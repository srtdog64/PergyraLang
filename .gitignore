# Build artifacts (root-level only -- the unanchored `build*/`
# previously matched paths like
# tests/cases/backend_compare/build_phase_advance/ and silently
# kept their main.pgy out of the index, which made CI's shard-zero
# precheck fail with "missing case" on every push).
/build/
/build*/
/bin/
/bin-*/
.tmp/

# Ad-hoc debug dumps emitted by --emit-c / --emit-mir / --emit-hir
# directly into the repo root (these are large per-example artifacts,
# not source). Keep them out of the index so debug sessions don't dirty
# the worktree.
/dnd_*.txt
/dnd_*.c
/raid_*.txt
/raid_*.c
/fsm_*.txt
/subject_*.txt
/*_mir.txt
/*_hir.txt
/*_air.txt
*.o
*.d
*.exe
*.obj
*.ll
*.lib
*.a
*.dll
*.so
*.dylib
*.mod
*.pdb
*.ilk

# Host-side registry/render tools may create interpreter caches. These are
# disposable machine-local products, never compiler or projection authority.
__pycache__/
*.py[cod]

# Generated C files from transpiler
examples/*.c
examples/**/*.c

# Compiled example binaries and build artifacts
# Root-level compiled examples are extensionless by default (`examples/foo`
# next to `examples/foo.pgy`). Ignore those products while keeping source,
# docs, expected outputs, and subdirectories visible.
examples/*
!examples/**/
!examples/*.pgy
!examples/*.md
!examples/*.txt
examples/*.exe
examples/**/*.exe
examples/**/*.o
examples/**/main
examples/**/player_main
examples/**/random_main

# Example runtime output (regenerated on run)
# Keep one representative scenario report tracked.
examples/**/results.txt
examples/**/results.*.txt
!examples/raid_graph_fsm/results.txt

# Root outputs written by backend-compare I/O fixtures when they are launched
# from the repository root. These are runtime evidence products, not fixtures.
/io.txt
/backend_compare_file_handle_io.txt

# Example expected output: keep ONE canonical expected_stdout.txt per project,
# ignore backend-specific variants
examples/**/expected_stdout.c.txt
examples/**/expected_stdout.llvm.txt
examples/**/expected_results.c.txt
examples/**/expected_results.llvm.txt

# Keep tracked:
#   examples/**/*.pgy                 source files
#   examples/**/expected_stdout.txt   canonical expected output
#   examples/**/expected_results.txt  canonical expected results
#   examples/raid_graph_fsm/results.txt representative generated report

# Self-host scaffold byproducts. Build artifacts under src/self_hosted/
# (*.exe / *.o) are already caught by the global patterns above, but
# probe files used during ad-hoc testing live next to main.pgy and
# need explicit exclusion so `git status` stays quiet during
# self-host work.
src/self_hosted/tools/**/probe.pgy
src/self_hosted/tools/**/probe_*.pgy
# Lexer fixture source override is parity-script-managed; never tracked.
src/self_hosted/lexer/fixture/source.txt
# Parser fixture source override is parity-script-managed; never tracked.
src/self_hosted/parser/fixture/source.txt
# Pergyra-emitted artifacts when a self-host tool is run directly via
# `pgy --emit-c` / `--emit-llvm`. The build dir under `.tmp/` is already
# ignored; these are for ad-hoc in-place runs.
src/self_hosted/tools/**/main.c
src/self_hosted/tools/**/main.ll
src/self_hosted/lexer/main.c
src/self_hosted/lexer/main.ll
src/self_hosted/parser/main.c
src/self_hosted/parser/main.ll
src/self_hosted/lib/*.c
src/self_hosted/lib/*.ll
# Compiler-world and bootstrap probes may also be emitted in place while
# validating the production self-host graph. They are disposable projections,
# never compiler source or semantic authority.
src/self_hosted/compiler/*.c
src/self_hosted/compiler/*.ll

# Self-host ABI fixtures may leave backend projections beside their .pgy input.
tests/self_hosted/fixtures/*.c
tests/self_hosted/fixtures/*.ll

# Backend-compare source fixtures are tracked as main.pgy. Generated C
# sidecars can appear beside them during targeted local C/LLVM runs.
tests/cases/backend_compare/**/main.c

# Temporary compiler artifacts
*.o.tmp
*.tmp
# Root-local compiler probes and scratch builders use the `.tmp_` prefix
# across source, log, MIR, object, and executable forms. Their semantic
# fixtures live under tests/ and src/self_hosted/; these products are disposable.
/.tmp_*
# Captured CI/job transcripts (`make ... > .tmp-<job>.log`). These run to tens
# of megabytes and were showing up as untracked noise in every git status.
/.tmp-*.log
/testall_run.txt

# Coq/Rocq proof build artifacts (docs/semantics/proofs/*.v). Only the .v
# sources are tracked; coqc output is regenerated by the formal-semantics gate.
*.vo
*.vok
*.vos
*.glob
.*.aux
.lia.cache
.nia.cache

# Editor / OS
*.backup
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/
.DS_Store
Thumbs.db

# VS Code extension packages are release artifacts. Historical packages stay
# tracked, but local/package-version rebuilds must not create new source facts.
*.vsix

# Review notes (private folder + README tracked, contents ignored)
review/*
!review/README.md

# Debug
/SESSION_CHANGES.md
*.dSYM/
core
vgcore.*
tests/*.exe
tests/*.o
tests/*_llvm
tests/tmp_*
tests/cases/**/main
# Backend-compare LLVM executable byproducts can appear at repo root when a
# fixture source name is used as the output stem.
/*_llvm
/*_llvm_fixed
.codex
.claude/

# Generated LLVM runtime bitcode (machine-local; bakes absolute __FILE__/root
# paths). Generate with scripts/build_runtime_bc.sh or `make runtime-bc`.
/src/runtime/pgy_runtime_lib.bc
