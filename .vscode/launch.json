{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pergyra: Language extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/editor/vscode-pergyra",
        "${workspaceFolder}"
      ]
    },
    {
      "name": "Pergyra: Semantic squiggle extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/editors/vscode",
        "${workspaceFolder}"
      ],
      "preLaunchTask": "Pergyra: Verify VS Code extensions"
    }
  ]
}
