// bench_array.pgy - heavy array indexing (xs[j]) in a tight loop.
func Main() -> Void {
    let xs: Array<Int> = [1, 2, 3, 4, 5, 6, 7, 8];
    let total: Int = 0;
    let i: Int = 0;
    let j: Int = 0;
    while i < 50000000 {
        total = total + xs[j];
        j = j + 1;
        if j >= 8 { j = 0; }
        i = i + 1;
    }
    Log("array=" + ToString(total));
}
