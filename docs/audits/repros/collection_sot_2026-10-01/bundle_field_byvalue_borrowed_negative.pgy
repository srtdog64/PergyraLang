// UNEXECUTED NEGATIVE. Compile/MIR refusal only; never execute this program.
struct Bundle
{
    value: Array<String>;
}

func Consume(bundle: Bundle) -> Void
{
    let value: Array<String> = bundle.value;
    ArrayDropOwnedStrings(value);
}

func Main() -> Void
{
    let value: Array<String> = [];
    ArrayPush(value, "borrowed");
    let bundle: Bundle = Bundle(value);
    Consume(bundle);
}
