// Analyze only: formal-RHS Assign lacks current-definition storage carriage.
func Metadata(own values: Array<String>) -> Int { return ArrayLength(values); }
func Forward(own values: Array<String>) -> Int {
    let moved: Array<String> = [];
    moved = values;
    let first: Int = Metadata(moved);
    return first + Metadata(values);
}
func Main() -> Void {
    let values: Array<String> = ["borrowed"];
    Log(Forward(values));
}
