{
  "name": "pergyra-lang",
  "displayName": "Pergyra Language",
  "description": "Language support for Pergyra (.pgy)",
  "version": "0.3.0",
  "publisher": "pergyra",
  "icon": "icons/pergyra-logo.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "pergyra",
        "aliases": ["Pergyra", "pgy"],
        "extensions": [".pgy"],
        "icon": {
          "light": "./icons/pgy-icon-light.png",
          "dark": "./icons/pgy-icon-dark.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pergyra",
        "scopeName": "source.pergyra",
        "path": "./syntaxes/pergyra.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "pergyra",
        "path": "./snippets/pergyra.json"
      }
    ],
    "commands": [
      {
        "command": "pergyra.run",
        "title": "Run Pergyra File",
        "icon": "$(play)",
        "category": "Pergyra"
      },
      {
        "command": "pergyra.build",
        "title": "Build Pergyra File",
        "icon": "$(gear)",
        "category": "Pergyra"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pergyra.run",
          "when": "resourceLangId == pergyra",
          "group": "navigation@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pergyra.run",
        "key": "ctrl+shift+r",
        "when": "resourceLangId == pergyra"
      }
    ],
    "iconThemes": [
      {
        "id": "pergyra-icons",
        "label": "Pergyra File Icons",
        "path": "./fileicons/pergyra-icon-theme.json"
      }
    ],
    "configuration": {
      "title": "Pergyra",
      "properties": {
        "pergyra.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to pgy compiler. Leave empty to auto-detect from workspace or PATH."
        },
        "pergyra.runFlags": {
          "type": "string",
          "default": "--run",
          "description": "Flags to pass when running a .pgy file."
        }
      }
    }
  }
}
