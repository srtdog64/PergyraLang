{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Pergyra",
  "scopeName": "source.pergyra",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#domain-keywords"
    },
    {
      "include": "#intent-keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#types"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.pergyra",
          "match": "//.*$"
        },
        {
          "name": "comment.block.pergyra",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.pergyra",
          "match": "\\b(?:as|await|break|case|collapse|compensate|continue|default|defer|else|fail|for|if|in|match|parallel|return|select|spawn|transaction|while|with)\\b"
        },
        {
          "name": "keyword.declaration.pergyra",
          "match": "\\b(?:action|enum|export|extends|extern|func|impl|import|include|let|namespace|type|use)\\b"
        },
        {
          "name": "storage.modifier.pergyra",
          "match": "\\b(?:async|dyn|innate|local|mut|nondeterministic|override|own|private|public|ref|reflect|remote|secure|unsafe)\\b"
        },
        {
          "name": "constant.language.pergyra",
          "match": "\\b(?:false|true)\\b"
        },
        {
          "name": "storage.type.pergyra",
          "match": "\\b(?:ability|class|effect|object|party|relation|role|roster|struct|subject|tobject|vessel|world|zone)\\b"
        }
      ]
    },
    "domain-keywords": {
      "patterns": [
        {
          "name": "keyword.other.domain.pergyra",
          "match": "\\b(?:authorized|bind|binding|by|causes|event|projection|requires|shared|slot|state|within)\\b"
        }
      ]
    },
    "intent-keywords": {
      "patterns": [
        {
          "name": "keyword.other.intent.pergyra",
          "match": "\\b(?:after|concurrent|exclusive|failure|guard|intent|invariant|involves|on|post|pre|step|success|where|who)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.pergyra",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.pergyra",
              "match": "\\\\."
            },
            {
              "name": "variable.other.interpolation.pergyra",
              "match": "\\$\\{[^}]+\\}"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.pergyra",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.pergyra",
          "match": "\\b(Int|Float|String|Bool|Void|Result|HashMap|List|Set|Queue|Fsm|Timer|Cooldown|Optional)\\b"
        },
        {
          "name": "entity.name.type.user.pergyra",
          "match": "\\b[A-Z][a-zA-Z0-9]+\\b"
        }
      ]
    }
  }
}
