// role_ability_demo.pgy — Role/Ability System Performance Demo
//
// Performance Test:
//   - Direct struct access vs Role-based access
//   - Event dispatch overhead
//   - Slot vs Stack vs Box performance

// ===== Ability Definitions =====

ability Damageable {
    require _health: Slot<Int>

    func TakeDamage(amount: Int);
    func GetHealth() -> Int;
}

ability Attackable {
    require _attackPower: Int

    func GetAttackPower() -> Int;
}

// ===== Data Structures =====

struct Entity {
    _health: Slot<Int>,
    _attackPower: Int,
    name: String
}

// ===== Role Implementations =====

role EntityDamageable for Entity {
    impl ability Damageable {
        func TakeDamage(amount: Int) {
            let current = Read(_health);
            let newHealth = Max(0, current - amount);
            Write(_health, newHealth);
        }

        func GetHealth() -> Int {
            return Read(_health);
        }
    }
}

role EntityAttackable for Entity {
    impl ability Attackable {
        func GetAttackPower() -> Int {
            return _attackPower;
        }
    }
}

// ===== Event Definitions =====

event OnDamageTaken: (target: Object, damage: Int);
event OnHealthChanged: (target: Object, newHealth: Int);

// ===== Performance Test Functions =====

// Test 1: Direct Slot Access
func TestDirectSlotAccess(iterations: Int) -> Int {
    let start = 0;
    let slot = ClaimSlot<Int>();
    Write(slot, 1000);
    
    for i in 0..iterations {
        let current = Read(slot);
        Write(slot, current - 1);
    }
    
    let result = Read(slot);
    Release(slot);
    return result;
}

// Test 2: Role-based Access (via ability)
func TestRoleBasedAccess(iterations: Int) -> Int {
    let healthSlot = ClaimSlot<Int>();
    Write(healthSlot, 1000);
    
    let entity = Entity {
        _health: healthSlot,
        _attackPower: 10,
        name: "TestEntity"
    };
    
    let damageable = EntityDamageable_as_Damageable(&entity);
    
    for i in 0..iterations {
        damageable.TakeDamage(1);
    }
    
    let result = damageable.GetHealth();
    Release(healthSlot);
    return result;
}

// Test 3: Event Dispatch Overhead
func TestEventDispatch(iterations: Int) -> Int {
    let counter = ClaimSlot<Int>();
    Write(counter, 0);
    
    // Simple event handler
    let handler = (target, damage) => {
        let current = Read(counter);
        Write(counter, current + 1);
    };
    
    // Subscribe
    OnDamageTaken += handler;
    
    // Fire events
    for i in 0..iterations {
        OnDamageTaken(this, 5);
    }
    
    // Unsubscribe
    OnDamageTaken -= handler;
    
    let result = Read(counter);
    Release(counter);
    return result;
}

// Test 4: Stack vs Slot Performance
func TestStackPerformance(iterations: Int) -> Int {
    let mut value = 1000;
    
    for i in 0..iterations {
        value = value - 1;
    }
    
    return value;
}

func TestSlotPerformance(iterations: Int) -> Int {
    let slot = ClaimSlot<Int>();
    Write(slot, 1000);
    
    for i in 0..iterations {
        let current = Read(slot);
        Write(slot, current - 1);
    }
    
    let result = Read(slot);
    Release(slot);
    return result;
}

// Test 5: Multiple Roles Composition
func TestMultipleRoles(iterations: Int) -> Int {
    let healthSlot = ClaimSlot<Int>();
    Write(healthSlot, 1000);
    
    let entity = Entity {
        _health: healthSlot,
        _attackPower: 15,
        name: "MultiRoleTest"
    };
    
    let damageable = EntityDamageable_as_Damageable(&entity);
    let attackable = EntityAttackable_as_Attackable(&entity);
    
    for i in 0..iterations {
        let attack = attackable.GetAttackPower();
        damageable.TakeDamage(attack / 10);
    }
    
    let result = damageable.GetHealth();
    Release(healthSlot);
    return result;
}

// ===== Benchmark Helper =====

func RunBenchmark(name: String, testFunc: Int -> Int, iterations: Int) -> Void {
    Log("=== ");
    Log(name);
    Log(" ===");
    Log("Iterations: ");
    Log(iterations);
    
    // In real implementation, we would measure time here
    // For now, just verify correctness
    let result = testFunc(iterations);
    
    Log("Result: ");
    Log(result);
    Log("Expected: 0");
    
    if result == 0 {
        Log("Status: PASS");
    } else {
        Log("Status: FAIL");
    }
    
    Log("");
}

// ===== Main Entry Point =====

func Main() -> Void {
    Log("========================================");
    Log("Pergyra Role/Ability System Performance Test");
    Log("========================================");
    Log("");
    
    let iterations = 10000;
    
    // Run all benchmarks
    RunBenchmark("Direct Slot Access", TestDirectSlotAccess, iterations);
    RunBenchmark("Role-based Access (via Ability)", TestRoleBasedAccess, iterations);
    RunBenchmark("Event Dispatch", TestEventDispatch, iterations);
    RunBenchmark("Stack Performance", TestStackPerformance, iterations);
    RunBenchmark("Slot Performance", TestSlotPerformance, iterations);
    RunBenchmark("Multiple Roles Composition", TestMultipleRoles, iterations);
    
    Log("========================================");
    Log("All Tests Complete");
    Log("========================================");
    
    // Summary
    Log("");
    Log("Expected Results:");
    Log("- Stack: Fastest (0 overhead)");
    Log("- Direct Slot: ~2-3x slower than stack");
    Log("- Role-based: ~1.1-1.3x overhead vs direct slot");
    Log("- Event Dispatch: ~1.5-2x overhead vs direct call");
    Log("");
    Log("Note: Actual timing requires compiler runtime with timer support.");
    Log("This demo verifies correctness of role/ability system.");
}
