// calendar_manage_event_explicit.pgy
//
// Large canonical explicit example.
// The same workflow is also provided as a compressed companion example:
// - calendar_manage_event_compressed.pgy

ability CalendarOwnerCap {
    func CanManage() -> Bool;
}

subject CalendarOwner {
    let revision: Int;

    action CreateEvent(self) -> Void
        requires CalendarOwnerCap
        within CalendarZone
        authorized by self
        causes EventCreated
    {
        self.revision = self.revision + 1;
    }

    action EditEvent(self) -> Void
        requires CalendarOwnerCap
        within EventEditZone
        authorized by self
        causes EventEdited
    {
        self.revision = self.revision + 1;
    }

    action DeleteEvent(self) -> Void
        requires CalendarOwnerCap
        within CalendarZone
        authorized by self
        causes EventDeleted
    {
        self.revision = self.revision + 1;
    }
}

role OwnerCalendarCap for CalendarOwner {
    impl ability CalendarOwnerCap {
        func CanManage() -> Bool {
            return true;
        }
    }
}

effect EventCreated for bearer: CalendarOwner {
}

effect EventEdited for bearer: CalendarOwner {
}

effect EventDeleted for bearer: CalendarOwner {
}

zone CalendarZone {
    subject slot owner: CalendarOwner
    effect slot created: EventCreated
    effect slot deleted: EventDeleted
    authority owner requires CalendarOwnerCap
}

zone EventEditZone {
    subject slot owner: CalendarOwner
    effect slot edited: EventEdited
    authority owner requires CalendarOwnerCap
}

intent ManageCalendarExplicit(calendar: CalendarZone,
                              editor: EventEditZone,
                              owner: CalendarOwner) {
    exclusive;

    step CreateEvent {
        who: owner;
        where: CalendarZone;
        using: calendar;
        requires: CalendarOwnerCap;
        authorized by: owner;
        causes: EventCreated;
        on: owner.CreateEvent();
        expect: true;
    }

    step EditEvent {
        who: owner;
        where: EventEditZone;
        using: editor;
        requires: CalendarOwnerCap;
        authorized by: owner;
        causes: EventEdited;
        on: owner.EditEvent();
        expect: true;
    }

    step DeleteEvent {
        who: owner;
        where: CalendarZone;
        using: calendar;
        requires: CalendarOwnerCap;
        authorized by: owner;
        causes: EventDeleted;
        on: owner.DeleteEvent();
        expect: true;
    }
}

func Main() -> Void {
    Log("calendar-manage-explicit");
    Log("mode=explicit");
    Log("steps=3");
}
