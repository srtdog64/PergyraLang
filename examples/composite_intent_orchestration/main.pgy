subject Clerk
{
    let reserved: Int;
    let charged: Int;
    let shipped: Int;

    action Reserve(self) -> Void
    {
        reserved = reserved + 1;
    }

    action RollbackReserve(self) -> Void
    {
        reserved = reserved - 1;
    }

    action Charge(self) -> Void
    {
        charged = charged + 1;
    }

    action RollbackCharge(self) -> Void
    {
        charged = charged - 1;
    }

    action Ship(self) -> Void
    {
        shipped = shipped + 1;
    }

    action RollbackShip(self) -> Void
    {
        shipped = shipped - 1;
    }
}

zone OrderZone
{
    subject slot clerk: Clerk
}

zone PaymentZone
{
    subject slot clerk: Clerk
}

zone ShippingZone
{
    subject slot clerk: Clerk
}

intent ReserveStock(order: OrderZone, clerk: Clerk)
{
    step reserve
    {
        where: OrderZone;
        using: order;
        who: clerk;
        on: clerk.Reserve();
        compensate: clerk.RollbackReserve();
        post: order.clerk.reserved > 0;
        expect: order.clerk.reserved > 0;
    }

    success: order.clerk.reserved > 0;
    failure: false;
}

intent ChargeBuyer(payment: PaymentZone, clerk: Clerk)
{
    step charge
    {
        where: PaymentZone;
        using: payment;
        who: clerk;
        on: clerk.Charge();
        compensate: clerk.RollbackCharge();
        post: payment.clerk.charged > 0;
        expect: payment.clerk.charged > 0;
    }

    success: payment.clerk.charged > 0;
    failure: false;
}

intent ShipParcel(shipping: ShippingZone, clerk: Clerk)
{
    step ship
    {
        where: ShippingZone;
        using: shipping;
        who: clerk;
        on: clerk.Ship();
        compensate: clerk.RollbackShip();
        post: shipping.clerk.shipped > 0;
        expect: shipping.clerk.shipped > 0;
    }

    success: shipping.clerk.shipped > 0;
    failure: false;
}

intent FulfillOrder(order: OrderZone, payment: PaymentZone, shipping: ShippingZone, clerk: Clerk)
{
    exclusive;

    step reserve
    {
        intent: ReserveStock(order, clerk);
        expect: order.clerk.reserved > 0;
    }

    step charge
    {
        intent: ChargeBuyer(payment, clerk);
        expect: payment.clerk.charged > 0;
    }

    step ship
    {
        intent: ShipParcel(shipping, clerk);
        expect: shipping.clerk.shipped > 0;
    }

    success: shipping.clerk.shipped > 0;
    failure: false;
}

intent ProcessOrder(order: OrderZone, payment: PaymentZone, shipping: ShippingZone, clerk: Clerk)
{
    exclusive;
    priority: 9;

    step fulfill
    {
        intent: FulfillOrder(order, payment, shipping, clerk);
        expect: shipping.clerk.shipped > 0;
    }

    success: shipping.clerk.shipped > 0;
    failure: false;
}

func Main() -> Void
{
    let clerk = Clerk(0, 0, 0);
    let order = OrderZone(clerk);
    let payment = PaymentZone(clerk);
    let shipping = ShippingZone(clerk);

    let ok = ProcessOrder(order, payment, shipping, clerk);
    Log("[Intent] ProcessOrder=" + ToString(ok));
    Log("[Runtime] name=" + IntentLastName()
        + " steps=" + ToString(IntentLastStepCount())
        + " failed=" + ToString(IntentLastFailed()));
    Log("[CanonicalClerk] reserved=" + ToString(clerk.reserved)
        + " charged=" + ToString(clerk.charged)
        + " shipped=" + ToString(clerk.shipped));
    Log("[OrderZone] reserved=" + ToString(order.clerk.reserved));
    Log("[PaymentZone] charged=" + ToString(payment.clerk.charged));
    Log("[ShippingZone] shipped=" + ToString(shipping.clerk.shipped));
    Log("[History] count=" + ToString(IntentHistoryCount()));

    let i = 0;
    while i < IntentHistoryCount()
    {
        Log("[Step] " + IntentHistoryStepName(i)
            + " phase=" + IntentHistoryStepPhase(i)
            + " participant=" + IntentHistoryStepParticipant(i)
            + " ok=" + ToString(IntentHistoryStepOk(i)));
        i = i + 1;
    }

    Log("[Trace] " + IntentLastTrace());
}
