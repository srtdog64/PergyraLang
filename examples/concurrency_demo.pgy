func Worker(id: Int) -> Int {
    Log(id);
    return id * 10;
}

func Main() -> Void {
    let a: Slot<Int> = ClaimSlot<Int>();
    let b: Slot<Int> = ClaimSlot<Int>();
    let c: Slot<Int> = ClaimSlot<Int>();

    parallel {
        Write(a, 100);
        Write(b, 200);
        Write(c, 300);
    }

    Log(Read(a));
    Log(Read(b));
    Log(Read(c));

    Release(a);
    Release(b);
    Release(c);
}
