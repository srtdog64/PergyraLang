func Main() -> Void
{
    Log(CampaignHeader());
    Log("  RANDOM MODE");

    let world = OpenTavernCampaign();

    world.RunCampaignRandom(77);

    Log("");
    Log("=== FINAL PARTY SNAPSHOT ===");
    world.LogSnapshot();
    Log("saving examples/dnd_tavern_campaign/results.random.txt");
    world.SaveReport("examples/dnd_tavern_campaign/results.random.txt");
}
