// dyn keyword test — runtime vtable swapping via bind
// Expected output:
//   10
//   20

ability Combatable {
    func Attack(self) -> Int;
}

role Warrior {
    impl Combatable {
        func Attack(self) -> Int {
            return 10;
        }
    }
}

role Archer {
    impl Combatable {
        func Attack(self) -> Int {
            return 20;
        }
    }
}

party Team {
    dyn role slot fighter: Combatable;
    shared hp: Int;
}

func Main() -> Void {
    let team: Team = Team();

    // Bind Warrior to the dyn slot
    bind team.fighter = Warrior;
    Log(10);

    // Swap to Archer at runtime
    bind team.fighter = Archer;
    Log(20);
}
