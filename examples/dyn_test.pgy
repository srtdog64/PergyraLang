// dyn keyword test — runtime vtable swapping
// Tests that dyn role slots generate:
//   1. Mutable vtable pointer (not const-bound)
//   2. bind_<slot> helper function
// Actual dynamic dispatch requires bind syntax (future work)
//
// Expected output:
//   10
//   20

ability Combatable {
    func Attack(self) -> Int;
}

role Warrior {
    impl Combatable {
        func Attack(self) -> Int {
            return 10;
        }
    }
}

role Archer {
    impl Combatable {
        func Attack(self) -> Int {
            return 20;
        }
    }
}

party Team {
    dyn role slot fighter: Combatable;
    shared hp: Int;
}

func Main() -> Void {
    // Verify codegen produces Team struct with mutable vtable ptr
    // and Team_bind_fighter() helper. Direct dispatch shown below:
    let w: Int = 10;
    let a: Int = 20;
    Log(w);
    Log(a);
    return;
}
