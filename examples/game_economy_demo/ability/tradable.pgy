// ability/tradable.pgy — 거래 능력 계약 + 구현
//
// 단일 책임: Tradable ability와 Player에 대한 role 구현.
import "subject/player.pgy";

ability Tradable {
    fields gold: Gold
    func CanTrade() -> Bool
}

role PlayerTrader for Player {
    impl ability Tradable {
        func CanTrade() -> Bool {
            return true;
        }
    }
}
