// async/async_lib.pgy — 비동기·동시성
//
// 단일 책임: 색깔 분해(coloring decomposition) 데모.
//   spawn=명명 작업, await=future 합류, parallel=구조적 실행,
//   Channel=스트리밍, select=수신 분기, RemoteFuture=Result 합류, Cancel=취소.
import "type/types.pgy";

async func Inc(x: Int) -> Int {
    return x + 1;
}

func Work(x: Int) -> Int {
    return x * 2;
}

func Produce(ch: Channel<Int>, n: Int) -> Void {
    let i: Int = 0;
    while i < n {
        ch <- Work(i);
        i = i + 1;
    }
}

// 데이터 병렬: join with sum
func ParallelSum(xs: Array<Int>) -> Int {
    let acc: Slot<Int> = ClaimSlot<Int>();
    Write(acc, 0);

    parallel (x in xs) join with sum {
        let cur: Int = Read(acc);
        Write(acc, cur + x);
    }

    let total: Int = Read(acc);
    Release(acc);
    return total;
}

func SelectDemo(ch: Channel<Int>) -> Int {
    select {
        case v = <-ch:
            return v;
        default:
            return -1;
    }
}

async func RemoteDemo() -> Int {
    let dev: DeviceSlot<Int> = ClaimDeviceSlot();
    DeviceWrite(dev, 11);
    let pending: RemoteFuture<Int> = SubmitDeviceRead(dev);
    let remoteResult: Result<Int> = await pending;
    ReleaseDeviceSlot(dev);
    return Unwrap(remoteResult);
}

func TransactionDemo() -> Void {
    transaction {
        Log("tx step 1");
        compensate Log("undo step 1");
        Log("tx step 2");
        compensate Log("undo step 2");
        fail
    }
    Log("after transaction");
}

async func RunAsyncPipeline() -> Void {
    let task: Future<Int> = spawn Inc(4);
    let v: Int = await task;
    Log(v);

    let ch: Channel<Int> = Channel(4);
    parallel {
        ch <- Work(3);
        ch <- Work(4);
    }
    let a: Int = <- ch;
    let b: Int = <- ch;
    Log(a + b);

    let ch2: Channel<Int> = Channel(1);
    ch2 <- 7;
    Log(SelectDemo(ch2));

    let cancellable: Future<Int> = spawn Inc(40);
    let requested: Bool = Cancel(cancellable);
    Log(requested);
}
