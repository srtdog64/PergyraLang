// commons/ranking.pgy — 결정적 집계와 동점 규칙
//
// 원정 MVP와 경매 낙찰자가 같은 동점 규칙을 쓴다: 같은 값이면 앞선 인덱스가 이긴다.
// 모든 집계는 parallel join이다. join은 인덱스 순서로 고정된 fold라서 워커 수와
// 스케줄에 상관없이 같은 값을 낸다.

func TotalOf(values: Array<Int>) -> Int {
    let total: Int = parallel (value in values) join with sum {
        give value;
    };
    return total;
}

func HighestOf(values: Array<Int>) -> Int {
    let top: Int = parallel (value in values) join with max {
        give value;
    };
    return top;
}

func LowestOf(values: Array<Int>) -> Int {
    let low: Int = parallel (value in values) join with min {
        give value;
    };
    return low;
}

func IndexIfEqual(value: Int, top: Int, index: Int, n: Int) -> Int {
    if value == top {
        return index;
    }
    return n;
}

// top 값을 가진 가장 앞선 인덱스. min으로 모으므로 동점이면 앞선 쪽이 남는다.
func FirstIndexOf(values: Array<Int>, top: Int) -> Int {
    let n: Int = ArrayLength(values);
    let first: Int = parallel (i in 0..n) join with min {
        give IndexIfEqual(values[i], top, i, n);
    };
    return first;
}

func ValueUnlessAt(value: Int, index: Int, skip: Int) -> Int {
    if index == skip {
        return 0;
    }
    return value;
}

// skip 자리를 뺀 최댓값(차순위 값).
func HighestExcept(values: Array<Int>, skip: Int) -> Int {
    let n: Int = ArrayLength(values);
    let second: Int = parallel (i in 0..n) join with max {
        give ValueUnlessAt(values[i], i, skip);
    };
    return second;
}
