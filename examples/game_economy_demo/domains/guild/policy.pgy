// domains/guild/policy.pgy — 면허 표
//
// 직업마다 할 수 있는 일. intent의 pre: 절이 이 표를 읽는다.
import "../../commons/types/calling.pgy";

func LicensedToCraft(calling: Calling) -> Bool {
    match calling {
        case Smith | Mage: return true;
        case Warrior | Merchant: return false;
    }
}

func LicensedToRaid(calling: Calling) -> Bool {
    match calling {
        case Warrior | Smith | Mage: return true;
        case Merchant: return false;
    }
}
