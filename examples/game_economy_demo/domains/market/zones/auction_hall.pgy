// domains/market/zones/auction_hall.pgy — 경매장
//
// 입찰가는 경매장 입찰판(book)에 자리 순서로 올라간다. 낙찰가는 정산이 끝날
// 때까지 escrow에 머문다. 세금은 escrow에서 떼어 국고로, 나머지는 판매자에게 간다.
import "../../guild/subjects/adventurer.pgy";
import "../../guild/abilities/guild_licenses.pgy";
import "../../../commons/types/gold.pgy";
import "../../../commons/types/member_card.pgy";
import "../effects/levy.pgy";
import "../relations/trade_bond.pgy";

zone AuctionHall {
    subject slot seller: Adventurer
    subject slot buyer: Adventurer
    object slot board: MemberCard
    effect slot levy: Levy
    relation slot bond: TradeBond

    shared book: Array<Gold> = [0, 0, 0]
    shared escrow: Gold = 0
    shared lot: Int = 0
    shared sales: Int = 0

    authority seller requires Tradable
    authority buyer requires Tradable
    refresh board from seller by seller
    apply levy to seller by seller
    link bond between seller, buyer by seller

    func Post(self, seat: Int, bid: Gold) -> Gold {
        book[seat] = bid;
        return book[seat];
    }

    func Escrow(self, price: Gold) -> Gold {
        buyer.Spend(price);
        escrow = escrow + price;
        return escrow;
    }

    func Refund(self, price: Gold) -> Gold {
        buyer.Earn(price);
        escrow = escrow - price;
        return escrow;
    }

    func Deliver(self) -> Int {
        lot = seller.HandRelic();
        buyer.StowRelic(lot);
        return lot;
    }

    func Undeliver(self) -> Int {
        buyer.DiscardRelic();
        seller.StowRelic(lot);
        lot = 0;
        return lot;
    }

    func Withhold(self, tax: Gold) -> Gold {
        escrow = escrow - tax;
        self.levy.paid = tax;
        return escrow;
    }

    func Unwithhold(self, tax: Gold) -> Gold {
        escrow = escrow + tax;
        self.levy.paid = 0;
        return escrow;
    }

    func Payout(self) -> Gold {
        let net: Gold = escrow;
        seller.Earn(net);
        seller.Honor(1);
        escrow = 0;
        sales = sales + 1;
        self.bond.net = net;
        return net;
    }

    func Unpayout(self, net: Gold) -> Gold {
        seller.Clawback(net);
        seller.Honor(-1);
        escrow = escrow + net;
        sales = sales - 1;
        self.bond.net = 0;
        return escrow;
    }
}
