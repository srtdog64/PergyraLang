// intent/battle_intent.pgy — 전투 오케스트레이션
//
// 단일 책임: RunBattle intent 하나.
import "zone/battle_zone.pgy";
import "subject/player.pgy";
import "subject/enemy.pgy";

intent RunBattle(battle: BattleZone, hero: Player, foe: Enemy) {
    concurrent;
    priority: 3;
    rollback: current;
    who: hero;

    step Attack {
        using: battle;
        on: hero.TakeHit(10);
        guard: hero.IsAlive();
        expect: true;
    }

    step Counter {
        using: battle;
        on: foe.Strike();
        expect: true;
    }

    success: true;
    failure: false;
}
