// main.pgy — 한 시즌을 처음부터 끝까지 돌린다
//
// 시즌의 줄거리:
//   1. 원정대가 보스를 쓰러뜨리고 새로 발행된 금화와 재료를 나눈다(faucet).
//   2. 더 센 보스에는 피해가 모자라 원정이 거절된다. 아무것도 발행되지 않는다.
//   3. 약한 보스는 쓰러지지만, 보상이 시즌 발행 한도를 넘어 조폐국이 발행을
//      거절한다. 처치 기록은 보상(compensate)으로 되돌려진다.
//   4. 대장장이와 마법사가 유물을 만들고, 수수료는 소각된다(sink).
//      면허 없는 전사의 제작은 거절된다.
//   5. 유물이 2차 가격 경매로 팔린다. 이미 판 유물을 다시 올린 경매는
//      정산을 열기 전에 거절된다.
//   6. 시즌 보고서: 발행·소각·세수와 보존 법칙을 검사한다.
import "genesis.pgy";

func Main() -> Void {
    let economy: GuildEconomy = OpenSeason();
    Log("=== GUILD ECONOMY: ONE SEASON ===");
    Log("[genesis] " + economy.Books());
    economy.Roll();

    economy.Raid("Ashen Wyrm", 90, 20);
    economy.Raid("Storm Titan", 160, 20);
    economy.Raid("Bone Hydra", 80, 20);

    economy.Craft(Cy);
    economy.Craft(Ana);
    economy.Craft(Dee);

    let listed: Int = economy.RelicOf(Cy);
    economy.Auction(Cy, listed, 60, Ana, Bo, Dee);
    economy.Auction(Cy, listed, 60, Ana, Bo, Dee);
    economy.Auction(Dee, economy.RelicOf(Dee), 60, Ana, Bo, Cy);

    economy.Report();
}
