// subject/player.pgy — 플레이어 개체
//
// 단일 책임: Player 하나. 계약 절은 능력/존 이름을 참조한다.
import "type/types.pgy";
import "subject/vessel/vitals.pgy";

subject Player {
    let name: String;
    let mut gold: Gold;
    vessel vitals: Vitals;
    let inventory: ItemId;

    action Earn(self, amount: Int) -> Void
        requires Tradable
        within MarketZone
        authorized by self
        causes Earned
    {
        gold = gold + amount;
    }

    action Spend(self, amount: Int) -> Void
        requires Tradable
        within MarketZone
        authorized by self
        causes Spent
    {
        gold = gold - amount;
    }

    action TakeHit(self, damage: Int) -> Void
        requires Combatant
        within BattleZone
        authorized by self
        causes Damaged
    {
        vitals.current = vitals.current - damage;
    }

    action Heal(self, amount: Int) -> Void
        requires Combatant
        within BattleZone
        authorized by self
    {
        vitals.current = vitals.current + amount;
    }

    func CanAfford(self, price: Int) -> Bool {
        return gold >= price;
    }

    func IsAlive(self) -> Bool {
        return vitals.IsAlive();
    }
}
