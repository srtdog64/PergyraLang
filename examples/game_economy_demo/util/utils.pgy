// util/utils.pgy — 범용 유틸 (namespace + 파이프 + Option/Result)
//
// 단일 책임: 범용 계산 헬퍼.
import "type/types.pgy";

namespace Utils {
    export func Sum(xs: Array<Int>) -> Int {
        let total: Int = 0;
        let i: Int = 0;
        while i < ArrayLength(xs) {
            total = total + xs[i];
            i = i + 1;
        }
        return total;
    }

    export func SafeDiv(a: Int, b: Int) -> Result<Int> {
        if b == 0 {
            return Err("division by zero");
        }
        return Ok(a / b);
    }

    export func FindGold(snapshot: Option<PlayerSnapshot>) -> Int {
        match snapshot {
            case Some(v): return v.gold;
            case None: return 0;
        }
    }

    export func Double(x: Int) -> Int {
        return x * 2;
    }

    export func AddTen(x: Int) -> Int {
        return x + 10;
    }
}

func PipelineDemo() -> Int {
    return 5 |> Utils.Double |> Utils.AddTen;
}
