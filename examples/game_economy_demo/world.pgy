// world.pgy — 길드 경제 한 시즌의 실행 경계
//
// 다섯 zone을 묶는다. 시나리오 메서드는 정책으로 계획(plan)을 계산하고, 그 계획을
// 값으로 intent에 넘긴다. 성공·실패와 그 이유는 intent가 소유한다.
//
// 보존 법칙: 금화는 발행(faucet)과 소각(sink)으로만 생기고 사라진다.
//   treasury.supply == 지갑 합 + 경매장 escrow + 대장간 feeBox + 국고 vault + 지급 대기분
//
// zone은 world 밖으로 나갈 수 없고, subject는 인자로 넘길 수 없다. 그래서
// intent 호출은 모두 이 world 안에 있고, 길드원은 Member 값으로 고른다.
import "domains/guild/zones/guild_roster.pgy";
import "domains/treasury/zones/treasury.pgy";
import "domains/raid/intents/clear_raid.pgy";
import "domains/forge/intents/craft_relic.pgy";
import "domains/market/intents/settle_auction.pgy";

world GuildEconomy {
    zone guild: GuildRoster
    zone treasury: Treasury
    zone raid: RaidHall
    zone forge: Forge
    zone hall: AuctionHall

    activate guild
    activate treasury
    activate raid
    activate forge
    activate hall

    func Open(self, seasonCap: Int) -> Int {
        return treasury.Open(guild.Wealth(), seasonCap);
    }

    func Held(self) -> Int {
        return guild.Wealth() + hall.escrow + forge.feeBox + treasury.vault + treasury.pending;
    }

    func Conserved(self) -> Bool {
        return treasury.supply == Held();
    }

    func Books(self) -> String {
        return "supply=" + ToString(treasury.supply)
            + " held=" + ToString(Held())
            + " conserved=" + ToString(Conserved());
    }

    func Roll(self) -> Void {
        Log("  " + guild.ana.Card());
        Log("  " + guild.bo.Card());
        Log("  " + guild.cy.Card());
        Log("  " + guild.dee.Card());
    }

    func Outcome(self, name: String, ok: Bool) -> Bool {
        if ok {
            Log("[intent] " + name + " ok");
        } else {
            Log("[intent] " + name + " refused at " + IntentLastFailure());
        }
        Log("[books] " + Books());
        return ok;
    }

    func RelicOf(self, member: Member) -> Int {
        match member {
            case Ana: return guild.ana.pack.relic;
            case Bo: return guild.bo.pack.relic;
            case Cy: return guild.cy.pack.relic;
            case Dee: return guild.dee.pack.relic;
        }
    }

    // 원정대: 선봉 Ana, 타격 Cy, 비전 Dee. 상인 Bo는 마을에 남는다.
    func Raid(self, boss: String, hp: Int, morale: Int) -> Bool {
        raid.Summon(boss, hp);
        let powers: Array<Int> = [guild.ana.power, guild.cy.power, guild.dee.power];
        let damage: Array<Int> = PartyDamage(powers, morale);
        let plan: RaidPlan = PlanRaid(damage, RewardPool(hp));
        Log("-- raid: " + boss + " hp=" + ToString(hp) + " --");
        Log("[plan] damage=" + ToString(damage[0]) + "/" + ToString(damage[1]) + "/" + ToString(damage[2])
            + " total=" + ToString(plan.total)
            + " bounty=" + ToString(plan.bounty)
            + " cuts=" + ToString(plan.vanguard.gold) + "/" + ToString(plan.striker.gold) + "/" + ToString(plan.arcanist.gold)
            + " mvp=" + ToString(plan.mvp));
        let ok: Bool = Outcome("ClearRaid", ClearRaid(raid, treasury, treasury.mint, guild.ana, guild.cy, guild.dee, plan));
        Log("[raid] " + raid.boss + " slain=" + ToString(raid.slain)
            + " clears=" + ToString(raid.clears)
            + " minted=" + ToString(treasury.mint.issued) + "/" + ToString(treasury.cap));
        return ok;
    }

    func Order(self, name: String, power: Int, calling: Calling) -> ForgeOrder {
        let order: ForgeOrder = PlanForge(power, forge.heat, calling);
        Log("-- forge: " + name + " heat=" + ToString(forge.heat) + " --");
        Log("[plan] fee=" + ToString(order.fee) + " quality=" + ToString(order.quality));
        return order;
    }

    func Craft(self, smith: Member) -> Bool {
        match smith {
            case Ana:
                let order: ForgeOrder = Order(guild.ana.name, guild.ana.power, guild.ana.calling);
                return Outcome("CraftRelic", CraftRelic(forge, treasury, treasury.mint, guild.ana, order));
            case Bo:
                let order: ForgeOrder = Order(guild.bo.name, guild.bo.power, guild.bo.calling);
                return Outcome("CraftRelic", CraftRelic(forge, treasury, treasury.mint, guild.bo, order));
            case Cy:
                let order: ForgeOrder = Order(guild.cy.name, guild.cy.power, guild.cy.calling);
                return Outcome("CraftRelic", CraftRelic(forge, treasury, treasury.mint, guild.cy, order));
            case Dee:
                let order: ForgeOrder = Order(guild.dee.name, guild.dee.power, guild.dee.calling);
                return Outcome("CraftRelic", CraftRelic(forge, treasury, treasury.mint, guild.dee, order));
        }
    }

    func Stake(self, bidder: Member, quality: Int) -> Int {
        match bidder {
            case Ana: return BidFor(quality, guild.ana.calling, guild.ana.purse.gold, guild.ana.pack.CanCarry());
            case Bo: return BidFor(quality, guild.bo.calling, guild.bo.purse.gold, guild.bo.pack.CanCarry());
            case Cy: return BidFor(quality, guild.cy.calling, guild.cy.purse.gold, guild.cy.pack.CanCarry());
            case Dee: return BidFor(quality, guild.dee.calling, guild.dee.purse.gold, guild.dee.pack.CanCarry());
        }
    }

    // 판매자×구매자 표. 자기 물건을 자기가 사는 칸은 intent까지 가지 않는다.
    func Settle(self, seller: Member, buyer: Member, clearing: Clearing) -> Bool {
        if seller == buyer {
            Log("[market] self-dealing refused");
            return false;
        }
        match seller {
            case Ana:
                match buyer {
                    case Bo: return SettleAuction(hall, treasury, treasury.mint, guild.ana, guild.bo, clearing);
                    case Cy: return SettleAuction(hall, treasury, treasury.mint, guild.ana, guild.cy, clearing);
                    default: return SettleAuction(hall, treasury, treasury.mint, guild.ana, guild.dee, clearing);
                }
            case Bo:
                match buyer {
                    case Ana: return SettleAuction(hall, treasury, treasury.mint, guild.bo, guild.ana, clearing);
                    case Cy: return SettleAuction(hall, treasury, treasury.mint, guild.bo, guild.cy, clearing);
                    default: return SettleAuction(hall, treasury, treasury.mint, guild.bo, guild.dee, clearing);
                }
            case Cy:
                match buyer {
                    case Ana: return SettleAuction(hall, treasury, treasury.mint, guild.cy, guild.ana, clearing);
                    case Bo: return SettleAuction(hall, treasury, treasury.mint, guild.cy, guild.bo, clearing);
                    default: return SettleAuction(hall, treasury, treasury.mint, guild.cy, guild.dee, clearing);
                }
            case Dee:
                match buyer {
                    case Ana: return SettleAuction(hall, treasury, treasury.mint, guild.dee, guild.ana, clearing);
                    case Bo: return SettleAuction(hall, treasury, treasury.mint, guild.dee, guild.bo, clearing);
                    default: return SettleAuction(hall, treasury, treasury.mint, guild.dee, guild.cy, clearing);
                }
        }
    }

    func Winner(self, index: Int, first: Member, second: Member, third: Member) -> Member {
        match index {
            case 0: return first;
            case 1: return second;
            default: return third;
        }
    }

    // 판매자 한 명과 입찰자 셋. quality는 경매장 게시판에 올라간 유물 품질이다.
    func Auction(self, seller: Member, quality: Int, reserve: Int, first: Member, second: Member, third: Member) -> Bool {
        let bids: Array<Int> = [Stake(first, quality), Stake(second, quality), Stake(third, quality)];
        Log("-- auction: " + MemberName(seller) + " lists quality=" + ToString(quality) + " reserve=" + ToString(reserve) + " --");
        Log("[bids] " + MemberName(first) + "=" + ToString(bids[0])
            + " " + MemberName(second) + "=" + ToString(bids[1])
            + " " + MemberName(third) + "=" + ToString(bids[2]));
        match ClearAuction(bids, reserve) {
            case Ok(clearing):
                let buyer: Member = Winner(clearing.winner, first, second, third);
                Log("[clearing] winner=" + MemberName(buyer) + " price=" + ToString(clearing.price) + " tax=" + ToString(clearing.tax));
                let ok: Bool = Outcome("SettleAuction", Settle(seller, buyer, clearing));
                if ok {
                    Log("[market] " + hall.bond.Label() + "; " + hall.levy.Label());
                }
                return ok;
            case Err(error):
                Log("[clearing] no sale: " + AuctionErrorName(error));
                return false;
        }
    }

    func Report(self) -> Void {
        let purses: Array<Int> = guild.Purses();
        Log("-- season report --");
        Roll();
        Log("[supply] genesis=" + ToString(treasury.genesis)
            + " minted=" + ToString(treasury.mint.issued)
            + " burned=" + ToString(treasury.mint.burned)
            + " supply=" + ToString(treasury.supply)
            + " inflation=" + ToString((treasury.supply - treasury.genesis) * 100 / treasury.genesis) + "%");
        Log("[treasury] vault=" + ToString(treasury.vault) + " pending=" + ToString(treasury.pending));
        // 공개 카드는 refresh 투영이라 그 zone의 step이 마지막으로 동기화한 때의 값이다.
        Log("[cards] herald=" + guild.herald.name + "/" + ToString(guild.herald.renown)
            + " raid-leader=" + raid.leader.name + "/" + ToString(raid.leader.renown)
            + " forge-master=" + forge.master.name + "/" + ToString(forge.master.renown)
            + " auction-board=" + hall.board.name + "/" + ToString(hall.board.renown));
        Log("[spread] richest=" + ToString(HighestOf(purses))
            + " poorest=" + ToString(LowestOf(purses))
            + " relics=" + ToString(forge.forged)
            + " sales=" + ToString(hall.sales));
        Log("[books] " + Books());
    }
}
