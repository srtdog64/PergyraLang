// world/game_world.pgy — 상위 합성 경계
//
// 단일 책임: GameWorld 하나(zone 멤버 + 라우팅 func).
import "zone/market_zone.pgy";
import "zone/battle_zone.pgy";

world GameWorld {
    zone market: MarketZone
    zone battle: BattleZone

    func MarketSellerGold(self) -> Int {
        return self.market.seller.gold;
    }

    func BattleHeroAlive(self) -> Bool {
        return self.battle.hero.IsAlive();
    }
}
