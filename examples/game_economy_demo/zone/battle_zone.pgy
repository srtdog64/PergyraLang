// zone/battle_zone.pgy — 전투 존
//
// 단일 책임: BattleZone 하나.
import "subject/player.pgy";
import "subject/enemy.pgy";
import "effect/effects.pgy";

zone BattleZone {
    subject slot hero: Player
    subject slot foe: Enemy
    object slot heroView: PlayerSnapshot
    effect slot hit: Damaged
    authority hero requires Combatant
    refresh heroView from hero
}
