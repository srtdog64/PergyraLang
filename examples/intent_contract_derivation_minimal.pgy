// intent_contract_derivation_minimal.pgy
//
// 현재 구현된 surface compression 예제:
// 1. transfer target -> using/where derivation

subject Buyer {
    let hp: Int;

    action Promote(self) -> Void {
        self.hp = self.hp + 1;
    }
}

zone CartZone {
    subject slot buyer: Buyer
}

zone PaymentZone {
    subject slot buyer: Buyer
}

intent Checkout(cart: CartZone, payment: PaymentZone, buyer: Buyer) {
    step Promote {
        transfer: cart -> payment;
        on: buyer.Promote();
        expect: true;
    }
}

func Main() -> Void {
    Log("intent contract derivation minimal");
}
