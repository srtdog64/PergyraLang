import "common.pgy";
import "subjects/vessels.pgy";
import "subjects/abilities.pgy";
import "subjects/units.pgy";
import "subjects/roles.pgy";
import "zones/surfaces.pgy";
import "zones/layers.pgy";
import "zones/loading.pgy";
import "zones/delivery.pgy";
import "intents/logistics_intents.pgy";
import "world.pgy";
import "setup.pgy";

func CompletionState(world: LogisticsWorld) -> Int
{
    return world.completed;
}

func Main() -> Void
{
    let world = OpenLogisticsWorld();
    world.Broadcast(ProbeHeader());
    world.Broadcast(ProbeSubtitle());
    world.Blank();

    let mergeA = MergeRouteScore(true, 4);
    let mergeB = MergeRouteScore(false, 4);
    world.Broadcast("merge.true=" + ToString(mergeA));
    world.Broadcast("merge.false=" + ToString(mergeB));

    let ok = world.Route();
    if ok
    {
        world.completed = 1;
    }
    else
    {
        world.completed = 0;
    }
    world.Broadcast("[Intent] RouteCargo ok=" + ToString(ok));
    world.Broadcast("  [Runtime] name=" + IntentLastName() + " handle=" + ToString(IntentLastHandle()) + " failed=" + ToString(IntentLastFailed()));
    world.Broadcast("  [Runtime] steps=" + ToString(IntentLastStepCount()));
    world.Broadcast("  [Trace] " + IntentLastTrace());
    world.Broadcast("  [HistoryCount] " + ToString(IntentHistoryCount()));
    world.Blank();

    world.Broadcast(world.Audit(CompletionState(world)));
    world.FinalSnapshot();
    world.Blank();

    world.Broadcast("saving examples/logistics_intent_probe/results.txt");
    WriteFile("examples/logistics_intent_probe/results.txt", world.transcript + "\n");
}
