func OpenLogisticsWorld() -> LogisticsWorld
{
    let courier = Courier(
        "Ivo",
        "north-17",
        CargoState(0, 0, ""),
        0,
        0,
        "idle"
    );
    let dispatcher = Dispatcher(
        "Mara",
        DispatchLedger(0, 0, 0),
        "north",
        "idle"
    );
    let loading = LoadingZone(
        Clone(courier),
        Clone(dispatcher)
    );
    let delivery = DeliveryZone(
        Clone(courier),
        Clone(dispatcher)
    );

    return LogisticsWorld(
        loading,
        delivery,
        "",
        0
    );
}
