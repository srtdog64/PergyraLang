func BuildLoadingZone() -> LoadingZone
{
    let courier = Courier(
        "Ivo",
        "north-17",
        CargoState(0, 0, ""),
        0,
        0,
        "idle"
    );
    let dispatcher = Dispatcher(
        "Mara",
        DispatchLedger(0, 0, 0),
        "north",
        "idle"
    );
    return LoadingZone(
        Clone(courier),
        Clone(dispatcher)
    );
}

func BuildDeliveryZone() -> DeliveryZone
{
    let courier = Courier(
        "Ivo",
