role CourierRoute for Courier
{
    impl ability Routable
    {
        func RouteMark() -> String
        {
            return "route-ready";
        }
    }

    impl ability BatchReady<Int>
    {
        func BatchMark(value: Int) -> String
        {
            return "batch-" + ToString(value);
        }
    }
}

role DispatcherApprove for Dispatcher
{
    impl ability Approvable
    {
        func ApprovalMark() -> String
        {
            return "approval-ready";
        }
    }
}
