world LogisticsWorld
{
    zone loading: LoadingZone
    zone delivery: DeliveryZone

    shared transcript: String = ""
    shared completed: Int = 0

    activate loading
    activate delivery

    func Record(self, line: String) -> Void
    {
        if StringLength(transcript) == 0
        {
            transcript = line;
        }
        else
        {
            transcript = transcript + "\n" + line;
        }
    }

    func Broadcast(self, line: String) -> Void
    {
        Log(line);
        Record(line);
    }

    func Blank(self) -> Void
    {
        Log("");
        Record("");
    }

    func Route(self) -> Bool
    {
        return RouteCargo(
            loading,
            delivery,
            loading.courier,
            loading.dispatcher
        );
    }

    func Audit(self, completionState: Int) -> String
    {
        let bias = 0;
        if completionState > 0
        {
            bias = bias + 2;
        }
        else
        {
            bias = bias + 1;
        }
        return "audit loading=" + ToString(loading.staged)
            + " lane=" + delivery.route.lane
            + " seal=" + ToString(delivery.seal.qty)
            + " bias=" + ToString(bias);
    }

    func FinalSnapshot(self) -> Void
    {
        Broadcast("loading=" + loading.Snapshot());
        Broadcast("delivery=" + delivery.Snapshot());
        Broadcast("courier=" + loading.courier.Summary());
        Broadcast("dispatcher=" + loading.dispatcher.Summary());
        Broadcast("route=" + delivery.route.Label());
        Broadcast("seal=" + delivery.seal.Label());
    }
}
