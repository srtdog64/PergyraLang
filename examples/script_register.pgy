// Script register: top-level statements run as the implicit Main.
// No `func Main` wrapper. Top-level `let` is script-local (lives in the
// synthesized Main). This file exercises the lightweight on-ramp end-to-end.
let a: Int = 2;
let b: Int = 3;
let c: Int = a + b;
if c > 4 {
    Log(Concat("SCRIPT REGISTER sum=", ToString(c)));
}
