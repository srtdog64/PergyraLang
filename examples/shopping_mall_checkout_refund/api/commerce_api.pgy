use http;

dto CheckoutIntentRequest
{
    let transport: HttpIntentRequest;
    let shipping: Int;
}

dto RefundIntentRequest
{
    let transport: HttpIntentRequest;
    let ticketSeed: Int;
}

dto ProfileSyncRequest
{
    let transport: HttpIntentRequest;
    let marketing: Int;
}

dto IntentApiResponse
{
    let transport: HttpIntentResponse;
}

func RenderIntentApiResponse(response: IntentApiResponse) -> String
{
    return "[Adapter] " + response.transport.intentName
        + " ok=" + ToString(response.transport.ok)
        + " handle=" + ToString(response.transport.handle)
        + " failed=" + ToString(response.transport.failed)
        + " steps=" + ToString(response.transport.stepCount);
}

func BuildCheckoutIntentRequest(cart: CartZone, shipping: Int) -> CheckoutIntentRequest
{
    let request = PostJson(
        "/api/intents/CheckoutPurchase",
        "{\"route\":\"" + cart.route + "\",\"shipping\":" + ToString(shipping) + "}",
        4101
    );
    return CheckoutIntentRequest(
        BuildIntentRequest("CheckoutPurchase", cart.buyer.name, request),
        shipping
    );
}

func BuildRefundIntentRequest(payment: PaymentZone, ticketSeed: Int) -> RefundIntentRequest
{
    let request = PostJson(
        "/api/intents/RefundPurchase",
        "{\"route\":\"" + payment.route + "\",\"ticketSeed\":" + ToString(ticketSeed) + "}",
        4102
    );
    return RefundIntentRequest(
        BuildIntentRequest("RefundPurchase", payment.buyer.name, request),
        ticketSeed
    );
}

func BuildProfileSyncRequest(refund: RefundZone, marketing: Int) -> ProfileSyncRequest
{
    let request = PostJson(
        "/api/intents/SyncAccountProfile",
        "{\"route\":\"" + refund.route + "\",\"marketing\":" + ToString(marketing) + "}",
        4103
    );
    return ProfileSyncRequest(
        BuildIntentRequest("SyncAccountProfile", refund.buyer.name, request),
        marketing
    );
}

func HandleCheckoutIntent(cart: CartZone, payment: PaymentZone, buyer: Member, merchant: Merchant, req: CheckoutIntentRequest) -> IntentApiResponse
{
    let ok = CheckoutPurchase(cart, payment, buyer, merchant);
    let body = "{\"ok\":" + ToString(ok)
        + ",\"intent\":\"" + IntentLastName()
        + "\",\"handle\":" + ToString(IntentLastHandle())
        + ",\"steps\":" + ToString(IntentLastStepCount()) + "}";
    return IntentApiResponse(BuildIntentResponse(
        ok,
        IntentLastName(),
        IntentLastHandle(),
        IntentLastFailed(),
        IntentLastStepCount(),
        JsonResponse(body)
    ));
}

func HandleRefundIntent(payment: PaymentZone, refund: RefundZone, buyer: Member, merchant: Merchant, req: RefundIntentRequest) -> IntentApiResponse
{
    let ok = RefundPurchase(payment, refund, buyer, merchant);
    let body = "{\"ok\":" + ToString(ok)
        + ",\"intent\":\"" + IntentLastName()
        + "\",\"handle\":" + ToString(IntentLastHandle())
        + ",\"steps\":" + ToString(IntentLastStepCount()) + "}";
    return IntentApiResponse(BuildIntentResponse(
        ok,
        IntentLastName(),
        IntentLastHandle(),
        IntentLastFailed(),
        IntentLastStepCount(),
        JsonResponse(body)
    ));
}

func HandleProfileSyncIntent(refund: RefundZone, account: AccountZone, buyer: Member, req: ProfileSyncRequest) -> IntentApiResponse
{
    let ok = SyncAccountProfile(refund, account, buyer);
    let body = "{\"ok\":" + ToString(ok)
        + ",\"intent\":\"" + IntentLastName()
        + "\",\"handle\":" + ToString(IntentLastHandle())
        + ",\"steps\":" + ToString(IntentLastStepCount()) + "}";
    return IntentApiResponse(BuildIntentResponse(
        ok,
        IntentLastName(),
        IntentLastHandle(),
        IntentLastFailed(),
        IntentLastStepCount(),
        JsonResponse(body)
    ));
}
