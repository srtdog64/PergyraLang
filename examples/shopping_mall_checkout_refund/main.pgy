use http;
use storage;
use page;

import "common.pgy";
import "subjects/vessels.pgy";
import "subjects/abilities.pgy";
import "subjects/commerce.pgy";
import "subjects/roles.pgy";
import "pages/surfaces.pgy";
import "api/commerce_api.pgy";
import "report/transcript_report.pgy";
import "zones/layers.pgy";
import "zones/cart.pgy";
import "zones/payment.pgy";
import "zones/refund.pgy";
import "zones/account.pgy";
import "intents/commerce_intents.pgy";
import "world.pgy";
import "setup.pgy";

func Main() -> Void
{
    let world = OpenCommerceWorld();
    world.Broadcast(CommerceHeader());
    world.Broadcast(CommerceSubtitle());
    world.Blank();

    world.Broadcast("[Scene] storefront opens with a JS cart page over a Pergyra backend.");
    world.cart.buyer.AddFeatured(2);
    world.cart.buyer.ApplyPromo(7);
    world.cart.Touch();
    world.ShowCart();
    world.Blank();

    world.flowState = "checkout";
    let checkoutReq = BuildCheckoutIntentRequest(Clone(world.cart), 6);
    world.Broadcast(RenderHttpRequest(checkoutReq.transport.request));
    let checkoutRes = HandleCheckoutIntent(Clone(world.cart), Clone(world.payment), world.cart.buyer, world.cart.merchant, checkoutReq);
    world.BroadcastIntentApi(checkoutRes);
    world.BroadcastIntentHistory();
    world.ShowCheckout();
    world.Blank();

    world.flowState = "refund";
    let refundReq = BuildRefundIntentRequest(Clone(world.payment), 8831);
    world.Broadcast(RenderHttpRequest(refundReq.transport.request));
    let refundRes = HandleRefundIntent(Clone(world.payment), Clone(world.refund), world.cart.buyer, world.cart.merchant, refundReq);
    world.BroadcastIntentApi(refundRes);
    world.BroadcastIntentHistory();
    world.ShowRefund();
    world.Blank();

    world.flowState = "account";
    let profileReq = BuildProfileSyncRequest(Clone(world.refund), 1);
    world.Broadcast(RenderHttpRequest(profileReq.transport.request));
    let profileRes = HandleProfileSyncIntent(Clone(world.refund), Clone(world.account), world.cart.buyer, profileReq);
    world.BroadcastIntentApi(profileRes);
    world.BroadcastIntentHistory();
    world.ShowProfile();
    world.Blank();

    world.Broadcast("[Summary] all page routes are projections; all state changes went through intents and zones.");
    world.FinalSnapshot();
    let saved = SaveCommerceReport(
        "examples/shopping_mall_checkout_refund/results.txt",
        world.route,
        world.flowState,
        world.transcript,
        world.cart.buyer,
        world.cart.merchant,
        Clone(world.cart),
        Clone(world.payment),
        Clone(world.refund),
        Clone(world.account)
    );
    world.Broadcast(RenderStorageWrite(saved));
}
