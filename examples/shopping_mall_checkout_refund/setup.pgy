func BuildFeaturedProduct() -> ProductSpec
{
    return ProductSpec("SKU-EMBER-01", "Ember Lantern", 42, "lighting");
}

func BuildPaymentMethod() -> PaymentMethod
{
    return PaymentMethod("VISA", "****-1024", 1);
}

func BuildCartZone() -> CartZone
{
    let featured = BuildFeaturedProduct();
    let payment = BuildPaymentMethod();
    let buyer = Member(
        "Hana",
        "gold",
        featured,
        payment,
        CartState(0, 0, 0, 0, ""),
        WalletState(250, 0, 0, 0),
        RefundState(0, 0, "", "idle"),
        AccountState("hana@pergyra.shop", 0, 0, "/", "none"),
        0,
        0,
        0,
        "idle"
    );
    let merchant = Merchant(
        "Northwind Store",
        featured,
        MerchantLedger(0, 0, 0, 0, 0),
        0,
        0,
        "idle"
    );
    return CartZone(
        Clone(buyer),
        Clone(merchant),
        BuildBuyerZoneView(buyer),
        BuildMerchantZonePacket(merchant),
        "/cart",
        "cart",
        0,
        0
    );
}

