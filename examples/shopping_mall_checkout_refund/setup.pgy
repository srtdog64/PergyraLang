func OpenCommerceWorld() -> CommerceWorld
{
    let featured = BuildFeaturedProduct();
    let paymentMethod = BuildPaymentMethod();
    let buyer = Member(
        "Hana",
        "gold",
        featured,
        paymentMethod,
        CartState(0, 0, 0, 0, ""),
        WalletState(250, 0, 0, 0),
        RefundState(0, 0, "", "idle"),
        AccountState("hana@pergyra.shop", 0, 0, "/", "none"),
        0,
        0,
        0,
        "idle"
    );
    let merchant = Merchant(
        "Northwind Store",
        featured,
        MerchantLedger(0, 0, 0, 0, 0),
        0,
        0,
        "idle"
    );
    let cart = CartZone(
        Clone(buyer),
        Clone(merchant),
        BuildBuyerZoneView(buyer),
        BuildMerchantZonePacket(merchant),
        "/cart",
        "cart",
        0,
        0
    );
    let payment = PaymentZone(
        Clone(buyer),
        Clone(merchant),
        BuildBuyerZoneView(buyer),
        BuildMerchantZonePacket(merchant),
        "/checkout",
        4101,
        0,
        0,
        "pending"
    );
    let refund = RefundZone(
        Clone(buyer),
        Clone(merchant),
        BuildBuyerZoneView(buyer),
        BuildMerchantZonePacket(merchant),
        "/refund",
        0,
        0,
        "idle"
    );
    let account = AccountZone(
        Clone(buyer),
        "/account/profile",
        "view",
        0
    );

    return CommerceWorld(
        cart,
        payment,
        refund,
        account,
        "",
        "/cart",
        "cart"
    );
}
