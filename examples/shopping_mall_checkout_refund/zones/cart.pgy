zone CartZone
{
    subject slot buyer: Member
    subject slot merchant: Merchant
    object slot buyerView: BuyerZoneView
    tobject slot merchantPacket: MerchantZonePacket

    refresh buyerView from buyer by buyer
    publish merchantPacket from merchant by merchant

    shared route: String = "/cart"
    shared stage: String = "cart"
    shared lastTotal: Int = 0
    shared coupon: Int = 0

    authority buyer requires Purchasable
    authority merchant requires Merchanting

    func Touch(self) -> Int
    {
        buyer.BrowseCart();
        lastTotal = buyer.cart.GrandTotal();
        coupon = buyer.cart.coupon;
        stage = "ready";
        return lastTotal;
    }

    func Snapshot(self) -> String
    {
        return route
            + " total=" + ToString(lastTotal)
            + " coupon=" + ToString(coupon)
            + " buyer=" + buyer.name;
    }
}
