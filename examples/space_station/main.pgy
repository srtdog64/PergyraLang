// main.pgy -- Space Station simulation entry point
// BSD (Allman) style
// Tests: multi-file import, subject param passing, general func + action,
//        vessel read-only, Random, for-in, while, if/else, match, enum, string ops

import "types.pgy";
import "vessels.pgy";
import "abilities.pgy";
import "crew.pgy";
import "domains.pgy";

// ============================================================
// Free functions -- take subjects by auto-reference
// ============================================================

func ShowCrew(member: CrewMember) -> Void
{
    let eff = member.CalculateEfficiency();
    let info: String = "  " + member.name + " [" + member.role_name + "]";
    let hp: String = " HP:" + ToString(member.vitals.health) + "/" + ToString(member.vitals.health_max);
    let sta: String = " STA:" + ToString(member.vitals.stamina) + "/" + ToString(member.vitals.stamina_max);
    let tail: String = " Eff:" + ToString(eff) + "%";
    Log(info + hp + sta + tail);
}

func SimulateRadiation(crew: CrewMember) -> Void
{
    let dose = Random(10) + 1;
    crew.TakeDamage(dose);
    Log("  [RADIATION] " + crew.name + " takes " + ToString(dose) + " radiation damage");
}

func SimulateRepair(engineer: CrewMember) -> Void
{
    let check: Bool = engineer.RollSkillCheck("engineering", 12);
    if check
    {
        let points = engineer.skills.engineering * 2 + Random(5);
        engineer.Work(8);
        Log("  [REPAIR] " + engineer.name + " repairs system for " + ToString(points) + " points");
    }
    else
    {
        engineer.Work(4);
        Log("  [REPAIR] " + engineer.name + " fails the repair check");
    }
}

func SimulateHealing(medic: CrewMember, patient: CrewMember) -> Void
{
    let check: Bool = medic.RollSkillCheck("medical", 10);
    if check
    {
        let heal = medic.skills.medical * 2 + Random(5);
        patient.vitals.health = Min(patient.vitals.health + heal, patient.vitals.health_max);
        medic.Work(6);
        Log("  [HEAL] " + medic.name + " heals " + patient.name + " for " + ToString(heal));
    }
    else
    {
        medic.Work(3);
        Log("  [HEAL] " + medic.name + " fails to heal " + patient.name);
    }
}

func SimulateRest(crew: CrewMember) -> Void
{
    let recovered = crew.Rest();
    Log("  [REST] " + crew.name + " recovers " + ToString(recovered) + " stamina");
}

// ============================================================
// Main simulation
// ============================================================

Log("========================================");
Log("  SPACE STATION ALPHA -- Day Simulation");
Log("========================================");
Log("");

// Create crew
let captain = CrewMember("Captain Park", "Commander", VitalSigns(100, 100, 80, 100), SkillSet(5, 3, 8));
let engineer = CrewMember("Engineer Kim", "Engineer", VitalSigns(90, 90, 100, 100), SkillSet(9, 2, 4));
let medic = CrewMember("Dr. Lee", "Medic", VitalSigns(80, 80, 90, 100), SkillSet(3, 9, 2));
let rookie = CrewMember("Cadet Choi", "Trainee", VitalSigns(100, 100, 100, 100), SkillSet(2, 2, 3));

Log("== Crew Roster ==");
ShowCrew(captain);
ShowCrew(engineer);
ShowCrew(medic);
ShowCrew(rookie);
Log("");

// Day simulation
let turn = 1;
let running = true;

while running
{
    Log("-- Hour " + ToString(turn) + " --");

    // Random event
    let roll = Random(4);

    if roll == 0
    {
        // Radiation leak
        Log("  [EVENT] Radiation leak in engineering!");
        SimulateRadiation(engineer);
        SimulateRadiation(rookie);
    }

    if roll == 1
    {
        // System malfunction
        Log("  [EVENT] System malfunction detected!");
        SimulateRepair(engineer);
    }

    if roll == 2
    {
        // Injury
        let injury = Random(15) + 5;
        Log("  [EVENT] " + rookie.name + " injured during EVA!");
        rookie.TakeDamage(injury);
        Log("  " + rookie.name + " takes " + ToString(injury) + " damage");
        SimulateHealing(medic, rookie);
    }

    if roll == 3
    {
        // Quiet shift
        Log("  [EVENT] Quiet shift. Crew rests.");
        SimulateRest(captain);
        SimulateRest(engineer);
        SimulateRest(medic);
        SimulateRest(rookie);
    }

    // Status check
    Log("");
    ShowCrew(captain);
    ShowCrew(engineer);
    ShowCrew(medic);
    ShowCrew(rookie);
    Log("");

    // Check if anyone is down
    let captain_ok: Bool = captain.IsOperational();
    let engineer_ok: Bool = engineer.IsOperational();
    let medic_ok: Bool = medic.IsOperational();
    let rookie_alive: Bool = rookie.vitals.IsAlive();

    if !captain_ok
    {
        Log("  [ALERT] Captain is down! Simulation ends.");
        running = false;
    }
    if !engineer_ok
    {
        Log("  [ALERT] Engineer is down! Systems failing.");
    }
    if !medic_ok
    {
        Log("  [ALERT] Medic is exhausted! No healing available.");
    }
    if !rookie_alive
    {
        Log("  [ALERT] Cadet is KIA!");
        running = false;
    }

    if turn >= 8
    {
        Log("  [END] Shift complete after " + ToString(turn) + " hours.");
        running = false;
    }

    turn = turn + 1;
}

Log("");
Log("========================================");
Log("  FINAL STATUS");
Log("========================================");
ShowCrew(captain);
ShowCrew(engineer);
ShowCrew(medic);
ShowCrew(rookie);
Log("========================================");
