// subject_object_dto.pgy — subject/object/dto 존재론 분리
//
// subject = 상태와 identity를 가진 능동 주체
// object  = subject에서 파생된 수동 투영 (읽기 전용 뷰)
// dto     = 외부 경계용 축약 투영 (IPC/API)

subject Player {
    let name: String;
    let hp: Int;
    let level: Int;
    let score: Int;
}

// object: subject의 필드 부분집합으로 읽기 전용 뷰
object PlayerView {
    let name: String;
    let hp: Int;
}

// dto: 외부 전송용 경량 투영
dto PlayerSummary {
    let name: String;
    let level: Int;
}

func Main() -> Void {
    let p: Player = Player("Alice", 100, 5, 2500);
    Log(p.name);
    Log(p.hp);

    // ToObject: subject → object 투영
    let view: PlayerView = ToObject(PlayerView, p);
    Log(view.name);
    Log(view.hp);

    // ToDto: subject → dto 투영
    let summary: PlayerSummary = ToDto(PlayerSummary, p);
    Log(summary.name);
    Log(summary.level);
}
