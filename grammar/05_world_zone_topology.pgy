// World topology.
//
// A world is a larger ownership/topology boundary. A zone can exist on its own,
// but once a zone is embedded in a world, the world-owned slot is the authority
// path. That is why this example uses `Clone(...)` at containment boundaries.

// The subject is the state-bearing value that zones will contain.
subject Buyer {
    let mut hp: Int;
}

// Passive projection value used inside zones.
object BuyerView {
    hp: Int;
}

// Zone declarations own resource slots.
zone CartZone {
    subject slot buyer: Buyer
    object slot mirror: BuyerView
    refresh mirror from buyer
}

// A second zone with its own subject slot.
zone PaymentZone {
    subject slot buyer: Buyer
    object slot receipt: BuyerView
    refresh receipt from buyer
}

// A world owns zone slots. Like zone slot declarations, these are topology
// declarations, so they are written without semicolons.
world CheckoutWorld {
    zone cart: CartZone
    zone payment: PaymentZone
}

func Main() -> Void {
    let buyer: Buyer = Buyer(7);

    // Clone makes the boundary fork explicit. Without it, construction would
    // silently copy a live subject into a zone-owned slot, which is rejected.
    let cart: CartZone = CartZone(Clone(buyer));
    let payment: PaymentZone = PaymentZone(Clone(buyer));

    // The same rule applies when embedding zones into a world.
    let checkout: CheckoutWorld = CheckoutWorld(Clone(cart), Clone(payment));

    Log("checkout-world");
}
