// site/pergyra_home.pgy
//
// The official Pergyra homepage, generated BY Pergyra. This program builds the
// page as text and prints it to stdout; `site/build.sh` redirects that into
// site/dist/index.html. Pergyra does not run in the browser (no WASM backend
// yet) -- it GENERATES the page, the same text-emission capability the
// self-host compiler uses to emit C. The browser plays the webtoon-style
// sequential animation the generator writes.
//
// HTML attributes use single quotes so the Pergyra double-quoted string
// literals need no escaping.

func Gyri() -> Void {
    Log("<svg class='gyri' viewBox='0 0 100 100' width='96' height='96' role='img' aria-label='Gyri the nautilus mascot'>");
    Log("<path d='M50 52 C50 36 76 34 78 52 C80 74 48 80 38 64 C28 48 44 30 64 30 C86 30 92 60 74 76 C54 94 22 78 22 52 C22 24 50 12 74 22' fill='none' stroke='#EF9F27' stroke-width='6' stroke-linecap='round'/>");
    Log("<circle cx='50' cy='52' r='20' fill='#EF9F27' stroke='#26215C' stroke-width='3'/>");
    Log("<path d='M50 52 L62 40 M50 52 L66 52 M50 52 L62 66 M50 52 L50 70 M50 52 L36 64' stroke='#26215C' stroke-width='2.5' fill='none' stroke-linecap='round'/>");
    Log("<circle cx='44' cy='48' r='4.5' fill='#fff' stroke='#26215C' stroke-width='2'/>");
    Log("<circle cx='45' cy='49' r='2' fill='#26215C'/>");
    Log("<path d='M22 56 q-6 2 -9 8 M22 60 q-7 4 -8 11' stroke='#534AB7' stroke-width='3' fill='none' stroke-linecap='round'/>");
    Log("</svg>");
}

func Style() -> Void {
    Log("<style>");
    Log("*{box-sizing:border-box}");
    Log("body{margin:0;font-family:ui-sans-serif,system-ui,'Apple SD Gothic Neo',sans-serif;background:#FAEEDA;color:#26215C;-webkit-font-smoothing:antialiased}");
    Log(".wrap{max-width:560px;margin:0 auto;padding:48px 18px 80px}");
    Log(".panel{opacity:0;transform:translateY(22px);border:3px solid #26215C;border-radius:18px;background:#fff;padding:20px 22px;margin:0 0 20px;animation:reveal .55s cubic-bezier(.2,.8,.2,1) forwards}");
    Log(".panel:nth-of-type(1){animation-delay:.15s}");
    Log(".panel:nth-of-type(2){animation-delay:.95s}");
    Log(".panel:nth-of-type(3){animation-delay:1.75s}");
    Log(".panel:nth-of-type(4){animation-delay:2.55s}");
    Log(".panel:nth-of-type(5){animation-delay:3.35s}");
    Log(".panel:nth-of-type(6){animation-delay:4.15s}");
    Log(".panel:nth-of-type(7){animation-delay:4.95s}");
    Log("@keyframes reveal{to{opacity:1;transform:translateY(0)}}");
    Log("@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}");
    Log(".row{display:flex;gap:16px;align-items:flex-start}");
    Log(".gyri{flex:0 0 96px;animation:float 3.2s ease-in-out infinite}");
    Log(".title{font-size:34px;font-weight:600;color:#534AB7;letter-spacing:-.5px;margin:0}");
    Log(".tag{font-size:14px;color:#854F0B;margin:4px 0 0}");
    Log(".bubble{position:relative;background:#EF9F27;color:#412402;border:3px solid #26215C;border-radius:16px;padding:14px 16px;font-size:16px;line-height:1.55;flex:1}");
    Log(".bubble::before{content:'';position:absolute;left:-13px;top:22px;border:8px solid transparent;border-right-color:#26215C}");
    Log(".bubble::after{content:'';position:absolute;left:-8px;top:24px;border:6px solid transparent;border-right-color:#EF9F27}");
    Log(".lost{text-decoration:line-through;text-decoration-color:#EF9F27;text-decoration-thickness:3px;color:#9a93b5}");
    Log(".code{font-family:ui-monospace,'SF Mono',Menlo,monospace;font-size:14px;background:#26215C;color:#EEEDFE;border-radius:10px;padding:14px 16px;border:3px solid #26215C;white-space:pre;line-height:1.55;overflow-x:auto}");
    Log(".kw{color:#FAC775}");
    Log(".meta{font-size:14px;color:#854F0B;margin:0 0 10px}");
    Log("code{font-family:ui-monospace,'SF Mono',Menlo,monospace;font-size:13px;background:#F2E4C8;border-radius:6px;padding:1px 5px}");
    Log("a{color:#534AB7;font-weight:600}");
    Log(".census{font-size:15px;line-height:1.6;margin:0}");
    Log(".cmt{color:#9a93d9}");
    Log(".by{text-align:center;font-size:13px;color:#9a8f6a;margin:8px 0 0}");
    Log("</style>");
}

func Main() -> Void {
    Log("<!DOCTYPE html>");
    Log("<html lang='ko'><head>");
    Log("<meta charset='utf-8'>");
    Log("<meta name='viewport' content='width=device-width,initial-scale=1'>");
    Log("<title>Pergyra</title>");
    Style();
    Log("</head><body><main class='wrap'>");

    Log("<section class='panel'><div class='row'>");
    Gyri();
    Log("<div style='flex:1'><h1 class='title'>Pergyra</h1><p class='tag'>도메인 의미를 되찾는 시스템 언어</p>");
    Log("<div class='bubble' style='margin-top:10px'>안녕! 난 Gyri야. 한 칸씩 보여줄게.</div></div>");
    Log("</div></section>");

    Log("<section class='panel'><div class='row'>");
    Log("<div class='bubble'>코드를 쓰면 <span class='lost'>누가·왜·어디까지</span> 가 사라져. Pergyra는 그걸 문법으로 되살려.</div>");
    Log("</div></section>");

    Log("<section class='panel'>");
    Log("<p class='meta'>그래서 의미가 1급 문법이 돼:</p>");
    Log("<pre class='code'><span class='kw'>action</span> Strike(self, target: Player) -> Int");
    Log("    <span class='kw'>requires</span> Striking       <span class='cmt'>// 자격 — 왜 할 수 있나</span>");
    Log("    <span class='kw'>within</span> Arena            <span class='cmt'>// 무대 — 어디서</span>");
    Log("    <span class='kw'>authorized by</span> self      <span class='cmt'>// 권한 — 누가</span>");
    Log("    <span class='kw'>with caps</span> io_read       <span class='cmt'>// 예산 — 어디까지</span>");
    Log("{ ... }</pre>");
    Log("</section>");

    Log("<section class='panel'><div class='row'>");
    Log("<div class='bubble'>그리고 이 페이지 자체를 <b>Pergyra가 생성</b>해. 언어가 자기 홈을 짓는 거지.</div>");
    Log("</div></section>");

    Log("<section class='panel'>");
    Log("<p class='meta'>문법 한눈에 — 세계는 다섯 자리 문장으로 선언돼:</p>");
    Log("<pre class='code'><span class='kw'>subject</span> Player { <span class='kw'>let</span> hp: Int; }");
    Log("<span class='kw'>ability</span> Striking { <span class='kw'>fields</span> attack: Int; <span class='kw'>func</span> Strike() -> Int; }");
    Log("<span class='kw'>role</span> Striker <span class='kw'>for</span> Player { <span class='kw'>impl ability</span> Striking { ... } }");
    Log("<span class='kw'>zone</span> Arena {");
    Log("  <span class='kw'>subject slot</span> hero: Player");
    Log("  <span class='kw'>authority</span> hero");
    Log("}");
    Log("<span class='kw'>world</span> Game { <span class='kw'>zone</span> arena: Arena  <span class='kw'>activate</span> arena }</pre>");
    Log("</section>");

    Log("<section class='panel'><div class='row'>");
    Log("<div class='bubble'>구두점도 의미야. 코드 층은 <b>;</b>로 &quot;일어난다&quot;를 말하고, zone·world·effect·relation 본문의 세계 사실은 <b>종결 없이</b> &quot;이다&quot;를 말해.</div>");
    Log("</div></section>");

    Log("<section class='panel'>");
    Log("<p class='meta'>언어 단어 전수 — 한 파일이 소유:</p>");
    Log("<p class='census'>예약어 <b>70</b> · 문맥어 <b>73</b> · soft <b>3</b> = <b>146</b> 단어.");
    Log("원장은 <code>src/lexer/language_keyword_registry.def</code>,");
    Log("사람용 레퍼런스는 <a href='https://github.com/srtdog64/PergyraLang/tree/main/docs/grammar'>docs/grammar</a> (치트시트 → 문법 → 형식 레퍼런스).</p>");
    Log("</section>");

    Log("<p class='by'>generated by pergyra · site/pergyra_home.pgy</p>");
    Log("</main></body></html>");
}
