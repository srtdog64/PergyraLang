/*
 * Canonical reserved-keyword registry.
 *
 * PGY_LANGUAGE_KEYWORD(
 *     spelling, class, token identity, debug identity, broad context mask,
 *     semantic axis, implementation support, tooling support)
 *
 * Rows are bytewise sorted by spelling because lexer_lookup_keyword() uses
 * binary search. Context, axis, support, and tooling fields are descriptive
 * inventory facts; token identity and debug identity are executable facts.
 * Future contextual/soft rows use PGY_KEYWORD_TOKEN_NONE: lookup keeps their
 * lexical identity as TOKEN_IDENTIFIER and reserved-token debug lookup skips
 * them, while row consumers may still use their debug/tooling vocabulary.
 */
PGY_LANGUAGE_KEYWORD(
    "ability", PGY_KEYWORD_CLASS_RESERVED, TOKEN_ABILITY, "ABILITY",
    PGY_KEYWORD_CONTEXT_DECLARATION | PGY_KEYWORD_CONTEXT_TYPE,
    PGY_KEYWORD_AXIS_TYPE_CONTRACT,
    PGY_KEYWORD_SUPPORT_NATIVE | PGY_KEYWORD_SUPPORT_SELF_HOST,
    PGY_KEYWORD_TOOLING_COMPLETION | PGY_KEYWORD_TOOLING_HIGHLIGHT)
PGY_LANGUAGE_KEYWORD(
    "as", PGY_KEYWORD_CLASS_RESERVED, TOKEN_AS, "AS",
