// MIR-bound AIR certificate for the bounded direct CFG replacement rung.
//
// Issuance validates typed MIR/CFG/phi owners once. Ready checks use only the
// certificate's fixed-size fields and self-digests; no serialized AIR, MIR,
// AST, source syntax, or expression graph is reopened after issuance.

import "../mir_lower/mir_json_input_owner.pgy";
import "../mir_lower/routine_fact_index_owner.pgy";
import "../mir_lower/routine_instruction_use_fact_owner.pgy";
import "../mir_lower/phi_fact_owner.pgy";
import "../compiler/air_evidence_owner.pgy";
import "mir_cfg_identity_owner.pgy";
import "mir_nested_cfg_certificate_fact_owner.pgy";
import "mir_loop_cfg_certificate_fact_owner.pgy";
import "mir_range_cfg_certificate_fact_owner.pgy";
import "mir_cfg_certificate_fact_owner.pgy";

func DirectMirCfgCertificateFromIndex(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    ref index: MirRoutineFactIndex,
    ref use_facts: MirRoutineInstructionUseFacts
) -> DirectMirCfgCertificate {
    let block_count: Int = ArrayLength(index.block_starts);
    if !CompilerAirEvidenceEnvelopeReady() ||
        !admitted.document.valid || !index.valid ||
        !MirRoutineInstructionUseFactsReady(
            use_facts, ArrayLength(index.instruction_facts.starts)
        ) {
        return DirectMirCfgCertificateEmpty();
    }
    if (block_count != 3 && block_count != 4 && block_count != 5) ||
        block_count != ArrayLength(index.block_ends) ||
        block_count != ArrayLength(index.block_reachable) ||
        block_count != ArrayLength(index.backedge_headers) ||
        block_count != ArrayLength(index.block_succ_true) ||
        block_count != ArrayLength(index.block_succ_false) ||
        block_count != ArrayLength(index.block_has_conditional_branch) ||
        block_count != ArrayLength(index.block_structural_merges) ||
        block_count != ArrayLength(index.block_instruction_starts) ||
        block_count != ArrayLength(index.block_instruction_counts) ||
        block_count != ArrayLength(
            index.instruction_facts.block_phi_prefix_counts
        ) {
        return DirectMirCfgCertificateEmpty();
    }
    if admitted.routines.source_json != admitted.document.root.json ||
        admitted.routines.source_length != StringLength(
            admitted.routines.source_json
        ) || index.routine_start != admitted.routines.starts[0] ||
        index.routine_end != admitted.routines.ends[0] ||
        StringLength(index.source_syntax_id) == 0 {
        return DirectMirCfgCertificateEmpty();
    }

    let entry: Int = 0;
    let true_block: Int = index.block_succ_true[entry];
    let false_block: Int = index.block_succ_false[entry];
    let merge_block: Int = index.block_structural_merges[entry];
    let nested: DirectMirNestedCfgCertificateFact =
        DirectMirNestedCfgCertificateFactEmpty();
    let loop_fact: DirectMirLoopCfgCertificateFact =
        DirectMirLoopCfgCertificateFactEmpty();
    let range_fact: DirectMirRangeCfgCertificateFact =
        DirectMirRangeCfgCertificateFactEmpty();
    if block_count == 4 &&
        ArrayLength(index.loop_flow_summary_kinds) == 1 &&
        index.loop_flow_summary_kinds[0] == 1 {
        range_fact = DirectMirRangeCfgCertificateFactFromIndex(
            admitted, index, use_facts
        );
    } else if block_count == 4 && true_block >= 0 &&
        true_block < block_count && index.backedge_headers[true_block] == 1 {
        loop_fact = DirectMirLoopCfgCertificateFactFromIndex(
            admitted, index, use_facts
        );
    }
    if block_count == 5 {
        nested = DirectMirNestedCfgCertificateFactFromIndex(
            admitted, index, use_facts
        );
    }
    let nested_ready: Bool = DirectMirNestedCfgCertificateFactReady(nested);
    let loop_ready: Bool = DirectMirLoopCfgCertificateFactReady(loop_fact);
    let range_ready: Bool =
        DirectMirRangeCfgCertificateFactReady(range_fact);
    if !range_ready &&
        (ArrayLength(index.iteration_type_facts.iteration_syntax_ids) != 0 ||
         ArrayLength(index.iteration_type_facts.function_syntax_ids) != 0 ||
         ArrayLength(index.iteration_type_facts.binding_types) != 0 ||
         ArrayLength(index.iteration_type_facts.iterable_types) != 0 ||
         ArrayLength(index.iteration_type_facts.collection_hoists) != 0) {
        Die("direct MIR CFG iteration facts require a range certificate");
    }
    if ArrayLength(index.loop_flow_summary_loop_ids) > 0 &&
        !loop_ready && !range_ready {
        Die("direct MIR loop CFG certificate fact was not issued");
    }
    if !MirRoutineFactIndexLoopFlowFactsValid(index) ||
        (!loop_ready && !range_ready &&
            (ArrayLength(index.loop_flow_summary_loop_ids) != 0 ||
             ArrayLength(index.loop_flow_state_stable_indices) != 0)) {
        Die("direct MIR CFG loop-flow fact inventory is invalid");
    }
    if block_count == 5 && !nested_ready {
        Die("direct MIR nested CFG issued topology fact is invalid");
    }
    if loop_ready {
        entry = loop_fact.preheader_block;
        true_block = loop_fact.body_block;
        false_block = loop_fact.exit_block;
        merge_block = loop_fact.header_block;
    } else if range_ready {
        entry = range_fact.preheader_block;
        true_block = range_fact.body_block;
        false_block = range_fact.exit_block;
        merge_block = range_fact.header_block;
    }
    let direct_false_edge: Bool =
        !loop_ready && !range_ready &&
        (block_count == 3 || nested_ready) &&
        false_block == merge_block;
    if true_block < 0 || true_block >= block_count ||
        false_block < 0 || false_block >= block_count ||
        merge_block < 0 || merge_block >= block_count ||
        entry == true_block || entry == false_block ||
        entry == merge_block || true_block == false_block ||
        true_block == merge_block ||
        (!direct_false_edge && false_block == merge_block) {
        if loop_ready || range_ready {
            Die("direct MIR loop CFG role binding is invalid");
        }
        return DirectMirCfgCertificateEmpty();
    }
    if loop_ready {
        if entry != loop_fact.preheader_block ||
            true_block != loop_fact.body_block ||
            false_block != loop_fact.exit_block ||
            merge_block != loop_fact.header_block {
            Die("direct MIR loop CFG outer role binding is invalid");
        }
    } else if range_ready {
        if entry != range_fact.preheader_block ||
            true_block != range_fact.body_block ||
            false_block != range_fact.exit_block ||
            merge_block != range_fact.header_block {
            Die("direct MIR range CFG outer role binding is invalid");
        }
    } else if nested_ready {
        if true_block != nested.branch_block ||
            false_block != nested.outer_merge_block ||
            merge_block != nested.outer_merge_block {
            return DirectMirCfgCertificateEmpty();
        }
    } else {
        if block_count == 5 ||
            index.block_succ_true[true_block] != merge_block ||
            index.block_succ_false[true_block] >= 0 ||
            (!direct_false_edge &&
                (index.block_succ_true[false_block] != merge_block ||
                 index.block_succ_false[false_block] >= 0)) ||
            index.block_succ_true[merge_block] >= 0 ||
            index.block_succ_false[merge_block] >= 0 {
            return DirectMirCfgCertificateEmpty();
        }
    }

    let phi_count: Int = 0;
    let block: Int = 0;
    while block < block_count {
        let block_phi_count: Int =
            index.instruction_facts.block_phi_prefix_counts[block];
        let expected_backedge_header: Int = 0;
        if loop_ready && block == loop_fact.header_block {
            expected_backedge_header = 1;
        } else if range_ready && block == range_fact.header_block {
            expected_backedge_header = 1;
        }
        if !index.block_reachable[block] ||
            index.backedge_headers[block] != expected_backedge_header ||
            block_phi_count < 0 {
            if loop_ready || range_ready {
                Die("direct MIR loop CFG certificate block fact is invalid");
            }
            return DirectMirCfgCertificateEmpty();
        }
        if block == merge_block {
            if block_phi_count > 1 {
                return DirectMirCfgCertificateEmpty();
            }
            phi_count = block_phi_count;
        } else if block_phi_count != 0 {
            return DirectMirCfgCertificateEmpty();
        }
        let should_branch: Int = 0;
        if loop_ready && block == loop_fact.header_block {
            should_branch = 1;
        } else if range_ready && block == range_fact.header_block {
            should_branch = 1;
        } else if !loop_ready && !range_ready &&
                (block == entry ||
                 (nested_ready && block == nested.branch_block)) {
            should_branch = 1;
        }
        if index.block_has_conditional_branch[block] != should_branch {
            if loop_ready || range_ready {
                Die("direct MIR loop CFG certificate branch role is invalid");
            }
            return DirectMirCfgCertificateEmpty();
        }
        block = block + 1;
    }
    let expected_merge_instructions: Int = 0;
    if phi_count == 1 { expected_merge_instructions = 2; }
    if loop_ready {
        if ArrayLength(index.instruction_facts.starts) != 5 ||
            phi_count != 1 {
            Die("direct MIR loop CFG certificate instruction or phi count is invalid");
        }
    } else if range_ready {
        if ArrayLength(index.instruction_facts.starts) != 3 ||
            phi_count != 0 {
            Die("direct MIR range CFG certificate instruction or phi count is invalid");
        }
    } else if nested_ready {
        if ArrayLength(index.instruction_facts.starts) != 4 ||
            phi_count != 0 {
            return DirectMirCfgCertificateEmpty();
        }
    } else {
        if index.block_instruction_counts[entry] != 2 ||
            index.block_instruction_counts[true_block] != 1 ||
            (!direct_false_edge &&
                index.block_instruction_counts[false_block] != 1) ||
            index.block_instruction_counts[merge_block] !=
                expected_merge_instructions {
            return DirectMirCfgCertificateEmpty();
        }
    }

    let phi_local_name: String = "";
    let phi_result_name: String = "";
    let phi_true_incoming: String = "";
    let phi_false_incoming: String = "";
    if phi_count == 1 {
        let phi_fact: MirRoutinePhiFact = MirRoutinePhiFactAt(
            index, admitted.routines, use_facts, 0, merge_block, 0
        );
        if !phi_fact.valid || phi_fact.predecessor_count != 2 ||
            ArrayLength(phi_fact.incoming_results) != 2 ||
            ArrayLength(phi_fact.incoming_definition_blocks) != 2 {
            if loop_ready {
                Die("direct MIR loop CFG certificate phi fact is invalid");
            }
            return DirectMirCfgCertificateEmpty();
        }
        phi_local_name = phi_fact.local_name;
        phi_result_name = phi_fact.result_name;
        let false_predecessor: Int = false_block;
        if direct_false_edge { false_predecessor = entry; }
        if loop_ready { false_predecessor = loop_fact.preheader_block; }
        let incoming_row: Int = 0;
        while incoming_row < 2 {
            let definition_block: Int =
                phi_fact.incoming_definition_blocks[incoming_row];
            if definition_block == true_block && phi_true_incoming == "" {
                phi_true_incoming = phi_fact.incoming_results[incoming_row];
            } else if definition_block == false_predecessor &&
                    phi_false_incoming == "" {
                phi_false_incoming = phi_fact.incoming_results[incoming_row];
            } else {
                if loop_ready {
                    Die("direct MIR loop CFG certificate phi predecessor is invalid");
                }
                return DirectMirCfgCertificateEmpty();
            }
            incoming_row = incoming_row + 1;
        }
        if StringLength(phi_true_incoming) == 0 ||
            StringLength(phi_false_incoming) == 0 {
            if loop_ready {
                Die("direct MIR loop CFG certificate phi incoming is missing");
            }
            return DirectMirCfgCertificateEmpty();
        }
    }

    let branch_block: Int = entry;
    if loop_ready { branch_block = loop_fact.header_block; }
    if range_ready { branch_block = range_fact.header_block; }
    let branch: MirRoutineInstructionSelection =
        MirRoutineFactIndexBranchAtBlock(
            index, admitted.routines, 0, branch_block
        );
    let entry_global_block: Int =
        admitted.routines.routine_block_starts[0] + branch_block;
    let expected_branch_source: String = "AST_BINARY";
    if phi_count == 1 && !loop_ready {
        expected_branch_source = "AST_IDENTIFIER";
    }
    if range_ready { expected_branch_source = "AST_FOR_LOOP"; }
    if !branch.valid || !branch.found || !branch.instruction.valid ||
        branch.instruction.source_type != expected_branch_source ||
        branch.instruction.global_row !=
            admitted.routines.block_instruction_starts[entry_global_block] +
            index.block_instruction_counts[branch_block] - 1 {
        if loop_ready || range_ready {
            Die("direct MIR loop CFG certificate branch anchor is invalid");
        }
        return DirectMirCfgCertificateEmpty();
    }

    let cfg_digest: Int = DirectMirCfgDigestFromIndex(index);
    let phi_digest: Int = DirectMirCfgPhiBindingDigest(
        phi_count, phi_local_name, phi_result_name,
        phi_true_incoming, phi_false_incoming
    );
    if cfg_digest == 0 || (phi_count == 1 && phi_digest == 0) {
        if loop_ready {
            Die("direct MIR loop CFG certificate digest binding is invalid");
        }
        return DirectMirCfgCertificateEmpty();
    }
    let evidence_fact_count: Int = 1;
    if nested_ready || loop_ready || range_ready {
        evidence_fact_count = 2;
    }
    let certificate: DirectMirCfgCertificate = DirectMirCfgCertificate(
        true, DirectMirCfgCertificateSchema(),
        DirectMirCfgCertificateRevision(), 0,
        DirectMirCfgMirDigest(admitted.routines.source_json),
        admitted.routines.source_length, index.routine_start,
        index.routine_end, index.source_syntax_id, cfg_digest,
        block_count, ArrayLength(index.instruction_facts.starts),
        entry, true_block, false_block, merge_block,
        branch.instruction.global_row, nested, loop_fact, range_fact,
        CompilerAirEvidenceMirTerminatorFact(), evidence_fact_count, 0, 0,
        true, true, phi_count, phi_digest, phi_local_name,
        phi_result_name, phi_true_incoming, phi_false_incoming
    );
    return DirectMirCfgCertificateWithDigest(
        certificate, DirectMirCfgCertificateIdentityDigest(certificate)
    );
}
func DirectMirCfgCertificateReady(
    ref certificate: DirectMirCfgCertificate
) -> Bool {
    let expected_instruction_count: Int = 4;
    if certificate.phi_count == 1 { expected_instruction_count = 6; }
    let loop_ready: Bool = certificate.block_count == 4 &&
        DirectMirLoopCfgCertificateFactReady(certificate.loop_fact) &&
        certificate.entry_block == certificate.loop_fact.preheader_block &&
        certificate.true_block == certificate.loop_fact.body_block &&
        certificate.false_block == certificate.loop_fact.exit_block &&
        certificate.merge_block == certificate.loop_fact.header_block &&
        certificate.branch_global_row ==
            certificate.loop_fact.branch_global_row &&
        certificate.phi_local_name == certificate.loop_fact.local_name &&
        certificate.phi_result_name == certificate.loop_fact.phi_result_name &&
        certificate.phi_true_incoming ==
            certificate.loop_fact.backedge_incoming &&
        certificate.phi_false_incoming ==
            certificate.loop_fact.preheader_incoming;
    if loop_ready { expected_instruction_count = 5; }
    let range_ready: Bool = certificate.block_count == 4 &&
        DirectMirRangeCfgCertificateFactReady(certificate.range_fact) &&
        certificate.entry_block == certificate.range_fact.preheader_block &&
        certificate.true_block == certificate.range_fact.body_block &&
        certificate.false_block == certificate.range_fact.exit_block &&
        certificate.merge_block == certificate.range_fact.header_block &&
        certificate.branch_global_row ==
            certificate.range_fact.branch_global_row &&
        ToInt(certificate.source_syntax_id) ==
            certificate.range_fact.iteration_function_id &&
        certificate.phi_count == 0;
    if range_ready { expected_instruction_count = 3; }
    let nested_ready: Bool = certificate.block_count == 5 &&
        DirectMirNestedCfgCertificateFactReady(certificate.nested) &&
        certificate.true_block == certificate.nested.branch_block &&
        certificate.false_block == certificate.nested.outer_merge_block &&
        certificate.merge_block == certificate.nested.outer_merge_block &&
        certificate.branch_global_row !=
            certificate.nested.branch_global_row;
    let nested_binding_ready: Bool = nested_ready;
    if certificate.block_count != 5 {
        nested_binding_ready =
            DirectMirNestedCfgCertificateFactAbsent(certificate.nested);
    }
    let loop_binding_ready: Bool = loop_ready;
    if !loop_ready {
        loop_binding_ready =
            DirectMirLoopCfgCertificateFactAbsent(certificate.loop_fact);
    }
    let range_binding_ready: Bool = range_ready;
    if !range_ready {
        range_binding_ready =
            DirectMirRangeCfgCertificateFactAbsent(certificate.range_fact);
    }
    let direct_false_edge: Bool =
        !loop_ready && !range_ready &&
        (certificate.block_count == 3 || nested_ready) &&
        certificate.phi_count == 1 &&
        certificate.false_block == certificate.merge_block;
    if nested_ready { direct_false_edge = true; }
    if certificate.block_count == 3 && direct_false_edge {
        expected_instruction_count = 5;
    }
    let expected_phi_digest: Int = DirectMirCfgPhiBindingDigest(
        certificate.phi_count, certificate.phi_local_name,
        certificate.phi_result_name, certificate.phi_true_incoming,
        certificate.phi_false_incoming
    );
    let phi_fields_ready: Bool = certificate.phi_count == 0 &&
        certificate.phi_digest == 0 && certificate.phi_local_name == "" &&
        certificate.phi_result_name == "" &&
        certificate.phi_true_incoming == "" &&
        certificate.phi_false_incoming == "";
    if certificate.phi_count == 1 {
        phi_fields_ready = expected_phi_digest != 0 &&
            MirSsaNameMatches(
                certificate.phi_result_name,
                certificate.phi_local_name, false
            ) && MirSsaNameMatches(
                certificate.phi_true_incoming,
                certificate.phi_local_name, false
            ) && MirSsaNameMatches(
                certificate.phi_false_incoming,
                certificate.phi_local_name, false
            ) && certificate.phi_result_name !=
                certificate.phi_true_incoming &&
            certificate.phi_result_name !=
                certificate.phi_false_incoming &&
            certificate.phi_true_incoming !=
                certificate.phi_false_incoming;
    }
    return certificate.valid &&
        certificate.schema == DirectMirCfgCertificateSchema() &&
        certificate.revision == DirectMirCfgCertificateRevision() &&
        certificate.certificate_digest != 0 &&
        certificate.certificate_digest ==
            DirectMirCfgCertificateIdentityDigest(certificate) &&
        certificate.mir_digest != 0 && certificate.source_length > 0 &&
        certificate.routine_start >= 0 &&
        certificate.routine_end > certificate.routine_start &&
        StringLength(certificate.source_syntax_id) > 0 &&
        certificate.cfg_digest != 0 &&
        (certificate.block_count == 4 || direct_false_edge || nested_ready) &&
        (certificate.phi_count == 0 || certificate.phi_count == 1) &&
        certificate.instruction_count == expected_instruction_count &&
        certificate.phi_digest == expected_phi_digest && phi_fields_ready &&
        nested_binding_ready && loop_binding_ready && range_binding_ready &&
        !(loop_ready && range_ready) &&
        certificate.entry_block >= 0 &&
        certificate.true_block >= 0 && certificate.false_block >= 0 &&
        certificate.merge_block >= 0 &&
        certificate.entry_block != certificate.true_block &&
        certificate.entry_block != certificate.false_block &&
        certificate.entry_block != certificate.merge_block &&
        certificate.true_block != certificate.false_block &&
        certificate.true_block != certificate.merge_block &&
        (direct_false_edge ||
            certificate.false_block != certificate.merge_block) &&
        certificate.evidence_kind ==
            CompilerAirEvidenceMirTerminatorFact() &&
        ((!nested_ready && !loop_ready && !range_ready &&
            certificate.evidence_fact_count == 1) ||
            ((nested_ready || loop_ready || range_ready) &&
                certificate.evidence_fact_count == 2)) &&
        certificate.fallback_count == 0 &&
        certificate.drift_count == 0 && certificate.strict_evidence &&
        certificate.mir_evidence_bound;
}
