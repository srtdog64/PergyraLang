// src/self_hosted/codegen/abi_layout/abi_layout_owner.pgy
//
// Self-host C ABI type spelling facts for the supported codegen subset.

import "../text/text_owner.pgy";
import "../type_facts/type_env.pgy";
import "enum_abi_value_fact_owner.pgy";
import "../runtime_abi/option_result_runtime_owner.pgy";
import "../runtime_abi/result_runtime_owner.pgy";
import "../runtime_abi/list_runtime_owner.pgy";
import "../runtime_abi/queue_runtime_owner.pgy";
import "../runtime_abi/set_runtime_owner.pgy";
import "../runtime_abi/box_array_runtime_owner.pgy";
import "../runtime_abi/spawn_runtime_owner.pgy";
import "../../compiler/abi_layout_row_owner.pgy";
import "../../compiler/abi_layout_nominal_array_owner.pgy";
import "../../compiler/machine_layer_runtime_projection_owner.pgy";
import "../../compiler/runtime_call_abi_structured_fact_owner.pgy";
import "../../compiler/symbol_table_owner.pgy";
import "../../semantic/array_type_shape_owner.pgy";
import "../../semantic/ast_type_name_canonical_owner.pgy";

func AbiLayoutRequireCompilerRows() -> Void {
    if !CompilerAbiLayoutRowsReady() {
        Die("compiler ABI/layout row owner is not ready");
    }
    if !EnumAbiValueFactContractReady() {
        Die("enum ABI value fact owner is not ready");
    }
}

func AbiLayoutCValueType(type_name: String, struct_env: CodegenTypeEnv) -> String {
    AbiLayoutRequireCompilerRows();
    let resource_type: Option<String> =
        CompilerRuntimeCallAbiConstructedCValueType(type_name);
    if IsSome(resource_type) { return UnwrapOption(resource_type); }
    let machine_type: String =
        CompilerRuntimeCallAbiMachineLayerDeviceCValueType(type_name);
    if machine_type != "" {
        return machine_type;
    }
    let remote_future_type: String =
        CompilerRuntimeCallAbiMachineLayerRemoteFutureCValueType(type_name);
    if remote_future_type != "" {
        return remote_future_type;
    }
    let future_type: String = SpawnRuntimeCFutureCValueType(type_name);
    if future_type != "" {
        return future_type;
    }
    let row: Option<Int> = CompilerAbiLayoutRowIndex(type_name);
    if IsSome(row) {
        return CompilerAbiLayoutRowCValueTypeAt(UnwrapOption(row));
    }
    let result_fact: ResultRuntimeFact = ResultRuntimeFactForType(type_name);
    if result_fact.ok { return result_fact.c_type; }
    let option_struct_fact_opt: Option<OptionStructRuntimeFact> =
        OptionResultRuntimeStructOptionFact(type_name, struct_env);
    if IsSome(option_struct_fact_opt) {
        let option_struct_fact: OptionStructRuntimeFact = UnwrapOption(option_struct_fact_opt);
        return option_struct_fact.c_type;
    }
    if IsBoxType(type_name) && IsSome(BoxArrayElementTypeOpt(type_name)) {
        let box_type: String = BoxArrayRuntimeCValueTypeFor(type_name);
        if box_type != "" { return box_type; }
    }
    let list_fact: CollectionListRuntimeFact =
        CollectionListRuntimeFactFromTypeName(type_name);
    if list_fact.ok { return list_fact.c_value_type; }
    let queue_fact: CollectionQueueRuntimeFact =
        CollectionQueueRuntimeFactFromTypeName(type_name);
    if queue_fact.ok { return queue_fact.c_value_type; }
    let set_fact: CollectionSetRuntimeFact =
        CollectionSetRuntimeFactFromTypeName(type_name);
    if set_fact.ok { return set_fact.c_value_type; }
    let array_element: Option<String> =
        SemanticArrayElementType(type_name);
    if type_name == "Array<Float>" ||
        type_name == "Array<Float: Float>" {
        return "pgy_af";
    }
    if type_name == "Array<Double>" ||
        type_name == "Array<Double: Double>" {
        return "pgy_ad";
    }
    if IsSome(array_element) {
        let element_type: String = UnwrapOption(array_element);
        if LookupKindType(struct_env, element_type, "s") == "struct" {
            let array_fact: CompilerAbiNominalArrayLayoutFact =
                CompilerAbiNominalArrayLayoutFactFor(element_type);
            if !array_fact.ok {
                Die("nominal array ABI/layout fact is missing");
            }
            return array_fact.c_value_type;
        }
    }
    if LookupKindType(struct_env, type_name, "s") == "struct" {
        return AbiLayoutCStructTypeName(type_name);
    }
    let enum_fact: EnumAbiValueFact = EnumAbiValueFactFor(
        type_name, struct_env
    );
    if enum_fact.ok {
        return enum_fact.c_value_type;
    }
    Die(Concat("unsupported C ABI value type (only Int/Long/Bool/Float/Double/String/Array/Result/Option/struct/enum): ", type_name));
    return "";
}

func AbiLayoutCParamType(type_name: String, struct_env: CodegenTypeEnv) -> String {
    return AbiLayoutCValueType(type_name, struct_env);
}

func AbiLayoutCStructTypeName(type_name: String) -> String {
    return CompilerSymbolCTypeName(type_name);
}

func AbiLayoutCFieldlessNominalFieldBlock() -> String {
    return "    char _pgy_reserved;\n";
}

func AbiLayoutCFieldlessNominalInitializer() -> String {
    return "0";
}

func AbiLayoutCReturnType(type_name: String, struct_env: CodegenTypeEnv) -> String {
    if type_name == CompilerAbiLayoutVoidTypeName() {
        return CompilerAbiLayoutVoidCValueType();
    }
    return AbiLayoutCValueType(type_name, struct_env);
}

func AbiLayoutIsVoidReturnType(type_name: String) -> Bool {
    return type_name == CompilerAbiLayoutVoidTypeName();
}

func AbiLayoutCEntrypointBodyReturnType() -> String {
    return CompilerAbiLayoutIntTypeName();
}

func AbiLayoutCEmptyParameterList() -> String {
    return CompilerAbiLayoutVoidCValueType();
}

func AbiLayoutCDefaultReturnValue(type_name: String, struct_env: CodegenTypeEnv) -> String {
    AbiLayoutRequireCompilerRows();
    let row: Option<Int> = CompilerAbiLayoutRowIndex(type_name);
    if IsSome(row) {
        let default_value: String = CompilerAbiLayoutRowDefaultReturnValueAt(UnwrapOption(row));
        if default_value != CompilerAbiLayoutDefaultReturnUnsupported() {
            return default_value;
        }
    }
    let enum_fact: EnumAbiValueFact = EnumAbiValueFactFor(
        type_name, struct_env
    );
    if enum_fact.ok {
        return enum_fact.default_return_value;
    }
    Die(Concat("unsupported bare return default for C ABI type: ", type_name));
    return "";
}

func AbiLayoutCLocalType(type_name: String, struct_env: CodegenTypeEnv) -> String {
    return AbiLayoutCValueType(type_name, struct_env);
}

func AbiLayoutCFieldType(type_name: String, struct_env: CodegenTypeEnv) -> String {
    let row: Option<Int> = CompilerAbiLayoutRowIndex(type_name);
    if IsSome(row) && !CompilerAbiLayoutFieldAllowed(type_name) {
        Die(Concat("struct/class fields must be Int/Long/Bool/Float/Double/String/previous struct, got: ", type_name));
    }
    return AbiLayoutCValueType(type_name, struct_env);
}
