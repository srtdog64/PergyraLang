// src/self_hosted/codegen/abi_layout/abi_layout_owner.pgy
//
// Self-host C ABI type spelling facts for the supported codegen subset.

import "../text/text_owner.pgy";
import "../type_facts/type_env.pgy";
import "../runtime_abi/option_result_runtime_owner.pgy";
import "../../compiler/abi_layout_row_owner.pgy";

func AbiLayoutRequireCompilerRows() -> Void {
    if !CompilerAbiLayoutRowsReady() {
        Die("compiler ABI/layout row owner is not ready");
    }
}

func AbiLayoutCValueType(type_name: String, struct_env: String) -> String {
    AbiLayoutRequireCompilerRows();
    let row: Option<Int> = CompilerAbiLayoutRowIndex(type_name);
    if IsSome(row) {
        return CompilerAbiLayoutRowCValueTypeAt(UnwrapOption(row));
    }
    let option_struct_fact_opt: Option<OptionStructRuntimeFact> = OptionResultRuntimeStructOptionFact(type_name, struct_env);
    if IsSome(option_struct_fact_opt) {
        let option_struct_fact: OptionStructRuntimeFact = UnwrapOption(option_struct_fact_opt);
        return option_struct_fact.c_type;
    }
    if LookupKindType(struct_env, type_name, "s") == "struct" {
        return type_name;
    }
    if LookupKindType(struct_env, type_name, "enum") == "payload_free" {
        return CompilerAbiLayoutPayloadFreeEnumCValueType();
    }
    Die(Concat("unsupported C ABI value type (only Int/Bool/Float/String/Array/Result/Option/struct/payload-free enum): ", type_name));
    return "";
}

func AbiLayoutCParamType(type_name: String, struct_env: String) -> String {
    return AbiLayoutCValueType(type_name, struct_env);
}

func AbiLayoutCReturnType(type_name: String, struct_env: String) -> String {
    if type_name == CompilerAbiLayoutVoidTypeName() {
        return CompilerAbiLayoutVoidCValueType();
    }
    return AbiLayoutCValueType(type_name, struct_env);
}

func AbiLayoutIsVoidReturnType(type_name: String) -> Bool {
    return type_name == CompilerAbiLayoutVoidTypeName();
}

func AbiLayoutCDefaultReturnValue(type_name: String, struct_env: String) -> String {
    AbiLayoutRequireCompilerRows();
    if type_name == CompilerAbiLayoutStringTypeName() {
        return "\"\"";
    }
    if type_name == CompilerAbiLayoutFloatTypeName() {
        return "0.0";
    }
    if type_name == CompilerAbiLayoutIntTypeName() || type_name == CompilerAbiLayoutBoolTypeName() {
        return "0";
    }
    if LookupKindType(struct_env, type_name, "enum") == "payload_free" {
        return "0";
    }
    Die(Concat("unsupported bare return default for C ABI type: ", type_name));
    return "";
}

func AbiLayoutCLocalType(type_name: String, struct_env: String) -> String {
    return AbiLayoutCValueType(type_name, struct_env);
}

func AbiLayoutCFieldType(type_name: String, struct_env: String) -> String {
    let row: Option<Int> = CompilerAbiLayoutRowIndex(type_name);
    if IsSome(row) && !CompilerAbiLayoutFieldAllowed(type_name) {
        Die(Concat("struct/class fields must be Int/Bool/Float/String/previous struct, got: ", type_name));
    }
    if LookupKindType(struct_env, type_name, "enum") == "payload_free" {
        return CompilerAbiLayoutPayloadFreeEnumCValueType();
    }
    return AbiLayoutCValueType(type_name, struct_env);
}
