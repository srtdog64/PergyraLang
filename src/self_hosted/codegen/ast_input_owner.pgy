// src/self_hosted/codegen/ast_input_owner.pgy
//
// Owns the codegen tool's AST input boundary. The entrypoint may orchestrate
// the flow, but default path selection, file existence diagnostics, and source
// reads are one policy owner.

func CodegenDefaultAstPath(args: Array<String>) -> String {
    if ArrayLength(args) > 0 {
        return args[0];
    }
    return "src/self_hosted/codegen/fixture/hello_ast.txt";
}

func CodegenReadAst(ast_path: String) -> String {
    if !FileExists(ast_path) {
        Log(Concat("CODEGEN ERROR: AST file not found: ", ast_path));
        Exit(1);
    }
    return ReadFile(ast_path);
}
