// Rendered array-item aggregate emission owner.

import "../type_facts/type_env.pgy";
import "../text/text_owner.pgy";
import "../abi_layout/abi_layout_owner.pgy";
import "../runtime_abi/collection_runtime_owner.pgy";

func EmitArrayLiteralFromRenderedItems(
    expected_type: String,
    env: CodegenTypeEnv,
    item_values: Array<String>
) -> String {
    let kind: String = CollectionRuntimeKindFromTypeName(expected_type);
    let kind_code: Int = CollectionRuntimeKindCode(kind);
    let element_type: String =
        CollectionRuntimeElementTypeFromKindCode(kind_code);
    if element_type == "CodegenAstTextNode" {
        Die("inline Array<CodegenAstTextNode> values are outside the bootstrap subset");
    }
    let c_type: String = AbiLayoutCValueType(expected_type, env);
    let temp: String = "_pgy_array_value";
    let out: String = Concat("({ ", Concat(c_type, Concat(" ",
        Concat(temp, Concat(" = ", Concat(
            CollectionRuntimeCNewFn(kind_code), "(); "))))));
    let index: Int = 0;
    while index < ArrayLength(item_values) {
        out = Concat(out, Concat(CollectionRuntimeCPushFn(kind_code),
            Concat("(&", Concat(temp, Concat(", ",
                Concat(item_values[index], "); "))))));
        index = index + 1;
    }
    return Concat(out, Concat(temp, "; })"));
}
