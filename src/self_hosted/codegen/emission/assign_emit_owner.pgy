// Assignment projection over semantic target/value rows and expression graphs.

import "../text/text_owner.pgy";
import "../type_facts/type_env.pgy";
import "../type_facts/type_env_state_lifetime_owner.pgy";
import "../input/semantic_assignment_codegen_view_owner.pgy";
import "../runtime_abi/collection_runtime_owner.pgy";
import "../runtime_abi/slice_runtime_owner.pgy";
import "../runtime_abi/option_result_runtime_owner.pgy";
import "expr_semantic_graph_emit_owner.pgy";
import "collection_element_emit_owner.pgy";
import "option_value_emit_owner.pgy";
import "../../semantic/ast_expression/ast_expression_graph_node_view_owner.pgy";

func EmitAssign(
    assignments: SemanticAstAssignmentFacts,
    node_id: Int,
    expected_type: String,
    target_type: String,
    env_state: CodegenTypeEnvState,
    env: CodegenTypeEnv,
    ref graph: SemanticExpressionGraphFacts,
    value_root_id: Int,
    target_root_id: Int
) -> String {
    let assignment_index: Int = CodegenSemanticAssignmentIndexOrDie(
        assignments, node_id
    );
    if assignment_index < 0 ||
        assignment_index >= ArrayLength(assignments.operations) ||
        assignments.operations[assignment_index] != 0 {
        Die("assignment projection requires its admitted MIR operation");
    }
    let name: String = CodegenSemanticAssignmentTargetOrDie(
        assignments, node_id
    );
    let expr: String = CodegenSemanticAssignmentValueOrDie(
        assignments, node_id
    );
    if expected_type == "" {
        Die("assignment expected type is missing");
    }
    let target_kind: Option<Int> = SemanticExpressionGraphNodeKind(
        graph, target_root_id
    );
    let target_text: Option<String> = SemanticExpressionGraphNodeText(
        graph, target_root_id
    );
    if !IsSome(target_kind) || !IsSome(target_text) {
        Die("assignment target graph is missing or invalid");
    }
    let target_kind_value: Int = UnwrapOption(target_kind);
    let target_text_value: String = UnwrapOption(target_text);
    if target_text_value != name {
        Die("assignment target graph is missing or invalid");
    }
    if CodegenSemanticAssignmentTargetIsIndex(assignments, node_id) {
        if target_type == "" {
            Die("indexed assignment target type is missing");
        }
        let receiver_opt: Option<Int> = SemanticExpressionGraphLeftChild(
            graph, target_root_id
        );
        let index_opt: Option<Int> = SemanticExpressionGraphRightChild(
            graph, target_root_id
        );
        if target_kind_value != AstExpressionNodeIndex() ||
            !IsSome(receiver_opt) || !IsSome(index_opt) {
            Die("indexed assignment target graph is missing or invalid");
        }
        let receiver_id: Int = UnwrapOption(receiver_opt);
        let index_id: Int = UnwrapOption(index_opt);
        let c_arr_name: String = RewriteExprFromSemanticGraph(
            graph, receiver_id, env
        );
        let idx_expr: String = RewriteExprFromSemanticGraph(
            graph, index_id, env
        );
        if StartsWith(target_type, "Slice<") {
            // The descriptor is a value; the write goes through a copy of it.
            let slice_fact: SliceRuntimeFact =
                SliceRuntimeFactFromSliceTypeName(target_type, env);
            if !slice_fact.ok { Die("Slice element write runtime ABI fact is missing"); }
            let element: String = EmitCollectionGraphElementValue(expr, env,
                CollectionRuntimeFactFromTypeName(slice_fact.array_type, env),
                graph, value_root_id);
            let view: String = Concat("__pgy_slice_set_", ToString(target_root_id));
            return "({ ${slice_fact.c_slice_type} ${view} = ${c_arr_name}; "
                + "${slice_fact.c_slice_set_fn}(&${view}, (long long)(${idx_expr}), ${element}); });";
        }
        let array_fact: CollectionRuntimeFact =
            CollectionRuntimeFactFromTypeName(target_type, env);
        let rhs: String = EmitCollectionGraphElementValue(
            expr, env, array_fact, graph, value_root_id
        );
        return Concat(array_fact.c_set_fn, Concat("(&", Concat(c_arr_name, Concat(", ",
            Concat(idx_expr, Concat(", ", Concat(rhs, ");")))))));
    }
    var c_name: String = LookupKindType(env, name, "cbind");
    if target_kind_value == AstExpressionNodeMemberAccess() {
        c_name = RewriteExprFromSemanticGraph(
            graph, target_root_id, env
        );
    } else if target_kind_value != AstExpressionNodeLeaf() {
        Die("assignment target graph kind is unsupported");
    } else if c_name == "" {
        Die("assignment target C binding fact is missing");
    }
    if expected_type == "String" || expected_type == "Float" ||
        expected_type == "Double" ||
        expected_type == "Long" {
        return Concat(c_name, Concat(" = ", Concat(
            WrapExprWithSemanticGraph(expr, env, graph, value_root_id), ";"
        )));
    }
    if StartsWith(expected_type, "Option<") {
        let option_expr: OptionExprEmissionFact =
            EmitOptionExprFactForType(expr, expected_type, env, graph, value_root_id);
        return Concat(c_name, Concat(" = ", Concat(
            option_expr.c_expr, ";"
        )));
    }
    // A collection value lowers against the target's type, as an annotated
    // let does, so a `[]` or `{}` literal takes that type.
    if StartsWith(expected_type, "Array<") ||
        StartsWith(expected_type, "List<") ||
        StartsWith(expected_type, "Queue<") ||
        StartsWith(expected_type, "Set<") ||
        StartsWith(expected_type, "HashMap<") {
        return Concat(c_name, Concat(" = ", Concat(
            RewriteExpectedValueWithSemanticGraph(
                expr, expected_type, env, graph, value_root_id
            ), ";"
        )));
    }
    if LookupKindType(env, expected_type, "s") == "struct" {
        return Concat(c_name, Concat(" = ", Concat(
            RewriteExpectedValueWithSemanticGraph(
                expr, expected_type, env, graph, value_root_id
            ), ";"
        )));
    }
    return Concat(c_name, Concat(" = ", Concat(
        WrapExprWithSemanticGraph(expr, env, graph, value_root_id), ";"
    )));
}
