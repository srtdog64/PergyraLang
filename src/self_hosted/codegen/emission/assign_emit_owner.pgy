// Assignment projection over semantic target/value rows and expression graphs.

import "../text/text_owner.pgy";
import "../type_facts/type_env.pgy";
import "../input/semantic_assignment_codegen_view_owner.pgy";
import "../runtime_abi/collection_runtime_owner.pgy";
import "../runtime_abi/option_result_runtime_owner.pgy";
import "../../compiler/symbol_table_owner.pgy";
import "expr_rewrite.pgy";
import "expr_semantic_graph_emit_owner.pgy";
import "collection_element_emit_owner.pgy";

func EmitAssign(
    assignments: SemanticAstAssignmentFacts,
    idx: Int,
    env_state: Array<String>,
    graph: SemanticExpressionGraphView,
    target_graph: SemanticExpressionGraphView
) -> String {
    let env: CodegenTypeEnv = CodegenTypeEnvStateView(env_state);
    let name: String = CodegenSemanticAssignmentTargetOrDie(assignments, idx);
    let expr: String = CodegenSemanticAssignmentValueOrDie(assignments, idx);
    if CodegenSemanticAssignmentTargetIsIndex(assignments, idx) {
        let target_kind: Option<Int> = SemanticExpressionGraphNodeKind(
            target_graph.graph, target_graph.root_id
        );
        let target_text: Option<String> = SemanticExpressionGraphNodeText(
            target_graph.graph, target_graph.root_id
        );
        let receiver_opt: Option<Int> = SemanticExpressionGraphLeftChild(
            target_graph.graph, target_graph.root_id
        );
        let index_opt: Option<Int> = SemanticExpressionGraphRightChild(
            target_graph.graph, target_graph.root_id
        );
        if !target_graph.ok || !IsSome(target_kind) ||
            UnwrapOption(target_kind) != AstExpressionNodeIndex() ||
            !IsSome(target_text) || UnwrapOption(target_text) != name ||
            !IsSome(receiver_opt) || !IsSome(index_opt) {
            Die("indexed assignment target graph is missing or invalid");
        }
        let receiver_id: Int = UnwrapOption(receiver_opt);
        let index_id: Int = UnwrapOption(index_opt);
        let receiver_text: Option<String> = SemanticExpressionGraphNodeText(
            target_graph.graph, receiver_id
        );
        if !IsSome(receiver_text) {
            Die("indexed assignment receiver graph is missing");
        }
        let arr_name: String = UnwrapOption(receiver_text);
        let c_arr_name: String = RewriteExprFromSemanticGraph(
            target_graph.graph, receiver_id, env
        );
        let idx_expr: String = RewriteExprFromSemanticGraph(
            target_graph.graph, index_id, env
        );
        let arr_kind: String = LookupKindType(env, arr_name, "v");
        let arr_kind_code: Int = CollectionRuntimeKindCode(arr_kind);
        let set_fn: String = CollectionRuntimeCSetFn(arr_kind_code);
        let rhs: String = EmitCollectionGraphElementValue(
            expr, env, arr_kind_code, graph
        );
        return Concat(set_fn, Concat("(&", Concat(c_arr_name, Concat(", ",
            Concat(idx_expr, Concat(", ", Concat(rhs, ");")))))));
    }
    let c_name: String = CompilerSymbolCBindingName(name);
    let vt: String = LookupKindType(env, name, "v");
    if vt == "String" || vt == "Float" || vt == "Long" {
        return Concat(c_name, Concat(" = ", Concat(
            WrapExprWithSemanticGraph(expr, env, graph), ";"
        )));
    }
    let option_struct: Option<OptionStructRuntimeFact> =
        OptionResultRuntimeStructOptionFact(vt, env.global_rows);
    if IsSome(option_struct) {
        let option_expr: OptionExprEmissionFact =
            EmitOptionExprFactForType(expr, vt, env, graph);
        return Concat(c_name, Concat(" = ", Concat(
            option_expr.c_expr, ";"
        )));
    }
    let payload_kind: Int =
        OptionResultRuntimeOptionPayloadKindFromEnvKind(vt);
    if payload_kind != 0 {
        let rendered: String = RewriteExpr(expr, env);
        let trimmed: String = StringTrim(expr);
        if trimmed == "None" || trimmed == "None()" {
            rendered = Concat(
                OptionResultRuntimeCOptionNoneFnForPayloadKind(payload_kind),
                "()"
            );
        }
        return Concat(c_name, Concat(" = ", Concat(rendered, ";")));
    }
    if LookupKindType(env, vt, "s") == "struct" {
        return Concat(c_name, Concat(" = ", Concat(
            RewriteExpectedValueWithSemanticGraph(expr, vt, env, graph), ";"
        )));
    }
    return Concat(c_name, Concat(" = ", Concat(
        WrapExprWithSemanticGraph(expr, env, graph), ";"
    )));
}
