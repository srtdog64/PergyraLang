// Exact C function-pointer declaration for a value-carried callable parameter.

import "../text/text_owner.pgy";
import "../abi_layout/abi_layout_owner.pgy";

func CodegenCallableParameterPrototypeIfPresent(
    semantic_type_name: String,
    c_binding_name: String,
    mode: Int,
    struct_env: CodegenTypeEnv
) -> Option<String> {
    let declaration: Option<String> = AbiLayoutCCallableParamDeclaration(
        semantic_type_name, c_binding_name, struct_env
    );
    if !IsSome(declaration) { return None; }
    if mode != 0 {
        Die("callable C prototype parameters support only value carriage");
    }
    return declaration;
}
