// Collection element value emission for self-host C lowering.

import "../type_facts/type_env.pgy";
import "../runtime_abi/collection_runtime_owner.pgy";
import "expr_rewrite.pgy";
import "expr_semantic_graph_emit_owner.pgy";
import "struct_value_emit.pgy";

// Array literal and indexed-assignment lanes remain explicit text bridges.
func EmitCollectionElementValue(
    kind: String,
    value_expr: String,
    env: CodegenTypeEnv,
    kind_code: Int
) -> String {
    let elem_type: String = CollectionRuntimeElementTypeFromKindCode(
        kind_code
    );
    if elem_type == "String" { return StrEval(value_expr, env); }
    if elem_type == "CodegenAstTextNode" {
        return EmitStructValue(value_expr, elem_type, env);
    }
    return IntEval(value_expr, env);
}

func EmitCollectionGraphElementValue(
    value_expr: String,
    env: CodegenTypeEnv,
    kind_code: Int,
    graph: SemanticExpressionGraphView
) -> String {
    let elem_type: String = CollectionRuntimeElementTypeFromKindCode(
        kind_code
    );
    if elem_type == "CodegenAstTextNode" {
        return RewriteExpectedValueWithSemanticGraph(
            value_expr, elem_type, env, graph
        );
    }
    return EmitCollectionElementValue("", value_expr, env, kind_code);
}
