// C storage-release materialization from admitted call and argument type facts.
// Semantic owners distinguish public plain-value drop from compiler retirement;
// neither descriptor type nor this emitter grants element-release authority.
import "expr_semantic_call_argument_owner.pgy";
import "expr_semantic_type_owner.pgy";
import "../text/text_owner.pgy";
import "../runtime_abi/collection_runtime_owner.pgy";

func RewriteSemanticArrayDropCall(
    graph: SemanticExpressionGraphFacts, view: SemanticCallSpineView,
    env: CodegenTypeEnv
) -> String {
    if ArrayLength(view.argument_nodes) != 1 { Die("ArrayDrop requires exactly one argument"); }
    let argument_type: Option<String> = CodegenExpressionTypeFromGraph(graph, view.argument_nodes[0], env);
    if !IsSome(argument_type) { Die("ArrayDrop argument type fact is missing"); }
    let fact: CollectionRuntimeFact = CollectionRuntimeFactFromTypeName(UnwrapOption(argument_type), env);
    let argument: String = RewriteSemanticCallArgument(graph, view.argument_nodes[0], UnwrapOption(argument_type), "inout", env);
    return "(free((" + argument + ")->data), memset(" + argument + ", 0, sizeof(" + fact.c_array_type + ")))";
}

func RewriteSemanticCompilerRetireArrayStorageCall(
    graph: SemanticExpressionGraphFacts,
    view: SemanticCallSpineView,
    env: CodegenTypeEnv
) -> String {
    if ArrayLength(view.argument_nodes) != 1 {
        Die("CompilerRetireArrayStorage requires exactly one argument");
    }
    let array_type_opt: Option<String> = CodegenExpressionTypeFromGraph(
        graph, view.argument_nodes[0], env
    );
    if !IsSome(array_type_opt) {
        Die("CompilerRetireArrayStorage argument type fact is missing");
    }
    let array_type: String = UnwrapOption(array_type_opt);
    let fact: CollectionRuntimeFact = CollectionRuntimeFactFromTypeName(
        array_type, env
    );
    let array_arg: String = RewriteSemanticCallArgument(
        graph, view.argument_nodes[0], array_type, "inout", env
    );
    return Concat(
        CollectionRuntimeCDropStorageFn(
            CollectionRuntimeKindCode(fact.kind)
        ),
        Concat("(", Concat(array_arg, ")"))
    );
}
