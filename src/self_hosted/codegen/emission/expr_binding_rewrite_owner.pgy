import "../text/text_owner.pgy";
import "../type_facts/type_env.pgy";

func RewriteBindingRefs(e: String, env: CodegenTypeEnv) -> String {
    let n: Int = StringLength(e);
    let result_allocator: Allocator = AllocatorResult();
    let out: TextBuilder = TextBuilderNew(n + 1);
    let i: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CodegenCharAt(e, i);
        if in_str {
            TextBuilderAppend(out, c);
            if c == "\\" && i + 1 < n {
                TextBuilderAppend(out, CodegenCharAt(e, i + 1));
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            TextBuilderAppend(out, c);
            i = i + 1;
            continue;
        }
        if IsIdentStart(c) {
            let j: Int = i;
            while j < n && IsIdentChar(CodegenCharAt(e, j)) {
                j = j + 1;
            }
            let ident: String = Substring(e, i, j - i);
            let prev_is_field: Bool = i > 0 && CodegenCharAt(e, i - 1) == ".";
            let next_is_call: Bool = j < n && CodegenCharAt(e, j) == "(";
            if !prev_is_field && !next_is_call {
                TextBuilderAppend(out, TypeEnvBindingCName(env, ident));
            } else {
                TextBuilderAppend(out, ident);
            }
            i = j;
            continue;
        }
        TextBuilderAppend(out, c);
        i = i + 1;
    }
    let rewritten: String = TextBuilderFinish(out, result_allocator);
    AllocatorDestroy(result_allocator);
    return rewritten;
}
