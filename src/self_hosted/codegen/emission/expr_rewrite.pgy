// src/self_hosted/codegen/emission/expr_rewrite.pgy
//
// Expression lowering owner for self-host C emission.

import "../runtime_abi/collection_runtime_owner.pgy";
import "../runtime_abi/host_io_runtime_owner.pgy";
import "../runtime_abi/math_runtime_owner.pgy";
import "../runtime_abi/option_result_runtime_owner.pgy";
import "../runtime_abi/string_runtime_owner.pgy";

func RewriteExpr(e: String, env: String) -> String {
    return RewriteRoleOperators(e, env);
}

func RewriteRoleOperators(e: String, env: String) -> String {
    let s: String = StripOuterParens(e);
    let p: Int = FindTopLevelPlus(s);
    if p >= 0 {
        let lhs: String = StringTrim(Substring(s, 0, p));
        let rhs: String = StringTrim(Substring(s, p + 1, StringLength(s) - (p + 1)));
        let lhs_kind: String = ExprKind(lhs, env);
        let rhs_kind: String = ExprKind(rhs, env);
        if lhs_kind == rhs_kind {
            let op_name: String = LookupKindType(env, Concat(lhs_kind, "+"), "op");
            if StringLength(op_name) == 0 && lhs_kind == "String" {
                op_name = StringRuntimeCConcatFn();
            }
            if StringLength(op_name) > 0 {
                return Concat(op_name, Concat("(", Concat(RewriteExpr(lhs, env),
                    Concat(", ", Concat(RewriteExpr(rhs, env), ")")))));
            }
        }
    }
    return RewriteBool(e, env);
}

func RewriteMemberCalls(e: String, env: String) -> String {
    let n: Int = StringLength(e);
    let out: String = "";
    let i: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CharAt(e, i);
        if in_str {
            out = Concat(out, c);
            if c == "\\" && i + 1 < n {
                out = Concat(out, CharAt(e, i + 1));
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            out = Concat(out, c);
            i = i + 1;
            continue;
        }
        if c == "." {
            let ol: Int = StringLength(out);
            let end: Int = ol;
            let start: Int = ol;
            while start > 0 && IsIdentChar(CharAt(out, start - 1)) {
                start = start - 1;
            }
            if start < end && i + 1 < n && IsIdentStart(CharAt(e, i + 1)) {
                let j: Int = i + 1;
                while j < n && IsIdentChar(CharAt(e, j)) {
                    j = j + 1;
                }
                if j < n && CharAt(e, j) == "(" {
                    let receiver: String = Substring(out, start, end - start);
                    let recv_type: String = LookupKindType(env, receiver, "v");
                    let method: String = Substring(e, i + 1, j - (i + 1));
                    let c_name: String = Concat(recv_type, Concat("_", method));
                    if StringLength(recv_type) > 0 && LookupKindType(env, c_name, "f") != "" {
                        let close: Int = FindMatchingParen(e, j);
                        let args: String = Substring(e, j + 1, close - j - 1);
                        out = Substring(out, 0, start);
                        out = Concat(out, Concat(c_name, Concat("(", receiver)));
                        if StringLength(StringTrim(args)) > 0 {
                            out = Concat(out, Concat(", ", args));
                        }
                        out = Concat(out, ")");
                        i = close + 1;
                        continue;
                    }
                }
            }
        }
        out = Concat(out, c);
        i = i + 1;
    }
    return out;
}

func RewriteEnumRefs(e: String, env: String) -> String {
    let n: Int = StringLength(e);
    let out: String = "";
    let i: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CharAt(e, i);
        if in_str {
            out = Concat(out, c);
            if c == "\\" && i + 1 < n {
                out = Concat(out, CharAt(e, i + 1));
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            out = Concat(out, c);
            i = i + 1;
            continue;
        }
        if c == "." {
            let ol: Int = StringLength(out);
            let end: Int = ol;
            let start: Int = ol;
            while start > 0 && IsIdentChar(CharAt(out, start - 1)) {
                start = start - 1;
            }
            if start < end && i + 1 < n && IsIdentStart(CharAt(e, i + 1)) {
                let j: Int = i + 1;
                while j < n && IsIdentChar(CharAt(e, j)) {
                    j = j + 1;
                }
                let receiver: String = Substring(out, start, end - start);
                let variant: String = Substring(e, i + 1, j - (i + 1));
                let key: String = Concat(receiver, Concat(".", variant));
                let value: String = LookupKindType(env, key, "e");
                if StringLength(value) > 0 {
                    out = Substring(out, 0, start);
                    out = Concat(out, value);
                    i = j;
                    continue;
                }
            }
        }
        out = Concat(out, c);
        i = i + 1;
    }
    return out;
}

// Rewrite a namespace-qualified call `NS.Func(...)` to the flattened C name
// `NS_Func(...)`. The parser flattens `namespace NS { func Func }` to a
// top-level `NS_Func` definition but renders calls in dotted form. A `.` that
// joins two identifiers and is followed (after the second identifier) by `(`
// is a qualified call; a `.` in `obj.field` (not followed by `(`) is left alone.
func RewriteQualifiedCalls(e: String) -> String {
    let n: Int = StringLength(e);
    let out: String = "";
    let i: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CharAt(e, i);
        if in_str {
            out = Concat(out, c);
            if c == "\\" && i + 1 < n {
                out = Concat(out, CharAt(e, i + 1));
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            out = Concat(out, c);
            i = i + 1;
            continue;
        }
        if c == "." {
            let ol: Int = StringLength(out);
            let prev_ok: Bool = ol > 0 && IsIdentChar(CharAt(out, ol - 1));
            let next_ok: Bool = i + 1 < n && IsIdentStart(CharAt(e, i + 1));
            if prev_ok && next_ok {
                let j: Int = i + 1;
                while j < n && IsIdentChar(CharAt(e, j)) {
                    j = j + 1;
                }
                if j < n && CharAt(e, j) == "(" {
                    let start: Int = ol;
                    while start > 0 && (IsIdentChar(CharAt(out, start - 1)) || CharAt(out, start - 1) == ".") {
                        start = start - 1;
                    }
                    let owner: String = Substring(out, start, ol - start);
                    let member: String = Substring(e, i + 1, j - (i + 1));
                    out = Substring(out, 0, start);
                    out = Concat(out, CompilerSymbolCQualifiedName(owner, member));
                    i = j;
                    continue;
                }
            }
        }
        out = Concat(out, c);
        i = i + 1;
    }
    return out;
}

func RewriteBoolLiterals(e: String) -> String {
    let n: Int = StringLength(e);
    let out: String = "";
    let i: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CharAt(e, i);
        if in_str {
            out = Concat(out, c);
            if c == "\\" && i + 1 < n {
                out = Concat(out, CharAt(e, i + 1));
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            out = Concat(out, c);
            i = i + 1;
            continue;
        }
        let prev_ok: Bool = i == 0 || !IsIdentChar(CharAt(e, i - 1));
        if prev_ok && i + 4 <= n && Substring(e, i, 4) == "true" {
            let next_true_ok: Bool = i + 4 == n || !IsIdentChar(CharAt(e, i + 4));
            if next_true_ok {
                out = Concat(out, "1");
                i = i + 4;
                continue;
            }
        }
        if prev_ok && i + 5 <= n && Substring(e, i, 5) == "false" {
            let next_false_ok: Bool = i + 5 == n || !IsIdentChar(CharAt(e, i + 5));
            if next_false_ok {
                out = Concat(out, "0");
                i = i + 5;
                continue;
            }
        }
        out = Concat(out, c);
        i = i + 1;
    }
    return out;
}

func RewriteNoneLiteral(e: String) -> String {
    let n: Int = StringLength(e);
    let out: String = "";
    let i: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CharAt(e, i);
        if in_str {
            out = Concat(out, c);
            if c == "\\" && i + 1 < n {
                out = Concat(out, CharAt(e, i + 1));
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            out = Concat(out, c);
            i = i + 1;
            continue;
        }
        let prev_ok: Bool = i == 0 || (!IsIdentChar(CharAt(e, i - 1)) && CharAt(e, i - 1) != ".");
        if prev_ok && i + 4 <= n && Substring(e, i, 4) == "None" {
            let next_ok: Bool = i + 4 == n || !IsIdentChar(CharAt(e, i + 4));
            if next_ok {
                out = Concat(out, Concat(OptionResultRuntimeCOptionNoneFn(), "()"));
                i = i + 4;
                continue;
            }
        }
        out = Concat(out, c);
        i = i + 1;
    }
    return out;
}

func ModeCsvCount(modes: String) -> Int {
    if StringLength(modes) == 0 {
        return 0;
    }
    let count: Int = 1;
    let i: Int = 0;
    while i < StringLength(modes) {
        if CharAt(modes, i) == "," {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

func RewriteCallArgsWithModes(inner: String, modes: String, env: String, mode_count: Int) -> String {
    let rem: String = StringTrim(inner);
    let out: String = "";
    let arg_index: Int = 0;
    while StringLength(rem) > 0 {
        let comma: Int = FindTopLevelComma(rem);
        let part: String = "";
        if comma < 0 {
            part = StringTrim(rem);
            rem = "";
        } else {
            part = StringTrim(Substring(rem, 0, comma));
            rem = StringTrim(Substring(rem, comma + 1, StringLength(rem) - (comma + 1)));
        }
        let mode: String = "default";
        if arg_index < mode_count {
            mode = CsvAt(modes, arg_index);
        }
        let rendered: String = RewriteExpr(part, env);
        if mode == "inout" {
            if !IsIdentifier(part) {
                Die(Concat("inout argument must be a variable: ", part));
            }
            rendered = Concat("&", rendered);
        }
        if arg_index == 0 {
            out = rendered;
        } else {
            out = Concat(out, Concat(", ", rendered));
        }
        arg_index = arg_index + 1;
    }
    return out;
}

func RewriteInoutCallArgs(e: String, env: String, strict: Bool) -> String {
    let n: Int = StringLength(e);
    let out: String = "";
    let i: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CharAt(e, i);
        if in_str {
            out = Concat(out, c);
            if c == "\\" && i + 1 < n {
                out = Concat(out, CharAt(e, i + 1));
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            out = Concat(out, c);
            i = i + 1;
            continue;
        }
        if IsIdentStart(c) {
            let j: Int = i;
            while j < n && IsIdentChar(CharAt(e, j)) {
                j = j + 1;
            }
            let ident: String = Substring(e, i, j - i);
            if j < n && CharAt(e, j) == "(" {
                let modes: String = LookupKindType(env, ident, "pm");
                if StringLength(modes) > 0 {
                    let close: Int = FindMatchingParen(e, j);
                    if close < 0 {
                        if strict {
                            Die(Concat("malformed call expression: ", e));
                        }
                        out = Concat(out, ident);
                        i = j;
                        continue;
                    }
                    let inner: String = Substring(e, j + 1, close - j - 1);
                    out = Concat(out, Concat(ident, Concat("(", Concat(RewriteCallArgsWithModes(inner, modes, env, ModeCsvCount(modes)), ")"))));
                    i = close + 1;
                    continue;
                }
            }
            out = Concat(out, ident);
            i = j;
            continue;
        }
        out = Concat(out, c);
        i = i + 1;
    }
    return out;
}

func RewriteTokens(e: String, env: String) -> String {
    let enumed: String = RewriteEnumRefs(e, env);
    let q0: String = RewriteMemberCalls(enumed, env);
    let q: String = RewriteQualifiedCalls(q0);
    let call_args: String = RewriteInoutCallArgs(q, env, true);
    let a: String = RewriteArrayLengthEnv(call_args, env);
    let b: String = RewriteIndexing(a, env);
    let c: String = ReplaceAllOutsideStrings(b, "StringLength(", Concat(StringRuntimeCStringLengthFn(), "("));
    let d0: String = ReplaceAllOutsideStrings(c, "StringContains(", Concat(StringRuntimeCStringContainsFn(), "("));
    let d: String = ReplaceAllOutsideStrings(d0, "StringIndexOf(", Concat(StringRuntimeCStringIndexOfFn(), "("));
    let f0: String = ReplaceAllOutsideStrings(d, "Split(", Concat(StringRuntimeCSplitFn(), "("));
    let f1: String = ReplaceAllOutsideStrings(f0, "ToInt(", Concat(StringRuntimeCToIntFn(), "("));
    let f: String = ReplaceAllOutsideStrings(f1, "StringTrim(", Concat(StringRuntimeCStringTrimFn(), "("));
    let f2: String = ReplaceAllOutsideStrings(f, "StringReplace(", Concat(StringRuntimeCStringReplaceFn(), "("));
    let f3: String = ReplaceAllOutsideStrings(f2, "ToUpper(", Concat(StringRuntimeCToUpperFn(), "("));
    let f4: String = ReplaceAllOutsideStrings(f3, "ToLower(", Concat(StringRuntimeCToLowerFn(), "("));
    let f5: String = ReplaceAllOutsideStrings(f4, "Abs(", Concat(MathRuntimeCAbsFn(), "("));
    let f6: String = ReplaceAllOutsideStrings(f5, "Min(", Concat(MathRuntimeCMinFn(), "("));
    let f7a: String = ReplaceAllOutsideStrings(f6, "Max(", Concat(MathRuntimeCMaxFn(), "("));
    let f7b: String = ReplaceAllOutsideStrings(f7a, "Sqrt(", Concat(MathRuntimeCSqrtFn(), "("));
    let f7c: String = ReplaceAllOutsideStrings(f7b, "Pow(", Concat(MathRuntimeCPowFn(), "("));
    let f7d: String = ReplaceAllOutsideStrings(f7c, "Floor(", Concat(MathRuntimeCFloorFn(), "("));
    let f7e: String = ReplaceAllOutsideStrings(f7d, "Ceil(", Concat(MathRuntimeCCeilFn(), "("));
    let f7seed: String = ReplaceAllOutsideStrings(f7e, "SeedRandom(", Concat(MathRuntimeCSeedRandomFn(), "("));
    let f7: String = ReplaceAllOutsideStrings(f7seed, "Random(", Concat(MathRuntimeCRandomFn(), "("));
    let g: String = ReplaceAllOutsideStrings(f7, "FileExists(", Concat(HostIORuntimeCFileExistsFn(), "("));
    let gw: String = ReplaceAllOutsideStrings(g, "WriteFile(", Concat(HostIORuntimeCWriteFileFn(), "("));
    let go: String = ReplaceAllOutsideStrings(gw, "FileOpen(", Concat(HostIORuntimeCFileOpenFn(), "("));
    let gwr: String = ReplaceAllOutsideStrings(go, "FileWrite(", Concat(HostIORuntimeCFileWriteFn(), "("));
    let gc: String = ReplaceAllOutsideStrings(gwr, "FileClose(", Concat(HostIORuntimeCFileCloseFn(), "("));
    let gr: String = ReplaceAllOutsideStrings(gc, "FileRead(", Concat(HostIORuntimeCFileReadFn(), "("));
    let gp: String = ReplaceAllOutsideStrings(gr, "Print(", Concat(StringRuntimeCPrintFn(), "("));
    let h0: String = ReplaceAllOutsideStrings(gp, "ReadFile(", Concat(HostIORuntimeCReadFileFn(), "("));
    let h: String = ReplaceAllOutsideStrings(h0, "DirWalk(", Concat(HostIORuntimeCDirWalkFn(), "("));
    let k: String = ReplaceAllOutsideStrings(h, "Args(", Concat(HostIORuntimeCArgsFn(), "("));
    let mc: String = ReplaceAllOutsideStrings(k, "CharCode(", Concat(StringRuntimeCCharCodeFn(), "("));
    let m0: String = ReplaceAllOutsideStrings(mc, "CharAtN(", Concat(StringRuntimeCCharAtNFn(), "("));
    let sw0: String = ReplaceAllOutsideStrings(m0, "SubContainsWithLen(", Concat(StringRuntimeCSubContainsWithLenFn(), "("));
    let sw1: String = ReplaceAllOutsideStrings(sw0, "SubEqualsWithLen(", Concat(StringRuntimeCSubEqualsWithLenFn(), "("));
    let sw2: String = ReplaceAllOutsideStrings(sw1, "SubIndexOfWithLen(", Concat(StringRuntimeCSubIndexOfWithLenFn(), "("));
    let sw3: String = ReplaceAllOutsideStrings(sw2, "SubStartsWithLen(", Concat(StringRuntimeCSubStartsWithLenFn(), "("));
    let m: String = ReplaceAllOutsideStrings(sw3, "Substring(", Concat(StringRuntimeCSubstringFn(), "("));
    let jn0: String = ReplaceAllOutsideStrings(m, "StringJoin(", Concat(StringRuntimeCStringJoinFn(), "("));
    let jn: String = ReplaceAllOutsideStrings(jn0, "Join(", Concat(StringRuntimeCStringJoinFn(), "("));
    let asort: String = ReplaceAllOutsideStrings(jn, "ArraySort(", Concat(CollectionRuntimeCIntSortFn(), "("));
    let arev: String = ReplaceAllOutsideStrings(asort, "ArrayReverse(", Concat(CollectionRuntimeCIntReverseFn(), "("));
    let amap: String = ReplaceAllOutsideStrings(arev, "ArrayMap(", Concat(CollectionRuntimeCIntMapFn(), "("));
    let afilter: String = ReplaceAllOutsideStrings(amap, "ArrayFilter(", Concat(CollectionRuntimeCIntFilterFn(), "("));
    let osome: String = ReplaceAllOutsideStrings(afilter, "Some(", Concat(OptionResultRuntimeCOptionSomeFn(), "("));
    let oissome: String = ReplaceAllOutsideStrings(osome, "IsSome(", Concat(OptionResultRuntimeCOptionIsSomeFn(), "("));
    let ounwrap: String = ReplaceAllOutsideStrings(oissome, "UnwrapOption(", Concat(OptionResultRuntimeCOptionUnwrapFn(), "("));
    let onone: String = RewriteNoneLiteral(ounwrap);
    let rok: String = ReplaceAllOutsideStrings(onone, "Ok(", Concat(OptionResultRuntimeCResultOkFn(), "("));
    let rerr: String = ReplaceAllOutsideStrings(rok, "Err(", Concat(OptionResultRuntimeCResultErrFn(), "("));
    let risok: String = ReplaceAllOutsideStrings(rerr, "IsOk(", Concat(OptionResultRuntimeCResultIsOkFn(), "("));
    let riserr: String = ReplaceAllOutsideStrings(risok, "IsErr(", Concat(OptionResultRuntimeCResultIsErrFn(), "("));
    let runwrapor: String = ReplaceAllOutsideStrings(riserr, "UnwrapOr(", Concat(OptionResultRuntimeCResultUnwrapOrFn(), "("));
    let runwrap: String = ReplaceAllOutsideStrings(runwrapor, "Unwrap(", Concat(OptionResultRuntimeCResultUnwrapFn(), "("));
    let tf: String = ReplaceAllOutsideStrings(runwrap, "ToFloat(", Concat(StringRuntimeCToFloatFn(), "("));
    let p: String = ReplaceAllOutsideStrings(tf, "ToString(", Concat(StringRuntimeCToStringFn(), "("));
    // `Concat(a, b)` lowers through the string runtime concat helper.
    // so it lowers recursively and inside arbitrary call arguments.
    return RewriteBoolLiterals(ReplaceAllOutsideStrings(p, "Concat(", Concat(StringRuntimeCConcatFn(), "(")));
}

// Emit a C integer-valued (or boolean) expression from the AST's parenthesized
// infix, with array/builtin rewrites applied.
func IntEval(expr: String, env: String) -> String {
    return RewriteExpr(expr, env);
}

// Emit a C string-valued (char*) expression. In a confirmed string context a
// top-level `+` is the concatenation operator (the operands are strings by
// construction), so it lowers through the string runtime concat helper. Everything else
// flows through the token pipeline.
func StrEval(expr: String, env: String) -> String {
    let e: String = StripOuterParens(expr);
    let p: Int = FindTopLevelPlus(e);
    if p >= 0 {
        let lhs: String = StringTrim(Substring(e, 0, p));
        let rhs: String = StringTrim(Substring(e, p + 1, StringLength(e) - (p + 1)));
        return Concat(StringRuntimeCConcatFn(), Concat("(", Concat(StrEval(lhs, env), Concat(", ", Concat(StrEval(rhs, env), ")")))));
    }
    if StartsWith(e, "ToString(") {
        let n: Int = StringLength(e);
        if CharAt(e, n - 1) != ")" {
            Die(Concat("malformed ToString(...): ", e));
        }
        let arg: String = StringTrim(Substring(e, 9, n - 9 - 1));
        if ExprKind(arg, env) == "String" {
            return StrEval(arg, env);
        }
    }
    return RewriteExpr(StringTrim(expr), env);
}

// Wrap a condition in C parens unless it is already a single parenthesized
// group. `(a > b)` stays as-is; `flag` becomes `(flag)`; `(a) && (b)` is
// wrapped to `((a) && (b))`.
func WrapCond(cond: String, env: String) -> String {
    let c: String = StringTrim(cond);
    let n: Int = StringLength(c);
    if n >= 2 && CharAt(c, 0) == "(" && CharAt(c, n - 1) == ")" && FindMatchingParen(c, 0) == n - 1 {
        return RewriteExpr(c, env);
    }
    return Concat("(", Concat(RewriteExpr(c, env), ")"));
}

// ---- Statement emitters ------------------------------------------------

// `Let: <name> : Int|String = <expr>`. Registers the variable's type into the
// environment box and emits a typed C declaration.
