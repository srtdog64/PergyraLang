import "member_call_receiver_carriage_owner.pgy";
func RewriteExpr(e: String, env: CodegenTypeEnv) -> String {
    return RewriteRoleOperators(e, env);
}
func RewriteRoleOperators(e: String, env: CodegenTypeEnv) -> String {
    let s: String = StripOuterParens(e);
    let p_opt: Option<Int> = FindTopLevelPlus(s);
    if IsSome(p_opt) {
        let p: Int = UnwrapOption(p_opt);
        let lhs: String = StringTrim(Substring(s, 0, p));
        let rhs: String = StringTrim(Substring(s, p + 1, StringLength(s) - (p + 1)));
        let lhs_kind: String = ExprKind(lhs, env);
        let rhs_kind: String = ExprKind(rhs, env);
        if lhs_kind == rhs_kind {
            let op_name: String = LookupKindType(env, Concat(lhs_kind, "+"), "op");
            if StringLength(op_name) == 0 && lhs_kind == "String" {
                op_name = StringRuntimeCConcatFn();
            }
            if StringLength(op_name) > 0 {
                return Concat(op_name, Concat("(", Concat(RewriteExpr(lhs, env),
                    Concat(", ", Concat(RewriteExpr(rhs, env), ")")))));
            }
        }
    }
    return RewriteBool(e, env);
}

func RewriteMemberCalls(e: String, env: CodegenTypeEnv) -> String {
    let n: Int = StringLength(e);
    let out: String = "";
    let i: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CodegenCharAt(e, i);
        if in_str {
            out = Concat(out, c);
            if c == "\\" && i + 1 < n {
                out = Concat(out, CodegenCharAt(e, i + 1));
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            out = Concat(out, c);
            i = i + 1;
            continue;
        }
        if IsIdentStart(c) {
            let direct_j: Int = i;
            while direct_j < n && IsIdentChar(CodegenCharAt(e, direct_j)) {
                direct_j = direct_j + 1;
            }
            let direct_ident: String = Substring(e, i, direct_j - i);
            let local_type: String = LookupKindType(env, direct_ident, "v");
            let direct_value: String = LookupKindType(env, direct_ident, "e");
            if StringLength(local_type) == 0 && StringLength(direct_value) > 0 {
                out = Concat(out, direct_value);
                i = direct_j;
                continue;
            }
        }
        if c == "." {
            let ol: Int = StringLength(out);
            let end: Int = ol;
            let start: Int = ol;
            while start > 0 && IsIdentChar(CodegenCharAt(out, start - 1)) {
                start = start - 1;
            }
            if start < end && i + 1 < n && IsIdentStart(CodegenCharAt(e, i + 1)) {
                let j: Int = i + 1;
                while j < n && IsIdentChar(CodegenCharAt(e, j)) {
                    j = j + 1;
                }
                if j < n && CodegenCharAt(e, j) == "(" {
                    let receiver: String = Substring(out, start, end - start);
                    let recv_type: String = LookupKindType(env, receiver, "v");
                    let method: String = Substring(e, i + 1, j - (i + 1));
                    let c_name: String = CompilerSymbolCQualifiedName(recv_type, method);
                    if StringLength(recv_type) > 0 && LookupKindType(env, c_name, "f") != "" {
                        let close_opt: Option<Int> = FindMatchingParen(e, j);
                        if !IsSome(close_opt) {
                            out = Concat(out, c);
                            i = i + 1;
                            continue;
                        }
                        let close: Int = UnwrapOption(close_opt);
                        let args: String = Substring(e, j + 1, close - j - 1);
                        let receiver_argument: String =
                            CodegenMemberCallReceiverArgument(
                                c_name, receiver, true, env
                            );
                        out = Substring(out, 0, start);
                        out = Concat(out, Concat(
                            c_name, Concat("(", receiver_argument)
                        ));
                        if StringLength(StringTrim(args)) > 0 {
                            out = Concat(out, Concat(", ", args));
                        }
                        out = Concat(out, ")");
                        i = close + 1;
                        continue;
                    }
                }
            }
        }
        out = Concat(out, c);
        i = i + 1;
    }
    return out;
}

func RewriteEnumRefs(e: String, env: CodegenTypeEnv) -> String {
    let n: Int = StringLength(e);
    let out: String = "";
    let i: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CodegenCharAt(e, i);
        if in_str {
            out = Concat(out, c);
            if c == "\\" && i + 1 < n {
                out = Concat(out, CodegenCharAt(e, i + 1));
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            out = Concat(out, c);
            i = i + 1;
            continue;
        }
        if c == "." {
            let ol: Int = StringLength(out);
            let end: Int = ol;
            let start: Int = ol;
            while start > 0 && IsIdentChar(CodegenCharAt(out, start - 1)) {
                start = start - 1;
            }
            if start < end && i + 1 < n && IsIdentStart(CodegenCharAt(e, i + 1)) {
                let j: Int = i + 1;
                while j < n && IsIdentChar(CodegenCharAt(e, j)) {
                    j = j + 1;
                }
                let receiver: String = Substring(out, start, end - start);
                let variant: String = Substring(e, i + 1, j - (i + 1));
                let key: String = Concat(receiver, Concat(".", variant));
                let value: String = LookupKindType(env, key, "e");
                if StringLength(value) > 0 {
                    out = Substring(out, 0, start);
                    out = Concat(out, value);
                    i = j;
                    continue;
                }
            }
        }
        out = Concat(out, c);
        i = i + 1;
    }
    return out;
}

// Rewrite a namespace-qualified call `NS.Func(...)` to the flattened C name
// `NS_Func(...)`. The parser flattens `namespace NS { func Func }` to a
// top-level `NS_Func` definition but renders calls in dotted form. A `.` that
// joins two identifiers and is followed (after the second identifier) by `(`
// is a qualified call; a `.` in `obj.field` (not followed by `(`) is left alone.
func RewriteQualifiedCalls(e: String) -> String {
    let n: Int = StringLength(e);
    let out: String = "";
    let i: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CodegenCharAt(e, i);
        if in_str {
            out = Concat(out, c);
            if c == "\\" && i + 1 < n {
                out = Concat(out, CodegenCharAt(e, i + 1));
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            out = Concat(out, c);
            i = i + 1;
            continue;
        }
        if c == "." {
            let ol: Int = StringLength(out);
            let prev_ok: Bool = ol > 0 && IsIdentChar(CodegenCharAt(out, ol - 1));
            let next_ok: Bool = i + 1 < n && IsIdentStart(CodegenCharAt(e, i + 1));
            if prev_ok && next_ok {
                let j: Int = i + 1;
                while j < n && IsIdentChar(CodegenCharAt(e, j)) {
                    j = j + 1;
                }
                if j < n && CodegenCharAt(e, j) == "(" {
                    let start: Int = ol;
                    while start > 0 && (IsIdentChar(CodegenCharAt(out, start - 1)) || CodegenCharAt(out, start - 1) == ".") {
                        start = start - 1;
                    }
                    let owner: String = Substring(out, start, ol - start);
                    let member: String = Substring(e, i + 1, j - (i + 1));
                    out = Substring(out, 0, start);
                    out = Concat(out, CompilerSymbolCQualifiedName(owner, member));
                    i = j;
                    continue;
                }
            }
        }
        out = Concat(out, c);
        i = i + 1;
    }
    return out;
}

func RewriteStructLiteralCallArg(expr: String, expected_type: String, env: CodegenTypeEnv) -> String {
    let e: String = StringTrim(expr);
    if LookupKindType(env, expected_type, "s") != "struct" ||
        !StructLiteralCallMatchesType(e, expected_type) {
        return RewriteExpr(expr, env);
    }
    let call_fact: StructLiteralCallFact = StructLiteralCallFactOrDie(e, "struct argument literal");
    let inner: String = StringTrim(call_fact.inner);
    let c_expected_type: String = AbiLayoutCStructTypeName(expected_type);
    let out: String = Concat("(", Concat(c_expected_type, "){ "));
    let first: Bool = true;
    let field_pos: Int = 0;
    let field_names: String = LookupKindType(env, expected_type, "fields");
    let field_count: Int = ExprSequenceItemCount(inner);
    while field_pos < field_count {
        let part_opt: Option<String> = ExprSequenceItemAt(inner, field_pos);
        if IsSome(part_opt) {
            let part: String = UnwrapOption(part_opt);
            let field_fact: StructLiteralFieldEntryFact = StructLiteralFieldEntryFactOrDie(part, field_names, field_pos, "struct argument");
            let fld: String = field_fact.field_name;
            let val: String = field_fact.value;
            if !first {
                out = Concat(out, ", ");
            }
            let ftype: String = LookupFieldType(env, expected_type, fld);
            if StringLength(ftype) == 0 {
                Die(Concat("struct argument initializer field lacks type fact: ", Concat(expected_type, Concat(".", fld))));
            }
            let cval: String = "";
            if ftype == "String" {
                cval = StrEval(val, env);
            } else if ftype == "Float" || ftype == "Double" {
                cval = RewriteExpr(val, env);
            } else if ftype == "Int" || ftype == "Bool" {
                cval = IntEval(val, env);
            } else if StartsWith(ftype, "Array<") {
                let array_kind: String =
                    CodegenBindingEnvKind(ftype, env);
                let array_val: String = StringTrim(val);
                if StringLength(array_val) > 0 && CodegenCharAt(array_val, 0) == "[" {
                    cval = EmitArrayLiteralValue(array_val, ftype, env);
                } else {
                    cval = RewriteExpr(array_val, env);
                }
                if StringLength(array_kind) == 0 {
                    Die(Concat("unsupported struct argument array field type: ", ftype));
                }
            } else if LookupKindType(env, ftype, "s") == "struct" {
                cval = RewriteStructLiteralCallArg(val, ftype, env);
            } else if LookupKindType(env, ftype, "enum") == "payload_free" {
                cval = RewriteExpr(val, env);
            } else {
                Die(Concat("unsupported struct argument field type: ", ftype));
            }
            let c_fld: String = CompilerSymbolCFieldName(fld);
            out = Concat(out, Concat(".", Concat(c_fld, Concat(" = (", Concat(cval, ")")))));
            first = false;
        }
        field_pos = field_pos + 1;
    }
    return Concat(out, " }");
}

func RewriteCallArgForExpectedType(part: String, expected_type: String, env: CodegenTypeEnv) -> String {
    let argument: String = StringTrim(part);
    if StartsWith(expected_type, "Array<") &&
        StringLength(argument) > 0 && CodegenCharAt(argument, 0) == "[" {
        return EmitArrayLiteralValue(argument, expected_type, env);
    }
    if StringLength(expected_type) > 0 && LookupKindType(env, expected_type, "s") == "struct" {
        return RewriteStructLiteralCallArg(part, expected_type, env);
    }
    let enum_fact_opt: Option<EnumLiteralProjectionFact> = EnumPayloadFreeArgumentProjectionFactOpt(part, expected_type, env);
    if IsSome(enum_fact_opt) {
        let enum_fact: EnumLiteralProjectionFact = UnwrapOption(enum_fact_opt);
        return enum_fact.c_value;
    }
    return RewriteExpr(part, env);
}

func RewriteCallArgsWithModes(inner: String, modes: String, param_types: String, env: CodegenTypeEnv, mode_count: Int) -> String {
    let out: String = "";
    let arg_index: Int = 0;
    let arg_count: Int = ExprSequenceItemCount(inner);
    while arg_index < arg_count {
        let part_opt: Option<String> = ExprSequenceItemAt(inner, arg_index);
        if !IsSome(part_opt) {
            Die(Concat("missing call argument at index: ", ToString(arg_index)));
        }
        let part: String = UnwrapOption(part_opt);
        let mode: String = "default";
        if arg_index < mode_count {
            mode = ParamModeCsvAt(modes, arg_index);
        }
        let expected_type: String = CsvAt(param_types, arg_index);
        let rendered: String = RewriteCallArgForExpectedType(part, expected_type, env);
        if mode == "inout" {
            if !IsIdentifier(part) {
                Die(Concat("inout argument must be a variable: ", part));
            }
            rendered = Concat("&", rendered);
        } else if mode == "ref" {
            let already_ref: Bool = IsIdentifier(part) &&
                TypeEnvBindingIsReadonlyRef(env, part);
            let member_lvalue: Bool = StringIndexOf(part, ".") > 0 &&
                StringIndexOf(part, "(") < 0 &&
                StringIndexOf(part, "[") < 0;
            if already_ref {
                let ref_c_name: Option<String> = TypeEnvReadonlyRefCName(
                    env, part
                );
                if !IsSome(ref_c_name) {
                    Die(Concat("readonly ref binding fact missing: ", part));
                }
                rendered = UnwrapOption(ref_c_name);
            } else {
                if !IsIdentifier(part) && !member_lvalue {
                    Die(Concat("ref argument must be addressable: ", part));
                }
                if !AbiLayoutCReadonlyRefPassesDirect(expected_type) {
                    rendered = Concat("&", rendered);
                }
            }
        }
        if arg_index == 0 {
            out = rendered;
        } else {
            out = Concat(out, Concat(", ", rendered));
        }
        arg_index = arg_index + 1;
    }
    return out;
}

func RewriteInoutCallArgs(e: String, env: CodegenTypeEnv, strict: Bool) -> String {
    let n: Int = StringLength(e);
    let out: String = "";
    let i: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CodegenCharAt(e, i);
        if in_str {
            out = Concat(out, c);
            if c == "\\" && i + 1 < n {
                out = Concat(out, CodegenCharAt(e, i + 1));
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            out = Concat(out, c);
            i = i + 1;
            continue;
        }
        if IsIdentStart(c) {
            let j: Int = i;
            while j < n && IsIdentChar(CodegenCharAt(e, j)) {
                j = j + 1;
            }
            let ident: String = Substring(e, i, j - i);
            if j < n && CodegenCharAt(e, j) == "(" {
                let call_symbol: String = ident;
                let call_alias: String = LookupKindType(env, ident, "call");
                if StringLength(call_alias) > 0 {
                    call_symbol = call_alias;
                }
                let modes: String = LookupKindType(env, call_symbol, "pm");
                if StringLength(modes) > 0 {
                    let param_types: String = LookupKindType(env, call_symbol, "pt");
                    let close_opt: Option<Int> = FindMatchingParen(e, j);
                    if !IsSome(close_opt) {
                        if strict {
                            Die(Concat("malformed call expression: ", e));
                        }
                        out = Concat(out, ident);
                        i = j;
                        continue;
                    }
                    let close: Int = UnwrapOption(close_opt);
                    let inner: String = Substring(e, j + 1, close - j - 1);
                    out = Concat(out, Concat(call_symbol, Concat("(", Concat(RewriteCallArgsWithModes(inner, modes, param_types, env, ParamModeCsvCount(modes)), ")"))));
                    i = close + 1;
                    continue;
                }
                if call_symbol != ident {
                    out = Concat(out, call_symbol);
                    i = j;
                    continue;
                }
            }
            out = Concat(out, ident);
            i = j;
            continue;
        }
        out = Concat(out, c);
        i = i + 1;
    }
    return out;
}

func RewriteTokens(e: String, env: CodegenTypeEnv) -> String {
    let enumed: String = RewriteEnumRefs(e, env);
    let q0: String = RewriteMemberCalls(enumed, env);
    let q: String = RewriteQualifiedCalls(q0);
    let call_args: String = RewriteInoutCallArgs(q, env, true);
    let a: String = RewriteArrayLengthEnv(call_args, env);
    let optioned: String = "";
    let some_scan_len: Int = StringLength(a);
    let some_scan_i: Int = 0;
    let some_scan_in_str: Bool = false;
    while some_scan_i < some_scan_len {
        let some_scan_char: String = CodegenCharAt(a, some_scan_i);
        if some_scan_in_str {
            optioned = Concat(optioned, some_scan_char);
            if some_scan_char == "\\" && some_scan_i + 1 < some_scan_len {
                optioned = Concat(optioned, CodegenCharAt(a, some_scan_i + 1));
                some_scan_i = some_scan_i + 2;
                continue;
            }
            if some_scan_char == "\"" {
                some_scan_in_str = false;
            }
            some_scan_i = some_scan_i + 1;
            continue;
        }
        if some_scan_char == "\"" {
            some_scan_in_str = true;
            optioned = Concat(optioned, some_scan_char);
            some_scan_i = some_scan_i + 1;
            continue;
        }
        if IsIdentStart(some_scan_char) {
            let some_ident_end: Int = some_scan_i;
            while some_ident_end < some_scan_len && IsIdentChar(CodegenCharAt(a, some_ident_end)) {
                some_ident_end = some_ident_end + 1;
            }
            let some_ident: String = Substring(a, some_scan_i, some_ident_end - some_scan_i);
            if some_ident == "Some" && some_ident_end < some_scan_len && CodegenCharAt(a, some_ident_end) == "(" {
                let some_close_opt: Option<Int> = FindMatchingParen(a, some_ident_end);
                if !IsSome(some_close_opt) {
                    Die(Concat("malformed Some(...) expression: ", a));
                }
                let some_close: Int = UnwrapOption(some_close_opt);
                let some_inner: String = StringTrim(Substring(a, some_ident_end + 1, some_close - some_ident_end - 1));
                let some_payload_kind: Int = OptionResultRuntimeOptionPayloadKindFromExprKind(ExprKind(some_inner, env));
                let some_fn: String = OptionResultRuntimeCOptionSomeFnForPayloadKind(some_payload_kind);
                optioned = Concat(optioned, Concat(some_fn, Concat("(", Concat(RewriteExpr(some_inner, env), ")"))));
                some_scan_i = some_close + 1;
                continue;
            }
            optioned = Concat(optioned, some_ident);
            some_scan_i = some_ident_end;
            continue;
        }
        optioned = Concat(optioned, some_scan_char);
        some_scan_i = some_scan_i + 1;
    }
    let b: String = RewriteIndexing(optioned, env);
    let fielded: String = RewriteStructFieldAccess(b, env);
    let bound: String = RewriteBindingRefs(fielded, env);
    let runtime_calls: String = RewriteRuntimeCallsOutsideStrings(bound);
    let optioned_runtime_calls: String = RewriteNoneLiteral(runtime_calls);
    return RewriteLongLiteralSuffixes(RewriteBoolLiterals(optioned_runtime_calls));
}

func EmitArrayLiteralValue(
    expr: String,
    expected_type: String,
    env: CodegenTypeEnv
) -> String {
    let literal: String = StringTrim(expr);
    if StringLength(literal) < 2 || CodegenCharAt(literal, 0) != "[" ||
        CodegenCharAt(literal, StringLength(literal) - 1) != "]" {
        Die(Concat("expected array literal for type: ", expected_type));
    }
    let collection: CollectionRuntimeFact =
        CollectionRuntimeFactFromTypeName(expected_type, env);
    let element_type: String = collection.element_type;
    let inner: String = StringTrim(Substring(
        literal, 1, StringLength(literal) - 2
    ));
    let item_values: Array<String> = [];
    let index: Int = 0;
    while index < ExprSequenceItemCount(inner) {
        let item: Option<String> = ExprSequenceItemAt(inner, index);
        if !IsSome(item) { Die("array literal item fact is missing"); }
        let item_expr: String = UnwrapOption(item);
        let value: String = IntEval(item_expr, env);
        if element_type == "String" { value = StrEval(item_expr, env); }
        ArrayPush(item_values, value);
        index = index + 1;
    }
    return EmitArrayLiteralFromRenderedItems(
        expected_type, env, item_values
    );
}

func IntEval(expr: String, env: CodegenTypeEnv) -> String {
    return RewriteExpr(expr, env);
}

func StrEval(expr: String, env: CodegenTypeEnv) -> String {
    let e: String = StripOuterParens(expr);
    let p_opt: Option<Int> = FindTopLevelPlus(e);
    if IsSome(p_opt) {
        let p: Int = UnwrapOption(p_opt);
        let lhs: String = StringTrim(Substring(e, 0, p));
        let rhs: String = StringTrim(Substring(e, p + 1, StringLength(e) - (p + 1)));
        return Concat(StringRuntimeCConcatFn(), Concat("(", Concat(StrEval(lhs, env), Concat(", ", Concat(StrEval(rhs, env), ")")))));
    }
    if StartsWith(e, "ToString(") {
        let n: Int = StringLength(e);
        if CodegenCharAt(e, n - 1) != ")" {
            Die(Concat("malformed ToString(...): ", e));
        }
        let arg: String = StringTrim(Substring(e, 9, n - 9 - 1));
        if ExprKind(arg, env) == "String" {
            return StrEval(arg, env);
        }
    }
    return RewriteExpr(StringTrim(expr), env);
}

func WrapCond(cond: String, env: CodegenTypeEnv) -> String {
    let c: String = StringTrim(cond);
    let n: Int = StringLength(c);
    let close_opt: Option<Int> = FindMatchingParen(c, 0);
    if n >= 2 && CodegenCharAt(c, 0) == "(" && CodegenCharAt(c, n - 1) == ")" &&
        IsSome(close_opt) && UnwrapOption(close_opt) == n - 1 {
        return RewriteExpr(c, env);
    }
    return Concat("(", Concat(RewriteExpr(c, env), ")"));
}
