// Storage addressability projected from expression graph and binding facts.

import "expr_semantic_type_owner.pgy";

func CodegenExpressionAddressabilityFromGraph(
    graph: SemanticExpressionGraphFacts,
    node_id: Int,
    env: CodegenTypeEnv
) -> Option<Bool> {
    let kind: Option<Int> = SemanticExpressionGraphNodeKind(
        graph, node_id
    );
    if !IsSome(kind) { return None; }
    let kind_value: Int = UnwrapOption(kind);
    if kind_value == AstExpressionNodeLeaf() {
        let text: Option<String> = SemanticExpressionGraphNodeText(
            graph, node_id
        );
        if !IsSome(text) { return None; }
        return Some(
            LookupKindType(env, UnwrapOption(text), "cbind") != ""
        );
    }
    if kind_value != AstExpressionNodeMemberAccess() {
        return Some(false);
    }
    let view: SemanticMemberAccessView =
        SemanticMemberAccessViewFromGraph(graph, node_id);
    if !view.ok { return None; }
    if !IsSome(CodegenExpressionMemberFieldTypeFromGraph(
        graph, node_id, env
    )) {
        return Some(false);
    }
    return CodegenExpressionAddressabilityFromGraph(
        graph, view.receiver_node, env
    );
}
