// Call and member emission from parser-owned expression graph nodes.

import "../input/semantic_expression_codegen_view_owner.pgy";
import "expr_rewrite.pgy";

struct SemanticCallSpineView {
    ok: Bool;
    callee_node: Int;
    argument_nodes: Array<Int>;
}

struct SemanticMemberAccessView {
    ok: Bool;
    receiver_node: Int;
    member_node: Int;
}

func SemanticMemberAccessViewFromGraph(
    graph: SemanticExpressionGraphFacts,
    node_id: Int
) -> SemanticMemberAccessView {
    let kind: Option<Int> = SemanticExpressionGraphNodeKind(graph, node_id);
    let receiver: Option<Int> = SemanticExpressionGraphLeftChild(
        graph, node_id
    );
    let member: Option<Int> = SemanticExpressionGraphRightChild(
        graph, node_id
    );
    if !IsSome(kind) || UnwrapOption(kind) !=
            AstExpressionNodeMemberAccess() ||
        !IsSome(receiver) || !IsSome(member) {
        return SemanticMemberAccessView(false, 0, 0);
    }
    let member_kind: Option<Int> = SemanticExpressionGraphNodeKind(
        graph, UnwrapOption(member)
    );
    if !IsSome(member_kind) || UnwrapOption(member_kind) !=
        AstExpressionNodeLeaf() {
        return SemanticMemberAccessView(false, 0, 0);
    }
    return SemanticMemberAccessView(
        true, UnwrapOption(receiver), UnwrapOption(member)
    );
}

func SemanticCallSpineViewFromGraph(
    graph: SemanticExpressionGraphFacts,
    root_id: Int
) -> SemanticCallSpineView {
    let reversed: Array<Int> = [];
    let node: Int = root_id;
    let kind: Option<Int> = SemanticExpressionGraphNodeKind(graph, node);
    while IsSome(kind) &&
        UnwrapOption(kind) == AstExpressionNodeCallArgument() {
        let argument: Option<Int> = SemanticExpressionGraphRightChild(
            graph, node
        );
        let previous: Option<Int> = SemanticExpressionGraphLeftChild(
            graph, node
        );
        if !IsSome(argument) || !IsSome(previous) {
            return SemanticCallSpineView(false, 0, reversed);
        }
        ArrayPush(reversed, UnwrapOption(argument));
        node = UnwrapOption(previous);
        kind = SemanticExpressionGraphNodeKind(graph, node);
    }
    if !IsSome(kind) || UnwrapOption(kind) != AstExpressionNodeCall() {
        return SemanticCallSpineView(false, 0, reversed);
    }
    let callee: Option<Int> = SemanticExpressionGraphLeftChild(graph, node);
    if !IsSome(callee) {
        return SemanticCallSpineView(false, 0, reversed);
    }
    let arguments: Array<Int> = [];
    let i: Int = ArrayLength(reversed) - 1;
    while i >= 0 {
        ArrayPush(arguments, reversed[i]);
        i = i - 1;
    }
    return SemanticCallSpineView(true, UnwrapOption(callee), arguments);
}

func RewriteSemanticCallArgument(
    graph: SemanticExpressionGraphFacts,
    node_id: Int,
    expected_type: String,
    mode: String,
    env: CodegenTypeEnv
) -> String {
    let text: Option<String> = SemanticExpressionGraphNodeText(
        graph, node_id
    );
    let kind: Option<Int> = SemanticExpressionGraphNodeKind(
        graph, node_id
    );
    if !IsSome(text) || !IsSome(kind) {
        Die("semantic call argument fact is missing");
    }
    let source: String = UnwrapOption(text);
    let rendered: String = "";
    if StartsWith(expected_type, "Array<") &&
        StringLength(source) > 0 && CodegenCharAt(source, 0) == "[" {
        rendered = EmitArrayLiteralValue(source, expected_type, env);
    } else if LookupKindType(env, expected_type, "s") == "struct" &&
        UnwrapOption(kind) == AstExpressionNodeLeaf() &&
        StructLiteralCallMatchesType(source, expected_type) {
        rendered = RewriteStructLiteralCallArg(source, expected_type, env);
    } else {
        let enum_fact: Option<EnumLiteralProjectionFact> =
            EnumPayloadFreeArgumentProjectionFactOpt(
                source, expected_type, env
            );
        if IsSome(enum_fact) {
            rendered = UnwrapOption(enum_fact).c_value;
        } else {
            rendered = RewriteExprFromSemanticGraph(graph, node_id, env);
        }
    }
    if mode == "inout" {
        if !IsIdentifier(source) {
            Die(Concat("inout argument must be a variable: ", source));
        }
        return Concat("&", rendered);
    }
    if mode == "ref" {
        let already_ref: Bool = IsIdentifier(source) &&
            TypeEnvBindingIsReadonlyRef(env, source);
        let member_lvalue: Bool = StringIndexOf(source, ".") > 0 &&
            StringIndexOf(source, "(") < 0 &&
            StringIndexOf(source, "[") < 0;
        if already_ref {
            let c_name: Option<String> = TypeEnvReadonlyRefCName(env, source);
            if !IsSome(c_name) {
                Die(Concat("readonly ref binding fact missing: ", source));
            }
            return UnwrapOption(c_name);
        }
        if !IsIdentifier(source) && !member_lvalue {
            Die(Concat("ref argument must be addressable: ", source));
        }
        return Concat("&", rendered);
    }
    return rendered;
}

func RewriteSemanticStructCall(
    graph: SemanticExpressionGraphFacts,
    view: SemanticCallSpineView,
    type_name: String,
    env: CodegenTypeEnv
) -> String {
    let fields: String = LookupKindType(env, type_name, "fields");
    let out: String = Concat(
        "(", Concat(AbiLayoutCStructTypeName(type_name), "){ ")
    );
    let i: Int = 0;
    while i < ArrayLength(view.argument_nodes) {
        let field_name: String = CsvAt(fields, i);
        let field_type: String = LookupFieldType(env, type_name, field_name);
        if field_name == "" || field_type == "" {
            Die(Concat("struct call field fact is missing: ", type_name));
        }
        let value: String = RewriteSemanticCallArgument(
            graph, view.argument_nodes[i], field_type, "default", env
        );
        if i > 0 { out = Concat(out, ", "); }
        out = Concat(out, Concat(
            ".", Concat(CompilerSymbolCFieldName(field_name), Concat(
                " = (", Concat(value, ")")
            ))
        ));
        i = i + 1;
    }
    if CsvAt(fields, ArrayLength(view.argument_nodes)) != "" {
        Die(Concat("struct call argument fact is missing: ", type_name));
    }
    return Concat(out, " }");
}

func RewriteSemanticCallArguments(
    graph: SemanticExpressionGraphFacts,
    view: SemanticCallSpineView,
    modes: String,
    param_types: String,
    param_offset: Int,
    prefix_argument: String,
    env: CodegenTypeEnv
) -> String {
    let args: String = prefix_argument;
    let i: Int = 0;
    while i < ArrayLength(view.argument_nodes) {
        let param_index: Int = i + param_offset;
        let mode: String = "default";
        if param_index < ParamModeCsvCount(modes) {
            mode = ParamModeCsvAt(modes, param_index);
        }
        let expected_type: String = CsvAt(param_types, param_index);
        let argument: String = RewriteSemanticCallArgument(
            graph, view.argument_nodes[i], expected_type, mode, env
        );
        if args == "" { args = argument; }
        else { args = Concat(args, Concat(", ", argument)); }
        i = i + 1;
    }
    return args;
}

func SemanticMemberReceiverTypeFromGraph(
    graph: SemanticExpressionGraphFacts,
    node_id: Int,
    env: CodegenTypeEnv
) -> Option<String> {
    let kind: Option<Int> = SemanticExpressionGraphNodeKind(graph, node_id);
    if !IsSome(kind) {
        return None;
    }
    if UnwrapOption(kind) == AstExpressionNodeLeaf() {
        let text: Option<String> = SemanticExpressionGraphNodeText(
            graph, node_id
        );
        if !IsSome(text) || !IsIdentifier(UnwrapOption(text)) {
            return None;
        }
        let value_type: String = LookupKindType(
            env, UnwrapOption(text), "v"
        );
        if value_type == "" {
            return None;
        }
        return Some(value_type);
    }
    if UnwrapOption(kind) != AstExpressionNodeMemberAccess() {
        return None;
    }
    let view: SemanticMemberAccessView =
        SemanticMemberAccessViewFromGraph(graph, node_id);
    if !view.ok {
        return None;
    }
    let member_text: Option<String> = SemanticExpressionGraphNodeText(
        graph, view.member_node
    );
    let receiver_type: Option<String> = SemanticMemberReceiverTypeFromGraph(
        graph, view.receiver_node, env
    );
    if !IsSome(member_text) ||
        !IsIdentifier(UnwrapOption(member_text)) ||
        !IsSome(receiver_type) {
        return None;
    }
    let field_type: String = LookupFieldType(
        env, UnwrapOption(receiver_type), UnwrapOption(member_text)
    );
    if field_type == "" {
        return None;
    }
    return Some(field_type);
}

func RewriteSemanticMemberAccess(
    graph: SemanticExpressionGraphFacts,
    node_id: Int,
    env: CodegenTypeEnv
) -> String {
    let view: SemanticMemberAccessView =
        SemanticMemberAccessViewFromGraph(graph, node_id);
    if !view.ok {
        Die("semantic member-access graph is missing or malformed");
    }
    let receiver_kind: Option<Int> = SemanticExpressionGraphNodeKind(
        graph, view.receiver_node
    );
    let receiver_text: Option<String> = SemanticExpressionGraphNodeText(
        graph, view.receiver_node
    );
    let member_text: Option<String> = SemanticExpressionGraphNodeText(
        graph, view.member_node
    );
    if !IsSome(receiver_kind) || !IsSome(member_text) ||
        !IsIdentifier(UnwrapOption(member_text)) {
        Die("semantic member-access edge fact is missing");
    }
    let member_name: String = UnwrapOption(member_text);
    if UnwrapOption(receiver_kind) == AstExpressionNodeLeaf() &&
        IsSome(receiver_text) && IsIdentifier(UnwrapOption(receiver_text)) {
        let enum_value: String = LookupKindType(
            env, Concat(
                UnwrapOption(receiver_text), Concat(".", member_name)
            ), "e"
        );
        if enum_value != "" { return enum_value; }
    }
    let receiver_type: Option<String> = SemanticMemberReceiverTypeFromGraph(
        graph, view.receiver_node, env
    );
    if !IsSome(receiver_type) ||
        LookupFieldType(env, UnwrapOption(receiver_type), member_name) == "" {
        Die("semantic member-access field fact is missing");
    }
    let receiver: String = RewriteExprFromSemanticGraph(
        graph, view.receiver_node, env
    );
    return Concat(receiver, Concat(
        ".", CompilerSymbolCFieldName(member_name)
    ));
}

func RewriteSemanticMemberCall(
    graph: SemanticExpressionGraphFacts,
    view: SemanticCallSpineView,
    env: CodegenTypeEnv
) -> String {
    let member: SemanticMemberAccessView =
        SemanticMemberAccessViewFromGraph(graph, view.callee_node);
    if !member.ok {
        Die("semantic member-call callee is missing or malformed");
    }
    let receiver_kind: Option<Int> = SemanticExpressionGraphNodeKind(
        graph, member.receiver_node
    );
    let receiver_text: Option<String> = SemanticExpressionGraphNodeText(
        graph, member.receiver_node
    );
    let member_text: Option<String> = SemanticExpressionGraphNodeText(
        graph, member.member_node
    );
    if !IsSome(receiver_kind) || UnwrapOption(receiver_kind) !=
            AstExpressionNodeLeaf() || !IsSome(receiver_text) ||
        !IsSome(member_text) ||
        !IsIdentifier(UnwrapOption(receiver_text)) ||
        !IsIdentifier(UnwrapOption(member_text)) {
        Die("semantic member-call leaf fact is missing");
    }
    let receiver_name: String = UnwrapOption(receiver_text);
    let method_name: String = UnwrapOption(member_text);
    let receiver_type: String = LookupKindType(env, receiver_name, "v");
    let call_symbol: String = "";
    let param_offset: Int = 0;
    let prefix_argument: String = "";
    if receiver_type != "" {
        call_symbol = CompilerSymbolCQualifiedName(
            receiver_type, method_name
        );
        if LookupKindType(env, call_symbol, "f") == "" {
            Die("semantic member-call method fact is missing");
        }
        param_offset = 1;
        prefix_argument = RewriteExprFromSemanticGraph(
            graph, member.receiver_node, env
        );
    } else {
        call_symbol = CompilerSymbolCQualifiedName(
            receiver_name, method_name
        );
        if LookupKindType(env, call_symbol, "f") == "" {
            Die("semantic qualified-call function fact is missing");
        }
    }
    let modes: String = LookupKindType(env, call_symbol, "pm");
    let param_types: String = LookupKindType(env, call_symbol, "pt");
    let args: String = RewriteSemanticCallArguments(
        graph, view, modes, param_types, param_offset,
        prefix_argument, env
    );
    return Concat(call_symbol, Concat("(", Concat(args, ")")));
}

func RewriteSemanticDirectCall(
    graph: SemanticExpressionGraphFacts,
    root_id: Int,
    env: CodegenTypeEnv
) -> String {
    let view: SemanticCallSpineView = SemanticCallSpineViewFromGraph(
        graph, root_id
    );
    if !view.ok {
        Die("semantic direct-call spine is missing or malformed");
    }
    let callee_text: Option<String> = SemanticExpressionGraphNodeText(
        graph, view.callee_node
    );
    if !IsSome(callee_text) || !IsIdentifier(UnwrapOption(callee_text)) {
        Die("semantic direct-call callee is not an identifier");
    }
    let source_name: String = UnwrapOption(callee_text);
    if LookupKindType(env, source_name, "s") == "struct" {
        return RewriteSemanticStructCall(graph, view, source_name, env);
    }
    let call_symbol: String = source_name;
    let alias: String = LookupKindType(env, source_name, "call");
    if alias != "" { call_symbol = alias; }
    let modes: String = LookupKindType(env, call_symbol, "pm");
    let param_types: String = LookupKindType(env, call_symbol, "pt");
    if source_name == "Some" {
        if ArrayLength(view.argument_nodes) != 1 {
            Die("Some call requires exactly one argument graph");
        }
        let payload_text: Option<String> = SemanticExpressionGraphNodeText(
            graph, view.argument_nodes[0]
        );
        if !IsSome(payload_text) {
            Die("Some call payload fact is missing");
        }
        call_symbol = OptionResultRuntimeCOptionSomeFnForPayloadKind(
            OptionResultRuntimeOptionPayloadKindFromExprKind(
                ExprKind(UnwrapOption(payload_text), env)
            )
        );
    } else if source_name == "ArrayLength" {
        if ArrayLength(view.argument_nodes) != 1 {
            Die("ArrayLength call requires exactly one argument graph");
        }
        let array_text: Option<String> = SemanticExpressionGraphNodeText(
            graph, view.argument_nodes[0]
        );
        if !IsSome(array_text) {
            Die("ArrayLength argument fact is missing");
        }
        let array_kind: String = LookupKindType(
            env, UnwrapOption(array_text), "v"
        );
        if array_kind == "" {
            array_kind = ExprKind(UnwrapOption(array_text), env);
        }
        if StartsWith(array_kind, "Array<") {
            array_kind = CollectionRuntimeKindFromTypeName(array_kind);
        }
        call_symbol = CollectionRuntimeCLenFn(
            CollectionRuntimeKindCode(array_kind)
        );
    } else {
        let runtime_symbol: Option<String> = RuntimeCallCName(source_name);
        if IsSome(runtime_symbol) {
            call_symbol = UnwrapOption(runtime_symbol);
        }
    }
    let args: String = RewriteSemanticCallArguments(
        graph, view, modes, param_types, 0, "", env
    );
    return Concat(call_symbol, Concat("(", Concat(args, ")")));
}

func RewriteSemanticCall(
    graph: SemanticExpressionGraphFacts,
    root_id: Int,
    env: CodegenTypeEnv
) -> String {
    let view: SemanticCallSpineView = SemanticCallSpineViewFromGraph(
        graph, root_id
    );
    if !view.ok {
        Die("semantic call spine is missing or malformed");
    }
    let callee_kind: Option<Int> = SemanticExpressionGraphNodeKind(
        graph, view.callee_node
    );
    if !IsSome(callee_kind) {
        Die("semantic call callee kind is missing");
    }
    if UnwrapOption(callee_kind) == AstExpressionNodeMemberAccess() {
        return RewriteSemanticMemberCall(graph, view, env);
    }
    if UnwrapOption(callee_kind) != AstExpressionNodeLeaf() {
        Die("semantic call callee kind is unsupported");
    }
    return RewriteSemanticDirectCall(graph, root_id, env);
}
