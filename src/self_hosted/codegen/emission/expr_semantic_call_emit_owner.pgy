// Call and member emission from parser-owned expression graph nodes.

import "../input/semantic_expression_codegen_view_owner.pgy";
import "../text/text_owner.pgy";
import "../input/generic_specialization_codegen_view_owner.pgy";
import "../../semantic/ast_expression_call_target_fact_owner.pgy";
import "../../semantic/ast_expression_graph_call_view_owner.pgy";
import "../../semantic/ast_expression_graph_member_view_owner.pgy";
import "../../semantic/wrapper_type_owner.pgy";
import "../runtime_abi/result_runtime_owner.pgy";
import "../../compiler/machine_layer_runtime_projection_owner.pgy";
import "../../compiler/runtime_call_abi_structured_fact_owner.pgy";
import "expr_rewrite.pgy";
import "expr_semantic_type_owner.pgy";

func RewriteSemanticCallArgument(
    graph: SemanticExpressionGraphFacts,
    node_id: Int,
    expected_type: String,
    mode: String,
    env: CodegenTypeEnv
) -> String {
    let text: Option<String> = SemanticExpressionGraphNodeText(
        graph, node_id
    );
    if !IsSome(text) {
        Die("semantic call argument fact is missing");
    }
    let source: String = UnwrapOption(text);
    let rendered: String = RewriteSemanticExpectedValue(
        graph, node_id, expected_type, env
    );
    if mode != "inout" && mode != "ref" { return rendered; }
    let place_kind: Option<Int> = SemanticExpressionGraphPlaceKind(
        graph, node_id
    );
    if !IsSome(place_kind) {
        Die("semantic call argument place fact is missing");
    }
    let carried_place_kind: Int = UnwrapOption(place_kind);
    let addressable: Bool = SemanticExpressionPlaceKindAddressable(
        carried_place_kind
    );
    let direct_binding: Bool =
        SemanticExpressionPlaceKindDirectBinding(carried_place_kind);
    if mode == "inout" {
        if !direct_binding {
            Die(Concat("inout argument must be a variable: ", source));
        }
        return Concat("&", rendered);
    }
    if mode == "ref" {
        let already_ref: Bool = carried_place_kind ==
            SemanticExpressionPlaceReadonlyRefBinding();
        if already_ref {
            let c_name: Option<String> = TypeEnvReadonlyRefCName(env, source);
            if !IsSome(c_name) {
                Die(Concat("readonly ref binding fact missing: ", source));
            }
            return UnwrapOption(c_name);
        }
        if !addressable {
            Die(Concat("ref argument must be addressable: ", source));
        }
        return Concat("&", rendered);
    }
    return rendered;
}

func RewriteSemanticStructCall(
    graph: SemanticExpressionGraphFacts,
    view: SemanticCallSpineView,
    type_name: String,
    env: CodegenTypeEnv
) -> String {
    let fields: String = LookupKindType(env, type_name, "fields");
    if !LookupKindTypeRowPresent(env, type_name, "fields") {
        Die(Concat("struct call field inventory is missing: ", type_name));
    }
    if ArrayLength(view.argument_nodes) == 0 {
        if fields != "" {
            Die(Concat("struct call argument fact is missing: ", type_name));
        }
        return Concat("(", Concat(AbiLayoutCStructTypeName(type_name), Concat("){ ", Concat(AbiLayoutCFieldlessNominalInitializer(), " }"))));
    }
    let out: String = Concat(
        "(", Concat(AbiLayoutCStructTypeName(type_name), "){ ")
    );
    let i: Int = 0;
    while i < ArrayLength(view.argument_nodes) {
        let field_name: String = CsvAt(fields, i);
        let field_type: String = LookupFieldType(env, type_name, field_name);
        if field_name == "" || field_type == "" {
            Die(Concat("struct call field fact is missing: ", type_name));
        }
        let value: String = RewriteSemanticCallArgument(
            graph, view.argument_nodes[i], field_type, "default", env
        );
        if i > 0 { out = Concat(out, ", "); }
        out = Concat(out, Concat(
            ".", Concat(CompilerSymbolCFieldName(field_name), Concat(
                " = (", Concat(value, ")")
            ))
        ));
        i = i + 1;
    }
    if CsvAt(fields, ArrayLength(view.argument_nodes)) != "" {
        Die(Concat("struct call argument fact is missing: ", type_name));
    }
    return Concat(out, " }");
}

func RewriteSemanticCallArguments(
    graph: SemanticExpressionGraphFacts,
    view: SemanticCallSpineView,
    modes: String,
    param_types: String,
    param_offset: Int,
    prefix_argument: String,
    env: CodegenTypeEnv
) -> String {
    let args: String = prefix_argument;
    let i: Int = 0;
    while i < ArrayLength(view.argument_nodes) {
        let param_index: Int = i + param_offset;
        let mode: String = "default";
        if param_index < ParamModeCsvCount(modes) {
            mode = ParamModeCsvAt(modes, param_index);
        }
        let expected_type: String = CsvAt(param_types, param_index);
        let argument: String = RewriteSemanticCallArgument(
            graph, view.argument_nodes[i], expected_type, mode, env
        );
        if args == "" { args = argument; }
        else { args = Concat(args, Concat(", ", argument)); }
        i = i + 1;
    }
    return args;
}

func RewriteSemanticMemberAccess(
    graph: SemanticExpressionGraphFacts,
    node_id: Int,
    env: CodegenTypeEnv
) -> String {
    let view: SemanticMemberAccessView =
        SemanticMemberAccessViewFromGraph(graph, node_id);
    if !view.ok {
        Die("semantic member-access graph is missing or malformed");
    }
    let receiver_kind: Option<Int> = SemanticExpressionGraphNodeKind(
        graph, view.receiver_node
    );
    let receiver_text: Option<String> = SemanticExpressionGraphNodeText(
        graph, view.receiver_node
    );
    let member_text: Option<String> = SemanticExpressionGraphNodeText(
        graph, view.member_node
    );
    if !IsSome(receiver_kind) {
        Die(Concat("semantic member-access receiver kind fact is missing: node=", ToString(node_id)));
    }
    if !IsSome(member_text) {
        Die(Concat("semantic member-access member text fact is missing: node=", ToString(node_id)));
    }
    if !IsIdentifier(UnwrapOption(member_text)) {
        let receiver_debug: String = "<missing>";
        if IsSome(receiver_text) {
            receiver_debug = UnwrapOption(receiver_text);
        }
        Die(Concat(
            "semantic member-access member name is invalid: node=",
            Concat(ToString(node_id), Concat(
                " receiver=", Concat(receiver_debug, Concat(
                    " member=", UnwrapOption(member_text)
                ))
            ))
        ));
    }
    let member_name: String = UnwrapOption(member_text);
    if UnwrapOption(receiver_kind) == AstExpressionNodeLeaf() &&
        IsSome(receiver_text) && IsIdentifier(UnwrapOption(receiver_text)) {
        let enum_value: String = LookupKindType(
            env, Concat(
                UnwrapOption(receiver_text), Concat(".", member_name)
            ), "e"
        );
        if enum_value != "" { return enum_value; }
        let tagged_key: String = Concat(
            UnwrapOption(receiver_text), Concat(".", member_name)
        );
        let tagged_value: String = LookupKindType(
            env, tagged_key, "eval"
        );
        if tagged_value != "" { return tagged_value; }
        let tagged_tag: String = LookupKindType(
            env, tagged_key, "etag"
        );
        if tagged_tag != "" { return tagged_tag; }
    }
    let receiver_type: Option<String> = CodegenExpressionTypeFromGraph(
        graph, view.receiver_node, env
    );
    if !IsSome(receiver_type) {
        let missing_receiver: String = "<unknown>";
        if IsSome(receiver_text) {
            missing_receiver = UnwrapOption(receiver_text);
        }
        Die(Concat(
            "semantic member-access receiver type fact is missing: node=",
            Concat(ToString(node_id), Concat(
                " receiver=", Concat(missing_receiver, Concat(
                    " member=", member_name
                ))
            ))
        ));
    }
    let receiver_type_name: String = UnwrapOption(receiver_type);
    let tagged_variant_owner: String = LookupKindType(
        env, Concat(receiver_type_name, Concat(".", member_name)), "etype"
    );
    if tagged_variant_owner == receiver_type_name &&
        LookupKindType(env, receiver_type_name, "enum") == "tagged" {
        let receiver: String = RewriteExprFromSemanticGraph(
            graph, view.receiver_node, env
        );
        return Concat("(", Concat(receiver, Concat(").", CompilerSymbolCFieldName(member_name))));
    }
    if LookupFieldType(env, receiver_type_name, member_name) == "" {
        Die(Concat(
            "semantic member-access field fact is missing: receiver_type=",
            Concat(receiver_type_name, Concat(
                " member=", Concat(member_name, Concat(
                    " node=", ToString(node_id)
                ))
            ))
        ));
    }
    let receiver: String = RewriteExprFromSemanticGraph(
        graph, view.receiver_node, env
    );
    return Concat(receiver, Concat(
        ".", CompilerSymbolCFieldName(member_name)
    ));
}

func RewriteSemanticMemberCall(
    graph: SemanticExpressionGraphFacts,
    view: SemanticCallSpineView,
    env: CodegenTypeEnv
) -> String {
    let member: SemanticMemberAccessView =
        SemanticMemberAccessViewFromGraph(graph, view.callee_node);
    if !member.ok {
        Die("semantic member-call callee is missing or malformed");
    }
    let target_kind: Option<Int> = SemanticExpressionGraphCallTargetKind(
        graph, view.call_node
    );
    let target_name: Option<String> = SemanticExpressionGraphCallTargetName(
        graph, view.call_node
    );
    if !IsSome(target_kind) || !IsSome(target_name) {
        Die("semantic member-call target fact is missing");
    }
    let call_symbol: String = "";
    let param_offset: Int = 0;
    let prefix_argument: String = "";
    if UnwrapOption(target_kind) == SemanticCallTargetNamespace() {
        if UnwrapOption(target_name) == "" {
            Die("semantic qualified-call target fact is missing");
        }
        call_symbol = CompilerSymbolCIdentifier(UnwrapOption(target_name));
        if LookupKindType(env, call_symbol, "f") == "" {
            Die("semantic qualified-call function fact is missing");
        }
    } else if UnwrapOption(target_kind) == SemanticCallTargetMember() {
        if UnwrapOption(target_name) == "" {
            Die("semantic member-call target fact is missing");
        }
        call_symbol = CompilerSymbolCIdentifier(UnwrapOption(target_name));
        let carried_specialization: String = LookupKindType(
            env, CodegenGenericCallNodeKey(view.call_node), "call"
        );
        if carried_specialization != "" {
            call_symbol = carried_specialization;
        } else if ArrayLength(view.generic_actual_type_names) > 0 {
            Die("semantic generic member specialization call fact is missing");
        }
        if LookupKindType(env, call_symbol, "f") == "" {
            Die("semantic member-call method fact is missing");
        }
        param_offset = 1;
        prefix_argument = RewriteExprFromSemanticGraph(
            graph, member.receiver_node, env
        );
    } else {
        Die("semantic member-call target fact is missing");
    }
    let modes: String = LookupKindType(env, call_symbol, "pm");
    let param_types: String = LookupKindType(env, call_symbol, "pt");
    let args: String = RewriteSemanticCallArguments(
        graph, view, modes, param_types, param_offset,
        prefix_argument, env
    );
    return Concat(call_symbol, Concat("(", Concat(args, ")")));
}

func RewriteSemanticMachineCall(
    graph: SemanticExpressionGraphFacts,
    view: SemanticCallSpineView,
    env: CodegenTypeEnv
) -> String {
    let target_name: Option<String> = SemanticExpressionGraphCallTargetName(
        graph, view.call_node
    );
    if !IsSome(target_name) {
        Die("semantic machine-call target fact is missing");
    }
    let source_name: String = UnwrapOption(target_name);
    let argc: Int = ArrayLength(view.argument_nodes);
    if source_name == "ClaimDeviceSlot" {
        Die("ClaimDeviceSlot requires an expected DeviceSlot<T> type fact");
    }
    if argc < 1 {
        Die(Concat(source_name, " requires a DeviceSlot<T> argument"));
    }
    let slot_type_opt: Option<String> = CodegenExpressionTypeFromGraph(
        graph, view.argument_nodes[0], env
    );
    if !IsSome(slot_type_opt) {
        Die(Concat(source_name, " argument type fact is missing"));
    }
    let slot_type: String = UnwrapOption(slot_type_opt);
    let runtime_name: Option<String> =
        CompilerRuntimeCallAbiMachineLayerDeviceRuntimeCName(
            source_name, slot_type
        );
    if !IsSome(runtime_name) {
        Die(Concat(source_name, " has no DeviceSlot<T> runtime ABI row"));
    }
    if source_name == "DeviceRead" || source_name == "ReleaseDeviceSlot" ||
        source_name == "SubmitDeviceRead" {
        if (source_name == "DeviceRead" || source_name == "ReleaseDeviceSlot") && argc != 1 {
            Die(Concat(source_name, " requires exactly one argument"));
        }
        if source_name == "SubmitDeviceRead" && argc != 1 {
            Die("SubmitDeviceRead requires exactly one argument");
        }
        let slot_arg: String = RewriteSemanticCallArgument(
            graph, view.argument_nodes[0], slot_type, "ref", env
        );
        return Concat(UnwrapOption(runtime_name), Concat("(", Concat(slot_arg, ")")));
    }
    if source_name == "DeviceWrite" {
        if argc != 2 {
            Die("DeviceWrite requires exactly two arguments");
        }
        let scalar_type: String =
            CompilerRuntimeCallAbiMachineLayerDeviceScalarType(slot_type);
        if scalar_type == "" {
            Die("DeviceWrite requires a valid DeviceSlot<T> argument");
        }
        let slot_arg: String = RewriteSemanticCallArgument(
            graph, view.argument_nodes[0], slot_type, "ref", env
        );
        let value_arg: String = RewriteSemanticCallArgument(
            graph, view.argument_nodes[1], scalar_type, "default", env
        );
        return Concat(UnwrapOption(runtime_name), Concat("(", Concat(
            slot_arg, Concat(", ", Concat(value_arg, ")")
        ))));
    }
    Die(Concat(source_name, " is not a supported machine-layer call"));
    return "";
}

func RewriteSemanticSlotCall(
    graph: SemanticExpressionGraphFacts,
    view: SemanticCallSpineView,
    source_name: String,
    env: CodegenTypeEnv
) -> String {
    if source_name == "ClaimSlot" {
        Die("ClaimSlot requires an expected Slot<T> type fact");
    }
    let argc: Int = ArrayLength(view.argument_nodes);
    if argc < 1 { Die(Concat(source_name, " requires a Slot<T> argument")); }
    let slot_type_fact: Option<String> = CodegenExpressionTypeFromGraph(
        graph, view.argument_nodes[0], env
    );
    if !IsSome(slot_type_fact) || !IsSlotType(UnwrapOption(slot_type_fact)) {
        Die(Concat(source_name, " requires a typed Slot<T> argument"));
    }
    let slot_type: String = UnwrapOption(slot_type_fact);
    let fact: CompilerRuntimeCallAbiFact =
        CompilerRuntimeCallAbiFactForConstructedResource(slot_type, source_name);
    if !fact.ok { Die(Concat(source_name, " runtime-call ABI fact is missing")); }
    let slot_arg: String = RewriteSemanticCallArgument(
        graph, view.argument_nodes[0], slot_type, "ref", env
    );
    if source_name == "Read" || source_name == "Release" {
        if argc != 1 { Die(Concat(source_name, " requires exactly one argument")); }
        return Concat(fact.symbol, Concat("(", Concat(slot_arg, ")")));
    }
    if source_name == "Write" {
        if argc != 2 { Die("Write requires exactly two arguments"); }
        let payload: Option<String> = SlotPayloadTypeOpt(slot_type);
        if !IsSome(payload) { Die("Write Slot<T> payload type is missing"); }
        let value_arg: String = RewriteSemanticCallArgument(
            graph, view.argument_nodes[1], UnwrapOption(payload), "default", env
        );
        return Concat(fact.symbol, Concat("(", Concat(
            slot_arg, Concat(", ", Concat(value_arg, ")"))
        )));
    }
    Die(Concat(source_name, " is not a supported Slot<T> call"));
    return "";
}

func RewriteSemanticDirectCall(
    graph: SemanticExpressionGraphFacts,
    root_id: Int,
    env: CodegenTypeEnv
) -> String {
    let view: SemanticCallSpineView = SemanticCallSpineViewFromGraph(
        graph, root_id
    );
    if !view.ok {
        Die("semantic direct-call spine is missing or malformed");
    }
    let target_kind: Option<Int> = SemanticExpressionGraphCallTargetKind(
        graph, view.call_node
    );
    let target_name: Option<String> = SemanticExpressionGraphCallTargetName(
        graph, view.call_node
    );
    if !IsSome(target_kind) || !IsSome(target_name) ||
        UnwrapOption(target_kind) != SemanticCallTargetDirect() ||
        UnwrapOption(target_name) == "" {
        Die("semantic direct-call target fact is missing");
    }
    let source_name: String = UnwrapOption(target_name);
    if source_name == "ClaimSlot" || source_name == "Read" ||
        source_name == "Write" || source_name == "Release" {
        return RewriteSemanticSlotCall(graph, view, source_name, env);
    }
    if CompilerRuntimeCallAbiMachineLayerContactNameForSource(source_name) != "" {
        return RewriteSemanticMachineCall(graph, view, env);
    }
    if LookupKindType(env, source_name, "s") == "struct" {
        return RewriteSemanticStructCall(graph, view, source_name, env);
    }
    let call_symbol: String = source_name;
    let alias: String = LookupKindType(env, source_name, "call");
    if alias != "" { call_symbol = alias; }
    let tagged_constructor: String = LookupKindType(
        env, source_name, "call"
    );
    if tagged_constructor != "" &&
        LookupKindType(env, call_symbol, "f") != "" {
        call_symbol = tagged_constructor;
    }
    let carried_specialization: String = LookupKindType(
        env, CodegenGenericCallNodeKey(view.call_node), "call"
    );
    if carried_specialization != "" {
        call_symbol = carried_specialization;
    } else if ArrayLength(view.generic_actual_type_names) > 0 {
        Die("semantic generic specialization call fact is missing");
    }
    let modes: String = LookupKindType(env, call_symbol, "pm");
    let param_types: String = LookupKindType(env, call_symbol, "pt");
    if source_name == "Some" {
        if ArrayLength(view.argument_nodes) != 1 {
            Die("Some call requires exactly one argument graph");
        }
        let payload_type: Option<String> = CodegenExpressionTypeFromGraph(
            graph, view.argument_nodes[0], env
        );
        if !IsSome(payload_type) {
            Die("Some call payload type fact is missing");
        }
        call_symbol = OptionResultRuntimeCOptionSomeFnForPayloadKind(
            OptionResultRuntimeOptionPayloadKindFromExprKind(
                UnwrapOption(payload_type)
            )
        );
    } else if source_name == "IsOk" || source_name == "IsErr" ||
        source_name == "Unwrap" || source_name == "UnwrapErr" {
        if ArrayLength(view.argument_nodes) != 1 {
            Die("Result projection call requires one argument graph");
        }
        let result_type: Option<String> = CodegenExpressionTypeFromGraph(
            graph, view.argument_nodes[0], env
        );
        if (!IsSome(result_type)) {
            Die("Result projection argument type fact is missing");
        }
        let result_fact: ResultRuntimeFact = ResultRuntimeFactForType(
            UnwrapOption(result_type)
        );
        if result_fact.ok {
            if source_name == "IsOk" {
                call_symbol = result_fact.is_ok_fn;
            } else if source_name == "IsErr" {
                call_symbol = result_fact.is_err_fn;
            } else if source_name == "Unwrap" {
                call_symbol = result_fact.unwrap_fn;
            } else {
                call_symbol = result_fact.unwrap_err_fn;
            }
        } else if source_name == "UnwrapErr" {
            Die("UnwrapErr requires an explicit Result<T, E> type fact");
        } else {
            let result_symbol: Option<String> = RuntimeCallCName(source_name);
            if !IsSome(result_symbol) {
                Die("Result projection runtime ABI row is missing");
            }
            call_symbol = UnwrapOption(result_symbol);
        }
    } else if source_name == "ToString" {
        if ArrayLength(view.argument_nodes) != 1 {
            Die("ToString call requires exactly one argument graph");
        }
        let argument_node: Int = view.argument_nodes[0];
        let argument_type: Option<String> = CodegenExpressionTypeFromGraph(
            graph, argument_node, env
        );
        if !IsSome(argument_type) {
            Die("ToString argument type fact is missing");
        }
        if UnwrapOption(argument_type) == "String" {
            return RewriteExprFromSemanticGraph(graph, argument_node, env);
        }
        if UnwrapOption(argument_type) == "Bool" {
            call_symbol = StringRuntimeCBoolToStringFn();
        } else {
            let tostring_symbol: Option<String> = RuntimeCallCName(source_name);
            if !IsSome(tostring_symbol) {
                Die("ToString runtime ABI row is missing");
            }
            call_symbol = UnwrapOption(tostring_symbol);
        }
    } else if source_name == "ArrayLength" {
        if ArrayLength(view.argument_nodes) != 1 {
            Die("ArrayLength call requires exactly one argument graph");
        }
        let array_type: Option<String> = CodegenExpressionTypeFromGraph(
            graph, view.argument_nodes[0], env
        );
        if !IsSome(array_type) {
            Die("ArrayLength argument type fact is missing");
        }
        let array_kind: String = UnwrapOption(array_type);
        if StartsWith(array_kind, "Array<") {
            array_kind =
                CollectionRuntimeFactFromTypeName(array_kind, env).kind;
        }
        call_symbol =
            CollectionRuntimeFactFromKind(array_kind, env).c_len_fn;
    } else {
        let runtime_symbol: Option<String> = RuntimeCallCName(source_name);
        if IsSome(runtime_symbol) {
            call_symbol = UnwrapOption(runtime_symbol);
        }
    }
    let args: String = RewriteSemanticCallArguments(
        graph, view, modes, param_types, 0, "", env
    );
    return Concat(call_symbol, Concat("(", Concat(args, ")")));
}

func RewriteSemanticCall(
    graph: SemanticExpressionGraphFacts,
    root_id: Int,
    env: CodegenTypeEnv
) -> String {
    let view: SemanticCallSpineView = SemanticCallSpineViewFromGraph(
        graph, root_id
    );
    if !view.ok {
        Die("semantic call spine is missing or malformed");
    }
    let callee_kind: Option<Int> = SemanticExpressionGraphNodeKind(
        graph, view.callee_node
    );
    if !IsSome(callee_kind) {
        Die("semantic call callee kind is missing");
    }
    if UnwrapOption(callee_kind) == AstExpressionNodeMemberAccess() {
        return RewriteSemanticMemberCall(graph, view, env);
    }
    if UnwrapOption(callee_kind) != AstExpressionNodeLeaf() {
        Die("semantic call callee kind is unsupported");
    }
    return RewriteSemanticDirectCall(graph, root_id, env);
}
