// Codegen call-spine type projection from semantic graph facts.

import "../text/text_owner.pgy";
import "../input/generic_specialization_codegen_view_owner.pgy";
import "../type_facts/type_env.pgy";
import "list_call_type_owner.pgy";
import "queue_call_type_owner.pgy";
import "set_call_type_owner.pgy";
import "../../semantic/ast_expression_call_target_fact_owner.pgy";
import "../../semantic/ast_expression_graph_call_view_owner.pgy";
import "../../semantic/builtin_signature_owner.pgy";
import "../../semantic/ast_domain_query_protocol_owner.pgy";
import "../../semantic/wrapper_type_owner.pgy";
import "../../semantic/ast_expression_graph_node_view_owner.pgy";

func CodegenExpressionCallTypeFromGraph(
    graph: SemanticExpressionGraphFacts,
    node_id: Int,
    env: CodegenTypeEnv
) -> Option<String> {
    let call: SemanticCallSpineView = SemanticCallSpineViewFromGraph(
        graph, node_id
    );
    if !call.ok { return None; }
    let list_return: Option<String> =
        CodegenListCallReturnTypeFromGraph(graph, node_id, env);
    if IsSome(list_return) { return list_return; }
    if CodegenListCallApplies(graph, node_id) { return None; }
    let queue_return: Option<String> =
        CodegenQueueCallReturnTypeFromGraph(graph, node_id, env);
    if IsSome(queue_return) { return queue_return; }
    if CodegenQueueCallApplies(graph, node_id) { return None; }
    let set_return: Option<String> =
        CodegenSetCallReturnTypeFromGraph(graph, node_id, env);
    if IsSome(set_return) { return set_return; }
    if CodegenSetCallApplies(graph, node_id) { return None; }
    let target_name: Option<String> = SemanticExpressionGraphCallTargetName(
        graph, call.call_node
    );
    if !IsSome(target_name) { return None; }
    let source_name: String = UnwrapOption(target_name);
    let domain_query: SemanticAstDomainQueryProtocol =
        SemanticAstDomainQueryProtocolFromName(source_name);
    if domain_query.applies {
        if ArrayLength(call.argument_nodes) != domain_query.expected_arity {
            return None;
        }
        return Some("Bool");
    }
    if (source_name == "UnwrapOption" || source_name == "Unwrap") &&
        ArrayLength(call.argument_nodes) == 1 {
        let wrapped: Option<String> = CodegenExpressionTypeFromGraph(
            graph, call.argument_nodes[0], env
        );
        if !IsSome(wrapped) { return None; }
        return TryPayloadTypeOpt(UnwrapOption(wrapped));
    }
    if source_name == "UnwrapErr" &&
        ArrayLength(call.argument_nodes) == 1 {
        let wrapped_error: Option<String> = CodegenExpressionTypeFromGraph(
            graph, call.argument_nodes[0], env
        );
        if !IsSome(wrapped_error) { return None; }
        return ResultErrorTypeOpt(UnwrapOption(wrapped_error));
    }
    if SemanticBuiltinReturnDependsOnArguments(source_name) {
        let argument_types: Array<String> = [];
        let argument_index: Int = 0;
        while argument_index < ArrayLength(call.argument_nodes) {
            let argument_type: Option<String> = CodegenExpressionTypeFromGraph(
                graph, call.argument_nodes[argument_index], env
            );
            if !IsSome(argument_type) { return None; }
            ArrayPush(argument_types, UnwrapOption(argument_type));
            argument_index = argument_index + 1;
        }
        return SemanticPolymorphicBuiltinReturnTypeOpt(
            source_name, argument_types
        );
    }
    return SemanticExpressionGraphCallReturnTypeName(
        graph, call.call_node
    );
}
