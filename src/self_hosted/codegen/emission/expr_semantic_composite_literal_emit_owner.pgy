// Composite literal emission from semantic-owned expression graph nodes.

import "../input/semantic_expression_codegen_view_owner.pgy";
import "../text/text_owner.pgy";
import "../type_facts/type_env.pgy";
import "../abi_layout/abi_layout_owner.pgy";
import "../runtime_abi/collection_runtime_owner.pgy";
import "../runtime_abi/list_runtime_owner.pgy";
import "../runtime_abi/queue_runtime_owner.pgy";
import "../runtime_abi/set_runtime_owner.pgy";
import "../runtime_abi/result_runtime_owner.pgy";
import "../../compiler/symbol_table_owner.pgy";
import "../../semantic/ast_expression_graph_struct_view_owner.pgy";
import "../../semantic/ast_expression_graph_call_view_owner.pgy";
import "../../semantic/ast_expression_graph_array_literal_owner.pgy";
import "../../compiler/machine_layer_runtime_projection_owner.pgy";
import "../../compiler/runtime_call_abi_structured_fact_owner.pgy";
import "expr_rewrite.pgy";
import "expr_semantic_option_value_owner.pgy";

func RewriteSemanticExpectedValue(
    graph: SemanticExpressionGraphFacts,
    node_id: Int,
    expected_type: String,
    env: CodegenTypeEnv
) -> String {
    let kind: Option<Int> = SemanticExpressionGraphNodeKind(graph, node_id);
    if !IsSome(kind) { Die("semantic expected-value kind is missing"); }
    if StartsWith(expected_type, "Option<") {
        let option_value: CodegenOptionExpectedValueFact =
            CodegenOptionExpectedValueFactFromGraph(
            graph, node_id, expected_type, env
        );
        if option_value.is_none {
            return Concat(option_value.none_fn, "()");
        }
        if option_value.is_some {
            return Concat(option_value.some_fn, Concat("(", Concat(
                RewriteSemanticExpectedValue(
                    graph, option_value.payload_node,
                    option_value.inner_type, env
                ), ")"
            )));
        }
        return RewriteExprFromSemanticGraph(graph, node_id, env);
    }
    if IsResultType(expected_type) &&
        AstExpressionNodeIsCallSpine(UnwrapOption(kind)) {
        let result_fact: ResultRuntimeFact =
            ResultRuntimeFactForType(expected_type);
        let call: SemanticCallSpineView = SemanticCallSpineViewFromGraph(
            graph, node_id
        );
        let target: Option<String> = None;
        if call.ok {
            target = SemanticExpressionGraphCallTargetName(
                graph, call.call_node
            );
        }
        if result_fact.ok && IsSome(target) &&
            (UnwrapOption(target) == "Ok" ||
             UnwrapOption(target) == "Err") {
            if ArrayLength(call.argument_nodes) != 1 {
                Die("Result constructor requires one argument graph");
            }
            let argument_type: String = result_fact.payload_type;
            let call_symbol: String = result_fact.ok_fn;
            if UnwrapOption(target) == "Err" {
                argument_type = result_fact.error_type;
                call_symbol = result_fact.err_fn;
            }
            return Concat(call_symbol, Concat("(", Concat(
                RewriteSemanticExpectedValue(
                    graph, call.argument_nodes[0], argument_type, env
                ), ")"
            )));
        }
    }
    if IsSlotType(expected_type) && AstExpressionNodeIsCallSpine(UnwrapOption(kind)) {
        let call: SemanticCallSpineView = SemanticCallSpineViewFromGraph(graph, node_id);
        let target: Option<String> = SemanticExpressionGraphCallTargetName(graph, call.call_node);
        if !call.ok || !IsSome(target) || UnwrapOption(target) != "ClaimSlot" ||
            ArrayLength(call.argument_nodes) != 0 {
            Die("Slot<T> initializer must be ClaimSlot with no arguments");
        }
        let fact: CompilerRuntimeCallAbiFact =
            CompilerRuntimeCallAbiFactForConstructedResource(expected_type, "Claim");
        if !fact.ok { Die("ClaimSlot runtime-call ABI fact is missing"); }
        return Concat(fact.symbol, "()");
    }
    if CompilerRuntimeCallAbiMachineLayerDeviceCValueType(expected_type) != "" &&
        AstExpressionNodeIsCallSpine(UnwrapOption(kind)) {
        let call: SemanticCallSpineView = SemanticCallSpineViewFromGraph(
            graph, node_id
        );
        if !call.ok {
            Die("semantic machine expected-value call graph is malformed");
        }
        let target_name: Option<String> = SemanticExpressionGraphCallTargetName(
            graph, call.call_node
        );
        if !IsSome(target_name) || UnwrapOption(target_name) != "ClaimDeviceSlot" {
            Die("DeviceSlot<T> initializer must be ClaimDeviceSlot");
        }
        if ArrayLength(call.argument_nodes) != 0 {
            Die("ClaimDeviceSlot takes no arguments");
        }
        let runtime_name: Option<String> =
            CompilerRuntimeCallAbiMachineLayerDeviceRuntimeCName(
                "ClaimDeviceSlot", expected_type
            );
        if !IsSome(runtime_name) {
            Die("ClaimDeviceSlot DeviceSlot<T> runtime ABI row is missing");
        }
        return Concat(UnwrapOption(runtime_name), "()");
    }
    if StartsWith(expected_type, "List<") &&
        AstExpressionNodeIsCallSpine(UnwrapOption(kind)) {
        let call: SemanticCallSpineView = SemanticCallSpineViewFromGraph(
            graph, node_id
        );
        let target: Option<String> = None;
        if call.ok {
            target = SemanticExpressionGraphCallTargetName(
                graph, call.call_node
            );
        }
        if !call.ok || !IsSome(target) ||
            UnwrapOption(target) != "ListNew" ||
            ArrayLength(call.argument_nodes) != 0 {
            Die("List<T> initializer must be ListNew with no arguments");
        }
        let collection: CollectionListRuntimeFact =
            CollectionListRuntimeFactFromTypeName(expected_type);
        if !collection.ok { Die("List<T> runtime ABI fact is missing"); }
        return Concat(collection.c_new_fn, "()");
    }
    if StartsWith(expected_type, "Queue<") &&
        AstExpressionNodeIsCallSpine(UnwrapOption(kind)) {
        let call: SemanticCallSpineView = SemanticCallSpineViewFromGraph(
            graph, node_id
        );
        let target: Option<String> = None;
        if call.ok {
            target = SemanticExpressionGraphCallTargetName(
                graph, call.call_node
            );
        }
        if !call.ok || !IsSome(target) ||
            UnwrapOption(target) != "QueueNew" ||
            ArrayLength(call.argument_nodes) != 0 {
            Die("Queue<T> initializer must be QueueNew with no arguments");
        }
        let collection: CollectionQueueRuntimeFact =
            CollectionQueueRuntimeFactFromTypeName(expected_type);
        if !collection.ok { Die("Queue<T> runtime ABI fact is missing"); }
        return Concat(collection.c_new_fn, "()");
    }
    if StartsWith(expected_type, "Set<") &&
        AstExpressionNodeIsCallSpine(UnwrapOption(kind)) {
        let call: SemanticCallSpineView = SemanticCallSpineViewFromGraph(
            graph, node_id
        );
        let target: Option<String> = None;
        if call.ok {
            target = SemanticExpressionGraphCallTargetName(
                graph, call.call_node
            );
        }
        if !call.ok || !IsSome(target) ||
            UnwrapOption(target) != "SetNew" ||
            ArrayLength(call.argument_nodes) != 0 {
            Die("Set<T> initializer must be SetNew with no arguments");
        }
        let collection: CollectionSetRuntimeFact =
            CollectionSetRuntimeFactFromTypeName(expected_type);
        if !collection.ok { Die("Set<T> runtime ABI fact is missing"); }
        return Concat(collection.c_new_fn, "()");
    }
    if AstExpressionNodeIsArrayLiteralSpine(UnwrapOption(kind)) {
        return RewriteSemanticArrayLiteralValue(
            graph, node_id, expected_type, env
        );
    }
    if AstExpressionNodeIsStructLiteralSpine(UnwrapOption(kind)) {
        return RewriteSemanticStructLiteralValue(
            graph, node_id, expected_type, env
        );
    }
    return RewriteExprFromSemanticGraph(graph, node_id, env);
}

func RewriteSemanticArrayLiteralValue(
    graph: SemanticExpressionGraphFacts,
    root_id: Int,
    expected_type: String,
    env: CodegenTypeEnv
) -> String {
    let view: SemanticArrayLiteralView =
        SemanticArrayLiteralViewFromGraph(graph, root_id);
    if !view.ok {
        Die("semantic array-literal graph/type fact is invalid");
    }
    if StartsWith(expected_type, "List<") {
        let list_collection: CollectionListRuntimeFact =
            CollectionListRuntimeFactFromTypeName(expected_type);
        if !list_collection.ok {
            Die("semantic List-literal runtime fact is invalid");
        }
        let c_type: String = AbiLayoutCValueType(expected_type, env);
        let temp: String = "_pgy_list_value";
        let out: String = Concat("({ ", Concat(c_type, Concat(" ",
            Concat(temp, Concat(" = ", Concat(
                list_collection.c_new_fn, "(); "))))));
        let i: Int = 0;
        while i < ArrayLength(view.element_nodes) {
            let value: String = RewriteSemanticExpectedValue(
                graph, view.element_nodes[i], list_collection.element_type, env
            );
            out = Concat(out, Concat(list_collection.c_push_fn,
                Concat("(&", Concat(temp, Concat(", ",
                    Concat(value, "); "))))));
            i = i + 1;
        }
        return Concat(out, Concat(temp, "; })"));
    }
    if StartsWith(expected_type, "Queue<") {
        let queue_collection: CollectionQueueRuntimeFact =
            CollectionQueueRuntimeFactFromTypeName(expected_type);
        if !queue_collection.ok {
            Die("semantic Queue-literal runtime fact is invalid");
        }
        let c_type: String = AbiLayoutCValueType(expected_type, env);
        let temp: String = "_pgy_queue_value";
        let out: String = Concat("({ ", Concat(c_type, Concat(" ",
            Concat(temp, Concat(" = ", Concat(
                queue_collection.c_new_fn, "(); "))))));
        let i: Int = 0;
        while i < ArrayLength(view.element_nodes) {
            let value: String = RewriteSemanticExpectedValue(
                graph, view.element_nodes[i], queue_collection.element_type, env
            );
            out = Concat(out, Concat(queue_collection.c_push_fn,
                Concat("(&", Concat(temp, Concat(", ",
                    Concat(value, "); "))))));
            i = i + 1;
        }
        return Concat(out, Concat(temp, "; })"));
    }
    if !StartsWith(expected_type, "Array<") {
        Die("semantic array-literal graph/type fact is invalid");
    }
    let collection: CollectionRuntimeFact =
        CollectionRuntimeFactFromTypeName(expected_type, env);
    let element_type: String = collection.element_type;
    let c_type: String = AbiLayoutCValueType(expected_type, env);
    let temp: String = "_pgy_array_value";
    let out: String = Concat("({ ", Concat(c_type, Concat(" ",
        Concat(temp, Concat(" = ", Concat(
            collection.c_new_fn, "(); "))))));
    let i: Int = 0;
    while i < ArrayLength(view.element_nodes) {
        let value: String = RewriteSemanticExpectedValue(
            graph, view.element_nodes[i], element_type, env
        );
        out = Concat(out, Concat(collection.c_push_fn,
            Concat("(&", Concat(temp, Concat(", ",
                Concat(value, "); "))))));
        i = i + 1;
    }
    return Concat(out, Concat(temp, "; })"));
}

func RewriteSemanticStructLiteralValue(
    graph: SemanticExpressionGraphFacts,
    root_id: Int,
    expected_type: String,
    env: CodegenTypeEnv
) -> String {
    let view: SemanticStructLiteralView =
        SemanticStructLiteralViewFromGraph(graph, root_id);
    if !view.ok {
        Die("semantic struct-literal graph/type fact is invalid");
    }
    let type_name: Option<String> = SemanticExpressionGraphNodeText(
        graph, view.type_node
    );
    if !IsSome(type_name) ||
        UnwrapOption(type_name) != expected_type ||
        LookupKindType(env, expected_type, "s") != "struct" {
        Die("semantic struct-literal graph/type fact is invalid");
    }
    let c_type: String = AbiLayoutCStructTypeName(expected_type);
    let out: String = Concat("(", Concat(c_type, "){ "));
    let i: Int = 0;
    while i < ArrayLength(view.field_names) {
        let field_name: String = view.field_names[i];
        let field_type: String = LookupFieldType(
            env, expected_type, field_name
        );
        if field_type == "" {
            Die(Concat("struct argument initializer field lacks type fact: ",
                Concat(expected_type, Concat(".", field_name))));
        }
        if i > 0 { out = Concat(out, ", "); }
        let value: String = RewriteSemanticExpectedValue(
            graph, view.value_nodes[i], field_type, env
        );
        out = Concat(out, Concat(".", Concat(
            CompilerSymbolCFieldName(field_name),
            Concat(" = (", Concat(value, ")"))
        )));
        i = i + 1;
    }
    return Concat(out, " }");
}
