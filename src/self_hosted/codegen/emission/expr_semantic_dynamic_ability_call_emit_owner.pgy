// Dynamic party role-slot call emission from semantic graph and ABI facts.

import "../input/semantic_expression_codegen_view_owner.pgy";
import "../text/text_owner.pgy";
import "../../semantic/ast_expression_graph_call_view_owner.pgy";
import "../../semantic/ast_expression_graph_member_view_owner.pgy";
import "../../compiler/symbol_table_owner.pgy";
import "expr_semantic_type_owner.pgy";
import "expression_c_text_materialization_owner.pgy";
import "call_argument_order_owner.pgy";
import "../../semantic/ast_expression_graph_node_view_owner.pgy";

func RewriteSemanticDynamicAbilityCall(
    graph: SemanticExpressionGraphFacts,
    view: SemanticCallSpineView,
    member: SemanticMemberAccessView,
    env: CodegenTypeEnv,
    inout owned_fragments: Array<String>
) -> Option<String> {
    let receiver_type: Option<String> = CodegenExpressionTypeFromGraph(
        graph, member.receiver_node, env
    );
    if !IsSome(receiver_type) { return None; }
    let slot_member: SemanticMemberAccessView =
        SemanticMemberAccessViewFromGraph(graph, member.receiver_node);
    if !slot_member.ok { return None; }
    let party_type: Option<String> = CodegenExpressionTypeFromGraph(
        graph, slot_member.receiver_node, env
    );
    let slot_name: Option<String> = SemanticExpressionGraphNodeText(
        graph, slot_member.member_node
    );
    let method_name: Option<String> = SemanticExpressionGraphNodeText(
        graph, member.member_node
    );
    if !IsSome(party_type) || !IsSome(slot_name) ||
        !IsSome(method_name) || !IsIdentifier(UnwrapOption(slot_name)) ||
        !IsIdentifier(UnwrapOption(method_name)) {
        Die("dynamic ability call is missing its party/slot/method facts");
    }
    let slot_key: String = CodegenCExpressionTextOwned(
        owned_fragments, Concat(
            UnwrapOption(party_type), Concat(".", UnwrapOption(slot_name))
        )
    ).text;
    let dispatch_identity: String = LookupKindType(
        env, slot_key, "role_slot"
    );
    if dispatch_identity == "" { return None; }
    let call_target: Option<String> = SemanticExpressionGraphCallTargetName(
        graph, view.call_node
    );
    if !IsSome(call_target) || UnwrapOption(call_target) == "" {
        Die("dynamic ability call target fact is missing");
    }
    let call_symbol: String = CompilerSymbolCIdentifier(
        UnwrapOption(call_target)
    );
    let modes: String = LookupKindType(env, call_symbol, "pm");
    let param_types: String = LookupKindType(env, call_symbol, "pt");
    if LookupKindType(env, call_symbol, "f") == "" {
        Die("dynamic ability call ABI method fact is missing");
    }
    let party_expr: String = RewriteExprFromSemanticGraphTracked(
        graph, slot_member.receiver_node, env, owned_fragments
    ).text;
    // The call reads the party twice, for the slot and for its vtable. A
    // binding or a field of one is read in place; any other party is bound
    // once, ahead of the arguments.
    let party_place: Option<Int> = SemanticExpressionGraphPlaceKind(
        graph, slot_member.receiver_node);
    if !IsSome(party_place) {
        Die("dynamic ability call party place fact is missing");
    }
    let party_binding: String = "";
    if !SemanticExpressionPlaceKindAddressable(UnwrapOption(party_place)) {
        let party_name: String = Concat("__pgy_party_", ToString(view.call_node));
        // Only avoids collisions in emitted C.
        while StringIndexOf(party_expr, party_name) >= 0 {
            party_name = Concat(party_name, "_");
        }
        party_binding = "__auto_type ${party_name} = (${party_expr}); ";
        party_expr = party_name;
    }
    let c_slot: String = CodegenCExpressionTextOwned(
        owned_fragments, CompilerSymbolCFieldName(UnwrapOption(slot_name))
    ).text;
    let prefix_argument: String = CodegenCExpressionTextOwned(
        owned_fragments, Concat(party_expr, Concat(".", c_slot))
    ).text;
    let param_offset: Int = ParamModeCsvCount(modes) -
        ArrayLength(view.argument_nodes);
    if param_offset < 0 || param_offset > 1 {
        Die("dynamic ability call parameter carriage does not match");
    }
    let vtable_field: String = CodegenCExpressionTextOwned(
        owned_fragments, Concat(
            c_slot, Concat("_", Concat(dispatch_identity, "_vt"))
        )
    ).text;
    let vtable_callee: String = Concat(
        party_expr, Concat(".", Concat(
            vtable_field, Concat("->",
                CompilerSymbolCFieldName(UnwrapOption(method_name)))
        ))
    );
    // The slot read now has no effect, so it takes no receiver binding, and
    // the arguments run left to right (docs/205 §11.1).
    let call: String = RewriteSemanticOrderedCall(
        vtable_callee, graph, view, modes, param_types,
        param_offset, prefix_argument, -1, env, owned_fragments
    );
    if party_binding == "" { return Some(call); }
    return Some("({ ${party_binding}${call}; })");
}
