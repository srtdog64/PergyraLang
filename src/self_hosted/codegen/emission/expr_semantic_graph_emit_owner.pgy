// Recursive expression emission from semantic-owned node handles.

import "../input/semantic_expression_codegen_view_owner.pgy";
import "expr_rewrite.pgy";
import "expr_semantic_call_emit_owner.pgy";

func RewriteExprFromSemanticGraph(
    graph: SemanticExpressionGraphFacts,
    node_id: Int,
    env: CodegenTypeEnv
) -> String {
    let kind_opt: Option<Int> = SemanticExpressionGraphNodeKind(
        graph, node_id
    );
    let text_opt: Option<String> = SemanticExpressionGraphNodeText(
        graph, node_id
    );
    if !IsSome(kind_opt) || !IsSome(text_opt) {
        Die("semantic expression graph node is missing");
    }
    let kind: Int = UnwrapOption(kind_opt);
    let text: String = UnwrapOption(text_opt);
    if kind == AstExpressionNodeLeaf() {
        return RewriteTokens(text, env);
    }
    if AstExpressionNodeIsCallSpine(kind) {
        return RewriteSemanticDirectCall(graph, node_id, env);
    }
    let left_opt: Option<Int> = SemanticExpressionGraphLeftChild(
        graph, node_id
    );
    if !IsSome(left_opt) {
        Die("semantic expression graph left edge is missing");
    }
    let left_id: Int = UnwrapOption(left_opt);
    if AstExpressionNodeIsUnaryOperator(kind) {
        let operand: String = RewriteExprFromSemanticGraph(
            graph, left_id, env
        );
        let operand_kind: Option<Int> = SemanticExpressionGraphNodeKind(
            graph, left_id
        );
        if !IsSome(operand_kind) {
            Die("semantic unary operand kind is missing");
        }
        if AstExpressionNodeArity(UnwrapOption(operand_kind)) == 1 {
            operand = Concat("(", Concat(operand, ")"));
        }
        if kind == AstExpressionNodeLogicalNot() {
            return Concat("!", operand);
        }
        if kind == AstExpressionNodeNegate() {
            return Concat("-", operand);
        }
        Die("unsupported semantic unary expression graph node kind");
    }
    let right_opt: Option<Int> = SemanticExpressionGraphRightChild(
        graph, node_id
    );
    if !IsSome(right_opt) {
        Die("semantic expression graph right edge is missing");
    }
    let right_id: Int = UnwrapOption(right_opt);
    if kind == AstExpressionNodeEquality() ||
        kind == AstExpressionNodeInequality() {
        let left_text: Option<String> = SemanticExpressionGraphNodeText(
            graph, left_id
        );
        let right_text: Option<String> = SemanticExpressionGraphNodeText(
            graph, right_id
        );
        if !IsSome(left_text) || !IsSome(right_text) {
            Die("semantic equality operand is missing");
        }
        let projected: Option<String> = RewriteEqualityProjection(
            UnwrapOption(left_text), UnwrapOption(right_text),
            kind == AstExpressionNodeEquality(), env
        );
        if IsSome(projected) { return UnwrapOption(projected); }
    }
    let left: String = RewriteExprFromSemanticGraph(graph, left_id, env);
    let right: String = RewriteExprFromSemanticGraph(graph, right_id, env);
    if kind == AstExpressionNodeIndex() {
        let left_text: Option<String> = SemanticExpressionGraphNodeText(
            graph, left_id
        );
        if !IsSome(left_text) {
            Die("semantic index receiver is missing");
        }
        let receiver_text: String = UnwrapOption(left_text);
        let receiver_type: String = LookupKindType(env, receiver_text, "v");
        if receiver_type == "" {
            receiver_type = ExprMemberFieldType(receiver_text, env);
        }
        let runtime_kind: String = receiver_type;
        if StartsWith(runtime_kind, "Array<") {
            runtime_kind = CollectionRuntimeKindFromTypeName(runtime_kind);
        }
        let get_fn: String = CollectionRuntimeCGetFn(
            CollectionRuntimeKindCode(runtime_kind)
        );
        return Concat(get_fn, Concat(
            "(", Concat(left, Concat(", ", Concat(right, ")")))
        ));
    }
    if kind == AstExpressionNodeAdd() {
        let left_text: Option<String> = SemanticExpressionGraphNodeText(
            graph, left_id
        );
        let right_text: Option<String> = SemanticExpressionGraphNodeText(
            graph, right_id
        );
        if !IsSome(left_text) || !IsSome(right_text) {
            Die("semantic addition operand is missing");
        }
        let left_kind: String = ExprKind(UnwrapOption(left_text), env);
        let right_kind: String = ExprKind(UnwrapOption(right_text), env);
        if left_kind == right_kind {
            let op_name: String = LookupKindType(
                env, Concat(left_kind, "+"), "op"
            );
            if op_name == "" && left_kind == "String" {
                op_name = StringRuntimeCConcatFn();
            }
            if op_name != "" {
                return Concat(op_name, Concat(
                    "(", Concat(left, Concat(", ", Concat(right, ")")))
                ));
            }
        }
    }
    let operator: String = " || ";
    if kind == AstExpressionNodeLogicalAnd() {
        operator = " && ";
    } else if kind == AstExpressionNodeEquality() {
        operator = " == ";
    } else if kind == AstExpressionNodeInequality() {
        operator = " != ";
    } else if kind == AstExpressionNodeLess() {
        operator = " < ";
    } else if kind == AstExpressionNodeLessEqual() {
        operator = " <= ";
    } else if kind == AstExpressionNodeGreater() {
        operator = " > ";
    } else if kind == AstExpressionNodeGreaterEqual() {
        operator = " >= ";
    } else if kind == AstExpressionNodeAdd() {
        operator = " + ";
    } else if kind == AstExpressionNodeSubtract() {
        operator = " - ";
    } else if kind == AstExpressionNodeMultiply() {
        operator = " * ";
    } else if kind == AstExpressionNodeDivide() {
        operator = " / ";
    } else if kind == AstExpressionNodeModulo() {
        operator = " % ";
    } else if kind == AstExpressionNodeIndex() {
        Die("semantic index expression did not project through its ABI row");
    } else if kind != AstExpressionNodeLogicalOr() {
        Die("unsupported semantic expression graph node kind");
    }
    return Concat("(", Concat(
        left, Concat(operator, Concat(right, ")"))
    ));
}

func WrapExprWithSemanticGraph(
    expression: String,
    env: CodegenTypeEnv,
    view: SemanticExpressionGraphView
) -> String {
    let root_text: Option<String> = SemanticExpressionGraphNodeText(
        view.graph, view.root_id
    );
    if !view.ok || !IsSome(root_text) ||
        UnwrapOption(root_text) != SemanticStripOuterParens(expression) {
        Die("semantic expression graph does not match codegen expression");
    }
    return Concat("(", Concat(
        RewriteExprFromSemanticGraph(view.graph, view.root_id, env), ")"
    ));
}
