// C index projection from the semantic receiver type and canonical runtime ABI.
import "../input/semantic_expression_codegen_view_owner.pgy";
import "../runtime_abi/collection_runtime_owner.pgy";
import "../runtime_abi/slice_runtime_owner.pgy";
import "../text/text_owner.pgy";
import "call_argument_order_owner.pgy";

func RewriteSemanticIndex(
    graph: SemanticExpressionGraphFacts, receiver_id: Int, receiver: String,
    index_id: Int, index: String, env: CodegenTypeEnv
) -> String {
    let receiver_type: Option<String> = CodegenExpressionTypeFromGraph(
        graph, receiver_id, env
    );
    if !IsSome(receiver_type) {
        Die("semantic index receiver type fact is missing");
    }
    let runtime_kind: String = UnwrapOption(receiver_type);
    if StartsWith(runtime_kind, "Slice<") {
        let fact: SliceRuntimeFact = SliceRuntimeFactFromSliceTypeName(
            runtime_kind, env
        );
        if !fact.ok { Die("semantic slice index runtime ABI fact is missing"); }
        let suffix: String = ToString(receiver_id);
        return "({ ${fact.c_slice_type} __pgy_slice_get_${suffix} = ${receiver}; "
            + "long long __pgy_slice_index_${suffix} = (long long)(${index}); "
            + "${fact.c_slice_get_fn}(&__pgy_slice_get_${suffix}, "
            + "__pgy_slice_index_${suffix}); })";
    }
    if StartsWith(runtime_kind, "Array<") {
        runtime_kind = CollectionRuntimeFactFromTypeName(runtime_kind, env).kind;
    }
    let get_fn: String =
        CollectionRuntimeFactFromKind(runtime_kind, env).c_get_fn;
    if get_fn == "" { Die("semantic index runtime ABI fact is missing"); }
    // The receiver evaluates before the index (docs/205 §11.1), but the
    // getter takes both as C arguments, whose order C leaves open. A receiver
    // that is more than a local read is bound first unless the index is a
    // literal.
    if !CodegenOperandIsLeaf(SemanticExpressionGraphNodeKind(graph, receiver_id)) &&
        !CodegenOperandIsLiteral(SemanticExpressionGraphNodeKind(graph, index_id)) {
        let name: String = Concat("__pgy_index_receiver_", ToString(receiver_id));
        // Only avoids collisions in emitted C.
        while StringIndexOf(receiver, name) >= 0 || StringIndexOf(index, name) >= 0 {
            name = Concat(name, "_");
        }
        return "({ __auto_type ${name} = (${receiver}); ${get_fn}(${name}, ${index}); })";
    }
    return Concat(
        get_fn, Concat("(", Concat(receiver, Concat(", ", Concat(index, ")"))))
    );
}
