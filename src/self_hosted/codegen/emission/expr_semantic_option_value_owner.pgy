// Option expected-value projection from semantic graph and runtime ABI facts.

import "../input/semantic_expression_codegen_view_owner.pgy";
import "../type_facts/type_env.pgy";
import "../text/text_owner.pgy";
import "../runtime_abi/option_result_runtime_owner.pgy";
import "../../semantic/ast_expression_graph_call_view_owner.pgy";
import "../../semantic/ast_expression_call_target_fact_owner.pgy";
import "../../semantic/ast_expression_graph_node_view_owner.pgy";

struct CodegenOptionExpectedValueFact {
    let is_none: Bool;
    let is_some: Bool;
    let inner_type: String;
    let some_fn: String;
    let none_fn: String;
    let payload_node: Int;
}

func CodegenOptionExpectedValueFactFromGraph(
    graph: SemanticExpressionGraphFacts,
    node_id: Int,
    option_type: String,
    env: CodegenTypeEnv
) -> CodegenOptionExpectedValueFact {
    let inner_type: String = "";
    let some_fn: String = "";
    let none_fn: String = "";
    let struct_fact: Option<OptionStructRuntimeFact> =
        OptionResultRuntimeStructOptionFact(option_type, env);
    if IsSome(struct_fact) {
        let option_struct: OptionStructRuntimeFact = UnwrapOption(struct_fact);
        inner_type = option_struct.inner_type_name;
        some_fn = option_struct.some_fn;
        none_fn = option_struct.none_fn;
    } else {
        let payload_kind: Int =
            OptionResultRuntimeOptionPayloadKindForType(option_type);
        if payload_kind == 0 {
            Die(Concat("unsupported Option payload type: ", option_type));
        }
        inner_type = OptionResultRuntimeOptionValueTypeForPayloadKind(
            payload_kind
        );
        some_fn = OptionResultRuntimeCOptionSomeFnForPayloadKind(payload_kind);
        none_fn = OptionResultRuntimeCOptionNoneFnForPayloadKind(payload_kind);
    }
    let root_kind: Option<Int> = SemanticExpressionGraphNodeKind(
        graph, node_id
    );
    let root_text: Option<String> = SemanticExpressionGraphNodeText(
        graph, node_id
    );
    if inner_type == "" || some_fn == "" || none_fn == "" ||
        !IsSome(root_kind) || !IsSome(root_text) {
        Die("semantic Option runtime or expression fact is incomplete");
    }
    if UnwrapOption(root_kind) == AstExpressionNodeLeaf() &&
        UnwrapOption(root_text) == "None" {
        return CodegenOptionExpectedValueFact(
            true, false, inner_type, some_fn, none_fn, -1
        );
    }
    let call: SemanticCallSpineView = SemanticCallSpineViewFromGraph(
        graph, node_id
    );
    if call.ok {
        let target_kind: Option<Int> = SemanticExpressionGraphCallTargetKind(
            graph, call.call_node
        );
        let target_name: Option<String> = SemanticExpressionGraphCallTargetName(
            graph, call.call_node
        );
        if !IsSome(target_kind) || !IsSome(target_name) {
            Die("semantic Option call target fact is missing");
        }
        if UnwrapOption(target_kind) == SemanticCallTargetDirect() &&
            UnwrapOption(target_name) == "None" {
            if ArrayLength(call.argument_nodes) != 0 {
                Die("None Option constructor must not carry a payload");
            }
            return CodegenOptionExpectedValueFact(
                true, false, inner_type, some_fn, none_fn, -1
            );
        }
        if UnwrapOption(target_kind) == SemanticCallTargetDirect() &&
            UnwrapOption(target_name) == "Some" {
            if ArrayLength(call.argument_nodes) != 1 {
                Die("Some Option constructor must carry exactly one payload");
            }
            return CodegenOptionExpectedValueFact(
                false, true, inner_type, some_fn, none_fn,
                call.argument_nodes[0]
            );
        }
    }
    return CodegenOptionExpectedValueFact(
        false, false, inner_type, some_fn, none_fn, -1
    );
}
