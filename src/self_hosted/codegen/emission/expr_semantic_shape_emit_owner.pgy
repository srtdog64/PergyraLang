// Expression emission that consumes semantic-owned top-level shape facts.

import "../input/semantic_expression_codegen_view_owner.pgy";

func RewriteBoolWithSemanticShape(
    e: String,
    env: CodegenTypeEnv,
    shape: SemanticAstExpressionShapeFact
) -> String {
    let s: String = StripOuterParens(e);
    let n: Int = StringLength(s);
    if !shape.ok || shape.normalized_text != s {
        Die("semantic boolean-expression shape does not match codegen expression");
    }
    if shape.logical_or_index >= 0 {
        let p: Int = shape.logical_or_index;
        let lhs: String = Substring(s, 0, p);
        let rhs: String = Substring(s, p + 2, n - (p + 2));
        return Concat(
            RewriteBool(lhs, env), Concat(" || ", RewriteBool(rhs, env))
        );
    }
    if shape.logical_and_index >= 0 {
        let p: Int = shape.logical_and_index;
        let lhs: String = Substring(s, 0, p);
        let rhs: String = Substring(s, p + 2, n - (p + 2));
        return Concat(
            RewriteBool(lhs, env), Concat(" && ", RewriteBool(rhs, env))
        );
    }
    if shape.equality_index >= 0 {
        let p: Int = shape.equality_index;
        let lhs: String = StringTrim(Substring(s, 0, p));
        let rhs: String = StringTrim(Substring(s, p + 2, n - (p + 2)));
        let projected: Option<String> = RewriteEqualityProjection(
            lhs, rhs, !shape.equality_is_not, env
        );
        if IsSome(projected) { return UnwrapOption(projected); }
    }
    return RewriteTokens(s, env);
}

func RewriteExprWithSemanticShape(
    e: String,
    env: CodegenTypeEnv,
    shape: SemanticAstExpressionShapeFact
) -> String {
    let s: String = StripOuterParens(e);
    if !shape.ok || shape.normalized_text != s {
        Die("semantic expression shape does not match codegen expression");
    }
    let p: Int = shape.additive_index;
    if p >= 0 && shape.additive_operator_code == SourceByteOf("+") {
        let lhs: String = StringTrim(Substring(s, 0, p));
        let rhs: String = StringTrim(
            Substring(s, p + 1, StringLength(s) - (p + 1))
        );
        let lhs_kind: String = ExprKind(lhs, env);
        let rhs_kind: String = ExprKind(rhs, env);
        if lhs_kind == rhs_kind {
            let op_name: String = LookupKindType(
                env, Concat(lhs_kind, "+"), "op"
            );
            if StringLength(op_name) == 0 && lhs_kind == "String" {
                op_name = StringRuntimeCConcatFn();
            }
            if StringLength(op_name) > 0 {
                return Concat(op_name, Concat("(", Concat(
                    RewriteExpr(lhs, env), Concat(", ", Concat(
                        RewriteExpr(rhs, env), ")"
                    ))
                )));
            }
        }
    }
    return RewriteBoolWithSemanticShape(e, env, shape);
}

func IntEvalWithSemanticShape(
    expr: String,
    env: CodegenTypeEnv,
    shape: SemanticAstExpressionShapeFact
) -> String {
    return RewriteExprWithSemanticShape(expr, env, shape);
}

func StrEvalWithSemanticShape(
    expr: String,
    env: CodegenTypeEnv,
    shape: SemanticAstExpressionShapeFact
) -> String {
    let e: String = StripOuterParens(expr);
    if !shape.ok || shape.normalized_text != e {
        Die("semantic string-expression shape does not match codegen expression");
    }
    let p: Int = shape.additive_index;
    if p >= 0 && shape.additive_operator_code == SourceByteOf("+") {
        let lhs: String = StringTrim(Substring(e, 0, p));
        let rhs: String = StringTrim(
            Substring(e, p + 1, StringLength(e) - (p + 1))
        );
        return Concat(StringRuntimeCConcatFn(), Concat("(", Concat(
            StrEval(lhs, env), Concat(", ", Concat(StrEval(rhs, env), ")"))
        )));
    }
    return RewriteExprWithSemanticShape(expr, env, shape);
}
