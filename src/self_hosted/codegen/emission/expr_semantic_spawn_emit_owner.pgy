// C emission for the bounded semantic spawn protocol.
import "../input/generic_specialization_codegen_view_owner.pgy";
import "../type_facts/type_env.pgy";
import "../runtime_abi/spawn_runtime_owner.pgy";
import "../../compiler/symbol_table_owner.pgy";
import "../../semantic/ast_expression_graph_call_view_owner.pgy";
import "expr_semantic_call_argument_owner.pgy";

func RewriteSemanticSpawn(
    ref graph: SemanticExpressionGraphFacts, node_id: Int,
    env: CodegenTypeEnv
) -> String {
    let view: SemanticCallSpineView =
        SemanticCallSpineViewFromGraph(graph, node_id);
    if !view.ok || ArrayLength(view.argument_nodes) < 1 ||
        ArrayLength(view.argument_nodes) > 2 {
        Die("self-host spawn requires a direct one-or-two-argument call fact");
    }
    let target_kind: Option<Int> =
        SemanticExpressionGraphCallTargetKind(graph, view.call_node);
    let target_name: Option<String> =
        SemanticExpressionGraphCallTargetName(graph, view.call_node);
    if !IsSome(target_kind) || !IsSome(target_name) ||
        UnwrapOption(target_kind) != SemanticCallTargetDirect() {
        Die("self-host spawn requires a direct call target fact");
    }
    let source_name: String = UnwrapOption(target_name);
    var call_symbol: String = source_name;
    let specialization: String = LookupKindType(
        env, CodegenGenericCallNodeKey(view.call_node), "call");
    if specialization != "" {
        call_symbol = specialization;
    } else {
        let alias: String = LookupKindType(env, source_name, "call");
        if alias != "" { call_symbol = alias; }
    }
    let arity: Int = ArrayLength(view.argument_nodes);
    let payload_type: String = LookupKindType(env, call_symbol, "f");
    if payload_type != "Int" && payload_type != "String" {
        Die("self-host spawn requires a bounded scalar return fact");
    }
    var expected_params: String = payload_type;
    if arity == 2 {
        expected_params = Concat(payload_type, Concat(",", payload_type));
    }
    if (payload_type == "String" && arity != 1) ||
        LookupKindType(env, call_symbol, "pt") != expected_params {
        Die("self-host spawn requires a bounded scalar-call signature fact");
    }
    var arguments: Array<String> = [];
    var argument_index: Int = 0;
    while argument_index < arity {
        ArrayPush(arguments, RewriteSemanticCallArgument(
            graph, view.argument_nodes[argument_index],
            payload_type, "default", env));
        argument_index = argument_index + 1;
    }
    return SpawnRuntimeCCall(
        CompilerSymbolCIdentifier(call_symbol), payload_type, arguments);
}
