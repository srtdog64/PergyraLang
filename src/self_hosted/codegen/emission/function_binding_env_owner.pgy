// Function-scoped C binding rows from semantic and MIR-owned facts.

import "../input/semantic_local_binding_codegen_view_owner.pgy";
import "../runtime_abi/option_result_runtime_owner.pgy";
import "../type_facts/type_env.pgy";
import "../runtime_abi/collection_runtime_owner.pgy";
import "../text/text_owner.pgy";
import "../../compiler/symbol_table_owner.pgy";

struct CodegenFunctionValueBindingFact {
    let source_name: String;
    let semantic_type_name: String;
    let value_kind: String;
    let c_name: String;
    let env_rows: String;
}

func CodegenBindingEnvKind(type_name: String, global_env: String) -> String {
    if StartsWith(type_name, "Array<") {
        return CollectionRuntimeFactFromTypeName(
            type_name, CodegenTypeEnv(global_env, "")
        ).kind;
    }
    if StartsWith(type_name, "Result<") && StringIndexOf(type_name, "Int") >= 0 {
        return "ResultInt";
    }
    if StartsWith(type_name, "Option<") {
        let payload_kind: Int =
            OptionResultRuntimeOptionPayloadKindForType(type_name);
        let option_kind: String =
            OptionResultRuntimeOptionEnvKindForPayloadKind(payload_kind);
        if StringLength(option_kind) > 0 { return option_kind; }
        if LookupKindTypeRows(global_env, type_name, "s") == "struct" {
            return type_name;
        }
    }
    return type_name;
}

func CodegenFunctionValueBindingFactFor(
    source_name: String,
    type_name: String,
    global_env: String
) -> CodegenFunctionValueBindingFact {
    if source_name == "" || type_name == "" {
        Die("function value binding identity or type is missing");
    }
    let value_kind: String = CodegenBindingEnvKind(
        type_name, global_env
    );
    let c_name: String = CompilerSymbolCBindingName(source_name);
    return CodegenFunctionValueBindingFact(
        source_name, type_name, value_kind, c_name,
        TypeEnvTypedValueBindingRows(
            source_name, type_name, value_kind, c_name
        )
    );
}

func CodegenCollectionTargetCBindingOrDie(
    env: CodegenTypeEnv, source_name: String
) -> String {
    let c_name: String = LookupKindType(env, source_name, "cbind");
    if c_name == "" {
        Die("collection target C binding fact is missing");
    }
    return c_name;
}

func CodegenFunctionOwnerFieldEnvRows(
    owner_name: String,
    env: CodegenTypeEnv
) -> String {
    if owner_name == "" { return ""; }
    let fields: String = LookupKindType(env, owner_name, "fields");
    if fields == "" {
        Die("method owner field inventory is missing");
    }
    let rows: Array<String> = [];
    let field_index: Int = 0;
    let field_name: String = CsvAt(fields, field_index);
    while field_name != "" {
        let field_type: String = LookupFieldType(
            env, owner_name, field_name
        );
        if field_type == "" {
            Die("method owner field type fact is missing");
        }
        ArrayPush(rows, TypeEnvTypedValueBindingRows(
            field_name, field_type,
            CodegenBindingEnvKind(field_type, env.global_rows),
            Concat(
                CompilerSymbolCBindingName("self"),
                Concat(".", CompilerSymbolCFieldName(field_name))
            )
        ));
        field_index = field_index + 1;
        field_name = CsvAt(fields, field_index);
    }
    return StringJoin(rows, "");
}

func CodegenFunctionLocalEnvRows(
    local_bindings: SemanticAstLocalBindingFacts,
    function_node_id: Int,
    global_env: String
) -> String {
    let rows: Array<String> = [];
    let i: Int = 0;
    while i < ArrayLength(local_bindings.node_ids) {
        if local_bindings.function_node_ids[i] == function_node_id {
            let type_opt: Option<String> =
                SemanticAstLocalBindingDeclaredTypeAt(local_bindings, i);
            if !IsSome(type_opt) {
                Die("self-host codegen requires a semantic declared local type");
            }
            let source_name: String = local_bindings.names[i];
            let type_name: String = UnwrapOption(type_opt);
            let binding: CodegenFunctionValueBindingFact =
                CodegenFunctionValueBindingFactFor(
                    source_name, type_name, global_env
                );
            ArrayPush(rows, binding.env_rows);
        }
        i = i + 1;
    }
    return StringJoin(rows, "");
}
