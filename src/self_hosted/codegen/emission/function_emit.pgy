import "../text/text_owner.pgy";
import "../text/owned_string_join_owner.pgy";
import "../input/ast_arena_codegen_view_owner.pgy";
import "../input/semantic_signature_codegen_view_owner.pgy";
import "../input/generic_specialization_codegen_view_owner.pgy";
import "../input/semantic_nominal_codegen_view_owner.pgy";
import "../input/callable_receiver_codegen_view_owner.pgy";
import "../input/domain_runtime_codegen_view_owner.pgy";
import "../../compiler/symbol_table_owner.pgy";
import "../abi_layout/abi_layout_owner.pgy";
import "../runtime_abi/collection_runtime_owner.pgy";
import "../runtime_abi/host_io_runtime_owner.pgy";
import "../type_facts/type_env_state_lifetime_owner.pgy";
import "function_binding_env_owner.pgy";
import "callable_parameter_binding_rows_owner.pgy";
import "function_global_env_owner.pgy";
import "role_receiver_binding_owner.pgy";
import "implicit_receiver_c_parameter_owner.pgy";
import "stmt_emit.pgy";
func EmitFunctionWithSpecialization(count: Int, arena: AstArena,
                   signatures: SemanticAstFunctionSignatureFacts,
                   receiver_facts: CodegenCallableReceiverFacts,
                   local_bindings: SemanticAstLocalBindingFacts,
                   assignments: SemanticAstAssignmentFacts,
                   statements: SemanticAstStatementFacts,
                   ref body_types: CodegenSemanticBodyTypeFacts,
                   expression_surfaces: SemanticAstExpressionSurfaceFacts,
                   inout cur: Array<Int>, f_indent: Int,
                   base_env: CodegenTypeEnv, uses_args: Bool,
                   machine_startup: String,
                   specialized_name: String,
                   generic_actuals: Array<String>, ref domain_runtime: CodegenDomainRuntimeFacts) -> String {
    let function_node_id: Int = cur[0];
    let signature_index: Int = CodegenSemanticSignatureIndexOrDie(
        signatures, function_node_id
    );
    let owner_name: String = CodegenSemanticFunctionOwnerOrDie(
        signatures, signature_index
    );
    let name: String = CodegenSemanticFunctionNameOrDie(
        signatures, signature_index
    );
    let c_name: String = CompilerSymbolCQualifiedName(owner_name, name);
    if specialized_name != "" { c_name = specialized_name; }
    ArraySet(cur, 0, cur[0] + 1);

    CodegenAstArenaSkipGenericParams(arena, count, cur);
    CodegenAstArenaExpectParameters(arena, count, cur);
    let params: String = "";
    let param_n: Int = 0;
    let expected_param_count: Int = CodegenSemanticFunctionParamCountOrDie(
        signatures, signature_index
    );
    let function_env_rows: Array<String> = [Concat("", "|")];
    let prologue: String = "";
    let copyout: String = "";
    let zone_return_carriage_guard: String = "";
    let receiver_carriage: String =
        CodegenCallableReceiverCarriageForAdmittedSignatureOrDie(
            receiver_facts, signature_index
        );
    let receiver_source_parameter_offset: Int =
        CodegenCallableReceiverSourceParameterOffsetForAdmittedSignatureOrDie(
            receiver_facts, signature_index
        );
    let domain_runtime_prologue: String = CodegenDomainRuntimeMethodPrologue(
        domain_runtime, owner_name);
    if domain_runtime_prologue != "" && receiver_carriage != CallableReceiverCarriageMutableIdentity() {
        Die("domain runtime owner method requires mutable identity receiver");
    }
    let role_erased: Bool =
        CodegenCallableReceiverRoleErasedForAdmittedSignatureOrDie(
            receiver_facts, signature_index
        );
    let role_receiver: Bool = role_erased;
    let role_receiver_type: String = "";
    let role_target_carriage: String = CallableReceiverCarriageNone();
    if role_receiver {
        role_receiver_type =
            CodegenCallableReceiverRoleTargetTypeForAdmittedSignatureOrDie(
                receiver_facts, signature_index
            );
        role_target_carriage =
            CodegenCallableReceiverRoleTargetCarriageForAdmittedSignatureOrDie(
                receiver_facts, signature_index
            );
    }
    let role_binding: CodegenRoleReceiverBinding =
        CodegenRoleReceiverBinding(false, "", "");
    if role_receiver {
        role_binding = CodegenRoleReceiverBindingOrDie(
            role_receiver_type, receiver_carriage, role_target_carriage,
            base_env
        );
    }
    let mutable_identity_receiver: Bool =
        receiver_carriage == CallableReceiverCarriageMutableIdentity() &&
        !role_receiver;
    let owner_receiver_c_expression: String =
        CompilerSymbolCBindingName("self");
    if mutable_identity_receiver ||
        (role_receiver && role_binding.pointer_identity) {
        owner_receiver_c_expression = role_binding.self_c_expression;
        if mutable_identity_receiver {
            owner_receiver_c_expression = Concat(
                "(*", Concat(CompilerSymbolCBindingName("self"), ")")
            );
        }
    }
    if owner_name != "" &&
        LookupKindType(base_env, owner_name, "s") == "struct" {
        ArrayPush(
            function_env_rows,
            CodegenFunctionOwnerFieldEnvRows(
                owner_name, owner_receiver_c_expression, base_env
            )
        );
    }
    let implicit_receiver: Option<String> =
        CodegenImplicitReceiverCParameterOrDie(
            receiver_facts, signature_index, owner_name, base_env
        );
    if IsSome(implicit_receiver) {
        params = UnwrapOption(implicit_receiver);
        if role_receiver {
            prologue = role_binding.prologue;
        } else {
            let self_binding: CodegenFunctionValueBindingFact =
                CodegenFunctionValueBindingFactForCExpression(
                    "self", owner_name, base_env,
                    owner_receiver_c_expression
                );
            ArrayPush(function_env_rows, self_binding.env_rows);
        }
    }
    while cur[0] < count && CodegenAstArenaIndentOrDie(arena, cur[0]) == f_indent + 4 {
        let parameter_node_id: Int = cur[0];
        let mutable_resource_parameter: Bool =
            CodegenSemanticMutableResourceParameter(
                body_types, parameter_node_id
            );
        let p_mode: Int = CodegenSemanticFunctionParamModeOrDie(
            signatures, signature_index, param_n
        );
        let p_name: String = CodegenSemanticFunctionParamNameForNodeOrDie(
            signatures, signature_index, param_n, cur[0]
        );
        let p_type: String = CodegenGenericResolvedParamTypeOrDie(
            signatures, signature_index, param_n, generic_actuals
        );
        let source_receiver_parameter: Bool =
            param_n < receiver_source_parameter_offset;
        if source_receiver_parameter {
            if role_receiver {
                p_type = role_receiver_type;
            }
        }
        let p_binding: CodegenFunctionValueBindingFact =
            CodegenFunctionValueBindingFactFor(
                p_name, p_type, base_env
            );
        let p_env_binding: CodegenFunctionValueBindingFact = p_binding;
        if source_receiver_parameter && (mutable_identity_receiver ||
            (role_receiver && role_binding.pointer_identity)) {
            p_env_binding = CodegenFunctionValueBindingFactForCExpression(
                p_name, p_type, base_env,
                owner_receiver_c_expression
            );
        }
        let c_p_name: String = p_binding.c_name;
        let callable_declaration: Option<String> =
            AbiLayoutCCallableParamDeclaration(
                p_type, c_p_name, base_env
            );
        let c_param_type: String = "";
        let c_param: String = "";
        if IsSome(callable_declaration) {
            if p_mode != 0 {
                Die("callable C parameters support only value carriage");
            }
            c_param = UnwrapOption(callable_declaration);
        } else {
            c_param_type = AbiLayoutCParamType(p_type, base_env);
            c_param = Concat(c_param_type, Concat(" ", c_p_name));
        }
        if IsSome(callable_declaration) {
        } else if source_receiver_parameter && mutable_identity_receiver {
            if p_mode != 0 {
                Die("mutable-identity receiver cannot use a parameter carriage mode");
            }
            c_param = Concat(c_param_type, Concat(" *", c_p_name));
        } else if source_receiver_parameter && role_receiver {
            c_param = "void *_pgy_raw_self";
            prologue = Concat(prologue, role_binding.prologue);
        }
        let readonly_ref_direct: Bool = p_mode == 3 &&
            AbiLayoutCReadonlyRefPassesDirect(p_type);
        let c_ref_name: String = c_p_name;
        if source_receiver_parameter &&
            (mutable_identity_receiver || role_receiver) {
        } else if p_mode == 1 {
            let inout_name: String = CompilerSymbolCInoutParamName(p_name);
            c_param = Concat(c_param_type, Concat(" *", inout_name));
            if mutable_resource_parameter {
                p_env_binding = CodegenFunctionValueBindingFactForCExpression(
                    p_name, p_type, base_env,
                    Concat("(*", Concat(inout_name, ")"))
                );
            } else {
                prologue = Concat(prologue, Concat("    ", Concat(c_param_type, Concat(" ", Concat(c_p_name, Concat(" = *", Concat(inout_name, ";\n")))))));
                copyout = Concat(copyout, Concat("    *", Concat(inout_name, Concat(" = ", Concat(c_p_name, ";\n")))));
            }
        } else if p_mode == 3 && !readonly_ref_direct {
            c_ref_name = CompilerSymbolCReadonlyRefParamName(p_name);
            c_param = Concat(
                "const ", Concat(c_param_type, Concat(" *", c_ref_name))
            );
        }
        if params == "" {
            params = c_param;
        } else {
            params = Concat(params, Concat(", ", c_param));
        }
        if p_mode == 3 && !readonly_ref_direct {
            ArrayPush(function_env_rows, TypeEnvTypedReadonlyRefBindingRows(
                p_name, p_type, p_binding.value_kind, c_ref_name
            ));
        } else {
            ArrayPush(function_env_rows, p_env_binding.env_rows);
            let callable_rows: String =
                CodegenCallableParameterBindingRows(
                    cur[0],
                    p_env_binding.semantic_type_name,
                    p_env_binding.c_name
                );
            if callable_rows != "" {
                ArrayPush(function_env_rows, callable_rows);
            }
        }
        param_n = param_n + 1;
        ArraySet(cur, 0, cur[0] + 1);
    }

    if param_n != expected_param_count {
        Die("semantic signature parameter count does not match AST traversal");
    }
    if cur[0] >= count || !CodegenAstArenaIsReturns(arena, cur[0]) {
        Die("expected Returns: line after parameters");
    }
    let env_state: CodegenTypeEnvState = CodegenTypeEnvStateOwned(
        CodegenJoinOwnedStringFragments(function_env_rows, "")
    );
    let ret_type: String = CodegenGenericResolvedReturnTypeOrDie(
        signatures, signature_index, generic_actuals
    );
    if LookupKindType(base_env, ret_type, "nk") == "zone" {
        zone_return_carriage_guard =
            "#ifdef PGY_ZONE_THREADSAFE\n#error \"Pergyra zone return requires an admitted transfer plan\"\n#endif\n";
    }
    ArraySet(cur, 0, cur[0] + 1);

    CodegenSemanticCallableContractAdvanceOrDie(
        signatures, signature_index, arena, count, cur
    );
    CodegenAstArenaExpectBody(arena, count, cur);
    CodegenAstArenaExpectBlock(arena, count, cur);
    let stmt_indent: Int = f_indent + 6;
    let is_main: Bool = CodegenSemanticFunctionUsesDirectHostEntrypoint(
        signatures.entrypoint_selection,
        SemanticAstFunctionSignatureCount(signatures), signature_index
    );
    let body_ret: String = ret_type;
    if is_main {
        body_ret = AbiLayoutCEntrypointBodyReturnType();
    }
    let routine_defers: Array<String> = [""];
    let body_emission: CodegenStatementBlockEmission = EmitStmtList(
        count, arena, local_bindings, assignments, statements, body_types,
        expression_surfaces, stmt_indent, cur, "    ",
        env_state, body_ret, routine_defers, copyout, "", base_env
    );
    let body: String = body_emission.body;

    let signature: String = "";
    if is_main {
        signature = HostIORuntimeCEntrypointSignature(uses_args);
    } else {
        let param_list: String = params;
        if params == "" {
            param_list = AbiLayoutCEmptyParameterList();
        }
        signature = Concat(
            AbiLayoutCReturnType(ret_type, base_env),
            Concat(" ", Concat(c_name, Concat("(", Concat(param_list, ")"))))
        );
    }
    let tail: String = "}\n";
    if is_main {
        tail = Concat("    return ", Concat(HostIORuntimeCEntrypointSuccessValue(), ";\n}\n"));
    }
    let output_allocator: Allocator = AllocatorResult();
    let output: TextBuilder = TextBuilderNew(1024);
    TextBuilderAppend(output, signature);
    TextBuilderAppend(output, "\n{\n");
    TextBuilderAppend(output, zone_return_carriage_guard);
    if is_main && uses_args {
        TextBuilderAppend(output, HostIORuntimeCArgsCapturePrefix());
        TextBuilderAppend(output, machine_startup);
        TextBuilderAppend(output, prologue);
    } else {
        if is_main { TextBuilderAppend(output, machine_startup); }
        TextBuilderAppend(output, prologue);
        TextBuilderAppend(output, domain_runtime_prologue);
    }
    TextBuilderAppend(output, body);
    TextBuilderAppend(output, routine_defers[0]);
    TextBuilderAppend(output, body_emission.scope_cleanup);
    TextBuilderAppend(output, copyout);
    TextBuilderAppend(output, tail);
    let definition: String = TextBuilderFinish(output, output_allocator);
    AllocatorDestroy(output_allocator);
    CodegenTypeEnvStateReleaseLocal(env_state);
    let owned_function_epoch: Array<String> = [body];
    if routine_defers[0] != "" {
        ArrayPush(owned_function_epoch, routine_defers[0]);
    }
    if body_emission.scope_cleanup != "" {
        ArrayPush(owned_function_epoch, body_emission.scope_cleanup);
    }
    if copyout != "" { ArrayPush(owned_function_epoch, copyout); }
    if !is_main && signature != "" {
        ArrayPush(owned_function_epoch, signature);
    }
    if is_main { ArrayPush(owned_function_epoch, tail); }
    ArrayDropOwnedStrings(owned_function_epoch);
    return definition;
}

func EmitFunction(count: Int, arena: AstArena,
                   signatures: SemanticAstFunctionSignatureFacts,
                   receiver_facts: CodegenCallableReceiverFacts,
                   local_bindings: SemanticAstLocalBindingFacts,
                   assignments: SemanticAstAssignmentFacts,
                   statements: SemanticAstStatementFacts,
                   ref body_types: CodegenSemanticBodyTypeFacts,
                   expression_surfaces: SemanticAstExpressionSurfaceFacts,
                   inout cur: Array<Int>, f_indent: Int,
                   base_env: CodegenTypeEnv, machine_startup: String, uses_args: Bool,
                   ref domain_runtime: CodegenDomainRuntimeFacts) -> String {
    let no_actuals: Array<String> = [];
    return EmitFunctionWithSpecialization(
        count, arena, signatures, receiver_facts,
        local_bindings, assignments,
        statements, body_types, expression_surfaces, cur, f_indent,
        base_env, uses_args, machine_startup, "", no_actuals, domain_runtime
    );
}
