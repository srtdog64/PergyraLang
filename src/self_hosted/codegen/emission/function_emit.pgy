// src/self_hosted/codegen/emission/function_emit.pgy
//
// Function/declaration scan and signature emission owner for self-host C emission.

import "../text/text_owner.pgy";
import "../input/ast_text_inventory_owner.pgy";
import "../input/ast_text_statement_owner.pgy";
import "../input/ast_text_typed_arena_owner.pgy";
import "../../compiler/symbol_table_owner.pgy";
import "../abi_layout/abi_layout_owner.pgy";
import "../runtime_abi/collection_runtime_owner.pgy";
import "stmt_emit.pgy";

func ParamModeCsvAppend(csv: String, mode: Int) -> String {
    let next: String = CodegenAstTextParamModeName(mode);
    if StringLength(csv) == 0 {
        return next;
    }
    return Concat(csv, Concat(",", next));
}

func ParamTypeCsvAppend(csv: String, type_name: String) -> String {
    if StringLength(csv) == 0 {
        return type_name;
    }
    return Concat(csv, Concat(",", type_name));
}

func FunctionCallProjectionSourceName(c_symbol: String) -> String {
    let n: Int = StringLength(c_symbol);
    let start: Int = 0;
    let i: Int = 0;
    while i < n {
        if CodegenCharAt(c_symbol, i) == "_" {
            start = i + 1;
        }
        i = i + 1;
    }
    if start <= 0 || start >= n {
        return c_symbol;
    }
    return Substring(c_symbol, start, n - start);
}

func FunctionCallProjectionIndex(names: Array<String>, source_name: String) -> Option<Int> {
    let i: Int = 0;
    while i < ArrayLength(names) {
        if names[i] == source_name {
            return Some(i);
        }
        i = i + 1;
    }
    return None;
}

func FunctionCallProjectionRecord(inout names: Array<String>, inout targets: Array<String>,
                                  inout counts: Array<Int>, source_name: String,
                                  c_symbol: String) -> Void {
    if StringLength(source_name) == 0 || source_name == c_symbol {
        return;
    }
    let idx_opt: Option<Int> = FunctionCallProjectionIndex(names, source_name);
    if !IsSome(idx_opt) {
        ArrayPush(names, source_name);
        ArrayPush(targets, c_symbol);
        ArrayPush(counts, 1);
        return;
    }
    let idx: Int = UnwrapOption(idx_opt);
    if targets[idx] != c_symbol {
        ArraySet(counts, idx, 2);
    }
}

// Emit one function definition starting at the `Function: <Name>` line at
// cur[0]. `base_env` carries the global function return-type bindings.
func EmitFunction(nodes: Array<CodegenAstTextNode>, count: Int, arena: AstArena,
                  inout cur: Array<Int>, f_indent: Int,
                  base_env: String, uses_args: Bool, owner_name: String) -> String {
    let name: String = CodegenAstArenaAtomOrDie(arena, cur[0]);
    let c_name: String = CompilerSymbolCQualifiedName(owner_name, name);
    ArraySet(cur, 0, cur[0] + 1);

    CodegenAstTextExpectNode(nodes, count, cur, "Parameters:");
    let params: String = "";
    let param_n: Int = 0;
    let env_box: Array<String> = [base_env];
    let prologue: String = "";
    let copyout: String = "";
    while cur[0] < count && CodegenAstArenaIndentOrDie(arena, cur[0]) == f_indent + 4 {
        let p_mode: Int = CodegenAstArenaModeOrDie(arena, cur[0]);
        if p_mode == 2 || p_mode == 3 {
            Die(Concat("unsupported self-host codegen parameter mode: ", CodegenAstTextProvenance(nodes[cur[0]])));
        }
        let p_name: String = CodegenAstArenaAtomOrDie(arena, cur[0]);
        let p_type: String = CodegenAstArenaParamTypeOrDie(arena, cur[0], owner_name);
        let c_param_type: String = AbiLayoutCParamType(p_type, base_env);
        let c_param: String = Concat(c_param_type, Concat(" ", p_name));
        if p_mode == 1 {
            let inout_name: String = Concat("_pgy_inout_", p_name);
            c_param = Concat(c_param_type, Concat(" *", inout_name));
            prologue = Concat(prologue, Concat("    ", Concat(c_param_type, Concat(" ", Concat(p_name, Concat(" = *", Concat(inout_name, ";\n")))))));
            copyout = Concat(copyout, Concat("    *", Concat(inout_name, Concat(" = ", Concat(p_name, ";\n")))));
        }
        if param_n == 0 {
            params = c_param;
        } else {
            params = Concat(params, Concat(", ", c_param));
        }
        // Register the param under a canonical kind so array indexing/length
        // rewriting recognizes it (`Array<Int...>` -> ArrayInt, etc.).
        let p_kind: String = p_type;
        if StartsWith(p_type, "Array<") {
            p_kind = CollectionRuntimeKindFromTypeName(p_type);
        }
        ArraySet(env_box, 0, Concat(env_box[0], Concat(p_name, Concat("=v:", Concat(p_kind, "|")))));
        param_n = param_n + 1;
        ArraySet(cur, 0, cur[0] + 1);
    }

    if cur[0] >= count || !CodegenAstTextIsReturns(nodes[cur[0]]) {
        Die("expected Returns: line after parameters");
    }
    let ret_type: String = CodegenAstArenaTypeNameOrDie(arena, cur[0]);
    ArraySet(cur, 0, cur[0] + 1);

    CodegenAstTextExpectNode(nodes, count, cur, "Body:");
    CodegenAstTextExpectNode(nodes, count, cur, "Block:");
    let stmt_indent: Int = f_indent + 6;
    let is_main: Bool = name == "Main";
    // Main lowers to `int main`, so a bare `return` inside it must be `return 0;`
    // -- emit its body with an Int return type.
    let body_ret: String = ret_type;
    if is_main {
        body_ret = "Int";
    }
    let body: String = EmitStmtList(nodes, count, arena, stmt_indent, cur, "    ", env_box, body_ret, copyout);

    let signature: String = "";
    let body_full: String = Concat(prologue, Concat(body, copyout));
    if is_main {
        if uses_args {
            // Capture argv into globals so `Args()` (-> pgy_args) can read them.
            signature = "int main(int argc, char **argv)";
            body_full = Concat("    pgy_argc = argc;\n    pgy_argv = argv;\n", Concat(prologue, Concat(body, copyout)));
        } else {
            signature = "int main(void)";
        }
    } else {
        let param_list: String = params;
        if param_n == 0 {
            param_list = "void";
        }
        signature = Concat(AbiLayoutCReturnType(ret_type, base_env), Concat(" ", Concat(c_name, Concat("(", Concat(param_list, ")")))));
    }

    let tail: String = "}\n";
    if is_main {
        tail = "    return 0;\n}\n";
    }
    return Concat(signature, Concat("\n{\n", Concat(body_full, tail)));
}

// Build the global environment: `|Name=f:RetType|...` for every function, by
// pairing each `Function: Name` line with the next `Returns:` line.
func BuildFunctionEnv(nodes: Array<CodegenAstTextNode>, count: Int, arena: AstArena) -> String {
    let env: String = "|";
    let i: Int = 0;
    let owner: String = "";
    let owner_indent: Int = -1;
    let skip_indent: Int = -1;
    while i < count {
        let indent: Int = CodegenAstArenaIndentOrDie(arena, i);
        if skip_indent >= 0 {
            if indent > skip_indent {
                i = i + 1;
                continue;
            }
            skip_indent = -1;
        }
        if StringLength(owner) > 0 && indent <= owner_indent {
            owner = "";
            owner_indent = -1;
        }
        if CodegenAstArenaIsZeroArtifactDecl(arena, i) {
            skip_indent = indent;
            i = i + 1;
            continue;
        }
        if CodegenAstArenaIsNominalDecl(arena, i) {
            owner = CodegenAstArenaAtomOrDie(arena, i);
            owner_indent = indent;
        }
        if CodegenAstArenaIsRoleDecl(arena, i) {
            owner = CodegenAstArenaAtomOrDie(arena, i);
            owner_indent = indent;
        }
        if CodegenAstArenaIsFunction(arena, i) {
            let fname: String = CodegenAstArenaAtomOrDie(arena, i);
            let cname: String = CompilerSymbolCQualifiedName("", fname);
            if StringLength(owner) > 0 && indent > owner_indent {
                cname = CompilerSymbolCQualifiedName(owner, fname);
            }
            let j: Int = i + 1;
            let rtype: String = "Void";
            while j < count && !CodegenAstArenaIsFunction(arena, j) {
                if CodegenAstTextIsParameters(nodes[j]) {
                    j = j + 1;
                    let modes: String = "";
                    let param_types: String = "";
                    while j < count && CodegenAstArenaIndentOrDie(arena, j) == indent + 4 {
                        modes = ParamModeCsvAppend(modes, CodegenAstArenaModeOrDie(arena, j));
                        param_types = ParamTypeCsvAppend(param_types, CodegenAstArenaParamTypeOrDie(arena, j, owner));
                        j = j + 1;
                    }
                    env = Concat(env, Concat(cname, Concat("=pm:", Concat(modes, "|"))));
                    env = Concat(env, Concat(cname, Concat("=pt:", Concat(param_types, "|"))));
                    continue;
                }
                if CodegenAstTextIsReturns(nodes[j]) {
                    rtype = CodegenAstArenaTypeNameOrDie(arena, j);
                    j = count;
                } else {
                    j = j + 1;
                }
            }
            env = Concat(env, Concat(cname, Concat("=f:", Concat(rtype, "|"))));
        }
        i = i + 1;
    }
    let projection_names: Array<String> = [];
    let projection_targets: Array<String> = [];
    let projection_counts: Array<Int> = [];
    i = 0;
    owner = "";
    owner_indent = -1;
    skip_indent = -1;
    while i < count {
        let indent: Int = CodegenAstArenaIndentOrDie(arena, i);
        if skip_indent >= 0 {
            if indent > skip_indent {
                i = i + 1;
                continue;
            }
            skip_indent = -1;
        }
        if StringLength(owner) > 0 && indent <= owner_indent {
            owner = "";
            owner_indent = -1;
        }
        if CodegenAstArenaIsZeroArtifactDecl(arena, i) {
            skip_indent = indent;
            i = i + 1;
            continue;
        }
        if CodegenAstArenaIsNominalDecl(arena, i) {
            owner = CodegenAstArenaAtomOrDie(arena, i);
            owner_indent = indent;
        }
        if CodegenAstArenaIsRoleDecl(arena, i) {
            owner = CodegenAstArenaAtomOrDie(arena, i);
            owner_indent = indent;
        }
        if CodegenAstArenaIsFunction(arena, i) {
            let fname: String = CodegenAstArenaAtomOrDie(arena, i);
            let cname: String = CompilerSymbolCQualifiedName("", fname);
            if StringLength(owner) > 0 && indent > owner_indent {
                cname = CompilerSymbolCQualifiedName(owner, fname);
            }
            let source_call_name: String = FunctionCallProjectionSourceName(cname);
            if LookupKindType(env, source_call_name, "f") == "" {
                FunctionCallProjectionRecord(projection_names, projection_targets,
                    projection_counts, source_call_name, cname);
            }
        }
        i = i + 1;
    }
    let projection_i: Int = 0;
    while projection_i < ArrayLength(projection_names) {
        if projection_counts[projection_i] == 1 {
            env = Concat(env, Concat(projection_names[projection_i],
                Concat("=cf:", Concat(projection_targets[projection_i], "|"))));
        }
        projection_i = projection_i + 1;
    }
    return env;
}

func CollectRoleOperators(nodes: Array<CodegenAstTextNode>, count: Int, arena: AstArena, inout env_box: Array<String>) -> String {
    let i: Int = 0;
    while i < count {
        if CodegenAstArenaIsRoleDecl(arena, i) {
            let role_name: String = CodegenAstArenaAtomOrDie(arena, i);
            let for_type: String = CodegenAstArenaTypeNameOrDie(arena, i);
            let j: Int = i + 1;
            while j < count && CodegenAstArenaIsDescendantOf(arena, j, i) {
                if CodegenAstArenaIsFunction(arena, j) {
                    let mname: String = CodegenAstArenaAtomOrDie(arena, j);
                    if for_type == "Int" && mname == "Add" {
                        let c_name: String = CompilerSymbolCRoleOperatorName(role_name, "Add");
                        ArraySet(env_box, 0, Concat(env_box[0], Concat("Int+=op:", Concat(c_name, "|"))));
                    }
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return "";
}

// Scan top-level nominal declarations into C typedefs, and append
// `Name=s:struct|Name=fields:a,b|Name.field=field:Type|` entries to env_box[0].
func CollectStructs(nodes: Array<CodegenAstTextNode>, count: Int, arena: AstArena, inout env_box: Array<String>) -> String {
    let typedefs: String = "";
    let i: Int = 0;
    while i < count {
        if CodegenAstArenaIsNominalDecl(arena, i) {
            let sname: String = CodegenAstArenaAtomOrDie(arena, i);
            let s_indent: Int = CodegenAstArenaIndentOrDie(arena, i);
            let j: Int = i + 1;
            if j < count && CodegenAstTextIsFieldsHeader(nodes[j]) {
                j = j + 1;
            }
            let fields_c: String = "";
            let field_names: String = "";
            while j < count && CodegenAstArenaIndentOrDie(arena, j) == s_indent + 4 {
                let fname: String = CodegenAstArenaAtomOrDie(arena, j);
                let ftype: String = CodegenAstArenaTypeNameOrDie(arena, j);
                let cfield_type: String = AbiLayoutCFieldType(ftype, env_box[0]);
                if StringLength(field_names) == 0 {
                    field_names = fname;
                } else {
                    field_names = Concat(field_names, Concat(",", fname));
                }
                ArraySet(env_box, 0, Concat(env_box[0], Concat(sname, Concat(".", Concat(fname, Concat("=field:", Concat(ftype, "|")))))));
                fields_c = Concat(fields_c, Concat("    ", Concat(cfield_type, Concat(" ", Concat(fname, ";\n")))));
                j = j + 1;
            }
            typedefs = Concat(typedefs, Concat("typedef struct {\n", Concat(fields_c, Concat("} ", Concat(sname, ";\n\n")))));
            ArraySet(env_box, 0, Concat(env_box[0], Concat(sname, "=s:struct|")));
            ArraySet(env_box, 0, Concat(env_box[0], Concat(sname, Concat("=fields:", Concat(field_names, "|")))));
        }
        i = i + 1;
    }
    return typedefs;
}

func CollectEnums(nodes: Array<CodegenAstTextNode>, count: Int, arena: AstArena, inout env_box: Array<String>) -> String {
    let block: String = "";
    let i: Int = 0;
    while i < count {
        if CodegenAstArenaIsEnumDecl(arena, i) {
            let ename: String = CodegenAstArenaAtomOrDie(arena, i);
            let variant_total: Int = CodegenAstArenaEnumVariantCount(arena, i);
            let value: Int = 0;
            let enum_c: String = "enum {\n";
            ArraySet(env_box, 0, Concat(env_box[0], Concat(ename, "=enum:payload_free|")));
            while value < variant_total {
                let part: String = CodegenAstArenaEnumVariantNameAt(arena, i, value);
                let cname: String = CompilerSymbolCEnumVariantName(ename, part);
                enum_c = Concat(enum_c, Concat("    ", Concat(cname, Concat(" = ", Concat(ToString(value), ",\n")))));
                ArraySet(env_box, 0, Concat(env_box[0], Concat(ename, Concat(".", Concat(part, Concat("=e:", Concat(ToString(value), "|")))))));
                value = value + 1;
            }
            enum_c = Concat(enum_c, "};\n\n");
            block = Concat(block, enum_c);
        }
        i = i + 1;
    }
    return block;
}

// Build the C forward-declaration block for every non-Main function, in
// GenerateC's own scope. (A pre-pass is required because Pergyra arrays pass by
// value with a shared element buffer: `ArraySet` mutations persist across calls
// but `ArrayPush` growth does not -- so a callee cannot append to the caller's
// `protos`. Emitting prototypes here makes forward references compile.)
func CollectProtos(nodes: Array<CodegenAstTextNode>, count: Int, arena: AstArena, struct_env: String) -> String {
    let block: String = "";
    let i: Int = 0;
    let owner: String = "";
    let owner_indent: Int = -1;
    let skip_indent: Int = -1;
    while i < count {
        let indent: Int = CodegenAstArenaIndentOrDie(arena, i);
        if skip_indent >= 0 {
            if indent > skip_indent {
                i = i + 1;
                continue;
            }
            skip_indent = -1;
        }
        if StringLength(owner) > 0 && indent <= owner_indent {
            owner = "";
            owner_indent = -1;
        }
        if CodegenAstArenaIsZeroArtifactDecl(arena, i) {
            skip_indent = indent;
            i = i + 1;
            continue;
        }
        if CodegenAstArenaIsNominalDecl(arena, i) {
            owner = CodegenAstArenaAtomOrDie(arena, i);
            owner_indent = indent;
        }
        if CodegenAstArenaIsRoleDecl(arena, i) {
            owner = CodegenAstArenaAtomOrDie(arena, i);
            owner_indent = indent;
        }
        if CodegenAstArenaIsFunction(arena, i) {
            let name: String = CodegenAstArenaAtomOrDie(arena, i);
            let c_name: String = CompilerSymbolCQualifiedName(owner, name);
            if c_name != "Main" {
                let f_indent: Int = indent;
                let j: Int = i + 1;
                if j < count && CodegenAstTextIsParameters(nodes[j]) {
                    j = j + 1;
                }
                let params: String = "";
                let pn: Int = 0;
                while j < count && CodegenAstArenaIndentOrDie(arena, j) == f_indent + 4 {
                    let p_mode: Int = CodegenAstArenaModeOrDie(arena, j);
                    if p_mode == 2 || p_mode == 3 {
                        Die(Concat("unsupported self-host codegen parameter mode: ", CodegenAstTextProvenance(nodes[j])));
                    }
                    let p_name: String = CodegenAstArenaAtomOrDie(arena, j);
                    let p_type: String = CodegenAstArenaParamTypeOrDie(arena, j, owner);
                    let cpt: String = AbiLayoutCParamType(p_type, struct_env);
                    let cp: String = Concat(cpt, Concat(" ", p_name));
                    if p_mode == 1 {
                        cp = Concat(cpt, Concat(" *_pgy_inout_", p_name));
                    }
                    if pn == 0 {
                        params = cp;
                    } else {
                        params = Concat(params, Concat(", ", cp));
                    }
                    pn = pn + 1;
                    j = j + 1;
                }
                let rtype: String = "Void";
                if j < count && CodegenAstTextIsReturns(nodes[j]) {
                    rtype = CodegenAstArenaTypeNameOrDie(arena, j);
                }
                let plist: String = params;
                if pn == 0 {
                    plist = "void";
                }
                let sig: String = Concat(AbiLayoutCReturnType(rtype, struct_env), Concat(" ", Concat(c_name, Concat("(", Concat(plist, ")")))));
                block = Concat(block, Concat(sig, ";\n"));
            }
        }
        i = i + 1;
    }
    if StringLength(block) > 0 {
        block = Concat(block, "\n");
    }
    return block;
}
