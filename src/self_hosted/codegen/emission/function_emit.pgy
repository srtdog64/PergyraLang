// Function/declaration scan and signature emission owner for self-host C emission.
import "../text/text_owner.pgy";
import "../input/ast_arena_codegen_view_owner.pgy";
import "../input/semantic_signature_codegen_view_owner.pgy";
import "../input/generic_specialization_codegen_view_owner.pgy";
import "../input/semantic_role_codegen_view_owner.pgy";
import "../input/semantic_nominal_codegen_view_owner.pgy";
import "../input/callable_receiver_codegen_view_owner.pgy";
import "../../compiler/symbol_table_owner.pgy";
import "../../semantic/builtin_signature_owner.pgy";
import "../abi_layout/abi_layout_owner.pgy";
import "../runtime_abi/collection_runtime_owner.pgy";
import "../runtime_abi/host_io_runtime_owner.pgy";
import "../runtime_abi/text_builder_runtime_owner.pgy";
import "function_binding_env_owner.pgy";
import "role_receiver_binding_owner.pgy";
import "stmt_emit.pgy";
func ParamModeCsvAppend(csv: String, mode: Int) -> String {
    let next: String = CodegenParamModeName(mode);
    if StringLength(csv) == 0 {
        return next;
    }
    return Concat(csv, Concat(",", next));
}
func ParamTypeCsvAppend(csv: String, type_name: String) -> String {
    if StringLength(csv) == 0 {
        return type_name;
    }
    return Concat(csv, Concat(",", type_name));
}
func EmitFunctionWithSpecialization(count: Int, arena: AstArena,
                   signatures: SemanticAstFunctionSignatureFacts,
                   roles: SemanticAstRoleFacts,
                   receiver_facts: CodegenCallableReceiverFacts,
                   local_bindings: SemanticAstLocalBindingFacts,
                   assignments: SemanticAstAssignmentFacts,
                   statements: SemanticAstStatementFacts,
                   ref body_types: CodegenSemanticBodyTypeFacts,
                   expression_surfaces: SemanticAstExpressionSurfaceFacts,
                   inout cur: Array<Int>, f_indent: Int,
                   base_env: CodegenTypeEnv, uses_args: Bool,
                   machine_startup: String,
                   specialized_name: String,
                   generic_actuals: Array<String>) -> String {
    let function_node_id: Int = cur[0];
    let signature_index: Int = CodegenSemanticSignatureIndexOrDie(
        signatures, function_node_id
    );
    let owner_name: String = CodegenSemanticFunctionOwnerOrDie(
        signatures, signature_index
    );
    let name: String = CodegenSemanticFunctionNameOrDie(
        signatures, signature_index
    );
    let c_name: String = CompilerSymbolCQualifiedName(owner_name, name);
    if specialized_name != "" { c_name = specialized_name; }
    ArraySet(cur, 0, cur[0] + 1);

    CodegenAstArenaSkipGenericParams(arena, count, cur);
    CodegenAstArenaExpectParameters(arena, count, cur);
    let params: String = "";
    let param_n: Int = 0;
    let expected_param_count: Int = CodegenSemanticFunctionParamCountOrDie(
        signatures, signature_index
    );
    let function_env_rows: Array<String> = [];
    let env_state: Array<String> = [base_env.global_rows, ""];
    let prologue: String = "";
    let copyout: String = "";
    let role_receiver_type: Option<String> = CodegenSemanticRoleReceiverType(
        roles, function_node_id
    );
    let role_receiver: Bool = IsSome(role_receiver_type);
    let receiver_carriage: String =
        CodegenCallableReceiverCarriageForSignatureOrDie(
            receiver_facts, signatures, signature_index
        );
    let role_erased: Bool =
        CodegenCallableReceiverRoleErasedForSignatureOrDie(
            receiver_facts, signatures, signature_index
        );
    if role_receiver != role_erased {
        Die("callable receiver role-erasure fact is stale");
    }
    let role_binding: CodegenRoleReceiverBinding =
        CodegenRoleReceiverBinding(false, "", "");
    if role_receiver {
        role_binding = CodegenRoleReceiverBindingOrDie(
            UnwrapOption(role_receiver_type), receiver_carriage, base_env
        );
    }
    let mutable_identity_receiver: Bool =
        receiver_carriage == CallableReceiverCarriageMutableIdentity() &&
        !role_receiver;
    let owner_receiver_c_expression: String =
        CompilerSymbolCBindingName("self");
    if mutable_identity_receiver ||
        (role_receiver && role_binding.pointer_identity) {
        owner_receiver_c_expression = role_binding.self_c_expression;
        if mutable_identity_receiver {
            owner_receiver_c_expression = Concat(
                "(*", Concat(CompilerSymbolCBindingName("self"), ")")
            );
        }
    }
    if owner_name != "" &&
        LookupKindType(base_env, owner_name, "s") == "struct" {
        ArrayPush(
            function_env_rows,
            CodegenFunctionOwnerFieldEnvRows(
                owner_name, owner_receiver_c_expression, base_env
            )
        );
    }
    let role_declares_self: Bool = false;
    let signature_param_index: Int = 0;
    while signature_param_index < expected_param_count {
        if CodegenSemanticFunctionParamNameOrDie(
            signatures, signature_index, signature_param_index
        ) == "self" {
            role_declares_self = true;
        }
        signature_param_index = signature_param_index + 1;
    }
    if role_receiver && !role_declares_self {
        params = "void *_pgy_raw_self";
        prologue = role_binding.prologue;
    }
    while cur[0] < count && CodegenAstArenaIndentOrDie(arena, cur[0]) == f_indent + 4 {
        let p_mode: Int = CodegenSemanticFunctionParamModeOrDie(
            signatures, signature_index, param_n
        );
        let p_name: String = CodegenSemanticFunctionParamNameForNodeOrDie(
            signatures, signature_index, param_n, cur[0]
        );
        let p_type: String = CodegenGenericResolvedParamTypeOrDie(
            signatures, signature_index, param_n, generic_actuals
        );
        if p_name == "self" {
            if IsSome(role_receiver_type) {
                p_type = UnwrapOption(role_receiver_type);
            }
        }
        let p_binding: CodegenFunctionValueBindingFact =
            CodegenFunctionValueBindingFactFor(
                p_name, p_type, base_env.global_rows
            );
        let p_env_binding: CodegenFunctionValueBindingFact = p_binding;
        if p_name == "self" && (mutable_identity_receiver ||
            (role_receiver && role_binding.pointer_identity)) {
            p_env_binding = CodegenFunctionValueBindingFactForCExpression(
                p_name, p_type, base_env.global_rows,
                owner_receiver_c_expression
            );
        }
        let c_p_name: String = p_binding.c_name;
        let c_param_type: String = AbiLayoutCParamType(p_type, base_env);
        let c_param: String = Concat(c_param_type, Concat(" ", c_p_name));
        if p_name == "self" && mutable_identity_receiver {
            if p_mode != 0 {
                Die("mutable-identity receiver cannot use a parameter carriage mode");
            }
            c_param = Concat(c_param_type, Concat(" *", c_p_name));
        } else if p_name == "self" && role_receiver {
            c_param = "void *_pgy_raw_self";
            prologue = Concat(prologue, role_binding.prologue);
        }
        let c_ref_name: String = c_p_name;
        if p_name == "self" &&
            (mutable_identity_receiver || role_receiver) {
        } else if p_mode == 1 {
            let inout_name: String = CompilerSymbolCInoutParamName(p_name);
            c_param = Concat(c_param_type, Concat(" *", inout_name));
            prologue = Concat(prologue, Concat("    ", Concat(c_param_type, Concat(" ", Concat(c_p_name, Concat(" = *", Concat(inout_name, ";\n")))))));
            copyout = Concat(copyout, Concat("    *", Concat(inout_name, Concat(" = ", Concat(c_p_name, ";\n")))));
        } else if p_mode == 3 {
            c_ref_name = CompilerSymbolCReadonlyRefParamName(p_name);
            c_param = Concat(
                "const ", Concat(c_param_type, Concat(" *", c_ref_name))
            );
        }
        if params == "" {
            params = c_param;
        } else {
            params = Concat(params, Concat(", ", c_param));
        }
        if p_mode == 3 {
            ArrayPush(function_env_rows, TypeEnvTypedReadonlyRefBindingRows(
                p_name, p_type, p_binding.value_kind, c_ref_name
            ));
        } else {
            ArrayPush(function_env_rows, p_env_binding.env_rows);
        }
        param_n = param_n + 1;
        ArraySet(cur, 0, cur[0] + 1);
    }

    if param_n != expected_param_count {
        Die("semantic signature parameter count does not match AST traversal");
    }

    if cur[0] >= count || !CodegenAstArenaIsReturns(arena, cur[0]) {
        Die("expected Returns: line after parameters");
    }
    ArraySet(
        env_state, 1, Concat("|", StringJoin(function_env_rows, ""))
    );
    let ret_type: String = CodegenGenericResolvedReturnTypeOrDie(
        signatures, signature_index, generic_actuals
    );
    ArraySet(cur, 0, cur[0] + 1);

    CodegenSemanticCallableContractAdvanceOrDie(
        signatures, signature_index, arena, count, cur
    );
    CodegenAstArenaExpectBody(arena, count, cur);
    CodegenAstArenaExpectBlock(arena, count, cur);
    let stmt_indent: Int = f_indent + 6;
    let is_main: Bool = name == "Main";
    let body_ret: String = ret_type;
    if is_main {
        body_ret = AbiLayoutCEntrypointBodyReturnType();
    }
    let routine_defers: Array<String> = [""];
    let body: String = EmitStmtList(
        count, arena, local_bindings, assignments, statements, body_types,
        expression_surfaces, stmt_indent, cur, "    ",
        env_state, body_ret, routine_defers, copyout
    );

    let signature: String = "";
    let body_full: String = Concat(
        prologue, Concat(body, Concat(routine_defers[0], copyout))
    );
    if is_main {
        body_full = Concat(machine_startup, body_full);
        signature = HostIORuntimeCEntrypointSignature(uses_args);
        if uses_args {
            body_full = Concat(HostIORuntimeCArgsCapturePrefix(), Concat(
                machine_startup, Concat(
                    prologue, Concat(body, Concat(routine_defers[0], copyout))
                )
            ));
        }
    } else {
        let param_list: String = params;
        if params == "" {
            param_list = AbiLayoutCEmptyParameterList();
        }
        signature = Concat(
            AbiLayoutCReturnType(ret_type, base_env),
            Concat(" ", Concat(c_name, Concat("(", Concat(param_list, ")"))))
        );
    }

    let tail: String = "}\n";
    if is_main {
        tail = Concat("    return ", Concat(HostIORuntimeCEntrypointSuccessValue(), ";\n}\n"));
    }
    return Concat(signature, Concat("\n{\n", Concat(body_full, tail)));
}

func EmitFunction(count: Int, arena: AstArena,
                   signatures: SemanticAstFunctionSignatureFacts,
                   roles: SemanticAstRoleFacts,
                   receiver_facts: CodegenCallableReceiverFacts,
                   local_bindings: SemanticAstLocalBindingFacts,
                   assignments: SemanticAstAssignmentFacts,
                   statements: SemanticAstStatementFacts,
                   ref body_types: CodegenSemanticBodyTypeFacts,
                   expression_surfaces: SemanticAstExpressionSurfaceFacts,
                   inout cur: Array<Int>, f_indent: Int,
                   base_env: CodegenTypeEnv, machine_startup: String,
                   uses_args: Bool) -> String {
    let no_actuals: Array<String> = [];
    return EmitFunctionWithSpecialization(
        count, arena, signatures, roles, receiver_facts,
        local_bindings, assignments,
        statements, body_types, expression_surfaces, cur, f_indent,
        base_env, uses_args, machine_startup, "", no_actuals
    );
}

func BuildFunctionEnv(
    signatures: SemanticAstFunctionSignatureFacts,
    specializations: CodegenGenericSpecializationFacts,
    receiver_facts: CodegenCallableReceiverFacts
) -> String {
    let rows: Array<String> = ["|"];
    ArrayPush(rows, CodegenCallableReceiverEnvRows(
        receiver_facts, signatures
    ));
    let builtin_names: Array<String> = [];
    let builtin_returns: Array<String> = [];
    let builtin_params: Array<String> = [];
    if !SeedSemanticBuiltinSignatures(
        builtin_names, builtin_returns, builtin_params
    ) {
        Die("semantic builtin signature facts are invalid");
    }
    let builtin_index: Int = 0;
    while builtin_index < ArrayLength(builtin_names) {
        ArrayPush(rows, Concat(
            builtin_names[builtin_index], Concat(
                "=f:", Concat(builtin_returns[builtin_index], "|")
            )
        ));
        builtin_index = builtin_index + 1;
    }
    ArrayPush(rows, Concat("AllocatorResult=call:", Concat(TextBuilderRuntimeCAllocatorResultFn(), "|")));
    ArrayPush(rows, Concat("AllocatorDestroy=call:", Concat(TextBuilderRuntimeCAllocatorDestroyFn(), "|")));
    ArrayPush(rows, Concat(TextBuilderRuntimeCAllocatorDestroyFn(), "=pm:ref|"));
    ArrayPush(rows, Concat(TextBuilderRuntimeCAllocatorDestroyFn(), "=pt:Allocator|"));
    ArrayPush(rows, Concat("TextBuilderNew=call:", Concat(TextBuilderRuntimeCNewFn(), "|")));
    ArrayPush(rows, Concat("TextBuilderAppend=call:", Concat(TextBuilderRuntimeCAppendFn(), "|")));
    ArrayPush(rows, Concat(TextBuilderRuntimeCAppendFn(), "=pm:inout,default|"));
    ArrayPush(rows, Concat(TextBuilderRuntimeCAppendFn(), "=pt:TextBuilder,String|"));
    ArrayPush(rows, Concat("TextBuilderFinish=call:", Concat(TextBuilderRuntimeCFinishFn(), "|")));
    ArrayPush(rows, Concat(TextBuilderRuntimeCFinishFn(), "=pm:inout,ref|"));
    ArrayPush(rows, Concat(TextBuilderRuntimeCFinishFn(), "=pt:TextBuilder,Allocator|"));
    ArrayPush(rows, Concat("TextBuilderDrop=call:", Concat(TextBuilderRuntimeCDropFn(), "|")));
    ArrayPush(rows, Concat(TextBuilderRuntimeCDropFn(), "=pm:inout|"));
    ArrayPush(rows, Concat(TextBuilderRuntimeCDropFn(), "=pt:TextBuilder|"));
    let i: Int = 0;
    while i < SemanticAstFunctionSignatureCount(signatures) {
        if CodegenSemanticFunctionGenericCountOrDie(signatures, i) > 0 {
            i = i + 1;
            continue;
        }
        let owner: String = CodegenSemanticFunctionOwnerOrDie(signatures, i);
        let fname: String = CodegenSemanticFunctionNameOrDie(signatures, i);
        let cname: String = CompilerSymbolCQualifiedName(owner, fname);
        let modes: String = "";
        let param_types: String = "";
        let param_count: Int = CodegenSemanticFunctionParamCountOrDie(
            signatures, i
        );
        let p: Int = 0;
        while p < param_count {
            modes = ParamModeCsvAppend(
                modes, CodegenSemanticFunctionParamModeOrDie(signatures, i, p)
            );
            param_types = ParamTypeCsvAppend(
                param_types,
                CodegenSemanticFunctionParamTypeOrDie(signatures, i, p)
            );
            p = p + 1;
        }
        ArrayPush(rows, Concat(cname, Concat("=pm:", Concat(modes, "|"))));
        ArrayPush(rows, Concat(cname, Concat("=pt:", Concat(param_types, "|"))));
        let rtype: String = CodegenSemanticFunctionReturnTypeOrDie(signatures, i);
        ArrayPush(rows, Concat(cname, Concat("=f:", Concat(rtype, "|"))));
        if fname != cname {
            ArrayPush(rows, Concat(fname, Concat("=call:", Concat(cname, "|"))));
        }
        let public_alias: String = CompilerSymbolCImportPublicName(cname);
        if StringLength(public_alias) > 0 && public_alias != cname && public_alias != fname {
            ArrayPush(rows, Concat(public_alias, Concat("=call:", Concat(cname, "|"))));
        }
        let local_alias: String = CompilerSymbolCLocalCallName(cname);
        if StringLength(local_alias) > 0 && local_alias != cname &&
            local_alias != fname && local_alias != public_alias {
            ArrayPush(rows, Concat(local_alias, Concat("=call:", Concat(cname, "|"))));
        }
        i = i + 1;
    }
    i = 0;
    while i < CodegenGenericSpecializationCount(specializations) {
        let signature_index: Int = specializations.signature_indexes[i];
        let c_name: String = specializations.c_names[i];
        let actuals: Array<String> =
            CodegenGenericSpecializationActuals(specializations, i);
        let modes: String = "";
        let param_types: String = "";
        let p: Int = 0;
        let param_count: Int = CodegenSemanticFunctionParamCountOrDie(
            signatures, signature_index
        );
        while p < param_count {
            modes = ParamModeCsvAppend(
                modes, CodegenSemanticFunctionParamModeOrDie(
                    signatures, signature_index, p
                )
            );
            param_types = ParamTypeCsvAppend(
                param_types, CodegenGenericResolvedParamTypeOrDie(
                    signatures, signature_index, p, actuals
                )
            );
            p = p + 1;
        }
        ArrayPush(rows, Concat(c_name, Concat("=pm:", Concat(modes, "|"))));
        ArrayPush(rows, Concat(
            c_name, Concat("=pt:", Concat(param_types, "|"))
        ));
        ArrayPush(rows, Concat(
            c_name, Concat("=f:", Concat(
                CodegenGenericResolvedReturnTypeOrDie(
                    signatures, signature_index, actuals
                ), "|"
            ))
        ));
        ArrayPush(rows, Concat(
            c_name, Concat("=rc:", Concat(
                CodegenCallableReceiverCarriageForSignatureOrDie(
                    receiver_facts, signatures, signature_index
                ), "|"
            ))
        ));
        if CodegenCallableReceiverRoleErasedForSignatureOrDie(
            receiver_facts, signatures, signature_index
        ) {
            ArrayPush(rows, Concat(c_name, "=rce:1|"));
        }
        i = i + 1;
    }
    ArrayPush(rows, CodegenGenericSpecializationCallEnvRows(specializations));
    return StringJoin(rows, "");
}

func CollectProtos(signatures: SemanticAstFunctionSignatureFacts,
                   roles: SemanticAstRoleFacts,
                   receiver_facts: CodegenCallableReceiverFacts,
                   struct_env: CodegenTypeEnv,
                   specializations: CodegenGenericSpecializationFacts) -> String {
    let rows: Array<String> = [];
    let i: Int = 0;
    while i < SemanticAstFunctionSignatureCount(signatures) {
        if !CodegenSemanticFunctionRuntimeCallableOrDie(signatures, i) ||
            CodegenSemanticFunctionGenericCountOrDie(signatures, i) > 0 {
            i = i + 1;
            continue;
        }
        let owner: String = CodegenSemanticFunctionOwnerOrDie(signatures, i);
        let name: String = CodegenSemanticFunctionNameOrDie(signatures, i);
        let c_name: String = CompilerSymbolCQualifiedName(owner, name);
        if c_name != "Main" {
            let params: String = "";
            let pn: Int = 0;
            let param_count: Int = CodegenSemanticFunctionParamCountOrDie(
                signatures, i
            );
            let function_node: Int = CodegenSemanticFunctionNodeOrDie(
                signatures, i
            );
            let role_receiver_type: Option<String> =
                CodegenSemanticRoleReceiverType(roles, function_node);
            let receiver_carriage: String =
                CodegenCallableReceiverCarriageForSignatureOrDie(
                    receiver_facts, signatures, i
                );
            let mutable_identity_receiver: Bool =
                receiver_carriage ==
                    CallableReceiverCarriageMutableIdentity() &&
                !IsSome(role_receiver_type);
            let role_declares_self: Bool = false;
            let signature_param_index: Int = 0;
            while signature_param_index < param_count {
                if CodegenSemanticFunctionParamNameOrDie(
                    signatures, i, signature_param_index
                ) == "self" {
                    role_declares_self = true;
                }
                signature_param_index = signature_param_index + 1;
            }
            if IsSome(role_receiver_type) && !role_declares_self {
                params = "void *_pgy_raw_self";
            }
            while pn < param_count {
                let p_mode: Int = CodegenSemanticFunctionParamModeOrDie(
                    signatures, i, pn
                );
                let p_name: String = CodegenSemanticFunctionParamNameOrDie(
                    signatures, i, pn
                );
                let p_type: String = CodegenSemanticFunctionParamTypeOrDie(
                    signatures, i, pn
                );
                let role_receiver_param: Bool = false;
                if p_name == "self" {
                    if IsSome(role_receiver_type) {
                        p_type = UnwrapOption(role_receiver_type);
                        role_receiver_param = true;
                    }
                }
                let c_p_name: String =
                    CodegenFunctionValueBindingFactFor(
                        p_name, p_type, struct_env.global_rows
                    ).c_name;
                let cpt: String = AbiLayoutCParamType(p_type, struct_env);
                let cp: String = Concat(cpt, Concat(" ", c_p_name));
                if p_name == "self" && mutable_identity_receiver {
                    if p_mode != 0 {
                        Die("mutable-identity receiver prototype mode is invalid");
                    }
                    cp = Concat(cpt, Concat(" *", c_p_name));
                } else if role_receiver_param {
                    cp = "void *_pgy_raw_self";
                } else if p_mode == 1 {
                    cp = Concat(cpt, Concat(" *", CompilerSymbolCInoutParamName(p_name)));
                } else if p_mode == 3 {
                    cp = Concat(
                        "const ", Concat(cpt, Concat(
                            " *", CompilerSymbolCReadonlyRefParamName(p_name)
                        ))
                    );
                }
                if params == "" {
                    params = cp;
                } else {
                    params = Concat(params, Concat(", ", cp));
                }
                pn = pn + 1;
            }
            let rtype: String = CodegenSemanticFunctionReturnTypeOrDie(
                signatures, i
            );
            let plist: String = params;
            if params == "" {
                plist = AbiLayoutCEmptyParameterList();
            }
            let sig: String = Concat(AbiLayoutCReturnType(rtype, struct_env), Concat(" ", Concat(c_name, Concat("(", Concat(plist, ")")))));
            ArrayPush(rows, Concat(sig, ";\n"));
        }
        i = i + 1;
    }
    i = 0;
    while i < CodegenGenericSpecializationCount(specializations) {
        let signature_index: Int = specializations.signature_indexes[i];
        let c_name: String = specializations.c_names[i];
        let actuals: Array<String> =
            CodegenGenericSpecializationActuals(specializations, i);
        let params: String = "";
        let pn: Int = 0;
        let param_count: Int = CodegenSemanticFunctionParamCountOrDie(
            signatures, signature_index
        );
        let specialized_carriage: String =
            CodegenCallableReceiverCarriageForSignatureOrDie(
                receiver_facts, signatures, signature_index
            );
        let specialized_role_erased: Bool =
            CodegenCallableReceiverRoleErasedForSignatureOrDie(
                receiver_facts, signatures, signature_index
            );
        while pn < param_count {
            let p_mode: Int = CodegenSemanticFunctionParamModeOrDie(
                signatures, signature_index, pn
            );
            let p_name: String = CodegenSemanticFunctionParamNameOrDie(
                signatures, signature_index, pn
            );
            let p_type: String = CodegenGenericResolvedParamTypeOrDie(
                signatures, signature_index, pn, actuals
            );
            let c_p_name: String = CodegenFunctionValueBindingFactFor(
                p_name, p_type, struct_env.global_rows
            ).c_name;
            let cpt: String = AbiLayoutCParamType(p_type, struct_env);
            let cp: String = Concat(cpt, Concat(" ", c_p_name));
            if p_name == "self" && specialized_role_erased {
                cp = "void *_pgy_raw_self";
            } else if p_name == "self" && specialized_carriage ==
                CallableReceiverCarriageMutableIdentity() {
                if p_mode != 0 {
                    Die("mutable-identity receiver prototype mode is invalid");
                }
                cp = Concat(cpt, Concat(" *", c_p_name));
            } else if p_mode == 1 {
                cp = Concat(cpt, Concat(
                    " *", CompilerSymbolCInoutParamName(p_name)
                ));
            } else if p_mode == 3 {
                cp = Concat("const ", Concat(cpt, Concat(
                    " *", CompilerSymbolCReadonlyRefParamName(p_name)
                )));
            }
            if pn == 0 { params = cp; }
            else { params = Concat(params, Concat(", ", cp)); }
            pn = pn + 1;
        }
        let plist: String = params;
        if pn == 0 { plist = AbiLayoutCEmptyParameterList(); }
        ArrayPush(rows, Concat(
            AbiLayoutCReturnType(
                CodegenGenericResolvedReturnTypeOrDie(
                    signatures, signature_index, actuals
                ), struct_env
            ), Concat(" ", Concat(c_name, Concat("(", Concat(plist, ");\n"))))
        ));
        i = i + 1;
    }
    if ArrayLength(rows) > 0 {
        ArrayPush(rows, "\n");
    }
    return StringJoin(rows, "");
}
