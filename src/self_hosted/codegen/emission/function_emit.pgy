// src/self_hosted/codegen/emission/function_emit.pgy
//
// Function/declaration scan and signature emission owner for self-host C emission.

func NominalDeclPrefixLen(line: String) -> Int {
    if StartsWith(line, "Struct: ") {
        return 8;
    }
    if StartsWith(line, "Class: ") {
        return 7;
    }
    if StartsWith(line, "Subject: ") {
        return 9;
    }
    if StartsWith(line, "Vessel: ") {
        return 8;
    }
    if StartsWith(line, "Object: ") {
        return 8;
    }
    if StartsWith(line, "TObject: ") {
        return 9;
    }
    return -1;
}

func IsNominalDeclLine(line: String) -> Bool {
    return NominalDeclPrefixLen(line) >= 0;
}

func IsZeroArtifactDeclLine(line: String) -> Bool {
    return StartsWith(line, "Ability: ");
}

func IsRoleDeclLine(line: String) -> Bool {
    return StartsWith(line, "Role: ");
}

func RoleForPos(line: String) -> Int {
    return StringIndexOf(line, " for ");
}

func RoleDeclName(line: String) -> String {
    let fp: Int = RoleForPos(line);
    if fp < 0 {
        Die(Concat("malformed role declaration line: ", line));
    }
    return Substring(line, 6, fp - 6);
}

func RoleDeclForType(line: String) -> String {
    let fp: Int = RoleForPos(line);
    if fp < 0 {
        Die(Concat("malformed role declaration line: ", line));
    }
    return Substring(line, fp + 5, StringLength(line) - (fp + 5));
}

func NominalDeclName(line: String) -> String {
    let prefix_len: Int = NominalDeclPrefixLen(line);
    if prefix_len < 0 {
        Die(Concat("expected nominal declaration line: ", line));
    }
    return Substring(line, prefix_len, StringLength(line) - prefix_len);
}

// Emit one function definition starting at the `Function: <Name>` line at
// cur[0]. `base_env` carries the global function return-type bindings.
func EmitFunction(indents: Array<Int>, texts: Array<String>, count: Int,
                  inout cur: Array<Int>, f_indent: Int,
                  base_env: String, uses_args: Bool, owner_name: String) -> String {
    let head: String = texts[cur[0]];
    let name: String = Substring(head, 10, StringLength(head) - 10);
    let c_name: String = SymbolMangleCQualifiedName(owner_name, name);
    ArraySet(cur, 0, cur[0] + 1);

    CodegenAstTextExpect(texts, count, cur, "Parameters:");
    let params: String = "";
    let param_n: Int = 0;
    let env_box: Array<String> = [base_env];
    while cur[0] < count && indents[cur[0]] == f_indent + 4 {
        let pline: String = texts[cur[0]];
        let pc: Int = StringIndexOf(pline, ": ");
        let p_name: String = "";
        let p_type: String = "";
        if pc < 0 && StringLength(owner_name) > 0 && pline == "self" {
            p_name = "self";
            p_type = owner_name;
        } else if pc < 0 {
            Die(Concat("malformed parameter: ", pline));
        } else {
            p_name = Substring(pline, 0, pc);
            p_type = Substring(pline, pc + 2, StringLength(pline) - (pc + 2));
        }
        let c_param: String = Concat(AbiLayoutCParamType(p_type, base_env), Concat(" ", p_name));
        if param_n == 0 {
            params = c_param;
        } else {
            params = Concat(params, Concat(", ", c_param));
        }
        // Register the param under a canonical kind so array indexing/length
        // rewriting recognizes it (`Array<Int...>` -> ArrayInt, etc.).
        let p_kind: String = p_type;
        if StartsWith(p_type, "Array<") {
            if StringIndexOf(p_type, "Int") >= 0 {
                p_kind = "ArrayInt";
            } else if StringIndexOf(p_type, "String") >= 0 {
                p_kind = "ArrayString";
            }
        }
        ArraySet(env_box, 0, Concat(env_box[0], Concat(p_name, Concat("=v:", Concat(p_kind, "|")))));
        param_n = param_n + 1;
        ArraySet(cur, 0, cur[0] + 1);
    }

    if cur[0] >= count || !StartsWith(texts[cur[0]], "Returns:") {
        Die("expected Returns: line after parameters");
    }
    let ret_line: String = texts[cur[0]];
    let ret_type: String = StringTrim(Substring(ret_line, 8, StringLength(ret_line) - 8));
    ArraySet(cur, 0, cur[0] + 1);

    CodegenAstTextExpect(texts, count, cur, "Body:");
    CodegenAstTextExpect(texts, count, cur, "Block:");
    let stmt_indent: Int = f_indent + 6;
    let is_main: Bool = name == "Main";
    // Main lowers to `int main`, so a bare `return` inside it must be `return 0;`
    // -- emit its body with an Int return type.
    let body_ret: String = ret_type;
    if is_main {
        body_ret = "Int";
    }
    let body: String = EmitStmtList(indents, texts, count, stmt_indent, cur, "    ", env_box, body_ret, "");

    let signature: String = "";
    let body_full: String = body;
    if is_main {
        if uses_args {
            // Capture argv into globals so `Args()` (-> pgy_args) can read them.
            signature = "int main(int argc, char **argv)";
            body_full = Concat("    pgy_argc = argc;\n    pgy_argv = argv;\n", body);
        } else {
            signature = "int main(void)";
        }
    } else {
        let param_list: String = params;
        if param_n == 0 {
            param_list = "void";
        }
        signature = Concat(AbiLayoutCReturnType(ret_type, base_env), Concat(" ", Concat(c_name, Concat("(", Concat(param_list, ")")))));
    }

    let tail: String = "}\n";
    if is_main {
        tail = "    return 0;\n}\n";
    }
    return Concat(signature, Concat("\n{\n", Concat(body_full, tail)));
}

// Build the global environment: `|Name=f:RetType|...` for every function, by
// pairing each `Function: Name` line with the next `Returns:` line.
func BuildFunctionEnv(nodes: Array<CodegenAstTextNode>, count: Int) -> String {
    let env: String = "|";
    let i: Int = 0;
    let owner: String = "";
    let owner_indent: Int = -1;
    let skip_indent: Int = -1;
    while i < count {
        let line: String = nodes[i].text;
        let indent: Int = nodes[i].indent;
        if skip_indent >= 0 {
            if indent > skip_indent {
                i = i + 1;
                continue;
            }
            skip_indent = -1;
        }
        if StringLength(owner) > 0 && indent <= owner_indent {
            owner = "";
            owner_indent = -1;
        }
        if IsZeroArtifactDeclLine(line) {
            skip_indent = indent;
            i = i + 1;
            continue;
        }
        if IsNominalDeclLine(line) {
            owner = NominalDeclName(line);
            owner_indent = indent;
        }
        if IsRoleDeclLine(line) {
            owner = RoleDeclName(line);
            owner_indent = indent;
        }
        if StartsWith(line, "Function:") {
            let fname: String = Substring(line, 10, StringLength(line) - 10);
            let cname: String = SymbolMangleCQualifiedName("", fname);
            if StringLength(owner) > 0 && indent > owner_indent {
                cname = SymbolMangleCQualifiedName(owner, fname);
            }
            let j: Int = i + 1;
            let rtype: String = "Void";
            while j < count && !StartsWith(nodes[j].text, "Function:") {
                let ret_line: String = nodes[j].text;
                if StartsWith(ret_line, "Returns:") {
                    rtype = StringTrim(Substring(ret_line, 8, StringLength(ret_line) - 8));
                    j = count;
                } else {
                    j = j + 1;
                }
            }
            env = Concat(env, Concat(cname, Concat("=f:", Concat(rtype, "|"))));
        }
        i = i + 1;
    }
    return env;
}

func CollectRoleOperators(nodes: Array<CodegenAstTextNode>, count: Int, inout env_box: Array<String>) -> String {
    let i: Int = 0;
    while i < count {
        let line: String = nodes[i].text;
        if IsRoleDeclLine(line) {
            let role_name: String = RoleDeclName(line);
            let for_type: String = RoleDeclForType(line);
            let role_indent: Int = nodes[i].indent;
            let j: Int = i + 1;
            while j < count && nodes[j].indent > role_indent {
                let method_line: String = nodes[j].text;
                if StartsWith(method_line, "Function: ") {
                    let mname: String = Substring(method_line, 10, StringLength(method_line) - 10);
                    if for_type == "Int" && mname == "Add" {
                        let c_name: String = SymbolMangleCRoleOperatorName(role_name, "Add");
                        ArraySet(env_box, 0, Concat(env_box[0], Concat("Int+=op:", Concat(c_name, "|"))));
                    }
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return "";
}

// Scan top-level nominal declarations into C typedefs, and append
// `Name=s:struct|Name=fields:a,b|Name.field=field:Type|` entries to env_box[0].
func CollectStructs(nodes: Array<CodegenAstTextNode>, count: Int, inout env_box: Array<String>) -> String {
    let typedefs: String = "";
    let i: Int = 0;
    while i < count {
        let line: String = nodes[i].text;
        if IsNominalDeclLine(line) {
            let sname: String = NominalDeclName(line);
            let s_indent: Int = nodes[i].indent;
            let j: Int = i + 1;
            if j < count && nodes[j].text == "Fields:" {
                j = j + 1;
            }
            let fields_c: String = "";
            let field_names: String = "";
            while j < count && nodes[j].indent == s_indent + 4 {
                let fl: String = nodes[j].text;
                let cpos: Int = StringIndexOf(fl, ": ");
                if cpos < 0 {
                    Die(Concat("malformed struct field: ", fl));
                }
                let fname: String = Substring(fl, 0, cpos);
                let ftype: String = Substring(fl, cpos + 2, StringLength(fl) - (cpos + 2));
                let cfield_type: String = AbiLayoutCFieldType(ftype, env_box[0]);
                if StringLength(field_names) == 0 {
                    field_names = fname;
                } else {
                    field_names = Concat(field_names, Concat(",", fname));
                }
                ArraySet(env_box, 0, Concat(env_box[0], Concat(sname, Concat(".", Concat(fname, Concat("=field:", Concat(ftype, "|")))))));
                fields_c = Concat(fields_c, Concat("    ", Concat(cfield_type, Concat(" ", Concat(fname, ";\n")))));
                j = j + 1;
            }
            typedefs = Concat(typedefs, Concat("typedef struct {\n", Concat(fields_c, Concat("} ", Concat(sname, ";\n\n")))));
            ArraySet(env_box, 0, Concat(env_box[0], Concat(sname, "=s:struct|")));
            ArraySet(env_box, 0, Concat(env_box[0], Concat(sname, Concat("=fields:", Concat(field_names, "|")))));
        }
        i = i + 1;
    }
    return typedefs;
}

func CollectEnums(nodes: Array<CodegenAstTextNode>, count: Int, inout env_box: Array<String>) -> String {
    let block: String = "";
    let i: Int = 0;
    while i < count {
        let line: String = nodes[i].text;
        if StartsWith(line, "Enum: ") {
            let brace: Int = StringIndexOf(line, " { ");
            if brace < 0 || CharAt(line, StringLength(line) - 1) != "}" {
                Die(Concat("malformed enum declaration: ", line));
            }
            let ename: String = Substring(line, 6, brace - 6);
            let inner: String = StringTrim(Substring(line, brace + 3, StringLength(line) - (brace + 4)));
            let value: Int = 0;
            let rem: String = inner;
            let enum_c: String = "enum {\n";
            while StringLength(rem) > 0 {
                let comma: Int = FindTopLevelComma(rem);
                let part: String = "";
                if comma < 0 {
                    part = StringTrim(rem);
                    rem = "";
                } else {
                    part = StringTrim(Substring(rem, 0, comma));
                    rem = StringTrim(Substring(rem, comma + 1, StringLength(rem) - (comma + 1)));
                }
                if StringIndexOf(part, "(") >= 0 {
                    Die(Concat("payload enum variants are not supported in self-host codegen subset: ", part));
                }
                let cname: String = SymbolMangleCEnumVariantName(ename, part);
                enum_c = Concat(enum_c, Concat("    ", Concat(cname, Concat(" = ", Concat(ToString(value), ",\n")))));
                ArraySet(env_box, 0, Concat(env_box[0], Concat(ename, Concat(".", Concat(part, Concat("=e:", Concat(ToString(value), "|")))))));
                value = value + 1;
            }
            enum_c = Concat(enum_c, "};\n\n");
            block = Concat(block, enum_c);
        }
        i = i + 1;
    }
    return block;
}

// Build the C forward-declaration block for every non-Main function, in
// GenerateC's own scope. (A pre-pass is required because Pergyra arrays pass by
// value with a shared element buffer: `ArraySet` mutations persist across calls
// but `ArrayPush` growth does not -- so a callee cannot append to the caller's
// `protos`. Emitting prototypes here makes forward references compile.)
func CollectProtos(nodes: Array<CodegenAstTextNode>, count: Int, struct_env: String) -> String {
    let block: String = "";
    let i: Int = 0;
    let owner: String = "";
    let owner_indent: Int = -1;
    let skip_indent: Int = -1;
    while i < count {
        let line: String = nodes[i].text;
        let indent: Int = nodes[i].indent;
        if skip_indent >= 0 {
            if indent > skip_indent {
                i = i + 1;
                continue;
            }
            skip_indent = -1;
        }
        if StringLength(owner) > 0 && indent <= owner_indent {
            owner = "";
            owner_indent = -1;
        }
        if IsZeroArtifactDeclLine(line) {
            skip_indent = indent;
            i = i + 1;
            continue;
        }
        if IsNominalDeclLine(line) {
            owner = NominalDeclName(line);
            owner_indent = indent;
        }
        if IsRoleDeclLine(line) {
            owner = RoleDeclName(line);
            owner_indent = indent;
        }
        if StartsWith(line, "Function:") {
            let name: String = Substring(line, 10, StringLength(line) - 10);
            let c_name: String = SymbolMangleCQualifiedName(owner, name);
            if c_name != "Main" {
                let f_indent: Int = indent;
                let j: Int = i + 1;
                if j < count && nodes[j].text == "Parameters:" {
                    j = j + 1;
                }
                let params: String = "";
                let pn: Int = 0;
                while j < count && nodes[j].indent == f_indent + 4 {
                    let pl: String = nodes[j].text;
                    let pc: Int = StringIndexOf(pl, ": ");
                    let p_name: String = "";
                    let p_type: String = "";
                    if pc < 0 && StringLength(owner) > 0 && pl == "self" {
                        p_name = "self";
                        p_type = owner;
                    } else if pc < 0 {
                        Die(Concat("malformed parameter: ", pl));
                    } else {
                        p_name = Substring(pl, 0, pc);
                        p_type = Substring(pl, pc + 2, StringLength(pl) - (pc + 2));
                    }
                    let cp: String = Concat(AbiLayoutCParamType(p_type, struct_env), Concat(" ", p_name));
                    if pn == 0 {
                        params = cp;
                    } else {
                        params = Concat(params, Concat(", ", cp));
                    }
                    pn = pn + 1;
                    j = j + 1;
                }
                let rtype: String = "Void";
                if j < count && StartsWith(nodes[j].text, "Returns:") {
                    let ret_line: String = nodes[j].text;
                    rtype = StringTrim(Substring(ret_line, 8, StringLength(ret_line) - 8));
                }
                let plist: String = params;
                if pn == 0 {
                    plist = "void";
                }
                let sig: String = Concat(AbiLayoutCReturnType(rtype, struct_env), Concat(" ", Concat(c_name, Concat("(", Concat(plist, ")")))));
                block = Concat(block, Concat(sig, ";\n"));
            }
        }
        i = i + 1;
    }
    if StringLength(block) > 0 {
        block = Concat(block, "\n");
    }
    return block;
}
