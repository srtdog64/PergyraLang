// src/self_hosted/codegen/emission/function_emit.pgy
//
// Function/declaration scan and signature emission owner for self-host C emission.

import "../text/text_owner.pgy";
import "../input/ast_arena_codegen_view_owner.pgy";
import "../input/ast_text_enum_variant_owner.pgy";
import "../input/semantic_signature_codegen_view_owner.pgy";
import "../input/ast_text_declaration_owner.pgy";
import "../../compiler/symbol_table_owner.pgy";
import "../abi_layout/abi_layout_owner.pgy";
import "../runtime_abi/collection_runtime_owner.pgy";
import "../runtime_abi/host_io_runtime_owner.pgy";
import "../runtime_abi/text_builder_runtime_owner.pgy";
import "stmt_emit.pgy";

func ParamModeCsvAppend(csv: String, mode: Int) -> String {
    let next: String = CodegenAstArenaParamModeName(mode);
    if StringLength(csv) == 0 {
        return next;
    }
    return Concat(csv, Concat(",", next));
}

func ParamTypeCsvAppend(csv: String, type_name: String) -> String {
    if StringLength(csv) == 0 {
        return type_name;
    }
    return Concat(csv, Concat(",", type_name));
}

func CodegenBindingEnvKind(type_name: String, global_env: String) -> String {
    if StartsWith(type_name, "Array<") {
        return CollectionRuntimeKindFromTypeName(type_name);
    }
    if StartsWith(type_name, "Result<") && StringIndexOf(type_name, "Int") >= 0 {
        return "ResultInt";
    }
    if StartsWith(type_name, "Option<") {
        let payload_kind: Int =
            OptionResultRuntimeOptionPayloadKindForType(type_name);
        let option_kind: String =
            OptionResultRuntimeOptionEnvKindForPayloadKind(payload_kind);
        if StringLength(option_kind) > 0 {
            return option_kind;
        }
        if LookupKindTypeRows(global_env, type_name, "s") == "struct" {
            return type_name;
        }
    }
    return type_name;
}

func CodegenFunctionLocalEnvRows(
    local_bindings: SemanticAstLocalBindingFacts,
    function_node_id: Int,
    global_env: String
) -> String {
    let rows: Array<String> = [];
    let i: Int = 0;
    while i < ArrayLength(local_bindings.node_ids) {
        if local_bindings.function_node_ids[i] == function_node_id {
            let type_opt: Option<String> =
                SemanticAstLocalBindingDeclaredTypeAt(local_bindings, i);
            if !IsSome(type_opt) {
                Die("self-host codegen requires a semantic declared local type");
            }
            let source_name: String = local_bindings.names[i];
            let type_name: String = UnwrapOption(type_opt);
            ArrayPush(rows, TypeEnvValueBindingRows(
                source_name,
                CodegenBindingEnvKind(type_name, global_env),
                CompilerSymbolCBindingName(source_name)
            ));
        }
        i = i + 1;
    }
    return StringJoin(rows, "");
}

// Emit one function definition starting at the `Function: <Name>` line at
// cur[0]. `base_env` carries the global function return-type bindings.
func EmitFunction(count: Int, arena: AstArena,
                  signatures: SemanticAstFunctionSignatureFacts,
                  local_bindings: SemanticAstLocalBindingFacts,
                  assignments: SemanticAstAssignmentFacts,
                  statements: SemanticAstStatementFacts,
                  inout cur: Array<Int>, f_indent: Int,
                  base_env: CodegenTypeEnv, uses_args: Bool) -> String {
    let function_node_id: Int = cur[0];
    let signature_index: Int = CodegenSemanticSignatureIndexOrDie(
        signatures, function_node_id
    );
    let owner_name: String = CodegenSemanticFunctionOwnerOrDie(
        signatures, signature_index
    );
    let name: String = CodegenSemanticFunctionNameOrDie(
        signatures, signature_index
    );
    let c_name: String = CompilerSymbolCQualifiedName(owner_name, name);
    ArraySet(cur, 0, cur[0] + 1);

    CodegenAstArenaExpectParameters(arena, count, cur);
    let params: String = "";
    let param_n: Int = 0;
    let expected_param_count: Int = CodegenSemanticFunctionParamCountOrDie(
        signatures, signature_index
    );
    let function_env_rows: Array<String> = [];
    let env_state: Array<String> = [base_env.global_rows, ""];
    let prologue: String = "";
    let copyout: String = "";
    while cur[0] < count && CodegenAstArenaIndentOrDie(arena, cur[0]) == f_indent + 4 {
        let p_mode: Int = CodegenSemanticFunctionParamModeOrDie(
            signatures, signature_index, param_n
        );
        let p_name: String = CodegenSemanticFunctionParamNameForNodeOrDie(
            signatures, signature_index, param_n, cur[0]
        );
        let c_p_name: String = CompilerSymbolCBindingName(p_name);
        let p_type: String = CodegenSemanticFunctionParamTypeOrDie(
            signatures, signature_index, param_n
        );
        let c_param_type: String = AbiLayoutCParamType(p_type, base_env);
        let c_param: String = Concat(c_param_type, Concat(" ", c_p_name));
        let c_ref_name: String = c_p_name;
        if p_mode == 1 {
            let inout_name: String = CompilerSymbolCInoutParamName(p_name);
            c_param = Concat(c_param_type, Concat(" *", inout_name));
            prologue = Concat(prologue, Concat("    ", Concat(c_param_type, Concat(" ", Concat(c_p_name, Concat(" = *", Concat(inout_name, ";\n")))))));
            copyout = Concat(copyout, Concat("    *", Concat(inout_name, Concat(" = ", Concat(c_p_name, ";\n")))));
        } else if p_mode == 3 {
            c_ref_name = CompilerSymbolCReadonlyRefParamName(p_name);
            c_param = Concat(
                "const ", Concat(c_param_type, Concat(" *", c_ref_name))
            );
        }
        if param_n == 0 {
            params = c_param;
        } else {
            params = Concat(params, Concat(", ", c_param));
        }
        // Register the param under a canonical kind so array indexing/length
        // rewriting recognizes it (`Array<Int...>` -> ArrayInt, etc.).
        let p_kind: String = p_type;
        if StartsWith(p_type, "Array<") {
            p_kind = CollectionRuntimeKindFromTypeName(p_type);
        }
        if p_mode == 3 {
            ArrayPush(function_env_rows, TypeEnvReadonlyRefBindingRows(
                p_name, p_kind, c_ref_name
            ));
        } else {
            ArrayPush(function_env_rows, TypeEnvValueBindingRows(
                p_name, p_kind, c_p_name
            ));
        }
        param_n = param_n + 1;
        ArraySet(cur, 0, cur[0] + 1);
    }

    if param_n != expected_param_count {
        Die("semantic signature parameter count does not match AST traversal");
    }

    if cur[0] >= count || !CodegenAstArenaIsReturns(arena, cur[0]) {
        Die("expected Returns: line after parameters");
    }
    ArrayPush(function_env_rows, CodegenFunctionLocalEnvRows(
        local_bindings, function_node_id, base_env.global_rows
    ));
    ArraySet(
        env_state, 1, Concat("|", StringJoin(function_env_rows, ""))
    );
    let ret_type: String = CodegenSemanticFunctionReturnTypeOrDie(
        signatures, signature_index
    );
    ArraySet(cur, 0, cur[0] + 1);

    CodegenAstArenaExpectBody(arena, count, cur);
    CodegenAstArenaExpectBlock(arena, count, cur);
    let stmt_indent: Int = f_indent + 6;
    let is_main: Bool = name == "Main";
    // Main lowers through the host/process entrypoint ABI. Its body still uses
    // the Int return lane so bare `Return:` emits the C success value.
    let body_ret: String = ret_type;
    if is_main {
        body_ret = AbiLayoutCEntrypointBodyReturnType();
    }
    let body: String = EmitStmtList(
        count, arena, local_bindings, assignments, statements, stmt_indent,
        cur, "    ", env_state, body_ret, copyout
    );

    let signature: String = "";
    let body_full: String = Concat(prologue, Concat(body, copyout));
    if is_main {
        signature = HostIORuntimeCEntrypointSignature(uses_args);
        if uses_args {
            body_full = Concat(HostIORuntimeCArgsCapturePrefix(), Concat(prologue, Concat(body, copyout)));
        }
    } else {
        let param_list: String = params;
        if param_n == 0 {
            param_list = AbiLayoutCEmptyParameterList();
        }
        signature = Concat(
            AbiLayoutCReturnType(ret_type, base_env),
            Concat(" ", Concat(c_name, Concat("(", Concat(param_list, ")"))))
        );
    }

    let tail: String = "}\n";
    if is_main {
        tail = Concat("    return ", Concat(HostIORuntimeCEntrypointSuccessValue(), ";\n}\n"));
    }
    return Concat(signature, Concat("\n{\n", Concat(body_full, tail)));
}

// Project semantic signature facts into the C emitter's compact type env.
func BuildFunctionEnv(signatures: SemanticAstFunctionSignatureFacts) -> String {
    let rows: Array<String> = ["|"];
    ArrayPush(rows, Concat("AllocatorResult=call:", Concat(TextBuilderRuntimeCAllocatorResultFn(), "|")));
    ArrayPush(rows, Concat("AllocatorDestroy=call:", Concat(TextBuilderRuntimeCAllocatorDestroyFn(), "|")));
    ArrayPush(rows, Concat(TextBuilderRuntimeCAllocatorDestroyFn(), "=pm:ref|"));
    ArrayPush(rows, Concat(TextBuilderRuntimeCAllocatorDestroyFn(), "=pt:Allocator|"));
    ArrayPush(rows, Concat("TextBuilderNew=call:", Concat(TextBuilderRuntimeCNewFn(), "|")));
    ArrayPush(rows, Concat("TextBuilderAppend=call:", Concat(TextBuilderRuntimeCAppendFn(), "|")));
    ArrayPush(rows, Concat(TextBuilderRuntimeCAppendFn(), "=pm:inout,default|"));
    ArrayPush(rows, Concat(TextBuilderRuntimeCAppendFn(), "=pt:TextBuilder,String|"));
    ArrayPush(rows, Concat("TextBuilderFinish=call:", Concat(TextBuilderRuntimeCFinishFn(), "|")));
    ArrayPush(rows, Concat(TextBuilderRuntimeCFinishFn(), "=pm:inout,ref|"));
    ArrayPush(rows, Concat(TextBuilderRuntimeCFinishFn(), "=pt:TextBuilder,Allocator|"));
    ArrayPush(rows, Concat("TextBuilderDrop=call:", Concat(TextBuilderRuntimeCDropFn(), "|")));
    ArrayPush(rows, Concat(TextBuilderRuntimeCDropFn(), "=pm:inout|"));
    ArrayPush(rows, Concat(TextBuilderRuntimeCDropFn(), "=pt:TextBuilder|"));
    let i: Int = 0;
    while i < SemanticAstFunctionSignatureCount(signatures) {
        if !CodegenSemanticFunctionRuntimeCallableOrDie(signatures, i) {
            i = i + 1;
            continue;
        }
        let owner: String = CodegenSemanticFunctionOwnerOrDie(signatures, i);
        let fname: String = CodegenSemanticFunctionNameOrDie(signatures, i);
        let cname: String = CompilerSymbolCQualifiedName(owner, fname);
        let modes: String = "";
        let param_types: String = "";
        let param_count: Int = CodegenSemanticFunctionParamCountOrDie(
            signatures, i
        );
        let p: Int = 0;
        while p < param_count {
            modes = ParamModeCsvAppend(
                modes, CodegenSemanticFunctionParamModeOrDie(signatures, i, p)
            );
            param_types = ParamTypeCsvAppend(
                param_types,
                CodegenSemanticFunctionParamTypeOrDie(signatures, i, p)
            );
            p = p + 1;
        }
        ArrayPush(rows, Concat(cname, Concat("=pm:", Concat(modes, "|"))));
        ArrayPush(rows, Concat(cname, Concat("=pt:", Concat(param_types, "|"))));
        let rtype: String = CodegenSemanticFunctionReturnTypeOrDie(signatures, i);
        ArrayPush(rows, Concat(cname, Concat("=f:", Concat(rtype, "|"))));
        if fname != cname {
            ArrayPush(rows, Concat(fname, Concat("=call:", Concat(cname, "|"))));
        }
        let public_alias: String = CompilerSymbolCImportPublicName(cname);
        if StringLength(public_alias) > 0 && public_alias != cname && public_alias != fname {
            ArrayPush(rows, Concat(public_alias, Concat("=call:", Concat(cname, "|"))));
        }
        let local_alias: String = CompilerSymbolCLocalCallName(cname);
        if StringLength(local_alias) > 0 && local_alias != cname &&
            local_alias != fname && local_alias != public_alias {
            ArrayPush(rows, Concat(local_alias, Concat("=call:", Concat(cname, "|"))));
        }
        i = i + 1;
    }
    return StringJoin(rows, "");
}

func CollectRoleOperators(count: Int, arena: AstArena,
                          signatures: SemanticAstFunctionSignatureFacts,
                          inout env_box: Array<String>) -> String {
    let rows: Array<String> = [];
    let i: Int = 0;
    while i < count {
        if CodegenAstArenaIsRoleDecl(arena, i) {
            let role_name: String = CodegenAstArenaRoleNameOrDie(arena, i);
            let for_type: String = CodegenAstArenaRoleTargetTypeNameOrDie(arena, i);
            let j: Int = i + 1;
            while j < count && CodegenAstArenaIsDescendantOf(arena, j, i) {
                if CodegenAstArenaIsFunction(arena, j) {
                    let signature_index: Int = CodegenSemanticSignatureIndexOrDie(
                        signatures, j
                    );
                    let mname: String = CodegenSemanticFunctionNameOrDie(
                        signatures, signature_index
                    );
                    if for_type == "Int" && mname == "Add" {
                        let c_name: String = CompilerSymbolCRoleOperatorName(role_name, "Add");
                        ArrayPush(rows, Concat("Int+=op:", Concat(c_name, "|")));
                    }
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    if ArrayLength(rows) > 0 {
        ArraySet(env_box, 0, Concat(env_box[0], StringJoin(rows, "")));
    }
    return "";
}

// Scan top-level nominal declarations into C typedefs, and append
// `Name=s:struct|Name=fields:a,b|Name.field=field:Type|` entries to env_box[0].
func CollectStructs(count: Int, arena: AstArena, inout env_box: Array<String>) -> String {
    let typedefs: Array<String> = [];
    let i: Int = 0;
    while i < count {
        if CodegenAstArenaIsNominalDecl(arena, i) {
            let struct_env_rows: Array<String> = [];
            let sname: String = CodegenAstArenaNominalNameOrDie(arena, i);
            let c_sname: String = AbiLayoutCStructTypeName(sname);
            let s_indent: Int = CodegenAstArenaIndentOrDie(arena, i);
            let j: Int = i + 1;
            if j < count && CodegenAstArenaIsFieldsHeader(arena, j) {
                j = j + 1;
            }
            let fields_c: Array<String> = [];
            let field_names: Array<String> = [];
            while j < count && CodegenAstArenaIndentOrDie(arena, j) == s_indent + 4 {
                let fname: String = CodegenAstArenaFieldNameOrDie(arena, j);
                let ftype: String = CodegenAstArenaFieldTypeNameOrDie(arena, j);
                let cfield_type: String = AbiLayoutCFieldType(
                    ftype, CodegenTypeEnv(env_box[0], "")
                );
                let c_fname: String = CompilerSymbolCFieldName(fname);
                ArrayPush(field_names, fname);
                ArrayPush(struct_env_rows, Concat(sname, Concat(".", Concat(fname, Concat("=field:", Concat(ftype, "|"))))));
                ArrayPush(fields_c, Concat("    ", Concat(cfield_type, Concat(" ", Concat(c_fname, ";\n")))));
                j = j + 1;
            }
            ArrayPush(typedefs, Concat("typedef struct {\n", Concat(StringJoin(fields_c, ""), Concat("} ", Concat(c_sname, ";\n\n")))));
            ArrayPush(struct_env_rows, Concat(sname, "=s:struct|"));
            ArrayPush(struct_env_rows, Concat(sname, Concat("=fields:", Concat(StringJoin(field_names, ","), "|"))));
            ArraySet(env_box, 0, Concat(env_box[0], StringJoin(struct_env_rows, "")));
        }
        i = i + 1;
    }
    return StringJoin(typedefs, "");
}

func CollectEnums(count: Int, arena: AstArena, inout env_box: Array<String>) -> String {
    let blocks: Array<String> = [];
    let env_rows: Array<String> = [];
    let i: Int = 0;
    while i < count {
        if CodegenAstArenaIsEnumDecl(arena, i) {
            let ename: String = CodegenAstArenaEnumNameOrDie(arena, i);
            let variant_total: Int = CodegenAstArenaEnumVariantCount(arena, i);
            let value: Int = 0;
            let enum_rows: Array<String> = ["enum {\n"];
            ArrayPush(env_rows, Concat(ename, "=enum:payload_free|"));
            while value < variant_total {
                let part: String = CodegenAstArenaEnumVariantNameAt(arena, i, value);
                let cname: String = CompilerSymbolCEnumVariantName(ename, part);
                ArrayPush(enum_rows, Concat("    ", Concat(cname, Concat(" = ", Concat(ToString(value), ",\n")))));
                ArrayPush(env_rows, Concat(ename, Concat(".", Concat(part, Concat("=e:", Concat(ToString(value), "|"))))));
                value = value + 1;
            }
            ArrayPush(enum_rows, "};\n\n");
            ArrayPush(blocks, StringJoin(enum_rows, ""));
        }
        i = i + 1;
    }
    if ArrayLength(env_rows) > 0 {
        ArraySet(env_box, 0, Concat(env_box[0], StringJoin(env_rows, "")));
    }
    return StringJoin(blocks, "");
}

// Build the C forward-declaration block for every non-Main function, in
// GenerateC's own scope. (A pre-pass is required because Pergyra arrays pass by
// value with a shared element buffer: `ArraySet` mutations persist across calls
// but `ArrayPush` growth does not -- so a callee cannot append to the caller's
// `protos`. Emitting prototypes here makes forward references compile.)
func CollectProtos(signatures: SemanticAstFunctionSignatureFacts,
                   struct_env: CodegenTypeEnv) -> String {
    let rows: Array<String> = [];
    let i: Int = 0;
    while i < SemanticAstFunctionSignatureCount(signatures) {
        if !CodegenSemanticFunctionRuntimeCallableOrDie(signatures, i) {
            i = i + 1;
            continue;
        }
        let owner: String = CodegenSemanticFunctionOwnerOrDie(signatures, i);
        let name: String = CodegenSemanticFunctionNameOrDie(signatures, i);
        let c_name: String = CompilerSymbolCQualifiedName(owner, name);
        if c_name != "Main" {
            let params: String = "";
            let pn: Int = 0;
            let param_count: Int = CodegenSemanticFunctionParamCountOrDie(
                signatures, i
            );
            while pn < param_count {
                let p_mode: Int = CodegenSemanticFunctionParamModeOrDie(
                    signatures, i, pn
                );
                let p_name: String = CodegenSemanticFunctionParamNameOrDie(
                    signatures, i, pn
                );
                let c_p_name: String = CompilerSymbolCBindingName(p_name);
                let p_type: String = CodegenSemanticFunctionParamTypeOrDie(
                    signatures, i, pn
                );
                let cpt: String = AbiLayoutCParamType(p_type, struct_env);
                let cp: String = Concat(cpt, Concat(" ", c_p_name));
                if p_mode == 1 {
                    cp = Concat(cpt, Concat(" *", CompilerSymbolCInoutParamName(p_name)));
                } else if p_mode == 3 {
                    cp = Concat(
                        "const ", Concat(cpt, Concat(
                            " *", CompilerSymbolCReadonlyRefParamName(p_name)
                        ))
                    );
                }
                if pn == 0 {
                    params = cp;
                } else {
                    params = Concat(params, Concat(", ", cp));
                }
                pn = pn + 1;
            }
            let rtype: String = CodegenSemanticFunctionReturnTypeOrDie(
                signatures, i
            );
            let plist: String = params;
            if pn == 0 {
                plist = AbiLayoutCEmptyParameterList();
            }
            let sig: String = Concat(AbiLayoutCReturnType(rtype, struct_env), Concat(" ", Concat(c_name, Concat("(", Concat(plist, ")")))));
            ArrayPush(rows, Concat(sig, ";\n"));
        }
        i = i + 1;
    }
    if ArrayLength(rows) > 0 {
        ArrayPush(rows, "\n");
    }
    return StringJoin(rows, "");
}
