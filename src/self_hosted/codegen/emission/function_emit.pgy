// src/self_hosted/codegen/emission/function_emit.pgy
//
// Function/declaration scan and signature emission owner for self-host C emission.

import "../text/text_owner.pgy";
import "../input/ast_arena_codegen_view_owner.pgy";
import "../input/ast_text_enum_variant_owner.pgy";
import "../input/ast_text_function_signature_owner.pgy";
import "../input/ast_text_declaration_owner.pgy";
import "../../compiler/symbol_table_owner.pgy";
import "../abi_layout/abi_layout_owner.pgy";
import "../runtime_abi/collection_runtime_owner.pgy";
import "../runtime_abi/host_io_runtime_owner.pgy";
import "stmt_emit.pgy";

func ParamModeCsvAppend(csv: String, mode: Int) -> String {
    let next: String = CodegenAstArenaParamModeName(mode);
    if StringLength(csv) == 0 {
        return next;
    }
    return Concat(csv, Concat(",", next));
}

func ParamTypeCsvAppend(csv: String, type_name: String) -> String {
    if StringLength(csv) == 0 {
        return type_name;
    }
    return Concat(csv, Concat(",", type_name));
}

// Emit one function definition starting at the `Function: <Name>` line at
// cur[0]. `base_env` carries the global function return-type bindings.
func EmitFunction(count: Int, arena: AstArena, inout cur: Array<Int>, f_indent: Int,
                  base_env: String, uses_args: Bool, owner_name: String) -> String {
    let signature_context: CodegenFunctionSignatureContext = CodegenFunctionSignatureContextFor(owner_name);
    let name: String = CodegenAstArenaFunctionNameOrDie(arena, cur[0]);
    let c_name: String = CompilerSymbolCQualifiedName(owner_name, name);
    ArraySet(cur, 0, cur[0] + 1);

    CodegenAstArenaExpectParameters(arena, count, cur);
    let params: String = "";
    let param_n: Int = 0;
    let env_box: Array<String> = [base_env];
    let prologue: String = "";
    let copyout: String = "";
    while cur[0] < count && CodegenAstArenaIndentOrDie(arena, cur[0]) == f_indent + 4 {
        let p_mode: Int = CodegenAstArenaParamModeOrDie(arena, cur[0]);
        if p_mode == 2 || p_mode == 3 {
            Die(Concat("unsupported self-host codegen parameter mode: ", CodegenAstArenaProvenanceOrDie(arena, cur[0])));
        }
        let p_name: String = CodegenAstArenaParamNameOrDie(arena, cur[0]);
        let c_p_name: String = CompilerSymbolCBindingName(p_name);
        let p_type: String = CodegenAstArenaParamTypeNameOrDie(arena, cur[0], signature_context);
        let c_param_type: String = AbiLayoutCParamType(p_type, base_env);
        let c_param: String = Concat(c_param_type, Concat(" ", c_p_name));
        if p_mode == 1 {
            let inout_name: String = CompilerSymbolCInoutParamName(p_name);
            c_param = Concat(c_param_type, Concat(" *", inout_name));
            prologue = Concat(prologue, Concat("    ", Concat(c_param_type, Concat(" ", Concat(c_p_name, Concat(" = *", Concat(inout_name, ";\n")))))));
            copyout = Concat(copyout, Concat("    *", Concat(inout_name, Concat(" = ", Concat(c_p_name, ";\n")))));
        }
        if param_n == 0 {
            params = c_param;
        } else {
            params = Concat(params, Concat(", ", c_param));
        }
        // Register the param under a canonical kind so array indexing/length
        // rewriting recognizes it (`Array<Int...>` -> ArrayInt, etc.).
        let p_kind: String = p_type;
        if StartsWith(p_type, "Array<") {
            p_kind = CollectionRuntimeKindFromTypeName(p_type);
        }
        ArraySet(env_box, 0, TypeEnvAppendValueBinding(env_box[0], p_name, p_kind, c_p_name));
        param_n = param_n + 1;
        ArraySet(cur, 0, cur[0] + 1);
    }

    if cur[0] >= count || !CodegenAstArenaIsReturns(arena, cur[0]) {
        Die("expected Returns: line after parameters");
    }
    let ret_type: String = CodegenAstArenaReturnTypeNameOrDie(arena, cur[0]);
    ArraySet(cur, 0, cur[0] + 1);

    CodegenAstArenaExpectBody(arena, count, cur);
    CodegenAstArenaExpectBlock(arena, count, cur);
    let stmt_indent: Int = f_indent + 6;
    let is_main: Bool = name == "Main";
    // Main lowers through the host/process entrypoint ABI. Its body still uses
    // the Int return lane so bare `Return:` emits the C success value.
    let body_ret: String = ret_type;
    if is_main {
        body_ret = AbiLayoutCEntrypointBodyReturnType();
    }
    let body: String = EmitStmtList(count, arena, stmt_indent, cur, "    ", env_box, body_ret, copyout);

    let signature: String = "";
    let body_full: String = Concat(prologue, Concat(body, copyout));
    if is_main {
        signature = HostIORuntimeCEntrypointSignature(uses_args);
        if uses_args {
            body_full = Concat(HostIORuntimeCArgsCapturePrefix(), Concat(prologue, Concat(body, copyout)));
        }
    } else {
        let param_list: String = params;
        if param_n == 0 {
            param_list = AbiLayoutCEmptyParameterList();
        }
        signature = Concat(AbiLayoutCReturnType(ret_type, base_env), Concat(" ", Concat(c_name, Concat("(", Concat(param_list, ")")))));
    }

    let tail: String = "}\n";
    if is_main {
        tail = Concat("    return ", Concat(HostIORuntimeCEntrypointSuccessValue(), ";\n}\n"));
    }
    return Concat(signature, Concat("\n{\n", Concat(body_full, tail)));
}

// Build the global environment: `|Name=f:RetType|...` for every function, by
// pairing each `Function: Name` line with the next `Returns:` line.
func BuildFunctionEnv(count: Int, arena: AstArena) -> String {
    let env: String = "|";
    let i: Int = 0;
    let owner: String = "";
    let owner_indent: Int = -1;
    let skip_indent: Int = -1;
    while i < count {
        let indent: Int = CodegenAstArenaIndentOrDie(arena, i);
        if skip_indent >= 0 {
            if indent > skip_indent {
                i = i + 1;
                continue;
            }
            skip_indent = -1;
        }
        if StringLength(owner) > 0 && indent <= owner_indent {
            owner = "";
            owner_indent = -1;
        }
        if CodegenAstArenaIsZeroArtifactDecl(arena, i) {
            skip_indent = indent;
            i = i + 1;
            continue;
        }
        if CodegenAstArenaIsNominalDecl(arena, i) {
            owner = CodegenAstArenaNominalNameOrDie(arena, i);
            owner_indent = indent;
        }
        if CodegenAstArenaIsRoleDecl(arena, i) {
            owner = CodegenAstArenaRoleNameOrDie(arena, i);
            owner_indent = indent;
        }
        if CodegenAstArenaIsFunction(arena, i) {
            let fname: String = CodegenAstArenaFunctionNameOrDie(arena, i);
            let signature_context: CodegenFunctionSignatureContext = CodegenFunctionSignatureContextFor(owner);
            let cname: String = CompilerSymbolCQualifiedName("", fname);
            if StringLength(owner) > 0 && indent > owner_indent {
                cname = CompilerSymbolCQualifiedName(owner, fname);
            }
            let j: Int = i + 1;
            let rtype: String = "Void";
            while j < count && !CodegenAstArenaIsFunction(arena, j) {
                if CodegenAstArenaIsParameters(arena, j) {
                    j = j + 1;
                    let modes: String = "";
                    let param_types: String = "";
                    while j < count && CodegenAstArenaIndentOrDie(arena, j) == indent + 4 {
                        modes = ParamModeCsvAppend(modes, CodegenAstArenaParamModeOrDie(arena, j));
                        param_types = ParamTypeCsvAppend(param_types, CodegenAstArenaParamTypeNameOrDie(arena, j, signature_context));
                        j = j + 1;
                    }
                    env = Concat(env, Concat(cname, Concat("=pm:", Concat(modes, "|"))));
                    env = Concat(env, Concat(cname, Concat("=pt:", Concat(param_types, "|"))));
                    continue;
                }
                if CodegenAstArenaIsReturns(arena, j) {
                    rtype = CodegenAstArenaReturnTypeNameOrDie(arena, j);
                    j = count;
                } else {
                    j = j + 1;
                }
            }
            env = Concat(env, Concat(cname, Concat("=f:", Concat(rtype, "|"))));
            if fname != cname {
                env = Concat(env, Concat(fname, Concat("=call:", Concat(cname, "|"))));
            }
            let public_alias: String = CompilerSymbolCImportPublicName(cname);
            if StringLength(public_alias) > 0 && public_alias != cname && public_alias != fname {
                env = Concat(env, Concat(public_alias, Concat("=call:", Concat(cname, "|"))));
            }
            let local_alias: String = CompilerSymbolCLocalCallName(cname);
            if StringLength(local_alias) > 0 && local_alias != cname &&
                local_alias != fname && local_alias != public_alias {
                env = Concat(env, Concat(local_alias, Concat("=call:", Concat(cname, "|"))));
            }
        }
        i = i + 1;
    }
    return env;
}

func CollectRoleOperators(count: Int, arena: AstArena, inout env_box: Array<String>) -> String {
    let i: Int = 0;
    while i < count {
        if CodegenAstArenaIsRoleDecl(arena, i) {
            let role_name: String = CodegenAstArenaRoleNameOrDie(arena, i);
            let for_type: String = CodegenAstArenaRoleTargetTypeNameOrDie(arena, i);
            let j: Int = i + 1;
            while j < count && CodegenAstArenaIsDescendantOf(arena, j, i) {
                if CodegenAstArenaIsFunction(arena, j) {
                    let mname: String = CodegenAstArenaFunctionNameOrDie(arena, j);
                    if for_type == "Int" && mname == "Add" {
                        let c_name: String = CompilerSymbolCRoleOperatorName(role_name, "Add");
                        ArraySet(env_box, 0, Concat(env_box[0], Concat("Int+=op:", Concat(c_name, "|"))));
                    }
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return "";
}

// Scan top-level nominal declarations into C typedefs, and append
// `Name=s:struct|Name=fields:a,b|Name.field=field:Type|` entries to env_box[0].
func CollectStructs(count: Int, arena: AstArena, inout env_box: Array<String>) -> String {
    let typedefs: String = "";
    let i: Int = 0;
    while i < count {
        if CodegenAstArenaIsNominalDecl(arena, i) {
            let sname: String = CodegenAstArenaNominalNameOrDie(arena, i);
            let c_sname: String = AbiLayoutCStructTypeName(sname);
            let s_indent: Int = CodegenAstArenaIndentOrDie(arena, i);
            let j: Int = i + 1;
            if j < count && CodegenAstArenaIsFieldsHeader(arena, j) {
                j = j + 1;
            }
            let fields_c: String = "";
            let field_names: String = "";
            while j < count && CodegenAstArenaIndentOrDie(arena, j) == s_indent + 4 {
                let fname: String = CodegenAstArenaFieldNameOrDie(arena, j);
                let ftype: String = CodegenAstArenaFieldTypeNameOrDie(arena, j);
                let cfield_type: String = AbiLayoutCFieldType(ftype, env_box[0]);
                let c_fname: String = CompilerSymbolCFieldName(fname);
                if StringLength(field_names) == 0 {
                    field_names = fname;
                } else {
                    field_names = Concat(field_names, Concat(",", fname));
                }
                ArraySet(env_box, 0, Concat(env_box[0], Concat(sname, Concat(".", Concat(fname, Concat("=field:", Concat(ftype, "|")))))));
                fields_c = Concat(fields_c, Concat("    ", Concat(cfield_type, Concat(" ", Concat(c_fname, ";\n")))));
                j = j + 1;
            }
            typedefs = Concat(typedefs, Concat("typedef struct {\n", Concat(fields_c, Concat("} ", Concat(c_sname, ";\n\n")))));
            ArraySet(env_box, 0, Concat(env_box[0], Concat(sname, "=s:struct|")));
            ArraySet(env_box, 0, Concat(env_box[0], Concat(sname, Concat("=fields:", Concat(field_names, "|")))));
        }
        i = i + 1;
    }
    return typedefs;
}

func CollectEnums(count: Int, arena: AstArena, inout env_box: Array<String>) -> String {
    let block: String = "";
    let i: Int = 0;
    while i < count {
        if CodegenAstArenaIsEnumDecl(arena, i) {
            let ename: String = CodegenAstArenaEnumNameOrDie(arena, i);
            let variant_total: Int = CodegenAstArenaEnumVariantCount(arena, i);
            let value: Int = 0;
            let enum_c: String = "enum {\n";
            ArraySet(env_box, 0, Concat(env_box[0], Concat(ename, "=enum:payload_free|")));
            while value < variant_total {
                let part: String = CodegenAstArenaEnumVariantNameAt(arena, i, value);
                let cname: String = CompilerSymbolCEnumVariantName(ename, part);
                enum_c = Concat(enum_c, Concat("    ", Concat(cname, Concat(" = ", Concat(ToString(value), ",\n")))));
                ArraySet(env_box, 0, Concat(env_box[0], Concat(ename, Concat(".", Concat(part, Concat("=e:", Concat(ToString(value), "|")))))));
                value = value + 1;
            }
            enum_c = Concat(enum_c, "};\n\n");
            block = Concat(block, enum_c);
        }
        i = i + 1;
    }
    return block;
}

// Build the C forward-declaration block for every non-Main function, in
// GenerateC's own scope. (A pre-pass is required because Pergyra arrays pass by
// value with a shared element buffer: `ArraySet` mutations persist across calls
// but `ArrayPush` growth does not -- so a callee cannot append to the caller's
// `protos`. Emitting prototypes here makes forward references compile.)
func CollectProtos(count: Int, arena: AstArena, struct_env: String) -> String {
    let block: String = "";
    let i: Int = 0;
    let owner: String = "";
    let owner_indent: Int = -1;
    let skip_indent: Int = -1;
    while i < count {
        let indent: Int = CodegenAstArenaIndentOrDie(arena, i);
        if skip_indent >= 0 {
            if indent > skip_indent {
                i = i + 1;
                continue;
            }
            skip_indent = -1;
        }
        if StringLength(owner) > 0 && indent <= owner_indent {
            owner = "";
            owner_indent = -1;
        }
        if CodegenAstArenaIsZeroArtifactDecl(arena, i) {
            skip_indent = indent;
            i = i + 1;
            continue;
        }
        if CodegenAstArenaIsNominalDecl(arena, i) {
            owner = CodegenAstArenaNominalNameOrDie(arena, i);
            owner_indent = indent;
        }
        if CodegenAstArenaIsRoleDecl(arena, i) {
            owner = CodegenAstArenaRoleNameOrDie(arena, i);
            owner_indent = indent;
        }
        if CodegenAstArenaIsFunction(arena, i) {
            let name: String = CodegenAstArenaFunctionNameOrDie(arena, i);
            let signature_context: CodegenFunctionSignatureContext = CodegenFunctionSignatureContextFor(owner);
            let c_name: String = CompilerSymbolCQualifiedName(owner, name);
            if c_name != "Main" {
                let f_indent: Int = indent;
                let j: Int = i + 1;
                if j < count && CodegenAstArenaIsParameters(arena, j) {
                    j = j + 1;
                }
                let params: String = "";
                let pn: Int = 0;
                while j < count && CodegenAstArenaIndentOrDie(arena, j) == f_indent + 4 {
                    let p_mode: Int = CodegenAstArenaParamModeOrDie(arena, j);
                    if p_mode == 2 || p_mode == 3 {
                        Die(Concat("unsupported self-host codegen parameter mode: ", CodegenAstArenaProvenanceOrDie(arena, j)));
                    }
                    let p_name: String = CodegenAstArenaParamNameOrDie(arena, j);
                    let c_p_name: String = CompilerSymbolCBindingName(p_name);
                    let p_type: String = CodegenAstArenaParamTypeNameOrDie(arena, j, signature_context);
                    let cpt: String = AbiLayoutCParamType(p_type, struct_env);
                    let cp: String = Concat(cpt, Concat(" ", c_p_name));
                    if p_mode == 1 {
                        cp = Concat(cpt, Concat(" *", CompilerSymbolCInoutParamName(p_name)));
                    }
                    if pn == 0 {
                        params = cp;
                    } else {
                        params = Concat(params, Concat(", ", cp));
                    }
                    pn = pn + 1;
                    j = j + 1;
                }
                let rtype: String = "Void";
                if j < count && CodegenAstArenaIsReturns(arena, j) {
                    rtype = CodegenAstArenaReturnTypeNameOrDie(arena, j);
                }
                let plist: String = params;
                if pn == 0 {
                    plist = AbiLayoutCEmptyParameterList();
                }
                let sig: String = Concat(AbiLayoutCReturnType(rtype, struct_env), Concat(" ", Concat(c_name, Concat("(", Concat(plist, ")")))));
                block = Concat(block, Concat(sig, ";\n"));
            }
        }
        i = i + 1;
    }
    if StringLength(block) > 0 {
        block = Concat(block, "\n");
    }
    return block;
}
