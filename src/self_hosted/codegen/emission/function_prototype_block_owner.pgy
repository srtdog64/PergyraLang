// Program function-prototype block owner.
//
// Prototype emission is a compiler-scale pass over every callable signature.
// Stream each row directly into one builder: retaining recursively concatenated
// parameter prefixes makes peak memory grow with both program size and arity.

import "../text/text_owner.pgy";
import "../input/semantic_signature_codegen_view_owner.pgy";
import "../input/generic_specialization_codegen_view_owner.pgy";
import "../input/semantic_role_codegen_view_owner.pgy";
import "../input/callable_receiver_codegen_view_owner.pgy";
import "../../compiler/symbol_table_owner.pgy";
import "../abi_layout/abi_layout_owner.pgy";
import "callable_parameter_prototype_owner.pgy";
import "implicit_receiver_c_parameter_owner.pgy";

func CodegenFunctionPrototypeBlock(
    signatures: SemanticAstFunctionSignatureFacts,
    roles: SemanticAstRoleFacts,
    receiver_facts: CodegenCallableReceiverFacts,
    struct_env: CodegenTypeEnv,
    specializations: CodegenGenericSpecializationFacts
) -> String {
    let output_allocator: Allocator = AllocatorResult();
    let output: TextBuilder = TextBuilderNew(4096);
    let emitted_count: Int = 0;
    let i: Int = 0;
    while i < SemanticAstFunctionSignatureCount(signatures) {
        if !CodegenSemanticFunctionRuntimeCallableOrDie(signatures, i) ||
            CodegenSemanticFunctionGenericCountOrDie(signatures, i) > 0 {
            i = i + 1;
            continue;
        }
        let owner: String = CodegenSemanticFunctionOwnerOrDie(signatures, i);
        let name: String = CodegenSemanticFunctionNameOrDie(signatures, i);
        let c_name: String = CompilerSymbolCQualifiedName(owner, name);
        if !CodegenSemanticFunctionUsesDirectHostEntrypoint(
            signatures.entrypoint_selection, SemanticAstFunctionSignatureCount(signatures), i) {
            TextBuilderAppend(output, AbiLayoutCReturnType(
                CodegenSemanticFunctionReturnTypeOrDie(signatures, i),
                struct_env
            ));
            TextBuilderAppend(output, " ");
            TextBuilderAppend(output, c_name);
            TextBuilderAppend(output, "(");
            let param_count: Int = CodegenSemanticFunctionParamCountOrDie(
                signatures, i
            );
            let function_node: Int = CodegenSemanticFunctionNodeOrDie(
                signatures, i
            );
            let role_receiver_type: Option<String> =
                CodegenSemanticRoleReceiverType(roles, function_node);
            let receiver_carriage: String =
                CodegenCallableReceiverCarriageForAdmittedSignatureOrDie(
                    receiver_facts, i
                );
            let receiver_source_parameter_offset: Int =
                CodegenCallableReceiverSourceParameterOffsetForAdmittedSignatureOrDie(
                    receiver_facts, i
                );
            let mutable_identity_receiver: Bool =
                receiver_carriage ==
                    CallableReceiverCarriageMutableIdentity() &&
                !IsSome(role_receiver_type);
            let wrote_param: Bool = false;
            let implicit_receiver: Option<String> =
                CodegenImplicitReceiverCParameterOrDie(
                    receiver_facts, i, owner, struct_env
                );
            if IsSome(implicit_receiver) {
                TextBuilderAppend(output, UnwrapOption(implicit_receiver));
                wrote_param = true;
            }
            let pn: Int = 0;
            while pn < param_count {
                if wrote_param { TextBuilderAppend(output, ", "); }
                let p_mode: Int = CodegenSemanticFunctionParamModeOrDie(
                    signatures, i, pn
                );
                let p_name: String = CodegenSemanticFunctionParamNameOrDie(
                    signatures, i, pn
                );
                let p_type: String = CodegenSemanticFunctionParamTypeOrDie(
                    signatures, i, pn
                );
                let role_receiver_param: Bool = false;
                let source_receiver_parameter: Bool =
                    pn < receiver_source_parameter_offset;
                if source_receiver_parameter && IsSome(role_receiver_type) {
                    p_type = UnwrapOption(role_receiver_type);
                    role_receiver_param = true;
                }
                let c_binding_name: String =
                    CompilerSymbolCBindingName(p_name);
                let callable_parameter: Option<String> =
                    CodegenCallableParameterPrototypeIfPresent(
                        p_type, c_binding_name, p_mode, struct_env
                    );
                if IsSome(callable_parameter) {
                    TextBuilderAppend(output, UnwrapOption(callable_parameter));
                } else {
                    let cpt: String = AbiLayoutCParamType(p_type, struct_env);
                    if source_receiver_parameter && mutable_identity_receiver {
                        if p_mode != 0 {
                            Die("mutable-identity receiver prototype mode is invalid");
                        }
                        TextBuilderAppend(output, cpt);
                        TextBuilderAppend(output, " *");
                        TextBuilderAppend(
                            output, CompilerSymbolCBindingName(p_name)
                        );
                    } else if role_receiver_param {
                        TextBuilderAppend(output, "void *_pgy_raw_self");
                    } else if p_mode == 1 {
                        TextBuilderAppend(output, cpt);
                        TextBuilderAppend(output, " *");
                        TextBuilderAppend(
                            output, CompilerSymbolCInoutParamName(p_name)
                        );
                    } else if p_mode == 3 && !AbiLayoutCReadonlyRefPassesDirect(p_type) {
                        TextBuilderAppend(output, "const ");
                        TextBuilderAppend(output, cpt);
                        TextBuilderAppend(output, " *");
                        TextBuilderAppend(
                            output, CompilerSymbolCReadonlyRefParamName(p_name)
                        );
                    } else {
                        TextBuilderAppend(output, cpt);
                        TextBuilderAppend(output, " ");
                        TextBuilderAppend(
                            output, CompilerSymbolCBindingName(p_name)
                        );
                    }
                }
                wrote_param = true;
                pn = pn + 1;
            }
            if !wrote_param {
                TextBuilderAppend(output, AbiLayoutCEmptyParameterList());
            }
            TextBuilderAppend(output, ");\n");
            emitted_count = emitted_count + 1;
        }
        i = i + 1;
    }

    i = 0;
    while i < CodegenGenericSpecializationCount(specializations) {
        let signature_index: Int = specializations.signature_indexes[i];
        let actuals: Array<String> =
            CodegenGenericSpecializationActuals(specializations, i);
        TextBuilderAppend(output, AbiLayoutCReturnType(
            CodegenGenericResolvedReturnTypeOrDie(
                signatures, signature_index, actuals
            ), struct_env
        ));
        TextBuilderAppend(output, " ");
        TextBuilderAppend(output, specializations.c_names[i]);
        TextBuilderAppend(output, "(");

        let param_count: Int = CodegenSemanticFunctionParamCountOrDie(
            signatures, signature_index
        );
        let specialized_carriage: String =
            CodegenCallableReceiverCarriageForAdmittedSignatureOrDie(
                receiver_facts, signature_index
            );
        let specialized_role_erased: Bool =
            CodegenCallableReceiverRoleErasedForAdmittedSignatureOrDie(
                receiver_facts, signature_index
            );
        let specialized_receiver_source_parameter_offset: Int =
            CodegenCallableReceiverSourceParameterOffsetForAdmittedSignatureOrDie(
                receiver_facts, signature_index
            );
        let specialized_owner: String =
            CodegenSemanticFunctionOwnerOrDie(signatures, signature_index);
        let specialized_implicit_receiver: Option<String> =
            CodegenImplicitReceiverCParameterOrDie(
                receiver_facts, signature_index, specialized_owner, struct_env
            );
        let wrote_param: Bool = false;
        if IsSome(specialized_implicit_receiver) {
            TextBuilderAppend(
                output, UnwrapOption(specialized_implicit_receiver)
            );
            wrote_param = true;
        }
        let pn: Int = 0;
        while pn < param_count {
            if wrote_param { TextBuilderAppend(output, ", "); }
            let p_mode: Int = CodegenSemanticFunctionParamModeOrDie(
                signatures, signature_index, pn
            );
            let p_name: String = CodegenSemanticFunctionParamNameOrDie(
                signatures, signature_index, pn
            );
            let p_type: String = CodegenGenericResolvedParamTypeOrDie(
                signatures, signature_index, pn, actuals
            );
            let source_receiver_parameter: Bool =
                pn < specialized_receiver_source_parameter_offset;
            let c_binding_name: String = CompilerSymbolCBindingName(p_name);
            let callable_parameter: Option<String> =
                CodegenCallableParameterPrototypeIfPresent(
                    p_type, c_binding_name, p_mode, struct_env
                );
            if IsSome(callable_parameter) {
                TextBuilderAppend(output, UnwrapOption(callable_parameter));
            } else {
                let cpt: String = AbiLayoutCParamType(p_type, struct_env);
                if source_receiver_parameter && specialized_role_erased {
                    TextBuilderAppend(output, "void *_pgy_raw_self");
                } else if source_receiver_parameter && specialized_carriage ==
                    CallableReceiverCarriageMutableIdentity() {
                    if p_mode != 0 {
                        Die("mutable-identity receiver prototype mode is invalid");
                    }
                    TextBuilderAppend(output, cpt);
                    TextBuilderAppend(output, " *");
                    TextBuilderAppend(
                        output, CompilerSymbolCBindingName(p_name)
                    );
                } else if p_mode == 1 {
                    TextBuilderAppend(output, cpt);
                    TextBuilderAppend(output, " *");
                    TextBuilderAppend(
                        output, CompilerSymbolCInoutParamName(p_name)
                    );
                } else if p_mode == 3 && !AbiLayoutCReadonlyRefPassesDirect(p_type) {
                    TextBuilderAppend(output, "const ");
                    TextBuilderAppend(output, cpt);
                    TextBuilderAppend(output, " *");
                    TextBuilderAppend(
                        output, CompilerSymbolCReadonlyRefParamName(p_name)
                    );
                } else {
                    TextBuilderAppend(output, cpt);
                    TextBuilderAppend(output, " ");
                    TextBuilderAppend(
                        output, CompilerSymbolCBindingName(p_name)
                    );
                }
            }
            wrote_param = true;
            pn = pn + 1;
        }
        if !wrote_param {
            TextBuilderAppend(output, AbiLayoutCEmptyParameterList());
        }
        TextBuilderAppend(output, ");\n");
        emitted_count = emitted_count + 1;
        i = i + 1;
    }
    if emitted_count > 0 { TextBuilderAppend(output, "\n"); }
    let block: String = TextBuilderFinish(output, output_allocator);
    AllocatorDestroy(output_allocator);
    return block;
}
