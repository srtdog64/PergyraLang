// Emit concrete definitions for generic function specialization facts.

import "../text/text_owner.pgy";
import "../text/owned_string_join_owner.pgy";
import "function_emit.pgy";

func EmitFunctionSet(
    count: Int,
    arena: AstArena,
    signatures: SemanticAstFunctionSignatureFacts,
    receiver_facts: CodegenCallableReceiverFacts,
    local_bindings: SemanticAstLocalBindingFacts,
    assignments: SemanticAstAssignmentFacts,
    statements: SemanticAstStatementFacts,
    ref body_types: CodegenSemanticBodyTypeFacts,
    expression_surfaces: SemanticAstExpressionSurfaceFacts,
    specializations: CodegenGenericSpecializationFacts,
    inout cur: Array<Int>,
    f_indent: Int,
    base_env: CodegenTypeEnv,
    machine_startup: String,
    uses_args: Bool,
    ref domain_runtime: CodegenDomainRuntimeFacts
) -> String {
    let function_node: Int = cur[0];
    let signature_index: Int = CodegenSemanticSignatureIndexOrDie(
        signatures, function_node
    );
    if CodegenSemanticFunctionGenericCountOrDie(
        signatures, signature_index
    ) == 0 {
        return EmitFunction(
            count, arena, signatures, receiver_facts,
            local_bindings, assignments,
            statements, body_types, expression_surfaces, cur, f_indent,
            base_env, machine_startup, uses_args, domain_runtime
        );
    }

    let definitions: Array<String> = [];
    let after_function: Int = -1;
    let specialization_index: Int = 0;
    while specialization_index <
        CodegenGenericSpecializationCount(specializations) {
        if specializations.signature_indexes[specialization_index] ==
            signature_index {
            let local_cur: Array<Int> = [function_node];
            let actuals: Array<String> =
                CodegenGenericSpecializationActuals(
                    specializations, specialization_index
                );
            let definition: String = EmitFunctionWithSpecialization(
                count, arena, signatures, receiver_facts, local_bindings,
                assignments, statements, body_types, expression_surfaces,
                local_cur, f_indent, base_env, uses_args,
                machine_startup,
                specializations.c_names[specialization_index], actuals,
                domain_runtime
            );
            if after_function < 0 { after_function = local_cur[0]; }
            else if after_function != local_cur[0] {
                Die("generic specialization traversal diverged");
            }
            ArrayPush(definitions, definition);
        }
        specialization_index = specialization_index + 1;
    }

    if after_function < 0 {
        ArraySet(cur, 0, function_node + 1);
        while cur[0] < count &&
            CodegenAstArenaIsDescendantOf(arena, cur[0], function_node) {
            ArraySet(cur, 0, cur[0] + 1);
        }
        return "";
    }
    ArraySet(cur, 0, after_function);
    return CodegenJoinOwnedStringFragments(definitions, "\n");
}
