// HashMap C call emission; signature and binding selection are separate inputs.
import "hashmap_call_type_owner.pgy";
import "../text/text_owner.pgy";
import "../runtime_abi/hashmap_runtime_owner.pgy";
import "../abi_layout/abi_layout_owner.pgy";
import "expr_semantic_call_argument_owner.pgy";
import "expr_semantic_type_owner.pgy";

func RewriteSemanticHashMapCall(
    graph: SemanticExpressionGraphFacts, view: SemanticCallSpineView,
    protocol: SemanticExpressionGraphCollectionCallProtocolFact, env: CodegenTypeEnv
) -> String {
    if !protocol.applies || protocol.family != "HashMap" ||
        protocol.return_kind == "constructor" ||
        ArrayLength(view.argument_nodes) != protocol.expected_arity {
        Die("HashMap call protocol or constructor context is missing");
    }
    let receiver_type: Option<String> = CodegenExpressionTypeFromGraph(
        graph, view.argument_nodes[protocol.receiver_argument_index], env);
    if !IsSome(receiver_type) { Die("HashMap receiver type fact is missing"); }
    let fact: CollectionHashMapRuntimeFact = CollectionHashMapRuntimeFactFromTypeName(UnwrapOption(receiver_type));
    if !fact.ok { Die("HashMap receiver runtime ABI fact is missing"); }
    let signature: SemanticHashMapCallSignature = SemanticHashMapCallSignatureFrom(
        protocol.operation, ArrayLength(view.argument_nodes), fact.type_name);
    if !signature.ok { Die("HashMap concrete argument signature is missing"); }
    let output: String = "({ ";
    let arguments: String = "";
    let index: Int = 0;
    // C leaves argument evaluation unspecified. Materialize each admitted
    // argument once, in source order, inside this expression's lexical scope.
    while index < protocol.expected_arity {
        let temporary: String = "__pgy_map_arg_" + ToString(view.call_node) + "_" + ToString(index);
        while TypeEnvSemanticValueType(env, temporary) != "" || LookupKindType(env, temporary, "f") != "" { temporary = temporary + "_"; }
        let mode: String = "default";
        let c_type: String = AbiLayoutCValueType(signature.parameter_types[index], env);
        if index == protocol.receiver_argument_index { mode = "ref"; c_type = c_type + " *"; }
        let argument: String = RewriteSemanticCallArgument(
            graph, view.argument_nodes[index], signature.parameter_types[index], mode, env);
        output = output + c_type + " " + temporary + " = " + argument + "; ";
        if index > 0 { arguments = arguments + ", "; }
        arguments = arguments + temporary;
        index = index + 1;
    }
    let callee_c_name: String = CollectionHashMapRuntimeCFunction(fact, protocol);
    if protocol.operation == "MapKeys" { callee_c_name = CollectionHashMapRuntimeCKeysBridgeName(fact); }
    return output + callee_c_name + "(" + arguments + "); })";
}
