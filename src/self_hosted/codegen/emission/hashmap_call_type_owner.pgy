// HashMap type projection from semantic call identity and signature facts.
import "../type_facts/type_env.pgy";
import "../../semantic/ast_expression_graph_call_view_owner.pgy";
import "../../semantic/ast_expression_call_target_fact_owner.pgy";
import "../../semantic/ast_expression_graph_node_view_owner.pgy";
import "../../semantic/builtin_signature_owner.pgy";

func CodegenHashMapCallProtocol(
    graph: SemanticExpressionGraphFacts, call: SemanticCallSpineView
) -> SemanticExpressionGraphCollectionCallProtocolFact {
    let missing: SemanticExpressionGraphCollectionCallProtocolFact = SemanticExpressionGraphCollectionCallProtocolNotApplicable();
    if !call.ok { return missing; }
    let kind: Option<Int> = SemanticExpressionGraphCallTargetKind(graph, call.call_node);
    let name: Option<String> = SemanticExpressionGraphCallTargetName(graph, call.call_node);
    let binding: Option<Int> = SemanticExpressionGraphBindingKind(graph, call.callee_node);
    if !IsSome(kind) || UnwrapOption(kind) != SemanticCallTargetDirect() ||
        !IsSome(name) || !IsSome(binding) { return missing; }
    if UnwrapOption(binding) == SemanticExpressionBindingFormalParameter() ||
        UnwrapOption(binding) == SemanticExpressionBindingDeclaredCallable() { return missing; }
    let protocol: SemanticExpressionGraphCollectionCallProtocolFact =
        SemanticExpressionGraphCollectionCallProtocolFromName(UnwrapOption(name));
    if !protocol.applies || protocol.family != "HashMap" { return missing; }
    return protocol;
}

func CodegenHashMapCallReturnTypeFromGraph(
    graph: SemanticExpressionGraphFacts, call: SemanticCallSpineView,
    protocol: SemanticExpressionGraphCollectionCallProtocolFact, env: CodegenTypeEnv
) -> Option<String> {
    if !protocol.applies || protocol.family != "HashMap" ||
        ArrayLength(call.argument_nodes) != protocol.expected_arity { return None; }
    if protocol.return_kind == "constructor" { return None; }
    let receiver: Option<String> = CodegenExpressionTypeFromGraph(
        graph, call.argument_nodes[protocol.receiver_argument_index], env);
    if !IsSome(receiver) { return None; }
    let signature: SemanticHashMapCallSignature = SemanticHashMapCallSignatureFrom(
        protocol.operation, ArrayLength(call.argument_nodes), UnwrapOption(receiver));
    if !signature.ok { return None; }
    return Some(signature.return_type);
}
