// Zone-bound action-step C emission after semantic binding admission.

import "../input/intent_zone_authority_transition_codegen_view_owner.pgy";
import "../input/semantic_expression_codegen_view_owner.pgy";
import "../text/text_owner.pgy";
import "../type_facts/type_env.pgy";
import "function_binding_env_owner.pgy";
import "expr_semantic_graph_emit_owner.pgy";
import "intent_observability_emit_owner.pgy";
import "intent_outcome_emit_owner.pgy";

struct CodegenIntentActionStepEmission {
    env: CodegenTypeEnv;
    sync_expression: String;
    writeback_expression: String;
}

func CodegenIntentEmitActionStep(
    inout body: Array<String>,
    ref zone_authority_transitions:
        CodegenIntentZoneAuthorityTransitionFacts,
    ref domain_runtime: CodegenDomainRuntimeFacts,
    intent_syntax_id: Int,
    intent_name: String,
    receiver_alias: String,
    who_names: Array<String>,
    who_start: Int,
    who_count: Int,
    using_alias: String,
    authority_alias: String,
    where_zone_name: String,
    step_name: String,
    expression_surfaces: SemanticAstExpressionSurfaceFacts,
    on_node: Int,
    pre_node: Int,
    invariant_node: Int,
    outcome_count: Int,
    outcome_name: String,
    uses_intent_observability: Bool,
    env: CodegenTypeEnv
) -> CodegenIntentActionStepEmission {
    if using_alias == "" {
        Die("self-host intent executable step using binding is missing");
    }
    let binding: CodegenIntentZoneAuthorityBindingFact =
        CodegenIntentZoneAuthorityBindingFactForStep(
            zone_authority_transitions, domain_runtime,
            intent_syntax_id, intent_name, step_name,
            receiver_alias, using_alias, authority_alias, where_zone_name
        );
    if !binding.ok {
        Die(Concat(
            "self-host intent step binding is invalid: ", binding.diagnostic
        ));
    }
    CodegenIntentObservabilityEmitAttributionRange(
        body, uses_intent_observability, step_name,
        binding.zone_type, who_names, who_start, who_count,
        binding.actor_slot_name
    );
    ArrayPush(body, Concat(
        "    ", Concat(binding.zone_member, Concat(
            " = (*", Concat(binding.actor_c, ");\n")
        ))
    ));
    CodegenIntentObservabilityEmitMaterialize(
        body, uses_intent_observability, receiver_alias,
        binding.actor_slot_name, binding.zone_type
    );
    ArrayPush(body, Concat(
        "    ", Concat(binding.sync_symbol, Concat(
            "(", Concat(binding.zone_pointer, ");\n")
        ))
    ));
    let step_env: CodegenTypeEnv = TypeEnvAppendLocalRows(
        env, CodegenFunctionValueBindingFactForCExpression(
            receiver_alias, binding.actor_type, env, binding.zone_member
        ).env_rows
    );
    let on_graph: SemanticExpressionGraphView =
        CodegenSemanticExpressionGraphOrDie(
            expression_surfaces, on_node, AstExpressionLaneAtom()
        );
    // Placement/receiver binding precedes checks; neither check may execute on.
    if pre_node >= 0 {
        CodegenIntentEmitPredicate(body, expression_surfaces, pre_node,
            "pre", step_name, uses_intent_observability, step_env);
    }
    if invariant_node >= 0 {
        CodegenIntentEmitPredicate(body, expression_surfaces, invariant_node,
            "invariant-pre", step_name, uses_intent_observability, step_env);
    }
    let on_expression: String = RewriteExprFromSemanticGraph(
        on_graph.graph, on_graph.root_id, step_env
    );
    step_env = CodegenIntentEmitOnOutcome(
        body, on_graph, on_expression, outcome_count, outcome_name, step_env
    );
    ArrayPush(body, Concat(
        "    ", Concat(binding.sync_symbol, Concat(
            "(", Concat(binding.zone_pointer, ");\n")
        ))
    ));
    ArrayPush(body, Concat(
        "    (*", Concat(binding.actor_c, Concat(") = ", Concat(
            binding.zone_member, ";\n"
        )))
    ));
    return CodegenIntentActionStepEmission(
        step_env,
        Concat(binding.sync_symbol, Concat(
            "(", Concat(binding.zone_pointer, ")")
        )),
        Concat("(*", Concat(binding.actor_c, Concat(
            ") = ", binding.zone_member
        )))
    );
}
