// C emission for the admitted source-DIR intent declaration lane.
//
// The DIR owner carries exact declaration, participant, step, phase, and
// ordered compensation identities.  This final consumer emits those rows and
// never discovers intent topology from AST children or reparses source text.

import "../../semantic/ast_intent_signature_fact_owner.pgy";
import "../../semantic/ast_zone_authority_fact_owner.pgy";
import "../input/intent_execution_codegen_view_owner.pgy";
import "../input/intent_policy_codegen_view_owner.pgy";
import "../text/text_owner.pgy";
import "../type_facts/type_env.pgy";
import "../../compiler/symbol_table_owner.pgy";
import "intent_signature_emit_owner.pgy";
import "intent_outcome_emit_owner.pgy";
import "intent_control_flow_emit_owner.pgy";
import "intent_observability_emit_owner.pgy";
import "intent_nested_call_emit_owner.pgy";
import "intent_action_step_emit_owner.pgy";

func CodegenIntentSourceRowOrDie(
    ref view: CodegenIntentExecutionView,
    syntax_id: Int,
    name: String
) -> Int {
    let found: Int = -1;
    let matches: Int = 0;
    let row: Int = 0;
    while row < ArrayLength(view.source_facts.intent_node_ids) {
        if view.source_facts.intent_node_ids[row] == syntax_id {
            matches = matches + 1;
            found = row;
            if view.source_facts.names[row] != name {
                Die("codegen DIR intent declaration name identity is stale");
            }
        }
        row = row + 1;
    }
    if matches != 1 || found < 0 {
        Die("codegen DIR intent declaration identity is missing or duplicated");
    }
    return found;
}

func CodegenIntentOptionalRangeNameOrDie(
    values: Array<String>, start: Int, count: Int, kind: String
) -> String {
    if start < 0 || count < 0 || count > 1 ||
        start + count > ArrayLength(values) {
        Die(Concat("codegen DIR intent optional range is invalid: ", kind));
    }
    if count == 0 { return ""; }
    return values[start];
}

func CodegenIntentDefinitionBlock(
    ref intents: SemanticAstIntentSignatureFacts,
    ref zone_authorities: SemanticAstZoneAuthorityFacts,
    expression_surfaces: SemanticAstExpressionSurfaceFacts,
    base_env: CodegenTypeEnv,
    own intent_execution: CodegenIntentExecutionView,
    ref intent_policy: CodegenIntentPolicyView,
    uses_intent_observability: Bool
) -> String {
    let definitions: Array<String> = [];
    let steps: SelfDirIntentStepFacts = intent_execution.source_facts.steps;
    let intent_index: Int = 0;
    while intent_index < SemanticAstIntentSignatureCount(intents) {
        let intent_node: Int = intents.intent_node_ids[intent_index];
        if CodegenIntentExecutionViewOwnsRoutine(
            intent_execution, intent_node
        ) {
            intent_index = intent_index + 1;
            continue;
        }
        let source_intent: Int = CodegenIntentSourceRowOrDie(
            intent_execution, intent_node, intents.names[intent_index]
        );
        let env: CodegenTypeEnv = CodegenIntentLocalEnv(
            intents, intent_index, base_env
        );
        let body: Array<String> = [];
        let step_start: Int =
            intent_execution.source_facts.step_starts[source_intent];
        let step_count: Int =
            intent_execution.source_facts.step_counts[source_intent];
        let compensation_starts: Array<Int> = [];
        let compensation_counts: Array<Int> = [];
        let compensation_expressions: Array<String> = [];
        let step_sync_expressions: Array<String> = [];
        let step_writeback_expressions: Array<String> = [];
        CodegenIntentEmitControlPrologue(
            body, step_count, uses_intent_observability, intent_node,
            intent_policy, intents, intent_index,
            expression_surfaces, env
        );
        let local_step: Int = 0;
        while local_step < step_count {
            let step_row: Int = step_start + local_step;
            let step_name: String = steps.names[step_row];
            let authority_alias: String =
                CodegenIntentOptionalRangeNameOrDie(
                    steps.authorized_names,
                    steps.authorized_starts[step_row],
                    steps.authorized_counts[step_row], "authority"
                );
            let outcome_count: Int = 0;
            if steps.outcome_node_ids[step_row] >= 0 {
                if steps.outcome_names[step_row] == "" {
                    Die("codegen DIR intent outcome identity is missing");
                }
                outcome_count = 1;
            }
            let step_env: CodegenTypeEnv = env;
            if steps.target_kinds[step_row] == "intent" {
                if outcome_count != 0 {
                    Die("codegen DIR nested intent boundary is invalid");
                }
                if steps.receiver_aliases[step_row] != "" {
                    if steps.using_aliases[step_row] == "" ||
                        steps.where_zone_names[step_row] == "" {
                        Die("codegen DIR placed intent boundary is invalid");
                    }
                    // A semantically nested intent reached through `on:` may
                    // retain an outer zone placement.  It uses the same
                    // action-shaped materialize/call/writeback boundary, but
                    // its placement receiver is carried explicitly by DIR.
                    let emitted: CodegenIntentActionStepEmission =
                        CodegenIntentEmitActionStep(
                            body, intents, zone_authorities, intent_index,
                            steps.receiver_aliases[step_row],
                            steps.who_names, steps.who_starts[step_row],
                            steps.who_counts[step_row],
                            steps.using_aliases[step_row], authority_alias,
                            steps.where_zone_names[step_row], step_name,
                            expression_surfaces,
                            steps.target_expression_node_ids[step_row],
                            0, "", uses_intent_observability, env
                        );
                    step_env = emitted.env;
                    ArrayPush(step_sync_expressions, emitted.sync_expression);
                    ArrayPush(
                        step_writeback_expressions,
                        emitted.writeback_expression
                    );
                } else {
                    if steps.using_aliases[step_row] != "" ||
                        authority_alias != "" ||
                        steps.where_zone_names[step_row] != "" {
                        Die("codegen DIR nested intent boundary is invalid");
                    }
                    CodegenIntentEmitNestedCall(
                        body, expression_surfaces,
                        steps.target_expression_node_ids[step_row], step_name,
                        steps.who_names, steps.who_starts[step_row],
                        steps.who_counts[step_row],
                        uses_intent_observability, step_env
                    );
                    ArrayPush(step_sync_expressions, "");
                    ArrayPush(step_writeback_expressions, "");
                }
            } else if steps.target_kinds[step_row] == "action" {
                let emitted: CodegenIntentActionStepEmission =
                    CodegenIntentEmitActionStep(
                        body, intents, zone_authorities, intent_index,
                        steps.receiver_aliases[step_row],
                        steps.who_names, steps.who_starts[step_row],
                        steps.who_counts[step_row],
                        steps.using_aliases[step_row],
                        authority_alias, steps.where_zone_names[step_row],
                        step_name, expression_surfaces,
                        steps.target_expression_node_ids[step_row],
                        outcome_count, steps.outcome_names[step_row],
                        uses_intent_observability, env
                    );
                step_env = emitted.env;
                ArrayPush(step_sync_expressions, emitted.sync_expression);
                ArrayPush(
                    step_writeback_expressions,
                    emitted.writeback_expression
                );
            } else {
                Die("codegen DIR intent target kind is invalid");
            }
            CodegenIntentEmitStepCompleted(body, local_step);
            ArrayPush(
                compensation_starts, ArrayLength(compensation_expressions)
            );
            let compensation_start: Int =
                steps.compensate_starts[step_row];
            let compensation_count: Int =
                steps.compensate_counts[step_row];
            ArrayPush(compensation_counts, compensation_count);
            let compensation: Int = 0;
            while compensation < compensation_count {
                ArrayPush(
                    compensation_expressions,
                    CodegenIntentCompensationExpression(
                        expression_surfaces,
                        steps.compensate_node_ids[
                            compensation_start + compensation
                        ],
                        step_env
                    )
                );
                compensation = compensation + 1;
            }
            if steps.guard_node_ids[step_row] >= 0 {
                CodegenIntentEmitPredicate(
                    body, expression_surfaces,
                    steps.guard_node_ids[step_row], "guard", step_name,
                    uses_intent_observability, step_env
                );
            }
            if steps.expect_node_ids[step_row] >= 0 {
                CodegenIntentEmitExpect(
                    body, expression_surfaces,
                    steps.expect_node_ids[step_row], outcome_count, step_name,
                    uses_intent_observability, step_env
                );
            }
            if steps.post_node_ids[step_row] >= 0 {
                CodegenIntentEmitPredicate(
                    body, expression_surfaces,
                    steps.post_node_ids[step_row], "post", step_name,
                    uses_intent_observability, step_env
                );
            }
            CodegenIntentObservabilityEmitStepOk(
                body, uses_intent_observability, step_name
            );
            local_step = local_step + 1;
        }
        CodegenIntentEmitCleanup(
            body, step_count, compensation_starts, compensation_counts,
            compensation_expressions, step_sync_expressions,
            step_writeback_expressions, uses_intent_observability
        );
        ArrayPush(definitions, Concat(
            CodegenIntentCReturnType(intents, intent_index, base_env),
            Concat(" ", Concat(
                CompilerSymbolCIdentifier(intents.names[intent_index]),
                Concat("(", Concat(
                    CodegenIntentParameterList(intents, intent_index, base_env),
                    Concat(")\n{\n", Concat(
                        StringJoin(body, ""), "}\n\n"
                    ))
                ))
            ))
        ));
        intent_index = intent_index + 1;
    }
    return StringJoin(definitions, "");
}
