// C emission for the bounded admitted intent declaration path.
//
// Intent remains its own semantic callable.  This owner consumes the compact
// intent signature rows plus the executable expression graphs reconstructed
// from admitted MIR; it does not reinterpret an intent as a func.  A typed
// Outcome row binds the one On action result exactly once and makes that
// immutable value available to the same step predicates and compensation.

import "../../semantic/ast_intent_signature_fact_owner.pgy";
import "../input/intent_execution_codegen_view_owner.pgy";
import "../input/semantic_expression_codegen_view_owner.pgy";
import "../text/text_owner.pgy";
import "../type_facts/type_env.pgy";
import "../abi_layout/abi_layout_owner.pgy";
import "../../compiler/symbol_table_owner.pgy";
import "function_binding_env_owner.pgy";
import "expr_semantic_graph_emit_owner.pgy";
import "intent_signature_emit_owner.pgy";
import "intent_outcome_emit_owner.pgy";
import "intent_control_flow_emit_owner.pgy";

func CodegenIntentDefinitionBlock(
    artifact: AstTreeArtifact,
    ref intents: SemanticAstIntentSignatureFacts,
    expression_surfaces: SemanticAstExpressionSurfaceFacts,
    base_env: CodegenTypeEnv,
    ref intent_execution: CodegenIntentExecutionView
) -> String {
    let definitions: Array<String> = [];
    let intent_index: Int = 0;
    while intent_index < SemanticAstIntentSignatureCount(intents) {
        let intent_node: Int = intents.intent_node_ids[intent_index];
        if CodegenIntentExecutionViewOwnsRoutine(
            intent_execution, intent_node
        ) {
            intent_index = intent_index + 1;
            continue;
        }
        let env: CodegenTypeEnv = CodegenIntentLocalEnv(
            intents, intent_index, base_env
        );
        let body: Array<String> = [];
        let step_count: Int = CodegenIntentExecutableStepCount(
            artifact, intent_node
        );
        let compensation_starts: Array<Int> = [];
        let compensation_counts: Array<Int> = [];
        let compensation_expressions: Array<String> = [];
        let step_sync_expressions: Array<String> = [];
        let step_writeback_expressions: Array<String> = [];
        CodegenIntentEmitControlPrologue(body, step_count);
        let step_index: Int = 0;
        let child_index: Int = 0;
        let child: Option<Int> = TypedAstArenaChildAt(
            artifact.arena, intent_node, child_index
        );
        while IsSome(child) {
            let child_id: Int = UnwrapOption(child);
            if TypedAstArenaNodeKindIs(
                artifact.arena, child_id, TypedAstKindIntentStepTag()
            ) {
                let on_count: Int = 0;
                let outcome_count: Int = 0;
                let expect_count: Int = 0;
                let guard_count: Int = 0;
                let post_count: Int = 0;
                let on_node: Int = 0 - 1;
                let expect_node: Int = 0 - 1;
                let guard_node: Int = 0 - 1;
                let post_node: Int = 0 - 1;
                let compensate_nodes: Array<Int> = [];
                let outcome_name: String = "";
                let who_alias: String = "";
                let using_alias: String = "";
                let authority_alias: String = "";
                let step_child_index: Int = 0;
                let step_child: Option<Int> = TypedAstArenaChildAt(
                    artifact.arena, child_id, step_child_index
                );
                while IsSome(step_child) {
                    let row_id: Int = UnwrapOption(step_child);
                    if TypedAstArenaNodeKindIs(
                        artifact.arena, row_id,
                        TypedAstKindIntentStepOnTag()
                    ) {
                        on_count = on_count + 1;
                        on_node = row_id;
                    } else if TypedAstArenaNodeKindIs(
                        artifact.arena, row_id,
                        TypedAstKindIntentStepOutcomeTag()
                    ) {
                        outcome_count = outcome_count + 1;
                        let outcome_atom: Option<String> =
                            TypedAstArenaAtomText(artifact.arena, row_id);
                        if !IsSome(outcome_atom) ||
                            !IsIdentifier(UnwrapOption(outcome_atom)) {
                            Die("self-host intent outcome binding is invalid");
                        }
                        outcome_name = UnwrapOption(outcome_atom);
                    } else if TypedAstArenaNodeKindIs(
                        artifact.arena, row_id,
                        TypedAstKindIntentStepExpectTag()
                    ) {
                        expect_count = expect_count + 1;
                        expect_node = row_id;
                    } else if TypedAstArenaNodeKindIs(
                        artifact.arena, row_id,
                        TypedAstKindIntentStepGuardTag()
                    ) {
                        guard_count = guard_count + 1;
                        guard_node = row_id;
                    } else if TypedAstArenaNodeKindIs(
                        artifact.arena, row_id,
                        TypedAstKindIntentStepPostTag()
                    ) {
                        post_count = post_count + 1;
                        post_node = row_id;
                    } else if TypedAstArenaNodeKindIs(
                        artifact.arena, row_id,
                        TypedAstKindIntentStepCompensateTag()
                    ) {
                        ArrayPush(compensate_nodes, row_id);
                    } else {
                        let provenance: Option<String> =
                            TypedAstArenaProvenanceText(
                                artifact.arena, row_id
                            );
                        if IsSome(provenance) && StartsWith(
                            UnwrapOption(provenance), "Who: "
                        ) {
                            who_alias = StringTrim(Substring(
                                UnwrapOption(provenance),
                                StringLength("Who: "),
                                StringLength(UnwrapOption(provenance)) -
                                    StringLength("Who: ")
                            ));
                        } else if IsSome(provenance) && StartsWith(
                            UnwrapOption(provenance), "Using: "
                        ) {
                            using_alias = StringTrim(Substring(
                                UnwrapOption(provenance),
                                StringLength("Using: "),
                                StringLength(UnwrapOption(provenance)) -
                                    StringLength("Using: ")
                            ));
                        } else if IsSome(provenance) && StartsWith(
                            UnwrapOption(provenance), "AuthorizedBy: "
                        ) {
                            authority_alias = StringTrim(Substring(
                                UnwrapOption(provenance),
                                StringLength("AuthorizedBy: "),
                                StringLength(UnwrapOption(provenance)) -
                                    StringLength("AuthorizedBy: ")
                            ));
                        }
                    }
                    step_child_index = step_child_index + 1;
                    step_child = TypedAstArenaChildAt(
                        artifact.arena, child_id, step_child_index
                    );
                }
                if on_count != 1 || on_node < 0 || outcome_count > 1 ||
                    (outcome_count == 1 && outcome_name == "") ||
                    expect_count > 1 || guard_count > 1 || post_count > 1 ||
                    who_alias == "" || using_alias == "" ||
                    authority_alias != who_alias {
                    Die("self-host intent executable step shape is invalid");
                }
                let who_param: Int = 0 - 1;
                let using_param: Int = 0 - 1;
                let p: Int = 0;
                while p < intents.param_counts[intent_index] {
                    let param_row: Int =
                        intents.param_starts[intent_index] + p;
                    if intents.param_names[param_row] == who_alias {
                        if who_param >= 0 { Die("duplicate intent who binding"); }
                        who_param = param_row;
                    }
                    if intents.param_names[param_row] == using_alias {
                        if using_param >= 0 { Die("duplicate intent using binding"); }
                        using_param = param_row;
                    }
                    p = p + 1;
                }
                if who_param < 0 || using_param < 0 ||
                    intents.param_is_values[who_param] ||
                    intents.param_is_values[using_param] {
                    Die("self-host intent step participant binding is invalid");
                }
                let who_type: String = intents.param_types[who_param];
                let zone_type: String = intents.param_types[using_param];
                if LookupFieldType(env, zone_type, who_alias) != who_type {
                    Die("self-host intent zone participant field is missing");
                }
                let who_c: String = CompilerSymbolCBindingName(who_alias);
                let zone_c: String = CompilerSymbolCBindingName(using_alias);
                let zone_member: String = Concat(
                    "(*", Concat(zone_c, Concat(").",
                        CompilerSymbolCFieldName(who_alias)
                    ))
                );
                let sync_symbol: String = LookupKindType(
                    env, zone_type, "projection_sync"
                );
                if sync_symbol == "" {
                    Die("self-host intent zone sync owner is missing");
                }
                ArrayPush(body, Concat(
                    "    ", Concat(zone_member, Concat(
                        " = (*", Concat(who_c, ");\n")
                    ))
                ));
                ArrayPush(body, Concat(
                    "    ", Concat(sync_symbol, Concat(
                        "(", Concat(zone_c, ");\n")
                    ))
                ));
                let step_env: CodegenTypeEnv = TypeEnvAppendLocalRows(
                    env, CodegenFunctionValueBindingFactForCExpression(
                        who_alias, who_type, env.global_rows, zone_member
                    ).env_rows
                );
                let on_graph: SemanticExpressionGraphView =
                    CodegenSemanticExpressionGraphOrDie(
                        expression_surfaces, on_node,
                        AstExpressionLaneAtom()
                    );
                let on_expression: String = RewriteExprFromSemanticGraph(
                    on_graph.graph, on_graph.root_id, step_env
                );
                step_env = CodegenIntentEmitOnOutcome(
                    body, on_graph, on_expression, outcome_count,
                    outcome_name, step_env
                );
                ArrayPush(body, Concat(
                    "    ", Concat(sync_symbol, Concat(
                        "(", Concat(zone_c, ");\n")
                    ))
                ));
                ArrayPush(body, Concat(
                    "    (*", Concat(who_c, Concat(") = ", Concat(
                        zone_member, ";\n"
                    )))
                ));
                CodegenIntentEmitStepCompleted(body, step_index);
                ArrayPush(compensation_starts,
                    ArrayLength(compensation_expressions));
                ArrayPush(compensation_counts,
                    ArrayLength(compensate_nodes));
                let compensate_index: Int = 0;
                while compensate_index < ArrayLength(compensate_nodes) {
                    ArrayPush(compensation_expressions,
                        CodegenIntentCompensationExpression(
                            expression_surfaces,
                            compensate_nodes[compensate_index], step_env
                        )
                    );
                    compensate_index = compensate_index + 1;
                }
                ArrayPush(step_sync_expressions, Concat(
                    sync_symbol, Concat("(", Concat(zone_c, ")"))
                ));
                ArrayPush(step_writeback_expressions, Concat(
                    "(*", Concat(who_c, Concat(") = ", zone_member))
                ));
                if guard_count == 1 {
                    CodegenIntentEmitPredicate(
                        body, expression_surfaces, guard_node,
                        "Guard", step_env
                    );
                }
                if expect_count == 1 {
                    CodegenIntentEmitExpect(
                        body, expression_surfaces, expect_node,
                        outcome_count, step_env
                    );
                }
                if post_count == 1 {
                    CodegenIntentEmitPredicate(
                        body, expression_surfaces, post_node,
                        "Post", step_env
                    );
                }
                step_index = step_index + 1;
            }
            child_index = child_index + 1;
            child = TypedAstArenaChildAt(
                artifact.arena, intent_node, child_index
            );
        }
        if step_index != step_count {
            Die("self-host intent executable step count drifted");
        }
        CodegenIntentEmitCleanup(
            body, step_count, compensation_starts, compensation_counts,
            compensation_expressions, step_sync_expressions,
            step_writeback_expressions
        );
        ArrayPush(definitions, Concat(
            CodegenIntentCReturnType(intents, intent_index, base_env),
            Concat(" ", Concat(
                CompilerSymbolCIdentifier(intents.names[intent_index]),
                Concat("(", Concat(
                    CodegenIntentParameterList(intents, intent_index, base_env),
                    Concat(")\n{\n", Concat(
                        StringJoin(body, ""), "}\n\n"
                    ))
                ))
            ))
        ));
        intent_index = intent_index + 1;
    }
    return StringJoin(definitions, "");
}
