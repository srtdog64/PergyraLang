// Projects one exact admitted policy row into the C runtime concurrency flag.
import "../input/intent_policy_codegen_view_owner.pgy";

func CodegenIntentModeConcurrent(
    ref policy: CodegenIntentPolicyView,
    intent_index: Int,
    intent_node: Int,
    intent_name: String
) -> Bool {
    let row: Int = CodegenIntentPolicyExactRowOrDie(
        policy, intent_index, intent_node, intent_name
    );
    return policy.concurrent[row];
}
