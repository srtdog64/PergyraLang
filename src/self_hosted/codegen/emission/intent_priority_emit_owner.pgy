// Projects the exact admitted intent-priority expression graph into C.
import "../input/intent_policy_codegen_view_owner.pgy";
import "../text/text_owner.pgy";
import "../type_facts/type_env.pgy";
import "expr_semantic_graph_emit_owner.pgy";

func CodegenIntentPriorityExpression(
    ref policy: CodegenIntentPolicyView,
    intent_index: Int,
    intent_node: Int,
    intent_name: String,
    env: CodegenTypeEnv
) -> String {
    let row: Int = CodegenIntentPolicyExactRowOrDie(
        policy, intent_index, intent_node, intent_name
    );
    if !policy.priority_present[row] { return "0"; }
    let root: Int = policy.priority_expression_roots[row];
    let type_name: Option<String> = CodegenExpressionTypeFromGraph(
        policy.expression_graph, root, env
    );
    if !IsSome(type_name) || UnwrapOption(type_name) != "Int" {
        Die("self-host intent observability priority is not Int");
    }
    return RewriteExprFromSemanticGraph(policy.expression_graph, root, env);
}
