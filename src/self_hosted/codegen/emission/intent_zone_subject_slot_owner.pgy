// C environment projection into the shared Intent subject-slot selection rule.
import "../type_facts/type_env.pgy";
import "../../semantic/intent_subject_slot_policy_owner.pgy";

struct CodegenIntentZoneSubjectSlotFact {
    ok: Bool;
    diagnostic: String;
    slot_name: String;
}

func CodegenIntentZoneSubjectSlotFromFacts(
    env: CodegenTypeEnv, zone_type: String,
    participant_alias: String, participant_type: String
) -> CodegenIntentZoneSubjectSlotFact {
    let owners: Array<Int> = [];
    let names: Array<String> = [];
    let types: Array<String> = [];
    let kinds: Array<String> = [];
    let fields: String = LookupKindType(env, zone_type, "fields");
    let count: Int = ParamModeCsvCount(fields);
    let row: Int = 0;
    while row < count {
        let name: String = CsvAt(fields, row);
        ArrayPush(owners, 0);
        ArrayPush(names, name);
        ArrayPush(types, LookupFieldType(env, zone_type, name));
        ArrayPush(kinds, LookupKindType(
            env, Concat(zone_type, Concat(".", name)), "field_kind"));
        row = row + 1;
    }
    let selected: IntentSubjectSlotSelection = IntentSubjectSlotSelect(
        owners, names, types, kinds, 0, participant_alias, participant_type);
    if !selected.ok {
        return CodegenIntentZoneSubjectSlotFact(false, selected.diagnostic, "");
    }
    return CodegenIntentZoneSubjectSlotFact(true, "", names[selected.field_row]);
}
