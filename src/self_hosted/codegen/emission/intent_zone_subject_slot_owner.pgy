// Exact subject-slot resolution for intent actor and authority participants.

import "../type_facts/type_env.pgy";
import "../../lib/nominal_field_kind_owner.pgy";

struct CodegenIntentZoneSubjectSlotFact {
    ok: Bool;
    diagnostic: String;
    slot_name: String;
}

func CodegenIntentZoneSubjectSlotFromFacts(
    env: CodegenTypeEnv,
    zone_type: String,
    participant_alias: String,
    participant_type: String
) -> CodegenIntentZoneSubjectSlotFact {
    if LookupFieldType(env, zone_type, participant_alias) == participant_type &&
        LookupKindType(
            env, Concat(zone_type, Concat(".", participant_alias)),
            "field_kind"
        ) == NominalFieldKindSubjectSlot() {
        return CodegenIntentZoneSubjectSlotFact(
            true, "", participant_alias
        );
    }
    let slot_name: String = "";
    let fields: String = LookupKindType(env, zone_type, "fields");
    let field_count: Int = ParamModeCsvCount(fields);
    let field_index: Int = 0;
    while field_index < field_count {
        let field_name: String = CsvAt(fields, field_index);
        if field_name != "" &&
            LookupFieldType(env, zone_type, field_name) == participant_type &&
            LookupKindType(
                env, Concat(zone_type, Concat(".", field_name)),
                "field_kind"
            ) == NominalFieldKindSubjectSlot() {
            if slot_name != "" {
                return CodegenIntentZoneSubjectSlotFact(
                    false, "zone-subject-slot-ambiguous", ""
                );
            }
            slot_name = field_name;
        }
        field_index = field_index + 1;
    }
    if slot_name == "" {
        return CodegenIntentZoneSubjectSlotFact(
            false, "zone-subject-slot-missing", ""
        );
    }
    return CodegenIntentZoneSubjectSlotFact(true, "", slot_name);
}
