// Source literal lowering owner for self-host C emission.

import "../text/text_owner.pgy";
import "../runtime_abi/option_result_runtime_owner.pgy";

func RewriteBoolLiterals(e: String) -> String {
    let n: Int = StringLength(e);
    let out: String = "";
    let i: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CodegenCharAt(e, i);
        if in_str {
            out = Concat(out, c);
            if c == "\\" && i + 1 < n {
                out = Concat(out, CodegenCharAt(e, i + 1));
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            out = Concat(out, c);
            i = i + 1;
            continue;
        }
        let prev_ok: Bool = i == 0 || !IsIdentChar(CodegenCharAt(e, i - 1));
        if prev_ok && i + 4 <= n &&
            SubEqualsWithLen(e, n, i, 4, "true") {
            let next_true_ok: Bool = i + 4 == n || !IsIdentChar(CodegenCharAt(e, i + 4));
            if next_true_ok {
                out = Concat(out, "1");
                i = i + 4;
                continue;
            }
        }
        if prev_ok && i + 5 <= n &&
            SubEqualsWithLen(e, n, i, 5, "false") {
            let next_false_ok: Bool = i + 5 == n || !IsIdentChar(CodegenCharAt(e, i + 5));
            if next_false_ok {
                out = Concat(out, "0");
                i = i + 5;
                continue;
            }
        }
        out = Concat(out, c);
        i = i + 1;
    }
    return out;
}

func RewriteNoneLiteral(e: String) -> String {
    let n: Int = StringLength(e);
    let out: String = "";
    let i: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CodegenCharAt(e, i);
        if in_str {
            out = Concat(out, c);
            if c == "\\" && i + 1 < n {
                out = Concat(out, CodegenCharAt(e, i + 1));
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            out = Concat(out, c);
            i = i + 1;
            continue;
        }
        let prev_ok: Bool = i == 0 || (!IsIdentChar(CodegenCharAt(e, i - 1)) && CodegenCharAt(e, i - 1) != ".");
        if prev_ok && i + 4 <= n &&
            SubEqualsWithLen(e, n, i, 4, "None") {
            let next_ok: Bool = i + 4 == n || !IsIdentChar(CodegenCharAt(e, i + 4));
            if next_ok {
                out = Concat(out, Concat(OptionResultRuntimeCOptionNoneFn(), "()"));
                i = i + 4;
                continue;
            }
        }
        out = Concat(out, c);
        i = i + 1;
    }
    return out;
}

func RewriteLongLiteralSuffixes(e: String) -> String {
    let n: Int = StringLength(e);
    let out: String = "";
    let i: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CodegenCharAt(e, i);
        if in_str {
            out = Concat(out, c);
            if c == "\\" && i + 1 < n {
                out = Concat(out, CodegenCharAt(e, i + 1));
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            out = Concat(out, c);
            i = i + 1;
            continue;
        }
        let prev_ok: Bool = i == 0 || !IsIdentChar(CodegenCharAt(e, i - 1));
        if prev_ok && StringIndexOf("0123456789", c) >= 0 {
            let start: Int = i;
            while i < n && StringIndexOf("0123456789", CodegenCharAt(e, i)) >= 0 {
                i = i + 1;
            }
            if i < n && CodegenCharAt(e, i) == "L" &&
                (i + 1 == n || !IsIdentChar(CodegenCharAt(e, i + 1))) {
                out = Concat(out, Concat(Substring(e, start, i - start), "LL"));
                i = i + 1;
                continue;
            }
            out = Concat(out, Substring(e, start, i - start));
            continue;
        }
        out = Concat(out, c);
        i = i + 1;
    }
    return out;
}
