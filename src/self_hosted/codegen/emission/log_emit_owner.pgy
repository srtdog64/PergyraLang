// Log expression projection and scalar formatting ABI owner.

import "../abi_layout/abi_layout_owner.pgy";
import "../runtime_abi/string_runtime_owner.pgy";
import "../text/text_owner.pgy";
import "expr_rewrite.pgy";
import "expr_semantic_graph_emit_owner.pgy";

func EmitFormattedScalarLog(
    c_expr: String,
    print_argument_c_type: String,
    line_format: String
) -> String {
    let stmt: String = Concat(StringRuntimeCFormattedPrintFn(), "(\"");
    stmt = Concat(stmt, line_format);
    stmt = Concat(stmt, "\", (");
    stmt = Concat(stmt, print_argument_c_type);
    stmt = Concat(stmt, ")(");
    stmt = Concat(stmt, c_expr);
    stmt = Concat(stmt, "));");
    return stmt;
}

func EmitLog(
    inferred_type_name: String,
    env: CodegenTypeEnv,
    graph: SemanticExpressionGraphView
) -> String {
    let rendered: String = RewriteExprFromSemanticGraph(
        graph.graph, graph.root_id, env
    );
    if inferred_type_name == "Int" {
        return EmitFormattedScalarLog(
            rendered, StringRuntimeCInt32PrintArgumentType(),
            StringRuntimeCInt32LineFormat()
        );
    }
    if inferred_type_name == "Long" {
        return EmitFormattedScalarLog(
            rendered, StringRuntimeCLongPrintArgumentType(),
            StringRuntimeCIntLineFormat()
        );
    }
    if inferred_type_name == "Float" {
        return EmitFormattedScalarLog(
            rendered, "double", StringRuntimeCFloatLineFormat()
        );
    }
    if inferred_type_name == "Double" {
        return EmitFormattedScalarLog(
            rendered, "double", StringRuntimeCFloatLineFormat()
        );
    }
    if inferred_type_name == "Bool" {
        return Concat(StringRuntimeCBoolLogFn(), Concat("((bool)(", Concat(
            rendered, "));"
        )));
    }
    if inferred_type_name == "String" {
        return Concat(StringRuntimeCLogFn(), Concat("(", Concat(
            rendered, ");"
        )));
    }
    Die(Concat("unsupported Log expression type: ", inferred_type_name));
    return "";
}
