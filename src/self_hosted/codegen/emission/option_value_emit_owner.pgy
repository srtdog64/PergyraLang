// Expected-type Option value emission from semantic graph facts.

import "../type_facts/type_env.pgy";
import "../text/text_owner.pgy";
import "expr_semantic_graph_emit_owner.pgy";
import "../../semantic/ast_expression_graph_node_view_owner.pgy";

struct OptionExprEmissionFact {
    let c_expr: String;
}

func EmitOptionExprFactForType(
    expression: String,
    option_type: String,
    env: CodegenTypeEnv,
    view: SemanticExpressionGraphView
) -> OptionExprEmissionFact {
    if !view.ok {
        Die("semantic Option graph is missing");
    }
    let root_text: Option<String> = SemanticExpressionGraphNodeText(
        view.graph, view.root_id
    );
    if !IsSome(root_text) ||
        UnwrapOption(root_text) != SemanticStripOuterParens(expression) {
        Die("semantic Option graph does not match codegen expression");
    }

    return OptionExprEmissionFact(
        RewriteSemanticExpectedValue(
            view.graph, view.root_id, option_type, env
        )
    );
}
