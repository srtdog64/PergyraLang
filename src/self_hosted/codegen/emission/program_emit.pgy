// Program-level C assembly owner for self-host C emission.
import "../text/text_owner.pgy";
import "../../semantic/ast_artifact_verdict_owner.pgy";
import "../input/ast_arena_codegen_view_owner.pgy";
import "../input/ast_usage_owner.pgy";
import "../input/semantic_local_binding_codegen_view_owner.pgy";
import "../input/semantic_assignment_codegen_view_owner.pgy";
import "../input/semantic_body_type_codegen_view_owner.pgy";
import "../input/semantic_statement_codegen_view_owner.pgy";
import "../input/semantic_signature_codegen_view_owner.pgy";
import "../input/semantic_nominal_codegen_view_owner.pgy";
import "../input/semantic_role_codegen_view_owner.pgy";
import "../input/semantic_enum_codegen_view_owner.pgy";
import "../input/semantic_kind_codegen_view_owner.pgy";
import "../input/domain_runtime_codegen_view_owner.pgy";
import "../runtime_abi/collection_runtime_owner.pgy";
import "../runtime_abi/list_runtime_owner.pgy";
import "../runtime_abi/queue_runtime_owner.pgy";
import "../runtime_abi/set_runtime_owner.pgy";
import "../runtime_abi/checked_arithmetic_runtime_owner.pgy";
import "../runtime_abi/host_io_runtime_owner.pgy";
import "../runtime_abi/math_runtime_owner.pgy";
import "../runtime_abi/option_result_runtime_owner.pgy";
import "../runtime_abi/string_runtime_owner.pgy";
import "../runtime_abi/text_builder_runtime_owner.pgy";
import "../runtime_abi/runtime_header_owner.pgy";
import "../runtime_abi/runtime_header_ownership_owner.pgy";
import "../runtime_abi/zone_runtime_owner.pgy";
import "../../compiler/machine_layer_runtime_projection_owner.pgy";
import "../../compiler/machine_layer_runtime_binding_owner.pgy";
import "../../compiler/runtime_call_abi_structured_fact_owner.pgy";
import "type_declaration_emit_owner.pgy";
import "program_function_definition_block_owner.pgy";
import "role_dispatch_emit_owner.pgy";
import "result_runtime_emit_owner.pgy";
import "program_statement_shape_owner.pgy";
import "intent_emit_owner.pgy";
import "intent_execution_plan_emit_owner.pgy";
import "../runtime_abi/spawn_runtime_owner.pgy";
func CheckFunction(count: Int, arena: AstArena,
                   signatures: SemanticAstFunctionSignatureFacts,
                   local_bindings: SemanticAstLocalBindingFacts,
                   assignments: SemanticAstAssignmentFacts,
                   statements: SemanticAstStatementFacts,
                   inout cur: Array<Int>, f_indent: Int) -> Bool {
    let signature_index: Int = CodegenSemanticSignatureIndexOrDie(
        signatures, cur[0]
    );
    let param_index: Int = 0;
    let param_count: Int = CodegenSemanticFunctionParamCountOrDie(
        signatures, signature_index
    );
    ArraySet(cur, 0, cur[0] + 1);
    CodegenAstArenaSkipGenericParams(arena, count, cur);
    CodegenAstArenaExpectParameters(arena, count, cur);
    while cur[0] < count && CodegenAstArenaIndentOrDie(arena, cur[0]) == f_indent + 4 {
        let p_mode: Int = CodegenSemanticFunctionParamModeOrDie(
            signatures, signature_index, param_index
        );
        CodegenSemanticFunctionParamNameForNodeOrDie(
            signatures, signature_index, param_index, cur[0]
        );
        param_index = param_index + 1;
        ArraySet(cur, 0, cur[0] + 1);
    }
    if param_index != param_count {
        Die("semantic signature parameter count does not match AST traversal");
    }
    if cur[0] >= count || !CodegenAstArenaIsReturns(arena, cur[0]) {
        Die("expected Returns: line after parameters");
    }
    ArraySet(cur, 0, cur[0] + 1);
    CodegenSemanticCallableContractAdvanceOrDie(
        signatures, signature_index, arena, count, cur
    );
    CodegenAstArenaExpectBody(arena, count, cur);
    CodegenAstArenaExpectBlock(arena, count, cur);
    return CheckStmtList(
        count, arena, local_bindings, assignments, statements,
        f_indent + 6, cur
    );
}
func CheckCUnitFromSemanticArtifact(
    artifact: AstTreeArtifact,
    semantic_analysis: SemanticAstArtifactAnalysis,
    require_entrypoint: Bool
) -> Bool {
    if !semantic_analysis.verdict.ok {
        Die(semantic_analysis.verdict.diagnostic_message);
    }
    if !SemanticAstArtifactAdmissionReady(
        artifact, semantic_analysis, require_entrypoint
    ) {
        Die("codegen semantic admission receipt is missing or stale");
    }
    Log("Phase: codegen-check:surface:start");
    RejectUnsupportedCodegenBuiltins(artifact.tree_text);
    Log("Phase: codegen-check:surface:done");
    let count: Int = artifact.count;
    let arena: AstArena = artifact.arena;
    let main_scan: Int = 0;
    Log("Phase: codegen-check:event-scan:start");
    while main_scan < count {
        if CodegenSemanticKindIs(
            semantic_analysis.kind_surfaces, main_scan,
            TypedAstKindEventDeclTag()
        ) {
            Die(Concat("event declarations are not supported (no handler/dispatch model): ", CodegenAstArenaProvenanceOrDie(arena, main_scan)));
        }
        main_scan = main_scan + 1;
    }
    Log("Phase: codegen-check:event-scan:done");
    Log("Phase: codegen-check:shape:start");
    let cur: Array<Int> = [0];
    let saw_function: Bool = false;
    while cur[0] < count {
        let cur_node: Int = cur[0];
        let cur_indent: Int = CodegenAstArenaIndentOrDie(arena, cur_node);
        if CodegenAstArenaIsProgramRoot(arena, cur[0]) {
            ArraySet(cur, 0, cur[0] + 1);
        } else if CodegenSemanticKindIs(
            semantic_analysis.kind_surfaces, cur[0],
            TypedAstKindAbilityDeclTag()
        ) {
            let decl_node: Int = cur_node;
            ArraySet(cur, 0, cur[0] + 1);
            while cur[0] < count && CodegenAstArenaIsDescendantOf(arena, cur[0], decl_node) {
                ArraySet(cur, 0, cur[0] + 1);
            }
        } else if CodegenSemanticNominalIs(
            semantic_analysis.constructors, cur[0]
        ) {
            let owner_node: Int = cur_node;
            ArraySet(cur, 0, cur[0] + 1);
            while cur[0] < count && CodegenAstArenaIsDescendantOf(arena, cur[0], owner_node) {
                if CodegenSemanticFunctionIs(
                    semantic_analysis.signatures, cur[0]
                ) {
                    let method_indent: Int = CodegenAstArenaIndentOrDie(arena, cur[0]);
                    CheckFunction(
                        count, arena, semantic_analysis.signatures,
                        semantic_analysis.local_bindings,
                        semantic_analysis.assignments,
                        semantic_analysis.statements,
                        cur, method_indent
                    );
                    saw_function = true;
                } else {
                    ArraySet(cur, 0, cur[0] + 1);
                }
            }
        } else if CodegenSemanticRoleIs(semantic_analysis.roles, cur[0]) {
            let role_owner_node: Int = cur_node;
            ArraySet(cur, 0, cur[0] + 1);
            while cur[0] < count && CodegenAstArenaIsDescendantOf(arena, cur[0], role_owner_node) {
                if CodegenSemanticFunctionIs(
                    semantic_analysis.signatures, cur[0]
                ) {
                    let role_method_indent: Int = CodegenAstArenaIndentOrDie(arena, cur[0]);
                    CheckFunction(
                        count, arena, semantic_analysis.signatures,
                        semantic_analysis.local_bindings,
                        semantic_analysis.assignments,
                        semantic_analysis.statements,
                        cur, role_method_indent
                    );
                    saw_function = true;
                } else {
                    ArraySet(cur, 0, cur[0] + 1);
                }
            }
        } else if CodegenSemanticEnumIs(semantic_analysis.enums, cur[0]) {
            ArraySet(cur, 0, cur[0] + 1);
        } else if CodegenSemanticKindIs(
            semantic_analysis.kind_surfaces, cur[0],
            TypedAstKindEventDeclTag()
        ) {
            Die(Concat("event declarations are not supported (no handler/dispatch model): ", CodegenAstArenaProvenanceOrDie(arena, cur[0])));
        } else if CodegenSemanticFunctionIs(
            semantic_analysis.signatures, cur[0]
        ) {
            CheckFunction(
                count, arena, semantic_analysis.signatures,
                semantic_analysis.local_bindings,
                semantic_analysis.assignments,
                semantic_analysis.statements,
                cur, cur_indent
            );
            saw_function = true;
        } else {
            ArraySet(cur, 0, cur[0] + 1);
        }
    }
    Log("Phase: codegen-check:shape:done");
    if require_entrypoint && !saw_function { Die("no function found in AST"); }
    return true;
}
func CheckCUnit(tree_text: String, require_entrypoint: Bool) -> Bool {
    let artifact: AstTreeArtifact = AstTreeArtifactFromText(tree_text);
    return CheckCUnitFromSemanticArtifact(
        artifact, SemanticAstArtifactAnalyzeCompactBridge(artifact, require_entrypoint), require_entrypoint
    );
}
// Ready core for an analysis admitted by the semantic owner. The semantic
// fact-family arrays are immutable in this call graph.  Keep this core free of
// whole-artifact reconstruction: the fixed-size artifact identity is checked
// here, while checked compatibility entrypoints remain above.
func GenerateCUnitFromReadySemanticFacts(
    artifact: AstTreeArtifact,
    semantic_analysis: SemanticAstArtifactAnalysis,
    own body_types: CodegenSemanticBodyTypeFacts,
    receiver_facts: CodegenCallableReceiverFacts,
    ref domain_runtime: CodegenDomainRuntimeFacts,
    ref intent_execution: CodegenIntentExecutionView,
    require_entrypoint: Bool,
    machine_declaration: SelfHostMachineLayerDeclaration,
    observe_pressure: Bool
) -> String {
    if !SemanticAstArtifactAdmissionReady(
        artifact, semantic_analysis, require_entrypoint
    ) {
        Die("codegen semantic admission receipt is missing or stale");
    }
    RejectUnsupportedCodegenBuiltins(artifact.tree_text);
    if observe_pressure { Log("[codegen-pressure-stage] entry:ready"); }
    let count: Int = artifact.count;
    let arena: AstArena = artifact.arena;
    let signatures: SemanticAstFunctionSignatureFacts =
        semantic_analysis.signatures;
    if !CodegenCallableReceiverFactsAdmittedReady(receiver_facts, signatures) {
        Die("codegen callable receiver facts are missing or stale");
    }
    if !CodegenDomainRuntimeFactsAdmittedReady(domain_runtime) {
        Die("codegen domain runtime facts are missing or stale");
    }
    let local_bindings: SemanticAstLocalBindingFacts =
        semantic_analysis.local_bindings;
    let assignments: SemanticAstAssignmentFacts =
        semantic_analysis.assignments;
    let statements: SemanticAstStatementFacts = semantic_analysis.statements;
    let main_scan: Int = 0;
    while main_scan < count {
        // `event` declarations have no handler/dispatch model in this codegen.
        // Reject them with an observable CODEGEN ERROR rather than silently
        // dropping the declaration and emitting a call to an undefined symbol
        // (which would be unobservable broken C -- a no-op fake would be worse,
        // masking real event dispatch in programs that register handlers).
        if CodegenSemanticKindIs(
            semantic_analysis.kind_surfaces, main_scan,
            TypedAstKindEventDeclTag()
        ) {
            Die(Concat("event declarations are not supported (no handler/dispatch model): ", CodegenAstArenaProvenanceOrDie(arena, main_scan)));
        }
        main_scan = main_scan + 1;
    }
    let first_fn: Option<Int> = CodegenSemanticSelectedFunctionNode(
        signatures, require_entrypoint
    );
    if require_entrypoint && !IsSome(first_fn) {
        Die("no function found in AST");
    }
    let f_indent: Int = 2;
    if IsSome(first_fn) {
        f_indent = CodegenAstArenaIndentOrDie(arena, UnwrapOption(first_fn));
    }
    let specializations: CodegenGenericSpecializationFacts =
        body_types.generic_specializations;
    if !specializations.ok {
        Die(Concat(
            "generic specialization facts are incomplete: ",
            specializations.diagnostic_message
        ));
    }
    if !SemanticAstIntentSignatureFactsAdmittedReady(
        artifact, semantic_analysis.intent_signatures
    ) {
        Die("semantic intent signature facts are missing or stale");
    }
    if observe_pressure { Log("[codegen-pressure-stage] function-env:start"); }
    let env_acc: Array<String> = [BuildFunctionEnv(
        signatures, specializations, receiver_facts,
        semantic_analysis.intent_signatures
    )];
    if observe_pressure { Log("[codegen-pressure-stage] function-env:done"); }
    if observe_pressure { Log("[codegen-pressure-stage] value-wrappers:start"); }
    let value_wrappers: CodegenValueWrapperUsageFacts =
        CodegenValueWrapperUsageFactsFromSemantic(
            semantic_analysis.type_surfaces, arena, signatures,
            specializations
        );
    if observe_pressure { Log("[codegen-pressure-stage] value-wrappers:done"); }
    if observe_pressure { Log("[codegen-pressure-stage] type-declarations:start"); }
    let type_declaration_fact: CodegenTypeDeclarationBlockFact =
        CollectTypeDeclarations(
        semantic_analysis.enums, semantic_analysis.constructors,
        semantic_analysis.roles,
        value_wrappers, env_acc
        );
    if observe_pressure { Log("[codegen-pressure-stage] type-declarations:done"); }
    if observe_pressure { Log("[codegen-pressure-stage] role-dispatch:start"); }
    let dispatch_type_block: String = CodegenSemanticRoleDispatchTypeBlock(
        semantic_analysis.roles, signatures,
        CodegenTypeEnvFromPresealRows(env_acc[0], "")
    );
    let dispatch_forward_block: String =
        CodegenSemanticRoleDispatchForwardBlock(semantic_analysis.roles);
    let dispatch_runtime_block: String =
        CodegenSemanticRoleDispatchRuntimeBlock(
            semantic_analysis.roles, signatures,
            semantic_analysis.constructors, env_acc
        );
    let operator_adapter_block: String = CollectRoleOperators(
        semantic_analysis.roles, signatures, env_acc
    );
    let type_declaration_block: String = Concat(
        dispatch_forward_block, Concat(
            type_declaration_fact.c_block, Concat(
                dispatch_type_block, Concat(
                    dispatch_runtime_block, operator_adapter_block
                )
            )
        )
    );
    if observe_pressure { Log("[codegen-pressure-stage] role-dispatch:done"); }
    if observe_pressure { Log("[codegen-pressure-stage] base-env:start"); }
    let base_env: CodegenTypeEnv = CodegenTypeEnvFromRows(env_acc[0], "");
    if observe_pressure { Log("[codegen-pressure-stage] base-env:done"); }
    if observe_pressure { Log("[codegen-pressure-stage] runtime-usage:start"); }
    let usage: CodegenRuntimeUsageFacts =
        CodegenRuntimeUsageFactsFromSemantic(
            semantic_analysis.expression_surfaces,
            semantic_analysis.type_surfaces,
            semantic_analysis.kind_surfaces,
            signatures,
            specializations,
            value_wrappers,
            base_env
        );
    if observe_pressure { Log("[codegen-pressure-stage] runtime-usage:done"); }
    if !usage.nominal_record_arrays.ok { Die("nominal record array usage facts are incomplete"); }
    let uses_args: Bool = usage.uses_args;
    if usage.uses_machine_layer &&
        !SelfHostMachineLayerDeclarationReady(machine_declaration) {
        Die("self-host machine-layer startup declaration is missing");
    }
    let machine_startup: String = CompilerMachineLayerRuntimeBindingStatement(machine_declaration);
    if usage.uses_spawn { machine_startup = Concat("    pgy_pool_init(0);\n    atexit(pgy_pool_shutdown);\n", machine_startup); }
    let definition_block: String = CodegenProgramFunctionDefinitionBlock(
        count, arena, signatures, semantic_analysis.constructors,
        semantic_analysis.roles, semantic_analysis.kind_surfaces, receiver_facts,
        local_bindings, assignments, statements, body_types,
        semantic_analysis.expression_surfaces, specializations, f_indent,
        base_env, machine_startup, uses_args, domain_runtime, observe_pressure
    );
    // Forward declarations come from a GenerateC-scope pre-pass.
    let proto_block: String = CollectProtos(
        signatures, semantic_analysis.roles, receiver_facts,
        base_env, specializations
    );
    let intent_proto_block: String = CodegenIntentPrototypeBlock(
        semantic_analysis.intent_signatures, base_env
    );
    let intent_definition_block: String = CodegenIntentDefinitionBlock(
        artifact, signatures, semantic_analysis.intent_signatures,
        semantic_analysis.zone_authorities,
        semantic_analysis.expression_surfaces, base_env, intent_execution
    );
    let admitted_intent_definition_block: String =
        CodegenIntentExecutionPlanDefinitionBlock(
            intent_execution, semantic_analysis.intent_signatures, base_env
        );
    if observe_pressure { Log("[codegen-pressure-stage] support-blocks:done"); }
    // String programs need the runtime string helpers; bool programs need
    // <stdbool.h>; array programs need the growable-array structs + stdlib;
    // int-only programs stay lean.
    let uses_str: Bool = usage.uses_str;
    let uses_math: Bool = usage.uses_math;
    let uses_array_sort: Bool = usage.uses_array_sort;
    let uses_array_reverse: Bool = usage.uses_array_reverse;
    let uses_array_map: Bool = usage.uses_array_map;
    let uses_array_filter: Bool = usage.uses_array_filter;
    let uses_result: Bool = usage.uses_result;
    let uses_option: Bool = usage.uses_option;
    let uses_bool: Bool = usage.uses_bool || usage.uses_array || usage.uses_log ||
        type_declaration_fact.requires_bool_header ||
        SemanticAstIntentSignatureCount(semantic_analysis.intent_signatures) > 0;
    let uses_exit: Bool = usage.uses_exit;
    let uses_array: Bool = usage.uses_array;
    let uses_list: Bool = usage.uses_list;
    let uses_queue: Bool = usage.uses_queue;
    let uses_set: Bool = usage.uses_set;
    let uses_ast_text_node_array: Bool = usage.uses_ast_text_node_array;
    let uses_args2: Bool = usage.uses_args;
    let uses_io: Bool = usage.uses_io;
    let uses_join: Bool = usage.uses_join;
    let uses_split: Bool = usage.uses_split;
    let uses_dirwalk: Bool = usage.uses_dirwalk;
    let uses_log: Bool = usage.uses_log;
    let uses_fhandle: Bool = usage.uses_fhandle;
    let uses_artifact_transaction: Bool = usage.uses_artifact_transaction;
    let uses_print: Bool = usage.uses_print;
    let uses_float: Bool = usage.uses_float;
    let uses_random_value: Bool = usage.uses_random_value;
    let uses_seed_random: Bool = usage.uses_seed_random;
    let uses_random: Bool = usage.uses_random;
    let uses_text_builder: Bool = usage.uses_text_builder;
    let uses_runtime_header: Bool = RuntimeCHeaderRequired(usage.uses_allocator, uses_text_builder, usage.uses_box_array, uses_array, usage.uses_spawn, uses_list, uses_queue, uses_set, uses_artifact_transaction);
    let need_stdlib: Bool = uses_str || uses_exit || uses_array || uses_list || uses_queue || uses_set || uses_io || uses_fhandle || uses_artifact_transaction || uses_random || uses_float || uses_result || uses_option || usage.uses_allocator || uses_text_builder || usage.uses_spawn || intent_execution.present;
    let output_allocator: Allocator = AllocatorResult();
    let output: TextBuilder = TextBuilderNew(4096);
    TextBuilderAppend(output, "#include <stdio.h>\n");
    if usage.uses_machine_layer || usage.uses_slot { TextBuilderAppend(output, CompilerRuntimeCallAbiResourceRuntimeCPreamble(uses_log)); }
    if uses_bool {
        TextBuilderAppend(output, "#include <stdbool.h>\n");
    }
    if need_stdlib {
        TextBuilderAppend(output, "#include <stdlib.h>\n");
    }
    if uses_str || uses_array || uses_io || uses_fhandle || usage.uses_allocator || uses_text_builder {
        TextBuilderAppend(output, "#include <string.h>\n");
    }
    if uses_runtime_header { TextBuilderAppend(output, RuntimeCHeaderIncludeBlock(usage.uses_allocator, uses_text_builder, usage.uses_box_array, uses_array, usage.uses_spawn, uses_list, uses_queue, uses_set, uses_artifact_transaction)); }
    if uses_io || uses_fhandle {
        TextBuilderAppend(output, "#ifdef _WIN32\n#include <fcntl.h>\n#include <io.h>\n#else\n#include <fcntl.h>\n#include <sys/stat.h>\n#include <unistd.h>\n#endif\n");
    }
    if uses_float { TextBuilderAppend(output, "#include <math.h>\n"); }
    if uses_dirwalk {
        TextBuilderAppend(output, "#include <dirent.h>\n#include <sys/stat.h>\n");
    }
    TextBuilderAppend(output, "\n");
    if !RuntimeCHeaderOwnsCheckedArithmetic(usage.uses_allocator, uses_text_builder, usage.uses_box_array, uses_list, uses_queue, uses_set, uses_artifact_transaction) { TextBuilderAppend(output, CheckedArithmeticRuntimeCProgramBlock(usage.uses_checked_int_cast, usage.uses_checked_long_cast)); }
    if usage.uses_spawn { TextBuilderAppend(output, SpawnRuntimeCBlock()); }
    if uses_log {
        TextBuilderAppend(output, StringRuntimeCLogMaterializationBlock(
            usage.uses_slot || RuntimeCHeaderOwnsScalarLog(usage.uses_box_array, uses_list, uses_queue, uses_set, uses_artifact_transaction),
            usage.uses_machine_layer || usage.uses_slot || RuntimeCHeaderOwnsScalarLog(usage.uses_box_array, uses_list, uses_queue, uses_set, uses_artifact_transaction)
        ));
    }
    if uses_print {
        TextBuilderAppend(output, StringRuntimeCPrintBlock());
    }
    if uses_random_value {
        TextBuilderAppend(output, MathRuntimeCRandomValueBlock());
    }
    if uses_seed_random {
        TextBuilderAppend(output, MathRuntimeCSeedRandomBlock());
    }
    if uses_result { TextBuilderAppend(output, OptionResultRuntimeCResultIntBlock()); if usage.uses_remote_future { TextBuilderAppend(output, CompilerRuntimeCallAbiMachineLayerRemoteFutureAwaitHelperBlock()); } }
    if uses_option {
        TextBuilderAppend(output, OptionResultRuntimeCOptionScalarBlock());
    }
    if uses_io || uses_fhandle {
        TextBuilderAppend(output, HostIORuntimeCPathAndSecureOpenBlock());
    }
    if uses_fhandle {
        TextBuilderAppend(output, HostIORuntimeCFileHandleBlock());
    }
    if uses_array {
        TextBuilderAppend(output, CollectionRuntimeCArrayBlock(
            uses_array_sort,
            uses_array_reverse,
            uses_array_map,
            uses_array_filter
        ));
    }
    let record_array_block: String = CollectionRuntimeRecordArrayBlocks(
        uses_ast_text_node_array, usage.nominal_record_arrays.element_types);
    let list_type_index: Int = 0;
    while list_type_index < ArrayLength(usage.list_type_names) {
        TextBuilderAppend(
            output,
            CollectionListRuntimeSpecializationBlock(
                usage.list_type_names[list_type_index]
            )
        );
        list_type_index = list_type_index + 1;
    }
    let queue_type_index: Int = 0;
    while queue_type_index < ArrayLength(usage.queue_type_names) {
        TextBuilderAppend(
            output,
            CollectionQueueRuntimeSpecializationBlock(
                usage.queue_type_names[queue_type_index]
            )
        );
        queue_type_index = queue_type_index + 1;
    }
    let set_type_index: Int = 0;
    while set_type_index < ArrayLength(usage.set_type_names) {
        TextBuilderAppend(
            output,
            CollectionSetRuntimeSpecializationBlock(
                usage.set_type_names[set_type_index]
            )
        );
        set_type_index = set_type_index + 1;
    }
    if uses_args2 {
        TextBuilderAppend(output, HostIORuntimeCArgsBlock());
    }
    if uses_str {
        TextBuilderAppend(output, StringRuntimeCStringCoreBlock(
            RuntimeCHeaderOwnsBoolToString(
                usage.uses_box_array, uses_list, uses_queue, uses_set,
                uses_artifact_transaction
            )
        ));
    }
    if uses_math {
        TextBuilderAppend(output, MathRuntimeCIntUtilityBlock());
    }
    if uses_split {
        TextBuilderAppend(output, StringRuntimeCSplitBlock());
    }
    if uses_join {
        TextBuilderAppend(output, StringRuntimeCStringJoinBlock());
    }
    if uses_io {
        TextBuilderAppend(output, HostIORuntimeCFileIOBlock());
    }
    if uses_dirwalk {
        TextBuilderAppend(output, HostIORuntimeCDirWalkBlock());
    }
    if CodegenDomainRuntimeHasZoneOwners(domain_runtime) {
        // Zone lock/generation storage is an isolated C ABI so a generated
        // unit does not re-import scalar runtime bodies it already emitted.
        TextBuilderAppend(output, DomainRuntimeZoneCHeaderIncludeBlock());
    }
    TextBuilderAppend(output, type_declaration_block);
    TextBuilderAppend(output, record_array_block);
    TextBuilderAppend(output, CodegenDomainRuntimeSyncBlock(domain_runtime));
    if usage.uses_machine_layer { TextBuilderAppend(output, CompilerMachineLayerRuntimeBindingBlock(machine_declaration)); }
    TextBuilderAppend(output, proto_block);
    TextBuilderAppend(output, intent_proto_block);
    TextBuilderAppend(output, intent_definition_block);
    TextBuilderAppend(output, admitted_intent_definition_block);
    if observe_pressure { Log("[codegen-pressure-stage] output-prefix:done"); }
    TextBuilderAppend(output, definition_block);
    let owned_definition_block: Array<String> = [definition_block];
    ArrayDropOwnedStrings(owned_definition_block);
    let generated_c: String = TextBuilderFinish(output, output_allocator);
    if observe_pressure { Log("[codegen-pressure-stage] output:finished"); }
    AllocatorDestroy(output_allocator);
    return generated_c;
}
