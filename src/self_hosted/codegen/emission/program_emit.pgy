// src/self_hosted/codegen/emission/program_emit.pgy
//
// Program-level C assembly owner for self-host C emission.

import "../text/text_owner.pgy";
import "../input/ast_text_inventory_owner.pgy";
import "../input/ast_text_typed_arena_owner.pgy";
import "../input/ast_usage_owner.pgy";
import "../runtime_abi/collection_runtime_owner.pgy";
import "../runtime_abi/host_io_runtime_owner.pgy";
import "../runtime_abi/math_runtime_owner.pgy";
import "../runtime_abi/option_result_runtime_owner.pgy";
import "../runtime_abi/string_runtime_owner.pgy";
import "function_emit.pgy";

func GenerateCUnit(tree_text: String, require_entrypoint: Bool) -> String {
    RejectUnsupportedCodegenBuiltins(tree_text);

    let nodes: Array<CodegenAstTextNode> = [];
    let node_count_box: Array<Int> = [0];
    CodegenAstTextNodeInventory(tree_text, nodes, node_count_box);

    let count: Int = node_count_box[0];
    if !CodegenTypedAstBridgeReady(nodes, count) {
        Die("codegen AST text bridge failed typed AST arena contract");
    }
    let arena: AstArena = CodegenAstTextTypedArenaFromNodes(nodes, count);
    let main_count: Int = 0;
    let main_scan: Int = 0;
    while main_scan < count {
        // `event` declarations have no handler/dispatch model in this codegen.
        // Reject them with an observable CODEGEN ERROR rather than silently
        // dropping the declaration and emitting a call to an undefined symbol
        // (which would be unobservable broken C -- a no-op fake would be worse,
        // masking real event dispatch in programs that register handlers).
        if CodegenAstArenaIsEventDecl(arena, main_scan) {
            Die(Concat("event declarations are not supported (no handler/dispatch model): ", CodegenAstTextProvenance(nodes[main_scan])));
        }
        if CodegenAstArenaIsMainFunction(arena, main_scan) {
            main_count = main_count + 1;
        }
        main_scan = main_scan + 1;
    }
    if require_entrypoint {
        if main_count != 1 {
            Die(Concat("exactly one `Main` function is required; saw count=", ToString(main_count)));
        }
    } else {
        if main_count > 1 {
            Die(Concat("at most one `Main` function is allowed in a codegen unit; saw count=", ToString(main_count)));
        }
    }

    let first_fn: Int = -1;
    let scan: Int = 0;
    while scan < count {
        if CodegenAstArenaIsMainFunction(arena, scan) {
            first_fn = scan;
            scan = count;
        } else if !require_entrypoint && first_fn < 0 && CodegenAstArenaIsFunction(arena, scan) {
            first_fn = scan;
            scan = scan + 1;
        } else {
            scan = scan + 1;
        }
    }
    if require_entrypoint && first_fn < 0 {
        Die("no function found in AST");
    }
    let f_indent: Int = 2;
    if first_fn >= 0 {
        f_indent = CodegenAstArenaIndentOrDie(arena, first_fn);
    }
    let env_acc: Array<String> = [BuildFunctionEnv(nodes, count, arena)];
    let enum_block: String = CollectEnums(nodes, count, arena, env_acc);
    let typedef_block: String = CollectStructs(nodes, count, arena, env_acc);
    CollectRoleOperators(nodes, count, arena, env_acc);
    let base_env: String = env_acc[0];
    let usage: CodegenRuntimeUsageFacts = CodegenRuntimeUsageFactsFromArena(arena, count);
    let uses_args: Bool = usage.uses_args;

    let defs: String = "";
    let cur: Array<Int> = [0];
    while cur[0] < count {
        let cur_node: Int = cur[0];
        let cur_indent: Int = CodegenAstArenaIndentOrDie(arena, cur_node);
        if CodegenAstArenaIsZeroArtifactDecl(arena, cur[0]) {
            let decl_node: Int = cur_node;
            ArraySet(cur, 0, cur[0] + 1);
            while cur[0] < count && CodegenAstArenaIsDescendantOf(arena, cur[0], decl_node) {
                ArraySet(cur, 0, cur[0] + 1);
            }
        } else if CodegenAstArenaIsNominalDecl(arena, cur[0]) {
            let owner_name: String = CodegenAstArenaAtomOrDie(arena, cur[0]);
            let owner_node: Int = cur_node;
            ArraySet(cur, 0, cur[0] + 1);
            while cur[0] < count && CodegenAstArenaIsDescendantOf(arena, cur[0], owner_node) {
                if CodegenAstArenaIsFunction(arena, cur[0]) {
                    let method_indent: Int = CodegenAstArenaIndentOrDie(arena, cur[0]);
                    let mdef: String = EmitFunction(nodes, count, arena, cur, method_indent, base_env, uses_args, owner_name);
                    defs = Concat(defs, Concat(mdef, "\n"));
                } else {
                    ArraySet(cur, 0, cur[0] + 1);
                }
            }
        } else if CodegenAstArenaIsRoleDecl(arena, cur[0]) {
            let role_owner_name: String = CodegenAstArenaAtomOrDie(arena, cur[0]);
            let role_owner_node: Int = cur_node;
            ArraySet(cur, 0, cur[0] + 1);
            while cur[0] < count && CodegenAstArenaIsDescendantOf(arena, cur[0], role_owner_node) {
                if CodegenAstArenaIsFunction(arena, cur[0]) {
                    let role_method_indent: Int = CodegenAstArenaIndentOrDie(arena, cur[0]);
                    let role_mdef: String = EmitFunction(nodes, count, arena, cur, role_method_indent, base_env, uses_args, role_owner_name);
                    defs = Concat(defs, Concat(role_mdef, "\n"));
                } else {
                    ArraySet(cur, 0, cur[0] + 1);
                }
            }
        } else if CodegenAstArenaIsFunction(arena, cur[0]) && cur_indent == f_indent {
            let def: String = EmitFunction(nodes, count, arena, cur, f_indent, base_env, uses_args, "");
            defs = Concat(defs, Concat(def, "\n"));
        } else {
            ArraySet(cur, 0, cur[0] + 1);
        }
    }

    // Forward declarations come from a GenerateC-scope pre-pass.
    let proto_block: String = CollectProtos(nodes, count, arena, base_env);
    let option_struct_block_fact: OptionStructDefinitionBlockFact = OptionResultRuntimeCStructOptionDefinitionBlock(base_env);
    let option_struct_block: String = option_struct_block_fact.c_block;

    // String programs need the runtime string helpers; bool programs need
    // <stdbool.h>; array programs need the growable-array structs + stdlib;
    // int-only programs stay lean.
    let uses_str: Bool = usage.uses_str;
    let uses_math: Bool = usage.uses_math;
    let uses_array_sort: Bool = usage.uses_array_sort;
    let uses_array_reverse: Bool = usage.uses_array_reverse;
    let uses_array_map: Bool = usage.uses_array_map;
    let uses_array_filter: Bool = usage.uses_array_filter;
    let uses_result: Bool = usage.uses_result;
    let uses_option: Bool = usage.uses_option;
    let uses_bool: Bool = usage.uses_bool;
    let uses_exit: Bool = usage.uses_exit;
    let uses_array: Bool = usage.uses_array;
    let uses_ast_text_node_array: Bool = usage.uses_ast_text_node_array;
    let uses_args2: Bool = usage.uses_args;
    let uses_io: Bool = usage.uses_io;
    let uses_join: Bool = usage.uses_join;
    let uses_split: Bool = usage.uses_split;
    let uses_dirwalk: Bool = usage.uses_dirwalk;
    let uses_log: Bool = usage.uses_log;
    let uses_fhandle: Bool = usage.uses_fhandle;
    let uses_print: Bool = usage.uses_print;
    let uses_float: Bool = usage.uses_float;
    let uses_random_value: Bool = usage.uses_random_value;
    let uses_seed_random: Bool = usage.uses_seed_random;
    let uses_random: Bool = usage.uses_random;
    let need_stdlib: Bool = uses_str || uses_exit || uses_array || uses_io || uses_fhandle || uses_random || uses_float || uses_result || uses_option;
    let header: String = "#include <stdio.h>\n";
    if uses_bool {
        header = Concat(header, "#include <stdbool.h>\n");
    }
    if need_stdlib {
        header = Concat(header, "#include <stdlib.h>\n");
    }
    if uses_str || uses_io || uses_fhandle {
        header = Concat(header, "#include <string.h>\n");
    }
    if uses_io || uses_fhandle {
        header = Concat(header, "#ifdef _WIN32\n#include <fcntl.h>\n#include <io.h>\n#else\n#include <fcntl.h>\n#include <sys/stat.h>\n#include <unistd.h>\n#endif\n");
    }
    if uses_float {
        header = Concat(header, "#include <math.h>\n");
    }
    if uses_dirwalk {
        header = Concat(header, "#include <dirent.h>\n#include <sys/stat.h>\n");
    }
    header = Concat(header, "\n");
    if uses_log {
        header = Concat(header, StringRuntimeCLogBlock());
    }
    if uses_print {
        header = Concat(header, StringRuntimeCPrintBlock());
    }
    if uses_random_value {
        header = Concat(header, MathRuntimeCRandomValueBlock());
    }
    if uses_seed_random {
        header = Concat(header, MathRuntimeCSeedRandomBlock());
    }
    if uses_result {
        header = Concat(header, OptionResultRuntimeCResultIntBlock());
    }
    if uses_option {
        header = Concat(header, OptionResultRuntimeCOptionScalarBlock());
    }
    if uses_io || uses_fhandle {
        header = Concat(header, HostIORuntimeCPathAndSecureOpenBlock());
    }
    if uses_fhandle {
        header = Concat(header, HostIORuntimeCFileHandleBlock());
    }
    if uses_array {
        header = Concat(header, CollectionRuntimeCArrayBlock(
            uses_array_sort,
            uses_array_reverse,
            uses_array_map,
            uses_array_filter
        ));
    }
    let record_array_block: String = "";
    if uses_ast_text_node_array {
        record_array_block = CollectionRuntimeCodegenAstTextNodeArrayBlock();
    }
    if uses_args2 {
        header = Concat(header, HostIORuntimeCArgsBlock());
    }
    if uses_str {
        header = Concat(header, StringRuntimeCStringCoreBlock());
    }
    if uses_math {
        header = Concat(header, MathRuntimeCIntUtilityBlock());
    }
    // pgy_strjoin needs both the pgy_as struct (uses_array) and string.h
    // (uses_str); emit it only when StringJoin is actually used so string-only
    // programs do not reference an undefined pgy_as.
    if uses_split {
        header = Concat(header, "static pgy_as pgy_split(const char *s, const char *sep)\n{\n");
        header = Concat(header, Concat("    pgy_as a = ", Concat(CollectionRuntimeCNewFn(2), "();\n    size_t sl = strlen(sep);\n")));
        header = Concat(header, Concat("    if (sl == 0) { ", Concat(CollectionRuntimeCPushFn(2), "(&a, s); return a; }\n")));
        header = Concat(header, "    const char *start = s;\n    const char *p;\n");
        header = Concat(header, "    while ((p = strstr(start, sep)) != NULL) {\n");
        header = Concat(header, "        size_t len = (size_t)(p - start);\n");
        header = Concat(header, "        char *part = (char *)malloc(len + 1);\n");
        header = Concat(header, "        memcpy(part, start, len); part[len] = '\\0';\n");
        header = Concat(header, Concat("        ", Concat(CollectionRuntimeCPushFn(2), "(&a, part);\n        start = p + sl;\n    }\n")));
        header = Concat(header, "    char *last = (char *)malloc(strlen(start) + 1);\n");
        header = Concat(header, Concat("    strcpy(last, start);\n    ", Concat(CollectionRuntimeCPushFn(2), "(&a, last);\n    return a;\n}\n\n")));
    }
    if uses_join {
        header = Concat(header, "static char *pgy_strjoin(pgy_as a, const char *sep)\n{\n");
        header = Concat(header, "    size_t sl = strlen(sep);\n    size_t total = 0;\n");
        header = Concat(header, "    for (long long i = 0; i < a.len; i++) { total += strlen(a.data[i]); }\n");
        header = Concat(header, "    if (a.len > 1) { total += sl * (size_t)(a.len - 1); }\n");
        header = Concat(header, "    char *r = (char *)malloc(total + 1);\n    char *p = r;\n");
        header = Concat(header, "    for (long long i = 0; i < a.len; i++) {\n");
        header = Concat(header, "        if (i > 0) { memcpy(p, sep, sl); p += sl; }\n");
        header = Concat(header, "        size_t el = strlen(a.data[i]);\n        memcpy(p, a.data[i], el); p += el;\n    }\n");
        header = Concat(header, "    *p = '\\0';\n    return r;\n}\n\n");
    }
    if uses_io {
        header = Concat(header, HostIORuntimeCFileIOBlock());
    }
    if uses_dirwalk {
        // DirWalk: recursive regular-file walk, `/`-joined paths, flat lexical
        // sort -- matches the oracle's snapshot. Needs pgy_as (uses_array).
        header = Concat(header, "static void pgy_dirwalk_rec(const char *dir, pgy_as *out)\n{\n");
        header = Concat(header, "    DIR *d = opendir(dir);\n    if (!d) { return; }\n");
        header = Concat(header, "    struct dirent *e;\n    while ((e = readdir(d)) != NULL) {\n");
        header = Concat(header, "        if (strcmp(e->d_name, \".\") == 0 || strcmp(e->d_name, \"..\") == 0) { continue; }\n");
        header = Concat(header, "        char *path = (char *)malloc(strlen(dir) + strlen(e->d_name) + 2);\n");
        header = Concat(header, "        sprintf(path, \"%s/%s\", dir, e->d_name);\n");
        header = Concat(header, "        struct stat st;\n");
        header = Concat(header, "        if (stat(path, &st) == 0) {\n");
        header = Concat(header, "            if (S_ISDIR(st.st_mode)) { pgy_dirwalk_rec(path, out); free(path); }\n");
        header = Concat(header, Concat("            else { ", Concat(CollectionRuntimeCPushFn(2), "(out, path); }\n")));
        header = Concat(header, "        } else { free(path); }\n    }\n    closedir(d);\n}\n");
        header = Concat(header, "static int pgy_str_cmp(const void *a, const void *b)\n{\n");
        header = Concat(header, "    return strcmp(*(const char **)a, *(const char **)b);\n}\n");
        header = Concat(header, "static pgy_as pgy_dirwalk(const char *dir)\n{\n");
        header = Concat(header, Concat("    pgy_as a = ", Concat(CollectionRuntimeCNewFn(2), "();\n    pgy_dirwalk_rec(dir, &a);\n")));
        header = Concat(header, "    qsort(a.data, (size_t)a.len, sizeof(const char *), pgy_str_cmp);\n");
        header = Concat(header, "    return a;\n}\n\n");
    }
    return Concat(header, Concat(enum_block, Concat(typedef_block, Concat(option_struct_block, Concat(record_array_block, Concat(proto_block, defs))))));
}

func GenerateC(tree_text: String) -> String {
    return GenerateCUnit(tree_text, true);
}
