// src/self_hosted/codegen/emission/program_emit.pgy
//
// Program-level C assembly owner for self-host C emission.

import "../text/text_owner.pgy";
import "../../hir/ast_text_inventory_owner.pgy";
import "../../semantic/ast_artifact_verdict_owner.pgy";
import "../input/ast_arena_codegen_view_owner.pgy";
import "../input/ast_usage_owner.pgy";
import "../runtime_abi/collection_runtime_owner.pgy";
import "../runtime_abi/host_io_runtime_owner.pgy";
import "../runtime_abi/math_runtime_owner.pgy";
import "../runtime_abi/option_result_runtime_owner.pgy";
import "../runtime_abi/string_runtime_owner.pgy";
import "../runtime_abi/text_builder_runtime_owner.pgy";
import "function_emit.pgy";

func CheckStmtList(nodes: Array<CodegenAstTextNode>, count: Int, arena: AstArena,
                  stmt_indent: Int, inout cur: Array<Int>) -> Bool {
    while cur[0] < count {
        let idx: Int = cur[0];
        let ind: Int = CodegenAstArenaIndentOrDie(arena, idx);
        if ind < stmt_indent {
            return true;
        }
        if ind > stmt_indent {
            Die(Concat("unexpected over-indented AST line: ", CodegenAstTextProvenance(nodes[idx])));
        }
        if CodegenAstArenaIsLetStmt(arena, idx) ||
            CodegenAstArenaIsAssignStmt(arena, idx) ||
            CodegenAstArenaIsLogStmt(arena, idx) ||
            CodegenAstArenaIsBareReturnStmt(arena, idx) ||
            CodegenAstArenaIsValueReturnStmt(arena, idx) ||
            CodegenAstArenaIsArraySetStmt(arena, idx) ||
            CodegenAstArenaIsArrayPushStmt(arena, idx) ||
            CodegenAstArenaIsArrayPopStmt(arena, idx) ||
            CodegenAstArenaIsExitStmt(arena, idx) ||
            CodegenAstArenaIsBreakStmt(arena, idx) ||
            CodegenAstArenaIsContinueStmt(arena, idx) ||
            CodegenAstArenaIsBareCallStmt(arena, idx) {
            ArraySet(cur, 0, idx + 1);
        } else if CodegenAstArenaIsDeferStmt(arena, idx) {
            ArraySet(cur, 0, idx + 1);
            CodegenAstArenaExpectBlock(arena, count, cur);
            CheckStmtList(nodes, count, arena, stmt_indent + 4, cur);
        } else if CodegenAstArenaIsForStmt(arena, idx) {
            ArraySet(cur, 0, idx + 1);
            CodegenAstArenaExpectBlock(arena, count, cur);
            CheckStmtList(nodes, count, arena, stmt_indent + 4, cur);
        } else if CodegenAstArenaIsWhileStmt(arena, idx) {
            ArraySet(cur, 0, idx + 1);
            CodegenAstArenaExpectBlock(arena, count, cur);
            CheckStmtList(nodes, count, arena, stmt_indent + 4, cur);
        } else if CodegenAstArenaIsIfStmt(arena, idx) {
            ArraySet(cur, 0, idx + 1);
            CodegenAstArenaExpectThen(arena, count, cur);
            CodegenAstArenaExpectBlock(arena, count, cur);
            CheckStmtList(nodes, count, arena, stmt_indent + 6, cur);
            if CodegenAstArenaHasElseAt(arena, count, cur[0], stmt_indent) {
                ArraySet(cur, 0, cur[0] + 1);
                if CodegenAstArenaIsElseIfAt(arena, count, cur[0]) {
                    CheckStmtList(nodes, count, arena, CodegenAstArenaIndentOrDie(arena, cur[0]), cur);
                } else {
                    CodegenAstArenaExpectBlock(arena, count, cur);
                    CheckStmtList(nodes, count, arena, stmt_indent + 6, cur);
                }
            }
        } else if CodegenAstArenaIsMatchStmt(arena, idx) {
            ArraySet(cur, 0, idx + 1);
            let match_case_count: Int = 0;
            while cur[0] < count && CodegenAstArenaIndentOrDie(arena, cur[0]) == stmt_indent + 2 {
                if CodegenAstArenaIsMatchCaseStmt(arena, cur[0]) {
                    ArraySet(cur, 0, cur[0] + 1);
                    CodegenAstArenaExpectBlock(arena, count, cur);
                    CheckStmtList(nodes, count, arena, stmt_indent + 6, cur);
                    match_case_count = match_case_count + 1;
                } else if CodegenAstArenaIsMatchDefaultStmt(arena, cur[0]) {
                    Die("match default is not supported in self-host codegen subset");
                } else {
                    Die(Concat("expected match case in self-host codegen subset: ", CodegenAstTextProvenance(nodes[cur[0]])));
                }
            }
            if match_case_count == 0 {
                Die(Concat("match statement has no cases: ", CodegenAstTextProvenance(nodes[idx])));
            }
        } else {
            Die(Concat("unsupported AST line in supported subset: ", CodegenAstTextProvenance(nodes[idx])));
        }
    }
    return true;
}

func CheckFunction(nodes: Array<CodegenAstTextNode>, count: Int, arena: AstArena,
                   signatures: SemanticAstFunctionSignatureFacts,
                   inout cur: Array<Int>, f_indent: Int) -> Bool {
    let signature_index: Int = CodegenSemanticSignatureIndexOrDie(
        signatures, cur[0]
    );
    let param_index: Int = 0;
    let param_count: Int = CodegenSemanticFunctionParamCountOrDie(
        signatures, signature_index
    );
    ArraySet(cur, 0, cur[0] + 1);
    CodegenAstArenaExpectParameters(arena, count, cur);
    while cur[0] < count && CodegenAstArenaIndentOrDie(arena, cur[0]) == f_indent + 4 {
        let p_mode: Int = CodegenSemanticFunctionParamModeOrDie(
            signatures, signature_index, param_index
        );
        CodegenSemanticFunctionParamNameForNodeOrDie(
            signatures, signature_index, param_index, cur[0]
        );
        param_index = param_index + 1;
        ArraySet(cur, 0, cur[0] + 1);
    }
    if param_index != param_count {
        Die("semantic signature parameter count does not match AST traversal");
    }
    if cur[0] >= count || !CodegenAstArenaIsReturns(arena, cur[0]) {
        Die("expected Returns: line after parameters");
    }
    ArraySet(cur, 0, cur[0] + 1);
    CodegenAstArenaExpectBody(arena, count, cur);
    CodegenAstArenaExpectBlock(arena, count, cur);
    return CheckStmtList(nodes, count, arena, f_indent + 6, cur);
}

func CheckCUnit(tree_text: String, require_entrypoint: Bool) -> Bool {
    RejectUnsupportedCodegenBuiltins(tree_text);

    let nodes: Array<CodegenAstTextNode> = [];
    let node_count_box: Array<Int> = [0];
    CodegenAstTextNodeInventory(tree_text, nodes, node_count_box);

    let count: Int = node_count_box[0];
    if !CodegenTypedAstBridgeReady(nodes, count) {
        Die("codegen AST text bridge failed typed AST arena contract");
    }
    let arena: AstArena = CodegenAstTextTypedArenaFromNodes(nodes, count);
    let artifact: AstTreeArtifact = AstTreeArtifact(tree_text, arena, count);
    let semantic_analysis: SemanticAstArtifactAnalysis =
        SemanticAstArtifactAnalyze(artifact, require_entrypoint);
    if !semantic_analysis.verdict.ok {
        Die(semantic_analysis.verdict.diagnostic_message);
    }
    let main_scan: Int = 0;
    while main_scan < count {
        if CodegenAstArenaIsEventDecl(arena, main_scan) {
            Die(Concat("event declarations are not supported (no handler/dispatch model): ", CodegenAstTextProvenance(nodes[main_scan])));
        }
        main_scan = main_scan + 1;
    }

    let cur: Array<Int> = [0];
    let saw_function: Bool = false;
    while cur[0] < count {
        let cur_node: Int = cur[0];
        let cur_indent: Int = CodegenAstArenaIndentOrDie(arena, cur_node);
        if CodegenAstArenaIsProgramRoot(arena, cur[0]) {
            ArraySet(cur, 0, cur[0] + 1);
        } else if CodegenAstArenaIsAbilityDecl(arena, cur[0]) {
            let decl_node: Int = cur_node;
            ArraySet(cur, 0, cur[0] + 1);
            while cur[0] < count && CodegenAstArenaIsDescendantOf(arena, cur[0], decl_node) {
                ArraySet(cur, 0, cur[0] + 1);
            }
        } else if CodegenAstArenaIsNominalDecl(arena, cur[0]) {
            let owner_node: Int = cur_node;
            ArraySet(cur, 0, cur[0] + 1);
            while cur[0] < count && CodegenAstArenaIsDescendantOf(arena, cur[0], owner_node) {
                if CodegenAstArenaIsFunction(arena, cur[0]) {
                    let method_indent: Int = CodegenAstArenaIndentOrDie(arena, cur[0]);
                    CheckFunction(
                        nodes, count, arena, semantic_analysis.signatures,
                        cur, method_indent
                    );
                    saw_function = true;
                } else {
                    ArraySet(cur, 0, cur[0] + 1);
                }
            }
        } else if CodegenAstArenaIsRoleDecl(arena, cur[0]) {
            let role_owner_node: Int = cur_node;
            ArraySet(cur, 0, cur[0] + 1);
            while cur[0] < count && CodegenAstArenaIsDescendantOf(arena, cur[0], role_owner_node) {
                if CodegenAstArenaIsFunction(arena, cur[0]) {
                    let role_method_indent: Int = CodegenAstArenaIndentOrDie(arena, cur[0]);
                    CheckFunction(
                        nodes, count, arena, semantic_analysis.signatures,
                        cur, role_method_indent
                    );
                    saw_function = true;
                } else {
                    ArraySet(cur, 0, cur[0] + 1);
                }
            }
        } else if CodegenAstArenaIsEnumDecl(arena, cur[0]) {
            ArraySet(cur, 0, cur[0] + 1);
        } else if CodegenAstArenaIsEventDecl(arena, cur[0]) {
            Die(Concat("event declarations are not supported (no handler/dispatch model): ", CodegenAstTextProvenance(nodes[cur[0]])));
        } else if CodegenAstArenaIsFunction(arena, cur[0]) {
            CheckFunction(
                nodes, count, arena, semantic_analysis.signatures,
                cur, cur_indent
            );
            saw_function = true;
        } else {
            ArraySet(cur, 0, cur[0] + 1);
        }
    }
    if require_entrypoint && !saw_function {
        Die("no function found in AST");
    }
    return true;
}

func GenerateCUnitFromSemanticArtifact(
    artifact: AstTreeArtifact,
    semantic_analysis: SemanticAstArtifactAnalysis,
    require_entrypoint: Bool
) -> String {
    RejectUnsupportedCodegenBuiltins(artifact.tree_text);

    let count: Int = artifact.count;
    let arena: AstArena = artifact.arena;
    if !CodegenAstTreeArtifactReady(artifact) {
        Die("codegen AST text bridge failed typed AST arena contract");
    }
    if !semantic_analysis.verdict.ok {
        Die(semantic_analysis.verdict.diagnostic_message);
    }
    if !SemanticAstArtifactAnalysisMatches(
        artifact, semantic_analysis, require_entrypoint
    ) {
        Die("codegen semantic evidence does not match AST artifact");
    }
    let signatures: SemanticAstFunctionSignatureFacts =
        semantic_analysis.signatures;
    let local_bindings: SemanticAstLocalBindingFacts =
        semantic_analysis.local_bindings;
    let assignments: SemanticAstAssignmentFacts =
        semantic_analysis.assignments;
    let statements: SemanticAstStatementFacts = semantic_analysis.statements;
    let main_scan: Int = 0;
    while main_scan < count {
        // `event` declarations have no handler/dispatch model in this codegen.
        // Reject them with an observable CODEGEN ERROR rather than silently
        // dropping the declaration and emitting a call to an undefined symbol
        // (which would be unobservable broken C -- a no-op fake would be worse,
        // masking real event dispatch in programs that register handlers).
        if CodegenAstArenaIsEventDecl(arena, main_scan) {
            Die(Concat("event declarations are not supported (no handler/dispatch model): ", CodegenAstArenaProvenanceOrDie(arena, main_scan)));
        }
        main_scan = main_scan + 1;
    }

    let first_fn: Int = -1;
    let scan: Int = 0;
    while scan < count {
        if CodegenAstArenaIsMainFunction(arena, scan) {
            first_fn = scan;
            scan = count;
        } else if !require_entrypoint && first_fn < 0 && CodegenAstArenaIsFunction(arena, scan) {
            first_fn = scan;
            scan = scan + 1;
        } else {
            scan = scan + 1;
        }
    }
    if require_entrypoint && first_fn < 0 {
        Die("no function found in AST");
    }
    let f_indent: Int = 2;
    if first_fn >= 0 {
        f_indent = CodegenAstArenaIndentOrDie(arena, first_fn);
    }
    let env_acc: Array<String> = [BuildFunctionEnv(signatures)];
    let enum_block: String = CollectEnums(semantic_analysis.enums, env_acc);
    let typedef_block: String = CollectStructs(
        semantic_analysis.constructors, env_acc
    );
    CollectRoleOperators(count, arena, signatures, env_acc);
    let base_env: CodegenTypeEnv = CodegenTypeEnv(env_acc[0], "");
    let usage: CodegenRuntimeUsageFacts = CodegenRuntimeUsageFactsFromArena(arena, count);
    let uses_args: Bool = usage.uses_args;

    let defs: Array<String> = [];
    let cur: Array<Int> = [0];
    while cur[0] < count {
        let cur_node: Int = cur[0];
        let cur_indent: Int = CodegenAstArenaIndentOrDie(arena, cur_node);
        if CodegenAstArenaIsAbilityDecl(arena, cur[0]) {
            let decl_node: Int = cur_node;
            ArraySet(cur, 0, cur[0] + 1);
            while cur[0] < count && CodegenAstArenaIsDescendantOf(arena, cur[0], decl_node) {
                ArraySet(cur, 0, cur[0] + 1);
            }
        } else if CodegenAstArenaIsNominalDecl(arena, cur[0]) {
            let owner_node: Int = cur_node;
            ArraySet(cur, 0, cur[0] + 1);
            while cur[0] < count && CodegenAstArenaIsDescendantOf(arena, cur[0], owner_node) {
                if CodegenAstArenaIsFunction(arena, cur[0]) {
                    let method_indent: Int = CodegenAstArenaIndentOrDie(arena, cur[0]);
                    let mdef: String = EmitFunction(
                        count, arena, signatures, local_bindings, assignments, statements,
                        cur, method_indent,
                        base_env, uses_args
                    );
                    ArrayPush(defs, Concat(mdef, "\n"));
                } else {
                    ArraySet(cur, 0, cur[0] + 1);
                }
            }
        } else if CodegenAstArenaIsRoleDecl(arena, cur[0]) {
            let role_owner_node: Int = cur_node;
            ArraySet(cur, 0, cur[0] + 1);
            while cur[0] < count && CodegenAstArenaIsDescendantOf(arena, cur[0], role_owner_node) {
                if CodegenAstArenaIsFunction(arena, cur[0]) {
                    let role_method_indent: Int = CodegenAstArenaIndentOrDie(arena, cur[0]);
                    let role_mdef: String = EmitFunction(
                        count, arena, signatures, local_bindings, assignments, statements,
                        cur, role_method_indent,
                        base_env, uses_args
                    );
                    ArrayPush(defs, Concat(role_mdef, "\n"));
                } else {
                    ArraySet(cur, 0, cur[0] + 1);
                }
            }
        } else if CodegenAstArenaIsFunction(arena, cur[0]) && cur_indent == f_indent {
            let def: String = EmitFunction(
                count, arena, signatures, local_bindings, assignments, statements,
                cur, f_indent, base_env, uses_args
            );
            ArrayPush(defs, Concat(def, "\n"));
        } else {
            ArraySet(cur, 0, cur[0] + 1);
        }
    }

    // Forward declarations come from a GenerateC-scope pre-pass.
    let proto_block: String = CollectProtos(signatures, base_env);
    let option_struct_block_fact: OptionStructDefinitionBlockFact =
        OptionResultRuntimeCStructOptionDefinitionBlock(base_env.global_rows);
    let option_struct_block: String = option_struct_block_fact.c_block;

    // String programs need the runtime string helpers; bool programs need
    // <stdbool.h>; array programs need the growable-array structs + stdlib;
    // int-only programs stay lean.
    let uses_str: Bool = usage.uses_str;
    let uses_math: Bool = usage.uses_math;
    let uses_array_sort: Bool = usage.uses_array_sort;
    let uses_array_reverse: Bool = usage.uses_array_reverse;
    let uses_array_map: Bool = usage.uses_array_map;
    let uses_array_filter: Bool = usage.uses_array_filter;
    let uses_result: Bool = usage.uses_result;
    let uses_option: Bool = usage.uses_option;
    let uses_bool: Bool = usage.uses_bool || usage.uses_array ||
        option_struct_block_fact.requires_bool_header;
    let uses_exit: Bool = usage.uses_exit;
    let uses_array: Bool = usage.uses_array;
    let uses_ast_text_node_array: Bool = usage.uses_ast_text_node_array;
    let uses_args2: Bool = usage.uses_args;
    let uses_io: Bool = usage.uses_io;
    let uses_join: Bool = usage.uses_join;
    let uses_split: Bool = usage.uses_split;
    let uses_dirwalk: Bool = usage.uses_dirwalk;
    let uses_log: Bool = usage.uses_log;
    let uses_fhandle: Bool = usage.uses_fhandle;
    let uses_print: Bool = usage.uses_print;
    let uses_float: Bool = usage.uses_float;
    let uses_random_value: Bool = usage.uses_random_value;
    let uses_seed_random: Bool = usage.uses_seed_random;
    let uses_random: Bool = usage.uses_random;
    let uses_allocator: Bool = usage.uses_allocator;
    let uses_text_builder: Bool = usage.uses_text_builder;
    let need_stdlib: Bool = uses_str || uses_exit || uses_array || uses_io || uses_fhandle || uses_random || uses_float || uses_result || uses_option || uses_allocator || uses_text_builder;
    let output_allocator: Allocator = AllocatorResult();
    let output: TextBuilder = TextBuilderNew(4096);
    TextBuilderAppend(output, "#include <stdio.h>\n");
    if uses_bool {
        TextBuilderAppend(output, "#include <stdbool.h>\n");
    }
    if need_stdlib {
        TextBuilderAppend(output, "#include <stdlib.h>\n");
    }
    if uses_str || uses_io || uses_fhandle || uses_text_builder {
        TextBuilderAppend(output, "#include <string.h>\n");
    }
    if uses_allocator || uses_text_builder {
        TextBuilderAppend(output, "#include <stdint.h>\n#include <stddef.h>\n");
    }
    if uses_io || uses_fhandle {
        TextBuilderAppend(output, "#ifdef _WIN32\n#include <fcntl.h>\n#include <io.h>\n#else\n#include <fcntl.h>\n#include <sys/stat.h>\n#include <unistd.h>\n#endif\n");
    }
    if uses_float {
        TextBuilderAppend(output, "#include <math.h>\n");
    }
    if uses_dirwalk {
        TextBuilderAppend(output, "#include <dirent.h>\n#include <sys/stat.h>\n");
    }
    TextBuilderAppend(output, "\n");
    if uses_allocator || uses_text_builder {
        TextBuilderAppend(output, TextBuilderRuntimeCBlock());
    }
    if uses_log {
        TextBuilderAppend(output, StringRuntimeCLogBlock());
    }
    if uses_print {
        TextBuilderAppend(output, StringRuntimeCPrintBlock());
    }
    if uses_random_value {
        TextBuilderAppend(output, MathRuntimeCRandomValueBlock());
    }
    if uses_seed_random {
        TextBuilderAppend(output, MathRuntimeCSeedRandomBlock());
    }
    if uses_result {
        TextBuilderAppend(output, OptionResultRuntimeCResultIntBlock());
    }
    if uses_option {
        TextBuilderAppend(output, OptionResultRuntimeCOptionScalarBlock());
    }
    if uses_io || uses_fhandle {
        TextBuilderAppend(output, HostIORuntimeCPathAndSecureOpenBlock());
    }
    if uses_fhandle {
        TextBuilderAppend(output, HostIORuntimeCFileHandleBlock());
    }
    if uses_array {
        TextBuilderAppend(output, CollectionRuntimeCArrayBlock(
            uses_array_sort,
            uses_array_reverse,
            uses_array_map,
            uses_array_filter
        ));
    }
    let record_array_block: String = "";
    if uses_ast_text_node_array {
        record_array_block = CollectionRuntimeCodegenAstTextNodeArrayBlock();
    }
    if uses_args2 {
        TextBuilderAppend(output, HostIORuntimeCArgsBlock());
    }
    if uses_str {
        TextBuilderAppend(output, StringRuntimeCStringCoreBlock());
    }
    if uses_math {
        TextBuilderAppend(output, MathRuntimeCIntUtilityBlock());
    }
    if uses_split {
        TextBuilderAppend(output, StringRuntimeCSplitBlock());
    }
    if uses_join {
        TextBuilderAppend(output, StringRuntimeCStringJoinBlock());
    }
    if uses_io {
        TextBuilderAppend(output, HostIORuntimeCFileIOBlock());
    }
    if uses_dirwalk {
        TextBuilderAppend(output, HostIORuntimeCDirWalkBlock());
    }
    TextBuilderAppend(output, enum_block);
    TextBuilderAppend(output, typedef_block);
    TextBuilderAppend(output, option_struct_block);
    TextBuilderAppend(output, record_array_block);
    TextBuilderAppend(output, proto_block);
    let definition_index: Int = 0;
    while definition_index < ArrayLength(defs) {
        TextBuilderAppend(output, defs[definition_index]);
        definition_index = definition_index + 1;
    }
    let generated_c: String = TextBuilderFinish(output, output_allocator);
    AllocatorDestroy(output_allocator);
    return generated_c;
}

func GenerateCUnit(tree_text: String, require_entrypoint: Bool) -> String {
    return GenerateCUnitFromAstArtifact(AstTreeArtifactFromText(tree_text), require_entrypoint);
}

func GenerateCUnitFromAstArtifact(artifact: AstTreeArtifact, require_entrypoint: Bool) -> String {
    let semantic_analysis: SemanticAstArtifactAnalysis =
        SemanticAstArtifactAnalyze(artifact, require_entrypoint);
    return GenerateCUnitFromSemanticArtifact(
        artifact, semantic_analysis, require_entrypoint
    );
}

func GenerateCFromSemanticArtifact(
    artifact: AstTreeArtifact,
    semantic_analysis: SemanticAstArtifactAnalysis
) -> String {
    return GenerateCUnitFromSemanticArtifact(artifact, semantic_analysis, true);
}

func GenerateCFromAstArtifact(artifact: AstTreeArtifact) -> String {
    return GenerateCUnitFromAstArtifact(artifact, true);
}

func GenerateC(tree_text: String) -> String {
    return GenerateCUnit(tree_text, true);
}
