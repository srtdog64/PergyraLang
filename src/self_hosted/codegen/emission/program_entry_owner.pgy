// Public semantic and source entrypoints for the program emission core.
import "program_emit.pgy";
import "../text/text_owner.pgy";
import "../input/domain_runtime_codegen_view_owner.pgy";
import "../../compiler/machine_layer_declaration_consumer.pgy";
import "../../compiler/target_projection_fact_owner.pgy";
func GenerateCUnitFromSemanticArtifact(
    artifact: AstTreeArtifact,
    semantic_analysis: SemanticAstArtifactAnalysis,
    require_entrypoint: Bool,
    machine_declaration: SelfHostMachineLayerDeclaration
) -> String {
    let receiver_facts: CodegenCallableReceiverFacts =
        CodegenCallableReceiverFactsFromAnalysis(semantic_analysis);
    let bundle: SemanticAstBodyTypeBundle =
        SemanticAstBodyTypeBundleFromAnalysis(artifact, semantic_analysis);
    let generic_specializations: CodegenGenericSpecializationFacts =
        CodegenGenericSpecializationFactsFromSemantic(
            semantic_analysis.signatures, bundle.generic_specializations
        );
    let body_types: CodegenSemanticBodyTypeFacts =
        CodegenSemanticBodyTypeFactsFromBundleOrDie(
            artifact, semantic_analysis, bundle, generic_specializations
        );
    let domain_runtime: CodegenDomainRuntimeFacts =
        CodegenDomainRuntimeFactsEmpty(true);
    return GenerateCUnitFromSemanticFacts(
        artifact, semantic_analysis, body_types, receiver_facts,
        domain_runtime,
        require_entrypoint,
        machine_declaration
    );
}

func GenerateCFromVerifiedSemanticArtifact(
    artifact: AstTreeArtifact,
    semantic_analysis: SemanticAstArtifactAnalysis,
    own body_types: CodegenSemanticBodyTypeFacts,
    receiver_facts: CodegenCallableReceiverFacts,
    ref domain_runtime: CodegenDomainRuntimeFacts,
    machine_declaration: SelfHostMachineLayerDeclaration,
    target_projection: CompilerTargetProjectionFact
) -> String {
    if !CompilerTargetProjectionFactReadyFor(
        target_projection, CompilerTargetCpuCProjection()
    ) {
        Die("self-host C emission target projection fact is missing or invalid");
    }
    return GenerateCUnitFromSemanticFacts(
        artifact, semantic_analysis, body_types, receiver_facts,
        domain_runtime,
        true, machine_declaration
    );
}

func GenerateCUnit(tree_text: String, require_entrypoint: Bool) -> String {
    return GenerateCUnitFromAstArtifact(
        AstTreeArtifactFromText(tree_text), require_entrypoint
    );
}

func GenerateCUnitFromAstArtifact(
    artifact: AstTreeArtifact,
    require_entrypoint: Bool
) -> String {
    let semantic_analysis: SemanticAstArtifactAnalysis =
        SemanticAstArtifactAnalyzeCompactBridge(
            artifact, require_entrypoint
        );
    return GenerateCUnitFromSemanticArtifact(
        artifact, semantic_analysis, require_entrypoint,
        SelfHostMachineLayerDeclarationEmpty()
    );
}

func GenerateCUnitFromTypedAstArtifact(
    artifact: AstTreeArtifact,
    require_entrypoint: Bool
) -> String {
    let semantic_analysis: SemanticAstArtifactAnalysis =
        SemanticAstArtifactAnalyzeTyped(artifact, require_entrypoint);
    return GenerateCUnitFromSemanticArtifact(
        artifact, semantic_analysis, require_entrypoint,
        SelfHostMachineLayerDeclarationEmpty()
    );
}

func GenerateCFromSemanticArtifact(
    artifact: AstTreeArtifact,
    semantic_analysis: SemanticAstArtifactAnalysis
) -> String {
    return GenerateCUnitFromSemanticArtifact(
        artifact, semantic_analysis, true,
        SelfHostMachineLayerDeclarationEmpty()
    );
}

func GenerateCFromAstArtifact(artifact: AstTreeArtifact) -> String { return GenerateCUnitFromAstArtifact(artifact, true); }

func GenerateCFromTypedAstArtifact(artifact: AstTreeArtifact) -> String { return GenerateCUnitFromTypedAstArtifact(artifact, true); }
