// Recursive statement-shape admission for program-level C emission.

import "../text/text_owner.pgy";
import "../input/ast_arena_codegen_view_owner.pgy";
import "../input/semantic_local_binding_codegen_view_owner.pgy";
import "../input/semantic_assignment_codegen_view_owner.pgy";
import "../input/semantic_statement_codegen_view_owner.pgy";

func CodegenStatementShapeLeafKind(kind: Int) -> Bool {
    return kind == TypedAstKindLogStmtTag() ||
        kind == TypedAstKindBareReturnStmtTag() ||
        kind == TypedAstKindValueReturnStmtTag() ||
        kind == TypedAstKindArraySetStmtTag() ||
        kind == TypedAstKindArrayPushStmtTag() ||
        kind == TypedAstKindArrayPopStmtTag() ||
        kind == TypedAstKindExitStmtTag() ||
        kind == TypedAstKindBreakStmtTag() ||
        kind == TypedAstKindContinueStmtTag() ||
        kind == TypedAstKindBindStmtTag() ||
        kind == TypedAstKindBareCallStmtTag();
}

func CheckStmtList(count: Int, arena: AstArena,
                  local_bindings: SemanticAstLocalBindingFacts,
                  assignments: SemanticAstAssignmentFacts,
                  statements: SemanticAstStatementFacts,
                  stmt_indent: Int, inout cur: Array<Int>) -> Bool {
    while cur[0] < count {
        let idx: Int = cur[0];
        let ind: Int = CodegenAstArenaIndentOrDie(arena, idx);
        if ind < stmt_indent {
            return true;
        }
        if ind > stmt_indent {
            Die(Concat("unexpected over-indented AST line: ", CodegenAstArenaProvenanceOrDie(arena, idx)));
        }
        let statement_kind_opt: Option<Int> =
            CodegenSemanticStatementKindForNode(statements, idx);
        let statement_kind: Int = 0;
        if IsSome(statement_kind_opt) {
            statement_kind = UnwrapOption(statement_kind_opt);
        }
        if CodegenSemanticLocalBindingIs(local_bindings, idx) ||
            CodegenSemanticAssignmentIs(assignments, idx) ||
            CodegenStatementShapeLeafKind(statement_kind) {
            ArraySet(cur, 0, idx + 1);
        } else if statement_kind == TypedAstKindDeferStmtTag() {
            ArraySet(cur, 0, idx + 1);
            CodegenAstArenaExpectBlock(arena, count, cur);
            CheckStmtList(
                count, arena, local_bindings, assignments, statements,
                stmt_indent + 4, cur
            );
        } else if statement_kind == TypedAstKindForStmtTag() {
            ArraySet(cur, 0, idx + 1);
            CodegenAstArenaExpectBlock(arena, count, cur);
            CheckStmtList(
                count, arena, local_bindings, assignments, statements,
                stmt_indent + 4, cur
            );
        } else if statement_kind == TypedAstKindWhileStmtTag() {
            ArraySet(cur, 0, idx + 1);
            CodegenAstArenaExpectBlock(arena, count, cur);
            CheckStmtList(
                count, arena, local_bindings, assignments, statements,
                stmt_indent + 4, cur
            );
        } else if statement_kind == TypedAstKindIfStmtTag() {
            ArraySet(cur, 0, idx + 1);
            CodegenAstArenaExpectThen(arena, count, cur);
            CodegenAstArenaExpectBlock(arena, count, cur);
            CheckStmtList(
                count, arena, local_bindings, assignments, statements,
                stmt_indent + 6, cur
            );
            if CodegenAstArenaHasElseAt(arena, count, cur[0], stmt_indent) {
                ArraySet(cur, 0, cur[0] + 1);
                if CodegenSemanticStatementIs(
                    statements, cur[0], TypedAstKindIfStmtTag()
                ) {
                    CheckStmtList(
                        count, arena, local_bindings, assignments,
                        statements, CodegenAstArenaIndentOrDie(arena, cur[0]), cur
                    );
                } else {
                    CodegenAstArenaExpectBlock(arena, count, cur);
                    CheckStmtList(
                        count, arena, local_bindings, assignments,
                        statements, stmt_indent + 6, cur
                    );
                }
            }
        } else if statement_kind == TypedAstKindMatchStmtTag() {
            ArraySet(cur, 0, idx + 1);
            let match_case_count: Int = 0;
            while cur[0] < count && CodegenAstArenaIndentOrDie(arena, cur[0]) == stmt_indent + 2 {
                if CodegenSemanticStatementIs(
                    statements, cur[0], TypedAstKindMatchCaseStmtTag()
                ) {
                    ArraySet(cur, 0, cur[0] + 1);
                    CodegenAstArenaExpectBlock(arena, count, cur);
                    CheckStmtList(
                        count, arena, local_bindings, assignments,
                        statements, stmt_indent + 6, cur
                    );
                    match_case_count = match_case_count + 1;
                } else if CodegenSemanticStatementIs(
                    statements, cur[0], TypedAstKindMatchDefaultStmtTag()
                ) {
                    Die("match default is not supported in self-host codegen subset");
                } else {
                    Die(Concat("expected match case in self-host codegen subset: ", CodegenAstArenaProvenanceOrDie(arena, cur[0])));
                }
            }
            if match_case_count == 0 {
                Die(Concat("match statement has no cases: ", CodegenAstArenaProvenanceOrDie(arena, idx)));
            }
        } else {
            Die(Concat("unsupported AST line in supported subset: ", CodegenAstArenaProvenanceOrDie(arena, idx)));
        }
    }
    return true;
}
