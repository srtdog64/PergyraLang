// Queue<T> call return-type projection for codegen expression consumers.

import "../type_facts/type_env.pgy";
import "../../semantic/ast_expression_graph_call_view_owner.pgy";
import "../../semantic/ast_expression_call_target_fact_owner.pgy";
import "../runtime_abi/queue_runtime_owner.pgy";

func CodegenQueueCallName(name: String) -> Bool {
    return name == "QueuePush" || name == "QueuePop" ||
        name == "QueueSize" || name == "QueueEmpty";
}

func CodegenQueueCallApplies(
    graph: SemanticExpressionGraphFacts,
    root_id: Int
) -> Bool {
    let call: SemanticCallSpineView = SemanticCallSpineViewFromGraph(
        graph, root_id
    );
    if !call.ok { return false; }
    let callee: Option<String> = SemanticExpressionGraphNodeText(
        graph, call.callee_node
    );
    return IsSome(callee) && CodegenQueueCallName(UnwrapOption(callee));
}

func CodegenQueueCallReceiverType(
    graph: SemanticExpressionGraphFacts,
    receiver_node: Int,
    env: CodegenTypeEnv
) -> String {
    let kind: Option<Int> = SemanticExpressionGraphNodeKind(
        graph, receiver_node
    );
    let text: Option<String> = SemanticExpressionGraphNodeText(
        graph, receiver_node
    );
    if !IsSome(kind) || !IsSome(text) ||
        UnwrapOption(kind) != AstExpressionNodeLeaf() {
        return "";
    }
    return TypeEnvSemanticValueType(env, UnwrapOption(text));
}

func CodegenQueueCallReturnTypeFromGraph(
    graph: SemanticExpressionGraphFacts,
    root_id: Int,
    env: CodegenTypeEnv
) -> Option<String> {
    let call: SemanticCallSpineView = SemanticCallSpineViewFromGraph(
        graph, root_id
    );
    if !call.ok { return None; }
    let callee: Option<String> = SemanticExpressionGraphNodeText(
        graph, call.callee_node
    );
    if !IsSome(callee) || !CodegenQueueCallName(UnwrapOption(callee)) {
        return None;
    }
    let name: String = UnwrapOption(callee);
    let target_name: Option<String> = SemanticExpressionGraphCallTargetName(
        graph, call.call_node
    );
    if !IsSome(target_name) || UnwrapOption(target_name) != name {
        return None;
    }
    let expected_arity: Int = 1;
    if name == "QueuePush" { expected_arity = 2; }
    if ArrayLength(call.argument_nodes) != expected_arity { return None; }
    let receiver_type: String = CodegenQueueCallReceiverType(
        graph, call.argument_nodes[0], env
    );
    let fact: CollectionQueueRuntimeFact =
        CollectionQueueRuntimeFactFromTypeName(receiver_type);
    if !fact.ok { return None; }
    if name == "QueuePop" { return Some(fact.element_type); }
    if name == "QueueEmpty" { return Some("Bool"); }
    if name == "QueueSize" { return Some("Int"); }
    return Some("Void");
}
