// src/self_hosted/codegen/emission/stmt_emit.pgy
//
// Statement lowering owner for self-host C emission.

import "../text/text_owner.pgy";
import "../text/enum_literal_owner.pgy";
import "../text/expr_scan.pgy";
import "../type_facts/type_env.pgy";
import "../input/ast_text_array_literal_owner.pgy";
import "../input/ast_text_typed_arena_owner.pgy";
import "../input/ast_text_try_let_owner.pgy";
import "../input/ast_text_indexed_assignment_owner.pgy";
import "../abi_layout/abi_layout_owner.pgy";
import "../../compiler/symbol_table_owner.pgy";
import "../runtime_abi/collection_runtime_owner.pgy";
import "../runtime_abi/host_io_runtime_owner.pgy";
import "../runtime_abi/option_result_runtime_owner.pgy";
import "../runtime_abi/string_runtime_owner.pgy";
import "expr_rewrite.pgy";
import "struct_value_emit.pgy";

struct OptionExprEmissionFact {
    let c_expr: String;
}

func EmitOptionExprFactForType(expr: String, option_type: String, env: String) -> OptionExprEmissionFact {
    let option_struct_fact_opt: Option<OptionStructRuntimeFact> = OptionResultRuntimeStructOptionFact(option_type, env);
    if IsSome(option_struct_fact_opt) {
        let option_struct_fact: OptionStructRuntimeFact = UnwrapOption(option_struct_fact_opt);
        let trimmed: String = StringTrim(expr);
        if trimmed == "None" || trimmed == "None()" {
            return OptionExprEmissionFact(Concat(option_struct_fact.none_fn, "()"));
        }
        if StartsWith(trimmed, "Some(") {
            let open: Int = StringIndexOf(trimmed, "(");
            let close_opt: Option<Int> = FindMatchingParen(trimmed, open);
            if IsSome(close_opt) && UnwrapOption(close_opt) == StringLength(trimmed) - 1 {
                let payload: String = StringTrim(Substring(trimmed, open + 1, UnwrapOption(close_opt) - open - 1));
                let c_payload: String = EmitStructValue(payload, option_struct_fact.inner_type_name, env);
                return OptionExprEmissionFact(Concat(option_struct_fact.some_fn, Concat("(", Concat(c_payload, ")"))));
            }
        }
        return OptionExprEmissionFact(RewriteExpr(expr, env));
    }
    let option_payload_kind: Int = OptionResultRuntimeOptionPayloadKindForType(option_type);
    let option_expr: String = RewriteExpr(expr, env);
    let option_trimmed: String = StringTrim(expr);
    if option_trimmed == "None" || option_trimmed == "None()" {
        option_expr = Concat(OptionResultRuntimeCOptionNoneFnForPayloadKind(option_payload_kind), "()");
    }
    return OptionExprEmissionFact(option_expr);
}

func EmitCollectionElementValue(kind: String, value_expr: String, env: String, kind_code: Int) -> String {
    let elem_type: String = CollectionRuntimeElementTypeFromKindCode(kind_code);
    if elem_type == "String" {
        return StrEval(value_expr, env);
    }
    if elem_type == "CodegenAstTextNode" {
        return EmitStructValue(value_expr, elem_type, env);
    }
    return IntEval(value_expr, env);
}

func EmitLet(arena: AstArena, idx: Int, inout env_box: Array<String>) -> String {
    let name: String = CodegenAstArenaAtomOrDie(arena, idx);
    let type_name: String = CodegenAstArenaTypeNameOrDie(arena, idx);
    let expr: String = CodegenAstArenaValueOrDie(arena, idx);
    if type_name == "Int" {
        ArraySet(env_box, 0, Concat(env_box[0], Concat(name, "=v:Int|")));
        return Concat(AbiLayoutCLocalType(type_name, env_box[0]), Concat(" ", Concat(name, Concat(" = ", Concat(IntEval(expr, env_box[0]), ";")))));
    }
    if type_name == "Bool" {
        ArraySet(env_box, 0, Concat(env_box[0], Concat(name, "=v:Bool|")));
        return Concat(AbiLayoutCLocalType(type_name, env_box[0]), Concat(" ", Concat(name, Concat(" = ", Concat(IntEval(expr, env_box[0]), ";")))));
    }
    if type_name == "Float" {
        ArraySet(env_box, 0, Concat(env_box[0], Concat(name, "=v:Float|")));
        return Concat(AbiLayoutCLocalType(type_name, env_box[0]), Concat(" ", Concat(name, Concat(" = ", Concat(RewriteExpr(expr, env_box[0]), ";")))));
    }
    if type_name == "String" {
        ArraySet(env_box, 0, Concat(env_box[0], Concat(name, "=v:String|")));
        return Concat(AbiLayoutCLocalType(type_name, env_box[0]), Concat(" ", Concat(name, Concat(" = ", Concat(StrEval(expr, env_box[0]), ";")))));
    }
    if StartsWith(type_name, "Array<") {
        // rung-10: growable `Array<Int>` / `Array<String>` as a struct. A
        // `[a, b, c]` literal lowers to `new()` plus one `push` per element;
        // `[]` is just `new()`. `ArrayPush` later extends the same value.
        let array_kind: String = CollectionRuntimeKindFromTypeName(type_name);
        let array_kind_code: Int = CollectionRuntimeKindCode(array_kind);
        let c_type: String = AbiLayoutCLocalType(type_name, env_box[0]);
        let new_fn: String = CollectionRuntimeCNewFn(array_kind_code);
        let push_fn: String = CollectionRuntimeCPushFn(array_kind_code);
        ArraySet(env_box, 0, Concat(env_box[0], Concat(name, Concat("=v:", Concat(array_kind, "|")))));
        // Non-literal initializer (e.g. `Args()` or an array-returning call):
        // bind the array value directly.
        if !CodegenAstArenaLetInitializerStartsArrayLiteral(arena, idx) {
            return Concat(c_type, Concat(" ", Concat(name, Concat(" = ", Concat(RewriteExpr(expr, env_box[0]), ";")))));
        }
        let out: String = Concat(c_type, Concat(" ", Concat(name, Concat(" = ", Concat(new_fn, "();")))));
        let element_count: Int = CodegenAstArenaLetArrayLiteralElementCount(arena, idx);
        let element_index: Int = 0;
        while element_index < element_count {
            let elem_opt: Option<String> = CodegenAstArenaLetArrayLiteralElementAt(arena, idx, element_index);
            if IsSome(elem_opt) {
                let ev: String = EmitCollectionElementValue(array_kind, UnwrapOption(elem_opt), env_box[0], array_kind_code);
                out = Concat(out, Concat(" ", Concat(push_fn, Concat("(&", Concat(name, Concat(", ", Concat(ev, ");")))))));
            }
            element_index = element_index + 1;
        }
        return out;
    }
    if StartsWith(type_name, "Result<") && StringIndexOf(type_name, "Int") >= 0 {
        ArraySet(env_box, 0, Concat(env_box[0], Concat(name, "=v:ResultInt|")));
        return Concat(AbiLayoutCLocalType(type_name, env_box[0]), Concat(" ", Concat(name, Concat(" = ", Concat(RewriteExpr(expr, env_box[0]), ";")))));
    }
    if StartsWith(type_name, "Option<") {
        let option_payload_kind: Int = OptionResultRuntimeOptionPayloadKindForType(type_name);
        let option_kind: String = OptionResultRuntimeOptionEnvKindForPayloadKind(option_payload_kind);
        if StringLength(option_kind) == 0 {
            let option_struct_fact_opt: Option<OptionStructRuntimeFact> = OptionResultRuntimeStructOptionFact(type_name, env_box[0]);
            if IsSome(option_struct_fact_opt) {
                option_kind = type_name;
            }
        }
        if StringLength(option_kind) == 0 {
            Die(Concat("unsupported option let payload type: ", type_name));
        }
        ArraySet(env_box, 0, Concat(env_box[0], Concat(name, Concat("=v:", Concat(option_kind, "|")))));
        let option_expr_fact: OptionExprEmissionFact = EmitOptionExprFactForType(expr, type_name, env_box[0]);
        let option_expr: String = option_expr_fact.c_expr;
        return Concat(AbiLayoutCLocalType(type_name, env_box[0]), Concat(" ", Concat(name, Concat(" = ", Concat(option_expr, ";")))));
    }
    if LookupKindType(env_box[0], type_name, "s") == "struct" {
        // rung-14: struct-typed local from a `Name(f: v, ...)` literal or a
        // struct-returning call.
        ArraySet(env_box, 0, Concat(env_box[0], Concat(name, Concat("=v:", Concat(type_name, "|")))));
        return Concat(AbiLayoutCLocalType(type_name, env_box[0]), Concat(" ", Concat(name, Concat(" = ", Concat(EmitStructValue(expr, type_name, env_box[0]), ";")))));
    }
    Die(Concat("unsupported let type (only Int/Bool/Float/String/Array/Option/struct): ", type_name));
    return "";
}

func EmitTryLet(node: CodegenAstTextNode, arena: AstArena, idx: Int, inout env_box: Array<String>, cur_fn_ret: String, pad: String, cleanup: String) -> String {
    let name: String = CodegenAstArenaAtomOrDie(arena, idx);
    let type_name: String = CodegenAstArenaTypeNameOrDie(arena, idx);
    let inner_opt: Option<String> = CodegenAstArenaLetTryInner(arena, idx);
    if !IsSome(inner_opt) {
        Die(Concat("unsupported try let shape in self-host codegen subset: ", CodegenAstTextProvenance(node)));
    }
    let inner: String = UnwrapOption(inner_opt);
    let tmp: String = CompilerSymbolCTryTempName(idx);
    if StartsWith(cur_fn_ret, "Result<") && StringIndexOf(cur_fn_ret, "Int") >= 0 {
        if type_name != "Int" {
            Die(Concat("unsupported Result try let payload type in self-host codegen subset: ", CodegenAstTextProvenance(node)));
        }
        ArraySet(env_box, 0, Concat(env_box[0], Concat(name, "=v:Int|")));
        let result_out: String = Concat(AbiLayoutCLocalType("Result<Int>", env_box[0]), Concat(" ", Concat(tmp, Concat(" = ", Concat(RewriteExpr(inner, env_box[0]), ";\n")))));
        result_out = Concat(result_out, Concat(pad, Concat("if (!", Concat(OptionResultRuntimeCResultIsOkFn(), Concat("(", Concat(tmp, ")) {\n"))))));
        result_out = Concat(result_out, cleanup);
        result_out = Concat(result_out, Concat(pad, Concat("    return ", Concat(tmp, ";\n"))));
        result_out = Concat(result_out, Concat(pad, "}\n"));
        result_out = Concat(result_out, Concat(pad, Concat(AbiLayoutCLocalType("Int", env_box[0]), Concat(" ", Concat(name, Concat(" = ", Concat(OptionResultRuntimeCResultUnwrapFn(), Concat("(", Concat(tmp, ");")))))))));
        return result_out;
    }
    if StartsWith(cur_fn_ret, "Option<") {
        let return_option_payload_kind: Int = OptionResultRuntimeOptionPayloadKindForType(cur_fn_ret);
        if return_option_payload_kind == 0 {
            Die(Concat("unsupported option try return payload type: ", cur_fn_ret));
        }
        let inner_kind: String = ExprKind(inner, env_box[0]);
        let operand_payload_kind: Int = OptionResultRuntimeOptionPayloadKindForType(inner_kind);
        if operand_payload_kind == 0 {
            operand_payload_kind = OptionResultRuntimeOptionPayloadKindFromEnvKind(inner_kind);
        }
        let operand_value_type: String = OptionResultRuntimeOptionValueTypeForPayloadKind(operand_payload_kind);
        if StringLength(operand_value_type) == 0 || operand_value_type != type_name {
            Die(Concat("try expression payload type does not match let type: ", CodegenAstTextProvenance(node)));
        }
        ArraySet(env_box, 0, Concat(env_box[0], Concat(name, Concat("=v:", Concat(type_name, "|")))));
        let operand_option_type: String = OptionResultRuntimeOptionTypeNameForPayloadKind(operand_payload_kind);
        let option_out: String = Concat(AbiLayoutCLocalType(operand_option_type, env_box[0]), Concat(" ", Concat(tmp, Concat(" = ", Concat(RewriteExpr(inner, env_box[0]), ";\n")))));
        option_out = Concat(option_out, Concat(pad, Concat("if (!", Concat(OptionResultRuntimeCOptionIsSomeFn(), Concat("(", Concat(tmp, ")) {\n"))))));
        option_out = Concat(option_out, cleanup);
        option_out = Concat(option_out, Concat(pad, Concat("    return ", Concat(OptionResultRuntimeCOptionNoneFnForPayloadKind(return_option_payload_kind), "();\n"))));
        option_out = Concat(option_out, Concat(pad, "}\n"));
        option_out = Concat(option_out, Concat(pad, Concat(AbiLayoutCLocalType(type_name, env_box[0]), Concat(" ", Concat(name, Concat(" = ", Concat(OptionResultRuntimeCOptionUnwrapFn(), Concat("(", Concat(tmp, ");")))))))));
        return option_out;
    }
    Die(Concat("try expression requires Result<Int> or Option<T> function return: ", CodegenAstTextProvenance(node)));
    return "";
}

// `Assign: <name> = <expr>`. Routes by the variable's recorded type.
func EmitAssign(arena: AstArena, idx: Int, env_box: Array<String>) -> String {
    let name: String = CodegenAstArenaAtomOrDie(arena, idx);
    let expr: String = CodegenAstArenaValueOrDie(arena, idx);
    if CodegenAstArenaAssignTargetIsIndex(arena, idx) {
        let arr_name: String = CodegenAstArenaAssignIndexReceiverOrDie(arena, idx);
        let idx_expr: String = CodegenAstArenaAssignIndexExprOrDie(arena, idx);
        let arr_kind: String = LookupKindType(env_box[0], arr_name, "v");
        let arr_kind_code: Int = CollectionRuntimeKindCode(arr_kind);
        let set_fn: String = CollectionRuntimeCSetFn(arr_kind_code);
        let rhs: String = EmitCollectionElementValue(arr_kind, expr, env_box[0], arr_kind_code);
        return Concat(set_fn, Concat("(&", Concat(arr_name, Concat(", ",
            Concat(IntEval(idx_expr, env_box[0]), Concat(", ", Concat(rhs, ");")))))));
    }
    let vt: String = LookupKindType(env_box[0], name, "v");
    if vt == "String" {
        return Concat(name, Concat(" = ", Concat(StrEval(expr, env_box[0]), ";")));
    }
    if vt == "Float" {
        return Concat(name, Concat(" = ", Concat(RewriteExpr(expr, env_box[0]), ";")));
    }
    let assign_option_struct_fact_opt: Option<OptionStructRuntimeFact> = OptionResultRuntimeStructOptionFact(vt, env_box[0]);
    if IsSome(assign_option_struct_fact_opt) {
        let assign_option_expr_fact: OptionExprEmissionFact = EmitOptionExprFactForType(expr, vt, env_box[0]);
        return Concat(name, Concat(" = ", Concat(assign_option_expr_fact.c_expr, ";")));
    }
    let assign_option_payload_kind: Int = OptionResultRuntimeOptionPayloadKindFromEnvKind(vt);
    if assign_option_payload_kind != 0 {
        let assign_option_expr: String = RewriteExpr(expr, env_box[0]);
        let assign_option_trimmed: String = StringTrim(expr);
        if assign_option_trimmed == "None" || assign_option_trimmed == "None()" {
            assign_option_expr = Concat(OptionResultRuntimeCOptionNoneFnForPayloadKind(assign_option_payload_kind), "()");
        }
        return Concat(name, Concat(" = ", Concat(assign_option_expr, ";")));
    }
    if LookupKindType(env_box[0], vt, "s") == "struct" {
        return Concat(name, Concat(" = ", Concat(EmitStructValue(expr, vt, env_box[0]), ";")));
    }
    return Concat(name, Concat(" = ", Concat(IntEval(expr, env_box[0]), ";")));
}

func EmitFormattedScalarLog(c_expr: String, type_name: String, line_format: String, env: String) -> String {
    let stmt: String = Concat(StringRuntimeCFormattedPrintFn(), "(\"");
    stmt = Concat(stmt, line_format);
    stmt = Concat(stmt, "\", (");
    stmt = Concat(stmt, AbiLayoutCValueType(type_name, env));
    stmt = Concat(stmt, ")(");
    stmt = Concat(stmt, c_expr);
    stmt = Concat(stmt, "));");
    return stmt;
}

// `Log(<expr>)`. Numeric logs consume C format/cast facts from owners; string
// logs route through the string runtime helper.
func EmitLog(inner: String, env: String) -> String {
    if StartsWith(inner, "ToString(") {
        let n: Int = StringLength(inner);
        if CodegenCharAt(inner, n - 1) != ")" {
            Die(Concat("malformed ToString(...): ", inner));
        }
        let arg: String = Substring(inner, 9, n - 9 - 1);
        if ExprKind(arg, env) == "String" {
            return Concat(StringRuntimeCLogFn(), Concat("(", Concat(StrEval(arg, env), ");")));
        }
        return EmitFormattedScalarLog(IntEval(arg, env), "Int", StringRuntimeCIntLineFormat(), env);
    }
    // `Log(x)` may log an Int/Bool value directly (not via ToString). Route by
    // the argument's type so an integer never gets printed with `%s`.
    if ExprKind(inner, env) == "Int" {
        return EmitFormattedScalarLog(IntEval(inner, env), "Int", StringRuntimeCIntLineFormat(), env);
    }
    if ExprKind(inner, env) == "Float" {
        return EmitFormattedScalarLog(RewriteExpr(inner, env), "Float", StringRuntimeCFloatLineFormat(), env);
    }
    // String Log: the oracle strips all trailing newlines from the value and
    // then appends exactly one (`Log("c\n\n")` -> `c\n`), so route through the
    // string runtime log helper rather than raw target formatted output.
    return Concat(StringRuntimeCLogFn(), Concat("(", Concat(StrEval(inner, env), ");")));
}

// `Return: <expr>` / bare `Return:`. String returns route through StrEval.
func EmitReturn(rexpr: String, cur_fn_ret: String, env: String) -> String {
    if StringLength(rexpr) == 0 {
        return "return;";
    }
    if cur_fn_ret == "String" {
        return Concat("return ", Concat(StrEval(rexpr, env), ";"));
    }
    if cur_fn_ret == "Float" {
        return Concat("return ", Concat(RewriteExpr(rexpr, env), ";"));
    }
    if StartsWith(cur_fn_ret, "Result<") && StringIndexOf(cur_fn_ret, "Int") >= 0 {
        return Concat("return ", Concat(RewriteExpr(rexpr, env), ";"));
    }
    if StartsWith(cur_fn_ret, "Option<") {
        let return_option_payload_kind: Int = OptionResultRuntimeOptionPayloadKindForType(cur_fn_ret);
        let return_option_struct_fact_opt: Option<OptionStructRuntimeFact> = OptionResultRuntimeStructOptionFact(cur_fn_ret, env);
        if return_option_payload_kind == 0 && !IsSome(return_option_struct_fact_opt) {
            Die(Concat("unsupported option return payload type: ", cur_fn_ret));
        }
        let return_option_expr_fact: OptionExprEmissionFact = EmitOptionExprFactForType(rexpr, cur_fn_ret, env);
        let return_option_expr: String = return_option_expr_fact.c_expr;
        return Concat("return ", Concat(return_option_expr, ";"));
    }
    if LookupKindType(env, cur_fn_ret, "s") == "struct" {
        return Concat("return ", Concat(EmitStructValue(rexpr, cur_fn_ret, env), ";"));
    }
    return Concat("return ", Concat(IntEval(rexpr, env), ";"));
}

func EmitMatchCaseValue(pattern: String, subject_type: String, env: String) -> String {
    let enum_fact_opt: Option<EnumLiteralProjectionFact> = EnumLiteralProjectionFactOpt(pattern, subject_type, env);
    if IsSome(enum_fact_opt) {
        let enum_fact: EnumLiteralProjectionFact = UnwrapOption(enum_fact_opt);
        return enum_fact.c_value;
    }
    Die(Concat("unsupported match case pattern in self-host codegen subset: ", pattern));
    return "0";
}

// Emit the C for a sequence of statements at AST indentation `stmt_indent`,
// starting at line cur[0]. `pad` is the C indentation prefix. `env_box` carries
// the mutable variable type environment; `cur_fn_ret` is the enclosing
// function's return type. Recurses for `while` / `if` bodies. Advances cur[0].
func EmitStmtList(nodes: Array<CodegenAstTextNode>, count: Int, arena: AstArena,
                  stmt_indent: Int, inout cur: Array<Int>, pad: String,
                  inout env_box: Array<String>, cur_fn_ret: String,
                  active_defers: String) -> String {
    let result: String = "";
    let deferred: String = "";
    let inner_pad: String = Concat(pad, "    ");
    while cur[0] < count {
        let idx: Int = cur[0];
        let ind: Int = CodegenAstArenaIndentOrDie(arena, idx);
        if ind < stmt_indent {
            return Concat(result, deferred);
        }
        if ind > stmt_indent {
            Die(Concat("unexpected over-indented AST line: ", CodegenAstTextProvenance(nodes[idx])));
        }
        if CodegenAstArenaIsLetStmt(arena, idx) {
            if CodegenAstArenaLetInitializerHasTry(arena, idx) {
                result = Concat(result, Concat(pad, Concat(EmitTryLet(nodes[idx], arena, idx, env_box, cur_fn_ret, pad, Concat(deferred, active_defers)), "\n")));
            } else {
                result = Concat(result, Concat(pad, Concat(EmitLet(arena, idx, env_box), "\n")));
            }
            ArraySet(cur, 0, idx + 1);
        } else if CodegenAstArenaIsAssignStmt(arena, idx) {
            result = Concat(result, Concat(pad, Concat(EmitAssign(arena, idx, env_box), "\n")));
            ArraySet(cur, 0, idx + 1);
        } else if CodegenAstArenaIsLogStmt(arena, idx) {
            let log_inner: String = CodegenAstArenaAtomOrDie(arena, idx);
            result = Concat(result, Concat(pad, Concat(EmitLog(log_inner, env_box[0]), "\n")));
            ArraySet(cur, 0, idx + 1);
        } else if CodegenAstArenaIsBareReturnStmt(arena, idx) {
            // Bare return (the AST printer omits the colon when there is no
            // value). The C form follows owner-owned ABI return facts.
            let bare: String = "return;";
            if !AbiLayoutIsVoidReturnType(cur_fn_ret) {
                bare = Concat("return ", Concat(AbiLayoutCDefaultReturnValue(cur_fn_ret, env_box[0]), ";"));
            }
            result = Concat(result, deferred);
            result = Concat(result, active_defers);
            deferred = "";
            result = Concat(result, Concat(pad, Concat(bare, "\n")));
            ArraySet(cur, 0, idx + 1);
        } else if CodegenAstArenaIsValueReturnStmt(arena, idx) {
            let rexpr: String = CodegenAstArenaAtomOrDie(arena, idx);
            result = Concat(result, deferred);
            result = Concat(result, active_defers);
            deferred = "";
            result = Concat(result, Concat(pad, Concat(EmitReturn(rexpr, cur_fn_ret, env_box[0]), "\n")));
            ArraySet(cur, 0, idx + 1);
        } else if CodegenAstArenaIsDeferStmt(arena, idx) {
            ArraySet(cur, 0, idx + 1);
            CodegenAstArenaExpectBlock(arena, count, cur);
            let defer_env: Array<String> = [env_box[0]];
            let body: String = EmitStmtList(nodes, count, arena, stmt_indent + 4,
                cur, pad, defer_env, cur_fn_ret, Concat(deferred, active_defers));
            deferred = Concat(body, deferred);
        } else if CodegenAstArenaIsArraySetStmt(arena, idx) {
            // `ArraySet(arr, idx, val)` lowers through the collection set helper owner.
            let a_arr: String = CodegenAstArenaAtomOrDie(arena, idx);
            let a_idx: String = CodegenAstArenaValueOrDie(arena, idx);
            let a_val: String = CodegenAstArenaAuxValueOrDie(arena, idx);
            let a_kind: String = LookupKindType(env_box[0], a_arr, "v");
            let a_kind_code: Int = CollectionRuntimeKindCode(a_kind);
            let set_fn: String = CollectionRuntimeCSetFn(a_kind_code);
            let a_rhs: String = EmitCollectionElementValue(a_kind, a_val, env_box[0], a_kind_code);
            let set_stmt: String = Concat(set_fn, Concat("(&", Concat(a_arr, Concat(", ", Concat(IntEval(a_idx, env_box[0]), Concat(", ", Concat(a_rhs, ");")))))));
            result = Concat(result, Concat(pad, Concat(set_stmt, "\n")));
            ArraySet(cur, 0, idx + 1);
        } else if CodegenAstArenaIsArrayPushStmt(arena, idx) {
            // `ArrayPush(arr, val)` lowers through the collection push helper owner.
            let p_arr: String = CodegenAstArenaAtomOrDie(arena, idx);
            let p_val: String = CodegenAstArenaValueOrDie(arena, idx);
            let p_kind: String = LookupKindType(env_box[0], p_arr, "v");
            let p_kind_code: Int = CollectionRuntimeKindCode(p_kind);
            let push_fn: String = CollectionRuntimeCPushFn(p_kind_code);
            let p_rhs: String = EmitCollectionElementValue(p_kind, p_val, env_box[0], p_kind_code);
            let push_stmt: String = Concat(push_fn, Concat("(&", Concat(p_arr, Concat(", ", Concat(p_rhs, ");")))));
            result = Concat(result, Concat(pad, Concat(push_stmt, "\n")));
            ArraySet(cur, 0, idx + 1);
        } else if CodegenAstArenaIsArrayPopStmt(arena, idx) {
            // `ArrayPop(arr)` statement lowers through the collection pop helper owner.
            let q_arr: String = CodegenAstArenaAtomOrDie(arena, idx);
            let q_kind: String = LookupKindType(env_box[0], q_arr, "v");
            let pop_fn: String = CollectionRuntimeCPopFn(CollectionRuntimeKindCode(q_kind));
            result = Concat(result, Concat(pad, Concat(pop_fn, Concat("(&", Concat(q_arr, ");\n")))));
            ArraySet(cur, 0, idx + 1);
        } else if CodegenAstArenaIsExitStmt(arena, idx) {
            // `Exit(N)` statement -> target process-exit call (rung-9).
            let e_arg: String = CodegenAstArenaAtomOrDie(arena, idx);
            result = Concat(result, Concat(pad, Concat(HostIORuntimeCExitFn(), Concat("(", Concat(IntEval(e_arg, env_box[0]), ");\n")))));
            ArraySet(cur, 0, idx + 1);
        } else if CodegenAstArenaIsBreakStmt(arena, idx) {
            result = Concat(result, Concat(pad, "break;\n"));
            ArraySet(cur, 0, idx + 1);
        } else if CodegenAstArenaIsContinueStmt(arena, idx) {
            result = Concat(result, Concat(pad, "continue;\n"));
            ArraySet(cur, 0, idx + 1);
        } else if CodegenAstArenaIsForStmt(arena, idx) {
            // `For: i in 0..5` -> a C integer range loop using ABI-owned type spelling.
            // The `..` range is exclusive of the upper bound (matches the oracle).
            let loop_var: String = CodegenAstArenaAtomOrDie(arena, idx);
            let range_end: Option<String> = TypedAstArenaAuxValueText(arena, idx);
            if IsSome(range_end) {
                // Range loop `for i in a..b` (exclusive upper bound).
                let start_v: String = CodegenAstArenaValueOrDie(arena, idx);
                let end_v: String = UnwrapOption(range_end);
                ArraySet(env_box, 0, Concat(env_box[0], Concat(loop_var, "=v:Int|")));
                let for_hdr: String = Concat("for (", AbiLayoutCLocalType("Int", env_box[0]));
                for_hdr = Concat(for_hdr, Concat(" ", loop_var));
                for_hdr = Concat(for_hdr, Concat(" = ", IntEval(start_v, env_box[0])));
                for_hdr = Concat(for_hdr, Concat("; ", loop_var));
                for_hdr = Concat(for_hdr, Concat(" < ", IntEval(end_v, env_box[0])));
                for_hdr = Concat(for_hdr, Concat("; ", loop_var));
                for_hdr = Concat(for_hdr, "++) {\n");
                result = Concat(result, Concat(pad, for_hdr));
            } else {
                // For-each `for x in coll`: evaluate the collection once into a
                // temp, then index it. Element type follows the array kind.
                let coll: String = CodegenAstArenaValueOrDie(arena, idx);
                let ck: String = ExprKind(coll, env_box[0]);
                let arr_c: String = "";
                let elem_c: String = "";
                let get_fn: String = "";
                let len_fn: String = "";
                let elem_kind: String = "";
                if ck == "ArrayString" {
                    arr_c = AbiLayoutCLocalType("Array<String>", env_box[0]);
                    elem_c = AbiLayoutCLocalType("String", env_box[0]);
                    get_fn = CollectionRuntimeCGetFn(CollectionRuntimeKindCode(ck));
                    len_fn = CollectionRuntimeCLenFn(CollectionRuntimeKindCode(ck));
                    elem_kind = "String";
                } else if ck == "ArrayInt" {
                    arr_c = AbiLayoutCLocalType("Array<Int>", env_box[0]);
                    elem_c = AbiLayoutCLocalType("Int", env_box[0]);
                    get_fn = CollectionRuntimeCGetFn(CollectionRuntimeKindCode(ck));
                    len_fn = CollectionRuntimeCLenFn(CollectionRuntimeKindCode(ck));
                    elem_kind = "Int";
                } else {
                    Die(Concat("for-each requires Array<Int> or Array<String>, got: ", ck));
                }
                let tc: String = Concat("_pgyc_", loop_var);
                let ti: String = Concat("_pgyi_", loop_var);
                ArraySet(env_box, 0, Concat(env_box[0], Concat(loop_var, Concat("=v:", Concat(elem_kind, "|")))));
                result = Concat(result, Concat(pad, Concat(arr_c, Concat(" ", Concat(tc, Concat(" = ", Concat(RewriteExpr(coll, env_box[0]), ";\n")))))));
                let foreach_hdr: String = Concat("for (", AbiLayoutCLocalType("Int", env_box[0]));
                foreach_hdr = Concat(foreach_hdr, Concat(" ", ti));
                foreach_hdr = Concat(foreach_hdr, Concat(" = 0; ", ti));
                foreach_hdr = Concat(foreach_hdr, Concat(" < ", len_fn));
                foreach_hdr = Concat(foreach_hdr, Concat("(", tc));
                foreach_hdr = Concat(foreach_hdr, Concat("); ", ti));
                foreach_hdr = Concat(foreach_hdr, "++) {\n");
                result = Concat(result, Concat(pad, foreach_hdr));
                result = Concat(result, Concat(inner_pad, Concat(elem_c, Concat(" ", Concat(loop_var, Concat(" = ", Concat(get_fn, Concat("(", Concat(tc, Concat(", ", Concat(ti, ");\n")))))))))));
            }
            ArraySet(cur, 0, idx + 1);
            CodegenAstArenaExpectBlock(arena, count, cur);
            result = Concat(result, EmitStmtList(nodes, count, arena, stmt_indent + 4, cur, inner_pad, env_box, cur_fn_ret, Concat(deferred, active_defers)));
            result = Concat(result, Concat(pad, "}\n"));
        } else if CodegenAstArenaIsWhileStmt(arena, idx) {
            let cond: String = WrapCond(CodegenAstArenaAtomOrDie(arena, idx), env_box[0]);
            result = Concat(result, Concat(pad, Concat("while ", Concat(cond, " {\n"))));
            ArraySet(cur, 0, idx + 1);
            CodegenAstArenaExpectBlock(arena, count, cur);
            result = Concat(result, EmitStmtList(nodes, count, arena, stmt_indent + 4, cur, inner_pad, env_box, cur_fn_ret, Concat(deferred, active_defers)));
            result = Concat(result, Concat(pad, "}\n"));
        } else if CodegenAstArenaIsIfStmt(arena, idx) {
            let cond2: String = WrapCond(CodegenAstArenaAtomOrDie(arena, idx), env_box[0]);
            result = Concat(result, Concat(pad, Concat("if ", Concat(cond2, " {\n"))));
            ArraySet(cur, 0, idx + 1);
            CodegenAstArenaExpectThen(arena, count, cur);
            CodegenAstArenaExpectBlock(arena, count, cur);
            result = Concat(result, EmitStmtList(nodes, count, arena, stmt_indent + 6, cur, inner_pad, env_box, cur_fn_ret, Concat(deferred, active_defers)));
            if CodegenAstArenaHasElseAt(arena, count, cur[0], stmt_indent) {
                ArraySet(cur, 0, cur[0] + 1);
                if CodegenAstArenaIsElseIfAt(arena, count, cur[0]) {
                    // `else if`: the AST nests an `If:` directly under `Else:`
                    // (no `Block:`). Emit `} else ` and recurse on that If at its
                    // own indent; the nested if-chain closes itself.
                    result = Concat(result, Concat(pad, "} else "));
                    result = Concat(result, EmitStmtList(nodes, count, arena, CodegenAstArenaIndentOrDie(arena, cur[0]), cur, pad, env_box, cur_fn_ret, Concat(deferred, active_defers)));
                } else {
                    result = Concat(result, Concat(pad, "} else {\n"));
                    CodegenAstArenaExpectBlock(arena, count, cur);
                    result = Concat(result, EmitStmtList(nodes, count, arena, stmt_indent + 6, cur, inner_pad, env_box, cur_fn_ret, Concat(deferred, active_defers)));
                    result = Concat(result, Concat(pad, "}\n"));
                }
            } else {
                result = Concat(result, Concat(pad, "}\n"));
            }
        } else if CodegenAstArenaIsMatchStmt(arena, idx) {
            let match_subject: String = CodegenAstArenaAtomOrDie(arena, idx);
            let match_subject_type: String = ExprKind(match_subject, env_box[0]);
            let match_tmp: String = CompilerSymbolCMatchTempName(idx);
            let match_tmp_type: String = AbiLayoutCLocalType("Int", env_box[0]);
            let match_tmp_cast: String = AbiLayoutCValueType("Int", env_box[0]);
            result = Concat(result, Concat(pad, "{\n"));
            let match_tmp_decl: String = Concat(match_tmp_type, " ");
            match_tmp_decl = Concat(match_tmp_decl, match_tmp);
            match_tmp_decl = Concat(match_tmp_decl, " = (");
            match_tmp_decl = Concat(match_tmp_decl, match_tmp_cast);
            match_tmp_decl = Concat(match_tmp_decl, ")(");
            match_tmp_decl = Concat(match_tmp_decl, IntEval(match_subject, env_box[0]));
            match_tmp_decl = Concat(match_tmp_decl, ");\n");
            result = Concat(result, Concat(inner_pad, match_tmp_decl));
            ArraySet(cur, 0, idx + 1);
            let match_case_count: Int = 0;
            while cur[0] < count && CodegenAstArenaIndentOrDie(arena, cur[0]) == stmt_indent + 2 {
                if CodegenAstArenaIsMatchCaseStmt(arena, cur[0]) {
                    let case_pattern: String = CodegenAstArenaAtomOrDie(arena, cur[0]);
                    let case_value: String = EmitMatchCaseValue(case_pattern, match_subject_type, env_box[0]);
                    if match_case_count == 0 {
                        result = Concat(result, Concat(inner_pad, Concat("if (", Concat(match_tmp, Concat(" == ", Concat(case_value, ") {\n"))))));
                    } else {
                        result = Concat(result, Concat(inner_pad, Concat("} else if (", Concat(match_tmp, Concat(" == ", Concat(case_value, ") {\n"))))));
                    }
                    ArraySet(cur, 0, cur[0] + 1);
                    CodegenAstArenaExpectBlock(arena, count, cur);
                    let case_env: Array<String> = [env_box[0]];
                    result = Concat(result, EmitStmtList(nodes, count, arena, stmt_indent + 6, cur, Concat(inner_pad, "    "), case_env, cur_fn_ret, Concat(deferred, active_defers)));
                    match_case_count = match_case_count + 1;
                } else if CodegenAstArenaIsMatchDefaultStmt(arena, cur[0]) {
                    Die("match default is not supported in self-host codegen subset");
                } else {
                    Die(Concat("expected match case in self-host codegen subset: ", CodegenAstTextProvenance(nodes[cur[0]])));
                }
            }
            if match_case_count == 0 {
                Die(Concat("match statement has no cases: ", CodegenAstTextProvenance(nodes[idx])));
            }
            result = Concat(result, Concat(inner_pad, "}\n"));
            result = Concat(result, Concat(pad, "}\n"));
        } else if CodegenAstArenaIsBareCallStmt(arena, idx) {
            // Bare function-call statement, e.g. `Die(Concat(...))` or a void
            // user call. Arguments lower through the same RewriteExpr pipeline.
            let call_expr: String = CodegenAstArenaAtomOrDie(arena, idx);
            result = Concat(result, Concat(pad, Concat(RewriteExpr(call_expr, env_box[0]), ";\n")));
            ArraySet(cur, 0, idx + 1);
        } else {
            Die(Concat("unsupported AST line in supported subset: ", CodegenAstTextProvenance(nodes[idx])));
        }
    }
    return Concat(result, deferred);
}

// C parameter type for a Pergyra type. `String` params are read-only.
