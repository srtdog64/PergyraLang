// src/self_hosted/codegen/emission/stmt_emit.pgy
//
// Statement lowering owner for self-host C emission.
import "../text/text_owner.pgy";
import "../text/owned_string_join_owner.pgy";
import "../text/enum_literal_owner.pgy";
import "../type_facts/type_env.pgy";
import "../type_facts/type_env_state_lifetime_owner.pgy";
import "../input/ast_arena_codegen_view_owner.pgy";
import "../input/semantic_local_binding_codegen_view_owner.pgy";
import "../input/semantic_assignment_codegen_view_owner.pgy";
import "../input/semantic_statement_codegen_view_owner.pgy";
import "../input/semantic_expression_codegen_view_owner.pgy";
import "../abi_layout/abi_layout_owner.pgy";
import "../../compiler/symbol_table_owner.pgy";
import "../runtime_abi/collection_runtime_owner.pgy";
import "../runtime_abi/queue_runtime_owner.pgy";
import "../runtime_abi/host_io_runtime_owner.pgy";
import "../runtime_abi/option_result_runtime_owner.pgy";
import "../runtime_abi/string_runtime_owner.pgy";
import "../runtime_abi/spawn_runtime_owner.pgy";
import "expr_semantic_graph_emit_owner.pgy";
import "expr_semantic_type_owner.pgy";
import "collection_element_emit_owner.pgy";
import "collection_statement_emit_owner.pgy";
import "option_value_emit_owner.pgy";
import "assign_emit_owner.pgy";
import "function_binding_env_owner.pgy";
import "log_emit_owner.pgy";
import "try_let_emit_owner.pgy";
import "foreach_collection_runtime_owner.pgy";
import "value_return_emit_owner.pgy";
import "ability_bind_emit_owner.pgy";
import "box_array_let_emit_owner.pgy";
import "result_let_emit_owner.pgy";
import "tagged_enum_match_owner.pgy";
import "option_match_owner.pgy";
import "../../semantic/ast_expression_graph_node_view_owner.pgy";
import "../input/semantic_body_type_codegen_view_owner.pgy";

struct CodegenStatementBlockEmission {
    body: String;
    scope_cleanup: String;
}

func EmitLet(local_bindings: SemanticAstLocalBindingFacts, arena: AstArena, idx: Int,
    inout env_state: CodegenTypeEnvState, env: CodegenTypeEnv,
    ref graph: SemanticExpressionGraphFacts, root_id: Int
) -> String {
    let name: String = CodegenSemanticLocalBindingNameOrDie(local_bindings, idx);
    let type_name: String = CodegenSemanticLocalBindingDeclaredTypeOrDie(local_bindings, idx);
    let binding: CodegenFunctionValueBindingFact =
        CodegenFunctionValueBindingFactFor(name, type_name, env);
    let c_name: String = binding.c_name;
    let expr: String = CodegenSemanticLocalBindingInitializerOrDie(local_bindings, idx);
    if type_name == "Int" || type_name == "Long" || type_name == "Bool" ||
        type_name == "Float" || type_name == "Double" || type_name == "String" ||
        type_name == "Allocator" || type_name == "TextBuilder" {
        CodegenTypeEnvStateAppendTypedValueBinding(env_state,
            binding.source_name, binding.semantic_type_name, binding.value_kind, binding.c_name);
        return Concat(AbiLayoutCLocalType(type_name, env), Concat(" ", Concat(c_name, Concat(" = ", Concat(WrapExprWithSemanticGraph(expr, env, graph, root_id), ";")))));
    }
    if IsBoxType(type_name) && IsSome(BoxArrayElementTypeOpt(type_name)) { return EmitBoxArrayLetDeclaration(name, type_name, c_name, env_state, env, graph, root_id); }
    if CompilerRuntimeCallAbiMachineLayerDeviceCValueType(type_name) != "" {
        CodegenTypeEnvStateAppendTypedValueBinding(env_state,
            binding.source_name, binding.semantic_type_name, binding.value_kind, binding.c_name);
        let value: String = RewriteExpectedValueWithSemanticGraph(expr, type_name, env, graph, root_id);
        let declaration: String = Concat(c_name, Concat(" = ", Concat(value, ";")));
        return Concat(AbiLayoutCLocalType(type_name, env), Concat(" ", declaration));
    }
    if CompilerRuntimeCallAbiMachineLayerRemoteFutureCValueType(type_name) != "" ||
        SpawnRuntimeCFutureCValueType(type_name) != "" {
        CodegenTypeEnvStateAppendTypedValueBinding(env_state,
            binding.source_name, binding.semantic_type_name, binding.value_kind, binding.c_name);
        let value: String = RewriteExpectedValueWithSemanticGraph(expr, type_name, env, graph, root_id);
        return Concat(AbiLayoutCLocalType(type_name, env), Concat(" ",
            Concat(c_name, Concat(" = ", Concat(value, ";")))));
    }
    if StartsWith(type_name, "Array<") {
        // rung-10: growable `Array<Int>` / `Array<String>` as a struct. A
        // `[a, b, c]` literal lowers to `new()` plus one `push` per element;
        // `[]` is just `new()`. `ArrayPush` later extends the same value.
        let array_fact: CollectionRuntimeFact = CollectionRuntimeFactFromTypeName(type_name, env);
        let array_kind: String = array_fact.kind;
        let c_type: String = AbiLayoutCLocalType(type_name, env);
        let new_fn: String = array_fact.c_new_fn;
        let push_fn: String = array_fact.c_push_fn;
        let element_type: String = array_fact.element_type;
        CodegenTypeEnvStateAppendTypedValueBinding(env_state,
            binding.source_name, binding.semantic_type_name, binding.value_kind, binding.c_name);
        let graph_kind: Option<Int> = SemanticExpressionGraphNodeKind(graph, root_id);
        if !IsSome(graph_kind) {
            Die("array initializer expression graph is invalid");
        }
        // Non-literal initializer (e.g. `Args()` or an array-returning call):
        // bind the array value directly.
        if !AstExpressionNodeIsArrayLiteralSpine(UnwrapOption(graph_kind)) {
            return Concat(c_type, Concat(" ", Concat(c_name, Concat(" = ", Concat(WrapExprWithSemanticGraph(expr, env, graph, root_id), ";")))));
        }
        let literal: SemanticArrayLiteralView =
            SemanticArrayLiteralViewFromGraph(graph, root_id);
        if !literal.ok {
            Die("array initializer expression graph is invalid");
        }
        var out: String = Concat(c_type, Concat(" ", Concat(c_name, Concat(" = ", Concat(new_fn, "();")))));
        var element_index: Int = 0;
        while element_index < ArrayLength(literal.element_nodes) {
            let ev: String = RewriteSemanticExpectedValue(
                graph, literal.element_nodes[element_index], element_type, env);
            out = Concat(out, Concat(" ", Concat(push_fn, Concat("(&", Concat(c_name, Concat(", ", Concat(ev, ");")))))));
            element_index = element_index + 1;
        }
        return out;
    }
    if StartsWith(type_name, "Result<") { return EmitResultLetDeclaration(name, type_name, c_name, expr, env_state, env, graph, root_id); }
    if IsSlotType(type_name) {
        CodegenTypeEnvStateAppendTypedValueBinding(
            env_state, binding.source_name, binding.semantic_type_name,
            binding.value_kind, binding.c_name
        );
        return Concat(AbiLayoutCLocalType(type_name, env), Concat(" ", Concat(c_name, Concat(" = ", Concat(RewriteExpectedValueWithSemanticGraph(expr, type_name, env, graph, root_id), ";")))));
    }
    if StartsWith(type_name, "Option<") {
        let option_payload_kind: Int = OptionResultRuntimeOptionPayloadKindForType(type_name);
        var option_kind: String = OptionResultRuntimeOptionEnvKindForPayloadKind(option_payload_kind);
        if StringLength(option_kind) == 0 {
            let option_struct_fact_opt: Option<OptionStructRuntimeFact> =
                OptionResultRuntimeStructOptionFact(
                    type_name, env
                );
            if IsSome(option_struct_fact_opt) {
                option_kind = type_name;
            }
        }
        if StringLength(option_kind) == 0 {
            Die(Concat("unsupported option let payload type: ", type_name));
        }
        CodegenTypeEnvStateAppendTypedValueBinding(
            env_state, binding.source_name, binding.semantic_type_name,
            binding.value_kind, binding.c_name
        );
        let option_expr_fact: OptionExprEmissionFact = EmitOptionExprFactForType(
            expr, type_name, env, graph, root_id
        );
        let option_expr: String = option_expr_fact.c_expr;
        return Concat(AbiLayoutCLocalType(type_name, env), Concat(" ", Concat(c_name, Concat(" = ", Concat(option_expr, ";")))));
    }
    if StartsWith(type_name, "Slice<") || StartsWith(type_name, "List<") || StartsWith(type_name, "Queue<") ||
        StartsWith(type_name, "Set<") || StartsWith(type_name, "HashMap<") ||
        LookupKindType(env, type_name, "s") == "struct" ||
        LookupKindType(env, type_name, "enum") != "" {
        CodegenTypeEnvStateAppendTypedValueBinding(
            env_state, binding.source_name, binding.semantic_type_name,
            binding.value_kind, binding.c_name
        );
        let value: String = RewriteExpectedValueWithSemanticGraph(
            expr, type_name, env, graph, root_id
        );
        return Concat(AbiLayoutCLocalType(type_name, env), Concat(" ",
            Concat(c_name, Concat(" = ", Concat(value, ";")))));
    }
    Die(Concat("unsupported let type (only Int/Long/Bool/Float/Double/String/Array/Slice/List/Queue/Set/Option/struct/enum): ", type_name));
}
func EmitStmtList(count: Int, arena: AstArena,
                  local_bindings: SemanticAstLocalBindingFacts,
                  assignments: SemanticAstAssignmentFacts,
                  statements: SemanticAstStatementFacts,
                  ref body_types: CodegenSemanticBodyTypeFacts,
                  ref expression_surfaces: SemanticAstExpressionSurfaceFacts,
                  stmt_indent: Int,
                  inout cur: Array<Int>, pad: String,
                  inout env_state: CodegenTypeEnvState, cur_fn_ret: String,
                  inout routine_defers: String,
                  routine_copyout: String,
                  active_defers: String, loop_escape_defers: String,
                  function_id: Int, scope_id: Int,
                  inout env: CodegenTypeEnv) -> CodegenStatementBlockEmission {
    var result: Array<String> = [];
    let inner_pad: String = Concat(pad, "    ");
    var scope_cleanup: String = "";
    while cur[0] < count {
        CodegenTypeEnvStateBindView(env, env_state);
        let idx: Int = cur[0];
        let ind: Int = CodegenAstArenaIndentOrDie(arena, idx);
        if ind < stmt_indent {
            return CodegenStatementBlockEmission(
                CodegenJoinOwnedStringFragments(result, ""), EmitFocusScopeCleanup(body_types, function_id, scope_id, scope_cleanup, pad)
            );
        }
        if ind > stmt_indent {
            Die(Concat("unexpected over-indented AST line: ", CodegenAstArenaProvenanceOrDie(arena, idx)));
        }
        if CodegenSemanticLocalBindingIs(local_bindings, idx) {
            let let_root_id: Int =
                CodegenSemanticExpressionGraphOrDie(
                    expression_surfaces, idx, AstExpressionLaneValue());
            var statement_env: CodegenTypeEnvState = CodegenTypeEnvStateBorrow(env_state);
            var emitted_let: String = "";
            let local_type: String =
                CodegenSemanticLocalBindingDeclaredTypeOrDie(
                    local_bindings, idx
                );
            let resource_local_index: Option<Int> =
                CodegenSemanticResourceLocalIndex(body_types, idx);
            if CodegenSemanticExpressionGraphIsTry(
                expression_surfaces.expression_graph, let_root_id
            ) {
                emitted_let = EmitTryLet(
                    local_bindings, arena, idx,
                    expression_surfaces.expression_graph, let_root_id,
                    statement_env, env,
                    cur_fn_ret, pad, EmitContinuingExitCleanup(body_types, function_id, scope_id, idx,
                        SemanticAstCollectionFocusExitTryError(), routine_defers, scope_cleanup, active_defers, routine_copyout, pad));
            } else {
                emitted_let = EmitLet(
                    local_bindings, arena, idx, statement_env, env,
                    expression_surfaces.expression_graph, let_root_id);
            }
            CodegenTypeEnvStateAdoptAfterLastConsumer(env_state, statement_env);
            CodegenTypeEnvStateReleaseLocal(statement_env);
            ArrayPushOwnedString(result, CodegenPrefixOwnedStatementLine(Concat("", emitted_let), pad, "", "\n"));
            if IsSome(resource_local_index) {
                let local_name: String =
                    CodegenSemanticLocalBindingNameOrDie(local_bindings, idx);
                let local_c_name: String =
                    CodegenFunctionValueBindingFactFor(
                        local_name, local_type, env
                    ).c_name;
                let resource_index: Int =
                    UnwrapOption(resource_local_index);
                let path_count: Int =
                    CodegenSemanticResourceLocalPathCountOrDie(
                        body_types, resource_index
                    );
                var path_index: Int = 0;
                while path_index < path_count {
                    let source_path: String =
                        CodegenSemanticResourceLocalPathOrDie(
                            body_types, resource_index, path_index
                        );
                    var resource_c_expression: String = local_c_name;
                    if source_path != "" {
                        resource_c_expression = Concat(
                            local_c_name, Concat(
                                ".", CompilerSymbolCFieldName(source_path)
                            )
                        );
                    }
                    ArrayPushOwnedString(result, Concat(
                        pad, Concat(
                            "PGY_ZONE_LOCK_INIT(&", Concat(
                                resource_c_expression, ");\n"
                            )
                        )
                    ));
                    scope_cleanup = Concat(
                        pad, Concat(
                            "PGY_ZONE_LOCK_DESTROY(&", Concat(
                                resource_c_expression,
                                Concat(");\n", scope_cleanup)
                            )
                        )
                    );
                    path_index = path_index + 1;
                }
            }
            ArraySet(cur, 0, idx + 1); continue;
        }
        if CodegenSemanticAssignmentIs(assignments, idx) {
            let assign_root_id: Int =
                CodegenSemanticExpressionGraphOrDie(
                    expression_surfaces, idx, AstExpressionLaneValue()
                );
            let assign_target_root_id: Int =
                CodegenSemanticExpressionGraphOrDie(
                    expression_surfaces, idx, AstExpressionLaneAtom()
                );
            let assignment_target_type: String =
                CodegenSemanticAssignmentTargetTypeOrDie(
                    body_types.assignment_types, idx
                );
            let emitted_assignment: String = EmitAssign(
                assignments, idx,
                CodegenSemanticAssignmentExpectedTypeOrDie(
                    body_types.assignment_types, idx
                ),
                assignment_target_type, env_state, env,
                expression_surfaces.expression_graph,
                assign_root_id, assign_target_root_id
            );
            ArrayPushOwnedString(result, CodegenPrefixOwnedStatementLine(Concat("", emitted_assignment), pad, "", "\n"));
            ArraySet(cur, 0, idx + 1); continue;
        }
        if CodegenSemanticStatementIs(
            statements, idx, TypedAstKindBindStmtTag()
        ) {
            let subject_root_id: Int = CodegenSemanticExpressionGraphOrDie(
                expression_surfaces, idx, AstExpressionLaneValue()
            );
            ArrayPushOwnedString(result, CodegenPrefixOwnedStatementLine(EmitAbilityBind(
                statements, idx, env, expression_surfaces.expression_graph,
                subject_root_id
            ), pad, "", "\n"));
            ArraySet(cur, 0, idx + 1); continue;
        }
        if CodegenSemanticStatementIs(statements, idx, TypedAstKindLogStmtTag()) {
            let log_root_id: Int =
                CodegenSemanticExpressionGraphOrDie(
                    expression_surfaces, idx, AstExpressionLaneAtom()
                );
            let log_type: String =
                CodegenSemanticStatementInferredTypeOrDie(
                    body_types.statement_types, idx, TypedAstKindLogStmtTag()
                );
            ArrayPushOwnedString(result, CodegenPrefixOwnedStatementLine(Concat("", EmitLog(
                log_type, env, expression_surfaces.expression_graph,
                log_root_id
            )), pad, "", "\n"));
            ArraySet(cur, 0, idx + 1); continue;
        }
        if CodegenSemanticStatementIs(statements, idx, TypedAstKindBareReturnStmtTag()) {
            // Bare return (the AST printer omits the colon when there is no
            // value). The C form follows owner-owned ABI return facts.
            var bare: String = "return;";
            if !AbiLayoutIsVoidReturnType(cur_fn_ret) {
                bare = Concat("return ", Concat(AbiLayoutCDefaultReturnValue(cur_fn_ret, env), ";"));
            }
            ArrayPushOwnedString(result, EmitContinuingExitCleanup(body_types, function_id, scope_id, idx,
                SemanticAstCollectionFocusExitBareReturn(), routine_defers, scope_cleanup, active_defers, routine_copyout, pad));
            ArrayPushOwnedString(result, Concat(pad, Concat(bare, "\n")));
            ArraySet(cur, 0, idx + 1); continue;
        }
        if CodegenSemanticStatementIs(statements, idx, TypedAstKindValueReturnStmtTag()) {
            let rexpr: String = CodegenSemanticReturnValueOrDie(statements, idx);
            let return_root_id: Int =
                CodegenSemanticExpressionGraphOrDie(
                    expression_surfaces, idx, AstExpressionLaneAtom()
                );
            let return_cleanup: String = EmitContinuingExitCleanup(body_types, function_id, scope_id, idx,
                SemanticAstCollectionFocusExitValueReturn(), routine_defers, scope_cleanup, active_defers, routine_copyout, pad);
            ArrayPushOwnedString(result, EmitReturnWithCleanup(
                rexpr, cur_fn_ret, env,
                expression_surfaces.expression_graph, return_root_id,
                return_cleanup, idx, pad
            ));
            ArraySet(cur, 0, idx + 1); continue;
        }
        if CodegenSemanticStatementIs(statements, idx, TypedAstKindUnsafeBlockTag()) {
            ArraySet(cur, 0, idx + 1);
            let block_scope_id: Int = cur[0];
            CodegenAstArenaExpectBlock(arena, count, cur);
            var block_env: CodegenTypeEnvState = CodegenTypeEnvStateBorrow(env_state);
            let nested: CodegenStatementBlockEmission = EmitStmtList(
                count, arena, local_bindings, assignments, statements,
                body_types, expression_surfaces, stmt_indent + 4, cur, inner_pad,
                block_env, cur_fn_ret, routine_defers, routine_copyout,
                Concat(scope_cleanup, active_defers), loop_escape_defers, function_id, block_scope_id, env);
            CodegenTypeEnvStateBindView(env, env_state);
            CodegenTypeEnvStateReleaseLocal(block_env);
            ArrayPushOwnedString(result, Concat(pad, "{\n"));
            ArrayPushOwnedString(result, nested.body);
            ArrayPushOwnedString(result, nested.scope_cleanup);
            ArrayPushOwnedString(result, Concat(pad, "}\n"));
            continue;
        }
        if CodegenSemanticStatementIs(statements, idx, TypedAstKindDeferStmtTag()) {
            ArraySet(cur, 0, idx + 1);
            let defer_scope_id: Int = cur[0];
            CodegenAstArenaExpectBlock(arena, count, cur);
            var defer_env: CodegenTypeEnvState =
                CodegenTypeEnvStateBorrow(env_state);
            let deferred: CodegenStatementBlockEmission = EmitStmtList(
                count, arena, local_bindings, assignments, statements,
                body_types, expression_surfaces, stmt_indent + 4, cur, pad,
                defer_env, cur_fn_ret, routine_defers, routine_copyout,
                Concat(scope_cleanup, active_defers), "", function_id, defer_scope_id, env
            );
            CodegenTypeEnvStateBindView(env, env_state);
            CodegenTypeEnvStateReleaseLocal(defer_env);
            routine_defers = Concat(
                deferred.body, Concat(
                    deferred.scope_cleanup, routine_defers
                )
            ); continue;
        }
        if CodegenSemanticStatementIs(statements, idx, TypedAstKindArraySetStmtTag()) {
            let emitted: String = EmitSemanticArraySetStatement(
                statements, body_types, expression_surfaces, idx, env);
            ArrayPushOwnedString(result, Concat(pad, Concat(emitted, "\n")));
            ArraySet(cur, 0, idx + 1); continue;
        }
        if CodegenSemanticStatementIs(statements, idx, TypedAstKindArrayPushStmtTag()) {
            let emitted: String = EmitSemanticArrayPushStatement(
                statements, body_types, expression_surfaces, idx, env);
            ArrayPushOwnedString(result, Concat(pad, Concat(emitted, "\n")));
            ArraySet(cur, 0, idx + 1); continue;
        }
        if CodegenSemanticStatementIs(statements, idx, TypedAstKindArrayPopStmtTag()) {
            let emitted: String = EmitSemanticArrayPopStatement(
                statements, expression_surfaces, idx, env);
            ArrayPushOwnedString(result, Concat(pad, Concat(emitted, "\n")));
            ArraySet(cur, 0, idx + 1); continue;
        }
        if CodegenSemanticStatementIs(statements, idx, TypedAstKindExitStmtTag()) {
            let exit_root_id: Int =
                CodegenSemanticExpressionGraphOrDie(
                    expression_surfaces, idx, AstExpressionLaneAtom()
                );
            let exit_value: String = RewriteSemanticExpectedValue(
                expression_surfaces.expression_graph, exit_root_id, "Int", env
            );
            ArrayPushOwnedString(result, Concat(
                pad, Concat(HostIORuntimeCExitFn(), Concat(
                    "(", Concat(exit_value, ");\n")
                ))
            ));
            ArraySet(cur, 0, idx + 1); continue;
        }
        if CodegenSemanticStatementIs(statements, idx, TypedAstKindBreakStmtTag()) {
            if scope_cleanup != "" {
                ArrayPushOwnedString(result, Concat("", scope_cleanup));
            }
            if loop_escape_defers != "" {
                ArrayPushOwnedString(result, Concat("", loop_escape_defers));
            }
            ArrayPushOwnedString(result, EmitAdmittedFocusRecovery(body_types, function_id,
                scope_id, idx, SemanticAstCollectionFocusExitBreak(), pad));
            ArrayPushOwnedString(result, Concat(pad, "break;\n"));
            ArraySet(cur, 0, idx + 1); continue;
        }
        if CodegenSemanticStatementIs(statements, idx, TypedAstKindContinueStmtTag()) {
            if scope_cleanup != "" {
                ArrayPushOwnedString(result, Concat("", scope_cleanup));
            }
            if loop_escape_defers != "" {
                ArrayPushOwnedString(result, Concat("", loop_escape_defers));
            }
            ArrayPushOwnedString(result, EmitAdmittedFocusRecovery(body_types, function_id,
                scope_id, idx, SemanticAstCollectionFocusExitContinue(), pad));
            ArrayPushOwnedString(result, Concat(pad, "continue;\n"));
            ArraySet(cur, 0, idx + 1); continue;
        }
        if CodegenSemanticStatementIs(statements, idx, TypedAstKindForStmtTag()) {
            // Integer ranges are exclusive at the upper bound.
            let loop_var: String = CodegenSemanticForLoopVarOrDie(statements, idx);
            var loop_env: CodegenTypeEnvState =
                CodegenTypeEnvStateBorrow(env_state);
            let iteration_root_id: Int =
                CodegenSemanticExpressionGraphOrDie(
                    expression_surfaces, idx, AstExpressionLaneValue()
                );
            if CodegenSemanticForIsRange(statements, idx) {
                let c_loop_var: String = CodegenFunctionValueBindingFactFor(
                    loop_var, "Int", env
                ).c_name;
                let start_v: String = CodegenSemanticForRangeStartOrDie(statements, idx);
                let end_v: String = CodegenSemanticForRangeEndOrDie(statements, idx);
                let stop_root_id: Int =
                    CodegenSemanticExpressionGraphOrDie(
                        expression_surfaces, idx,
                        AstExpressionLaneAuxiliary()
                    );
                let start_c: String = RewriteExprWithSemanticGraph(
                    start_v, env, expression_surfaces.expression_graph,
                    iteration_root_id
                );
                let end_c: String = RewriteExprWithSemanticGraph(
                    end_v, env, expression_surfaces.expression_graph,
                    stop_root_id
                );
                CodegenTypeEnvStateAppendTypedValueBinding(
                    loop_env, loop_var, "Int", "Int", c_loop_var
                );
                var for_hdr: String = Concat("for (", AbiLayoutCLocalType("Int", env));
                for_hdr = Concat(for_hdr, Concat(" ", c_loop_var));
                for_hdr = Concat(for_hdr, Concat(" = ", start_c));
                for_hdr = Concat(for_hdr, Concat("; ", c_loop_var));
                for_hdr = Concat(for_hdr, Concat(" < ", end_c));
                for_hdr = Concat(for_hdr, Concat("; ", c_loop_var));
                for_hdr = Concat(for_hdr, "++) {\n");
                ArrayPushOwnedString(result, Concat(pad, for_hdr));
            } else {
                let coll: String = CodegenSemanticForEachCollectionOrDie(statements, idx);
                let coll_root_kind: Option<Int> =
                    SemanticExpressionGraphNodeKind(
                        expression_surfaces.expression_graph,
                        iteration_root_id
                    );
                let coll_root_text: Option<String> =
                    SemanticExpressionGraphNodeText(
                        expression_surfaces.expression_graph,
                        iteration_root_id
                    );
                if !IsSome(coll_root_kind) || !IsSome(coll_root_text) ||
                    UnwrapOption(coll_root_kind) != AstExpressionNodeLeaf() ||
                    !IsIdentifier(UnwrapOption(coll_root_text)) {
                    Die("for-each collection type fact is outside the bounded graph subset");
                }
                let ck: String = LookupKindType(
                    env, UnwrapOption(coll_root_text), "v"
                );
                let coll_c: String = RewriteExprWithSemanticGraph(
                    coll, env, expression_surfaces.expression_graph,
                    iteration_root_id
                );
                var arr_c: String = "";
                var elem_c: String = "";
                let runtime: CodegenForEachCollectionRuntimeFact =
                    CodegenForEachCollectionRuntimeFactFromTypeName(ck, env);
                if !runtime.ok {
                    Die("for-each collection runtime ABI fact is missing");
                }
                arr_c = runtime.collection_c_type;
                elem_c = runtime.element_c_type;
                let elem_kind: String = runtime.element_type;
                let c_loop_var: String = CodegenFunctionValueBindingFactFor(
                    loop_var, elem_kind, env
                ).c_name;
                let tc: String = CompilerSymbolCForEachCollectionTempName(loop_var);
                let ti: String = CompilerSymbolCForEachIndexTempName(loop_var);
                CodegenTypeEnvStateAppendTypedValueBinding(
                    loop_env, loop_var, elem_kind, elem_kind, c_loop_var
                );
                let len_call: String = CodegenForEachCollectionCLengthCall(
                    runtime, tc
                );
                let get_call: String = CodegenForEachCollectionCGetCall(
                    runtime, tc, ti
                );
                ArrayPushOwnedString(result, Concat(pad, Concat(arr_c, Concat(" ", Concat(tc, Concat(" = ", Concat(coll_c, ";\n")))))));
                var foreach_hdr: String = Concat("for (", AbiLayoutCLocalType("Int", env));
                foreach_hdr = Concat(foreach_hdr, Concat(" ", ti));
                foreach_hdr = Concat(foreach_hdr, Concat(" = 0; ", ti));
                foreach_hdr = Concat(foreach_hdr, Concat(" < ", len_call));
                foreach_hdr = Concat(foreach_hdr, Concat("; ", ti));
                foreach_hdr = Concat(foreach_hdr, "++) {\n");
                ArrayPushOwnedString(result, Concat(pad, foreach_hdr));
                ArrayPushOwnedString(result, Concat(inner_pad, Concat(elem_c, Concat(" ", Concat(c_loop_var, Concat(" = ", Concat(get_call, ";\n")))))));
            }
            ArraySet(cur, 0, idx + 1);
            let loop_scope_id: Int = cur[0];
            CodegenAstArenaExpectBlock(arena, count, cur);
            let loop_emission: CodegenStatementBlockEmission = EmitStmtList(
                count, arena, local_bindings, assignments, statements,
                body_types, expression_surfaces, stmt_indent + 4, cur,
                inner_pad, loop_env, cur_fn_ret, routine_defers, routine_copyout,
                Concat(scope_cleanup, active_defers), "", function_id, loop_scope_id, env
            );
            CodegenTypeEnvStateBindView(env, env_state);
            CodegenTypeEnvStateReleaseLocal(loop_env);
            ArrayPushOwnedString(result, loop_emission.body);
            if loop_emission.scope_cleanup != "" {
                ArrayPushOwnedString(result, loop_emission.scope_cleanup);
            }
            ArrayPushOwnedString(result, Concat(pad, "}\n"));
            continue;
        }
        if CodegenSemanticStatementIs(statements, idx, TypedAstKindWhileStmtTag()) {
            let while_expr: String = CodegenSemanticWhileConditionOrDie(
                statements, idx
            );
            let while_root_id: Int =
                CodegenSemanticExpressionGraphOrDie(
                    expression_surfaces, idx, AstExpressionLaneAtom()
                );
            let cond: String = WrapExprWithSemanticGraph(
                while_expr, env, expression_surfaces.expression_graph,
                while_root_id
            );
            ArrayPushOwnedString(result, CodegenPrefixOwnedStatementLine(Concat("", cond), pad, "while ", " {\n"));
            ArraySet(cur, 0, idx + 1);
            let while_scope_id: Int = cur[0];
            CodegenAstArenaExpectBlock(arena, count, cur);
            var while_env: CodegenTypeEnvState =
                CodegenTypeEnvStateBorrow(env_state);
            let while_emission: CodegenStatementBlockEmission = EmitStmtList(
                count, arena, local_bindings, assignments, statements,
                body_types, expression_surfaces, stmt_indent + 4, cur,
                inner_pad, while_env, cur_fn_ret, routine_defers, routine_copyout,
                Concat(scope_cleanup, active_defers), "", function_id, while_scope_id, env
            );
            CodegenTypeEnvStateBindView(env, env_state);
            CodegenTypeEnvStateReleaseLocal(while_env);
            ArrayPushOwnedString(result, while_emission.body);
            if while_emission.scope_cleanup != "" {
                ArrayPushOwnedString(result, while_emission.scope_cleanup);
            }
            ArrayPushOwnedString(result, Concat(pad, "}\n"));
            continue;
        }
        if CodegenSemanticStatementIs(statements, idx, TypedAstKindIfStmtTag()) {
            let if_expr: String = CodegenSemanticIfConditionOrDie(
                statements, idx
            );
            let if_root_id: Int =
                CodegenSemanticExpressionGraphOrDie(
                    expression_surfaces, idx, AstExpressionLaneAtom()
                );
            let cond2: String = WrapExprWithSemanticGraph(
                if_expr, env, expression_surfaces.expression_graph,
                if_root_id
            );
            ArrayPushOwnedString(result, CodegenPrefixOwnedStatementLine(Concat("", cond2), pad, "if ", " {\n"));
            ArraySet(cur, 0, idx + 1);
            CodegenAstArenaExpectThen(arena, count, cur);
            let then_scope_id: Int = cur[0];
            CodegenAstArenaExpectBlock(arena, count, cur);
            var then_env: CodegenTypeEnvState =
                CodegenTypeEnvStateBorrow(env_state);
            let then_emission: CodegenStatementBlockEmission = EmitStmtList(
                count, arena, local_bindings, assignments, statements,
                body_types, expression_surfaces, stmt_indent + 6, cur,
                inner_pad, then_env, cur_fn_ret, routine_defers, routine_copyout,
                Concat(scope_cleanup, active_defers),
                Concat(scope_cleanup, loop_escape_defers), function_id, then_scope_id, env
            );
            CodegenTypeEnvStateBindView(env, env_state);
            CodegenTypeEnvStateReleaseLocal(then_env);
            ArrayPushOwnedString(result, then_emission.body);
            if then_emission.scope_cleanup != "" {
                ArrayPushOwnedString(result, then_emission.scope_cleanup);
            }
            if CodegenAstArenaHasElseAt(arena, count, cur[0], stmt_indent) {
                ArraySet(cur, 0, cur[0] + 1);
                if CodegenSemanticStatementIs(statements, cur[0], TypedAstKindIfStmtTag()) {
                    // `else if`: the AST nests an `If:` directly under `Else:`
                    // (no `Block:`). Emit `} else ` and recurse on that If at its
                    // own indent; the nested if-chain closes itself.
                    ArrayPushOwnedString(result, Concat(pad, "} else "));
                    var else_if_env: CodegenTypeEnvState =
                        CodegenTypeEnvStateBorrow(env_state);
                    let else_if_emission: CodegenStatementBlockEmission =
                        EmitStmtList(
                            count, arena, local_bindings, assignments,
                            statements, body_types, expression_surfaces,
                            CodegenAstArenaIndentOrDie(arena, cur[0]), cur,
                            pad, else_if_env, cur_fn_ret, routine_defers, routine_copyout,
                            Concat(scope_cleanup, active_defers),
                            Concat(scope_cleanup, loop_escape_defers), function_id, -1, env
                        );
                    CodegenTypeEnvStateBindView(env, env_state);
                    CodegenTypeEnvStateReleaseLocal(else_if_env);
                    ArrayPushOwnedString(result, else_if_emission.body);
                    if else_if_emission.scope_cleanup != "" {
                        ArrayPushOwnedString(result, else_if_emission.scope_cleanup);
                    }
                } else {
                    ArrayPushOwnedString(result, Concat(pad, "} else {\n"));
                    let else_scope_id: Int = cur[0];
                    CodegenAstArenaExpectBlock(arena, count, cur);
                    var else_env: CodegenTypeEnvState =
                        CodegenTypeEnvStateBorrow(env_state);
                    let else_emission: CodegenStatementBlockEmission =
                        EmitStmtList(
                            count, arena, local_bindings, assignments,
                            statements, body_types, expression_surfaces,
                            stmt_indent + 6, cur, inner_pad, else_env,
                            cur_fn_ret, routine_defers, routine_copyout,
                            Concat(scope_cleanup, active_defers),
                            Concat(scope_cleanup, loop_escape_defers), function_id, else_scope_id, env
                        );
                    CodegenTypeEnvStateBindView(env, env_state);
                    CodegenTypeEnvStateReleaseLocal(else_env);
                    ArrayPushOwnedString(result, else_emission.body);
                    if else_emission.scope_cleanup != "" {
                        ArrayPushOwnedString(result, else_emission.scope_cleanup);
                    }
                    ArrayPushOwnedString(result, Concat(pad, "}\n"));
                }
            } else {
                ArrayPushOwnedString(result, Concat(pad, "}\n"));
            }
            continue;
        }
        if CodegenSemanticStatementIs(statements, idx, TypedAstKindMatchStmtTag()) {
            let match_subject: String = CodegenSemanticMatchSubjectOrDie(statements, idx);
            let match_root_id: Int =
                CodegenSemanticExpressionGraphOrDie(
                    expression_surfaces, idx, AstExpressionLaneAtom()
                );
            let rendered_match_subject: String = RewriteExprWithSemanticGraph(
                match_subject, env, expression_surfaces.expression_graph,
                match_root_id
            );
            let match_subject_type: String =
                CodegenSemanticStatementInferredTypeOrDie(
                    body_types.statement_types, idx, TypedAstKindMatchStmtTag()
                );
            let option_match: Bool = StartsWith(match_subject_type, "Option<");
            let tagged_match: Bool = LookupKindType(env, match_subject_type, "enum") == "tagged";
            let match_tmp: String = CompilerSymbolCMatchTempName(idx);
            ArrayPushOwnedString(result, Concat(pad, "{\n"));
            var match_tmp_type: String = "";
            if !tagged_match && !option_match { match_tmp_type = AbiLayoutCLocalType("Int", env); }
            else { match_tmp_type = AbiLayoutCLocalType(match_subject_type, env); }
            var match_tmp_decl: String = Concat(
                match_tmp_type, Concat(" ", Concat(match_tmp, " = "))
            );
            if !tagged_match && !option_match {
                let match_tmp_cast: String = AbiLayoutCValueType("Int", env);
                match_tmp_decl = Concat(
                    match_tmp_decl, Concat("(", Concat(
                        match_tmp_cast, Concat(")(", Concat(
                            rendered_match_subject, ")"
                        ))
                    ))
                );
            } else {
                match_tmp_decl = Concat(match_tmp_decl, rendered_match_subject);
            }
            match_tmp_decl = Concat(match_tmp_decl, ";\n");
            ArrayPushOwnedString(result, Concat(inner_pad, match_tmp_decl));
            ArraySet(cur, 0, idx + 1);
            var match_case_count: Int = 0;
            while cur[0] < count && CodegenAstArenaIndentOrDie(arena, cur[0]) == stmt_indent + 2 {
                if CodegenSemanticStatementIs(statements, cur[0], TypedAstKindMatchCaseStmtTag()) {
                    let case_fact: AstMatchCasePatternFact =
                        CodegenSemanticMatchCasePatternFactOrDie(
                            statements, cur[0]
                        );
                    var case_line: String = "";
                    if option_match {
                        case_line = EmitOptionMatchCaseLine(
                            case_fact, match_subject_type,
                            match_tmp,
                            match_case_count, env
                        );
                    } else {
                        case_line = EmitMatchCaseLine(
                            tagged_match, case_fact, match_subject_type,
                            match_tmp, match_case_count,
                            match_tmp, env
                        );
                    }
                    ArrayPushOwnedString(result, Concat(inner_pad, case_line));
                    ArraySet(cur, 0, cur[0] + 1);
                    let case_scope_id: Int = cur[0];
                    CodegenAstArenaExpectBlock(arena, count, cur);
                    var case_env: CodegenTypeEnvState =
                        CodegenTypeEnvStateBorrow(env_state);
                    if option_match {
                        BindOptionMatchPayload(
                            case_fact, match_tmp,
                            match_subject_type,
                            case_env, env
                        );
                    } else if tagged_match {
                        BindTaggedEnumMatchPayload(
                            case_fact, match_tmp,
                            match_subject_type,
                            case_env, env
                        );
                    }
                    let case_emission: CodegenStatementBlockEmission =
                        EmitStmtList(
                            count, arena, local_bindings, assignments,
                            statements, body_types, expression_surfaces,
                            stmt_indent + 6, cur, Concat(inner_pad, "    "),
                            case_env, cur_fn_ret, routine_defers, routine_copyout,
                            Concat(scope_cleanup, active_defers),
                            Concat(scope_cleanup, loop_escape_defers), function_id, case_scope_id, env
                        );
                    CodegenTypeEnvStateBindView(env, env_state);
                    CodegenTypeEnvStateReleaseLocal(case_env);
                    ArrayPushOwnedString(result, case_emission.body);
                    if case_emission.scope_cleanup != "" {
                        ArrayPushOwnedString(result, case_emission.scope_cleanup);
                    }
                    match_case_count = match_case_count + 1;
                } else if CodegenSemanticStatementIs(statements, cur[0], TypedAstKindMatchDefaultStmtTag()) {
                    Die("match default is not supported in self-host codegen subset");
                } else {
                    Die(Concat("expected match case in self-host codegen subset: ", CodegenAstArenaProvenanceOrDie(arena, cur[0])));
                }
            }
            if match_case_count == 0 {
                Die(Concat("match statement has no cases: ", CodegenAstArenaProvenanceOrDie(arena, idx)));
            }
            ArrayPushOwnedString(result, Concat(inner_pad, "}\n"));
            ArrayPushOwnedString(result, Concat(pad, "}\n"));
            continue;
        }
        if CodegenSemanticStatementIs(statements, idx, TypedAstKindBareCallStmtTag()) {
            let call_root_id: Int =
                CodegenSemanticExpressionGraphOrDie(
                    expression_surfaces, idx, AstExpressionLaneAtom()
                );
            ArrayPushOwnedString(result, Concat(pad, Concat(
                RewriteExprFromSemanticGraph(
                    expression_surfaces.expression_graph, call_root_id, env
                ), ";\n"
            )));
            ArraySet(cur, 0, idx + 1);
            continue;
        }
        Die(Concat("unsupported AST line in supported subset: ", CodegenAstArenaProvenanceOrDie(arena, idx)));
    }
    return CodegenStatementBlockEmission(
        CodegenJoinOwnedStringFragments(result, ""), EmitFocusScopeCleanup(body_types, function_id, scope_id, scope_cleanup, pad)
    );
}
// C parameter type for a Pergyra type. `String` params are read-only.
