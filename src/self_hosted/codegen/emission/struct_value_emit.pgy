// Struct-valued expression lowering owner for self-host C emission.

import "../text/text_owner.pgy";
import "../text/expr_scan.pgy";
import "../text/expr_sequence_owner.pgy";
import "../text/struct_literal_call_owner.pgy";
import "../text/struct_literal_field_owner.pgy";
import "../type_facts/type_env.pgy";
import "../../compiler/symbol_table_owner.pgy";
import "../abi_layout/abi_layout_owner.pgy";
import "../runtime_abi/collection_runtime_owner.pgy";
import "expr_rewrite.pgy";
import "array_value_emit_owner.pgy";

// Emit a C struct-valued expression: a `Name(f: v, ...)` literal becomes a
// compound literal; anything else (e.g. a struct-returning call) passes through.
func EmitStructValue(expr: String, sname: String, env: String) -> String {
    let e: String = StringTrim(expr);
    if StructLiteralCallMatchesType(e, sname) {
        return EmitStructLit(e, env);
    }
    return RewriteExpr(e, env);
}

// Emit a C compound literal for a `Name(f: v, ...)` struct construction:
// `(Name){ .f = (v), ... }`, routing each field by the collected field type.
func EmitStructLit(expr: String, env: String) -> String {
    let e: String = StringTrim(expr);
    let call_fact: StructLiteralCallFact = StructLiteralCallFactOrDie(e, "struct literal");
    let sname: String = call_fact.type_name;
    let c_sname: String = AbiLayoutCStructTypeName(sname);
    let inner: String = call_fact.inner;
    let out: String = Concat("(", Concat(c_sname, "){ "));
    let first: Bool = true;
    let field_pos: Int = 0;
    let field_names: String = LookupKindType(env, sname, "fields");
    let field_count: Int = ExprSequenceItemCount(inner);
    while field_pos < field_count {
        let part_opt: Option<String> = ExprSequenceItemAt(inner, field_pos);
        if IsSome(part_opt) {
            let part: String = UnwrapOption(part_opt);
            let field_fact: StructLiteralFieldEntryFact = StructLiteralFieldEntryFactOrDie(part, field_names, field_pos, "struct");
            let fld: String = field_fact.field_name;
            let val: String = field_fact.value;
            if !first {
                out = Concat(out, ", ");
            }
            let ftype: String = LookupFieldType(env, sname, fld);
            if StringLength(ftype) == 0 {
                Die(Concat("struct initializer field lacks type fact: ", Concat(sname, Concat(".", fld))));
            }
            let cval: String = "";
            if ftype == "String" {
                cval = StrEval(val, env);
            } else if ftype == "Float" {
                cval = RewriteExpr(val, env);
            } else if ftype == "Int" || ftype == "Bool" {
                cval = IntEval(val, env);
            } else if StartsWith(ftype, "Array<") {
                let array_kind: String = CollectionRuntimeKindFromTypeName(ftype);
                let array_val: String = StringTrim(val);
                if StringLength(array_val) > 0 && CodegenCharAt(array_val, 0) == "[" {
                    cval = EmitArrayLiteralValue(array_val, ftype, env);
                } else {
                    cval = RewriteExpr(array_val, env);
                }
                if StringLength(array_kind) == 0 {
                    Die(Concat("unsupported struct initializer array field type: ", ftype));
                }
            } else if LookupKindType(env, ftype, "s") == "struct" {
                cval = EmitStructValue(val, ftype, env);
            } else if LookupKindType(env, ftype, "enum") == "payload_free" {
                cval = RewriteExpr(val, env);
            } else {
                Die(Concat("unsupported struct initializer field type: ", ftype));
            }
            let c_fld: String = CompilerSymbolCFieldName(fld);
            out = Concat(out, Concat(".", Concat(c_fld, Concat(" = (", Concat(cval, ")")))));
            first = false;
        }
        field_pos = field_pos + 1;
    }
    return Concat(out, " }");
}
