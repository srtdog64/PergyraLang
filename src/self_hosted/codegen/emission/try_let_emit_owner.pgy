// src/self_hosted/codegen/emission/try_let_emit_owner.pgy
// Try-expression local-binding control-flow owner for self-host C emission.

import "../text/text_owner.pgy";
import "../type_facts/type_env.pgy";
import "../input/ast_arena_codegen_view_owner.pgy";
import "../input/semantic_expression_codegen_view_owner.pgy";
import "../input/semantic_local_binding_codegen_view_owner.pgy";
import "../abi_layout/abi_layout_owner.pgy";
import "../../compiler/symbol_table_owner.pgy";
import "../../compiler/machine_layer_runtime_projection_owner.pgy";
import "../runtime_abi/option_result_runtime_owner.pgy";
import "expr_rewrite.pgy";
import "expr_semantic_graph_emit_owner.pgy";
import "function_binding_env_owner.pgy";

func EmitTryLet(
    local_bindings: SemanticAstLocalBindingFacts,
    arena: AstArena,
    idx: Int,
    graph: SemanticExpressionGraphView,
    inout env_state: Array<String>,
    cur_fn_ret: String,
    pad: String,
    cleanup: String
) -> String {
    let env: CodegenTypeEnv = CodegenTypeEnvStateView(env_state);
    let name: String = CodegenSemanticLocalBindingNameOrDie(
        local_bindings, idx
    );
    let type_name: String = CodegenSemanticLocalBindingDeclaredTypeOrDie(
        local_bindings, idx
    );
    let c_name: String = CodegenFunctionValueBindingFactFor(
        name, type_name, env_state[0]
    ).c_name;
    let operand_node: Int = CodegenSemanticTryOperandNodeOrDie(graph);
    let rendered_inner: String = RewriteExprFromSemanticGraph(
        graph.graph, operand_node, env
    );
    let tmp: String = CompilerSymbolCTryTempName(idx);
    if cur_fn_ret == "Int" && type_name == "Int" {
        CodegenTypeEnvStateAppendValueBinding(
            env_state, name, "Int", c_name
        );
        let result_out: String = Concat(
            AbiLayoutCLocalType("Result<Int>", env),
            Concat(" ", Concat(tmp, Concat(" = ",
                Concat(rendered_inner, ";\n"))))
        );
        result_out = Concat(result_out, Concat(pad, Concat(
            "if (!", Concat(OptionResultRuntimeCResultIsOkFn(),
            Concat("(", Concat(tmp, ")) {\n")))
        )));
        result_out = Concat(result_out, cleanup);
        result_out = Concat(result_out, Concat(
            pad, Concat("    ", Concat(
                CompilerRuntimeCallAbiMachineLayerRemoteFutureTryFailureStmt(),
                "\n"
            ))
        ));
        result_out = Concat(result_out, Concat(pad, "}\n"));
        result_out = Concat(result_out, Concat(pad, Concat(
            AbiLayoutCLocalType("Int", env), Concat(" ", Concat(
                c_name, Concat(" = ", Concat(
                    OptionResultRuntimeCResultUnwrapFn(),
                    Concat("(", Concat(tmp, ");"))
                ))
            ))
        )));
        return result_out;
    }
    if StartsWith(cur_fn_ret, "Result<") &&
        StringIndexOf(cur_fn_ret, "Int") >= 0 {
        if type_name != "Int" {
            Die(Concat(
                "unsupported Result try let payload type in self-host codegen subset: ",
                CodegenAstArenaProvenanceOrDie(arena, idx)
            ));
        }
        CodegenTypeEnvStateAppendValueBinding(
            env_state, name, "Int", c_name
        );
        let result_out: String = Concat(
            AbiLayoutCLocalType("Result<Int>", env),
            Concat(" ", Concat(tmp, Concat(" = ", Concat(
                rendered_inner, ";\n"
            ))))
        );
        result_out = Concat(result_out, Concat(pad, Concat(
            "if (!", Concat(OptionResultRuntimeCResultIsOkFn(),
            Concat("(", Concat(tmp, ")) {\n")))
        )));
        result_out = Concat(result_out, cleanup);
        result_out = Concat(result_out, Concat(
            pad, Concat("    return ", Concat(tmp, ";\n"))
        ));
        result_out = Concat(result_out, Concat(pad, "}\n"));
        result_out = Concat(result_out, Concat(pad, Concat(
            AbiLayoutCLocalType("Int", env), Concat(" ", Concat(
                c_name, Concat(" = ", Concat(
                    OptionResultRuntimeCResultUnwrapFn(),
                    Concat("(", Concat(tmp, ");"))
                ))
            ))
        )));
        return result_out;
    }
    if StartsWith(cur_fn_ret, "Option<") {
        let return_payload_kind: Int =
            OptionResultRuntimeOptionPayloadKindForType(cur_fn_ret);
        if return_payload_kind == 0 {
            Die(Concat(
                "unsupported option try return payload type: ", cur_fn_ret
            ));
        }
        let inner_kind_opt: Option<String> = CodegenExpressionTypeFromGraph(
            graph.graph, operand_node, env
        );
        if !IsSome(inner_kind_opt) {
            Die(Concat(
                "semantic try-expression operand type is missing: ",
                CodegenAstArenaProvenanceOrDie(arena, idx)
            ));
        }
        let inner_kind: String = UnwrapOption(inner_kind_opt);
        let operand_payload_kind: Int =
            OptionResultRuntimeOptionPayloadKindForType(inner_kind);
        if operand_payload_kind == 0 {
            operand_payload_kind =
                OptionResultRuntimeOptionPayloadKindFromEnvKind(inner_kind);
        }
        let operand_value_type: String =
            OptionResultRuntimeOptionValueTypeForPayloadKind(
                operand_payload_kind
            );
        if StringLength(operand_value_type) == 0 ||
            operand_value_type != type_name {
            Die(Concat(
                "try expression payload type does not match let type: ",
                CodegenAstArenaProvenanceOrDie(arena, idx)
            ));
        }
        CodegenTypeEnvStateAppendValueBinding(
            env_state, name, type_name, c_name
        );
        let operand_option_type: String =
            OptionResultRuntimeOptionTypeNameForPayloadKind(
                operand_payload_kind
            );
        let option_out: String = Concat(
            AbiLayoutCLocalType(operand_option_type, env),
            Concat(" ", Concat(tmp, Concat(" = ", Concat(
                rendered_inner, ";\n"
            ))))
        );
        option_out = Concat(option_out, Concat(pad, Concat(
            "if (!", Concat(OptionResultRuntimeCOptionIsSomeFn(),
            Concat("(", Concat(tmp, ")) {\n")))
        )));
        option_out = Concat(option_out, cleanup);
        option_out = Concat(option_out, Concat(pad, Concat(
            "    return ", Concat(
                OptionResultRuntimeCOptionNoneFnForPayloadKind(
                    return_payload_kind
                ),
                "();\n"
            )
        )));
        option_out = Concat(option_out, Concat(pad, "}\n"));
        option_out = Concat(option_out, Concat(pad, Concat(
            AbiLayoutCLocalType(type_name, env), Concat(" ", Concat(
                c_name, Concat(" = ", Concat(
                    OptionResultRuntimeCOptionUnwrapFn(),
                    Concat("(", Concat(tmp, ");"))
                ))
            ))
        )));
        return option_out;
    }
    Die(Concat(
        "try expression requires Result<Int> or Option<T> function return: ",
        CodegenAstArenaProvenanceOrDie(arena, idx)
    ));
    return "";
}
