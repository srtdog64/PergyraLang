// Owner-directed value declaration scheduling; direct by-value cycles fail closed.

import "enum_emit_owner.pgy";
import "function_emit.pgy";
import "result_runtime_emit_owner.pgy";
import "../text/text_owner.pgy";
import "../input/result_usage_owner.pgy";
import "../runtime_abi/option_result_runtime_owner.pgy";
import "../runtime_abi/result_runtime_owner.pgy";
import "../input/semantic_enum_codegen_view_owner.pgy";
import "../input/semantic_nominal_codegen_view_owner.pgy";
struct CodegenTypeDeclarationBlockFact {
    let c_block: String;
    let requires_bool_header: Bool;
}

func CodegenTypeDeclarationZeroMask(count: Int) -> Array<Int> {
    let rows: Array<Int> = [];
    let i: Int = 0;
    while i < count {
        ArrayPush(rows, 0);
        i = i + 1;
    }
    return rows;
}
func CodegenTypeDeclarationNominalIndexForName(
    facts: SemanticAstNominalConstructorFacts,
    name: String
) -> Option<Int> {
    let i: Int = 0;
    while i < SemanticAstNominalConstructorCount(facts) {
        if CodegenSemanticNominalNameOrDie(facts, i) == name {
            return Some(i);
        }
        i = i + 1;
    }
    return None;
}
func CodegenTypeDeclarationEnumIndexForName(
    facts: SemanticAstEnumFacts,
    name: String
) -> Option<Int> {
    let i: Int = 0;
    while i < SemanticAstEnumCount(facts) {
        if CodegenSemanticEnumNameAtOrDie(facts, i) == name {
            return Some(i);
        }
        i = i + 1;
    }
    return None;
}

func CodegenTypeDeclarationResultIndexForName(
    facts: CodegenResultUsageFacts,
    name: String
) -> Option<Int> {
    let i: Int = 0;
    while i < ArrayLength(facts.type_names) {
        if facts.type_names[i] == name { return Some(i); }
        i = i + 1;
    }
    return None;
}

func CodegenTypeDeclarationDependencyReady(
    type_name: String,
    nominal_facts: SemanticAstNominalConstructorFacts,
    enum_facts: SemanticAstEnumFacts,
    result_facts: CodegenResultUsageFacts,
    nominal_emitted: Array<Int>,
    enum_emitted: Array<Int>,
    result_emitted: Array<Int>
) -> Bool {
    let option_inner: Option<String> =
        OptionResultRuntimeOptionInnerTypeName(type_name);
    if IsSome(option_inner) {
        return CodegenTypeDeclarationDependencyReady(
            UnwrapOption(option_inner), nominal_facts, enum_facts, result_facts,
            nominal_emitted, enum_emitted, result_emitted
        );
    }
    let result_fact: ResultRuntimeFact = ResultRuntimeFactForType(type_name);
    if result_fact.ok {
        let result_index: Option<Int> =
            CodegenTypeDeclarationResultIndexForName(result_facts, type_name);
        if !IsSome(result_index) {
            Die("Result declaration usage fact is missing");
        }
        return result_emitted[UnwrapOption(result_index)] != 0;
    }
    let nominal_index: Option<Int> =
        CodegenTypeDeclarationNominalIndexForName(nominal_facts, type_name);
    if IsSome(nominal_index) {
        return nominal_emitted[UnwrapOption(nominal_index)] != 0;
    }
    let enum_index: Option<Int> =
        CodegenTypeDeclarationEnumIndexForName(enum_facts, type_name);
    if IsSome(enum_index) {
        return enum_emitted[UnwrapOption(enum_index)] != 0;
    }
    return true;
}

func CodegenNominalDeclarationDependenciesReady(
    nominal_index: Int,
    nominal_facts: SemanticAstNominalConstructorFacts,
    enum_facts: SemanticAstEnumFacts,
    result_facts: CodegenResultUsageFacts,
    nominal_emitted: Array<Int>,
    enum_emitted: Array<Int>,
    result_emitted: Array<Int>
) -> Bool {
    let field_count: Int = CodegenSemanticNominalFieldCountOrDie(
        nominal_facts, nominal_index
    );
    let field_index: Int = 0;
    while field_index < field_count {
        let field_type: String = CodegenSemanticNominalFieldTypeOrDie(
            nominal_facts, nominal_index, field_index
        );
        if !CodegenTypeDeclarationDependencyReady(
            field_type, nominal_facts, enum_facts, result_facts,
            nominal_emitted, enum_emitted, result_emitted
        ) {
            return false;
        }
        field_index = field_index + 1;
    }
    return true;
}

func CodegenEnumDeclarationDependenciesReady(
    enum_index: Int,
    nominal_facts: SemanticAstNominalConstructorFacts,
    enum_facts: SemanticAstEnumFacts,
    result_facts: CodegenResultUsageFacts,
    nominal_emitted: Array<Int>,
    enum_emitted: Array<Int>,
    result_emitted: Array<Int>
) -> Bool {
    let enum_name: String = CodegenSemanticEnumNameAtOrDie(
        enum_facts, enum_index
    );
    let variant_count: Int = CodegenSemanticEnumVariantCount(
        enum_facts, enum_name
    );
    let variant_index: Int = 0;
    while variant_index < variant_count {
        let variant_name: String = CodegenSemanticEnumVariantNameAtOrDie(
            enum_facts, enum_name, variant_index
        );
        let payload_count: Int =
            CodegenSemanticEnumVariantParamCountAtOrDie(
                enum_facts, enum_name, variant_index
            );
        let payload_index: Int = 0;
        while payload_index < payload_count {
            let payload_type: String =
                CodegenSemanticEnumVariantPayloadTypeAtOrDie(
                    enum_facts, enum_name, variant_name, payload_index
                );
            if !CodegenTypeDeclarationDependencyReady(
                payload_type, nominal_facts, enum_facts, result_facts,
                nominal_emitted, enum_emitted, result_emitted
            ) {
                return false;
            }
            payload_index = payload_index + 1;
        }
        variant_index = variant_index + 1;
    }
    return true;
}

func CodegenResultDeclarationDependenciesReady(
    result_index: Int,
    result_facts: CodegenResultUsageFacts,
    nominal_facts: SemanticAstNominalConstructorFacts,
    enum_facts: SemanticAstEnumFacts,
    nominal_emitted: Array<Int>,
    enum_emitted: Array<Int>,
    result_emitted: Array<Int>
) -> Bool {
    let fact: ResultRuntimeFact = ResultRuntimeFactForType(
        result_facts.type_names[result_index]
    );
    if !fact.ok { Die("explicit Result<T, E> runtime fact is missing"); }
    return CodegenTypeDeclarationDependencyReady(
        fact.payload_type, nominal_facts, enum_facts, result_facts,
        nominal_emitted, enum_emitted, result_emitted
    ) && CodegenTypeDeclarationDependencyReady(
        fact.error_type, nominal_facts, enum_facts, result_facts,
        nominal_emitted, enum_emitted, result_emitted
    );
}

func CodegenTypeDeclarationNamedOptionDefinition(
    name: String, env: String, required: Bool
) -> OptionStructDefinitionBlockFact {
    let fact: OptionStructDefinitionBlockFact =
        OptionResultRuntimeCNamedOptionDefinition(name, env);
    if required && !fact.requires_bool_header {
        Die("named Option declaration fact is missing");
    }
    return fact;
}

func CollectTypeDeclarations(
    enum_facts: SemanticAstEnumFacts,
    nominal_facts: SemanticAstNominalConstructorFacts,
    result_facts: CodegenResultUsageFacts,
    inout env_box: Array<String>
) -> CodegenTypeDeclarationBlockFact {
    let enum_count: Int = SemanticAstEnumCount(enum_facts);
    let nominal_count: Int = SemanticAstNominalConstructorCount(nominal_facts);
    let result_count: Int = ArrayLength(result_facts.type_names);
    let enum_emitted: Array<Int> = CodegenTypeDeclarationZeroMask(enum_count);
    let nominal_emitted: Array<Int> =
        CodegenTypeDeclarationZeroMask(nominal_count);
    let result_emitted: Array<Int> =
        CodegenTypeDeclarationZeroMask(result_count);
    let remaining: Int = enum_count + nominal_count + result_count;
    let blocks: Array<String> = [];
    let requires_bool_header: Bool = false;
    while remaining > 0 {
        let made_progress: Bool = false;
        let enum_selected: Array<Int> =
            CodegenTypeDeclarationZeroMask(enum_count);
        let enum_selected_count: Int = 0;
        let enum_index: Int = 0;
        while enum_index < enum_count {
            if enum_emitted[enum_index] == 0 &&
                CodegenEnumDeclarationDependenciesReady(
                    enum_index, nominal_facts, enum_facts, result_facts,
                    nominal_emitted, enum_emitted, result_emitted
                ) {
                ArraySet(enum_selected, enum_index, 1);
                enum_selected_count = enum_selected_count + 1;
            }
            enum_index = enum_index + 1;
        }
        if enum_selected_count > 0 {
            ArrayPush(blocks, CollectEnumsSelected(
                enum_facts, enum_selected, env_box
            ));
            enum_index = 0;
            while enum_index < enum_count {
                if enum_selected[enum_index] != 0 {
                    ArraySet(enum_emitted, enum_index, 1);
                    let enum_name: String = CodegenSemanticEnumNameAtOrDie(
                        enum_facts, enum_index
                    );
                    let option_definition: OptionStructDefinitionBlockFact =
                        CodegenTypeDeclarationNamedOptionDefinition(
                            enum_name, env_box[0], LookupKindTypeRows(
                                env_box[0], enum_name, "enum"
                            ) == "tagged"
                        );
                    if option_definition.requires_bool_header {
                        ArrayPush(blocks, option_definition.c_block);
                        requires_bool_header = true;
                    }
                }
                enum_index = enum_index + 1;
            }
            remaining = remaining - enum_selected_count;
            made_progress = true;
        }

        let nominal_selected: Array<Int> =
            CodegenTypeDeclarationZeroMask(nominal_count);
        let nominal_selected_count: Int = 0;
        let nominal_index: Int = 0;
        while nominal_index < nominal_count {
            if nominal_emitted[nominal_index] == 0 &&
                CodegenNominalDeclarationDependenciesReady(
                    nominal_index, nominal_facts, enum_facts, result_facts,
                    nominal_emitted, enum_emitted, result_emitted
                ) {
                ArraySet(nominal_selected, nominal_index, 1);
                nominal_selected_count = nominal_selected_count + 1;
            }
            nominal_index = nominal_index + 1;
        }
        if nominal_selected_count > 0 {
            ArrayPush(blocks, CollectStructsSelected(
                nominal_facts, nominal_selected, env_box
            ));
            nominal_index = 0;
            while nominal_index < nominal_count {
                if nominal_selected[nominal_index] != 0 {
                    ArraySet(nominal_emitted, nominal_index, 1);
                    let option_definition: OptionStructDefinitionBlockFact =
                        CodegenTypeDeclarationNamedOptionDefinition(
                            CodegenSemanticNominalNameOrDie(
                                nominal_facts, nominal_index
                            ), env_box[0], true
                        );
                    if option_definition.requires_bool_header {
                        ArrayPush(blocks, option_definition.c_block);
                        requires_bool_header = true;
                    }
                }
                nominal_index = nominal_index + 1;
            }
            remaining = remaining - nominal_selected_count;
            made_progress = true;
        }
        let result_index: Int = 0;
        while result_index < result_count {
            if result_emitted[result_index] == 0 &&
                CodegenResultDeclarationDependenciesReady(
                    result_index, result_facts, nominal_facts, enum_facts,
                    nominal_emitted, enum_emitted, result_emitted
                ) {
                ArrayPush(blocks, EmitResultRuntimeDefinition(
                    result_facts.type_names[result_index],
                    CodegenTypeEnv(env_box[0], "")
                ));
                ArraySet(result_emitted, result_index, 1);
                remaining = remaining - 1;
                made_progress = true;
            }
            result_index = result_index + 1;
        }
        if !made_progress {
            Die("cyclic by-value type declaration dependency");
        }
    }
    return CodegenTypeDeclarationBlockFact(
        StringJoin(blocks, ""), requires_bool_header
    );
}
