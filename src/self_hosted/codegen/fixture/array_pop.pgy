func Main() -> Void {
    var xs: Array<Int> = [10, 20, 30, 40];
    ArrayPop(xs);
    ArrayPop(xs);
    var total: Int = 0;
    for v in xs {
        total = total + v;
    }
    Log(ToString(total));
    Log(ToString(ArrayLength(xs)));
    var ws: Array<String> = ["a", "b", "c"];
    ArrayPop(ws);
    Log(ToString(ArrayLength(ws)));
    Log(ws[0]);
}
