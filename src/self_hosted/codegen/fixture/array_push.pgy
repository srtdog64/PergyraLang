func Main() -> Void {
    var xs: Array<Int> = [];
    var i: Int = 0;
    while i < 5 {
        ArrayPush(xs, i * i);
        i = i + 1;
    }
    var total: Int = 0;
    var j: Int = 0;
    while j < ArrayLength(xs) {
        total = total + xs[j];
        j = j + 1;
    }
    Log(ToString(total));
    Log(ToString(ArrayLength(xs)));
}
