func Classify(n: Int) -> String {
    if n < 0 {
        return "neg";
    } else if n == 0 {
        return "zero";
    } else if n < 10 {
        return "small";
    } else if n == 10 {
        return "small";
    } else if n == 11 {
        return "small";
    } else if n == 12 {
        return "small";
    } else if n == 13 {
        return "small";
    } else if n == 14 {
        return "small";
    } else if n == 15 {
        return "small";
    } else if n == 16 {
        return "small";
    } else if n == 17 {
        return "small";
    } else if n == 18 {
        return "small";
    } else if n == 19 {
        return "small";
    } else if n == 20 {
        return "small";
    } else if n == 21 {
        return "small";
    } else if n == 22 {
        return "small";
    } else if n == 23 {
        return "small";
    } else if n == 24 {
        return "small";
    } else if n == 25 {
        return "small";
    } else if n == 26 {
        return "small";
    } else if n == 27 {
        return "small";
    } else if n == 28 {
        return "small";
    } else if n == 29 {
        return "small";
    } else if n == 30 {
        return "small";
    } else if n == 31 {
        return "small";
    } else if n == 32 {
        return "small";
    } else if n == 33 {
        return "small";
    } else if n == 34 {
        return "small";
    } else if n == 35 {
        return "small";
    } else if n == 36 {
        return "small";
    } else if n == 37 {
        return "small";
    } else if n == 38 {
        return "small";
    } else if n == 39 {
        return "small";
    } else if n == 40 {
        return "small";
    } else if n == 41 {
        return "small";
    } else if n == 42 {
        return "small";
    } else if n == 43 {
        return "small";
    } else if n == 44 {
        return "small";
    } else if n == 45 {
        return "small";
    } else if n == 46 {
        return "small";
    } else if n == 47 {
        return "small";
    } else {
        return "big";
    }
}
func Main() -> Void {
    Log(Classify(0 - 5));
    Log(Classify(0));
    Log(Classify(7));
    Log(Classify(100));
}
