func Classify(n: Int) -> String {
    if n < 0 {
        return "neg";
    } else if n == 0 {
        return "zero";
    } else if n < 10 {
        return "small";
    } else {
        return "big";
    }
}
func Main() -> Void {
    Log(Classify(0 - 5));
    Log(Classify(0));
    Log(Classify(7));
    Log(Classify(100));
}
