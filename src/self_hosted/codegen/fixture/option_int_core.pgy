func Main() -> Void {
    let a: Option<Int> = None;
    a = Some(7);
    let b: Option<Int> = Some(1);
    b = None();
    if IsSome(a) {
        Log(UnwrapOption(a));
        let sum: Int = UnwrapOption(a) + 3;
        Log(sum);
    }
    if !IsSome(b) {
        Log(0);
    }
    let wide: Option<Long> = Some(4294967297L);
    let no_wide: Option<Long> = None;
    if IsSome(wide) {
        Log(UnwrapOption(wide));
    }
    if !IsSome(no_wide) {
        Log(0L);
    }
}
