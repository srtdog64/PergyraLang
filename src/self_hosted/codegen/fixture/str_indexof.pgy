func Main() -> Void {
    let s: String = "hello,world";
    let p: Int = StringIndexOf(s, ",");
    Log(ToString(p));
    let q: Int = StringIndexOf(s, "z");
    Log(ToString(q));
    let left: String = Substring(s, 0, p);
    let right: String = Substring(s, p + 1, StringLength(s) - p - 1);
    Log(left);
    Log(right);
    Log(CharAtN(s, StringLength(s), 2));
    Log(CharAtN(s, 1, 1));
    Log(ToString(CharCode(s, StringLength(s), 2)));
    Log(ToString(CharCode(s, 1, 1)));
    Log(ToString(SubIndexOfWithLen(s, StringLength(s), 1, 5, "lo")));
    Log(ToString(SubIndexOfWithLen(s, StringLength(s), 99, 5, "lo")));
    Log("done");
}
