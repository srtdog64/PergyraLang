// Self-host codegen parity fixture manifest owner.
//
// Owns the committed codegen fixture frontier used by codegen parity and by
// later hard-substitution gates that consume the same source corpus.

func CodegenParityFixtureDir() -> String {
    return "src/self_hosted/codegen/fixture";
}

func CodegenParityExpectedDir() -> String {
    return "src/self_hosted/codegen/expected";
}

func CodegenParityFixtureExpectedCount() -> Int {
    return 85;
}

func CodegenParityPathEndsWith(path: String, suffix: String) -> Bool {
    let path_len: Int = StringLength(path);
    let suffix_len: Int = StringLength(suffix);
    if suffix_len > path_len {
        return false;
    }
    return Substring(path, path_len - suffix_len, suffix_len) == suffix;
}

func CodegenParityBaseName(path: String, suffix: String) -> String {
    if !CodegenParityPathEndsWith(path, suffix) {
        return "";
    }
    let last_slash: Int = -1;
    let i: Int = 0;
    while i < StringLength(path) {
        if Substring(path, i, 1) == "/" {
            last_slash = i;
        }
        i = i + 1;
    }
    let start: Int = last_slash + 1;
    let len: Int = StringLength(path) - start - StringLength(suffix);
    if len <= 0 {
        return "";
    }
    return Substring(path, start, len);
}

func CodegenParityFixtureSourcePath(base: String) -> String {
    return Concat(Concat(CodegenParityFixtureDir(), "/"), Concat(base, ".pgy"));
}

func CodegenParityExpectedPath(base: String) -> String {
    return Concat(Concat(CodegenParityExpectedDir(), "/"), Concat(base, "_stdout.txt"));
}

func CodegenParityFixtureManifestRows() -> Array<String> {
    let entries: Array<String> = DirWalk(CodegenParityFixtureDir());
    let rows: Array<String> = [];
    let i: Int = 0;
    while i < ArrayLength(entries) {
        let path: String = entries[i];
        if CodegenParityPathEndsWith(path, ".pgy") {
            let base: String = CodegenParityBaseName(path, ".pgy");
            if StringLength(base) > 0 && FileExists(CodegenParityExpectedPath(base)) {
                ArrayPush(rows, base);
            }
        }
        i = i + 1;
    }
    return rows;
}

func CodegenParityFixtureManifestReady() -> Bool {
    return ArrayLength(CodegenParityFixtureManifestRows()) ==
        CodegenParityFixtureExpectedCount();
}
