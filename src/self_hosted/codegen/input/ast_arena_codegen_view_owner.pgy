func CodegenAstArenaExpectKind(arena: AstArena, count: Int, inout cur: Array<Int>, expected_kind: Int, label: String) -> Void {
    if cur[0] >= count {
        Die(Concat("expected `", Concat(label, "` but reached end of typed AST arena")));
    }
    if !TypedAstArenaNodeKindIs(arena, cur[0], expected_kind) {
        Die(Concat("expected `", Concat(label, Concat("` at typed AST node: ", ToString(cur[0])))));
    }
    ArraySet(cur, 0, cur[0] + 1);
}

func CodegenAstArenaExpectParameters(arena: AstArena, count: Int, inout cur: Array<Int>) -> Void {
    CodegenAstArenaExpectKind(arena, count, cur, TypedAstKindParametersTag(), "Parameters:");
}

func CodegenAstArenaExpectBody(arena: AstArena, count: Int, inout cur: Array<Int>) -> Void {
    CodegenAstArenaExpectKind(arena, count, cur, TypedAstKindBodyTag(), "Body:");
}

func CodegenAstArenaExpectBlock(arena: AstArena, count: Int, inout cur: Array<Int>) -> Void {
