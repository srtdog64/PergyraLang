func CodegenAstArenaIsProgramRoot(arena: AstArena, node_id: Int) -> Bool {
    return TypedAstArenaNodeKindIs(arena, node_id, TypedAstKindProgramTag());
}

func CodegenAstArenaIsParameters(arena: AstArena, node_id: Int) -> Bool {
    return TypedAstArenaNodeKindIs(arena, node_id, TypedAstKindParametersTag());
}

func CodegenAstArenaIsReturns(arena: AstArena, node_id: Int) -> Bool {
    return TypedAstArenaNodeKindIs(arena, node_id, TypedAstKindReturnsTag());
}

func CodegenAstArenaIsFieldsHeader(arena: AstArena, node_id: Int) -> Bool {
    return TypedAstArenaNodeKindIs(arena, node_id, TypedAstKindFieldsHeaderTag());
}

func CodegenAstArenaIsBody(arena: AstArena, node_id: Int) -> Bool {
    return TypedAstArenaNodeKindIs(arena, node_id, TypedAstKindBodyTag());
