// Codegen-only fail-closed and routing view over shared AstArena facts.

import "../../hir/ast_text_arena_projection_owner.pgy";
import "../../hir/ast_node_kind_owner.pgy";
import "../text/text_owner.pgy";

func CodegenAstArenaIndentOrDie(arena: AstArena, node_id: Int) -> Int {
    let indent: Option<Int> = TypedAstArenaIndent(arena, node_id);
    if !IsSome(indent) {
        Die(Concat("typed AST arena missing indent for node: ", ToString(node_id)));
    }
    return UnwrapOption(indent);
}

func CodegenAstArenaProvenanceOrDie(arena: AstArena, node_id: Int) -> String {
    let provenance: Option<String> = TypedAstArenaProvenanceText(arena, node_id);
    if !IsSome(provenance) {
        Die(Concat("typed AST arena missing provenance for node: ", ToString(node_id)));
    }
    return UnwrapOption(provenance);
}

func CodegenAstTreeArtifactReady(artifact: AstTreeArtifact) -> Bool {
    return AstTreeArtifactReady(artifact) &&
        artifact.count > 0 && CodegenAstArenaIsProgramRoot(artifact.arena, 0);
}

