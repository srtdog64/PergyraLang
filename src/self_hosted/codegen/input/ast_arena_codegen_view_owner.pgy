func CodegenAstArenaIsMainFunction(arena: AstArena, node_id: Int) -> Bool {
    if !CodegenAstArenaIsFunction(arena, node_id) {
        return false;
    }
    let atom: Option<String> = TypedAstArenaAtomText(arena, node_id);
    if !IsSome(atom) {
        return false;
    }
    return UnwrapOption(atom) == "Main";
}

