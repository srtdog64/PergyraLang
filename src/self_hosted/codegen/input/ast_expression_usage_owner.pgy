// Codegen expression usage fact owner.
//
// Runtime/header usage decisions need to know which expression-level builtin
// families are present. The matching is still backed by the transitional typed
// arena payload strings, but the scan and builtin vocabulary are owned here so
// runtime/header usage can consume a fact row instead of reopening payloads.

import "../text/text_owner.pgy";
import "ast_text_typed_arena_owner.pgy";

struct CodegenExpressionUsageFacts {
    let has_args: Bool;
    let has_string: Bool;
    let has_math: Bool;
    let has_array_sort: Bool;
    let has_array_reverse: Bool;
    let has_array_map: Bool;
    let has_array_filter: Bool;
    let has_result: Bool;
    let has_option: Bool;
    let has_exit: Bool;
    let has_array_core: Bool;
    let has_io: Bool;
    let has_join: Bool;
    let has_split: Bool;
    let has_dirwalk: Bool;
    let has_log: Bool;
    let has_file_handle: Bool;
    let has_print: Bool;
    let has_float: Bool;
    let has_random_value: Bool;
    let has_seed_random: Bool;
    let has_none: Bool;
}

func CodegenUsageBuiltinGroupArgs() -> Int { return 1; }
func CodegenUsageBuiltinGroupString() -> Int { return 2; }
func CodegenUsageBuiltinGroupMath() -> Int { return 3; }
func CodegenUsageBuiltinGroupArraySort() -> Int { return 4; }
func CodegenUsageBuiltinGroupArrayReverse() -> Int { return 5; }
func CodegenUsageBuiltinGroupArrayMap() -> Int { return 6; }
func CodegenUsageBuiltinGroupArrayFilter() -> Int { return 7; }
func CodegenUsageBuiltinGroupResult() -> Int { return 8; }
func CodegenUsageBuiltinGroupOption() -> Int { return 9; }
func CodegenUsageBuiltinGroupExit() -> Int { return 10; }
func CodegenUsageBuiltinGroupArrayCore() -> Int { return 11; }
func CodegenUsageBuiltinGroupIo() -> Int { return 12; }
func CodegenUsageBuiltinGroupJoin() -> Int { return 13; }
func CodegenUsageBuiltinGroupSplit() -> Int { return 14; }
func CodegenUsageBuiltinGroupDirWalk() -> Int { return 15; }
func CodegenUsageBuiltinGroupLog() -> Int { return 16; }
func CodegenUsageBuiltinGroupFileHandle() -> Int { return 17; }
func CodegenUsageBuiltinGroupPrint() -> Int { return 18; }
func CodegenUsageBuiltinGroupFloat() -> Int { return 19; }
func CodegenUsageBuiltinGroupRandomValue() -> Int { return 20; }
func CodegenUsageBuiltinGroupSeedRandom() -> Int { return 21; }

func CodegenUsageBuiltinGroupCalleeCount(group: Int) -> Int {
    if group == CodegenUsageBuiltinGroupArgs() { return 1; }
    if group == CodegenUsageBuiltinGroupString() { return 20; }
    if group == CodegenUsageBuiltinGroupMath() { return 3; }
    if group == CodegenUsageBuiltinGroupArraySort() { return 1; }
    if group == CodegenUsageBuiltinGroupArrayReverse() { return 1; }
    if group == CodegenUsageBuiltinGroupArrayMap() { return 1; }
    if group == CodegenUsageBuiltinGroupArrayFilter() { return 1; }
    if group == CodegenUsageBuiltinGroupResult() { return 6; }
    if group == CodegenUsageBuiltinGroupOption() { return 3; }
    if group == CodegenUsageBuiltinGroupExit() { return 1; }
    if group == CodegenUsageBuiltinGroupArrayCore() { return 9; }
    if group == CodegenUsageBuiltinGroupIo() { return 4; }
    if group == CodegenUsageBuiltinGroupJoin() { return 2; }
    if group == CodegenUsageBuiltinGroupSplit() { return 1; }
    if group == CodegenUsageBuiltinGroupDirWalk() { return 1; }
    if group == CodegenUsageBuiltinGroupLog() { return 1; }
    if group == CodegenUsageBuiltinGroupFileHandle() { return 4; }
    if group == CodegenUsageBuiltinGroupPrint() { return 1; }
    if group == CodegenUsageBuiltinGroupFloat() { return 5; }
    if group == CodegenUsageBuiltinGroupRandomValue() { return 1; }
    if group == CodegenUsageBuiltinGroupSeedRandom() { return 1; }
    return 0;
}

func CodegenUsageBuiltinGroupCalleeAt(group: Int, index: Int) -> String {
    if group == CodegenUsageBuiltinGroupArgs() {
        if index == 0 { return "Args"; }
    }
    if group == CodegenUsageBuiltinGroupString() {
        if index == 0 { return "Concat"; }
        if index == 1 { return "Substring"; }
        if index == 2 { return "StringLength"; }
        if index == 3 { return "StringContains"; }
        if index == 4 { return "StringIndexOf"; }
        if index == 5 { return "StringTrim"; }
        if index == 6 { return "StringReplace"; }
        if index == 7 { return "SubIndexOfWithLen"; }
        if index == 8 { return "SubEqualsWithLen"; }
        if index == 9 { return "SubContainsWithLen"; }
        if index == 10 { return "SubStartsWithLen"; }
        if index == 11 { return "CharCode"; }
        if index == 12 { return "CharAtN"; }
        if index == 13 { return "ToInt"; }
        if index == 14 { return "ToString"; }
        if index == 15 { return "ToUpper"; }
        if index == 16 { return "ToLower"; }
        if index == 17 { return "StringJoin"; }
        if index == 18 { return "Join"; }
        if index == 19 { return "Split"; }
    }
    if group == CodegenUsageBuiltinGroupMath() {
        if index == 0 { return "Abs"; }
        if index == 1 { return "Min"; }
        if index == 2 { return "Max"; }
    }
    if group == CodegenUsageBuiltinGroupArraySort() && index == 0 { return "ArraySort"; }
    if group == CodegenUsageBuiltinGroupArrayReverse() && index == 0 { return "ArrayReverse"; }
    if group == CodegenUsageBuiltinGroupArrayMap() && index == 0 { return "ArrayMap"; }
    if group == CodegenUsageBuiltinGroupArrayFilter() && index == 0 { return "ArrayFilter"; }
    if group == CodegenUsageBuiltinGroupResult() {
        if index == 0 { return "Ok"; }
        if index == 1 { return "Err"; }
        if index == 2 { return "IsOk"; }
        if index == 3 { return "IsErr"; }
        if index == 4 { return "Unwrap"; }
        if index == 5 { return "UnwrapOr"; }
    }
    if group == CodegenUsageBuiltinGroupOption() {
        if index == 0 { return "Some"; }
        if index == 1 { return "IsSome"; }
        if index == 2 { return "UnwrapOption"; }
    }
    if group == CodegenUsageBuiltinGroupExit() && index == 0 { return "Exit"; }
    if group == CodegenUsageBuiltinGroupArrayCore() {
        if index == 0 { return "ArrayPush"; }
        if index == 1 { return "ArrayLength"; }
        if index == 2 { return "ArraySet"; }
        if index == 3 { return "ArrayPop"; }
        if index == 4 { return "StringJoin"; }
        if index == 5 { return "Join"; }
        if index == 6 { return "Split"; }
        if index == 7 { return "DirWalk"; }
        if index == 8 { return "Args"; }
    }
    if group == CodegenUsageBuiltinGroupIo() {
        if index == 0 { return "ReadFile"; }
        if index == 1 { return "ReadStdin"; }
        if index == 2 { return "FileExists"; }
        if index == 3 { return "WriteFile"; }
    }
    if group == CodegenUsageBuiltinGroupJoin() {
        if index == 0 { return "StringJoin"; }
        if index == 1 { return "Join"; }
    }
    if group == CodegenUsageBuiltinGroupSplit() && index == 0 { return "Split"; }
    if group == CodegenUsageBuiltinGroupDirWalk() && index == 0 { return "DirWalk"; }
    if group == CodegenUsageBuiltinGroupLog() && index == 0 { return "Log"; }
    if group == CodegenUsageBuiltinGroupFileHandle() {
        if index == 0 { return "FileOpen"; }
        if index == 1 { return "FileWrite"; }
        if index == 2 { return "FileClose"; }
        if index == 3 { return "FileRead"; }
    }
    if group == CodegenUsageBuiltinGroupPrint() && index == 0 { return "Print"; }
    if group == CodegenUsageBuiltinGroupFloat() {
        if index == 0 { return "Sqrt"; }
        if index == 1 { return "Pow"; }
        if index == 2 { return "Floor"; }
        if index == 3 { return "Ceil"; }
        if index == 4 { return "ToFloat"; }
    }
    if group == CodegenUsageBuiltinGroupRandomValue() && index == 0 { return "Random"; }
    if group == CodegenUsageBuiltinGroupSeedRandom() && index == 0 { return "SeedRandom"; }
    return "";
}

func CodegenAstArenaExpressionPartHasToken(part: Option<String>, token: String) -> Bool {
    if !IsSome(part) {
        return false;
    }
    let text: String = UnwrapOption(part);
    let n: Int = StringLength(text);
    let m: Int = StringLength(token);
    let i: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CodegenCharAt(text, i);
        if in_str {
            if c == "\\" {
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            i = i + 1;
            continue;
        }
        if m > 0 && i + m <= n && Substring(text, i, m) == token {
            let before_ok: Bool = i == 0 || !IsIdentChar(CodegenCharAt(text, i - 1));
            let after_pos: Int = i + m;
            let after_ok: Bool = after_pos >= n || !IsIdentChar(CodegenCharAt(text, after_pos));
            if before_ok && after_ok {
                return true;
            }
        }
        i = i + 1;
    }
    return false;
}

func CodegenAstArenaExpressionPartCalls(part: Option<String>, callee: String) -> Bool {
    if !IsSome(part) {
        return false;
    }
    return ContainsCallOutsideStrings(UnwrapOption(part), callee);
}

func CodegenAstArenaExpressionTokenPresent(arena: AstArena, count: Int, token: String) -> Bool {
    let i: Int = 0;
    while i < count {
        if CodegenAstArenaExpressionPartHasToken(TypedAstArenaAtomText(arena, i), token) ||
            CodegenAstArenaExpressionPartHasToken(TypedAstArenaValueText(arena, i), token) ||
            CodegenAstArenaExpressionPartHasToken(TypedAstArenaAuxValueText(arena, i), token) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func CodegenAstArenaBuiltinCallPresent(arena: AstArena, count: Int, callee: String) -> Bool {
    let i: Int = 0;
    while i < count {
        if CodegenAstArenaExpressionPartCalls(TypedAstArenaAtomText(arena, i), callee) ||
            CodegenAstArenaExpressionPartCalls(TypedAstArenaValueText(arena, i), callee) ||
            CodegenAstArenaExpressionPartCalls(TypedAstArenaAuxValueText(arena, i), callee) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func CodegenAstArenaBuiltinGroupPresent(arena: AstArena, count: Int, group: Int) -> Bool {
    let callee_index: Int = 0;
    while callee_index < CodegenUsageBuiltinGroupCalleeCount(group) {
        let callee: String = CodegenUsageBuiltinGroupCalleeAt(group, callee_index);
        if StringLength(callee) > 0 && CodegenAstArenaBuiltinCallPresent(arena, count, callee) {
            return true;
        }
        callee_index = callee_index + 1;
    }
    return false;
}

func CodegenExpressionUsageFactsFromArena(arena: AstArena, count: Int) -> CodegenExpressionUsageFacts {
    return CodegenExpressionUsageFacts(
        CodegenAstArenaBuiltinGroupPresent(arena, count, CodegenUsageBuiltinGroupArgs()),
        CodegenAstArenaBuiltinGroupPresent(arena, count, CodegenUsageBuiltinGroupString()),
        CodegenAstArenaBuiltinGroupPresent(arena, count, CodegenUsageBuiltinGroupMath()),
        CodegenAstArenaBuiltinGroupPresent(arena, count, CodegenUsageBuiltinGroupArraySort()),
        CodegenAstArenaBuiltinGroupPresent(arena, count, CodegenUsageBuiltinGroupArrayReverse()),
        CodegenAstArenaBuiltinGroupPresent(arena, count, CodegenUsageBuiltinGroupArrayMap()),
        CodegenAstArenaBuiltinGroupPresent(arena, count, CodegenUsageBuiltinGroupArrayFilter()),
        CodegenAstArenaBuiltinGroupPresent(arena, count, CodegenUsageBuiltinGroupResult()),
        CodegenAstArenaBuiltinGroupPresent(arena, count, CodegenUsageBuiltinGroupOption()),
        CodegenAstArenaBuiltinGroupPresent(arena, count, CodegenUsageBuiltinGroupExit()),
        CodegenAstArenaBuiltinGroupPresent(arena, count, CodegenUsageBuiltinGroupArrayCore()),
        CodegenAstArenaBuiltinGroupPresent(arena, count, CodegenUsageBuiltinGroupIo()),
        CodegenAstArenaBuiltinGroupPresent(arena, count, CodegenUsageBuiltinGroupJoin()),
        CodegenAstArenaBuiltinGroupPresent(arena, count, CodegenUsageBuiltinGroupSplit()),
        CodegenAstArenaBuiltinGroupPresent(arena, count, CodegenUsageBuiltinGroupDirWalk()),
        CodegenAstArenaBuiltinGroupPresent(arena, count, CodegenUsageBuiltinGroupLog()),
        CodegenAstArenaBuiltinGroupPresent(arena, count, CodegenUsageBuiltinGroupFileHandle()),
        CodegenAstArenaBuiltinGroupPresent(arena, count, CodegenUsageBuiltinGroupPrint()),
        CodegenAstArenaBuiltinGroupPresent(arena, count, CodegenUsageBuiltinGroupFloat()),
        CodegenAstArenaBuiltinGroupPresent(arena, count, CodegenUsageBuiltinGroupRandomValue()),
        CodegenAstArenaBuiltinGroupPresent(arena, count, CodegenUsageBuiltinGroupSeedRandom()),
        CodegenAstArenaExpressionTokenPresent(arena, count, "None")
    );
}

func CodegenExpressionUsageKnownGroup(group: Int) -> Result<Int> {
    if group >= CodegenUsageBuiltinGroupArgs() && group <= CodegenUsageBuiltinGroupSeedRandom() {
        return Ok(group);
    }
    return Err("unknown expression usage builtin group");
}

func CodegenExpressionUsageGroupPresent(facts: CodegenExpressionUsageFacts, group: Int) -> Bool {
    let known: Result<Int> = CodegenExpressionUsageKnownGroup(group);
    if IsErr(known) {
        Die("unknown expression usage builtin group");
    }
    let known_group: Int = Unwrap(known);
    if known_group == CodegenUsageBuiltinGroupArgs() { return facts.has_args; }
    if known_group == CodegenUsageBuiltinGroupString() { return facts.has_string; }
    if known_group == CodegenUsageBuiltinGroupMath() { return facts.has_math; }
    if known_group == CodegenUsageBuiltinGroupArraySort() { return facts.has_array_sort; }
    if known_group == CodegenUsageBuiltinGroupArrayReverse() { return facts.has_array_reverse; }
    if known_group == CodegenUsageBuiltinGroupArrayMap() { return facts.has_array_map; }
    if known_group == CodegenUsageBuiltinGroupArrayFilter() { return facts.has_array_filter; }
    if known_group == CodegenUsageBuiltinGroupResult() { return facts.has_result; }
    if known_group == CodegenUsageBuiltinGroupOption() { return facts.has_option; }
    if known_group == CodegenUsageBuiltinGroupExit() { return facts.has_exit; }
    if known_group == CodegenUsageBuiltinGroupArrayCore() { return facts.has_array_core; }
    if known_group == CodegenUsageBuiltinGroupIo() { return facts.has_io; }
    if known_group == CodegenUsageBuiltinGroupJoin() { return facts.has_join; }
    if known_group == CodegenUsageBuiltinGroupSplit() { return facts.has_split; }
    if known_group == CodegenUsageBuiltinGroupDirWalk() { return facts.has_dirwalk; }
    if known_group == CodegenUsageBuiltinGroupLog() { return facts.has_log; }
    if known_group == CodegenUsageBuiltinGroupFileHandle() { return facts.has_file_handle; }
    if known_group == CodegenUsageBuiltinGroupPrint() { return facts.has_print; }
    if known_group == CodegenUsageBuiltinGroupFloat() { return facts.has_float; }
    if known_group == CodegenUsageBuiltinGroupRandomValue() { return facts.has_random_value; }
    if known_group == CodegenUsageBuiltinGroupSeedRandom() { return facts.has_seed_random; }
    return false;
}

func CodegenExpressionUsageHasNone(facts: CodegenExpressionUsageFacts) -> Bool {
    return facts.has_none;
}
