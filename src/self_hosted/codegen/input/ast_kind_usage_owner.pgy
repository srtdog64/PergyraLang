// Codegen kind usage fact owner.
//
// Runtime/header usage decisions need statement-shape facts. Codegen projects
// those facts from the semantic owner and never scans typed arena kind rows.

import "../../semantic/ast_kind_surface_fact_owner.pgy";

struct CodegenKindUsageFacts {
    let has_log_stmt: Bool;
    let has_exit_stmt: Bool;
    let has_array_pop: Bool;
    let has_array_push: Bool;
    let has_array_set: Bool;
}

func CodegenKindUsageFactsFromSemantic(facts: SemanticAstKindSurfaceFacts) -> CodegenKindUsageFacts {
    return CodegenKindUsageFacts(
        SemanticAstKindSurfaceContains(facts, TypedAstKindLogStmtTag()),
        SemanticAstKindSurfaceContains(facts, TypedAstKindExitStmtTag()),
        SemanticAstKindSurfaceContains(facts, TypedAstKindArrayPopStmtTag()),
        SemanticAstKindSurfaceContains(facts, TypedAstKindArrayPushStmtTag()),
        SemanticAstKindSurfaceContains(facts, TypedAstKindArraySetStmtTag())
    );
}
