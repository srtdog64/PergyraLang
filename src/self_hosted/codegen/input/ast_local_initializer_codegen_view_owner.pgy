// Transitional HIR expression-payload view for local initializers.

import "ast_arena_codegen_view_owner.pgy";

func CodegenAstArenaLetInitializerOrDie(
    arena: AstArena,
    node_id: Int
) -> String {
    if !CodegenAstArenaIsLetStmt(arena, node_id) {
        Die(Concat(
            "expected Let statement at typed AST node: ", ToString(node_id)
        ));
    }
    return CodegenAstArenaValueOrDie(arena, node_id);
}
