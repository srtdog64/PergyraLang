// Self-host codegen array literal shape over semantic initializer facts.
//
// The semantic local-binding owner carries the initializer payload. This owner
// only projects its array-literal shape for emission.

import "semantic_local_binding_codegen_view_owner.pgy";
import "../text/expr_sequence_owner.pgy";

struct CodegenLetArrayLiteralFact {
    let has_initializer: Bool;
    let initializer: String;
}

func CodegenSemanticLetArrayLiteralFactAt(
    facts: SemanticAstLocalBindingFacts,
    node_id: Int
) -> CodegenLetArrayLiteralFact {
    let index: Option<Int> = SemanticAstLocalBindingIndexForNode(
        facts, node_id
    );
    if !IsSome(index) {
        return CodegenLetArrayLiteralFact(false, "");
    }
    let initializer: Option<String> = SemanticAstLocalBindingInitializerAt(
        facts, UnwrapOption(index)
    );
    if !IsSome(initializer) {
        return CodegenLetArrayLiteralFact(false, "");
    }
    return CodegenLetArrayLiteralFact(true, UnwrapOption(initializer));
}

func CodegenLetArrayLiteralInitializerText(fact: CodegenLetArrayLiteralFact) -> Option<String> {
    if !fact.has_initializer {
        return None;
    }
    return Some(fact.initializer);
}

func CodegenSemanticLetInitializerStartsArrayLiteral(
    facts: SemanticAstLocalBindingFacts,
    node_id: Int
) -> Bool {
    let fact: CodegenLetArrayLiteralFact =
        CodegenSemanticLetArrayLiteralFactAt(facts, node_id);
    let initializer: Option<String> = CodegenLetArrayLiteralInitializerText(fact);
    if !IsSome(initializer) {
        return false;
    }
    let expr: String = StringTrim(UnwrapOption(initializer));
    return StringLength(expr) > 0 && CodegenCharAt(expr, 0) == "[";
}

func CodegenSemanticLetArrayLiteralBodyOrDie(
    facts: SemanticAstLocalBindingFacts,
    node_id: Int
) -> String {
    let fact: CodegenLetArrayLiteralFact =
        CodegenSemanticLetArrayLiteralFactAt(facts, node_id);
    let initializer: Option<String> = CodegenLetArrayLiteralInitializerText(fact);
    if !IsSome(initializer) {
        Die(Concat("expected array literal initializer at typed AST node: ", ToString(node_id)));
    }
    let expr: String = StringTrim(UnwrapOption(initializer));
    if StringLength(expr) == 0 || CodegenCharAt(expr, 0) != "[" {
        Die(Concat("expected array literal initializer at typed AST node: ", ToString(node_id)));
    }
    let n: Int = StringLength(expr);
    if n < 2 || CodegenCharAt(expr, n - 1) != "]" {
        Die(Concat("malformed array literal initializer at typed AST node: ", ToString(node_id)));
    }
    return StringTrim(Substring(expr, 1, n - 2));
}

func CodegenAstArenaArrayLiteralElementCount(body: String) -> Int {
    return ExprSequenceItemCount(body);
}

func CodegenAstArenaArrayLiteralElementAt(body: String, index: Int) -> Option<String> {
    return ExprSequenceItemAt(body, index);
}

func CodegenSemanticLetArrayLiteralElementCount(
    facts: SemanticAstLocalBindingFacts,
    node_id: Int
) -> Int {
    return CodegenAstArenaArrayLiteralElementCount(
        CodegenSemanticLetArrayLiteralBodyOrDie(facts, node_id)
    );
}

func CodegenSemanticLetArrayLiteralElementAt(
    facts: SemanticAstLocalBindingFacts,
    node_id: Int,
    index: Int
) -> Option<String> {
    return CodegenAstArenaArrayLiteralElementAt(
        CodegenSemanticLetArrayLiteralBodyOrDie(facts, node_id), index
    );
}
