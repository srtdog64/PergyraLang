// Self-host codegen AST-text assignment statement facts.
//
// Assignment lowering owns C store shape. This owner owns the assignment
// target and RHS payload facts before indexed-shape specialization runs.

import "ast_text_typed_arena_owner.pgy";

func CodegenAstArenaAssignTargetOrDie(arena: AstArena, node_id: Int) -> String {
    if !CodegenAstArenaIsAssignStmt(arena, node_id) {
        Die(Concat("expected Assign statement at typed AST node: ", ToString(node_id)));
    }
    return CodegenAstArenaAtomOrDie(arena, node_id);
}

func CodegenAstArenaAssignValueOrDie(arena: AstArena, node_id: Int) -> String {
    if !CodegenAstArenaIsAssignStmt(arena, node_id) {
        Die(Concat("expected Assign statement at typed AST node: ", ToString(node_id)));
    }
    return CodegenAstArenaValueOrDie(arena, node_id);
}
