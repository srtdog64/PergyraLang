// Self-host codegen AST-text enum variant facts.
//
// This owner keeps payload-free enum variant list splitting out of typed arena
// projection and emission participants while enum declarations still arrive as
// transitional AST-text payload rows.

import "ast_text_typed_arena_owner.pgy";
import "../text/expr_sequence_owner.pgy";
import "../text/text_owner.pgy";

struct CodegenEnumVariantPayloadFact {
    let has_payload: Bool;
    let payload: String;
}

func CodegenAstArenaEnumVariantPayloadFactAt(arena: AstArena, node_id: Int) -> CodegenEnumVariantPayloadFact {
    if !CodegenAstArenaIsEnumDecl(arena, node_id) {
        return CodegenEnumVariantPayloadFact(false, "");
    }
    let value: Option<String> = TypedAstArenaAuxValueText(arena, node_id);
    if IsSome(value) {
        return CodegenEnumVariantPayloadFact(true, UnwrapOption(value));
    }
    return CodegenEnumVariantPayloadFact(false, "");
}

func CodegenEnumVariantPayloadText(fact: CodegenEnumVariantPayloadFact) -> Option<String> {
    if !fact.has_payload {
        return None;
    }
    return Some(fact.payload);
}

func CodegenAstArenaEnumVariantPayload(arena: AstArena, node_id: Int) -> String {
    let fact: CodegenEnumVariantPayloadFact = CodegenAstArenaEnumVariantPayloadFactAt(arena, node_id);
    let payload: Option<String> = CodegenEnumVariantPayloadText(fact);
    if IsSome(payload) {
        return UnwrapOption(payload);
    }
    return "";
}

func CodegenAstArenaEnumVariantCount(arena: AstArena, node_id: Int) -> Int {
    let fact: CodegenEnumVariantPayloadFact = CodegenAstArenaEnumVariantPayloadFactAt(arena, node_id);
    let payload: Option<String> = CodegenEnumVariantPayloadText(fact);
    if !IsSome(payload) {
        return 0;
    }
    return ExprSequenceItemCount(UnwrapOption(payload));
}

func CodegenAstArenaEnumVariantNameAt(arena: AstArena, node_id: Int, index: Int) -> String {
    let fact: CodegenEnumVariantPayloadFact = CodegenAstArenaEnumVariantPayloadFactAt(arena, node_id);
    let payload: Option<String> = CodegenEnumVariantPayloadText(fact);
    if !IsSome(payload) {
        Die(Concat("enum variant index out of bounds: ", ToString(index)));
    }
    let part_opt: Option<String> = ExprSequenceItemAt(UnwrapOption(payload), index);
    if IsSome(part_opt) {
        let part: String = UnwrapOption(part_opt);
        if StringIndexOf(part, "(") >= 0 {
            Die(Concat("payload enum variants are not supported in self-host codegen subset: ", part));
        }
        return part;
    }
    Die(Concat("enum variant index out of bounds: ", ToString(index)));
    return "";
}
