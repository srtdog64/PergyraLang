// Self-host codegen AST-text for-statement facts.
//
// The typed arena already carries loop variable, iterable/range start, and
// optional range end rows. This owner keeps range-vs-foreach classification out
// of statement emission participants.

import "ast_text_typed_arena_owner.pgy";

struct CodegenForRangeEndFact {
    let has_range_end: Bool;
    let range_end: String;
}

func CodegenAstArenaForRangeEndFactAt(arena: AstArena, node_id: Int) -> CodegenForRangeEndFact {
    if !CodegenAstArenaIsForStmt(arena, node_id) {
        return CodegenForRangeEndFact(false, "");
    }
    let range_end: Option<String> = TypedAstArenaAuxValueText(arena, node_id);
    if !IsSome(range_end) {
        return CodegenForRangeEndFact(false, "");
    }
    return CodegenForRangeEndFact(true, UnwrapOption(range_end));
}

func CodegenForRangeEndText(fact: CodegenForRangeEndFact) -> Option<String> {
    if !fact.has_range_end {
        return None;
    }
    return Some(fact.range_end);
}

func CodegenAstArenaForLoopVarOrDie(arena: AstArena, node_id: Int) -> String {
    if !CodegenAstArenaIsForStmt(arena, node_id) {
        Die(Concat("expected for statement at typed AST node: ", ToString(node_id)));
    }
    return CodegenAstArenaAtomOrDie(arena, node_id);
}

func CodegenAstArenaForIsRange(arena: AstArena, node_id: Int) -> Bool {
    if !CodegenAstArenaIsForStmt(arena, node_id) {
        return false;
    }
    let fact: CodegenForRangeEndFact = CodegenAstArenaForRangeEndFactAt(arena, node_id);
    return IsSome(CodegenForRangeEndText(fact));
}

func CodegenAstArenaForRangeStartOrDie(arena: AstArena, node_id: Int) -> String {
    if !CodegenAstArenaForIsRange(arena, node_id) {
        Die(Concat("expected range for statement at typed AST node: ", ToString(node_id)));
    }
    return CodegenAstArenaValueOrDie(arena, node_id);
}

func CodegenAstArenaForRangeEndOrDie(arena: AstArena, node_id: Int) -> String {
    if !CodegenAstArenaIsForStmt(arena, node_id) {
        Die(Concat("expected for statement at typed AST node: ", ToString(node_id)));
    }
    let fact: CodegenForRangeEndFact = CodegenAstArenaForRangeEndFactAt(arena, node_id);
    let range_end: Option<String> = CodegenForRangeEndText(fact);
    if !IsSome(range_end) {
        Die(Concat("expected range end at typed AST node: ", ToString(node_id)));
    }
    return UnwrapOption(range_end);
}

func CodegenAstArenaForEachCollectionOrDie(arena: AstArena, node_id: Int) -> String {
    if !CodegenAstArenaIsForStmt(arena, node_id) || CodegenAstArenaForIsRange(arena, node_id) {
        Die(Concat("expected foreach statement at typed AST node: ", ToString(node_id)));
    }
    return CodegenAstArenaValueOrDie(arena, node_id);
}
