// src/self_hosted/codegen/input/ast_text_inventory_owner.pgy
//
// Owns the AST-text line inventory consumed by the self-host C emitter.
// This is still a text bridge, not the final tagged AST owner. The bridge now
// carries a typed node record so downstream owners can migrate one consumer at a
// time instead of re-pairing parallel text/indent arrays.

import "../text/text_owner.pgy";

struct CodegenAstTextNode {
    let indent: Int;
    let text: String;
    let parent: Int;
    let kind: Int;
}

func CodegenAstTextKindOf(text: String) -> Int {
    if text == "Parameters:" {
        return 2;
    }
    if StartsWith(text, "Returns:") {
        return 3;
    }
    if text == "Fields:" {
        return 4;
    }
    if StartsWith(text, "Field:") {
        return 5;
    }
    if StartsWith(text, "Function:") {
        return 6;
    }
    if StartsWith(text, "Role:") {
        return 7;
    }
    if StartsWith(text, "Struct:") || StartsWith(text, "Class:") || StartsWith(text, "Subject:") ||
        StartsWith(text, "Object:") || StartsWith(text, "TObject:") ||
        StartsWith(text, "Vessel:") {
        return 8;
    }
    if StartsWith(text, "Enum:") {
        return 9;
    }
    if StartsWith(text, "Event:") {
        return 10;
    }
    if StartsWith(text, "Ability:") {
        return 11;
    }
    return 1;
}

func CodegenAstTextIsFunction(node: CodegenAstTextNode) -> Bool {
    return node.kind == 6;
}

func CodegenAstTextIsMainFunction(node: CodegenAstTextNode) -> Bool {
    return CodegenAstTextIsFunction(node) && node.text == "Function: Main";
}

func CodegenAstTextIsRoleDecl(node: CodegenAstTextNode) -> Bool {
    return node.kind == 7;
}

func CodegenAstTextIsNominalDecl(node: CodegenAstTextNode) -> Bool {
    return node.kind == 8;
}

func CodegenAstTextIsEnumDecl(node: CodegenAstTextNode) -> Bool {
    return node.kind == 9;
}

func CodegenAstTextIsEventDecl(node: CodegenAstTextNode) -> Bool {
    return node.kind == 10;
}

func CodegenAstTextIsZeroArtifactDecl(node: CodegenAstTextNode) -> Bool {
    return node.kind == 11;
}

func CodegenAstTextPayloadAfter(node: CodegenAstTextNode, prefix: String, label: String) -> String {
    if !StartsWith(node.text, prefix) {
        Die(Concat("expected ", Concat(label, Concat(" AST line: ", node.text))));
    }
    let prefix_len: Int = StringLength(prefix);
    return Substring(node.text, prefix_len, StringLength(node.text) - prefix_len);
}

func CodegenAstTextFunctionName(node: CodegenAstTextNode) -> String {
    return CodegenAstTextPayloadAfter(node, "Function: ", "function");
}

func CodegenAstTextReturnType(node: CodegenAstTextNode) -> String {
    return StringTrim(CodegenAstTextPayloadAfter(node, "Returns:", "return type"));
}

func CodegenAstTextNominalPrefixLen(node: CodegenAstTextNode) -> Int {
    if StartsWith(node.text, "Struct: ") {
        return 8;
    }
    if StartsWith(node.text, "Class: ") {
        return 7;
    }
    if StartsWith(node.text, "Subject: ") {
        return 9;
    }
    if StartsWith(node.text, "Vessel: ") {
        return 8;
    }
    if StartsWith(node.text, "Object: ") {
        return 8;
    }
    if StartsWith(node.text, "TObject: ") {
        return 9;
    }
    Die(Concat("expected nominal declaration AST line: ", node.text));
    return -1;
}

func CodegenAstTextNominalName(node: CodegenAstTextNode) -> String {
    let prefix_len: Int = CodegenAstTextNominalPrefixLen(node);
    return Substring(node.text, prefix_len, StringLength(node.text) - prefix_len);
}

func CodegenAstTextRoleForPos(node: CodegenAstTextNode) -> Int {
    let pos: Int = StringIndexOf(node.text, " for ");
    if pos < 0 {
        Die(Concat("malformed role declaration AST line: ", node.text));
    }
    return pos;
}

func CodegenAstTextRoleName(node: CodegenAstTextNode) -> String {
    let fp: Int = CodegenAstTextRoleForPos(node);
    return Substring(node.text, 6, fp - 6);
}

func CodegenAstTextRoleForType(node: CodegenAstTextNode) -> String {
    let fp: Int = CodegenAstTextRoleForPos(node);
    return Substring(node.text, fp + 5, StringLength(node.text) - (fp + 5));
}

func CodegenAstTextParamMode(node: CodegenAstTextNode) -> Int {
    if StartsWith(node.text, "inout ") {
        return 1;
    }
    if StartsWith(node.text, "own ") {
        return 2;
    }
    if StartsWith(node.text, "ref ") {
        return 3;
    }
    return 0;
}

func CodegenAstTextParamModeName(mode: Int) -> String {
    if mode == 1 {
        return "inout";
    }
    if mode == 2 {
        return "own";
    }
    if mode == 3 {
        return "ref";
    }
    return "default";
}

func CodegenAstTextParamPayload(node: CodegenAstTextNode, mode: Int) -> String {
    if mode == 0 {
        return node.text;
    }
    let prefix_len: Int = 4;
    if mode == 1 {
        prefix_len = 6;
    }
    return Substring(node.text, prefix_len, StringLength(node.text) - prefix_len);
}

func CodegenAstTextParamName(node: CodegenAstTextNode, owner_name: String) -> String {
    let mode: Int = CodegenAstTextParamMode(node);
    let payload: String = CodegenAstTextParamPayload(node, mode);
    let colon: Int = StringIndexOf(payload, ": ");
    if colon < 0 && StringLength(owner_name) > 0 && payload == "self" {
        return "self";
    }
    if colon < 0 {
        Die(Concat("malformed parameter AST line: ", node.text));
    }
    return Substring(payload, 0, colon);
}

func CodegenAstTextParamType(node: CodegenAstTextNode, owner_name: String) -> String {
    let mode: Int = CodegenAstTextParamMode(node);
    let payload: String = CodegenAstTextParamPayload(node, mode);
    let colon: Int = StringIndexOf(payload, ": ");
    if colon < 0 && StringLength(owner_name) > 0 && payload == "self" {
        return owner_name;
    }
    if colon < 0 {
        Die(Concat("malformed parameter AST line: ", node.text));
    }
    return Substring(payload, colon + 2, StringLength(payload) - (colon + 2));
}

func CodegenAstTextFieldName(node: CodegenAstTextNode) -> String {
    let colon: Int = StringIndexOf(node.text, ": ");
    if colon < 0 {
        Die(Concat("malformed field AST line: ", node.text));
    }
    return Substring(node.text, 0, colon);
}

func CodegenAstTextFieldType(node: CodegenAstTextNode) -> String {
    let colon: Int = StringIndexOf(node.text, ": ");
    if colon < 0 {
        Die(Concat("malformed field AST line: ", node.text));
    }
    return Substring(node.text, colon + 2, StringLength(node.text) - (colon + 2));
}

func CodegenAstTextParentIndex(nodes: Array<CodegenAstTextNode>, count: Int, indent: Int) -> Int {
    let back: Int = count - 1;
    while back >= 0 {
        if nodes[back].indent < indent {
            return back;
        }
        back = back - 1;
    }
    return -1;
}

func CodegenAstTextIndentOf(raw: String) -> Int {
    let n: Int = StringLength(raw);
    let i: Int = 0;
    while i < n && CharAt(raw, i) == " " {
        i = i + 1;
    }
    return i;
}

func CodegenAstTextNodeInventory(ast: String, inout nodes: Array<CodegenAstTextNode>, inout count_box: Array<Int>) -> Void {
    let total: Int = StringLength(ast);
    let pos: Int = 0;
    while pos < total {
        let nl: Int = NextNewline(ast, pos);
        let raw_line: String = Substring(ast, pos, nl - pos);
        let trimmed: String = StringTrim(raw_line);
        // Namespace/import functions are flattened to top-level exported
        // function lines by the current parser bridge.
        if StartsWith(trimmed, "[export] ") {
            trimmed = Substring(trimmed, 9, StringLength(trimmed) - 9);
        }
        if StringLength(trimmed) > 0 {
            let indent: Int = CodegenAstTextIndentOf(raw_line);
            let parent: Int = CodegenAstTextParentIndex(nodes, count_box[0], indent);
            ArrayPush(nodes, CodegenAstTextNode(indent, trimmed, parent, CodegenAstTextKindOf(trimmed)));
            ArraySet(count_box, 0, count_box[0] + 1);
        }
        pos = nl + 1;
    }
}

func CodegenAstTextExpectNode(nodes: Array<CodegenAstTextNode>, count: Int, inout cur: Array<Int>, expected: String) -> Void {
    if cur[0] >= count {
        Die(Concat("expected `", Concat(expected, "` but reached end of AST")));
    }
    if nodes[cur[0]].text != expected {
        Die(Concat("expected `", Concat(expected, Concat("` but got: ", nodes[cur[0]].text))));
    }
    ArraySet(cur, 0, cur[0] + 1);
}
