// src/self_hosted/codegen/input/ast_text_inventory_owner.pgy
//
// Owns the AST-text line inventory consumed by the self-host C emitter.
// This is still a text bridge, not the final tagged AST owner. The bridge now
// carries a typed node record so downstream owners can migrate one consumer at a
// time instead of re-pairing parallel text/indent arrays.

import "../text/text_owner.pgy";

struct CodegenAstTextNode {
    let indent: Int;
    let text: String;
    let parent: Int;
    let kind: Int;
}

func CodegenAstTextKindOf(text: String) -> Int {
    if text == "Parameters:" {
        return 2;
    }
    if StartsWith(text, "Returns:") {
        return 3;
    }
    if text == "Fields:" {
        return 4;
    }
    if StartsWith(text, "Field:") {
        return 5;
    }
    if StartsWith(text, "Function:") {
        return 6;
    }
    if StartsWith(text, "Role:") {
        return 7;
    }
    if StartsWith(text, "Struct:") || StartsWith(text, "Class:") || StartsWith(text, "Subject:") ||
        StartsWith(text, "Object:") || StartsWith(text, "TObject:") ||
        StartsWith(text, "Vessel:") {
        return 8;
    }
    if StartsWith(text, "Enum:") {
        return 9;
    }
    if StartsWith(text, "Event:") {
        return 10;
    }
    if StartsWith(text, "Ability:") {
        return 11;
    }
    return 1;
}

func CodegenAstTextIsFunction(node: CodegenAstTextNode) -> Bool {
    return node.kind == 6;
}

func CodegenAstTextIsMainFunction(node: CodegenAstTextNode) -> Bool {
    return CodegenAstTextIsFunction(node) && node.text == "Function: Main";
}

func CodegenAstTextIsRoleDecl(node: CodegenAstTextNode) -> Bool {
    return node.kind == 7;
}

func CodegenAstTextIsNominalDecl(node: CodegenAstTextNode) -> Bool {
    return node.kind == 8;
}

func CodegenAstTextIsEnumDecl(node: CodegenAstTextNode) -> Bool {
    return node.kind == 9;
}

func CodegenAstTextIsEventDecl(node: CodegenAstTextNode) -> Bool {
    return node.kind == 10;
}

func CodegenAstTextIsZeroArtifactDecl(node: CodegenAstTextNode) -> Bool {
    return node.kind == 11;
}

func CodegenAstTextParentIndex(nodes: Array<CodegenAstTextNode>, count: Int, indent: Int) -> Int {
    let back: Int = count - 1;
    while back >= 0 {
        if nodes[back].indent < indent {
            return back;
        }
        back = back - 1;
    }
    return -1;
}

func CodegenAstTextIndentOf(raw: String) -> Int {
    let n: Int = StringLength(raw);
    let i: Int = 0;
    while i < n && CharAt(raw, i) == " " {
        i = i + 1;
    }
    return i;
}

func CodegenAstTextNodeInventory(ast: String, inout nodes: Array<CodegenAstTextNode>, inout count_box: Array<Int>) -> Void {
    let total: Int = StringLength(ast);
    let pos: Int = 0;
    while pos < total {
        let nl: Int = NextNewline(ast, pos);
        let raw_line: String = Substring(ast, pos, nl - pos);
        let trimmed: String = StringTrim(raw_line);
        // Namespace/import functions are flattened to top-level exported
        // function lines by the current parser bridge.
        if StartsWith(trimmed, "[export] ") {
            trimmed = Substring(trimmed, 9, StringLength(trimmed) - 9);
        }
        if StringLength(trimmed) > 0 {
            let indent: Int = CodegenAstTextIndentOf(raw_line);
            let parent: Int = CodegenAstTextParentIndex(nodes, count_box[0], indent);
            ArrayPush(nodes, CodegenAstTextNode(indent, trimmed, parent, CodegenAstTextKindOf(trimmed)));
            ArraySet(count_box, 0, count_box[0] + 1);
        }
        pos = nl + 1;
    }
}

func CodegenAstTextExpectNode(nodes: Array<CodegenAstTextNode>, count: Int, inout cur: Array<Int>, expected: String) -> Void {
    if cur[0] >= count {
        Die(Concat("expected `", Concat(expected, "` but reached end of AST")));
    }
    if nodes[cur[0]].text != expected {
        Die(Concat("expected `", Concat(expected, Concat("` but got: ", nodes[cur[0]].text))));
    }
    ArraySet(cur, 0, cur[0] + 1);
}
