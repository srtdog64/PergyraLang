// src/self_hosted/codegen/input/ast_text_inventory_owner.pgy
//
// Owns the AST-text line inventory consumed by the self-host C emitter.
// This is still a text bridge, not the final tagged AST owner. The bridge now
// carries a typed node record so downstream owners can migrate one consumer at a
// time instead of re-pairing parallel text/indent arrays.

import "../text/text_owner.pgy";
import "../typed_ast_node_skeleton.pgy";
import "ast_text_row_fact_owner.pgy";

struct CodegenAstTextNode {
    let indent: Int;
    let text: String;
    let kind: Int;
    let payload: String;
    let aux_payload: String;
    let name: String;
    let type_name: String;
    let mode: Int;
}

func CodegenAstTextKindOf(text: String) -> Int {
    if text == "Program:" {
        return 30;
    }
    if text == "Parameters:" {
        return 2;
    }
    if text == "Body:" {
        return 31;
    }
    if text == "Block:" {
        return 32;
    }
    if text == "Then:" {
        return 33;
    }
    if StartsWith(text, "Returns:") {
        return 3;
    }
    if text == "Fields:" {
        return 4;
    }
    if StartsWith(text, "Field:") {
        return 5;
    }
    if StartsWith(text, "Function:") {
        return 6;
    }
    if StartsWith(text, "Role:") {
        return 7;
    }
    if StartsWith(text, "Struct:") || StartsWith(text, "Class:") || StartsWith(text, "Subject:") ||
        StartsWith(text, "Object:") || StartsWith(text, "TObject:") ||
        StartsWith(text, "Vessel:") {
        return 8;
    }
    if StartsWith(text, "Enum:") {
        return 9;
    }
    if StartsWith(text, "Event:") {
        return 10;
    }
    if StartsWith(text, "Ability:") {
        return 11;
    }
    if StartsWith(text, "Log(") {
        return 13;
    }
    if text == "Return" {
        return 14;
    }
    if StartsWith(text, "Return:") {
        return 15;
    }
    if StartsWith(text, "ArrayPop(") {
        return 16;
    }
    if StartsWith(text, "Exit(") {
        return 17;
    }
    if StartsWith(text, "ArraySet(") {
        return 18;
    }
    if StartsWith(text, "ArrayPush(") {
        return 19;
    }
    if StartsWith(text, "Let: ") {
        return 20;
    }
    if StartsWith(text, "Assign: ") {
        return 21;
    }
    if StartsWith(text, "For: ") {
        return 22;
    }
    if StartsWith(text, "While: ") {
        return 23;
    }
    if StartsWith(text, "If: ") {
        return 24;
    }
    if text == "Else:" {
        return 25;
    }
    if StartsWith(text, "Match: ") {
        return 34;
    }
    if StartsWith(text, "Case: ") {
        return 35;
    }
    if text == "Default:" {
        return 36;
    }
    if text == "Defer:" {
        return 26;
    }
    if text == "Break" {
        return 27;
    }
    if text == "Continue" {
        return 28;
    }
    if IsSingleCall(text) {
        return 29;
    }
    return 1;
}

func CodegenAstTextPayloadFor(text: String, kind: Int) -> String {
    if kind == 6 {
        return Substring(text, 10, StringLength(text) - 10);
    }
    if kind == 3 {
        return StringTrim(Substring(text, 8, StringLength(text) - 8));
    }
    if kind == 5 {
        if StartsWith(text, "Field: ") {
            return Substring(text, 7, StringLength(text) - 7);
        }
        return text;
    }
    if kind == 12 {
        return text;
    }
    if kind == 7 {
        return Substring(text, 6, StringLength(text) - 6);
    }
    if kind == 8 {
        if StartsWith(text, "Struct: ") {
            return Substring(text, 8, StringLength(text) - 8);
        }
        if StartsWith(text, "Class: ") {
            return Substring(text, 7, StringLength(text) - 7);
        }
        if StartsWith(text, "Subject: ") {
            return Substring(text, 9, StringLength(text) - 9);
        }
        if StartsWith(text, "Vessel: ") {
            return Substring(text, 8, StringLength(text) - 8);
        }
        if StartsWith(text, "Object: ") {
            return Substring(text, 8, StringLength(text) - 8);
        }
        if StartsWith(text, "TObject: ") {
            return Substring(text, 9, StringLength(text) - 9);
        }
    }
    if kind == 9 {
        let brace: Int = StringIndexOf(text, " { ");
        if brace >= 0 {
            return Substring(text, 6, brace - 6);
        }
    }
    if kind == 13 {
        if CodegenCharAt(text, StringLength(text) - 1) == ")" {
            return StringTrim(Substring(text, 4, StringLength(text) - 5));
        }
    }
    if kind == 15 {
        return StringTrim(Substring(text, 7, StringLength(text) - 7));
    }
    if kind == 16 {
        if CodegenCharAt(text, StringLength(text) - 1) == ")" {
            return StringTrim(Substring(text, 9, StringLength(text) - 10));
        }
    }
    if kind == 17 {
        if CodegenCharAt(text, StringLength(text) - 1) == ")" {
            return StringTrim(Substring(text, 5, StringLength(text) - 6));
        }
    }
    if kind == 18 {
        if CodegenCharAt(text, StringLength(text) - 1) == ")" {
            return Substring(text, 9, StringLength(text) - 10);
        }
    }
    if kind == 19 {
        if CodegenCharAt(text, StringLength(text) - 1) == ")" {
            return Substring(text, 10, StringLength(text) - 11);
        }
    }
    if kind == 20 {
        return Substring(text, 5, StringLength(text) - 5);
    }
    if kind == 21 {
        return Substring(text, 8, StringLength(text) - 8);
    }
    if kind == 22 {
        return Substring(text, 5, StringLength(text) - 5);
    }
    if kind == 23 {
        return Substring(text, 7, StringLength(text) - 7);
    }
    if kind == 24 {
        return Substring(text, 4, StringLength(text) - 4);
    }
    if kind == 34 {
        return Substring(text, 7, StringLength(text) - 7);
    }
    if kind == 35 {
        return Substring(text, 6, StringLength(text) - 6);
    }
    if kind == 29 {
        return text;
    }
    return "";
}

func CodegenAstTextAuxPayloadFor(text: String, kind: Int) -> String {
    if kind == 9 {
        let brace: Int = StringIndexOf(text, " { ");
        if brace >= 0 && CodegenCharAt(text, StringLength(text) - 1) == "}" {
            return StringTrim(Substring(text, brace + 3, StringLength(text) - (brace + 4)));
        }
    }
    return "";
}

func CodegenAstTextIsFunction(node: CodegenAstTextNode) -> Bool {
    return node.kind == 6;
}

func CodegenAstTextIsParameters(node: CodegenAstTextNode) -> Bool {
    return node.kind == 2;
}

func CodegenAstTextIsProgramRoot(node: CodegenAstTextNode) -> Bool {
    return node.kind == 30;
}

func CodegenAstTextIsParameterRow(node: CodegenAstTextNode) -> Bool {
    return node.kind == 12;
}

func CodegenAstTextIsReturns(node: CodegenAstTextNode) -> Bool {
    return node.kind == 3;
}

func CodegenAstTextIsFieldsHeader(node: CodegenAstTextNode) -> Bool {
    return node.kind == 4;
}

func CodegenAstTextIsMainFunction(node: CodegenAstTextNode) -> Bool {
    return CodegenAstTextIsFunction(node) && node.name == "Main";
}

func CodegenAstTextIsRoleDecl(node: CodegenAstTextNode) -> Bool {
    return node.kind == 7;
}

func CodegenAstTextIsNominalDecl(node: CodegenAstTextNode) -> Bool {
    return node.kind == 8;
}

func CodegenAstTextIsEnumDecl(node: CodegenAstTextNode) -> Bool {
    return node.kind == 9;
}

func CodegenAstTextIsEventDecl(node: CodegenAstTextNode) -> Bool {
    return node.kind == 10;
}

func CodegenAstTextProvenance(node: CodegenAstTextNode) -> String {
    let provenance: String = node.text;
    return provenance;
}

func CodegenAstTextIsZeroArtifactDecl(node: CodegenAstTextNode) -> Bool {
    return node.kind == 11;
}

func CodegenAstTextFunctionName(node: CodegenAstTextNode) -> String {
    if !CodegenAstTextIsFunction(node) || node.name == "" {
        Die(Concat("expected function AST line: ", node.text));
    }
    return node.name;
}

func CodegenAstTextReturnType(node: CodegenAstTextNode) -> String {
    if !CodegenAstTextIsReturns(node) || node.type_name == "" {
        Die(Concat("expected return type AST line: ", node.text));
    }
    return node.type_name;
}

func CodegenAstTextEnumName(node: CodegenAstTextNode) -> String {
    if !CodegenAstTextIsEnumDecl(node) || node.name == "" {
        Die(Concat("expected enum declaration AST line: ", node.text));
    }
    return node.name;
}

func CodegenAstTextEnumVariantPayload(node: CodegenAstTextNode) -> String {
    if !CodegenAstTextIsEnumDecl(node) {
        Die(Concat("expected enum declaration AST line: ", node.text));
    }
    return node.aux_payload;
}

func CodegenAstTextEnumVariantCount(node: CodegenAstTextNode) -> Int {
    let rem: String = CodegenAstTextEnumVariantPayload(node);
    let count: Int = 0;
    while StringLength(rem) > 0 {
        let comma_opt: Option<Int> = FindTopLevelComma(rem);
        let part: String = "";
        if !IsSome(comma_opt) {
            part = StringTrim(rem);
            rem = "";
        } else {
            let comma: Int = UnwrapOption(comma_opt);
            part = StringTrim(Substring(rem, 0, comma));
            rem = StringTrim(Substring(rem, comma + 1, StringLength(rem) - (comma + 1)));
        }
        if StringLength(part) > 0 {
            count = count + 1;
        }
    }
    return count;
}

func CodegenAstTextEnumVariantNameAt(node: CodegenAstTextNode, index: Int) -> String {
    let rem: String = CodegenAstTextEnumVariantPayload(node);
    let cur: Int = 0;
    while StringLength(rem) > 0 {
        let comma_opt: Option<Int> = FindTopLevelComma(rem);
        let part: String = "";
        if !IsSome(comma_opt) {
            part = StringTrim(rem);
            rem = "";
        } else {
            let comma: Int = UnwrapOption(comma_opt);
            part = StringTrim(Substring(rem, 0, comma));
            rem = StringTrim(Substring(rem, comma + 1, StringLength(rem) - (comma + 1)));
        }
        if StringLength(part) > 0 {
            if cur == index {
                if StringIndexOf(part, "(") >= 0 {
                    Die(Concat("payload enum variants are not supported in self-host codegen subset: ", part));
                }
                return part;
            }
            cur = cur + 1;
        }
    }
    Die(Concat("enum variant index out of bounds: ", ToString(index)));
    return "";
}

func CodegenAstTextNominalName(node: CodegenAstTextNode) -> String {
    if !CodegenAstTextIsNominalDecl(node) || node.name == "" {
        Die(Concat("expected nominal declaration AST line: ", node.text));
    }
    return node.name;
}

func CodegenAstTextRoleName(node: CodegenAstTextNode) -> String {
    if !CodegenAstTextIsRoleDecl(node) || node.name == "" {
        Die(Concat("expected role declaration AST line: ", node.text));
    }
    return node.name;
}

func CodegenAstTextRoleForType(node: CodegenAstTextNode) -> String {
    if !CodegenAstTextIsRoleDecl(node) || node.type_name == "" {
        Die(Concat("malformed role declaration AST line: ", node.text));
    }
    return node.type_name;
}

func CodegenAstTextParamMode(node: CodegenAstTextNode) -> Int {
    if !CodegenAstTextIsParameterRow(node) || node.payload == "" {
        Die(Concat("expected parameter AST line: ", node.text));
    }
    return node.mode;
}

func CodegenAstTextParamModeName(mode: Int) -> String {
    if mode == 1 {
        return "inout";
    }
    if mode == 2 {
        return "own";
    }
    if mode == 3 {
        return "ref";
    }
    return "default";
}

func CodegenAstTextParamName(node: CodegenAstTextNode, owner_name: String) -> String {
    if !CodegenAstTextIsParameterRow(node) || node.name == "" {
        Die(Concat("malformed parameter AST line: ", node.text));
    }
    return node.name;
}

func CodegenAstTextParamType(node: CodegenAstTextNode, owner_name: String) -> String {
    if CodegenAstTextIsParameterRow(node) && node.name == "self" && node.type_name == "" && StringLength(owner_name) > 0 {
        return owner_name;
    }
    if !CodegenAstTextIsParameterRow(node) || node.type_name == "" {
        Die(Concat("malformed parameter AST line: ", node.text));
    }
    return node.type_name;
}

func CodegenAstTextFieldName(node: CodegenAstTextNode) -> String {
    if node.kind != 5 || node.name == "" {
        Die(Concat("expected field AST line: ", node.text));
    }
    return node.name;
}

func CodegenAstTextFieldType(node: CodegenAstTextNode) -> String {
    if node.kind != 5 || node.type_name == "" {
        Die(Concat("expected field AST line: ", node.text));
    }
    return node.type_name;
}

func CodegenAstTextIndentOf(raw: String) -> Int {
    let n: Int = StringLength(raw);
    let i: Int = 0;
    while i < n && CodegenCharAt(raw, i) == " " {
        i = i + 1;
    }
    return i;
}

func CodegenAstTextNodeInventory(tree_text: String, inout nodes: Array<CodegenAstTextNode>, inout count_box: Array<Int>) -> Void {
    let total: Int = StringLength(tree_text);
    let pos: Int = 0;
    let param_indent: Int = -1;
    let field_indent: Int = -1;
    while pos < total {
        let nl: Int = NextNewline(tree_text, pos);
        let raw_line: String = Substring(tree_text, pos, nl - pos);
        let trimmed: String = StringTrim(raw_line);
        // Namespace/import functions are flattened to top-level exported
        // function lines by the current parser bridge.
        if StartsWith(trimmed, "[export] ") {
            trimmed = Substring(trimmed, 9, StringLength(trimmed) - 9);
        }
        if StringLength(trimmed) > 0 {
            let indent: Int = CodegenAstTextIndentOf(raw_line);
            let kind: Int = CodegenAstTextKindOf(trimmed);
            if param_indent >= 0 && indent < param_indent {
                param_indent = -1;
            }
            if field_indent >= 0 && indent < field_indent {
                field_indent = -1;
            }
            if kind == 2 {
                param_indent = indent + 2;
                field_indent = -1;
            } else if kind == 4 {
                field_indent = indent + 2;
                param_indent = -1;
            } else if param_indent >= 0 && indent == param_indent &&
                (StringIndexOf(trimmed, ": ") >= 0 || trimmed == "self") {
                kind = 12;
            } else if field_indent >= 0 && indent == field_indent && StringIndexOf(trimmed, ": ") >= 0 {
                kind = 5;
            }
            let payload: String = CodegenAstTextPayloadFor(trimmed, kind);
            let mode: Int = CodegenAstTextParamModeForPayload(kind, payload);
            let row_input: CodegenAstTextRowFactInput = CodegenAstTextRowFactInput(kind, payload, mode);
            ArrayPush(nodes, CodegenAstTextNode(
                indent,
                trimmed,
                kind,
                payload,
                CodegenAstTextAuxPayloadFor(trimmed, kind),
                CodegenAstTextNameFactFor(row_input),
                CodegenAstTextTypeNameFactFor(row_input),
                mode
            ));
            ArraySet(count_box, 0, count_box[0] + 1);
        }
        pos = nl + 1;
    }
}

func CodegenTypedAstBridgeReady(nodes: Array<CodegenAstTextNode>, count: Int) -> Bool {
    if !TypedAstArenaPayloadContractReady() {
        return false;
    }
    if count <= 0 {
        return false;
    }
    if !CodegenAstTextIsProgramRoot(nodes[0]) {
        return false;
    }
    return true;
}

func CodegenAstTextExpectNode(nodes: Array<CodegenAstTextNode>, count: Int, inout cur: Array<Int>, expected: String) -> Void {
    if cur[0] >= count {
        Die(Concat("expected `", Concat(expected, "` but reached end of AST")));
    }
    let expected_kind: Int = CodegenAstTextKindOf(expected);
    if expected_kind == 1 {
        Die(Concat("unsupported expected AST marker: ", expected));
    }
    if nodes[cur[0]].kind != expected_kind {
        Die(Concat("expected `", Concat(expected, Concat("` but got: ", CodegenAstTextProvenance(nodes[cur[0]])))));
    }
    ArraySet(cur, 0, cur[0] + 1);
}
