// src/self_hosted/codegen/input/ast_text_inventory_owner.pgy
//
// Owns the AST-text line inventory consumed by the self-host C emitter.
// This is still a text bridge, not the final tagged AST owner. The bridge now
// carries a typed node record so downstream owners can migrate one consumer at a
// time instead of re-pairing parallel text/indent arrays.

import "../text/text_owner.pgy";

struct CodegenAstTextNode {
    let indent: Int;
    let text: String;
}

func CodegenAstTextIndentOf(raw: String) -> Int {
    let n: Int = StringLength(raw);
    let i: Int = 0;
    while i < n && CharAt(raw, i) == " " {
        i = i + 1;
    }
    return i;
}

func CodegenAstTextNodeInventory(ast: String, inout nodes: Array<CodegenAstTextNode>, inout count_box: Array<Int>) -> Void {
    let total: Int = StringLength(ast);
    let pos: Int = 0;
    while pos < total {
        let nl: Int = NextNewline(ast, pos);
        let raw_line: String = Substring(ast, pos, nl - pos);
        let trimmed: String = StringTrim(raw_line);
        // Namespace/import functions are flattened to top-level exported
        // function lines by the current parser bridge.
        if StartsWith(trimmed, "[export] ") {
            trimmed = Substring(trimmed, 9, StringLength(trimmed) - 9);
        }
        if StringLength(trimmed) > 0 {
            ArrayPush(nodes, CodegenAstTextNode(CodegenAstTextIndentOf(raw_line), trimmed));
            ArraySet(count_box, 0, count_box[0] + 1);
        }
        pos = nl + 1;
    }
}

func CodegenAstTextExpectNode(nodes: Array<CodegenAstTextNode>, count: Int, inout cur: Array<Int>, expected: String) -> Void {
    if cur[0] >= count {
        Die(Concat("expected `", Concat(expected, "` but reached end of AST")));
    }
    if nodes[cur[0]].text != expected {
        Die(Concat("expected `", Concat(expected, Concat("` but got: ", nodes[cur[0]].text))));
    }
    ArraySet(cur, 0, cur[0] + 1);
}
