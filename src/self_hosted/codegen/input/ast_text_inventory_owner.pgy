// src/self_hosted/codegen/input/ast_text_inventory_owner.pgy
//
// Owns the AST-text line inventory consumed by the self-host C emitter.
// This is still a text bridge, not the final tagged AST owner. The bridge now
// carries a typed node record so downstream owners can migrate one consumer at a
// time instead of re-pairing parallel text/indent arrays.

import "../text/text_owner.pgy";

struct CodegenAstTextNode {
    let indent: Int;
    let text: String;
    let parent: Int;
    let kind: Int;
}

func CodegenAstTextKindOf(text: String) -> Int {
    if text == "Parameters:" {
        return 2;
    }
    if StartsWith(text, "Returns:") {
        return 3;
    }
    if text == "Fields:" {
        return 4;
    }
    if StartsWith(text, "Field:") {
        return 5;
    }
    if StartsWith(text, "Function:") {
        return 6;
    }
    if StartsWith(text, "Role:") {
        return 7;
    }
    if StartsWith(text, "Struct:") || StartsWith(text, "Class:") || StartsWith(text, "Subject:") ||
        StartsWith(text, "Object:") || StartsWith(text, "TObject:") ||
        StartsWith(text, "Vessel:") {
        return 8;
    }
    if StartsWith(text, "Enum:") {
        return 9;
    }
    if StartsWith(text, "Event:") {
        return 10;
    }
    if StartsWith(text, "Ability:") {
        return 11;
    }
    return 1;
}

func CodegenAstTextIsFunction(node: CodegenAstTextNode) -> Bool {
    return node.kind == 6;
}

func CodegenAstTextIsLetStmt(node: CodegenAstTextNode) -> Bool {
    return StartsWith(node.text, "Let: ");
}

func CodegenAstTextIsAssignStmt(node: CodegenAstTextNode) -> Bool {
    return StartsWith(node.text, "Assign: ");
}

func CodegenAstTextIsLogStmt(node: CodegenAstTextNode) -> Bool {
    return StartsWith(node.text, "Log(");
}

func CodegenAstTextIsBareReturnStmt(node: CodegenAstTextNode) -> Bool {
    return node.text == "Return";
}

func CodegenAstTextIsValueReturnStmt(node: CodegenAstTextNode) -> Bool {
    return StartsWith(node.text, "Return:");
}

func CodegenAstTextIsDeferStmt(node: CodegenAstTextNode) -> Bool {
    return node.text == "Defer:";
}

func CodegenAstTextIsArrayPopStmt(node: CodegenAstTextNode) -> Bool {
    return StartsWith(node.text, "ArrayPop(");
}

func CodegenAstTextIsArraySetStmt(node: CodegenAstTextNode) -> Bool {
    return StartsWith(node.text, "ArraySet(");
}

func CodegenAstTextIsArrayPushStmt(node: CodegenAstTextNode) -> Bool {
    return StartsWith(node.text, "ArrayPush(");
}

func CodegenAstTextIsExitStmt(node: CodegenAstTextNode) -> Bool {
    return StartsWith(node.text, "Exit(");
}

func CodegenAstTextIsBreakStmt(node: CodegenAstTextNode) -> Bool {
    return node.text == "Break";
}

func CodegenAstTextIsContinueStmt(node: CodegenAstTextNode) -> Bool {
    return node.text == "Continue";
}

func CodegenAstTextIsParameters(node: CodegenAstTextNode) -> Bool {
    return node.kind == 2;
}

func CodegenAstTextIsReturns(node: CodegenAstTextNode) -> Bool {
    return node.kind == 3;
}

func CodegenAstTextIsFieldsHeader(node: CodegenAstTextNode) -> Bool {
    return node.kind == 4;
}

func CodegenAstTextIsMainFunction(node: CodegenAstTextNode) -> Bool {
    return CodegenAstTextIsFunction(node) && node.text == "Function: Main";
}

func CodegenAstTextIsRoleDecl(node: CodegenAstTextNode) -> Bool {
    return node.kind == 7;
}

func CodegenAstTextIsNominalDecl(node: CodegenAstTextNode) -> Bool {
    return node.kind == 8;
}

func CodegenAstTextIsEnumDecl(node: CodegenAstTextNode) -> Bool {
    return node.kind == 9;
}

func CodegenAstTextIsEventDecl(node: CodegenAstTextNode) -> Bool {
    return node.kind == 10;
}

func CodegenAstTextIsZeroArtifactDecl(node: CodegenAstTextNode) -> Bool {
    return node.kind == 11;
}

func CodegenAstTextPayloadAfter(node: CodegenAstTextNode, prefix: String, label: String) -> String {
    if !StartsWith(node.text, prefix) {
        Die(Concat("expected ", Concat(label, Concat(" AST line: ", node.text))));
    }
    let prefix_len: Int = StringLength(prefix);
    return Substring(node.text, prefix_len, StringLength(node.text) - prefix_len);
}

func CodegenAstTextFunctionName(node: CodegenAstTextNode) -> String {
    return CodegenAstTextPayloadAfter(node, "Function: ", "function");
}

func CodegenAstTextReturnType(node: CodegenAstTextNode) -> String {
    return StringTrim(CodegenAstTextPayloadAfter(node, "Returns:", "return type"));
}

func CodegenAstTextLetPayload(node: CodegenAstTextNode) -> String {
    return CodegenAstTextPayloadAfter(node, "Let: ", "let statement");
}

func CodegenAstTextLetNameEnd(node: CodegenAstTextNode) -> Int {
    let rest: String = CodegenAstTextLetPayload(node);
    let pos: Int = StringIndexOf(rest, " : ");
    if pos < 0 {
        Die(Concat("malformed Let statement (no type separator): ", node.text));
    }
    return pos;
}

func CodegenAstTextLetName(node: CodegenAstTextNode) -> String {
    let rest: String = CodegenAstTextLetPayload(node);
    let pos: Int = CodegenAstTextLetNameEnd(node);
    return Substring(rest, 0, pos);
}

func CodegenAstTextLetAfterName(node: CodegenAstTextNode) -> String {
    let rest: String = CodegenAstTextLetPayload(node);
    let pos: Int = CodegenAstTextLetNameEnd(node);
    return Substring(rest, pos + 3, StringLength(rest) - (pos + 3));
}

func CodegenAstTextLetInitializerPos(node: CodegenAstTextNode) -> Int {
    let after_name: String = CodegenAstTextLetAfterName(node);
    let pos: Int = StringIndexOf(after_name, " = ");
    if pos < 0 {
        Die(Concat("malformed Let statement (no initializer): ", node.text));
    }
    return pos;
}

func CodegenAstTextLetTypeName(node: CodegenAstTextNode) -> String {
    let after_name: String = CodegenAstTextLetAfterName(node);
    let pos: Int = CodegenAstTextLetInitializerPos(node);
    return Substring(after_name, 0, pos);
}

func CodegenAstTextLetInitializer(node: CodegenAstTextNode) -> String {
    let after_name: String = CodegenAstTextLetAfterName(node);
    let pos: Int = CodegenAstTextLetInitializerPos(node);
    return Substring(after_name, pos + 3, StringLength(after_name) - (pos + 3));
}

func CodegenAstTextAssignPayload(node: CodegenAstTextNode) -> String {
    return CodegenAstTextPayloadAfter(node, "Assign: ", "assign statement");
}

func CodegenAstTextAssignEqualsPos(node: CodegenAstTextNode) -> Int {
    let rest: String = CodegenAstTextAssignPayload(node);
    let pos: Int = StringIndexOf(rest, " = ");
    if pos < 0 {
        Die(Concat("malformed Assign statement: ", node.text));
    }
    return pos;
}

func CodegenAstTextAssignTarget(node: CodegenAstTextNode) -> String {
    let rest: String = CodegenAstTextAssignPayload(node);
    let pos: Int = CodegenAstTextAssignEqualsPos(node);
    return Substring(rest, 0, pos);
}

func CodegenAstTextAssignValue(node: CodegenAstTextNode) -> String {
    let rest: String = CodegenAstTextAssignPayload(node);
    let pos: Int = CodegenAstTextAssignEqualsPos(node);
    return Substring(rest, pos + 3, StringLength(rest) - (pos + 3));
}

func CodegenAstTextLogInner(node: CodegenAstTextNode) -> String {
    if !StartsWith(node.text, "Log(") || CharAt(node.text, StringLength(node.text) - 1) != ")" {
        Die(Concat("malformed Log statement AST line: ", node.text));
    }
    return StringTrim(Substring(node.text, 4, StringLength(node.text) - 5));
}

func CodegenAstTextReturnValue(node: CodegenAstTextNode) -> String {
    return StringTrim(CodegenAstTextPayloadAfter(node, "Return:", "return statement"));
}

func CodegenAstTextArrayPopTarget(node: CodegenAstTextNode) -> String {
    if !StartsWith(node.text, "ArrayPop(") || CharAt(node.text, StringLength(node.text) - 1) != ")" {
        Die(Concat("malformed ArrayPop statement AST line: ", node.text));
    }
    return StringTrim(Substring(node.text, 9, StringLength(node.text) - 10));
}

func CodegenAstTextArraySetInner(node: CodegenAstTextNode) -> String {
    if !StartsWith(node.text, "ArraySet(") || CharAt(node.text, StringLength(node.text) - 1) != ")" {
        Die(Concat("malformed ArraySet statement AST line: ", node.text));
    }
    return Substring(node.text, 9, StringLength(node.text) - 10);
}

func CodegenAstTextArraySetFirstComma(node: CodegenAstTextNode) -> Int {
    let inner: String = CodegenAstTextArraySetInner(node);
    let comma: Int = FindTopLevelComma(inner);
    if comma < 0 {
        Die(Concat("ArraySet needs three arguments: ", node.text));
    }
    return comma;
}

func CodegenAstTextArraySetSecondComma(node: CodegenAstTextNode) -> Int {
    let inner: String = CodegenAstTextArraySetInner(node);
    let first: Int = CodegenAstTextArraySetFirstComma(node);
    let rest: String = Substring(inner, first + 1, StringLength(inner) - (first + 1));
    let comma: Int = FindTopLevelComma(rest);
    if comma < 0 {
        Die(Concat("ArraySet needs three arguments: ", node.text));
    }
    return comma;
}

func CodegenAstTextArraySetTarget(node: CodegenAstTextNode) -> String {
    let inner: String = CodegenAstTextArraySetInner(node);
    let first: Int = CodegenAstTextArraySetFirstComma(node);
    return StringTrim(Substring(inner, 0, first));
}

func CodegenAstTextArraySetIndex(node: CodegenAstTextNode) -> String {
    let inner: String = CodegenAstTextArraySetInner(node);
    let first: Int = CodegenAstTextArraySetFirstComma(node);
    let rest: String = Substring(inner, first + 1, StringLength(inner) - (first + 1));
    let second: Int = CodegenAstTextArraySetSecondComma(node);
    return StringTrim(Substring(rest, 0, second));
}

func CodegenAstTextArraySetValue(node: CodegenAstTextNode) -> String {
    let inner: String = CodegenAstTextArraySetInner(node);
    let first: Int = CodegenAstTextArraySetFirstComma(node);
    let rest: String = Substring(inner, first + 1, StringLength(inner) - (first + 1));
    let second: Int = CodegenAstTextArraySetSecondComma(node);
    return StringTrim(Substring(rest, second + 1, StringLength(rest) - (second + 1)));
}

func CodegenAstTextArrayPushInner(node: CodegenAstTextNode) -> String {
    if !StartsWith(node.text, "ArrayPush(") || CharAt(node.text, StringLength(node.text) - 1) != ")" {
        Die(Concat("malformed ArrayPush statement AST line: ", node.text));
    }
    return Substring(node.text, 10, StringLength(node.text) - 11);
}

func CodegenAstTextArrayPushComma(node: CodegenAstTextNode) -> Int {
    let inner: String = CodegenAstTextArrayPushInner(node);
    let comma: Int = FindTopLevelComma(inner);
    if comma < 0 {
        Die(Concat("ArrayPush needs two arguments: ", node.text));
    }
    return comma;
}

func CodegenAstTextArrayPushTarget(node: CodegenAstTextNode) -> String {
    let inner: String = CodegenAstTextArrayPushInner(node);
    let comma: Int = CodegenAstTextArrayPushComma(node);
    return StringTrim(Substring(inner, 0, comma));
}

func CodegenAstTextArrayPushValue(node: CodegenAstTextNode) -> String {
    let inner: String = CodegenAstTextArrayPushInner(node);
    let comma: Int = CodegenAstTextArrayPushComma(node);
    return StringTrim(Substring(inner, comma + 1, StringLength(inner) - (comma + 1)));
}

func CodegenAstTextExitValue(node: CodegenAstTextNode) -> String {
    if !StartsWith(node.text, "Exit(") || CharAt(node.text, StringLength(node.text) - 1) != ")" {
        Die(Concat("malformed Exit statement AST line: ", node.text));
    }
    return StringTrim(Substring(node.text, 5, StringLength(node.text) - 6));
}

func CodegenAstTextEnumBracePos(node: CodegenAstTextNode) -> Int {
    let brace: Int = StringIndexOf(node.text, " { ");
    if brace < 0 || CharAt(node.text, StringLength(node.text) - 1) != "}" {
        Die(Concat("malformed enum declaration AST line: ", node.text));
    }
    return brace;
}

func CodegenAstTextEnumName(node: CodegenAstTextNode) -> String {
    let brace: Int = CodegenAstTextEnumBracePos(node);
    return Substring(node.text, 6, brace - 6);
}

func CodegenAstTextEnumVariantPayload(node: CodegenAstTextNode) -> String {
    let brace: Int = CodegenAstTextEnumBracePos(node);
    return StringTrim(Substring(node.text, brace + 3, StringLength(node.text) - (brace + 4)));
}

func CodegenAstTextEnumVariantCount(node: CodegenAstTextNode) -> Int {
    let rem: String = CodegenAstTextEnumVariantPayload(node);
    let count: Int = 0;
    while StringLength(rem) > 0 {
        let comma: Int = FindTopLevelComma(rem);
        let part: String = "";
        if comma < 0 {
            part = StringTrim(rem);
            rem = "";
        } else {
            part = StringTrim(Substring(rem, 0, comma));
            rem = StringTrim(Substring(rem, comma + 1, StringLength(rem) - (comma + 1)));
        }
        if StringLength(part) > 0 {
            count = count + 1;
        }
    }
    return count;
}

func CodegenAstTextEnumVariantNameAt(node: CodegenAstTextNode, index: Int) -> String {
    let rem: String = CodegenAstTextEnumVariantPayload(node);
    let cur: Int = 0;
    while StringLength(rem) > 0 {
        let comma: Int = FindTopLevelComma(rem);
        let part: String = "";
        if comma < 0 {
            part = StringTrim(rem);
            rem = "";
        } else {
            part = StringTrim(Substring(rem, 0, comma));
            rem = StringTrim(Substring(rem, comma + 1, StringLength(rem) - (comma + 1)));
        }
        if StringLength(part) > 0 {
            if cur == index {
                if StringIndexOf(part, "(") >= 0 {
                    Die(Concat("payload enum variants are not supported in self-host codegen subset: ", part));
                }
                return part;
            }
            cur = cur + 1;
        }
    }
    Die(Concat("enum variant index out of bounds: ", ToString(index)));
    return "";
}

func CodegenAstTextNominalPrefixLen(node: CodegenAstTextNode) -> Int {
    if StartsWith(node.text, "Struct: ") {
        return 8;
    }
    if StartsWith(node.text, "Class: ") {
        return 7;
    }
    if StartsWith(node.text, "Subject: ") {
        return 9;
    }
    if StartsWith(node.text, "Vessel: ") {
        return 8;
    }
    if StartsWith(node.text, "Object: ") {
        return 8;
    }
    if StartsWith(node.text, "TObject: ") {
        return 9;
    }
    Die(Concat("expected nominal declaration AST line: ", node.text));
    return -1;
}

func CodegenAstTextNominalName(node: CodegenAstTextNode) -> String {
    let prefix_len: Int = CodegenAstTextNominalPrefixLen(node);
    return Substring(node.text, prefix_len, StringLength(node.text) - prefix_len);
}

func CodegenAstTextRoleForPos(node: CodegenAstTextNode) -> Int {
    let pos: Int = StringIndexOf(node.text, " for ");
    if pos < 0 {
        Die(Concat("malformed role declaration AST line: ", node.text));
    }
    return pos;
}

func CodegenAstTextRoleName(node: CodegenAstTextNode) -> String {
    let fp: Int = CodegenAstTextRoleForPos(node);
    return Substring(node.text, 6, fp - 6);
}

func CodegenAstTextRoleForType(node: CodegenAstTextNode) -> String {
    let fp: Int = CodegenAstTextRoleForPos(node);
    return Substring(node.text, fp + 5, StringLength(node.text) - (fp + 5));
}

func CodegenAstTextParamMode(node: CodegenAstTextNode) -> Int {
    if StartsWith(node.text, "inout ") {
        return 1;
    }
    if StartsWith(node.text, "own ") {
        return 2;
    }
    if StartsWith(node.text, "ref ") {
        return 3;
    }
    return 0;
}

func CodegenAstTextParamModeName(mode: Int) -> String {
    if mode == 1 {
        return "inout";
    }
    if mode == 2 {
        return "own";
    }
    if mode == 3 {
        return "ref";
    }
    return "default";
}

func CodegenAstTextParamPayload(node: CodegenAstTextNode, mode: Int) -> String {
    if mode == 0 {
        return node.text;
    }
    let prefix_len: Int = 4;
    if mode == 1 {
        prefix_len = 6;
    }
    return Substring(node.text, prefix_len, StringLength(node.text) - prefix_len);
}

func CodegenAstTextParamName(node: CodegenAstTextNode, owner_name: String) -> String {
    let mode: Int = CodegenAstTextParamMode(node);
    let payload: String = CodegenAstTextParamPayload(node, mode);
    let colon: Int = StringIndexOf(payload, ": ");
    if colon < 0 && StringLength(owner_name) > 0 && payload == "self" {
        return "self";
    }
    if colon < 0 {
        Die(Concat("malformed parameter AST line: ", node.text));
    }
    return Substring(payload, 0, colon);
}

func CodegenAstTextParamType(node: CodegenAstTextNode, owner_name: String) -> String {
    let mode: Int = CodegenAstTextParamMode(node);
    let payload: String = CodegenAstTextParamPayload(node, mode);
    let colon: Int = StringIndexOf(payload, ": ");
    if colon < 0 && StringLength(owner_name) > 0 && payload == "self" {
        return owner_name;
    }
    if colon < 0 {
        Die(Concat("malformed parameter AST line: ", node.text));
    }
    return Substring(payload, colon + 2, StringLength(payload) - (colon + 2));
}

func CodegenAstTextFieldName(node: CodegenAstTextNode) -> String {
    let colon: Int = StringIndexOf(node.text, ": ");
    if colon < 0 {
        Die(Concat("malformed field AST line: ", node.text));
    }
    return Substring(node.text, 0, colon);
}

func CodegenAstTextFieldType(node: CodegenAstTextNode) -> String {
    let colon: Int = StringIndexOf(node.text, ": ");
    if colon < 0 {
        Die(Concat("malformed field AST line: ", node.text));
    }
    return Substring(node.text, colon + 2, StringLength(node.text) - (colon + 2));
}

func CodegenAstTextParentIndex(nodes: Array<CodegenAstTextNode>, count: Int, indent: Int) -> Int {
    let back: Int = count - 1;
    while back >= 0 {
        if nodes[back].indent < indent {
            return back;
        }
        back = back - 1;
    }
    return -1;
}

func CodegenAstTextIndentOf(raw: String) -> Int {
    let n: Int = StringLength(raw);
    let i: Int = 0;
    while i < n && CharAt(raw, i) == " " {
        i = i + 1;
    }
    return i;
}

func CodegenAstTextNodeInventory(ast: String, inout nodes: Array<CodegenAstTextNode>, inout count_box: Array<Int>) -> Void {
    let total: Int = StringLength(ast);
    let pos: Int = 0;
    while pos < total {
        let nl: Int = NextNewline(ast, pos);
        let raw_line: String = Substring(ast, pos, nl - pos);
        let trimmed: String = StringTrim(raw_line);
        // Namespace/import functions are flattened to top-level exported
        // function lines by the current parser bridge.
        if StartsWith(trimmed, "[export] ") {
            trimmed = Substring(trimmed, 9, StringLength(trimmed) - 9);
        }
        if StringLength(trimmed) > 0 {
            let indent: Int = CodegenAstTextIndentOf(raw_line);
            let parent: Int = CodegenAstTextParentIndex(nodes, count_box[0], indent);
            ArrayPush(nodes, CodegenAstTextNode(indent, trimmed, parent, CodegenAstTextKindOf(trimmed)));
            ArraySet(count_box, 0, count_box[0] + 1);
        }
        pos = nl + 1;
    }
}

func CodegenAstTextExpectNode(nodes: Array<CodegenAstTextNode>, count: Int, inout cur: Array<Int>, expected: String) -> Void {
    if cur[0] >= count {
        Die(Concat("expected `", Concat(expected, "` but reached end of AST")));
    }
    if nodes[cur[0]].text != expected {
        Die(Concat("expected `", Concat(expected, Concat("` but got: ", nodes[cur[0]].text))));
    }
    ArraySet(cur, 0, cur[0] + 1);
}
