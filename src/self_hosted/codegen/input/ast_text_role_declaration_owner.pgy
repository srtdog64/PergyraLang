// Transitional self-host codegen role declaration facts.
//
// Role name and target-type rows do not yet have a semantic owner. Keep this
// bridge named after that exact remaining responsibility; nominal and field
// declaration rows are forbidden here.

import "ast_arena_codegen_view_owner.pgy";

func CodegenAstArenaRoleNameOrDie(arena: AstArena, node_id: Int) -> String {
    if !CodegenAstArenaIsRoleDecl(arena, node_id) {
        Die(Concat("expected role declaration at typed AST node: ", ToString(node_id)));
    }
    return CodegenAstArenaAtomOrDie(arena, node_id);
}

func CodegenAstArenaRoleTargetTypeNameOrDie(arena: AstArena, node_id: Int) -> String {
    if !CodegenAstArenaIsRoleDecl(arena, node_id) {
        Die(Concat("expected role declaration at typed AST node: ", ToString(node_id)));
    }
    return CodegenAstArenaTypeNameOrDie(arena, node_id);
}
