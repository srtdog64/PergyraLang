// src/self_hosted/codegen/input/ast_text_statement_owner.pgy
//
// Owns statement-row facts for the transitional AST-text bridge.

import "ast_text_inventory_owner.pgy";
import "../text/text_owner.pgy";

func CodegenAstTextIsLetStmt(node: CodegenAstTextNode) -> Bool {
    return node.kind == 20;
}

func CodegenAstTextIsAssignStmt(node: CodegenAstTextNode) -> Bool {
    return node.kind == 21;
}

func CodegenAstTextIsLogStmt(node: CodegenAstTextNode) -> Bool {
    return node.kind == 13;
}

func CodegenAstTextIsBareReturnStmt(node: CodegenAstTextNode) -> Bool {
    return node.kind == 14;
}

func CodegenAstTextIsValueReturnStmt(node: CodegenAstTextNode) -> Bool {
    return node.kind == 15;
}

func CodegenAstTextIsDeferStmt(node: CodegenAstTextNode) -> Bool {
    return node.kind == 26;
}

func CodegenAstTextIsArrayPopStmt(node: CodegenAstTextNode) -> Bool {
    return node.kind == 16;
}

func CodegenAstTextIsArraySetStmt(node: CodegenAstTextNode) -> Bool {
    return node.kind == 18;
}

func CodegenAstTextIsArrayPushStmt(node: CodegenAstTextNode) -> Bool {
    return node.kind == 19;
}

func CodegenAstTextIsExitStmt(node: CodegenAstTextNode) -> Bool {
    return node.kind == 17;
}

func CodegenAstTextIsBreakStmt(node: CodegenAstTextNode) -> Bool {
    return node.kind == 27;
}

func CodegenAstTextIsContinueStmt(node: CodegenAstTextNode) -> Bool {
    return node.kind == 28;
}

func CodegenAstTextIsForStmt(node: CodegenAstTextNode) -> Bool {
    return node.kind == 22;
}

func CodegenAstTextIsWhileStmt(node: CodegenAstTextNode) -> Bool {
    return node.kind == 23;
}

func CodegenAstTextIsIfStmt(node: CodegenAstTextNode) -> Bool {
    return node.kind == 24;
}

func CodegenAstTextIsElseStmt(node: CodegenAstTextNode) -> Bool {
    return node.kind == 25;
}

func CodegenAstTextIsBareCallStmt(node: CodegenAstTextNode) -> Bool {
    return node.kind == 29;
}

func CodegenAstTextLetPayload(node: CodegenAstTextNode) -> String {
    if !CodegenAstTextIsLetStmt(node) || node.payload == "" {
        Die(Concat("malformed Let statement AST line: ", node.text));
    }
    return node.payload;
}

func CodegenAstTextLetNameEnd(node: CodegenAstTextNode) -> Int {
    let rest: String = CodegenAstTextLetPayload(node);
    let pos: Int = StringIndexOf(rest, " : ");
    if pos < 0 {
        Die(Concat("malformed Let statement (no type separator): ", node.text));
    }
    return pos;
}

func CodegenAstTextLetName(node: CodegenAstTextNode) -> String {
    let rest: String = CodegenAstTextLetPayload(node);
    let pos: Int = CodegenAstTextLetNameEnd(node);
    return Substring(rest, 0, pos);
}

func CodegenAstTextLetAfterName(node: CodegenAstTextNode) -> String {
    let rest: String = CodegenAstTextLetPayload(node);
    let pos: Int = CodegenAstTextLetNameEnd(node);
    return Substring(rest, pos + 3, StringLength(rest) - (pos + 3));
}

func CodegenAstTextLetInitializerPos(node: CodegenAstTextNode) -> Int {
    let after_name: String = CodegenAstTextLetAfterName(node);
    let pos: Int = StringIndexOf(after_name, " = ");
    if pos < 0 {
        Die(Concat("malformed Let statement (no initializer): ", node.text));
    }
    return pos;
}

func CodegenAstTextLetTypeName(node: CodegenAstTextNode) -> String {
    let after_name: String = CodegenAstTextLetAfterName(node);
    let pos: Int = CodegenAstTextLetInitializerPos(node);
    return Substring(after_name, 0, pos);
}

func CodegenAstTextLetInitializer(node: CodegenAstTextNode) -> String {
    let after_name: String = CodegenAstTextLetAfterName(node);
    let pos: Int = CodegenAstTextLetInitializerPos(node);
    return Substring(after_name, pos + 3, StringLength(after_name) - (pos + 3));
}

func CodegenAstTextAssignPayload(node: CodegenAstTextNode) -> String {
    if !CodegenAstTextIsAssignStmt(node) || node.payload == "" {
        Die(Concat("malformed Assign statement AST line: ", node.text));
    }
    return node.payload;
}

func CodegenAstTextAssignEqualsPos(node: CodegenAstTextNode) -> Int {
    let rest: String = CodegenAstTextAssignPayload(node);
    let pos: Int = StringIndexOf(rest, " = ");
    if pos < 0 {
        Die(Concat("malformed Assign statement: ", node.text));
    }
    return pos;
}

func CodegenAstTextAssignTarget(node: CodegenAstTextNode) -> String {
    let rest: String = CodegenAstTextAssignPayload(node);
    let pos: Int = CodegenAstTextAssignEqualsPos(node);
    return Substring(rest, 0, pos);
}

func CodegenAstTextAssignValue(node: CodegenAstTextNode) -> String {
    let rest: String = CodegenAstTextAssignPayload(node);
    let pos: Int = CodegenAstTextAssignEqualsPos(node);
    return Substring(rest, pos + 3, StringLength(rest) - (pos + 3));
}

func CodegenAstTextLogInner(node: CodegenAstTextNode) -> String {
    if !CodegenAstTextIsLogStmt(node) || node.payload == "" {
        Die(Concat("malformed Log statement AST line: ", node.text));
    }
    return node.payload;
}

func CodegenAstTextReturnValue(node: CodegenAstTextNode) -> String {
    if !CodegenAstTextIsValueReturnStmt(node) {
        Die(Concat("malformed Return statement AST line: ", node.text));
    }
    return node.payload;
}

func CodegenAstTextArrayPopTarget(node: CodegenAstTextNode) -> String {
    if !CodegenAstTextIsArrayPopStmt(node) || node.payload == "" {
        Die(Concat("malformed ArrayPop statement AST line: ", node.text));
    }
    return node.payload;
}

func CodegenAstTextArraySetInner(node: CodegenAstTextNode) -> String {
    if !CodegenAstTextIsArraySetStmt(node) || node.payload == "" {
        Die(Concat("malformed ArraySet statement AST line: ", node.text));
    }
    return node.payload;
}

func CodegenAstTextArraySetFirstComma(node: CodegenAstTextNode) -> Int {
    let inner: String = CodegenAstTextArraySetInner(node);
    let comma_opt: Option<Int> = FindTopLevelComma(inner);
    if !IsSome(comma_opt) {
        Die(Concat("ArraySet needs three arguments: ", node.text));
    }
    return UnwrapOption(comma_opt);
}

func CodegenAstTextArraySetSecondComma(node: CodegenAstTextNode) -> Int {
    let inner: String = CodegenAstTextArraySetInner(node);
    let first: Int = CodegenAstTextArraySetFirstComma(node);
    let rest: String = Substring(inner, first + 1, StringLength(inner) - (first + 1));
    let comma_opt: Option<Int> = FindTopLevelComma(rest);
    if !IsSome(comma_opt) {
        Die(Concat("ArraySet needs three arguments: ", node.text));
    }
    return UnwrapOption(comma_opt);
}

func CodegenAstTextArraySetTarget(node: CodegenAstTextNode) -> String {
    let inner: String = CodegenAstTextArraySetInner(node);
    let first: Int = CodegenAstTextArraySetFirstComma(node);
    return StringTrim(Substring(inner, 0, first));
}

func CodegenAstTextArraySetIndex(node: CodegenAstTextNode) -> String {
    let inner: String = CodegenAstTextArraySetInner(node);
    let first: Int = CodegenAstTextArraySetFirstComma(node);
    let rest: String = Substring(inner, first + 1, StringLength(inner) - (first + 1));
    let second: Int = CodegenAstTextArraySetSecondComma(node);
    return StringTrim(Substring(rest, 0, second));
}

func CodegenAstTextArraySetValue(node: CodegenAstTextNode) -> String {
    let inner: String = CodegenAstTextArraySetInner(node);
    let first: Int = CodegenAstTextArraySetFirstComma(node);
    let rest: String = Substring(inner, first + 1, StringLength(inner) - (first + 1));
    let second: Int = CodegenAstTextArraySetSecondComma(node);
    return StringTrim(Substring(rest, second + 1, StringLength(rest) - (second + 1)));
}

func CodegenAstTextArrayPushInner(node: CodegenAstTextNode) -> String {
    if !CodegenAstTextIsArrayPushStmt(node) || node.payload == "" {
        Die(Concat("malformed ArrayPush statement AST line: ", node.text));
    }
    return node.payload;
}

func CodegenAstTextArrayPushComma(node: CodegenAstTextNode) -> Int {
    let inner: String = CodegenAstTextArrayPushInner(node);
    let comma_opt: Option<Int> = FindTopLevelComma(inner);
    if !IsSome(comma_opt) {
        Die(Concat("ArrayPush needs two arguments: ", node.text));
    }
    return UnwrapOption(comma_opt);
}

func CodegenAstTextArrayPushTarget(node: CodegenAstTextNode) -> String {
    let inner: String = CodegenAstTextArrayPushInner(node);
    let comma: Int = CodegenAstTextArrayPushComma(node);
    return StringTrim(Substring(inner, 0, comma));
}

func CodegenAstTextArrayPushValue(node: CodegenAstTextNode) -> String {
    let inner: String = CodegenAstTextArrayPushInner(node);
    let comma: Int = CodegenAstTextArrayPushComma(node);
    return StringTrim(Substring(inner, comma + 1, StringLength(inner) - (comma + 1)));
}

func CodegenAstTextExitValue(node: CodegenAstTextNode) -> String {
    if !CodegenAstTextIsExitStmt(node) || node.payload == "" {
        Die(Concat("malformed Exit statement AST line: ", node.text));
    }
    return node.payload;
}

func CodegenAstTextForSpec(node: CodegenAstTextNode) -> String {
    if !CodegenAstTextIsForStmt(node) || node.payload == "" {
        Die(Concat("malformed For statement AST line: ", node.text));
    }
    return node.payload;
}

func CodegenAstTextForInPos(node: CodegenAstTextNode) -> Int {
    let spec: String = CodegenAstTextForSpec(node);
    let pos: Int = StringIndexOf(spec, " in ");
    if pos < 0 {
        Die(Concat("malformed For (no `in`): ", node.text));
    }
    return pos;
}

func CodegenAstTextForLoopVar(node: CodegenAstTextNode) -> String {
    let spec: String = CodegenAstTextForSpec(node);
    let inpos: Int = CodegenAstTextForInPos(node);
    return StringTrim(Substring(spec, 0, inpos));
}

func CodegenAstTextForIterable(node: CodegenAstTextNode) -> String {
    let spec: String = CodegenAstTextForSpec(node);
    let inpos: Int = CodegenAstTextForInPos(node);
    return Substring(spec, inpos + 4, StringLength(spec) - (inpos + 4));
}

func CodegenAstTextForRangeDotPos(node: CodegenAstTextNode) -> Int {
    let iterable: String = CodegenAstTextForIterable(node);
    return StringIndexOf(iterable, "..");
}

func CodegenAstTextForIsRange(node: CodegenAstTextNode) -> Bool {
    return CodegenAstTextForRangeDotPos(node) >= 0;
}

func CodegenAstTextForRangeStart(node: CodegenAstTextNode) -> String {
    let iterable: String = CodegenAstTextForIterable(node);
    let dotpos: Int = CodegenAstTextForRangeDotPos(node);
    if dotpos < 0 {
        Die(Concat("For range start requested for non-range statement: ", node.text));
    }
    return Substring(iterable, 0, dotpos);
}

func CodegenAstTextForRangeEnd(node: CodegenAstTextNode) -> String {
    let iterable: String = CodegenAstTextForIterable(node);
    let dotpos: Int = CodegenAstTextForRangeDotPos(node);
    if dotpos < 0 {
        Die(Concat("For range end requested for non-range statement: ", node.text));
    }
    return Substring(iterable, dotpos + 2, StringLength(iterable) - (dotpos + 2));
}

func CodegenAstTextForEachCollection(node: CodegenAstTextNode) -> String {
    return StringTrim(CodegenAstTextForIterable(node));
}

func CodegenAstTextWhileCondition(node: CodegenAstTextNode) -> String {
    if !CodegenAstTextIsWhileStmt(node) || node.payload == "" {
        Die(Concat("malformed While statement AST line: ", node.text));
    }
    return node.payload;
}

func CodegenAstTextIfCondition(node: CodegenAstTextNode) -> String {
    if !CodegenAstTextIsIfStmt(node) || node.payload == "" {
        Die(Concat("malformed If statement AST line: ", node.text));
    }
    return node.payload;
}

func CodegenAstTextHasElseAt(nodes: Array<CodegenAstTextNode>, count: Int, index: Int, if_indent: Int) -> Bool {
    return index < count && CodegenAstTextIsElseStmt(nodes[index]) && nodes[index].indent == if_indent + 2;
}

func CodegenAstTextIsElseIfAt(nodes: Array<CodegenAstTextNode>, count: Int, index: Int) -> Bool {
    return index < count && CodegenAstTextIsIfStmt(nodes[index]);
}

func CodegenAstTextBareCallExpr(node: CodegenAstTextNode) -> String {
    if !CodegenAstTextIsBareCallStmt(node) || node.payload == "" {
        Die(Concat("expected bare call statement AST line: ", node.text));
    }
    return node.payload;
}
