// Self-host codegen AST-text single-payload statement facts.
//
// Statement emission owns C lowering. This owner owns the payload meaning for
// simple statement rows whose semantic payload is the arena atom text.

import "ast_text_typed_arena_owner.pgy";

func CodegenAstArenaLogArgumentOrDie(arena: AstArena, node_id: Int) -> String {
    if !CodegenAstArenaIsLogStmt(arena, node_id) {
        Die(Concat("expected Log statement at typed AST node: ", ToString(node_id)));
    }
    return CodegenAstArenaAtomOrDie(arena, node_id);
}

func CodegenAstArenaReturnValueOrDie(arena: AstArena, node_id: Int) -> String {
    if !CodegenAstArenaIsValueReturnStmt(arena, node_id) {
        Die(Concat("expected value Return statement at typed AST node: ", ToString(node_id)));
    }
