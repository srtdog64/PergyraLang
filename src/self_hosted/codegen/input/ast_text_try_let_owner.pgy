// Self-host codegen try-let shape over semantic initializer facts.
//
// This owner keeps `let x: T = (?expr)` payload recognition and inner-expression
// extraction out of statement emission. The payload itself is semantic-owned.

import "semantic_local_binding_codegen_view_owner.pgy";
import "../text/text_owner.pgy";

struct CodegenLetTryInitializerFact {
    let has_initializer: Bool;
    let initializer: String;
}

func CodegenSemanticLetTryInitializerFactAt(
    facts: SemanticAstLocalBindingFacts,
    node_id: Int
) -> CodegenLetTryInitializerFact {
    let index: Option<Int> = SemanticAstLocalBindingIndexForNode(
        facts, node_id
    );
    if !IsSome(index) {
        return CodegenLetTryInitializerFact(false, "");
    }
    let initializer: Option<String> = SemanticAstLocalBindingInitializerAt(
        facts, UnwrapOption(index)
    );
    if !IsSome(initializer) {
        return CodegenLetTryInitializerFact(false, "");
    }
    return CodegenLetTryInitializerFact(true, UnwrapOption(initializer));
}

func CodegenLetTryInitializerText(fact: CodegenLetTryInitializerFact) -> Option<String> {
    if !fact.has_initializer {
        return None;
    }
    return Some(fact.initializer);
}

func CodegenSemanticLetInitializerHasTry(
    facts: SemanticAstLocalBindingFacts,
    node_id: Int
) -> Bool {
    let fact: CodegenLetTryInitializerFact =
        CodegenSemanticLetTryInitializerFactAt(facts, node_id);
    let initializer: Option<String> = CodegenLetTryInitializerText(fact);
    if !IsSome(initializer) {
        return false;
    }
    return ContainsOutsideStrings(UnwrapOption(initializer), "(?");
}

func CodegenSemanticLetTryInner(
    facts: SemanticAstLocalBindingFacts,
    node_id: Int
) -> Option<String> {
    let fact: CodegenLetTryInitializerFact =
        CodegenSemanticLetTryInitializerFactAt(facts, node_id);
    let initializer: Option<String> = CodegenLetTryInitializerText(fact);
    if !IsSome(initializer) {
        return None;
    }
    let e: String = StringTrim(UnwrapOption(initializer));
    let n: Int = StringLength(e);
    if n < 4 || CodegenCharAt(e, 0) != "(" || CodegenCharAt(e, 1) != "?" || CodegenCharAt(e, n - 1) != ")" {
        return None;
    }
    let close_opt: Option<Int> = FindMatchingParen(e, 0);
    if !IsSome(close_opt) || UnwrapOption(close_opt) != n - 1 {
        return None;
    }
    let inner: String = StringTrim(Substring(e, 2, n - 3));
    if StringLength(inner) == 0 {
        return None;
    }
    return Some(inner);
}
