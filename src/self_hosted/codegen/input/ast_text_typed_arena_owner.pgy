func CodegenAstArenaHasElseAt(arena: AstArena, count: Int, index: Int, if_indent: Int) -> Bool {
    return index < count && CodegenAstArenaIsElseStmt(arena, index)
        && CodegenAstArenaIndentOrDie(arena, index) == if_indent + 2;
}

func CodegenAstArenaIsElseIfAt(arena: AstArena, count: Int, index: Int) -> Bool {
    return index < count && CodegenAstArenaIsIfStmt(arena, index);
}

func CodegenAstArenaModeOrDie(arena: AstArena, node_id: Int) -> Int {
    let mode: Option<Int> = TypedAstArenaMode(arena, node_id);
    if !IsSome(mode) {
        Die(Concat("typed AST arena missing mode for node: ", ToString(node_id)));
    }
    return UnwrapOption(mode);
}

func CodegenAstArenaParamModeName(mode: Int) -> String {
    if mode == 1 {
        return "inout";
    }
    if mode == 2 {
        return "own";
    }
    if mode == 3 {
        return "ref";
    }
    return "default";
}

func CodegenAstArenaParamTypeOrDie(arena: AstArena, node_id: Int, owner_name: String) -> String {
    let type_name: Option<String> = TypedAstArenaTypeName(arena, node_id);
    if IsSome(type_name) {
        return UnwrapOption(type_name);
    }
    if StringLength(owner_name) > 0 && CodegenAstArenaAtomOrDie(arena, node_id) == "self" {
        return owner_name;
    }
    Die(Concat("typed AST arena missing parameter type for node: ", ToString(node_id)));
    return "";
}

func CodegenAstArenaParentOrDie(arena: AstArena, node_id: Int) -> Int {
    let parent: Option<Int> = TypedAstArenaParentId(arena, node_id);
    if !IsSome(parent) {
        Die(Concat("typed AST arena missing parent for node: ", ToString(node_id)));
    }
    return UnwrapOption(parent);
}

func CodegenAstArenaIsDescendantOf(arena: AstArena, node_id: Int, ancestor_id: Int) -> Bool {
    if node_id < 0 || ancestor_id < 0 {
        return false;
    }
    let cur_parent: Option<Int> = TypedAstArenaParentId(arena, node_id);
    while IsSome(cur_parent) {
        let cur: Int = UnwrapOption(cur_parent);
        if cur == ancestor_id {
            return true;
        }
        cur_parent = TypedAstArenaParentId(arena, cur);
    }
    return false;
}

func CodegenTypedAstBridgeReady(nodes: Array<CodegenAstTextNode>, count: Int) -> Bool {
    if !TypedAstArenaPayloadContractReady() {
        return false;
    }
    if count <= 0 {
        return false;
    }
    let arena: AstArena = CodegenAstTextTypedArenaFromNodes(nodes, count);
    if !CodegenAstArenaIsProgramRoot(arena, 0) {
        return false;
    }
    return CodegenAstTextTypedArenaProjectionReady(nodes, count);
}
