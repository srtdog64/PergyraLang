// Codegen AST usage fact owner.
//
// The self-host C emitter still consumes the transitional AST-text bridge, but
// runtime/header decisions should not rescan the raw AST document. This owner
// derives those decisions from the typed line inventory.

import "ast_arena_codegen_view_owner.pgy";
import "ast_expression_usage_owner.pgy";
import "ast_kind_usage_owner.pgy";
import "ast_type_usage_owner.pgy";

struct CodegenRuntimeUsageFacts {
    let uses_args: Bool;
    let uses_str: Bool;
    let uses_math: Bool;
    let uses_array_sort: Bool;
    let uses_array_reverse: Bool;
    let uses_array_map: Bool;
    let uses_array_filter: Bool;
    let uses_result: Bool;
    let uses_option: Bool;
    let uses_bool: Bool;
    let uses_exit: Bool;
    let uses_array: Bool;
    let uses_ast_text_node_array: Bool;
    let uses_io: Bool;
    let uses_join: Bool;
    let uses_split: Bool;
    let uses_dirwalk: Bool;
    let uses_log: Bool;
    let uses_fhandle: Bool;
    let uses_print: Bool;
    let uses_float: Bool;
    let uses_random_value: Bool;
    let uses_seed_random: Bool;
    let uses_random: Bool;
    let uses_allocator: Bool;
    let uses_text_builder: Bool;
}

func CodegenRuntimeUsageFactsFromArena(arena: AstArena, count: Int) -> CodegenRuntimeUsageFacts {
    let expr_usage: CodegenExpressionUsageFacts = CodegenExpressionUsageFactsFromArena(arena, count);
    let kind_usage: CodegenKindUsageFacts = CodegenKindUsageFactsFromArena(arena, count);
    let type_usage: CodegenTypeUsageFacts = CodegenTypeUsageFactsFromArena(arena, count);
    let uses_args: Bool = CodegenExpressionUsageGroupPresent(expr_usage, CodegenUsageBuiltinGroupArgs());
    let uses_str: Bool = type_usage.has_string
        || CodegenExpressionUsageGroupPresent(expr_usage, CodegenUsageBuiltinGroupString());
    let uses_math: Bool = CodegenExpressionUsageGroupPresent(expr_usage, CodegenUsageBuiltinGroupMath());
    let uses_array_sort: Bool = CodegenExpressionUsageGroupPresent(expr_usage, CodegenUsageBuiltinGroupArraySort());
    let uses_array_reverse: Bool = CodegenExpressionUsageGroupPresent(expr_usage, CodegenUsageBuiltinGroupArrayReverse());
    let uses_array_map: Bool = CodegenExpressionUsageGroupPresent(expr_usage, CodegenUsageBuiltinGroupArrayMap());
    let uses_array_filter: Bool = CodegenExpressionUsageGroupPresent(expr_usage, CodegenUsageBuiltinGroupArrayFilter());
    let uses_result: Bool = type_usage.has_result
        || CodegenExpressionUsageGroupPresent(expr_usage, CodegenUsageBuiltinGroupResult());
    let uses_option: Bool = type_usage.has_option
        || CodegenExpressionUsageGroupPresent(expr_usage, CodegenUsageBuiltinGroupOption())
        || CodegenExpressionUsageHasNone(expr_usage);
    let uses_bool: Bool = type_usage.has_bool || uses_array_filter || uses_result || uses_option
        || type_usage.has_allocator || type_usage.has_text_builder;
    let uses_exit: Bool = kind_usage.has_exit_stmt
        || CodegenExpressionUsageGroupPresent(expr_usage, CodegenUsageBuiltinGroupExit());
    let uses_array: Bool = type_usage.has_array
        || kind_usage.has_array_push
        || kind_usage.has_array_set
        || kind_usage.has_array_literal
        || CodegenExpressionUsageGroupPresent(expr_usage, CodegenUsageBuiltinGroupArrayCore())
        || uses_array_sort
        || uses_array_reverse
        || uses_array_map
        || uses_array_filter
        || uses_args;
    let uses_ast_text_node_array: Bool = type_usage.has_ast_text_node_array;
    let uses_io: Bool = CodegenExpressionUsageGroupPresent(expr_usage, CodegenUsageBuiltinGroupIo());
    let uses_join: Bool = CodegenExpressionUsageGroupPresent(expr_usage, CodegenUsageBuiltinGroupJoin());
    let uses_split: Bool = CodegenExpressionUsageGroupPresent(expr_usage, CodegenUsageBuiltinGroupSplit());
    let uses_dirwalk: Bool = CodegenExpressionUsageGroupPresent(expr_usage, CodegenUsageBuiltinGroupDirWalk());
    let uses_log: Bool = kind_usage.has_log_stmt
        || CodegenExpressionUsageGroupPresent(expr_usage, CodegenUsageBuiltinGroupLog());
    let uses_fhandle: Bool = CodegenExpressionUsageGroupPresent(expr_usage, CodegenUsageBuiltinGroupFileHandle());
    let uses_print: Bool = CodegenExpressionUsageGroupPresent(expr_usage, CodegenUsageBuiltinGroupPrint());
    let uses_float: Bool = type_usage.has_float
        || CodegenExpressionUsageGroupPresent(expr_usage, CodegenUsageBuiltinGroupFloat());
    let uses_random_value: Bool = CodegenExpressionUsageGroupPresent(expr_usage, CodegenUsageBuiltinGroupRandomValue());
    let uses_seed_random: Bool = CodegenExpressionUsageGroupPresent(expr_usage, CodegenUsageBuiltinGroupSeedRandom());
    let uses_random: Bool = uses_random_value || uses_seed_random;
    let uses_allocator: Bool = type_usage.has_allocator;
    let uses_text_builder: Bool = type_usage.has_text_builder;
    return CodegenRuntimeUsageFacts(
        uses_args,
        uses_str,
        uses_math,
        uses_array_sort,
        uses_array_reverse,
        uses_array_map,
        uses_array_filter,
        uses_result,
        uses_option,
        uses_bool,
        uses_exit,
        uses_array,
        uses_ast_text_node_array,
        uses_io,
        uses_join,
        uses_split,
        uses_dirwalk,
        uses_log,
        uses_fhandle,
        uses_print,
        uses_float,
        uses_random_value,
        uses_seed_random,
        uses_random,
        uses_allocator,
        uses_text_builder
    );
}
