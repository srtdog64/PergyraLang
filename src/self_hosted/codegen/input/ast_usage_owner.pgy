// Codegen AST usage fact owner.
//
// The self-host C emitter still consumes the transitional AST-text bridge, but
// runtime/header decisions should not rescan the raw AST document. This owner
// derives those decisions from the typed line inventory.

import "../text/text_owner.pgy";
import "ast_text_typed_arena_owner.pgy";

struct CodegenRuntimeUsageFacts {
    let uses_args: Bool;
    let uses_str: Bool;
    let uses_math: Bool;
    let uses_array_sort: Bool;
    let uses_array_reverse: Bool;
    let uses_array_map: Bool;
    let uses_array_filter: Bool;
    let uses_result: Bool;
    let uses_option: Bool;
    let uses_bool: Bool;
    let uses_exit: Bool;
    let uses_array: Bool;
    let uses_ast_text_node_array: Bool;
    let uses_io: Bool;
    let uses_join: Bool;
    let uses_split: Bool;
    let uses_dirwalk: Bool;
    let uses_log: Bool;
    let uses_fhandle: Bool;
    let uses_print: Bool;
    let uses_float: Bool;
    let uses_random_value: Bool;
    let uses_seed_random: Bool;
    let uses_random: Bool;
}

func CodegenAstArenaTypePartContains(part: Option<String>, needle: String) -> Bool {
    if !IsSome(part) {
        return false;
    }
    return StringIndexOf(UnwrapOption(part), needle) >= 0;
}

func CodegenAstArenaExpressionPartHasToken(part: Option<String>, token: String) -> Bool {
    if !IsSome(part) {
        return false;
    }
    let text: String = UnwrapOption(part);
    let n: Int = StringLength(text);
    let m: Int = StringLength(token);
    let i: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CodegenCharAt(text, i);
        if in_str {
            if c == "\\" {
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            i = i + 1;
            continue;
        }
        if m > 0 && i + m <= n && Substring(text, i, m) == token {
            let before_ok: Bool = i == 0 || !IsIdentChar(CodegenCharAt(text, i - 1));
            let after_pos: Int = i + m;
            let after_ok: Bool = after_pos >= n || !IsIdentChar(CodegenCharAt(text, after_pos));
            if before_ok && after_ok {
                return true;
            }
        }
        i = i + 1;
    }
    return false;
}

func CodegenAstArenaExpressionPartCalls(part: Option<String>, callee: String) -> Bool {
    if !IsSome(part) {
        return false;
    }
    return ContainsCallOutsideStrings(UnwrapOption(part), callee);
}

func CodegenAstArenaTypeFactPresent(arena: AstArena, count: Int, needle: String) -> Bool {
    let i: Int = 0;
    while i < count {
        if CodegenAstArenaTypePartContains(TypedAstArenaTypeName(arena, i), needle) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func CodegenAstArenaExpressionTokenPresent(arena: AstArena, count: Int, token: String) -> Bool {
    let i: Int = 0;
    while i < count {
        if CodegenAstArenaExpressionPartHasToken(TypedAstArenaAtomText(arena, i), token) ||
            CodegenAstArenaExpressionPartHasToken(TypedAstArenaValueText(arena, i), token) ||
            CodegenAstArenaExpressionPartHasToken(TypedAstArenaAuxValueText(arena, i), token) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func CodegenAstArenaBuiltinCallPresent(arena: AstArena, count: Int, callee: String) -> Bool {
    let i: Int = 0;
    while i < count {
        if CodegenAstArenaExpressionPartCalls(TypedAstArenaAtomText(arena, i), callee) ||
            CodegenAstArenaExpressionPartCalls(TypedAstArenaValueText(arena, i), callee) ||
            CodegenAstArenaExpressionPartCalls(TypedAstArenaAuxValueText(arena, i), callee) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func CodegenAstArenaKindPresent(arena: AstArena, count: Int, kind: Int) -> Bool {
    let i: Int = 0;
    while i < count {
        if CodegenAstArenaKindIs(arena, i, kind) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func CodegenRuntimeUsageFactsFromArena(arena: AstArena, count: Int) -> CodegenRuntimeUsageFacts {
    let uses_args: Bool = CodegenAstArenaBuiltinCallPresent(arena, count, "Args");
    let uses_str: Bool = CodegenAstArenaTypeFactPresent(arena, count, "String")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "Concat")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "Substring")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "StringLength")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "StringContains")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "StringIndexOf")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "StringTrim")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "StringReplace")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "SubIndexOfWithLen")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "SubEqualsWithLen")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "SubContainsWithLen")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "SubStartsWithLen")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "CharCode")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "CharAtN")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "ToInt")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "ToString")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "ToUpper")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "ToLower")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "StringJoin")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "Join")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "Split");
    let uses_math: Bool = CodegenAstArenaBuiltinCallPresent(arena, count, "Abs")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "Min")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "Max");
    let uses_array_sort: Bool = CodegenAstArenaBuiltinCallPresent(arena, count, "ArraySort");
    let uses_array_reverse: Bool = CodegenAstArenaBuiltinCallPresent(arena, count, "ArrayReverse");
    let uses_array_map: Bool = CodegenAstArenaBuiltinCallPresent(arena, count, "ArrayMap");
    let uses_array_filter: Bool = CodegenAstArenaBuiltinCallPresent(arena, count, "ArrayFilter");
    let uses_result: Bool = CodegenAstArenaTypeFactPresent(arena, count, "Result<")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "Ok")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "Err")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "IsOk")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "IsErr")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "Unwrap")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "UnwrapOr");
    let uses_option: Bool = CodegenAstArenaTypeFactPresent(arena, count, "Option<")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "Some")
        || CodegenAstArenaExpressionTokenPresent(arena, count, "None")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "IsSome")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "UnwrapOption");
    let uses_bool: Bool = CodegenAstArenaTypeFactPresent(arena, count, "Bool") || uses_array_filter || uses_result || uses_option;
    let uses_exit: Bool = CodegenAstArenaKindPresent(arena, count, 17)
        || CodegenAstArenaBuiltinCallPresent(arena, count, "Exit");
    let uses_array: Bool = CodegenAstArenaTypeFactPresent(arena, count, "Array<")
        || CodegenAstArenaKindPresent(arena, count, 19)
        || CodegenAstArenaBuiltinCallPresent(arena, count, "ArrayPush")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "ArrayLength")
        || CodegenAstArenaKindPresent(arena, count, 18)
        || CodegenAstArenaBuiltinCallPresent(arena, count, "ArraySet")
        || CodegenAstArenaKindPresent(arena, count, 16)
        || CodegenAstArenaBuiltinCallPresent(arena, count, "ArrayPop")
        || uses_array_sort
        || uses_array_reverse
        || uses_array_map
        || uses_array_filter
        || CodegenAstArenaBuiltinCallPresent(arena, count, "StringJoin")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "Join")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "Split")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "DirWalk")
        || uses_args;
    let uses_ast_text_node_array: Bool = CodegenAstArenaTypeFactPresent(arena, count, "Array<CodegenAstTextNode");
    let uses_io: Bool = CodegenAstArenaBuiltinCallPresent(arena, count, "ReadFile")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "ReadStdin")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "FileExists")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "WriteFile");
    let uses_join: Bool = CodegenAstArenaBuiltinCallPresent(arena, count, "StringJoin")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "Join");
    let uses_split: Bool = CodegenAstArenaBuiltinCallPresent(arena, count, "Split");
    let uses_dirwalk: Bool = CodegenAstArenaBuiltinCallPresent(arena, count, "DirWalk");
    let uses_log: Bool = CodegenAstArenaKindPresent(arena, count, 13)
        || CodegenAstArenaBuiltinCallPresent(arena, count, "Log");
    let uses_fhandle: Bool = CodegenAstArenaBuiltinCallPresent(arena, count, "FileOpen")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "FileWrite")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "FileClose")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "FileRead");
    let uses_print: Bool = CodegenAstArenaBuiltinCallPresent(arena, count, "Print");
    let uses_float: Bool = CodegenAstArenaTypeFactPresent(arena, count, "Float")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "Sqrt")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "Pow")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "Floor")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "Ceil")
        || CodegenAstArenaBuiltinCallPresent(arena, count, "ToFloat");
    let uses_random_value: Bool = CodegenAstArenaBuiltinCallPresent(arena, count, "Random");
    let uses_seed_random: Bool = CodegenAstArenaBuiltinCallPresent(arena, count, "SeedRandom");
    let uses_random: Bool = uses_random_value || uses_seed_random;
    return CodegenRuntimeUsageFacts(
        uses_args,
        uses_str,
        uses_math,
        uses_array_sort,
        uses_array_reverse,
        uses_array_map,
        uses_array_filter,
        uses_result,
        uses_option,
        uses_bool,
        uses_exit,
        uses_array,
        uses_ast_text_node_array,
        uses_io,
        uses_join,
        uses_split,
        uses_dirwalk,
        uses_log,
        uses_fhandle,
        uses_print,
        uses_float,
        uses_random_value,
        uses_seed_random,
        uses_random
    );
}
