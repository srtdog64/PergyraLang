// Codegen AST usage fact owner.
//
// The self-host C emitter still consumes the transitional AST-text bridge, but
// runtime/header decisions should not rescan the raw AST document. This owner
// derives those decisions from the typed line inventory.

import "ast_text_typed_arena_owner.pgy";

struct CodegenRuntimeUsageFacts {
    let uses_args: Bool;
    let uses_str: Bool;
    let uses_math: Bool;
    let uses_array_sort: Bool;
    let uses_array_reverse: Bool;
    let uses_array_map: Bool;
    let uses_array_filter: Bool;
    let uses_result: Bool;
    let uses_option: Bool;
    let uses_bool: Bool;
    let uses_exit: Bool;
    let uses_array: Bool;
    let uses_ast_text_node_array: Bool;
    let uses_io: Bool;
    let uses_join: Bool;
    let uses_split: Bool;
    let uses_dirwalk: Bool;
    let uses_log: Bool;
    let uses_fhandle: Bool;
    let uses_print: Bool;
    let uses_float: Bool;
    let uses_random_value: Bool;
    let uses_seed_random: Bool;
    let uses_random: Bool;
}

func CodegenAstArenaTextPartContains(part: Option<String>, needle: String) -> Bool {
    if !IsSome(part) {
        return false;
    }
    return StringIndexOf(UnwrapOption(part), needle) >= 0;
}

func CodegenAstArenaContains(arena: AstArena, count: Int, needle: String) -> Bool {
    let i: Int = 0;
    while i < count {
        if CodegenAstArenaTextPartContains(TypedAstArenaAtomText(arena, i), needle) ||
            CodegenAstArenaTextPartContains(TypedAstArenaTypeName(arena, i), needle) ||
            CodegenAstArenaTextPartContains(TypedAstArenaValueText(arena, i), needle) ||
            CodegenAstArenaTextPartContains(TypedAstArenaAuxValueText(arena, i), needle) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func CodegenAstArenaKindPresent(arena: AstArena, count: Int, kind: Int) -> Bool {
    let i: Int = 0;
    while i < count {
        if CodegenAstArenaKindIs(arena, i, kind) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func CodegenRuntimeUsageFactsFromArena(arena: AstArena, count: Int) -> CodegenRuntimeUsageFacts {
    let uses_args: Bool = CodegenAstArenaContains(arena, count, "Args(");
    let uses_str: Bool = CodegenAstArenaContains(arena, count, "String")
        || CodegenAstArenaContains(arena, count, "Concat(")
        || CodegenAstArenaContains(arena, count, "Substring(")
        || CodegenAstArenaContains(arena, count, "SubIndexOfWithLen(")
        || CodegenAstArenaContains(arena, count, "SubEqualsWithLen(")
        || CodegenAstArenaContains(arena, count, "SubContainsWithLen(")
        || CodegenAstArenaContains(arena, count, "SubStartsWithLen(")
        || CodegenAstArenaContains(arena, count, "ToUpper(")
        || CodegenAstArenaContains(arena, count, "ToLower(");
    let uses_math: Bool = CodegenAstArenaContains(arena, count, "Abs(")
        || CodegenAstArenaContains(arena, count, "Min(")
        || CodegenAstArenaContains(arena, count, "Max(");
    let uses_array_sort: Bool = CodegenAstArenaContains(arena, count, "ArraySort(");
    let uses_array_reverse: Bool = CodegenAstArenaContains(arena, count, "ArrayReverse(");
    let uses_array_map: Bool = CodegenAstArenaContains(arena, count, "ArrayMap(");
    let uses_array_filter: Bool = CodegenAstArenaContains(arena, count, "ArrayFilter(");
    let uses_result: Bool = CodegenAstArenaContains(arena, count, "Result<")
        || CodegenAstArenaContains(arena, count, "Ok(")
        || CodegenAstArenaContains(arena, count, "Err(")
        || CodegenAstArenaContains(arena, count, "IsOk(")
        || CodegenAstArenaContains(arena, count, "IsErr(")
        || CodegenAstArenaContains(arena, count, "Unwrap(")
        || CodegenAstArenaContains(arena, count, "UnwrapOr(");
    let uses_option: Bool = CodegenAstArenaContains(arena, count, "Option<")
        || CodegenAstArenaContains(arena, count, "Some(")
        || CodegenAstArenaContains(arena, count, "None")
        || CodegenAstArenaContains(arena, count, "IsSome(")
        || CodegenAstArenaContains(arena, count, "UnwrapOption(");
    let uses_bool: Bool = CodegenAstArenaContains(arena, count, "Bool") || uses_array_filter || uses_result || uses_option;
    let uses_exit: Bool = CodegenAstArenaKindPresent(arena, count, 17)
        || CodegenAstArenaContains(arena, count, "Exit(");
    let uses_array: Bool = CodegenAstArenaContains(arena, count, "Array<")
        || CodegenAstArenaKindPresent(arena, count, 19)
        || CodegenAstArenaContains(arena, count, "ArrayPush(")
        || CodegenAstArenaContains(arena, count, "ArrayLength(")
        || CodegenAstArenaKindPresent(arena, count, 18)
        || CodegenAstArenaContains(arena, count, "ArraySet(")
        || CodegenAstArenaKindPresent(arena, count, 16)
        || CodegenAstArenaContains(arena, count, "ArrayPop(")
        || uses_array_sort
        || uses_array_reverse
        || uses_array_map
        || uses_array_filter
        || CodegenAstArenaContains(arena, count, "StringJoin(")
        || CodegenAstArenaContains(arena, count, "Join(")
        || CodegenAstArenaContains(arena, count, "Split(")
        || CodegenAstArenaContains(arena, count, "DirWalk(")
        || uses_args;
    let uses_ast_text_node_array: Bool = CodegenAstArenaContains(arena, count, "Array<CodegenAstTextNode");
    let uses_io: Bool = CodegenAstArenaContains(arena, count, "ReadFile(")
        || CodegenAstArenaContains(arena, count, "ReadStdin(")
        || CodegenAstArenaContains(arena, count, "FileExists(")
        || CodegenAstArenaContains(arena, count, "WriteFile(");
    let uses_join: Bool = CodegenAstArenaContains(arena, count, "StringJoin(")
        || CodegenAstArenaContains(arena, count, "Join(");
    let uses_split: Bool = CodegenAstArenaContains(arena, count, "Split(");
    let uses_dirwalk: Bool = CodegenAstArenaContains(arena, count, "DirWalk(");
    let uses_log: Bool = CodegenAstArenaKindPresent(arena, count, 13)
        || CodegenAstArenaContains(arena, count, "Log");
    let uses_fhandle: Bool = CodegenAstArenaContains(arena, count, "FileOpen(")
        || CodegenAstArenaContains(arena, count, "FileWrite(")
        || CodegenAstArenaContains(arena, count, "FileClose(")
        || CodegenAstArenaContains(arena, count, "FileRead(");
    let uses_print: Bool = CodegenAstArenaContains(arena, count, "Print(");
    let uses_float: Bool = CodegenAstArenaContains(arena, count, "Float")
        || CodegenAstArenaContains(arena, count, "Sqrt(")
        || CodegenAstArenaContains(arena, count, "Pow(")
        || CodegenAstArenaContains(arena, count, "Floor(")
        || CodegenAstArenaContains(arena, count, "Ceil(")
        || CodegenAstArenaContains(arena, count, "ToFloat(");
    let uses_random_value: Bool = CodegenAstArenaContains(arena, count, "Random(");
    let uses_seed_random: Bool = CodegenAstArenaContains(arena, count, "SeedRandom(");
    let uses_random: Bool = uses_random_value || uses_seed_random;
    return CodegenRuntimeUsageFacts(
        uses_args,
        uses_str,
        uses_math,
        uses_array_sort,
        uses_array_reverse,
        uses_array_map,
        uses_array_filter,
        uses_result,
        uses_option,
        uses_bool,
        uses_exit,
        uses_array,
        uses_ast_text_node_array,
        uses_io,
        uses_join,
        uses_split,
        uses_dirwalk,
        uses_log,
        uses_fhandle,
        uses_print,
        uses_float,
        uses_random_value,
        uses_seed_random,
        uses_random
    );
}

func CodegenRuntimeUsageFactsFromNodes(nodes: Array<CodegenAstTextNode>, count: Int) -> CodegenRuntimeUsageFacts {
    let arena: AstArena = CodegenAstTextTypedArenaFromNodes(nodes, count);
    return CodegenRuntimeUsageFactsFromArena(arena, count);
}
