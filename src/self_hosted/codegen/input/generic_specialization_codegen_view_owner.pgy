// Concrete generic-function specializations carried by expression graph facts.

import "../../compiler/symbol_table_owner.pgy";
import "../../semantic/ast_expression_call_target_fact_owner.pgy";
import "../../semantic/ast_expression_graph_call_view_owner.pgy";
import "../../semantic/ast_expression_graph_generic_call_owner.pgy";
import "../../semantic/ast_expression_surface_fact_owner.pgy";
import "../../semantic/ast_type_name_canonical_owner.pgy";
import "semantic_signature_codegen_view_owner.pgy";

struct CodegenGenericSpecializationFacts {
    ok: Bool;
    diagnostic_message: String;
    signature_indexes: Array<Int>;
    c_names: Array<String>;
    actual_starts: Array<Int>;
    actual_counts: Array<Int>;
    actual_type_names: Array<String>;
}

func CodegenGenericSpecializationFactsEmpty(
) -> CodegenGenericSpecializationFacts {
    let signature_indexes: Array<Int> = [];
    let c_names: Array<String> = [];
    let actual_starts: Array<Int> = [];
    let actual_counts: Array<Int> = [];
    let actual_type_names: Array<String> = [];
    return CodegenGenericSpecializationFacts(
        true, "", signature_indexes, c_names, actual_starts, actual_counts,
        actual_type_names
    );
}

func CodegenGenericSpecializationFactsFromSemantic(
    signatures: SemanticAstFunctionSignatureFacts,
    expression_surfaces: SemanticAstExpressionSurfaceFacts
) -> CodegenGenericSpecializationFacts {
    let facts: CodegenGenericSpecializationFacts =
        CodegenGenericSpecializationFactsEmpty();
    let graph: SemanticExpressionGraphFacts =
        expression_surfaces.expression_graph;
    let node_id: Int = 0;
    while node_id < SemanticExpressionGraphArenaNodeCount(graph.arena) {
        let view: SemanticCallSpineView = SemanticCallSpineViewFromGraph(
            graph, node_id
        );
        if view.ok && ArrayLength(view.generic_actual_type_names) > 0 {
            let target_kind: Option<Int> =
                SemanticExpressionGraphCallTargetKind(graph, view.call_node);
            let target_name: Option<String> =
                SemanticExpressionGraphCallTargetName(graph, view.call_node);
            if IsSome(target_kind) && IsSome(target_name) &&
                UnwrapOption(target_kind) == SemanticCallTargetDirect() {
                let signature_index_opt: Option<Int> =
                    SemanticGenericCallSignatureIndex(
                        signatures, UnwrapOption(target_name)
                    );
                if IsSome(signature_index_opt) {
                    let signature_index: Int =
                        UnwrapOption(signature_index_opt);
                    let generic_count_opt: Option<Int> =
                        SemanticAstFunctionGenericCountAt(
                            signatures, signature_index
                        );
                    if !IsSome(generic_count_opt) ||
                        UnwrapOption(generic_count_opt) !=
                            ArrayLength(view.generic_actual_type_names) {
                        return CodegenGenericSpecializationFacts(
                            false, "generic actual count does not match signature",
                            facts.signature_indexes, facts.c_names,
                            facts.actual_starts, facts.actual_counts,
                            facts.actual_type_names
                        );
                    }
                    let actuals: Array<String> = [];
                    let actual_i: Int = 0;
                    while actual_i <
                        ArrayLength(view.generic_actual_type_names) {
                        let actual: String = SemanticCanonicalTypeName(
                            view.generic_actual_type_names[actual_i]
                        );
                        if actual == "" {
                            return CodegenGenericSpecializationFacts(
                                false, "generic actual type is invalid",
                                facts.signature_indexes, facts.c_names,
                                facts.actual_starts, facts.actual_counts,
                                facts.actual_type_names
                            );
                        }
                        ArrayPush(actuals, actual);
                        actual_i = actual_i + 1;
                    }
                    let owner: String = CodegenSemanticFunctionOwnerOrDie(
                        signatures, signature_index
                    );
                    let name: String = CodegenSemanticFunctionNameOrDie(
                        signatures, signature_index
                    );
                    let base_c_name: String =
                        CompilerSymbolCQualifiedName(owner, name);
                    let c_name: String =
                        CompilerSymbolCGenericSpecializationName(
                            base_c_name, actuals
                        );
                    let existing: Int = -1;
                    let spec_i: Int = 0;
                    while spec_i < ArrayLength(facts.c_names) {
                        if facts.c_names[spec_i] == c_name {
                            existing = spec_i;
                        }
                        spec_i = spec_i + 1;
                    }
                    if existing < 0 {
                        ArrayPush(facts.signature_indexes, signature_index);
                        ArrayPush(facts.c_names, c_name);
                        ArrayPush(
                            facts.actual_starts,
                            ArrayLength(facts.actual_type_names)
                        );
                        ArrayPush(facts.actual_counts, ArrayLength(actuals));
                        actual_i = 0;
                        while actual_i < ArrayLength(actuals) {
                            ArrayPush(
                                facts.actual_type_names, actuals[actual_i]
                            );
                            actual_i = actual_i + 1;
                        }
                    } else if facts.signature_indexes[existing] !=
                        signature_index {
                        return CodegenGenericSpecializationFacts(
                            false, "generic specialization symbol collision",
                            facts.signature_indexes, facts.c_names,
                            facts.actual_starts, facts.actual_counts,
                            facts.actual_type_names
                        );
                    }
                }
            }
        }
        node_id = node_id + 1;
    }
    node_id = 0;
    while node_id < SemanticExpressionGraphArenaNodeCount(graph.arena) {
        let view: SemanticCallSpineView = SemanticCallSpineViewFromGraph(
            graph, node_id
        );
        if view.ok && ArrayLength(view.generic_actual_type_names) == 0 {
            let target_kind: Option<Int> =
                SemanticExpressionGraphCallTargetKind(graph, view.call_node);
            let target_name: Option<String> =
                SemanticExpressionGraphCallTargetName(graph, view.call_node);
            if IsSome(target_kind) && IsSome(target_name) &&
                UnwrapOption(target_kind) == SemanticCallTargetDirect() {
                let signature_index: Option<Int> =
                    SemanticGenericCallSignatureIndex(
                        signatures, UnwrapOption(target_name)
                    );
                if IsSome(signature_index) &&
                    CodegenSemanticFunctionGenericCountOrDie(
                        signatures, UnwrapOption(signature_index)
                    ) > 0 {
                    return CodegenGenericSpecializationFacts(
                        false, "generic call requires explicit actuals in the bounded self-host emitter",
                        facts.signature_indexes, facts.c_names,
                        facts.actual_starts, facts.actual_counts,
                        facts.actual_type_names
                    );
                }
            }
        }
        node_id = node_id + 1;
    }
    return facts;
}

func CodegenGenericSpecializationCount(
    facts: CodegenGenericSpecializationFacts
) -> Int {
    return ArrayLength(facts.c_names);
}

func CodegenGenericSpecializationActuals(
    facts: CodegenGenericSpecializationFacts,
    specialization_index: Int
) -> Array<String> {
    let actuals: Array<String> = [];
    if !facts.ok || specialization_index < 0 ||
        specialization_index >= CodegenGenericSpecializationCount(facts) {
        return actuals;
    }
    let start: Int = facts.actual_starts[specialization_index];
    let count: Int = facts.actual_counts[specialization_index];
    let i: Int = 0;
    while i < count {
        ArrayPush(actuals, facts.actual_type_names[start + i]);
        i = i + 1;
    }
    return actuals;
}

func CodegenGenericResolvedParamTypeOrDie(
    signatures: SemanticAstFunctionSignatureFacts,
    signature_index: Int,
    parameter_index: Int,
    actuals: Array<String>
) -> String {
    if ArrayLength(actuals) == 0 {
        return CodegenSemanticFunctionParamTypeOrDie(
            signatures, signature_index, parameter_index
        );
    }
    let flat: Option<Int> = SemanticAstFunctionParamFlatIndex(
        signatures, signature_index, parameter_index
    );
    let generic_count: Option<Int> = SemanticAstFunctionGenericCountAt(
        signatures, signature_index
    );
    if !IsSome(flat) || !IsSome(generic_count) ||
        UnwrapOption(generic_count) != ArrayLength(actuals) {
        Die("generic specialization parameter fact is incomplete");
    }
    let resolved: Option<String> =
        SemanticAstSignatureTypeExpressionResolveRoot(
            signatures.type_expressions,
            signatures.type_expressions.parameter_roots[UnwrapOption(flat)],
            signatures.generic_starts[signature_index],
            UnwrapOption(generic_count), signatures.generic_names, actuals
        );
    if !IsSome(resolved) {
        Die("generic specialization parameter type is unresolved");
    }
    return UnwrapOption(resolved);
}

func CodegenGenericResolvedReturnTypeOrDie(
    signatures: SemanticAstFunctionSignatureFacts,
    signature_index: Int,
    actuals: Array<String>
) -> String {
    if ArrayLength(actuals) == 0 {
        return CodegenSemanticFunctionReturnTypeOrDie(
            signatures, signature_index
        );
    }
    let generic_count: Option<Int> = SemanticAstFunctionGenericCountAt(
        signatures, signature_index
    );
    if !IsSome(generic_count) ||
        UnwrapOption(generic_count) != ArrayLength(actuals) {
        Die("generic specialization return fact is incomplete");
    }
    let resolved: Option<String> = SemanticAstSignatureReturnTypeResolveAt(
        signatures.type_expressions, signature_index,
        signatures.generic_starts[signature_index],
        UnwrapOption(generic_count), signatures.generic_names, actuals
    );
    if !IsSome(resolved) {
        Die("generic specialization return type is unresolved");
    }
    return UnwrapOption(resolved);
}
