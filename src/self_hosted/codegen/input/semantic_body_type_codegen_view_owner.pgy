// Verified semantic body-type bundle consumed by codegen.
//
// The semantic owner synthesizes the facts once. Codegen validates and projects
// that prepared bundle; it may not invoke any semantic fact producer.

import "../../semantic/ast_body_type_bundle_owner.pgy";
import "../../semantic/ast_body_type_bundle_admission_receipt_owner.pgy";
import "../../semantic/ast_expression_call_return_type_diagnostic_owner.pgy";
import "../text/text_owner.pgy";
import "semantic_assignment_codegen_view_owner.pgy";
import "semantic_statement_codegen_view_owner.pgy";
import "generic_specialization_codegen_view_owner.pgy";

struct CodegenSemanticBodyTypeFacts {
    assignment_types: SemanticAstAssignmentTypeFacts;
    statement_types: SemanticAstStatementTypeFacts;
    generic_specializations: CodegenGenericSpecializationFacts;
}

func CodegenSemanticBodyTypeFactsFromBundleOrDie(
    artifact: AstTreeArtifact,
    ref analysis: SemanticAstArtifactAnalysis,
    own bundle: SemanticAstBodyTypeBundle,
    own generic_specializations: CodegenGenericSpecializationFacts
) -> CodegenSemanticBodyTypeFacts {
    if !SemanticAstBodyTypeBundleReady(artifact, analysis, bundle) {
        let readiness_error: String =
            SemanticAstBodyTypeBundleReadinessError(
                artifact, analysis, bundle);
        if readiness_error == "call_return_type_rows" {
            readiness_error = Concat(readiness_error, Concat(":",
                SemanticExpressionGraphCallReturnTypesResolutionDiagnostic(
                    analysis.expression_surfaces.expression_graph,
                    analysis.signatures, analysis.function_tables,
                    bundle.generic_specializations)));
        }
        Die(Concat(
            "codegen semantic body type bundle is missing or invalid: ",
            readiness_error
        ));
    }
    if !CodegenSemanticAssignmentTypeFactsReady(
        artifact, analysis.assignments, bundle.assignment_types
    ) {
        Die("codegen semantic assignment type facts are missing or invalid");
    }
    if !CodegenSemanticStatementTypeFactsReady(
        artifact, analysis.statements, bundle.statement_types
    ) {
        Die("codegen semantic statement type facts are missing or invalid");
    }
    if !generic_specializations.ok {
        Die(Concat(
            "codegen generic specialization facts are incomplete: ",
            generic_specializations.diagnostic_message
        ));
    }
    return CodegenSemanticBodyTypeFacts(
        bundle.assignment_types, bundle.statement_types,
        generic_specializations
    );
}

func CodegenSemanticBodyTypeFactsFromAdmittedBundleOrDie(
    artifact: AstTreeArtifact,
    ref analysis: SemanticAstArtifactAnalysis,
    own bundle: SemanticAstBodyTypeBundle,
    own generic_specializations: CodegenGenericSpecializationFacts,
    receipt: SemanticAstBodyTypeBundleAdmissionReceipt
) -> CodegenSemanticBodyTypeFacts {
    if !SemanticAstBodyTypeBundleAdmissionReceiptReadyFor(
        receipt, artifact, analysis, bundle
    ) {
        Die("codegen semantic body type admission receipt is missing or stale");
    }
    if !generic_specializations.ok {
        Die(Concat(
            "codegen generic specialization facts are incomplete: ",
            generic_specializations.diagnostic_message
        ));
    }
    return CodegenSemanticBodyTypeFacts(
        bundle.assignment_types, bundle.statement_types,
        generic_specializations
    );
}
