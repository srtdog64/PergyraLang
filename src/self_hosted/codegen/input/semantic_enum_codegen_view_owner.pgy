// Fail-closed codegen view over semantic-owned enum declaration facts.

import "../../semantic/ast_enum_fact_owner.pgy";
import "../text/text_owner.pgy";

func CodegenSemanticEnumIs(
    facts: SemanticAstEnumFacts,
    node_id: Int
) -> Bool {
    return IsSome(SemanticAstEnumIndexForNode(facts, node_id));
}

func CodegenSemanticEnumNameAtOrDie(
    facts: SemanticAstEnumFacts,
    index: Int
) -> String {
    let name: Option<String> = SemanticAstEnumNameAt(facts, index);
    if !IsSome(name) {
        Die(Concat("semantic enum index out of bounds: ", ToString(index)));
    }
    return UnwrapOption(name);
}

func CodegenSemanticEnumVariantCount(
    facts: SemanticAstEnumFacts,
    enum_name: String
) -> Int {
    let count: Option<Int> = SemanticAstEnumVariantCountForName(
        facts, enum_name
    );
    if !IsSome(count) {
        Die(Concat("semantic enum is missing: ", enum_name));
    }
    return UnwrapOption(count);
}

func CodegenSemanticEnumVariantNameAtOrDie(
    facts: SemanticAstEnumFacts,
    enum_name: String,
    index: Int
) -> String {
    let name: Option<String> = SemanticAstEnumVariantNameAt(
        facts, enum_name, index
    );
    if !IsSome(name) {
        Die(Concat("semantic enum variant index out of bounds: ", ToString(index)));
    }
    return UnwrapOption(name);
}

func CodegenSemanticEnumVariantParamCountAtOrDie(
    facts: SemanticAstEnumFacts,
    enum_name: String,
    index: Int
) -> Int {
    let count: Option<Int> = SemanticAstEnumVariantParamCountAt(
        facts, enum_name, index
    );
    if !IsSome(count) {
        Die(Concat(
            "semantic enum variant parameter count is missing: ",
            Concat(enum_name, Concat("#", ToString(index)))
        ));
    }
    return UnwrapOption(count);
}

func CodegenSemanticEnumVariantPayloadTypeAtOrDie(
    facts: SemanticAstEnumFacts,
    enum_name: String,
    variant_name: String,
    payload_index: Int
) -> String {
    let payload_type: Option<String> =
        SemanticAstEnumVariantPayloadTypeAt(
            facts, enum_name, variant_name, payload_index
        );
    if !IsSome(payload_type) {
        Die(Concat(
            "semantic enum variant payload type is missing: ",
            Concat(enum_name, Concat(".", Concat(
                variant_name, Concat("#", ToString(payload_index))
            )))
        ));
    }
    return UnwrapOption(payload_type);
}

func CodegenSemanticEnumPayloadFree(
    facts: SemanticAstEnumFacts,
    enum_name: String
) -> Bool {
    let variant_count: Int = CodegenSemanticEnumVariantCount(
        facts, enum_name
    );
    let variant_index: Int = 0;
    while variant_index < variant_count {
        if CodegenSemanticEnumVariantParamCountAtOrDie(
            facts, enum_name, variant_index
        ) != 0 {
            return false;
        }
        variant_index = variant_index + 1;
    }
    return true;
}
