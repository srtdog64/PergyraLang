// Approved codegen view over semantic-owned expression graph rows.

import "../../semantic/ast_expression_surface_fact_owner.pgy";
import "../text/text_owner.pgy";

func CodegenSemanticExpressionGraphOrDie(
    facts: SemanticAstExpressionSurfaceFacts,
    node_id: Int,
    lane: Int
) -> SemanticExpressionGraphView {
    let graph: SemanticExpressionGraphView =
        SemanticAstExpressionGraphForNode(
            facts, node_id, lane
    );
    if !graph.ok {
        Die(Concat(
            "self-host codegen requires a semantic expression graph: node=",
            Concat(ToString(node_id), Concat(" lane=", ToString(lane)))
        ));
    }
    let graph_text: Option<String> = SemanticExpressionGraphNodeText(
        graph.graph, graph.root_id
    );
    let shape: SemanticAstExpressionShapeFact =
        SemanticAstExpressionShapeForNode(
            facts, node_id, lane
        );
    if !IsSome(graph_text) || !shape.ok ||
        UnwrapOption(graph_text) != shape.normalized_text {
        Die("semantic expression graph root does not match its surface row");
    }
    return graph;
}

func CodegenSemanticExpressionGraphIsTry(
    view: SemanticExpressionGraphView
) -> Bool {
    if !view.ok { return false; }
    let kind: Option<Int> = SemanticExpressionGraphNodeKind(
        view.graph, view.root_id
    );
    return IsSome(kind) && UnwrapOption(kind) == AstExpressionNodeTry();
}

func CodegenSemanticTryOperandNodeOrDie(
    view: SemanticExpressionGraphView
) -> Int {
    if !CodegenSemanticExpressionGraphIsTry(view) {
        Die("self-host codegen requires a semantic try-expression graph");
    }
    let operand: Option<Int> = SemanticExpressionGraphLeftChild(
        view.graph, view.root_id
    );
    if !IsSome(operand) {
        Die("semantic try-expression operand edge is missing");
    }
    return UnwrapOption(operand);
}
