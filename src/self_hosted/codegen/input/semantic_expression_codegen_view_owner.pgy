// Approved codegen view over semantic-owned expression shape rows.

import "../../semantic/ast_expression_surface_fact_owner.pgy";

func CodegenSemanticAtomExpressionShapeOrDie(
    facts: SemanticAstExpressionSurfaceFacts,
    node_id: Int
) -> SemanticAstExpressionShapeFact {
    let shape: SemanticAstExpressionShapeFact =
        SemanticAstExpressionShapeForNode(
            facts, node_id, AstExpressionLaneAtom()
        );
    if !shape.ok {
        Die("self-host codegen requires a semantic atom-expression shape");
    }
    return shape;
}

func CodegenSemanticValueExpressionShapeOrDie(
    facts: SemanticAstExpressionSurfaceFacts,
    node_id: Int
) -> SemanticAstExpressionShapeFact {
    let shape: SemanticAstExpressionShapeFact =
        SemanticAstExpressionShapeForNode(
            facts, node_id, AstExpressionLaneValue()
        );
    if !shape.ok {
        Die("self-host codegen requires a semantic value-expression shape");
    }
    return shape;
}

func CodegenSemanticExpressionGraphOrDie(
    facts: SemanticAstExpressionSurfaceFacts,
    node_id: Int,
    lane: Int
) -> SemanticExpressionGraphView {
    let graph: SemanticExpressionGraphView =
        SemanticAstExpressionGraphForNode(
            facts, node_id, lane
        );
    if !graph.ok {
        Die("self-host codegen requires a semantic expression graph");
    }
    let graph_text: Option<String> = SemanticExpressionGraphNodeText(
        graph.graph, graph.root_id
    );
    let shape: SemanticAstExpressionShapeFact =
        SemanticAstExpressionShapeForNode(
            facts, node_id, lane
        );
    if !IsSome(graph_text) || !shape.ok ||
        UnwrapOption(graph_text) != shape.normalized_text {
        Die("semantic expression graph root does not match its surface row");
    }
    return graph;
}
