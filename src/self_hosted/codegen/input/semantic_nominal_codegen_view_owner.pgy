func CodegenSemanticNominalFieldKindOrDie(
    facts: SemanticAstNominalConstructorFacts,
    constructor_index: Int,
    field_index: Int
) -> String {
    let kind: Option<String> = SemanticAstNominalConstructorFieldKindAt(
        facts, constructor_index, field_index
    );
    if !IsSome(kind) {
        Die("semantic nominal declaration field-kind fact missing");
    }
    return UnwrapOption(kind);
}

func CodegenSemanticNominalsRequireProjectionReadyBool(
    facts: SemanticAstNominalConstructorFacts
) -> Bool {
    let nominal_index: Int = 0;
    while nominal_index < SemanticAstNominalConstructorCount(facts) {
        let field_index: Int = 0;
        while field_index < CodegenSemanticNominalFieldCountOrDie(
            facts, nominal_index
        ) {
            let kind: String = CodegenSemanticNominalFieldKindOrDie(
                facts, nominal_index, field_index
            );
            if kind == NominalFieldKindObjectSlot() ||
                kind == NominalFieldKindTObjectSlot() {
                return true;
            }
            field_index = field_index + 1;
        }
        nominal_index = nominal_index + 1;
    }
    return false;
}

func CodegenSemanticNominalFieldIsConstructorArgumentOrDie(
    facts: SemanticAstNominalConstructorFacts,
    constructor_index: Int,
    field_index: Int
) -> Bool {
    if constructor_index < 0 ||
        constructor_index >= SemanticAstNominalConstructorCount(facts) ||
        field_index < 0 ||
        field_index >= CodegenSemanticNominalFieldCountOrDie(
            facts, constructor_index
        ) {
        Die("semantic nominal constructor-argument field index is invalid");
    }
    return SemanticAstNominalConstructorFieldIsArgument(
        facts, constructor_index, field_index
    );
}

