// Fail-closed codegen view over semantic-owned nominal declaration rows.

import "../../semantic/ast_nominal_constructor_fact_owner.pgy";
import "../../semantic/nominal_constructor_argument_policy_owner.pgy";
import "../text/text_owner.pgy";

func CodegenSemanticNominalIs(
    facts: SemanticAstNominalConstructorFacts,
    node_id: Int
) -> Bool {
    return IsSome(SemanticAstNominalConstructorIndexForNode(facts, node_id));
}

func CodegenSemanticNominalNameOrDie(
    facts: SemanticAstNominalConstructorFacts,
    constructor_index: Int
) -> String {
    let name: Option<String> = SemanticAstNominalConstructorNameAt(
        facts, constructor_index
    );
    if !IsSome(name) {
        Die("semantic nominal declaration name fact missing");
    }
    return UnwrapOption(name);
}

func CodegenSemanticNominalFieldCountOrDie(
    facts: SemanticAstNominalConstructorFacts,
    constructor_index: Int
) -> Int {
    let count: Option<Int> = SemanticAstNominalConstructorFieldCountAt(
        facts, constructor_index
    );
    if !IsSome(count) {
        Die("semantic nominal declaration field-count fact missing");
    }
    return UnwrapOption(count);
}

func CodegenSemanticNominalFieldNameOrDie(
    facts: SemanticAstNominalConstructorFacts,
    constructor_index: Int,
    field_index: Int
) -> String {
    let name: Option<String> = SemanticAstNominalConstructorFieldNameAt(
        facts, constructor_index, field_index
    );
    if !IsSome(name) {
        Die("semantic nominal declaration field-name fact missing");
    }
    return UnwrapOption(name);
}

func CodegenSemanticNominalFieldTypeOrDie(
    facts: SemanticAstNominalConstructorFacts,
    constructor_index: Int,
    field_index: Int
) -> String {
    let type_name: Option<String> = SemanticAstNominalConstructorFieldTypeAt(
        facts, constructor_index, field_index
    );
    if !IsSome(type_name) {
        Die("semantic nominal declaration field-type fact missing");
    }
    return UnwrapOption(type_name);
}

func CodegenSemanticNominalFieldIsConstructorArgumentOrDie(
    facts: SemanticAstNominalConstructorFacts,
    constructor_index: Int,
    field_index: Int
) -> Bool {
    if constructor_index < 0 ||
        constructor_index >= SemanticAstNominalConstructorCount(facts) ||
        field_index < 0 ||
        field_index >= CodegenSemanticNominalFieldCountOrDie(
            facts, constructor_index
        ) {
        Die("semantic nominal constructor-argument field index is invalid");
    }
    return SemanticAstNominalConstructorFieldIsArgument(
        facts, constructor_index, field_index
    );
}

func CodegenSemanticNominalRoleSlotCountOrDie(
    facts: SemanticAstNominalConstructorFacts,
    constructor_index: Int
) -> Int {
    let count: Option<Int> = SemanticAstNominalRoleSlotCountAt(
        facts, constructor_index
    );
    if !IsSome(count) {
        Die("semantic party role-slot count fact missing");
    }
    return UnwrapOption(count);
}

func CodegenSemanticNominalRoleSlotNameOrDie(
    facts: SemanticAstNominalConstructorFacts,
    constructor_index: Int,
    slot_index: Int
) -> String {
    let name: Option<String> = SemanticAstNominalRoleSlotNameAt(
        facts, constructor_index, slot_index
    );
    if !IsSome(name) { Die("semantic party role-slot name fact missing"); }
    return UnwrapOption(name);
}

func CodegenSemanticNominalRoleSlotTypeOrDie(
    facts: SemanticAstNominalConstructorFacts,
    constructor_index: Int,
    slot_index: Int
) -> String {
    let type_name: Option<String> = SemanticAstNominalRoleSlotTypeAt(
        facts, constructor_index, slot_index
    );
    if !IsSome(type_name) {
        Die("semantic party role-slot ability fact missing");
    }
    return UnwrapOption(type_name);
}
