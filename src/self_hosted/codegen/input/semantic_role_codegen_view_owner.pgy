// Fail-closed codegen view over semantic-owned role declaration rows.

import "../../semantic/ast_role_fact_owner.pgy";

func CodegenSemanticRoleNameOrDie(
    facts: SemanticAstRoleFacts,
    role_index: Int
) -> String {
    let value: Option<String> = SemanticAstRoleNameAt(facts, role_index);
    if !IsSome(value) { Die("semantic role name fact missing"); }
    return UnwrapOption(value);
}

func CodegenSemanticRoleTargetTypeOrDie(
    facts: SemanticAstRoleFacts,
    role_index: Int
) -> String {
    let value: Option<String> = SemanticAstRoleTargetTypeAt(facts, role_index);
    if !IsSome(value) { Die("semantic role target-type fact missing"); }
    return UnwrapOption(value);
}

func CodegenSemanticRoleMethodCountOrDie(
    facts: SemanticAstRoleFacts,
    role_index: Int
) -> Int {
    let value: Option<Int> = SemanticAstRoleMethodCountAt(facts, role_index);
    if !IsSome(value) { Die("semantic role method-count fact missing"); }
    return UnwrapOption(value);
}

func CodegenSemanticRoleMethodNodeOrDie(
    facts: SemanticAstRoleFacts,
    role_index: Int,
    method_index: Int
) -> Int {
    let value: Option<Int> = SemanticAstRoleMethodNodeAt(
        facts, role_index, method_index
    );
    if !IsSome(value) { Die("semantic role method-node fact missing"); }
    return UnwrapOption(value);
}

func CodegenSemanticRoleReceiverType(
    facts: SemanticAstRoleFacts,
    method_node_id: Int
) -> Option<String> {
    return SemanticAstRoleTargetTypeForMethodNode(facts, method_node_id);
}
