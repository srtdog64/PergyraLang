// Codegen fail-closed view over semantic function signature facts.

import "../../semantic/ast_signature_fact_owner.pgy";
import "ast_arena_codegen_view_owner.pgy";

func CodegenSemanticSignatureIndexOrDie(
    facts: SemanticAstFunctionSignatureFacts,
    function_node_id: Int
) -> Int {
    let index: Option<Int> = SemanticAstFunctionSignatureIndexForNode(
        facts, function_node_id
    );
    if !IsSome(index) {
        Die(Concat(
            "semantic signature facts missing function node: ",
            ToString(function_node_id)
        ));
    }
    return UnwrapOption(index);
}

func CodegenSemanticFunctionOwnerOrDie(
    facts: SemanticAstFunctionSignatureFacts,
    signature_index: Int
) -> String {
    let owner: Option<String> = SemanticAstFunctionOwnerNameAt(
        facts, signature_index
    );
    if !IsSome(owner) {
        Die("semantic signature facts missing function owner");
    }
    return UnwrapOption(owner);
}

func CodegenSemanticFunctionRuntimeCallableOrDie(
    facts: SemanticAstFunctionSignatureFacts,
    signature_index: Int
) -> Bool {
    let runtime_callable: Option<Bool> =
        SemanticAstFunctionRuntimeCallableAt(facts, signature_index);
    if !IsSome(runtime_callable) {
        Die("semantic signature facts missing runtime-callable classification");
    }
    return UnwrapOption(runtime_callable);
}

