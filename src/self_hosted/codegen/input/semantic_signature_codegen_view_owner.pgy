// Codegen fail-closed view over semantic function signature facts.

import "../../semantic/ast_signature_fact_owner.pgy";
import "../text/text_owner.pgy";
import "ast_arena_codegen_view_owner.pgy";

func CodegenSemanticFunctionIs(
    facts: SemanticAstFunctionSignatureFacts,
    node_id: Int
) -> Bool {
    return IsSome(SemanticAstFunctionSignatureIndexForNode(facts, node_id));
}

func CodegenSemanticSignatureIndexOrDie(
    facts: SemanticAstFunctionSignatureFacts,
    function_node_id: Int
) -> Int {
    let index: Option<Int> = SemanticAstFunctionSignatureIndexForNode(
        facts, function_node_id
    );
    if !IsSome(index) {
        Die(Concat(
            "semantic signature facts missing function node: ",
            ToString(function_node_id)
        ));
    }
    return UnwrapOption(index);
}

func CodegenSemanticFunctionNodeOrDie(
    facts: SemanticAstFunctionSignatureFacts,
    signature_index: Int
) -> Int {
    let node: Option<Int> = SemanticAstFunctionNodeAt(facts, signature_index);
    if !IsSome(node) {
        Die("semantic signature facts missing function node");
    }
    return UnwrapOption(node);
}

