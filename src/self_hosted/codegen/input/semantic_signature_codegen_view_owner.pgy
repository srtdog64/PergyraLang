func CodegenSemanticFunctionParamNodeOrDie(
    facts: SemanticAstFunctionSignatureFacts,
    signature_index: Int,
    parameter_index: Int
) -> Int {
    let node: Option<Int> = SemanticAstFunctionParamNodeAt(
        facts, signature_index, parameter_index
    );
    if !IsSome(node) {
        Die("semantic signature facts missing parameter node");
    }
    return UnwrapOption(node);
}

func CodegenSemanticFunctionParamNameOrDie(
    facts: SemanticAstFunctionSignatureFacts,
    signature_index: Int,
    parameter_index: Int
) -> String {
    let name: Option<String> = SemanticAstFunctionParamNameAt(
        facts, signature_index, parameter_index
    );
    if !IsSome(name) {
        Die("semantic signature facts missing parameter name");
    }
    return UnwrapOption(name);
}

func CodegenSemanticFunctionParamNameForNodeOrDie(
    facts: SemanticAstFunctionSignatureFacts,
    signature_index: Int,
    parameter_index: Int,
    expected_node_id: Int
) -> String {
    if CodegenSemanticFunctionParamNodeOrDie(
        facts, signature_index, parameter_index
    ) != expected_node_id {
        Die("semantic signature parameter row does not match AST traversal");
    }
    return CodegenSemanticFunctionParamNameOrDie(
        facts, signature_index, parameter_index
    );
}

