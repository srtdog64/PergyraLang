// Codegen projection over semantic-owned statement payload rows.

import "../../semantic/ast_statement_fact_owner.pgy";
import "../../semantic/ast_statement_type_fact_owner.pgy";
import "../../semantic/ast_statement_type_query_owner.pgy";
import "../text/text_owner.pgy";

func CodegenSemanticStatementTypeFactsReady(
    artifact: AstTreeArtifact,
    ref statements: SemanticAstStatementFacts,
    ref facts: SemanticAstStatementTypeFacts
) -> Bool {
    let count: Int = ArrayLength(statements.node_ids);
    if !facts.ok || facts.artifact_node_count != artifact.count ||
        !SemanticAstStatementTypeRowsReady(facts) ||
        !SemanticAstStatementTypesAllVerified(facts) ||
        ArrayLength(facts.node_ids) != count ||
        ArrayLength(facts.kind_tags) != count ||
        ArrayLength(facts.inferred_type_names) != count {
        return false;
    }
    let i: Int = 0;
    while i < count {
        if facts.node_ids[i] != statements.node_ids[i] ||
            facts.kind_tags[i] != statements.kind_tags[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func CodegenSemanticStatementIs(
    facts: SemanticAstStatementFacts,
    node_id: Int,
    expected_kind: Int
) -> Bool {
    let index_opt: Option<Int> = SemanticAstStatementIndexForNode(
        facts, node_id
    );
    return IsSome(index_opt) &&
        facts.kind_tags[UnwrapOption(index_opt)] == expected_kind;
}

func CodegenSemanticStatementIndexOrDie(
    facts: SemanticAstStatementFacts,
    node_id: Int,
    expected_kind: Int
) -> Int {
    let index_opt: Option<Int> = SemanticAstStatementIndexForNode(
        facts, node_id
    );
    if !IsSome(index_opt) {
        Die(Concat("missing semantic statement fact: ", ToString(node_id)));
    }
    let index: Int = UnwrapOption(index_opt);
    if facts.kind_tags[index] != expected_kind {
        Die(Concat("semantic statement kind mismatch: ", ToString(node_id)));
    }
    return index;
}

func CodegenSemanticStatementPayloadOrDie(
    facts: SemanticAstStatementFacts,
    node_id: Int,
    expected_kind: Int
) -> String {
    let index: Int = CodegenSemanticStatementIndexOrDie(
        facts, node_id, expected_kind
    );
    return facts.payload_texts[index];
}

func CodegenSemanticStatementInferredTypeOrDie(
    ref facts: SemanticAstStatementTypeFacts,
    node_id: Int,
    expected_kind: Int
) -> String {
    let type_name: Option<String> = SemanticAstStatementInferredTypeForNode(
        facts, node_id, expected_kind
    );
    if !IsSome(type_name) {
        Die(Concat(
            "missing semantic statement result type: ", ToString(node_id)
        ));
    }
    return UnwrapOption(type_name);
}

func CodegenSemanticReturnValueOrDie(facts: SemanticAstStatementFacts, node_id: Int) -> String {
    return CodegenSemanticStatementPayloadOrDie(facts, node_id, TypedAstKindValueReturnStmtTag());
}

func CodegenSemanticArrayPopTargetOrDie(facts: SemanticAstStatementFacts, node_id: Int) -> String {
    return CodegenSemanticStatementPayloadOrDie(facts, node_id, TypedAstKindArrayPopStmtTag());
}

