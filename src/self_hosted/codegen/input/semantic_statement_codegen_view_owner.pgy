    return CodegenSemanticStatementPayloadOrDie(facts, node_id, TypedAstKindBareCallStmtTag());
}

func CodegenSemanticForLoopVarOrDie(
    facts: SemanticAstStatementFacts, node_id: Int
) -> String {
    return CodegenSemanticStatementPayloadOrDie(
        facts, node_id, TypedAstKindForStmtTag()
    );
}

func CodegenSemanticForIndexOrDie(
    facts: SemanticAstStatementFacts, node_id: Int
) -> Int {
    return CodegenSemanticStatementIndexOrDie(
        facts, node_id, TypedAstKindForStmtTag()
    );
}

func CodegenSemanticForIsRange(
    facts: SemanticAstStatementFacts, node_id: Int
) -> Bool {
    let index: Int = CodegenSemanticForIndexOrDie(facts, node_id);
    return facts.auxiliary_texts[index] != "";
}

func CodegenSemanticForRangeStartOrDie(
    facts: SemanticAstStatementFacts, node_id: Int
) -> String {
    let index: Int = CodegenSemanticForIndexOrDie(facts, node_id);
    if facts.auxiliary_texts[index] == "" {
        Die(Concat("expected semantic range for statement: ", ToString(node_id)));
    }
    return facts.value_texts[index];
}

func CodegenSemanticForRangeEndOrDie(
    facts: SemanticAstStatementFacts, node_id: Int
) -> String {
    let index: Int = CodegenSemanticForIndexOrDie(facts, node_id);
    if facts.auxiliary_texts[index] == "" {
        Die(Concat("missing semantic range end: ", ToString(node_id)));
    }
    return facts.auxiliary_texts[index];
}

func CodegenSemanticForEachCollectionOrDie(
    facts: SemanticAstStatementFacts, node_id: Int
) -> String {
    let index: Int = CodegenSemanticForIndexOrDie(facts, node_id);
    if facts.auxiliary_texts[index] != "" {
        Die(Concat("expected semantic foreach statement: ", ToString(node_id)));
    }
    return facts.value_texts[index];
}
