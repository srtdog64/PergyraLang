// Codegen projection over semantic-owned statement payload rows.

import "../../semantic/ast_statement_fact_owner.pgy";

func CodegenSemanticStatementIs(
    facts: SemanticAstStatementFacts,
    node_id: Int,
    expected_kind: Int
) -> Bool {
    let index_opt: Option<Int> = SemanticAstStatementIndexForNode(
        facts, node_id
    );
    return IsSome(index_opt) &&
        facts.kind_tags[UnwrapOption(index_opt)] == expected_kind;
}

func CodegenSemanticStatementIndexOrDie(
    facts: SemanticAstStatementFacts,
    node_id: Int,
    expected_kind: Int
) -> Int {
    let index_opt: Option<Int> = SemanticAstStatementIndexForNode(
        facts, node_id
    );
    if !IsSome(index_opt) {
        Die(Concat("missing semantic statement fact: ", ToString(node_id)));
    }
    let index: Int = UnwrapOption(index_opt);
    if facts.kind_tags[index] != expected_kind {
        Die(Concat("semantic statement kind mismatch: ", ToString(node_id)));
    }
    return index;
}

func CodegenSemanticStatementPayloadOrDie(
    facts: SemanticAstStatementFacts,
    node_id: Int,
    expected_kind: Int
) -> String {
    let index: Int = CodegenSemanticStatementIndexOrDie(
        facts, node_id, expected_kind
    );
    return facts.payload_texts[index];
}

func CodegenSemanticLogArgumentOrDie(facts: SemanticAstStatementFacts, node_id: Int) -> String {
    return CodegenSemanticStatementPayloadOrDie(facts, node_id, TypedAstKindLogStmtTag());
}

func CodegenSemanticReturnValueOrDie(facts: SemanticAstStatementFacts, node_id: Int) -> String {
    return CodegenSemanticStatementPayloadOrDie(facts, node_id, TypedAstKindValueReturnStmtTag());
}

func CodegenSemanticArrayPopTargetOrDie(facts: SemanticAstStatementFacts, node_id: Int) -> String {
    return CodegenSemanticStatementPayloadOrDie(facts, node_id, TypedAstKindArrayPopStmtTag());
}

