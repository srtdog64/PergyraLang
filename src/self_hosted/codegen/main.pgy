// src/self_hosted/codegen/main.pgy
//
// Status: rung-0/1/2/3/4 (2026-06-17). First Pergyra-origin C codegen
// substitute, and the first hard compiler-core substitution opened after the
// 2026-06-17 BDFL freeze lift (see docs/self_hosted/README.md).
//
// Input:  a text file containing `pgy --ast <src>` output (path via Args()[0]).
// Output: a self-contained C program on stdout whose run-stdout matches the
//         C/LLVM oracle for the supported subset.
//
// Supported subset (anything else is an observable Exit(1), never a silent
// fallback -- CLAUDE.md s1.1):
//   - one or more `Int`/`String`/`Void` functions; exactly one is `Main`.
//     Each emits a C function; non-Main get forward declarations (call order
//     and recursion are free); `Main` lowers to `int main(void)`.
//       * `Int`    param -> `long long`,    return -> `long long`
//       * `String` param -> `const char*`,  return -> `char*`
//   - body statements:
//       * `Log(<strexpr>)`                       (rung-0/4)
//       * `Log(ToString(<intexpr>))`             (rung-1)
//       * `Let: <name> : Int|String = <expr>`    (rung-1/4)
//       * `Assign: <name> = <expr>`              (rung-2/4, routed by var type)
//       * `While: (<cond>) { ... }`              (rung-2)
//       * `If: (<cond>) Then { ... } [Else { ... }]` (rung-2)
//       * `Return: <expr>` / bare `Return:`      (rung-3/4, routed by ret type)
//   - <intexpr>/<cond>: C-compatible parenthesized infix the AST printer emits
//     (identifiers, integer literals, + - * / %, comparisons, && ||, and
//     `Name(args)` calls). `Int` = C `long long`.
//   - <strexpr>: string-literal | `Concat(<strexpr>, <strexpr>)` | string-typed
//     identifier | string-returning call. `Concat` lowers to a runtime
//     `pgy_concat` (malloc + memcpy). String/Int routing for Assign/Log/Return
//     uses a per-function variable type environment plus a global function
//     return-type table. (No block scoping or string freeing yet -- run-stdout
//     parity only.)

func CharAt(s: String, i: Int) -> String {
    let n: Int = StringLength(s);
    if i < 0 {
        return "";
    }
    if i >= n {
        return "";
    }
    return Substring(s, i, 1);
}

// Index of the next '\n' at or after `start`, or StringLength(s) if none.
func NextNewline(s: String, start: Int) -> Int {
    let n: Int = StringLength(s);
    let i: Int = start;
    while i < n {
        if CharAt(s, i) == "\n" {
            return i;
        }
        i = i + 1;
    }
    return n;
}

// True when `s` starts with `prefix`.
func StartsWith(s: String, prefix: String) -> Bool {
    let pn: Int = StringLength(prefix);
    if StringLength(s) < pn {
        return false;
    }
    return Substring(s, 0, pn) == prefix;
}

func Die(msg: String) -> Void {
    Log(Concat("CODEGEN ERROR: ", msg));
    Exit(1);
}

func IsIdentChar(c: String) -> Bool {
    if StringLength(c) != 1 {
        return false;
    }
    let chars: String = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
    return StringIndexOf(chars, c) >= 0;
}

// True when `e` is a single bare identifier (alnum/underscore, first non-digit).
func IsIdentifier(e: String) -> Bool {
    let n: Int = StringLength(e);
    if n == 0 {
        return false;
    }
    let digits: String = "0123456789";
    if StringIndexOf(digits, CharAt(e, 0)) >= 0 {
        return false;
    }
    let i: Int = 0;
    while i < n {
        if !IsIdentChar(CharAt(e, i)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func IsIdentStart(c: String) -> Bool {
    if StringLength(c) != 1 {
        return false;
    }
    let chars: String = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_";
    return StringIndexOf(chars, c) >= 0;
}

// Given the index of a '[' in `s`, return the index of its matching ']',
// respecting nesting and string literals. Returns -1 if unmatched.
func FindMatchingBracket(s: String, open_idx: Int) -> Int {
    let n: Int = StringLength(s);
    let i: Int = open_idx;
    let depth: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CharAt(s, i);
        if in_str {
            if c == "\\" {
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
        } else if c == "[" {
            depth = depth + 1;
        } else if c == "]" {
            depth = depth - 1;
            if depth == 0 {
                return i;
            }
        }
        i = i + 1;
    }
    return -1;
}

// Given the index of a '(' in `s`, return the index of its matching ')',
// respecting nested parens and string literals. Returns -1 if unmatched.
func FindMatchingParen(s: String, open_idx: Int) -> Int {
    let n: Int = StringLength(s);
    let i: Int = open_idx;
    let depth: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CharAt(s, i);
        if in_str {
            if c == "\\" {
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
        } else if c == "(" {
            depth = depth + 1;
        } else if c == ")" {
            depth = depth - 1;
            if depth == 0 {
                return i;
            }
        }
        i = i + 1;
    }
    return -1;
}

// True when `e` is a single call `Name(args...)` whose closing paren is the
// last character (so it is one call, not `f() + g()`).
func IsSingleCall(e: String) -> Bool {
    let n: Int = StringLength(e);
    if n == 0 || CharAt(e, n - 1) != ")" {
        return false;
    }
    let op: Int = StringIndexOf(e, "(");
    if op <= 0 {
        return false;
    }
    let prefix: String = Substring(e, 0, op);
    if !IsIdentifier(prefix) {
        return false;
    }
    return FindMatchingParen(e, op) == n - 1;
}

// Within `s`, find the index of the top-level comma (depth 0, not inside a
// string literal). Returns -1 if none. `s` is the argument list interior of
// a Concat(...) call, e.g. `"a", "b"` or `"a", Concat("b", "c")`.
func FindTopLevelComma(s: String) -> Int {
    let n: Int = StringLength(s);
    let i: Int = 0;
    let depth: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CharAt(s, i);
        if in_str {
            if c == "\\" {
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            i = i + 1;
            continue;
        }
        if c == "(" {
            depth = depth + 1;
            i = i + 1;
            continue;
        }
        if c == ")" {
            depth = depth - 1;
            i = i + 1;
            continue;
        }
        if c == "," && depth == 0 {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// ---- Type environment --------------------------------------------------
// The environment is a string of `name=kind:Type|` entries with a leading
// `|`, e.g. `|Greet=f:String|who=v:String|`. kind is `v` (variable) or `f`
// (function return). Lookups search for `|name=kind:` and read to the next
// `|`. Variables are flat per function (no block scoping); functions are
// global. This is enough for run-stdout parity on the supported subset.

func LookupKindType(env: String, name: String, kind: String) -> String {
    let needle: String = Concat("|", Concat(name, Concat("=", Concat(kind, ":"))));
    let idx: Int = StringIndexOf(env, needle);
    if idx < 0 {
        return "";
    }
    let start: Int = idx + StringLength(needle);
    let rest: String = Substring(env, start, StringLength(env) - start);
    let bar: Int = StringIndexOf(rest, "|");
    if bar < 0 {
        return rest;
    }
    return Substring(rest, 0, bar);
}

// Classify an expression as "String" or "Int" using the environment.
func ExprKind(expr: String, env: String) -> String {
    let e: String = StringTrim(expr);
    if StringLength(e) == 0 {
        return "Int";
    }
    if CharAt(e, 0) == "\"" {
        return "String";
    }
    if StartsWith(e, "Concat(") {
        return "String";
    }
    if StartsWith(e, "Substring(") {
        return "String";
    }
    if StartsWith(e, "ToString(") {
        return "String";
    }
    if StartsWith(e, "StringLength(") {
        return "Int";
    }
    if IsIdentifier(e) {
        let vt: String = LookupKindType(env, e, "v");
        if StringLength(vt) > 0 {
            return vt;
        }
        return "Int";
    }
    if IsSingleCall(e) {
        let op: Int = StringIndexOf(e, "(");
        let fname: String = Substring(e, 0, op);
        let ft: String = LookupKindType(env, fname, "f");
        if StringLength(ft) > 0 {
            return ft;
        }
        return "Int";
    }
    return "Int";
}

// Replace every occurrence of `from` with `to` in `s`.
func ReplaceAll(s: String, from: String, to: String) -> String {
    let fl: Int = StringLength(from);
    if fl == 0 {
        return s;
    }
    let n: Int = StringLength(s);
    let out: String = "";
    let i: Int = 0;
    while i < n {
        if i + fl <= n && Substring(s, i, fl) == from {
            out = Concat(out, to);
            i = i + fl;
        } else {
            out = Concat(out, CharAt(s, i));
            i = i + 1;
        }
    }
    return out;
}

// Rewrite `ArrayLength(<arr>)` to `pgy_ai_len(arr)` / `pgy_as_len(arr)` per the
// array's element type (rung-10 growable-array representation).
func RewriteArrayLengthEnv(e: String, env: String) -> String {
    let out: String = e;
    let guard: Int = 0;
    while guard < 64 {
        let idx: Int = StringIndexOf(out, "ArrayLength(");
        if idx < 0 {
            return out;
        }
        let open: Int = idx + 11;
        let close: Int = FindMatchingParen(out, open);
        if close < 0 {
            Die(Concat("malformed ArrayLength(...): ", out));
        }
        let arg: String = StringTrim(Substring(out, open + 1, close - open - 1));
        let kind: String = LookupKindType(env, arg, "v");
        let fn: String = "pgy_ai_len";
        if kind == "ArrayString" {
            fn = "pgy_as_len";
        }
        let repl: String = Concat(fn, Concat("(", Concat(arg, ")")));
        out = Concat(Substring(out, 0, idx), Concat(repl, Substring(out, close + 1, StringLength(out) - (close + 1))));
        guard = guard + 1;
    }
    return out;
}

// Rewrite array index reads `IDENT[<expr>]` to `pgy_ai_get(IDENT, <expr>)` /
// `pgy_as_get(IDENT, <expr>)` for array variables (rung-10). String literals
// are copied verbatim so a `[` inside a string is never touched. Non-array
// identifiers keep native `[...]` (defensive; should not occur in the subset).
func RewriteIndexing(e: String, env: String) -> String {
    let n: Int = StringLength(e);
    let out: String = "";
    let i: Int = 0;
    while i < n {
        let c: String = CharAt(e, i);
        if c == "\"" {
            out = Concat(out, c);
            i = i + 1;
            while i < n {
                let d: String = CharAt(e, i);
                out = Concat(out, d);
                i = i + 1;
                if d == "\\" {
                    if i < n {
                        out = Concat(out, CharAt(e, i));
                        i = i + 1;
                    }
                } else if d == "\"" {
                    i = i;
                    break;
                }
            }
        } else if IsIdentStart(c) {
            let j: Int = i;
            while j < n && IsIdentChar(CharAt(e, j)) {
                j = j + 1;
            }
            let ident: String = Substring(e, i, j - i);
            if j < n && CharAt(e, j) == "[" {
                let close: Int = FindMatchingBracket(e, j);
                if close < 0 {
                    Die(Concat("unmatched index bracket: ", e));
                }
                let inner: String = Substring(e, j + 1, close - j - 1);
                let inner_r: String = RewriteIndexing(inner, env);
                let kind: String = LookupKindType(env, ident, "v");
                if kind == "ArrayString" {
                    out = Concat(out, Concat("pgy_as_get(", Concat(ident, Concat(", ", Concat(inner_r, ")")))));
                } else if kind == "ArrayInt" {
                    out = Concat(out, Concat("pgy_ai_get(", Concat(ident, Concat(", ", Concat(inner_r, ")")))));
                } else {
                    out = Concat(out, Concat(ident, Concat("[", Concat(inner_r, "]"))));
                }
                i = close + 1;
            } else {
                out = Concat(out, ident);
                i = j;
            }
        } else {
            out = Concat(out, c);
            i = i + 1;
        }
    }
    return out;
}

// Rewrite a C expression: array length, then array indexing, then string
// builtin call-names to their runtime helpers. Environment-aware.
func RewriteExpr(e: String, env: String) -> String {
    let a: String = RewriteArrayLengthEnv(e, env);
    let b: String = RewriteIndexing(a, env);
    let c: String = ReplaceAll(b, "StringLength(", "pgy_strlen(");
    let d: String = ReplaceAll(c, "StringIndexOf(", "pgy_strindexof(");
    return ReplaceAll(d, "Substring(", "pgy_substr(");
}

// Emit a C integer-valued (or boolean) expression from the AST's parenthesized
// infix, with array/builtin rewrites applied.
func IntEval(expr: String, env: String) -> String {
    return RewriteExpr(expr, env);
}

// Emit a C string-valued (char*) expression for a <strexpr>. `Concat` lowers
// to a runtime `pgy_concat`; `Substring` to `pgy_substr`; array element reads
// to `pgy_as_get`; literals / identifiers / calls pass through.
func StrEval(expr: String, env: String) -> String {
    let e: String = StringTrim(expr);
    if StartsWith(e, "Concat(") {
        let n: Int = StringLength(e);
        if CharAt(e, n - 1) != ")" {
            Die(Concat("malformed Concat(...): ", e));
        }
        let inner: String = Substring(e, 7, n - 7 - 1);
        let comma: Int = FindTopLevelComma(inner);
        if comma < 0 {
            Die(Concat("Concat needs two arguments: ", e));
        }
        let a: String = Substring(inner, 0, comma);
        let b: String = Substring(inner, comma + 1, StringLength(inner) - (comma + 1));
        return Concat("pgy_concat(", Concat(StrEval(a, env), Concat(", ", Concat(StrEval(b, env), ")"))));
    }
    return RewriteExpr(e, env);
}

// Wrap a condition in C parens unless it is already a single parenthesized
// group. `(a > b)` stays as-is; `flag` becomes `(flag)`; `(a) && (b)` is
// wrapped to `((a) && (b))`.
func WrapCond(cond: String, env: String) -> String {
    let c: String = StringTrim(cond);
    let n: Int = StringLength(c);
    if n >= 2 && CharAt(c, 0) == "(" && CharAt(c, n - 1) == ")" && FindMatchingParen(c, 0) == n - 1 {
        return RewriteExpr(c, env);
    }
    return Concat("(", Concat(RewriteExpr(c, env), ")"));
}

// ---- Statement emitters ------------------------------------------------

// `Let: <name> : Int|String = <expr>`. Registers the variable's type into the
// environment box and emits a typed C declaration.
func EmitLet(line: String, env_box: Array<String>) -> String {
    let rest: String = Substring(line, 5, StringLength(line) - 5);
    let ci: Int = StringIndexOf(rest, " : ");
    if ci < 0 {
        Die(Concat("malformed Let (no type separator): ", line));
    }
    let name: String = Substring(rest, 0, ci);
    let after_name: String = Substring(rest, ci + 3, StringLength(rest) - (ci + 3));
    let ei: Int = StringIndexOf(after_name, " = ");
    if ei < 0 {
        Die(Concat("malformed Let (no initializer): ", line));
    }
    let type_name: String = Substring(after_name, 0, ei);
    let expr: String = Substring(after_name, ei + 3, StringLength(after_name) - (ei + 3));
    if type_name == "Int" {
        ArraySet(env_box, 0, Concat(env_box[0], Concat(name, "=v:Int|")));
        return Concat("long long ", Concat(name, Concat(" = ", Concat(IntEval(expr, env_box[0]), ";"))));
    }
    if type_name == "Bool" {
        ArraySet(env_box, 0, Concat(env_box[0], Concat(name, "=v:Bool|")));
        return Concat("bool ", Concat(name, Concat(" = ", Concat(IntEval(expr, env_box[0]), ";"))));
    }
    if type_name == "String" {
        ArraySet(env_box, 0, Concat(env_box[0], Concat(name, "=v:String|")));
        return Concat("const char* ", Concat(name, Concat(" = ", Concat(StrEval(expr, env_box[0]), ";"))));
    }
    if StartsWith(type_name, "Array<") {
        // rung-10: growable `Array<Int>` / `Array<String>` as a struct. A
        // `[a, b, c]` literal lowers to `new()` plus one `push` per element;
        // `[]` is just `new()`. `ArrayPush` later extends the same value.
        let c_type: String = "";
        let new_fn: String = "";
        let push_fn: String = "";
        let elem_kind: String = "";
        let is_str: Bool = false;
        if StringIndexOf(type_name, "Int") >= 0 {
            c_type = "pgy_ai";
            new_fn = "pgy_ai_new";
            push_fn = "pgy_ai_push";
            elem_kind = "ArrayInt";
        } else if StringIndexOf(type_name, "String") >= 0 {
            c_type = "pgy_as";
            new_fn = "pgy_as_new";
            push_fn = "pgy_as_push";
            elem_kind = "ArrayString";
            is_str = true;
        } else {
            Die(Concat("only Array<Int>/Array<String> supported, got: ", type_name));
        }
        let ex: String = StringTrim(expr);
        let exn: Int = StringLength(ex);
        if exn < 2 || CharAt(ex, 0) != "[" || CharAt(ex, exn - 1) != "]" {
            Die(Concat("array let needs a `[...]` literal initializer: ", expr));
        }
        ArraySet(env_box, 0, Concat(env_box[0], Concat(name, Concat("=v:", Concat(elem_kind, "|")))));
        let out: String = Concat(c_type, Concat(" ", Concat(name, Concat(" = ", Concat(new_fn, "();")))));
        let rem: String = StringTrim(Substring(ex, 1, exn - 2));
        while StringLength(rem) > 0 {
            let comma: Int = FindTopLevelComma(rem);
            let elem: String = "";
            if comma < 0 {
                elem = StringTrim(rem);
                rem = "";
            } else {
                elem = StringTrim(Substring(rem, 0, comma));
                rem = StringTrim(Substring(rem, comma + 1, StringLength(rem) - (comma + 1)));
            }
            if StringLength(elem) > 0 {
                let ev: String = IntEval(elem, env_box[0]);
                if is_str {
                    ev = StrEval(elem, env_box[0]);
                }
                out = Concat(out, Concat(" ", Concat(push_fn, Concat("(&", Concat(name, Concat(", ", Concat(ev, ");")))))));
            }
        }
        return out;
    }
    Die(Concat("unsupported let type (only Int/Bool/String/Array<Int>/Array<String>): ", type_name));
    return "";
}

// `Assign: <name> = <expr>`. Routes by the variable's recorded type.
func EmitAssign(line: String, env_box: Array<String>) -> String {
    let rest: String = Substring(line, 8, StringLength(line) - 8);
    let eq: Int = StringIndexOf(rest, " = ");
    if eq < 0 {
        Die(Concat("malformed Assign: ", line));
    }
    let name: String = Substring(rest, 0, eq);
    let expr: String = Substring(rest, eq + 3, StringLength(rest) - (eq + 3));
    let vt: String = LookupKindType(env_box[0], name, "v");
    if vt == "String" {
        return Concat(name, Concat(" = ", Concat(StrEval(expr, env_box[0]), ";")));
    }
    return Concat(name, Concat(" = ", Concat(IntEval(expr, env_box[0]), ";")));
}

// `Log(<expr>)`. Integer via `Log(ToString(...))` -> printf %lld; otherwise the
// argument is a string expression -> printf %s of its StrEval.
func EmitLog(inner: String, env: String) -> String {
    if StartsWith(inner, "ToString(") {
        let n: Int = StringLength(inner);
        if CharAt(inner, n - 1) != ")" {
            Die(Concat("malformed ToString(...): ", inner));
        }
        let arg: String = Substring(inner, 9, n - 9 - 1);
        return Concat("printf(\"%lld\\n\", (long long)(", Concat(IntEval(arg, env), "));"));
    }
    return Concat("printf(\"%s\\n\", ", Concat(StrEval(inner, env), ");"));
}

// `Return: <expr>` / bare `Return:`. String returns route through StrEval.
func EmitReturn(rexpr: String, cur_fn_ret: String, env: String) -> String {
    if StringLength(rexpr) == 0 {
        return "return;";
    }
    if cur_fn_ret == "String" {
        return Concat("return ", Concat(StrEval(rexpr, env), ";"));
    }
    return Concat("return ", Concat(IntEval(rexpr, env), ";"));
}

// Count the leading spaces of a raw (untrimmed) AST line.
func IndentOf(raw: String) -> Int {
    let n: Int = StringLength(raw);
    let i: Int = 0;
    while i < n && CharAt(raw, i) == " " {
        i = i + 1;
    }
    return i;
}

// Consume the line at cur[0], asserting its trimmed text equals `expected`.
func ExpectText(texts: Array<String>, count: Int, cur: Array<Int>, expected: String) -> Void {
    if cur[0] >= count {
        Die(Concat("expected `", Concat(expected, "` but reached end of AST")));
    }
    if texts[cur[0]] != expected {
        Die(Concat("expected `", Concat(expected, Concat("` but got: ", texts[cur[0]]))));
    }
    ArraySet(cur, 0, cur[0] + 1);
}

// Emit the C for a sequence of statements at AST indentation `stmt_indent`,
// starting at line cur[0]. `pad` is the C indentation prefix. `env_box` carries
// the mutable variable type environment; `cur_fn_ret` is the enclosing
// function's return type. Recurses for `while` / `if` bodies. Advances cur[0].
func EmitStmtList(indents: Array<Int>, texts: Array<String>, count: Int,
                  stmt_indent: Int, cur: Array<Int>, pad: String,
                  env_box: Array<String>, cur_fn_ret: String) -> String {
    let result: String = "";
    let inner_pad: String = Concat(pad, "    ");
    while cur[0] < count {
        let idx: Int = cur[0];
        let ind: Int = indents[idx];
        if ind < stmt_indent {
            return result;
        }
        if ind > stmt_indent {
            Die(Concat("unexpected over-indented AST line: ", texts[idx]));
        }
        let t: String = texts[idx];
        if StartsWith(t, "Let: ") {
            result = Concat(result, Concat(pad, Concat(EmitLet(t, env_box), "\n")));
            ArraySet(cur, 0, idx + 1);
        } else if StartsWith(t, "Assign: ") {
            result = Concat(result, Concat(pad, Concat(EmitAssign(t, env_box), "\n")));
            ArraySet(cur, 0, idx + 1);
        } else if StartsWith(t, "Log(") {
            if CharAt(t, StringLength(t) - 1) != ")" {
                Die(Concat("malformed Log statement: ", t));
            }
            let log_inner: String = StringTrim(Substring(t, 4, StringLength(t) - 4 - 1));
            result = Concat(result, Concat(pad, Concat(EmitLog(log_inner, env_box[0]), "\n")));
            ArraySet(cur, 0, idx + 1);
        } else if StartsWith(t, "Return:") {
            let rexpr: String = StringTrim(Substring(t, 7, StringLength(t) - 7));
            result = Concat(result, Concat(pad, Concat(EmitReturn(rexpr, cur_fn_ret, env_box[0]), "\n")));
            ArraySet(cur, 0, idx + 1);
        } else if StartsWith(t, "ArraySet(") {
            // `ArraySet(arr, idx, val)` -> `pgy_ai_set(&arr, idx, val);` (rung-10).
            let an: Int = StringLength(t);
            if CharAt(t, an - 1) != ")" {
                Die(Concat("malformed ArraySet(...): ", t));
            }
            let a_inner: String = Substring(t, 9, an - 9 - 1);
            let c1: Int = FindTopLevelComma(a_inner);
            if c1 < 0 {
                Die(Concat("ArraySet needs three arguments: ", t));
            }
            let a_arr: String = StringTrim(Substring(a_inner, 0, c1));
            let a_rest: String = Substring(a_inner, c1 + 1, StringLength(a_inner) - (c1 + 1));
            let c2: Int = FindTopLevelComma(a_rest);
            if c2 < 0 {
                Die(Concat("ArraySet needs three arguments: ", t));
            }
            let a_idx: String = StringTrim(Substring(a_rest, 0, c2));
            let a_val: String = StringTrim(Substring(a_rest, c2 + 1, StringLength(a_rest) - (c2 + 1)));
            let a_kind: String = LookupKindType(env_box[0], a_arr, "v");
            let set_fn: String = "pgy_ai_set";
            let a_rhs: String = IntEval(a_val, env_box[0]);
            if a_kind == "ArrayString" {
                set_fn = "pgy_as_set";
                a_rhs = StrEval(a_val, env_box[0]);
            }
            let set_stmt: String = Concat(set_fn, Concat("(&", Concat(a_arr, Concat(", ", Concat(IntEval(a_idx, env_box[0]), Concat(", ", Concat(a_rhs, ");")))))));
            result = Concat(result, Concat(pad, Concat(set_stmt, "\n")));
            ArraySet(cur, 0, idx + 1);
        } else if StartsWith(t, "ArrayPush(") {
            // `ArrayPush(arr, val)` -> `pgy_ai_push(&arr, val);` (rung-10).
            let pn2: Int = StringLength(t);
            if CharAt(t, pn2 - 1) != ")" {
                Die(Concat("malformed ArrayPush(...): ", t));
            }
            let p_inner: String = Substring(t, 10, pn2 - 10 - 1);
            let pc: Int = FindTopLevelComma(p_inner);
            if pc < 0 {
                Die(Concat("ArrayPush needs two arguments: ", t));
            }
            let p_arr: String = StringTrim(Substring(p_inner, 0, pc));
            let p_val: String = StringTrim(Substring(p_inner, pc + 1, StringLength(p_inner) - (pc + 1)));
            let p_kind: String = LookupKindType(env_box[0], p_arr, "v");
            let push_fn: String = "pgy_ai_push";
            let p_rhs: String = IntEval(p_val, env_box[0]);
            if p_kind == "ArrayString" {
                push_fn = "pgy_as_push";
                p_rhs = StrEval(p_val, env_box[0]);
            }
            let push_stmt: String = Concat(push_fn, Concat("(&", Concat(p_arr, Concat(", ", Concat(p_rhs, ");")))));
            result = Concat(result, Concat(pad, Concat(push_stmt, "\n")));
            ArraySet(cur, 0, idx + 1);
        } else if StartsWith(t, "Exit(") {
            // `Exit(N)` statement -> `exit(N);` (rung-9).
            let en: Int = StringLength(t);
            if CharAt(t, en - 1) != ")" {
                Die(Concat("malformed Exit(...): ", t));
            }
            let e_arg: String = StringTrim(Substring(t, 5, en - 5 - 1));
            result = Concat(result, Concat(pad, Concat("exit(", Concat(IntEval(e_arg, env_box[0]), ");\n"))));
            ArraySet(cur, 0, idx + 1);
        } else if t == "Break" {
            result = Concat(result, Concat(pad, "break;\n"));
            ArraySet(cur, 0, idx + 1);
        } else if t == "Continue" {
            result = Concat(result, Concat(pad, "continue;\n"));
            ArraySet(cur, 0, idx + 1);
        } else if StartsWith(t, "For: ") {
            // `For: i in 0..5` -> `for (long long i = 0; i < 5; i++) { ... }`.
            // The `..` range is exclusive of the upper bound (matches the oracle).
            let spec: String = Substring(t, 5, StringLength(t) - 5);
            let inpos: Int = StringIndexOf(spec, " in ");
            if inpos < 0 {
                Die(Concat("malformed For (no `in`): ", t));
            }
            let loop_var: String = Substring(spec, 0, inpos);
            let range: String = Substring(spec, inpos + 4, StringLength(spec) - (inpos + 4));
            let dotpos: Int = StringIndexOf(range, "..");
            if dotpos < 0 {
                Die(Concat("For range needs `..`: ", t));
            }
            let start_v: String = Substring(range, 0, dotpos);
            let end_v: String = Substring(range, dotpos + 2, StringLength(range) - (dotpos + 2));
            ArraySet(env_box, 0, Concat(env_box[0], Concat(loop_var, "=v:Int|")));
            let for_hdr: String = Concat("for (long long ", Concat(loop_var, Concat(" = ", Concat(IntEval(start_v, env_box[0]),
                Concat("; ", Concat(loop_var, Concat(" < ", Concat(IntEval(end_v, env_box[0]),
                Concat("; ", Concat(loop_var, "++) {\n"))))))))));
            result = Concat(result, Concat(pad, for_hdr));
            ArraySet(cur, 0, idx + 1);
            ExpectText(texts, count, cur, "Block:");
            result = Concat(result, EmitStmtList(indents, texts, count, stmt_indent + 4, cur, inner_pad, env_box, cur_fn_ret));
            result = Concat(result, Concat(pad, "}\n"));
        } else if StartsWith(t, "While: ") {
            let cond: String = WrapCond(Substring(t, 7, StringLength(t) - 7), env_box[0]);
            result = Concat(result, Concat(pad, Concat("while ", Concat(cond, " {\n"))));
            ArraySet(cur, 0, idx + 1);
            ExpectText(texts, count, cur, "Block:");
            result = Concat(result, EmitStmtList(indents, texts, count, stmt_indent + 4, cur, inner_pad, env_box, cur_fn_ret));
            result = Concat(result, Concat(pad, "}\n"));
        } else if StartsWith(t, "If: ") {
            let cond2: String = WrapCond(Substring(t, 4, StringLength(t) - 4), env_box[0]);
            result = Concat(result, Concat(pad, Concat("if ", Concat(cond2, " {\n"))));
            ArraySet(cur, 0, idx + 1);
            ExpectText(texts, count, cur, "Then:");
            ExpectText(texts, count, cur, "Block:");
            result = Concat(result, EmitStmtList(indents, texts, count, stmt_indent + 6, cur, inner_pad, env_box, cur_fn_ret));
            if cur[0] < count && texts[cur[0]] == "Else:" && indents[cur[0]] == stmt_indent + 2 {
                result = Concat(result, Concat(pad, "} else {\n"));
                ArraySet(cur, 0, cur[0] + 1);
                ExpectText(texts, count, cur, "Block:");
                result = Concat(result, EmitStmtList(indents, texts, count, stmt_indent + 6, cur, inner_pad, env_box, cur_fn_ret));
                result = Concat(result, Concat(pad, "}\n"));
            } else {
                result = Concat(result, Concat(pad, "}\n"));
            }
        } else {
            Die(Concat("unsupported AST line in supported subset: ", t));
        }
    }
    return result;
}

// C parameter type for a Pergyra type. `String` params are read-only.
func CParamType(type_name: String) -> String {
    if type_name == "Int" {
        return "long long";
    }
    if type_name == "Bool" {
        return "bool";
    }
    if type_name == "String" {
        return "const char*";
    }
    Die(Concat("unsupported parameter type (only Int/Bool/String): ", type_name));
    return "";
}

// C return type for a Pergyra type. `String` returns may be malloc'd buffers.
func CRetType(type_name: String) -> String {
    if type_name == "Int" {
        return "long long";
    }
    if type_name == "Bool" {
        return "bool";
    }
    if type_name == "String" {
        return "char*";
    }
    if type_name == "Void" {
        return "void";
    }
    Die(Concat("unsupported return type (only Int/Bool/String/Void): ", type_name));
    return "";
}

// Emit one function definition starting at the `Function: <Name>` line at
// cur[0]. Pushes the C prototype for non-Main functions into `protos`.
// `base_env` carries the global function return-type bindings.
func EmitFunction(indents: Array<Int>, texts: Array<String>, count: Int,
                  cur: Array<Int>, f_indent: Int, protos: Array<String>,
                  base_env: String) -> String {
    let head: String = texts[cur[0]];
    let name: String = Substring(head, 10, StringLength(head) - 10);
    ArraySet(cur, 0, cur[0] + 1);

    ExpectText(texts, count, cur, "Parameters:");
    let params: String = "";
    let param_n: Int = 0;
    let env_box: Array<String> = [base_env];
    while cur[0] < count && indents[cur[0]] == f_indent + 4 {
        let pline: String = texts[cur[0]];
        let pc: Int = StringIndexOf(pline, ": ");
        if pc < 0 {
            Die(Concat("malformed parameter: ", pline));
        }
        let p_name: String = Substring(pline, 0, pc);
        let p_type: String = Substring(pline, pc + 2, StringLength(pline) - (pc + 2));
        let c_param: String = Concat(CParamType(p_type), Concat(" ", p_name));
        if param_n == 0 {
            params = c_param;
        } else {
            params = Concat(params, Concat(", ", c_param));
        }
        ArraySet(env_box, 0, Concat(env_box[0], Concat(p_name, Concat("=v:", Concat(p_type, "|")))));
        param_n = param_n + 1;
        ArraySet(cur, 0, cur[0] + 1);
    }

    if cur[0] >= count || !StartsWith(texts[cur[0]], "Returns:") {
        Die("expected Returns: line after parameters");
    }
    let ret_line: String = texts[cur[0]];
    let ret_type: String = StringTrim(Substring(ret_line, 8, StringLength(ret_line) - 8));
    ArraySet(cur, 0, cur[0] + 1);

    ExpectText(texts, count, cur, "Body:");
    ExpectText(texts, count, cur, "Block:");
    let stmt_indent: Int = f_indent + 6;
    let body: String = EmitStmtList(indents, texts, count, stmt_indent, cur, "    ", env_box, ret_type);

    let is_main: Bool = name == "Main";
    let signature: String = "";
    if is_main {
        signature = "int main(void)";
    } else {
        let param_list: String = params;
        if param_n == 0 {
            param_list = "void";
        }
        signature = Concat(CRetType(ret_type), Concat(" ", Concat(name, Concat("(", Concat(param_list, ")")))));
        ArrayPush(protos, Concat(signature, ";"));
    }

    let tail: String = "}\n";
    if is_main {
        tail = "    return 0;\n}\n";
    }
    return Concat(signature, Concat("\n{\n", Concat(body, tail)));
}

// Build the global environment: `|Name=f:RetType|...` for every function, by
// pairing each `Function: Name` line with the next `Returns:` line.
func BuildFunctionEnv(indents: Array<Int>, texts: Array<String>, count: Int) -> String {
    let env: String = "|";
    let i: Int = 0;
    while i < count {
        if StartsWith(texts[i], "Function:") {
            let fname: String = Substring(texts[i], 10, StringLength(texts[i]) - 10);
            let j: Int = i + 1;
            let rtype: String = "Void";
            while j < count && !StartsWith(texts[j], "Function:") {
                if StartsWith(texts[j], "Returns:") {
                    rtype = StringTrim(Substring(texts[j], 8, StringLength(texts[j]) - 8));
                    j = count;
                } else {
                    j = j + 1;
                }
            }
            env = Concat(env, Concat(fname, Concat("=f:", Concat(rtype, "|"))));
        }
        i = i + 1;
    }
    return env;
}

func GenerateC(ast: String) -> String {
    let indents: Array<Int> = [];
    let texts: Array<String> = [];
    let total: Int = StringLength(ast);
    let pos: Int = 0;
    let main_count: Int = 0;
    while pos < total {
        let nl: Int = NextNewline(ast, pos);
        let raw_line: String = Substring(ast, pos, nl - pos);
        let trimmed: String = StringTrim(raw_line);
        if StringLength(trimmed) > 0 {
            ArrayPush(indents, IndentOf(raw_line));
            ArrayPush(texts, trimmed);
            if trimmed == "Function: Main" {
                main_count = main_count + 1;
            }
        }
        pos = nl + 1;
    }
    if main_count != 1 {
        Die(Concat("exactly one `Main` function is required; saw count=", ToString(main_count)));
    }

    let count: Int = ArrayLength(texts);
    let first_fn: Int = -1;
    let scan: Int = 0;
    while scan < count {
        if StartsWith(texts[scan], "Function:") {
            first_fn = scan;
            scan = count;
        } else {
            scan = scan + 1;
        }
    }
    if first_fn < 0 {
        Die("no function found in AST");
    }
    let f_indent: Int = indents[first_fn];
    let base_env: String = BuildFunctionEnv(indents, texts, count);

    let protos: Array<String> = [];
    let defs: String = "";
    let cur: Array<Int> = [first_fn];
    while cur[0] < count {
        if StartsWith(texts[cur[0]], "Function:") && indents[cur[0]] == f_indent {
            let def: String = EmitFunction(indents, texts, count, cur, f_indent, protos, base_env);
            defs = Concat(defs, Concat(def, "\n"));
        } else {
            ArraySet(cur, 0, cur[0] + 1);
        }
    }

    let proto_block: String = "";
    let pn: Int = ArrayLength(protos);
    let pi: Int = 0;
    while pi < pn {
        proto_block = Concat(proto_block, Concat(protos[pi], "\n"));
        pi = pi + 1;
    }
    if pn > 0 {
        proto_block = Concat(proto_block, "\n");
    }

    // String programs need the runtime string helpers; bool programs need
    // <stdbool.h>; array programs need the growable-array structs + stdlib;
    // int-only programs stay lean.
    let uses_str: Bool = StringIndexOf(ast, "String") >= 0
        || StringIndexOf(ast, "Concat(") >= 0
        || StringIndexOf(ast, "Substring(") >= 0;
    let uses_bool: Bool = StringIndexOf(ast, "Bool") >= 0;
    let uses_exit: Bool = StringIndexOf(ast, "Exit(") >= 0;
    let uses_array: Bool = StringIndexOf(ast, "Array<") >= 0
        || StringIndexOf(ast, "ArrayPush(") >= 0
        || StringIndexOf(ast, "ArrayLength(") >= 0
        || StringIndexOf(ast, "ArraySet(") >= 0;
    let need_stdlib: Bool = uses_str || uses_exit || uses_array;
    let header: String = "#include <stdio.h>\n";
    if uses_bool {
        header = Concat(header, "#include <stdbool.h>\n");
    }
    if need_stdlib {
        header = Concat(header, "#include <stdlib.h>\n");
    }
    if uses_str {
        header = Concat(header, "#include <string.h>\n");
    }
    header = Concat(header, "\n");
    if uses_array {
        header = Concat(header, "typedef struct { long long *data; long long len; long long cap; } pgy_ai;\n");
        header = Concat(header, "typedef struct { const char **data; long long len; long long cap; } pgy_as;\n\n");
        header = Concat(header, "static pgy_ai pgy_ai_new(void) { pgy_ai a; a.data = NULL; a.len = 0; a.cap = 0; return a; }\n");
        header = Concat(header, "static void pgy_ai_push(pgy_ai *a, long long v) {\n");
        header = Concat(header, "    if (a->len == a->cap) { a->cap = a->cap ? a->cap * 2 : 4; a->data = (long long *)realloc(a->data, (size_t)a->cap * sizeof(long long)); }\n");
        header = Concat(header, "    a->data[a->len++] = v;\n}\n");
        header = Concat(header, "static long long pgy_ai_get(pgy_ai a, long long i) { return a.data[i]; }\n");
        header = Concat(header, "static void pgy_ai_set(pgy_ai *a, long long i, long long v) { a->data[i] = v; }\n");
        header = Concat(header, "static long long pgy_ai_len(pgy_ai a) { return a.len; }\n\n");
        header = Concat(header, "static pgy_as pgy_as_new(void) { pgy_as a; a.data = NULL; a.len = 0; a.cap = 0; return a; }\n");
        header = Concat(header, "static void pgy_as_push(pgy_as *a, const char *v) {\n");
        header = Concat(header, "    if (a->len == a->cap) { a->cap = a->cap ? a->cap * 2 : 4; a->data = (const char **)realloc(a->data, (size_t)a->cap * sizeof(const char *)); }\n");
        header = Concat(header, "    a->data[a->len++] = v;\n}\n");
        header = Concat(header, "static const char *pgy_as_get(pgy_as a, long long i) { return a.data[i]; }\n");
        header = Concat(header, "static void pgy_as_set(pgy_as *a, long long i, const char *v) { a->data[i] = v; }\n");
        header = Concat(header, "static long long pgy_as_len(pgy_as a) { return a.len; }\n\n");
    }
    if uses_str {
        header = Concat(header, "static char *pgy_concat(const char *a, const char *b)\n{\n");
        header = Concat(header, "    size_t la = strlen(a);\n    size_t lb = strlen(b);\n");
        header = Concat(header, "    char *r = (char *)malloc(la + lb + 1);\n");
        header = Concat(header, "    memcpy(r, a, la);\n    memcpy(r + la, b, lb);\n    r[la + lb] = '\\0';\n");
        header = Concat(header, "    return r;\n}\n\n");
        header = Concat(header, "static long long pgy_strlen(const char *s)\n{\n");
        header = Concat(header, "    return (long long)strlen(s);\n}\n\n");
        header = Concat(header, "static char *pgy_substr(const char *s, long long start, long long len)\n{\n");
        header = Concat(header, "    char *r = (char *)malloc((size_t)len + 1);\n");
        header = Concat(header, "    memcpy(r, s + start, (size_t)len);\n    r[len] = '\\0';\n");
        header = Concat(header, "    return r;\n}\n\n");
        header = Concat(header, "static long long pgy_strindexof(const char *hay, const char *needle)\n{\n");
        header = Concat(header, "    const char *p = strstr(hay, needle);\n");
        header = Concat(header, "    if (p == NULL) { return -1; }\n");
        header = Concat(header, "    return (long long)(p - hay);\n}\n\n");
    }
    return Concat(header, Concat(proto_block, defs));
}

func Main() -> Void {
    let run_args: Array<String> = Args();
    let ast_path: String = "src/self_hosted/codegen/fixture/hello_ast.txt";
    if ArrayLength(run_args) > 0 {
        ast_path = run_args[0];
    }
    if !FileExists(ast_path) {
        Log(Concat("CODEGEN ERROR: AST file not found: ", ast_path));
        Exit(1);
    }
    let ast: String = ReadFile(ast_path);
    let c_source: String = GenerateC(ast);
    Log(c_source);
}
