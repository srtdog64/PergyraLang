// src/self_hosted/codegen/main.pgy
//
// Status: rung-0..15 (2026-06-17). First Pergyra-origin C codegen
// substitute, and the first hard compiler-core substitution opened after the
// 2026-06-17 BDFL freeze lift (see docs/self_hosted/README.md).
//
// Input:  a text file containing `pgy --ast <src>` output (path via Args()[0]).
// Output: a self-contained C program on stdout whose run-stdout matches the
//         C/LLVM oracle for the supported subset.
//
// Supported subset (anything else is an observable Exit(1), never a silent
// fallback -- CLAUDE.md s1.1):
//   - one or more `Int`/`Bool`/`String`/`Array<Int>`/`Array<String>`/`Void`
//     functions; exactly one is `Main`.
//     Each emits a C function; non-Main get forward declarations (call order
//     and recursion are free); `Main` lowers to `int main(void)`.
//       * `Int`    param -> `long long`,    return -> `long long`
//       * `String` param -> `const char*`,  return -> `char*`
//   - body statements:
//       * `Log(<strexpr>)`                       (rung-0/4)
//       * `Log(ToString(<intexpr>))`             (rung-1)
//       * `Let: <name> : Int|String = <expr>`    (rung-1/4)
//       * `Assign: <name> = <expr>`              (rung-2/4, routed by var type)
//       * `While: (<cond>) { ... }`              (rung-2)
//       * `If: (<cond>) Then { ... } [Else { ... }]` (rung-2)
//       * `Return: <expr>` / bare `Return:`      (rung-3/4, routed by ret type)
//   - <intexpr>/<cond>: C-compatible parenthesized infix the AST printer emits
//     (identifiers, integer literals, + - * / %, comparisons, && ||, and
//     `Name(args)` calls). `Int` = C `long long`.
//   - <strexpr>: string-literal | `Concat(<strexpr>, <strexpr>)` | string-typed
//     identifier | string-returning call. `Concat`, string helpers, file I/O,
//     arrays, Args(), and Int-field structs lower to small standalone C helpers.
//     String/Int/array/struct routing for Assign/Log/Return uses a per-function
//     variable type environment plus a global function return-type table. (No
//     block scoping or string freeing yet -- run-stdout parity only.)

func CharAt(s: String, i: Int) -> String {
    let n: Int = StringLength(s);
    if i < 0 {
        return "";
    }
    if i >= n {
        return "";
    }
    return Substring(s, i, 1);
}

// Index of the next '\n' at or after `start`, or StringLength(s) if none.
func NextNewline(s: String, start: Int) -> Int {
    let n: Int = StringLength(s);
    let i: Int = start;
    while i < n {
        if CharAt(s, i) == "\n" {
            return i;
        }
        i = i + 1;
    }
    return n;
}

// True when `s` starts with `prefix`.
func StartsWith(s: String, prefix: String) -> Bool {
    let pn: Int = StringLength(prefix);
    if StringLength(s) < pn {
        return false;
    }
    return Substring(s, 0, pn) == prefix;
}

func Die(msg: String) -> Void {
    Log(Concat("CODEGEN ERROR: ", msg));
    Exit(1);
}

func ContainsCallOutsideStrings(text: String, callee: String) -> Bool {
    let n: Int = StringLength(text);
    let needle: String = Concat(callee, "(");
    let m: Int = StringLength(needle);
    let i: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CharAt(text, i);
        if in_str {
            if c == "\\" {
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            i = i + 1;
            continue;
        }
        if m > 0 && i + m <= n && Substring(text, i, m) == needle {
            if i == 0 || !IsIdentChar(CharAt(text, i - 1)) {
                return true;
            }
        }
        i = i + 1;
    }
    return false;
}

func ContainsOutsideStrings(text: String, needle: String) -> Bool {
    let n: Int = StringLength(text);
    let m: Int = StringLength(needle);
    let i: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CharAt(text, i);
        if in_str {
            if c == "\\" {
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            i = i + 1;
            continue;
        }
        if m > 0 && i + m <= n && Substring(text, i, m) == needle {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func RejectUnsupportedCodegenBuiltins(ast: String) -> Void {
    if ContainsOutsideStrings(ast, "(?") {
        Die("unsupported try expression in self-host codegen subset");
    }
    if ContainsCallOutsideStrings(ast, "ArrayReverse") {
        Die("unsupported builtin in self-host codegen subset: ArrayReverse");
    }
}

func IsIdentChar(c: String) -> Bool {
    if StringLength(c) != 1 {
        return false;
    }
    let chars: String = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
    return StringIndexOf(chars, c) >= 0;
}

// True when `e` is a single bare identifier (alnum/underscore, first non-digit).
func IsIdentifier(e: String) -> Bool {
    let n: Int = StringLength(e);
    if n == 0 {
        return false;
    }
    let digits: String = "0123456789";
    if StringIndexOf(digits, CharAt(e, 0)) >= 0 {
        return false;
    }
    let i: Int = 0;
    while i < n {
        if !IsIdentChar(CharAt(e, i)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func IsIdentStart(c: String) -> Bool {
    if StringLength(c) != 1 {
        return false;
    }
    let chars: String = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_";
    return StringIndexOf(chars, c) >= 0;
}

// Given the index of a '[' in `s`, return the index of its matching ']',
// respecting nesting and string literals. Returns -1 if unmatched.
func FindMatchingBracket(s: String, open_idx: Int) -> Int {
    let n: Int = StringLength(s);
    let i: Int = open_idx;
    let depth: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CharAt(s, i);
        if in_str {
            if c == "\\" {
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
        } else if c == "[" {
            depth = depth + 1;
        } else if c == "]" {
            depth = depth - 1;
            if depth == 0 {
                return i;
            }
        }
        i = i + 1;
    }
    return -1;
}

// Given the index of a '(' in `s`, return the index of its matching ')',
// respecting nested parens and string literals. Returns -1 if unmatched.
func FindMatchingParen(s: String, open_idx: Int) -> Int {
    let n: Int = StringLength(s);
    let i: Int = open_idx;
    let depth: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CharAt(s, i);
        if in_str {
            if c == "\\" {
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
        } else if c == "(" {
            depth = depth + 1;
        } else if c == ")" {
            depth = depth - 1;
            if depth == 0 {
                return i;
            }
        }
        i = i + 1;
    }
    return -1;
}

// True when `e` is a single call `Name(args...)` whose closing paren is the
// last character (so it is one call, not `f() + g()`).
func IsSingleCall(e: String) -> Bool {
    let n: Int = StringLength(e);
    if n == 0 || CharAt(e, n - 1) != ")" {
        return false;
    }
    let op: Int = StringIndexOf(e, "(");
    if op <= 0 {
        return false;
    }
    let prefix: String = Substring(e, 0, op);
    if !IsIdentifier(prefix) {
        return false;
    }
    return FindMatchingParen(e, op) == n - 1;
}

// Within `s`, find the index of the top-level comma (depth 0, not inside a
// string literal). Returns -1 if none. `s` is the argument list interior of
// a Concat(...) call, e.g. `"a", "b"` or `"a", Concat("b", "c")`.
func FindTopLevelComma(s: String) -> Int {
    let n: Int = StringLength(s);
    let i: Int = 0;
    let depth: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CharAt(s, i);
        if in_str {
            if c == "\\" {
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            i = i + 1;
            continue;
        }
        if c == "(" {
            depth = depth + 1;
            i = i + 1;
            continue;
        }
        if c == ")" {
            depth = depth - 1;
            i = i + 1;
            continue;
        }
        if c == "," && depth == 0 {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// ---- Type environment --------------------------------------------------
// The environment is a string of `name=kind:Type|` entries with a leading
// `|`, e.g. `|Greet=f:String|who=v:String|`. kind is `v` (variable) or `f`
// (function return). Lookups search for `|name=kind:` and read to the next
// `|`. Variables are flat per function (no block scoping); functions are
// global. This is enough for run-stdout parity on the supported subset.

func LookupKindType(env: String, name: String, kind: String) -> String {
    let needle: String = Concat("|", Concat(name, Concat("=", Concat(kind, ":"))));
    let idx: Int = StringIndexOf(env, needle);
    if idx < 0 {
        return "";
    }
    let start: Int = idx + StringLength(needle);
    let rest: String = Substring(env, start, StringLength(env) - start);
    let bar: Int = StringIndexOf(rest, "|");
    if bar < 0 {
        return rest;
    }
    return Substring(rest, 0, bar);
}

func CsvAt(csv: String, want: Int) -> String {
    let i: Int = 0;
    let idx: Int = 0;
    let start: Int = 0;
    let n: Int = StringLength(csv);
    while i <= n {
        if i == n || CharAt(csv, i) == "," {
            if idx == want {
                return Substring(csv, start, i - start);
            }
            idx = idx + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

// Classify an expression as "String" or "Int" using the environment.
func ExprKind(expr: String, env: String) -> String {
    let e: String = StringTrim(expr);
    if StringLength(e) == 0 {
        return "Int";
    }
    if LookupKindType(env, e, "e") != "" {
        return "Int";
    }
    if CharAt(e, 0) == "\"" {
        return "String";
    }
    // A top-level `+` whose left operand is a string is string concatenation.
    let stripped: String = StripOuterParens(e);
    let plus: Int = FindTopLevelPlus(stripped);
    if plus >= 0 {
        let lhs: String = StringTrim(Substring(stripped, 0, plus));
        if ExprKind(lhs, env) == "String" {
            return "String";
        }
    }
    if StartsWith(e, "Concat(") {
        return "String";
    }
    if StartsWith(e, "Substring(") {
        return "String";
    }
    if StartsWith(e, "CharAtN(") {
        return "String";
    }
    if StartsWith(e, "CharCode(") {
        return "Int";
    }
    if StartsWith(e, "StringTrim(") {
        return "String";
    }
    if StartsWith(e, "StringJoin(") {
        return "String";
    }
    if StartsWith(e, "Join(") {
        return "String";
    }
    if StartsWith(e, "Split(") {
        return "ArrayString";
    }
    if StartsWith(e, "ArraySort(") {
        return "ArrayInt";
    }
    if StartsWith(e, "ArrayMap(") {
        return "ArrayInt";
    }
    if StartsWith(e, "ArrayFilter(") {
        return "ArrayInt";
    }
    if StartsWith(e, "Ok(") {
        return "ResultInt";
    }
    if StartsWith(e, "Err(") {
        return "ResultInt";
    }
    if StartsWith(e, "Unwrap(") {
        return "Int";
    }
    if StartsWith(e, "UnwrapOr(") {
        return "Int";
    }
    if StartsWith(e, "IsOk(") {
        return "Bool";
    }
    if StartsWith(e, "IsErr(") {
        return "Bool";
    }
    if StartsWith(e, "StringContains(") {
        return "Int";
    }
    if StartsWith(e, "ToInt(") {
        return "Int";
    }
    if StartsWith(e, "ToFloat(") {
        return "Float";
    }
    if StartsWith(e, "ReadFile(") {
        return "String";
    }
    if StartsWith(e, "DirWalk(") {
        return "ArrayString";
    }
    if StartsWith(e, "FileExists(") {
        return "Int";
    }
    if StartsWith(e, "FileOpen(") {
        return "Int";
    }
    if StartsWith(e, "FileRead(") {
        return "String";
    }
    if StartsWith(e, "Args(") {
        return "ArrayString";
    }
    let bracket: Int = StringIndexOf(e, "[");
    if bracket > 0 && CharAt(e, StringLength(e) - 1) == "]" {
        let arr_name: String = Substring(e, 0, bracket);
        let arr_kind: String = LookupKindType(env, arr_name, "v");
        if arr_kind == "ArrayString" {
            return "String";
        }
        if arr_kind == "ArrayInt" {
            return "Int";
        }
    }
    if StartsWith(e, "ToString(") {
        return "String";
    }
    if StartsWith(e, "StringLength(") {
        return "Int";
    }
    if StartsWith(e, "ToUpper(") {
        return "String";
    }
    if StartsWith(e, "ToLower(") {
        return "String";
    }
    if StartsWith(e, "StringReplace(") {
        return "String";
    }
    if StartsWith(e, "Abs(") {
        return "Int";
    }
    if StartsWith(e, "Min(") {
        return "Int";
    }
    if StartsWith(e, "Max(") {
        return "Int";
    }
    if StartsWith(e, "Sqrt(") {
        return "Float";
    }
    if StartsWith(e, "Pow(") {
        return "Float";
    }
    if StartsWith(e, "Floor(") {
        return "Float";
    }
    if StartsWith(e, "Ceil(") {
        return "Float";
    }
    if IsIdentifier(e) {
        let vt: String = LookupKindType(env, e, "v");
        if StringLength(vt) > 0 {
            return vt;
        }
        return "Int";
    }
    if IsSingleCall(e) {
        let op: Int = StringIndexOf(e, "(");
        let fname: String = Substring(e, 0, op);
        let ft: String = LookupKindType(env, fname, "f");
        if StringLength(ft) > 0 {
            return ft;
        }
        return "Int";
    }
    // Array element access `IDENT[...]`: element type follows the array's kind.
    let ob: Int = StringIndexOf(e, "[");
    if ob > 0 {
        let pfx: String = Substring(e, 0, ob);
        if IsIdentifier(pfx) && FindMatchingBracket(e, ob) == StringLength(e) - 1 {
            if LookupKindType(env, pfx, "v") == "ArrayString" {
                return "String";
            }
            return "Int";
        }
    }
    return "Int";
}

// Replace every occurrence of `from` with `to` in `s`.
func ReplaceAll(s: String, from: String, to: String) -> String {
    let fl: Int = StringLength(from);
    if fl == 0 {
        return s;
    }
    let n: Int = StringLength(s);
    let out: String = "";
    let i: Int = 0;
    while i < n {
        if i + fl <= n && Substring(s, i, fl) == from {
            out = Concat(out, to);
            i = i + fl;
        } else {
            out = Concat(out, CharAt(s, i));
            i = i + 1;
        }
    }
    return out;
}

// Like ReplaceAll, but never matches inside a C string literal -- so a builtin
// name that appears as *data* (e.g. the literal "ArrayLength(") is left alone.
// Needed once the emitter compiles code that manipulates builtin-name strings
// (e.g. the codegen tool itself).
func ReplaceAllOutsideStrings(s: String, from: String, to: String) -> String {
    let fl: Int = StringLength(from);
    if fl == 0 {
        return s;
    }
    let n: Int = StringLength(s);
    let out: String = "";
    let i: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CharAt(s, i);
        if in_str {
            out = Concat(out, c);
            if c == "\\" && i + 1 < n {
                out = Concat(out, CharAt(s, i + 1));
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            out = Concat(out, c);
            i = i + 1;
            continue;
        }
        // Word-boundary check: only replace `Name(` when it is not the suffix
        // of a longer identifier (e.g. don't rewrite `Args(` inside
        // `CompareCallArgs(`). The previous output char must not be ident-ish.
        let ol: Int = StringLength(out);
        let boundary_ok: Bool = ol == 0 || !IsIdentChar(CharAt(out, ol - 1));
        if boundary_ok && i + fl <= n && Substring(s, i, fl) == from {
            out = Concat(out, to);
            i = i + fl;
            continue;
        }
        out = Concat(out, c);
        i = i + 1;
    }
    return out;
}

// Rewrite `ArrayLength(<arr>)` to `pgy_ai_len(arr)` / `pgy_as_len(arr)` per the
// array's element type (rung-10 growable-array representation).
func RewriteArrayLengthEnv(e: String, env: String) -> String {
    let n: Int = StringLength(e);
    let out: String = "";
    let i: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CharAt(e, i);
        if in_str {
            out = Concat(out, c);
            if c == "\\" && i + 1 < n {
                out = Concat(out, CharAt(e, i + 1));
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            out = Concat(out, c);
            i = i + 1;
            continue;
        }
        if i + 12 <= n && Substring(e, i, 12) == "ArrayLength(" {
            let open: Int = i + 11;
            let close: Int = FindMatchingParen(e, open);
            if close < 0 {
                Die(Concat("malformed ArrayLength(...): ", e));
            }
            let arg: String = StringTrim(Substring(e, open + 1, close - open - 1));
            let kind: String = LookupKindType(env, arg, "v");
            let fn: String = "pgy_ai_len";
            if kind == "ArrayString" {
                fn = "pgy_as_len";
            }
            out = Concat(out, Concat(fn, Concat("(", Concat(arg, ")"))));
            i = close + 1;
            continue;
        }
        out = Concat(out, c);
        i = i + 1;
    }
    return out;
}

// Rewrite array index reads `IDENT[<expr>]` to `pgy_ai_get(IDENT, <expr>)` /
// `pgy_as_get(IDENT, <expr>)` for array variables (rung-10). String literals
// are copied verbatim so a `[` inside a string is never touched. Non-array
// identifiers keep native `[...]` (defensive; should not occur in the subset).
func RewriteIndexing(e: String, env: String) -> String {
    let n: Int = StringLength(e);
    let out: String = "";
    let i: Int = 0;
    while i < n {
        let c: String = CharAt(e, i);
        if c == "\"" {
            out = Concat(out, c);
            i = i + 1;
            while i < n {
                let d: String = CharAt(e, i);
                out = Concat(out, d);
                i = i + 1;
                if d == "\\" {
                    if i < n {
                        out = Concat(out, CharAt(e, i));
                        i = i + 1;
                    }
                } else if d == "\"" {
                    i = i;
                    break;
                }
            }
        } else if IsIdentStart(c) {
            let j: Int = i;
            while j < n && IsIdentChar(CharAt(e, j)) {
                j = j + 1;
            }
            let ident: String = Substring(e, i, j - i);
            if j < n && CharAt(e, j) == "[" {
                let close: Int = FindMatchingBracket(e, j);
                if close < 0 {
                    Die(Concat("unmatched index bracket: ", e));
                }
                let inner: String = Substring(e, j + 1, close - j - 1);
                let inner_r: String = RewriteIndexing(inner, env);
                let kind: String = LookupKindType(env, ident, "v");
                if kind == "ArrayString" {
                    out = Concat(out, Concat("pgy_as_get(", Concat(ident, Concat(", ", Concat(inner_r, ")")))));
                } else if kind == "ArrayInt" {
                    out = Concat(out, Concat("pgy_ai_get(", Concat(ident, Concat(", ", Concat(inner_r, ")")))));
                } else {
                    out = Concat(out, Concat(ident, Concat("[", Concat(inner_r, "]"))));
                }
                i = close + 1;
            } else {
                out = Concat(out, ident);
                i = j;
            }
        } else {
            out = Concat(out, c);
            i = i + 1;
        }
    }
    return out;
}

// Rewrite a C expression: array length, then array indexing, then string
// builtin call-names to their runtime helpers. Environment-aware.
// Find the index of a top-level two-char operator `op` (depth 0, outside string
// literals). Returns -1 if none.
func FindTopLevelOp2(s: String, op: String) -> Int {
    let n: Int = StringLength(s);
    let i: Int = 0;
    let depth: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CharAt(s, i);
        if in_str {
            if c == "\\" {
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            i = i + 1;
            continue;
        }
        if c == "(" || c == "[" {
            depth = depth + 1;
            i = i + 1;
            continue;
        }
        if c == ")" || c == "]" {
            depth = depth - 1;
            i = i + 1;
            continue;
        }
        if depth == 0 && i + 2 <= n && Substring(s, i, 2) == op {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// Recursively lower a boolean/comparison expression. The key job: a string
// `==` / `!=` must become `strcmp(a, b) == 0` / `!= 0` (C `==` on `char*`
// compares pointers). Int comparisons keep `==`. Operand expressions still flow
// through the token pipeline (RewriteTokens).
func RewriteBool(e: String, env: String) -> String {
    let s: String = StringTrim(e);
    let n: Int = StringLength(s);
    if n == 0 {
        return s;
    }
    // Fully parenthesized group -> recurse inside, keep the parens.
    if CharAt(s, 0) == "(" && FindMatchingParen(s, 0) == n - 1 {
        return Concat("(", Concat(RewriteBool(Substring(s, 1, n - 2), env), ")"));
    }
    // Lowest precedence first: `||`, then `&&`.
    let orp: Int = FindTopLevelOp2(s, "||");
    if orp >= 0 {
        let l: String = Substring(s, 0, orp);
        let r: String = Substring(s, orp + 2, n - (orp + 2));
        return Concat(RewriteBool(l, env), Concat(" || ", RewriteBool(r, env)));
    }
    let andp: Int = FindTopLevelOp2(s, "&&");
    if andp >= 0 {
        let l2: String = Substring(s, 0, andp);
        let r2: String = Substring(s, andp + 2, n - (andp + 2));
        return Concat(RewriteBool(l2, env), Concat(" && ", RewriteBool(r2, env)));
    }
    // Equality / inequality: rewrite to strcmp when an operand is a string.
    let eqp: Int = FindTopLevelOp2(s, "==");
    let nep: Int = FindTopLevelOp2(s, "!=");
    let cmpp: Int = eqp;
    let is_eq: Bool = true;
    if eqp < 0 || (nep >= 0 && nep < eqp) {
        cmpp = nep;
        is_eq = false;
    }
    if cmpp >= 0 {
        let lhs: String = StringTrim(Substring(s, 0, cmpp));
        let rhs: String = StringTrim(Substring(s, cmpp + 2, n - (cmpp + 2)));
        if ExprKind(lhs, env) == "String" || ExprKind(rhs, env) == "String" {
            let tail: String = ") == 0)";
            if !is_eq {
                tail = ") != 0)";
            }
            return Concat("(strcmp(", Concat(RewriteTokens(lhs, env), Concat(", ", Concat(RewriteTokens(rhs, env), tail))));
        }
    }
    return RewriteTokens(s, env);
}

func RewriteExpr(e: String, env: String) -> String {
    return RewriteBool(e, env);
}

func RewriteMemberCalls(e: String, env: String) -> String {
    let n: Int = StringLength(e);
    let out: String = "";
    let i: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CharAt(e, i);
        if in_str {
            out = Concat(out, c);
            if c == "\\" && i + 1 < n {
                out = Concat(out, CharAt(e, i + 1));
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            out = Concat(out, c);
            i = i + 1;
            continue;
        }
        if c == "." {
            let ol: Int = StringLength(out);
            let end: Int = ol;
            let start: Int = ol;
            while start > 0 && IsIdentChar(CharAt(out, start - 1)) {
                start = start - 1;
            }
            if start < end && i + 1 < n && IsIdentStart(CharAt(e, i + 1)) {
                let j: Int = i + 1;
                while j < n && IsIdentChar(CharAt(e, j)) {
                    j = j + 1;
                }
                if j < n && CharAt(e, j) == "(" {
                    let receiver: String = Substring(out, start, end - start);
                    let recv_type: String = LookupKindType(env, receiver, "v");
                    let method: String = Substring(e, i + 1, j - (i + 1));
                    let c_name: String = Concat(recv_type, Concat("_", method));
                    if StringLength(recv_type) > 0 && LookupKindType(env, c_name, "f") != "" {
                        let close: Int = FindMatchingParen(e, j);
                        let args: String = Substring(e, j + 1, close - j - 1);
                        out = Substring(out, 0, start);
                        out = Concat(out, Concat(c_name, Concat("(", receiver)));
                        if StringLength(StringTrim(args)) > 0 {
                            out = Concat(out, Concat(", ", args));
                        }
                        out = Concat(out, ")");
                        i = close + 1;
                        continue;
                    }
                }
            }
        }
        out = Concat(out, c);
        i = i + 1;
    }
    return out;
}

func RewriteEnumRefs(e: String, env: String) -> String {
    let n: Int = StringLength(e);
    let out: String = "";
    let i: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CharAt(e, i);
        if in_str {
            out = Concat(out, c);
            if c == "\\" && i + 1 < n {
                out = Concat(out, CharAt(e, i + 1));
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            out = Concat(out, c);
            i = i + 1;
            continue;
        }
        if c == "." {
            let ol: Int = StringLength(out);
            let end: Int = ol;
            let start: Int = ol;
            while start > 0 && IsIdentChar(CharAt(out, start - 1)) {
                start = start - 1;
            }
            if start < end && i + 1 < n && IsIdentStart(CharAt(e, i + 1)) {
                let j: Int = i + 1;
                while j < n && IsIdentChar(CharAt(e, j)) {
                    j = j + 1;
                }
                let receiver: String = Substring(out, start, end - start);
                let variant: String = Substring(e, i + 1, j - (i + 1));
                let key: String = Concat(receiver, Concat(".", variant));
                let value: String = LookupKindType(env, key, "e");
                if StringLength(value) > 0 {
                    out = Substring(out, 0, start);
                    out = Concat(out, value);
                    i = j;
                    continue;
                }
            }
        }
        out = Concat(out, c);
        i = i + 1;
    }
    return out;
}

// Rewrite a namespace-qualified call `NS.Func(...)` to the flattened C name
// `NS_Func(...)`. The parser flattens `namespace NS { func Func }` to a
// top-level `NS_Func` definition but renders calls in dotted form. A `.` that
// joins two identifiers and is followed (after the second identifier) by `(`
// is a qualified call; a `.` in `obj.field` (not followed by `(`) is left alone.
func RewriteQualifiedCalls(e: String) -> String {
    let n: Int = StringLength(e);
    let out: String = "";
    let i: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CharAt(e, i);
        if in_str {
            out = Concat(out, c);
            if c == "\\" && i + 1 < n {
                out = Concat(out, CharAt(e, i + 1));
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            out = Concat(out, c);
            i = i + 1;
            continue;
        }
        if c == "." {
            let ol: Int = StringLength(out);
            let prev_ok: Bool = ol > 0 && IsIdentChar(CharAt(out, ol - 1));
            let next_ok: Bool = i + 1 < n && IsIdentStart(CharAt(e, i + 1));
            if prev_ok && next_ok {
                let j: Int = i + 1;
                while j < n && IsIdentChar(CharAt(e, j)) {
                    j = j + 1;
                }
                if j < n && CharAt(e, j) == "(" {
                    out = Concat(out, "_");
                    i = i + 1;
                    continue;
                }
            }
        }
        out = Concat(out, c);
        i = i + 1;
    }
    return out;
}

func RewriteBoolLiterals(e: String) -> String {
    let n: Int = StringLength(e);
    let out: String = "";
    let i: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CharAt(e, i);
        if in_str {
            out = Concat(out, c);
            if c == "\\" && i + 1 < n {
                out = Concat(out, CharAt(e, i + 1));
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            out = Concat(out, c);
            i = i + 1;
            continue;
        }
        let prev_ok: Bool = i == 0 || !IsIdentChar(CharAt(e, i - 1));
        if prev_ok && i + 4 <= n && Substring(e, i, 4) == "true" {
            let next_true_ok: Bool = i + 4 == n || !IsIdentChar(CharAt(e, i + 4));
            if next_true_ok {
                out = Concat(out, "1");
                i = i + 4;
                continue;
            }
        }
        if prev_ok && i + 5 <= n && Substring(e, i, 5) == "false" {
            let next_false_ok: Bool = i + 5 == n || !IsIdentChar(CharAt(e, i + 5));
            if next_false_ok {
                out = Concat(out, "0");
                i = i + 5;
                continue;
            }
        }
        out = Concat(out, c);
        i = i + 1;
    }
    return out;
}

func RewriteTokens(e: String, env: String) -> String {
    let enumed: String = RewriteEnumRefs(e, env);
    let q0: String = RewriteMemberCalls(enumed, env);
    let q: String = RewriteQualifiedCalls(q0);
    let a: String = RewriteArrayLengthEnv(q, env);
    let b: String = RewriteIndexing(a, env);
    let c: String = ReplaceAllOutsideStrings(b, "StringLength(", "pgy_strlen(");
    let d0: String = ReplaceAllOutsideStrings(c, "StringContains(", "pgy_strcontains(");
    let d: String = ReplaceAllOutsideStrings(d0, "StringIndexOf(", "pgy_strindexof(");
    let f0: String = ReplaceAllOutsideStrings(d, "Split(", "pgy_split(");
    let f1: String = ReplaceAllOutsideStrings(f0, "ToInt(", "pgy_toint(");
    let f: String = ReplaceAllOutsideStrings(f1, "StringTrim(", "pgy_strtrim(");
    let f2: String = ReplaceAllOutsideStrings(f, "StringReplace(", "pgy_strreplace(");
    let f3: String = ReplaceAllOutsideStrings(f2, "ToUpper(", "pgy_toupper(");
    let f4: String = ReplaceAllOutsideStrings(f3, "ToLower(", "pgy_tolower(");
    let f5: String = ReplaceAllOutsideStrings(f4, "Abs(", "pgy_abs(");
    let f6: String = ReplaceAllOutsideStrings(f5, "Min(", "pgy_min(");
    let f7a: String = ReplaceAllOutsideStrings(f6, "Max(", "pgy_max(");
    let f7b: String = ReplaceAllOutsideStrings(f7a, "Sqrt(", "sqrt(");
    let f7c: String = ReplaceAllOutsideStrings(f7b, "Pow(", "pow(");
    let f7d: String = ReplaceAllOutsideStrings(f7c, "Floor(", "floor(");
    let f7e: String = ReplaceAllOutsideStrings(f7d, "Ceil(", "ceil(");
    let f7: String = ReplaceAllOutsideStrings(f7e, "Random(", "pgy_random(");
    let g: String = ReplaceAllOutsideStrings(f7, "FileExists(", "pgy_fexists(");
    let gw: String = ReplaceAllOutsideStrings(g, "WriteFile(", "pgy_writefile(");
    let go: String = ReplaceAllOutsideStrings(gw, "FileOpen(", "pgy_fopen(");
    let gwr: String = ReplaceAllOutsideStrings(go, "FileWrite(", "pgy_fwrite(");
    let gc: String = ReplaceAllOutsideStrings(gwr, "FileClose(", "pgy_fclose(");
    let gr: String = ReplaceAllOutsideStrings(gc, "FileRead(", "pgy_fread(");
    let gp: String = ReplaceAllOutsideStrings(gr, "Print(", "pgy_print(");
    let h0: String = ReplaceAllOutsideStrings(gp, "ReadFile(", "pgy_readfile(");
    let h: String = ReplaceAllOutsideStrings(h0, "DirWalk(", "pgy_dirwalk(");
    let k: String = ReplaceAllOutsideStrings(h, "Args(", "pgy_args(");
    let mc: String = ReplaceAllOutsideStrings(k, "CharCode(", "pgy_charcode(");
    let m0: String = ReplaceAllOutsideStrings(mc, "CharAtN(", "pgy_charatn(");
    let m: String = ReplaceAllOutsideStrings(m0, "Substring(", "pgy_substr(");
    let jn0: String = ReplaceAllOutsideStrings(m, "StringJoin(", "pgy_strjoin(");
    let jn: String = ReplaceAllOutsideStrings(jn0, "Join(", "pgy_strjoin(");
    let asort: String = ReplaceAllOutsideStrings(jn, "ArraySort(", "pgy_ai_sort(");
    let amap: String = ReplaceAllOutsideStrings(asort, "ArrayMap(", "pgy_ai_map(");
    let afilter: String = ReplaceAllOutsideStrings(amap, "ArrayFilter(", "pgy_ai_filter(");
    let rok: String = ReplaceAllOutsideStrings(afilter, "Ok(", "pgy_result_ok(");
    let rerr: String = ReplaceAllOutsideStrings(rok, "Err(", "pgy_result_err(");
    let risok: String = ReplaceAllOutsideStrings(rerr, "IsOk(", "pgy_result_is_ok(");
    let riserr: String = ReplaceAllOutsideStrings(risok, "IsErr(", "pgy_result_is_err(");
    let runwrapor: String = ReplaceAllOutsideStrings(riserr, "UnwrapOr(", "pgy_result_unwrap_or(");
    let runwrap: String = ReplaceAllOutsideStrings(runwrapor, "Unwrap(", "pgy_result_unwrap(");
    let tf: String = ReplaceAllOutsideStrings(runwrap, "ToFloat(", "atof(");
    let p: String = ReplaceAllOutsideStrings(tf, "ToString(", "pgy_tostr(");
    // `Concat(a, b)` -> `pgy_concat(a, b)` is a pure name rewrite (same args),
    // so it lowers recursively and inside arbitrary call arguments.
    return RewriteBoolLiterals(ReplaceAllOutsideStrings(p, "Concat(", "pgy_concat("));
}

// Emit a C integer-valued (or boolean) expression from the AST's parenthesized
// infix, with array/builtin rewrites applied.
func IntEval(expr: String, env: String) -> String {
    return RewriteExpr(expr, env);
}

// Emit a C string-valued (char*) expression for a <strexpr>. `Concat` lowers
// to a runtime `pgy_concat`; `Substring` to `pgy_substr`; array element reads
// to `pgy_as_get`; literals / identifiers / calls pass through.
// String-valued expressions now lower through the same `RewriteExpr` token
// pipeline as everything else -- `Concat` is a name rewrite (see RewriteExpr),
// so nested and call-argument occurrences lower correctly without special
// top-level parsing here.
// Strip redundant parentheses that wrap an entire expression. The AST printer
// fully parenthesizes infix (`(("a" + b) + "c")`), which would hide top-level
// operators behind depth > 0. Removes one wrapping layer at a time.
func StripOuterParens(e: String) -> String {
    let s: String = StringTrim(e);
    while StringLength(s) >= 2 && CharAt(s, 0) == "(" && FindMatchingParen(s, 0) == StringLength(s) - 1 {
        s = StringTrim(Substring(s, 1, StringLength(s) - 2));
    }
    return s;
}

// Find the first top-level single-char `+` (string-concatenation operator) in a
// string-valued expression: depth 0 (outside any (), []) and outside string
// literals. Returns -1 if none.
func FindTopLevelPlus(s: String) -> Int {
    let n: Int = StringLength(s);
    let i: Int = 0;
    let depth: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CharAt(s, i);
        if in_str {
            if c == "\\" {
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            i = i + 1;
            continue;
        }
        if c == "(" || c == "[" {
            depth = depth + 1;
            i = i + 1;
            continue;
        }
        if c == ")" || c == "]" {
            depth = depth - 1;
            i = i + 1;
            continue;
        }
        if depth == 0 && c == "+" {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// Emit a C string-valued (char*) expression. In a confirmed string context a
// top-level `+` is the concatenation operator (the operands are strings by
// construction), so it lowers to nested `pgy_concat(...)`. Everything else
// flows through the token pipeline.
func StrEval(expr: String, env: String) -> String {
    let e: String = StripOuterParens(expr);
    let p: Int = FindTopLevelPlus(e);
    if p >= 0 {
        let lhs: String = StringTrim(Substring(e, 0, p));
        let rhs: String = StringTrim(Substring(e, p + 1, StringLength(e) - (p + 1)));
        return Concat("pgy_concat(", Concat(StrEval(lhs, env), Concat(", ", Concat(StrEval(rhs, env), ")"))));
    }
    return RewriteExpr(StringTrim(expr), env);
}

// Wrap a condition in C parens unless it is already a single parenthesized
// group. `(a > b)` stays as-is; `flag` becomes `(flag)`; `(a) && (b)` is
// wrapped to `((a) && (b))`.
func WrapCond(cond: String, env: String) -> String {
    let c: String = StringTrim(cond);
    let n: Int = StringLength(c);
    if n >= 2 && CharAt(c, 0) == "(" && CharAt(c, n - 1) == ")" && FindMatchingParen(c, 0) == n - 1 {
        return RewriteExpr(c, env);
    }
    return Concat("(", Concat(RewriteExpr(c, env), ")"));
}

// ---- Statement emitters ------------------------------------------------

// `Let: <name> : Int|String = <expr>`. Registers the variable's type into the
// environment box and emits a typed C declaration.
func EmitLet(line: String, inout env_box: Array<String>) -> String {
    let rest: String = Substring(line, 5, StringLength(line) - 5);
    let ci: Int = StringIndexOf(rest, " : ");
    if ci < 0 {
        Die(Concat("malformed Let (no type separator): ", line));
    }
    let name: String = Substring(rest, 0, ci);
    let after_name: String = Substring(rest, ci + 3, StringLength(rest) - (ci + 3));
    let ei: Int = StringIndexOf(after_name, " = ");
    if ei < 0 {
        Die(Concat("malformed Let (no initializer): ", line));
    }
    let type_name: String = Substring(after_name, 0, ei);
    let expr: String = Substring(after_name, ei + 3, StringLength(after_name) - (ei + 3));
    if type_name == "Int" {
        ArraySet(env_box, 0, Concat(env_box[0], Concat(name, "=v:Int|")));
        return Concat("long long ", Concat(name, Concat(" = ", Concat(IntEval(expr, env_box[0]), ";"))));
    }
    if type_name == "Bool" {
        ArraySet(env_box, 0, Concat(env_box[0], Concat(name, "=v:Bool|")));
        return Concat("bool ", Concat(name, Concat(" = ", Concat(IntEval(expr, env_box[0]), ";"))));
    }
    if type_name == "Float" {
        ArraySet(env_box, 0, Concat(env_box[0], Concat(name, "=v:Float|")));
        return Concat("double ", Concat(name, Concat(" = ", Concat(RewriteExpr(expr, env_box[0]), ";"))));
    }
    if type_name == "String" {
        ArraySet(env_box, 0, Concat(env_box[0], Concat(name, "=v:String|")));
        return Concat("const char* ", Concat(name, Concat(" = ", Concat(StrEval(expr, env_box[0]), ";"))));
    }
    if StartsWith(type_name, "Array<") {
        // rung-10: growable `Array<Int>` / `Array<String>` as a struct. A
        // `[a, b, c]` literal lowers to `new()` plus one `push` per element;
        // `[]` is just `new()`. `ArrayPush` later extends the same value.
        let c_type: String = "";
        let new_fn: String = "";
        let push_fn: String = "";
        let elem_kind: String = "";
        let is_str: Bool = false;
        if StringIndexOf(type_name, "Int") >= 0 {
            c_type = "pgy_ai";
            new_fn = "pgy_ai_new";
            push_fn = "pgy_ai_push";
            elem_kind = "ArrayInt";
        } else if StringIndexOf(type_name, "String") >= 0 {
            c_type = "pgy_as";
            new_fn = "pgy_as_new";
            push_fn = "pgy_as_push";
            elem_kind = "ArrayString";
            is_str = true;
        } else {
            Die(Concat("only Array<Int>/Array<String> supported, got: ", type_name));
        }
        let ex: String = StringTrim(expr);
        let exn: Int = StringLength(ex);
        ArraySet(env_box, 0, Concat(env_box[0], Concat(name, Concat("=v:", Concat(elem_kind, "|")))));
        // Non-literal initializer (e.g. `Args()` or an array-returning call):
        // bind the array value directly.
        if exn < 1 || CharAt(ex, 0) != "[" {
            return Concat(c_type, Concat(" ", Concat(name, Concat(" = ", Concat(RewriteExpr(ex, env_box[0]), ";")))));
        }
        if CharAt(ex, exn - 1) != "]" {
            Die(Concat("malformed array literal initializer: ", expr));
        }
        let out: String = Concat(c_type, Concat(" ", Concat(name, Concat(" = ", Concat(new_fn, "();")))));
        let rem: String = StringTrim(Substring(ex, 1, exn - 2));
        while StringLength(rem) > 0 {
            let comma: Int = FindTopLevelComma(rem);
            let elem: String = "";
            if comma < 0 {
                elem = StringTrim(rem);
                rem = "";
            } else {
                elem = StringTrim(Substring(rem, 0, comma));
                rem = StringTrim(Substring(rem, comma + 1, StringLength(rem) - (comma + 1)));
            }
            if StringLength(elem) > 0 {
                let ev: String = IntEval(elem, env_box[0]);
                if is_str {
                    ev = StrEval(elem, env_box[0]);
                }
                out = Concat(out, Concat(" ", Concat(push_fn, Concat("(&", Concat(name, Concat(", ", Concat(ev, ");")))))));
            }
        }
        return out;
    }
    if StartsWith(type_name, "Result<") && StringIndexOf(type_name, "Int") >= 0 {
        ArraySet(env_box, 0, Concat(env_box[0], Concat(name, "=v:ResultInt|")));
        return Concat("pgy_result_int ", Concat(name, Concat(" = ", Concat(RewriteExpr(expr, env_box[0]), ";"))));
    }
    if LookupKindType(env_box[0], type_name, "s") == "struct" {
        // rung-14: struct-typed local from a `Name(f: v, ...)` literal or a
        // struct-returning call.
        ArraySet(env_box, 0, Concat(env_box[0], Concat(name, Concat("=v:", Concat(type_name, "|")))));
        return Concat(type_name, Concat(" ", Concat(name, Concat(" = ", Concat(EmitStructValue(expr, type_name, env_box[0]), ";")))));
    }
    Die(Concat("unsupported let type (only Int/Bool/String/Array/struct): ", type_name));
    return "";
}

// Emit a C struct-valued expression: a `Name(f: v, ...)` literal becomes a
// compound literal; anything else (e.g. a struct-returning call) passes through.
func EmitStructValue(expr: String, sname: String, env: String) -> String {
    let e: String = StringTrim(expr);
    if StartsWith(e, Concat(sname, "(")) {
        return EmitStructLit(e, env);
    }
    return RewriteExpr(e, env);
}

// Emit a C compound literal for a `Name(f: v, ...)` struct construction:
// `(Name){ .f = (v), ... }`. rung-14 struct fields are `Int`.
func EmitStructLit(expr: String, env: String) -> String {
    let e: String = StringTrim(expr);
    let op: Int = StringIndexOf(e, "(");
    if op <= 0 || CharAt(e, StringLength(e) - 1) != ")" {
        Die(Concat("malformed struct literal: ", expr));
    }
    let sname: String = Substring(e, 0, op);
    let close: Int = FindMatchingParen(e, op);
    let inner: String = Substring(e, op + 1, close - op - 1);
    let out: String = Concat("(", Concat(sname, "){ "));
    let rem: String = StringTrim(inner);
    let first: Bool = true;
    let field_pos: Int = 0;
    let field_names: String = LookupKindType(env, sname, "fields");
    while StringLength(rem) > 0 {
        let comma: Int = FindTopLevelComma(rem);
        let part: String = "";
        if comma < 0 {
            part = StringTrim(rem);
            rem = "";
        } else {
            part = StringTrim(Substring(rem, 0, comma));
            rem = StringTrim(Substring(rem, comma + 1, StringLength(rem) - (comma + 1)));
        }
        if StringLength(part) > 0 {
            let cp: Int = StringIndexOf(part, ": ");
            let fld: String = "";
            let val: String = "";
            if cp >= 0 {
                fld = Substring(part, 0, cp);
                val = Substring(part, cp + 2, StringLength(part) - (cp + 2));
            } else {
                fld = CsvAt(field_names, field_pos);
                val = part;
                if StringLength(fld) == 0 {
                    Die(Concat("struct positional initializer has no field fact: ", part));
                }
            }
            if !first {
                out = Concat(out, ", ");
            }
            out = Concat(out, Concat(".", Concat(fld, Concat(" = (", Concat(IntEval(val, env), ")")))));
            first = false;
            field_pos = field_pos + 1;
        }
    }
    return Concat(out, " }");
}

// `Assign: <name> = <expr>`. Routes by the variable's recorded type.
func EmitAssign(line: String, env_box: Array<String>) -> String {
    let rest: String = Substring(line, 8, StringLength(line) - 8);
    let eq: Int = StringIndexOf(rest, " = ");
    if eq < 0 {
        Die(Concat("malformed Assign: ", line));
    }
    let name: String = Substring(rest, 0, eq);
    let expr: String = Substring(rest, eq + 3, StringLength(rest) - (eq + 3));
    let vt: String = LookupKindType(env_box[0], name, "v");
    if vt == "String" {
        return Concat(name, Concat(" = ", Concat(StrEval(expr, env_box[0]), ";")));
    }
    if LookupKindType(env_box[0], vt, "s") == "struct" {
        return Concat(name, Concat(" = ", Concat(EmitStructValue(expr, vt, env_box[0]), ";")));
    }
    return Concat(name, Concat(" = ", Concat(IntEval(expr, env_box[0]), ";")));
}

// `Log(<expr>)`. Integer via `Log(ToString(...))` -> printf %lld; otherwise the
// argument is a string expression -> printf %s of its StrEval.
func EmitLog(inner: String, env: String) -> String {
    if StartsWith(inner, "ToString(") {
        let n: Int = StringLength(inner);
        if CharAt(inner, n - 1) != ")" {
            Die(Concat("malformed ToString(...): ", inner));
        }
        let arg: String = Substring(inner, 9, n - 9 - 1);
        return Concat("printf(\"%lld\\n\", (long long)(", Concat(IntEval(arg, env), "));"));
    }
    // `Log(x)` may log an Int/Bool value directly (not via ToString). Route by
    // the argument's type so an integer never gets printed with `%s`.
    if ExprKind(inner, env) == "Int" {
        return Concat("printf(\"%lld\\n\", (long long)(", Concat(IntEval(inner, env), "));"));
    }
    if ExprKind(inner, env) == "Float" {
        return Concat("printf(\"%f\\n\", (double)(", Concat(RewriteExpr(inner, env), "));"));
    }
    // String Log: the oracle strips all trailing newlines from the value and
    // then appends exactly one (`Log("c\n\n")` -> `c\n`), so route through the
    // pgy_log helper rather than a raw `printf("%s\n", ...)`.
    return Concat("pgy_log(", Concat(StrEval(inner, env), ");"));
}

// `Return: <expr>` / bare `Return:`. String returns route through StrEval.
func EmitReturn(rexpr: String, cur_fn_ret: String, env: String) -> String {
    if StringLength(rexpr) == 0 {
        return "return;";
    }
    if cur_fn_ret == "String" {
        return Concat("return ", Concat(StrEval(rexpr, env), ";"));
    }
    if StartsWith(cur_fn_ret, "Result<") && StringIndexOf(cur_fn_ret, "Int") >= 0 {
        return Concat("return ", Concat(RewriteExpr(rexpr, env), ";"));
    }
    if LookupKindType(env, cur_fn_ret, "s") == "struct" {
        return Concat("return ", Concat(EmitStructValue(rexpr, cur_fn_ret, env), ";"));
    }
    return Concat("return ", Concat(IntEval(rexpr, env), ";"));
}

// Count the leading spaces of a raw (untrimmed) AST line.
func IndentOf(raw: String) -> Int {
    let n: Int = StringLength(raw);
    let i: Int = 0;
    while i < n && CharAt(raw, i) == " " {
        i = i + 1;
    }
    return i;
}

// Consume the line at cur[0], asserting its trimmed text equals `expected`.
func ExpectText(texts: Array<String>, count: Int, inout cur: Array<Int>, expected: String) -> Void {
    if cur[0] >= count {
        Die(Concat("expected `", Concat(expected, "` but reached end of AST")));
    }
    if texts[cur[0]] != expected {
        Die(Concat("expected `", Concat(expected, Concat("` but got: ", texts[cur[0]]))));
    }
    ArraySet(cur, 0, cur[0] + 1);
}

// Emit the C for a sequence of statements at AST indentation `stmt_indent`,
// starting at line cur[0]. `pad` is the C indentation prefix. `env_box` carries
// the mutable variable type environment; `cur_fn_ret` is the enclosing
// function's return type. Recurses for `while` / `if` bodies. Advances cur[0].
func EmitStmtList(indents: Array<Int>, texts: Array<String>, count: Int,
                  stmt_indent: Int, inout cur: Array<Int>, pad: String,
                  inout env_box: Array<String>, cur_fn_ret: String) -> String {
    let result: String = "";
    let inner_pad: String = Concat(pad, "    ");
    while cur[0] < count {
        let idx: Int = cur[0];
        let ind: Int = indents[idx];
        if ind < stmt_indent {
            return result;
        }
        if ind > stmt_indent {
            Die(Concat("unexpected over-indented AST line: ", texts[idx]));
        }
        let t: String = texts[idx];
        if StartsWith(t, "Let: ") {
            result = Concat(result, Concat(pad, Concat(EmitLet(t, env_box), "\n")));
            ArraySet(cur, 0, idx + 1);
        } else if StartsWith(t, "Assign: ") {
            result = Concat(result, Concat(pad, Concat(EmitAssign(t, env_box), "\n")));
            ArraySet(cur, 0, idx + 1);
        } else if StartsWith(t, "Log(") {
            if CharAt(t, StringLength(t) - 1) != ")" {
                Die(Concat("malformed Log statement: ", t));
            }
            let log_inner: String = StringTrim(Substring(t, 4, StringLength(t) - 4 - 1));
            result = Concat(result, Concat(pad, Concat(EmitLog(log_inner, env_box[0]), "\n")));
            ArraySet(cur, 0, idx + 1);
        } else if t == "Return" {
            // Bare return (the AST printer omits the colon when there is no
            // value). The C form follows the *C* return type: void -> `return;`,
            // otherwise a typed default (Main lowers to `int main`, so its
            // cur_fn_ret is passed as "Int" -> `return 0;`).
            let bare: String = "return;";
            if cur_fn_ret == "String" {
                bare = "return \"\";";
            } else if cur_fn_ret != "Void" {
                bare = "return 0;";
            }
            result = Concat(result, Concat(pad, Concat(bare, "\n")));
            ArraySet(cur, 0, idx + 1);
        } else if StartsWith(t, "Return:") {
            let rexpr: String = StringTrim(Substring(t, 7, StringLength(t) - 7));
            result = Concat(result, Concat(pad, Concat(EmitReturn(rexpr, cur_fn_ret, env_box[0]), "\n")));
            ArraySet(cur, 0, idx + 1);
        } else if StartsWith(t, "ArraySet(") {
            // `ArraySet(arr, idx, val)` -> `pgy_ai_set(&arr, idx, val);` (rung-10).
            let an: Int = StringLength(t);
            if CharAt(t, an - 1) != ")" {
                Die(Concat("malformed ArraySet(...): ", t));
            }
            let a_inner: String = Substring(t, 9, an - 9 - 1);
            let c1: Int = FindTopLevelComma(a_inner);
            if c1 < 0 {
                Die(Concat("ArraySet needs three arguments: ", t));
            }
            let a_arr: String = StringTrim(Substring(a_inner, 0, c1));
            let a_rest: String = Substring(a_inner, c1 + 1, StringLength(a_inner) - (c1 + 1));
            let c2: Int = FindTopLevelComma(a_rest);
            if c2 < 0 {
                Die(Concat("ArraySet needs three arguments: ", t));
            }
            let a_idx: String = StringTrim(Substring(a_rest, 0, c2));
            let a_val: String = StringTrim(Substring(a_rest, c2 + 1, StringLength(a_rest) - (c2 + 1)));
            let a_kind: String = LookupKindType(env_box[0], a_arr, "v");
            let set_fn: String = "pgy_ai_set";
            let a_rhs: String = IntEval(a_val, env_box[0]);
            if a_kind == "ArrayString" {
                set_fn = "pgy_as_set";
                a_rhs = StrEval(a_val, env_box[0]);
            }
            let set_stmt: String = Concat(set_fn, Concat("(&", Concat(a_arr, Concat(", ", Concat(IntEval(a_idx, env_box[0]), Concat(", ", Concat(a_rhs, ");")))))));
            result = Concat(result, Concat(pad, Concat(set_stmt, "\n")));
            ArraySet(cur, 0, idx + 1);
        } else if StartsWith(t, "ArrayPush(") {
            // `ArrayPush(arr, val)` -> `pgy_ai_push(&arr, val);` (rung-10).
            let pn2: Int = StringLength(t);
            if CharAt(t, pn2 - 1) != ")" {
                Die(Concat("malformed ArrayPush(...): ", t));
            }
            let p_inner: String = Substring(t, 10, pn2 - 10 - 1);
            let pc: Int = FindTopLevelComma(p_inner);
            if pc < 0 {
                Die(Concat("ArrayPush needs two arguments: ", t));
            }
            let p_arr: String = StringTrim(Substring(p_inner, 0, pc));
            let p_val: String = StringTrim(Substring(p_inner, pc + 1, StringLength(p_inner) - (pc + 1)));
            let p_kind: String = LookupKindType(env_box[0], p_arr, "v");
            let push_fn: String = "pgy_ai_push";
            let p_rhs: String = IntEval(p_val, env_box[0]);
            if p_kind == "ArrayString" {
                push_fn = "pgy_as_push";
                p_rhs = StrEval(p_val, env_box[0]);
            }
            let push_stmt: String = Concat(push_fn, Concat("(&", Concat(p_arr, Concat(", ", Concat(p_rhs, ");")))));
            result = Concat(result, Concat(pad, Concat(push_stmt, "\n")));
            ArraySet(cur, 0, idx + 1);
        } else if StartsWith(t, "ArrayPop(") {
            // `ArrayPop(arr)` statement -> `pgy_ai_pop(&arr);` (drops the popped
            // value; element type by array kind).
            let qn: Int = StringLength(t);
            if CharAt(t, qn - 1) != ")" {
                Die(Concat("malformed ArrayPop(...): ", t));
            }
            let q_arr: String = StringTrim(Substring(t, 9, qn - 9 - 1));
            let q_kind: String = LookupKindType(env_box[0], q_arr, "v");
            let pop_fn: String = "pgy_ai_pop";
            if q_kind == "ArrayString" {
                pop_fn = "pgy_as_pop";
            }
            result = Concat(result, Concat(pad, Concat(pop_fn, Concat("(&", Concat(q_arr, ");\n")))));
            ArraySet(cur, 0, idx + 1);
        } else if StartsWith(t, "Exit(") {
            // `Exit(N)` statement -> `exit(N);` (rung-9).
            let en: Int = StringLength(t);
            if CharAt(t, en - 1) != ")" {
                Die(Concat("malformed Exit(...): ", t));
            }
            let e_arg: String = StringTrim(Substring(t, 5, en - 5 - 1));
            result = Concat(result, Concat(pad, Concat("exit(", Concat(IntEval(e_arg, env_box[0]), ");\n"))));
            ArraySet(cur, 0, idx + 1);
        } else if t == "Break" {
            result = Concat(result, Concat(pad, "break;\n"));
            ArraySet(cur, 0, idx + 1);
        } else if t == "Continue" {
            result = Concat(result, Concat(pad, "continue;\n"));
            ArraySet(cur, 0, idx + 1);
        } else if StartsWith(t, "For: ") {
            // `For: i in 0..5` -> `for (long long i = 0; i < 5; i++) { ... }`.
            // The `..` range is exclusive of the upper bound (matches the oracle).
            let spec: String = Substring(t, 5, StringLength(t) - 5);
            let inpos: Int = StringIndexOf(spec, " in ");
            if inpos < 0 {
                Die(Concat("malformed For (no `in`): ", t));
            }
            let loop_var: String = Substring(spec, 0, inpos);
            let range: String = Substring(spec, inpos + 4, StringLength(spec) - (inpos + 4));
            let dotpos: Int = StringIndexOf(range, "..");
            if dotpos >= 0 {
                // Range loop `for i in a..b` (exclusive upper bound).
                let start_v: String = Substring(range, 0, dotpos);
                let end_v: String = Substring(range, dotpos + 2, StringLength(range) - (dotpos + 2));
                ArraySet(env_box, 0, Concat(env_box[0], Concat(loop_var, "=v:Int|")));
                let for_hdr: String = Concat("for (long long ", Concat(loop_var, Concat(" = ", Concat(IntEval(start_v, env_box[0]),
                    Concat("; ", Concat(loop_var, Concat(" < ", Concat(IntEval(end_v, env_box[0]),
                    Concat("; ", Concat(loop_var, "++) {\n"))))))))));
                result = Concat(result, Concat(pad, for_hdr));
            } else {
                // For-each `for x in coll`: evaluate the collection once into a
                // temp, then index it. Element type follows the array kind.
                let coll: String = StringTrim(range);
                let ck: String = ExprKind(coll, env_box[0]);
                let arr_c: String = "pgy_ai";
                let elem_c: String = "long long";
                let get_fn: String = "pgy_ai_get";
                let len_fn: String = "pgy_ai_len";
                let elem_kind: String = "Int";
                if ck == "ArrayString" {
                    arr_c = "pgy_as";
                    elem_c = "const char*";
                    get_fn = "pgy_as_get";
                    len_fn = "pgy_as_len";
                    elem_kind = "String";
                }
                let tc: String = Concat("_pgyc_", loop_var);
                let ti: String = Concat("_pgyi_", loop_var);
                ArraySet(env_box, 0, Concat(env_box[0], Concat(loop_var, Concat("=v:", Concat(elem_kind, "|")))));
                result = Concat(result, Concat(pad, Concat(arr_c, Concat(" ", Concat(tc, Concat(" = ", Concat(RewriteExpr(coll, env_box[0]), ";\n")))))));
                result = Concat(result, Concat(pad, Concat("for (long long ", Concat(ti, Concat(" = 0; ", Concat(ti, Concat(" < ", Concat(len_fn, Concat("(", Concat(tc, Concat("); ", Concat(ti, "++) {\n"))))))))))));
                result = Concat(result, Concat(inner_pad, Concat(elem_c, Concat(" ", Concat(loop_var, Concat(" = ", Concat(get_fn, Concat("(", Concat(tc, Concat(", ", Concat(ti, ");\n")))))))))));
            }
            ArraySet(cur, 0, idx + 1);
            ExpectText(texts, count, cur, "Block:");
            result = Concat(result, EmitStmtList(indents, texts, count, stmt_indent + 4, cur, inner_pad, env_box, cur_fn_ret));
            result = Concat(result, Concat(pad, "}\n"));
        } else if StartsWith(t, "While: ") {
            let cond: String = WrapCond(Substring(t, 7, StringLength(t) - 7), env_box[0]);
            result = Concat(result, Concat(pad, Concat("while ", Concat(cond, " {\n"))));
            ArraySet(cur, 0, idx + 1);
            ExpectText(texts, count, cur, "Block:");
            result = Concat(result, EmitStmtList(indents, texts, count, stmt_indent + 4, cur, inner_pad, env_box, cur_fn_ret));
            result = Concat(result, Concat(pad, "}\n"));
        } else if StartsWith(t, "If: ") {
            let cond2: String = WrapCond(Substring(t, 4, StringLength(t) - 4), env_box[0]);
            result = Concat(result, Concat(pad, Concat("if ", Concat(cond2, " {\n"))));
            ArraySet(cur, 0, idx + 1);
            ExpectText(texts, count, cur, "Then:");
            ExpectText(texts, count, cur, "Block:");
            result = Concat(result, EmitStmtList(indents, texts, count, stmt_indent + 6, cur, inner_pad, env_box, cur_fn_ret));
            if cur[0] < count && texts[cur[0]] == "Else:" && indents[cur[0]] == stmt_indent + 2 {
                ArraySet(cur, 0, cur[0] + 1);
                if cur[0] < count && StartsWith(texts[cur[0]], "If: ") {
                    // `else if`: the AST nests an `If:` directly under `Else:`
                    // (no `Block:`). Emit `} else ` and recurse on that If at its
                    // own indent; the nested if-chain closes itself.
                    result = Concat(result, Concat(pad, "} else "));
                    result = Concat(result, EmitStmtList(indents, texts, count, indents[cur[0]], cur, pad, env_box, cur_fn_ret));
                } else {
                    result = Concat(result, Concat(pad, "} else {\n"));
                    ExpectText(texts, count, cur, "Block:");
                    result = Concat(result, EmitStmtList(indents, texts, count, stmt_indent + 6, cur, inner_pad, env_box, cur_fn_ret));
                    result = Concat(result, Concat(pad, "}\n"));
                }
            } else {
                result = Concat(result, Concat(pad, "}\n"));
            }
        } else if IsSingleCall(t) {
            // Bare function-call statement, e.g. `Die(Concat(...))` or a void
            // user call. Arguments lower through the same RewriteExpr pipeline.
            result = Concat(result, Concat(pad, Concat(RewriteExpr(t, env_box[0]), ";\n")));
            ArraySet(cur, 0, idx + 1);
        } else {
            Die(Concat("unsupported AST line in supported subset: ", t));
        }
    }
    return result;
}

// C parameter type for a Pergyra type. `String` params are read-only.
func CParamType(type_name: String, struct_env: String) -> String {
    if type_name == "Int" {
        return "long long";
    }
    if type_name == "Bool" {
        return "bool";
    }
    if type_name == "String" {
        return "const char*";
    }
    if StartsWith(type_name, "Array<") {
        if StringIndexOf(type_name, "Int") >= 0 {
            return "pgy_ai";
        }
        if StringIndexOf(type_name, "String") >= 0 {
            return "pgy_as";
        }
    }
    if StartsWith(type_name, "Result<") && StringIndexOf(type_name, "Int") >= 0 {
        return "pgy_result_int";
    }
    if LookupKindType(struct_env, type_name, "s") == "struct" {
        return type_name;
    }
    // Float params/returns are intentionally NOT supported: the codegen's Float
    // surface is locals + math builtins + Log only. Rejecting Float in
    // signatures keeps complex Float programs (Array<Float>, Float struct
    // fields) as a clean observable rejection rather than emitting broken C.
    Die(Concat("unsupported parameter type (only Int/Bool/String/Array/struct): ", type_name));
    return "";
}

// C return type for a Pergyra type. `String` returns may be malloc'd buffers.
func CRetType(type_name: String, struct_env: String) -> String {
    if type_name == "Int" {
        return "long long";
    }
    if type_name == "Bool" {
        return "bool";
    }
    if type_name == "String" {
        return "char*";
    }
    if type_name == "Void" {
        return "void";
    }
    if StartsWith(type_name, "Array<") {
        if StringIndexOf(type_name, "Int") >= 0 {
            return "pgy_ai";
        }
        if StringIndexOf(type_name, "String") >= 0 {
            return "pgy_as";
        }
    }
    if StartsWith(type_name, "Result<") && StringIndexOf(type_name, "Int") >= 0 {
        return "pgy_result_int";
    }
    if LookupKindType(struct_env, type_name, "s") == "struct" {
        return type_name;
    }
    Die(Concat("unsupported return type (only Int/Bool/String/Void/Array/struct): ", type_name));
    return "";
}

// Emit one function definition starting at the `Function: <Name>` line at
// cur[0]. `base_env` carries the global function return-type bindings.
func EmitFunction(indents: Array<Int>, texts: Array<String>, count: Int,
                  inout cur: Array<Int>, f_indent: Int,
                  base_env: String, uses_args: Bool, owner_name: String) -> String {
    let head: String = texts[cur[0]];
    let name: String = Substring(head, 10, StringLength(head) - 10);
    let c_name: String = name;
    if StringLength(owner_name) > 0 {
        c_name = Concat(owner_name, Concat("_", name));
    }
    ArraySet(cur, 0, cur[0] + 1);

    ExpectText(texts, count, cur, "Parameters:");
    let params: String = "";
    let param_n: Int = 0;
    let env_box: Array<String> = [base_env];
    while cur[0] < count && indents[cur[0]] == f_indent + 4 {
        let pline: String = texts[cur[0]];
        let pc: Int = StringIndexOf(pline, ": ");
        let p_name: String = "";
        let p_type: String = "";
        if pc < 0 && StringLength(owner_name) > 0 && pline == "self" {
            p_name = "self";
            p_type = owner_name;
        } else if pc < 0 {
            Die(Concat("malformed parameter: ", pline));
        } else {
            p_name = Substring(pline, 0, pc);
            p_type = Substring(pline, pc + 2, StringLength(pline) - (pc + 2));
        }
        let c_param: String = Concat(CParamType(p_type, base_env), Concat(" ", p_name));
        if param_n == 0 {
            params = c_param;
        } else {
            params = Concat(params, Concat(", ", c_param));
        }
        // Register the param under a canonical kind so array indexing/length
        // rewriting recognizes it (`Array<Int...>` -> ArrayInt, etc.).
        let p_kind: String = p_type;
        if StartsWith(p_type, "Array<") {
            if StringIndexOf(p_type, "Int") >= 0 {
                p_kind = "ArrayInt";
            } else if StringIndexOf(p_type, "String") >= 0 {
                p_kind = "ArrayString";
            }
        }
        ArraySet(env_box, 0, Concat(env_box[0], Concat(p_name, Concat("=v:", Concat(p_kind, "|")))));
        param_n = param_n + 1;
        ArraySet(cur, 0, cur[0] + 1);
    }

    if cur[0] >= count || !StartsWith(texts[cur[0]], "Returns:") {
        Die("expected Returns: line after parameters");
    }
    let ret_line: String = texts[cur[0]];
    let ret_type: String = StringTrim(Substring(ret_line, 8, StringLength(ret_line) - 8));
    ArraySet(cur, 0, cur[0] + 1);

    ExpectText(texts, count, cur, "Body:");
    ExpectText(texts, count, cur, "Block:");
    let stmt_indent: Int = f_indent + 6;
    let is_main: Bool = name == "Main";
    // Main lowers to `int main`, so a bare `return` inside it must be `return 0;`
    // -- emit its body with an Int return type.
    let body_ret: String = ret_type;
    if is_main {
        body_ret = "Int";
    }
    let body: String = EmitStmtList(indents, texts, count, stmt_indent, cur, "    ", env_box, body_ret);

    let signature: String = "";
    let body_full: String = body;
    if is_main {
        if uses_args {
            // Capture argv into globals so `Args()` (-> pgy_args) can read them.
            signature = "int main(int argc, char **argv)";
            body_full = Concat("    pgy_argc = argc;\n    pgy_argv = argv;\n", body);
        } else {
            signature = "int main(void)";
        }
    } else {
        let param_list: String = params;
        if param_n == 0 {
            param_list = "void";
        }
        signature = Concat(CRetType(ret_type, base_env), Concat(" ", Concat(c_name, Concat("(", Concat(param_list, ")")))));
    }

    let tail: String = "}\n";
    if is_main {
        tail = "    return 0;\n}\n";
    }
    return Concat(signature, Concat("\n{\n", Concat(body_full, tail)));
}

// Build the global environment: `|Name=f:RetType|...` for every function, by
// pairing each `Function: Name` line with the next `Returns:` line.
func BuildFunctionEnv(indents: Array<Int>, texts: Array<String>, count: Int) -> String {
    let env: String = "|";
    let i: Int = 0;
    let owner: String = "";
    let owner_indent: Int = -1;
    while i < count {
        if StringLength(owner) > 0 && indents[i] <= owner_indent {
            owner = "";
            owner_indent = -1;
        }
        if StartsWith(texts[i], "Class: ") {
            owner = Substring(texts[i], 7, StringLength(texts[i]) - 7);
            owner_indent = indents[i];
        }
        if StartsWith(texts[i], "Function:") {
            let fname: String = Substring(texts[i], 10, StringLength(texts[i]) - 10);
            let cname: String = fname;
            if StringLength(owner) > 0 && indents[i] > owner_indent {
                cname = Concat(owner, Concat("_", fname));
            }
            let j: Int = i + 1;
            let rtype: String = "Void";
            while j < count && !StartsWith(texts[j], "Function:") {
                if StartsWith(texts[j], "Returns:") {
                    rtype = StringTrim(Substring(texts[j], 8, StringLength(texts[j]) - 8));
                    j = count;
                } else {
                    j = j + 1;
                }
            }
            env = Concat(env, Concat(cname, Concat("=f:", Concat(rtype, "|"))));
        }
        i = i + 1;
    }
    return env;
}

// Scan top-level `Struct: Name` / `Class: Name` declarations into C typedefs,
// and append `Name=s:struct|Name=fields:a,b|` entries to env_box[0].
func CollectStructs(indents: Array<Int>, texts: Array<String>, count: Int, inout env_box: Array<String>) -> String {
    let typedefs: String = "";
    let i: Int = 0;
    while i < count {
        if StartsWith(texts[i], "Struct: ") || StartsWith(texts[i], "Class: ") {
            let prefix_len: Int = 8;
            if StartsWith(texts[i], "Class: ") {
                prefix_len = 7;
            }
            let sname: String = Substring(texts[i], prefix_len, StringLength(texts[i]) - prefix_len);
            let s_indent: Int = indents[i];
            let j: Int = i + 1;
            if j < count && texts[j] == "Fields:" {
                j = j + 1;
            }
            let fields_c: String = "";
            let field_names: String = "";
            while j < count && indents[j] == s_indent + 4 {
                let fl: String = texts[j];
                let cpos: Int = StringIndexOf(fl, ": ");
                if cpos < 0 {
                    Die(Concat("malformed struct field: ", fl));
                }
                let fname: String = Substring(fl, 0, cpos);
                let ftype: String = Substring(fl, cpos + 2, StringLength(fl) - (cpos + 2));
                let cfield_type: String = "long long";
                if ftype == "String" {
                    cfield_type = "const char *";
                } else if ftype != "Int" {
                    Die(Concat("struct/class fields must be Int/String, got: ", ftype));
                }
                if StringLength(field_names) == 0 {
                    field_names = fname;
                } else {
                    field_names = Concat(field_names, Concat(",", fname));
                }
                fields_c = Concat(fields_c, Concat("    ", Concat(cfield_type, Concat(" ", Concat(fname, ";\n")))));
                j = j + 1;
            }
            typedefs = Concat(typedefs, Concat("typedef struct {\n", Concat(fields_c, Concat("} ", Concat(sname, ";\n\n")))));
            ArraySet(env_box, 0, Concat(env_box[0], Concat(sname, "=s:struct|")));
            ArraySet(env_box, 0, Concat(env_box[0], Concat(sname, Concat("=fields:", Concat(field_names, "|")))));
        }
        i = i + 1;
    }
    return typedefs;
}

func CollectEnums(indents: Array<Int>, texts: Array<String>, count: Int, inout env_box: Array<String>) -> String {
    let block: String = "";
    let i: Int = 0;
    while i < count {
        if StartsWith(texts[i], "Enum: ") {
            let line: String = texts[i];
            let brace: Int = StringIndexOf(line, " { ");
            if brace < 0 || CharAt(line, StringLength(line) - 1) != "}" {
                Die(Concat("malformed enum declaration: ", line));
            }
            let ename: String = Substring(line, 6, brace - 6);
            let inner: String = StringTrim(Substring(line, brace + 3, StringLength(line) - (brace + 4)));
            let value: Int = 0;
            let rem: String = inner;
            let enum_c: String = "enum {\n";
            while StringLength(rem) > 0 {
                let comma: Int = FindTopLevelComma(rem);
                let part: String = "";
                if comma < 0 {
                    part = StringTrim(rem);
                    rem = "";
                } else {
                    part = StringTrim(Substring(rem, 0, comma));
                    rem = StringTrim(Substring(rem, comma + 1, StringLength(rem) - (comma + 1)));
                }
                if StringIndexOf(part, "(") >= 0 {
                    Die(Concat("payload enum variants are not supported in self-host codegen subset: ", part));
                }
                let cname: String = Concat(ename, Concat("_", part));
                enum_c = Concat(enum_c, Concat("    ", Concat(cname, Concat(" = ", Concat(ToString(value), ",\n")))));
                ArraySet(env_box, 0, Concat(env_box[0], Concat(ename, Concat(".", Concat(part, Concat("=e:", Concat(ToString(value), "|")))))));
                value = value + 1;
            }
            enum_c = Concat(enum_c, "};\n\n");
            block = Concat(block, enum_c);
        }
        i = i + 1;
    }
    return block;
}

// Build the C forward-declaration block for every non-Main function, in
// GenerateC's own scope. (A pre-pass is required because Pergyra arrays pass by
// value with a shared element buffer: `ArraySet` mutations persist across calls
// but `ArrayPush` growth does not -- so a callee cannot append to the caller's
// `protos`. Emitting prototypes here makes forward references compile.)
func CollectProtos(indents: Array<Int>, texts: Array<String>, count: Int, struct_env: String) -> String {
    let block: String = "";
    let i: Int = 0;
    let owner: String = "";
    let owner_indent: Int = -1;
    while i < count {
        if StringLength(owner) > 0 && indents[i] <= owner_indent {
            owner = "";
            owner_indent = -1;
        }
        if StartsWith(texts[i], "Class: ") {
            owner = Substring(texts[i], 7, StringLength(texts[i]) - 7);
            owner_indent = indents[i];
        }
        if StartsWith(texts[i], "Function:") {
            let name: String = Substring(texts[i], 10, StringLength(texts[i]) - 10);
            let c_name: String = name;
            if StringLength(owner) > 0 && indents[i] > owner_indent {
                c_name = Concat(owner, Concat("_", name));
            }
            if c_name != "Main" {
                let f_indent: Int = indents[i];
                let j: Int = i + 1;
                if j < count && texts[j] == "Parameters:" {
                    j = j + 1;
                }
                let params: String = "";
                let pn: Int = 0;
                while j < count && indents[j] == f_indent + 4 {
                    let pl: String = texts[j];
                    let pc: Int = StringIndexOf(pl, ": ");
                    let p_name: String = "";
                    let p_type: String = "";
                    if pc < 0 && StringLength(owner) > 0 && pl == "self" {
                        p_name = "self";
                        p_type = owner;
                    } else if pc < 0 {
                        Die(Concat("malformed parameter: ", pl));
                    } else {
                        p_name = Substring(pl, 0, pc);
                        p_type = Substring(pl, pc + 2, StringLength(pl) - (pc + 2));
                    }
                    let cp: String = Concat(CParamType(p_type, struct_env), Concat(" ", p_name));
                    if pn == 0 {
                        params = cp;
                    } else {
                        params = Concat(params, Concat(", ", cp));
                    }
                    pn = pn + 1;
                    j = j + 1;
                }
                let rtype: String = "Void";
                if j < count && StartsWith(texts[j], "Returns:") {
                    rtype = StringTrim(Substring(texts[j], 8, StringLength(texts[j]) - 8));
                }
                let plist: String = params;
                if pn == 0 {
                    plist = "void";
                }
                let sig: String = Concat(CRetType(rtype, struct_env), Concat(" ", Concat(c_name, Concat("(", Concat(plist, ")")))));
                block = Concat(block, Concat(sig, ";\n"));
            }
        }
        i = i + 1;
    }
    if StringLength(block) > 0 {
        block = Concat(block, "\n");
    }
    return block;
}

func GenerateC(ast: String) -> String {
    RejectUnsupportedCodegenBuiltins(ast);

    let indents: Array<Int> = [];
    let texts: Array<String> = [];
    let total: Int = StringLength(ast);
    let pos: Int = 0;
    let main_count: Int = 0;
    while pos < total {
        let nl: Int = NextNewline(ast, pos);
        let raw_line: String = Substring(ast, pos, nl - pos);
        let trimmed: String = StringTrim(raw_line);
        // Strip an `[export] ` modifier (namespace/import functions are flattened
        // to top-level `[export] Function: NS_Func`); the rest of the emitter
        // then treats them as ordinary functions.
        if StartsWith(trimmed, "[export] ") {
            trimmed = Substring(trimmed, 9, StringLength(trimmed) - 9);
        }
        // `event` declarations have no handler/dispatch model in this codegen.
        // Reject them with an observable CODEGEN ERROR rather than silently
        // dropping the declaration and emitting a call to an undefined symbol
        // (which would be unobservable broken C -- a no-op fake would be worse,
        // masking real event dispatch in programs that register handlers).
        if StartsWith(trimmed, "Event:") {
            Die(Concat("event declarations are not supported (no handler/dispatch model): ", trimmed));
        }
        if StringLength(trimmed) > 0 {
            ArrayPush(indents, IndentOf(raw_line));
            ArrayPush(texts, trimmed);
            if trimmed == "Function: Main" {
                main_count = main_count + 1;
            }
        }
        pos = nl + 1;
    }
    if main_count != 1 {
        Die(Concat("exactly one `Main` function is required; saw count=", ToString(main_count)));
    }

    let count: Int = ArrayLength(texts);
    let first_fn: Int = -1;
    let scan: Int = 0;
    while scan < count {
        if texts[scan] == "Function: Main" {
            first_fn = scan;
            scan = count;
        } else {
            scan = scan + 1;
        }
    }
    if first_fn < 0 {
        Die("no function found in AST");
    }
    let f_indent: Int = indents[first_fn];
    let env_acc: Array<String> = [BuildFunctionEnv(indents, texts, count)];
    let enum_block: String = CollectEnums(indents, texts, count, env_acc);
    let typedef_block: String = CollectStructs(indents, texts, count, env_acc);
    let base_env: String = env_acc[0];
    let uses_args: Bool = StringIndexOf(ast, "Args(") >= 0;

    let defs: String = "";
    let cur: Array<Int> = [0];
    while cur[0] < count {
        if StartsWith(texts[cur[0]], "Class: ") {
            let owner_name: String = Substring(texts[cur[0]], 7, StringLength(texts[cur[0]]) - 7);
            let owner_indent: Int = indents[cur[0]];
            ArraySet(cur, 0, cur[0] + 1);
            while cur[0] < count && indents[cur[0]] > owner_indent {
                if StartsWith(texts[cur[0]], "Function:") {
                    let method_indent: Int = indents[cur[0]];
                    let mdef: String = EmitFunction(indents, texts, count, cur, method_indent, base_env, uses_args, owner_name);
                    defs = Concat(defs, Concat(mdef, "\n"));
                } else {
                    ArraySet(cur, 0, cur[0] + 1);
                }
            }
        } else if StartsWith(texts[cur[0]], "Function:") && indents[cur[0]] == f_indent {
            let def: String = EmitFunction(indents, texts, count, cur, f_indent, base_env, uses_args, "");
            defs = Concat(defs, Concat(def, "\n"));
        } else {
            ArraySet(cur, 0, cur[0] + 1);
        }
    }

    // Forward declarations come from a GenerateC-scope pre-pass.
    let proto_block: String = CollectProtos(indents, texts, count, base_env);

    // String programs need the runtime string helpers; bool programs need
    // <stdbool.h>; array programs need the growable-array structs + stdlib;
    // int-only programs stay lean.
    let uses_str: Bool = StringIndexOf(ast, "String") >= 0
        || StringIndexOf(ast, "Concat(") >= 0
        || StringIndexOf(ast, "Substring(") >= 0
        || StringIndexOf(ast, "ToUpper(") >= 0
        || StringIndexOf(ast, "ToLower(") >= 0;
    let uses_math: Bool = StringIndexOf(ast, "Abs(") >= 0
        || StringIndexOf(ast, "Min(") >= 0
        || StringIndexOf(ast, "Max(") >= 0;
    let uses_array_sort: Bool = StringIndexOf(ast, "ArraySort(") >= 0;
    let uses_array_map: Bool = StringIndexOf(ast, "ArrayMap(") >= 0;
    let uses_array_filter: Bool = StringIndexOf(ast, "ArrayFilter(") >= 0;
    let uses_result: Bool = StringIndexOf(ast, "Result<") >= 0
        || StringIndexOf(ast, "Ok(") >= 0
        || StringIndexOf(ast, "Err(") >= 0
        || StringIndexOf(ast, "IsOk(") >= 0
        || StringIndexOf(ast, "IsErr(") >= 0
        || StringIndexOf(ast, "Unwrap(") >= 0
        || StringIndexOf(ast, "UnwrapOr(") >= 0;
    let uses_bool: Bool = StringIndexOf(ast, "Bool") >= 0 || uses_array_filter || uses_result;
    let uses_exit: Bool = StringIndexOf(ast, "Exit(") >= 0;
    let uses_array: Bool = StringIndexOf(ast, "Array<") >= 0
        || StringIndexOf(ast, "ArrayPush(") >= 0
        || StringIndexOf(ast, "ArrayLength(") >= 0
        || StringIndexOf(ast, "ArraySet(") >= 0
        || StringIndexOf(ast, "ArrayPop(") >= 0
        || uses_array_sort
        || uses_array_map
        || uses_array_filter
        || StringIndexOf(ast, "StringJoin(") >= 0
        || StringIndexOf(ast, "Join(") >= 0
        || StringIndexOf(ast, "Split(") >= 0
        || StringIndexOf(ast, "DirWalk(") >= 0
        || StringIndexOf(ast, "Args(") >= 0;
    let uses_args2: Bool = StringIndexOf(ast, "Args(") >= 0;
    let uses_io: Bool = StringIndexOf(ast, "ReadFile(") >= 0
        || StringIndexOf(ast, "FileExists(") >= 0
        || StringIndexOf(ast, "WriteFile(") >= 0;
    let uses_join: Bool = StringIndexOf(ast, "StringJoin(") >= 0
        || StringIndexOf(ast, "Join(") >= 0;
    let uses_split: Bool = StringIndexOf(ast, "Split(") >= 0;
    let uses_dirwalk: Bool = StringIndexOf(ast, "DirWalk(") >= 0;
    let uses_log: Bool = StringIndexOf(ast, "Log") >= 0;
    let uses_fhandle: Bool = StringIndexOf(ast, "FileOpen(") >= 0
        || StringIndexOf(ast, "FileWrite(") >= 0
        || StringIndexOf(ast, "FileClose(") >= 0
        || StringIndexOf(ast, "FileRead(") >= 0;
    let uses_print: Bool = StringIndexOf(ast, "Print(") >= 0;
    let uses_float: Bool = StringIndexOf(ast, "Float") >= 0
        || StringIndexOf(ast, "Sqrt(") >= 0
        || StringIndexOf(ast, "Pow(") >= 0
        || StringIndexOf(ast, "Floor(") >= 0
        || StringIndexOf(ast, "Ceil(") >= 0
        || StringIndexOf(ast, "ToFloat(") >= 0;
    let uses_random: Bool = StringIndexOf(ast, "Random(") >= 0;
    let need_stdlib: Bool = uses_str || uses_exit || uses_array || uses_io || uses_fhandle || uses_random || uses_float || uses_result;
    let header: String = "#include <stdio.h>\n";
    if uses_bool {
        header = Concat(header, "#include <stdbool.h>\n");
    }
    if need_stdlib {
        header = Concat(header, "#include <stdlib.h>\n");
    }
    if uses_str {
        header = Concat(header, "#include <string.h>\n");
    }
    if uses_float {
        header = Concat(header, "#include <math.h>\n");
    }
    if uses_dirwalk {
        header = Concat(header, "#include <dirent.h>\n#include <sys/stat.h>\n");
    }
    header = Concat(header, "\n");
    if uses_log {
        // String Log: strip all trailing newlines, then emit exactly one (the
        // oracle's `Log` semantics). Self-contained (no string.h dependency).
        header = Concat(header, "static void pgy_log(const char *s)\n{\n");
        header = Concat(header, "    long long n = 0;\n    while (s[n] != '\\0') { n++; }\n");
        header = Concat(header, "    while (n > 0 && (s[n-1] == '\\n' || s[n-1] == '\\r')) { n--; }\n");
        header = Concat(header, "    fwrite(s, 1, (size_t)n, stdout);\n    putchar('\\n');\n}\n\n");
    }
    if uses_print {
        // Print: write to stdout with no added newline.
        header = Concat(header, "static void pgy_print(const char *s)\n{\n    fputs(s, stdout);\n}\n\n");
    }
    if uses_random {
        // Random(n): rand() % n with the default (unseeded) sequence, matching
        // the oracle's deterministic behavior.
        header = Concat(header, "static long long pgy_random(long long n)\n{\n");
        header = Concat(header, "    return n > 0 ? (long long)(rand() % n) : 0;\n}\n\n");
    }
    if uses_result {
        header = Concat(header, "typedef struct { bool is_ok; long long value; } pgy_result_int;\n");
        header = Concat(header, "static pgy_result_int pgy_result_ok(long long v) { pgy_result_int r; r.is_ok = true; r.value = v; return r; }\n");
        header = Concat(header, "static pgy_result_int pgy_result_err(const char *msg) { (void)msg; pgy_result_int r; r.is_ok = false; r.value = 0; return r; }\n");
        header = Concat(header, "static bool pgy_result_is_ok(pgy_result_int r) { return r.is_ok; }\n");
        header = Concat(header, "static bool pgy_result_is_err(pgy_result_int r) { return !r.is_ok; }\n");
        header = Concat(header, "static long long pgy_result_unwrap(pgy_result_int r) { return r.value; }\n");
        header = Concat(header, "static long long pgy_result_unwrap_or(pgy_result_int r, long long fallback) { return r.is_ok ? r.value : fallback; }\n\n");
    }
    if uses_io || uses_fhandle {
        // Mirror the runtime path-policy default: absolute paths are denied
        // unless PGY_IO_ALLOW_ABSOLUTE=1 is present.
        header = Concat(header, "static int pgy_path_allowed(const char *path)\n{\n");
        header = Concat(header, "    if (path == NULL || path[0] == '\\0') { return 0; }\n");
        header = Concat(header, "    int drive = ((path[0] >= 'A' && path[0] <= 'Z') || (path[0] >= 'a' && path[0] <= 'z')) && path[1] == ':';\n");
        header = Concat(header, "    int absolute = path[0] == '/' || path[0] == '\\\\' || drive;\n");
        header = Concat(header, "    if (!absolute) { return 1; }\n");
        header = Concat(header, "    const char *allow = getenv(\"PGY_IO_ALLOW_ABSOLUTE\");\n");
        header = Concat(header, "    return allow != NULL && allow[0] == '1' && allow[1] == '\\0';\n");
        header = Concat(header, "}\n\n");
    }
    if uses_fhandle {
        // File-handle API: an int handle indexes a small static FILE* table.
        // FileOpen returns -1 on failure; FileRead returns one line (with its
        // trailing newline) or "" at EOF. Self-contained (no string.h).
        header = Concat(header, "static FILE *pgy_fh[256];\nstatic long long pgy_fh_n = 0;\n");
        header = Concat(header, "static long long pgy_fopen(const char *path, const char *mode)\n{\n");
        header = Concat(header, "    if (!pgy_path_allowed(path)) { return -1; }\n");
        header = Concat(header, "    FILE *f = fopen(path, mode);\n    if (!f) { return -1; }\n");
        header = Concat(header, "    if (pgy_fh_n >= 256) { fclose(f); return -1; }\n");
        header = Concat(header, "    pgy_fh[pgy_fh_n] = f;\n    return pgy_fh_n++;\n}\n\n");
        header = Concat(header, "static int pgy_fh_valid(long long fd)\n{\n");
        header = Concat(header, "    return fd >= 0 && fd < pgy_fh_n && pgy_fh[fd] != NULL;\n}\n\n");
        header = Concat(header, "static void pgy_fwrite(long long fd, const char *s)\n{\n");
        header = Concat(header, "    if (!pgy_fh_valid(fd)) { return; }\n    fputs(s, pgy_fh[fd]);\n}\n\n");
        header = Concat(header, "static void pgy_fclose(long long fd)\n{\n");
        header = Concat(header, "    if (!pgy_fh_valid(fd)) { return; }\n    fclose(pgy_fh[fd]);\n    pgy_fh[fd] = NULL;\n}\n\n");
        header = Concat(header, "static char *pgy_fread(long long fd)\n{\n");
        header = Concat(header, "    if (!pgy_fh_valid(fd)) { char *e = (char *)malloc(1); e[0] = '\\0'; return e; }\n");
        header = Concat(header, "    char buf[4096];\n    if (!fgets(buf, (int)sizeof(buf), pgy_fh[fd])) { char *e = (char *)malloc(1); e[0] = '\\0'; return e; }\n");
        header = Concat(header, "    long long n = 0;\n    while (buf[n] != '\\0') { n++; }\n");
        header = Concat(header, "    char *r = (char *)malloc((size_t)n + 1);\n");
        header = Concat(header, "    long long i = 0;\n    while (i <= n) { r[i] = buf[i]; i++; }\n    return r;\n}\n\n");
    }
    if uses_array {
        header = Concat(header, "typedef struct { long long *data; long long len; long long cap; } pgy_ai;\n");
        header = Concat(header, "typedef struct { const char **data; long long len; long long cap; } pgy_as;\n\n");
        header = Concat(header, "static pgy_ai pgy_ai_new(void) { pgy_ai a; a.data = NULL; a.len = 0; a.cap = 0; return a; }\n");
        header = Concat(header, "static void pgy_ai_push(pgy_ai *a, long long v) {\n");
        header = Concat(header, "    if (a->len == a->cap) { a->cap = a->cap ? a->cap * 2 : 4; a->data = (long long *)realloc(a->data, (size_t)a->cap * sizeof(long long)); }\n");
        header = Concat(header, "    a->data[a->len++] = v;\n}\n");
        header = Concat(header, "static long long pgy_ai_get(pgy_ai a, long long i) { return a.data[i]; }\n");
        header = Concat(header, "static void pgy_ai_set(pgy_ai *a, long long i, long long v) { a->data[i] = v; }\n");
        header = Concat(header, "static long long pgy_ai_len(pgy_ai a) { return a.len; }\n");
        header = Concat(header, "static long long pgy_ai_pop(pgy_ai *a) { return a->len > 0 ? a->data[--a->len] : 0; }\n\n");
        if uses_array_sort {
            header = Concat(header, "static int pgy_ai_cmp(const void *pa, const void *pb)\n{\n");
            header = Concat(header, "    long long a = *(const long long *)pa;\n    long long b = *(const long long *)pb;\n");
            header = Concat(header, "    return (a > b) - (a < b);\n}\n");
            header = Concat(header, "static pgy_ai pgy_ai_sort(pgy_ai a)\n{\n");
            header = Concat(header, "    if (a.len > 1) { qsort(a.data, (size_t)a.len, sizeof(long long), pgy_ai_cmp); }\n");
            header = Concat(header, "    return a;\n}\n\n");
        }
        if uses_array_map {
            header = Concat(header, "static pgy_ai pgy_ai_map(pgy_ai a, long long (*fn)(long long))\n{\n");
            header = Concat(header, "    pgy_ai out = pgy_ai_new();\n");
            header = Concat(header, "    for (long long i = 0; i < a.len; i++) { pgy_ai_push(&out, fn(a.data[i])); }\n");
            header = Concat(header, "    return out;\n}\n\n");
        }
        if uses_array_filter {
            header = Concat(header, "static pgy_ai pgy_ai_filter(pgy_ai a, bool (*pred)(long long))\n{\n");
            header = Concat(header, "    pgy_ai out = pgy_ai_new();\n");
            header = Concat(header, "    for (long long i = 0; i < a.len; i++) { if (pred(a.data[i])) { pgy_ai_push(&out, a.data[i]); } }\n");
            header = Concat(header, "    return out;\n}\n\n");
        }
        header = Concat(header, "static pgy_as pgy_as_new(void) { pgy_as a; a.data = NULL; a.len = 0; a.cap = 0; return a; }\n");
        header = Concat(header, "static void pgy_as_push(pgy_as *a, const char *v) {\n");
        header = Concat(header, "    if (a->len == a->cap) { a->cap = a->cap ? a->cap * 2 : 4; a->data = (const char **)realloc(a->data, (size_t)a->cap * sizeof(const char *)); }\n");
        header = Concat(header, "    a->data[a->len++] = v;\n}\n");
        header = Concat(header, "static const char *pgy_as_get(pgy_as a, long long i) { return a.data[i]; }\n");
        header = Concat(header, "static void pgy_as_set(pgy_as *a, long long i, const char *v) { a->data[i] = v; }\n");
        header = Concat(header, "static long long pgy_as_len(pgy_as a) { return a.len; }\n");
        header = Concat(header, "static const char *pgy_as_pop(pgy_as *a) { return a->len > 0 ? a->data[--a->len] : \"\"; }\n\n");
    }
    if uses_args2 {
        // `Args()` -> pgy_args(): user args (argv[1..]) as a pgy_as. main() stashes
        // argc/argv into these globals before any body statement runs.
        header = Concat(header, "static int pgy_argc = 0;\nstatic char **pgy_argv = NULL;\n");
        header = Concat(header, "static pgy_as pgy_args(void)\n{\n");
        header = Concat(header, "    pgy_as a = pgy_as_new();\n");
        header = Concat(header, "    for (int i = 1; i < pgy_argc; i++) { pgy_as_push(&a, pgy_argv[i]); }\n");
        header = Concat(header, "    return a;\n}\n\n");
    }
    if uses_str {
        header = Concat(header, "static char *pgy_concat(const char *a, const char *b)\n{\n");
        header = Concat(header, "    size_t la = strlen(a);\n    size_t lb = strlen(b);\n");
        header = Concat(header, "    char *r = (char *)malloc(la + lb + 1);\n");
        header = Concat(header, "    memcpy(r, a, la);\n    memcpy(r + la, b, lb);\n    r[la + lb] = '\\0';\n");
        header = Concat(header, "    return r;\n}\n\n");
        header = Concat(header, "static long long pgy_strlen(const char *s)\n{\n");
        header = Concat(header, "    return (long long)strlen(s);\n}\n\n");
        header = Concat(header, "static char *pgy_charatn(const char *s, long long len, long long i)\n{\n");
        header = Concat(header, "    if (s == NULL || i < 0 || i >= len) { char *e = (char *)malloc(1); e[0] = '\\0'; return e; }\n");
        header = Concat(header, "    char *r = (char *)malloc(2);\n    r[0] = s[i];\n    r[1] = '\\0';\n    return r;\n}\n\n");
        header = Concat(header, "static long long pgy_charcode(const char *s, long long len, long long i)\n{\n");
        header = Concat(header, "    if (s == NULL || i < 0 || i >= len) return -1;\n");
        header = Concat(header, "    return (long long)(unsigned char)s[i];\n}\n\n");
        header = Concat(header, "static char *pgy_substr(const char *s, long long start, long long len)\n{\n");
        header = Concat(header, "    char *r = (char *)malloc((size_t)len + 1);\n");
        header = Concat(header, "    memcpy(r, s + start, (size_t)len);\n    r[len] = '\\0';\n");
        header = Concat(header, "    return r;\n}\n\n");
        header = Concat(header, "static long long pgy_strindexof(const char *hay, const char *needle)\n{\n");
        header = Concat(header, "    const char *p = strstr(hay, needle);\n");
        header = Concat(header, "    if (p == NULL) { return -1; }\n");
        header = Concat(header, "    return (long long)(p - hay);\n}\n\n");
        header = Concat(header, "static char *pgy_strtrim(const char *s)\n{\n");
        header = Concat(header, "    while (*s == ' ' || *s == '\\t' || *s == '\\n' || *s == '\\r') { s++; }\n");
        header = Concat(header, "    size_t len = strlen(s);\n");
        header = Concat(header, "    while (len > 0 && (s[len-1] == ' ' || s[len-1] == '\\t' || s[len-1] == '\\n' || s[len-1] == '\\r')) { len--; }\n");
        header = Concat(header, "    char *r = (char *)malloc(len + 1);\n");
        header = Concat(header, "    memcpy(r, s, len);\n    r[len] = '\\0';\n");
        header = Concat(header, "    return r;\n}\n\n");
        header = Concat(header, "static char *pgy_tostr(long long v)\n{\n");
        header = Concat(header, "    char *r = (char *)malloc(24);\n");
        header = Concat(header, "    sprintf(r, \"%lld\", v);\n    return r;\n}\n\n");
        header = Concat(header, "static int pgy_strcontains(const char *h, const char *n)\n{\n");
        header = Concat(header, "    return strstr(h, n) != NULL ? 1 : 0;\n}\n\n");
        header = Concat(header, "static long long pgy_toint(const char *s)\n{\n    return atoll(s);\n}\n\n");
        header = Concat(header, "static char *pgy_toupper(const char *s)\n{\n");
        header = Concat(header, "    size_t n = strlen(s);\n    char *r = (char *)malloc(n + 1);\n");
        header = Concat(header, "    for (size_t i = 0; i < n; i++) { char c = s[i]; r[i] = (c >= 'a' && c <= 'z') ? (char)(c - 32) : c; }\n");
        header = Concat(header, "    r[n] = '\\0';\n    return r;\n}\n\n");
        header = Concat(header, "static char *pgy_tolower(const char *s)\n{\n");
        header = Concat(header, "    size_t n = strlen(s);\n    char *r = (char *)malloc(n + 1);\n");
        header = Concat(header, "    for (size_t i = 0; i < n; i++) { char c = s[i]; r[i] = (c >= 'A' && c <= 'Z') ? (char)(c + 32) : c; }\n");
        header = Concat(header, "    r[n] = '\\0';\n    return r;\n}\n\n");
        header = Concat(header, "static char *pgy_strreplace(const char *s, const char *from, const char *to)\n{\n");
        header = Concat(header, "    size_t fl = strlen(from);\n    if (fl == 0) { return pgy_concat(s, \"\"); }\n");
        header = Concat(header, "    size_t tl = strlen(to);\n    size_t cnt = 0;\n    const char *p = s;\n");
        header = Concat(header, "    while ((p = strstr(p, from)) != NULL) { cnt++; p += fl; }\n");
        header = Concat(header, "    char *r = (char *)malloc(strlen(s) + cnt * (tl > fl ? tl - fl : 0) + 1);\n");
        header = Concat(header, "    char *w = r;\n    const char *q = s;\n");
        header = Concat(header, "    while (*q) {\n        if (strncmp(q, from, fl) == 0) { memcpy(w, to, tl); w += tl; q += fl; }\n");
        header = Concat(header, "        else { *w++ = *q++; }\n    }\n    *w = '\\0';\n    return r;\n}\n\n");
    }
    if uses_math {
        header = Concat(header, "static long long pgy_abs(long long v)\n{\n    return v < 0 ? -v : v;\n}\n\n");
        header = Concat(header, "static long long pgy_min(long long a, long long b)\n{\n    return a < b ? a : b;\n}\n\n");
        header = Concat(header, "static long long pgy_max(long long a, long long b)\n{\n    return a > b ? a : b;\n}\n\n");
    }
    // pgy_strjoin needs both the pgy_as struct (uses_array) and string.h
    // (uses_str); emit it only when StringJoin is actually used so string-only
    // programs do not reference an undefined pgy_as.
    if uses_split {
        header = Concat(header, "static pgy_as pgy_split(const char *s, const char *sep)\n{\n");
        header = Concat(header, "    pgy_as a = pgy_as_new();\n    size_t sl = strlen(sep);\n");
        header = Concat(header, "    if (sl == 0) { pgy_as_push(&a, s); return a; }\n");
        header = Concat(header, "    const char *start = s;\n    const char *p;\n");
        header = Concat(header, "    while ((p = strstr(start, sep)) != NULL) {\n");
        header = Concat(header, "        size_t len = (size_t)(p - start);\n");
        header = Concat(header, "        char *part = (char *)malloc(len + 1);\n");
        header = Concat(header, "        memcpy(part, start, len); part[len] = '\\0';\n");
        header = Concat(header, "        pgy_as_push(&a, part);\n        start = p + sl;\n    }\n");
        header = Concat(header, "    char *last = (char *)malloc(strlen(start) + 1);\n");
        header = Concat(header, "    strcpy(last, start);\n    pgy_as_push(&a, last);\n    return a;\n}\n\n");
    }
    if uses_join {
        header = Concat(header, "static char *pgy_strjoin(pgy_as a, const char *sep)\n{\n");
        header = Concat(header, "    size_t sl = strlen(sep);\n    size_t total = 0;\n");
        header = Concat(header, "    for (long long i = 0; i < a.len; i++) { total += strlen(a.data[i]); }\n");
        header = Concat(header, "    if (a.len > 1) { total += sl * (size_t)(a.len - 1); }\n");
        header = Concat(header, "    char *r = (char *)malloc(total + 1);\n    char *p = r;\n");
        header = Concat(header, "    for (long long i = 0; i < a.len; i++) {\n");
        header = Concat(header, "        if (i > 0) { memcpy(p, sep, sl); p += sl; }\n");
        header = Concat(header, "        size_t el = strlen(a.data[i]);\n        memcpy(p, a.data[i], el); p += el;\n    }\n");
        header = Concat(header, "    *p = '\\0';\n    return r;\n}\n\n");
    }
    if uses_io {
        header = Concat(header, "static int pgy_fexists(const char *path)\n{\n");
        header = Concat(header, "    if (!pgy_path_allowed(path)) { return 0; }\n");
        header = Concat(header, "    FILE *f = fopen(path, \"rb\");\n");
        header = Concat(header, "    if (f) { fclose(f); return 1; }\n    return 0;\n}\n\n");
        header = Concat(header, "static char *pgy_readfile(const char *path)\n{\n");
        header = Concat(header, "    if (!pgy_path_allowed(path)) { char *e = (char *)malloc(1); e[0] = '\\0'; return e; }\n");
        header = Concat(header, "    FILE *f = fopen(path, \"rb\");\n");
        header = Concat(header, "    if (!f) { char *e = (char *)malloc(1); e[0] = '\\0'; return e; }\n");
        header = Concat(header, "    fseek(f, 0, SEEK_END);\n    long sz = ftell(f);\n    fseek(f, 0, SEEK_SET);\n");
        header = Concat(header, "    if (sz < 0) { sz = 0; }\n");
        header = Concat(header, "    char *buf = (char *)malloc((size_t)sz + 1);\n");
        header = Concat(header, "    size_t rd = fread(buf, 1, (size_t)sz, f);\n");
        header = Concat(header, "    buf[rd] = '\\0';\n    fclose(f);\n    return buf;\n}\n\n");
        header = Concat(header, "static int pgy_writefile(const char *path, const char *content)\n{\n");
        header = Concat(header, "    if (!pgy_path_allowed(path)) { return 0; }\n");
        header = Concat(header, "    FILE *f = fopen(path, \"wb\");\n");
        header = Concat(header, "    if (!f) { return 0; }\n");
        header = Concat(header, "    size_t n = strlen(content);\n");
        header = Concat(header, "    size_t wr = fwrite(content, 1, n, f);\n");
        header = Concat(header, "    fclose(f);\n    return (int)wr;\n}\n\n");
    }
    if uses_dirwalk {
        // DirWalk: recursive regular-file walk, `/`-joined paths, flat lexical
        // sort -- matches the oracle's snapshot. Needs pgy_as (uses_array).
        header = Concat(header, "static void pgy_dirwalk_rec(const char *dir, pgy_as *out)\n{\n");
        header = Concat(header, "    DIR *d = opendir(dir);\n    if (!d) { return; }\n");
        header = Concat(header, "    struct dirent *e;\n    while ((e = readdir(d)) != NULL) {\n");
        header = Concat(header, "        if (strcmp(e->d_name, \".\") == 0 || strcmp(e->d_name, \"..\") == 0) { continue; }\n");
        header = Concat(header, "        char *path = (char *)malloc(strlen(dir) + strlen(e->d_name) + 2);\n");
        header = Concat(header, "        sprintf(path, \"%s/%s\", dir, e->d_name);\n");
        header = Concat(header, "        struct stat st;\n");
        header = Concat(header, "        if (stat(path, &st) == 0) {\n");
        header = Concat(header, "            if (S_ISDIR(st.st_mode)) { pgy_dirwalk_rec(path, out); free(path); }\n");
        header = Concat(header, "            else { pgy_as_push(out, path); }\n");
        header = Concat(header, "        } else { free(path); }\n    }\n    closedir(d);\n}\n");
        header = Concat(header, "static int pgy_str_cmp(const void *a, const void *b)\n{\n");
        header = Concat(header, "    return strcmp(*(const char **)a, *(const char **)b);\n}\n");
        header = Concat(header, "static pgy_as pgy_dirwalk(const char *dir)\n{\n");
        header = Concat(header, "    pgy_as a = pgy_as_new();\n    pgy_dirwalk_rec(dir, &a);\n");
        header = Concat(header, "    qsort(a.data, (size_t)a.len, sizeof(const char *), pgy_str_cmp);\n");
        header = Concat(header, "    return a;\n}\n\n");
    }
    return Concat(header, Concat(enum_block, Concat(typedef_block, Concat(proto_block, defs))));
}

func Main() -> Void {
    let run_args: Array<String> = Args();
    let ast_path: String = "src/self_hosted/codegen/fixture/hello_ast.txt";
    if ArrayLength(run_args) > 0 {
        ast_path = run_args[0];
    }
    if !FileExists(ast_path) {
        Log(Concat("CODEGEN ERROR: AST file not found: ", ast_path));
        Exit(1);
    }
    let ast: String = ReadFile(ast_path);
    let c_source: String = GenerateC(ast);
    Log(c_source);
}
