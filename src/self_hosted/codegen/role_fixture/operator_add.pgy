ability Arithmetic {
    func Add(self, rhs: Int) -> Int;
}

role IntMath for Int {
    impl Arithmetic {
        func Add(self, rhs: Int) -> Int {
            return 123;
        }
    }
}

func ComputeAdd() -> Int {
    return 1 + 2;
}

func Main() -> Void {
    Log(1 + 2);
    Log(ComputeAdd());
    Log(5 - 2);
}
