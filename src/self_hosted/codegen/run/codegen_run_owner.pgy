// Self-host codegen run boundary owner.
//
// Owns CLI-to-output orchestration for the bounded codegen substitute. AST
// path/file policy stays in ast_input_owner.pgy; C translation stays in
// program_emit.pgy.

import "../input/ast_input_owner.pgy";
import "../emission/program_emit.pgy";
import "../../compiler/target_capability_owner.pgy";

func CodegenParityFixtureDir() -> String {
    return "src/self_hosted/codegen/fixture";
}

func CodegenParityExpectedDir() -> String {
    return "src/self_hosted/codegen/expected";
}

func CodegenParityPathEndsWith(path: String, suffix: String) -> Bool {
    let path_len: Int = StringLength(path);
    let suffix_len: Int = StringLength(suffix);
    if suffix_len > path_len {
        return false;
    }
    return Substring(path, path_len - suffix_len, suffix_len) == suffix;
}

func CodegenParityBaseName(path: String, suffix: String) -> String {
    if !CodegenParityPathEndsWith(path, suffix) {
        return "";
    }
    let last_slash: Int = -1;
    let i: Int = 0;
    while i < StringLength(path) {
        if Substring(path, i, 1) == "/" {
            last_slash = i;
        }
        i = i + 1;
    }
    let start: Int = last_slash + 1;
    let len: Int = StringLength(path) - start - StringLength(suffix);
    if len <= 0 {
        return "";
    }
    return Substring(path, start, len);
}

func CodegenParityExpectedPath(base: String) -> String {
    return Concat(Concat(CodegenParityExpectedDir(), "/"), Concat(base, "_stdout.txt"));
}

func CodegenParityFixtureManifestRows() -> Array<String> {
    let entries: Array<String> = DirWalk(CodegenParityFixtureDir());
    let rows: Array<String> = [];
    let i: Int = 0;
    while i < ArrayLength(entries) {
        let path: String = entries[i];
        if CodegenParityPathEndsWith(path, ".pgy") {
            let base: String = CodegenParityBaseName(path, ".pgy");
            if StringLength(base) > 0 && FileExists(CodegenParityExpectedPath(base)) {
                ArrayPush(rows, base);
            }
        }
        i = i + 1;
    }
    return rows;
}

func EmitCodegenParityFixtureManifest() -> Void {
    let rows: Array<String> = CodegenParityFixtureManifestRows();
    let i: Int = 0;
    while i < ArrayLength(rows) {
        Log(rows[i]);
        i = i + 1;
    }
}

func RunCodegenFromArgs(args: Array<String>) -> Void {
    if ArrayLength(args) > 0 && args[0] == "--fixture-manifest" {
        EmitCodegenParityFixtureManifest();
        return;
    }
    if ArrayLength(args) > 0 && args[0] == "--check" {
        if ArrayLength(args) < 2 {
            Log("Diagnostic: pgy.selfhost.stage-check.v1");
            Log("Stage: codegen");
            Log("Status: error");
            Log("Reason: input_missing");
            Exit(1);
            return;
        }
        if !CompilerTargetCapabilityEnvelopeReady() {
            Die("target capability envelope is not ready for self-host C codegen");
        }
        let check_tree_text: String = CodegenReadAst(args[1]);
        let check_c_source: String = GenerateCUnit(check_tree_text, false);
        if StringLength(check_c_source) >= 0 {
            Log("Diagnostic: pgy.selfhost.stage-check.v1");
            Log("Stage: codegen");
            Log("Status: ok");
        }
        return;
    }
    if !CompilerTargetCapabilityEnvelopeReady() {
        Die("target capability envelope is not ready for self-host C codegen");
    }
    let ast_path: String = CodegenDefaultAstPath(args);
    let tree_text: String = CodegenReadAst(ast_path);
    let c_source: String = GenerateC(tree_text);
    Log(c_source);
}
