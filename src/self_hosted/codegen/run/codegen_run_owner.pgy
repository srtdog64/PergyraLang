// Self-host codegen run boundary owner.
//
// Owns CLI-to-output orchestration for the bounded codegen substitute. AST
// path/file policy stays in ast_input_owner.pgy; C translation stays in
// program_emit.pgy.

import "../input/ast_input_owner.pgy";
import "../emission/program_entry_owner.pgy";
import "../fixture_manifest_owner.pgy";
import "../text/text_owner.pgy";
import "../../compiler/driver_pipeline_owner.pgy";
import "../../compiler/target_capability_owner.pgy";

func EmitCodegenParityFixtureManifest() -> Void {
    if !CodegenParityFixtureManifestReady() {
        Exit(1);
        return;
    }
    let rows: Array<String> = CodegenParityFixtureManifestRows();
    let i: Int = 0;
    while i < ArrayLength(rows) {
        Log(rows[i]);
        i = i + 1;
    }
}

func RunCodegenFromArgs(args: Array<String>) -> Void {
    if ArrayLength(args) > 0 && args[0] == "--fixture-manifest" {
        EmitCodegenParityFixtureManifest();
        return;
    }
    if ArrayLength(args) > 0 && args[0] == "--check-source" {
        if ArrayLength(args) < 2 {
            Log("Diagnostic: pgy.selfhost.stage-check.v1");
            Log("Stage: codegen");
            Log("Status: error");
            Log("Reason: input_missing");
            Exit(1);
            return;
        }
        if !CompilerTargetCapabilityEnvelopeReady() {
            Die("target capability envelope is not ready for self-host C codegen");
        }
        Log("Phase: parse:start");
        let source_artifact: AstTreeArtifact =
            CompileSourceToAstArtifact(args[1]);
        Log("Phase: semantic:start");
        let semantic_analysis: SemanticAstArtifactAnalysis =
            SemanticAstArtifactAnalyzeTyped(source_artifact, false);
        Log("Phase: semantic:done");
        Log("Phase: codegen-check:start");
        let source_ready: Bool =
            CheckCUnitFromSemanticArtifact(
                source_artifact, semantic_analysis, false
            );
        if source_ready {
            Log("Diagnostic: pgy.selfhost.stage-check.v1");
            Log("Stage: codegen");
            Log("Status: ok");
        }
        return;
    }
    if ArrayLength(args) > 0 && args[0] == "--check" {
        if ArrayLength(args) < 2 {
            Log("Diagnostic: pgy.selfhost.stage-check.v1");
            Log("Stage: codegen");
            Log("Status: error");
            Log("Reason: input_missing");
            Exit(1);
            return;
        }
        if !CompilerTargetCapabilityEnvelopeReady() {
            Die("target capability envelope is not ready for self-host C codegen");
        }
        let check_tree_text: String = CodegenReadAst(args[1]);
        if CheckCUnit(check_tree_text, false) {
            Log("Diagnostic: pgy.selfhost.stage-check.v1");
            Log("Stage: codegen");
            Log("Status: ok");
        }
        return;
    }
    if ArrayLength(args) > 0 && args[0] == "--source" {
        if ArrayLength(args) < 2 {
            Die("codegen source path is missing");
        }
        if !CompilerTargetCapabilityEnvelopeReady() {
            Die("target capability envelope is not ready for self-host C codegen");
        }
        let source_artifact: AstTreeArtifact =
            CompileSourceToAstArtifact(args[1]);
        Log(GenerateCFromTypedAstArtifact(source_artifact));
        return;
    }
    if ArrayLength(args) > 0 && args[0] == "--observe-pressure" {
        if ArrayLength(args) < 2 {
            Die("observed codegen AST path is missing");
        }
        if !CompilerTargetCapabilityEnvelopeReady() {
            Die("target capability envelope is not ready for self-host C codegen");
        }
        Log("[codegen-pressure-stage] input:start");
        let observed_text: String = CodegenReadAst(args[1]);
        Log("[codegen-pressure-stage] input:done");
        let observed_artifact: AstTreeArtifact =
            CodegenAstArtifactFromTextObserved(observed_text, true);
        Log("[codegen-pressure-stage] semantic:start");
        let observed_analysis: SemanticAstArtifactAnalysis =
            SemanticAstArtifactAnalyzeCompactBridge(observed_artifact, true);
        Log("[codegen-pressure-stage] semantic:done");
        Log(GenerateCUnitFromAdmittedSemanticArtifactObserved(
            observed_artifact, observed_analysis, true,
            SelfHostMachineLayerDeclarationEmpty(), true
        ));
        return;
    }
    if !CompilerTargetCapabilityEnvelopeReady() {
        Die("target capability envelope is not ready for self-host C codegen");
    }
    let ast_path: String = CodegenDefaultAstPath(args);
    let tree_text: String = CodegenReadAst(ast_path);
    let c_source: String = GenerateCUnit(tree_text, true);
    Log(c_source);
}
