func CollectionRuntimeCLenFn(kind_code: Int) -> String {
    let checked: Int = CollectionRuntimeKindCodeOrDie(kind_code, "array length");
    if checked == 2 {
        return "pgy_as_len";
    }
    if checked == 3 {
        return "pgy_CodegenAstTextNode_array_len";
    }
    if checked == 4 {
