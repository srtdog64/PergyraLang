// src/self_hosted/codegen/runtime_abi/collection_runtime_owner.pgy
//
// Self-host C collection runtime symbol facts for the supported codegen subset.

import "../text/text_owner.pgy";
import "../../compiler/abi_layout_row_owner.pgy";

// The AST-text bridge currently prints generic actuals as `Array<T: T>`.
// Normalize bridge spelling at the owner boundary so emission participants
// consume canonical collection-kind facts rather than re-parsing type text.
func CollectionRuntimeKindFromTypeName(type_name: String) -> String {
    if type_name == "Array<Int>" || type_name == "Array<Int: Int>" ||
        type_name == "Array<Long>" || type_name == "Array<Long: Long>" {
        return "ArrayInt";
    }
    if type_name == "Array<String>" || type_name == "Array<String: String>" {
        return "ArrayString";
    }
    if type_name == "Array<Bool>" || type_name == "Array<Bool: Bool>" {
        return "ArrayBool";
    }
    if type_name == "Array<CodegenAstTextNode>" ||
        type_name == "Array<CodegenAstTextNode: CodegenAstTextNode>" {
        return "ArrayCodegenAstTextNode";
    }
    Die(Concat("unsupported collection type (only Array<Int>/Array<String>/Array<Bool>/Array<CodegenAstTextNode> bridge forms): ", type_name));
    return "";
}

func CollectionRuntimeRequireKind(kind: String, context: String) -> String {
    if kind == "ArrayInt" || kind == "ArrayString" || kind == "ArrayBool" || kind == "ArrayCodegenAstTextNode" {
        return kind;
    }
    Die(Concat(context, Concat(" requires Array<Int>, Array<String>, Array<Bool>, or Array<CodegenAstTextNode>, got: ", kind)));
    return "";
}

func CollectionRuntimeKindCode(kind: String) -> Int {
    let checked: String = CollectionRuntimeRequireKind(kind, "array kind code");
    if checked == "ArrayString" {
        return 2;
    }
    if checked == "ArrayCodegenAstTextNode" {
        return 3;
    }
    if checked == "ArrayBool" {
        return 4;
    }
    return 1;
}

func CollectionRuntimeElementTypeFromKindCode(kind_code: Int) -> String {
    if kind_code == 2 {
        return "String";
    }
    if kind_code == 3 {
        return "CodegenAstTextNode";
    }
    if kind_code == 4 {
        return "Bool";
    }
    return "Int";
}

func CollectionRuntimeKindCodeOrDie(kind_code: Int, context: String) -> Int {
    if kind_code == 1 || kind_code == 2 || kind_code == 3 || kind_code == 4 {
        return kind_code;
    }
    Die(Concat(context, Concat(" requires collection kind code 1, 2, 3, or 4, got: ", ToString(kind_code))));
    return 0;
}

func CollectionRuntimeCNewFn(kind_code: Int) -> String {
    let checked: Int = CollectionRuntimeKindCodeOrDie(kind_code, "array new");
    if checked == 2 {
        return "pgy_as_new";
    }
    if checked == 3 {
        return "pgy_CodegenAstTextNode_array_new";
    }
    if checked == 4 {
        return "pgy_ab_new";
    }
    return "pgy_ai_new";
}

