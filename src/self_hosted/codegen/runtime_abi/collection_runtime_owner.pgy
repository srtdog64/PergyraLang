    if checked == "ArrayString" {
        return "pgy_as_get";
    }
    return "pgy_ai_get";
}

func CollectionRuntimeCLenFn(kind: String) -> String {
    let checked: String = CollectionRuntimeRequireKind(kind, "array length");
    if checked == "ArrayString" {
        return "pgy_as_len";
    }
    return "pgy_ai_len";
}

func CollectionRuntimeCPopFn(kind: String) -> String {
    let checked: String = CollectionRuntimeRequireKind(kind, "array pop");
    if checked == "ArrayString" {
        return "pgy_as_pop";
    }
    return "pgy_ai_pop";
}

func CollectionRuntimeCIntSortFn() -> String {
    return "pgy_ai_sort";
}

func CollectionRuntimeCIntReverseFn() -> String {
    return "pgy_ai_reverse";
}

func CollectionRuntimeCIntMapFn() -> String {
    return "pgy_ai_map";
}

func CollectionRuntimeCIntFilterFn() -> String {
    return "pgy_ai_filter";
}
