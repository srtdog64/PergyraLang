// src/self_hosted/codegen/runtime_abi/collection_runtime_owner.pgy
//
// Self-host C collection runtime symbol facts for the supported codegen subset.

import "../text/text_owner.pgy";
import "../type_facts/type_env.pgy";
import "../../compiler/abi_layout_row_owner.pgy";
import "../../compiler/abi_layout_nominal_array_owner.pgy";
import "../../semantic/array_type_shape_owner.pgy";
import "collection_bounds_owner.pgy";

struct CollectionRuntimeFact {
    ok: Bool;
    kind: String;
    element_type: String;
    c_array_type: String;
    c_new_fn: String;
    c_push_fn: String;
    c_set_fn: String;
    c_get_fn: String;
    c_len_fn: String;
    c_pop_fn: String;
}

func CollectionRuntimeBuiltinKindFromTypeName(
    type_name: String
) -> Option<String> {
    if type_name == "Array<Int>" || type_name == "Array<Int: Int>" {
        return Some("ArrayInt");
    }
    if type_name == "Array<Long>" || type_name == "Array<Long: Long>" {
        return Some("ArrayLong");
    }
    if type_name == "Array<String>" ||
        type_name == "Array<String: String>" {
        return Some("ArrayString");
    }
    if type_name == "Array<Bool>" || type_name == "Array<Bool: Bool>" {
        return Some("ArrayBool");
    }
    if type_name == "Array<Float>" || type_name == "Array<Float: Float>" {
        return Some("ArrayFloat");
    }
    if type_name == "Array<Double>" || type_name == "Array<Double: Double>" {
        return Some("ArrayDouble");
    }
    if type_name == "Array<CodegenAstTextNode>" ||
        type_name ==
            "Array<CodegenAstTextNode: CodegenAstTextNode>" {
        return Some("ArrayCodegenAstTextNode");
    }
    return None;
}

// The AST-text bridge currently prints generic actuals as `Array<T: T>`.
// Normalize bridge spelling at the owner boundary so emission participants
// consume canonical collection-kind facts rather than re-parsing type text.
func CollectionRuntimeKindFromTypeName(type_name: String) -> String {
    let kind: Option<String> =
        CollectionRuntimeBuiltinKindFromTypeName(type_name);
    if IsSome(kind) {
        return UnwrapOption(kind);
    }
    Die(Concat("unsupported collection type (only Array<Int>/Array<Long>/Array<String>/Array<Bool>/Array<Float>/Array<Double>/Array<CodegenAstTextNode> bridge forms): ", type_name));
    return "";
}

func CollectionRuntimeRecordElementType(kind: String) -> Option<String> {
    return SemanticArrayElementType(kind);
}

func CollectionRuntimeRequireKind(kind: String, context: String) -> String {
    if kind == "ArrayInt" || kind == "ArrayLong" ||
        kind == "ArrayString" || kind == "ArrayBool" ||
        kind == "ArrayFloat" || kind == "ArrayDouble" ||
        kind == "ArrayCodegenAstTextNode" {
        return kind;
    }
    Die(Concat(context, Concat(" requires Array<Int>, Array<Long>, Array<String>, Array<Bool>, Array<Float>, Array<Double>, or Array<CodegenAstTextNode>, got: ", kind)));
    return "";
}

func CollectionRuntimeKindCode(kind: String) -> Int {
    let checked: String = CollectionRuntimeRequireKind(kind, "array kind code");
    if checked == "ArrayString" {
        return 2;
    }
    if checked == "ArrayCodegenAstTextNode" {
        return 3;
    }
    if checked == "ArrayBool" {
        return 4;
    }
    if checked == "ArrayFloat" {
        return 5;
    }
    if checked == "ArrayDouble" {
        return 6;
    }
    if checked == "ArrayLong" {
        return 7;
    }
    return 1;
}

func CollectionRuntimeElementTypeFromKindCode(kind_code: Int) -> String {
    if kind_code == 2 {
        return "String";
    }
    if kind_code == 3 {
        return "CodegenAstTextNode";
    }
    if kind_code == 4 {
        return "Bool";
    }
    if kind_code == 5 {
        return "Float";
    }
    if kind_code == 6 {
        return "Double";
    }
    if kind_code == 7 {
        return "Long";
    }
    return "Int";
}

func CollectionRuntimeKindCodeOrDie(kind_code: Int, context: String) -> Int {
    if kind_code >= 1 && kind_code <= 7 {
        return kind_code;
    }
    Die(Concat(context, Concat(" requires collection kind code 1 through 7, got: ", ToString(kind_code))));
    return 0;
}

func CollectionRuntimeCSymbolPrefix(kind_code: Int) -> String {
    let checked: Int = CollectionRuntimeKindCodeOrDie(
        kind_code, "collection runtime symbol"
    );
    if checked == 2 { return "pgy_as"; }
    if checked == 3 { return "pgy_CodegenAstTextNode_array"; }
    if checked == 4 { return "pgy_ab"; }
    if checked == 5 { return "pgy_af"; }
    if checked == 6 { return "pgy_ad"; }
    if checked == 7 { return "pgy_al"; }
    return "pgy_ai";
}

func CollectionRuntimeCNewFn(kind_code: Int) -> String {
    return Concat(CollectionRuntimeCSymbolPrefix(kind_code), "_new");
}

func CollectionRuntimeCPushFn(kind_code: Int) -> String {
    return Concat(CollectionRuntimeCSymbolPrefix(kind_code), "_push");
}

func CollectionRuntimeCSetFn(kind_code: Int) -> String {
    return Concat(CollectionRuntimeCSymbolPrefix(kind_code), "_set");
}

func CollectionRuntimeCGetFn(kind_code: Int) -> String {
    return Concat(CollectionRuntimeCSymbolPrefix(kind_code), "_get");
}

func CollectionRuntimeCLenFn(kind_code: Int) -> String {
    return Concat(CollectionRuntimeCSymbolPrefix(kind_code), "_len");
}

func CollectionRuntimeCPopFn(kind_code: Int) -> String {
    return Concat(CollectionRuntimeCSymbolPrefix(kind_code), "_pop");
}

func CollectionRuntimeCDropStorageFn(kind_code: Int) -> String {
    let checked: Int = CollectionRuntimeKindCodeOrDie(
        kind_code, "array storage drop"
    );
    if checked == 2 { return "pgy_as_drop_storage"; }
    if checked != 1 {
        Die("self-host CompilerRetireArrayStorage supports only Array<Int>/Array<String>");
    }
    return "pgy_ai_drop_storage";
}

func CollectionRuntimeFactFromKind(
    kind: String, env: CodegenTypeEnv
) -> CollectionRuntimeFact {
    if kind == "ArrayInt" || kind == "ArrayLong" || kind == "ArrayString" ||
        kind == "ArrayBool" || kind == "ArrayFloat" || kind == "ArrayDouble" ||
        kind == "ArrayCodegenAstTextNode" {
        let kind_code: Int = CollectionRuntimeKindCode(kind);
        let c_array_type: String = CompilerAbiLayoutArrayIntCValueType();
        if kind == "ArrayLong" {
            c_array_type = CompilerAbiLayoutArrayLongCValueType();
        } else if kind == "ArrayString" {
            c_array_type = CompilerAbiLayoutArrayStringCValueType();
        } else if kind == "ArrayBool" {
            c_array_type = CompilerAbiLayoutArrayBoolCValueType();
        } else if kind == "ArrayFloat" {
            c_array_type = "pgy_af";
        } else if kind == "ArrayDouble" {
            c_array_type = "pgy_ad";
        } else if kind == "ArrayCodegenAstTextNode" {
            c_array_type =
                CompilerAbiLayoutArrayCodegenAstTextNodeCValueType();
        }
        return CollectionRuntimeFact(
            true, kind,
            CollectionRuntimeElementTypeFromKindCode(kind_code),
            c_array_type,
            CollectionRuntimeCNewFn(kind_code),
            CollectionRuntimeCPushFn(kind_code),
            CollectionRuntimeCSetFn(kind_code),
            CollectionRuntimeCGetFn(kind_code),
            CollectionRuntimeCLenFn(kind_code),
            CollectionRuntimeCPopFn(kind_code)
        );
    }
    let record_element: Option<String> =
        CollectionRuntimeRecordElementType(kind);
    if IsSome(record_element) {
        let element_type: String = UnwrapOption(record_element);
        if LookupKindType(env, element_type, "s") != "struct" {
            Die(Concat(
                "nominal array element is not a declared struct: ",
                element_type
            ));
        }
        let layout: CompilerAbiNominalArrayLayoutFact =
            CompilerAbiNominalArrayLayoutFactFor(element_type);
        if !layout.ok {
            Die("nominal array ABI/layout fact is missing");
        }
        return CollectionRuntimeFact(
            true, kind, element_type, layout.c_value_type,
            Concat(layout.c_value_type, "_new"),
            Concat(layout.c_value_type, "_push"),
            Concat(layout.c_value_type, "_set"),
            Concat(layout.c_value_type, "_get"),
            Concat(layout.c_value_type, "_len"),
            Concat(layout.c_value_type, "_pop")
        );
    }
    Die(Concat("unsupported collection runtime kind: ", kind));
    return CollectionRuntimeFact(
        false, "", "", "", "", "", "", "", "", ""
    );
}

func CollectionRuntimeFactFromTypeName(
    type_name: String, env: CodegenTypeEnv
) -> CollectionRuntimeFact {
    let builtin: Option<String> =
        CollectionRuntimeBuiltinKindFromTypeName(type_name);
    if IsSome(builtin) {
        return CollectionRuntimeFactFromKind(
            UnwrapOption(builtin), env
        );
    }
    let element: Option<String> = SemanticArrayElementType(type_name);
    if IsSome(element) {
        let element_type: String = UnwrapOption(element);
        if LookupKindType(env, element_type, "s") == "struct" {
            return CollectionRuntimeFactFromKind(type_name, env);
        }
    }
    Die(Concat(
        "unsupported collection type; nominal arrays require a declared struct: ",
        type_name
    ));
    return CollectionRuntimeFact(
        false, "", "", "", "", "", "", "", "", ""
    );
}

func CollectionRuntimeCIntSortFn() -> String {
    return "pgy_ai_sort";
}

func CollectionRuntimeCIntReverseFn() -> String {
    return "pgy_ai_reverse";
}

func CollectionRuntimeCIntMapFn() -> String {
    return "pgy_ai_map";
}

func CollectionRuntimeCIntFilterFn() -> String {
    return "pgy_ai_filter";
}

func CollectionRuntimeCOwnedStringPushFn() -> String {
    return "pgy_as_push_owned";
}

func CollectionRuntimeCOwnedStringDropFn() -> String {
    return "pgy_as_drop_owned";
}

func CollectionRuntimeCArrayBlock(uses_array_sort: Bool, uses_array_reverse: Bool,
                                  uses_array_map: Bool, uses_array_filter: Bool) -> String {
    let int_array_type: String = CompilerAbiLayoutArrayIntCValueType();
    let long_array_type: String = CompilerAbiLayoutArrayLongCValueType();
    let string_array_type: String = CompilerAbiLayoutArrayStringCValueType();
    let bool_array_type: String = CompilerAbiLayoutArrayBoolCValueType();
    let block: String = "";
    block = Concat(block, Concat("typedef struct { int32_t *data; long long len; long long cap; } ", Concat(int_array_type, ";\n")));
    block = Concat(block, Concat("typedef struct { int64_t *data; long long len; long long cap; } ", Concat(long_array_type, ";\n")));
    block = Concat(block, Concat("typedef struct { const char **data; long long len; long long cap; } ", Concat(string_array_type, ";\n\n")));
    block = Concat(block, Concat("static ", Concat(int_array_type, Concat(" ", Concat(CollectionRuntimeCNewFn(1), Concat("(void) { ", Concat(int_array_type, " a; a.data = NULL; a.len = 0; a.cap = 0; return a; }\n")))))));
    block = Concat(block, Concat("static void ", Concat(CollectionRuntimeCPushFn(1), Concat("(", Concat(int_array_type, " *a, int32_t v) {\n")))));
    block = Concat(block, "    if (a->len == a->cap) { a->cap = a->cap ? a->cap * 2 : 4; a->data = (int32_t *)realloc(a->data, (size_t)a->cap * sizeof(int32_t)); }\n");
    block = Concat(block, "    a->data[a->len++] = v;\n}\n");
    block = Concat(block, CollectionRuntimeCGuardedGet("int32_t", CollectionRuntimeCGetFn(1), int_array_type));
    block = Concat(block, CollectionRuntimeCGuardedSet(CollectionRuntimeCSetFn(1), int_array_type, "int32_t"));
    block = Concat(block, Concat("static int32_t ", Concat(CollectionRuntimeCLenFn(1), Concat("(", Concat(int_array_type, " a) { return (int32_t)a.len; }\n")))));
    block = Concat(block, Concat("static int32_t ", Concat(CollectionRuntimeCPopFn(1), Concat("(", Concat(int_array_type, " *a) { return a->len > 0 ? a->data[--a->len] : 0; }\n\n")))));
    block = Concat(block, Concat("static void ", Concat(CollectionRuntimeCDropStorageFn(1), Concat("(", Concat(int_array_type, " *a) { if (a == NULL) return; free(a->data); a->data = NULL; a->len = 0; a->cap = 0; }\n\n")))));
    if uses_array_sort {
        block = Concat(block, "static int pgy_ai_cmp(const void *pa, const void *pb)\n{\n");
        block = Concat(block, "    int32_t a = *(const int32_t *)pa;\n    int32_t b = *(const int32_t *)pb;\n");
        block = Concat(block, "    return (a > b) - (a < b);\n}\n");
        block = Concat(block, Concat("static ", Concat(int_array_type, Concat(" ", Concat(CollectionRuntimeCIntSortFn(), Concat("(", Concat(int_array_type, " a)\n{\n")))))));
        block = Concat(block, "    if (a.len > 1) { qsort(a.data, (size_t)a.len, sizeof(int32_t), pgy_ai_cmp); }\n");
        block = Concat(block, "    return a;\n}\n\n");
    }
    if uses_array_reverse {
        block = Concat(block, Concat("static ", Concat(int_array_type, Concat(" ", Concat(CollectionRuntimeCIntReverseFn(), Concat("(", Concat(int_array_type, " a)\n{\n")))))));
        block = Concat(block, Concat("    ", Concat(int_array_type, Concat(" out = ", Concat(CollectionRuntimeCNewFn(1), "();\n")))));
        block = Concat(block, Concat("    for (long long i = a.len; i > 0; i--) { ", Concat(CollectionRuntimeCPushFn(1), "(&out, a.data[i - 1]); }\n")));
        block = Concat(block, "    return out;\n}\n\n");
    }
    if uses_array_map {
        block = Concat(block, Concat("static ", Concat(int_array_type, Concat(" ", Concat(CollectionRuntimeCIntMapFn(), Concat("(", Concat(int_array_type, " a, int32_t (*fn)(int32_t))\n{\n")))))));
        block = Concat(block, Concat("    ", Concat(int_array_type, Concat(" out = ", Concat(CollectionRuntimeCNewFn(1), "();\n")))));
        block = Concat(block, Concat("    for (long long i = 0; i < a.len; i++) { ", Concat(CollectionRuntimeCPushFn(1), "(&out, fn(a.data[i])); }\n")));
        block = Concat(block, "    return out;\n}\n\n");
    }
    if uses_array_filter {
        block = Concat(block, Concat("static ", Concat(int_array_type, Concat(" ", Concat(CollectionRuntimeCIntFilterFn(), Concat("(", Concat(int_array_type, " a, bool (*pred)(int32_t))\n{\n")))))));
        block = Concat(block, Concat("    ", Concat(int_array_type, Concat(" out = ", Concat(CollectionRuntimeCNewFn(1), "();\n")))));
        block = Concat(block, Concat("    for (long long i = 0; i < a.len; i++) { if (pred(a.data[i])) { ", Concat(CollectionRuntimeCPushFn(1), "(&out, a.data[i]); } }\n")));
        block = Concat(block, "    return out;\n}\n\n");
    }
    block = Concat(block, Concat("static ", Concat(long_array_type, Concat(" ", Concat(CollectionRuntimeCNewFn(7), Concat("(void) { ", Concat(long_array_type, " a; a.data = NULL; a.len = 0; a.cap = 0; return a; }\n")))))));
    block = Concat(block, Concat("static void ", Concat(CollectionRuntimeCPushFn(7), Concat("(", Concat(long_array_type, " *a, int64_t v) { if (a->len == a->cap) { a->cap = a->cap ? a->cap * 2 : 4; a->data = (int64_t *)realloc(a->data, (size_t)a->cap * sizeof(int64_t)); } a->data[a->len++] = v; }\n")))));
    block = Concat(block, CollectionRuntimeCGuardedGet("int64_t", CollectionRuntimeCGetFn(7), long_array_type));
    block = Concat(block, CollectionRuntimeCGuardedSet(CollectionRuntimeCSetFn(7), long_array_type, "int64_t"));
    block = Concat(block, Concat("static int32_t ", Concat(CollectionRuntimeCLenFn(7), Concat("(", Concat(long_array_type, " a) { return (int32_t)a.len; }\n")))));
    block = Concat(block, Concat("static int64_t ", Concat(CollectionRuntimeCPopFn(7), Concat("(", Concat(long_array_type, " *a) { return a->len > 0 ? a->data[--a->len] : 0; }\n\n")))));
    block = Concat(block, Concat("static ", Concat(string_array_type, Concat(" ", Concat(CollectionRuntimeCNewFn(2), Concat("(void) { ", Concat(string_array_type, " a; a.data = NULL; a.len = 0; a.cap = 0; return a; }\n")))))));
    block = Concat(block, Concat("static void ", Concat(CollectionRuntimeCPushFn(2), Concat("(", Concat(string_array_type, " *a, const char *v) {\n")))));
    block = Concat(block, "    if (a->len == a->cap) { a->cap = a->cap ? a->cap * 2 : 4; a->data = (const char **)realloc(a->data, (size_t)a->cap * sizeof(const char *)); }\n");
    block = Concat(block, "    a->data[a->len++] = v;\n}\n");
    block = Concat(block, "static char *pgy_as_owned_copy(const char *v) {\n");
    block = Concat(block, "    const char *source = v != NULL ? v : \"\";\n");
    block = Concat(block, "    size_t length = strlen(source);\n");
    block = Concat(block, "    if (length == (size_t)-1) { PGY_RUNTIME_PANIC(PGY_RUNTIME_PANIC_CLASS_OOM, PGY_RUNTIME_PANIC_REASON_ALLOCATION_FAILED); }\n");
    block = Concat(block, "    char *copy = (char *)malloc(length + 1);\n");
    block = Concat(block, "    if (copy == NULL) { PGY_RUNTIME_PANIC(PGY_RUNTIME_PANIC_CLASS_OOM, PGY_RUNTIME_PANIC_REASON_ALLOCATION_FAILED); }\n");
    block = Concat(block, "    memcpy(copy, source, length + 1);\n    return copy;\n}\n");
    block = Concat(block, Concat("static void ", Concat(CollectionRuntimeCOwnedStringPushFn(), Concat("(", Concat(string_array_type, " *a, const char *v) {\n")))));
    block = Concat(block, "    if (a->len == a->cap) {\n");
    block = Concat(block, "        long long next_cap = a->cap ? a->cap * 2 : 4;\n");
    block = Concat(block, "        if (next_cap <= a->cap || (size_t)next_cap > (size_t)-1 / sizeof(const char *)) { PGY_RUNTIME_PANIC(PGY_RUNTIME_PANIC_CLASS_OOM, PGY_RUNTIME_PANIC_REASON_ALLOCATION_FAILED); }\n");
    block = Concat(block, "        const char **next_data = (const char **)realloc(a->data, (size_t)next_cap * sizeof(const char *));\n");
    block = Concat(block, "        if (next_data == NULL) { PGY_RUNTIME_PANIC(PGY_RUNTIME_PANIC_CLASS_OOM, PGY_RUNTIME_PANIC_REASON_ALLOCATION_FAILED); }\n");
    block = Concat(block, "        a->data = next_data; a->cap = next_cap;\n    }\n");
    block = Concat(block, "    a->data[a->len++] = pgy_as_owned_copy(v);\n}\n");
    block = Concat(block, Concat("static void ", Concat(CollectionRuntimeCOwnedStringDropFn(), Concat("(", Concat(string_array_type, " *a) {\n")))));
    block = Concat(block, "    if (a == NULL) { return; }\n");
    block = Concat(block, "    for (long long i = 0; i < a->len; i++) { free((void *)a->data[i]); }\n");
    block = Concat(block, "    free(a->data); a->data = NULL; a->len = 0; a->cap = 0;\n}\n");
    block = Concat(block, CollectionRuntimeCGuardedGet("const char *", CollectionRuntimeCGetFn(2), string_array_type));
    block = Concat(block, CollectionRuntimeCGuardedSet(CollectionRuntimeCSetFn(2), string_array_type, "const char *"));
    block = Concat(block, Concat("static long long ", Concat(CollectionRuntimeCLenFn(2), Concat("(", Concat(string_array_type, " a) { return a.len; }\n")))));
    block = Concat(block, Concat("static const char *", Concat(CollectionRuntimeCPopFn(2), Concat("(", Concat(string_array_type, " *a) { return a->len > 0 ? a->data[--a->len] : \"\"; }\n\n")))));
    block = Concat(block, Concat("static void ", Concat(CollectionRuntimeCDropStorageFn(2), Concat("(", Concat(string_array_type, " *a) { if (a == NULL) return; free(a->data); a->data = NULL; a->len = 0; a->cap = 0; }\n\n")))));
    block = Concat(block, Concat("typedef struct { bool *data; long long len; long long cap; } ", Concat(bool_array_type, ";\n")));
    block = Concat(block, Concat("static ", Concat(bool_array_type, Concat(" ", Concat(CollectionRuntimeCNewFn(4), Concat("(void) { ", Concat(bool_array_type, " a; a.data = NULL; a.len = 0; a.cap = 0; return a; }\n")))))));
    block = Concat(block, Concat("static void ", Concat(CollectionRuntimeCPushFn(4), Concat("(", Concat(bool_array_type, " *a, bool v) {\n")))));
    block = Concat(block, "    if (a->len == a->cap) { a->cap = a->cap ? a->cap * 2 : 4; a->data = (bool *)realloc(a->data, (size_t)a->cap * sizeof(bool)); }\n");
    block = Concat(block, "    a->data[a->len++] = v;\n}\n");
    block = Concat(block, CollectionRuntimeCGuardedGet("bool", CollectionRuntimeCGetFn(4), bool_array_type));
    block = Concat(block, CollectionRuntimeCGuardedSet(CollectionRuntimeCSetFn(4), bool_array_type, "bool"));
    block = Concat(block, Concat("static long long ", Concat(CollectionRuntimeCLenFn(4), Concat("(", Concat(bool_array_type, " a) { return a.len; }\n")))));
    block = Concat(block, Concat("static bool ", Concat(CollectionRuntimeCPopFn(4), Concat("(", Concat(bool_array_type, " *a) { return a->len > 0 ? a->data[--a->len] : false; }\n\n")))));
    block = Concat(block, "typedef struct { float *data; long long len; long long cap; } pgy_af;\n");
    block = Concat(block, "static pgy_af pgy_af_new(void) { pgy_af a; a.data = NULL; a.len = 0; a.cap = 0; return a; }\n");
    block = Concat(block, "static void pgy_af_push(pgy_af *a, float v) {\n");
    block = Concat(block, "    if (a->len == a->cap) { a->cap = a->cap ? a->cap * 2 : 4; a->data = (float *)realloc(a->data, (size_t)a->cap * sizeof(float)); }\n");
    block = Concat(block, "    a->data[a->len++] = v;\n}\n");
    block = Concat(block, "static float pgy_af_get(pgy_af a, long long i) { return a.data[i]; }\n");
    block = Concat(block, "static void pgy_af_set(pgy_af *a, long long i, float v) { a->data[i] = v; }\n");
    block = Concat(block, "static long long pgy_af_len(pgy_af a) { return a.len; }\n");
    block = Concat(block, "static float pgy_af_pop(pgy_af *a) { return a->len > 0 ? a->data[--a->len] : 0.0f; }\n\n");
    block = Concat(block, "typedef struct { double *data; long long len; long long cap; } pgy_ad;\n");
    block = Concat(block, "static pgy_ad pgy_ad_new(void) { pgy_ad a; a.data = NULL; a.len = 0; a.cap = 0; return a; }\n");
    block = Concat(block, "static void pgy_ad_push(pgy_ad *a, double v) {\n");
    block = Concat(block, "    if (a->len == a->cap) { a->cap = a->cap ? a->cap * 2 : 4; a->data = (double *)realloc(a->data, (size_t)a->cap * sizeof(double)); }\n");
    block = Concat(block, "    a->data[a->len++] = v;\n}\n");
    block = Concat(block, "static double pgy_ad_get(pgy_ad a, long long i) { return a.data[i]; }\n");
    block = Concat(block, "static void pgy_ad_set(pgy_ad *a, long long i, double v) { a->data[i] = v; }\n");
    block = Concat(block, "static long long pgy_ad_len(pgy_ad a) { return a.len; }\n");
    block = Concat(block, "static double pgy_ad_pop(pgy_ad *a) { return a->len > 0 ? a->data[--a->len] : 0.0; }\n\n");
    return block;
}

func CollectionRuntimeCodegenAstTextNodeArrayBlock() -> String {
    let array_type: String = CompilerAbiLayoutArrayCodegenAstTextNodeCValueType();
    let block: String = "";
    block = Concat(block, Concat("typedef struct { CodegenAstTextNode *data; long long len; long long cap; } ", Concat(array_type, ";\n\n")));
    block = Concat(block, Concat("static ", Concat(array_type, Concat(" ", Concat(CollectionRuntimeCNewFn(3), Concat("(void) { ", Concat(array_type, " a; a.data = NULL; a.len = 0; a.cap = 0; return a; }\n")))))));
    block = Concat(block, Concat("static void ", Concat(CollectionRuntimeCPushFn(3), Concat("(", Concat(array_type, " *a, CodegenAstTextNode v) {\n")))));
    block = Concat(block, "    if (a->len == a->cap) { a->cap = a->cap ? a->cap * 2 : 4; a->data = (CodegenAstTextNode *)realloc(a->data, (size_t)a->cap * sizeof(CodegenAstTextNode)); }\n");
    block = Concat(block, "    a->data[a->len++] = v;\n}\n");
    block = Concat(block, CollectionRuntimeCGuardedGet("CodegenAstTextNode", CollectionRuntimeCGetFn(3), array_type));
    block = Concat(block, CollectionRuntimeCGuardedSet(CollectionRuntimeCSetFn(3), array_type, "CodegenAstTextNode"));
    block = Concat(block, Concat("static long long ", Concat(CollectionRuntimeCLenFn(3), Concat("(", Concat(array_type, " a) { return a.len; }\n")))));
    block = Concat(block, Concat("static CodegenAstTextNode ", Concat(CollectionRuntimeCPopFn(3), Concat("(", Concat(array_type, " *a) { return a->len > 0 ? a->data[--a->len] : (CodegenAstTextNode){0, \"\", -1, 0}; }\n\n")))));
    return block;
}

func CollectionRuntimeNominalRecordArrayBlock(
    element_type: String
) -> String {
    let layout: CompilerAbiNominalArrayLayoutFact =
        CompilerAbiNominalArrayLayoutFactFor(element_type);
    if !layout.ok {
        Die("nominal array ABI/layout fact is missing");
    }
    let env: CodegenTypeEnv = CodegenTypeEnvFromRows(
        Concat("|", Concat(element_type, "=s:struct|")), ""
    );
    let fact: CollectionRuntimeFact =
        CollectionRuntimeFactFromTypeName(
            Concat("Array<", Concat(element_type, ">")), env
        );
    let block: String = "";
    block = Concat(block, Concat(
        "typedef struct { ",
        Concat(layout.c_element_type, Concat(
            " *data; long long len; long long cap; } ",
            Concat(layout.c_value_type, ";\n\n")
        ))
    ));
    block = Concat(block, Concat(
        "static ", Concat(layout.c_value_type, Concat(
            " ", Concat(fact.c_new_fn, Concat(
                "(void) { ", Concat(
                    layout.c_value_type,
                    " a; a.data = NULL; a.len = 0; a.cap = 0; return a; }\n"
                )
            ))
        ))
    ));
    block = Concat(block, Concat(
        "static void ", Concat(fact.c_push_fn, Concat(
            "(", Concat(layout.c_value_type, Concat(
                " *a, ", Concat(layout.c_element_type, " v) {\n")
            ))
        ))
    ));
    block = Concat(block, Concat(
        "    if (a->len == a->cap) { a->cap = a->cap ? a->cap * 2 : 4; a->data = (",
        Concat(layout.c_element_type, Concat(
            " *)realloc(a->data, (size_t)a->cap * sizeof(",
            Concat(layout.c_element_type, ")); }\n")
        ))
    ));
    block = Concat(block, "    a->data[a->len++] = v;\n}\n");
    block = Concat(block, Concat(
        "static ", Concat(layout.c_element_type, Concat(
            " ", Concat(fact.c_get_fn, Concat(
                "(", Concat(layout.c_value_type,
                    " a, long long i) { return a.data[i]; }\n")
            ))
        ))
    ));
    block = Concat(block, Concat(
        "static void ", Concat(fact.c_set_fn, Concat(
            "(", Concat(layout.c_value_type, Concat(
                " *a, long long i, ", Concat(
                    layout.c_element_type,
                    " v) { a->data[i] = v; }\n"
                )
            ))
        ))
    ));
    block = Concat(block, Concat(
        "static long long ", Concat(fact.c_len_fn, Concat(
            "(", Concat(layout.c_value_type,
                " a) { return a.len; }\n")
        ))
    ));
    block = Concat(block, Concat(
        "static ", Concat(layout.c_element_type, Concat(
            " ", Concat(fact.c_pop_fn, Concat(
                "(", Concat(layout.c_value_type, Concat(
                    " *a) { return a->len > 0 ? a->data[--a->len] : (",
                    Concat(layout.c_element_type, "){0}; }\n\n")
                ))
            ))
        ))
    ));
    return block;
}

func CollectionRuntimeRecordArrayBlocks(
    uses_ast_text_node_array: Bool,
    nominal_element_types: Array<String>
) -> String {
    let blocks: Array<String> = [];
    if uses_ast_text_node_array {
        ArrayPush(
            blocks,
            CollectionRuntimeCodegenAstTextNodeArrayBlock()
        );
    }
    let index: Int = 0;
    while index < ArrayLength(nominal_element_types) {
        ArrayPush(
            blocks,
            CollectionRuntimeNominalRecordArrayBlock(
                nominal_element_types[index]
            )
        );
        index = index + 1;
    }
    return StringJoin(blocks, "");
}
