// src/self_hosted/codegen/runtime_abi/host_io_runtime_owner.pgy
//
// Self-host C host file/argv runtime symbol facts for the supported codegen subset.

import "collection_runtime_owner.pgy";

func HostIORuntimeCFileExistsFn() -> String {
    return "pgy_fexists";
}

func HostIORuntimeCWriteFileFn() -> String {
    return "pgy_writefile";
}

func HostIORuntimeCFileOpenFn() -> String {
    return "pgy_fopen";
}

func HostIORuntimeCSecureFileOpenFn() -> String {
    return "pgy_secure_fopen";
}

func HostIORuntimeCFileWriteFn() -> String {
    return "pgy_fwrite";
}

func HostIORuntimeCFileCloseFn() -> String {
    return "pgy_fclose";
}

func HostIORuntimeCFileReadFn() -> String {
    return "pgy_fread";
}

func HostIORuntimeCReadFileFn() -> String {
    return "pgy_readfile";
}

func HostIORuntimeCReadStdinFn() -> String {
    return "pgy_readstdin";
}

func HostIORuntimeCDirWalkFn() -> String {
    return "pgy_dirwalk";
}

func HostIORuntimeCArgsFn() -> String {
    return "pgy_args";
}

func HostIORuntimeCExitFn() -> String {
    return "exit";
}

func HostIORuntimeCArgcGlobal() -> String {
    return "pgy_argc";
}

func HostIORuntimeCArgvGlobal() -> String {
    return "pgy_argv";
}

func HostIORuntimeCArgsCapturePrefix() -> String {
    let block: String = "";
    block = Concat(block, Concat("    ", Concat(HostIORuntimeCArgcGlobal(), " = argc;\n")));
    block = Concat(block, Concat("    ", Concat(HostIORuntimeCArgvGlobal(), " = argv;\n")));
    return block;
}

func HostIORuntimeCArgsBlock() -> String {
    let block: String = "";
    block = Concat(block, Concat("static int ", Concat(HostIORuntimeCArgcGlobal(), " = 0;\n")));
    block = Concat(block, Concat("static char **", Concat(HostIORuntimeCArgvGlobal(), " = NULL;\n")));
    block = Concat(block, Concat("static pgy_as ", Concat(HostIORuntimeCArgsFn(), "(void)\n{\n")));
    block = Concat(block, Concat("    pgy_as a = ", Concat(CollectionRuntimeCNewFn(2), "();\n")));
    block = Concat(block, Concat("    for (int i = 1; i < ", Concat(HostIORuntimeCArgcGlobal(), Concat("; i++) { ", Concat(CollectionRuntimeCPushFn(2), Concat("(&a, ", Concat(HostIORuntimeCArgvGlobal(), "[i]); }\n")))))));
    block = Concat(block, "    return a;\n}\n\n");
    return block;
}
