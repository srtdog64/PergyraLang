func HostIORuntimeCArgsFn() -> String {
    // The canonical runtime header already owns pgy_args with a different
    // aggregate ABI. Keep the standalone self-host helper identity distinct.
    return "pgy_selfhost_args";
}

func HostIORuntimeCExitFn() -> String {
    return "exit";
}

func HostIORuntimeCArgcGlobal() -> String {
    return "pgy_argc";
