// What Log writes for a String, the same on every backend.
//
// The runtime writes a String value as it is and then a line break unless it
// already ends with one (pgy_log_string, src/runtime/pgy_runtime_lib_core_exports.h).
// A String literal argument that holds a line break is first normalized as a
// banner (src/codegen/c/transpiler_log_normalize.c, which native C and LLVM
// both apply): one leading line break is dropped, every trailing one is
// dropped, and the indent its content lines share is removed. A literal
// without a line break is written unchanged.
import "../../lib/source_scan_owner.pgy";

func LogLineTextIsBreak(character: String) -> Bool {
    return character == "\n" || character == "\r";
}

func LogLineTextIsBlank(character: String) -> Bool {
    return character == " " || character == "\t";
}

func LogLineLiteralHasBreak(raw: String) -> Bool {
    var index: Int = 0;
    while index < StringLength(raw) {
        if LogLineTextIsBreak(SourceCharAt(raw, index)) { return true; }
        index = index + 1;
    }
    return false;
}

// The end of the line that starts at `line`, bounded by `end`.
func LogLineTextLineEnd(raw: String, line: Int, end: Int) -> Int {
    var line_end: Int = line;
    while line_end < end && !LogLineTextIsBreak(SourceCharAt(raw, line_end)) {
        line_end = line_end + 1;
    }
    return line_end;
}

// The start of the line after the break at `line_end` (a CR LF pair is one break).
func LogLineTextNextLine(raw: String, line_end: Int, end: Int) -> Int {
    if SourceCharAt(raw, line_end) == "\r" && line_end + 1 < end &&
        SourceCharAt(raw, line_end + 1) == "\n" {
        return line_end + 2;
    }
    return line_end + 1;
}

func LogLineBannerText(raw: String) -> String {
    let length: Int = StringLength(raw);
    var start: Int = 0;
    if length > 0 && SourceCharAt(raw, 0) == "\n" {
        start = 1;
    } else if length > 0 && SourceCharAt(raw, 0) == "\r" {
        start = 1;
        if length > 1 && SourceCharAt(raw, 1) == "\n" { start = 2; }
    }
    var end: Int = length;
    while end > start && LogLineTextIsBreak(SourceCharAt(raw, end - 1)) {
        end = end - 1;
    }
    // The least indent among lines that hold more than blanks.
    var shared_indent: Int = 0;
    var found: Bool = false;
    var line: Int = start;
    while line < end {
        let line_end: Int = LogLineTextLineEnd(raw, line, end);
        var indent: Int = 0;
        while line + indent < line_end &&
            LogLineTextIsBlank(SourceCharAt(raw, line + indent)) {
            indent = indent + 1;
        }
        if line + indent < line_end && (!found || indent < shared_indent) {
            shared_indent = indent;
            found = true;
        }
        if line_end == end {
            line = end;
        } else {
            line = LogLineTextNextLine(raw, line_end, end);
        }
    }
    var text: String = "";
    line = start;
    while line < end {
        let line_end: Int = LogLineTextLineEnd(raw, line, end);
        var body: Int = line;
        var blank_only: Bool = true;
        var scan: Int = line;
        while scan < line_end {
            if !LogLineTextIsBlank(SourceCharAt(raw, scan)) { blank_only = false; }
            scan = scan + 1;
        }
        if blank_only {
            body = line_end;
        } else {
            var removed: Int = 0;
            while removed < shared_indent && body < line_end &&
                LogLineTextIsBlank(SourceCharAt(raw, body)) {
                body = body + 1;
                removed = removed + 1;
            }
        }
        if line_end > body {
            text = Concat(text, Substring(raw, body, line_end - body));
        }
        if line_end < end {
            text = Concat(text, "\n");
            line = LogLineTextNextLine(raw, line_end, end);
        } else {
            line = end;
        }
    }
    return text;
}

// The text a Log of this String literal writes before the runtime line rule.
func LogLineLiteralText(raw: String) -> String {
    if !LogLineLiteralHasBreak(raw) { return raw; }
    return LogLineBannerText(raw);
}
