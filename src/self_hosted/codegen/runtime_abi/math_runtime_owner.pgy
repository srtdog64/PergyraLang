// src/self_hosted/codegen/runtime_abi/math_runtime_owner.pgy
//
// Self-host C math/random runtime symbol facts for the supported codegen subset.

import "../../compiler/abi_layout_row_owner.pgy";

func MathRuntimeCAbsFn() -> String {
    return "pgy_abs";
}

func MathRuntimeCMinFn() -> String {
    return "pgy_min";
}

func MathRuntimeCMaxFn() -> String {
    return "pgy_max";
}

func MathRuntimeCSqrtFn() -> String {
    return "sqrt";
}

func MathRuntimeCPowFn() -> String {
    return "pow";
}

func MathRuntimeCFloorFn() -> String {
    return "floor";
}

func MathRuntimeCCeilFn() -> String {
    return "ceil";
}

// Float math builtins. Pergyra Float is C float, and native C lowers these to
// the runtime's float wrappers over the <math.h> f-suffixed functions
// (src/runtime/pgy_runtime_scalar_std_inline.h), so the default route calls
// the same f-suffixed functions.
func MathRuntimeCLibmFloatFn(source_name: String) -> Option<String> {
    if source_name == "Acos" { return Some("acosf"); }
    if source_name == "Asin" { return Some("asinf"); }
    if source_name == "Atan" { return Some("atanf"); }
    if source_name == "Atan2" { return Some("atan2f"); }
    if source_name == "Cos" { return Some("cosf"); }
    if source_name == "Exp" { return Some("expf"); }
    if source_name == "Log10" { return Some("log10f"); }
    if source_name == "Log2" { return Some("log2f"); }
    if source_name == "MathLog" { return Some("logf"); }
    if source_name == "Round" { return Some("roundf"); }
    if source_name == "Sin" { return Some("sinf"); }
    if source_name == "Tan" { return Some("tanf"); }
    return None;
}

// E() and PI() are Float constants; the literals are native's PGY_E/PGY_PI.
func MathRuntimeCFloatConstantLiteral(source_name: String) -> Option<String> {
    if source_name == "E" { return Some("2.71828182845904523536f"); }
    if source_name == "PI" { return Some("3.14159265358979323846f"); }
    return None;
}

func MathRuntimeCSeedRandomFn() -> String {
    return "pgy_seedrandom";
}

func MathRuntimeCRandomFn() -> String {
    return "pgy_random";
}

func MathRuntimeCRandomValueBlock() -> String {
    let int_type: String = CompilerAbiLayoutIntCValueType();
    let block: String = "";
    block = Concat(block, Concat("static ", Concat(int_type, Concat(" ", Concat(MathRuntimeCRandomFn(), Concat("(", Concat(int_type, " n)\n{\n")))))));
    block = Concat(block, "    return n > 0 ? (long long)(rand() % n) : 0;\n}\n\n");
    return block;
}

func MathRuntimeCSeedRandomBlock() -> String {
    let int_type: String = CompilerAbiLayoutIntCValueType();
    let block: String = "";
    block = Concat(block, Concat("static void ", Concat(MathRuntimeCSeedRandomFn(), Concat("(", Concat(int_type, " seed)\n{\n")))));
    block = Concat(block, "    srand((unsigned int)seed);\n}\n\n");
    return block;
}

// Abs, Min and Max take Int, Long and Float operands through one call-site
// rewrite that does not see the operand type, so the helpers must not pick a
// width either: an int32_t signature truncated every Long operand. They
// evaluate each operand once, left to right, and keep its type, as the native
// C emitter does.
func MathRuntimeCIntUtilityBlock() -> String {
    let block: String = "";
    block = Concat(block, Concat("#define ", Concat(MathRuntimeCAbsFn(), "(v) (({ __auto_type pgy_abs_v_ = (v); pgy_abs_v_ < 0 ? -pgy_abs_v_ : pgy_abs_v_; }))\n")));
    block = Concat(block, Concat("#define ", Concat(MathRuntimeCMinFn(), "(a, b) (({ __auto_type pgy_min_a_ = (a); __auto_type pgy_min_b_ = (b); pgy_min_a_ < pgy_min_b_ ? pgy_min_a_ : pgy_min_b_; }))\n")));
    block = Concat(block, Concat("#define ", Concat(MathRuntimeCMaxFn(), "(a, b) (({ __auto_type pgy_max_a_ = (a); __auto_type pgy_max_b_ = (b); pgy_max_a_ > pgy_max_b_ ? pgy_max_a_ : pgy_max_b_; }))\n\n")));
    return block;
}
