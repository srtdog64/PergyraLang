// src/self_hosted/codegen/runtime_abi/option_result_runtime_owner.pgy
//
// Self-host C Option/Result runtime symbol facts for the supported codegen subset.

import "../../compiler/abi_layout_row_owner.pgy";
import "../../compiler/symbol_table_owner.pgy";
import "../../semantic/ast_type_name_canonical_owner.pgy";
import "../../semantic/wrapper_type_owner.pgy";
import "../abi_layout/enum_abi_value_fact_owner.pgy";
import "../type_facts/type_env.pgy";
import "result_runtime_owner.pgy";

struct OptionStructRuntimeFact {
    let inner_type_name: String;
    let inner_c_type: String;
    let c_type: String;
    let some_fn: String;
    let none_fn: String;
}

struct OptionStructDefinitionBlockFact {
    let c_block: String;
    let requires_bool_header: Bool;
}

func OptionResultRuntimeCOptionSomeFn() -> String {
    return "pgy_option_some";
}

func OptionResultRuntimeOptionPayloadKindInt() -> Int {
    return 1;
}

func OptionResultRuntimeOptionPayloadKindString() -> Int {
    return 2;
}

func OptionResultRuntimeOptionPayloadKindFloat() -> Int {
    return 3;
}

func OptionResultRuntimeOptionPayloadKindDouble() -> Int {
    return 4;
}

func OptionResultRuntimeOptionPayloadKindBool() -> Int {
    return 5;
}

func OptionResultRuntimeOptionPayloadKindLong() -> Int {
    return 6;
}

func OptionResultRuntimeOptionPayloadKindFromExprKind(kind: String) -> Int {
    if kind == "String" {
        return OptionResultRuntimeOptionPayloadKindString();
    }
    if kind == "Float" {
        return OptionResultRuntimeOptionPayloadKindFloat();
    }
    if kind == "Double" {
        return OptionResultRuntimeOptionPayloadKindDouble();
    }
    if kind == "Bool" {
        return OptionResultRuntimeOptionPayloadKindBool();
    }
    if kind == "Long" {
        return OptionResultRuntimeOptionPayloadKindLong();
    }
    return OptionResultRuntimeOptionPayloadKindInt();
}

func OptionResultRuntimeOptionPayloadKindForType(type_name: String) -> Int {
    let inner: Option<String> = OptionResultRuntimeOptionInnerTypeName(
        type_name
    );
    if !IsSome(inner) { return 0; }
    let payload: String = UnwrapOption(inner);
    if payload == "String" {
        return OptionResultRuntimeOptionPayloadKindString();
    }
    if payload == "Int" {
        return OptionResultRuntimeOptionPayloadKindInt();
    }
    if payload == "Long" {
        return OptionResultRuntimeOptionPayloadKindLong();
    }
    if payload == "Float" {
        return OptionResultRuntimeOptionPayloadKindFloat();
    }
    if payload == "Double" {
        return OptionResultRuntimeOptionPayloadKindDouble();
    }
    if payload == "Bool" {
        return OptionResultRuntimeOptionPayloadKindBool();
    }
    return 0;
}

func OptionResultRuntimeOptionInnerTypeName(
    type_name: String
) -> Option<String> {
    let canonical: String = SemanticCanonicalTypeName(type_name);
    let inner: Option<String> = OptionPayloadTypeOpt(canonical);
    if !IsSome(inner) || UnwrapOption(inner) == "" { return None; }
    return Some(SemanticCanonicalTypeName(UnwrapOption(inner)));
}

func OptionResultRuntimeStructOptionFact(
    type_name: String,
    env: CodegenTypeEnv
) -> Option<OptionStructRuntimeFact> {
    let inner_opt: Option<String> =
        OptionResultRuntimeOptionInnerTypeName(type_name);
    if !IsSome(inner_opt) {
        return None;
    }
    let inner: String = UnwrapOption(inner_opt);
    let inner_c_type: String = "";
    let enum_fact: EnumAbiValueFact =
        EnumAbiValueFactFor(inner, env);
    let is_struct: Bool = LookupKindType(env, inner, "s") == "struct";
    if enum_fact.ok {
        inner_c_type = enum_fact.c_value_type;
    } else if is_struct {
        inner_c_type = CompilerSymbolCTypeName(inner);
    } else {
        let result_fact: ResultRuntimeFact = ResultRuntimeFactForType(inner);
        if result_fact.ok {
            inner_c_type = result_fact.c_type;
        } else {
            let nested_option: Option<OptionStructRuntimeFact> =
                OptionResultRuntimeStructOptionFact(inner, env);
            if IsSome(nested_option) {
                inner_c_type = UnwrapOption(nested_option).c_type;
            } else {
                let scalar_kind: Int =
                    OptionResultRuntimeOptionPayloadKindForType(inner);
                if scalar_kind == OptionResultRuntimeOptionPayloadKindInt() {
                    inner_c_type = CompilerAbiLayoutOptionIntCValueType();
                } else if scalar_kind ==
                    OptionResultRuntimeOptionPayloadKindLong() {
                    inner_c_type = CompilerAbiLayoutOptionLongCValueType();
                } else if scalar_kind ==
                    OptionResultRuntimeOptionPayloadKindString() {
                    inner_c_type = CompilerAbiLayoutOptionStringCValueType();
                } else if scalar_kind ==
                    OptionResultRuntimeOptionPayloadKindFloat() {
                    inner_c_type = CompilerAbiLayoutOptionFloatCValueType();
                } else if scalar_kind ==
                    OptionResultRuntimeOptionPayloadKindDouble() {
                    inner_c_type = CompilerAbiLayoutOptionDoubleCValueType();
                } else if scalar_kind ==
                    OptionResultRuntimeOptionPayloadKindBool() {
                    inner_c_type = CompilerAbiLayoutOptionBoolCValueType();
                } else {
                    return None;
                }
            }
        }
    }
    let suffix: String = CompilerSymbolCMangledTypeName(inner);
    return Some(OptionStructRuntimeFact(
        inner, inner_c_type,
        Concat("pgy_option_", suffix),
        Concat("pgy_option_some_", suffix),
        Concat("pgy_option_none_", suffix)));
}

func OptionResultRuntimeOptionPayloadKindFromEnvKind(kind: String) -> Int {
    if kind == "OptionString" {
        return OptionResultRuntimeOptionPayloadKindString();
    }
    if kind == "OptionFloat" {
        return OptionResultRuntimeOptionPayloadKindFloat();
    }
    if kind == "OptionDouble" {
        return OptionResultRuntimeOptionPayloadKindDouble();
    }
    if kind == "OptionBool" {
        return OptionResultRuntimeOptionPayloadKindBool();
    }
    if kind == "OptionLong" {
        return OptionResultRuntimeOptionPayloadKindLong();
    }
    if kind == "OptionInt" {
        return OptionResultRuntimeOptionPayloadKindInt();
    }
    return 0;
}

func OptionResultRuntimeCOptionSomeFnForPayloadKind(kind: Int) -> String {
    if kind == OptionResultRuntimeOptionPayloadKindLong() {
        return "pgy_option_some_long";
    }
    if kind == OptionResultRuntimeOptionPayloadKindString() {
        return "pgy_option_some_string";
    }
    if kind == OptionResultRuntimeOptionPayloadKindFloat() {
        return "pgy_option_some_float";
    }
    if kind == OptionResultRuntimeOptionPayloadKindDouble() {
        return "pgy_option_some_double";
    }
    if kind == OptionResultRuntimeOptionPayloadKindBool() {
        return "pgy_option_some_bool";
    }
    return OptionResultRuntimeCOptionSomeFn();
}

