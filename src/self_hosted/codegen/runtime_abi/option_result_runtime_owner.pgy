func OptionResultRuntimeCValueOptionDefinition(
    option_type_name: String,
    env: CodegenTypeEnv
) -> OptionStructDefinitionBlockFact {
    let runtime_fact_opt: Option<OptionStructRuntimeFact> =
        OptionResultRuntimeStructOptionFact(option_type_name, env);
    if !IsSome(runtime_fact_opt) {
        return OptionStructDefinitionBlockFact("", false);
    }
    let runtime_fact: OptionStructRuntimeFact =
        UnwrapOption(runtime_fact_opt);
    let inner_c_type: String = runtime_fact.inner_c_type;
    let out: String = Concat(
        "typedef struct { bool is_some; ",
        Concat(inner_c_type, Concat(
            " value; } ", Concat(runtime_fact.c_type, ";\n")
        ))
    );
    out = Concat(out, Concat(
        "static ", Concat(runtime_fact.c_type, Concat(
            " ", Concat(runtime_fact.some_fn, Concat(
                "(", Concat(inner_c_type, Concat(
                    " v) { ", Concat(runtime_fact.c_type,
                    " o; o.is_some = true; o.value = v; return o; }\n")
                ))
            ))
        ))
    ));
    out = Concat(out, Concat(
        "static ", Concat(runtime_fact.c_type, Concat(
            " ", Concat(runtime_fact.none_fn, Concat(
                "(void) { ", Concat(inner_c_type, Concat(
                    " z = {0}; ", Concat(runtime_fact.c_type,
                    " o; o.is_some = false; o.value = z; return o; }\n")
                ))
            ))
        ))
    ));
    return OptionStructDefinitionBlockFact(out, true);
}

func OptionResultRuntimeCResultIntBlock() -> String {
    let result_type: String = CompilerAbiLayoutResultIntCValueType();
    let int_type: String = CompilerAbiLayoutIntCValueType();
    let string_type: String = CompilerAbiLayoutStringCValueType();
    let block: String = "";
    block = Concat(block, Concat("typedef struct { bool is_ok; ", Concat(int_type, Concat(" value; } ", Concat(result_type, ";\n")))));
    block = Concat(block, Concat("static ", Concat(result_type, Concat(" ", Concat(OptionResultRuntimeCResultOkFn(), Concat("(", Concat(int_type, " v) { ")))))));
    block = Concat(block, Concat(result_type, " r; r.is_ok = true; r.value = v; return r; }\n"));
    block = Concat(block, Concat("static ", Concat(result_type, Concat(" ", Concat(OptionResultRuntimeCResultErrFn(), Concat("(", Concat(string_type, " msg) { (void)msg; ")))))));
    block = Concat(block, Concat(result_type, " r; r.is_ok = false; r.value = 0; return r; }\n"));
    block = Concat(block, Concat("static bool ", Concat(OptionResultRuntimeCResultIsOkFn(), Concat("(", Concat(result_type, " r) { return r.is_ok; }\n")))));
    block = Concat(block, Concat("static bool ", Concat(OptionResultRuntimeCResultIsErrFn(), Concat("(", Concat(result_type, " r) { return !r.is_ok; }\n")))));
    block = Concat(block, Concat("static ", Concat(int_type, Concat(" ", Concat(OptionResultRuntimeCResultUnwrapFn(), Concat("(", Concat(result_type, " r) { return r.value; }\n")))))));
    block = Concat(block, Concat("static ", Concat(int_type, Concat(" ", Concat(OptionResultRuntimeCResultUnwrapOrFn(), Concat("(", Concat(result_type, Concat(" r, ", Concat(int_type, " fallback) { return r.is_ok ? r.value : fallback; }\n\n")))))))));
    return block;
}

func OptionResultRuntimeCOptionScalarBlock() -> String {
    let option_int_type: String = CompilerAbiLayoutOptionIntCValueType();
    let option_long_type: String = CompilerAbiLayoutOptionLongCValueType();
    let option_string_type: String = CompilerAbiLayoutOptionStringCValueType();
    let option_float_type: String = CompilerAbiLayoutOptionFloatCValueType();
    let option_double_type: String = CompilerAbiLayoutOptionDoubleCValueType();
    let option_bool_type: String = CompilerAbiLayoutOptionBoolCValueType();
    let int_type: String = CompilerAbiLayoutIntCValueType();
    let long_type: String = CompilerAbiLayoutLongCValueType();
    let string_type: String = CompilerAbiLayoutStringCValueType();
    let float_type: String = CompilerAbiLayoutFloatCValueType();
    let double_type: String = CompilerAbiLayoutDoubleCValueType();
    let bool_type: String = CompilerAbiLayoutBoolCValueType();
    let block: String = "";
    block = Concat(block, Concat("typedef struct { bool is_some; ", Concat(int_type, Concat(" value; } ", Concat(option_int_type, ";\n")))));
    block = Concat(block, Concat("typedef struct { bool is_some; ", Concat(long_type, Concat(" value; } ", Concat(option_long_type, ";\n")))));
    block = Concat(block, Concat("typedef struct { bool is_some; ", Concat(string_type, Concat(" value; } ", Concat(option_string_type, ";\n")))));
    block = Concat(block, Concat("typedef struct { bool is_some; ", Concat(float_type, Concat(" value; } ", Concat(option_float_type, ";\n")))));
    block = Concat(block, Concat("typedef struct { bool is_some; ", Concat(double_type, Concat(" value; } ", Concat(option_double_type, ";\n")))));
    block = Concat(block, Concat("typedef struct { bool is_some; ", Concat(bool_type, Concat(" value; } ", Concat(option_bool_type, ";\n")))));
    block = Concat(block, Concat("static ", Concat(option_int_type, Concat(" ", Concat(OptionResultRuntimeCOptionSomeFn(), Concat("(", Concat(int_type, " v) { ")))))));
    block = Concat(block, Concat(option_int_type, " o; o.is_some = true; o.value = v; return o; }\n"));
    block = Concat(block, Concat("static ", Concat(option_long_type, Concat(" ", Concat(OptionResultRuntimeCOptionSomeFnForPayloadKind(OptionResultRuntimeOptionPayloadKindLong()), Concat("(", Concat(long_type, " v) { ")))))));
    block = Concat(block, Concat(option_long_type, " o; o.is_some = true; o.value = v; return o; }\n"));
    block = Concat(block, Concat("static ", Concat(option_string_type, Concat(" ", Concat(OptionResultRuntimeCOptionSomeFnForPayloadKind(OptionResultRuntimeOptionPayloadKindString()), Concat("(", Concat(string_type, " v) { ")))))));
    block = Concat(block, Concat(option_string_type, " o; o.is_some = true; o.value = v; return o; }\n"));
    block = Concat(block, Concat("static ", Concat(option_float_type, Concat(" ", Concat(OptionResultRuntimeCOptionSomeFnForPayloadKind(OptionResultRuntimeOptionPayloadKindFloat()), Concat("(", Concat(float_type, " v) { ")))))));
    block = Concat(block, Concat(option_float_type, " o; o.is_some = true; o.value = v; return o; }\n"));
    block = Concat(block, Concat("static ", Concat(option_double_type, Concat(" ", Concat(OptionResultRuntimeCOptionSomeFnForPayloadKind(OptionResultRuntimeOptionPayloadKindDouble()), Concat("(", Concat(double_type, " v) { ")))))));
    block = Concat(block, Concat(option_double_type, " o; o.is_some = true; o.value = v; return o; }\n"));
    block = Concat(block, Concat("static ", Concat(option_bool_type, Concat(" ", Concat(OptionResultRuntimeCOptionSomeFnForPayloadKind(OptionResultRuntimeOptionPayloadKindBool()), Concat("(", Concat(bool_type, " v) { ")))))));
    block = Concat(block, Concat(option_bool_type, " o; o.is_some = true; o.value = v; return o; }\n"));
    block = Concat(block, Concat("static ", Concat(option_int_type, Concat(" ", Concat(OptionResultRuntimeCOptionNoneFn(), "(void) { ")))));
    block = Concat(block, Concat(option_int_type, " o; o.is_some = false; o.value = 0; return o; }\n"));
    block = Concat(block, Concat("static ", Concat(option_long_type, Concat(" ", Concat(OptionResultRuntimeCOptionNoneFnForPayloadKind(OptionResultRuntimeOptionPayloadKindLong()), "(void) { ")))));
    block = Concat(block, Concat(option_long_type, " o; o.is_some = false; o.value = 0; return o; }\n"));
    block = Concat(block, Concat("static ", Concat(option_string_type, Concat(" ", Concat(OptionResultRuntimeCOptionNoneFnForPayloadKind(OptionResultRuntimeOptionPayloadKindString()), "(void) { ")))));
    block = Concat(block, Concat(option_string_type, " o; o.is_some = false; o.value = \"\"; return o; }\n"));
    block = Concat(block, Concat("static ", Concat(option_float_type, Concat(" ", Concat(OptionResultRuntimeCOptionNoneFnForPayloadKind(OptionResultRuntimeOptionPayloadKindFloat()), "(void) { ")))));
    block = Concat(block, Concat(option_float_type, " o; o.is_some = false; o.value = 0.0; return o; }\n"));
    block = Concat(block, Concat("static ", Concat(option_double_type, Concat(" ", Concat(OptionResultRuntimeCOptionNoneFnForPayloadKind(OptionResultRuntimeOptionPayloadKindDouble()), "(void) { ")))));
    block = Concat(block, Concat(option_double_type, " o; o.is_some = false; o.value = 0.0; return o; }\n"));
    block = Concat(block, Concat("static ", Concat(option_bool_type, Concat(" ", Concat(OptionResultRuntimeCOptionNoneFnForPayloadKind(OptionResultRuntimeOptionPayloadKindBool()), "(void) { ")))));
    block = Concat(block, Concat(option_bool_type, " o; o.is_some = false; o.value = false; return o; }\n"));
    block = Concat(block, Concat("#define ", Concat(OptionResultRuntimeCOptionIsSomeFn(), "(o) ((o).is_some)\n")));
    block = Concat(block, Concat("#define ", Concat(OptionResultRuntimeCOptionUnwrapFn(), "(o) ((o).value)\n\n")));
    return block;
}

