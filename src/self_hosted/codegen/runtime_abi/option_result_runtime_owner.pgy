// src/self_hosted/codegen/runtime_abi/option_result_runtime_owner.pgy
//
// Self-host C Option/Result runtime symbol facts for the supported codegen subset.

import "../type_facts/type_env.pgy";

struct OptionStructRuntimeFact {
    let inner_type_name: String;
    let c_type: String;
    let some_fn: String;
    let none_fn: String;
}

struct OptionStructDefinitionBlockFact {
    let c_block: String;
}

func OptionResultRuntimeCOptionSomeFn() -> String {
    return "pgy_option_some";
}

func OptionResultRuntimeOptionPayloadKindInt() -> Int {
    return 1;
}

func OptionResultRuntimeOptionPayloadKindString() -> Int {
    return 2;
}

func OptionResultRuntimeOptionPayloadKindFromExprKind(kind: String) -> Int {
    if kind == "String" {
        return OptionResultRuntimeOptionPayloadKindString();
    }
    return OptionResultRuntimeOptionPayloadKindInt();
}

func OptionResultRuntimeOptionPayloadKindForType(type_name: String) -> Int {
    if type_name == "Option<String>" {
        return OptionResultRuntimeOptionPayloadKindString();
    }
    if type_name == "Option<String: String>" {
        return OptionResultRuntimeOptionPayloadKindString();
    }
    if type_name == "Option<Int>" {
        return OptionResultRuntimeOptionPayloadKindInt();
    }
    if type_name == "Option<Int: Int>" {
        return OptionResultRuntimeOptionPayloadKindInt();
    }
    return 0;
}

func OptionResultRuntimeStructOptionFact(type_name: String, env: String) -> Option<OptionStructRuntimeFact> {
    let n: Int = StringLength(type_name);
    if !StartsWith(type_name, "Option<") || n < 9 {
        return None;
    }
    let inner: String = StringTrim(Substring(type_name, 7, n - 8));
    let colon: Int = StringIndexOf(inner, ":");
    if colon >= 0 {
        inner = StringTrim(Substring(inner, 0, colon));
    }
    if StringLength(inner) == 0 || LookupKindType(env, inner, "s") != "struct" {
        return None;
    }
    return Some(OptionStructRuntimeFact(
        inner,
        Concat("pgy_option_", inner),
        Concat("pgy_option_some_", inner),
        Concat("pgy_option_none_", inner)));
}

func OptionResultRuntimeOptionPayloadKindFromEnvKind(kind: String) -> Int {
    if kind == "OptionString" {
        return OptionResultRuntimeOptionPayloadKindString();
    }
    if kind == "OptionInt" {
        return OptionResultRuntimeOptionPayloadKindInt();
    }
    return 0;
}

func OptionResultRuntimeCOptionSomeFnForPayloadKind(kind: Int) -> String {
    if kind == OptionResultRuntimeOptionPayloadKindString() {
        return "pgy_option_some_string";
    }
    return OptionResultRuntimeCOptionSomeFn();
}

func OptionResultRuntimeCOptionNoneFn() -> String {
    return "pgy_option_none";
}

func OptionResultRuntimeCOptionNoneFnForPayloadKind(kind: Int) -> String {
    if kind == OptionResultRuntimeOptionPayloadKindString() {
        return "pgy_option_none_string";
    }
    return OptionResultRuntimeCOptionNoneFn();
}

func OptionResultRuntimeCOptionIsSomeFn() -> String {
    return "pgy_option_is_some";
}

func OptionResultRuntimeCOptionUnwrapFn() -> String {
    return "pgy_option_unwrap";
}

func OptionResultRuntimeOptionEnvKindForPayloadKind(kind: Int) -> String {
    if kind == OptionResultRuntimeOptionPayloadKindString() {
        return "OptionString";
    }
    if kind == OptionResultRuntimeOptionPayloadKindInt() {
        return "OptionInt";
    }
    return "";
}

func OptionResultRuntimeOptionTypeNameForPayloadKind(kind: Int) -> String {
    if kind == OptionResultRuntimeOptionPayloadKindString() {
        return "Option<String>";
    }
    if kind == OptionResultRuntimeOptionPayloadKindInt() {
        return "Option<Int>";
    }
    return "";
}

func OptionResultRuntimeOptionValueTypeForPayloadKind(kind: Int) -> String {
    if kind == OptionResultRuntimeOptionPayloadKindString() {
        return "String";
    }
    if kind == OptionResultRuntimeOptionPayloadKindInt() {
        return "Int";
    }
    return "";
}

func OptionResultRuntimeCStructOptionDefinitionBlock(env: String) -> OptionStructDefinitionBlockFact {
    let out: String = "";
    let scan: Int = 0;
    let marker: String = "=s:struct|";
    while scan < StringLength(env) {
        let rest: String = Substring(env, scan, StringLength(env) - scan);
        let rel: Int = StringIndexOf(rest, marker);
        if rel < 0 {
            return OptionStructDefinitionBlockFact(out);
        }
        let mark: Int = scan + rel;
        let start: Int = mark - 1;
        while start >= 0 && CodegenCharAt(env, start) != "|" {
            start = start - 1;
        }
        let name: String = Substring(env, start + 1, mark - start - 1);
        if StringLength(name) > 0 {
            let opt_name: String = Concat("pgy_option_", name);
            let typedef_line: String = Concat("typedef struct { bool is_some; ", name);
            typedef_line = Concat(typedef_line, Concat(" value; } ", Concat(opt_name, ";\n")));
            out = Concat(out, typedef_line);

            let some_line: String = Concat("static ", opt_name);
            some_line = Concat(some_line, Concat(" pgy_option_some_", name));
            some_line = Concat(some_line, Concat("(", Concat(name, " v) { ")));
            some_line = Concat(some_line, Concat(opt_name, " o; o.is_some = true; o.value = v; return o; }\n"));
            out = Concat(out, some_line);

            let none_line: String = Concat("static ", opt_name);
            none_line = Concat(none_line, Concat(" pgy_option_none_", name));
            none_line = Concat(none_line, Concat("(void) { ", Concat(name, " z = {0}; ")));
            none_line = Concat(none_line, Concat(opt_name, " o; o.is_some = false; o.value = z; return o; }\n"));
            out = Concat(out, none_line);
        }
        scan = mark + StringLength(marker);
    }
    return OptionStructDefinitionBlockFact(out);
}

func OptionResultRuntimeCResultOkFn() -> String {
    return "pgy_result_ok";
}

func OptionResultRuntimeCResultErrFn() -> String {
    return "pgy_result_err";
}

func OptionResultRuntimeCResultIsOkFn() -> String {
    return "pgy_result_is_ok";
}

func OptionResultRuntimeCResultIsErrFn() -> String {
    return "pgy_result_is_err";
}

func OptionResultRuntimeCResultUnwrapFn() -> String {
    return "pgy_result_unwrap";
}

func OptionResultRuntimeCResultUnwrapOrFn() -> String {
    return "pgy_result_unwrap_or";
}
