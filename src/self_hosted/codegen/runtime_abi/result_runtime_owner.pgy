// C symbol facts for Result specializations.
//
// A one-argument Result<T> has the language's implicit String error lane.
// Int, Bool, and String are the scalar specializations materialized by the
// self-host C preamble. Explicit Result<T, E> values remain declaration-graph
// nodes emitted from their two owned type arguments.

import "../../compiler/symbol_table_owner.pgy";
import "../../semantic/ast_type_name_canonical_owner.pgy";
import "../../semantic/wrapper_type_owner.pgy";

struct ResultRuntimeFact {
    ok: Bool;
    type_name: String;
    payload_type: String;
    error_type: String;
    c_type: String;
    ok_fn: String;
    err_fn: String;
    is_ok_fn: String;
    is_err_fn: String;
    unwrap_fn: String;
    unwrap_err_fn: String;
    unwrap_or_fn: String;
}

func ResultRuntimeFactInvalid(type_name: String) -> ResultRuntimeFact {
    return ResultRuntimeFact(
        false, type_name, "", "", "", "", "", "", "", "", "", ""
    );
}

func ResultRuntimeFactIsBuiltinScalar(type_name: String) -> Bool {
    let canonical: String = SemanticCanonicalTypeName(type_name);
    return canonical == "Result<Int>" ||
        canonical == "Result<Bool>" ||
        canonical == "Result<String>";
}

func ResultRuntimeBuiltinScalarFact(
    canonical: String
) -> ResultRuntimeFact {
    if canonical == "Result<Int>" {
        return ResultRuntimeFact(
            true, canonical, "Int", "String", "pgy_result_int",
            "pgy_result_ok", "pgy_result_err",
            "pgy_result_is_ok", "pgy_result_is_err",
            "pgy_result_unwrap", "pgy_result_unwrap_err",
            "pgy_result_unwrap_or"
        );
    }
    if canonical == "Result<Bool>" {
        return ResultRuntimeFact(
            true, canonical, "Bool", "String", "pgy_result_bool",
            "pgy_result_ok_bool", "pgy_result_err_bool",
            "pgy_result_is_ok_bool", "pgy_result_is_err_bool",
            "pgy_result_unwrap_bool", "pgy_result_unwrap_err_bool",
            "pgy_result_unwrap_or_bool"
        );
    }
    if canonical == "Result<String>" {
        return ResultRuntimeFact(
            true, canonical, "String", "String", "pgy_result_string",
            "pgy_result_ok_string", "pgy_result_err_string",
            "pgy_result_is_ok_string", "pgy_result_is_err_string",
            "pgy_result_unwrap_string", "pgy_result_unwrap_err_string",
            "pgy_result_unwrap_or_string"
        );
    }
    return ResultRuntimeFactInvalid(canonical);
}

func ResultRuntimeFactForType(type_name: String) -> ResultRuntimeFact {
    let canonical: String = SemanticCanonicalTypeName(type_name);
    if ResultRuntimeFactIsBuiltinScalar(canonical) {
        return ResultRuntimeBuiltinScalarFact(canonical);
    }
    let payload: Option<String> = ResultPayloadTypeOpt(canonical);
    let error: Option<String> = ResultErrorTypeOpt(canonical);
    if !IsSome(payload) || !IsSome(error) ||
        UnwrapOption(payload) == "" || UnwrapOption(payload) == "Unknown" ||
        UnwrapOption(error) == "" || UnwrapOption(error) == "Unknown" {
        return ResultRuntimeFactInvalid(canonical);
    }
    let suffix: String = CompilerSymbolCMangledTypeName(Concat(
        UnwrapOption(payload), Concat("_", UnwrapOption(error))
    ));
    if suffix == "" { return ResultRuntimeFactInvalid(canonical); }
    return ResultRuntimeFact(
        true, canonical, UnwrapOption(payload), UnwrapOption(error),
        Concat("pgy_result_", suffix),
        Concat("pgy_result_ok_", suffix),
        Concat("pgy_result_err_", suffix),
        Concat("pgy_result_is_ok_", suffix),
        Concat("pgy_result_is_err_", suffix),
        Concat("pgy_result_unwrap_", suffix),
        Concat("pgy_result_unwrap_err_", suffix),
        Concat("pgy_result_unwrap_or_", suffix)
    );
}
