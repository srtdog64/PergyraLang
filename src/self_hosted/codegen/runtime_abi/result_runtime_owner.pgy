// C symbol facts for explicit Result<T, E> specializations.

import "../../compiler/symbol_table_owner.pgy";
import "../../semantic/ast_type_name_canonical_owner.pgy";
import "../../semantic/wrapper_type_owner.pgy";

struct ResultRuntimeFact {
    ok: Bool;
    type_name: String;
    payload_type: String;
    error_type: String;
    c_type: String;
    ok_fn: String;
    err_fn: String;
    is_ok_fn: String;
    is_err_fn: String;
    unwrap_fn: String;
    unwrap_err_fn: String;
}

func ResultRuntimeFactInvalid(type_name: String) -> ResultRuntimeFact {
    return ResultRuntimeFact(
        false, type_name, "", "", "", "", "", "", "", "", ""
    );
}

func ResultRuntimeFactForType(type_name: String) -> ResultRuntimeFact {
    let canonical: String = SemanticCanonicalTypeName(type_name);
    let payload: Option<String> = ResultPayloadTypeOpt(canonical);
    let error: Option<String> = ResultErrorTypeOpt(canonical);
    if !IsSome(payload) || !IsSome(error) ||
        UnwrapOption(payload) == "" || UnwrapOption(payload) == "Unknown" ||
        UnwrapOption(error) == "" || UnwrapOption(error) == "Unknown" {
        return ResultRuntimeFactInvalid(canonical);
    }
    let suffix: String = CompilerSymbolCMangledTypeName(Concat(
        UnwrapOption(payload), Concat("_", UnwrapOption(error))
    ));
    if suffix == "" { return ResultRuntimeFactInvalid(canonical); }
    return ResultRuntimeFact(
        true, canonical, UnwrapOption(payload), UnwrapOption(error),
        Concat("pgy_result_", suffix),
        Concat("pgy_result_ok_", suffix),
        Concat("pgy_result_err_", suffix),
        Concat("pgy_result_is_ok_", suffix),
        Concat("pgy_result_is_err_", suffix),
        Concat("pgy_result_unwrap_", suffix),
        Concat("pgy_result_unwrap_err_", suffix)
    );
}
