// Canonical self-host C runtime header composition owner.
//
// Header selection is a consumer fact. Runtime types and implementations stay
// owned by the runtime inline headers named here.

func RuntimeCHeaderRequired(
    uses_allocator: Bool,
    uses_text_builder: Bool,
    uses_box_array: Bool,
    uses_array: Bool,
    uses_spawn: Bool,
    uses_list: Bool,
    uses_queue: Bool,
    uses_set: Bool,
    uses_artifact_transaction: Bool,
    uses_intent_observability: Bool
) -> Bool {
    return uses_allocator || uses_text_builder || uses_box_array ||
        uses_array || uses_spawn || uses_list || uses_queue || uses_set ||
        uses_artifact_transaction || uses_intent_observability;
}

func RuntimeCHeaderIncludeBlock(
    uses_allocator: Bool, uses_text_builder: Bool,
    uses_box_array: Bool, uses_array: Bool, uses_spawn: Bool, uses_list: Bool,
    uses_queue: Bool, uses_set: Bool, uses_artifact_transaction: Bool,
    uses_intent_observability: Bool
) -> String {
    if uses_intent_observability {
        return "#define PGY_INTENT_OBSERVABILITY_ENABLED 1\n#include \"pgy_runtime.h\"\n";
    }
    if uses_artifact_transaction {
        return "#include \"pgy_runtime_artifact_transaction_inline.h\"\n";
    }
    if uses_box_array || uses_list || uses_queue || uses_set {
        return "#include \"pgy_runtime.h\"\n";
    }
    let block: String = "";
    if uses_spawn {
        block = "#include <stdint.h>\n#include <time.h>\n#include \"pgy_runtime_panic_checked_inline.h\"\n#include \"pgy_parallel.h\"\n#include \"pgy_lane_scheduler.h\"\n";
    } else if uses_allocator || uses_text_builder {
        block = "#include \"pgy_runtime_panic_contract.h\"\n#include \"pgy_runtime_panic_checked_inline.h\"\n#include \"pgy_runtime_allocator_inline.h\"\n#include \"pgy_runtime_text_builder_inline.h\"\n";
    } else if uses_array {
        block = "#include <stdint.h>\n#include \"pgy_runtime_panic_contract.h\"\n";
    }
    return block;
}
