// Canonical self-host C runtime header composition owner.
//
// Header selection is a consumer fact. Runtime types and implementations stay
// owned by the runtime inline headers named here.

func RuntimeCHeaderRequired(
    uses_allocator: Bool,
    uses_text_builder: Bool,
    uses_box_array: Bool,
    uses_spawn: Bool,
    uses_list: Bool
) -> Bool {
    return uses_allocator || uses_text_builder || uses_box_array ||
        uses_spawn || uses_list;
}

func RuntimeCHeaderIncludeBlock(
    uses_box_array: Bool, uses_spawn: Bool, uses_list: Bool
) -> String {
    if uses_box_array || uses_list {
        return "#include \"pgy_runtime.h\"\n";
    }
    if uses_spawn {
        return "#include <stdint.h>\n#include <time.h>\n#include \"pgy_runtime_panic_checked_inline.h\"\n#include \"pgy_parallel.h\"\n#include \"pgy_lane_scheduler.h\"\n";
    }
    return "#include \"pgy_runtime_panic_contract.h\"\n#include \"pgy_runtime_panic_checked_inline.h\"\n#include \"pgy_runtime_allocator_inline.h\"\n#include \"pgy_runtime_text_builder_inline.h\"\n";
}

func RuntimeCHeaderOwnsCheckedArithmetic(
    uses_allocator: Bool,
    uses_text_builder: Bool,
    uses_box_array: Bool,
    uses_list: Bool
) -> Bool {
    return RuntimeCHeaderRequired(
        uses_allocator, uses_text_builder, uses_box_array, false, uses_list
    );
}

func RuntimeCHeaderOwnsScalarLog(
    uses_box_array: Bool,
    uses_list: Bool
) -> Bool {
    return uses_box_array || uses_list;
}
