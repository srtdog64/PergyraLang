func StringRuntimeCSubstringBlock() -> String {
    let block: String = "";
    block = Concat(block, Concat("static char *", Concat(StringRuntimeCSubstringFn(), "(const char *s, long long start, long long len)\n{\n")));
    block = Concat(block, "    if (s == NULL) { char *e = (char *)malloc(1); if (e != NULL) e[0] = '\\0'; return e; }\n");
    block = Concat(block, "    size_t raw_len = strlen(s);\n");
    block = Concat(block, "    if (raw_len >= 9223372036854775807ULL || start < 0 || len <= 0 || (size_t)start >= raw_len) { char *e = (char *)malloc(1); if (e != NULL) e[0] = '\\0'; return e; }\n");
    block = Concat(block, "    long long source_len = (long long)raw_len;\n");
    block = Concat(block, "    if (len > source_len - start) len = source_len - start;\n");
    block = Concat(block, "    char *r = (char *)malloc((size_t)len + 1);\n    if (r == NULL) return r;\n");
    block = Concat(block, "    memcpy(r, s + start, (size_t)len);\n    r[len] = '\\0';\n");
    return Concat(block, "    return r;\n}\n\n");
}

func StringRuntimeCSubstringWithLenBlock() -> String {
    let block: String = "";
    block = Concat(block, Concat("static char *", Concat(StringRuntimeCSubstringWithLenFn(), "(const char *s, long long source_len, long long start, long long len)\n{\n")));
    block = Concat(block, "    if (s == NULL || source_len < 0 || start < 0 || start >= source_len || len <= 0) { char *e = (char *)malloc(1); if (e != NULL) e[0] = '\\0'; return e; }\n");
    block = Concat(block, "    if (len > source_len - start) len = source_len - start;\n");
    block = Concat(block, "    char *bounded = (char *)malloc((size_t)len + 1);\n");
    block = Concat(block, "    if (bounded == NULL) return bounded;\n");
    block = Concat(block, "    memcpy(bounded, s + start, (size_t)len);\n    bounded[len] = '\\0';\n");
    return Concat(block, "    return bounded;\n}\n\n");
}

func StringRuntimeCStringIndexOfBlock() -> String {
    let block: String = Concat("static long long ", Concat(
        StringRuntimeCStringIndexOfFn(),
        "(const char *hay, const char *needle)\n{\n"));
    block = Concat(block, "    if (hay == NULL || needle == NULL) return -1;\n");
    block = Concat(block, "    const char *p = strstr(hay, needle);\n");
    block = Concat(block, "    if (p == NULL) { return -1; }\n");
    return Concat(block, "    return (long long)(p - hay);\n}\n\n");
}

func StringRuntimeCStringCoreBlock(
    runtime_header_owns_bool_to_string: Bool
) -> String {
    let block: String = "";
    block = Concat(block, StringRuntimeCConcatBlock());
    block = Concat(block, StringRuntimeCStringLengthBlock());
    block = Concat(block, Concat("static char *", Concat(StringRuntimeCCharAtNFn(), "(const char *s, long long len, long long i)\n{\n")));
    block = Concat(block, "    if (s == NULL || i < 0 || i >= len) { char *e = (char *)malloc(1); e[0] = '\\0'; return e; }\n");
    block = Concat(block, "    char *r = (char *)malloc(2);\n    r[0] = s[i];\n    r[1] = '\\0';\n    return r;\n}\n\n");
    block = Concat(block, Concat("static long long ", Concat(StringRuntimeCCharCodeFn(), "(const char *s, long long len, long long i)\n{\n")));
    block = Concat(block, "    if (s == NULL || i < 0 || i >= len) return -1;\n");
    block = Concat(block, "    return (long long)(unsigned char)s[i];\n}\n\n");
    block = Concat(block, StringRuntimeCSubstringBlock());
    block = Concat(block, StringRuntimeCSubstringWithLenBlock());
    block = Concat(block, StringRuntimeCStringIndexOfBlock());
    block = Concat(block, Concat("static char *", Concat(StringRuntimeCStringTrimFn(), "(const char *s)\n{\n")));
    block = Concat(block, "    while (*s == ' ' || *s == '\\t' || *s == '\\n' || *s == '\\r') { s++; }\n");
    block = Concat(block, "    size_t len = strlen(s);\n");
    block = Concat(block, "    while (len > 0 && (s[len-1] == ' ' || s[len-1] == '\\t' || s[len-1] == '\\n' || s[len-1] == '\\r')) { len--; }\n");
    block = Concat(block, "    char *r = (char *)malloc(len + 1);\n");
    block = Concat(block, "    memcpy(r, s, len);\n    r[len] = '\\0';\n");
    block = Concat(block, "    return r;\n}\n\n");
    block = Concat(block, StringRuntimeCToStringBlock());
    if !runtime_header_owns_bool_to_string {
        block = Concat(block, Concat("static char *", Concat(StringRuntimeCBoolToStringFn(), "(_Bool v)\n{\n")));
        block = Concat(block, "    const char *s = v ? \"true\" : \"false\";\n");
        block = Concat(block, "    size_t n = strlen(s);\n    char *r = (char *)malloc(n + 1);\n");
        block = Concat(block, "    if (r != NULL) { memcpy(r, s, n + 1); }\n    return r;\n}\n\n");
    }
    block = Concat(block, StringRuntimeCStringContainsBlock());
    block = Concat(block, Concat("static long long ", Concat(StringRuntimeCSubIndexOfWithLenFn(), "(const char *s, long long source_len, long long start, long long len, const char *needle)\n{\n")));
    block = Concat(block, "    if (s == NULL || needle == NULL || source_len < 0 || start < 0 || start >= source_len || len <= 0) return -1;\n");
    block = Concat(block, "    if (len > source_len - start) len = source_len - start;\n    size_t nl = strlen(needle);\n    if (nl == 0) return 0;\n    if ((size_t)len < nl) return -1;\n");
    block = Concat(block, "    if (nl == 1) { const char *m = (const char *)memchr(s + start, needle[0], (size_t)len); return m ? (long long)(m - (s + start)) : -1; }\n");
    block = Concat(block, "    const char *base = s + start; const char *cur = base; size_t remaining = (size_t)len;\n    while (remaining >= nl) { const char *m = (const char *)memchr(cur, (unsigned char)needle[0], remaining - nl + 1u); if (m == NULL) return -1; if (memcmp(m, needle, nl) == 0) return (long long)(m - base); size_t advanced = (size_t)(m - cur) + 1u; cur += advanced; remaining -= advanced; }\n    return -1;\n}\n\n");
    block = Concat(block, Concat("static int ", Concat(StringRuntimeCSubEqualsWithLenFn(), "(const char *s, long long source_len, long long start, long long len, const char *other)\n{\n")));
    block = Concat(block, "    if (other == NULL) return 0;\n    if (s == NULL || source_len < 0 || start < 0 || start >= source_len || len <= 0) return strlen(other) == 0 ? 1 : 0;\n");
    block = Concat(block, "    if (len > source_len - start) len = source_len - start;\n    size_t n = strlen(other);\n    if ((size_t)len != n) return 0;\n");
    block = Concat(block, "    if (n == 0) return 1;\n    if (n == 1) return s[start] == other[0];\n    if (n == 2) return s[start] == other[0] && s[start + 1] == other[1];\n");
    block = Concat(block, "    if (n == 3) return s[start] == other[0] && s[start + 1] == other[1] && s[start + 2] == other[2];\n");
    block = Concat(block, "    if (n == 4) return s[start] == other[0] && s[start + 1] == other[1] && s[start + 2] == other[2] && s[start + 3] == other[3];\n");
    block = Concat(block, "    return memcmp(s + start, other, n) == 0;\n}\n\n");
    block = Concat(block, Concat("static int ", Concat(StringRuntimeCSubContainsWithLenFn(), "(const char *s, long long source_len, long long start, long long len, const char *needle)\n{\n")));
    block = Concat(block, Concat("    return ", Concat(StringRuntimeCSubIndexOfWithLenFn(), "(s, source_len, start, len, needle) >= 0;\n}\n\n")));
    block = Concat(block, Concat("static int ", Concat(StringRuntimeCSubStartsWithLenFn(), "(const char *s, long long source_len, long long start, const char *prefix)\n{\n")));
    block = Concat(block, "    if (s == NULL || prefix == NULL || source_len < 0 || start < 0 || start > source_len) return 0;\n");
    block = Concat(block, "    size_t n = strlen(prefix);\n    if (n == 0) return 1;\n    if ((size_t)(source_len - start) < n) return 0;\n");
    block = Concat(block, Concat("    return ", Concat(StringRuntimeCSubEqualsWithLenFn(), "(s, source_len, start, (long long)n, prefix);\n}\n\n")));
    block = Concat(block, StringRuntimeCToIntBlock());
    block = Concat(block, StringRuntimeCToUpperBlock());
    block = Concat(block, StringRuntimeCToLowerBlock());
    block = Concat(block, Concat("static char *", Concat(StringRuntimeCStringReplaceFn(), "(const char *s, const char *from, const char *to)\n{\n")));
    block = Concat(block, "    size_t fl = strlen(from);\n");
    block = Concat(block, Concat("    if (fl == 0) { return ", Concat(StringRuntimeCConcatFn(), "(s, \"\"); }\n")));
    block = Concat(block, "    size_t tl = strlen(to);\n    size_t cnt = 0;\n    const char *p = s;\n");
    block = Concat(block, "    while ((p = strstr(p, from)) != NULL) { cnt++; p += fl; }\n");
    block = Concat(block, "    char *r = (char *)malloc(strlen(s) + cnt * (tl > fl ? tl - fl : 0) + 1);\n");
    block = Concat(block, "    char *w = r;\n    const char *q = s;\n");
    block = Concat(block, "    while (*q) {\n        if (strncmp(q, from, fl) == 0) { memcpy(w, to, tl); w += tl; q += fl; }\n");
    block = Concat(block, "        else { *w++ = *q++; }\n    }\n    *w = '\\0';\n    return r;\n}\n\n");
    return block;
}

func StringRuntimeCStringContainsBlock() -> String {
    let block: String = Concat("static int ",
        Concat(StringRuntimeCStringContainsFn(),
            "(const char *h, const char *n)\n{\n"));
    return Concat(block,
        "    return strstr(h, n) != NULL ? 1 : 0;\n}\n\n");
}

func StringRuntimeCToIntBlock() -> String {
    let block: String = Concat("static long long ",
        Concat(StringRuntimeCToIntFn(), "(const char *s)\n{\n"));
    return Concat(block, "    return atoll(s);\n}\n\n");
}

func StringRuntimeCSplitBlock() -> String {
    let block: String = "";
    block = Concat(block, Concat("static pgy_as ", Concat(StringRuntimeCSplitFn(), "(const char *s, const char *sep)\n{\n")));
    block = Concat(block, Concat("    pgy_as a = ", Concat(CollectionRuntimeCNewFn(2), "();\n")));
    block = Concat(block, "    size_t sl = strlen(sep);\n");
    block = Concat(block, "    if (sl == 0) { char *only = (char *)malloc(strlen(s) + 1); strcpy(only, s); ");
    block = Concat(block, Concat(CollectionRuntimeCPushFn(2),
        "(&a, only); return a; }\n"));
    block = Concat(block, "    const char *start = s;\n    const char *p;\n");
    block = Concat(block, "    while ((p = strstr(start, sep)) != NULL) {\n");
    block = Concat(block, "        size_t len = (size_t)(p - start);\n");
    block = Concat(block, "        char *part = (char *)malloc(len + 1);\n");
    block = Concat(block, "        memcpy(part, start, len); part[len] = '\\0';\n");
    block = Concat(block, Concat("        ", Concat(CollectionRuntimeCPushFn(2), "(&a, part);\n")));
    block = Concat(block, "        start = p + sl;\n    }\n");
    block = Concat(block, "    char *last = (char *)malloc(strlen(start) + 1);\n");
    block = Concat(block, "    strcpy(last, start);\n");
    block = Concat(block, Concat("    ", Concat(CollectionRuntimeCPushFn(2), "(&a, last);\n")));
    block = Concat(block, "    return a;\n}\n\n");
    return block;
}

func StringRuntimeCStringJoinBlock() -> String {
    let block: String = "";
    block = Concat(block, Concat("static char *", Concat(StringRuntimeCStringJoinFn(), "(pgy_as a, const char *sep)\n{\n")));
    block = Concat(block, "    size_t sl = strlen(sep);\n    size_t total = 0;\n");
    block = Concat(block, "    for (long long i = 0; i < a.len; i++) { total += strlen(a.data[i]); }\n");
    block = Concat(block, "    if (a.len > 1) { total += sl * (size_t)(a.len - 1); }\n");
    block = Concat(block, "    char *r = (char *)malloc(total + 1);\n    char *p = r;\n");
    block = Concat(block, "    for (long long i = 0; i < a.len; i++) {\n");
    block = Concat(block, "        if (i > 0) { memcpy(p, sep, sl); p += sl; }\n");
    block = Concat(block, "        size_t el = strlen(a.data[i]);\n        memcpy(p, a.data[i], el); p += el;\n    }\n");
    block = Concat(block, "    *p = '\\0';\n    return r;\n}\n\n");
    return block;
}
