func StringRuntimeCToUpperBlock() -> String {
    let block: String = "";
    block = Concat(block, Concat("static char *", Concat(StringRuntimeCToUpperFn(), "(const char *s)\n{\n")));
    block = Concat(block, "    size_t n = strlen(s);\n    char *r = (char *)malloc(n + 1);\n");
    block = Concat(block, "    for (size_t i = 0; i < n; i++) { char c = s[i]; r[i] = (c >= 'a' && c <= 'z') ? (char)(c - 32) : c; }\n");
    block = Concat(block, "    r[n] = '\\0';\n    return r;\n}\n\n");
    return block;
}

