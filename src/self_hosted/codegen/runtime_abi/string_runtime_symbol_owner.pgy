// C symbol and format-string names for the string runtime ABI.
//
// Split out of string_runtime_owner.pgy, which emits the runtime blocks
// themselves. What a runtime entry point is CALLED is an ABI naming fact;
// what it EMITS is code generation. Holding both put that owner over its
// line cap.
import "collection_runtime_owner.pgy";

func StringRuntimeCConcatFn() -> String {
    return "pgy_concat";
}

func StringRuntimeCLogFn() -> String {
    return "pgy_log";
}

func StringRuntimeCBoolLogFn() -> String {
    return "pgy_log_bool";
}

func StringRuntimeCPrintFn() -> String {
    return "pgy_print";
}

func StringRuntimeCFormattedPrintFn() -> String {
    return "printf";
}

func StringRuntimeCStringCompareFn() -> String {
    return "strcmp";
}

func StringRuntimeCIntLineFormat() -> String {
    return "%lld\\n";
}

func StringRuntimeCStringLineFormat() -> String {
    return "%s\\n";
}

func StringRuntimeCFloatLineFormat() -> String {
    return "%f\\n";
}

func StringRuntimeCStringLengthFn() -> String {
    return "pgy_strlen";
}

func StringRuntimeCStringContainsFn() -> String {
    return "pgy_strcontains";
}

func StringRuntimeCStringIndexOfFn() -> String {
    return "pgy_strindexof";
}

func StringRuntimeCSplitFn() -> String {
    return "pgy_split";
}

func StringRuntimeCToIntFn() -> String {
    return "pgy_toint";
}

func StringRuntimeCToFloatFn() -> String {
    return "atof";
}

func StringRuntimeCStringTrimFn() -> String {
    return "pgy_strtrim";
}

func StringRuntimeCStringReplaceFn() -> String {
    return "pgy_strreplace";
}

func StringRuntimeCToUpperFn() -> String {
    return "pgy_toupper";
}

func StringRuntimeCToLowerFn() -> String {
    return "pgy_tolower";
}

func StringRuntimeCCharCodeFn() -> String {
    return "pgy_charcode";
}

func StringRuntimeCCharAtNFn() -> String {
    return "pgy_charatn";
}

func StringRuntimeCSubContainsWithLenFn() -> String {
    return "pgy_subcontains_with_len";
}

func StringRuntimeCSubEqualsWithLenFn() -> String {
    return "pgy_subequals_with_len";
}

func StringRuntimeCSubIndexOfWithLenFn() -> String {
    return "pgy_subindexof_with_len";
}

func StringRuntimeCSubStartsWithLenFn() -> String {
    return "pgy_substartswith_with_len";
}

func StringRuntimeCSubstringFn() -> String {
    return "pgy_substr";
}

func StringRuntimeCSubstringWithLenFn() -> String {
    return "pgy_substr_with_len";
}

func StringRuntimeCStringJoinFn() -> String {
    return "pgy_strjoin";
}

func StringRuntimeCToStringFn() -> String {
    return "pgy_tostr";
}

func StringRuntimeCBoolToStringFn() -> String {
    return "pgy_bool_to_string";
}
