func TextBuilderRuntimeCFinishFn() -> String { return "pgy_text_builder_finish"; }
func TextBuilderRuntimeCDropFn() -> String { return "pgy_text_builder_drop"; }

// LLVM consumes the same logical runtime-value rows through pointer-oriented
// exports.  These are target spellings, not a second operation registry.
func TextBuilderRuntimeLlvmAllocatorResultFn() -> String {
    return "pgy_allocator_result_init";
}
func TextBuilderRuntimeLlvmAllocatorDestroyFn() -> String {
    return "pgy_allocator_destroy_export";
