// src/self_hosted/codegen/text/expr_scan.pgy
//
// Expression token scanning and first-pass rewrites for self-host C emission.

import "../runtime_abi/collection_runtime_owner.pgy";
import "../type_facts/type_env.pgy";

func ReplaceAll(s: String, from: String, to: String) -> String {
    let fl: Int = StringLength(from);
    if fl == 0 {
        return s;
    }
    let n: Int = StringLength(s);
    let out: String = "";
    let i: Int = 0;
    while i < n {
        if i + fl <= n && Substring(s, i, fl) == from {
            out = Concat(out, to);
            i = i + fl;
        } else {
            out = Concat(out, CodegenCharAt(s, i));
            i = i + 1;
        }
    }
    return out;
}

// Like ReplaceAll, but never matches inside a C string literal -- so a builtin
// name that appears as *data* (e.g. the literal "ArrayLength(") is left alone.
// Needed once the emitter compiles code that manipulates builtin-name strings
// (e.g. the codegen tool itself).
func ReplaceAllOutsideStrings(s: String, from: String, to: String) -> String {
    let fl: Int = StringLength(from);
    if fl == 0 {
        return s;
    }
    let n: Int = StringLength(s);
    let out: String = "";
    let i: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CodegenCharAt(s, i);
        if in_str {
            out = Concat(out, c);
            if c == "\\" && i + 1 < n {
                out = Concat(out, CodegenCharAt(s, i + 1));
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            out = Concat(out, c);
            i = i + 1;
            continue;
        }
        // Word-boundary check: only replace `Name(` when it is not the suffix
        // of a longer identifier (e.g. don't rewrite `Args(` inside
        // `CompareCallArgs(`). The previous output char must not be ident-ish.
        let ol: Int = StringLength(out);
        let boundary_ok: Bool = ol == 0 || !IsIdentChar(CodegenCharAt(out, ol - 1));
        if boundary_ok && i + fl <= n && Substring(s, i, fl) == from {
            out = Concat(out, to);
            i = i + fl;
            continue;
        }
        out = Concat(out, c);
        i = i + 1;
    }
    return out;
}

// Rewrite `ArrayLength(<arr>)` through the collection runtime symbol owner per
// the array's element type (rung-10 growable-array representation).
func RewriteArrayLengthEnv(e: String, env: String) -> String {
    let n: Int = StringLength(e);
    let out: String = "";
    let i: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CodegenCharAt(e, i);
        if in_str {
            out = Concat(out, c);
            if c == "\\" && i + 1 < n {
                out = Concat(out, CodegenCharAt(e, i + 1));
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            out = Concat(out, c);
            i = i + 1;
            continue;
        }
        if i + 12 <= n && Substring(e, i, 12) == "ArrayLength(" {
            let open: Int = i + 11;
            let close_opt: Option<Int> = FindMatchingParen(e, open);
            if !IsSome(close_opt) {
                Die(Concat("malformed ArrayLength(...): ", e));
            }
            let close: Int = UnwrapOption(close_opt);
            let arg: String = StringTrim(Substring(e, open + 1, close - open - 1));
            let kind: String = LookupKindType(env, arg, "v");
            let fn: String = CollectionRuntimeCLenFn(kind);
            out = Concat(out, Concat(fn, Concat("(", Concat(arg, ")"))));
            i = close + 1;
            continue;
        }
        out = Concat(out, c);
        i = i + 1;
    }
    return out;
}

// Rewrite array index reads through the collection runtime symbol owner for
// array variables (rung-10). String literals are copied verbatim so a `[` inside
// a string is never touched.
func RewriteIndexing(e: String, env: String) -> String {
    let n: Int = StringLength(e);
    let out: String = "";
    let i: Int = 0;
    while i < n {
        let c: String = CodegenCharAt(e, i);
        if c == "\"" {
            out = Concat(out, c);
            i = i + 1;
            while i < n {
                let d: String = CodegenCharAt(e, i);
                out = Concat(out, d);
                i = i + 1;
                if d == "\\" {
                    if i < n {
                        out = Concat(out, CodegenCharAt(e, i));
                        i = i + 1;
                    }
                } else if d == "\"" {
                    i = i;
                    break;
                }
            }
        } else if IsIdentStart(c) {
            let j: Int = i;
            while j < n && IsIdentChar(CodegenCharAt(e, j)) {
                j = j + 1;
            }
            let ident: String = Substring(e, i, j - i);
            if j < n && CodegenCharAt(e, j) == "[" {
                let close_opt: Option<Int> = FindMatchingBracket(e, j);
                if !IsSome(close_opt) {
                    Die(Concat("unmatched index bracket: ", e));
                }
                let close: Int = UnwrapOption(close_opt);
                let inner: String = Substring(e, j + 1, close - j - 1);
                let inner_r: String = RewriteIndexing(inner, env);
                let kind: String = LookupKindType(env, ident, "v");
                let get_fn: String = CollectionRuntimeCGetFn(kind);
                out = Concat(out, Concat(get_fn, Concat("(", Concat(ident, Concat(", ", Concat(inner_r, ")"))))));
                i = close + 1;
            } else {
                out = Concat(out, ident);
                i = j;
            }
        } else {
            out = Concat(out, c);
            i = i + 1;
        }
    }
    return out;
}

// Rewrite a C expression: array length, then array indexing, then string
// builtin call-names to their runtime helpers. Environment-aware.
// Find the index of a top-level two-char operator `op` (depth 0, outside string
// literals).
func FindTopLevelOp2(s: String, op: String) -> Option<Int> {
    let n: Int = StringLength(s);
    let i: Int = 0;
    let depth: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CodegenCharAt(s, i);
        if in_str {
            if c == "\\" {
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            i = i + 1;
            continue;
        }
        if c == "(" || c == "[" {
            depth = depth + 1;
            i = i + 1;
            continue;
        }
        if c == ")" || c == "]" {
            depth = depth - 1;
            i = i + 1;
            continue;
        }
        if depth == 0 && i + 2 <= n && Substring(s, i, 2) == op {
            return Some(i);
        }
        i = i + 1;
    }
    return None;
}

// Recursively lower a boolean/comparison expression. The key job: a string
// `==` / `!=` must become `strcmp(a, b) == 0` / `!= 0` (C `==` on `char*`
// compares pointers). Int comparisons keep `==`. Operand expressions still flow
// through the token pipeline (RewriteTokens).
func RewriteBool(e: String, env: String) -> String {
    let s: String = StringTrim(e);
    let n: Int = StringLength(s);
    if n == 0 {
        return s;
    }
    // Fully parenthesized group -> recurse inside, keep the parens.
    let close_opt: Option<Int> = FindMatchingParen(s, 0);
    if CodegenCharAt(s, 0) == "(" && IsSome(close_opt) && UnwrapOption(close_opt) == n - 1 {
        return Concat("(", Concat(RewriteBool(Substring(s, 1, n - 2), env), ")"));
    }
    // Lowest precedence first: `||`, then `&&`.
    let orp: Option<Int> = FindTopLevelOp2(s, "||");
    if IsSome(orp) {
        let or_pos: Int = UnwrapOption(orp);
        let l: String = Substring(s, 0, or_pos);
        let r: String = Substring(s, or_pos + 2, n - (or_pos + 2));
        return Concat(RewriteBool(l, env), Concat(" || ", RewriteBool(r, env)));
    }
    let andp: Option<Int> = FindTopLevelOp2(s, "&&");
    if IsSome(andp) {
        let and_pos: Int = UnwrapOption(andp);
        let l2: String = Substring(s, 0, and_pos);
        let r2: String = Substring(s, and_pos + 2, n - (and_pos + 2));
        return Concat(RewriteBool(l2, env), Concat(" && ", RewriteBool(r2, env)));
    }
    // Equality / inequality: rewrite to strcmp when an operand is a string.
    let eqp: Option<Int> = FindTopLevelOp2(s, "==");
    let nep: Option<Int> = FindTopLevelOp2(s, "!=");
    let cmpp: Option<Int> = eqp;
    let is_eq: Bool = true;
    if !IsSome(eqp) {
        cmpp = nep;
        is_eq = false;
    } else if IsSome(nep) && UnwrapOption(nep) < UnwrapOption(eqp) {
        cmpp = nep;
        is_eq = false;
    }
    if IsSome(cmpp) {
        let cmp_pos: Int = UnwrapOption(cmpp);
        let lhs: String = StringTrim(Substring(s, 0, cmp_pos));
        let rhs: String = StringTrim(Substring(s, cmp_pos + 2, n - (cmp_pos + 2)));
        if ExprKind(lhs, env) == "String" || ExprKind(rhs, env) == "String" {
            let tail: String = ") == 0)";
            if !is_eq {
                tail = ") != 0)";
            }
            return Concat("(strcmp(", Concat(RewriteExpr(lhs, env), Concat(", ", Concat(RewriteExpr(rhs, env), tail))));
        }
    }
    return RewriteTokens(s, env);
}
