// src/self_hosted/codegen/text/text_owner.pgy
//
// Text and delimiter scanning primitives owned by the self-host codegen front boundary.

import "../../hir/ast_text_scan_owner.pgy";

func Die(msg: String) -> Void {
    Log(Concat("CODEGEN ERROR: ", msg));
    Exit(1);
}

func ContainsCallOutsideStrings(text: String, callee: String) -> Bool {
    let n: Int = StringLength(text);
    let needle: String = Concat(callee, "(");
    let m: Int = StringLength(needle);
    let i: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CodegenCharAt(text, i);
        if in_str {
            if c == "\\" {
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            i = i + 1;
            continue;
        }
        if m > 0 && i + m <= n && Substring(text, i, m) == needle {
            if i == 0 || !IsIdentChar(CodegenCharAt(text, i - 1)) {
                return true;
            }
        }
        i = i + 1;
    }
    return false;
}

func ContainsOutsideStrings(text: String, needle: String) -> Bool {
    let n: Int = StringLength(text);
    let m: Int = StringLength(needle);
    let i: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CodegenCharAt(text, i);
        if in_str {
            if c == "\\" {
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            i = i + 1;
            continue;
        }
        if m > 0 && i + m <= n && Substring(text, i, m) == needle {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func TrySurfaceAllowedLine(line: String) -> Bool {
    let t: String = StringTrim(line);
    if !StartsWith(t, "Let: ") {
        return false;
    }
    return StringIndexOf(t, " : Int = (?") >= 0;
}

func RejectUnsupportedCodegenBuiltins(tree_text: String) -> Void {
    let total: Int = StringLength(tree_text);
    let pos: Int = 0;
    while pos < total {
        let nl: Int = NextNewline(tree_text, pos);
        let line: String = Substring(tree_text, pos, nl - pos);
        if ContainsOutsideStrings(line, "(?") && !TrySurfaceAllowedLine(line) {
            Die("unsupported try expression in self-host codegen subset");
        }
        pos = nl + 1;
    }
}

func IsIdentStart(c: String) -> Bool {
    if StringLength(c) != 1 {
        return false;
    }
    let chars: String = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_";
    return StringIndexOf(chars, c) >= 0;
}

// Given the index of a '[' in `s`, return the index of its matching ']',
// respecting nesting and string literals.
func FindMatchingBracket(s: String, open_idx: Int) -> Option<Int> {
    let n: Int = StringLength(s);
    let i: Int = open_idx;
    let depth: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CodegenCharAt(s, i);
        if in_str {
            if c == "\\" {
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
        } else if c == "[" {
            depth = depth + 1;
        } else if c == "]" {
            depth = depth - 1;
            if depth == 0 {
                return Some(i);
            }
        }
        i = i + 1;
    }
    return None;
}

// Strip redundant parentheses that wrap an entire expression. The AST printer
// fully parenthesizes infix (`(("a" + b) + "c")`), which would hide top-level
// operators behind depth > 0. Removes one wrapping layer at a time.
func StripOuterParens(e: String) -> String {
    let s: String = StringTrim(e);
    while StringLength(s) >= 2 && CodegenCharAt(s, 0) == "(" {
        let close: Option<Int> = FindMatchingParen(s, 0);
        if !IsSome(close) || UnwrapOption(close) != StringLength(s) - 1 {
            return s;
        }
        s = StringTrim(Substring(s, 1, StringLength(s) - 2));
    }
    return s;
}

// Find the first top-level single-char `+` (string-concatenation operator) in a
// string-valued expression: depth 0 (outside any (), []) and outside string
// literals.
func FindTopLevelPlus(s: String) -> Option<Int> {
    let n: Int = StringLength(s);
    let i: Int = 0;
    let depth: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: String = CodegenCharAt(s, i);
        if in_str {
            if c == "\\" {
                i = i + 2;
                continue;
            }
            if c == "\"" {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            in_str = true;
            i = i + 1;
            continue;
        }
        if c == "(" || c == "[" {
            depth = depth + 1;
            i = i + 1;
            continue;
        }
        if c == ")" || c == "]" {
            depth = depth - 1;
            i = i + 1;
            continue;
        }
        if depth == 0 && c == "+" {
            return Some(i);
        }
        i = i + 1;
    }
    return None;
}

// ---- Type environment --------------------------------------------------
// The environment is a string of `name=kind:Type|` entries with a leading
// `|`, e.g. `|Greet=f:String|who=v:String|`. kind is `v` (variable) or `f`
// (function return). Lookups search for `|name=kind:` and read to the next
// `|`. Variables are flat per function (no block scoping); functions are
// global. This is enough for run-stdout parity on the supported subset.
