// src/self_hosted/codegen/type_facts/type_env.pgy
//
// Layered type-environment and expression-kind owner for self-host C emission.

import "../text/text_owner.pgy";
import "../../semantic/array_type_shape_owner.pgy";
import "type_env_global_index_owner.pgy";
import "type_env_local_row_scan_owner.pgy";
import "type_env_local_row_materialization_owner.pgy";

struct CodegenTypeEnv {
    global_rows: String;
    preseal_rows: String;
    preseal_index: CodegenTypeGlobalIndex;
    local_rows: String;
    global_index: CodegenTypeGlobalIndex;
}

func CodegenTypeEnvFromRows(
    global_rows: String, local_rows: String
) -> CodegenTypeEnv {
    let global_index: CodegenTypeGlobalIndex =
        CodegenTypeGlobalIndexFromRows(global_rows);
    if !CodegenTypeGlobalIndexArraysReady(global_index) {
        Die("codegen global type rows are malformed");
    }
    return CodegenTypeEnv(
        global_rows, "", CodegenTypeGlobalIndexMissing(),
        local_rows, global_index
    );
}

func CodegenTypeEnvFromPresealRows(
    global_rows: String, local_rows: String
) -> CodegenTypeEnv {
    // Declaration scheduling owns a changing row epoch.  Callers may seal one
    // dependency snapshot per selected batch, never once per field/parameter.
    return CodegenTypeEnvFromRows(global_rows, local_rows);
}

func CodegenTypeEnvAppendPresealRows(
    env: CodegenTypeEnv, rows: String
) -> CodegenTypeEnv {
    if rows == "" { return env; }
    if CodegenCharAt(rows, StringLength(rows) - 1) != "|" {
        Die("codegen preseal type-row delta is malformed");
    }
    let preseal_rows: String = env.preseal_rows;
    if preseal_rows == "" { preseal_rows = "|"; }
    return CodegenTypeEnv(
        env.global_rows, Concat(preseal_rows, rows),
        CodegenTypeGlobalIndexMissing(), env.local_rows, env.global_index
    );
}

func CodegenTypeEnvSealPresealRows(env: CodegenTypeEnv) -> CodegenTypeEnv {
    if env.preseal_rows == "" { return env; }
    let index: CodegenTypeGlobalIndex =
        CodegenTypeGlobalIndexFromRows(env.preseal_rows);
    if !CodegenTypeGlobalIndexArraysReady(index) {
        Die("codegen preseal type-row index is malformed");
    }
    return CodegenTypeEnv(
        env.global_rows, env.preseal_rows, index,
        env.local_rows, env.global_index
    );
}

func CodegenTypeEnvAdvancePresealRows(
    inout global_rows_box: Array<String>, env: CodegenTypeEnv, rows: String
) -> CodegenTypeEnv {
    if rows == "" { return env; }
    if ArrayLength(global_rows_box) != 1 ||
        CodegenCharAt(rows, StringLength(rows) - 1) != "|" {
        Die("codegen preseal type-row delta is malformed");
    }
    ArraySet(global_rows_box, 0, Concat(global_rows_box[0], rows));
    return CodegenTypeEnvAppendPresealRows(env, rows);
}

func LookupKindType(env: CodegenTypeEnv, name: String, kind: String) -> String {
    // Preserve the flat owner's established first-row semantics while the
    // rows live in separate storage. Scope-aware shadowing needs typed scope
    // facts; changing precedence here would silently redefine name lookup.
    let global_value: String = CodegenTypeGlobalIndexLookupAdmitted(
        env.global_index, env.global_rows, name, kind
    );
    if StringLength(global_value) > 0 {
        return global_value;
    }
    let preseal_value: String = "";
    if env.preseal_rows != "" {
        if CodegenTypeGlobalIndexArraysReady(env.preseal_index) {
            preseal_value = CodegenTypeGlobalIndexLookupAdmitted(
                env.preseal_index, env.preseal_rows, name, kind
            );
        } else {
            let preseal_row: Option<String> =
                LookupKindTypeRows(env.preseal_rows, name, kind);
            if IsSome(preseal_row) {
                preseal_value = UnwrapOption(preseal_row);
            }
        }
    }
    if StringLength(preseal_value) > 0 { return preseal_value; }
    let local_row_value: Option<String> =
        LookupKindTypeRows(env.local_rows, name, kind);
    if !IsSome(local_row_value) { return ""; }
    return UnwrapOption(local_row_value);
}

func LookupKindTypeRowPresent(
    env: CodegenTypeEnv, name: String, kind: String
) -> Bool {
    let present: Bool = CodegenTypeGlobalIndexContainsAdmitted(
        env.global_index, env.global_rows, name, kind
    );
    if present { return true; }
    if env.preseal_rows != "" {
        if CodegenTypeGlobalIndexArraysReady(env.preseal_index) {
            if CodegenTypeGlobalIndexContainsAdmitted(
                env.preseal_index, env.preseal_rows, name, kind
            ) { return true; }
        } else if LookupKindTypeRowPresentRows(
            env.preseal_rows, name, kind
        ) { return true; }
    }
    return LookupKindTypeRowPresentRows(env.local_rows, name, kind);
}

func TypeEnvAppendLocalRows(
    env: CodegenTypeEnv, rows: String
) -> CodegenTypeEnv {
    if rows == "" { return env; }
    let local_rows: String = env.local_rows;
    let next_local_rows: String = Concat(rows, local_rows);
    return CodegenTypeEnv(env.global_rows, env.preseal_rows, env.preseal_index,
        next_local_rows,
        env.global_index);
}

func TypeEnvAppendValueBinding(env: CodegenTypeEnv, source_name: String, value_kind: String, c_name: String) -> CodegenTypeEnv {
    if LookupKindType(env, source_name, "v") == value_kind &&
        LookupKindType(env, source_name, "cbind") == c_name {
        return env;
    }
    return TypeEnvAppendLocalRows(
        env, TypeEnvValueBindingRows(
            source_name, value_kind, c_name
        )
    );
}


func TypeEnvAppendReadonlyRefBinding(
    env: CodegenTypeEnv, source_name: String, value_kind: String, ref_c_name: String
) -> CodegenTypeEnv {
    if LookupKindType(env, source_name, "v") == value_kind &&
        LookupKindType(env, source_name, "cref") == ref_c_name {
        return env;
    }
    return TypeEnvAppendLocalRows(
        env, TypeEnvReadonlyRefBindingRows(
            source_name, value_kind, ref_c_name
        )
    );
}

func TypeEnvReadonlyRefCName(
    env: CodegenTypeEnv, source_name: String
) -> Option<String> {
    let ref_c_name: String = LookupKindType(env, source_name, "cref");
    if StringLength(ref_c_name) == 0 {
        return None;
    }
    return Some(ref_c_name);
}

func TypeEnvBindingIsReadonlyRef(env: CodegenTypeEnv, source_name: String) -> Bool {
    return IsSome(TypeEnvReadonlyRefCName(env, source_name));
}

func TypeEnvBindingCName(env: CodegenTypeEnv, source_name: String) -> String {
    let c_name: String = LookupKindType(env, source_name, "cbind");
    if StringLength(c_name) > 0 {
        return c_name;
    }
    return source_name;
}

func TypeEnvSemanticValueType(
    env: CodegenTypeEnv, source_name: String
) -> String {
    return LookupKindType(env, source_name, "type");
}

func CsvAt(csv: String, want: Int) -> String {
    let i: Int = 0;
    let idx: Int = 0;
    let start: Int = 0;
    let n: Int = StringLength(csv);
    while i <= n {
        if i == n || CodegenCharCodeAt(csv, n, i) == 44 {
            if idx == want {
                return Substring(csv, start, i - start);
            }
            idx = idx + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

func ParamModeCsvCount(modes: String) -> Int {
    let n: Int = StringLength(modes);
    if n == 0 {
        return 0;
    }
    let count: Int = 1;
    let i: Int = 0;
    while i < n {
        if CodegenCharCodeAt(modes, n, i) == 44 {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

func ParamModeCsvAt(modes: String, want: Int) -> String {
    return CsvAt(modes, want);
}

func CodegenTypeOwnedQualifiedKey(
    owner: String, member: String
) -> String {
    let suffix: String = Concat(".", member);
    let key: String = Concat(owner, suffix);
    let retired: Array<String> = [suffix];
    ArrayDropOwnedStrings(retired);
    return key;
}

func LookupQualifiedKindType(
    env: CodegenTypeEnv, owner: String, member: String, kind: String
) -> String {
    let key: String = CodegenTypeOwnedQualifiedKey(owner, member);
    let value: String = LookupKindType(env, key, kind);
    let retired: Array<String> = [key];
    ArrayDropOwnedStrings(retired);
    return value;
}

func LookupFieldType(env: CodegenTypeEnv, owner: String, field: String) -> String {
    return LookupQualifiedKindType(env, owner, field, "field");
}

func ExprMemberFieldType(expr: String, env: CodegenTypeEnv) -> String {
    let e: String = StringTrim(expr);
    let n: Int = StringLength(e);
    let first_dot: Int = StringIndexOf(e, ".");
    if first_dot <= 0 {
        return "";
    }
    let receiver: String = Substring(e, 0, first_dot);
    if !IsIdentifier(receiver) {
        return "";
    }
    let owner: String = LookupKindType(env, receiver, "v");
    if StringLength(owner) == 0 {
        return "";
    }
    let pos: Int = first_dot;
    while pos < n {
        if CodegenCharAt(e, pos) != "." {
            return "";
        }
        pos = pos + 1;
        if pos >= n || !IsIdentStart(CodegenCharAt(e, pos)) {
            return "";
        }
        let start: Int = pos;
        while pos < n && IsIdentChar(CodegenCharAt(e, pos)) {
            pos = pos + 1;
        }
        let field: String = Substring(e, start, pos - start);
        let ftype: String = LookupFieldType(env, owner, field);
        if StringLength(ftype) == 0 {
            return "";
        }
        owner = ftype;
    }
    return owner;
}

func ExprCollectionElementKind(kind: String) -> String {
    let semantic_element: Option<String> =
        SemanticArrayElementType(kind);
    if IsSome(semantic_element) {
        return UnwrapOption(semantic_element);
    }
    if kind == "ArrayString" || kind == "Array<String>" || kind == "Array<String: String>" {
        return "String";
    }
    if kind == "ArrayCodegenAstTextNode" ||
        kind == "Array<CodegenAstTextNode>" ||
        kind == "Array<CodegenAstTextNode: CodegenAstTextNode>" {
        return "CodegenAstTextNode";
    }
    if kind == "ArrayInt" || kind == "Array<Int>" || kind == "Array<Int: Int>" {
        return "Int";
    }
    if kind == "ArrayBool" || kind == "Array<Bool>" || kind == "Array<Bool: Bool>" {
        return "Bool";
    }
    return "";
}

// Classify an expression using the environment.
func ExprKind(expr: String, env: CodegenTypeEnv) -> String {
    let e: String = StringTrim(expr);
    if StringLength(e) == 0 {
        return "Int";
    }
    let member_type: String = ExprMemberFieldType(e, env);
    if StringLength(member_type) > 0 {
        return member_type;
    }
    if LookupKindType(env, e, "e") != "" {
        return "Int";
    }
    let enum_type: String = LookupKindType(env, e, "etype");
    if enum_type != "" {
        return enum_type;
    }
    if CodegenCharAt(e, 0) == "\"" {
        return "String";
    }
    if StringIndexOf("0123456789", CodegenCharAt(e, 0)) >= 0 &&
        CodegenCharAt(e, StringLength(e) - 1) == "L" {
        return "Long";
    }
    // A top-level `+` whose left operand is a string is string concatenation.
    let stripped: String = StripOuterParens(e);
    let plus_opt: Option<Int> = FindTopLevelPlus(stripped);
    if IsSome(plus_opt) {
        let plus: Int = UnwrapOption(plus_opt);
        let lhs: String = StringTrim(Substring(stripped, 0, plus));
        let rhs: String = StringTrim(Substring(stripped, plus + 1, StringLength(stripped) - (plus + 1)));
        if ExprKind(lhs, env) == "String" {
            return "String";
        }
        if ExprKind(lhs, env) == "Float" || ExprKind(rhs, env) == "Float" {
            return "Float";
        }
        if ExprKind(lhs, env) == "Long" || ExprKind(rhs, env) == "Long" {
            return "Long";
        }
    }
    if StartsWith(e, "Concat(") {
        return "String";
    }
    if StartsWith(e, "Substring(") {
        return "String";
    }
    if StartsWith(e, "CharAtN(") {
        return "String";
    }
    if StartsWith(e, "CharCode(") {
        return "Int";
    }
    if StartsWith(e, "StringTrim(") {
        return "String";
    }
    if StartsWith(e, "StringJoin(") {
        return "String";
    }
    if StartsWith(e, "Join(") {
        return "String";
    }
    if StartsWith(e, "Split(") || StartsWith(e, "StringSplit(") {
        return "ArrayString";
    }
    if StartsWith(e, "ArraySort(") {
        return "ArrayInt";
    }
    if StartsWith(e, "ArrayReverse(") {
        return "ArrayInt";
    }
    if StartsWith(e, "ArrayMap(") {
        return "ArrayInt";
    }
    if StartsWith(e, "ArrayFilter(") {
        return "ArrayInt";
    }
    if StartsWith(e, "Some(") {
        let some_open: Int = StringIndexOf(e, "(");
        let some_close_opt: Option<Int> = FindMatchingParen(e, some_open);
        if IsSome(some_close_opt) && UnwrapOption(some_close_opt) == StringLength(e) - 1 {
            let some_inner: String = StringTrim(Substring(e, some_open + 1, UnwrapOption(some_close_opt) - some_open - 1));
            if ExprKind(some_inner, env) == "String" {
                return "OptionString";
            }
            if ExprKind(some_inner, env) == "Bool" {
                return "OptionBool";
            }
        }
        return "OptionInt";
    }
    if e == "None" {
        return "OptionInt";
    }
    if StartsWith(e, "IsSome(") {
        return "Bool";
    }
    if StartsWith(e, "UnwrapOption(") {
        let unwrap_open: Int = StringIndexOf(e, "(");
        let unwrap_close_opt: Option<Int> = FindMatchingParen(e, unwrap_open);
        if IsSome(unwrap_close_opt) && UnwrapOption(unwrap_close_opt) == StringLength(e) - 1 {
            let unwrap_inner: String = StringTrim(Substring(e, unwrap_open + 1, UnwrapOption(unwrap_close_opt) - unwrap_open - 1));
            if ExprKind(unwrap_inner, env) == "OptionString" {
                return "String";
            }
            if ExprKind(unwrap_inner, env) == "OptionBool" {
                return "Bool";
            }
        }
        return "Int";
    }
    if StartsWith(e, "Ok(") {
        return "ResultInt";
    }
    if StartsWith(e, "Err(") {
        return "ResultInt";
    }
    if StartsWith(e, "Unwrap(") {
        return "Int";
    }
    if StartsWith(e, "UnwrapOr(") {
        return "Int";
    }
    if StartsWith(e, "IsOk(") {
        return "Bool";
    }
    if StartsWith(e, "IsErr(") {
        return "Bool";
    }
    if StartsWith(e, "StringContains(") {
        return "Int";
    }
    if StartsWith(e, "ToInt(") {
        return "Int";
    }
    if StartsWith(e, "ToFloat(") {
        return "Float";
    }
    if StartsWith(e, "ReadFile(") {
        return "String";
    }
    if StartsWith(e, "ReadStdin(") {
        return "String";
    }
    if StartsWith(e, "DirWalk(") {
        return "ArrayString";
    }
    if StartsWith(e, "FileExists(") {
        return "Int";
    }
    if StartsWith(e, "FileOpen(") {
        return "Int";
    }
    if StartsWith(e, "FileRead(") {
        return "String";
    }
    if StartsWith(e, "Args(") {
        return "ArrayString";
    }
    let bracket: Int = StringIndexOf(e, "[");
    if bracket > 0 && CodegenCharAt(e, StringLength(e) - 1) == "]" {
        let arr_name: String = Substring(e, 0, bracket);
        let arr_kind: String = LookupKindType(env, arr_name, "v");
        if StringLength(arr_kind) == 0 {
            arr_kind = ExprMemberFieldType(arr_name, env);
        }
        let elem_kind: String = ExprCollectionElementKind(arr_kind);
        if StringLength(elem_kind) > 0 {
            return elem_kind;
        }
    }
    if StartsWith(e, "ToString(") {
        return "String";
    }
    if StartsWith(e, "StringLength(") {
        return "Int";
    }
    if StartsWith(e, "ToUpper(") {
        return "String";
    }
    if StartsWith(e, "ToLower(") {
        return "String";
    }
    if StartsWith(e, "StringReplace(") {
        return "String";
    }
    if StartsWith(e, "Abs(") {
        return "Int";
    }
    if StartsWith(e, "Min(") {
        return "Int";
    }
    if StartsWith(e, "Max(") {
        return "Int";
    }
    if StartsWith(e, "Sqrt(") {
        return "Float";
    }
    if StartsWith(e, "Pow(") {
        return "Float";
    }
    if StartsWith(e, "Floor(") {
        return "Float";
    }
    if StartsWith(e, "Ceil(") {
        return "Float";
    }
    if IsIdentifier(e) {
        let vt: String = LookupKindType(env, e, "v");
        if StringLength(vt) > 0 {
            return vt;
        }
        return "Int";
    }
    if IsSingleCall(e) {
        let op: Int = StringIndexOf(e, "(");
        let fname: String = Substring(e, 0, op);
        let call_alias: String = LookupKindType(env, fname, "call");
        if StringLength(call_alias) > 0 {
            fname = call_alias;
        }
        let ft: String = LookupKindType(env, fname, "f");
        if StringLength(ft) > 0 {
            return ft;
        }
        return "Int";
    }
    // Array element access `IDENT[...]`: element type follows the array's kind.
    let ob: Int = StringIndexOf(e, "[");
    if ob > 0 {
        let pfx: String = Substring(e, 0, ob);
        let close_opt: Option<Int> = FindMatchingBracket(e, ob);
        if IsSome(close_opt) && UnwrapOption(close_opt) == StringLength(e) - 1 {
            let pfx_kind: String = LookupKindType(env, pfx, "v");
            if StringLength(pfx_kind) == 0 {
                pfx_kind = ExprMemberFieldType(pfx, env);
            }
            let pfx_elem_kind: String = ExprCollectionElementKind(pfx_kind);
            if StringLength(pfx_elem_kind) > 0 {
                return pfx_elem_kind;
            }
        }
    }
    return "Int";
}

// Replace every occurrence of `from` with `to` in `s`.
