// Function-local codegen type-row ownership and last-consumer retirement.

import "type_env.pgy";
import "../text/text_owner.pgy";

struct CodegenTypeEnvState {
    local_rows: String;
    owned_epochs: Array<String>;
}

// Each scope owns its snapshots. Views borrow the current snapshot until the
// scope's last consumer; a Bool or String field is never retirement authority.
func CodegenTypeEnvStateOwned(own local_rows: String) -> CodegenTypeEnvState {
    let retired: Array<String> = [local_rows];
    let epochs: Array<String> = Clone(retired);
    ArrayDropOwnedStrings(retired);
    let state: CodegenTypeEnvState = CodegenTypeEnvState("", epochs);
    state.local_rows = state.owned_epochs[0];
    return state;
}

func CodegenTypeEnvStateBorrow(
    ref state: CodegenTypeEnvState
) -> CodegenTypeEnvState {
    let epochs: Array<String> = [];
    return CodegenTypeEnvState(state.local_rows, epochs);
}

func CodegenTypeEnvStateView(
    ref state: CodegenTypeEnvState, base_env: CodegenTypeEnv
) -> CodegenTypeEnv {
    // The sealed global epoch remains owned by `base_env`; only local rows vary.
    return CodegenTypeEnv(
        base_env.global_rows, base_env.preseal_rows, base_env.preseal_index,
        state.local_rows, base_env.global_index
    );
}

func CodegenTypeEnvStateAppendEpoch(
    inout epochs: Array<String>, own rows: String
) -> Void {
    ArrayPushOwnedString(epochs, rows);
    let retired: Array<String> = [rows];
    ArrayDropOwnedStrings(retired);
}

func CodegenTypeEnvStateReleaseLocal(
    inout state: CodegenTypeEnvState
) -> Void {
    let epochs: Array<String> = state.owned_epochs;
    ArrayDropOwnedStrings(epochs);
    state.owned_epochs = epochs;
    state.local_rows = "";
}

func CodegenTypeEnvStateAdoptAfterLastConsumer(
    inout state: CodegenTypeEnvState,
    ref next_state: CodegenTypeEnvState
) -> Void {
    let epochs: Array<String> = state.owned_epochs;
    if next_state.local_rows != state.local_rows {
        if ArrayLength(next_state.owned_epochs) == 0 {
            Die("codegen type environment replacement is not owned");
        }
        CodegenTypeEnvStateAppendEpoch(epochs, Concat("", next_state.local_rows));
    }
    state.owned_epochs = epochs;
    if ArrayLength(state.owned_epochs) != 0 {
        state.local_rows = state.owned_epochs[ArrayLength(state.owned_epochs) - 1];
    }
}

func CodegenTypeEnvStateAppendValueBinding(
    inout state: CodegenTypeEnvState, env: CodegenTypeEnv, source_name: String,
    value_kind: String, c_name: String
) -> Void {
    let view: CodegenTypeEnv = CodegenTypeEnvStateView(state, env);
    if LookupKindType(view, source_name, "v") == value_kind &&
        LookupKindType(view, source_name, "cbind") == c_name { return; }
    let rows: String = TypeEnvValueBindingRows(source_name, value_kind, c_name);
    let combined: String = Concat(rows, view.local_rows);
    let epochs: Array<String> = state.owned_epochs;
    CodegenTypeEnvStateAppendEpoch(epochs, combined);
    state.owned_epochs = epochs;
    state.local_rows = state.owned_epochs[ArrayLength(state.owned_epochs) - 1];
    let retired: Array<String> = [rows];
    ArrayDropOwnedStrings(retired);
}

func CodegenTypeEnvStateAppendOwnedLocalRows(
    inout state: CodegenTypeEnvState, env: CodegenTypeEnv,
    own rows: String
) -> Void {
    let view: CodegenTypeEnv = CodegenTypeEnvStateView(state, env);
    let combined: String = Concat(rows, view.local_rows);
    let epochs: Array<String> = state.owned_epochs;
    CodegenTypeEnvStateAppendEpoch(epochs, combined);
    state.owned_epochs = epochs;
    state.local_rows = state.owned_epochs[ArrayLength(state.owned_epochs) - 1];
    let retired: Array<String> = [rows];
    ArrayDropOwnedStrings(retired);
}

func CodegenTypeEnvStateAppendTypedValueBinding(
    inout state: CodegenTypeEnvState, env: CodegenTypeEnv, source_name: String,
    value_type: String, value_kind: String, c_name: String
) -> Void {
    let rows: String = TypeEnvTypedValueBindingRows(
        source_name, value_type, value_kind, c_name
    );
    let view: CodegenTypeEnv = CodegenTypeEnvStateView(state, env);
    let combined: String = Concat(rows, view.local_rows);
    let epochs: Array<String> = state.owned_epochs;
    CodegenTypeEnvStateAppendEpoch(epochs, combined);
    state.owned_epochs = epochs;
    state.local_rows = state.owned_epochs[ArrayLength(state.owned_epochs) - 1];
    let retired: Array<String> = [rows];
    ArrayDropOwnedStrings(retired);
}
