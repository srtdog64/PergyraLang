// src/self_hosted/codegen/typed_ast_node_skeleton.pgy
//
// Typed AST arena payload contract owner. This is the migration target for
// replacing the AST text bridge with owned node records.
//
// WHY THIS EXISTS
// ---------------
// Today the self-host compiler still carries the AST as serialized tree text,
// and the "typed" compiler-world objects are veneers: `object AstTree { schema:
// String; }` carries the whole tree as a serialized String. Because the core
// datum is String, every lookup tends toward sentinel and text-munging APIs.
// That is C-shaped code passing through the Pergyra parser; it is not idiomatic
// Pergyra. This file owns the first payload contract for a typed arena that
// future parser/codegen cutover slices can consume.
//
// BOOTSTRAP-COMPATIBLE SHAPE
// --------------------------
// Recursive enum payloads are not lowered by the current self-host rungs, so this
// uses a flat arena: nodes live in arrays indexed by a NodeId (an Int), children
// are NodeId edges, and textual atoms (identifiers, literals) are interned into
// a string table. NodeKind is payload-free. Not-found is Option, never a
// sentinel.

enum NodeKind {
    Program,
    FuncDecl,
    Param,
    Block,
    LetStmt,
    AssignStmt,
    ReturnStmt,
    IfStmt,
    WhileStmt,
    ForStmt,
    CallExpr,
    BinaryExpr,
    UnaryExpr,
    IndexExpr,
    MemberExpr,
    IntLit,
    FloatLit,
    StringLit,
    BoolLit,
    Ident,
    TypeRef
}

// A NodeId is an index into the arena's parallel arrays. Missing edges are
// represented as absent Option values at lookup boundaries.

struct AstNode {
    kind: NodeKind;
    atom: Int;
    has_atom: Bool;
    first_child: Int;
    child_count: Int;
}

struct AstArena {
    nodes: Array<Int>;        // placeholder until Array<AstNode> field-lowering lands
    children: Array<Int>;     // flattened child NodeId edges
    atom_table: Array<String>; // interned identifier/literal text
}

func ChildAtFromEdges(children: Array<Int>, first_child: Int, child_count: Int, i: Int) -> Option<Int> {
    if i < 0 {
        return None;
    }
    if i >= child_count {
        return None;
    }
    let edge: Int = first_child + i;
    return Some(children[edge]);
}

func ChildAt(arena: AstArena, node: AstNode, i: Int) -> Option<Int> {
    return ChildAtFromEdges(arena.children, node.first_child, node.child_count, i);
}

func AtomTextFromTable(atom_table: Array<String>, has_atom: Bool, atom: Int) -> Option<String> {
    if !has_atom {
        return None;
    }
    return Some(atom_table[atom]);
}

func AtomText(arena: AstArena, node: AstNode) -> Option<String> {
    return AtomTextFromTable(arena.atom_table, node.has_atom, node.atom);
}

func TypedAstArenaPayloadSchema() -> String {
    return "pgy.selfhost.typed-ast-arena.v1";
}

func TypedAstArenaPayloadFixtureCount() -> Int {
    return 1;
}

func TypedAstArenaRootTraversalReady() -> Bool {
    let children: Array<Int> = [1];
    let atom_table: Array<String> = ["", "Main"];

    let first_child: Option<Int> = ChildAtFromEdges(children, 0, 1, 0);
    if !IsSome(first_child) {
        return false;
    }
    if UnwrapOption(first_child) != 1 {
        return false;
    }
    if IsSome(ChildAtFromEdges(children, 0, 1, 1)) {
        return false;
    }
    if IsSome(AtomTextFromTable(atom_table, false, 0)) {
        return false;
    }

    let atom: Option<String> = AtomTextFromTable(atom_table, true, 1);
    if !IsSome(atom) {
        return false;
    }
    if UnwrapOption(atom) != "Main" {
        return false;
    }
    return true;
}

func TypedAstArenaPayloadContractReady() -> Bool {
    if TypedAstArenaPayloadSchema() != "pgy.selfhost.typed-ast-arena.v1" {
        return false;
    }
    if TypedAstArenaPayloadFixtureCount() != 1 {
        return false;
    }
    if !TypedAstArenaRootTraversalReady() {
        return false;
    }
    return true;
}
