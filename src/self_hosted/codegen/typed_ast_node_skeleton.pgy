// src/self_hosted/codegen/typed_ast_node_skeleton.pgy
//
// Typed AST arena payload contract owner. This is the migration target for
// replacing the AST text bridge with owned node records.
//
// WHY THIS EXISTS
// ---------------
// Today the self-host compiler still carries the AST as serialized tree text,
// and the "typed" compiler-world objects are veneers: `object AstTree { schema:
// String; }` carries the whole tree as a serialized String. Because the core
// datum is String, every lookup tends toward sentinel and text-munging APIs.
// That is C-shaped code passing through the Pergyra parser; it is not idiomatic
// Pergyra. This file owns the first payload contract for a typed arena that
// future parser/codegen cutover slices can consume.
//
// BOOTSTRAP-COMPATIBLE SHAPE
// --------------------------
// Recursive enum payloads are not lowered by the current self-host rungs, so this
// uses a flat arena: nodes live in arrays indexed by a NodeId (an Int), children
// are NodeId edges, and textual atoms (identifiers, literals) are interned into
// a string table. Type-name and parameter-mode rows are parallel facts owned by
// the arena, not ad hoc reads from the transitional text node. NodeKind is
// payload-free. Not-found is Option, never a sentinel.

enum NodeKind {
    Program,
    FuncDecl,
    Param,
    Block,
    LetStmt,
    AssignStmt,
    ReturnStmt,
    IfStmt,
    WhileStmt,
    ForStmt,
    CallExpr,
    BinaryExpr,
    UnaryExpr,
    IndexExpr,
    MemberExpr,
    IntLit,
    FloatLit,
    StringLit,
    BoolLit,
    Ident,
    TypeRef
}

// A NodeId is an index into the arena's parallel arrays. Missing edges are
// represented as absent Option values at lookup boundaries.

struct AstNode {
    kind: NodeKind;
    atom: Int;
    has_atom: Bool;
    type_name: Int;
    has_type_name: Bool;
    mode: Int;
    first_child: Int;
    child_count: Int;
    parent: Int;
    indent: Int;
}

struct AstArena {
    kinds: Array<Int>;
    atoms: Array<Int>;
    has_atoms: Array<Int>;
    type_names: Array<Int>;
    has_type_names: Array<Int>;
    modes: Array<Int>;
    first_children: Array<Int>;
    child_counts: Array<Int>;
    parents: Array<Int>;
    indents: Array<Int>;
    children: Array<Int>;
    atom_table: Array<String>;
}

func TypedAstKindProgramTag() -> Int {
    return 1;
}

func TypedAstKindFuncDeclTag() -> Int {
    return 2;
}

func TypedAstKindBlockTag() -> Int {
    return 3;
}

func TypedAstArenaFixture() -> AstArena {
    let kinds: Array<Int> = [TypedAstKindProgramTag(), TypedAstKindFuncDeclTag(), TypedAstKindBlockTag()];
    let atoms: Array<Int> = [0, 1, 0];
    let has_atoms: Array<Int> = [0, 1, 0];
    let type_names: Array<Int> = [0, 0, 0];
    let has_type_names: Array<Int> = [0, 0, 0];
    let modes: Array<Int> = [0, 0, 0];
    let first_children: Array<Int> = [0, 1, 2];
    let child_counts: Array<Int> = [1, 1, 0];
    let parents: Array<Int> = [-1, 0, 1];
    let indents: Array<Int> = [0, 2, 4];
    let children: Array<Int> = [1, 2];
    let atom_table: Array<String> = ["", "Main"];
    return AstArena(kinds, atoms, has_atoms, type_names, has_type_names, modes,
        first_children, child_counts, parents, indents, children, atom_table);
}

func TypedAstArenaNodeCount(arena: AstArena) -> Int {
    return ArrayLength(arena.kinds);
}

func TypedAstArenaParallelRowsReady(arena: AstArena) -> Bool {
    let n: Int = TypedAstArenaNodeCount(arena);
    return ArrayLength(arena.atoms) == n &&
        ArrayLength(arena.has_atoms) == n &&
        ArrayLength(arena.type_names) == n &&
        ArrayLength(arena.has_type_names) == n &&
        ArrayLength(arena.modes) == n &&
        ArrayLength(arena.first_children) == n &&
        ArrayLength(arena.child_counts) == n &&
        ArrayLength(arena.parents) == n &&
        ArrayLength(arena.indents) == n;
}

func TypedAstArenaHasNode(arena: AstArena, node_id: Int) -> Bool {
    return TypedAstArenaParallelRowsReady(arena) &&
        node_id >= 0 &&
        node_id < TypedAstArenaNodeCount(arena);
}

func TypedAstArenaNodeKind(arena: AstArena, node_id: Int) -> Option<Int> {
    if !TypedAstArenaHasNode(arena, node_id) {
        return None;
    }
    return Some(arena.kinds[node_id]);
}

func TypedAstArenaChildAt(arena: AstArena, node_id: Int, i: Int) -> Option<Int> {
    if !TypedAstArenaHasNode(arena, node_id) {
        return None;
    }
    if i < 0 {
        return None;
    }
    if i >= arena.child_counts[node_id] {
        return None;
    }
    let edge: Int = arena.first_children[node_id] + i;
    if edge < 0 || edge >= ArrayLength(arena.children) {
        return None;
    }
    return Some(arena.children[edge]);
}

func TypedAstArenaParentId(arena: AstArena, node_id: Int) -> Option<Int> {
    if !TypedAstArenaHasNode(arena, node_id) {
        return None;
    }
    return Some(arena.parents[node_id]);
}

func TypedAstArenaIndent(arena: AstArena, node_id: Int) -> Option<Int> {
    if !TypedAstArenaHasNode(arena, node_id) {
        return None;
    }
    return Some(arena.indents[node_id]);
}

func TypedAstArenaAtomText(arena: AstArena, node_id: Int) -> Option<String> {
    if !TypedAstArenaHasNode(arena, node_id) {
        return None;
    }
    if arena.has_atoms[node_id] == 0 {
        return None;
    }
    let atom: Int = arena.atoms[node_id];
    if atom < 0 || atom >= ArrayLength(arena.atom_table) {
        return None;
    }
    return Some(arena.atom_table[atom]);
}

func TypedAstArenaTypeName(arena: AstArena, node_id: Int) -> Option<String> {
    if !TypedAstArenaHasNode(arena, node_id) {
        return None;
    }
    if arena.has_type_names[node_id] == 0 {
        return None;
    }
    let type_atom: Int = arena.type_names[node_id];
    if type_atom < 0 || type_atom >= ArrayLength(arena.atom_table) {
        return None;
    }
    return Some(arena.atom_table[type_atom]);
}

func TypedAstArenaMode(arena: AstArena, node_id: Int) -> Option<Int> {
    if !TypedAstArenaHasNode(arena, node_id) {
        return None;
    }
    return Some(arena.modes[node_id]);
}

func ChildAtFromEdges(children: Array<Int>, first_child: Int, child_count: Int, i: Int) -> Option<Int> {
    if i < 0 {
        return None;
    }
    if i >= child_count {
        return None;
    }
    let edge: Int = first_child + i;
    return Some(children[edge]);
}

func ChildAt(arena: AstArena, node: AstNode, i: Int) -> Option<Int> {
    return ChildAtFromEdges(arena.children, node.first_child, node.child_count, i);
}

func AtomTextFromTable(atom_table: Array<String>, has_atom: Bool, atom: Int) -> Option<String> {
    if !has_atom {
        return None;
    }
    return Some(atom_table[atom]);
}

func AtomText(arena: AstArena, node: AstNode) -> Option<String> {
    return AtomTextFromTable(arena.atom_table, node.has_atom, node.atom);
}

func TypedAstArenaPayloadSchema() -> String {
    return "pgy.selfhost.typed-ast-arena.v1";
}

func TypedAstArenaPayloadFixtureCount() -> Int {
    return 1;
}

func TypedAstArenaRootTraversalReady() -> Bool {
    let arena: AstArena = TypedAstArenaFixture();
    if !TypedAstArenaParallelRowsReady(arena) {
        return false;
    }
    if TypedAstArenaNodeCount(arena) != 3 {
        return false;
    }

    let root_kind: Option<Int> = TypedAstArenaNodeKind(arena, 0);
    if !IsSome(root_kind) || UnwrapOption(root_kind) != TypedAstKindProgramTag() {
        return false;
    }

    let first_child: Option<Int> = TypedAstArenaChildAt(arena, 0, 0);
    if !IsSome(first_child) || UnwrapOption(first_child) != 1 {
        return false;
    }
    let root_parent: Option<Int> = TypedAstArenaParentId(arena, 0);
    if !IsSome(root_parent) || UnwrapOption(root_parent) != -1 {
        return false;
    }
    let root_indent: Option<Int> = TypedAstArenaIndent(arena, 0);
    if !IsSome(root_indent) || UnwrapOption(root_indent) != 0 {
        return false;
    }
    if IsSome(TypedAstArenaChildAt(arena, 0, 1)) {
        return false;
    }

    let func_kind: Option<Int> = TypedAstArenaNodeKind(arena, UnwrapOption(first_child));
    if !IsSome(func_kind) || UnwrapOption(func_kind) != TypedAstKindFuncDeclTag() {
        return false;
    }

    let block_child: Option<Int> = TypedAstArenaChildAt(arena, UnwrapOption(first_child), 0);
    if !IsSome(block_child) || UnwrapOption(block_child) != 2 {
        return false;
    }
    let func_parent: Option<Int> = TypedAstArenaParentId(arena, UnwrapOption(first_child));
    if !IsSome(func_parent) || UnwrapOption(func_parent) != 0 {
        return false;
    }
    let func_indent: Option<Int> = TypedAstArenaIndent(arena, UnwrapOption(first_child));
    if !IsSome(func_indent) || UnwrapOption(func_indent) != 2 {
        return false;
    }
    let block_kind: Option<Int> = TypedAstArenaNodeKind(arena, UnwrapOption(block_child));
    if !IsSome(block_kind) || UnwrapOption(block_kind) != TypedAstKindBlockTag() {
        return false;
    }
    let block_parent: Option<Int> = TypedAstArenaParentId(arena, UnwrapOption(block_child));
    if !IsSome(block_parent) || UnwrapOption(block_parent) != 1 {
        return false;
    }
    let block_indent: Option<Int> = TypedAstArenaIndent(arena, UnwrapOption(block_child));
    if !IsSome(block_indent) || UnwrapOption(block_indent) != 4 {
        return false;
    }
    if IsSome(TypedAstArenaChildAt(arena, UnwrapOption(block_child), 0)) {
        return false;
    }

    if IsSome(TypedAstArenaAtomText(arena, 0)) {
        return false;
    }
    let atom: Option<String> = TypedAstArenaAtomText(arena, UnwrapOption(first_child));
    if !IsSome(atom) || UnwrapOption(atom) != "Main" {
        return false;
    }
    if IsSome(TypedAstArenaAtomText(arena, 99)) {
        return false;
    }
    if IsSome(TypedAstArenaTypeName(arena, UnwrapOption(first_child))) {
        return false;
    }
    let mode: Option<Int> = TypedAstArenaMode(arena, UnwrapOption(first_child));
    if !IsSome(mode) || UnwrapOption(mode) != 0 {
        return false;
    }
    return true;
}

func TypedAstArenaPayloadContractReady() -> Bool {
    if TypedAstArenaPayloadSchema() != "pgy.selfhost.typed-ast-arena.v1" {
        return false;
    }
    if TypedAstArenaPayloadFixtureCount() != 1 {
        return false;
    }
    if !TypedAstArenaRootTraversalReady() {
        return false;
    }
    return true;
}
