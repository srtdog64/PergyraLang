// Runnable ABI row projection over abi_layout_row_owner.pgy.

import "abi_layout_row_owner.pgy";
import "abi_layout_target_policy_owner.pgy";

func CompilerAbiLayoutManifestRowAt(index: Int) -> String {
    let row0: String = Concat(ToString(index), "|");
    let row1: String = Concat(row0, CompilerAbiLayoutRowTypeNameAt(index));
    let row2: String = Concat(row1, "|");
    let row3: String = Concat(row2, CompilerAbiLayoutRowCValueTypeAt(index));
    let row4: String = Concat(row3, "|");
    let row5: String = Concat(row4, CompilerAbiLayoutRowFieldOrderAt(index));
    let row6: String = Concat(row5, "|");
    let row7: String = Concat(row6, CompilerAbiLayoutRowTagKindAt(index));
    let row8: String = Concat(row7, "|");
    let row9: String = Concat(row8, CompilerAbiLayoutRowNicheAt(index));
    let row10: String = Concat(row9, "|");
    let row11: String = Concat(row10, CompilerAbiLayoutRowOwnershipShapeAt(index));
    let row12: String = Concat(row11, "|");
    let row13: String = Concat(row12, CompilerAbiLayoutRowTargetAbiAt(index));
    let row14: String = Concat(row13, "|");
    let row15: String = Concat(row14, CompilerAbiLayoutRowSizeAlignAt(index));
    let row16: String = Concat(row15, "|");
    let row17: String = Concat(row16, CompilerAbiLayoutRowMaterializationAt(index));
    let row18: String = Concat(row17, "|");
    return Concat(row18, CompilerAbiLayoutRowDefaultReturnValueAt(index));
}

func CompilerAbiLayoutTargetPolicyManifestRowAt(index: Int) -> String {
    let row0: String = Concat("target_policy|", ToString(index));
    let row1: String = Concat(row0, "|");
    let row2: String = Concat(row1, CompilerAbiLayoutTargetPolicyAbiAt(index));
    let row3: String = Concat(row2, "|");
    let row4: String = Concat(row3, CompilerAbiLayoutTargetPolicyProjectionSetAt(index));
    let row5: String = Concat(row4, "|");
    let row6: String = Concat(row5, CompilerAbiLayoutTargetPolicyRequiredFactsAt(index));
    let row7: String = Concat(row6, "|");
    return Concat(row7, CompilerAbiLayoutTargetPolicyFallbacksAt(index));
}

func Main() -> Void {
    if !CompilerAbiLayoutRowsReady() {
        Log("ABI_LAYOUT ERROR: row owner is not ready");
        Exit(1);
        return;
    }
    Log(Concat("schema=", CompilerAbiLayoutRowSchema()));
    Log(Concat("count=", ToString(CompilerAbiLayoutConcreteRowCount())));
    let i: Int = 0;
    while i < CompilerAbiLayoutConcreteRowCount() {
        Log(CompilerAbiLayoutManifestRowAt(i));
        i = i + 1;
    }
    Log(Concat("target_policy_count=", ToString(CompilerAbiLayoutTargetPolicyCount())));
    let target_policy_index: Int = 0;
    while target_policy_index < CompilerAbiLayoutTargetPolicyCount() {
        Log(CompilerAbiLayoutTargetPolicyManifestRowAt(target_policy_index));
        target_policy_index = target_policy_index + 1;
    }
}
