    if index == 4 { return "runtime function name pattern"; }
    return "";
}
func CompilerBackendAbiLayoutContractReady() -> Bool {
    return CompilerBackendAbiLayoutRequiredCount() == 13 &&
        CompilerBackendAbiLayoutForbiddenCount() == 5 &&
        CompilerBackendAbiLayoutNegativeSchema() != "" &&
        CompilerBackendAbiLayoutMissingInputFinding() != "" &&
        CompilerBackendAbiLayoutMissingRequiredFinding() != "" &&
        CompilerBackendAbiLayoutForbiddenHitFinding() != "" &&
        CompilerBackendAbiLayoutRequiredCountField() != "" &&
        CompilerBackendAbiLayoutForbiddenCountField() != "" &&
        CompilerBackendAbiLayoutMissingRequiredCountField() != "" &&
        CompilerBackendAbiLayoutForbiddenHitsCountField() != "" &&
        CompilerBackendAbiLayoutOwnerNotReadyMessage() != "" &&
        CompilerBackendAbiLayoutRequiredPathAt(0) == "src/compiler/mir_abi_layout.c" &&
        CompilerBackendAbiLayoutRequiredPathAt(4) == "src/compiler/mir_abi_resource_runtime.c" &&
        CompilerBackendAbiLayoutRequiredPathAt(5) == "src/compiler/mir_abi_layout.h" &&
        CompilerBackendAbiLayoutRequiredPathAt(6) == "src/codegen/transpiler_mir_resource_op_core.c" &&
        CompilerBackendAbiLayoutRequiredPathAt(7) == "src/compiler/mir_abi_resource_runtime.c" &&
        CompilerBackendAbiLayoutForbiddenPathAt(0) == "src/compiler/mir_abi_resource_runtime.c" &&
        CompilerBackendAbiLayoutRequiredTermAt(0) == "ABI_TYPE(\"Array<Long>\"" &&
        CompilerBackendAbiLayoutRequiredTermAt(1) == "ABI_TAGGED_TYPE(\"Option<Int>\"" &&
        CompilerBackendAbiLayoutRequiredTermAt(6) == "mir_abi_resource_runtime_fn(effective_layout, op_name)" &&
        CompilerBackendAbiLayoutRequiredTermAt(9) == "const MIRAbiTargetPolicy *mir_abi_target_policy" &&
        CompilerBackendAbiLayoutRequiredTermAt(11) == "\"layout_shape,materialization_reason\"" &&
        CompilerBackendAbiLayoutForbiddenTermAt(0) == "Slot<Int>_rel" &&
        CompilerBackendAbiLayoutForbiddenTermAt(3) == "mir_extract_inner_type_suffix_owned";
}
