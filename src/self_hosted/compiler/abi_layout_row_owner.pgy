        CompilerAbiLayoutRowTypeNameAt(15) == CompilerAbiLayoutOptionDoubleTypeName() &&
        CompilerAbiLayoutRowCValueTypeAt(15) == CompilerAbiLayoutOptionDoubleCValueType() &&
        CompilerAbiLayoutVoidTypeName() != "" &&
        CompilerAbiLayoutVoidCValueType() != "" &&
        CompilerAbiLayoutPayloadFreeEnumCValueType() == CompilerAbiLayoutIntCValueType() &&
        CompilerAbiLayoutRowDefaultReturnValueAt(0) == CompilerAbiLayoutDefaultReturnZero() &&
        CompilerAbiLayoutRowDefaultReturnValueAt(2) == CompilerAbiLayoutDefaultReturnFloatZero() &&
        CompilerAbiLayoutRowDefaultReturnValueAt(3) == CompilerAbiLayoutDefaultReturnEmptyString() &&
        CompilerAbiLayoutRowDefaultReturnValueAt(4) == CompilerAbiLayoutDefaultReturnUnsupported() &&
        CompilerAbiLayoutRowDefaultReturnValueAt(10) == CompilerAbiLayoutDefaultReturnZero() &&
