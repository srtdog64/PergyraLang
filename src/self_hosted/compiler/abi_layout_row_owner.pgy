func CompilerAbiLayoutFieldOrderScalarValue() -> String {
    return "value";
}
func CompilerAbiLayoutFieldOrderArrayBuffer() -> String {
    return "data,len,cap";
}
func CompilerAbiLayoutFieldOrderResultInt() -> String {
    return "is_ok,value";
}
func CompilerAbiLayoutFieldOrderOptionValue() -> String {
    return "is_some,value";
}
func CompilerAbiLayoutRowFieldOrderAt(index: Int) -> String {
    if index >= 0 && index <= 3 { return CompilerAbiLayoutFieldOrderScalarValue(); }
    if index >= 4 && index <= 6 { return CompilerAbiLayoutFieldOrderArrayBuffer(); }
    if index == 7 { return CompilerAbiLayoutFieldOrderResultInt(); }
    if index == 8 || index == 9 { return CompilerAbiLayoutFieldOrderOptionValue(); }
    return "";
}

func CompilerAbiLayoutTagKindNone() -> String {
    return "none";
}
func CompilerAbiLayoutTagKindBoolResult() -> String {
    return "bool_result";
}
func CompilerAbiLayoutTagKindBoolPresence() -> String {
    return "bool_presence";
}
func CompilerAbiLayoutRowTagKindAt(index: Int) -> String {
    if index >= 0 && index <= 6 { return CompilerAbiLayoutTagKindNone(); }
    if index == 7 { return CompilerAbiLayoutTagKindBoolResult(); }
    if index == 8 || index == 9 { return CompilerAbiLayoutTagKindBoolPresence(); }
    return "";
}

func CompilerAbiLayoutNicheNone() -> String {
    return "none";
}
func CompilerAbiLayoutRowNicheAt(index: Int) -> String {
    if index >= 0 && index < CompilerAbiLayoutConcreteRowCount() {
        return CompilerAbiLayoutNicheNone();
    }
    return "";
}

func CompilerAbiLayoutOwnershipPlainValue() -> String {
    return "plain_value";
}
func CompilerAbiLayoutOwnershipBorrowedStringView() -> String {
    return "borrowed_string_view";
}
func CompilerAbiLayoutOwnershipSharedBufferValue() -> String {
    return "shared_buffer_value";
}
func CompilerAbiLayoutOwnershipTaggedValue() -> String {
    return "tagged_value";
}
func CompilerAbiLayoutRowOwnershipShapeAt(index: Int) -> String {
    if index >= 0 && index <= 2 { return CompilerAbiLayoutOwnershipPlainValue(); }
    if index == 3 { return CompilerAbiLayoutOwnershipBorrowedStringView(); }
    if index >= 4 && index <= 6 { return CompilerAbiLayoutOwnershipSharedBufferValue(); }
    if index >= 7 && index <= 9 { return CompilerAbiLayoutOwnershipTaggedValue(); }
    return "";
}

func CompilerAbiLayoutSelfHostedCAbi() -> String {
    return "selfhost-c";
}
func CompilerAbiLayoutRowTargetAbiAt(index: Int) -> String {
    if index >= 0 && index < CompilerAbiLayoutConcreteRowCount() {
        return CompilerAbiLayoutSelfHostedCAbi();
    }
    return "";
}

func CompilerAbiLayoutTargetCDefaultSizeAlign() -> String {
    return "target-c-default";
}
func CompilerAbiLayoutRowSizeAlignAt(index: Int) -> String {
    if index >= 0 && index < CompilerAbiLayoutConcreteRowCount() {
        return CompilerAbiLayoutTargetCDefaultSizeAlign();
    }
    return "";
}

func CompilerAbiLayoutFieldAllowedMaterialization() -> String {
    return "field_allowed";
}

func CompilerAbiLayoutRuntimeValueOnlyMaterialization() -> String {
    return "runtime_value_only";
}

func CompilerAbiLayoutRowMaterializationAt(index: Int) -> String {
    if index >= 0 && index <= 6 { return CompilerAbiLayoutFieldAllowedMaterialization(); }
    if index >= 7 && index <= 9 { return CompilerAbiLayoutRuntimeValueOnlyMaterialization(); }
    return "";
}

func CompilerAbiLayoutRowMatches(index: Int, type_name: String) -> Bool {
    let canonical: String = CompilerAbiLayoutRowTypeNameAt(index);
    if type_name == canonical {
        return true;
    }
    if canonical == CompilerAbiLayoutArrayIntTypeName() &&
        type_name == CompilerAbiLayoutArrayIntExplicitTypeName() {
        return true;
    }
    if canonical == CompilerAbiLayoutArrayStringTypeName() &&
        type_name == CompilerAbiLayoutArrayStringExplicitTypeName() {
        return true;
    }
    if canonical == CompilerAbiLayoutArrayCodegenAstTextNodeTypeName() &&
        type_name == CompilerAbiLayoutArrayCodegenAstTextNodeExplicitTypeName() {
        return true;
    }
    if canonical == CompilerAbiLayoutResultIntTypeName() &&
        type_name == CompilerAbiLayoutResultIntExplicitTypeName() {
        return true;
    }
    if canonical == CompilerAbiLayoutOptionIntTypeName() &&
        type_name == CompilerAbiLayoutOptionIntExplicitTypeName() {
        return true;
    }
    if canonical == CompilerAbiLayoutOptionStringTypeName() &&
        type_name == CompilerAbiLayoutOptionStringExplicitTypeName() {
        return true;
    }
    return false;
}

func CompilerAbiLayoutRowIndex(type_name: String) -> Option<Int> {
    let i: Int = 0;
    while i < CompilerAbiLayoutConcreteRowCount() {
        if CompilerAbiLayoutRowMatches(i, type_name) {
            return Some(i);
        }
        i = i + 1;
    }
    return None;
}

func CompilerAbiLayoutFieldAllowed(type_name: String) -> Bool {
    let row: Option<Int> = CompilerAbiLayoutRowIndex(type_name);
    if !IsSome(row) {
        return false;
    }
    return CompilerAbiLayoutRowMaterializationAt(UnwrapOption(row)) ==
        CompilerAbiLayoutFieldAllowedMaterialization();
}
