// Self-host compiler cross-backend ABI/layout row owner.
//
// Owns the row vocabulary every projection must consume before emission.

func CompilerAbiLayoutRowSchema() -> String {
    return "pgy.selfhost.abi-layout-row.v1";
}
func CompilerAbiLayoutRowFactCount() -> Int {
    return 8;
}
func CompilerAbiLayoutDeclNameFact() -> String {
    return "decl_name";
}
func CompilerAbiLayoutFieldOrderFact() -> String {
    return "field_order";
}
func CompilerAbiLayoutTagKindFact() -> String {
    return "tag_kind";
}
func CompilerAbiLayoutNicheFact() -> String {
    return "niche";
}
func CompilerAbiLayoutOwnershipShapeFact() -> String {
    return "ownership_shape";
}
func CompilerAbiLayoutTargetAbiFact() -> String {
    return "target_abi";
}
func CompilerAbiLayoutSizeAlignFact() -> String {
    return "size_align";
}
func CompilerAbiLayoutMaterializationPolicyFact() -> String {
    return "materialization_policy";
}
func CompilerAbiLayoutRowFactAt(index: Int) -> String {
    if index == 0 { return CompilerAbiLayoutDeclNameFact(); }
    if index == 1 { return CompilerAbiLayoutFieldOrderFact(); }
    if index == 2 { return CompilerAbiLayoutTagKindFact(); }
    if index == 3 { return CompilerAbiLayoutNicheFact(); }
    if index == 4 { return CompilerAbiLayoutOwnershipShapeFact(); }
    if index == 5 { return CompilerAbiLayoutTargetAbiFact(); }
    if index == 6 { return CompilerAbiLayoutSizeAlignFact(); }
    if index == 7 { return CompilerAbiLayoutMaterializationPolicyFact(); }
    return "";
}
func CompilerAbiLayoutRowsReady() -> Bool {
    return CompilerAbiLayoutRowFactCount() == 8 &&
        CompilerAbiLayoutRowFactAt(0) == CompilerAbiLayoutDeclNameFact() &&
        CompilerAbiLayoutRowFactAt(1) == CompilerAbiLayoutFieldOrderFact() &&
        CompilerAbiLayoutRowFactAt(2) == CompilerAbiLayoutTagKindFact() &&
        CompilerAbiLayoutRowFactAt(3) == CompilerAbiLayoutNicheFact() &&
        CompilerAbiLayoutRowFactAt(4) == CompilerAbiLayoutOwnershipShapeFact() &&
        CompilerAbiLayoutRowFactAt(5) == CompilerAbiLayoutTargetAbiFact() &&
        CompilerAbiLayoutRowFactAt(6) == CompilerAbiLayoutSizeAlignFact() &&
        CompilerAbiLayoutRowFactAt(7) == CompilerAbiLayoutMaterializationPolicyFact() &&
        CompilerAbiLayoutConcreteRowCount() == 10 &&
        CompilerAbiLayoutRowTypeNameAt(0) == CompilerAbiLayoutIntTypeName() &&
        CompilerAbiLayoutRowCValueTypeAt(0) == CompilerAbiLayoutIntCValueType() &&
        CompilerAbiLayoutRowFieldOrderAt(4) == CompilerAbiLayoutFieldOrderArrayBuffer() &&
        CompilerAbiLayoutRowTagKindAt(8) == CompilerAbiLayoutTagKindBoolPresence() &&
        CompilerAbiLayoutRowNicheAt(8) == CompilerAbiLayoutNicheNone() &&
        CompilerAbiLayoutRowOwnershipShapeAt(5) == CompilerAbiLayoutOwnershipSharedBufferValue() &&
        CompilerAbiLayoutRowTargetAbiAt(0) == CompilerAbiLayoutSelfHostedCAbi() &&
        CompilerAbiLayoutRowSizeAlignAt(0) == CompilerAbiLayoutTargetCDefaultSizeAlign() &&
        CompilerAbiLayoutRowMaterializationAt(0) == CompilerAbiLayoutFieldAllowedMaterialization() &&
        CompilerAbiLayoutRowTypeNameAt(9) == CompilerAbiLayoutOptionStringTypeName() &&
        CompilerAbiLayoutRowCValueTypeAt(9) == CompilerAbiLayoutOptionStringCValueType() &&
        CompilerAbiLayoutRowMaterializationAt(9) == CompilerAbiLayoutRuntimeValueOnlyMaterialization();
}
func CompilerAbiLayoutConcreteRowCount() -> Int {
    return 10;
}
