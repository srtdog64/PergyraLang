func CompilerAbiLayoutRowDefaultReturnValueAt(index: Int) -> String {
    if index == 0 || index == 1 || index == 10 {
        return CompilerAbiLayoutDefaultReturnZero();
    }
    if index == 2 || index == 11 {
        return CompilerAbiLayoutDefaultReturnFloatZero();
    }
    if index == 3 {
        return CompilerAbiLayoutDefaultReturnEmptyString();
    }
    if index >= 4 && index < CompilerAbiLayoutConcreteRowCount() {
        return CompilerAbiLayoutDefaultReturnUnsupported();
    }
    return "";
}

func CompilerAbiLayoutRowMatches(index: Int, type_name: String) -> Bool {
    let canonical: String = CompilerAbiLayoutRowTypeNameAt(index);
    if type_name == canonical {
        return true;
    }
    if canonical == CompilerAbiLayoutArrayIntTypeName() &&
        type_name == CompilerAbiLayoutArrayIntExplicitTypeName() {
        return true;
    }
    if canonical == CompilerAbiLayoutArrayLongTypeName() &&
        type_name == CompilerAbiLayoutArrayLongExplicitTypeName() {
        return true;
    }
    if canonical == CompilerAbiLayoutArrayStringTypeName() &&
        type_name == CompilerAbiLayoutArrayStringExplicitTypeName() {
        return true;
    }
    if canonical == CompilerAbiLayoutArrayCodegenAstTextNodeTypeName() &&
        type_name == CompilerAbiLayoutArrayCodegenAstTextNodeExplicitTypeName() {
        return true;
    }
    if canonical == CompilerAbiLayoutArrayBoolTypeName() &&
        type_name == CompilerAbiLayoutArrayBoolExplicitTypeName() {
        return true;
    }
    if canonical == CompilerAbiLayoutResultIntTypeName() &&
        type_name == CompilerAbiLayoutResultIntExplicitTypeName() {
        return true;
    }
    if canonical == CompilerAbiLayoutOptionIntTypeName() &&
        type_name == CompilerAbiLayoutOptionIntExplicitTypeName() {
        return true;
    }
    if canonical == CompilerAbiLayoutOptionLongTypeName() &&
        type_name == CompilerAbiLayoutOptionLongExplicitTypeName() {
        return true;
    }
    if canonical == CompilerAbiLayoutOptionFloatTypeName() &&
        type_name == CompilerAbiLayoutOptionFloatExplicitTypeName() {
        return true;
    }
    if canonical == CompilerAbiLayoutOptionDoubleTypeName() &&
        type_name == CompilerAbiLayoutOptionDoubleExplicitTypeName() {
        return true;
    }
    if canonical == CompilerAbiLayoutOptionStringTypeName() &&
        type_name == CompilerAbiLayoutOptionStringExplicitTypeName() {
        return true;
    }
    if canonical == CompilerAbiLayoutOptionBoolTypeName() &&
        type_name == CompilerAbiLayoutOptionBoolExplicitTypeName() {
        return true;
    }
    if canonical == CompilerAbiLayoutSetStringTypeName() &&
        type_name == CompilerAbiLayoutSetStringExplicitTypeName() {
        return true;
    }
    return false;
}

func CompilerAbiLayoutRowIndex(type_name: String) -> Option<Int> {
    let i: Int = 0;
    while i < CompilerAbiLayoutConcreteRowCount() {
        if CompilerAbiLayoutRowMatches(i, type_name) {
            return Some(i);
        }
        i = i + 1;
    }
    return None;
}

func CompilerAbiLayoutRowCValueTypeFor(type_name: String) -> String {
    let row: Option<Int> = CompilerAbiLayoutRowIndex(type_name);
    if !IsSome(row) { return ""; }
    return CompilerAbiLayoutRowCValueTypeAt(UnwrapOption(row));
}
func CompilerAbiLayoutRowFieldOrderFor(type_name: String) -> String {
    let row: Option<Int> = CompilerAbiLayoutRowIndex(type_name);
    if !IsSome(row) { return ""; }
    return CompilerAbiLayoutRowFieldOrderAt(UnwrapOption(row));
}
func CompilerAbiLayoutRowMaterializationFor(type_name: String) -> String {
    let row: Option<Int> = CompilerAbiLayoutRowIndex(type_name);
    if !IsSome(row) { return ""; }
    return CompilerAbiLayoutRowMaterializationAt(UnwrapOption(row));
}
func CompilerAbiLayoutRowDefaultReturnValueFor(type_name: String) -> String {
    let row: Option<Int> = CompilerAbiLayoutRowIndex(type_name);
    if !IsSome(row) { return ""; }
    return CompilerAbiLayoutRowDefaultReturnValueAt(UnwrapOption(row));
}

func CompilerAbiLayoutFieldAllowed(type_name: String) -> Bool {
    let row: Option<Int> = CompilerAbiLayoutRowIndex(type_name);
    if !IsSome(row) {
        return false;
    }
    return CompilerAbiLayoutRowMaterializationAt(UnwrapOption(row)) ==
        CompilerAbiLayoutFieldAllowedMaterialization();
}
