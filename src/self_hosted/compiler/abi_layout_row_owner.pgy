func CompilerAbiLayoutSetStringRowReady() -> Bool {
    return CompilerAbiLayoutRowCValueTypeFor(
            CompilerAbiLayoutSetStringTypeName()) ==
            CompilerAbiLayoutSetStringCValueType() &&
        CompilerAbiLayoutRowFieldOrderFor(CompilerAbiLayoutSetStringTypeName()) ==
            CompilerAbiLayoutFieldOrderSetBuffer() &&
        CompilerAbiLayoutRowOwnershipShapeAt(20) ==
            CompilerAbiLayoutOwnershipSharedBufferValue() &&
        CompilerAbiLayoutRowMaterializationFor(CompilerAbiLayoutSetStringTypeName()) ==
            CompilerAbiLayoutRuntimeValueOnlyMaterialization();
}
func CompilerAbiLayoutRowsReady() -> Bool {
    return CompilerAbiLayoutRowFactCount() > 0 &&
        CompilerTargetCapabilityEnvelopeReady() &&
        CompilerAbiLayoutRowFactAt(0) == CompilerAbiLayoutDeclNameFact() &&
        CompilerAbiLayoutRowFactAt(CompilerAbiLayoutRowFactCount() - 1) == CompilerAbiLayoutDefaultReturnValueFact() &&
        CompilerAbiLayoutConcreteRowCount() > 0 &&
        CompilerAbiLayoutRowTypeNameAt(CompilerAbiLayoutConcreteRowCount()) == "" &&
        CompilerAbiLayoutRowCValueTypeFor(CompilerAbiLayoutIntTypeName()) == CompilerAbiLayoutIntCValueType() &&
        CompilerAbiLayoutRowFieldOrderFor(CompilerAbiLayoutArrayIntTypeName()) == CompilerAbiLayoutFieldOrderArrayBuffer() &&
        CompilerAbiLayoutRowTagKindAt(8) == CompilerAbiLayoutTagKindBoolPresence() &&
        CompilerAbiLayoutRowNicheAt(8) == CompilerAbiLayoutNicheNone() &&
        CompilerAbiLayoutRowOwnershipShapeAt(5) == CompilerAbiLayoutOwnershipSharedBufferValue() &&
        CompilerAbiLayoutRowTargetAbiAt(0) == CompilerAbiLayoutSelfHostedCAbi() &&
        CompilerAbiLayoutRowSizeAlignAt(0) == CompilerAbiLayoutTargetCDefaultSizeAlign() &&
        CompilerAbiLayoutRowMaterializationFor(CompilerAbiLayoutIntTypeName()) == CompilerAbiLayoutFieldAllowedMaterialization() &&
        CompilerAbiLayoutRowMaterializationFor(CompilerAbiLayoutOptionIntTypeName()) == CompilerAbiLayoutFieldAllowedMaterialization() &&
        CompilerAbiLayoutRowCValueTypeFor(CompilerAbiLayoutOptionStringTypeName()) == CompilerAbiLayoutOptionStringCValueType() &&
        CompilerAbiLayoutRowCValueTypeFor(CompilerAbiLayoutLongTypeName()) == CompilerAbiLayoutLongCValueType() &&
        CompilerAbiLayoutRowCValueTypeFor(CompilerAbiLayoutDoubleTypeName()) == CompilerAbiLayoutDoubleCValueType() &&
        CompilerAbiLayoutRowCValueTypeFor(CompilerAbiLayoutArrayLongTypeName()) == CompilerAbiLayoutArrayLongCValueType() &&
        CompilerAbiLayoutRowCValueTypeFor(CompilerAbiLayoutArrayBoolTypeName()) == CompilerAbiLayoutArrayBoolCValueType() &&
        CompilerAbiLayoutRowCValueTypeFor(CompilerAbiLayoutOptionBoolTypeName()) == CompilerAbiLayoutOptionBoolCValueType() &&
        CompilerAbiLayoutRowCValueTypeFor(CompilerAbiLayoutOptionLongTypeName()) == CompilerAbiLayoutOptionLongCValueType() &&
        CompilerAbiLayoutRowCValueTypeFor(CompilerAbiLayoutOptionFloatTypeName()) == CompilerAbiLayoutOptionFloatCValueType() &&
        CompilerAbiLayoutRowCValueTypeFor(CompilerAbiLayoutOptionDoubleTypeName()) == CompilerAbiLayoutOptionDoubleCValueType() &&
        CompilerAbiLayoutRowCValueTypeFor(CompilerAbiLayoutAllocatorTypeName()) == CompilerAbiLayoutAllocatorCValueType() &&
        CompilerAbiLayoutRowCValueTypeFor(CompilerAbiLayoutTextBuilderTypeName()) == CompilerAbiLayoutTextBuilderCValueType() &&
        CompilerAbiLayoutSetStringRowReady() &&
        CompilerAbiLayoutVoidTypeName() != "" &&
        CompilerAbiLayoutVoidCValueType() != "" &&
        CompilerAbiLayoutPayloadFreeEnumCValueType() == CompilerAbiLayoutIntCValueType() &&
        CompilerAbiLayoutRowDefaultReturnValueFor(CompilerAbiLayoutIntTypeName()) == CompilerAbiLayoutDefaultReturnZero() &&
        CompilerAbiLayoutRowDefaultReturnValueFor(CompilerAbiLayoutFloatTypeName()) == CompilerAbiLayoutDefaultReturnFloatZero() &&
        CompilerAbiLayoutRowDefaultReturnValueFor(CompilerAbiLayoutStringTypeName()) == CompilerAbiLayoutDefaultReturnEmptyString() &&
        CompilerAbiLayoutRowDefaultReturnValueFor(CompilerAbiLayoutArrayIntTypeName()) == CompilerAbiLayoutDefaultReturnUnsupported() &&
        CompilerAbiLayoutRowDefaultReturnValueFor(CompilerAbiLayoutLongTypeName()) == CompilerAbiLayoutDefaultReturnZero() &&
        CompilerAbiLayoutRowMaterializationFor(CompilerAbiLayoutOptionStringTypeName()) == CompilerAbiLayoutRuntimeValueOnlyMaterialization() &&
        CompilerAbiLayoutTargetPolicyReady();
}
