// Self-host compiler ABI target-policy owner.
//
// Keeps target projection and fallback facts out of the concrete ABI row table.
// The structured row is semantic authority; CSV getters exist only for the
// manifest boundary.

import "target_capability_owner.pgy";

struct CompilerAbiLayoutTargetPolicyRow {
    valid: Bool;
    abi_name: String;
    primary_projection: String;
    secondary_projection: String;
    primary_required_fact: String;
    secondary_required_fact: String;
    primary_fallback: String;
    secondary_fallback: String;
}

func CompilerAbiLayoutSelfHostedCAbi() -> String {
    return "selfhost-c";
}

func CompilerAbiLayoutTargetPolicyCount() -> Int {
    return 1;
}

func CompilerAbiLayoutTargetPolicyRowAt(
    index: Int
) -> CompilerAbiLayoutTargetPolicyRow {
    if index == 0 {
        return CompilerAbiLayoutTargetPolicyRow(
            true, CompilerAbiLayoutSelfHostedCAbi(),
            CompilerTargetCpuCProjection(),
            CompilerTargetSelfHostedProjection(),
            CompilerTargetLayoutShapeFact(),
            CompilerTargetMaterializationReasonFact(),
            CompilerTargetUnsupportedShapeFallbackReason(),
            CompilerTargetForbiddenLossBudgetFallbackReason()
        );
    }
    return CompilerAbiLayoutTargetPolicyRow(
        false, "", "", "", "", "", "", ""
    );
}

func CompilerAbiLayoutTargetPolicyAbiAt(index: Int) -> String {
    let row: CompilerAbiLayoutTargetPolicyRow =
        CompilerAbiLayoutTargetPolicyRowAt(index);
    if !row.valid { return ""; }
    return row.abi_name;
}

func CompilerAbiLayoutTargetPolicyProjectionSetAt(index: Int) -> String {
    let row: CompilerAbiLayoutTargetPolicyRow =
        CompilerAbiLayoutTargetPolicyRowAt(index);
    if !row.valid { return ""; }
    return Concat(Concat(row.primary_projection, ","), row.secondary_projection);
}

func CompilerAbiLayoutTargetPolicyRequiredFactsAt(index: Int) -> String {
    let row: CompilerAbiLayoutTargetPolicyRow =
        CompilerAbiLayoutTargetPolicyRowAt(index);
    if !row.valid { return ""; }
    return Concat(
        Concat(row.primary_required_fact, ","), row.secondary_required_fact
    );
}

func CompilerAbiLayoutTargetPolicyFallbacksAt(index: Int) -> String {
    let row: CompilerAbiLayoutTargetPolicyRow =
        CompilerAbiLayoutTargetPolicyRowAt(index);
    if !row.valid { return ""; }
    return Concat(Concat(row.primary_fallback, ","), row.secondary_fallback);
}

func CompilerAbiLayoutTargetPolicyKnown(abi_name: String) -> Bool {
    let i: Int = 0;
    while i < CompilerAbiLayoutTargetPolicyCount() {
        let row: CompilerAbiLayoutTargetPolicyRow =
            CompilerAbiLayoutTargetPolicyRowAt(i);
        if row.valid && row.abi_name == abi_name { return true; }
        i = i + 1;
    }
    return false;
}

func CompilerAbiLayoutTargetPolicyRowKnown(
    abi_name: String,
    projection_set: String,
    required_facts: String,
    fallbacks: String
) -> Bool {
    let i: Int = 0;
    while i < CompilerAbiLayoutTargetPolicyCount() {
        if CompilerAbiLayoutTargetPolicyAbiAt(i) == abi_name &&
            CompilerAbiLayoutTargetPolicyProjectionSetAt(i) == projection_set &&
            CompilerAbiLayoutTargetPolicyRequiredFactsAt(i) == required_facts &&
            CompilerAbiLayoutTargetPolicyFallbacksAt(i) == fallbacks {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func CompilerAbiLayoutTargetPolicyRowsReady() -> Bool {
    let i: Int = 0;
    while i < CompilerAbiLayoutTargetPolicyCount() {
        let row: CompilerAbiLayoutTargetPolicyRow =
            CompilerAbiLayoutTargetPolicyRowAt(i);
        if !row.valid || row.abi_name == "" ||
            !CompilerTargetProjectionKnown(row.primary_projection) ||
            !CompilerTargetProjectionKnown(row.secondary_projection) ||
            !CompilerTargetFactKnown(row.primary_required_fact) ||
            !CompilerTargetFactKnown(row.secondary_required_fact) ||
            !CompilerTargetFallbackReasonKnown(row.primary_fallback) ||
            !CompilerTargetFallbackReasonKnown(row.secondary_fallback) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func CompilerAbiLayoutTargetPolicyReady() -> Bool {
    return CompilerAbiLayoutTargetPolicyCount() > 0 &&
        !CompilerAbiLayoutTargetPolicyRowAt(-1).valid &&
        !CompilerAbiLayoutTargetPolicyRowAt(
            CompilerAbiLayoutTargetPolicyCount()
        ).valid &&
        CompilerAbiLayoutTargetPolicyAbiAt(CompilerAbiLayoutTargetPolicyCount()) == "" &&
        CompilerAbiLayoutTargetPolicyProjectionSetAt(CompilerAbiLayoutTargetPolicyCount()) == "" &&
        CompilerAbiLayoutTargetPolicyRequiredFactsAt(CompilerAbiLayoutTargetPolicyCount()) == "" &&
        CompilerAbiLayoutTargetPolicyFallbacksAt(CompilerAbiLayoutTargetPolicyCount()) == "" &&
        CompilerAbiLayoutTargetPolicyKnown(CompilerAbiLayoutSelfHostedCAbi()) &&
        CompilerAbiLayoutTargetPolicyRowsReady();
}
