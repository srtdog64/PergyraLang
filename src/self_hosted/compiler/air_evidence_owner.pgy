// Self-host compiler AIR evidence owner.
//
// Owns the hard-rung evidence vocabulary that ties intent, effect, authority,
// coordination, slot ownership, materialization, and loss budget together.

func CompilerAirEvidenceSchema() -> String {
    return "pgy.selfhost.air-evidence.v1";
}

func CompilerAirEvidenceFactCount() -> Int {
    return 7;
}

func CompilerAirEvidenceIntentGraphFact() -> String {
    return "intent_graph";
}

func CompilerAirEvidenceEffectSetFact() -> String {
    return "effect_set";
}

func CompilerAirEvidenceAuthorityEvidenceFact() -> String {
    return "authority_evidence";
}

func CompilerAirEvidenceCoordinationFact() -> String {
    return "coordination";
}

func CompilerAirEvidenceSlotOwnershipFact() -> String {
    return "slot_ownership";
}

func CompilerAirEvidenceMaterializationReasonFact() -> String {
    return "materialization_reason";
}

func CompilerAirEvidenceLossBudgetFact() -> String {
    return "loss_budget";
}

func CompilerAirEvidenceFactAt(index: Int) -> String {
    if index == 0 { return CompilerAirEvidenceIntentGraphFact(); }
    if index == 1 { return CompilerAirEvidenceEffectSetFact(); }
    if index == 2 { return CompilerAirEvidenceAuthorityEvidenceFact(); }
    if index == 3 { return CompilerAirEvidenceCoordinationFact(); }
    if index == 4 { return CompilerAirEvidenceSlotOwnershipFact(); }
    if index == 5 { return CompilerAirEvidenceMaterializationReasonFact(); }
    if index == 6 { return CompilerAirEvidenceLossBudgetFact(); }
    return "";
}

func CompilerAirEvidenceFactKnown(fact: String) -> Bool {
    let i: Int = 0;
    while i < CompilerAirEvidenceFactCount() {
        if CompilerAirEvidenceFactAt(i) == fact {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func CompilerAirEvidenceEnvelopeReady() -> Bool {
    return CompilerAirEvidenceFactCount() > 0 &&
        CompilerAirEvidenceFactAt(CompilerAirEvidenceFactCount()) == "" &&
        CompilerAirEvidenceFactKnown(CompilerAirEvidenceIntentGraphFact()) &&
        CompilerAirEvidenceFactKnown(CompilerAirEvidenceEffectSetFact()) &&
        CompilerAirEvidenceFactKnown(CompilerAirEvidenceAuthorityEvidenceFact()) &&
        CompilerAirEvidenceFactKnown(CompilerAirEvidenceCoordinationFact()) &&
        CompilerAirEvidenceFactKnown(CompilerAirEvidenceSlotOwnershipFact()) &&
        CompilerAirEvidenceFactKnown(CompilerAirEvidenceMaterializationReasonFact()) &&
        CompilerAirEvidenceFactKnown(CompilerAirEvidenceLossBudgetFact());
}
