// Self-host compiler AIR evidence owner.
//
// Owns the hard-rung evidence vocabulary that ties intent, effect, authority,
// coordination, slot ownership, materialization, and loss budget together.

func CompilerAirEvidenceSchema() -> String {
    return "pgy.selfhost.air-evidence.v1";
}

func CompilerAirEvidenceFactCount() -> Int {
    return 7;
}

func CompilerAirEvidenceFactAt(index: Int) -> String {
    if index == 0 { return "intent_graph"; }
    if index == 1 { return "effect_set"; }
    if index == 2 { return "authority_evidence"; }
    if index == 3 { return "coordination"; }
    if index == 4 { return "slot_ownership"; }
    if index == 5 { return "materialization_reason"; }
    if index == 6 { return "loss_budget"; }
    return "";
}

func CompilerAirEvidenceEnvelopeReady() -> Bool {
    return CompilerAirEvidenceFactCount() == 7 &&
        CompilerAirEvidenceFactAt(0) == "intent_graph" &&
        CompilerAirEvidenceFactAt(1) == "effect_set" &&
        CompilerAirEvidenceFactAt(2) == "authority_evidence" &&
        CompilerAirEvidenceFactAt(3) == "coordination" &&
        CompilerAirEvidenceFactAt(4) == "slot_ownership" &&
        CompilerAirEvidenceFactAt(5) == "materialization_reason" &&
        CompilerAirEvidenceFactAt(6) == "loss_budget";
}
