// Self-host compiler artifact-zone owner.
//
// Owns the comparable artifact kinds for C, LLVM, and self-hosted proof.

func CompilerArtifactSchema() -> String {
    return "pgy.selfhost.artifact-zone.v1";
}

func CompilerArtifactKindCount() -> Int {
    return 9;
}

func CompilerArtifactKindAt(index: Int) -> String {
    if index == 0 { return "diagnostics"; }
    if index == 1 { return "air_json"; }
    if index == 2 { return "mir_json"; }
    if index == 3 { return "abi_layout"; }
    if index == 4 { return "runtime_materialization"; }
    if index == 5 { return "emitted_c"; }
    if index == 6 { return "emitted_llvm"; }
    if index == 7 { return "emitted_self_hosted"; }
    if index == 8 { return "run_output"; }
    return "";
}

func CompilerArtifactKindKnown(kind: String) -> Bool {
    let i: Int = 0;
    while i < CompilerArtifactKindCount() {
        if CompilerArtifactKindAt(i) == kind {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func CompilerRunOutputArtifactKind() -> String {
    return "run_output";
}

func CompilerArtifactZoneReady() -> Bool {
    return CompilerArtifactKindCount() == 9 &&
        CompilerArtifactKindAt(0) == "diagnostics" &&
        CompilerArtifactKindAt(1) == "air_json" &&
        CompilerArtifactKindAt(2) == "mir_json" &&
        CompilerArtifactKindAt(3) == "abi_layout" &&
        CompilerArtifactKindAt(4) == "runtime_materialization" &&
        CompilerArtifactKindAt(5) == "emitted_c" &&
        CompilerArtifactKindAt(6) == "emitted_llvm" &&
        CompilerArtifactKindAt(7) == "emitted_self_hosted" &&
        CompilerArtifactKindAt(8) == CompilerRunOutputArtifactKind();
}
