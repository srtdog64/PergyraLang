// Self-host compiler artifact-zone owner.
//
// Owns the comparable artifact kinds for C, LLVM, and self-hosted proof.

func CompilerArtifactSchema() -> String {
    return "pgy.selfhost.artifact-zone.v1";
}

func CompilerArtifactKindCount() -> Int {
    return 28;
}

// Native C/LLVM artifacts are valid only when they carry the planner's
// anchored identity. The digest is an identity/mutation guard, not crypto.
func CompilerArtifactPlanRevision() -> Int {
    return 1;
}

func CompilerArtifactIdentityReady(
    kind: String,
    plan_revision: Int,
    plan_digest: Int
) -> Bool {
    return CompilerArtifactKindKnown(kind) &&
        (kind == CompilerEmittedCArtifactKind() ||
         kind == CompilerEmittedLlvmArtifactKind()) &&
        plan_revision == CompilerArtifactPlanRevision() &&
        plan_digest != 0;
}

func CompilerDiagnosticsArtifactKind() -> String {
    return "diagnostics";
}

func CompilerAirJsonArtifactKind() -> String {
    return "air_json";
}

func CompilerMirJsonArtifactKind() -> String {
    return "mir_json";
}

