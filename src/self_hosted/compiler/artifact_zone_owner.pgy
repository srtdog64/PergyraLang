func CompilerSpawnLanePlanArtifactKind() -> String {
    return "spawn_lane_plan";
}

func CompilerArtifactKindAt(index: Int) -> String {
    if index == 0 { return CompilerDiagnosticsArtifactKind(); }
    if index == 1 { return CompilerAirJsonArtifactKind(); }
    if index == 2 { return CompilerMirJsonArtifactKind(); }
    if index == 3 { return CompilerAbiLayoutArtifactKind(); }
    if index == 4 { return CompilerRuntimeCallAbiArtifactKind(); }
    if index == 5 { return CompilerCompatibilityEvolutionArtifactKind(); }
    if index == 6 { return CompilerRuntimeMaterializationArtifactKind(); }
    if index == 7 { return CompilerEmittedCArtifactKind(); }
    if index == 8 { return CompilerEmittedLlvmArtifactKind(); }
    if index == 9 { return CompilerEmittedSelfHostedArtifactKind(); }
    if index == 10 { return CompilerRunOutputArtifactKind(); }
    if index == 11 { return CompilerAstTextArtifactKind(); }
    if index == 12 { return CompilerLspDiagnosticsArtifactKind(); }
    if index == 13 { return CompilerLspTransportFrameArtifactKind(); }
    if index == 14 { return CompilerLspTransportStreamArtifactKind(); }
    if index == 15 { return CompilerLspRequestDispatchArtifactKind(); }
    if index == 16 { return CompilerLspResponseEmissionArtifactKind(); }
    if index == 17 { return CompilerLspSessionReplayArtifactKind(); }
    if index == 18 { return CompilerLspDocumentStoreArtifactKind(); }
    if index == 19 { return CompilerLspSessionStateArtifactKind(); }
    if index == 20 { return CompilerLspHoverContentArtifactKind(); }
    if index == 21 { return CompilerTargetCapabilityArtifactKind(); }
    if index == 22 { return CompilerSandboxCapabilityArtifactKind(); }
    if index == 23 { return CompilerRunGroupPlanArtifactKind(); }
    if index == 24 { return CompilerParallelChunkPolicyArtifactKind(); }
    if index == 25 { return CompilerParallelLanePolicyArtifactKind(); }
    if index == 26 { return CompilerReachabilityContractArtifactKind(); }
    if index == 27 { return CompilerSpawnLanePlanArtifactKind(); }
    return "";
}

func CompilerArtifactKindKnown(kind: String) -> Bool {
    let i: Int = 0;
    while i < CompilerArtifactKindCount() {
        if CompilerArtifactKindAt(i) == kind {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func CompilerArtifactZoneReady() -> Bool {
    return CompilerArtifactKindCount() > 0 &&
        CompilerArtifactKindAt(CompilerArtifactKindCount()) == "" &&
        CompilerArtifactKindKnown(CompilerDiagnosticsArtifactKind()) &&
        CompilerArtifactKindKnown(CompilerAirJsonArtifactKind()) &&
        CompilerArtifactKindKnown(CompilerMirJsonArtifactKind()) &&
        CompilerArtifactKindKnown(CompilerAbiLayoutArtifactKind()) &&
        CompilerArtifactKindKnown(CompilerRuntimeCallAbiArtifactKind()) &&
        CompilerArtifactKindKnown(CompilerCompatibilityEvolutionArtifactKind()) &&
        CompilerArtifactKindKnown(CompilerRuntimeMaterializationArtifactKind()) &&
        CompilerArtifactKindKnown(CompilerEmittedCArtifactKind()) &&
        CompilerArtifactKindKnown(CompilerEmittedLlvmArtifactKind()) &&
        CompilerArtifactKindKnown(CompilerEmittedSelfHostedArtifactKind()) &&
        CompilerArtifactKindKnown(CompilerRunOutputArtifactKind()) &&
        CompilerArtifactKindKnown(CompilerAstTextArtifactKind()) &&
        CompilerArtifactKindKnown(CompilerLspDiagnosticsArtifactKind()) &&
        CompilerArtifactKindKnown(CompilerLspTransportFrameArtifactKind()) &&
        CompilerArtifactKindKnown(CompilerLspTransportStreamArtifactKind()) &&
        CompilerArtifactKindKnown(CompilerLspRequestDispatchArtifactKind()) &&
        CompilerArtifactKindKnown(CompilerLspResponseEmissionArtifactKind()) &&
        CompilerArtifactKindKnown(CompilerLspSessionReplayArtifactKind()) &&
        CompilerArtifactKindKnown(CompilerLspDocumentStoreArtifactKind()) &&
        CompilerArtifactKindKnown(CompilerLspSessionStateArtifactKind()) &&
        CompilerArtifactKindKnown(CompilerLspHoverContentArtifactKind()) &&
        CompilerArtifactKindKnown(CompilerTargetCapabilityArtifactKind()) &&
        CompilerArtifactKindKnown(CompilerSandboxCapabilityArtifactKind()) &&
        CompilerArtifactKindKnown(CompilerRunGroupPlanArtifactKind()) &&
        CompilerArtifactKindKnown(CompilerParallelChunkPolicyArtifactKind()) &&
        CompilerArtifactKindKnown(CompilerParallelLanePolicyArtifactKind()) &&
        CompilerArtifactKindKnown(CompilerReachabilityContractArtifactKind()) &&
        CompilerArtifactKindKnown(CompilerSpawnLanePlanArtifactKind());
}
