// Self-host compiler artifact-zone owner.
//
// Owns the comparable artifact kinds for C, LLVM, and self-hosted proof.

func CompilerArtifactSchema() -> String {
    return "pgy.selfhost.artifact-zone.v1";
}

func CompilerArtifactKindCount() -> Int {
    return 21;
}

func CompilerDiagnosticsArtifactKind() -> String {
    return "diagnostics";
}

func CompilerAirJsonArtifactKind() -> String {
    return "air_json";
}

func CompilerMirJsonArtifactKind() -> String {
    return "mir_json";
}

func CompilerAstTextArtifactKind() -> String {
    return "ast_text";
}

func CompilerAbiLayoutArtifactKind() -> String {
    return "abi_layout";
}

func CompilerRuntimeCallAbiArtifactKind() -> String {
    return "runtime_call_abi";
}

func CompilerCompatibilityEvolutionArtifactKind() -> String {
    return "compatibility_evolution";
}

func CompilerRuntimeMaterializationArtifactKind() -> String {
    return "runtime_materialization";
}

func CompilerEmittedCArtifactKind() -> String {
    return "emitted_c";
}

func CompilerEmittedLlvmArtifactKind() -> String {
    return "emitted_llvm";
}

func CompilerEmittedSelfHostedArtifactKind() -> String {
    return "emitted_self_hosted";
}

func CompilerRunOutputArtifactKind() -> String {
    return "run_output";
}

func CompilerLspDiagnosticsArtifactKind() -> String {
    return "lsp_diagnostics";
}

func CompilerLspTransportFrameArtifactKind() -> String {
    return "lsp_transport_frame";
}

func CompilerLspTransportStreamArtifactKind() -> String {
    return "lsp_transport_stream";
}

func CompilerLspRequestDispatchArtifactKind() -> String {
    return "lsp_request_dispatch";
}

func CompilerLspResponseEmissionArtifactKind() -> String {
    return "lsp_response_emission";
}

func CompilerLspSessionReplayArtifactKind() -> String {
    return "lsp_session_replay";
}

func CompilerLspDocumentStoreArtifactKind() -> String {
    return "lsp_document_store";
}

func CompilerLspSessionStateArtifactKind() -> String {
    return "lsp_session_state";
}

func CompilerLspHoverContentArtifactKind() -> String {
    return "lsp_hover_content";
}

func CompilerArtifactKindAt(index: Int) -> String {
    if index == 0 { return CompilerDiagnosticsArtifactKind(); }
    if index == 1 { return CompilerAirJsonArtifactKind(); }
    if index == 2 { return CompilerMirJsonArtifactKind(); }
    if index == 3 { return CompilerAbiLayoutArtifactKind(); }
    if index == 4 { return CompilerRuntimeCallAbiArtifactKind(); }
    if index == 5 { return CompilerCompatibilityEvolutionArtifactKind(); }
    if index == 6 { return CompilerRuntimeMaterializationArtifactKind(); }
    if index == 7 { return CompilerEmittedCArtifactKind(); }
    if index == 8 { return CompilerEmittedLlvmArtifactKind(); }
    if index == 9 { return CompilerEmittedSelfHostedArtifactKind(); }
    if index == 10 { return CompilerRunOutputArtifactKind(); }
    if index == 11 { return CompilerAstTextArtifactKind(); }
    if index == 12 { return CompilerLspDiagnosticsArtifactKind(); }
    if index == 13 { return CompilerLspTransportFrameArtifactKind(); }
    if index == 14 { return CompilerLspTransportStreamArtifactKind(); }
    if index == 15 { return CompilerLspRequestDispatchArtifactKind(); }
    if index == 16 { return CompilerLspResponseEmissionArtifactKind(); }
    if index == 17 { return CompilerLspSessionReplayArtifactKind(); }
    if index == 18 { return CompilerLspDocumentStoreArtifactKind(); }
    if index == 19 { return CompilerLspSessionStateArtifactKind(); }
    if index == 20 { return CompilerLspHoverContentArtifactKind(); }
    return "";
}

func CompilerArtifactKindKnown(kind: String) -> Bool {
    let i: Int = 0;
    while i < CompilerArtifactKindCount() {
        if CompilerArtifactKindAt(i) == kind {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func CompilerArtifactZoneReady() -> Bool {
    return CompilerArtifactKindCount() == 21 &&
        CompilerArtifactKindAt(0) == CompilerDiagnosticsArtifactKind() &&
        CompilerArtifactKindAt(1) == CompilerAirJsonArtifactKind() &&
        CompilerArtifactKindAt(2) == CompilerMirJsonArtifactKind() &&
        CompilerArtifactKindAt(3) == CompilerAbiLayoutArtifactKind() &&
        CompilerArtifactKindAt(4) == CompilerRuntimeCallAbiArtifactKind() &&
        CompilerArtifactKindAt(5) == CompilerCompatibilityEvolutionArtifactKind() &&
        CompilerArtifactKindAt(6) == CompilerRuntimeMaterializationArtifactKind() &&
        CompilerArtifactKindAt(7) == CompilerEmittedCArtifactKind() &&
        CompilerArtifactKindAt(8) == CompilerEmittedLlvmArtifactKind() &&
        CompilerArtifactKindAt(9) == CompilerEmittedSelfHostedArtifactKind() &&
        CompilerArtifactKindAt(10) == CompilerRunOutputArtifactKind() &&
        CompilerArtifactKindAt(11) == CompilerAstTextArtifactKind() &&
        CompilerArtifactKindAt(12) == CompilerLspDiagnosticsArtifactKind() &&
        CompilerArtifactKindAt(13) == CompilerLspTransportFrameArtifactKind() &&
        CompilerArtifactKindAt(14) == CompilerLspTransportStreamArtifactKind() &&
        CompilerArtifactKindAt(15) == CompilerLspRequestDispatchArtifactKind() &&
        CompilerArtifactKindAt(16) == CompilerLspResponseEmissionArtifactKind() &&
        CompilerArtifactKindAt(17) == CompilerLspSessionReplayArtifactKind() &&
        CompilerArtifactKindAt(18) == CompilerLspDocumentStoreArtifactKind() &&
        CompilerArtifactKindAt(19) == CompilerLspSessionStateArtifactKind() &&
        CompilerArtifactKindAt(20) == CompilerLspHoverContentArtifactKind();
}
