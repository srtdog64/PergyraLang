// Self-host compiler artifact-zone owner.
//
// Owns the comparable artifact kinds for C, LLVM, and self-hosted proof.

func CompilerArtifactSchema() -> String {
    return "pgy.selfhost.artifact-zone.v1";
}

func CompilerArtifactKindCount() -> Int {
    return 9;
}

func CompilerDiagnosticsArtifactKind() -> String {
    return "diagnostics";
}

func CompilerAirJsonArtifactKind() -> String {
    return "air_json";
}

func CompilerMirJsonArtifactKind() -> String {
    return "mir_json";
}

func CompilerAbiLayoutArtifactKind() -> String {
    return "abi_layout";
}

func CompilerRuntimeMaterializationArtifactKind() -> String {
    return "runtime_materialization";
}

func CompilerEmittedCArtifactKind() -> String {
    return "emitted_c";
}

func CompilerEmittedLlvmArtifactKind() -> String {
    return "emitted_llvm";
}

func CompilerEmittedSelfHostedArtifactKind() -> String {
    return "emitted_self_hosted";
}

func CompilerRunOutputArtifactKind() -> String {
    return "run_output";
}

func CompilerArtifactKindAt(index: Int) -> String {
    if index == 0 { return CompilerDiagnosticsArtifactKind(); }
    if index == 1 { return CompilerAirJsonArtifactKind(); }
    if index == 2 { return CompilerMirJsonArtifactKind(); }
    if index == 3 { return CompilerAbiLayoutArtifactKind(); }
    if index == 4 { return CompilerRuntimeMaterializationArtifactKind(); }
    if index == 5 { return CompilerEmittedCArtifactKind(); }
    if index == 6 { return CompilerEmittedLlvmArtifactKind(); }
    if index == 7 { return CompilerEmittedSelfHostedArtifactKind(); }
    if index == 8 { return CompilerRunOutputArtifactKind(); }
    return "";
}

func CompilerArtifactKindKnown(kind: String) -> Bool {
    let i: Int = 0;
    while i < CompilerArtifactKindCount() {
        if CompilerArtifactKindAt(i) == kind {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func CompilerArtifactZoneReady() -> Bool {
    return CompilerArtifactKindCount() == 9 &&
        CompilerArtifactKindAt(0) == CompilerDiagnosticsArtifactKind() &&
        CompilerArtifactKindAt(1) == CompilerAirJsonArtifactKind() &&
        CompilerArtifactKindAt(2) == CompilerMirJsonArtifactKind() &&
        CompilerArtifactKindAt(3) == CompilerAbiLayoutArtifactKind() &&
        CompilerArtifactKindAt(4) == CompilerRuntimeMaterializationArtifactKind() &&
        CompilerArtifactKindAt(5) == CompilerEmittedCArtifactKind() &&
        CompilerArtifactKindAt(6) == CompilerEmittedLlvmArtifactKind() &&
        CompilerArtifactKindAt(7) == CompilerEmittedSelfHostedArtifactKind() &&
        CompilerArtifactKindAt(8) == CompilerRunOutputArtifactKind();
}
