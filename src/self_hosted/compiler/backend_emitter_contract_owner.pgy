// Self-host compiler backend-emitter contract owner.
//
// Names the first self-host-consumed dumb-emitter source checks. The backend
// may emit rows, but must not invent runtime function names locally.

func CompilerBackendEmitterContractSchema() -> String {
    return "pgy.selfhost.backend-emitter-contract.v1";
}
func CompilerBackendEmitterNegativeSchema() -> String {
    return "pgy.selfhost.backend-emitter-contract-negative.v1";
}
func CompilerBackendEmitterMissingInputFinding() -> String {
    return "missing_input";
}
func CompilerBackendEmitterMissingRequiredFinding() -> String {
    return "missing_required";
}
func CompilerBackendEmitterForbiddenHitFinding() -> String {
    return "forbidden_hit";
}
func CompilerBackendEmitterRequiredCountField() -> String {
    return "required";
}
func CompilerBackendEmitterForbiddenCountField() -> String {
    return "forbidden";
}
func CompilerBackendEmitterMissingRequiredCountField() -> String {
    return "missing_required";
}
func CompilerBackendEmitterForbiddenHitsCountField() -> String {
    return "forbidden_hits";
}
func CompilerBackendEmitterOwnerNotReadyMessage() -> String {
    return "BACKEND_EMITTER_CONTRACT ERROR: owner is not ready";
}

func CompilerBackendEmitterRequiredCount() -> Int {
    return 20;
}

func CompilerBackendEmitterRequiredPathAt(index: Int) -> String {
    if index == 0 { return "src/codegen/transpiler_mir_resource_op_core.c"; }
    if index == 1 { return "src/codegen/llvm_runtime.c"; }
    if index == 2 { return "src/codegen/llvm_runtime_secure_slot_decl.c"; }
    if index == 3 { return "src/codegen/llvm_expr_slot_device_calls.c"; }
    // Slot auto-release is owned by the block emitter; llvm_stmt.c only
    // dispatches statements and must not be treated as the ABI-row consumer.
    if index == 4 { return "src/codegen/llvm_stmt_block.c"; }
    if index == 5 { return "src/codegen/transpiler_block_emit.c"; }
    if index == 6 { return "src/codegen/transpiler_expr_call_member_emit.c"; }
    if index == 7 { return "src/codegen/transpiler_let_slot_emit.c"; }
    if index == 8 { return "src/codegen/transpiler_func_class_flow_emit.c"; }
    if index == 9 { return "src/codegen/transpiler_mir_destructure_emit.c"; }
    if index == 10 { return "src/codegen/transpiler_class_decl_emit.c"; }
    if index == 11 { return "src/codegen/transpiler_expr_stdlib_builtin.c"; }
    if index == 12 { return "src/codegen/transpiler_mir_pin_emit.c"; }
    if index == 13 { return "src/codegen/transpiler_mir_pin_emit.c"; }
    if index == 14 { return "src/codegen/transpiler_block_emit.c"; }
    if index == 15 { return "src/codegen/transpiler_block_emit.c"; }
    if index == 16 { return "src/codegen/llvm_mir_pin_region.c"; }
    if index == 17 { return "src/codegen/llvm_mir_pin_region.c"; }
    if index == 18 { return "src/codegen/llvm_runtime.c"; }
    if index == 19 { return "src/codegen/llvm_runtime_secure_slot_decl.c"; }
    return "";
}

func CompilerBackendEmitterRequiredTermAt(index: Int) -> String {
    if index == 0 { return "mir_abi_resource_runtime_row_by_type_name("; }
    if index == 1 { return "mir_abi_resource_runtime_row_by_type_name(abi_type_name, operation)"; }
    if index == 2 { return "mir_abi_resource_runtime_row_by_type_name(abi_type_name, operation)"; }
    if index == 3 { return "mir_abi_resource_runtime_row_by_kind("; }
    if index == 4 { return "mir_abi_resource_runtime_fn_by_kind("; }
    if index == 5 { return "C source slot auto-release requires MIR ABI runtime function row"; }
    if index == 6 { return "transpiler_slot_runtime_fn("; }
    if index == 7 { return "C let-slot %s requires MIR ABI runtime function row"; }
    if index == 8 { return "transpiler_slot_runtime_fn("; }
    if index == 9 { return "transpiler_slot_runtime_fn("; }
    if index == 10 { return "transpiler_slot_runtime_fn("; }
    if index == 11 { return "transpiler_slot_runtime_fn("; }
    if index == 12 { return "mir_abi_resource_runtime_row_by_kind("; }
    if index == 13 { return "row->call_shape"; }
    if index == 14 { return "mir_abi_resource_runtime_row_by_kind("; }
    if index == 15 { return "row->call_shape"; }
    if index == 16 { return "mir_abi_resource_runtime_row_by_kind("; }
    if index == 17 { return "row->call_shape"; }
    if index == 18 { return "row->call_shape"; }
    if index == 19 { return "row->call_shape"; }
    return "";
}

func CompilerBackendEmitterRequiredRowKnown(path: String, term: String) -> Bool {
    let index: Int = 0;
    while index < CompilerBackendEmitterRequiredCount() {
        if CompilerBackendEmitterRequiredPathAt(index) == path &&
            CompilerBackendEmitterRequiredTermAt(index) == term {
            return true;
        }
        index = index + 1;
    }
    return false;
}

func CompilerBackendEmitterPrimaryRequiredPath() -> String {
    return "src/codegen/transpiler_mir_resource_op_core.c";
}

func CompilerBackendEmitterPrimaryRequiredTerm() -> String {
    return "mir_abi_resource_runtime_row_by_type_name(";
}

func CompilerBackendEmitterForbiddenCount() -> Int {
    return 11;
}

func CompilerBackendEmitterForbiddenPathAt(index: Int) -> String {
    if index == 0 { return "src/codegen/llvm_runtime.c"; }
    if index == 1 { return "src/codegen/llvm_runtime_secure_slot_decl.c"; }
    if index == 2 { return "src/codegen/llvm_stmt.c"; }
    if index == 3 { return "src/codegen/llvm_expr_call_methods_domain_slice.c"; }
    if index == 4 { return "src/codegen/llvm_expr_identifier_slot_helpers.c"; }
    if index == 5 { return "src/codegen/transpiler_mir_resource_op_core.c"; }
    if index == 6 { return "src/codegen/transpiler_expr_call_member_emit.c"; }
    if index == 7 { return "src/codegen/transpiler_func_class_flow_emit.c"; }
    if index == 8 { return "src/codegen/transpiler_mir_destructure_emit.c"; }
    if index == 9 { return "src/codegen/transpiler_class_decl_emit.c"; }
    if index == 10 { return "src/codegen/transpiler_expr_stdlib_builtin.c"; }
    return "";
}

func CompilerBackendEmitterForbiddenTermAt(index: Int) -> String {
    if index == 0 { return "llvm_runtime_slot_name"; }
    if index == 1 { return "llvm_runtime_secure_slot_name"; }
    if index == 2 { return "llvm_stmt_format_runtime_name"; }
    if index == 3 { return "llvm_domain_slot_format_runtime_name"; }
    if index == 4 { return "is_secure ? \"pgy_secure_read_%s\" : \"pgy_read_%s\""; }
    if index == 5 { return "strncmp(fn, \"pgy_claim_secure_\""; }
    if index == 6 { return "mir_abi_resource_runtime_fn_by_kind("; }
    if index == 7 { return "mir_abi_resource_runtime_fn_by_kind("; }
    if index == 8 { return "mir_abi_resource_runtime_fn_by_kind("; }
    if index == 9 { return "mir_abi_resource_runtime_fn_by_kind("; }
    if index == 10 { return "mir_abi_resource_runtime_fn_by_kind("; }
    return "";
}

func CompilerBackendEmitterForbiddenRowKnown(path: String, term: String) -> Bool {
    let index: Int = 0;
    while index < CompilerBackendEmitterForbiddenCount() {
        if CompilerBackendEmitterForbiddenPathAt(index) == path &&
            CompilerBackendEmitterForbiddenTermAt(index) == term {
            return true;
        }
        index = index + 1;
    }
    return false;
}

func CompilerBackendEmitterPrimaryForbiddenPath() -> String {
    return "src/codegen/llvm_runtime.c";
}

func CompilerBackendEmitterPrimaryForbiddenTerm() -> String {
    return "llvm_runtime_slot_name";
}

func CompilerBackendEmitterContractReady() -> Bool {
    return CompilerBackendEmitterContractSchema() != "" &&
        CompilerBackendEmitterNegativeSchema() != "" &&
        CompilerBackendEmitterMissingInputFinding() != "" &&
        CompilerBackendEmitterMissingRequiredFinding() != "" &&
        CompilerBackendEmitterForbiddenHitFinding() != "" &&
        CompilerBackendEmitterRequiredCountField() != "" &&
        CompilerBackendEmitterForbiddenCountField() != "" &&
        CompilerBackendEmitterMissingRequiredCountField() != "" &&
        CompilerBackendEmitterForbiddenHitsCountField() != "" &&
        CompilerBackendEmitterOwnerNotReadyMessage() != "" &&
        CompilerBackendEmitterRequiredPathAt(CompilerBackendEmitterRequiredCount()) == "" &&
        CompilerBackendEmitterRequiredTermAt(CompilerBackendEmitterRequiredCount()) == "" &&
        CompilerBackendEmitterForbiddenPathAt(CompilerBackendEmitterForbiddenCount()) == "" &&
        CompilerBackendEmitterForbiddenTermAt(CompilerBackendEmitterForbiddenCount()) == "" &&
        CompilerBackendEmitterRequiredRowKnown(
            CompilerBackendEmitterPrimaryRequiredPath(),
            CompilerBackendEmitterPrimaryRequiredTerm()) &&
        CompilerBackendEmitterRequiredRowKnown(
            "src/codegen/llvm_runtime.c",
            "mir_abi_resource_runtime_row_by_type_name(abi_type_name, operation)") &&
        CompilerBackendEmitterRequiredRowKnown(
            "src/codegen/llvm_runtime_secure_slot_decl.c",
            "mir_abi_resource_runtime_row_by_type_name(abi_type_name, operation)") &&
        CompilerBackendEmitterRequiredRowKnown(
            "src/codegen/llvm_expr_slot_device_calls.c",
            "mir_abi_resource_runtime_row_by_kind(") &&
        CompilerBackendEmitterRequiredRowKnown(
            "src/codegen/transpiler_mir_pin_emit.c",
            "mir_abi_resource_runtime_row_by_kind(") &&
        CompilerBackendEmitterRequiredRowKnown(
            "src/codegen/transpiler_mir_pin_emit.c",
            "row->call_shape") &&
        CompilerBackendEmitterRequiredRowKnown(
            "src/codegen/transpiler_block_emit.c",
            "row->call_shape") &&
        CompilerBackendEmitterRequiredRowKnown(
            "src/codegen/llvm_mir_pin_region.c",
            "mir_abi_resource_runtime_row_by_kind(") &&
        CompilerBackendEmitterRequiredRowKnown(
            "src/codegen/llvm_mir_pin_region.c",
            "row->call_shape") &&
        CompilerBackendEmitterRequiredRowKnown(
            "src/codegen/llvm_runtime_secure_slot_decl.c",
            "row->call_shape") &&
        CompilerBackendEmitterForbiddenRowKnown(
            CompilerBackendEmitterPrimaryForbiddenPath(),
            CompilerBackendEmitterPrimaryForbiddenTerm()) &&
        CompilerBackendEmitterForbiddenRowKnown(
            "src/codegen/llvm_expr_call_methods_domain_slice.c",
            "llvm_domain_slot_format_runtime_name") &&
        CompilerBackendEmitterForbiddenRowKnown(
            "src/codegen/transpiler_mir_resource_op_core.c",
            "strncmp(fn, \"pgy_claim_secure_\"") &&
        CompilerBackendEmitterForbiddenRowKnown(
            "src/codegen/transpiler_expr_stdlib_builtin.c",
            "mir_abi_resource_runtime_fn_by_kind(");
}
