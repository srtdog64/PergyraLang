// Bridges one machine-admitted MIR routine inventory into the C ABI receiver
// fact. The codegen layer receives the joined fact and never reads MIR JSON.

import "../mir_lower/machine_layer_fact_owner.pgy";
import "../semantic/ast_artifact_verdict_owner.pgy";
import "../codegen/input/callable_receiver_codegen_view_owner.pgy";
import "../codegen/input/semantic_body_type_codegen_view_owner.pgy";
import "../codegen/input/domain_runtime_codegen_view_owner.pgy";
import "domain_runtime_c_codegen_bridge_owner.pgy";
import "direct_mir_intent_plan_projection_owner.pgy";
import "intent_policy_c_codegen_bridge_owner.pgy";

struct CodegenAdmittedCView {
    receivers: CodegenCallableReceiverFacts;
    body_types: CodegenSemanticBodyTypeFacts;
    domain_runtime: CodegenDomainRuntimeFacts;
    intent_execution: CodegenIntentExecutionView;
    intent_policy: CodegenIntentPolicyView;
}

func CodegenCallableReceiverFactsFromAdmittedOrDie(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    analysis: SemanticAstArtifactAnalysis,
    canonical_routine_source_syntax_ids: Array<String>
) -> CodegenCallableReceiverFacts {
    return CodegenCallableReceiverFactsFromAdmittedRowsOrDie(
        analysis.signatures, analysis.constructors, analysis.roles,
        analysis.enums,
        canonical_routine_source_syntax_ids,
        admitted.routines.kinds,
        admitted.routines.owners,
        admitted.routines.names,
        admitted.routines.receiver_carriages
    );
}

func CodegenAdmittedCViewFromFactsOrDie(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    analysis: SemanticAstArtifactAnalysis,
    artifact: AstTreeArtifact,
    own semantic_body_types: SemanticAstBodyTypeBundle,
    own generic_specializations: CodegenGenericSpecializationFacts,
    body_type_admission: SemanticAstBodyTypeBundleAdmissionReceipt,
    ref intent_expression_occurrences: MirExpressionSemanticOccurrenceIndex,
    canonical_routine_source_syntax_ids: Array<String>,
    observe_pressure: Bool
) -> CodegenAdmittedCView {
    if observe_pressure { Log("[codegen-view-stage] receivers:start"); }
    let receivers: CodegenCallableReceiverFacts =
        CodegenCallableReceiverFactsFromAdmittedOrDie(
            admitted, analysis, canonical_routine_source_syntax_ids
        );
    if !receivers.admitted {
        Die("MIR callable receiver facts did not cross machine admission");
    }
    if observe_pressure { Log("[codegen-view-stage] receivers:done"); }
    if observe_pressure { Log("[codegen-view-stage] body-types:start"); }
    let body_types: CodegenSemanticBodyTypeFacts =
        CodegenSemanticBodyTypeFactsFromAdmittedBundleOrDie(
            artifact, analysis, semantic_body_types, generic_specializations,
            body_type_admission
        );
    if observe_pressure { Log("[codegen-view-stage] body-types:done"); }
    if observe_pressure { Log("[codegen-view-stage] domain-runtime:start"); }
    let domain_runtime: CodegenDomainRuntimeFacts =
        CodegenDomainRuntimeFactsFromAdmittedOrDie(admitted);
    if observe_pressure { Log("[codegen-view-stage] domain-runtime:done"); }
    if observe_pressure { Log("[codegen-view-stage] intent-execution:start"); }
    let intent_execution: CodegenIntentExecutionView =
        DirectMirIntentExecutionViewFromAdmitted(
            admitted, admitted.intent_execution_plan,
            analysis.expression_surfaces,
            intent_expression_occurrences,
            canonical_routine_source_syntax_ids
        );
    if !CodegenIntentExecutionViewReady(intent_execution) {
        Die("MIR typed intent execution plan did not cross machine admission");
    }
    if observe_pressure { Log("[codegen-view-stage] intent-execution:done"); }
    if observe_pressure { Log("[codegen-view-stage] intent-policy:start"); }
    let intent_policy: CodegenIntentPolicyView =
        CodegenIntentPolicyViewFromAdmittedMirOrDie(
            admitted, analysis, intent_expression_occurrences,
            canonical_routine_source_syntax_ids
        );
    if observe_pressure { Log("[codegen-view-stage] intent-policy:done"); }
    return CodegenAdmittedCView(
        receivers, body_types, domain_runtime, intent_execution,
        intent_policy
    );
}
