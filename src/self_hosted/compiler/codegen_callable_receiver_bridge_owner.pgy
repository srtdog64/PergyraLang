// Bridges one machine-admitted MIR routine inventory into the C ABI receiver
// fact. The codegen layer receives the joined fact and never reads MIR JSON.

import "../mir_lower/machine_layer_fact_owner.pgy";
import "../semantic/ast_artifact_verdict_owner.pgy";
import "../codegen/input/callable_receiver_codegen_view_owner.pgy";
import "../codegen/input/semantic_body_type_codegen_view_owner.pgy";
import "../codegen/input/domain_runtime_codegen_view_owner.pgy";
import "domain_runtime_c_codegen_bridge_owner.pgy";

struct CodegenAdmittedCView {
    receivers: CodegenCallableReceiverFacts;
    body_types: CodegenSemanticBodyTypeFacts;
    domain_runtime: CodegenDomainRuntimeFacts;
}

func CodegenCallableReceiverFactsFromAdmittedOrDie(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    analysis: SemanticAstArtifactAnalysis
) -> CodegenCallableReceiverFacts {
    return CodegenCallableReceiverFactsFromAdmittedRowsOrDie(
        analysis.signatures, analysis.constructors, analysis.roles,
        analysis.enums,
        admitted.routines.source_syntax_ids,
        admitted.routines.kinds,
        admitted.routines.owners,
        admitted.routines.names,
        admitted.routines.receiver_carriages
    );
}

func CodegenAdmittedCViewFromFactsOrDie(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    analysis: SemanticAstArtifactAnalysis,
    artifact: AstTreeArtifact,
    own semantic_body_types: SemanticAstBodyTypeBundle,
    own generic_specializations: CodegenGenericSpecializationFacts
) -> CodegenAdmittedCView {
    let receivers: CodegenCallableReceiverFacts =
        CodegenCallableReceiverFactsFromAdmittedOrDie(admitted, analysis);
    if !receivers.admitted {
        Die("MIR callable receiver facts did not cross machine admission");
    }
    let body_types: CodegenSemanticBodyTypeFacts =
        CodegenSemanticBodyTypeFactsFromBundleOrDie(
            artifact, analysis, semantic_body_types, generic_specializations
        );
    let domain_runtime: CodegenDomainRuntimeFacts =
        CodegenDomainRuntimeFactsFromAdmittedOrDie(admitted);
    return CodegenAdmittedCView(receivers, body_types, domain_runtime);
}
