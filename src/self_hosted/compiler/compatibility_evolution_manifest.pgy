// Runnable compatibility-evolution row projection.

import "compatibility_evolution_owner.pgy";

func CompilerCompatibilitySurfaceManifestRowAt(index: Int) -> String {
    let row0: String = Concat("surface|", ToString(index));
    let row1: String = Concat(row0, "|");
    return Concat(row1, CompilerCompatibilitySurfaceAt(index));
}

func CompilerObsoleteMigrationManifestRowAt(index: Int) -> String {
    let row0: String = Concat("obsolete_field|", ToString(index));
    let row1: String = Concat(row0, "|");
    return Concat(row1, CompilerObsoleteMigrationFieldAt(index));
}

func CompilerCompatibilityReceiptCrosswireMode() -> String {
    return "--self-test-receipt-diagnostic-crosswire";
}

func CompilerCompatibilityReceiptMissingRowMode() -> String {
    return "--self-test-receipt-missing-row";
}

func CompilerCompatibilityReceiptDuplicateSurfaceMode() -> String {
    return "--self-test-receipt-duplicate-surface";
}

func CompilerCompatibilityViewDiagnosticCrosswireMode() -> String {
    return "--self-test-view-diagnostic-crosswire";
}

func CompilerCompatibilityViewMissingPackageRowMode() -> String {
    return "--self-test-view-missing-package-row";
}

func CompilerCompatibilityChangeRowWithDiagnosticId(
    row: String,
    diagnostic_id: String
) -> String {
    return CompilerCompatibilityChangeRow(
        CompilerCompatibilityChangeRowFieldAt(
            row, CompilerCompatibilityChangeSurfaceFieldIndex()
        ),
        CompilerCompatibilityChangeRowFieldAt(
            row, CompilerCompatibilityChangeSymbolFieldIndex()
        ),
        CompilerCompatibilityChangeRowFieldAt(
            row, CompilerCompatibilityChangeKindFieldIndex()
        ),
        diagnostic_id,
        CompilerCompatibilityChangeRowFieldAt(
            row, CompilerCompatibilityChangeReplacementFieldIndex()
        ),
        CompilerCompatibilityChangeRowFieldAt(
            row, CompilerCompatibilityChangeMigrationUrlFieldIndex()
        ),
        CompilerCompatibilityChangeRowFieldAt(
            row, CompilerCompatibilityChangeCodefixStatusFieldIndex()
        )
    );
}

func CompilerCompatibilityEvolutionMutatedReceipt(
    ref canonical: CompilerCompatibilityEvolutionReceipt,
    mode: String
) -> CompilerCompatibilityEvolutionReceipt {
    let surfaces: Array<String> = [];
    let diagnostic_ids: Array<String> = [];
    let change_rows: Array<String> = [];
    let limit: Int = ArrayLength(canonical.surfaces);
    if mode == CompilerCompatibilityReceiptMissingRowMode() {
        limit = limit - 1;
    }
    let index: Int = 0;
    while index < limit {
        let surface: String = canonical.surfaces[index];
        let diagnostic_id: String = canonical.diagnostic_ids[index];
        let row: String = canonical.change_rows[index];
        if mode == CompilerCompatibilityReceiptCrosswireMode() &&
            surface == CompilerBehaviorCompatibilitySurface() {
            diagnostic_id = CompilerCompatibilityDiagnosticId("003");
            row = CompilerCompatibilityChangeRowWithDiagnosticId(
                row, diagnostic_id
            );
        } else if mode == CompilerCompatibilityReceiptCrosswireMode() &&
            surface == CompilerDiagnosticCompatibilitySurface() {
            diagnostic_id = CompilerCompatibilityDiagnosticId("004");
            row = CompilerCompatibilityChangeRowWithDiagnosticId(
                row, diagnostic_id
            );
        } else if mode == CompilerCompatibilityReceiptDuplicateSurfaceMode() &&
            index == limit - 1 {
            surface = canonical.surfaces[0];
            diagnostic_id = canonical.diagnostic_ids[0];
            row = canonical.change_rows[0];
        }
        ArrayPush(surfaces, surface);
        ArrayPush(diagnostic_ids, diagnostic_id);
        ArrayPush(change_rows, row);
        index = index + 1;
    }
    return CompilerCompatibilityEvolutionReceipt(
        canonical.schema, canonical.owner_schema,
        surfaces, diagnostic_ids, change_rows
    );
}

func CompilerCompatibilityEvolutionReceiptSelfTest(
    ref canonical: CompilerCompatibilityEvolutionReceipt,
    mode: String
) -> Void {
    let mutated: CompilerCompatibilityEvolutionReceipt =
        CompilerCompatibilityEvolutionMutatedReceipt(canonical, mode);
    if CompilerCompatibilityEvolutionReceiptReady(mutated) {
        Log(Concat("COMPATIBILITY_EVOLUTION ERROR: accepted ", mode));
        Exit(1);
    }
    Log(Concat("receipt_rejected=", mode));
}

func CompilerCompatibilityExecutionViewMutated(
    ref canonical: CompilerCompatibilityExecutionView,
    mode: String
) -> CompilerCompatibilityExecutionView {
    let diagnostic_row: String = canonical.diagnostic_row;
    let stdlib_module_row: String = canonical.stdlib_module_row;
    if mode == CompilerCompatibilityViewDiagnosticCrosswireMode() {
        diagnostic_row = canonical.behavior_row;
    } else if mode == CompilerCompatibilityViewMissingPackageRowMode() {
        stdlib_module_row = "";
    }
    return CompilerCompatibilityExecutionView(
        canonical.schema, canonical.source_row, canonical.abi_binary_row,
        canonical.behavior_row, diagnostic_row, canonical.air_evidence_row,
        canonical.mir_json_row, canonical.runtime_trace_row,
        canonical.capability_profile_row, stdlib_module_row
    );
}

func CompilerCompatibilityExecutionViewSelfTest(
    ref canonical: CompilerCompatibilityExecutionView,
    mode: String
) -> Void {
    let mutated: CompilerCompatibilityExecutionView =
        CompilerCompatibilityExecutionViewMutated(canonical, mode);
    if CompilerCompatibilityExecutionViewReady(mutated) {
        Log(Concat("COMPATIBILITY_EVOLUTION ERROR: accepted ", mode));
        Exit(1);
    }
    Log(Concat("view_rejected=", mode));
}

func Main() -> Void {
    let receipt: CompilerCompatibilityEvolutionReceipt =
        CompilerCompatibilityEvolutionReceiptFromOwner();
    let view: CompilerCompatibilityExecutionView =
        CompilerCompatibilityExecutionViewFromReceipt(receipt);
    if !CompilerCompatibilityEvolutionReady() ||
        !CompilerCompatibilityEvolutionReceiptReady(receipt) ||
        !CompilerCompatibilityExecutionViewReady(view) {
        Log("COMPATIBILITY_EVOLUTION ERROR: owner is not ready");
        Exit(1);
    }
    let args: Array<String> = Args();
    if ArrayLength(args) > 0 &&
        (args[0] == CompilerCompatibilityReceiptCrosswireMode() ||
         args[0] == CompilerCompatibilityReceiptMissingRowMode() ||
         args[0] == CompilerCompatibilityReceiptDuplicateSurfaceMode()) {
        CompilerCompatibilityEvolutionReceiptSelfTest(receipt, args[0]);
        return;
    }
    if ArrayLength(args) > 0 &&
        (args[0] == CompilerCompatibilityViewDiagnosticCrosswireMode() ||
         args[0] == CompilerCompatibilityViewMissingPackageRowMode()) {
        CompilerCompatibilityExecutionViewSelfTest(view, args[0]);
        return;
    }
    Log(Concat("schema=", CompilerCompatibilityEvolutionSchema()));
    Log(Concat("surface_count=", ToString(CompilerCompatibilitySurfaceCount())));
    let surface_index: Int = 0;
    while surface_index < CompilerCompatibilitySurfaceCount() {
        Log(CompilerCompatibilitySurfaceManifestRowAt(surface_index));
        surface_index = surface_index + 1;
    }
    Log(Concat("obsolete_field_count=", ToString(CompilerObsoleteMigrationFieldCount())));
    let obsolete_index: Int = 0;
    while obsolete_index < CompilerObsoleteMigrationFieldCount() {
        Log(CompilerObsoleteMigrationManifestRowAt(obsolete_index));
        obsolete_index = obsolete_index + 1;
    }
    Log(Concat("runtime_call_abi_schema=", CompilerRuntimeCallAbiCompatibilitySchema()));
    Log(Concat("runtime_call_abi_protocol=", CompilerRuntimeCallAbiProtocolId()));
    Log(Concat("runtime_call_abi_unknown_version=", CompilerRuntimeCallAbiUnknownVersionPolicy()));
    Log(Concat("runtime_call_abi_unknown_field=", CompilerRuntimeCallAbiUnknownFieldPolicy()));
    Log(Concat("runtime_call_abi_missing_fact=", CompilerRuntimeCallAbiMissingFactPolicy()));
    Log(Concat("runtime_call_abi_constructed_nominal=", CompilerRuntimeCallAbiConstructedNominalPolicy()));
    Log(Concat("runtime_call_abi_policy=", CompilerRuntimeCallAbiCompatibilityPolicy()));
    Log(Concat("change_count=", ToString(CompilerCompatibilityChangeCount())));
    let change_index: Int = 0;
    while change_index < CompilerCompatibilityChangeCount() {
        Log(CompilerCompatibilityChangeRowAt(change_index));
        change_index = change_index + 1;
    }
}
