// Self-host compiler compatibility-evolution owner.
//
// Owns the versioned surface vocabulary that hard self-hosted replacement must
// preserve before a surface can claim compatibility discipline.

func CompilerCompatibilityEvolutionSchema() -> String {
    return "pgy.selfhost.compatibility-evolution.v1";
}

func CompilerCompatibilitySurfaceCount() -> Int {
    return 9;
}

func CompilerSourceCompatibilitySurface() -> String { return "source"; }
func CompilerAbiBinaryCompatibilitySurface() -> String { return "abi_binary"; }
func CompilerBehaviorCompatibilitySurface() -> String { return "behavior"; }
func CompilerDiagnosticCompatibilitySurface() -> String { return "diagnostic"; }
func CompilerAirEvidenceCompatibilitySurface() -> String { return "air_evidence"; }
func CompilerMirJsonCompatibilitySurface() -> String { return "mir_json"; }
func CompilerRuntimeTraceCompatibilitySurface() -> String { return "runtime_trace"; }
func CompilerCapabilityProfileCompatibilitySurface() -> String { return "capability_profile"; }
func CompilerStdlibModuleCompatibilitySurface() -> String { return "stdlib_module"; }

func CompilerCompatibilitySurfaceAt(index: Int) -> String {
    if index == 0 { return CompilerSourceCompatibilitySurface(); }
    if index == 1 { return CompilerAbiBinaryCompatibilitySurface(); }
    if index == 2 { return CompilerBehaviorCompatibilitySurface(); }
    if index == 3 { return CompilerDiagnosticCompatibilitySurface(); }
    if index == 4 { return CompilerAirEvidenceCompatibilitySurface(); }
    if index == 5 { return CompilerMirJsonCompatibilitySurface(); }
    if index == 6 { return CompilerRuntimeTraceCompatibilitySurface(); }
    if index == 7 { return CompilerCapabilityProfileCompatibilitySurface(); }
    if index == 8 { return CompilerStdlibModuleCompatibilitySurface(); }
    return "";
}

func CompilerObsoleteMigrationFieldCount() -> Int {
    return 7;
}

func CompilerObsoleteDiagnosticIdField() -> String { return "diagnostic_id"; }
func CompilerObsoleteReplacementField() -> String { return "replacement"; }
func CompilerObsoleteMigrationUrlField() -> String { return "migration_url"; }
func CompilerObsoleteWarningFromField() -> String { return "warning_from"; }
func CompilerObsoleteErrorFromField() -> String { return "error_from"; }
func CompilerObsoleteRemoveFromField() -> String { return "remove_from"; }
func CompilerObsoleteCodefixStatusField() -> String { return "codefix_status"; }

func CompilerCompatibilityCodefixAvailableStatus() -> String { return "codefix_available"; }
func CompilerCompatibilityManualMigrationStatus() -> String { return "manual_migration"; }
func CompilerCompatibilityNoCodefixStatus() -> String { return "no_codefix"; }

func CompilerObsoleteMigrationFieldAt(index: Int) -> String {
    if index == 0 { return CompilerObsoleteDiagnosticIdField(); }
    if index == 1 { return CompilerObsoleteReplacementField(); }
    if index == 2 { return CompilerObsoleteMigrationUrlField(); }
    if index == 3 { return CompilerObsoleteWarningFromField(); }
    if index == 4 { return CompilerObsoleteErrorFromField(); }
    if index == 5 { return CompilerObsoleteRemoveFromField(); }
    if index == 6 { return CompilerObsoleteCodefixStatusField(); }
    return "";
}

func CompilerCompatibilityChangeCount() -> Int {
    return 9;
}

func CompilerCompatibilityChangeRowAt(index: Int) -> String {
    if index == 0 {
        return "change|source|PrintLine|obsolete|0.8|0.9|1.0|PGYCOMPAT001|Print|docs/compat/PrintLine|codefix_available";
    }
    if index == 1 {
        return "change|abi_binary|Array<String>|breaking|0.8|0.9|1.0|PGYCOMPAT002|ArrayOwned<String>|docs/compat/array-string-ownership|manual_migration";
    }
    if index == 2 {
        return "change|diagnostic|logical_operand_not_bool|behavior|0.8|0.9|1.0|PGYCOMPAT003|BoolLogicalOperands|docs/compat/logical-bool|no_codefix";
    }
    if index == 3 {
        return "change|behavior|ArrayPushValueParam|behavior|0.8|0.9|1.0|PGYCOMPAT004|inout Array<T>|docs/compat/value-arraypush|codefix_available";
    }
    if index == 4 {
        return "change|air_evidence|authority_effect_evidence|required|0.8|0.9|1.0|PGYCOMPAT005|AIRAuthorityEvidence|docs/compat/air-authority-evidence|manual_migration";
    }
    if index == 5 {
        return "change|mir_json|source_ast_semantic_fallback|breaking|0.8|0.9|1.0|PGYCOMPAT006|MirOwnedFacts|docs/compat/mir-source-ast|manual_migration";
    }
    if index == 6 {
        return "change|runtime_trace|slot_materialization_reason|required|0.8|0.9|1.0|PGYCOMPAT007|RuntimeMaterializationTrace|docs/compat/runtime-materialization|no_codefix";
    }
    if index == 7 {
        return "change|capability_profile|ambient_filesystem|breaking|0.8|0.9|1.0|PGYCOMPAT008|CapabilityManifestFs|docs/compat/capability-fs|manual_migration";
    }
    if index == 8 {
        return "change|stdlib_module|money_add_currency|behavior|0.8|0.9|1.0|PGYCOMPAT009|MoneyCurrencyMatch|docs/compat/money-currency|no_codefix";
    }
    return "";
}

func CompilerCompatibilityEvolutionReady() -> Bool {
    return CompilerCompatibilitySurfaceCount() == 9 &&
        CompilerCompatibilitySurfaceAt(0) == CompilerSourceCompatibilitySurface() &&
        CompilerCompatibilitySurfaceAt(1) == CompilerAbiBinaryCompatibilitySurface() &&
        CompilerCompatibilitySurfaceAt(2) == CompilerBehaviorCompatibilitySurface() &&
        CompilerCompatibilitySurfaceAt(3) == CompilerDiagnosticCompatibilitySurface() &&
        CompilerCompatibilitySurfaceAt(4) == CompilerAirEvidenceCompatibilitySurface() &&
        CompilerCompatibilitySurfaceAt(5) == CompilerMirJsonCompatibilitySurface() &&
        CompilerCompatibilitySurfaceAt(6) == CompilerRuntimeTraceCompatibilitySurface() &&
        CompilerCompatibilitySurfaceAt(7) == CompilerCapabilityProfileCompatibilitySurface() &&
        CompilerCompatibilitySurfaceAt(8) == CompilerStdlibModuleCompatibilitySurface() &&
        CompilerObsoleteMigrationFieldCount() == 7 &&
        CompilerObsoleteMigrationFieldAt(0) == CompilerObsoleteDiagnosticIdField() &&
        CompilerObsoleteMigrationFieldAt(1) == CompilerObsoleteReplacementField() &&
        CompilerObsoleteMigrationFieldAt(2) == CompilerObsoleteMigrationUrlField() &&
        CompilerObsoleteMigrationFieldAt(3) == CompilerObsoleteWarningFromField() &&
        CompilerObsoleteMigrationFieldAt(4) == CompilerObsoleteErrorFromField() &&
        CompilerObsoleteMigrationFieldAt(5) == CompilerObsoleteRemoveFromField() &&
        CompilerObsoleteMigrationFieldAt(6) == CompilerObsoleteCodefixStatusField() &&
        CompilerCompatibilityChangeCount() == 9 &&
        StringContains(CompilerCompatibilityChangeRowAt(0), CompilerCompatibilityCodefixAvailableStatus()) &&
        StringContains(CompilerCompatibilityChangeRowAt(1), CompilerCompatibilityManualMigrationStatus()) &&
        StringContains(CompilerCompatibilityChangeRowAt(2), CompilerCompatibilityNoCodefixStatus()) &&
        StringContains(CompilerCompatibilityChangeRowAt(3), CompilerBehaviorCompatibilitySurface()) &&
        StringContains(CompilerCompatibilityChangeRowAt(4), CompilerAirEvidenceCompatibilitySurface()) &&
        StringContains(CompilerCompatibilityChangeRowAt(5), CompilerMirJsonCompatibilitySurface()) &&
        StringContains(CompilerCompatibilityChangeRowAt(6), CompilerRuntimeTraceCompatibilitySurface()) &&
        StringContains(CompilerCompatibilityChangeRowAt(7), CompilerCapabilityProfileCompatibilitySurface()) &&
        StringContains(CompilerCompatibilityChangeRowAt(8), CompilerStdlibModuleCompatibilitySurface());
}
