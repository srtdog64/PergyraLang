func CompilerCompatibilityCorpusObsoleteMigrationCountField() -> String { return "obsolete_migration"; }
func CompilerCompatibilityCorpusMissingCountField() -> String { return "missing"; }

func CompilerCompatibilityMissingSourceFinding() -> String { return "missing_source_change"; }
func CompilerCompatibilityMissingAbiFinding() -> String { return "missing_abi_change"; }
func CompilerCompatibilityMissingBehaviorFinding() -> String { return "missing_behavior_change"; }
func CompilerCompatibilityMissingDiagnosticFinding() -> String { return "missing_diagnostic_change"; }
func CompilerCompatibilityMissingAirEvidenceFinding() -> String { return "missing_air_evidence_change"; }
func CompilerCompatibilityMissingMirJsonFinding() -> String { return "missing_mir_json_change"; }
func CompilerCompatibilityMissingRuntimeTraceFinding() -> String { return "missing_runtime_trace_change"; }
func CompilerCompatibilityMissingCapabilityProfileFinding() -> String { return "missing_capability_profile_change"; }
func CompilerCompatibilityMissingStdlibModuleFinding() -> String { return "missing_stdlib_module_change"; }
func CompilerCompatibilityMissingDiagnosticIdFinding() -> String { return "missing_diagnostic_id"; }
func CompilerCompatibilityMissingVersionLadderFinding() -> String { return "missing_version_ladder"; }
func CompilerCompatibilityMissingMigrationUrlFinding() -> String { return "missing_migration_url"; }
func CompilerCompatibilityMissingCodefixStatusFinding() -> String { return "missing_codefix_status"; }
func CompilerCompatibilityUnknownChangeKindFinding() -> String { return "unknown_change_kind"; }
func CompilerCompatibilityMalformedChangeRowFinding() -> String { return "malformed_change_row"; }
func CompilerCompatibilityMissingObsoleteFinding() -> String { return "missing_obsolete_change"; }
func CompilerCompatibilityMissingObsoleteMigrationEnvelopeFinding() -> String { return "missing_obsolete_migration_envelope"; }
func CompilerCompatibilityUnknownCodefixSelfTestStatus() -> String { return "unknown_codefix"; }

func CompilerCompatibilityChangeRow(
    surface: String,
    symbol: String,
    change_kind: String,
    diagnostic_id: String,
    replacement: String,
    migration_url: String,
    codefix_status: String
) -> String {
    let fields: Array<String> = [
        CompilerCompatibilityChangeMarker(),
        surface,
        symbol,
        change_kind,
        CompilerCompatibilityWarningFromVersion(),
        CompilerCompatibilityErrorFromVersion(),
        CompilerCompatibilityRemoveFromVersion(),
        diagnostic_id,
        replacement,
        migration_url,
        codefix_status
    ];
    return StringJoin(fields, CompilerCompatibilityChangeRowDelimiter());
}

func CompilerCompatibilityChangeRowAt(index: Int) -> String {
    if index == 0 {
        return CompilerCompatibilityChangeRow(CompilerSourceCompatibilitySurface(), "PrintLine", CompilerCompatibilityObsoleteChangeKind(), CompilerCompatibilityDiagnosticId("001"), "Print", CompilerCompatibilityMigrationUrl("PrintLine"), CompilerCompatibilityCodefixAvailableStatus());
    }
    if index == 1 {
        return CompilerCompatibilityChangeRow(CompilerAbiBinaryCompatibilitySurface(), "Array<String>", CompilerCompatibilityBreakingChangeKind(), CompilerCompatibilityDiagnosticId("002"), "ArrayOwned<String>", CompilerCompatibilityMigrationUrl("array-string-ownership"), CompilerCompatibilityManualMigrationStatus());
    }
    if index == 2 {
        return CompilerCompatibilityChangeRow(CompilerDiagnosticCompatibilitySurface(), "logical_operand_not_bool", CompilerCompatibilityBehaviorChangeKind(), CompilerCompatibilityDiagnosticId("003"), "BoolLogicalOperands", CompilerCompatibilityMigrationUrl("logical-bool"), CompilerCompatibilityNoCodefixStatus());
    }
    if index == 3 {
        return CompilerCompatibilityChangeRow(CompilerBehaviorCompatibilitySurface(), "ArrayPushValueParam", CompilerCompatibilityBehaviorChangeKind(), CompilerCompatibilityDiagnosticId("004"), "inout Array<T>", CompilerCompatibilityMigrationUrl("value-arraypush"), CompilerCompatibilityCodefixAvailableStatus());
    }
    if index == 4 {
        return CompilerCompatibilityChangeRow(CompilerAirEvidenceCompatibilitySurface(), "authority_effect_evidence", CompilerCompatibilityRequiredChangeKind(), CompilerCompatibilityDiagnosticId("005"), "AIRAuthorityEvidence", CompilerCompatibilityMigrationUrl("air-authority-evidence"), CompilerCompatibilityManualMigrationStatus());
    }
    if index == 5 {
        return CompilerCompatibilityChangeRow(CompilerMirJsonCompatibilitySurface(), "source_ast_semantic_fallback", CompilerCompatibilityBreakingChangeKind(), CompilerCompatibilityDiagnosticId("006"), "MirOwnedFacts", CompilerCompatibilityMigrationUrl("mir-source-ast"), CompilerCompatibilityManualMigrationStatus());
    }
    if index == 6 {
        return CompilerCompatibilityChangeRow(CompilerRuntimeTraceCompatibilitySurface(), "slot_materialization_reason", CompilerCompatibilityRequiredChangeKind(), CompilerCompatibilityDiagnosticId("007"), "RuntimeMaterializationTrace", CompilerCompatibilityMigrationUrl("runtime-materialization"), CompilerCompatibilityNoCodefixStatus());
    }
    if index == 7 {
        return CompilerCompatibilityChangeRow(CompilerCapabilityProfileCompatibilitySurface(), "ambient_filesystem", CompilerCompatibilityBreakingChangeKind(), CompilerCompatibilityDiagnosticId("008"), "CapabilityManifestFs", CompilerCompatibilityMigrationUrl("capability-fs"), CompilerCompatibilityManualMigrationStatus());
    }
    if index == 8 {
        return CompilerCompatibilityChangeRow(CompilerStdlibModuleCompatibilitySurface(), "money_add_currency", CompilerCompatibilityBehaviorChangeKind(), CompilerCompatibilityDiagnosticId("009"), "MoneyCurrencyMatch", CompilerCompatibilityMigrationUrl("money-currency"), CompilerCompatibilityNoCodefixStatus());
    }
    return "";
}

func CompilerCompatibilityEvolutionReady() -> Bool {
    return CompilerCompatibilitySurfaceCount() == 9 &&
        CompilerCompatibilitySurfaceAt(0) == CompilerSourceCompatibilitySurface() &&
        CompilerCompatibilitySurfaceAt(1) == CompilerAbiBinaryCompatibilitySurface() &&
        CompilerCompatibilitySurfaceAt(2) == CompilerBehaviorCompatibilitySurface() &&
        CompilerCompatibilitySurfaceAt(3) == CompilerDiagnosticCompatibilitySurface() &&
        CompilerCompatibilitySurfaceAt(4) == CompilerAirEvidenceCompatibilitySurface() &&
        CompilerCompatibilitySurfaceAt(5) == CompilerMirJsonCompatibilitySurface() &&
        CompilerCompatibilitySurfaceAt(6) == CompilerRuntimeTraceCompatibilitySurface() &&
        CompilerCompatibilitySurfaceAt(7) == CompilerCapabilityProfileCompatibilitySurface() &&
        CompilerCompatibilitySurfaceAt(8) == CompilerStdlibModuleCompatibilitySurface() &&
        CompilerObsoleteMigrationFieldCount() == 7 &&
        CompilerObsoleteMigrationFieldAt(0) == CompilerObsoleteDiagnosticIdField() &&
        CompilerObsoleteMigrationFieldAt(1) == CompilerObsoleteReplacementField() &&
        CompilerObsoleteMigrationFieldAt(2) == CompilerObsoleteMigrationUrlField() &&
        CompilerObsoleteMigrationFieldAt(3) == CompilerObsoleteWarningFromField() &&
        CompilerObsoleteMigrationFieldAt(4) == CompilerObsoleteErrorFromField() &&
        CompilerObsoleteMigrationFieldAt(5) == CompilerObsoleteRemoveFromField() &&
        CompilerObsoleteMigrationFieldAt(6) == CompilerObsoleteCodefixStatusField() &&
        CompilerCompatibilityObsoleteChangeKind() != "" &&
        CompilerCompatibilityBreakingChangeKind() != "" &&
        CompilerCompatibilityBehaviorChangeKind() != "" &&
        CompilerCompatibilityRequiredChangeKind() != "" &&
        CompilerCompatibilityChangeKindCount() == 4 &&
        CompilerCompatibilityChangeKindAt(0) == CompilerCompatibilityObsoleteChangeKind() &&
        CompilerCompatibilityChangeKindAt(1) == CompilerCompatibilityBreakingChangeKind() &&
        CompilerCompatibilityChangeKindAt(2) == CompilerCompatibilityBehaviorChangeKind() &&
        CompilerCompatibilityChangeKindAt(3) == CompilerCompatibilityRequiredChangeKind() &&
        CompilerCompatibilityWarningFromVersion() != "" &&
        CompilerCompatibilityErrorFromVersion() != "" &&
        CompilerCompatibilityRemoveFromVersion() != "" &&
        CompilerCompatibilityDiagnosticIdPrefix() != "" &&
        CompilerCompatibilityMigrationUrlPrefix() != "" &&
        CompilerCompatibilityDiagnosticId("001") != "" &&
        CompilerCompatibilityMigrationUrl("PrintLine") != "" &&
        CompilerCompatibilityChangeRowDelimiter() != "" &&
        CompilerCompatibilityChangeMarker() != "" &&
        CompilerCompatibilityChangeFieldCount() == 11 &&
        CompilerCompatibilityChangeSurfaceFieldIndex() == 1 &&
        CompilerCompatibilityChangeSymbolFieldIndex() == 2 &&
        CompilerCompatibilityChangeKindFieldIndex() == 3 &&
        CompilerCompatibilityChangeWarningFromFieldIndex() == 4 &&
        CompilerCompatibilityChangeErrorFromFieldIndex() == 5 &&
        CompilerCompatibilityChangeRemoveFromFieldIndex() == 6 &&
        CompilerCompatibilityChangeDiagnosticIdFieldIndex() == 7 &&
        CompilerCompatibilityChangeReplacementFieldIndex() == 8 &&
        CompilerCompatibilityChangeMigrationUrlFieldIndex() == 9 &&
        CompilerCompatibilityChangeCodefixStatusFieldIndex() == 10 &&
        CompilerCompatibilityCorpusSchema() != "" &&
        CompilerCompatibilityCorpusNegativeSchema() != "" &&
        CompilerCompatibilityCorpusChangesCountField() != "" &&
        CompilerCompatibilityCorpusRowShapeCountField() != "" &&
        CompilerCompatibilityCorpusMissingCountField() != "" &&
        CompilerCompatibilityCorpusChangeKindCountField() != "" &&
        CompilerCompatibilityMissingSourceFinding() != "" &&
        CompilerCompatibilityMissingAbiFinding() != "" &&
        CompilerCompatibilityMissingBehaviorFinding() != "" &&
        CompilerCompatibilityMissingDiagnosticFinding() != "" &&
        CompilerCompatibilityMissingAirEvidenceFinding() != "" &&
        CompilerCompatibilityMissingMirJsonFinding() != "" &&
        CompilerCompatibilityMissingRuntimeTraceFinding() != "" &&
        CompilerCompatibilityMissingCapabilityProfileFinding() != "" &&
        CompilerCompatibilityMissingStdlibModuleFinding() != "" &&
        CompilerCompatibilityMissingDiagnosticIdFinding() != "" &&
        CompilerCompatibilityMissingVersionLadderFinding() != "" &&
        CompilerCompatibilityMissingMigrationUrlFinding() != "" &&
        CompilerCompatibilityMissingCodefixStatusFinding() != "" &&
        CompilerCompatibilityUnknownChangeKindFinding() != "" &&
        CompilerCompatibilityMalformedChangeRowFinding() != "" &&
        CompilerCompatibilityMissingObsoleteFinding() != "" &&
        CompilerCompatibilityMissingObsoleteMigrationEnvelopeFinding() != "" &&
        CompilerCompatibilityUnknownCodefixSelfTestStatus() != "" &&
        CompilerCompatibilityChangeCount() == 9 &&
        StringContains(CompilerCompatibilityChangeRowAt(0), CompilerCompatibilityCodefixAvailableStatus()) &&
        StringContains(CompilerCompatibilityChangeRowAt(1), CompilerCompatibilityManualMigrationStatus()) &&
        StringContains(CompilerCompatibilityChangeRowAt(2), CompilerCompatibilityNoCodefixStatus()) &&
        StringContains(CompilerCompatibilityChangeRowAt(3), CompilerBehaviorCompatibilitySurface()) &&
        StringContains(CompilerCompatibilityChangeRowAt(4), CompilerAirEvidenceCompatibilitySurface()) &&
        StringContains(CompilerCompatibilityChangeRowAt(5), CompilerMirJsonCompatibilitySurface()) &&
        StringContains(CompilerCompatibilityChangeRowAt(6), CompilerRuntimeTraceCompatibilitySurface()) &&
        StringContains(CompilerCompatibilityChangeRowAt(7), CompilerCapabilityProfileCompatibilitySurface()) &&
        StringContains(CompilerCompatibilityChangeRowAt(8), CompilerStdlibModuleCompatibilitySurface());
}
