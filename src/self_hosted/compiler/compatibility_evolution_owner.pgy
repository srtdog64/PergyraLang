// Self-host compiler compatibility-evolution owner.
//
// Owns the versioned surface vocabulary that hard self-hosted replacement must
// preserve before a surface can claim compatibility discipline.

func CompilerCompatibilityEvolutionSchema() -> String {
    return "pgy.selfhost.compatibility-evolution.v1";
}

func CompilerCompatibilityCorpusSchema() -> String {
    return "pgy.selfhost.compatibility-corpus.v1";
}

func CompilerCompatibilityCorpusNegativeSchema() -> String {
    return "pgy.selfhost.compatibility-corpus-negative.v1";
}

func CompilerCompatibilitySurfaceCount() -> Int {
    return 9;
}

func CompilerSourceCompatibilitySurface() -> String { return "source"; }
func CompilerAbiBinaryCompatibilitySurface() -> String { return "abi_binary"; }
func CompilerBehaviorCompatibilitySurface() -> String { return "behavior"; }
func CompilerDiagnosticCompatibilitySurface() -> String { return "diagnostic"; }
func CompilerAirEvidenceCompatibilitySurface() -> String { return "air_evidence"; }
func CompilerMirJsonCompatibilitySurface() -> String { return "mir_json"; }
func CompilerRuntimeTraceCompatibilitySurface() -> String { return "runtime_trace"; }
func CompilerCapabilityProfileCompatibilitySurface() -> String { return "capability_profile"; }
func CompilerStdlibModuleCompatibilitySurface() -> String { return "stdlib_module"; }

func CompilerCompatibilitySurfaceAt(index: Int) -> String {
    if index == 0 { return CompilerSourceCompatibilitySurface(); }
    if index == 1 { return CompilerAbiBinaryCompatibilitySurface(); }
    if index == 2 { return CompilerBehaviorCompatibilitySurface(); }
    if index == 3 { return CompilerDiagnosticCompatibilitySurface(); }
    if index == 4 { return CompilerAirEvidenceCompatibilitySurface(); }
    if index == 5 { return CompilerMirJsonCompatibilitySurface(); }
    if index == 6 { return CompilerRuntimeTraceCompatibilitySurface(); }
    if index == 7 { return CompilerCapabilityProfileCompatibilitySurface(); }
    if index == 8 { return CompilerStdlibModuleCompatibilitySurface(); }
    return "";
}

func CompilerObsoleteMigrationFieldCount() -> Int {
    return 7;
}

func CompilerObsoleteDiagnosticIdField() -> String { return "diagnostic_id"; }
func CompilerObsoleteReplacementField() -> String { return "replacement"; }
func CompilerObsoleteMigrationUrlField() -> String { return "migration_url"; }
func CompilerObsoleteWarningFromField() -> String { return "warning_from"; }
func CompilerObsoleteErrorFromField() -> String { return "error_from"; }
func CompilerObsoleteRemoveFromField() -> String { return "remove_from"; }
func CompilerObsoleteCodefixStatusField() -> String { return "codefix_status"; }

func CompilerCompatibilityCodefixAvailableStatus() -> String { return "codefix_available"; }
func CompilerCompatibilityManualMigrationStatus() -> String { return "manual_migration"; }
func CompilerCompatibilityNoCodefixStatus() -> String { return "no_codefix"; }
func CompilerCompatibilityObsoleteChangeKind() -> String { return "obsolete"; }
func CompilerCompatibilityBreakingChangeKind() -> String { return "breaking"; }
func CompilerCompatibilityBehaviorChangeKind() -> String { return "behavior"; }
func CompilerCompatibilityRequiredChangeKind() -> String { return "required"; }
func CompilerCompatibilityChangeKindCount() -> Int { return 4; }
func CompilerCompatibilityChangeKindAt(index: Int) -> String {
    if index == 0 { return CompilerCompatibilityObsoleteChangeKind(); }
    if index == 1 { return CompilerCompatibilityBreakingChangeKind(); }
    if index == 2 { return CompilerCompatibilityBehaviorChangeKind(); }
    if index == 3 { return CompilerCompatibilityRequiredChangeKind(); }
    return "";
}
func CompilerCompatibilityWarningFromVersion() -> String { return "0.8"; }
func CompilerCompatibilityErrorFromVersion() -> String { return "0.9"; }
func CompilerCompatibilityRemoveFromVersion() -> String { return "1.0"; }
func CompilerCompatibilityDiagnosticIdPrefix() -> String { return "PGYCOMPAT"; }
func CompilerCompatibilityMigrationUrlPrefix() -> String { return "docs/compat/"; }

func CompilerCompatibilityDiagnosticId(suffix: String) -> String {
    let parts: Array<String> = [CompilerCompatibilityDiagnosticIdPrefix(), suffix];
    return StringJoin(parts, "");
}

func CompilerCompatibilityMigrationUrl(slug: String) -> String {
    let parts: Array<String> = [CompilerCompatibilityMigrationUrlPrefix(), slug];
    return StringJoin(parts, "");
}

func CompilerObsoleteMigrationFieldAt(index: Int) -> String {
    if index == 0 { return CompilerObsoleteDiagnosticIdField(); }
    if index == 1 { return CompilerObsoleteReplacementField(); }
    if index == 2 { return CompilerObsoleteMigrationUrlField(); }
    if index == 3 { return CompilerObsoleteWarningFromField(); }
    if index == 4 { return CompilerObsoleteErrorFromField(); }
    if index == 5 { return CompilerObsoleteRemoveFromField(); }
    if index == 6 { return CompilerObsoleteCodefixStatusField(); }
    return "";
}

func CompilerCompatibilityChangeCount() -> Int {
    return 9;
}

func CompilerCompatibilityChangeRowDelimiter() -> String { return "|"; }
func CompilerCompatibilityChangeMarker() -> String { return "change"; }
func CompilerCompatibilityChangeFieldCount() -> Int { return 11; }
func CompilerCompatibilityChangeSurfaceFieldIndex() -> Int { return 1; }
func CompilerCompatibilityChangeSymbolFieldIndex() -> Int { return 2; }
func CompilerCompatibilityChangeKindFieldIndex() -> Int { return 3; }
func CompilerCompatibilityChangeWarningFromFieldIndex() -> Int { return 4; }
func CompilerCompatibilityChangeErrorFromFieldIndex() -> Int { return 5; }
func CompilerCompatibilityChangeRemoveFromFieldIndex() -> Int { return 6; }
func CompilerCompatibilityChangeDiagnosticIdFieldIndex() -> Int { return 7; }
func CompilerCompatibilityChangeReplacementFieldIndex() -> Int { return 8; }
func CompilerCompatibilityChangeMigrationUrlFieldIndex() -> Int { return 9; }
func CompilerCompatibilityChangeCodefixStatusFieldIndex() -> Int { return 10; }

func CompilerCompatibilityCorpusChangesCountField() -> String { return "changes"; }
func CompilerCompatibilityCorpusDiagnosticIdCountField() -> String { return "diagnostic_id"; }
func CompilerCompatibilityCorpusVersionLadderCountField() -> String { return "version_ladder"; }
func CompilerCompatibilityCorpusMigrationUrlCountField() -> String { return "migration_url"; }
func CompilerCompatibilityCorpusCodefixStatusCountField() -> String { return "codefix_status"; }
