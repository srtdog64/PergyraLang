// Sole composition root for the production-reachable compiler world slices.
// It materializes every positional executable zone; aggregate zero-fill and a
// second world are forbidden. The value is not a physical singleton claim.

import "world.pgy";
func PgyCompilerWorldMaterializeExecutableZones() -> PgyCompilerWorld {
    let compiler_world: PgyCompilerWorld = PgyCompilerWorld(
        DriverRung2DirectMirZone(
            DriverRung2Execution(DriverRung2ExecutionOwnerIdentity())
        ),
        DriverSourceMirZone(DriverSourceMirExecution(
            DriverSourceMirExecutionOwnerIdentity(),
            DriverSourceMirExecutionTopologyIdentity()
        )),
        DriverSourceLlvmIntentZone(DriverSourceLlvmIntentExecution(
            DriverSourceLlvmIntentExecutionOwnerIdentity(), None
        )),
        DriverSourceCZone(DriverSourceCExecution(
            DriverSourceCExecutionOwnerIdentity(),
            DriverSourceCExecutionTopologyIdentity(), None
        ))
    );
    return compiler_world;
}

func EmitDirectMirThroughPgyCompilerWorld(
    mir_json_path: String, output_path: String,
    machine_declaration: SelfHostMachineLayerDeclaration,
    request: DriverRung2DirectMirRequest, observe_pressure: Bool
) -> DriverRung2ExecutionOutcome with caps io_read, io_write {
    let compiler_world: PgyCompilerWorld = PgyCompilerWorldMaterializeExecutableZones();
    return compiler_world.EmitDirectMir(mir_json_path, output_path,
        machine_declaration, request, observe_pressure);
}

func ProduceMirCThroughPgyCompilerWorld(
    mir_json_path: String,
    observation_request: DriverRung2MirCRequest,
    machine_request: DriverRung2MirCMachineRequest
) -> DriverRung2MirCPayloadAdmission with caps io_read {
    let compiler_world: PgyCompilerWorld = PgyCompilerWorldMaterializeExecutableZones();
    return compiler_world.ProduceMirC(
        mir_json_path, observation_request, machine_request);
}

