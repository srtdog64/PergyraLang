// Sole composition root for the production-reachable compiler world slices.
//
// PgyCompilerWorld remains the only compiler-world declaration graph. This
// owner materializes both positional executable zones; no omitted executable
// zone may be supplied through aggregate zero-fill.
// Inline nesting leaves no surviving origin binding or implicit identity fork.
// The C/LLVM representation is still a by-value aggregate, not physical
// no-copy, stable-address identity, or a process-wide runtime singleton.

import "world.pgy";

func PgyCompilerWorldMaterializeExecutableZones() -> PgyCompilerWorld {
    let compiler_world: PgyCompilerWorld = PgyCompilerWorld(
        DriverRung2DirectMirZone(
            DriverRung2Execution(DriverRung2ExecutionOwnerIdentity())
        ),
        DriverSourceMirZone(DriverSourceMirExecution(
            DriverSourceMirExecutionOwnerIdentity(),
            DriverSourceMirExecutionTopologyIdentity()
        ))
    );
    return compiler_world;
}

func EmitDirectMirThroughPgyCompilerWorld(
    mir_json_path: String,
    output_path: String,
    machine_declaration: SelfHostMachineLayerDeclaration,
    request: DriverRung2DirectMirRequest,
    observe_pressure: Bool
) -> DriverRung2ExecutionOutcome with caps io_read, io_write {
    let compiler_world: PgyCompilerWorld =
        PgyCompilerWorldMaterializeExecutableZones();
    return compiler_world.EmitDirectMir(
        mir_json_path, output_path, machine_declaration, request,
        observe_pressure
    );
}

func ProduceSourceMirThroughPgyCompilerWorld(
    source_path: String,
    machine_declaration: SelfHostMachineLayerDeclaration,
    request: DriverSourceMirRequest
) -> DriverSourceMirExecutionOutcome with caps io_read {
    let compiler_world: PgyCompilerWorld =
        PgyCompilerWorldMaterializeExecutableZones();
    return compiler_world.ProduceSourceMir(
        source_path, machine_declaration, request
    );
}

func PublishSourceMirArtifactThroughPgyCompilerWorld(
    source_path: String,
    output_path: String,
    machine_declaration: SelfHostMachineLayerDeclaration,
    request: DriverSourceMirRequest
) -> DriverSourceMirExecutionOutcome with caps io_read, io_write {
    let compiler_world: PgyCompilerWorld =
        PgyCompilerWorldMaterializeExecutableZones();
    return compiler_world.PublishSourceMirArtifact(
        source_path, output_path, machine_declaration, request
    );
}
