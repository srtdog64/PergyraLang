// Self-host completeness ledger owner.
//
// Owns the M2 source inventory scope, stage names, and monotone baseline
// minima. Shell runners may execute the rows, but must not redefine them.

struct CompilerCompletenessCheckTarget {
    let path: String;
}

func CompilerCompletenessLedgerSchema() -> String {
    return "pgy.selfhost.completeness-ledger.v1";
}

func CompilerCompletenessSourceRoot() -> String {
    return "src/self_hosted";
}

func CompilerCompletenessSourcesSuiteName() -> String {
    return "self-host-completeness-sources";
}

func CompilerCompletenessStagesSuiteName() -> String {
    return "self-host-completeness-stages";
}

func CompilerCompletenessSemanticTargetsSuiteName() -> String {
    return "self-host-completeness-semantic-targets";
}

func CompilerCompletenessBaselineSuiteName() -> String {
    return "self-host-completeness-baseline";
}

func CompilerCompletenessLexParseBaselineSuiteName() -> String {
    return "self-host-completeness-lex-parse-baseline";
}

func CompilerCompletenessLexParseSemanticBaselineSuiteName() -> String {
    return "self-host-completeness-lex-parse-semantic-baseline";
}

func CompilerCompletenessFullPipelineBaselineSuiteName() -> String {
    return "self-host-completeness-full-pipeline-baseline";
}

func CompilerCompletenessPathEndsWith(path: String, suffix: String) -> Bool {
    let path_len: Int = StringLength(path);
    let suffix_len: Int = StringLength(suffix);
    if suffix_len > path_len {
        return false;
    }
    return Substring(path, path_len - suffix_len, suffix_len) == suffix;
}

func CompilerCompletenessPathContains(path: String, needle: String) -> Bool {
    return StringIndexOf(path, needle) >= 0;
}

func CompilerCompletenessIsProductionSource(path: String) -> Bool {
    if !CompilerCompletenessPathEndsWith(path, ".pgy") {
        return false;
    }
    if CompilerCompletenessPathContains(path, "/fixture/") {
        return false;
    }
    if CompilerCompletenessPathContains(path, "/expected/") {
        return false;
    }
    if path == "src/self_hosted/tools/linter/fixture.pgy" {
        return false;
    }
    if path == "src/self_hosted/tools/linter/fixture_structural.pgy" {
        return false;
    }
    return true;
}

func CompilerCompletenessSourceInventory() -> Array<String> {
    let entries: Array<String> = DirWalk(CompilerCompletenessSourceRoot());
    let rows: Array<String> = [];
    let i: Int = 0;
    while i < ArrayLength(entries) {
        let path: String = entries[i];
        if CompilerCompletenessIsProductionSource(path) {
            ArrayPush(rows, path);
        }
        i = i + 1;
    }
    return rows;
}

func EmitCompilerCompletenessSourceInventory() -> Void {
    let rows: Array<String> = CompilerCompletenessSourceInventory();
    let i: Int = 0;
    while i < ArrayLength(rows) {
        Log(rows[i]);
        i = i + 1;
    }
}

func CompilerCompletenessStageCount() -> Int {
    return 4;
}

func CompilerCompletenessStageAt(index: Int) -> String {
    if index == 0 { return "lexer"; }
    if index == 1 { return "parser"; }
    if index == 2 { return "semantic"; }
    if index == 3 { return "codegen"; }
    return "";
}

func EmitCompilerCompletenessStages() -> Void {
    let i: Int = 0;
    while i < CompilerCompletenessStageCount() {
        Log(CompilerCompletenessStageAt(i));
        i = i + 1;
    }
}

func CompilerCompletenessSemanticCheckTarget(path: String) -> CompilerCompletenessCheckTarget {
    if path == "src/self_hosted/parser/expr_postfix_owner.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/parser/expr_owner.pgy");
    }
    if path == "src/self_hosted/parser/expr_precedence_owner.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/parser/expr_owner.pgy");
    }
    if path == "src/self_hosted/parser/expr_primary_owner.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/parser/expr_owner.pgy");
    }
    if path == "src/self_hosted/parser/expr_string_owner.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/parser/expr_owner.pgy");
    }
    if path == "src/self_hosted/parser/stmt_if_owner.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/parser/stmt_owner.pgy");
    }
    if path == "src/self_hosted/parser/stmt_loop_owner.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/parser/stmt_owner.pgy");
    }
    if path == "src/self_hosted/parser/stmt_match_owner.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/parser/stmt_owner.pgy");
    }
    if path == "src/self_hosted/parser/stmt_parallel_owner.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/parser/stmt_owner.pgy");
    }
    if path == "src/self_hosted/codegen/text/expr_scan.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/codegen/emission/expr_rewrite.pgy");
    }
    return CompilerCompletenessCheckTarget(path);
}

func EmitCompilerCompletenessSemanticTargets() -> Void {
    let rows: Array<String> = CompilerCompletenessSourceInventory();
    let i: Int = 0;
    while i < ArrayLength(rows) {
        let path: String = rows[i];
        let target: CompilerCompletenessCheckTarget = CompilerCompletenessSemanticCheckTarget(path);
        Log(Concat(path, Concat("\t", target.path)));
        i = i + 1;
    }
}

func CompilerCompletenessSourceMin() -> Int {
    return 195;
}

func CompilerCompletenessLexerPassMin() -> Int {
    return 195;
}

func CompilerCompletenessParserPassMin() -> Int {
    return 195;
}

func CompilerCompletenessSemanticPassMin() -> Int {
    return 195;
}

func CompilerCompletenessCodegenPassMin() -> Int {
    return 195;
}

func CompilerCompletenessLexParsePassMin() -> Int {
    return 195;
}

func CompilerCompletenessLexParseSemanticPassMin() -> Int {
    return 195;
}

func CompilerCompletenessFullPipelinePassMin() -> Int {
    return 195;
}

func EmitCompilerCompletenessLexParseBaseline() -> Void {
    EmitCompilerCompletenessSourceInventory();
}

func EmitCompilerCompletenessLexParseSemanticBaseline() -> Void {
    EmitCompilerCompletenessSourceInventory();
}

func EmitCompilerCompletenessFullPipelineBaseline() -> Void {
    EmitCompilerCompletenessSourceInventory();
}

func EmitCompilerCompletenessBaseline() -> Void {
    Log(Concat("schema=", CompilerCompletenessLedgerSchema()));
    Log(Concat("source_min=", ToString(CompilerCompletenessSourceMin())));
    Log(Concat("lexer_pass_min=", ToString(CompilerCompletenessLexerPassMin())));
    Log(Concat("parser_pass_min=", ToString(CompilerCompletenessParserPassMin())));
    Log(Concat("semantic_pass_min=", ToString(CompilerCompletenessSemanticPassMin())));
    Log(Concat("codegen_pass_min=", ToString(CompilerCompletenessCodegenPassMin())));
    Log(Concat("lex_parse_pass_min=", ToString(CompilerCompletenessLexParsePassMin())));
    Log(Concat("lex_parse_semantic_pass_min=", ToString(CompilerCompletenessLexParseSemanticPassMin())));
    Log(Concat("full_pipeline_pass_min=", ToString(CompilerCompletenessFullPipelinePassMin())));
}

func CompilerCompletenessLedgerReady() -> Bool {
    return CompilerCompletenessStageCount() == 4 &&
        CompilerCompletenessStageAt(0) == "lexer" &&
        CompilerCompletenessStageAt(1) == "parser" &&
        CompilerCompletenessStageAt(2) == "semantic" &&
        CompilerCompletenessStageAt(3) == "codegen" &&
        StringLength(CompilerCompletenessLedgerSchema()) > 0 &&
        StringLength(CompilerCompletenessSourceRoot()) > 0 &&
        StringLength(CompilerCompletenessSemanticTargetsSuiteName()) > 0 &&
        StringLength(CompilerCompletenessLexParseBaselineSuiteName()) > 0 &&
        StringLength(CompilerCompletenessLexParseSemanticBaselineSuiteName()) > 0 &&
        StringLength(CompilerCompletenessFullPipelineBaselineSuiteName()) > 0;
}
