// Self-host completeness ledger owner.
//
// Owns the M2 source inventory scope, stage names, and monotone baseline
// minima. Shell runners may execute the rows, but must not redefine them.
import "completeness_impact_owner.pgy";

struct CompilerCompletenessCheckTarget {
    let path: String;
}

func CompilerCompletenessLedgerSchema() -> String {
    return "pgy.selfhost.completeness-ledger.v1";
}

func CompilerCompletenessSourceRoot() -> String {
    return "src/self_hosted";
}

func CompilerCompletenessSourcesSuiteName() -> String {
    return "self-host-completeness-sources";
}

func CompilerCompletenessStagesSuiteName() -> String {
    return "self-host-completeness-stages";
}

func CompilerCompletenessProgramTargetsSuiteName() -> String {
    return "self-host-completeness-program-targets";
}

func CompilerCompletenessBaselineSuiteName() -> String {
    return "self-host-completeness-baseline";
}

func CompilerCompletenessLexParseBaselineSuiteName() -> String {
    return "self-host-completeness-lex-parse-baseline";
}

func CompilerCompletenessLexParseSemanticBaselineSuiteName() -> String {
    return "self-host-completeness-lex-parse-semantic-baseline";
}

func CompilerCompletenessFullPipelineBaselineSuiteName() -> String {
    return "self-host-completeness-full-pipeline-baseline";
}

func CompilerCompletenessIncrementalCacheSchema() -> String {
    return "pgy.selfhost.completeness-cache.v1";
}

func CompilerCompletenessCacheFingerprintCount() -> Int {
    return 8;
}

func CompilerCompletenessSourceSetFingerprint() -> String {
    return "source-set";
}

func CompilerCompletenessStageFingerprint() -> String {
    return "stage";
}

func CompilerCompletenessSourcePathFingerprint() -> String {
    return "source-path";
}

func CompilerCompletenessCheckTargetFingerprint() -> String {
    return "check-target";
}

func CompilerCompletenessToolSourceFingerprint() -> String {
    return "tool-source";
}

func CompilerCompletenessCompilerExecutableFingerprint() -> String {
    return "compiler-executable";
}

func CompilerCompletenessToolExecutableFingerprint() -> String {
    return "tool-executable";
}

func CompilerCompletenessProducerExecutableFingerprint() -> String {
    return "producer-executable";
}

func CompilerCompletenessCacheFingerprintAt(index: Int) -> String {
    if index == 0 { return CompilerCompletenessSourceSetFingerprint(); }
    if index == 1 { return CompilerCompletenessStageFingerprint(); }
    if index == 2 { return CompilerCompletenessSourcePathFingerprint(); }
    if index == 3 { return CompilerCompletenessCheckTargetFingerprint(); }
    if index == 4 { return CompilerCompletenessToolSourceFingerprint(); }
    if index == 5 { return CompilerCompletenessCompilerExecutableFingerprint(); }
    if index == 6 { return CompilerCompletenessToolExecutableFingerprint(); }
    if index == 7 { return CompilerCompletenessProducerExecutableFingerprint(); }
    return "";
}

func CompilerCompletenessCacheFingerprintKnown(fact: String) -> Bool {
    if fact == CompilerCompletenessSourceSetFingerprint() { return true; }
    if fact == CompilerCompletenessStageFingerprint() { return true; }
    if fact == CompilerCompletenessSourcePathFingerprint() { return true; }
    if fact == CompilerCompletenessCheckTargetFingerprint() { return true; }
    if fact == CompilerCompletenessToolSourceFingerprint() { return true; }
    if fact == CompilerCompletenessCompilerExecutableFingerprint() { return true; }
    if fact == CompilerCompletenessToolExecutableFingerprint() { return true; }
    if fact == CompilerCompletenessProducerExecutableFingerprint() { return true; }
    return false;
}

func CompilerCompletenessPathEndsWith(path: String, suffix: String) -> Bool {
    let path_len: Int = StringLength(path);
    let suffix_len: Int = StringLength(suffix);
    if suffix_len > path_len {
        return false;
    }
    return Substring(path, path_len - suffix_len, suffix_len) == suffix;
}

func CompilerCompletenessPathContains(path: String, needle: String) -> Bool {
    return StringIndexOf(path, needle) >= 0;
}

func CompilerCompletenessIsProductionSource(path: String) -> Bool {
    if !CompilerCompletenessPathEndsWith(path, ".pgy") {
        return false;
    }
    if CompilerCompletenessPathContains(path, "/fixture/") {
        return false;
    }
    if CompilerCompletenessPathContains(path, "/expected/") {
        return false;
    }
    if CompilerCompletenessPathContains(path, "_fixture/") {
        return false;
    }
    if CompilerCompletenessPathContains(path, "_expected/") {
        return false;
    }
    if path == "src/self_hosted/tools/linter/fixture.pgy" {
        return false;
    }
    if path == "src/self_hosted/tools/linter/fixture_structural.pgy" {
        return false;
    }
    if CompilerCompletenessPathContains(path, "/tools/") &&
        CompilerCompletenessPathContains(path, "_probe/") &&
        !CompilerCompletenessPathEndsWith(path, "/main.pgy") {
        return false;
    }
    return true;
}

func CompilerCompletenessSourceInventory() -> Array<String> {
    let entries: Array<String> = DirWalk(CompilerCompletenessSourceRoot());
    let rows: Array<String> = [];
    let i: Int = 0;
    while i < ArrayLength(entries) {
        let path: String = entries[i];
        if CompilerCompletenessIsProductionSource(path) {
            ArrayPush(rows, path);
        }
        i = i + 1;
    }
    return rows;
}

func EmitCompilerCompletenessSourceInventory() -> Void {
    let rows: Array<String> = CompilerCompletenessSourceInventory();
    let i: Int = 0;
    while i < ArrayLength(rows) {
        Log(rows[i]);
        i = i + 1;
    }
}

func CompilerCompletenessStageCount() -> Int {
    return 4;
}

func CompilerCompletenessStageAt(index: Int) -> String {
    if index == 0 { return "lexer"; }
    if index == 1 { return "parser"; }
    if index == 2 { return "semantic"; }
    if index == 3 { return "codegen"; }
    return "";
}

func CompilerCompletenessStageKnown(stage: String) -> Bool {
    if stage == "lexer" { return true; }
    if stage == "parser" { return true; }
    if stage == "semantic" { return true; }
    if stage == "codegen" { return true; }
    return false;
}

func EmitCompilerCompletenessStages() -> Void {
    let i: Int = 0;
    while i < CompilerCompletenessStageCount() {
        Log(CompilerCompletenessStageAt(i));
        i = i + 1;
    }
}

func CompilerCompletenessProgramCheckTarget(path: String) -> CompilerCompletenessCheckTarget {
    if path == "src/self_hosted/parser/expr_postfix_owner.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/parser/expr_owner.pgy");
    }
    if path == "src/self_hosted/parser/expr_precedence_owner.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/parser/expr_owner.pgy");
    }
    if path == "src/self_hosted/parser/expr_primary_owner.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/parser/expr_owner.pgy");
    }
    if path == "src/self_hosted/parser/expr_string_owner.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/parser/expr_owner.pgy");
    }
    if path == "src/self_hosted/parser/expression_graph_owner.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/parser/expr_owner.pgy");
    }
    if path == "src/self_hosted/parser/stmt_if_owner.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/parser/stmt_owner.pgy");
    }
    if path == "src/self_hosted/parser/stmt_loop_owner.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/parser/stmt_owner.pgy");
    }
    if path == "src/self_hosted/parser/stmt_match_owner.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/parser/stmt_owner.pgy");
    }
    if path == "src/self_hosted/parser/stmt_parallel_owner.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/parser/stmt_owner.pgy");
    }
    if path == "src/self_hosted/semantic/result_call_type_owner.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/semantic/expr_type_owner.pgy");
    }
    if path == "src/self_hosted/codegen/text/expr_scan.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/codegen/emission/expr_rewrite.pgy");
    }
    if path == "src/self_hosted/codegen/emission/expr_semantic_call_emit_owner.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/codegen/emission/expr_semantic_graph_emit_owner.pgy");
    }
    if path == "src/self_hosted/codegen/emission/expr_semantic_dynamic_ability_call_emit_owner.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/codegen/emission/expr_semantic_graph_emit_owner.pgy");
    }
    if path == "src/self_hosted/codegen/emission/expr_semantic_composite_literal_emit_owner.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/codegen/emission/expr_semantic_graph_emit_owner.pgy");
    }
    if path == "src/self_hosted/codegen/emission/expr_semantic_call_type_owner.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/codegen/emission/expr_semantic_graph_emit_owner.pgy");
    }
    if path == "src/self_hosted/codegen/emission/expr_semantic_type_owner.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/codegen/emission/expr_semantic_graph_emit_owner.pgy");
    }
    return CompilerCompletenessCheckTarget(path);
}

func EmitCompilerCompletenessProgramTargets() -> Void {
    let rows: Array<String> = CompilerCompletenessSourceInventory();
    let i: Int = 0;
    while i < ArrayLength(rows) {
        let path: String = rows[i];
        let target: CompilerCompletenessCheckTarget = CompilerCompletenessProgramCheckTarget(path);
        Log(Concat(path, Concat("\t", target.path)));
        i = i + 1;
    }
}

