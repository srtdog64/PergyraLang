func CompilerCompletenessImpactPlannerToolSourcePath() -> String {
    return "src/self_hosted/tools/completeness_impact_planner/main.pgy";
}

func CompilerCompletenessImpactPlannerExpectedCleanPath() -> String {
    return "src/self_hosted/tools/completeness_impact_planner/expected/clean.json";
}

func CompilerCompletenessImpactPlannerExpectedUnmatchedPath() -> String {
    return "src/self_hosted/tools/completeness_impact_planner/expected/unmatched.json";
}

func CompilerCompletenessImpactPlannerExpectedRunGroupsPath() -> String {
    return "src/self_hosted/tools/completeness_impact_planner/expected/clean.run_groups.tsv";
}

func CompilerCompletenessImpactPlannerPathCount() -> Int {
    return 10;
}

func CompilerCompletenessImpactPlannerPathAt(index: Int) -> String {
    if index == 0 { return CompilerCompletenessImpactPlannerToolSourcePath(); }
    if index == 1 { return CompilerCompletenessImpactPlannerExpectedCleanPath(); }
    if index == 2 { return CompilerCompletenessImpactPlannerExpectedUnmatchedPath(); }
    if index == 3 { return CompilerCompletenessImpactPlannerExpectedRunGroupsPath(); }
    if index == 4 { return "src/self_hosted/compiler/completeness_ledger_owner.pgy"; }
    if index == 5 { return "src/self_hosted/parser/main.pgy"; }
    if index == 6 { return "src/self_hosted/codegen/emission/program_emit.pgy"; }
    if index == 7 { return "src/self_hosted/tools/air_graph_id_uniqueness/main.pgy"; }
    if index == 8 { return "tests/self_hosted_component_contract_smoke.sh"; }
    if index == 9 { return "README.md"; }
    return "";
}

func CompilerCompletenessCacheFingerprintCount() -> Int {
    return 8;
}

func CompilerCompletenessCacheFingerprintAt(index: Int) -> String {
    if index == 0 { return "source-set"; }
    if index == 1 { return "stage"; }
    if index == 2 { return "source-path"; }
    if index == 3 { return "check-target"; }
    if index == 4 { return "tool-source"; }
    if index == 5 { return "compiler-executable"; }
    if index == 6 { return "tool-executable"; }
    if index == 7 { return "producer-executable"; }
    return "";
}

func CompilerCompletenessImpactFieldCount() -> Int {
    return 6;
}

func CompilerCompletenessImpactFieldAt(index: Int) -> String {
    if index == 0 { return "impact_id"; }
    if index == 1 { return "source_pattern"; }
    if index == 2 { return "source_filter_env"; }
    if index == 3 { return "stage_filter_env"; }
    if index == 4 { return "stage_filter_value"; }
    if index == 5 { return "proof_gate"; }
    return "";
}

func CompilerCompletenessImpactSourceFilterEnv() -> String {
    return "PGY_SELFHOST_COMPLETENESS_SOURCES";
}

func CompilerCompletenessImpactStageFilterEnv() -> String {
    return "PGY_SELFHOST_COMPLETENESS_STAGES";
}

func CompilerCompletenessImpactAllStages() -> String {
    return "lexer,parser,semantic,codegen";
}

func CompilerCompletenessImpactRow(
    impact_id: String,
    source_pattern: String,
    source_filter_env: String,
    stage_filter_env: String,
    stage_filter_value: String,
    proof_gate: String
) -> String {
    return Concat(
        impact_id,
        Concat(
            "\t",
            Concat(
                source_pattern,
                Concat(
                    "\t",
                    Concat(
                        source_filter_env,
                        Concat(
                            "\t",
                            Concat(
                                stage_filter_env,
                                Concat(
                                    "\t",
                                    Concat(stage_filter_value, Concat("\t", proof_gate))
                                )
                            )
                        )
                    )
                )
            )
        )
    );
}

func CompilerCompletenessImpactRowCount() -> Int {
    return 5;
}

func CompilerCompletenessImpactProofGateFor(impact_id: String) -> Option<String> {
    if impact_id == "selfhost-production-source" {
        return Some("self-host-completeness-smoke");
    }
    if impact_id == "parser-source" {
        return Some("self-host-parser-parity-test-smoke");
    }
    if impact_id == "codegen-source" {
        return Some("self-host-codegen-parity-test-smoke");
    }
    if impact_id == "air-graph-consumer-source" {
        return Some("self-host-air-graph-consumer-parity-test-smoke");
    }
    if impact_id == "component-contract" {
        return Some("self-host-component-contract-test-smoke");
    }
    return None;
}

func CompilerCompletenessImpactRowAt(index: Int) -> String {
    if index == 0 {
        return CompilerCompletenessImpactRow(
            "selfhost-production-source",
            "src/self_hosted/**/*.pgy",
            CompilerCompletenessImpactSourceFilterEnv(),
            CompilerCompletenessImpactStageFilterEnv(),
            CompilerCompletenessImpactAllStages(),
            "self-host-completeness-smoke"
        );
    }
    if index == 1 {
        return CompilerCompletenessImpactRow(
            "parser-source",
            "src/self_hosted/parser/**/*.pgy",
            CompilerCompletenessImpactSourceFilterEnv(),
            CompilerCompletenessImpactStageFilterEnv(),
            CompilerCompletenessImpactAllStages(),
            "self-host-parser-parity-test-smoke"
        );
    }
    if index == 2 {
        return CompilerCompletenessImpactRow(
            "codegen-source",
            "src/self_hosted/codegen/**/*.pgy",
            CompilerCompletenessImpactSourceFilterEnv(),
            CompilerCompletenessImpactStageFilterEnv(),
            CompilerCompletenessImpactAllStages(),
            "self-host-codegen-parity-test-smoke"
        );
    }
    if index == 3 {
        return CompilerCompletenessImpactRow(
            "air-graph-consumer-source",
            "src/self_hosted/tools/air_graph*/**/*.pgy",
            CompilerCompletenessImpactSourceFilterEnv(),
            CompilerCompletenessImpactStageFilterEnv(),
            CompilerCompletenessImpactAllStages(),
            "self-host-air-graph-consumer-parity-test-smoke"
        );
    }
    if index == 4 {
        return CompilerCompletenessImpactRow(
            "component-contract",
            "tests/self_hosted_component_contract_smoke.sh",
            "-",
            "-",
            "-",
            "self-host-component-contract-test-smoke"
        );
    }
    return "";
}

func EmitCompilerCompletenessImpactPlan() -> Void {
    Log(Concat("schema=", CompilerCompletenessImpactPlanSchema()));
    let i: Int = 0;
    while i < CompilerCompletenessImpactRowCount() {
        Log(CompilerCompletenessImpactRowAt(i));
        i = i + 1;
    }
}

func EmitCompilerCompletenessImpactPlannerPaths() -> Void {
    let i: Int = 0;
    while i < CompilerCompletenessImpactPlannerPathCount() {
        Log(CompilerCompletenessImpactPlannerPathAt(i));
        i = i + 1;
    }
}

func CompilerCompletenessPathEndsWith(path: String, suffix: String) -> Bool {
    let path_len: Int = StringLength(path);
    let suffix_len: Int = StringLength(suffix);
    if suffix_len > path_len {
        return false;
    }
    return Substring(path, path_len - suffix_len, suffix_len) == suffix;
}

func CompilerCompletenessPathContains(path: String, needle: String) -> Bool {
    return StringIndexOf(path, needle) >= 0;
}

func CompilerCompletenessIsProductionSource(path: String) -> Bool {
    if !CompilerCompletenessPathEndsWith(path, ".pgy") {
        return false;
    }
    if CompilerCompletenessPathContains(path, "/fixture/") {
        return false;
    }
    if CompilerCompletenessPathContains(path, "/expected/") {
        return false;
    }
    if path == "src/self_hosted/tools/linter/fixture.pgy" {
        return false;
    }
    if path == "src/self_hosted/tools/linter/fixture_structural.pgy" {
        return false;
    }
    return true;
}

func CompilerCompletenessSourceInventory() -> Array<String> {
    let entries: Array<String> = DirWalk(CompilerCompletenessSourceRoot());
    let rows: Array<String> = [];
    let i: Int = 0;
    while i < ArrayLength(entries) {
        let path: String = entries[i];
        if CompilerCompletenessIsProductionSource(path) {
            ArrayPush(rows, path);
        }
        i = i + 1;
    }
    return rows;
}

func EmitCompilerCompletenessSourceInventory() -> Void {
    let rows: Array<String> = CompilerCompletenessSourceInventory();
    let i: Int = 0;
    while i < ArrayLength(rows) {
        Log(rows[i]);
        i = i + 1;
    }
}

func CompilerCompletenessStageCount() -> Int {
    return 4;
}

func CompilerCompletenessStageAt(index: Int) -> String {
    if index == 0 { return "lexer"; }
    if index == 1 { return "parser"; }
    if index == 2 { return "semantic"; }
    if index == 3 { return "codegen"; }
    return "";
}

func EmitCompilerCompletenessStages() -> Void {
    let i: Int = 0;
    while i < CompilerCompletenessStageCount() {
        Log(CompilerCompletenessStageAt(i));
        i = i + 1;
    }
}

func CompilerCompletenessSemanticCheckTarget(path: String) -> CompilerCompletenessCheckTarget {
    if path == "src/self_hosted/parser/expr_postfix_owner.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/parser/expr_owner.pgy");
    }
    if path == "src/self_hosted/parser/expr_precedence_owner.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/parser/expr_owner.pgy");
    }
    if path == "src/self_hosted/parser/expr_primary_owner.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/parser/expr_owner.pgy");
    }
    if path == "src/self_hosted/parser/expr_string_owner.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/parser/expr_owner.pgy");
    }
    if path == "src/self_hosted/parser/stmt_if_owner.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/parser/stmt_owner.pgy");
    }
    if path == "src/self_hosted/parser/stmt_loop_owner.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/parser/stmt_owner.pgy");
    }
    if path == "src/self_hosted/parser/stmt_match_owner.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/parser/stmt_owner.pgy");
    }
    if path == "src/self_hosted/parser/stmt_parallel_owner.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/parser/stmt_owner.pgy");
    }
    if path == "src/self_hosted/codegen/text/expr_scan.pgy" {
        return CompilerCompletenessCheckTarget("src/self_hosted/codegen/emission/expr_rewrite.pgy");
    }
    return CompilerCompletenessCheckTarget(path);
}

func EmitCompilerCompletenessSemanticTargets() -> Void {
    let rows: Array<String> = CompilerCompletenessSourceInventory();
    let i: Int = 0;
    while i < ArrayLength(rows) {
        let path: String = rows[i];
        let target: CompilerCompletenessCheckTarget = CompilerCompletenessSemanticCheckTarget(path);
        Log(Concat(path, Concat("\t", target.path)));
        i = i + 1;
    }
}

