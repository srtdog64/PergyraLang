func EmitCompilerCompletenessBaseline() -> Void {
    Log(Concat("schema=", CompilerCompletenessLedgerSchema()));
    Log(Concat("source_min=", ToString(CompilerCompletenessSourceMin())));
    Log(Concat("lexer_pass_min=", ToString(CompilerCompletenessLexerPassMin())));
    Log(Concat("parser_pass_min=", ToString(CompilerCompletenessParserPassMin())));
    Log(Concat("semantic_pass_min=", ToString(CompilerCompletenessSemanticPassMin())));
    Log(Concat("codegen_pass_min=", ToString(CompilerCompletenessCodegenPassMin())));
    Log(Concat("lex_parse_pass_min=", ToString(CompilerCompletenessLexParsePassMin())));
    Log(Concat("lex_parse_semantic_pass_min=", ToString(CompilerCompletenessLexParseSemanticPassMin())));
    Log(Concat("full_pipeline_pass_min=", ToString(CompilerCompletenessFullPipelinePassMin())));
}

func CompilerCompletenessLedgerReady() -> Bool {
    return CompilerCompletenessStageCount() == 4 &&
        CompilerCompletenessStageAt(0) == "lexer" &&
        CompilerCompletenessStageAt(1) == "parser" &&
        CompilerCompletenessStageAt(2) == "semantic" &&
        CompilerCompletenessStageAt(3) == "codegen" &&
        StringLength(CompilerCompletenessLedgerSchema()) > 0 &&
        StringLength(CompilerCompletenessSourceRoot()) > 0 &&
        StringLength(CompilerCompletenessSemanticTargetsSuiteName()) > 0 &&
        StringLength(CompilerCompletenessLexParseBaselineSuiteName()) > 0 &&
        StringLength(CompilerCompletenessLexParseSemanticBaselineSuiteName()) > 0 &&
        StringLength(CompilerCompletenessFullPipelineBaselineSuiteName()) > 0 &&
        StringLength(CompilerCompletenessIncrementalCacheSchema()) > 0 &&
        StringLength(CompilerCompletenessImpactPlanSchema()) > 0 &&
        StringLength(CompilerCompletenessImpactRunGroupsSchema()) > 0 &&
        StringLength(CompilerCompletenessImpactSuiteName()) > 0 &&
        StringLength(CompilerCompletenessImpactPlannerSuiteName()) > 0 &&
        CompilerCompletenessImpactPlannerPathCount() == 10 &&
        CompilerCompletenessImpactPlannerPathAt(0) == CompilerCompletenessImpactPlannerToolSourcePath() &&
        CompilerCompletenessImpactPlannerPathAt(3) == CompilerCompletenessImpactPlannerExpectedRunGroupsPath() &&
        CompilerCompletenessCacheFingerprintCount() == 8 &&
        CompilerCompletenessCacheFingerprintAt(0) == "source-set" &&
        CompilerCompletenessCacheFingerprintAt(5) == "compiler-executable" &&
        CompilerCompletenessCacheFingerprintAt(6) == "tool-executable" &&
        CompilerCompletenessImpactFieldCount() == 6 &&
        CompilerCompletenessImpactFieldAt(0) == "impact_id" &&
        CompilerCompletenessImpactFieldAt(5) == "proof_gate" &&
        CompilerCompletenessImpactRowCount() == 5 &&
        CompilerCompletenessImpactSourceFilterEnv() == "PGY_SELFHOST_COMPLETENESS_SOURCES" &&
        CompilerCompletenessImpactStageFilterEnv() == "PGY_SELFHOST_COMPLETENESS_STAGES" &&
        CompilerCompletenessImpactAllStages() == "lexer,parser,semantic,codegen" &&
        IsSome(CompilerCompletenessImpactProofGateFor("selfhost-production-source")) &&
        IsSome(CompilerCompletenessImpactProofGateFor("parser-source")) &&
        IsSome(CompilerCompletenessImpactProofGateFor("codegen-source")) &&
        IsSome(CompilerCompletenessImpactProofGateFor("air-graph-consumer-source")) &&
        IsSome(CompilerCompletenessImpactProofGateFor("component-contract")) &&
        !IsSome(CompilerCompletenessImpactProofGateFor("unknown-impact"));
}
