// Canonical captured Array<Bool> ABI receipt.

import "../abi_layout_row_owner.pgy";
import "direct_mir_array_captured_abi_fact_owner.pgy";

func DirectMirArrayBoolCanonicalAbi() -> MirAbiLayoutRowCapture {
    return DirectMirArrayCanonicalAbiRow(
        CompilerAbiLayoutArrayBoolTypeName(), "pgy_array_new_Bool", "bool"
    );
}

func DirectMirArrayBoolCapturedAbiReady(
    ref abi: MirAbiLayoutRowCapture
) -> Bool {
    let canonical: MirAbiLayoutRowCapture = DirectMirArrayBoolCanonicalAbi();
    return DirectMirArrayCapturedAbiMatches(abi, canonical);
}
