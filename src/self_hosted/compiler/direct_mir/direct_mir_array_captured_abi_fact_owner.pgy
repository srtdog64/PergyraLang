// Shared four-field array layout admission; element identity stays explicit.

import "../../mir_lower/abi_layout_admission_fact_owner.pgy";
import "direct_mir_array_storage_layout_contract_owner.pgy";
import "direct_mir_nominal_abi_row_identity_owner.pgy";

// The canonical ABI row of an Array<T>: the storage layout contract's four
// one-word fields (target profile) with the element's runtime constructor
// and C element type. A captured MIR row is admitted only when it equals
// this row; an invalid contract yields an invalid row, which admits none.
func DirectMirArrayCanonicalAbiRow(
    type_name: String, runtime_fn: String, inner_c_type: String
) -> MirAbiLayoutRowCapture {
    let layout: DirectMirArrayStorageLayoutContract = DirectMirArrayStorageLayoutContractFact();
    if !DirectMirArrayStorageLayoutContractReady(layout) { return InvalidMirAbiLayoutRowCapture(); }
    let word: String = ToString(layout.align);
    let names: Array<String> = [layout.data_field, layout.length_field,
        layout.capacity_field, layout.allocator_field];
    let offsets: Array<String> = [ToString(layout.data_offset), ToString(layout.length_offset),
        ToString(layout.capacity_offset), ToString(layout.allocator_offset)];
    let sizes: Array<String> = [word, word, word, word];
    let aligns: Array<String> = [word, word, word, word];
    return MirAbiLayoutRowCapture(true, type_name, ToString(layout.size), word,
        names, offsets, sizes, aligns, runtime_fn, inner_c_type, "0", "", "0", "0", "");
}

func DirectMirArrayCapturedAbiMatches(
    ref abi: MirAbiLayoutRowCapture, ref canonical: MirAbiLayoutRowCapture
) -> Bool {
    let identity: String = DirectMirAbiRowIdentityText(canonical);
    return abi.valid && canonical.valid && identity != "" &&
        DirectMirAbiRowIdentityText(abi) == identity;
}
