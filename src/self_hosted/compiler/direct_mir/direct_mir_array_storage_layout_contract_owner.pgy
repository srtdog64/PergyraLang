// Public language Array storage layout consumed by direct-MIR projections.
// Call classification is deliberately owned by a separate call-ABI fact.

import "../target_capability_owner.pgy";

struct DirectMirArrayStorageLayoutContract {
    let valid: Bool;
    let size: Int;
    let align: Int;
    let data_layout_id: String;
    let field_order: String;
    let data_field: String;
    let length_field: String;
    let capacity_field: String;
    let allocator_field: String;
    let c_length_type: String;
    let llvm_aggregate_type: String;
    let data_offset: Int;
    let length_offset: Int;
    let capacity_offset: Int;
    let allocator_offset: Int;
}

// The four fields are a pointer, two size_t words and a pointer, one word
// each, laid out from the target profile's pointer width and alignment
// (target.capability_profile). The runtime is built for 64-bit
// little-endian targets only; a profile whose rows share another layout
// yields an invalid contract, which every consumer refuses.
func DirectMirArrayStorageLayoutWordBytes() -> Int {
    let bits: Int = CompilerTargetProfileSharedPointerBits();
    if bits != 64 || CompilerTargetProfileSharedPointerAlign() != bits / 8 ||
        !CompilerTargetProfileSharedLittleEndian() {
        return 0;
    }
    return bits / 8;
}

func DirectMirArrayStorageLayoutContractFact(
) -> DirectMirArrayStorageLayoutContract {
    let word: Int = DirectMirArrayStorageLayoutWordBytes();
    let bits: String = ToString(word * 8);
    return DirectMirArrayStorageLayoutContract(
        word > 0, 4 * word, word,
        Concat("pgy.runtime.pointer", Concat(bits, Concat("-size_t", Concat(bits, ".v1")))),
        "data,length,capacity,allocator", "data", "length", "capacity",
        "allocator", "size_t",
        Concat("{ ptr, i", Concat(bits, Concat(", i", Concat(bits, ", ptr }")))),
        0, word, 2 * word, 3 * word
    );
}

func DirectMirArrayStorageLayoutContractReady(
    ref contract: DirectMirArrayStorageLayoutContract
) -> Bool {
    let word: Int = DirectMirArrayStorageLayoutWordBytes();
    let bits: String = ToString(word * 8);
    return word > 0 && contract.valid && contract.size == 4 * word && contract.align == word &&
        contract.data_layout_id == Concat("pgy.runtime.pointer", Concat(bits, Concat("-size_t", Concat(bits, ".v1")))) &&
        contract.field_order == "data,length,capacity,allocator" &&
        contract.data_field == "data" && contract.length_field == "length" &&
        contract.capacity_field == "capacity" &&
        contract.allocator_field == "allocator" &&
        contract.c_length_type == "size_t" &&
        contract.llvm_aggregate_type == Concat("{ ptr, i", Concat(bits, Concat(", i", Concat(bits, ", ptr }")))) &&
        contract.data_offset == 0 && contract.length_offset == word &&
        contract.capacity_offset == 2 * word && contract.allocator_offset == 3 * word;
}

func DirectMirArrayStorageLayoutIndex(
    ref contract: DirectMirArrayStorageLayoutContract, offset: Int
) -> Int {
    if !DirectMirArrayStorageLayoutContractReady(contract) ||
        offset < 0 || offset % contract.align != 0 {
        return 0 - 1;
    }
    return offset / contract.align;
}
