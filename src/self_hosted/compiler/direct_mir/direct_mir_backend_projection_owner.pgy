// Backend-neutral orchestration from machine-admitted MIR facts to one target artifact.

import "../driver/driver_pipeline_owner.pgy";
import "../target_projection_fact_owner.pgy";
import "direct_mir_compile_time_declaration_erasure_owner.pgy";
import "direct_mir_literal_log_plan_owner.pgy";
import "direct_mir_literal_log_emission_owner.pgy";
import "direct_mir_multi_routine_projection_owner.pgy";
import "scalar_program/direct_mir_scalar_program_projection_owner.pgy";
import "scalar_program/direct_mir_scalar_program_route_admission_owner.pgy";
import "../runtime_call_abi_structured_fact_owner.pgy";
import "../abi_layout_row_owner.pgy";
import "../domain_topology_graph_plan_consumer_owner.pgy";
import "direct_mir_pressure_observation_owner.pgy";
import "../../mir_lower/mir_json_input_owner.pgy";
import "../../mir_lower/generic_instance_plan_owner.pgy";

func CompileAdmittedDirectMirForTargetObserved(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    target_projection: CompilerTargetProjectionFact,
    observe_pressure: Bool
) -> CompilerEmissionOutcome {
    let is_c: Bool = CompilerTargetProjectionFactReadyFor(
        target_projection, CompilerTargetCpuCProjection()
    );
    let is_llvm: Bool = CompilerTargetProjectionFactReadyFor(
        target_projection, CompilerTargetCpuLlvmProjection()
    );
    if !is_c && !is_llvm {
        Die("direct MIR backend projection rejected the target fact");
    }
    let generic_calls: MirGenericCallOccurrenceIndex =
        MirGenericCallOccurrenceIndexFromDocument(admitted.document, admitted.routines);
    if !generic_calls.valid {
        Die("MIR generic call occurrences are missing or invalid");
    }
    let generic_instances: GenericInstanceClosure = MirGenericInstanceClosureFromOccurrences(generic_calls);
    if !generic_instances.valid { Die(generic_instances.diagnostic); }
    var kind: String = "emitted-c";
    if is_llvm { kind = "emitted_llvm"; }
    var payload: String = "";
    let routine_count: Int = MirProgramRoutineIndexCount(admitted.routines);
    if routine_count > 1 {
        let routed: CodegenRoutePayload = CompileAdmittedDirectMirMultiRoutineForTargetObserved(
            admitted, target_projection, observe_pressure, generic_calls, generic_instances);
        match routed {
            case CodegenRoutePayloadEmitted(text): payload = text;
            case CodegenRoutePayloadRefused(refusal): return CompilerEmissionRouteRefused(refusal);
        }
    } else if routine_count == 1 {
        let literal_log_route: Bool =
            DirectMirLiteralLogRouteClaimed(admitted);
        let scalar_program_admission:
            DirectMirScalarProgramRouteAdmission =
                DirectMirScalarProgramRouteAdmissionFromAdmitted(
                    admitted, generic_calls, generic_instances);
        if !DirectMirScalarProgramRouteAdmissionReady(
                scalar_program_admission) {
            Die("direct MIR scalar program route admission receipt is invalid");
        }
        if DirectMirScalarProgramRouteAdmissionEndsDispatch(scalar_program_admission) { return CompilerEmissionRouteRefused(
            DirectMirScalarProgramRouteAdmissionRefusal(scalar_program_admission)); }
        let scalar_program_route: DirectMirScalarProgramRouteFact =
            scalar_program_admission.route;
        // Runtime-bearing declarations already have an owned record/enum or
        // identity-cell (subject, vessel) receipt; they must not enter
        // compile-time-only erasure.
        let runtime_declaration_route: Bool =
            scalar_program_route.claimed &&
            (scalar_program_route.referenced_enum.payload_present ||
             scalar_program_route.logical_record.present ||
             ArrayLength(scalar_program_route.logical_record.identity_cells.names) > 0);
        if runtime_declaration_route {
            let scalar_payload: CodegenRoutePayload =
                CompileAdmittedDirectMirScalarProgramForTarget(
                    admitted, scalar_program_route, target_projection);
            match scalar_payload {
                case CodegenRoutePayloadEmitted(text): payload = text;
                case CodegenRoutePayloadRefused(refusal): return CompilerEmissionRouteRefused(refusal);
            }
        } else if DirectMirCompileTimeDeclarationErasureRouteClaimed(
                admitted) || literal_log_route {
            let literal_log: DirectMirLiteralLogPlan =
                DirectMirLiteralLogPlanFromAdmitted(admitted);
            if is_llvm {
                payload = DirectMirLiteralLogEmitLlvm(literal_log);
            } else {
                payload = DirectMirLiteralLogEmitC(
                    literal_log, CompilerAbiLayoutIntCValueType()
                );
            }
        } else if scalar_program_route.claimed {
            let scalar_payload: CodegenRoutePayload =
                CompileAdmittedDirectMirScalarProgramForTarget(
                    admitted, scalar_program_route, target_projection);
            match scalar_payload {
                case CodegenRoutePayloadEmitted(text): payload = text;
                case CodegenRoutePayloadRefused(refusal): return CompilerEmissionRouteRefused(refusal);
            }
        } else {
            return CompilerEmissionRouteRefused(DirectMirScalarProgramRouteAdmissionRefusal(
                scalar_program_admission));
        }
    } else {
        Die("direct MIR backend projection rejected missing routines");
    }
    if is_llvm {
        payload = MirDomainTopologyGraphPlanAttachAdmittedToLlvm(
            admitted, payload
        );
    } else {
        payload = MirDomainTopologyGraphPlanAttachAdmittedToC(
            admitted, payload
        );
    }
    let artifact: CompilerEmissionArtifact = CompilerEmissionArtifact(
        kind,
        payload,
        target_projection.schema,
        target_projection.projection,
        target_projection.target_capability_fingerprint
    );
    if !CompilerEmissionArtifactReady(artifact) {
        Die("direct MIR backend emission artifact fingerprint is missing or invalid");
    }
    return CompilerEmissionProduced(artifact);
}

func CompileMirJsonToDirectBackendVerified(
    mir_json_path: String,
    machine_declaration: SelfHostMachineLayerDeclaration,
    target_projection: CompilerTargetProjectionFact
) -> CompilerEmissionOutcome with caps io_read {
    return CompileMirJsonToDirectBackendVerifiedObserved(
        mir_json_path, machine_declaration, target_projection, false
    );
}

func CompileMirJsonTextToDirectBackendVerifiedObserved(
    mir_json: String,
    machine_declaration: SelfHostMachineLayerDeclaration,
    target_projection: CompilerTargetProjectionFact,
    observe_pressure: Bool
) -> CompilerEmissionOutcome {
    DirectMirPressureStage(observe_pressure, "input:start");
    let admitted_opt: Option<MirMachineLayerAdmittedJsonInput> =
        MirMachineLayerAdmitJsonInput(mir_json, machine_declaration);
    if !IsSome(admitted_opt) {
        Die("direct MIR backend projection rejected invalid in-memory MIR facts");
    }
    DirectMirPressureStage(observe_pressure, "input:done");
    DirectMirPressureStage(observe_pressure, "projection:start");
    let admitted: MirMachineLayerAdmittedJsonInput =
        UnwrapOption(admitted_opt);
    let emission: CompilerEmissionOutcome =
        CompileAdmittedDirectMirForTargetObserved(
            admitted, target_projection, observe_pressure
        );
    DirectMirPressureStage(observe_pressure, "projection:done");
    return emission;
}

func CompileMirJsonToDirectBackendVerifiedObserved(
    mir_json_path: String,
    machine_declaration: SelfHostMachineLayerDeclaration,
    target_projection: CompilerTargetProjectionFact,
    observe_pressure: Bool
) -> CompilerEmissionOutcome with caps io_read {
    DirectMirPressureStage(observe_pressure, "input:start");
    let admitted: MirMachineLayerAdmittedJsonInput =
        MirJsonReadMachineAdmittedInput(
            mir_json_path, machine_declaration
        );
    DirectMirPressureStage(observe_pressure, "input:done");
    DirectMirPressureStage(observe_pressure, "projection:start");
    let emission: CompilerEmissionOutcome =
        CompileAdmittedDirectMirForTargetObserved(
            admitted, target_projection, observe_pressure
        );
    DirectMirPressureStage(observe_pressure, "projection:done");
    return emission;
}
