// Projection into the existing internal single-Int value-class fact.

import "direct_mir_constructed_generic_member_method_instruction_owner.pgy";
import "direct_mir_constructed_generic_member_main_instruction_owner.pgy";
import "direct_mir_inferred_generic_member_representation_fact_owner.pgy";

func DirectMirConstructedGenericMemberRepresentationFromProgram(
    ref identity: DirectMirConstructedGenericMemberProgramIdentity,
    ref methods: DirectMirConstructedGenericMemberMethodInstructions,
    ref main: DirectMirConstructedGenericMemberMainInstructions
) -> DirectMirInferredGenericMemberRepresentationFact {
    if !DirectMirConstructedGenericMemberProgramIdentityReady(identity) ||
        !DirectMirConstructedGenericMemberMethodInstructionsReady(methods) ||
        !DirectMirConstructedGenericMemberMainInstructionsReady(main) ||
        identity.constructed_method.receiver_carriage != "value" ||
        identity.identity_method.receiver_carriage != "value" ||
        main.constructor.abi_layout_id_start < 0 ||
        main.constructor.abi_layout_required_start < 0 ||
        main.constructor.abi_layout_start < 0 {
        Die("direct MIR constructed member representation input is invalid");
    }
    let fact: DirectMirInferredGenericMemberRepresentationFact =
        DirectMirInferredGenericMemberRepresentationFact(
            true, 0, identity.declaration.name,
            identity.declaration.field_name, identity.declaration.field_type,
            DirectMirInferredGenericMemberRepresentation(), "value"
        );
    let verified: DirectMirInferredGenericMemberRepresentationFact =
        DirectMirInferredGenericMemberRepresentationFact(
            fact.valid,
            DirectMirInferredGenericMemberRepresentationFactDigest(fact),
            fact.type_name, fact.field_name, fact.field_type,
            fact.representation, fact.receiver_carriage
        );
    if !DirectMirInferredGenericMemberRepresentationFactReady(verified) {
        Die("direct MIR constructed member representation fact is invalid");
    }
    return verified;
}
