// Resolve one carried method SyntaxNodeId, then prepend its typed receiver.
// Value receivers join the passive-record declaration row; mutable receivers
// join the identity-cell row. Selector spelling confirms an owned target but
// never selects the routine.
import "scalar_program/direct_mir_scalar_program_callable_inventory_owner.pgy";
import "scalar_program/direct_mir_scalar_program_builtin_argument_chain_owner.pgy";
import "scalar_program/direct_mir_scalar_program_direct_call_fact_owner.pgy";
import "scalar_program/direct_mir_scalar_program_logical_record_fact_owner.pgy";

func DirectMirMemberCallFromGraph(
    ref sequence: MirExpressionGraphSequence, call: Int,
    ref source_rows: Array<Int>, ref types: Array<String>,
    arguments: Array<Int>,
    ref callables: DirectMirScalarCfgProgramCallableInventory,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    ref routine_instances: DirectMirRoutineInstanceInventory
) -> DirectMirScalarProgramDirectCallFact {
    let invalid: DirectMirScalarProgramDirectCallFact =
        DirectMirScalarProgramDirectCallFactInvalid(true);
    if !DirectMirScalarProgramMemberCallMarkerReady(sequence, call) {
        return invalid;
    }
    let ordinal: Int = DirectMirScalarProgramCallableOrdinalAtCall(
        callables, sequence, call);
    if !DirectMirScalarCfgProgramCallableInventoryOrdinalReady(
            callables, ordinal) {
        return invalid;
    }
    let signature: DirectMirRoutineSignatureFact =
        DirectMirRoutineInstanceSignatureAt(routine_instances, ordinal);
    if !DirectMirRoutineSignatureFactReady(signature) ||
        signature.kind != "method" {
        return invalid;
    }
    let callee: Int = DirectMirScalarProgramCallCalleeBase(sequence, call);
    let receiver: Int = sequence.arena.topology.left_children[callee];
    let member: Int = sequence.arena.topology.right_children[callee];
    // MIR producers retain either the local display name or its qualified
    // projection. Neither can override the already-joined source identity.
    if receiver >= ArrayLength(source_rows) || source_rows[receiver] < 0 ||
        source_rows[receiver] >= ArrayLength(types) ||
        types[source_rows[receiver]] != signature.receiver_type ||
        sequence.arena.node_texts[member] !=
            callables.source_names[ordinal - 1] ||
        (sequence.arena.call_target_names[call] != signature.name &&
         sequence.arena.call_target_names[call] !=
            callables.source_names[ordinal - 1]) {
        return invalid;
    }
    if signature.receiver_carriage == CallableReceiverCarriageValue() {
        let record: Int = DirectMirScalarProgramLogicalRecordRow(
            logical_record, signature.receiver_type);
        if record < 0 || logical_record.declaration_rows[record] !=
                signature.receiver_owner_row {
            return invalid;
        }
    } else if signature.receiver_carriage ==
            CallableReceiverCarriageMutableIdentity() {
        let cell: Int = DirectMirIdentityCellRow(
            routine_instances.identity_cells, signature.receiver_type);
        if cell < 0 ||
            routine_instances.identity_cells.declaration_rows[cell] !=
                signature.receiver_owner_row {
            return invalid;
        }
    } else {
        return invalid;
    }
    var rows: Array<Int> = [source_rows[receiver]];
    var argument: Int = 0;
    while argument < ArrayLength(arguments) {
        let value: Int = arguments[argument];
        let parameter: Int = argument + 1;
        if parameter >= signature.param_count || value < 0 ||
            value >= ArrayLength(types) ||
            types[value] != signature.parameters.type_names[parameter] ||
            signature.parameters.carriages[parameter] != "value" {
            return invalid;
        }
        ArrayPush(rows, value);
        argument = argument + 1;
    }
    return DirectMirScalarProgramDirectCallFact(
        true, true, ArrayLength(rows) == signature.param_count,
        rows, call, ordinal, -1, signature.return_type);
}
