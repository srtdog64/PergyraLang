// Exclusive multi-routine projection; rejected shapes are never reinterpreted.
import "direct_mir_legacy_intent_program_projection_owner.pgy";
import "direct_mir_composite_intent_program_projection_owner.pgy";
import "direct_mir_nested_intent_program_projection_owner.pgy";
import "scalar_program/direct_mir_scalar_program_projection_owner.pgy";
import "scalar_program/direct_mir_scalar_program_route_admission_owner.pgy";
import "direct_mir_pressure_observation_owner.pgy";
func CompileAdmittedDirectMirMultiRoutineForTarget(
    ref admitted: MirMachineLayerAdmittedJsonInput, target_projection: CompilerTargetProjectionFact) -> CodegenRoutePayload {
    let calls: MirGenericCallOccurrenceIndex = MirGenericCallOccurrenceIndexFromDocument(admitted.document, admitted.routines);
    if !calls.valid { Die("MIR generic call occurrences are missing or invalid"); }
    let instances: GenericInstanceClosure = MirGenericInstanceClosureFromOccurrences(calls);
    if !instances.valid { Die(instances.diagnostic); }
    return CompileAdmittedDirectMirMultiRoutineForTargetObserved(admitted, target_projection, false, calls, instances);
}
func CompileAdmittedDirectMirMultiRoutineForTargetObserved(
    ref admitted: MirMachineLayerAdmittedJsonInput, target_projection: CompilerTargetProjectionFact,
    observe_pressure: Bool, generic_calls: MirGenericCallOccurrenceIndex,
    generic_instances: GenericInstanceClosure) -> CodegenRoutePayload {
    let is_c: Bool = CompilerTargetProjectionFactReadyFor(
        target_projection, CompilerTargetCpuCProjection());
    let is_llvm: Bool = CompilerTargetProjectionFactReadyFor(
        target_projection, CompilerTargetCpuLlvmProjection());
    if !is_c && !is_llvm { Die("direct MIR multi-routine projection rejected the program graph"); }
    let intent_payload: Option<String> = CompileAdmittedDirectMirLegacyIntentProgramLlvmIfClaimed(admitted, is_llvm);
    if IsSome(intent_payload) { return CodegenRoutePayloadEmitted(UnwrapOption(intent_payload)); }
    let composite_intent_payload: Option<String> = CompileAdmittedDirectMirCompositeIntentProgramLlvmIfClaimed(admitted, is_llvm);
    if IsSome(composite_intent_payload) { return CodegenRoutePayloadEmitted(UnwrapOption(composite_intent_payload)); }
    let nested_intent_payload: Option<String> = CompileAdmittedDirectMirNestedIntentProgramForTargetIfClaimed(admitted, target_projection);
    if IsSome(nested_intent_payload) { return CodegenRoutePayloadEmitted(UnwrapOption(nested_intent_payload)); }
    DirectMirPressureStage(observe_pressure, "scalar-route:start");
    let scalar_program_admission: DirectMirScalarProgramRouteAdmission =
        DirectMirScalarProgramRouteAdmissionFromAdmitted(admitted, generic_calls, generic_instances);
    if !DirectMirScalarProgramRouteAdmissionReady(scalar_program_admission) {
        Die("direct MIR scalar program route admission receipt is invalid");
    }
    if DirectMirScalarProgramRouteAdmissionEndsDispatch(scalar_program_admission) { return CodegenRoutePayloadRefused(
        DirectMirScalarProgramRouteAdmissionRefusal(scalar_program_admission)); }
    DirectMirPressureStage(observe_pressure, "scalar-route:done");
    let scalar_program_route: DirectMirScalarProgramRouteFact = scalar_program_admission.route;
    if scalar_program_route.claimed {
        return CompileAdmittedDirectMirScalarProgramForTargetObserved(
            admitted, scalar_program_route, target_projection,
            observe_pressure
        );
    }
    // The general route declined the program: it is refused with the
    // general route's receipt. No per-program-shape route follows it.
    return CodegenRoutePayloadRefused(DirectMirScalarProgramRouteAdmissionRefusal(scalar_program_admission));
}
