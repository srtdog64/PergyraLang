// Bare receiver-field names inside a method of a mutable-identity receiver.
// MIR carries `value = value + 1` in such a method as an owner-field SSA
// variable: an `owner_field` definition, the entry value `value.0` and phis
// at joins, while a read before any such definition has no use at all. The
// general route keeps no local for it. A read is the receiver cell's member
// and a definition stores into that member (the identity-cell store), so
// every read sees the cell's current value, as native code does. A name the
// routine binds as a local or parameter resolves to that binding first.
import "direct_mir_identity_cell_fact_owner.pgy";
import "direct_mir_routine_signature_schema_owner.pgy";
import "scalar_cfg/direct_mir_scalar_cfg_expression_base_owner.pgy";
import "../../mir_lower/routine_fact_index_schema_owner.pgy";
import "../../mir_lower/ssa_identity_owner.pgy";
import "../../mir_lower/routine_instruction_use_fact_owner.pgy";
import "../../mir_lower/expression_graph_sequence_owner.pgy";
import "../../semantic/ast_expression/ast_expression_identity_fact_owner.pgy";

// The variables MIR carries as owner-field SSA variables in one routine:
// the `arg0` of each `owner_field` definition, once each.
func DirectMirReceiverFieldVariableNames(ref index: MirRoutineFactIndex) -> Array<String> {
    var names: Array<String> = [];
    var instruction: Int = 0;
    while instruction < ArrayLength(index.instruction_facts.starts) {
        if index.instruction_facts.arg1s[instruction] == "owner_field" &&
            DirectMirScalarCfgGraphValueRow(names, index.instruction_facts.arg0s[instruction]) < 0 {
            ArrayPushOwnedString(names, Concat("", index.instruction_facts.arg0s[instruction]));
        }
        instruction = instruction + 1;
    }
    return names;
}

// A definition or phi of an owner-field variable. It gets no local, and its
// phi no operation; a definition becomes the identity-cell store.
func DirectMirReceiverFieldVariableInstruction(
    ref index: MirRoutineFactIndex, ref names: Array<String>, instruction: Int, kind: String
) -> Bool {
    if kind == "def" {
        return DirectMirScalarCfgGraphValueRow(names, index.instruction_facts.arg0s[instruction]) >= 0;
    }
    return kind == "phi" &&
        DirectMirScalarCfgGraphValueRow(names, index.instruction_facts.names[instruction]) >= 0;
}

// The field's ordinal in the receiver cell, or -1 when the routine has no
// admitted mutable-identity receiver cell or the cell has no such field.
func DirectMirReceiverFieldOrdinal(
    ref signature: DirectMirRoutineSignatureFact,
    ref cells: DirectMirIdentityCellFacts, name: String
) -> Int {
    if !signature.valid || signature.kind != "method" ||
        signature.receiver_carriage != "mutable-identity" || name == "" {
        return -1;
    }
    let cell: Int = DirectMirIdentityCellRow(cells, signature.receiver_type);
    if cell < 0 || cells.declaration_rows[cell] != signature.receiver_owner_row {
        return -1;
    }
    return DirectMirIdentityCellFieldOrdinal(cells, signature.receiver_type, name);
}

struct DirectMirReceiverFieldLeaf {
    let valid: Bool;
    let member: Int;
    let type_name: String;
    let use_count: Int;
}

// An unbound leaf naming a receiver field. Its owner-field uses (`name.N`
// with no value row) are consumed in the lane that carries them: the value
// lane of an instruction. The target lane of an owner-field definition
// carries none, so it consumes none.
func DirectMirReceiverFieldLeafFromOwners(
    ref signature: DirectMirRoutineSignatureFact,
    ref cells: DirectMirIdentityCellFacts, parameter_types: Array<String>,
    ref sequence: MirExpressionGraphSequence, node: Int,
    ref uses: MirRoutineInstructionUseFacts, global_row: Int, use_row: Int,
    ref value_names: Array<String>, consume_uses: Bool
) -> DirectMirReceiverFieldLeaf {
    let invalid: DirectMirReceiverFieldLeaf = DirectMirReceiverFieldLeaf(false, -1, "", 0);
    if node < 0 || node >= ArrayLength(sequence.arena.node_texts) ||
        sequence.arena.identities.binding_kinds[node] != SemanticExpressionBindingNone() ||
        ArrayLength(parameter_types) == 0 || parameter_types[0] != signature.receiver_type {
        return invalid;
    }
    let name: String = sequence.arena.node_texts[node];
    let member: Int = DirectMirReceiverFieldOrdinal(signature, cells, name);
    let field_type: String = DirectMirIdentityCellFieldType(cells, signature.receiver_type, member);
    if member < 0 || field_type == "" { return invalid; }
    var count: Int = 0;
    let total: Int = MirRoutineInstructionUseCountAtGlobal(uses, global_row);
    while consume_uses && use_row + count < total {
        let entry: Option<String> = MirRoutineInstructionUseAtGlobal(uses, global_row, use_row + count);
        if !IsSome(entry) || !MirSsaNameMatches(UnwrapOption(entry), name, true) ||
            DirectMirScalarCfgGraphValueRow(value_names, UnwrapOption(entry)) >= 0 {
            break;
        }
        count = count + 1;
    }
    return DirectMirReceiverFieldLeaf(true, member, field_type, count);
}

// A phi joining an owner-field variable joins nothing: every definition
// already stored into the receiver cell. Its result and incoming values are
// all versions of one receiver field and none of them has a value row.
func DirectMirReceiverFieldPhiReady(
    ref signature: DirectMirRoutineSignatureFact,
    ref cells: DirectMirIdentityCellFacts, ref index: MirRoutineFactIndex,
    ref uses: MirRoutineInstructionUseFacts, global_row: Int, local_instruction: Int,
    ref value_names: Array<String>
) -> Bool {
    let name: String = index.instruction_facts.names[local_instruction];
    let result: String = index.instruction_facts.results[local_instruction];
    let total: Int = MirRoutineInstructionUseCountAtGlobal(uses, global_row);
    if DirectMirReceiverFieldOrdinal(signature, cells, name) < 0 ||
        !MirSsaNameMatches(result, name, false) || total == 0 ||
        DirectMirScalarCfgGraphValueRow(value_names, result) >= 0 {
        return false;
    }
    var row: Int = 0;
    while row < total {
        let incoming: Option<String> = MirRoutineInstructionUseAtGlobal(uses, global_row, row);
        if !IsSome(incoming) || !MirSsaNameMatches(UnwrapOption(incoming), name, true) ||
            DirectMirScalarCfgGraphValueRow(value_names, UnwrapOption(incoming)) >= 0 {
            return false;
        }
        row = row + 1;
    }
    return true;
}
