// Exclusive envelope for the two-routine, one-struct value-flow program.

import "direct_mir_two_routine_nominal_program_admission_owner.pgy";

func DirectMirStructValueFlowProgramEnvelopeReady(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    ref classification: DirectMirTwoRoutineNominalClassificationFact
) -> Bool {
    return classification.kind == DirectMirTwoRoutineNominalPlain() &&
        DirectMirTwoRoutineNominalProgramEnvelopeReady(
            admitted, classification
        );
}
