// C operation dispatch for mutually exclusive Array<Int> program modes.

import "direct_mir_scalar_cfg_array_int_static_c_operation_owner.pgy";
import "direct_mir_scalar_cfg_array_int_nonmutating_c_operation_owner.pgy";
import "direct_mir_scalar_cfg_c_collection_operation_fact_owner.pgy";

func DirectMirScalarCfgArrayIntCProgramOperation(
    ref plan: DirectMirScalarCfgGraphPlan, operation: Int,
    formatted_print: CompilerRuntimeCallAbiFact,
    int_line_format: String, int_c_type: String
) -> DirectMirScalarCfgCCollectionOperationEmission {
    let nonmutating: DirectMirScalarCfgCCollectionOperationEmission =
        DirectMirScalarCfgArrayIntNonmutatingCOperation(
            plan, operation, formatted_print, int_line_format, int_c_type
        );
    if nonmutating.valid { return nonmutating; }
    return DirectMirScalarCfgArrayIntStaticCOperation(
        plan, operation, formatted_print, int_line_format, int_c_type
    );
}
