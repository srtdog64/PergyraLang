// LLVM operation dispatch for mutually exclusive Array<Int> program modes.

import "direct_mir_scalar_cfg_array_int_static_llvm_operation_owner.pgy";
import "direct_mir_scalar_cfg_array_int_nonmutating_llvm_operation_owner.pgy";
import "direct_mir_scalar_cfg_llvm_collection_operation_fact_owner.pgy";

func DirectMirScalarCfgArrayIntLlvmProgramOperation(
    ref plan: DirectMirScalarCfgGraphPlan, operation: Int,
    formatted_print: CompilerRuntimeCallAbiFact
) -> DirectMirScalarCfgLlvmCollectionOperationEmission {
    let nonmutating: DirectMirScalarCfgLlvmCollectionOperationEmission =
        DirectMirScalarCfgArrayIntNonmutatingLlvmOperation(
            plan, operation, formatted_print
        );
    if nonmutating.valid { return nonmutating; }
    return DirectMirScalarCfgArrayIntStaticLlvmOperation(
        plan, operation, formatted_print
    );
}
