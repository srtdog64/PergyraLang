// Target-neutral bounded Array<Int> program receipt.

import "direct_mir_scalar_cfg_array_int_collection_owner.pgy";
import "direct_mir_scalar_cfg_array_int_mutating_fact_owner.pgy";
import "direct_mir_scalar_cfg_array_int_static_mutation_fact_owner.pgy";
import "direct_mir_scalar_cfg_array_int_read_only_fact_owner.pgy";
import "direct_mir_scalar_cfg_array_int_reverse_fact_owner.pgy";
import "direct_mir_scalar_cfg_array_int_reverse_absence_owner.pgy";
import "direct_mir_scalar_cfg_array_int_pop_fact_owner.pgy";

func DirectMirScalarCfgArrayIntDynamicPushMode() -> Int { return 1; }
func DirectMirScalarCfgArrayIntStaticSetMode() -> Int { return 2; }
func DirectMirScalarCfgArrayIntReadOnlyInitializedMode() -> Int { return 3; }
func DirectMirScalarCfgArrayIntFreshReverseMode() -> Int { return 4; }
func DirectMirScalarCfgArrayIntForEachPrefixPopMode() -> Int { return 5; }

struct DirectMirScalarCfgArrayIntProgramFact {
    let valid: Bool;
    let mode: Int;
    let collection: DirectMirScalarCfgArrayIntCollectionFact;
    let producer: DirectMirScalarCfgArrayIntProducerFact;
    let consumer: DirectMirScalarCfgArrayIntConsumerFact;
    let static_mutation: DirectMirScalarCfgArrayIntStaticMutationFact;
    let read_only: DirectMirScalarCfgArrayIntReadOnlyRangeFact;
    let reverse: DirectMirScalarCfgArrayIntReverseFact;
    let pop: DirectMirScalarCfgArrayIntPopFact;
}

func DirectMirScalarCfgArrayIntProgramFactEmpty(
) -> DirectMirScalarCfgArrayIntProgramFact {
    return DirectMirScalarCfgArrayIntProgramFact(
        false, 0, DirectMirScalarCfgArrayIntCollectionFactEmpty(),
        DirectMirScalarCfgArrayIntProducerFactEmpty(),
        DirectMirScalarCfgArrayIntConsumerFactEmpty(),
        DirectMirScalarCfgArrayIntStaticMutationFactEmpty(),
        DirectMirScalarCfgArrayIntReadOnlyRangeFactEmpty(),
        DirectMirScalarCfgArrayIntReverseFactEmpty(),
        DirectMirScalarCfgArrayIntPopFactEmpty()
    );
}

func DirectMirScalarCfgArrayIntProgramAbsent(
    ref fact: DirectMirScalarCfgArrayIntProgramFact
) -> Bool {
    return !fact.valid && fact.mode == 0 && !fact.collection.valid &&
        !fact.producer.valid && !fact.consumer.valid &&
        !fact.static_mutation.valid && !fact.read_only.valid &&
        DirectMirScalarCfgArrayIntReverseAbsent(fact.reverse) &&
        DirectMirScalarCfgArrayIntPopFactAbsent(fact.pop);
}
