// Definition, source-local, and operation lookup over one Array<Int> receipt.

import "direct_mir_scalar_cfg_array_int_program_fact_owner.pgy";
import "direct_mir_scalar_cfg_array_int_mutating_lookup_owner.pgy";
import "direct_mir_scalar_cfg_array_int_reverse_lookup_owner.pgy";
import "direct_mir_scalar_cfg_array_int_pop_lookup_owner.pgy";
import "direct_mir_scalar_cfg_array_int_source_lookup_owner.pgy";

func DirectMirScalarCfgArrayIntOperationGlobal(
    ref fact: DirectMirScalarCfgArrayIntProgramFact, global_row: Int
) -> Bool {
    return DirectMirScalarCfgArrayIntMutatingOperationGlobal(
            fact, global_row) ||
        DirectMirScalarCfgArrayIntReverseOperationGlobal(
            fact.reverse, global_row) ||
        DirectMirScalarCfgArrayIntPopOperationGlobal(fact.pop, global_row);
}
