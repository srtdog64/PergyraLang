// Operation and condition expressions from one bound read-only receipt.

import "direct_mir_scalar_cfg_array_int_read_only_fact_owner.pgy";
import "direct_mir_scalar_cfg_expression_owner.pgy";

func DirectMirScalarCfgArrayIntReadOnlyExpressionFact(
    ref fact: DirectMirScalarCfgArrayIntReadOnlyRangeFact, global_row: Int
) -> DirectMirScalarCfgExpressionFact {
    if !fact.valid { return DirectMirScalarCfgExpressionFactEmpty(); }
    if global_row == fact.initial_read.global_row {
        return DirectMirScalarCfgExpressionFact(
            true, DirectMirScalarCfgOpArrayReadInt(),
            -1, -1, -1, -1, "0", ""
        );
    }
    if global_row == fact.update_read.global_row {
        return DirectMirScalarCfgExpressionFact(
            true, DirectMirScalarCfgOpArrayReadInt(),
            -1, -1, fact.index_local_row, -1, "", ""
        );
    }
    return DirectMirScalarCfgExpressionFactEmpty();
}

func DirectMirScalarCfgArrayIntReadOnlyConditionFact(
    ref fact: DirectMirScalarCfgArrayIntReadOnlyRangeFact, global_row: Int
) -> DirectMirScalarCfgExpressionFact {
    if !fact.valid || global_row != fact.condition_global_row {
        return DirectMirScalarCfgExpressionFactEmpty();
    }
    return DirectMirScalarCfgExpressionFact(
        true, DirectMirScalarCfgConditionGreater(), -1,
        fact.current_value_row, fact.index_local_row, -1, "", ""
    );
}
