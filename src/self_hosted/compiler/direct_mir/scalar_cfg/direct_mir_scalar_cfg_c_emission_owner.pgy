// C projection of one verified scalar CFG program plan.

import "direct_mir_scalar_cfg_graph_readiness_owner.pgy";
import "direct_mir_scalar_cfg_program_c_emission_owner.pgy";
import "../../../mir/runtime_call_abi_fact_owner.pgy";

func DirectMirScalarCfgEmitC(
    ref plan: DirectMirScalarCfgGraphPlan,
    formatted_print: CompilerRuntimeCallAbiFact,
    process_exit: CompilerRuntimeCallAbiFact,
    int_line_format: String,
    string_line_format: String,
    int_c_type: String,
    target: CompilerTargetProjectionFact
) -> String {
    if !DirectMirScalarCfgGraphPlanReady(plan) || !plan.program.valid ||
        !formatted_print.ok ||
        formatted_print.call_shape !=
            CompilerRuntimeCallAbiStringCallShape("formatted-print") ||
        int_line_format == "" || string_line_format == "" ||
        int_c_type == "" {
        Die("direct MIR scalar CFG C plan or runtime ABI is invalid");
    }
    let runtime: DirectMirScalarProgramRuntimeAbiProjection =
        DirectMirScalarProgramRuntimeAbiProjectionFromFact(
            plan.program.runtime_abi);
    if !DirectMirScalarProgramRuntimeAbiProjectionReady(
            runtime, plan.program.runtime_abi) {
        Die("direct MIR scalar CFG program C runtime ABI is invalid");
    }
    return DirectMirScalarCfgEmitProgramC(
        plan, formatted_print, process_exit, runtime, int_line_format,
        string_line_format, int_c_type, target
    );
}
