// Target-neutral local storage identities for the scalar CFG plan.

import "direct_mir_scalar_cfg_iteration_local_owner.pgy";
import "direct_mir_scalar_cfg_local_inventory_owner.pgy";
import "direct_mir_scalar_cfg_routine_partition_fact_owner.pgy";
import "direct_mir_scalar_cfg_wire_local_ref_owner.pgy";
import "../../../mir_lower/routine_result_definition_fact_owner.pgy";
import "direct_mir_scalar_cfg_expression_base_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_logical_record_fact_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_referenced_enum_fact_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_indexed_assignment_fact_owner.pgy";
import "direct_mir_scalar_cfg_match_binding_local_owner.pgy";
import "direct_mir_scalar_cfg_local_ref_identity_owner.pgy";
import "../direct_mir_receiver_field_binding_owner.pgy";

struct DirectMirScalarCfgLocalRefPlan {
    let valid: Bool;
    let local_names: Array<String>;
    let local_ref_kinds: Array<Int>;
    let local_ref_value_ids: Array<String>;
    let local_ref_syntax_ids: Array<Int>;
    let value_names: Array<String>;
    let value_local_rows: Array<Int>;
    let value_definition_blocks: Array<Int>;
}

func DirectMirScalarCfgLocalRefPlanEmpty() -> DirectMirScalarCfgLocalRefPlan {
    let strings: Array<String> = [];
    let ints: Array<Int> = [];
    return DirectMirScalarCfgLocalRefPlan(false, strings, ints, strings, ints, strings, ints, ints);
}

func DirectMirScalarCfgValueLocalRow(names: Array<String>, wanted: String) -> Int {
    var row: Int = 0;
    while row < ArrayLength(names) {
        if names[row] == wanted { return row; }
        row = row + 1;
    }
    return -1;
}

func DirectMirScalarCfgLocalRefPlanFromOwners(ref admitted: MirMachineLayerAdmittedJsonInput,
    ref index: MirRoutineFactIndex, ref use_facts: MirRoutineInstructionUseFacts,
    ref wire: DirectMirScalarCfgWireLocalRefs, ref ranges: DirectMirScalarCfgRangeFactSet,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    ref referenced_enum: DirectMirScalarProgramReferencedEnumFact,
    ref indexed_assignments:
        DirectMirScalarProgramIndexedAssignmentFactSet,
    ref parameters: DirectMirRoutineParameterSetFact
) -> DirectMirScalarCfgLocalRefPlan {
    let empty: DirectMirScalarCfgLocalRefPlan =
        DirectMirScalarCfgLocalRefPlanEmpty();
    if !wire.valid {
        Die("direct MIR scalar CFG LocalRef wire is invalid"); return empty;
    }
    if !indexed_assignments.valid {
        Die("direct MIR scalar CFG indexed-assignment facts are invalid");
    }
    var local_names: Array<String> = [];
    var local_ref_kinds: Array<Int> = [];
    var local_ref_value_ids: Array<String> = [];
    var local_ref_syntax_ids: Array<Int> = [];
    var value_names: Array<String> = [];
    var value_local_rows: Array<Int> = [];
    var value_definition_blocks: Array<Int> = [];
    // A receiver field has no local (direct_mir_receiver_field_binding_owner.pgy).
    let receiver_fields: Array<String> = DirectMirReceiverFieldVariableNames(index);
    var instruction: Int = 0;
    while instruction < ArrayLength(index.instruction_facts.starts) {
        let result: String = index.instruction_facts.results[instruction];
        let global: Int = index.instruction_facts.global_start + instruction;
        let kind: String = admitted.routines.instruction_kinds[global];
        let source: String =
            admitted.routines.instruction_source_types[global];
        let wire_ref: String = wire.primary_refs[instruction];
        let arg0: String = index.instruction_facts.arg0s[instruction];
        let collection_mutation_receiver: Bool = kind == "stmt" &&
            (arg0 == "ArrayPush" || arg0 == "ArraySet" ||
             arg0 == "ArrayPop");
        if wire.required &&
            ((result != "" && wire_ref == "") ||
             (result == "" && wire_ref != "" &&
              kind != "loop-init" && kind != "branch" &&
              !collection_mutation_receiver)) {
            Die("direct MIR scalar CFG instruction LocalRef coverage is invalid");
        }
        if DirectMirReceiverFieldVariableInstruction(index, receiver_fields, instruction, kind) {
            // A local of the same name would make the field's versions ambiguous.
            if kind == "def" && index.instruction_facts.arg1s[instruction] != "owner_field" { return empty; }
            instruction = instruction + 1; continue;
        }
        if result != "" {
            if kind != "def" && kind != "phi" { return empty; }
            var local_name: String = index.instruction_facts.arg0s[instruction];
            if kind == "phi" {
                local_name = index.instruction_facts.names[instruction];
            }
            var local_identity: String = result;
            var parameter_ordinal: Int =
                DirectMirRoutineLocalParameterOrdinalAtName(
                    parameters, local_name);
            if parameter_ordinal >= 0 {
                local_identity = SelfMirLocalRef(
                    "parameter", ToInt(index.source_syntax_id),
                    parameter_ordinal);
            }
            if wire.required {
                local_identity = wire_ref;
                parameter_ordinal = SelfMirLocalRefParameterOrdinalForOwner(
                    local_identity, ToInt(index.source_syntax_id));
                if (StartsWith(local_identity, "parameter:") &&
                    (parameter_ordinal < 0 || parameter_ordinal >= ArrayLength(parameters.names))) ||
                    (source == "AST_LET_DECL" && !StartsWith(local_identity, "declaration:") &&
                     !MirIterationTypeFactsHoistedIterableRef(index.iteration_type_facts, local_identity)) {
                    Die("direct MIR scalar CFG LocalRef declaration role or owner is invalid");
                }
            }
            var local_row: Int = -1;
            if wire.required {
                local_row = DirectMirScalarCfgLocalIdentityRow(
                    local_ref_value_ids, local_identity
                );
            } else {
                local_row = DirectMirScalarCfgValueLocalRow(
                    local_names, local_name
                );
            }
            if (source == "AST_LET_DECL" && local_row >= 0) ||
                ((source == "AST_ASSIGNMENT" || kind == "phi") &&
                    DirectMirScalarCfgValueDefinitionConflictsWithRange(
                        ranges, local_name, local_identity, wire.required
                    )) {
                Die("direct MIR scalar CFG value LocalRef ownership is invalid");
            }
            if local_row < 0 {
                // Ownership consumers use declaration identity even when the
                // noncolliding wire form omits explicit LocalRefs.
                if !wire.required && parameter_ordinal < 0 &&
                    ArrayLength(index.collection_ownership_facts.binding_syntax_ids) > 0 {
                    var loop_bindings: Array<String> = DirectMirScalarCfgLoopBindingNames(admitted.routines, index);
                    local_identity = DirectMirScalarCfgDeclarationIdentity(index.source_local_names,
                        index.source_local_binding_syntax_ids, index.declared_source_local_count, local_name, loop_bindings);
                }
                local_row = ArrayLength(local_names);
                ArrayPush(local_names, local_name);
                ArrayPush(local_ref_kinds, DirectMirScalarCfgLocalRefValue());
                ArrayPush(local_ref_value_ids, local_identity);
                ArrayPush(local_ref_syntax_ids, -1);
                // A receiver is an existing identity pointer, not an initial
                // value definition. Its first field store may have no SSA use.
                if parameter_ordinal >= 0 &&
                    parameters.carriages[parameter_ordinal] != "mutable-identity" {
                    ArrayPushOwnedString(value_names, Concat(local_name, ".0"));
                    ArrayPush(value_local_rows, local_row);
                    ArrayPush(value_definition_blocks, 0);
                }
            } else if local_names[local_row] != local_name {
                Die("direct MIR scalar CFG LocalRef name identity disagrees");
            }
            let definition: MirRoutineResultDefinitionFact =
                MirRoutineFactIndexUniqueResultDefinition(index, result);
            if local_name == "" ||
                !MirRoutineResultDefinitionFactReady(definition) ||
                !MirSsaNameMatches(result, local_name, false) ||
                DirectMirScalarCfgGraphValueRow(value_names, result) >= 0 {
                Die("direct MIR scalar CFG result definition LocalRef is invalid");
            }
            ArrayPushOwnedString(value_names, result);
            ArrayPush(value_local_rows, local_row);
            ArrayPush(value_definition_blocks, definition.block_id);
        }
        instruction = instruction + 1;
    }
    if !DirectMirScalarCfgAppendIterationLocals(
        admitted, index, use_facts, wire, ranges, local_names,
        local_ref_kinds, local_ref_value_ids, local_ref_syntax_ids
    ) {
        Die("direct MIR scalar CFG range LocalRef binding is invalid");
    }
    if !DirectMirScalarCfgAppendIterationElementValues(ranges, local_ref_kinds, local_ref_syntax_ids,
            value_names, value_local_rows, value_definition_blocks) { Die("direct MIR scalar CFG iteration element value is invalid"); }
    if !DirectMirScalarCfgAppendMatchBindingLocals(
        admitted, index, logical_record, referenced_enum, local_names,
        local_ref_kinds, local_ref_value_ids, local_ref_syntax_ids
    ) {
        Die("direct MIR scalar CFG match binding LocalRef is invalid");
    }
    return DirectMirScalarCfgLocalRefPlan(
        true, local_names, local_ref_kinds, local_ref_value_ids,
        local_ref_syntax_ids, value_names, value_local_rows,
        value_definition_blocks
    );
}

func DirectMirScalarCfgLocalRefsReady(
    ref local_names: Array<String>, ref local_ref_kinds: Array<Int>,
    ref local_ref_value_ids: Array<String>, ref local_ref_syntax_ids: Array<Int>,
    ref value_names: Array<String>, ref value_local_rows: Array<Int>,
    ref value_definition_blocks: Array<Int>, block_count: Int,
    ref routines: DirectMirScalarCfgRoutinePartitionFact,
    ref ranges: DirectMirScalarCfgRangeFactSet
) -> Bool {
    let count: Int = ArrayLength(local_names);
    let value_count: Int = ArrayLength(value_names);
    if count != ArrayLength(local_ref_kinds) ||
        count != ArrayLength(local_ref_value_ids) ||
        count != ArrayLength(local_ref_syntax_ids) ||
        value_count != ArrayLength(value_local_rows) ||
        value_count != ArrayLength(value_definition_blocks) ||
        !DirectMirScalarCfgRoutinePartitionRangesReady(
            routines.local_starts, routines.local_counts, count) ||
        !DirectMirScalarCfgRoutinePartitionRangesReady(
            routines.value_starts, routines.value_counts, value_count) ||
        !DirectMirScalarCfgRoutinePartitionRangesReady(
            routines.block_starts, routines.block_counts, block_count) {
        return false;
    }
    var routine: Int = 0;
    while routine < ArrayLength(routines.roles) {
        let local_start: Int = routines.local_starts[routine];
        let local_end: Int = local_start + routines.local_counts[routine];
        var row: Int = local_start;
        while row < local_end {
            let kind: Int = local_ref_kinds[row];
            if local_names[row] == "" ||
                (kind == DirectMirScalarCfgLocalRefValue() &&
                    (local_ref_value_ids[row] == "" ||
                     local_ref_syntax_ids[row] >= 0)) ||
                (kind == DirectMirScalarCfgLocalRefIteration() &&
                    (local_ref_syntax_ids[row] < 0 ||
                     (local_ref_value_ids[row] != "" &&
                      local_ref_value_ids[row] != Concat(
                        "iteration:", Concat(
                            ToString(local_ref_syntax_ids[row]), ":0"
                        )
                      )))) ||
                (kind == DirectMirScalarCfgLocalRefIterationCursor() &&
                    (local_ref_syntax_ids[row] < 0 || local_ref_value_ids[row] != "")) ||
                (kind == DirectMirScalarCfgLocalRefMatchBinding() &&
                    (local_ref_syntax_ids[row] < 0 ||
                     SelfMirLocalRefDestructureOrdinalForOwner(
                        local_ref_value_ids[row],
                        routines.source_syntax_ids[routine]) !=
                            local_ref_syntax_ids[row])) ||
                (kind != DirectMirScalarCfgLocalRefValue() &&
                 kind != DirectMirScalarCfgLocalRefIteration() &&
                 kind != DirectMirScalarCfgLocalRefIterationCursor() &&
                 kind != DirectMirScalarCfgLocalRefMatchBinding()) {
                return false;
            }
            var prior: Int = local_start;
            while prior < row {
                if local_ref_value_ids[row] != "" &&
                    local_ref_value_ids[prior] == local_ref_value_ids[row] {
                    return false;
                }
                prior = prior + 1;
            }
            row = row + 1;
        }
        var value: Int = routines.value_starts[routine];
        let value_end: Int = value + routines.value_counts[routine];
        let block_start: Int = routines.block_starts[routine];
        let block_end: Int = block_start + routines.block_counts[routine];
        while value < value_end {
            let local_binding: Int = value_local_rows[value];
            let definition_block: Int = value_definition_blocks[value];
            if StringLength(value_names[value]) == 0 ||
                local_binding < local_start || local_binding >= local_end ||
                definition_block < block_start || definition_block >= block_end ||
                (local_ref_kinds[local_binding] != DirectMirScalarCfgLocalRefValue() &&
                 !DirectMirScalarCfgIterationElementValueOf(ranges, value_names[value],
                    local_ref_kinds[local_binding], local_ref_syntax_ids[local_binding])) {
                return false;
            }
            value = value + 1;
        }
        routine = routine + 1;
    }
    return DirectMirScalarCfgIterationLocalsReady(
        local_names, local_ref_kinds, local_ref_value_ids,
        local_ref_syntax_ids, ranges
    );
}
