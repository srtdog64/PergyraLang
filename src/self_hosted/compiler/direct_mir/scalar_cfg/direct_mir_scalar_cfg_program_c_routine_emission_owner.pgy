import "../../owned_local_lifetime_emission_owner.pgy";
// Direct scalar-C routine emission.

import "direct_mir_scalar_cfg_program_extension_readiness_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_process_exit_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_c_expression_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_c_slice_expression_owner.pgy";
import "direct_mir_scalar_cfg_program_c_operation_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_c_array_mutation_owner.pgy";
import "direct_mir_scalar_cfg_local_emission_owner.pgy";
import "direct_mir_scalar_cfg_string_c_materialization_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_c_builtin_materialization_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_c_string_collection_materialization_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_c_array_string_cleanup_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_c_hashmap_cleanup_owner.pgy";
import "direct_mir_scalar_cfg_program_c_signature_owner.pgy";
import "../../runtime_value_representation_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_c_option_result_preamble_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_c_array_int_value_result_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_c_array_bool_materialization_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_c_array_bool_value_result_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_c_array_string_value_result_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_c_logical_record_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_c_logical_record_option_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_c_payload_enum_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_c_logical_record_value_result_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_c_logical_record_array_value_result_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_c_set_string_value_result_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_hashmap_parameter_lifecycle_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_array_int_populated_literal_readiness_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_c_array_int_populated_literal_materialization_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_c_array_bool_populated_literal_owner.pgy";
import "../../../mir/runtime_call_abi_fact_owner.pgy";
import "../../../codegen/runtime_abi/host_io_runtime_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_scalar_value_result_owner.pgy";
import "direct_mir_scalar_cfg_range_block_effect_owner.pgy";
import "direct_mir_scalar_cfg_program_c_block_exit_emission_owner.pgy";

func DirectMirScalarCfgProgramCRoutine(ref plan: DirectMirScalarCfgGraphPlan, ref lifetime: DirectMirOwnedLocalLifetimeFact, routine: Int,
    formatted_print: CompilerRuntimeCallAbiFact, process_exit: CompilerRuntimeCallAbiFact,
    ref runtime: DirectMirScalarProgramRuntimeAbiProjection,
    int_line_format: String, string_line_format: String, int_c_type: String,
    array_string_projection: Option<DirectMirArrayStringAbiProjection>,
    target: CompilerTargetProjectionFact) -> String {
    let output_allocator: Allocator = AllocatorResult();
    let output: TextBuilder = TextBuilderNew(4096);
    TextBuilderAppend(output, DirectMirScalarCfgProgramCSignature(plan, routine, int_c_type, false, array_string_projection));
    TextBuilderAppend(output, " {\n");
    var parameter_ordinal: Int = 0;
    while routine != plan.routines.entrypoint_ordinal &&
            parameter_ordinal < plan.routines.parameter_counts[routine] {
        TextBuilderAppend(output, "    (void)pgy_param_${parameter_ordinal}");
        if DirectMirScalarProgramParameterValueResultAt(
                plan, routine, parameter_ordinal) {
            TextBuilderAppend(output, "_mutref");
        }
        TextBuilderAppend(output, ";\n");
        parameter_ordinal = parameter_ordinal + 1;
    }
    TextBuilderAppend(output, DirectMirScalarProgramCScalarValueResultCopyIn(plan, routine));
    TextBuilderAppend(output, DirectMirIdentityCellRoutineStorage(plan, routine, false));
    if routine == plan.routines.entrypoint_ordinal &&
        plan.program.runtime_abi.process_args_id != 0 {
        TextBuilderAppend(output, HostIORuntimeCArgsCapturePrefix());
    }
    TextBuilderAppend(output, DirectMirScalarProgramCArrayIntValueResultCopyIn(plan, routine));
    TextBuilderAppend(output, DirectMirScalarProgramCArrayBoolValueResultCopyIn(plan, routine));
    TextBuilderAppend(output, DirectMirScalarProgramCArrayStringValueResultCopyIn(plan, routine, array_string_projection));
    TextBuilderAppend(output, DirectMirScalarProgramCLogicalRecordValueResultCopyIn(plan, routine));
    TextBuilderAppend(output, DirectMirScalarProgramCLogicalRecordArrayValueResultCopyIn(plan, routine));
    TextBuilderAppend(output, DirectMirScalarProgramCSetStringValueResultCopyIn(plan, routine));
    TextBuilderAppend(output, DirectMirScalarProgramCHashMapValueResultCopyIn(plan, routine));
    TextBuilderAppend(output, DirectMirScalarCfgCLocalDeclarationsInRange(
        plan, int_c_type, plan.routines.local_starts[routine],
        plan.routines.local_counts[routine], routine));
    TextBuilderAppend(output, DirectMirOwnedLocalInitialization(plan, lifetime, routine, false));
    let block_start: Int = plan.routines.block_starts[routine];
    let block_end: Int = block_start + plan.routines.block_counts[routine];
    TextBuilderAppend(output, "    goto pgy_r${routine}_block_${block_start};\n");
    var block: Int = block_start;
    while block < block_end {
        TextBuilderAppend(output, "pgy_r${routine}_block_${block}:\n");
        var operation: Int = plan.block_operation_starts[block];
        let operation_end: Int = operation +
            plan.block_operation_counts[block];
        while operation < operation_end {
            let emitted: String = DirectMirScalarCfgProgramCOperation(
                plan, lifetime, routine, operation, formatted_print, process_exit,
                runtime, int_line_format, string_line_format, array_string_projection, target);
            if emitted == "" && (plan.operation_kinds[operation] == DirectMirScalarCfgOpPhiInt() ||
                 plan.operation_kinds[operation] == DirectMirScalarCfgOpPhiString() ||
                 plan.operation_kinds[operation] == DirectMirScalarCfgOpPhiValue()) {
                // Memory locals already carry the selected predecessor value.
            }
            if emitted == "" && plan.operation_kinds[operation] != DirectMirScalarCfgOpPhiInt() &&
                    plan.operation_kinds[operation] != DirectMirScalarCfgOpPhiString() &&
                    plan.operation_kinds[operation] != DirectMirScalarCfgOpPhiValue() {
                Die("direct MIR scalar program C operation is unsupported");
            }
            TextBuilderAppend(output, emitted);
            operation = operation + 1;
        }
        TextBuilderAppend(output, DirectMirScalarCfgRangeCBlockEffects(
            plan.range_iterations,
            ArrayLength(plan.block_succ_true), block));
        TextBuilderAppend(output, DirectMirScalarCfgProgramCBlockExit(
            plan, lifetime, routine, block, runtime, int_c_type,
            array_string_projection, target));
        block = block + 1;
    }
    TextBuilderAppend(output, "}\n");
    let routine_c: String = TextBuilderFinish(output, output_allocator);
    AllocatorDestroy(output_allocator);
    return routine_c;
}

