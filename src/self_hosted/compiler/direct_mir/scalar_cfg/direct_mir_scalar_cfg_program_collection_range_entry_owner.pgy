// Binds a collection iteration's element at the entry of its body block,
// `v = xs[cursor]`, from the receipt's admitted element expression row. The
// header has already checked `cursor < ArrayLength(xs)` on this pass.
import "direct_mir_scalar_cfg_range_block_effect_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_llvm_expression_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_llvm_type_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_c_expression_owner.pgy";

func DirectMirScalarCfgProgramCollectionRangeLlvmEntry(
    ref plan: DirectMirScalarCfgGraphPlan, routine: Int, block: Int,
    ref runtime: DirectMirScalarProgramRuntimeAbiProjection,
    array_string_projection: Option<DirectMirArrayStringAbiProjection>,
    array_int_projection: Option<DirectMirArrayIntAbiProjection>, target: CompilerTargetProjectionFact
) -> String {
    var output: String = "";
    var row: Int = 0;
    while row < DirectMirScalarCfgRangeFactCount(plan.range_iterations) {
        let fact: DirectMirScalarCfgRangeIterationFact = DirectMirScalarCfgRangeFactAt(plan.range_iterations, row);
        if fact.iterable_type != "" && fact.body_block == block {
            let expression: DirectMirScalarProgramLlvmExpression = DirectMirScalarProgramLlvmExpressionAt(
                plan, plan.program.expressions, fact.element_expression_row, runtime,
                plan.program.logical_record, plan.program.payload_free_enum, plan.program.referenced_enum,
                plan.routines, routine, plan.program.array_string_abi, array_string_projection,
                plan.program.array_int_value_result, array_int_projection, target);
            let llvm_type: String = DirectMirScalarProgramLlvmTypeForProgramWithReferencedEnum(
                plan.local_types[fact.local_row], plan.program.logical_record,
                plan.program.payload_free_enum, plan.program.referenced_enum);
            if !expression.valid || llvm_type == "" ||
                expression.type_name != plan.local_types[fact.local_row] {
                Die("direct MIR LLVM collection iteration element is invalid");
            }
            var align: String = "8";
            if llvm_type == "i1" { align = "1"; }
            output = output + expression.instructions + "  store " + llvm_type + " " + expression.value +
                ", ptr %pgy.local." + ToString(fact.local_row) + ", align " + align + "\n";
        }
        row = row + 1;
    }
    return output;
}

func DirectMirScalarCfgProgramCollectionRangeCEntry(
    ref plan: DirectMirScalarCfgGraphPlan, routine: Int, block: Int,
    ref runtime: DirectMirScalarProgramRuntimeAbiProjection, target: CompilerTargetProjectionFact,
    array_string_projection: Option<DirectMirArrayStringAbiProjection>
) -> String {
    var output: String = "";
    var row: Int = 0;
    while row < DirectMirScalarCfgRangeFactCount(plan.range_iterations) {
        let fact: DirectMirScalarCfgRangeIterationFact = DirectMirScalarCfgRangeFactAt(plan.range_iterations, row);
        if fact.iterable_type != "" && fact.body_block == block {
            let expression: String = DirectMirScalarProgramCExpressionAt(
                plan, plan.program.expressions, fact.element_expression_row, runtime,
                plan.program.logical_record, plan.program.referenced_enum, plan.routines, routine,
                target, plan.program.array_string_abi, array_string_projection);
            if expression == "" { Die("direct MIR C collection iteration element is invalid"); }
            output = output + "    pgy_local_" + ToString(fact.local_row) + " = " + expression + ";\n";
        }
        row = row + 1;
    }
    return output;
}
