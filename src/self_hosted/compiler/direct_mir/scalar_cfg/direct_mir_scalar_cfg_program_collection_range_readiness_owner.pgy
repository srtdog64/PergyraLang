// Plan readiness of a collection iteration's header shape and body entry: the
// body block, entered only from the header, starts with the definition of
// the binding from `xs[cursor]`.
import "direct_mir_scalar_cfg_graph_fact_owner.pgy";

func DirectMirScalarCfgCollectionRangeShapeReady(
    ref plan: DirectMirScalarCfgGraphPlan, ref range: DirectMirScalarCfgRangeIterationFact
) -> Bool {
    if range.cursor_local_row < 0 || plan.block_operation_counts[range.body_block] < 1 { return false; }
    let operation: Int = plan.block_operation_starts[range.body_block];
    let value: Int = plan.operation_result_values[operation];
    let row: Int = plan.program.operation_expression_rows[operation];
    if plan.operation_kinds[operation] != DirectMirScalarCfgOpExpressionDefinition() ||
        value < 0 || value >= ArrayLength(plan.value_local_rows) ||
        plan.value_local_rows[value] != range.local_row || row < 0 ||
        row >= ArrayLength(plan.program.expressions.graph_roots) ||
        plan.program.expressions.graph_global_rows[row] != range.branch_global_row { return false; }
    let cursor: Int = plan.program.expressions.node_rights[plan.program.expressions.graph_roots[row]];
    if cursor < 0 || plan.program.expressions.node_kinds[cursor] != DirectMirScalarProgramExprLocal() ||
        plan.program.expressions.node_local_rows[cursor] != range.cursor_local_row { return false; }
    var block: Int = 0;
    while block < ArrayLength(plan.block_succ_true) {
        if block != range.header_block && (plan.block_succ_true[block] == range.body_block ||
                plan.block_succ_false[block] == range.body_block) { return false; }
        block = block + 1;
    }
    return true;
}
