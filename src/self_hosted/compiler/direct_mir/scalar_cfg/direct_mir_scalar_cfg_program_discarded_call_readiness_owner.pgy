// Admits discarded calls whose side effect is the statement's observable result.
import "../scalar_program/direct_mir_scalar_program_expression_fact_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_expression_kind_id_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_array_transform_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_checked_int_owner.pgy";

func DirectMirScalarCfgProgramDiscardedCallExpressionReady(
    ref expressions: DirectMirScalarProgramExpressionSet,
    expression_row: Int
) -> Bool {
    if expression_row < 0 ||
        expression_row >= ArrayLength(expressions.graph_roots) {
        return false;
    }
    let root: Int = expressions.graph_roots[expression_row];
    if root < 0 || root >= ArrayLength(expressions.node_kinds) ||
        expressions.node_types[root] == "" {
        return false;
    }
    // These calls mutate existing storage and return its unchanged descriptor.
    // Discarding that alias must not discard the operation or demand a Void type.
    if DirectMirScalarProgramArrayTransformKind(expressions.node_kinds[root]) {
        return DirectMirScalarProgramArrayTransformNodeReady(expressions, root);
    }
    if DirectMirScalarProgramCheckedIntKind(expressions.node_kinds[root]) {
        return DirectMirScalarProgramCheckedIntNodeReady(expressions, root);
    }
    return expressions.node_types[root] == "Void" ||
        expressions.node_kinds[root] == DirectMirScalarProgramExprDirectCall() ||
        expressions.node_kinds[root] ==
            DirectMirScalarProgramExprCompilerArtifactWrite();
}
