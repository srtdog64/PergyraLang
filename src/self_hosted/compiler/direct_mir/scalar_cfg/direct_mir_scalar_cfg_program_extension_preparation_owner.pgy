// Seals every extension fact that still reads the complete graph storage.
// The caller may move storage row arrays only after this preparation returns.
import "../scalar_program/direct_mir_scalar_program_callable_admission_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_route_fact_owner.pgy";
import "direct_mir_scalar_cfg_program_graph_storage_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_extension_abi_seal_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_callable_inventory_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_owned_array_string_move_admission_owner.pgy";

struct DirectMirScalarCfgProgramExtensionPreparation {
    let callable: DirectMirScalarCfgProgramCallableFact;
    let closed_call_abi: DirectMirClosedModuleCallAbiFact;
    let expressions: DirectMirScalarProgramExpressionSet;
    let abi: DirectMirScalarProgramExtensionAbiSeal;
    let owned_array_string_move: DirectMirScalarProgramOwnedArrayStringMoveFact;
}

func DirectMirScalarCfgProgramExtensionPreparationFromOwners(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    own route: DirectMirScalarProgramRouteFact,
    ref callables: DirectMirScalarCfgProgramCallableInventory,
    ref storage: DirectMirScalarCfgProgramGraphStorage,
    expressions: DirectMirScalarProgramExpressionSet,
    option_int_abi: DirectMirOptionMatchAbiFact,
    result_abi: DirectMirScalarResultAbiSet,
    option_string_abi: DirectMirOptionMatchAbiFact,
    option_bool_abi: DirectMirOptionMatchAbiFact
) -> DirectMirScalarCfgProgramExtensionPreparation {
    var callable: DirectMirScalarCfgProgramCallableFact =
        DirectMirScalarCfgProgramCallableFactInvalid();
    var closed_call_abi: DirectMirClosedModuleCallAbiFact =
        DirectMirClosedModuleCallAbiFactEmpty();
    if ArrayLength(route.routine_rows) == 2 {
        callable = DirectMirScalarProgramCallableFactFromInstance(
            route.routine_instances, 1, route.logical_record,
            route.payload_free_enum, route.referenced_enum,
            route.opaque_readonly_zones);
        closed_call_abi = DirectMirClosedModuleCallAbiFactFromOwner();
    }
    let sealed_expressions: DirectMirScalarProgramExpressionSet =
        DirectMirScalarProgramExpressionSetWithDigest(
            expressions, DirectMirScalarProgramExpressionSetDigest(expressions));
    let abi: DirectMirScalarProgramExtensionAbiSeal =
        DirectMirScalarProgramExtensionAbiSealFromOwners(
            admitted, route, storage, sealed_expressions, option_int_abi,
            result_abi, option_string_abi, option_bool_abi, callable);
    if !abi.valid {
        Die(Concat("direct MIR scalar program extension ABI is invalid: stage=", abi.stage));
    }
    let owned_array_string_move: DirectMirScalarProgramOwnedArrayStringMoveFact =
        DirectMirScalarProgramOwnedArrayStringMoveFactFromProgram(
            callables, storage, sealed_expressions, abi.array_string);
    return DirectMirScalarCfgProgramExtensionPreparation(
        callable, closed_call_abi, sealed_expressions, abi,
        owned_array_string_move);
}
