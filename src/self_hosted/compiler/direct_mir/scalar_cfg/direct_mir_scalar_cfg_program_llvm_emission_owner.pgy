import "../../owned_local_lifetime_emission_owner.pgy";
// Range-aware LLVM projection for every routine in the scalar program GraphPlan.
import "direct_mir_scalar_cfg_program_extension_readiness_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_llvm_expression_owner.pgy";
import "direct_mir_scalar_cfg_program_llvm_operation_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_llvm_array_long_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_llvm_string_global_owner.pgy";
import "direct_mir_scalar_cfg_local_emission_owner.pgy";
import "direct_mir_scalar_cfg_string_llvm_materialization_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_llvm_builtin_materialization_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_llvm_array_mutation_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_llvm_option_result_preamble_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_llvm_array_int_value_result_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_llvm_array_value_parameter_storage_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_llvm_array_bool_materialization_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_expression_kind_query_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_llvm_array_bool_value_result_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_llvm_array_string_value_result_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_llvm_owned_array_string_parameter_binding_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_llvm_logical_record_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_llvm_logical_record_option_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_llvm_payload_enum_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_llvm_logical_record_value_result_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_llvm_logical_record_value_parameter_address_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_llvm_logical_record_array_value_result_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_llvm_set_string_value_result_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_hashmap_parameter_lifecycle_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_process_exit_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_llvm_string_collection_materialization_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_llvm_array_string_cleanup_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_llvm_hashmap_cleanup_owner.pgy";
import "direct_mir_scalar_cfg_llvm_foreign_declaration_owner.pgy";
import "direct_mir_scalar_cfg_program_llvm_signature_owner.pgy";
import "../direct_mir_llvm_text_format_owner.pgy";
import "../../runtime_value_representation_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_llvm_runtime_value_expression_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_llvm_compiler_artifact_expression_owner.pgy";
import "direct_mir_scalar_cfg_program_llvm_runtime_value_parameter_storage_owner.pgy";
import "direct_mir_scalar_cfg_program_llvm_condition_diagnostic_owner.pgy";
import "../../../mir/runtime_call_abi_fact_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_scalar_value_result_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_llvm_slice_expression_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_payload_free_enum_result_preamble_owner.pgy";
import "direct_mir_scalar_cfg_range_block_effect_owner.pgy";
import "../../../codegen/runtime_abi/string_runtime_symbol_owner.pgy";
func DirectMirScalarCfgProgramLlvmRoutine(ref plan: DirectMirScalarCfgGraphPlan, ref lifetime: DirectMirOwnedLocalLifetimeFact, routine: Int,
    formatted_print: CompilerRuntimeCallAbiFact, process_exit: CompilerRuntimeCallAbiFact,
    ref runtime: DirectMirScalarProgramRuntimeAbiProjection,
    int_line_format: String, string_line_format: String,
    array_string_projection: Option<DirectMirArrayStringAbiProjection>,
    array_int_projection: Option<DirectMirArrayIntAbiProjection>, target: CompilerTargetProjectionFact
) -> String {
    let output_allocator: Allocator = AllocatorResult();
    let output: TextBuilder = TextBuilderNew(4096);
    TextBuilderAppend(output, DirectMirScalarCfgProgramLlvmRoutineSignature(plan, routine));
    TextBuilderAppend(output, " {\nentry:\n");
    TextBuilderAppend(output, DirectMirIdentityCellRoutineStorage(plan, routine, true));
    if routine == plan.routines.entrypoint_ordinal &&
        plan.program.runtime_abi.process_args_id != 0 {
        TextBuilderAppend(output,
            "  call void @pgy_runtime_process_utf8_argv_export(i32 %argc, ptr %argv, ptr @pgy.selfhost.argc, ptr @pgy.selfhost.argv)\n");
    }
    TextBuilderAppend(output, DirectMirScalarProgramLlvmArrayValueParameterAddressableCopyIn(
        plan, routine, array_string_projection, array_int_projection));
    TextBuilderAppend(output,
        DirectMirScalarProgramLlvmLogicalRecordValueParameterAddressableCopyIn(plan, routine));
    TextBuilderAppend(output, DirectMirScalarProgramLlvmScalarParameterCopyIn(plan, routine));
    TextBuilderAppend(output, DirectMirScalarProgramLlvmArrayIntValueResultCopyIn(plan, routine));
    TextBuilderAppend(output, DirectMirScalarProgramLlvmArrayBoolValueResultCopyIn(plan, routine));
    TextBuilderAppend(output, DirectMirScalarProgramLlvmOwnedArrayStringParameterCopyIn(
            plan, routine, array_string_projection));
    TextBuilderAppend(output, DirectMirScalarProgramLlvmArrayStringValueResultCopyIn(
        plan, routine, array_string_projection));
    TextBuilderAppend(output, DirectMirScalarProgramLlvmLogicalRecordValueResultCopyIn(
            plan, routine));
    TextBuilderAppend(output, DirectMirScalarProgramLlvmLogicalRecordArrayValueResultCopyIn(plan, routine));
    TextBuilderAppend(output, DirectMirScalarProgramLlvmSetStringValueResultCopyIn(plan, routine));
    TextBuilderAppend(output, DirectMirScalarProgramLlvmHashMapParameterCopyIn(plan, routine));
    TextBuilderAppend(output, DirectMirScalarCfgProgramLlvmRuntimeValueParameterStorage(plan, routine));
    TextBuilderAppend(output, DirectMirScalarCfgLlvmLocalDeclarationsInRange(
        plan, plan.routines.local_starts[routine], plan.routines.local_counts[routine], routine, array_string_projection));
    TextBuilderAppend(output, DirectMirOwnedLocalInitialization(plan, lifetime, routine, true));
    let block_start: Int = plan.routines.block_starts[routine];
    let block_end: Int = block_start + plan.routines.block_counts[routine];
    TextBuilderAppend(output, "  br label %pgy.r${routine}.block.${block_start}\n");
    var block: Int = block_start;
    while block < block_end {
        TextBuilderAppend(output, "\npgy.r");
        TextBuilderAppend(output, ToString(routine));
        TextBuilderAppend(output, ".block.");
        TextBuilderAppend(output, ToString(block));
        TextBuilderAppend(output, ":\n");
        var operation: Int = plan.block_operation_starts[block];
        let operation_end: Int = operation +
            plan.block_operation_counts[block];
        while operation < operation_end {
            let emitted: String = DirectMirScalarCfgProgramLlvmOperation(
                plan, lifetime, routine, operation, formatted_print, process_exit,
                runtime, int_line_format, string_line_format, array_string_projection, array_int_projection, target);
            if emitted == "" && (plan.operation_kinds[operation] == DirectMirScalarCfgOpPhiInt() ||
                 plan.operation_kinds[operation] ==
                    DirectMirScalarCfgOpPhiString() ||
                 plan.operation_kinds[operation] ==
                    DirectMirScalarCfgOpPhiValue()) {
                // Memory locals already carry the selected predecessor value.
            }
            if emitted == "" && plan.operation_kinds[operation] !=
                    DirectMirScalarCfgOpPhiInt() &&
                    plan.operation_kinds[operation] !=
                    DirectMirScalarCfgOpPhiString() &&
                    plan.operation_kinds[operation] !=
                    DirectMirScalarCfgOpPhiValue() {
                Die("direct MIR scalar program LLVM operation is unsupported");
            }
            TextBuilderAppend(output, emitted);
            operation = operation + 1;
        }
        TextBuilderAppend(output, DirectMirScalarCfgRangeLlvmBlockEffects(
            plan.range_iterations,
            ArrayLength(plan.block_succ_true), block));
        let return_row: Int =
            plan.program.block_return_expression_rows[block];
        if return_row == DirectMirScalarCfgVoidReturnExpressionRow() {
            if routine == plan.routines.entrypoint_ordinal {
                TextBuilderAppend(output,
                    DirectMirScalarProgramLlvmStringArrayCleanup(
                        plan, lifetime, routine));
            TextBuilderAppend(output, DirectMirOwnedLocalExitCleanup(plan, lifetime, routine, block, true));
                TextBuilderAppend(output, "  ret i32 0\n");
            } else {
                TextBuilderAppend(output, DirectMirScalarProgramLlvmScalarValueResultCopyOut(plan, routine, block));
                TextBuilderAppend(output,
                    DirectMirScalarProgramLlvmArrayStringValueResultCopyOut(
                        plan, routine, block, array_string_projection));
                TextBuilderAppend(output,
                    DirectMirScalarProgramLlvmArrayIntValueResultCopyOut(
                        plan, routine, block));
                TextBuilderAppend(output,
                    DirectMirScalarProgramLlvmArrayBoolValueResultCopyOut(
                        plan, routine, block));
                TextBuilderAppend(output,
                    DirectMirScalarProgramLlvmLogicalRecordValueResultCopyOut(
                        plan, routine, block));
                TextBuilderAppend(output, DirectMirScalarProgramLlvmLogicalRecordArrayValueResultCopyOut(plan, routine, block));
                TextBuilderAppend(output,
                    DirectMirScalarProgramLlvmSetStringValueResultCopyOut(
                        plan, routine, block));
                TextBuilderAppend(output,
                    DirectMirScalarProgramLlvmHashMapValueResultCopyOut(
                        plan, routine, block));
            TextBuilderAppend(output, DirectMirOwnedLocalExitCleanup(plan, lifetime, routine, block, true));
                TextBuilderAppend(output, "  ret void\n");
            }
        } else if return_row >= 0 {
            let expression: DirectMirScalarProgramLlvmExpression =
                DirectMirScalarProgramLlvmExpressionAt(
                    plan, plan.program.expressions, return_row, runtime,
                    plan.program.logical_record,
                    plan.program.payload_free_enum,
                    plan.program.referenced_enum, plan.routines, routine, plan.program.array_string_abi,
                    array_string_projection, plan.program.array_int_value_result, array_int_projection, target);
            if !expression.valid { Die(
                "direct MIR scalar CFG LLVM return expression is invalid"); }
            TextBuilderAppend(output, expression.instructions);
            var return_value: String = expression.value;
            if lifetime.return_clones[return_row] {
                if expression.type_name != CompilerAbiLayoutStringTypeName() ||
                    !CompilerRuntimeCallAbiStringConcatFactReady(
                        runtime.string_concat) {
                    Die("owned String return normalization has no LLVM ABI");
                }
                return_value = "%pgy.return.clone.${block}";
                TextBuilderAppend(output, "  ${return_value} = call ptr @");
                TextBuilderAppend(output, runtime.string_concat.symbol);
                TextBuilderAppend(output,
                    "(ptr @pgy.scalar.owned.return.empty, ptr ${expression.value})\n");
            }
            TextBuilderAppend(output, DirectMirScalarProgramLlvmScalarValueResultCopyOut(plan, routine, block));
            TextBuilderAppend(output,
                DirectMirScalarProgramLlvmArrayIntValueResultCopyOut(
                    plan, routine, block));
            TextBuilderAppend(output,
                DirectMirScalarProgramLlvmArrayBoolValueResultCopyOut(
                    plan, routine, block));
            TextBuilderAppend(output,
                DirectMirScalarProgramLlvmArrayStringValueResultCopyOut(
                    plan, routine, block, array_string_projection));
            TextBuilderAppend(output,
                DirectMirScalarProgramLlvmLogicalRecordValueResultCopyOut(
                    plan, routine, block));
            TextBuilderAppend(output, DirectMirScalarProgramLlvmLogicalRecordArrayValueResultCopyOut(plan, routine, block));
            TextBuilderAppend(output,
                DirectMirScalarProgramLlvmSetStringValueResultCopyOut(
                    plan, routine, block));
            TextBuilderAppend(output,
                DirectMirScalarProgramLlvmHashMapValueResultCopyOut(
                    plan, routine, block));
            TextBuilderAppend(output,
                DirectMirScalarProgramLlvmStringArrayCleanup(plan, lifetime, routine));
            TextBuilderAppend(output, DirectMirOwnedLocalExitCleanup(plan, lifetime, routine, block, true));
            if routine == plan.routines.entrypoint_ordinal {
                TextBuilderAppend(output, "  ret i32 0\n");
            } else {
                TextBuilderAppend(output, "  ret ");
                TextBuilderAppend(output,
                    DirectMirScalarProgramLlvmTypeForProgramWithReferencedEnum(
                    expression.type_name,
                    plan.program.logical_record,
                    plan.program.payload_free_enum,
                    plan.program.referenced_enum));
                TextBuilderAppend(output, " ");
                TextBuilderAppend(output, return_value);
                TextBuilderAppend(output, "\n");
            }
        } else if plan.block_condition_kinds[block] ==
                DirectMirScalarCfgConditionExpression() {
            let condition: DirectMirScalarProgramLlvmExpression =
                DirectMirScalarProgramLlvmExpressionAt(
                    plan, plan.program.expressions,
                    plan.program.block_condition_expression_rows[block],
                    runtime,
                    plan.program.logical_record,
                    plan.program.payload_free_enum,
                    plan.program.referenced_enum, plan.routines, routine, plan.program.array_string_abi,
                    array_string_projection, plan.program.array_int_value_result, array_int_projection, target);
            if !condition.valid || condition.type_name !=
                    CompilerAbiLayoutBoolTypeName() {
                DirectMirScalarCfgProgramLlvmConditionProjectionFailed(
                    plan, routine, block, condition.valid, condition.type_name);
            }
            TextBuilderAppend(output, condition.instructions);
            TextBuilderAppend(output, "  br i1 ");
            TextBuilderAppend(output, condition.value);
            TextBuilderAppend(output, ", label %pgy.r");
            TextBuilderAppend(output, ToString(routine));
            TextBuilderAppend(output, ".block.");
            TextBuilderAppend(output, ToString(plan.block_succ_true[block]));
            TextBuilderAppend(output, ", label %pgy.r");
            TextBuilderAppend(output, ToString(routine));
            TextBuilderAppend(output, ".block.");
            TextBuilderAppend(output, ToString(plan.block_succ_false[block]));
            TextBuilderAppend(output, "\n");
        } else if plan.block_succ_true[block] >= 0 {
            TextBuilderAppend(output, "  br label %pgy.r");
            TextBuilderAppend(output, ToString(routine));
            TextBuilderAppend(output, ".block.");
            TextBuilderAppend(output, ToString(plan.block_succ_true[block]));
            TextBuilderAppend(output, "\n");
        } else if routine == plan.routines.entrypoint_ordinal {
            TextBuilderAppend(output,
                DirectMirScalarProgramLlvmStringArrayCleanup(plan, lifetime, routine));
            TextBuilderAppend(output, DirectMirOwnedLocalExitCleanup(plan, lifetime, routine, block, true));
            TextBuilderAppend(output, "  ret i32 0\n");
        } else if DirectMirScalarProgramBlockEndsWithProcessExit(
                plan.operation_kinds, plan.block_operation_starts[block],
                plan.block_operation_counts[block]) {
            TextBuilderAppend(output, "  unreachable\n");
        } else if return_row == -1 {
            // Readiness proved this is the empty exhaustive-match fallthrough.
            TextBuilderAppend(output, "  unreachable\n");
        } else {
            Die("direct MIR scalar program callable return is missing");
        }
        block = block + 1;
    }
    TextBuilderAppend(output, "}\n");
    let routine_llvm: String = TextBuilderFinish(output, output_allocator);
    AllocatorDestroy(output_allocator);
    return routine_llvm;
}
