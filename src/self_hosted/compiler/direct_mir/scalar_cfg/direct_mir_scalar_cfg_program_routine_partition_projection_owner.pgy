// Scalar-CFG routine partition projection.

import "direct_mir_scalar_cfg_routine_partition_fact_owner.pgy";
import "direct_mir_scalar_cfg_program_routine_identity_owner.pgy";
import "../../../codegen/text/text_owner.pgy";
import "direct_mir_scalar_cfg_program_routine_partition_schema_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_opaque_readonly_zone_fact_owner.pgy";

func DirectMirScalarCfgProgramRoutineStarts(counts: Array<Int>) -> Array<Int> {
    var starts: Array<Int> = [];
    if ArrayLength(counts) < 1 { return starts; }
    var next: Int = 0;
    var row: Int = 0;
    while row < ArrayLength(counts) {
        if counts[row] < 0 {
            let invalid: Array<Int> = [];
            return invalid;
        }
        ArrayPush(starts, next);
        next = next + counts[row];
        row = row + 1;
    }
    return starts;
}

func DirectMirScalarCfgProgramRoutinePartitionFromOwners(
    ref instances: DirectMirRoutineInstanceInventory, cfg_digests: Array<Int>,
    local_counts: Array<Int>, value_counts: Array<Int>,
    block_counts: Array<Int>, operation_counts: Array<Int>, phi_counts: Array<Int>,
    parameter_flow_masks: Array<Int>,
    parameter_array_preserved: Array<Int>,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    ref payload_free_enum: DirectMirScalarProgramPayloadFreeEnumFact,
    ref referenced_enum: DirectMirScalarProgramReferencedEnumFact,
    ref opaque_readonly_zones:
        DirectMirScalarProgramOpaqueReadonlyZoneFact
) -> DirectMirScalarCfgRoutinePartitionFact {
    let routine_count: Int = ArrayLength(local_counts);
    if routine_count < 1 || !DirectMirRoutineInstanceInventoryReady(instances) ||
        ArrayLength(instances.source_rows) != routine_count ||
        ArrayLength(cfg_digests) != routine_count || ArrayLength(value_counts) != routine_count ||
        ArrayLength(block_counts) != routine_count ||
        ArrayLength(operation_counts) != routine_count ||
        ArrayLength(phi_counts) != routine_count {
        Die("direct MIR scalar CFG program routine partition is invalid");
    }
    let identity: DirectMirScalarCfgProgramRoutineIdentity =
        DirectMirScalarCfgProgramRoutineIdentityFromOwners(instances, cfg_digests, logical_record,
            payload_free_enum, referenced_enum, opaque_readonly_zones);
    if !identity.valid {
        Die("direct MIR scalar CFG program routine identity is invalid");
    }
    if ArrayLength(parameter_flow_masks) !=
            ArrayLength(identity.parameter_types) ||
        ArrayLength(parameter_array_preserved) !=
            ArrayLength(identity.parameter_types) {
        Die("direct MIR scalar CFG parameter flow projection is invalid");
    }
    let fact: DirectMirScalarCfgRoutinePartitionFact = DirectMirScalarCfgRoutinePartitionFact(
            true, 0, 0,
            identity.roles, identity.source_rows, identity.source_syntax_ids, identity.instance_keys,
            identity.names, identity.return_types,
            identity.receiver_carriages, identity.receiver_owner_rows,
            identity.parameter_counts,
            identity.parameter_starts, identity.parameter_types, identity.parameter_carriages,
            parameter_flow_masks, parameter_array_preserved,
            identity.signature_digests, identity.cfg_digests,
            DirectMirScalarCfgProgramRoutineStarts(local_counts), local_counts,
            DirectMirScalarCfgProgramRoutineStarts(value_counts), value_counts,
            DirectMirScalarCfgProgramRoutineStarts(block_counts), block_counts,
            DirectMirScalarCfgProgramRoutineStarts(operation_counts), operation_counts,
            DirectMirScalarCfgProgramRoutineStarts(phi_counts), phi_counts);
    return DirectMirScalarCfgRoutinePartitionFact(
        fact.valid, DirectMirScalarCfgRoutinePartitionDigest(fact),
        fact.entrypoint_ordinal, fact.roles, fact.source_rows,
        fact.source_syntax_ids, fact.instance_keys, fact.names, fact.return_types,
        fact.receiver_carriages, fact.receiver_owner_rows,
        fact.parameter_counts, fact.parameter_starts, fact.parameter_types,
        fact.parameter_carriages, fact.parameter_flow_masks,
        fact.parameter_array_preserved,
        fact.signature_digests, fact.cfg_digests, fact.local_starts,
        fact.local_counts, fact.value_starts, fact.value_counts,
        fact.block_starts, fact.block_counts, fact.operation_starts,
        fact.operation_counts, fact.phi_starts, fact.phi_counts);
}

