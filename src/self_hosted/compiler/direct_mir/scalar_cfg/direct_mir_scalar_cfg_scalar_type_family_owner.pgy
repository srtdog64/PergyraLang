// Scalar-CFG scalar and entrypoint type families.

import "../../abi_layout_row_owner.pgy";
import "../../runtime_value_representation_owner.pgy";
import "../../../codegen/runtime_abi/hashmap_llvm_runtime_owner.pgy";
import "../../../mir_lower/routine_fact_index_owner.pgy";

func DirectMirScalarCfgSliceTypeSupported(type_name: String) -> Bool { return type_name == CompilerAbiLayoutSliceIntTypeName() || type_name == CompilerAbiLayoutSliceStringTypeName(); }
func DirectMirScalarCfgScalarTypeSupported(type_name: String) -> Bool {
    return type_name == CompilerAbiLayoutIntTypeName() ||
        type_name == CompilerAbiLayoutLongTypeName() ||
        type_name == CompilerAbiLayoutFloatTypeName() ||
        type_name == CompilerAbiLayoutBoolTypeName() ||
        type_name == CompilerAbiLayoutStringTypeName();
}
// The general scalar program maps the language entrypoint to the host C ABI.
// Void means a synthetic zero status; Int is evaluated for language semantics
// but, like the native wrapper, is not the process exit status.
func DirectMirScalarCfgEntrypointReturnTypeSupported(
    type_name: String
) -> Bool {
    return type_name == CompilerAbiLayoutVoidTypeName() ||
        type_name == CompilerAbiLayoutIntTypeName();
}

