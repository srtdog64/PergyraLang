// String compatibility view over the element-neutral ArrayLength log graph.

import "direct_mir_scalar_cfg_array_length_log_graph_owner.pgy";

struct DirectMirScalarCfgStringArrayLengthLogGraphFact {
    let valid: Bool;
    let collection_name: String;
}

func DirectMirScalarCfgStringArrayLengthLogGraphFactFrom(
    ref graph: MirExpressionGraphSequence
) -> DirectMirScalarCfgStringArrayLengthLogGraphFact {
    let fact: DirectMirScalarCfgArrayLengthLogGraphFact =
        DirectMirScalarCfgArrayLengthLogGraphFactFrom(graph);
    return DirectMirScalarCfgStringArrayLengthLogGraphFact(
        fact.valid, fact.collection_name
    );
}
