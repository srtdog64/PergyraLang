// C materialization selected by the sealed String concat ABI receipt.

import "direct_mir_scalar_cfg_graph_fact_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_collection_ownership_transition_plan_readiness_owner.pgy";
import "../../runtime_call_abi_structured_fact_owner.pgy";
import "../../../codegen/runtime_abi/string_runtime_owner.pgy";

func DirectMirScalarCfgStringCPreamble(
    ref plan: DirectMirScalarCfgGraphPlan,
    concat: CompilerRuntimeCallAbiFact
) -> String {
    if !DirectMirScalarProgramStringConcatMaterializationReached(plan) {
        return "";
    }
    if !CompilerRuntimeCallAbiStringConcatFactReady(concat) ||
        (plan.string_concat_runtime_call_abi_id != 0 &&
            plan.string_concat_runtime_call_abi_id != concat.runtime_call_abi_id) {
        Die("direct MIR scalar CFG String concat C ABI is invalid");
    }
    return Concat(
        "#include <stdlib.h>\n#include <string.h>\n\n",
        StringRuntimeCConcatBlock()
    );
}
