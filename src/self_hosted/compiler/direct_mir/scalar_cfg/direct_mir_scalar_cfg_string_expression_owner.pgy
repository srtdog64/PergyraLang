// String expression admission into typed scalar-CFG operation receipts.
import "direct_mir_scalar_cfg_op_code_owner.pgy";
import "direct_mir_scalar_cfg_value_type_owner.pgy";
import "../../runtime_call_abi_structured_fact_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_logical_record_fact_owner.pgy";
import "../scalar_program/direct_mir_scalar_program_payload_free_enum_fact_owner.pgy";

func DirectMirScalarCfgPhiOperationKind(
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    ref payload_free_enum: DirectMirScalarProgramPayloadFreeEnumFact, type_name: String
) -> Int {
    if type_name == CompilerAbiLayoutIntTypeName() {
        return DirectMirScalarCfgOpPhiInt();
    }
    if type_name == CompilerAbiLayoutStringTypeName() {
        return DirectMirScalarCfgOpPhiString();
    }
    if DirectMirScalarCfgPhiValueTypeReady(
        logical_record, payload_free_enum, type_name) {
        return DirectMirScalarCfgOpPhiValue();
    }
    return 0;
}
func DirectMirScalarCfgPhiValueTypeReady(
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    ref payload_free_enum: DirectMirScalarProgramPayloadFreeEnumFact, type_name: String
) -> Bool {
    return type_name == CompilerAbiLayoutBoolTypeName() ||
        type_name == CompilerAbiLayoutLongTypeName() ||
        type_name == CompilerAbiLayoutOptionIntTypeName() || type_name == CompilerAbiLayoutOptionStringTypeName() || type_name == CompilerAbiLayoutOptionBoolTypeName() ||
        type_name == CompilerAbiLayoutArrayIntTypeName() ||
        type_name == CompilerAbiLayoutArrayBoolTypeName() ||
        type_name == CompilerAbiLayoutArrayStringTypeName() ||
        DirectMirScalarProgramPayloadFreeEnumTypeReady(
            payload_free_enum, type_name) ||
        DirectMirScalarProgramLogicalRecordTypeReady(logical_record, type_name) ||
        DirectMirScalarProgramLogicalRecordOptionTypeReady(
            logical_record, type_name);
}

func DirectMirScalarCfgStringConcatRuntimeCallAbiId(
    operation_kinds: Array<Int>
) -> Int {
    var seen: Bool = false;
    var row: Int = 0;
    while row < ArrayLength(operation_kinds) {
        if operation_kinds[row] == DirectMirScalarCfgOpConcatString() ||
            operation_kinds[row] ==
                DirectMirScalarCfgOpLogArrayIndexConcatString() {
            seen = true;
        }
        row = row + 1;
    }
    if !seen { return 0; }
    let concat: CompilerRuntimeCallAbiFact =
        CompilerRuntimeCallAbiStringConcatFact();
    if !CompilerRuntimeCallAbiStringConcatFactReady(concat) {
        return 0;
    }
    return concat.runtime_call_abi_id;
}
