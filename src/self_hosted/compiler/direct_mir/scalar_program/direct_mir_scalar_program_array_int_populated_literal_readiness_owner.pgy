// Ordered admitted Int operands carried by one populated Array<Int> literal.
import "direct_mir_scalar_program_direct_call_readiness_owner.pgy";
import "direct_mir_scalar_program_logical_record_expression_readiness_owner.pgy";
import "direct_mir_scalar_program_array_int_index_readiness_owner.pgy";
func DirectMirScalarProgramArrayIntPopulatedLiteralOperandRows(
    ref facts: DirectMirScalarProgramExpressionSet, node: Int) -> Array<Int> {
    var rows: Array<Int> = DirectMirScalarProgramNaryOperandRows(facts.nary_operands, node);
    if ArrayLength(rows) != 0 { return rows; }
    if facts.node_lefts[node] >= 0 {
        ArrayPush(rows, facts.node_lefts[node]); }
    if facts.node_rights[node] >= 0 {
        ArrayPush(rows, facts.node_rights[node]); }
    return rows;
}
func DirectMirScalarProgramArrayIntPopulatedLiteralNodeReady(
    ref facts: DirectMirScalarProgramExpressionSet, node: Int) -> Bool {
    if facts.node_kinds[node] !=
            DirectMirScalarProgramExprArrayIntPopulatedLiteral() ||
        facts.node_types[node] != CompilerAbiLayoutArrayIntTypeName() ||
        facts.node_local_rows[node] != -1 ||
        facts.node_parameter_ordinals[node] != -1 ||
        facts.node_member_ordinals[node] != -1 ||
        facts.node_literals[node] != "" ||
        facts.node_callable_rows[node] != -1 { return false; }
    let operands: Array<Int> = DirectMirScalarProgramArrayIntPopulatedLiteralOperandRows(facts, node);
    if ArrayLength(operands) < 1 { return false; }
    let nary: Bool = DirectMirScalarProgramNaryOperandEntry(
        facts.nary_operands, node) >= 0;
    if nary && (ArrayLength(operands) < 3 ||
            facts.node_lefts[node] != -1 ||
            facts.node_rights[node] != -1) { return false; }
    if !nary && (ArrayLength(operands) > 2 ||
            facts.node_lefts[node] < 0) { return false; }
    var row: Int = 0;
    while row < ArrayLength(operands) {
        let operand: Int = operands[row];
        if operand < 0 || operand >= node ||
            facts.node_types[operand] != CompilerAbiLayoutIntTypeName() {
            return false;
        }
        // Every operand node is independently admitted by the expression
        // owner. This container owns order and Int element identity, not a
        // second grammar for the expression producing each element.
        row = row + 1;
    }
    return true;
}
func DirectMirScalarProgramHasArrayIntPopulatedLiteral(
    ref facts: DirectMirScalarProgramExpressionSet
) -> Bool {
    var node: Int = 0;
    while node < ArrayLength(facts.node_kinds) {
        if facts.node_kinds[node] ==
                DirectMirScalarProgramExprArrayIntPopulatedLiteral() {
            return true;
        }
        node = node + 1;
    }
    return false;
}
