// Array<Int> value-result projection from admitted MIR.

import "../direct_mir_array_int_abi_fact_owner.pgy";
import "../direct_mir_array_storage_layout_contract_owner.pgy";
import "direct_mir_scalar_program_owned_array_value_parameter_policy_owner.pgy";
import "../direct_mir_routine_instance_inventory_owner.pgy";
import "direct_mir_scalar_program_parameter_fact_projection_owner.pgy";
import "../scalar_cfg/direct_mir_scalar_cfg_hash_owner.pgy";
import "../../../mir_lower/abi_layout_admission_fact_owner.pgy";
import "../../../mir_lower/routine_fact_index_owner.pgy";
import "../../../mir_lower/machine_layer_fact_owner.pgy";
import "direct_mir_scalar_program_array_int_value_result_schema_owner.pgy";

func DirectMirScalarProgramArrayIntValueResultFactFromAdmitted(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    ref routine_instances: DirectMirRoutineInstanceInventory,
    routine_rows: Array<Int>
) -> DirectMirScalarProgramArrayIntValueResultFact {
    var routines: Array<Int> = [];
    var parameters: Array<Int> = [];
    var digests: Array<Int> = [];
    var layout_id: Int = 0; var size: Int = 0; var align: Int = 0;
    var data_offset: Int = 0; var length_offset: Int = 0;
    var capacity_offset: Int = 0; var allocator_offset: Int = 0;
    var found: Int = 0;
    var routine: Int = 0;
    while routine < ArrayLength(routine_rows) {
        let row: Int = routine_rows[routine];
        let index: MirRoutineFactIndex = BuildMirRoutineFactIndex(
            admitted.routines, row);
        let signature: DirectMirRoutineSignatureFact =
            DirectMirRoutineInstanceSignatureAt(routine_instances, routine);
        if !index.valid || !DirectMirRoutineSignatureFactReady(signature) {
            return DirectMirScalarProgramArrayIntValueResultFactInvalid();
        }
        var parameter: Int = 0;
        while parameter < signature.param_count {
            if signature.parameters.type_names[parameter] ==
                    CompilerAbiLayoutArrayIntTypeName() {
                let fact: DirectMirRoutineParamFact =
                    DirectMirScalarProgramParamFactAtOrdinal(
                        admitted.routines, row, parameter);
                let carriage: String =
                    signature.parameters.carriages[parameter];
                let projected_instance: Bool =
                    routine_instances.instance_rows[routine] >= 0 &&
                    fact.type_name != CompilerAbiLayoutArrayIntTypeName() &&
                    DirectMirArrayIntCapturedAbiReady(
                        routine_instances.array_int_abi);
                var parameter_digest: Int = fact.digest;
                if projected_instance {
                    parameter_digest =
                        signature.parameters.param_digests[parameter];
                }
                if (carriage != "value" && carriage != "value-result" &&
                    carriage != "readonly-ref" &&
                    !DirectMirScalarProgramOwnedArrayValueParameterReady(signature, parameter)) ||
                    signature.parameters.resources[parameter] != "none" ||
                    signature.parameters.pass_shapes[parameter] != "direct" ||
                    !signature.parameters.abi_required[parameter] ||
                    !DirectMirRoutineParamFactReady(fact) ||
                    (!projected_instance &&
                     fact.digest !=
                        signature.parameters.param_digests[parameter]) ||
                    (projected_instance &&
                     (signature.parameters.abi_layout_ids[parameter] !=
                        MirAbiLayoutIdFromCapture(
                            routine_instances.array_int_abi) ||
                      signature.parameters.abi_row_keys[parameter] !=
                        DirectMirAbiRowIdentityText(
                            routine_instances.array_int_abi))) ||
                    (!projected_instance &&
                     !DirectMirArrayIntCapturedAbiReady(fact.abi)) {
                    return DirectMirScalarProgramArrayIntValueResultFactInvalid();
                }
                var candidate_id: Int = 0;
                var candidate_size: Int = 0;
                var candidate_align: Int = 0;
                var candidate_data: Int = 0;
                var candidate_length: Int = 0;
                var candidate_capacity: Int = 0;
                var candidate_allocator: Int = 0;
                if projected_instance {
                    candidate_id = MirAbiLayoutIdFromCapture(
                        routine_instances.array_int_abi);
                    candidate_size = ToInt(
                        routine_instances.array_int_abi.size_text);
                    candidate_align = ToInt(
                        routine_instances.array_int_abi.align_text);
                    candidate_data = ToInt(
                        routine_instances.array_int_abi.field_offsets[0]);
                    candidate_length = ToInt(
                        routine_instances.array_int_abi.field_offsets[1]);
                    candidate_capacity = ToInt(
                        routine_instances.array_int_abi.field_offsets[2]);
                    candidate_allocator = ToInt(
                        routine_instances.array_int_abi.field_offsets[3]);
                } else {
                    candidate_id = MirAbiLayoutIdFromCapture(fact.abi);
                    candidate_size = ToInt(fact.abi.size_text);
                    candidate_align = ToInt(fact.abi.align_text);
                    candidate_data = ToInt(fact.abi.field_offsets[0]);
                    candidate_length = ToInt(fact.abi.field_offsets[1]);
                    candidate_capacity = ToInt(fact.abi.field_offsets[2]);
                    candidate_allocator = ToInt(fact.abi.field_offsets[3]);
                }
                if found == 0 {
                    layout_id = candidate_id; size = candidate_size;
                    align = candidate_align; data_offset = candidate_data;
                    length_offset = candidate_length;
                    capacity_offset = candidate_capacity;
                    allocator_offset = candidate_allocator;
                } else if layout_id != candidate_id || size != candidate_size ||
                    align != candidate_align || data_offset != candidate_data ||
                    length_offset != candidate_length ||
                    capacity_offset != candidate_capacity ||
                    allocator_offset != candidate_allocator {
                    return DirectMirScalarProgramArrayIntValueResultFactInvalid();
                }
                found = found + 1;
                if carriage == "value-result" {
                    ArrayPush(routines, routine);
                    ArrayPush(parameters, parameter);
                    ArrayPush(digests, parameter_digest);
                }
            }
            parameter = parameter + 1;
        }
        var instruction: Int = 0;
        while instruction < ArrayLength(index.instruction_facts.starts) {
            let global: Int = index.instruction_facts.global_start + instruction;
            let capture: MirRoutineInstructionScalarCapture =
                MirRoutineInstructionFactBundleAtGlobal(
                    index.instruction_facts, global);
            if !capture.valid {
                return DirectMirScalarProgramArrayIntValueResultFactInvalid();
            }
            if capture.abi_type_name == CompilerAbiLayoutArrayIntTypeName() {
                if admitted.routines.instruction_kinds[global] != "def" &&
                    admitted.routines.instruction_kinds[global] != "return" {
                    return DirectMirScalarProgramArrayIntValueResultFactInvalid();
                }
                let abi_opt: Option<MirAbiLayoutRowCapture> =
                    MirCapturedRequiredAbiLayoutRowAdmission(
                        admitted.routines.source_json, admitted.routines.source_json_extent,
                        capture.abi_type_name, capture.abi_type_value_ready,
                        capture.abi_type_start, capture.abi_type_end,
                        capture.abi_layout_id_start,
                        capture.abi_layout_id_end,
                        capture.abi_layout_required_start,
                        capture.abi_layout_required_end,
                        capture.abi_layout_start, capture.abi_layout_end);
                if !IsSome(abi_opt) {
                    return DirectMirScalarProgramArrayIntValueResultFactInvalid();
                }
                let abi: MirAbiLayoutRowCapture = UnwrapOption(abi_opt);
                if !DirectMirArrayIntCapturedAbiReady(abi) {
                    return DirectMirScalarProgramArrayIntValueResultFactInvalid();
                }
                let candidate_id: Int = MirAbiLayoutIdFromCapture(abi);
                let candidate_size: Int = ToInt(abi.size_text);
                let candidate_align: Int = ToInt(abi.align_text);
                let candidate_data: Int = ToInt(abi.field_offsets[0]);
                let candidate_length: Int = ToInt(abi.field_offsets[1]);
                let candidate_capacity: Int = ToInt(abi.field_offsets[2]);
                let candidate_allocator: Int = ToInt(abi.field_offsets[3]);
                if found == 0 {
                    layout_id = candidate_id; size = candidate_size;
                    align = candidate_align; data_offset = candidate_data;
                    length_offset = candidate_length;
                    capacity_offset = candidate_capacity;
                    allocator_offset = candidate_allocator;
                } else if layout_id != candidate_id || size != candidate_size ||
                    align != candidate_align || data_offset != candidate_data ||
                    length_offset != candidate_length ||
                    capacity_offset != candidate_capacity ||
                    allocator_offset != candidate_allocator {
                    return DirectMirScalarProgramArrayIntValueResultFactInvalid();
                }
                found = found + 1;
            }
            instruction = instruction + 1;
        }
        routine = routine + 1;
    }
    let present: Bool = found > 0;
    if !present {
        return DirectMirScalarProgramArrayIntValueResultFactCanonicalEmpty();
    }
    let source: DirectMirScalarProgramArrayIntValueResultFact =
        DirectMirScalarProgramArrayIntValueResultFact(
            true, 0, true, layout_id, size, align, data_offset,
            length_offset, capacity_offset, allocator_offset,
            routines, parameters, digests);
    let sealed: DirectMirScalarProgramArrayIntValueResultFact =
        DirectMirScalarProgramArrayIntValueResultFact(
            true, DirectMirScalarProgramArrayIntValueResultFactDigest(source),
            true, layout_id, size, align, data_offset, length_offset,
            capacity_offset, allocator_offset, routines, parameters, digests);
    if !DirectMirScalarProgramArrayIntValueResultFactReady(sealed) {
        return DirectMirScalarProgramArrayIntValueResultFactInvalid();
    }
    return sealed;
}

func DirectMirScalarProgramArrayIntValueResultAt(
    ref fact: DirectMirScalarProgramArrayIntValueResultFact,
    routine: Int, parameter: Int
) -> Bool {
    if !DirectMirScalarProgramArrayIntValueResultFactReady(fact) ||
        !fact.present { return false; }
    var row: Int = 0;
    while row < ArrayLength(fact.routine_ordinals) {
        if fact.routine_ordinals[row] == routine &&
            fact.parameter_ordinals[row] == parameter { return true; }
        row = row + 1;
    }
    return false;
}

