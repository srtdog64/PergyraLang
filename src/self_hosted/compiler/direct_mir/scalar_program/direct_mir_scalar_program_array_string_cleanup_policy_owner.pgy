// Per-local Array<String> element ownership and cleanup policy.

import "../scalar_cfg/direct_mir_scalar_cfg_graph_fact_owner.pgy";
import "direct_mir_scalar_program_array_string_literal_readiness_owner.pgy";
import "direct_mir_scalar_program_owned_array_string_move_query_owner.pgy";
import "../../../codegen/runtime_abi/collection_runtime_owner.pgy";

func DirectMirScalarProgramLegacyArrayStringLocalBorrowsElements(
    ref plan: DirectMirScalarCfgGraphPlan, routine: Int, local_row: Int
) -> Bool {
    if routine < 0 || routine >=
            ArrayLength(plan.routines.operation_starts) ||
        ArrayLength(plan.operation_result_values) !=
            ArrayLength(plan.program.operation_expression_rows) {
        return false;
    }
    var definition_count: Int = 0;
    var operation: Int = plan.routines.operation_starts[routine];
    let end: Int = operation + plan.routines.operation_counts[routine];
    if operation < 0 || end > ArrayLength(plan.operation_result_values) {
        return false;
    }
    while operation < end {
        let expression_row: Int =
            plan.program.operation_expression_rows[operation];
        if expression_row >= 0 && expression_row <
                ArrayLength(plan.program.expressions.graph_roots) {
            let root: Int = plan.program.expressions.graph_roots[expression_row];
            if plan.program.expressions.node_kinds[root] ==
                    DirectMirScalarProgramExprArrayStringPushOwned() {
                let receiver: Int = plan.program.expressions.node_lefts[root];
                if receiver >= 0 &&
                    plan.program.expressions.node_kinds[receiver] ==
                        DirectMirScalarProgramExprLocal() &&
                    plan.program.expressions.node_local_rows[receiver] ==
                        local_row { return false; }
            }
        }
        let result: Int = plan.operation_result_values[operation];
        if result >= 0 && result < ArrayLength(plan.value_local_rows) &&
            plan.value_local_rows[result] == local_row {
            if expression_row < 0 || expression_row >=
                    ArrayLength(plan.program.expressions.graph_roots) {
                return false;
            }
            let root: Int = plan.program.expressions.graph_roots[expression_row];
            if plan.program.expressions.node_kinds[root] !=
                    DirectMirScalarProgramExprArrayStringLiteral() ||
                DirectMirScalarProgramArrayStringLiteralOwnsElements(
                    plan.program.expressions, root, plan.routines, routine) {
                return false;
            }
            definition_count = definition_count + 1;
        }
        operation = operation + 1;
    }
    return definition_count == 1;
}

func DirectMirScalarProgramArrayStringCleanupDropSymbol(
    ref plan: DirectMirScalarCfgGraphPlan, routine: Int, local_row: Int
) -> String {
    let transition_row: Int =
        DirectMirScalarProgramCollectionOwnershipTransitionRow(
            plan.program.collection_ownership, routine, local_row
        );
    if transition_row >= 0 {
        let state: Int = plan.program.collection_ownership.
            terminal_states[transition_row];
        if state == DirectMirCollectionOwnershipStateEmpty() ||
            state == DirectMirCollectionOwnershipStateBorrowed() ||
            state == DirectMirCollectionOwnershipStateUnknown() {
            return CollectionRuntimeCDropStorageFn(2);
        }
        if state == DirectMirCollectionOwnershipStateOwned() {
            return CollectionRuntimeCOwnedStringDropFn();
        }
        return "";
    }
    if DirectMirScalarProgramLegacyArrayStringLocalBorrowsElements(
            plan, routine, local_row) {
        return CollectionRuntimeCDropStorageFn(2);
    }
    return CollectionRuntimeCOwnedStringDropFn();
}

func DirectMirScalarProgramArrayStringLocalCleanupRequired(
    ref plan: DirectMirScalarCfgGraphPlan, routine: Int, local_row: Int
) -> Bool {
    let transition_row: Int =
        DirectMirScalarProgramCollectionOwnershipTransitionRow(
            plan.program.collection_ownership, routine, local_row
        );
    if transition_row >= 0 && plan.program.collection_ownership.
            terminal_states[transition_row] ==
            DirectMirCollectionOwnershipStateRetired() {
        return false;
    }
    return !DirectMirScalarProgramOwnedArrayStringMoveRetiresLocal(
        plan.program.owned_array_string_move, routine, local_row);
}

// A declaration may execute repeatedly. Its fresh RHS is evaluated before
// replacing the local descriptor; the prior lifetime must retire at that
// publication boundary as well as at the final routine exit.
func DirectMirScalarProgramArrayStringReplacementDropSymbol(
    ref plan: DirectMirScalarCfgGraphPlan, routine: Int, operation: Int
) -> String {
    if plan.operation_kinds[operation] != DirectMirScalarCfgOpExpressionDefinition() {
        return "";
    }
    let value: Int = plan.operation_result_values[operation];
    if value < 0 || value >= ArrayLength(plan.value_local_rows) ||
        plan.value_types[value] != CompilerAbiLayoutArrayStringTypeName() {
        return "";
    }
    let local_row: Int = plan.value_local_rows[value];
    if local_row < 0 || plan.local_ref_kinds[local_row] !=
            DirectMirScalarCfgLocalRefValue() {
        return "";
    }
    let graph: Int = plan.program.operation_expression_rows[operation];
    let root: Int = plan.program.expressions.graph_roots[graph];
    if plan.program.expressions.node_kinds[root] !=
            DirectMirScalarProgramExprArrayStringLiteral() {
        return "";
    }
    let transition: Int = DirectMirScalarProgramCollectionOwnershipTransitionRow(
        plan.program.collection_ownership, routine, local_row);
    if transition < 0 {
        Die("direct MIR Array<String> replacement requires its admitted ownership row");
    }
    if !DirectMirScalarProgramArrayStringLocalCleanupRequired(
            plan, routine, local_row) {
        return "";
    }
    let mode: Int = plan.program.collection_ownership.replacement_modes[transition];
    if mode == 1 {
        return CollectionRuntimeCDropStorageFn(2);
    }
    if mode == 2 { return CollectionRuntimeCOwnedStringDropFn(); }
    return "";
}
