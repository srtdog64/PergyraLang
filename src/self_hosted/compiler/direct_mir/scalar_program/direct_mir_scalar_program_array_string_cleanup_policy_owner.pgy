// Per-local Array<String> element ownership and cleanup policy.

import "../scalar_cfg/direct_mir_scalar_cfg_graph_fact_owner.pgy";
import "direct_mir_scalar_program_array_string_literal_readiness_owner.pgy";
import "direct_mir_scalar_program_owned_array_string_move_query_owner.pgy";
import "direct_mir_scalar_program_expression_kind_id_owner.pgy";
import "../scalar_cfg/direct_mir_scalar_cfg_op_code_owner.pgy";
import "../../../codegen/runtime_abi/collection_runtime_owner.pgy";
import "direct_mir_scalar_program_array_string_storage_sharing_owner.pgy";

// With no transition row, the definitions of a local that is never pushed,
// set or popped decide what it owns. A literal of borrowed elements owns only
// its storage. StringSplit, Args, DirWalk and SliceCopy return fresh storage
// whose elements the runtime strdup'd. Any other definition (a user call
// result, an alias of another local) or any element change proves nothing
// and yields "".
func DirectMirScalarProgramUnrowedArrayStringLocalDrop(
    ref plan: DirectMirScalarCfgGraphPlan, routine: Int, local_row: Int
) -> String {
    if routine < 0 || routine >=
            ArrayLength(plan.routines.operation_starts) ||
        ArrayLength(plan.operation_result_values) !=
            ArrayLength(plan.program.operation_expression_rows) {
        return "";
    }
    var borrowed_literals: Int = 0;
    var runtime_results: Int = 0;
    var operation: Int = plan.routines.operation_starts[routine];
    let end: Int = operation + plan.routines.operation_counts[routine];
    if operation < 0 || end > ArrayLength(plan.operation_result_values) ||
        end > ArrayLength(plan.operation_kinds) ||
        end > ArrayLength(plan.operation_left_locals) {
        return "";
    }
    while operation < end {
        let operation_kind: Int = plan.operation_kinds[operation];
        if (operation_kind == DirectMirScalarCfgOpLocalArrayStringPush() ||
                operation_kind == DirectMirScalarCfgOpArrayStringValueResultPush() ||
                operation_kind == DirectMirScalarCfgOpArrayStringSet() ||
                operation_kind == DirectMirScalarCfgOpArrayStringPop()) &&
            plan.operation_left_locals[operation] == local_row {
            return "";
        }
        let expression_row: Int =
            plan.program.operation_expression_rows[operation];
        if expression_row >= 0 && expression_row <
                ArrayLength(plan.program.expressions.graph_roots) {
            let root: Int = plan.program.expressions.graph_roots[expression_row];
            if plan.program.expressions.node_kinds[root] ==
                    DirectMirScalarProgramExprArrayStringPushOwned() ||
                plan.program.expressions.node_kinds[root] ==
                    DirectMirScalarProgramExprArrayStringDropOwned() {
                let receiver: Int = plan.program.expressions.node_lefts[root];
                if receiver >= 0 &&
                    plan.program.expressions.node_kinds[receiver] ==
                        DirectMirScalarProgramExprLocal() &&
                    plan.program.expressions.node_local_rows[receiver] ==
                        local_row { return ""; }
            }
        }
        let result: Int = plan.operation_result_values[operation];
        if result >= 0 && result < ArrayLength(plan.value_local_rows) &&
            plan.value_local_rows[result] == local_row {
            if expression_row < 0 || expression_row >=
                    ArrayLength(plan.program.expressions.graph_roots) {
                return "";
            }
            let root: Int = plan.program.expressions.graph_roots[expression_row];
            let kind: Int = plan.program.expressions.node_kinds[root];
            if kind == DirectMirScalarProgramExprArrayStringLiteral() &&
                !DirectMirScalarProgramArrayStringLiteralOwnsElements(
                    plan.program.expressions, root, plan.routines, routine) {
                borrowed_literals = borrowed_literals + 1;
            } else if kind == DirectMirScalarProgramExprStringSplit() ||
                kind == DirectMirScalarProgramExprProcessArgs() ||
                kind == DirectMirScalarProgramExprDirWalk() ||
                kind == DirectMirScalarProgramExprSliceCopy() {
                runtime_results = runtime_results + 1;
            } else {
                return "";
            }
        }
        operation = operation + 1;
    }
    if borrowed_literals == 1 && runtime_results == 0 {
        return CollectionRuntimeCDropStorageFn(2);
    }
    if runtime_results > 0 && borrowed_literals == 0 {
        return CollectionRuntimeCOwnedStringDropFn();
    }
    return "";
}

// A release of storage that a call, constructor or binding still holds frees
// what that holder reads next. A constructor input is handed to its record
// by the semantic verdict (decision 2026-11-15); a binding the verdict left
// live while a constructor took it has no such fact and is refused.
func DirectMirScalarProgramArrayStringCleanupDropSymbol(
    ref plan: DirectMirScalarCfgGraphPlan, routine: Int, local_row: Int
) -> String {
    let symbol: String = DirectMirScalarProgramArrayStringCleanupDropSymbolFromFacts(
        plan, routine, local_row);
    if symbol != "" && DirectMirScalarProgramArrayStringConstructorInput(plan, routine, local_row) {
        Die(Concat("direct MIR Array<String> constructor input has no hand-off fact: routine=",
            Concat(ToString(routine), Concat(" local=", ToString(local_row)))));
    }
    if symbol != "" && DirectMirScalarProgramArrayStringLocalShared(plan, routine, local_row) {
        Die(Concat("direct MIR Array<String> cleanup refuses storage another holder still has: routine=",
            Concat(ToString(routine), Concat(" local=", ToString(local_row)))));
    }
    return symbol;
}

// An alias of an inout or ref parameter's member that grows in place leaves
// that member on the storage the growth released. Checked once per routine:
// a void callable's exits release no Array<String> local.
func DirectMirScalarProgramArrayStringFormalMemberAliasRefusal(
    ref plan: DirectMirScalarCfgGraphPlan, routine: Int
) -> Void {
    var local_row: Int = plan.routines.local_starts[routine];
    let end: Int = local_row + plan.routines.local_counts[routine];
    while local_row < end {
        if plan.local_types[local_row] == CompilerAbiLayoutArrayStringTypeName() &&
            DirectMirScalarProgramArrayStringFormalMemberAliasGrown(plan, routine, local_row) {
            Die(Concat("direct MIR Array<String> alias of a parameter member grows storage the member still names: routine=",
                Concat(ToString(routine), Concat(" local=", ToString(local_row)))));
        }
        local_row = local_row + 1;
    }
}

func DirectMirScalarProgramArrayStringCleanupDropSymbolFromFacts(
    ref plan: DirectMirScalarCfgGraphPlan, routine: Int, local_row: Int
) -> String {
    let transition_row: Int =
        DirectMirScalarProgramCollectionOwnershipTransitionRow(
            plan.program.collection_ownership, routine, local_row
        );
    if transition_row >= 0 {
        let state: Int = plan.program.collection_ownership.
            terminal_states[transition_row];
        if state == DirectMirCollectionOwnershipStateEmpty() ||
            state == DirectMirCollectionOwnershipStateBorrowed() ||
            state == DirectMirCollectionOwnershipStateUnknown() {
            return CollectionRuntimeCDropStorageFn(2);
        }
        if state == DirectMirCollectionOwnershipStateOwned() {
            return CollectionRuntimeCOwnedStringDropFn();
        }
        return "";
    }
    let unrowed: String = DirectMirScalarProgramUnrowedArrayStringLocalDrop(
        plan, routine, local_row);
    if unrowed != "" { return unrowed; }
    // Neither a row nor a runtime producer: the storage and its elements are
    // unknown (a user call result, an alias of a formal). Releasing either
    // would free what this local may not own.
    Die(Concat("direct MIR Array<String> cleanup requires an admitted ownership row: routine=",
        Concat(ToString(routine), Concat(" local=", ToString(local_row)))));
    return "";
}

func DirectMirScalarProgramArrayStringLocalCleanupRequired(
    ref plan: DirectMirScalarCfgGraphPlan, routine: Int, local_row: Int
) -> Bool {
    let transition_row: Int =
        DirectMirScalarProgramCollectionOwnershipTransitionRow(
            plan.program.collection_ownership, routine, local_row
        );
    if transition_row >= 0 && (plan.program.collection_ownership.
            terminal_states[transition_row] ==
            DirectMirCollectionOwnershipStateRetired() ||
        plan.program.collection_ownership.handed_off[transition_row] == 1) {
        return false;
    }
    // Storage of a by-value formal (the formal, a member path, or a local
    // alias of either) is released by its caller, or by nobody once handed off.
    if DirectMirScalarProgramArrayStringByValueFormalStorage(plan, routine, local_row) {
        return false;
    }
    return !DirectMirScalarProgramOwnedArrayStringMoveRetiresLocal(
        plan.program.owned_array_string_move, routine, local_row);
}

// A declaration may execute repeatedly. Its fresh RHS is evaluated before
// replacing the local descriptor; the prior lifetime must retire at that
// publication boundary as well as at the final routine exit.
func DirectMirScalarProgramArrayStringReplacementDropSymbol(
    ref plan: DirectMirScalarCfgGraphPlan, routine: Int, operation: Int
) -> String {
    if plan.operation_kinds[operation] != DirectMirScalarCfgOpExpressionDefinition() {
        return "";
    }
    let value: Int = plan.operation_result_values[operation];
    if value < 0 || value >= ArrayLength(plan.value_local_rows) ||
        plan.value_types[value] != CompilerAbiLayoutArrayStringTypeName() {
        return "";
    }
    let local_row: Int = plan.value_local_rows[value];
    if local_row < 0 || plan.local_ref_kinds[local_row] !=
            DirectMirScalarCfgLocalRefValue() {
        return "";
    }
    let graph: Int = plan.program.operation_expression_rows[operation];
    let root: Int = plan.program.expressions.graph_roots[graph];
    if plan.program.expressions.node_kinds[root] !=
            DirectMirScalarProgramExprArrayStringLiteral() {
        return "";
    }
    let transition: Int = DirectMirScalarProgramCollectionOwnershipTransitionRow(
        plan.program.collection_ownership, routine, local_row);
    if transition < 0 {
        Die("direct MIR Array<String> replacement requires its admitted ownership row");
    }
    if !DirectMirScalarProgramArrayStringLocalCleanupRequired(
            plan, routine, local_row) {
        return "";
    }
    let mode: Int = plan.program.collection_ownership.replacement_modes[transition];
    // A definition that runs again releases the storage of the previous run;
    // one that runs once releases the zero descriptor.
    if (mode == 1 || mode == 2) &&
        DirectMirScalarProgramOperationInCycle(plan, operation, -1) &&
        DirectMirScalarProgramArrayStringLocalShared(plan, routine, local_row) {
        Die("direct MIR Array<String> replacement refuses storage another holder still has");
    }
    if mode == 1 {
        return CollectionRuntimeCDropStorageFn(2);
    }
    if mode == 2 { return CollectionRuntimeCOwnedStringDropFn(); }
    return "";
}
