// C composition of independently sealed scalar String runtime bodies.

import "direct_mir_scalar_program_c_string_index_materialization_owner.pgy";
import "direct_mir_scalar_program_c_string_trim_materialization_owner.pgy";

func DirectMirScalarProgramCStringScalarMaterialization(
    ref abi: DirectMirScalarProgramRuntimeAbiFact
) -> String {
    return Concat(DirectMirScalarProgramCStringIndexMaterialization(abi),
        DirectMirScalarProgramCStringTrimMaterialization(abi));
}
