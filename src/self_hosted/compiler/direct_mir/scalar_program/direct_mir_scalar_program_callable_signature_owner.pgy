// Scalar-program callable signature support and canonical empty-state checks.
import "../direct_mir_routine_signature_fact_owner.pgy";
import "../../abi_layout_row_owner.pgy";
import "direct_mir_scalar_program_callable_parameter_policy_owner.pgy";
import "direct_mir_scalar_program_callable_parameter_role_plan_owner.pgy";
import "direct_mir_scalar_program_owned_logical_record_return_policy_owner.pgy";
import "direct_mir_scalar_program_readonly_logical_record_string_array_string_value_result_policy_owner.pgy";
import "direct_mir_scalar_program_option_result_return_type_owner.pgy";
import "direct_mir_scalar_program_opaque_readonly_zone_fact_owner.pgy";
func DirectMirScalarProgramComposableCallableSignatureReadyWithReferencedEnum(
    ref signature: DirectMirRoutineSignatureFact,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    ref payload_free_enum: DirectMirScalarProgramPayloadFreeEnumFact,
    ref referenced_enum: DirectMirScalarProgramReferencedEnumFact,
    ref opaque_readonly_zones:
        DirectMirScalarProgramOpaqueReadonlyZoneFact
) -> Bool {
    let option_return: Bool =
        DirectMirScalarProgramOptionResultReturnTypeReady(
            signature.return_type) ||
        DirectMirScalarProgramPayloadEnumOptionTypeReady(
            referenced_enum, signature.return_type);
    let return_ready: Bool = signature.return_type == "Void" ||
        DirectMirScalarCfgScalarTypeSupported(signature.return_type) || DirectMirScalarProgramHashMapTypeReady(signature.return_type) || signature.return_type == CompilerAbiLayoutArrayStringTypeName() || signature.return_type == CompilerAbiLayoutArrayBoolTypeName() || DirectMirScalarProgramPayloadFreeEnumTypeReady(payload_free_enum, signature.return_type) || DirectMirScalarProgramPayloadEnumTypeReady(referenced_enum, signature.return_type) ||
        DirectMirScalarProgramPayloadEnumOptionTypeReady(
            referenced_enum, signature.return_type) ||
        DirectMirScalarProgramPayloadFreeEnumResultTypeReady(
            signature.return_type, logical_record, referenced_enum) ||
        DirectMirScalarProgramLogicalRecordTypeReady(
            logical_record, signature.return_type) ||
        DirectMirScalarProgramLogicalRecordArrayTypeReady(
            logical_record, signature.return_type) ||
        (signature.param_count > 0 && option_return);
    let plan: DirectMirScalarProgramCallableParameterRolePlan = DirectMirScalarProgramCallableParameterRolePlanFromSignatureWithReferencedEnum(
            signature, logical_record, payload_free_enum, referenced_enum,
            opaque_readonly_zones);
    return return_ready && DirectMirScalarProgramCallableParameterRolePlanReady(plan, signature.param_count);
}
func DirectMirScalarProgramComposableCallableSignatureReady(
    ref signature: DirectMirRoutineSignatureFact,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    ref payload_free_enum: DirectMirScalarProgramPayloadFreeEnumFact
) -> Bool {
    let referenced_enum: DirectMirScalarProgramReferencedEnumFact =
        DirectMirScalarProgramReferencedEnumFactCanonicalEmpty();
    let opaque_readonly_zones:
        DirectMirScalarProgramOpaqueReadonlyZoneFact =
            DirectMirScalarProgramOpaqueReadonlyZoneFactEmpty();
    return DirectMirScalarProgramComposableCallableSignatureReadyWithReferencedEnum(
        signature, logical_record, payload_free_enum, referenced_enum,
        opaque_readonly_zones);
}
func DirectMirScalarProgramCallableSignatureSupportedWithReferencedEnum(
    ref signature: DirectMirRoutineSignatureFact,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    ref payload_free_enum: DirectMirScalarProgramPayloadFreeEnumFact,
    ref referenced_enum: DirectMirScalarProgramReferencedEnumFact,
    ref opaque_readonly_zones:
        DirectMirScalarProgramOpaqueReadonlyZoneFact
) -> Bool {
    if !DirectMirRoutineSignatureFactReady(signature) { return false; }
    if signature.kind == "intent" {
        // MIR already owns the synthesized participant/value binder. This
        // admits only its signature; the CFG cleanup protocol remains a
        // separate mandatory consumer before an artifact can be published.
        return signature.return_type == CompilerAbiLayoutBoolTypeName() &&
            DirectMirRoutineIntentParameterSetReady(signature.parameters) &&
            DirectMirScalarProgramComposableCallableSignatureReadyWithReferencedEnum(
                signature, logical_record, payload_free_enum,
                referenced_enum, opaque_readonly_zones);
    }
    if signature.param_count == 0 {
        return DirectMirScalarProgramComposableCallableSignatureReadyWithReferencedEnum(
                signature, logical_record, payload_free_enum,
                referenced_enum, opaque_readonly_zones) ||
            DirectMirScalarProgramZeroParameterReturnTypeSupportedWithReferencedEnum(
                signature.return_type, logical_record, referenced_enum) ||
            DirectMirScalarProgramOwnedArrayStringReturnSignatureReady(
                signature);
    }
    let int_or_option: Bool = signature.return_type ==
            CompilerAbiLayoutIntTypeName() ||
        signature.return_type == CompilerAbiLayoutOptionIntTypeName();
    let option_string: Bool = signature.return_type == CompilerAbiLayoutOptionStringTypeName(); let option_bool: Bool = signature.return_type == CompilerAbiLayoutOptionBoolTypeName();
    let long_return: Bool = signature.return_type == CompilerAbiLayoutLongTypeName(); let array_int_return: Bool = signature.return_type == CompilerAbiLayoutArrayIntTypeName();
    let logical_record_return: Bool = DirectMirScalarProgramLogicalRecordTypeReady(logical_record, signature.return_type);
    let logical_record_option_return: Bool = DirectMirScalarProgramLogicalRecordOptionTypeReady(logical_record, signature.return_type);
    let payload_enum_option_return: Bool =
        DirectMirScalarProgramPayloadEnumOptionTypeReady(
            referenced_enum, signature.return_type);
    if logical_record_return && signature.param_count == 1 &&
        signature.parameters.type_names[0] == signature.return_type &&
        signature.parameters.carriages[0] == "value-result" { return false; }
    let composable_callable: Bool =
        DirectMirScalarProgramComposableCallableSignatureReadyWithReferencedEnum(
            signature, logical_record, payload_free_enum, referenced_enum,
            opaque_readonly_zones);
    let logical_record_value_result: Bool = DirectMirScalarProgramLogicalRecordValueResultSignatureReady(
            signature, logical_record);
    let logical_record_array_value_result: Bool =
        DirectMirScalarProgramLogicalRecordArrayValueResultSignatureReady(
            signature, logical_record);
    let logical_record_array_value_parameter: Bool =
        DirectMirScalarProgramLogicalRecordArrayValueParameterSignatureReady(
            signature, logical_record);
    let logical_record_mixed_collection_value_result: Bool =
        DirectMirScalarProgramLogicalRecordMixedCollectionValueResultSignatureReady(
        signature, logical_record);
    let array_string_value_result: Bool =
        DirectMirScalarProgramArrayStringValueResultSignatureReady(
            signature);
    let owned_array_string_return: Bool =
        DirectMirScalarProgramOwnedArrayStringReturnSignatureReady(signature);
    var shape_ready: Bool = int_or_option || option_string || option_bool ||
        long_return || array_int_return ||
        logical_record_return || logical_record_option_return ||
        payload_enum_option_return ||
        composable_callable || logical_record_value_result ||
        logical_record_array_value_result ||
        logical_record_array_value_parameter ||
        logical_record_mixed_collection_value_result ||
        DirectMirScalarProgramBoolMixedCollectionValueResultSignatureReady(signature) ||
        DirectMirScalarProgramVoidLogicalRecordArrayIntValueResultSignatureReady(signature, logical_record) ||
        DirectMirScalarProgramLogicalRecordInputsValueResultSignatureReady(signature, logical_record) || DirectMirScalarProgramReadonlyLogicalRecordArrayStringValueResultSignatureReady(signature, logical_record) || DirectMirScalarProgramBoolTwoArrayStringTwoArrayIntValueResultSignatureReady(signature) || DirectMirScalarProgramOwnedLogicalRecordReturnSignatureReady(signature, logical_record) || DirectMirScalarProgramReadonlyLogicalRecordStringArrayStringValueResultSignatureReady(signature, logical_record) || DirectMirScalarProgramVoidLogicalRecordArrayStringValueResultSignatureReady(signature, logical_record) ||
        array_string_value_result || owned_array_string_return;
    if signature.param_count == 1 {
        shape_ready = shape_ready ||
            (signature.return_type == CompilerAbiLayoutBoolTypeName() &&
             signature.param.type_name == CompilerAbiLayoutIntTypeName()) ||
            (signature.return_type == CompilerAbiLayoutStringTypeName() &&
             (signature.param.type_name == CompilerAbiLayoutStringTypeName() ||
              signature.param.type_name ==
                CompilerAbiLayoutArrayStringTypeName()));
    }
    if !shape_ready { return false; }
    var ordinal: Int = 0;
    while ordinal < signature.param_count {
        let int_or_option_parameter: Bool =
            signature.parameters.type_names[ordinal] ==
                CompilerAbiLayoutIntTypeName() ||
            ((signature.parameters.type_names[ordinal] ==
                CompilerAbiLayoutArrayIntTypeName() ||
              signature.parameters.type_names[ordinal] ==
                CompilerAbiLayoutArrayStringTypeName()) &&
             signature.parameters.carriages[ordinal] == "value");
        if !DirectMirScalarProgramCallableParameterSupportedWithReferencedEnum(
                signature, ordinal, logical_record,
                payload_free_enum, referenced_enum,
                opaque_readonly_zones) ||
            (int_or_option && !composable_callable &&
             !int_or_option_parameter &&
             !array_string_value_result) ||
            ((option_string || option_bool) && !composable_callable &&
             !DirectMirScalarCfgScalarTypeSupported(
                signature.parameters.type_names[ordinal])) ||
            (logical_record_return && !
             DirectMirScalarProgramCallableParameterSupportedWithReferencedEnum(
                signature, ordinal, logical_record,
                payload_free_enum, referenced_enum,
                opaque_readonly_zones)) ||
            (logical_record_return && !composable_callable &&
             signature.parameters.type_names[ordinal] == CompilerAbiLayoutArrayStringTypeName() &&
             signature.parameters.carriages[ordinal] == "value-result" &&
             !logical_record_mixed_collection_value_result &&
             !DirectMirScalarProgramLogicalRecordReturnArrayStringValueResultSignatureReady(signature, logical_record)) {
            return false;
        }
        ordinal = ordinal + 1;
    }
    return true;
}
func DirectMirScalarProgramCallableSignatureSupportedWithFacts(
    ref signature: DirectMirRoutineSignatureFact,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    ref payload_free_enum: DirectMirScalarProgramPayloadFreeEnumFact
) -> Bool {
    let referenced_enum: DirectMirScalarProgramReferencedEnumFact =
        DirectMirScalarProgramReferencedEnumFactCanonicalEmpty();
    let opaque_readonly_zones:
        DirectMirScalarProgramOpaqueReadonlyZoneFact =
            DirectMirScalarProgramOpaqueReadonlyZoneFactEmpty();
    return DirectMirScalarProgramCallableSignatureSupportedWithReferencedEnum(
        signature, logical_record, payload_free_enum,
        referenced_enum, opaque_readonly_zones);
}
func DirectMirScalarProgramCallableSignatureSupported(
    ref signature: DirectMirRoutineSignatureFact
) -> Bool {
    let logical_record: DirectMirScalarProgramLogicalRecordFact =
        DirectMirScalarProgramLogicalRecordFactCanonicalEmpty();
    let payload_free_enum: DirectMirScalarProgramPayloadFreeEnumFact =
        DirectMirScalarProgramPayloadFreeEnumFactCanonicalEmpty();
    return DirectMirScalarProgramCallableSignatureSupportedWithFacts(
        signature, logical_record, payload_free_enum);
}
