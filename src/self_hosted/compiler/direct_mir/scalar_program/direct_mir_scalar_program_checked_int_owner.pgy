// Checked Int calls retain the canonical i32 overflow boundary and ABI identity.
import "direct_mir_scalar_program_expression_fact_owner.pgy";
import "../../runtime_call_abi_structured_fact_owner.pgy";

func DirectMirScalarProgramCheckedIntKind(kind: Int) -> Bool {
    return kind == DirectMirScalarProgramExprCheckedAddInt() ||
        kind == DirectMirScalarProgramExprCheckedMulInt() ||
        kind == DirectMirScalarProgramExprDivideInt();
}

func DirectMirScalarProgramCheckedIntRuntimeFact(kind: Int) -> CompilerRuntimeCallAbiFact {
    var operation: String = ""; var symbol: String = "";
    if kind == DirectMirScalarProgramExprCheckedAddInt() {
        operation = "int-add"; symbol = CheckedBuiltinRuntimeLlvmAddFn();
    } else if kind == DirectMirScalarProgramExprCheckedMulInt() {
        operation = "int-multiply"; symbol = CheckedBuiltinRuntimeLlvmMulFn();
    } else if kind == DirectMirScalarProgramExprDivideInt() {
        operation = "int-division"; symbol = CheckedArithmeticRuntimeCIntDivisionFn();
    } else { return CompilerRuntimeCallAbiFactMissing(); }
    let fact: CompilerRuntimeCallAbiFact = CompilerRuntimeCallAbiFactFromRowInput(
        CompilerRuntimeCallAbiRowInput("checked-arithmetic", operation, symbol,
            CompilerRuntimeCallAbiMaterialTargetLibrary()));
    if !fact.ok || fact.call_shape != "i32_i32_to_i32" {
        return CompilerRuntimeCallAbiFactMissing();
    }
    return fact;
}

// Native's safe literal divisor rule (src/codegen/codegen_scalar_arithmetic_policy.c):
// an Int `/` or `%` whose divisor is an Int literal other than 0 and -1, inside
// i32, is a plain operation. Long, a negated literal (`-7` is negate(7) in MIR,
// as in the native AST) and every other divisor keep the checked helper. The
// divisor is the MIR integer_literal operand fact the expression set carries.
func DirectMirScalarProgramSafeLiteralDivisor(
    ref facts: DirectMirScalarProgramExpressionSet, type_name: String, divisor: Int
) -> Bool {
    if type_name != CompilerAbiLayoutIntTypeName() || divisor < 0 ||
        divisor >= ArrayLength(facts.node_kinds) ||
        facts.node_kinds[divisor] != DirectMirScalarProgramExprIntLiteral() ||
        facts.node_types[divisor] != CompilerAbiLayoutIntTypeName() ||
        !DirectMirScalarCfgCanonicalInt(facts.node_literals[divisor]) { return false; }
    let value: Int = ToInt(facts.node_literals[divisor]);
    return value != 0 && value != -1;
}

func DirectMirScalarProgramSafeLiteralDivisionNode(
    ref facts: DirectMirScalarProgramExpressionSet, node: Int
) -> Bool {
    let kind: Int = facts.node_kinds[node];
    return (kind == DirectMirScalarProgramExprDivideInt() ||
            kind == DirectMirScalarProgramExprModuloInt()) &&
        DirectMirScalarProgramSafeLiteralDivisor(facts, facts.node_types[node], facts.node_rights[node]);
}

// A checked call of `kind` stays reached while one of its nodes is not a safe
// literal division; helper declarations and headers follow this, not the kind.
func DirectMirScalarProgramCheckedCallReached(
    ref facts: DirectMirScalarProgramExpressionSet, kind: Int
) -> Bool {
    var node: Int = 0;
    while node < ArrayLength(facts.node_kinds) {
        if facts.node_kinds[node] == kind &&
            !DirectMirScalarProgramSafeLiteralDivisionNode(facts, node) { return true; }
        node = node + 1;
    }
    return false;
}

// The checked helpers' own operand widths: Int division on i32, Int remainder
// on the i64 lane (pgy_checked_mod_i64_export), so the values are unchanged.
func DirectMirScalarProgramCSafeLiteralDivision(divide: Bool, left: String, right: String) -> String {
    if divide {
        let narrow: String = CompilerAbiLayoutIntCValueType();
        return "((${narrow})(${left}) / (${narrow})(${right}))";
    }
    let wide: String = CompilerAbiLayoutLongCValueType();
    return "((${wide})(${left}) % (${wide})(${right}))";
}

func DirectMirScalarProgramLlvmSafeLiteralDivision(
    divide: Bool, result: String, left: String, right: String
) -> String {
    if divide {
        return "  ${result}.lhs = trunc i64 ${left} to i32\n  ${result}.rhs = trunc i64 ${right} to i32\n  ${result}.i32 = sdiv i32 ${result}.lhs, ${result}.rhs\n  ${result} = sext i32 ${result}.i32 to i64\n";
    }
    return "  ${result} = srem i64 ${left}, ${right}\n";
}

func DirectMirScalarProgramCheckedIntNodeReady(
    ref facts: DirectMirScalarProgramExpressionSet, node: Int
) -> Bool {
    let abi: CompilerRuntimeCallAbiFact =
        DirectMirScalarProgramCheckedIntRuntimeFact(facts.node_kinds[node]);
    let left: Int = facts.node_lefts[node]; let right: Int = facts.node_rights[node];
    return abi.ok && facts.node_runtime_call_abi_ids[node] == abi.runtime_call_abi_id &&
        facts.node_types[node] == CompilerAbiLayoutIntTypeName() &&
        left >= 0 && left < node && right >= 0 && right < node &&
        facts.node_types[left] == CompilerAbiLayoutIntTypeName() &&
        facts.node_types[right] == CompilerAbiLayoutIntTypeName() &&
        facts.node_local_rows[node] == -1 && facts.node_parameter_ordinals[node] == -1 &&
        facts.node_member_ordinals[node] == -1 && facts.node_callable_rows[node] == -1 &&
        facts.node_literals[node] == "" &&
        ArrayLength(DirectMirScalarProgramNaryOperandRows(facts.nary_operands, node)) == 0;
}
