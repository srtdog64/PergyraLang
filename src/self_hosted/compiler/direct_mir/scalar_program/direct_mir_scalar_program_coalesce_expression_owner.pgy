// C and LLVM projection of the `??` condition admitted by
// direct_mir_scalar_program_coalesce_expression_kind_owner.pgy.
import "direct_mir_scalar_program_coalesce_expression_kind_owner.pgy";
import "direct_mir_scalar_program_llvm_string_expression_fact_owner.pgy";
import "direct_mir_scalar_program_llvm_option_int_owner.pgy";

func DirectMirScalarProgramCCoalesceAt(
    ref expressions: DirectMirScalarProgramExpressionSet, node: Int, left: String, right: String
) -> Option<String> {
    let kind: Int = expressions.node_kinds[node];
    if kind == DirectMirScalarProgramExprCoalesceOptionInt() {
        return Some("pgy_scalar_option_int_coalesce(" + left + ", " + right + ")");
    }
    if kind == DirectMirScalarProgramExprCoalesceOptionBool() {
        return Some("pgy_scalar_option_bool_coalesce(" + left + ", " + right + ")");
    }
    return None;
}

func DirectMirScalarProgramLlvmCoalesceAt(
    ref expressions: DirectMirScalarProgramExpressionSet, node: Int, result: String,
    left: String, right: String
) -> DirectMirScalarProgramLlvmStringExpression {
    let kind: Int = expressions.node_kinds[node];
    var output: String = "";
    if kind == DirectMirScalarProgramExprCoalesceOptionInt() {
        let option_type: String = DirectMirScalarProgramLlvmOptionIntTypeName();
        output = "  " + result + ".some = call i1 @pgy.scalar.option.int.is_some(" + option_type + " " + left + ")\n";
        output = output + "  " + result + ".payload = call i64 @pgy.scalar.option.int.payload(" + option_type +
            " " + left + ")\n";
        output = output + "  " + result + " = select i1 " + result + ".some, i64 " + result + ".payload, i64 " +
            right + "\n";
        return DirectMirScalarProgramLlvmStringExpression(true, true, output, result);
    }
    if kind == DirectMirScalarProgramExprCoalesceOptionBool() {
        output = "  " + result + ".some = call i1 @pgy.scalar.option.bool.is_some(%pgy.scalar.option.bool " +
            left + ")\n";
        output = output + "  " + result + ".payload = extractvalue %pgy.scalar.option.bool " + left + ", 1\n";
        output = output + "  " + result + " = select i1 " + result + ".some, i1 " + result + ".payload, i1 " +
            right + "\n";
        return DirectMirScalarProgramLlvmStringExpression(true, true, output, result);
    }
    return DirectMirScalarProgramLlvmStringExpressionMissing();
}
