// Target-neutral terminal ownership state for receipt-tracked Array<String> locals.

import "../scalar_cfg/direct_mir_scalar_cfg_hash_owner.pgy";
import "direct_mir_scalar_program_collection_ownership_row_index_owner.pgy";

func DirectMirCollectionOwnershipStateEmpty() -> Int { return 1; }
func DirectMirCollectionOwnershipStateBorrowed() -> Int { return 2; }
func DirectMirCollectionOwnershipStateOwned() -> Int { return 3; }
func DirectMirCollectionOwnershipStateRetired() -> Int { return 4; }
func DirectMirCollectionOwnershipStateUnknown() -> Int { return 5; }

struct DirectMirScalarProgramCollectionOwnershipTransitionFact {
    let valid: Bool;
    let digest: Int;
    let routine_ordinals: Array<Int>;
    let local_rows: Array<Int>;
    let binding_syntax_ids: Array<Int>;
    let terminal_states: Array<Int>;
    // 0: no replacement proof; 1: storage only; 2: owned String elements.
    let replacement_modes: Array<Int>;
    // Exact instruction receipts, keyed by the global MIR operation ordinal.
    // Emitters consume these rows instead of reconstructing ownership effects
    // from an operation kind or terminal local state.
    let operation_ordinals: Array<Int>;
    let operation_effect_kinds: Array<Int>;
}

func DirectMirScalarProgramCollectionOwnershipTransitionFactEmpty(
) -> DirectMirScalarProgramCollectionOwnershipTransitionFact {
    let routines: Array<Int> = [];
    let locals: Array<Int> = [];
    let bindings: Array<Int> = [];
    let states: Array<Int> = [];
    let operations: Array<Int> = []; let effects: Array<Int> = [];
    return DirectMirScalarProgramCollectionOwnershipTransitionFact(
        true, 0, routines, locals, bindings, states, states, operations, effects
    );
}

func DirectMirScalarProgramCollectionOwnershipTransitionFactInvalid(
) -> DirectMirScalarProgramCollectionOwnershipTransitionFact {
    let routines: Array<Int> = [];
    let locals: Array<Int> = [];
    let bindings: Array<Int> = [];
    let states: Array<Int> = [];
    let operations: Array<Int> = []; let effects: Array<Int> = [];
    return DirectMirScalarProgramCollectionOwnershipTransitionFact(
        false, 0, routines, locals, bindings, states, states, operations, effects
    );
}

func DirectMirScalarProgramCollectionOwnershipTransitionFactDigest(
    ref fact: DirectMirScalarProgramCollectionOwnershipTransitionFact
) -> Int {
    if !fact.valid { return 0; }
    var hash: Long = DirectMirScalarCfgHashInts(
        389L, fact.routine_ordinals
    );
    hash = DirectMirScalarCfgHashInts(hash, fact.local_rows);
    hash = DirectMirScalarCfgHashInts(hash, fact.binding_syntax_ids);
    hash = DirectMirScalarCfgHashInts(hash, fact.terminal_states);
    hash = DirectMirScalarCfgHashInts(hash, fact.replacement_modes);
    hash = DirectMirScalarCfgHashInts(hash, fact.operation_ordinals);
    hash = DirectMirScalarCfgHashInts(hash, fact.operation_effect_kinds);
    return DirectMirCfgBoundedDigest(hash);
}

func DirectMirScalarProgramCollectionOwnershipTransitionFactWithDigest(
    fact: DirectMirScalarProgramCollectionOwnershipTransitionFact
) -> DirectMirScalarProgramCollectionOwnershipTransitionFact {
    return DirectMirScalarProgramCollectionOwnershipTransitionFact(
        fact.valid,
        DirectMirScalarProgramCollectionOwnershipTransitionFactDigest(fact),
        fact.routine_ordinals, fact.local_rows,
        fact.binding_syntax_ids, fact.terminal_states, fact.replacement_modes,
        fact.operation_ordinals, fact.operation_effect_kinds
    );
}

func DirectMirScalarProgramCollectionOwnershipTransitionFactSealOrDie(
    fact: DirectMirScalarProgramCollectionOwnershipTransitionFact
) -> DirectMirScalarProgramCollectionOwnershipTransitionFact {
    let sealed: DirectMirScalarProgramCollectionOwnershipTransitionFact =
        DirectMirScalarProgramCollectionOwnershipTransitionFactWithDigest(fact);
    if !DirectMirScalarProgramCollectionOwnershipTransitionFactReady(sealed) {
        Die("direct MIR collection ownership transition fact is invalid");
    }
    return sealed;
}

func DirectMirScalarProgramCollectionOwnershipTransitionFactReady(
    ref fact: DirectMirScalarProgramCollectionOwnershipTransitionFact
) -> Bool {
    let count: Int = ArrayLength(fact.routine_ordinals);
    if !fact.valid || fact.digest == 0 || fact.digest !=
            DirectMirScalarProgramCollectionOwnershipTransitionFactDigest(fact) ||
        count != ArrayLength(fact.local_rows) ||
        count != ArrayLength(fact.binding_syntax_ids) ||
        count != ArrayLength(fact.terminal_states) ||
        count != ArrayLength(fact.replacement_modes) ||
        ArrayLength(fact.operation_ordinals) !=
            ArrayLength(fact.operation_effect_kinds) {
        return false;
    }
    var row: Int = 0;
    while row < count {
        if fact.routine_ordinals[row] < 0 || fact.local_rows[row] < 0 ||
            fact.binding_syntax_ids[row] <= 0 ||
            (fact.terminal_states[row] !=
                DirectMirCollectionOwnershipStateEmpty() &&
             fact.terminal_states[row] !=
                DirectMirCollectionOwnershipStateBorrowed() &&
             fact.terminal_states[row] !=
                DirectMirCollectionOwnershipStateOwned() &&
             fact.terminal_states[row] !=
                DirectMirCollectionOwnershipStateRetired() &&
             fact.terminal_states[row] !=
                DirectMirCollectionOwnershipStateUnknown()) {
            return false;
        }
        let mode: Int = fact.replacement_modes[row];
        if mode < 0 || mode > 2 ||
            (mode == 2 && fact.terminal_states[row] != DirectMirCollectionOwnershipStateOwned()) ||
            (mode == 1 && fact.terminal_states[row] != DirectMirCollectionOwnershipStateEmpty() &&
                fact.terminal_states[row] != DirectMirCollectionOwnershipStateBorrowed() &&
                fact.terminal_states[row] != DirectMirCollectionOwnershipStateUnknown()) {
            return false;
        }
        var prior: Int = 0;
        while prior < row {
            if (fact.routine_ordinals[prior] == fact.routine_ordinals[row] &&
                    fact.local_rows[prior] == fact.local_rows[row]) ||
                fact.binding_syntax_ids[prior] ==
                    fact.binding_syntax_ids[row] {
                return false;
            }
            prior = prior + 1;
        }
        row = row + 1;
    }
    row = 0;
    while row < ArrayLength(fact.operation_ordinals) {
        if fact.operation_ordinals[row] < 0 ||
            fact.operation_effect_kinds[row] < 1 ||
            fact.operation_effect_kinds[row] > 5 {
            return false;
        }
        var prior: Int = 0;
        while prior < row {
            if fact.operation_ordinals[prior] ==
                    fact.operation_ordinals[row] {
                return false;
            }
            prior = prior + 1;
        }
        row = row + 1;
    }
    return true;
}

func DirectMirScalarProgramCollectionOwnershipOperationEffect(
    ref fact: DirectMirScalarProgramCollectionOwnershipTransitionFact,
    operation: Int
) -> Int {
    if operation < 0 || ArrayLength(fact.operation_ordinals) !=
            ArrayLength(fact.operation_effect_kinds) {
        return -1;
    }
    var effect: Int = 0;
    var row: Int = 0;
    while row < ArrayLength(fact.operation_ordinals) {
        if fact.operation_ordinals[row] == operation {
            if effect != 0 { return -1; }
            effect = fact.operation_effect_kinds[row];
        }
        row = row + 1;
    }
    return effect;
}

func DirectMirScalarProgramCollectionOwnershipTransitionRow(
    ref fact: DirectMirScalarProgramCollectionOwnershipTransitionFact,
    routine: Int, local_row: Int
) -> Int {
    return DirectMirScalarProgramCollectionOwnershipTransitionRowIn(fact.routine_ordinals, fact.local_rows, routine, local_row);
}
