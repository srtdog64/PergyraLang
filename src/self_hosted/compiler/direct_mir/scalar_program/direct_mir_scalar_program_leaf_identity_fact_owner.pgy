// Identity priority for one scalar-program leaf expression.

import "../../../semantic/ast_expression/ast_expression_identity_fact_owner.pgy";

struct DirectMirScalarProgramLeafIdentityFact {
    valid: Bool;
    bound_local: Int;
    parameter_ordinal: Int;
}

func DirectMirScalarProgramLeafIdentityFactFromOwners(
    ref bound_texts: Array<String>,
    ref bound_locals: Array<Int>,
    text: String,
    binding_kind: Int,
    binding_syntax_id: Int,
    binding_ordinal: Int,
    source_parameter_offset: Int,
    ref parameter_names: Array<String>,
    ref parameter_syntax_ids: Array<Int>
) -> DirectMirScalarProgramLeafIdentityFact {
    let parameter_count: Int = ArrayLength(parameter_names);
    if ArrayLength(bound_texts) != ArrayLength(bound_locals) ||
        parameter_count != ArrayLength(parameter_syntax_ids) {
        return DirectMirScalarProgramLeafIdentityFact(false, -1, -1);
    }
    var parameter_ordinal: Int = -1;
    if binding_kind == SemanticExpressionBindingFormalParameter() {
        let abi_ordinal: Int = binding_ordinal + source_parameter_offset;
        if binding_ordinal < 0 || source_parameter_offset < 0 ||
            source_parameter_offset > 1 || abi_ordinal < 0 ||
            abi_ordinal >= parameter_count ||
            binding_syntax_id <= 0 ||
            parameter_syntax_ids[abi_ordinal] != binding_syntax_id ||
            parameter_names[abi_ordinal] != text {
            return DirectMirScalarProgramLeafIdentityFact(false, -1, -1);
        }
        parameter_ordinal = abi_ordinal;
    }
    var bound_local: Int = -1;
    var row: Int = 0;
    while row < ArrayLength(bound_texts) {
        if bound_texts[row] == text {
            if bound_local >= 0 && bound_local != bound_locals[row] {
                return DirectMirScalarProgramLeafIdentityFact(
                    false, -1, -1
                );
            }
            bound_local = bound_locals[row];
        }
        row = row + 1;
    }
    return DirectMirScalarProgramLeafIdentityFact(
        true, bound_local, parameter_ordinal
    );
}

// Declaration identity cannot repair a conflicting published owner. An absent
// wire row is allowed only when optional or replaced by an admitted SSA use.
func DirectMirScalarProgramFormalWireIdentityReady(
    published: String, instruction_owner: String, expected: String,
    required: Bool, has_ssa: Bool
) -> Bool {
    if published != "" { return published == expected; }
    if instruction_owner == expected { return true; }
    return !required || has_ssa;
}
