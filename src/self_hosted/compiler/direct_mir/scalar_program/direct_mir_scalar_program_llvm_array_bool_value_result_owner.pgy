// LLVM value-result copy boundary for admitted Array<Bool> parameters.

import "../scalar_cfg/direct_mir_scalar_cfg_graph_fact_owner.pgy";
import "direct_mir_scalar_program_scalar_value_result_storage_owner.pgy";

func DirectMirScalarProgramLlvmArrayBoolMutationTarget(
    ref plan: DirectMirScalarCfgGraphPlan, routine: Int, parameter: Int
) -> Bool {
    var offset: Int = 0;
    while offset < plan.routines.operation_counts[routine] {
        let operation: Int = plan.routines.operation_starts[routine] + offset;
        let kind: Int = plan.operation_kinds[operation];
        if (kind == DirectMirScalarCfgOpArrayBoolPush() ||
            kind == DirectMirScalarCfgOpArrayBoolSet()) &&
            plan.operation_right_locals[operation] == parameter {
            return true;
        }
        offset = offset + 1;
    }
    return false;
}

func DirectMirScalarProgramLlvmArrayBoolValueResultCopyIn(
    ref plan: DirectMirScalarCfgGraphPlan, routine: Int
) -> String {
    var output: String = "";
    var parameter: Int = 0;
    while parameter < plan.routines.parameter_counts[routine] {
        if DirectMirScalarProgramArrayBoolValueResultAt(
                plan.program.array_bool_abi, routine, parameter) {
            output = Concat(output, "  %pgy.param.");
            output = Concat(output, ToString(parameter));
            output = Concat(output,
                ".local = alloca %pgy.array.bool, align 8\n");
            output = Concat(output, "  %pgy.param.");
            output = Concat(output, ToString(parameter));
            output = Concat(output,
                " = load %pgy.array.bool, ptr %pgy.param.");
            output = Concat(output, ToString(parameter));
            output = Concat(output, ".mutref, align 8\n");
            output = Concat(output,
                "  store %pgy.array.bool %pgy.param.");
            output = Concat(output, ToString(parameter));
            output = Concat(output, ", ptr %pgy.param.");
            output = Concat(output, ToString(parameter));
            output = Concat(output, ".local, align 8\n");
        }
        parameter = parameter + 1;
    }
    return output;
}

func DirectMirScalarProgramLlvmArrayBoolValueResultCopyOut(
    ref plan: DirectMirScalarCfgGraphPlan, routine: Int, exit_block: Int
) -> String {
    var output: String = "";
    var parameter: Int = 0;
    while parameter < plan.routines.parameter_counts[routine] {
        if DirectMirScalarProgramArrayBoolValueResultAt(
                plan.program.array_bool_abi, routine, parameter) {
            let spelling: String = ToString(parameter);
            let local_row: Int =
                DirectMirScalarProgramParameterValueResultLocalRow(
                    plan, routine, parameter);
            var storage: String = Concat(
                "%pgy.param.", Concat(spelling, ".local"));
            if local_row >= 0 {
                storage = Concat("%pgy.local.", ToString(local_row));
            }
            let value: String = Concat(Concat(
                "%pgy.param.", spelling), Concat(
                ".copyout.", ToString(exit_block)));
            output = Concat(output, Concat("  ", Concat(
                value, " = load %pgy.array.bool, ptr ")));
            output = Concat(output, Concat(storage, ", align 8\n"));
            output = Concat(output,
                "  store %pgy.array.bool ");
            output = Concat(output, value);
            output = Concat(output, ", ptr %pgy.param.");
            output = Concat(output, ToString(parameter));
            output = Concat(output, ".mutref, align 8\n");
        }
        parameter = parameter + 1;
    }
    return output;
}
