// Entry-frame storage for by-value records and record-array descriptors.
import "../scalar_cfg/direct_mir_scalar_cfg_graph_fact_owner.pgy";
import "direct_mir_scalar_program_llvm_logical_record_owner.pgy";
import "direct_mir_scalar_program_logical_record_array_target_owner.pgy";

func DirectMirScalarProgramLlvmLogicalRecordValueParameterAddressableCopyIn(
    ref plan: DirectMirScalarCfgGraphPlan, routine: Int
) -> String {
    var output: String = "";
    var ordinal: Int = 0;
    while ordinal < plan.routines.parameter_counts[routine] {
        let row: Int = plan.routines.parameter_starts[routine] + ordinal;
        let type_name: String = plan.routines.parameter_types[row];
        if plan.routines.parameter_carriages[row] == "value" {
            var llvm_type: String = "";
            if DirectMirScalarProgramLogicalRecordTypeReady(plan.program.logical_record, type_name) {
                llvm_type = DirectMirScalarProgramLlvmLogicalRecordTypeName(
                    plan.program.logical_record, type_name);
            } else if DirectMirScalarProgramLogicalRecordArrayTypeReady(plan.program.logical_record, type_name) {
                llvm_type = DirectMirScalarProgramLlvmLogicalRecordArrayTypeName(
                    plan.program.logical_record, type_name);
            }
            if llvm_type != "" {
                let value: String = "%pgy.param." + ToString(ordinal);
                output = output + "  ${value}.local = alloca ${llvm_type}, align 8\n";
                output = output + "  store ${llvm_type} ${value}, ptr ${value}.local, align 8\n";
            }
        }
        ordinal = ordinal + 1;
    }
    return output;
}
