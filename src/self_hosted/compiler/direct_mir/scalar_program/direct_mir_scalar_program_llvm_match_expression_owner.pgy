// LLVM projection dispatch for the admitted scalar-program match families.

import "direct_mir_scalar_program_option_int_match_target_expression_owner.pgy";
import "direct_mir_scalar_program_payload_enum_target_expression_owner.pgy";
import "direct_mir_scalar_program_payload_free_enum_result_match_target_owner.pgy";

struct DirectMirScalarProgramLlvmMatchExpression {
    let matched: Bool;
    let valid: Bool;
    let instructions: String;
    let value: String;
}

func DirectMirScalarProgramLlvmMatchExpressionAt(
    ref expressions: DirectMirScalarProgramExpressionSet,
    node: Int, result: String, left: String,
    ref arguments: Array<String>, ref argument_types: Array<String>,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    ref payload_free_enum: DirectMirScalarProgramPayloadFreeEnumFact,
    ref referenced_enum: DirectMirScalarProgramReferencedEnumFact
) -> DirectMirScalarProgramLlvmMatchExpression {
    let result_match: DirectMirScalarProgramLlvmStringExpression =
        DirectMirScalarProgramLlvmPayloadFreeEnumResultMatchAt(
            expressions, node, result, left, logical_record,
            payload_free_enum, referenced_enum);
    if result_match.matched {
        return DirectMirScalarProgramLlvmMatchExpression(
            true, result_match.valid, result_match.instructions,
            result_match.value);
    }
    let option_match: DirectMirScalarProgramLlvmStringExpression =
        DirectMirScalarProgramLlvmOptionIntMatchExpressionAt(
            expressions, node, result, left);
    if option_match.matched {
        return DirectMirScalarProgramLlvmMatchExpression(
            true, option_match.valid, option_match.instructions,
            option_match.value);
    }
    let payload_match: DirectMirScalarProgramLlvmPayloadEnumExpression =
        DirectMirScalarProgramLlvmPayloadEnumExpressionAt(
            expressions, node, result, left, arguments, argument_types,
            logical_record, payload_free_enum, referenced_enum);
    return DirectMirScalarProgramLlvmMatchExpression(
        payload_match.matched, payload_match.valid,
        payload_match.instructions, payload_match.value);
}
