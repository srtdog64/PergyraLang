// Typed normalization of one empty declaration-owned Array<Record> literal.

import "../direct_mir_array_literal_spine_owner.pgy";
import "direct_mir_scalar_program_expression_mutation_owner.pgy";
import "direct_mir_scalar_program_expression_kind_id_owner.pgy";
import "direct_mir_scalar_program_logical_record_array_value_result_policy_owner.pgy";

func DirectMirScalarProgramAppendLogicalRecordArrayEmptyLiteral(
    facts: DirectMirScalarProgramExpressionSet,
    ref sequence: MirExpressionGraphSequence,
    ref uses: MirRoutineInstructionUseFacts,
    global_row: Int, expected_type: String,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact
) -> DirectMirScalarProgramLiteralExpressionAdmission {
    let root: Int = sequence.roots[0];
    let recognized: Bool =
        DirectMirScalarProgramLogicalRecordArrayTypeReady(
            logical_record, expected_type) &&
        sequence.arena.topology.node_kinds[root] ==
            AstExpressionNodeArrayLiteral();
    if !recognized {
        return DirectMirScalarProgramLiteralExpressionAdmission(
            false, facts);
    }
    let invalid: DirectMirScalarProgramExpressionSet =
        DirectMirScalarProgramExpressionSetInvalid(facts);
    if !DirectMirArrayLiteralEmptyReady(sequence) ||
        MirRoutineInstructionUseCountAtGlobal(uses, global_row) != 0 {
        return DirectMirScalarProgramLiteralExpressionAdmission(
            true, invalid);
    }
    var graph_rows: Array<Int> = facts.graph_global_rows;
    var starts: Array<Int> = facts.graph_starts;
    var counts: Array<Int> = facts.graph_counts;
    var roots: Array<Int> = facts.graph_roots;
    var kinds: Array<Int> = facts.node_kinds;
    var types: Array<String> = facts.node_types;
    var lefts: Array<Int> = facts.node_lefts;
    var rights: Array<Int> = facts.node_rights;
    var locals: Array<Int> = facts.node_local_rows;
    var params: Array<Int> = facts.node_parameter_ordinals;
    var members: Array<Int> = facts.node_member_ordinals;
    var literals: Array<String> = facts.node_literals;
    var callables: Array<Int> = facts.node_callable_rows;
    var runtime_ids: Array<Int> = facts.node_runtime_call_abi_ids;
    DirectMirScalarProgramAppendExpressionNode(
        kinds, types, lefts, rights, locals, params, members,
        literals, callables, runtime_ids,
        DirectMirScalarProgramExprLogicalRecordArrayEmptyLiteral(),
        expected_type, -1, -1, -1, -1, -1, "", -1, -1);
    ArrayPush(graph_rows, global_row);
    ArrayPush(starts, ArrayLength(kinds) - 1);
    ArrayPush(counts, 1);
    ArrayPush(roots, ArrayLength(kinds) - 1);
    return DirectMirScalarProgramLiteralExpressionAdmission(
        true, DirectMirScalarProgramExpressionSet(
            true, 0, graph_rows, starts, counts, roots, kinds, types,
            lefts, rights, locals, params, members, literals, callables,
            runtime_ids,
            facts.nary_operands));
}
