// Wrapper-aware logical-record dependency identity and reference discovery.
import "../../abi_layout_row_owner.pgy";
import "../../../mir_lower/program_declaration_index_owner.pgy";
import "../../../semantic/array_type_shape_owner.pgy";
import "../../../semantic/wrapper_type_owner.pgy";
import "../../../codegen/runtime_abi/hashmap_runtime_owner.pgy";
import "../../../codegen/runtime_abi/hashmap_llvm_runtime_owner.pgy";

func DirectMirScalarProgramLogicalRecordHashMapTerminalFieldTypeReady(
    type_name: String
) -> Bool {
    let c_fact: CollectionHashMapRuntimeFact =
        CollectionHashMapRuntimeFactFromTypeName(type_name);
    let llvm_fact: CollectionHashMapLlvmFact =
        CollectionHashMapLlvmFactFromTypeName(type_name);
    return c_fact.ok && llvm_fact.ok &&
        c_fact.type_name == llvm_fact.type_name;
}

func DirectMirScalarProgramLogicalRecordScalarFieldTypeReady(
    type_name: String
) -> Bool {
    return type_name == CompilerAbiLayoutBoolTypeName() ||
        type_name == CompilerAbiLayoutIntTypeName() ||
        type_name == CompilerAbiLayoutLongTypeName() ||
        type_name == CompilerAbiLayoutStringTypeName();
}

func DirectMirScalarProgramLogicalRecordTerminalFieldTypeReady(
    type_name: String
) -> Bool {
    return DirectMirScalarProgramLogicalRecordScalarFieldTypeReady(type_name) ||
        DirectMirScalarProgramLogicalRecordHashMapTerminalFieldTypeReady(
            type_name) ||
        type_name == CompilerAbiLayoutOptionIntTypeName() ||
        type_name == CompilerAbiLayoutArrayIntTypeName() ||
        type_name == CompilerAbiLayoutArrayLongTypeName() ||
        type_name == CompilerAbiLayoutArrayBoolTypeName() ||
        type_name == CompilerAbiLayoutArrayStringTypeName();
}

func DirectMirScalarProgramLogicalRecordFieldDependencyType(
    type_name: String
) -> String {
    if type_name == "" ||
        DirectMirScalarProgramLogicalRecordTerminalFieldTypeReady(type_name) {
        return "";
    }
    var dependency: String = type_name;
    var unwrapped: Bool = false;
    var progress: Bool = true;
    while progress {
        progress = false;
        let array_element: Option<String> = SemanticArrayElementType(dependency);
        if IsSome(array_element) && UnwrapOption(array_element) != dependency {
            dependency = UnwrapOption(array_element);
            unwrapped = true;
            progress = true;
        } else {
            let option_payload: Option<String> = OptionPayloadTypeOpt(dependency);
            if IsSome(option_payload) && UnwrapOption(option_payload) != dependency {
                dependency = UnwrapOption(option_payload);
                unwrapped = true;
                progress = true;
            } else {
                let result_payload: Option<String> = ResultPayloadTypeOpt(dependency);
                if IsSome(result_payload) && UnwrapOption(result_payload) != dependency {
                    dependency = UnwrapOption(result_payload);
                    unwrapped = true;
                    progress = true;
                }
            }
        }
    }
    if unwrapped &&
        DirectMirScalarProgramLogicalRecordTerminalFieldTypeReady(dependency) {
        return type_name;
    }
    return dependency;
}

func DirectMirScalarProgramLogicalRecordReferenceAdd(
    ref declarations: MirProgramDeclarationIndex,
    type_name: String, inout referenced_rows: Array<Int>
) -> Bool {
    var referenced_type: String = type_name;
    var unwrapped: Bool = true;
    while unwrapped {
        unwrapped = false;
        let array_element: Option<String> = SemanticArrayElementType(referenced_type);
        if IsSome(array_element) && UnwrapOption(array_element) != referenced_type {
            referenced_type = UnwrapOption(array_element);
            unwrapped = true;
        } else {
            let option_payload: Option<String> = OptionPayloadTypeOpt(referenced_type);
            if IsSome(option_payload) && UnwrapOption(option_payload) != referenced_type {
                referenced_type = UnwrapOption(option_payload);
                unwrapped = true;
            } else {
                let result_payload: Option<String> = ResultPayloadTypeOpt(referenced_type);
                if IsSome(result_payload) && UnwrapOption(result_payload) != referenced_type {
                    referenced_type = UnwrapOption(result_payload);
                    unwrapped = true;
                }
            }
        }
    }
    let declaration_row: Int = MirProgramDeclarationFieldIdentityDeclarationIndex(
        declarations.field_identities, referenced_type);
    if declaration_row < 0 { return true; }
    var prior: Int = 0;
    while prior < ArrayLength(referenced_rows) {
        if referenced_rows[prior] == declaration_row { return true; }
        prior = prior + 1;
    }
    ArrayPush(referenced_rows, declaration_row);
    return referenced_rows[ArrayLength(referenced_rows) - 1] == declaration_row;
}
