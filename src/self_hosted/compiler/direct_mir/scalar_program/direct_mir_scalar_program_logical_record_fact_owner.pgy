// Callable-return passive logical records carried by declaration identity.
//
// The declaration index owns record and field identity. This inventory keeps
// distinct declaration rows distinct even when their ordered field types are
// equal. Physical layout is a separate, explicit producer-receipt carriage;
// an admitted absence never stands in for a required layout.

import "../direct_mir_routine_instance_inventory_owner.pgy";
import "../direct_mir_instruction_abi_absence_owner.pgy";
import "../scalar_cfg/direct_mir_scalar_cfg_hash_owner.pgy";
import "../../../mir_lower/machine_layer_fact_owner.pgy";
import "../direct_mir_nominal_abi_row_identity_owner.pgy";
import "../../../semantic/array_type_shape_owner.pgy";
import "../../../semantic/wrapper_type_owner.pgy";
import "direct_mir_scalar_program_payload_free_enum_fact_owner.pgy";
import "direct_mir_scalar_program_logical_record_declaration_envelope_owner.pgy";
import "direct_mir_scalar_program_record_abi_fact_owner.pgy";
import "direct_mir_scalar_program_logical_record_dependency_owner.pgy";
import "direct_mir_scalar_program_logical_record_validation_receipt_schema_owner.pgy";
struct DirectMirScalarProgramLogicalRecordFact {
    let valid: Bool;
    let digest: Int;
    let present: Bool;
    let declaration_rows: Array<Int>;
    let names: Array<String>;
    let source_syntax_ids: Array<Int>;
    let field_starts: Array<Int>;
    let field_counts: Array<Int>;
    let field_names: Array<String>;
    let field_types: Array<String>;
    let field_dependency_types: Array<String>;
    let field_source_syntax_ids: Array<Int>;
    let field_payload_free_enums: Array<Int>;
    let physical: DirectMirScalarProgramRecordAbiCarriage;
    // Sibling carriage only: passive row/type lookup never claims these cells.
    var identity_cells: DirectMirIdentityCellFacts;
    let validation: DirectMirScalarProgramLogicalRecordValidationReceipt;
}
func DirectMirScalarProgramLogicalRecordFactInvalid() -> DirectMirScalarProgramLogicalRecordFact {
    let ints: Array<Int> = [];
    let names: Array<String> = [];
    let types: Array<String> = [];
    return DirectMirScalarProgramLogicalRecordFact(false, 0, false, ints, names, ints, ints, ints,
        names, types, types, ints, ints, DirectMirScalarProgramRecordAbiCarriageEmpty(),
        DirectMirIdentityCellFactsEmpty(),
        DirectMirScalarProgramLogicalRecordValidationReceiptEmpty());
}
func DirectMirScalarProgramLogicalRecordFactDigest(ref fact: DirectMirScalarProgramLogicalRecordFact
) -> Int {
    if !fact.valid { return 0; }
    var hash: Long = DirectMirCfgHashInt(263L, ArrayLength(fact.declaration_rows));
    hash = DirectMirScalarCfgHashInts(hash, fact.declaration_rows);
    hash = DirectMirScalarCfgHashStrings(hash, fact.names);
    hash = DirectMirScalarCfgHashInts(hash, fact.source_syntax_ids);
    hash = DirectMirScalarCfgHashInts(hash, fact.field_starts);
    hash = DirectMirScalarCfgHashInts(hash, fact.field_counts);
    hash = DirectMirScalarCfgHashStrings(hash, fact.field_names);
    hash = DirectMirScalarCfgHashStrings(hash, fact.field_types);
    hash = DirectMirScalarCfgHashStrings(hash, fact.field_dependency_types);
    hash = DirectMirScalarCfgHashInts(hash, fact.field_source_syntax_ids);
    hash = DirectMirScalarCfgHashInts(hash, fact.field_payload_free_enums);
    if fact.present { hash = DirectMirCfgHashInt(hash, 1); }
    else { hash = DirectMirCfgHashInt(hash, 0); }
    hash = DirectMirScalarProgramRecordAbiCarriageHash(hash, fact.physical);
    hash = DirectMirCfgHashInt(hash, fact.identity_cells.digest);
    return DirectMirCfgBoundedDigest(hash);
}
func DirectMirScalarProgramLogicalRecordFactCanonicalEmpty(
) -> DirectMirScalarProgramLogicalRecordFact {
    let ints: Array<Int> = [];
    let names: Array<String> = [];
    let types: Array<String> = [];
    let physical: DirectMirScalarProgramRecordAbiCarriage =
        DirectMirScalarProgramRecordAbiCarriageEmpty();
    let source: DirectMirScalarProgramLogicalRecordFact = DirectMirScalarProgramLogicalRecordFact(
            true, 0, false, ints, names, ints, ints, ints,
            names, types, types, ints, ints, physical, DirectMirIdentityCellFactsEmpty(),
            DirectMirScalarProgramLogicalRecordValidationReceiptEmpty());
    return DirectMirScalarProgramLogicalRecordFact(
        true, DirectMirScalarProgramLogicalRecordFactDigest(source),
        false, ints, names, ints, ints, ints, names, types, types, ints, ints,
        physical, DirectMirIdentityCellFactsEmpty(),
        DirectMirScalarProgramLogicalRecordValidationReceiptEmpty());
}

func DirectMirScalarProgramLogicalRecordCandidateReady(
    ref fact: DirectMirScalarProgramLogicalRecordFact) -> Bool {
    if !fact.valid || fact.digest == 0 || !fact.present ||
        !DirectMirScalarProgramRecordAbiCarriageColumnsReady(
            fact.physical, 1, ArrayLength(fact.field_names)) ||
        fact.digest != DirectMirScalarProgramLogicalRecordFactDigest(fact) ||
        ArrayLength(fact.declaration_rows) != 1 || ArrayLength(fact.names) != 1 ||
        ArrayLength(fact.source_syntax_ids) != 1 || ArrayLength(fact.field_starts) != 1 ||
        ArrayLength(fact.field_counts) != 1 ||
        fact.declaration_rows[0] < 0 || fact.names[0] == "" ||
        fact.source_syntax_ids[0] <= 0 || fact.field_starts[0] != 0 ||
        fact.field_counts[0] <= 0 || fact.field_counts[0] !=
            ArrayLength(fact.field_names) || fact.field_counts[0] !=
            ArrayLength(fact.field_types) || fact.field_counts[0] !=
            ArrayLength(fact.field_dependency_types) || fact.field_counts[0] !=
            ArrayLength(fact.field_source_syntax_ids) || fact.field_counts[0] !=
            ArrayLength(fact.field_payload_free_enums) {
        return false;
    }
    if !DirectMirScalarProgramRecordAbiCarriageRowReady(
            fact.physical, 0, 0, fact.field_counts[0]) { return false; }
    var field: Int = 0;
    while field < fact.field_counts[0] {
        if fact.field_names[field] == "" || fact.field_types[field] == "" ||
            fact.field_source_syntax_ids[field] <= 0 ||
            fact.field_source_syntax_ids[field] == fact.source_syntax_ids[0] ||
            (fact.field_payload_free_enums[field] != 0 &&
             fact.field_payload_free_enums[field] != 1) {
            return false;
        }
        var prior: Int = 0;
        while prior < field {
            if fact.field_names[prior] == fact.field_names[field] ||
                fact.field_source_syntax_ids[prior] == fact.field_source_syntax_ids[field] {
                return false;
            }
            prior = prior + 1;
        }
        field = field + 1;
    }
    return true;
}

func DirectMirScalarProgramLogicalRecordFactReplayReady(ref fact: DirectMirScalarProgramLogicalRecordFact
) -> Bool {
    let count: Int = ArrayLength(fact.declaration_rows);
    if !fact.valid || fact.digest == 0 || fact.digest !=
            DirectMirScalarProgramLogicalRecordFactDigest(fact) ||
        !DirectMirScalarProgramRecordAbiCarriageColumnsReady(
            fact.physical, count, ArrayLength(fact.field_names)) ||
        !DirectMirIdentityCellFactsReady(fact.identity_cells) || fact.present != (count > 0) ||
        count != ArrayLength(fact.names) || count != ArrayLength(fact.source_syntax_ids) ||
        count != ArrayLength(fact.field_starts) || count != ArrayLength(fact.field_counts) ||
        ArrayLength(fact.field_names) != ArrayLength(fact.field_types) ||
        ArrayLength(fact.field_names) != ArrayLength(fact.field_dependency_types) ||
        ArrayLength(fact.field_names) != ArrayLength(fact.field_payload_free_enums) {
        return false;
    }
    var expected_field: Int = 0;
    var row: Int = 0;
    while row < count {
        if fact.declaration_rows[row] < 0 || fact.names[row] == "" ||
            fact.source_syntax_ids[row] <= 0 || fact.field_starts[row] != expected_field ||
            fact.field_counts[row] <= 0 || expected_field + fact.field_counts[row] >
                ArrayLength(fact.field_names) {
            return false;
        }
        if !DirectMirScalarProgramRecordAbiCarriageRowReady(
                fact.physical, row, expected_field, fact.field_counts[row]) {
            return false;
        }
        var prior: Int = 0;
        while prior < row {
            if fact.declaration_rows[prior] == fact.declaration_rows[row] ||
                fact.names[prior] == fact.names[row] ||
                fact.source_syntax_ids[prior] == fact.source_syntax_ids[row] {
                return false;
            }
            prior = prior + 1;
        }
        var field: Int = expected_field;
        while field < expected_field + fact.field_counts[row] {
            if fact.field_names[field] == "" || fact.field_types[field] == "" ||
                fact.field_source_syntax_ids[field] <= 0 || fact.field_source_syntax_ids[field] ==
                    fact.source_syntax_ids[row] || (fact.field_payload_free_enums[field] != 0 &&
                 fact.field_payload_free_enums[field] != 1) {
                return false;
            }
            let dependency_type: String = fact.field_dependency_types[field];
            if fact.field_payload_free_enums[field] == 0 &&
                dependency_type != "" {
                var dependency: Int = 0;
                var dependency_found: Bool = false;
                while dependency < row {
                    if fact.names[dependency] == dependency_type {
                        dependency_found = true;
                    }
                    dependency = dependency + 1;
                }
                if !dependency_found { return false; }
            }
            var field_prior: Int = expected_field;
            while field_prior < field {
                if fact.field_names[field_prior] == fact.field_names[field] ||
                    fact.field_source_syntax_ids[field_prior] ==
                        fact.field_source_syntax_ids[field] {
                    return false;
                }
                field_prior = field_prior + 1;
            }
            field = field + 1;
        }
        expected_field = expected_field + fact.field_counts[row];
        row = row + 1;
    }
    return expected_field == ArrayLength(fact.field_names) &&
        expected_field == ArrayLength(fact.field_types) &&
        expected_field == ArrayLength(fact.field_source_syntax_ids);
}

func DirectMirScalarProgramLogicalRecordFactReady(
    ref fact: DirectMirScalarProgramLogicalRecordFact
) -> Bool {
    if !fact.validation.admitted {
        return DirectMirScalarProgramLogicalRecordFactReplayReady(fact);
    }
    if !DirectMirScalarProgramLogicalRecordValidationReceiptMatches(
            fact.validation, fact.digest, fact.present,
            ArrayLength(fact.declaration_rows), ArrayLength(fact.field_names),
            fact.identity_cells.digest) {
        return false;
    }
    if fact.validation.verification_replay {
        return DirectMirScalarProgramLogicalRecordFactReplayReady(fact);
    }
    return true;
}

func DirectMirScalarProgramLogicalRecordCandidateAt(
    json: String, json_extent: Int, ref declarations: MirProgramDeclarationIndex, declaration_row: Int,
    ref payload_free_enum: DirectMirScalarProgramPayloadFreeEnumFact
) -> DirectMirScalarProgramLogicalRecordFact {
    let invalid: DirectMirScalarProgramLogicalRecordFact =
        DirectMirScalarProgramLogicalRecordFactInvalid();
    let envelope: DirectMirScalarProgramLogicalRecordDeclarationEnvelope =
        DirectMirScalarProgramLogicalRecordDeclarationEnvelopeFromOwner(
            json, json_extent, declarations, declaration_row);
    if !DirectMirScalarProgramPayloadFreeEnumFactReady(payload_free_enum) ||
        !envelope.valid { return invalid; }
    if MirProgramDeclarationFieldIdentityDeclarationIndex(
            declarations.field_identities, envelope.name) != declaration_row {
        return invalid;
    }
    var field_names: Array<String> = [];
    var field_types: Array<String> = [];
    var field_dependencies: Array<String> = [];
    var field_ids: Array<Int> = [];
    var field_enums: Array<Int> = [];
    var field: Int = 0;
    while field < ArrayLength(declarations.field_identities.field_names) {
        if declarations.field_identities.field_owner_indices[field] == declaration_row {
            if declarations.field_identities.field_kinds[field] != "field" ||
                !MirProgramDeclarationFieldIdentityPositiveDecimal(
                    declarations.field_identities.field_source_syntax_ids[
                        field]) {
                return invalid;
            }
            let ordinal: Int = ArrayLength(field_names);
            if envelope.physical.valid && (ordinal >= ArrayLength(envelope.physical.field_names) ||
                 envelope.physical.field_names[ordinal] != declarations.field_identities.field_names[field] ||
                 envelope.physical.field_types[ordinal] != declarations.field_identities.field_type_names[field] ||
                 envelope.physical.field_source_syntax_ids[ordinal] !=
                    ToInt(declarations.field_identities.field_source_syntax_ids[field])) {
                return invalid;
            }
            ArrayPush(field_names, declarations.field_identities.field_names[field]);
            let field_type: String = declarations.field_identities.field_type_names[field];
            ArrayPush(field_types, field_type);
            ArrayPush(field_dependencies, Clone(
                DirectMirScalarProgramLogicalRecordFieldDependencyType(field_type)));
            ArrayPush(field_ids, ToInt(declarations.field_identities.field_source_syntax_ids[
                    field]));
            if DirectMirScalarProgramPayloadFreeEnumTypeReady(payload_free_enum,
                    declarations.field_identities.field_type_names[field]) {
                ArrayPush(field_enums, 1);
            } else { ArrayPush(field_enums, 0); }
        }
        field = field + 1;
    }
    let rows: Array<Int> = [declaration_row];
    let unwrapped_name: String = envelope.name;
    let names: Array<String> = [unwrapped_name];
    let syntax_ids: Array<Int> = [envelope.source_syntax_id];
    let field_starts: Array<Int> = [0];
    let field_counts: Array<Int> = [ArrayLength(field_names)];
    let physical: DirectMirScalarProgramRecordAbiCarriage =
        DirectMirScalarProgramRecordAbiCarriageFromDeclaration(
            envelope.physical, ArrayLength(field_names));
    let source: DirectMirScalarProgramLogicalRecordFact = DirectMirScalarProgramLogicalRecordFact(
            true, 0, true, rows, names, syntax_ids, field_starts,
            field_counts, field_names, field_types, field_dependencies,
            field_ids, field_enums, physical, DirectMirIdentityCellFactsEmpty(),
            DirectMirScalarProgramLogicalRecordValidationReceiptEmpty());
    let sealed: DirectMirScalarProgramLogicalRecordFact = DirectMirScalarProgramLogicalRecordFact(
            true, DirectMirScalarProgramLogicalRecordFactDigest(source),
            true, rows, names, syntax_ids, field_starts, field_counts,
            field_names, field_types, field_dependencies, field_ids,
            field_enums, physical, DirectMirIdentityCellFactsEmpty(),
            DirectMirScalarProgramLogicalRecordValidationReceiptEmpty());
    if !DirectMirScalarProgramLogicalRecordCandidateReady(sealed) {
        return invalid;
    }
    return sealed;
}

func DirectMirScalarProgramLogicalRecordAppendCandidate(
    current: DirectMirScalarProgramLogicalRecordFact,
    ref candidate: DirectMirScalarProgramLogicalRecordFact
) -> DirectMirScalarProgramLogicalRecordFact {
    if !DirectMirScalarProgramLogicalRecordFactReady(current) ||
        !DirectMirScalarProgramLogicalRecordCandidateReady(candidate) {
        return DirectMirScalarProgramLogicalRecordFactInvalid();
    }
    var rows: Array<Int> = current.declaration_rows;
    var names: Array<String> = current.names;
    var syntax_ids: Array<Int> = current.source_syntax_ids;
    var field_starts: Array<Int> = current.field_starts;
    var field_counts: Array<Int> = current.field_counts;
    var field_names: Array<String> = current.field_names;
    var field_types: Array<String> = current.field_types;
    var field_dependencies: Array<String> = current.field_dependency_types;
    var field_ids: Array<Int> = current.field_source_syntax_ids;
    var field_enums: Array<Int> = current.field_payload_free_enums;
    let physical: DirectMirScalarProgramRecordAbiCarriage =
        DirectMirScalarProgramRecordAbiCarriageAppend(current.physical, candidate.physical);
    ArrayPush(rows, candidate.declaration_rows[0]);
    ArrayPush(names, candidate.names[0]);
    ArrayPush(syntax_ids, candidate.source_syntax_ids[0]);
    ArrayPush(field_starts, ArrayLength(field_names));
    ArrayPush(field_counts, candidate.field_counts[0]);
    var field: Int = 0;
    while field < candidate.field_counts[0] {
        ArrayPush(field_names, candidate.field_names[field]);
        ArrayPush(field_types, candidate.field_types[field]);
        ArrayPush(field_dependencies, Clone(
            candidate.field_dependency_types[field]));
        ArrayPush(field_ids, candidate.field_source_syntax_ids[field]);
        ArrayPush(field_enums, candidate.field_payload_free_enums[field]);
        field = field + 1;
    }
    let source: DirectMirScalarProgramLogicalRecordFact = DirectMirScalarProgramLogicalRecordFact(
            true, 0, true, rows, names, syntax_ids, field_starts,
            field_counts, field_names, field_types, field_dependencies,
            field_ids, field_enums, physical, DirectMirIdentityCellFactsEmpty(),
            DirectMirScalarProgramLogicalRecordValidationReceiptEmpty());
    let sealed: DirectMirScalarProgramLogicalRecordFact = DirectMirScalarProgramLogicalRecordFact(
        true, DirectMirScalarProgramLogicalRecordFactDigest(source),
        true, rows, names, syntax_ids, field_starts, field_counts,
        field_names, field_types, field_dependencies, field_ids,
        field_enums, physical, DirectMirIdentityCellFactsEmpty(),
        DirectMirScalarProgramLogicalRecordValidationReceiptEmpty());
    if !DirectMirScalarProgramLogicalRecordFactReady(sealed) {
        return DirectMirScalarProgramLogicalRecordFactInvalid();
    }
    return sealed;
}

func DirectMirScalarProgramLogicalRecordCandidateDependenciesReady(
    ref selected: DirectMirScalarProgramLogicalRecordFact,
    ref candidate: DirectMirScalarProgramLogicalRecordFact) -> Bool {
    if !DirectMirScalarProgramLogicalRecordFactReady(selected) ||
        !DirectMirScalarProgramLogicalRecordCandidateReady(candidate) {
        return false;
    }
    var field: Int = 0;
    while field < candidate.field_counts[0] {
        let dependency_type: String = candidate.field_dependency_types[field];
        if candidate.field_payload_free_enums[field] == 0 &&
            dependency_type != "" {
            var found: Bool = false;
            var row: Int = 0;
            while row < ArrayLength(selected.names) {
                if selected.names[row] == dependency_type { found = true; }
                row = row + 1;
            }
            if !found { return false; }
        }
        field = field + 1;
    }
    return true;
}

func DirectMirScalarProgramLogicalRecordFactFromAdmitted(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    ref routine_instances: DirectMirRoutineInstanceInventory,
    ref payload_free_enum: DirectMirScalarProgramPayloadFreeEnumFact,
    cells: DirectMirIdentityCellFacts
) -> DirectMirScalarProgramLogicalRecordFact {
    if !admitted.domain_runtime_admission.declarations.valid ||
        !DirectMirScalarProgramPayloadFreeEnumFactReady(payload_free_enum) {
        return DirectMirScalarProgramLogicalRecordFactInvalid();
    }
    var referenced_rows: Array<Int> = [];
    var row: Int = 0;
    while row < ArrayLength(routine_instances.source_rows) {
        let signature: DirectMirRoutineSignatureFact =
            DirectMirRoutineInstanceSignatureAt(routine_instances, row);
        if !DirectMirRoutineSignatureFactReady(signature) {
            return DirectMirScalarProgramLogicalRecordFactInvalid();
        }
        if !DirectMirScalarProgramLogicalRecordReferenceAdd(
                admitted.domain_runtime_admission.declarations,
                signature.return_type, referenced_rows) {
            return DirectMirScalarProgramLogicalRecordFactInvalid();
        }
        var parameter: Int = 0;
        while parameter < signature.param_count {
            if !DirectMirScalarProgramLogicalRecordReferenceAdd(
                    admitted.domain_runtime_admission.declarations,
                    signature.parameters.type_names[parameter],
                    referenced_rows) {
                return DirectMirScalarProgramLogicalRecordFactInvalid();
            }
            parameter = parameter + 1;
        }
        row = row + 1;
    }
    if ArrayLength(admitted.routines.instruction_abi_type_names) !=
            ArrayLength(admitted.routines.instruction_starts) {
        return DirectMirScalarProgramLogicalRecordFactInvalid();
    }
    var instruction: Int = 0;
    while instruction <
            ArrayLength(admitted.routines.instruction_abi_type_names) {
        if !DirectMirScalarProgramLogicalRecordReferenceAdd(
                admitted.domain_runtime_admission.declarations,
                admitted.routines.instruction_abi_type_names[instruction],
                referenced_rows) {
            return DirectMirScalarProgramLogicalRecordFactInvalid();
        }
        instruction = instruction + 1;
    }
    var reference: Int = 0;
    while reference < ArrayLength(referenced_rows) {
        let candidate: DirectMirScalarProgramLogicalRecordFact =
            DirectMirScalarProgramLogicalRecordCandidateAt(
                admitted.document.root.json, admitted.document.root.json_extent,
                admitted.domain_runtime_admission.declarations,
                referenced_rows[reference], payload_free_enum);
        if candidate.valid {
            var field: Int = 0;
            while field < candidate.field_counts[0] {
                if !DirectMirScalarProgramLogicalRecordReferenceAdd(
                        admitted.domain_runtime_admission.declarations,
                        candidate.field_types[field],
                        referenced_rows) {
                    return DirectMirScalarProgramLogicalRecordFactInvalid();
                }
                field = field + 1;
            }
        }
        reference = reference + 1;
    }
    var selected: DirectMirScalarProgramLogicalRecordFact =
        DirectMirScalarProgramLogicalRecordFactCanonicalEmpty();
    var progress: Bool = true;
    while progress {
        progress = false;
        reference = 0;
        while reference < ArrayLength(referenced_rows) {
            let candidate: DirectMirScalarProgramLogicalRecordFact =
                DirectMirScalarProgramLogicalRecordCandidateAt(
                    admitted.document.root.json, admitted.document.root.json_extent,
                    admitted.domain_runtime_admission.declarations,
                    referenced_rows[reference], payload_free_enum);
            var already_selected: Bool = false;
            if candidate.valid {
                var selected_row: Int = 0;
                while selected_row < ArrayLength(selected.names) {
                    if selected.names[selected_row] == candidate.names[0] {
                        already_selected = true;
                    }
                    selected_row = selected_row + 1;
                }
            }
            if candidate.valid && !already_selected &&
                DirectMirScalarProgramLogicalRecordCandidateDependenciesReady(
                    selected, candidate) {
                selected = DirectMirScalarProgramLogicalRecordAppendCandidate(
                    selected, candidate);
                if !DirectMirScalarProgramLogicalRecordFactReady(selected) {
                    return DirectMirScalarProgramLogicalRecordFactInvalid();
                }
                progress = true;
            }
            reference = reference + 1;
        }
    }
    let combined: DirectMirScalarProgramLogicalRecordFact = DirectMirScalarProgramLogicalRecordFact(
        selected.valid, 0, selected.present, selected.declaration_rows, selected.names,
        selected.source_syntax_ids, selected.field_starts, selected.field_counts,
        selected.field_names, selected.field_types, selected.field_dependency_types,
        selected.field_source_syntax_ids,
        selected.field_payload_free_enums, selected.physical, cells,
        DirectMirScalarProgramLogicalRecordValidationReceiptEmpty());
    return DirectMirScalarProgramLogicalRecordFact(combined.valid,
        DirectMirScalarProgramLogicalRecordFactDigest(combined), combined.present,
        combined.declaration_rows, combined.names, combined.source_syntax_ids,
        combined.field_starts, combined.field_counts, combined.field_names, combined.field_types,
        combined.field_dependency_types, combined.field_source_syntax_ids,
        combined.field_payload_free_enums, combined.physical, cells,
        DirectMirScalarProgramLogicalRecordValidationReceiptEmpty());
}

func DirectMirScalarProgramLogicalRecordRow(
    ref fact: DirectMirScalarProgramLogicalRecordFact, type_name: String
) -> Int {
    if !fact.valid || !fact.present || type_name == "" { return -1; }
    var found: Int = -1;
    var row: Int = 0;
    while row < ArrayLength(fact.names) {
        if fact.names[row] == type_name {
            if found >= 0 { return -1; }
            found = row;
        }
        row = row + 1;
    }
    // A missing row is a fail-closed answer and does not need to replay the
    // whole sealed inventory. A positive lookup still proves the complete
    // fact before publishing its row.
    if found < 0 || !DirectMirScalarProgramLogicalRecordFactReady(fact) {
        return -1;
    }
    return found;
}

func DirectMirScalarProgramLogicalRecordTypeReady(
    ref fact: DirectMirScalarProgramLogicalRecordFact, type_name: String
) -> Bool {
    return DirectMirScalarProgramLogicalRecordRow(fact, type_name) >= 0;
}

func DirectMirScalarProgramLogicalRecordOptionPayloadType(
    ref fact: DirectMirScalarProgramLogicalRecordFact,
    option_type: String
) -> String {
    let payload: Option<String> = OptionPayloadTypeOpt(option_type);
    if !IsSome(payload) || !DirectMirScalarProgramLogicalRecordTypeReady(
            fact, UnwrapOption(payload)) {
        return "";
    }
    return UnwrapOption(payload);
}

func DirectMirScalarProgramLogicalRecordOptionTypeReady(
    ref fact: DirectMirScalarProgramLogicalRecordFact,
    option_type: String
) -> Bool {
    return DirectMirScalarProgramLogicalRecordOptionPayloadType(
        fact, option_type) != "";
}

func DirectMirScalarProgramLogicalRecordFieldTypeReady(
    ref fact: DirectMirScalarProgramLogicalRecordFact, type_name: String
) -> Bool {
    return DirectMirScalarProgramLogicalRecordTerminalFieldTypeReady(type_name) ||
        DirectMirScalarProgramLogicalRecordTypeReady(fact, type_name);
}

func DirectMirScalarProgramLogicalRecordFieldOrdinal(
    ref fact: DirectMirScalarProgramLogicalRecordFact,
    type_name: String, field_name: String
) -> Int {
    let record: Int = DirectMirScalarProgramLogicalRecordRow(fact, type_name);
    if record < 0 || field_name == "" { return -1; }
    var found: Int = -1;
    var ordinal: Int = 0;
    let start: Int = fact.field_starts[record];
    while ordinal < fact.field_counts[record] {
        if fact.field_names[start + ordinal] == field_name {
            if found >= 0 { return -1; }
            found = ordinal;
        }
        ordinal = ordinal + 1;
    }
    return found;
}

func DirectMirScalarProgramLogicalRecordFieldType(
    ref fact: DirectMirScalarProgramLogicalRecordFact,
    type_name: String, ordinal: Int
) -> String {
    let record: Int = DirectMirScalarProgramLogicalRecordRow(fact, type_name);
    if record < 0 || ordinal < 0 || ordinal >= fact.field_counts[record] {
        return "";
    }
    return fact.field_types[fact.field_starts[record] + ordinal];
}

func DirectMirScalarProgramLogicalRecordInstructionReady(
    ref fact: DirectMirScalarProgramLogicalRecordFact,
    json: String, json_extent: Int, ref capture: MirRoutineInstructionScalarCapture
) -> Bool {
    if !DirectMirScalarProgramLogicalRecordFactReady(fact) { return false; }
    let row: Int = DirectMirScalarProgramLogicalRecordRow(
        fact, capture.abi_type_name);
    if row < 0 {
        if DirectMirIdentityCellRow(fact.identity_cells, capture.abi_type_name) >= 0 {
            return DirectMirInstructionHasNoPhysicalAbi(json, json_extent, capture, capture.abi_type_name);
        }
        return true;
    }
    if fact.physical.layout_ids[row] > 0 {
        let physical: Option<MirAbiLayoutRowCapture> =
            MirCapturedRequiredAbiLayoutRowAdmission(
                json, json_extent, capture.abi_type_name, capture.abi_type_value_ready,
                capture.abi_type_start, capture.abi_type_end,
                capture.abi_layout_id_start, capture.abi_layout_id_end,
                capture.abi_layout_required_start,
                capture.abi_layout_required_end, capture.abi_layout_start,
                capture.abi_layout_end);
        if !IsSome(physical) { return false; }
        let captured: MirAbiLayoutRowCapture = UnwrapOption(physical);
        return MirAbiLayoutIdFromCapture(captured) == fact.physical.layout_ids[row] &&
            DirectMirAbiRowIdentityText(captured) == fact.physical.row_keys[row];
    }
    return DirectMirInstructionHasNoPhysicalAbi(
        json, json_extent, capture, capture.abi_type_name);
}

func DirectMirScalarProgramLogicalRecordParameterAbiReady(
    ref fact: DirectMirScalarProgramLogicalRecordFact,
    ref parameters: DirectMirRoutineParameterSetFact, ordinal: Int
) -> Bool {
    if ordinal < 0 || ordinal >= ArrayLength(parameters.names) { return false; }
    let row: Int = DirectMirScalarProgramLogicalRecordRow(
        fact, parameters.type_names[ordinal]);
    if row < 0 { return false; }
    return parameters.abi_required[ordinal] == (fact.physical.layout_ids[row] > 0) &&
        parameters.abi_layout_ids[ordinal] == fact.physical.layout_ids[row] &&
        parameters.abi_row_keys[ordinal] == fact.physical.row_keys[row];
}
