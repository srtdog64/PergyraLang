// Option<Int> parameter ABI and readiness.

import "../direct_mir_option_match_abi_capture_owner.pgy";
import "../direct_mir_instruction_abi_absence_owner.pgy";
import "../direct_mir_routine_param_fact_owner.pgy";
import "direct_mir_scalar_program_parameter_fact_projection_owner.pgy";
import "direct_mir_scalar_program_expression_fact_owner.pgy";
import "../../../mir_lower/abi_layout_admission_fact_owner.pgy";
import "../../../mir_lower/routine_instruction_scalar_capture_owner.pgy";
import "direct_mir_scalar_program_option_int_instruction_abi_owner.pgy";

func DirectMirScalarProgramOptionIntAbiFromParameter(
    current: DirectMirOptionMatchAbiFact, own parameter: DirectMirRoutineParamFact
) -> DirectMirOptionMatchAbiFact {
    if parameter.type_name != CompilerAbiLayoutOptionIntTypeName() { return current; }
    if !DirectMirRoutineParamFactReady(parameter) || parameter.carriage != "value" ||
        parameter.resource != "none" || parameter.pass_shape != "direct" || !parameter.abi_required {
        Die("direct MIR scalar program Option<Int> parameter ABI is invalid");
    }
    let abi_capture: MirAbiLayoutRowCapture = parameter.abi;
    let next: DirectMirOptionMatchAbiFact = DirectMirOptionMatchAbiFactFromCapture(abi_capture);
    if current.valid && (current.layout_id != next.layout_id || current.digest != next.digest) {
        Die("direct MIR scalar program Option<Int> ABI owners disagree");
    }
    return next;
}

func DirectMirScalarProgramOptionIntAbiFromRoutineParameters(
    current: DirectMirOptionMatchAbiFact, ref routines: MirProgramRoutineIndex,
    routine_row: Int, param_count: Int
) -> DirectMirOptionMatchAbiFact {
    var ordinal: Int = 0;
    while ordinal < param_count {
        let parameter: DirectMirRoutineParamFact = DirectMirScalarProgramParamFactAtOrdinal(routines, routine_row, ordinal);
        current = DirectMirScalarProgramOptionIntAbiFromParameter(current, parameter);
        ordinal = ordinal + 1;
    }
    return current;
}

func DirectMirScalarProgramOptionIntAbiReadyForExpressions(
    ref fact: DirectMirOptionMatchAbiFact,
    ref expressions: DirectMirScalarProgramExpressionSet
) -> Bool {
    var required: Bool = false;
    var row: Int = 0;
    while row < ArrayLength(expressions.node_types) {
        if expressions.node_types[row] ==
                CompilerAbiLayoutOptionIntTypeName() {
            required = true;
        }
        row = row + 1;
    }
    if required || fact.valid { return DirectMirOptionMatchAbiFactReady(fact); }
    return DirectMirScalarProgramOptionIntAbiCanonicalEmpty(fact);
}

