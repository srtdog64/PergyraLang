// Result<P, E> match normalization for an admitted payload and payload-free
// enum error. The node tests the wrapper tag and carries one scoped binding.

import "direct_mir_scalar_program_expression_mutation_owner.pgy";
import "direct_mir_scalar_program_payload_free_enum_result_projection_owner.pgy";
import "direct_mir_scalar_program_result_int_expression_kind_owner.pgy";
import "../scalar_cfg/direct_mir_scalar_cfg_local_ref_plan_owner.pgy";
import "../../../mir/local_ref_identity_owner.pgy";
import "../../../mir_lower/match_json_fact_owner.pgy";

func DirectMirScalarProgramPayloadFreeEnumResultMatchFromInstruction(
    facts: DirectMirScalarProgramExpressionSet,
    ref instruction: JsonObjectFactTable, expression_row: Int,
    global_row: Int, local_offset: Int,
    ref signature: DirectMirRoutineSignatureFact,
    ref index: MirRoutineFactIndex,
    ref locals: DirectMirScalarCfgLocalRefPlan,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    ref referenced_enum: DirectMirScalarProgramReferencedEnumFact
) -> DirectMirScalarProgramExpressionSet {
    let match_fact: MirMatchInstructionCapture =
        MirMatchInstructionCaptureFromTable(instruction);
    if !facts.valid || expression_row < 0 ||
        expression_row + 1 != ArrayLength(facts.graph_starts) ||
        !match_fact.valid || match_fact.pattern_count != 1 ||
        match_fact.binding_count != 1 ||
        match_fact.binding_type_count != 1 {
        return DirectMirScalarProgramExpressionSetInvalid(facts);
    }
    let value_node: Int = facts.graph_roots[expression_row];
    if value_node < facts.graph_starts[expression_row] ||
        value_node >= facts.graph_starts[expression_row] +
            facts.graph_counts[expression_row] ||
        value_node >= ArrayLength(facts.node_types) ||
        facts.node_kinds[value_node] != DirectMirScalarProgramExprLocal() {
        return DirectMirScalarProgramExpressionSetInvalid(facts);
    }
    let projection: DirectMirScalarProgramPayloadFreeEnumResultProjection =
        DirectMirScalarProgramPayloadFreeEnumResultProjectionFromType(
            facts.node_types[value_node], logical_record, referenced_enum);
    if !DirectMirScalarProgramPayloadFreeEnumResultProjectionReady(
            projection, logical_record, referenced_enum) {
        return DirectMirScalarProgramExpressionSetInvalid(facts);
    }
    var expected_binding_type: String = "";
    var variant: Int = -1;
    if match_fact.variant == "Ok" {
        expected_binding_type = projection.payload_type;
        variant = DirectMirScalarProgramPayloadFreeEnumResultMatchOkVariant();
    } else if match_fact.variant == "Err" {
        expected_binding_type = projection.error_type;
        variant = DirectMirScalarProgramPayloadFreeEnumResultMatchErrVariant();
    } else { return DirectMirScalarProgramExpressionSetInvalid(facts); }
    if match_fact.binding_types[0] != expected_binding_type ||
        match_fact.pattern != Concat(match_fact.variant, Concat(
            "(", Concat(match_fact.bindings[0], ")"))) {
        return DirectMirScalarProgramExpressionSetInvalid(facts);
    }
    let source_row_opt: Option<Int> = MirMatchBindingSourceRowAtOrigin(
        index.match_binding_origins, global_row, 0);
    if !IsSome(source_row_opt) {
        return DirectMirScalarProgramExpressionSetInvalid(facts);
    }
    let source_row: Int = UnwrapOption(source_row_opt);
    let identity: String = SelfMirLocalRef(
        "destructure", signature.source_syntax_id, source_row);
    let binding_local: Int = DirectMirScalarCfgLocalIdentityRow(
        locals.local_ref_value_ids, identity);
    if binding_local < 0 || binding_local >= ArrayLength(locals.local_names) ||
        locals.local_names[binding_local] != match_fact.bindings[0] ||
        locals.local_ref_syntax_ids[binding_local] != source_row ||
        locals.local_ref_kinds[binding_local] !=
            DirectMirScalarCfgLocalRefMatchBinding() {
        return DirectMirScalarProgramExpressionSetInvalid(facts);
    }
    var graph_counts: Array<Int> = facts.graph_counts;
    var graph_roots: Array<Int> = facts.graph_roots;
    var kinds: Array<Int> = facts.node_kinds;
    var types: Array<String> = facts.node_types;
    var lefts: Array<Int> = facts.node_lefts;
    var rights: Array<Int> = facts.node_rights;
    var local_rows: Array<Int> = facts.node_local_rows;
    var params: Array<Int> = facts.node_parameter_ordinals;
    var members: Array<Int> = facts.node_member_ordinals;
    var literals: Array<String> = facts.node_literals;
    var callables: Array<Int> = facts.node_callable_rows;
    var runtime_ids: Array<Int> = facts.node_runtime_call_abi_ids;
    let condition_node: Int = ArrayLength(kinds);
    DirectMirScalarProgramAppendExpressionNode(
        kinds, types, lefts, rights, local_rows, params, members,
        literals, callables, runtime_ids,
        DirectMirScalarProgramExprPayloadFreeEnumResultMatch(),
        CompilerAbiLayoutBoolTypeName(), value_node, -1,
        binding_local + local_offset, -1, variant, "", -1, -1);
    ArraySet(graph_counts, expression_row,
        facts.graph_counts[expression_row] + 1);
    ArraySet(graph_roots, expression_row, condition_node);
    return DirectMirScalarProgramExpressionSet(
        true, 0, facts.graph_global_rows, facts.graph_starts,
        graph_counts, graph_roots, kinds, types, lefts, rights,
        local_rows, params, members, literals, callables, runtime_ids,
        facts.nary_operands);
}
