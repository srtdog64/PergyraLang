// Typed Result<P, E> projection when P is admitted scalar/record storage and
// E is a referenced payload-free enum. The declaration facts own P and E;
// this view owns their joined result identity for admission and emission.

import "direct_mir_scalar_program_referenced_enum_fact_owner.pgy";
import "direct_mir_scalar_program_logical_record_fact_owner.pgy";
import "../../../codegen/runtime_abi/result_runtime_owner.pgy";

struct DirectMirScalarProgramPayloadFreeEnumResultProjection {
    let valid: Bool;
    let type_name: String;
    let payload_type: String;
    let error_type: String;
    let payload_record_row: Int;
    let enum_row: Int;
    let c_type: String;
    let c_ok_fn: String;
    let c_err_fn: String;
    let c_is_ok_fn: String;
    let c_is_err_fn: String;
    let c_unwrap_fn: String;
    let c_unwrap_err_fn: String;
    let c_unwrap_or_fn: String;
    let llvm_type: String;
    let llvm_stem: String;
}

func DirectMirScalarProgramPayloadFreeEnumResultProjectionInvalid(
) -> DirectMirScalarProgramPayloadFreeEnumResultProjection {
    return DirectMirScalarProgramPayloadFreeEnumResultProjection(
        false, "", "", "", -1, -1, "", "", "", "", "", "", "", "",
        "", "");
}

func DirectMirScalarProgramPayloadFreeEnumResultProjectionFromType(
    type_name: String,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    ref referenced_enum: DirectMirScalarProgramReferencedEnumFact
) -> DirectMirScalarProgramPayloadFreeEnumResultProjection {
    let invalid: DirectMirScalarProgramPayloadFreeEnumResultProjection =
        DirectMirScalarProgramPayloadFreeEnumResultProjectionInvalid();
    if !DirectMirScalarProgramReferencedEnumFactReady(referenced_enum) {
        return invalid;
    }
    let runtime: ResultRuntimeFact = ResultRuntimeFactForType(type_name);
    let payload_record_row: Int = DirectMirScalarProgramLogicalRecordRow(
        logical_record, runtime.payload_type);
    if !runtime.ok || (runtime.payload_type !=
            CompilerAbiLayoutIntTypeName() && payload_record_row < 0) {
        return invalid;
    }
    let enum_row: Int = DirectMirScalarProgramReferencedEnumRow(
        referenced_enum, runtime.error_type);
    if enum_row < 0 || referenced_enum.payload_flags[enum_row] != 0 {
        return invalid;
    }
    let suffix: String = CompilerSymbolCMangledTypeName(Concat(
        runtime.payload_type, Concat("_", runtime.error_type)));
    if suffix == "" { return invalid; }
    return DirectMirScalarProgramPayloadFreeEnumResultProjection(
        true, runtime.type_name, runtime.payload_type, runtime.error_type,
        payload_record_row, enum_row, runtime.c_type, runtime.ok_fn,
        runtime.err_fn,
        runtime.is_ok_fn, runtime.is_err_fn, runtime.unwrap_fn,
        runtime.unwrap_err_fn, runtime.unwrap_or_fn,
        Concat("%pgy.scalar.result.", suffix),
        Concat("pgy.scalar.result.", suffix));
}

func DirectMirScalarProgramPayloadFreeEnumResultProjectionReady(
    ref projection: DirectMirScalarProgramPayloadFreeEnumResultProjection,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    ref referenced_enum: DirectMirScalarProgramReferencedEnumFact
) -> Bool {
    if !projection.valid || projection.type_name == "" ||
        (projection.payload_type != CompilerAbiLayoutIntTypeName() &&
         projection.payload_record_row < 0) ||
        projection.error_type == "" || projection.enum_row < 0 ||
        projection.enum_row >= ArrayLength(referenced_enum.names) ||
        projection.c_type == "" || projection.c_ok_fn == "" ||
        projection.c_err_fn == "" || projection.c_is_ok_fn == "" ||
        projection.c_is_err_fn == "" || projection.c_unwrap_fn == "" ||
        projection.c_unwrap_err_fn == "" ||
        projection.c_unwrap_or_fn == "" || projection.llvm_type == "" ||
        projection.llvm_stem == "" {
        return false;
    }
    let expected: DirectMirScalarProgramPayloadFreeEnumResultProjection =
        DirectMirScalarProgramPayloadFreeEnumResultProjectionFromType(
            projection.type_name, logical_record, referenced_enum);
    return expected.valid && expected.enum_row == projection.enum_row &&
        expected.payload_record_row == projection.payload_record_row &&
        expected.type_name == projection.type_name &&
        expected.payload_type == projection.payload_type &&
        expected.error_type == projection.error_type &&
        expected.c_type == projection.c_type &&
        expected.c_ok_fn == projection.c_ok_fn &&
        expected.c_err_fn == projection.c_err_fn &&
        expected.c_is_ok_fn == projection.c_is_ok_fn &&
        expected.c_is_err_fn == projection.c_is_err_fn &&
        expected.c_unwrap_fn == projection.c_unwrap_fn &&
        expected.c_unwrap_err_fn == projection.c_unwrap_err_fn &&
        expected.c_unwrap_or_fn == projection.c_unwrap_or_fn &&
        expected.llvm_type == projection.llvm_type &&
        expected.llvm_stem == projection.llvm_stem;
}

func DirectMirScalarProgramPayloadFreeEnumResultTypeReady(
    type_name: String,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    ref referenced_enum: DirectMirScalarProgramReferencedEnumFact
) -> Bool {
    let projection: DirectMirScalarProgramPayloadFreeEnumResultProjection =
        DirectMirScalarProgramPayloadFreeEnumResultProjectionFromType(
            type_name, logical_record, referenced_enum);
    return DirectMirScalarProgramPayloadFreeEnumResultProjectionReady(
        projection, logical_record, referenced_enum);
}
