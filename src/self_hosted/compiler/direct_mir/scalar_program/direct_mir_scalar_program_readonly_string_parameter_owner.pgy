// Exact parameter-row contract for a direct borrowed String.
import "../direct_mir_routine_signature_fact_owner.pgy";
import "../scalar_cfg/direct_mir_scalar_cfg_routine_partition_fact_owner.pgy";
import "../../abi_layout_row_owner.pgy";
func DirectMirScalarProgramReadonlyStringReturnBorrowIndependent(
    return_type: String
) -> Bool {
    if return_type == CompilerAbiLayoutVoidTypeName() { return true; }
    let row: Option<Int> = CompilerAbiLayoutRowIndex(return_type);
    return IsSome(row) && CompilerAbiLayoutRowOwnershipShapeAt(UnwrapOption(row)) ==
        CompilerAbiLayoutOwnershipPlainValue();
}
func DirectMirScalarProgramReadonlyStringParameterReady(
    ref signature: DirectMirRoutineSignatureFact, ordinal: Int
) -> Bool {
    if !DirectMirRoutineSignatureFactReady(signature) || ordinal < 0 ||
        ordinal >= signature.param_count { return false; }
    return DirectMirScalarProgramReadonlyStringReturnBorrowIndependent(
            signature.return_type) &&
        CompilerAbiLayoutReadonlyRefPassesDirect(signature.parameters.type_names[ordinal]) &&
        signature.parameters.carriages[ordinal] == "readonly-ref" &&
        signature.parameters.resources[ordinal] == "none" &&
        signature.parameters.pass_shapes[ordinal] == "direct" &&
        !signature.parameters.abi_required[ordinal] &&
        signature.parameters.abi_layout_ids[ordinal] == 0;
}
func DirectMirScalarProgramReadonlyStringTargetAt(
    ref routines: DirectMirScalarCfgRoutinePartitionFact,
    routine: Int, ordinal: Int
) -> Bool {
    if routine < 0 || routine >= ArrayLength(routines.roles) ||
        routines.roles[routine] != DirectMirScalarCfgRoutineRoleCallable() ||
        ordinal < 0 || ordinal >= routines.parameter_counts[routine] { return false; }
    let row: Int = routines.parameter_starts[routine] + ordinal;
    return row >= 0 && row < ArrayLength(routines.parameter_types) &&
        DirectMirScalarProgramReadonlyStringReturnBorrowIndependent(
            routines.return_types[routine]) &&
        CompilerAbiLayoutReadonlyRefPassesDirect(routines.parameter_types[row]) &&
        routines.parameter_carriages[row] == "readonly-ref";
}
