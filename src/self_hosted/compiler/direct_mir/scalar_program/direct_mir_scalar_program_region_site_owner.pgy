// Region sites of one admitted instruction lane (self-host MIR
// `expr0_region_sites` / `expr1_region_sites`, written by
// mir/region_site_projection_owner.pgy from the semantic region escape owner).
// A listed node is a String `+` whose value lives only for one call: the
// direct-MIR route allocates it from the routine region
// (DirectMirScalarProgramExprRegionConcatString). An absent list means no
// site; a malformed one is refused.

import "../../../lib/json_fact_table.pgy";
import "../../../mir_lower/expression_graph_persisted_read_owner.pgy";

struct DirectMirScalarProgramRegionSites {
    ok: Bool;
    // Ascending window indices of the lane's graph.
    nodes: Array<Int>;
}

func DirectMirScalarProgramRegionSitesForLane(
    ref instruction: JsonObjectFactTable, lane: Int
) -> DirectMirScalarProgramRegionSites {
    var nodes: Array<Int> = [];
    var field: String = "expr0_region_sites";
    if lane == 1 { field = "expr1_region_sites"; }
    if lane != 0 && lane != 1 {
        return DirectMirScalarProgramRegionSites(true, nodes);
    }
    let kind: Option<String> = JsonObjectFactValueKind(instruction, field);
    if !IsSome(kind) { return DirectMirScalarProgramRegionSites(true, nodes); }
    var bounds: Array<Int> = [0, 0];
    if !JsonObjectFactArrayBounds(instruction, field, bounds) {
        return DirectMirScalarProgramRegionSites(false, nodes);
    }
    let end: Int = bounds[1] - 1;
    var cursor: Int = bounds[0] + 1;
    var element_start: Int = cursor;
    while cursor <= end {
        let c: Int = JsonCharCodeAt(instruction.json, instruction.json_extent, bounds[1], cursor);
        if c == JsonAsciiCode(",") || cursor == end {
            let value: Option<Int> =
                MirExpressionGraphIndexWithin(
                    instruction.json, instruction.json_extent, element_start, cursor);
            if !IsSome(value) ||
                (ArrayLength(nodes) > 0 &&
                 UnwrapOption(value) <= nodes[ArrayLength(nodes) - 1]) {
                return DirectMirScalarProgramRegionSites(false, nodes);
            }
            ArrayPush(nodes, UnwrapOption(value));
            element_start = cursor + 1;
        }
        cursor = cursor + 1;
    }
    return DirectMirScalarProgramRegionSites(ArrayLength(nodes) > 0, nodes);
}

// Why a lane's site list cannot be read against its graph of `count` nodes;
// "" when it can.
func DirectMirScalarProgramRegionSitesFailure(
    ref sites: DirectMirScalarProgramRegionSites, count: Int
) -> String {
    if !sites.ok { return "region-site-list"; }
    let n: Int = ArrayLength(sites.nodes);
    if n > 0 && sites.nodes[n - 1] >= count { return "region-site-window"; }
    return "";
}

func DirectMirScalarProgramRegionSiteListed(
    ref sites: DirectMirScalarProgramRegionSites, node: Int
) -> Bool {
    var i: Int = 0;
    while i < ArrayLength(sites.nodes) {
        if sites.nodes[i] == node { return true; }
        i = i + 1;
    }
    return false;
}
