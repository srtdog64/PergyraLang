// Contextual Result<P, E> constructor compatibility at routine returns.

import "../../../codegen/runtime_abi/result_runtime_owner.pgy";
import "../../../semantic/wrapper_type_owner.pgy";

func DirectMirScalarProgramResultReturnAbiReady(
    text: String, persisted_type: String, expected_type: String
) -> Bool {
    let expected: ResultRuntimeFact = ResultRuntimeFactForType(expected_type);
    let persisted_payload: Option<String> =
        ResultPayloadTypeOpt(persisted_type);
    let persisted_error: Option<String> =
        ResultErrorTypeOpt(persisted_type);
    if !expected.ok || !IsSome(persisted_payload) {
        return false;
    }
    if StartsWith(text, "Ok(") {
        if UnwrapOption(persisted_payload) != expected.payload_type {
            return false;
        }
        return !IsSome(persisted_error) ||
            UnwrapOption(persisted_error) == "Unknown" ||
            UnwrapOption(persisted_error) == expected.error_type;
    }
    return StartsWith(text, "Err(") && IsSome(persisted_error) &&
        UnwrapOption(persisted_payload) == "Unknown" &&
        UnwrapOption(persisted_error) == expected.error_type;
}
