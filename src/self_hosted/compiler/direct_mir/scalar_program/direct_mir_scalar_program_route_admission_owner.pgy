// One-pass scalar-program route admission with a stable rejection receipt.
// The terminal dispatcher consumes the receipt only after every earlier route
// declines; it never rescans the MIR to reconstruct the failed decision.
import "direct_mir_scalar_program_route_fact_owner.pgy";
import "direct_mir_scalar_program_array_bool_abi_capture_owner.pgy";
import "direct_mir_scalar_program_callable_route_envelope_owner.pgy";
import "direct_mir_scalar_program_callable_signature_owner.pgy";
import "../direct_mir_routine_signature_fact_owner.pgy";
import "../scalar_cfg/direct_mir_scalar_cfg_type_family_owner.pgy";
import "../../../mir_lower/routine_inventory_owner.pgy";
import "direct_mir_scalar_program_role_declaration_owner.pgy";
import "../../codegen_route_refusal_owner.pgy";
import "../direct_mir_identity_cell_type_join_owner.pgy";
import "direct_mir_scalar_program_logical_record_validation_receipt_owner.pgy";
import "direct_mir_scalar_program_record_field_array_abi_owner.pgy";
struct DirectMirScalarProgramRouteAdmission {
    let valid: Bool;
    let route: DirectMirScalarProgramRouteFact;
    let owner: String;
    let stage: String;
    let routine_ordinal: Int;
    let routine_name: String;
    let parameter_ordinal: Int;
    let type_name: String;
    let carriage: String;
}
func DirectMirScalarProgramRouteAdmissionOwnerStageReady(
    owner: String, stage: String
) -> Bool {
    if owner == "scalar-program-route" {
        return stage == "ready" || stage == "routine-count" || stage == "routine-instance" ||
            stage == "declaration-index" || stage == "role-receiver-unsupported" ||
            stage == "opaque-readonly-zone" ||
            stage == "logical-record" || stage == "referenced-enum" ||
            stage == "payload-free-enum" ||
            stage == "entrypoint" ||
            stage == "array-int-value-result-abi" || stage == "array-bool-abi" ||
            stage == "array-string-abi" || stage == "seal-claim" ||
            stage == "seal-routine-rows" || stage == "seal-routine-instance" ||
            stage == "seal-logical-record" || stage == "seal-identity-cell" ||
            stage == "seal-referenced-enum" || stage == "seal-payload-free-enum" ||
            stage == "seal-array-int-value-result" || stage == "seal-array-bool-abi" ||
            stage == "seal-opaque-readonly-zone" || stage == "seal-array-string-abi" ||
            stage == "seal-record-collection-abi";
    }
    if owner == "identity-cell" {
        return stage == "declaration-inventory" || stage == "field-type-join";
    }
    if owner == "role-declaration" {
        return stage == "source-identity" || stage == "declaration-schema" ||
            stage == "method-contract" || stage == "receiver-join" ||
            stage == "method-routine-join" || stage == "method-identity" ||
            stage == "impl-method-join";
    }
    if owner == "role-declaration" {
        return stage == "source-identity" || stage == "declaration-schema" ||
            stage == "method-contract" || stage == "receiver-join" ||
            stage == "method-routine-join" || stage == "method-identity" ||
            stage == "impl-method-join";
    }
    if owner == "callable-route-envelope" {
        return stage == "signature" || stage == "parameter-count" ||
            stage == "return-type" ||
            stage == "parameter-type-or-carriage";
    }
    return owner == "callable-signature" && stage == "signature-family";
}
func DirectMirScalarProgramRouteAdmissionReady(
    ref admission: DirectMirScalarProgramRouteAdmission
) -> Bool {
    if !admission.valid ||
        !DirectMirScalarProgramRouteAdmissionOwnerStageReady(
            admission.owner, admission.stage) {
        return false;
    }
    if admission.route.claimed {
        return DirectMirScalarProgramRouteFactReady(admission.route) &&
            admission.owner == "scalar-program-route" &&
            admission.stage == "ready" && admission.routine_ordinal == -1 &&
            admission.routine_name == "" &&
            admission.parameter_ordinal == -1 &&
            admission.type_name == "" && admission.carriage == "";
    }
    if !DirectMirScalarProgramRouteFactCanonicalEmpty(admission.route) ||
        admission.stage == "ready" || admission.routine_ordinal < -1 ||
        admission.parameter_ordinal < -1 {
        return false;
    }
    if admission.routine_ordinal < 0 {
        return admission.routine_name == "" &&
            admission.parameter_ordinal == -1;
    }
    if admission.routine_name == "" { return false; }
    if admission.parameter_ordinal >= 0 {
        return admission.type_name != "" && admission.carriage != "";
    }
    return admission.carriage == "";
}

func DirectMirScalarProgramRouteAdmissionRejected(
    owner: String, stage: String, routine_ordinal: Int,
    routine_name: String, parameter_ordinal: Int,
    type_name: String, carriage: String
) -> DirectMirScalarProgramRouteAdmission {
    return DirectMirScalarProgramRouteAdmission(
        true, DirectMirScalarProgramRouteFactEmpty(), owner, stage,
        routine_ordinal, routine_name, parameter_ordinal, type_name, carriage);
}

func DirectMirScalarProgramRouteAdmissionAccepted(
    route: DirectMirScalarProgramRouteFact
) -> DirectMirScalarProgramRouteAdmission {
    return DirectMirScalarProgramRouteAdmission(
        true, route, "scalar-program-route", "ready", -1, "", -1, "", "");
}

// Malformed claimed identity/role facts cannot be rescued by a legacy route.
func DirectMirScalarProgramRouteAdmissionEndsDispatch(ref admission: DirectMirScalarProgramRouteAdmission) -> Bool {
    return admission.valid && !admission.route.claimed &&
        (admission.owner == "identity-cell" || admission.owner == "role-declaration");
}

func DirectMirScalarProgramRouteAdmissionRefusal(ref admission: DirectMirScalarProgramRouteAdmission) -> CodegenRouteRefusal {
    if !DirectMirScalarProgramRouteAdmissionReady(admission) || admission.route.claimed {
        Die("direct MIR scalar program route admission receipt is invalid"); }
    if admission.owner == "identity-cell" { return CodegenRouteRefusal(
        admission.owner, admission.stage, "direct MIR identity cell declaration inventory is invalid"); }
    return CodegenRouteRefusal(admission.owner, admission.stage, Concat(
        "direct MIR scalar program route rejected: owner=", Concat(admission.owner,
        Concat(" stage=", Concat(admission.stage, Concat(" routine=", Concat(ToString(admission.routine_ordinal),
        Concat(" name=", Concat(admission.routine_name, Concat(" parameter=", Concat(ToString(admission.parameter_ordinal),
        Concat(" type=", Concat(admission.type_name, Concat(" carriage=", admission.carriage))))))))))))));
}

// The default C scalar substitution has no typed refusal consumer yet.
func DirectMirScalarProgramRouteAdmissionDie(ref admission: DirectMirScalarProgramRouteAdmission) -> Void {
    let refusal: CodegenRouteRefusal = DirectMirScalarProgramRouteAdmissionRefusal(admission);
    Die(refusal.message);
}

func DirectMirScalarProgramRouteAdmissionFromAdmitted(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    generic_calls: MirGenericCallOccurrenceIndex,
    generic_instances: GenericInstanceClosure
) -> DirectMirScalarProgramRouteAdmission {
    let identity_cells: DirectMirIdentityCellFacts = DirectMirIdentityCellFactsFromDeclarations(
        admitted.document.root.json, admitted.document.root.json_extent, admitted.domain_runtime_admission.declarations);
    if !identity_cells.valid { return DirectMirScalarProgramRouteAdmissionRejected(
        "identity-cell", "declaration-inventory", -1, "", -1, "", ""); }
    let routine_instances: DirectMirRoutineInstanceInventory = DirectMirRoutineInstanceInventoryFromOwners(
        admitted.routines, generic_calls, generic_instances, identity_cells);
    if !routine_instances.valid {
        return DirectMirScalarProgramRouteAdmissionRejected(
            "scalar-program-route", "routine-instance", -1, "", -1, routine_instances.diagnostic, "");
    }
    let routine_count: Int = ArrayLength(routine_instances.source_rows);
    if routine_count < 1 { return DirectMirScalarProgramRouteAdmissionRejected(
        "scalar-program-route", "routine-count", -1, "", -1, "", ""); }
    if !JsonArrayObjectFactTableReady(admitted.document.declarations) { return DirectMirScalarProgramRouteAdmissionRejected(
        "scalar-program-route", "declaration-index", -1, "", -1, "", ""); }
    let roles: DirectMirScalarProgramRoleDeclarationAssessment =
        DirectMirScalarProgramRoleDeclarationsAssess(admitted.routines, routine_instances);
    if !roles.supported {
        if roles.terminal { return DirectMirScalarProgramRouteAdmissionRejected(
            "role-declaration", roles.stage, -1, "", -1, roles.name, ""); }
        return DirectMirScalarProgramRouteAdmissionRejected(
            "scalar-program-route", "role-receiver-unsupported", -1, "", -1, roles.name, "");
    }
    let referenced_enum: DirectMirScalarProgramReferencedEnumFact =
        DirectMirScalarProgramReferencedEnumFactFromAdmitted(admitted, routine_instances);
    if !DirectMirScalarProgramReferencedEnumFactReady(referenced_enum) {
        return DirectMirScalarProgramRouteAdmissionRejected(
            "scalar-program-route", "referenced-enum", -1, "", -1, "", "");
    }
    let payload_free_enum: DirectMirScalarProgramPayloadFreeEnumFact =
        DirectMirScalarProgramPayloadFreeEnumFactFromReferenced(
            referenced_enum);
    if !DirectMirScalarProgramPayloadFreeEnumFactReady(payload_free_enum) {
        return DirectMirScalarProgramRouteAdmissionRejected(
            "scalar-program-route", "payload-free-enum",
            -1, "", -1, "", "");
    }
    let logical_record: DirectMirScalarProgramLogicalRecordFact =
        DirectMirScalarProgramLogicalRecordFactForRouteDemand(
            admitted, routine_instances, payload_free_enum,
            identity_cells, false);
    if !DirectMirScalarProgramLogicalRecordFactReady(logical_record) ||
        !DirectMirScalarProgramLogicalRecordPayloadFreeEnumJoinReady(
            logical_record, payload_free_enum) {
        return DirectMirScalarProgramRouteAdmissionRejected(
            "scalar-program-route", "logical-record", -1, "", -1, "", "");
    }
    if !DirectMirIdentityCellFieldTypesReady(
            identity_cells, referenced_enum) {
        return DirectMirScalarProgramRouteAdmissionRejected(
            "identity-cell", "field-type-join", -1, "", -1, "", "");
    }
    let opaque_readonly_zones:
        DirectMirScalarProgramOpaqueReadonlyZoneFact =
            DirectMirScalarProgramOpaqueReadonlyZoneFactFromOwners(
                admitted, routine_instances);
    if !DirectMirScalarProgramOpaqueReadonlyZoneFactReady(
            opaque_readonly_zones) {
        return DirectMirScalarProgramRouteAdmissionRejected(
            "scalar-program-route", "opaque-readonly-zone",
            -1, "", -1, "", "");
    }
    // A one-routine program is its entrypoint; a longer one is checked
    // routine by routine. The inventory seals the selected entrypoint (Main,
    // or a unique lowercase main) at row 0.
    var routine_rows: Array<Int> = [];
    var row: Int = 0;
    while row < routine_count {
        let signature: DirectMirRoutineSignatureFact =
            DirectMirRoutineInstanceSignatureAt(routine_instances, row);
        if routine_count > 1 && row == 0 && (!DirectMirRoutineSignatureFactReady(signature) ||
                !DirectMirScalarCfgEntrypointReturnTypeSupported(signature.return_type) ||
                signature.param_count != 0) {
            return DirectMirScalarProgramRouteAdmissionRejected(
                "scalar-program-route", "entrypoint", row,
                signature.name, -1, signature.return_type, "");
        }
        if row > 0 {
            let assessment:
                DirectMirScalarProgramCallableRouteEnvelopeAssessment =
                    DirectMirScalarProgramCallableRouteEnvelopeAssessWithReferencedEnum(
                        signature, logical_record,
                        payload_free_enum, referenced_enum,
                        opaque_readonly_zones);
            if !DirectMirScalarProgramCallableRouteEnvelopeAssessmentReady(
                    assessment) || !assessment.supported {
                return DirectMirScalarProgramRouteAdmissionRejected(
                    "callable-route-envelope", assessment.stage, row,
                    signature.name, assessment.parameter_ordinal,
                    assessment.type_name, assessment.carriage);
            }
            if !DirectMirScalarProgramCallableSignatureSupportedWithReferencedEnum(
                    signature, logical_record, payload_free_enum,
                    referenced_enum, opaque_readonly_zones) {
                return DirectMirScalarProgramRouteAdmissionRejected(
                    "callable-signature", "signature-family", row,
                    signature.name, -1, signature.return_type, "");
            }
        }
        ArrayPush(routine_rows, routine_instances.source_rows[row]);
        row = row + 1;
    }
    let entrypoint_row: Int = routine_rows[0];
    var callable_row: Int = -1;
    if routine_count == 2 { callable_row = routine_rows[1]; }
    let array_int_value_result:
        DirectMirScalarProgramArrayIntValueResultFact =
            DirectMirScalarProgramArrayIntAbiForRecordFields(
                DirectMirScalarProgramArrayIntValueResultFactFromAdmitted(
                    admitted, routine_instances, routine_rows), logical_record);
    if !DirectMirScalarProgramArrayIntValueResultFactReady(
            array_int_value_result) {
        return DirectMirScalarProgramRouteAdmissionRejected(
            "scalar-program-route", "array-int-value-result-abi",
            -1, "", -1, "", "");
    }
    let array_bool_abi: DirectMirScalarProgramArrayBoolAbiFact =
        DirectMirScalarProgramArrayBoolAbiForRecordFields(
            DirectMirScalarProgramArrayBoolAbiFactFromAdmitted(
                admitted, routine_instances, routine_rows, logical_record), logical_record);
    if !DirectMirScalarProgramArrayBoolAbiFactReady(array_bool_abi) {
        return DirectMirScalarProgramRouteAdmissionRejected(
            "scalar-program-route", "array-bool-abi",
            -1, "", -1, "", "");
    }
    let array_string_abi: DirectMirScalarProgramArrayStringAbiFact =
        DirectMirScalarProgramArrayStringAbiFactFromAdmitted(
            admitted, routine_instances, routine_rows, logical_record, payload_free_enum);
    if !DirectMirScalarProgramArrayStringAbiFactReady(array_string_abi) &&
        !DirectMirScalarProgramArrayStringAbiFactCanonicalEmpty(
            array_string_abi) {
        return DirectMirScalarProgramRouteAdmissionRejected(
            "scalar-program-route", "array-string-abi",
            -1, "", -1, "", "");
    }
    let source: DirectMirScalarProgramRouteFact =
        DirectMirScalarProgramRouteFact(
            true, 0, entrypoint_row, callable_row, routine_rows,
            logical_record, referenced_enum, payload_free_enum,
            array_int_value_result,
            array_bool_abi, array_string_abi, opaque_readonly_zones,
            routine_instances);
    let sealed: DirectMirScalarProgramRouteFact =
        DirectMirScalarProgramRouteFact(
            true, DirectMirScalarProgramRouteFactDigest(source),
            entrypoint_row, callable_row, routine_rows,
            logical_record, referenced_enum, payload_free_enum,
            array_int_value_result,
            array_bool_abi, array_string_abi, opaque_readonly_zones,
            routine_instances);
    let seal_failure: String = DirectMirScalarProgramRouteFactSealFailure(sealed);
    if seal_failure != "" {
        return DirectMirScalarProgramRouteAdmissionRejected(
            "scalar-program-route", seal_failure, -1, "", -1, "", "");
    }
    return DirectMirScalarProgramRouteAdmissionAccepted(sealed);
}
