// Scalar program claim keyed by typed routine and declaration envelopes.
import "../scalar_cfg/direct_mir_scalar_cfg_hash_owner.pgy";
import "direct_mir_scalar_program_array_int_value_result_fact_owner.pgy";
import "direct_mir_scalar_program_array_bool_abi_owner.pgy";
import "direct_mir_scalar_program_array_string_abi_owner.pgy";
import "direct_mir_scalar_program_logical_record_fact_owner.pgy";
import "direct_mir_scalar_program_payload_free_enum_fact_owner.pgy";
import "direct_mir_scalar_program_logical_record_payload_free_enum_join_owner.pgy";
import "direct_mir_scalar_program_logical_record_collection_abi_owner.pgy";
import "../direct_mir_routine_instance_inventory_owner.pgy";
import "direct_mir_scalar_program_opaque_readonly_zone_fact_owner.pgy";
struct DirectMirScalarProgramRouteFact {
    let claimed: Bool; let digest: Int;
    let entrypoint_row: Int; let callable_row: Int;
    let routine_rows: Array<Int>;
    let logical_record: DirectMirScalarProgramLogicalRecordFact;
    let referenced_enum: DirectMirScalarProgramReferencedEnumFact;
    let payload_free_enum: DirectMirScalarProgramPayloadFreeEnumFact;
    let array_int_value_result: DirectMirScalarProgramArrayIntValueResultFact;
    let array_bool_abi: DirectMirScalarProgramArrayBoolAbiFact;
    let array_string_abi: DirectMirScalarProgramArrayStringAbiFact;
    let opaque_readonly_zones: DirectMirScalarProgramOpaqueReadonlyZoneFact;
    let routine_instances: DirectMirRoutineInstanceInventory;
}
func DirectMirScalarProgramRouteFactEmpty() -> DirectMirScalarProgramRouteFact {
    let rows: Array<Int> = [];
    return DirectMirScalarProgramRouteFact(false, 0, -1, -1, rows,
        DirectMirScalarProgramLogicalRecordFactInvalid(),
        DirectMirScalarProgramReferencedEnumFactInvalid(),
        DirectMirScalarProgramPayloadFreeEnumFactInvalid(),
        DirectMirScalarProgramArrayIntValueResultFactInvalid(),
        DirectMirScalarProgramArrayBoolAbiFactInvalid(),
        DirectMirScalarProgramArrayStringAbiFactEmpty(),
        DirectMirScalarProgramOpaqueReadonlyZoneFactInvalid(),
        DirectMirRoutineInstanceInventoryEmpty(""));
}
func DirectMirScalarProgramRouteFactCanonicalEmpty(ref fact: DirectMirScalarProgramRouteFact
) -> Bool {
    return !fact.claimed && fact.digest == 0 && fact.entrypoint_row == -1 &&
        fact.callable_row == -1 && ArrayLength(fact.routine_rows) == 0 &&
        !fact.logical_record.valid && !fact.referenced_enum.valid &&
        !fact.payload_free_enum.valid &&
        !fact.array_int_value_result.valid && !fact.array_bool_abi.valid &&
        !fact.opaque_readonly_zones.valid &&
        !fact.routine_instances.valid &&
        DirectMirScalarProgramArrayStringAbiFactCanonicalEmpty(
            fact.array_string_abi);
}
func DirectMirScalarProgramRouteFactDigest(
    ref fact: DirectMirScalarProgramRouteFact
) -> Int {
    if !fact.claimed { return 0; }
    var hash: Long = DirectMirCfgHashInt(223L, fact.entrypoint_row);
    hash = DirectMirCfgHashInt(hash, fact.callable_row);
    hash = DirectMirScalarCfgHashInts(hash, fact.routine_rows);
    hash = DirectMirCfgHashInt(hash, fact.logical_record.digest);
    hash = DirectMirCfgHashInt(hash, fact.referenced_enum.digest);
    hash = DirectMirCfgHashInt(hash, fact.payload_free_enum.digest);
    hash = DirectMirCfgHashInt(hash, fact.array_int_value_result.digest);
    hash = DirectMirCfgHashInt(hash, fact.array_bool_abi.digest);
    hash = DirectMirCfgHashInt(hash, fact.array_string_abi.digest);
    hash = DirectMirCfgHashInt(hash, fact.opaque_readonly_zones.digest);
    hash = DirectMirCfgHashInt(hash, fact.routine_instances.digest);
    return DirectMirCfgBoundedDigest(hash);
}
func DirectMirScalarProgramRouteFactReady(ref fact: DirectMirScalarProgramRouteFact) -> Bool {
    return DirectMirScalarProgramRouteFactSealFailure(fact) == "";
}

// The first condition a route fact fails, named as the refusal stage the
// route admission reports; "" when the fact is ready.
func DirectMirScalarProgramRouteFactSealFailure(ref fact: DirectMirScalarProgramRouteFact) -> String {
    let count: Int = ArrayLength(fact.routine_rows);
    if !fact.claimed || fact.digest == 0 || count < 1 ||
        fact.digest != DirectMirScalarProgramRouteFactDigest(fact) { return "seal-claim"; }
    if fact.entrypoint_row < 0 || fact.routine_rows[0] != fact.entrypoint_row ||
        ((count == 2) != (fact.callable_row >= 0)) ||
        (count == 2 && fact.routine_rows[1] != fact.callable_row) ||
        (count != 2 && fact.callable_row >= 0) { return "seal-routine-rows"; }
    if !DirectMirRoutineInstanceInventoryReady(fact.routine_instances) ||
        count != ArrayLength(fact.routine_instances.source_rows) { return "seal-routine-instance"; }
    if !DirectMirScalarProgramLogicalRecordFactReady(fact.logical_record) { return "seal-logical-record"; }
    if fact.logical_record.identity_cells.digest != fact.routine_instances.identity_cells.digest {
        return "seal-identity-cell"; }
    if !DirectMirScalarProgramReferencedEnumFactReady(fact.referenced_enum) { return "seal-referenced-enum"; }
    if !DirectMirScalarProgramPayloadFreeEnumFactReady(fact.payload_free_enum) ||
        !DirectMirScalarProgramReferencedEnumPayloadFreeProjectionReady(
            fact.referenced_enum, fact.payload_free_enum) ||
        !DirectMirScalarProgramLogicalRecordPayloadFreeEnumJoinReady(
            fact.logical_record, fact.payload_free_enum) { return "seal-payload-free-enum"; }
    if !DirectMirScalarProgramArrayIntValueResultFactReady(fact.array_int_value_result) {
        return "seal-array-int-value-result"; }
    if !DirectMirScalarProgramArrayBoolAbiFactReady(fact.array_bool_abi) { return "seal-array-bool-abi"; }
    if !DirectMirScalarProgramOpaqueReadonlyZoneFactReady(fact.opaque_readonly_zones) {
        return "seal-opaque-readonly-zone"; }
    if !DirectMirScalarProgramArrayStringAbiFactReady(fact.array_string_abi) &&
        !DirectMirScalarProgramArrayStringAbiFactCanonicalEmpty(fact.array_string_abi) {
        return "seal-array-string-abi"; }
    if !DirectMirScalarProgramLogicalRecordCollectionAbiReady(
            fact.logical_record, fact.array_int_value_result, fact.array_bool_abi,
            fact.array_string_abi) { return "seal-record-collection-abi"; }
    var row: Int = 0;
    while row < count {
        if fact.routine_rows[row] < 0 || fact.routine_rows[row] != fact.routine_instances.source_rows[row] {
            return "seal-routine-instance";
        }
        var prior: Int = 0;
        while prior < row {
            if fact.routine_rows[prior] == fact.routine_rows[row] &&
                fact.routine_instances.instance_rows[prior] == fact.routine_instances.instance_rows[row] {
                return "seal-routine-instance";
            }
            prior = prior + 1;
        }
        row = row + 1;
    }
    return "";
}
