// Derives the sealed runtime ABI only from normalized expression kinds.

import "direct_mir_scalar_program_string_runtime_requirement_owner.pgy";

func DirectMirScalarProgramRuntimeAbiFactFromExpressionKinds(
    ref expressions: DirectMirScalarProgramExpressionSet
) -> DirectMirScalarProgramRuntimeAbiFact {
    return DirectMirScalarProgramStringRuntimeRequirement(expressions);
}
