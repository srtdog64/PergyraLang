// Exact formal identity selects current mutable parameter storage.
import "direct_mir_scalar_program_value_result_union_owner.pgy";
import "direct_mir_scalar_program_owned_array_string_parameter_target_owner.pgy";
import "../../../mir/local_ref_identity_owner.pgy";

// A formal with SSA definitions has one exact GraphPlan local; an untouched
// formal remains in its entry storage. Source spelling never selects either.
func DirectMirScalarProgramParameterCurrentStorageLocalRow(
    ref plan: DirectMirScalarCfgGraphPlan, routine: Int, ordinal: Int
) -> Int {
    if !DirectMirScalarProgramParameterValueResultAt(plan, routine, ordinal) &&
        !DirectMirScalarProgramOwnedArrayStringMutationParameterAt(
            plan.routines, routine, ordinal) {
        Die("direct MIR current storage requires an admitted mutable formal");
    }
    let identity: String = SelfMirLocalRef(
        "parameter", plan.routines.source_syntax_ids[routine], ordinal);
    var found: Int = -1;
    var row: Int = plan.routines.local_starts[routine];
    let end: Int = row + plan.routines.local_counts[routine];
    while row < end {
        if plan.local_ref_value_ids[row] == identity {
            if found >= 0 || plan.local_types[row] != plan.routines.parameter_types[
                    plan.routines.parameter_starts[routine] + ordinal] {
                Die("direct MIR mutable parameter storage identity is ambiguous");
            }
            found = row;
        }
        row = row + 1;
    }
    return found;
}

func DirectMirScalarProgramParameterValueResultLocalRow(
    ref plan: DirectMirScalarCfgGraphPlan, routine: Int, ordinal: Int
) -> Int {
    if !DirectMirScalarProgramParameterValueResultAt(plan, routine, ordinal) {
        Die("direct MIR value-result storage requires an admitted formal");
    }
    return DirectMirScalarProgramParameterCurrentStorageLocalRow(
        plan, routine, ordinal);
}
