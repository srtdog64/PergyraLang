// Admits one value-result argument and any parameter-to-parameter copyout chain.
import "../scalar_cfg/direct_mir_scalar_cfg_graph_fact_owner.pgy";
import "direct_mir_scalar_program_logical_record_value_result_target_owner.pgy";
import "direct_mir_scalar_program_logical_record_array_value_result_target_owner.pgy";
import "direct_mir_scalar_program_array_int_value_result_fact_owner.pgy";
import "direct_mir_scalar_program_set_string_value_result_target_owner.pgy";
import "direct_mir_scalar_program_hashmap_value_result_target_owner.pgy";
import "direct_mir_scalar_program_value_result_union_owner.pgy";
func DirectMirScalarProgramValueResultCarriageReady(
    ref plan: DirectMirScalarCfgGraphPlan,
    ref facts: DirectMirScalarProgramExpressionSet,
    argument_node: Int, routine: Int, target: Int, ordinal: Int
) -> Bool {
    let scalar_copyout: Bool = DirectMirScalarProgramScalarValueResultAt(plan, target, ordinal);
    let array_string_copyout: Bool = DirectMirScalarProgramArrayStringValueResultAt(
        plan.program.array_string_abi, target, ordinal);
    let array_int_copyout: Bool = DirectMirScalarProgramArrayIntValueResultAt(
        plan.program.array_int_value_result, target, ordinal);
    let array_bool_copyout: Bool = DirectMirScalarProgramArrayBoolValueResultAt(
        plan.program.array_bool_abi, target, ordinal);
    let logical_record_copyout: Bool = DirectMirScalarProgramLogicalRecordValueResultAt(
        plan, target, ordinal);
    let logical_record_array_copyout: Bool =
        DirectMirScalarProgramLogicalRecordArrayValueResultAt(plan, target, ordinal);
    let set_string_copyout: Bool =
        DirectMirScalarProgramSetStringValueResultAt(plan, target, ordinal);
    let hashmap_copyout: Bool =
        DirectMirScalarProgramHashMapValueResultAt(plan, target, ordinal);
    if !scalar_copyout && !array_string_copyout && !array_int_copyout &&
        !array_bool_copyout && !logical_record_copyout &&
        !logical_record_array_copyout && !set_string_copyout &&
        !hashmap_copyout { return false; }
    if facts.node_kinds[argument_node] != DirectMirScalarProgramExprParameter() {
        return true;
    }
    let source_ordinal: Int = facts.node_parameter_ordinals[argument_node];
    let source_parameter_row: Int =
        plan.routines.parameter_starts[routine] + source_ordinal;
    let source_carriage: String =
        plan.routines.parameter_carriages[source_parameter_row];
    let value_input: Bool = source_carriage == "value" &&
        (scalar_copyout || array_int_copyout || logical_record_copyout);
    if value_input { return true; }
    return !((scalar_copyout &&
            !DirectMirScalarProgramScalarValueResultAt(plan, routine, source_ordinal)) ||
        (array_string_copyout &&
            !DirectMirScalarProgramArrayStringValueResultAt(
                plan.program.array_string_abi, routine, source_ordinal)) ||
        (array_int_copyout &&
            !DirectMirScalarProgramArrayIntValueResultAt(
                plan.program.array_int_value_result, routine, source_ordinal)) ||
        (array_bool_copyout &&
            !DirectMirScalarProgramArrayBoolValueResultAt(
                plan.program.array_bool_abi, routine, source_ordinal)) ||
        (logical_record_copyout &&
            !DirectMirScalarProgramLogicalRecordValueResultAt(plan, routine, source_ordinal)) ||
        (logical_record_array_copyout &&
            !DirectMirScalarProgramLogicalRecordArrayValueResultAt(
                plan, routine, source_ordinal)) ||
        (set_string_copyout &&
            !DirectMirScalarProgramSetStringValueResultAt(
                plan, routine, source_ordinal)) ||
        (hashmap_copyout &&
            !DirectMirScalarProgramHashMapValueResultAt(
                plan, routine, source_ordinal)));
}
