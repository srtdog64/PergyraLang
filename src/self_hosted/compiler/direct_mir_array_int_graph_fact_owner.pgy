// Typed expression-graph facts for the bounded local Array<Int> rung.
// This owner closes literal spines, assignment target, length-call identity,
// and index/add topology before the target-neutral plan is constructed.

import "../mir_lower/expression_graph_sequence_owner.pgy";
import "../mir_lower/program_instruction_expression_index_owner.pgy";
import "direct_mir_array_literal_spine_owner.pgy";

func DirectMirArrayIntGraphFromExpressionFact(
    json: String, ref fact: MirProgramInstructionExpressionFact,
    slot: Int
) -> MirExpressionGraphSequence {
    let graph: JsonObjectFactTable =
        MirProgramInstructionExpressionGraphTable(json, fact, slot);
    if !graph.valid {
        Die("direct MIR Array<Int> expression graph fact is missing");
    }
    return MirExpressionGraphSequenceAppend(
        MirExpressionGraphSequenceEmpty(), graph
    );
}

func DirectMirArrayIntLiteralElements(
    ref sequence: MirExpressionGraphSequence
) -> Array<Int> {
    let values: Array<Int> = [];
    let nodes: Array<Int> = DirectMirArrayLiteralElementNodes(
        sequence, AstExpressionNodeIntegerLiteral()
    );
    if ArrayLength(nodes) < 1 {
        Die("direct MIR Array<Int> literal graph shape is invalid");
    }
    let row: Int = 0;
    while row < ArrayLength(nodes) {
        let literal: String = sequence.arena.node_texts[nodes[row]];
        if literal == "" ||
            ToString(ToInt(literal)) != literal {
            Die("direct MIR Array<Int> element or spine fact is invalid");
        }
        ArrayPush(values, ToInt(literal));
        row = row + 1;
    }
    return values;
}

func DirectMirArrayIntAssignmentTargetReady(
    ref sequence: MirExpressionGraphSequence, local_name: String
) -> Bool {
    return sequence.ok && sequence.ready_node_count == 1 &&
        ArrayLength(sequence.roots) == 1 && sequence.roots[0] == 0 &&
        ArrayLength(sequence.arena.topology.node_kinds) == 1 &&
        sequence.arena.topology.node_kinds[0] == AstExpressionNodeLeaf() &&
        ArrayLength(sequence.arena.node_texts) == 1 &&
        sequence.arena.node_texts[0] == local_name &&
        ArrayLength(sequence.arena.call_target_kinds) == 1 &&
        sequence.arena.call_target_kinds[0] == SemanticCallTargetNone() &&
        ArrayLength(sequence.arena.call_target_names) == 1 &&
        sequence.arena.call_target_names[0] == "";
}

func DirectMirArrayIntLengthGraphReady(
    ref sequence: MirExpressionGraphSequence, local_name: String
) -> Bool {
    return sequence.ok && sequence.ready_node_count == 7 &&
        ArrayLength(sequence.roots) == 1 && sequence.roots[0] == 6 &&
        ArrayLength(sequence.arena.topology.node_kinds) == 7 &&
        ArrayLength(sequence.arena.node_texts) == 7 &&
        sequence.arena.topology.node_kinds[0] == AstExpressionNodeLeaf() &&
        sequence.arena.node_texts[0] == "ToString" &&
        sequence.arena.topology.node_kinds[1] == AstExpressionNodeCall() &&
        sequence.arena.topology.left_children[1] == 0 &&
        sequence.arena.call_target_kinds[1] == SemanticCallTargetDirect() &&
        sequence.arena.call_target_names[1] == "ToString" &&
        sequence.arena.topology.node_kinds[2] == AstExpressionNodeLeaf() &&
        sequence.arena.node_texts[2] == "ArrayLength" &&
        sequence.arena.topology.node_kinds[3] == AstExpressionNodeCall() &&
        sequence.arena.topology.left_children[3] == 2 &&
        sequence.arena.call_target_kinds[3] == SemanticCallTargetDirect() &&
        sequence.arena.call_target_names[3] == "ArrayLength" &&
        sequence.arena.topology.node_kinds[4] == AstExpressionNodeLeaf() &&
        sequence.arena.node_texts[4] == local_name &&
        sequence.arena.topology.node_kinds[5] ==
            AstExpressionNodeCallArgument() &&
        sequence.arena.topology.left_children[5] == 3 &&
        sequence.arena.topology.right_children[5] == 4 &&
        sequence.arena.topology.node_kinds[6] ==
            AstExpressionNodeCallArgument() &&
        sequence.arena.topology.left_children[6] == 1 &&
        sequence.arena.topology.right_children[6] == 5;
}

func DirectMirArrayIntIndexGraphIndices(
    ref sequence: MirExpressionGraphSequence, local_name: String
) -> Array<Int> {
    let indices: Array<Int> = [];
    if !sequence.ok || sequence.ready_node_count != 10 ||
        ArrayLength(sequence.roots) != 1 || sequence.roots[0] != 9 ||
        ArrayLength(sequence.arena.topology.node_kinds) != 10 ||
        ArrayLength(sequence.arena.node_texts) != 10 ||
        sequence.arena.topology.node_kinds[0] != AstExpressionNodeLeaf() ||
        sequence.arena.node_texts[0] != "ToString" ||
        sequence.arena.topology.node_kinds[1] != AstExpressionNodeCall() ||
        sequence.arena.topology.left_children[1] != 0 ||
        sequence.arena.call_target_kinds[1] != SemanticCallTargetDirect() ||
        sequence.arena.call_target_names[1] != "ToString" ||
        sequence.arena.topology.node_kinds[2] != AstExpressionNodeLeaf() ||
        sequence.arena.node_texts[2] != local_name ||
        sequence.arena.topology.node_kinds[3] !=
            AstExpressionNodeIntegerLiteral() ||
        sequence.arena.topology.node_kinds[4] != AstExpressionNodeIndex() ||
        sequence.arena.topology.left_children[4] != 2 ||
        sequence.arena.topology.right_children[4] != 3 ||
        sequence.arena.topology.node_kinds[5] != AstExpressionNodeLeaf() ||
        sequence.arena.node_texts[5] != local_name ||
        sequence.arena.topology.node_kinds[6] !=
            AstExpressionNodeIntegerLiteral() ||
        sequence.arena.topology.node_kinds[7] != AstExpressionNodeIndex() ||
        sequence.arena.topology.left_children[7] != 5 ||
        sequence.arena.topology.right_children[7] != 6 ||
        sequence.arena.topology.node_kinds[8] != AstExpressionNodeAdd() ||
        sequence.arena.topology.left_children[8] != 4 ||
        sequence.arena.topology.right_children[8] != 7 ||
        sequence.arena.topology.node_kinds[9] !=
            AstExpressionNodeCallArgument() ||
        sequence.arena.topology.left_children[9] != 1 ||
        sequence.arena.topology.right_children[9] != 8 {
        Die("direct MIR Array<Int> index graph shape is invalid");
    }
    let left: String = sequence.arena.node_texts[3];
    let right: String = sequence.arena.node_texts[6];
    if left == "" || right == "" || ToString(ToInt(left)) != left ||
        ToString(ToInt(right)) != right {
        Die("direct MIR Array<Int> index literal is not canonical");
    }
    ArrayPush(indices, ToInt(left));
    ArrayPush(indices, ToInt(right));
    return indices;
}
