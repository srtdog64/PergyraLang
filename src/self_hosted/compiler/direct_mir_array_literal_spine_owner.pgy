// One persisted array-literal spine validator shared by element decoders.

import "../mir_lower/expression_graph_sequence_owner.pgy";

func DirectMirArrayLiteralNodeEmptyReady(
    ref sequence: MirExpressionGraphSequence, node: Int
) -> Bool {
    let count: Int = sequence.ready_node_count;
    if !sequence.ok || node < 0 || node >= count ||
        ArrayLength(sequence.arena.topology.node_kinds) != count ||
        ArrayLength(sequence.arena.topology.left_children) != count ||
        ArrayLength(sequence.arena.topology.right_children) != count ||
        ArrayLength(sequence.arena.node_texts) != count ||
        ArrayLength(sequence.arena.call_target_kinds) != count ||
        ArrayLength(sequence.arena.call_target_names) != count ||
        ArrayLength(sequence.arena.identities.call_target_syntax_ids) != count ||
        ArrayLength(sequence.arena.identities.runtime_call_abi_ids) != count ||
        ArrayLength(sequence.arena.identities.binding_syntax_ids) != count ||
        ArrayLength(sequence.arena.identities.binding_kinds) != count ||
        ArrayLength(sequence.arena.identities.binding_ordinals) != count ||
        sequence.arena.topology.node_kinds[node] !=
            AstExpressionNodeArrayLiteral() ||
        sequence.arena.topology.left_children[node] != 0 ||
        sequence.arena.topology.right_children[node] != 0 ||
        sequence.arena.node_texts[node] != "[]" ||
        sequence.arena.call_target_kinds[node] != SemanticCallTargetNone() ||
        sequence.arena.call_target_names[node] != "" ||
        sequence.arena.identities.call_target_syntax_ids[node] != 0 ||
        sequence.arena.identities.runtime_call_abi_ids[node] != 0 ||
        sequence.arena.identities.binding_syntax_ids[node] != 0 ||
        sequence.arena.identities.binding_kinds[node] !=
            SemanticExpressionBindingNone() ||
        sequence.arena.identities.binding_ordinals[node] !=
            SemanticExpressionBindingOrdinalAbsent() { return false; }
    var candidate: Int = 0;
    while candidate < count {
        if sequence.arena.topology.node_kinds[candidate] ==
                AstExpressionNodeArrayElement() &&
            sequence.arena.topology.left_children[candidate] == node {
            return false;
        }
        candidate = candidate + 1;
    }
    return true;
}

func DirectMirArrayLiteralEmptyReady(
    ref sequence: MirExpressionGraphSequence
) -> Bool {
    return sequence.ready_node_count == 1 &&
        ArrayLength(sequence.roots) == 1 && sequence.roots[0] == 0 &&
        DirectMirArrayLiteralNodeEmptyReady(sequence, 0);
}

func DirectMirArrayLiteralElementNodes(
    ref sequence: MirExpressionGraphSequence, element_kind: Int
) -> Array<Int> {
    var nodes: Array<Int> = [];
    let count: Int = sequence.ready_node_count;
    if !sequence.ok || count < 3 || count % 2 == 0 ||
        ArrayLength(sequence.roots) != 1 || sequence.roots[0] != count - 1 ||
        ArrayLength(sequence.arena.topology.node_kinds) != count ||
        ArrayLength(sequence.arena.topology.left_children) != count ||
        ArrayLength(sequence.arena.topology.right_children) != count ||
        ArrayLength(sequence.arena.node_texts) != count ||
        ArrayLength(sequence.arena.call_target_kinds) != count ||
        ArrayLength(sequence.arena.call_target_names) != count ||
        sequence.arena.topology.node_kinds[0] !=
            AstExpressionNodeArrayLiteral() { return nodes; }
    var row: Int = 0;
    while row < count {
        if sequence.arena.call_target_kinds[row] !=
                SemanticCallTargetNone() ||
            sequence.arena.call_target_names[row] != "" { return []; }
        row = row + 1;
    }
    var element: Int = 1;
    var prior_spine: Int = 0;
    while element < count {
        let spine: Int = element + 1;
        if sequence.arena.topology.node_kinds[element] != element_kind ||
            sequence.arena.topology.node_kinds[spine] !=
                AstExpressionNodeArrayElement() ||
            sequence.arena.topology.left_children[spine] != prior_spine ||
            sequence.arena.topology.right_children[spine] != element {
            return [];
        }
        ArrayPush(nodes, element);
        prior_spine = spine;
        element = element + 2;
    }
    return nodes;
}
