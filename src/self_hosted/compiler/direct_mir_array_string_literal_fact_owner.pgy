// Canonical typed Array<String> literal payload from persisted expression DAGs.

import "direct_mir_array_literal_spine_owner.pgy";
import "direct_mir_scalar_graph_admission_owner.pgy";

struct DirectMirArrayStringLiteralFact {
    let valid: Bool;
    let elements: Array<String>;
}

func DirectMirArrayStringLiteralFactFromGraph(
    ref graph: MirExpressionGraphSequence
) -> DirectMirArrayStringLiteralFact {
    let values: Array<String> = [];
    let nodes: Array<Int> = DirectMirArrayLiteralElementNodes(
        graph, AstExpressionNodeStringLiteral()
    );
    if ArrayLength(nodes) < 1 {
        return DirectMirArrayStringLiteralFact(
            DirectMirArrayLiteralEmptyReady(graph), values
        );
    }
    let row: Int = 0;
    while row < ArrayLength(nodes) {
        let content: Option<String> = DirectMirAsciiLiteralContent(
            graph.arena.node_texts[nodes[row]]
        );
        if !IsSome(content) {
            return DirectMirArrayStringLiteralFact(false, values);
        }
        ArrayPush(values, UnwrapOption(content));
        row = row + 1;
    }
    return DirectMirArrayStringLiteralFact(true, values);
}
