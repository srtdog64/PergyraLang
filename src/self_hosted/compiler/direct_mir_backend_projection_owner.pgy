// Backend-neutral orchestration from machine-admitted MIR facts to one target artifact.

import "driver_pipeline_owner.pgy";
import "target_projection_fact_owner.pgy";
import "direct_mir_scalar_graph_admission_owner.pgy";
import "direct_mir_scalar_cfg_projection_owner.pgy";
import "direct_mir_cfg_plan_owner.pgy";
import "direct_mir_backend_emission_owner.pgy";
import "direct_mir_compile_time_declaration_erasure_owner.pgy";
import "direct_mir_enum_value_match_route_owner.pgy";
import "direct_mir_literal_log_plan_owner.pgy";
import "direct_mir_literal_log_emission_owner.pgy";
import "direct_mir_array_int_plan_owner.pgy";
import "direct_mir_array_int_abi_projection_owner.pgy";
import "direct_mir_array_int_emission_owner.pgy";
import "direct_mir_nominal_literal_projection_owner.pgy";
import "direct_mir_nominal_literal_route_fact_owner.pgy";
import "direct_mir_multi_routine_projection_owner.pgy";
import "direct_mir_option_match_cfg_plan_owner.pgy";
import "direct_mir_option_match_cfg_emission_owner.pgy";
import "direct_mir_option_match_abi_projection_owner.pgy";
import "runtime_call_abi_structured_fact_owner.pgy";
import "abi_layout_row_owner.pgy";
import "domain_topology_graph_plan_consumer_owner.pgy";
import "../mir_lower/mir_json_input_owner.pgy";

func CompileAdmittedDirectMirCfgPayloadForTarget(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    ref enum_route: DirectMirEnumValueMatchRouteFact,
    target_projection: CompilerTargetProjectionFact
) -> String {
    let is_c: Bool = CompilerTargetProjectionFactReadyFor(
        target_projection, CompilerTargetCpuCProjection()
    );
    let is_llvm: Bool = CompilerTargetProjectionFactReadyFor(
        target_projection, CompilerTargetCpuLlvmProjection()
    );
    if !is_c && !is_llvm {
        Die("direct MIR CFG projection rejected the target fact");
    }
    let formatted_print: CompilerRuntimeCallAbiFact =
        CompilerRuntimeCallAbiFormattedPrintFact();
    if !CompilerRuntimeCallAbiFlatFactOwnerReady(formatted_print) {
        Die("direct MIR CFG runtime ABI owner is incomplete");
    }
    let plan: DirectMirCfgPlan = DirectMirCfgPlanFromAdmitted(
        admitted, enum_route
    );
    if !DirectMirCfgPlanReady(plan) {
        Die("direct MIR CFG verified plan identity is invalid before emission");
    }
    let line_format: String = StringRuntimeCStringLineFormat();
    if DirectMirEnumValueMatchPlanFactReady(plan.enum_match) ||
        DirectMirLoopCfgPlanFactReady(plan.loop_fact) ||
        DirectMirRangeCfgPlanFactReady(plan.range_fact) ||
        DirectMirBreakCfgPlanFactReady(plan.break_fact) ||
        plan.shape.kind == DirectMirCfgPhiMergeShapeKind() {
        line_format = StringRuntimeCIntLineFormat();
    } else if plan.shape.kind != DirectMirCfgLiteralArmShapeKind() &&
            plan.shape.kind != DirectMirCfgNestedConditionalShapeKind() {
        Die("direct MIR CFG projection shape has no runtime ABI format");
    }
    if is_llvm {
        return DirectMirCfgEmitLlvm(plan, formatted_print, line_format);
    }
    return DirectMirCfgEmitC(
        plan, formatted_print, line_format, CompilerAbiLayoutIntCValueType()
    );
}

func CompileAdmittedDirectMirForTarget(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    target_projection: CompilerTargetProjectionFact
) -> CompilerEmissionArtifact {
    let is_c: Bool = CompilerTargetProjectionFactReadyFor(
        target_projection, CompilerTargetCpuCProjection()
    );
    let is_llvm: Bool = CompilerTargetProjectionFactReadyFor(
        target_projection, CompilerTargetCpuLlvmProjection()
    );
    if !is_c && !is_llvm {
        Die("direct MIR backend projection rejected the target fact");
    }
    let kind: String = "emitted-c";
    if is_llvm { kind = "emitted_llvm"; }
    let payload: String = "";
    let routine_count: Int = MirProgramRoutineIndexCount(admitted.routines);
    if routine_count > 1 {
        payload = CompileAdmittedDirectMirMultiRoutineForTarget(
            admitted, target_projection
        );
    } else if routine_count == 1 {
        let block_count: Int = admitted.routines.routine_block_counts[0];
        let instruction_count: Int =
            MirProgramRoutineIndexBlockInstructionCountAt(
                admitted.routines, 0, 0
            );
        let enum_route: DirectMirEnumValueMatchRouteFact =
            DirectMirEnumValueMatchRouteFactFromAdmitted(admitted);
        if enum_route.claimed {
            payload = CompileAdmittedDirectMirCfgPayloadForTarget(
                admitted, enum_route, target_projection
            );
        } else {
            let nominal_literal_route: DirectMirNominalLiteralRouteFact =
                DirectMirNominalLiteralRouteFactFromAdmitted(admitted);
            let literal_log_route: Bool =
                DirectMirCompileTimeDeclarationErasureRouteClaimed(admitted) ||
                (block_count == 1 && instruction_count == 1);
            if nominal_literal_route.claimed {
            payload = CompileAdmittedDirectMirNominalLiteral(
                admitted, nominal_literal_route, target_projection
            );
        } else if literal_log_route {
            let literal_log: DirectMirLiteralLogPlan =
                DirectMirLiteralLogPlanFromAdmitted(admitted);
            if is_llvm {
                payload = DirectMirLiteralLogEmitLlvm(literal_log);
            } else {
                payload = DirectMirLiteralLogEmitC(
                    literal_log, CompilerAbiLayoutIntCValueType()
                );
            }
        } else if DirectMirScalarCfgGraphRouteClaimed(admitted) {
            payload = CompileAdmittedDirectMirScalarCfgForTarget(
                admitted, target_projection
            );
        } else if block_count == 1 {
            let formatted_print: CompilerRuntimeCallAbiFact =
                CompilerRuntimeCallAbiFormattedPrintFact();
            if !CompilerRuntimeCallAbiFlatFactOwnerReady(formatted_print) {
                Die("direct MIR one-block runtime ABI owner is incomplete");
            }
            let line_format: String = StringRuntimeCIntLineFormat();
            if DirectMirArrayIntPlanCandidate(admitted) {
                let plan: DirectMirArrayIntPlan =
                    DirectMirArrayIntPlanFromAdmitted(admitted);
                let abi_projection: DirectMirArrayIntAbiProjection =
                    DirectMirArrayIntAbiProjectionFromPlan(
                        plan, target_projection
                    );
                if is_llvm {
                    payload = DirectMirArrayIntEmitLlvm(
                        plan, abi_projection, formatted_print, line_format
                    );
                } else {
                    payload = DirectMirArrayIntEmitC(
                        plan, abi_projection, formatted_print, line_format
                    );
                }
            } else {
                let int_c_type: String = CompilerAbiLayoutIntCValueType();
                let scalar: DirectMirScalarBlockProjection =
                    DirectMirScalarBlockProjectionFromAdmitted(admitted);
                if !scalar.valid || !formatted_print.ok {
                    Die("direct MIR backend projection rejected unsupported scalar facts");
                }
                if is_llvm {
                    payload = DirectMirScalarEmitLlvm(
                        scalar, formatted_print, line_format
                    );
                } else {
                    payload = DirectMirScalarEmitC(
                        scalar, formatted_print, line_format, int_c_type
                    );
                }
            }
        } else if block_count == 7 {
            let formatted_print: CompilerRuntimeCallAbiFact =
                CompilerRuntimeCallAbiFormattedPrintFact();
            if !CompilerRuntimeCallAbiFlatFactOwnerReady(formatted_print) {
                Die("direct MIR Option match runtime ABI owner is incomplete");
            }
            let plan: DirectMirOptionMatchCfgPlan =
                DirectMirOptionMatchCfgPlanFromAdmitted(admitted);
            if !DirectMirOptionMatchCfgPlanReady(plan) {
                Die("direct MIR Option match verified plan identity is invalid before emission");
            }
            let abi_projection: DirectMirOptionMatchAbiProjection =
                DirectMirOptionMatchAbiProjectionFromFact(
                    plan.abi, target_projection
                );
            let line_format: String = StringRuntimeCIntLineFormat();
            if is_llvm {
                payload = DirectMirOptionMatchCfgEmitLlvm(
                    plan, abi_projection, formatted_print, line_format
                );
            } else {
                payload = DirectMirOptionMatchCfgEmitC(
                    plan, abi_projection, formatted_print, line_format
                );
            }
        } else if block_count == 3 || block_count == 4 || block_count == 5 ||
            block_count == 6 {
            payload = CompileAdmittedDirectMirCfgPayloadForTarget(
                admitted, enum_route, target_projection
            );
        } else {
            Die("direct MIR backend projection rejected unsupported CFG shape");
        }
        }
    } else {
        Die("direct MIR backend projection rejected missing routines");
    }
    if is_llvm {
        payload = MirDomainTopologyGraphPlanAttachAdmittedToLlvm(
            admitted, payload
        );
    } else {
        payload = MirDomainTopologyGraphPlanAttachAdmittedToC(
            admitted, payload
        );
    }
    let artifact: CompilerEmissionArtifact = CompilerEmissionArtifact(
        kind,
        payload,
        target_projection.schema,
        target_projection.projection,
        target_projection.target_capability_fingerprint
    );
    if !CompilerEmissionArtifactReady(artifact) {
        Die("direct MIR backend emission artifact fingerprint is missing or invalid");
    }
    return artifact;
}

func CompileMirJsonToDirectBackendVerified(
    mir_json_path: String,
    machine_declaration: SelfHostMachineLayerDeclaration,
    target_projection: CompilerTargetProjectionFact
) -> CompilerEmissionArtifact with caps io_read {
    let admitted: MirMachineLayerAdmittedJsonInput =
        MirJsonReadMachineAdmittedInput(
            mir_json_path, machine_declaration
        );
    return CompileAdmittedDirectMirForTarget(
        admitted, target_projection
    );
}
