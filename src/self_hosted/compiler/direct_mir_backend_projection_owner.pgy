// Backend-neutral direct text projection from machine-admitted MIR facts.

import "driver_pipeline_owner.pgy";
import "target_projection_fact_owner.pgy";
import "direct_mir_scalar_graph_admission_owner.pgy";
import "../mir_lower/mir_json_input_owner.pgy";

func DirectMirHelloEmitC(projection: DirectMirHelloProjection) -> String {
    let output: String = "#include <stdio.h>\n\nint main(void) {\n    puts(";
    output = Concat(output, projection.literal);
    output = Concat(output, ");\n    return 0;\n}\n");
    return output;
}

func DirectMirHelloEmitLlvm(projection: DirectMirHelloProjection) -> String {
    let constant_length: Int = StringLength(projection.content) + 1;
    let output: String =
        "@.pgy.hello = private unnamed_addr constant [";
    output = Concat(output, ToString(constant_length));
    output = Concat(output, " x i8] c\"");
    output = Concat(output, projection.content);
    output = Concat(output, "\\00\", align 1\n\ndeclare i32 @puts(ptr)\n\n");
    output = Concat(output, "define i32 @main() {\nentry:\n");
    output = Concat(output, "  %ignored = call i32 @puts(ptr @.pgy.hello)\n");
    output = Concat(output, "  ret i32 0\n}\n");
    return output;
}

func DirectMirLetLogEmitC(projection: DirectMirLetLogProjection) -> String {
    let output: String =
        "#include <stdio.h>\n\nint main(void) {\n    long long ";
    output = Concat(output, projection.local_name);
    output = Concat(output, " = ");
    output = Concat(output, projection.integer_literal);
    output = Concat(output, ";\n    char pgy_text[32];\n");
    output = Concat(
        output, "    snprintf(pgy_text, sizeof(pgy_text), \"%lld\", (long long)("
    );
    output = Concat(output, projection.local_name);
    output = Concat(output, " + ");
    output = Concat(output, projection.local_name);
    output = Concat(output, "));\n    puts(pgy_text);\n    return 0;\n}\n");
    return output;
}

func DirectMirLetLogEmitLlvm(
    projection: DirectMirLetLogProjection
) -> String {
    let output: String =
        "@.pgy.int.format = private unnamed_addr constant [5 x i8] c\"%lld\\00\", align 1\n\n";
    output = Concat(
        output, "declare i32 @snprintf(ptr, i64, ptr, ...)\ndeclare i32 @puts(ptr)\n\n"
    );
    output = Concat(output, "define i32 @main() {\nentry:\n");
    output = Concat(output, "  %pgy.text = alloca [32 x i8], align 16\n  %");
    output = Concat(output, projection.result_name);
    output = Concat(output, " = add i64 0, ");
    output = Concat(output, projection.integer_literal);
    output = Concat(output, "\n  %pgy.sum = add i64 %");
    output = Concat(output, projection.result_name);
    output = Concat(output, ", %");
    output = Concat(output, projection.result_name);
    output = Concat(
        output,
        "\n  %pgy.formatted = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %pgy.text, i64 32, ptr @.pgy.int.format, i64 %pgy.sum)\n"
    );
    output = Concat(
        output,
        "  %pgy.logged = call i32 @puts(ptr %pgy.text)\n  ret i32 0\n}\n"
    );
    return output;
}

func CompileAdmittedDirectMirForTarget(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    target_projection: CompilerTargetProjectionFact
) -> CompilerEmissionArtifact {
    let is_c: Bool = CompilerTargetProjectionFactReadyFor(
        target_projection, CompilerTargetCpuCProjection()
    );
    let is_llvm: Bool = CompilerTargetProjectionFactReadyFor(
        target_projection, CompilerTargetCpuLlvmProjection()
    );
    if !is_c && !is_llvm {
        Die("direct MIR backend projection rejected the target fact");
    }
    let instruction_count: Int =
        MirProgramRoutineIndexBlockInstructionCountAt(
            admitted.routines, 0, 0
        );
    let kind: String = "emitted-c";
    if is_llvm {
        kind = "emitted_llvm";
    }
    let payload: String = "";
    if instruction_count == 1 {
        let hello: DirectMirHelloProjection =
            DirectMirHelloProjectionFromAdmitted(admitted);
        if !hello.valid {
            Die("direct MIR backend projection rejected unsupported or mutated hello facts");
        }
        payload = DirectMirHelloEmitC(hello);
        if is_llvm { payload = DirectMirHelloEmitLlvm(hello); }
    } else if instruction_count == 2 {
        let let_log: DirectMirLetLogProjection =
            DirectMirLetLogProjectionFromAdmitted(admitted);
        if !let_log.valid {
            Die("direct MIR backend projection rejected unsupported let_log facts");
        }
        payload = DirectMirLetLogEmitC(let_log);
        if is_llvm { payload = DirectMirLetLogEmitLlvm(let_log); }
    } else {
        Die("direct MIR backend projection rejected unsupported instruction shape");
    }
    let artifact: CompilerEmissionArtifact = CompilerEmissionArtifact(
        kind,
        payload,
        target_projection.schema,
        target_projection.projection,
        target_projection.target_capability_fingerprint
    );
    if !CompilerEmissionArtifactReady(artifact) {
        Die("direct MIR backend emission artifact fingerprint is missing or invalid");
    }
    return artifact;
}

func CompileMirJsonToDirectBackendVerified(
    mir_json_path: String,
    machine_declaration: SelfHostMachineLayerDeclaration,
    target_projection: CompilerTargetProjectionFact
) -> CompilerEmissionArtifact with caps io_read {
    let admitted: MirMachineLayerAdmittedJsonInput =
        MirJsonReadMachineAdmittedInput(
            mir_json_path, machine_declaration
        );
    return CompileAdmittedDirectMirForTarget(
        admitted, target_projection
    );
}
