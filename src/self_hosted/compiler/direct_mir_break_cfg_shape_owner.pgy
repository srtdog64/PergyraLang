// Target-neutral payload for one certified loop-break CFG. The normal loop
// exit and explicit break remain distinct lanes until the backend materializes
// their shared final-Log value.

import "direct_mir_cfg_entry_fact_owner.pgy";
import "direct_mir_cfg_log_shape_owner.pgy";
import "direct_mir_scalar_graph_admission_owner.pgy";
import "../air/mir_break_cfg_certificate_fact_owner.pgy";
import "../mir_lower/routine_instruction_use_fact_owner.pgy";

struct DirectMirBreakCfgShapeFact {
    let valid: Bool;
    let digest: Int;
    let local_name: String;
    let entry_result_name: String;
    let phi_result_name: String;
    let backedge_result_name: String;
    let normal_exit_result_name: String;
    let break_exit_result_name: String;
    let exit_log_result_name: String;
    let initial_literal: String;
    let limit_literal: String;
    let increment_literal: String;
    let decision_literal: String;
}

func DirectMirBreakCfgShapeFactEmpty() -> DirectMirBreakCfgShapeFact {
    return DirectMirBreakCfgShapeFact(
        false, 0, "", "", "", "", "", "", "", "", "", "", ""
    );
}

func DirectMirBreakCfgShapeFactDigest(
    ref fact: DirectMirBreakCfgShapeFact
) -> Int {
    if !fact.valid { return 0; }
    let hash: Long = DirectMirCfgHashString(79L, fact.local_name);
    hash = DirectMirCfgHashString(hash, fact.entry_result_name);
    hash = DirectMirCfgHashString(hash, fact.phi_result_name);
    hash = DirectMirCfgHashString(hash, fact.backedge_result_name);
    hash = DirectMirCfgHashString(hash, fact.normal_exit_result_name);
    hash = DirectMirCfgHashString(hash, fact.break_exit_result_name);
    hash = DirectMirCfgHashString(hash, fact.exit_log_result_name);
    hash = DirectMirCfgHashString(hash, fact.initial_literal);
    hash = DirectMirCfgHashString(hash, fact.limit_literal);
    hash = DirectMirCfgHashString(hash, fact.increment_literal);
    hash = DirectMirCfgHashString(hash, fact.decision_literal);
    return DirectMirCfgBoundedDigest(hash);
}

func DirectMirBreakCfgShapeFactWithDigest(
    fact: DirectMirBreakCfgShapeFact, digest: Int
) -> DirectMirBreakCfgShapeFact {
    return DirectMirBreakCfgShapeFact(
        fact.valid, digest, fact.local_name, fact.entry_result_name,
        fact.phi_result_name, fact.backedge_result_name,
        fact.normal_exit_result_name, fact.break_exit_result_name,
        fact.exit_log_result_name, fact.initial_literal,
        fact.limit_literal, fact.increment_literal, fact.decision_literal
    );
}

func DirectMirBreakCfgShapeFactAbsent(
    ref fact: DirectMirBreakCfgShapeFact
) -> Bool {
    return !fact.valid && fact.digest == 0 && fact.local_name == "" &&
        fact.entry_result_name == "" && fact.phi_result_name == "" &&
        fact.backedge_result_name == "" &&
        fact.normal_exit_result_name == "" &&
        fact.break_exit_result_name == "" &&
        fact.exit_log_result_name == "" && fact.initial_literal == "" &&
        fact.limit_literal == "" && fact.increment_literal == "" &&
        fact.decision_literal == "";
}

func DirectMirBreakCfgShapeFactReady(
    ref fact: DirectMirBreakCfgShapeFact
) -> Bool {
    return fact.valid && fact.digest != 0 &&
        fact.digest == DirectMirBreakCfgShapeFactDigest(fact) &&
        StringLength(fact.local_name) > 0 &&
        MirSsaNameMatches(
            fact.entry_result_name, fact.local_name, false
        ) && MirSsaNameMatches(
            fact.phi_result_name, fact.local_name, false
        ) && MirSsaNameMatches(
            fact.backedge_result_name, fact.local_name, false
        ) && fact.entry_result_name != fact.phi_result_name &&
        fact.entry_result_name != fact.backedge_result_name &&
        fact.phi_result_name != fact.backedge_result_name &&
        fact.normal_exit_result_name == fact.phi_result_name &&
        fact.break_exit_result_name == fact.backedge_result_name &&
        fact.exit_log_result_name == fact.break_exit_result_name &&
        StringLength(fact.initial_literal) > 0 &&
        ToString(ToInt(fact.initial_literal)) == fact.initial_literal &&
        StringLength(fact.limit_literal) > 0 &&
        ToString(ToInt(fact.limit_literal)) == fact.limit_literal &&
        StringLength(fact.increment_literal) > 0 &&
        ToString(ToInt(fact.increment_literal)) == fact.increment_literal &&
        StringLength(fact.decision_literal) > 0 &&
        ToString(ToInt(fact.decision_literal)) == fact.decision_literal;
}

func DirectMirBreakCfgShapeBinaryLiteral(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    global_row: Int,
    expected_kind: Int,
    local_name: String,
    assignment_target: Bool
) -> String {
    if global_row < 0 ||
        global_row >= ArrayLength(admitted.routines.instruction_starts) ||
        global_row >= ArrayLength(admitted.routines.instruction_ends) {
        Die("direct MIR break CFG binary row is invalid");
    }
    let instruction: JsonObjectFactTable = JsonObjectFactTableFromBounds(
        admitted.routines.source_json,
        admitted.routines.instruction_starts[global_row],
        admitted.routines.instruction_ends[global_row]
    );
    let graph: JsonObjectFactTable = JsonObjectFactObjectTable(
        instruction, "expr0_graph"
    );
    let sequence: MirExpressionGraphSequence =
        MirExpressionGraphSequenceAppend(
            MirExpressionGraphSequenceEmpty(), graph
        );
    if !sequence.ok || sequence.ready_node_count != 3 ||
        ArrayLength(sequence.roots) != 1 || sequence.roots[0] != 2 ||
        ArrayLength(sequence.arena.topology.node_kinds) != 3 ||
        ArrayLength(sequence.arena.topology.left_children) != 3 ||
        ArrayLength(sequence.arena.topology.right_children) != 3 ||
        ArrayLength(sequence.arena.node_texts) != 3 ||
        ArrayLength(sequence.arena.call_target_kinds) != 3 ||
        ArrayLength(sequence.arena.call_target_names) != 3 ||
        sequence.arena.topology.node_kinds[0] != AstExpressionNodeLeaf() ||
        sequence.arena.node_texts[0] != local_name ||
        sequence.arena.topology.node_kinds[1] !=
            AstExpressionNodeIntegerLiteral() ||
        sequence.arena.topology.node_kinds[2] != expected_kind ||
        sequence.arena.topology.left_children[2] != 0 ||
        sequence.arena.topology.right_children[2] != 1 {
        Die("direct MIR break CFG binary graph is invalid");
    }
    let node: Int = 0;
    while node < 3 {
        if sequence.arena.call_target_kinds[node] !=
                SemanticCallTargetNone() ||
            sequence.arena.call_target_names[node] != "" {
            Die("direct MIR break CFG binary call target is invalid");
        }
        node = node + 1;
    }
    if assignment_target {
        let target_graph: JsonObjectFactTable = JsonObjectFactObjectTable(
            instruction, "expr1_graph"
        );
        let target: MirExpressionGraphSequence =
            MirExpressionGraphSequenceAppend(
                MirExpressionGraphSequenceEmpty(), target_graph
            );
        if !target.ok || target.ready_node_count != 1 ||
            ArrayLength(target.roots) != 1 || target.roots[0] != 0 ||
            ArrayLength(target.arena.topology.node_kinds) != 1 ||
            ArrayLength(target.arena.node_texts) != 1 ||
            ArrayLength(target.arena.call_target_kinds) != 1 ||
            ArrayLength(target.arena.call_target_names) != 1 ||
            target.arena.topology.node_kinds[0] != AstExpressionNodeLeaf() ||
            target.arena.node_texts[0] != local_name ||
            target.arena.call_target_kinds[0] !=
                SemanticCallTargetNone() ||
            target.arena.call_target_names[0] != "" {
            Die("direct MIR break CFG assignment target graph is invalid");
        }
    }
    let literal: String = sequence.arena.node_texts[1];
    if StringLength(literal) == 0 || ToString(ToInt(literal)) != literal {
        Die("direct MIR break CFG integer literal is not canonical");
    }
    return literal;
}

func DirectMirBreakCfgSingleUseEquals(
    ref use_facts: MirRoutineInstructionUseFacts,
    global_row: Int,
    expected: String
) -> Bool {
    let use_opt: Option<String> = MirRoutineInstructionUseAtGlobal(
        use_facts, global_row, 0
    );
    return MirRoutineInstructionUseCountAtGlobal(
            use_facts, global_row
        ) == 1 && IsSome(use_opt) && UnwrapOption(use_opt) == expected;
}

func DirectMirBreakCfgShapeFactFromOwners(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    ref index: MirRoutineFactIndex,
    ref use_facts: MirRoutineInstructionUseFacts,
    ref break_fact: DirectMirBreakCfgCertificateFact
) -> DirectMirBreakCfgShapeFact {
    if !DirectMirBreakCfgCertificateFactReady(break_fact) {
        return DirectMirBreakCfgShapeFactEmpty();
    }
    let entry: DirectMirCfgEntryFact = DirectMirCfgEntryFactFromOwners(
        admitted, index, use_facts, break_fact.preheader_block
    );
    if !entry.valid || entry.local_name != break_fact.local_name ||
        entry.result_name != break_fact.preheader_incoming ||
        !DirectMirBreakCfgSingleUseEquals(
            use_facts, break_fact.branch_global_row,
            break_fact.phi_result_name
        ) || !DirectMirBreakCfgSingleUseEquals(
            use_facts, break_fact.increment_global_row,
            break_fact.phi_result_name
        ) || !DirectMirBreakCfgSingleUseEquals(
            use_facts, break_fact.decision_global_row,
            break_fact.backedge_incoming
        ) || !DirectMirBreakCfgSingleUseEquals(
            use_facts, break_fact.break_log_global_row,
            break_fact.backedge_incoming
        ) || MirRoutineInstructionUseCountAtGlobal(
            use_facts, break_fact.break_global_row
        ) != 0 || !DirectMirBreakCfgSingleUseEquals(
            use_facts, break_fact.exit_log_global_row,
            break_fact.backedge_incoming
        ) || !DirectMirCfgLogToStringGraphReady(
            admitted, break_fact.break_log_global_row,
            break_fact.local_name
        ) || !DirectMirCfgLogToStringGraphReady(
            admitted, break_fact.exit_log_global_row,
            break_fact.local_name
        ) {
        return DirectMirBreakCfgShapeFactEmpty();
    }
    let limit_literal: String = DirectMirBreakCfgShapeBinaryLiteral(
        admitted, break_fact.branch_global_row, AstExpressionNodeLess(),
        break_fact.local_name, false
    );
    let increment_literal: String = DirectMirBreakCfgShapeBinaryLiteral(
        admitted, break_fact.increment_global_row, AstExpressionNodeAdd(),
        break_fact.local_name, true
    );
    let decision_literal: String = DirectMirBreakCfgShapeBinaryLiteral(
        admitted, break_fact.decision_global_row,
        AstExpressionNodeEquality(), break_fact.local_name, false
    );
    let fact: DirectMirBreakCfgShapeFact = DirectMirBreakCfgShapeFact(
        true, 0, break_fact.local_name, entry.result_name,
        break_fact.phi_result_name, break_fact.backedge_incoming,
        break_fact.phi_result_name, break_fact.backedge_incoming,
        break_fact.backedge_incoming, entry.integer_literal,
        limit_literal, increment_literal, decision_literal
    );
    return DirectMirBreakCfgShapeFactWithDigest(
        fact, DirectMirBreakCfgShapeFactDigest(fact)
    );
}

func DirectMirBreakCfgShapeFactInvalidExitSelection(
    fact: DirectMirBreakCfgShapeFact
) -> DirectMirBreakCfgShapeFact {
    let invalid: DirectMirBreakCfgShapeFact = DirectMirBreakCfgShapeFact(
        fact.valid, 0, fact.local_name, fact.entry_result_name,
        fact.phi_result_name, fact.backedge_result_name,
        fact.break_exit_result_name, fact.break_exit_result_name,
        fact.exit_log_result_name, fact.initial_literal,
        fact.limit_literal, fact.increment_literal, fact.decision_literal
    );
    return DirectMirBreakCfgShapeFactWithDigest(
        invalid, DirectMirBreakCfgShapeFactDigest(invalid)
    );
}
