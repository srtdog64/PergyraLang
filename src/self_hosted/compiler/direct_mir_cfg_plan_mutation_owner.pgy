// Repaired-digest negative checks for the fixed target-neutral CFG plan.

import "direct_mir_cfg_plan_value_owner.pgy";
import "direct_mir_enum_value_match_plan_mutation_owner.pgy";

func DirectMirCfgPlanMutationRejected(own plan: DirectMirCfgPlan) -> Bool {
    let bad_digest: DirectMirCfgPlan = DirectMirCfgPlanWithDigest(
        plan, plan.plan_digest + 1
    );
    let bad_target: DirectMirCfgPlan =
        DirectMirCfgPlanWithTargetFingerprint(
            plan, plan.target_capability_fingerprint + 1
        );
    bad_target = DirectMirCfgPlanWithDigest(
        bad_target, DirectMirCfgPlanIdentityDigest(bad_target)
    );
    let bad_phi_binding_rejected: Bool = true;
    if plan.phi_count == 1 {
        let bad_phi_digest: Int = plan.phi_digest + 1;
        let bad_false_block: Int = plan.false_block;
        if !DirectMirLoopCfgPlanFactReady(plan.loop_fact) &&
            plan.shape.entry_result_name == plan.shape.false_result_name {
            bad_phi_digest = plan.phi_digest;
            bad_false_block = plan.merge_block + 1;
        }
        let bad_phi_binding: DirectMirCfgPlan = DirectMirCfgPlan(
            plan.valid, plan.schema, plan.revision, 0,
            plan.certificate_digest, plan.mir_digest, plan.cfg_digest,
            bad_phi_digest, plan.nested_digest, plan.loop_digest,
            plan.range_digest, plan.break_digest, plan.enum_digest,
            plan.target_capability_schema,
            plan.target_capability_fingerprint, plan.entry_block,
            plan.true_block, bad_false_block, plan.merge_block,
            plan.phi_count, plan.nested, plan.loop_fact,
            plan.range_fact, plan.break_fact, plan.enum_match, plan.shape
        );
        bad_phi_binding = DirectMirCfgPlanWithDigest(
            bad_phi_binding,
            DirectMirCfgPlanIdentityDigest(bad_phi_binding)
        );
        bad_phi_binding_rejected =
            !DirectMirCfgPlanReady(bad_phi_binding);
    }
    let bad_nested_rejected: Bool = true;
    if DirectMirNestedCfgCertificateFactReady(plan.nested) {
        let nested_for_mutation: DirectMirNestedCfgCertificateFact =
            plan.nested;
        let bad_nested: DirectMirNestedCfgCertificateFact =
            DirectMirNestedCfgCertificateFactInvalidMerge(
                nested_for_mutation
            );
        let bad_nested_plan: DirectMirCfgPlan =
            DirectMirCfgPlanWithNested(plan, bad_nested);
        bad_nested_plan = DirectMirCfgPlanWithDigest(
            bad_nested_plan, DirectMirCfgPlanIdentityDigest(bad_nested_plan)
        );
        bad_nested_rejected = !DirectMirCfgPlanReady(bad_nested_plan);
    }
    let bad_loop_rejected: Bool = true;
    if DirectMirLoopCfgPlanFactReady(plan.loop_fact) {
        let loop_for_mutation: DirectMirLoopCfgPlanFact = plan.loop_fact;
        let bad_loop: DirectMirLoopCfgPlanFact =
            DirectMirLoopCfgPlanFactInvalidBackedge(loop_for_mutation);
        let bad_loop_plan: DirectMirCfgPlan =
            DirectMirCfgPlanWithLoop(plan, bad_loop);
        bad_loop_plan = DirectMirCfgPlanWithDigest(
            bad_loop_plan, DirectMirCfgPlanIdentityDigest(bad_loop_plan)
        );
        let loop_for_negative: DirectMirLoopCfgPlanFact = plan.loop_fact;
        bad_loop_rejected = !DirectMirCfgPlanReady(bad_loop_plan) &&
            DirectMirLoopCfgPlanFactMutationRejected(loop_for_negative);
    }
    let bad_range_rejected: Bool = true;
    if DirectMirRangeCfgPlanFactReady(plan.range_fact) {
        let range_for_mutation: DirectMirRangeCfgPlanFact =
            plan.range_fact;
        let bad_range: DirectMirRangeCfgPlanFact =
            DirectMirRangeCfgPlanFactInvalidPolicy(range_for_mutation);
        let bad_range_plan: DirectMirCfgPlan =
            DirectMirCfgPlanWithRange(plan, bad_range);
        bad_range_plan = DirectMirCfgPlanWithDigest(
            bad_range_plan, DirectMirCfgPlanIdentityDigest(bad_range_plan)
        );
        let range_for_negative: DirectMirRangeCfgPlanFact = plan.range_fact;
        bad_range_rejected = !DirectMirCfgPlanReady(bad_range_plan) &&
            DirectMirRangeCfgPlanFactMutationRejected(range_for_negative);
    }
    let bad_break_rejected: Bool = true;
    if DirectMirBreakCfgPlanFactReady(plan.break_fact) {
        let break_for_mutation: DirectMirBreakCfgPlanFact = plan.break_fact;
        let bad_break: DirectMirBreakCfgPlanFact =
            DirectMirBreakCfgPlanFactInvalidExitSelection(
                break_for_mutation
            );
        let bad_break_plan: DirectMirCfgPlan =
            DirectMirCfgPlanWithBreak(plan, bad_break);
        bad_break_plan = DirectMirCfgPlanWithDigest(
            bad_break_plan, DirectMirCfgPlanIdentityDigest(bad_break_plan)
        );
        let break_for_negative: DirectMirBreakCfgPlanFact = plan.break_fact;
        bad_break_rejected = !DirectMirCfgPlanReady(bad_break_plan) &&
            DirectMirBreakCfgPlanFactMutationRejected(break_for_negative);
    }
    let bad_enum_rejected: Bool = true;
    if DirectMirEnumValueMatchPlanFactReady(plan.enum_match) {
        let bad_enum: DirectMirEnumValueMatchPlanFact =
            DirectMirEnumValueMatchPlanFactInvalidAbiSelection(
                plan.enum_match
            );
        let bad_enum_plan: DirectMirCfgPlan =
            DirectMirCfgPlanWithEnumMatch(plan, bad_enum);
        bad_enum_plan = DirectMirCfgPlanWithDigest(
            bad_enum_plan, DirectMirCfgPlanIdentityDigest(bad_enum_plan)
        );
        bad_enum_rejected = !DirectMirCfgPlanReady(bad_enum_plan) &&
            DirectMirEnumValueMatchPlanFactMutationRejected(plan.enum_match);
    }
    return !DirectMirCfgPlanReady(bad_digest) &&
        !DirectMirCfgPlanReady(bad_target) && bad_phi_binding_rejected &&
        bad_nested_rejected && bad_loop_rejected && bad_range_rejected &&
        bad_break_rejected && bad_enum_rejected;
}
