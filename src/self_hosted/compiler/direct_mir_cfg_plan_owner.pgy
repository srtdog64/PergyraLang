// One backend-neutral verified plan for the direct MIR CFG replacement rung.
//
// Certificate issuance validates MIR/CFG owners once. The plan carries only
// fixed-size certificate bindings and shape facts; C and LLVM cannot reopen or
// revalidate MIR, AIR, AST, or source facts.

import "direct_mir_cfg_plan_fact_owner.pgy";
import "direct_mir_cfg_plan_value_owner.pgy";
import "direct_mir_cfg_plan_mutation_owner.pgy";
import "direct_mir_nested_cfg_shape_owner.pgy";
import "direct_mir_enum_value_match_plan_owner.pgy";
import "../air/mir_cfg_certificate_owner.pgy";
import "../air/mir_cfg_certificate_mutation_owner.pgy";
import "../mir_lower/routine_instruction_use_fact_owner.pgy";

func DirectMirCfgPlanFromAdmitted(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    own enum_route: DirectMirEnumValueMatchRouteFact
) -> DirectMirCfgPlan {
    let block_count: Int = admitted.routines.routine_block_counts[0];
    let standard_envelope: Bool = DirectMirCfgProgramEnvelopeReady(admitted);
    let enum_envelope: Bool = false;
    if DirectMirEnumValueMatchRouteFactReady(enum_route) &&
        enum_route.claimed {
        let routine: JsonObjectFactTable = JsonObjectFactTableFromBounds(
            admitted.routines.source_json, admitted.routines.starts[0],
            admitted.routines.ends[0]
        );
        enum_envelope = DirectMirProgramCommonEnvelopeReady(admitted) &&
            !admitted.domain_topology_plan.present &&
            enum_route.declaration_count == 1 &&
            JsonArrayObjectFactCount(admitted.document.declarations) == 1 &&
            DirectMirRoutineHasNoUnsupportedFactsExceptLoop(routine);
    }
    if !DirectMirEnumValueMatchRouteFactReady(enum_route) ||
        (!standard_envelope && !enum_envelope) ||
        (block_count != 3 && block_count != 4 && block_count != 5 &&
            block_count != 6) {
        Die("direct MIR CFG block inventory or program structure is invalid");
    }
    let index: MirRoutineFactIndex = BuildMirRoutineFactIndex(
        admitted.routines, 0
    );
    if !index.valid {
        if index.validation_stage == "cfg_successor" {
            Die("direct MIR CFG successor is missing or out of range");
        }
        Die("direct MIR CFG typed owner admission is invalid");
    }
    let block: Int = 0;
    while block < ArrayLength(index.block_reachable) {
        if !index.block_reachable[block] {
            Die("direct MIR CFG reachability fact disagrees with graph");
        }
        block = block + 1;
    }
    let use_facts: MirRoutineInstructionUseFacts =
        BuildMirRoutineInstructionUseFacts(admitted.routines, 0);
    if !MirRoutineInstructionUseFactsReady(
        use_facts, ArrayLength(index.instruction_facts.starts)
    ) {
        Die("direct MIR CFG instruction use owner is invalid");
    }
    let certificate: DirectMirCfgCertificate =
        DirectMirCfgCertificateFromIndex(admitted, index, use_facts);
    let certificate_negative: DirectMirCfgCertificate =
        DirectMirCfgCertificateWithDigest(
            certificate, certificate.certificate_digest
        );
    if !DirectMirCfgCertificateReady(certificate) {
        if enum_route.claimed {
            Die("direct MIR enum value-match CFG certificate is invalid");
        }
        if certificate.valid {
            Die("direct MIR CFG issued certificate identity or fixed binding is invalid");
        }
        let merge_block: Int = index.block_structural_merges[0];
        if merge_block >= 0 &&
            merge_block < ArrayLength(index.block_instruction_counts) &&
            index.block_instruction_counts[merge_block] > 0 {
            Die("direct MIR CFG merge phi result or incoming/predecessor fact is missing or invalid");
        }
        Die("direct MIR CFG AIR certificate binding or successor topology is invalid");
    }
    if !DirectMirCfgCertificateMutationRejected(certificate_negative) {
        Die("direct MIR CFG AIR certificate mutation negative is invalid");
    }
    let shape: DirectMirCfgShapeFacts = DirectMirCfgShapeFactsEmpty();
    let loop_plan: DirectMirLoopCfgPlanFact =
        DirectMirLoopCfgPlanFactEmpty();
    let enum_plan: DirectMirEnumValueMatchPlanFact =
        DirectMirEnumValueMatchPlanFactEmpty();
    if DirectMirIdentityMatchCfgCertificateFactReady(
        certificate.identity_match
    ) {
        if !enum_route.claimed {
            Die("direct MIR identity-match CFG lacks its enum route claim");
        }
        let enum_identity_match: DirectMirIdentityMatchCfgCertificateFact =
            certificate.identity_match;
        let enum_certificate_digest: Int = certificate.certificate_digest;
        enum_plan = DirectMirEnumValueMatchPlanFactFromOwners(
            admitted, enum_route, enum_identity_match,
            enum_certificate_digest, use_facts
        );
    } else if enum_route.claimed {
        Die("direct MIR enum route cannot retry a legacy CFG shape");
    } else if DirectMirLoopCfgCertificateFactReady(certificate.loop_fact) {
        let loop_shape: DirectMirLoopCfgShapeFact =
            DirectMirLoopCfgShapeFactFromOwners(
                admitted, index, use_facts, certificate.loop_fact
            );
        loop_plan = DirectMirLoopCfgPlanFactFromOwners(
            certificate.loop_fact, loop_shape
        );
    } else if DirectMirRangeCfgCertificateFactReady(certificate.range_fact) {
        Die("direct MIR range CFG must be claimed by the general scalar CFG plan");
    } else if DirectMirNestedCfgCertificateFactReady(certificate.nested) {
        shape = DirectMirNestedCfgShapeFactsFromOwners(
            admitted, index, use_facts, certificate
        );
    } else {
        shape = DirectMirCfgShapeFactsFromOwners(
            admitted, index, use_facts, certificate
        );
    }
    let shape_ready: Bool = DirectMirCfgShapeFactsReady(
        shape, certificate.phi_count
    );
    if DirectMirLoopCfgCertificateFactReady(certificate.loop_fact) {
        shape_ready = DirectMirCfgShapeFactsAbsent(shape) &&
            DirectMirLoopCfgPlanFactReady(loop_plan);
    }
    if DirectMirEnumValueMatchPlanFactReady(enum_plan) {
        shape_ready = DirectMirCfgShapeFactsAbsent(shape);
    }
    if !shape_ready {
        if DirectMirLoopCfgCertificateFactReady(certificate.loop_fact) {
            Die("direct MIR loop CFG condition, Log, increment, or graph facts are invalid");
        }
        Die("direct MIR CFG condition, arm, or merge facts are invalid");
    }
    let plan: DirectMirCfgPlan = DirectMirCfgPlan(
        true, DirectMirCfgPlanSchema(), CompilerArtifactPlanRevision(), 0,
        certificate.certificate_digest, certificate.mir_digest,
        certificate.cfg_digest, certificate.phi_digest,
        certificate.nested.digest, loop_plan.digest, enum_plan.digest,
        CompilerTargetCapabilitySchema(),
        CompilerTargetCapabilityFingerprint(), certificate.entry_block,
        certificate.true_block, certificate.false_block,
        certificate.merge_block, certificate.phi_count,
        certificate.nested, loop_plan, enum_plan, shape
    );
    let verified: DirectMirCfgPlan = DirectMirCfgPlanWithDigest(
        plan, DirectMirCfgPlanIdentityDigest(plan)
    );
    let verified_negative: DirectMirCfgPlan = DirectMirCfgPlanWithDigest(
        verified, verified.plan_digest
    );
    if !DirectMirCfgPlanReady(verified) ||
        !DirectMirCfgPlanMutationRejected(verified_negative) {
        Die("direct MIR CFG verified plan identity is invalid");
    }
    return verified;
}
