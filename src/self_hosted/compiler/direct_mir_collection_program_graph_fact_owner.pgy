// Persisted expression-graph facts used by the generic collection-program plan.

import "direct_mir_scalar_cfg_instruction_graph_owner.pgy";
import "direct_mir_scalar_cfg_array_int_graph_shape_owner.pgy";
import "direct_mir_scalar_cfg_array_length_log_graph_owner.pgy";

struct DirectMirCollectionNamePairGraphFact {
    let valid: Bool;
    let left_name: String;
    let right_name: String;
}

struct DirectMirCollectionNameLiteralGraphFact {
    let valid: Bool;
    let name: String;
    let literal: Int;
    let operation_kind: Int;
}

struct DirectMirCollectionCallGraphFact {
    let valid: Bool;
    let target_name: String;
    let argument_name: String;
    let argument_literal: Int;
    let call_node: Int;
}

func DirectMirCollectionInstructionGraph(
    ref admitted: MirMachineLayerAdmittedJsonInput, global: Int
) -> MirExpressionGraphSequence {
    if global < 0 || global >= ArrayLength(admitted.routines.instruction_starts) {
        return MirExpressionGraphSequenceEmpty();
    }
    let object: JsonObjectFactTable = JsonObjectFactTableFromBounds(
        admitted.routines.source_json,
        admitted.routines.instruction_starts[global],
        admitted.routines.instruction_ends[global]
    );
    return DirectMirScalarCfgInstructionGraphAt(object, "expr0_graph");
}

func DirectMirCollectionEmptyArrayGraphReady(
    ref graph: MirExpressionGraphSequence
) -> Bool {
    return graph.ok && graph.ready_node_count == 1 &&
        ArrayLength(graph.roots) == 1 && graph.roots[0] == 0 &&
        graph.arena.topology.node_kinds[0] == AstExpressionNodeArrayLiteral() &&
        graph.arena.node_texts[0] == "[]" &&
        DirectMirScalarCfgNoCallTargets(graph);
}

func DirectMirCollectionLeafGraphName(
    ref graph: MirExpressionGraphSequence
) -> String {
    if !graph.ok || graph.ready_node_count != 1 ||
        ArrayLength(graph.roots) != 1 || graph.roots[0] != 0 ||
        graph.arena.topology.node_kinds[0] != AstExpressionNodeLeaf() ||
        graph.arena.node_texts[0] == "" ||
        !DirectMirScalarCfgNoCallTargets(graph) { return ""; }
    return graph.arena.node_texts[0];
}

func DirectMirCollectionIntegerLiteralGraphValue(
    ref graph: MirExpressionGraphSequence
) -> Option<Int> {
    if !graph.ok || graph.ready_node_count != 1 ||
        ArrayLength(graph.roots) != 1 || graph.roots[0] != 0 ||
        graph.arena.topology.node_kinds[0] !=
            AstExpressionNodeIntegerLiteral() ||
        !DirectMirScalarCfgCanonicalInt(graph.arena.node_texts[0]) ||
        !DirectMirScalarCfgNoCallTargets(graph) { return None(); }
    return Some(ToInt(graph.arena.node_texts[0]));
}

func DirectMirCollectionLessNamesGraphFactFrom(
    ref graph: MirExpressionGraphSequence
) -> DirectMirCollectionNamePairGraphFact {
    let invalid: DirectMirCollectionNamePairGraphFact =
        DirectMirCollectionNamePairGraphFact(false, "", "");
    if !graph.ok || graph.ready_node_count != 3 ||
        ArrayLength(graph.roots) != 1 || graph.roots[0] != 2 ||
        graph.arena.topology.node_kinds[0] != AstExpressionNodeLeaf() ||
        graph.arena.topology.node_kinds[1] != AstExpressionNodeLeaf() ||
        graph.arena.topology.node_kinds[2] != AstExpressionNodeLess() ||
        graph.arena.topology.left_children[2] != 0 ||
        graph.arena.topology.right_children[2] != 1 ||
        graph.arena.node_texts[0] == "" || graph.arena.node_texts[1] == "" ||
        !DirectMirScalarCfgNoCallTargets(graph) { return invalid; }
    return DirectMirCollectionNamePairGraphFact(
        true, graph.arena.node_texts[0], graph.arena.node_texts[1]
    );
}

func DirectMirCollectionNameLiteralGraphFactFrom(
    ref graph: MirExpressionGraphSequence
) -> DirectMirCollectionNameLiteralGraphFact {
    let invalid: DirectMirCollectionNameLiteralGraphFact =
        DirectMirCollectionNameLiteralGraphFact(false, "", 0, 0);
    if !graph.ok || graph.ready_node_count != 3 ||
        ArrayLength(graph.roots) != 1 || graph.roots[0] != 2 ||
        graph.arena.topology.node_kinds[0] != AstExpressionNodeLeaf() ||
        graph.arena.topology.node_kinds[1] != AstExpressionNodeIntegerLiteral() ||
        graph.arena.node_texts[0] == "" ||
        !DirectMirScalarCfgCanonicalInt(graph.arena.node_texts[1]) ||
        graph.arena.topology.left_children[2] != 0 ||
        graph.arena.topology.right_children[2] != 1 ||
        !DirectMirScalarCfgNoCallTargets(graph) { return invalid; }
    let kind: Int = 0;
    if graph.arena.topology.node_kinds[2] == AstExpressionNodeAdd() {
        kind = DirectMirScalarCfgArrayIntPushValueAdd();
    } else if graph.arena.topology.node_kinds[2] ==
            AstExpressionNodeMultiply() {
        kind = DirectMirScalarCfgArrayIntPushValueMultiply();
    } else { return invalid; }
    return DirectMirCollectionNameLiteralGraphFact(
        true, graph.arena.node_texts[0],
        ToInt(graph.arena.node_texts[1]), kind
    );
}

func DirectMirCollectionDirectCallLiteralGraphFactFrom(
    ref graph: MirExpressionGraphSequence
) -> DirectMirCollectionCallGraphFact {
    let invalid: DirectMirCollectionCallGraphFact =
        DirectMirCollectionCallGraphFact(false, "", "", 0, -1);
    if !graph.ok || graph.ready_node_count != 4 ||
        ArrayLength(graph.roots) != 1 || graph.roots[0] != 3 ||
        graph.arena.topology.node_kinds[0] != AstExpressionNodeLeaf() ||
        graph.arena.topology.node_kinds[1] != AstExpressionNodeCall() ||
        graph.arena.topology.left_children[1] != 0 ||
        graph.arena.call_target_kinds[1] != SemanticCallTargetDirect() ||
        graph.arena.call_target_names[1] == "" ||
        graph.arena.node_texts[0] != graph.arena.call_target_names[1] ||
        graph.arena.topology.node_kinds[2] != AstExpressionNodeIntegerLiteral() ||
        !DirectMirScalarCfgCanonicalInt(graph.arena.node_texts[2]) ||
        graph.arena.topology.node_kinds[3] != AstExpressionNodeCallArgument() ||
        graph.arena.topology.left_children[3] != 1 ||
        graph.arena.topology.right_children[3] != 2 { return invalid; }
    return DirectMirCollectionCallGraphFact(
        true, graph.arena.call_target_names[1], "",
        ToInt(graph.arena.node_texts[2]), 1
    );
}

func DirectMirCollectionLoggedCallGraphFactFrom(
    ref graph: MirExpressionGraphSequence
) -> DirectMirCollectionCallGraphFact {
    let invalid: DirectMirCollectionCallGraphFact =
        DirectMirCollectionCallGraphFact(false, "", "", 0, -1);
    if !graph.ok || graph.ready_node_count != 7 ||
        ArrayLength(graph.roots) != 1 || graph.roots[0] != 6 ||
        graph.arena.topology.node_kinds[0] != AstExpressionNodeLeaf() ||
        graph.arena.node_texts[0] != "ToString" ||
        graph.arena.topology.node_kinds[1] != AstExpressionNodeCall() ||
        graph.arena.call_target_kinds[1] != SemanticCallTargetDirect() ||
        graph.arena.call_target_names[1] != "ToString" ||
        graph.arena.topology.node_kinds[2] != AstExpressionNodeLeaf() ||
        graph.arena.topology.node_kinds[3] != AstExpressionNodeCall() ||
        graph.arena.topology.left_children[3] != 2 ||
        graph.arena.call_target_kinds[3] != SemanticCallTargetDirect() ||
        graph.arena.call_target_names[3] == "" ||
        graph.arena.node_texts[2] != graph.arena.call_target_names[3] ||
        graph.arena.topology.node_kinds[4] != AstExpressionNodeLeaf() ||
        graph.arena.node_texts[4] == "" ||
        graph.arena.topology.node_kinds[5] != AstExpressionNodeCallArgument() ||
        graph.arena.topology.left_children[5] != 3 ||
        graph.arena.topology.right_children[5] != 4 ||
        graph.arena.topology.node_kinds[6] != AstExpressionNodeCallArgument() ||
        graph.arena.topology.left_children[6] != 1 ||
        graph.arena.topology.right_children[6] != 5 { return invalid; }
    let row: Int = 0;
    while row < graph.ready_node_count {
        if row != 1 && row != 3 &&
            (graph.arena.call_target_kinds[row] != SemanticCallTargetNone() ||
             graph.arena.call_target_names[row] != "") { return invalid; }
        row = row + 1;
    }
    return DirectMirCollectionCallGraphFact(
        true, graph.arena.call_target_names[3], graph.arena.node_texts[4],
        0, 3
    );
}
