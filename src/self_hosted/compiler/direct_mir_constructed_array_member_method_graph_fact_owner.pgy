// Structured bodies for one single-element Array return and one identity method.

import "direct_mir_inferred_generic_member_graph_fact_owner.pgy";

struct DirectMirConstructedArrayMemberMethodGraphFact {
    let valid: Bool;
    let digest: Int;
    let constructed_value_parameter: String;
    let identity_value_parameter: String;
    let construction_policy: String;
    let identity_policy: String;
    let element_count: Int;
}

func DirectMirConstructedArrayMemberMethodGraphDigest(
    ref fact: DirectMirConstructedArrayMemberMethodGraphFact
) -> Int {
    if !fact.valid { return 0; }
    let hash: Long = DirectMirCfgHashString(
        401L, fact.constructed_value_parameter
    );
    hash = DirectMirCfgHashString(hash, fact.identity_value_parameter);
    hash = DirectMirCfgHashString(hash, fact.construction_policy);
    hash = DirectMirCfgHashString(hash, fact.identity_policy);
    hash = DirectMirCfgHashInt(hash, fact.element_count);
    return DirectMirCfgBoundedDigest(hash);
}

func DirectMirConstructedArrayMemberMethodGraphFactReady(
    ref fact: DirectMirConstructedArrayMemberMethodGraphFact
) -> Bool {
    return fact.valid && fact.digest != 0 && fact.digest ==
        DirectMirConstructedArrayMemberMethodGraphDigest(fact) &&
        fact.constructed_value_parameter != "" &&
        fact.identity_value_parameter != "" &&
        fact.construction_policy == "single_element_array_construct" &&
        fact.identity_policy == "identity_return" && fact.element_count == 1;
}

func DirectMirConstructedArrayMemberLiteralReturnParameter(
    ref sequence: MirExpressionGraphSequence
) -> String {
    if !DirectMirGenericNominalExactTopologyReady(
        sequence,
        [AstExpressionNodeArrayLiteral(), AstExpressionNodeLeaf(),
         AstExpressionNodeArrayElement()],
        [0,0,0], [0,0,1], ["","",""], 2
    ) || sequence.arena.node_texts[0] != "[]" {
        Die("direct MIR constructed Array member literal graph is invalid");
    }
    let value: String = sequence.arena.node_texts[1];
    if value == "" || sequence.arena.node_texts[2] !=
        Concat("[", Concat(value, "]")) {
        Die("direct MIR constructed Array member literal value is invalid");
    }
    return value;
}

func DirectMirConstructedArrayMemberMethodGraphFactFromSequences(
    ref constructed_return: MirExpressionGraphSequence,
    ref identity_return: MirExpressionGraphSequence
) -> DirectMirConstructedArrayMemberMethodGraphFact {
    let constructed_value: String =
        DirectMirConstructedArrayMemberLiteralReturnParameter(
            constructed_return
        );
    if !DirectMirGenericNominalIdentityReturnShapeReady(identity_return) {
        Die("direct MIR constructed Array identity graph is invalid");
    }
    let fact: DirectMirConstructedArrayMemberMethodGraphFact =
        DirectMirConstructedArrayMemberMethodGraphFact(
            true, 0, constructed_value,
            identity_return.arena.node_texts[0],
            "single_element_array_construct", "identity_return", 1
        );
    let verified: DirectMirConstructedArrayMemberMethodGraphFact =
        DirectMirConstructedArrayMemberMethodGraphFact(
            fact.valid,
            DirectMirConstructedArrayMemberMethodGraphDigest(fact),
            fact.constructed_value_parameter,
            fact.identity_value_parameter, fact.construction_policy,
            fact.identity_policy, fact.element_count
        );
    if !DirectMirConstructedArrayMemberMethodGraphFactReady(verified) {
        Die("direct MIR constructed Array member method graph fact is invalid");
    }
    return verified;
}
