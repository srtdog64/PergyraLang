// Semantic identity for one constructed Array-return generic member program.

import "direct_mir_constructed_generic_member_program_admission_owner.pgy";
import "direct_mir_constructed_generic_member_declaration_fact_owner.pgy";
import "direct_mir_constructed_array_member_signature_fact_owner.pgy";
import "direct_mir_constructed_array_member_substitution_owner.pgy";
import "direct_mir_constructed_array_member_method_graph_fact_owner.pgy";
import "direct_mir_constructed_array_member_main_graph_fact_owner.pgy";
import "direct_mir_inferred_generic_member_program_identity_owner.pgy";
import "direct_mir_inferred_generic_member_routine_array_shape_owner.pgy";
import "direct_mir_routine_signature_fact_owner.pgy";

struct DirectMirConstructedArrayMemberProgramIdentity {
    let valid: Bool;
    let digest: Int;
    let entrypoint: DirectMirRoutineSignatureFact;
    let constructed_method: DirectMirConstructedArrayMemberSignatureFact;
    let identity_method: DirectMirConstructedArrayMemberSignatureFact;
    let specialization: DirectMirConstructedArrayMemberSpecializationFact;
    let declaration: DirectMirConstructedGenericMemberDeclarationFact;
    let method_graph: DirectMirConstructedArrayMemberMethodGraphFact;
    let main_graph: DirectMirConstructedArrayMemberMainGraphFact;
}

func DirectMirConstructedArrayMemberProgramIdentityDigest(
    ref identity: DirectMirConstructedArrayMemberProgramIdentity
) -> Int {
    if !identity.valid { return 0; }
    let hash: Long = DirectMirCfgHashInt(419L, identity.entrypoint.digest);
    hash = DirectMirCfgHashInt(hash, identity.constructed_method.digest);
    hash = DirectMirCfgHashInt(hash, identity.identity_method.digest);
    hash = DirectMirCfgHashInt(hash, identity.specialization.digest);
    hash = DirectMirCfgHashInt(hash, identity.declaration.digest);
    hash = DirectMirCfgHashInt(hash, identity.method_graph.digest);
    hash = DirectMirCfgHashInt(hash, identity.main_graph.digest);
    return DirectMirCfgBoundedDigest(hash);
}

func DirectMirConstructedArrayMemberSourceIdentitiesReady(
    ref identity: DirectMirConstructedArrayMemberProgramIdentity
) -> Bool {
    let ids: Array<Int> = [
        identity.entrypoint.source_syntax_id,
        identity.constructed_method.source_syntax_id,
        identity.identity_method.source_syntax_id,
        identity.declaration.source_syntax_id,
        identity.declaration.field_source_syntax_id
    ];
    let left: Int = 0;
    while left < ArrayLength(ids) {
        if ids[left] <= 0 { return false; }
        let right: Int = left + 1;
        while right < ArrayLength(ids) {
            if ids[left] == ids[right] { return false; }
            right = right + 1;
        }
        left = left + 1;
    }
    return true;
}

func DirectMirConstructedArrayMemberProgramIdentityReady(
    ref identity: DirectMirConstructedArrayMemberProgramIdentity
) -> Bool {
    if !identity.valid || identity.digest == 0 || identity.digest !=
        DirectMirConstructedArrayMemberProgramIdentityDigest(identity) ||
        !DirectMirRoutineSignatureFactReady(identity.entrypoint) ||
        !DirectMirConstructedArrayMemberSignatureFactReady(
            identity.constructed_method
        ) || !DirectMirConstructedArrayMemberSignatureFactReady(
            identity.identity_method
        ) || !DirectMirConstructedArrayMemberSpecializationFactReady(
            identity.specialization
        ) || !DirectMirConstructedGenericMemberDeclarationFactReady(
            identity.declaration
        ) || !DirectMirConstructedArrayMemberMethodGraphFactReady(
            identity.method_graph
        ) || !DirectMirConstructedArrayMemberMainGraphFactReady(
            identity.main_graph
        ) || !DirectMirConstructedArrayMemberSourceIdentitiesReady(identity) {
        return false;
    }
    return identity.entrypoint.name == "Main" &&
        identity.entrypoint.return_type == "Void" &&
        identity.entrypoint.param_count == 0 &&
        identity.constructed_method.returns_array &&
        !identity.identity_method.returns_array &&
        DirectMirConstructedArrayMemberSubstitutionReady(
            identity.specialization
        ) &&
        identity.constructed_method.owner == identity.declaration.name &&
        identity.identity_method.owner == identity.declaration.name &&
        identity.constructed_method.name ==
            identity.specialization.inner_callable &&
        identity.identity_method.name ==
            identity.specialization.outer_callable &&
        identity.constructed_method.generic_name ==
            identity.specialization.inner_generic_param &&
        identity.identity_method.generic_name ==
            identity.specialization.outer_generic_param &&
        DirectMirConstructedGenericMemberDeclarationHasMethod(
            identity.declaration, identity.constructed_method.name,
            identity.constructed_method.return_type
        ) && DirectMirConstructedGenericMemberDeclarationHasMethod(
            identity.declaration, identity.identity_method.name,
            identity.identity_method.return_type
        ) && identity.method_graph.constructed_value_parameter ==
            identity.constructed_method.value_param.name &&
        identity.method_graph.identity_value_parameter ==
            identity.identity_method.value_param.name &&
        identity.specialization.owner == identity.declaration.name &&
        identity.main_graph.owner == identity.declaration.name &&
        identity.main_graph.inner_method ==
            identity.constructed_method.name &&
        identity.main_graph.outer_method ==
            identity.identity_method.name &&
        identity.main_graph.inner_target == CompilerSymbolCQualifiedName(
            identity.declaration.name, identity.constructed_method.name
        ) && identity.main_graph.outer_target ==
            CompilerSymbolCQualifiedName(
                identity.declaration.name, identity.identity_method.name
            ) && identity.constructed_method.row !=
            identity.identity_method.row &&
        identity.entrypoint.row != identity.constructed_method.row &&
        identity.entrypoint.row != identity.identity_method.row;
}

func DirectMirConstructedArrayMemberProgramIdentityFromAdmitted(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    ref classification: DirectMirThreeRoutineClassificationFact,
    ref specialization: DirectMirConstructedArrayMemberSpecializationFact
) -> DirectMirConstructedArrayMemberProgramIdentity {
    if !DirectMirConstructedGenericMemberProgramEnvelopeReady(
        admitted, classification
    ) || !DirectMirConstructedArrayMemberSpecializationFactReady(
        specialization
    ) {
        Die("direct MIR constructed Array member envelope is invalid");
    }
    let main_row: Int = DirectMirInferredGenericMemberUniqueRoutineRow(
        admitted.routines, "Main"
    );
    let constructed_row: Int = DirectMirInferredGenericMemberUniqueRoutineRow(
        admitted.routines, specialization.inner_callable
    );
    let identity_row: Int = DirectMirInferredGenericMemberUniqueRoutineRow(
        admitted.routines, specialization.outer_callable
    );
    if main_row < 0 || constructed_row < 0 || identity_row < 0 ||
        main_row == constructed_row || main_row == identity_row ||
        constructed_row == identity_row ||
        !DirectMirInferredGenericMemberRoutineArrayShapeReady(
            admitted.routines, main_row, 0, 0, 2
        ) || !DirectMirInferredGenericMemberRoutineArrayShapeReady(
            admitted.routines, constructed_row, 1, 2, 0
        ) || !DirectMirInferredGenericMemberRoutineArrayShapeReady(
            admitted.routines, identity_row, 1, 2, 0
        ) || MirProgramRoutineIndexBlockInstructionCountAt(
            admitted.routines, main_row, 0
        ) != 3 || MirProgramRoutineIndexBlockInstructionCountAt(
            admitted.routines, constructed_row, 0
        ) != 1 || MirProgramRoutineIndexBlockInstructionCountAt(
            admitted.routines, identity_row, 0
        ) != 1 {
        Die("direct MIR constructed Array member routine cardinality is invalid");
    }
    let constructed_return: MirExpressionGraphSequence =
        DirectMirInferredGenericMemberInstructionGraph(
            admitted, constructed_row, 0
        );
    let identity_return: MirExpressionGraphSequence =
        DirectMirInferredGenericMemberInstructionGraph(
            admitted, identity_row, 0
        );
    let constructor: MirExpressionGraphSequence =
        DirectMirInferredGenericMemberInstructionGraph(admitted, main_row, 0);
    let nested_call: MirExpressionGraphSequence =
        DirectMirInferredGenericMemberInstructionGraph(admitted, main_row, 1);
    let output: MirExpressionGraphSequence =
        DirectMirInferredGenericMemberInstructionGraph(admitted, main_row, 2);
    let identity: DirectMirConstructedArrayMemberProgramIdentity =
        DirectMirConstructedArrayMemberProgramIdentity(
            true, 0,
            DirectMirRoutineSignatureFactAt(admitted.routines, main_row, 3),
            DirectMirConstructedArrayMemberSignatureFactAt(
                admitted.routines, constructed_row
            ), DirectMirConstructedArrayMemberSignatureFactAt(
                admitted.routines, identity_row
            ), specialization,
            DirectMirConstructedGenericMemberDeclarationFactFromDocument(
                admitted.document.root.json,
                admitted.domain_runtime_admission.declarations
            ), DirectMirConstructedArrayMemberMethodGraphFactFromSequences(
                constructed_return, identity_return
            ), DirectMirConstructedArrayMemberMainGraphFactFromSequences(
                constructor, nested_call, output
            )
        );
    let verified: DirectMirConstructedArrayMemberProgramIdentity =
        DirectMirConstructedArrayMemberProgramIdentity(
            identity.valid,
            DirectMirConstructedArrayMemberProgramIdentityDigest(identity),
            identity.entrypoint, identity.constructed_method,
            identity.identity_method, identity.specialization,
            identity.declaration, identity.method_graph, identity.main_graph
        );
    if !DirectMirConstructedArrayMemberProgramIdentityReady(verified) {
        Die("direct MIR constructed Array member identity is invalid");
    }
    return verified;
}
