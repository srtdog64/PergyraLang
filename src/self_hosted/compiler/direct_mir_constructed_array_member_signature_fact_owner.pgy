// Exact generic value-receiver signature for T or Array<T> returns.

import "direct_mir_generic_member_signature_fact_owner.pgy";
import "direct_mir_inferred_generic_member_array_shape_owner.pgy";
import "../semantic/ast_type_name_canonical_owner.pgy";

struct DirectMirConstructedArrayMemberSignatureFact {
    let valid: Bool;
    let digest: Int;
    let row: Int;
    let owner: String;
    let name: String;
    let source_syntax_id: Int;
    let receiver_name: String;
    let receiver_carriage: String;
    let generic_name: String;
    let return_type: String;
    let returns_array: Bool;
    let value_param: DirectMirRoutineParamFact;
}

func InvalidDirectMirConstructedArrayMemberSignatureFact(
) -> DirectMirConstructedArrayMemberSignatureFact {
    return DirectMirConstructedArrayMemberSignatureFact(
        false, 0, 0 - 1, "", "", 0, "", "", "", "", false,
        InvalidDirectMirRoutineParamFact()
    );
}

func DirectMirConstructedArrayMemberSignatureDigest(
    ref fact: DirectMirConstructedArrayMemberSignatureFact
) -> Int {
    if !fact.valid { return 0; }
    let hash: Long = DirectMirCfgHashString(431L, fact.owner);
    hash = DirectMirCfgHashString(hash, fact.name);
    hash = DirectMirCfgHashInt(hash, fact.source_syntax_id);
    hash = DirectMirCfgHashString(hash, fact.receiver_name);
    hash = DirectMirCfgHashString(hash, fact.receiver_carriage);
    hash = DirectMirCfgHashString(hash, fact.generic_name);
    hash = DirectMirCfgHashString(hash, fact.return_type);
    let array_bit: Int = 0;
    if fact.returns_array { array_bit = 1; }
    hash = DirectMirCfgHashInt(hash, array_bit);
    hash = DirectMirCfgHashInt(hash, fact.value_param.digest);
    return DirectMirCfgBoundedDigest(hash);
}

func DirectMirConstructedArrayMemberSignatureFactReady(
    ref fact: DirectMirConstructedArrayMemberSignatureFact
) -> Bool {
    let return_shape: SemanticConstructedTypeNameFact =
        SemanticConstructedTypeNameFactFrom(fact.return_type);
    let array_return_ready: Bool = fact.returns_array && return_shape.ok &&
        return_shape.canonical_name == fact.return_type &&
        return_shape.nominal_base_name == "Array" &&
        ArrayLength(return_shape.actual_type_names) == 1 &&
        return_shape.actual_type_names[0] == fact.generic_name;
    return fact.valid && fact.digest != 0 && fact.digest ==
        DirectMirConstructedArrayMemberSignatureDigest(fact) &&
        fact.row >= 0 && fact.owner != "" && fact.name != "" &&
        fact.name != "Main" && fact.source_syntax_id > 0 &&
        fact.receiver_name == "self" && fact.receiver_carriage == "value" &&
        fact.generic_name != "" &&
        ((fact.returns_array && array_return_ready) ||
         (!fact.returns_array && fact.return_type == fact.generic_name)) &&
        DirectMirRoutineParamFactReady(fact.value_param) &&
        fact.value_param.type_name == fact.generic_name &&
        fact.value_param.carriage == "value" &&
        fact.value_param.resource == "none" &&
        fact.value_param.pass_shape == "direct" &&
        !fact.value_param.abi_required;
}

func DirectMirConstructedArrayMemberSignatureFactAt(
    ref routines: MirProgramRoutineIndex, row: Int
) -> DirectMirConstructedArrayMemberSignatureFact {
    if row < 0 || !MirProgramRoutineIndexRowReady(routines, row) ||
        routines.kinds[row] != "method" || routines.owners[row] == "" ||
        routines.routine_block_counts[row] != 1 ||
        MirProgramRoutineIndexBlockInstructionCountAt(routines, row, 0) != 1 {
        return InvalidDirectMirConstructedArrayMemberSignatureFact();
    }
    let routine: JsonObjectFactTable = JsonObjectFactTableFromBounds(
        routines.source_json, routines.starts[row], routines.ends[row]
    );
    let receiver_opt: Option<String> = JsonObjectFactStringFieldOpt(
        routine, "receiver_carriage"
    );
    let return_opt: Option<String> = JsonObjectFactStringFieldOpt(
        routine, "return"
    );
    let generic_bounds: Array<Int> = [0, 0];
    let param_bounds: Array<Int> = [0, 0];
    if !IsSome(receiver_opt) || !IsSome(return_opt) ||
        UnwrapOption(receiver_opt) != "value" ||
        !MirObjectArrayBoundsAtBounds(
            routines.source_json, routines.starts[row], routines.ends[row],
            "generics", generic_bounds
        ) || !DirectMirInferredGenericMemberExactStringArrayCount(
            routines.source_json, generic_bounds[0], generic_bounds[1], 1
        ) || !MirObjectArrayBoundsAtBounds(
            routines.source_json, routines.starts[row], routines.ends[row],
            "params", param_bounds
        ) {
        return InvalidDirectMirConstructedArrayMemberSignatureFact();
    }
    let params: JsonArrayObjectFactTable = JsonArrayObjectFactTableFromBounds(
        routines.source_json, param_bounds[0], param_bounds[1]
    );
    let first_bounds: Array<Int> = [0, 0];
    let second_bounds: Array<Int> = [0, 0];
    if !DirectMirInferredGenericMemberExactObjectArrayCount(params, 2) ||
        !JsonArrayNextObjectBounds(
            routines.source_json, param_bounds[0] + 1,
            param_bounds[1], first_bounds
        ) || !JsonArrayNextObjectBounds(
            routines.source_json, first_bounds[1],
            param_bounds[1], second_bounds
        ) {
        return InvalidDirectMirConstructedArrayMemberSignatureFact();
    }
    let receiver: JsonObjectFactTable = JsonObjectFactTableFromBounds(
        routines.source_json, first_bounds[0], first_bounds[1]
    );
    let value_param: DirectMirRoutineParamFact =
        DirectMirRoutineParamFactFromBounds(
            routines.source_json, second_bounds[0], second_bounds[1]
        );
    let header: MirRoutineHeaderFacts = BuildMirRoutineHeaderFacts(
        routines.source_json, routines.starts[row], routines.ends[row]
    );
    if !DirectMirGenericMemberReceiverParamReady(receiver) ||
        !DirectMirRoutineParamFactReady(value_param) ||
        ArrayLength(header.generic_names) != 1 ||
        ArrayLength(header.param_names) != 2 ||
        ArrayLength(header.param_types) != 2 ||
        ArrayLength(header.param_carriages) != 2 ||
        ArrayLength(header.param_resources) != 2 ||
        ArrayLength(header.param_pass_shapes) != 2 ||
        header.param_names[0] != "self" ||
        header.param_names[1] != value_param.name ||
        header.param_types[0] != "" ||
        header.param_types[1] != value_param.type_name ||
        header.param_carriages[0] != "value" ||
        header.param_carriages[1] != value_param.carriage ||
        header.param_resources[0] != "none" ||
        header.param_resources[1] != value_param.resource ||
        header.param_pass_shapes[0] != "direct" ||
        header.param_pass_shapes[1] != value_param.pass_shape ||
        header.return_type != UnwrapOption(return_opt) {
        return InvalidDirectMirConstructedArrayMemberSignatureFact();
    }
    let return_shape: SemanticConstructedTypeNameFact =
        SemanticConstructedTypeNameFactFrom(header.return_type);
    let returns_array: Bool = return_shape.ok &&
        return_shape.canonical_name == header.return_type &&
        return_shape.nominal_base_name == "Array" &&
        ArrayLength(return_shape.actual_type_names) == 1 &&
        return_shape.actual_type_names[0] == header.generic_names[0];
    if !returns_array && header.return_type != header.generic_names[0] {
        return InvalidDirectMirConstructedArrayMemberSignatureFact();
    }
    let fact: DirectMirConstructedArrayMemberSignatureFact =
        DirectMirConstructedArrayMemberSignatureFact(
            true, 0, row, routines.owners[row], routines.names[row],
            ToInt(routines.source_syntax_ids[row]), "self", "value",
            header.generic_names[0], header.return_type, returns_array,
            value_param
        );
    let verified: DirectMirConstructedArrayMemberSignatureFact =
        DirectMirConstructedArrayMemberSignatureFact(
            fact.valid, DirectMirConstructedArrayMemberSignatureDigest(fact),
            fact.row, fact.owner, fact.name, fact.source_syntax_id,
            fact.receiver_name, fact.receiver_carriage, fact.generic_name,
            fact.return_type, fact.returns_array, fact.value_param
        );
    if !DirectMirConstructedArrayMemberSignatureFactReady(verified) {
        return InvalidDirectMirConstructedArrayMemberSignatureFact();
    }
    return verified;
}
