// Array-specific projection of one admitted constructed member pair.

import "direct_mir_constructed_member_specialization_pair_owner.pgy";

struct DirectMirConstructedArrayMemberSpecializationFact {
    let valid: Bool;
    let digest: Int;
    let owner: String;
    let source_owner_syntax_id: Int;
    let outer_callable: String;
    let outer_symbol: String;
    let outer_generic_param: String;
    let outer_generic_actual: String;
    let inner_callable: String;
    let inner_symbol: String;
    let inner_generic_param: String;
    let inner_generic_actual: String;
}

func InvalidDirectMirConstructedArrayMemberSpecializationFact(
) -> DirectMirConstructedArrayMemberSpecializationFact {
    return DirectMirConstructedArrayMemberSpecializationFact(
        false, 0, "", 0, "", "", "", "", "", "", "", ""
    );
}

func DirectMirConstructedArrayMemberSpecializationDigest(
    ref fact: DirectMirConstructedArrayMemberSpecializationFact
) -> Int {
    if !fact.valid { return 0; }
    let hash: Long = DirectMirCfgHashString(421L, fact.owner);
    hash = DirectMirCfgHashInt(hash, fact.source_owner_syntax_id);
    hash = DirectMirCfgHashString(hash, fact.outer_callable);
    hash = DirectMirCfgHashString(hash, fact.outer_symbol);
    hash = DirectMirCfgHashString(hash, fact.outer_generic_param);
    hash = DirectMirCfgHashString(hash, fact.outer_generic_actual);
    hash = DirectMirCfgHashString(hash, fact.inner_callable);
    hash = DirectMirCfgHashString(hash, fact.inner_symbol);
    hash = DirectMirCfgHashString(hash, fact.inner_generic_param);
    hash = DirectMirCfgHashString(hash, fact.inner_generic_actual);
    return DirectMirCfgBoundedDigest(hash);
}

func DirectMirConstructedArrayMemberSpecializationFactReady(
    ref fact: DirectMirConstructedArrayMemberSpecializationFact
) -> Bool {
    let outer_actuals: Array<String> = [fact.outer_generic_actual];
    let inner_actuals: Array<String> = [fact.inner_generic_actual];
    return fact.valid && fact.digest != 0 && fact.digest ==
        DirectMirConstructedArrayMemberSpecializationDigest(fact) &&
        fact.owner != "" && fact.source_owner_syntax_id > 0 &&
        fact.outer_callable != "" && fact.inner_callable != "" &&
        fact.outer_callable != fact.inner_callable &&
        fact.outer_generic_param != "" && fact.inner_generic_param != "" &&
        fact.outer_generic_actual == CompilerAbiLayoutArrayIntTypeName() &&
        fact.inner_generic_actual == CompilerAbiLayoutIntTypeName() &&
        fact.outer_symbol == CompilerSymbolCGenericSpecializationName(
            CompilerSymbolCQualifiedName(fact.owner, fact.outer_callable),
            outer_actuals
        ) && fact.inner_symbol == CompilerSymbolCGenericSpecializationName(
            CompilerSymbolCQualifiedName(fact.owner, fact.inner_callable),
            inner_actuals
        );
}

func DirectMirConstructedArrayMemberSpecializationFactFromPair(
    ref pair: DirectMirConstructedMemberSpecializationPairFact
) -> DirectMirConstructedArrayMemberSpecializationFact {
    if !DirectMirConstructedMemberSpecializationPairFactReady(pair) ||
        pair.outer_constructor != "Array" ||
        pair.outer_generic_actual != CompilerAbiLayoutArrayIntTypeName() {
        return InvalidDirectMirConstructedArrayMemberSpecializationFact();
    }
    let fact: DirectMirConstructedArrayMemberSpecializationFact =
        DirectMirConstructedArrayMemberSpecializationFact(
            true, 0, pair.owner, pair.source_owner_syntax_id,
            pair.outer_callable, pair.outer_symbol,
            pair.outer_generic_param, pair.outer_generic_actual,
            pair.inner_callable, pair.inner_symbol,
            pair.inner_generic_param, pair.inner_generic_actual
        );
    let verified: DirectMirConstructedArrayMemberSpecializationFact =
        DirectMirConstructedArrayMemberSpecializationFact(
            fact.valid,
            DirectMirConstructedArrayMemberSpecializationDigest(fact),
            fact.owner, fact.source_owner_syntax_id,
            fact.outer_callable, fact.outer_symbol,
            fact.outer_generic_param, fact.outer_generic_actual,
            fact.inner_callable, fact.inner_symbol,
            fact.inner_generic_param, fact.inner_generic_actual
        );
    if !DirectMirConstructedArrayMemberSpecializationFactReady(verified) {
        return InvalidDirectMirConstructedArrayMemberSpecializationFact();
    }
    return verified;
}
