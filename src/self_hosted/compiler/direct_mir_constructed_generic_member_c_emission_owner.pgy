// C emission from the sealed constructed-member plan and selected Option ABI.

import "direct_mir_constructed_generic_member_plan_owner.pgy";
import "direct_mir_option_match_abi_projection_owner.pgy";
import "runtime_call_abi_structured_fact_owner.pgy";
import "symbol_table_owner.pgy";

func DirectMirConstructedGenericMemberCNamesReady(
    type_name: String, option_type: String,
    outer_symbol: String, inner_symbol: String,
    receiver_parameter: String, value_parameter: String,
    formatted_print_symbol: String
) -> Bool {
    let names: Array<String> = [];
    ArrayPush(names, type_name);
    ArrayPush(names, option_type);
    ArrayPush(names, outer_symbol);
    ArrayPush(names, inner_symbol);
    ArrayPush(names, formatted_print_symbol);
    let left: Int = 0;
    while left < ArrayLength(names) {
        if names[left] == "" { return false; }
        let right: Int = left + 1;
        while right < ArrayLength(names) {
            if names[left] == names[right] { return false; }
            right = right + 1;
        }
        left = left + 1;
    }
    return receiver_parameter != "" && value_parameter != "" &&
        receiver_parameter != value_parameter;
}

func DirectMirConstructedGenericMemberEmitC(
    ref plan: DirectMirConstructedGenericMemberPlan,
    ref abi: DirectMirOptionMatchAbiProjection,
    formatted_print: CompilerRuntimeCallAbiFact,
    line_format: String
) -> String {
    if !DirectMirConstructedGenericMemberPlanReady(plan) ||
        !DirectMirOptionMatchAbiProjectionReadyFor(
            abi, CompilerTargetCpuCProjection()
        ) || !formatted_print.ok || formatted_print.call_shape !=
            CompilerRuntimeCallAbiStringCallShape("formatted-print") ||
        formatted_print.symbol == "" || line_format == "" {
        Die("direct MIR constructed member C projection facts are invalid");
    }
    let type_name: String = CompilerSymbolCIdentifier(
        plan.representation.type_name
    );
    let field_name: String = CompilerSymbolCIdentifier(
        plan.representation.field_name
    );
    let outer_symbol: String = CompilerSymbolCIdentifier(
        plan.identity.specialization.outer_symbol
    );
    let inner_symbol: String = CompilerSymbolCIdentifier(
        plan.identity.specialization.inner_symbol
    );
    let receiver_parameter: String = CompilerSymbolCIdentifier(
        plan.identity.constructed_method.receiver_name
    );
    let inner_value_parameter: String = CompilerSymbolCIdentifier(
        plan.identity.constructed_method.value_param.name
    );
    let outer_value_parameter: String = CompilerSymbolCIdentifier(
        plan.identity.identity_method.value_param.name
    );
    let option_type: String = "pgy_direct_option_int";
    let option_tag: String = CompilerSymbolCIdentifier(plan.option_abi.tag_name);
    let option_value: String = CompilerSymbolCIdentifier(
        plan.option_abi.value_name
    );
    if field_name == "" || option_tag == "" || option_value == "" ||
        option_tag == option_value ||
        !DirectMirConstructedGenericMemberCNamesReady(
            type_name, option_type, outer_symbol, inner_symbol,
            receiver_parameter, inner_value_parameter,
            formatted_print.symbol
        ) || outer_value_parameter == "" ||
        receiver_parameter == outer_value_parameter {
        Die("direct MIR constructed member C symbols are invalid");
    }
    let output: String = "#include <stdint.h>\n#include <stdio.h>\n\n";
    output = Concat(output, "typedef struct {\n    int32_t ");
    output = Concat(output, field_name);
    output = Concat(output, ";\n} ");
    output = Concat(output, type_name);
    output = Concat(output, ";\n\ntypedef struct {\n    ");
    output = Concat(output, abi.c_tag_type);
    output = Concat(output, " ");
    output = Concat(output, option_tag);
    output = Concat(output, ";\n    ");
    output = Concat(output, abi.c_value_type);
    output = Concat(output, " ");
    output = Concat(output, option_value);
    output = Concat(output, ";\n} ");
    output = Concat(output, option_type);
    output = Concat(output, ";\n\nstatic ");
    output = Concat(output, option_type);
    output = Concat(output, " ");
    output = Concat(output, inner_symbol);
    output = Concat(output, "(");
    output = Concat(output, type_name);
    output = Concat(output, " ");
    output = Concat(output, receiver_parameter);
    output = Concat(output, ", ");
    output = Concat(output, abi.c_value_type);
    output = Concat(output, " ");
    output = Concat(output, inner_value_parameter);
    output = Concat(output, ") {\n    (void)");
    output = Concat(output, receiver_parameter);
    output = Concat(output, ";\n    ");
    output = Concat(output, option_type);
    output = Concat(output, " _pgy_wrapped_0 = {");
    output = Concat(output, plan.option_abi.some_tag);
    output = Concat(output, ", ");
    output = Concat(output, inner_value_parameter);
    output = Concat(output, "};\n    return _pgy_wrapped_0;\n}\n\nstatic ");
    output = Concat(output, option_type);
    output = Concat(output, " ");
    output = Concat(output, outer_symbol);
    output = Concat(output, "(");
    output = Concat(output, type_name);
    output = Concat(output, " ");
    output = Concat(output, receiver_parameter);
    output = Concat(output, ", ");
    output = Concat(output, option_type);
    output = Concat(output, " ");
    output = Concat(output, outer_value_parameter);
    output = Concat(output, ") {\n    (void)");
    output = Concat(output, receiver_parameter);
    output = Concat(output, ";\n    return ");
    output = Concat(output, outer_value_parameter);
    output = Concat(output, ";\n}\n\nint main(void) {\n    ");
    output = Concat(output, type_name);
    output = Concat(output, " _pgy_receiver_0 = {");
    output = Concat(output, ToString(plan.identity.main_graph.marker_value));
    output = Concat(output, "};\n    ");
    output = Concat(output, option_type);
    output = Concat(output, " _pgy_inner_option_0 = ");
    output = Concat(output, inner_symbol);
    output = Concat(output, "(_pgy_receiver_0, ");
    output = Concat(output, ToString(plan.identity.main_graph.argument_value));
    output = Concat(output, ");\n    ");
    output = Concat(output, option_type);
    output = Concat(output, " _pgy_result_option_0 = ");
    output = Concat(output, outer_symbol);
    output = Concat(output, "(_pgy_receiver_0, _pgy_inner_option_0);\n    if (_pgy_result_option_0.");
    output = Concat(output, option_tag);
    output = Concat(output, " != ");
    output = Concat(output, plan.option_abi.some_tag);
    output = Concat(output, ") { return 1; }\n    ");
    output = Concat(output, formatted_print.symbol);
    output = Concat(output, "(\"");
    output = Concat(output, line_format);
    output = Concat(output, "\", (long long)_pgy_result_option_0.");
    output = Concat(output, option_value);
    output = Concat(output, ");\n    return 0;\n}\n");
    return output;
}
