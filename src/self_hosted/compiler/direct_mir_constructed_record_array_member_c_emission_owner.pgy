// Runtime-free C projection of the admitted caller-owned record Array plan.

import "direct_mir_constructed_record_array_member_abi_projection_owner.pgy";
import "runtime_call_abi_structured_fact_owner.pgy";
import "direct_mir_array_storage_symbol_owner.pgy";
import "direct_mir_array_storage_c_assertion_owner.pgy";
import "direct_mir_aggregate_value_flow_target_projection_owner.pgy";

func DirectMirConstructedRecordArrayMemberEmitC(
    ref plan: DirectMirConstructedRecordArrayMemberPlan,
    ref abi: DirectMirConstructedRecordArrayMemberAbiProjection,
    formatted_print: CompilerRuntimeCallAbiFact,
    line_format: String
) -> String {
    if !DirectMirConstructedRecordArrayMemberPlanReady(plan) ||
        !DirectMirConstructedRecordArrayMemberAbiProjectionReadyForPlan(
            abi, plan, CompilerTargetCpuCProjection()
        ) || !formatted_print.ok || formatted_print.call_shape !=
            CompilerRuntimeCallAbiStringCallShape("formatted-print") ||
        formatted_print.symbol == "" || line_format == "" {
        Die("direct MIR constructed record Array C facts are invalid");
    }
    let flow_target: DirectMirAggregateValueFlowTargetProjection =
        DirectMirAggregateValueFlowTargetProjectionFromFacts(
            plan.aggregate_flow, abi.storage, CompilerTargetCpuCProjection()
        );
    let record: String = CompilerSymbolCIdentifier(plan.identity.record.name);
    let field: String = CompilerSymbolCIdentifier(
        plan.identity.record.field_names[0]
    );
    let wrapper: String = CompilerSymbolCIdentifier(
        plan.aggregate_flow.representation.type_name
    );
    let marker: String = CompilerSymbolCIdentifier(
        plan.aggregate_flow.representation.field_name
    );
    let inner_symbol: String = CompilerSymbolCIdentifier(
        plan.identity.specialization.pair.inner_symbol
    );
    let outer_symbol: String = CompilerSymbolCIdentifier(
        plan.identity.specialization.pair.outer_symbol
    );
    let receiver: String = CompilerSymbolCIdentifier(
        plan.identity.constructed_method.receiver_name
    );
    let inner_value: String = CompilerSymbolCIdentifier(
        plan.identity.constructed_method.value_param.name
    );
    let outer_value: String = CompilerSymbolCIdentifier(
        plan.identity.identity_method.value_param.name
    );
    if record == "" || field == "" || wrapper == "" || marker == "" ||
        inner_symbol == "" || outer_symbol == "" ||
        inner_symbol == outer_symbol || receiver == "" ||
        inner_value == "" || outer_value == "" || receiver == inner_value ||
        receiver == outer_value {
        Die("direct MIR constructed record Array C symbols are invalid");
    }
    let storage: DirectMirArrayStorageSymbolFact =
        DirectMirArrayStorageSymbolFactFromOccupied(
            [receiver, inner_value, outer_value, "pgy_receiver", "pgy_point",
             "pgy_inner", "pgy_result", "pgy_first"]
        );
    if !DirectMirArrayStorageSymbolFactReadyFor(
        storage, [receiver, inner_value, outer_value,
                  "pgy_receiver", "pgy_point", "pgy_inner",
                  "pgy_result", "pgy_first"]
    ) {
        Die("direct MIR constructed record Array storage symbol is invalid");
    }
    let graph: DirectMirConstructedRecordArrayMemberMainGraphFact =
        plan.identity.main_graph;
    let point_abi: MirAbiLayoutRowCapture = plan.point_abi.declaration.abi;
    let output: String =
        "#include <stdint.h>\n#include <stddef.h>\n#include <stdio.h>\n\n";
    output = Concat(output, "typedef struct {\n    int32_t ");
    output = Concat(output, field);
    output = Concat(output, ";\n} ");
    output = Concat(output, record);
    output = Concat(output, ";\n\n_Static_assert(sizeof(");
    output = Concat(output, record);
    output = Concat(output, ") == ");
    output = Concat(output, point_abi.size_text);
    output = Concat(output, ", \"record size receipt\");\n_Static_assert(_Alignof(");
    output = Concat(output, record);
    output = Concat(output, ") == ");
    output = Concat(output, point_abi.align_text);
    output = Concat(output, ", \"record align receipt\");\n_Static_assert(offsetof(");
    output = Concat(output, record);
    output = Concat(output, ", ");
    output = Concat(output, field);
    output = Concat(output, ") == ");
    output = Concat(output, point_abi.field_offsets[0]);
    output = Concat(output, ", \"record field receipt\");\n\ntypedef struct {\n    int32_t ");
    output = Concat(output, marker);
    output = Concat(output, ";\n} ");
    output = Concat(output, wrapper);
    output = Concat(output, ";\n\ntypedef struct { ");
    output = Concat(output, abi.c_element_type);
    output = Concat(output, " *data; ");
    output = Concat(output, abi.c_length_type);
    output = Concat(output, " length; ");
    output = Concat(output, abi.c_length_type);
    output = Concat(output, " capacity; void *allocator; } ");
    output = Concat(output, abi.c_array_type);
    output = Concat(output, ";\n\n");
    output = Concat(output, DirectMirArrayStorageCAssertionBlock(
        abi.storage, abi.c_array_type
    ));
    output = Concat(output, flow_target.call_linkage);
    output = Concat(output, " ");
    output = Concat(output, abi.c_array_type);
    output = Concat(output, " ");
    output = Concat(output, inner_symbol);
    output = Concat(output, "(");
    output = Concat(output, wrapper);
    output = Concat(output, " ");
    output = Concat(output, receiver);
    output = Concat(output, ", ");
    output = Concat(output, record);
    output = Concat(output, " ");
    output = Concat(output, inner_value);
    output = Concat(output, ", ");
    output = Concat(output, record);
    output = Concat(output, " *");
    output = Concat(output, storage.name);
    output = Concat(output, ") {\n    (void)");
    output = Concat(output, receiver);
    output = Concat(output, ";\n    ");
    output = Concat(output, storage.name);
    output = Concat(output, "[");
    output = Concat(output, ToString(flow_target.selected_index));
    output = Concat(output, "] = ");
    output = Concat(output, inner_value);
    output = Concat(output, ";\n    return (");
    output = Concat(output, abi.c_array_type);
    output = Concat(output, "){");
    output = Concat(output, storage.name);
    output = Concat(output, ", ");
    output = Concat(output, ToString(flow_target.storage_count));
    output = Concat(output, ", ");
    output = Concat(output, ToString(flow_target.storage_count));
    output = Concat(output, ", ");
    output = Concat(output, flow_target.allocator_literal);
    output = Concat(output, "};\n}\n\n");
    output = Concat(output, flow_target.call_linkage);
    output = Concat(output, " ");
    output = Concat(output, abi.c_array_type);
    output = Concat(output, " ");
    output = Concat(output, outer_symbol);
    output = Concat(output, "(");
    output = Concat(output, wrapper);
    output = Concat(output, " ");
    output = Concat(output, receiver);
    output = Concat(output, ", ");
    output = Concat(output, abi.c_array_type);
    output = Concat(output, " ");
    output = Concat(output, outer_value);
    output = Concat(output, ") {\n    (void)");
    output = Concat(output, receiver);
    output = Concat(output, ";\n    return ");
    output = Concat(output, outer_value);
    output = Concat(output, ";\n}\n\nint main(void) {\n    ");
    output = Concat(output, wrapper);
    output = Concat(output, " pgy_receiver = {");
    output = Concat(output, ToString(graph.marker_value));
    output = Concat(output, "};\n    ");
    output = Concat(output, record);
    output = Concat(output, " pgy_point = {");
    output = Concat(output, ToString(graph.field_value));
    output = Concat(output, "};\n    ");
    output = Concat(output, record);
    output = Concat(output, " ");
    output = Concat(output, storage.name);
    output = Concat(output, "[");
    output = Concat(output, ToString(flow_target.storage_count));
    output = Concat(output, "];\n    ");
    output = Concat(output, abi.c_array_type);
    output = Concat(output, " pgy_inner = ");
    output = Concat(output, inner_symbol);
    output = Concat(output, "(pgy_receiver, pgy_point, ");
    output = Concat(output, storage.name);
    output = Concat(output, ");\n    ");
    output = Concat(output, abi.c_array_type);
    output = Concat(output, " pgy_result = ");
    output = Concat(output, outer_symbol);
    output = Concat(output, "(pgy_receiver, pgy_inner);\n    ");
    output = Concat(output, record);
    output = Concat(output, " pgy_first = pgy_result.data[");
    output = Concat(output, ToString(flow_target.selected_index));
    output = Concat(output, "];\n    ");
    output = Concat(output, formatted_print.symbol);
    output = Concat(output, "(\"");
    output = Concat(output, line_format);
    output = Concat(output, "\", (long long)pgy_first.");
    output = Concat(output, field);
    output = Concat(output, ");\n    return 0;\n}\n");
    return output;
}
