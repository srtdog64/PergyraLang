// Semantic identity for one mixed struct/class Array<Record> member program.

import "direct_mir_constructed_record_array_member_program_admission_owner.pgy";
import "direct_mir_constructed_record_array_member_specialization_owner.pgy";
import "direct_mir_constructed_generic_member_declaration_fact_owner.pgy";
import "direct_mir_constructed_array_member_signature_fact_owner.pgy";
import "direct_mir_constructed_array_member_method_graph_fact_owner.pgy";
import "direct_mir_constructed_record_array_member_main_graph_owner.pgy";
import "direct_mir_constructed_record_array_member_source_identity_owner.pgy";
import "direct_mir_nominal_declaration_abi_fact_owner.pgy";
import "direct_mir_inferred_generic_member_program_identity_owner.pgy";
import "direct_mir_inferred_generic_member_routine_array_shape_owner.pgy";
import "direct_mir_routine_signature_fact_owner.pgy";

struct DirectMirConstructedRecordArrayMemberIdentity {
    let valid: Bool;
    let digest: Int;
    let entrypoint: DirectMirRoutineSignatureFact;
    let constructed_method: DirectMirConstructedArrayMemberSignatureFact;
    let identity_method: DirectMirConstructedArrayMemberSignatureFact;
    let specialization: DirectMirConstructedRecordArrayMemberSpecializationFact;
    let record: DirectMirNominalDeclarationAbiFact;
    let wrapper: DirectMirConstructedGenericMemberDeclarationFact;
    let method_graph: DirectMirConstructedArrayMemberMethodGraphFact;
    let main_graph: DirectMirConstructedRecordArrayMemberMainGraphFact;
}

func DirectMirConstructedRecordArrayMemberIdentityDigest(
    ref identity: DirectMirConstructedRecordArrayMemberIdentity
) -> Int {
    if !identity.valid { return 0; }
    let hash: Long = DirectMirCfgHashInt(457L, identity.entrypoint.digest);
    hash = DirectMirCfgHashInt(hash, identity.constructed_method.digest);
    hash = DirectMirCfgHashInt(hash, identity.identity_method.digest);
    hash = DirectMirCfgHashInt(hash, identity.specialization.digest);
    hash = DirectMirCfgHashInt(hash, identity.record.digest);
    hash = DirectMirCfgHashInt(hash, identity.wrapper.digest);
    hash = DirectMirCfgHashInt(hash, identity.method_graph.digest);
    hash = DirectMirCfgHashInt(hash, identity.main_graph.digest);
    return DirectMirCfgBoundedDigest(hash);
}

func DirectMirConstructedRecordArrayMemberIdentityReady(
    ref identity: DirectMirConstructedRecordArrayMemberIdentity
) -> Bool {
    if !identity.valid || identity.digest == 0 || identity.digest !=
        DirectMirConstructedRecordArrayMemberIdentityDigest(identity) ||
        !DirectMirRoutineSignatureFactReady(identity.entrypoint) ||
        !DirectMirConstructedArrayMemberSignatureFactReady(
            identity.constructed_method
        ) || !DirectMirConstructedArrayMemberSignatureFactReady(
            identity.identity_method
        ) || !DirectMirConstructedRecordArrayMemberSpecializationFactReady(
            identity.specialization
        ) || !DirectMirNominalDeclarationAbiFactReady(identity.record) ||
        !DirectMirConstructedGenericMemberDeclarationFactReady(
            identity.wrapper
        ) || !DirectMirConstructedArrayMemberMethodGraphFactReady(
            identity.method_graph
        ) || !DirectMirConstructedRecordArrayMemberMainGraphFactReady(
            identity.main_graph
        ) {
        return false;
    }
    let source_syntax_ids: Array<Int> = [
        identity.entrypoint.source_syntax_id,
        identity.constructed_method.source_syntax_id,
        identity.identity_method.source_syntax_id,
        identity.record.source_syntax_id,
        identity.record.field_source_syntax_ids[0],
        identity.wrapper.source_syntax_id,
        identity.wrapper.field_source_syntax_id,
        identity.specialization.pair.source_owner_syntax_id
    ];
    return identity.entrypoint.name == "Main" &&
        identity.entrypoint.return_type == "Void" &&
        identity.entrypoint.param_count == 0 &&
        identity.constructed_method.returns_array &&
        !identity.identity_method.returns_array &&
        identity.record.name == identity.specialization.record_type &&
        ArrayLength(identity.record.field_names) == 1 &&
        identity.record.field_types[0] == CompilerAbiLayoutIntTypeName() &&
        DirectMirConstructedRecordArraySourceIdentitiesReady(
            source_syntax_ids
        ) && identity.wrapper.name == identity.specialization.pair.owner &&
        identity.constructed_method.owner == identity.wrapper.name &&
        identity.identity_method.owner == identity.wrapper.name &&
        identity.constructed_method.name ==
            identity.specialization.pair.inner_callable &&
        identity.identity_method.name ==
            identity.specialization.pair.outer_callable &&
        identity.constructed_method.generic_name ==
            identity.specialization.pair.inner_generic_param &&
        identity.identity_method.generic_name ==
            identity.specialization.pair.outer_generic_param &&
        DirectMirConstructedGenericMemberDeclarationHasMethod(
            identity.wrapper, identity.constructed_method.name,
            identity.constructed_method.return_type
        ) && DirectMirConstructedGenericMemberDeclarationHasMethod(
            identity.wrapper, identity.identity_method.name,
            identity.identity_method.return_type
        ) && identity.method_graph.constructed_value_parameter ==
            identity.constructed_method.value_param.name &&
        identity.method_graph.identity_value_parameter ==
            identity.identity_method.value_param.name &&
        identity.main_graph.owner == identity.wrapper.name &&
        identity.main_graph.record_type == identity.record.name &&
        identity.main_graph.record_field == identity.record.field_names[0] &&
        identity.main_graph.inner_method == identity.constructed_method.name &&
        identity.main_graph.outer_method == identity.identity_method.name &&
        identity.constructed_method.row != identity.identity_method.row &&
        identity.entrypoint.row != identity.constructed_method.row &&
        identity.entrypoint.row != identity.identity_method.row &&
        identity.record.row != identity.wrapper.row;
}

func DirectMirConstructedRecordArrayMemberIdentityFromAdmitted(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    ref classification: DirectMirThreeRoutineClassificationFact
) -> DirectMirConstructedRecordArrayMemberIdentity {
    if !DirectMirConstructedRecordArrayMemberProgramEnvelopeReady(
        admitted, classification
    ) {
        Die("direct MIR constructed record Array envelope is invalid");
    }
    let specialization: DirectMirConstructedRecordArrayMemberSpecializationFact =
        DirectMirConstructedRecordArrayMemberSpecializationFromDocument(
            admitted.document.root,
            classification.mixed_constructed_member_shape.record_name,
            classification.mixed_constructed_member_shape.class_name
        );
    let main_row: Int = DirectMirInferredGenericMemberUniqueRoutineRow(
        admitted.routines, "Main"
    );
    let constructed_row: Int = DirectMirInferredGenericMemberUniqueRoutineRow(
        admitted.routines, specialization.pair.inner_callable
    );
    let identity_row: Int = DirectMirInferredGenericMemberUniqueRoutineRow(
        admitted.routines, specialization.pair.outer_callable
    );
    let record_row: Int = 0 - 1;
    let wrapper_row: Int = 0 - 1;
    let declaration_row: Int = 0;
    while declaration_row < 2 {
        let name: String = admitted.domain_runtime_admission.declarations.names[
            declaration_row
        ];
        if name == classification.mixed_constructed_member_shape.record_name { record_row = declaration_row; }
        if name == classification.mixed_constructed_member_shape.class_name { wrapper_row = declaration_row; }
        declaration_row = declaration_row + 1;
    }
    if main_row < 0 || constructed_row < 0 || identity_row < 0 ||
        record_row < 0 || wrapper_row < 0 || main_row == constructed_row ||
        main_row == identity_row || constructed_row == identity_row ||
        !DirectMirInferredGenericMemberRoutineArrayShapeReady(
            admitted.routines, main_row, 0, 0, 4
        ) || !DirectMirInferredGenericMemberRoutineArrayShapeReady(
            admitted.routines, constructed_row, 1, 2, 0
        ) || !DirectMirInferredGenericMemberRoutineArrayShapeReady(
            admitted.routines, identity_row, 1, 2, 0
        ) || MirProgramRoutineIndexBlockInstructionCountAt(
            admitted.routines, main_row, 0
        ) != 5 {
        Die("direct MIR constructed record Array cardinality is invalid");
    }
    let constructed_return: MirExpressionGraphSequence =
        DirectMirInferredGenericMemberInstructionGraph(
            admitted, constructed_row, 0
        );
    let identity_return: MirExpressionGraphSequence =
        DirectMirInferredGenericMemberInstructionGraph(
            admitted, identity_row, 0
        );
    let wrapper_constructor: MirExpressionGraphSequence =
        DirectMirInferredGenericMemberInstructionGraph(admitted, main_row, 0);
    let point_constructor: MirExpressionGraphSequence =
        DirectMirInferredGenericMemberInstructionGraph(admitted, main_row, 1);
    let nested_call: MirExpressionGraphSequence =
        DirectMirInferredGenericMemberInstructionGraph(admitted, main_row, 2);
    let indexed_value: MirExpressionGraphSequence =
        DirectMirInferredGenericMemberInstructionGraph(admitted, main_row, 3);
    let output_value: MirExpressionGraphSequence =
        DirectMirInferredGenericMemberInstructionGraph(admitted, main_row, 4);
    let main_graph: DirectMirConstructedRecordArrayMemberMainGraphFact =
        DirectMirConstructedRecordArrayMemberMainGraphFactFromSequences(
            wrapper_constructor, point_constructor, nested_call,
            indexed_value, output_value
        );
    let identity: DirectMirConstructedRecordArrayMemberIdentity =
        DirectMirConstructedRecordArrayMemberIdentity(
            true, 0,
            DirectMirRoutineSignatureFactAt(admitted.routines, main_row, 5),
            DirectMirConstructedArrayMemberSignatureFactAt(
                admitted.routines, constructed_row
            ), DirectMirConstructedArrayMemberSignatureFactAt(
                admitted.routines, identity_row
            ), specialization, DirectMirNominalDeclarationAbiFactFromDocument(
                admitted.document.root.json,
                admitted.domain_runtime_admission.declarations, record_row
            ), DirectMirConstructedGenericMemberDeclarationFactAtDocument(
                admitted.document.root.json,
                admitted.domain_runtime_admission.declarations, wrapper_row
            ), DirectMirConstructedArrayMemberMethodGraphFactFromSequences(
                constructed_return, identity_return
            ), main_graph
        );
    let verified: DirectMirConstructedRecordArrayMemberIdentity =
        DirectMirConstructedRecordArrayMemberIdentity(
            identity.valid,
            DirectMirConstructedRecordArrayMemberIdentityDigest(identity),
            identity.entrypoint, identity.constructed_method,
            identity.identity_method, identity.specialization,
            identity.record, identity.wrapper, identity.method_graph,
            identity.main_graph
        );
    if !DirectMirConstructedRecordArrayMemberIdentityReady(verified) {
        Die("direct MIR constructed record Array identity is invalid");
    }
    return verified;
}
