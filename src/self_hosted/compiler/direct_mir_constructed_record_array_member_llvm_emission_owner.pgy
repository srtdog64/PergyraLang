// Runtime-free LLVM projection of the same caller-owned record Array plan.

import "direct_mir_constructed_record_array_member_abi_projection_owner.pgy";
import "direct_mir_llvm_text_format_owner.pgy";
import "runtime_call_abi_structured_fact_owner.pgy";
import "direct_mir_aggregate_value_flow_target_projection_owner.pgy";

func DirectMirConstructedRecordArrayMemberEmitLlvm(
    ref plan: DirectMirConstructedRecordArrayMemberPlan,
    ref abi: DirectMirConstructedRecordArrayMemberAbiProjection,
    formatted_print: CompilerRuntimeCallAbiFact,
    line_format: String
) -> String {
    if !DirectMirConstructedRecordArrayMemberPlanReady(plan) ||
        !DirectMirConstructedRecordArrayMemberAbiProjectionReadyForPlan(
            abi, plan, CompilerTargetCpuLlvmProjection()
        ) || !formatted_print.ok || formatted_print.call_shape !=
            CompilerRuntimeCallAbiStringCallShape("formatted-print") ||
        formatted_print.symbol == "" || line_format == "" {
        Die("direct MIR constructed record Array LLVM facts are invalid");
    }
    let flow_target: DirectMirAggregateValueFlowTargetProjection =
        DirectMirAggregateValueFlowTargetProjectionFromFacts(
            plan.aggregate_flow, abi.storage,
            CompilerTargetCpuLlvmProjection()
        );
    let record: String = CompilerSymbolCIdentifier(plan.identity.record.name);
    let wrapper: String = CompilerSymbolCIdentifier(
        plan.aggregate_flow.representation.type_name
    );
    let inner_symbol: String = CompilerSymbolCIdentifier(
        plan.identity.specialization.pair.inner_symbol
    );
    let outer_symbol: String = CompilerSymbolCIdentifier(
        plan.identity.specialization.pair.outer_symbol
    );
    let receiver: String = CompilerSymbolCIdentifier(
        plan.identity.constructed_method.receiver_name
    );
    let inner_value: String = CompilerSymbolCIdentifier(
        plan.identity.constructed_method.value_param.name
    );
    let outer_value: String = CompilerSymbolCIdentifier(
        plan.identity.identity_method.value_param.name
    );
    if record == "" || wrapper == "" || inner_symbol == "" ||
        outer_symbol == "" || inner_symbol == outer_symbol || receiver == "" ||
        inner_value == "" || outer_value == "" || receiver == inner_value ||
        receiver == outer_value || abi.llvm_element_type != Concat("%", record) {
        Die("direct MIR constructed record Array LLVM symbols are invalid");
    }
    let aggregate: String = abi.llvm_aggregate_type;
    let payload: String = DirectMirScalarLlvmFormatPayload(line_format);
    let format_size: Int = DirectMirScalarLlvmFormatByteCount(line_format);
    let output: String = "%";
    output = Concat(output, record);
    output = Concat(output, " = type { i32 }\n%");
    output = Concat(output, wrapper);
    output = Concat(output, " = type { i32 }\n\n@.pgy.int.line.format = private unnamed_addr constant [");
    output = Concat(output, ToString(format_size));
    output = Concat(output, " x i8] c\"");
    output = Concat(output, payload);
    output = Concat(output, "\\00\", align 1\n\ndeclare i32 @");
    output = Concat(output, formatted_print.symbol);
    output = Concat(output, "(ptr, ...)\n\ndefine ");
    output = Concat(output, flow_target.call_linkage);
    output = Concat(output, " ");
    output = Concat(output, aggregate);
    output = Concat(output, " @");
    output = Concat(output, inner_symbol);
    output = Concat(output, "(%");
    output = Concat(output, wrapper);
    output = Concat(output, " %");
    output = Concat(output, receiver);
    output = Concat(output, ", %");
    output = Concat(output, record);
    output = Concat(output, " %");
    output = Concat(output, inner_value);
    output = Concat(output, ", ptr %pgy.array.storage) {\nentry:\n  store %");
    output = Concat(output, record);
    output = Concat(output, " %");
    output = Concat(output, inner_value);
    output = Concat(output, ", ptr %pgy.array.storage, align ");
    output = Concat(output, plan.identity.record.abi.align_text);
    output = Concat(output, "\n  %array.0 = insertvalue ");
    output = Concat(output, aggregate);
    output = Concat(output, " poison, ptr %pgy.array.storage, ");
    output = Concat(output, ToString(abi.data_index));
    output = Concat(output, "\n  %array.1 = insertvalue ");
    output = Concat(output, aggregate);
    output = Concat(output, " %array.0, i64 ");
    output = Concat(output, ToString(flow_target.storage_count));
    output = Concat(output, ", ");
    output = Concat(output, ToString(abi.length_index));
    output = Concat(output, "\n  %array.2 = insertvalue ");
    output = Concat(output, aggregate);
    output = Concat(output, " %array.1, i64 ");
    output = Concat(output, ToString(flow_target.storage_count));
    output = Concat(output, ", ");
    output = Concat(output, ToString(abi.capacity_index));
    output = Concat(output, "\n  %array.3 = insertvalue ");
    output = Concat(output, aggregate);
    output = Concat(output, " %array.2, ptr ");
    output = Concat(output, flow_target.allocator_literal);
    output = Concat(output, ", ");
    output = Concat(output, ToString(abi.allocator_index));
    output = Concat(output, "\n  ret ");
    output = Concat(output, aggregate);
    output = Concat(output, " %array.3\n}\n\ndefine ");
    output = Concat(output, flow_target.call_linkage);
    output = Concat(output, " ");
    output = Concat(output, aggregate);
    output = Concat(output, " @");
    output = Concat(output, outer_symbol);
    output = Concat(output, "(%");
    output = Concat(output, wrapper);
    output = Concat(output, " %");
    output = Concat(output, receiver);
    output = Concat(output, ", ");
    output = Concat(output, aggregate);
    output = Concat(output, " %");
    output = Concat(output, outer_value);
    output = Concat(output, ") {\nentry:\n  ret ");
    output = Concat(output, aggregate);
    output = Concat(output, " %");
    output = Concat(output, outer_value);
    output = Concat(output, "\n}\n\ndefine i32 @main() {\nentry:\n  %receiver = insertvalue %");
    output = Concat(output, wrapper);
    output = Concat(output, " poison, i32 ");
    output = Concat(output, ToString(plan.identity.main_graph.marker_value));
    output = Concat(output, ", 0\n  %point = insertvalue %");
    output = Concat(output, record);
    output = Concat(output, " poison, i32 ");
    output = Concat(output, ToString(plan.identity.main_graph.field_value));
    output = Concat(output, ", 0\n  %array.storage = alloca [");
    output = Concat(output, ToString(flow_target.storage_count));
    output = Concat(output, " x %");
    output = Concat(output, record);
    output = Concat(output, "], align ");
    output = Concat(output, plan.identity.record.abi.align_text);
    output = Concat(output, "\n  %array.data = getelementptr inbounds [");
    output = Concat(output, ToString(flow_target.storage_count));
    output = Concat(output, " x %");
    output = Concat(output, record);
    output = Concat(output, "], ptr %array.storage, i64 0, i64 ");
    output = Concat(output, ToString(flow_target.selected_index));
    output = Concat(output, "\n  %inner = call ");
    output = Concat(output, aggregate);
    output = Concat(output, " @");
    output = Concat(output, inner_symbol);
    output = Concat(output, "(%");
    output = Concat(output, wrapper);
    output = Concat(output, " %receiver, %");
    output = Concat(output, record);
    output = Concat(output, " %point, ptr %array.data)\n  %result = call ");
    output = Concat(output, aggregate);
    output = Concat(output, " @");
    output = Concat(output, outer_symbol);
    output = Concat(output, "(%");
    output = Concat(output, wrapper);
    output = Concat(output, " %receiver, ");
    output = Concat(output, aggregate);
    output = Concat(output, " %inner)\n  %result.data = extractvalue ");
    output = Concat(output, aggregate);
    output = Concat(output, " %result, ");
    output = Concat(output, ToString(abi.data_index));
    output = Concat(output, "\n  %first.ptr = getelementptr inbounds %");
    output = Concat(output, record);
    output = Concat(output, ", ptr %result.data, i64 ");
    output = Concat(output, ToString(flow_target.selected_index));
    output = Concat(output, "\n  %first = load %");
    output = Concat(output, record);
    output = Concat(output, ", ptr %first.ptr, align ");
    output = Concat(output, plan.identity.record.abi.align_text);
    output = Concat(output, "\n  %field = extractvalue %");
    output = Concat(output, record);
    output = Concat(output, " %first, 0\n  %print = sext i32 %field to i64\n  %logged = call i32 (ptr, ...) @");
    output = Concat(output, formatted_print.symbol);
    output = Concat(output, "(ptr @.pgy.int.line.format, i64 %print)\n  ret i32 0\n}\n");
    return output;
}
