// Target-neutral Point/Array<Point> plan for one mixed member execution rung.

import "direct_mir_constructed_record_array_member_representation_owner.pgy";
import "direct_mir_constructed_record_array_member_plan_join_owner.pgy";
import "direct_mir_aggregate_value_flow_fact_owner.pgy";
import "artifact_zone_owner.pgy";
import "../mir_lower/ssa_identity_owner.pgy";

struct DirectMirConstructedRecordArrayMemberPlan {
    let valid: Bool;
    let schema: String;
    let revision: Int;
    let digest: Int;
    let identity: DirectMirConstructedRecordArrayMemberIdentity;
    let methods: DirectMirConstructedArrayMemberMethodInstructions;
    let main: DirectMirConstructedRecordArrayMemberMainAdmission;
    let point_abi: DirectMirConstructedRecordArrayMemberPointAbiFact;
    let aggregate_flow: DirectMirAggregateValueFlowFact;
}

func DirectMirConstructedRecordArrayMemberPlanSchema() -> String {
    return "pgy.selfhost.direct-mir-constructed-record-array-member-plan.v1";
}

func DirectMirConstructedRecordArrayMemberPlanDigest(
    ref plan: DirectMirConstructedRecordArrayMemberPlan
) -> Int {
    if !plan.valid { return 0; }
    let hash: Long = DirectMirCfgHashString(463L, plan.schema);
    hash = DirectMirCfgHashInt(hash, plan.revision);
    hash = DirectMirCfgHashInt(hash, plan.identity.digest);
    hash = DirectMirCfgHashInt(
        hash, DirectMirConstructedRecordArrayProgramDigest(
            plan.methods, plan.main
        )
    );
    hash = DirectMirCfgHashInt(hash, plan.point_abi.digest);
    hash = DirectMirCfgHashInt(hash, plan.aggregate_flow.digest);
    return DirectMirCfgBoundedDigest(hash);
}

func DirectMirConstructedRecordArrayMemberPlanReady(
    ref plan: DirectMirConstructedRecordArrayMemberPlan
) -> Bool {
    let graph: DirectMirConstructedRecordArrayMemberMainGraphFact =
        plan.identity.main_graph;
    return plan.valid &&
        plan.schema == DirectMirConstructedRecordArrayMemberPlanSchema() &&
        plan.revision == CompilerArtifactPlanRevision() && plan.digest != 0 &&
        plan.digest == DirectMirConstructedRecordArrayMemberPlanDigest(plan) &&
        DirectMirConstructedRecordArrayMemberIdentityReady(plan.identity) &&
        DirectMirConstructedArrayMemberMethodInstructionsReady(plan.methods) &&
        DirectMirConstructedRecordArrayMemberMainAdmissionReady(plan.main) &&
        DirectMirConstructedRecordArrayProgramJoinReady(
            plan.identity, plan.methods, plan.main
        ) &&
        DirectMirConstructedRecordArrayMemberPointAbiFactReady(plan.point_abi) &&
        DirectMirAggregateValueFlowFactReady(plan.aggregate_flow) &&
        plan.aggregate_flow.wrapper_type == plan.identity.wrapper.name &&
        plan.aggregate_flow.wrapper_field ==
            plan.identity.wrapper.field_name &&
        plan.aggregate_flow.wrapper_field_type ==
            plan.identity.wrapper.field_type &&
        plan.aggregate_flow.element_type == plan.identity.record.name &&
        plan.aggregate_flow.array_type ==
            plan.identity.specialization.pair.outer_generic_actual &&
        plan.aggregate_flow.abi_provenance ==
            DirectMirAggregateValueFlowTypedArrayAbsenceNominalElementAbi() &&
        plan.aggregate_flow.array_layout_admission ==
            "typed_array_physical_abi_absent" &&
        plan.aggregate_flow.abi_evidence_id ==
            plan.main.typed_array_abi_absence.digest &&
        plan.point_abi.declaration.digest == plan.identity.record.digest &&
        plan.aggregate_flow.selected_index == graph.selected_index &&
        plan.identity.method_graph.element_count ==
            plan.aggregate_flow.storage_count &&
        plan.identity.method_graph.construction_policy ==
            plan.aggregate_flow.construction_policy &&
        plan.identity.method_graph.identity_policy ==
            plan.aggregate_flow.identity_policy &&
        MirSsaNameMatches(plan.main.wrapper.result, graph.receiver_local, false) &&
        MirSsaNameMatches(plan.main.point.result, graph.point_local, false) &&
        MirSsaNameMatches(plan.main.result.result, graph.result_local, false) &&
        MirSsaNameMatches(plan.main.first.result, graph.first_local, false);
}

func DirectMirConstructedRecordArrayMemberPlanFromAdmitted(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    ref classification: DirectMirThreeRoutineClassificationFact
) -> DirectMirConstructedRecordArrayMemberPlan {
    let identity: DirectMirConstructedRecordArrayMemberIdentity =
        DirectMirConstructedRecordArrayMemberIdentityFromAdmitted(
            admitted, classification
        );
    let methods: DirectMirConstructedArrayMemberMethodInstructions =
        DirectMirConstructedArrayMemberMethodInstructionsFromSignatures(
            admitted, identity.constructed_method, identity.identity_method
        );
    let main: DirectMirConstructedRecordArrayMemberMainAdmission =
        DirectMirConstructedRecordArrayMemberMainAdmissionFromProgram(
            admitted, identity
        );
    let point_abi: DirectMirConstructedRecordArrayMemberPointAbiFact =
        DirectMirConstructedRecordArrayMemberPointAbiFromMain(
            admitted.routines.source_json, identity, main
        );
    let representation: DirectMirInferredGenericMemberRepresentationFact =
        DirectMirConstructedRecordArrayMemberRepresentationFromProgram(
            identity, methods, main
        );
    let aggregate_flow: DirectMirAggregateValueFlowFact =
        DirectMirAggregateValueFlowFactFromTypedArrayAbsence(
            representation, identity.wrapper.name,
            identity.wrapper.field_name, identity.wrapper.field_type,
            identity.record.name,
            identity.specialization.pair.outer_generic_actual,
            main.typed_array_abi_absence.digest
        );
    if !DirectMirConstructedRecordArrayProgramJoinReady(
        identity, methods, main
    ) {
        Die(Concat(
            "direct MIR constructed record Array program join is invalid: ",
            DirectMirConstructedRecordArrayProgramJoinDiagnostic(
                identity, methods, main
            )
        ));
    }
    let plan: DirectMirConstructedRecordArrayMemberPlan =
        DirectMirConstructedRecordArrayMemberPlan(
            true, DirectMirConstructedRecordArrayMemberPlanSchema(),
            CompilerArtifactPlanRevision(), 0, identity, methods, main,
            point_abi, aggregate_flow
        );
    let verified: DirectMirConstructedRecordArrayMemberPlan =
        DirectMirConstructedRecordArrayMemberPlan(
            plan.valid, plan.schema, plan.revision,
            DirectMirConstructedRecordArrayMemberPlanDigest(plan),
            plan.identity, plan.methods, plan.main, plan.point_abi,
            plan.aggregate_flow
        );
    if !DirectMirConstructedRecordArrayMemberPlanReady(verified) {
        Die("direct MIR constructed record Array plan is invalid");
    }
    return verified;
}
