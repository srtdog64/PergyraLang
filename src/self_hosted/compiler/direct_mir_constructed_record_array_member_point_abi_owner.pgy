// Point declaration plus both value receipts, admitted as one physical fact.

import "direct_mir_constructed_record_array_member_main_admission_owner.pgy";
import "direct_mir_nominal_abi_row_equality_owner.pgy";

struct DirectMirConstructedRecordArrayMemberPointAbiFact {
    let valid: Bool;
    let digest: Int;
    let declaration_digest: Int;
    let declaration_layout_id: Int;
    let point_layout_id: Int;
    let first_layout_id: Int;
}

func DirectMirConstructedRecordArrayMemberPointAbiDigest(
    ref fact: DirectMirConstructedRecordArrayMemberPointAbiFact
) -> Int {
    if !fact.valid { return 0; }
    let hash: Long = DirectMirCfgHashInt(461L, fact.declaration_digest);
    hash = DirectMirCfgHashInt(hash, fact.declaration_layout_id);
    hash = DirectMirCfgHashInt(hash, fact.point_layout_id);
    hash = DirectMirCfgHashInt(hash, fact.first_layout_id);
    return DirectMirCfgBoundedDigest(hash);
}

func DirectMirConstructedRecordArrayPointLayoutReady(
    ref declaration: DirectMirNominalDeclarationAbiFact
) -> Bool {
    return DirectMirNominalDeclarationAbiFactReady(declaration) &&
        ArrayLength(declaration.field_names) == 1 &&
        declaration.field_types[0] == CompilerAbiLayoutIntTypeName() &&
        declaration.abi.size_text == "4" && declaration.abi.align_text == "4" &&
        ArrayLength(declaration.abi.field_names) == 1 &&
        ArrayLength(declaration.abi.field_offsets) == 1 &&
        ArrayLength(declaration.abi.field_sizes) == 1 &&
        ArrayLength(declaration.abi.field_aligns) == 1 &&
        declaration.abi.field_names[0] == declaration.field_names[0] &&
        declaration.abi.field_offsets[0] == "0" && declaration.abi.field_sizes[0] == "4" &&
        declaration.abi.field_aligns[0] == "4" && declaration.abi.runtime_fn == "" &&
        declaration.abi.inner_c_type == "" && declaration.abi.representation_text == "0" &&
        declaration.abi.discriminant == "" && declaration.abi.primary_tag_text == "0" &&
        declaration.abi.secondary_tag_text == "0" && declaration.abi.niche_none_pattern == "";
}

func DirectMirConstructedRecordArrayMemberPointAbiFactReady(
    ref fact: DirectMirConstructedRecordArrayMemberPointAbiFact
) -> Bool {
    return fact.valid && fact.digest != 0 && fact.digest ==
        DirectMirConstructedRecordArrayMemberPointAbiDigest(fact) &&
        fact.declaration_digest != 0 && fact.declaration_layout_id != 0 &&
        fact.point_layout_id == fact.declaration_layout_id &&
        fact.first_layout_id == fact.declaration_layout_id;
}

func DirectMirConstructedRecordArrayCapturedPointAbi(
    json: String, ref capture: MirRoutineInstructionScalarCapture
) -> MirAbiLayoutRowCapture {
    let admitted: Option<MirAbiLayoutRowCapture> =
        MirCapturedRequiredAbiLayoutRowAdmission(
            json, capture.abi_type_name, capture.abi_type_value_ready,
            capture.abi_type_start, capture.abi_type_end,
            capture.abi_layout_id_start, capture.abi_layout_id_end,
            capture.abi_layout_required_start,
            capture.abi_layout_required_end, capture.abi_layout_start,
            capture.abi_layout_end
        );
    if !IsSome(admitted) {
        Die("direct MIR constructed record Array Point ABI is missing");
    }
    return UnwrapOption(admitted);
}

func DirectMirConstructedRecordArrayMemberPointAbiFromMain(
    json: String,
    ref identity: DirectMirConstructedRecordArrayMemberIdentity,
    ref main: DirectMirConstructedRecordArrayMemberMainAdmission
) -> DirectMirConstructedRecordArrayMemberPointAbiFact {
    let point: MirAbiLayoutRowCapture =
        DirectMirConstructedRecordArrayCapturedPointAbi(json, main.point);
    let first: MirAbiLayoutRowCapture =
        DirectMirConstructedRecordArrayCapturedPointAbi(json, main.first);
    if !DirectMirConstructedRecordArrayPointLayoutReady(identity.record) ||
        !DirectMirStructAbiRowsEqual(point, identity.record.abi) ||
        !DirectMirStructAbiRowsEqual(first, identity.record.abi) {
        Die("direct MIR constructed record Array Point ABI receipts disagree");
    }
    let fact: DirectMirConstructedRecordArrayMemberPointAbiFact =
        DirectMirConstructedRecordArrayMemberPointAbiFact(
            true, 0, identity.record.digest,
            identity.record.abi_layout_id, MirAbiLayoutIdFromCapture(point),
            MirAbiLayoutIdFromCapture(first)
        );
    let verified: DirectMirConstructedRecordArrayMemberPointAbiFact =
        DirectMirConstructedRecordArrayMemberPointAbiFact(
            fact.valid,
            DirectMirConstructedRecordArrayMemberPointAbiDigest(fact),
            fact.declaration_digest, fact.declaration_layout_id,
            fact.point_layout_id, fact.first_layout_id
        );
    if !DirectMirConstructedRecordArrayMemberPointAbiFactReady(verified) {
        Die("direct MIR constructed record Array Point ABI fact is invalid");
    }
    return verified;
}
