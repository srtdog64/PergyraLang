// Shared outer envelope for programs containing one strict generic routine.

import "direct_mir_array_argument_program_identity_owner.pgy";

func DirectMirGenericRoutineProgramEnvelopeReady(
    ref routine: JsonObjectFactTable
) -> Bool {
    let generic_bounds: Array<Int> = [0, 0];
    if !JsonObjectFactTableReady(routine) ||
        !MirObjectArrayBoundsAtBounds(
            routine.json, routine.start, routine.end, "generics",
            generic_bounds
        ) || JsonArrayStringCount(
            routine.json, generic_bounds[0], generic_bounds[1]
        ) > 1 || !JsonObjectFactHasField(routine, "params") ||
        JsonObjectFactHasField(routine, "function_param_flow_summary_count") ||
        JsonObjectFactHasField(routine, "function_param_flow_summaries") {
        return false;
    }
    return DirectMirObjectArrayEmpty(routine, "resource_flow_symbols") &&
        DirectMirObjectArrayEmpty(routine, "loop_flow_summaries") &&
        DirectMirObjectArrayEmpty(routine, "loop_flow_states") &&
        DirectMirObjectArrayEmpty(routine, "iteration_type_facts") &&
        DirectMirObjectArrayEmpty(routine, "destructure_type_facts") &&
        DirectMirObjectNumberEquals(
            routine, "resource_flow_symbol_count", "0"
        ) && DirectMirObjectNumberEquals(
            routine, "loop_flow_summary_count", "0"
        ) && DirectMirObjectNumberEquals(
            routine, "loop_flow_state_count", "0"
        ) && DirectMirObjectNumberEquals(
            routine, "iteration_type_fact_count", "0"
        ) && DirectMirObjectNumberEquals(
            routine, "destructure_type_fact_count", "0"
        );
}
