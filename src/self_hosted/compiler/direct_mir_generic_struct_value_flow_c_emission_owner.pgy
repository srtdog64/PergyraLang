// Runtime-free C emission from the explicit-generic nominal plan.

import "direct_mir_generic_struct_value_flow_plan_owner.pgy";
import "runtime_call_abi_structured_fact_owner.pgy";
import "symbol_table_owner.pgy";

func DirectMirGenericStructValueFlowEmitC(
    ref plan: DirectMirGenericStructValueFlowPlan,
    formatted_print: CompilerRuntimeCallAbiFact,
    line_format: String
) -> String {
    if !DirectMirGenericStructValueFlowPlanReady(plan) ||
        !formatted_print.ok || formatted_print.call_shape !=
            CompilerRuntimeCallAbiStringCallShape("formatted-print") ||
        formatted_print.symbol == "" || line_format == "" {
        Die("direct MIR generic nominal C projection facts are invalid");
    }
    let type_name: String = CompilerSymbolCIdentifier(
        plan.identity.graph.type_name
    );
    let first: String = CompilerSymbolCIdentifier(
        plan.identity.graph.first_field
    );
    let second: String = CompilerSymbolCIdentifier(
        plan.identity.graph.second_field
    );
    let specialized: String = CompilerSymbolCIdentifier(
        plan.identity.specialization.specialized_symbol
    );
    let generic_param: String = CompilerSymbolCIdentifier(
        plan.identity.graph.generic_parameter_name
    );
    let producer: String = CompilerSymbolCIdentifier(
        plan.identity.graph.producer_name
    );
    let producer_param: String = CompilerSymbolCIdentifier(
        plan.identity.graph.parameter_name
    );
    if type_name == "" || first == "" || second == "" || first == second ||
        specialized == "" || generic_param == "" || producer == "" ||
        producer_param == "" || specialized == producer {
        Die("direct MIR generic nominal C symbols are invalid");
    }
    let output: String =
        "#include <stdint.h>\n#include <stddef.h>\n#include <stdio.h>\n\n";
    output = Concat(output, "typedef struct {\n    int32_t ");
    output = Concat(output, first);
    output = Concat(output, ";\n    int32_t ");
    output = Concat(output, second);
    output = Concat(output, ";\n} ");
    output = Concat(output, type_name);
    output = Concat(output, ";\n\n_Static_assert(sizeof(");
    output = Concat(output, type_name);
    output = Concat(output, ") == ");
    output = Concat(output, plan.identity.declaration.abi.size_text);
    output = Concat(output, ", \"nominal size receipt\");\n_Static_assert(_Alignof(");
    output = Concat(output, type_name);
    output = Concat(output, ") == ");
    output = Concat(output, plan.identity.declaration.abi.align_text);
    output = Concat(output, ", \"nominal align receipt\");\n_Static_assert(offsetof(");
    output = Concat(output, type_name);
    output = Concat(output, ", ");
    output = Concat(output, second);
    output = Concat(output, ") == ");
    output = Concat(output, plan.identity.declaration.abi.field_offsets[1]);
    output = Concat(output, ", \"nominal field receipt\");\n\nstatic int32_t ");
    output = Concat(output, specialized);
    output = Concat(output, "(int32_t ");
    output = Concat(output, generic_param);
    output = Concat(output, ") {\n    return ");
    output = Concat(output, generic_param);
    output = Concat(output, ";\n}\n\nstatic ");
    output = Concat(output, type_name);
    output = Concat(output, " ");
    output = Concat(output, producer);
    output = Concat(output, "(int32_t ");
    output = Concat(output, producer_param);
    output = Concat(output, ") {\n    ");
    output = Concat(output, type_name);
    output = Concat(output, " pgy_returned = {");
    output = Concat(output, specialized);
    output = Concat(output, "(");
    output = Concat(output, producer_param);
    output = Concat(output, " + ");
    output = Concat(output, ToString(plan.identity.graph.producer_first_delta));
    output = Concat(output, "), ");
    output = Concat(output, specialized);
    output = Concat(output, "(");
    output = Concat(output, producer_param);
    output = Concat(output, " + ");
    output = Concat(output, ToString(plan.identity.graph.producer_second_delta));
    output = Concat(output, ")};\n    return pgy_returned;\n}\n\nint main(void) {\n    ");
    output = Concat(output, type_name);
    output = Concat(output, " pgy_initial = {");
    output = Concat(output, specialized);
    output = Concat(output, "(");
    output = Concat(output, ToString(plan.identity.graph.initial_first));
    output = Concat(output, "), ");
    output = Concat(output, specialized);
    output = Concat(output, "(");
    output = Concat(output, ToString(plan.identity.graph.initial_second));
    output = Concat(output, ")};\n    ");
    output = Concat(output, type_name);
    output = Concat(output, " pgy_built = ");
    output = Concat(output, producer);
    output = Concat(output, "(pgy_initial.");
    output = Concat(output, second);
    output = Concat(output, ");\n    int32_t pgy_sum = pgy_built.");
    output = Concat(output, first);
    output = Concat(output, " + pgy_built.");
    output = Concat(output, second);
    output = Concat(output, ";\n    ");
    output = Concat(output, formatted_print.symbol);
    output = Concat(output, "(\"");
    output = Concat(output, line_format);
    output = Concat(output, "\", (long long)pgy_sum);\n    return 0;\n}\n");
    return output;
}
