// LLVM projection from the same explicit-generic nominal plan as C.

import "direct_mir_generic_struct_value_flow_plan_owner.pgy";
import "direct_mir_llvm_text_format_owner.pgy";
import "runtime_call_abi_structured_fact_owner.pgy";
import "symbol_table_owner.pgy";

func DirectMirGenericStructValueFlowEmitLlvm(
    ref plan: DirectMirGenericStructValueFlowPlan,
    formatted_print: CompilerRuntimeCallAbiFact,
    line_format: String
) -> String {
    if !DirectMirGenericStructValueFlowPlanReady(plan) ||
        !formatted_print.ok || formatted_print.call_shape !=
            CompilerRuntimeCallAbiStringCallShape("formatted-print") ||
        formatted_print.symbol == "" || line_format == "" {
        Die("direct MIR generic nominal LLVM projection facts are invalid");
    }
    let type_name: String =
        CompilerSymbolCIdentifier(plan.identity.graph.type_name);
    let specialized: String = CompilerSymbolCIdentifier(
        plan.identity.specialization.specialized_symbol
    );
    let producer: String =
        CompilerSymbolCIdentifier(plan.identity.graph.producer_name);
    if type_name == "" || specialized == "" || producer == "" ||
        specialized == producer {
        Die("direct MIR generic nominal LLVM symbols are invalid");
    }
    let payload: String = DirectMirScalarLlvmFormatPayload(line_format);
    let format_size: Int = DirectMirScalarLlvmFormatByteCount(line_format);
    let output: String = "%";
    output = Concat(output, type_name);
    output = Concat(output, " = type { i32, i32 }\n\n@.pgy.int.line.format = private unnamed_addr constant [");
    output = Concat(output, ToString(format_size));
    output = Concat(output, " x i8] c\"");
    output = Concat(output, payload);
    output = Concat(output, "\\00\", align 1\n\ndeclare i32 @");
    output = Concat(output, formatted_print.symbol);
    output = Concat(output, "(ptr, ...)\n\ndefine internal i32 @");
    output = Concat(output, specialized);
    output = Concat(output, "(i32 %value) {\nentry:\n  ret i32 %value\n}\n\ndefine internal %");
    output = Concat(output, type_name);
    output = Concat(output, " @");
    output = Concat(output, producer);
    output = Concat(output, "(i32 %base) {\nentry:\n  %pgy.left.raw = add i32 %base, ");
    output = Concat(output, ToString(plan.identity.graph.producer_first_delta));
    output = Concat(output, "\n  %pgy.left = call i32 @");
    output = Concat(output, specialized);
    output = Concat(output, "(i32 %pgy.left.raw)\n  %pgy.right.raw = add i32 %base, ");
    output = Concat(output,
        ToString(plan.identity.graph.producer_second_delta));
    output = Concat(output, "\n  %pgy.right = call i32 @");
    output = Concat(output, specialized);
    output = Concat(output, "(i32 %pgy.right.raw)\n  %pgy.return.0 = insertvalue %");
    output = Concat(output, type_name);
    output = Concat(output, " poison, i32 %pgy.left, 0\n  %pgy.return.1 = insertvalue %");
    output = Concat(output, type_name);
    output = Concat(output, " %pgy.return.0, i32 %pgy.right, 1\n  ret %");
    output = Concat(output, type_name);
    output = Concat(output, " %pgy.return.1\n}\n\ndefine i32 @main() {\nentry:\n  %pgy.initial.left = call i32 @");
    output = Concat(output, specialized);
    output = Concat(output, "(i32 ");
    output = Concat(output, ToString(plan.identity.graph.initial_first));
    output = Concat(output, ")\n  %pgy.initial.right = call i32 @");
    output = Concat(output, specialized);
    output = Concat(output, "(i32 ");
    output = Concat(output, ToString(plan.identity.graph.initial_second));
    output = Concat(output, ")\n  %pgy.initial.0 = insertvalue %");
    output = Concat(output, type_name);
    output = Concat(output, " poison, i32 %pgy.initial.left, 0\n  %pgy.initial.1 = insertvalue %");
    output = Concat(output, type_name);
    output = Concat(output, " %pgy.initial.0, i32 %pgy.initial.right, 1\n  %pgy.argument = extractvalue %");
    output = Concat(output, type_name);
    output = Concat(output, " %pgy.initial.1, 1\n  %pgy.built = call %");
    output = Concat(output, type_name);
    output = Concat(output, " @");
    output = Concat(output, producer);
    output = Concat(output, "(i32 %pgy.argument)\n  %pgy.built.left = extractvalue %");
    output = Concat(output, type_name);
    output = Concat(output, " %pgy.built, 0\n  %pgy.built.right = extractvalue %");
    output = Concat(output, type_name);
    output = Concat(output, " %pgy.built, 1\n  %pgy.sum = add i32 %pgy.built.left, %pgy.built.right\n  %pgy.print = sext i32 %pgy.sum to i64\n  %pgy.logged = call i32 (ptr, ...) @");
    output = Concat(output, formatted_print.symbol);
    output = Concat(output, "(ptr @.pgy.int.line.format, i64 %pgy.print)\n  ret i32 0\n}\n");
    return output;
}
