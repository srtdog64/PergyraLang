// Exclusive document/routine envelope for the explicit-generic nominal rung.

import "direct_mir_three_routine_classification_owner.pgy";

func DirectMirGenericStructRoutineEnvelopeReady(
    ref routine: JsonObjectFactTable
) -> Bool {
    let generic_bounds: Array<Int> = [0, 0];
    if !JsonObjectFactTableReady(routine) ||
        !MirObjectArrayBoundsAtBounds(
            routine.json, routine.start, routine.end, "generics",
            generic_bounds
        ) || JsonArrayStringCount(
            routine.json, generic_bounds[0], generic_bounds[1]
        ) > 1 || !JsonObjectFactHasField(routine, "params") ||
        JsonObjectFactHasField(routine, "function_param_flow_summary_count") ||
        JsonObjectFactHasField(routine, "function_param_flow_summaries") {
        return false;
    }
    return DirectMirObjectArrayEmpty(routine, "resource_flow_symbols") &&
        DirectMirObjectArrayEmpty(routine, "loop_flow_summaries") &&
        DirectMirObjectArrayEmpty(routine, "loop_flow_states") &&
        DirectMirObjectArrayEmpty(routine, "iteration_type_facts") &&
        DirectMirObjectArrayEmpty(routine, "destructure_type_facts") &&
        DirectMirObjectNumberEquals(
            routine, "resource_flow_symbol_count", "0"
        ) && DirectMirObjectNumberEquals(
            routine, "loop_flow_summary_count", "0"
        ) && DirectMirObjectNumberEquals(
            routine, "loop_flow_state_count", "0"
        ) && DirectMirObjectNumberEquals(
            routine, "iteration_type_fact_count", "0"
        ) && DirectMirObjectNumberEquals(
            routine, "destructure_type_fact_count", "0"
        );
}

func DirectMirGenericStructValueFlowProgramEnvelopeReady(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    ref classification: DirectMirThreeRoutineClassificationFact
) -> Bool {
    let declarations: MirProgramDeclarationIndex =
        admitted.domain_runtime_admission.declarations;
    if !DirectMirThreeRoutineClassificationFactReady(classification) ||
        classification.kind != DirectMirThreeRoutineGenericNominal() ||
        classification.specialization_count != 4 ||
        !admitted.document.valid || admitted.domain_topology_plan.present ||
        admitted.document.routines.json != admitted.routines.source_json ||
        JsonObjectFactCount(admitted.document.root) != 5 ||
        !declarations.valid ||
        MirProgramDeclarationIndexCount(declarations) != 1 ||
        !JsonArrayObjectFactTableReady(
            admitted.document.parallel_capture_boundaries
        ) || JsonArrayObjectFactCount(
            admitted.document.parallel_capture_boundaries
        ) != 0 || !MirProgramRoutineIndexStructureReady(admitted.routines) {
        return false;
    }
    let generic_rows: Int = 0;
    let row: Int = 0;
    while row < 3 {
        if admitted.routines.kinds[row] != "function" ||
            admitted.routines.owners[row] != "" ||
            admitted.routines.routine_block_counts[row] != 1 {
            return false;
        }
        let routine: JsonObjectFactTable = JsonObjectFactTableFromBounds(
            admitted.routines.source_json, admitted.routines.starts[row],
            admitted.routines.ends[row]
        );
        if !DirectMirGenericStructRoutineEnvelopeReady(routine) {
            return false;
        }
        let header: MirRoutineHeaderFacts = BuildMirRoutineHeaderFacts(
            admitted.routines.source_json, admitted.routines.starts[row],
            admitted.routines.ends[row]
        );
        if ArrayLength(header.generic_names) == 1 {
            generic_rows = generic_rows + 1;
        }
        row = row + 1;
    }
    return generic_rows == 1;
}
