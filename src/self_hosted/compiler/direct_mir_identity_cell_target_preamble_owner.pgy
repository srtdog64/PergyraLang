// Target declaration order for payload-enum wrappers and identity cells.

import "direct_mir_scalar_cfg_graph_fact_owner.pgy";
import "direct_mir_identity_cell_projection_owner.pgy";
import "direct_mir_scalar_program_c_payload_enum_option_owner.pgy";
import "direct_mir_scalar_program_llvm_payload_enum_option_owner.pgy";

func DirectMirIdentityCellCTargetPreamble(
    ref plan: DirectMirScalarCfgGraphPlan,
    ref target: CompilerTargetProjectionFact
) -> String {
    return DirectMirScalarProgramCPayloadEnumOptionPreamble(
            plan.program.referenced_enum, target) +
        DirectMirIdentityCellPreamble(
            plan.program.logical_record.identity_cells,
            plan.program.referenced_enum, false);
}

func DirectMirIdentityCellLlvmTargetPreamble(
    ref plan: DirectMirScalarCfgGraphPlan,
    ref target: CompilerTargetProjectionFact
) -> String {
    return DirectMirScalarProgramLlvmPayloadEnumOptionPreamble(
            plan.program.referenced_enum, target,
            DirectMirScalarProgramExpressionContainsKind(
                plan.program.expressions,
                DirectMirScalarProgramExprUnwrapOptionPayloadEnum())) +
        DirectMirIdentityCellPreamble(
            plan.program.logical_record.identity_cells,
            plan.program.referenced_enum, true);
}
