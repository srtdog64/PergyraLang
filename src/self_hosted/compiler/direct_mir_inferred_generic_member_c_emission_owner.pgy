// C emission from the admitted generic member plan only.

import "direct_mir_inferred_generic_member_plan_owner.pgy";
import "runtime_call_abi_structured_fact_owner.pgy";
import "symbol_table_owner.pgy";
import "direct_mir_member_receiver_target_projection_owner.pgy";

func DirectMirInferredGenericMemberEmitC(
    ref plan: DirectMirInferredGenericMemberPlan,
    formatted_print: CompilerRuntimeCallAbiFact,
    line_format: String
) -> String {
    if !DirectMirInferredGenericMemberPlanReady(plan) ||
        !formatted_print.ok || formatted_print.call_shape !=
            CompilerRuntimeCallAbiStringCallShape("formatted-print") ||
        formatted_print.symbol == "" || line_format == "" {
        Die("direct MIR inferred member C projection facts are invalid");
    }
    let type_name: String = CompilerSymbolCIdentifier(
        plan.representation.type_name
    );
    let field_name: String = CompilerSymbolCIdentifier(
        plan.representation.field_name
    );
    let method_symbol: String = CompilerSymbolCIdentifier(
        plan.identity.specialization.specialized_symbol
    );
    let receiver_parameter: String = CompilerSymbolCIdentifier(
        plan.identity.graph.receiver_parameter_name
    );
    let value_parameter: String = CompilerSymbolCIdentifier(
        plan.identity.graph.value_parameter_name
    );
    if type_name == "" || field_name == "" || method_symbol == "" ||
        receiver_parameter == "" || value_parameter == "" ||
        receiver_parameter == value_parameter {
        Die("direct MIR inferred member C symbols are invalid");
    }
    let receiver_abi: DirectMirMemberReceiverTargetProjection =
        DirectMirMemberReceiverTargetProjectionFromFacts(
            plan.identity.declaration.host,
            plan.representation.receiver_carriage, false
        );
    let receiver_formal: String = Concat(type_name, " ");
    let receiver_operand: String = "_pgy_receiver_0";
    if receiver_abi.formal_shape == "pointer" {
        receiver_formal = Concat(type_name, " *");
        receiver_operand = "&(_pgy_receiver_0)";
    }
    receiver_formal = Concat(receiver_formal, receiver_parameter);
    let output: String = "#include <stdint.h>\n#include <stdio.h>\n\n";
    output = Concat(output, "typedef struct {\n    int32_t ");
    output = Concat(output, field_name);
    output = Concat(output, ";\n} ");
    output = Concat(output, type_name);
    output = Concat(output, ";\n\nstatic int32_t ");
    output = Concat(output, method_symbol);
    output = Concat(output, "(");
    output = Concat(output, receiver_formal);
    output = Concat(output, ", int32_t ");
    output = Concat(output, value_parameter);
    output = Concat(output, ") {\n    (void)");
    output = Concat(output, receiver_parameter);
    output = Concat(output, ";\n    return ");
    output = Concat(output, value_parameter);
    output = Concat(output, ";\n}\n\nint main(void) {\n    ");
    output = Concat(output, type_name);
    output = Concat(output, " ");
    output = Concat(output, "_pgy_receiver_0");
    output = Concat(output, " = {");
    output = Concat(output, ToString(plan.identity.graph.marker_value));
    output = Concat(output, "};\n    int32_t _pgy_inner_0 = ");
    output = Concat(output, method_symbol);
    output = Concat(output, "(");
    output = Concat(output, receiver_operand);
    output = Concat(output, ", ");
    output = Concat(output, ToString(plan.identity.graph.argument_value));
    output = Concat(output, ");\n    int32_t ");
    output = Concat(output, "_pgy_result_0");
    output = Concat(output, " = ");
    output = Concat(output, method_symbol);
    output = Concat(output, "(");
    output = Concat(output, receiver_operand);
    output = Concat(output, ", _pgy_inner_0);\n    ");
    output = Concat(output, formatted_print.symbol);
    output = Concat(output, "(\"");
    output = Concat(output, line_format);
    output = Concat(output, "\", (long long)");
    output = Concat(output, "_pgy_result_0");
    output = Concat(output, ");\n    return 0;\n}\n");
    return output;
}
