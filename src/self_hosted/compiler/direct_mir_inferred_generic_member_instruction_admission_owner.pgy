// Exact instruction, use, definition, and no-layout admission for the member rung.

import "direct_mir_inferred_generic_member_program_identity_owner.pgy";
import "direct_mir_instruction_abi_absence_owner.pgy";
import "direct_mir_scalar_graph_admission_owner.pgy";
import "../mir_lower/routine_fact_index_owner.pgy";
import "../mir_lower/routine_instruction_use_fact_owner.pgy";
import "../mir_lower/routine_result_definition_fact_owner.pgy";

struct DirectMirInferredGenericMemberInstructionAdmission {
    let valid: Bool;
    let method_return: MirRoutineInstructionScalarCapture;
    let constructor: MirRoutineInstructionScalarCapture;
    let nested_call: MirRoutineInstructionScalarCapture;
    let output: MirRoutineInstructionScalarCapture;
}

func DirectMirInferredGenericMemberInstructionCapture(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    ref index: MirRoutineFactIndex,
    routine_row: Int, instruction_row: Int
) -> MirRoutineInstructionScalarCapture {
    let global: Int = MirProgramRoutineIndexGlobalInstructionRow(
        admitted.routines, routine_row, 0, instruction_row
    );
    if global < 0 { Die("direct MIR inferred member instruction is missing"); }
    return MirRoutineInstructionFactBundleAtGlobal(
        index.instruction_facts, global
    );
}

func DirectMirInferredGenericMemberExpectedUse(
    ref uses: MirRoutineInstructionUseFacts,
    global_row: Int, expected: String
) -> Bool {
    let count: Int = MirRoutineInstructionUseCountAtGlobal(uses, global_row);
    if expected == "" { return count == 0; }
    let value: Option<String> = MirRoutineInstructionUseAtGlobal(
        uses, global_row, 0
    );
    return count == 1 && IsSome(value) && UnwrapOption(value) == expected;
}

func DirectMirInferredGenericMemberInstructionAdmissionReady(
    ref fact: DirectMirInferredGenericMemberInstructionAdmission
) -> Bool {
    return fact.valid && fact.method_return.valid && fact.constructor.valid &&
        fact.nested_call.valid && fact.output.valid &&
        fact.method_return.result == "" && fact.constructor.result != "" &&
        fact.nested_call.result != "" &&
        fact.constructor.result != fact.nested_call.result &&
        fact.output.result == "";
}

func DirectMirInferredGenericMemberSourceLocalsReady(
    ref index: MirRoutineFactIndex,
    receiver_name: String, receiver_type: String,
    result_name: String
) -> Bool {
    if ArrayLength(index.source_local_names) != 2 ||
        ArrayLength(index.source_local_types) != 2 ||
        receiver_name == "" || result_name == "" ||
        receiver_name == result_name {
        return false;
    }
    let receiver_seen: Bool = false;
    let result_seen: Bool = false;
    let row: Int = 0;
    while row < 2 {
        if index.source_local_names[row] == receiver_name &&
            index.source_local_types[row] == receiver_type && !receiver_seen {
            receiver_seen = true;
        } else if index.source_local_names[row] == result_name &&
            index.source_local_types[row] == CompilerAbiLayoutIntTypeName() &&
            !result_seen {
            result_seen = true;
        } else {
            return false;
        }
        row = row + 1;
    }
    return receiver_seen && result_seen;
}

func DirectMirInferredGenericMemberInstructionAdmissionFromProgram(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    ref identity: DirectMirInferredGenericMemberProgramIdentity
) -> DirectMirInferredGenericMemberInstructionAdmission {
    let main_row: Int = identity.entrypoint.row;
    let method_row: Int = identity.generic_method.row;
    let main_index: MirRoutineFactIndex = BuildMirRoutineFactIndex(
        admitted.routines, main_row
    );
    let method_index: MirRoutineFactIndex = BuildMirRoutineFactIndex(
        admitted.routines, method_row
    );
    let main_uses: MirRoutineInstructionUseFacts =
        BuildMirRoutineInstructionUseFacts(admitted.routines, main_row);
    let method_uses: MirRoutineInstructionUseFacts =
        BuildMirRoutineInstructionUseFacts(admitted.routines, method_row);
    let indexes_ready: Bool = main_index.valid && method_index.valid &&
        ArrayLength(main_index.block_reachable) == 1 &&
        ArrayLength(method_index.block_reachable) == 1 &&
        main_index.block_reachable[0] && method_index.block_reachable[0] &&
        MirRoutineFactIndexBlockIsTerminal(main_index, 0) &&
        MirRoutineFactIndexBlockIsTerminal(method_index, 0) &&
        main_index.block_has_conditional_branch[0] == 0 &&
        method_index.block_has_conditional_branch[0] == 0;
    if !indexes_ready || !DirectMirInferredGenericMemberSourceLocalsReady(
            main_index, identity.graph.receiver_local_name,
            identity.declaration.name, identity.graph.result_local_name
        ) ||
        ArrayLength(method_index.source_local_names) != 0 ||
        !MirRoutineInstructionUseFactsReady(main_uses, 3) ||
        !MirRoutineInstructionUseFactsReady(method_uses, 1) {
        Die("direct MIR inferred member routine facts are invalid");
    }
    let method_return: MirRoutineInstructionScalarCapture =
        DirectMirInferredGenericMemberInstructionCapture(
            admitted, method_index, method_row, 0
        );
    let constructor: MirRoutineInstructionScalarCapture =
        DirectMirInferredGenericMemberInstructionCapture(
            admitted, main_index, main_row, 0
        );
    let nested_call: MirRoutineInstructionScalarCapture =
        DirectMirInferredGenericMemberInstructionCapture(
            admitted, main_index, main_row, 1
        );
    let output: MirRoutineInstructionScalarCapture =
        DirectMirInferredGenericMemberInstructionCapture(
            admitted, main_index, main_row, 2
        );
    let globals: Array<Int> = [
        MirProgramRoutineIndexGlobalInstructionRow(
            admitted.routines, method_row, 0, 0
        ), MirProgramRoutineIndexGlobalInstructionRow(
            admitted.routines, main_row, 0, 0
        ), MirProgramRoutineIndexGlobalInstructionRow(
            admitted.routines, main_row, 0, 1
        ), MirProgramRoutineIndexGlobalInstructionRow(
            admitted.routines, main_row, 0, 2
        )
    ];
    let output_object: JsonObjectFactTable = JsonObjectFactTableFromBounds(
        admitted.routines.source_json,
        admitted.routines.instruction_starts[globals[3]],
        admitted.routines.instruction_ends[globals[3]]
    );
    if admitted.routines.instruction_kinds[globals[0]] != "return" ||
        admitted.routines.instruction_source_types[globals[0]] !=
            "AST_IDENTIFIER" ||
        admitted.routines.instruction_kinds[globals[1]] != "def" ||
        admitted.routines.instruction_source_types[globals[1]] !=
            "AST_LET_DECL" ||
        admitted.routines.instruction_kinds[globals[2]] != "def" ||
        admitted.routines.instruction_source_types[globals[2]] !=
            "AST_LET_DECL" ||
        admitted.routines.instruction_kinds[globals[3]] != "stmt" ||
        admitted.routines.instruction_source_types[globals[3]] != "AST_CALL" ||
        method_return.name != "return" || constructor.name != "ssa-def" ||
        nested_call.name != "ssa-def" || output.name != "stmt" ||
        method_return.arg0 != "" || method_return.arg1 != "" ||
        !DirectMirInstructionHasNoPhysicalAbi(
            admitted.routines.source_json, method_return,
            identity.generic_method.generic_name
        ) || constructor.arg0 != identity.graph.receiver_local_name ||
        constructor.arg1 != identity.declaration.name ||
        constructor.expr1 != identity.declaration.name ||
        !DirectMirInstructionHasNoPhysicalAbi(
            admitted.routines.source_json, constructor,
            identity.declaration.name
        ) || nested_call.arg0 != identity.graph.result_local_name ||
        nested_call.arg1 != "" ||
        nested_call.expr1 != CompilerAbiLayoutIntTypeName() ||
        !DirectMirInstructionHasNoPhysicalAbi(
            admitted.routines.source_json, nested_call,
            CompilerAbiLayoutIntTypeName()
        ) || output.arg0 != "Log" || output.arg1 != "" ||
        !DirectMirLogInstructionEnvelopeReady(output_object, "2") {
        Die("direct MIR inferred member instruction identity is invalid");
    }
    if !MirSsaNameMatches(
            constructor.result, identity.graph.receiver_local_name, false
        ) || !MirSsaNameMatches(
            nested_call.result, identity.graph.result_local_name, false
        ) || !DirectMirInferredGenericMemberExpectedUse(
            method_uses, globals[0], ""
        ) || !DirectMirInferredGenericMemberExpectedUse(
            main_uses, globals[1], ""
        ) || !DirectMirInferredGenericMemberExpectedUse(
            main_uses, globals[2], constructor.result
        ) || !DirectMirInferredGenericMemberExpectedUse(
            main_uses, globals[3], nested_call.result
        ) {
        Die("direct MIR inferred member SSA use is invalid");
    }
    let results: Array<String> = [constructor.result, nested_call.result];
    let row: Int = 0;
    while row < 2 {
        let definition: MirRoutineResultDefinitionFact =
            MirRoutineFactIndexUniqueResultDefinition(main_index, results[row]);
        if !MirRoutineResultDefinitionFactReady(definition) ||
            definition.global_row != globals[row + 1] {
            Die("direct MIR inferred member result definition is invalid");
        }
        row = row + 1;
    }
    let fact: DirectMirInferredGenericMemberInstructionAdmission =
        DirectMirInferredGenericMemberInstructionAdmission(
            true, method_return, constructor, nested_call, output
        );
    if !DirectMirInferredGenericMemberInstructionAdmissionReady(fact) {
        Die("direct MIR inferred member instruction admission is invalid");
    }
    return fact;
}
