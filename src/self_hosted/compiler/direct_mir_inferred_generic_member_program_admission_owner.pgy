// Exclusive outer envelope for the two-routine inferred generic member rung.

import "direct_mir_two_routine_classification_owner.pgy";
import "direct_mir_generic_routine_program_envelope_owner.pgy";
import "direct_mir_exact_json_array_cardinality_owner.pgy";

func DirectMirInferredGenericMemberProgramEnvelopeReady(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    ref classification: DirectMirTwoRoutineClassificationFact
) -> Bool {
    let specializations: JsonArrayObjectFactTable =
        JsonObjectFactArrayObjectTable(
            admitted.document.root, "generic_method_specializations"
        );
    if !DirectMirTwoRoutineClassificationFactReady(classification) ||
        !DirectMirTwoRoutineInferredMemberKindMatches(
            classification.kind, classification.shape.declaration_kind
        ) ||
        classification.specialization_count != 2 ||
        classification.shape.generic_routine_count != 1 ||
        classification.shape.method_routine_count != 1 ||
        !admitted.document.valid || admitted.domain_topology_plan.present ||
        admitted.document.routines.json != admitted.routines.source_json ||
        JsonObjectFactCount(admitted.document.root) != 5 ||
        !DirectMirTwoRoutineNominalProgramCandidate(admitted) ||
        !admitted.domain_runtime_admission.declarations.valid ||
        MirProgramDeclarationIndexCount(
            admitted.domain_runtime_admission.declarations
        ) != 1 ||
        admitted.domain_runtime_admission.declarations.kinds[0] !=
            classification.shape.declaration_kind ||
        admitted.domain_runtime_admission.declarations.nominal_kinds[0] !=
            classification.shape.declaration_kind ||
        !JsonArrayObjectFactTableReady(specializations) ||
        JsonArrayObjectFactCount(specializations) != 2 ||
        !JsonArrayObjectFactTableReady(
            admitted.document.parallel_capture_boundaries
        ) || !DirectMirExactObjectArrayCount(
            admitted.document.parallel_capture_boundaries, 0
        ) || !MirProgramRoutineIndexStructureReady(admitted.routines) {
        return false;
    }
    let function_count: Int = 0;
    let method_count: Int = 0;
    let row: Int = 0;
    while row < 2 {
        let routine: JsonObjectFactTable = JsonObjectFactTableFromBounds(
            admitted.routines.source_json, admitted.routines.starts[row],
            admitted.routines.ends[row]
        );
        if !DirectMirGenericRoutineProgramEnvelopeReady(routine) ||
            admitted.routines.routine_block_counts[row] != 1 {
            return false;
        }
        if admitted.routines.kinds[row] == "function" &&
            admitted.routines.owners[row] == "" {
            function_count = function_count + 1;
        } else if admitted.routines.kinds[row] == "method" &&
            admitted.routines.owners[row] ==
                admitted.domain_runtime_admission.declarations.names[0] {
            method_count = method_count + 1;
        } else {
            return false;
        }
        row = row + 1;
    }
    return function_count == 1 && method_count == 1;
}
