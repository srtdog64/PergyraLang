// Exact instruction, SSA-use, and local-lifetime admission for inferred calls.

import "direct_mir_inferred_generic_nominal_program_identity_owner.pgy";
import "direct_mir_instruction_abi_absence_owner.pgy";
import "../mir_lower/routine_fact_index_owner.pgy";
import "../mir_lower/routine_instruction_use_fact_owner.pgy";
import "../mir_lower/routine_result_definition_fact_owner.pgy";

struct DirectMirInferredGenericNominalInstructionAdmission {
    let valid: Bool;
    let generic_return: MirRoutineInstructionScalarCapture;
    let initial: MirRoutineInstructionScalarCapture;
    let output: MirRoutineInstructionScalarCapture;
}

func DirectMirInferredGenericNominalInstructionCapture(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    ref index: MirRoutineFactIndex,
    routine_row: Int, instruction_row: Int
) -> MirRoutineInstructionScalarCapture {
    let global: Int = MirProgramRoutineIndexGlobalInstructionRow(
        admitted.routines, routine_row, 0, instruction_row
    );
    if global < 0 {
        Die("direct MIR inferred generic instruction is missing");
    }
    return MirRoutineInstructionFactBundleAtGlobal(
        index.instruction_facts, global
    );
}

func DirectMirInferredGenericNominalExpectedUse(
    ref uses: MirRoutineInstructionUseFacts,
    global_row: Int, expected: String
) -> Bool {
    let count: Int = MirRoutineInstructionUseCountAtGlobal(uses, global_row);
    if expected == "" { return count == 0; }
    let value: Option<String> = MirRoutineInstructionUseAtGlobal(
        uses, global_row, 0
    );
    return count == 1 && IsSome(value) && UnwrapOption(value) == expected;
}

func DirectMirInferredGenericNominalInstructionAdmissionReady(
    ref fact: DirectMirInferredGenericNominalInstructionAdmission
) -> Bool {
    return fact.valid && fact.generic_return.valid && fact.initial.valid &&
        fact.output.valid && fact.generic_return.result == "" &&
        fact.initial.result != "" && fact.output.result == "";
}

func DirectMirInferredGenericNominalInstructionAdmissionFromProgram(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    ref identity: DirectMirInferredGenericNominalProgramIdentity
) -> DirectMirInferredGenericNominalInstructionAdmission {
    let main_row: Int = identity.entrypoint.row;
    let generic_row: Int = identity.generic_template.row;
    let main_index: MirRoutineFactIndex = BuildMirRoutineFactIndex(
        admitted.routines, main_row
    );
    let generic_index: MirRoutineFactIndex = BuildMirRoutineFactIndex(
        admitted.routines, generic_row
    );
    let main_uses: MirRoutineInstructionUseFacts =
        BuildMirRoutineInstructionUseFacts(admitted.routines, main_row);
    let generic_uses: MirRoutineInstructionUseFacts =
        BuildMirRoutineInstructionUseFacts(admitted.routines, generic_row);
    if !main_index.valid || !generic_index.valid ||
        ArrayLength(main_index.block_reachable) != 1 ||
        ArrayLength(generic_index.block_reachable) != 1 ||
        !main_index.block_reachable[0] || !generic_index.block_reachable[0] ||
        !MirRoutineFactIndexBlockIsTerminal(main_index, 0) ||
        !MirRoutineFactIndexBlockIsTerminal(generic_index, 0) ||
        main_index.block_has_conditional_branch[0] != 0 ||
        generic_index.block_has_conditional_branch[0] != 0 ||
        ArrayLength(main_index.source_local_names) != 1 ||
        ArrayLength(main_index.source_local_types) != 1 ||
        main_index.source_local_names[0] != identity.graph.source_local_name ||
        main_index.source_local_types[0] != identity.declaration.name ||
        !MirRoutineInstructionUseFactsReady(main_uses, 2) ||
        !MirRoutineInstructionUseFactsReady(generic_uses, 1) {
        Die("direct MIR inferred generic routine facts are invalid");
    }
    let generic_return: MirRoutineInstructionScalarCapture =
        DirectMirInferredGenericNominalInstructionCapture(
            admitted, generic_index, generic_row, 0
        );
    let initial: MirRoutineInstructionScalarCapture =
        DirectMirInferredGenericNominalInstructionCapture(
            admitted, main_index, main_row, 0
        );
    let output: MirRoutineInstructionScalarCapture =
        DirectMirInferredGenericNominalInstructionCapture(
            admitted, main_index, main_row, 1
        );
    let generic_global: Int = MirProgramRoutineIndexGlobalInstructionRow(
        admitted.routines, generic_row, 0, 0
    );
    let initial_global: Int = MirProgramRoutineIndexGlobalInstructionRow(
        admitted.routines, main_row, 0, 0
    );
    let output_global: Int = MirProgramRoutineIndexGlobalInstructionRow(
        admitted.routines, main_row, 0, 1
    );
    if !generic_return.valid || !initial.valid || !output.valid ||
        admitted.routines.instruction_kinds[generic_global] != "return" ||
        admitted.routines.instruction_source_types[generic_global] !=
            "AST_IDENTIFIER" ||
        admitted.routines.instruction_kinds[initial_global] != "def" ||
        admitted.routines.instruction_source_types[initial_global] !=
            "AST_LET_DECL" ||
        admitted.routines.instruction_kinds[output_global] != "stmt" ||
        admitted.routines.instruction_source_types[output_global] !=
            "AST_CALL" ||
        generic_return.name != "return" || initial.name != "ssa-def" ||
        output.name != "stmt" || generic_return.arg0 != "" ||
        generic_return.arg1 != "" ||
        !DirectMirInstructionHasNoPhysicalAbi(
            admitted.routines.source_json, generic_return,
            identity.generic_template.generic_name
        ) || initial.arg0 != identity.graph.source_local_name ||
        initial.arg1 != identity.declaration.name ||
        initial.abi_type_name != identity.declaration.name ||
        output.arg0 != "Log" || output.arg1 != "" {
        Die("direct MIR inferred generic instruction identity is invalid");
    }
    if !DirectMirInferredGenericNominalExpectedUse(
            generic_uses, generic_global, ""
        ) || !DirectMirInferredGenericNominalExpectedUse(
            main_uses, initial_global, ""
        ) || !DirectMirInferredGenericNominalExpectedUse(
            main_uses, output_global, initial.result
        ) {
        Die("direct MIR inferred generic SSA use is invalid");
    }
    let definition: MirRoutineResultDefinitionFact =
        MirRoutineFactIndexUniqueResultDefinition(main_index, initial.result);
    if !MirRoutineResultDefinitionFactReady(definition) ||
        definition.global_row != initial_global {
        Die("direct MIR inferred generic result definition is invalid");
    }
    let fact: DirectMirInferredGenericNominalInstructionAdmission =
        DirectMirInferredGenericNominalInstructionAdmission(
            true, generic_return, initial, output
        );
    if !DirectMirInferredGenericNominalInstructionAdmissionReady(fact) {
        Die("direct MIR inferred generic instruction admission is invalid");
    }
    return fact;
}
