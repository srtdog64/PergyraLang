// LLVM emission from the same inferred-generic nominal plan as C.

import "direct_mir_inferred_generic_nominal_plan_owner.pgy";
import "direct_mir_llvm_text_format_owner.pgy";
import "runtime_call_abi_structured_fact_owner.pgy";
import "symbol_table_owner.pgy";

func DirectMirInferredGenericNominalEmitLlvm(
    ref plan: DirectMirInferredGenericNominalPlan,
    formatted_print: CompilerRuntimeCallAbiFact,
    line_format: String
) -> String {
    if !DirectMirInferredGenericNominalPlanReady(plan) ||
        !formatted_print.ok || formatted_print.call_shape !=
            CompilerRuntimeCallAbiStringCallShape("formatted-print") ||
        formatted_print.symbol == "" || line_format == "" {
        Die("direct MIR inferred generic LLVM projection facts are invalid");
    }
    let graph: DirectMirInferredGenericNominalGraphFact = plan.identity.graph;
    let type_name: String = CompilerSymbolCIdentifier(graph.type_name);
    let specialized: String = CompilerSymbolCIdentifier(
        plan.identity.specialization.specialized_symbol
    );
    if type_name == "" || specialized == "" {
        Die("direct MIR inferred generic LLVM symbols are invalid");
    }
    let payload: String = DirectMirScalarLlvmFormatPayload(line_format);
    let format_size: Int = DirectMirScalarLlvmFormatByteCount(line_format);
    let output: String = "%";
    output = Concat(output, type_name);
    output = Concat(output, " = type { i32, i32 }\n\n@.pgy.int.line.format = private unnamed_addr constant [");
    output = Concat(output, ToString(format_size));
    output = Concat(output, " x i8] c\"");
    output = Concat(output, payload);
    output = Concat(output, "\\00\", align 1\n\ndeclare i32 @");
    output = Concat(output, formatted_print.symbol);
    output = Concat(output, "(ptr, ...)\n\ndefine internal i32 @");
    output = Concat(output, specialized);
    output = Concat(output, "(i32 %value) {\nentry:\n  ret i32 %value\n}\n\ndefine i32 @main() {\nentry:\n  %pgy.left = call i32 @");
    output = Concat(output, specialized);
    output = Concat(output, "(i32 ");
    output = Concat(output, ToString(graph.first_value));
    output = Concat(output, ")\n  %pgy.right = call i32 @");
    output = Concat(output, specialized);
    output = Concat(output, "(i32 ");
    output = Concat(output, ToString(graph.second_value));
    output = Concat(output, ")\n  %pgy.pair.0 = insertvalue %");
    output = Concat(output, type_name);
    output = Concat(output, " poison, i32 %pgy.left, 0\n  %pgy.pair.1 = insertvalue %");
    output = Concat(output, type_name);
    output = Concat(output, " %pgy.pair.0, i32 %pgy.right, 1\n  %pgy.pair.left = extractvalue %");
    output = Concat(output, type_name);
    output = Concat(output, " %pgy.pair.1, 0\n  %pgy.pair.right = extractvalue %");
    output = Concat(output, type_name);
    output = Concat(output, " %pgy.pair.1, 1\n  %pgy.sum = add i32 %pgy.pair.left, %pgy.pair.right\n  %pgy.print = sext i32 %pgy.sum to i64\n  %pgy.logged = call i32 (ptr, ...) @");
    output = Concat(output, formatted_print.symbol);
    output = Concat(output, "(ptr @.pgy.int.line.format, i64 %pgy.print)\n  ret i32 0\n}\n");
    return output;
}
