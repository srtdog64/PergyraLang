// Target-specific text emission from one verified literal Log plan.

import "direct_mir_literal_log_plan_owner.pgy";
import "direct_mir_llvm_text_format_owner.pgy";

func DirectMirLiteralLogEmitC(
    ref plan: DirectMirLiteralLogPlan, int_c_type: String
) -> String {
    if !DirectMirLiteralLogPlanReady(plan) ||
        (plan.literal_kind == DirectMirLiteralLogIntegerKind() &&
         int_c_type == "") {
        Die("direct MIR literal Log C plan or ABI type is invalid");
    }
    let output: String = "#include <stdint.h>\n#include <stdio.h>\n\nint main(void) {\n";
    if plan.literal_kind == DirectMirLiteralLogIntegerKind() {
        output = Concat(output, "    ");
        output = Concat(output, int_c_type);
        output = Concat(output, " pgy_literal_0 = ");
        output = Concat(output, plan.literal);
        output = Concat(output, ";\n    ");
        output = Concat(output, plan.formatted_print.symbol);
        output = Concat(output, "(\"");
        output = Concat(output, plan.line_format);
        output = Concat(output, "\", (");
        output = Concat(output, int_c_type);
        output = Concat(output, ")pgy_literal_0);\n");
    } else {
        output = Concat(output, "    ");
        output = Concat(output, plan.formatted_print.symbol);
        output = Concat(output, "(\"");
        output = Concat(output, plan.line_format);
        output = Concat(output, "\", ");
        output = Concat(output, plan.literal);
        output = Concat(output, ");\n");
    }
    return Concat(output, "    return 0;\n}\n");
}

func DirectMirLiteralLogEmitLlvm(
    ref plan: DirectMirLiteralLogPlan
) -> String {
    if !DirectMirLiteralLogPlanReady(plan) {
        Die("direct MIR literal Log LLVM plan is invalid");
    }
    let format_payload: String = DirectMirScalarLlvmFormatPayload(
        plan.line_format
    );
    let format_size: Int = DirectMirScalarLlvmFormatByteCount(
        plan.line_format
    );
    let output: String =
        "@.pgy.log.format = private unnamed_addr constant [";
    output = Concat(output, ToString(format_size));
    output = Concat(output, " x i8] c\"");
    output = Concat(output, format_payload);
    output = Concat(output, "\\00\", align 1\n");
    if plan.literal_kind == DirectMirLiteralLogStringKind() {
        output = Concat(
            output,
            "@.pgy.log.literal = private unnamed_addr constant ["
        );
        output = Concat(output, ToString(StringLength(plan.content) + 1));
        output = Concat(output, " x i8] c\"");
        output = Concat(output, plan.content);
        output = Concat(output, "\\00\", align 1\n");
    }
    output = Concat(output, "\ndeclare i32 @");
    output = Concat(output, plan.formatted_print.symbol);
    output = Concat(output, "(ptr, ...)\n\ndefine i32 @main() {\nentry:\n");
    output = Concat(output, "  %pgy.logged = call i32 (ptr, ...) @");
    output = Concat(output, plan.formatted_print.symbol);
    output = Concat(output, "(ptr @.pgy.log.format, ");
    if plan.literal_kind == DirectMirLiteralLogIntegerKind() {
        output = Concat(output, "i32 ");
        output = Concat(output, plan.literal);
    } else {
        output = Concat(output, "ptr @.pgy.log.literal");
    }
    return Concat(output, ")\n  ret i32 0\n}\n");
}
