// Exclusive multi-routine projection; rejected shapes are never reinterpreted.
import "direct_mir_array_return_emission_owner.pgy";
import "direct_mir_returned_array_foreach_projection_owner.pgy";
import "direct_mir_two_routine_nominal_projection_owner.pgy";
import "direct_mir_two_routine_classification_owner.pgy";
import "direct_mir_inferred_generic_nominal_projection_owner.pgy";
import "direct_mir_inferred_generic_member_projection_owner.pgy";
import "direct_mir_multi_routine_terminal_projection_owner.pgy";
import "direct_mir_role_operator_emission_owner.pgy";
import "direct_mir_scalar_program_projection_owner.pgy";
func CompileAdmittedDirectMirMultiRoutineForTarget(
    ref admitted: MirMachineLayerAdmittedJsonInput, target_projection: CompilerTargetProjectionFact) -> String {
    let is_c: Bool = CompilerTargetProjectionFactReadyFor(
        target_projection, CompilerTargetCpuCProjection()
    );
    let is_llvm: Bool = CompilerTargetProjectionFactReadyFor(
        target_projection, CompilerTargetCpuLlvmProjection()
    );
    if !is_c && !is_llvm {
        Die("direct MIR multi-routine projection rejected the program graph");
    }
    let formatted_print: CompilerRuntimeCallAbiFact =
        CompilerRuntimeCallAbiFormattedPrintFact();
    if !CompilerRuntimeCallAbiFlatFactOwnerReady(formatted_print) {
        Die("direct MIR multi-routine runtime ABI owner is incomplete");
    }
    let line_format: String = StringRuntimeCIntLineFormat();
    if DirectMirRoleOperatorProgramCandidate(admitted) { return CompileAdmittedDirectMirRoleOperatorForTarget(
        admitted, target_projection, is_llvm, formatted_print, line_format); }
    if DirectMirReturnedArrayForEachProgramCandidate(admitted) { return
        CompileAdmittedDirectMirReturnedArrayForEachForTarget(
            admitted, target_projection); }
    if DirectMirArrayReturnProgramCandidate(admitted) {
        let return_plan: DirectMirArrayReturnPlan = DirectMirArrayReturnPlanFromAdmitted(admitted);
        let return_abi: DirectMirArrayIntAbiProjection = DirectMirArrayReturnAbiProjectionFromPlan(
            return_plan, target_projection);
        if is_llvm {
            return DirectMirArrayReturnEmitLlvm(
                return_plan, return_abi, formatted_print, line_format
            );
        }
        return DirectMirArrayReturnEmitC(
            return_plan, return_abi, formatted_print, line_format
        );
    }
    let scalar_program_route: DirectMirScalarProgramRouteFact = DirectMirScalarProgramRouteFactFromAdmitted(admitted);
    if scalar_program_route.claimed {
        return CompileAdmittedDirectMirScalarProgramForTarget(admitted, scalar_program_route, target_projection);
    }
    if DirectMirTwoRoutineNominalProgramCandidate(admitted) {
        let two_routine: DirectMirTwoRoutineClassificationFact =
            DirectMirTwoRoutineClassificationFromAdmitted(admitted);
        if !DirectMirTwoRoutineClassificationFactReady(two_routine) {
            Die("direct MIR two-routine classification is invalid");
        }
        if two_routine.kind ==
            DirectMirTwoRoutineInferredGenericNominal() {
            return CompileAdmittedDirectMirInferredGenericNominal(
                admitted, two_routine, is_llvm, formatted_print, line_format
            );
        }
        if DirectMirTwoRoutineInferredMemberKindMatches(
            two_routine.kind, two_routine.shape.declaration_kind
        ) {
            return CompileAdmittedDirectMirInferredGenericMember(
                admitted, two_routine, is_llvm, formatted_print, line_format
            );
        }
        if two_routine.kind != DirectMirTwoRoutineClosedNominal() {
            Die("direct MIR two-routine classification is unsupported");
        }
        return CompileAdmittedDirectMirTwoRoutineNominal(
            admitted, is_llvm, formatted_print, line_format
        );
    }
    return CompileAdmittedDirectMirTerminalMultiRoutine(
        admitted, target_projection, is_llvm, formatted_print, line_format
    );
}
