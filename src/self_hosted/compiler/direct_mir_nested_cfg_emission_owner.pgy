// C and LLVM text for one normalized nested-conditional responsibility.
// The combined backend emission owner remains the last artifact-producing
// plan consumer and passes only fixed shape/topology facts here.

import "direct_mir_cfg_shape_fact_owner.pgy";
import "direct_mir_llvm_text_format_owner.pgy";
import "runtime_call_abi_structured_fact_owner.pgy";
import "../air/mir_nested_cfg_certificate_fact_owner.pgy";

func DirectMirNestedCfgEmissionFactsReady(
    ref shape: DirectMirCfgShapeFacts,
    ref nested: DirectMirNestedCfgCertificateFact,
    formatted_print: CompilerRuntimeCallAbiFact,
    line_format: String
) -> Bool {
    return DirectMirCfgShapeFactsReady(shape, 0) &&
        shape.kind == DirectMirCfgNestedConditionalShapeKind() &&
        DirectMirNestedCfgCertificateFactReady(nested) &&
        shape.entry_result_name == nested.condition_result_name &&
        formatted_print.ok && StringLength(formatted_print.symbol) > 0 &&
        formatted_print.call_shape ==
            CompilerRuntimeCallAbiStringCallShape("formatted-print") &&
        StringLength(line_format) > 0;
}

func DirectMirNestedCfgEmitC(
    ref shape: DirectMirCfgShapeFacts,
    ref nested: DirectMirNestedCfgCertificateFact,
    formatted_print: CompilerRuntimeCallAbiFact,
    line_format: String,
    int_c_type: String
) -> String {
    if !DirectMirNestedCfgEmissionFactsReady(
        shape, nested, formatted_print, line_format
    ) || StringLength(int_c_type) == 0 {
        Die("direct MIR nested CFG C facts are invalid");
    }
    let output: String = "#include <stdio.h>\n\nint main(void) {\n    ";
    output = Concat(output, int_c_type);
    output = Concat(output, " pgy_local_0 = ");
    output = Concat(output, shape.entry_integer_literal);
    output = Concat(output, ";\n    if (pgy_local_0 > ");
    output = Concat(output, shape.condition_literal);
    output = Concat(output, ") {\n        if (pgy_local_0 > ");
    output = Concat(output, shape.nested_condition_literal);
    output = Concat(output, ") {\n            ");
    output = Concat(output, formatted_print.symbol);
    output = Concat(output, "(\"");
    output = Concat(output, line_format);
    output = Concat(output, "\", ");
    output = Concat(output, shape.true_literal);
    output = Concat(output, ");\n        }\n    }\n    return 0;\n}\n");
    return output;
}

func DirectMirNestedCfgEmitLlvm(
    ref shape: DirectMirCfgShapeFacts,
    ref nested: DirectMirNestedCfgCertificateFact,
    formatted_print: CompilerRuntimeCallAbiFact,
    line_format: String
) -> String {
    if !DirectMirNestedCfgEmissionFactsReady(
        shape, nested, formatted_print, line_format
    ) {
        Die("direct MIR nested CFG LLVM facts are invalid");
    }
    let format_size: Int = DirectMirScalarLlvmFormatByteCount(line_format);
    let content_size: Int = StringLength(shape.true_content) + 1;
    let output: String = "@.pgy.string.line.format = private unnamed_addr constant [";
    output = Concat(output, ToString(format_size));
    output = Concat(output, " x i8] c\"");
    output = Concat(output, DirectMirScalarLlvmFormatPayload(line_format));
    output = Concat(output, "\\00\", align 1\n@.pgy.cfg.nested = private unnamed_addr constant [");
    output = Concat(output, ToString(content_size));
    output = Concat(output, " x i8] c\"");
    output = Concat(output, shape.true_content);
    output = Concat(output, "\\00\", align 1\n\ndeclare i32 @");
    output = Concat(output, formatted_print.symbol);
    output = Concat(output, "(ptr, ...)\n\ndefine i32 @main() {\nentry:\n");
    output = Concat(output, "  %pgy.local.entry = add i64 0, ");
    output = Concat(output, shape.entry_integer_literal);
    output = Concat(output, "\n  %pgy.condition.outer = icmp sgt i64 %pgy.local.entry, ");
    output = Concat(output, shape.condition_literal);
    output = Concat(output, "\n  br i1 %pgy.condition.outer, label %pgy.block.");
    output = Concat(output, ToString(nested.branch_block));
    output = Concat(output, ", label %pgy.block.");
    output = Concat(output, ToString(nested.outer_merge_block));
    output = Concat(output, "\n\npgy.block.");
    output = Concat(output, ToString(nested.branch_block));
    output = Concat(output, ":\n  %pgy.condition.inner = icmp sgt i64 %pgy.local.entry, ");
    output = Concat(output, shape.nested_condition_literal);
    output = Concat(output, "\n  br i1 %pgy.condition.inner, label %pgy.block.");
    output = Concat(output, ToString(nested.true_block));
    output = Concat(output, ", label %pgy.block.");
    output = Concat(output, ToString(nested.false_block));
    output = Concat(output, "\n\npgy.block.");
    output = Concat(output, ToString(nested.true_block));
    output = Concat(output, ":\n  %pgy.logged.nested = call i32 (ptr, ...) @");
    output = Concat(output, formatted_print.symbol);
    output = Concat(output, "(ptr @.pgy.string.line.format, ptr @.pgy.cfg.nested)\n  br label %pgy.block.");
    output = Concat(output, ToString(nested.merge_block));
    output = Concat(output, "\n\npgy.block.");
    output = Concat(output, ToString(nested.merge_block));
    output = Concat(output, ":\n  br label %pgy.block.");
    output = Concat(output, ToString(nested.outer_merge_block));
    output = Concat(output, "\n\npgy.block.");
    output = Concat(output, ToString(nested.outer_merge_block));
    output = Concat(output, ":\n  ret i32 0\n}\n");
    return output;
}
