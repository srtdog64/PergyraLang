// Exclusive target-pair boundary for the admitted nested-intent route.

import "direct_mir_nested_intent_program_c_emission_owner.pgy";
import "direct_mir_nested_intent_program_llvm_emission_owner.pgy";

func CompileAdmittedDirectMirNestedIntentProgramForTargetIfClaimed(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    target_projection: CompilerTargetProjectionFact
) -> Option<String> {
    let route: DirectMirNestedIntentProgramRouteFact =
        DirectMirNestedIntentProgramRouteFactFromAdmitted(admitted);
    if !route.claimed { return None; }
    let plan: DirectMirNestedIntentProgramPlan =
        DirectMirNestedIntentProgramPlanFromAdmitted(admitted, route);
    if CompilerTargetProjectionFactReadyFor(
            target_projection, CompilerTargetCpuCProjection()) {
        return Some(DirectMirNestedIntentProgramEmitC(plan));
    }
    if CompilerTargetProjectionFactReadyFor(
            target_projection, CompilerTargetCpuLlvmProjection()) {
        return Some(DirectMirNestedIntentProgramEmitLlvm(plan));
    }
    Die("direct MIR nested intent target projection is invalid");
    return None;
}
