// Mutable-identity projection only. Passive value emission moved to the
// general logical-record GraphPlan and has no literal-plan fallback.
import "direct_mir_mutable_nominal_identity_c_emission_owner.pgy";
import "direct_mir_mutable_nominal_identity_llvm_emission_owner.pgy";
import "direct_mir_nominal_literal_program_admission_owner.pgy";
import "direct_mir_nominal_literal_route_fact_owner.pgy";

func CompileAdmittedDirectMirNominalLiteral(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    ref route: DirectMirNominalLiteralRouteFact,
    target: CompilerTargetProjectionFact
) -> String {
    if !DirectMirNominalLiteralRouteUsesMutableIdentity(route) {
        Die("direct MIR nominal literal projection route is invalid");
    }
    let admission: DirectMirNominalLiteralProgramAdmission =
        DirectMirNominalLiteralProgramAdmissionFromAdmitted(admitted, route);
    let formatted_print: CompilerRuntimeCallAbiFact =
        CompilerRuntimeCallAbiFormattedPrintFact();
    let line_format: String = StringRuntimeCIntLineFormat();
    let is_llvm: Bool = CompilerTargetProjectionFactReadyFor(
        target, CompilerTargetCpuLlvmProjection()
    );
    let is_c: Bool = CompilerTargetProjectionFactReadyFor(
        target, CompilerTargetCpuCProjection()
    );
    if !is_c && !is_llvm {
        Die("direct MIR nominal literal projection target is invalid");
    }
    let identity_plan: DirectMirMutableNominalIdentityPlan =
        DirectMirMutableNominalIdentityPlanFromAdmission(admission);
    let identity_projection:
        DirectMirMutableNominalIdentityTargetProjection =
        DirectMirMutableNominalIdentityTargetProjectionFromPlan(
            identity_plan, target
        );
    if is_llvm {
        return DirectMirMutableNominalIdentityEmitLlvm(
            identity_plan, identity_projection,
            formatted_print, line_format
        );
    }
    return DirectMirMutableNominalIdentityEmitC(
        identity_plan, identity_projection, formatted_print, line_format
    );
}
