// One sealed routing claim for the value/identity nominal literal frontier.
import "direct_mir_nominal_literal_declaration_fact_owner.pgy";
import "../codegen/text/text_owner.pgy";
struct DirectMirNominalLiteralRouteFact {
    let valid: Bool;
    let digest: Int;
    let claimed: Bool;
    let kind: String;
    let nominal_kind: String;
    let name: String;
}
func DirectMirNominalLiteralRouteKind(kind: String) -> Bool {
    return DirectMirNominalLiteralFrontierKindReady(kind);
}
func DirectMirNominalLiteralRouteFactDigest(
    ref fact: DirectMirNominalLiteralRouteFact
) -> Int {
    if !fact.valid { return 0; }
    let hash: Long = DirectMirCfgHashInt(541L, 0);
    if fact.claimed { hash = DirectMirCfgHashInt(hash, 1); }
    hash = DirectMirCfgHashString(hash, fact.kind);
    hash = DirectMirCfgHashString(hash, fact.nominal_kind);
    hash = DirectMirCfgHashString(hash, fact.name);
    return DirectMirCfgBoundedDigest(hash);
}
func DirectMirNominalLiteralRouteFactReady(
    ref fact: DirectMirNominalLiteralRouteFact
) -> Bool {
    if !fact.valid || fact.digest == 0 || fact.digest !=
        DirectMirNominalLiteralRouteFactDigest(fact) {
        return false;
    }
    if !fact.claimed {
        return fact.kind == "" && fact.nominal_kind == "" && fact.name == "";
    }
    return DirectMirNominalLiteralRouteKind(fact.kind) &&
        fact.kind == fact.nominal_kind && fact.name != "";
}
func DirectMirNominalLiteralRouteUsesMutableIdentity(
    ref fact: DirectMirNominalLiteralRouteFact
) -> Bool {
    return DirectMirNominalLiteralRouteFactReady(fact) && fact.claimed &&
        CallableReceiverNominalKindUsesMutableIdentity(fact.kind);
}
func DirectMirNominalLiteralRouteFactFromAdmitted(
    ref admitted: MirMachineLayerAdmittedJsonInput
) -> DirectMirNominalLiteralRouteFact {
    let kind: String = "";
    let nominal_kind: String = "";
    let name: String = "";
    if JsonArrayObjectFactTableReady(admitted.document.declarations) &&
        JsonArrayObjectFactCount(admitted.document.declarations) == 1 {
        let declaration: JsonObjectFactTable = JsonArrayObjectFactAt(
            admitted.document.declarations, 0
        );
        let kind_fact: Option<String> = MirObjectUniqueStringFactAtBounds(
            declaration.json, declaration.start, declaration.end, "kind");
        let nominal_fact: Option<String> = MirObjectUniqueStringFactAtBounds(
            declaration.json, declaration.start, declaration.end,
            "nominal_kind");
        let name_fact: Option<String> = MirObjectUniqueStringFactAtBounds(
            declaration.json, declaration.start, declaration.end, "name");
        if IsSome(kind_fact) { kind = UnwrapOption(kind_fact); }
        if IsSome(nominal_fact) {
            nominal_kind = UnwrapOption(nominal_fact);
        }
        if IsSome(name_fact) { name = UnwrapOption(name_fact); }
    }
    let claimed: Bool = name != "" &&
        (DirectMirNominalLiteralRouteKind(kind) ||
         DirectMirNominalLiteralRouteKind(nominal_kind));
    if !claimed {
        kind = "";
        nominal_kind = "";
        name = "";
    }
    let fact: DirectMirNominalLiteralRouteFact =
        DirectMirNominalLiteralRouteFact(
            true, 0, claimed, kind, nominal_kind, name);
    let verified: DirectMirNominalLiteralRouteFact =
        DirectMirNominalLiteralRouteFact(
            fact.valid, DirectMirNominalLiteralRouteFactDigest(fact),
            fact.claimed, fact.kind, fact.nominal_kind, fact.name);
    if !DirectMirNominalLiteralRouteFactReady(verified) {
        Die("direct MIR nominal literal route fact is invalid");
    }
    return verified;
}
