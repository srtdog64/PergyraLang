// Exact expression-graph shapes for the bounded Option<nominal> value flow.

import "direct_mir_array_int_graph_fact_owner.pgy";

func DirectMirOptionStructExactTopologyReady(
    ref sequence: MirExpressionGraphSequence,
    kinds: Array<Int>, lefts: Array<Int>, rights: Array<Int>,
    targets: Array<String>, root: Int
) -> Bool {
    let count: Int = ArrayLength(kinds);
    if !sequence.ok || sequence.ready_node_count != count ||
        ArrayLength(sequence.roots) != 1 || sequence.roots[0] != root ||
        ArrayLength(lefts) != count || ArrayLength(rights) != count ||
        ArrayLength(targets) != count {
        return false;
    }
    let row: Int = 0;
    while row < count {
        if sequence.arena.topology.node_kinds[row] != kinds[row] ||
            sequence.arena.topology.left_children[row] != lefts[row] ||
            sequence.arena.topology.right_children[row] != rights[row] {
            return false;
        }
        if targets[row] == "" {
            if sequence.arena.call_target_kinds[row] !=
                    SemanticCallTargetNone() ||
                sequence.arena.call_target_names[row] != "" {
                return false;
            }
        } else if sequence.arena.call_target_kinds[row] !=
                SemanticCallTargetDirect() ||
            sequence.arena.call_target_names[row] != targets[row] {
            return false;
        }
        row = row + 1;
    }
    return true;
}

func DirectMirOptionStructProducerSomeShapeReady(
    ref sequence: MirExpressionGraphSequence
) -> Bool {
    return DirectMirOptionStructExactTopologyReady(sequence, [
        AstExpressionNodeLeaf(), AstExpressionNodeCall(),
        AstExpressionNodeLeaf(), AstExpressionNodeStructLiteral(),
        AstExpressionNodeStructFieldName(), AstExpressionNodeLeaf(),
        AstExpressionNodeStructFieldBinding(), AstExpressionNodeStructField(),
        AstExpressionNodeStructFieldName(), AstExpressionNodeLeaf(),
        AstExpressionNodeIntegerLiteral(), AstExpressionNodeAdd(),
        AstExpressionNodeStructFieldBinding(), AstExpressionNodeStructField(),
        AstExpressionNodeCallArgument()
    ], [0,0,0,2,0,0,4,3,0,0,0,9,8,7,1],
    [0,0,0,0,0,0,5,6,0,0,0,10,11,12,13],
    ["","Some","","","","","","","","","","","","",""], 14);
}

func DirectMirOptionStructLiteralSomeShapeReady(
    ref sequence: MirExpressionGraphSequence
) -> Bool {
    return DirectMirOptionStructExactTopologyReady(sequence, [
        AstExpressionNodeLeaf(), AstExpressionNodeCall(),
        AstExpressionNodeLeaf(), AstExpressionNodeStructLiteral(),
        AstExpressionNodeStructFieldName(), AstExpressionNodeIntegerLiteral(),
        AstExpressionNodeStructFieldBinding(), AstExpressionNodeStructField(),
        AstExpressionNodeStructFieldName(), AstExpressionNodeIntegerLiteral(),
        AstExpressionNodeStructFieldBinding(), AstExpressionNodeStructField(),
        AstExpressionNodeCallArgument()
    ], [0,0,0,2,0,0,4,3,0,0,8,7,1],
    [0,0,0,0,0,0,5,6,0,0,9,10,11],
    ["","Some","","","","","","","","","","",""], 12);
}

func DirectMirOptionStructNoneShapeReady(
    ref sequence: MirExpressionGraphSequence
) -> Bool {
    return DirectMirOptionStructExactTopologyReady(
        sequence, [AstExpressionNodeLeaf()], [0], [0], [""], 0
    ) && sequence.arena.node_texts[0] == "None";
}

func DirectMirOptionStructUnwrapShapeReady(
    ref sequence: MirExpressionGraphSequence
) -> Bool {
    return DirectMirOptionStructExactTopologyReady(sequence, [
        AstExpressionNodeLeaf(), AstExpressionNodeCall(),
        AstExpressionNodeLeaf(), AstExpressionNodeCallArgument()
    ], [0,0,0,1], [0,0,0,2], ["","UnwrapOption","",""], 3) &&
        sequence.arena.node_texts[0] == "UnwrapOption";
}

func DirectMirOptionStructSumShapeReady(
    ref sequence: MirExpressionGraphSequence
) -> Bool {
    return DirectMirOptionStructExactTopologyReady(sequence, [
        AstExpressionNodeLeaf(), AstExpressionNodeCall(),
        AstExpressionNodeLeaf(), AstExpressionNodeLeaf(),
        AstExpressionNodeMemberAccess(), AstExpressionNodeLeaf(),
        AstExpressionNodeLeaf(), AstExpressionNodeMemberAccess(),
        AstExpressionNodeAdd(), AstExpressionNodeCallArgument()
    ], [0,0,0,0,2,0,0,5,4,1], [0,0,0,0,3,0,0,6,7,8],
    ["","ToString","","","","","","","",""], 9) &&
        sequence.arena.node_texts[0] == "ToString";
}

func DirectMirOptionStructProducerCallShapeReady(
    ref sequence: MirExpressionGraphSequence, producer_name: String
) -> Bool {
    return producer_name != "" &&
        DirectMirOptionStructExactTopologyReady(sequence, [
            AstExpressionNodeLeaf(), AstExpressionNodeCall(),
            AstExpressionNodeIntegerLiteral(), AstExpressionNodeCallArgument()
        ], [0,0,0,1], [0,0,0,2], ["",producer_name,"",""], 3) &&
        sequence.arena.node_texts[0] == producer_name;
}

func DirectMirOptionStructChainedShapeReady(
    ref sequence: MirExpressionGraphSequence
) -> Bool {
    return DirectMirOptionStructExactTopologyReady(sequence, [
        AstExpressionNodeLeaf(), AstExpressionNodeCall(),
        AstExpressionNodeLeaf(), AstExpressionNodeCall(),
        AstExpressionNodeLeaf(), AstExpressionNodeCallArgument(),
        AstExpressionNodeLeaf(), AstExpressionNodeMemberAccess(),
        AstExpressionNodeCallArgument()
    ], [0,0,0,2,0,3,0,5,1], [0,0,0,0,0,4,0,6,7],
    ["","ToString","","UnwrapOption","","","","",""], 8) &&
        sequence.arena.node_texts[0] == "ToString" &&
        sequence.arena.node_texts[2] == "UnwrapOption";
}
