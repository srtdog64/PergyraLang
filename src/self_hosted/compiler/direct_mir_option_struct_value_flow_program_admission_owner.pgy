// Exclusive envelope for Option<nominal> return and value flow.

import "direct_mir_two_routine_nominal_program_admission_owner.pgy";

func DirectMirOptionStructValueFlowProgramEnvelopeReady(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    ref classification: DirectMirTwoRoutineNominalClassificationFact
) -> Bool {
    return classification.kind == DirectMirTwoRoutineNominalOption() &&
        DirectMirTwoRoutineNominalProgramEnvelopeReady(
            admitted, classification
        );
}
