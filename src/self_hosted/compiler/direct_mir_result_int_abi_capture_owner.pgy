// One-way projection from the admitted MIR layout into Result<Int> ABI facts.

import "direct_mir_result_int_abi_fact_owner.pgy";
import "../codegen/text/text_owner.pgy";

func DirectMirResultIntAbiFactFromCapture(
    own row: MirAbiLayoutRowCapture
) -> DirectMirResultIntAbiFact {
    let layout_id: Int = MirAbiLayoutIdFromCapture(row);
    if !row.valid || layout_id <= 0 ||
        row.type_name != CompilerAbiLayoutResultIntTypeName() ||
        row.size_text != "16" || row.align_text != "8" ||
        ArrayLength(row.field_names) != 3 ||
        ArrayLength(row.field_offsets) != 3 ||
        ArrayLength(row.field_sizes) != 3 ||
        ArrayLength(row.field_aligns) != 3 ||
        row.field_names[0] != "tag" || row.field_offsets[0] != "0" ||
        row.field_sizes[0] != "4" || row.field_aligns[0] != "4" ||
        row.field_names[1] != "ok" || row.field_offsets[1] != "4" ||
        row.field_sizes[1] != "4" || row.field_aligns[1] != "4" ||
        row.field_names[2] != "err" || row.field_offsets[2] != "8" ||
        row.field_sizes[2] != "8" || row.field_aligns[2] != "8" ||
        row.runtime_fn != "pgy_result_ok_Int" ||
        row.inner_c_type != "int32_t" || row.representation_text != "1" ||
        row.discriminant != "tag" || row.primary_tag_text != "0" ||
        row.secondary_tag_text != "1" || row.niche_none_pattern != "" {
        Die("direct MIR Result<Int> ABI layout is unsupported or mutated");
    }
    let fact: DirectMirResultIntAbiFact = DirectMirResultIntAbiFact(
        true, 0, layout_id, row.type_name, ToInt(row.size_text),
        ToInt(row.align_text), row.field_names[0],
        ToInt(row.field_offsets[0]), ToInt(row.field_sizes[0]),
        ToInt(row.field_aligns[0]), row.field_names[1],
        ToInt(row.field_offsets[1]), ToInt(row.field_sizes[1]),
        ToInt(row.field_aligns[1]), row.field_names[2],
        ToInt(row.field_offsets[2]), ToInt(row.field_sizes[2]),
        ToInt(row.field_aligns[2]), row.runtime_fn, row.inner_c_type,
        ToInt(row.representation_text), row.discriminant,
        row.primary_tag_text, row.secondary_tag_text,
        row.niche_none_pattern
    );
    let verified: DirectMirResultIntAbiFact =
        DirectMirResultIntAbiFactWithDigest(
            fact, DirectMirResultIntAbiFactDigest(fact));
    if !DirectMirResultIntAbiFactReady(verified) {
        Die("direct MIR Result<Int> ABI receipt identity is invalid");
    }
    return verified;
}
