// Ordered formal-parameter identity without an unsupported struct array ABI.

import "direct_mir_routine_param_fact_owner.pgy";

struct DirectMirRoutineParameterSetFact {
    let valid: Bool;
    let digest: Int;
    let names: Array<String>;
    let source_syntax_ids: Array<Int>;
    let type_names: Array<String>;
    let carriages: Array<String>;
    let resources: Array<String>;
    let pass_shapes: Array<String>;
    let abi_type_names: Array<String>;
    let abi_layout_ids: Array<Int>;
    let abi_required: Array<Bool>;
    let param_digests: Array<Int>;
    let first: DirectMirRoutineParamFact;
}

func DirectMirRoutineParameterSetFactInvalid(
) -> DirectMirRoutineParameterSetFact {
    let strings: Array<String> = [];
    let ints: Array<Int> = []; let bools: Array<Bool> = [];
    return DirectMirRoutineParameterSetFact(
        false, 0, strings, ints, strings, strings, strings, strings, strings,
        ints, bools, ints, InvalidDirectMirRoutineParamFact());
}

func DirectMirRoutineParameterSetFactDigest(
    ref fact: DirectMirRoutineParameterSetFact
) -> Int {
    if !fact.valid { return 0; }
    let hash: Long = DirectMirCfgHashInt(107L, ArrayLength(fact.names));
    let row: Int = 0;
    while row < ArrayLength(fact.names) {
        hash = DirectMirCfgHashInt(hash, row);
        hash = DirectMirCfgHashInt(hash, fact.param_digests[row]);
        row = row + 1;
    }
    return DirectMirCfgBoundedDigest(hash);
}

func DirectMirRoutineParameterSetFactReady(
    ref fact: DirectMirRoutineParameterSetFact
) -> Bool {
    let count: Int = ArrayLength(fact.names);
    if !fact.valid || fact.digest == 0 ||
        fact.digest != DirectMirRoutineParameterSetFactDigest(fact) ||
        count != ArrayLength(fact.type_names) ||
        count != ArrayLength(fact.source_syntax_ids) ||
        count != ArrayLength(fact.carriages) ||
        count != ArrayLength(fact.resources) ||
        count != ArrayLength(fact.pass_shapes) ||
        count != ArrayLength(fact.abi_type_names) ||
        count != ArrayLength(fact.abi_layout_ids) ||
        count != ArrayLength(fact.abi_required) ||
        count != ArrayLength(fact.param_digests) ||
        (count == 0 && fact.first.valid) ||
        (count > 0 && (!DirectMirRoutineParamFactReady(fact.first) ||
         fact.first.digest != fact.param_digests[0])) { return false; }
    let row: Int = 0;
    while row < count {
        if fact.names[row] == "" || fact.source_syntax_ids[row] <= 0 ||
            fact.type_names[row] == "" ||
            fact.carriages[row] == "" || fact.resources[row] == "" ||
            fact.pass_shapes[row] == "" ||
            fact.abi_type_names[row] != fact.type_names[row] ||
            (fact.abi_required[row] && fact.abi_layout_ids[row] <= 0) ||
            (!fact.abi_required[row] && fact.abi_layout_ids[row] != 0) ||
            fact.param_digests[row] !=
                DirectMirRoutineParamFactDigestFromFields(
                    fact.names[row], fact.source_syntax_ids[row],
                    fact.type_names[row],
                    fact.carriages[row], fact.resources[row],
                    fact.pass_shapes[row], fact.abi_type_names[row],
                    fact.abi_layout_ids[row], fact.abi_required[row]) {
            return false;
        }
        let prior: Int = 0;
        while prior < row {
            if fact.names[prior] == fact.names[row] ||
                fact.source_syntax_ids[prior] ==
                    fact.source_syntax_ids[row] { return false; }
            prior = prior + 1;
        }
        row = row + 1;
    }
    return true;
}

func DirectMirRoutineLocalParameterOrdinalAtName(
    ref fact: DirectMirRoutineParameterSetFact, name: String
) -> Int {
    if !DirectMirRoutineParameterSetFactReady(fact) || name == "" { return -1; }
    let row: Int = 0;
    while row < ArrayLength(fact.names) {
        if fact.names[row] == name {
            if (fact.carriages[row] != "value" &&
                    fact.carriages[row] != "value-result") ||
                fact.resources[row] != "none" ||
                fact.pass_shapes[row] != "direct" { return -1; }
            return row;
        }
        row = row + 1;
    }
    return -1;
}

func DirectMirRoutineValueParameterOrdinalAtName(
    ref fact: DirectMirRoutineParameterSetFact, name: String
) -> Int {
    let ordinal: Int = DirectMirRoutineLocalParameterOrdinalAtName(fact, name);
    if ordinal < 0 || fact.carriages[ordinal] != "value" { return -1; }
    return ordinal;
}

func DirectMirRoutineLocalParameterTypeAtName(
    ref fact: DirectMirRoutineParameterSetFact, name: String
) -> String {
    let ordinal: Int = DirectMirRoutineLocalParameterOrdinalAtName(fact, name);
    if ordinal >= 0 { return fact.type_names[ordinal]; }
    return "";
}

func DirectMirRoutineValueParameterTypeAtName(
    ref fact: DirectMirRoutineParameterSetFact, name: String
) -> String {
    let ordinal: Int = DirectMirRoutineValueParameterOrdinalAtName(fact, name);
    if ordinal >= 0 { return fact.type_names[ordinal]; }
    return "";
}
