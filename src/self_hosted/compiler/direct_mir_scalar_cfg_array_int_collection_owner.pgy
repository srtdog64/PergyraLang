// Empty local Array<Int> definition and canonical public ABI receipt.

import "direct_mir_array_int_abi_fact_owner.pgy";
import "direct_mir_array_literal_spine_owner.pgy";
import "direct_mir_scalar_cfg_collection_definition_owner.pgy";
import "direct_mir_scalar_graph_admission_owner.pgy";

struct DirectMirScalarCfgArrayIntCollectionFact {
    let valid: Bool;
    let definition_global_row: Int;
    let collection_value_id: String;
    let collection_name: String;
    let storage_identity: String;
    let abi_layout_id: Int;
    let abi_size: Int;
    let abi_align: Int;
    let data_offset: Int;
    let length_offset: Int;
    let capacity_offset: Int;
    let allocator_offset: Int;
}

func DirectMirScalarCfgArrayIntCollectionFactEmpty(
) -> DirectMirScalarCfgArrayIntCollectionFact {
    return DirectMirScalarCfgArrayIntCollectionFact(
        false, -1, "", "", "", 0, 0, 0, 0, 0, 0, 0
    );
}

func DirectMirScalarCfgArrayIntCollectionFactReady(
    ref fact: DirectMirScalarCfgArrayIntCollectionFact
) -> Bool {
    let layout: DirectMirArrayStorageLayoutContract =
        DirectMirArrayStorageLayoutContractFact();
    return fact.valid && fact.definition_global_row >= 0 &&
        fact.collection_value_id != "" && fact.collection_name != "" &&
        fact.storage_identity == Concat(
            "local-array:", fact.collection_value_id
        ) && DirectMirArrayStorageLayoutContractReady(layout) &&
        fact.abi_layout_id > 0 && fact.abi_size == layout.size &&
        fact.abi_align == layout.align &&
        fact.data_offset == layout.data_offset &&
        fact.length_offset == layout.length_offset &&
        fact.capacity_offset == layout.capacity_offset &&
        fact.allocator_offset == layout.allocator_offset;
}

func DirectMirScalarCfgArrayIntCollectionFromOwners(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    ref index: MirRoutineFactIndex,
    ref use_facts: MirRoutineInstructionUseFacts,
    ref wire: DirectMirScalarCfgWireLocalRefs,
    definition: MirRoutineResultDefinitionFact,
    declaration: MirRoutineInstructionScalarCapture
) -> DirectMirScalarCfgArrayIntCollectionFact {
    let invalid: DirectMirScalarCfgArrayIntCollectionFact =
        DirectMirScalarCfgArrayIntCollectionFactEmpty();
    if !DirectMirScalarCfgCollectionDefinitionReady(
        admitted, index, use_facts, wire, definition, declaration,
        declaration.result, declaration.arg0
    ) || declaration.abi_type_name !=
            CompilerAbiLayoutArrayIntTypeName() { return invalid; }
    let abi_opt: Option<MirAbiLayoutRowCapture> =
        MirCapturedRequiredAbiLayoutRowAdmission(
            admitted.routines.source_json, declaration.abi_type_name,
            declaration.abi_type_value_ready, declaration.abi_type_start,
            declaration.abi_type_end, declaration.abi_layout_id_start,
            declaration.abi_layout_id_end,
            declaration.abi_layout_required_start,
            declaration.abi_layout_required_end,
            declaration.abi_layout_start, declaration.abi_layout_end
        );
    if !IsSome(abi_opt) { return invalid; }
    let abi: MirAbiLayoutRowCapture = UnwrapOption(abi_opt);
    if !DirectMirArrayIntCapturedAbiReady(abi) { return invalid; }
    let expression: MirProgramInstructionExpressionFact =
        MirProgramInstructionExpressionIndexAt(
            admitted.routines.instruction_expressions,
            definition.global_row
        );
    let graph: MirExpressionGraphSequence =
        DirectMirArrayIntGraphFromExpressionFact(
            admitted.routines.source_json, expression, 0
        );
    if !DirectMirArrayLiteralEmptyReady(graph) { return invalid; }
    let fact: DirectMirScalarCfgArrayIntCollectionFact =
        DirectMirScalarCfgArrayIntCollectionFact(
            true, definition.global_row, declaration.result,
            declaration.arg0, Concat("local-array:", declaration.result),
            MirAbiLayoutIdFromCapture(abi), ToInt(abi.size_text),
            ToInt(abi.align_text), ToInt(abi.field_offsets[0]),
            ToInt(abi.field_offsets[1]), ToInt(abi.field_offsets[2]),
            ToInt(abi.field_offsets[3])
        );
    if !DirectMirScalarCfgArrayIntCollectionFactReady(fact) {
        return invalid;
    }
    return fact;
}
