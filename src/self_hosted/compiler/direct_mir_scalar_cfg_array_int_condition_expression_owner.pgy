// Current-length condition projected from the sealed Array<Int> receipt.
import "direct_mir_scalar_cfg_array_int_program_fact_owner.pgy";
import "direct_mir_scalar_cfg_expression_owner.pgy";
import "direct_mir_scalar_cfg_array_int_read_only_expression_owner.pgy";
func DirectMirScalarCfgArrayIntLengthConditionFact(
    ref fact: DirectMirScalarCfgArrayIntProgramFact, global_row: Int
) -> DirectMirScalarCfgExpressionFact {
    let read_only: DirectMirScalarCfgExpressionFact =
        DirectMirScalarCfgArrayIntReadOnlyConditionFact(
            fact.read_only, global_row
        );
    if read_only.valid { return read_only; }
    if !fact.valid || global_row != fact.consumer.length_global_row {
        return DirectMirScalarCfgExpressionFactEmpty();
    }
    return DirectMirScalarCfgExpressionFact(
        true, DirectMirScalarCfgConditionLess(),
        fact.consumer.index_value_row, -1, -1, -1, "", ""
    );
}
