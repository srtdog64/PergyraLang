// Condition block roles derived from the sealed Array<Int> receipt.

import "direct_mir_scalar_cfg_graph_fact_owner.pgy";
import "direct_mir_scalar_cfg_range_set_owner.pgy";

func DirectMirScalarCfgArrayIntReadOnlyRangeAtPlan(
    ref plan: DirectMirScalarCfgGraphPlan
) -> DirectMirScalarCfgRangeIterationFact {
    if !plan.array_int_program.valid ||
        !plan.array_int_program.read_only.valid {
        return DirectMirScalarCfgRangeIterationFactEmpty();
    }
    return DirectMirScalarCfgRangeFactAtLoopSyntaxId(
        plan.range_iterations,
        plan.array_int_program.read_only.loop_syntax_id
    );
}

func DirectMirScalarCfgArrayIntLengthConditionBlock(
    ref plan: DirectMirScalarCfgGraphPlan, block: Int
) -> Bool {
    if plan.array_int_program.valid &&
        plan.array_int_program.consumer.valid &&
        block == plan.array_int_program.consumer.header_block { return true; }
    let range: DirectMirScalarCfgRangeIterationFact =
        DirectMirScalarCfgArrayIntReadOnlyRangeAtPlan(plan);
    return range.valid && block == range.header_block;
}

func DirectMirScalarCfgArrayIntIndexedConditionBlock(
    ref plan: DirectMirScalarCfgGraphPlan, block: Int
) -> Bool {
    return plan.array_int_program.valid &&
        plan.array_int_program.read_only.valid &&
        block == plan.array_int_program.read_only.condition_block;
}

func DirectMirScalarCfgArrayIntConditionBlock(
    ref plan: DirectMirScalarCfgGraphPlan, block: Int
) -> Bool {
    return DirectMirScalarCfgArrayIntLengthConditionBlock(plan, block) ||
        DirectMirScalarCfgArrayIntIndexedConditionBlock(plan, block);
}
