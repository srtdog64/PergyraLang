// Shared accumulator-phi readiness for Array<Int> indexed-sum consumers.

import "direct_mir_scalar_cfg_array_int_loop_mutation_fact_owner.pgy";
import "direct_mir_scalar_cfg_while_induction_owner.pgy";

func DirectMirScalarCfgArrayIntSumPhiReady(
    ref plan: DirectMirScalarCfgGraphPlan,
    ref fact: DirectMirScalarCfgArrayIntLoopMutationFact
) -> Bool {
    let phi: Int = DirectMirScalarCfgResultOperation(
        plan, fact.consumer.sum_left_value_row
    );
    if phi < 0 || plan.operation_kinds[phi] !=
            DirectMirScalarCfgOpPhiInt() ||
        DirectMirScalarCfgOperationBlock(plan, phi) !=
            fact.consumer.header_block ||
        plan.operation_phi_counts[phi] != 2 { return false; }
    let zero: Int = 0; let recurrence: Int = 0; let incoming: Int = 0;
    while incoming < plan.operation_phi_counts[phi] {
        let value: Int = plan.phi_incoming_values[
            plan.operation_phi_starts[phi] + incoming
        ];
        let operation: Int = DirectMirScalarCfgResultOperation(plan, value);
        if operation < 0 || plan.value_local_rows[value] !=
                plan.value_local_rows[fact.consumer.sum_left_value_row] {
            return false;
        }
        if plan.operation_kinds[operation] ==
                DirectMirScalarCfgOpConstInt() &&
            plan.operation_left_literals[operation] == "0" {
            zero = zero + 1;
        } else if operation == fact.consumer.read_operation_row &&
            value == fact.consumer.read_result_value_row {
            recurrence = recurrence + 1;
        } else { return false; }
        incoming = incoming + 1;
    }
    return zero == 1 && recurrence == 1;
}
