// Scalar-CFG expression rows projected from the sealed Array<Int> receipt.

import "direct_mir_scalar_cfg_array_int_program_fact_owner.pgy";
import "direct_mir_scalar_cfg_expression_owner.pgy";
import "direct_mir_scalar_cfg_array_int_condition_expression_owner.pgy";
import "direct_mir_scalar_cfg_array_int_read_only_expression_owner.pgy";
import "direct_mir_scalar_cfg_array_int_reverse_expression_owner.pgy";
import "direct_mir_scalar_cfg_array_int_mutating_expression_owner.pgy";

func DirectMirScalarCfgArrayIntExpressionFact(
    ref fact: DirectMirScalarCfgArrayIntProgramFact, global_row: Int
) -> DirectMirScalarCfgExpressionFact {
    if !fact.valid { return DirectMirScalarCfgExpressionFactEmpty(); }
    let read_only: DirectMirScalarCfgExpressionFact =
        DirectMirScalarCfgArrayIntReadOnlyExpressionFact(
            fact.read_only, global_row
        );
    if read_only.valid { return read_only; }
    let reverse: DirectMirScalarCfgExpressionFact =
        DirectMirScalarCfgArrayIntReverseExpressionFact(
            fact.reverse, global_row
        );
    if reverse.valid { return reverse; }
    return DirectMirScalarCfgArrayIntMutatingExpressionFact(fact, global_row);
}
