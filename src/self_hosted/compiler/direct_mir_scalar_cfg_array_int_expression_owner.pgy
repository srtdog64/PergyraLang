// Scalar-CFG expression rows projected from the sealed Array<Int> receipt.

import "direct_mir_scalar_cfg_array_int_loop_mutation_fact_owner.pgy";
import "direct_mir_scalar_cfg_expression_owner.pgy";

func DirectMirScalarCfgArrayIntExpressionFact(
    ref fact: DirectMirScalarCfgArrayIntLoopMutationFact, global_row: Int
) -> DirectMirScalarCfgExpressionFact {
    if !fact.valid { return DirectMirScalarCfgExpressionFactEmpty(); }
    if global_row == fact.producer.push_global_row {
        return DirectMirScalarCfgExpressionFact(
            true, DirectMirScalarCfgOpArrayPushInt(),
            fact.producer.induction_value_row,
            fact.producer.induction_value_row, -1, -1, "", ""
        );
    }
    if global_row == fact.consumer.read_global_row {
        return DirectMirScalarCfgExpressionFact(
            true, DirectMirScalarCfgOpAddArrayReadInt(),
            fact.consumer.sum_left_value_row,
            fact.consumer.index_value_row, -1, -1, "", ""
        );
    }
    if global_row == fact.consumer.length_log_global_row {
        return DirectMirScalarCfgExpressionFact(
            true, DirectMirScalarCfgOpLogArrayLength(),
            -1, -1, -1, -1, "", ""
        );
    }
    return DirectMirScalarCfgExpressionFactEmpty();
}

func DirectMirScalarCfgArrayIntLengthConditionFact(
    ref fact: DirectMirScalarCfgArrayIntLoopMutationFact, global_row: Int
) -> DirectMirScalarCfgExpressionFact {
    if !fact.valid || global_row != fact.consumer.length_global_row {
        return DirectMirScalarCfgExpressionFactEmpty();
    }
    return DirectMirScalarCfgExpressionFact(
        true, DirectMirScalarCfgConditionLess(),
        fact.consumer.index_value_row, -1, -1, -1, "", ""
    );
}
