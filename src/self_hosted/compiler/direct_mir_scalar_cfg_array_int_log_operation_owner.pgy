// Operation ownership for Array<Int> length observations across all modes.

import "direct_mir_scalar_cfg_array_int_program_fact_owner.pgy";

func DirectMirScalarCfgArrayIntOwnsLengthLogOperation(
    ref fact: DirectMirScalarCfgArrayIntProgramFact, operation: Int
) -> Bool {
    if !fact.valid { return false; }
    if operation == fact.consumer.length_log_operation_row { return true; }
    let row: Int = 0;
    while row < ArrayLength(fact.reverse.log_operation_rows) {
        if fact.reverse.log_operation_rows[row] == operation &&
            fact.reverse.log_kinds[row] ==
                DirectMirScalarCfgArrayIntReverseLengthLog() { return true; }
        row = row + 1;
    }
    return fact.pop.length_log_operation_row == operation;
}
