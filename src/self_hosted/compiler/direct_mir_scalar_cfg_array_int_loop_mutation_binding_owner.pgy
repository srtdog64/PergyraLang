// Bind source Array<Int> identities to sealed value and operation rows.

import "direct_mir_scalar_cfg_array_int_loop_mutation_fact_owner.pgy";
import "direct_mir_scalar_cfg_graph_fact_owner.pgy";

func DirectMirScalarCfgArrayIntLoopMutationAtValueRows(
    fact: DirectMirScalarCfgArrayIntLoopMutationFact,
    value_names: Array<String>
) -> DirectMirScalarCfgArrayIntLoopMutationFact {
    if !fact.valid { return fact; }
    let induction: Int = DirectMirScalarCfgGraphValueRow(
        value_names, fact.producer.induction_value_id
    );
    let index: Int = DirectMirScalarCfgGraphValueRow(
        value_names, fact.consumer.index_value_id
    );
    let sum: Int = DirectMirScalarCfgGraphValueRow(
        value_names, fact.consumer.sum_left_value_id
    );
    let result: Int = DirectMirScalarCfgGraphValueRow(
        value_names, fact.consumer.read_result_value_id
    );
    if induction < 0 || index < 0 || sum < 0 || result < 0 {
        return DirectMirScalarCfgArrayIntLoopMutationFactEmpty();
    }
    return DirectMirScalarCfgArrayIntLoopMutationFact(
        true, fact.collection,
        DirectMirScalarCfgArrayIntProducerFact(
            true, fact.producer.header_block, fact.producer.body_block,
            fact.producer.exit_block, fact.producer.bound,
            fact.producer.push_global_row, fact.producer.push_value_kind,
            fact.producer.induction_value_id, induction, -1
        ),
        DirectMirScalarCfgArrayIntConsumerFact(
            true, fact.consumer.header_block, fact.consumer.body_block,
            fact.consumer.exit_block, fact.consumer.length_global_row,
            fact.consumer.read_global_row,
            fact.consumer.length_log_global_row,
            fact.consumer.index_value_id, index,
            fact.consumer.sum_left_value_id, sum,
            fact.consumer.read_result_value_id, result, -1, -1
        )
    );
}

func DirectMirScalarCfgArrayIntLoopMutationAtOperation(
    fact: DirectMirScalarCfgArrayIntLoopMutationFact,
    global_row: Int, operation_row: Int
) -> DirectMirScalarCfgArrayIntLoopMutationFact {
    if !fact.valid || operation_row < 0 { return fact; }
    let push: Int = fact.producer.push_operation_row;
    let read: Int = fact.consumer.read_operation_row;
    let length_log: Int = fact.consumer.length_log_operation_row;
    if global_row == fact.producer.push_global_row { push = operation_row; }
    else if global_row == fact.consumer.read_global_row {
        read = operation_row;
    } else if global_row == fact.consumer.length_log_global_row {
        length_log = operation_row;
    } else { return fact; }
    return DirectMirScalarCfgArrayIntLoopMutationFact(
        true, fact.collection,
        DirectMirScalarCfgArrayIntProducerFact(
            true, fact.producer.header_block, fact.producer.body_block,
            fact.producer.exit_block, fact.producer.bound,
            fact.producer.push_global_row, fact.producer.push_value_kind,
            fact.producer.induction_value_id,
            fact.producer.induction_value_row, push
        ),
        DirectMirScalarCfgArrayIntConsumerFact(
            true, fact.consumer.header_block, fact.consumer.body_block,
            fact.consumer.exit_block, fact.consumer.length_global_row,
            fact.consumer.read_global_row,
            fact.consumer.length_log_global_row,
            fact.consumer.index_value_id, fact.consumer.index_value_row,
            fact.consumer.sum_left_value_id,
            fact.consumer.sum_left_value_row,
            fact.consumer.read_result_value_id,
            fact.consumer.read_result_value_row, read, length_log
        )
    );
}
