// Exact Array<Int>-owned operation inventory for inactive program receipts.
import "direct_mir_scalar_cfg_graph_fact_owner.pgy";
import "direct_mir_scalar_cfg_collection_plan_array_int_absence_owner.pgy";

func DirectMirScalarCfgArrayIntOwnedOperationKind(kind: Int) -> Bool {
    return kind == DirectMirScalarCfgOpArrayPushInt() ||
        kind == DirectMirScalarCfgOpAddArrayReadInt() ||
        kind == DirectMirScalarCfgOpArraySetInt() ||
        kind == DirectMirScalarCfgOpLogArrayIndexInt() ||
        kind == DirectMirScalarCfgOpArrayReadInt() ||
        kind == DirectMirScalarCfgOpArrayReverseInt() ||
        kind == DirectMirScalarCfgOpArrayPopInt();
}

func DirectMirScalarCfgArrayIntOwnedOperationsAbsent(
    ref plan: DirectMirScalarCfgGraphPlan
) -> Bool {
    let row: Int = 0;
    while row < ArrayLength(plan.operation_kinds) {
        if DirectMirScalarCfgArrayIntOwnedOperationKind(
                plan.operation_kinds[row]
            ) {
            if !DirectMirScalarCfgCollectionClaimsArrayIntOperation(
                plan, row
            ) { return false; }
        }
        row = row + 1;
    }
    return true;
}
