// C effects over the foreach-owned Array<Int> storage identity.

import "direct_mir_scalar_cfg_array_int_pop_foreach_owner.pgy";
import "direct_mir_scalar_cfg_array_int_pop_lookup_owner.pgy";
import "direct_mir_scalar_cfg_c_collection_operation_fact_owner.pgy";

func DirectMirScalarCfgArrayIntPopCOperation(
    ref plan: DirectMirScalarCfgGraphPlan, operation: Int,
    formatted_print: CompilerRuntimeCallAbiFact,
    int_line_format: String, int_c_type: String
) -> DirectMirScalarCfgCCollectionOperationEmission {
    if plan.array_int_program.mode !=
            DirectMirScalarCfgArrayIntForEachPrefixPopMode() {
        return DirectMirScalarCfgCCollectionOperationEmission(false, "");
    }
    let foreach_row: Int = DirectMirScalarCfgArrayIntPopForEachRowAtLoop(
        plan.foreach_iterations,
        plan.array_int_program.pop.foreach_loop_syntax_id
    );
    let storage_row: Int = DirectMirScalarCfgForEachStorageRow(
        plan.foreach_iterations, foreach_row
    );
    if storage_row < 0 {
        Die("direct MIR Array<Int> pop C storage is missing");
    }
    let name: String = Concat(
        "pgy_foreach_collection_", ToString(storage_row)
    );
    if DirectMirScalarCfgArrayIntPopOperationRow(plan.array_int_program.pop,
            operation) >= 0 {
        let output: String = Concat("    ", Concat(name, ".length = "));
        return DirectMirScalarCfgCCollectionOperationEmission(
            true, Concat(output, Concat(name, ".length - 1;\n"))
        );
    }
    if operation == plan.array_int_program.pop.length_log_operation_row {
        let output: String = Concat("    ", formatted_print.symbol);
        output = Concat(output, Concat("(\"", int_line_format));
        output = Concat(output, Concat("\", (", int_c_type));
        return DirectMirScalarCfgCCollectionOperationEmission(
            true, Concat(output, Concat(")", Concat(name, ".length);\n")))
        );
    }
    return DirectMirScalarCfgCCollectionOperationEmission(false, "");
}
