// Cross-owner closure for foreach storage and Array<Int> prefix-pop effects.

import "direct_mir_scalar_cfg_array_int_foreach_view_owner.pgy";
import "direct_mir_scalar_cfg_array_int_pop_lookup_owner.pgy";
import "direct_mir_scalar_cfg_array_int_operation_absence_owner.pgy";
import "direct_mir_scalar_cfg_foreach_set_owner.pgy";
import "direct_mir_scalar_cfg_operation_position_owner.pgy";

func DirectMirScalarCfgArrayIntPopCollectionMatchesForEach(
    ref collection: DirectMirScalarCfgArrayIntCollectionFact,
    ref foreach: DirectMirScalarCfgForEachFact
) -> Bool {
    if !collection.valid || !foreach.valid ||
        collection.definition_global_row != foreach.definition_global_row ||
        collection.collection_value_id != foreach.collection_value_id ||
        collection.collection_name != foreach.collection_name ||
        collection.storage_identity != foreach.storage_identity ||
        collection.abi_layout_id != foreach.abi_layout_id ||
        collection.abi_size != foreach.abi_size ||
        collection.abi_align != foreach.abi_align ||
        collection.data_offset != foreach.data_offset ||
        collection.length_offset != foreach.length_offset ||
        collection.capacity_offset != foreach.capacity_offset ||
        collection.allocator_offset != foreach.allocator_offset ||
        ArrayLength(collection.elements) != ArrayLength(foreach.elements) {
        return false;
    }
    let row: Int = 0;
    while row < ArrayLength(collection.elements) {
        if collection.elements[row] != foreach.elements[row] { return false; }
        row = row + 1;
    }
    return true;
}

func DirectMirScalarCfgArrayIntPopReady(
    ref plan: DirectMirScalarCfgGraphPlan
) -> Bool {
    let foreach: DirectMirScalarCfgForEachFact =
        DirectMirScalarCfgForEachFactAtLoopSyntaxId(
            plan.foreach_iterations, plan.array_int_program.pop.foreach_loop_syntax_id
        );
    let count: Int = ArrayLength(plan.array_int_program.pop.global_rows);
    if !plan.array_int_program.valid || plan.array_int_program.mode !=
            DirectMirScalarCfgArrayIntForEachPrefixPopMode() ||
        !DirectMirScalarCfgArrayIntCollectionFactReady(plan.array_int_program.collection) ||
        plan.array_int_program.producer.valid || plan.array_int_program.consumer.valid || plan.array_int_program.static_mutation.valid ||
        !DirectMirScalarCfgArrayIntReadOnlyAbsent(plan.array_int_program.read_only) ||
        !DirectMirScalarCfgArrayIntReverseAbsent(plan.array_int_program.reverse) ||
        !plan.array_int_program.pop.valid || count < 1 ||
        count != ArrayLength(plan.array_int_program.pop.operation_rows) ||
        count != ArrayLength(plan.array_int_program.pop.expected_lengths_before) ||
        count > ArrayLength(plan.array_int_program.collection.elements) ||
        plan.array_int_program.pop.length_log_global_row < 0 ||
        plan.array_int_program.pop.length_log_operation_row < 0 ||
        !DirectMirScalarCfgArrayIntPopCollectionMatchesForEach(
            plan.array_int_program.collection, foreach
        ) || foreach.loop_syntax_id != plan.array_int_program.pop.foreach_loop_syntax_id {
        return false;
    }
    let prior_operation: Int = -1;
    let row: Int = 0;
    while row < count {
        let operation: Int = plan.array_int_program.pop.operation_rows[row];
        if plan.array_int_program.pop.global_rows[row] < 0 ||
            plan.array_int_program.pop.global_rows[row] >= foreach.init_global_row ||
            plan.array_int_program.pop.expected_lengths_before[row] !=
                ArrayLength(plan.array_int_program.collection.elements) - row ||
            operation <= prior_operation || operation < 0 ||
            operation >= ArrayLength(plan.operation_kinds) ||
            plan.operation_kinds[operation] !=
                DirectMirScalarCfgOpArrayPopInt() ||
            plan.operation_result_values[operation] != -1 ||
            plan.operation_left_values[operation] != -1 ||
            plan.operation_right_values[operation] != -1 ||
            plan.operation_left_locals[operation] != -1 ||
            plan.operation_right_locals[operation] != -1 ||
            plan.operation_left_literals[operation] != "" ||
            plan.operation_right_literals[operation] != "" ||
            DirectMirScalarCfgOperationBlock(plan, operation) !=
                foreach.init_block {
            return false;
        }
        let prior: Int = 0;
        while prior < row {
            if plan.array_int_program.pop.global_rows[prior] == plan.array_int_program.pop.global_rows[row] { return false; }
            prior = prior + 1;
        }
        prior_operation = operation;
        row = row + 1;
    }
    if plan.array_int_program.pop.length_log_global_row <= foreach.branch_global_row ||
        plan.array_int_program.pop.length_log_operation_row <= prior_operation ||
        plan.array_int_program.pop.length_log_operation_row >= ArrayLength(plan.operation_kinds) ||
        plan.operation_kinds[plan.array_int_program.pop.length_log_operation_row] !=
            DirectMirScalarCfgOpLogArrayLength() ||
        plan.operation_result_values[plan.array_int_program.pop.length_log_operation_row] != -1 ||
        DirectMirScalarCfgOperationBlock(
            plan, plan.array_int_program.pop.length_log_operation_row
        ) != foreach.exit_block { return false; }
    let owned_pop_count: Int = 0;
    row = 0;
    while row < ArrayLength(plan.operation_kinds) {
        if plan.operation_kinds[row] == DirectMirScalarCfgOpArrayPopInt() {
            if DirectMirScalarCfgArrayIntPopOperationRow(
                plan.array_int_program.pop, row) < 0 {
                return false;
            }
            owned_pop_count = owned_pop_count + 1;
        }
        row = row + 1;
    }
    return owned_pop_count == count;
}
