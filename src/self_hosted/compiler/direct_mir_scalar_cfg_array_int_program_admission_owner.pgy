// Exclusive source admission for one Array<Int> program receipt.

import "direct_mir_scalar_cfg_array_int_collection_admission_owner.pgy";
import "direct_mir_scalar_cfg_array_int_source_identity_owner.pgy";
import "direct_mir_scalar_cfg_array_int_dynamic_push_admission_owner.pgy";
import "direct_mir_scalar_cfg_array_int_static_mutation_admission_owner.pgy";
import "direct_mir_scalar_cfg_array_int_read_only_admission_owner.pgy";
import "direct_mir_scalar_cfg_array_int_reverse_admission_owner.pgy";
import "direct_mir_scalar_cfg_array_int_reverse_graph_owner.pgy";
import "direct_mir_scalar_cfg_array_int_mode_owner.pgy";
import "direct_mir_scalar_cfg_array_int_pop_admission_owner.pgy";
import "direct_mir_scalar_cfg_instruction_graph_owner.pgy";
import "direct_mir_scalar_cfg_foreach_set_owner.pgy";

func DirectMirScalarCfgArrayIntProgramFromOwners(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    ref index: MirRoutineFactIndex,
    ref uses: MirRoutineInstructionUseFacts,
    ref wire: DirectMirScalarCfgWireLocalRefs,
    ref foreaches: DirectMirScalarCfgForEachFactSet,
    ref ranges: DirectMirScalarCfgRangeFactSet
) -> DirectMirScalarCfgArrayIntProgramFact {
    let empty: DirectMirScalarCfgArrayIntProgramFact =
        DirectMirScalarCfgArrayIntProgramFactEmpty();
    let foreach_pop: DirectMirScalarCfgArrayIntProgramFact =
        DirectMirScalarCfgArrayIntForEachPopFromOwners(
            admitted, index, uses, foreaches
        );
    if foreach_pop.valid { return foreach_pop; }
    let collection: DirectMirScalarCfgArrayIntCollectionFact =
        DirectMirScalarCfgArrayIntCollectionFactEmpty();
    let reverse_count: Int = 0;
    let instruction: Int = 0;
    while instruction < ArrayLength(index.instruction_facts.starts) {
        let global: Int = index.instruction_facts.global_start + instruction;
        let declaration: MirRoutineInstructionScalarCapture =
            MirRoutineInstructionFactBundleAtGlobal(
                index.instruction_facts, global
            );
        if admitted.routines.instruction_kinds[global] == "def" &&
            !DirectMirScalarCfgForEachOwnsDefinition(foreaches, global) &&
            declaration.valid && declaration.abi_type_name ==
                CompilerAbiLayoutArrayIntTypeName() {
            let object_table: JsonObjectFactTable = JsonObjectFactTableFromBounds(
                admitted.routines.source_json,
                admitted.routines.instruction_starts[global],
                admitted.routines.instruction_ends[global]
            );
            let graph: MirExpressionGraphSequence =
                DirectMirScalarCfgInstructionGraphAt(object_table, "expr0_graph");
            if DirectMirScalarCfgArrayIntReverseCallGraphFactFrom(
                    graph
                ).valid {
                reverse_count = reverse_count + 1;
            } else {
                if collection.valid {
                    Die("direct MIR scalar CFG Array<Int> source is ambiguous");
                }
                let definition: MirRoutineResultDefinitionFact =
                    MirRoutineFactIndexUniqueResultDefinition(
                        index, declaration.result
                    );
                collection = DirectMirScalarCfgArrayIntCollectionFromOwners(
                    admitted, index, uses, wire, definition, declaration
                );
                if !DirectMirScalarCfgArrayIntCollectionFactReady(collection) ||
                    !DirectMirScalarCfgArrayIntSourceLocalReady(
                        index, collection.collection_name
                    ) {
                    Die("direct MIR scalar CFG Array<Int> source is invalid");
                }
            }
        }
        instruction = instruction + 1;
    }
    if reverse_count > 1 {
        Die("direct MIR scalar CFG ArrayReverse owner is ambiguous");
    }
    if !collection.valid { return empty; }
    if reverse_count == 1 {
        let program: DirectMirScalarCfgArrayIntProgramFact =
            DirectMirScalarCfgArrayIntReverseFromOwners(
                admitted, index, uses, collection
            );
        if !program.valid {
            Die("direct MIR scalar CFG ArrayReverse admission is invalid");
        }
        return program;
    }
    if ArrayLength(collection.elements) > 0 {
        let mode: Int = DirectMirScalarCfgArrayIntInitializedModeFromOwners(
            index, uses, collection.collection_value_id, ranges
        );
        if mode == DirectMirScalarCfgArrayIntStaticSetMode() {
            let program: DirectMirScalarCfgArrayIntProgramFact =
                DirectMirScalarCfgArrayIntStaticMutationFromOwners(
                    admitted, index, uses, collection
                );
            if !program.valid {
                Die("direct MIR scalar CFG static Array<Int> admission is invalid");
            }
            return program;
        }
        if mode == DirectMirScalarCfgArrayIntReadOnlyInitializedMode() {
            let program: DirectMirScalarCfgArrayIntProgramFact =
                DirectMirScalarCfgArrayIntReadOnlyRangeFromOwners(
                    admitted, index, uses, collection, ranges
                );
            if !program.valid {
                Die("direct MIR scalar CFG read-only Array<Int> admission is invalid");
            }
            return program;
        }
        Die("direct MIR scalar CFG initialized Array<Int> mode is invalid");
    }
    let program: DirectMirScalarCfgArrayIntProgramFact =
        DirectMirScalarCfgArrayIntDynamicPushFromOwners(
            admitted, index, uses, wire, collection
        );
    if !program.valid {
        Die("direct MIR scalar CFG dynamic Array<Int> admission is invalid");
    }
    return program;
}
