// Bind source Array<Int> identities to sealed value and operation rows.

import "direct_mir_scalar_cfg_array_int_program_fact_owner.pgy";
import "direct_mir_scalar_cfg_graph_fact_owner.pgy";
import "direct_mir_scalar_cfg_array_int_operation_binding_owner.pgy";
import "direct_mir_scalar_cfg_array_int_read_only_binding_owner.pgy";

func DirectMirScalarCfgArrayIntProgramAtValueRows(
    fact: DirectMirScalarCfgArrayIntProgramFact,
    value_names: Array<String>,
    ref ranges: DirectMirScalarCfgRangeFactSet
) -> DirectMirScalarCfgArrayIntProgramFact {
    if !fact.valid || fact.mode == DirectMirScalarCfgArrayIntForEachPrefixPopMode() || fact.mode == DirectMirScalarCfgArrayIntFreshReverseMode() { return fact; }
    if fact.mode == DirectMirScalarCfgArrayIntReadOnlyInitializedMode() {
        let read_only: DirectMirScalarCfgArrayIntReadOnlyRangeFact =
            DirectMirScalarCfgArrayIntReadOnlyAtValueRows(
                fact.read_only, value_names, ranges
            );
        if !read_only.valid {
            return DirectMirScalarCfgArrayIntProgramFactEmpty();
        }
        return DirectMirScalarCfgArrayIntProgramFact(
            true, fact.mode, fact.collection,
            DirectMirScalarCfgArrayIntProducerFactEmpty(),
            fact.consumer, fact.static_mutation, read_only, fact.reverse,
            fact.pop
        );
    }
    let induction: Int = -1;
    if fact.producer.valid {
        induction = DirectMirScalarCfgGraphValueRow(
            value_names, fact.producer.induction_value_id
        );
    }
    let index: Int = DirectMirScalarCfgGraphValueRow(
        value_names, fact.consumer.index_value_id
    );
    let sum: Int = DirectMirScalarCfgGraphValueRow(
        value_names, fact.consumer.sum_left_value_id
    );
    let result: Int = DirectMirScalarCfgGraphValueRow(
        value_names, fact.consumer.read_result_value_id
    );
    if (fact.producer.valid && induction < 0) ||
        index < 0 || sum < 0 || result < 0 {
        return DirectMirScalarCfgArrayIntProgramFactEmpty();
    }
    let producer: DirectMirScalarCfgArrayIntProducerFact =
        DirectMirScalarCfgArrayIntProducerFactEmpty();
    if fact.producer.valid {
        producer = DirectMirScalarCfgArrayIntProducerFact(
            true, fact.producer.header_block, fact.producer.body_block,
            fact.producer.exit_block, fact.producer.bound,
            fact.producer.push_global_row, fact.producer.push_value_kind,
            fact.producer.induction_value_id, induction, -1
        );
    }
    return DirectMirScalarCfgArrayIntProgramFact(
        true, fact.mode, fact.collection, producer,
        DirectMirScalarCfgArrayIntConsumerFact(
            true, fact.consumer.header_block, fact.consumer.body_block,
            fact.consumer.exit_block, fact.consumer.length_global_row,
            fact.consumer.read_global_row,
            fact.consumer.length_log_global_row,
            fact.consumer.index_value_id, index,
            fact.consumer.sum_left_value_id, sum,
            fact.consumer.read_result_value_id, result, -1, -1
        ), fact.static_mutation, fact.read_only, fact.reverse, fact.pop
    );
}
