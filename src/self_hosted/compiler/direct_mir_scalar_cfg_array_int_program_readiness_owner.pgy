// Final graph-plan closure for bounded Array<Int> mutation and consumption.
import "direct_mir_scalar_cfg_array_int_program_fact_owner.pgy";
import "direct_mir_scalar_cfg_array_int_consumer_readiness_owner.pgy";
import "direct_mir_scalar_cfg_array_int_static_mutation_readiness_owner.pgy";
import "direct_mir_scalar_cfg_array_int_read_only_readiness_owner.pgy";
import "direct_mir_scalar_cfg_array_int_reverse_readiness_owner.pgy";
import "direct_mir_scalar_cfg_array_int_pop_readiness_owner.pgy";
import "direct_mir_scalar_cfg_array_int_operation_absence_owner.pgy";
import "direct_mir_scalar_cfg_while_induction_owner.pgy";
import "direct_mir_scalar_cfg_operation_position_owner.pgy";

func DirectMirScalarCfgArrayIntProducerOrderReady(
    ref plan: DirectMirScalarCfgGraphPlan,
    ref fact: DirectMirScalarCfgArrayIntProgramFact
) -> Bool {
    let phi: Int = DirectMirScalarCfgResultOperation(
        plan, fact.producer.induction_value_row
    );
    if phi < 0 || DirectMirScalarCfgOperationBlock(plan, phi) !=
            fact.producer.header_block { return false; }
    let step: Int = -1; let incoming: Int = 0;
    while incoming < plan.operation_phi_counts[phi] {
        let value: Int = plan.phi_incoming_values[
            plan.operation_phi_starts[phi] + incoming
        ];
        let operation: Int = DirectMirScalarCfgResultOperation(plan, value);
        if operation >= 0 && plan.operation_kinds[operation] ==
                DirectMirScalarCfgOpAddInt() &&
            plan.operation_left_values[operation] ==
                fact.producer.induction_value_row &&
            plan.operation_right_values[operation] == -1 &&
            plan.operation_right_locals[operation] == -1 &&
            plan.operation_right_literals[operation] == "1" {
            if step >= 0 { return false; }
            step = operation;
        }
        incoming = incoming + 1;
    }
    return step > fact.producer.push_operation_row &&
        DirectMirScalarCfgOperationBlock(plan, step) ==
            fact.producer.body_block;
}

func DirectMirScalarCfgArrayIntProgramReady(
    ref plan: DirectMirScalarCfgGraphPlan
) -> Bool {
    let fact: DirectMirScalarCfgArrayIntProgramFact =
        plan.array_int_program;
    if DirectMirScalarCfgArrayIntProgramAbsent(fact) {
        return DirectMirScalarCfgArrayIntOwnedOperationsAbsent(plan);
    }
    if fact.mode == DirectMirScalarCfgArrayIntStaticSetMode() {
        return DirectMirScalarCfgArrayIntStaticMutationReady(plan);
    }
    if fact.mode == DirectMirScalarCfgArrayIntReadOnlyInitializedMode() {
        return DirectMirScalarCfgArrayIntReadOnlyReady(plan);
    }
    if fact.mode == DirectMirScalarCfgArrayIntFreshReverseMode() {
        return DirectMirScalarCfgArrayIntReverseReady(plan);
    }
    if fact.mode == DirectMirScalarCfgArrayIntForEachPrefixPopMode() {
        return DirectMirScalarCfgArrayIntPopReady(plan);
    }
    let p: DirectMirScalarCfgArrayIntProducerFact = fact.producer;
    let c: DirectMirScalarCfgArrayIntConsumerFact = fact.consumer;
    let values: Int = ArrayLength(plan.value_names);
    let operations: Int = ArrayLength(plan.operation_kinds);
    if !fact.valid || fact.mode !=
            DirectMirScalarCfgArrayIntDynamicPushMode() ||
        !DirectMirScalarCfgArrayIntCollectionFactReady(fact.collection) ||
        ArrayLength(fact.collection.elements) != 0 ||
        !p.valid || !c.valid || fact.static_mutation.valid ||
        !DirectMirScalarCfgArrayIntReadOnlyAbsent(fact.read_only) ||
        !DirectMirScalarCfgArrayIntReverseAbsent(fact.reverse) ||
        p.bound < 1 || p.bound > 46340 ||
        (p.push_value_kind != DirectMirScalarCfgArrayIntPushValueMultiply() &&
         p.push_value_kind != DirectMirScalarCfgArrayIntPushValueAdd()) ||
        p.induction_value_row < 0 || p.induction_value_row >= values ||
        c.index_value_row < 0 || c.index_value_row >= values ||
        c.sum_left_value_row < 0 || c.sum_left_value_row >= values ||
        c.read_result_value_row < 0 || c.read_result_value_row >= values ||
        p.push_operation_row < 0 || p.push_operation_row >= operations ||
        c.read_operation_row < 0 || c.read_operation_row >= operations ||
        c.length_log_operation_row < 0 ||
        c.length_log_operation_row >= operations ||
        plan.value_names[p.induction_value_row] != p.induction_value_id ||
        plan.value_names[c.index_value_row] != c.index_value_id ||
        plan.value_names[c.sum_left_value_row] != c.sum_left_value_id ||
        plan.value_names[c.read_result_value_row] != c.read_result_value_id ||
        plan.value_types[p.induction_value_row] != "Int" ||
        plan.value_types[c.index_value_row] != "Int" ||
        plan.value_types[c.sum_left_value_row] != "Int" ||
        plan.value_types[c.read_result_value_row] != "Int" ||
        plan.value_local_rows[c.sum_left_value_row] !=
            plan.value_local_rows[c.read_result_value_row] { return false; }
    if p.header_block < 0 || p.body_block < 0 || p.exit_block < 0 ||
        c.header_block < 0 || c.body_block < 0 || c.exit_block < 0 ||
        plan.block_succ_true[p.header_block] != p.body_block ||
        plan.block_succ_false[p.header_block] != p.exit_block ||
        plan.block_succ_true[p.body_block] != p.header_block ||
        plan.block_succ_false[p.body_block] >= 0 ||
        plan.block_succ_true[p.exit_block] != c.header_block ||
        plan.block_succ_false[p.exit_block] >= 0 ||
        plan.block_succ_true[c.header_block] != c.body_block ||
        plan.block_succ_false[c.header_block] != c.exit_block ||
        plan.block_succ_true[c.body_block] != c.header_block ||
        plan.block_succ_false[c.body_block] >= 0 { return false; }
    if plan.block_condition_kinds[p.header_block] !=
            DirectMirScalarCfgConditionLess() ||
        plan.block_condition_left_values[p.header_block] !=
            p.induction_value_row ||
        plan.block_condition_right_literals[p.header_block] !=
            ToString(p.bound) ||
        plan.block_condition_kinds[c.header_block] !=
            DirectMirScalarCfgConditionLess() ||
        plan.block_condition_left_values[c.header_block] != c.index_value_row ||
        plan.block_condition_right_values[c.header_block] != -1 ||
        plan.block_condition_right_locals[c.header_block] != -1 ||
        plan.block_condition_right_literals[c.header_block] != "" {
        return false;
    }
    if plan.operation_kinds[p.push_operation_row] !=
            DirectMirScalarCfgOpArrayPushInt() ||
        plan.operation_result_values[p.push_operation_row] != -1 ||
        plan.operation_left_values[p.push_operation_row] !=
            p.induction_value_row ||
        plan.operation_right_values[p.push_operation_row] !=
            p.induction_value_row ||
        DirectMirScalarCfgOperationBlock(plan, p.push_operation_row) !=
            p.body_block ||
        plan.operation_kinds[c.read_operation_row] !=
            DirectMirScalarCfgOpAddArrayReadInt() ||
        plan.operation_result_values[c.read_operation_row] !=
            c.read_result_value_row ||
        plan.operation_left_values[c.read_operation_row] !=
            c.sum_left_value_row ||
        plan.operation_right_values[c.read_operation_row] != c.index_value_row ||
        DirectMirScalarCfgOperationBlock(plan, c.read_operation_row) !=
            c.body_block ||
        plan.operation_kinds[c.length_log_operation_row] !=
            DirectMirScalarCfgOpLogArrayLength() ||
        DirectMirScalarCfgOperationBlock(
            plan, c.length_log_operation_row
        ) != c.exit_block { return false; }
    return DirectMirScalarCfgWhileInductionZeroUnitReady(
        plan, p.induction_value_row
    ) && DirectMirScalarCfgWhileInductionZeroUnitReady(
        plan, c.index_value_row
    ) && DirectMirScalarCfgArrayIntProducerOrderReady(plan, fact) &&
        DirectMirScalarCfgArrayIntSumPhiReady(plan, fact);
}
