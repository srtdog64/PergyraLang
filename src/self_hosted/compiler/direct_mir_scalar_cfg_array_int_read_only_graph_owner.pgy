// Exact indexed-read, greater-condition, and final-log graph facts.

import "direct_mir_scalar_cfg_expression_base_owner.pgy";

struct DirectMirScalarCfgArrayIntIndexReadGraphFact {
    let valid: Bool;
    let collection_name: String;
    let index_name: String;
    let index_literal: Int;
}

func DirectMirScalarCfgArrayIntIndexReadGraphFactFrom(
    ref graph: MirExpressionGraphSequence
) -> DirectMirScalarCfgArrayIntIndexReadGraphFact {
    let invalid: DirectMirScalarCfgArrayIntIndexReadGraphFact =
        DirectMirScalarCfgArrayIntIndexReadGraphFact(false, "", "", -1);
    if !graph.ok || graph.ready_node_count != 3 ||
        ArrayLength(graph.roots) != 1 || graph.roots[0] != 2 ||
        graph.arena.topology.node_kinds[0] != AstExpressionNodeLeaf() ||
        graph.arena.node_texts[0] == "" ||
        graph.arena.topology.node_kinds[2] != AstExpressionNodeIndex() ||
        graph.arena.topology.left_children[2] != 0 ||
        graph.arena.topology.right_children[2] != 1 ||
        !DirectMirScalarCfgNoCallTargets(graph) { return invalid; }
    let index_name: String = ""; let index_literal: Int = -1;
    if graph.arena.topology.node_kinds[1] == AstExpressionNodeLeaf() &&
        graph.arena.node_texts[1] != "" {
        index_name = graph.arena.node_texts[1];
    } else if graph.arena.topology.node_kinds[1] ==
            AstExpressionNodeIntegerLiteral() &&
        DirectMirScalarCfgCanonicalInt(graph.arena.node_texts[1]) {
        index_literal = ToInt(graph.arena.node_texts[1]);
    } else { return invalid; }
    return DirectMirScalarCfgArrayIntIndexReadGraphFact(
        true, graph.arena.node_texts[0], index_name, index_literal
    );
}

struct DirectMirScalarCfgArrayIntMaxConditionGraphFact {
    let valid: Bool;
    let collection_name: String;
    let index_name: String;
    let current_name: String;
}

func DirectMirScalarCfgArrayIntMaxConditionGraphFactFrom(
    ref graph: MirExpressionGraphSequence
) -> DirectMirScalarCfgArrayIntMaxConditionGraphFact {
    let invalid: DirectMirScalarCfgArrayIntMaxConditionGraphFact =
        DirectMirScalarCfgArrayIntMaxConditionGraphFact(false, "", "", "");
    if !graph.ok || graph.ready_node_count != 5 ||
        ArrayLength(graph.roots) != 1 || graph.roots[0] != 4 ||
        graph.arena.topology.node_kinds[0] != AstExpressionNodeLeaf() ||
        graph.arena.topology.node_kinds[1] != AstExpressionNodeLeaf() ||
        graph.arena.topology.node_kinds[2] != AstExpressionNodeIndex() ||
        graph.arena.topology.left_children[2] != 0 ||
        graph.arena.topology.right_children[2] != 1 ||
        graph.arena.topology.node_kinds[3] != AstExpressionNodeLeaf() ||
        graph.arena.topology.node_kinds[4] != AstExpressionNodeGreater() ||
        graph.arena.topology.left_children[4] != 2 ||
        graph.arena.topology.right_children[4] != 3 ||
        graph.arena.node_texts[0] == "" || graph.arena.node_texts[1] == "" ||
        graph.arena.node_texts[3] == "" ||
        !DirectMirScalarCfgNoCallTargets(graph) { return invalid; }
    return DirectMirScalarCfgArrayIntMaxConditionGraphFact(
        true, graph.arena.node_texts[0], graph.arena.node_texts[1],
        graph.arena.node_texts[3]
    );
}

func DirectMirScalarCfgArrayIntMaxLogName(
    ref graph: MirExpressionGraphSequence
) -> String {
    if !graph.ok || graph.ready_node_count != 4 ||
        ArrayLength(graph.roots) != 1 || graph.roots[0] != 3 ||
        graph.arena.topology.node_kinds[0] != AstExpressionNodeLeaf() ||
        graph.arena.node_texts[0] != "ToString" ||
        graph.arena.topology.node_kinds[1] != AstExpressionNodeCall() ||
        graph.arena.topology.left_children[1] != 0 ||
        graph.arena.call_target_kinds[1] != SemanticCallTargetDirect() ||
        graph.arena.call_target_names[1] != "ToString" ||
        graph.arena.topology.node_kinds[2] != AstExpressionNodeLeaf() ||
        graph.arena.node_texts[2] == "" ||
        graph.arena.topology.node_kinds[3] !=
            AstExpressionNodeCallArgument() ||
        graph.arena.topology.left_children[3] != 1 ||
        graph.arena.topology.right_children[3] != 2 { return ""; }
    let node: Int = 0;
    while node < graph.ready_node_count {
        if node != 1 && (graph.arena.call_target_kinds[node] !=
                SemanticCallTargetNone() ||
            graph.arena.call_target_names[node] != "") { return ""; }
        node = node + 1;
    }
    return graph.arena.node_texts[2];
}
