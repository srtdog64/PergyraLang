// Exact inactive sentinel for the fresh ArrayReverse receipt.

import "direct_mir_scalar_cfg_array_int_reverse_fact_owner.pgy";

func DirectMirScalarCfgArrayIntDerivedCollectionAbsent(
    ref fact: DirectMirScalarCfgArrayIntDerivedCollectionFact
) -> Bool {
    return !fact.valid && fact.definition_global_row == -1 &&
        fact.collection_value_id == "" && fact.collection_name == "" &&
        fact.storage_identity == "" && fact.abi_layout_id == 0 &&
        fact.abi_size == 0 && fact.abi_align == 0 && fact.data_offset == 0 &&
        fact.length_offset == 0 && fact.capacity_offset == 0 &&
        fact.allocator_offset == 0;
}

func DirectMirScalarCfgArrayIntReverseAbsent(
    ref fact: DirectMirScalarCfgArrayIntReverseFact
) -> Bool {
    return !fact.valid && fact.source_value_id == "" &&
        DirectMirScalarCfgArrayIntDerivedCollectionAbsent(fact.result) &&
        fact.reverse_global_row == -1 && fact.reverse_operation_row == -1 &&
        ArrayLength(fact.log_global_rows) == 0 &&
        ArrayLength(fact.log_kinds) == 0 &&
        ArrayLength(fact.log_indices) == 0 &&
        ArrayLength(fact.log_operation_rows) == 0;
}
