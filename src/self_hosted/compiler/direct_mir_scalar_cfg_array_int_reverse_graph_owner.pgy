// Exact direct-call and observation graphs for the fresh ArrayReverse mode.

import "direct_mir_scalar_cfg_expression_base_owner.pgy";
import "direct_mir_scalar_cfg_array_length_fact_owner.pgy";

struct DirectMirScalarCfgArrayIntReverseCallGraphFact {
    let valid: Bool;
    let source_name: String;
}

func DirectMirScalarCfgArrayIntReverseCallGraphFactFrom(
    ref graph: MirExpressionGraphSequence
) -> DirectMirScalarCfgArrayIntReverseCallGraphFact {
    let invalid: DirectMirScalarCfgArrayIntReverseCallGraphFact =
        DirectMirScalarCfgArrayIntReverseCallGraphFact(false, "");
    if !graph.ok || graph.ready_node_count != 4 ||
        ArrayLength(graph.roots) != 1 || graph.roots[0] != 3 ||
        graph.arena.topology.node_kinds[0] != AstExpressionNodeLeaf() ||
        graph.arena.node_texts[0] != "ArrayReverse" ||
        graph.arena.topology.node_kinds[1] != AstExpressionNodeCall() ||
        graph.arena.topology.left_children[1] != 0 ||
        graph.arena.call_target_kinds[1] != SemanticCallTargetDirect() ||
        graph.arena.call_target_names[1] != "ArrayReverse" ||
        graph.arena.topology.node_kinds[2] != AstExpressionNodeLeaf() ||
        graph.arena.node_texts[2] == "" ||
        graph.arena.topology.node_kinds[3] !=
            AstExpressionNodeCallArgument() ||
        graph.arena.topology.left_children[3] != 1 ||
        graph.arena.topology.right_children[3] != 2 { return invalid; }
    let row: Int = 0;
    while row < graph.ready_node_count {
        if row != 1 && (graph.arena.call_target_kinds[row] !=
                SemanticCallTargetNone() ||
            graph.arena.call_target_names[row] != "") { return invalid; }
        row = row + 1;
    }
    return DirectMirScalarCfgArrayIntReverseCallGraphFact(
        true, graph.arena.node_texts[2]
    );
}

struct DirectMirScalarCfgArrayIntReverseObservationGraphFact {
    let valid: Bool;
    let kind: Int;
    let collection_name: String;
    let index: Int;
}

func DirectMirScalarCfgArrayIntReverseObservationGraphFactFrom(
    ref graph: MirExpressionGraphSequence
) -> DirectMirScalarCfgArrayIntReverseObservationGraphFact {
    let invalid: DirectMirScalarCfgArrayIntReverseObservationGraphFact =
        DirectMirScalarCfgArrayIntReverseObservationGraphFact(
            false, 0, "", -1
        );
    if graph.ok && graph.ready_node_count == 4 &&
        ArrayLength(graph.roots) == 1 && graph.roots[0] == 3 {
        let length: DirectMirScalarCfgArrayLengthGraphFact =
            DirectMirScalarCfgArrayLengthGraphFactAt(graph, 0, 1, 2, 3);
        if length.valid {
            let row: Int = 0;
            while row < graph.ready_node_count {
                if row != 1 && (graph.arena.call_target_kinds[row] !=
                        SemanticCallTargetNone() ||
                    graph.arena.call_target_names[row] != "") {
                    return invalid;
                }
                row = row + 1;
            }
            return DirectMirScalarCfgArrayIntReverseObservationGraphFact(
                true, DirectMirScalarCfgArrayIntReverseLengthLog(),
                length.collection_name, -1
            );
        }
    }
    if !graph.ok || graph.ready_node_count != 3 ||
        ArrayLength(graph.roots) != 1 || graph.roots[0] != 2 ||
        graph.arena.topology.node_kinds[0] != AstExpressionNodeLeaf() ||
        graph.arena.node_texts[0] == "" ||
        graph.arena.topology.node_kinds[1] !=
            AstExpressionNodeIntegerLiteral() ||
        !DirectMirScalarCfgCanonicalInt(graph.arena.node_texts[1]) ||
        graph.arena.topology.node_kinds[2] != AstExpressionNodeIndex() ||
        graph.arena.topology.left_children[2] != 0 ||
        graph.arena.topology.right_children[2] != 1 ||
        !DirectMirScalarCfgNoCallTargets(graph) { return invalid; }
    return DirectMirScalarCfgArrayIntReverseObservationGraphFact(
        true, DirectMirScalarCfgArrayIntReverseIndexLog(),
        graph.arena.node_texts[0], ToInt(graph.arena.node_texts[1])
    );
}
