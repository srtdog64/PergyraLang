// Structural exception owned only by an exact fresh ArrayReverse receipt.

import "direct_mir_scalar_cfg_graph_fact_owner.pgy";

func DirectMirScalarCfgMinimumPlanShapeReady(
    ref plan: DirectMirScalarCfgGraphPlan,
    local_count: Int, value_count: Int, block_count: Int
) -> Bool {
    if plan.array_int_program.mode ==
            DirectMirScalarCfgArrayIntFreshReverseMode() &&
        plan.array_int_program.reverse.valid {
        return local_count == 0 && value_count == 0 && block_count == 1;
    }
    return local_count >= 1 && block_count >= 2;
}
