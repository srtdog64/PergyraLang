// C set and post-set indexed Log from the sealed static Array<Int> receipt.

import "direct_mir_scalar_cfg_c_operand_owner.pgy";

func DirectMirScalarCfgArrayIntCSet(
    ref plan: DirectMirScalarCfgGraphPlan, operation: Int
) -> String {
    if !plan.array_int_program.static_mutation.valid || operation !=
            plan.array_int_program.static_mutation.set_operation_row {
        Die("direct MIR scalar CFG Array<Int> C set is invalid");
    }
    let output: String = Concat(
        "    pgy_array_int_collection.data[",
        ToString(plan.array_int_program.static_mutation.set_index)
    );
    output = Concat(output, "] = (int32_t)(");
    output = Concat(
        output, ToString(plan.array_int_program.static_mutation.set_value)
    );
    return Concat(output, ");\n");
}

func DirectMirScalarCfgArrayIntCIndexedLog(
    ref plan: DirectMirScalarCfgGraphPlan, operation: Int,
    formatted_print: CompilerRuntimeCallAbiFact,
    int_line_format: String, int_c_type: String
) -> String {
    if !plan.array_int_program.static_mutation.valid || operation !=
            plan.array_int_program.static_mutation.indexed_log_operation_row {
        Die("direct MIR scalar CFG Array<Int> C indexed Log is invalid");
    }
    let output: String = Concat("    ", formatted_print.symbol);
    output = Concat(output, Concat("(\"", int_line_format));
    output = Concat(output, Concat("\", (", int_c_type));
    output = Concat(output, ")pgy_array_int_collection.data[");
    output = Concat(output, ToString(
        plan.array_int_program.static_mutation.indexed_log_index
    ));
    return Concat(output, "]);\n");
}
