// Exact literal set and post-read graph facts for static Array<Int> mutation.

import "direct_mir_scalar_cfg_array_int_collection_owner.pgy";
import "direct_mir_scalar_cfg_expression_base_owner.pgy";

struct DirectMirScalarCfgArrayIntLiteralGraphFact {
    let valid: Bool;
    let value: Int;
}

func DirectMirScalarCfgArrayIntLiteralGraphFactFrom(
    ref graph: MirExpressionGraphSequence
) -> DirectMirScalarCfgArrayIntLiteralGraphFact {
    if !graph.ok || graph.ready_node_count != 1 ||
        ArrayLength(graph.roots) != 1 || graph.roots[0] != 0 ||
        graph.arena.topology.node_kinds[0] !=
            AstExpressionNodeIntegerLiteral() ||
        !DirectMirScalarCfgCanonicalInt(graph.arena.node_texts[0]) ||
        !DirectMirScalarCfgNoCallTargets(graph) {
        return DirectMirScalarCfgArrayIntLiteralGraphFact(false, 0);
    }
    let value: Int = ToInt(graph.arena.node_texts[0]);
    return DirectMirScalarCfgArrayIntLiteralGraphFact(
        DirectMirScalarCfgArrayIntElementValueReady(value), value
    );
}

struct DirectMirScalarCfgArrayIntIndexedLogGraphFact {
    let valid: Bool;
    let collection_name: String;
    let index: Int;
}

func DirectMirScalarCfgArrayIntIndexedLogGraphFactFrom(
    ref graph: MirExpressionGraphSequence
) -> DirectMirScalarCfgArrayIntIndexedLogGraphFact {
    let invalid: DirectMirScalarCfgArrayIntIndexedLogGraphFact =
        DirectMirScalarCfgArrayIntIndexedLogGraphFact(false, "", -1);
    if !graph.ok || graph.ready_node_count != 6 ||
        ArrayLength(graph.roots) != 1 || graph.roots[0] != 5 ||
        graph.arena.topology.node_kinds[0] != AstExpressionNodeLeaf() ||
        graph.arena.node_texts[0] != "ToString" ||
        graph.arena.topology.node_kinds[1] != AstExpressionNodeCall() ||
        graph.arena.topology.left_children[1] != 0 ||
        graph.arena.call_target_kinds[1] != SemanticCallTargetDirect() ||
        graph.arena.call_target_names[1] != "ToString" ||
        graph.arena.topology.node_kinds[2] != AstExpressionNodeLeaf() ||
        graph.arena.node_texts[2] == "" ||
        graph.arena.topology.node_kinds[3] !=
            AstExpressionNodeIntegerLiteral() ||
        !DirectMirScalarCfgCanonicalInt(graph.arena.node_texts[3]) ||
        graph.arena.topology.node_kinds[4] != AstExpressionNodeIndex() ||
        graph.arena.topology.left_children[4] != 2 ||
        graph.arena.topology.right_children[4] != 3 ||
        graph.arena.topology.node_kinds[5] !=
            AstExpressionNodeCallArgument() ||
        graph.arena.topology.left_children[5] != 1 ||
        graph.arena.topology.right_children[5] != 4 { return invalid; }
    let row: Int = 0;
    while row < graph.ready_node_count {
        if row != 1 && (graph.arena.call_target_kinds[row] !=
                SemanticCallTargetNone() ||
            graph.arena.call_target_names[row] != "") { return invalid; }
        row = row + 1;
    }
    return DirectMirScalarCfgArrayIntIndexedLogGraphFact(
        true, graph.arena.node_texts[2],
        ToInt(graph.arena.node_texts[3])
    );
}
