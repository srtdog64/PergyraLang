// C routing for operations owned by typed collection receipts.

import "direct_mir_scalar_cfg_c_collection_mutation_emission_owner.pgy";
import "direct_mir_scalar_cfg_array_int_c_emission_owner.pgy";
import "direct_mir_scalar_cfg_array_int_c_program_operation_owner.pgy";
import "direct_mir_scalar_cfg_c_collection_operation_fact_owner.pgy";

func DirectMirScalarCfgEmitCCollectionOperation(
    ref plan: DirectMirScalarCfgGraphPlan, operation: Int,
    formatted_print: CompilerRuntimeCallAbiFact,
    int_line_format: String, int_c_type: String
) -> DirectMirScalarCfgCCollectionOperationEmission {
    let kind: Int = plan.operation_kinds[operation];
    let mutation: DirectMirScalarCfgCCollectionOperationEmission =
        DirectMirScalarCfgEmitCCollectionMutation(
            plan, operation, formatted_print, int_line_format, int_c_type);
    if mutation.valid { return mutation; }
    if kind == DirectMirScalarCfgOpAddArrayReadInt() {
        return DirectMirScalarCfgCCollectionOperationEmission(
            true, DirectMirScalarCfgArrayIntCRead(plan, operation)
        );
    }
    let array_int: DirectMirScalarCfgCCollectionOperationEmission =
        DirectMirScalarCfgArrayIntCProgramOperation(
            plan, operation, formatted_print, int_line_format, int_c_type
        );
    if array_int.valid { return array_int; }
    if kind == DirectMirScalarCfgOpLogArrayLength() {
        if operation == plan.array_int_program.pop.length_log_operation_row {
            return DirectMirScalarCfgArrayIntPopCOperation(
                plan, operation, formatted_print, int_line_format, int_c_type);
        }
        if operation ==
            plan.array_int_program.consumer.length_log_operation_row {
            return DirectMirScalarCfgCCollectionOperationEmission(
                true, DirectMirScalarCfgArrayIntCLengthLog(
                    plan, operation, formatted_print,
                    int_line_format, int_c_type
                )
            );
        }
        return DirectMirScalarCfgCCollectionOperationEmission(
            true, DirectMirScalarCfgStringArrayCLengthLog(
                plan, operation, formatted_print,
                int_line_format, int_c_type
            )
        );
    }
    return DirectMirScalarCfgCCollectionOperationEmission(false, "");
}
