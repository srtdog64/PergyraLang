// Per-operation C projection from the sealed typed scalar-CFG receipt.
import "direct_mir_scalar_cfg_c_operand_owner.pgy";
import "runtime_call_abi_structured_fact_owner.pgy";
import "direct_mir_scalar_cfg_string_array_c_emission_owner.pgy";
import "direct_mir_scalar_cfg_string_array_c_mutation_emission_owner.pgy";
import "direct_mir_scalar_cfg_c_collection_operation_emission_owner.pgy";
import "direct_mir_scalar_cfg_collection_plan_c_operation_owner.pgy";

func DirectMirScalarCfgEmitCOperation(
    ref plan: DirectMirScalarCfgGraphPlan, operation: Int,
    formatted_print: CompilerRuntimeCallAbiFact,
    concat: CompilerRuntimeCallAbiFact,
    int_line_format: String, string_line_format: String,
    int_c_type: String
) -> String {
    let kind: Int = plan.operation_kinds[operation];
    let output: String = "";
    let legalized_collection: String = DirectMirScalarCfgCollectionPlanCOperation(plan, operation, formatted_print, concat, int_line_format, string_line_format, int_c_type);
    if legalized_collection != "" { return legalized_collection; }
    if kind == DirectMirScalarCfgOpConstInt() ||
            kind == DirectMirScalarCfgOpConstString() {
        output = Concat(output, "    ");
        output = Concat(output, DirectMirScalarCfgCLocal(
            plan, plan.operation_result_values[operation]
        ));
        output = Concat(output, " = ");
        if kind == DirectMirScalarCfgOpConstString() {
            output = Concat(output, "\"");
            output = Concat(output, plan.operation_left_literals[operation]);
            output = Concat(output, "\"");
        } else {
            output = Concat(output, plan.operation_left_literals[operation]);
        }
        return Concat(output, ";\n");
    }
    if kind == DirectMirScalarCfgOpCopyInt() ||
            kind == DirectMirScalarCfgOpAddInt() ||
            kind == DirectMirScalarCfgOpCopyString() ||
            kind == DirectMirScalarCfgOpConcatString() {
        output = Concat(output, "    ");
        output = Concat(output, DirectMirScalarCfgCLocal(
            plan, plan.operation_result_values[operation]
        ));
        output = Concat(output, " = ");
        if kind == DirectMirScalarCfgOpConcatString() {
            if !CompilerRuntimeCallAbiStringConcatFactReady(concat) ||
                concat.runtime_call_abi_id !=
                    plan.string_concat_runtime_call_abi_id {
                Die("direct MIR scalar CFG C concat receipt is invalid");
            }
            output = Concat(output, Concat(concat.symbol, "("));
        }
        output = Concat(output, DirectMirScalarCfgCOperand(
            plan, plan.operation_left_values[operation],
            plan.operation_left_locals[operation],
            plan.operation_left_literals[operation]
        ));
        if kind == DirectMirScalarCfgOpAddInt() ||
                kind == DirectMirScalarCfgOpConcatString() {
            if kind == DirectMirScalarCfgOpAddInt() {
                output = Concat(output, " + ");
            } else { output = Concat(output, ", "); }
            let indexed_row: Int =
                DirectMirScalarCfgStringArrayAccessRowAtOperation(
                    plan.string_arrays, operation
                );
            if kind == DirectMirScalarCfgOpConcatString() && indexed_row >= 0 &&
                plan.string_arrays.accesses.kinds[indexed_row] ==
                    DirectMirScalarCfgStringArrayAccessConcatRead() {
                output = Concat(output,
                    DirectMirScalarCfgStringArrayCRead(plan, operation));
            } else {
                output = Concat(output, DirectMirScalarCfgCOperand(
                    plan, plan.operation_right_values[operation],
                    plan.operation_right_locals[operation],
                    plan.operation_right_literals[operation]
                ));
            }
        }
        if kind == DirectMirScalarCfgOpConcatString() {
            output = Concat(output, ")");
        }
        return Concat(output, ";\n");
    }
    if kind == DirectMirScalarCfgOpLogInt() {
        output = Concat(output, Concat("    ", formatted_print.symbol));
        output = Concat(output, Concat("(\"", int_line_format));
        output = Concat(output, "\", ("); output = Concat(output, int_c_type);
        output = Concat(output, ")");
        output = Concat(output, DirectMirScalarCfgCOperand(
            plan, plan.operation_left_values[operation],
            plan.operation_left_locals[operation],
            plan.operation_left_literals[operation]
        ));
        return Concat(output, ");\n");
    }
    if kind == DirectMirScalarCfgOpLogString() ||
            kind == DirectMirScalarCfgOpLogStringValue() {
        output = Concat(output, Concat("    ", formatted_print.symbol));
        output = Concat(output, Concat("(\"", string_line_format));
        output = Concat(output, "\", ");
        if kind == DirectMirScalarCfgOpLogString() {
            output = Concat(output, "\"");
            output = Concat(output, plan.operation_left_literals[operation]);
            output = Concat(output, "\"");
        } else if DirectMirScalarCfgStringArrayAccessRowAtOperation(
                plan.string_arrays, operation
            ) >= 0 {
            output = Concat(
                output, DirectMirScalarCfgStringArrayCRead(plan, operation)
            );
        } else {
            output = Concat(output, DirectMirScalarCfgCOperand(
                plan, plan.operation_left_values[operation],
                plan.operation_left_locals[operation], ""
            ));
        }
        return Concat(output, ");\n");
    }
    let collection: DirectMirScalarCfgCCollectionOperationEmission =
        DirectMirScalarCfgEmitCCollectionOperation(
            plan, operation, formatted_print, int_line_format, int_c_type
        );
    if collection.valid { return collection.text; }
    if kind != DirectMirScalarCfgOpPhiInt() &&
        kind != DirectMirScalarCfgOpPhiString() {
        Die("direct MIR scalar CFG C operation is unsupported");
    }
    return output;
}
