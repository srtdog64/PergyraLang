// Typed observation slices over ordered collection Get rows.
import "direct_mir_scalar_cfg_collection_operation_readiness_owner.pgy";
func DirectMirScalarCfgCollectionObservationsReady(
    ref plan: DirectMirScalarCfgCollectionPlan
) -> Bool {
    let count: Int = ArrayLength(plan.observations.kinds);
    if !plan.observations.valid || count < 1 ||
        count != ArrayLength(plan.observations.global_rows) ||
        count != ArrayLength(plan.observations.receiver_value_rows) ||
        count != ArrayLength(plan.observations.get_operation_starts) ||
        count != ArrayLength(plan.observations.get_operation_counts) ||
        count != ArrayLength(plan.observations.graph_operation_rows) {
        return false;
    }
    let get_claims: Array<Int> = [];
    let operation: Int = 0;
    while operation < ArrayLength(plan.operations.kinds) {
        ArrayPush(get_claims, 0);
        operation = operation + 1;
    }
    let row: Int = 0;
    let prior_global: Int = -1;
    while row < count {
        let receiver: Int = plan.observations.receiver_value_rows[row];
        let start: Int = plan.observations.get_operation_starts[row];
        let items: Int = plan.observations.get_operation_counts[row];
        let kind: Int = plan.observations.kinds[row];
        if plan.observations.global_rows[row] <= prior_global ||
            receiver < 0 || receiver >= ArrayLength(plan.values.value_ids) ||
            start < 0 || items < 1 ||
            start + items > ArrayLength(plan.operations.kinds) ||
            plan.observations.graph_operation_rows[row] < 0 ||
            (kind == DirectMirScalarCfgCollectionObservationSumInt() &&
                plan.values.element_types[receiver] != "Int") ||
            (kind == DirectMirScalarCfgCollectionObservationConcatString() &&
                (plan.values.element_types[receiver] != "String" ||
                 items != 2)) ||
            (kind != DirectMirScalarCfgCollectionObservationSumInt() &&
             kind != DirectMirScalarCfgCollectionObservationConcatString()) {
            return false;
        }
        let item: Int = 0;
        while item < items {
            let operation_row: Int = start + item;
            if plan.operations.kinds[operation_row] !=
                    DirectMirScalarCfgCollectionOpGet() ||
                plan.operations.global_rows[operation_row] !=
                    plan.observations.global_rows[row] ||
                plan.operations.source_ordinals[operation_row] != item ||
                plan.operations.receiver_value_rows[operation_row] != receiver ||
                plan.operations.graph_operation_rows[operation_row] !=
                    plan.observations.graph_operation_rows[row] { return false; }
            ArraySet(
                get_claims, operation_row, get_claims[operation_row] + 1
            );
            item = item + 1;
        }
        prior_global = plan.observations.global_rows[row]; row = row + 1;
    }
    operation = 0;
    while operation < ArrayLength(plan.operations.kinds) {
        let expected: Int = 0;
        if plan.operations.kinds[operation] ==
                DirectMirScalarCfgCollectionOpGet() { expected = 1; }
        if get_claims[operation] != expected { return false; }
        operation = operation + 1;
    }
    return true;
}
