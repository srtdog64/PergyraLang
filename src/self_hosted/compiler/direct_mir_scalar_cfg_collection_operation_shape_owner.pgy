// Operand-free operation kinds whose payload is owned by collection receipts.

import "direct_mir_scalar_cfg_graph_fact_owner.pgy";

func DirectMirScalarCfgCollectionOperationHasNoOperands(kind: Int) -> Bool {
    return kind == DirectMirScalarCfgOpArraySetString() ||
        kind == DirectMirScalarCfgOpArrayPushString() ||
        kind == DirectMirScalarCfgOpLogArrayLength() ||
        kind == DirectMirScalarCfgOpArraySetInt() ||
        kind == DirectMirScalarCfgOpLogArrayIndexInt();
}
