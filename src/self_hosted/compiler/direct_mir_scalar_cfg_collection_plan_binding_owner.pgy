// Bind legalized collection effects to sealed GraphPlan operation rows.

import "direct_mir_scalar_cfg_collection_plan_identity_owner.pgy";

func DirectMirScalarCfgCollectionPlanAtGraphOperation(
    inout source: DirectMirScalarCfgCollectionPlan,
    global: Int, graph_operation: Int
) -> Void {
    let operation_rows: Array<Int> = source.operations.graph_operation_rows;
    let observation_rows: Array<Int> =
        source.observations.graph_operation_rows;
    let matched: Bool = false;
    let row: Int = 0;
    while row < ArrayLength(source.operations.global_rows) {
        if source.operations.global_rows[row] == global &&
            source.operations.kinds[row] !=
                DirectMirScalarCfgCollectionOpInitialize() {
            if operation_rows[row] >= 0 {
                source = DirectMirScalarCfgCollectionPlanEmpty();
                return;
            }
            ArraySet(operation_rows, row, graph_operation); matched = true;
        }
        row = row + 1;
    }
    row = 0;
    while row < ArrayLength(source.observations.global_rows) {
        if source.observations.global_rows[row] == global {
            if observation_rows[row] >= 0 {
                source = DirectMirScalarCfgCollectionPlanEmpty();
                return;
            }
            ArraySet(observation_rows, row, graph_operation); matched = true;
        }
        row = row + 1;
    }
    if !matched {
        source = DirectMirScalarCfgCollectionPlanEmpty();
        return;
    }
    let operations: DirectMirScalarCfgCollectionOperationSet =
        DirectMirScalarCfgCollectionOperationSet(
            source.operations.valid, source.operations.dynamic_inputs,
            source.operations.global_rows,
            source.operations.source_ordinals, source.operations.kinds,
            source.operations.receiver_value_rows,
            source.operations.result_value_rows, source.operations.indices,
            source.operations.input_types, source.operations.input_ints,
            source.operations.input_strings, operation_rows
        );
    let observations: DirectMirScalarCfgCollectionObservationSet =
        DirectMirScalarCfgCollectionObservationSet(
            source.observations.valid, source.observations.global_rows,
            source.observations.kinds,
            source.observations.receiver_value_rows,
            source.observations.get_operation_starts,
            source.observations.get_operation_counts, observation_rows
        );
    let plan: DirectMirScalarCfgCollectionPlan =
        DirectMirScalarCfgCollectionPlan(
            true, 0, source.values, operations, observations
        );
    source = DirectMirScalarCfgCollectionPlanWithDigest(
        plan, DirectMirScalarCfgCollectionPlanDigest(plan)
    );
}
