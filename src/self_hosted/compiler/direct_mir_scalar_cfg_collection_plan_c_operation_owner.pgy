// C projection of legalized collection Set/Get observation rows.

import "direct_mir_scalar_cfg_collection_plan_fact_owner.pgy";
import "runtime_call_abi_structured_fact_owner.pgy";

func DirectMirScalarCfgCollectionPlanCOperation(
    ref plan: DirectMirScalarCfgGraphPlan, operation: Int,
    formatted_print: CompilerRuntimeCallAbiFact,
    concat: CompilerRuntimeCallAbiFact,
    int_line_format: String, string_line_format: String,
    int_c_type: String
) -> String {
    let set_row: Int = DirectMirScalarCfgCollectionSetOperationAtGraphRow(
        plan.collections, operation
    );
    if set_row >= 0 {
        let receiver: Int =
            plan.collections.operations.receiver_value_rows[set_row];
        let root: Int = DirectMirScalarCfgCollectionRootValueRow(
            plan.collections, receiver
        );
        if root < 0 { Die("direct MIR collection C Set root is invalid"); }
        let output: String = Concat("    pgy_collection_",
            Concat(ToString(root), ".data["));
        output = Concat(output, Concat(ToString(
            plan.collections.operations.indices[set_row]
        ), "] = "));
        if plan.collections.operations.input_types[set_row] == "Int" {
            output = Concat(output, Concat("(int32_t)(", Concat(
                ToString(plan.collections.operations.input_ints[set_row]),
                ")"
            )));
        } else {
            output = Concat(output, Concat("\"",
                Concat(plan.collections.operations.input_strings[set_row],
                    "\"")));
        }
        return Concat(output, ";\n");
    }
    let observation: Int = DirectMirScalarCfgCollectionObservationAtGraphRow(
        plan.collections, operation
    );
    if observation < 0 { return ""; }
    let receiver: Int =
        plan.collections.observations.receiver_value_rows[observation];
    let root: Int = DirectMirScalarCfgCollectionRootValueRow(
        plan.collections, receiver
    );
    let start: Int =
        plan.collections.observations.get_operation_starts[observation];
    let count: Int =
        plan.collections.observations.get_operation_counts[observation];
    if root < 0 || count < 1 {
        Die("direct MIR collection C observation is invalid");
    }
    let output: String = Concat("    ", formatted_print.symbol);
    if plan.collections.observations.kinds[observation] ==
            DirectMirScalarCfgCollectionObservationSumInt() {
        output = Concat(output, Concat("(\"", int_line_format));
        output = Concat(output, Concat("\", (", Concat(int_c_type, ")(")));
        let item: Int = 0;
        while item < count {
            if item > 0 { output = Concat(output, " + "); }
            output = Concat(output, Concat("pgy_collection_",
                Concat(ToString(root), Concat(".data[", Concat(ToString(
                    plan.collections.operations.indices[start + item]
                ), "]")))));
            item = item + 1;
        }
        return Concat(output, "));\n");
    }
    if count != 2 || !CompilerRuntimeCallAbiStringConcatFactReady(concat) ||
        concat.runtime_call_abi_id !=
            plan.string_concat_runtime_call_abi_id {
        Die("direct MIR collection C concat observation is invalid");
    }
    output = Concat(output, Concat("(\"", string_line_format));
    output = Concat(output, Concat("\", ", Concat(concat.symbol, "(")));
    let item: Int = 0;
    while item < 2 {
        if item > 0 { output = Concat(output, ", "); }
        output = Concat(output, Concat("pgy_collection_",
            Concat(ToString(root), Concat(".data[", Concat(ToString(
                plan.collections.operations.indices[start + item]
            ), "]")))));
        item = item + 1;
    }
    return Concat(output, "));\n");
}
