// C storage materialization from generic collection value facts.

import "direct_mir_scalar_cfg_collection_plan_readiness_owner.pgy";
import "direct_mir_scalar_cfg_array_c_materialization_owner.pgy";
import "direct_mir_scalar_cfg_string_array_graph_shape_owner.pgy";
import "direct_mir_array_int_abi_projection_owner.pgy";
import "direct_mir_array_string_abi_projection_owner.pgy";

func DirectMirScalarCfgCollectionPlanCPreamble(
    ref plan: DirectMirScalarCfgGraphPlan,
    target: CompilerTargetProjectionFact
) -> String {
    if DirectMirScalarCfgCollectionPlanAbsent(plan.collections) { return ""; }
    let output: String = "#include <stdint.h>\n#include <stddef.h>\n";
    let int_emitted: Bool = false;
    let string_emitted: Bool = false;
    let row: Int = 0;
    while row < ArrayLength(plan.collections.values.value_ids) {
        if plan.collections.values.predecessor_value_rows[row] < 0 {
            if plan.collections.values.element_types[row] == "Int" &&
                !int_emitted {
                let abi: DirectMirArrayIntAbiProjection =
                    DirectMirArrayIntAbiProjectionFromCanonicalLayout(
                        target, plan.collections.values.abi_layout_ids[row],
                        plan.collections.values.abi_sizes[row],
                        plan.collections.values.abi_aligns[row],
                        plan.collections.values.data_offsets[row],
                        plan.collections.values.length_offsets[row],
                        plan.collections.values.capacity_offsets[row],
                        plan.collections.values.allocator_offsets[row]
                    );
                output = Concat(output, DirectMirScalarCfgArrayCStruct(
                    abi.c_element_type, abi.c_length_type, abi.c_array_type
                ));
                int_emitted = true;
            } else if plan.collections.values.element_types[row] ==
                    "String" && !string_emitted {
                let abi: DirectMirArrayStringAbiProjection =
                    DirectMirArrayStringAbiProjectionFromCanonicalLayout(
                        target, plan.collections.values.abi_layout_ids[row],
                        plan.collections.values.abi_sizes[row],
                        plan.collections.values.abi_aligns[row],
                        plan.collections.values.data_offsets[row],
                        plan.collections.values.length_offsets[row],
                        plan.collections.values.capacity_offsets[row],
                        plan.collections.values.allocator_offsets[row]
                    );
                output = Concat(output, DirectMirScalarCfgArrayCStruct(
                    abi.c_element_type, abi.c_length_type, abi.c_array_type
                ));
                string_emitted = true;
            }
        }
        row = row + 1;
    }
    return output;
}

func DirectMirScalarCfgCollectionPlanCDeclarations(
    ref plan: DirectMirScalarCfgGraphPlan,
    target: CompilerTargetProjectionFact
) -> String {
    let output: String = "";
    let row: Int = 0;
    while row < ArrayLength(plan.collections.values.value_ids) {
        if plan.collections.values.predecessor_value_rows[row] < 0 {
            let length: Int =
                plan.collections.values.initial_element_counts[row];
            let element_type: String = "";
            let array_type: String = "";
            if plan.collections.values.element_types[row] == "Int" {
                let abi: DirectMirArrayIntAbiProjection =
                    DirectMirArrayIntAbiProjectionFromCanonicalLayout(
                        target, plan.collections.values.abi_layout_ids[row],
                        plan.collections.values.abi_sizes[row],
                        plan.collections.values.abi_aligns[row],
                        plan.collections.values.data_offsets[row],
                        plan.collections.values.length_offsets[row],
                        plan.collections.values.capacity_offsets[row],
                        plan.collections.values.allocator_offsets[row]
                    );
                element_type = abi.c_element_type; array_type = abi.c_array_type;
            } else {
                let abi: DirectMirArrayStringAbiProjection =
                    DirectMirArrayStringAbiProjectionFromCanonicalLayout(
                        target, plan.collections.values.abi_layout_ids[row],
                        plan.collections.values.abi_sizes[row],
                        plan.collections.values.abi_aligns[row],
                        plan.collections.values.data_offsets[row],
                        plan.collections.values.length_offsets[row],
                        plan.collections.values.capacity_offsets[row],
                        plan.collections.values.allocator_offsets[row]
                    );
                element_type = abi.c_element_type; array_type = abi.c_array_type;
            }
            output = Concat(output, Concat("    ", element_type));
            output = Concat(output, Concat(" pgy_collection_storage_",
                Concat(ToString(row), Concat("[", ToString(length)))));
            output = Concat(output, "] = {");
            let item: Int = 0;
            while item < length {
                if item > 0 { output = Concat(output, ", "); }
                let start: Int =
                    plan.collections.values.initial_element_starts[row];
                if plan.collections.values.element_types[row] == "Int" {
                    output = Concat(output, ToString(
                        plan.collections.values.initial_int_elements[
                            start + item
                        ]
                    ));
                } else {
                    let values: Array<String> = [
                        plan.collections.values.initial_string_elements[
                            start + item
                        ]
                    ];
                    output = Concat(output,
                        DirectMirScalarCfgArrayStringCElementList(values));
                }
                item = item + 1;
            }
            output = Concat(output, "};\n    ");
            output = Concat(output, Concat(array_type,
                Concat(" pgy_collection_", Concat(ToString(row), " = {"))));
            output = Concat(output, Concat("pgy_collection_storage_",
                Concat(ToString(row), Concat(", ", ToString(length)))));
            output = Concat(output, Concat(", ", ToString(length)));
            output = Concat(output, ", NULL};\n");
        }
        row = row + 1;
    }
    return output;
}
