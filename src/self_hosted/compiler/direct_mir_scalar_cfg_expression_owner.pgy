// Typed expression-graph projection for the general scalar CFG plan.

import "direct_mir_scalar_cfg_graph_fact_owner.pgy";
import "direct_mir_scalar_graph_admission_owner.pgy";
import "../mir_lower/expression_graph_sequence_owner.pgy";
import "../mir_lower/routine_instruction_use_fact_owner.pgy";
import "../mir_lower/ssa_identity_owner.pgy";

struct DirectMirScalarCfgExpressionFact {
    let valid: Bool;
    let kind: Int;
    let left_value: Int;
    let right_value: Int;
    let left_literal: String;
    let right_literal: String;
}

func DirectMirScalarCfgExpressionFactEmpty(
) -> DirectMirScalarCfgExpressionFact {
    return DirectMirScalarCfgExpressionFact(false, 0, -1, -1, "", "");
}

func DirectMirScalarCfgExpressionSequence(
    ref instruction: JsonObjectFactTable
) -> MirExpressionGraphSequence {
    return MirExpressionGraphSequenceAppend(
        MirExpressionGraphSequenceEmpty(),
        JsonObjectFactObjectTable(instruction, "expr0_graph")
    );
}

func DirectMirScalarCfgNoCallTargets(
    ref sequence: MirExpressionGraphSequence
) -> Bool {
    let row: Int = 0;
    while row < ArrayLength(sequence.arena.call_target_kinds) {
        if sequence.arena.call_target_kinds[row] !=
                SemanticCallTargetNone() ||
            sequence.arena.call_target_names[row] != "" {
            return false;
        }
        row = row + 1;
    }
    return true;
}

func DirectMirScalarCfgCanonicalInt(value: String) -> Bool {
    return StringLength(value) > 0 && ToString(ToInt(value)) == value;
}

func DirectMirScalarCfgUseValueRow(
    ref use_facts: MirRoutineInstructionUseFacts,
    global_row: Int,
    use_row: Int,
    node_text: String,
    value_names: Array<String>
) -> Int {
    let use_opt: Option<String> = MirRoutineInstructionUseAtGlobal(
        use_facts, global_row, use_row
    );
    if !IsSome(use_opt) ||
        !MirSsaNameMatches(UnwrapOption(use_opt), node_text, true) {
        return -1;
    }
    return DirectMirScalarCfgGraphValueRow(
        value_names, UnwrapOption(use_opt)
    );
}

func DirectMirScalarCfgValueExpressionFact(
    ref instruction: JsonObjectFactTable,
    ref use_facts: MirRoutineInstructionUseFacts,
    global_row: Int,
    value_names: Array<String>
) -> DirectMirScalarCfgExpressionFact {
    let sequence: MirExpressionGraphSequence =
        DirectMirScalarCfgExpressionSequence(instruction);
    let count: Int = ArrayLength(sequence.arena.topology.node_kinds);
    if !sequence.ok || ArrayLength(sequence.roots) != 1 ||
        sequence.roots[0] != count - 1 ||
        !DirectMirScalarCfgNoCallTargets(sequence) {
        return DirectMirScalarCfgExpressionFactEmpty();
    }
    if count == 1 && sequence.arena.topology.node_kinds[0] ==
            AstExpressionNodeIntegerLiteral() &&
        MirRoutineInstructionUseCountAtGlobal(use_facts, global_row) == 0 &&
        DirectMirScalarCfgCanonicalInt(sequence.arena.node_texts[0]) {
        return DirectMirScalarCfgExpressionFact(
            true, DirectMirScalarCfgOpConstInt(), -1, -1,
            sequence.arena.node_texts[0], ""
        );
    }
    if count == 1 && sequence.arena.topology.node_kinds[0] ==
            AstExpressionNodeLeaf() &&
        MirRoutineInstructionUseCountAtGlobal(use_facts, global_row) == 1 {
        let value_row: Int = DirectMirScalarCfgUseValueRow(
            use_facts, global_row, 0, sequence.arena.node_texts[0],
            value_names
        );
        if value_row >= 0 {
            return DirectMirScalarCfgExpressionFact(
                true, DirectMirScalarCfgOpCopyInt(), value_row, -1, "", ""
            );
        }
    }
    if count != 3 || sequence.arena.topology.node_kinds[2] !=
            AstExpressionNodeAdd() ||
        sequence.arena.topology.left_children[2] != 0 ||
        sequence.arena.topology.right_children[2] != 1 {
        return DirectMirScalarCfgExpressionFactEmpty();
    }
    let left_value: Int = -1;
    let right_value: Int = -1;
    let left_literal: String = "";
    let right_literal: String = "";
    let expected_uses: Int = 0;
    if sequence.arena.topology.node_kinds[0] == AstExpressionNodeLeaf() {
        left_value = DirectMirScalarCfgUseValueRow(
            use_facts, global_row, expected_uses,
            sequence.arena.node_texts[0], value_names
        );
        expected_uses = expected_uses + 1;
    } else if sequence.arena.topology.node_kinds[0] ==
            AstExpressionNodeIntegerLiteral() &&
        DirectMirScalarCfgCanonicalInt(sequence.arena.node_texts[0]) {
        left_literal = sequence.arena.node_texts[0];
    } else {
        return DirectMirScalarCfgExpressionFactEmpty();
    }
    if sequence.arena.topology.node_kinds[1] == AstExpressionNodeLeaf() {
        right_value = DirectMirScalarCfgUseValueRow(
            use_facts, global_row, expected_uses,
            sequence.arena.node_texts[1], value_names
        );
        expected_uses = expected_uses + 1;
    } else if sequence.arena.topology.node_kinds[1] ==
            AstExpressionNodeIntegerLiteral() &&
        DirectMirScalarCfgCanonicalInt(sequence.arena.node_texts[1]) {
        right_literal = sequence.arena.node_texts[1];
    } else {
        return DirectMirScalarCfgExpressionFactEmpty();
    }
    if MirRoutineInstructionUseCountAtGlobal(use_facts, global_row) !=
            expected_uses || (left_value < 0 && left_literal == "") ||
        (right_value < 0 && right_literal == "") {
        return DirectMirScalarCfgExpressionFactEmpty();
    }
    return DirectMirScalarCfgExpressionFact(
        true, DirectMirScalarCfgOpAddInt(), left_value, right_value,
        left_literal, right_literal
    );
}

func DirectMirScalarCfgConditionExpressionFact(
    ref instruction: JsonObjectFactTable,
    ref use_facts: MirRoutineInstructionUseFacts,
    global_row: Int,
    value_names: Array<String>
) -> DirectMirScalarCfgExpressionFact {
    let sequence: MirExpressionGraphSequence =
        DirectMirScalarCfgExpressionSequence(instruction);
    let count: Int = ArrayLength(sequence.arena.topology.node_kinds);
    if !sequence.ok || ArrayLength(sequence.roots) != 1 ||
        sequence.roots[0] != count - 1 ||
        !DirectMirScalarCfgNoCallTargets(sequence) {
        return DirectMirScalarCfgExpressionFactEmpty();
    }
    if count == 1 && sequence.arena.topology.node_kinds[0] ==
            AstExpressionNodeBoolLiteral() &&
        MirRoutineInstructionUseCountAtGlobal(use_facts, global_row) == 0 &&
        (sequence.arena.node_texts[0] == "true" ||
         sequence.arena.node_texts[0] == "false") {
        return DirectMirScalarCfgExpressionFact(
            true, DirectMirScalarCfgConditionBool(), -1, -1,
            sequence.arena.node_texts[0], ""
        );
    }
    if count != 3 || sequence.arena.topology.left_children[2] != 0 ||
        sequence.arena.topology.right_children[2] != 1 {
        return DirectMirScalarCfgExpressionFactEmpty();
    }
    let condition_kind: Int = 0;
    if sequence.arena.topology.node_kinds[2] == AstExpressionNodeLess() {
        condition_kind = DirectMirScalarCfgConditionLess();
    } else if sequence.arena.topology.node_kinds[2] ==
            AstExpressionNodeEquality() {
        condition_kind = DirectMirScalarCfgConditionEqual();
    } else if sequence.arena.topology.node_kinds[2] ==
            AstExpressionNodeGreater() {
        condition_kind = DirectMirScalarCfgConditionGreater();
    } else {
        return DirectMirScalarCfgExpressionFactEmpty();
    }
    let left_value: Int = -1;
    let right_value: Int = -1;
    let left_literal: String = "";
    let right_literal: String = "";
    let expected_uses: Int = 0;
    let node: Int = 0;
    while node < 2 {
        if sequence.arena.topology.node_kinds[node] ==
                AstExpressionNodeLeaf() {
            let value_row: Int = DirectMirScalarCfgUseValueRow(
                use_facts, global_row, expected_uses,
                sequence.arena.node_texts[node], value_names
            );
            if node == 0 { left_value = value_row; }
            else { right_value = value_row; }
            expected_uses = expected_uses + 1;
        } else if sequence.arena.topology.node_kinds[node] ==
                AstExpressionNodeIntegerLiteral() &&
            DirectMirScalarCfgCanonicalInt(sequence.arena.node_texts[node]) {
            if node == 0 { left_literal = sequence.arena.node_texts[node]; }
            else { right_literal = sequence.arena.node_texts[node]; }
        } else {
            return DirectMirScalarCfgExpressionFactEmpty();
        }
        node = node + 1;
    }
    if MirRoutineInstructionUseCountAtGlobal(use_facts, global_row) !=
            expected_uses || (left_value < 0 && left_literal == "") ||
        (right_value < 0 && right_literal == "") {
        return DirectMirScalarCfgExpressionFactEmpty();
    }
    return DirectMirScalarCfgExpressionFact(
        true, condition_kind, left_value, right_value,
        left_literal, right_literal
    );
}

func DirectMirScalarCfgLogExpressionFact(
    ref instruction: JsonObjectFactTable,
    ref use_facts: MirRoutineInstructionUseFacts,
    global_row: Int,
    value_names: Array<String>
) -> DirectMirScalarCfgExpressionFact {
    let sequence: MirExpressionGraphSequence =
        DirectMirScalarCfgExpressionSequence(instruction);
    let count: Int = ArrayLength(sequence.arena.topology.node_kinds);
    if !sequence.ok || ArrayLength(sequence.roots) != 1 ||
        sequence.roots[0] != count - 1 {
        return DirectMirScalarCfgExpressionFactEmpty();
    }
    if count == 1 && sequence.arena.topology.node_kinds[0] ==
            AstExpressionNodeStringLiteral() &&
        DirectMirScalarCfgNoCallTargets(sequence) &&
        MirRoutineInstructionUseCountAtGlobal(use_facts, global_row) == 0 {
        let content_opt: Option<String> = DirectMirAsciiLiteralContent(
            sequence.arena.node_texts[0]
        );
        if IsSome(content_opt) {
            return DirectMirScalarCfgExpressionFact(
                true, DirectMirScalarCfgOpLogString(), -1, -1,
                UnwrapOption(content_opt), ""
            );
        }
    }
    let value_node: Int = -1;
    if count == 1 && sequence.arena.topology.node_kinds[0] ==
            AstExpressionNodeLeaf() &&
        DirectMirScalarCfgNoCallTargets(sequence) {
        value_node = 0;
    } else if count == 4 && sequence.roots[0] == 3 &&
        sequence.arena.topology.node_kinds[0] == AstExpressionNodeLeaf() &&
        sequence.arena.node_texts[0] == "ToString" &&
        sequence.arena.topology.node_kinds[1] == AstExpressionNodeCall() &&
        sequence.arena.topology.left_children[1] == 0 &&
        sequence.arena.call_target_kinds[1] ==
            SemanticCallTargetDirect() &&
        sequence.arena.call_target_names[1] == "ToString" &&
        sequence.arena.topology.node_kinds[2] == AstExpressionNodeLeaf() &&
        sequence.arena.topology.node_kinds[3] ==
            AstExpressionNodeCallArgument() &&
        sequence.arena.topology.left_children[3] == 1 &&
        sequence.arena.topology.right_children[3] == 2 {
        value_node = 2;
    }
    if value_node < 0 ||
        MirRoutineInstructionUseCountAtGlobal(use_facts, global_row) != 1 {
        return DirectMirScalarCfgExpressionFactEmpty();
    }
    let value_row: Int = DirectMirScalarCfgUseValueRow(
        use_facts, global_row, 0,
        sequence.arena.node_texts[value_node], value_names
    );
    if value_row < 0 { return DirectMirScalarCfgExpressionFactEmpty(); }
    return DirectMirScalarCfgExpressionFact(
        true, DirectMirScalarCfgOpLogInt(), value_row, -1, "", ""
    );
}
