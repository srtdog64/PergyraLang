// Stable C consumer names delegated to the element-typed projection owner.

import "direct_mir_scalar_cfg_foreach_typed_c_emission_owner.pgy";

func DirectMirScalarCfgForEachCPreamble(
    ref plan: DirectMirScalarCfgGraphPlan, target: CompilerTargetProjectionFact
) -> String {
    return DirectMirScalarCfgForEachTypedCPreamble(plan, target);
}

func DirectMirScalarCfgForEachCDeclarations(
    ref plan: DirectMirScalarCfgGraphPlan, target: CompilerTargetProjectionFact
) -> String {
    return DirectMirScalarCfgForEachTypedCDeclarations(plan, target);
}

func DirectMirScalarCfgForEachCBlockEntry(
    ref plan: DirectMirScalarCfgGraphPlan, block: Int
) -> String {
    return DirectMirScalarCfgForEachTypedCBlockEntry(plan, block);
}

func DirectMirScalarCfgForEachCBlockExit(
    ref plan: DirectMirScalarCfgGraphPlan, block: Int
) -> String {
    return DirectMirScalarCfgForEachTypedCBlockExit(plan, block);
}

func DirectMirScalarCfgForEachCCondition(
    ref plan: DirectMirScalarCfgGraphPlan, block: Int
) -> String {
    return DirectMirScalarCfgForEachTypedCCondition(plan, block);
}
