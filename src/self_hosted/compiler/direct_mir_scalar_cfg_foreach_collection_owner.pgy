// Resolves one foreach collection definition from either a local Array<Int>
// literal or an admitted direct-call result. The expression graph and producer
// receipt own identity; display text is never reparsed.

import "direct_mir_array_int_producer_fact_owner.pgy";
import "direct_mir_array_return_graph_fact_owner.pgy";
import "direct_mir_scalar_cfg_wire_local_ref_owner.pgy";
import "direct_mir_scalar_cfg_foreach_collection_definition_owner.pgy";
import "../mir_lower/routine_fact_index_owner.pgy";
import "../mir_lower/routine_result_definition_fact_owner.pgy";

struct DirectMirScalarCfgForEachCollectionFact {
    let valid: Bool;
    let storage_identity: String;
    let elements: Array<Int>;
    let abi_layout_id: Int;
    let abi_size: Int;
    let abi_align: Int;
    let data_offset: Int;
    let length_offset: Int;
    let capacity_offset: Int;
    let allocator_offset: Int;
}

func DirectMirScalarCfgForEachCollectionFactEmpty(
) -> DirectMirScalarCfgForEachCollectionFact {
    let elements: Array<Int> = [];
    return DirectMirScalarCfgForEachCollectionFact(
        false, "", elements, 0, 0, 0, 0, 0, 0, 0
    );
}

func DirectMirScalarCfgForEachCollectionFactReady(
    ref fact: DirectMirScalarCfgForEachCollectionFact
) -> Bool {
    let layout: DirectMirArrayStorageLayoutContract =
        DirectMirArrayStorageLayoutContractFact();
    if !fact.valid || fact.storage_identity == "" ||
        ArrayLength(fact.elements) < 1 ||
        !DirectMirArrayStorageLayoutContractReady(layout) ||
        fact.abi_layout_id <= 0 || fact.abi_size != layout.size ||
        fact.abi_align != layout.align ||
        fact.data_offset != layout.data_offset ||
        fact.length_offset != layout.length_offset ||
        fact.capacity_offset != layout.capacity_offset ||
        fact.allocator_offset != layout.allocator_offset {
        return false;
    }
    let row: Int = 0;
    while row < ArrayLength(fact.elements) {
        if fact.elements[row] < -2147483648 ||
            fact.elements[row] > 2147483647 { return false; }
        row = row + 1;
    }
    return true;
}

func DirectMirScalarCfgForEachCollectionFromOwners(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    ref index: MirRoutineFactIndex,
    ref use_facts: MirRoutineInstructionUseFacts,
    ref wire: DirectMirScalarCfgWireLocalRefs,
    definition: MirRoutineResultDefinitionFact,
    declaration: MirRoutineInstructionScalarCapture,
    collection_value: String,
    collection_name: String,
    collection_hoisted: Bool,
    ref producer: DirectMirArrayIntProducerFact
) -> DirectMirScalarCfgForEachCollectionFact {
    let invalid: DirectMirScalarCfgForEachCollectionFact =
        DirectMirScalarCfgForEachCollectionFactEmpty();
    if !DirectMirScalarCfgForEachCollectionDefinitionReady(
        admitted, index, use_facts, wire, definition, declaration,
        collection_value, collection_name
    ) {
        return invalid;
    }
    let expression: MirProgramInstructionExpressionFact =
        MirProgramInstructionExpressionIndexAt(
            admitted.routines.instruction_expressions,
            definition.global_row
        );
    let graph: MirExpressionGraphSequence =
        DirectMirArrayIntGraphFromExpressionFact(
            admitted.routines.source_json, expression, 0
        );
    if collection_hoisted {
        if !DirectMirArrayIntProducerFactReady(producer) ||
            declaration.abi_type_name != "" ||
            !declaration.abi_type_value_ready ||
            DirectMirArrayReturnProducerName(graph) !=
                producer.routine_name {
            return invalid;
        }
        let returned: DirectMirScalarCfgForEachCollectionFact =
            DirectMirScalarCfgForEachCollectionFact(
                true, producer.storage_identity, producer.elements,
                producer.abi_layout_id, producer.abi_size,
                producer.abi_align, producer.data_offset,
                producer.length_offset, producer.capacity_offset,
                producer.allocator_offset
            );
        if !DirectMirScalarCfgForEachCollectionFactReady(returned) {
            return invalid;
        }
        return returned;
    }
    if declaration.abi_type_name != CompilerAbiLayoutArrayIntTypeName() {
        return invalid;
    }
    let abi_opt: Option<MirAbiLayoutRowCapture> =
        MirCapturedRequiredAbiLayoutRowAdmission(
            admitted.routines.source_json, declaration.abi_type_name,
            declaration.abi_type_value_ready, declaration.abi_type_start,
            declaration.abi_type_end, declaration.abi_layout_id_start,
            declaration.abi_layout_id_end,
            declaration.abi_layout_required_start,
            declaration.abi_layout_required_end,
            declaration.abi_layout_start, declaration.abi_layout_end
        );
    if !IsSome(abi_opt) { return invalid; }
    let abi: MirAbiLayoutRowCapture = UnwrapOption(abi_opt);
    if !DirectMirArrayIntCapturedAbiReady(abi) { return invalid; }
    let local: DirectMirScalarCfgForEachCollectionFact =
        DirectMirScalarCfgForEachCollectionFact(
            true, Concat("local-array:", declaration.result),
            DirectMirArrayIntLiteralElements(graph),
            MirAbiLayoutIdFromCapture(abi), ToInt(abi.size_text),
            ToInt(abi.align_text), ToInt(abi.field_offsets[0]),
            ToInt(abi.field_offsets[1]), ToInt(abi.field_offsets[2]),
            ToInt(abi.field_offsets[3])
        );
    if !DirectMirScalarCfgForEachCollectionFactReady(local) {
        return invalid;
    }
    return local;
}
