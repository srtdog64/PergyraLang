// LLVM storage, binding, cursor, and bound projection for sealed foreach receipts.

import "direct_mir_scalar_cfg_foreach_graph_readiness_owner.pgy";
import "direct_mir_array_int_abi_projection_owner.pgy";
import "direct_mir_array_int_emission_owner.pgy";

func DirectMirScalarCfgForEachLlvmAbi(
    ref fact: DirectMirScalarCfgForEachFact,
    target: CompilerTargetProjectionFact
) -> DirectMirArrayIntAbiProjection {
    return DirectMirArrayIntAbiProjectionFromCanonicalLayout(
        target, fact.abi_layout_id, fact.abi_size, fact.abi_align,
        fact.data_offset, fact.length_offset, fact.capacity_offset,
        fact.allocator_offset
    );
}

func DirectMirScalarCfgForEachLlvmPrefix(row: Int) -> String {
    return Concat("foreach.", ToString(row));
}

func DirectMirScalarCfgForEachLlvmDeclarations(
    ref plan: DirectMirScalarCfgGraphPlan,
    target: CompilerTargetProjectionFact
) -> String {
    let output: String = "";
    let row: Int = 0;
    while row < DirectMirScalarCfgForEachFactCount(plan.foreach_iterations) {
        let fact: DirectMirScalarCfgForEachFact =
            DirectMirScalarCfgForEachFactAt(plan.foreach_iterations, row);
        let abi: DirectMirArrayIntAbiProjection =
            DirectMirScalarCfgForEachLlvmAbi(fact, target);
        let prefix: String = DirectMirScalarCfgForEachLlvmPrefix(row);
        output = Concat(output, DirectMirArrayIntEmitLlvmValue(
            prefix, fact.elements, abi
        ));
        output = Concat(output, "  %pgy.foreach.");
        output = Concat(output, ToString(row));
        output = Concat(output, ".cursor = alloca i64, align 8\n");
        row = row + 1;
    }
    return output;
}

func DirectMirScalarCfgForEachLlvmBlockEntry(
    ref plan: DirectMirScalarCfgGraphPlan,
    target: CompilerTargetProjectionFact, block: Int
) -> String {
    let output: String = "";
    let row: Int = 0;
    while row < DirectMirScalarCfgForEachFactCount(plan.foreach_iterations) {
        let fact: DirectMirScalarCfgForEachFact =
            DirectMirScalarCfgForEachFactAt(plan.foreach_iterations, row);
        let abi: DirectMirArrayIntAbiProjection =
            DirectMirScalarCfgForEachLlvmAbi(fact, target);
        let stem: String = Concat(
            "%pgy.foreach.", Concat(ToString(row), ".")
        );
        if block == fact.init_block {
            output = Concat(output, "  store i64 0, ptr ");
            output = Concat(output, stem);
            output = Concat(output, "cursor, align 8\n");
        }
        if block == fact.body_block {
            output = Concat(output, "  ");
            output = Concat(output, stem);
            output = Concat(output, "body.cursor = load i64, ptr ");
            output = Concat(output, stem);
            output = Concat(output, "cursor, align 8\n  ");
            output = Concat(output, stem);
            output = Concat(output, "body.data = extractvalue ");
            output = Concat(output, abi.llvm_aggregate_type);
            output = Concat(output, " %pgy.array.");
            output = Concat(output, DirectMirScalarCfgForEachLlvmPrefix(row));
            output = Concat(output, ".3, ");
            output = Concat(output, ToString(abi.data_index));
            output = Concat(output, "\n  ");
            output = Concat(output, stem);
            output = Concat(output, "body.ptr = getelementptr inbounds ");
            output = Concat(output, abi.llvm_element_type);
            output = Concat(output, ", ptr ");
            output = Concat(output, stem);
            output = Concat(output, "body.data, i64 ");
            output = Concat(output, stem);
            output = Concat(output, "body.cursor\n  ");
            output = Concat(output, stem);
            output = Concat(output, "body.value = load ");
            output = Concat(output, abi.llvm_element_type);
            output = Concat(output, ", ptr ");
            output = Concat(output, stem);
            output = Concat(output, "body.ptr, align 4\n  ");
            output = Concat(output, stem);
            output = Concat(output, "body.wide = ");
            output = Concat(output, abi.llvm_print_extension);
            output = Concat(output, " ");
            output = Concat(output, abi.llvm_element_type);
            output = Concat(output, " ");
            output = Concat(output, stem);
            output = Concat(output, "body.value to ");
            output = Concat(output, abi.llvm_print_type);
            output = Concat(output, "\n  store i64 ");
            output = Concat(output, stem);
            output = Concat(output, "body.wide, ptr %pgy.local.");
            output = Concat(output, ToString(fact.binding_local_row));
            output = Concat(output, ", align 8\n");
        }
        row = row + 1;
    }
    return output;
}

func DirectMirScalarCfgForEachLlvmBlockExit(
    ref plan: DirectMirScalarCfgGraphPlan, block: Int
) -> String {
    let output: String = "";
    let row: Int = 0;
    while row < DirectMirScalarCfgForEachFactCount(plan.foreach_iterations) {
        let fact: DirectMirScalarCfgForEachFact =
            DirectMirScalarCfgForEachFactAt(plan.foreach_iterations, row);
        let edge: Int = 0;
        while edge < ArrayLength(fact.backedge_blocks) {
            if fact.backedge_blocks[edge] == block {
                let stem: String = Concat(
                    "%pgy.foreach.", Concat(ToString(row), ".backedge")
                );
                output = Concat(output, "  ");
                output = Concat(output, stem);
                output = Concat(output, " = load i64, ptr %pgy.foreach.");
                output = Concat(output, ToString(row));
                output = Concat(output, ".cursor, align 8\n  ");
                output = Concat(output, stem);
                output = Concat(output, ".next = add i64 ");
                output = Concat(output, stem);
                output = Concat(output, ", 1\n  store i64 ");
                output = Concat(output, stem);
                output = Concat(output, ".next, ptr %pgy.foreach.");
                output = Concat(output, ToString(row));
                output = Concat(output, ".cursor, align 8\n");
            }
            edge = edge + 1;
        }
        row = row + 1;
    }
    return output;
}

func DirectMirScalarCfgForEachLlvmCondition(
    ref plan: DirectMirScalarCfgGraphPlan,
    target: CompilerTargetProjectionFact, block: Int
) -> String {
    let found: Int = -1;
    let row: Int = 0;
    while row < DirectMirScalarCfgForEachFactCount(plan.foreach_iterations) {
        let fact: DirectMirScalarCfgForEachFact =
            DirectMirScalarCfgForEachFactAt(plan.foreach_iterations, row);
        if fact.header_block == block {
            if found >= 0 { Die("direct MIR scalar CFG foreach LLVM header is ambiguous"); }
            found = row;
        }
        row = row + 1;
    }
    if found < 0 { Die("direct MIR scalar CFG foreach LLVM header is missing"); }
    let fact: DirectMirScalarCfgForEachFact =
        DirectMirScalarCfgForEachFactAt(plan.foreach_iterations, found);
    let abi: DirectMirArrayIntAbiProjection =
        DirectMirScalarCfgForEachLlvmAbi(fact, target);
    let stem: String = Concat("%pgy.cond.", ToString(block));
    let output: String = Concat("  ", Concat(
        stem, Concat(".cursor = load i64, ptr %pgy.foreach.", Concat(
            ToString(found), ".cursor, align 8\n  "
        ))
    ));
    output = Concat(output, stem);
    output = Concat(output, ".length = extractvalue ");
    output = Concat(output, abi.llvm_aggregate_type);
    output = Concat(output, " %pgy.array.");
    output = Concat(output, DirectMirScalarCfgForEachLlvmPrefix(found));
    output = Concat(output, ".3, ");
    output = Concat(output, ToString(abi.length_index));
    output = Concat(output, "\n  ");
    output = Concat(output, stem);
    output = Concat(output, " = icmp ult i64 ");
    output = Concat(output, stem);
    output = Concat(output, ".cursor, ");
    output = Concat(output, stem);
    return Concat(output, ".length");
}
