// Stable LLVM consumer names delegated to the element-typed projection owner.

import "direct_mir_scalar_cfg_foreach_typed_llvm_emission_owner.pgy";
import "direct_mir_scalar_cfg_foreach_typed_llvm_condition_owner.pgy";

func DirectMirScalarCfgForEachLlvmDeclarations(
    ref plan: DirectMirScalarCfgGraphPlan, target: CompilerTargetProjectionFact
) -> String {
    return DirectMirScalarCfgForEachTypedLlvmDeclarations(plan, target);
}

func DirectMirScalarCfgForEachLlvmBlockEntry(
    ref plan: DirectMirScalarCfgGraphPlan,
    target: CompilerTargetProjectionFact, block: Int
) -> String {
    return DirectMirScalarCfgForEachTypedLlvmBlockEntry(plan, target, block);
}

func DirectMirScalarCfgForEachLlvmBlockExit(
    ref plan: DirectMirScalarCfgGraphPlan, block: Int
) -> String {
    return DirectMirScalarCfgForEachTypedLlvmBlockExit(plan, block);
}

func DirectMirScalarCfgForEachLlvmCondition(
    ref plan: DirectMirScalarCfgGraphPlan,
    target: CompilerTargetProjectionFact, block: Int
) -> String {
    return DirectMirScalarCfgForEachTypedLlvmCondition(plan, target, block);
}
