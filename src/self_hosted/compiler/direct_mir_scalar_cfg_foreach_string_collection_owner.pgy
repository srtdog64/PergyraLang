// Local Array<String> graph and ABI admission into the shared collection shape.

import "direct_mir_scalar_cfg_array_string_collection_owner.pgy";
import "direct_mir_scalar_cfg_foreach_collection_owner.pgy";

func DirectMirScalarCfgForEachStringCollectionFromOwners(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    ref index: MirRoutineFactIndex,
    ref use_facts: MirRoutineInstructionUseFacts,
    ref wire: DirectMirScalarCfgWireLocalRefs,
    definition: MirRoutineResultDefinitionFact,
    declaration: MirRoutineInstructionScalarCapture,
    collection_value: String, collection_name: String,
    inout string_elements: Array<String>
) -> DirectMirScalarCfgForEachCollectionFact {
    let invalid: DirectMirScalarCfgForEachCollectionFact =
        DirectMirScalarCfgForEachCollectionFactEmpty();
    let fact: DirectMirScalarCfgArrayStringCollectionFact =
        DirectMirScalarCfgArrayStringCollectionFromOwners(
            admitted, index, use_facts, wire, definition, declaration,
            collection_value, collection_name
        );
    if !DirectMirScalarCfgArrayStringCollectionFactReady(fact) {
        return invalid;
    }
    string_elements = fact.elements;
    let indices: Array<Int> = [];
    let row: Int = 0;
    while row < ArrayLength(string_elements) {
        ArrayPush(indices, row); row = row + 1;
    }
    let local: DirectMirScalarCfgForEachCollectionFact =
        DirectMirScalarCfgForEachCollectionFact(
            true, fact.storage_identity, indices,
            fact.abi_layout_id, fact.abi_size, fact.abi_align,
            fact.data_offset, fact.length_offset, fact.capacity_offset,
            fact.allocator_offset
        );
    if !DirectMirScalarCfgForEachCollectionFactReady(local) { return invalid; }
    return local;
}
