// Element-typed LLVM materialization for the shared foreach receipt set.

import "direct_mir_array_int_abi_projection_owner.pgy";
import "direct_mir_array_int_emission_owner.pgy";
import "direct_mir_array_string_abi_projection_owner.pgy";
import "direct_mir_scalar_cfg_foreach_graph_readiness_owner.pgy";
import "direct_mir_scalar_cfg_string_llvm_materialization_owner.pgy";
import "direct_mir_scalar_cfg_array_int_pop_llvm_storage_owner.pgy";

func DirectMirScalarCfgForEachTypedLlvmDeclarations(
    ref plan: DirectMirScalarCfgGraphPlan,
    target: CompilerTargetProjectionFact
) -> String {
    let output: String = ""; let row: Int = 0;
    while row < DirectMirScalarCfgForEachFactCount(plan.foreach_iterations) {
        let fact: DirectMirScalarCfgForEachFact =
            DirectMirScalarCfgForEachFactAt(plan.foreach_iterations, row);
        let type_name: String =
            DirectMirScalarCfgForEachElementTypeAtLoopSyntaxId(
                plan.foreach_elements, fact.loop_syntax_id
            );
        let storage_row: Int = DirectMirScalarCfgForEachStorageRow(
            plan.foreach_iterations, row
        );
        if storage_row == row && type_name == CompilerAbiLayoutIntTypeName() {
            let abi: DirectMirArrayIntAbiProjection =
                DirectMirArrayIntAbiProjectionFromCanonicalLayout(
                    target, fact.abi_layout_id, fact.abi_size,
                    fact.abi_align, fact.data_offset, fact.length_offset,
                    fact.capacity_offset, fact.allocator_offset
                );
            output = Concat(output, DirectMirArrayIntEmitLlvmValue(
                DirectMirScalarCfgForEachLlvmPrefix(row), fact.elements, abi
            ));
        } else if storage_row == row &&
                type_name == CompilerAbiLayoutStringTypeName() {
            let abi: DirectMirArrayStringAbiProjection =
                DirectMirArrayStringAbiProjectionFromCanonicalLayout(
                    target, fact.abi_layout_id, fact.abi_size,
                    fact.abi_align, fact.data_offset, fact.length_offset,
                    fact.capacity_offset, fact.allocator_offset
                );
            let strings: Array<String> =
                DirectMirScalarCfgForEachStringElementsAtLoopSyntaxId(
                    plan.foreach_elements, fact.loop_syntax_id
                );
            output = Concat(output,
                DirectMirScalarCfgForEachStringLlvmValue(row, strings, abi));
        }
        output = Concat(output,
            DirectMirScalarCfgArrayIntPopLlvmObjectDeclaration(
                plan, target, row
            ));
        output = Concat(output, "  %pgy.foreach.");
        output = Concat(output, ToString(row));
        output = Concat(output, ".cursor = alloca i64, align 8\n");
        row = row + 1;
    }
    return output;
}

func DirectMirScalarCfgForEachTypedLlvmBlockEntry(
    ref plan: DirectMirScalarCfgGraphPlan,
    target: CompilerTargetProjectionFact, block: Int
) -> String {
    let output: String = ""; let row: Int = 0;
    while row < DirectMirScalarCfgForEachFactCount(plan.foreach_iterations) {
        let fact: DirectMirScalarCfgForEachFact =
            DirectMirScalarCfgForEachFactAt(plan.foreach_iterations, row);
        let type_name: String =
            DirectMirScalarCfgForEachElementTypeAtLoopSyntaxId(
                plan.foreach_elements, fact.loop_syntax_id
            );
        let aggregate_type: String = ""; let element_type: String = "";
        let data_index: Int = -1; let align: Int = 0;
        if type_name == CompilerAbiLayoutIntTypeName() {
            let abi: DirectMirArrayIntAbiProjection =
                DirectMirArrayIntAbiProjectionFromCanonicalLayout(
                    target, fact.abi_layout_id, fact.abi_size,
                    fact.abi_align, fact.data_offset, fact.length_offset,
                    fact.capacity_offset, fact.allocator_offset
                );
            aggregate_type = abi.llvm_aggregate_type;
            element_type = abi.llvm_element_type;
            data_index = abi.data_index; align = 4;
        } else if type_name == CompilerAbiLayoutStringTypeName() {
            let abi: DirectMirArrayStringAbiProjection =
                DirectMirArrayStringAbiProjectionFromCanonicalLayout(
                    target, fact.abi_layout_id, fact.abi_size,
                    fact.abi_align, fact.data_offset, fact.length_offset,
                    fact.capacity_offset, fact.allocator_offset
                );
            aggregate_type = abi.llvm_aggregate_type;
            element_type = abi.llvm_element_type;
            data_index = abi.data_index; align = 8;
        } else { Die("direct MIR scalar CFG foreach LLVM element type is invalid"); }
        let stem: String = Concat("%pgy.foreach.", Concat(ToString(row), "."));
        let storage_row: Int = DirectMirScalarCfgForEachStorageRow(
            plan.foreach_iterations, row
        );
        if block == fact.init_block {
            output = Concat(output, Concat("  store i64 0, ptr ", stem));
            output = Concat(output, "cursor, align 8\n");
        }
        if block == fact.body_block {
            output = Concat(output, Concat("  ", stem));
            output = Concat(output, Concat("body.cursor = load i64, ptr ", stem));
            output = Concat(output, Concat("cursor, align 8\n  ", stem));
            output = Concat(output, Concat("body.data = extractvalue ", aggregate_type));
            output = Concat(output, " %pgy.array.");
            output = Concat(output, DirectMirScalarCfgForEachLlvmPrefix(storage_row));
            output = Concat(output, Concat(".3, ", ToString(data_index)));
            output = Concat(output, Concat("\n  ", stem));
            output = Concat(output, Concat("body.ptr = getelementptr inbounds ", element_type));
            output = Concat(output, Concat(", ptr ", stem));
            output = Concat(output, Concat("body.data, i64 ", stem));
            output = Concat(output, Concat("body.cursor\n  ", stem));
            output = Concat(output, Concat("body.value = load ", element_type));
            output = Concat(output, Concat(", ptr ", stem));
            output = Concat(output, Concat("body.ptr, align ", ToString(align)));
            output = Concat(output, "\n");
            if type_name == CompilerAbiLayoutIntTypeName() {
                output = Concat(output, Concat("  ", stem));
                output = Concat(output, "body.wide = sext i32 ");
                output = Concat(output, Concat(stem, "body.value to i64\n"));
                output = Concat(output, "  store i64 ");
                output = Concat(output, Concat(stem, "body.wide, ptr %pgy.local."));
            } else {
                output = Concat(output, "  store ptr ");
                output = Concat(output, Concat(stem, "body.value, ptr %pgy.local."));
            }
            output = Concat(output, ToString(fact.binding_local_row));
            output = Concat(output, ", align 8\n");
        }
        row = row + 1;
    }
    return output;
}

func DirectMirScalarCfgForEachTypedLlvmBlockExit(
    ref plan: DirectMirScalarCfgGraphPlan, block: Int
) -> String {
    let output: String = ""; let row: Int = 0;
    while row < DirectMirScalarCfgForEachFactCount(plan.foreach_iterations) {
        let fact: DirectMirScalarCfgForEachFact =
            DirectMirScalarCfgForEachFactAt(plan.foreach_iterations, row);
        let edge: Int = 0;
        while edge < ArrayLength(fact.backedge_blocks) {
            if fact.backedge_blocks[edge] == block {
                let stem: String = Concat("%pgy.foreach.", Concat(ToString(row), ".backedge"));
                output = Concat(output, Concat("  ", stem));
                output = Concat(output, " = load i64, ptr %pgy.foreach.");
                output = Concat(output, Concat(ToString(row), ".cursor, align 8\n  "));
                output = Concat(output, Concat(stem, ".next = add i64 "));
                output = Concat(output, Concat(stem, ", 1\n  store i64 "));
                output = Concat(output, Concat(stem, ".next, ptr %pgy.foreach."));
                output = Concat(output, Concat(ToString(row), ".cursor, align 8\n"));
            }
            edge = edge + 1;
        }
        row = row + 1;
    }
    return output;
}
