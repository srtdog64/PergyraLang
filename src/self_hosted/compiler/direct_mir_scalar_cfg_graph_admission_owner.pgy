// Admission and immutable-plan issuance for the general scalar CFG slice.
import "direct_mir_scalar_cfg_expression_owner.pgy";
import "direct_mir_scalar_cfg_assignment_target_owner.pgy";
import "direct_mir_scalar_cfg_graph_plan_seal_owner.pgy";
import "direct_mir_scalar_cfg_graph_input_owner.pgy";
import "direct_mir_scalar_cfg_local_ref_plan_owner.pgy";
import "direct_mir_scalar_cfg_operation_plan_owner.pgy";
import "direct_mir_scalar_cfg_string_expression_owner.pgy";
import "direct_mir_scalar_cfg_string_array_expression_owner.pgy";
import "direct_mir_scalar_cfg_string_array_plan_binding_owner.pgy";
import "direct_mir_scalar_cfg_array_int_loop_mutation_binding_owner.pgy";
import "direct_mir_scalar_cfg_array_int_program_lookup_owner.pgy";
import "direct_mir_scalar_cfg_collection_expression_owner.pgy";
import "../mir_lower/phi_predecessor_binding_fact_owner.pgy";
func DirectMirScalarCfgGraphPlanFromAdmitted(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    routine_row: Int,
    ref producer: DirectMirArrayIntProducerFact
) -> DirectMirScalarCfgGraphPlan {
    if !DirectMirScalarCfgRoutineRouteClaimed(admitted, routine_row) {
        Die("direct MIR scalar CFG graph route was not claimed");
    }
    let input: DirectMirScalarCfgGraphInput =
        DirectMirScalarCfgGraphInputFromAdmitted(
            admitted, routine_row, producer
        );
    let index: MirRoutineFactIndex = input.index;
    let use_facts: MirRoutineInstructionUseFacts = input.use_facts;
    let wire: DirectMirScalarCfgWireLocalRefs = input.wire;
    let range_sources: DirectMirScalarCfgRangeFactSet = input.ranges;
    let foreach_sources: DirectMirScalarCfgForEachFactSet =
        input.foreach_facts;
    let foreach_elements: DirectMirScalarCfgForEachElementFacts = input.foreach_elements;
    let string_array_source: DirectMirScalarCfgStringArrayPlan = input.string_arrays;
    let array_int_source: DirectMirScalarCfgArrayIntLoopMutationFact =
        input.array_int_loop_mutation;
    let local_refs: DirectMirScalarCfgLocalRefPlan =
        DirectMirScalarCfgLocalRefPlanFromOwners(
            admitted, index, use_facts, wire, range_sources, foreach_sources,
            string_array_source, array_int_source
        );
    if !local_refs.valid { Die("direct MIR scalar CFG LocalRef plan is invalid"); }
    let type_plan: DirectMirScalarCfgValueTypePlan =
        DirectMirScalarCfgValueTypePlanFromOwners(
            index, local_refs, foreach_elements
        );
    if !type_plan.valid { Die("direct MIR scalar CFG value type plan is invalid"); }
    let string_arrays: DirectMirScalarCfgStringArrayPlan =
        DirectMirScalarCfgStringArrayPlanAtLocalRows(
            string_array_source, local_refs
        );
    let range_iterations: DirectMirScalarCfgRangeFactSet =
        DirectMirScalarCfgRangeFactsAtLocalRows(
            range_sources, local_refs.local_ref_kinds,
            local_refs.local_ref_syntax_ids
        );
    if DirectMirScalarCfgRangeFactCount(range_iterations) !=
            DirectMirScalarCfgRangeFactCount(range_sources) {
        Die("direct MIR scalar CFG range local binding is invalid");
    }
    let foreach_iterations: DirectMirScalarCfgForEachFactSet =
        DirectMirScalarCfgForEachFactsAtLocalRows(
            foreach_sources, local_refs.local_names,
            local_refs.local_ref_kinds, local_refs.local_ref_syntax_ids
        );
    if DirectMirScalarCfgForEachFactCount(foreach_iterations) !=
            DirectMirScalarCfgForEachFactCount(foreach_sources) {
        Die("direct MIR scalar CFG foreach local binding is invalid");
    }
    if !DirectMirScalarCfgLoopFlowFactsReady(
        index, admitted.routines, routine_row,
        range_iterations, foreach_iterations
    ) {
        Die("direct MIR scalar CFG loop facts are invalid");
    }
    let local_names: Array<String> = local_refs.local_names;
    let value_names: Array<String> = local_refs.value_names;
    let value_local_rows: Array<Int> = local_refs.value_local_rows;
    let value_definition_blocks: Array<Int> = local_refs.value_definition_blocks;
    let array_int_loop_mutation: DirectMirScalarCfgArrayIntLoopMutationFact =
        DirectMirScalarCfgArrayIntLoopMutationAtValueRows(
            array_int_source, value_names
        );
    if array_int_source.valid && !array_int_loop_mutation.valid {
        Die("direct MIR scalar CFG Array<Int> value binding is invalid");
    }

    let block_succ_true: Array<Int> = index.block_succ_true;
    let block_succ_false: Array<Int> = index.block_succ_false;
    let block_operation_starts: Array<Int> = []; let block_operation_counts: Array<Int> = [];
    let block_condition_kinds: Array<Int> = []; let block_condition_left_values: Array<Int> = [];
    let block_condition_right_values: Array<Int> = []; let block_condition_left_locals: Array<Int> = [];
    let block_condition_right_locals: Array<Int> = []; let block_condition_left_literals: Array<String> = [];
    let block_condition_right_literals: Array<String> = []; let operation_kinds: Array<Int> = [];
    let operation_result_values: Array<Int> = []; let operation_left_values: Array<Int> = [];
    let operation_right_values: Array<Int> = []; let operation_left_locals: Array<Int> = [];
    let operation_right_locals: Array<Int> = []; let operation_left_literals: Array<String> = [];
    let operation_right_literals: Array<String> = []; let operation_phi_starts: Array<Int> = [];
    let operation_phi_counts: Array<Int> = []; let phi_predecessor_blocks: Array<Int> = [];
    let phi_incoming_values: Array<Int> = [];

    let block: Int = 0;
    while block < ArrayLength(index.block_starts) {
        if !index.block_reachable[block] {
            Die("direct MIR scalar CFG contains an unreachable block");
        }
        let operation_start: Int = ArrayLength(operation_kinds);
        ArrayPush(block_operation_starts, operation_start);
        let condition: DirectMirScalarCfgExpressionFact =
            DirectMirScalarCfgExpressionFact(
                true, DirectMirScalarCfgConditionNone(), -1, -1,
                -1, -1, "", ""
            );
        let instruction_row: Int = 0;
        while instruction_row < index.block_instruction_counts[block] {
            let local_instruction: Int =
                index.block_instruction_starts[block] + instruction_row;
            let global_row: Int =
                index.instruction_facts.global_start + local_instruction;
            let kind: String = admitted.routines.instruction_kinds[global_row];
            let source: String =
                admitted.routines.instruction_source_types[global_row];
            let instruction: JsonObjectFactTable =
                JsonObjectFactTableFromBounds(
                    admitted.routines.source_json,
                    admitted.routines.instruction_starts[global_row],
                    admitted.routines.instruction_ends[global_row]
                );
            if kind == "def" && DirectMirScalarCfgForEachOwnsDefinition(
                    foreach_iterations, global_row
                ) || (kind == "def" &&
                    DirectMirScalarCfgStringArrayOwnsDefinition(
                        string_arrays, global_row
                    )) || (kind == "def" &&
                    DirectMirScalarCfgArrayIntOwnsDefinition(
                        array_int_loop_mutation, global_row
                    )) {
                // Collection storage is owned by the sealed foreach receipt.
            } else if kind == "def" {
                let scalar: MirRoutineInstructionScalarCapture =
                    MirRoutineInstructionFactBundleAtGlobal(
                        index.instruction_facts, global_row
                    );
                let result_value: Int =
                    DirectMirScalarCfgGraphValueRow(
                        value_names, scalar.result
                    );
                let expression: DirectMirScalarCfgExpressionFact =
                    DirectMirScalarCfgCollectionDefinitionExpressionFact(
                        string_arrays, array_int_loop_mutation,
                        scalar.abi_type_name, instruction, use_facts,
                        global_row, local_instruction, value_names,
                        local_refs, wire
                    );
                let string_access: Int = DirectMirScalarCfgStringArrayAccessRowAtGlobal(
                    string_arrays, global_row
                );
                if !scalar.valid || scalar.name != "ssa-def" ||
                    result_value < 0 || scalar.abi_type_name !=
                        type_plan.value_types[result_value] ||
                    !expression.valid ||
                    (source == "AST_LET_DECL" && scalar.arg1 != "") ||
                    (source == "AST_ASSIGNMENT" && scalar.arg1 != "local") ||
                    (source == "AST_ASSIGNMENT" &&
                        !DirectMirScalarCfgAssignmentTargetReady(
                            instruction, scalar.arg0
                        )) ||
                    (expression.left_value >= 0 &&
                        !DirectMirScalarCfgValueUseDominates(
                            index, value_names, value_local_rows,
                            expression.left_value,
                            block, instruction_row
                        )) ||
                    (expression.right_value >= 0 &&
                        !DirectMirScalarCfgValueUseDominates(
                            index, value_names, value_local_rows,
                            expression.right_value,
                            block, instruction_row
                        )) {
                    Die("direct MIR scalar CFG definition fact is invalid");
                }
                if string_access >= 0 {
                    string_arrays = DirectMirScalarCfgStringArrayPlanAtOperation(
                        string_arrays, global_row, ArrayLength(operation_kinds)
                    );
                }
                array_int_loop_mutation =
                    DirectMirScalarCfgArrayIntLoopMutationAtOperation(
                        array_int_loop_mutation, global_row,
                        ArrayLength(operation_kinds)
                    );
                DirectMirScalarCfgAppendOperation(
                    operation_kinds, operation_result_values,
                    operation_left_values, operation_right_values,
                    operation_left_locals, operation_right_locals,
                    operation_left_literals, operation_right_literals,
                    operation_phi_starts, operation_phi_counts,
                    expression.kind, result_value, expression,
                    ArrayLength(phi_predecessor_blocks), 0
                );
            } else if kind == "phi" {
                let phi: MirRoutinePhiFact = MirRoutinePhiFactAt(
                    index, admitted.routines, use_facts, routine_row,
                    block, instruction_row
                );
                let binding: MirPhiPredecessorBindingFact =
                    MirPhiPredecessorBindingFactFromOwners(index, phi);
                let result_value: Int =
                    DirectMirScalarCfgGraphValueRow(
                        value_names, phi.result_name
                    );
                if !MirPhiPredecessorBindingFactReady(
                        binding, phi.predecessor_count
                    ) || result_value < 0 {
                    Die("direct MIR scalar CFG predecessor/phi binding is invalid");
                }
                let phi_start: Int = ArrayLength(phi_predecessor_blocks);
                let predecessor_row: Int = 0;
                while predecessor_row < ArrayLength(
                    binding.predecessor_blocks
                ) {
                    let incoming_row: Int =
                        binding.incoming_rows[predecessor_row];
                    let incoming_value: Int =
                        DirectMirScalarCfgGraphValueRow(
                            value_names, phi.incoming_results[incoming_row]
                        );
                    if incoming_value < 0 ||
                        value_local_rows[incoming_value] !=
                            value_local_rows[result_value] {
                        Die("direct MIR scalar CFG phi ValueId local binding is invalid");
                    }
                    ArrayPush(
                        phi_predecessor_blocks,
                        binding.predecessor_blocks[predecessor_row]
                    );
                    ArrayPush(phi_incoming_values, incoming_value);
                    predecessor_row = predecessor_row + 1;
                }
                let phi_kind: Int = DirectMirScalarCfgPhiOperationKind(
                    type_plan.value_types[result_value]
                );
                let empty_expression: DirectMirScalarCfgExpressionFact =
                    DirectMirScalarCfgExpressionFact(
                        phi_kind != 0, phi_kind, -1, -1,
                        -1, -1, "", ""
                    );
                DirectMirScalarCfgAppendOperation(
                    operation_kinds, operation_result_values,
                    operation_left_values, operation_right_values,
                    operation_left_locals, operation_right_locals,
                    operation_left_literals, operation_right_literals,
                    operation_phi_starts, operation_phi_counts,
                    phi_kind, result_value,
                    empty_expression, phi_start,
                    ArrayLength(binding.predecessor_blocks)
                );
            } else if kind == "loop-init" {
                let range: DirectMirScalarCfgRangeIterationFact =
                    DirectMirScalarCfgRangeFactAtInitGlobalRow(
                        range_iterations, global_row
                    );
                let foreach: DirectMirScalarCfgForEachFact =
                    DirectMirScalarCfgForEachFactAtInitGlobalRow(
                        foreach_iterations, global_row
                    );
                if range.valid == foreach.valid || (range.valid &&
                    (!DirectMirScalarCfgRangeIterationFactReady(
                        range, ArrayLength(index.block_starts)
                    ) || block != range.init_block)) || (foreach.valid &&
                    (!DirectMirScalarCfgForEachFactReady(
                        foreach, ArrayLength(index.block_starts)
                    ) || block != foreach.init_block)) {
                    Die("direct MIR scalar CFG range initializer is invalid");
                }
            } else if kind == "stmt" {
                let scalar: MirRoutineInstructionScalarCapture =
                    MirRoutineInstructionFactBundleAtGlobal(
                        index.instruction_facts, global_row
                    );
                let string_access: Int = DirectMirScalarCfgStringArrayAccessRowAtGlobal(
                    string_arrays, global_row
                );
                let expression: DirectMirScalarCfgExpressionFact =
                    DirectMirScalarCfgCollectionStatementExpressionFact(
                        string_arrays, array_int_loop_mutation, scalar,
                        instruction, use_facts, global_row,
                        local_instruction, value_names, local_refs, wire,
                        type_plan
                    );
                let array_int_operation: Bool =
                    DirectMirScalarCfgArrayIntOperationGlobal(
                        array_int_loop_mutation, global_row
                    );
                if !scalar.valid || (string_access < 0 &&
                    !array_int_operation && scalar.arg0 != "Log") ||
                    scalar.result != "" || !expression.valid ||
                    (expression.left_value >= 0 &&
                        !DirectMirScalarCfgValueUseDominates(
                            index, value_names, value_local_rows,
                            expression.left_value,
                            block, instruction_row
                        )) {
                    Die("direct MIR scalar CFG Log fact is invalid");
                }
                if string_access >= 0 {
                    string_arrays = DirectMirScalarCfgStringArrayPlanAtOperation(
                        string_arrays, global_row, ArrayLength(operation_kinds)
                    );
                }
                array_int_loop_mutation =
                    DirectMirScalarCfgArrayIntLoopMutationAtOperation(
                        array_int_loop_mutation, global_row,
                        ArrayLength(operation_kinds)
                    );
                DirectMirScalarCfgAppendOperation(
                    operation_kinds, operation_result_values,
                    operation_left_values, operation_right_values,
                    operation_left_locals, operation_right_locals,
                    operation_left_literals, operation_right_literals,
                    operation_phi_starts, operation_phi_counts,
                    expression.kind, -1, expression,
                    ArrayLength(phi_predecessor_blocks), 0
                );
            } else if kind == "branch" {
                if instruction_row + 1 !=
                    index.block_instruction_counts[block] {
                    Die("direct MIR scalar CFG branch is not the terminator");
                }
                if source == "AST_BREAK" {
                    if index.block_succ_true[block] < 0 ||
                        index.block_succ_false[block] >= 0 ||
                        MirRoutineBlockDominates(
                            index, index.block_succ_true[block], block
                        ) ||
                        MirRoutineInstructionUseCountAtGlobal(
                            use_facts, global_row
                        ) != 0 {
                        Die("direct MIR scalar CFG break edge is invalid");
                    }
                } else if source == "AST_CONTINUE" {
                    if index.block_succ_true[block] < 0 ||
                        index.block_succ_false[block] >= 0 ||
                        !MirRoutineBlockDominates(
                            index, index.block_succ_true[block], block
                        ) || MirRoutineInstructionUseCountAtGlobal(
                            use_facts, global_row
                        ) != 0 {
                        Die("direct MIR scalar CFG continue edge is invalid");
                    }
                } else if source == "AST_FOR_LOOP" {
                    let foreach: DirectMirScalarCfgForEachFact =
                        DirectMirScalarCfgForEachFactAtBranchGlobalRow(
                            foreach_iterations, global_row
                        );
                    let range: DirectMirScalarCfgRangeIterationFact =
                        DirectMirScalarCfgRangeFactAtBranchGlobalRow(
                            range_iterations, global_row
                        );
                    if range.valid == foreach.valid || (range.valid &&
                        (!DirectMirScalarCfgRangeIterationFactReady(
                            range, ArrayLength(index.block_starts)
                        ) || block != range.header_block)) || (foreach.valid &&
                        (!DirectMirScalarCfgForEachFactReady(
                            foreach, ArrayLength(index.block_starts)
                        ) || block != foreach.header_block)) {
                        Die("direct MIR scalar CFG range branch is invalid");
                    }
                    if foreach.valid {
                        condition = DirectMirScalarCfgExpressionFact(
                            true, DirectMirScalarCfgConditionForEach(),
                            -1, -1, -1, -1, "", ""
                        );
                    } else if range.stop_value_id != "" {
                        condition = DirectMirScalarCfgExpressionFact(
                            true, DirectMirScalarCfgConditionLess(), -1, -1,
                            range.local_row, -1, "", ""
                        );
                    } else {
                        condition = DirectMirScalarCfgExpressionFact(
                            true, DirectMirScalarCfgConditionLess(), -1, -1,
                            range.local_row, -1, "", range.stop_literal
                        );
                    }
                } else {
                    condition =
                        DirectMirScalarCfgCollectionConditionExpressionFact(
                            string_arrays, array_int_loop_mutation,
                            instruction, use_facts, global_row,
                            local_instruction, value_names, local_refs, wire
                        );
                    if !condition.valid ||
                        index.block_succ_true[block] < 0 ||
                        (index.block_succ_false[block] < 0 &&
                            (condition.kind !=
                                DirectMirScalarCfgConditionBool() ||
                             condition.left_literal != "true")) ||
                        (condition.left_value >= 0 &&
                            !DirectMirScalarCfgValueUseDominates(
                                index, value_names, value_local_rows,
                                condition.left_value,
                                block, instruction_row
                            )) ||
                        (condition.right_value >= 0 &&
                            !DirectMirScalarCfgValueUseDominates(
                                index, value_names, value_local_rows,
                                condition.right_value,
                                block, instruction_row
                            )) {
                        Die("direct MIR scalar CFG condition fact is invalid");
                    }
                }
            }
            instruction_row = instruction_row + 1;
        }
        ArrayPush(
            block_operation_counts,
            ArrayLength(operation_kinds) - operation_start
        );
        ArrayPush(block_condition_kinds, condition.kind);
        ArrayPush(block_condition_left_values, condition.left_value);
        ArrayPush(block_condition_right_values, condition.right_value);
        ArrayPush(block_condition_left_locals, condition.left_local);
        ArrayPush(block_condition_right_locals, condition.right_local);
        ArrayPush(block_condition_left_literals, condition.left_literal);
        ArrayPush(block_condition_right_literals, condition.right_literal);
        block = block + 1;
    }
    return DirectMirScalarCfgSealGraphPlan(
        admitted, index, local_refs, type_plan,
        block_succ_true, block_succ_false,
        block_operation_starts, block_operation_counts,
        block_condition_kinds, block_condition_left_values,
        block_condition_right_values, block_condition_left_locals,
        block_condition_right_locals, block_condition_left_literals,
        block_condition_right_literals, operation_kinds,
        operation_result_values, operation_left_values,
        operation_right_values, operation_left_locals,
        operation_right_locals, operation_left_literals,
        operation_right_literals, operation_phi_starts,
        operation_phi_counts, phi_predecessor_blocks, phi_incoming_values,
        range_iterations, foreach_iterations, foreach_elements,
        string_arrays, array_int_loop_mutation
    );
}
