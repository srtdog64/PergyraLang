// Admission and immutable-plan issuance for the general scalar CFG slice.

import "direct_mir_scalar_cfg_expression_owner.pgy";
import "direct_mir_scalar_cfg_assignment_target_owner.pgy";
import "direct_mir_scalar_cfg_graph_readiness_owner.pgy";
import "direct_mir_scalar_cfg_graph_route_owner.pgy";
import "direct_mir_scalar_cfg_loop_flow_admission_owner.pgy";
import "direct_mir_scalar_cfg_local_ref_plan_owner.pgy";
import "direct_mir_scalar_cfg_operation_plan_owner.pgy";
import "../mir_lower/phi_fact_owner.pgy";
import "../mir_lower/phi_predecessor_binding_fact_owner.pgy";
import "../mir_lower/routine_fact_index_owner.pgy";
import "../mir_lower/routine_instruction_use_fact_owner.pgy";
import "../mir_lower/routine_result_definition_fact_owner.pgy";

func DirectMirScalarCfgGraphPlanFromAdmitted(
    ref admitted: MirMachineLayerAdmittedJsonInput
) -> DirectMirScalarCfgGraphPlan {
    if !DirectMirScalarCfgGraphRouteClaimed(admitted) {
        Die("direct MIR scalar CFG graph route was not claimed");
    }
    let index: MirRoutineFactIndex = BuildMirRoutineFactIndex(
        admitted.routines, 0
    );
    let instruction_count: Int = ArrayLength(index.instruction_facts.starts);
    let use_facts: MirRoutineInstructionUseFacts =
        BuildMirRoutineInstructionUseFacts(admitted.routines, 0);
    let range_source: DirectMirScalarCfgRangeIterationFact =
        DirectMirScalarCfgRangeIterationFactFromOwners(
            admitted, index, use_facts
        );
    if index.valid &&
        ArrayLength(index.loop_flow_summary_kinds) == 1 &&
        index.loop_flow_summary_kinds[0] == 1 &&
        !DirectMirScalarCfgRangeIterationFactSourceReady(
            range_source, ArrayLength(index.block_starts)
        ) {
        Die("direct MIR scalar CFG range iteration facts are invalid");
    }
    if !index.valid || !MirRoutineInstructionFactBundleReady(
            index.instruction_facts, ArrayLength(index.block_starts)
        ) || !MirRoutineInstructionUseFactsReady(
            use_facts, instruction_count
        ) || !MirRoutinePhiFactsReady(
            index, admitted.routines, use_facts, 0
        ) {
        Die("direct MIR scalar CFG typed index, use, or phi facts are invalid");
    }
    let local_refs: DirectMirScalarCfgLocalRefPlan =
        DirectMirScalarCfgLocalRefPlanFromOwners(
            admitted, index, range_source
        );
    if !local_refs.valid {
        Die("direct MIR scalar CFG LocalRef plan is invalid");
    }
    let range_iteration: DirectMirScalarCfgRangeIterationFact = range_source;
    if range_source.valid {
        range_iteration = DirectMirScalarCfgRangeIterationFactAtLocalRow(
            range_source, local_refs.range_local_row
        );
    }
    if !DirectMirScalarCfgLoopFlowFactsReady(
        index, admitted.routines, 0, range_iteration
    ) {
        Die("direct MIR scalar CFG loop facts are invalid");
    }
    let local_names: Array<String> = local_refs.local_names;
    let value_names: Array<String> = local_refs.value_names;
    let value_local_rows: Array<Int> = local_refs.value_local_rows;
    let value_definition_blocks: Array<Int> =
        local_refs.value_definition_blocks;

    let block_succ_true: Array<Int> = index.block_succ_true;
    let block_succ_false: Array<Int> = index.block_succ_false;
    let block_operation_starts: Array<Int> = [];
    let block_operation_counts: Array<Int> = [];
    let block_condition_kinds: Array<Int> = [];
    let block_condition_left_values: Array<Int> = [];
    let block_condition_right_values: Array<Int> = [];
    let block_condition_left_locals: Array<Int> = [];
    let block_condition_right_locals: Array<Int> = [];
    let block_condition_left_literals: Array<String> = [];
    let block_condition_right_literals: Array<String> = [];
    let operation_kinds: Array<Int> = [];
    let operation_result_values: Array<Int> = [];
    let operation_left_values: Array<Int> = [];
    let operation_right_values: Array<Int> = [];
    let operation_left_locals: Array<Int> = [];
    let operation_right_locals: Array<Int> = [];
    let operation_left_literals: Array<String> = [];
    let operation_right_literals: Array<String> = [];
    let operation_phi_starts: Array<Int> = [];
    let operation_phi_counts: Array<Int> = [];
    let phi_predecessor_blocks: Array<Int> = [];
    let phi_incoming_values: Array<Int> = [];

    let block: Int = 0;
    while block < ArrayLength(index.block_starts) {
        if !index.block_reachable[block] {
            Die("direct MIR scalar CFG contains an unreachable block");
        }
        let operation_start: Int = ArrayLength(operation_kinds);
        ArrayPush(block_operation_starts, operation_start);
        let condition: DirectMirScalarCfgExpressionFact =
            DirectMirScalarCfgExpressionFact(
                true, DirectMirScalarCfgConditionNone(), -1, -1,
                -1, -1, "", ""
            );
        let instruction_row: Int = 0;
        while instruction_row < index.block_instruction_counts[block] {
            let local_instruction: Int =
                index.block_instruction_starts[block] + instruction_row;
            let global_row: Int =
                index.instruction_facts.global_start + local_instruction;
            let kind: String = admitted.routines.instruction_kinds[global_row];
            let source: String =
                admitted.routines.instruction_source_types[global_row];
            let instruction: JsonObjectFactTable =
                JsonObjectFactTableFromBounds(
                    admitted.routines.source_json,
                    admitted.routines.instruction_starts[global_row],
                    admitted.routines.instruction_ends[global_row]
                );
            if kind == "def" {
                let scalar: MirRoutineInstructionScalarCapture =
                    MirRoutineInstructionFactBundleAtGlobal(
                        index.instruction_facts, global_row
                    );
                let result_value: Int =
                    DirectMirScalarCfgGraphValueRow(
                        value_names, scalar.result
                    );
                let expression: DirectMirScalarCfgExpressionFact =
                    DirectMirScalarCfgValueExpressionFact(
                        instruction, use_facts, global_row, value_names,
                        DirectMirScalarCfgRangeLocalName(
                            range_iteration, local_names
                        ), range_iteration.local_row
                    );
                if !scalar.valid || scalar.name != "ssa-def" ||
                    scalar.abi_type_name != "Int" || result_value < 0 ||
                    !expression.valid ||
                    (source == "AST_LET_DECL" && scalar.arg1 != "") ||
                    (source == "AST_ASSIGNMENT" && scalar.arg1 != "local") ||
                    (source == "AST_ASSIGNMENT" &&
                        !DirectMirScalarCfgAssignmentTargetReady(
                            instruction, scalar.arg0
                        )) ||
                    (expression.left_value >= 0 &&
                        !DirectMirScalarCfgValueUseDominates(
                            index, value_names, value_local_rows,
                            expression.left_value,
                            block, instruction_row
                        )) ||
                    (expression.right_value >= 0 &&
                        !DirectMirScalarCfgValueUseDominates(
                            index, value_names, value_local_rows,
                            expression.right_value,
                            block, instruction_row
                        )) {
                    Die("direct MIR scalar CFG definition fact is invalid");
                }
                DirectMirScalarCfgAppendOperation(
                    operation_kinds, operation_result_values,
                    operation_left_values, operation_right_values,
                    operation_left_locals, operation_right_locals,
                    operation_left_literals, operation_right_literals,
                    operation_phi_starts, operation_phi_counts,
                    expression.kind, result_value, expression,
                    ArrayLength(phi_predecessor_blocks), 0
                );
            } else if kind == "phi" {
                let phi: MirRoutinePhiFact = MirRoutinePhiFactAt(
                    index, admitted.routines, use_facts, 0,
                    block, instruction_row
                );
                let binding: MirPhiPredecessorBindingFact =
                    MirPhiPredecessorBindingFactFromOwners(index, phi);
                let result_value: Int =
                    DirectMirScalarCfgGraphValueRow(
                        value_names, phi.result_name
                    );
                if !MirPhiPredecessorBindingFactReady(
                        binding, phi.predecessor_count
                    ) || result_value < 0 {
                    Die("direct MIR scalar CFG predecessor/phi binding is invalid");
                }
                let phi_start: Int = ArrayLength(phi_predecessor_blocks);
                let predecessor_row: Int = 0;
                while predecessor_row < ArrayLength(
                    binding.predecessor_blocks
                ) {
                    let incoming_row: Int =
                        binding.incoming_rows[predecessor_row];
                    let incoming_value: Int =
                        DirectMirScalarCfgGraphValueRow(
                            value_names, phi.incoming_results[incoming_row]
                        );
                    if incoming_value < 0 ||
                        value_local_rows[incoming_value] !=
                            value_local_rows[result_value] {
                        Die("direct MIR scalar CFG phi ValueId local binding is invalid");
                    }
                    ArrayPush(
                        phi_predecessor_blocks,
                        binding.predecessor_blocks[predecessor_row]
                    );
                    ArrayPush(phi_incoming_values, incoming_value);
                    predecessor_row = predecessor_row + 1;
                }
                let empty_expression: DirectMirScalarCfgExpressionFact =
                    DirectMirScalarCfgExpressionFact(
                        true, DirectMirScalarCfgOpPhiInt(), -1, -1,
                        -1, -1, "", ""
                    );
                DirectMirScalarCfgAppendOperation(
                    operation_kinds, operation_result_values,
                    operation_left_values, operation_right_values,
                    operation_left_locals, operation_right_locals,
                    operation_left_literals, operation_right_literals,
                    operation_phi_starts, operation_phi_counts,
                    DirectMirScalarCfgOpPhiInt(), result_value,
                    empty_expression, phi_start,
                    ArrayLength(binding.predecessor_blocks)
                );
            } else if kind == "loop-init" {
                if !DirectMirScalarCfgRangeIterationFactReady(
                        range_iteration, ArrayLength(index.block_starts)
                    ) || global_row != range_iteration.init_global_row ||
                    block != range_iteration.init_block {
                    Die("direct MIR scalar CFG range initializer is invalid");
                }
            } else if kind == "stmt" {
                let scalar: MirRoutineInstructionScalarCapture =
                    MirRoutineInstructionFactBundleAtGlobal(
                        index.instruction_facts, global_row
                    );
                let expression: DirectMirScalarCfgExpressionFact =
                    DirectMirScalarCfgLogExpressionFact(
                        instruction, use_facts, global_row, value_names,
                        DirectMirScalarCfgRangeLocalName(
                            range_iteration, local_names
                        ), range_iteration.local_row
                    );
                if !scalar.valid || scalar.arg0 != "Log" ||
                    scalar.result != "" || !expression.valid ||
                    (expression.left_value >= 0 &&
                        !DirectMirScalarCfgValueUseDominates(
                            index, value_names, value_local_rows,
                            expression.left_value,
                            block, instruction_row
                        )) {
                    Die("direct MIR scalar CFG Log fact is invalid");
                }
                DirectMirScalarCfgAppendOperation(
                    operation_kinds, operation_result_values,
                    operation_left_values, operation_right_values,
                    operation_left_locals, operation_right_locals,
                    operation_left_literals, operation_right_literals,
                    operation_phi_starts, operation_phi_counts,
                    expression.kind, -1, expression,
                    ArrayLength(phi_predecessor_blocks), 0
                );
            } else if kind == "branch" {
                if instruction_row + 1 !=
                    index.block_instruction_counts[block] {
                    Die("direct MIR scalar CFG branch is not the terminator");
                }
                if source == "AST_BREAK" {
                    if index.block_succ_true[block] < 0 ||
                        index.block_succ_false[block] >= 0 ||
                        MirRoutineBlockDominates(
                            index, index.block_succ_true[block], block
                        ) ||
                        MirRoutineInstructionUseCountAtGlobal(
                            use_facts, global_row
                        ) != 0 {
                        Die("direct MIR scalar CFG break edge is invalid");
                    }
                } else if source == "AST_CONTINUE" {
                    if index.block_succ_true[block] < 0 ||
                        index.block_succ_false[block] >= 0 ||
                        !MirRoutineBlockDominates(
                            index, index.block_succ_true[block], block
                        ) || MirRoutineInstructionUseCountAtGlobal(
                            use_facts, global_row
                        ) != 0 {
                        Die("direct MIR scalar CFG continue edge is invalid");
                    }
                } else if source == "AST_FOR_LOOP" {
                    if !DirectMirScalarCfgRangeIterationFactReady(
                            range_iteration, ArrayLength(index.block_starts)
                        ) || global_row != range_iteration.branch_global_row ||
                        block != range_iteration.header_block {
                        Die("direct MIR scalar CFG range branch is invalid");
                    }
                    condition = DirectMirScalarCfgExpressionFact(
                        true, DirectMirScalarCfgConditionLess(), -1, -1,
                        range_iteration.local_row, -1, "",
                        range_iteration.stop_literal
                    );
                } else {
                    condition = DirectMirScalarCfgConditionExpressionFact(
                        instruction, use_facts, global_row, value_names,
                        DirectMirScalarCfgRangeLocalName(
                            range_iteration, local_names
                        ), range_iteration.local_row
                    );
                    if !condition.valid ||
                        index.block_succ_true[block] < 0 ||
                        (index.block_succ_false[block] < 0 &&
                            (condition.kind !=
                                DirectMirScalarCfgConditionBool() ||
                             condition.left_literal != "true")) ||
                        (condition.left_value >= 0 &&
                            !DirectMirScalarCfgValueUseDominates(
                                index, value_names, value_local_rows,
                                condition.left_value,
                                block, instruction_row
                            )) ||
                        (condition.right_value >= 0 &&
                            !DirectMirScalarCfgValueUseDominates(
                                index, value_names, value_local_rows,
                                condition.right_value,
                                block, instruction_row
                            )) {
                        Die("direct MIR scalar CFG condition fact is invalid");
                    }
                }
            }
            instruction_row = instruction_row + 1;
        }
        ArrayPush(
            block_operation_counts,
            ArrayLength(operation_kinds) - operation_start
        );
        ArrayPush(block_condition_kinds, condition.kind);
        ArrayPush(block_condition_left_values, condition.left_value);
        ArrayPush(block_condition_right_values, condition.right_value);
        ArrayPush(block_condition_left_locals, condition.left_local);
        ArrayPush(block_condition_right_locals, condition.right_local);
        ArrayPush(block_condition_left_literals, condition.left_literal);
        ArrayPush(block_condition_right_literals, condition.right_literal);
        block = block + 1;
    }
    let plan: DirectMirScalarCfgGraphPlan = DirectMirScalarCfgGraphPlan(
        true, DirectMirScalarCfgGraphPlanSchema(),
        CompilerArtifactPlanRevision(), 0,
        DirectMirCfgMirDigest(admitted.routines.source_json),
        DirectMirCfgDigestFromIndex(index), CompilerTargetCapabilitySchema(),
        CompilerTargetCapabilityFingerprint(), local_names,
        local_refs.local_ref_kinds, local_refs.local_ref_value_ids,
        local_refs.local_ref_syntax_ids, value_names,
        value_local_rows, value_definition_blocks,
        block_succ_true, block_succ_false,
        block_operation_starts, block_operation_counts,
        block_condition_kinds, block_condition_left_values,
        block_condition_right_values, block_condition_left_locals,
        block_condition_right_locals, block_condition_left_literals,
        block_condition_right_literals, operation_kinds,
        operation_result_values, operation_left_values,
        operation_right_values, operation_left_locals,
        operation_right_locals, operation_left_literals,
        operation_right_literals, operation_phi_starts,
        operation_phi_counts, phi_predecessor_blocks, phi_incoming_values,
        range_iteration
    );
    let verified: DirectMirScalarCfgGraphPlan =
        DirectMirScalarCfgGraphPlanWithDigest(
            plan, DirectMirScalarCfgGraphPlanDigest(plan)
        );
    if !DirectMirScalarCfgGraphPlanReady(verified) ||
        !DirectMirScalarCfgGraphPlanMutationRejected(verified) {
        Die("direct MIR scalar CFG verified plan identity is invalid");
    }
    return verified;
}
