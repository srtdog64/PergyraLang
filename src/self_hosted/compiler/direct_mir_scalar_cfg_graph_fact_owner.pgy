struct DirectMirScalarCfgGraphPlan {
    let valid: Bool;
    let schema: String;
    let revision: Int;
    let digest: Int;
    let mir_digest: Int;
    let cfg_digest: Int;
    let target_schema: String;
    let target_fingerprint: Int;
    let routines: DirectMirScalarCfgRoutinePartitionFact;
    let local_names: Array<String>;
    let local_types: Array<String>;
    let local_ref_kinds: Array<Int>;
    let local_ref_value_ids: Array<String>;
    let local_ref_syntax_ids: Array<Int>;
    let value_names: Array<String>;
    let value_types: Array<String>;
    let value_local_rows: Array<Int>;
    let value_definition_blocks: Array<Int>;
    let block_succ_true: Array<Int>;
    let block_succ_false: Array<Int>;
    let block_operation_starts: Array<Int>;
    let block_operation_counts: Array<Int>;
    let block_condition_kinds: Array<Int>;
    let block_condition_left_values: Array<Int>;
    let block_condition_right_values: Array<Int>;
    let block_condition_left_locals: Array<Int>;
    let block_condition_right_locals: Array<Int>;
    let block_condition_left_literals: Array<String>;
    let block_condition_right_literals: Array<String>;
    let operation_kinds: Array<Int>;
    let operation_result_values: Array<Int>;
    let operation_left_values: Array<Int>;
    let operation_right_values: Array<Int>;
    let operation_left_locals: Array<Int>;
    let operation_right_locals: Array<Int>;
    let operation_left_literals: Array<String>;
    let operation_right_literals: Array<String>;
    let operation_phi_starts: Array<Int>;
    let operation_phi_counts: Array<Int>;
    let phi_predecessor_blocks: Array<Int>;
    let phi_incoming_values: Array<Int>;
    let range_iterations: DirectMirScalarCfgRangeFactSet;
    let foreach_iterations: DirectMirScalarCfgForEachFactSet;
    let foreach_elements: DirectMirScalarCfgForEachElementFacts;
    let string_arrays: DirectMirScalarCfgStringArrayPlan;
    let array_int_program: DirectMirScalarCfgArrayIntProgramFact;
    let collection_pops: DirectMirScalarCfgCollectionPopProgramFact;
    let collections: DirectMirScalarCfgCollectionPlan;
    let string_concat_runtime_call_abi_id: Int;
    let program: DirectMirScalarCfgProgramExtensionFact;
}

func DirectMirScalarCfgGraphPlanSchema() -> String {
    return "pgy.selfhost.direct-mir-scalar-cfg-graph-plan.v19";
}

func DirectMirScalarCfgOpConstInt() -> Int { return 1; }
func DirectMirScalarCfgOpCopyInt() -> Int { return 2; }
func DirectMirScalarCfgOpAddInt() -> Int { return 3; }
func DirectMirScalarCfgOpPhiInt() -> Int { return 4; }
func DirectMirScalarCfgOpLogInt() -> Int { return 5; }
func DirectMirScalarCfgOpLogString() -> Int { return 6; }
func DirectMirScalarCfgOpConstString() -> Int { return 7; }
func DirectMirScalarCfgOpCopyString() -> Int { return 8; }
func DirectMirScalarCfgOpConcatString() -> Int { return 9; }
func DirectMirScalarCfgOpPhiString() -> Int { return 10; }
func DirectMirScalarCfgOpLogStringValue() -> Int { return 11; }
func DirectMirScalarCfgOpArraySetString() -> Int { return 12; }
func DirectMirScalarCfgOpArrayPushString() -> Int { return 13; }
func DirectMirScalarCfgOpLogArrayLength() -> Int { return 14; }
func DirectMirScalarCfgOpArrayPushInt() -> Int { return 15; }
func DirectMirScalarCfgOpAddArrayReadInt() -> Int { return 16; }
func DirectMirScalarCfgOpArraySetInt() -> Int { return 17; }
func DirectMirScalarCfgOpLogArrayIndexInt() -> Int { return 18; }
func DirectMirScalarCfgOpArrayReadInt() -> Int { return 19; }
func DirectMirScalarCfgOpArrayReverseInt() -> Int { return 20; }
func DirectMirScalarCfgOpArrayPopString() -> Int { return 21; }
func DirectMirScalarCfgOpArrayPopInt() -> Int { return 22; }
func DirectMirScalarCfgOpLogArrayIndexSumInt() -> Int { return 23; }
func DirectMirScalarCfgOpLogArrayIndexConcatString() -> Int { return 24; }
func DirectMirScalarCfgOpExpressionDefinition() -> Int { return 25; }
func DirectMirScalarCfgOpExpressionLog() -> Int { return 26; }
func DirectMirScalarCfgConditionNone() -> Int { return 0; }
func DirectMirScalarCfgConditionBool() -> Int { return 1; }
func DirectMirScalarCfgConditionLess() -> Int { return 2; }
func DirectMirScalarCfgConditionEqual() -> Int { return 3; }
func DirectMirScalarCfgConditionGreater() -> Int { return 4; }
func DirectMirScalarCfgConditionForEach() -> Int { return 5; }
func DirectMirScalarCfgConditionExpression() -> Int { return 6; }

func DirectMirScalarCfgGraphValueRow(
    names: Array<String>, wanted: String
) -> Int {
    let found: Int = 0 - 1;
    let row: Int = 0;
    while row < ArrayLength(names) {
        if names[row] == wanted {
            if found >= 0 { return 0 - 1; }
            found = row;
        }
        row = row + 1;
    }
    return found;
}
