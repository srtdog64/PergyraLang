// One indexed input boundary for scalar-CFG plan construction.

import "direct_mir_scalar_cfg_graph_route_owner.pgy";
import "direct_mir_scalar_cfg_loop_flow_admission_owner.pgy";
import "direct_mir_scalar_cfg_range_transfer_admission_owner.pgy";
import "direct_mir_scalar_cfg_foreach_admission_owner.pgy";
import "direct_mir_scalar_cfg_collection_plan_selection_owner.pgy";
import "../mir_lower/phi_fact_owner.pgy";

struct DirectMirScalarCfgGraphInput {
    let index: MirRoutineFactIndex;
    let use_facts: MirRoutineInstructionUseFacts;
    let wire: DirectMirScalarCfgWireLocalRefs;
    let ranges: DirectMirScalarCfgRangeFactSet;
    let foreach_facts: DirectMirScalarCfgForEachFactSet;
    let foreach_elements: DirectMirScalarCfgForEachElementFacts;
    let string_arrays: DirectMirScalarCfgStringArrayPlan;
    let array_int_program: DirectMirScalarCfgArrayIntProgramFact;
    let collections: DirectMirScalarCfgCollectionPlan;
}

func DirectMirScalarCfgGraphInputFromAdmittedForOwner(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    routine_row: Int,
    ref producer: DirectMirArrayIntProducerFact,
    program_expression_owner: Bool
) -> DirectMirScalarCfgGraphInput {
    let index: MirRoutineFactIndex = BuildMirRoutineFactIndex(
        admitted.routines, routine_row
    );
    let instruction_count: Int = ArrayLength(index.instruction_facts.starts);
    let use_facts: MirRoutineInstructionUseFacts =
        BuildMirRoutineInstructionUseFacts(admitted.routines, routine_row);
    let wire: DirectMirScalarCfgWireLocalRefs =
        DirectMirScalarCfgWireLocalRefsFromOwners(admitted, index);
    if !wire.valid { Die("direct MIR scalar CFG LocalRef plan is invalid"); }
    let foreach_admission: DirectMirScalarCfgForEachAdmission =
        DirectMirScalarCfgForEachFactsFromOwners(
            admitted, index, use_facts, wire, producer
        );
    let foreach_facts: DirectMirScalarCfgForEachFactSet =
        foreach_admission.facts;
    if !foreach_admission.valid ||
        DirectMirScalarCfgForEachFactCount(foreach_facts) !=
            DirectMirScalarCfgCollectionIterationCount(admitted, index) ||
        !DirectMirScalarCfgForEachFactSetSourceReady(
            foreach_facts, ArrayLength(index.block_starts)
        ) { Die("direct MIR scalar CFG foreach facts are invalid"); }
    let ranges: DirectMirScalarCfgRangeFactSet =
        DirectMirScalarCfgRangeIterationFactsFromOwners(
            admitted, index, use_facts, wire, foreach_facts
        );
    let expected_ranges: Int = 0;
    let flow_row: Int = 0;
    while flow_row < ArrayLength(index.loop_flow_summary_kinds) {
        if index.loop_flow_summary_kinds[flow_row] == 1 &&
            !DirectMirScalarCfgForEachFactAtLoopSyntaxId(
                foreach_facts, index.loop_flow_summary_loop_ids[flow_row]
            ).valid { expected_ranges = expected_ranges + 1; }
        flow_row = flow_row + 1;
    }
    if !index.valid || DirectMirScalarCfgRangeFactCount(ranges) !=
            expected_ranges {
        Die("direct MIR scalar CFG range iteration facts are invalid");
    }
    if !DirectMirScalarCfgRangeFactSetSourceReady(
        ranges, ArrayLength(index.block_starts)
    ) { Die("direct MIR scalar CFG range iteration facts are invalid"); }
    if !DirectMirScalarCfgRangeTransfersReady(index, ranges) {
        Die("direct MIR scalar CFG range transfer is invalid");
    }
    let selection: DirectMirScalarCfgCollectionPlanSelection =
        DirectMirScalarCfgCollectionPlanSelection(
            DirectMirScalarCfgCollectionPlanEmpty(),
            DirectMirScalarCfgStringArrayPlanEmpty(),
            DirectMirScalarCfgArrayIntProgramFactEmpty());
    if !program_expression_owner {
        selection = DirectMirScalarCfgCollectionPlansFromOwners(
            admitted, index, use_facts, wire, ranges, foreach_facts);
    }
    if !MirRoutineInstructionFactBundleReady(
            index.instruction_facts, ArrayLength(index.block_starts)
        ) || !MirRoutineInstructionUseFactsReady(
            use_facts, instruction_count
        ) || !MirRoutinePhiFactsReady(
            index, admitted.routines, use_facts, routine_row
        ) {
        Die("direct MIR scalar CFG typed index, use, or phi facts are invalid");
    }
    return DirectMirScalarCfgGraphInput(
        index, use_facts, wire, ranges, foreach_facts,
        foreach_admission.elements, selection.string_arrays,
        selection.array_int_program, selection.collections
    );
}

func DirectMirScalarCfgGraphInputFromAdmitted(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    routine_row: Int,
    ref producer: DirectMirArrayIntProducerFact
) -> DirectMirScalarCfgGraphInput {
    return DirectMirScalarCfgGraphInputFromAdmittedForOwner(
        admitted, routine_row, producer, false);
}

func DirectMirScalarCfgProgramGraphInputFromAdmitted(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    routine_row: Int,
    ref producer: DirectMirArrayIntProducerFact
) -> DirectMirScalarCfgGraphInput {
    return DirectMirScalarCfgGraphInputFromAdmittedForOwner(
        admitted, routine_row, producer, true);
}
