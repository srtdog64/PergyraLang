// Sealed identity for one ArrayLength-bounded indexed String operation.

import "direct_mir_scalar_cfg_array_string_collection_owner.pgy";
import "direct_mir_scalar_cfg_range_set_owner.pgy";

struct DirectMirScalarCfgIndexedStringArrayFact {
    let valid: Bool;
    let digest: Int;
    let definition_global_row: Int;
    let branch_global_row: Int;
    let assignment_global_row: Int;
    let header_block: Int;
    let body_block: Int;
    let loop_syntax_id: Int;
    let index_local_row: Int;
    let operation_row: Int;
    let collection_value_id: String;
    let collection_name: String;
    let storage_identity: String;
    let index_name: String;
    let target_name: String;
    let result_value_id: String;
    let elements: Array<String>;
    let abi_layout_id: Int;
    let abi_size: Int;
    let abi_align: Int;
    let data_offset: Int;
    let length_offset: Int;
    let capacity_offset: Int;
    let allocator_offset: Int;
}

func DirectMirScalarCfgIndexedStringArrayFactEmpty(
) -> DirectMirScalarCfgIndexedStringArrayFact {
    let strings: Array<String> = [];
    return DirectMirScalarCfgIndexedStringArrayFact(
        false, 0, -1, -1, -1, -1, -1, -1, -1, -1,
        "", "", "", "", "", "", strings, 0, 0, 0, 0, 0, 0, 0
    );
}

func DirectMirScalarCfgIndexedStringArrayFactDigest(
    ref fact: DirectMirScalarCfgIndexedStringArrayFact
) -> Int {
    if !fact.valid { return 0; }
    let hash: Long = DirectMirCfgHashInt(229L, fact.definition_global_row);
    hash = DirectMirCfgHashInt(hash, fact.branch_global_row);
    hash = DirectMirCfgHashInt(hash, fact.assignment_global_row);
    hash = DirectMirCfgHashInt(hash, fact.header_block);
    hash = DirectMirCfgHashInt(hash, fact.body_block);
    hash = DirectMirCfgHashInt(hash, fact.loop_syntax_id);
    hash = DirectMirCfgHashInt(hash, fact.index_local_row);
    hash = DirectMirCfgHashInt(hash, fact.operation_row);
    hash = DirectMirCfgHashString(hash, fact.collection_value_id);
    hash = DirectMirCfgHashString(hash, fact.collection_name);
    hash = DirectMirCfgHashString(hash, fact.storage_identity);
    hash = DirectMirCfgHashString(hash, fact.index_name);
    hash = DirectMirCfgHashString(hash, fact.target_name);
    hash = DirectMirCfgHashString(hash, fact.result_value_id);
    let row: Int = 0;
    while row < ArrayLength(fact.elements) {
        hash = DirectMirCfgHashString(hash, fact.elements[row]);
        row = row + 1;
    }
    hash = DirectMirCfgHashInt(hash, fact.abi_layout_id);
    hash = DirectMirCfgHashInt(hash, fact.abi_size);
    hash = DirectMirCfgHashInt(hash, fact.abi_align);
    hash = DirectMirCfgHashInt(hash, fact.data_offset);
    hash = DirectMirCfgHashInt(hash, fact.length_offset);
    hash = DirectMirCfgHashInt(hash, fact.capacity_offset);
    hash = DirectMirCfgHashInt(hash, fact.allocator_offset);
    return DirectMirCfgBoundedDigest(hash);
}

func DirectMirScalarCfgIndexedStringArrayFactWithDigest(
    fact: DirectMirScalarCfgIndexedStringArrayFact, digest: Int
) -> DirectMirScalarCfgIndexedStringArrayFact {
    return DirectMirScalarCfgIndexedStringArrayFact(
        fact.valid, digest, fact.definition_global_row,
        fact.branch_global_row, fact.assignment_global_row,
        fact.header_block, fact.body_block, fact.loop_syntax_id,
        fact.index_local_row, fact.operation_row,
        fact.collection_value_id, fact.collection_name,
        fact.storage_identity, fact.index_name, fact.target_name,
        fact.result_value_id,
        fact.elements, fact.abi_layout_id, fact.abi_size, fact.abi_align,
        fact.data_offset, fact.length_offset, fact.capacity_offset,
        fact.allocator_offset
    );
}

func DirectMirScalarCfgIndexedStringArrayFactAbsent(
    ref fact: DirectMirScalarCfgIndexedStringArrayFact
) -> Bool {
    return !fact.valid && fact.digest == 0 &&
        fact.definition_global_row < 0 && fact.branch_global_row < 0 &&
        fact.assignment_global_row < 0 && fact.header_block < 0 &&
        fact.body_block < 0 && fact.loop_syntax_id < 0 &&
        fact.index_local_row < 0 && fact.operation_row < 0 &&
        fact.collection_value_id == "" && fact.collection_name == "" &&
        fact.storage_identity == "" && fact.index_name == "" &&
        fact.target_name == "" && fact.result_value_id == "" &&
        ArrayLength(fact.elements) == 0 &&
        fact.abi_layout_id == 0 && fact.abi_size == 0 &&
        fact.abi_align == 0 && fact.data_offset == 0 &&
        fact.length_offset == 0 && fact.capacity_offset == 0 &&
        fact.allocator_offset == 0;
}

func DirectMirScalarCfgIndexedStringArrayFactShapeReady(
    ref fact: DirectMirScalarCfgIndexedStringArrayFact,
    require_bound_rows: Bool
) -> Bool {
    let collection: DirectMirScalarCfgArrayStringCollectionFact =
        DirectMirScalarCfgArrayStringCollectionFact(
            fact.valid, fact.definition_global_row,
            fact.collection_value_id, fact.collection_name,
            fact.storage_identity, fact.elements, fact.abi_layout_id,
            fact.abi_size, fact.abi_align, fact.data_offset,
            fact.length_offset, fact.capacity_offset, fact.allocator_offset
        );
    return fact.valid && fact.digest != 0 &&
        fact.digest == DirectMirScalarCfgIndexedStringArrayFactDigest(fact) &&
        DirectMirScalarCfgArrayStringCollectionFactReady(collection) &&
        fact.branch_global_row >= 0 && fact.assignment_global_row >= 0 &&
        fact.header_block >= 0 && fact.body_block >= 0 &&
        fact.header_block != fact.body_block && fact.loop_syntax_id >= 0 &&
        ((require_bound_rows && fact.index_local_row >= 0 &&
            fact.operation_row >= 0) ||
         (!require_bound_rows && fact.index_local_row == -1 &&
            fact.operation_row == -1)) &&
        fact.index_name != "" && fact.target_name != "" &&
        fact.result_value_id != "";
}

func DirectMirScalarCfgIndexedStringArrayFactAtPlanRows(
    fact: DirectMirScalarCfgIndexedStringArrayFact,
    index_local_row: Int, operation_row: Int
) -> DirectMirScalarCfgIndexedStringArrayFact {
    let bound: DirectMirScalarCfgIndexedStringArrayFact =
        DirectMirScalarCfgIndexedStringArrayFact(
            fact.valid, 0, fact.definition_global_row,
            fact.branch_global_row, fact.assignment_global_row,
            fact.header_block, fact.body_block, fact.loop_syntax_id,
            index_local_row, operation_row, fact.collection_value_id,
            fact.collection_name, fact.storage_identity, fact.index_name,
            fact.target_name, fact.result_value_id, fact.elements,
            fact.abi_layout_id,
            fact.abi_size, fact.abi_align, fact.data_offset,
            fact.length_offset, fact.capacity_offset, fact.allocator_offset
        );
    return DirectMirScalarCfgIndexedStringArrayFactWithDigest(
        bound, DirectMirScalarCfgIndexedStringArrayFactDigest(bound)
    );
}

func DirectMirScalarCfgIndexedStringArrayOwnsDefinition(
    ref fact: DirectMirScalarCfgIndexedStringArrayFact, global_row: Int
) -> Bool {
    return fact.valid && fact.definition_global_row == global_row;
}

func DirectMirScalarCfgIndexedStringArrayOwnsHeader(
    ref fact: DirectMirScalarCfgIndexedStringArrayFact, block: Int
) -> Bool { return fact.valid && fact.header_block == block; }

func DirectMirScalarCfgIndexedStringArrayOwnsOperation(
    ref fact: DirectMirScalarCfgIndexedStringArrayFact, operation: Int
) -> Bool { return fact.valid && fact.operation_row == operation; }
