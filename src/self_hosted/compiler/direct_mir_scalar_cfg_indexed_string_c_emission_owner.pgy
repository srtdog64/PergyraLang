// C projection of one sealed ArrayLength-bounded parts[i] receipt.

import "direct_mir_scalar_cfg_array_c_materialization_owner.pgy";
import "direct_mir_scalar_cfg_indexed_string_graph_readiness_owner.pgy";
import "direct_mir_array_string_abi_projection_owner.pgy";

func DirectMirScalarCfgIndexedStringCPreamble(
    ref plan: DirectMirScalarCfgGraphPlan,
    target: CompilerTargetProjectionFact
) -> String {
    if DirectMirScalarCfgIndexedStringArrayFactAbsent(
        plan.indexed_string_array
    ) { return ""; }
    let fact: DirectMirScalarCfgIndexedStringArrayFact =
        plan.indexed_string_array;
    let abi: DirectMirArrayStringAbiProjection =
        DirectMirArrayStringAbiProjectionFromCanonicalLayout(
            target, fact.abi_layout_id, fact.abi_size, fact.abi_align,
            fact.data_offset, fact.length_offset, fact.capacity_offset,
            fact.allocator_offset
        );
    return Concat(
        "#include <stdint.h>\n#include <stddef.h>\n",
        DirectMirScalarCfgArrayCStruct(
            abi.c_element_type, abi.c_length_type, abi.c_array_type
        )
    );
}

func DirectMirScalarCfgIndexedStringCDeclarations(
    ref plan: DirectMirScalarCfgGraphPlan,
    target: CompilerTargetProjectionFact
) -> String {
    if DirectMirScalarCfgIndexedStringArrayFactAbsent(
        plan.indexed_string_array
    ) { return ""; }
    let fact: DirectMirScalarCfgIndexedStringArrayFact =
        plan.indexed_string_array;
    let abi: DirectMirArrayStringAbiProjection =
        DirectMirArrayStringAbiProjectionFromCanonicalLayout(
            target, fact.abi_layout_id, fact.abi_size, fact.abi_align,
            fact.data_offset, fact.length_offset, fact.capacity_offset,
            fact.allocator_offset
        );
    let count: String = ToString(ArrayLength(fact.elements));
    let output: String = Concat("    ", abi.c_element_type);
    output = Concat(output, " pgy_indexed_storage[");
    output = Concat(output, Concat(count, "] = {"));
    output = Concat(
        output, DirectMirScalarCfgArrayStringCElementList(fact.elements)
    );
    output = Concat(output, Concat("};\n    ", abi.c_array_type));
    output = Concat(
        output, " pgy_indexed_collection = {pgy_indexed_storage, "
    );
    output = Concat(output, Concat(count, Concat(", ", count)));
    return Concat(output, ", NULL};\n");
}

func DirectMirScalarCfgIndexedStringCCondition(
    ref plan: DirectMirScalarCfgGraphPlan, block: Int
) -> String {
    let fact: DirectMirScalarCfgIndexedStringArrayFact =
        plan.indexed_string_array;
    if !DirectMirScalarCfgIndexedStringArrayOwnsHeader(fact, block) {
        Die("direct MIR indexed String C condition is missing");
    }
    return Concat(
        "((size_t)pgy_local_", Concat(
            ToString(fact.index_local_row),
            ") < pgy_indexed_collection.length"
        )
    );
}

func DirectMirScalarCfgIndexedStringCOperand(
    ref plan: DirectMirScalarCfgGraphPlan, operation: Int
) -> String {
    let fact: DirectMirScalarCfgIndexedStringArrayFact =
        plan.indexed_string_array;
    if !DirectMirScalarCfgIndexedStringArrayOwnsOperation(fact, operation) {
        Die("direct MIR indexed String C operand is missing");
    }
    return Concat(
        "pgy_indexed_collection.data[pgy_local_",
        Concat(ToString(fact.index_local_row), "]")
    );
}
