// String concat operand admission from one sealed parts[i] receipt.

import "direct_mir_scalar_cfg_indexed_string_array_fact_owner.pgy";
import "direct_mir_scalar_cfg_leaf_operand_owner.pgy";

func DirectMirScalarCfgIndexedStringExpressionFact(
    ref receipt: DirectMirScalarCfgIndexedStringArrayFact,
    ref use_facts: MirRoutineInstructionUseFacts,
    global_row: Int, instruction_row: Int,
    value_names: Array<String>,
    ref local_refs: DirectMirScalarCfgLocalRefPlan,
    ref wire: DirectMirScalarCfgWireLocalRefs
) -> DirectMirScalarCfgExpressionFact {
    if !receipt.valid || receipt.assignment_global_row != global_row {
        return DirectMirScalarCfgExpressionFactEmpty();
    }
    let left: DirectMirScalarCfgLeafOperand =
        DirectMirScalarCfgLeafOperandFromOwners(
            use_facts, global_row, 0, instruction_row, 2,
            receipt.target_name,
            value_names, local_refs, wire
        );
    let left_use: Option<String> = MirRoutineInstructionUseAtGlobal(
        use_facts, global_row, 0
    );
    let collection_use: Option<String> = MirRoutineInstructionUseAtGlobal(
        use_facts, global_row, 1
    );
    if !left.valid || left.use_count != 1 || !IsSome(left_use) ||
        !IsSome(collection_use) ||
        UnwrapOption(collection_use) != receipt.collection_value_id {
        return DirectMirScalarCfgExpressionFactEmpty();
    }
    return DirectMirScalarCfgExpressionFact(
        true, DirectMirScalarCfgOpConcatString(), left.value_row, -1,
        left.local_row, -1, "", ""
    );
}
