// LLVM projection of one sealed ArrayLength-bounded parts[i] receipt.

import "direct_mir_scalar_cfg_indexed_string_graph_readiness_owner.pgy";
import "direct_mir_scalar_cfg_array_string_llvm_value_owner.pgy";
import "direct_mir_scalar_cfg_string_llvm_materialization_owner.pgy";

func DirectMirScalarCfgIndexedStringLlvmGlobals(
    ref plan: DirectMirScalarCfgGraphPlan
) -> String {
    if DirectMirScalarCfgIndexedStringArrayFactAbsent(
        plan.indexed_string_array
    ) { return ""; }
    let output: String = "";
    let item: Int = 0;
    while item < ArrayLength(plan.indexed_string_array.elements) {
        output = Concat(output, DirectMirScalarCfgStringLlvmConstant(
            Concat(".pgy.scalar.cfg.indexed.", ToString(item)),
            plan.indexed_string_array.elements[item]
        ));
        item = item + 1;
    }
    return output;
}

func DirectMirScalarCfgIndexedStringLlvmDeclarations(
    ref plan: DirectMirScalarCfgGraphPlan,
    target: CompilerTargetProjectionFact
) -> String {
    if DirectMirScalarCfgIndexedStringArrayFactAbsent(
        plan.indexed_string_array
    ) { return ""; }
    let fact: DirectMirScalarCfgIndexedStringArrayFact =
        plan.indexed_string_array;
    let abi: DirectMirArrayStringAbiProjection =
        DirectMirArrayStringAbiProjectionFromCanonicalLayout(
            target, fact.abi_layout_id, fact.abi_size, fact.abi_align,
            fact.data_offset, fact.length_offset, fact.capacity_offset,
            fact.allocator_offset
        );
    return DirectMirScalarCfgArrayStringLlvmValue(
        "indexed", ".pgy.scalar.cfg.indexed", fact.elements, abi
    );
}

func DirectMirScalarCfgIndexedStringLlvmOperand(
    ref plan: DirectMirScalarCfgGraphPlan,
    target: CompilerTargetProjectionFact, operation: Int
) -> String {
    let fact: DirectMirScalarCfgIndexedStringArrayFact =
        plan.indexed_string_array;
    if !DirectMirScalarCfgIndexedStringArrayOwnsOperation(fact, operation) {
        Die("direct MIR indexed String LLVM operand is missing");
    }
    let abi: DirectMirArrayStringAbiProjection =
        DirectMirArrayStringAbiProjectionFromCanonicalLayout(
            target, fact.abi_layout_id, fact.abi_size, fact.abi_align,
            fact.data_offset, fact.length_offset, fact.capacity_offset,
            fact.allocator_offset
        );
    let stem: String = Concat("%pgy.op.", ToString(operation));
    let output: String = Concat("  ", Concat(stem,
        Concat(".index = load i64, ptr %pgy.local.", Concat(
            ToString(fact.index_local_row), ", align 8\n  "
        ))));
    output = Concat(output, Concat(stem, ".array.data = extractvalue "));
    output = Concat(output, Concat(
        abi.llvm_aggregate_type, " %pgy.array.indexed.3, "
    ));
    output = Concat(output, Concat(ToString(abi.data_index), Concat("\n  ", stem)));
    output = Concat(output, Concat(
        ".array.ptr = getelementptr inbounds ptr, ptr ", stem
    ));
    output = Concat(output, Concat(".array.data, i64 ", stem));
    output = Concat(output, Concat(".index\n  ", stem));
    output = Concat(output, Concat(
        ".right = load ptr, ptr ", stem
    ));
    return Concat(output, ".array.ptr, align 8\n");
}

func DirectMirScalarCfgIndexedStringLlvmCondition(
    ref plan: DirectMirScalarCfgGraphPlan,
    target: CompilerTargetProjectionFact, block: Int
) -> String {
    let fact: DirectMirScalarCfgIndexedStringArrayFact =
        plan.indexed_string_array;
    if !DirectMirScalarCfgIndexedStringArrayOwnsHeader(fact, block) {
        Die("direct MIR indexed String LLVM condition is missing");
    }
    let abi: DirectMirArrayStringAbiProjection =
        DirectMirArrayStringAbiProjectionFromCanonicalLayout(
            target, fact.abi_layout_id, fact.abi_size, fact.abi_align,
            fact.data_offset, fact.length_offset, fact.capacity_offset,
            fact.allocator_offset
        );
    let stem: String = Concat("%pgy.cond.", ToString(block));
    let output: String = Concat("  ", Concat(stem,
        Concat(".index = load i64, ptr %pgy.local.", Concat(
            ToString(fact.index_local_row), ", align 8\n  "
        ))));
    output = Concat(output, Concat(stem, ".length = extractvalue "));
    output = Concat(output, Concat(
        abi.llvm_aggregate_type, " %pgy.array.indexed.3, "
    ));
    output = Concat(output, Concat(ToString(abi.length_index), Concat("\n  ", stem)));
    output = Concat(output, Concat(" = icmp ult i64 ", stem));
    output = Concat(output, Concat(".index, ", stem));
    return Concat(output, ".length");
}
