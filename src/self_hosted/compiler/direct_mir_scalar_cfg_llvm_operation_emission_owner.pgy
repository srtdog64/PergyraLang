// Per-operation LLVM projection from the sealed typed scalar-CFG receipt.

import "direct_mir_scalar_cfg_llvm_operand_owner.pgy";
import "runtime_call_abi_structured_fact_owner.pgy";
import "direct_mir_scalar_cfg_string_array_llvm_emission_owner.pgy";
import "direct_mir_scalar_cfg_string_array_llvm_mutation_emission_owner.pgy";
import "direct_mir_scalar_cfg_llvm_collection_operation_emission_owner.pgy";

func DirectMirScalarCfgLlvmLoadedOperand(
    ref plan: DirectMirScalarCfgGraphPlan, operation: Int,
    side: String, llvm_type: String, value: Int, local: Int
) -> String {
    let output: String = Concat("  %pgy.op.", ToString(operation));
    output = Concat(output, Concat(".", side));
    output = Concat(output, Concat(" = load ", llvm_type));
    output = Concat(output, ", ptr ");
    output = Concat(output, DirectMirScalarCfgLlvmOperandLocal(
        plan, value, local
    ));
    return Concat(output, ", align 8\n");
}

func DirectMirScalarCfgEmitLlvmOperation(
    ref plan: DirectMirScalarCfgGraphPlan, operation: Int,
    formatted_print: CompilerRuntimeCallAbiFact,
    concat: CompilerRuntimeCallAbiFact,
    target: CompilerTargetProjectionFact
) -> String {
    let kind: Int = plan.operation_kinds[operation];
    let output: String = "";
    if kind == DirectMirScalarCfgOpConstInt() {
        output = Concat(output, "  store i64 ");
        output = Concat(output, plan.operation_left_literals[operation]);
        output = Concat(output, ", ptr ");
        output = Concat(output, DirectMirScalarCfgLlvmLocal(
            plan, plan.operation_result_values[operation]
        ));
        return Concat(output, ", align 8\n");
    }
    if kind == DirectMirScalarCfgOpConstString() {
        output = Concat(output, "  store ptr @.pgy.scalar.cfg.string.");
        output = Concat(output, ToString(operation));
        output = Concat(output, ", ptr ");
        output = Concat(output, DirectMirScalarCfgLlvmLocal(
            plan, plan.operation_result_values[operation]
        ));
        return Concat(output, ", align 8\n");
    }
    if kind == DirectMirScalarCfgOpCopyInt() ||
            kind == DirectMirScalarCfgOpAddInt() {
        output = Concat(output, DirectMirScalarCfgLlvmLoadedOperand(
            plan, operation, "left", "i64",
            plan.operation_left_values[operation],
            plan.operation_left_locals[operation]
        ));
        let result_operand: String = Concat(
            "%pgy.op.", Concat(ToString(operation), ".left")
        );
        if kind == DirectMirScalarCfgOpAddInt() {
            let right_operand: String =
                plan.operation_right_literals[operation];
            if plan.operation_right_values[operation] >= 0 ||
                    plan.operation_right_locals[operation] >= 0 {
                output = Concat(output, DirectMirScalarCfgLlvmLoadedOperand(
                    plan, operation, "right", "i64",
                    plan.operation_right_values[operation],
                    plan.operation_right_locals[operation]
                ));
                right_operand = Concat(
                    "%pgy.op.", Concat(ToString(operation), ".right")
                );
            }
            output = Concat(output, Concat("  %pgy.op.", ToString(operation)));
            output = Concat(output, ".sum = add i64 ");
            output = Concat(output, Concat(result_operand, ", "));
            output = Concat(output, Concat(right_operand, "\n"));
            result_operand = Concat(
                "%pgy.op.", Concat(ToString(operation), ".sum")
            );
        }
        output = Concat(output, Concat("  store i64 ", result_operand));
        output = Concat(output, ", ptr ");
        output = Concat(output, DirectMirScalarCfgLlvmLocal(
            plan, plan.operation_result_values[operation]
        ));
        return Concat(output, ", align 8\n");
    }
    if kind == DirectMirScalarCfgOpCopyString() ||
            kind == DirectMirScalarCfgOpConcatString() {
        output = Concat(output, DirectMirScalarCfgLlvmLoadedOperand(
            plan, operation, "left", "ptr",
            plan.operation_left_values[operation],
            plan.operation_left_locals[operation]
        ));
        let result_operand: String = Concat(
            "%pgy.op.", Concat(ToString(operation), ".left")
        );
        if kind == DirectMirScalarCfgOpConcatString() {
            if !CompilerRuntimeCallAbiStringConcatFactReady(concat) ||
                concat.runtime_call_abi_id !=
                    plan.string_concat_runtime_call_abi_id {
                Die("direct MIR scalar CFG LLVM concat receipt is invalid");
            }
            let indexed_row: Int =
                DirectMirScalarCfgStringArrayAccessRowAtOperation(
                    plan.string_arrays, operation
                );
            if indexed_row >= 0 && plan.string_arrays.accesses.kinds[indexed_row] ==
                    DirectMirScalarCfgStringArrayAccessConcatRead() {
                output = Concat(output,
                    DirectMirScalarCfgStringArrayLlvmRead(
                        plan, target, operation, "right"
                    ));
            } else {
                output = Concat(output, DirectMirScalarCfgLlvmLoadedOperand(
                    plan, operation, "right", "ptr",
                    plan.operation_right_values[operation],
                    plan.operation_right_locals[operation]
                ));
            }
            output = Concat(output, Concat("  %pgy.op.", ToString(operation)));
            output = Concat(output, Concat(".concat = call ptr @", concat.symbol));
            output = Concat(output, Concat("(ptr ", result_operand));
            output = Concat(output, Concat(", ptr %pgy.op.", ToString(operation)));
            output = Concat(output, ".right)\n");
            result_operand = Concat(
                "%pgy.op.", Concat(ToString(operation), ".concat")
            );
        }
        output = Concat(output, Concat("  store ptr ", result_operand));
        output = Concat(output, ", ptr ");
        output = Concat(output, DirectMirScalarCfgLlvmLocal(
            plan, plan.operation_result_values[operation]
        ));
        return Concat(output, ", align 8\n");
    }
    if kind == DirectMirScalarCfgOpLogInt() {
        output = Concat(output, DirectMirScalarCfgLlvmLoadedOperand(
            plan, operation, "log", "i64",
            plan.operation_left_values[operation],
            plan.operation_left_locals[operation]
        ));
        output = Concat(output, Concat("  %pgy.op.", ToString(operation)));
        output = Concat(output, Concat(".printed = call i32 (ptr, ...) @",
            formatted_print.symbol));
        output = Concat(output,
            "(ptr @.pgy.scalar.cfg.int.format, i64 %pgy.op.");
        output = Concat(output, Concat(ToString(operation), ".log)\n"));
        return output;
    }
    let indexed_row: Int = DirectMirScalarCfgStringArrayAccessRowAtOperation(
        plan.string_arrays, operation
    );
    if kind == DirectMirScalarCfgOpLogStringValue() && indexed_row >= 0 {
        output = Concat(output, DirectMirScalarCfgStringArrayLlvmRead(
            plan, target, operation, "log"
        ));
    } else if kind == DirectMirScalarCfgOpLogStringValue() {
        output = Concat(output, DirectMirScalarCfgLlvmLoadedOperand(
            plan, operation, "log", "ptr",
            plan.operation_left_values[operation],
            plan.operation_left_locals[operation]
        ));
    }
    if kind == DirectMirScalarCfgOpLogString() ||
            kind == DirectMirScalarCfgOpLogStringValue() {
        output = Concat(output, Concat("  %pgy.op.", ToString(operation)));
        output = Concat(output, Concat(".printed = call i32 (ptr, ...) @",
            formatted_print.symbol));
        output = Concat(output, "(ptr @.pgy.scalar.cfg.string.format, ptr ");
        if kind == DirectMirScalarCfgOpLogString() {
            output = Concat(output, "@.pgy.scalar.cfg.string.");
            output = Concat(output, ToString(operation));
        } else {
            output = Concat(output, Concat("%pgy.op.", ToString(operation)));
            output = Concat(output, ".log");
        }
        return Concat(output, ")\n");
    }
    let collection: DirectMirScalarCfgLlvmCollectionOperationEmission =
        DirectMirScalarCfgEmitLlvmCollectionOperation(
            plan, operation, formatted_print, target
        );
    if collection.valid { return collection.text; }
    if kind != DirectMirScalarCfgOpPhiInt() &&
        kind != DirectMirScalarCfgOpPhiString() {
        Die("direct MIR scalar CFG LLVM operation is unsupported");
    }
    return output;
}
