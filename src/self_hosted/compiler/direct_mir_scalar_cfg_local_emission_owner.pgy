// Target spelling for scalar local storage already sealed by the graph plan.

import "direct_mir_scalar_cfg_graph_fact_owner.pgy";

func DirectMirScalarCfgCLocalDeclarations(
    ref plan: DirectMirScalarCfgGraphPlan, int_c_type: String
) -> String {
    if int_c_type == "" { Die("direct MIR scalar CFG C local type is empty"); }
    let output: String = "";
    let row: Int = 0;
    while row < ArrayLength(plan.local_names) {
        output = Concat(output, "    ");
        if plan.local_types[row] == CompilerAbiLayoutStringTypeName() {
            output = Concat(output, CompilerAbiLayoutStringCValueType());
        } else if plan.local_types[row] == CompilerAbiLayoutBoolTypeName() {
            output = Concat(output, "bool");
        } else { output = Concat(output, int_c_type); }
        output = Concat(output, " pgy_local_");
        output = Concat(output, ToString(row));
        if plan.local_types[row] == CompilerAbiLayoutStringTypeName() {
            output = Concat(output, " = \"\";\n");
        } else { output = Concat(output, " = 0;\n"); }
        row = row + 1;
    }
    return output;
}

func DirectMirScalarCfgLlvmLocalDeclarations(
    ref plan: DirectMirScalarCfgGraphPlan
) -> String {
    let output: String = "";
    let row: Int = 0;
    while row < ArrayLength(plan.local_names) {
        output = Concat(output, "  %pgy.local.");
        output = Concat(output, ToString(row));
        if plan.local_types[row] == CompilerAbiLayoutStringTypeName() {
            output = Concat(output,
                " = alloca ptr, align 8\n  store ptr null, ptr %pgy.local."
            );
        } else if plan.local_types[row] == CompilerAbiLayoutBoolTypeName() {
            output = Concat(output,
                " = alloca i1, align 1\n  store i1 false, ptr %pgy.local."
            );
        } else { output = Concat(output,
            " = alloca i64, align 8\n  store i64 0, ptr %pgy.local."
        ); }
        output = Concat(output, ToString(row));
        if plan.local_types[row] == CompilerAbiLayoutBoolTypeName() {
            output = Concat(output, ", align 1\n");
        } else { output = Concat(output, ", align 8\n"); }
        row = row + 1;
    }
    return output;
}
