// Target spelling for scalar local storage already sealed by the graph plan.

import "direct_mir_scalar_cfg_graph_fact_owner.pgy";
import "direct_mir_scalar_cfg_llvm_local_emission_owner.pgy";

func DirectMirScalarCfgCLocalDeclarationsInRange(
    ref plan: DirectMirScalarCfgGraphPlan, int_c_type: String,
    start: Int, count: Int
) -> String {
    if int_c_type == "" || start < 0 || count < 0 ||
        start + count > ArrayLength(plan.local_names) {
        Die("direct MIR scalar CFG C local range is invalid");
    }
    let output: String = "";
    let row: Int = start;
    while row < start + count {
        output = Concat(output, "    ");
        if plan.local_types[row] == CompilerAbiLayoutStringTypeName() {
            output = Concat(output, CompilerAbiLayoutStringCValueType());
        } else if plan.local_types[row] == CompilerAbiLayoutBoolTypeName() {
            output = Concat(output, "bool");
        } else if plan.local_types[row] ==
                CompilerAbiLayoutArrayStringTypeName() {
            output = Concat(output,
                CompilerAbiLayoutArrayStringCValueType());
        } else { output = Concat(output, int_c_type); }
        output = Concat(output, " pgy_local_");
        output = Concat(output, ToString(row));
        if plan.local_types[row] == CompilerAbiLayoutStringTypeName() {
            output = Concat(output, " = \"\";\n");
        } else if plan.local_types[row] ==
                CompilerAbiLayoutArrayStringTypeName() {
            output = Concat(output, " = {0};\n");
        } else { output = Concat(output, " = 0;\n"); }
        row = row + 1;
    }
    return output;
}

func DirectMirScalarCfgCLocalDeclarations(
    ref plan: DirectMirScalarCfgGraphPlan, int_c_type: String
) -> String {
    return DirectMirScalarCfgCLocalDeclarationsInRange(
        plan, int_c_type, 0, ArrayLength(plan.local_names)
    );
}
