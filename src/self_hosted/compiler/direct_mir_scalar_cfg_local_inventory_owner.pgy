// Source-local inventory closure across scalar and collection owners.
import "direct_mir_scalar_cfg_foreach_set_owner.pgy";
import "direct_mir_scalar_cfg_type_family_owner.pgy";
import "direct_mir_scalar_cfg_string_array_plan_fact_owner.pgy";
import "direct_mir_scalar_cfg_string_array_plan_lookup_owner.pgy";
import "direct_mir_scalar_cfg_array_int_program_fact_owner.pgy";
import "direct_mir_scalar_cfg_array_int_program_lookup_owner.pgy";
import "direct_mir_scalar_cfg_collection_plan_fact_owner.pgy";
import "direct_mir_scalar_program_logical_record_fact_owner.pgy";
import "direct_mir_scalar_program_logical_record_array_value_result_policy_owner.pgy";
import "direct_mir_routine_parameter_set_fact_owner.pgy";
import "runtime_value_representation_owner.pgy";
import "direct_mir_scalar_program_referenced_enum_fact_owner.pgy";
import "../mir_lower/routine_fact_index_owner.pgy";
func DirectMirScalarCfgLocalInventoryReadyWithReferencedEnum(
    ref index: MirRoutineFactIndex,
    local_names: Array<String>, local_types: Array<String>,
    ref foreaches: DirectMirScalarCfgForEachFactSet,
    ref string_arrays: DirectMirScalarCfgStringArrayPlan,
    ref array_int_program: DirectMirScalarCfgArrayIntProgramFact,
    ref collections: DirectMirScalarCfgCollectionPlan,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    ref referenced_enum: DirectMirScalarProgramReferencedEnumFact,
    ref parameters: DirectMirRoutineParameterSetFact
) -> Bool {
    if ArrayLength(index.source_local_names) !=
        ArrayLength(index.source_local_types) ||
        ArrayLength(local_names) != ArrayLength(local_types) ||
        !DirectMirRoutineParameterSetFactReady(parameters) { return false; }
    let consumed: Array<Bool> = [];
    let row: Int = 0;
    while row < ArrayLength(index.source_local_names) {
        ArrayPush(consumed, false); row = row + 1;
    }
    row = 0;
    while row < ArrayLength(local_names) {
        let found: Int = -1; let source: Int = 0;
        while source < ArrayLength(index.source_local_names) {
            if !consumed[source] && index.source_local_names[source] ==
                    local_names[row] &&
                DirectMirScalarCfgSourceLocalTypeMatchesResolved(
                    index.source_local_types[source], local_types[row]) &&
                (DirectMirScalarCfgSourceLocalTypeSupported(
                    local_types[row]) ||
                 CompilerRuntimeValueTypeReady(
                    local_types[row]) ||
                 DirectMirScalarProgramLogicalRecordTypeReady(
                    logical_record, local_types[row]) ||
                 DirectMirScalarProgramLogicalRecordArrayTypeReady(
                    logical_record, local_types[row]) ||
                 DirectMirScalarProgramLogicalRecordOptionTypeReady(
                    logical_record, local_types[row]) ||
                 DirectMirScalarProgramPayloadEnumTypeReady(
                    referenced_enum, local_types[row])) {
                found = source; break;
            }
            source = source + 1;
        }
        let parameter_type: String = "";
        if found < 0 { parameter_type =
            DirectMirRoutineLocalParameterTypeAtName(
                parameters, local_names[row]); }
        if found < 0 && parameter_type == "" { return false; }
        if found >= 0 { ArraySet(consumed, found, true); }
        row = row + 1;
    }
    row = 0;
    while row < ArrayLength(index.source_local_names) {
        if !consumed[row] {
            let claimed: Bool = false;
            let fact_row: Int = 0;
            while fact_row < DirectMirScalarCfgForEachFactCount(foreaches) {
                let fact: DirectMirScalarCfgForEachFact =
                    DirectMirScalarCfgForEachFactAt(foreaches, fact_row);
                if fact.collection_name == index.source_local_names[row] &&
                    DirectMirScalarCfgCollectionTypeSupported(
                        index.source_local_types[row]
                    ) { claimed = true; }
                fact_row = fact_row + 1;
            }
            let collection_row: Int = 0;
            while collection_row <
                    DirectMirScalarCfgStringArrayCollectionCount(string_arrays) {
                if string_arrays.collections.names[collection_row] ==
                        index.source_local_names[row] &&
                    index.source_local_types[row] ==
                        CompilerAbiLayoutArrayStringTypeName() {
                    claimed = true;
                }
                collection_row = collection_row + 1;
            }
            if DirectMirScalarCfgArrayIntOwnsSourceLocal(
                array_int_program, index.source_local_names[row],
                index.source_local_types[row]
            ) { claimed = true; }
            if DirectMirScalarCfgCollectionOwnsSourceLocal(
                collections, index.source_local_names[row],
                index.source_local_types[row]
            ) {
                claimed = true;
            }
            if !claimed { return false; }
            ArraySet(consumed, row, true);
        }
        row = row + 1;
    }
    return true;
}

func DirectMirScalarCfgLocalInventoryReady(
    ref index: MirRoutineFactIndex,
    local_names: Array<String>, local_types: Array<String>,
    ref foreaches: DirectMirScalarCfgForEachFactSet,
    ref string_arrays: DirectMirScalarCfgStringArrayPlan,
    ref array_int_program: DirectMirScalarCfgArrayIntProgramFact,
    ref collections: DirectMirScalarCfgCollectionPlan,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    ref parameters: DirectMirRoutineParameterSetFact
) -> Bool {
    let referenced_enum: DirectMirScalarProgramReferencedEnumFact =
        DirectMirScalarProgramReferencedEnumFactCanonicalEmpty();
    return DirectMirScalarCfgLocalInventoryReadyWithReferencedEnum(
        index, local_names, local_types, foreaches, string_arrays,
        array_int_program, collections, logical_record, referenced_enum,
        parameters);
}
