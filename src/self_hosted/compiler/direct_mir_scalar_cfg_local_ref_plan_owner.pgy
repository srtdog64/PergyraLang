// Target-neutral local storage identities for the scalar CFG plan.

import "direct_mir_scalar_cfg_iteration_local_owner.pgy";
import "direct_mir_scalar_cfg_foreach_local_owner.pgy";
import "direct_mir_scalar_cfg_string_array_plan_fact_owner.pgy";
import "direct_mir_scalar_cfg_string_array_plan_lookup_owner.pgy";
import "direct_mir_scalar_cfg_array_int_program_fact_owner.pgy";
import "direct_mir_scalar_cfg_array_int_program_lookup_owner.pgy";
import "direct_mir_scalar_cfg_collection_plan_fact_owner.pgy";
import "direct_mir_scalar_cfg_local_inventory_owner.pgy";
import "direct_mir_scalar_cfg_graph_fact_owner.pgy";
import "direct_mir_scalar_cfg_wire_local_ref_owner.pgy";
import "../mir_lower/routine_result_definition_fact_owner.pgy";

struct DirectMirScalarCfgLocalRefPlan {
    let valid: Bool;
    let local_names: Array<String>;
    let local_ref_kinds: Array<Int>;
    let local_ref_value_ids: Array<String>;
    let local_ref_syntax_ids: Array<Int>;
    let value_names: Array<String>;
    let value_local_rows: Array<Int>;
    let value_definition_blocks: Array<Int>;
}

func DirectMirScalarCfgLocalRefPlanEmpty(
) -> DirectMirScalarCfgLocalRefPlan {
    let strings: Array<String> = [];
    let ints: Array<Int> = [];
    return DirectMirScalarCfgLocalRefPlan(
        false, strings, ints, strings, ints, strings, ints, ints
    );
}

func DirectMirScalarCfgValueLocalRow(
    names: Array<String>, wanted: String
) -> Int {
    let row: Int = 0;
    while row < ArrayLength(names) {
        if names[row] == wanted { return row; }
        row = row + 1;
    }
    return -1;
}

func DirectMirScalarCfgLocalRefPlanFromOwners(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    ref index: MirRoutineFactIndex,
    ref use_facts: MirRoutineInstructionUseFacts,
    ref wire: DirectMirScalarCfgWireLocalRefs,
    ref ranges: DirectMirScalarCfgRangeFactSet,
    ref foreach_sources: DirectMirScalarCfgForEachFactSet,
    ref string_arrays: DirectMirScalarCfgStringArrayPlan,
    ref array_int_program: DirectMirScalarCfgArrayIntProgramFact,
    ref collections: DirectMirScalarCfgCollectionPlan
) -> DirectMirScalarCfgLocalRefPlan {
    let empty: DirectMirScalarCfgLocalRefPlan =
        DirectMirScalarCfgLocalRefPlanEmpty();
    if !wire.valid {
        Die("direct MIR scalar CFG LocalRef wire is invalid"); return empty;
    }
    let local_names: Array<String> = [];
    let local_ref_kinds: Array<Int> = [];
    let local_ref_value_ids: Array<String> = [];
    let local_ref_syntax_ids: Array<Int> = [];
    let value_names: Array<String> = [];
    let value_local_rows: Array<Int> = [];
    let value_definition_blocks: Array<Int> = [];
    let instruction: Int = 0;
    while instruction < ArrayLength(index.instruction_facts.starts) {
        let result: String = index.instruction_facts.results[instruction];
        let global: Int = index.instruction_facts.global_start + instruction;
        let kind: String = admitted.routines.instruction_kinds[global];
        let source: String =
            admitted.routines.instruction_source_types[global];
        let wire_ref: String = wire.primary_refs[instruction];
        if wire.required &&
            ((result != "" && wire_ref == "") ||
             (result == "" && wire_ref != "" &&
              kind != "loop-init" && kind != "branch")) {
            Die("direct MIR scalar CFG instruction LocalRef coverage is invalid");
            return empty;
        }
        if result != "" && !DirectMirScalarCfgForEachOwnsDefinition(
            foreach_sources, global
        ) && !DirectMirScalarCfgStringArrayOwnsDefinition(
            string_arrays, global
        ) && !DirectMirScalarCfgArrayIntOwnsDefinition(
            array_int_program, global
        ) && !DirectMirScalarCfgCollectionOwnsDefinition(
            collections, global
        ) {
            if kind != "def" && kind != "phi" { return empty; }
            let local_name: String = index.instruction_facts.arg0s[instruction];
            if kind == "phi" {
                local_name = index.instruction_facts.names[instruction];
            }
            let local_identity: String = result;
            if wire.required { local_identity = wire_ref; }
            let local_row: Int = -1;
            if wire.required {
                local_row = DirectMirScalarCfgLocalIdentityRow(
                    local_ref_value_ids, local_identity
                );
            } else {
                local_row = DirectMirScalarCfgValueLocalRow(
                    local_names, local_name
                );
            }
            if (source == "AST_LET_DECL" && local_row >= 0) ||
                ((source == "AST_ASSIGNMENT" || kind == "phi") &&
                    DirectMirScalarCfgValueDefinitionConflictsWithRange(
                        ranges, local_name, local_identity, wire.required
                    )) {
                Die("direct MIR scalar CFG value LocalRef ownership is invalid");
                return empty;
            }
            if local_row < 0 {
                local_row = ArrayLength(local_names);
                ArrayPush(local_names, local_name);
                ArrayPush(local_ref_kinds, DirectMirScalarCfgLocalRefValue());
                ArrayPush(local_ref_value_ids, local_identity);
                ArrayPush(local_ref_syntax_ids, -1);
            } else if local_names[local_row] != local_name {
                Die("direct MIR scalar CFG LocalRef name identity disagrees");
                return empty;
            }
            let definition: MirRoutineResultDefinitionFact =
                MirRoutineFactIndexUniqueResultDefinition(index, result);
            if local_name == "" ||
                !MirRoutineResultDefinitionFactReady(definition) ||
                !MirSsaNameMatches(result, local_name, false) ||
                DirectMirScalarCfgGraphValueRow(value_names, result) >= 0 {
                Die("direct MIR scalar CFG result definition LocalRef is invalid");
                return empty;
            }
            ArrayPush(value_names, result);
            ArrayPush(value_local_rows, local_row);
            ArrayPush(value_definition_blocks, definition.block_id);
        }
        instruction = instruction + 1;
    }
    if !DirectMirScalarCfgAppendIterationLocals(
        admitted, index, use_facts, wire, ranges, local_names,
        local_ref_kinds, local_ref_value_ids, local_ref_syntax_ids
    ) {
        Die("direct MIR scalar CFG range LocalRef binding is invalid");
        return empty;
    }
    if !DirectMirScalarCfgAppendForEachLocals(
        index, wire, foreach_sources, local_names, local_ref_kinds,
        local_ref_value_ids, local_ref_syntax_ids
    ) {
        Die("direct MIR scalar CFG foreach LocalRef binding is invalid");
        return empty;
    }
    if !DirectMirScalarCfgLocalInventoryReady(
        index, local_names, foreach_sources, string_arrays,
        array_int_program, collections
    ) {
        Die("direct MIR scalar CFG foreach local inventory is invalid");
        return empty;
    }
    return DirectMirScalarCfgLocalRefPlan(
        true, local_names, local_ref_kinds, local_ref_value_ids,
        local_ref_syntax_ids, value_names, value_local_rows,
        value_definition_blocks
    );
}

func DirectMirScalarCfgLocalRefsReady(
    local_names: Array<String>, local_ref_kinds: Array<Int>,
    local_ref_value_ids: Array<String>, local_ref_syntax_ids: Array<Int>,
    value_local_rows: Array<Int>,
    ref ranges: DirectMirScalarCfgRangeFactSet,
    ref foreach_facts: DirectMirScalarCfgForEachFactSet
) -> Bool {
    let count: Int = ArrayLength(local_names);
    if count != ArrayLength(local_ref_kinds) ||
        count != ArrayLength(local_ref_value_ids) ||
        count != ArrayLength(local_ref_syntax_ids) {
        return false;
    }
    let row: Int = 0;
    while row < count {
        let kind: Int = local_ref_kinds[row];
        if local_names[row] == "" ||
            (kind == DirectMirScalarCfgLocalRefValue() &&
                (local_ref_value_ids[row] == "" ||
                 local_ref_syntax_ids[row] >= 0)) ||
            (kind == DirectMirScalarCfgLocalRefIteration() &&
                (local_ref_syntax_ids[row] < 0 ||
                 (local_ref_value_ids[row] != "" &&
                  local_ref_value_ids[row] != Concat(
                    "iteration:", Concat(
                        ToString(local_ref_syntax_ids[row]), ":0"
                    )
                  )))) ||
            (kind == DirectMirScalarCfgLocalRefForEach() &&
                (local_ref_syntax_ids[row] < 0 ||
                 (local_ref_value_ids[row] != "" &&
                  local_ref_value_ids[row] != Concat(
                      "iteration:", Concat(
                          ToString(local_ref_syntax_ids[row]), ":0"
                      )
                  )))) ||
            (kind != DirectMirScalarCfgLocalRefValue() &&
             kind != DirectMirScalarCfgLocalRefIteration() &&
             kind != DirectMirScalarCfgLocalRefForEach()) {
            return false;
        }
        let prior: Int = 0;
        while prior < row {
            if local_ref_value_ids[row] != "" &&
                local_ref_value_ids[prior] == local_ref_value_ids[row] {
                return false;
            }
            prior = prior + 1;
        }
        row = row + 1;
    }
    row = 0;
    while row < ArrayLength(value_local_rows) {
        let local_binding: Int = value_local_rows[row];
        if local_binding < 0 || local_binding >= count ||
            local_ref_kinds[local_binding] != DirectMirScalarCfgLocalRefValue() {
            return false;
        }
        row = row + 1;
    }
    return DirectMirScalarCfgIterationLocalsReady(
        local_names, local_ref_kinds, local_ref_value_ids,
        local_ref_syntax_ids, ranges
    ) && DirectMirScalarCfgForEachLocalsReady(
        local_names, local_ref_kinds, local_ref_syntax_ids, foreach_facts
    );
}
