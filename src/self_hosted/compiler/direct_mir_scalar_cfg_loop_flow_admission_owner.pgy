// Loop-flow receipt required by the general scalar CFG execution slice.
import "../mir_lower/routine_lower.pgy";
import "direct_mir_scalar_cfg_range_iteration_owner.pgy";
func DirectMirScalarCfgLoopFlowFactsReady(
    ref index: MirRoutineFactIndex, ref routines: MirProgramRoutineIndex,
    routine_row: Int, ref ranges: DirectMirScalarCfgRangeFactSet,
    ref foreaches: DirectMirScalarCfgForEachFactSet
) -> Bool {
    if !LoopFlowSummaryProjectionReady(index, routines, routine_row) ||
        !MirRoutineFactIndexLoopFlowFactsValid(index) ||
        ArrayLength(index.loop_flow_state_stable_indices) != 0 { return false; }
    let row: Int = 0;
    let claimed: Int = 0;
    while row < ArrayLength(index.loop_flow_summary_loop_ids) {
        let kind: Int = index.loop_flow_summary_kinds[row];
        if (kind != 0 && kind != 1) ||
            index.loop_flow_summary_effect_bases[row] != 0 ||
            index.loop_flow_summary_effect_deltas[row] != 0 ||
            index.loop_flow_summary_flags[row] != 1 ||
            index.loop_flow_summary_entry_starts[row] != 0 ||
            index.loop_flow_summary_entry_counts[row] != 0 ||
            index.loop_flow_summary_exit_starts[row] != 0 ||
            index.loop_flow_summary_exit_counts[row] != 0 { return false; }
        let loop_id: Int = index.loop_flow_summary_loop_ids[row];
        let range: DirectMirScalarCfgRangeIterationFact =
            DirectMirScalarCfgRangeFactAtLoopSyntaxId(ranges, loop_id);
        let foreach: DirectMirScalarCfgForEachFact =
            DirectMirScalarCfgForEachFactAtLoopSyntaxId(foreaches, loop_id);
        if kind == 1 {
            if range.valid == foreach.valid || (range.valid &&
                !DirectMirScalarCfgRangeIterationFactReady(range,
                    ArrayLength(index.block_starts))) || (foreach.valid &&
                !DirectMirScalarCfgForEachFactReady(foreach,
                    ArrayLength(index.block_starts))) { return false; }
            claimed = claimed + 1;
        } else if range.valid || foreach.valid { return false; }
        row = row + 1;
    }
    return claimed == DirectMirScalarCfgRangeFactCount(ranges) + DirectMirScalarCfgForEachFactCount(foreaches);
}
