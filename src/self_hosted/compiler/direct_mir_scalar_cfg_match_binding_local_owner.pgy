// Match-payload locals admitted from MIR-carried binding/type facts.

import "direct_mir_scalar_cfg_local_ref_identity_owner.pgy";
import "direct_mir_scalar_cfg_type_family_owner.pgy";
import "direct_mir_scalar_program_logical_record_fact_owner.pgy";
import "../mir/local_ref_identity_owner.pgy";
import "../mir_lower/match_json_fact_owner.pgy";

func DirectMirScalarCfgAppendMatchBindingLocals(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    ref index: MirRoutineFactIndex,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    inout local_names: Array<String>,
    inout local_ref_kinds: Array<Int>,
    inout local_ref_value_ids: Array<String>,
    inout local_ref_syntax_ids: Array<Int>
) -> Bool {
    if !index.valid || ToInt(index.source_syntax_id) <= 0 ||
        ArrayLength(index.instruction_facts.starts) !=
            ArrayLength(index.instruction_facts.ends) {
        return false;
    }
    if index.declared_source_local_count < 0 ||
        index.declared_source_local_count > ArrayLength(index.source_local_names) ||
        ArrayLength(index.source_local_names) != ArrayLength(index.source_local_types) ||
        ArrayLength(index.source_local_names) !=
            ArrayLength(index.match_binding_origins.instruction_global_rows) ||
        ArrayLength(index.source_local_names) !=
            ArrayLength(index.match_binding_origins.binding_ordinals) { return false; }
    let row: Int = index.declared_source_local_count;
    while row < ArrayLength(index.source_local_names) {
        let global: Int = index.match_binding_origins.instruction_global_rows[row];
        if global < 0 || global >= ArrayLength(
                admitted.routines.instruction_source_types) ||
            admitted.routines.instruction_source_types[global] !=
                "AST_MATCH_CASE" || index.match_binding_origins.binding_ordinals[row] < 0 ||
            MirMatchBindingSourceRowAtOrigin(
                index.match_binding_origins,
                global, index.match_binding_origins.binding_ordinals[row]) != row {
            return false;
        }
        let name: String = index.source_local_names[row];
        let type_name: String = index.source_local_types[row];
        if name == "" || type_name == "" ||
            (!DirectMirScalarCfgScalarTypeSupported(type_name) &&
             !DirectMirScalarProgramLogicalRecordTypeReady(
                logical_record, type_name)) { return false; }
        let identity: String = SelfMirLocalRef(
            "destructure", ToInt(index.source_syntax_id), row);
        if identity == "" || DirectMirScalarCfgLocalIdentityRow(
                local_ref_value_ids, identity) >= 0 {
            return false;
        }
        ArrayPush(local_names, name);
        ArrayPush(local_ref_kinds, DirectMirScalarCfgLocalRefMatchBinding());
        ArrayPush(local_ref_value_ids, identity);
        ArrayPush(local_ref_syntax_ids, row);
        row = row + 1;
    }
    return true;
}
