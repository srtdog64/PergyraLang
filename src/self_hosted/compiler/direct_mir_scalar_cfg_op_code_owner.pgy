func DirectMirScalarCfgOpPhiString() -> Int { return 10; }
func DirectMirScalarCfgOpLogStringValue() -> Int { return 11; }
func DirectMirScalarCfgOpArraySetString() -> Int { return 12; }
func DirectMirScalarCfgOpArrayPushString() -> Int { return 13; }
func DirectMirScalarCfgOpLogArrayLength() -> Int { return 14; }
func DirectMirScalarCfgOpArrayPushInt() -> Int { return 15; }
func DirectMirScalarCfgOpAddArrayReadInt() -> Int { return 16; }
func DirectMirScalarCfgOpArraySetInt() -> Int { return 17; }
func DirectMirScalarCfgOpLogArrayIndexInt() -> Int { return 18; }
func DirectMirScalarCfgOpArrayReadInt() -> Int { return 19; }
