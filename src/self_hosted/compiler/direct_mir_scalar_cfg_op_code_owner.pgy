// Scalar-CFG plan vocabulary: operation codes and branch condition codes.
//
// Split out of direct_mir_scalar_cfg_graph_fact_owner.pgy, which owns the
// plan shape itself. A code table is a vocabulary fact, and it is the part
// that grows every time an operation is added -- keeping it here is what
// kept pushing that owner over its line cap.

func DirectMirScalarCfgOpConstInt() -> Int { return 1; }
func DirectMirScalarCfgOpCopyInt() -> Int { return 2; }
func DirectMirScalarCfgOpAddInt() -> Int { return 3; }
func DirectMirScalarCfgOpPhiInt() -> Int { return 4; }
func DirectMirScalarCfgOpLogInt() -> Int { return 5; }
