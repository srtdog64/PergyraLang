// Consumes graph row storage only after its complete-storage readers finish.
import "direct_mir_scalar_cfg_program_extension_preparation_owner.pgy";
import "direct_mir_scalar_cfg_program_extension_fact_readiness_owner.pgy";
import "direct_mir_scalar_cfg_program_expression_diagnostic_owner.pgy";
func DirectMirScalarCfgProgramExtensionFromPreparation(
    preparation: DirectMirScalarCfgProgramExtensionPreparation,
    collection_ownership: DirectMirScalarProgramCollectionOwnershipTransitionFact,
    block_condition_expression_rows: Array<Int>,
    operation_expression_rows: Array<Int>,
    operation_secondary_expression_rows: Array<Int>,
    operation_target_paths: DirectMirScalarCfgProgramOperationTargetPaths,
    block_return_expression_rows: Array<Int>
) -> DirectMirScalarCfgProgramExtensionFact {
    let source: DirectMirScalarCfgProgramExtensionFact =
        DirectMirScalarCfgProgramExtensionFact(
            true, 0, preparation.callable, preparation.expressions,
            block_condition_expression_rows, operation_expression_rows,
            operation_secondary_expression_rows, operation_target_paths,
            block_return_expression_rows,
            preparation.closed_call_abi, preparation.abi.runtime,
            preparation.abi.option_int, preparation.abi.result,
            preparation.abi.option_string, preparation.abi.option_bool,
            preparation.abi.logical_record, preparation.abi.referenced_enum,
            preparation.abi.payload_free_enum,
            preparation.abi.opaque_readonly_zones,
            preparation.abi.array_int_value_result,
            preparation.abi.array_bool,
            preparation.abi.array_string, preparation.abi.boundary,
            DirectMirScalarProgramCollectionOwnershipTransitionFactSealOrDie(
                collection_ownership), preparation.owned_array_string_move
        );
    let fact: DirectMirScalarCfgProgramExtensionFact =
        DirectMirScalarCfgProgramExtensionFactWithDigest(
            source, DirectMirScalarCfgProgramExtensionFactDigest(source)
        );
    if !DirectMirScalarCfgProgramExtensionFactReady(fact) {
        if DirectMirScalarCfgProgramExtensionFactReadinessCode(fact) == 5 {
            DirectMirScalarCfgProgramExpressionSetReadinessFailed(
                fact.expressions);
        }
        Die(Concat(
            "direct MIR scalar program extension is invalid: code=",
            ToString(DirectMirScalarCfgProgramExtensionFactReadinessCode(fact))));
    }
    return fact;
}
