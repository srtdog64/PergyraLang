// Seals typed program cross-links after the sole flat GraphPlan loop closes.

import "direct_mir_scalar_program_callable_admission_owner.pgy";
import "direct_mir_scalar_program_route_fact_owner.pgy";

func DirectMirScalarCfgProgramExtensionFromOwners(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    ref route: DirectMirScalarProgramRouteFact,
    expressions: DirectMirScalarProgramExpressionSet,
    block_condition_expression_rows: Array<Int>,
    operation_expression_rows: Array<Int>,
    block_return_expression_rows: Array<Int>
) -> DirectMirScalarCfgProgramExtensionFact {
    let callable: DirectMirScalarCfgProgramCallableFact =
        DirectMirScalarCfgProgramCallableFactInvalid();
    let closed_call_abi: DirectMirClosedModuleCallAbiFact =
        DirectMirClosedModuleCallAbiFactEmpty();
    if route.callable_row >= 0 {
        callable = DirectMirScalarProgramCallableFactFromAdmitted(
            admitted, route.callable_row, 1
        );
        closed_call_abi = DirectMirClosedModuleCallAbiFactFromOwner();
    }
    let sealed_expressions: DirectMirScalarProgramExpressionSet =
        DirectMirScalarProgramExpressionSetWithDigest(
            expressions,
            DirectMirScalarProgramExpressionSetDigest(expressions)
        );
    let compare_id_opt: Option<Int> =
        DirectMirScalarProgramStringCompareRuntimeCallAbiId(sealed_expressions);
    let concat_id_opt: Option<Int> =
        DirectMirScalarProgramStringConcatRuntimeCallAbiId(sealed_expressions);
    if !IsSome(compare_id_opt) || !IsSome(concat_id_opt) {
        Die("direct MIR scalar program runtime ABI is invalid");
    }
    let source: DirectMirScalarCfgProgramExtensionFact =
        DirectMirScalarCfgProgramExtensionFact(
            true, 0, callable, sealed_expressions,
            block_condition_expression_rows, operation_expression_rows,
            block_return_expression_rows,
            closed_call_abi, UnwrapOption(compare_id_opt),
            UnwrapOption(concat_id_opt)
        );
    let fact: DirectMirScalarCfgProgramExtensionFact =
        DirectMirScalarCfgProgramExtensionFactWithDigest(
            source, DirectMirScalarCfgProgramExtensionFactDigest(source)
        );
    if !DirectMirScalarCfgProgramExtensionFactReady(fact) {
        Die("direct MIR scalar program extension is invalid");
    }
    return fact;
}
