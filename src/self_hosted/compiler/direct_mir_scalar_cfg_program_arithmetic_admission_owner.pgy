// Overflow-safe arithmetic evidence for the scalar-program GraphPlan dialect.

import "direct_mir_scalar_cfg_program_arithmetic_magnitude_owner.pgy";
import "direct_mir_scalar_cfg_program_condition_bound_owner.pgy";
import "direct_mir_scalar_cfg_program_string_index_range_owner.pgy";

func DirectMirScalarCfgProgramArithmeticReady(
    ref expressions: DirectMirScalarProgramExpressionSet,
    ref condition_rows: Array<Int>,
    ref operations: DirectMirScalarCfgProgramOperationStorage,
    ref values: DirectMirScalarCfgProgramValueStorage,
    ref index: MirRoutineFactIndex,
    block: Int, operation_start: Int, expression_row: Int
) -> Bool {
    let start: Int = expressions.graph_starts[expression_row];
    let node: Int = start;
    while node < start + expressions.graph_counts[expression_row] {
        if expressions.node_kinds[node] == DirectMirScalarProgramExprAddInt() &&
            !DirectMirScalarCfgProgramAddBoundedByCondition(
                expressions, condition_rows, index, block,
                node) &&
            !DirectMirScalarCfgProgramAddBoundedByMagnitude(
                expressions, node) &&
            !DirectMirScalarCfgProgramStringIndexWindowReady(
                expressions, operations, values, operation_start,
                expression_row, node) {
            return false;
        }
        node = node + 1;
    }
    return true;
}
