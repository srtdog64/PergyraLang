// Emits one C block terminator, including copy-out and owned cleanup.
import "owned_local_lifetime_emission_owner.pgy";
import "direct_mir_scalar_cfg_program_extension_readiness_owner.pgy";
import "direct_mir_scalar_program_process_exit_owner.pgy";
import "direct_mir_scalar_program_c_expression_owner.pgy";
import "direct_mir_scalar_program_c_slice_expression_owner.pgy";
import "direct_mir_scalar_cfg_program_c_operation_owner.pgy";
import "direct_mir_scalar_program_c_array_mutation_owner.pgy";
import "direct_mir_scalar_cfg_local_emission_owner.pgy";
import "direct_mir_scalar_cfg_string_c_materialization_owner.pgy";
import "direct_mir_scalar_program_c_builtin_materialization_owner.pgy";
import "direct_mir_scalar_program_c_string_collection_materialization_owner.pgy";
import "direct_mir_scalar_program_c_array_string_cleanup_owner.pgy";
import "direct_mir_scalar_program_c_hashmap_cleanup_owner.pgy";
import "direct_mir_scalar_cfg_program_c_signature_owner.pgy";
import "runtime_value_representation_owner.pgy";
import "direct_mir_scalar_program_c_option_result_preamble_owner.pgy";
import "direct_mir_scalar_program_c_array_int_value_result_owner.pgy";
import "direct_mir_scalar_program_c_array_bool_materialization_owner.pgy";
import "direct_mir_scalar_program_c_array_bool_value_result_owner.pgy";
import "direct_mir_scalar_program_c_array_string_value_result_owner.pgy";
import "direct_mir_scalar_program_c_logical_record_owner.pgy";
import "direct_mir_scalar_program_c_logical_record_option_owner.pgy";
import "direct_mir_scalar_program_c_payload_enum_owner.pgy";
import "direct_mir_scalar_program_c_logical_record_value_result_owner.pgy";
import "direct_mir_scalar_program_c_logical_record_array_value_result_owner.pgy";
import "direct_mir_scalar_program_c_set_string_value_result_owner.pgy";
import "direct_mir_scalar_program_hashmap_parameter_lifecycle_owner.pgy";
import "direct_mir_scalar_program_array_int_populated_literal_readiness_owner.pgy";
import "direct_mir_scalar_program_c_array_int_populated_literal_materialization_owner.pgy";
import "direct_mir_scalar_program_c_array_bool_populated_literal_owner.pgy";
import "../mir/runtime_call_abi_fact_owner.pgy";
import "../codegen/runtime_abi/host_io_runtime_owner.pgy";
import "direct_mir_scalar_program_scalar_value_result_owner.pgy";
import "direct_mir_scalar_cfg_range_block_effect_owner.pgy";

func DirectMirScalarCfgProgramCBlockExit(
    ref plan: DirectMirScalarCfgGraphPlan,
    ref lifetime: DirectMirOwnedLocalLifetimeFact,
    routine: Int, block: Int,
    ref runtime: DirectMirScalarProgramRuntimeAbiProjection,
    int_c_type: String,
    array_string_projection: Option<DirectMirArrayStringAbiProjection>,
    target: CompilerTargetProjectionFact
) -> String {
    let output_allocator: Allocator = AllocatorResult();
    let output: TextBuilder = TextBuilderNew(1024);
    let return_row: Int = plan.program.block_return_expression_rows[block];
    if return_row == DirectMirScalarCfgVoidReturnExpressionRow() {
        if routine == plan.routines.entrypoint_ordinal {
            TextBuilderAppend(output, DirectMirScalarProgramCStringArrayCleanup(plan, lifetime, routine));
        TextBuilderAppend(output, DirectMirOwnedLocalExitCleanup(plan, lifetime, routine, block, false));
            TextBuilderAppend(output, "    return 0;\n");
        } else {
            TextBuilderAppend(output, DirectMirScalarProgramCScalarValueResultCopyOut(plan, routine));
            TextBuilderAppend(output, DirectMirScalarProgramCArrayStringValueResultCopyOut(
                plan, routine, array_string_projection));
            TextBuilderAppend(output, DirectMirScalarProgramCArrayIntValueResultCopyOut(
                    plan, routine));
            TextBuilderAppend(output, DirectMirScalarProgramCArrayBoolValueResultCopyOut(
                    plan, routine));
            TextBuilderAppend(output, DirectMirScalarProgramCLogicalRecordValueResultCopyOut(
                    plan, routine));
            TextBuilderAppend(output, DirectMirScalarProgramCLogicalRecordArrayValueResultCopyOut(plan, routine));
            TextBuilderAppend(output, DirectMirScalarProgramCSetStringValueResultCopyOut(
                    plan, routine));
            TextBuilderAppend(output,
                DirectMirScalarProgramCHashMapValueResultCopyOut(
                    plan, routine));
        TextBuilderAppend(output, DirectMirOwnedLocalExitCleanup(plan, lifetime, routine, block, false));
            TextBuilderAppend(output, "    return;\n");
        }
    } else if return_row >= 0 {
        // Evaluate the return expression before publishing any copyout.
        let return_type: String = DirectMirScalarCfgProgramCTypeWithReferencedEnum(
            plan.routines.return_types[routine], int_c_type,
            plan.program.logical_record, plan.program.payload_free_enum,
            plan.program.referenced_enum, plan.program.array_string_abi, array_string_projection);
        if return_type == "" { Die("direct MIR scalar C return has no admitted type"); }
        TextBuilderAppend(output, "    ${return_type} pgy_return_${block} = ");
        let clone_return: Bool = lifetime.return_clones[return_row];
        if clone_return {
            if plan.routines.return_types[routine] !=
                    CompilerAbiLayoutStringTypeName() ||
                !CompilerRuntimeCallAbiStringConcatFactReady(
                    runtime.string_concat) {
                Die("owned String return normalization has no C ABI");
            }
            TextBuilderAppend(output, runtime.string_concat.symbol);
            TextBuilderAppend(output, "(\"\", ");
        }
        TextBuilderAppend(output, DirectMirScalarProgramCExpressionAt(
            plan, plan.program.expressions, return_row, runtime,
            plan.program.logical_record, plan.program.referenced_enum,
            plan.routines, routine, target, plan.program.array_string_abi, array_string_projection));
        if clone_return { TextBuilderAppend(output, ")"); }
        TextBuilderAppend(output, ";\n");
        TextBuilderAppend(output, DirectMirScalarProgramCScalarValueResultCopyOut(plan, routine));
        TextBuilderAppend(output, DirectMirScalarProgramCArrayIntValueResultCopyOut(
                plan, routine));
        TextBuilderAppend(output,
            DirectMirScalarProgramCArrayBoolValueResultCopyOut(
                plan, routine));
        TextBuilderAppend(output, DirectMirScalarProgramCArrayStringValueResultCopyOut(
            plan, routine, array_string_projection));
        TextBuilderAppend(output,
            DirectMirScalarProgramCLogicalRecordValueResultCopyOut(
                plan, routine));
        TextBuilderAppend(output, DirectMirScalarProgramCLogicalRecordArrayValueResultCopyOut(plan, routine));
        TextBuilderAppend(output,
            DirectMirScalarProgramCSetStringValueResultCopyOut(
                plan, routine));
        TextBuilderAppend(output,
            DirectMirScalarProgramCHashMapValueResultCopyOut(
                plan, routine));
        TextBuilderAppend(output,
            DirectMirScalarProgramCStringArrayCleanup(plan, lifetime, routine));
        TextBuilderAppend(output, DirectMirOwnedLocalExitCleanup(plan, lifetime, routine, block, false));
        if routine == plan.routines.entrypoint_ordinal {
            TextBuilderAppend(output,
                "    (void)pgy_return_${block};\n    return 0;\n");
        } else {
            TextBuilderAppend(output, "    return pgy_return_${block};\n");
        }
    } else if plan.block_condition_kinds[block] ==
            DirectMirScalarCfgConditionExpression() {
        TextBuilderAppend(output, "    if (");
        TextBuilderAppend(output, DirectMirScalarProgramCExpressionAt(
            plan, plan.program.expressions,
            plan.program.block_condition_expression_rows[block],
            runtime, plan.program.logical_record,
            plan.program.referenced_enum, plan.routines, routine, target, plan.program.array_string_abi, array_string_projection));
        TextBuilderAppend(output, ") goto pgy_r");
        TextBuilderAppend(output, ToString(routine));
        TextBuilderAppend(output, "_block_");
        TextBuilderAppend(output, ToString(plan.block_succ_true[block]));
        TextBuilderAppend(output, ";\n    goto pgy_r");
        TextBuilderAppend(output, ToString(routine));
        TextBuilderAppend(output, "_block_");
        TextBuilderAppend(output, ToString(plan.block_succ_false[block]));
        TextBuilderAppend(output, ";\n");
    } else if plan.block_succ_true[block] >= 0 {
        TextBuilderAppend(output, "    goto pgy_r");
        TextBuilderAppend(output, ToString(routine));
        TextBuilderAppend(output, "_block_");
        TextBuilderAppend(output, ToString(plan.block_succ_true[block]));
        TextBuilderAppend(output, ";\n");
    } else if routine == plan.routines.entrypoint_ordinal {
        TextBuilderAppend(output,
            DirectMirScalarProgramCStringArrayCleanup(plan, lifetime, routine));
        TextBuilderAppend(output, DirectMirOwnedLocalExitCleanup(plan, lifetime, routine, block, false));
        TextBuilderAppend(output, "    return 0;\n");
    } else if DirectMirScalarProgramBlockEndsWithProcessExit(
            plan.operation_kinds, plan.block_operation_starts[block], plan.block_operation_counts[block]) {
        // The canonical C exit ABI does not return.
    } else if return_row == -1 { TextBuilderAppend(output, "    abort();\n");
    } else {
        Die("direct MIR scalar program callable return is missing");
    }
    let block_exit: String = TextBuilderFinish(output, output_allocator);
    AllocatorDestroy(output_allocator);
    return block_exit;
}
