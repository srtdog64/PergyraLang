// Projects one typed scalar log operation to C.
import "direct_mir_scalar_program_c_expression_owner.pgy";
import "../mir/runtime_call_abi_fact_owner.pgy";
import "../codegen/runtime_abi/string_runtime_symbol_owner.pgy";

func DirectMirScalarCfgProgramCLogOperation(
    ref plan: DirectMirScalarCfgGraphPlan, routine: Int, operation: Int,
    formatted_print: CompilerRuntimeCallAbiFact,
    ref runtime: DirectMirScalarProgramRuntimeAbiProjection,
    int_line_format: String, string_line_format: String,
    array_string_projection: Option<DirectMirArrayStringAbiProjection>,
    target: CompilerTargetProjectionFact
) -> String {
    let expression_row: Int = plan.program.operation_expression_rows[operation];
    var line_format: String = string_line_format;
    let root: Int = plan.program.expressions.graph_roots[expression_row];
    if plan.program.expressions.node_types[root] == CompilerAbiLayoutIntTypeName() { line_format = int_line_format; }
    if plan.program.expressions.node_types[root] == CompilerAbiLayoutLongTypeName() {
        line_format = StringRuntimeCIntLineFormat();
    }
    if plan.program.expressions.node_types[root] == CompilerAbiLayoutFloatTypeName() {
        line_format = StringRuntimeCFloatLineFormat();
    }
    var output: String = Concat("    ", formatted_print.symbol);
    output = Concat(output, Concat("(\"", line_format));
    output = Concat(output, "\", ");
    var log_value: String = DirectMirScalarProgramCExpressionAt(
        plan, plan.program.expressions, expression_row, runtime,
        plan.program.logical_record, plan.program.referenced_enum,
        plan.routines, routine, target, plan.program.array_string_abi,
        array_string_projection);
    if plan.program.expressions.node_types[root] == CompilerAbiLayoutBoolTypeName() {
        log_value = "(" + log_value + " ? \"true\" : \"false\")";
    }
    if plan.program.expressions.node_types[root] == CompilerAbiLayoutIntTypeName() {
        // Logical record storage is compiler-private i64; the public Int
        // vararg contract still requires the target's promoted Int value.
        log_value = "(" + CompilerAbiLayoutIntCValueType() + ")(" + log_value + ")";
    }
    if plan.program.expressions.node_types[root] == CompilerAbiLayoutLongTypeName() {
        log_value = "(" + StringRuntimeCLongPrintArgumentType() + ")(" + log_value + ")";
    }
    output = Concat(output, log_value);
    return Concat(output, ");\n");
}
