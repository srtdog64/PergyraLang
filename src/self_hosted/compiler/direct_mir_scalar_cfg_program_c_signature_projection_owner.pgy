// Scalar-CFG C signature projection.

import "direct_mir_scalar_cfg_graph_fact_owner.pgy";
import "direct_mir_scalar_program_c_option_int_owner.pgy";
import "direct_mir_scalar_program_c_option_string_owner.pgy";
import "direct_mir_scalar_program_c_option_bool_owner.pgy";
import "direct_mir_scalar_program_c_logical_record_owner.pgy";
import "direct_mir_scalar_program_c_logical_record_option_owner.pgy";
import "direct_mir_scalar_program_value_result_union_owner.pgy";
import "direct_mir_scalar_program_logical_record_value_result_target_owner.pgy";
import "direct_mir_scalar_program_logical_record_array_target_owner.pgy";
import "direct_mir_scalar_program_set_string_value_result_target_owner.pgy";
import "direct_mir_scalar_program_array_readonly_ref_target_owner.pgy";
import "direct_mir_scalar_program_array_string_abi_projection_owner.pgy";
import "direct_mir_scalar_program_payload_enum_type_name_owner.pgy";
import "runtime_value_representation_owner.pgy";
import "direct_mir_identity_cell_projection_owner.pgy";
import "direct_mir_scalar_program_callable_parameter_policy_owner.pgy";
import "../codegen/runtime_abi/host_io_runtime_owner.pgy";
import "direct_mir_scalar_cfg_program_c_type_owner.pgy";

func DirectMirScalarCfgProgramCOpaqueReadonlyZoneType(
    ref fact: DirectMirScalarProgramOpaqueReadonlyZoneFact,
    type_name: String
) -> String {
    let row: Int = DirectMirScalarProgramOpaqueReadonlyZoneRow(
        fact, type_name);
    if row < 0 { return ""; }
    return Concat("pgy_opaque_zone_", ToString(
        fact.declaration_rows[row]));
}

func DirectMirScalarCfgProgramCOpaqueReadonlyZonePreamble(
    ref fact: DirectMirScalarProgramOpaqueReadonlyZoneFact
) -> String {
    if !DirectMirScalarProgramOpaqueReadonlyZoneFactReady(fact) {
        Die("direct MIR opaque Zone declaration fact is invalid");
    }
    var output: String = "";
    var row: Int = 0;
    while row < ArrayLength(fact.names) {
        let c_type: String = DirectMirScalarCfgProgramCOpaqueReadonlyZoneType(
            fact, fact.names[row]);
        output = Concat(output, Concat("typedef struct ", Concat(
            c_type, Concat(" ", Concat(c_type, ";\n")))));
        row = row + 1;
    }
    return output;
}

func DirectMirScalarCfgProgramCSignature(ref plan: DirectMirScalarCfgGraphPlan,
    routine: Int, int_c_type: String, prototype: Bool, array_string_projection: Option<DirectMirArrayStringAbiProjection>
) -> String {
    if routine == plan.routines.entrypoint_ordinal {
        if prototype { return ""; }
        if plan.program.runtime_abi.process_args_id != 0 {
            return HostIORuntimeCEntrypointSignature(true);
        }
        return "int main(void)";
    }
    // A routine the program never calls (an override body a subject call
    // does not reach) is still emitted; `unused` keeps -Wall -Werror quiet.
    var output: String = Concat("static __attribute__((unused)) ", Concat(
        DirectMirScalarCfgProgramCTypeWithReferencedEnum(
            plan.routines.return_types[routine], int_c_type,
            plan.program.logical_record,
            plan.program.payload_free_enum,
            plan.program.referenced_enum, plan.program.array_string_abi, array_string_projection), " "));
    output = Concat(output,
        DirectMirScalarCfgProgramCRoutineName(routine));
    output = Concat(output, "(");
    if plan.routines.parameter_counts[routine] == 0 {
        output = Concat(output, "void");
    }
    var ordinal: Int = 0;
    let start: Int = plan.routines.parameter_starts[routine];
    while ordinal < plan.routines.parameter_counts[routine] {
        if ordinal > 0 { output = Concat(output, ", "); }
        let value_result: Bool = DirectMirScalarProgramParameterValueResultAt(
            plan, routine, ordinal);
        let parameter_row: Int = start + ordinal;
        let readonly_record: Bool = plan.routines.parameter_carriages[
                parameter_row] == "readonly-ref" &&
            DirectMirScalarProgramLogicalRecordTypeReady(
                plan.program.logical_record,
                plan.routines.parameter_types[parameter_row]);
        let readonly_array: Bool =
            DirectMirScalarProgramArrayReadonlyRefAt(
                plan.routines, routine, ordinal);
        let readonly_payload_enum: Bool =
            DirectMirScalarProgramPayloadEnumReadonlyRefAt(
                plan.routines, plan.program.referenced_enum,
                routine, ordinal);
        let identity_cell: Bool =
            DirectMirScalarProgramIdentityCellParameterCarriageReady(
                plan.program.logical_record.identity_cells,
                plan.routines.parameter_types[parameter_row],
                plan.routines.parameter_carriages[parameter_row]);
        let readonly_cell: Bool = plan.routines.parameter_carriages[parameter_row] == "readonly-ref" && identity_cell;
        let opaque_zone_type: String =
            DirectMirScalarCfgProgramCOpaqueReadonlyZoneType(
                plan.program.opaque_readonly_zones,
                plan.routines.parameter_types[parameter_row]);
        let opaque_zone: Bool = opaque_zone_type != "" &&
            (plan.routines.parameter_carriages[parameter_row] ==
                "readonly-ref" ||
             plan.routines.parameter_carriages[parameter_row] ==
                "participant");
        let readonly_opaque_zone: Bool = opaque_zone &&
            plan.routines.parameter_carriages[parameter_row] ==
                "readonly-ref";
        if readonly_record || readonly_array || readonly_cell ||
            readonly_payload_enum || readonly_opaque_zone {
            output = Concat(output, "const ");
        }
        if opaque_zone {
            output = Concat(output, opaque_zone_type);
        } else {
            output = Concat(output,
                DirectMirScalarCfgProgramCTypeWithReferencedEnum(
                plan.routines.parameter_types[parameter_row], int_c_type,
                plan.program.logical_record,
                plan.program.payload_free_enum,
                plan.program.referenced_enum, plan.program.array_string_abi,
                array_string_projection));
        }
        if value_result || readonly_record || readonly_array ||
            readonly_payload_enum || opaque_zone ||
            (plan.routines.parameter_carriages[parameter_row] ==
                "mutable-identity" && !identity_cell) {
            output = Concat(output, " *");
        } else { output = Concat(output, " "); }
        output = Concat(output, Concat(
            "pgy_param_", ToString(ordinal)));
        if value_result { output = Concat(output, "_mutref"); }
        ordinal = ordinal + 1;
    }
    output = Concat(output, ")");
    if prototype { return Concat(output, ";\n"); }
    return output;
}

