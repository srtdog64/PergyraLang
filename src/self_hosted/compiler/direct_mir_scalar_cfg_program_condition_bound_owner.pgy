// Dominating loop-condition evidence for overflow-safe scalar addition.

import "direct_mir_scalar_program_expression_readiness_owner.pgy";
import "../mir_lower/routine_definition_dominance_fact_owner.pgy";

func DirectMirScalarCfgProgramPositiveBound(value: String) -> Bool {
    return DirectMirScalarCfgCanonicalInt(value) &&
        StringLength(value) > 0 && StringLength(value) <= 18 &&
        Substring(value, 0, 1) != "0" && Substring(value, 0, 1) != "-";
}

func DirectMirScalarCfgProgramAddBoundedByCondition(
    ref expressions: DirectMirScalarProgramExpressionSet,
    ref condition_rows: Array<Int>, ref index: MirRoutineFactIndex,
    block: Int, node: Int
) -> Bool {
    let left: Int = expressions.node_lefts[node];
    let right: Int = expressions.node_rights[node];
    if expressions.node_kinds[left] != DirectMirScalarProgramExprLocal() ||
        expressions.node_kinds[right] !=
            DirectMirScalarProgramExprIntLiteral() ||
        expressions.node_literals[right] != "1" {
        return false;
    }
    let condition_block: Int = 0;
    while condition_block < ArrayLength(condition_rows) {
        let row: Int = condition_rows[condition_block];
        if row >= 0 && row < ArrayLength(expressions.graph_roots) {
            let root: Int = expressions.graph_roots[row];
            let bound_left: Int = expressions.node_lefts[root];
            let bound_right: Int = expressions.node_rights[root];
            if expressions.node_kinds[root] ==
                    DirectMirScalarProgramExprLessInt() &&
                expressions.node_kinds[bound_left] ==
                    DirectMirScalarProgramExprLocal() &&
                expressions.node_local_rows[bound_left] ==
                    expressions.node_local_rows[left] &&
                expressions.node_kinds[bound_right] ==
                    DirectMirScalarProgramExprIntLiteral() &&
                DirectMirScalarCfgProgramPositiveBound(
                    expressions.node_literals[bound_right]) &&
                index.block_succ_true[condition_block] >= 0 &&
                MirRoutineBlockDominates(
                    index, index.block_succ_true[condition_block], block
                ) {
                return true;
            }
        }
        condition_block = condition_block + 1;
    }
    return false;
}
