// Admit one direct-call argument against its declared parameter carriage.
import "direct_mir_scalar_cfg_graph_fact_owner.pgy";
import "direct_mir_scalar_program_logical_record_value_result_target_owner.pgy";
import "direct_mir_scalar_program_logical_record_array_value_result_target_owner.pgy";
import "direct_mir_scalar_program_array_int_value_result_fact_owner.pgy";
import "direct_mir_scalar_program_set_string_value_result_target_owner.pgy";
import "direct_mir_scalar_program_array_readonly_ref_target_owner.pgy";
import "direct_mir_scalar_program_owned_string_member_argument_owner.pgy";
import "direct_mir_scalar_program_owned_string_call_result_argument_owner.pgy";
import "direct_mir_scalar_program_owned_string_argument_source_owner.pgy";
import "direct_mir_scalar_program_readonly_string_parameter_owner.pgy";
import "direct_mir_scalar_program_value_result_union_owner.pgy";
import "direct_mir_scalar_program_callable_parameter_policy_owner.pgy";
import "direct_mir_scalar_program_owned_direct_parameter_type_policy_owner.pgy";
import "direct_mir_scalar_program_hashmap_owner_handle_move_admission_owner.pgy";
import "direct_mir_scalar_program_value_result_carriage_owner.pgy";
func DirectMirScalarCfgProgramDirectCallCarriageReady(ref plan: DirectMirScalarCfgGraphPlan,
    ref facts: DirectMirScalarProgramExpressionSet, node: Int, routine: Int, graph_start: Int,
    target: Int, argument_node: Int, ordinal: Int) -> Bool {
    let parameter_row: Int = plan.routines.parameter_starts[target] + ordinal;
    let carriage: String = plan.routines.parameter_carriages[parameter_row];
    let identity_value_result: Bool = carriage == "value-result" &&
        DirectMirScalarProgramIdentityCellParameterCarriageReady(
            plan.program.logical_record.identity_cells,
            plan.routines.parameter_types[parameter_row], carriage);
    let readonly_string: Bool =
        DirectMirScalarProgramReadonlyStringTargetAt(
            plan.routines, target, ordinal);
    let owned_string_member: Bool = DirectMirScalarProgramOwnedStringMemberArgumentReady(plan.program.logical_record, facts, argument_node, graph_start, carriage, plan.routines.parameter_types[parameter_row]);
    let owned_string_call_result: Bool = DirectMirScalarProgramOwnedStringCallResultArgumentReady(plan,
        facts, argument_node, graph_start, carriage, plan.routines.parameter_types[parameter_row]);
    var fresh_identity: Bool = false;
    if argument_node >= graph_start && argument_node < node &&
        argument_node < ArrayLength(facts.node_kinds) {
        fresh_identity = carriage == "mutable-identity" &&
            facts.node_kinds[argument_node] ==
                DirectMirScalarProgramExprIdentityCellConstructor() &&
            DirectMirScalarProgramIdentityCellParameterCarriageReady(
                plan.program.logical_record.identity_cells,
                plan.routines.parameter_types[parameter_row], carriage);
    }
    if argument_node < graph_start || argument_node >= node ||
        facts.node_types[argument_node] != plan.routines.parameter_types[parameter_row] ||
        (carriage != "value" &&
         (facts.node_kinds[argument_node] != DirectMirScalarProgramExprLocal() &&
          facts.node_kinds[argument_node] != DirectMirScalarProgramExprParameter() &&
          !(carriage == "readonly-ref" && (readonly_string || facts.node_kinds[argument_node] ==
                DirectMirScalarProgramExprLogicalRecordMember())) &&
          !owned_string_member && !owned_string_call_result && !fresh_identity)) {
        return false;
    }
    if carriage == "readonly-ref" {
        let readonly_cell: Bool = DirectMirScalarProgramIdentityCellParameterCarriageReady(
            plan.program.logical_record.identity_cells, plan.routines.parameter_types[parameter_row], carriage);
        let readonly_array: Bool = DirectMirScalarProgramArrayReadonlyRefAt(plan.routines, target, ordinal);
        let readonly_hashmap: Bool =
            DirectMirScalarProgramHashMapParameterCarriageReady(
                plan.routines.parameter_types[parameter_row], carriage);
        let readonly_payload_free_enum: Bool =
            DirectMirScalarProgramPayloadFreeEnumReadonlyRefAt(
                plan.routines, plan.program.payload_free_enum,
                target, ordinal);
        let readonly_payload_enum: Bool =
            DirectMirScalarProgramPayloadEnumReadonlyRefAt(
                plan.routines, plan.program.referenced_enum,
                target, ordinal);
        let readonly_value: Bool = DirectMirScalarProgramReadonlyValueTargetAt(
            plan.routines, target, ordinal);
        if !readonly_array && !readonly_string && !readonly_cell &&
            !readonly_hashmap && !readonly_payload_free_enum &&
            !readonly_payload_enum && !readonly_value &&
            !DirectMirScalarProgramLogicalRecordTypeReady(plan.program.logical_record,
                plan.routines.parameter_types[parameter_row]) {
            return false;
        }
        if readonly_array && facts.node_kinds[argument_node] ==
                DirectMirScalarProgramExprParameter() &&
            !DirectMirScalarProgramReadonlyArrayReborrowAt(plan.routines, routine,
                facts.node_parameter_ordinals[argument_node]) {
            return false;
        }
        if readonly_array && facts.node_kinds[argument_node] ==
                DirectMirScalarProgramExprLogicalRecordMember() &&
            !DirectMirScalarProgramReadonlyArrayMemberArgumentReady(
                facts, argument_node, graph_start) { return false; }
    }
    if identity_value_result {
        return facts.node_kinds[argument_node] ==
                DirectMirScalarProgramExprLocal() ||
            facts.node_kinds[argument_node] ==
                DirectMirScalarProgramExprParameter();
    }
    if carriage == "value-result" {
        if !DirectMirScalarProgramValueResultCarriageReady(
            plan, facts, argument_node, routine, target, ordinal) { return false; }
    } else if carriage == "owner-handle" {
        let owner_type: String = plan.routines.parameter_types[parameter_row];
        if !DirectMirScalarProgramOwnedDirectParameterTypeReadyWithReferencedEnum(
                plan.program.logical_record, plan.program.referenced_enum,
                owner_type) {
            return false;
        }
        if DirectMirScalarProgramHashMapTypeReady(owner_type) &&
            !DirectMirScalarProgramHashMapOwnerHandleTailMoveReady(
                plan, facts, node, routine, graph_start, argument_node) {
            return false;
        }
        // A direct result already has the callee-body verdict above. Reuse it;
        // bound values still need their exact allocation-source join.
        if owner_type == CompilerAbiLayoutStringTypeName() &&
            !owned_string_call_result &&
            !DirectMirScalarProgramOwnedStringBoundArgumentSourceReady(
                plan, argument_node, routine, graph_start) { return false; }
    } else if carriage == "mutable-identity" || carriage == "participant" {
        return DirectMirScalarProgramIdentityCellParameterCarriageReady(
            plan.program.logical_record.identity_cells, plan.routines.parameter_types[parameter_row], carriage);
    } else if carriage != "value" && carriage != "readonly-ref" {
        return false;
    }
    return true;
}
