// Scalar-CFG extension readiness admission.

import "direct_mir_scalar_cfg_graph_fact_owner.pgy";
import "direct_mir_scalar_cfg_program_expression_row_readiness_owner.pgy";
import "direct_mir_scalar_program_array_string_boundary_plan_readiness_owner.pgy";
import "direct_mir_scalar_cfg_program_extension_fact_readiness_owner.pgy";
import "direct_mir_scalar_program_array_mutation_readiness_owner.pgy";
import "direct_mir_scalar_program_option_int_try_admission_owner.pgy";
import "direct_mir_scalar_program_logical_record_value_result_target_owner.pgy";
import "direct_mir_scalar_program_runtime_value_lifecycle_owner.pgy";
import "direct_mir_scalar_cfg_program_statement_admission_owner.pgy";
import "direct_mir_scalar_program_process_exit_owner.pgy";
import "direct_mir_scalar_program_logical_record_assignment_readiness_owner.pgy";
import "direct_mir_identity_cell_store_readiness_owner.pgy";
import "mir_compound_assignment_readiness_owner.pgy";
import "direct_mir_scalar_program_enum_exhaustive_match_owner.pgy";
import "direct_mir_scalar_program_owned_array_string_move_plan_readiness_owner.pgy";
import "direct_mir_scalar_program_collection_ownership_transition_plan_readiness_owner.pgy";
import "direct_mir_scalar_program_payload_enum_member_plan_readiness_owner.pgy";
import "direct_mir_identity_cell_lifetime_owner.pgy";
import "direct_mir_scalar_program_hashmap_lifetime_owner.pgy";
import "direct_mir_array_storage_release_lifetime_owner.pgy";
import "direct_mir_scalar_program_array_index_static_bounds_owner.pgy";
import "direct_mir_scalar_cfg_program_extension_graph_owner.pgy";

func DirectMirScalarCfgProgramExtensionReadinessCode(
    ref plan: DirectMirScalarCfgGraphPlan
) -> Int {
    if !DirectMirScalarCfgProgramExtensionFactReady(plan.program) { return 1; }
    if !plan.program.valid { return 0; }
    let block_count: Int = ArrayLength(plan.block_succ_true);
    let operation_count: Int = ArrayLength(plan.operation_kinds);
    let routine_count: Int = ArrayLength(plan.routines.roles);
    let callable: Int = plan.program.callable.routine_ordinal;
    if routine_count < 1 ||
        ArrayLength(plan.program.block_condition_expression_rows) !=
            block_count ||
        ArrayLength(plan.program.block_return_expression_rows) !=
            block_count ||
        ArrayLength(plan.program.operation_expression_rows) !=
            operation_count ||
        ArrayLength(plan.program.operation_secondary_expression_rows) !=
            operation_count ||
        !DirectMirScalarCfgProgramRoutineEdgesReady(plan) { return 2; }
    if routine_count == 1 {
        if !DirectMirScalarCfgProgramCallableFactCanonicalEmpty(
                plan.program.callable) ||
            !DirectMirClosedModuleCallAbiFactCanonicalEmpty(
                plan.program.closed_call_abi) { return 12; }
    } else if routine_count == 2 && (callable != 1 ||
        plan.program.callable.signature.digest !=
            plan.routines.signature_digests[callable] ||
        plan.program.callable.signature.source_syntax_id !=
            plan.routines.source_syntax_ids[callable]) {
        return 13;
    } else if routine_count > 2 &&
        (!DirectMirScalarCfgProgramCallableFactCanonicalEmpty(
            plan.program.callable) ||
         !DirectMirClosedModuleCallAbiFactCanonicalEmpty(
            plan.program.closed_call_abi)) { return 13;
    }
    var block: Int = 0;
    var unreachable_routine: Int = -1;
    var unreachable: Array<Int> = [];
    while block < block_count {
        let routine: Int = DirectMirScalarCfgRoutinePartitionBlockOwner(
            plan.routines, block);
        let condition_row: Int =
            plan.program.block_condition_expression_rows[block];
        let return_row: Int = plan.program.block_return_expression_rows[block];
        if plan.block_condition_kinds[block] ==
                DirectMirScalarCfgConditionExpression() {
            if !DirectMirScalarCfgProgramExpressionRowReady(
                    plan, condition_row,
                    CompilerAbiLayoutBoolTypeName(), routine) ||
                return_row != -1 { return 3; }
        } else if condition_row != -1 { return 4; }
        let terminal: Bool = plan.block_succ_true[block] < 0 &&
            plan.block_succ_false[block] < 0;
        if routine == plan.routines.entrypoint_ordinal {
            let entry_return_type: String =
                plan.routines.return_types[routine];
            if entry_return_type == CompilerAbiLayoutVoidTypeName() {
                if return_row != -1 && return_row !=
                        DirectMirScalarCfgVoidReturnExpressionRow() {
                    return 5;
                }
            } else if entry_return_type == CompilerAbiLayoutIntTypeName() {
                let exits: Bool = return_row == -1 &&
                    DirectMirScalarProgramBlockEndsWithProcessExit(
                        plan.operation_kinds,
                        plan.block_operation_starts[block],
                        plan.block_operation_counts[block]);
                if terminal && !exits &&
                    !DirectMirScalarCfgProgramExpressionRowReady(
                        plan, return_row, entry_return_type, routine) {
                    return 5;
                }
                if !terminal && return_row != -1 {
                    return 5;
                }
            } else {
                return 5;
            }
        } else if terminal {
            let exits: Bool = return_row == -1 &&
                DirectMirScalarProgramBlockEndsWithProcessExit(
                    plan.operation_kinds,
                    plan.block_operation_starts[block],
                    plan.block_operation_counts[block]);
            if !exits && plan.routines.return_types[routine] == "Void" {
                if return_row != DirectMirScalarCfgVoidReturnExpressionRow() {
                    return 6;
                }
            } else if !exits && return_row == -1 {
                if unreachable_routine != routine {
                    unreachable = DirectMirScalarProgramEnumUnreachableBlocks(plan, routine);
                    unreachable_routine = routine;
                }
                if !DirectMirScalarProgramEnumExhaustiveMatchFallthroughReady(
                        plan, routine, block, unreachable) { return 6; }
            } else if !exits && !DirectMirScalarCfgProgramExpressionRowReady(
                    plan, return_row, plan.routines.return_types[routine], routine) {
                return 6;
            }
        } else if return_row != -1 { return 7; }
        block = block + 1;
    }
    var operation: Int = 0;
    while operation < operation_count {
        let kind: Int = plan.operation_kinds[operation];
        let expression_row: Int =
            plan.program.operation_expression_rows[operation];
        let routine: Int = DirectMirScalarCfgRoutinePartitionOperationOwner(
            plan.routines, operation);
        let target_member_count: Int =
            DirectMirScalarProgramArrayMutationTargetMemberCount(
                plan.program.operation_target_paths, operation);
        if target_member_count < 0 ||
            (!DirectMirScalarProgramArrayMutationKind(kind) &&
             target_member_count != 0) {
            return 10;
        }
        if kind == DirectMirScalarCfgOpOptionIntTryDefinition() {
            let result: Int = plan.operation_result_values[operation];
            if result < 0 || result >= ArrayLength(plan.value_types) ||
                plan.value_types[result] != CompilerAbiLayoutIntTypeName() ||
                !DirectMirScalarProgramOptionIntTryRoutineReady(
                    plan.routines, routine) ||
                !DirectMirScalarCfgProgramExpressionRowReady(
                    plan, expression_row,
                    CompilerAbiLayoutOptionIntTypeName(), routine) {
                return 15;
            }
        } else if MirCompoundAssignmentPlanOperation(kind) > 0 {
            if !MirCompoundAssignmentReady(plan, operation, routine) { return 25; }
        } else if kind == DirectMirScalarCfgOpIdentityCellStore() {
            if !DirectMirIdentityCellStoreReady(plan, operation, routine) { return 24; }
        } else if kind == DirectMirScalarCfgOpLogicalRecordMemberRebind() ||
                kind == DirectMirScalarCfgOpLogicalRecordArrayIndexedAssignment() {
            let code: Int =
                DirectMirScalarProgramLogicalRecordAssignmentReadinessCode(
                    plan, operation, routine);
            if code != 0 { return code; }
        } else if kind == DirectMirScalarCfgOpExpressionDefinition() {
            let result: Int = plan.operation_result_values[operation];
            if result < 0 || result >= ArrayLength(plan.value_types) ||
                !DirectMirScalarCfgProgramExpressionRowReady(
                    plan, expression_row, plan.value_types[result], routine
                ) { return 8; }
        } else if kind == DirectMirScalarCfgOpExpressionLog() {
            let root: Int = plan.program.expressions.graph_roots[expression_row];
            let log_type: String = plan.program.expressions.node_types[root];
            if !DirectMirScalarCfgScalarTypeSupported(log_type) ||
                !DirectMirScalarCfgProgramExpressionRowReady(
                    plan, expression_row, log_type, routine) { return 9; }
        } else if kind == DirectMirScalarCfgOpExpressionStatement() {
            let root: Int = plan.program.expressions.graph_roots[expression_row];
            let statement_type: String =
                plan.program.expressions.node_types[root];
            if !DirectMirScalarCfgProgramDiscardedCallExpressionReady(
                    plan.program.expressions, expression_row) ||
                !DirectMirScalarCfgProgramExpressionRowReady(
                    plan, expression_row, statement_type, routine) { return 9; }
        } else if kind == DirectMirScalarCfgOpProcessExit() {
            if !DirectMirScalarCfgProgramExpressionRowReady(
                    plan, expression_row,
                    CompilerAbiLayoutIntTypeName(), routine) { return 9; }
        } else if DirectMirScalarProgramArrayMutationKind(kind) {
            if !DirectMirScalarProgramArrayMutationOperationReady(
                    plan, operation, routine) { return 9; }
        } else if expression_row != -1 { return 10; }
        operation = operation + 1;
    }
    var expression_row: Int = 0;
    while expression_row < ArrayLength(plan.program.expressions.graph_starts) {
        if DirectMirScalarCfgProgramExpressionUseCount(
                plan, expression_row) != 1 { return 11; }
        expression_row = expression_row + 1;
    }
    if !DirectMirScalarProgramArrayStringBoundaryReadyForPlan(plan) {
        return 14;
    }
    if !DirectMirScalarProgramCollectionOwnershipTransitionReadyForPlan(plan) {
        return 26;
    }
    if !DirectMirScalarProgramOwnedArrayStringMoveReadyForPlan(plan) {
        return 23;
    }
    if !DirectMirScalarProgramPayloadEnumMembersReadyForPlan(plan) { return 24; }
    if !DirectMirScalarProgramRuntimeValueLifecycleReady(plan) { return 22; }
    if !DirectMirIdentityCellLifetimeReady(plan) { return 25; }
    if !DirectMirScalarProgramHashMapLifetimeReadyForPlan(plan) { return 27; }
    if !DirectMirArrayStorageReleaseLifetimeReady(plan) { return 28; }
    if !DirectMirScalarProgramArrayIndexStaticBoundsReady(plan) { return 29; }
    return 0;
}

func DirectMirScalarCfgProgramExtensionReadyForPlan(
    ref plan: DirectMirScalarCfgGraphPlan
) -> Bool {
    return DirectMirScalarCfgProgramExtensionReadinessCode(plan) == 0;
}

