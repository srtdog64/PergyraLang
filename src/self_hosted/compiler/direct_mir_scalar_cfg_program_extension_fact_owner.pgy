// Optional typed-expression/call seam carried by the scalar CFG graph plan.
// CFG, SSA, phi, locals, and operations remain owned only by GraphPlan.

import "direct_mir_scalar_program_expression_readiness_owner.pgy";
import "direct_mir_routine_signature_fact_owner.pgy";
import "direct_mir_closed_module_call_abi_owner.pgy";

struct DirectMirScalarCfgProgramCallableFact {
    let valid: Bool;
    let digest: Int;
    let signature: DirectMirRoutineSignatureFact;
    let return_global_row: Int;
    let return_expression_row: Int;
}

struct DirectMirScalarCfgProgramExtensionFact {
    let valid: Bool;
    let digest: Int;
    let callable: DirectMirScalarCfgProgramCallableFact;
    let expressions: DirectMirScalarProgramExpressionSet;
    let block_condition_expression_rows: Array<Int>;
    let operation_expression_rows: Array<Int>;
    let closed_call_abi: DirectMirClosedModuleCallAbiFact;
}

func DirectMirScalarCfgProgramCallableFactInvalid(
) -> DirectMirScalarCfgProgramCallableFact {
    return DirectMirScalarCfgProgramCallableFact(
        false, 0, InvalidDirectMirRoutineSignatureFact(), -1, -1
    );
}

func DirectMirScalarCfgProgramCallableFactDigest(
    ref fact: DirectMirScalarCfgProgramCallableFact
) -> Int {
    if !fact.valid { return 0; }
    let hash: Long = DirectMirCfgHashInt(229L, fact.signature.digest);
    hash = DirectMirCfgHashInt(hash, fact.return_global_row);
    hash = DirectMirCfgHashInt(hash, fact.return_expression_row);
    return DirectMirCfgBoundedDigest(hash);
}

func DirectMirScalarCfgProgramCallableFactReady(
    ref fact: DirectMirScalarCfgProgramCallableFact
) -> Bool {
    return fact.valid && fact.digest != 0 &&
        fact.digest == DirectMirScalarCfgProgramCallableFactDigest(fact) &&
        DirectMirRoutineSignatureFactReady(fact.signature) &&
        fact.signature.return_type == CompilerAbiLayoutBoolTypeName() &&
        fact.signature.param_count == 1 &&
        fact.signature.param.type_name == CompilerAbiLayoutIntTypeName() &&
        fact.return_global_row >= 0 && fact.return_expression_row >= 0;
}

func DirectMirScalarCfgProgramExtensionFactEmpty(
) -> DirectMirScalarCfgProgramExtensionFact {
    let rows: Array<Int> = [];
    return DirectMirScalarCfgProgramExtensionFact(
        false, 0, DirectMirScalarCfgProgramCallableFactInvalid(),
        DirectMirScalarProgramExpressionSetEmpty(), rows, rows,
        DirectMirClosedModuleCallAbiFact(false, 0, "", "", "", true)
    );
}

func DirectMirScalarCfgProgramExtensionFactDigest(
    ref fact: DirectMirScalarCfgProgramExtensionFact
) -> Int {
    if !fact.valid { return 0; }
    let hash: Long = DirectMirCfgHashInt(241L, fact.callable.digest);
    hash = DirectMirCfgHashInt(hash, fact.expressions.digest);
    hash = DirectMirScalarCfgHashInts(
        hash, fact.block_condition_expression_rows
    );
    hash = DirectMirScalarCfgHashInts(hash, fact.operation_expression_rows);
    hash = DirectMirCfgHashInt(
        hash, fact.closed_call_abi.target_capability_fingerprint
    );
    return DirectMirCfgBoundedDigest(hash);
}

func DirectMirScalarCfgProgramExtensionFactWithDigest(
    fact: DirectMirScalarCfgProgramExtensionFact, digest: Int
) -> DirectMirScalarCfgProgramExtensionFact {
    return DirectMirScalarCfgProgramExtensionFact(
        fact.valid, digest, fact.callable, fact.expressions,
        fact.block_condition_expression_rows,
        fact.operation_expression_rows, fact.closed_call_abi
    );
}

func DirectMirScalarCfgProgramExtensionFactReady(
    ref fact: DirectMirScalarCfgProgramExtensionFact
) -> Bool {
    if !fact.valid {
        return fact.digest == 0 && !fact.callable.valid &&
            DirectMirScalarProgramExpressionSetCanonicalEmpty(
                fact.expressions) &&
            ArrayLength(fact.block_condition_expression_rows) == 0 &&
            ArrayLength(fact.operation_expression_rows) == 0 &&
            DirectMirClosedModuleCallAbiFactCanonicalEmpty(
                fact.closed_call_abi);
    }
    return fact.digest != 0 &&
        fact.digest == DirectMirScalarCfgProgramExtensionFactDigest(fact) &&
        DirectMirScalarCfgProgramCallableFactReady(fact.callable) &&
        DirectMirScalarProgramExpressionSetSemanticallyReady(
            fact.expressions
        ) && DirectMirClosedModuleCallAbiFactReady(fact.closed_call_abi);
}
