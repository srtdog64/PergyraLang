// Optional typed-expression/call seam carried by the scalar CFG graph plan.
// CFG, SSA, phi, locals, and operations remain owned only by GraphPlan.

import "direct_mir_scalar_program_expression_readiness_owner.pgy";
import "direct_mir_scalar_program_callable_fact_owner.pgy";
import "direct_mir_scalar_program_runtime_abi_owner.pgy";
import "direct_mir_closed_module_call_abi_owner.pgy";
import "direct_mir_scalar_program_array_string_abi_owner.pgy";
import "direct_mir_scalar_program_array_string_callable_abi_owner.pgy";
import "direct_mir_scalar_program_array_string_boundary_fact_owner.pgy";
import "direct_mir_scalar_program_option_int_abi_owner.pgy";
import "direct_mir_scalar_program_two_int_nominal_abi_fact_owner.pgy";

struct DirectMirScalarCfgProgramExtensionFact {
    let valid: Bool;
    let digest: Int;
    let callable: DirectMirScalarCfgProgramCallableFact;
    let expressions: DirectMirScalarProgramExpressionSet;
    let block_condition_expression_rows: Array<Int>;
    let operation_expression_rows: Array<Int>;
    let block_return_expression_rows: Array<Int>;
    let closed_call_abi: DirectMirClosedModuleCallAbiFact;
    let runtime_abi: DirectMirScalarProgramRuntimeAbiFact;
    let option_int_abi: DirectMirOptionMatchAbiFact;
    let nominal_abi: DirectMirScalarProgramTwoIntNominalAbiFact;
    let array_string_abi: DirectMirScalarProgramArrayStringAbiFact;
    let array_string_boundary: DirectMirScalarProgramArrayStringBoundaryFact;
}

func DirectMirScalarCfgProgramExtensionFactEmpty(
) -> DirectMirScalarCfgProgramExtensionFact {
    let rows: Array<Int> = [];
    return DirectMirScalarCfgProgramExtensionFact(
        false, 0, DirectMirScalarCfgProgramCallableFactInvalid(),
        DirectMirScalarProgramExpressionSetEmpty(), rows, rows, rows,
        DirectMirClosedModuleCallAbiFactEmpty(),
        DirectMirScalarProgramRuntimeAbiFactEmpty(),
        DirectMirOptionMatchAbiFactEmpty(),
        DirectMirScalarProgramTwoIntNominalAbiFactFromCanonicalEmpty(),
        DirectMirScalarProgramArrayStringAbiFactEmpty(),
        DirectMirScalarProgramArrayStringBoundaryFactEmpty()
    );
}

func DirectMirScalarCfgProgramExtensionFactDigest(
    ref fact: DirectMirScalarCfgProgramExtensionFact
) -> Int {
    if !fact.valid { return 0; }
    let hash: Long = DirectMirCfgHashInt(241L, fact.callable.digest);
    hash = DirectMirCfgHashInt(hash, fact.expressions.digest);
    hash = DirectMirScalarCfgHashInts(
        hash, fact.block_condition_expression_rows
    );
    hash = DirectMirScalarCfgHashInts(hash, fact.operation_expression_rows);
    hash = DirectMirScalarCfgHashInts(hash, fact.block_return_expression_rows);
    hash = DirectMirCfgHashInt(
        hash, fact.closed_call_abi.target_capability_fingerprint
    );
    hash = DirectMirCfgHashInt(hash, fact.runtime_abi.digest);
    hash = DirectMirCfgHashInt(hash, fact.option_int_abi.digest);
    hash = DirectMirCfgHashInt(hash, fact.nominal_abi.digest);
    hash = DirectMirCfgHashInt(hash, fact.array_string_abi.digest);
    hash = DirectMirCfgHashInt(hash, fact.array_string_boundary.digest);
    return DirectMirCfgBoundedDigest(hash);
}

func DirectMirScalarCfgProgramExtensionFactWithDigest(
    fact: DirectMirScalarCfgProgramExtensionFact, digest: Int
) -> DirectMirScalarCfgProgramExtensionFact {
    return DirectMirScalarCfgProgramExtensionFact(
        fact.valid, digest, fact.callable, fact.expressions,
        fact.block_condition_expression_rows,
        fact.operation_expression_rows, fact.block_return_expression_rows,
        fact.closed_call_abi, fact.runtime_abi, fact.option_int_abi,
        fact.nominal_abi,
        fact.array_string_abi,
        fact.array_string_boundary
    );
}
