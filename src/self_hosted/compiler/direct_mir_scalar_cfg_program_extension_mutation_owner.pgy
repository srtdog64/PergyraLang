import "direct_mir_scalar_cfg_program_extension_fact_owner.pgy";
import "direct_mir_scalar_cfg_program_extension_abi_mutation_owner.pgy";
import "direct_mir_scalar_cfg_program_extension_fact_readiness_owner.pgy";
func DirectMirScalarCfgProgramExtensionMutationRejected() -> Bool {
    let empty_ints: Array<Int> = [];
    let one_int: Array<Int> = [0];
    let strings: Array<String> = [];
    let expression_payload: DirectMirScalarProgramExpressionSet =
        DirectMirScalarProgramExpressionSet(
            true, 0, one_int, empty_ints, empty_ints, empty_ints,
            empty_ints, strings, empty_ints, empty_ints, empty_ints,
            empty_ints, empty_ints, strings, empty_ints, empty_ints,
            DirectMirScalarProgramNaryOperandsEmpty()
        );
    let empty: DirectMirScalarCfgProgramExtensionFact =
        DirectMirScalarCfgProgramExtensionFactEmpty();
    let expression_mutation: DirectMirScalarCfgProgramExtensionFact =
        DirectMirScalarCfgProgramExtensionFact(
            false, 0, empty.callable, expression_payload,
            empty_ints, empty_ints, empty_ints, empty_ints,
            empty.closed_call_abi,
            empty.runtime_abi, empty.option_int_abi, empty.result_int_abi,
            empty.option_string_abi, empty.option_bool_abi, empty.nominal_abi,
            empty.logical_record, empty.referenced_enum,
            empty.payload_free_enum,
            empty.array_int_value_result,
            empty.array_bool_abi,
            empty.array_string_abi, empty.array_string_boundary);
    let abi_mutation: DirectMirScalarCfgProgramExtensionFact =
        DirectMirScalarCfgProgramExtensionFact(
            false, 0, empty.callable, empty.expressions,
            empty_ints, empty_ints, empty_ints, empty_ints,
            DirectMirClosedModuleCallAbiFact(false, 1, "", "", "", true),
            empty.runtime_abi, empty.option_int_abi, empty.result_int_abi,
            empty.option_string_abi, empty.option_bool_abi, empty.nominal_abi,
            empty.logical_record, empty.referenced_enum,
            empty.payload_free_enum,
            empty.array_int_value_result,
            empty.array_bool_abi,
            empty.array_string_abi,
            empty.array_string_boundary
        );
    return !DirectMirScalarCfgProgramExtensionFactReady(expression_mutation) &&
        !DirectMirScalarCfgProgramExtensionFactReady(abi_mutation) &&
        DirectMirScalarCfgProgramExtensionAbiMutationRejected(
            empty, empty_ints);
}
