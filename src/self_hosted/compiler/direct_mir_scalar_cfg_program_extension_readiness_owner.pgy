// Cross-links between typed program expressions and routine-owned GraphPlan ranges.

import "direct_mir_scalar_cfg_graph_fact_owner.pgy";
import "direct_mir_scalar_cfg_program_expression_identity_readiness_owner.pgy";
import "direct_mir_scalar_program_array_string_boundary_plan_readiness_owner.pgy";
import "direct_mir_scalar_cfg_program_extension_fact_readiness_owner.pgy";

func DirectMirScalarCfgProgramRoutineForBlock(
    ref plan: DirectMirScalarCfgGraphPlan, block: Int
) -> Int {
    let routine: Int = 0;
    while routine < ArrayLength(plan.routines.block_starts) {
        let start: Int = plan.routines.block_starts[routine];
        if block >= start && block < start +
                plan.routines.block_counts[routine] { return routine; }
        routine = routine + 1;
    }
    return -1;
}

func DirectMirScalarCfgProgramRoutineForOperation(
    ref plan: DirectMirScalarCfgGraphPlan, operation: Int
) -> Int {
    let routine: Int = 0;
    while routine < ArrayLength(plan.routines.operation_starts) {
        let start: Int = plan.routines.operation_starts[routine];
        if operation >= start && operation < start +
                plan.routines.operation_counts[routine] { return routine; }
        routine = routine + 1;
    }
    return -1;
}

func DirectMirScalarCfgProgramExpressionRowReady(
    ref plan: DirectMirScalarCfgGraphPlan,
    expression_row: Int, expected_type: String, routine: Int
) -> Bool {
    if routine < 0 || routine >= ArrayLength(plan.routines.roles) ||
        expression_row < 0 ||
        expression_row >= ArrayLength(plan.program.expressions.graph_roots) {
        return false;
    }
    let start: Int = plan.program.expressions.graph_starts[expression_row];
    let count: Int = plan.program.expressions.graph_counts[expression_row];
    let root: Int = plan.program.expressions.graph_roots[expression_row];
    if plan.program.expressions.node_types[root] !=
            expected_type { return false; }
    let node: Int = start;
    while node < start + count {
        if !DirectMirScalarCfgProgramExpressionIdentityReady(
                plan, plan.program.expressions, node, routine, start
        ) { return false; }
        node = node + 1;
    }
    return true;
}

func DirectMirScalarCfgProgramExpressionUseCount(
    ref plan: DirectMirScalarCfgGraphPlan, expression_row: Int
) -> Int {
    let count: Int = 0;
    let row: Int = 0;
    while row < ArrayLength(plan.program.block_condition_expression_rows) {
        if plan.program.block_condition_expression_rows[row] ==
                expression_row { count = count + 1; }
        if plan.program.block_return_expression_rows[row] ==
                expression_row { count = count + 1; }
        row = row + 1;
    }
    row = 0;
    while row < ArrayLength(plan.program.operation_expression_rows) {
        if plan.program.operation_expression_rows[row] ==
                expression_row { count = count + 1; }
        row = row + 1;
    }
    return count;
}

func DirectMirScalarCfgProgramRoutineEdgesReady(
    ref plan: DirectMirScalarCfgGraphPlan
) -> Bool {
    let block: Int = 0;
    while block < ArrayLength(plan.block_succ_true) {
        let routine: Int = DirectMirScalarCfgProgramRoutineForBlock(plan, block);
        if routine < 0 { return false; }
        let start: Int = plan.routines.block_starts[routine];
        let end: Int = start + plan.routines.block_counts[routine];
        let true_target: Int = plan.block_succ_true[block];
        let false_target: Int = plan.block_succ_false[block];
        if (true_target >= 0 &&
                (true_target < start || true_target >= end)) ||
            (false_target >= 0 &&
                (false_target < start || false_target >= end)) {
            return false;
        }
        block = block + 1;
    }
    return true;
}

func DirectMirScalarCfgProgramExtensionReadinessCode(
    ref plan: DirectMirScalarCfgGraphPlan
) -> Int {
    if !DirectMirScalarCfgProgramExtensionFactReady(plan.program) { return 1; }
    if !plan.program.valid { return 0; }
    let block_count: Int = ArrayLength(plan.block_succ_true);
    let operation_count: Int = ArrayLength(plan.operation_kinds);
    let routine_count: Int = ArrayLength(plan.routines.roles);
    let callable: Int = plan.program.callable.routine_ordinal;
    if routine_count < 1 ||
        ArrayLength(plan.program.block_condition_expression_rows) !=
            block_count ||
        ArrayLength(plan.program.block_return_expression_rows) !=
            block_count ||
        ArrayLength(plan.program.operation_expression_rows) !=
            operation_count ||
        !DirectMirScalarCfgProgramRoutineEdgesReady(plan) { return 2; }
    if routine_count == 1 {
        if !DirectMirScalarCfgProgramCallableFactCanonicalEmpty(
                plan.program.callable) ||
            !DirectMirClosedModuleCallAbiFactCanonicalEmpty(
                plan.program.closed_call_abi) { return 12; }
    } else if routine_count == 2 && (callable != 1 ||
        plan.program.callable.signature.digest !=
            plan.routines.signature_digests[callable] ||
        plan.program.callable.signature.source_syntax_id !=
            plan.routines.source_syntax_ids[callable]) {
        return 13;
    } else if routine_count > 2 &&
        (!DirectMirScalarCfgProgramCallableFactCanonicalEmpty(
            plan.program.callable) ||
         !DirectMirClosedModuleCallAbiFactCanonicalEmpty(
            plan.program.closed_call_abi)) { return 13;
    }
    let block: Int = 0;
    while block < block_count {
        let routine: Int = DirectMirScalarCfgProgramRoutineForBlock(plan, block);
        let condition_row: Int =
            plan.program.block_condition_expression_rows[block];
        let return_row: Int = plan.program.block_return_expression_rows[block];
        if plan.block_condition_kinds[block] ==
                DirectMirScalarCfgConditionExpression() {
            if !DirectMirScalarCfgProgramExpressionRowReady(
                    plan, condition_row,
                    CompilerAbiLayoutBoolTypeName(), routine) ||
                return_row != -1 { return 3; }
        } else if condition_row != -1 { return 4; }
        let terminal: Bool = plan.block_succ_true[block] < 0 &&
            plan.block_succ_false[block] < 0;
        if routine == plan.routines.entrypoint_ordinal {
            if return_row != -1 { return 5; }
        } else if terminal {
            if !DirectMirScalarCfgProgramExpressionRowReady(
                    plan, return_row, plan.routines.return_types[routine],
                    routine) { return 6; }
        } else if return_row != -1 { return 7; }
        block = block + 1;
    }
    let operation: Int = 0;
    while operation < operation_count {
        let kind: Int = plan.operation_kinds[operation];
        let expression_row: Int =
            plan.program.operation_expression_rows[operation];
        let routine: Int =
            DirectMirScalarCfgProgramRoutineForOperation(plan, operation);
        if kind == DirectMirScalarCfgOpExpressionDefinition() {
            let result: Int = plan.operation_result_values[operation];
            if result < 0 || result >= ArrayLength(plan.value_types) ||
                !DirectMirScalarCfgProgramExpressionRowReady(
                    plan, expression_row, plan.value_types[result], routine
                ) { return 8; }
        } else if kind == DirectMirScalarCfgOpExpressionLog() {
            let root: Int = plan.program.expressions.graph_roots[expression_row];
            let log_type: String = plan.program.expressions.node_types[root];
            if (log_type != CompilerAbiLayoutStringTypeName() &&
                log_type != CompilerAbiLayoutIntTypeName()) ||
                !DirectMirScalarCfgProgramExpressionRowReady(
                    plan, expression_row, log_type, routine) { return 9; }
        } else if expression_row != -1 { return 10; }
        operation = operation + 1;
    }
    let expression_row: Int = 0;
    while expression_row < ArrayLength(plan.program.expressions.graph_starts) {
        if DirectMirScalarCfgProgramExpressionUseCount(
                plan, expression_row) != 1 { return 11; }
        expression_row = expression_row + 1;
    }
    if !DirectMirScalarProgramArrayStringBoundaryReadyForPlan(plan) {
        return 14;
    }
    return 0;
}

func DirectMirScalarCfgProgramExtensionReadyForPlan(
    ref plan: DirectMirScalarCfgGraphPlan
) -> Bool {
    return DirectMirScalarCfgProgramExtensionReadinessCode(plan) == 0;
}
