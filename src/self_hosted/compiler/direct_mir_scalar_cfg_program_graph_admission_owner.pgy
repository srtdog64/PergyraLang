// Sole arbitrary-routine issuer for the one immutable scalar GraphPlan.

import "direct_mir_scalar_cfg_program_routine_admission_owner.pgy";
import "direct_mir_scalar_cfg_program_routine_partition_owner.pgy";
import "direct_mir_scalar_cfg_graph_plan_seal_owner.pgy";
import "direct_mir_scalar_cfg_program_admission_owner.pgy";
import "direct_mir_scalar_program_callable_inventory_owner.pgy";
import "direct_mir_option_match_abi_fact_owner.pgy";

func DirectMirScalarCfgProgramGraphPlanFromAdmitted(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    own route: DirectMirScalarProgramRouteFact
) -> DirectMirScalarCfgGraphPlan {
    if !DirectMirScalarProgramRouteFactReady(route) {
        Die("direct MIR scalar CFG program route is invalid");
    }
    let producer: DirectMirArrayIntProducerFact =
        DirectMirArrayIntProducerFactEmpty();
    let entry: DirectMirScalarCfgGraphInput =
        DirectMirScalarCfgProgramGraphInputFromAdmitted(
            admitted, route.entrypoint_row, producer
        );
    let callables: DirectMirScalarCfgProgramCallableInventory =
        DirectMirScalarCfgProgramCallableInventoryFromAdmitted(
            admitted, route.routine_rows, route.nominal,
            route.logical_record, route.payload_free_enum
        );
    if !DirectMirScalarCfgProgramCallableInventoryReady(
            callables, ArrayLength(route.routine_rows)) {
        Die("direct MIR scalar CFG program callable inventory is invalid");
    }
    let storage: DirectMirScalarCfgProgramGraphStorage =
        DirectMirScalarCfgProgramGraphStorageEmpty();
    let expressions: DirectMirScalarProgramExpressionSet =
        DirectMirScalarProgramExpressionSetEmpty();
    let cfg_digests: Array<Int> = [];
    let option_int_abi: DirectMirOptionMatchAbiFact =
        DirectMirOptionMatchAbiFactEmpty();
    let option_string_abi: DirectMirOptionMatchAbiFact =
        DirectMirOptionMatchAbiFactEmpty();
    let option_bool_abi: DirectMirOptionMatchAbiFact =
        DirectMirOptionMatchAbiFactEmpty();
    let ordinal: Int = 0;
    while ordinal < ArrayLength(route.routine_rows) {
        let input: DirectMirScalarCfgGraphInput = entry;
        if ordinal > 0 {
            input = DirectMirScalarCfgProgramGraphInputFromAdmitted(
                admitted, route.routine_rows[ordinal], producer
            );
        }
        ArrayPush(cfg_digests, DirectMirCfgDigestFromIndex(input.index));
        let admission: DirectMirScalarCfgProgramRoutineAdmission =
            DirectMirScalarCfgProgramAppendRoutine(
                admitted, route.routine_rows[ordinal], ordinal, callables, input,
                storage, expressions, option_int_abi, option_string_abi,
                option_bool_abi,
                route.nominal, route.logical_record,
                route.payload_free_enum,
                route.array_int_value_result, route.array_bool_abi,
                route.array_string_abi
            );
        if !admission.valid {
            Die(Concat(
                "direct MIR scalar CFG program routine admission is invalid: ordinal=",
                ToString(ordinal)));
        }
        storage = admission.storage;
        expressions = admission.expressions;
        option_int_abi = admission.option_int_abi;
        option_string_abi = admission.option_string_abi;
        option_bool_abi = admission.option_bool_abi;
        ordinal = ordinal + 1;
    }
    let partition: DirectMirScalarCfgRoutinePartitionFact =
        DirectMirScalarCfgProgramRoutinePartitionFromOwners(
            admitted.routines, route.routine_rows, cfg_digests,
            storage.routines.local_counts, storage.routines.value_counts,
            storage.routines.block_counts,
            storage.routines.operation_counts,
            storage.routines.phi_counts, route.nominal,
            route.logical_record, route.payload_free_enum
        );
    let program: DirectMirScalarCfgProgramExtensionFact =
        DirectMirScalarCfgProgramExtensionFromOwners(
            admitted, route, callables, storage, expressions, option_int_abi,
            option_string_abi,
            option_bool_abi,
            storage.blocks.condition_expression_rows,
            storage.operations.expression_rows,
            storage.operations.secondary_expression_rows,
            storage.blocks.return_expression_rows
        );
    let value_storage: DirectMirScalarCfgProgramValueStorage = storage.values;
    let value_plans: DirectMirScalarCfgProgramValuePlans =
        DirectMirScalarCfgProgramValuePlansFromStorage(value_storage);
    let locals: DirectMirScalarCfgLocalRefPlan = value_plans.locals;
    let types: DirectMirScalarCfgValueTypePlan = value_plans.types;
    let partition_digest: Int = partition.digest;
    return DirectMirScalarCfgSealGraphPlan(
        admitted, partition, partition_digest, locals, types,
        storage.blocks.succ_true, storage.blocks.succ_false,
        storage.blocks.operation_starts, storage.blocks.operation_counts,
        storage.blocks.condition_kinds,
        storage.blocks.condition_left_values,
        storage.blocks.condition_right_values,
        storage.blocks.condition_left_locals,
        storage.blocks.condition_right_locals,
        storage.blocks.condition_left_literals,
        storage.blocks.condition_right_literals,
        storage.operations.kinds, storage.operations.result_values,
        storage.operations.left_values, storage.operations.right_values,
        storage.operations.left_locals, storage.operations.right_locals,
        storage.operations.left_literals, storage.operations.right_literals,
        storage.operations.phi_starts, storage.operations.phi_counts,
        storage.operations.phi_predecessor_blocks,
        storage.operations.phi_incoming_values,
        entry.ranges, entry.foreach_facts,
        entry.foreach_elements, entry.string_arrays,
        entry.array_int_program, entry.collections, program
    );
}
