// One typed expression admission core; public routes supply their ABI envelope.

import "direct_mir_scalar_program_expression_admission_owner.pgy";
import "direct_mir_scalar_cfg_program_extension_fact_owner.pgy";
import "direct_mir_scalar_program_int_literal_expression_row_owner.pgy";
import "direct_mir_scalar_cfg_program_match_expression_admission_owner.pgy";
import "direct_mir_scalar_cfg_type_family_owner.pgy";
func DirectMirScalarCfgProgramAppendTypedExpressionFieldWithOptionIntMatch(
    inout expressions: DirectMirScalarProgramExpressionSet,
    inout failure: DirectMirScalarProgramExpressionAdmissionFailure,
    ref instruction: JsonObjectFactTable, ref uses: MirRoutineInstructionUseFacts,
    ref index: MirRoutineFactIndex, global_row: Int, local_instruction: Int,
    ref locals: DirectMirScalarCfgLocalRefPlan, ref types: DirectMirScalarCfgValueTypePlan,
    ref wire: DirectMirScalarCfgWireLocalRefs, local_offset: Int, parameter_types: Array<String>,
    ref signature: DirectMirRoutineSignatureFact,
    ref callables: DirectMirScalarCfgProgramCallableInventory,
    ref routine_instances: DirectMirRoutineInstanceInventory, caller_ordinal: Int,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    ref payload_free_enum: DirectMirScalarProgramPayloadFreeEnumFact,
    ref referenced_enum: DirectMirScalarProgramReferencedEnumFact,
    ref option_int_abi: DirectMirOptionMatchAbiFact, graph_field: String, inout use_offset: Int,
    require_all_uses: Bool, expected_type: String, source_root: Int,
    allow_process_exit_wrapper: Bool
) -> Option<Int> {
    let expression_row: Int = ArrayLength(expressions.graph_starts);
    let admission: DirectMirScalarProgramExpressionAdmission = DirectMirScalarProgramAppendExpression(
            expressions, instruction, uses, index, global_row,
            local_instruction, locals, types, wire, local_offset,
            parameter_types, signature, callables, routine_instances,
            caller_ordinal, logical_record,
            payload_free_enum, referenced_enum, graph_field, use_offset,
            require_all_uses, expected_type, false, source_root,
            allow_process_exit_wrapper);
    // The admission may have grown the set before it failed: every exit
    // hands the caller the set it returned, never the stale one.
    if !admission.valid {
        if !failure.present { failure = admission.failure; }
        expressions = admission.facts;
        return None;
    }
    let appended: DirectMirScalarProgramExpressionSet =
        DirectMirScalarCfgProgramMatchExpressionFromInstruction(
            admission.facts, instruction, expression_row, global_row,
            local_offset, signature, index, locals, logical_record,
            payload_free_enum, referenced_enum, option_int_abi);
    if !appended.valid {
        if !failure.present {
            failure = DirectMirScalarProgramExpressionAdmissionFailureAt(
                "enum-match", -1);
        }
        expressions = appended;
        return None;
    }
    if ArrayLength(appended.graph_starts) != expression_row + 1 {
        if !failure.present {
            failure = DirectMirScalarProgramExpressionAdmissionFailureAt(
                "admitted-cardinality", -1);
        }
        expressions = appended;
        return None;
    }
    let root: Int = appended.graph_roots[expression_row];
    if (expected_type != "" && !DirectMirScalarCfgSourceLocalTypeMatchesResolved(
            expected_type, appended.node_types[root])) ||
            appended.node_types[root] == "" {
        if !failure.present {
            failure = DirectMirScalarProgramExpressionAdmissionFailureAt(
                "admitted-type", root);
        }
        expressions = appended;
        return None;
    }
    expressions = appended;
    return Some(expression_row);
}
