// Range-aware LLVM projection for every routine in the scalar program GraphPlan.

import "direct_mir_scalar_cfg_program_extension_readiness_owner.pgy";
import "direct_mir_scalar_program_process_exit_owner.pgy";
import "direct_mir_scalar_program_llvm_expression_owner.pgy";
import "direct_mir_scalar_cfg_program_llvm_operation_owner.pgy";
import "direct_mir_scalar_program_llvm_string_global_owner.pgy";
import "direct_mir_scalar_cfg_local_emission_owner.pgy";
import "direct_mir_scalar_cfg_string_llvm_materialization_owner.pgy";
import "direct_mir_scalar_program_llvm_builtin_materialization_owner.pgy";
import "direct_mir_scalar_program_llvm_array_mutation_owner.pgy";
import "direct_mir_scalar_program_llvm_option_int_owner.pgy";
import "direct_mir_scalar_program_llvm_option_string_owner.pgy";
import "direct_mir_scalar_program_llvm_option_bool_owner.pgy";
import "direct_mir_scalar_program_llvm_two_int_nominal_owner.pgy";
import "direct_mir_scalar_program_llvm_array_int_value_result_owner.pgy";
import "direct_mir_scalar_program_llvm_array_bool_materialization_owner.pgy";
import "direct_mir_scalar_program_expression_kind_query_owner.pgy";
import "direct_mir_scalar_program_llvm_array_bool_value_result_owner.pgy";
import "direct_mir_scalar_program_llvm_array_string_value_result_owner.pgy";
import "direct_mir_scalar_program_llvm_logical_record_owner.pgy";
import "direct_mir_scalar_program_llvm_logical_record_option_owner.pgy";
import "direct_mir_scalar_program_llvm_logical_record_value_result_owner.pgy";
import "direct_mir_scalar_program_llvm_logical_record_array_value_result_owner.pgy";
import "direct_mir_scalar_program_llvm_set_string_value_result_owner.pgy";
import "direct_mir_scalar_program_process_exit_owner.pgy";
import "direct_mir_scalar_program_llvm_string_collection_materialization_owner.pgy";
import "direct_mir_scalar_program_llvm_array_string_cleanup_owner.pgy";
import "direct_mir_scalar_cfg_llvm_foreign_declaration_owner.pgy";
import "direct_mir_scalar_cfg_program_llvm_signature_owner.pgy";
import "direct_mir_llvm_text_format_owner.pgy";
import "runtime_value_representation_owner.pgy";
import "direct_mir_scalar_program_llvm_runtime_value_expression_owner.pgy";
import "../mir/runtime_call_abi_fact_owner.pgy";

func DirectMirScalarCfgProgramLlvmRoutine(
    ref plan: DirectMirScalarCfgGraphPlan, routine: Int,
    formatted_print: CompilerRuntimeCallAbiFact,
    process_exit: CompilerRuntimeCallAbiFact,
    ref runtime: DirectMirScalarProgramRuntimeAbiProjection,
    int_line_format: String, string_line_format: String,
    target: CompilerTargetProjectionFact
) -> String {
    let output: String = DirectMirScalarCfgProgramLlvmRoutineSignature(
        plan, routine);
    output = Concat(output, " {\nentry:\n");
    if routine == plan.routines.entrypoint_ordinal &&
        plan.program.runtime_abi.process_args_id != 0 {
        output = Concat(output,
            "  store i32 %argc, ptr @pgy.selfhost.argc, align 4\n  store ptr %argv, ptr @pgy.selfhost.argv, align 8\n");
    }
    output = Concat(output,
        DirectMirScalarProgramLlvmArrayIntValueParameterAddressableCopyIn(
            plan, routine));
    output = Concat(output,
        DirectMirScalarProgramLlvmArrayIntValueResultCopyIn(plan, routine));
    output = Concat(output,
        DirectMirScalarProgramLlvmArrayBoolValueResultCopyIn(plan, routine));
    output = Concat(output,
        DirectMirScalarProgramLlvmArrayStringValueResultCopyIn(plan, routine));
    output = Concat(output,
        DirectMirScalarProgramLlvmLogicalRecordValueResultCopyIn(
            plan, routine));
    output = Concat(output, DirectMirScalarProgramLlvmLogicalRecordArrayValueResultCopyIn(plan, routine));
    output = Concat(output,
        DirectMirScalarProgramLlvmSetStringValueResultCopyIn(plan, routine));
    output = Concat(output, DirectMirScalarCfgLlvmLocalDeclarationsInRange(
        plan, plan.routines.local_starts[routine],
        plan.routines.local_counts[routine], routine));
    let block_start: Int = plan.routines.block_starts[routine];
    let block_end: Int = block_start + plan.routines.block_counts[routine];
    output = Concat(output, "  br label %pgy.r");
    output = Concat(output, ToString(routine));
    output = Concat(output, ".block.");
    output = Concat(output, ToString(block_start));
    output = Concat(output, "\n");
    let block: Int = block_start;
    while block < block_end {
        output = Concat(output, "\npgy.r");
        output = Concat(output, ToString(routine));
        output = Concat(output, ".block.");
        output = Concat(output, ToString(block));
        output = Concat(output, ":\n");
        let operation: Int = plan.block_operation_starts[block];
        let operation_end: Int = operation +
            plan.block_operation_counts[block];
        while operation < operation_end {
            let emitted: String = DirectMirScalarCfgProgramLlvmOperation(
                plan, routine, operation, formatted_print, process_exit,
                runtime, int_line_format, string_line_format, target);
            if emitted == "" &&
                (plan.operation_kinds[operation] ==
                    DirectMirScalarCfgOpPhiInt() ||
                 plan.operation_kinds[operation] ==
                    DirectMirScalarCfgOpPhiString() ||
                 plan.operation_kinds[operation] ==
                    DirectMirScalarCfgOpPhiValue()) {
                // Memory locals already carry the selected predecessor value.
            }
            if emitted == "" && plan.operation_kinds[operation] !=
                    DirectMirScalarCfgOpPhiInt() &&
                    plan.operation_kinds[operation] !=
                    DirectMirScalarCfgOpPhiString() &&
                    plan.operation_kinds[operation] !=
                    DirectMirScalarCfgOpPhiValue() {
                Die("direct MIR scalar program LLVM operation is unsupported");
            }
            output = Concat(output, emitted);
            operation = operation + 1;
        }
        let return_row: Int =
            plan.program.block_return_expression_rows[block];
        if return_row == DirectMirScalarCfgVoidReturnExpressionRow() {
            if routine == plan.routines.entrypoint_ordinal {
                output = Concat(output,
                    DirectMirScalarProgramLlvmStringArrayCleanup(
                        plan, routine));
                output = Concat(output, "  ret i32 0\n");
            } else {
                output = Concat(output,
                    DirectMirScalarProgramLlvmArrayStringValueResultCopyOut(
                        plan, routine, block));
                output = Concat(output,
                    DirectMirScalarProgramLlvmArrayIntValueResultCopyOut(
                        plan, routine, block));
                output = Concat(output,
                    DirectMirScalarProgramLlvmArrayBoolValueResultCopyOut(
                        plan, routine, block));
                output = Concat(output,
                    DirectMirScalarProgramLlvmLogicalRecordValueResultCopyOut(
                        plan, routine, block));
                output = Concat(output, DirectMirScalarProgramLlvmLogicalRecordArrayValueResultCopyOut(plan, routine, block));
                output = Concat(output,
                    DirectMirScalarProgramLlvmSetStringValueResultCopyOut(
                        plan, routine, block));
                output = Concat(output, "  ret void\n");
            }
        } else if return_row >= 0 {
            let expression: DirectMirScalarProgramLlvmExpression =
                DirectMirScalarProgramLlvmExpressionAt(
                    plan.program.expressions, return_row, runtime,
                    plan.program.logical_record,
                    plan.program.payload_free_enum, plan.routines, routine,
                    target);
            if !expression.valid { Die(
                "direct MIR scalar CFG LLVM return expression is invalid"); }
            output = Concat(output, expression.instructions);
            output = Concat(output,
                DirectMirScalarProgramLlvmArrayIntValueResultCopyOut(
                    plan, routine, block));
            output = Concat(output,
                DirectMirScalarProgramLlvmArrayBoolValueResultCopyOut(
                    plan, routine, block));
            output = Concat(output,
                DirectMirScalarProgramLlvmArrayStringValueResultCopyOut(
                    plan, routine, block));
            output = Concat(output,
                DirectMirScalarProgramLlvmLogicalRecordValueResultCopyOut(
                    plan, routine, block));
            output = Concat(output, DirectMirScalarProgramLlvmLogicalRecordArrayValueResultCopyOut(plan, routine, block));
            output = Concat(output,
                DirectMirScalarProgramLlvmSetStringValueResultCopyOut(
                    plan, routine, block));
            output = Concat(output, "  ret ");
            output = Concat(output, DirectMirScalarProgramLlvmTypeForProgram(
                expression.type_name, plan.program.nominal_abi,
                plan.program.logical_record,
                plan.program.payload_free_enum));
            output = Concat(output, " ");
            output = Concat(output, expression.value);
            output = Concat(output, "\n");
        } else if plan.block_condition_kinds[block] ==
                DirectMirScalarCfgConditionExpression() {
            let condition: DirectMirScalarProgramLlvmExpression =
                DirectMirScalarProgramLlvmExpressionAt(
                    plan.program.expressions,
                    plan.program.block_condition_expression_rows[block],
                    runtime, plan.program.logical_record,
                    plan.program.payload_free_enum, plan.routines, routine,
                    target);
            if !condition.valid || condition.type_name !=
                    CompilerAbiLayoutBoolTypeName() {
                Die("direct MIR scalar CFG LLVM condition is invalid");
            }
            output = Concat(output, condition.instructions);
            output = Concat(output, "  br i1 ");
            output = Concat(output, condition.value);
            output = Concat(output, ", label %pgy.r");
            output = Concat(output, ToString(routine));
            output = Concat(output, ".block.");
            output = Concat(output, ToString(plan.block_succ_true[block]));
            output = Concat(output, ", label %pgy.r");
            output = Concat(output, ToString(routine));
            output = Concat(output, ".block.");
            output = Concat(output, ToString(plan.block_succ_false[block]));
            output = Concat(output, "\n");
        } else if plan.block_succ_true[block] >= 0 {
            output = Concat(output, "  br label %pgy.r");
            output = Concat(output, ToString(routine));
            output = Concat(output, ".block.");
            output = Concat(output, ToString(plan.block_succ_true[block]));
            output = Concat(output, "\n");
        } else if routine == plan.routines.entrypoint_ordinal {
            output = Concat(output,
                DirectMirScalarProgramLlvmStringArrayCleanup(plan, routine));
            output = Concat(output, "  ret i32 0\n");
        } else if DirectMirScalarProgramBlockEndsWithProcessExit(
                plan.operation_kinds, plan.block_operation_starts[block],
                plan.block_operation_counts[block]) {
            output = Concat(output, "  unreachable\n");
        } else if return_row == -1 {
            // Readiness proved this is the empty exhaustive-match fallthrough.
            output = Concat(output, "  unreachable\n");
        } else {
            Die("direct MIR scalar program callable return is missing");
        }
        block = block + 1;
    }
    return Concat(output, "}\n");
}

func DirectMirScalarCfgEmitProgramLlvm(
    ref plan: DirectMirScalarCfgGraphPlan,
    formatted_print: CompilerRuntimeCallAbiFact,
    process_exit: CompilerRuntimeCallAbiFact,
    ref runtime: DirectMirScalarProgramRuntimeAbiProjection,
    int_line_format: String, string_line_format: String,
    target: CompilerTargetProjectionFact
) -> String {
    if !DirectMirScalarCfgProgramExtensionReadyForPlan(plan) {
        Die("direct MIR scalar CFG program LLVM projection is invalid");
    }
    let int_size: Int = DirectMirScalarLlvmFormatByteCount(int_line_format);
    let string_size: Int =
        DirectMirScalarLlvmFormatByteCount(string_line_format);
    let array_int_runtime: DirectMirScalarProgramArrayIntRuntimeRequirement =
        DirectMirScalarProgramArrayIntRuntimeRequirementFromPlan(plan);
    if !array_int_runtime.valid { Die(
        "direct MIR scalar LLVM Array<Int> runtime requirement is invalid"); }
    let output: String =
        "@.pgy.scalar.cfg.int.format = private unnamed_addr constant [";
    output = Concat(
        CompilerRuntimeValueLlvmLocalPreamble(plan.local_types),
        output);
    output = Concat(
        DirectMirScalarProgramLlvmLogicalRecordOptionPreamble(
            plan.program.logical_record, target), output);
    output = Concat(DirectMirScalarProgramLlvmLogicalRecordArrayPreamble(plan, target), output);
    output = Concat(
        DirectMirScalarProgramLlvmLogicalRecordPreamble(
            plan.program.logical_record, target), output);
    output = Concat(
        DirectMirScalarProgramLlvmArrayIntValueResultPreamble(
            plan.program.array_int_value_result, array_int_runtime, target),
        output);
    let array_bool_get_required: Bool =
        DirectMirScalarProgramExpressionContainsKind(
            plan.program.expressions,
            DirectMirScalarProgramExprArrayBoolIndex());
    let array_bool_preamble: String =
        DirectMirScalarProgramLlvmArrayBoolPreamble(
            plan.program.array_bool_abi, array_bool_get_required, target);
    if DirectMirScalarProgramArrayBoolPushRequired(plan.operation_kinds) {
        array_bool_preamble = Concat(
            array_bool_preamble,
            DirectMirScalarProgramLlvmArrayBoolPushMaterialization());
    }
    output = Concat(array_bool_preamble, output);
    output = Concat(
        DirectMirScalarProgramLlvmStringCollectionMaterialization(
            plan, runtime), output);
    output = Concat(
        DirectMirScalarProgramLlvmTwoIntNominalPreamble(
            plan.program.nominal_abi, target), output);
    output = Concat(
        DirectMirScalarProgramLlvmOptionIntPreamble(
            plan.program.option_int_abi, target), output);
    output = Concat(
        DirectMirScalarProgramLlvmOptionStringPreamble(
            plan.program.option_string_abi, target), output);
    output = Concat(
        DirectMirScalarProgramLlvmOptionBoolPreamble(
            plan.program.option_bool_abi, target), output);
    output = Concat(output, ToString(int_size));
    output = Concat(output, " x i8] c\"");
    output = Concat(output,
        DirectMirScalarLlvmFormatPayload(int_line_format));
    output = Concat(output, "\\00\", align 1\n");
    output = Concat(output,
        "@.pgy.scalar.cfg.string.format = private unnamed_addr constant [");
    output = Concat(output, ToString(string_size));
    output = Concat(output, " x i8] c\"");
    output = Concat(output,
        DirectMirScalarLlvmFormatPayload(string_line_format));
    output = Concat(output, "\\00\", align 1\n");
    output = Concat(output, DirectMirScalarProgramLlvmStringGlobals(
        plan.program.expressions));
    output = Concat(output,
        DirectMirScalarCfgLlvmForeignDeclarations(plan));
    output = Concat(output,
        DirectMirScalarProgramLlvmRuntimeValueDeclarations(
            plan.program.expressions));
    output = Concat(output,
        DirectMirScalarProgramLlvmIntentObservabilityDeclarations(
            plan.program.expressions));
    output = Concat(output,
        DirectMirScalarCfgStringLlvmConcatBlock(
            plan, runtime.string_concat));
    output = Concat(output,
        DirectMirScalarProgramLlvmBuiltinMaterialization(
            plan, runtime, formatted_print));
    output = Concat(output,
        DirectMirScalarProgramLlvmLocalArraySetMaterialization(
            plan));
    output = Concat(output, "\ndeclare i32 @");
    output = Concat(output, formatted_print.symbol);
    output = Concat(output, "(ptr, ...)\n");
    if DirectMirScalarProgramHasProcessExit(plan.operation_kinds) {
        if !CompilerRuntimeCallAbiProcessExitFactReady(process_exit) {
            Die("direct MIR scalar LLVM process-exit ABI is invalid");
        }
        output = Concat(output, "declare void @");
        output = Concat(output, process_exit.symbol);
        output = Concat(output, "(i32)\n");
    }
    if plan.program.runtime_abi.string_compare_id != 0 {
        if !CompilerRuntimeCallAbiStringCompareFactReady(
                runtime.string_compare) {
            Die("direct MIR scalar CFG program LLVM compare ABI is invalid");
        }
        output = Concat(output, "declare i32 @");
        output = Concat(output, runtime.string_compare.symbol);
        output = Concat(output, "(ptr, ptr)\n");
    }
    output = Concat(output, "\n");
    let routine: Int = 0;
    while routine < ArrayLength(plan.routines.roles) {
        output = Concat(output, DirectMirScalarCfgProgramLlvmRoutine(
            plan, routine, formatted_print, process_exit, runtime,
            int_line_format, string_line_format, target));
        routine = routine + 1;
    }
    return output;
}
