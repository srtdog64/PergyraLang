// LLVM signatures projected from ordered GraphPlan routine parameter facts.

import "direct_mir_scalar_cfg_graph_fact_owner.pgy";
import "direct_mir_scalar_program_llvm_type_owner.pgy";

func DirectMirScalarCfgProgramLlvmRoutineSignature(
    ref plan: DirectMirScalarCfgGraphPlan, routine: Int
) -> String {
    if routine == plan.routines.entrypoint_ordinal {
        return "define i32 @main()";
    }
    let output: String = Concat("define internal ",
        DirectMirScalarProgramLlvmTypeForNominal(
            plan.routines.return_types[routine], plan.program.nominal_abi));
    output = Concat(output, Concat(
        " @pgy.scalar.routine.", ToString(routine)));
    output = Concat(output, "(");
    let ordinal: Int = 0;
    let start: Int = plan.routines.parameter_starts[routine];
    while ordinal < plan.routines.parameter_counts[routine] {
        if ordinal > 0 { output = Concat(output, ", "); }
        output = Concat(output, DirectMirScalarProgramLlvmTypeForNominal(
            plan.routines.parameter_types[start + ordinal],
            plan.program.nominal_abi));
        output = Concat(output, Concat(
            " %pgy.param.", ToString(ordinal)));
        ordinal = ordinal + 1;
    }
    return Concat(output, ")");
}
