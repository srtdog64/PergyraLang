// Selects one typed match-expression admission from the carried value type.

import "direct_mir_scalar_program_payload_free_enum_match_condition_owner.pgy";
import "direct_mir_scalar_program_payload_enum_match_condition_owner.pgy";
import "direct_mir_scalar_program_option_int_match_condition_owner.pgy";
import "direct_mir_scalar_program_int_match_condition_owner.pgy";
import "direct_mir_scalar_program_payload_free_enum_result_match_condition_owner.pgy";

func DirectMirScalarCfgProgramMatchExpressionFromInstruction(
    facts: DirectMirScalarProgramExpressionSet,
    ref instruction: JsonObjectFactTable,
    expression_row: Int, global_row: Int, local_offset: Int,
    ref signature: DirectMirRoutineSignatureFact,
    ref index: MirRoutineFactIndex,
    ref locals: DirectMirScalarCfgLocalRefPlan,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    ref payload_free_enum: DirectMirScalarProgramPayloadFreeEnumFact,
    ref referenced_enum: DirectMirScalarProgramReferencedEnumFact,
    ref option_int_abi: DirectMirOptionMatchAbiFact
) -> DirectMirScalarProgramExpressionSet {
    if !JsonObjectFactStringFieldEquals(
            instruction, "source_type", "AST_MATCH_CASE") {
        return DirectMirScalarProgramPayloadFreeEnumMatchConditionFromInstruction(
            facts, instruction, expression_row, payload_free_enum);
    }
    let value_node: Int = facts.graph_roots[expression_row];
    var enum_row: Int = -1;
    var value_type: String = "";
    if value_node >= 0 && value_node < ArrayLength(facts.node_types) {
        // The aggregate moves into one selected admission below. Keep the
        // type discriminator independent of that moved member storage.
        value_type = Concat("", facts.node_types[value_node]);
        enum_row = DirectMirScalarProgramReferencedEnumRow(
            referenced_enum, value_type);
    }
    if value_type != "" &&
        DirectMirScalarProgramPayloadFreeEnumResultTypeReady(
            value_type, logical_record, referenced_enum) {
        return DirectMirScalarProgramPayloadFreeEnumResultMatchFromInstruction(
            facts, instruction, expression_row, global_row, local_offset,
            signature, index, locals, logical_record, referenced_enum);
    }
    if value_type == CompilerAbiLayoutOptionIntTypeName() {
        return DirectMirScalarProgramOptionIntMatchConditionFromInstruction(
            facts, instruction, expression_row, global_row, local_offset,
            signature, index, locals, option_int_abi);
    }
    if value_type == CompilerAbiLayoutIntTypeName() {
        return DirectMirScalarProgramIntMatchConditionFromInstruction(
            facts, instruction, expression_row);
    }
    if enum_row >= 0 && referenced_enum.payload_flags[enum_row] == 1 {
        return DirectMirScalarProgramPayloadEnumMatchConditionFromInstruction(
            facts, instruction, expression_row, global_row, local_offset,
            signature, index, locals, referenced_enum);
    }
    return DirectMirScalarProgramPayloadFreeEnumMatchConditionFromInstruction(
        facts, instruction, expression_row, payload_free_enum);
}
