// Appends every admitted program routine through one range-aware flat loop.
import "direct_mir_scalar_cfg_program_value_storage_owner.pgy";
import "direct_mir_scalar_cfg_program_graph_storage_mutation_owner.pgy";
import "direct_mir_scalar_cfg_program_array_mutation_storage_owner.pgy";
import "direct_mir_scalar_cfg_program_instruction_expression_owner.pgy";
import "direct_mir_scalar_cfg_program_statement_admission_owner.pgy";
import "direct_mir_scalar_cfg_graph_input_owner.pgy";
import "direct_mir_scalar_cfg_phi_operation_admission_owner.pgy";
import "direct_mir_scalar_cfg_program_parameter_identity_owner.pgy";
import "direct_mir_scalar_cfg_program_expression_diagnostic_owner.pgy";
import "direct_mir_scalar_cfg_control_transfer_admission_owner.pgy";
import "direct_mir_scalar_cfg_expression_base_owner.pgy";
import "direct_mir_scalar_program_option_int_abi_owner.pgy";
import "direct_mir_scalar_result_abi_owner.pgy";
import "direct_mir_scalar_cfg_program_definition_route_owner.pgy";
import "direct_mir_scalar_program_option_string_abi_owner.pgy";
import "direct_mir_scalar_program_option_bool_abi_owner.pgy";
import "direct_mir_scalar_program_return_expression_abi_owner.pgy";
import "direct_mir_scalar_program_indexed_assignment_fact_owner.pgy";
import "direct_mir_scalar_program_logical_record_member_rebind_owner.pgy";
import "direct_mir_scalar_program_collection_ownership_transition_admission_owner.pgy";
import "direct_mir_scalar_cfg_void_return_admission_owner.pgy";
import "direct_mir_scalar_cfg_type_family_owner.pgy";
import "direct_mir_scalar_cfg_loop_flow_admission_owner.pgy";
import "direct_mir_scalar_cfg_program_range_projection_owner.pgy";
import "direct_mir_scalar_cfg_program_range_condition_owner.pgy";
import "direct_mir_scalar_cfg_program_phi_storage_owner.pgy";
struct DirectMirScalarCfgProgramRoutineAdmission {
    let valid: Bool;
    let storage: DirectMirScalarCfgProgramGraphStorage;
    let expressions: DirectMirScalarProgramExpressionSet;
    let option_int_abi: DirectMirOptionMatchAbiFact;
    let result_abi: DirectMirScalarResultAbiSet;
    let option_string_abi: DirectMirOptionMatchAbiFact;
    let option_bool_abi: DirectMirOptionMatchAbiFact;
    let ranges: DirectMirScalarCfgRangeFactSet;
    let collection_ownership:
        DirectMirScalarProgramCollectionOwnershipTransitionFact;
}
func DirectMirScalarCfgProgramInputReady(
    ref input: DirectMirScalarCfgGraphInput
) -> Bool {
    return DirectMirScalarCfgRangeFactSetSourceReady(
            input.ranges, ArrayLength(input.index.block_starts)) &&
        DirectMirScalarCfgForEachFactCount(input.foreach_facts) == 0 &&
        !input.string_arrays.valid && !input.array_int_program.valid &&
        !input.collections.valid;
}
func DirectMirScalarCfgProgramAppendRoutine(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    routine_row: Int, routine_ordinal: Int,
    ref callables: DirectMirScalarCfgProgramCallableInventory,
    ref routine_instances: DirectMirRoutineInstanceInventory,
    ref input: DirectMirScalarCfgGraphInput,
    storage: DirectMirScalarCfgProgramGraphStorage,
    expressions: DirectMirScalarProgramExpressionSet,
    ranges: DirectMirScalarCfgRangeFactSet,
    collection_ownership:
        DirectMirScalarProgramCollectionOwnershipTransitionFact,
    option_int_abi: DirectMirOptionMatchAbiFact,
    option_string_abi: DirectMirOptionMatchAbiFact,
    option_bool_abi: DirectMirOptionMatchAbiFact,
    result_abi: DirectMirScalarResultAbiSet,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    ref payload_free_enum: DirectMirScalarProgramPayloadFreeEnumFact,
    ref referenced_enum: DirectMirScalarProgramReferencedEnumFact,
    ref array_int_value_result: DirectMirScalarProgramArrayIntValueResultFact,
    ref array_bool_abi: DirectMirScalarProgramArrayBoolAbiFact,
    ref array_string_abi: DirectMirScalarProgramArrayStringAbiFact,
    inout refusal: String
) -> DirectMirScalarCfgProgramRoutineAdmission {
    // `refusal` names a routine this route cannot emit; the admission is then
    // invalid but still carries every input. A broken input ends in Die.
    // (Not a result field: a field-pack rebind must carry every String field.)
    refusal = "";
    if !input.index.valid || !DirectMirScalarCfgProgramInputReady(input) {
        Die("direct MIR scalar program routine input has an external collection plan");
    }
    let signature: DirectMirRoutineSignatureFact =
        DirectMirRoutineInstanceSignatureAt(routine_instances, routine_ordinal);
    if !DirectMirRoutineSignatureFactReady(signature) || signature.row != routine_row ||
        (routine_ordinal == 0 && (signature.name != "Main" ||
         !DirectMirScalarCfgEntrypointReturnTypeSupported(
             signature.return_type) || signature.param_count != 0)) ||
        (routine_ordinal != 0 &&
         (!DirectMirScalarCfgProgramCallableInventoryOrdinalReady(
              callables, routine_ordinal) ||
          signature.digest !=
              callables.signature_digests[routine_ordinal - 1])) {
        Die("direct MIR scalar program routine signature is invalid");
    }
    option_int_abi = DirectMirScalarProgramOptionIntAbiFromRoutineParameters(option_int_abi, admitted.routines, routine_row, signature.param_count);
    option_string_abi = DirectMirScalarProgramOptionStringAbiFromRoutineParameters(option_string_abi, admitted.routines, routine_row, signature.param_count);
    let indexed_assignments:
        DirectMirScalarProgramIndexedAssignmentFactSet =
        DirectMirScalarProgramIndexedAssignmentFactSetFromOwners(
            admitted, input.index, input.use_facts, signature,
            array_int_value_result, array_string_abi, routine_ordinal);
    let locals: DirectMirScalarCfgLocalRefPlan =
        DirectMirScalarCfgLocalRefPlanFromOwners(
            admitted, input.index, input.use_facts, input.wire, input.ranges,
            input.foreach_facts, input.string_arrays,
            input.array_int_program, input.collections, logical_record,
            referenced_enum, indexed_assignments, signature.parameters);
    let types: DirectMirScalarCfgValueTypePlan =
        DirectMirScalarCfgValueTypePlanFromOwnersWithReferencedEnum(
            input.index, locals, input.foreach_elements, logical_record,
            referenced_enum, signature.parameters);
    if !locals.valid {
        Die(DirectMirScalarCfgProgramRoutineAdmissionRefusal(
            "local_refs", routine_ordinal, -1, -1, ""));
    }
    if !types.valid {
        Die(DirectMirScalarCfgProgramRoutineAdmissionRefusal(
            "value_types", routine_ordinal, -1, -1, ""));
    }
    let routine_ranges: DirectMirScalarCfgRangeFactSet =
        DirectMirScalarCfgRangeFactsAtLocalRows(
            input.ranges, locals.local_ref_kinds,
            locals.local_ref_syntax_ids);
    if DirectMirScalarCfgRangeFactCount(routine_ranges) !=
            DirectMirScalarCfgRangeFactCount(input.ranges) ||
        !DirectMirScalarCfgLoopFlowFactsReady(
            input.index, admitted.routines, routine_row,
            routine_ranges, input.foreach_facts) {
        Die(DirectMirScalarCfgProgramRoutineAdmissionRefusal(
            "range_facts", routine_ordinal, -1, -1, ""));
    }
    if !DirectMirScalarCfgLocalInventoryReadyWithReferencedEnum(
        input.index, locals.local_names, types.local_types,
        input.foreach_facts, input.string_arrays, input.array_int_program,
        input.collections, logical_record, referenced_enum,
        signature.parameters
    ) {
        Die(DirectMirScalarCfgProgramRoutineAdmissionRefusal(
            "local_inventory", routine_ordinal, -1, -1, ""));
    }
    let member_rebinds:
        DirectMirScalarProgramLogicalRecordMemberRebindFactSet =
        DirectMirScalarProgramLogicalRecordMemberRebindFactSetFromOwners(
            admitted, input.index, input.use_facts, signature, logical_record,
            locals, types);
    let nested_indexed_assignments:
        DirectMirScalarProgramLogicalRecordArrayIndexedAssignmentFactSet =
        DirectMirScalarProgramLogicalRecordArrayIndexedAssignmentFactsFromOwners(
            admitted, input.index, input.use_facts, signature, logical_record,
            locals, types);
    let local_offset: Int = ArrayLength(storage.values.local_names);
    let value_offset: Int = ArrayLength(storage.values.value_names);
    let block_offset: Int = ArrayLength(storage.blocks.succ_true);
    let operation_offset: Int = ArrayLength(storage.operations.kinds);
    let phi_offset: Int =
        ArrayLength(storage.operations.phi_predecessor_blocks);
    ranges = DirectMirScalarCfgProgramRangeFactsMergeRoutine(
        ranges, routine_ranges, local_offset, block_offset,
        ArrayLength(input.index.block_starts));
    if !ranges.valid {
        Die(DirectMirScalarCfgProgramRoutineAdmissionRefusal(
            "range_projection", routine_ordinal, -1, -1, ""));
    }
    let values: DirectMirScalarCfgProgramValueStorage =
        DirectMirScalarCfgProgramValuesAppendRoutine(
            storage.values, locals, types, block_offset);
    if !values.valid {
        Die("direct MIR scalar program routine value storage is invalid");
    }
    var blocks: DirectMirScalarCfgProgramBlockStorage = storage.blocks;
    var operations: DirectMirScalarCfgProgramOperationStorage =
        storage.operations;
    var parameter_types: Array<String> = [];
    if !DirectMirScalarCfgProgramAppendParameterTypes(
            parameter_types, signature) {
        Die(DirectMirScalarCfgProgramRoutineAdmissionRefusal(
            "parameter_types", routine_ordinal, -1, -1, ""));
    }
    // Keep block identity stable. Unreachable blocks still undergo complete
    // instruction admission; their flags must agree with the owned CFG edges.
    let reachable: Array<Int> = MirRoutineGraphDistances(
        input.index.block_succ_true, input.index.block_succ_false, 0);
    var block: Int = 0;
    while block < ArrayLength(input.index.block_starts) {
        if input.index.block_reachable[block] != (reachable[block] >= 0) {
            refusal = DirectMirScalarCfgProgramRoutineAdmissionRefusal(
                "block_reachability_identity", routine_ordinal, block, -1, ""); break;
        }
        let operation_start: Int = ArrayLength(operations.kinds);
        var condition_row: Int = -1;
        var return_row: Int = -1;
        var instruction_row: Int = 0;
        while instruction_row < input.index.block_instruction_counts[block] {
            let local_instruction: Int =
                input.index.block_instruction_starts[block] + instruction_row;
            let global_row: Int =
                input.index.instruction_facts.global_start + local_instruction;
            let kind: String = admitted.routines.instruction_kinds[global_row];
            let source: String =
                admitted.routines.instruction_source_types[global_row];
            let instruction: JsonObjectFactTable = JsonObjectFactTableFromBounds(
                admitted.routines.source_json, admitted.routines.source_json_extent,
                admitted.routines.instruction_starts[global_row],
                admitted.routines.instruction_ends[global_row]);
            let capture: MirRoutineInstructionScalarCapture =
                MirRoutineInstructionFactBundleAtGlobal(
                    input.index.instruction_facts, global_row);
            var expression_failure:
                DirectMirScalarProgramExpressionAdmissionFailure =
                    DirectMirScalarProgramExpressionAdmissionFailureEmpty();
            if !capture.valid { refusal = DirectMirScalarCfgProgramRoutineAdmissionRefusal(
                "instruction_capture", routine_ordinal, block, global_row, source); break; }
            if DirectMirScalarCfgScalarTypeSupported(capture.abi_type_name) &&
                !DirectMirInstructionHasNoPhysicalAbi(admitted.routines.source_json, admitted.routines.source_json_extent, capture, capture.abi_type_name) {
                refusal = DirectMirScalarCfgProgramRoutineAdmissionRefusal(
                    "scalar_physical_abi", routine_ordinal, block, global_row, source); break;
            }
            if !DirectMirScalarProgramLogicalRecordInstructionReady(
                    logical_record, admitted.routines.source_json, admitted.routines.source_json_extent, capture) {
                refusal = DirectMirScalarCfgProgramRoutineAdmissionRefusal(
                    "logical_record_abi", routine_ordinal, block, global_row, source); break;
            }
            option_int_abi =
                DirectMirScalarProgramOptionIntAbiFromInstruction(
                    option_int_abi, admitted.routines.source_json, admitted.routines.source_json_extent, capture);
            result_abi = DirectMirScalarResultAbiSetFromInstruction(
                result_abi, admitted.routines.source_json,
                admitted.routines.source_json_extent, capture);
            option_string_abi =
                DirectMirScalarProgramOptionStringAbiFromInstruction(
                    option_string_abi, admitted.routines.source_json, admitted.routines.source_json_extent, capture);
            option_bool_abi =
                DirectMirScalarProgramOptionBoolAbiFromInstruction(
                    option_bool_abi, admitted.routines.source_json, admitted.routines.source_json_extent, capture);
            if kind == "loop-init" {
                let range: DirectMirScalarCfgRangeIterationFact =
                    DirectMirScalarCfgRangeFactAtInitGlobalRow(
                        routine_ranges, global_row);
                if !range.valid || block != range.init_block {
                    refusal = DirectMirScalarCfgProgramRoutineAdmissionRefusal(
                        "range_init", routine_ordinal, block,
                        global_row, source); break;
                }
            } else if kind == "def" || kind == "assign" {
                let member_rebind:
                    DirectMirScalarProgramLogicalRecordMemberRebindFact =
                    DirectMirScalarProgramLogicalRecordMemberRebindFactAtGlobal(
                        member_rebinds, global_row);
                let indexed_assignment: DirectMirScalarProgramIndexedAssignmentFact = DirectMirScalarProgramIndexedAssignmentFactAtGlobal(indexed_assignments, global_row);
                let nested_indexed:
                    DirectMirScalarProgramLogicalRecordArrayIndexedAssignmentFact =
                    DirectMirScalarProgramLogicalRecordArrayIndexedAssignmentAtGlobal(
                        nested_indexed_assignments, global_row);
                let definition: DirectMirScalarCfgProgramDefinitionRoute =
                    DirectMirScalarCfgProgramRouteDefinition(
                        operations, expressions, expression_failure, source, kind,
                        capture, instruction, input.use_facts, input.index,
                        global_row,
                        local_instruction, locals, types, input.wire,
                        local_offset, value_offset, parameter_types, callables,
                        routine_instances, routine_ordinal,
                        logical_record, payload_free_enum, referenced_enum,
                        signature,
                        member_rebind, nested_indexed,
                        indexed_assignment);
                if !definition.valid {
                    if expression_failure.present {
                        refusal = DirectMirScalarCfgProgramExpressionAdmissionRefusal(
                            global_row, source, expression_failure);
                    } else {
                        // A copy: the refusal text outlives the definition.
                        let failure_stage: String = Concat("", definition.failure_stage);
                        refusal = DirectMirScalarCfgProgramRoutineAdmissionRefusal(
                            failure_stage, routine_ordinal, block, global_row, source);
                    }
                }
                // The call consumed both; a refused definition hands them back
                // too, so the refusal return still carries them.
                operations = definition.operations;
                expressions = definition.expressions;
                if refusal != "" { break; }
            } else if kind == "stmt" {
                let statement: DirectMirScalarCfgProgramStatementAdmission =
                    DirectMirScalarCfgProgramAppendStatement(
                        operations, expressions, expression_failure, source, capture, instruction,
                        input.use_facts, input.index, global_row,
                        local_instruction, locals,
                        types, input.wire, local_offset, parameter_types,
                        callables, routine_instances, logical_record,
                        payload_free_enum,
                        referenced_enum, signature,
                        array_int_value_result, array_bool_abi,
                        array_string_abi,
                        routine_ordinal);
                if !statement.valid {
                    if expression_failure.present {
                        refusal = DirectMirScalarCfgProgramExpressionAdmissionRefusal(
                            global_row, source, expression_failure);
                    } else {
                        refusal = DirectMirScalarCfgProgramRoutineAdmissionRefusal(
                            "statement", routine_ordinal, block, global_row, source);
                    }
                }
                operations = statement.operations;
                expressions = statement.expressions;
                if refusal != "" { break; }
            } else if kind == "phi" {
                operations = DirectMirScalarCfgProgramOperationsAppendPhi(
                    operations, input.index, admitted, input.use_facts, routine_row,
                    block, instruction_row, locals, types, logical_record,
                    payload_free_enum, referenced_enum,
                    value_offset, block_offset);
                if !operations.valid { refusal = DirectMirScalarCfgProgramRoutineAdmissionRefusal(
                    "phi", routine_ordinal, block, global_row, source); break; }
            } else if kind == "branch" {
                let transfer: DirectMirScalarCfgControlTransferAdmission = DirectMirScalarCfgControlTransferFromOwners(
                    input.index, input.use_facts, source, global_row, block, instruction_row);
                if transfer.claimed {
                    if !transfer.valid { refusal = DirectMirScalarCfgProgramBranchTopologyAdmissionRefusal(routine_ordinal, block, global_row, source); break; }
                } else if source == "AST_FOR_LOOP" {
                    let range: DirectMirScalarCfgRangeIterationFact =
                        DirectMirScalarCfgRangeFactAtBranchGlobalRow(
                            routine_ranges, global_row);
                    if !range.valid || block != range.header_block {
                        refusal = DirectMirScalarCfgProgramBranchTopologyAdmissionRefusal(
                            routine_ordinal, block, global_row, source);
                        break;
                    }
                    let condition_row_opt: Option<Int> =
                        DirectMirScalarCfgProgramAppendRangeConditionExpression(
                            expressions, expression_failure, instruction,
                            input.use_facts, input.index, global_row,
                            local_instruction, locals, types, input.wire,
                            local_offset, parameter_types, signature,
                            callables, routine_instances, routine_ordinal,
                            logical_record, payload_free_enum,
                            referenced_enum, range);
                    if !IsSome(condition_row_opt) {
                        refusal = DirectMirScalarCfgProgramExpressionAdmissionRefusal(
                            global_row, source, expression_failure);
                        break;
                    }
                    condition_row = UnwrapOption(condition_row_opt);
                } else {
                    if instruction_row + 1 != input.index.block_instruction_counts[block] || input.index.block_succ_true[block] < 0 ||
                        input.index.block_succ_false[block] < 0 { refusal = DirectMirScalarCfgProgramBranchTopologyAdmissionRefusal(routine_ordinal, block, global_row, source); break; }
                    let condition_row_opt: Option<Int> =
                        DirectMirScalarCfgProgramAppendMatchConditionExpression(
                        expressions, expression_failure, instruction,
                        input.use_facts, input.index, global_row,
                        local_instruction,
                        locals, types, input.wire, local_offset,
                        parameter_types, signature, callables,
                        routine_instances, routine_ordinal,
                        logical_record, payload_free_enum, referenced_enum,
                        option_int_abi);
                    if !IsSome(condition_row_opt) { refusal = DirectMirScalarCfgProgramExpressionAdmissionRefusal(global_row, source, expression_failure); break; }
                    condition_row = UnwrapOption(condition_row_opt);
                }
            } else if kind == "return" {
                if !DirectMirScalarCfgTerminalReturnShapeReady(
                        input.index, capture, block, instruction_row) {
                    refusal = DirectMirScalarCfgProgramRoutineAdmissionRefusal("return_shape", routine_ordinal, block, global_row, source); break;
                }
                if signature.return_type == "Void" {
                    if !DirectMirScalarCfgVoidReturnReady(
                            input.index, input.use_facts, instruction, capture,
                            global_row, block, instruction_row,
                            source, signature.return_type) {
                        refusal = DirectMirScalarCfgProgramRoutineAdmissionRefusal("void_return", routine_ordinal, block, global_row, source); break;
                    }
                    return_row =
                        DirectMirScalarCfgVoidReturnExpressionRow();
                    instruction_row = instruction_row + 1;
                    continue;
                }
                if !DirectMirScalarProgramReturnExpressionAbiReady(
                        capture.expr0, capture.abi_type_name,
                        signature.return_type, logical_record,
                        referenced_enum) {
                    refusal = DirectMirScalarCfgProgramRoutineAdmissionRefusal("return_abi", routine_ordinal, block, global_row, source); break;
                }
                let return_row_opt: Option<Int> =
                    DirectMirScalarCfgProgramAppendTypedExpression(
                    expressions, expression_failure, instruction,
                    input.use_facts, input.index, global_row,
                    local_instruction, locals, types, input.wire,
                        local_offset, parameter_types, signature, callables,
                        routine_instances, routine_ordinal,
                        logical_record, payload_free_enum, referenced_enum, 0,
                    signature.return_type, false);
                if !IsSome(return_row_opt) { refusal = DirectMirScalarCfgProgramExpressionAdmissionRefusal(global_row, source, expression_failure); break; }
                return_row = UnwrapOption(return_row_opt);
            } else { refusal = DirectMirScalarCfgProgramRoutineAdmissionRefusal("instruction_kind", routine_ordinal, block, global_row, source); break; }
            instruction_row = instruction_row + 1;
        }
        // A refused instruction ends the routine; the tail below still
        // returns every input it was handed, as a field-pack move needs.
        if refusal != "" { break; }
        var true_target: Int = input.index.block_succ_true[block];
        var false_target: Int = input.index.block_succ_false[block];
        if routine_ordinal != 0 && signature.return_type == "Void" &&
            true_target < 0 && false_target < 0 && return_row == -1 {
            return_row = DirectMirScalarCfgVoidReturnExpressionRow();
        }
        if true_target >= 0 { true_target = true_target + block_offset; }
        if false_target >= 0 { false_target = false_target + block_offset; }
        blocks = DirectMirScalarCfgProgramBlocksAppend(
            blocks, true_target, false_target, operation_start,
            ArrayLength(operations.kinds) - operation_start,
            condition_row, return_row);
        block = block + 1;
    }
    let routines: DirectMirScalarCfgProgramRoutineCounts =
        DirectMirScalarCfgProgramRoutineCountsAppend(
            storage.routines, ArrayLength(values.local_names) - local_offset,
            ArrayLength(values.value_names) - value_offset,
            ArrayLength(blocks.succ_true) - block_offset,
            ArrayLength(operations.kinds) - operation_offset,
            ArrayLength(operations.phi_predecessor_blocks) - phi_offset);
    let appended_storage: DirectMirScalarCfgProgramGraphStorage =
        DirectMirScalarCfgProgramGraphStorage(
            values, blocks, operations, routines
        );
    // One terminal return: a refused routine still hands back every input.
    if refusal == "" {
        collection_ownership =
            DirectMirScalarProgramCollectionOwnershipTransitionAppendRoutine(
                collection_ownership, admitted.routines.source_json, admitted.routines.source_json_extent,
                input.index, appended_storage, expressions, callables,
                signature, logical_record,
                routine_ordinal, local_offset, operation_offset
            );
        if !collection_ownership.valid {
            refusal = DirectMirScalarCfgProgramRoutineAdmissionRefusal(
                "collection_ownership_transition", routine_ordinal, -1, -1, "");
        }
    }
    return DirectMirScalarCfgProgramRoutineAdmission(
        refusal == "", appended_storage, expressions,
        option_int_abi, result_abi,
        option_string_abi, option_bool_abi, ranges,
        collection_ownership);
}
