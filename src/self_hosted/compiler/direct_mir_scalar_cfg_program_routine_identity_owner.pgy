// Canonical routine identities consumed by the scalar-program partition.
import "direct_mir_scalar_cfg_routine_partition_fact_owner.pgy";
import "direct_mir_scalar_program_callable_signature_owner.pgy";
import "direct_mir_scalar_cfg_program_parameter_identity_owner.pgy";
struct DirectMirScalarCfgProgramRoutineIdentity {
    let valid: Bool;
    let roles: Array<Int>;
    let source_rows: Array<Int>;
    let source_syntax_ids: Array<Int>;
    let names: Array<String>;
    let return_types: Array<String>;
    let parameter_counts: Array<Int>;
    let parameter_starts: Array<Int>;
    let parameter_types: Array<String>;
    let signature_digests: Array<Int>;
    let cfg_digests: Array<Int>;
}
func DirectMirScalarCfgProgramRoutineIdentityFromOwners(
    ref routines: MirProgramRoutineIndex,
    routine_rows: Array<Int>, cfg_digests: Array<Int>,
    ref nominal: DirectMirScalarProgramTwoIntNominalAbiFact
) -> DirectMirScalarCfgProgramRoutineIdentity {
    let roles: Array<Int> = [];
    let source_rows: Array<Int> = []; let source_syntax_ids: Array<Int> = [];
    let names: Array<String> = []; let return_types: Array<String> = [];
    let parameter_counts: Array<Int> = [];
    let parameter_starts: Array<Int> = [];
    let parameter_types: Array<String> = [];
    let signature_digests: Array<Int> = [];
    let identity_valid: Bool = true;
    if ArrayLength(routine_rows) < 1 ||
        ArrayLength(routine_rows) != ArrayLength(cfg_digests) {
        identity_valid = false;
    }
    let ordinal: Int = 0;
    while identity_valid && ordinal < ArrayLength(routine_rows) {
        let routine_row: Int = routine_rows[ordinal];
        let first_block_count: Int =
            MirProgramRoutineIndexBlockInstructionCountAt(
                routines, routine_row, 0
            );
        let signature: DirectMirRoutineSignatureFact =
            DirectMirRoutineSignatureFactAt(
                routines, routine_row, first_block_count
            );
        if !DirectMirRoutineSignatureFactReady(signature) ||
            (ordinal == 0 && (signature.name != "Main" ||
             signature.return_type != "Void" || signature.param_count != 0)) ||
            (ordinal > 0 &&
             !DirectMirScalarProgramCallableSignatureSupported(
                signature, nominal)) ||
            cfg_digests[ordinal] == 0 {
            identity_valid = false;
        } else {
            ArrayPush(roles, DirectMirScalarCfgRoutineRoleCallable());
            if ordinal == 0 {
                ArraySet(roles, 0, DirectMirScalarCfgRoutineRoleEntrypoint());
            }
            ArrayPush(source_rows, routine_row);
            ArrayPush(source_syntax_ids, signature.source_syntax_id);
            ArrayPush(names, signature.name);
            ArrayPush(return_types, signature.return_type);
            ArrayPush(parameter_counts, signature.param_count);
            ArrayPush(parameter_starts, ArrayLength(parameter_types));
            if !DirectMirScalarCfgProgramAppendParameterTypes(
                    parameter_types, signature) { identity_valid = false; }
            ArrayPush(signature_digests, signature.digest);
        }
        ordinal = ordinal + 1;
    }
    return DirectMirScalarCfgProgramRoutineIdentity(
        identity_valid && ArrayLength(roles) == ArrayLength(routine_rows),
        roles, source_rows,
        source_syntax_ids, names, return_types, parameter_counts,
        parameter_starts, parameter_types, signature_digests, cfg_digests
    );
}
