// Scalar-CFG routine partition owner and start queries.

import "direct_mir_scalar_cfg_routine_partition_fact_owner.pgy";
import "direct_mir_scalar_cfg_program_routine_identity_owner.pgy";
import "../codegen/text/text_owner.pgy";

func DirectMirScalarProgramRoutinePartitionOwner(ref counts: Array<Int>, item: Int) -> Int {
    var start: Int = 0;
    var routine: Int = 0;
    while routine < ArrayLength(counts) {
        if counts[routine] < 0 { return -1; }
        if item >= start && item < start + counts[routine] { return routine; }
        start = start + counts[routine];
        routine = routine + 1;
    }
    return -1;
}

func DirectMirScalarProgramRoutinePartitionStart(ref counts: Array<Int>, routine: Int) -> Int {
    if routine < 0 || routine >= ArrayLength(counts) { return -1; }
    var start: Int = 0;
    var row: Int = 0;
    while row < routine {
        if counts[row] < 0 { return -1; }
        start = start + counts[row];
        row = row + 1;
    }
    return start;
}

