// One verified scalar CFG plan projected to either public backend.
import "direct_mir_scalar_cfg_graph_admission_owner.pgy";
import "direct_mir_scalar_cfg_c_emission_owner.pgy";
import "direct_mir_scalar_cfg_llvm_emission_owner.pgy";
import "target_projection_fact_owner.pgy";
import "runtime_call_abi_structured_fact_owner.pgy";
import "abi_layout_row_owner.pgy";

func CompileAdmittedDirectMirScalarCfgForTarget(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    target_projection: CompilerTargetProjectionFact
) -> String {
    let is_c: Bool = CompilerTargetProjectionFactReadyFor(
        target_projection, CompilerTargetCpuCProjection()
    );
    let is_llvm: Bool = CompilerTargetProjectionFactReadyFor(
        target_projection, CompilerTargetCpuLlvmProjection()
    );
    if !is_c && !is_llvm {
        Die("direct MIR scalar CFG projection rejected the target fact");
    }
    let producer: DirectMirArrayIntProducerFact =
        DirectMirArrayIntProducerFactEmpty();
    let plan: DirectMirScalarCfgGraphPlan =
        DirectMirScalarCfgGraphPlanFromAdmitted(
            admitted, 0, producer
        );
    let formatted_print: CompilerRuntimeCallAbiFact =
        CompilerRuntimeCallAbiFormattedPrintFact();
    let concat: CompilerRuntimeCallAbiFact =
        CompilerRuntimeCallAbiStringConcatFact();
    let compare: CompilerRuntimeCallAbiFact =
        CompilerRuntimeCallAbiStringCompareFact();
    let process_exit: CompilerRuntimeCallAbiFact =
        CompilerRuntimeCallAbiProcessExitFact();
    if !DirectMirScalarCfgGraphPlanReady(plan) ||
        !CompilerRuntimeCallAbiFlatFactOwnerReady(formatted_print) ||
        !CompilerRuntimeCallAbiProcessExitFactReady(process_exit) {
        Die("direct MIR scalar CFG plan or runtime ABI is incomplete");
    }
    let int_line_format: String = StringRuntimeCIntLineFormat();
    let string_line_format: String = StringRuntimeCStringLineFormat();
    if is_llvm {
        return DirectMirScalarCfgEmitLlvm(
            plan, formatted_print, concat, compare, process_exit,
            int_line_format, string_line_format,
            target_projection
        );
    }
    return DirectMirScalarCfgEmitC(
        plan, formatted_print, concat, compare, process_exit,
        int_line_format, string_line_format,
        CompilerAbiLayoutIntCValueType(), target_projection
    );
}
