// Resolve a same-spelled match binding only through its dominating CFG scope.

import "direct_mir_scalar_cfg_leaf_operand_owner.pgy";
import "direct_mir_scalar_cfg_leaf_operand_latest_value_readiness_owner.pgy";
import "../mir_lower/routine_definition_dominance_fact_owner.pgy";

func DirectMirScalarCfgInstructionBlockAt(
    ref index: MirRoutineFactIndex, instruction: Int) -> Int {
    let found: Int = -1; let block: Int = 0;
    while block < ArrayLength(index.block_instruction_starts) {
        let start: Int = index.block_instruction_starts[block]; let count: Int = index.block_instruction_counts[block];
        if instruction >= start && instruction < start + count {
            if found >= 0 { return -1; }
            found = block;
        }
        block = block + 1;
    }
    return found;
}

func DirectMirScalarCfgScopedMatchBindingLocalOperandRow(
    ref index: MirRoutineFactIndex,
    ref local_refs: DirectMirScalarCfgLocalRefPlan,
    instruction_row: Int, node_text: String
) -> Int {
    let use_block: Int = DirectMirScalarCfgInstructionBlockAt(index, instruction_row);
    if use_block < 0 { return -1; }
    let selected: Int = -1; let selected_scope: Int = -1; let row: Int = 0;
    while row < ArrayLength(local_refs.local_names) {
        if local_refs.local_ref_kinds[row] ==
                DirectMirScalarCfgLocalRefMatchBinding() &&
            local_refs.local_names[row] == node_text {
            let source_row: Int = local_refs.local_ref_syntax_ids[row];
            if source_row < index.declared_source_local_count ||
                source_row >= ArrayLength(index.match_binding_origins.instruction_global_rows) {
                return -1;
            }
            let match_instruction: Int =
                index.match_binding_origins.instruction_global_rows[source_row] -
                    index.instruction_facts.global_start;
            let match_block: Int = DirectMirScalarCfgInstructionBlockAt(
                index, match_instruction);
            if match_block < 0 || match_block >=
                    ArrayLength(index.block_succ_true) {
                return -1;
            }
            let scope: Int = index.block_succ_true[match_block];
            if scope >= 0 &&
                MirRoutineBlockDominates(index, scope, use_block) {
                if selected < 0 {
                    selected = row;
                    selected_scope = scope;
                } else if selected_scope == scope {
                    return -1;
                } else if MirRoutineBlockDominates(
                        index, selected_scope, scope) &&
                    selected_scope != scope {
                    selected = row;
                    selected_scope = scope;
                } else if !MirRoutineBlockDominates(
                        index, scope, selected_scope) {
                    return -1;
                }
            }
        }
        row = row + 1;
    }
    return selected;
}

func DirectMirScalarCfgLeafOrScopedMatchBindingOperandFromOwners(
    ref use_facts: MirRoutineInstructionUseFacts,
    ref index: MirRoutineFactIndex,
    global_row: Int, use_row: Int, instruction_row: Int,
    node: Int, node_text: String,
    ref value_names: Array<String>,
    ref local_refs: DirectMirScalarCfgLocalRefPlan,
    ref wire: DirectMirScalarCfgWireLocalRefs,
    wire_expr0_carriage: Bool
) -> DirectMirScalarCfgLeafOperand {
    let operand: DirectMirScalarCfgLeafOperand =
        DirectMirScalarCfgLeafOperandFromOwners(
            use_facts, global_row, use_row, instruction_row, node, node_text,
            value_names, local_refs, wire, wire_expr0_carriage);
    if operand.valid {
        // A unique name or explicit LocalRef selects a candidate, not a scope
        // proof. Match payloads remain confined to their owning true arm.
        if operand.local_row >= 0 && operand.local_row <
                ArrayLength(local_refs.local_ref_kinds) &&
            local_refs.local_ref_kinds[operand.local_row] ==
                DirectMirScalarCfgLocalRefMatchBinding() &&
            DirectMirScalarCfgScopedMatchBindingLocalOperandRow(
                index, local_refs, instruction_row, node_text) !=
                    operand.local_row {
            return DirectMirScalarCfgLeafOperand(false, -1, -1, 0);
        }
        let use_block: Int = DirectMirScalarCfgInstructionBlockAt(
            index, instruction_row);
        if DirectMirScalarCfgLeafOperandLatestValueReady(
                index, local_refs, operand, instruction_row, use_block) {
            return operand;
        }
        return DirectMirScalarCfgLeafOperand(false, -1, -1, 0);
    }
    if wire.required { return operand; }
    let scoped_local: Int =
        DirectMirScalarCfgScopedMatchBindingLocalOperandRow(
            index, local_refs, instruction_row, node_text);
    if scoped_local < 0 { return operand; }
    return DirectMirScalarCfgLeafOperand(true, -1, scoped_local, 0);
}
