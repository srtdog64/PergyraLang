// Access-row shape and live-length readiness for one String-array plan.

import "direct_mir_scalar_cfg_string_array_plan_lookup_owner.pgy";
import "direct_mir_scalar_cfg_string_array_index_readiness_owner.pgy";
import "direct_mir_scalar_cfg_string_array_capacity_owner.pgy";

func DirectMirScalarCfgStringArrayAccessesReady(
    ref plan: DirectMirScalarCfgStringArrayPlan,
    require_bound_rows: Bool, length_count: Int
) -> Bool {
    let row: Int = 0;
    while row < DirectMirScalarCfgStringArrayAccessCount(plan) {
        let fact: DirectMirScalarCfgStringArrayAccessFact =
            DirectMirScalarCfgStringArrayAccessAt(plan, row);
        let no_index: Bool = fact.kind ==
                DirectMirScalarCfgStringArrayAccessPushKind() ||
            fact.kind == DirectMirScalarCfgStringArrayAccessLengthLog() ||
            fact.kind == DirectMirScalarCfgStringArrayAccessPopKind();
        let owns_value: Bool = fact.kind ==
                DirectMirScalarCfgStringArrayAccessSetKind() ||
            fact.kind == DirectMirScalarCfgStringArrayAccessPushKind();
        let is_push: Bool = fact.kind ==
            DirectMirScalarCfgStringArrayAccessPushKind();
        let is_pop: Bool = fact.kind ==
            DirectMirScalarCfgStringArrayAccessPopKind();
        if fact.global_row < 0 || fact.collection_row < 0 ||
            fact.collection_row >=
                DirectMirScalarCfgStringArrayCollectionCount(plan) ||
            fact.kind < DirectMirScalarCfgStringArrayAccessConcatRead() ||
            fact.kind > DirectMirScalarCfgStringArrayAccessPopKind() ||
            (no_index && !DirectMirScalarCfgStringArrayIndexAbsentReady(
                fact.index
            )) || (!no_index && !DirectMirScalarCfgStringArrayIndexReady(
                fact.index, require_bound_rows,
                DirectMirScalarCfgStringArrayFinalLength(
                    plan, fact.collection_row
                )
            )) || owns_value != fact.value_present || (!fact.value_present &&
                fact.value_literal != "") ||
            (!no_index &&
             (fact.index.kind == DirectMirScalarCfgStringArrayIndexLiteral()) !=
                (fact.guard_length_row == -1)) ||
            (no_index && fact.guard_length_row != -1) ||
            (!is_push && !is_pop && fact.expected_length_before != -1) ||
            (fact.guard_length_row >= 0 &&
                (fact.guard_length_row >= length_count ||
                 plan.lengths.collection_rows[fact.guard_length_row] !=
                    fact.collection_row ||
                 plan.lengths.indices.kinds[fact.guard_length_row] !=
                    fact.index.kind ||
                 plan.lengths.indices.value_ids[fact.guard_length_row] !=
                    fact.index.value_id ||
                 plan.lengths.indices.iteration_syntax_ids[fact.guard_length_row] !=
                    fact.index.iteration_syntax_id)) ||
            ((require_bound_rows && fact.operation_row < 0) ||
             (!require_bound_rows && fact.operation_row != -1)) {
            return false;
        }
        if is_push || is_pop {
            let expected: Int = plan.collections.element_counts[
                fact.collection_row
            ];
            let prior_effect: Int = 0;
            while prior_effect < row {
                if plan.accesses.collection_rows[prior_effect] ==
                        fact.collection_row {
                    if plan.accesses.kinds[prior_effect] ==
                            DirectMirScalarCfgStringArrayAccessPushKind() {
                        expected = expected + 1;
                    } else if plan.accesses.kinds[prior_effect] ==
                            DirectMirScalarCfgStringArrayAccessPopKind() {
                        expected = expected - 1;
                    }
                }
                prior_effect = prior_effect + 1;
            }
            if (is_pop && expected < 1) ||
                fact.expected_length_before != expected ||
                (is_push && expected >=
                    DirectMirScalarCfgStringArrayStaticCapacity(
                        plan, fact.collection_row
                    )) { return false; }
        }
        let prior: Int = 0;
        while prior < row {
            if plan.accesses.global_rows[prior] == fact.global_row ||
                (require_bound_rows && plan.accesses.operation_rows[prior] ==
                    fact.operation_row) { return false; }
            prior = prior + 1;
        }
        row = row + 1;
    }
    return true;
}
