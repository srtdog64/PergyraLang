// Operation-time C mutation and length observation for String arrays.

import "direct_mir_scalar_cfg_array_c_materialization_owner.pgy";
import "direct_mir_scalar_cfg_string_array_plan_lookup_owner.pgy";
import "runtime_call_abi_structured_fact_owner.pgy";

func DirectMirScalarCfgStringArrayCPush(
    ref plan: DirectMirScalarCfgGraphPlan, operation: Int
) -> String {
    let row: Int = DirectMirScalarCfgStringArrayAccessRowAtOperation(
        plan.string_arrays, operation
    );
    if row < 0 || plan.string_arrays.accesses.kinds[row] !=
            DirectMirScalarCfgStringArrayAccessPushKind() {
        Die("direct MIR String array C push is missing");
    }
    let fact: DirectMirScalarCfgStringArrayAccessFact =
        DirectMirScalarCfgStringArrayAccessAt(plan.string_arrays, row);
    let value: Array<String> = []; ArrayPush(value, fact.value_literal);
    let prefix: String = Concat(
        "    pgy_indexed_collection_", ToString(fact.collection_row)
    );
    let output: String = Concat(prefix, Concat(".data[",
        Concat(ToString(fact.expected_length_before), "] = ")
    ));
    output = Concat(output,
        DirectMirScalarCfgArrayStringCElementList(value));
    output = Concat(output, ";\n");
    output = Concat(output, Concat(prefix, ".length = "));
    return Concat(output,
        Concat(ToString(fact.expected_length_before + 1), ";\n"));
}

func DirectMirScalarCfgStringArrayCLengthLog(
    ref plan: DirectMirScalarCfgGraphPlan, operation: Int,
    formatted_print: CompilerRuntimeCallAbiFact,
    int_line_format: String, int_c_type: String
) -> String {
    let row: Int = DirectMirScalarCfgStringArrayAccessRowAtOperation(
        plan.string_arrays, operation
    );
    if row < 0 || plan.string_arrays.accesses.kinds[row] !=
            DirectMirScalarCfgStringArrayAccessLengthLog() {
        Die("direct MIR String array C length log is missing");
    }
    let fact: DirectMirScalarCfgStringArrayAccessFact =
        DirectMirScalarCfgStringArrayAccessAt(plan.string_arrays, row);
    let output: String = Concat("    ", formatted_print.symbol);
    output = Concat(output, Concat("(\"", int_line_format));
    output = Concat(output, Concat("\", (", int_c_type));
    output = Concat(output, Concat(")pgy_indexed_collection_",
        ToString(fact.collection_row)));
    return Concat(output, ".length);\n");
}
