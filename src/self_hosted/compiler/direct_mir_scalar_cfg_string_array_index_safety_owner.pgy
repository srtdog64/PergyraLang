// Nonnegative dynamic-index proof consumed before unsigned backend projection.

import "direct_mir_scalar_cfg_graph_fact_owner.pgy";
import "direct_mir_scalar_cfg_string_array_plan_lookup_owner.pgy";

func DirectMirScalarCfgStringArrayResultOperation(
    ref plan: DirectMirScalarCfgGraphPlan, value_row: Int
) -> Int {
    let found: Int = -1;
    let operation: Int = 0;
    while operation < ArrayLength(plan.operation_kinds) {
        if plan.operation_result_values[operation] == value_row {
            if found >= 0 { return -1; }
            found = operation;
        }
        operation = operation + 1;
    }
    return found;
}

func DirectMirScalarCfgStringArrayWhileIndexNonnegative(
    ref plan: DirectMirScalarCfgGraphPlan,
    index: DirectMirScalarCfgStringArrayIndexFact
) -> Bool {
    if index.value_row < 0 ||
        index.value_row >= ArrayLength(plan.value_types) ||
        plan.value_types[index.value_row] != "Int" {
        return false;
    }
    let local_row: Int = plan.value_local_rows[index.value_row];
    let phi: Int = DirectMirScalarCfgStringArrayResultOperation(
        plan, index.value_row
    );
    if local_row < 0 || phi < 0 ||
        plan.operation_kinds[phi] != DirectMirScalarCfgOpPhiInt() ||
        plan.operation_phi_counts[phi] != 2 {
        return false;
    }
    let init_count: Int = 0;
    let step_count: Int = 0;
    let incoming: Int = 0;
    while incoming < plan.operation_phi_counts[phi] {
        let value_row: Int = plan.phi_incoming_values[
            plan.operation_phi_starts[phi] + incoming
        ];
        let operation: Int = DirectMirScalarCfgStringArrayResultOperation(
            plan, value_row
        );
        if operation < 0 || plan.value_local_rows[value_row] != local_row {
            return false;
        }
        if plan.operation_kinds[operation] == DirectMirScalarCfgOpConstInt() &&
            plan.operation_left_literals[operation] == "0" {
            init_count = init_count + 1;
        } else if plan.operation_kinds[operation] ==
                DirectMirScalarCfgOpAddInt() &&
            plan.operation_left_values[operation] == index.value_row &&
            plan.operation_right_values[operation] == -1 &&
            plan.operation_right_locals[operation] == -1 &&
            plan.operation_right_literals[operation] == "1" {
            step_count = step_count + 1;
        } else {
            return false;
        }
        incoming = incoming + 1;
    }
    return init_count == 1 && step_count == 1;
}

func DirectMirScalarCfgStringArrayIndexNonnegative(
    ref plan: DirectMirScalarCfgGraphPlan,
    index: DirectMirScalarCfgStringArrayIndexFact
) -> Bool {
    if index.kind == DirectMirScalarCfgStringArrayIndexLiteral() {
        return ToInt(index.literal) >= 0;
    }
    if index.kind == DirectMirScalarCfgStringArrayIndexValue() {
        return DirectMirScalarCfgStringArrayWhileIndexNonnegative(plan, index);
    }
    if index.kind == DirectMirScalarCfgStringArrayIndexIteration() {
        let range: DirectMirScalarCfgRangeIterationFact =
            DirectMirScalarCfgRangeFactAtLoopSyntaxId(
                plan.range_iterations, index.iteration_syntax_id
            );
        return range.valid && range.start_literal == "0" &&
            range.step_literal == "1";
    }
    return false;
}
