// Nonnegative dynamic-index proof consumed before unsigned backend projection.

import "direct_mir_scalar_cfg_graph_fact_owner.pgy";
import "direct_mir_scalar_cfg_string_array_plan_lookup_owner.pgy";
import "direct_mir_scalar_cfg_while_induction_owner.pgy";

func DirectMirScalarCfgStringArrayIndexNonnegative(
    ref plan: DirectMirScalarCfgGraphPlan,
    index: DirectMirScalarCfgStringArrayIndexFact
) -> Bool {
    if index.kind == DirectMirScalarCfgStringArrayIndexLiteral() {
        return ToInt(index.literal) >= 0;
    }
    if index.kind == DirectMirScalarCfgStringArrayIndexValue() {
        return DirectMirScalarCfgWhileInductionZeroUnitReady(
            plan, index.value_row
        );
    }
    if index.kind == DirectMirScalarCfgStringArrayIndexIteration() {
        let range: DirectMirScalarCfgRangeIterationFact =
            DirectMirScalarCfgRangeFactAtLoopSyntaxId(
                plan.range_iterations, index.iteration_syntax_id
            );
        return range.valid && range.start_literal == "0" &&
            range.step_literal == "1";
    }
    return false;
}
