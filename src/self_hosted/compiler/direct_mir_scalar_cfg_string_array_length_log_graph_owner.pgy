// Exact persisted graph for Log(ToString(ArrayLength(collection))).

import "direct_mir_scalar_cfg_array_length_fact_owner.pgy";

struct DirectMirScalarCfgStringArrayLengthLogGraphFact {
    let valid: Bool;
    let collection_name: String;
}

func DirectMirScalarCfgStringArrayLengthLogGraphFactFrom(
    ref graph: MirExpressionGraphSequence
) -> DirectMirScalarCfgStringArrayLengthLogGraphFact {
    let invalid: DirectMirScalarCfgStringArrayLengthLogGraphFact =
        DirectMirScalarCfgStringArrayLengthLogGraphFact(false, "");
    if !graph.ok || graph.ready_node_count != 7 ||
        ArrayLength(graph.roots) != 1 || graph.roots[0] != 6 ||
        graph.arena.topology.node_kinds[0] != AstExpressionNodeLeaf() ||
        graph.arena.node_texts[0] != "ToString" ||
        graph.arena.topology.node_kinds[1] != AstExpressionNodeCall() ||
        graph.arena.topology.left_children[1] != 0 ||
        graph.arena.call_target_kinds[1] != SemanticCallTargetDirect() ||
        graph.arena.call_target_names[1] != "ToString" ||
        graph.arena.topology.node_kinds[6] !=
            AstExpressionNodeCallArgument() ||
        graph.arena.topology.left_children[6] != 1 ||
        graph.arena.topology.right_children[6] != 5 {
        return invalid;
    }
    let length: DirectMirScalarCfgArrayLengthGraphFact =
        DirectMirScalarCfgArrayLengthGraphFactAt(graph, 2, 3, 4, 5);
    if !length.valid { return invalid; }
    let row: Int = 0;
    while row < graph.ready_node_count {
        if row != 1 && row != 3 &&
            (graph.arena.call_target_kinds[row] !=
                SemanticCallTargetNone() ||
             graph.arena.call_target_names[row] != "") { return invalid; }
        row = row + 1;
    }
    return DirectMirScalarCfgStringArrayLengthLogGraphFact(
        true, length.collection_name
    );
}
