// LLVM projection from the sealed multi-row String-array plan.

import "direct_mir_scalar_cfg_llvm_operand_owner.pgy";
import "direct_mir_scalar_cfg_string_array_graph_readiness_owner.pgy";
import "direct_mir_scalar_cfg_string_array_llvm_storage_emission_owner.pgy";

struct DirectMirScalarCfgStringArrayLlvmAddressFact {
    let instructions: String;
    let pointer: String;
    let element_align: String;
}

func DirectMirScalarCfgStringArrayLlvmProjectionAt(
    ref plan: DirectMirScalarCfgGraphPlan,
    target: CompilerTargetProjectionFact, collection_row: Int
) -> DirectMirArrayStringAbiProjection {
    let fact: DirectMirScalarCfgArrayStringCollectionFact =
        DirectMirScalarCfgStringArrayCollectionAt(plan.string_arrays, collection_row);
    if !fact.valid { Die("direct MIR String array LLVM projection source is missing"); }
    return DirectMirArrayStringAbiProjectionFromCanonicalLayout(
        target, fact.abi_layout_id, fact.abi_size, fact.abi_align,
        fact.data_offset, fact.length_offset, fact.capacity_offset,
        fact.allocator_offset);
}

func DirectMirScalarCfgStringArrayLlvmIndex(
    ref plan: DirectMirScalarCfgGraphPlan,
    fact: DirectMirScalarCfgStringArrayIndexFact,
    stem: String
) -> Array<String> {
    let output: Array<String> = ["", ""];
    if fact.kind == DirectMirScalarCfgStringArrayIndexLiteral() {
        ArraySet(output, 1, fact.literal); return output;
    }
    let text: String = Concat("  ", Concat(stem, ".index = load i64, ptr "));
    text = Concat(text, DirectMirScalarCfgLlvmOperandLocal(
        plan, fact.value_row, fact.local_row
    ));
    text = Concat(text, ", align 8\n");
    ArraySet(output, 0, text);
    ArraySet(output, 1, Concat(stem, ".index"));
    return output;
}

func DirectMirScalarCfgStringArrayLlvmAddress(
    ref plan: DirectMirScalarCfgGraphPlan,
    target: CompilerTargetProjectionFact,
    fact: DirectMirScalarCfgStringArrayAccessFact,
    stem: String
) -> DirectMirScalarCfgStringArrayLlvmAddressFact {
    let abi: DirectMirArrayStringAbiProjection =
        DirectMirScalarCfgStringArrayLlvmProjectionAt(plan, target, fact.collection_row);
    let index: Array<String> = DirectMirScalarCfgStringArrayLlvmIndex(
        plan, fact.index, stem
    );
    let output: String = index[0];
    output = Concat(output, Concat("  ", Concat(stem, ".array.data = load ")));
    output = Concat(output, Concat(abi.llvm_element_type,
        ", ptr %pgy.array.indexed."));
    output = Concat(output, Concat(ToString(fact.collection_row),
        Concat(".data.field, align ", Concat(ToString(abi.storage.align), "\n  "))));
    output = Concat(output, Concat(stem,
        Concat(".array.ptr = getelementptr inbounds ",
            Concat(abi.llvm_element_type, ", ptr "))));
    output = Concat(output, Concat(stem, Concat(".array.data, i64 ", index[1])));
    output = Concat(output, "\n");
    return DirectMirScalarCfgStringArrayLlvmAddressFact(
        output, Concat(stem, ".array.ptr"), ToString(abi.element_align));
}

func DirectMirScalarCfgStringArrayLlvmRead(
    ref plan: DirectMirScalarCfgGraphPlan,
    target: CompilerTargetProjectionFact,
    operation: Int, result_name: String
) -> String {
    let row: Int = DirectMirScalarCfgStringArrayAccessRowAtOperation(
        plan.string_arrays, operation
    );
    if row < 0 || plan.string_arrays.accesses.kinds[row] ==
            DirectMirScalarCfgStringArrayAccessSetKind() {
        Die("direct MIR String array LLVM read is missing");
    }
    let stem: String = Concat("%pgy.op.", ToString(operation));
    let fact: DirectMirScalarCfgStringArrayAccessFact =
        DirectMirScalarCfgStringArrayAccessAt(plan.string_arrays, row);
    let address: DirectMirScalarCfgStringArrayLlvmAddressFact = DirectMirScalarCfgStringArrayLlvmAddress(
        plan, target, fact, stem
    );
    let output: String = address.instructions;
    output = Concat(output, Concat("  ", Concat(stem, Concat(
        Concat(".", result_name), " = load ptr, ptr "
    ))));
    output = Concat(output, Concat(address.pointer,
        Concat(", align ", Concat(address.element_align, "\n"))));
    return output;
}

func DirectMirScalarCfgStringArrayLlvmSet(
    ref plan: DirectMirScalarCfgGraphPlan,
    target: CompilerTargetProjectionFact, operation: Int
) -> String {
    let row: Int = DirectMirScalarCfgStringArrayAccessRowAtOperation(
        plan.string_arrays, operation
    );
    if row < 0 || plan.string_arrays.accesses.kinds[row] !=
            DirectMirScalarCfgStringArrayAccessSetKind() {
        Die("direct MIR String array LLVM set is missing");
    }
    let stem: String = Concat("%pgy.op.", ToString(operation));
    let fact: DirectMirScalarCfgStringArrayAccessFact =
        DirectMirScalarCfgStringArrayAccessAt(plan.string_arrays, row);
    let address: DirectMirScalarCfgStringArrayLlvmAddressFact = DirectMirScalarCfgStringArrayLlvmAddress(
        plan, target, fact, stem
    );
    let output: String = address.instructions;
    output = Concat(output, Concat("  store ptr @.pgy.scalar.cfg.indexed.set.",
        ToString(row)));
    return Concat(output, Concat(", ptr ", Concat(address.pointer,
        Concat(", align ", Concat(address.element_align, "\n")))));
}

func DirectMirScalarCfgStringArrayLlvmCondition(
    ref plan: DirectMirScalarCfgGraphPlan,
    target: CompilerTargetProjectionFact, block: Int
) -> String {
    let row: Int = DirectMirScalarCfgStringArrayLengthRowAtBlock(
        plan.string_arrays, block
    );
    if row < 0 { Die("direct MIR String array LLVM condition is missing"); }
    let fact: DirectMirScalarCfgStringArrayLengthFact =
        DirectMirScalarCfgStringArrayLengthAt(plan.string_arrays, row);
    let abi: DirectMirArrayStringAbiProjection =
        DirectMirScalarCfgStringArrayLlvmProjectionAt(plan, target, fact.collection_row);
    let stem: String = Concat("%pgy.cond.", ToString(block));
    let index: Array<String> = DirectMirScalarCfgStringArrayLlvmIndex(
        plan, fact.index, stem
    );
    let output: String = index[0];
    output = Concat(output, Concat("  ", Concat(stem, ".length = load ")));
    output = Concat(output, Concat(abi.llvm_length_type,
        ", ptr %pgy.array.indexed."));
    output = Concat(output, Concat(ToString(fact.collection_row),
        Concat(".length.field, align ", Concat(ToString(abi.storage.align), "\n  "))));
    output = Concat(output, Concat(stem, " = icmp ult i64 "));
    output = Concat(output, Concat(index[1], Concat(", ", stem)));
    return Concat(output, ".length");
}
