// Canonical scalar-CFG type family admitted by the shared graph planner.

import "abi_layout_row_owner.pgy";
import "../mir_lower/routine_fact_index_owner.pgy";

func DirectMirScalarCfgScalarTypeSupported(type_name: String) -> Bool {
    return type_name == CompilerAbiLayoutIntTypeName() ||
        type_name == CompilerAbiLayoutStringTypeName();
}

func DirectMirScalarCfgCollectionTypeSupported(type_name: String) -> Bool {
    return type_name == CompilerAbiLayoutArrayIntTypeName() ||
        type_name == CompilerAbiLayoutArrayStringTypeName();
}

func DirectMirScalarCfgIterationTypePairSupported(
    binding_type: String, iterable_type: String
) -> Bool {
    return (binding_type == CompilerAbiLayoutIntTypeName() &&
            iterable_type == CompilerAbiLayoutArrayIntTypeName()) ||
        (binding_type == CompilerAbiLayoutStringTypeName() &&
            iterable_type == CompilerAbiLayoutArrayStringTypeName());
}

func DirectMirScalarCfgSourceLocalTypeSupported(type_name: String) -> Bool {
    return DirectMirScalarCfgScalarTypeSupported(type_name) ||
        DirectMirScalarCfgCollectionTypeSupported(type_name);
}

func DirectMirScalarCfgRoutineSourceLocalTypesSupported(
    ref index: MirRoutineFactIndex
) -> Bool {
    if !index.valid || ArrayLength(index.source_local_names) < 1 ||
        ArrayLength(index.source_local_names) !=
            ArrayLength(index.source_local_types) { return false; }
    let row: Int = 0;
    while row < ArrayLength(index.source_local_types) {
        if !DirectMirScalarCfgSourceLocalTypeSupported(
            index.source_local_types[row]
        ) { return false; }
        row = row + 1;
    }
    return true;
}
