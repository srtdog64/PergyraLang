// Cross-type readiness for locals, operations, foreach payloads, and ABI calls.

import "direct_mir_scalar_cfg_graph_fact_owner.pgy";
import "direct_mir_scalar_cfg_type_family_owner.pgy";
import "runtime_call_abi_structured_fact_owner.pgy";

func DirectMirScalarCfgPlanOperandType(
    ref plan: DirectMirScalarCfgGraphPlan, value: Int, local: Int
) -> String {
    if value >= 0 && value < ArrayLength(plan.value_types) && local < 0 {
        return plan.value_types[value];
    }
    if local >= 0 && local < ArrayLength(plan.local_types) && value < 0 {
        return plan.local_types[local];
    }
    return "";
}

func DirectMirScalarCfgTypedForEachReady(
    ref plan: DirectMirScalarCfgGraphPlan
) -> Bool {
    if !DirectMirScalarCfgForEachElementFactsReady(plan.foreach_elements) ||
        DirectMirScalarCfgForEachFactCount(plan.foreach_iterations) !=
            ArrayLength(plan.foreach_elements.loop_syntax_ids) {
        return false;
    }
    let row: Int = 0;
    while row < DirectMirScalarCfgForEachFactCount(plan.foreach_iterations) {
        let fact: DirectMirScalarCfgForEachFact =
            DirectMirScalarCfgForEachFactAt(plan.foreach_iterations, row);
        let type_name: String =
            DirectMirScalarCfgForEachElementTypeAtLoopSyntaxId(
                plan.foreach_elements, fact.loop_syntax_id
            );
        if fact.binding_local_row < 0 || fact.binding_local_row >=
                ArrayLength(plan.local_types) ||
            plan.local_types[fact.binding_local_row] != type_name {
            return false;
        }
        let strings: Array<String> =
            DirectMirScalarCfgForEachStringElementsAtLoopSyntaxId(
                plan.foreach_elements, fact.loop_syntax_id
            );
        if type_name == CompilerAbiLayoutIntTypeName() {
            if ArrayLength(strings) != 0 { return false; }
        } else if type_name == CompilerAbiLayoutStringTypeName() {
            let start_opt: Option<Int> =
                DirectMirScalarCfgForEachStringElementStartAtLoopSyntaxId(
                    plan.foreach_elements, fact.loop_syntax_id
                );
            if !IsSome(start_opt) ||
                ArrayLength(strings) != ArrayLength(fact.elements) {
                return false;
            }
            let start: Int = UnwrapOption(start_opt);
            let item: Int = 0;
            while item < ArrayLength(fact.elements) {
                if fact.elements[item] != start + item { return false; }
                item = item + 1;
            }
        } else { return false; }
        row = row + 1;
    }
    return true;
}

func DirectMirScalarCfgTypedOperationsReady(
    ref plan: DirectMirScalarCfgGraphPlan
) -> Bool {
    let concat_seen: Bool = false;
    let row: Int = 0;
    while row < ArrayLength(plan.operation_kinds) {
        let kind: Int = plan.operation_kinds[row];
        let result: Int = plan.operation_result_values[row];
        let result_type: String = "";
        if result >= 0 && result < ArrayLength(plan.value_types) {
            result_type = plan.value_types[result];
        }
        let left_type: String = DirectMirScalarCfgPlanOperandType(
            plan, plan.operation_left_values[row],
            plan.operation_left_locals[row]
        );
        let right_type: String = DirectMirScalarCfgPlanOperandType(
            plan, plan.operation_right_values[row],
            plan.operation_right_locals[row]
        );
        let left_is_int: Bool =
            left_type == CompilerAbiLayoutIntTypeName() ||
            (left_type == "" && plan.operation_left_literals[row] != "");
        let right_is_int: Bool =
            right_type == CompilerAbiLayoutIntTypeName() ||
            (right_type == "" && plan.operation_right_literals[row] != "");
        let is_int_result: Bool = result_type == CompilerAbiLayoutIntTypeName();
        let is_string_result: Bool =
            result_type == CompilerAbiLayoutStringTypeName();
        if (kind == DirectMirScalarCfgOpConstInt() && !is_int_result) ||
            (kind == DirectMirScalarCfgOpConstString() && !is_string_result) ||
            ((kind == DirectMirScalarCfgOpCopyInt() ||
              kind == DirectMirScalarCfgOpAddInt()) &&
                (!is_int_result || !left_is_int ||
                 (kind == DirectMirScalarCfgOpAddInt() &&
                  !right_is_int))) ||
            ((kind == DirectMirScalarCfgOpCopyString() ||
              kind == DirectMirScalarCfgOpConcatString()) &&
                (!is_string_result ||
                 left_type != CompilerAbiLayoutStringTypeName() ||
                 (kind == DirectMirScalarCfgOpConcatString() &&
                  right_type != CompilerAbiLayoutStringTypeName() &&
                  !DirectMirScalarCfgIndexedStringArrayOwnsOperation(
                      plan.indexed_string_array, row
                  )))) ||
            (kind == DirectMirScalarCfgOpPhiInt() && !is_int_result) ||
            (kind == DirectMirScalarCfgOpPhiString() && !is_string_result) ||
            (kind == DirectMirScalarCfgOpLogInt() && !left_is_int) ||
            (kind == DirectMirScalarCfgOpLogStringValue() &&
                left_type != CompilerAbiLayoutStringTypeName()) {
            return false;
        }
        if kind == DirectMirScalarCfgOpConcatString() { concat_seen = true; }
        row = row + 1;
    }
    let concat: CompilerRuntimeCallAbiFact =
        CompilerRuntimeCallAbiStringConcatFact();
    if concat_seen {
        return CompilerRuntimeCallAbiStringConcatFactReady(concat) &&
            plan.string_concat_runtime_call_abi_id ==
                concat.runtime_call_abi_id;
    }
    return plan.string_concat_runtime_call_abi_id == 0;
}

func DirectMirScalarCfgTypedPlanReady(
    ref plan: DirectMirScalarCfgGraphPlan
) -> Bool {
    if ArrayLength(plan.local_names) != ArrayLength(plan.local_types) ||
        ArrayLength(plan.value_names) != ArrayLength(plan.value_types) {
        return false;
    }
    let row: Int = 0;
    while row < ArrayLength(plan.local_types) {
        if !DirectMirScalarCfgScalarTypeSupported(plan.local_types[row]) {
            return false;
        }
        row = row + 1;
    }
    row = 0;
    while row < ArrayLength(plan.value_types) {
        let local: Int = plan.value_local_rows[row];
        if local < 0 || local >= ArrayLength(plan.local_types) ||
            plan.value_types[row] != plan.local_types[local] {
            return false;
        }
        row = row + 1;
    }
    return DirectMirScalarCfgTypedForEachReady(plan) &&
        DirectMirScalarCfgTypedOperationsReady(plan);
}
