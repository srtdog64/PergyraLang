// Zero-start, unit-step scalar while induction over one sealed graph plan.

import "direct_mir_scalar_cfg_graph_fact_owner.pgy";

func DirectMirScalarCfgResultOperation(
    ref plan: DirectMirScalarCfgGraphPlan, value_row: Int
) -> Int {
    let found: Int = -1;
    let operation: Int = 0;
    while operation < ArrayLength(plan.operation_kinds) {
        if plan.operation_result_values[operation] == value_row {
            if found >= 0 { return -1; }
            found = operation;
        }
        operation = operation + 1;
    }
    return found;
}

func DirectMirScalarCfgWhileInductionZeroUnitReady(
    ref plan: DirectMirScalarCfgGraphPlan, value_row: Int
) -> Bool {
    if value_row < 0 || value_row >= ArrayLength(plan.value_types) ||
        plan.value_types[value_row] != "Int" { return false; }
    let local_row: Int = plan.value_local_rows[value_row];
    let phi: Int = DirectMirScalarCfgResultOperation(plan, value_row);
    if local_row < 0 || phi < 0 ||
        plan.operation_kinds[phi] != DirectMirScalarCfgOpPhiInt() ||
        plan.operation_phi_counts[phi] != 2 { return false; }
    let init_count: Int = 0; let step_count: Int = 0;
    let incoming: Int = 0;
    while incoming < plan.operation_phi_counts[phi] {
        let incoming_value: Int = plan.phi_incoming_values[
            plan.operation_phi_starts[phi] + incoming
        ];
        let operation: Int = DirectMirScalarCfgResultOperation(
            plan, incoming_value
        );
        if operation < 0 ||
            plan.value_local_rows[incoming_value] != local_row { return false; }
        if plan.operation_kinds[operation] == DirectMirScalarCfgOpConstInt() &&
            plan.operation_left_literals[operation] == "0" {
            init_count = init_count + 1;
        } else if plan.operation_kinds[operation] ==
                DirectMirScalarCfgOpAddInt() &&
            plan.operation_left_values[operation] == value_row &&
            plan.operation_right_values[operation] == -1 &&
            plan.operation_right_locals[operation] == -1 &&
            plan.operation_right_literals[operation] == "1" {
            step_count = step_count + 1;
        } else { return false; }
        incoming = incoming + 1;
    }
    return init_count == 1 && step_count == 1;
}
