// Backend-neutral scalar-graph admission for bounded MIR replacement rungs.
//
// This owner consumes only admitted pgy.mir.v1 facts.  It deliberately does
// not reconstruct an AST, invoke semantic analysis, consume the legacy expr0
// surface as semantic input, or fall back to the source driver. The admitted
// shapes are literal-Log hello and one-block typed Int definitions followed
// by graph-owned binary ToString/Log statements.

import "../mir_lower/mir_json_input_owner.pgy";
import "../mir_lower/expression_graph_sequence_owner.pgy";
import "../mir_lower/routine_fact_index_owner.pgy";
import "../mir_lower/routine_instruction_use_fact_owner.pgy";
import "../mir_lower/ssa_identity_owner.pgy";

struct DirectMirHelloProjection {
    let valid: Bool;
    let literal: String;
    let content: String;
}

struct DirectMirScalarBlockProjection {
    let valid: Bool;
    let local_names: Array<String>;
    let result_names: Array<String>;
    let integer_literals: Array<String>;
    let log_left_local_rows: Array<Int>;
    let log_right_local_rows: Array<Int>;
    let log_binary_kinds: Array<Int>;
}

func DirectMirHelloProjectionEmpty() -> DirectMirHelloProjection {
    return DirectMirHelloProjection(false, "", "");
}

func DirectMirScalarBlockProjectionEmpty() -> DirectMirScalarBlockProjection {
    let local_names: Array<String> = [];
    let result_names: Array<String> = [];
    let integer_literals: Array<String> = [];
    let left_rows: Array<Int> = [];
    let right_rows: Array<Int> = [];
    let binary_kinds: Array<Int> = [];
    return DirectMirScalarBlockProjection(
        false, local_names, result_names, integer_literals,
        left_rows, right_rows, binary_kinds);
}

func DirectMirObjectFieldKindEquals(
    ref fact_table: JsonObjectFactTable, field: String, expected: String) -> Bool {
    let kind_opt: Option<String> = JsonObjectFactValueKind(fact_table, field);
    return IsSome(kind_opt) && UnwrapOption(kind_opt) == expected;
}

func DirectMirObjectArrayEmpty(
    ref fact_table: JsonObjectFactTable, field: String) -> Bool {
    let bounds: Array<Int> = [0, 0];
    if !JsonObjectFactArrayBounds(fact_table, field, bounds) { return false; }
    let cursor: Int = JsonSkipWhitespaceWithin(
        fact_table.json, bounds[0] + 1, bounds[1]);
    return cursor < bounds[1] &&
        JsonCharCodeAt(fact_table.json, bounds[1], cursor) ==
            JsonAsciiCode("]");
}

func DirectMirObjectNumberEquals(
    ref fact_table: JsonObjectFactTable, field: String, expected: String) -> Bool {
    let value_opt: Option<String> = JsonObjectFactNumberFieldOpt(
        fact_table, field);
    return IsSome(value_opt) && UnwrapOption(value_opt) == expected;
}

func DirectMirRoutineHasNoUnsupportedFacts(
    ref routine: JsonObjectFactTable) -> Bool {
    return DirectMirObjectArrayEmpty(routine, "generics") &&
        DirectMirObjectArrayEmpty(routine, "params") &&
        !JsonObjectFactHasField(routine, "function_param_flow_summary_count") &&
        !JsonObjectFactHasField(routine, "function_param_flow_summaries") &&
        DirectMirObjectArrayEmpty(routine, "resource_flow_symbols") &&
        DirectMirObjectArrayEmpty(routine, "loop_flow_summaries") &&
        DirectMirObjectArrayEmpty(routine, "loop_flow_states") &&
        DirectMirObjectArrayEmpty(routine, "iteration_type_facts") &&
        DirectMirObjectArrayEmpty(routine, "destructure_type_facts") &&
        DirectMirObjectNumberEquals(routine, "resource_flow_symbol_count", "0") &&
        DirectMirObjectNumberEquals(routine, "loop_flow_summary_count", "0") &&
        DirectMirObjectNumberEquals(routine, "loop_flow_state_count", "0") &&
        DirectMirObjectNumberEquals(routine, "iteration_type_fact_count", "0") &&
        DirectMirObjectNumberEquals(routine, "destructure_type_fact_count", "0");
}

func DirectMirAsciiLiteralContent(literal: String) -> Option<String> {
    let length: Int = StringLength(literal);
    if length < 2 || CharCode(literal, length, 0) != 34 ||
        CharCode(literal, length, length - 1) != 34 { return None; }
    let i: Int = 1;
    while i < length - 1 {
        let code: Int = CharCode(literal, length, i);
        if code < 32 || code > 126 || code == 34 || code == 92 { return None; }
        i = i + 1;
    }
    return Some(Substring(literal, 1, length - 2));
}

func DirectMirProgramEnvelopeReady(
    ref admitted: MirMachineLayerAdmittedJsonInput) -> Bool {
    let json: String = admitted.routines.source_json;
    let generic_specializations: JsonArrayObjectFactTable = JsonObjectFactArrayObjectTable(
        admitted.document.root, "generic_method_specializations");
    if !admitted.document.valid || admitted.document.routines.json != json ||
        JsonObjectFactCount(admitted.document.root) != 5 ||
        !MirProgramRoutineIndexStructureReady(admitted.routines) ||
        !JsonArrayObjectFactTableReady(admitted.document.declarations) ||
        JsonArrayObjectFactCount(admitted.document.declarations) != 0 ||
        !JsonArrayObjectFactTableReady(
            admitted.document.parallel_capture_boundaries) ||
        JsonArrayObjectFactCount(
            admitted.document.parallel_capture_boundaries) != 0 ||
        !JsonArrayObjectFactTableReady(generic_specializations) ||
        JsonArrayObjectFactCount(generic_specializations) != 0 ||
        JsonArrayObjectFactCount(admitted.document.routines) != 1 ||
        MirProgramRoutineIndexCount(admitted.routines) != 1 ||
        admitted.routines.kinds[0] != "function" ||
        admitted.routines.owners[0] != "" ||
        admitted.routines.names[0] != "Main" ||
        admitted.routines.routine_block_counts[0] < 1 {
        return false;
    }
    let routine: JsonObjectFactTable = JsonObjectFactTableFromBounds(
        json, admitted.routines.starts[0], admitted.routines.ends[0]);
    return JsonObjectFactTableReady(routine) &&
        JsonObjectFactStringFieldEquals(routine, "name", "Main") &&
        JsonObjectFactStringFieldEquals(routine, "kind", "function") &&
        JsonObjectFactStringFieldEquals(routine, "return", "Void") &&
        DirectMirRoutineHasNoUnsupportedFacts(routine);
}

func DirectMirLogInstructionEnvelopeReady(
    ref instruction: JsonObjectFactTable, expected_id: String) -> Bool {
    return JsonObjectFactTableReady(instruction) &&
        DirectMirObjectNumberEquals(instruction, "id", expected_id) &&
        JsonObjectFactStringFieldEquals(instruction, "kind", "stmt") &&
        JsonObjectFactStringFieldEquals(instruction, "name", "stmt") &&
        JsonObjectFactStringFieldEquals(instruction, "arg0", "Log") &&
        JsonObjectFactStringFieldEquals(instruction, "source_type", "AST_CALL") &&
        DirectMirObjectFieldKindEquals(instruction, "result", "null") &&
        DirectMirObjectFieldKindEquals(instruction, "arg1", "null") &&
        DirectMirObjectFieldKindEquals(instruction, "slot_anchor", "null") &&
        DirectMirObjectFieldKindEquals(instruction, "abi_type_name", "null") &&
        DirectMirObjectNumberEquals(instruction, "abi_layout_id", "0") &&
        JsonObjectBoolFieldEqualsWithin(
            instruction.json, instruction.start, instruction.end,
            "abi_layout_required", false
        ) &&
        DirectMirObjectFieldKindEquals(instruction, "abi_layout", "null") &&
        DirectMirObjectFieldKindEquals(instruction, "expr0", "string") &&
        DirectMirObjectFieldKindEquals(instruction, "expr1", "null") &&
        DirectMirObjectFieldKindEquals(instruction, "expr1_graph", "null") &&
        DirectMirObjectFieldKindEquals(instruction, "machine_layer", "null") &&
        JsonObjectFactStringFieldEquals(instruction, "machine_contact_kind", "") &&
        DirectMirObjectArrayEmpty(instruction, "match_patterns") &&
        DirectMirObjectFieldKindEquals(instruction, "match_variant", "null") &&
        DirectMirObjectArrayEmpty(instruction, "match_bindings") &&
        DirectMirObjectArrayEmpty(instruction, "match_binding_types") &&
        DirectMirObjectFieldKindEquals(instruction, "destructure_element_type", "null") &&
        DirectMirObjectArrayEmpty(instruction, "destructure_bindings");
}

func DirectMirHelloGraphProjection(
    ref instruction: JsonObjectFactTable) -> DirectMirHelloProjection {
    let graph: JsonObjectFactTable = JsonObjectFactObjectTable(
        instruction, "expr0_graph");
    let sequence: MirExpressionGraphSequence = MirExpressionGraphSequenceAppend(
        MirExpressionGraphSequenceEmpty(), graph);
    if !sequence.ok {
        Die("direct MIR backend projection expression graph is missing or invalid");
    }
    if sequence.ready_node_count != 1 ||
        ArrayLength(sequence.roots) != 1 || sequence.roots[0] != 0 ||
        ArrayLength(sequence.arena.topology.node_kinds) != 1 ||
        sequence.arena.topology.node_kinds[0] !=
            AstExpressionNodeStringLiteral() ||
        ArrayLength(sequence.arena.node_texts) != 1 {
        return DirectMirHelloProjectionEmpty();
    }
    let literal: String = sequence.arena.node_texts[0];
    let content_opt: Option<String> = DirectMirAsciiLiteralContent(literal);
    if !IsSome(content_opt) {
        return DirectMirHelloProjectionEmpty();
    }
    return DirectMirHelloProjection(true, literal, UnwrapOption(content_opt));
}

func DirectMirHelloProjectionFromAdmitted(
    ref admitted: MirMachineLayerAdmittedJsonInput) -> DirectMirHelloProjection {
    let json: String = admitted.routines.source_json;
    if !DirectMirProgramEnvelopeReady(admitted) ||
        admitted.routines.routine_block_counts[0] != 1 ||
        MirProgramRoutineIndexBlockInstructionCountAt(
            admitted.routines, 0, 0
        ) != 1 {
        return DirectMirHelloProjectionEmpty();
    }
    let routine_index: MirRoutineFactIndex = BuildMirRoutineFactIndex(
        admitted.routines, 0);
    if !routine_index.valid ||
        ArrayLength(routine_index.source_local_names) != 0 ||
        ArrayLength(routine_index.source_local_types) != 0 {
        return DirectMirHelloProjectionEmpty();
    }
    let block_row: Int = admitted.routines.routine_block_starts[0];
    let block: JsonObjectFactTable = JsonObjectFactTableFromBounds(
        json, admitted.routines.block_starts[block_row],
        admitted.routines.block_ends[block_row]);
    if !JsonObjectFactTableReady(block) || JsonObjectFactCount(block) != 3 ||
        !DirectMirObjectNumberEquals(block, "id", "0") ||
        !JsonObjectBoolFieldEqualsWithin(
            json, block.start, block.end, "reachable", true
        ) {
        return DirectMirHelloProjectionEmpty();
    }
    let instruction_row: Int = MirProgramRoutineIndexGlobalInstructionRow(
        admitted.routines, 0, 0, 0);
    if instruction_row < 0 {
        return DirectMirHelloProjectionEmpty();
    }
    if admitted.routines.instruction_kinds[instruction_row] != "stmt" {
        Die("direct MIR backend projection rejected invalid instruction kind");
    }
    if admitted.routines.instruction_source_types[instruction_row] !=
            "AST_CALL" {
        return DirectMirHelloProjectionEmpty();
    }
    let instruction: JsonObjectFactTable = JsonObjectFactTableFromBounds(
        json, admitted.routines.instruction_starts[instruction_row],
        admitted.routines.instruction_ends[instruction_row]);
    let use_facts: MirRoutineInstructionUseFacts =
        BuildMirRoutineInstructionUseFacts(admitted.routines, 0);
    if !MirRoutineInstructionUseFactsReady(use_facts, 1) ||
        MirRoutineInstructionUseCountAtGlobal(use_facts, instruction_row) != 0 ||
        !DirectMirLogInstructionEnvelopeReady(instruction, "0") {
        return DirectMirHelloProjectionEmpty();
    }
    return DirectMirHelloGraphProjection(instruction);
}

func DirectMirScalarLocalRow(
    local_names: Array<String>, wanted: String) -> Int {
    let row: Int = 0;
    while row < ArrayLength(local_names) {
        if local_names[row] == wanted { return row; }
        row = row + 1;
    }
    return 0 - 1;
}

func DirectMirScalarDefinitionLiteral(
    ref instruction: JsonObjectFactTable,
    expected_id: String, local_name: String, result_name: String
) -> String {
    if !JsonObjectFactTableReady(instruction) ||
        !DirectMirObjectNumberEquals(instruction, "id", expected_id) ||
        !JsonObjectFactStringFieldEquals(instruction, "kind", "def") ||
        !JsonObjectFactStringFieldEquals(instruction, "name", "ssa-def") ||
        !MirSsaNameMatches(result_name, local_name, false) ||
        !JsonObjectFactStringFieldEquals(instruction, "result", result_name) ||
        !JsonObjectFactStringFieldEquals(instruction, "arg0", local_name) ||
        !DirectMirObjectFieldKindEquals(instruction, "arg1", "null") ||
        !DirectMirObjectFieldKindEquals(instruction, "slot_anchor", "null") ||
        !JsonObjectFactStringFieldEquals(instruction, "abi_type_name", "Int") ||
        !DirectMirObjectNumberEquals(instruction, "abi_layout_id", "0") ||
        !JsonObjectBoolFieldEqualsWithin(
            instruction.json, instruction.start, instruction.end,
            "abi_layout_required", false
        ) ||
        !DirectMirObjectFieldKindEquals(instruction, "abi_layout", "null") ||
        !DirectMirObjectFieldKindEquals(instruction, "expr0", "string") ||
        !JsonObjectFactStringFieldEquals(instruction, "expr1", "Int") ||
        !DirectMirObjectFieldKindEquals(instruction, "expr1_graph", "null") ||
        !JsonObjectFactStringFieldEquals(
            instruction, "source_type", "AST_LET_DECL") ||
        !JsonObjectFactStringFieldEquals(instruction, "machine_contact_kind", "") ||
        !DirectMirObjectFieldKindEquals(instruction, "machine_layer", "null") ||
        !DirectMirObjectArrayEmpty(instruction, "match_patterns") ||
        !DirectMirObjectFieldKindEquals(instruction, "match_variant", "null") ||
        !DirectMirObjectArrayEmpty(instruction, "match_bindings") ||
        !DirectMirObjectArrayEmpty(instruction, "match_binding_types") ||
        !DirectMirObjectFieldKindEquals(
            instruction, "destructure_element_type", "null") ||
        !DirectMirObjectArrayEmpty(instruction, "destructure_bindings") {
        Die("direct MIR scalar local result identity is missing or invalid");
    }
    let graph: JsonObjectFactTable = JsonObjectFactObjectTable(
        instruction, "expr0_graph");
    let sequence: MirExpressionGraphSequence = MirExpressionGraphSequenceAppend(
        MirExpressionGraphSequenceEmpty(), graph);
    if !sequence.ok || sequence.ready_node_count != 1 ||
        ArrayLength(sequence.roots) != 1 || sequence.roots[0] != 0 ||
        ArrayLength(sequence.arena.topology.node_kinds) != 1 ||
        sequence.arena.topology.node_kinds[0] !=
            AstExpressionNodeIntegerLiteral() ||
        ArrayLength(sequence.arena.node_texts) != 1 ||
        ArrayLength(sequence.arena.call_target_kinds) != 1 ||
        sequence.arena.call_target_kinds[0] != SemanticCallTargetNone() ||
        ArrayLength(sequence.arena.call_target_names) != 1 ||
        sequence.arena.call_target_names[0] != "" {
        Die("direct MIR scalar initializer integer fact is missing or invalid");
    }
    let literal: String = sequence.arena.node_texts[0];
    if StringLength(literal) == 0 || ToString(ToInt(literal)) != literal {
        Die("direct MIR scalar initializer integer is not canonical");
    }
    return literal;
}

func DirectMirScalarUsesMatch(
    ref use_facts: MirRoutineInstructionUseFacts,
    global_row: Int, left_result: String, right_result: String
) -> Bool {
    let expected_count: Int = 2;
    if left_result == right_result { expected_count = 1; }
    if MirRoutineInstructionUseCountAtGlobal(
        use_facts, global_row) != expected_count {
        return false;
    }
    let left_seen: Bool = false;
    let right_seen: Bool = false;
    let use_row: Int = 0;
    while use_row < expected_count {
        let use_opt: Option<String> = MirRoutineInstructionUseAtGlobal(
            use_facts, global_row, use_row);
        if !IsSome(use_opt) { return false; }
        let value: String = UnwrapOption(use_opt);
        if value != left_result && value != right_result {
            return false;
        }
        if value == left_result { left_seen = true; }
        if value == right_result { right_seen = true; }
        use_row = use_row + 1;
    }
    return left_seen && right_seen;
}

func DirectMirScalarLogGraphAppend(
    ref instruction: JsonObjectFactTable,
    local_names: Array<String>, result_names: Array<String>,
    ref use_facts: MirRoutineInstructionUseFacts, global_row: Int,
    inout left_rows: Array<Int>,
    inout right_rows: Array<Int>,
    inout binary_kinds: Array<Int>
) -> Bool {
    let graph: JsonObjectFactTable =
        JsonObjectFactObjectTable(instruction, "expr0_graph");
    let sequence: MirExpressionGraphSequence =
        MirExpressionGraphSequenceAppend(
            MirExpressionGraphSequenceEmpty(), graph
        );
    if !sequence.ok || sequence.ready_node_count != 6 ||
        ArrayLength(sequence.roots) != 1 || sequence.roots[0] != 5 ||
        ArrayLength(sequence.arena.topology.node_kinds) != 6 ||
        ArrayLength(sequence.arena.topology.left_children) != 6 ||
        ArrayLength(sequence.arena.topology.right_children) != 6 ||
        ArrayLength(sequence.arena.node_texts) != 6 ||
        ArrayLength(sequence.arena.call_target_kinds) != 6 ||
        ArrayLength(sequence.arena.call_target_names) != 6 {
        Die("direct MIR scalar Log expression graph topology is invalid");
    }
    if sequence.arena.topology.node_kinds[0] != AstExpressionNodeLeaf() ||
        sequence.arena.node_texts[0] != "ToString" ||
        sequence.arena.call_target_kinds[0] != SemanticCallTargetNone() ||
        sequence.arena.call_target_names[0] != "" ||
        sequence.arena.topology.node_kinds[1] != AstExpressionNodeCall() ||
        sequence.arena.topology.left_children[1] != 0 ||
        sequence.arena.call_target_kinds[1] != SemanticCallTargetDirect() ||
        sequence.arena.call_target_names[1] != "ToString" {
        Die("direct MIR scalar ToString call target is missing or invalid");
    }
    let binary_kind: Int = sequence.arena.topology.node_kinds[4];
    if sequence.arena.topology.node_kinds[2] != AstExpressionNodeLeaf() ||
        sequence.arena.topology.node_kinds[3] != AstExpressionNodeLeaf() ||
        (binary_kind != AstExpressionNodeAdd() &&
            binary_kind != AstExpressionNodeMultiply()) ||
        sequence.arena.topology.left_children[4] != 2 ||
        sequence.arena.topology.right_children[4] != 3 ||
        sequence.arena.topology.node_kinds[5] !=
            AstExpressionNodeCallArgument() ||
        sequence.arena.topology.left_children[5] != 1 ||
        sequence.arena.topology.right_children[5] != 4 {
        Die("direct MIR scalar arithmetic add node or multiply operator node or edge is missing or invalid");
    }
    let target_row: Int = 2;
    while target_row < 6 {
        if sequence.arena.call_target_kinds[target_row] !=
                SemanticCallTargetNone() ||
            sequence.arena.call_target_names[target_row] != "" {
            Die("direct MIR scalar non-call node has an invalid call target");
        }
        target_row = target_row + 1;
    }
    let left_row: Int = DirectMirScalarLocalRow(
        local_names, sequence.arena.node_texts[2]
    );
    let right_row: Int = DirectMirScalarLocalRow(
        local_names, sequence.arena.node_texts[3]
    );
    if left_row < 0 || right_row < 0 ||
        left_row >= ArrayLength(result_names) ||
        right_row >= ArrayLength(result_names) {
        Die("direct MIR scalar binary operand local identity is missing or invalid");
    }
    if !DirectMirScalarUsesMatch(
        use_facts, global_row,
        result_names[left_row], result_names[right_row]
    ) {
        Die("direct MIR scalar local result identity or graph use edge is missing or invalid");
    }
    ArrayPush(left_rows, left_row);
    ArrayPush(right_rows, right_row);
    ArrayPush(binary_kinds, binary_kind);
    return true;
}

func DirectMirScalarBlockProjectionFromAdmitted(
    ref admitted: MirMachineLayerAdmittedJsonInput) -> DirectMirScalarBlockProjection {
    let json: String = admitted.routines.source_json;
    if !DirectMirProgramEnvelopeReady(admitted) ||
        admitted.routines.routine_block_counts[0] != 1 {
        return DirectMirScalarBlockProjectionEmpty();
    }
    let instruction_count: Int =
        MirProgramRoutineIndexBlockInstructionCountAt(
            admitted.routines, 0, 0
        );
    let routine_index: MirRoutineFactIndex =
        BuildMirRoutineFactIndex(admitted.routines, 0);
    let local_count: Int =
        ArrayLength(routine_index.source_local_names);
    if !routine_index.valid || local_count < 1 ||
        local_count != ArrayLength(routine_index.source_local_types) ||
        instruction_count <= local_count {
        Die("direct MIR scalar local inventory or instruction order is invalid");
    }
    let local_row: Int = 0;
    while local_row < local_count {
        if routine_index.source_local_types[local_row] != "Int" ||
            StringLength(routine_index.source_local_names[local_row]) == 0 {
            Die("direct MIR scalar local type inventory is missing or invalid");
        }
        let prior_row: Int = 0;
        while prior_row < local_row {
            if routine_index.source_local_names[prior_row] ==
                    routine_index.source_local_names[local_row] {
                Die("direct MIR scalar local identity is duplicated");
            }
            prior_row = prior_row + 1;
        }
        local_row = local_row + 1;
    }
    let block_row: Int = admitted.routines.routine_block_starts[0];
    let block: JsonObjectFactTable = JsonObjectFactTableFromBounds(
        json,
        admitted.routines.block_starts[block_row],
        admitted.routines.block_ends[block_row]
    );
    if !JsonObjectFactTableReady(block) || JsonObjectFactCount(block) != 3 ||
        !DirectMirObjectNumberEquals(block, "id", "0") ||
        !JsonObjectBoolFieldEqualsWithin(
            json, block.start, block.end, "reachable", true
        ) {
        Die("direct MIR scalar reachable block is missing or invalid");
    }
    let use_facts: MirRoutineInstructionUseFacts =
        BuildMirRoutineInstructionUseFacts(admitted.routines, 0);
    if !MirRoutineInstructionUseFactsReady(
        use_facts, instruction_count
    ) {
        Die("direct MIR scalar instruction use facts are invalid");
    }
    let local_names: Array<String> =
        routine_index.source_local_names;
    let result_names: Array<String> = [];
    let integer_literals: Array<String> = [];
    let definition_row: Int = 0;
    while definition_row < local_count {
        let global_row: Int = MirProgramRoutineIndexGlobalInstructionRow(
            admitted.routines, 0, 0, definition_row
        );
        if global_row < 0 ||
            admitted.routines.instruction_kinds[global_row] != "def" ||
            admitted.routines.instruction_source_types[global_row] !=
                "AST_LET_DECL" {
            Die("direct MIR scalar definition instruction order is invalid");
        }
        let instruction: JsonObjectFactTable = JsonObjectFactTableFromBounds(
            json,
            admitted.routines.instruction_starts[global_row],
            admitted.routines.instruction_ends[global_row]
        );
        let result_opt: Option<String> =
            JsonObjectFactStringFieldOpt(instruction, "result");
        if !IsSome(result_opt) {
            Die("direct MIR scalar local result identity is missing or invalid");
        }
        let result_name: String = UnwrapOption(result_opt);
        let literal: String = DirectMirScalarDefinitionLiteral(
            instruction, ToString(definition_row),
            local_names[definition_row], result_name
        );
        if MirRoutineInstructionUseCountAtGlobal(
            use_facts, global_row
        ) != 0 {
            Die("direct MIR scalar definition use facts are invalid");
        }
        ArrayPush(result_names, result_name);
        ArrayPush(integer_literals, literal);
        definition_row = definition_row + 1;
    }
    let left_rows: Array<Int> = [];
    let right_rows: Array<Int> = [];
    let binary_kinds: Array<Int> = [];
    let statement_row: Int = local_count;
    while statement_row < instruction_count {
        let global_row: Int = MirProgramRoutineIndexGlobalInstructionRow(
            admitted.routines, 0, 0, statement_row
        );
        if global_row < 0 ||
            admitted.routines.instruction_kinds[global_row] != "stmt" ||
            admitted.routines.instruction_source_types[global_row] !=
                "AST_CALL" {
            Die("direct MIR scalar repeated Log instruction order is invalid");
        }
        let instruction: JsonObjectFactTable = JsonObjectFactTableFromBounds(
            json,
            admitted.routines.instruction_starts[global_row],
            admitted.routines.instruction_ends[global_row]
        );
        if !DirectMirLogInstructionEnvelopeReady(
            instruction, ToString(statement_row)
        ) {
            Die("direct MIR scalar Log instruction id/order facts are invalid");
        }
        if !DirectMirScalarLogGraphAppend(
            instruction, local_names, result_names, use_facts, global_row,
            left_rows, right_rows, binary_kinds
        ) {
            Die("direct MIR scalar Log graph projection is invalid");
        }
        statement_row = statement_row + 1;
    }
    return DirectMirScalarBlockProjection(
        true, local_names, result_names, integer_literals,
        left_rows, right_rows, binary_kinds
    );
}
