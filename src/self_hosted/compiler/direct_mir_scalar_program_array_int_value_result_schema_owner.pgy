// Array<Int> value-result fact schema and readiness.

import "direct_mir_array_int_abi_fact_owner.pgy";
import "direct_mir_array_storage_layout_contract_owner.pgy";
import "direct_mir_scalar_program_owned_array_value_parameter_policy_owner.pgy";
import "direct_mir_routine_instance_inventory_owner.pgy";
import "direct_mir_scalar_program_parameter_fact_projection_owner.pgy";
import "direct_mir_scalar_cfg_hash_owner.pgy";
import "../mir_lower/abi_layout_admission_fact_owner.pgy";
import "../mir_lower/routine_fact_index_owner.pgy";
import "../mir_lower/machine_layer_fact_owner.pgy";

struct DirectMirScalarProgramArrayIntValueResultFact {
    let valid: Bool;
    let digest: Int;
    let present: Bool;
    let layout_id: Int;
    let size: Int;
    let align: Int;
    let data_offset: Int;
    let length_offset: Int;
    let capacity_offset: Int;
    let allocator_offset: Int;
    let routine_ordinals: Array<Int>;
    let parameter_ordinals: Array<Int>;
    let parameter_digests: Array<Int>;
}

func DirectMirScalarProgramArrayIntValueResultFactInvalid(
) -> DirectMirScalarProgramArrayIntValueResultFact {
    let rows: Array<Int> = [];
    return DirectMirScalarProgramArrayIntValueResultFact(
        false, 0, false, 0, 0, 0, 0, 0, 0, 0, rows, rows, rows);
}

func DirectMirScalarProgramArrayIntValueResultFactDigest(
    ref fact: DirectMirScalarProgramArrayIntValueResultFact
) -> Int {
    if !fact.valid { return 0; }
    var hash: Long = DirectMirCfgHashInt(271L, fact.layout_id);
    hash = DirectMirCfgHashInt(hash, fact.size);
    hash = DirectMirCfgHashInt(hash, fact.align);
    hash = DirectMirCfgHashInt(hash, fact.data_offset);
    hash = DirectMirCfgHashInt(hash, fact.length_offset);
    hash = DirectMirCfgHashInt(hash, fact.capacity_offset);
    hash = DirectMirCfgHashInt(hash, fact.allocator_offset);
    hash = DirectMirScalarCfgHashInts(hash, fact.routine_ordinals);
    hash = DirectMirScalarCfgHashInts(hash, fact.parameter_ordinals);
    hash = DirectMirScalarCfgHashInts(hash, fact.parameter_digests);
    if fact.present { hash = DirectMirCfgHashInt(hash, 1); }
    else { hash = DirectMirCfgHashInt(hash, 0); }
    return DirectMirCfgBoundedDigest(hash);
}

func DirectMirScalarProgramArrayIntValueResultFactReady(
    ref fact: DirectMirScalarProgramArrayIntValueResultFact
) -> Bool {
    if !fact.valid || fact.digest == 0 || fact.digest !=
            DirectMirScalarProgramArrayIntValueResultFactDigest(fact) {
        return false;
    }
    let count: Int = ArrayLength(fact.routine_ordinals);
    if count != ArrayLength(fact.parameter_ordinals) ||
        count != ArrayLength(fact.parameter_digests) { return false; }
    if !fact.present {
        return count == 0 && fact.layout_id == 0 && fact.size == 0 &&
            fact.align == 0 && fact.data_offset == 0 &&
            fact.length_offset == 0 && fact.capacity_offset == 0 &&
            fact.allocator_offset == 0;
    }
    let layout: DirectMirArrayStorageLayoutContract =
        DirectMirArrayStorageLayoutContractFact();
    if fact.layout_id <= 0 ||
        !DirectMirArrayStorageLayoutContractReady(layout) ||
        fact.size != layout.size || fact.align != layout.align ||
        fact.data_offset != layout.data_offset ||
        fact.length_offset != layout.length_offset ||
        fact.capacity_offset != layout.capacity_offset ||
        fact.allocator_offset != layout.allocator_offset {
        return false;
    }
    var row: Int = 0;
    while row < count {
        if fact.routine_ordinals[row] <= 0 ||
            fact.parameter_ordinals[row] < 0 ||
            fact.parameter_digests[row] == 0 { return false; }
        var prior: Int = 0;
        while prior < row {
            if fact.routine_ordinals[prior] == fact.routine_ordinals[row] &&
                fact.parameter_ordinals[prior] ==
                    fact.parameter_ordinals[row] { return false; }
            prior = prior + 1;
        }
        row = row + 1;
    }
    return true;
}

func DirectMirScalarProgramArrayIntValueResultFactCanonicalEmpty(
) -> DirectMirScalarProgramArrayIntValueResultFact {
    let rows: Array<Int> = [];
    let source: DirectMirScalarProgramArrayIntValueResultFact =
        DirectMirScalarProgramArrayIntValueResultFact(
            true, 0, false, 0, 0, 0, 0, 0, 0, 0, rows, rows, rows);
    return DirectMirScalarProgramArrayIntValueResultFact(
        true, DirectMirScalarProgramArrayIntValueResultFactDigest(source),
        false, 0, 0, 0, 0, 0, 0, 0, rows, rows, rows);
}

