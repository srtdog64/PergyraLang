// Owns the exact target identity and no-value lane shape of array receivers.
import "direct_mir_scalar_program_array_mutation_target_owner.pgy";
import "direct_mir_scalar_cfg_scoped_match_binding_operand_owner.pgy";

func DirectMirScalarProgramArrayMutationReceiverTargetShapeReady(
    ref locals: DirectMirScalarCfgLocalRefPlan,
    ref types: DirectMirScalarCfgValueTypePlan,
    ref wire: DirectMirScalarCfgWireLocalRefs,
    ref target: DirectMirScalarProgramArrayMutationTarget,
    local_instruction: Int
) -> Bool {
    let local_row: Int = target.local_row;
    let parameter: Int = target.parameter_ordinal;
    if !target.valid || !locals.valid || !types.valid || !wire.valid ||
        !wire.required || ((local_row < 0) == (parameter < 0)) ||
        local_instruction < 0 ||
        local_instruction >= ArrayLength(wire.primary_refs) {
        return false;
    }
    let receiver_ref: String = wire.primary_refs[local_instruction];
    if local_row >= 0 {
        return local_row < ArrayLength(locals.local_ref_value_ids) &&
            local_row < ArrayLength(types.local_types) &&
            receiver_ref == locals.local_ref_value_ids[local_row];
    }
    let parts: Array<String> = Split(receiver_ref, ":");
    return ArrayLength(parts) == 3 && parts[0] == "parameter" &&
        ToString(ToInt(parts[2])) == parts[2] &&
        ToInt(parts[2]) == parameter;
}

// Pop has no value/index lane after the local receiver or parameter identity.
func DirectMirScalarProgramArrayPopReceiverShapeReady(
    ref instruction: JsonObjectFactTable,
    ref uses: MirRoutineInstructionUseFacts,
    global_row: Int, expected_receiver_uses: Int
) -> Bool {
    if expected_receiver_uses != 0 && expected_receiver_uses != 1 {
        return false;
    }
    let graph0: Option<String> =
        JsonObjectFactValueKind(instruction, "expr0_graph");
    let graph1: Option<String> =
        JsonObjectFactValueKind(instruction, "expr1_graph");
    return IsSome(graph0) && UnwrapOption(graph0) == "null" &&
        IsSome(graph1) && UnwrapOption(graph1) == "null" &&
        MirRoutineInstructionUseCountAtGlobal(uses, global_row) ==
            expected_receiver_uses;
}
