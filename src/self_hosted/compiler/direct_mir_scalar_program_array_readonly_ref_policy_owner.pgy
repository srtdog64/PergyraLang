// Read-only Array<Int>/Array<String> callable-parameter policy.

import "direct_mir_routine_signature_fact_owner.pgy";
import "abi_layout_row_owner.pgy";

func DirectMirScalarProgramReadonlyArrayTypeSupported(type_name: String) -> Bool {
    return type_name == CompilerAbiLayoutArrayIntTypeName() ||
        type_name == CompilerAbiLayoutArrayStringTypeName();
}

func DirectMirScalarProgramArrayReadonlyRefParameterReady(
    ref signature: DirectMirRoutineSignatureFact, ordinal: Int
) -> Bool {
    return ordinal >= 0 && ordinal < signature.param_count &&
        DirectMirScalarProgramReadonlyArrayTypeSupported(
            signature.parameters.type_names[ordinal]) &&
        signature.parameters.carriages[ordinal] == "readonly-ref" &&
        signature.parameters.resources[ordinal] == "none" &&
        signature.parameters.pass_shapes[ordinal] == "direct" &&
        signature.parameters.abi_required[ordinal] &&
        signature.parameters.abi_layout_ids[ordinal] > 0;
}
