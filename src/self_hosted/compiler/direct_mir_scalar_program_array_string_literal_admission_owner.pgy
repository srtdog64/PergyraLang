// Typed normalization of one Array<String> literal into the program arena.

import "direct_mir_array_string_literal_fact_owner.pgy";
import "direct_mir_scalar_program_expression_mutation_owner.pgy";
import "direct_mir_scalar_program_expression_kind_id_owner.pgy";

struct DirectMirScalarProgramArrayStringLiteralAdmission {
    let recognized: Bool;
    let facts: DirectMirScalarProgramExpressionSet;
}

func DirectMirScalarProgramAppendArrayStringLiteral(
    facts: DirectMirScalarProgramExpressionSet,
    ref sequence: MirExpressionGraphSequence,
    ref uses: MirRoutineInstructionUseFacts,
    global_row: Int, expected_type: String
) -> DirectMirScalarProgramArrayStringLiteralAdmission {
    let root: Int = sequence.roots[0];
    let source_kind: Int = sequence.arena.topology.node_kinds[root];
    let recognized: Bool = expected_type ==
            CompilerAbiLayoutArrayStringTypeName() &&
        (source_kind == AstExpressionNodeArrayLiteral() ||
         source_kind == AstExpressionNodeArrayElement());
    if !recognized {
        return DirectMirScalarProgramArrayStringLiteralAdmission(false, facts);
    }
    let invalid: DirectMirScalarProgramExpressionSet =
        DirectMirScalarProgramExpressionSetInvalid(facts);
    let literal: DirectMirArrayStringLiteralFact =
        DirectMirArrayStringLiteralFactFromGraph(sequence);
    if !literal.valid ||
        MirRoutineInstructionUseCountAtGlobal(uses, global_row) != 0 {
        return DirectMirScalarProgramArrayStringLiteralAdmission(true, invalid);
    }
    let graph_rows: Array<Int> = facts.graph_global_rows;
    let starts: Array<Int> = facts.graph_starts;
    let counts: Array<Int> = facts.graph_counts;
    let roots: Array<Int> = facts.graph_roots;
    let kinds: Array<Int> = facts.node_kinds;
    let types: Array<String> = facts.node_types;
    let lefts: Array<Int> = facts.node_lefts;
    let rights: Array<Int> = facts.node_rights;
    let locals: Array<Int> = facts.node_local_rows;
    let params: Array<Int> = facts.node_parameter_ordinals;
    let literals: Array<String> = facts.node_literals;
    let callables: Array<Int> = facts.node_callable_rows;
    let nary: DirectMirScalarProgramNaryOperands = facts.nary_operands;
    let start: Int = ArrayLength(kinds);
    let operands: Array<Int> = [];
    let element: Int = 0;
    while element < ArrayLength(literal.elements) {
        DirectMirScalarProgramAppendExpressionNode(
            kinds, types, lefts, rights, locals, params, literals, callables,
            DirectMirScalarProgramExprStringLiteral(),
            CompilerAbiLayoutStringTypeName(), -1, -1, -1, -1,
            literal.elements[element], -1);
        ArrayPush(operands, ArrayLength(kinds) - 1);
        element = element + 1;
    }
    let left: Int = -1; let right: Int = -1;
    if ArrayLength(operands) == 1 { left = operands[0]; }
    if ArrayLength(operands) == 2 {
        left = operands[0]; right = operands[1];
    }
    DirectMirScalarProgramAppendExpressionNode(
        kinds, types, lefts, rights, locals, params, literals, callables,
        DirectMirScalarProgramExprArrayStringLiteral(),
        CompilerAbiLayoutArrayStringTypeName(), left, right, -1, -1, "", -1);
    let normalized_root: Int = ArrayLength(kinds) - 1;
    if ArrayLength(operands) >= 3 {
        nary = DirectMirScalarProgramNaryOperandsAppend(
            nary, normalized_root, operands);
    }
    ArrayPush(graph_rows, global_row); ArrayPush(starts, start);
    ArrayPush(counts, ArrayLength(kinds) - start);
    ArrayPush(roots, normalized_root);
    return DirectMirScalarProgramArrayStringLiteralAdmission(
        true, DirectMirScalarProgramExpressionSet(
            true, 0, graph_rows, starts, counts, roots, kinds, types,
            lefts, rights, locals, params, literals, callables, nary));
}
