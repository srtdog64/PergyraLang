// Target-qualified Array<String> spelling for scalar-program Set and Pop.
import "direct_mir_scalar_program_array_string_abi_projection_owner.pgy";
import "../codegen/runtime_abi/collection_bounds_owner.pgy";
import "../codegen/runtime_abi/collection_runtime_owner.pgy";

func DirectMirScalarProgramCArrayStringSetMaterialization(
    ref fact: DirectMirScalarProgramArrayStringAbiFact,
    projection_opt: Option<DirectMirArrayStringAbiProjection>
) -> String {
    if !IsSome(projection_opt) { Die(
        "direct MIR C Array<String> mutation projection is missing"); }
    let projection: DirectMirArrayStringAbiProjection =
        UnwrapOption(projection_opt);
    let carrier: String = DirectMirScalarProgramCArrayStringCarrierType(
        fact, projection);
    return CollectionRuntimeCGuardedSetWithLength(
        CollectionRuntimeCSetFn(2), carrier, "const char *", "length");
}

func DirectMirScalarProgramLlvmArrayStringMutationProjection(
    ref fact: DirectMirScalarProgramArrayStringAbiFact,
    projection_opt: Option<DirectMirArrayStringAbiProjection>
) -> DirectMirArrayStringAbiProjection {
    if !IsSome(projection_opt) { Die(
        "direct MIR LLVM Array<String> mutation projection is missing"); }
    let projection: DirectMirArrayStringAbiProjection =
        UnwrapOption(projection_opt);
    if !DirectMirScalarProgramArrayStringAbiProjectionReadyForFact(
            fact, projection, CompilerTargetCpuLlvmProjection()) { Die(
        "direct MIR LLVM Array<String> mutation projection drifted"); }
    return projection;
}

func DirectMirScalarProgramLlvmArrayStringSetMaterialization(
    ref fact: DirectMirScalarProgramArrayStringAbiFact,
    projection_opt: Option<DirectMirArrayStringAbiProjection>
) -> String {
    let projection: DirectMirArrayStringAbiProjection =
        DirectMirScalarProgramLlvmArrayStringMutationProjection(
            fact, projection_opt);
    let aggregate: String = projection.llvm_aggregate_type;
    let align: String = ToString(projection.storage.align);
    var output: String = "define internal void @pgy_as_set(ptr %array, i64 %index, ptr %value) {\nentry:\n  %length.ptr = getelementptr inbounds ";
    output = Concat(output, Concat(aggregate, ", ptr %array, i32 0, i32 "));
    output = Concat(output, Concat(ToString(projection.length_index),
        Concat("\n  %length = load i64, ptr %length.ptr, align ", align)));
    output = Concat(output, "\n  %negative = icmp slt i64 %index, 0\n  %past.end = icmp sge i64 %index, %length\n  %invalid = or i1 %negative, %past.end\n  br i1 %invalid, label %panic, label %write\n\npanic:\n  call void @pgy_runtime_panic_out_of_bounds_export(ptr null)\n  unreachable\n\nwrite:\n  %data.ptr = getelementptr inbounds ");
    output = Concat(output, Concat(aggregate, ", ptr %array, i32 0, i32 "));
    output = Concat(output, Concat(ToString(projection.data_index),
        Concat("\n  %data = load ptr, ptr %data.ptr, align ", align)));
    output = Concat(output, Concat("\n  %slot = getelementptr inbounds ptr, ptr %data, i64 %index\n  store ptr %value, ptr %slot, align ", align));
    return Concat(output, "\n  ret void\n}\n\n");
}
