// Routine-partition identity for admitted read-only Array<String> parameters.

import "direct_mir_scalar_cfg_routine_partition_fact_owner.pgy";
import "abi_layout_row_owner.pgy";

func DirectMirScalarProgramArrayStringReadonlyRefAt(
    ref routines: DirectMirScalarCfgRoutinePartitionFact,
    routine: Int, ordinal: Int
) -> Bool {
    if routine < 0 || routine >= ArrayLength(routines.parameter_counts) ||
        ordinal < 0 || ordinal >= routines.parameter_counts[routine] {
        return false;
    }
    let row: Int = routines.parameter_starts[routine] + ordinal;
    return routines.parameter_types[row] ==
            CompilerAbiLayoutArrayStringTypeName() &&
        routines.parameter_carriages[row] == "readonly-ref";
}
