// Bool signature with exactly two ArrayString and two ArrayInt copyouts.

import "direct_mir_routine_signature_fact_owner.pgy";
import "direct_mir_scalar_cfg_type_family_owner.pgy";
func DirectMirScalarProgramBoolTwoArrayStringTwoArrayIntValueResultSignatureReady(
    ref signature: DirectMirRoutineSignatureFact
) -> Bool {
    if !DirectMirRoutineSignatureFactReady(signature) ||
        signature.return_type != CompilerAbiLayoutBoolTypeName() ||
        signature.param_count < 4 { return false; }
    let array_string_count: Int = 0;
    let array_int_count: Int = 0;
    let array_string_layout: Int = 0;
    let array_int_layout: Int = 0;
    let ordinal: Int = 0;
    while ordinal < signature.param_count {
        let type_name: String = signature.parameters.type_names[ordinal];
        let array_string: Bool = type_name ==
            CompilerAbiLayoutArrayStringTypeName();
        let array_int: Bool = type_name == CompilerAbiLayoutArrayIntTypeName();
        let collection: Bool = array_string || array_int;
        if (!collection && !DirectMirScalarCfgScalarTypeSupported(type_name)) ||
            signature.parameters.resources[ordinal] != "none" ||
            signature.parameters.pass_shapes[ordinal] != "direct" {
            return false;
        }
        if collection {
            if signature.parameters.carriages[ordinal] != "value-result" ||
                !signature.parameters.abi_required[ordinal] ||
                signature.parameters.abi_layout_ids[ordinal] <= 0 {
                return false;
            }
            let layout: Int = signature.parameters.abi_layout_ids[ordinal];
            if array_string {
                array_string_count = array_string_count + 1;
                if array_string_layout == 0 { array_string_layout = layout; }
                else if array_string_layout != layout { return false; }
            } else {
                array_int_count = array_int_count + 1;
                if array_int_layout == 0 { array_int_layout = layout; }
                else if array_int_layout != layout { return false; }
            }
        } else if signature.parameters.carriages[ordinal] != "value" ||
            signature.parameters.abi_required[ordinal] ||
            signature.parameters.abi_layout_ids[ordinal] != 0 {
            return false;
        }
        ordinal = ordinal + 1;
    }
    return array_string_count == 2 && array_int_count == 2 &&
        array_string_layout != array_int_layout;
}

func DirectMirScalarProgramBoolTwoArrayStringTwoArrayIntValueResultParameterReady(
    ref signature: DirectMirRoutineSignatureFact, ordinal: Int
) -> Bool {
    return ordinal >= 0 && ordinal < signature.param_count &&
        DirectMirScalarProgramBoolTwoArrayStringTwoArrayIntValueResultSignatureReady(
            signature);
}
