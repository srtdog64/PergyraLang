// Canonical builtin-signature join for calls nested in scalar expression DAGs.

import "direct_mir_scalar_program_builtin_argument_chain_owner.pgy";
import "direct_mir_scalar_program_builtin_signature_projection_owner.pgy";

struct DirectMirScalarProgramBuiltinCallFact {
    let recognized: Bool;
    let valid: Bool;
    let complete: Bool;
    let expression_kind: Int;
    let argument_rows: Array<Int>;
    let call_node: Int;
}

func DirectMirScalarProgramBuiltinCallFactInvalid(
    recognized: Bool
) -> DirectMirScalarProgramBuiltinCallFact {
    let rows: Array<Int> = [];
    return DirectMirScalarProgramBuiltinCallFact(
        recognized, false, false, 0, rows, -1);
}

func DirectMirScalarProgramBuiltinCallFactFromGraph(
    ref sequence: MirExpressionGraphSequence, node: Int,
    source_rows: Array<Int>, normalized_types: Array<String>
) -> DirectMirScalarProgramBuiltinCallFact {
    let missing: DirectMirScalarProgramBuiltinCallFact =
        DirectMirScalarProgramBuiltinCallFactInvalid(false);
    if node < 0 || node >= ArrayLength(sequence.arena.topology.node_kinds) ||
        sequence.arena.topology.node_kinds[node] !=
            AstExpressionNodeCallArgument() { return missing; }
    let chain: DirectMirScalarProgramBuiltinArgumentChain =
        DirectMirScalarProgramBuiltinArgumentChainFromGraph(
            sequence, node, source_rows, normalized_types);
    if !chain.valid {
        return DirectMirScalarProgramBuiltinCallFactInvalid(true);
    }
    if sequence.arena.identities.call_target_syntax_ids[chain.call_node] != 0 {
        return missing;
    }
    let signature: DirectMirScalarProgramBuiltinSignatureFact =
        DirectMirScalarProgramBuiltinSignatureFactFromName(
            sequence.arena.call_target_names[chain.call_node]);
    if !signature.valid {
        return DirectMirScalarProgramBuiltinCallFactInvalid(true);
    }
    let actual_types: Array<String> = []; let i: Int = 0;
    while i < ArrayLength(chain.argument_rows) {
        ArrayPush(actual_types, normalized_types[chain.argument_rows[i]]);
        i = i + 1;
    }
    if !DirectMirScalarProgramBuiltinArgumentPrefixReady(
            signature, actual_types) {
        return DirectMirScalarProgramBuiltinCallFactInvalid(true);
    }
    let complete: Bool = ArrayLength(actual_types) ==
        ArrayLength(signature.parameter_types);
    return DirectMirScalarProgramBuiltinCallFact(
        true, true, complete, signature.expression_kind,
        chain.argument_rows, chain.call_node);
}
