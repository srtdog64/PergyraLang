// Exact graph-to-signature identity policy for runtime-backed builtins.
import "direct_mir_scalar_program_builtin_signature_projection_owner.pgy";
import "direct_mir_scalar_program_expression_kind_id_owner.pgy";
func DirectMirScalarProgramBuiltinRuntimeCallIdentityReady(
    ref signature: DirectMirScalarProgramBuiltinSignatureFact, carried: Int) -> Bool {
    if !signature.valid { return false; }
    // These target-library rows are selected by normalized builtin admission,
    // not carried as per-instruction resource identities in the source graph.
    if DirectMirScalarProgramCheckedIntKind(signature.expression_kind) ||
            DirectMirScalarProgramArrayTransformKind(signature.expression_kind) {
        let abi: CompilerRuntimeCallAbiFact = DirectMirScalarProgramCheckedIntRuntimeFact(signature.expression_kind);
        if DirectMirScalarProgramArrayTransformKind(signature.expression_kind) {
            abi = DirectMirScalarProgramArrayTransformRuntimeFact(signature.expression_kind);
        }
        return abi.ok && signature.runtime_call_abi_id == abi.runtime_call_abi_id && carried == 0;
    }
    // Runtime-value rows are sealed at the instruction; artifact rows belong
    // to the registry. Neither resource identity is carried by the source graph.
    if signature.expression_kind == DirectMirScalarProgramExprRuntimeValueCall() || signature.expression_kind ==
            DirectMirScalarProgramExprCompilerArtifactWrite() || signature.expression_kind ==
            DirectMirScalarProgramExprCompilerArtifactBegin() || signature.expression_kind ==
            DirectMirScalarProgramExprCompilerArtifactCommit() || signature.expression_kind ==
            DirectMirScalarProgramExprCompilerArtifactAbort() {
        return signature.runtime_call_abi_id > 0 && carried == 0;
    }
    if signature.runtime_call_abi_id > 0 {
        return carried == signature.runtime_call_abi_id;
    }
    return signature.valid && carried == 0;
}
