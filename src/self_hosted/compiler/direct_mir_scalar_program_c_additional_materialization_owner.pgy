// C composition of responsibility-specific generated runtime bodies.

import "direct_mir_scalar_program_c_string_window_materialization_owner.pgy";
import "direct_mir_scalar_program_c_case_math_materialization_owner.pgy";
import "direct_mir_scalar_program_c_string_scalar_materialization_owner.pgy";

func DirectMirScalarProgramCAdditionalMaterialization(
    ref plan: DirectMirScalarCfgGraphPlan,
    ref runtime: DirectMirScalarProgramRuntimeAbiProjection
) -> String {
    let output: String = DirectMirScalarProgramCStringWindowMaterialization(
        plan.program.runtime_abi);
    output = Concat(output, DirectMirScalarProgramCStringScalarMaterialization(
        plan.program.runtime_abi));
    return Concat(output,
        DirectMirScalarProgramCCaseMathMaterialization(plan, runtime));
}
