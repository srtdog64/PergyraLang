// C type materialization for one sealed program-wide Array<Bool> ABI.

import "direct_mir_scalar_program_array_bool_abi_owner.pgy";
import "direct_mir_array_storage_abi_projection_owner.pgy";
import "direct_mir_array_storage_c_assertion_owner.pgy";
import "target_projection_fact_owner.pgy";
import "../codegen/runtime_abi/collection_bounds_owner.pgy";
import "../codegen/runtime_abi/collection_runtime_owner.pgy";

func DirectMirScalarProgramCArrayBoolPreamble(
    ref fact: DirectMirScalarProgramArrayBoolAbiFact,
    ref target: CompilerTargetProjectionFact
) -> String {
    if !DirectMirScalarProgramArrayBoolAbiFactReady(fact) {
        Die("direct MIR C Array<Bool> ABI fact is invalid");
    }
    if !fact.present { return ""; }
    let storage: DirectMirArrayStorageAbiProjection =
        DirectMirArrayStorageAbiProjectionFromTarget(target);
    if !DirectMirArrayStorageAbiProjectionReadyFor(
            storage, CompilerTargetCpuCProjection()) ||
        fact.size != storage.size || fact.align != storage.align ||
        fact.data_offset != storage.data_offset ||
        fact.length_offset != storage.length_offset ||
        fact.capacity_offset != storage.capacity_offset ||
        fact.allocator_offset != storage.allocator_offset {
        Die("direct MIR C Array<Bool> target projection is invalid");
    }
    let output: String = "#include <stddef.h>\n";
    output = Concat(output,
        "typedef struct { bool *data; size_t length; size_t capacity; void *allocator; } ");
    output = Concat(output, CompilerAbiLayoutArrayBoolCValueType());
    output = Concat(output, ";\n");
    output = Concat(output, DirectMirArrayStorageCAssertionBlock(
        storage, CompilerAbiLayoutArrayBoolCValueType()));
    output = Concat(output, "#include \"pgy_runtime_panic_contract.h\"\n");
    return Concat(output, CollectionRuntimeCGuardedGetWithLength(
        "bool", CollectionRuntimeCGetFn(4),
        CompilerAbiLayoutArrayBoolCValueType(), "length"));
}
