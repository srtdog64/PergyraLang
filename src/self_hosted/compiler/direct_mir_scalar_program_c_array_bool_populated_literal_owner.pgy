// Ordered C materialization for heap-backed populated Array<Bool> literals.

import "direct_mir_scalar_cfg_graph_fact_owner.pgy";
import "direct_mir_scalar_program_array_bool_populated_literal_readiness_owner.pgy";

func DirectMirScalarProgramCArrayBoolPopulatedLiteralMaterialization(
    ref plan: DirectMirScalarCfgGraphPlan
) -> String {
    if !DirectMirScalarProgramHasArrayBoolPopulatedLiteral(
            plan.program.expressions) { return ""; }
    if !DirectMirScalarProgramArrayBoolAbiFactReady(
            plan.program.array_bool_abi) ||
        !plan.program.array_bool_abi.present {
        Die("direct MIR scalar C populated Array<Bool> ABI is invalid");
    }
    let output: String = "";
    let node: Int = 0;
    while node < ArrayLength(plan.program.expressions.node_kinds) {
        if plan.program.expressions.node_kinds[node] !=
                DirectMirScalarProgramExprArrayBoolPopulatedLiteral() {
            node = node + 1; continue;
        }
        let operands: Array<Int> =
            DirectMirScalarProgramArrayBoolPopulatedLiteralOperandRows(
                plan.program.expressions, node);
        output = Concat(output, "static ");
        output = Concat(output, CompilerAbiLayoutArrayBoolCValueType());
        output = Concat(output, " pgy_array_bool_populated_literal_");
        output = Concat(output, ToString(node));
        output = Concat(output, "(void) {\n    ");
        output = Concat(output, CompilerAbiLayoutArrayBoolCValueType());
        output = Concat(output, " out = {NULL, 0, 0, NULL};\n");
        output = Concat(output, "    out.data = (bool *)malloc(");
        output = Concat(output, ToString(ArrayLength(operands)));
        output = Concat(output,
            " * sizeof(bool));\n    if (out.data == NULL) abort();\n");
        output = Concat(output, "    out.length = ");
        output = Concat(output, ToString(ArrayLength(operands)));
        output = Concat(output, "; out.capacity = out.length;\n");
        let item: Int = 0;
        while item < ArrayLength(operands) {
            output = Concat(output, "    out.data[");
            output = Concat(output, ToString(item));
            output = Concat(output, "] = ");
            output = Concat(output, plan.program.expressions.node_literals[
                operands[item]]);
            output = Concat(output, ";\n");
            item = item + 1;
        }
        output = Concat(output, "    return out;\n}\n\n");
        node = node + 1;
    }
    return output;
}

func DirectMirScalarProgramCArrayBoolPopulatedLiteralExpression(
    kind: Int, expression_node: Int
) -> Option<String> {
    if kind != DirectMirScalarProgramExprArrayBoolPopulatedLiteral() {
        return None;
    }
    return Some(Concat("pgy_array_bool_populated_literal_", Concat(
        ToString(expression_node), "()")));
}
