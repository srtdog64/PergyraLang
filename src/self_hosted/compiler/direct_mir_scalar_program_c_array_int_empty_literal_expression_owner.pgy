// C materialization for one ABI-sealed empty Array<Int> value.

import "direct_mir_scalar_program_expression_kind_id_owner.pgy";
import "abi_layout_row_owner.pgy";

func DirectMirScalarProgramCArrayIntEmptyLiteralExpression(
    kind: Int
) -> Option<String> {
    if kind != DirectMirScalarProgramExprArrayIntEmptyLiteral() {
        return None;
    }
    return Some(Concat("((", Concat(
        CompilerAbiLayoutArrayIntCValueType(),
        "){NULL, 0, 0, NULL})")));
}
