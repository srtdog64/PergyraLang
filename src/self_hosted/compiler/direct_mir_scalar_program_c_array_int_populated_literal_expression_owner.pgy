// C evaluates every element once, in source order, before materialization.
import "direct_mir_scalar_program_expression_kind_id_owner.pgy";

func DirectMirScalarProgramCArrayIntPopulatedLiteralExpression(
    kind: Int, expression_node: Int, arguments: Array<String>
) -> Option<String> {
    if kind != DirectMirScalarProgramExprArrayIntPopulatedLiteral() {
        return None;
    }
    if ArrayLength(arguments) < 1 {
        Die("populated Array<Int> requires admitted element values");
    }
    let name: String = "pgy_array_values_" + ToString(expression_node);
    var output: String = "({ int64_t " + name + "[" +
        ToString(ArrayLength(arguments)) + "]; ";
    var row: Int = 0;
    while row < ArrayLength(arguments) {
        output = output + name + "[" + ToString(row) + "] = " +
            arguments[row] + "; ";
        row = row + 1;
    }
    return Some(output + "pgy_array_int_populated_literal_" +
        ToString(expression_node) + "(" + name + "); })");
}
