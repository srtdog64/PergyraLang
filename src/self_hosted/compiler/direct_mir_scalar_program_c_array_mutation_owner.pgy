// C materialization and operation emission for typed array mutation targets.
import "direct_mir_scalar_cfg_graph_fact_owner.pgy";
import "direct_mir_scalar_cfg_c_operand_owner.pgy";
import "direct_mir_scalar_program_array_mutation_target_owner.pgy";
import "direct_mir_scalar_program_array_string_parameter_mutation_policy_owner.pgy";
import "direct_mir_scalar_program_array_string_mutation_projection_owner.pgy";
import "direct_mir_scalar_program_array_int_value_result_target_owner.pgy";
import "direct_mir_scalar_program_logical_record_assignment_readiness_owner.pgy";
import "../codegen/runtime_abi/collection_bounds_owner.pgy";
import "../codegen/runtime_abi/collection_runtime_owner.pgy";
func DirectMirScalarProgramCArrayPushMaterialization(
    symbol: String, array_type: String, element_type: String
) -> String {
    if symbol == "" || array_type == "" || element_type == "" {
        Die("direct MIR C local array push type is invalid");
    }
    let output: String = "#include <stdlib.h>\nstatic void ";
    output = Concat(output, Concat(symbol, "("));
    output = Concat(output, array_type);
    output = Concat(output, " *a, long long v) {\n");
    output = Concat(output, "    if (a->length == a->capacity) { size_t n = a->capacity ? a->capacity * 2 : 4; ");
    output = Concat(output, element_type);
    output = Concat(output, " *p = ("); output = Concat(output, element_type);
    output = Concat(output, " *)realloc(a->data, n * sizeof(");
    output = Concat(output, element_type);
    output = Concat(output, ")); if (p == NULL) abort(); a->data = p; a->capacity = n; }\n");
    output = Concat(output, "    a->data[a->length++] = (");
    output = Concat(output, element_type);
    return Concat(output, ")v;\n}\n\n");
}
func DirectMirScalarProgramCLocalArraySetMaterialization(
    ref plan: DirectMirScalarCfgGraphPlan,
    array_string_projection: Option<DirectMirArrayStringAbiProjection>,
    ref target: CompilerTargetProjectionFact
) -> String {
    let int_set: Bool = false; let string_set: Bool = false; let bool_set: Bool = false;
    let row: Int = 0;
    while row < ArrayLength(plan.operation_kinds) {
        if plan.operation_kinds[row] == DirectMirScalarCfgOpLocalArrayIntSet() ||
            plan.operation_kinds[row] ==
                DirectMirScalarCfgOpArrayIntValueResultSet() {
            int_set = true;
        }
        if plan.operation_kinds[row] == DirectMirScalarCfgOpArrayStringSet() { string_set = true; }
        let nested_type: String = DirectMirScalarProgramLogicalRecordArrayIndexedAssignmentElementType(plan, row);
        if nested_type == CompilerAbiLayoutIntTypeName() { int_set = true; }
        if nested_type == CompilerAbiLayoutStringTypeName() { string_set = true; }
        if plan.operation_kinds[row] == DirectMirScalarCfgOpArrayBoolSet() {
            bool_set = true;
        }
        row = row + 1;
    }
    if !int_set && !string_set && !bool_set { return ""; }
    let output: String = "#include \"pgy_runtime_panic_contract.h\"\n";
    if int_set {
        let abi: DirectMirArrayIntAbiProjection =
            DirectMirScalarProgramArrayIntValueResultTargetFromFact(
                plan.program.array_int_value_result, target);
        if !DirectMirArrayIntAbiProjectionReadyFor(
                abi, CompilerTargetCpuCProjection()) {
            Die("direct MIR C local Array<Int> set ABI is invalid");
        }
        output = Concat(output, CollectionRuntimeCGuardedSetWithLength(
            CollectionRuntimeCSetFn(1), abi.c_array_type,
            "long long", "length"));
    }
    if string_set {
        output = Concat(output,
            DirectMirScalarProgramCArrayStringSetMaterialization(
                plan.program.array_string_abi, array_string_projection));
    }
    if bool_set {
        output = Concat(output, CollectionRuntimeCGuardedSetWithLength(
            CollectionRuntimeCSetFn(4),
            CompilerAbiLayoutArrayBoolCValueType(), "bool", "length"));
    }
    return Concat(output, "\n");
}
func DirectMirScalarProgramCArrayMutation(
    ref plan: DirectMirScalarCfgGraphPlan,
    routine: Int, operation: Int, index: String, value: String
) -> String {
    let kind: Int = plan.operation_kinds[operation];
    let target_local: Int = plan.operation_left_locals[operation];
    let target_parameter: Int = plan.operation_right_locals[operation];
    if !DirectMirScalarProgramArrayMutationKind(kind) ||
        ((target_local < 0) == (target_parameter < 0)) { Die(
            "direct MIR C array mutation target is invalid"); }
    if target_parameter >= 0 {
        if target_local != -1 ||
            !DirectMirScalarProgramArrayMutationParameterTargetKind(kind) ||
            DirectMirScalarProgramLogicalRecordArrayMutationKind(kind) ||
            kind == DirectMirScalarCfgOpArrayStringValueResultPush() ||
            ((kind == DirectMirScalarCfgOpArrayIntPush() ||
              kind == DirectMirScalarCfgOpArrayIntValueResultSet() ||
              kind == DirectMirScalarCfgOpArrayIntPop()) &&
             !DirectMirScalarProgramArrayIntValueResultAt(
                plan.program.array_int_value_result, routine, target_parameter)) ||
            ((kind == DirectMirScalarCfgOpArrayBoolPush() ||
              kind == DirectMirScalarCfgOpArrayBoolSet()) &&
             !DirectMirScalarProgramArrayBoolValueResultAt(
                plan.program.array_bool_abi, routine, target_parameter)) { Die(
                    "direct MIR C array copyout mutation is invalid"); }
        if (kind == DirectMirScalarCfgOpArrayStringSet() ||
            kind == DirectMirScalarCfgOpArrayStringPop()) &&
            !DirectMirScalarProgramArrayStringParameterMutationReady(plan, routine, target_parameter, kind) { Die(
                "direct MIR C Array<String> copyout set is invalid"); }
    } else if target_parameter != -1 || target_local < 0 ||
        target_local >= ArrayLength(plan.local_types) ||
        !DirectMirScalarProgramLocalArrayMutationTargetTypeReady(
            kind, plan.local_types[target_local]) { Die(
                "direct MIR C local array mutation target is invalid"); }
    let symbol: String = "pgy_as_push"; let value_type: String = "const char *";
    let cast: String = "";
    if kind == DirectMirScalarCfgOpArrayIntPush() ||
        kind == DirectMirScalarCfgOpLocalArrayIntSet() ||
        kind == DirectMirScalarCfgOpArrayIntValueResultSet() {
        symbol = "pgy_ai_push"; value_type = "long long"; cast = "(long long)(";
    }
    if kind == DirectMirScalarCfgOpArrayBoolPush() {
        symbol = "pgy_ab_push"; value_type = "long long"; cast = "(long long)(";
    }
    let target_array: String = "";
    if target_local >= 0 {
        target_array = DirectMirScalarCfgCOperand(plan, -1, target_local, "");
    } else {
        target_array = Concat("pgy_param_", ToString(target_parameter));
    }
    if DirectMirScalarProgramArrayPopKind(kind) {
        let output: String = Concat("    if (", target_array);
        output = Concat(output, ".length > 0) { ");
        output = Concat(output, Concat(target_array, ".length = "));
        output = Concat(output, Concat(target_array, ".length - 1; }\n"));
        return output;
    }
    if DirectMirScalarProgramArrayPushKind(kind) {
        let output: String = Concat(
            "    ", Concat(symbol, Concat("(&", target_array))
        );
        output = Concat(output, ", "); output = Concat(output, cast);
        output = Concat(output, value);
        if cast != "" { output = Concat(output, ")"); }
        return Concat(output, ");\n");
    }
    if index == "" { Die("direct MIR C local array set index is invalid"); }
    symbol = CollectionRuntimeCSetFn(2);
    if kind == DirectMirScalarCfgOpLocalArrayIntSet() ||
        kind == DirectMirScalarCfgOpArrayIntValueResultSet() {
        symbol = CollectionRuntimeCSetFn(1);
    }
    if kind == DirectMirScalarCfgOpArrayBoolSet() {
        symbol = CollectionRuntimeCSetFn(4); value_type = "bool";
    }
    let stem: String = Concat("pgy_set_", ToString(operation));
    let output: String = Concat("    long long ", stem);
    output = Concat(output, "_index = (long long)(");
    output = Concat(output, Concat(index, ");\n    "));
    output = Concat(output, Concat(value_type, " "));
    output = Concat(output, Concat(stem, "_value = "));
    output = Concat(output, Concat(cast, value));
    if cast != "" { output = Concat(output, ")"); }
    output = Concat(output, ";\n    "); output = Concat(output, symbol);
    output = Concat(output, Concat("(&", Concat(target_array, ", ")));
    output = Concat(output, Concat(stem, "_index, "));
    output = Concat(output, Concat(stem, "_value);\n"));
    return output;
}
