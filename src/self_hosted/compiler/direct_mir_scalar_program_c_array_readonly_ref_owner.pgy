// C value/address projection for admitted read-only Int/String array parameters.

import "direct_mir_scalar_program_array_readonly_ref_target_owner.pgy";
import "direct_mir_scalar_program_expression_fact_owner.pgy";

func DirectMirScalarProgramCArrayReadonlyRefParameterValue(
    ref routines: DirectMirScalarCfgRoutinePartitionFact,
    routine: Int, ordinal: Int, value: String
) -> String {
    if !DirectMirScalarProgramArrayReadonlyRefAt(
            routines, routine, ordinal) {
        return value;
    }
    return Concat("(*", Concat(value, ")"));
}

func DirectMirScalarProgramCArrayReadonlyRefCallArgument(
    ref expressions: DirectMirScalarProgramExpressionSet,
    ref routines: DirectMirScalarCfgRoutinePartitionFact,
    routine: Int, target: Int, ordinal: Int,
    argument_node: Int, value: String
) -> String {
    if !DirectMirScalarProgramArrayReadonlyRefAt(
            routines, target, ordinal) {
        return "";
    }
    if expressions.node_kinds[argument_node] ==
            DirectMirScalarProgramExprLocal() {
        return Concat("&pgy_local_", ToString(
            expressions.node_local_rows[argument_node]));
    }
    if expressions.node_kinds[argument_node] !=
            DirectMirScalarProgramExprParameter() {
        if expressions.node_kinds[argument_node] == DirectMirScalarProgramExprLogicalRecordMember() {
            return Concat("&(", Concat(value, ")"));
        }
        return "";
    }
    let source: Int = expressions.node_parameter_ordinals[argument_node];
    if !DirectMirScalarProgramReadonlyArrayReborrowAt(
            routines, routine, source) {
        return "";
    }
    if !DirectMirScalarProgramArrayReadonlyRefAt(routines, routine, source) {
        return Concat("&pgy_param_", ToString(source));
    }
    return Concat("pgy_param_", ToString(source));
}
