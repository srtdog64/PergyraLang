// Target-projected C storage materialization for the private scalar-program
// Array<String> carrier. Public PgyArray_String naming remains a separate ABI.

import "direct_mir_scalar_program_array_string_abi_projection_owner.pgy";
import "direct_mir_scalar_cfg_array_c_materialization_owner.pgy";
import "../codegen/runtime_abi/collection_bounds_owner.pgy";
import "../codegen/runtime_abi/collection_runtime_owner.pgy";

func DirectMirScalarProgramCStringArrayOwnedSingleFn() -> String {
    return "pgy_as_owned_single";
}
func DirectMirScalarProgramCStringArrayValuesFn() -> String { return "pgy_as_from_values"; }

func DirectMirScalarProgramCStringArrayStorageBlock(
    ref abi: DirectMirScalarProgramArrayStringAbiFact,
    ref projection: DirectMirArrayStringAbiProjection
) -> String {
    if !DirectMirScalarProgramArrayStringAbiProjectionReadyForFact(
            abi, projection, CompilerTargetCpuCProjection()) {
        Die("direct MIR C Array<String> storage projection is invalid");
    }
    let type_name: String = DirectMirScalarProgramCArrayStringCarrierType(
        abi, projection);
    // This private read view keeps const-qualified elements; descriptor
    // order and every physical field still come from the admitted projection.
    let output: String = DirectMirScalarCfgArrayCStruct(
        Concat("const ", projection.c_element_type), type_name, projection.storage);
    let empty: String = DirectMirScalarCfgArrayCInitializer(
        projection.storage, "NULL", "0", "0", "NULL");
    output = Concat(output, Concat("static ", Concat(type_name, Concat(
        " pgy_as_new(void) { ", Concat(type_name, Concat(" a = ",
        Concat(empty, "; return a; }\n")))))));
    output = Concat(output,
        "static void pgy_as_push(pgy_as *a, const char *v) {\n    if (a->length == a->capacity) { size_t n = a->capacity ? a->capacity * 2 : 4; const char **p = (const char **)realloc(a->data, n * sizeof(const char *)); if (p == NULL) abort(); a->data = p; a->capacity = n; }\n    a->data[a->length++] = v;\n}\n");
    output = Concat(output, Concat("static void ", Concat(CollectionRuntimeCOwnedStringPushFn(), "(pgy_as *a, const char *v) { const char *source = v != NULL ? v : \"\"; size_t n = strlen(source); char *owned = (char *)malloc(n + 1); if (owned == NULL) abort(); memcpy(owned, source, n + 1); pgy_as_push(a, owned); }\n")));
    output = Concat(output, Concat("static pgy_as ", Concat(DirectMirScalarProgramCStringArrayValuesFn(), "(const char **v, size_t n) { pgy_as a = pgy_as_new(); for (size_t i = 0; i < n; i++) pgy_as_push(&a, v[i]); return a; }\n")));
    output = Concat(output, Concat("static pgy_as ", Concat(
        DirectMirScalarProgramCStringArrayOwnedSingleFn(), Concat(
        "(const char *v) { pgy_as a = pgy_as_new(); ", Concat(
        CollectionRuntimeCPushFn(2), "(&a, v); return a; }\n")))));
    output = Concat(output,
        "static long long pgy_as_len(pgy_as a) { return (long long)a.length; }\n#include \"pgy_runtime_panic_contract.h\"\n");
    // General expressions do not carry the legacy induction proof; every
    // indexed read retains the canonical runtime failure boundary.
    output = Concat(output, CollectionRuntimeCGuardedGetWithLength(
        "const char *", CollectionRuntimeCGetFn(2), type_name, "length"));
    output = Concat(output, Concat("static void ", Concat(
        CollectionRuntimeCOwnedStringDropFn(),
        "(pgy_as *a) { if (a == NULL) return; for (size_t i = 0; i < a->length; i++) free((void *)a->data[i]); free(a->data); a->data = NULL; a->length = 0; a->capacity = 0; }\n\n")));
    output = Concat(output, Concat("static void ", Concat(CollectionRuntimeCDropStorageFn(2), "(pgy_as *a) { if (a == NULL) return; free(a->data); a->data = NULL; a->length = 0; a->capacity = 0; }\n\n")));
    return output;
}
