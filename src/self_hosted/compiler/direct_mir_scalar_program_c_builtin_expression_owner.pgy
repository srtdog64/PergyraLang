import "direct_mir_scalar_program_c_string_expression_owner.pgy";
import "direct_mir_scalar_program_c_string_collection_expression_owner.pgy";
import "direct_mir_scalar_program_c_extended_expression_owner.pgy";
import "direct_mir_scalar_program_c_option_result_expression_owner.pgy";
import "direct_mir_scalar_program_c_aggregate_option_expression_owner.pgy";
import "direct_mir_scalar_program_c_set_string_expression_owner.pgy";
import "direct_mir_scalar_program_c_compiler_artifact_expression_owner.pgy";

func DirectMirScalarProgramCBuiltinExpression(
    kind: Int, result_type: String, left_type: String,
    left: String, right: String, arguments: Array<String>,
    owns_array_string_elements: Bool, expression_row: Int, callable_ordinal: Int,
    ref runtime: DirectMirScalarProgramRuntimeAbiProjection,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    ref referenced_enum: DirectMirScalarProgramReferencedEnumFact,
    ref array_string_abi: DirectMirScalarProgramArrayStringAbiFact,
    array_string_projection: Option<DirectMirArrayStringAbiProjection>
) -> Option<String> {
    let artifact: Option<String> =
        DirectMirScalarProgramCCompilerArtifactExpression(
            kind, left, right, runtime);
    if IsSome(artifact) { return artifact; }
    let aggregate_option: Option<String> =
        DirectMirScalarProgramCAggregateOptionExpression(
            logical_record, referenced_enum, kind,
            result_type, left_type, left);
    if IsSome(aggregate_option) { return aggregate_option; }
    let option_result: Option<String> =
        DirectMirScalarProgramCOptionResultExpression(
            kind, result_type, left_type, left, right, logical_record,
            referenced_enum);
    if IsSome(option_result) { return option_result; }
    let set_string: Option<String> =
        DirectMirScalarProgramCSetStringExpression(
            kind, left_type, left, right);
    if IsSome(set_string) { return set_string; }
    let extended: Option<String> = DirectMirScalarProgramCExtendedExpression(
        kind, left, right, arguments, owns_array_string_elements,
        expression_row, callable_ordinal, runtime, array_string_abi,
        array_string_projection);
    if IsSome(extended) { return extended; }
    let collection: Option<String> =
        DirectMirScalarProgramCStringCollectionExpression(
            kind, left_type, left, right, runtime, logical_record);
    if IsSome(collection) { return collection; }
    return DirectMirScalarProgramCStringExpression(
        kind, left, right, arguments, runtime);
}
