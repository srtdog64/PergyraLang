import "direct_mir_scalar_cfg_graph_fact_owner.pgy";
import "direct_mir_scalar_program_runtime_abi_projection_readiness_owner.pgy";
import "direct_mir_scalar_program_c_string_window_materialization_owner.pgy";
import "../codegen/runtime_abi/string_runtime_owner.pgy";

func DirectMirScalarProgramCBuiltinMaterialization(
    ref plan: DirectMirScalarCfgGraphPlan,
    ref runtime: DirectMirScalarProgramRuntimeAbiProjection
) -> String {
    let abi: DirectMirScalarProgramRuntimeAbiFact = plan.program.runtime_abi;
    let any_builtin: Bool = abi.string_to_string_id != 0 ||
        abi.string_to_upper_id != 0 || abi.string_to_lower_id != 0 ||
        abi.string_length_id != 0 || abi.string_substring_id != 0 ||
        abi.string_substring_with_len_id != 0;
    if !any_builtin { return ""; }
    if !DirectMirScalarProgramRuntimeAbiProjectionReady(runtime, abi) {
        Die("direct MIR scalar program C builtin ABI is invalid");
    }
    let output: String = "";
    if plan.string_concat_runtime_call_abi_id == 0 {
        output = "#include <stdlib.h>\n#include <string.h>\n\n";
    }
    if abi.string_to_string_id != 0 {
        output = Concat(output, StringRuntimeCToStringBlock());
    }
    if abi.string_to_upper_id != 0 {
        output = Concat(output, StringRuntimeCToUpperBlock());
    }
    if abi.string_to_lower_id != 0 {
        output = Concat(output, StringRuntimeCToLowerBlock());
    }
    output = Concat(output, DirectMirScalarProgramCStringWindowMaterialization(
        abi));
    return output;
}
