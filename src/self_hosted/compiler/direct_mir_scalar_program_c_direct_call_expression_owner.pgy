// C direct-call syntax from ordered GraphPlan argument values.

import "direct_mir_scalar_program_expression_kind_id_owner.pgy";
import "direct_mir_scalar_program_expression_fact_owner.pgy";
import "direct_mir_scalar_cfg_routine_partition_fact_owner.pgy";
import "direct_mir_scalar_program_c_logical_record_readonly_ref_owner.pgy";
import "direct_mir_scalar_program_c_array_readonly_ref_owner.pgy";
import "direct_mir_scalar_program_void_readonly_string_target_owner.pgy";
import "direct_mir_scalar_program_callable_parameter_policy_owner.pgy";

func DirectMirScalarProgramCDirectCallArgumentValue(
    ref expressions: DirectMirScalarProgramExpressionSet,
    ref routines: DirectMirScalarCfgRoutinePartitionFact,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    routine: Int, callable: Int, argument: Int,
    argument_node: Int, value: String
) -> String {
    if routine < 0 || routine >= ArrayLength(routines.roles) ||
        callable < 0 || callable >= ArrayLength(routines.roles) ||
        argument < 0 || argument >= routines.parameter_counts[callable] ||
        argument_node < 0 || argument_node >=
            ArrayLength(expressions.node_kinds) { Die(
                "direct MIR scalar C call argument identity is invalid"); }
    let parameter_row: Int = routines.parameter_starts[callable] + argument;
    let cell_carriage: String = DirectMirScalarProgramIdentityCellBorrowCarriage(
        logical_record.identity_cells, routines.parameter_types[parameter_row]);
    if cell_carriage != "" {
        if routines.parameter_carriages[parameter_row] != cell_carriage {
            Die("direct MIR identity cell C call carriage is invalid");
        }
        // The value already names cell storage, not an addressable record copy.
        return value;
    }
    if routines.parameter_carriages[parameter_row] == "value-result" {
        if expressions.node_kinds[argument_node] ==
                DirectMirScalarProgramExprLocal() {
            return Concat("&pgy_local_", ToString(
                expressions.node_local_rows[argument_node]));
        }
        if expressions.node_kinds[argument_node] ==
                DirectMirScalarProgramExprParameter() {
            return Concat("&pgy_param_", ToString(
                expressions.node_parameter_ordinals[argument_node]));
        }
        Die("direct MIR scalar C value-result argument is not addressable");
    }
    if DirectMirScalarProgramArrayReadonlyRefAt(
            routines, callable, argument) {
        let readonly_value: String =
            DirectMirScalarProgramCArrayReadonlyRefCallArgument(
                expressions, routines, routine, callable, argument,
                argument_node, value);
        if readonly_value == "" { Die(
            "direct MIR scalar C readonly array argument is invalid"); }
        return readonly_value;
    }
    if DirectMirScalarProgramVoidReadonlyStringTargetAt(
            routines, callable, argument) { return value; }
    return DirectMirScalarProgramCLogicalRecordCallArgument(
        routines, logical_record, callable, argument, value);
}

func DirectMirScalarProgramCDirectCallExpression(
    kind: Int, left: String, right: String,
    arguments: Array<String>, callable_ordinal: Int
) -> Option<String> {
    if kind != DirectMirScalarProgramExprDirectCall() { return None; }
    let values: Array<String> = arguments;
    if ArrayLength(values) == 0 {
        if left != "" { ArrayPush(values, left); }
        if right != "" { ArrayPush(values, right); }
    }
    if callable_ordinal < 0 { return None; }
    let output: String = Concat("pgy_scalar_routine_",
        Concat(ToString(callable_ordinal), "("));
    let ordinal: Int = 0;
    while ordinal < ArrayLength(values) {
        if ordinal > 0 { output = Concat(output, ", "); }
        output = Concat(output, values[ordinal]);
        ordinal = ordinal + 1;
    }
    return Some(Concat(output, ")"));
}
