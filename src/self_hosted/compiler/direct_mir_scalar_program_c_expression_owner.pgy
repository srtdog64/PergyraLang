import "direct_mir_scalar_program_expression_readiness_owner.pgy";
import "direct_mir_scalar_program_runtime_abi_projection_owner.pgy";
import "direct_mir_scalar_program_c_builtin_expression_owner.pgy";
func DirectMirScalarProgramCLocalName(row: Int) -> String {
    return Concat("pgy_local_", ToString(row));
}

func DirectMirScalarProgramCExpressionValues(
    ref expressions: DirectMirScalarProgramExpressionSet,
    expression_row: Int,
    ref runtime: DirectMirScalarProgramRuntimeAbiProjection
) -> Array<String> {
    let values: Array<String> = [];
    let start: Int = expressions.graph_starts[expression_row];
    let count: Int = expressions.graph_counts[expression_row];
    let node: Int = start;
    while node < start + count {
        let kind: Int = expressions.node_kinds[node];
        let left: String = "";
        let right: String = "";
        if expressions.node_lefts[node] >= start {
            left = values[expressions.node_lefts[node] - start];
        }
        if expressions.node_rights[node] >= start {
            right = values[expressions.node_rights[node] - start];
        }
        let arguments: Array<String> = [];
        let argument_rows: Array<Int> =
            DirectMirScalarProgramNaryOperandRows(
                expressions.nary_operands, node);
        let argument: Int = 0;
        while argument < ArrayLength(argument_rows) {
            if argument_rows[argument] < start ||
                argument_rows[argument] >= node {
                Die("direct MIR scalar C n-ary operand is invalid");
            }
            ArrayPush(arguments,
                values[argument_rows[argument] - start]);
            argument = argument + 1;
        }
        let value: String = "";
        if kind == DirectMirScalarProgramExprLocal() {
            value = DirectMirScalarProgramCLocalName(
                expressions.node_local_rows[node]
            );
        } else if kind == DirectMirScalarProgramExprParameter() {
            value = Concat("pgy_param_", ToString(
                expressions.node_parameter_ordinals[node]));
        } else if kind == DirectMirScalarProgramExprIntLiteral() {
            value = Concat(expressions.node_literals[node], "LL");
        } else if kind == DirectMirScalarProgramExprBoolLiteral() {
            value = expressions.node_literals[node];
        } else if kind == DirectMirScalarProgramExprStringLiteral() {
            value = Concat("\"", Concat(
                expressions.node_literals[node], "\""
            ));
        } else if kind == DirectMirScalarProgramExprModuloInt() {
            value = Concat("(", Concat(left, Concat(" % ", Concat(right, ")"))));
        } else if kind == DirectMirScalarProgramExprEqualInt() {
            value = Concat("(", Concat(left, Concat(" == ", Concat(right, ")"))));
        } else {
            let builtin_value: Option<String> =
                DirectMirScalarProgramCBuiltinExpression(
                    kind, left, right, arguments,
                    expressions.node_callable_rows[node], runtime);
            if IsSome(builtin_value) { value = UnwrapOption(builtin_value); }
            if value == "" {
            if kind == DirectMirScalarProgramExprLogicalNot() {
            value = Concat("(!", Concat(left, ")"));
            } else if kind == DirectMirScalarProgramExprLogicalAnd() {
            value = Concat("(", Concat(left, Concat(" && ", Concat(right, ")"))));
            } else if kind == DirectMirScalarProgramExprLogicalOr() {
            value = Concat("(", Concat(left, Concat(" || ", Concat(right, ")"))));
            } else if kind == DirectMirScalarProgramExprLessInt() {
            value = Concat("(", Concat(left, Concat(" < ", Concat(right, ")"))));
            } else if kind == DirectMirScalarProgramExprAddInt() {
            value = Concat("(", Concat(left, Concat(" + ", Concat(right, ")"))));
            } else if kind == DirectMirScalarProgramExprSubtractInt() {
            value = Concat("(", Concat(left, Concat(" - ", Concat(right, ")"))));
            } else if kind == DirectMirScalarProgramExprNegateInt() {
            value = Concat("(-", Concat(left, ")"));
            } else {
                Die("direct MIR scalar program C expression kind is unsupported");
            }
            }
        }
        ArrayPush(values, value);
        node = node + 1;
    }
    return values;
}

func DirectMirScalarProgramCExpressionAt(
    ref expressions: DirectMirScalarProgramExpressionSet,
    expression_row: Int,
    ref runtime: DirectMirScalarProgramRuntimeAbiProjection
) -> String {
    let values: Array<String> = DirectMirScalarProgramCExpressionValues(
        expressions, expression_row, runtime
    );
    let root: Int = expressions.graph_roots[expression_row] -
        expressions.graph_starts[expression_row];
    return values[root];
}
