// C declarations required by normalized external-runtime expressions.
import "direct_mir_scalar_program_expression_fact_owner.pgy";
import "direct_mir_scalar_program_task_builtin_owner.pgy";

func DirectMirScalarProgramCIntentObservabilityPreamble(
    ref expressions: DirectMirScalarProgramExpressionSet
) -> String {
    let node: Int = 0;
    while node < ArrayLength(expressions.node_kinds) {
        if expressions.node_kinds[node] ==
                DirectMirScalarProgramExprIntentObservabilityCall() {
            return "#define PGY_INTENT_OBSERVABILITY_ENABLED 1\n#include \"pgy_runtime.h\"\n";
        }
        node = node + 1;
    }
    return "";
}

func DirectMirScalarProgramCTaskObservationPreamble(
    ref expressions: DirectMirScalarProgramExpressionSet
) -> String {
    let node: Int = 0;
    while node < ArrayLength(expressions.node_kinds) {
        if expressions.node_kinds[node] ==
                DirectMirScalarProgramExprTaskIsCancelled() {
            return TaskRuntimeCDeclarationBlock();
        }
        node = node + 1;
    }
    return "";
}

func DirectMirScalarProgramCExternalRuntimePreamble(
    ref expressions: DirectMirScalarProgramExpressionSet
) -> String {
    return Concat(DirectMirScalarProgramCIntentObservabilityPreamble(expressions),
        DirectMirScalarProgramCTaskObservationPreamble(expressions));
}
