// Ordered C constructor operands and member reads over admitted record layout.
import "direct_mir_scalar_program_c_logical_record_owner.pgy";

func DirectMirScalarProgramCLogicalRecordExpression(
    ref fact: DirectMirScalarProgramLogicalRecordFact,
    kind: Int, record_type: String, left: String,
    arguments: Array<String>, argument_rows: Array<Int>, node: Int,
    member_ordinal: Int
) -> Option<String> {
    let row: Int = DirectMirScalarProgramLogicalRecordRow(
        fact, record_type);
    if kind == DirectMirScalarProgramExprLogicalRecordConstructor() {
        if row < 0 || ArrayLength(arguments) != fact.field_counts[row] ||
            ArrayLength(argument_rows) != ArrayLength(arguments) ||
            member_ordinal != -1 {
            return None;
        }
        // Operand rows retain expression order; field ordinals retain layout.
        // Sort only this constructor's operands, never a program inventory.
        let order: Array<Int> = [];
        let temporary: String = Concat("pgy_record_value_", ToString(node));
        let ordinal: Int = 0;
        while ordinal < ArrayLength(arguments) {
            if argument_rows[ordinal] < 0 || argument_rows[ordinal] >= node {
                return None;
            }
            ArrayPush(order, ordinal);
            let position: Int = ordinal;
            while position > 0 &&
                argument_rows[order[position - 1]] > argument_rows[ordinal] {
                order[position] = order[position - 1];
                position = position - 1;
            }
            order[position] = ordinal;
            ordinal = ordinal + 1;
        }
        ordinal = 0;
        while ordinal < ArrayLength(arguments) {
            if StringIndexOf(arguments[ordinal], temporary) >= 0 {
                temporary = Concat(temporary, "_");
                ordinal = 0;
            } else { ordinal = ordinal + 1; }
        }
        let output: String = Concat("({ ", Concat(
            DirectMirScalarProgramCLogicalRecordTypeName(fact, record_type),
            Concat(" ", Concat(temporary, " = {0}; "))));
        let position: Int = 0;
        while position < ArrayLength(order) {
            ordinal = order[position];
            output = Concat(output, Concat(temporary,
                Concat(".field_", ToString(ordinal))));
            output = Concat(output, Concat(" = (",
                Concat(arguments[ordinal], "); ")));
            position = position + 1;
        }
        return Some(Concat(output, Concat(temporary, "; })")));
    }
    if kind != DirectMirScalarProgramExprLogicalRecordMember() || row < 0 ||
        left == "" || member_ordinal < 0 ||
        member_ordinal >= fact.field_counts[row] ||
        ArrayLength(arguments) != 0 {
        return None;
    }
    let member: String = Concat("(", Concat(left, Concat(").field_",
        ToString(member_ordinal))));
    if DirectMirScalarProgramLogicalRecordPhysicalIntField(
            fact, record_type, member_ordinal) {
        member = Concat("((int64_t)(", Concat(member, "))"));
    }
    return Some(member);
}
