// C representation and expressions for ABI-free Option<logical-record> values.

import "direct_mir_scalar_program_logical_record_option_expression_kind_owner.pgy";
import "direct_mir_scalar_program_c_logical_record_owner.pgy";
import "target_projection_fact_owner.pgy";

func DirectMirScalarProgramCLogicalRecordOptionTypeName(
    ref fact: DirectMirScalarProgramLogicalRecordFact,
    option_type: String
) -> String {
    let payload: String =
        DirectMirScalarProgramLogicalRecordOptionPayloadType(
            fact, option_type);
    let row: Int = DirectMirScalarProgramLogicalRecordRow(fact, payload);
    if row < 0 { return ""; }
    return Concat("pgy_scalar_option_logical_record_", ToString(row));
}

func DirectMirScalarProgramCLogicalRecordOptionExpression(
    ref fact: DirectMirScalarProgramLogicalRecordFact,
    kind: Int, result_type: String, left_type: String, left: String
) -> Option<String> {
    let option_type: String = result_type;
    if kind == DirectMirScalarProgramExprIsSomeLogicalRecord() ||
        kind == DirectMirScalarProgramExprUnwrapOptionLogicalRecord() {
        option_type = left_type;
    }
    let t: String = DirectMirScalarProgramCLogicalRecordOptionTypeName(
        fact, option_type);
    if t == "" { return None; }
    if kind == DirectMirScalarProgramExprSomeLogicalRecord() {
        return Some(Concat(t, Concat("_some(", Concat(left, ")"))));
    }
    if kind == DirectMirScalarProgramExprNoneLogicalRecord() {
        return Some(Concat(t, "_none()"));
    }
    if kind == DirectMirScalarProgramExprIsSomeLogicalRecord() {
        return Some(Concat(t, Concat("_is_some(", Concat(left, ")"))));
    }
    if kind == DirectMirScalarProgramExprUnwrapOptionLogicalRecord() {
        return Some(Concat(t, Concat("_unwrap(", Concat(left, ")"))));
    }
    return None;
}

func DirectMirScalarProgramCLogicalRecordOptionPreamble(
    ref fact: DirectMirScalarProgramLogicalRecordFact,
    ref target: CompilerTargetProjectionFact
) -> String {
    if !DirectMirScalarProgramLogicalRecordFactReady(fact) ||
        !CompilerTargetProjectionFactReadyFor(
            target, CompilerTargetCpuCProjection()) {
        Die("direct MIR logical-record Option C fact is invalid");
    }
    let output: String = "";
    let row: Int = 0;
    while row < ArrayLength(fact.names) {
        let option_type: String = Concat(
            "Option<", Concat(fact.names[row], ">"));
        let t: String = DirectMirScalarProgramCLogicalRecordOptionTypeName(
            fact, option_type);
        let payload: String = DirectMirScalarProgramCLogicalRecordTypeName(
            fact, fact.names[row]);
        output = Concat(output, Concat("typedef struct { bool is_some; ",
            Concat(payload, Concat(" value; } ", Concat(t, ";\n")))));
        output = Concat(output, "static "); output = Concat(output, t);
        output = Concat(output, Concat(" ", Concat(t, "_some(")));
        output = Concat(output, Concat(payload, Concat(" value) { ", t)));
        output = Concat(output,
            " out = {true, value}; return out; }\n");
        output = Concat(output, "static "); output = Concat(output, t);
        output = Concat(output, Concat(" ", Concat(t, "_none(void) { ")));
        output = Concat(output, Concat(t,
            " out = {0}; return out; }\n"));
        output = Concat(output, Concat("static bool ", t));
        output = Concat(output, Concat("_is_some(", Concat(t,
            " value) { return value.is_some; }\n")));
        output = Concat(output, Concat("static ", payload));
        output = Concat(output, Concat(" ", Concat(t, "_unwrap(")));
        output = Concat(output, Concat(t,
            " value) { if (!value.is_some) abort(); return value.value; }\n"));
        row = row + 1;
    }
    return output;
}
