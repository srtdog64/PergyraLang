// C representation and expression projection for logical record identities.

import "direct_mir_scalar_program_logical_record_target_owner.pgy";
import "direct_mir_scalar_program_logical_record_payload_free_enum_join_owner.pgy";
import "direct_mir_scalar_program_c_option_int_owner.pgy";
func DirectMirScalarProgramCLogicalRecordTypeName(
    ref fact: DirectMirScalarProgramLogicalRecordFact, type_name: String
) -> String {
    let row: Int = DirectMirScalarProgramLogicalRecordRow(fact, type_name);
    if row < 0 { return ""; }
    return Concat("pgy_scalar_logical_record_value_", ToString(row));
}

func DirectMirScalarProgramCLogicalRecordFieldType(
    ref fact: DirectMirScalarProgramLogicalRecordFact, type_name: String
) -> String {
    if type_name == CompilerAbiLayoutBoolTypeName() { return "bool"; }
    if type_name == CompilerAbiLayoutIntTypeName() { return "int64_t"; }
    if type_name == CompilerAbiLayoutStringTypeName() { return CompilerAbiLayoutStringCValueType(); }
    if type_name == CompilerAbiLayoutOptionIntTypeName() { return DirectMirScalarProgramCOptionIntTypeName(); }
    if type_name == CompilerAbiLayoutArrayIntTypeName() { return CompilerAbiLayoutArrayIntCValueType(); }
    if type_name == CompilerAbiLayoutArrayBoolTypeName() { return CompilerAbiLayoutArrayBoolCValueType(); }
    if type_name == CompilerAbiLayoutArrayStringTypeName() { return CompilerAbiLayoutArrayStringCValueType(); }
    if DirectMirScalarProgramLogicalRecordPayloadFreeEnumFieldTypeReady(fact, type_name) { return CompilerAbiLayoutPayloadFreeEnumCValueType(); }
    return DirectMirScalarProgramCLogicalRecordTypeName(fact, type_name);
}

// Assert the admitted receipt against this C toolchain; never infer a missing row.
func DirectMirScalarProgramCLogicalRecordReceiptAssertions(
    ref fact: DirectMirScalarProgramLogicalRecordFact, row: Int
) -> String {
    if fact.physical.layout_ids[row] == 0 { return ""; }
    let type_name: String = DirectMirScalarProgramCLogicalRecordTypeName(fact, fact.names[row]);
    let output: String = Concat("#include <stddef.h>\n_Static_assert(sizeof(", type_name);
    output = Concat(output, Concat(") == ", ToString(fact.physical.sizes[row])));
    output = Concat(output, ", \"record size receipt\");\n_Static_assert(_Alignof(");
    output = Concat(output, Concat(type_name, ") == "));
    output = Concat(output, ToString(fact.physical.aligns[row]));
    output = Concat(output, ", \"record alignment receipt\");\n");
    let ordinal: Int = 0;
    while ordinal < fact.field_counts[row] {
        let field: Int = fact.field_starts[row] + ordinal;
        let member: String = Concat("field_", ToString(ordinal));
        output = Concat(output, Concat("_Static_assert(offsetof(", type_name));
        output = Concat(output, Concat(", ", Concat(member, ") == ")));
        output = Concat(output, ToString(fact.physical.field_offsets[field]));
        output = Concat(output, ", \"record field offset receipt\");\n_Static_assert(sizeof(((");
        output = Concat(output, Concat(type_name, "*)0)->"));
        output = Concat(output, Concat(member, ") == "));
        output = Concat(output, ToString(fact.physical.field_sizes[field]));
        output = Concat(output, ", \"record field size receipt\");\n");
        ordinal = ordinal + 1;
    }
    return output;
}

func DirectMirScalarProgramCLogicalRecordPreamble(
    ref fact: DirectMirScalarProgramLogicalRecordFact,
    ref target: CompilerTargetProjectionFact
) -> String {
    if !DirectMirScalarProgramLogicalRecordFactReady(fact) {
        Die("direct MIR logical record C fact is invalid");
    }
    let output: String = "";
    let row: Int = 0;
    while row < ArrayLength(fact.names) {
        let projection: DirectMirScalarProgramLogicalRecordTarget =
            DirectMirScalarProgramLogicalRecordTargetFromFact(
                fact, fact.names[row], target);
        if !DirectMirScalarProgramLogicalRecordTargetReadyFor(
                projection, CompilerTargetCpuCProjection()) {
            Die("direct MIR logical record C target is invalid");
        }
        output = Concat(output, "#include <stdint.h>\ntypedef struct {");
        let ordinal: Int = 0;
        while ordinal < fact.field_counts[row] {
            let field_type: String =
                DirectMirScalarProgramCLogicalRecordFieldType(
                    fact,
                    DirectMirScalarProgramLogicalRecordFieldType(
                        fact, fact.names[row], ordinal));
            if DirectMirScalarProgramLogicalRecordPhysicalIntField(
                    fact, fact.names[row], ordinal) { field_type = "int32_t"; }
            if field_type == "" {
                Die("direct MIR logical record C field type is invalid");
            }
            output = Concat(output, Concat(" ", field_type));
            output = Concat(output, Concat(
                " field_", Concat(ToString(ordinal), ";")));
            ordinal = ordinal + 1;
        }
        output = Concat(output, Concat(
            " } ", Concat(projection.c_type_name, ";\n")));
        output = Concat(output, DirectMirScalarProgramCLogicalRecordReceiptAssertions(fact, row));
        row = row + 1;
    }
    return output;
}
