// C value projection for the admitted Int/Long numeric cast identities.

import "direct_mir_scalar_program_expression_kind_id_owner.pgy";
import "abi_layout_row_owner.pgy";

func DirectMirScalarProgramCNumericCastExpressionValue(
    kind: Int, left: String
) -> Option<String> {
    if kind == DirectMirScalarProgramExprTypeNameLong() { return Some(""); }
    if kind == DirectMirScalarProgramExprTypeNameInt() { return Some(""); }
    if kind == DirectMirScalarProgramExprCastIntToLong() {
        return Some(Concat("((", Concat(CompilerAbiLayoutLongCValueType(),
            Concat(")(", Concat(left, "))")))));
    }
    if kind == DirectMirScalarProgramExprCastLongToInt() {
        return Some(Concat("((", Concat(CompilerAbiLayoutIntCValueType(),
            Concat(")(", Concat(left, "))")))));
    }
    return None;
}
