// C representation and expression projection from the admitted Option<String> ABI.

import "direct_mir_scalar_program_option_string_expression_kind_owner.pgy";
import "direct_mir_scalar_program_option_string_abi_owner.pgy";
import "target_projection_fact_owner.pgy";

func DirectMirScalarProgramCOptionStringTypeName() -> String {
    return "pgy_scalar_option_string";
}

func DirectMirScalarProgramCOptionStringExpression(
    kind: Int, left: String
) -> Option<String> {
    if kind == DirectMirScalarProgramExprSomeString() {
        return Some(Concat(
            "pgy_scalar_option_string_some(", Concat(left, ")")));
    }
    if kind == DirectMirScalarProgramExprNoneString() {
        return Some("pgy_scalar_option_string_none()");
    }
    if kind == DirectMirScalarProgramExprIsSomeString() {
        return Some(Concat(
            "pgy_scalar_option_string_is_some(", Concat(left, ")")));
    }
    if kind == DirectMirScalarProgramExprUnwrapOptionString() {
        return Some(Concat(
            "pgy_scalar_option_string_unwrap(", Concat(left, ")")));
    }
    return None;
}

func DirectMirScalarProgramCOptionStringPreamble(
    ref fact: DirectMirOptionMatchAbiFact,
    ref target: CompilerTargetProjectionFact
) -> String {
    if DirectMirScalarProgramOptionStringAbiCanonicalEmpty(fact) { return ""; }
    if !DirectMirOptionStringAbiFactReady(fact) ||
        !CompilerTargetProjectionFactReadyFor(
            target, CompilerTargetCpuCProjection()) {
        Die("direct MIR scalar program C Option<String> ABI is invalid");
    }
    let t: String = DirectMirScalarProgramCOptionStringTypeName();
    let output: String = "#include <stddef.h>\n#include <stdint.h>\n#include <stdlib.h>\n";
    output = Concat(output, "typedef struct { int32_t ");
    output = Concat(output, fact.tag_name);
    output = Concat(output, "; char *");
    output = Concat(output, fact.value_name);
    output = Concat(output, "; } ");
    output = Concat(output, t);
    output = Concat(output, ";\n");
    output = Concat(output, "_Static_assert(sizeof(");
    output = Concat(output, t);
    output = Concat(output, ") == ");
    output = Concat(output, ToString(fact.size));
    output = Concat(output, ", \"Option<String> size\");\n");
    output = Concat(output, "_Static_assert(_Alignof(");
    output = Concat(output, t);
    output = Concat(output, ") == ");
    output = Concat(output, ToString(fact.align));
    output = Concat(output, ", \"Option<String> align\");\n");
    output = Concat(output, "_Static_assert(offsetof(");
    output = Concat(output, t);
    output = Concat(output, ", ");
    output = Concat(output, fact.value_name);
    output = Concat(output, ") == ");
    output = Concat(output, ToString(fact.value_offset));
    output = Concat(output, ", \"Option<String> value offset\");\n");
    output = Concat(output, "static ");
    output = Concat(output, t);
    output = Concat(output,
        " pgy_scalar_option_string_some(const char *value) {\n    ");
    output = Concat(output, t);
    output = Concat(output, " result = {");
    output = Concat(output, fact.some_tag);
    output = Concat(output,
        ", (char *)value};\n    return result;\n}\n");
    output = Concat(output, "static ");
    output = Concat(output, t);
    output = Concat(output,
        " pgy_scalar_option_string_none(void) {\n    ");
    output = Concat(output, t);
    output = Concat(output, " result = {");
    output = Concat(output, fact.none_tag);
    output = Concat(output, ", NULL};\n    return result;\n}\n");
    output = Concat(output,
        "static bool pgy_scalar_option_string_is_some(");
    output = Concat(output, t);
    output = Concat(output, " value) { return value.");
    output = Concat(output, fact.tag_name);
    output = Concat(output, " == ");
    output = Concat(output, fact.some_tag);
    output = Concat(output, "; }\n");
    output = Concat(output,
        "static const char *pgy_scalar_option_string_unwrap(");
    output = Concat(output, t);
    output = Concat(output, " value) {\n    if (value.");
    output = Concat(output, fact.tag_name);
    output = Concat(output, " != ");
    output = Concat(output, fact.some_tag);
    output = Concat(output,
        ") { abort(); }\n    return value.");
    output = Concat(output, fact.value_name);
    output = Concat(output, ";\n}\n");
    return output;
}
