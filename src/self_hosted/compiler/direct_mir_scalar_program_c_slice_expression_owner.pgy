// C projection for Slice expressions already sealed in the GraphPlan.

import "direct_mir_scalar_program_expression_fact_owner.pgy";
import "../codegen/runtime_abi/slice_runtime_owner.pgy";

func DirectMirScalarProgramCSliceRuntimeFact(
    slice_type: String
) -> SliceRuntimeFact {
    let is_string: Bool = slice_type == CompilerAbiLayoutSliceStringTypeName();
    if !is_string && slice_type != CompilerAbiLayoutSliceIntTypeName() {
        return SliceRuntimeMissingFact();
    }
    let element: String = "Int";
    let array_type: String = CompilerAbiLayoutArrayIntTypeName();
    let c_slice_type: String = CompilerAbiLayoutSliceIntCValueType();
    let c_array_type: String = CompilerAbiLayoutArrayIntCValueType();
    let c_element_type: String = "int32_t";
    let kind_code: Int = CollectionRuntimeKindCode("ArrayInt");
    let push: String = CollectionRuntimeCPushFn(kind_code);
    if is_string {
        element = "String";
        array_type = CompilerAbiLayoutArrayStringTypeName();
        c_slice_type = CompilerAbiLayoutSliceStringCValueType();
        c_array_type = CompilerAbiLayoutArrayStringCValueType();
        c_element_type = "const char *";
        kind_code = CollectionRuntimeKindCode("ArrayString");
        push = CollectionRuntimeCOwnedStringPushFn();
    }
    return SliceRuntimeFact(
        true, slice_type, array_type, element,
        c_slice_type,
        c_array_type, c_element_type,
        Concat("pgy_array_slice_", element),
        Concat("pgy_slice_copy_", element),
        Concat("pgy_slice_get_", element),
        CollectionRuntimeCNewFn(kind_code), push
    );
}

// The direct-MIR carrier is the admitted four-field public ABI projection,
// not the three-field collection runtime used to build the self-host binary.
// Clone therefore owns a distinct materialization instead of pretending the
// source Array is a Slice and accidentally reopening the other layout.
func DirectMirScalarProgramCArrayCloneBlock(
    fact: SliceRuntimeFact
) -> String {
    if !fact.ok || (fact.element_type != "Int" &&
            fact.element_type != "String") {
        Die("direct MIR C Array Clone runtime fact is invalid");
    }
    let clone_fn: String = CollectionRuntimeCCloneFn(
        CollectionRuntimeKindCode(Concat("Array", fact.element_type))
    );
    let output: String = "static ${fact.c_array_type} ${clone_fn}(${fact.c_array_type} *array) {\n"
        + "    if (array == NULL) { PGY_RUNTIME_PANIC(PGY_RUNTIME_PANIC_CLASS_INTERNAL_INVARIANT, \"array clone on null array\"); }\n"
        + "    if (array->length > 0 && array->data == NULL) { PGY_RUNTIME_PANIC(PGY_RUNTIME_PANIC_CLASS_INTERNAL_INVARIANT, \"array clone on array without backing storage\"); }\n";
    if fact.element_type == "String" {
        return output
            + "    ${fact.c_array_type} out = ${fact.c_array_new_fn}();\n"
            + "    for (size_t i = 0; i < array->length; i++) { ${fact.c_array_push_fn}(&out, array->data[i]); }\n"
            + "    return out;\n}\n\n";
    }
    return output
        + "    ${fact.c_array_type} out = {NULL, 0, 0, NULL};\n"
        + "    if (array->length == 0) { return out; }\n"
        + "    if (array->length > (size_t)-1 / sizeof(${fact.c_element_type})) { PGY_RUNTIME_PANIC(PGY_RUNTIME_PANIC_CLASS_OOM, PGY_RUNTIME_PANIC_REASON_ALLOCATION_FAILED); }\n"
        + "    out.data = (${fact.c_element_type} *)malloc(array->length * sizeof(${fact.c_element_type}));\n"
        + "    if (out.data == NULL) { PGY_RUNTIME_PANIC(PGY_RUNTIME_PANIC_CLASS_OOM, PGY_RUNTIME_PANIC_REASON_ALLOCATION_FAILED); }\n"
        + "    out.length = array->length; out.capacity = array->length; out.allocator = NULL;\n"
        + "    for (size_t i = 0; i < array->length; i++) { out.data[i] = array->data[i]; }\n"
        + "    return out;\n}\n\n";
}

func DirectMirScalarProgramCSliceExpression(
    kind: Int, result_type: String, left_type: String,
    left: String, right: String, arguments: Array<String>
) -> Option<String> {
    if kind != DirectMirScalarProgramExprArraySlice() &&
        kind != DirectMirScalarProgramExprSliceCopy() &&
        kind != DirectMirScalarProgramExprArrayClone() &&
        kind != DirectMirScalarProgramExprSliceIntIndex() &&
        kind != DirectMirScalarProgramExprSliceStringIndex() { return None; }
    let slice_type: String = result_type;
    if kind != DirectMirScalarProgramExprArraySlice() { slice_type = left_type; }
    if kind == DirectMirScalarProgramExprArrayClone() {
        if left_type == CompilerAbiLayoutArrayIntTypeName() {
            slice_type = CompilerAbiLayoutSliceIntTypeName();
        } else if left_type == CompilerAbiLayoutArrayStringTypeName() {
            slice_type = CompilerAbiLayoutSliceStringTypeName();
        }
    }
    let fact: SliceRuntimeFact =
        DirectMirScalarProgramCSliceRuntimeFact(slice_type);
    if !fact.ok { Die("direct MIR C Slice expression type is invalid"); }
    if kind == DirectMirScalarProgramExprArraySlice() {
        if ArrayLength(arguments) != 3 {
            Die("direct MIR C Array.Slice operands are invalid");
        }
        // Every receiver is evaluated once into an addressable carrier.  This
        // is required for function-return arrays as well as ordinary locals.
        return Some("({ ${fact.c_array_type} __pgy_slice_receiver = "
            + arguments[0] + "; long long __pgy_slice_start = (long long)("
            + arguments[1] + "); long long __pgy_slice_length = (long long)("
            + arguments[2] + "); " + fact.c_array_slice_fn
            + "(&__pgy_slice_receiver, __pgy_slice_start, __pgy_slice_length); })");
    }
    if kind == DirectMirScalarProgramExprSliceCopy() {
        if left == "" || right != "" || ArrayLength(arguments) != 0 {
            Die("direct MIR C SliceCopy operands are invalid");
        }
        return Some("({ ${fact.c_slice_type} __pgy_slice_copy = " + left
            + "; " + fact.c_slice_copy_fn + "(&__pgy_slice_copy); })");
    }
    if kind == DirectMirScalarProgramExprArrayClone() {
        if left == "" || right != "" || ArrayLength(arguments) != 0 ||
            result_type != fact.array_type || left_type != fact.array_type {
            Die("direct MIR C Array Clone operands are invalid");
        }
        let clone_fn: String = CollectionRuntimeCCloneFn(
            CollectionRuntimeKindCode(Concat("Array", fact.element_type))
        );
        return Some("({ ${fact.c_array_type} __pgy_clone_source = ${left}; "
            + "${clone_fn}(&__pgy_clone_source); })");
    }
    if left == "" || right == "" || ArrayLength(arguments) != 0 {
        Die("direct MIR C Slice index operands are invalid");
    }
    return Some("({ ${fact.c_slice_type} __pgy_slice_get = " + left
        + "; long long __pgy_slice_index = (long long)(" + right + "); "
        + fact.c_slice_get_fn + "(&__pgy_slice_get, __pgy_slice_index); })");
}

func DirectMirScalarProgramCSlicePreamble(
    ref expressions: DirectMirScalarProgramExpressionSet
) -> String {
    let int_reached: Bool = false;
    let string_reached: Bool = false;
    let int_clone_reached: Bool = false;
    let string_clone_reached: Bool = false;
    let row: Int = 0;
    while row < ArrayLength(expressions.node_kinds) {
        let kind: Int = expressions.node_kinds[row];
        if kind == DirectMirScalarProgramExprArrayClone() {
            if expressions.node_lefts[row] < 0 {
                Die("direct MIR C Array Clone source is missing");
            }
            let clone_type: String =
                expressions.node_types[expressions.node_lefts[row]];
            if clone_type == CompilerAbiLayoutArrayIntTypeName() {
                int_clone_reached = true;
            } else if clone_type == CompilerAbiLayoutArrayStringTypeName() {
                string_clone_reached = true;
            } else {
                Die("direct MIR C Array Clone preamble type is invalid");
            }
        }
        if kind == DirectMirScalarProgramExprArraySlice() ||
            kind == DirectMirScalarProgramExprSliceCopy() ||
            kind == DirectMirScalarProgramExprSliceIntIndex() ||
            kind == DirectMirScalarProgramExprSliceStringIndex() {
            let type_name: String = expressions.node_types[row];
            if kind != DirectMirScalarProgramExprArraySlice() &&
                expressions.node_lefts[row] >= 0 {
                type_name = expressions.node_types[expressions.node_lefts[row]];
            }
            if type_name == CompilerAbiLayoutSliceIntTypeName() {
                int_reached = true;
            } else if type_name == CompilerAbiLayoutSliceStringTypeName() {
                string_reached = true;
            } else { Die("direct MIR C Slice preamble type is invalid"); }
        }
        row = row + 1;
    }
    if !int_reached && !string_reached &&
        !int_clone_reached && !string_clone_reached { return ""; }
    let output: String = "#include \"pgy_runtime_panic_contract.h\"\n";
    if int_reached {
        let fact: SliceRuntimeFact = DirectMirScalarProgramCSliceRuntimeFact(
            CompilerAbiLayoutSliceIntTypeName());
        output = output + SliceRuntimeCBlockForFact(
            fact, "length", "(pgy_ai){NULL, 0, 0, NULL}");
    }
    if string_reached {
        let fact: SliceRuntimeFact = DirectMirScalarProgramCSliceRuntimeFact(
            CompilerAbiLayoutSliceStringTypeName());
        output = output + SliceRuntimeCBlockForFact(
            fact, "length", "(pgy_as){NULL, 0, 0, NULL}");
    }
    if int_clone_reached {
        output = output + DirectMirScalarProgramCArrayCloneBlock(
            DirectMirScalarProgramCSliceRuntimeFact(
                CompilerAbiLayoutSliceIntTypeName()));
    }
    if string_clone_reached {
        output = output + DirectMirScalarProgramCArrayCloneBlock(
            DirectMirScalarProgramCSliceRuntimeFact(
                CompilerAbiLayoutSliceStringTypeName()));
    }
    return output;
}
