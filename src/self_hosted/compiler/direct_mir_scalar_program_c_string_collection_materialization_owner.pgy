// C runtime materialization for the sealed String/Array<String> ABI receipt.

import "direct_mir_scalar_cfg_graph_fact_owner.pgy";
import "direct_mir_scalar_program_runtime_abi_projection_readiness_owner.pgy";
import "../codegen/runtime_abi/collection_runtime_owner.pgy";
import "../codegen/runtime_abi/string_runtime_owner.pgy";

func DirectMirScalarProgramCStringArrayStorageBlock(
    ref abi: DirectMirScalarProgramArrayStringAbiFact
) -> String {
    if !DirectMirScalarProgramArrayStringAbiFactReady(abi) { return ""; }
    let type_name: String = CompilerAbiLayoutArrayStringCValueType();
    let output: String = Concat(
        "typedef struct { const char **data; size_t length; size_t capacity; void *allocator; } ",
        Concat(type_name, ";\n"));
    output = Concat(output, Concat("_Static_assert(sizeof(pgy_as) == ",
        Concat(ToString(abi.size), ", \"Array<String> size\");\n")));
    output = Concat(output, Concat("_Static_assert(_Alignof(pgy_as) == ",
        Concat(ToString(abi.align), ", \"Array<String> align\");\n")));
    output = Concat(output, Concat("_Static_assert(offsetof(pgy_as, data) == ",
        Concat(ToString(abi.data_offset), ", \"Array<String> data\");\n")));
    output = Concat(output, Concat("_Static_assert(offsetof(pgy_as, length) == ",
        Concat(ToString(abi.length_offset), ", \"Array<String> length\");\n")));
    output = Concat(output, Concat("_Static_assert(offsetof(pgy_as, capacity) == ",
        Concat(ToString(abi.capacity_offset), ", \"Array<String> capacity\");\n")));
    output = Concat(output, Concat("_Static_assert(offsetof(pgy_as, allocator) == ",
        Concat(ToString(abi.allocator_offset), ", \"Array<String> allocator\");\n\n")));
    output = Concat(output,
        "static pgy_as pgy_as_new(void) { pgy_as a = {NULL, 0, 0, NULL}; return a; }\n");
    output = Concat(output,
        "static void pgy_as_push(pgy_as *a, const char *v) {\n");
    output = Concat(output,
        "    if (a->length == a->capacity) { size_t n = a->capacity ? a->capacity * 2 : 4; const char **p = (const char **)realloc(a->data, n * sizeof(const char *)); if (p == NULL) abort(); a->data = p; a->capacity = n; }\n");
    output = Concat(output, "    a->data[a->length++] = v;\n}\n");
    output = Concat(output,
        "static long long pgy_as_len(pgy_as a) { return (long long)a.length; }\n");
    output = Concat(output,
        "static const char *pgy_as_get(pgy_as a, long long i) { return a.data[(size_t)i]; }\n");
    output = Concat(output,
        "static void pgy_as_drop(pgy_as *a) { if (a == NULL) return; for (size_t i = 0; i < a->length; i++) free((void *)a->data[i]); free(a->data); a->data = NULL; a->length = 0; a->capacity = 0; }\n\n");
    return output;
}

func DirectMirScalarProgramCStringCollectionMaterialization(
    ref plan: DirectMirScalarCfgGraphPlan,
    ref runtime: DirectMirScalarProgramRuntimeAbiProjection
) -> String {
    let any: Bool = plan.program.runtime_abi.string_contains_id != 0 ||
        plan.program.runtime_abi.string_split_id != 0 ||
        plan.program.runtime_abi.string_to_int_id != 0 ||
        plan.program.runtime_abi.array_string_length_id != 0 ||
        plan.program.runtime_abi.array_string_get_id != 0;
    if !any { return ""; }
    if !DirectMirScalarProgramRuntimeAbiProjectionReady(
            runtime, plan.program.runtime_abi) ||
        !DirectMirScalarProgramArrayStringAbiReadyForExpressions(
            plan.program.array_string_abi, plan.program.expressions) {
        Die("direct MIR scalar program C String collection ABI is invalid");
    }
    let output: String = "#include <stddef.h>\n#include <stdlib.h>\n#include <string.h>\n\n";
    if DirectMirScalarProgramArrayStringAbiRequired(plan.program.expressions) {
        output = Concat(output, DirectMirScalarProgramCStringArrayStorageBlock(
            plan.program.array_string_abi));
    }
    if plan.program.runtime_abi.string_contains_id != 0 {
        output = Concat(output, StringRuntimeCStringContainsBlock());
    }
    if plan.program.runtime_abi.string_to_int_id != 0 {
        output = Concat(output, StringRuntimeCToIntBlock());
    }
    if plan.program.runtime_abi.string_split_id != 0 {
        output = Concat(output, StringRuntimeCSplitBlock());
    }
    return output;
}
