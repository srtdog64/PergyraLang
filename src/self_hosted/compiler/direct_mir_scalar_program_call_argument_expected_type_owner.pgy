// Contextual argument type lookup sealed by the carried callee identity.

import "direct_mir_scalar_program_callable_inventory_owner.pgy";
import "direct_mir_scalar_program_callable_parameter_identity_owner.pgy";
import "direct_mir_scalar_program_declared_call_callee_identity_owner.pgy";
import "direct_mir_scalar_program_logical_record_fact_owner.pgy";
import "../semantic/array_type_shape_owner.pgy";

func DirectMirScalarProgramDirectCallArgumentExpectedType(ref sequence:
    MirExpressionGraphSequence, argument_root: Int,
    ref callables: DirectMirScalarCfgProgramCallableInventory,
    ref signature: DirectMirRoutineSignatureFact,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact
) -> String {
    let node_count: Int = ArrayLength(sequence.arena.topology.node_kinds);
    var cursor: Int = argument_root + 1; var argument_ordinal: Int = 0;
    if argument_root < 0 || cursor >= node_count ||
        sequence.arena.topology.node_kinds[cursor] != AstExpressionNodeCallArgument() ||
        sequence.arena.topology.right_children[cursor] != argument_root { return ""; }
    while cursor >= 0 && cursor < node_count {
        let left: Int = sequence.arena.topology.left_children[cursor];
        if left < 0 || left >= cursor { return ""; }
        let left_kind: Int = sequence.arena.topology.node_kinds[left];
        if left_kind == AstExpressionNodeCall() {
            if sequence.arena.call_target_kinds[left] != SemanticCallTargetDirect() &&
                sequence.arena.call_target_kinds[left] != SemanticCallTargetNamespace() { return ""; }
            let target_syntax_id: Int = sequence.arena.identities.call_target_syntax_ids[left];
            let callee: Int = DirectMirScalarProgramCallCalleeBase(sequence, left);
            if target_syntax_id <= 0 || callee < 0 || callee >= left { return ""; }
            let target_name: String = sequence.arena.call_target_names[left];
            let record_row: Int = DirectMirScalarProgramLogicalRecordRow(
                logical_record, target_name);
            let cell_row: Int = DirectMirIdentityCellRow(
                logical_record.identity_cells, target_name);
            if record_row >= 0 || cell_row >= 0 {
                if sequence.arena.call_target_kinds[left] !=
                        SemanticCallTargetDirect() ||
                    (record_row >= 0 && cell_row >= 0) { return ""; }
                var declaration_id: Int = 0;
                var field_start: Int = 0;
                var field_count: Int = 0;
                if record_row >= 0 {
                    declaration_id = logical_record.source_syntax_ids[record_row];
                    field_start = logical_record.field_starts[record_row];
                    field_count = logical_record.field_counts[record_row];
                } else {
                    declaration_id = logical_record.identity_cells.source_syntax_ids[cell_row];
                    field_start = logical_record.identity_cells.field_starts[cell_row];
                    field_count = logical_record.identity_cells.field_counts[cell_row];
                }
                if target_syntax_id != declaration_id || argument_ordinal < 0 ||
                    argument_ordinal >= field_count { return ""; }
                if record_row >= 0 {
                    return logical_record.field_types[
                        field_start + argument_ordinal];
                }
                return logical_record.identity_cells.field_types[
                    field_start + argument_ordinal];
            }
            let callee_is_leaf: Bool =
                sequence.arena.topology.node_kinds[callee] == AstExpressionNodeLeaf();
            var binding_kind: Int = SemanticExpressionBindingNone();
            if callee_is_leaf { binding_kind = sequence.arena.identities.binding_kinds[callee]; }
            if binding_kind == SemanticExpressionBindingFormalParameter() {
                if sequence.arena.call_target_kinds[left] !=
                        SemanticCallTargetDirect() || !callee_is_leaf {
                    return "";
                }
                let parameter_ordinal: Int =
                    DirectMirScalarProgramCallableParameterOrdinalBySyntaxId(
                        signature, target_syntax_id);
                if parameter_ordinal < 0 ||
                    sequence.arena.identities.binding_ordinals[callee] != parameter_ordinal ||
                    sequence.arena.identities.binding_syntax_ids[callee] != target_syntax_id ||
                    sequence.arena.node_texts[callee] !=
                        signature.parameters.names[parameter_ordinal] ||
                    sequence.arena.call_target_names[left] !=
                        signature.parameters.names[parameter_ordinal] { return ""; }
                let shape: SemanticAstCallableTypeShape =
                    SemanticAstCallableTypeShapeFromName(
                        signature.parameters.type_names[parameter_ordinal]);
                if !shape.ok || argument_ordinal < 0 || argument_ordinal >=
                        ArrayLength(shape.parameter_types) { return ""; }
                return shape.parameter_types[argument_ordinal];
            }
            if !DirectMirScalarProgramDeclaredCallCalleeIdentityReady(
                    sequence, left) { return ""; }
            let callable_ordinal: Int =
                DirectMirScalarProgramCallableOrdinalAtCall(callables, sequence, left);
            if !DirectMirScalarCfgProgramCallableInventoryOrdinalReady(
                    callables, callable_ordinal) ||
                sequence.arena.call_target_names[left] != callables.source_names[callable_ordinal - 1] {
                return "";
            }
            return DirectMirScalarCfgProgramCallableParameterTypeAtOrdinal(
                callables, callable_ordinal, argument_ordinal);
        }
        if left_kind != AstExpressionNodeCallArgument() { return ""; }
        argument_ordinal = argument_ordinal + 1; cursor = left;
    }
    return "";
}

// Expected type follows the immediate expression context after direct-call
// parameter lookup. Array elements consume the element type, never the outer
// Array<T> carrier type. The postorder arena places each enclosing element
// directly after the value it wraps, so every descent remains identity-bound.
func DirectMirScalarProgramContextualExpectedType(
    ref sequence: MirExpressionGraphSequence, expression_root: Int,
    expected_type: String,
    ref callables: DirectMirScalarCfgProgramCallableInventory,
    ref signature: DirectMirRoutineSignatureFact,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact
) -> String {
    let direct: String = DirectMirScalarProgramDirectCallArgumentExpectedType(
        sequence, expression_root, callables, signature, logical_record);
    if direct != "" { return direct; }
    let node_count: Int = ArrayLength(sequence.arena.topology.node_kinds);
    var cursor: Int = expression_root;
    var contextual: String = expected_type;
    var descended: Bool = false;
    while cursor >= 0 && cursor + 1 < node_count &&
            sequence.arena.topology.node_kinds[cursor + 1] ==
                AstExpressionNodeArrayElement() &&
            sequence.arena.topology.right_children[cursor + 1] == cursor {
        let element: Option<String> = SemanticArrayElementType(contextual);
        if !IsSome(element) { return ""; }
        contextual = UnwrapOption(element);
        cursor = cursor + 1;
        descended = true;
    }
    if descended { return contextual; }
    return "";
}
