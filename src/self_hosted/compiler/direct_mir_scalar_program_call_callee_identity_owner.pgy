// Structural callee topology joined to carried callable identity.
//
// Direct calls use one leaf callee. Namespace calls use the persisted
// receiver/member/member-access trio, but both are admitted only when the call
// node already carries its canonical target kind and SyntaxNodeId.

import "direct_mir_scalar_cfg_expression_base_owner.pgy";

// Generic actuals are already bound by the occurrence/instance owner. This
// projection removes only their structural wrapper, never chooses a target.
func DirectMirScalarProgramCallCalleeBase(
    ref sequence: MirExpressionGraphSequence, call: Int
) -> Int {
    if call < 0 || call >= sequence.ready_node_count ||
        sequence.arena.topology.node_kinds[call] != AstExpressionNodeCall() { return -1; }
    let callee: Int = sequence.arena.topology.left_children[call];
    while callee >= 0 && callee < call &&
        sequence.arena.topology.node_kinds[callee] == AstExpressionNodeGenericCallee() {
        let actual: Int = sequence.arena.topology.right_children[callee];
        let previous: Int = sequence.arena.topology.left_children[callee];
        if actual < 0 || actual >= callee || previous < 0 || previous >= callee ||
            sequence.arena.topology.node_kinds[actual] != AstExpressionNodeGenericTypeActual() {
            return -1;
        }
        callee = previous;
    }
    if callee < 0 || callee >= call { return -1; }
    return callee;
}

func DirectMirScalarProgramNamespaceCallMarkerReady(
    ref sequence: MirExpressionGraphSequence, node: Int
) -> Bool {
    if node < 1 || node >= ArrayLength(sequence.arena.topology.node_kinds) ||
        sequence.arena.topology.node_kinds[node] != AstExpressionNodeCall() ||
        sequence.arena.call_target_kinds[node] !=
            SemanticCallTargetNamespace() ||
        sequence.arena.call_target_names[node] == "" ||
        sequence.arena.identities.call_target_syntax_ids[node] <= 0 {
        return false;
    }
    let callee: Int = DirectMirScalarProgramCallCalleeBase(sequence, node);
    if callee < 0 || callee >= node ||
        sequence.arena.topology.node_kinds[callee] !=
            AstExpressionNodeMemberAccess() {
        return false;
    }
    let receiver: Int = sequence.arena.topology.left_children[callee];
    let member: Int = sequence.arena.topology.right_children[callee];
    return receiver >= 0 && receiver < callee && member >= 0 &&
        member < callee && sequence.arena.topology.node_kinds[receiver] ==
            AstExpressionNodeLeaf() &&
        sequence.arena.topology.node_kinds[member] == AstExpressionNodeLeaf();
}

func DirectMirScalarProgramCallMarkerReady(
    ref sequence: MirExpressionGraphSequence, node: Int
) -> Bool {
    if DirectMirScalarProgramNamespaceCallMarkerReady(sequence, node) ||
        DirectMirScalarProgramMemberCallMarkerReady(sequence, node) {
        return true;
    }
    if node < 1 || node >= ArrayLength(sequence.arena.topology.node_kinds) ||
        sequence.arena.topology.node_kinds[node] != AstExpressionNodeCall() ||
        sequence.arena.call_target_kinds[node] != SemanticCallTargetDirect() {
        return false;
    }
    let callee: Int = DirectMirScalarProgramCallCalleeBase(sequence, node);
    if callee < 0 || callee >= node ||
        sequence.arena.topology.node_kinds[callee] != AstExpressionNodeLeaf() {
        return false;
    }
    if sequence.arena.identities.call_target_syntax_ids[node] > 0 {
        return true;
    }
    return sequence.arena.call_target_names[node] ==
        sequence.arena.node_texts[callee];
}

func DirectMirScalarProgramBuiltinCallMarkerReady(
    ref sequence: MirExpressionGraphSequence, node: Int
) -> Bool {
    return DirectMirScalarProgramCallMarkerReady(sequence, node) &&
        sequence.arena.identities.call_target_syntax_ids[node] == 0;
}

func DirectMirScalarProgramMemberCallMarkerReady(
    ref sequence: MirExpressionGraphSequence, call: Int
) -> Bool {
    if call < 1 || call >= sequence.ready_node_count ||
        sequence.arena.topology.node_kinds[call] != AstExpressionNodeCall() ||
        sequence.arena.call_target_kinds[call] != SemanticCallTargetMember() ||
        sequence.arena.call_target_names[call] == "" ||
        sequence.arena.identities.call_target_syntax_ids[call] <= 0 { return false; }
    let callee: Int = DirectMirScalarProgramCallCalleeBase(sequence, call);
    if callee < 0 || callee >= call ||
        sequence.arena.topology.node_kinds[callee] != AstExpressionNodeMemberAccess() { return false; }
    let receiver: Int = sequence.arena.topology.left_children[callee];
    let member: Int = sequence.arena.topology.right_children[callee];
    return receiver >= 0 && receiver < callee && member >= 0 && member < callee &&
        sequence.arena.topology.node_kinds[member] == AstExpressionNodeLeaf() &&
        sequence.arena.identities.binding_kinds[member] == SemanticExpressionBindingNone() &&
        sequence.arena.identities.binding_syntax_ids[member] == 0 &&
        sequence.arena.identities.binding_ordinals[member] == -1;
}
