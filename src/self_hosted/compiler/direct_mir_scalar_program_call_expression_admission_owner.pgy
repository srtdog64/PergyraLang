// Typed n-argument direct-call admission keyed only by carried SyntaxNodeId.

import "direct_mir_scalar_program_builtin_argument_chain_owner.pgy";
import "direct_mir_scalar_program_callable_inventory_owner.pgy";

struct DirectMirScalarProgramDirectCallFact {
    let recognized: Bool;
    let valid: Bool;
    let complete: Bool;
    let argument_rows: Array<Int>;
    let call_node: Int;
    let callable_ordinal: Int;
    let return_type: String;
}

func DirectMirScalarProgramDirectCallFactInvalid(
    recognized: Bool
) -> DirectMirScalarProgramDirectCallFact {
    let rows: Array<Int> = [];
    return DirectMirScalarProgramDirectCallFact(
        recognized, false, false, rows, -1, -1, "");
}

func DirectMirScalarProgramDirectCallArgumentExpectedType(ref sequence:
    MirExpressionGraphSequence, argument_root: Int, ref callables: DirectMirScalarCfgProgramCallableInventory) -> String {
    let node_count: Int = ArrayLength(sequence.arena.topology.node_kinds);
    let cursor: Int = argument_root + 1; let argument_ordinal: Int = 0;
    if argument_root < 0 || cursor >= node_count ||
        sequence.arena.topology.node_kinds[cursor] != AstExpressionNodeCallArgument() ||
        sequence.arena.topology.right_children[cursor] != argument_root { return ""; }
    while cursor >= 0 && cursor < node_count {
        let left: Int = sequence.arena.topology.left_children[cursor];
        if left < 0 || left >= cursor { return ""; }
        let left_kind: Int = sequence.arena.topology.node_kinds[left];
        if left_kind == AstExpressionNodeCall() {
            if sequence.arena.call_target_kinds[left] != SemanticCallTargetDirect() { return ""; }
            return DirectMirScalarCfgProgramCallableParameterTypeBySyntaxId(callables,
                sequence.arena.identities.call_target_syntax_ids[left], argument_ordinal);
        }
        if left_kind != AstExpressionNodeCallArgument() { return ""; }
        argument_ordinal = argument_ordinal + 1; cursor = left;
    }
    return "";
}
func DirectMirScalarProgramDirectCallFactFromGraph(
    ref sequence: MirExpressionGraphSequence, node: Int,
    source_rows: Array<Int>, normalized_types: Array<String>,
    ref callables: DirectMirScalarCfgProgramCallableInventory
) -> DirectMirScalarProgramDirectCallFact {
    let missing: DirectMirScalarProgramDirectCallFact =
        DirectMirScalarProgramDirectCallFactInvalid(false);
    if node < 0 || node >= ArrayLength(sequence.arena.topology.node_kinds) ||
        sequence.arena.topology.node_kinds[node] !=
            AstExpressionNodeCallArgument() {
        return missing;
    }
    let chain: DirectMirScalarProgramBuiltinArgumentChain =
        DirectMirScalarProgramBuiltinArgumentChainFromGraph(
            sequence, node, source_rows, normalized_types);
    if !chain.valid { return missing; }
    let target_syntax_id: Int =
        sequence.arena.identities.call_target_syntax_ids[chain.call_node];
    if target_syntax_id == 0 { return missing; }
    let callable_ordinal: Int =
        DirectMirScalarCfgProgramCallableInventoryOrdinalBySyntaxId(
            callables, target_syntax_id
        );
    if !DirectMirScalarCfgProgramCallableInventoryOrdinalReady(
            callables, callable_ordinal) {
        return DirectMirScalarProgramDirectCallFactInvalid(true);
    }
    let callable_row: Int = callable_ordinal - 1;
    let count: Int = ArrayLength(chain.argument_rows);
    if count > callables.parameter_counts[callable_row] {
        return DirectMirScalarProgramDirectCallFactInvalid(true);
    }
    let ordinal: Int = 0;
    while ordinal < count {
        let parameter_row: Int =
            callables.parameter_starts[callable_row] + ordinal;
        if (callables.parameter_carriages[parameter_row] != "value" &&
            callables.parameter_carriages[parameter_row] != "readonly-ref" &&
            callables.parameter_carriages[parameter_row] != "value-result" &&
            callables.parameter_carriages[parameter_row] != "owner-handle") ||
            normalized_types[chain.argument_rows[ordinal]] !=
                callables.parameter_types[parameter_row] {
            return DirectMirScalarProgramDirectCallFactInvalid(true);
        }
        ordinal = ordinal + 1;
    }
    return DirectMirScalarProgramDirectCallFact(
        true, true,
        count == callables.parameter_counts[callable_row],
        chain.argument_rows, chain.call_node, callable_ordinal,
        callables.return_types[callable_row]);
}

func DirectMirScalarProgramZeroArgumentDirectCallFactFromGraph(
    ref sequence: MirExpressionGraphSequence, node: Int,
    ref callables: DirectMirScalarCfgProgramCallableInventory
) -> DirectMirScalarProgramDirectCallFact {
    let missing: DirectMirScalarProgramDirectCallFact =
        DirectMirScalarProgramDirectCallFactInvalid(false);
    if !DirectMirScalarProgramCallMarkerReady(sequence, node) {
        return missing;
    }
    let target_syntax_id: Int =
        sequence.arena.identities.call_target_syntax_ids[node];
    if target_syntax_id == 0 { return missing; }
    let callable_ordinal: Int =
        DirectMirScalarCfgProgramCallableInventoryOrdinalBySyntaxId(
            callables, target_syntax_id);
    if !DirectMirScalarCfgProgramCallableInventoryOrdinalReady(
            callables, callable_ordinal) {
        return DirectMirScalarProgramDirectCallFactInvalid(true);
    }
    let callable_row: Int = callable_ordinal - 1;
    if callables.parameter_counts[callable_row] != 0 {
        return DirectMirScalarProgramDirectCallFactInvalid(true);
    }
    let rows: Array<Int> = [];
    return DirectMirScalarProgramDirectCallFact(
        true, true, true, rows, node, callable_ordinal,
        callables.return_types[callable_row]);
}
