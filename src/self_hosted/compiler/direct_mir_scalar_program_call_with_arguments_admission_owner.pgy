// Admission for direct calls whose normalized argument chain is non-empty.

import "direct_mir_scalar_program_builtin_argument_chain_owner.pgy";
import "direct_mir_scalar_program_callable_inventory_owner.pgy";
import "direct_mir_scalar_program_callable_parameter_identity_owner.pgy";
import "direct_mir_scalar_program_direct_call_fact_owner.pgy";

func DirectMirScalarProgramDirectCallFactFromGraph(
    ref sequence: MirExpressionGraphSequence, node: Int,
    source_rows: Array<Int>, normalized_types: Array<String>,
    ref callables: DirectMirScalarCfgProgramCallableInventory,
    ref signature: DirectMirRoutineSignatureFact
) -> DirectMirScalarProgramDirectCallFact {
    let missing: DirectMirScalarProgramDirectCallFact =
        DirectMirScalarProgramDirectCallFactInvalid(false);
    if node < 0 || node >= ArrayLength(sequence.arena.topology.node_kinds) ||
        sequence.arena.topology.node_kinds[node] != AstExpressionNodeCallArgument() { return missing; }
    let chain: DirectMirScalarProgramBuiltinArgumentChain =
        DirectMirScalarProgramBuiltinArgumentChainFromGraph(
            sequence, node, source_rows, normalized_types);
    if !chain.valid { return missing; }
    let target_syntax_id: Int =
        sequence.arena.identities.call_target_syntax_ids[chain.call_node];
    let callee: Int = sequence.arena.topology.left_children[chain.call_node];
    if callee < 0 || callee >= chain.call_node {
        return DirectMirScalarProgramDirectCallFactInvalid(true);
    }
    let callee_is_leaf: Bool =
        sequence.arena.topology.node_kinds[callee] == AstExpressionNodeLeaf();
    let binding_kind: Int = SemanticExpressionBindingNone();
    if callee_is_leaf {
        binding_kind = sequence.arena.identities.binding_kinds[callee];
    }
    if target_syntax_id <= 0 {
        if binding_kind == SemanticExpressionBindingFormalParameter() ||
            binding_kind == SemanticExpressionBindingDeclaredCallable() {
            return DirectMirScalarProgramDirectCallFactInvalid(true);
        }
        return missing;
    }
    let count: Int = ArrayLength(chain.argument_rows);
    if binding_kind == SemanticExpressionBindingFormalParameter() {
        if sequence.arena.call_target_kinds[chain.call_node] !=
                SemanticCallTargetDirect() || !callee_is_leaf {
            return DirectMirScalarProgramDirectCallFactInvalid(true);
        }
        let parameter_ordinal: Int =
            DirectMirScalarProgramCallableParameterOrdinalBySyntaxId(signature, target_syntax_id);
        if parameter_ordinal < 0 ||
            sequence.arena.identities.binding_ordinals[callee] != parameter_ordinal ||
            sequence.arena.identities.binding_syntax_ids[callee] != target_syntax_id ||
            sequence.arena.node_texts[callee] != signature.parameters.names[parameter_ordinal] ||
            sequence.arena.call_target_names[chain.call_node] !=
                signature.parameters.names[parameter_ordinal] {
            return DirectMirScalarProgramDirectCallFactInvalid(true);
        }
        let shape: SemanticAstCallableTypeShape = SemanticAstCallableTypeShapeFromName(
            signature.parameters.type_names[parameter_ordinal]);
        if !shape.ok || count > ArrayLength(shape.parameter_types) {
            return DirectMirScalarProgramDirectCallFactInvalid(true);
        }
        let ordinal: Int = 0;
        while ordinal < count {
            if normalized_types[chain.argument_rows[ordinal]] != shape.parameter_types[ordinal] {
                return DirectMirScalarProgramDirectCallFactInvalid(true);
            }
            ordinal = ordinal + 1;
        }
        return DirectMirScalarProgramDirectCallFact(
            true, true, count == ArrayLength(shape.parameter_types), chain.argument_rows,
            chain.call_node, -1, parameter_ordinal, shape.return_type);
    }
    if !DirectMirScalarProgramDeclaredCallCalleeIdentityReady(
            sequence, chain.call_node) {
        return DirectMirScalarProgramDirectCallFactInvalid(true);
    }
    let callable_ordinal: Int =
        DirectMirScalarCfgProgramCallableInventoryOrdinalBySyntaxId(callables, target_syntax_id);
    if !DirectMirScalarCfgProgramCallableInventoryOrdinalReady(callables, callable_ordinal) {
        return DirectMirScalarProgramDirectCallFactInvalid(true);
    }
    let callable_row: Int = callable_ordinal - 1;
    if sequence.arena.call_target_names[chain.call_node] !=
            callables.names[callable_row] ||
        count > callables.parameter_counts[callable_row] {
        return DirectMirScalarProgramDirectCallFactInvalid(true);
    }
    let ordinal: Int = 0;
    while ordinal < count {
        let parameter_row: Int = callables.parameter_starts[callable_row] + ordinal;
        if (callables.parameter_carriages[parameter_row] != "value" &&
            callables.parameter_carriages[parameter_row] != "readonly-ref" &&
            callables.parameter_carriages[parameter_row] != "value-result" &&
            callables.parameter_carriages[parameter_row] != "owner-handle") ||
            normalized_types[chain.argument_rows[ordinal]] != callables.parameter_types[parameter_row] {
            return DirectMirScalarProgramDirectCallFactInvalid(true);
        }
        ordinal = ordinal + 1;
    }
    return DirectMirScalarProgramDirectCallFact(
        true, true, count == callables.parameter_counts[callable_row], chain.argument_rows,
        chain.call_node, callable_ordinal, -1, callables.return_types[callable_row]);
}
