// Typed callable identity admitted independently of CFG block topology.

import "direct_mir_scalar_program_callable_fact_owner.pgy";

func DirectMirScalarProgramCallableFactFromAdmitted(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    callable_row: Int, routine_ordinal: Int,
    ref nominal: DirectMirScalarProgramTwoIntNominalAbiFact,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    ref payload_free_enum: DirectMirScalarProgramPayloadFreeEnumFact,
    ref referenced_enum: DirectMirScalarProgramReferencedEnumFact
) -> DirectMirScalarCfgProgramCallableFact {
    if !MirProgramRoutineIndexRowReady(admitted.routines, callable_row) {
        return DirectMirScalarCfgProgramCallableFactInvalid();
    }
    let first_block_count: Int =
        MirProgramRoutineIndexBlockInstructionCountAt(
            admitted.routines, callable_row, 0
        );
    let signature: DirectMirRoutineSignatureFact =
        DirectMirRoutineSignatureFactAt(
            admitted.routines, callable_row, first_block_count
        );
    let source: DirectMirScalarCfgProgramCallableFact =
        DirectMirScalarCfgProgramCallableFact(
            true, 0, signature, routine_ordinal
        );
    let fact: DirectMirScalarCfgProgramCallableFact =
        DirectMirScalarCfgProgramCallableFact(
            source.valid,
            DirectMirScalarCfgProgramCallableFactDigest(source),
            source.signature, source.routine_ordinal
        );
    if !DirectMirScalarCfgProgramCallableFactReadyWithReferencedEnum(
            fact, nominal, logical_record, payload_free_enum,
            referenced_enum) {
        return DirectMirScalarCfgProgramCallableFactInvalid();
    }
    return fact;
}
