// Optional callable identity carried by the scalar-program extension.

import "direct_mir_routine_signature_fact_owner.pgy";
import "direct_mir_scalar_program_callable_signature_owner.pgy";
import "direct_mir_scalar_program_callable_signature_empty_owner.pgy";

struct DirectMirScalarCfgProgramCallableFact {
    let valid: Bool;
    let digest: Int;
    let signature: DirectMirRoutineSignatureFact;
    let routine_ordinal: Int;
}

func DirectMirScalarCfgProgramCallableFactInvalid(
) -> DirectMirScalarCfgProgramCallableFact {
    return DirectMirScalarCfgProgramCallableFact(
        false, 0, InvalidDirectMirRoutineSignatureFact(), -1
    );
}

func DirectMirScalarCfgProgramCallableFactDigest(
    ref fact: DirectMirScalarCfgProgramCallableFact
) -> Int {
    if !fact.valid { return 0; }
    let hash: Long = DirectMirCfgHashInt(229L, fact.signature.digest);
    hash = DirectMirCfgHashInt(hash, fact.routine_ordinal);
    return DirectMirCfgBoundedDigest(hash);
}

func DirectMirScalarCfgProgramCallableFactReady(
    ref fact: DirectMirScalarCfgProgramCallableFact
) -> Bool {
    if !fact.valid || fact.digest == 0 ||
        fact.digest != DirectMirScalarCfgProgramCallableFactDigest(fact) ||
        fact.routine_ordinal <= 0 { return false; }
    let nominal: DirectMirScalarProgramTwoIntNominalAbiFact =
        DirectMirScalarProgramTwoIntNominalAbiFactFromCanonicalEmpty();
    return DirectMirScalarProgramCallableSignatureSupported(
        fact.signature, nominal);
}

func DirectMirScalarCfgProgramCallableFactReadyWithNominal(
    ref fact: DirectMirScalarCfgProgramCallableFact,
    ref nominal: DirectMirScalarProgramTwoIntNominalAbiFact
) -> Bool {
    return fact.valid && fact.digest != 0 && fact.digest ==
        DirectMirScalarCfgProgramCallableFactDigest(fact) &&
        fact.routine_ordinal > 0 &&
        DirectMirScalarProgramCallableSignatureSupported(
            fact.signature, nominal);
}

func DirectMirScalarCfgProgramCallableFactReadyWithReferencedEnum(
    ref fact: DirectMirScalarCfgProgramCallableFact,
    ref nominal: DirectMirScalarProgramTwoIntNominalAbiFact,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    ref payload_free_enum: DirectMirScalarProgramPayloadFreeEnumFact,
    ref referenced_enum: DirectMirScalarProgramReferencedEnumFact
) -> Bool {
    return fact.valid && fact.digest != 0 && fact.digest ==
        DirectMirScalarCfgProgramCallableFactDigest(fact) &&
        fact.routine_ordinal > 0 &&
        DirectMirScalarProgramCallableSignatureSupportedWithReferencedEnum(
            fact.signature, nominal, logical_record, payload_free_enum,
            referenced_enum);
}

func DirectMirScalarCfgProgramCallableFactCanonicalEmpty(
    ref fact: DirectMirScalarCfgProgramCallableFact
) -> Bool {
    return !fact.valid && fact.digest == 0 && fact.routine_ordinal < 0 &&
        DirectMirScalarProgramCallableSignatureCanonicalEmpty(
            fact.signature);
}
