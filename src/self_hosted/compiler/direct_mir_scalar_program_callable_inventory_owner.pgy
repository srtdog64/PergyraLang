// Program-wide typed callable inventory for declaration-free scalar GraphPlan.

import "direct_mir_scalar_program_callable_admission_owner.pgy";
import "direct_mir_scalar_cfg_hash_owner.pgy";
import "direct_mir_scalar_cfg_program_parameter_identity_owner.pgy";

struct DirectMirScalarCfgProgramCallableInventory {
    let valid: Bool;
    let digest: Int;
    let routine_ordinals: Array<Int>;
    let source_syntax_ids: Array<Int>;
    let names: Array<String>;
    let return_types: Array<String>;
    let parameter_starts: Array<Int>;
    let parameter_counts: Array<Int>;
    let parameter_types: Array<String>;
    let parameter_carriages: Array<String>;
    let signature_digests: Array<Int>;
    let source_names: Array<String>;
    let instances: DirectMirRoutineInstanceInventory;
    // A passed, read-only use context; not part of the global inventory digest.
    let caller_ordinal: Int;
}

func DirectMirScalarCfgProgramCallableInventoryDigest(ref inventory: DirectMirScalarCfgProgramCallableInventory
) -> Int {
    if !inventory.valid { return 0; }
    let hash: Long = DirectMirCfgHashInt(227L, ArrayLength(inventory.routine_ordinals));
    hash = DirectMirScalarCfgHashInts(hash, inventory.routine_ordinals);
    hash = DirectMirScalarCfgHashInts(hash, inventory.source_syntax_ids);
    hash = DirectMirScalarCfgHashStrings(hash, inventory.names);
    hash = DirectMirScalarCfgHashStrings(hash, inventory.return_types);
    hash = DirectMirScalarCfgHashInts(hash, inventory.parameter_starts);
    hash = DirectMirScalarCfgHashInts(hash, inventory.parameter_counts);
    hash = DirectMirScalarCfgHashStrings(hash, inventory.parameter_types);
    hash = DirectMirScalarCfgHashStrings(hash, inventory.parameter_carriages);
    hash = DirectMirScalarCfgHashInts(hash, inventory.signature_digests);
    hash = DirectMirScalarCfgHashStrings(hash, inventory.source_names);
    hash = DirectMirCfgHashInt(hash, inventory.instances.digest);
    return DirectMirCfgBoundedDigest(hash);
}

func DirectMirScalarCfgProgramCallableInventoryReady(ref inventory: DirectMirScalarCfgProgramCallableInventory,
    routine_count: Int) -> Bool {
    let count: Int = ArrayLength(inventory.routine_ordinals);
    if !inventory.valid || inventory.digest == 0 || routine_count < 1 || count != routine_count - 1 ||
        count != ArrayLength(inventory.source_syntax_ids) || count != ArrayLength(inventory.names) ||
        count != ArrayLength(inventory.source_names) || !DirectMirRoutineInstanceInventoryReady(inventory.instances) ||
        routine_count != ArrayLength(inventory.instances.source_rows) || count != ArrayLength(inventory.return_types) ||
        count != ArrayLength(inventory.parameter_starts) || count != ArrayLength(inventory.parameter_counts) ||
        count != ArrayLength(inventory.signature_digests) || inventory.digest !=
            DirectMirScalarCfgProgramCallableInventoryDigest(inventory) {
        return false;
    }
    let expected_parameter: Int = 0;
    let row: Int = 0;
    while row < count {
        if inventory.routine_ordinals[row] != row + 1 || inventory.source_syntax_ids[row] <= 0 ||
            inventory.names[row] == "" || inventory.source_names[row] == "" || inventory.return_types[row] == "" ||
            inventory.parameter_starts[row] != expected_parameter || inventory.parameter_counts[row] < 0 ||
            expected_parameter + inventory.parameter_counts[row] >
                ArrayLength(inventory.parameter_types) || expected_parameter + inventory.parameter_counts[row] >
                ArrayLength(inventory.parameter_carriages) || inventory.signature_digests[row] == 0 {
            return false;
        }
        expected_parameter = expected_parameter +
            inventory.parameter_counts[row];
        let parameter: Int = inventory.parameter_starts[row];
        while parameter < expected_parameter {
            if inventory.parameter_types[parameter] == "" || inventory.parameter_carriages[parameter] == "" {
                return false;
            }
            parameter = parameter + 1;
        }
        let prior: Int = 0;
        while prior < row {
            if (inventory.source_syntax_ids[prior] == inventory.source_syntax_ids[row] &&
                inventory.instances.instance_rows[prior + 1] == inventory.instances.instance_rows[row + 1]) ||
                inventory.names[prior] == inventory.names[row] {
                return false;
            }
            prior = prior + 1;
        }
        row = row + 1;
    }
    return expected_parameter == ArrayLength(inventory.parameter_types) &&
        expected_parameter == ArrayLength(inventory.parameter_carriages);
}

func DirectMirScalarCfgProgramCallableInventoryFromAdmitted(ref admitted: MirMachineLayerAdmittedJsonInput,
    routine_instances: DirectMirRoutineInstanceInventory, ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    ref payload_free_enum: DirectMirScalarProgramPayloadFreeEnumFact,
    ref referenced_enum: DirectMirScalarProgramReferencedEnumFact) -> DirectMirScalarCfgProgramCallableInventory {
    let ordinals: Array<Int> = [];
    let syntax_ids: Array<Int> = [];
    let names: Array<String> = [];
    let source_names: Array<String> = [];
    let return_types: Array<String> = [];
    let parameter_starts: Array<Int> = [];
    let parameter_counts: Array<Int> = [];
    let parameter_types: Array<String> = [];
    let parameter_carriages: Array<String> = [];
    let signature_digests: Array<Int> = [];
    let ordinal: Int = 1;
    while ordinal < ArrayLength(routine_instances.source_rows) {
        let fact: DirectMirScalarCfgProgramCallableFact = DirectMirScalarProgramCallableFactFromInstance(
                routine_instances, ordinal, logical_record, payload_free_enum, referenced_enum);
        if !DirectMirScalarCfgProgramCallableFactReadyWithReferencedEnum(fact, logical_record, payload_free_enum,
                referenced_enum) {
            return DirectMirScalarCfgProgramCallableInventory(false, 0, ordinals, syntax_ids, names, return_types,
                parameter_starts, parameter_counts, parameter_types,
                parameter_carriages, signature_digests, source_names, routine_instances, -1);
        }
        ArrayPush(ordinals, ordinal);
        ArrayPush(syntax_ids, fact.signature.source_syntax_id);
        ArrayPush(names, fact.signature.name);
        ArrayPush(source_names, admitted.routines.names[routine_instances.source_rows[ordinal]]);
        ArrayPush(return_types, fact.signature.return_type);
        ArrayPush(parameter_starts, ArrayLength(parameter_types));
        ArrayPush(parameter_counts, fact.signature.param_count);
        if !DirectMirScalarCfgProgramAppendParameterTypes(parameter_types, fact.signature) {
            return DirectMirScalarCfgProgramCallableInventory(false, 0, ordinals, syntax_ids, names, return_types,
                parameter_starts, parameter_counts, parameter_types,
                parameter_carriages, signature_digests, source_names, routine_instances, -1);
        }
        let parameter: Int = 0;
        while parameter < fact.signature.param_count {
            ArrayPush(parameter_carriages,
                fact.signature.parameters.carriages[parameter]);
            parameter = parameter + 1;
        }
        ArrayPush(signature_digests, fact.signature.digest);
        ordinal = ordinal + 1;
    }
    let source: DirectMirScalarCfgProgramCallableInventory =
        DirectMirScalarCfgProgramCallableInventory(
            true, 0, ordinals, syntax_ids, names, return_types,
            parameter_starts, parameter_counts, parameter_types,
            parameter_carriages, signature_digests, source_names, routine_instances, -1);
    let sealed: DirectMirScalarCfgProgramCallableInventory =
        DirectMirScalarCfgProgramCallableInventory(
            true, DirectMirScalarCfgProgramCallableInventoryDigest(source),
            ordinals, syntax_ids, names, return_types,
            parameter_starts, parameter_counts, parameter_types,
            parameter_carriages, signature_digests, source_names, routine_instances, -1);
    if !DirectMirScalarCfgProgramCallableInventoryReady(
            sealed, ArrayLength(routine_instances.source_rows)) {
        return DirectMirScalarCfgProgramCallableInventory(
            false, 0, ordinals, syntax_ids, names, return_types,
            parameter_starts, parameter_counts, parameter_types,
            parameter_carriages, signature_digests, source_names, routine_instances, -1);
    }
    return sealed;
}

func DirectMirScalarCfgProgramCallableInventoryOrdinalBySyntaxId(
    ref inventory: DirectMirScalarCfgProgramCallableInventory,
    syntax_id: Int
) -> Int {
    let found: Int = -1;
    let row: Int = 0;
    while row < ArrayLength(inventory.source_syntax_ids) {
        if inventory.source_syntax_ids[row] == syntax_id && inventory.instances.instance_rows[row + 1] == -1 {
            if found >= 0 { return -1; }
            found = inventory.routine_ordinals[row];
        }
        row = row + 1;
    }
    return found;
}

func DirectMirScalarCfgProgramCallableInventoryOrdinalReady(
    ref inventory: DirectMirScalarCfgProgramCallableInventory,
    ordinal: Int
) -> Bool {
    return ordinal > 0 && ordinal <= ArrayLength(inventory.routine_ordinals) &&
        inventory.routine_ordinals[ordinal - 1] == ordinal;
}

func DirectMirScalarCfgProgramCallableParameterTypeAtOrdinal(ref inventory: DirectMirScalarCfgProgramCallableInventory, ordinal: Int, parameter_ordinal: Int) -> String {
    if !DirectMirScalarCfgProgramCallableInventoryOrdinalReady(inventory, ordinal) { return ""; }
    let row: Int = ordinal - 1;
    if parameter_ordinal < 0 || parameter_ordinal >= inventory.parameter_counts[row] { return ""; }
    return inventory.parameter_types[inventory.parameter_starts[row] + parameter_ordinal];
}

func DirectMirScalarProgramCallableUseContext(
    inventory: DirectMirScalarCfgProgramCallableInventory,
    caller_ordinal: Int
) -> DirectMirScalarCfgProgramCallableInventory {
    return DirectMirScalarCfgProgramCallableInventory(inventory.valid, inventory.digest,
        inventory.routine_ordinals, inventory.source_syntax_ids, inventory.names, inventory.return_types,
        inventory.parameter_starts, inventory.parameter_counts, inventory.parameter_types,
        inventory.parameter_carriages, inventory.signature_digests, inventory.source_names, inventory.instances,
        caller_ordinal);
}

func DirectMirScalarProgramCallableOrdinalAtCall(
    ref inventory: DirectMirScalarCfgProgramCallableInventory,
    ref sequence: MirExpressionGraphSequence, node: Int
) -> Int {
    if !sequence.ok || node < 0 || node >= sequence.ready_node_count ||
        ArrayLength(sequence.program_call_ordinals) != sequence.ready_node_count { return -1; }
    let ordinal: Int = sequence.program_call_ordinals[node];
    if !DirectMirScalarCfgProgramCallableInventoryOrdinalReady(inventory, ordinal) ||
        inventory.source_syntax_ids[ordinal - 1] != sequence.arena.identities.call_target_syntax_ids[node] {
        return -1;
    }
    return ordinal;
}
