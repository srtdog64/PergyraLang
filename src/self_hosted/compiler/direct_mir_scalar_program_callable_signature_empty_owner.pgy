// Canonical empty callable signature state for absent program callables.

import "direct_mir_routine_signature_fact_owner.pgy";

func DirectMirScalarProgramCallableSignatureCanonicalEmpty(
    ref signature: DirectMirRoutineSignatureFact
) -> Bool {
    return !signature.valid && signature.digest == 0 && signature.row < 0 &&
        signature.name == "" && signature.kind == "" &&
        signature.source_syntax_id == 0 && signature.receiver_carriage == "" &&
        signature.return_type == "" && signature.param_count == 0 &&
        !signature.parameters.valid && signature.parameters.digest == 0 &&
        ArrayLength(signature.parameters.names) == 0 &&
        !signature.param.valid && signature.param.digest == 0 &&
        signature.param.name == "" && signature.param.type_name == "" &&
        signature.param.carriage == "" && signature.param.resource == "" &&
        signature.param.pass_shape == "" &&
        signature.param.abi_type_name == "" &&
        signature.param.abi_layout_id == 0 &&
        !signature.param.abi_required && !signature.param.abi.valid &&
        signature.param.abi.type_name == "" &&
        signature.param.abi.size_text == "" &&
        signature.param.abi.align_text == "" &&
        signature.param.abi.runtime_fn == "" &&
        signature.param.abi.inner_c_type == "" &&
        signature.param.abi.representation_text == "" &&
        signature.param.abi.discriminant == "" &&
        signature.param.abi.primary_tag_text == "" &&
        signature.param.abi.secondary_tag_text == "" &&
        signature.param.abi.niche_none_pattern == "" &&
        ArrayLength(signature.param.abi.field_names) == 0 &&
        ArrayLength(signature.param.abi.field_offsets) == 0 &&
        ArrayLength(signature.param.abi.field_sizes) == 0 &&
        ArrayLength(signature.param.abi.field_aligns) == 0;
}
