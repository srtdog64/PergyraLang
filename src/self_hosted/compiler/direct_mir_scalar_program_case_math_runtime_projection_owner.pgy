// Concrete StringReplace/checked numeric runtime facts projected from sealed IDs.

import "direct_mir_scalar_program_case_math_runtime_requirement_owner.pgy";

struct DirectMirScalarProgramCaseMathRuntimeProjection {
    let valid: Bool;
    let replace: CompilerRuntimeCallAbiFact;
    let abs: CompilerRuntimeCallAbiFact;
    let min: CompilerRuntimeCallAbiFact;
    let max: CompilerRuntimeCallAbiFact;
    let long_modulo: CompilerRuntimeCallAbiFact;
    let long_division: CompilerRuntimeCallAbiFact;
}

func DirectMirScalarProgramCaseMathRuntimeProjectionFromIds(
    ref ids: DirectMirScalarProgramCaseMathRuntimeIds
) -> DirectMirScalarProgramCaseMathRuntimeProjection {
    return DirectMirScalarProgramCaseMathRuntimeProjection(
        ids.valid,
        DirectMirScalarProgramCaseMathRuntimeFact(
            "string", "replace", StringRuntimeCStringReplaceFn()),
        DirectMirScalarProgramCaseMathRuntimeFact(
            "math", "abs", MathRuntimeCAbsFn()),
        DirectMirScalarProgramCaseMathRuntimeFact(
            "math", "min", MathRuntimeCMinFn()),
        DirectMirScalarProgramCaseMathRuntimeFact(
            "math", "max", MathRuntimeCMaxFn()),
        DirectMirScalarProgramLongModuloRuntimeFact(),
        DirectMirScalarProgramLongDivisionRuntimeFact());
}

func DirectMirScalarProgramCaseMathRuntimeProjectionReady(
    ref projection: DirectMirScalarProgramCaseMathRuntimeProjection,
    ref ids: DirectMirScalarProgramCaseMathRuntimeIds
) -> Bool {
    if !projection.valid ||
        !DirectMirScalarProgramCaseMathRuntimeIdsReady(ids) { return false; }
    return DirectMirScalarProgramCaseMathRuntimeFactReady(
            projection.replace, ids.replace_id) &&
        DirectMirScalarProgramCaseMathRuntimeFactReady(
            projection.abs, ids.abs_id) &&
        DirectMirScalarProgramCaseMathRuntimeFactReady(
            projection.min, ids.min_id) &&
        DirectMirScalarProgramCaseMathRuntimeFactReady(
            projection.max, ids.max_id) &&
        DirectMirScalarProgramLongModuloRuntimeFactReady(
            projection.long_modulo, ids.long_modulo_id) &&
        DirectMirScalarProgramLongDivisionRuntimeFactReady(
            projection.long_division, ids.long_division_id);
}

func DirectMirScalarProgramLongDivisionRuntimeFactReady(
    fact: CompilerRuntimeCallAbiFact, expected_id: Int
) -> Bool {
    return expected_id == 0 || (fact.ok &&
        fact.runtime_call_abi_id == expected_id &&
        fact.domain == "checked-arithmetic" &&
        fact.operation == "long-division" &&
        fact.symbol == CheckedArithmeticRuntimeCLongDivisionFn() &&
        fact.materialization == CompilerRuntimeCallAbiMaterialTargetLibrary() &&
        fact.call_shape == "long_long_to_long");
}

func DirectMirScalarProgramLongModuloRuntimeFactReady(
    fact: CompilerRuntimeCallAbiFact, expected_id: Int
) -> Bool {
    return expected_id == 0 || (fact.ok &&
        fact.runtime_call_abi_id == expected_id &&
        fact.domain == "checked-arithmetic" &&
        fact.operation == "long-modulo" &&
        fact.symbol == CheckedArithmeticRuntimeCLongModuloFn() &&
        fact.materialization == CompilerRuntimeCallAbiMaterialTargetLibrary() &&
        fact.call_shape == "long_long_to_long");
}

func DirectMirScalarProgramCaseMathRuntimeFactReady(
    fact: CompilerRuntimeCallAbiFact, expected_id: Int
) -> Bool {
    return expected_id == 0 || (fact.ok &&
        fact.runtime_call_abi_id == expected_id && fact.materialization ==
            CompilerRuntimeCallAbiMaterialGeneratedHelper());
}

func DirectMirScalarProgramCaseMathRuntimeRequired(
    ref ids: DirectMirScalarProgramCaseMathRuntimeIds
) -> Bool {
    return ids.replace_id != 0 || ids.abs_id != 0 ||
        ids.min_id != 0 || ids.max_id != 0 || ids.long_modulo_id != 0 ||
        ids.long_division_id != 0;
}
