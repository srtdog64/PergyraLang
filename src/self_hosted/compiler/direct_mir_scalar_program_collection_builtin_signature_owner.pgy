// Exact semantic-registry projection for the bounded collection builtin set.
import "direct_mir_scalar_program_expression_kind_id_owner.pgy";
func DirectMirScalarProgramCollectionBuiltinSignatureExpected(
    name: String
) -> Array<String> {
    if name == "StringContains" {
        return ["Bool", "String|String", ToString(
            DirectMirScalarProgramExprStringContains())];
    }
    if name == "Split" || name == "StringSplit" {
        return ["Array<String>", "String|String", ToString(
            DirectMirScalarProgramExprStringSplit())];
    }
    if name == "Join" || name == "StringJoin" { return ["String",
        "Array<String>|String", ToString(DirectMirScalarProgramExprStringJoin())]; }
    if name == "ArrayLength" {
        return ["Int", "Unknown", ToString(
            DirectMirScalarProgramExprArrayStringLength())];
    }
    if name == "ArrayDropOwnedStrings" {
        return ["Void", "Array<String>", ToString(
            DirectMirScalarProgramExprArrayStringDropOwned())];
    }
    if name == "ArrayPushOwnedString" {
        return ["Void", "Array<String>|String", ToString(
            DirectMirScalarProgramExprArrayStringPushOwned())];
    }
    if name == "Args" {
        return ["Array<String>", "", ToString(
            DirectMirScalarProgramExprProcessArgs())];
    }
    if name == "DirWalk" {
        return ["Array<String>", "String", ToString(
            DirectMirScalarProgramExprDirWalk())];
    }
    if name == "FileExists" {
        return ["Bool", "String", ToString(
            DirectMirScalarProgramExprFileExists())];
    }
    if name == "ReadFile" {
        return ["String", "String", ToString(
            DirectMirScalarProgramExprReadFile())];
    }
    if name == "ToInt" {
        return ["Int", "Unknown", ToString(
            DirectMirScalarProgramExprToIntString())];
    }
    if name == "SetNew" { return ["Set<Unknown>", "", ToString(
        DirectMirScalarProgramExprSetStringNew())]; }
    if name == "SetAdd" { return ["Void", "Unknown|Unknown", ToString(
        DirectMirScalarProgramExprSetStringAdd())]; }
    if name == "SetHas" { return ["Bool", "Unknown|Unknown", ToString(
        DirectMirScalarProgramExprSetStringHas())]; }
    return [];
}

func DirectMirScalarProgramCollectionBuiltinArgumentType(
    name: String, expected: String
) -> String {
    if name == "ArrayLength" && expected == "Unknown" {
        return "Array<String>";
    }
    if name == "ToInt" { return "String"; }
    return expected;
}

func DirectMirScalarProgramSetStringBuiltinSelected(
    name: String, actual_types: Array<String>, expected_type: String
) -> Bool {
    if name == "SetNew" {
        return ArrayLength(actual_types) == 0 && expected_type ==
            CompilerAbiLayoutSetStringTypeName();
    }
    if name != "SetAdd" && name != "SetHas" { return false; }
    if (name == "SetAdd" && expected_type != "" &&
            expected_type != CompilerAbiLayoutVoidTypeName()) ||
            (name == "SetHas" && expected_type != CompilerAbiLayoutBoolTypeName()) ||
            ArrayLength(actual_types) > 2 { return false; }
    if ArrayLength(actual_types) > 0 && actual_types[0] !=
            CompilerAbiLayoutSetStringTypeName() { return false; }
    if ArrayLength(actual_types) > 1 && actual_types[1] !=
            CompilerAbiLayoutStringTypeName() { return false; }
    return true;
}
struct DirectMirScalarProgramSetStringBuiltinSignature {
    let selected: Bool;
    let return_type: String;
    let parameter_types: Array<String>;
}
func DirectMirScalarProgramSetStringBuiltinSignatureFor(
    name: String, actual_types: Array<String>, expected_type: String
) -> DirectMirScalarProgramSetStringBuiltinSignature {
    let no_parameters: Array<String> = [];
    if !DirectMirScalarProgramSetStringBuiltinSelected(
            name, actual_types, expected_type) {
        return DirectMirScalarProgramSetStringBuiltinSignature(
            false, "", no_parameters);
    }
    if name == "SetNew" {
        return DirectMirScalarProgramSetStringBuiltinSignature(
            true, CompilerAbiLayoutSetStringTypeName(), no_parameters);
    }
    let return_type: String = CompilerAbiLayoutVoidTypeName();
    if name == "SetHas" { return_type = CompilerAbiLayoutBoolTypeName(); }
    let set_parameter_types: Array<String> = [
        CompilerAbiLayoutSetStringTypeName(),
        CompilerAbiLayoutStringTypeName()];
    return DirectMirScalarProgramSetStringBuiltinSignature(
        true, return_type, set_parameter_types);
}
