// Normalized collection and String expression classifications.

import "direct_mir_scalar_program_expression_kind_fact_owner.pgy";
import "direct_mir_scalar_program_expression_kind_id_owner.pgy";

func DirectMirScalarProgramCollectionExpressionKindFact(
    source_kind: Int, left_type: String, right_type: String, arity: Int
) -> DirectMirScalarProgramExpressionKindFact {
    let invalid: DirectMirScalarProgramExpressionKindFact =
        DirectMirScalarProgramExpressionKindFactInvalid();
    if source_kind == AstExpressionNodeIndex() && arity == 2 &&
            right_type == CompilerAbiLayoutIntTypeName() {
        let kind: Int = 0; let type_name: String = "";
        if left_type == CompilerAbiLayoutArrayStringTypeName() {
            kind = DirectMirScalarProgramExprArrayStringIndex();
            type_name = CompilerAbiLayoutStringTypeName();
        } else if left_type == CompilerAbiLayoutArrayIntTypeName() {
            kind = DirectMirScalarProgramExprArrayIntIndex();
            type_name = CompilerAbiLayoutIntTypeName();
        } else if left_type == CompilerAbiLayoutArrayBoolTypeName() {
            kind = DirectMirScalarProgramExprArrayBoolIndex();
            type_name = CompilerAbiLayoutBoolTypeName();
        }
        if kind != 0 { return DirectMirScalarProgramExpressionKindFact(
            true, kind, type_name, ""); }
    }
    if arity != 2 || left_type != CompilerAbiLayoutStringTypeName() ||
        right_type != CompilerAbiLayoutStringTypeName() { return invalid; }
    if source_kind == AstExpressionNodeAdd() {
        return DirectMirScalarProgramExpressionKindFact(
            true, DirectMirScalarProgramExprConcatString(),
            CompilerAbiLayoutStringTypeName(), "");
    }
    if source_kind == AstExpressionNodeEquality() ||
            source_kind == AstExpressionNodeInequality() {
        let kind: Int = DirectMirScalarProgramExprEqualString();
        if source_kind == AstExpressionNodeInequality() {
            kind = DirectMirScalarProgramExprNotEqualString();
        }
        return DirectMirScalarProgramExpressionKindFact(
            true, kind, CompilerAbiLayoutBoolTypeName(), "");
    }
    return invalid;
}
