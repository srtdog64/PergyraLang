// Strict receipt parser and straight-line transition issuer for empty literals.
import "direct_mir_scalar_program_collection_ownership_transition_fact_owner.pgy";
import "direct_mir_scalar_program_collection_ownership_transition_policy_owner.pgy";
import "direct_mir_scalar_program_collection_ownership_cfg_flow_owner.pgy";
import "direct_mir_scalar_cfg_program_graph_storage_owner.pgy";
import "direct_mir_scalar_program_expression_fact_owner.pgy";
import "direct_mir_scalar_program_collection_ownership_receipt_source_owner.pgy";
import "direct_mir_scalar_program_collection_ownership_binding_local_owner.pgy";
import "../mir_lower/routine_fact_index_schema_owner.pgy";

struct DirectMirCollectionOwnershipInstructionReceipt {
    let valid: Bool;
    let present: Bool;
    let effect_kind: Int;
    let receiver_binding_syntax_id: Int;
    let source_binding_syntax_id: Int;
}

func DirectMirCollectionOwnershipInstructionReceiptInvalid(
) -> DirectMirCollectionOwnershipInstructionReceipt {
    return DirectMirCollectionOwnershipInstructionReceipt(
        false, false, 0, 0, 0
    );
}

func DirectMirCollectionOwnershipInstructionReceiptFromJson(
    ref instruction: JsonObjectFactTable
) -> DirectMirCollectionOwnershipInstructionReceipt {
    let kind_opt: Option<String> = JsonObjectFactValueKind(
        instruction, "collection_ownership_receipt"
    );
    if !IsSome(kind_opt) {
        return DirectMirCollectionOwnershipInstructionReceiptInvalid();
    }
    if UnwrapOption(kind_opt) == "null" {
        return DirectMirCollectionOwnershipInstructionReceipt(
            true, false, 0, 0, 0
        );
    }
    if UnwrapOption(kind_opt) != "object" {
        return DirectMirCollectionOwnershipInstructionReceiptInvalid();
    }
    let receipt: JsonObjectFactTable = JsonObjectFactObjectTable(
        instruction, "collection_ownership_receipt"
    );
    let kind: Option<String> = JsonObjectFactStringFieldOpt(receipt, "kind");
    let receiver: Option<String> = JsonObjectFactNumberFieldOpt(
        receipt, "receiver_binding_syntax_id"
    );
    let source: Option<String> = JsonObjectFactNumberFieldOpt(
        receipt, "source_binding_syntax_id"
    );
    if !JsonObjectFactTableReady(receipt) || JsonObjectFactCount(receipt) != 3 ||
        !IsSome(kind) || !IsSome(receiver) || !IsSome(source) ||
        ToString(ToInt(UnwrapOption(receiver))) != UnwrapOption(receiver) ||
        ToString(ToInt(UnwrapOption(source))) != UnwrapOption(source) ||
        ToInt(UnwrapOption(receiver)) <= 0 || ToInt(UnwrapOption(source)) < 0 {
        return DirectMirCollectionOwnershipInstructionReceiptInvalid();
    }
    let effect: Int = 0;
    if UnwrapOption(kind) == "owned-string-push" { effect = 1; }
    else if UnwrapOption(kind) == "shallow-mutation" { effect = 2; }
    else if UnwrapOption(kind) == "drop" { effect = 3; }
    if effect == 0 {
        return DirectMirCollectionOwnershipInstructionReceiptInvalid();
    }
    if ToInt(UnwrapOption(source)) != 0 && effect != 1 {
        return DirectMirCollectionOwnershipInstructionReceiptInvalid();
    }
    return DirectMirCollectionOwnershipInstructionReceipt(
        true, true, effect, ToInt(UnwrapOption(receiver)),
        ToInt(UnwrapOption(source))
    );
}

func DirectMirCollectionOwnershipTrackedRowForLocal(
    ref fact: DirectMirScalarProgramCollectionOwnershipTransitionFact,
    routine: Int,
    local_row: Int
) -> Int {
    return DirectMirScalarProgramCollectionOwnershipTransitionRow(
        fact, routine, local_row
    );
}

func DirectMirCollectionOwnershipInstructionSetHasTransitionReceipt(
    json: String,
    ref index: MirRoutineFactIndex,
    binding_syntax_id: Int
) -> Bool {
    let instruction: Int = 0;
    while instruction < ArrayLength(index.instruction_facts.starts) {
        let instruction_object: JsonObjectFactTable = JsonObjectFactTableFromBounds(
            json, index.instruction_facts.starts[instruction],
            index.instruction_facts.ends[instruction]
        );
        let receipt: DirectMirCollectionOwnershipInstructionReceipt =
            DirectMirCollectionOwnershipInstructionReceiptFromJson(
                instruction_object
            );
        if receipt.valid && receipt.present &&
            receipt.receiver_binding_syntax_id == binding_syntax_id {
            return true;
        }
        instruction = instruction + 1;
    }
    return false;
}

func DirectMirCollectionOwnershipOperationSetRequiresTransition(
    ref storage: DirectMirScalarCfgProgramGraphStorage,
    ref expressions: DirectMirScalarProgramExpressionSet,
    operation_start: Int,
    operation_count: Int,
    local_row: Int
) -> Bool {
    if operation_start < 0 || operation_count < 0 || local_row < 0 ||
        operation_start + operation_count >
            ArrayLength(storage.operations.kinds) {
        return false;
    }
    let operation: Int = operation_start;
    let operation_end: Int = operation_start + operation_count;
    while operation < operation_end {
        let operation_local: Int = -1;
        let effect: Int = DirectMirCollectionOwnershipExpectedOperationEffect(
            storage, expressions, operation, operation_local);
        if effect != 0 && operation_local == local_row { return true; }
        operation = operation + 1;
    }
    return false;
}

func DirectMirCollectionOwnershipEmptyBindingForLocal(
    ref index: MirRoutineFactIndex,
    ref storage: DirectMirScalarCfgProgramGraphStorage,
    local_row: Int
) -> Int {
    if local_row < 0 ||
        local_row >= ArrayLength(storage.values.local_ref_value_ids) {
        return 0;
    }
    let matched: Int = 0;
    let row: Int = 0;
    while row < ArrayLength(
            index.collection_ownership_facts.binding_syntax_ids) {
        let binding: Int = index.collection_ownership_facts.
            binding_syntax_ids[row];
        if index.collection_ownership_facts.origins[row] ==
                "empty-literal" &&
            storage.values.local_ref_value_ids[local_row] == Concat(
                "declaration:", Concat(ToString(binding), ":0")
            ) {
            if matched != 0 { return 0; }
            matched = binding;
        }
        row = row + 1;
    }
    return matched;
}

func DirectMirScalarProgramCollectionOwnershipTransitionAppendRoutine(
    fact: DirectMirScalarProgramCollectionOwnershipTransitionFact,
    json: String,
    ref index: MirRoutineFactIndex,
    ref storage: DirectMirScalarCfgProgramGraphStorage,
    ref expressions: DirectMirScalarProgramExpressionSet,
    ref callables: DirectMirScalarCfgProgramCallableInventory,
    routine: Int,
    local_offset: Int,
    operation_offset: Int
) -> DirectMirScalarProgramCollectionOwnershipTransitionFact {
    if !fact.valid || fact.digest != 0 || !index.valid ||
        !index.collection_ownership_facts.valid ||
        routine < 0 || local_offset < 0 || operation_offset < 0 {
        return DirectMirScalarProgramCollectionOwnershipTransitionFactInvalid();
    }
    let routines: Array<Int> = fact.routine_ordinals;
    let locals: Array<Int> = fact.local_rows;
    let bindings: Array<Int> = fact.binding_syntax_ids;
    let states: Array<Int> = fact.terminal_states;
    let retire_rows: Array<Int> = [];
    let cfg_rows: Array<Int> = [];
    let ownership_row: Int = 0;
    while ownership_row < ArrayLength(
            index.collection_ownership_facts.binding_syntax_ids) {
        let origin: String =
            index.collection_ownership_facts.origins[ownership_row];
        let retired: Bool = index.collection_ownership_facts.dispositions[
            ownership_row] == "retired";
        if origin == "empty-literal" || origin == "member-move" ||
                origin == "binding" || retired {
            let binding: Int = index.collection_ownership_facts.
                binding_syntax_ids[ownership_row];
            let local_end: Int = local_offset +
                storage.routines.local_counts[routine];
            let matched_local: Int =
                DirectMirCollectionOwnershipBindingLocalRow(
                    index, storage, binding, local_offset, local_end);
            if matched_local < 0 || storage.values.local_types[matched_local] !=
                    CompilerAbiLayoutArrayStringTypeName() {
                return DirectMirScalarProgramCollectionOwnershipTransitionFactInvalid();
            }
            let requires_transition: Bool = origin == "member-move" ||
                origin == "binding" || retired ||
                DirectMirCollectionOwnershipInstructionSetHasTransitionReceipt(
                    json, index, binding) ||
                DirectMirCollectionOwnershipOperationSetRequiresTransition(
                    storage, expressions, operation_offset,
                    storage.routines.operation_counts[routine], matched_local);
            if requires_transition {
                if ArrayLength(index.block_starts) != 1 &&
                    (origin == "member-move" || origin == "binding" ||
                     retired) {
                    return DirectMirScalarProgramCollectionOwnershipTransitionFactInvalid();
                }
                ArrayPush(routines, routine);
                ArrayPush(locals, matched_local);
                ArrayPush(bindings, binding);
                let initial_state: Int =
                    DirectMirCollectionOwnershipStateEmpty();
                let ownership: String = index.collection_ownership_facts.
                    element_ownerships[ownership_row];
                if ownership == "borrowed-elements" {
                    initial_state = DirectMirCollectionOwnershipStateBorrowed();
                } else if ownership == "owned-elements" ||
                        ownership == "map-keys-snapshot" {
                    initial_state = DirectMirCollectionOwnershipStateOwned();
                } else if origin != "empty-literal" {
                    initial_state =
                        DirectMirCollectionOwnershipStateUnknown();
                }
                if ArrayLength(index.block_starts) != 1 {
                    initial_state = DirectMirCollectionOwnershipCfgTerminalState(
                        index, storage, expressions, routine, matched_local,
                        initial_state
                    );
                    if initial_state == 0 {
                        return DirectMirScalarProgramCollectionOwnershipTransitionFactInvalid();
                    }
                    ArrayPush(cfg_rows, ArrayLength(routines) - 1);
                }
                ArrayPush(states, initial_state);
                if retired {
                    ArrayPush(retire_rows, ArrayLength(routines) - 1);
                }
            }
        }
        ownership_row = ownership_row + 1;
    }
    let working: DirectMirScalarProgramCollectionOwnershipTransitionFact =
        DirectMirScalarProgramCollectionOwnershipTransitionFact(
            true, 0, routines, locals, bindings, states
        );
    let operation: Int = operation_offset;
    let operation_end: Int = operation_offset +
        storage.routines.operation_counts[routine];
    // Read only the already bounded instruction objects; no program-root scan.
    let instruction: Int = 0;
    while instruction < ArrayLength(index.instruction_facts.starts) {
        let instruction_object: JsonObjectFactTable = JsonObjectFactTableFromBounds(
            json, index.instruction_facts.starts[instruction],
            index.instruction_facts.ends[instruction]
        );
        let kind: Option<String> = JsonObjectFactStringFieldOpt(
            instruction_object, "kind"
        );
        let receipt: DirectMirCollectionOwnershipInstructionReceipt =
            DirectMirCollectionOwnershipInstructionReceiptFromJson(
                instruction_object
            );
        if !JsonObjectFactTableReady(instruction_object) || !IsSome(kind) ||
            !receipt.valid {
            return DirectMirScalarProgramCollectionOwnershipTransitionFactInvalid();
        }
        if DirectMirCollectionOwnershipOperationKindProducesRow(
                UnwrapOption(kind)) {
            if operation < operation_offset || operation >= operation_end {
                return DirectMirScalarProgramCollectionOwnershipTransitionFactInvalid();
            }
            let local_row: Int = -1;
            let expected_effect: Int =
                DirectMirCollectionOwnershipExpectedOperationEffect(
                    storage, expressions, operation, local_row
                );
            let tracked: Int =
                DirectMirCollectionOwnershipTrackedRowForLocal(
                    working, routine, local_row
                );
            if tracked >= 0 {
                let next: Int = 0;
                let cfg_tracked: Bool = false;
                let cfg_index: Int = 0;
                while cfg_index < ArrayLength(cfg_rows) {
                    if cfg_rows[cfg_index] == tracked { cfg_tracked = true; }
                    cfg_index = cfg_index + 1;
                }
                if expected_effect == 0 && !receipt.present { next = states[tracked]; } else if cfg_tracked {
                    if expected_effect == 0 || !receipt.present ||
                        receipt.effect_kind != expected_effect ||
                        receipt.receiver_binding_syntax_id != bindings[tracked] ||
                        !DirectMirCollectionOwnershipReceiptSourceReady(
                            receipt.present, receipt.effect_kind,
                            receipt.source_binding_syntax_id, callables,
                            storage, expressions, operation) {
                        return DirectMirScalarProgramCollectionOwnershipTransitionFactInvalid();
                    }
                    next = states[tracked];
                } else if states[tracked] ==
                        DirectMirCollectionOwnershipStateUnknown() {
                    if expected_effect != 2 || receipt.present {
                        return DirectMirScalarProgramCollectionOwnershipTransitionFactInvalid();
                    }
                    next = DirectMirCollectionOwnershipNextState(
                        states[tracked], expected_effect
                    );
                } else {
                    if expected_effect == 0 || !receipt.present ||
                        receipt.effect_kind != expected_effect ||
                        receipt.receiver_binding_syntax_id !=
                            bindings[tracked] ||
                        !DirectMirCollectionOwnershipReceiptSourceReady(
                            receipt.present, receipt.effect_kind,
                            receipt.source_binding_syntax_id, callables,
                            storage, expressions, operation) {
                        return DirectMirScalarProgramCollectionOwnershipTransitionFactInvalid();
                    }
                    next = DirectMirCollectionOwnershipNextState(
                        states[tracked], expected_effect
                    );
                }
                if next == 0 {
                    return DirectMirScalarProgramCollectionOwnershipTransitionFactInvalid();
                }
                ArraySet(states, tracked, next);
            } else if receipt.present {
                let empty_binding: Int =
                    DirectMirCollectionOwnershipEmptyBindingForLocal(
                        index, storage, local_row
                    );
                if expected_effect == 0 ||
                    receipt.effect_kind != expected_effect ||
                    receipt.effect_kind == 3 || empty_binding == 0 ||
                    receipt.receiver_binding_syntax_id != empty_binding ||
                    !DirectMirCollectionOwnershipReceiptSourceReady(
                        receipt.present, receipt.effect_kind,
                        receipt.source_binding_syntax_id, callables,
                        storage, expressions, operation) {
                    return DirectMirScalarProgramCollectionOwnershipTransitionFactInvalid();
                }
            }
            operation = operation + 1;
        } else if receipt.present {
            return DirectMirScalarProgramCollectionOwnershipTransitionFactInvalid();
        }
        instruction = instruction + 1;
    }
    if operation != operation_end {
        return DirectMirScalarProgramCollectionOwnershipTransitionFactInvalid();
    }
    let retire: Int = 0;
    while retire < ArrayLength(retire_rows) {
        ArraySet(states, retire_rows[retire],
            DirectMirCollectionOwnershipStateRetired());
        retire = retire + 1;
    }
    return DirectMirScalarProgramCollectionOwnershipTransitionFact(
        true, 0, routines, locals, bindings, states
    );
}
