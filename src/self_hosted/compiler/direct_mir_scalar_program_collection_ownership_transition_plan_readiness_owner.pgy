// Cross-link sealed ownership transitions to their exact GraphPlan locals.

import "direct_mir_scalar_cfg_graph_fact_owner.pgy";
import "direct_mir_scalar_program_collection_ownership_transition_fact_owner.pgy";
import "direct_mir_scalar_program_owned_string_call_result_argument_owner.pgy";
import "abi_layout_row_owner.pgy";

func DirectMirScalarProgramCollectionOwnershipTransitionReadyForPlan(
    ref plan: DirectMirScalarCfgGraphPlan
) -> Bool {
    if !DirectMirScalarProgramCollectionOwnershipTransitionFactReady(
            plan.program.collection_ownership) {
        return false;
    }
    let row: Int = 0;
    while row < ArrayLength(
            plan.program.collection_ownership.routine_ordinals) {
        let routine: Int =
            plan.program.collection_ownership.routine_ordinals[row];
        let local_row: Int =
            plan.program.collection_ownership.local_rows[row];
        if routine < 0 || routine >= ArrayLength(plan.routines.roles) ||
            local_row < 0 || local_row >= ArrayLength(plan.local_types) ||
            DirectMirScalarCfgRoutinePartitionLocalOwner(
                plan.routines, local_row) != routine ||
            plan.routines.block_counts[routine] < 1 ||
            plan.local_types[local_row] !=
                CompilerAbiLayoutArrayStringTypeName() ||
            plan.local_ref_value_ids[local_row] != Concat(
                "declaration:", Concat(
                    ToString(plan.program.collection_ownership.
                        binding_syntax_ids[row]), ":0"
                )
            ) {
            return false;
        }
        row = row + 1;
    }
    let operation: Int = 0;
    while operation < ArrayLength(plan.operation_kinds) {
        if plan.operation_kinds[operation] ==
                DirectMirScalarCfgOpLocalArrayStringPush() {
            let expression: Int =
                plan.program.operation_expression_rows[operation];
            if expression < 0 || expression >= ArrayLength(
                    plan.program.expressions.graph_roots) {
                return false;
            }
            let root: Int = plan.program.expressions.graph_roots[expression];
            if root >= 0 && root < ArrayLength(
                    plan.program.expressions.node_kinds) &&
                plan.program.expressions.node_kinds[root] ==
                    DirectMirScalarProgramExprDirectCall() &&
                !DirectMirScalarProgramFunctionReturnsOwnedString(
                    plan, plan.program.expressions.node_callable_rows[root], 0) {
                return false;
            }
        }
        operation = operation + 1;
    }
    return true;
}
