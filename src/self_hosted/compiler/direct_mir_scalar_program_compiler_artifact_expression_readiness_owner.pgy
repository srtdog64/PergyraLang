// Fail-closed shapes for normalized compiler-artifact transaction calls.
import "direct_mir_scalar_program_expression_fact_owner.pgy";
import "runtime_call_abi_structured_fact_owner.pgy";

func DirectMirScalarProgramCompilerArtifactExpressionNodeReady(
    ref facts: DirectMirScalarProgramExpressionSet, node: Int
) -> Option<Bool> {
    let kind: Int = facts.node_kinds[node];
    if kind != DirectMirScalarProgramExprCompilerArtifactWrite() &&
        kind != DirectMirScalarProgramExprCompilerArtifactBegin() &&
        kind != DirectMirScalarProgramExprCompilerArtifactCommit() &&
        kind != DirectMirScalarProgramExprCompilerArtifactAbort() {
        return None;
    }
    let left: Int = facts.node_lefts[node];
    let right: Int = facts.node_rights[node];
    let nary: Array<Int> = DirectMirScalarProgramNaryOperandRows(
        facts.nary_operands, node);
    let runtime: CompilerRuntimeCallAbiFact =
        CompilerRuntimeCallAbiFactMissing();
    let runtime_ready: Bool = false;
    if kind == DirectMirScalarProgramExprCompilerArtifactWrite() {
        runtime = CompilerRuntimeCallAbiCompilerArtifactWriteFact();
        runtime_ready =
            CompilerRuntimeCallAbiCompilerArtifactWriteFactReady(runtime);
    } else if kind == DirectMirScalarProgramExprCompilerArtifactBegin() {
        runtime = CompilerRuntimeCallAbiCompilerArtifactBeginFact();
        runtime_ready =
            CompilerRuntimeCallAbiCompilerArtifactBeginFactReady(runtime);
    } else if kind == DirectMirScalarProgramExprCompilerArtifactCommit() {
        runtime = CompilerRuntimeCallAbiCompilerArtifactCommitFact();
        runtime_ready =
            CompilerRuntimeCallAbiCompilerArtifactCommitFactReady(runtime);
    } else {
        runtime = CompilerRuntimeCallAbiCompilerArtifactAbortFact();
        runtime_ready =
            CompilerRuntimeCallAbiCompilerArtifactAbortFactReady(runtime);
    }
    let expected_result: String = CompilerAbiLayoutIntTypeName();
    if kind == DirectMirScalarProgramExprCompilerArtifactWrite() {
        expected_result = CompilerAbiLayoutBoolTypeName();
    }
    if ArrayLength(nary) != 0 || !runtime_ready ||
        facts.node_runtime_call_abi_ids[node] != runtime.runtime_call_abi_id ||
        facts.node_types[node] != expected_result ||
        facts.node_local_rows[node] != -1 ||
        facts.node_parameter_ordinals[node] != -1 ||
        facts.node_literals[node] != "" || facts.node_callable_rows[node] != -1 {
        return Some(false);
    }
    if kind == DirectMirScalarProgramExprCompilerArtifactWrite() {
        return Some(left >= 0 && left < node && right >= 0 && right < node &&
            facts.node_types[left] == CompilerAbiLayoutIntTypeName() &&
            facts.node_types[right] == CompilerAbiLayoutStringTypeName());
    }
    let expected_parameter: String = CompilerAbiLayoutIntTypeName();
    if kind == DirectMirScalarProgramExprCompilerArtifactBegin() {
        expected_parameter = CompilerAbiLayoutStringTypeName();
    }
    return Some(left >= 0 && left < node && right == -1 &&
        facts.node_types[left] == expected_parameter);
}
