// Sealed compiler-artifact transaction runtime requirement.
import "direct_mir_scalar_program_expression_fact_owner.pgy";
import "direct_mir_scalar_program_expression_kind_query_owner.pgy";
import "runtime_call_abi_structured_fact_owner.pgy";

struct DirectMirScalarProgramCompilerArtifactRuntimeRequirement {
    let valid: Bool;
    let runtime_call_abi_id: Int;
    let begin_runtime_call_abi_id: Int;
    let commit_runtime_call_abi_id: Int;
    let abort_runtime_call_abi_id: Int;
}

func DirectMirScalarProgramCompilerArtifactRuntimeRequirementFromExpressions(
    ref expressions: DirectMirScalarProgramExpressionSet
) -> DirectMirScalarProgramCompilerArtifactRuntimeRequirement {
    let write_required: Bool = DirectMirScalarProgramExpressionContainsKind(
        expressions, DirectMirScalarProgramExprCompilerArtifactWrite());
    let begin_required: Bool = DirectMirScalarProgramExpressionContainsKind(
        expressions, DirectMirScalarProgramExprCompilerArtifactBegin());
    let commit_required: Bool = DirectMirScalarProgramExpressionContainsKind(
        expressions, DirectMirScalarProgramExprCompilerArtifactCommit());
    let abort_required: Bool = DirectMirScalarProgramExpressionContainsKind(
        expressions, DirectMirScalarProgramExprCompilerArtifactAbort());
    let write: CompilerRuntimeCallAbiFact =
        CompilerRuntimeCallAbiCompilerArtifactWriteFact();
    let begin: CompilerRuntimeCallAbiFact =
        CompilerRuntimeCallAbiCompilerArtifactBeginFact();
    let commit: CompilerRuntimeCallAbiFact =
        CompilerRuntimeCallAbiCompilerArtifactCommitFact();
    let abort: CompilerRuntimeCallAbiFact =
        CompilerRuntimeCallAbiCompilerArtifactAbortFact();
    if (write_required &&
            !CompilerRuntimeCallAbiCompilerArtifactWriteFactReady(write)) ||
        (begin_required &&
            !CompilerRuntimeCallAbiCompilerArtifactBeginFactReady(begin)) ||
        (commit_required &&
            !CompilerRuntimeCallAbiCompilerArtifactCommitFactReady(commit)) ||
        (abort_required &&
            !CompilerRuntimeCallAbiCompilerArtifactAbortFactReady(abort)) {
        return DirectMirScalarProgramCompilerArtifactRuntimeRequirement(
            false, 0, 0, 0, 0);
    }
    let write_id: Int = 0; let begin_id: Int = 0;
    let commit_id: Int = 0; let abort_id: Int = 0;
    if write_required { write_id = write.runtime_call_abi_id; }
    if begin_required { begin_id = begin.runtime_call_abi_id; }
    if commit_required { commit_id = commit.runtime_call_abi_id; }
    if abort_required { abort_id = abort.runtime_call_abi_id; }
    return DirectMirScalarProgramCompilerArtifactRuntimeRequirement(
        true, write_id, begin_id, commit_id, abort_id);
}
