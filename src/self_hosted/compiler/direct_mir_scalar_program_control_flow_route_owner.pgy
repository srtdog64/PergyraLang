// Scalar control-flow claim; the shared GraphPlan owns exact instruction admission.

import "direct_mir_routine_signature_fact_owner.pgy";
import "direct_mir_scalar_cfg_type_family_owner.pgy";
import "../mir_lower/routine_fact_index_owner.pgy";

func DirectMirScalarControlFlowProgramRouteClaimed(
    ref admitted: MirMachineLayerAdmittedJsonInput
) -> Bool {
    if MirProgramRoutineIndexCount(admitted.routines) != 1 ||
        !MirProgramRoutineIndexRowReady(admitted.routines, 0) ||
        !JsonArrayObjectFactTableReady(admitted.document.declarations) ||
        JsonArrayObjectFactCount(admitted.document.declarations) != 0 {
        return false;
    }
    let first_block_count: Int =
        MirProgramRoutineIndexBlockInstructionCountAt(
            admitted.routines, 0, 0
        );
    let signature: DirectMirRoutineSignatureFact =
        DirectMirRoutineSignatureFactAt(
            admitted.routines, 0, first_block_count
        );
    if !DirectMirRoutineSignatureFactReady(signature) ||
        signature.name != "Main" || signature.return_type != "Void" ||
        signature.param_count != 0 {
        return false;
    }
    let index: MirRoutineFactIndex = BuildMirRoutineFactIndex(
        admitted.routines, 0
    );
    if !index.valid {
        return false;
    }
    return DirectMirScalarControlFlowRoutineRouteClaimed(admitted, signature, index);
}

func DirectMirScalarControlFlowRoutineRouteClaimed(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    ref signature: DirectMirRoutineSignatureFact,
    ref index: MirRoutineFactIndex
) -> Bool {
    if !DirectMirRoutineSignatureFactReady(signature) || !index.valid ||
        signature.kind != "function" ||
        (signature.return_type != "Void" &&
            !DirectMirScalarCfgScalarTypeSupported(signature.return_type)) { return false; }
    let parameter: Int = 0;
    while parameter < signature.param_count {
        if !DirectMirScalarCfgScalarTypeSupported(signature.parameters.type_names[parameter]) ||
            (signature.parameters.carriages[parameter] != "value" &&
             signature.parameters.carriages[parameter] != "value-result") { return false; }
        parameter = parameter + 1;
    }
    let local_binding: Int = 0;
    while local_binding < ArrayLength(index.source_local_types) {
        if !DirectMirScalarCfgScalarTypeSupported(
                index.source_local_types[local_binding]) {
            return false;
        }
        local_binding = local_binding + 1;
    }
    let row: Int = 0;
    while row < ArrayLength(index.instruction_facts.starts) {
        let global_row: Int = index.instruction_facts.global_start + row;
        let kind: String = admitted.routines.instruction_kinds[global_row];
        if kind != "branch" && kind != "def" && kind != "assign" && kind != "phi" &&
                kind != "stmt" && kind != "return" {
            return false;
        }
        row = row + 1;
    }
    return true;
}
