// Exact proof that an empty terminal block follows one exhaustive enum match.

import "direct_mir_scalar_program_payload_free_enum_exhaustive_match_owner.pgy";

struct DirectMirScalarProgramPayloadEnumMatchConditionFact {
    let valid: Bool;
    let enum_row: Int;
    let variant_ordinal: Int;
    let source_start: Int;
    let source_count: Int;
    let scrutinee_offset: Int;
}

func DirectMirScalarProgramPayloadEnumMatchConditionInvalid(
) -> DirectMirScalarProgramPayloadEnumMatchConditionFact {
    return DirectMirScalarProgramPayloadEnumMatchConditionFact(
        false, -1, -1, -1, 0, -1);
}

func DirectMirScalarProgramPayloadEnumMatchConditionAt(
    ref plan: DirectMirScalarCfgGraphPlan, block: Int
) -> DirectMirScalarProgramPayloadEnumMatchConditionFact {
    let invalid: DirectMirScalarProgramPayloadEnumMatchConditionFact =
        DirectMirScalarProgramPayloadEnumMatchConditionInvalid();
    if block < 0 || block >= ArrayLength(plan.block_condition_kinds) ||
        plan.block_condition_kinds[block] !=
            DirectMirScalarCfgConditionExpression() {
        return invalid;
    }
    let expression_row: Int =
        plan.program.block_condition_expression_rows[block];
    if expression_row < 0 || expression_row >=
            ArrayLength(plan.program.expressions.graph_starts) {
        return invalid;
    }
    let start: Int = plan.program.expressions.graph_starts[expression_row];
    let count: Int = plan.program.expressions.graph_counts[expression_row];
    let root: Int = plan.program.expressions.graph_roots[expression_row];
    if count < 2 || root != start + count - 1 ||
        root >= ArrayLength(plan.program.expressions.node_kinds) ||
        plan.program.expressions.node_kinds[root] !=
            DirectMirScalarProgramExprPayloadEnumMatch() ||
        plan.program.expressions.node_types[root] !=
            CompilerAbiLayoutBoolTypeName() {
        return invalid;
    }
    let source_count: Int = count - 1;
    let scrutinee: Int = plan.program.expressions.node_lefts[root];
    if scrutinee < start || scrutinee >= start + source_count ||
        plan.program.expressions.node_rights[root] != -1 {
        return invalid;
    }
    let enum_row: Int = DirectMirScalarProgramReferencedEnumRow(
        plan.program.referenced_enum,
        plan.program.expressions.node_types[scrutinee]);
    let ordinal: Int = plan.program.expressions.node_member_ordinals[root];
    if enum_row < 0 ||
        plan.program.referenced_enum.payload_flags[enum_row] != 1 ||
        ordinal < 0 || ordinal >=
            plan.program.referenced_enum.variant_counts[enum_row] {
        return invalid;
    }
    let arity: Int = plan.program.referenced_enum.variant_param_counts[
        plan.program.referenced_enum.variant_starts[enum_row] + ordinal];
    let binding: Int = plan.program.expressions.node_local_rows[root];
    if (arity == 0 && binding != -1) || (arity > 0 && binding < 0) {
        return invalid;
    }
    let node: Int = start;
    while node < start + source_count {
        if !DirectMirScalarProgramPayloadFreeEnumStableScrutineeKind(
                plan.program.expressions.node_kinds[node]) ||
            plan.program.expressions.node_callable_rows[node] != -1 ||
            plan.program.expressions.node_runtime_call_abi_ids[node] != -1 {
            return invalid;
        }
        node = node + 1;
    }
    return DirectMirScalarProgramPayloadEnumMatchConditionFact(
        true, enum_row, ordinal, start, source_count, scrutinee - start);
}

func DirectMirScalarProgramPayloadEnumMatchScrutineeSame(
    ref expressions: DirectMirScalarProgramExpressionSet,
    left: DirectMirScalarProgramPayloadEnumMatchConditionFact,
    right: DirectMirScalarProgramPayloadEnumMatchConditionFact
) -> Bool {
    if !left.valid || !right.valid || left.enum_row != right.enum_row ||
        left.source_count != right.source_count ||
        left.scrutinee_offset != right.scrutinee_offset { return false; }
    let offset: Int = 0;
    while offset < left.source_count {
        let a: Int = left.source_start + offset;
        let b: Int = right.source_start + offset;
        let a_left: Int = DirectMirScalarProgramPayloadFreeEnumRelativeEdge(
            expressions.node_lefts[a], left.source_start, left.source_count);
        let b_left: Int = DirectMirScalarProgramPayloadFreeEnumRelativeEdge(
            expressions.node_lefts[b], right.source_start, right.source_count);
        let a_right: Int = DirectMirScalarProgramPayloadFreeEnumRelativeEdge(
            expressions.node_rights[a], left.source_start, left.source_count);
        let b_right: Int = DirectMirScalarProgramPayloadFreeEnumRelativeEdge(
            expressions.node_rights[b], right.source_start, right.source_count);
        if expressions.node_kinds[a] != expressions.node_kinds[b] ||
            expressions.node_types[a] != expressions.node_types[b] ||
            expressions.node_local_rows[a] != expressions.node_local_rows[b] ||
            expressions.node_parameter_ordinals[a] !=
                expressions.node_parameter_ordinals[b] ||
            expressions.node_member_ordinals[a] !=
                expressions.node_member_ordinals[b] ||
            expressions.node_literals[a] != expressions.node_literals[b] ||
            a_left == -2 || b_left == -2 || a_right == -2 || b_right == -2 ||
            a_left != b_left || a_right != b_right {
            return false;
        }
        offset = offset + 1;
    }
    return true;
}

// Project each typed condition once. The shape tag separates the two enum
// inventories; equal row numbers across them are not equal type identities.
struct DirectMirScalarProgramEnumGuardFact {
    let shape: Int;
    let variant: Int;
    let count: Int;
    let plain: DirectMirScalarProgramPayloadFreeEnumMatchConditionFact;
    let payload: DirectMirScalarProgramPayloadEnumMatchConditionFact;
}

func DirectMirScalarProgramEnumGuardAt(
    ref plan: DirectMirScalarCfgGraphPlan, block: Int
) -> DirectMirScalarProgramEnumGuardFact {
    let plain: DirectMirScalarProgramPayloadFreeEnumMatchConditionFact =
        DirectMirScalarProgramPayloadFreeEnumMatchConditionAt(plan, block);
    let payload: DirectMirScalarProgramPayloadEnumMatchConditionFact =
        DirectMirScalarProgramPayloadEnumMatchConditionAt(plan, block);
    if plain.valid {
        return DirectMirScalarProgramEnumGuardFact(1, plain.variant_ordinal,
            plan.program.payload_free_enum.variant_counts[plain.enum_row], plain, payload);
    }
    if payload.valid {
        return DirectMirScalarProgramEnumGuardFact(2, payload.variant_ordinal,
            plan.program.referenced_enum.variant_counts[payload.enum_row], plain, payload);
    }
    return DirectMirScalarProgramEnumGuardFact(0, -1, 0, plain, payload);
}

func DirectMirScalarProgramEnumGuardSame(
    ref expressions: DirectMirScalarProgramExpressionSet,
    left: DirectMirScalarProgramEnumGuardFact, right: DirectMirScalarProgramEnumGuardFact
) -> Bool {
    if left.shape != right.shape || left.count != right.count { return false; }
    if left.shape == 1 {
        return DirectMirScalarProgramPayloadFreeEnumMatchScrutineeSame(
            expressions, left.plain, right.plain);
    }
    if left.shape == 2 {
        return DirectMirScalarProgramPayloadEnumMatchScrutineeSame(
            expressions, left.payload, right.payload);
    }
    return false;
}

// Routine-local proof, not a source/backend fallback. A false edge is excluded
// only by a unique predecessor chain testing the same stable scrutinee, without
// intervening operations. Distinct variants count once. Then a worklist removes
// blocks whose every incoming edge is excluded or comes from a proved-dead block.
// The entry block is never removed, even if a backedge targets it.
func DirectMirScalarProgramEnumUnreachableBlocks(
    ref plan: DirectMirScalarCfgGraphPlan, routine: Int
) -> Array<Int> {
    let invalid: Array<Int> = [];
    if routine < 0 || routine >= ArrayLength(plan.routines.roles) { return invalid; }
    let first: Int = plan.routines.block_starts[routine];
    let count: Int = plan.routines.block_counts[routine];
    let end: Int = first + count;
    if first < 0 || count < 1 || end > ArrayLength(plan.block_succ_true) ||
        end > ArrayLength(plan.block_succ_false) { return invalid; }
    let guards: Array<DirectMirScalarProgramEnumGuardFact> = [];
    let incoming: Array<Int> = [];
    let predecessor: Array<Int> = [];
    let false_excluded: Array<Int> = [];
    let dead: Array<Int> = [];
    let row: Int = 0;
    while row < count {
        ArrayPush(guards, DirectMirScalarProgramEnumGuardAt(plan, first + row));
        ArrayPush(incoming, 0); ArrayPush(predecessor, -1);
        ArrayPush(false_excluded, 0); ArrayPush(dead, 0);
        row = row + 1;
    }
    row = 0;
    while row < count {
        let side: Int = 0;
        while side < 2 {
            let target: Int = plan.block_succ_true[first + row];
            if side == 1 { target = plan.block_succ_false[first + row]; }
            if target < -1 || target >= end || (target >= 0 && target < first) { return invalid; }
            if target >= 0 {
                let target_row: Int = target - first;
                incoming[target_row] = incoming[target_row] + 1;
                predecessor[target_row] = first + row;
            }
            side = side + 1;
        }
        row = row + 1;
    }
    row = 0;
    while row < count {
        let guard_fact: DirectMirScalarProgramEnumGuardFact = guards[row];
        if guard_fact.shape != 0 && guard_fact.count > 0 {
            let seen: HashMap<Int, Int> = MapNew();
            let distinct: Int = 0;
            let current: Int = first + row;
            let hops: Int = 0;
            while hops < count {
                let prior: DirectMirScalarProgramEnumGuardFact = guards[current - first];
                if !DirectMirScalarProgramEnumGuardSame(plan.program.expressions, guard_fact, prior) ||
                    plan.program.block_return_expression_rows[current] != -1 { break; }
                if !MapHas(seen, prior.variant) {
                    MapSet(seen, prior.variant, 1); distinct = distinct + 1;
                }
                if distinct == guard_fact.count { false_excluded[row] = 1; break; }
                // An entry can be reached without traversing any predecessor.
                if current == first || plan.block_operation_counts[current] != 0 ||
                    incoming[current - first] != 1 { break; }
                let parent: Int = predecessor[current - first];
                if parent < first || plan.block_succ_false[parent] != current ||
                    plan.block_succ_true[parent] == current { break; }
                current = parent; hops = hops + 1;
            }
        }
        row = row + 1;
    }
    row = 0;
    while row < count {
        let target: Int = plan.block_succ_false[first + row];
        if false_excluded[row] == 1 && target >= 0 {
            incoming[target - first] = incoming[target - first] - 1;
        }
        row = row + 1;
    }
    let pending: Array<Int> = [];
    row = 1;
    while row < count {
        if incoming[row] == 0 { dead[row] = 1; ArrayPush(pending, first + row); }
        row = row + 1;
    }
    let cursor: Int = 0;
    while cursor < ArrayLength(pending) {
        let block: Int = pending[cursor];
        let side: Int = 0;
        while side < 2 {
            let target: Int = plan.block_succ_true[block];
            if side == 1 { target = plan.block_succ_false[block]; }
            if target >= 0 && (side == 0 || false_excluded[block - first] == 0) {
                let target_row: Int = target - first;
                incoming[target_row] = incoming[target_row] - 1;
                if incoming[target_row] == 0 && target_row != 0 && dead[target_row] == 0 {
                    dead[target_row] = 1; ArrayPush(pending, target);
                }
            }
            side = side + 1;
        }
        cursor = cursor + 1;
    }
    return dead;
}

func DirectMirScalarProgramEnumExhaustiveMatchFallthroughReadinessCode(
    ref plan: DirectMirScalarCfgGraphPlan, routine: Int, fallthrough: Int,
    ref unreachable: Array<Int>
) -> Int {
    if routine < 0 || routine >= ArrayLength(plan.routines.roles) ||
        routine == plan.routines.entrypoint_ordinal ||
        plan.routines.return_types[routine] == "Void" { return 1; }
    let first: Int = plan.routines.block_starts[routine];
    if ArrayLength(unreachable) != plan.routines.block_counts[routine] ||
        fallthrough <= first || fallthrough >= first + ArrayLength(unreachable) ||
        plan.block_succ_true[fallthrough] != -1 || plan.block_succ_false[fallthrough] != -1 ||
        plan.block_operation_counts[fallthrough] != 0 ||
        plan.program.block_condition_expression_rows[fallthrough] != -1 ||
        plan.program.block_return_expression_rows[fallthrough] != -1 { return 2; }
    if unreachable[fallthrough - first] != 1 { return 3; }
    return 0;
}

func DirectMirScalarProgramEnumExhaustiveMatchFallthroughReady(
    ref plan: DirectMirScalarCfgGraphPlan, routine: Int, fallthrough: Int,
    ref unreachable: Array<Int>
) -> Bool {
    return DirectMirScalarProgramEnumExhaustiveMatchFallthroughReadinessCode(
        plan, routine, fallthrough, unreachable) == 0;
}
