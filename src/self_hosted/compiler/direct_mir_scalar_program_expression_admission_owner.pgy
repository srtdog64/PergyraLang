// Typed normalization of persisted MIR expression graphs for scalar programs.
import "direct_mir_scalar_program_call_expression_admission_owner.pgy";
import "direct_mir_scalar_program_builtin_call_owner.pgy";
import "direct_mir_scalar_program_call_consumption_owner.pgy";
import "direct_mir_scalar_program_expression_mutation_owner.pgy";
import "direct_mir_scalar_program_expression_kind_owner.pgy";
import "direct_mir_scalar_cfg_local_ref_plan_owner.pgy";
import "direct_mir_scalar_cfg_value_type_owner.pgy";
import "direct_mir_scalar_cfg_scoped_match_binding_operand_owner.pgy";
import "direct_mir_scalar_program_literal_expression_admission_owner.pgy";
import "direct_mir_scalar_program_array_int_populated_literal_admission_owner.pgy";
import "direct_mir_scalar_program_array_string_nested_literal_owner.pgy";
import "direct_mir_scalar_program_array_bool_nested_literal_owner.pgy";
import "direct_mir_scalar_program_option_absence_expression_owner.pgy";
import "direct_mir_scalar_program_logical_record_expression_owner.pgy";
import "direct_mir_scalar_program_logical_record_option_expression_kind_owner.pgy";
import "direct_mir_scalar_program_expression_admission_failure_owner.pgy";
import "direct_mir_scalar_program_payload_free_enum_expression_owner.pgy";
import "direct_mir_scalar_program_payload_enum_expression_owner.pgy";
import "direct_mir_scalar_program_leaf_identity_fact_owner.pgy";
import "direct_mir_scalar_program_declared_callable_value_admission_owner.pgy";
func DirectMirScalarProgramAppendExpression(
    facts: DirectMirScalarProgramExpressionSet,
    ref instruction: JsonObjectFactTable,
    ref uses: MirRoutineInstructionUseFacts, ref index: MirRoutineFactIndex,
    global_row: Int, local_instruction: Int,
    ref locals: DirectMirScalarCfgLocalRefPlan,
    ref value_types: DirectMirScalarCfgValueTypePlan,
    ref wire: DirectMirScalarCfgWireLocalRefs,
    local_offset: Int, parameter_types: Array<String>,
    ref signature: DirectMirRoutineSignatureFact,
    ref callables: DirectMirScalarCfgProgramCallableInventory,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    ref payload_free_enum: DirectMirScalarProgramPayloadFreeEnumFact,
    ref referenced_enum: DirectMirScalarProgramReferencedEnumFact,
    graph_field: String, inout use_offset: Int,
    require_all_uses: Bool, expected_type: String,
    try_operand_only: Bool, source_root_override: Int
) -> DirectMirScalarProgramExpressionAdmission {
    let sequence: MirExpressionGraphSequence =
        DirectMirScalarCfgExpressionSequenceForField(
            instruction, graph_field);
    if !facts.valid || !sequence.ok || ArrayLength(sequence.roots) != 1 {
        return DirectMirScalarProgramExpressionAdmissionRejected(facts, "graph-sequence", -1);
    }
    let total_count: Int = ArrayLength(sequence.arena.topology.node_kinds); let count: Int = total_count;
    let source_root: Int = sequence.roots[0];
    if source_root_override >= 0 { source_root = source_root_override; count = source_root + 1; }
    if total_count < 1 || source_root < 0 || source_root >= total_count {
        return DirectMirScalarProgramExpressionAdmissionRejected(facts, "graph-root", source_root);
    }
    if try_operand_only {
        if sequence.arena.topology.node_kinds[source_root] !=
                AstExpressionNodeTry() ||
            sequence.arena.topology.right_children[source_root] != 0 {
            return DirectMirScalarProgramExpressionAdmissionRejected(facts, "try-root", source_root);
        }
        source_root = sequence.arena.topology.left_children[source_root];
        if source_root < 0 || source_root >= sequence.roots[0] {
            return DirectMirScalarProgramExpressionAdmissionRejected(facts, "try-operand", source_root);
        }
        count = source_root + 1;
    }
    let total_uses: Int = MirRoutineInstructionUseCountAtGlobal(
        uses, global_row);
    if use_offset < 0 || total_uses < use_offset {
        return DirectMirScalarProgramExpressionAdmissionRejected(facts, "instruction-uses", -1);
    }
    let initial_use_offset: Int = use_offset;
    if !try_operand_only && initial_use_offset == 0 &&
            graph_field == "expr0_graph" {
        let literal_admission:
            DirectMirScalarProgramLiteralExpressionAdmission =
            DirectMirScalarProgramAppendLiteralExpression(
                facts, sequence, uses, global_row, local_instruction,
                local_offset, use_offset, expected_type, locals, value_types,
                wire, signature, callables, logical_record);
        if literal_admission.recognized {
            if require_all_uses && total_uses != use_offset {
                return DirectMirScalarProgramExpressionAdmissionRejected(facts, "literal-uses", source_root);
            }
            if !literal_admission.facts.valid {
                return DirectMirScalarProgramExpressionAdmissionRejected(facts, "literal", source_root);
            }
            return DirectMirScalarProgramExpressionAdmissionAccepted(
                literal_admission.facts);
        }
    }
    let graph_rows: Array<Int> = facts.graph_global_rows;
    let starts: Array<Int> = facts.graph_starts;
    let counts: Array<Int> = facts.graph_counts;
    let roots: Array<Int> = facts.graph_roots;
    let kinds: Array<Int> = facts.node_kinds;
    let types: Array<String> = facts.node_types;
    let lefts: Array<Int> = facts.node_lefts;
    let rights: Array<Int> = facts.node_rights;
    let local_rows: Array<Int> = facts.node_local_rows;
    let params: Array<Int> = facts.node_parameter_ordinals;
    let member_ordinals: Array<Int> = facts.node_member_ordinals;
    let literals: Array<String> = facts.node_literals;
    let callable_rows: Array<Int> = facts.node_callable_rows;
    let runtime_call_abi_ids: Array<Int> =
        facts.node_runtime_call_abi_ids;
    let nary_operands: DirectMirScalarProgramNaryOperands =
        facts.nary_operands;
    let source_rows: Array<Int> = [];
    let consumed_calls: Array<Bool> = [];
    let bound_leaf_texts: Array<String> = [];
    let bound_leaf_locals: Array<Int> = [];
    let start: Int = ArrayLength(kinds);
    let expected_uses: Int = initial_use_offset;
    let initialize: Int = 0;
    while initialize < total_count {
        ArrayPush(consumed_calls, false); initialize = initialize + 1;
    }
    let node: Int = 0;
    while node < count {
        let source_kind: Int = sequence.arena.topology.node_kinds[node];
        if DirectMirScalarProgramCallCalleeNodeReady(sequence, node) ||
            DirectMirScalarProgramPayloadFreeEnumMarkerReady(
                sequence, node, payload_free_enum) ||
            DirectMirScalarProgramPayloadEnumMemberMarkerReady(sequence, node, source_rows, types, referenced_enum) ||
            DirectMirScalarProgramLogicalRecordMemberMarkerReady(
                sequence, node, "", logical_record) ||
            DirectMirScalarProgramNestedArrayLiteralSeedMarkerReady(
                sequence, node) {
            ArrayPush(source_rows, -1); node = node + 1; continue;
        }
        let kind: Int = 0; let type_name: String = "";
        let left: Int = -1; let right: Int = -1;
        let local_row: Int = -1; let param: Int = -1;
        let member_ordinal: Int = -1;
        let literal: String = "";
        let call_arguments: Array<Int> = [];
        let call_callable: Int = -1;
        let runtime_call_abi_id: Int = -1;
        if DirectMirScalarProgramCallMarkerReady(sequence, node) {
            let builtin: DirectMirScalarProgramBuiltinCallFact =
                DirectMirScalarProgramZeroArgumentBuiltinCallFactFromGraph(
                    sequence, node, expected_type, logical_record);
            if builtin.recognized {
                if !builtin.valid || !builtin.complete ||
                    builtin.call_node < 0 || builtin.call_node >= total_count {
                    return DirectMirScalarProgramExpressionAdmissionRejected(
                        facts, "runtime-value-call", node);
                }
                if builtin.expression_kind == DirectMirScalarProgramExprRuntimeValueCall() {
                    let runtime_value: CompilerRuntimeValueCallAbiFact =
                        CompilerRuntimeValueCallAbiFactForSource(
                            sequence.arena.call_target_names[
                                builtin.call_node]);
                    if !CompilerRuntimeValueCallInstructionRowReady(
                            instruction, runtime_value) {
                        return DirectMirScalarProgramExpressionAdmissionRejected(
                            facts, "runtime-value-call", node);
                    }
                }
                if consumed_calls[builtin.call_node] {
                    return DirectMirScalarProgramExpressionAdmissionRejected(
                        facts, "runtime-value-call-consumption", node);
                }
                consumed_calls[builtin.call_node] = true;
                kind = builtin.expression_kind;
                call_arguments = builtin.argument_rows;
                type_name = builtin.return_type;
                runtime_call_abi_id = builtin.runtime_call_abi_id;
            } else {
                let direct: DirectMirScalarProgramDirectCallFact =
                    DirectMirScalarProgramZeroArgumentDirectCallFactFromGraph(sequence, node, callables, signature);
                if !direct.valid || !direct.complete {
                    ArrayPush(source_rows, -1); node = node + 1; continue;
                }
                if consumed_calls[direct.call_node] {
                    return DirectMirScalarProgramExpressionAdmissionRejected(
                        facts, "direct-call-consumption", node);
                }
                consumed_calls[direct.call_node] = true;
                kind = DirectMirScalarProgramExprDirectCall();
                if direct.callable_parameter_ordinal >= 0 {
                    kind = DirectMirScalarProgramExprCallableParameterCall(); }
                call_arguments = direct.argument_rows;
                call_callable = direct.callable_ordinal;
                param = direct.callable_parameter_ordinal;
                type_name = direct.return_type;
            }
        } else if source_kind == AstExpressionNodeCallArgument() {
            let constructor:
                DirectMirScalarProgramLogicalRecordExpressionFact =
                    DirectMirScalarProgramLogicalRecordConstructorFromGraph(
                        sequence, node, source_rows, types, logical_record);
            if constructor.recognized {
                if !constructor.valid {
                    return DirectMirScalarProgramExpressionAdmissionRejected(facts, "logical-record-constructor", node);
                }
                if !constructor.complete {
                    ArrayPush(source_rows, -1); node = node + 1; continue;
                }
                if consumed_calls[constructor.call_node] {
                    return DirectMirScalarProgramExpressionAdmissionRejected(facts, "logical-record-constructor-consumption", node);
                }
                consumed_calls[constructor.call_node] = true;
                kind = constructor.kind;
                call_arguments = constructor.argument_rows;
                type_name = constructor.type_name;
            } else {
            let payload_constructor:
                DirectMirScalarProgramPayloadEnumConstructorFact =
                    DirectMirScalarProgramPayloadEnumConstructorFromGraph(
                        sequence, node, source_rows, types, referenced_enum);
            if payload_constructor.recognized {
                if !payload_constructor.valid {
                    return DirectMirScalarProgramExpressionAdmissionRejected(
                        facts, "payload-enum-constructor", node);
                }
                if !payload_constructor.complete {
                    ArrayPush(source_rows, -1); node = node + 1; continue;
                }
                if consumed_calls[payload_constructor.call_node] {
                    return DirectMirScalarProgramExpressionAdmissionRejected(
                        facts, "payload-enum-constructor-consumption", node);
                }
                consumed_calls[payload_constructor.call_node] = true;
                kind = DirectMirScalarProgramExprPayloadEnumConstructor();
                call_arguments = payload_constructor.argument_rows;
                type_name = payload_constructor.type_name;
                member_ordinal = payload_constructor.variant_ordinal;
            } else {
            let call: DirectMirScalarProgramBuiltinCallFact =
                DirectMirScalarProgramBuiltinCallFactFromGraph(
                    sequence, node, source_rows, types, expected_type,
                    logical_record);
            if call.recognized {
                if !call.valid {
                    return DirectMirScalarProgramExpressionAdmissionRejected(facts, "builtin-call", node);
                }
                if !call.complete {
                    ArrayPush(source_rows, -1); node = node + 1; continue;
                }
                if consumed_calls[call.call_node] {
                    return DirectMirScalarProgramExpressionAdmissionRejected(facts, "builtin-call-consumption", node);
                }
                consumed_calls[call.call_node] = true;
                kind = call.expression_kind;
                call_arguments = call.argument_rows;
                type_name = call.return_type;
                runtime_call_abi_id = call.runtime_call_abi_id;
                if call.expression_kind == DirectMirScalarProgramExprRuntimeValueCall() {
                    let runtime_value: CompilerRuntimeValueCallAbiFact =
                        CompilerRuntimeValueCallAbiFactForSource(
                            sequence.arena.call_target_names[call.call_node]);
                    if !CompilerRuntimeValueCallInstructionRowReady(
                            instruction, runtime_value) {
                        return DirectMirScalarProgramExpressionAdmissionRejected(
                            facts, "runtime-value-call-row", node);
                    }
                }
            } else {
                let direct: DirectMirScalarProgramDirectCallFact = DirectMirScalarProgramDirectCallFactFromGraph(
                    sequence, node, source_rows, types, callables, signature);
                if !direct.recognized || !direct.valid {
                    return DirectMirScalarProgramExpressionAdmissionRejected(facts, "direct-call", node);
                }
                if !direct.complete {
                    ArrayPush(source_rows, -1); node = node + 1; continue;
                }
                if consumed_calls[direct.call_node] {
                    return DirectMirScalarProgramExpressionAdmissionRejected(facts, "direct-call-consumption", node);
                }
                consumed_calls[direct.call_node] = true;
                kind = DirectMirScalarProgramExprDirectCall();
                if direct.callable_parameter_ordinal >= 0 {
                    kind = DirectMirScalarProgramExprCallableParameterCall(); }
                call_arguments = direct.argument_rows;
                call_callable = direct.callable_ordinal;
                param = direct.callable_parameter_ordinal;
                type_name = direct.return_type;
            }
            }
            }
            if ArrayLength(call_arguments) == 1 {
                left = call_arguments[0];
            } else if ArrayLength(call_arguments) == 2 {
                left = call_arguments[0]; right = call_arguments[1];
            }
        } else if source_kind == AstExpressionNodeLeaf() {
            let absence_expected_type: String = DirectMirScalarProgramDirectCallArgumentExpectedType(
                sequence, node, callables, signature);
            if absence_expected_type == "" { absence_expected_type = expected_type; }
            let enum_leaf:
                DirectMirScalarProgramPayloadFreeEnumExpressionFact =
                DirectMirScalarProgramPayloadFreeEnumLeafVariant(
                    sequence, node, absence_expected_type,
                    payload_free_enum);
            let absence: DirectMirScalarProgramExpressionKindFact =
                DirectMirScalarProgramOptionAbsenceExpressionKind(
                    sequence.arena.node_texts[node], absence_expected_type,
                    logical_record);
            let declared: DirectMirScalarProgramDeclaredCallableValueFact = DirectMirScalarProgramDeclaredCallableValueFromGraph(sequence, node, absence_expected_type, callables);
            if declared.recognized {
                if !declared.valid {
                    return DirectMirScalarProgramExpressionAdmissionRejected(facts, declared.failure_stage, node);
                }
                kind = DirectMirScalarProgramExprDeclaredCallable(); type_name = declared.type_name; call_callable = declared.callable_ordinal;
            } else if enum_leaf.valid {
                kind = enum_leaf.kind;
                type_name = enum_leaf.type_name;
                member_ordinal = enum_leaf.variant_ordinal;
            } else if absence.valid && sequence.arena.identities.binding_kinds[node] ==
                    SemanticExpressionBindingNone() {
                kind = absence.kind;
                type_name = absence.type_name;
                literal = absence.literal;
            } else if !absence.valid {
                let identity: DirectMirScalarProgramLeafIdentityFact =
                    DirectMirScalarProgramLeafIdentityFactFromOwners(
                        bound_leaf_texts, bound_leaf_locals, sequence.arena.node_texts[node],
                        sequence.arena.identities.binding_kinds[node], sequence.arena.identities.binding_ordinals[node],
                        ArrayLength(parameter_types));
                if !identity.valid {
                    return DirectMirScalarProgramExpressionAdmissionRejected(facts, "leaf-alias", node);
                }
                let bound_local: Int = identity.bound_local; let operand: DirectMirScalarCfgLeafOperand =
                    DirectMirScalarCfgLeafOrScopedMatchBindingOperandFromOwners(
                        uses, index, global_row, expected_uses,
                        local_instruction, node, sequence.arena.node_texts[node],
                        locals.value_names, locals, wire,
                        graph_field == "expr0_graph");
                let operand_local: Int = operand.local_row;
                if operand.value_row >= 0 && operand.value_row <
                        ArrayLength(locals.value_local_rows) {
                    operand_local = locals.value_local_rows[operand.value_row];
                }
                let consumed_uses: Int = operand.use_count; let reused_prior_lane: Bool = operand.valid &&
                    operand.value_row >= 0 && consumed_uses == 0;
                let selects_local: Bool = false;
                if bound_local >= 0 {
                    if operand.valid && operand_local >= 0 &&
                        operand_local != bound_local {
                        return DirectMirScalarProgramExpressionAdmissionRejected(facts, "leaf-alias", node);
                    }
                    operand_local = bound_local; consumed_uses = 0;
                    selects_local = true;
                } else if identity.parameter_ordinal >= 0 &&
                        (!operand.valid || reused_prior_lane) {
                    param = identity.parameter_ordinal; type_name = parameter_types[param];
                    if signature.parameters.carriages[param] == "value-result" {
                        let wanted: String = SelfMirLocalRef("parameter", signature.source_syntax_id, param);
                        let parameter_local: Int = DirectMirScalarCfgLocalIdentityRow(locals.local_ref_value_ids, wanted);
                        if parameter_local >= 0 { kind = DirectMirScalarProgramExprLocal(); local_row = parameter_local + local_offset; param = -1;
                        } else { kind = DirectMirScalarProgramExprParameter(); }
                    } else { kind = DirectMirScalarProgramExprParameter(); }
                } else if operand.valid && operand_local >= 0 {
                    ArrayPush(bound_leaf_texts, sequence.arena.node_texts[node]);
                    ArrayPush(bound_leaf_locals, operand_local); selects_local = true;
                } else {
                    return DirectMirScalarProgramExpressionAdmissionRejected(facts, "leaf-operand", node);
                }
                if selects_local {
                    if operand_local >= ArrayLength(value_types.local_types) {
                        return DirectMirScalarProgramExpressionAdmissionRejected(
                            facts, "leaf-type", node);
                    }
                    kind = DirectMirScalarProgramExprLocal();
                    type_name = value_types.local_types[operand_local];
                    local_row = operand_local + local_offset;
                    expected_uses = expected_uses + consumed_uses;
                }
            } else {
                return DirectMirScalarProgramExpressionAdmissionRejected(facts, "leaf-binding", node);
            }
        } else if source_kind == AstExpressionNodeMemberAccess() {
            let payload_member: DirectMirScalarProgramPayloadEnumMemberFact = DirectMirScalarProgramPayloadEnumMemberFromGraph(sequence, node, source_rows, types, referenced_enum);
            if payload_member.recognized {
                if !payload_member.valid {
                    return DirectMirScalarProgramExpressionAdmissionRejected(facts, "payload-enum-member", node);
                }
                kind = DirectMirScalarProgramExprPayloadEnumMember(); type_name = payload_member.type_name;
                left = payload_member.left_row; member_ordinal = payload_member.parameter_row;
            } else {
            let enum_variant: DirectMirScalarProgramPayloadFreeEnumExpressionFact = DirectMirScalarProgramPayloadFreeEnumVariantFromGraph(sequence, node, payload_free_enum);
            if enum_variant.recognized {
                if !enum_variant.valid {
                    return DirectMirScalarProgramExpressionAdmissionRejected(facts, "payload-free-enum-variant", node);
                }
                kind = enum_variant.kind; type_name = enum_variant.type_name;
                member_ordinal = enum_variant.variant_ordinal;
            } else {
                let member: DirectMirScalarProgramLogicalRecordExpressionFact = DirectMirScalarProgramLogicalRecordMemberFromGraph(
                    sequence, node, source_rows, types, logical_record);
                if !member.recognized || !member.valid || !member.complete {
                    return DirectMirScalarProgramExpressionAdmissionRejected(facts, "logical-record-member", node);
                }
                kind = member.kind; type_name = member.type_name;
                left = member.left_row; member_ordinal = member.member_ordinal;
            }
            }
        } else {
            let nested_operands: Array<Int> = DirectMirScalarProgramNestedArrayStringLiteralOperandRows(sequence, node, source_rows, types);
            let nested_kind: Int = DirectMirScalarProgramExprArrayStringLiteral();
            let nested_type: String = CompilerAbiLayoutArrayStringTypeName();
            if ArrayLength(nested_operands) == 0 {
                nested_operands = DirectMirScalarProgramNestedArrayIntLiteralOperandRows(sequence, node, source_rows, types);
                nested_kind = DirectMirScalarProgramExprArrayIntPopulatedLiteral(); nested_type = CompilerAbiLayoutArrayIntTypeName();
            }
            if ArrayLength(nested_operands) == 0 {
                nested_operands = DirectMirScalarProgramNestedArrayBoolLiteralOperandRows(sequence, node, source_rows, types);
                nested_kind = DirectMirScalarProgramExprArrayBoolPopulatedLiteral(); nested_type = CompilerAbiLayoutArrayBoolTypeName();
            }
            if ArrayLength(nested_operands) >= 1 {
                kind = nested_kind; type_name = nested_type;
                if ArrayLength(nested_operands) == 1 { left = nested_operands[0]; }
                else if ArrayLength(nested_operands) == 2 {
                    left = nested_operands[0]; right = nested_operands[1];
                } else { nary_operands = DirectMirScalarProgramNaryOperandsAppend(
                    nary_operands, ArrayLength(kinds), nested_operands); }
            } else {
            let arity: Int = AstExpressionNodeArity(source_kind);
            if arity >= 1 {
                let source_left: Int =
                    sequence.arena.topology.left_children[node];
                if source_left < 0 || source_left >= node ||
                    source_rows[source_left] < start {
                    return DirectMirScalarProgramExpressionAdmissionRejected(facts, "left-edge", node);
                }
                left = source_rows[source_left];
            }
            if arity == 2 {
                let source_right: Int =
                    sequence.arena.topology.right_children[node];
                if source_right < 0 || source_right >= node ||
                    source_rows[source_right] < start {
                    return DirectMirScalarProgramExpressionAdmissionRejected(facts, "right-edge", node);
                }
                right = source_rows[source_right];
            }
            let left_type: String = ""; let right_type: String = "";
            if left >= 0 { left_type = types[left]; }
            if right >= 0 { right_type = types[right]; }
            let classified: DirectMirScalarProgramExpressionKindFact =
                DirectMirScalarProgramPayloadFreeEnumComparisonKindFact(
                    source_kind, left_type, right_type, arity,
                    payload_free_enum);
            if !classified.valid {
                classified = DirectMirScalarProgramExpressionKindFactFromSource(
                    source_kind, sequence.arena.node_texts[node],
                    left_type, right_type, arity, logical_record);
            }
            if !classified.valid {
                return DirectMirScalarProgramExpressionAdmissionRejected(facts, "expression-kind", node);
            }
            kind = classified.kind; type_name = classified.type_name;
            literal = classified.literal;
            }
        }
        DirectMirScalarProgramAppendExpressionNode(
            kinds, types, lefts, rights, local_rows, params,
            member_ordinals, literals, callable_rows, runtime_call_abi_ids,
            kind, type_name, left, right,
            local_row, param, member_ordinal, literal, call_callable,
            runtime_call_abi_id);
        if source_kind == AstExpressionNodeCallArgument() &&
                ArrayLength(call_arguments) > 2 {
            nary_operands = DirectMirScalarProgramNaryOperandsAppend(
                nary_operands, ArrayLength(kinds) - 1,
                call_arguments);
        }
        ArrayPush(source_rows, ArrayLength(kinds) - 1);
        node = node + 1;
    }
    let root: Int = source_rows[source_root];
    if root < start {
        return DirectMirScalarProgramExpressionAdmissionRejected(
            facts, "graph-root-mapping", source_root);
    }
    if require_all_uses && expected_uses != total_uses {
        return DirectMirScalarProgramExpressionAdmissionRejected(
            facts, "graph-use-completeness", source_root);
    }
    if !DirectMirScalarProgramCallsComplete(sequence, consumed_calls) {
        return DirectMirScalarProgramExpressionAdmissionRejected(
            facts, "graph-call-completeness", source_root);
    }
    use_offset = expected_uses;
    ArrayPush(graph_rows, global_row); ArrayPush(starts, start);
    ArrayPush(counts, ArrayLength(kinds) - start); ArrayPush(roots, root);
    return DirectMirScalarProgramExpressionAdmissionAccepted(DirectMirScalarProgramExpressionSet(
        true, 0, graph_rows, starts, counts, roots, kinds, types,
        lefts, rights, local_rows, params, member_ordinals, literals,
        callable_rows, runtime_call_abi_ids, nary_operands));
}
