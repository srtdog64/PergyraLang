// Typed normalization of persisted MIR expression graphs for scalar programs.
import "direct_mir_scalar_program_call_expression_admission_owner.pgy";
import "direct_mir_scalar_program_builtin_call_owner.pgy";
import "direct_mir_scalar_program_expression_kind_owner.pgy";
import "direct_mir_scalar_cfg_local_ref_plan_owner.pgy";
import "direct_mir_scalar_cfg_value_type_owner.pgy";
import "direct_mir_scalar_cfg_leaf_operand_owner.pgy";

func DirectMirScalarProgramAppendExpression(
    facts: DirectMirScalarProgramExpressionSet,
    ref instruction: JsonObjectFactTable,
    ref uses: MirRoutineInstructionUseFacts,
    global_row: Int, local_instruction: Int,
    ref locals: DirectMirScalarCfgLocalRefPlan,
    ref value_types: DirectMirScalarCfgValueTypePlan,
    ref wire: DirectMirScalarCfgWireLocalRefs,
    local_offset: Int, parameter_type: String,
    callable_syntax_id: Int, callable_ordinal: Int,
    callable_parameter_type: String, callable_return_type: String
) -> DirectMirScalarProgramExpressionSet {
    let sequence: MirExpressionGraphSequence =
        DirectMirScalarCfgExpressionSequence(instruction);
    let invalid: DirectMirScalarProgramExpressionSet =
        DirectMirScalarProgramExpressionSetInvalid(facts);
    if !facts.valid || !sequence.ok || ArrayLength(sequence.roots) != 1 {
        return invalid;
    }
    let count: Int = ArrayLength(sequence.arena.topology.node_kinds);
    if count == 4 && sequence.arena.topology.node_kinds[1] ==
            AstExpressionNodeCall() &&
            sequence.arena.identities.call_target_syntax_ids[1] != 0 {
        return DirectMirScalarProgramAppendCallExpression(
            facts, sequence, uses, global_row, local_instruction,
            locals, value_types, wire, local_offset, callable_syntax_id,
            callable_ordinal, callable_parameter_type, callable_return_type
        );
    }
    if count < 1 || sequence.roots[0] < 0 ||
        sequence.roots[0] >= count { return invalid; }
    let graph_rows: Array<Int> = facts.graph_global_rows;
    let starts: Array<Int> = facts.graph_starts;
    let counts: Array<Int> = facts.graph_counts;
    let roots: Array<Int> = facts.graph_roots;
    let kinds: Array<Int> = facts.node_kinds;
    let types: Array<String> = facts.node_types;
    let lefts: Array<Int> = facts.node_lefts;
    let rights: Array<Int> = facts.node_rights;
    let local_rows: Array<Int> = facts.node_local_rows;
    let params: Array<Int> = facts.node_parameter_ordinals;
    let literals: Array<String> = facts.node_literals;
    let callable_rows: Array<Int> = facts.node_callable_rows;
    let nary_operands: DirectMirScalarProgramNaryOperands =
        facts.nary_operands;
    let source_rows: Array<Int> = [];
    let consumed_calls: Array<Bool> = [];
    let bound_leaf_texts: Array<String> = [];
    let bound_leaf_locals: Array<Int> = [];
    let start: Int = ArrayLength(kinds);
    let expected_uses: Int = 0;
    let initialize: Int = 0;
    while initialize < count {
        ArrayPush(consumed_calls, false); initialize = initialize + 1;
    }
    let node: Int = 0;
    while node < count {
        let source_kind: Int = sequence.arena.topology.node_kinds[node];
        if DirectMirScalarProgramBuiltinCalleeLeafReady(sequence, node) ||
            DirectMirScalarProgramBuiltinCallMarkerReady(sequence, node) {
            ArrayPush(source_rows, -1); node = node + 1; continue;
        }
        let kind: Int = 0; let type_name: String = "";
        let left: Int = -1; let right: Int = -1;
        let local_row: Int = -1; let param: Int = -1;
        let literal: String = "";
        let call_arguments: Array<Int> = [];
        if source_kind == AstExpressionNodeCallArgument() {
            let call: DirectMirScalarProgramBuiltinCallFact =
                DirectMirScalarProgramBuiltinCallFactFromGraph(
                    sequence, node, source_rows, types);
            if !call.recognized || !call.valid { return invalid; }
            if !call.complete {
                ArrayPush(source_rows, -1); node = node + 1; continue;
            }
            if consumed_calls[call.call_node] {
                return invalid;
            }
            consumed_calls[call.call_node] = true;
            kind = call.expression_kind;
            call_arguments = call.argument_rows;
            let signature: DirectMirScalarProgramBuiltinSignatureFact =
                DirectMirScalarProgramBuiltinSignatureFactFromName(
                    sequence.arena.call_target_names[call.call_node]);
            if !signature.valid { return invalid; }
            type_name = signature.return_type;
            if ArrayLength(call_arguments) == 1 {
                left = call_arguments[0];
            } else if ArrayLength(call_arguments) == 2 {
                left = call_arguments[0]; right = call_arguments[1];
            }
        } else if source_kind == AstExpressionNodeLeaf() {
            if sequence.arena.identities.binding_kinds[node] ==
                    SemanticExpressionBindingFormalParameter() &&
                    sequence.arena.identities.binding_ordinals[node] == 0 &&
                    parameter_type != "" && expected_uses == 0 &&
                    MirRoutineInstructionUseCountAtGlobal(
                        uses, global_row) == 0 {
                kind = DirectMirScalarProgramExprParameter();
                type_name = parameter_type;
                param = 0;
            } else {
                let operand: DirectMirScalarCfgLeafOperand =
                    DirectMirScalarCfgLeafOperandFromOwners(
                        uses, global_row, expected_uses, local_instruction,
                        node, sequence.arena.node_texts[node],
                        locals.value_names, locals, wire);
                let operand_local: Int = operand.local_row;
                if operand.value_row >= 0 && operand.value_row <
                        ArrayLength(locals.value_local_rows) {
                    operand_local = locals.value_local_rows[operand.value_row];
                }
                let consumed_uses: Int = operand.use_count;
                if !operand.valid || operand_local < 0 {
                    operand_local = -1;
                    let bound: Int = 0;
                    while bound < ArrayLength(bound_leaf_texts) {
                        if bound_leaf_texts[bound] ==
                                sequence.arena.node_texts[node] {
                            if operand_local >= 0 && operand_local !=
                                    bound_leaf_locals[bound] { return invalid; }
                            operand_local = bound_leaf_locals[bound];
                        }
                        bound = bound + 1;
                    }
                    if operand_local < 0 { return invalid; }
                    consumed_uses = 0;
                } else {
                    ArrayPush(bound_leaf_texts,
                        sequence.arena.node_texts[node]);
                    ArrayPush(bound_leaf_locals, operand_local);
                }
                if operand_local >= ArrayLength(value_types.local_types) {
                    return invalid;
                }
                kind = DirectMirScalarProgramExprLocal();
                type_name = value_types.local_types[operand_local];
                local_row = operand_local + local_offset;
                expected_uses = expected_uses + consumed_uses;
            }
        } else {
            let arity: Int = AstExpressionNodeArity(source_kind);
            if arity >= 1 {
                let source_left: Int =
                    sequence.arena.topology.left_children[node];
                if source_left < 0 || source_left >= node ||
                    source_rows[source_left] < start { return invalid; }
                left = source_rows[source_left];
            }
            if arity == 2 {
                let source_right: Int =
                    sequence.arena.topology.right_children[node];
                if source_right < 0 || source_right >= node ||
                    source_rows[source_right] < start { return invalid; }
                right = source_rows[source_right];
            }
            let left_type: String = ""; let right_type: String = "";
            if left >= 0 { left_type = types[left]; }
            if right >= 0 { right_type = types[right]; }
            let classified: DirectMirScalarProgramExpressionKindFact =
                DirectMirScalarProgramExpressionKindFactFromSource(
                    source_kind, sequence.arena.node_texts[node],
                    left_type, right_type, arity);
            if !classified.valid { return invalid; }
            kind = classified.kind; type_name = classified.type_name;
            literal = classified.literal;
        }
        DirectMirScalarProgramAppendExpressionNode(
            kinds, types, lefts, rights, local_rows, params, literals,
            callable_rows, kind, type_name, left, right, local_row,
            param, literal, -1);
        if source_kind == AstExpressionNodeCallArgument() &&
                ArrayLength(call_arguments) > 2 {
            nary_operands = DirectMirScalarProgramNaryOperandsAppend(
                nary_operands, ArrayLength(kinds) - 1,
                call_arguments);
        }
        ArrayPush(source_rows, ArrayLength(kinds) - 1);
        node = node + 1;
    }
    let root: Int = source_rows[sequence.roots[0]];
    if root < start ||
        expected_uses != MirRoutineInstructionUseCountAtGlobal(
            uses, global_row) ||
        !DirectMirScalarProgramBuiltinCallsComplete(
            sequence, consumed_calls) { return invalid; }
    ArrayPush(graph_rows, global_row); ArrayPush(starts, start);
    ArrayPush(counts, ArrayLength(kinds) - start); ArrayPush(roots, root);
    return DirectMirScalarProgramExpressionSet(
        true, 0, graph_rows, starts, counts, roots, kinds, types,
        lefts, rights, local_rows, params, literals, callable_rows,
        nary_operands);
}
