// Sole query over kind identities already sealed in the expression arena.

import "direct_mir_scalar_program_expression_fact_owner.pgy";

func DirectMirScalarProgramExpressionContainsKind(
    ref expressions: DirectMirScalarProgramExpressionSet, kind: Int
) -> Bool {
    let row: Int = 0;
    while row < ArrayLength(expressions.node_kinds) {
        if expressions.node_kinds[row] == kind { return true; }
        row = row + 1;
    }
    return false;
}
