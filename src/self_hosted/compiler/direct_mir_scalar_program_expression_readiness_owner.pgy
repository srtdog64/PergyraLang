// Exact schema and type invariants for normalized scalar-program expressions.
import "direct_mir_scalar_program_expression_fact_owner.pgy";
import "direct_mir_scalar_cfg_expression_base_owner.pgy";
import "direct_mir_scalar_program_bool_readiness_owner.pgy";
import "direct_mir_scalar_program_nary_expression_readiness_owner.pgy";
import "direct_mir_scalar_program_collection_expression_readiness_owner.pgy";
import "direct_mir_scalar_program_case_math_expression_readiness_owner.pgy";
import "direct_mir_scalar_program_callable_parameter_call_readiness_owner.pgy";
import "direct_mir_scalar_program_string_search_expression_readiness_owner.pgy";
import "direct_mir_scalar_program_string_transform_expression_readiness_owner.pgy";
import "direct_mir_scalar_program_option_int_expression_family_readiness_owner.pgy";
import "direct_mir_scalar_program_option_string_expression_readiness_owner.pgy";
import "direct_mir_scalar_program_option_bool_expression_readiness_owner.pgy";
import "direct_mir_scalar_program_result_int_expression_readiness_owner.pgy";
import "direct_mir_scalar_program_to_string_expression_readiness_owner.pgy";
import "direct_mir_scalar_program_logical_record_option_expression_readiness_owner.pgy";
import "direct_mir_scalar_program_logical_record_expression_readiness_owner.pgy";
import "direct_mir_scalar_program_array_bool_empty_literal_readiness_owner.pgy";
import "direct_mir_scalar_program_array_bool_populated_literal_readiness_owner.pgy";
import "direct_mir_scalar_program_logical_record_array_index_expression_owner.pgy";
import "direct_mir_scalar_program_comparison_expression_readiness_owner.pgy";
import "direct_mir_scalar_program_numeric_cast_expression_readiness_owner.pgy";
import "direct_mir_scalar_program_payload_free_enum_expression_readiness_owner.pgy";
import "direct_mir_scalar_program_payload_enum_expression_readiness_owner.pgy";
import "direct_mir_scalar_program_runtime_value_expression_readiness_owner.pgy";
import "direct_mir_scalar_program_intent_observability_readiness_owner.pgy";
import "direct_mir_scalar_program_compiler_artifact_expression_readiness_owner.pgy";

func DirectMirScalarProgramExpressionNodeReady(
    ref facts: DirectMirScalarProgramExpressionSet, node: Int) -> Bool {
    if node < 0 || node >= ArrayLength(facts.node_kinds) {
        return false;
    }
    let kind: Int = facts.node_kinds[node];
    let type_name: String = facts.node_types[node];
    let left: Int = facts.node_lefts[node];
    let right: Int = facts.node_rights[node];
    let local_binding: Int = facts.node_local_rows[node];
    let param: Int = facts.node_parameter_ordinals[node];
    let member: Int = facts.node_member_ordinals[node];
    let literal: String = facts.node_literals[node];
    let callable: Int = facts.node_callable_rows[node];
    let runtime_call_abi_id: Int = facts.node_runtime_call_abi_ids[node];
    if kind == DirectMirScalarProgramExprRuntimeValueCall() { return DirectMirScalarProgramRuntimeValueCallNodeReady(facts, node); }
    if kind == DirectMirScalarProgramExprIntentObservabilityCall() { return DirectMirScalarProgramIntentObservabilityCallNodeReady(facts, node); }
    let artifact_ready: Option<Bool> = DirectMirScalarProgramCompilerArtifactExpressionNodeReady(facts, node); if IsSome(artifact_ready) { return UnwrapOption(artifact_ready); }
    if runtime_call_abi_id != -1 { return false; }
    if kind == DirectMirScalarProgramExprLogicalRecordConstructor() ||
        kind == DirectMirScalarProgramExprLogicalRecordMember() ||
        kind == DirectMirScalarProgramExprLogicalRecordArrayEmptyLiteral() {
        return DirectMirScalarProgramLogicalRecordExpressionNodeReady(
            facts, node);
    }
    if kind == DirectMirScalarProgramExprArrayBoolEmptyLiteral() {
        return DirectMirScalarProgramArrayBoolEmptyLiteralNodeReady(
            facts, node);
    }
    if kind == DirectMirScalarProgramExprArrayBoolPopulatedLiteral() {
        return DirectMirScalarProgramArrayBoolPopulatedLiteralNodeReady(
            facts, node);
    }
    if kind == DirectMirScalarProgramExprLogicalRecordArrayIndex() {
        return DirectMirScalarProgramLogicalRecordArrayIndexNodeShapeReady(
            facts, node);
    }
    let enum_ready: Option<Bool> =
        DirectMirScalarProgramPayloadFreeEnumExpressionNodeReady(facts, node);
    if IsSome(enum_ready) { return UnwrapOption(enum_ready); }
    let payload_enum_ready: Option<Bool> =
        DirectMirScalarProgramPayloadEnumExpressionNodeReady(facts, node);
    if IsSome(payload_enum_ready) {
        return UnwrapOption(payload_enum_ready);
    }
    let option_ready: Option<Bool> =
        DirectMirScalarProgramOptionIntExpressionFamilyNodeReady(facts, node);
    if IsSome(option_ready) { return UnwrapOption(option_ready); }
    if member != -1 { return false; }
    let cast_ready: Option<Bool> = DirectMirScalarProgramNumericCastExpressionNodeReady(facts, node); if IsSome(cast_ready) { return UnwrapOption(cast_ready); }
    let comparison_ready: Option<Bool> = DirectMirScalarProgramComparisonExpressionNodeReady(facts, node);
    if IsSome(comparison_ready) { return UnwrapOption(comparison_ready); }
    let nary_ready: Option<Bool> =
        DirectMirScalarProgramNaryExpressionNodeReady(facts, node);
    if IsSome(nary_ready) { return UnwrapOption(nary_ready); }
    let collection_ready: Option<Bool> =
        DirectMirScalarProgramCollectionExpressionNodeReady(facts, node);
    if IsSome(collection_ready) { return UnwrapOption(collection_ready); }
    let case_math_ready: Option<Bool> =
        DirectMirScalarProgramCaseMathExpressionNodeReady(facts, node);
    if IsSome(case_math_ready) { return UnwrapOption(case_math_ready); }
    let search_ready: Option<Bool> =
        DirectMirScalarProgramStringSearchExpressionNodeReady(facts, node);
    if IsSome(search_ready) { return UnwrapOption(search_ready); }
    let transform_ready: Option<Bool> =
        DirectMirScalarProgramStringTransformExpressionNodeReady(facts, node);
    if IsSome(transform_ready) { return UnwrapOption(transform_ready); }
    let option_string_ready: Option<Bool> = DirectMirScalarProgramOptionStringExpressionNodeReady(facts, node);
    if IsSome(option_string_ready) { return UnwrapOption(option_string_ready); }
    let option_bool_ready: Option<Bool> =
        DirectMirScalarProgramOptionBoolExpressionNodeReady(facts, node);
    if IsSome(option_bool_ready) { return UnwrapOption(option_bool_ready); }
    let result_int_ready: Option<Bool> =
        DirectMirScalarProgramResultIntExpressionNodeReady(facts, node);
    if IsSome(result_int_ready) { return UnwrapOption(result_int_ready); }
    let record_option_ready: Option<Bool> = DirectMirScalarProgramLogicalRecordOptionExpressionNodeReady(facts, node);
    if IsSome(record_option_ready) { return UnwrapOption(record_option_ready); }
    if kind == DirectMirScalarProgramExprLocal() {
        return local_binding >= 0 && left == -1 && right == -1 && param == -1 &&
            literal == "" && callable == -1;
    }
    if kind == DirectMirScalarProgramExprParameter() {
        return param >= 0 && left == -1 && right == -1 && local_binding == -1 &&
            literal == "" && callable == -1;
    }
    if kind == DirectMirScalarProgramExprIntLiteral() {
        return type_name == CompilerAbiLayoutIntTypeName() &&
            DirectMirScalarCfgCanonicalInt(literal) && left == -1 &&
            right == -1 && local_binding == -1 && param == -1 && callable == -1;
    }
    if kind == DirectMirScalarProgramExprLongLiteral() {
        return type_name == CompilerAbiLayoutLongTypeName() &&
            AstExpressionLongLiteralPayloadReady(Concat(literal, "L")) &&
            left == -1 && right == -1 && local_binding == -1 && param == -1 &&
            callable == -1;
    }
    if kind == DirectMirScalarProgramExprBoolLiteral() {
        return type_name == CompilerAbiLayoutBoolTypeName() &&
            (literal == "true" || literal == "false") && left == -1 &&
            right == -1 && local_binding == -1 && param == -1 && callable == -1;
    }
    if kind == DirectMirScalarProgramExprStringLiteral() {
        return type_name == CompilerAbiLayoutStringTypeName() &&
            DirectMirScalarProgramLiteralEmbeddable(literal) && left == -1 &&
            right == -1 && local_binding == -1 && param == -1 && callable == -1;
    }
    if kind == DirectMirScalarProgramExprLogicalNot() {
        return type_name == CompilerAbiLayoutBoolTypeName() && left >= 0 &&
            facts.node_types[left] == CompilerAbiLayoutBoolTypeName() &&
            right == -1 && local_binding == -1 && param == -1 && literal == "" &&
            callable == -1;
    }
    if kind == DirectMirScalarProgramExprDirectCall() {
        return DirectMirScalarProgramDirectCallNodeReady(facts, node);
    }
    if kind == DirectMirScalarProgramExprCallableParameterCall() {
        return DirectMirScalarProgramCallableParameterCallNodeReady(facts, node);
    }
    if kind == DirectMirScalarProgramExprDeclaredCallable() {
        return DirectMirScalarProgramFirstOrderCallableTypeSupported(type_name) && left == -1 && right == -1 &&
            local_binding == -1 && param == -1 && member == -1 && literal == "" && callable > 0 &&
            ArrayLength(DirectMirScalarProgramNaryOperandRows(facts.nary_operands, node)) == 0;
    }
    let to_string_ready: Option<Bool> =
        DirectMirScalarProgramToStringExpressionNodeReady(facts, node);
    if IsSome(to_string_ready) { return UnwrapOption(to_string_ready); }
    if kind == DirectMirScalarProgramExprToUpperString() || kind ==
            DirectMirScalarProgramExprToLowerString() {
        return type_name == CompilerAbiLayoutStringTypeName() && left >= 0 &&
            facts.node_types[left] == CompilerAbiLayoutStringTypeName() &&
            right == -1 && local_binding == -1 && param == -1 && literal == "" && callable == -1;
    }
    if kind == DirectMirScalarProgramExprPrintString() {
        return type_name == CompilerAbiLayoutVoidTypeName() && left >= 0 &&
            facts.node_types[left] == CompilerAbiLayoutStringTypeName() &&
            right == -1 && local_binding == -1 && param == -1 &&
            literal == "" && callable == -1;
    }
    if kind == DirectMirScalarProgramExprStringLength() {
        return type_name == CompilerAbiLayoutIntTypeName() && left >= 0 &&
            facts.node_types[left] == CompilerAbiLayoutStringTypeName() &&
            right == -1 && local_binding == -1 && param == -1 && literal == "" &&
            callable == -1;
    }
    let int_binary: Bool = kind == DirectMirScalarProgramExprAddInt() ||
        kind == DirectMirScalarProgramExprSubtractInt() ||
        kind == DirectMirScalarProgramExprMultiplyInt() ||
        kind == DirectMirScalarProgramExprDivideInt();
    let long_binary: Bool = kind == DirectMirScalarProgramExprAddLong() ||
        kind == DirectMirScalarProgramExprMultiplyLong() ||
        kind == DirectMirScalarProgramExprSubtractLong();
    let bool_binary: Bool = kind == DirectMirScalarProgramExprLogicalAnd() ||
        kind == DirectMirScalarProgramExprLogicalOr();
    let string_binary: Bool = kind == DirectMirScalarProgramExprEqualString() ||
        kind == DirectMirScalarProgramExprNotEqualString() ||
        kind == DirectMirScalarProgramExprConcatString();
    if (!int_binary && !long_binary && !bool_binary && !string_binary) ||
        left < 0 || right < 0 ||
        local_binding != -1 || param != -1 || literal != "" || callable != -1 {
        return false;
    }
    if string_binary {
        let expected_type: String = CompilerAbiLayoutBoolTypeName();
        if kind == DirectMirScalarProgramExprConcatString() {
            expected_type = CompilerAbiLayoutStringTypeName();
        }
        return type_name == expected_type &&
            facts.node_types[left] == CompilerAbiLayoutStringTypeName() &&
            facts.node_types[right] == CompilerAbiLayoutStringTypeName();
    }
    if long_binary {
        return type_name == CompilerAbiLayoutLongTypeName() &&
            facts.node_types[left] == CompilerAbiLayoutLongTypeName() &&
            facts.node_types[right] == CompilerAbiLayoutLongTypeName();
    }
    if int_binary {
        if facts.node_types[left] != CompilerAbiLayoutIntTypeName() ||
            facts.node_types[right] != CompilerAbiLayoutIntTypeName() {
            return false;
        }
        if kind == DirectMirScalarProgramExprDivideInt() {
            return type_name == CompilerAbiLayoutIntTypeName() &&
                facts.node_kinds[right] ==
                    DirectMirScalarProgramExprIntLiteral() &&
                facts.node_literals[right] != "0" &&
                facts.node_literals[right] != "-1";
        }
        if kind == DirectMirScalarProgramExprAddInt() ||
                kind == DirectMirScalarProgramExprSubtractInt() ||
                kind == DirectMirScalarProgramExprMultiplyInt() {
            return type_name == CompilerAbiLayoutIntTypeName();
        }
        return type_name == CompilerAbiLayoutBoolTypeName();
    }
    return type_name == CompilerAbiLayoutBoolTypeName() &&
        facts.node_types[left] == CompilerAbiLayoutBoolTypeName() &&
        facts.node_types[right] == CompilerAbiLayoutBoolTypeName();
}

func DirectMirScalarProgramExpressionSetSemanticallyReady(
    ref facts: DirectMirScalarProgramExpressionSet
) -> Bool {
    if !DirectMirScalarProgramExpressionSetReady(facts) { return false; }
    let node: Int = 0;
    while node < ArrayLength(facts.node_kinds) {
        if !DirectMirScalarProgramExpressionNodeReady(facts, node) {
            return false;
        }
        node = node + 1;
    }
    return true;
}
