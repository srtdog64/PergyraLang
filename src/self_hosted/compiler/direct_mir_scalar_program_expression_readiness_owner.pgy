// Exact schema and type invariants for normalized scalar-program expressions.

import "direct_mir_scalar_program_expression_fact_owner.pgy";
import "direct_mir_scalar_cfg_expression_base_owner.pgy";
import "direct_mir_scalar_program_bool_readiness_owner.pgy";
import "direct_mir_scalar_program_nary_expression_readiness_owner.pgy";
import "direct_mir_scalar_program_collection_expression_readiness_owner.pgy";

func DirectMirScalarProgramExpressionNodeReady(
    ref facts: DirectMirScalarProgramExpressionSet, node: Int
) -> Bool {
    if node < 0 || node >= ArrayLength(facts.node_kinds) {
        return false;
    }
    let kind: Int = facts.node_kinds[node];
    let type_name: String = facts.node_types[node];
    let left: Int = facts.node_lefts[node];
    let right: Int = facts.node_rights[node];
    let local: Int = facts.node_local_rows[node];
    let param: Int = facts.node_parameter_ordinals[node];
    let literal: String = facts.node_literals[node];
    let callable: Int = facts.node_callable_rows[node];
    let nary_ready: Option<Bool> =
        DirectMirScalarProgramNaryExpressionNodeReady(facts, node);
    if IsSome(nary_ready) { return UnwrapOption(nary_ready); }
    let collection_ready: Option<Bool> =
        DirectMirScalarProgramCollectionExpressionNodeReady(facts, node);
    if IsSome(collection_ready) { return UnwrapOption(collection_ready); }
    if kind == DirectMirScalarProgramExprLocal() {
        return local >= 0 && left == -1 && right == -1 && param == -1 &&
            literal == "" && callable == -1;
    }
    if kind == DirectMirScalarProgramExprParameter() {
        return param == 0 && left == -1 && right == -1 && local == -1 &&
            literal == "" && callable == -1;
    }
    if kind == DirectMirScalarProgramExprIntLiteral() {
        return type_name == CompilerAbiLayoutIntTypeName() &&
            DirectMirScalarCfgCanonicalInt(literal) && left == -1 &&
            right == -1 && local == -1 && param == -1 && callable == -1;
    }
    if kind == DirectMirScalarProgramExprBoolLiteral() {
        return type_name == CompilerAbiLayoutBoolTypeName() &&
            (literal == "true" || literal == "false") && left == -1 &&
            right == -1 && local == -1 && param == -1 && callable == -1;
    }
    if kind == DirectMirScalarProgramExprStringLiteral() {
        return type_name == CompilerAbiLayoutStringTypeName() &&
            DirectMirScalarProgramLiteralEmbeddable(literal) && left == -1 &&
            right == -1 && local == -1 && param == -1 && callable == -1;
    }
    if kind == DirectMirScalarProgramExprLogicalNot() {
        return type_name == CompilerAbiLayoutBoolTypeName() && left >= 0 &&
            facts.node_types[left] == CompilerAbiLayoutBoolTypeName() &&
            right == -1 && local == -1 && param == -1 && literal == "" &&
            callable == -1;
    }
    if kind == DirectMirScalarProgramExprDirectCall() {
        return DirectMirScalarCfgScalarTypeSupported(type_name) && left >= 0 &&
            DirectMirScalarCfgScalarTypeSupported(facts.node_types[left]) &&
            right == -1 && local == -1 && param == -1 && literal == "" &&
            callable >= 0;
    }
    if kind == DirectMirScalarProgramExprToStringInt() {
        return type_name == CompilerAbiLayoutStringTypeName() && left >= 0 &&
            facts.node_types[left] == CompilerAbiLayoutIntTypeName() &&
            right == -1 && local == -1 && param == -1 && literal == "" &&
            callable == -1;
    }
    if kind == DirectMirScalarProgramExprToUpperString() || kind ==
            DirectMirScalarProgramExprToLowerString() {
        return type_name == CompilerAbiLayoutStringTypeName() && left >= 0 &&
            facts.node_types[left] == CompilerAbiLayoutStringTypeName() &&
            right == -1 && local == -1 && param == -1 && literal == "" && callable == -1;
    }
    if kind == DirectMirScalarProgramExprStringLength() {
        return type_name == CompilerAbiLayoutIntTypeName() && left >= 0 &&
            facts.node_types[left] == CompilerAbiLayoutStringTypeName() &&
            right == -1 && local == -1 && param == -1 && literal == "" &&
            callable == -1;
    }
    let int_binary: Bool = kind == DirectMirScalarProgramExprModuloInt() ||
        kind == DirectMirScalarProgramExprEqualInt() ||
        kind == DirectMirScalarProgramExprLessInt() ||
        kind == DirectMirScalarProgramExprAddInt() ||
        kind == DirectMirScalarProgramExprSubtractInt();
    let bool_binary: Bool = kind == DirectMirScalarProgramExprLogicalAnd() ||
        kind == DirectMirScalarProgramExprLogicalOr();
    let string_binary: Bool = kind == DirectMirScalarProgramExprEqualString() ||
        kind == DirectMirScalarProgramExprNotEqualString() ||
        kind == DirectMirScalarProgramExprConcatString();
    if (!int_binary && !bool_binary && !string_binary) ||
        left < 0 || right < 0 ||
        local != -1 || param != -1 || literal != "" || callable != -1 {
        return false;
    }
    if string_binary {
        let expected_type: String = CompilerAbiLayoutBoolTypeName();
        if kind == DirectMirScalarProgramExprConcatString() {
            expected_type = CompilerAbiLayoutStringTypeName();
        }
        return type_name == expected_type &&
            facts.node_types[left] == CompilerAbiLayoutStringTypeName() &&
            facts.node_types[right] == CompilerAbiLayoutStringTypeName();
    }
    if int_binary {
        if facts.node_types[left] != CompilerAbiLayoutIntTypeName() ||
            facts.node_types[right] != CompilerAbiLayoutIntTypeName() {
            return false;
        }
        if kind == DirectMirScalarProgramExprModuloInt() {
            return type_name == CompilerAbiLayoutIntTypeName() &&
                facts.node_kinds[right] ==
                    DirectMirScalarProgramExprIntLiteral() &&
                facts.node_literals[right] != "0" &&
                facts.node_literals[right] != "-1";
        }
        if kind == DirectMirScalarProgramExprAddInt() || kind ==
                DirectMirScalarProgramExprSubtractInt() {
            return type_name == CompilerAbiLayoutIntTypeName();
        }
        return type_name == CompilerAbiLayoutBoolTypeName();
    }
    return type_name == CompilerAbiLayoutBoolTypeName() &&
        DirectMirScalarProgramNonTrappingBoolNode(facts, right) &&
        facts.node_types[left] == CompilerAbiLayoutBoolTypeName() &&
        facts.node_types[right] == CompilerAbiLayoutBoolTypeName();
}

func DirectMirScalarProgramExpressionSetSemanticallyReady(
    ref facts: DirectMirScalarProgramExpressionSet
) -> Bool {
    if !DirectMirScalarProgramExpressionSetReady(facts) { return false; }
    let node: Int = 0;
    while node < ArrayLength(facts.node_kinds) {
        if !DirectMirScalarProgramExpressionNodeReady(facts, node) {
            return false;
        }
        node = node + 1;
    }
    return true;
}
