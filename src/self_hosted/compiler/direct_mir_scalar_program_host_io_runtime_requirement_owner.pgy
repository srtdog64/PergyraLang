// Sealed host-I/O runtime IDs required by normalized GraphPlan expressions.
import "direct_mir_scalar_program_expression_fact_owner.pgy";
import "direct_mir_scalar_program_expression_kind_query_owner.pgy";
import "direct_mir_scalar_program_compiler_artifact_runtime_requirement_owner.pgy";
import "runtime_call_abi_structured_fact_owner.pgy";
import "../codegen/runtime_abi/host_io_runtime_owner.pgy";

struct DirectMirScalarProgramHostIoRuntimeIds {
    let valid: Bool;
    let process_args_id: Int;
    let dir_walk_id: Int;
    let file_exists_id: Int;
    let read_file_id: Int;
    let compiler_artifact_write_id: Int;
}

func DirectMirScalarProgramHostIoRuntimeIdsEmpty() -> DirectMirScalarProgramHostIoRuntimeIds {
    return DirectMirScalarProgramHostIoRuntimeIds(false, 0, 0, 0, 0, 0);
}

func DirectMirScalarProgramHostIoRuntimeRequirement(
    ref expressions: DirectMirScalarProgramExpressionSet
) -> DirectMirScalarProgramHostIoRuntimeIds {
    let args_required: Bool = DirectMirScalarProgramExpressionContainsKind(
        expressions, DirectMirScalarProgramExprProcessArgs());
    let walk_required: Bool = DirectMirScalarProgramExpressionContainsKind(
        expressions, DirectMirScalarProgramExprDirWalk());
    let exists_required: Bool = DirectMirScalarProgramExpressionContainsKind(
        expressions, DirectMirScalarProgramExprFileExists());
    let read_required: Bool = DirectMirScalarProgramExpressionContainsKind(
        expressions, DirectMirScalarProgramExprReadFile());
    let artifact_write: DirectMirScalarProgramCompilerArtifactRuntimeRequirement =
        DirectMirScalarProgramCompilerArtifactRuntimeRequirementFromExpressions(expressions);
    let args: CompilerRuntimeCallAbiFact = CompilerRuntimeCallAbiFactFromRowInput(
        CompilerRuntimeCallAbiRowInput("host-io", "args",
            HostIORuntimeCArgsFn(),
            CompilerRuntimeCallAbiMaterialGeneratedHelper()));
    let walk: CompilerRuntimeCallAbiFact = CompilerRuntimeCallAbiFactFromRowInput(
        CompilerRuntimeCallAbiRowInput("host-io", "dir-walk",
            HostIORuntimeCDirWalkFn(),
            CompilerRuntimeCallAbiMaterialGeneratedHelper()));
    let exists: CompilerRuntimeCallAbiFact = CompilerRuntimeCallAbiFactFromRowInput(
        CompilerRuntimeCallAbiRowInput("host-io", "file-exists",
            HostIORuntimeCFileExistsFn(),
            CompilerRuntimeCallAbiMaterialGeneratedHelper()));
    let read: CompilerRuntimeCallAbiFact = CompilerRuntimeCallAbiFactFromRowInput(
        CompilerRuntimeCallAbiRowInput("host-io", "read-file",
            HostIORuntimeCReadFileFn(),
            CompilerRuntimeCallAbiMaterialGeneratedHelper()));
    if (args_required && (!args.ok || args.domain != "host-io" ||
            args.operation != "args" || args.symbol != HostIORuntimeCArgsFn() ||
            args.call_shape != "returns_array_string" || args.materialization !=
                CompilerRuntimeCallAbiMaterialGeneratedHelper())) ||
        (walk_required && (!walk.ok || walk.domain != "host-io" ||
            walk.operation != "dir-walk" || walk.symbol !=
                HostIORuntimeCDirWalkFn() || walk.call_shape !=
                "string_to_array_string" || walk.materialization !=
                CompilerRuntimeCallAbiMaterialGeneratedHelper())) ||
        (exists_required && (!exists.ok || exists.domain != "host-io" ||
            exists.operation != "file-exists" || exists.symbol !=
                HostIORuntimeCFileExistsFn() || exists.call_shape !=
                "string_to_bool" || exists.materialization !=
                CompilerRuntimeCallAbiMaterialGeneratedHelper())) ||
        (read_required && (!read.ok || read.domain != "host-io" ||
            read.operation != "read-file" || read.symbol !=
                HostIORuntimeCReadFileFn() || read.call_shape !=
                "string_to_string" || read.materialization !=
                CompilerRuntimeCallAbiMaterialGeneratedHelper())) ||
        !artifact_write.valid {
        return DirectMirScalarProgramHostIoRuntimeIdsEmpty();
    }
    let args_id: Int = 0; let walk_id: Int = 0;
    let exists_id: Int = 0; let read_id: Int = 0;
    if args_required { args_id = args.runtime_call_abi_id; }
    if walk_required { walk_id = walk.runtime_call_abi_id; }
    if exists_required { exists_id = exists.runtime_call_abi_id; }
    if read_required { read_id = read.runtime_call_abi_id; }
    return DirectMirScalarProgramHostIoRuntimeIds(true, args_id, walk_id, exists_id, read_id,
        artifact_write.runtime_call_abi_id);
}
