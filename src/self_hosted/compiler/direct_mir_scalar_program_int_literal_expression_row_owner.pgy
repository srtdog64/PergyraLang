// Appends one canonical Int literal row to the normalized expression arena.
import "direct_mir_scalar_cfg_expression_base_owner.pgy";
import "direct_mir_scalar_program_expression_mutation_owner.pgy";

func DirectMirScalarCfgProgramAppendIntLiteralExpression(
    inout expressions: DirectMirScalarProgramExpressionSet,
    global_row: Int, literal: String
) -> Option<Int> {
    if !expressions.valid ||
        !DirectMirScalarCfgCanonicalInt(literal) { return None; }
    var graph_rows: Array<Int> = expressions.graph_global_rows;
    var starts: Array<Int> = expressions.graph_starts;
    var counts: Array<Int> = expressions.graph_counts;
    var roots: Array<Int> = expressions.graph_roots;
    var kinds: Array<Int> = expressions.node_kinds;
    var types: Array<String> = expressions.node_types;
    var lefts: Array<Int> = expressions.node_lefts;
    var rights: Array<Int> = expressions.node_rights;
    var locals: Array<Int> = expressions.node_local_rows;
    var params: Array<Int> = expressions.node_parameter_ordinals;
    var members: Array<Int> = expressions.node_member_ordinals;
    var literals: Array<String> = expressions.node_literals;
    var callables: Array<Int> = expressions.node_callable_rows;
    var runtime_ids: Array<Int> = expressions.node_runtime_call_abi_ids;
    let start: Int = ArrayLength(kinds);
    DirectMirScalarProgramAppendExpressionNode(
        kinds, types, lefts, rights, locals, params, members, literals,
        callables, runtime_ids, DirectMirScalarProgramExprIntLiteral(),
        CompilerAbiLayoutIntTypeName(), -1, -1, -1, -1, -1, literal, -1,
        -1);
    ArrayPush(graph_rows, global_row); ArrayPush(starts, start);
    ArrayPush(counts, 1); ArrayPush(roots, start);
    expressions = DirectMirScalarProgramExpressionSet(
        true, 0, graph_rows, starts, counts, roots, kinds, types, lefts,
        rights, locals, params, members, literals, callables, runtime_ids,
        expressions.nary_operands);
    return Some(ArrayLength(graph_rows) - 1);
}
