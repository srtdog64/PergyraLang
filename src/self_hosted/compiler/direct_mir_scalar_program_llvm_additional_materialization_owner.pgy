// LLVM composition of responsibility-specific generated runtime bodies.

import "direct_mir_scalar_program_llvm_string_window_materialization_owner.pgy";
import "direct_mir_scalar_program_llvm_string_collection_materialization_owner.pgy";
import "direct_mir_scalar_program_llvm_case_math_materialization_owner.pgy";

func DirectMirScalarProgramLlvmAdditionalMaterialization(
    ref plan: DirectMirScalarCfgGraphPlan,
    ref runtime: DirectMirScalarProgramRuntimeAbiProjection
) -> String {
    let output: String =
        DirectMirScalarProgramLlvmStringWindowMaterialization(plan, runtime);
    output = Concat(output,
        DirectMirScalarProgramLlvmStringCollectionMaterialization(
            plan, runtime));
    return Concat(output,
        DirectMirScalarProgramLlvmCaseMathMaterialization(plan, runtime));
}
