// Array<Long> shares the admitted four-field array descriptor, with i64 elements.
import "direct_mir_array_storage_abi_projection_owner.pgy";
import "direct_mir_scalar_program_expression_fact_owner.pgy";
import "../codegen/runtime_abi/collection_bounds_owner.pgy";

func DirectMirScalarProgramLlvmArrayLongPreamble(
    local_types: Array<String>, ref facts: DirectMirScalarProgramExpressionSet,
    ref target: CompilerTargetProjectionFact
) -> String {
    let present: Bool = false; let get: Bool = false; let index: Int = 0;
    while index < ArrayLength(local_types) {
        if local_types[index] == CompilerAbiLayoutArrayLongTypeName() { present = true; }
        index = index + 1;
    }
    index = 0;
    while index < ArrayLength(facts.node_types) {
        if facts.node_types[index] == CompilerAbiLayoutArrayLongTypeName() { present = true; }
        if facts.node_kinds[index] == DirectMirScalarProgramExprArrayLongIndex() { get = true; }
        index = index + 1;
    }
    if !present { return ""; }
    let storage: DirectMirArrayStorageAbiProjection = DirectMirArrayStorageAbiProjectionFromTarget(target);
    if !DirectMirArrayStorageAbiProjectionReadyFor(storage, CompilerTargetCpuLlvmProjection()) {
        Die("direct MIR Array<Long> target storage is missing");
    }
    let output: String = "%pgy.array.long = type " + storage.llvm_aggregate_type + "\n";
    if !get { return output; }
    return output + "define internal i64 @pgy_array_long_get(%pgy.array.long %array, i64 %index) {\nentry:\n  %length = extractvalue %pgy.array.long %array, 1\n  %negative = icmp slt i64 %index, 0\n  %past = icmp sge i64 %index, %length\n  %invalid = or i1 %negative, %past\n  br i1 %invalid, label %panic, label %read\npanic:\n  call void @${CollectionRuntimeLlvmBoundsPanicFn()}(ptr null)\n  unreachable\nread:\n  %data = extractvalue %pgy.array.long %array, 0\n  %slot = getelementptr inbounds i64, ptr %data, i64 %index\n  %value = load i64, ptr %slot, align 8\n  ret i64 %value\n}\n\n";
}
