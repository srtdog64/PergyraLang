// LLVM mutation target for an admitted Array<String> value-result formal.
import "direct_mir_scalar_cfg_graph_fact_owner.pgy";
import "direct_mir_scalar_program_backend_value_result_storage_owner.pgy";
import "direct_mir_scalar_program_collection_ownership_receipt_source_owner.pgy";
import "direct_mir_scalar_program_collection_ownership_transition_plan_readiness_owner.pgy";
import "direct_mir_scalar_program_runtime_abi_projection_owner.pgy";

func DirectMirScalarProgramLlvmArrayStringValueResultPush(
    ref plan: DirectMirScalarCfgGraphPlan,
    routine: Int, operation: Int, parameter: Int, value: String,
    ref runtime: DirectMirScalarProgramRuntimeAbiProjection
) -> String {
    if parameter < 0 || value == "" ||
        !DirectMirScalarProgramArrayStringValueResultAt(
            plan.program.array_string_abi, routine, parameter) {
        Die("direct MIR LLVM Array<String> value-result push is invalid");
    }
    let storage: String =
        DirectMirScalarProgramLlvmParameterValueResultStorage(
            plan, routine, parameter);
    var stored_value: String = value;
    var prefix: String = "";
    if DirectMirScalarProgramCollectionOwnershipOperationRequiresValueCopy(
            plan, operation) {
        if !CompilerRuntimeCallAbiStringConcatFactReady(
                runtime.string_concat) {
            Die("direct MIR LLVM Array<String> value-result copy ABI is invalid");
        }
        stored_value = Concat(
            "%pgy.owned.push.copy.", ToString(operation));
        prefix = Concat("  ", Concat(stored_value, Concat(
            " = call ptr @", Concat(runtime.string_concat.symbol, Concat(
                "(ptr ", Concat(value,
                    ", ptr @pgy.scalar.owned.push.empty)\n"))))));
    }
    return Concat(prefix, Concat(
        "  call void @pgy_as_push(ptr ", Concat(
            storage, Concat(", ptr ", Concat(stored_value, ")\n")))));
}
