// LLVM adapter from the sealed host-io DirWalk receipt to native runtime ABI.
import "direct_mir_scalar_cfg_graph_fact_owner.pgy";
import "direct_mir_scalar_program_runtime_abi_projection_owner.pgy";
import "../codegen/runtime_abi/host_io_runtime_owner.pgy";

func DirectMirScalarProgramLlvmDirWalkBlock(
    ref plan: DirectMirScalarCfgGraphPlan,
    ref runtime: DirectMirScalarProgramRuntimeAbiProjection
) -> String {
    if plan.program.runtime_abi.dir_walk_id == 0 { return ""; }
    if !runtime.dir_walk.ok || runtime.dir_walk.symbol !=
            HostIORuntimeCDirWalkFn() {
        Die("direct MIR scalar LLVM dir-walk ABI is invalid");
    }
    return Concat(
        "declare %pgy.array.string @pgy_dir_walk(ptr)\ndefine internal %pgy.array.string @",
        Concat(runtime.dir_walk.symbol,
        "(ptr %root) {\nentry:\n  %result = call %pgy.array.string @pgy_dir_walk(ptr %root)\n  ret %pgy.array.string %result\n}\n\n"));
}
