// LLVM adapter from the sealed host-io DirWalk receipt to native runtime ABI.
import "direct_mir_scalar_cfg_graph_fact_owner.pgy";
import "direct_mir_scalar_program_runtime_abi_projection_owner.pgy";
import "direct_mir_scalar_program_array_string_abi_projection_owner.pgy";
import "../codegen/runtime_abi/host_io_runtime_owner.pgy";

func DirectMirScalarProgramLlvmDirWalkBlock(
    ref plan: DirectMirScalarCfgGraphPlan,
    ref runtime: DirectMirScalarProgramRuntimeAbiProjection,
    projection_opt: Option<DirectMirArrayStringAbiProjection>
) -> String {
    if plan.program.runtime_abi.dir_walk_id == 0 { return ""; }
    if !runtime.dir_walk.ok || runtime.dir_walk.symbol !=
            HostIORuntimeCDirWalkFn() {
        Die("direct MIR scalar LLVM dir-walk ABI is invalid");
    }
    if !IsSome(projection_opt) { Die(
        "direct MIR scalar LLVM dir-walk Array<String> projection is missing"); }
    let projection: DirectMirArrayStringAbiProjection = UnwrapOption(projection_opt);
    if !DirectMirScalarProgramArrayStringAbiProjectionReadyForFact(
            plan.program.array_string_abi, projection,
            CompilerTargetCpuLlvmProjection()) {
        Die("direct MIR scalar LLVM dir-walk Array<String> projection drifted");
    }
    let aggregate: String = projection.llvm_value_type;
    let output: String = Concat("declare ", Concat(aggregate,
        Concat(" @pgy_dir_walk(ptr)\ndefine internal ", aggregate)));
    output = Concat(output, Concat(" @", Concat(runtime.dir_walk.symbol,
        "(ptr %root) {\nentry:\n  %result = call ")));
    output = Concat(output, Concat(aggregate,
        " @pgy_dir_walk(ptr %root)\n  ret "));
    return Concat(output, Concat(aggregate, " %result\n}\n\n"));
}
