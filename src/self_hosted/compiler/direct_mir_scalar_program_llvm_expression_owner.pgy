// LLVM expression projection from the sealed scalar-program expression arena.

import "direct_mir_scalar_program_expression_readiness_owner.pgy";
import "direct_mir_scalar_program_llvm_builtin_expression_owner.pgy";
import "direct_mir_scalar_program_llvm_type_owner.pgy";

struct DirectMirScalarProgramLlvmExpression {
    let valid: Bool;
    let instructions: String;
    let value: String;
    let type_name: String;
}

func DirectMirScalarProgramLlvmNodeName(
    expression_row: Int, node: Int
) -> String {
    return Concat("%pgy.expr.", Concat(
        ToString(expression_row), Concat(".", ToString(node))));
}

func DirectMirScalarProgramLlvmLocalName(row: Int) -> String {
    return Concat("%pgy.local.", ToString(row));
}

func DirectMirScalarProgramLlvmExpressionAt(
    ref expressions: DirectMirScalarProgramExpressionSet,
    expression_row: Int,
    ref runtime: DirectMirScalarProgramRuntimeAbiProjection
) -> DirectMirScalarProgramLlvmExpression {
    let instructions: String = "";
    let values: Array<String> = [];
    let start: Int = expressions.graph_starts[expression_row];
    let count: Int = expressions.graph_counts[expression_row];
    let node: Int = start;
    while node < start + count {
        let kind: Int = expressions.node_kinds[node];
        let left: String = ""; let right: String = "";
        if expressions.node_lefts[node] >= start {
            left = values[expressions.node_lefts[node] - start];
        }
        if expressions.node_rights[node] >= start {
            right = values[expressions.node_rights[node] - start];
        }
        let arguments: Array<String> = [];
        let argument_types: Array<String> = [];
        let argument_rows: Array<Int> =
            DirectMirScalarProgramNaryOperandRows(
                expressions.nary_operands, node);
        let argument: Int = 0;
        while argument < ArrayLength(argument_rows) {
            if argument_rows[argument] < start ||
                argument_rows[argument] >= node {
                return DirectMirScalarProgramLlvmExpression(
                    false, "", "", "");
            }
            ArrayPush(arguments, values[argument_rows[argument] - start]);
            ArrayPush(argument_types,
                expressions.node_types[argument_rows[argument]]);
            argument = argument + 1;
        }
        let value: String = "";
        let result: String = DirectMirScalarProgramLlvmNodeName(
            expression_row, node);
        if kind == DirectMirScalarProgramExprLocal() {
            let type_name: String = DirectMirScalarProgramLlvmType(
                expressions.node_types[node]);
            value = result;
            instructions = Concat(instructions, "  ");
            instructions = Concat(instructions, value);
            instructions = Concat(instructions, " = load ");
            instructions = Concat(instructions, type_name);
            instructions = Concat(instructions, ", ptr ");
            instructions = Concat(instructions,
                DirectMirScalarProgramLlvmLocalName(
                    expressions.node_local_rows[node]));
            instructions = Concat(instructions, "\n");
        } else if kind == DirectMirScalarProgramExprParameter() {
            value = Concat("%pgy.param.", ToString(
                expressions.node_parameter_ordinals[node]));
        } else if kind == DirectMirScalarProgramExprIntLiteral() ||
                kind == DirectMirScalarProgramExprBoolLiteral() {
            value = expressions.node_literals[node];
        } else if kind == DirectMirScalarProgramExprStringLiteral() {
            value = Concat("@pgy.scalar.string.", ToString(node));
        } else {
            let left_type: String = ""; let right_type: String = "";
            if expressions.node_lefts[node] >= start {
                left_type = expressions.node_types[
                    expressions.node_lefts[node]];
            }
            if expressions.node_rights[node] >= start {
                right_type = expressions.node_types[
                    expressions.node_rights[node]];
            }
            let string_expression: DirectMirScalarProgramLlvmStringExpression =
                DirectMirScalarProgramLlvmBuiltinExpressionAt(
                    kind, result, expressions.node_types[node],
                    left, left_type, right, right_type,
                    arguments, argument_types,
                    expressions.node_callable_rows[node], runtime);
            if string_expression.matched {
                if !string_expression.valid {
                    return DirectMirScalarProgramLlvmExpression(
                        false, "", "", "");
                }
                instructions = Concat(
                    instructions, string_expression.instructions);
                value = string_expression.value;
            } else {
                value = result;
                instructions = Concat(instructions, Concat("  ", result));
                if kind == DirectMirScalarProgramExprModuloInt() {
                    instructions = Concat(instructions, " = srem i64 ");
                } else if kind == DirectMirScalarProgramExprEqualInt() {
                    instructions = Concat(instructions, " = icmp eq i64 ");
                } else if kind == DirectMirScalarProgramExprLogicalNot() {
                    instructions = Concat(instructions, " = xor i1 ");
                } else if kind == DirectMirScalarProgramExprLogicalAnd() {
                    instructions = Concat(instructions, " = and i1 ");
                } else if kind == DirectMirScalarProgramExprLogicalOr() {
                    instructions = Concat(instructions, " = or i1 ");
                } else if kind == DirectMirScalarProgramExprLessInt() {
                    instructions = Concat(instructions, " = icmp slt i64 ");
                } else if kind == DirectMirScalarProgramExprAddInt() {
                    instructions = Concat(instructions, " = add nsw i64 ");
                } else if kind == DirectMirScalarProgramExprSubtractInt() {
                    instructions = Concat(instructions, " = sub nsw i64 ");
                } else if kind == DirectMirScalarProgramExprNegateInt() {
                    instructions = Concat(instructions, " = sub nsw i64 0, ");
                } else {
                    return DirectMirScalarProgramLlvmExpression(
                        false, "", "", "");
                }
                instructions = Concat(instructions, left);
                if kind == DirectMirScalarProgramExprLogicalNot() {
                    instructions = Concat(instructions, ", true");
                } else if kind == DirectMirScalarProgramExprNegateInt() {
                    // The leading zero and comma are already part of the opcode.
                } else {
                    instructions = Concat(
                        instructions, Concat(", ", right));
                }
                instructions = Concat(instructions, "\n");
            }
        }
        ArrayPush(values, value); node = node + 1;
    }
    let root: Int = expressions.graph_roots[expression_row] - start;
    return DirectMirScalarProgramLlvmExpression(
        true, instructions, values[root],
        expressions.node_types[expressions.graph_roots[expression_row]]);
}
