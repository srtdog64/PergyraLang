// LLVM expression projection from the sealed scalar-program expression arena.
import "direct_mir_scalar_program_expression_readiness_owner.pgy";
import "direct_mir_scalar_program_llvm_builtin_expression_owner.pgy";
import "direct_mir_scalar_program_llvm_type_owner.pgy";
import "direct_mir_scalar_program_llvm_logical_value_expression_owner.pgy";
import "direct_mir_scalar_cfg_routine_partition_fact_owner.pgy";
import "direct_mir_scalar_program_llvm_logical_record_readonly_ref_owner.pgy";
import "direct_mir_scalar_program_llvm_array_bool_empty_literal_expression_owner.pgy";
import "direct_mir_scalar_program_llvm_short_circuit_owner.pgy";
import "direct_mir_scalar_program_llvm_numeric_cast_expression_owner.pgy";
import "direct_mir_scalar_program_llvm_logical_record_array_empty_literal_expression_owner.pgy";
import "direct_mir_scalar_program_llvm_external_runtime_expression_owner.pgy";
import "direct_mir_scalar_program_llvm_array_string_readonly_ref_owner.pgy";
import "direct_mir_scalar_program_llvm_collection_parameter_binding_owner.pgy";
import "direct_mir_scalar_program_llvm_int_wrap_expression_owner.pgy";
import "direct_mir_scalar_program_payload_enum_target_expression_owner.pgy";
struct DirectMirScalarProgramLlvmExpression {
    let valid: Bool;
    let instructions: String;
    let value: String;
    let type_name: String;
}
func DirectMirScalarProgramLlvmNodeName(
    expression_row: Int, node: Int
) -> String {
    return Concat("%pgy.expr.", Concat(
        ToString(expression_row), Concat(".", ToString(node))));
}
func DirectMirScalarProgramLlvmLocalName(row: Int) -> String {
    return Concat("%pgy.local.", ToString(row));
}
func DirectMirScalarProgramLlvmExpressionAt(
    ref expressions: DirectMirScalarProgramExpressionSet,
    expression_row: Int,
    ref runtime: DirectMirScalarProgramRuntimeAbiProjection,
    ref nominal: DirectMirScalarProgramTwoIntNominalAbiFact,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    ref payload_free_enum: DirectMirScalarProgramPayloadFreeEnumFact,
    ref referenced_enum: DirectMirScalarProgramReferencedEnumFact,
    ref routines: DirectMirScalarCfgRoutinePartitionFact, routine: Int,
    target: CompilerTargetProjectionFact
) -> DirectMirScalarProgramLlvmExpression {
    let chunks: Array<String> = [];
    let values: Array<String> = [];
    let start: Int = expressions.graph_starts[expression_row];
    let count: Int = expressions.graph_counts[expression_row];
    let node: Int = start;
    while node < start + count {
        let node_instructions: String = "";
        let kind: Int = expressions.node_kinds[node];
        let left: String = ""; let right: String = "";
        let left_address: String = "";
        if expressions.node_lefts[node] >= start {
            left = values[expressions.node_lefts[node] - start];
            let left_node: Int = expressions.node_lefts[node];
            if expressions.node_kinds[left_node] ==
                    DirectMirScalarProgramExprLocal() {
                left_address = DirectMirScalarProgramLlvmLocalName(
                    expressions.node_local_rows[left_node]);
            } else if expressions.node_kinds[left_node] ==
                    DirectMirScalarProgramExprParameter() {
                let left_ordinal: Int =
                    expressions.node_parameter_ordinals[left_node];
                let left_parameter_row: Int =
                    routines.parameter_starts[routine] + left_ordinal;
                let parameter_address: String =
                    DirectMirScalarProgramLlvmCollectionParameterMutationAddress(
                        routines, left_parameter_row, left_ordinal);
                if parameter_address != "" { left_address = parameter_address; }
            }
        }
        if expressions.node_rights[node] >= start {
            right = values[expressions.node_rights[node] - start];
        }
        let arguments: Array<String> = [];
        let argument_types: Array<String> = [];
        let argument_kinds: Array<Int> = [];
        let argument_carriages: Array<String> = [];
        let argument_rows: Array<Int> =
            DirectMirScalarProgramNaryOperandRows(
                expressions.nary_operands, node);
        if kind == DirectMirScalarProgramExprDirectCall() || kind == DirectMirScalarProgramExprCallableParameterCall() {
            argument_rows = DirectMirScalarProgramDirectCallArgumentRows(
                expressions, node);
        } else if kind == DirectMirScalarProgramExprLogicalRecordConstructor() ||
                kind == DirectMirScalarProgramExprPayloadEnumConstructor() {
            argument_rows = DirectMirScalarProgramLogicalRecordArgumentRows(
                expressions, node);
        }
        let argument: Int = 0;
        while argument < ArrayLength(argument_rows) {
            if argument_rows[argument] < start ||
                argument_rows[argument] >= node {
                return DirectMirScalarProgramLlvmExpression(
                    false, "", "", "");
            }
            let argument_value: String =
                values[argument_rows[argument] - start];
            let argument_carriage: String = "value";
            if kind == DirectMirScalarProgramExprDirectCall() &&
                expressions.node_callable_rows[node] >= 0 {
                let call_argument: DirectMirScalarProgramLlvmCallArgument = DirectMirScalarProgramLlvmCallArgumentValue(
                    expressions, routines, logical_record, routine,
                    expressions.node_callable_rows[node], argument, argument_rows[argument], argument_value);
                if !call_argument.valid { return DirectMirScalarProgramLlvmExpression(
                    false, "", "", ""); }
                node_instructions = Concat(node_instructions, call_argument.instructions);
                argument_value = call_argument.value;
                argument_carriage = call_argument.carriage;
            }
            ArrayPush(arguments, argument_value);
            ArrayPush(argument_types,
                expressions.node_types[argument_rows[argument]]);
            ArrayPush(argument_kinds,
                expressions.node_kinds[argument_rows[argument]]);
            ArrayPush(argument_carriages, argument_carriage);
            argument = argument + 1;
        }
        let value: String = "";
        let result: String = DirectMirScalarProgramLlvmNodeName(expression_row, node);
        let cast_value: Option<String> = DirectMirScalarProgramLlvmNumericCastExpressionValue(kind, left);
        if IsSome(cast_value) { value = UnwrapOption(cast_value);
        } else if kind == DirectMirScalarProgramExprLocal() {
            let type_name: String =
                DirectMirScalarProgramLlvmTypeForProgramWithReferencedEnum(
                    expressions.node_types[node], nominal, logical_record,
                    payload_free_enum, referenced_enum);
            if type_name == "" { return DirectMirScalarProgramLlvmExpression(
                false, "", "", ""); }
            value = result;
            node_instructions = Concat(node_instructions, "  ");
            node_instructions = Concat(node_instructions, value);
            node_instructions = Concat(node_instructions, " = load ");
            node_instructions = Concat(node_instructions, type_name);
            node_instructions = Concat(node_instructions, ", ptr ");
            node_instructions = Concat(node_instructions,
                DirectMirScalarProgramLlvmLocalName(
                    expressions.node_local_rows[node]));
            node_instructions = Concat(node_instructions, "\n");
        } else if kind == DirectMirScalarProgramExprParameter() {
            let ordinal: Int = expressions.node_parameter_ordinals[node];
            value = Concat("%pgy.param.", ToString(ordinal));
            let parameter_row: Int = routines.parameter_starts[routine] +
                ordinal;
            let array_type: String =
                DirectMirScalarProgramLlvmValueResultCollectionTypeName(
                    logical_record, routines.parameter_types[parameter_row]);
            if routines.parameter_carriages[parameter_row] == "value-result" &&
                    array_type != "" {
                value = result;
                node_instructions = Concat(node_instructions, Concat("  ", result));
                node_instructions = Concat(node_instructions,
                    Concat(" = load ", Concat(array_type, ", ptr %pgy.param.")));
                node_instructions = Concat(node_instructions, ToString(ordinal));
                node_instructions = Concat(node_instructions, ".local, align 8\n");
            }
            let parameter_read:
                DirectMirScalarProgramLlvmStringExpression =
                    DirectMirScalarProgramLlvmLogicalRecordParameterRead(
                        expressions, routines, logical_record, routine, node,
                        result, value);
            if parameter_read.matched {
                if !parameter_read.valid {
                    return DirectMirScalarProgramLlvmExpression(
                        false, "", "", "");
                }
                node_instructions = Concat(
                    node_instructions, parameter_read.instructions);
                value = parameter_read.value;
            }
            let array_parameter_read:
                DirectMirScalarProgramLlvmStringExpression =
                    DirectMirScalarProgramLlvmArrayStringReadonlyRefParameterRead(
                        routines, routine, ordinal, result);
            if array_parameter_read.matched {
                if !array_parameter_read.valid {
                    return DirectMirScalarProgramLlvmExpression(
                        false, "", "", "");
                }
                node_instructions = Concat(
                    node_instructions, array_parameter_read.instructions);
                value = array_parameter_read.value;
            }
        } else if kind == DirectMirScalarProgramExprDeclaredCallable() {
            value = Concat("@pgy.scalar.routine.", ToString(expressions.node_callable_rows[node]));
        } else if kind == DirectMirScalarProgramExprIntLiteral() || kind ==
                DirectMirScalarProgramExprLongLiteral() || kind == DirectMirScalarProgramExprBoolLiteral() {
            value = expressions.node_literals[node];
        } else if kind ==
                DirectMirScalarProgramExprPayloadFreeEnumVariant() {
            value = ToString(expressions.node_member_ordinals[node]);
        } else if kind == DirectMirScalarProgramExprStringLiteral() {
            value = Concat("@pgy.scalar.string.", ToString(node));
        } else if kind == DirectMirScalarProgramExprArrayBoolEmptyLiteral() {
            let empty_bool: DirectMirScalarProgramLlvmStringExpression =
                DirectMirScalarProgramLlvmArrayBoolEmptyLiteralExpressionAt(
                    kind);
            if !empty_bool.matched || !empty_bool.valid {
                return DirectMirScalarProgramLlvmExpression(
                    false, "", "", "");
            }
            value = empty_bool.value;
        } else if kind ==
                DirectMirScalarProgramExprLogicalRecordArrayEmptyLiteral() {
            let empty_record_array:
                DirectMirScalarProgramLlvmStringExpression =
                DirectMirScalarProgramLlvmLogicalRecordArrayEmptyLiteralExpressionAt(
                    kind, expressions.node_types[node], logical_record,
                    target);
            if !empty_record_array.matched || !empty_record_array.valid {
                return DirectMirScalarProgramLlvmExpression(
                    false, "", "", "");
            }
            node_instructions = empty_record_array.instructions;
            value = empty_record_array.value;
        } else {
            let payload_enum:
                DirectMirScalarProgramLlvmPayloadEnumExpression =
                DirectMirScalarProgramLlvmPayloadEnumExpressionAt(
                    expressions, node, result, left, arguments,
                    argument_types, nominal, logical_record,
                    payload_free_enum, referenced_enum);
            if payload_enum.matched {
                if !payload_enum.valid {
                    return DirectMirScalarProgramLlvmExpression(
                        false, "", "", "");
                }
                node_instructions = payload_enum.instructions;
                value = payload_enum.value;
            } else {
            let runtime_value: DirectMirScalarProgramLlvmStringExpression =
                DirectMirScalarProgramLlvmExternalRuntimeExpressionAt(
                    expressions, node, result, left, right);
            if runtime_value.matched {
                if !runtime_value.valid {
                    return DirectMirScalarProgramLlvmExpression(
                        false, "", "", "");
                }
                node_instructions = runtime_value.instructions;
                value = runtime_value.value;
            } else {
            let left_type: String = ""; let right_type: String = "";
            if expressions.node_lefts[node] >= start {
                left_type = expressions.node_types[
                    expressions.node_lefts[node]];
            }
            if expressions.node_rights[node] >= start {
                right_type = expressions.node_types[
                    expressions.node_rights[node]];
            }
            let record_type: String = expressions.node_types[node];
            if kind == DirectMirScalarProgramExprLogicalRecordMember() { record_type = left_type; }
            let record_expression: DirectMirScalarProgramLlvmStringExpression = DirectMirScalarProgramLlvmLogicalValueExpressionAt(
                        logical_record, target, kind, result, record_type,
                        left_type, expressions.node_types[node], left, right,
                        arguments, argument_types,
                        expressions.node_member_ordinals[node]);
            if record_expression.matched {
                if !record_expression.valid {
                    return DirectMirScalarProgramLlvmExpression(
                        false, "", "", "");
                }
                node_instructions = Concat(
                    node_instructions, record_expression.instructions);
                value = record_expression.value;
            } else {
            let string_expression: DirectMirScalarProgramLlvmStringExpression =
                DirectMirScalarProgramLlvmBuiltinExpressionAt(
                    kind, result, expressions.node_types[node],
                    left, left_address, left_type, right, right_type,
                    DirectMirScalarProgramArrayStringLiteralOwnsElements(
                        expressions, node, routines, routine),
                    arguments, argument_types, argument_kinds,
                    argument_carriages,
                    expressions.node_callable_rows[node], expressions.node_parameter_ordinals[node], runtime,
                    logical_record, payload_free_enum, referenced_enum);
            if string_expression.matched {
                if !string_expression.valid {
                    return DirectMirScalarProgramLlvmExpression(
                        false, "", "", "");
                }
                node_instructions = Concat(
                    node_instructions, string_expression.instructions);
                value = string_expression.value;
            } else {
                let short_circuit: DirectMirScalarProgramLlvmShortCircuit =
                    DirectMirScalarProgramLlvmShortCircuitAt(
                        expressions, expression_row, node, start,
                        chunks, left, right, result);
                if short_circuit.matched {
                    if !short_circuit.valid {
                        return DirectMirScalarProgramLlvmExpression(
                            false, "", "", "");
                    }
                    node_instructions = short_circuit.instructions;
                    value = result;
                } else {
                let int_wrap: DirectMirScalarProgramLlvmStringExpression =
                    DirectMirScalarProgramLlvmIntWrapExpressionAt(
                        kind, result, left, right);
                if int_wrap.matched {
                    if !int_wrap.valid { return DirectMirScalarProgramLlvmExpression(
                        false, "", "", ""); }
                    node_instructions = int_wrap.instructions;
                    value = int_wrap.value;
                } else {
                value = result;
                node_instructions = Concat(node_instructions, Concat("  ", result));
                if kind == DirectMirScalarProgramExprEqualInt() || kind == DirectMirScalarProgramExprEqualLong() || kind == DirectMirScalarProgramExprEqualPayloadFreeEnum() { node_instructions = Concat(node_instructions, " = icmp eq i64 ");
                } else if kind == DirectMirScalarProgramExprEqualBool() { node_instructions = Concat(node_instructions, " = icmp eq i1 ");
                } else if kind == DirectMirScalarProgramExprNotEqualInt() || kind == DirectMirScalarProgramExprNotEqualLong() || kind == DirectMirScalarProgramExprNotEqualPayloadFreeEnum() { node_instructions = Concat(node_instructions, " = icmp ne i64 ");
                } else if kind == DirectMirScalarProgramExprNotEqualBool() { node_instructions = Concat(node_instructions, " = icmp ne i1 ");
                } else if kind == DirectMirScalarProgramExprGreaterEqualInt() { node_instructions = Concat(node_instructions, " = icmp sge i64 ");
                } else if kind == DirectMirScalarProgramExprGreaterInt() || kind == DirectMirScalarProgramExprGreaterLong() { node_instructions = Concat(node_instructions, " = icmp sgt i64 ");
                } else if kind == DirectMirScalarProgramExprLessEqualInt() { node_instructions = Concat(node_instructions, " = icmp sle i64 ");
                } else if kind == DirectMirScalarProgramExprLogicalNot() {
                    node_instructions = Concat(node_instructions, " = xor i1 ");
                } else if kind == DirectMirScalarProgramExprLogicalAnd() {
                    node_instructions = Concat(node_instructions, " = and i1 ");
                } else if kind == DirectMirScalarProgramExprLogicalOr() {
                    node_instructions = Concat(node_instructions, " = or i1 ");
                } else if kind == DirectMirScalarProgramExprLessInt() || kind == DirectMirScalarProgramExprLessLong() {
                    node_instructions = Concat(node_instructions, " = icmp slt i64 ");
                } else if kind == DirectMirScalarProgramExprAddLong() {
                    node_instructions = Concat(node_instructions, " = add i64 ");
                } else if kind == DirectMirScalarProgramExprSubtractLong() {
                    node_instructions = Concat(node_instructions, " = sub i64 ");
                } else if kind == DirectMirScalarProgramExprMultiplyLong() {
                    node_instructions = Concat(node_instructions, " = mul i64 ");
                } else if kind == DirectMirScalarProgramExprDivideInt() {
                    node_instructions = Concat(node_instructions, " = sdiv i64 ");
                } else {
                    return DirectMirScalarProgramLlvmExpression(
                        false, "", "", "");
                }
                node_instructions = Concat(node_instructions, left);
                if kind == DirectMirScalarProgramExprLogicalNot() {
                    node_instructions = Concat(node_instructions, ", true");
                } else {
                    node_instructions = Concat(
                        node_instructions, Concat(", ", right));
                }
                node_instructions = Concat(node_instructions, "\n");
                }
                }
            }
            }
            }
            }
        }
        ArrayPush(chunks, node_instructions);
        ArrayPush(values, value); node = node + 1;
    }
    let instructions: String =
        DirectMirScalarProgramLlvmExpressionChunksJoin(chunks);
    let root: Int = expressions.graph_roots[expression_row] - start;
    return DirectMirScalarProgramLlvmExpression(
        true, instructions, values[root],
        expressions.node_types[expressions.graph_roots[expression_row]]);
}
