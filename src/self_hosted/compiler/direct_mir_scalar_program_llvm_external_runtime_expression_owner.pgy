// LLVM projection of external runtime calls carried by typed scalar expression facts.

import "direct_mir_scalar_program_expression_fact_owner.pgy";
import "direct_mir_scalar_program_llvm_runtime_value_expression_owner.pgy";
import "direct_mir_scalar_program_llvm_string_expression_fact_owner.pgy";
import "direct_mir_scalar_program_llvm_type_owner.pgy";
import "direct_mir_scalar_program_llvm_external_runtime_declaration_owner.pgy";
import "direct_mir_scalar_program_task_builtin_owner.pgy";
import "../lib/intent_observability_abi_projection_owner.pgy";

func DirectMirScalarProgramLlvmTaskObservationExpressionAt(
    ref expressions: DirectMirScalarProgramExpressionSet, node: Int,
    result: String
) -> DirectMirScalarProgramLlvmStringExpression {
    if expressions.node_kinds[node] !=
            DirectMirScalarProgramExprTaskIsCancelled() {
        return DirectMirScalarProgramLlvmStringExpressionMissing();
    }
    let task: CompilerRuntimeCallAbiFact =
        DirectMirScalarProgramTaskRuntimeFact();
    if !CompilerRuntimeCallAbiTaskIsCancelledFactReady(task) ||
        expressions.node_runtime_call_abi_ids[node] != task.runtime_call_abi_id {
        return DirectMirScalarProgramLlvmStringExpression(
            true, false, "", "");
    }
    let output: String = Concat("  ", Concat(result, Concat(
        " = call i1 @", Concat(task.symbol, "()\n"))));
    return DirectMirScalarProgramLlvmStringExpression(
        true, true, output, result);
}

func DirectMirScalarProgramLlvmIntentObservabilityExpressionAt(
    ref expressions: DirectMirScalarProgramExpressionSet, node: Int,
    result: String, left: String, right: String
) -> DirectMirScalarProgramLlvmStringExpression {
    if expressions.node_kinds[node] !=
            DirectMirScalarProgramExprIntentObservabilityCall() {
        return DirectMirScalarProgramLlvmStringExpressionMissing();
    }
    let row: IntentObservabilityAbiRow = IntentObservabilityAbiRowForId(
        expressions.node_runtime_call_abi_ids[node]);
    let llvm_type: String = DirectMirScalarProgramLlvmType(row.return_type);
    if !row.valid || llvm_type == "" {
        return DirectMirScalarProgramLlvmStringExpression(
            true, false, "", "");
    }
    let arguments: String = "";
    if row.argument_count == 1 { arguments = Concat("i64 ", left); }
    else if row.argument_count == 2 {
        arguments = Concat("i64 ", Concat(left, Concat(", i64 ", right)));
    } else if row.argument_count != 0 {
        return DirectMirScalarProgramLlvmStringExpression(
            true, false, "", "");
    }
    let output: String = Concat("  ", Concat(result, Concat(
        " = call ", Concat(llvm_type, Concat(" @", Concat(
            row.runtime_name, Concat("(", Concat(arguments, ")\n"))))))));
    return DirectMirScalarProgramLlvmStringExpression(
        true, true, output, result);
}

func DirectMirScalarProgramLlvmExternalRuntimeExpressionAt(
    ref expressions: DirectMirScalarProgramExpressionSet, node: Int,
    result: String, left: String, right: String
) -> DirectMirScalarProgramLlvmStringExpression {
    let task: DirectMirScalarProgramLlvmStringExpression =
        DirectMirScalarProgramLlvmTaskObservationExpressionAt(
            expressions, node, result);
    if task.matched { return task; }
    let observability: DirectMirScalarProgramLlvmStringExpression =
        DirectMirScalarProgramLlvmIntentObservabilityExpressionAt(
            expressions, node, result, left, right);
    if observability.matched { return observability; }
    return DirectMirScalarProgramLlvmRuntimeValueExpressionAt(
        expressions, node, result, left, right);
}
