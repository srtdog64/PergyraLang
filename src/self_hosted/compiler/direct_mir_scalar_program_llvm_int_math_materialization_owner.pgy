// Standalone LLVM integer math helpers selected by sealed runtime IDs.

import "direct_mir_scalar_program_case_math_runtime_projection_owner.pgy";

func DirectMirScalarProgramLlvmIntMathMaterialization(
    ref projection: DirectMirScalarProgramCaseMathRuntimeProjection,
    ref ids: DirectMirScalarProgramCaseMathRuntimeIds
) -> String {
    let output: String = "";
    if ids.long_modulo_id != 0 {
        output = Concat(output, Concat("declare i64 @",
            Concat(projection.long_modulo.symbol, "(i64, i64)\n\n")));
    }
    if ids.long_division_id != 0 {
        output = Concat(output, Concat("declare i64 @",
            Concat(projection.long_division.symbol, "(i64, i64)\n\n")));
    }
    if ids.abs_id != 0 {
        output = Concat(output, Concat("define internal i64 @",
            Concat(projection.abs.symbol,
            "(i64 %value) {\nentry:\n  %narrow = trunc i64 %value to i32\n  %negative = icmp slt i32 %narrow, 0\n  %negated = sub i32 0, %narrow\n  %selected = select i1 %negative, i32 %negated, i32 %narrow\n  %result = sext i32 %selected to i64\n  ret i64 %result\n}\n\n")));
    }
    if ids.min_id != 0 {
        output = Concat(output, Concat("define internal i64 @",
            Concat(projection.min.symbol,
            "(i64 %left, i64 %right) {\nentry:\n  %less = icmp slt i64 %left, %right\n  %result = select i1 %less, i64 %left, i64 %right\n  ret i64 %result\n}\n\n")));
    }
    if ids.max_id != 0 {
        output = Concat(output, Concat("define internal i64 @",
            Concat(projection.max.symbol,
            "(i64 %left, i64 %right) {\nentry:\n  %greater = icmp sgt i64 %left, %right\n  %result = select i1 %greater, i64 %left, i64 %right\n  ret i64 %result\n}\n\n")));
    }
    return output;
}
