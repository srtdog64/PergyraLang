// LLVM target spelling for local and value-result logical-record arrays.
import "direct_mir_scalar_program_llvm_logical_record_owner.pgy";
import "direct_mir_scalar_program_logical_record_array_target_owner.pgy";
import "direct_mir_scalar_program_logical_record_array_value_result_target_owner.pgy";
import "direct_mir_scalar_program_backend_value_result_storage_owner.pgy";
import "direct_mir_scalar_program_logical_record_array_mutation_target_fact_owner.pgy";

func DirectMirScalarProgramLlvmLogicalRecordArrayValueResultMutation(
    ref plan: DirectMirScalarCfgGraphPlan, routine: Int,
    local_row: Int, parameter: Int,
    index: String, value_type: String, value: String,
    ref target: CompilerTargetProjectionFact
) -> String {
    let mutation_target: DirectMirScalarProgramLogicalRecordArrayMutationTargetFact =
        DirectMirScalarProgramLogicalRecordArrayMutationTargetFactAt(
            plan, routine, local_row, parameter);
    if !mutation_target.valid || value == "" {
        Die("direct MIR LLVM logical-record Array mutation identity is invalid");
    }
    var storage: String = "";
    if local_row >= 0 {
        storage = Concat("%pgy.local.", ToString(local_row));
    } else {
        storage = DirectMirScalarProgramLlvmParameterValueResultStorage(
            plan, routine, parameter);
    }
    let projected: DirectMirScalarProgramLogicalRecordArrayTarget =
        DirectMirScalarProgramLogicalRecordArrayTargetFromType(
            plan.program.logical_record, mutation_target.array_type, target);
    if !DirectMirScalarProgramLogicalRecordArrayTargetReadyFor(
            projected, CompilerTargetCpuLlvmProjection()) ||
        mutation_target.element_type != value_type {
        Die("direct MIR LLVM logical-record Array mutation type is invalid");
    }
    let element_type: String = DirectMirScalarProgramLlvmLogicalRecordTypeName(
        plan.program.logical_record, projected.element_type);
    var operation: String = "push.";
    if index != "" { operation = "set."; }
    var output: String = Concat(
        "  call void @pgy.scalar.logical.record.array.", operation);
    output = Concat(output, Concat(
        ToString(projected.record_row), "(ptr "));
    output = Concat(output, Concat(storage, ", "));
    if index != "" {
        output = Concat(output, Concat("i64 ", Concat(index, ", ")));
    }
    output = Concat(output, Concat(element_type, " "));
    return Concat(output, Concat(value, ")\n"));
}
