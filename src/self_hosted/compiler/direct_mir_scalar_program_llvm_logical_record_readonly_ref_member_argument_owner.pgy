// LLVM readonly-ref binding for a logical-record member call argument.

import "direct_mir_scalar_cfg_routine_partition_fact_owner.pgy";
import "direct_mir_scalar_program_expression_fact_owner.pgy";
import "direct_mir_scalar_program_llvm_logical_record_owner.pgy";
import "direct_mir_scalar_program_llvm_string_expression_fact_owner.pgy";

func DirectMirScalarProgramLlvmLogicalRecordMemberCallArgument(
    ref expressions: DirectMirScalarProgramExpressionSet,
    ref routines: DirectMirScalarCfgRoutinePartitionFact,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    routine: Int, argument_node: Int, value: String
) -> DirectMirScalarProgramLlvmStringExpression {
    let members: Array<Int> = [];
    let receiver: Int = argument_node;
    while receiver >= 0 && receiver < ArrayLength(expressions.node_kinds) &&
            expressions.node_kinds[receiver] == DirectMirScalarProgramExprLogicalRecordMember() {
        let parent: Int = expressions.node_lefts[receiver];
        let member: Int = expressions.node_member_ordinals[receiver];
        if parent < 0 || parent >= receiver || member < 0 ||
            !DirectMirScalarProgramLogicalRecordTypeReady(
                logical_record, expressions.node_types[parent]) {
            return DirectMirScalarProgramLlvmStringExpression(true, false, "", "");
        }
        ArrayPush(members, member);
        receiver = parent;
    }
    if ArrayLength(members) == 0 {
        return DirectMirScalarProgramLlvmStringExpression(
            true, false, "", "");
    }
    let receiver_type: String =
        DirectMirScalarProgramLlvmLogicalRecordTypeName(
            logical_record, expressions.node_types[receiver]);
    let receiver_pointer: String = "";
    let receiver_instructions: String = "";
    if expressions.node_kinds[receiver] ==
            DirectMirScalarProgramExprLocal() {
        receiver_pointer = Concat("%pgy.local.", ToString(
            expressions.node_local_rows[receiver]));
    } else if expressions.node_kinds[receiver] ==
            DirectMirScalarProgramExprParameter() {
        let source: Int = expressions.node_parameter_ordinals[receiver];
        let source_row: Int = routines.parameter_starts[routine] + source;
        if routines.parameter_carriages[source_row] == "readonly-ref" {
            receiver_pointer = Concat("%pgy.param.", ToString(source));
        } else if routines.parameter_carriages[source_row] == "value-result" {
            receiver_pointer = Concat("%pgy.param.", Concat(
                ToString(source), ".local"));
        } else if routines.parameter_carriages[source_row] == "value" ||
                routines.parameter_carriages[source_row] == "owner-handle" {
            receiver_pointer = Concat(
                "%pgy.readonly.receiver.", ToString(argument_node));
            receiver_instructions = Concat("  ", receiver_pointer);
            receiver_instructions = Concat(receiver_instructions, Concat(
                " = alloca ", Concat(receiver_type, "\n")));
            receiver_instructions = Concat(receiver_instructions,
                Concat("  store ", receiver_type));
            receiver_instructions = Concat(receiver_instructions,
                Concat(" %pgy.param.", ToString(source)));
            receiver_instructions = Concat(receiver_instructions,
                Concat(", ptr ", Concat(receiver_pointer, "\n")));
        } else {
            return DirectMirScalarProgramLlvmStringExpression(
                true, false, "", "");
        }
    } else {
        return DirectMirScalarProgramLlvmStringExpression(
            true, false, "", "");
    }
    let pointer: String = Concat(value, ".address");
    let instructions: String = Concat(receiver_instructions, Concat("  ",
        Concat(pointer, " = getelementptr inbounds ")));
    instructions = Concat(instructions, receiver_type);
    instructions = Concat(instructions, ", ptr ");
    instructions = Concat(instructions, receiver_pointer);
    instructions = Concat(instructions, ", i32 0");
    let index: Int = ArrayLength(members);
    while index > 0 {
        index = index - 1;
        instructions = Concat(instructions, Concat(", i32 ", ToString(members[index])));
    }
    instructions = Concat(instructions, "\n");
    return DirectMirScalarProgramLlvmStringExpression(
        true, true, instructions, pointer);
}
