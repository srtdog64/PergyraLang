// Ordered LLVM projection for scalar Option and Result expression families.
import "direct_mir_scalar_program_llvm_option_int_owner.pgy";
import "direct_mir_scalar_program_llvm_option_string_owner.pgy";
import "direct_mir_scalar_program_llvm_option_bool_owner.pgy";
import "direct_mir_scalar_program_llvm_result_owner.pgy";
import "direct_mir_scalar_program_payload_free_enum_result_builtin_target_owner.pgy";

func DirectMirScalarProgramLlvmOptionResultExpressionAt(
    kind: Int, result: String, result_type: String,
    left: String, left_type: String, right: String,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    ref payload_free_enum: DirectMirScalarProgramPayloadFreeEnumFact,
    ref referenced_enum: DirectMirScalarProgramReferencedEnumFact
) -> DirectMirScalarProgramLlvmStringExpression {
    let explicit_result: DirectMirScalarProgramLlvmStringExpression =
        DirectMirScalarProgramLlvmPayloadFreeEnumResultExpressionAt(
            kind, result, result_type, left, left_type, right,
            logical_record, payload_free_enum, referenced_enum);
    if explicit_result.matched { return explicit_result; }
    var selected: DirectMirScalarProgramLlvmStringExpression =
        DirectMirScalarProgramLlvmOptionIntExpressionAt(kind, result, left);
    if selected.matched { return selected; }
    selected = DirectMirScalarProgramLlvmOptionStringExpressionAt(
        kind, result, left);
    if selected.matched { return selected; }
    selected = DirectMirScalarProgramLlvmOptionBoolExpressionAt(
        kind, result, left);
    if selected.matched { return selected; }
    return DirectMirScalarProgramLlvmScalarResultExpressionAt(
        kind, result, result_type, left, left_type, right);
}
