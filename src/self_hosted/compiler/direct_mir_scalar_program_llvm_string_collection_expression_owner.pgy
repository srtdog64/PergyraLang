// LLVM expression projection for String/Array<String> runtime receipts.
import "direct_mir_scalar_program_llvm_string_expression_fact_owner.pgy";
import "direct_mir_scalar_program_runtime_abi_projection_owner.pgy";
import "direct_mir_scalar_program_logical_record_array_target_owner.pgy";
import "../codegen/runtime_abi/collection_runtime_owner.pgy";
func DirectMirScalarProgramLlvmStringCollectionExpressionAt(
    kind: Int, result: String, left_type: String, left: String,
    left_address: String, right: String,
    ref runtime: DirectMirScalarProgramRuntimeAbiProjection, ref logical_record: DirectMirScalarProgramLogicalRecordFact
) -> DirectMirScalarProgramLlvmStringExpression {
    let call: String = "";
    if kind == DirectMirScalarProgramExprProcessArgs() {
        call = Concat("call %pgy.array.string @",
            Concat(runtime.process_args.symbol, "()"));
    } else if kind == DirectMirScalarProgramExprDirWalk() {
        call = Concat("call %pgy.array.string @",
            Concat(runtime.dir_walk.symbol,
            Concat("(ptr ", Concat(left, ")"))));
    } else if kind == DirectMirScalarProgramExprFileExists() {
        call = Concat("call i1 @", Concat(runtime.file_exists.symbol,
            Concat("(ptr ", Concat(left, ")"))));
    } else if kind == DirectMirScalarProgramExprReadFile() {
        call = Concat("call ptr @", Concat(runtime.read_file.symbol,
            Concat("(ptr ", Concat(left, ")"))));
    } else if kind == DirectMirScalarProgramExprArrayStringDropOwned() {
        if left_address == "" || left_type !=
                CompilerAbiLayoutArrayStringTypeName() {
            return DirectMirScalarProgramLlvmStringExpression(
                true, false, "", "");
        }
        let output: String = Concat("  call void @",
            Concat(CollectionRuntimeCOwnedStringDropFn(),
            Concat("(ptr ", Concat(left_address, ")\n"))));
        return DirectMirScalarProgramLlvmStringExpression(
            true, true, output, "");
    } else if kind == DirectMirScalarProgramExprArrayStringPushOwned() {
        if left_address == "" || left_type != CompilerAbiLayoutArrayStringTypeName() {
            return DirectMirScalarProgramLlvmStringExpression(true, false, "", ""); }
        let output: String = Concat("  call void @", Concat(CollectionRuntimeCOwnedStringPushFn(), Concat("(ptr ", Concat(left_address, Concat(", ptr ", Concat(right, ")\n")))))); return DirectMirScalarProgramLlvmStringExpression(true, true, output, "");
    } else if kind == DirectMirScalarProgramExprStringContains() {
        call = Concat("call i1 @", Concat(runtime.string_contains.symbol,
            Concat("(ptr ", Concat(left, Concat(", ptr ",
            Concat(right, ")"))))));
    } else if kind == DirectMirScalarProgramExprStringSplit() {
        call = Concat("call %pgy.array.string @",
            Concat(runtime.string_split.symbol, Concat("(ptr ",
            Concat(left, Concat(", ptr ", Concat(right, ")"))))));
    } else if kind == DirectMirScalarProgramExprStringJoin() { call = Concat(
        "call ptr @", Concat(runtime.string_join.symbol, Concat(
        "(%pgy.array.string ", Concat(left, Concat(", ptr ", Concat(right, ")"))))));
    } else if kind == DirectMirScalarProgramExprArrayStringLength() {
        let llvm_type: String = "%pgy.array.string";
        if left_type == CompilerAbiLayoutArrayIntTypeName() {
            llvm_type = "%pgy.array.int";
        } else if left_type == CompilerAbiLayoutArrayBoolTypeName() {
            llvm_type = "%pgy.array.bool";
        }
        if left_type == CompilerAbiLayoutArrayStringTypeName() {
            call = Concat("call i64 @", Concat(
                runtime.array_string_length.symbol,
                Concat("(%pgy.array.string ", Concat(left, ")"))));
        } else if left_type == CompilerAbiLayoutArrayIntTypeName() ||
                left_type == CompilerAbiLayoutArrayBoolTypeName() {
            call = Concat("extractvalue ", Concat(llvm_type, Concat(" ",
                Concat(left, ", 1"))));
        } else {
            let nominal_type: String = DirectMirScalarProgramLlvmLogicalRecordArrayTypeName(
                logical_record, left_type);
            if nominal_type == "" { return DirectMirScalarProgramLlvmStringExpressionMissing(); }
            call = Concat("extractvalue ", Concat(nominal_type,
                Concat(" ", Concat(left, ", 1"))));
        }
    } else if kind == DirectMirScalarProgramExprToIntString() {
        call = Concat("call i64 @", Concat(runtime.string_to_int.symbol,
            Concat("(ptr ", Concat(left, ")"))));
    } else if kind == DirectMirScalarProgramExprArrayStringIndex() {
        call = Concat("call ptr @", Concat(runtime.array_string_get.symbol,
            Concat("(%pgy.array.string ", Concat(left,
            Concat(", i64 ", Concat(right, ")"))))));
    } else { return DirectMirScalarProgramLlvmStringExpressionMissing(); }
    let output: String = Concat("  ", Concat(
        result, Concat(" = ", Concat(call, "\n"))));
    return DirectMirScalarProgramLlvmStringExpression(
        true, true, output, result);
}
