// LLVM runtime definitions for the sealed String/Array<String> receipts.
import "direct_mir_scalar_cfg_graph_fact_owner.pgy";
import "direct_mir_scalar_program_llvm_process_args_materialization_owner.pgy";
import "direct_mir_scalar_program_llvm_dir_walk_materialization_owner.pgy";
import "direct_mir_scalar_program_llvm_file_exists_materialization_owner.pgy";
import "direct_mir_scalar_program_llvm_read_file_materialization_owner.pgy";
import "direct_mir_scalar_program_runtime_abi_projection_readiness_owner.pgy";
import "direct_mir_scalar_program_llvm_string_join_materialization_owner.pgy";
import "direct_mir_scalar_program_expression_kind_query_owner.pgy";
import "../codegen/runtime_abi/collection_runtime_owner.pgy";
func DirectMirScalarProgramLlvmOwnedStringArrayPushBlock() -> String { return Concat("define internal void @", Concat(CollectionRuntimeCOwnedStringPushFn(), "(ptr %array, ptr %value) {\nentry:\n  %source.length = call i64 @strlen(ptr %value)\n  %owned.size = add i64 %source.length, 1\n  %owned = call ptr @malloc(i64 %owned.size)\n  %copied = call ptr @memcpy(ptr %owned, ptr %value, i64 %owned.size)\n  call void @pgy_as_push(ptr %array, ptr %owned)\n  ret void\n}\n\n")); }
func DirectMirScalarProgramLlvmStringArrayPushBlock(
    symbol: String
) -> String {
    let output: String = Concat("define internal void @", Concat(symbol,
        "(ptr %array, ptr %value) {\nentry:\n"));
    output = Concat(output,
        "  %data.ptr = getelementptr inbounds %pgy.array.string, ptr %array, i32 0, i32 0\n  %length.ptr = getelementptr inbounds %pgy.array.string, ptr %array, i32 0, i32 1\n  %capacity.ptr = getelementptr inbounds %pgy.array.string, ptr %array, i32 0, i32 2\n  %length = load i64, ptr %length.ptr, align 8\n  %capacity = load i64, ptr %capacity.ptr, align 8\n  %full = icmp eq i64 %length, %capacity\n  br i1 %full, label %grow, label %append\n\ngrow:\n  %empty = icmp eq i64 %capacity, 0\n  %doubled = mul i64 %capacity, 2\n  %next.capacity = select i1 %empty, i64 4, i64 %doubled\n  %bytes = mul i64 %next.capacity, 8\n  %old.data = load ptr, ptr %data.ptr, align 8\n  %next.data = call ptr @realloc(ptr %old.data, i64 %bytes)\n  %failed = icmp eq ptr %next.data, null\n  br i1 %failed, label %abort, label %grown\n\nabort:\n  call void @abort()\n  unreachable\n\ngrown:\n  store ptr %next.data, ptr %data.ptr, align 8\n  store i64 %next.capacity, ptr %capacity.ptr, align 8\n  br label %append\n\nappend:\n  %data = load ptr, ptr %data.ptr, align 8\n  %slot = getelementptr inbounds ptr, ptr %data, i64 %length\n  store ptr %value, ptr %slot, align 8\n  %next.length = add i64 %length, 1\n  store i64 %next.length, ptr %length.ptr, align 8\n  ret void\n}\n\n");
    return output;
}
func DirectMirScalarProgramLlvmStringArrayAccessBlocks(
    ref runtime: DirectMirScalarProgramRuntimeAbiProjection
) -> String {
    let output: String = "";
    if runtime.array_string_length.ok {
        output = Concat(output, Concat("define internal i64 @",
            Concat(runtime.array_string_length.symbol,
            "(%pgy.array.string %array) {\nentry:\n  %length = extractvalue %pgy.array.string %array, 1\n  ret i64 %length\n}\n\n")));
    }
    if runtime.array_string_get.ok {
        output = Concat(output, Concat("define internal ptr @",
            Concat(runtime.array_string_get.symbol,
            "(%pgy.array.string %array, i64 %index) {\nentry:\n  %data = extractvalue %pgy.array.string %array, 0\n  %slot = getelementptr inbounds ptr, ptr %data, i64 %index\n  %value = load ptr, ptr %slot, align 8\n  ret ptr %value\n}\n\n")));
    }
    return output;
}
func DirectMirScalarProgramLlvmStringArrayDropBlock() -> String {
    return Concat("define internal void @", Concat(
        CollectionRuntimeCOwnedStringDropFn(),
        "(ptr %array) {\nentry:\n  %data.ptr = getelementptr inbounds %pgy.array.string, ptr %array, i32 0, i32 0\n  %length.ptr = getelementptr inbounds %pgy.array.string, ptr %array, i32 0, i32 1\n  %capacity.ptr = getelementptr inbounds %pgy.array.string, ptr %array, i32 0, i32 2\n  %data = load ptr, ptr %data.ptr, align 8\n  %length = load i64, ptr %length.ptr, align 8\n  br label %loop\n\nloop:\n  %index = phi i64 [ 0, %entry ], [ %next, %body ]\n  %more = icmp ult i64 %index, %length\n  br i1 %more, label %body, label %done\n\nbody:\n  %slot = getelementptr inbounds ptr, ptr %data, i64 %index\n  %value = load ptr, ptr %slot, align 8\n  call void @free(ptr %value)\n  %next = add i64 %index, 1\n  br label %loop\n\ndone:\n  call void @free(ptr %data)\n  store ptr null, ptr %data.ptr, align 8\n  store i64 0, ptr %length.ptr, align 8\n  store i64 0, ptr %capacity.ptr, align 8\n  ret void\n}\n\n"));
}

func DirectMirScalarProgramLlvmStringSplitBlock(
    ref runtime: DirectMirScalarProgramRuntimeAbiProjection
) -> String {
    let output: String = Concat("define internal %pgy.array.string @",
        Concat(runtime.string_split.symbol,
        "(ptr %source, ptr %separator) {\nentry:\n  %array = alloca %pgy.array.string, align 8\n  store %pgy.array.string zeroinitializer, ptr %array, align 8\n  %separator.length = call i64 @strlen(ptr %separator)\n  %separator.empty = icmp eq i64 %separator.length, 0\n  br i1 %separator.empty, label %single, label %loop.entry\n\nsingle:\n  %single.length = call i64 @strlen(ptr %source)\n  %single.size = add i64 %single.length, 1\n  %single.part = call ptr @malloc(i64 %single.size)\n  %single.copied = call ptr @memcpy(ptr %single.part, ptr %source, i64 %single.size)\n  call void @pgy_as_push(ptr %array, ptr %single.part)\n  br label %done\n\nloop.entry:\n  br label %loop\n\nloop:\n  %start = phi ptr [ %source, %loop.entry ], [ %next.start, %found ]\n  %match = call ptr @strstr(ptr %start, ptr %separator)\n  %missing = icmp eq ptr %match, null\n  br i1 %missing, label %last, label %found\n\nfound:\n  %match.int = ptrtoint ptr %match to i64\n  %start.int = ptrtoint ptr %start to i64\n  %part.length = sub i64 %match.int, %start.int\n  %part.size = add i64 %part.length, 1\n  %part = call ptr @malloc(i64 %part.size)\n  %copied = call ptr @memcpy(ptr %part, ptr %start, i64 %part.length)\n  %part.nul = getelementptr inbounds i8, ptr %part, i64 %part.length\n  store i8 0, ptr %part.nul, align 1\n  call void @pgy_as_push(ptr %array, ptr %part)\n  %next.start = getelementptr inbounds i8, ptr %match, i64 %separator.length\n  br label %loop\n\nlast:\n  %last.length = call i64 @strlen(ptr %start)\n  %last.size = add i64 %last.length, 1\n  %last.part = call ptr @malloc(i64 %last.size)\n  %last.copied = call ptr @memcpy(ptr %last.part, ptr %start, i64 %last.size)\n  call void @pgy_as_push(ptr %array, ptr %last.part)\n  br label %done\n\ndone:\n  %result = load %pgy.array.string, ptr %array, align 8\n  ret %pgy.array.string %result\n}\n\n"));
    return output;
}

func DirectMirScalarProgramLlvmStringCollectionMaterialization(
    ref plan: DirectMirScalarCfgGraphPlan,
    ref runtime: DirectMirScalarProgramRuntimeAbiProjection
) -> String {
    let array_required: Bool =
        plan.program.runtime_abi.string_split_id != 0 ||
        plan.program.runtime_abi.string_join_id != 0 ||
        plan.program.runtime_abi.array_string_length_id != 0 ||
        plan.program.runtime_abi.array_string_get_id != 0 ||
        plan.program.runtime_abi.process_args_id != 0 ||
        plan.program.runtime_abi.dir_walk_id != 0 ||
        DirectMirScalarProgramArrayStringAbiFactReady(
            plan.program.array_string_abi);
    let any: Bool = plan.program.runtime_abi.string_contains_id != 0 ||
        plan.program.runtime_abi.string_to_int_id != 0 ||
        plan.program.runtime_abi.file_exists_id != 0 || array_required;
    if plan.program.runtime_abi.read_file_id != 0 { any = true; }
    if !any { return ""; }
    if !DirectMirScalarProgramRuntimeAbiProjectionReady(
            runtime, plan.program.runtime_abi) ||
        !DirectMirScalarProgramArrayStringAbiReadyForExpressions(
            plan.program.array_string_abi, plan.program.expressions) {
        Die("direct MIR scalar program LLVM String collection ABI is invalid");
    }
    let output: String = "";
    if array_required {
        output = "%pgy.array.string = type { ptr, i64, i64, ptr }\n";
    }
    if plan.program.runtime_abi.string_contains_id != 0 {
        output = Concat(output, Concat("define internal i1 @",
            Concat(runtime.string_contains.symbol,
            "(ptr %haystack, ptr %needle) {\nentry:\n  %match = call ptr @strstr(ptr %haystack, ptr %needle)\n  %found = icmp ne ptr %match, null\n  ret i1 %found\n}\n\n")));
    }
    if plan.program.runtime_abi.string_to_int_id != 0 {
        output = Concat(output, Concat("define internal i64 @",
            Concat(runtime.string_to_int.symbol,
            "(ptr %source) {\nentry:\n  %value = call i64 @atoll(ptr %source)\n  ret i64 %value\n}\n\n")));
    }
    if array_required {
        output = Concat(output,
            DirectMirScalarProgramLlvmStringArrayPushBlock("pgy_as_push"));
        if DirectMirScalarProgramExpressionContainsKind(plan.program.expressions,
                DirectMirScalarProgramExprArrayStringPushOwned()) { output = Concat(output, DirectMirScalarProgramLlvmOwnedStringArrayPushBlock()); }
        output = Concat(output,
            DirectMirScalarProgramLlvmStringArrayAccessBlocks(runtime));
        output = Concat(output,
            DirectMirScalarProgramLlvmStringArrayDropBlock());
    }
    output = Concat(output,
        DirectMirScalarProgramLlvmProcessArgsBlock(plan, runtime));
    output = Concat(output,
        DirectMirScalarProgramLlvmDirWalkBlock(plan, runtime));
    output = Concat(output,
        DirectMirScalarProgramLlvmFileExistsBlock(plan, runtime));
    output = Concat(output,
        DirectMirScalarProgramLlvmReadFileBlock(plan, runtime));
    if plan.program.runtime_abi.string_split_id != 0 {
        output = Concat(output,
            DirectMirScalarProgramLlvmStringSplitBlock(runtime));
    }
    if plan.program.runtime_abi.string_join_id != 0 { output = Concat(
        output, DirectMirScalarProgramLlvmStringJoinBlock(runtime)); }
    return output;
}
