// LLVM projection of String runtime expressions from one ABI projection.

import "direct_mir_scalar_program_expression_fact_owner.pgy";
import "direct_mir_scalar_program_runtime_abi_projection_owner.pgy";
import "direct_mir_scalar_program_llvm_string_expression_fact_owner.pgy";
import "direct_mir_scalar_program_llvm_string_window_expression_owner.pgy";
import "direct_mir_scalar_program_llvm_string_collection_expression_owner.pgy";
import "direct_mir_scalar_program_llvm_string_special_expression_owner.pgy";

func DirectMirScalarProgramLlvmStringExpressionAt(
    kind: Int, result: String, left: String, right: String,
    arguments: Array<String>,
    ref runtime: DirectMirScalarProgramRuntimeAbiProjection
) -> DirectMirScalarProgramLlvmStringExpression {
    let special: DirectMirScalarProgramLlvmStringExpression =
        DirectMirScalarProgramLlvmStringSpecialExpressionAt(
            kind, result, left, right, runtime);
    if special.matched { return special; }
    let collection: DirectMirScalarProgramLlvmStringExpression =
        DirectMirScalarProgramLlvmStringCollectionExpressionAt(
            kind, result, left, right, runtime);
    if collection.matched { return collection; }
    let window: DirectMirScalarProgramLlvmStringExpression =
        DirectMirScalarProgramLlvmStringWindowExpressionAt(
            kind, result, left, arguments, runtime);
    if window.matched { return window; }
    if kind == DirectMirScalarProgramExprEqualString() ||
            kind == DirectMirScalarProgramExprNotEqualString() {
        if !CompilerRuntimeCallAbiStringCompareFactReady(
                runtime.string_compare) {
            return DirectMirScalarProgramLlvmStringExpression(
                true, false, "", "");
        }
        let output: String = Concat("  ", Concat(result,
            Concat(" = call i32 @", Concat(
                runtime.string_compare.symbol, Concat("(ptr ", Concat(
                    left, Concat(", ptr ", Concat(right, ")\n"))))))));
        let compared: String = Concat(result, ".bool");
        let predicate: String = "ne";
        if kind == DirectMirScalarProgramExprEqualString() {
            predicate = "eq";
        }
        output = Concat(output, Concat("  ", Concat(compared,
            Concat(" = icmp ", Concat(
                predicate,
                Concat(" i32 ", Concat(result, ", 0\n")))))));
        return DirectMirScalarProgramLlvmStringExpression(
            true, true, output, compared);
    }
    if kind == DirectMirScalarProgramExprConcatString() {
        if !CompilerRuntimeCallAbiStringConcatFactReady(
                runtime.string_concat) {
            return DirectMirScalarProgramLlvmStringExpression(
                true, false, "", "");
        }
        let output: String = Concat("  ", Concat(result,
            Concat(" = call ptr @", Concat(
                runtime.string_concat.symbol, Concat("(ptr ", Concat(
                    left, Concat(", ptr ", Concat(right, ")\n"))))))));
        return DirectMirScalarProgramLlvmStringExpression(
            true, true, output, result);
    }
    let builtin_symbol: String = runtime.string_to_string.symbol;
    let argument_type: String = "i64";
    let ready: Bool = false;
    if kind == DirectMirScalarProgramExprToStringInt() {
        ready = CompilerRuntimeCallAbiStringToStringFactReady(
            runtime.string_to_string);
    } else if kind == DirectMirScalarProgramExprToUpperString() {
        builtin_symbol = runtime.string_to_upper.symbol; argument_type = "ptr";
        ready = CompilerRuntimeCallAbiStringToUpperFactReady(
            runtime.string_to_upper);
    } else if kind == DirectMirScalarProgramExprToLowerString() {
        builtin_symbol = runtime.string_to_lower.symbol; argument_type = "ptr";
        ready = CompilerRuntimeCallAbiStringToLowerFactReady(
            runtime.string_to_lower);
    } else { return DirectMirScalarProgramLlvmStringExpressionMissing(); }
    if !ready {
        return DirectMirScalarProgramLlvmStringExpression(
            true, false, "", "");
    }
    let output: String = Concat("  ", Concat(result,
        Concat(" = call ptr @", Concat(builtin_symbol, Concat("(", Concat(
            argument_type, Concat(" ", Concat(left, ")\n"))))))));
    return DirectMirScalarProgramLlvmStringExpression(
        true, true, output, result);
}
