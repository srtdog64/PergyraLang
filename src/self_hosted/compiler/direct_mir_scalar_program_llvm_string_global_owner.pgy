// LLVM string globals derived solely from sealed expression literal nodes.

import "direct_mir_scalar_program_expression_fact_owner.pgy";
import "direct_mir_scalar_program_llvm_string_literal_owner.pgy";

func DirectMirScalarProgramLlvmStringGlobals(
    ref expressions: DirectMirScalarProgramExpressionSet
) -> String {
    let output_allocator: Allocator = AllocatorResult();
    let output: TextBuilder = TextBuilderNew(4096);
    var node: Int = 0;
    var clone_empty_emitted: Bool = false;
    while node < ArrayLength(expressions.node_kinds) {
        if expressions.node_kinds[node] ==
                DirectMirScalarProgramExprStringClone() &&
            !clone_empty_emitted {
            TextBuilderAppend(output,
                "@pgy.scalar.clone.empty = private unnamed_addr constant [1 x i8] c\"\\00\"\n");
            clone_empty_emitted = true;
        }
        if expressions.node_kinds[node] ==
                DirectMirScalarProgramExprStringLiteral() {
            let literal: String = expressions.node_literals[node];
            TextBuilderAppend(output, "@pgy.scalar.string.");
            TextBuilderAppend(output, ToString(node));
            TextBuilderAppend(output, " = private unnamed_addr constant [");
            TextBuilderAppend(output, ToString(StringLength(literal) + 1));
            TextBuilderAppend(output, " x i8] c\"");
            TextBuilderAppend(output, DirectMirScalarProgramLlvmStringLiteralPayload(literal));
            TextBuilderAppend(output, "\\00\"\n");
        }
        node = node + 1;
    }
    let globals: String = TextBuilderFinish(output, output_allocator);
    AllocatorDestroy(output_allocator);
    return globals;
}
