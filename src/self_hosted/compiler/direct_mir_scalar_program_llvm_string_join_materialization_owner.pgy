// LLVM body for the registry-owned Array<String> + separator join ABI.

import "direct_mir_scalar_program_runtime_abi_projection_owner.pgy";

func DirectMirScalarProgramLlvmStringJoinBlock(
    ref runtime: DirectMirScalarProgramRuntimeAbiProjection
) -> String {
    return Concat("define internal ptr @", Concat(runtime.string_join.symbol,
        "(%pgy.array.string %array, ptr %separator) {\nentry:\n  %data = extractvalue %pgy.array.string %array, 0\n  %length = extractvalue %pgy.array.string %array, 1\n  %separator.length = call i64 @strlen(ptr %separator)\n  br label %size.loop\n\nsize.loop:\n  %size.index = phi i64 [ 0, %entry ], [ %size.next, %size.body ]\n  %payload.bytes = phi i64 [ 0, %entry ], [ %payload.next, %size.body ]\n  %size.more = icmp ult i64 %size.index, %length\n  br i1 %size.more, label %size.body, label %size.done\n\nsize.body:\n  %size.slot = getelementptr inbounds ptr, ptr %data, i64 %size.index\n  %size.item = load ptr, ptr %size.slot, align 8\n  %item.length = call i64 @strlen(ptr %size.item)\n  %payload.next = add i64 %payload.bytes, %item.length\n  %size.next = add i64 %size.index, 1\n  br label %size.loop\n\nsize.done:\n  %has.separators = icmp ugt i64 %length, 1\n  %length.minus.one = sub i64 %length, 1\n  %separator.count = select i1 %has.separators, i64 %length.minus.one, i64 0\n  %separator.bytes = mul i64 %separator.count, %separator.length\n  %total.bytes = add i64 %payload.bytes, %separator.bytes\n  %allocation.bytes = add i64 %total.bytes, 1\n  %result = call ptr @malloc(i64 %allocation.bytes)\n  br label %copy.loop\n\ncopy.loop:\n  %copy.index = phi i64 [ 0, %size.done ], [ %copy.next, %copy.item ]\n  %cursor = phi ptr [ %result, %size.done ], [ %after.item, %copy.item ]\n  %copy.more = icmp ult i64 %copy.index, %length\n  br i1 %copy.more, label %copy.separator.check, label %copy.done\n\ncopy.separator.check:\n  %first = icmp eq i64 %copy.index, 0\n  br i1 %first, label %copy.item, label %copy.separator\n\ncopy.separator:\n  %separator.copied = call ptr @memcpy(ptr %cursor, ptr %separator, i64 %separator.length)\n  %after.separator = getelementptr inbounds i8, ptr %cursor, i64 %separator.length\n  br label %copy.item\n\ncopy.item:\n  %item.cursor = phi ptr [ %cursor, %copy.separator.check ], [ %after.separator, %copy.separator ]\n  %copy.slot = getelementptr inbounds ptr, ptr %data, i64 %copy.index\n  %copy.value = load ptr, ptr %copy.slot, align 8\n  %copy.length = call i64 @strlen(ptr %copy.value)\n  %item.copied = call ptr @memcpy(ptr %item.cursor, ptr %copy.value, i64 %copy.length)\n  %after.item = getelementptr inbounds i8, ptr %item.cursor, i64 %copy.length\n  %copy.next = add i64 %copy.index, 1\n  br label %copy.loop\n\ncopy.done:\n  store i8 0, ptr %cursor, align 1\n  ret ptr %result\n}\n\n"));
}
