// LLVM byte spelling for one decoded scalar-program string literal.

import "../codegen/text/text_owner.pgy";
import "../lib/string_window_within.pgy";

func DirectMirScalarProgramLlvmStringLiteralPayload(
    value: String
) -> String {
    let allocator: Allocator = AllocatorResult();
    let payload: TextBuilder = TextBuilderNew(256);
    let digits: String = "0123456789ABCDEF";
    let digits_extent: Int = StringLength(digits);
    let length: Int = StringLength(value);
    let index: Int = 0;
    while index < length {
        let code: Int = CharCode(value, length, index);
        if code >= 32 && code <= 126 && code != 34 && code != 92 {
            TextBuilderAppend(payload, CharAtN(value, length, index));
        } else if code == 9 || code == 10 || code == 13 ||
                code == 34 || code == 92 || (code >= 128 && code <= 255) {
            TextBuilderAppend(payload, "\\");
            TextBuilderAppend(payload, StringWindowCharAt(digits, digits_extent, 16, code / 16));
            TextBuilderAppend(payload, StringWindowCharAt(digits, digits_extent, 16, code % 16));
        } else {
            Die("direct MIR scalar LLVM string literal byte is invalid");
        }
        index = index + 1;
    }
    let result: String = TextBuilderFinish(payload, allocator);
    AllocatorDestroy(allocator);
    return result;
}
