// LLVM projection of length and bounded String-window expressions.

import "direct_mir_scalar_program_runtime_abi_projection_owner.pgy";
import "direct_mir_scalar_program_expression_kind_id_owner.pgy";
import "direct_mir_scalar_program_llvm_string_expression_fact_owner.pgy";

func DirectMirScalarProgramLlvmStringWindowExpressionAt(
    kind: Int, result: String, left: String, arguments: Array<String>,
    ref runtime: DirectMirScalarProgramRuntimeAbiProjection
) -> DirectMirScalarProgramLlvmStringExpression {
    if kind == DirectMirScalarProgramExprStringLength() {
        if !CompilerRuntimeCallAbiStringGeneratedBuiltinFactReady(
                runtime.string_length, "length", StringRuntimeCStringLengthFn(),
                "string_to_int") {
            return DirectMirScalarProgramLlvmStringExpression(
                true, false, "", "");
        }
        let length_output: String = Concat("  ", Concat(result,
            Concat(" = call i64 @", Concat(runtime.string_length.symbol,
            Concat("(ptr ", Concat(left, ")\n"))))));
        return DirectMirScalarProgramLlvmStringExpression(
            true, true, length_output, result);
    }
    if kind == DirectMirScalarProgramExprCharAtN() {
        if ArrayLength(arguments) != 3 ||
            !CompilerRuntimeCallAbiStringGeneratedBuiltinFactReady(
                runtime.string_char_at_n, "char-at-n",
                StringRuntimeCCharAtNFn(), "string_int_to_string") {
            return DirectMirScalarProgramLlvmStringExpression(
                true, false, "", "");
        }
        let char_output: String = Concat("  ", Concat(result,
            Concat(" = call ptr @", Concat(runtime.string_char_at_n.symbol,
            Concat("(ptr ", Concat(arguments[0], Concat(", i64 ",
            Concat(arguments[1], Concat(", i64 ",
            Concat(arguments[2], ")\n"))))))))));
        return DirectMirScalarProgramLlvmStringExpression(
            true, true, char_output, result);
    }
    if kind == DirectMirScalarProgramExprCharCode() {
        if ArrayLength(arguments) != 3 ||
            !CompilerRuntimeCallAbiStringGeneratedBuiltinFactReady(
                runtime.string_char_code, "char-code",
                StringRuntimeCCharCodeFn(), "string_to_int") {
            return DirectMirScalarProgramLlvmStringExpression(
                true, false, "", "");
        }
        let code_output: String = Concat("  ", Concat(result,
            Concat(" = call i64 @", Concat(runtime.string_char_code.symbol,
            Concat("(ptr ", Concat(arguments[0], Concat(", i64 ",
            Concat(arguments[1], Concat(", i64 ",
            Concat(arguments[2], ")\n"))))))))));
        return DirectMirScalarProgramLlvmStringExpression(
            true, true, code_output, result);
    }
    if kind == DirectMirScalarProgramExprSubIndexOfWithLen() {
        if ArrayLength(arguments) != 5 ||
            !CompilerRuntimeCallAbiStringGeneratedBuiltinFactReady(
                runtime.string_sub_index_with_len, "sub-index-of-with-len",
                StringRuntimeCSubIndexOfWithLenFn(),
                "string_int_string_int_to_int") {
            return DirectMirScalarProgramLlvmStringExpression(
                true, false, "", "");
        }
        let sub_index_output: String = Concat("  ", Concat(result,
            Concat(" = call i64 @",
            Concat(runtime.string_sub_index_with_len.symbol,
            Concat("(ptr ", Concat(arguments[0], Concat(", i64 ",
            Concat(arguments[1], Concat(", i64 ",
            Concat(arguments[2], Concat(", i64 ",
            Concat(arguments[3], Concat(", ptr ",
            Concat(arguments[4], ")\n"))))))))))))));
        return DirectMirScalarProgramLlvmStringExpression(
            true, true, sub_index_output, result);
    }
    if kind == DirectMirScalarProgramExprSubEqualsWithLen() {
        if ArrayLength(arguments) != 5 ||
            !CompilerRuntimeCallAbiStringGeneratedBuiltinFactReady(
                runtime.string_sub_equals_with_len, "sub-equals-with-len",
                StringRuntimeCSubEqualsWithLenFn(),
                "string_int_string_int_to_bool") {
            return DirectMirScalarProgramLlvmStringExpression(
                true, false, "", "");
        }
        let sub_equals_output: String = Concat("  ", Concat(result,
            Concat(" = call i1 @",
            Concat(runtime.string_sub_equals_with_len.symbol,
            Concat("(ptr ", Concat(arguments[0], Concat(", i64 ",
            Concat(arguments[1], Concat(", i64 ",
            Concat(arguments[2], Concat(", i64 ",
            Concat(arguments[3], Concat(", ptr ",
            Concat(arguments[4], ")\n"))))))))))))));
        return DirectMirScalarProgramLlvmStringExpression(
            true, true, sub_equals_output, result);
    }
    let fact_symbol: String = runtime.string_substring.symbol;
    let operation: String = "substring";
    let symbol: String = StringRuntimeCSubstringFn();
    let shape: String = "string_int_int_to_string";
    let expected: Int = 3;
    if kind == DirectMirScalarProgramExprSubstringWithLen() {
        fact_symbol = runtime.string_substring_with_len.symbol;
        operation = "substring-with-len";
        symbol = StringRuntimeCSubstringWithLenFn();
        shape = "string_int_int_int_to_string"; expected = 4;
    } else if kind != DirectMirScalarProgramExprSubstring() {
        return DirectMirScalarProgramLlvmStringExpressionMissing();
    }
    if ArrayLength(arguments) != expected ||
        (kind == DirectMirScalarProgramExprSubstring() &&
            !CompilerRuntimeCallAbiStringGeneratedBuiltinFactReady(
                runtime.string_substring, operation, symbol, shape)) ||
        (kind == DirectMirScalarProgramExprSubstringWithLen() &&
            !CompilerRuntimeCallAbiStringGeneratedBuiltinFactReady(
                runtime.string_substring_with_len,
                operation, symbol, shape)) {
        return DirectMirScalarProgramLlvmStringExpression(
            true, false, "", "");
    }
    let output: String = Concat("  ", Concat(result,
        Concat(" = call ptr @", Concat(fact_symbol, "("))));
    let i: Int = 0;
    while i < expected {
        if i > 0 { output = Concat(output, ", "); }
        let llvm_type: String = "i64"; if i == 0 { llvm_type = "ptr"; }
        output = Concat(output, Concat(llvm_type,
            Concat(" ", arguments[i]))); i = i + 1;
    }
    output = Concat(output, ")\n");
    return DirectMirScalarProgramLlvmStringExpression(
        true, true, output, result);
}
