// LLVM bodies for checked String substring windows.

import "direct_mir_scalar_program_runtime_abi_projection_owner.pgy";

func DirectMirScalarProgramLlvmSubstringMaterialization(
    fact: CompilerRuntimeCallAbiFact
) -> String {
    let out: String = Concat("define internal ptr @", fact.symbol);
    out = Concat(out, "(ptr %source, i64 %start, i64 %length) {\nentry:\n");
    out = Concat(out, "  %source.null = icmp eq ptr %source, null\n");
    out = Concat(out, "  br i1 %source.null, label %empty, label %bounds\n\nbounds:\n");
    out = Concat(out, "  %source.length = call i64 @strlen(ptr %source)\n");
    out = Concat(out, "  %source.large = icmp uge i64 %source.length, 9223372036854775807\n");
    out = Concat(out, "  %start.negative = icmp slt i64 %start, 0\n");
    out = Concat(out, "  %start.past = icmp uge i64 %start, %source.length\n");
    out = Concat(out, "  %length.empty = icmp sle i64 %length, 0\n");
    out = Concat(out, "  %invalid.0 = or i1 %source.large, %start.negative\n");
    out = Concat(out, "  %invalid.1 = or i1 %start.past, %length.empty\n");
    out = Concat(out, "  %invalid = or i1 %invalid.0, %invalid.1\n");
    out = Concat(out, "  br i1 %invalid, label %empty, label %copy\n\nempty:\n");
    out = Concat(out, "  %empty.result = call ptr @malloc(i64 1)\n");
    out = Concat(out, "  store i8 0, ptr %empty.result, align 1\n  ret ptr %empty.result\n\ncopy:\n");
    out = Concat(out, "  %remaining = sub i64 %source.length, %start\n");
    out = Concat(out, "  %too.long = icmp sgt i64 %length, %remaining\n");
    out = Concat(out, "  %bounded = select i1 %too.long, i64 %remaining, i64 %length\n");
    out = Concat(out, "  %size = add i64 %bounded, 1\n");
    out = Concat(out, "  %result = call ptr @malloc(i64 %size)\n");
    out = Concat(out, "  %source.at = getelementptr inbounds i8, ptr %source, i64 %start\n");
    out = Concat(out, "  %copied = call ptr @memcpy(ptr %result, ptr %source.at, i64 %bounded)\n");
    out = Concat(out, "  %nul = getelementptr inbounds i8, ptr %result, i64 %bounded\n");
    return Concat(out, "  store i8 0, ptr %nul, align 1\n  ret ptr %result\n}\n\n");
}

func DirectMirScalarProgramLlvmBoundedSubstringMaterialization(
    fact: CompilerRuntimeCallAbiFact
) -> String {
    let out: String = Concat("define internal ptr @", fact.symbol);
    out = Concat(out, "(ptr %source, i64 %source.length, i64 %start, i64 %length) {\nentry:\n");
    out = Concat(out, "  %source.null = icmp eq ptr %source, null\n");
    out = Concat(out, "  %source.negative = icmp slt i64 %source.length, 0\n");
    out = Concat(out, "  %start.negative = icmp slt i64 %start, 0\n");
    out = Concat(out, "  %start.past = icmp sge i64 %start, %source.length\n");
    out = Concat(out, "  %length.empty = icmp sle i64 %length, 0\n");
    out = Concat(out, "  %invalid.0 = or i1 %source.null, %source.negative\n");
    out = Concat(out, "  %invalid.1 = or i1 %start.negative, %start.past\n");
    out = Concat(out, "  %invalid.2 = or i1 %invalid.0, %invalid.1\n");
    out = Concat(out, "  %invalid = or i1 %invalid.2, %length.empty\n");
    out = Concat(out, "  br i1 %invalid, label %empty, label %copy\n\nempty:\n");
    out = Concat(out, "  %empty.result = call ptr @malloc(i64 1)\n");
    out = Concat(out, "  store i8 0, ptr %empty.result, align 1\n  ret ptr %empty.result\n\ncopy:\n");
    out = Concat(out, "  %remaining = sub i64 %source.length, %start\n");
    out = Concat(out, "  %too.long = icmp sgt i64 %length, %remaining\n");
    out = Concat(out, "  %bounded = select i1 %too.long, i64 %remaining, i64 %length\n");
    out = Concat(out, "  %size = add i64 %bounded, 1\n");
    out = Concat(out, "  %result = call ptr @malloc(i64 %size)\n");
    out = Concat(out, "  %source.at = getelementptr inbounds i8, ptr %source, i64 %start\n");
    out = Concat(out, "  %copied = call ptr @memcpy(ptr %result, ptr %source.at, i64 %bounded)\n");
    out = Concat(out, "  %nul = getelementptr inbounds i8, ptr %result, i64 %bounded\n");
    return Concat(out, "  store i8 0, ptr %nul, align 1\n  ret ptr %result\n}\n\n");
}
