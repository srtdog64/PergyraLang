// Exact logical-record-returning mixed collection copyout signature policy.

import "direct_mir_routine_signature_fact_owner.pgy";
import "direct_mir_scalar_cfg_type_family_owner.pgy";
import "direct_mir_scalar_program_logical_record_fact_owner.pgy";

func DirectMirScalarProgramLogicalRecordMixedCollectionValueResultSignatureReady(
    ref signature: DirectMirRoutineSignatureFact,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact
) -> Bool {
    let append_node_shape: Bool = signature.param_count == 10;
    let compact_bridge_shape: Bool = signature.param_count == 7;
    if !DirectMirRoutineSignatureFactReady(signature) ||
        !DirectMirScalarProgramLogicalRecordTypeReady(
            logical_record, signature.return_type) ||
        (!append_node_shape && !compact_bridge_shape) {
        return false;
    }
    let ordinal: Int = 0;
    while ordinal < signature.param_count {
        let type_name: String = signature.parameters.type_names[ordinal];
        let array_int: Bool = ordinal == 0 || ordinal == 2 ||
            ordinal == 3 || ordinal == 4;
        let array_string: Bool = ordinal == 1 || ordinal == 5;
        let int_value: Bool = append_node_shape &&
            (ordinal == 6 || ordinal == 8 || ordinal == 9);
        let string_value: Bool = (append_node_shape && ordinal == 7) ||
            (compact_bridge_shape && ordinal == 6);
        if (array_int && type_name != CompilerAbiLayoutArrayIntTypeName()) ||
            (array_string &&
             type_name != CompilerAbiLayoutArrayStringTypeName()) ||
            (int_value && type_name != CompilerAbiLayoutIntTypeName()) ||
            (string_value && type_name != CompilerAbiLayoutStringTypeName()) ||
            (!array_int && !array_string && !int_value && !string_value) ||
            signature.parameters.resources[ordinal] != "none" ||
            signature.parameters.pass_shapes[ordinal] != "direct" {
            return false;
        }
        if array_int || array_string {
            if signature.parameters.carriages[ordinal] != "value-result" ||
                !signature.parameters.abi_required[ordinal] ||
                signature.parameters.abi_layout_ids[ordinal] <= 0 {
                return false;
            }
        } else if signature.parameters.carriages[ordinal] != "value" ||
            signature.parameters.abi_required[ordinal] ||
            signature.parameters.abi_layout_ids[ordinal] != 0 {
            return false;
        }
        ordinal = ordinal + 1;
    }
    return true;
}

func DirectMirScalarProgramLogicalRecordMixedCollectionValueResultParameterReady(
    ref signature: DirectMirRoutineSignatureFact, ordinal: Int,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact
) -> Bool {
    return ordinal >= 0 && ordinal < signature.param_count &&
        DirectMirScalarProgramLogicalRecordMixedCollectionValueResultSignatureReady(
            signature, logical_record);
}
