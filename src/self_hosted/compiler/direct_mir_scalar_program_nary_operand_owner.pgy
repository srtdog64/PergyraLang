// Operand spans for normalized expressions whose semantic arity exceeds two.

struct DirectMirScalarProgramNaryOperands {
    let valid: Bool;
    let node_rows: Array<Int>;
    let starts: Array<Int>;
    let counts: Array<Int>;
    let operand_rows: Array<Int>;
}

func DirectMirScalarProgramNaryOperandsEmpty(
) -> DirectMirScalarProgramNaryOperands {
    let rows: Array<Int> = [];
    return DirectMirScalarProgramNaryOperands(true, rows, rows, rows, rows);
}

func DirectMirScalarProgramNaryOperandsCanonicalEmpty(
    ref fact: DirectMirScalarProgramNaryOperands
) -> Bool {
    return fact.valid && ArrayLength(fact.node_rows) == 0 &&
        ArrayLength(fact.starts) == 0 && ArrayLength(fact.counts) == 0 &&
        ArrayLength(fact.operand_rows) == 0;
}

func DirectMirScalarProgramNaryOperandsAppend(
    fact: DirectMirScalarProgramNaryOperands,
    node_row: Int, operands: Array<Int>
) -> DirectMirScalarProgramNaryOperands {
    let nodes: Array<Int> = fact.node_rows;
    let starts: Array<Int> = fact.starts;
    let counts: Array<Int> = fact.counts;
    let rows: Array<Int> = fact.operand_rows;
    ArrayPush(nodes, node_row); ArrayPush(starts, ArrayLength(rows));
    ArrayPush(counts, ArrayLength(operands));
    let i: Int = 0;
    while i < ArrayLength(operands) {
        ArrayPush(rows, operands[i]); i = i + 1;
    }
    return DirectMirScalarProgramNaryOperands(
        fact.valid, nodes, starts, counts, rows);
}

func DirectMirScalarProgramNaryOperandEntry(
    ref fact: DirectMirScalarProgramNaryOperands, node_row: Int
) -> Int {
    let i: Int = 0;
    while i < ArrayLength(fact.node_rows) {
        if fact.node_rows[i] == node_row { return i; }
        i = i + 1;
    }
    return -1;
}

func DirectMirScalarProgramNaryOperandRows(
    ref fact: DirectMirScalarProgramNaryOperands, node_row: Int
) -> Array<Int> {
    let out: Array<Int> = [];
    let entry: Int = DirectMirScalarProgramNaryOperandEntry(fact, node_row);
    if entry < 0 { return out; }
    let i: Int = 0;
    while i < fact.counts[entry] {
        ArrayPush(out, fact.operand_rows[fact.starts[entry] + i]);
        i = i + 1;
    }
    return out;
}

func DirectMirScalarProgramNaryOperandsShapeReady(
    ref fact: DirectMirScalarProgramNaryOperands, node_count: Int
) -> Bool {
    if !fact.valid || ArrayLength(fact.node_rows) != ArrayLength(fact.starts) ||
        ArrayLength(fact.node_rows) != ArrayLength(fact.counts) { return false; }
    let expected_start: Int = 0; let prior_node: Int = -1; let i: Int = 0;
    while i < ArrayLength(fact.node_rows) {
        let node: Int = fact.node_rows[i];
        if node <= prior_node || node >= node_count ||
            fact.starts[i] != expected_start || fact.counts[i] < 3 ||
            expected_start + fact.counts[i] > ArrayLength(fact.operand_rows) {
            return false;
        }
        let arg: Int = 0;
        while arg < fact.counts[i] {
            let operand: Int = fact.operand_rows[expected_start + arg];
            if operand < 0 || operand >= node { return false; }
            arg = arg + 1;
        }
        prior_node = node; expected_start = expected_start + fact.counts[i];
        i = i + 1;
    }
    return expected_start == ArrayLength(fact.operand_rows);
}
