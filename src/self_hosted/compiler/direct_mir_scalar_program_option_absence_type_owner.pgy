// Normalized zero-argument None identity from the expected Option type.

import "direct_mir_scalar_program_expression_kind_fact_owner.pgy";
import "direct_mir_scalar_program_option_int_expression_kind_owner.pgy";
import "direct_mir_scalar_program_option_string_expression_kind_owner.pgy";
import "direct_mir_scalar_program_option_bool_expression_kind_owner.pgy";
import "direct_mir_scalar_program_payload_enum_expression_kind_owner.pgy";
import "direct_mir_scalar_program_payload_enum_option_type_owner.pgy";
import "abi_layout_row_owner.pgy";
import "direct_mir_scalar_program_logical_record_fact_owner.pgy";

func DirectMirScalarProgramOptionAbsenceExpressionKind(
    text: String, expected_type: String,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    ref referenced_enum: DirectMirScalarProgramReferencedEnumFact
) -> DirectMirScalarProgramExpressionKindFact {
    if text != "None" {
        return DirectMirScalarProgramExpressionKindFactInvalid();
    }
    if expected_type == CompilerAbiLayoutOptionIntTypeName() {
        return DirectMirScalarProgramExpressionKindFact(
            true, DirectMirScalarProgramExprNoneInt(), expected_type, "");
    }
    if expected_type == CompilerAbiLayoutOptionStringTypeName() {
        return DirectMirScalarProgramExpressionKindFact(
            true, DirectMirScalarProgramExprNoneString(), expected_type, "");
    }
    if expected_type == CompilerAbiLayoutOptionBoolTypeName() {
        return DirectMirScalarProgramExpressionKindFact(
            true, DirectMirScalarProgramExprNoneBool(), expected_type, "");
    }
    if DirectMirScalarProgramLogicalRecordOptionTypeReady(
            logical_record, expected_type) {
        return DirectMirScalarProgramExpressionKindFact(
            true, DirectMirScalarProgramExprNoneLogicalRecord(),
            expected_type, "");
    }
    if DirectMirScalarProgramPayloadEnumOptionTypeReady(
            referenced_enum, expected_type) {
        return DirectMirScalarProgramExpressionKindFact(
            true, DirectMirScalarProgramExprNonePayloadEnum(),
            expected_type, "");
    }
    return DirectMirScalarProgramExpressionKindFactInvalid();
}
