// Sole complete-exit-set proof for caller-local owned Array<String> moves.
import "direct_mir_scalar_program_owned_array_string_move_coverage_fact_owner.pgy";
import "direct_mir_scalar_program_owned_array_string_move_flow_owner.pgy";

func DirectMirScalarProgramOwnedArrayStringMoveExitSetCoverageReady(
    ref storage: DirectMirScalarCfgProgramGraphStorage,
    ref expressions: DirectMirScalarProgramExpressionSet,
    ref callers: Array<Int>, ref operations: Array<Int>, ref graphs: Array<Int>,
    ref locals: Array<Int>, ref call_blocks: Array<Int>, row: Int
) -> Bool {
    let routine: Int = callers[row];
    let local_row: Int = locals[row];
    let definition: Int = DirectMirScalarProgramOwnedArrayStringMoveDefinitionOperation(
        storage, routine, local_row);
    if definition < 0 { return false; }
    let definition_block: Int = DirectMirScalarProgramOwnedArrayStringMoveOperationBlock(
        storage, routine, definition);
    if definition_block < 0 { return false; }
    let consuming_blocks: Array<Int> = [];
    let member: Int = 0;
    while member < ArrayLength(callers) {
        if callers[member] == routine && locals[member] == local_row {
            if !DirectMirScalarProgramOwnedArrayStringMoveCallLastUseReady(
                storage, expressions, routine, operations[member], graphs[member],
                local_row, call_blocks[member], definition, definition_block) {
                return false;
            }
            ArrayPush(consuming_blocks, call_blocks[member]);
        }
        member = member + 1;
    }
    return DirectMirScalarProgramOwnedArrayStringMoveExitPathsCovered(
        storage, routine, definition_block, consuming_blocks);
}

func DirectMirScalarProgramOwnedArrayStringMoveCoverageFromProgram(
    ref storage: DirectMirScalarCfgProgramGraphStorage,
    ref expressions: DirectMirScalarProgramExpressionSet,
    ref callers: Array<Int>, ref operations: Array<Int>,
    ref graphs: Array<Int>, ref locals: Array<Int>,
    ref callables: Array<Int>, ref parameters: Array<Int>,
    ref layouts: Array<Int>
) -> DirectMirScalarProgramOwnedArrayStringMoveCoverageFact {
    let call_blocks: Array<Int> = [];
    let row: Int = 0;
    while row < ArrayLength(callers) {
        let block: Int = DirectMirScalarProgramOwnedArrayStringMoveCallBlock(
            storage, callers[row], operations[row], graphs[row]);
        if block < 0 { return DirectMirScalarProgramOwnedArrayStringMoveCoverageInvalid(); }
        ArrayPush(call_blocks, block);
        row = row + 1;
    }
    row = 0;
    while row < ArrayLength(callers) {
        let first: Bool = true;
        let previous: Int = 0;
        while previous < row {
            if callers[previous] == callers[row] && locals[previous] == locals[row] {
                first = false;
            }
            previous = previous + 1;
        }
        if first && !DirectMirScalarProgramOwnedArrayStringMoveExitSetCoverageReady(
            storage, expressions, callers, operations, graphs, locals, call_blocks, row) {
            return DirectMirScalarProgramOwnedArrayStringMoveCoverageInvalid();
        }
        row = row + 1;
    }
    let source: DirectMirScalarProgramOwnedArrayStringMoveCoverageFact =
        DirectMirScalarProgramOwnedArrayStringMoveCoverageFact(
            true, 0, DirectMirScalarProgramOwnedArrayStringMoveCoverageInputDigest(
                storage.values.valid && storage.blocks.valid && storage.operations.valid,
                expressions, storage.routines.block_counts,
                storage.routines.operation_counts, storage.routines.local_counts,
                storage.values.local_types, storage.values.value_local_rows,
                storage.blocks.operation_starts, storage.blocks.operation_counts,
                storage.blocks.succ_true, storage.blocks.succ_false,
                storage.blocks.condition_expression_rows,
                storage.blocks.return_expression_rows, storage.operations.kinds,
                storage.operations.result_values, storage.operations.expression_rows,
                storage.operations.secondary_expression_rows,
                storage.operations.left_locals, storage.operations.right_locals,
                storage.operations.left_values, storage.operations.right_values,
                callers, operations, graphs, locals,
                callables, parameters, layouts, call_blocks), call_blocks);
    return DirectMirScalarProgramOwnedArrayStringMoveCoverageFact(
        true, DirectMirScalarProgramOwnedArrayStringMoveCoverageDigest(source),
        source.input_digest, call_blocks);
}
