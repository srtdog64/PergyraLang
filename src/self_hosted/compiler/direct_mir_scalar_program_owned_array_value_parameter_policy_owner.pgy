// Bounded descriptor transfer for public plain-value array release.
import "direct_mir_routine_signature_fact_owner.pgy";
import "abi_layout_row_owner.pgy";

func DirectMirScalarProgramOwnedArrayValueTypeReady(type_name: String) -> Bool {
    return type_name == CompilerAbiLayoutArrayIntTypeName() ||
        type_name == CompilerAbiLayoutArrayBoolTypeName();
}

func DirectMirScalarProgramOwnedArrayValueParameterReady(
    ref signature: DirectMirRoutineSignatureFact, ordinal: Int) -> Bool {
    return DirectMirRoutineSignatureFactReady(signature) && ordinal >= 0 &&
        ordinal < signature.param_count &&
        DirectMirScalarProgramOwnedArrayValueTypeReady(signature.parameters.type_names[ordinal]) &&
        signature.parameters.carriages[ordinal] == "owner-handle" &&
        signature.parameters.resources[ordinal] == "none" &&
        signature.parameters.pass_shapes[ordinal] == "direct" &&
        signature.parameters.abi_required[ordinal] &&
        signature.parameters.abi_layout_ids[ordinal] > 0;
}
