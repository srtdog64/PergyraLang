// CFG fixed point for actual owned-local execution witnesses.
import "direct_mir_scalar_program_owned_collection_block_owner.pgy";
import "direct_mir_scalar_cfg_program_routine_partition_owner.pgy";

struct DirectMirOwnedCollectionFlow { ok: Bool; terminal: Int; }

func DirectMirOwnedCollectionFlowFrom(
    ref index: MirRoutineFactIndex, ref storage: DirectMirScalarCfgProgramGraphStorage,
    ref expressions: DirectMirScalarProgramExpressionSet,
    ref callables: DirectMirScalarCfgProgramCallableInventory,
    ref signature: DirectMirRoutineSignatureFact,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    ref receipt_effects: Array<Int>, operation_offset: Int,
    routine: Int, target: Int, row: Int
) -> DirectMirOwnedCollectionFlow {
    let invalid: DirectMirOwnedCollectionFlow = DirectMirOwnedCollectionFlow(false, 0);
    let count: Int = ArrayLength(index.block_starts);
    let start: Int = DirectMirScalarProgramRoutinePartitionStart(storage.routines.block_counts, routine);
    let local_start: Int = DirectMirScalarProgramRoutinePartitionStart(
        storage.routines.local_counts, routine);
    var local_end: Int = -1;
    if local_start >= 0 && routine >= 0 &&
        routine < ArrayLength(storage.routines.local_counts) {
        local_end = local_start + storage.routines.local_counts[routine];
    }
    if !index.valid || !DirectMirOwnedCollectionRowTracked(index, row) ||
        count <= 0 || start < 0 || local_start < 0 || local_end < local_start ||
        local_end > ArrayLength(storage.values.local_names) ||
        count != ArrayLength(index.block_reachable) || count != ArrayLength(index.block_succ_true) ||
        count != ArrayLength(index.block_succ_false) ||
        start + count > ArrayLength(storage.blocks.operation_starts) ||
        start + count > ArrayLength(storage.blocks.operation_counts) ||
        routine >= ArrayLength(storage.routines.block_counts) ||
        storage.routines.block_counts[routine] != count ||
        routine >= ArrayLength(storage.routines.operation_counts) ||
        operation_offset < 0 || ArrayLength(receipt_effects) !=
            storage.routines.operation_counts[routine] ||
        !index.block_reachable[0] { return invalid; }
    var inputs: Array<Int> = [];
    var outputs: Array<Int> = [];
    var definitions: Int = 0;
    var block: Int = 0;
    while block < count {
        ArrayPush(inputs, 0); ArrayPush(outputs, 0);
        var operation: Int = storage.blocks.operation_starts[start + block];
        let end: Int = operation + storage.blocks.operation_counts[start + block];
        if operation < 0 || end < operation || end > ArrayLength(storage.operations.kinds) ||
            end > ArrayLength(storage.operations.result_values) ||
            end > ArrayLength(storage.operations.expression_rows) { return invalid; }
        while operation < end {
            let result: Int = storage.operations.result_values[operation];
            if result >= 0 && result < ArrayLength(storage.values.value_local_rows) &&
                storage.values.value_local_rows[result] == target {
                let definition: DirectMirOwnedCollectionDefinition =
                    DirectMirOwnedCollectionDefinitionFrom(storage, expressions, operation);
                if !DirectMirOwnedCollectionDefinitionReady(
                    index, storage, expressions, callables, signature,
                    logical_record, definition, row,
                    local_start, local_end) {
                    return invalid;
                }
                definitions = definitions + 1;
            }
            operation = operation + 1;
        }
        block = block + 1;
    }
    if definitions != 1 { return invalid; }
    var changed: Bool = true;
    var iteration: Int = 0;
    let limit: Int = count * 8 + 1;
    while changed && iteration < limit {
        changed = false;
        block = 0;
        while block < count {
            if index.block_reachable[block] {
                var joined: Int = 0;
                if block == 0 { joined = 1; }
                var predecessor: Int = 0;
                while predecessor < count {
                    if index.block_reachable[predecessor] &&
                        (index.block_succ_true[predecessor] == block || index.block_succ_false[predecessor] == block) {
                        joined = DirectMirOwnedCollectionStateJoin(joined, outputs[predecessor]);
                    }
                    predecessor = predecessor + 1;
                }
                if joined != 0 {
                    let output: Int = DirectMirOwnedCollectionBlockOutput(
                        index, storage, expressions, callables, signature,
                        logical_record, receipt_effects,
                        operation_offset, start + block, target, row, joined,
                        local_start, local_end);
                    if output == 0 { return invalid; }
                    if inputs[block] != joined || outputs[block] != output {
                        ArraySet(inputs, block, joined); ArraySet(outputs, block, output); changed = true;
                    }
                }
            }
            block = block + 1;
        }
        iteration = iteration + 1;
    }
    if changed { return invalid; }
    let retired: Bool = index.collection_ownership_facts.dispositions[row] == "retired";
    var terminals: Int = 0;
    block = 0;
    while block < count {
        let left: Int = index.block_succ_true[block];
        let right: Int = index.block_succ_false[block];
        if left < -1 || right < -1 || left >= count || right >= count { return invalid; }
        if index.block_reachable[block] {
            let state: Int = outputs[block];
            if state == 0 { return invalid; }
            if left < 0 && right < 0 {
                terminals = terminals + 1;
                if retired && state != 1 && state != 4 && state != 5 { return invalid; }
                if !retired && state % 8 != 1 && state % 8 != 2 && state % 8 != 3 { return invalid; }
            }
        }
        block = block + 1;
    }
    if terminals == 0 { return invalid; }
    var terminal: Int = DirectMirCollectionOwnershipStateOwned();
    if retired { terminal = DirectMirCollectionOwnershipStateRetired(); }
    else if index.collection_ownership_facts.element_ownerships[row] ==
            "unknown" {
        terminal = DirectMirCollectionOwnershipStateUnknown();
    }
    return DirectMirOwnedCollectionFlow(true, terminal);
}
