// Type policy for direct owner-handle callable parameters.

import "abi_layout_row_owner.pgy";
import "direct_mir_scalar_program_logical_record_fact_owner.pgy";
import "direct_mir_scalar_program_owned_array_value_parameter_policy_owner.pgy";
import "direct_mir_scalar_program_hashmap_parameter_policy_owner.pgy";
import "direct_mir_scalar_program_referenced_enum_fact_owner.pgy";

func DirectMirScalarProgramOwnedDirectParameterTypeReady(
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    type_name: String
) -> Bool {
    return type_name == CompilerAbiLayoutStringTypeName() ||
        type_name == CompilerAbiLayoutArrayStringTypeName() ||
        DirectMirScalarProgramOwnedArrayValueTypeReady(type_name) ||
        DirectMirScalarProgramHashMapTypeReady(type_name) ||
        DirectMirScalarProgramLogicalRecordTypeReady(logical_record, type_name);
}

func DirectMirScalarProgramOwnedDirectParameterTypeReadyWithReferencedEnum(
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    ref referenced_enum: DirectMirScalarProgramReferencedEnumFact,
    type_name: String
) -> Bool {
    return DirectMirScalarProgramOwnedDirectParameterTypeReady(
            logical_record, type_name) ||
        DirectMirScalarProgramPayloadEnumTypeReady(
            referenced_enum, type_name);
}
