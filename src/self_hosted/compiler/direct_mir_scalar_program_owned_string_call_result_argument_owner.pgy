// A proven fresh String call result may move directly into an owner-handle.
import "direct_mir_scalar_program_expression_fact_owner.pgy";
import "direct_mir_scalar_program_owned_string_result_fact_owner.pgy";

func DirectMirScalarProgramOwnedStringCallResultArgumentReady(
    ref plan: DirectMirScalarCfgGraphPlan,
    ref facts: DirectMirScalarProgramExpressionSet,
    argument: Int, graph_start: Int,
    target_carriage: String, target_type: String
) -> Bool {
    if target_carriage != "owner-handle" ||
        target_type != CompilerAbiLayoutStringTypeName() ||
        argument < graph_start || argument >= ArrayLength(facts.node_kinds) ||
        facts.node_kinds[argument] != DirectMirScalarProgramExprDirectCall() ||
        facts.node_types[argument] != CompilerAbiLayoutStringTypeName() {
        return false;
    }
    return DirectMirScalarProgramFunctionReturnsOwnedString(
        plan, facts.node_callable_rows[argument], 0);
}
