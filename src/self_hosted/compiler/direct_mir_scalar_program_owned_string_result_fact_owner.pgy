// Callee-body proof for freshly owned String results. Return type alone never
// grants ownership to a direct-call result.
import "direct_mir_scalar_cfg_graph_fact_owner.pgy";
import "direct_mir_scalar_cfg_routine_partition_fact_owner.pgy";
import "runtime_value_call_abi_owner.pgy";
import "runtime_call_abi_structured_fact_owner.pgy";
// Retire query-local integer scratch only; no GraphPlan storage is consumed.
func DirectMirScalarProgramOwnedStringProofStorageRetire(own rows: Array<Int>) -> Void {
    CompilerRetireArrayStorage(rows);
}
func DirectMirScalarProgramOwnedStringDefinitionOperation(
    ref plan: DirectMirScalarCfgGraphPlan, routine: Int, local_row: Int
) -> Int {
    var found: Int = -1;
    var operation: Int = plan.routines.operation_starts[routine];
    let end: Int = operation + plan.routines.operation_counts[routine];
    while operation < end {
        let result: Int = plan.operation_result_values[operation];
        if result >= 0 && result < ArrayLength(plan.value_local_rows) &&
            plan.value_local_rows[result] == local_row {
            // A unique definition is required to follow allocator/result
            // provenance; reassignment cannot inherit the earlier proof.
            if found >= 0 || plan.operation_kinds[operation] !=
                    DirectMirScalarCfgOpExpressionDefinition() {
                return -1;
            }
            found = operation;
        }
        operation = operation + 1;
    }
    return found;
}

func DirectMirScalarProgramOwnedStringDefinitionExpression(
    ref plan: DirectMirScalarCfgGraphPlan, routine: Int, local_row: Int
) -> Int {
    let operation: Int =
        DirectMirScalarProgramOwnedStringDefinitionOperation(
            plan, routine, local_row);
    if operation < 0 || operation >= ArrayLength(
            plan.program.operation_expression_rows) {
        return -1;
    }
    return plan.program.operation_expression_rows[operation];
}

// Resolve the value that actually reaches one use. A later assignment cannot
// prove an earlier alias, and a definition in another block needs a CFG fact
// that this bounded proof does not own.
func DirectMirScalarProgramOwnedStringReachingDefinitionOperation(
    ref plan: DirectMirScalarCfgGraphPlan, routine: Int, block: Int,
    local_row: Int, before_operation: Int
) -> Int {
    if block < 0 || block >= ArrayLength(plan.block_operation_starts) ||
        block >= ArrayLength(plan.block_operation_counts) ||
        DirectMirScalarCfgRoutinePartitionBlockOwner(
            plan.routines, block) != routine {
        return -1;
    }
    let start: Int = plan.block_operation_starts[block];
    let end: Int = start + plan.block_operation_counts[block];
    if start < 0 || end < start ||
        end > ArrayLength(plan.operation_kinds) ||
        end > ArrayLength(plan.operation_result_values) ||
        end > ArrayLength(plan.program.operation_expression_rows) ||
        before_operation < start || before_operation > end {
        return -1;
    }
    var operation: Int = before_operation;
    while operation > start {
        operation = operation - 1;
        let result: Int = plan.operation_result_values[operation];
        if result >= 0 && result < ArrayLength(plan.value_local_rows) &&
            plan.value_local_rows[result] == local_row {
            if plan.operation_kinds[operation] !=
                    DirectMirScalarCfgOpExpressionDefinition() {
                return -1;
            }
            return operation;
        }
    }
    // The admitted MIR use row already names one SSA value.  If this source
    // local has exactly one definition in the routine, crossing a block edge
    // cannot select a different value; reassignment remains fail-closed.
    return DirectMirScalarProgramOwnedStringDefinitionOperation(
        plan, routine, local_row);
}

func DirectMirScalarProgramOwnedStringAllocatorLocalReady(
    ref plan: DirectMirScalarCfgGraphPlan, routine: Int, local_row: Int
) -> Bool {
    if local_row < 0 || local_row >= ArrayLength(plan.local_types) ||
        plan.local_types[local_row] != "Allocator" ||
        DirectMirScalarCfgRoutinePartitionLocalOwner(
            plan.routines, local_row) != routine {
        return false;
    }
    let expression: Int = DirectMirScalarProgramOwnedStringDefinitionExpression(
        plan, routine, local_row);
    if expression < 0 || expression >= ArrayLength(
            plan.program.expressions.graph_roots) {
        return false;
    }
    let root: Int = plan.program.expressions.graph_roots[expression];
    if root < 0 || root >= ArrayLength(
            plan.program.expressions.node_kinds) ||
        plan.program.expressions.node_kinds[root] !=
            DirectMirScalarProgramExprRuntimeValueCall() {
        return false;
    }
    let call: CompilerRuntimeValueCallAbiFact =
        CompilerRuntimeValueCallAbiFactForId(
            plan.program.expressions.node_runtime_call_abi_ids[root]);
    return call.valid && call.source_name == "AllocatorResult" &&
        ArrayLength(call.parameter_types) == 0;
}

// One allocation predicate serves return proof and bound caller provenance.
func DirectMirScalarProgramOwnedStringAllocatingExpressionReady(ref plan: DirectMirScalarCfgGraphPlan, node: Int, routine: Int) -> Bool {
    if node < 0 || node >= ArrayLength(plan.program.expressions.node_kinds) ||
        plan.program.expressions.node_types[node] != CompilerAbiLayoutStringTypeName() { return false; }
    let kind: Int = plan.program.expressions.node_kinds[node];
    if DirectMirScalarProgramConcatBackedFreshStringExpressionKind(kind) {
        let concat: CompilerRuntimeCallAbiFact = CompilerRuntimeCallAbiStringConcatFact();
        return CompilerRuntimeCallAbiStringConcatFactReady(concat) &&
            plan.string_concat_runtime_call_abi_id == concat.runtime_call_abi_id;
    }
    if DirectMirScalarProgramFreshStringExpressionKind(kind) {
        if !plan.program.runtime_abi.valid { return false; }
        if kind == DirectMirScalarProgramExprToStringSignedInteger() {
            return plan.program.runtime_abi.string_to_string_id != 0;
        }
        if kind == DirectMirScalarProgramExprToStringBool() {
            return plan.program.runtime_abi.bool_to_string_id != 0;
        }
        if kind == DirectMirScalarProgramExprSubstring() {
            return plan.program.runtime_abi.string_substring_id != 0;
        }
        if kind == DirectMirScalarProgramExprSubstringWithLen() {
            return plan.program.runtime_abi.string_substring_with_len_id != 0;
        }
        if kind == DirectMirScalarProgramExprStringTrim() {
            return plan.program.runtime_abi.string_trim.runtime_call_abi_id != 0 &&
                plan.program.runtime_abi.string_trim.contract.returns_owned_string;
        }
        if kind == DirectMirScalarProgramExprCharAtN() {
            return plan.program.runtime_abi.string_char_at_n_id != 0;
        }
        if kind == DirectMirScalarProgramExprStringJoin() {
            return plan.program.runtime_abi.string_join_id != 0;
        }
        return kind == DirectMirScalarProgramExprReadFile() &&
            plan.program.runtime_abi.read_file_id != 0;
    }
    if kind != DirectMirScalarProgramExprRuntimeValueCall() { return false; }
    let call: CompilerRuntimeValueCallAbiFact = CompilerRuntimeValueCallAbiFactForId(
        plan.program.expressions.node_runtime_call_abi_ids[node]);
    let allocator: Int = plan.program.expressions.node_rights[node];
    return call.valid && call.source_name == "TextBuilderFinish" &&
        ArrayLength(call.parameter_types) == 2 && allocator >= 0 &&
        allocator < node && plan.program.expressions.node_kinds[allocator] ==
            DirectMirScalarProgramExprLocal() &&
        DirectMirScalarProgramOwnedStringAllocatorLocalReady(
            plan, routine, plan.program.expressions.node_local_rows[allocator]);
}

func DirectMirScalarProgramOwnedStringExpressionReady(
    ref plan: DirectMirScalarCfgGraphPlan, node: Int, routine: Int, block: Int,
    before_operation: Int, allow_borrowed: Bool, inout pending: Array<Int>
) -> Bool {
    var steps: Int = 0;
    while steps <= ArrayLength(plan.program.expressions.node_kinds) {
        if node < 0 || node >= ArrayLength(plan.program.expressions.node_kinds) ||
            plan.program.expressions.node_types[node] != CompilerAbiLayoutStringTypeName() {
            return false;
        }
        let kind: Int = plan.program.expressions.node_kinds[node];
        if kind == DirectMirScalarProgramExprLocal() {
            let local_row: Int = plan.program.expressions.node_local_rows[node];
            if local_row < 0 || DirectMirScalarCfgRoutinePartitionLocalOwner(
                    plan.routines, local_row) != routine { return false; }
            let definition: Int =
                DirectMirScalarProgramOwnedStringReachingDefinitionOperation(
                    plan, routine, block, local_row, before_operation);
            if definition < 0 { return false; }
            let expression: Int =
                plan.program.operation_expression_rows[definition];
            if expression < 0 || expression >= ArrayLength(
                    plan.program.expressions.graph_roots) { return false; }
            node = plan.program.expressions.graph_roots[expression];
            before_operation = definition;
            steps = steps + 1;
        } else if allow_borrowed &&
                kind == DirectMirScalarProgramExprToStringString() {
            let input: Int = plan.program.expressions.node_lefts[node];
            if input < 0 || input >= node ||
                plan.program.expressions.node_types[input] !=
                    CompilerAbiLayoutStringTypeName() {
                return false;
            }
            node = input;
            steps = steps + 1;
        } else {
            if allow_borrowed &&
                    kind == DirectMirScalarProgramExprStringLiteral() {
                return true;
            }
            if allow_borrowed &&
                    kind == DirectMirScalarProgramExprParameter() {
                let ordinal: Int =
                    plan.program.expressions.node_parameter_ordinals[node];
                if routine < 0 || routine >= ArrayLength(
                        plan.routines.parameter_starts) ||
                    ordinal < 0 || ordinal >=
                        plan.routines.parameter_counts[routine] {
                    return false;
                }
                let parameter: Int =
                    plan.routines.parameter_starts[routine] + ordinal;
                return parameter >= 0 && parameter < ArrayLength(
                        plan.routines.parameter_types) &&
                    plan.routines.parameter_types[parameter] ==
                        CompilerAbiLayoutStringTypeName() &&
                    plan.routines.parameter_carriages[parameter] == "value";
            }
            if DirectMirScalarProgramFreshStringExpressionKind(kind) ||
                kind == DirectMirScalarProgramExprRuntimeValueCall() {
                return DirectMirScalarProgramOwnedStringAllocatingExpressionReady(
                    plan, node, routine);
            }
            if kind != DirectMirScalarProgramExprDirectCall() { return false; }
            let target: Int = plan.program.expressions.node_callable_rows[node];
            if target <= plan.routines.entrypoint_ordinal ||
                target >= ArrayLength(plan.routines.return_types) ||
                plan.routines.return_types[target] != CompilerAbiLayoutStringTypeName() {
                return false;
            }
            ArrayPush(pending, target);
            return true;
        }
    }
    return false;
}
func DirectMirScalarProgramBlockHasProcessExit(
    ref plan: DirectMirScalarCfgGraphPlan, block: Int
) -> Bool {
    var operation: Int = plan.block_operation_starts[block];
    let end: Int = operation + plan.block_operation_counts[block];
    while operation < end {
        if plan.operation_kinds[operation] ==
                DirectMirScalarCfgOpProcessExit() {
            return true;
        }
        operation = operation + 1;
    }
    return false;
}

func DirectMirScalarProgramFunctionStringResultReady(
    ref plan: DirectMirScalarCfgGraphPlan, routine: Int, allow_borrowed: Bool
) -> Bool {
    if routine <= plan.routines.entrypoint_ordinal ||
        routine >= ArrayLength(plan.routines.return_types) ||
        plan.routines.return_types[routine] !=
            CompilerAbiLayoutStringTypeName() {
        return false;
    }
    // Query-local DFS states: 0 unseen, 1 active, 2 fully proved. Reuse a
    // completed callee, but reject an active back-edge as a proof cycle.
    var states: Array<Int> = [];
    var row: Int = 0;
    while row < ArrayLength(plan.routines.return_types) {
        ArrayPush(states, 0); row = row + 1;
    }
    var pending: Array<Int> = [routine];
    var ready: Bool = true;
    while ready && ArrayLength(pending) > 0 {
        let current: Int = pending[ArrayLength(pending) - 1];
        ArrayPop(pending);
        // Exit markers complete a body only after its callees; queued sharing is not a cycle.
        if current < 0 { states[-current - 1] = 2; }
        else if states[current] == 1 { ready = false; }
        else if states[current] == 0 {
            states[current] = 1;
            ArrayPush(pending, -current - 1);
            var saw_return: Bool = false;
            var block: Int = plan.routines.block_starts[current];
            let end: Int = block + plan.routines.block_counts[current];
            // Every terminal block except process exit needs fresh-result
            // evidence; one allocating return cannot authorize another path.
            while ready && block < end {
                if plan.block_succ_true[block] < 0 && plan.block_succ_false[block] < 0 &&
                    !DirectMirScalarProgramBlockHasProcessExit(plan, block) {
                    let expression: Int = plan.program.block_return_expression_rows[block];
                    if expression < 0 || expression >= ArrayLength(plan.program.expressions.graph_roots) ||
                        !DirectMirScalarProgramOwnedStringExpressionReady(plan,
                            plan.program.expressions.graph_roots[expression],
                            current, block,
                            plan.block_operation_starts[block] +
                                plan.block_operation_counts[block],
                            allow_borrowed, pending) {
                        ready = false;
                    }
                    saw_return = true;
                }
                block = block + 1;
            }
            if !saw_return { ready = false; }
        }
    }
    DirectMirScalarProgramOwnedStringProofStorageRetire(pending);
    DirectMirScalarProgramOwnedStringProofStorageRetire(states);
    return ready;
}

func DirectMirScalarProgramFunctionReturnsOwnedString(
    ref plan: DirectMirScalarCfgGraphPlan, routine: Int
) -> Bool {
    return DirectMirScalarProgramFunctionStringResultReady(
        plan, routine, false);
}

// A copyable result may borrow one value-carried String parameter, but every
// return path must still prove that the pointer is valid at the call boundary.
// Collection storage consumes only an immediate backend copy of this result.
func DirectMirScalarProgramFunctionReturnsCopyableString(
    ref plan: DirectMirScalarCfgGraphPlan, routine: Int
) -> Bool {
    return DirectMirScalarProgramFunctionStringResultReady(
        plan, routine, true);
}
