// Source and target type identity for Option<payload-enum> values.

import "direct_mir_scalar_program_referenced_enum_fact_owner.pgy";
import "direct_mir_scalar_program_payload_enum_type_name_owner.pgy";
import "../semantic/wrapper_type_owner.pgy";

func DirectMirScalarProgramPayloadEnumOptionPayloadType(
    ref fact: DirectMirScalarProgramReferencedEnumFact, option_type: String
) -> String {
    let payload: Option<String> = OptionPayloadTypeOpt(option_type);
    if !IsSome(payload) ||
        !DirectMirScalarProgramPayloadEnumTypeReady(fact, UnwrapOption(payload)) {
        return "";
    }
    return UnwrapOption(payload);
}

func DirectMirScalarProgramPayloadEnumOptionTypeReady(
    ref fact: DirectMirScalarProgramReferencedEnumFact, option_type: String
) -> Bool {
    return DirectMirScalarProgramPayloadEnumOptionPayloadType(
        fact, option_type) != "";
}

func DirectMirScalarProgramPayloadEnumOptionRow(
    ref fact: DirectMirScalarProgramReferencedEnumFact, option_type: String
) -> Int {
    let payload: String = DirectMirScalarProgramPayloadEnumOptionPayloadType(
        fact, option_type);
    if payload == "" { return -1; }
    return DirectMirScalarProgramReferencedEnumRow(fact, payload);
}

func DirectMirScalarProgramCPayloadEnumOptionTypeNameAt(row: Int) -> String {
    return Concat("PgyScalarPayloadEnumOption", ToString(row));
}

func DirectMirScalarProgramCPayloadEnumOptionTypeName(
    ref fact: DirectMirScalarProgramReferencedEnumFact, option_type: String
) -> String {
    let row: Int = DirectMirScalarProgramPayloadEnumOptionRow(
        fact, option_type);
    if row < 0 { return ""; }
    return DirectMirScalarProgramCPayloadEnumOptionTypeNameAt(row);
}

func DirectMirScalarProgramLlvmPayloadEnumOptionTypeNameAt(row: Int) -> String {
    return Concat("%pgy.scalar.payload.enum.option.", ToString(row));
}

func DirectMirScalarProgramLlvmPayloadEnumOptionTypeName(
    ref fact: DirectMirScalarProgramReferencedEnumFact, option_type: String
) -> String {
    let row: Int = DirectMirScalarProgramPayloadEnumOptionRow(
        fact, option_type);
    if row < 0 { return ""; }
    return DirectMirScalarProgramLlvmPayloadEnumOptionTypeNameAt(row);
}

func DirectMirScalarProgramPayloadEnumOptionParameterReady(
    ref signature: DirectMirRoutineSignatureFact, ordinal: Int,
    ref fact: DirectMirScalarProgramReferencedEnumFact
) -> Bool {
    return ordinal >= 0 && ordinal < signature.param_count &&
        DirectMirScalarProgramPayloadEnumOptionTypeReady(
            fact, signature.parameters.type_names[ordinal]) &&
        signature.parameters.carriages[ordinal] == "value" &&
        signature.parameters.resources[ordinal] == "none" &&
        signature.parameters.pass_shapes[ordinal] == "direct" &&
        !signature.parameters.abi_required[ordinal] &&
        signature.parameters.abi_layout_ids[ordinal] == 0;
}
