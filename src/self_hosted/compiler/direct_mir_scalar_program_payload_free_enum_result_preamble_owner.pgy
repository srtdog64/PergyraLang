// One target preamble per reached Result<P, E> specialization. P is an
// admitted scalar/record payload and E is a referenced payload-free enum.

import "direct_mir_scalar_cfg_graph_fact_owner.pgy";
import "direct_mir_scalar_program_payload_free_enum_result_projection_owner.pgy";
import "direct_mir_scalar_program_c_logical_record_owner.pgy";
import "direct_mir_scalar_program_llvm_logical_record_owner.pgy";
import "direct_mir_scalar_program_expression_kind_query_owner.pgy";
import "direct_mir_scalar_program_result_int_expression_kind_owner.pgy";
import "direct_mir_scalar_program_llvm_unwrap_panic_owner.pgy";

func DirectMirScalarProgramPayloadFreeEnumResultTypeAppend(
    type_name: String,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact,
    ref referenced_enum: DirectMirScalarProgramReferencedEnumFact,
    inout types: Array<String>
) -> Bool {
    let projection: DirectMirScalarProgramPayloadFreeEnumResultProjection =
        DirectMirScalarProgramPayloadFreeEnumResultProjectionFromType(
            type_name, logical_record, referenced_enum);
    if !DirectMirScalarProgramPayloadFreeEnumResultProjectionReady(
            projection, logical_record, referenced_enum) {
        return true;
    }
    var row: Int = 0;
    while row < ArrayLength(types) {
        if types[row] == projection.type_name { return true; }
        row = row + 1;
    }
    ArrayPush(types, projection.type_name);
    return types[ArrayLength(types) - 1] == projection.type_name;
}

func DirectMirScalarProgramPayloadFreeEnumResultTypes(
    ref plan: DirectMirScalarCfgGraphPlan
) -> Array<String> {
    var types: Array<String> = [];
    var row: Int = 0;
    while row < ArrayLength(plan.routines.return_types) {
        if !DirectMirScalarProgramPayloadFreeEnumResultTypeAppend(
                plan.routines.return_types[row], plan.program.logical_record,
                plan.program.referenced_enum, types) { return []; }
        row = row + 1;
    }
    row = 0;
    while row < ArrayLength(plan.routines.parameter_types) {
        if !DirectMirScalarProgramPayloadFreeEnumResultTypeAppend(
                plan.routines.parameter_types[row], plan.program.logical_record,
                plan.program.referenced_enum, types) { return []; }
        row = row + 1;
    }
    row = 0;
    while row < ArrayLength(plan.local_types) {
        if !DirectMirScalarProgramPayloadFreeEnumResultTypeAppend(
                plan.local_types[row], plan.program.logical_record,
                plan.program.referenced_enum, types) { return []; }
        row = row + 1;
    }
    row = 0;
    while row < ArrayLength(plan.program.expressions.node_types) {
        if !DirectMirScalarProgramPayloadFreeEnumResultTypeAppend(
                plan.program.expressions.node_types[row],
                plan.program.logical_record, plan.program.referenced_enum,
                types) { return []; }
        row = row + 1;
    }
    return types;
}

func DirectMirScalarProgramCPayloadFreeEnumResultPreamble(
    ref plan: DirectMirScalarCfgGraphPlan
) -> String {
    let types: Array<String> =
        DirectMirScalarProgramPayloadFreeEnumResultTypes(plan);
    var output: String = "";
    var row: Int = 0;
    while row < ArrayLength(types) {
        let p: DirectMirScalarProgramPayloadFreeEnumResultProjection =
            DirectMirScalarProgramPayloadFreeEnumResultProjectionFromType(
                types[row], plan.program.logical_record,
                plan.program.referenced_enum);
        if !DirectMirScalarProgramPayloadFreeEnumResultProjectionReady(
                p, plan.program.logical_record, plan.program.referenced_enum) {
            Die("direct MIR explicit Result C preamble projection is invalid");
        }
        var payload_type: String = CompilerAbiLayoutIntCValueType();
        var payload_zero: String = "0";
        if p.payload_record_row >= 0 {
            payload_type = DirectMirScalarProgramCLogicalRecordTypeName(
                plan.program.logical_record, p.payload_type);
            payload_zero = Concat("(", Concat(payload_type, "){0}"));
        }
        output = output + "typedef struct { bool is_ok; " + payload_type +
            " ok; int32_t error; } " + p.c_type + ";\n";
        output = output + "static " + p.c_type + " " + p.c_ok_fn + "(" +
            payload_type + " value) { " + p.c_type +
            " result = {true, value, 0}; return result; }\n";
        output = output + "static " + p.c_type + " " + p.c_err_fn +
            "(int32_t error) { " + p.c_type + " result = {false, " +
            payload_zero + ", error}; return result; }\n";
        output = output + "static bool " + p.c_is_ok_fn + "(" + p.c_type +
            " value) { return value.is_ok; }\n";
        output = output + "static bool " + p.c_is_err_fn + "(" + p.c_type +
            " value) { return !value.is_ok; }\n";
        output = output + "static " + payload_type + " " + p.c_unwrap_fn +
            "(" + p.c_type +
            " value) { if (!value.is_ok) { abort(); } return value.ok; }\n";
        output = output + "static int32_t " + p.c_unwrap_err_fn + "(" +
            p.c_type +
            " value) { if (value.is_ok) { abort(); } return value.error; }\n";
        output = output + "static " + payload_type + " " + p.c_unwrap_or_fn +
            "(" + p.c_type + " value, " + payload_type +
            " fallback) { return value.is_ok ? value.ok : fallback; }\n";
        row = row + 1;
    }
    return output;
}

func DirectMirScalarProgramLlvmPayloadFreeEnumResultPreamble(
    ref plan: DirectMirScalarCfgGraphPlan
) -> String {
    let types: Array<String> =
        DirectMirScalarProgramPayloadFreeEnumResultTypes(plan);
    var output: String = "";
    let unwrap: Bool = DirectMirScalarProgramExpressionContainsKind(
        plan.program.expressions, DirectMirScalarProgramExprUnwrapResultInt());
    let unwrap_err: Bool = DirectMirScalarProgramExpressionContainsKind(
        plan.program.expressions, DirectMirScalarProgramExprUnwrapErrInt());
    var row: Int = 0;
    while row < ArrayLength(types) {
        let p: DirectMirScalarProgramPayloadFreeEnumResultProjection =
            DirectMirScalarProgramPayloadFreeEnumResultProjectionFromType(
                types[row], plan.program.logical_record,
                plan.program.referenced_enum);
        if !DirectMirScalarProgramPayloadFreeEnumResultProjectionReady(
                p, plan.program.logical_record, plan.program.referenced_enum) {
            Die("direct MIR explicit Result LLVM preamble projection is invalid");
        }
        var payload_type: String = "i64";
        if p.payload_record_row >= 0 {
            payload_type = DirectMirScalarProgramLlvmLogicalRecordTypeName(
                plan.program.logical_record, p.payload_type);
        }
        output = output + p.llvm_type + " = type { i1, " + payload_type +
            ", i64 }\n\n";
        output = output + "define internal " + p.llvm_type + " @" +
            p.llvm_stem + ".ok(" + payload_type +
            " %value) {\nentry:\n  %tagged = insertvalue " + p.llvm_type +
            " poison, i1 true, 0\n  %valued = insertvalue " + p.llvm_type +
            " %tagged, " + payload_type +
            " %value, 1\n  %complete = insertvalue " + p.llvm_type +
            " %valued, i64 0, 2\n  ret " + p.llvm_type +
            " %complete\n}\n\n";
        output = output + "define internal " + p.llvm_type + " @" +
            p.llvm_stem +
            ".err(i64 %error) {\nentry:\n  %tagged = insertvalue " +
            p.llvm_type +
            " poison, i1 false, 0\n  %zeroed = insertvalue " + p.llvm_type +
            " %tagged, " + payload_type +
            " zeroinitializer, 1\n  %complete = insertvalue " + p.llvm_type +
            " %zeroed, i64 %error, 2\n  ret " + p.llvm_type +
            " %complete\n}\n\n";
        output = output + "define internal i1 @" + p.llvm_stem +
            ".is_ok(" + p.llvm_type +
            " %value) {\nentry:\n  %tag = extractvalue " + p.llvm_type +
            " %value, 0\n  ret i1 %tag\n}\n\n";
        output = output + "define internal i1 @" + p.llvm_stem +
            ".is_err(" + p.llvm_type +
            " %value) {\nentry:\n  %tag = extractvalue " + p.llvm_type +
            " %value, 0\n  %error = xor i1 %tag, true\n  ret i1 %error\n}\n\n";
        if unwrap {
            output = output + "define internal " + payload_type + " @" +
                p.llvm_stem + ".unwrap(" + p.llvm_type +
                " %value) {\nentry:\n  %tag = extractvalue " + p.llvm_type +
                " %value, 0\n  br i1 %tag, label %ok, label %error\nerror:\n" +
                DirectMirScalarProgramLlvmUnwrapErrPanic() +
                "ok:\n  %payload = extractvalue " + p.llvm_type +
                " %value, 1\n  ret " + payload_type + " %payload\n}\n\n";
        }
        if unwrap_err {
            output = output + "define internal i64 @" + p.llvm_stem +
                ".unwrap_err(" + p.llvm_type +
                " %value) {\nentry:\n  %tag = extractvalue " + p.llvm_type +
                " %value, 0\n  br i1 %tag, label %ok, label %error\nok:\n" +
                DirectMirScalarProgramLlvmUnwrapOkPanic() +
                "error:\n  %payload = extractvalue " + p.llvm_type +
                " %value, 2\n  ret i64 %payload\n}\n\n";
        }
        output = output + "define internal " + payload_type + " @" +
            p.llvm_stem + ".unwrap_or(" + p.llvm_type + " %value, " +
            payload_type +
            " %fallback) {\nentry:\n  %tag = extractvalue " + p.llvm_type +
            " %value, 0\n  br i1 %tag, label %ok, label %fallback_block\nok:\n" +
            "  %payload = extractvalue " + p.llvm_type +
            " %value, 1\n  ret " + payload_type +
            " %payload\nfallback_block:\n  ret " + payload_type +
            " %fallback\n}\n\n";
        row = row + 1;
    }
    return output;
}
