// Exact ArrayBool return with one readonly record and two scalar inputs.

import "direct_mir_routine_signature_fact_owner.pgy";
import "abi_layout_row_owner.pgy";
import "direct_mir_scalar_program_logical_record_fact_owner.pgy";

func DirectMirScalarProgramReadonlyLogicalRecordArrayBoolReturnSignatureReady(
    ref signature: DirectMirRoutineSignatureFact,
    ref logical_record: DirectMirScalarProgramLogicalRecordFact
) -> Bool {
    if !DirectMirRoutineSignatureFactReady(signature) ||
        signature.return_type != CompilerAbiLayoutArrayBoolTypeName() ||
        signature.param_count != 3 ||
        !DirectMirScalarProgramLogicalRecordTypeReady(
            logical_record, signature.parameters.type_names[0]) {
        return false;
    }
    let ordinal: Int = 0;
    while ordinal < signature.param_count {
        let expected: String = CompilerAbiLayoutBoolTypeName();
        let carriage: String = "value";
        let pass_shape: String = "direct";
        if ordinal == 0 {
            expected = signature.parameters.type_names[0];
            carriage = "readonly-ref";
            pass_shape = "indirect";
        } else if ordinal == 1 {
            expected = CompilerAbiLayoutIntTypeName();
        }
        if signature.parameters.type_names[ordinal] != expected ||
            signature.parameters.carriages[ordinal] != carriage ||
            signature.parameters.resources[ordinal] != "none" ||
            signature.parameters.pass_shapes[ordinal] != pass_shape ||
            signature.parameters.abi_required[ordinal] ||
            signature.parameters.abi_layout_ids[ordinal] != 0 {
            return false;
        }
        ordinal = ordinal + 1;
    }
    return true;
}
