// One canonical Result<Int> layout receipt for scalar-program expressions.

import "direct_mir_result_int_abi_capture_owner.pgy";
import "direct_mir_scalar_program_expression_fact_owner.pgy";
import "../mir_lower/abi_layout_admission_fact_owner.pgy";
import "../mir_lower/routine_instruction_scalar_capture_owner.pgy";

func DirectMirScalarProgramResultIntAbiFromInstruction(
    current: DirectMirResultIntAbiFact,
    json: String,
    ref capture: MirRoutineInstructionScalarCapture
) -> DirectMirResultIntAbiFact {
    if capture.abi_type_name != CompilerAbiLayoutResultIntTypeName() {
        return current;
    }
    let admitted: Option<MirAbiLayoutRowCapture> =
        MirCapturedRequiredAbiLayoutRowAdmission(
            json, capture.abi_type_name, capture.abi_type_value_ready,
            capture.abi_type_start, capture.abi_type_end,
            capture.abi_layout_id_start, capture.abi_layout_id_end,
            capture.abi_layout_required_start,
            capture.abi_layout_required_end,
            capture.abi_layout_start, capture.abi_layout_end
        );
    if !IsSome(admitted) {
        Die("direct MIR scalar program Result<Int> ABI receipt is missing");
    }
    let next: DirectMirResultIntAbiFact =
        DirectMirResultIntAbiFactFromCapture(UnwrapOption(admitted));
    if current.valid && (current.layout_id != next.layout_id ||
        current.digest != next.digest) {
        Die("direct MIR scalar program Result<Int> ABI owners disagree");
    }
    return next;
}

func DirectMirScalarProgramResultIntAbiCanonicalEmpty(
    ref fact: DirectMirResultIntAbiFact
) -> Bool {
    return !fact.valid && fact.digest == 0 && fact.layout_id == 0;
}

func DirectMirScalarProgramResultIntAbiReadyForExpressions(
    ref fact: DirectMirResultIntAbiFact,
    ref expressions: DirectMirScalarProgramExpressionSet
) -> Bool {
    let required: Bool = false;
    let row: Int = 0;
    while row < ArrayLength(expressions.node_types) {
        if expressions.node_types[row] ==
                CompilerAbiLayoutResultIntTypeName() {
            required = true;
        }
        row = row + 1;
    }
    if required || fact.valid { return DirectMirResultIntAbiFactReady(fact); }
    return DirectMirScalarProgramResultIntAbiCanonicalEmpty(fact);
}
