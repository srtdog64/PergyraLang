// Declaration-free scalar program claim keyed by typed routine envelopes.
import "direct_mir_scalar_cfg_hash_owner.pgy";
import "direct_mir_scalar_program_two_int_nominal_abi_fact_owner.pgy";
import "direct_mir_scalar_program_array_int_value_result_fact_owner.pgy";
import "direct_mir_scalar_program_array_bool_abi_owner.pgy";
import "direct_mir_scalar_program_array_string_abi_owner.pgy";
import "direct_mir_scalar_program_logical_record_fact_owner.pgy";
import "direct_mir_scalar_program_payload_free_enum_fact_owner.pgy";
import "direct_mir_scalar_program_logical_record_payload_free_enum_join_owner.pgy";
import "direct_mir_scalar_program_logical_record_collection_abi_owner.pgy";
struct DirectMirScalarProgramRouteFact {
    let claimed: Bool; let digest: Int;
    let entrypoint_row: Int; let callable_row: Int;
    let routine_rows: Array<Int>;
    let nominal: DirectMirScalarProgramTwoIntNominalAbiFact;
    let logical_record: DirectMirScalarProgramLogicalRecordFact;
    let payload_free_enum: DirectMirScalarProgramPayloadFreeEnumFact;
    let array_int_value_result: DirectMirScalarProgramArrayIntValueResultFact;
    let array_bool_abi: DirectMirScalarProgramArrayBoolAbiFact;
    let array_string_abi: DirectMirScalarProgramArrayStringAbiFact;
}
func DirectMirScalarProgramRouteFactEmpty() -> DirectMirScalarProgramRouteFact {
    let rows: Array<Int> = [];
    return DirectMirScalarProgramRouteFact(
        false, 0, -1, -1, rows,
        DirectMirScalarProgramTwoIntNominalAbiFactInvalid(),
        DirectMirScalarProgramLogicalRecordFactInvalid(),
        DirectMirScalarProgramPayloadFreeEnumFactInvalid(),
        DirectMirScalarProgramArrayIntValueResultFactInvalid(),
        DirectMirScalarProgramArrayBoolAbiFactInvalid(),
        DirectMirScalarProgramArrayStringAbiFactEmpty());
}
func DirectMirScalarProgramRouteFactCanonicalEmpty(
    ref fact: DirectMirScalarProgramRouteFact
) -> Bool {
    return !fact.claimed && fact.digest == 0 && fact.entrypoint_row == -1 &&
        fact.callable_row == -1 && ArrayLength(fact.routine_rows) == 0 &&
        !fact.nominal.valid && !fact.logical_record.valid &&
        !fact.payload_free_enum.valid &&
        !fact.array_int_value_result.valid && !fact.array_bool_abi.valid &&
        DirectMirScalarProgramArrayStringAbiFactCanonicalEmpty(
            fact.array_string_abi);
}
func DirectMirScalarProgramRouteFactDigest(
    ref fact: DirectMirScalarProgramRouteFact
) -> Int {
    if !fact.claimed { return 0; }
    let hash: Long = DirectMirCfgHashInt(223L, fact.entrypoint_row);
    hash = DirectMirCfgHashInt(hash, fact.callable_row);
    hash = DirectMirScalarCfgHashInts(hash, fact.routine_rows);
    hash = DirectMirCfgHashInt(hash, fact.nominal.digest);
    hash = DirectMirCfgHashInt(hash, fact.logical_record.digest);
    hash = DirectMirCfgHashInt(hash, fact.payload_free_enum.digest);
    hash = DirectMirCfgHashInt(hash, fact.array_int_value_result.digest);
    hash = DirectMirCfgHashInt(hash, fact.array_bool_abi.digest);
    hash = DirectMirCfgHashInt(hash, fact.array_string_abi.digest);
    return DirectMirCfgBoundedDigest(hash);
}
func DirectMirScalarProgramRouteFactReady(
    ref fact: DirectMirScalarProgramRouteFact
) -> Bool {
    let count: Int = ArrayLength(fact.routine_rows);
    if !fact.claimed || fact.digest == 0 || count < 1 ||
        fact.digest != DirectMirScalarProgramRouteFactDigest(fact) ||
        fact.entrypoint_row < 0 || fact.routine_rows[0] != fact.entrypoint_row ||
        ((count == 2) != (fact.callable_row >= 0)) ||
        (count == 2 && fact.routine_rows[1] != fact.callable_row) ||
        (count != 2 && fact.callable_row >= 0) ||
        !DirectMirScalarProgramTwoIntNominalAbiFactReady(fact.nominal) ||
        !DirectMirScalarProgramLogicalRecordFactReady(fact.logical_record) ||
        !DirectMirScalarProgramPayloadFreeEnumFactReady(
            fact.payload_free_enum) ||
        !DirectMirScalarProgramLogicalRecordPayloadFreeEnumJoinReady(
            fact.logical_record, fact.payload_free_enum) ||
        !DirectMirScalarProgramArrayIntValueResultFactReady(
            fact.array_int_value_result) ||
        !DirectMirScalarProgramArrayBoolAbiFactReady(fact.array_bool_abi) ||
        (!DirectMirScalarProgramArrayStringAbiFactReady(
            fact.array_string_abi) &&
         !DirectMirScalarProgramArrayStringAbiFactCanonicalEmpty(
            fact.array_string_abi) ||
        !DirectMirScalarProgramLogicalRecordCollectionAbiReady(
            fact.logical_record, fact.array_int_value_result, fact.array_bool_abi,
            fact.array_string_abi)) {
        return false;
    }
    let row: Int = 0;
    while row < count {
        if fact.routine_rows[row] < 0 { return false; }
        let prior: Int = 0;
        while prior < row {
            if fact.routine_rows[prior] == fact.routine_rows[row] {
                return false;
            }
            prior = prior + 1;
        }
        row = row + 1;
    }
    return true;
}
