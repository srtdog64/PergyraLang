// Readiness boundary for expression-derived scalar-program runtime ABI facts.

import "direct_mir_scalar_program_runtime_abi_requirement_owner.pgy";

func DirectMirScalarProgramRuntimeAbiFactReadyForExpressions(
    ref fact: DirectMirScalarProgramRuntimeAbiFact,
    ref expressions: DirectMirScalarProgramExpressionSet
) -> Bool {
    if !fact.valid || fact.digest == 0 ||
        fact.digest != DirectMirScalarProgramRuntimeAbiFactDigest(fact) {
        return false;
    }
    let expected: DirectMirScalarProgramRuntimeAbiFact =
        DirectMirScalarProgramRuntimeAbiFactFromExpressionKinds(expressions);
    return expected.valid && expected.digest == fact.digest &&
        expected.string_compare_id == fact.string_compare_id &&
        expected.string_concat_id == fact.string_concat_id &&
        expected.string_to_string_id == fact.string_to_string_id &&
        expected.string_to_upper_id == fact.string_to_upper_id &&
        expected.string_to_lower_id == fact.string_to_lower_id &&
        expected.string_length_id == fact.string_length_id &&
        expected.string_substring_id == fact.string_substring_id &&
        expected.string_substring_with_len_id ==
            fact.string_substring_with_len_id;
}
