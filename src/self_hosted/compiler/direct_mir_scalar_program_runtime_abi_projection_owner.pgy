// Concrete runtime symbols projected from one sealed scalar-program ABI fact.

import "direct_mir_scalar_program_runtime_abi_fact_owner.pgy";
import "runtime_call_abi_structured_fact_owner.pgy";

struct DirectMirScalarProgramRuntimeAbiProjection {
    let valid: Bool;
    let string_compare: CompilerRuntimeCallAbiFact;
    let string_concat: CompilerRuntimeCallAbiFact;
    let string_to_string: CompilerRuntimeCallAbiFact;
    let string_to_upper: CompilerRuntimeCallAbiFact;
    let string_to_lower: CompilerRuntimeCallAbiFact;
}

func DirectMirScalarProgramRuntimeAbiProjectionFromFact(
    ref fact: DirectMirScalarProgramRuntimeAbiFact
) -> DirectMirScalarProgramRuntimeAbiProjection {
    return DirectMirScalarProgramRuntimeAbiProjection(
        fact.valid,
        CompilerRuntimeCallAbiStringCompareFact(),
        CompilerRuntimeCallAbiStringConcatFact(),
        CompilerRuntimeCallAbiStringToStringFact(),
        CompilerRuntimeCallAbiStringToUpperFact(),
        CompilerRuntimeCallAbiStringToLowerFact()
    );
}

func DirectMirScalarProgramRuntimeAbiProjectionReady(
    ref projection: DirectMirScalarProgramRuntimeAbiProjection,
    ref fact: DirectMirScalarProgramRuntimeAbiFact
) -> Bool {
    if !projection.valid || !fact.valid { return false; }
    return (fact.string_compare_id == 0 ||
            (CompilerRuntimeCallAbiStringCompareFactReady(
                projection.string_compare) &&
             fact.string_compare_id ==
                projection.string_compare.runtime_call_abi_id)) &&
        (fact.string_concat_id == 0 ||
            (CompilerRuntimeCallAbiStringConcatFactReady(
                projection.string_concat) &&
             fact.string_concat_id ==
                projection.string_concat.runtime_call_abi_id)) &&
        (fact.string_to_string_id == 0 ||
            (CompilerRuntimeCallAbiStringToStringFactReady(
                projection.string_to_string) &&
             fact.string_to_string_id ==
                projection.string_to_string.runtime_call_abi_id)) &&
        (fact.string_to_upper_id == 0 ||
            (CompilerRuntimeCallAbiStringToUpperFactReady(
                projection.string_to_upper) &&
             fact.string_to_upper_id ==
                projection.string_to_upper.runtime_call_abi_id)) &&
        (fact.string_to_lower_id == 0 ||
            (CompilerRuntimeCallAbiStringToLowerFactReady(
                projection.string_to_lower) &&
             fact.string_to_lower_id ==
                projection.string_to_lower.runtime_call_abi_id));
}
