// Exact projected ABI identity for String/Array<String> runtime operations.

import "direct_mir_scalar_program_runtime_abi_projection_owner.pgy";
import "direct_mir_scalar_program_generated_runtime_projection_readiness_owner.pgy";
import "../codegen/runtime_abi/host_io_runtime_owner.pgy";

func DirectMirScalarProgramCollectionAbiProjectionReady(
    id: Int, fact: CompilerRuntimeCallAbiFact,
    operation: String, symbol: String, call_shape: String
) -> Bool {
    return id == 0 ||
        (fact.ok && fact.domain == "collection" &&
         fact.operation == operation && fact.symbol == symbol &&
         fact.symbol_kind == "function" && fact.materialization ==
            CompilerRuntimeCallAbiMaterialGeneratedHelper() &&
         fact.call_shape == call_shape && id == fact.runtime_call_abi_id);
}

func DirectMirScalarProgramStringCollectionRuntimeProjectionReady(
    ref projection: DirectMirScalarProgramRuntimeAbiProjection,
    ref fact: DirectMirScalarProgramRuntimeAbiFact
) -> Bool {
    return DirectMirScalarProgramRuntimeGeneratedAbiProjectionReady(
            fact.string_contains_id, projection.string_contains, "contains",
            StringRuntimeCStringContainsFn(), "string_string_to_bool") &&
        DirectMirScalarProgramRuntimeGeneratedAbiProjectionReady(
            fact.string_split_id, projection.string_split, "split",
            StringRuntimeCSplitFn(), "string_string_to_array_string") &&
        DirectMirScalarProgramRuntimeGeneratedAbiProjectionReady(
            fact.string_join_id, projection.string_join, "join",
            StringRuntimeCStringJoinFn(), "array_string_string_to_string") &&
        DirectMirScalarProgramRuntimeGeneratedAbiProjectionReady(
            fact.string_to_int_id, projection.string_to_int, "to-int",
            StringRuntimeCToIntFn(), "string_to_int") &&
        DirectMirScalarProgramCollectionAbiProjectionReady(
            fact.array_string_length_id, projection.array_string_length,
            "array-string.len", CollectionRuntimeCLenFn(2),
            "collection_to_int") &&
        DirectMirScalarProgramCollectionAbiProjectionReady(
            fact.array_string_get_id, projection.array_string_get,
            "array-string.get", CollectionRuntimeCGetFn(2),
            "collection_index_to_value") &&
        (fact.process_args_id == 0 ||
         (projection.process_args.ok &&
          projection.process_args.domain == "host-io" &&
          projection.process_args.operation == "args" &&
          projection.process_args.symbol == HostIORuntimeCArgsFn() &&
          projection.process_args.materialization ==
            CompilerRuntimeCallAbiMaterialGeneratedHelper() &&
          projection.process_args.call_shape == "returns_array_string" &&
          fact.process_args_id ==
            projection.process_args.runtime_call_abi_id)) &&
        (fact.dir_walk_id == 0 ||
         (projection.dir_walk.ok && projection.dir_walk.domain == "host-io" &&
          projection.dir_walk.operation == "dir-walk" &&
          projection.dir_walk.symbol == HostIORuntimeCDirWalkFn() &&
          projection.dir_walk.materialization ==
            CompilerRuntimeCallAbiMaterialGeneratedHelper() &&
          projection.dir_walk.call_shape == "string_to_array_string" &&
          fact.dir_walk_id == projection.dir_walk.runtime_call_abi_id)) &&
        (fact.file_exists_id == 0 ||
         (projection.file_exists.ok &&
          projection.file_exists.domain == "host-io" &&
          projection.file_exists.operation == "file-exists" &&
          projection.file_exists.symbol == HostIORuntimeCFileExistsFn() &&
          projection.file_exists.materialization ==
            CompilerRuntimeCallAbiMaterialGeneratedHelper() &&
          projection.file_exists.call_shape == "string_to_bool" &&
          fact.file_exists_id == projection.file_exists.runtime_call_abi_id)) &&
        (fact.read_file_id == 0 ||
         (projection.read_file.ok &&
          projection.read_file.domain == "host-io" &&
          projection.read_file.operation == "read-file" &&
          projection.read_file.symbol == HostIORuntimeCReadFileFn() &&
          projection.read_file.materialization ==
            CompilerRuntimeCallAbiMaterialGeneratedHelper() &&
          projection.read_file.call_shape == "string_to_string" &&
          fact.read_file_id == projection.read_file.runtime_call_abi_id));
}
