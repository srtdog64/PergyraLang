// JSON-ready spelling of a persisted Pergyra String literal.
// `\$` and `\{` keep an interpolation opener literal (docs/grammar/01_syntax.md);
// the native AST decoder drops the backslash. They are not JSON escapes, so
// the backslash is removed before the bounded JSON decoder reads the literal.

import "../codegen/text/text_owner.pgy";
import "../lib/string_window_within.pgy";

func DirectMirScalarProgramStringLiteralJsonSpelling(
    spelling: String, spelling_extent: Int, length: Int
) -> String {
    if StringIndexOf(spelling, "\\$") < 0 && StringIndexOf(spelling, "\\{") < 0 {
        return spelling;
    }
    let allocator: Allocator = AllocatorResult();
    let out: TextBuilder = TextBuilderNew(256);
    let index: Int = 0;
    while index < length {
        let code: Int = StringWindowCharCode(spelling, spelling_extent, length, index);
        if code == 92 && index + 1 < length {
            let escaped: Int = StringWindowCharCode(spelling, spelling_extent, length, index + 1);
            if escaped != 36 && escaped != 123 {
                TextBuilderAppend(out, StringWindowCharAt(spelling, spelling_extent, length, index));
            }
            TextBuilderAppend(out, StringWindowCharAt(spelling, spelling_extent, length, index + 1));
            index = index + 2;
        } else {
            TextBuilderAppend(out, StringWindowCharAt(spelling, spelling_extent, length, index));
            index = index + 1;
        }
    }
    let result: String = TextBuilderFinish(out, allocator);
    AllocatorDestroy(allocator);
    return result;
}
