// Decoded UTF-8 byte payload identity for persisted Pergyra string literals.
// docs/110 owns byte preservation; this is not Unicode normalization.

import "../lib/json.pgy";
import "direct_mir_scalar_program_string_literal_escape_owner.pgy";

func DirectMirScalarProgramStringLiteralContent(
    spelling: String
) -> Option<String> {
    let length: Int = StringLength(spelling);
    if length < 2 || CharCode(spelling, length, 0) != 34 ||
        CharCode(spelling, length, length - 1) != 34 { return None; }
    let index: Int = 1;
    while index < length - 1 {
        let code: Int = CharCode(spelling, length, index);
        if code < 32 || code == 127 || code > 255 || code == 34 { return None; }
        if code == 92 {
            if index + 1 >= length - 1 { return None; }
            let escaped: Int = CharCode(spelling, length, index + 1);
            if escaped != 110 && escaped != 114 && escaped != 116 && escaped != 34 &&
                escaped != 92 && escaped != 36 && escaped != 123 { return None; }
            index = index + 2;
        } else { index = index + 1; }
    }
    let json_spelling: String =
        DirectMirScalarProgramStringLiteralJsonSpelling(spelling, length);
    let json_length: Int = StringLength(json_spelling);
    let end: Array<Int> = [0];
    let value: String = ReadJsonStringBounded(
        json_spelling, 0, json_length, end);
    if end[0] != json_length { return None; }
    return Some(value);
}
