// Exact input/output shapes for scalar ToString specializations.
import "direct_mir_scalar_program_expression_fact_owner.pgy";

func DirectMirScalarProgramToStringExpressionNodeReady(
    ref facts: DirectMirScalarProgramExpressionSet, node: Int
) -> Option<Bool> {
    let kind: Int = facts.node_kinds[node];
    if kind != DirectMirScalarProgramExprToStringSignedInteger() && kind !=
            DirectMirScalarProgramExprToStringString() && kind !=
            DirectMirScalarProgramExprToStringBool() { return None; }
    let left: Int = facts.node_lefts[node];
    if left < 0 || left >= node { return Some(false); }
    let input: String = facts.node_types[left];
    let expected: Bool = input == CompilerAbiLayoutIntTypeName() ||
        input == CompilerAbiLayoutLongTypeName();
    if kind == DirectMirScalarProgramExprToStringString() {
        expected = input == CompilerAbiLayoutStringTypeName();
    } else if kind == DirectMirScalarProgramExprToStringBool() {
        expected = input == CompilerAbiLayoutBoolTypeName();
    }
    return Some(facts.node_types[node] == CompilerAbiLayoutStringTypeName() &&
        expected &&
        facts.node_rights[node] == -1 && facts.node_local_rows[node] == -1 &&
        facts.node_parameter_ordinals[node] == -1 &&
        facts.node_member_ordinals[node] == -1 &&
        facts.node_literals[node] == "" &&
        facts.node_callable_rows[node] == -1);
}
