// Runtime-free C emission from one verified nested value-struct plan.

import "direct_mir_struct_argument_plan_owner.pgy";
import "runtime_call_abi_structured_fact_owner.pgy";
import "symbol_table_owner.pgy";

func DirectMirStructArgumentEmitC(
    ref plan: DirectMirStructArgumentPlan,
    formatted_print: CompilerRuntimeCallAbiFact,
    line_format: String
) -> String {
    if !DirectMirStructArgumentPlanReady(plan) || !formatted_print.ok ||
        formatted_print.call_shape !=
            CompilerRuntimeCallAbiStringCallShape("formatted-print") ||
        formatted_print.symbol == "" || line_format == "" {
        Die("direct MIR struct argument C projection facts are invalid");
    }
    let outer_type: String = CompilerSymbolCIdentifier(
        plan.program.outer_declaration.name
    );
    let nested_type: String = CompilerSymbolCIdentifier(
        plan.program.nested_declaration.name
    );
    let outer_first: String = CompilerSymbolCIdentifier(
        plan.program.main_graph.outer_first_field
    );
    let outer_second: String = CompilerSymbolCIdentifier(
        plan.program.main_graph.outer_second_field
    );
    let nested_first: String = CompilerSymbolCIdentifier(
        plan.program.main_graph.nested_first_field
    );
    let nested_second: String = CompilerSymbolCIdentifier(
        plan.program.main_graph.nested_second_field
    );
    let outer_symbol: String = CompilerSymbolCIdentifier(
        plan.program.outer_callee.name
    );
    let nested_symbol: String = CompilerSymbolCIdentifier(
        plan.program.nested_callee.name
    );
    let outer_param: String = CompilerSymbolCIdentifier(
        plan.program.outer_callee.param.name
    );
    let nested_param: String = CompilerSymbolCIdentifier(
        plan.program.nested_callee.param.name
    );
    if outer_type == "" || nested_type == "" || outer_type == nested_type ||
        outer_symbol == "" || nested_symbol == "" ||
        outer_symbol == nested_symbol || outer_param == "" ||
        nested_param == "" || outer_first == "" || outer_second == "" ||
        nested_first == "" || nested_second == "" {
        Die("direct MIR struct argument C symbols are invalid");
    }
    let output: String =
        "#include <stdint.h>\n#include <stddef.h>\n#include <stdio.h>\n\n";
    output = Concat(output, "typedef struct {\n    int32_t ");
    output = Concat(output, nested_first);
    output = Concat(output, ";\n    int32_t ");
    output = Concat(output, nested_second);
    output = Concat(output, ";\n} ");
    output = Concat(output, nested_type);
    output = Concat(output, ";\n\ntypedef struct {\n    ");
    output = Concat(output, nested_type);
    output = Concat(output, " ");
    output = Concat(output, outer_first);
    output = Concat(output, ";\n    ");
    output = Concat(output, nested_type);
    output = Concat(output, " ");
    output = Concat(output, outer_second);
    output = Concat(output, ";\n} ");
    output = Concat(output, outer_type);
    output = Concat(output, ";\n\n_Static_assert(sizeof(");
    output = Concat(output, nested_type);
    output = Concat(output, ") == ");
    output = Concat(output, plan.program.nested_declaration.abi.size_text);
    output = Concat(output, ", \"nested size receipt\");\n_Static_assert(_Alignof(");
    output = Concat(output, nested_type);
    output = Concat(output, ") == ");
    output = Concat(output, plan.program.nested_declaration.abi.align_text);
    output = Concat(output, ", \"nested align receipt\");\n_Static_assert(offsetof(");
    output = Concat(output, nested_type);
    output = Concat(output, ", ");
    output = Concat(output, nested_second);
    output = Concat(output, ") == ");
    output = Concat(output, plan.program.nested_declaration.abi.field_offsets[1]);
    output = Concat(output, ", \"nested field receipt\");\n_Static_assert(sizeof(");
    output = Concat(output, outer_type);
    output = Concat(output, ") == ");
    output = Concat(output, plan.program.outer_declaration.abi.size_text);
    output = Concat(output, ", \"outer size receipt\");\n_Static_assert(_Alignof(");
    output = Concat(output, outer_type);
    output = Concat(output, ") == ");
    output = Concat(output, plan.program.outer_declaration.abi.align_text);
    output = Concat(output, ", \"outer align receipt\");\n_Static_assert(offsetof(");
    output = Concat(output, outer_type);
    output = Concat(output, ", ");
    output = Concat(output, outer_second);
    output = Concat(output, ") == ");
    output = Concat(output, plan.program.outer_declaration.abi.field_offsets[1]);
    output = Concat(output, ", \"outer field receipt\");\n\nstatic int32_t ");
    output = Concat(output, nested_symbol);
    output = Concat(output, "(int32_t ");
    output = Concat(output, nested_param);
    output = Concat(output, ") {\n    return ");
    output = Concat(output, nested_param);
    output = Concat(output, " * ");
    output = Concat(output, ToString(plan.scalar_factor));
    output = Concat(output, ";\n}\n\nstatic int32_t ");
    output = Concat(output, outer_symbol);
    output = Concat(output, "(");
    output = Concat(output, outer_type);
    output = Concat(output, " ");
    output = Concat(output, outer_param);
    output = Concat(output, ") {\n    return ");
    output = Concat(output, outer_param);
    output = Concat(output, ".");
    output = Concat(output, outer_second);
    output = Concat(output, ".");
    output = Concat(output, nested_first);
    output = Concat(output, " - ");
    output = Concat(output, outer_param);
    output = Concat(output, ".");
    output = Concat(output, outer_first);
    output = Concat(output, ".");
    output = Concat(output, nested_first);
    output = Concat(output, ";\n}\n\nint main(void) {\n    int32_t pgy_nested = ");
    output = Concat(output, nested_symbol);
    output = Concat(output, "(");
    output = Concat(output, ToString(plan.program.main_graph.nested_argument));
    output = Concat(output, ");\n    ");
    output = Concat(output, nested_type);
    output = Concat(output, " pgy_first = {pgy_nested, ");
    output = Concat(output, ToString(plan.program.main_graph.first_second_value));
    output = Concat(output, "};\n    int32_t pgy_second_first = ");
    output = Concat(output, ToString(plan.program.main_graph.second_first_left));
    output = Concat(output, " + ");
    output = Concat(output, ToString(plan.program.main_graph.second_first_right));
    output = Concat(output, ";\n    ");
    output = Concat(output, nested_type);
    output = Concat(output, " pgy_second = {pgy_second_first, ");
    output = Concat(output, ToString(plan.program.main_graph.second_second_value));
    output = Concat(output, "};\n    ");
    output = Concat(output, outer_type);
    output = Concat(output, " pgy_argument = {pgy_first, pgy_second};\n    int32_t pgy_result = ");
    output = Concat(output, outer_symbol);
    output = Concat(output, "(pgy_argument);\n    ");
    output = Concat(output, formatted_print.symbol);
    output = Concat(output, "(\"");
    output = Concat(output, line_format);
    output = Concat(output, "\", (long long)pgy_result);\n    return 0;\n}\n");
    return output;
}
