// Target selection for the already admitted nominal value-flow plan.

import "direct_mir_struct_value_flow_c_emission_owner.pgy";
import "direct_mir_struct_value_flow_llvm_emission_owner.pgy";

func CompileAdmittedDirectMirStructValueFlow(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    ref classification: DirectMirTwoRoutineNominalClassificationFact,
    is_llvm: Bool,
    formatted_print: CompilerRuntimeCallAbiFact,
    line_format: String
) -> String {
    let plan: DirectMirStructValueFlowPlan =
        DirectMirStructValueFlowPlanFromAdmitted(admitted, classification);
    if is_llvm {
        return DirectMirStructValueFlowEmitLlvm(
            plan, formatted_print, line_format
        );
    }
    return DirectMirStructValueFlowEmitC(
        plan, formatted_print, line_format
    );
}
