// One structural decision for all bounded three-routine direct-MIR programs.
import "direct_mir_scalar_graph_admission_owner.pgy";
import "direct_mir_three_routine_shape_owner.pgy";
import "direct_mir_three_routine_classification_fact_owner.pgy";
import "direct_mir_array_argument_legacy_route_owner.pgy";
import "direct_mir_struct_argument_program_admission_owner.pgy";

func DirectMirThreeRoutineClassificationFromAdmitted(
    ref admitted: MirMachineLayerAdmittedJsonInput
) -> DirectMirThreeRoutineClassificationFact {
    let specializations: JsonArrayObjectFactTable =
        JsonObjectFactArrayObjectTable(
            admitted.document.root, "generic_method_specializations"
        );
    if MirProgramRoutineIndexCount(admitted.routines) != 3 ||
        !JsonArrayObjectFactTableReady(admitted.document.declarations) ||
        !JsonArrayObjectFactTableReady(specializations) ||
        !MirProgramRoutineIndexStructureReady(admitted.routines) {
        Die("direct MIR three-routine structure is invalid");
    }
    let declarations: Int = JsonArrayObjectFactCount(
        admitted.document.declarations
    );
    let specialization_count: Int = JsonArrayObjectFactCount(specializations);
    let generic_routine_count: Int =
        DirectMirThreeRoutineGenericRoutineCount(admitted.routines);
    let constructed_shape: DirectMirThreeRoutineConstructedMemberShapeFact =
        InvalidDirectMirThreeRoutineConstructedMemberShapeFact();
    let mixed_shape: DirectMirThreeRoutineMixedConstructedMemberShapeFact =
        InvalidDirectMirThreeRoutineMixedConstructedMemberShapeFact();
    let role_override: DirectMirRoleOverrideProgramIdentity =
        InvalidDirectMirRoleOverrideProgramIdentity();
    let kind: String = "";
    if DirectMirArrayArgumentLegacyRouteClaimed(admitted) &&
        declarations == 0 && specialization_count == 0 &&
        generic_routine_count == 0 {
        kind = DirectMirThreeRoutineArrayArgument();
    } else if declarations == 0 && specialization_count == 2 &&
        generic_routine_count == 1 {
        kind = DirectMirThreeRoutineInferredGenericScalar();
    } else if declarations == 1 && specialization_count == 4 &&
        generic_routine_count == 1 {
        kind = DirectMirThreeRoutineGenericNominal();
    } else if declarations == 1 && specialization_count == 2 &&
        generic_routine_count == 2 {
        constructed_shape =
            DirectMirThreeRoutineConstructedMemberShapeFromAdmitted(admitted);
        if !DirectMirThreeRoutineConstructedMemberShapeFactReady(
            constructed_shape
        ) {
            Die("direct MIR constructed member structural shape is invalid");
        }
        kind = DirectMirThreeRoutineConstructedGenericMember();
    } else if declarations == 2 && specialization_count == 2 &&
        generic_routine_count == 2 {
        mixed_shape =
            DirectMirThreeRoutineMixedConstructedMemberShapeFromAdmitted(
                admitted
            );
        if !DirectMirThreeRoutineMixedConstructedMemberShapeFactReady(
            mixed_shape
        ) {
            Die("direct MIR mixed constructed member structural shape is invalid");
        }
        kind = DirectMirThreeRoutineMixedConstructedGenericMember();
    } else if declarations == 2 && specialization_count == 0 &&
        generic_routine_count == 0 &&
        DirectMirRoleOverrideFamilyClaimed(admitted) {
        role_override =
            DirectMirRoleOverrideProgramIdentityFromAdmitted(admitted);
        kind = DirectMirThreeRoutineRoleOverride();
    } else if declarations == 2 && specialization_count == 0 &&
        generic_routine_count == 0 &&
        DirectMirStructArgumentProgramEnvelopeReady(admitted) {
        kind = DirectMirThreeRoutineStructArgument();
    } else {
        Die("direct MIR three-routine structural shape is unsupported");
    }
    let fact: DirectMirThreeRoutineClassificationFact =
        DirectMirThreeRoutineClassificationFact(
            true, 0, kind, declarations,
            specialization_count, generic_routine_count, role_override,
            constructed_shape, mixed_shape
        );
    let verified: DirectMirThreeRoutineClassificationFact =
        DirectMirThreeRoutineClassificationFact(
            fact.valid, DirectMirThreeRoutineClassificationFactDigest(fact),
            fact.kind, fact.declaration_count, fact.specialization_count,
            fact.generic_routine_count, fact.role_override_program,
            fact.constructed_member_shape,
            fact.mixed_constructed_member_shape
        );
    if !DirectMirThreeRoutineClassificationFactReady(verified) {
        Die("direct MIR three-routine classification is invalid");
    }
    return verified;
}
