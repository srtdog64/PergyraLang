// Exact struct-plus-class shape for one constructed nominal Array member flow.

import "direct_mir_scalar_graph_admission_owner.pgy";
import "../air/mir_cfg_identity_owner.pgy";

struct DirectMirThreeRoutineMixedConstructedMemberShapeFact {
    let valid: Bool;
    let digest: Int;
    let record_name: String;
    let class_name: String;
    let method_routine_count: Int;
    let function_routine_count: Int;
}

func InvalidDirectMirThreeRoutineMixedConstructedMemberShapeFact(
) -> DirectMirThreeRoutineMixedConstructedMemberShapeFact {
    return DirectMirThreeRoutineMixedConstructedMemberShapeFact(
        false, 0, "", "", 0, 0
    );
}

func DirectMirThreeRoutineMixedConstructedMemberShapeDigest(
    ref fact: DirectMirThreeRoutineMixedConstructedMemberShapeFact
) -> Int {
    if !fact.valid { return 0; }
    let hash: Long = DirectMirCfgHashString(439L, fact.record_name);
    hash = DirectMirCfgHashString(hash, fact.class_name);
    hash = DirectMirCfgHashInt(hash, fact.method_routine_count);
    hash = DirectMirCfgHashInt(hash, fact.function_routine_count);
    return DirectMirCfgBoundedDigest(hash);
}

func DirectMirThreeRoutineMixedConstructedMemberShapeFactReady(
    ref fact: DirectMirThreeRoutineMixedConstructedMemberShapeFact
) -> Bool {
    return fact.valid && fact.digest != 0 && fact.digest ==
        DirectMirThreeRoutineMixedConstructedMemberShapeDigest(fact) &&
        fact.record_name != "" && fact.class_name != "" &&
        fact.record_name != fact.class_name &&
        fact.method_routine_count == 2 && fact.function_routine_count == 1;
}

func DirectMirThreeRoutineMixedConstructedMemberShapeFromAdmitted(
    ref admitted: MirMachineLayerAdmittedJsonInput
) -> DirectMirThreeRoutineMixedConstructedMemberShapeFact {
    let declarations: MirProgramDeclarationIndex =
        admitted.domain_runtime_admission.declarations;
    if MirProgramRoutineIndexCount(admitted.routines) != 3 ||
        !MirProgramRoutineIndexStructureReady(admitted.routines) ||
        !declarations.valid || MirProgramDeclarationIndexCount(declarations) != 2 {
        return InvalidDirectMirThreeRoutineMixedConstructedMemberShapeFact();
    }
    let record_name: String = "";
    let class_name: String = "";
    let row: Int = 0;
    while row < 2 {
        if declarations.kinds[row] == "struct" &&
            declarations.nominal_kinds[row] == "struct" &&
            record_name == "" {
            record_name = declarations.names[row];
        } else if declarations.kinds[row] == "class" &&
            declarations.nominal_kinds[row] == "class" &&
            class_name == "" {
            class_name = declarations.names[row];
        } else {
            return InvalidDirectMirThreeRoutineMixedConstructedMemberShapeFact();
        }
        row = row + 1;
    }
    if record_name == "" || class_name == "" || record_name == class_name {
        return InvalidDirectMirThreeRoutineMixedConstructedMemberShapeFact();
    }
    let method_count: Int = 0;
    let function_count: Int = 0;
    let routine_row: Int = 0;
    while routine_row < 3 {
        if admitted.routines.kinds[routine_row] == "method" &&
            admitted.routines.owners[routine_row] == class_name {
            method_count = method_count + 1;
        } else if admitted.routines.kinds[routine_row] == "function" &&
            admitted.routines.owners[routine_row] == "" {
            function_count = function_count + 1;
        } else {
            return InvalidDirectMirThreeRoutineMixedConstructedMemberShapeFact();
        }
        routine_row = routine_row + 1;
    }
    let fact: DirectMirThreeRoutineMixedConstructedMemberShapeFact =
        DirectMirThreeRoutineMixedConstructedMemberShapeFact(
            true, 0, record_name, class_name, method_count, function_count
        );
    let verified: DirectMirThreeRoutineMixedConstructedMemberShapeFact =
        DirectMirThreeRoutineMixedConstructedMemberShapeFact(
            fact.valid,
            DirectMirThreeRoutineMixedConstructedMemberShapeDigest(fact),
            fact.record_name, fact.class_name, fact.method_routine_count,
            fact.function_routine_count
        );
    if !DirectMirThreeRoutineMixedConstructedMemberShapeFactReady(verified) {
        return InvalidDirectMirThreeRoutineMixedConstructedMemberShapeFact();
    }
    return verified;
}
