// Exclusive projection for the one structural three-routine classification.

import "direct_mir_three_routine_classification_owner.pgy";
import "direct_mir_array_argument_emission_owner.pgy";
import "direct_mir_struct_argument_c_emission_owner.pgy";
import "direct_mir_struct_argument_llvm_emission_owner.pgy";
import "direct_mir_generic_struct_value_flow_projection_owner.pgy";
import "direct_mir_inferred_generic_scalar_projection_owner.pgy";
import "direct_mir_constructed_generic_member_projection_owner.pgy";

func CompileAdmittedDirectMirThreeRoutine(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    target_projection: CompilerTargetProjectionFact,
    is_llvm: Bool,
    formatted_print: CompilerRuntimeCallAbiFact,
    line_format: String
) -> String {
    let classification: DirectMirThreeRoutineClassificationFact =
        DirectMirThreeRoutineClassificationFromAdmitted(admitted);
    if classification.kind == DirectMirThreeRoutineInferredGenericScalar() {
        return CompileAdmittedDirectMirInferredGenericScalar(
            admitted, classification, is_llvm, formatted_print, line_format
        );
    }
    if classification.kind ==
        DirectMirThreeRoutineConstructedGenericMember() {
        return CompileAdmittedDirectMirConstructedGenericMember(
            admitted, classification, target_projection, is_llvm,
            formatted_print, line_format
        );
    }
    if classification.kind == DirectMirThreeRoutineArrayArgument() {
        let plan: DirectMirArrayArgumentPlan =
            DirectMirArrayArgumentPlanFromAdmitted(admitted);
        let abi: DirectMirArrayIntAbiProjection =
            DirectMirArrayIntAbiProjectionFromCanonicalLayout(
                target_projection, plan.abi_layout_id, plan.abi_size,
                plan.abi_align, plan.data_offset, plan.length_offset,
                plan.capacity_offset, plan.allocator_offset
            );
        if is_llvm {
            return DirectMirArrayArgumentEmitLlvm(
                plan, abi, formatted_print, line_format
            );
        }
        return DirectMirArrayArgumentEmitC(
            plan, abi, formatted_print, line_format
        );
    }
    if classification.kind == DirectMirThreeRoutineGenericNominal() {
        return CompileAdmittedDirectMirGenericStructValueFlow(
            admitted, classification, is_llvm, formatted_print, line_format
        );
    }
    if classification.kind == DirectMirThreeRoutineStructArgument() {
        let plan: DirectMirStructArgumentPlan =
            DirectMirStructArgumentPlanFromAdmitted(admitted);
        if is_llvm {
            return DirectMirStructArgumentEmitLlvm(
                plan, formatted_print, line_format
            );
        }
        return DirectMirStructArgumentEmitC(
            plan, formatted_print, line_format
        );
    }
    Die("direct MIR three-routine projection rejected the classification");
    return "";
}
