// Compiler Clone landings and the routes that can carry them.
//
// The semantic ownership analysis selects exact expression nodes that must be
// copied (a compiler Clone, docs/truth/decisions/2026-10-22 and 2026-11-12).
// MIR carries one kind of landing: the stored value of an owned String push
// or set, whose instruction's collection receipt (owned-string-push or
// owned-string-set) makes the direct emitter store a copy. Every other
// landing has no MIR carrier: an argument of a declared routine or of a
// constructor, a binding's initializer, an assigned value, or a value a
// shallow store keeps. Self-host MIR JSON has no Clone call for it. The MIR
// to AST round trip derives the same landings again from the same program,
// so its C keeps every copy. A direct MIR emitter reads only the MIR and
// would emit the program without that copy, so a direct route refuses a
// program with one instead of admitting it.
import "../../mir/program_fact_owner.pgy";
import "../../semantic/ast_expression/ast_expression_graph_call_argument_edge_owner.pgy";
import "../../semantic/ast_expression/ast_expression_graph_node_view_owner.pgy";
import "../../semantic/ast_expression/ast_expression_graph_consumer_owner.pgy";
import "../codegen_route_refusal_owner.pgy";

// The node that consumes `node`: the sealed consumer row, or the first later
// row whose operands name it; -1 when none does.
func DriverCompilerCloneLandingConsumer(ref graph: SemanticExpressionGraphFacts, node: Int) -> Int {
    let count: Int = SemanticExpressionGraphArenaNodeCount(graph.arena);
    if graph.arena.shape_ready && ArrayLength(graph.arena.consumer_rows) == count {
        return graph.arena.consumer_rows[node];
    }
    var row: Int = node + 1;
    while row < count {
        if SemanticExpressionGraphRowConsumes(graph.arena.topology, row, node) { return row; }
        row = row + 1;
    }
    return -1;
}

// The landings no direct MIR emitter carries (see the header). An argument
// of a declared routine or of a constructor is never carried, even inside an
// owned store: a constructor emitted without its copy leaves the record
// sharing the local's storage, and every holder that releases it frees it
// again.
func DriverCompilerCloneLandingCount(ref facts: SelfMirProgramFacts) -> Int {
    let node_count: Int = ArrayLength(facts.expression_graph.arena.compiler_clone_kinds);
    var targets: HashMap<String, Int> = MapNew();
    var row: Int = 0;
    while row < ArrayLength(facts.routines.node_ids) {
        MapSet(targets, ToString(facts.routines.node_ids[row]), 1);
        row = row + 1;
    }
    // A constructor call targets its nominal declaration.
    row = 0;
    while row < ArrayLength(facts.declarations.source_syntax_ids) {
        if facts.declarations.source_syntax_ids[row] > 0 {
            MapSet(targets, ToString(facts.declarations.source_syntax_ids[row]), 1);
        }
        row = row + 1;
    }
    let carried: Array<Bool> = DriverCompilerCloneReceiptCarriedNodes(facts, node_count);
    var count: Int = 0;
    var node: Int = 0;
    while node < node_count {
        if facts.expression_graph.arena.compiler_clone_kinds[node] == 1 && !carried[node] {
            count = count + 1;
        } else if facts.expression_graph.arena.compiler_clone_kinds[node] == 1 {
            var uncarried: Bool = false;
            var consumer: Int = -1;
            if facts.expression_graph.ok && node_count == SemanticExpressionGraphArenaNodeCount(facts.expression_graph.arena) {
                consumer = DriverCompilerCloneLandingConsumer(facts.expression_graph, node);
            }
            if consumer >= 0 {
                let edge: SemanticCallArgumentEdgeView = SemanticCallArgumentEdgeFromGraph(
                    facts.expression_graph, consumer);
                var target: Int = 0;
                if edge.ok && edge.argument_node == node {
                    let found: Option<Int> = SemanticExpressionGraphCallTargetSyntaxId(
                        facts.expression_graph, edge.call_node);
                    if IsSome(found) { target = UnwrapOption(found); }
                }
                uncarried = edge.ok && edge.argument_node == node && MapHas(targets, ToString(target));
            }
            if uncarried { count = count + 1; }
        }
        node = node + 1;
    }
    return count;
}

// The expression nodes of instructions whose collection receipt is an owned
// String push (1) or set (4): the emitter copies the value such a store
// keeps. Rows that do not line up with the instructions carry nothing.
func DriverCompilerCloneReceiptCarriedNodes(ref facts: SelfMirProgramFacts, node_count: Int) -> Array<Bool> {
    var carried: Array<Bool> = [];
    var node: Int = 0;
    while node < node_count {
        ArrayPush(carried, false);
        node = node + 1;
    }
    let instruction_count: Int = ArrayLength(facts.cfg.instructions.ids);
    if !facts.collection_ownership_receipts.valid ||
        ArrayLength(facts.collection_ownership_receipts.effect_kinds) != instruction_count ||
        ArrayLength(facts.cfg.instructions.expr0_graphs.has_roots) != instruction_count ||
        ArrayLength(facts.cfg.instructions.expr0_graphs.node_starts) != instruction_count ||
        ArrayLength(facts.cfg.instructions.expr0_graphs.node_counts) != instruction_count {
        return carried;
    }
    var instruction: Int = 0;
    while instruction < instruction_count {
        let effect: Int = facts.collection_ownership_receipts.effect_kinds[instruction];
        if (effect == 1 || effect == 4) &&
            facts.cfg.instructions.expr0_graphs.has_roots[instruction] != 0 {
            let first: Int = facts.cfg.instructions.expr0_graphs.node_starts[instruction];
            let end: Int = first + facts.cfg.instructions.expr0_graphs.node_counts[instruction];
            var row: Int = first;
            while row < end {
                if row >= 0 && row < node_count { ArraySet(carried, row, true); }
                row = row + 1;
            }
        }
        instruction = instruction + 1;
    }
    return carried;
}

func DriverCompilerCloneDirectRouteRefusal(landings: Int, route: String) -> CodegenRouteRefusal {
    return CodegenRouteRefusal(
        "driver-compiler-clone-route", route,
        Concat("direct MIR emission cannot carry the ", Concat(ToString(landings),
            " compiler Clone landing(s) the source ownership analysis selected; the program is refused instead of emitted without its copies")));
}
