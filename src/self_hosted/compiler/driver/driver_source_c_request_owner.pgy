// Exact source-C request identity. Diagnostic selection is carried with the
// machine declaration; consumers may not recover it from rendered text.

import "../machine_layer_declaration_consumer.pgy";

enum DriverSourceCRequest {
    SourceCDefault(Bool),
    SourceCManifestVerified(SelfHostMachineLayerDeclaration, Bool),
}

struct DriverSourceCRequestIdentity {
    let mode: String;
    let machine_manifest_id: String;
    let machine_manifest_fingerprint: String;
    let emit_json_diagnostic: Bool;
}

func DriverSourceCRequestIdentitySnapshot(
    ref request: DriverSourceCRequest
) -> DriverSourceCRequestIdentity {
    match request {
        case SourceCDefault(emit_json):
            var mode: String = "default";
            if emit_json { mode = "default-json-diagnostic"; }
            return DriverSourceCRequestIdentity(mode, "", "", emit_json);
        case SourceCManifestVerified(declaration, emit_json):
            var mode: String = "manifest-verified";
            if emit_json { mode = "manifest-verified-json-diagnostic"; }
            return DriverSourceCRequestIdentity(
                mode,
                Concat("", declaration.manifest_id),
                Concat("", declaration.manifest_fingerprint),
                emit_json
            );
    }
}

func DriverSourceCRequestDeclaration(
    own request: DriverSourceCRequest
) -> SelfHostMachineLayerDeclaration {
    match request {
        case SourceCDefault(emit_json):
            return SelfHostMachineLayerDeclarationEmpty();
        case SourceCManifestVerified(declaration, emit_json):
            return declaration;
    }
}
