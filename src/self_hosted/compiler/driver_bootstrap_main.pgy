// Minimal runnable boundary for the integrated compiler fixed point.
//
// The verified pipeline is owned by driver_rung2_owner.pgy. This entrypoint
// gives the bootstrap runner deterministic source/MIR/output-file surfaces.

import "driver_rung2_owner.pgy";
import "compiler_world_direct_mir_owner.pgy";

func Main() -> Void with caps env, io_read, io_write {
    let args: Array<String> = Args();
    let machine_declaration: SelfHostMachineLayerDeclaration =
        SelfHostMachineLayerDeclarationEmpty();
    if ArrayLength(args) == 2 {
        let source_commit: SelfMirArtifactCommitOutcome =
            SelfMirArtifactCommitPayload(
            args[1],
            CompileSourceToCVerified(
                args[0], machine_declaration
            ).payload
        );
        if !SelfMirArtifactCommitOutcomeReady(source_commit) {
            Die("source compiler artifact transaction failed");
        }
        return;
    }
    if (ArrayLength(args) == 3 || ArrayLength(args) == 4) &&
        args[0] == "--emit-mir-json-verified" {
        let source_request: DriverSourceMirRequest = SourceMirVerified;
        if ArrayLength(args) == 4 {
            if args[3] != "--pressure-owned-full-fixpoint" {
                Die("unknown source MIR pressure token");
            }
            source_request = SourceMirPressureObserved;
        }
        let source_outcome: DriverSourceMirExecutionOutcome =
            PublishSourceMirArtifactThroughPgyCompilerWorld(
                args[1], args[2], machine_declaration, source_request
            );
        if !DriverSourceMirExecutionOutcomeReadyFor(
            source_outcome, args[1], args[2], source_request
        ) {
            Log(DriverSourceMirExecutionOutcomeDiagnostic(
                source_outcome, args[1], args[2], source_request
            ));
            Exit(1);
        }
        return;
    }
    if ArrayLength(args) == 3 &&
        (args[0] == "--mir-json-backend=c" ||
         args[0] == "--mir-json-backend=llvm") {
        let request: DriverRung2DirectMirRequest = DirectMirC;
        if args[0] == "--mir-json-backend=llvm" {
            request = DirectMirLlvm;
        }
        let outcome: DriverRung2ExecutionOutcome =
            EmitDirectMirThroughPgyCompilerWorld(
            args[1], args[2], machine_declaration, request
        );
        let expected_projection: String =
            DriverRung2DirectMirRequestProjection(request);
        if !DriverRung2ExecutionOutcomeReadyFor(
            outcome, args[2], expected_projection
        ) {
            Log(DriverRung2ExecutionOutcomeDiagnostic(
                outcome, args[2], expected_projection
            ));
            Exit(1);
        }
        return;
    }
    if ArrayLength(args) > 0 && StringLength(args[0]) >= 19 &&
        Substring(args[0], 0, 19) == "--mir-json-backend=" {
        Die("unknown direct MIR backend target; expected c or llvm");
    }
    if (ArrayLength(args) == 3 || ArrayLength(args) == 4) &&
        args[0] == "--mir-json" {
        if ArrayLength(args) == 4 &&
            args[3] != "--observe-mir-consumer-stages" {
            Die("unknown MIR consumer observation token");
        }
        if ArrayLength(args) == 4 {
            let observed_commit: SelfMirArtifactCommitOutcome =
                SelfMirArtifactCommitPayload(
                args[2],
                CompileMirJsonToCVerifiedObserved(
                    args[1], machine_declaration
                ).payload
            );
            if !SelfMirArtifactCommitOutcomeReady(observed_commit) {
                Die("observed MIR compiler artifact transaction failed");
            }
            return;
        }
        let mir_commit: SelfMirArtifactCommitOutcome =
            SelfMirArtifactCommitPayload(
            args[2],
            CompileMirJsonToCVerified(
                args[1], machine_declaration
            ).payload
        );
        if !SelfMirArtifactCommitOutcomeReady(mir_commit) {
            Die("MIR compiler artifact transaction failed");
        }
        return;
    }
    Die("bootstrap driver requires source/output or MIR mode/input/output");
}
