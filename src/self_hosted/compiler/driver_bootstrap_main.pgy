// Minimal runnable boundary for the integrated compiler fixed point.
//
// The verified pipeline is owned by driver_rung2_owner.pgy. This entrypoint
// gives the bootstrap runner deterministic source/MIR/output-file surfaces.

import "driver_rung2_owner.pgy";
import "compiler_world_direct_mir_owner.pgy";

func DriverBootstrapPathEndsWith(path: String, suffix: String) -> Bool {
    let path_length: Int = StringLength(path);
    let suffix_length: Int = StringLength(suffix);
    return path_length >= suffix_length &&
        SubEqualsWithLen(
            path, path_length, path_length - suffix_length,
            suffix_length, suffix
        );
}

func Main() -> Void with caps env, io_read, io_write {
    let args: Array<String> = Args();
    let machine_declaration: SelfHostMachineLayerDeclaration =
        SelfHostMachineLayerDeclarationEmpty();
    if ArrayLength(args) == 2 {
        WriteFile(
            args[1],
            CompileSourceToCVerified(
                args[0], machine_declaration
            ).payload
        );
        return;
    }
    if (ArrayLength(args) == 3 || ArrayLength(args) == 4) &&
        args[0] == "--emit-mir-json-verified" {
        let is_full_driver_source: Bool =
            args[1] == "src/self_hosted/compiler/driver_bootstrap_main.pgy" ||
            DriverBootstrapPathEndsWith(
                args[1],
                "/src/self_hosted/compiler/driver_bootstrap_main.pgy"
            );
        if is_full_driver_source &&
            (ArrayLength(args) != 4 ||
             args[3] != "--pressure-owned-full-fixpoint") {
            Die("full driver MIR production requires the pressure-owned bootstrap gate");
        }
        if !is_full_driver_source && ArrayLength(args) != 3 {
            Die("full-fixpoint pressure token is only valid for the driver source");
        }
        if is_full_driver_source {
            CompileSourceToMirJsonFilePressureObserved(
                args[1], args[2], machine_declaration
            );
        } else {
            CompileSourceToMirJsonFileVerified(
                args[1], args[2], machine_declaration
            );
        }
        return;
    }
    if ArrayLength(args) == 3 &&
        (args[0] == "--mir-json-backend=c" ||
         args[0] == "--mir-json-backend=llvm") {
        let request: DriverRung2DirectMirRequest = DirectMirC;
        if args[0] == "--mir-json-backend=llvm" {
            request = DirectMirLlvm;
        }
        let result: DriverRung2ExecutionResult =
            EmitDirectMirThroughPgyCompilerWorld(
            args[1], args[2], machine_declaration, request
        );
        if !DriverRung2ExecutionResultReady(result) {
            Log(result.diagnostic);
            Exit(1);
        }
        return;
    }
    if ArrayLength(args) > 0 && StringLength(args[0]) >= 19 &&
        Substring(args[0], 0, 19) == "--mir-json-backend=" {
        Die("unknown direct MIR backend target; expected c or llvm");
    }
    if (ArrayLength(args) == 3 || ArrayLength(args) == 4) &&
        args[0] == "--mir-json" {
        if ArrayLength(args) == 4 &&
            args[3] != "--observe-mir-consumer-stages" {
            Die("unknown MIR consumer observation token");
        }
        if ArrayLength(args) == 4 {
            WriteFile(
                args[2],
                CompileMirJsonToCVerifiedObserved(
                    args[1], machine_declaration
                ).payload
            );
            return;
        }
        WriteFile(
            args[2],
            CompileMirJsonToCVerified(
                args[1], machine_declaration
            ).payload
        );
        return;
    }
    Die("bootstrap driver requires source/output or MIR mode/input/output");
}
