// Self-host compiler driver pipeline owner.
//
// Owns the executable source -> AST fact -> emitted C spine shared by the
// user-facing driver and the bootstrap fixed-point runner. Compiler-world and
// CLI policy stay in their own owners; neither may reimplement this pipeline.

import "../parser/program_parse_owner.pgy";
import "../semantic/ast_artifact_verdict_owner.pgy";
import "../codegen/emission/program_emit.pgy";

func CompilerDriverPipelineReady() -> Bool {
    return ParserAstTreePayloadContractReady() &&
        TypedAstArenaPayloadContractReady() &&
        AstTreeArtifactPayloadContractReady() &&
        SemanticAstArtifactVerdictContractReady() &&
        SemanticAstFunctionSignatureFactsContractReady();
}

func CompileSourceToAstArtifact(source_path: String) -> AstTreeArtifact with caps io_read {
    if !CompilerDriverPipelineReady() {
        Die("driver pipeline facts are not ready");
    }
    let artifact: AstTreeArtifact = ParseRootProgramArtifact(source_path);
    if !AstTreeArtifactReady(artifact) {
        Die("parser produced an invalid typed AST artifact");
    }
    return artifact;
}

func CompileSourceToAst(source_path: String) -> String with caps io_read {
    let artifact: AstTreeArtifact = CompileSourceToAstArtifact(source_path);
    return artifact.tree_text;
}

func CompileAstToC(ast_text: String) -> String {
    if !CompilerDriverPipelineReady() {
        Die("driver pipeline facts are not ready");
    }
    let artifact: AstTreeArtifact = AstTreeArtifactFromText(ast_text);
    let semantic_analysis: SemanticAstArtifactAnalysis =
        SemanticAstArtifactAnalyze(artifact, true);
    if !semantic_analysis.verdict.ok {
        Log(semantic_analysis.verdict.diagnostic_message);
        Exit(1);
    }
    return GenerateCFromSemanticArtifact(artifact, semantic_analysis);
}

func CompileSourceToC(source_path: String) -> String with caps io_read {
    let artifact: AstTreeArtifact = CompileSourceToAstArtifact(source_path);
    let semantic_analysis: SemanticAstArtifactAnalysis =
        SemanticAstArtifactAnalyze(artifact, true);
    if !semantic_analysis.verdict.ok {
        Log(semantic_analysis.verdict.diagnostic_message);
        Exit(1);
    }
    return GenerateCFromSemanticArtifact(artifact, semantic_analysis);
}
