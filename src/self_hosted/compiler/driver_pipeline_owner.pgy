// Self-host compiler driver pipeline owner.
//
// Owns the executable source -> AST fact -> emitted C spine shared by the
// user-facing driver and the bootstrap fixed-point runner. Compiler-world and
// CLI policy stay in their own owners; neither may reimplement this pipeline.

import "../parser/program_parse_owner.pgy";
import "../semantic/ast_artifact_verdict_owner.pgy";
import "../semantic/ast_signature_contract_owner.pgy";
import "../semantic/ast_body_type_bundle_owner.pgy";
import "../codegen/emission/program_entry_owner.pgy";
import "machine_layer_declaration_consumer.pgy";

struct CompilerEmissionArtifact {
    kind: String;
    payload: String;
}

func CompilerDriverPipelineReady() -> Bool {
    return ParserAstTreePayloadContractReady() &&
        TypedAstArenaPayloadContractReady() &&
        AstTreeArtifactPayloadContractReady() &&
        SemanticAstArtifactVerdictContractReady() &&
        SemanticAstFunctionSignatureFactsContractReady() &&
        SemanticAstLocalBindingFactsContractReady();
}

func CompileSourceToAstArtifact(source_path: String) -> AstTreeArtifact with caps io_read {
    if !CompilerDriverPipelineReady() {
        Die("driver pipeline facts are not ready");
    }
    let artifact: AstTreeArtifact = ParseRootProgramArtifact(source_path);
    if !AstTreeArtifactReady(artifact) {
        Die("parser produced an invalid typed AST artifact");
    }
    return artifact;
}

func CompileAstArtifactToC(
    artifact: AstTreeArtifact
) -> CompilerEmissionArtifact {
    if !CompilerDriverPipelineReady() {
        Die("driver pipeline facts are not ready");
    }
    let semantic_analysis: SemanticAstArtifactAnalysis =
        SemanticAstArtifactAnalyzeCompactBridge(artifact, true);
    if !semantic_analysis.verdict.ok {
        Log(semantic_analysis.verdict.diagnostic_message);
        Exit(1);
    }
    let bundle: SemanticAstBodyTypeBundle =
        SemanticAstBodyTypeBundleFromAnalysis(artifact, semantic_analysis);
    let generic_specializations: CodegenGenericSpecializationFacts =
        CodegenGenericSpecializationFactsFromSemantic(
            semantic_analysis.signatures, bundle.generic_specializations
        );
    let body_types: CodegenSemanticBodyTypeFacts =
        CodegenSemanticBodyTypeFactsFromBundleOrDie(
            artifact, semantic_analysis, bundle, generic_specializations
        );
    return CompilerEmissionArtifact(
        "emitted-c",
        GenerateCFromVerifiedSemanticArtifact(
            artifact, semantic_analysis, body_types,
            SelfHostMachineLayerDeclarationEmpty()
        )
    );
}

func CompileSourceToCArtifact(
    source_path: String
) -> CompilerEmissionArtifact with caps io_read {
    let artifact: AstTreeArtifact = CompileSourceToAstArtifact(source_path);
    return CompileAstArtifactToC(artifact);
}
