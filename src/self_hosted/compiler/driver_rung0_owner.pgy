// DRV-0 in-process self-host driver owner.
//
// Owns the first driver assembly seam: source path -> self-parser AST text ->
// self-codegen emitted C text. Stage-local parsing and emission facts remain in
// their stage owners; this owner only consumes compiler-world readiness facts
// and composes the already-owned stage entry functions.

import "path_manifest_owner.pgy";
import "stage_artifact_owner.pgy";
import "target_capability_owner.pgy";
import "../parser/source_path_owner.pgy";
import "../parser/program_parse_owner.pgy";
import "../codegen/emission/program_emit.pgy";

func CompilerDriverRung0Ready() -> Bool with caps io_read {
    if !CompilerStagePathManifestReady() {
        return false;
    }
    if !CompilerAstTreeFactReady() {
        return false;
    }
    if !CompilerEmissionFactReady() {
        return false;
    }
    if !CompilerTargetCapabilityEnvelopeReady() {
        return false;
    }
    return true;
}

func CompileSourceToAst(source_path: String) -> String with caps io_read {
    if !CompilerDriverRung0Ready() {
        Die("driver rung-0 compiler-world facts are not ready");
    }
    return ParseRootProgram(source_path);
}

func CompileAstToC(ast_text: String) -> String {
    return GenerateC(ast_text);
}

func CompileSourceToC(source_path: String) -> String with caps io_read {
    let ast_text: String = CompileSourceToAst(source_path);
    return CompileAstToC(ast_text);
}

func DriverRung0ArtifactMode(args: Array<String>) -> String {
    if ArrayLength(args) > 1 {
        return args[1];
    }
    return "--emit-c";
}

func RunDriverRung0FromArgs(args: Array<String>) -> Void with caps io_read {
    let source_path: String = ParserDefaultSourcePath(args);
    let mode: String = DriverRung0ArtifactMode(args);
    if mode == "--emit-ast" {
        Log(CompileSourceToAst(source_path));
        return;
    }
    if mode != "--emit-c" {
        Die(Concat("unknown driver rung-0 artifact mode: ", mode));
    }
    Log(CompileSourceToC(source_path));
}
