// Standalone DRV-2 command-line boundary. Exact argv meaning is owned by the
// pure request owner; this wrapper performs one admission and one read action.

import "driver_rung2_cli_request_owner.pgy";
import "driver_rung2_cli_read_execution_owner.pgy";

func RunDriverRung2FromArgs(args: Array<String>) -> Void with caps io_read {
    let request: DriverRung2CliRequest =
        DriverRung2CliRequestFromArgsOrDie(args);
    DriverRung2ExecuteReadRequest(request);
}
