// Reachable direct-MIR action boundary: typed MIR/backend owners keep semantic
// authority; this subject owns admission, artifact acceptance, and completion.

import "direct_mir_backend_projection_owner.pgy";
import "target_projection_fact_owner.pgy";
import "../mir/artifact_transaction_owner.pgy";

enum DriverRung2DirectMirRequest {
    DirectMirC,
    DirectMirLlvm,
}

tobject DriverRung2ExecutionReceipt {
    schema: String;
    target_projection: String;
    final_path: String;
    atomic_visibility: Bool;
    crash_durable: Bool;
}

tobject DriverRung2ExecutionRejection {
    schema: String;
    target_projection: String;
    diagnostic: String;
}

enum DriverRung2ExecutionOutcome {
    DriverRung2Executed(DriverRung2ExecutionReceipt),
    DriverRung2Rejected(DriverRung2ExecutionRejection),
    DriverRung2ArtifactRejected(SelfMirArtifactFailure),
}

func DriverRung2ExecutionOwnerIdentity() -> String {
    return "driver-rung2-direct-mir-execution";
}

func DriverRung2ExecutionOutcomeSchema() -> String {
    return "pgy.driver-rung2-execution-outcome.v1";
}

func DriverRung2DirectMirRequestProjection(
    request: DriverRung2DirectMirRequest
) -> String {
    match request {
        case DirectMirC: return CompilerTargetCpuCProjection();
        case DirectMirLlvm: return CompilerTargetCpuLlvmProjection();
    }
}

func DriverRung2RejectedOutcome(
    target_projection: String,
    diagnostic: String
) -> DriverRung2ExecutionOutcome {
    return DriverRung2Rejected(DriverRung2ExecutionRejection(
        DriverRung2ExecutionOutcomeSchema(),
        target_projection,
        diagnostic
    ));
}

func DriverRung2ExecutionOutcomeReadyFor(
    outcome: DriverRung2ExecutionOutcome,
    expected_output_path: String,
    expected_target_projection: String
) -> Bool {
    match outcome {
        case DriverRung2Executed(receipt):
            return receipt.schema == DriverRung2ExecutionOutcomeSchema() &&
                receipt.target_projection == expected_target_projection &&
                CompilerTargetProjectionKnown(expected_target_projection) &&
                receipt.final_path == expected_output_path &&
                receipt.atomic_visibility && !receipt.crash_durable;
        case DriverRung2Rejected(rejection): return false;
        case DriverRung2ArtifactRejected(failure): return false;
    }
}

func DriverRung2ExecutionOutcomeDiagnostic(
    outcome: DriverRung2ExecutionOutcome,
    expected_output_path: String,
    expected_target_projection: String
) -> String {
    match outcome {
        case DriverRung2Executed(receipt):
            if DriverRung2ExecutionOutcomeReadyFor(
                outcome, expected_output_path, expected_target_projection
            ) { return ""; }
            return "direct MIR execution receipt is invalid";
        case DriverRung2Rejected(rejection):
            if rejection.schema != DriverRung2ExecutionOutcomeSchema() ||
                rejection.target_projection != expected_target_projection ||
                !CompilerTargetProjectionKnown(expected_target_projection) ||
                rejection.diagnostic == "" {
                return "direct MIR execution rejection payload is invalid";
            }
            return rejection.diagnostic;
        case DriverRung2ArtifactRejected(failure):
            return SelfMirArtifactFailureDiagnostic(
                failure, expected_output_path
            );
    }
}

subject DriverRung2Execution {
    let identity: String;

    action EmitDirectMir(
        self,
        mir_json_path: String,
        output_path: String,
        machine_declaration: SelfHostMachineLayerDeclaration,
        request: DriverRung2DirectMirRequest
    ) -> DriverRung2ExecutionOutcome
        within DriverRung2DirectMirZone
        authorized by self
        with caps io_read, io_write {
        let projection_name: String =
            DriverRung2DirectMirRequestProjection(request);
        if self.identity != DriverRung2ExecutionOwnerIdentity() {
            return DriverRung2RejectedOutcome(
                projection_name,
                "direct MIR execution subject identity is invalid"
            );
        }

        let target_projection: CompilerTargetProjectionFact =
            CompilerTargetProjectionFactFromOwner(projection_name);
        if !CompilerTargetProjectionFactReadyFor(
            target_projection, projection_name
        ) {
            return DriverRung2RejectedOutcome(
                projection_name,
                "direct MIR execution target admission failed"
            );
        }

        let artifact: CompilerEmissionArtifact =
            CompileMirJsonToDirectBackendVerified(
                mir_json_path, machine_declaration, target_projection
            );
        if !CompilerEmissionArtifactReady(artifact) ||
            artifact.target_capability_schema != target_projection.schema ||
            artifact.target_projection != target_projection.projection ||
            artifact.target_capability_fingerprint !=
                target_projection.target_capability_fingerprint {
            return DriverRung2RejectedOutcome(
                projection_name,
                "direct MIR execution artifact does not match the admitted target"
            );
        }

        let committed: SelfMirArtifactCommitOutcome =
            SelfMirArtifactCommitPayload(output_path, artifact.payload);
        match committed {
            case SelfMirArtifactCommitted(receipt):
                if !SelfMirArtifactReceiptReadyFor(receipt, output_path) {
                    return DriverRung2RejectedOutcome(
                        projection_name,
                        "direct MIR artifact receipt is invalid"
                    );
                }
                return DriverRung2Executed(DriverRung2ExecutionReceipt(
                    DriverRung2ExecutionOutcomeSchema(),
                    projection_name,
                    receipt.final_path,
                    receipt.atomic_visibility,
                    receipt.crash_durable
                ));
            case SelfMirArtifactRejected(failure):
                return DriverRung2ArtifactRejected(failure);
        }
    }
}

// This boundary owns authority/lifetime only; target selection, projection,
// emission, and validation stay with the owners called by EmitDirectMir.
public zone DriverRung2DirectMirZone {
    subject slot execution: DriverRung2Execution
    authority execution
}
