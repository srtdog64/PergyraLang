// Reachable MIR execution action boundary. Typed compiler owners retain
// semantic authority; this subject owns admission and atomic publication.

import "driver_rung2_execution_protocol_owner.pgy";
import "driver_rung2_owner.pgy";
import "direct_mir_backend_projection_owner.pgy";
import "../mir/artifact_transaction_owner.pgy";

func DriverRung2CommitArtifactForTarget(
    artifact: CompilerEmissionArtifact,
    target_projection: CompilerTargetProjectionFact,
    output_path: String
) -> DriverRung2ExecutionOutcome with caps io_write {
    if output_path == "" {
        return DriverRung2RejectedOutcome(
            target_projection.projection,
            "MIR artifact destination path is empty"
        );
    }
    if !CompilerEmissionArtifactReady(artifact) ||
        artifact.target_capability_schema != target_projection.schema ||
        artifact.target_projection != target_projection.projection ||
        artifact.target_capability_fingerprint !=
            target_projection.target_capability_fingerprint {
        return DriverRung2RejectedOutcome(
            target_projection.projection,
            "MIR execution artifact does not match the admitted target"
        );
    }
    let committed: SelfMirArtifactCommitOutcome =
        SelfMirArtifactCommitPayload(output_path, artifact.payload);
    match committed {
        case SelfMirArtifactCommitted(receipt):
            if !SelfMirArtifactReceiptReadyFor(receipt, output_path) {
                return DriverRung2RejectedOutcome(
                    target_projection.projection,
                    "MIR artifact receipt is invalid"
                );
            }
            return DriverRung2Executed(DriverRung2ExecutionReceipt(
                DriverRung2ExecutionOutcomeSchema(),
                target_projection.projection,
                receipt.final_path,
                receipt.atomic_visibility,
                receipt.crash_durable
            ));
        case SelfMirArtifactRejected(failure):
            return DriverRung2ArtifactRejected(failure);
    }
}

func DriverRung2CompileMirCForRequest(
    mir_json_path: String,
    machine_declaration: SelfHostMachineLayerDeclaration,
    request: DriverRung2MirCRequest
) -> CompilerEmissionArtifact with caps io_read {
    match request {
        case MirCVerified:
            return CompileMirJsonToCVerified(
                mir_json_path, machine_declaration
            );
        case MirCPressureObserved:
            return CompileMirJsonToCVerifiedObserved(
                mir_json_path, machine_declaration
            );
    }
}

subject DriverRung2Execution {
    let identity: String;

    action EmitDirectMir(
        self,
        mir_json_path: String,
        output_path: String,
        machine_declaration: SelfHostMachineLayerDeclaration,
        request: DriverRung2DirectMirRequest,
        observe_pressure: Bool
    ) -> DriverRung2ExecutionOutcome
        within DriverRung2DirectMirZone
        authorized by self
        with caps io_read, io_write {
        let projection_name: String =
            DriverRung2DirectMirRequestProjection(request);
        if self.identity != DriverRung2ExecutionOwnerIdentity() {
            return DriverRung2RejectedOutcome(
                projection_name,
                "direct MIR execution subject identity is invalid"
            );
        }
        if mir_json_path == "" {
            return DriverRung2RejectedOutcome(
                projection_name, "direct MIR input path is empty"
            );
        }
        let target_projection: CompilerTargetProjectionFact =
            CompilerTargetProjectionFactFromOwner(projection_name);
        if !CompilerTargetProjectionFactReadyFor(
            target_projection, projection_name
        ) {
            return DriverRung2RejectedOutcome(
                projection_name,
                "direct MIR execution target admission failed"
            );
        }
        let artifact: CompilerEmissionArtifact =
            CompileMirJsonToDirectBackendVerifiedObserved(
                mir_json_path, machine_declaration, target_projection,
                observe_pressure
            );
        return DriverRung2CommitArtifactForTarget(
            artifact, target_projection, output_path
        );
    }

    action PublishMirCArtifact(
        self,
        mir_json_path: String,
        output_path: String,
        machine_declaration: SelfHostMachineLayerDeclaration,
        request: DriverRung2MirCRequest
    ) -> DriverRung2ExecutionOutcome
        within DriverRung2DirectMirZone
        authorized by self
        with caps io_read, io_write {
        let projection_name: String = CompilerTargetCpuCProjection();
        if self.identity != DriverRung2ExecutionOwnerIdentity() {
            return DriverRung2RejectedOutcome(
                projection_name, "MIR C execution subject identity is invalid"
            );
        }
        if mir_json_path == "" {
            return DriverRung2RejectedOutcome(
                projection_name, "MIR C input path is empty"
            );
        }
        let target_projection: CompilerTargetProjectionFact =
            CompilerTargetProjectionFactFromOwner(projection_name);
        if !CompilerTargetProjectionFactReadyFor(
            target_projection, projection_name
        ) {
            return DriverRung2RejectedOutcome(
                projection_name, "MIR C execution target admission failed"
            );
        }
        let artifact: CompilerEmissionArtifact =
            DriverRung2CompileMirCForRequest(
                mir_json_path, machine_declaration, request
            );
        return DriverRung2CommitArtifactForTarget(
            artifact, target_projection, output_path
        );
    }
}

// Both actions consume admitted MIR and publish a backend artifact under one
// authority/lifetime boundary; CLI mode spelling does not create another zone.
public zone DriverRung2DirectMirZone {
    subject slot execution: DriverRung2Execution
    authority execution
}
