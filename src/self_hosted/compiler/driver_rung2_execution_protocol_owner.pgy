// Typed request/outcome protocol shared by the production-reachable MIR
// execution actions. It owns no compilation, artifact write, or world.

import "target_projection_fact_owner.pgy";
import "driver_pipeline_owner.pgy";
import "../mir/artifact_transaction_owner.pgy";

enum DriverRung2DirectMirRequest {
    DirectMirC,
    DirectMirLlvm,
}

enum DriverRung2MirCRequest {
    MirCVerified,
    MirCPressureObserved,
}

tobject DriverRung2ExecutionReceipt {
    schema: String;
    target_projection: String;
    final_path: String;
    atomic_visibility: Bool;
    crash_durable: Bool;
}

tobject DriverRung2ExecutionRejection {
    schema: String;
    target_projection: String;
    diagnostic: String;
}

enum DriverRung2ExecutionOutcome {
    DriverRung2Executed(DriverRung2ExecutionReceipt),
    DriverRung2Rejected(DriverRung2ExecutionRejection),
    DriverRung2ArtifactRejected(SelfMirArtifactFailure),
}

func DriverRung2ExecutionOwnerIdentity() -> String {
    return "driver-rung2-direct-mir-execution";
}

func DriverRung2ExecutionOutcomeSchema() -> String {
    return "pgy.driver-rung2-execution-outcome.v1";
}

func DriverRung2EmissionArtifactReadyForTarget(
    artifact: CompilerEmissionArtifact,
    ref target_projection: CompilerTargetProjectionFact
) -> Bool {
    return CompilerTargetProjectionFactReadyFor(
        target_projection, target_projection.projection
    ) && CompilerEmissionArtifactReady(artifact) &&
        artifact.target_capability_schema == target_projection.schema &&
        artifact.target_projection == target_projection.projection &&
        artifact.target_capability_fingerprint ==
            target_projection.target_capability_fingerprint;
}

func DriverRung2DirectMirRequestProjection(
    request: DriverRung2DirectMirRequest
) -> String {
    match request {
        case DirectMirC: return CompilerTargetCpuCProjection();
        case DirectMirLlvm: return CompilerTargetCpuLlvmProjection();
    }
}

func DriverRung2RejectedOutcome(
    target_projection: String,
    diagnostic: String
) -> DriverRung2ExecutionOutcome {
    return DriverRung2Rejected(DriverRung2ExecutionRejection(
        DriverRung2ExecutionOutcomeSchema(),
        target_projection,
        diagnostic
    ));
}

func DriverRung2ExecutionOutcomeReadyFor(
    outcome: DriverRung2ExecutionOutcome,
    expected_output_path: String,
    expected_target_projection: String
) -> Bool {
    match outcome {
        case DriverRung2Executed(receipt):
            return receipt.schema == DriverRung2ExecutionOutcomeSchema() &&
                receipt.target_projection == expected_target_projection &&
                CompilerTargetProjectionKnown(expected_target_projection) &&
                receipt.final_path == expected_output_path &&
                receipt.atomic_visibility && !receipt.crash_durable;
        case DriverRung2Rejected(rejection): return false;
        case DriverRung2ArtifactRejected(failure): return false;
    }
}

func DriverRung2ExecutionOutcomeDiagnostic(
    outcome: DriverRung2ExecutionOutcome,
    expected_output_path: String,
    expected_target_projection: String
) -> String {
    match outcome {
        case DriverRung2Executed(receipt):
            if DriverRung2ExecutionOutcomeReadyFor(
                outcome, expected_output_path, expected_target_projection
            ) { return ""; }
            return "MIR execution receipt is invalid";
        case DriverRung2Rejected(rejection):
            if rejection.schema != DriverRung2ExecutionOutcomeSchema() ||
                rejection.target_projection != expected_target_projection ||
                !CompilerTargetProjectionKnown(expected_target_projection) ||
                rejection.diagnostic == "" {
                return "MIR execution rejection payload is invalid";
            }
            return rejection.diagnostic;
        case DriverRung2ArtifactRejected(failure):
            return SelfMirArtifactFailureDiagnostic(
                failure, expected_output_path
            );
    }
}
