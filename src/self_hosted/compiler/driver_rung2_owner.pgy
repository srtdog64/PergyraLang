// DRV-2 artifact-body semantic driver owner.
//
// This hard rung computes initializer, iteration, assignment, expression-use,
// call, return, and condition evidence. Source and MIR-JSON inputs converge on
// the same artifact verifier and codegen owner; neither path may fall back to
// source scanning.

import "driver_pipeline_owner.pgy";
import "../semantic/ast_initializer_type_fact_owner.pgy";
import "../semantic/ast_assignment_type_fact_owner.pgy";
import "../semantic/ast_iteration_type_fact_owner.pgy";
import "../semantic/ast_statement_type_fact_owner.pgy";
import "../semantic/ast_statement_type_query_owner.pgy";
import "../semantic/ast_body_verdict_owner.pgy";
import "../semantic/ast_body_type_bundle_owner.pgy";
import "../semantic/ast_expression_surface_contract_owner.pgy";
import "../semantic/ast_expression_graph_bridge_contract_owner.pgy";
import "../semantic/ast_expression_call_target_contract_owner.pgy";
import "../mir_lower/mir_fact_graph_contract_owner.pgy";
import "../mir_lower/mir_json_input_owner.pgy";
import "../mir_lower/program_lower.pgy";
import "../mir_lower/expression_graph_fact_owner.pgy";
import "../mir/artifact_lower_owner.pgy";
import "../mir/json_projection_owner.pgy";

func CompilerDriverRung2ReadinessError() -> String {
    if !CompilerDriverPipelineReady() { return "driver_pipeline"; }
    if !SemanticBuiltinSignatureContractReady() { return "builtin_signature"; }
    if !SemanticCallableResolutionContractReady() { return "callable_resolution"; }
    if !SemanticExpressionNormalizationContractReady() { return "expression_normalization"; }
    if !SemanticAstExpressionEnvironmentContractReady() { return "expression_environment"; }
    if !SemanticAstInitializerTypeFactsContractReady() { return "initializer_type_facts"; }
    if !SemanticAstIterationTypeFactsContractReady() { return "iteration_type_facts"; }
    if !SemanticAstAssignmentFactsContractReady() { return "assignment_facts"; }
    if !SemanticAstAssignmentTypeFactsContractReady() { return "assignment_type_facts"; }
    if !SemanticAstStatementFactsContractReady() { return "statement_facts"; }
    if !SemanticAstExpressionVerdictContractReady() { return "expression_verdict"; }
    if !SemanticExpressionGraphIntrinsicTypeContractReady() { return "graph_intrinsic_type"; }
    if !SemanticArrayTypeShapeContractReady() { return "array_type_shape"; }
    if !SemanticExpressionGraphScalarTypeContractReady() { return "graph_scalar_type"; }
    if !SemanticExpressionGraphWrapperValueContractReady() { return "graph_wrapper_value"; }
    if !SemanticExpressionGraphCollectionMutationContractReady() { return "graph_collection_mutation"; }
    if !SemanticExpressionGraphFieldTypeContractReady() { return "graph_field_type"; }
    if !SemanticAstExpressionTypedBindingContractReady() { return "expression_typed_binding"; }
    if !SemanticAstStatementTypeFactsContractReady() { return "statement_type_facts"; }
    if !SemanticAstStatementTypeQueryContractReady() { return "statement_type_query"; }
    if !SemanticAstBodyTypeBundleContractReady() {
        return Concat(
            "body_type_bundle:", SemanticAstBodyTypeBundleContractError()
        );
    }
    if !ParserExpressionGraphContractReady() { return "parser_expression_graph"; }
    if !ParserExpressionPrecedenceGraphContractReady() { return "parser_precedence_graph"; }
    if !ParserExpressionUnaryGraphContractReady() { return "parser_unary_graph"; }
    if !ParserExpressionPipeGraphContractReady() { return "parser_pipe_graph"; }
    if !ParserExpressionPostfixGraphContractReady() { return "parser_postfix_graph"; }
    if !ParserExpressionTryGraphContractReady() { return "parser_try_graph"; }
    if !ParserExpressionArrayLiteralGraphContractReady() { return "parser_array_literal_graph"; }
    if !ParserExpressionStructLiteralGraphContractReady() { return "parser_struct_literal_graph"; }
    if !SemanticExpressionGraphParserBridgeContractReady() { return "graph_parser_bridge"; }
    if !SemanticExpressionGraphCompactBridgeTryContractReady() { return "graph_compact_try_bridge"; }
    if !ParserExpressionCallGraphContractReady() { return "parser_call_graph"; }
    if !ParserExpressionExplicitGenericCallGraphContractReady() { return "parser_generic_call_graph"; }
    if !ParserExpressionNamedSingleCallArgumentContractReady() { return "parser_named_single_arg"; }
    if !ParserExpressionNamedCallArgumentAtContractReady() { return "parser_named_arg"; }
    if !ParserExpressionDirectCallCalleeContractReady() { return "parser_direct_callee"; }
    if !SemanticExpressionCallTargetFactContractReady() { return "call_target_fact"; }
    if !SelfMirExpressionGraphRowsContractReady() { return "mir_expression_graph_rows"; }
    if !SelfMirIndexedAssignmentUseContractReady() { return "mir_indexed_assignment"; }
    if !MirFactGraphPayloadContractReady() { return "mir_fact_graph_payload"; }
    if TypedAstNominalSubkindName(TypedAstNominalSubkindClass()) != "class" {
        return "typed_ast_nominal_subkind";
    }
    return "";
}

func CompilerDriverRung2Ready() -> Bool {
    return CompilerDriverRung2ReadinessError() == "";
}

func DriverRung2FixtureRows() -> Array<String> {
    return [
        "valid_compound_local|ok",
        "valid_call_int|ok",
        "valid_option_none_literal|ok",
        "valid_array_builtins|ok",
        "valid_let_mut_reassign|ok",
        "valid_outer_block_assign|ok",
        "bad_let_type|error",
        "bad_inner_let_type|error",
        "bad_call_assign|error",
        "bad_assign_type|error",
        "bad_undefined_assign_lhs|error",
        "bad_return_type|error",
        "bad_condition_not_bool|error",
        "bad_undefined_return|error",
        "bad_undefined_assign|error",
        "bad_undefined_let|error",
        "bad_arity_too_few|error",
        "valid_for_loop|ok",
        "bad_for_undefined_iter|error",
        "bad_for_body|error"
    ];
}

func DriverRung2ExpectedFixtureCount() -> Int {
    return 20;
}

