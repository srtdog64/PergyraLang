import "driver_rung2_nested_intent_c_substitution_owner.pgy";
struct DriverRung2VerifiedFacts {
    analysis: SemanticAstArtifactAnalysis;
    body_types: SemanticAstBodyTypeBundle;
    body_type_admission: SemanticAstBodyTypeBundleAdmissionReceipt;
}
struct DriverRung2MirProjection {
    facts: SelfMirProgramFacts;
    analysis: SemanticAstArtifactAnalysis;
}
func VerifyArtifactForDriverRung2FromAdmittedAnalysisObservedWithIdentityPolicy(
    artifact: AstTreeArtifact, semantic_analysis: SemanticAstArtifactAnalysis,
    observe_pressure: Bool, require_carried_expression_identities: Bool
) -> DriverRung2VerifiedFacts {
    if !semantic_analysis.verdict.ok {
        Log(semantic_analysis.verdict.diagnostic_message);
        Exit(1);
    }
    if !AstTreeArtifactReady(artifact) {
        Die("driver rung-2 AST artifact is missing or invalid");
    }
    if !SemanticAstArtifactAdmissionReady(
        artifact, semantic_analysis, true
    ) {
        Die("driver rung-2 semantic admission receipt is missing or stale");
    }
    DriverRung2PressureStage(observe_pressure, "body-types:start");
    let body_types: SemanticAstBodyTypeBundle =
        SemanticAstBodyTypeBundleFromAdmittedAnalysisObservedWithIdentityPolicy(
            artifact, semantic_analysis, observe_pressure,
            require_carried_expression_identities
        );
    DriverRung2PressureStage(observe_pressure, "body-types:done");
    let body_type_admission: SemanticAstBodyTypeBundleAdmissionReceipt =
        SemanticAstBodyTypeBundleAdmissionReceiptFromFacts(
            artifact, semantic_analysis, body_types
        );
    if !SemanticAstBodyTypeBundleAdmissionReceiptReadyFor(
        body_type_admission, artifact, semantic_analysis, body_types
    ) {
        Log(body_types.verdict.diagnostic_message);
        Exit(1);
    }
    DriverRung2PressureStage(observe_pressure, "body-types:ready");
    return DriverRung2VerifiedFacts(
        semantic_analysis, body_types, body_type_admission
    );
}
func VerifyArtifactForDriverRung2FromAdmittedAnalysisObserved(
    artifact: AstTreeArtifact, semantic_analysis: SemanticAstArtifactAnalysis,
    observe_pressure: Bool
) -> DriverRung2VerifiedFacts {
    return VerifyArtifactForDriverRung2FromAdmittedAnalysisObservedWithIdentityPolicy(
        artifact, semantic_analysis, observe_pressure, false);
}
func VerifyArtifactAnalysisForDriverRung2Observed(
    artifact: AstTreeArtifact, semantic_analysis: SemanticAstArtifactAnalysis,
    observe_pressure: Bool
) -> DriverRung2VerifiedFacts {
    if !SemanticAstArtifactAnalysisMatches(artifact, semantic_analysis, true) {
        Die("driver rung-2 semantic analysis deep proof failed");
    }
    return VerifyArtifactForDriverRung2FromAdmittedAnalysisObserved(artifact, semantic_analysis, observe_pressure);
}
func VerifyArtifactAnalysisForDriverRung2(
    artifact: AstTreeArtifact, semantic_analysis: SemanticAstArtifactAnalysis
) -> DriverRung2VerifiedFacts {
    return VerifyArtifactAnalysisForDriverRung2Observed(artifact, semantic_analysis, false);
}
func VerifyArtifactForMirProduction(artifact: AstTreeArtifact) -> DriverRung2VerifiedFacts {
    return VerifyArtifactForDriverRung2FromAdmittedAnalysisObserved(
        artifact, SemanticAstArtifactAnalyzeTyped(artifact, true), false
    );
}
func DriverRung2PressureStage(enabled: Bool, stage: String) -> Void {
    if enabled {
        Log(Concat("[driver-pressure-stage] ", stage));
    }
}
func DriverRung2MirProjectionFromVerifiedFactsObserved(
    own artifact: AstTreeArtifact,
    verified: DriverRung2VerifiedFacts,
    machine_declaration: SelfHostMachineLayerDeclaration,
    observe_pressure: Bool
) -> DriverRung2MirProjection {
    if !SemanticAstBodyTypeBundleAdmissionReceiptReadyFor(
        verified.body_type_admission, artifact,
        verified.analysis, verified.body_types
    ) {
        Die("driver rung-2 verified body facts are missing or stale");
    }
    DriverRung2PressureStage(observe_pressure, "mir-facts:start");
    let mir_facts: SelfMirProgramFacts = SelfMirProgramFactsBeforeCanonicalIdsObserved(
        artifact, verified.analysis, verified.body_types.initializer_types,
        verified.body_types.iteration_types,
        verified.body_types.assignment_types,
        verified.body_types.statement_types,
        verified.body_types.generic_specializations,
        machine_declaration, observe_pressure
    );
    let terminal_body_types: SemanticAstBodyTypeBundle = verified.body_types;
    SelfMirBodyTypeBundleStorageRetireAfterProgramFacts(terminal_body_types);
    SelfMirArtifactPressureStage(observe_pressure, "canonical-ids:start");
    mir_facts = SelfMirCanonicalInstructionIds(mir_facts);
    SelfMirArtifactPressureStage(observe_pressure, "canonical-ids:done");
    let validation_error: String = SelfMirProgramFactsValidationErrorObserved(
        mir_facts, observe_pressure
    );
    if validation_error != "" {
        Log(validation_error);
        Exit(1);
    }
    DriverRung2PressureStage(observe_pressure, "mir-facts:done");
    return DriverRung2MirProjection(mir_facts, verified.analysis);
}

func DriverRung2MirProjectionFromAdmittedAnalysisObserved(
    own artifact: AstTreeArtifact, analysis: SemanticAstArtifactAnalysis,
    machine_declaration: SelfHostMachineLayerDeclaration, observe_pressure: Bool
) -> DriverRung2MirProjection {
    DriverRung2PressureStage(observe_pressure, "verify:start");
    let verified: DriverRung2VerifiedFacts =
        VerifyArtifactForDriverRung2FromAdmittedAnalysisObserved(
            artifact, analysis, observe_pressure
        );
    DriverRung2PressureStage(observe_pressure, "verify:done");
    return DriverRung2MirProjectionFromVerifiedFactsObserved(
        artifact, verified, machine_declaration, observe_pressure
    );
}

func DriverRung2MirProjectionFromAnalysisObserved(
    own artifact: AstTreeArtifact, analysis: SemanticAstArtifactAnalysis,
    machine_declaration: SelfHostMachineLayerDeclaration, observe_pressure: Bool
) -> DriverRung2MirProjection {
    if !SemanticAstArtifactAnalysisMatches(artifact, analysis, true) {
        Die("driver rung-2 semantic analysis deep proof failed");
    }
    return DriverRung2MirProjectionFromAdmittedAnalysisObserved(artifact, analysis, machine_declaration, observe_pressure);
}

func DriverRung2MirProjectionRelease(
    inout projection: DriverRung2MirProjection
) -> Void {
    let terminal_analysis: SemanticAstArtifactAnalysis = projection.analysis;
    let function_tables: SemanticAstExpressionFunctionTableFacts =
        terminal_analysis.function_tables;
    SemanticAstExpressionFunctionTableFactsRelease(function_tables);
    terminal_analysis.function_tables = function_tables;
    projection.analysis = terminal_analysis;
}

func DriverRung2MirProjectionJson(inout projection: DriverRung2MirProjection,
                                  observe_pressure: Bool) -> String {
    DriverRung2PressureStage(observe_pressure, "json:start");
    let json: String = SelfMirProgramJson(projection.facts);
    if json == "" { Log("self-host MIR JSON projection failed closed"); Exit(1); }
    DriverRung2PressureStage(observe_pressure, "json:done");
    DriverRung2MirProjectionRelease(projection);
    return json;
}

func CompileArtifactAnalysisToMirJsonVerifiedObserved(
    own artifact: AstTreeArtifact,
    analysis: SemanticAstArtifactAnalysis,
    machine_declaration: SelfHostMachineLayerDeclaration,
    observe_pressure: Bool
) -> String {
    let projection: DriverRung2MirProjection =
        DriverRung2MirProjectionFromAnalysisObserved(
            artifact, analysis, machine_declaration, observe_pressure
        );
    return DriverRung2MirProjectionJson(projection, observe_pressure);
}

func CompileArtifactAnalysisToMirJsonVerified(
    own artifact: AstTreeArtifact,
    analysis: SemanticAstArtifactAnalysis,
    machine_declaration: SelfHostMachineLayerDeclaration
) -> String {
    return CompileArtifactAnalysisToMirJsonVerifiedObserved(
        artifact, analysis, machine_declaration, false
    );
}

func CompileArtifactToMirJsonVerified(
    own artifact: AstTreeArtifact,
    machine_declaration: SelfHostMachineLayerDeclaration
) -> String {
    let analysis: SemanticAstArtifactAnalysis =
        SemanticAstArtifactAnalyzeTyped(artifact, true);
    let projection: DriverRung2MirProjection =
        DriverRung2MirProjectionFromAdmittedAnalysisObserved(
            artifact, analysis, machine_declaration, false
        );
    return DriverRung2MirProjectionJson(projection, false);
}

func CompileSourceToMirJsonVerified(
    source_path: String,
    machine_declaration: SelfHostMachineLayerDeclaration
) -> String with caps io_read {
    let artifact: AstTreeArtifact = CompileSourceToAstArtifact(source_path);
    return CompileArtifactToMirJsonVerified(
        artifact, machine_declaration
    );
}

func CompileSourceToMirJsonPressureObserved(
    source_path: String,
    machine_declaration: SelfHostMachineLayerDeclaration
) -> String with caps io_read {
    DriverRung2PressureStage(true, "ast:start");
    let artifact: AstTreeArtifact = CompileSourceToAstArtifact(source_path);
    DriverRung2PressureStage(true, "ast:done");
    DriverRung2PressureStage(true, "semantic:start");
    let analysis: SemanticAstArtifactAnalysis =
        SemanticAstArtifactAnalyzeTyped(artifact, true);
    DriverRung2PressureStage(true, "semantic:done");
    let projection: DriverRung2MirProjection =
        DriverRung2MirProjectionFromAdmittedAnalysisObserved(
            artifact, analysis, machine_declaration, true
        );
    return DriverRung2MirProjectionJson(projection, true);
}

func CompileMachineAdmittedMirJsonToCForTargetVerifiedObserved(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    target_projection: CompilerTargetProjectionFact,
    observe_pressure: Bool,
    retire_owned_source_json: Bool
) -> CompilerEmissionArtifact {
    let nested_c: Option<CompilerEmissionArtifact> =
        DriverRung2NestedIntentCSubstitutionIfClaimed(
            admitted, target_projection, retire_owned_source_json);
    if IsSome(nested_c) { return UnwrapOption(nested_c); }
    let json: String = admitted.routines.source_json;
    let topology_receipt: MirDomainTopologyGraphPlanConsumptionReceipt =
        MirDomainTopologyGraphPlanConsumptionFromAdmitted(admitted);
    DriverRung2PressureStage(
        observe_pressure, "consumer:mir-to-ast:start"
    );
    let tree_emission: MirProgramTreeEmission =
        DriverRung2IntentTreeEmissionOrDie(admitted, observe_pressure);
    let artifact: AstTreeArtifact = CanonicalMirIdentityArtifactFromTreeTextOrDie(
        tree_emission.text, tree_emission.source_module_paths, admitted);
    DriverRung2PressureStage(
        observe_pressure, "consumer:mir-to-ast:done"
    );
    DriverRung2PressureStage(
        observe_pressure, "consumer:expression-graph:start"
    );
    let graph: SemanticExpressionGraphFacts =
        MirExpressionGraphFactsForArtifactObserved(
            admitted.routines, artifact, tree_emission.expression_order,
            admitted.intent_execution_plan, observe_pressure
        );
    if !graph.ok {
        Die("MIR instruction expression graph is missing or invalid");
    }
    DriverRung2PressureStage(
        observe_pressure, "consumer:expression-graph:done"
    );
    DriverRung2PressureStage(
        observe_pressure, "consumer:semantic:start"
    );
    let analysis: SemanticAstArtifactAnalysis =
        SemanticAstArtifactAnalyzeWithExpressionGraph(
            artifact, true, graph
        );
    DriverRung2PressureStage(
        observe_pressure, "consumer:semantic:done"
    );
    DriverRung2PressureStage(
        observe_pressure, "consumer:verify:start"
    );
    let verified: DriverRung2VerifiedFacts =
        VerifyArtifactForDriverRung2FromAdmittedAnalysisObservedWithIdentityPolicy(
            artifact, analysis, observe_pressure, true
        );
    DriverRung2PressureStage(
        observe_pressure, "consumer:verify:done"
    );
    DriverRung2PressureStage(
        observe_pressure, "consumer:assignment-binding:start"
    );
    if !MirAssignmentBindingModesMatchSemanticFacts(
        admitted.routines, tree_emission.expression_order,
        verified.body_types.assignment_types
    ) {
        Die("MIR assignment binding-mode fact is missing or invalid");
    }
    DriverRung2PressureStage(
        observe_pressure, "consumer:assignment-binding:done"
    );
    let semantic_body_types: SemanticAstBodyTypeBundle =
        verified.body_types;
    DriverRung2PressureStage(
        observe_pressure, "consumer:generic-specialization:start"
    );
    let mir_generic_specializations: CodegenGenericSpecializationFacts =
        MirCodegenGenericSpecializationFacts(
            json, verified.analysis.signatures,
            semantic_body_types.generic_specializations,
            verified.analysis.expression_surfaces
        );
    if !mir_generic_specializations.ok {
        Die(Concat(
            "MIR generic specialization facts are incomplete: ",
            mir_generic_specializations.diagnostic_message
        ));
    }
    DriverRung2PressureStage(observe_pressure, "consumer:generic-specialization:done");
    // Source intent admission inside the codegen view is the last legitimate
    // consumer of the owned callable table strings.
    let codegen_analysis: SemanticAstArtifactAnalysis = verified.analysis;
    DriverRung2PressureStage(observe_pressure, "consumer:codegen-view:start");
    let routine_identity_epoch: CanonicalMirRoutineIdentityEpoch =
        CanonicalMirRoutineIdentityEpochFromArtifact(admitted.routines,
            artifact, codegen_analysis.signatures);
    if !routine_identity_epoch.ok { Die("canonical MIR routine identity epoch remap is invalid"); }
    let intent_expression_occurrences:
        MirExpressionSemanticOccurrenceIndex =
            DriverRung2IntentExpressionOccurrencesOrDie(
                artifact, tree_emission.expression_order,
                codegen_analysis.expression_surfaces
            );
    let codegen_view: CodegenAdmittedCView = CodegenAdmittedCViewFromFactsOrDie(
        admitted, codegen_analysis, artifact, semantic_body_types,
        mir_generic_specializations, verified.body_type_admission,
        intent_expression_occurrences,
        routine_identity_epoch.source_syntax_ids, observe_pressure);
    DriverRung2PressureStage(observe_pressure, "consumer:codegen-view:done");
    let expired_function_tables: SemanticAstExpressionFunctionTableFacts =
        codegen_analysis.function_tables;
    SemanticAstExpressionFunctionTableFactsRelease(expired_function_tables);
    codegen_analysis.function_tables = expired_function_tables;
    DriverRung2PressureStage(observe_pressure, "consumer:function-tables:released");
    let codegen_body_types: CodegenSemanticBodyTypeFacts = codegen_view.body_types;
    let codegen_intent_execution: CodegenIntentExecutionView = codegen_view.intent_execution;
    if retire_owned_source_json {
        MirJsonOwnedInputRelease(json);
        DriverRung2PressureStage(
            observe_pressure, "consumer:owned-input:released"
        );
    }
    DriverRung2PressureStage(
        observe_pressure, "consumer:c-emission:start"
    );
    let emission: CompilerEmissionArtifact = CompilerEmissionArtifact(
        "emitted-c",
        MirDomainTopologyGraphPlanAttachToC(
            topology_receipt, admitted.domain_topology_plan,
            GenerateCFromVerifiedSemanticArtifact(
                artifact, codegen_analysis, codegen_body_types,
                codegen_view.receivers,
                codegen_view.domain_runtime, codegen_intent_execution,
                codegen_view.intent_policy,
                admitted.machine_declaration, target_projection,
                observe_pressure
            )
        ),
        target_projection.schema,
        target_projection.projection,
        target_projection.target_capability_fingerprint
    );
    if !CompilerEmissionArtifactReady(emission) {
        Die("self-host C emission artifact target fingerprint is missing or invalid");
    }
    DriverRung2PressureStage(
        observe_pressure, "consumer:c-emission:done"
    );
    return emission;
}

func CompileMirJsonTextToCForTargetVerifiedObserved(
    json: String,
    machine_declaration: SelfHostMachineLayerDeclaration,
    target_projection: CompilerTargetProjectionFact,
    observe_pressure: Bool
) -> CompilerEmissionArtifact {
    DriverRung2PressureStage(
        observe_pressure, "consumer:machine-layer-admission:start"
    );
    let admitted_opt: Option<MirMachineLayerAdmittedJsonInput> =
        MirMachineLayerAdmitJsonInput(json, machine_declaration);
    if !IsSome(admitted_opt) {
        Die("self-host C emission rejected invalid machine-layer facts");
    }
    DriverRung2PressureStage(
        observe_pressure, "consumer:machine-layer-admission:done"
    );
    let admitted: MirMachineLayerAdmittedJsonInput =
        UnwrapOption(admitted_opt);
    return CompileMachineAdmittedMirJsonToCForTargetVerifiedObserved(
        admitted, target_projection, observe_pressure, false
    );
}

func CompileMirJsonTextToCForTargetVerified(
    json: String,
    machine_declaration: SelfHostMachineLayerDeclaration,
    target_projection: CompilerTargetProjectionFact
) -> CompilerEmissionArtifact {
    return CompileMirJsonTextToCForTargetVerifiedObserved(
        json, machine_declaration, target_projection, false
    );
}

func CompileMachineAdmittedMirJsonToCVerifiedObserved(
    ref admitted: MirMachineLayerAdmittedJsonInput,
    observe_pressure: Bool,
    retire_owned_source_json: Bool
) -> CompilerEmissionArtifact {
    return CompileMachineAdmittedMirJsonToCForTargetVerifiedObserved(
        admitted,
        CompilerTargetProjectionFactFromOwner(
            CompilerTargetCpuCProjection()
        ),
        observe_pressure,
        retire_owned_source_json
    );
}

func CompileMirJsonTextToCVerified(
    json: String,
    machine_declaration: SelfHostMachineLayerDeclaration
) -> CompilerEmissionArtifact {
    return CompileMirJsonTextToCForTargetVerified(
        json, machine_declaration,
        CompilerTargetProjectionFactFromOwner(
            CompilerTargetCpuCProjection()
        )
    );
}

func CompileSourceToCVerified(
    source_path: String,
    machine_declaration: SelfHostMachineLayerDeclaration
) -> CompilerEmissionArtifact with caps io_read {
    let json: String = CompileSourceToMirJsonVerified(
        source_path, machine_declaration
    );
    return CompileMirJsonTextToCVerified(json, machine_declaration);
}

func CompileMirJsonToCVerified(
    mir_json_path: String,
    machine_declaration: SelfHostMachineLayerDeclaration
) -> CompilerEmissionArtifact with caps io_read {
    let admitted: MirMachineLayerAdmittedJsonInput =
        MirJsonReadMachineAdmittedInput(
            mir_json_path, machine_declaration
        );
    return CompileMachineAdmittedMirJsonToCVerifiedObserved(
        admitted, false, true
    );
}

func CompileMirJsonToCVerifiedObserved(
    mir_json_path: String,
    machine_declaration: SelfHostMachineLayerDeclaration
) -> CompilerEmissionArtifact with caps io_read {
    DriverRung2PressureStage(true, "consumer:input:start");
    let admitted: MirMachineLayerAdmittedJsonInput =
        MirJsonReadMachineAdmittedInputObserved(
            mir_json_path, machine_declaration, true
        );
    DriverRung2PressureStage(true, "consumer:input:done");
    return CompileMachineAdmittedMirJsonToCVerifiedObserved(
        admitted, true, true
    );
}
