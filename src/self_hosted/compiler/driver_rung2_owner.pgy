// DRV-2 artifact-body semantic driver owner.
//
// This hard rung computes initializer, iteration, assignment, expression-use,
// call, return, and condition evidence. Source and MIR-JSON inputs converge on
// the same artifact verifier and codegen owner; neither path may fall back to
// source scanning.

import "driver_pipeline_owner.pgy";
import "../semantic/ast_initializer_type_fact_owner.pgy";
import "../semantic/ast_assignment_type_fact_owner.pgy";
import "../semantic/ast_iteration_type_fact_owner.pgy";
import "../semantic/ast_statement_type_fact_owner.pgy";
import "../semantic/ast_body_verdict_owner.pgy";
import "../semantic/ast_expression_surface_contract_owner.pgy";
import "../mir_lower/mir_fact_graph_contract_owner.pgy";
import "../mir_lower/mir_json_input_owner.pgy";
import "../mir_lower/program_lower.pgy";
import "../mir_lower/expression_graph_fact_owner.pgy";
import "../mir/artifact_lower_owner.pgy";
import "../mir/json_projection_owner.pgy";

func CompilerDriverRung2Ready() -> Bool {
    return CompilerDriverPipelineReady() &&
        SemanticBuiltinSignatureContractReady() &&
        SemanticCallableResolutionContractReady() &&
        SemanticExpressionNormalizationContractReady() &&
        SemanticAstExpressionEnvironmentContractReady() &&
        SemanticAstInitializerTypeFactsContractReady() &&
        SemanticAstIterationTypeFactsContractReady() &&
        SemanticAstAssignmentFactsContractReady() &&
        SemanticAstAssignmentTypeFactsContractReady() &&
        SemanticAstStatementFactsContractReady() &&
        SemanticAstExpressionVerdictContractReady() &&
        SemanticAstExpressionTypedBindingContractReady() &&
        SemanticAstStatementTypeFactsContractReady() &&
        SemanticAstBodyVerdictContractReady() &&
        ParserExpressionGraphContractReady() &&
        ParserExpressionPrecedenceGraphContractReady() &&
        ParserExpressionUnaryGraphContractReady() &&
        ParserExpressionPipeGraphContractReady() &&
        ParserExpressionPostfixGraphContractReady() &&
        ParserExpressionTryGraphContractReady() &&
        SemanticExpressionGraphCompactBridgeTryContractReady() &&
        ParserExpressionCallGraphContractReady() &&
        ParserExpressionNamedSingleCallArgumentContractReady() &&
        ParserExpressionDirectCallCalleeContractReady() &&
        SelfMirExpressionGraphRowsContractReady() &&
        SelfMirIndexedAssignmentUseContractReady() &&
        MirFactGraphPayloadContractReady() &&
        TypedAstNominalSubkindName(TypedAstNominalSubkindClass()) == "class";
}

func DriverRung2FixtureRows() -> Array<String> {
    return [
        "valid_compound_local|ok",
        "valid_call_int|ok",
        "valid_option_none_literal|ok",
        "valid_array_builtins|ok",
        "valid_let_mut_reassign|ok",
        "valid_outer_block_assign|ok",
        "bad_let_type|error",
        "bad_inner_let_type|error",
        "bad_call_assign|error",
        "bad_assign_type|error",
        "bad_undefined_assign_lhs|error",
        "bad_return_type|error",
        "bad_condition_not_bool|error",
        "bad_undefined_return|error",
        "bad_undefined_assign|error",
        "bad_undefined_let|error",
        "bad_arity_too_few|error",
        "valid_for_loop|ok",
        "bad_for_undefined_iter|error",
        "bad_for_body|error"
    ];
}

func DriverRung2ExpectedFixtureCount() -> Int {
    return 20;
}

func DriverRung2MirFixtureRows() -> Array<String> {
    return [
        "src/self_hosted/mir_lower/fixture/let_log.pgy",
        "src/self_hosted/mir_lower/fixture/forloop.pgy",
        "src/self_hosted/mir_lower/fixture/nested_loop_cfg.pgy",
        "src/self_hosted/mir_lower/fixture/indexed_assignment.pgy",
        "src/self_hosted/mir_lower/fixture/enum_return.pgy",
        "src/self_hosted/mir_lower/fixture/if_else_assign.pgy",
        "src/self_hosted/mir_lower/fixture/param_carriage.pgy",
        "src/self_hosted/mir_lower/fixture/pipe_carriage.pgy",
        "src/self_hosted/codegen/fixture/option_try.pgy",
        "src/self_hosted/codegen/fixture/func_recursive.pgy",
        "src/self_hosted/mir_lower/fixture/class_method.pgy",
        "src/self_hosted/mir_lower/fixture/nested_member_access.pgy",
        "src/self_hosted/codegen/fixture/for_each.pgy",
        "src/self_hosted/semantic/fixture/valid_array_builtins.pgy",
        "src/self_hosted/semantic/fixture/valid_option_none_literal.pgy",
        "src/self_hosted/semantic/fixture/valid_call_int.pgy"
    ];
}

func DriverRung2ExpectedMirFixtureCount() -> Int {
    return 16;
}

func EmitDriverRung2FixtureManifest() -> Void {
    let rows: Array<String> = DriverRung2FixtureRows();
    if ArrayLength(rows) != DriverRung2ExpectedFixtureCount() {
        Exit(1);
    }
    let i: Int = 0;
    while i < ArrayLength(rows) {
        Log(rows[i]);
        i = i + 1;
    }
}

func EmitDriverRung2MirFixtureManifest() -> Void {
    let rows: Array<String> = DriverRung2MirFixtureRows();
    if ArrayLength(rows) != DriverRung2ExpectedMirFixtureCount() {
        Exit(1);
    }
    let i: Int = 0;
    while i < ArrayLength(rows) {
        Log(rows[i]);
        i = i + 1;
    }
}

struct DriverRung2VerifiedFacts {
    analysis: SemanticAstArtifactAnalysis;
    initializer_types: SemanticAstInitializerTypeFacts;
    iteration_types: SemanticAstIterationTypeFacts;
}

func VerifyArtifactAnalysisForDriverRung2(
    artifact: AstTreeArtifact,
    semantic_analysis: SemanticAstArtifactAnalysis
) -> DriverRung2VerifiedFacts {
    if !CompilerDriverRung2Ready() {
        Die("driver rung-2 semantic facts are not ready");
    }
    if !semantic_analysis.verdict.ok {
        Log(semantic_analysis.verdict.diagnostic_message);
        Exit(1);
    }
    let initializer_types: SemanticAstInitializerTypeFacts =
        SemanticAstInitializerTypeFactsFromArtifact(
            artifact,
            semantic_analysis.signatures,
            semantic_analysis.constructors,
            semantic_analysis.local_bindings
        );
    if !initializer_types.ok {
        Log(initializer_types.diagnostic_message);
        Exit(1);
    }
    let iteration_types: SemanticAstIterationTypeFacts =
        SemanticAstIterationTypeFactsFromArtifact(
            artifact,
            semantic_analysis.signatures,
            semantic_analysis.constructors,
            semantic_analysis.local_bindings,
            initializer_types,
            semantic_analysis.statements
        );
    if !iteration_types.ok {
        Log(iteration_types.diagnostic_message);
        Exit(1);
    }
    let assignment_types: SemanticAstAssignmentTypeFacts =
        SemanticAstAssignmentTypeFactsFromArtifact(
            artifact,
            semantic_analysis.signatures,
            semantic_analysis.constructors,
            semantic_analysis.local_bindings,
            initializer_types,
            semantic_analysis.statements,
            iteration_types,
            semantic_analysis.assignments
        );
    if !assignment_types.ok {
        Log(assignment_types.diagnostic_message);
        Exit(1);
    }
    let statement_types: SemanticAstStatementTypeFacts =
        SemanticAstStatementTypeFactsFromArtifact(
            artifact,
            semantic_analysis.signatures,
            semantic_analysis.constructors,
            semantic_analysis.local_bindings,
            initializer_types,
            iteration_types,
            semantic_analysis.statements
        );
    if !statement_types.ok {
        Log(statement_types.diagnostic_message);
        Exit(1);
    }
    let body_verdict: SemanticAstBodyVerdict =
        SemanticAstBodyVerdictFromFacts(
            initializer_types, iteration_types, assignment_types,
            statement_types
        );
    if !body_verdict.ok {
        Log(body_verdict.diagnostic_message);
        Exit(1);
    }
    return DriverRung2VerifiedFacts(
        semantic_analysis, initializer_types, iteration_types
    );
}

func VerifyArtifactForMirProduction(
    artifact: AstTreeArtifact
) -> DriverRung2VerifiedFacts {
    return VerifyArtifactAnalysisForDriverRung2(
        artifact, SemanticAstArtifactAnalyzeTyped(artifact, true)
    );
}

func CompileArtifactAnalysisToMirJsonVerified(
    artifact: AstTreeArtifact,
    analysis: SemanticAstArtifactAnalysis
) -> String {
    let verified: DriverRung2VerifiedFacts =
        VerifyArtifactAnalysisForDriverRung2(artifact, analysis);
    let mir_facts: SelfMirProgramFacts = SelfMirProgramFactsFromArtifact(
        artifact, verified.analysis, verified.initializer_types,
        verified.iteration_types
    );
    if !SelfMirProgramFactsReady(mir_facts) {
        Log(SelfMirProgramFactsValidationError(mir_facts));
        Exit(1);
    }
    let json: String = SelfMirProgramJson(mir_facts);
    if json == "" {
        Log("self-host MIR JSON projection failed closed");
        Exit(1);
    }
    return json;
}

func CompileArtifactToMirJsonVerified(
    artifact: AstTreeArtifact
) -> String {
    return CompileArtifactAnalysisToMirJsonVerified(
        artifact, SemanticAstArtifactAnalyzeTyped(artifact, true)
    );
}

func CompileSourceToMirJsonVerified(
    source_path: String
) -> String with caps io_read {
    return CompileArtifactToMirJsonVerified(
        CompileSourceToAstArtifact(source_path)
    );
}

func CanonicalizeMirJsonVerified(
    mir_json_path: String
) -> String with caps io_read {
    let json: String = MirJsonReadInput(mir_json_path);
    let artifact: AstTreeArtifact = AstTreeArtifactFromText(
        EmitMirProgramTree(json)
    );
    return CompileArtifactAnalysisToMirJsonVerified(
        artifact,
        SemanticAstArtifactAnalyzeCompactBridge(artifact, true)
    );
}

func CompileMirJsonTextToCVerified(
    json: String
) -> CompilerEmissionArtifact {
    let artifact: AstTreeArtifact = AstTreeArtifactFromText(
        EmitMirProgramTree(json)
    );
    let graph: SemanticExpressionGraphFacts =
        MirExpressionGraphFactsForArtifact(json, artifact);
    if !graph.ok {
        Die("MIR instruction expression graph is missing or invalid");
    }
    let analysis: SemanticAstArtifactAnalysis =
        SemanticAstArtifactAnalyzeWithExpressionGraph(
            artifact, true, graph
        );
    let verified: DriverRung2VerifiedFacts =
        VerifyArtifactAnalysisForDriverRung2(artifact, analysis);
    return CompilerEmissionArtifact(
        "emitted-c",
        GenerateCFromSemanticArtifact(artifact, verified.analysis)
    );
}

func CompileSourceToCVerified(
    source_path: String
) -> CompilerEmissionArtifact with caps io_read {
    let json: String = CompileSourceToMirJsonVerified(source_path);
    return CompileMirJsonTextToCVerified(json);
}

func CompileMirJsonToCVerified(
    mir_json_path: String
) -> CompilerEmissionArtifact with caps io_read {
    let json: String = MirJsonReadInput(mir_json_path);
    return CompileMirJsonTextToCVerified(json);
}

func RunDriverRung2FromArgs(args: Array<String>) -> Void with caps io_read {
    if ArrayLength(args) > 0 && args[0] == "--fixture-manifest" {
        EmitDriverRung2FixtureManifest();
        return;
    }
    if ArrayLength(args) > 0 && args[0] == "--mir-fixture-manifest" {
        EmitDriverRung2MirFixtureManifest();
        return;
    }
    if ArrayLength(args) == 2 &&
        args[0] == "--emit-mir-json-verified" {
        Log(CompileSourceToMirJsonVerified(args[1]));
        return;
    }
    if ArrayLength(args) == 2 &&
        args[0] == "--canonicalize-mir-json" {
        Log(CanonicalizeMirJsonVerified(args[1]));
        return;
    }
    if ArrayLength(args) > 0 && args[0] == "--mir-json" {
        if ArrayLength(args) != 2 {
            Die("driver rung-2 --mir-json requires one MIR JSON path");
        }
        Log(CompileMirJsonToCVerified(args[1]).payload);
        return;
    }
    let source_path: String = ParserDefaultSourcePath(args);
    if ArrayLength(args) > 1 && args[1] != "--emit-c-verified" {
        Die(Concat("unknown driver rung-2 mode: ", args[1]));
    }
    Log(CompileSourceToCVerified(source_path).payload);
}
