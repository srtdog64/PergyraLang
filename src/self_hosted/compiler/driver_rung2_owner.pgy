func DriverRung2ExpectedMirFixtureCount() -> Int {
    return 224;
}

func EmitDriverRung2MirFixtureManifest() -> Void {
    let rows: Array<String> = DriverRung2MirFixtureRows();
    if ArrayLength(rows) != DriverRung2ExpectedMirFixtureCount() {
        Exit(1);
    }
    let i: Int = 0;
    while i < ArrayLength(rows) {
        Log(rows[i]);
        i = i + 1;
    }
}

struct DriverRung2VerifiedFacts {
    analysis: SemanticAstArtifactAnalysis;
    body_types: SemanticAstBodyTypeBundle;
}

func VerifyArtifactAnalysisForDriverRung2(
    artifact: AstTreeArtifact,
    semantic_analysis: SemanticAstArtifactAnalysis
) -> DriverRung2VerifiedFacts {
    let readiness_error: String = CompilerDriverRung2ReadinessError();
    if readiness_error != "" {
        Die(Concat("driver rung-2 semantic facts are not ready: ", readiness_error));
    }
    if !semantic_analysis.verdict.ok {
        Log(semantic_analysis.verdict.diagnostic_message);
        Exit(1);
    }
    let body_types: SemanticAstBodyTypeBundle =
        SemanticAstBodyTypeBundleFromAnalysis(artifact, semantic_analysis);
    if !SemanticAstBodyTypeBundleReady(
        artifact, semantic_analysis, body_types
    ) {
        Log(body_types.verdict.diagnostic_message);
        Exit(1);
    }
    return DriverRung2VerifiedFacts(semantic_analysis, body_types);
}

func VerifyArtifactForMirProduction(
    artifact: AstTreeArtifact
) -> DriverRung2VerifiedFacts {
    return VerifyArtifactAnalysisForDriverRung2(
        artifact, SemanticAstArtifactAnalyzeTyped(artifact, true)
    );
}

func CompileArtifactAnalysisToMirJsonVerified(
    artifact: AstTreeArtifact,
    analysis: SemanticAstArtifactAnalysis,
    machine_declaration: SelfHostMachineLayerDeclaration
) -> String {
    let verified: DriverRung2VerifiedFacts =
        VerifyArtifactAnalysisForDriverRung2(artifact, analysis);
    let mir_facts: SelfMirProgramFacts = SelfMirProgramFactsFromArtifact(
        artifact, verified.analysis, verified.body_types.initializer_types,
        verified.body_types.iteration_types,
        verified.body_types.assignment_types,
        verified.body_types.generic_specializations,
        machine_declaration
    );
    if !SelfMirProgramFactsReady(mir_facts) {
        Log(SelfMirProgramFactsValidationError(mir_facts));
        Exit(1);
    }
    let json: String = SelfMirProgramJson(mir_facts);
    if json == "" {
        Log("self-host MIR JSON projection failed closed");
        Exit(1);
    }
    return json;
}

func CompileArtifactToMirJsonVerified(
    artifact: AstTreeArtifact,
    machine_declaration: SelfHostMachineLayerDeclaration
) -> String {
    return CompileArtifactAnalysisToMirJsonVerified(
        artifact, SemanticAstArtifactAnalyzeTyped(artifact, true),
        machine_declaration
    );
}

func CompileSourceToMirJsonVerified(
    source_path: String,
    machine_declaration: SelfHostMachineLayerDeclaration
) -> String with caps io_read {
    return CompileArtifactToMirJsonVerified(
        CompileSourceToAstArtifact(source_path), machine_declaration
    );
}

func CanonicalizeMirJsonVerified(
    mir_json_path: String,
    machine_declaration: SelfHostMachineLayerDeclaration
) -> String with caps io_read {
    let json: String = MirJsonReadInput(
        mir_json_path, machine_declaration
    );
    let artifact: AstTreeArtifact = AstTreeArtifactFromText(
        EmitMirProgramTree(json)
    );
    let graph: SemanticExpressionGraphFacts =
        MirExpressionGraphFactsForArtifact(json, artifact);
    if !graph.ok {
        Die("MIR instruction expression graph is missing or invalid");
    }
    let analysis: SemanticAstArtifactAnalysis =
        SemanticAstArtifactAnalyzeWithExpressionGraph(artifact, true, graph);
    let verified: DriverRung2VerifiedFacts =
        VerifyArtifactAnalysisForDriverRung2(artifact, analysis);
    if !MirAssignmentBindingModesMatchSemanticFacts(
        json, verified.body_types.assignment_types
    ) {
        Die("MIR assignment binding-mode fact is missing or invalid");
    }
    return CompileArtifactAnalysisToMirJsonVerified(
        artifact, verified.analysis,
        machine_declaration
    );
}

func CanonicalizeOracleMirJsonBridge(
    mir_json_path: String,
    machine_declaration: SelfHostMachineLayerDeclaration
) -> String with caps io_read {
    let json: String = MirJsonReadInput(
        mir_json_path, machine_declaration
    );
    let artifact: AstTreeArtifact = AstTreeArtifactFromText(
        EmitMirProgramTree(json)
    );
    return CompileArtifactAnalysisToMirJsonVerified(
        artifact,
        SemanticAstArtifactAnalyzeCompactBridge(artifact, true),
        machine_declaration
    );
}

func CompileMirJsonTextToCForTargetVerified(
    json: String,
    machine_declaration: SelfHostMachineLayerDeclaration,
    target_projection: CompilerTargetProjectionFact
) -> CompilerEmissionArtifact {
    if !MirMachineLayerFactsReady(json, machine_declaration) {
        Die("self-host C emission rejected invalid machine-layer facts");
    }
    let artifact: AstTreeArtifact = AstTreeArtifactFromText(
        EmitMirProgramTree(json)
    );
    let graph: SemanticExpressionGraphFacts =
        MirExpressionGraphFactsForArtifact(json, artifact);
    if !graph.ok {
        Die("MIR instruction expression graph is missing or invalid");
    }
    let analysis: SemanticAstArtifactAnalysis =
        SemanticAstArtifactAnalyzeWithExpressionGraph(
            artifact, true, graph
        );
    let verified: DriverRung2VerifiedFacts =
        VerifyArtifactAnalysisForDriverRung2(artifact, analysis);
    if !MirAssignmentBindingModesMatchSemanticFacts(
        json, verified.body_types.assignment_types
    ) {
        Die("MIR assignment binding-mode fact is missing or invalid");
    }
    let semantic_body_types: SemanticAstBodyTypeBundle =
        verified.body_types;
    let mir_generic_specializations: CodegenGenericSpecializationFacts =
        MirCodegenGenericSpecializationFacts(
            json, verified.analysis.signatures,
            semantic_body_types.generic_specializations,
            verified.analysis.expression_surfaces
        );
    if !mir_generic_specializations.ok {
        Die(Concat(
            "MIR generic specialization facts are incomplete: ",
            mir_generic_specializations.diagnostic_message
        ));
    }
    let body_types: CodegenSemanticBodyTypeFacts =
        CodegenSemanticBodyTypeFactsFromBundleOrDie(
            artifact, verified.analysis, semantic_body_types,
            mir_generic_specializations
        );
    let emission: CompilerEmissionArtifact = CompilerEmissionArtifact(
        "emitted-c",
        GenerateCFromVerifiedSemanticArtifact(
            artifact, verified.analysis, body_types, machine_declaration,
            target_projection
        ),
        target_projection.schema,
        target_projection.projection,
        target_projection.target_capability_fingerprint
    );
    if !CompilerEmissionArtifactReady(emission) {
        Die("self-host C emission artifact target fingerprint is missing or invalid");
    }
    return emission;
}

func CompileMirJsonTextToCVerified(
    json: String,
    machine_declaration: SelfHostMachineLayerDeclaration
) -> CompilerEmissionArtifact {
    return CompileMirJsonTextToCForTargetVerified(
        json, machine_declaration,
        CompilerTargetProjectionFactFromOwner(
            CompilerTargetCpuCProjection()
        )
    );
}

func CompileSourceToCVerified(
    source_path: String,
    machine_declaration: SelfHostMachineLayerDeclaration
) -> CompilerEmissionArtifact with caps io_read {
    let json: String = CompileSourceToMirJsonVerified(
        source_path, machine_declaration
    );
    return CompileMirJsonTextToCVerified(json, machine_declaration);
}

func CompileMirJsonToCVerified(
    mir_json_path: String,
    machine_declaration: SelfHostMachineLayerDeclaration
) -> CompilerEmissionArtifact with caps io_read {
    let json: String = MirJsonReadInput(
        mir_json_path, machine_declaration
    );
    return CompileMirJsonTextToCVerified(json, machine_declaration);
}
