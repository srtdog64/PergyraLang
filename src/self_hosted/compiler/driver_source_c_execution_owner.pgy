// Production-reachable source-to-C orchestration and publication boundary.
// Existing typed compiler owners retain semantic and emission authority; this
// subject owns request admission and the artifact transaction transition.

import "driver_source_c_protocol_owner.pgy";
import "driver_rung2_owner.pgy";
import "../mir/artifact_transaction_owner.pgy";

func DriverSourceCRequestDiagnostic(
    subject_identity: String,
    topology_identity: String,
    source_path: String,
    request: DriverSourceCRequest
) -> String {
    if subject_identity != DriverSourceCExecutionOwnerIdentity() {
        return "source C execution subject identity is invalid";
    }
    if topology_identity != DriverSourceCExecutionTopologyIdentity() {
        return "source C execution topology identity is invalid";
    }
    if source_path == "" { return "source C input path is empty"; }
    match request {
        case SourceCDefault: return "";
        case SourceCManifestVerified(declaration):
            if !SelfHostMachineLayerDeclarationReady(declaration) {
                return "source C machine declaration is invalid";
            }
            return "";
    }
}

func DriverSourceCProducePayloadAdmitted(
    subject_identity: String,
    topology_identity: String,
    source_path: String,
    request: DriverSourceCRequest
) -> DriverSourceCPayloadAdmission with caps io_read {
    let diagnostic: String = DriverSourceCRequestDiagnostic(
        subject_identity, topology_identity, source_path, request
    );
    if diagnostic != "" {
        return DriverSourceCPayloadDeniedAdmission(
            request, source_path, diagnostic
        );
    }
    let artifact: CompilerEmissionArtifact = CompileSourceToCVerified(
        source_path, DriverSourceCRequestDeclaration(request)
    );
    if !CompilerEmissionArtifactReady(artifact) {
        return DriverSourceCPayloadDeniedAdmission(
            request, source_path,
            "source C compiler artifact target is invalid"
        );
    }
    return DriverSourceCPayloadAdmitted(DriverSourceCPayloadReceipt(
        DriverSourceCExecutionOutcomeSchema(),
        DriverSourceCRequestMode(request), source_path,
        DriverSourceCRequestManifestId(request),
        DriverSourceCRequestManifestFingerprint(request), artifact
    ));
}

subject DriverSourceCExecution {
    let identity: String;
    let topology_identity: String;
    let mut outcome: Option<DriverSourceCExecutionOutcome>;

    action ProduceSourceC(
        self,
        source_path: String,
        request: DriverSourceCRequest
    ) -> DriverSourceCPayloadAdmission
        within DriverSourceCZone
        authorized by self
        with caps io_read {
        return DriverSourceCProducePayloadAdmitted(
            self.identity, self.topology_identity, source_path,
            request
        );
    }

    action Compile(
        self,
        source_path: String,
        output_path: String,
        request: DriverSourceCRequest
    ) -> Bool
        within DriverSourceCZone
        authorized by self
        with caps io_read, io_write {
        if output_path == "" {
            self.outcome = Some(DriverSourceCRejectedOutcome(
                source_path, output_path,
                "source C artifact destination path is empty"
            ));
            return false;
        }
        let admission: DriverSourceCPayloadAdmission =
            DriverSourceCProducePayloadAdmitted(
                self.identity, self.topology_identity, source_path,
                request
            );
        match admission {
            case DriverSourceCPayloadDenied(rejection):
                self.outcome = Some(DriverSourceCRejectedOutcome(
                    source_path, output_path,
                    DriverSourceCPayloadAdmissionDiagnostic(
                        admission, source_path, request
                    )
                ));
                return false;
            case DriverSourceCPayloadAdmitted(receipt):
                if !DriverSourceCPayloadReceiptReadyFor(
                    receipt, source_path, request
                ) {
                    self.outcome = Some(DriverSourceCRejectedOutcome(
                        source_path, output_path,
                        "source C payload receipt is invalid"
                    ));
                    return false;
                }
                let committed: SelfMirArtifactCommitOutcome =
                    SelfMirArtifactCommitPayload(
                        output_path, receipt.artifact.payload
                    );
                match committed {
                    case SelfMirArtifactCommitted(commit_receipt):
                        if !SelfMirArtifactReceiptReadyFor(
                            commit_receipt, output_path
                        ) {
                            self.outcome = Some(DriverSourceCRejectedOutcome(
                                source_path, output_path,
                                "source C artifact receipt is invalid"
                            ));
                            return false;
                        }
                        self.outcome = Some(DriverSourceCExecutedOutcome(
                            DriverSourceCExecutionReceipt(
                                DriverSourceCExecutionOutcomeSchema(),
                                source_path, commit_receipt.final_path,
                                receipt.artifact.target_capability_fingerprint,
                                commit_receipt.atomic_visibility,
                                commit_receipt.crash_durable
                            )
                        ));
                        return true;
                    case SelfMirArtifactRejected(failure):
                        self.outcome = Some(
                            DriverSourceCArtifactRejectedOutcome(failure)
                        );
                        return false;
                }
        }
    }
}

public zone DriverSourceCZone {
    subject slot execution: DriverSourceCExecution
    authority execution
}

public intent CompilePergyraCArtifact(
    intent_zone: DriverSourceCZone,
    intent_execution: DriverSourceCExecution,
    source_path: String, output_path: String,
    request: DriverSourceCRequest
) {
    exclusive;
    step Compile {
        using: intent_zone;
        on action_succeeded: intent_execution.Compile(
            source_path, output_path, request
        );
        expect: action_succeeded;
    }
    success: true;
    failure: false;
}
