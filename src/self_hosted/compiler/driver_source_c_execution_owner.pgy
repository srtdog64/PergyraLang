// Production-reachable source-to-C orchestration and publication boundary.
// Existing typed compiler owners retain semantic and emission authority; this
// subject owns only request admission and the artifact transaction transition.

import "driver_rung2_owner.pgy";
import "../mir/artifact_transaction_owner.pgy";

tobject DriverSourceCExecutionReceipt {
    schema: String;
    source_path: String;
    final_path: String;
    target_capability_fingerprint: Int;
    atomic_visibility: Bool;
    crash_durable: Bool;
}

tobject DriverSourceCExecutionRejection {
    schema: String;
    source_path: String;
    final_path: String;
    diagnostic: String;
}

enum DriverSourceCExecutionOutcome {
    DriverSourceCExecuted(DriverSourceCExecutionReceipt),
    DriverSourceCRejected(DriverSourceCExecutionRejection),
    DriverSourceCArtifactRejected(SelfMirArtifactFailure),
}

func DriverSourceCExecutionOwnerIdentity() -> String {
    return "driver-source-c-execution";
}

func DriverSourceCExecutionTopologyIdentity() -> String {
    return "driver-source-c-zone.v1";
}

func DriverSourceCExecutionOutcomeSchema() -> String {
    return "pgy.driver-source-c-execution-outcome.v1";
}

func DriverSourceCRejectedOutcome(
    source_path: String,
    final_path: String,
    diagnostic: String
) -> DriverSourceCExecutionOutcome {
    return DriverSourceCRejected(DriverSourceCExecutionRejection(
        DriverSourceCExecutionOutcomeSchema(), source_path, final_path,
        diagnostic
    ));
}

func DriverSourceCExecutionOutcomeReadyFor(
    outcome: DriverSourceCExecutionOutcome,
    expected_source_path: String,
    expected_final_path: String
) -> Bool {
    match outcome {
        case DriverSourceCExecuted(receipt):
            return receipt.schema == DriverSourceCExecutionOutcomeSchema() &&
                receipt.source_path == expected_source_path &&
                receipt.final_path == expected_final_path &&
                receipt.target_capability_fingerprint ==
                    CompilerTargetCapabilityFingerprint() &&
                receipt.atomic_visibility && !receipt.crash_durable;
        case DriverSourceCRejected(rejection): return false;
        case DriverSourceCArtifactRejected(failure): return false;
    }
}

func DriverSourceCExecutionOutcomeDiagnostic(
    outcome: DriverSourceCExecutionOutcome,
    expected_source_path: String,
    expected_final_path: String
) -> String {
    match outcome {
        case DriverSourceCExecuted(receipt):
            if DriverSourceCExecutionOutcomeReadyFor(
                outcome, expected_source_path, expected_final_path
            ) { return ""; }
            return "source C execution receipt is invalid";
        case DriverSourceCRejected(rejection):
            if rejection.schema != DriverSourceCExecutionOutcomeSchema() ||
                rejection.source_path != expected_source_path ||
                rejection.final_path != expected_final_path ||
                rejection.diagnostic == "" {
                return "source C execution rejection payload is invalid";
            }
            return rejection.diagnostic;
        case DriverSourceCArtifactRejected(failure):
            return SelfMirArtifactFailureDiagnostic(
                failure, expected_final_path
            );
    }
}

subject DriverSourceCExecution {
    let identity: String;
    let topology_identity: String;

    action PublishSourceCArtifact(
        self,
        source_path: String,
        output_path: String,
        machine_declaration: SelfHostMachineLayerDeclaration
    ) -> DriverSourceCExecutionOutcome
        within DriverSourceCZone
        authorized by self
        with caps io_read, io_write {
        if self.identity != DriverSourceCExecutionOwnerIdentity() {
            return DriverSourceCRejectedOutcome(
                source_path, output_path,
                "source C execution subject identity is invalid"
            );
        }
        if self.topology_identity !=
            DriverSourceCExecutionTopologyIdentity() {
            return DriverSourceCRejectedOutcome(
                source_path, output_path,
                "source C execution topology identity is invalid"
            );
        }
        if source_path == "" {
            return DriverSourceCRejectedOutcome(
                source_path, output_path,
                "source C input path is empty"
            );
        }
        if output_path == "" {
            return DriverSourceCRejectedOutcome(
                source_path, output_path,
                "source C artifact destination path is empty"
            );
        }
        let artifact: CompilerEmissionArtifact = CompileSourceToCVerified(
            source_path, machine_declaration
        );
        if !CompilerEmissionArtifactReady(artifact) ||
            artifact.target_projection != CompilerTargetCpuCProjection() {
            return DriverSourceCRejectedOutcome(
                source_path, output_path,
                "source C compiler artifact target is invalid"
            );
        }
        let committed: SelfMirArtifactCommitOutcome =
            SelfMirArtifactCommitPayload(output_path, artifact.payload);
        match committed {
            case SelfMirArtifactCommitted(receipt):
                if !SelfMirArtifactReceiptReadyFor(receipt, output_path) {
                    return DriverSourceCRejectedOutcome(
                        source_path, output_path,
                        "source C artifact receipt is invalid"
                    );
                }
                return DriverSourceCExecuted(
                    DriverSourceCExecutionReceipt(
                        DriverSourceCExecutionOutcomeSchema(),
                        source_path, receipt.final_path,
                        artifact.target_capability_fingerprint,
                        receipt.atomic_visibility, receipt.crash_durable
                    )
                );
            case SelfMirArtifactRejected(failure):
                return DriverSourceCArtifactRejected(failure);
        }
    }
}

public zone DriverSourceCZone {
    subject slot execution: DriverSourceCExecution
    authority execution
}
