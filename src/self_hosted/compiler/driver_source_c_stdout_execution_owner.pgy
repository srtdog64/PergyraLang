// Checked read-only last consumer for installed source-C stdout requests.

import "compiler_world_direct_mir_owner.pgy";

func DriverRung2CliLogSourceCPayloadOrDie(
    source_path: String,
    request: DriverSourceCRequest
) -> Void with caps io_read {
    let admission: DriverSourceCPayloadAdmission =
        ProduceSourceCThroughPgyCompilerWorld(
            source_path, request
        );
    if !DriverSourceCPayloadAdmissionReadyFor(
        admission, source_path, request
    ) {
        Log(DriverSourceCPayloadAdmissionDiagnostic(
            admission, source_path, request
        ));
        Exit(1);
    }
    match admission {
        case DriverSourceCPayloadAdmitted(receipt):
            Log(receipt.artifact.payload);
        case DriverSourceCPayloadDenied(rejection):
            Die("source C stdout request returned an unchecked rejection");
    }
}
