// Production-reachable source-to-MIR orchestration boundary.
// Typed source/MIR owners retain semantic authority; this subject owns
// pressure admission, one payload compilation, and the artifact commit.

import "driver_source_mir_protocol_owner.pgy";
import "driver_rung2_owner.pgy";
import "../mir/artifact_transaction_owner.pgy";

func DriverSourceMirRequestDiagnostic(
    subject_identity: String,
    topology_identity: String,
    source_path: String,
    request: DriverSourceMirRequest
) -> String {
    if subject_identity != DriverSourceMirExecutionOwnerIdentity() {
        return "source MIR execution subject identity is invalid";
    }
    if topology_identity != DriverSourceMirExecutionTopologyIdentity() {
        return "source MIR execution topology identity is invalid";
    }
    let full_driver: Bool = DriverSourceMirIsFullDriverSource(source_path);
    let pressure_observed: Bool =
        DriverSourceMirRequestObservesPressure(request);
    if full_driver && !pressure_observed {
        return "full driver MIR production requires pressure observation";
    }
    if !full_driver && pressure_observed {
        return "pressure-observed source MIR is only valid for the full driver";
    }
    return "";
}

func DriverSourceMirProjectionFromAdmittedRequest(
    source_path: String,
    machine_declaration: SelfHostMachineLayerDeclaration,
    request: DriverSourceMirRequest
) -> DriverRung2MirProjection with caps io_read {
    let observe_pressure: Bool =
        DriverSourceMirRequestObservesPressure(request);
    DriverRung2PressureStage(observe_pressure, "ast:start");
    let artifact: AstTreeArtifact = CompileSourceToAstArtifact(source_path);
    DriverRung2PressureStage(observe_pressure, "ast:done");
    DriverRung2PressureStage(observe_pressure, "semantic:start");
    let analysis: SemanticAstArtifactAnalysis =
        SemanticAstArtifactAnalyzeTyped(artifact, true);
    DriverRung2PressureStage(observe_pressure, "semantic:done");
    let projection: DriverRung2MirProjection =
        DriverRung2MirProjectionFromAdmittedAnalysisObserved(
        artifact, analysis, machine_declaration, observe_pressure
    );
    return projection;
}

func DriverSourceMirProducePayloadAdmitted(
    subject_identity: String,
    topology_identity: String,
    source_path: String,
    machine_declaration: SelfHostMachineLayerDeclaration,
    request: DriverSourceMirRequest
) -> DriverSourceMirPayloadAdmission with caps io_read {
    let request_diagnostic: String = DriverSourceMirRequestDiagnostic(
        subject_identity, topology_identity, source_path, request
    );
    if request_diagnostic != "" {
        return DriverSourceMirPayloadDenied(
            DriverSourceMirExecutionRejection(
                DriverSourceMirExecutionOutcomeSchema(),
                DriverSourceMirRequestMode(request),
                source_path,
                request_diagnostic
            )
        );
    }
    let projection: DriverRung2MirProjection =
        DriverSourceMirProjectionFromAdmittedRequest(
            source_path, machine_declaration, request
        );
    let payload: String = DriverRung2MirProjectionJson(
        projection, DriverSourceMirRequestObservesPressure(request)
    );
    if payload == "" {
        return DriverSourceMirPayloadDenied(
            DriverSourceMirExecutionRejection(
                DriverSourceMirExecutionOutcomeSchema(),
                DriverSourceMirRequestMode(request),
                source_path,
                "source MIR execution produced an empty payload"
            )
        );
    }
    return DriverSourceMirPayloadAdmitted(
        DriverSourceMirPayloadReceipt(
            DriverSourceMirExecutionOutcomeSchema(),
            DriverSourceMirRequestMode(request),
            source_path,
            payload
        )
    );
}

subject DriverSourceMirExecution {
    let identity: String;
    let topology_identity: String;

    action ProduceSourceMir(
        self,
        source_path: String,
        machine_declaration: SelfHostMachineLayerDeclaration,
        request: DriverSourceMirRequest
    ) -> DriverSourceMirPayloadAdmission
        within DriverSourceMirZone
        authorized by self
        with caps io_read {
        return DriverSourceMirProducePayloadAdmitted(
            self.identity, self.topology_identity, source_path,
            machine_declaration, request
        );
    }

    action PublishSourceMirArtifact(
        self,
        source_path: String,
        output_path: String,
        machine_declaration: SelfHostMachineLayerDeclaration,
        request: DriverSourceMirRequest
    ) -> DriverSourceMirExecutionOutcome
        within DriverSourceMirZone
        authorized by self
        with caps io_read, io_write {
        if output_path == "" {
            return DriverSourceMirRejectedOutcome(
                request, source_path,
                "source MIR artifact destination path is empty"
            );
        }
        let request_diagnostic: String = DriverSourceMirRequestDiagnostic(
            self.identity, self.topology_identity, source_path, request
        );
        if request_diagnostic != "" {
            return DriverSourceMirRejectedOutcome(
                request, source_path, request_diagnostic
            );
        }
        let observe_pressure: Bool =
            DriverSourceMirRequestObservesPressure(request);
        let projection: DriverRung2MirProjection =
            DriverSourceMirProjectionFromAdmittedRequest(
                source_path, machine_declaration, request
            );
        DriverRung2PressureStage(observe_pressure, "json-write:start");
        let committed: SelfMirArtifactCommitOutcome =
            SelfMirProgramJsonWriteArtifactVerified(
                projection.facts, output_path
            );
        DriverRung2MirProjectionRelease(projection);
        match committed {
            case SelfMirArtifactCommitted(receipt):
                DriverRung2PressureStage(observe_pressure, "json-write:done");
                if !SelfMirArtifactReceiptReadyFor(receipt, output_path) {
                    return DriverSourceMirRejectedOutcome(
                        request, source_path,
                        "source MIR artifact receipt is invalid"
                    );
                }
                return DriverSourceMirExecuted(
                    DriverSourceMirExecutionReceipt(
                        DriverSourceMirExecutionOutcomeSchema(),
                        DriverSourceMirRequestMode(request),
                        source_path,
                        receipt.final_path,
                        receipt.atomic_visibility,
                        receipt.crash_durable
                    )
                );
            case SelfMirArtifactRejected(failure):
                return DriverSourceMirArtifactRejected(failure);
        }
    }
}

public zone DriverSourceMirZone {
    subject slot execution: DriverSourceMirExecution
    authority execution
}
