// Source-to-MIR request, receipt, rejection, and diagnostic protocol owner.

import "../mir/artifact_transaction_owner.pgy";

enum DriverSourceMirRequest {
    SourceMirVerified,
    SourceMirPressureObserved,
}

tobject DriverSourceMirPayloadReceipt {
    schema: String;
    request_mode: String;
    source_path: String;
    payload: String;
}

tobject DriverSourceMirExecutionReceipt {
    schema: String;
    request_mode: String;
    source_path: String;
    final_path: String;
    atomic_visibility: Bool;
    crash_durable: Bool;
}

tobject DriverSourceMirExecutionRejection {
    schema: String;
    request_mode: String;
    source_path: String;
    diagnostic: String;
}

enum DriverSourceMirExecutionOutcome {
    DriverSourceMirProduced(DriverSourceMirPayloadReceipt),
    DriverSourceMirExecuted(DriverSourceMirExecutionReceipt),
    DriverSourceMirRejected(DriverSourceMirExecutionRejection),
    DriverSourceMirArtifactRejected(SelfMirArtifactFailure),
}

enum DriverSourceMirPayloadAdmission {
    DriverSourceMirPayloadAdmitted(DriverSourceMirPayloadReceipt),
    DriverSourceMirPayloadDenied(DriverSourceMirExecutionRejection),
}

func DriverSourceMirExecutionOwnerIdentity() -> String {
    return "driver-source-mir-execution";
}

func DriverSourceMirExecutionTopologyIdentity() -> String {
    return "driver-source-mir-zone.v1";
}

func DriverSourceMirExecutionOutcomeSchema() -> String {
    return "pgy.driver-source-mir-execution-outcome.v1";
}

func DriverSourceMirRequestMode(
    request: DriverSourceMirRequest
) -> String {
    match request {
        case SourceMirVerified: return "verified";
        case SourceMirPressureObserved: return "pressure-observed";
    }
}

func DriverSourceMirRequestObservesPressure(
    request: DriverSourceMirRequest
) -> Bool {
    match request {
        case SourceMirVerified: return false;
        case SourceMirPressureObserved: return true;
    }
}

func DriverSourceMirPathEndsWith(path: String, suffix: String) -> Bool {
    let path_length: Int = StringLength(path);
    let suffix_length: Int = StringLength(suffix);
    return path_length >= suffix_length &&
        SubEqualsWithLen(
            path, path_length, path_length - suffix_length,
            suffix_length, suffix
        );
}

func DriverSourceMirIsFullDriverSource(source_path: String) -> Bool {
    return source_path ==
        "src/self_hosted/compiler/driver_bootstrap_main.pgy" ||
        DriverSourceMirPathEndsWith(
            source_path,
            "/src/self_hosted/compiler/driver_bootstrap_main.pgy"
        );
}

func DriverSourceMirRejectedOutcome(
    request: DriverSourceMirRequest,
    source_path: String,
    diagnostic: String
) -> DriverSourceMirExecutionOutcome {
    return DriverSourceMirRejected(DriverSourceMirExecutionRejection(
        DriverSourceMirExecutionOutcomeSchema(),
        DriverSourceMirRequestMode(request),
        source_path,
        diagnostic
    ));
}

func DriverSourceMirExecutionOutcomeReadyFor(
    outcome: DriverSourceMirExecutionOutcome,
    expected_source_path: String,
    expected_output_path: String,
    expected_request: DriverSourceMirRequest
) -> Bool {
    match outcome {
        case DriverSourceMirProduced(receipt): return false;
        case DriverSourceMirExecuted(receipt):
            return receipt.schema ==
                    DriverSourceMirExecutionOutcomeSchema() &&
                receipt.request_mode ==
                    DriverSourceMirRequestMode(expected_request) &&
                receipt.source_path == expected_source_path &&
                receipt.final_path == expected_output_path &&
                receipt.atomic_visibility && !receipt.crash_durable;
        case DriverSourceMirRejected(rejection): return false;
        case DriverSourceMirArtifactRejected(failure): return false;
    }
}

func DriverSourceMirPayloadReceiptReadyFor(
    receipt: DriverSourceMirPayloadReceipt,
    expected_source_path: String,
    expected_request: DriverSourceMirRequest
) -> Bool {
    return receipt.schema == DriverSourceMirExecutionOutcomeSchema() &&
        receipt.request_mode == DriverSourceMirRequestMode(expected_request) &&
        receipt.source_path == expected_source_path &&
        receipt.payload != "";
}

func DriverSourceMirExecutionOutcomePayloadReadyFor(
    outcome: DriverSourceMirExecutionOutcome,
    expected_source_path: String,
    expected_request: DriverSourceMirRequest
) -> Bool {
    match outcome {
        case DriverSourceMirProduced(receipt):
            return DriverSourceMirPayloadReceiptReadyFor(
                receipt, expected_source_path, expected_request
            );
        case DriverSourceMirExecuted(receipt): return false;
        case DriverSourceMirRejected(rejection): return false;
        case DriverSourceMirArtifactRejected(failure): return false;
    }
}

func DriverSourceMirExecutionOutcomeDiagnostic(
    outcome: DriverSourceMirExecutionOutcome,
    expected_source_path: String,
    expected_output_path: String,
    expected_request: DriverSourceMirRequest
) -> String {
    match outcome {
        case DriverSourceMirProduced(receipt):
            return "source MIR execution produced a payload instead of an artifact";
        case DriverSourceMirExecuted(receipt):
            if DriverSourceMirExecutionOutcomeReadyFor(
                outcome, expected_source_path, expected_output_path,
                expected_request
            ) { return ""; }
            return "source MIR execution receipt is invalid";
        case DriverSourceMirRejected(rejection):
            if rejection.schema !=
                    DriverSourceMirExecutionOutcomeSchema() ||
                rejection.request_mode !=
                    DriverSourceMirRequestMode(expected_request) ||
                rejection.source_path != expected_source_path ||
                rejection.diagnostic == "" {
                return "source MIR execution rejection payload is invalid";
            }
            return rejection.diagnostic;
        case DriverSourceMirArtifactRejected(failure):
            return SelfMirArtifactFailureDiagnostic(
                failure, expected_output_path
            );
    }
}

func DriverSourceMirExecutionOutcomePayloadDiagnostic(
    outcome: DriverSourceMirExecutionOutcome,
    expected_source_path: String,
    expected_request: DriverSourceMirRequest
) -> String {
    match outcome {
        case DriverSourceMirProduced(receipt):
            if DriverSourceMirPayloadReceiptReadyFor(
                receipt, expected_source_path, expected_request
            ) { return ""; }
            return "source MIR payload receipt is invalid";
        case DriverSourceMirExecuted(receipt):
            return "source MIR execution published an artifact instead of producing a payload";
        case DriverSourceMirRejected(rejection):
            if rejection.schema !=
                    DriverSourceMirExecutionOutcomeSchema() ||
                rejection.request_mode !=
                    DriverSourceMirRequestMode(expected_request) ||
                rejection.source_path != expected_source_path ||
                rejection.diagnostic == "" {
                return "source MIR execution rejection payload is invalid";
            }
            return rejection.diagnostic;
        case DriverSourceMirArtifactRejected(failure):
            return "source MIR payload execution unexpectedly reached the artifact transaction";
    }
}
