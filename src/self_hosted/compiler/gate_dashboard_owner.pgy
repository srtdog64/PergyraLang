}

func CompilerGateDashboardCount(
    manifest: CompilerGateDashboardManifest
) -> Int {
    return ArrayLength(manifest.ids);
}

func CompilerGateDashboardTierKnown(tier: String) -> Bool {
    return tier == "static" || tier == "focused" || tier == "integration";
}

func CompilerGateDashboardDeclaredStateKnown(state: String) -> Bool {
    return state == "LANDED" || state == "PARTIAL" || state == "NEXT";
}

func CompilerGateDashboardManifestReady(
    manifest: CompilerGateDashboardManifest
) -> Bool {
    let count: Int = CompilerGateDashboardCount(manifest);
    if count == 0 || ArrayLength(manifest.make_targets) != count ||
        ArrayLength(manifest.tiers) != count ||
        ArrayLength(manifest.budget_seconds) != count ||
        ArrayLength(manifest.declared_states) != count ||
        ArrayLength(manifest.blocking) != count ||
        ArrayLength(manifest.owner_facts) != count {
        return false;
    }
    let i: Int = 0;
    while i < count {
        if manifest.ids[i] == "" || manifest.make_targets[i] == "" ||
            !CompilerGateDashboardTierKnown(manifest.tiers[i]) ||
            manifest.budget_seconds[i] <= 0 ||
            !CompilerGateDashboardDeclaredStateKnown(
                manifest.declared_states[i]
            ) || (manifest.blocking[i] != 0 && manifest.blocking[i] != 1) ||
            manifest.owner_facts[i] == "" {
            return false;
        }
        let prior: Int = 0;
        while prior < i {
            if manifest.ids[prior] == manifest.ids[i] ||
                manifest.make_targets[prior] == manifest.make_targets[i] {
                return false;
            }
            prior = prior + 1;
        }
        i = i + 1;
    }
    return true;
}

func CompilerGateDashboardIndex(
    manifest: CompilerGateDashboardManifest,
    gate_id: String
) -> Option<Int> {
    let i: Int = 0;
    while i < CompilerGateDashboardCount(manifest) {
        if manifest.ids[i] == gate_id { return Some(i); }
        i = i + 1;
    }
    return None;
}

func CompilerGateDashboardManifestText(
    manifest: CompilerGateDashboardManifest
) -> String {
    if !CompilerGateDashboardManifestReady(manifest) { return ""; }
    let rows: Array<String> = [
        Concat("schema=", CompilerGateDashboardSchema())
    ];
    let i: Int = 0;
    while i < CompilerGateDashboardCount(manifest) {
        let fields: Array<String> = [
            manifest.ids[i], manifest.make_targets[i], manifest.tiers[i],
            ToString(manifest.budget_seconds[i]),
            manifest.declared_states[i], ToString(manifest.blocking[i]),
            manifest.owner_facts[i]
        ];
        ArrayPush(rows, StringJoin(fields, "\t"));
        i = i + 1;
    }
    return StringJoin(rows, "\n");
}
