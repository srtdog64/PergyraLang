// Canonical operational rows for the hard self-host gate dashboard.
//
// Semantic fact ownership remains in sot_owner_spine_registry.md. This owner
// only owns which executable gates represent the active self-host frontier.

struct CompilerGateDashboardManifest {
    ids: Array<String>;
    make_targets: Array<String>;
    tiers: Array<String>;
    budget_seconds: Array<Int>;
    declared_states: Array<String>;
    blocking: Array<Int>;
    owner_facts: Array<String>;
}

func CompilerGateDashboardSchema() -> String {
    return "pgy.selfhost.gate-dashboard.v1";
}

func CompilerGateResultSchema() -> String {
    return "pgy.selfhost.gate-results.v1";
}

