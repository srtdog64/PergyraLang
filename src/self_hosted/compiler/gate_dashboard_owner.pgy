            "wrapper_policy_projection",
            "collection_policy_projection",
            "aggregate_field_policy_projection",
            "self_host_contract_cluster",
            "self_host_parity_cluster"
        ],
        [
            "sot-authority-edge-test-smoke",
            "sot-authority-adequacy-test-smoke",
            "self-host-hard-contract-test-smoke",
            "self-host-substitution-velocity-test-smoke",
            "self-host-program-graph-unification-test-smoke",
            "self-host-codegen-assignment-projection-parity-test-smoke",
            "self-host-initializer-projection-parity-test-smoke",
            "self-host-generic-return-parity-test-smoke",
            "self-host-wrapper-policy-parity-test-smoke",
            "self-host-collection-policy-parity-test-smoke",
            "self-host-aggregate-field-policy-parity-test-smoke",
            "self-host-preparation-contract-test-smoke",
            "self-host-preparation-parity-test-smoke"
        ],
        [
            "static", "static", "static", "static", "static",
            "focused", "focused", "focused", "focused", "focused",
            "focused",
            "integration", "integration"
        ],
        [60, 60, 60, 60, 60, 300, 300, 300, 300, 300, 300, 1800, 1800],
        [
            "LANDED", "LANDED", "LANDED", "LANDED",
