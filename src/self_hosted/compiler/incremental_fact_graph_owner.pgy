// Self-host incremental fact graph owner.
//
// This is the contract for future compiler-scale incrementality. It does not
// claim precise import invalidation is implemented yet; it names the fact graph
// and verifier axes that any reusable artifact must consume.

import "completeness_ledger_owner.pgy";

func CompilerIncrementalFactGraphSchema() -> String {
    return "pgy.selfhost.incremental-fact-graph.v1";
}

func CompilerIncrementalFactGraphRung0CacheSchema() -> String {
    return CompilerCompletenessIncrementalCacheSchema();
}

func CompilerIncrementalCacheParitySuiteName() -> String {
    return "self-host-incremental-cache-parity";
}

func CompilerIncrementalCacheParityDefaultSource() -> String {
    return "src/self_hosted/compiler/incremental_fact_graph_owner.pgy";
}

func CompilerIncrementalCacheParityDefaultStages() -> String {
    return "lexer,parser,semantic,codegen";
}

func CompilerIncrementalFactGraphStageCount() -> Int {
    return 9;
}

func CompilerIncrementalFactGraphSourceStageIndex() -> Int {
    return 0;
}

func CompilerIncrementalFactGraphMirStageIndex() -> Int {
    return 4;
}

func CompilerIncrementalFactGraphParityStageIndex() -> Int {
    return CompilerIncrementalFactGraphStageCount() - 1;
}

func CompilerIncrementalFactGraphStageAt(index: Int) -> String {
    if index == 0 { return "source-bytes"; }
    if index == 1 { return "token-stream"; }
    if index == 2 { return "ast-tree"; }
    if index == 3 { return "semantic-verdict"; }
    if index == 4 { return "mir-fact-graph"; }
    if index == 5 { return "abi-layout-rows"; }
    if index == 6 { return "air-evidence"; }
    if index == 7 { return "emitted-artifact"; }
    if index == 8 { return "parity-evidence"; }
    return "";
}

func CompilerIncrementalFactGraphStageIndexKnown(index: Int) -> Bool {
    return index >= 0 &&
        index < CompilerIncrementalFactGraphStageCount() &&
        CompilerIncrementalFactGraphStageAt(index) != "";
}

func CompilerIncrementalFactGraphDependencyCount() -> Int {
    return 12;
}

func CompilerIncrementalFactGraphSourceHashDependencyIndex() -> Int {
    return 0;
}

func CompilerIncrementalFactGraphImportFingerprintDependencyIndex() -> Int {
    return 1;
}

func CompilerIncrementalFactGraphAbiRowDependencyIndex() -> Int {
    return 8;
}

func CompilerIncrementalFactGraphRuntimeCallRowDependencyIndex() -> Int {
    return 9;
}

func CompilerIncrementalFactGraphDependencyAt(index: Int) -> String {
    if index == 0 { return "source-bytes-hash"; }
    if index == 1 { return "import-graph-fingerprint"; }
    if index == 2 { return "language-profile"; }
    if index == 3 { return "runtime-profile"; }
    if index == 4 { return "stdlib-profile"; }
    if index == 5 { return "capability-profile"; }
    if index == 6 { return "target-profile"; }
    if index == 7 { return "owner-schema-version"; }
    if index == 8 { return "abi-row-fingerprint"; }
    if index == 9 { return "runtime-call-row-fingerprint"; }
    if index == 10 { return "tool-executable"; }
    if index == 11 { return "oracle-executable"; }
    return "";
}

func CompilerIncrementalFactGraphDependencyIndexKnown(index: Int) -> Bool {
    return index >= 0 &&
        index < CompilerIncrementalFactGraphDependencyCount() &&
        CompilerIncrementalFactGraphDependencyAt(index) != "";
}

func CompilerIncrementalFactGraphArtifactCount() -> Int {
    return 9;
}

func CompilerIncrementalFactGraphMirJsonArtifactIndex() -> Int {
    return 3;
}

func CompilerIncrementalFactGraphAbiLayoutArtifactIndex() -> Int {
    return 5;
}

func CompilerIncrementalFactGraphArtifactAt(index: Int) -> String {
    if index == 0 { return "tokens"; }
    if index == 1 { return "ast-text"; }
    if index == 2 { return "semantic-verdict"; }
    if index == 3 { return "mir-json"; }
    if index == 4 { return "air-json"; }
    if index == 5 { return "abi-layout-rows"; }
    if index == 6 { return "emitted-c"; }
    if index == 7 { return "run-output"; }
    if index == 8 { return "parity-artifact"; }
    return "";
}

func CompilerIncrementalFactGraphArtifactIndexKnown(index: Int) -> Bool {
    return index >= 0 &&
        index < CompilerIncrementalFactGraphArtifactCount() &&
        CompilerIncrementalFactGraphArtifactAt(index) != "";
}

func CompilerIncrementalFactGraphVerifierCount() -> Int {
    return 5;
}

func CompilerIncrementalFactGraphArtifactParityVerifierIndex() -> Int {
    return 0;
}

func CompilerIncrementalFactGraphUnsupportedFactVerifierIndex() -> Int {
    return CompilerIncrementalFactGraphVerifierCount() - 1;
}

func CompilerIncrementalFactGraphVerifierAt(index: Int) -> String {
    if index == 0 { return "clean-vs-incremental-artifact-parity"; }
    if index == 1 { return "dependency-fingerprint-match"; }
    if index == 2 { return "owner-fact-presence"; }
    if index == 3 { return "schema-version-match"; }
    if index == 4 { return "unsupported-fact-fail-closed"; }
    return "";
}

func CompilerIncrementalFactGraphVerifierIndexKnown(index: Int) -> Bool {
    return index >= 0 &&
        index < CompilerIncrementalFactGraphVerifierCount() &&
        CompilerIncrementalFactGraphVerifierAt(index) != "";
}

func CompilerIncrementalFactGraphCacheHitPolicy() -> String {
    return "verify-consumed-owner-facts-before-reuse";
}

func CompilerIncrementalFactGraphMissingFactPolicy() -> String {
    return "fail-closed-recompute-no-text-recovery";
}

func EmitCompilerIncrementalCacheParityPlan() -> Void {
    Log(Concat("schema=", CompilerIncrementalFactGraphSchema()));
    Log(Concat("cache_schema=", CompilerIncrementalFactGraphRung0CacheSchema()));
    Log(Concat("source=", CompilerIncrementalCacheParityDefaultSource()));
    Log(Concat("stages=", CompilerIncrementalCacheParityDefaultStages()));
    Log(Concat("verifier=", CompilerIncrementalFactGraphVerifierAt(CompilerIncrementalFactGraphArtifactParityVerifierIndex())));
    Log(Concat("cache_hit_policy=", CompilerIncrementalFactGraphCacheHitPolicy()));
    Log(Concat("missing_fact_policy=", CompilerIncrementalFactGraphMissingFactPolicy()));
}

func CompilerIncrementalFactGraphReady() -> Bool {
    if CompilerIncrementalFactGraphSchema() != "pgy.selfhost.incremental-fact-graph.v1" {
        return false;
    }
    if CompilerIncrementalFactGraphRung0CacheSchema() != "pgy.selfhost.completeness-cache.v1" {
        return false;
    }
    if CompilerIncrementalCacheParitySuiteName() != "self-host-incremental-cache-parity" {
        return false;
    }
    if CompilerIncrementalCacheParityDefaultSource() != "src/self_hosted/compiler/incremental_fact_graph_owner.pgy" {
        return false;
    }
    if CompilerIncrementalCacheParityDefaultStages() != "lexer,parser,semantic,codegen" {
        return false;
    }
    if CompilerIncrementalFactGraphStageCount() <= 0 {
        return false;
    }
    if CompilerIncrementalFactGraphStageAt(CompilerIncrementalFactGraphSourceStageIndex()) != "source-bytes" {
        return false;
    }
    if CompilerIncrementalFactGraphStageAt(CompilerIncrementalFactGraphMirStageIndex()) != "mir-fact-graph" {
        return false;
    }
    if CompilerIncrementalFactGraphStageAt(CompilerIncrementalFactGraphParityStageIndex()) != "parity-evidence" {
        return false;
    }
    if !CompilerIncrementalFactGraphStageIndexKnown(CompilerIncrementalFactGraphSourceStageIndex()) {
        return false;
    }
    if !CompilerIncrementalFactGraphStageIndexKnown(CompilerIncrementalFactGraphParityStageIndex()) {
        return false;
    }
    if CompilerIncrementalFactGraphStageIndexKnown(CompilerIncrementalFactGraphStageCount()) {
        return false;
    }
    if CompilerIncrementalFactGraphDependencyCount() <= 0 {
        return false;
    }
    if CompilerIncrementalFactGraphDependencyAt(CompilerIncrementalFactGraphSourceHashDependencyIndex()) != "source-bytes-hash" {
        return false;
    }
    if CompilerIncrementalFactGraphDependencyAt(CompilerIncrementalFactGraphImportFingerprintDependencyIndex()) != "import-graph-fingerprint" {
        return false;
    }
    if CompilerIncrementalFactGraphDependencyAt(CompilerIncrementalFactGraphAbiRowDependencyIndex()) != "abi-row-fingerprint" {
        return false;
    }
    if CompilerIncrementalFactGraphDependencyAt(CompilerIncrementalFactGraphRuntimeCallRowDependencyIndex()) != "runtime-call-row-fingerprint" {
        return false;
    }
    if !CompilerIncrementalFactGraphDependencyIndexKnown(CompilerIncrementalFactGraphAbiRowDependencyIndex()) {
        return false;
    }
    if CompilerIncrementalFactGraphDependencyIndexKnown(CompilerIncrementalFactGraphDependencyCount()) {
        return false;
    }
    if CompilerIncrementalFactGraphArtifactCount() <= 0 {
        return false;
    }
    if CompilerIncrementalFactGraphArtifactAt(CompilerIncrementalFactGraphMirJsonArtifactIndex()) != "mir-json" {
        return false;
    }
    if CompilerIncrementalFactGraphArtifactAt(CompilerIncrementalFactGraphAbiLayoutArtifactIndex()) != "abi-layout-rows" {
        return false;
    }
    if !CompilerIncrementalFactGraphArtifactIndexKnown(CompilerIncrementalFactGraphMirJsonArtifactIndex()) {
        return false;
    }
    if CompilerIncrementalFactGraphArtifactIndexKnown(CompilerIncrementalFactGraphArtifactCount()) {
        return false;
    }
    if CompilerIncrementalFactGraphVerifierCount() <= 0 {
        return false;
    }
    if CompilerIncrementalFactGraphVerifierAt(CompilerIncrementalFactGraphArtifactParityVerifierIndex()) != "clean-vs-incremental-artifact-parity" {
        return false;
    }
    if CompilerIncrementalFactGraphVerifierAt(CompilerIncrementalFactGraphUnsupportedFactVerifierIndex()) != "unsupported-fact-fail-closed" {
        return false;
    }
    if !CompilerIncrementalFactGraphVerifierIndexKnown(CompilerIncrementalFactGraphUnsupportedFactVerifierIndex()) {
        return false;
    }
    if CompilerIncrementalFactGraphVerifierIndexKnown(CompilerIncrementalFactGraphVerifierCount()) {
        return false;
    }
    return CompilerIncrementalFactGraphCacheHitPolicy() ==
        "verify-consumed-owner-facts-before-reuse" &&
        CompilerIncrementalFactGraphMissingFactPolicy() ==
        "fail-closed-recompute-no-text-recovery";
}
