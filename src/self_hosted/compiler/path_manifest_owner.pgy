func CompilerDriverPipelineOwnerPath() -> String {
    return "src/self_hosted/compiler/driver_pipeline_owner.pgy";
}

func CompilerDriverBootstrapMainPath() -> String {
    return "src/self_hosted/compiler/driver_bootstrap_main.pgy";
}

func CompilerDriverRung0OwnerPath() -> String {
    return "src/self_hosted/compiler/driver_rung0_owner.pgy";
}

func CompilerDriverRung0MainPath() -> String {
    return "src/self_hosted/compiler/driver_rung0_main.pgy";
}

func CompilerDriverCliOwnerPath() -> String {
    return "src/self_hosted/compiler/driver_cli_owner.pgy";
}

func CompilerDriverRung1MainPath() -> String {
    return "src/self_hosted/compiler/driver_rung1_main.pgy";
}

func CompilerDriverRung2OwnerPath() -> String {
    return "src/self_hosted/compiler/driver_rung2_owner.pgy";
}

func CompilerDriverRung2MainPath() -> String {
    return "src/self_hosted/compiler/driver_rung2_main.pgy";
}

func CompilerAuthorityOwnerPath() -> String {
    return "src/self_hosted/compiler/authority_owner.pgy";
}

func CompilerOwnerManifestPath() -> String {
    return "src/self_hosted/OWNERS.md";
}

func CompilerWorldPathProjectionSuiteName() -> String {
    return "compiler-world-paths";
}

func CompilerStagePathCount() -> Int {
    return 5;
}

func CompilerStagePathAt(index: Int) -> String {
    if index == 0 {
        return "src/self_hosted/lexer/main.pgy";
    }
    if index == 1 {
        return "src/self_hosted/parser/main.pgy";
    }
    if index == 2 {
        return "src/self_hosted/semantic/main.pgy";
    }
    if index == 3 {
        return "src/self_hosted/mir_lower/main.pgy";
    }
    if index == 4 {
        return "src/self_hosted/codegen/main.pgy";
    }
    return "";
}

func CompilerStageWorldBindingAt(index: Int) -> String {
    if index == 0 {
        return "lexer|TokenStreamZone|LexerStage|LexSource|LexerTokenPayloadContractReady";
    }
    if index == 1 {
        return "parser|AstTreeZone|ParserStage|ParseTokens|ParserAstTreePayloadContractReady";
    }
    if index == 2 {
        return "semantic|SemanticVerdictZone|SemanticStage|CheckProgramSemantics|SemanticVerdictPayloadContractReady";
    }
    if index == 3 {
        return "mir_lower|MirFactGraphZone|MirLowerStage|LowerProgramFacts|MirFactGraphPayloadContractReady";
    }
    if index == 4 {
        return "codegen|EmissionZone|ProgramEmitter|EmitProgramArtifact|TypedAstArenaPayloadContractReady";
    }
    return "";
}

func CompilerDriverRung0ParityPath() -> String {
    return "tests/self_hosted/parity/driver_rung0_parity.sh";
}

func CompilerDriverRung1ParityPath() -> String {
    return "tests/self_hosted/parity/driver_rung1_parity.sh";
}

func CompilerDriverRung2ParityPath() -> String {
    return "tests/self_hosted/parity/driver_rung2_initializer_parity.sh";
}

func CompilerParityPathCount() -> Int {
    return 9;
}

func CompilerParityPathAt(index: Int) -> String {
    if index == 0 {
        return "tests/self_hosted/parity/lexer_parity.sh";
    }
    if index == 1 {
        return "tests/self_hosted/parity/parser_parity.sh";
    }
    if index == 2 {
        return "tests/self_hosted/parity/semantic_parity.sh";
    }
    if index == 3 {
        return "tests/self_hosted/parity/mir_json_parity.sh";
    }
    if index == 4 {
        return "tests/self_hosted/parity/codegen_parity.sh";
    }
    if index == 5 {
        return "tests/self_hosted/parity/codegen_bootstrap.sh";
    }
    if index == 6 {
        return CompilerDriverRung0ParityPath();
    }
    if index == 7 {
        return CompilerDriverRung1ParityPath();
    }
    if index == 8 {
        return CompilerDriverRung2ParityPath();
    }
    return "";
}

func CompilerWorldManifestPathCount() -> Int {
    return 42;
}

func CompilerWorldManifestPathAt(index: Int) -> String {
    if index == 0 { return CompilerWorldPath(); }
    if index == 1 { return CompilerPathManifestPath(); }
    if index == 2 { return CompilerStageIntentsPath(); }
    if index == 3 { return CompilerTargetCapabilityOwnerPath(); }
    if index == 4 { return CompilerSandboxCapabilityOwnerPath(); }
    if index == 5 { return CompilerSandboxCapabilityManifestPath(); }
    if index == 6 { return CompilerCompatibilityEvolutionOwnerPath(); }
    if index == 7 { return CompilerAirEvidenceOwnerPath(); }
    if index == 8 { return CompilerArtifactZoneOwnerPath(); }
    if index == 9 { return CompilerTestHarnessOwnerPath(); }
    if index == 10 { return CompilerTestHarnessManifestPath(); }
    if index == 11 { return CompilerSubprocessRunnerOwnerPath(); }
    if index == 12 { return CompilerAbiLayoutRowOwnerPath(); }
    if index == 13 { return CompilerBackendAbiLayoutContractOwnerPath(); }
    if index == 14 { return CompilerAbiLayoutTargetPolicyOwnerPath(); }
    if index == 15 { return CompilerAbiLayoutRowManifestPath(); }
    if index == 16 { return CompilerSymbolTableOwnerPath(); }
    if index == 17 { return CompilerStageArtifactOwnerPath(); }
    if index == 18 { return CompilerOwnerManifestPath(); }
    if index < 24 {
        return CompilerStagePathAt(index - 19);
    }
    if index < 33 {
        return CompilerParityPathAt(index - 24);
    }
    if index == 33 { return CompilerAuthorityOwnerPath(); }
    if index == 34 { return CompilerDriverPipelineOwnerPath(); }
    if index == 35 { return CompilerDriverBootstrapMainPath(); }
    if index == 36 { return CompilerDriverRung0OwnerPath(); }
    if index == 37 { return CompilerDriverRung0MainPath(); }
    if index == 38 { return CompilerDriverCliOwnerPath(); }
    if index == 39 { return CompilerDriverRung1MainPath(); }
    if index == 40 { return CompilerDriverRung2OwnerPath(); }
    if index == 41 { return CompilerDriverRung2MainPath(); }
    return "";
}

func CompilerWorldProjectionPrefixCount() -> Int {
    return 3;
}

func CompilerWorldProjectionPathCount() -> Int {
    return CompilerWorldManifestPathCount() + CompilerWorldProjectionPrefixCount();
}

func CompilerWorldProjectionPathAt(index: Int) -> String {
    if index == 0 { return SelfHostSourceDir(); }
    if index == 1 { return SelfHostTestDir(); }
    if index == 2 { return SelfHostParityDir(); }
    return CompilerWorldManifestPathAt(index - CompilerWorldProjectionPrefixCount());
}

func CompilerStagePathManifestReady() -> Bool with caps io_read {
    if CompilerStagePathCount() <= 0 { return false; }
    if CompilerParityPathCount() <= 0 { return false; }
    if CompilerWorldManifestPathCount() <= 0 { return false; }
    if CompilerWorldProjectionPathCount() != CompilerWorldManifestPathCount() + CompilerWorldProjectionPrefixCount() { return false; }
    if CompilerWorldPathProjectionSuiteName() == "" { return false; }
    if SelfHostSourceDir() == "" { return false; }
    if CompilerWorldPath() == "" { return false; }
    if CompilerSandboxCapabilityOwnerPath() == "" { return false; }
    if CompilerSandboxCapabilityManifestPath() == "" { return false; }
    if CompilerBackendAbiLayoutContractOwnerPath() == "" { return false; }
    if CompilerStagePathAt(0) == "" { return false; }
    if CompilerStagePathAt(CompilerStagePathCount() - 1) == "" { return false; }
    if CompilerStagePathAt(CompilerStagePathCount()) != "" { return false; }
    if CompilerStageWorldBindingAt(0) == "" { return false; }
    if CompilerStageWorldBindingAt(CompilerStagePathCount() - 1) == "" { return false; }
    if CompilerStageWorldBindingAt(CompilerStagePathCount()) != "" { return false; }
    if CompilerParityPathAt(0) == "" { return false; }
    if CompilerParityPathAt(CompilerParityPathCount() - 1) == "" { return false; }
    if CompilerParityPathAt(CompilerParityPathCount()) != "" { return false; }
    if CompilerWorldManifestPathAt(0) == "" { return false; }
    if CompilerWorldManifestPathAt(CompilerWorldManifestPathCount() - 1) == "" { return false; }
    if CompilerWorldManifestPathAt(CompilerWorldManifestPathCount()) != "" { return false; }
    if CompilerWorldProjectionPathAt(0) != SelfHostSourceDir() { return false; }
    if CompilerWorldProjectionPathAt(2) != SelfHostParityDir() { return false; }
    if CompilerWorldProjectionPathAt(CompilerWorldProjectionPrefixCount()) != CompilerWorldManifestPathAt(0) { return false; }
    if CompilerWorldProjectionPathAt(CompilerWorldProjectionPathCount() - 1) != CompilerWorldManifestPathAt(CompilerWorldManifestPathCount() - 1) { return false; }
    if CompilerWorldProjectionPathAt(CompilerWorldProjectionPathCount()) != "" { return false; }
    return true;
}
