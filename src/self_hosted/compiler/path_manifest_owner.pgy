    return "src/self_hosted/compiler/subprocess_runner_owner.pgy";
}

func CompilerAbiLayoutRowOwnerPath() -> String {
    return "src/self_hosted/compiler/abi_layout_row_owner.pgy";
}

func CompilerBackendAbiLayoutContractOwnerPath() -> String {
    return "src/self_hosted/compiler/backend_abi_layout_contract_owner.pgy";
}

func CompilerAbiLayoutTargetPolicyOwnerPath() -> String {
    return "src/self_hosted/compiler/abi_layout_target_policy_owner.pgy";
}

func CompilerAbiLayoutRowManifestPath() -> String {
    return "src/self_hosted/compiler/abi_layout_row_manifest.pgy";
