// Self-host compiler path manifest owner.
//
// Owns the stable source/test/parity paths consumed by PgyCompilerWorld. The
// shell manifest in tests/self_hosted/compiler_world_manifest.sh is the harness
// projection of these facts, not a separate source of truth.

func SelfHostSourceDir() -> String {
    return "src/self_hosted";
}

func SelfHostTestDir() -> String {
    return "tests/self_hosted";
}

func SelfHostParityDir() -> String {
    return "tests/self_hosted/parity";
}

func CompilerWorldPath() -> String {
    return "src/self_hosted/compiler/world.pgy";
}

func CompilerPathManifestPath() -> String {
    return "src/self_hosted/compiler/path_manifest_owner.pgy";
}

func CompilerStageIntentsPath() -> String {
    return "src/self_hosted/compiler/stage_intents.pgy";
}

func CompilerTargetCapabilityOwnerPath() -> String {
    return "src/self_hosted/compiler/target_capability_owner.pgy";
}

func CompilerCompatibilityEvolutionOwnerPath() -> String {
    return "src/self_hosted/compiler/compatibility_evolution_owner.pgy";
}

func CompilerAirEvidenceOwnerPath() -> String {
    return "src/self_hosted/compiler/air_evidence_owner.pgy";
}

func CompilerArtifactZoneOwnerPath() -> String {
    return "src/self_hosted/compiler/artifact_zone_owner.pgy";
}

func CompilerTestHarnessOwnerPath() -> String {
    return "src/self_hosted/compiler/test_harness_owner.pgy";
}

func CompilerTestHarnessManifestPath() -> String {
    return "src/self_hosted/compiler/test_harness_manifest.pgy";
}

func CompilerSubprocessRunnerOwnerPath() -> String {
    return "src/self_hosted/compiler/subprocess_runner_owner.pgy";
}

func CompilerAbiLayoutRowOwnerPath() -> String {
    return "src/self_hosted/compiler/abi_layout_row_owner.pgy";
}

func CompilerAbiLayoutRowManifestPath() -> String {
    return "src/self_hosted/compiler/abi_layout_row_manifest.pgy";
}

func CompilerSymbolTableOwnerPath() -> String {
    return "src/self_hosted/compiler/symbol_table_owner.pgy";
}

func CompilerStageArtifactOwnerPath() -> String {
    return "src/self_hosted/compiler/stage_artifact_owner.pgy";
}

func CompilerDriverRung0OwnerPath() -> String {
    return "src/self_hosted/compiler/driver_rung0_owner.pgy";
}

func CompilerDriverRung0MainPath() -> String {
    return "src/self_hosted/compiler/driver_rung0_main.pgy";
}

func CompilerDriverCliOwnerPath() -> String {
    return "src/self_hosted/compiler/driver_cli_owner.pgy";
}

func CompilerDriverRung1MainPath() -> String {
    return "src/self_hosted/compiler/driver_rung1_main.pgy";
}

func CompilerAuthorityOwnerPath() -> String {
    return "src/self_hosted/compiler/authority_owner.pgy";
}

func CompilerOwnerManifestPath() -> String {
    return "src/self_hosted/OWNERS.md";
}

func CompilerWorldPathProjectionSuiteName() -> String {
    return "compiler-world-paths";
}

func CompilerStagePathCount() -> Int {
    return 5;
}

func CompilerStagePathAt(index: Int) -> String {
    if index == 0 {
        return "src/self_hosted/lexer/main.pgy";
    }
    if index == 1 {
        return "src/self_hosted/parser/main.pgy";
    }
    if index == 2 {
        return "src/self_hosted/semantic/main.pgy";
    }
    if index == 3 {
        return "src/self_hosted/mir_lower/main.pgy";
    }
    if index == 4 {
        return "src/self_hosted/codegen/main.pgy";
    }
    return "";
}

func CompilerStageWorldBindingAt(index: Int) -> String {
    if index == 0 {
        return "lexer|TokenStreamZone|LexerStage|LexSource|LexerTokenPayloadContractReady";
    }
    if index == 1 {
        return "parser|AstTreeZone|ParserStage|ParseTokens|ParserAstTreePayloadContractReady";
    }
    if index == 2 {
        return "semantic|SemanticVerdictZone|SemanticStage|CheckProgramSemantics|SemanticVerdictPayloadContractReady";
    }
    if index == 3 {
        return "mir_lower|MirFactGraphZone|MirLowerStage|LowerProgramFacts|MirFactGraphPayloadContractReady";
    }
    if index == 4 {
        return "codegen|EmissionZone|ProgramEmitter|EmitProgramArtifact|TypedAstArenaPayloadContractReady";
    }
    return "";
}

func CompilerDriverRung0ParityPath() -> String {
    return "tests/self_hosted/parity/driver_rung0_parity.sh";
}

func CompilerDriverRung1ParityPath() -> String {
    return "tests/self_hosted/parity/driver_rung1_parity.sh";
}

func CompilerParityPathCount() -> Int {
    return 8;
}

func CompilerParityPathAt(index: Int) -> String {
    if index == 0 {
        return "tests/self_hosted/parity/lexer_parity.sh";
    }
    if index == 1 {
        return "tests/self_hosted/parity/parser_parity.sh";
    }
    if index == 2 {
        return "tests/self_hosted/parity/semantic_parity.sh";
    }
    if index == 3 {
        return "tests/self_hosted/parity/mir_json_parity.sh";
    }
    if index == 4 {
        return "tests/self_hosted/parity/codegen_parity.sh";
    }
    if index == 5 {
        return "tests/self_hosted/parity/codegen_bootstrap.sh";
    }
    if index == 6 {
        return CompilerDriverRung0ParityPath();
    }
    if index == 7 {
        return CompilerDriverRung1ParityPath();
    }
    return "";
}

func CompilerWorldManifestPathCount() -> Int {
    return 33;
}

func CompilerWorldManifestPathAt(index: Int) -> String {
    if index == 0 { return CompilerWorldPath(); }
    if index == 1 { return CompilerPathManifestPath(); }
    if index == 2 { return CompilerStageIntentsPath(); }
    if index == 3 { return CompilerTargetCapabilityOwnerPath(); }
    if index == 4 { return CompilerCompatibilityEvolutionOwnerPath(); }
    if index == 5 { return CompilerAirEvidenceOwnerPath(); }
    if index == 6 { return CompilerArtifactZoneOwnerPath(); }
    if index == 7 { return CompilerTestHarnessOwnerPath(); }
    if index == 8 { return CompilerTestHarnessManifestPath(); }
    if index == 9 { return CompilerSubprocessRunnerOwnerPath(); }
    if index == 10 { return CompilerAbiLayoutRowOwnerPath(); }
    if index == 11 { return CompilerAbiLayoutRowManifestPath(); }
    if index == 12 { return CompilerSymbolTableOwnerPath(); }
    if index == 13 { return CompilerStageArtifactOwnerPath(); }
    if index == 14 { return CompilerOwnerManifestPath(); }
    if index < 20 {
        return CompilerStagePathAt(index - 15);
    }
    if index < 28 {
        return CompilerParityPathAt(index - 20);
    }
    if index == 28 { return CompilerAuthorityOwnerPath(); }
    if index == 29 { return CompilerDriverRung0OwnerPath(); }
    if index == 30 { return CompilerDriverRung0MainPath(); }
    if index == 31 { return CompilerDriverCliOwnerPath(); }
    if index == 32 { return CompilerDriverRung1MainPath(); }
    return "";
}

func CompilerWorldProjectionPathCount() -> Int {
    return CompilerWorldManifestPathCount() + 3;
}

func CompilerWorldProjectionPathAt(index: Int) -> String {
    if index == 0 { return SelfHostSourceDir(); }
    if index == 1 { return SelfHostTestDir(); }
    if index == 2 { return SelfHostParityDir(); }
    return CompilerWorldManifestPathAt(index - 3);
}

func CompilerStagePathManifestReady() -> Bool with caps io_read {
    if CompilerStagePathCount() != 5 { return false; }
    if CompilerParityPathCount() != 8 { return false; }
    if CompilerWorldManifestPathCount() != 33 { return false; }
    if CompilerWorldProjectionPathCount() != 36 { return false; }
    if CompilerWorldPathProjectionSuiteName() == "" { return false; }
    if SelfHostSourceDir() == "" { return false; }
    if CompilerWorldPath() == "" { return false; }
    if CompilerStagePathAt(0) == "" { return false; }
    if CompilerStagePathAt(4) == "" { return false; }
    if CompilerStageWorldBindingAt(0) == "" { return false; }
    if CompilerStageWorldBindingAt(4) == "" { return false; }
    if CompilerParityPathAt(0) == "" { return false; }
    if CompilerParityPathAt(7) == "" { return false; }
    if CompilerWorldManifestPathAt(0) == "" { return false; }
    if CompilerWorldManifestPathAt(32) == "" { return false; }
    if CompilerWorldProjectionPathAt(0) != SelfHostSourceDir() { return false; }
    if CompilerWorldProjectionPathAt(2) != SelfHostParityDir() { return false; }
    if CompilerWorldProjectionPathAt(35) != CompilerWorldManifestPathAt(32) { return false; }
    return true;
}
