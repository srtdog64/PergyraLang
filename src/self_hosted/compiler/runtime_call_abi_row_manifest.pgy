// Runnable runtime-call ABI row projection over runtime_call_abi_row_owner.pgy.

import "runtime_call_abi_row_owner.pgy";
import "runtime_call_abi_structured_fact_owner.pgy";

func CompilerRuntimeCallAbiRowsReady() -> Bool {
    return CompilerRuntimeCallAbiRowFactCount() > 0 &&
        CompilerRuntimeCallAbiRowFactAt(0) == CompilerRuntimeCallAbiRowDomainFact() &&
        CompilerRuntimeCallAbiRowFactAt(CompilerRuntimeCallAbiRowFactCount() - 1) == CompilerRuntimeCallAbiRowCallShapeFact() &&
        CompilerRuntimeCallAbiConcreteRowCount() > 0 &&
        CompilerRuntimeCallAbiRowAt(CompilerRuntimeCallAbiConcreteRowCount()) == "" &&
        CompilerRuntimeCallAbiRowFor("collection", "array-int.new") == CompilerRuntimeCallAbiRow(CompilerRuntimeCallAbiRowInput("collection", "array-int.new", CollectionRuntimeCNewFn(1), CompilerRuntimeCallAbiMaterialGeneratedHelper())) &&
        CompilerRuntimeCallAbiRowFor("collection", "array-long.new") == CompilerRuntimeCallAbiRow(CompilerRuntimeCallAbiRowInput("collection", "array-long.new", CollectionRuntimeCNewFn(7), CompilerRuntimeCallAbiMaterialGeneratedHelper())) &&
        CompilerRuntimeCallAbiRowFor("option-result", "option-int.some") == CompilerRuntimeCallAbiRow(CompilerRuntimeCallAbiRowInput("option-result", "option-int.some", OptionResultRuntimeCOptionSomeFnForPayloadKind(OptionResultRuntimeOptionPayloadKindInt()), CompilerRuntimeCallAbiMaterialGeneratedHelper())) &&
        CompilerRuntimeCallAbiRowFor("option-result", "option-long.some") == CompilerRuntimeCallAbiRow(CompilerRuntimeCallAbiRowInput("option-result", "option-long.some", OptionResultRuntimeCOptionSomeFnForPayloadKind(OptionResultRuntimeOptionPayloadKindLong()), CompilerRuntimeCallAbiMaterialGeneratedHelper())) &&
        CompilerRuntimeCallAbiRowFor("option-result", "option-float.some") == CompilerRuntimeCallAbiRow(CompilerRuntimeCallAbiRowInput("option-result", "option-float.some", OptionResultRuntimeCOptionSomeFnForPayloadKind(OptionResultRuntimeOptionPayloadKindFloat()), CompilerRuntimeCallAbiMaterialGeneratedHelper())) &&
        CompilerRuntimeCallAbiRowFor("option-result", "option-double.some") == CompilerRuntimeCallAbiRow(CompilerRuntimeCallAbiRowInput("option-result", "option-double.some", OptionResultRuntimeCOptionSomeFnForPayloadKind(OptionResultRuntimeOptionPayloadKindDouble()), CompilerRuntimeCallAbiMaterialGeneratedHelper())) &&
        CompilerRuntimeCallAbiRowFor("math", "abs") == CompilerRuntimeCallAbiRow(CompilerRuntimeCallAbiRowInput("math", "abs", MathRuntimeCAbsFn(), CompilerRuntimeCallAbiMaterialGeneratedHelper())) &&
        CompilerRuntimeCallAbiRowFor("checked-arithmetic", "float-to-int") == CompilerRuntimeCallAbiRow(CompilerRuntimeCallAbiRowInput("checked-arithmetic", "float-to-int", CheckedArithmeticRuntimeCFloatToIntegerFn("Int"), CompilerRuntimeCallAbiMaterialTargetLibrary())) &&
        CompilerRuntimeCallAbiRowFor("checked-arithmetic", "float-to-long") == CompilerRuntimeCallAbiRow(CompilerRuntimeCallAbiRowInput("checked-arithmetic", "float-to-long", CheckedArithmeticRuntimeCFloatToIntegerFn("Long"), CompilerRuntimeCallAbiMaterialTargetLibrary())) &&
        CompilerRuntimeCallAbiRowFor("checked-arithmetic", "long-modulo") == CompilerRuntimeCallAbiRow(CompilerRuntimeCallAbiRowInput("checked-arithmetic", "long-modulo", CheckedArithmeticRuntimeCLongModuloFn(), CompilerRuntimeCallAbiMaterialTargetLibrary())) &&
        CompilerRuntimeCallAbiRowFor("checked-arithmetic", "long-division") == CompilerRuntimeCallAbiRow(CompilerRuntimeCallAbiRowInput("checked-arithmetic", "long-division", CheckedArithmeticRuntimeCLongDivisionFn(), CompilerRuntimeCallAbiMaterialTargetLibrary())) &&
        CompilerRuntimeCallAbiRowFor("checked-arithmetic", "int-division") == CompilerRuntimeCallAbiRow(CompilerRuntimeCallAbiRowInput("checked-arithmetic", "int-division", CheckedArithmeticRuntimeCIntDivisionFn(), CompilerRuntimeCallAbiMaterialTargetLibrary())) &&
        CompilerRuntimeCallAbiRowFor("string", "concat") == CompilerRuntimeCallAbiRow(CompilerRuntimeCallAbiRowInput("string", "concat", StringRuntimeCConcatFn(), CompilerRuntimeCallAbiMaterialGeneratedHelper())) &&
        CompilerRuntimeCallAbiRowFor("host-io", "file-exists") == CompilerRuntimeCallAbiRow(CompilerRuntimeCallAbiRowInput("host-io", "file-exists", HostIORuntimeCFileExistsFn(), CompilerRuntimeCallAbiMaterialGeneratedHelper())) &&
        CompilerRuntimeCallAbiRowFor("host-io", "exit") == CompilerRuntimeCallAbiRow(CompilerRuntimeCallAbiRowInput("host-io", "exit", HostIORuntimeCExitFn(), CompilerRuntimeCallAbiMaterialTargetLibrary())) &&
        CompilerRuntimeCallAbiRowFor("host-io", "compiler-artifact-write") == CompilerRuntimeCallAbiRow(CompilerRuntimeCallAbiRowInput("host-io", "compiler-artifact-write", HostIORuntimeCCompilerArtifactWriteFn(), CompilerRuntimeCallAbiMaterialTargetLibrary())) &&
        CompilerRuntimeCallAbiRowFor("host-io", "compiler-artifact-begin") == CompilerRuntimeCallAbiRow(CompilerRuntimeCallAbiRowInput("host-io", "compiler-artifact-begin", HostIORuntimeCCompilerArtifactBeginFn(), CompilerRuntimeCallAbiMaterialTargetLibrary())) &&
        CompilerRuntimeCallAbiRowFor("host-io", "compiler-artifact-commit") == CompilerRuntimeCallAbiRow(CompilerRuntimeCallAbiRowInput("host-io", "compiler-artifact-commit", HostIORuntimeCCompilerArtifactCommitFn(), CompilerRuntimeCallAbiMaterialTargetLibrary())) &&
        CompilerRuntimeCallAbiRowFor("host-io", "compiler-artifact-abort") == CompilerRuntimeCallAbiRow(CompilerRuntimeCallAbiRowInput("host-io", "compiler-artifact-abort", HostIORuntimeCCompilerArtifactAbortFn(), CompilerRuntimeCallAbiMaterialTargetLibrary())) &&
        CompilerRuntimeCallAbiRowFor("native-resource", "Slot<Int>.Claim") == "native-resource|Slot<Int>.Claim|pgy_claim_Int|function|mir_abi_resource_row|returns_container" &&
        CompilerRuntimeCallAbiRowFor("native-resource", "SecureSlot<String>.Write") == "native-resource|SecureSlot<String>.Write|pgy_secure_write_String|function|mir_abi_resource_row|container_ptr_value_token_ptr_to_void" &&
        CompilerRuntimeCallAbiRowFor("native-resource", "Slot<Int>.PinRead") == "native-resource|Slot<Int>.PinRead|pgy_pin_read_Int|function|mir_abi_resource_row|container_ptr_to_pinned_view" &&
        CompilerRuntimeCallAbiRowFor("native-resource", "SecureSlot<String>.UnpinCleanup") == "native-resource|SecureSlot<String>.UnpinCleanup|pgy_secure_unpin_cleanup_String|function|mir_abi_resource_row|pinned_view_ptr_to_void" &&
        CompilerRuntimeCallAbiRowFor("native-resource", "DeviceSlot<Int>.Claim") == "native-resource|DeviceSlot<Int>.Claim|pgy_claim_device_Int|function|mir_abi_resource_row|returns_container" &&
        CompilerRuntimeCallAbiRowFor("native-resource", "DeviceSlot<String>.Write") == "native-resource|DeviceSlot<String>.Write|pgy_device_write_String|function|mir_abi_resource_row|container_ptr_value_to_void" &&
        CompilerRuntimeCallAbiRowFor("native-resource", "DeviceSlot<String>.SubmitRead") == "native-resource|DeviceSlot<String>.SubmitRead|pgy_submit_device_read_String|function|mir_abi_resource_row|container_ptr_to_task_handle" &&
        CompilerRuntimeCallAbiRowFor("selfhost-c-text-builder", "new") == CompilerRuntimeCallAbiRow(CompilerRuntimeCallAbiRowInput("selfhost-c-text-builder", "new", TextBuilderRuntimeCNewFn(), CompilerRuntimeCallAbiMaterialGeneratedHelper())) &&
        CompilerRuntimeCallAbiRowFor("selfhost-c-text-builder", "finish") == CompilerRuntimeCallAbiRow(CompilerRuntimeCallAbiRowInput("selfhost-c-text-builder", "finish", TextBuilderRuntimeCFinishFn(), CompilerRuntimeCallAbiMaterialGeneratedHelper())) &&
        CompilerRuntimeCallAbiRowFor("selfhost-c-text-builder", "allocator.pool") == CompilerRuntimeCallAbiRow(CompilerRuntimeCallAbiRowInput("selfhost-c-text-builder", "allocator.pool", TextBuilderRuntimeCAllocatorPoolFn(), CompilerRuntimeCallAbiMaterialGeneratedHelper())) &&
        CompilerRuntimeCallAbiRowFor("task", TaskRuntimeIsCancelledOperation()) == CompilerRuntimeCallAbiRow(CompilerRuntimeCallAbiRowInput("task", TaskRuntimeIsCancelledOperation(), TaskRuntimeIsCancelledSymbol(), CompilerRuntimeCallAbiMaterialTargetLibrary()));
}

func CompilerRuntimeCallAbiManifestRowAt(index: Int) -> String {
    return Concat(Concat(ToString(index), "|"), CompilerRuntimeCallAbiRowAt(index));
}

// Constructed-resource rows have no fixed table: the self-host spells them
// from the payload type like the native ABI owner does. These probe payloads
// cover a plain nominal, a nested generic, and a generic with a comma and a
// space, so test-mir can compare every spelling rule with the native owner.
// The last payload is longer than the native runtime-name suffix limit, so
// both owners must refuse every row for it.
func CompilerRuntimeCallAbiConstructedProbePayloadCount() -> Int { return 4; }

func CompilerRuntimeCallAbiConstructedProbePayloadAt(index: Int) -> String {
    if index == 0 { return "Vec2"; }
    if index == 1 { return "Array<Int>"; }
    if index == 2 { return "HashMap<String, Int>"; }
    if index == 3 {
        return "OverlongPayloadXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX";
    }
    return "";
}

func CompilerRuntimeCallAbiConstructedProbeContainerAt(index: Int) -> String {
    if index == 0 { return "Slot"; }
    if index == 1 { return "SecureSlot"; }
    if index == 2 { return "DeviceSlot"; }
    return "";
}

func CompilerRuntimeCallAbiConstructedProbeOperationAt(index: Int) -> String {
    if index == 0 { return "Claim"; }
    if index == 1 { return "Read"; }
    if index == 2 { return "Write"; }
    if index == 3 { return "Release"; }
    if index == 4 { return "PinRead"; }
    if index == 5 { return "PinWrite"; }
    if index == 6 { return "PinReadInit"; }
    if index == 7 { return "PinWriteInit"; }
    if index == 8 { return "Unpin"; }
    if index == 9 { return "UnpinCleanup"; }
    if index == 10 { return "SubmitRead"; }
    return "";
}

func CompilerRuntimeCallAbiConstructedProbeCount() -> Int {
    return CompilerRuntimeCallAbiConstructedProbePayloadCount() * 33;
}

// Probe index -> fact: payload-major, then container, then operation.
func CompilerRuntimeCallAbiConstructedProbeFactAt(
    index: Int
) -> CompilerRuntimeCallAbiFact {
    let payload: String =
        CompilerRuntimeCallAbiConstructedProbePayloadAt(index / 33);
    let container: String =
        CompilerRuntimeCallAbiConstructedProbeContainerAt((index / 11) % 3);
    let operation: String =
        CompilerRuntimeCallAbiConstructedProbeOperationAt(index % 11);
    return CompilerRuntimeCallAbiFactForConstructedResource(
        Concat(Concat(Concat(container, "<"), payload), ">"), operation);
}

func CompilerRuntimeCallAbiConstructedProbeRow(
    fact: CompilerRuntimeCallAbiFact
) -> String {
    var row: String = Concat("constructed|", fact.domain);
    row = Concat(Concat(row, "|"), fact.operation);
    row = Concat(Concat(row, "|"), fact.symbol);
    row = Concat(Concat(row, "|"), fact.symbol_kind);
    row = Concat(Concat(row, "|"), fact.materialization);
    row = Concat(Concat(row, "|"), fact.call_shape);
    return Concat(Concat(row, "|"), ToString(fact.runtime_call_abi_id));
}

func Main() -> Void {
    if !CompilerRuntimeCallAbiRowsReady() {
        Log("RUNTIME_CALL_ABI ERROR: row owner is not ready");
        Exit(1);
    }
    Log(Concat("schema=", CompilerRuntimeCallAbiRowSchema()));
    Log(Concat("count=", ToString(CompilerRuntimeCallAbiConcreteRowCount())));
    var i: Int = 0;
    while i < CompilerRuntimeCallAbiConcreteRowCount() {
        Log(CompilerRuntimeCallAbiManifestRowAt(i));
        i = i + 1;
    }
    var payload: Int = 0;
    while payload < CompilerRuntimeCallAbiConstructedProbePayloadCount() {
        Log(Concat("constructed_probe=",
            CompilerRuntimeCallAbiConstructedProbePayloadAt(payload)));
        payload = payload + 1;
    }
    var constructed: Int = 0;
    var probe: Int = 0;
    while probe < CompilerRuntimeCallAbiConstructedProbeCount() {
        if CompilerRuntimeCallAbiConstructedProbeFactAt(probe).ok {
            constructed = constructed + 1;
        }
        probe = probe + 1;
    }
    Log(Concat("constructed_count=", ToString(constructed)));
    probe = 0;
    while probe < CompilerRuntimeCallAbiConstructedProbeCount() {
        let fact: CompilerRuntimeCallAbiFact =
            CompilerRuntimeCallAbiConstructedProbeFactAt(probe);
        if fact.ok {
            Log(CompilerRuntimeCallAbiConstructedProbeRow(fact));
        }
        probe = probe + 1;
    }
}
