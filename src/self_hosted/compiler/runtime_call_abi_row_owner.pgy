// Self-host compiler runtime-call ABI row owner.
//
// Projects runtime helper/target-library call spellings from the runtime ABI
// owners into one stable row artifact. Backend participants may consume the
// domain owners directly, but parity gates consume this row projection so the
// call ABI does not become a shell or backend-local truth.

import "../codegen/runtime_abi/collection_runtime_owner.pgy";
import "../codegen/runtime_abi/host_io_runtime_owner.pgy";
import "../codegen/runtime_abi/math_runtime_owner.pgy";
import "../codegen/runtime_abi/option_result_runtime_owner.pgy";
import "../codegen/runtime_abi/string_runtime_owner.pgy";

func CompilerRuntimeCallAbiRowSchema() -> String {
    return "pgy.selfhost.runtime-call-abi-row.v1";
}

func CompilerRuntimeCallAbiRowFactCount() -> Int {
    return 5;
}

func CompilerRuntimeCallAbiRowDomainFact() -> String { return "domain"; }
func CompilerRuntimeCallAbiRowOperationFact() -> String { return "operation"; }
func CompilerRuntimeCallAbiRowSymbolFact() -> String { return "symbol"; }
func CompilerRuntimeCallAbiRowSymbolKindFact() -> String { return "symbol_kind"; }
func CompilerRuntimeCallAbiRowMaterializationFact() -> String { return "materialization"; }

func CompilerRuntimeCallAbiRowFactAt(index: Int) -> String {
    if index == 0 { return CompilerRuntimeCallAbiRowDomainFact(); }
    if index == 1 { return CompilerRuntimeCallAbiRowOperationFact(); }
    if index == 2 { return CompilerRuntimeCallAbiRowSymbolFact(); }
    if index == 3 { return CompilerRuntimeCallAbiRowSymbolKindFact(); }
    if index == 4 { return CompilerRuntimeCallAbiRowMaterializationFact(); }
    return "";
}

func CompilerRuntimeCallAbiMaterialGeneratedHelper() -> String {
    return "generated_runtime_helper";
}

func CompilerRuntimeCallAbiMaterialGeneratedInternal() -> String {
    return "generated_internal_helper";
}

func CompilerRuntimeCallAbiMaterialTargetLibrary() -> String {
    return "target_library";
}

struct CompilerRuntimeCallAbiRowInput {
    let domain: String;
    let operation: String;
    let symbol: String;
    let materialization: String;
}

func CompilerRuntimeCallAbiRow(input: CompilerRuntimeCallAbiRowInput) -> String {
    let row: String = Concat(input.domain, "|");
    row = Concat(row, Concat(input.operation, "|"));
    row = Concat(row, Concat(input.symbol, "|"));
    row = Concat(row, "function|");
    return Concat(row, input.materialization);
}

func CompilerRuntimeCallAbiConcreteRowCount() -> Int {
    return 87;
}

