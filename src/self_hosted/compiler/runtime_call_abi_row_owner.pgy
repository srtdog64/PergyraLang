// Self-host compiler runtime-call ABI row projection.
//
// Projects runtime helper/target-library call spellings into one stable row
// artifact. The native MIR ABI owner is the authority for MIR resource rows;
// this file is a self-host projection consumed by parity and artifact gates,
// never a second semantic owner.

import "../codegen/runtime_abi/collection_runtime_owner.pgy";
import "../codegen/runtime_abi/checked_arithmetic_runtime_owner.pgy";
import "../codegen/runtime_abi/host_io_runtime_owner.pgy";
import "../codegen/runtime_abi/math_runtime_owner.pgy";
import "../codegen/runtime_abi/option_result_runtime_owner.pgy";
import "../codegen/runtime_abi/string_runtime_owner.pgy";
import "../codegen/runtime_abi/text_builder_runtime_owner.pgy";

func CompilerRuntimeCallAbiRowSchema() -> String {
    return "pgy.selfhost.runtime-call-abi-row.v2";
}

func CompilerRuntimeCallAbiRowFactCount() -> Int {
    return 6;
}

func CompilerRuntimeCallAbiRowDomainFact() -> String { return "domain"; }
func CompilerRuntimeCallAbiRowOperationFact() -> String { return "operation"; }
func CompilerRuntimeCallAbiRowSymbolFact() -> String { return "symbol"; }
func CompilerRuntimeCallAbiRowSymbolKindFact() -> String { return "symbol_kind"; }
func CompilerRuntimeCallAbiRowMaterializationFact() -> String { return "materialization"; }
func CompilerRuntimeCallAbiRowCallShapeFact() -> String { return "call_shape"; }

func CompilerRuntimeCallAbiRowFactAt(index: Int) -> String {
    if index == 0 { return CompilerRuntimeCallAbiRowDomainFact(); }
    if index == 1 { return CompilerRuntimeCallAbiRowOperationFact(); }
    if index == 2 { return CompilerRuntimeCallAbiRowSymbolFact(); }
    if index == 3 { return CompilerRuntimeCallAbiRowSymbolKindFact(); }
    if index == 4 { return CompilerRuntimeCallAbiRowMaterializationFact(); }
    if index == 5 { return CompilerRuntimeCallAbiRowCallShapeFact(); }
    return "";
}

func CompilerRuntimeCallAbiMaterialGeneratedHelper() -> String {
    return "generated_runtime_helper";
}

func CompilerRuntimeCallAbiMaterialGeneratedInternal() -> String {
    return "generated_internal_helper";
}

func CompilerRuntimeCallAbiMaterialTargetLibrary() -> String {
    return "target_library";
}

func CompilerRuntimeCallAbiMaterialMirResourceRow() -> String {
    return "mir_abi_resource_row";
}

func CompilerRuntimeCallAbiTextBuilderCallShape(operation: String) -> String {
    if operation == "allocator.result" { return "returns_allocator"; }
    if operation == "allocator.destroy" { return "allocator_ptr_to_void"; }
    if operation == "new" { return "capacity_to_builder"; }
    if operation == "append" { return "builder_ptr_string_to_void"; }
    if operation == "finish" { return "builder_ptr_allocator_ptr_to_string"; }
    if operation == "drop" { return "builder_ptr_to_void"; }
    return "text_builder_runtime_call";
}

struct CompilerRuntimeCallAbiRowInput {
    let domain: String;
    let operation: String;
    let symbol: String;
    let materialization: String;
}

func CompilerRuntimeCallAbiNativeResourceCallShape(operation: String) -> String {
    let is_secure_resource: Bool = StringContains(operation, "SecureSlot<");
    if StringContains(operation, ".SubmitRead") {
        return "container_ptr_to_task_handle";
    }
    if StringContains(operation, ".PinReadInit") || StringContains(operation, ".PinWriteInit") {
        if is_secure_resource { return "pinned_view_ptr_container_ptr_token_ptr_to_void"; }
        return "pinned_view_ptr_container_ptr_to_void";
    }
    if StringContains(operation, ".PinRead") || StringContains(operation, ".PinWrite") {
        if is_secure_resource { return "container_ptr_token_ptr_to_pinned_view"; }
        return "container_ptr_to_pinned_view";
    }
    if StringContains(operation, ".UnpinCleanup") || StringContains(operation, ".Unpin") {
        return "pinned_view_ptr_to_void";
    }
    if StringContains(operation, ".Claim") {
        if is_secure_resource { return "token_ptr_to_container"; }
        return "returns_container";
    }
    if StringContains(operation, ".Read") {
        if is_secure_resource { return "container_ptr_token_ptr_to_value"; }
        return "container_ptr_to_value";
    }
    if StringContains(operation, ".Release") {
        if is_secure_resource { return "container_ptr_token_ptr_to_void"; }
        return "container_ptr_to_void";
    }
    if StringContains(operation, ".Write") {
        if is_secure_resource { return "container_ptr_value_token_ptr_to_void"; }
        return "container_ptr_value_to_void";
    }
    return "unknown_native_resource_call_shape";
}

func CompilerRuntimeCallAbiCollectionCallShape(operation: String) -> String {
    if StringContains(operation, ".new") { return "returns_collection"; }
    if StringContains(operation, ".push") { return "collection_value_to_void"; }
    if StringContains(operation, ".set") { return "collection_index_value_to_void"; }
    if StringContains(operation, ".get") { return "collection_index_to_value"; }
    if StringContains(operation, ".len") { return "collection_to_int"; }
    if StringContains(operation, ".pop") { return "collection_to_value"; }
    if StringContains(operation, ".sort") || StringContains(operation, ".reverse") {
        return "collection_to_collection";
    }
    if StringContains(operation, ".map") || StringContains(operation, ".filter") {
        return "collection_callback_to_collection";
    }
    return "collection_runtime_call";
}

func CompilerRuntimeCallAbiOptionResultCallShape(operation: String) -> String {
    if StringContains(operation, ".some") { return "value_to_option"; }
    if StringContains(operation, ".none") { return "returns_option"; }
    if operation == "option.is-some" { return "option_to_bool"; }
    if operation == "option.unwrap" { return "option_to_value"; }
    if operation == "result.ok" || operation == "result.err" { return "value_to_result"; }
    if operation == "result.is-ok" || operation == "result.is-err" { return "result_to_bool"; }
    if operation == "result.unwrap" { return "result_to_value"; }
    if operation == "result.unwrap-or" { return "result_value_to_value"; }
    return "option_result_runtime_call";
}

func CompilerRuntimeCallAbiMathCallShape(operation: String) -> String {
    if operation == "abs" { return "int_to_int"; }
    if operation == "min" || operation == "max" { return "int_int_to_int"; }
    if operation == "pow" { return "double_double_to_double"; }
    if operation == "seed-random" { return "int_to_void"; }
    if operation == "random" { return "returns_int"; }
    return "float_to_float";
}

func CompilerRuntimeCallAbiCheckedArithmeticCallShape(
    operation: String
) -> String {
    if operation == "float-to-int" { return "double_to_int"; }
    if operation == "float-to-long" { return "double_to_long"; }
    return "checked_arithmetic_runtime_call";
}

func CompilerRuntimeCallAbiStringCallShape(operation: String) -> String {
    if operation == "concat" { return "string_string_to_string"; }
    if operation == "log" || operation == "print" { return "string_to_void"; }
    if operation == "formatted-print" { return "format_varargs_to_int"; }
    if operation == "compare" { return "string_string_to_int"; }
    if operation == "length" { return "string_to_int"; }
    if operation == "contains" { return "string_string_to_bool"; }
    if operation == "index-of" { return "string_string_to_int"; }
    if operation == "split" { return "string_string_to_array_string"; }
    if operation == "to-int" { return "string_to_int"; }
    if operation == "to-float" { return "string_to_float"; }
    if operation == "trim" || operation == "to-upper" || operation == "to-lower" {
        return "string_to_string";
    }
    if operation == "replace" { return "string_string_string_to_string"; }
    if operation == "char-code" { return "string_to_int"; }
    if operation == "char-at-n" { return "string_int_to_string"; }
    if operation == "sub-contains-with-len" || operation == "sub-equals-with-len" || operation == "sub-starts-with-len" {
        return "string_int_string_int_to_bool";
    }
    if operation == "sub-index-of-with-len" { return "string_int_string_int_to_int"; }
    if operation == "substring" { return "string_int_int_to_string"; }
    if operation == "join" { return "array_string_string_to_string"; }
    if operation == "to-string" { return "value_to_string"; }
    return "string_runtime_call";
}

func CompilerRuntimeCallAbiHostIoCallShape(operation: String) -> String {
    if operation == "file-exists" || operation == "path-allowed" {
        return "string_to_bool";
    }
    if operation == "write-file" { return "string_string_to_bool"; }
    if operation == "file-open" || operation == "secure-file-open" {
        return "string_string_to_handle";
    }
    if operation == "file-write" { return "handle_string_to_bool"; }
    if operation == "file-close" { return "handle_to_void"; }
    if operation == "file-read" { return "handle_to_string"; }
    if operation == "read-file" { return "string_to_string"; }
    if operation == "read-stdin" { return "returns_string"; }
    if operation == "dir-walk" { return "string_to_array_string"; }
    if operation == "dir-walk-rec" { return "string_array_string_to_void"; }
    if operation == "string-compare" { return "string_string_to_int"; }
    if operation == "args" { return "returns_array_string"; }
    if operation == "exit" { return "int_to_noreturn"; }
    return "host_io_runtime_call";
}

func CompilerRuntimeCallAbiCallShape(domain: String, operation: String, materialization: String) -> String {
    if domain == "native-resource" {
        return CompilerRuntimeCallAbiNativeResourceCallShape(operation);
    }
    if domain == "collection" {
        return CompilerRuntimeCallAbiCollectionCallShape(operation);
    }
    if domain == "option-result" {
        return CompilerRuntimeCallAbiOptionResultCallShape(operation);
    }
    if domain == "math" {
        return CompilerRuntimeCallAbiMathCallShape(operation);
    }
    if domain == "checked-arithmetic" {
        return CompilerRuntimeCallAbiCheckedArithmeticCallShape(operation);
    }
    if domain == "string" {
        return CompilerRuntimeCallAbiStringCallShape(operation);
    }
    if domain == "host-io" {
        return CompilerRuntimeCallAbiHostIoCallShape(operation);
    }
    if domain == "selfhost-c-text-builder" {
        return CompilerRuntimeCallAbiTextBuilderCallShape(operation);
    }
    if materialization == CompilerRuntimeCallAbiMaterialTargetLibrary() {
        return "target_library_call";
    }
    return "runtime_helper_call";
}

func CompilerRuntimeCallAbiRow(input: CompilerRuntimeCallAbiRowInput) -> String {
    let row: String = Concat(input.domain, "|");
    row = Concat(row, Concat(input.operation, "|"));
    row = Concat(row, Concat(input.symbol, "|"));
    row = Concat(row, "function|");
    row = Concat(row, Concat(input.materialization, "|"));
    return Concat(row, CompilerRuntimeCallAbiCallShape(input.domain, input.operation, input.materialization));
}

func CompilerRuntimeCallAbiConcreteRowCount() -> Int {
    return 245;
}

func CompilerRuntimeCallAbiNativeScalarTypeAt(index: Int) -> String {
    if index == 0 { return "Int"; }
    if index == 1 { return "Long"; }
    if index == 2 { return "Float"; }
    if index == 3 { return "Double"; }
    if index == 4 { return "Bool"; }
    if index == 5 { return "String"; }
    return "";
}

func CompilerRuntimeCallAbiNativeResourceType(kind: Int, scalar_index: Int) -> String {
    let scalar: String = CompilerRuntimeCallAbiNativeScalarTypeAt(scalar_index);
    if kind == 0 { return Concat(Concat("Slot<", scalar), ">"); }
    if kind == 1 { return Concat(Concat("SecureSlot<", scalar), ">"); }
    if kind == 2 { return Concat(Concat("DeviceSlot<", scalar), ">"); }
    return "";
}

func CompilerRuntimeCallAbiNativeResourceOperationAt(index: Int) -> String {
    if index == 0 { return "Claim"; }
    if index == 1 { return "Read"; }
    if index == 2 { return "Release"; }
    if index == 3 { return "Write"; }
    return "";
}

func CompilerRuntimeCallAbiNativePinOperationAt(index: Int) -> String {
    if index == 0 { return "PinRead"; }
    if index == 1 { return "PinWrite"; }
    if index == 2 { return "PinReadInit"; }
    if index == 3 { return "PinWriteInit"; }
    if index == 4 { return "Unpin"; }
    if index == 5 { return "UnpinCleanup"; }
    return "";
}

func CompilerRuntimeCallAbiNativeResourceSymbol(kind: Int, scalar_index: Int, op_index: Int) -> String {
    let scalar: String = CompilerRuntimeCallAbiNativeScalarTypeAt(scalar_index);
    if kind == 0 {
        if op_index == 0 { return Concat("pgy_claim_", scalar); }
        if op_index == 1 { return Concat("pgy_read_", scalar); }
        if op_index == 2 { return Concat("pgy_release_", scalar); }
        if op_index == 3 { return Concat("pgy_write_", scalar); }
    }
    if kind == 1 {
        if op_index == 0 { return Concat("pgy_claim_secure_", scalar); }
        if op_index == 1 { return Concat("pgy_secure_read_", scalar); }
        if op_index == 2 { return Concat("pgy_secure_release_", scalar); }
        if op_index == 3 { return Concat("pgy_secure_write_", scalar); }
    }
    if kind == 2 {
        if op_index == 0 { return Concat("pgy_claim_device_", scalar); }
        if op_index == 1 { return Concat("pgy_device_read_", scalar); }
        if op_index == 2 { return Concat("pgy_release_device_", scalar); }
        if op_index == 3 { return Concat("pgy_device_write_", scalar); }
    }
    return "";
}

func CompilerRuntimeCallAbiNativePinSymbol(kind: Int, scalar_index: Int, op_index: Int) -> String {
    let scalar: String = CompilerRuntimeCallAbiNativeScalarTypeAt(scalar_index);
    if kind == 0 {
        if op_index == 0 { return Concat("pgy_pin_read_", scalar); }
        if op_index == 1 { return Concat("pgy_pin_write_", scalar); }
        if op_index == 2 { return Concat("pgy_pin_read_init_", scalar); }
        if op_index == 3 { return Concat("pgy_pin_write_init_", scalar); }
        if op_index == 4 { return Concat("pgy_unpin_", scalar); }
        if op_index == 5 { return Concat("pgy_unpin_cleanup_", scalar); }
    }
    if kind == 1 {
        if op_index == 0 { return Concat("pgy_secure_pin_read_", scalar); }
        if op_index == 1 { return Concat("pgy_secure_pin_write_", scalar); }
        if op_index == 2 { return Concat("pgy_secure_pin_read_init_", scalar); }
        if op_index == 3 { return Concat("pgy_secure_pin_write_init_", scalar); }
        if op_index == 4 { return Concat("pgy_secure_unpin_", scalar); }
        if op_index == 5 { return Concat("pgy_secure_unpin_cleanup_", scalar); }
    }
    return "";
}

func CompilerRuntimeCallAbiNativeSlotResourceRowAt(index: Int) -> String {
    let kind: Int = index / 24;
    let inner: Int = (index % 24) / 4;
    let op: Int = index % 4;
    let type_name: String = CompilerRuntimeCallAbiNativeResourceType(kind, inner);
    let operation: String = CompilerRuntimeCallAbiNativeResourceOperationAt(op);
    return CompilerRuntimeCallAbiRow(CompilerRuntimeCallAbiRowInput(
        "native-resource",
        Concat(Concat(type_name, "."), operation),
        CompilerRuntimeCallAbiNativeResourceSymbol(kind, inner, op),
        CompilerRuntimeCallAbiMaterialMirResourceRow()));
}

func CompilerRuntimeCallAbiNativePinRowAt(index: Int) -> String {
    let kind: Int = index / 36;
    let inner: Int = (index % 36) / 6;
    let op: Int = index % 6;
    let type_name: String = CompilerRuntimeCallAbiNativeResourceType(kind, inner);
    let operation: String = CompilerRuntimeCallAbiNativePinOperationAt(op);
    return CompilerRuntimeCallAbiRow(CompilerRuntimeCallAbiRowInput(
        "native-resource",
        Concat(Concat(type_name, "."), operation),
        CompilerRuntimeCallAbiNativePinSymbol(kind, inner, op),
        CompilerRuntimeCallAbiMaterialMirResourceRow()));
}

func CompilerRuntimeCallAbiNativeDeviceSubmitRowAt(index: Int) -> String {
    let scalar: String = CompilerRuntimeCallAbiNativeScalarTypeAt(index);
    let type_name: String = CompilerRuntimeCallAbiNativeResourceType(2, index);
    return CompilerRuntimeCallAbiRow(CompilerRuntimeCallAbiRowInput(
        "native-resource",
        Concat(Concat(type_name, "."), "SubmitRead"),
        Concat("pgy_submit_device_read_", scalar),
        CompilerRuntimeCallAbiMaterialMirResourceRow()));
}

func CompilerRuntimeCallAbiNativeDeviceSubmitSymbol(index: Int) -> String {
    let scalar: String = CompilerRuntimeCallAbiNativeScalarTypeAt(index);
    if scalar == "" { return ""; }
    return Concat("pgy_submit_device_read_", scalar);
}

