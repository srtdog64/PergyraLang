func CompilerRuntimeCallAbiRowAt(index: Int) -> String {
    if index >= 0 && index < 22 { return CompilerRuntimeCallAbiCollectionRowAt(index); }
    if index >= 22 && index < 34 { return CompilerRuntimeCallAbiOptionResultRowAt(index - 22); }
    if index >= 34 && index < 43 { return CompilerRuntimeCallAbiMathRowAt(index - 34); }
    if index >= 43 && index < 67 { return CompilerRuntimeCallAbiStringRowAt(index - 43); }
    if index >= 67 && index < 83 { return CompilerRuntimeCallAbiHostIoRowAt(index - 67); }
    return "";
}

func CompilerRuntimeCallAbiRowsReady() -> Bool {
    return CompilerRuntimeCallAbiRowFactCount() == 5 &&
        CompilerRuntimeCallAbiRowFactAt(0) == CompilerRuntimeCallAbiRowDomainFact() &&
        CompilerRuntimeCallAbiRowFactAt(1) == CompilerRuntimeCallAbiRowOperationFact() &&
        CompilerRuntimeCallAbiRowFactAt(2) == CompilerRuntimeCallAbiRowSymbolFact() &&
        CompilerRuntimeCallAbiRowFactAt(3) == CompilerRuntimeCallAbiRowSymbolKindFact() &&
        CompilerRuntimeCallAbiRowFactAt(4) == CompilerRuntimeCallAbiRowMaterializationFact() &&
        CompilerRuntimeCallAbiConcreteRowCount() == 83 &&
        CompilerRuntimeCallAbiRowAt(0) == CompilerRuntimeCallAbiRow("collection", "array-int.new", CollectionRuntimeCNewFn(1), CompilerRuntimeCallAbiMaterialGeneratedHelper()) &&
        CompilerRuntimeCallAbiRowAt(22) == CompilerRuntimeCallAbiRow("option-result", "option-int.some", OptionResultRuntimeCOptionSomeFnForPayloadKind(OptionResultRuntimeOptionPayloadKindInt()), CompilerRuntimeCallAbiMaterialGeneratedHelper()) &&
        CompilerRuntimeCallAbiRowAt(34) == CompilerRuntimeCallAbiRow("math", "abs", MathRuntimeCAbsFn(), CompilerRuntimeCallAbiMaterialGeneratedHelper()) &&
        CompilerRuntimeCallAbiRowAt(43) == CompilerRuntimeCallAbiRow("string", "concat", StringRuntimeCConcatFn(), CompilerRuntimeCallAbiMaterialGeneratedHelper()) &&
        CompilerRuntimeCallAbiRowAt(67) == CompilerRuntimeCallAbiRow("host-io", "file-exists", HostIORuntimeCFileExistsFn(), CompilerRuntimeCallAbiMaterialGeneratedHelper()) &&
        CompilerRuntimeCallAbiRowAt(82) == CompilerRuntimeCallAbiRow("host-io", "exit", HostIORuntimeCExitFn(), CompilerRuntimeCallAbiMaterialTargetLibrary());
}
