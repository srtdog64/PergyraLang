func CompilerRuntimeCallAbiRowAt(index: Int) -> String {
    if index >= 0 && index < 22 { return CompilerRuntimeCallAbiCollectionRowAt(index); }
    if index >= 22 && index < 38 { return CompilerRuntimeCallAbiOptionResultRowAt(index - 22); }
    if index >= 38 && index < 47 { return CompilerRuntimeCallAbiMathRowAt(index - 38); }
    if index >= 47 && index < 71 { return CompilerRuntimeCallAbiStringRowAt(index - 47); }
    if index >= 71 && index < 87 { return CompilerRuntimeCallAbiHostIoRowAt(index - 71); }
    if index >= 87 && index < 135 { return CompilerRuntimeCallAbiNativeSlotResourceRowAt(index - 87); }
    if index >= 135 && index < 207 { return CompilerRuntimeCallAbiNativePinRowAt(index - 135); }
    if index >= 207 && index < 231 { return CompilerRuntimeCallAbiNativeSlotResourceRowAt(index - 159); }
    if index >= 231 && index < 237 { return CompilerRuntimeCallAbiNativeDeviceSubmitRowAt(index - 231); }
    return "";
}

func CompilerRuntimeCallAbiRowsReady() -> Bool {
    return CompilerRuntimeCallAbiRowFactCount() == 5 &&
        CompilerRuntimeCallAbiRowFactAt(0) == CompilerRuntimeCallAbiRowDomainFact() &&
        CompilerRuntimeCallAbiRowFactAt(1) == CompilerRuntimeCallAbiRowOperationFact() &&
        CompilerRuntimeCallAbiRowFactAt(2) == CompilerRuntimeCallAbiRowSymbolFact() &&
        CompilerRuntimeCallAbiRowFactAt(3) == CompilerRuntimeCallAbiRowSymbolKindFact() &&
        CompilerRuntimeCallAbiRowFactAt(4) == CompilerRuntimeCallAbiRowMaterializationFact() &&
        CompilerRuntimeCallAbiConcreteRowCount() == 237 &&
        CompilerRuntimeCallAbiRowAt(0) == CompilerRuntimeCallAbiRow(CompilerRuntimeCallAbiRowInput("collection", "array-int.new", CollectionRuntimeCNewFn(1), CompilerRuntimeCallAbiMaterialGeneratedHelper())) &&
        CompilerRuntimeCallAbiRowAt(22) == CompilerRuntimeCallAbiRow(CompilerRuntimeCallAbiRowInput("option-result", "option-int.some", OptionResultRuntimeCOptionSomeFnForPayloadKind(OptionResultRuntimeOptionPayloadKindInt()), CompilerRuntimeCallAbiMaterialGeneratedHelper())) &&
        CompilerRuntimeCallAbiRowAt(24) == CompilerRuntimeCallAbiRow(CompilerRuntimeCallAbiRowInput("option-result", "option-float.some", OptionResultRuntimeCOptionSomeFnForPayloadKind(OptionResultRuntimeOptionPayloadKindFloat()), CompilerRuntimeCallAbiMaterialGeneratedHelper())) &&
