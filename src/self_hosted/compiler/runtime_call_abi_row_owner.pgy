// Self-host compiler runtime-call ABI row owner.
//
// Projects runtime helper/target-library call spellings from the runtime ABI
// owners into one stable row artifact. Backend participants may consume the
// domain owners directly, but parity gates consume this row projection so the
// call ABI does not become a shell or backend-local truth.

import "../codegen/runtime_abi/collection_runtime_owner.pgy";
import "../codegen/runtime_abi/host_io_runtime_owner.pgy";
import "../codegen/runtime_abi/math_runtime_owner.pgy";
import "../codegen/runtime_abi/option_result_runtime_owner.pgy";
import "../codegen/runtime_abi/string_runtime_owner.pgy";

func CompilerRuntimeCallAbiRowSchema() -> String {
    return "pgy.selfhost.runtime-call-abi-row.v1";
}

func CompilerRuntimeCallAbiRowFactCount() -> Int {
    return 5;
}

func CompilerRuntimeCallAbiRowDomainFact() -> String { return "domain"; }
func CompilerRuntimeCallAbiRowOperationFact() -> String { return "operation"; }
func CompilerRuntimeCallAbiRowSymbolFact() -> String { return "symbol"; }
func CompilerRuntimeCallAbiRowSymbolKindFact() -> String { return "symbol_kind"; }
func CompilerRuntimeCallAbiRowMaterializationFact() -> String { return "materialization"; }

func CompilerRuntimeCallAbiRowFactAt(index: Int) -> String {
    if index == 0 { return CompilerRuntimeCallAbiRowDomainFact(); }
    if index == 1 { return CompilerRuntimeCallAbiRowOperationFact(); }
    if index == 2 { return CompilerRuntimeCallAbiRowSymbolFact(); }
    if index == 3 { return CompilerRuntimeCallAbiRowSymbolKindFact(); }
    if index == 4 { return CompilerRuntimeCallAbiRowMaterializationFact(); }
    return "";
}

func CompilerRuntimeCallAbiMaterialGeneratedHelper() -> String {
    return "generated_runtime_helper";
}

func CompilerRuntimeCallAbiMaterialGeneratedInternal() -> String {
    return "generated_internal_helper";
}

func CompilerRuntimeCallAbiMaterialTargetLibrary() -> String {
    return "target_library";
}

func CompilerRuntimeCallAbiMaterialMirResourceRow() -> String {
    return "mir_abi_resource_row";
}

struct CompilerRuntimeCallAbiRowInput {
    let domain: String;
    let operation: String;
    let symbol: String;
    let materialization: String;
}

func CompilerRuntimeCallAbiRow(input: CompilerRuntimeCallAbiRowInput) -> String {
    let row: String = Concat(input.domain, "|");
    row = Concat(row, Concat(input.operation, "|"));
    row = Concat(row, Concat(input.symbol, "|"));
    row = Concat(row, "function|");
    return Concat(row, input.materialization);
}

func CompilerRuntimeCallAbiConcreteRowCount() -> Int {
    return 237;
}

func CompilerRuntimeCallAbiNativeScalarTypeAt(index: Int) -> String {
    if index == 0 { return "Int"; }
    if index == 1 { return "Long"; }
    if index == 2 { return "Float"; }
    if index == 3 { return "Double"; }
    if index == 4 { return "Bool"; }
    if index == 5 { return "String"; }
    return "";
}

func CompilerRuntimeCallAbiNativeResourceType(kind: Int, scalar_index: Int) -> String {
    let scalar: String = CompilerRuntimeCallAbiNativeScalarTypeAt(scalar_index);
    if kind == 0 { return Concat(Concat("Slot<", scalar), ">"); }
    if kind == 1 { return Concat(Concat("SecureSlot<", scalar), ">"); }
    if kind == 2 { return Concat(Concat("DeviceSlot<", scalar), ">"); }
    return "";
}

func CompilerRuntimeCallAbiNativeResourceOperationAt(index: Int) -> String {
    if index == 0 { return "Claim"; }
    if index == 1 { return "Read"; }
    if index == 2 { return "Release"; }
    if index == 3 { return "Write"; }
    return "";
}

func CompilerRuntimeCallAbiNativePinOperationAt(index: Int) -> String {
    if index == 0 { return "PinRead"; }
    if index == 1 { return "PinWrite"; }
    if index == 2 { return "PinReadInit"; }
    if index == 3 { return "PinWriteInit"; }
    if index == 4 { return "Unpin"; }
    if index == 5 { return "UnpinCleanup"; }
    return "";
}

func CompilerRuntimeCallAbiNativeResourceSymbol(kind: Int, scalar_index: Int, op_index: Int) -> String {
    let scalar: String = CompilerRuntimeCallAbiNativeScalarTypeAt(scalar_index);
    if kind == 0 {
        if op_index == 0 { return Concat("pgy_claim_", scalar); }
        if op_index == 1 { return Concat("pgy_read_", scalar); }
        if op_index == 2 { return Concat("pgy_release_", scalar); }
        if op_index == 3 { return Concat("pgy_write_", scalar); }
    }
    if kind == 1 {
        if op_index == 0 { return Concat("pgy_claim_secure_", scalar); }
        if op_index == 1 { return Concat("pgy_secure_read_", scalar); }
        if op_index == 2 { return Concat("pgy_secure_release_", scalar); }
        if op_index == 3 { return Concat("pgy_secure_write_", scalar); }
    }
    if kind == 2 {
        if op_index == 0 { return Concat("pgy_claim_device_", scalar); }
        if op_index == 1 { return Concat("pgy_device_read_", scalar); }
        if op_index == 2 { return Concat("pgy_release_device_", scalar); }
        if op_index == 3 { return Concat("pgy_device_write_", scalar); }
    }
    return "";
}

func CompilerRuntimeCallAbiNativePinSymbol(kind: Int, scalar_index: Int, op_index: Int) -> String {
    let scalar: String = CompilerRuntimeCallAbiNativeScalarTypeAt(scalar_index);
    if kind == 0 {
        if op_index == 0 { return Concat("pgy_pin_read_", scalar); }
        if op_index == 1 { return Concat("pgy_pin_write_", scalar); }
        if op_index == 2 { return Concat("pgy_pin_read_init_", scalar); }
        if op_index == 3 { return Concat("pgy_pin_write_init_", scalar); }
        if op_index == 4 { return Concat("pgy_unpin_", scalar); }
        if op_index == 5 { return Concat("pgy_unpin_cleanup_", scalar); }
    }
    if kind == 1 {
        if op_index == 0 { return Concat("pgy_secure_pin_read_", scalar); }
        if op_index == 1 { return Concat("pgy_secure_pin_write_", scalar); }
        if op_index == 2 { return Concat("pgy_secure_pin_read_init_", scalar); }
        if op_index == 3 { return Concat("pgy_secure_pin_write_init_", scalar); }
        if op_index == 4 { return Concat("pgy_secure_unpin_", scalar); }
        if op_index == 5 { return Concat("pgy_secure_unpin_cleanup_", scalar); }
    }
    return "";
}

func CompilerRuntimeCallAbiNativeSlotResourceRowAt(index: Int) -> String {
    let kind: Int = index / 24;
    let inner: Int = (index % 24) / 4;
    let op: Int = index % 4;
    let type_name: String = CompilerRuntimeCallAbiNativeResourceType(kind, inner);
    let operation: String = CompilerRuntimeCallAbiNativeResourceOperationAt(op);
    return CompilerRuntimeCallAbiRow(CompilerRuntimeCallAbiRowInput(
        "native-resource",
        Concat(Concat(type_name, "."), operation),
        CompilerRuntimeCallAbiNativeResourceSymbol(kind, inner, op),
        CompilerRuntimeCallAbiMaterialMirResourceRow()));
}

func CompilerRuntimeCallAbiNativePinRowAt(index: Int) -> String {
    let kind: Int = index / 36;
    let inner: Int = (index % 36) / 6;
    let op: Int = index % 6;
    let type_name: String = CompilerRuntimeCallAbiNativeResourceType(kind, inner);
    let operation: String = CompilerRuntimeCallAbiNativePinOperationAt(op);
    return CompilerRuntimeCallAbiRow(CompilerRuntimeCallAbiRowInput(
        "native-resource",
        Concat(Concat(type_name, "."), operation),
        CompilerRuntimeCallAbiNativePinSymbol(kind, inner, op),
        CompilerRuntimeCallAbiMaterialMirResourceRow()));
}

func CompilerRuntimeCallAbiNativeDeviceSubmitRowAt(index: Int) -> String {
    let scalar: String = CompilerRuntimeCallAbiNativeScalarTypeAt(index);
    let type_name: String = CompilerRuntimeCallAbiNativeResourceType(2, index);
    return CompilerRuntimeCallAbiRow(CompilerRuntimeCallAbiRowInput(
        "native-resource",
        Concat(Concat(type_name, "."), "SubmitRead"),
        Concat("pgy_submit_device_read_", scalar),
        CompilerRuntimeCallAbiMaterialMirResourceRow()));
}

