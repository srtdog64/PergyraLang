// Structured self-host projection of native resource runtime-call ABI rows.

import "runtime_call_abi_row_owner.pgy";

struct CompilerRuntimeCallAbiFact {
    ok: Bool;
    domain: String;
    operation: String;
    symbol: String;
    symbol_kind: String;
    materialization: String;
    call_shape: String;
    runtime_call_abi_id: Int;
}

func CompilerRuntimeCallAbiResourceRuntimeCPreamble(
    undef_log_macro: Bool
) -> String {
    let out: String = "#include \"pgy_runtime.h\"\n";
    if undef_log_macro {
        out = Concat(out, "#ifdef pgy_log\n#undef pgy_log\n#endif\n");
    }
    return out;
}

func CompilerRuntimeCallAbiFactMissing() -> CompilerRuntimeCallAbiFact {
    return CompilerRuntimeCallAbiFact(false, "", "", "", "", "", "", 0);
}

// Must match mir_abi_resource_runtime_row_id in the native ABI owner.  The
// key is domain|canonical ABI type|logical operation; target symbol spelling
// and table position are deliberately excluded from identity.
func CompilerRuntimeCallAbiRowId(
    domain: String, type_name: String, operation: String
) -> Int {
    let modulus: Long = 268435456L;
    let hash: Long = 7L;
    let key: String = Concat(
        Concat(Concat(domain, "|"), type_name),
        Concat("|", operation)
    );
    let i: Int = 0;
    let n: Int = StringLength(key);
    while i < n {
        hash = (hash * 131L + (CharCode(key, n, i) as Long)) % modulus;
        i = i + 1;
    }
    return (1073741824L + hash) as Int;
}

// Convert the row owner's structured input directly. Serialized manifest text
// stays an output artifact and is never parsed back into compiler facts.
func CompilerRuntimeCallAbiFactFromRowInput(
    input: CompilerRuntimeCallAbiRowInput
) -> CompilerRuntimeCallAbiFact {
    let projected_row: String = CompilerRuntimeCallAbiRow(input);
    if StringLength(input.domain) == 0 ||
        StringLength(input.operation) == 0 ||
        StringLength(input.symbol) == 0 ||
        StringLength(input.materialization) == 0 ||
        CompilerRuntimeCallAbiRowFor(
            input.domain, input.operation
        ) != projected_row {
        return CompilerRuntimeCallAbiFactMissing();
    }
    let call_shape: String = CompilerRuntimeCallAbiCallShape(
        input.domain, input.operation, input.materialization
    );
    if StringLength(call_shape) == 0 {
        return CompilerRuntimeCallAbiFactMissing();
    }
    return CompilerRuntimeCallAbiFact(
        true,
        input.domain,
        input.operation,
        input.symbol,
        "function",
        input.materialization,
        call_shape,
        CompilerRuntimeCallAbiRowId(
            input.domain, "", input.operation
        )
    );
}

func CompilerRuntimeCallAbiFormattedPrintFact(
) -> CompilerRuntimeCallAbiFact {
    return CompilerRuntimeCallAbiFactFromRowInput(
        CompilerRuntimeCallAbiStringFormattedPrintRowInput()
    );
}

func CompilerRuntimeCallAbiFlatFactOwnerReady(
    formatted: CompilerRuntimeCallAbiFact
) -> Bool {
    let missing: CompilerRuntimeCallAbiFact =
        CompilerRuntimeCallAbiFactFromRowInput(
            CompilerRuntimeCallAbiRowInput(
                "string",
                "missing-direct-backend",
                StringRuntimeCFormattedPrintFn(),
                CompilerRuntimeCallAbiMaterialTargetLibrary()
            )
        );
    return formatted.ok && formatted.domain == "string" &&
        formatted.operation == "formatted-print" &&
        formatted.symbol_kind == "function" &&
        formatted.materialization ==
            CompilerRuntimeCallAbiMaterialTargetLibrary() &&
        formatted.call_shape ==
            CompilerRuntimeCallAbiStringCallShape("formatted-print") &&
        formatted.runtime_call_abi_id == CompilerRuntimeCallAbiRowId(
            "string", "", "formatted-print"
        ) && !missing.ok;
}

// This is the self-host projection of the native constructed-resource spelling
// rule.  The native MIR owner remains authoritative; keeping the same bounded
// character walk here makes a self-host-produced row comparable without
// rediscovering the type from the AST or accepting an arbitrary symbol.
func CompilerRuntimeCallAbiConstructedSuffix(
    inner_type_name: String
) -> Option<String> {
    let n: Int = StringLength(inner_type_name);
    if n == 0 || inner_type_name == "Unknown" || inner_type_name == "Void" {
        return None;
    }
    let out: String = "";
    let i: Int = 0;
    let last_was_underscore: Bool = false;
    while i < n {
        let c: Int = CharCode(inner_type_name, n, i);
        let is_ascii_alpha_or_digit: Bool =
            (c >= 65 && c <= 90) ||
            (c >= 97 && c <= 122) ||
            (c >= 48 && c <= 57);
        if is_ascii_alpha_or_digit {
            out = Concat(out, CharAtN(inner_type_name, n, i));
            last_was_underscore = false;
        } else if StringLength(out) > 0 && !last_was_underscore {
            out = Concat(out, "_");
            last_was_underscore = true;
        }
        i = i + 1;
    }
    while StringLength(out) > 0 && Substring(
        out, StringLength(out) - 1, 1
    ) == "_" {
        out = Substring(out, 0, StringLength(out) - 1);
    }
    if StringLength(out) == 0 {
        return None;
    }
    let first: Int = CharCode(out, StringLength(out), 0);
    if first >= 48 && first <= 57 {
        out = Concat("T_", out);
    }
    // The native owner rejects a suffix which would overflow its fixed
    // runtime-name buffer.  Keep the same effective limit for parity.
    if StringLength(out) >= 96 {
        return None;
    }
    return Some(out);
}

func CompilerRuntimeCallAbiConstructedKind(type_name: String) -> Option<Int> {
    let n: Int = StringLength(type_name);
    if n >= 7 && StringIndexOf(type_name, "Slot<") == 0 &&
        Substring(type_name, n - 1, 1) == ">" {
        return Some(0);
    }
    if n >= 13 && StringIndexOf(type_name, "SecureSlot<") == 0 &&
        Substring(type_name, n - 1, 1) == ">" {
        return Some(1);
    }
    if n >= 13 && StringIndexOf(type_name, "DeviceSlot<") == 0 &&
        Substring(type_name, n - 1, 1) == ">" {
        return Some(2);
    }
    return None;
}

func CompilerRuntimeCallAbiConstructedInner(
    type_name: String, kind: Int
) -> Option<String> {
    let prefix_len: Int = 11;
    if kind == 0 {
        prefix_len = 5;
    }
    let n: Int = StringLength(type_name);
    if kind < 0 || n <= prefix_len + 1 {
        return None;
    }
    return Some(Substring(type_name, prefix_len, n - prefix_len - 1));
}

func CompilerRuntimeCallAbiConstructedCValueType(
    type_name: String
) -> Option<String> {
    let kind_fact: Option<Int> =
        CompilerRuntimeCallAbiConstructedKind(type_name);
    if !IsSome(kind_fact) { return None; }
    let kind: Int = UnwrapOption(kind_fact);
    let inner_fact: Option<String> =
        CompilerRuntimeCallAbiConstructedInner(type_name, kind);
    if !IsSome(inner_fact) { return None; }
    let suffix_fact: Option<String> =
        CompilerRuntimeCallAbiConstructedSuffix(UnwrapOption(inner_fact));
    if !IsSome(suffix_fact) { return None; }
    let prefix: String = "PgySlot_";
    if kind == 1 { prefix = "PgySecureSlot_"; }
    if kind == 2 { prefix = "PgyDeviceSlot_"; }
    return Some(Concat(prefix, UnwrapOption(suffix_fact)));
}

func CompilerRuntimeCallAbiConstructedPrefix(
    kind: Int, operation: String
) -> Option<String> {
    if kind == 0 {
        if operation == "Claim" { return Some("pgy_claim_"); }
        if operation == "Read" { return Some("pgy_read_"); }
        if operation == "Write" { return Some("pgy_write_"); }
        if operation == "Release" { return Some("pgy_release_"); }
        if operation == "PinRead" { return Some("pgy_pin_read_"); }
        if operation == "PinWrite" { return Some("pgy_pin_write_"); }
        if operation == "PinReadInit" { return Some("pgy_pin_read_init_"); }
        if operation == "PinWriteInit" { return Some("pgy_pin_write_init_"); }
        if operation == "Unpin" { return Some("pgy_unpin_"); }
        if operation == "UnpinCleanup" { return Some("pgy_unpin_cleanup_"); }
    }
    if kind == 1 {
        if operation == "Claim" { return Some("pgy_claim_secure_"); }
        if operation == "Read" { return Some("pgy_secure_read_"); }
        if operation == "Write" { return Some("pgy_secure_write_"); }
        if operation == "Release" { return Some("pgy_secure_release_"); }
        if operation == "PinRead" { return Some("pgy_secure_pin_read_"); }
        if operation == "PinWrite" { return Some("pgy_secure_pin_write_"); }
        if operation == "PinReadInit" { return Some("pgy_secure_pin_read_init_"); }
        if operation == "PinWriteInit" { return Some("pgy_secure_pin_write_init_"); }
        if operation == "Unpin" { return Some("pgy_secure_unpin_"); }
        if operation == "UnpinCleanup" { return Some("pgy_secure_unpin_cleanup_"); }
    }
    if kind == 2 {
        if operation == "Claim" { return Some("pgy_claim_device_"); }
        if operation == "Read" { return Some("pgy_device_read_"); }
        if operation == "Write" { return Some("pgy_device_write_"); }
        if operation == "Release" { return Some("pgy_release_device_"); }
        if operation == "SubmitRead" { return Some("pgy_submit_device_read_"); }
    }
    return None;
}

func CompilerRuntimeCallAbiFactForConstructedResource(
    type_name: String,
    operation: String
) -> CompilerRuntimeCallAbiFact {
    let kind_fact: Option<Int> =
        CompilerRuntimeCallAbiConstructedKind(type_name);
    if !IsSome(kind_fact) {
        return CompilerRuntimeCallAbiFactMissing();
    }
    let kind: Int = UnwrapOption(kind_fact);
    let inner_fact: Option<String> =
        CompilerRuntimeCallAbiConstructedInner(type_name, kind);
    if !IsSome(inner_fact) {
        return CompilerRuntimeCallAbiFactMissing();
    }
    let inner: String = UnwrapOption(inner_fact);
    let suffix_fact: Option<String> =
        CompilerRuntimeCallAbiConstructedSuffix(inner);
    let prefix_fact: Option<String> =
        CompilerRuntimeCallAbiConstructedPrefix(kind, operation);
    if !IsSome(suffix_fact) || !IsSome(prefix_fact) {
        return CompilerRuntimeCallAbiFactMissing();
    }
    let suffix: String = UnwrapOption(suffix_fact);
    let prefix: String = UnwrapOption(prefix_fact);
    let operation_key: String = Concat(Concat(type_name, "."), operation);
    let call_shape: String = CompilerRuntimeCallAbiNativeResourceCallShape(
        operation_key
    );
    if call_shape == "unknown_native_resource_call_shape" {
        return CompilerRuntimeCallAbiFactMissing();
    }
    return CompilerRuntimeCallAbiFact(
        true,
        "constructed-resource",
        operation_key,
        Concat(prefix, suffix),
        "function",
        "constructed_resource_runtime_spelling",
        call_shape,
        CompilerRuntimeCallAbiRowId(
            "constructed-resource", type_name, operation
        )
    );
}

func CompilerRuntimeCallAbiFactForNativeResource(
    type_name: String,
    operation: String
) -> CompilerRuntimeCallAbiFact {
    let kind: Int = 0;
    while kind < 3 {
        let scalar_index: Int = 0;
        while scalar_index < 6 {
            if CompilerRuntimeCallAbiNativeResourceType(
                kind, scalar_index
            ) == type_name {
                let operation_index: Int = 0;
                while operation_index < 4 {
                    if CompilerRuntimeCallAbiNativeResourceOperationAt(
                        operation_index
                    ) == operation {
                        let operation_key: String = Concat(
                            Concat(type_name, "."), operation
                        );
                        return CompilerRuntimeCallAbiFact(
                            true, "native-resource", operation_key,
                            CompilerRuntimeCallAbiNativeResourceSymbol(
                                kind, scalar_index, operation_index
                            ),
                            "function",
                            CompilerRuntimeCallAbiMaterialMirResourceRow(),
                            CompilerRuntimeCallAbiNativeResourceCallShape(
                                operation_key
                            ),
                            CompilerRuntimeCallAbiRowId(
                                "native-resource", type_name, operation
                            )
                        );
                    }
                    operation_index = operation_index + 1;
                }
                operation_index = 0;
                while operation_index < 6 && kind < 2 {
                    if CompilerRuntimeCallAbiNativePinOperationAt(
                        operation_index
                    ) == operation {
                        let operation_key: String = Concat(
                            Concat(type_name, "."), operation
                        );
                        return CompilerRuntimeCallAbiFact(
                            true, "native-resource", operation_key,
                            CompilerRuntimeCallAbiNativePinSymbol(
                                kind, scalar_index, operation_index
                            ),
                            "function",
                            CompilerRuntimeCallAbiMaterialMirResourceRow(),
                            CompilerRuntimeCallAbiNativeResourceCallShape(
                                operation_key
                            ),
                            CompilerRuntimeCallAbiRowId(
                                "native-resource", type_name, operation
                            )
                        );
                    }
                    operation_index = operation_index + 1;
                }
                if kind == 2 && operation == "SubmitRead" {
                    let submit_operation: String = Concat(
                        Concat(type_name, "."), operation
                    );
                    return CompilerRuntimeCallAbiFact(
                        true, "native-resource", submit_operation,
                        CompilerRuntimeCallAbiNativeDeviceSubmitSymbol(
                            scalar_index
                        ),
                        "function",
                        CompilerRuntimeCallAbiMaterialMirResourceRow(),
                        CompilerRuntimeCallAbiNativeResourceCallShape(
                            submit_operation
                        ),
                        CompilerRuntimeCallAbiRowId(
                            "native-resource", type_name, operation
                        )
                    );
                }
                return CompilerRuntimeCallAbiFactMissing();
            }
            scalar_index = scalar_index + 1;
        }
        kind = kind + 1;
    }
    return CompilerRuntimeCallAbiFactForConstructedResource(
        type_name, operation
    );
}
