// Allocation-free stable identity for Allocator/TextBuilder runtime calls.
//
// MIR production may materialize parameter arrays and registry rows once. MIR
// validation consumes only this identity receipt and never reconstructs the
// 256-row serialized runtime-call registry for each instruction.

import "runtime_call_abi_structured_fact_owner.pgy";
import "../codegen/runtime_abi/text_builder_runtime_owner.pgy";

struct CompilerRuntimeValueCallAbiIdentity {
    let valid: Bool;
    let source_name: String;
    let owner_name: String;
    let native_operation: String;
    let registry_operation: String;
    let c_symbol: String;
    let llvm_symbol: String;
    let c_shape: String;
    let llvm_shape: String;
    let return_type: String;
    let parameter_count: Int;
    let parameter0: String;
    let parameter1: String;
    let terminal_consumer: Bool;
}

func CompilerRuntimeValueCallAbiIdentityMissing(
) -> CompilerRuntimeValueCallAbiIdentity {
    return CompilerRuntimeValueCallAbiIdentity(
        false, "", "", "", "", "", "", "", "", "", 0, "", "", false
    );
}

func CompilerRuntimeValueCallAbiIdentityForSource(
    source_name: String
) -> CompilerRuntimeValueCallAbiIdentity {
    if source_name == "AllocatorResult" {
        return CompilerRuntimeValueCallAbiIdentity(
            true, source_name, "Allocator", "Result", "allocator.result",
            TextBuilderRuntimeCAllocatorResultFn(),
            TextBuilderRuntimeLlvmAllocatorResultFn(), "returns_allocator",
            "allocator_out_to_void", "Allocator", 0, "", "", false
        );
    }
    if source_name == "AllocatorDestroy" {
        return CompilerRuntimeValueCallAbiIdentity(
            true, source_name, "Allocator", "Destroy", "allocator.destroy",
            TextBuilderRuntimeCAllocatorDestroyFn(),
            TextBuilderRuntimeLlvmAllocatorDestroyFn(),
            "allocator_ptr_to_void", "allocator_ptr_to_void", "Void", 1,
            "Allocator", "", true
        );
    }
    if source_name == "TextBuilderNew" {
        return CompilerRuntimeValueCallAbiIdentity(
            true, source_name, "TextBuilder", "New", "new",
            TextBuilderRuntimeCNewFn(), TextBuilderRuntimeLlvmNewFn(),
            "capacity_to_builder", "builder_out_capacity_to_void",
            "TextBuilder", 1, "Int", "", false
        );
    }
    if source_name == "TextBuilderAppend" {
        return CompilerRuntimeValueCallAbiIdentity(
            true, source_name, "TextBuilder", "Append", "append",
            TextBuilderRuntimeCAppendFn(), TextBuilderRuntimeLlvmAppendFn(),
            "builder_ptr_string_to_void", "builder_ptr_string_to_void",
            "Void", 2, "TextBuilder", "String", false
        );
    }
    if source_name == "TextBuilderFinish" {
        return CompilerRuntimeValueCallAbiIdentity(
            true, source_name, "TextBuilder", "Finish", "finish",
            TextBuilderRuntimeCFinishFn(), TextBuilderRuntimeLlvmFinishFn(),
            "builder_ptr_allocator_ptr_to_string",
            "builder_ptr_allocator_ptr_to_string", "String", 2,
            "TextBuilder", "Allocator", true
        );
    }
    if source_name == "TextBuilderDrop" {
        return CompilerRuntimeValueCallAbiIdentity(
            true, source_name, "TextBuilder", "Drop", "drop",
            TextBuilderRuntimeCDropFn(), TextBuilderRuntimeLlvmDropFn(),
            "builder_ptr_to_void", "builder_ptr_to_void", "Void", 1,
            "TextBuilder", "", true
        );
    }
    return CompilerRuntimeValueCallAbiIdentityMissing();
}

func CompilerRuntimeValueCallSourceAt(index: Int) -> String {
    if index == 0 { return "AllocatorResult"; }
    if index == 1 { return "AllocatorDestroy"; }
    if index == 2 { return "TextBuilderNew"; }
    if index == 3 { return "TextBuilderAppend"; }
    if index == 4 { return "TextBuilderFinish"; }
    if index == 5 { return "TextBuilderDrop"; }
    return "";
}

func CompilerRuntimeValueCallAbiIdentityId(
    ref identity: CompilerRuntimeValueCallAbiIdentity
) -> Int {
    if !identity.valid { return 0; }
    return CompilerRuntimeCallAbiRowId(
        "selfhost-c-text-builder", "", identity.registry_operation
    );
}

func CompilerRuntimeValueCallAbiIdentityForId(
    runtime_call_abi_id: Int
) -> CompilerRuntimeValueCallAbiIdentity {
    let found: CompilerRuntimeValueCallAbiIdentity =
        CompilerRuntimeValueCallAbiIdentityMissing();
    let row: Int = 0;
    while row < 6 {
        let candidate: CompilerRuntimeValueCallAbiIdentity =
            CompilerRuntimeValueCallAbiIdentityForSource(
                CompilerRuntimeValueCallSourceAt(row));
        if candidate.valid && CompilerRuntimeValueCallAbiIdentityId(candidate) ==
            runtime_call_abi_id {
            if found.valid { return CompilerRuntimeValueCallAbiIdentityMissing(); }
            found = candidate;
        }
        row = row + 1;
    }
    return found;
}
