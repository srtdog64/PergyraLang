import "path_manifest_owner.pgy";
import "../lexer/token_owner.pgy";
import "../parser/tree_text_owner.pgy";
import "../semantic/diagnostic_owner.pgy";
import "../mir_lower/mir_fact_graph_contract_owner.pgy";
import "../hir/ast_text_arena_projection_owner.pgy";

// Stage artifact envelope facts for PgyCompilerWorld.
//
// These facts prove that each active compiler stage is present in the path
// manifest and bound to the expected world/zone/actor/intent row. Each stage
// readiness fact then consumes the current payload contract owned by that
// stage, so world actions stay load-bearing rather than decorative topology.

func CompilerStageArtifactRowReady(index: Int, binding: String) -> Bool {
    if CompilerStagePathAt(index) == "" {
        return false;
    }
    if CompilerStageWorldBindingAt(index) != binding {
        return false;
    }
    return true;
}

func CompilerTokenStreamFactReady() -> Bool {
    if !CompilerStageArtifactRowReady(0, "lexer|TokenStreamZone|LexerStage|LexSource|LexerTokenPayloadContractReady") {
        return false;
    }
    return LexerTokenPayloadContractReady();
}

func CompilerAstTreeFactReady() -> Bool {
    if !CompilerStageArtifactRowReady(1, "parser|AstTreeZone|ParserStage|ParseTokens|ParserAstTreePayloadContractReady") {
        return false;
    }
    return ParserAstTreePayloadContractReady() &&
        AstTreeArtifactPayloadContractReady();
}

func CompilerSemanticVerdictFactReady() -> Bool {
    if !CompilerStageArtifactRowReady(2, "semantic|SemanticVerdictZone|SemanticStage|CheckProgramSemantics|SemanticVerdictPayloadContractReady") {
        return false;
    }
    return SemanticVerdictPayloadContractReady();
}

func CompilerMirFactGraphReady() -> Bool {
    if !CompilerStageArtifactRowReady(3, "mir_lower|MirFactGraphZone|MirLowerStage|LowerProgramFacts|MirFactGraphPayloadContractReady") {
        return false;
    }
    return MirFactGraphPayloadContractReady();
}

func CompilerEmissionFactReady() -> Bool {
    if !CompilerStageArtifactRowReady(4, "codegen|EmissionZone|ProgramEmitter|EmitProgramArtifact|TypedAstArenaPayloadContractReady") {
        return false;
    }
    return TypedAstArenaPayloadContractReady() &&
        AstTreeArtifactPayloadContractReady();
}
