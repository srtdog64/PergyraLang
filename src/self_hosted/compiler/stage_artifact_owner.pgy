import "path_manifest_owner.pgy";
import "../lexer/token_owner.pgy";
import "../parser/tree_text_owner.pgy";
import "../semantic/diagnostic_owner.pgy";

// Stage artifact envelope facts for PgyCompilerWorld.
//
// These facts prove that each active compiler stage is present in the path
// manifest and bound to the expected world/zone/actor/intent row. They do not
// claim to validate the full token/AST/semantic/MIR payload yet.

func CompilerStageArtifactRowReady(index: Int, binding: String) -> Bool {
    if CompilerStagePathAt(index) == "" {
        return false;
    }
    if CompilerStageWorldBindingAt(index) != binding {
        return false;
    }
    return true;
}

func CompilerTokenStreamFactReady() -> Bool {
    if !CompilerStageArtifactRowReady(0, "lexer|TokenStreamZone|LexerStage|LexSource") {
        return false;
    }
    return LexerTokenPayloadContractReady();
}

func CompilerAstTreeFactReady() -> Bool {
    if !CompilerStageArtifactRowReady(1, "parser|AstTreeZone|ParserStage|ParseTokens") {
        return false;
    }
    return ParserAstTreePayloadContractReady();
}

func CompilerSemanticVerdictFactReady() -> Bool {
    if !CompilerStageArtifactRowReady(2, "semantic|SemanticVerdictZone|SemanticStage|CheckProgramSemantics") {
        return false;
    }
    return SemanticVerdictPayloadContractReady();
}

func CompilerMirFactGraphReady() -> Bool {
    return CompilerStageArtifactRowReady(3, "mir_lower|MirFactGraphZone|MirLowerStage|LowerProgramFacts");
}
