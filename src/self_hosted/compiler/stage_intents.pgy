// src/self_hosted/compiler/stage_intents.pgy
//
// Derived compiler intent clusters. These are not resource zones: they compose
// existing resource zones into visible compiler actions.

intent FrontendPipeline(
    intake: SourceIntakeZone,
    tokens: TokenStreamZone,
    ast: AstTreeZone,
    paths: StagePathManifest,
    source: SourceUnit,
    lexer: LexerStage,
    parser: ParserStage
) {
    exclusive;

    step Intake {
        where: SourceIntakeZone;
        using: intake;
        who: source;
        authorized by: source;
        on: IntakeSource(intake, source, paths);
        expect: true;
    }

    step Lex {
        where: TokenStreamZone;
        using: tokens;
        who: lexer;
        authorized by: lexer;
        on: LexSource(tokens, lexer);
        expect: true;
    }

    step Parse {
        where: AstTreeZone;
        using: ast;
        who: parser;
        authorized by: parser;
        on: ParseTokens(ast, parser);
        expect: true;
    }

    success: true;
    failure: false;
}

intent MiddleEndPipeline(
    semantic_zone: SemanticVerdictZone,
    lower_zone: MirFactGraphZone,
    checker: SemanticStage,
    lowerer: MirLowerStage
) {
    exclusive;

    step Check {
        using: semantic_zone;
        who: checker;
        requires: FactProving;
        authorized by: checker;
        on: CheckProgramSemantics(semantic_zone, checker);
        expect: true;
    }

    step Lower {
        using: lower_zone;
        who: lowerer;
        requires: MirFactLowering;
        authorized by: lowerer;
        on: LowerProgramFacts(lower_zone, lowerer);
        expect: true;
    }

    success: true;
    failure: false;
}

intent BackendPipeline(
    types: TypeEnvZone,
    abi_layout: AbiLayoutZone,
    target_capability: TargetCapabilityZone,
    emit_zone: EmissionZone,
    target_planner: TargetProjectionPlanner,
    emitter: ProgramEmitter
) {
    exclusive;

    step PlanTarget {
        where: TargetCapabilityZone;
        using: target_capability;
        who: target_planner;
        requires: TargetProjectionPlanning;
        authorized by: target_planner;
        on: PlanTargetProjection(target_capability, target_planner);
        expect: true;
    }

    step Emit {
        using: emit_zone;
        who: emitter;
        requires: ArtifactEmission;
        authorized by: emitter;
        on: EmitProgramArtifact(emit_zone, types, abi_layout, target_capability, emitter);
        expect: true;
    }

    success: true;
    failure: false;
}

intent SelfProofPipeline(parity_zone: ParityZone, oracle: OraclePair) {
    exclusive;

    step Prove {
        where: ParityZone;
        using: parity_zone;
        who: oracle;
        authorized by: oracle;
        on: ProveSelfHostedParity(parity_zone, oracle);
        expect: true;
    }

    success: true;
    failure: false;
}
