// Self-host compiler subprocess-runner owner.
//
// Owns the capability envelope for invoking external compiler oracles. It does
// not grant raw shell escape; a runner must consume this envelope first.

func CompilerSubprocessSchema() -> String {
    return "pgy.selfhost.subprocess-runner.v1";
}

func CompilerSubprocessFactCount() -> Int {
    return 7;
}

func CompilerSubprocessExecutablePathFact() -> String {
    return "executable_path";
}

func CompilerSubprocessArgvFact() -> String {
    return "argv";
}

func CompilerSubprocessCwdFact() -> String {
    return "cwd";
}

func CompilerSubprocessEnvAllowlistFact() -> String {
    return "env_allowlist";
}

func CompilerSubprocessTimeoutMsFact() -> String {
    return "timeout_ms";
}

func CompilerSubprocessStreamFact() -> String {
    return "stdout_stderr";
}

func CompilerSubprocessExitFact() -> String {
    return "exit_code";
}

func CompilerSubprocessFactKnown(fact: String) -> Bool {
    return fact == CompilerSubprocessExecutablePathFact() ||
        fact == CompilerSubprocessArgvFact() ||
        fact == CompilerSubprocessCwdFact() ||
        fact == CompilerSubprocessEnvAllowlistFact() ||
        fact == CompilerSubprocessTimeoutMsFact() ||
        fact == CompilerSubprocessStreamFact() ||
        fact == CompilerSubprocessExitFact();
}

func CompilerSubprocessFactAt(index: Int) -> String {
    if index == 0 { return CompilerSubprocessExecutablePathFact(); }
    if index == 1 { return CompilerSubprocessArgvFact(); }
    if index == 2 { return CompilerSubprocessCwdFact(); }
    if index == 3 { return CompilerSubprocessEnvAllowlistFact(); }
    if index == 4 { return CompilerSubprocessTimeoutMsFact(); }
    if index == 5 { return CompilerSubprocessStreamFact(); }
    if index == 6 { return CompilerSubprocessExitFact(); }
    return "";
}

func CompilerSubprocessUseCaseCount() -> Int {
    return 3;
}

func CompilerSubprocessUseCaseAt(index: Int) -> String {
    if index == 0 { return CompilerSubprocessOracleCompareUseCase(); }
    if index == 1 { return CompilerSubprocessFixtureBuildUseCase(); }
    if index == 2 { return CompilerSubprocessArtifactProbeUseCase(); }
    return "";
}

func CompilerSubprocessOracleCompareUseCase() -> String {
    return "oracle_compare";
}

func CompilerSubprocessFixtureBuildUseCase() -> String {
    return "fixture_build";
}

func CompilerSubprocessArtifactProbeUseCase() -> String {
    return "artifact_probe";
}

func CompilerSubprocessUseCaseKnown(use_case: String) -> Bool {
    return use_case == CompilerSubprocessOracleCompareUseCase() ||
        use_case == CompilerSubprocessFixtureBuildUseCase() ||
        use_case == CompilerSubprocessArtifactProbeUseCase();
}

func CompilerSubprocessOracleCompareTimeoutMsValue() -> Int {
    return 30000;
}

func CompilerSubprocessOracleCompareTimeoutMs() -> String {
    return ToString(CompilerSubprocessOracleCompareTimeoutMsValue());
}

func CompilerSubprocessOracleCompareEnvAllowlistCount() -> Int {
    return 4;
}

func CompilerSubprocessEnvPathName() -> String {
    return "PATH";
}

func CompilerSubprocessEnvPgyBinName() -> String {
    return "PGY_BIN";
}

func CompilerSubprocessEnvBackendRunTimeoutName() -> String {
    return "PGY_BACKEND_COMPARE_RUN_TIMEOUT_SECONDS";
}

func CompilerSubprocessEnvSelfHostBuildDirName() -> String {
    return "PGY_SELFHOST_BUILD_DIR";
}

func CompilerSubprocessOracleCompareEnvAllowlistAt(index: Int) -> String {
    if index == 0 { return CompilerSubprocessEnvPathName(); }
    if index == 1 { return CompilerSubprocessEnvPgyBinName(); }
    if index == 2 { return CompilerSubprocessEnvBackendRunTimeoutName(); }
    if index == 3 { return CompilerSubprocessEnvSelfHostBuildDirName(); }
    return "";
}

func CompilerSubprocessOracleCompareEnvAllowlistKnown(name: String) -> Bool {
    return name == CompilerSubprocessOracleCompareEnvAllowlistAt(0) ||
        name == CompilerSubprocessOracleCompareEnvAllowlistAt(1) ||
        name == CompilerSubprocessOracleCompareEnvAllowlistAt(2) ||
        name == CompilerSubprocessOracleCompareEnvAllowlistAt(3);
}

func CompilerSubprocessOracleCompareEnvAllowlist() -> String {
    let names: Array<String> = [
        CompilerSubprocessOracleCompareEnvAllowlistAt(0),
        CompilerSubprocessOracleCompareEnvAllowlistAt(1),
        CompilerSubprocessOracleCompareEnvAllowlistAt(2),
        CompilerSubprocessOracleCompareEnvAllowlistAt(3)
    ];
    return StringJoin(names, ",");
}

func CompilerSubprocessOracleComparePlanReady() -> Bool {
    return CompilerSubprocessFactCount() == 7 &&
        CompilerSubprocessUseCaseCount() == 3 &&
        CompilerSubprocessUseCaseAt(0) == CompilerSubprocessOracleCompareUseCase() &&
        CompilerSubprocessUseCaseAt(1) == CompilerSubprocessFixtureBuildUseCase() &&
        CompilerSubprocessUseCaseAt(2) == CompilerSubprocessArtifactProbeUseCase() &&
        CompilerSubprocessUseCaseKnown(CompilerSubprocessOracleCompareUseCase()) &&
        CompilerSubprocessUseCaseKnown(CompilerSubprocessFixtureBuildUseCase()) &&
        CompilerSubprocessUseCaseKnown(CompilerSubprocessArtifactProbeUseCase()) &&
        CompilerSubprocessFactAt(0) == CompilerSubprocessExecutablePathFact() &&
        CompilerSubprocessFactAt(1) == CompilerSubprocessArgvFact() &&
        CompilerSubprocessFactAt(2) == CompilerSubprocessCwdFact() &&
        CompilerSubprocessFactAt(3) == CompilerSubprocessEnvAllowlistFact() &&
        CompilerSubprocessFactAt(4) == CompilerSubprocessTimeoutMsFact() &&
        CompilerSubprocessFactAt(5) == CompilerSubprocessStreamFact() &&
        CompilerSubprocessFactAt(6) == CompilerSubprocessExitFact() &&
        CompilerSubprocessFactKnown(CompilerSubprocessExecutablePathFact()) &&
        CompilerSubprocessFactKnown(CompilerSubprocessArgvFact()) &&
        CompilerSubprocessFactKnown(CompilerSubprocessCwdFact()) &&
        CompilerSubprocessFactKnown(CompilerSubprocessEnvAllowlistFact()) &&
        CompilerSubprocessFactKnown(CompilerSubprocessTimeoutMsFact()) &&
        CompilerSubprocessFactKnown(CompilerSubprocessStreamFact()) &&
        CompilerSubprocessFactKnown(CompilerSubprocessExitFact()) &&
        CompilerSubprocessOracleCompareTimeoutMsValue() > 0 &&
        CompilerSubprocessOracleCompareTimeoutMs() == ToString(CompilerSubprocessOracleCompareTimeoutMsValue()) &&
        CompilerSubprocessOracleCompareEnvAllowlistCount() == 4 &&
        CompilerSubprocessOracleCompareEnvAllowlistAt(0) == CompilerSubprocessEnvPathName() &&
        CompilerSubprocessOracleCompareEnvAllowlistAt(1) == CompilerSubprocessEnvPgyBinName() &&
        CompilerSubprocessOracleCompareEnvAllowlistKnown(CompilerSubprocessEnvBackendRunTimeoutName()) &&
        CompilerSubprocessOracleCompareEnvAllowlistKnown(CompilerSubprocessEnvSelfHostBuildDirName()) &&
        CompilerSubprocessOracleCompareTimeoutMs() != "" &&
        CompilerSubprocessOracleCompareEnvAllowlist() != "";
}

func CompilerSubprocessRunnerReady() -> Bool with caps env {
    return CompilerSubprocessFactAt(0) == CompilerSubprocessExecutablePathFact() &&
        CompilerSubprocessFactAt(1) == CompilerSubprocessArgvFact() &&
        CompilerSubprocessFactAt(3) == CompilerSubprocessEnvAllowlistFact() &&
        CompilerSubprocessFactAt(6) == CompilerSubprocessExitFact() &&
        CompilerSubprocessOracleComparePlanReady();
}
