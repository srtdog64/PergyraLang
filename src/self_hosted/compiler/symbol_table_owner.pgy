func CompilerSymbolTableSchema() -> String {
    return "pgy.selfhost.symbol-table.v1";
}
func CompilerSymbolTableRowCount() -> Int {
    return 7;
}
func CompilerSymbolSourceOwnerRow() -> String {
    return "source_owner";
}
func CompilerSymbolSourceNameRow() -> String {
    return "source_name";
}
func CompilerSymbolNamespacePathRow() -> String {
    return "namespace_path";
}
func CompilerSymbolCSymbolRow() -> String {
    return "c_symbol";
}
func CompilerSymbolLlvmSymbolRow() -> String {
    return "llvm_symbol";
}
func CompilerSymbolSelfHostedSymbolRow() -> String {
    return "self_hosted_symbol";
}
func CompilerSymbolCollisionPolicyRow() -> String {
    return "collision_policy";
}
func CompilerSymbolTableRowAt(index: Int) -> String {
    if index == 0 { return CompilerSymbolSourceOwnerRow(); }
    if index == 1 { return CompilerSymbolSourceNameRow(); }
    if index == 2 { return CompilerSymbolNamespacePathRow(); }
    if index == 3 { return CompilerSymbolCSymbolRow(); }
    if index == 4 { return CompilerSymbolLlvmSymbolRow(); }
    if index == 5 { return CompilerSymbolSelfHostedSymbolRow(); }
    if index == 6 { return CompilerSymbolCollisionPolicyRow(); }
    return "";
}
func CompilerSymbolProjectionAt(index: Int) -> String {
    if index == 0 { return CompilerSymbolCSymbolRow(); }
    if index == 1 { return CompilerSymbolLlvmSymbolRow(); }
    if index == 2 { return CompilerSymbolSelfHostedSymbolRow(); }
    return "";
}
func CompilerSymbolTableRowIndex(row_name: String) -> Option<Int> {
    let i: Int = 0;
    while i < CompilerSymbolTableRowCount() {
        if CompilerSymbolTableRowAt(i) == row_name {
            return Some(i);
        }
        i = i + 1;
    }
    return None;
}
func CompilerSymbolTableRowKnown(row_name: String) -> Bool {
    return IsSome(CompilerSymbolTableRowIndex(row_name));
}
func CompilerSymbolProjectionCount() -> Int {
    return 3;
}
func CompilerSymbolProjectionIndex(row_name: String) -> Option<Int> {
    let i: Int = 0;
    while i < CompilerSymbolProjectionCount() {
        if CompilerSymbolProjectionAt(i) == row_name {
            return Some(i);
        }
        i = i + 1;
    }
    return None;
}
func CompilerSymbolProjectionKnown(row_name: String) -> Bool {
    return IsSome(CompilerSymbolProjectionIndex(row_name));
}
func CompilerSymbolRequireTable() -> Void {
    if !CompilerSymbolTableReady() {
        Log("SYMBOL ERROR: compiler symbol table owner is not ready");
        Exit(1);
    }
}
func CompilerSymbolCharAt(s: String, i: Int) -> String {
    if i < 0 || i >= StringLength(s) {
        return "";
    }
    return Substring(s, i, 1);
}
func CompilerSymbolCIdentChar(c: String) -> Bool {
    if StringLength(c) != 1 {
        return false;
    }
    return StringIndexOf("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", c) >= 0;
}
func CompilerSymbolCIdentStart(c: String) -> Bool {
    if StringLength(c) != 1 {
        return false;
    }
    return StringIndexOf("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c) >= 0;
}
func CompilerSymbolCReservedWord(name: String) -> Bool {
    return name == "auto" || name == "break" || name == "case" ||
        name == "char" || name == "const" || name == "continue" ||
        name == "default" || name == "do" || name == "double" ||
        name == "else" || name == "enum" || name == "extern" ||
        name == "float" || name == "for" || name == "goto" ||
        name == "if" || name == "inline" || name == "int" ||
        name == "long" || name == "register" || name == "restrict" ||
        name == "return" || name == "short" || name == "signed" ||
        name == "sizeof" || name == "static" || name == "struct" ||
        name == "switch" || name == "typedef" || name == "union" ||
        name == "unsigned" || name == "void" || name == "volatile" ||
        name == "while";
}
func CompilerSymbolCIdentifier(source_name: String) -> String {
    CompilerSymbolRequireTable();
    let name: String = StringTrim(source_name);
    let n: Int = StringLength(name);
    if n == 0 {
        Log("SYMBOL ERROR: empty source name cannot be projected");
        Exit(1);
        return "";
    }
    let out: String = "";
    let i: Int = 0;
    while i < n {
        let c: String = CompilerSymbolCharAt(name, i);
        if i == 0 {
            if CompilerSymbolCIdentStart(c) {
                out = Concat(out, c);
            } else if CompilerSymbolCIdentChar(c) {
                out = Concat("_", c);
            } else {
                out = "_";
            }
        } else if CompilerSymbolCIdentChar(c) {
            out = Concat(out, c);
        } else {
            out = Concat(out, "_");
        }
        i = i + 1;
    }
    if CompilerSymbolCReservedWord(out) {
        return Concat("pgy_", out);
    }
    return out;
}
func CompilerSymbolCQualifiedName(owner_name: String, member_name: String) -> String {
    let member_symbol: String = CompilerSymbolCIdentifier(member_name);
    if StringLength(StringTrim(owner_name)) == 0 {
        return member_symbol;
    }
    return Concat(CompilerSymbolCIdentifier(owner_name), Concat("_", member_symbol));
}
func CompilerSymbolCImportPublicName(c_symbol: String) -> String {
    let prefix: String = "__imp0_";
    let prefix_len: Int = StringLength(prefix);
    if StringLength(c_symbol) > prefix_len &&
        Substring(c_symbol, 0, prefix_len) == prefix {
        return Substring(c_symbol, prefix_len, StringLength(c_symbol) - prefix_len);
    }
    return c_symbol;
}
func CompilerSymbolCLocalCallName(c_symbol: String) -> String {
    let public_symbol: String = CompilerSymbolCImportPublicName(c_symbol);
    let last_underscore: Int = 0 - 1;
    let i: Int = 0;
    while i < StringLength(public_symbol) {
        if CompilerSymbolCharAt(public_symbol, i) == "_" {
            last_underscore = i;
        }
        i = i + 1;
    }
    if last_underscore >= 0 && last_underscore + 1 < StringLength(public_symbol) {
        return Substring(public_symbol, last_underscore + 1, StringLength(public_symbol) - last_underscore - 1);
    }
    return public_symbol;
}
func CompilerSymbolCTypeName(type_name: String) -> String {
    return CompilerSymbolCIdentifier(type_name);
}
func CompilerSymbolCMangledTypeName(type_name: String) -> String {
    let out: String = "";
    let wrote: Bool = false;
    let i: Int = 0;
    while i < StringLength(type_name) {
        let c: String = CompilerSymbolCharAt(type_name, i);
        if StringIndexOf(
            "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789", c
        ) >= 0 {
            out = Concat(out, c);
            wrote = true;
        } else if wrote &&
            CompilerSymbolCharAt(out, StringLength(out) - 1) != "_" {
            out = Concat(out, "_");
        }
        i = i + 1;
    }
    while StringLength(out) > 0 &&
        CompilerSymbolCharAt(out, StringLength(out) - 1) == "_" {
        out = Substring(out, 0, StringLength(out) - 1);
    }
    if !wrote { return "Type"; }
    return out;
}
func CompilerSymbolCGenericSpecializationName(
    base_name: String,
    actual_type_names: Array<String>
) -> String {
    let out: String = CompilerSymbolCIdentifier(base_name);
    let i: Int = 0;
    while i < ArrayLength(actual_type_names) {
        out = Concat(out, Concat(
            "_", CompilerSymbolCMangledTypeName(actual_type_names[i])
        ));
        i = i + 1;
    }
    return out;
}
func CompilerSymbolCFieldName(field_name: String) -> String {
    return CompilerSymbolCIdentifier(field_name);
}
func CompilerSymbolCBindingName(source_name: String) -> String {
    return CompilerSymbolCIdentifier(source_name);
}
func CompilerSymbolCInoutParamName(param_name: String) -> String {
    return Concat("_pgy_inout_", CompilerSymbolCIdentifier(param_name));
}
func CompilerSymbolCReadonlyRefParamName(param_name: String) -> String {
    return Concat("_pgy_ref_", CompilerSymbolCIdentifier(param_name));
}
func CompilerSymbolCForEachCollectionTempName(loop_var_name: String) -> String {
    return Concat("_pgyc_", CompilerSymbolCIdentifier(loop_var_name));
}
func CompilerSymbolCForEachIndexTempName(loop_var_name: String) -> String {
    return Concat("_pgyi_", CompilerSymbolCIdentifier(loop_var_name));
}
func CompilerSymbolCTryTempName(node_index: Int) -> String {
    return Concat("_pgy_try_", ToString(node_index));
}
func CompilerSymbolCMatchTempName(node_index: Int) -> String {
    return Concat("_pgy_match_", ToString(node_index));
}
func CompilerSymbolCRoleOperatorName(role_name: String, op_name: String) -> String {
    return CompilerSymbolCQualifiedName(role_name, op_name);
}
func CompilerSymbolCOperatorAdapterName(type_name: String, op_name: String) -> String {
    return Concat(
        "operator_", Concat(
            CompilerSymbolCIdentifier(op_name),
            Concat("_", CompilerSymbolCIdentifier(type_name))
        )
    );
}
func CompilerSymbolCEnumVariantName(enum_name: String, variant_name: String) -> String {
    return CompilerSymbolCQualifiedName(enum_name, variant_name);
}
func CompilerSymbolTableReady() -> Bool {
    return CompilerSymbolTableRowCount() > 0 &&
        CompilerSymbolTableRowAt(CompilerSymbolTableRowCount()) == "" &&
        CompilerSymbolTableRowKnown(CompilerSymbolSourceOwnerRow()) &&
        CompilerSymbolTableRowKnown(CompilerSymbolSourceNameRow()) &&
        CompilerSymbolTableRowKnown(CompilerSymbolNamespacePathRow()) &&
        CompilerSymbolTableRowKnown(CompilerSymbolCSymbolRow()) &&
        CompilerSymbolTableRowKnown(CompilerSymbolLlvmSymbolRow()) &&
        CompilerSymbolTableRowKnown(CompilerSymbolSelfHostedSymbolRow()) &&
        CompilerSymbolTableRowKnown(CompilerSymbolCollisionPolicyRow()) &&
        CompilerSymbolProjectionCount() > 0 &&
        CompilerSymbolProjectionAt(CompilerSymbolProjectionCount()) == "" &&
        CompilerSymbolProjectionKnown(CompilerSymbolCSymbolRow()) &&
        CompilerSymbolProjectionKnown(CompilerSymbolLlvmSymbolRow()) &&
        CompilerSymbolProjectionKnown(CompilerSymbolSelfHostedSymbolRow());
}
