// Self-host compiler target-capability owner.
//
// Owns the target acceptance/fallback envelope that backend projections must
// consume before emission. This is a fact owner, not an accelerator backend.

func CompilerTargetCapabilitySchema() -> String {
    return "pgy.selfhost.target-capability-envelope.v1";
}

func CompilerTargetProjectionCount() -> Int {
    return 3;
}

func CompilerTargetProjectionAt(index: Int) -> String {
    if index == 0 {
        return "cpu-c";
    }
    if index == 1 {
        return "cpu-llvm";
    }
    if index == 2 {
        return "self-hosted";
    }
    return "";
}

func CompilerTargetFactCount() -> Int {
    return 8;
}

func CompilerTargetFactAt(index: Int) -> String {
    if index == 0 {
        return "intent_graph";
    }
    if index == 1 {
        return "effect_set";
    }
    if index == 2 {
        return "authority_evidence";
    }
    if index == 3 {
        return "coordination";
    }
    if index == 4 {
        return "slot_ownership";
    }
    if index == 5 {
        return "layout_shape";
    }
    if index == 6 {
        return "loss_budget";
    }
    if index == 7 {
        return "materialization_reason";
    }
    return "";
}

func CompilerTargetFallbackReasonCount() -> Int {
    return 5;
}

func CompilerTargetFallbackReasonAt(index: Int) -> String {
    if index == 0 {
        return "unsupported_shape";
    }
    if index == 1 {
        return "forbidden_loss_budget";
    }
    if index == 2 {
        return "retained_effect";
    }
    if index == 3 {
        return "missing_authority_evidence";
    }
    if index == 4 {
        return "host_only_slot_boundary";
    }
    return "";
}

func CompilerTargetCapabilityEnvelopeReady() -> Bool {
    return CompilerTargetProjectionCount() == 3 &&
        CompilerTargetProjectionAt(0) == "cpu-c" &&
        CompilerTargetProjectionAt(1) == "cpu-llvm" &&
        CompilerTargetProjectionAt(2) == "self-hosted" &&
        CompilerTargetFactCount() == 8 &&
        CompilerTargetFactAt(0) == "intent_graph" &&
        CompilerTargetFactAt(1) == "effect_set" &&
        CompilerTargetFactAt(2) == "authority_evidence" &&
        CompilerTargetFactAt(3) == "coordination" &&
        CompilerTargetFactAt(4) == "slot_ownership" &&
        CompilerTargetFactAt(5) == "layout_shape" &&
        CompilerTargetFactAt(6) == "loss_budget" &&
        CompilerTargetFactAt(7) == "materialization_reason" &&
        CompilerTargetFallbackReasonCount() == 5 &&
        CompilerTargetFallbackReasonAt(0) == "unsupported_shape" &&
        CompilerTargetFallbackReasonAt(1) == "forbidden_loss_budget" &&
        CompilerTargetFallbackReasonAt(2) == "retained_effect" &&
        CompilerTargetFallbackReasonAt(3) == "missing_authority_evidence" &&
        CompilerTargetFallbackReasonAt(4) == "host_only_slot_boundary";
}
