// Self-host compiler target-capability owner.
//
// Owns the target acceptance/fallback envelope that backend projections must
// consume before emission. This is a fact owner, not an accelerator backend.

func CompilerTargetCapabilitySchema() -> String {
    return "pgy.selfhost.target-capability-envelope.v1";
}

func CompilerTargetProjectionCount() -> Int {
    return 3;
}

func CompilerTargetCpuCProjection() -> String {
    return "cpu-c";
}

func CompilerTargetCpuLlvmProjection() -> String {
    return "cpu-llvm";
}

func CompilerTargetSelfHostedProjection() -> String {
    return "self-hosted";
}

func CompilerTargetProjectionAt(index: Int) -> String {
    if index == 0 {
        return CompilerTargetCpuCProjection();
    }
    if index == 1 {
        return CompilerTargetCpuLlvmProjection();
    }
    if index == 2 {
        return CompilerTargetSelfHostedProjection();
    }
    return "";
}

func CompilerTargetFactCount() -> Int {
    return 8;
}

func CompilerTargetIntentGraphFact() -> String {
    return "intent_graph";
}

func CompilerTargetEffectSetFact() -> String {
    return "effect_set";
}

func CompilerTargetAuthorityEvidenceFact() -> String {
    return "authority_evidence";
}

func CompilerTargetCoordinationFact() -> String {
    return "coordination";
}

func CompilerTargetSlotOwnershipFact() -> String {
    return "slot_ownership";
}

func CompilerTargetLayoutShapeFact() -> String {
    return "layout_shape";
}

func CompilerTargetLossBudgetFact() -> String {
    return "loss_budget";
}

func CompilerTargetMaterializationReasonFact() -> String {
    return "materialization_reason";
}

func CompilerTargetFactAt(index: Int) -> String {
    if index == 0 {
        return CompilerTargetIntentGraphFact();
    }
    if index == 1 {
        return CompilerTargetEffectSetFact();
    }
    if index == 2 {
        return CompilerTargetAuthorityEvidenceFact();
    }
    if index == 3 {
        return CompilerTargetCoordinationFact();
    }
    if index == 4 {
        return CompilerTargetSlotOwnershipFact();
    }
    if index == 5 {
        return CompilerTargetLayoutShapeFact();
    }
    if index == 6 {
        return CompilerTargetLossBudgetFact();
    }
    if index == 7 {
        return CompilerTargetMaterializationReasonFact();
    }
    return "";
}

func CompilerTargetFallbackReasonCount() -> Int {
    return 5;
}

func CompilerTargetUnsupportedShapeFallbackReason() -> String {
    return "unsupported_shape";
}

func CompilerTargetForbiddenLossBudgetFallbackReason() -> String {
    return "forbidden_loss_budget";
}

func CompilerTargetRetainedEffectFallbackReason() -> String {
    return "retained_effect";
}

func CompilerTargetMissingAuthorityEvidenceFallbackReason() -> String {
    return "missing_authority_evidence";
}

func CompilerTargetHostOnlySlotBoundaryFallbackReason() -> String {
    return "host_only_slot_boundary";
}

func CompilerTargetFallbackReasonAt(index: Int) -> String {
    if index == 0 {
        return CompilerTargetUnsupportedShapeFallbackReason();
    }
    if index == 1 {
        return CompilerTargetForbiddenLossBudgetFallbackReason();
    }
    if index == 2 {
        return CompilerTargetRetainedEffectFallbackReason();
    }
    if index == 3 {
        return CompilerTargetMissingAuthorityEvidenceFallbackReason();
    }
    if index == 4 {
        return CompilerTargetHostOnlySlotBoundaryFallbackReason();
    }
    return "";
}

func CompilerTargetProjectionKnown(projection: String) -> Bool {
    let i: Int = 0;
    while i < CompilerTargetProjectionCount() {
        if CompilerTargetProjectionAt(i) == projection {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func CompilerTargetFactKnown(fact: String) -> Bool {
    let i: Int = 0;
    while i < CompilerTargetFactCount() {
        if CompilerTargetFactAt(i) == fact {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func CompilerTargetFallbackReasonKnown(reason: String) -> Bool {
    let i: Int = 0;
    while i < CompilerTargetFallbackReasonCount() {
        if CompilerTargetFallbackReasonAt(i) == reason {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// The self-host projection carries a bounded positive fingerprint so the
// derived row can be checked after it leaves this owner.  The native owner
// keeps its full-width FNV fingerprint; both implementations hash this same
// ordered envelope (schema, projections, facts, fallback reasons), while the
// bounded self-host representation remains safe for Pergyra Int carriage.
func CompilerTargetCapabilityFingerprintHashString(
    hash: Long, value: String, modulus: Long
) -> Long {
    let length: Int = StringLength(value);
    let next: Long = (hash * 131L + (length as Long)) % modulus;
    let i: Int = 0;
    let out: Long = next;
    while i < length {
        out = (out * 131L + (CharCode(value, length, i) as Long)) % modulus;
        i = i + 1;
    }
    return out;
}

func CompilerTargetCapabilityFingerprint() -> Int {
    if !CompilerTargetCapabilityEnvelopeReady() {
        return 0;
    }
    let modulus: Long = 268435456L;
    let hash: Long = 7L;
    hash = CompilerTargetCapabilityFingerprintHashString(
        hash, CompilerTargetCapabilitySchema(), modulus
    );
    hash = (hash * 131L + (CompilerTargetProjectionCount() as Long)) % modulus;
    let projection_i: Int = 0;
    while projection_i < CompilerTargetProjectionCount() {
        hash = CompilerTargetCapabilityFingerprintHashString(
            hash, CompilerTargetProjectionAt(projection_i), modulus
        );
        projection_i = projection_i + 1;
    }
    hash = (hash * 131L + (CompilerTargetFactCount() as Long)) % modulus;
    let fact_i: Int = 0;
    while fact_i < CompilerTargetFactCount() {
        hash = CompilerTargetCapabilityFingerprintHashString(
            hash, CompilerTargetFactAt(fact_i), modulus
        );
        fact_i = fact_i + 1;
    }
    hash = (hash * 131L + (CompilerTargetFallbackReasonCount() as Long)) % modulus;
    let fallback_i: Int = 0;
    while fallback_i < CompilerTargetFallbackReasonCount() {
        hash = CompilerTargetCapabilityFingerprintHashString(
            hash, CompilerTargetFallbackReasonAt(fallback_i), modulus
        );
        fallback_i = fallback_i + 1;
    }
    return (1073741824L + hash) as Int;
}

func CompilerTargetCapabilityEnvelopeReady() -> Bool {
    return CompilerTargetProjectionCount() > 0 &&
        CompilerTargetProjectionAt(CompilerTargetProjectionCount()) == "" &&
        CompilerTargetProjectionKnown(CompilerTargetCpuCProjection()) &&
        CompilerTargetProjectionKnown(CompilerTargetCpuLlvmProjection()) &&
        CompilerTargetProjectionKnown(CompilerTargetSelfHostedProjection()) &&
        CompilerTargetFactCount() > 0 &&
        CompilerTargetFactAt(CompilerTargetFactCount()) == "" &&
        CompilerTargetFactKnown(CompilerTargetIntentGraphFact()) &&
        CompilerTargetFactKnown(CompilerTargetEffectSetFact()) &&
        CompilerTargetFactKnown(CompilerTargetAuthorityEvidenceFact()) &&
        CompilerTargetFactKnown(CompilerTargetCoordinationFact()) &&
        CompilerTargetFactKnown(CompilerTargetSlotOwnershipFact()) &&
        CompilerTargetFactKnown(CompilerTargetLayoutShapeFact()) &&
        CompilerTargetFactKnown(CompilerTargetLossBudgetFact()) &&
        CompilerTargetFactKnown(CompilerTargetMaterializationReasonFact()) &&
        CompilerTargetFallbackReasonCount() > 0 &&
        CompilerTargetFallbackReasonAt(CompilerTargetFallbackReasonCount()) == "" &&
        CompilerTargetFallbackReasonKnown(CompilerTargetUnsupportedShapeFallbackReason()) &&
        CompilerTargetFallbackReasonKnown(CompilerTargetForbiddenLossBudgetFallbackReason()) &&
        CompilerTargetFallbackReasonKnown(CompilerTargetRetainedEffectFallbackReason()) &&
        CompilerTargetFallbackReasonKnown(CompilerTargetMissingAuthorityEvidenceFallbackReason()) &&
        CompilerTargetFallbackReasonKnown(CompilerTargetHostOnlySlotBoundaryFallbackReason());
}
