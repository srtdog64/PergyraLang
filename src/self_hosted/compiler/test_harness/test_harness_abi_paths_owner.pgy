// TestHarness ABI path owner.

func CompilerHarnessAbiLayoutRowsSuiteName() -> String {
    return "abi-layout-rows";
}

func CompilerHarnessAbiLayoutRowsToolSourcePath() -> String {
    return "src/self_hosted/compiler/abi_layout_row_manifest.pgy";
}

func CompilerHarnessAbiLayoutRowsExpectedPath() -> String {
    return "src/self_hosted/compiler/expected/abi_layout_rows.txt";
}

func CompilerHarnessAbiLayoutRowsPathCount() -> Int {
    return 2;
}

func CompilerHarnessAbiLayoutRowsPathAt(index: Int) -> String {
    if index == 0 { return CompilerHarnessAbiLayoutRowsToolSourcePath(); }
    if index == 1 { return CompilerHarnessAbiLayoutRowsExpectedPath(); }
    return "";
}

func CompilerHarnessAbiLayoutRowsPathKnown(path: String) -> Bool {
    if path == CompilerHarnessAbiLayoutRowsToolSourcePath() { return true; }
    if path == CompilerHarnessAbiLayoutRowsExpectedPath() { return true; }
    return false;
}

func CompilerHarnessAbiLayoutRowsReady() -> Bool {
    return CompilerHarnessAbiLayoutRowsSuiteName() != "" &&
        CompilerHarnessAbiLayoutRowsPathCount() > 0 &&
        CompilerHarnessAbiLayoutRowsPathAt(CompilerHarnessAbiLayoutRowsPathCount()) == "" &&
        CompilerHarnessAbiLayoutRowsPathKnown(CompilerHarnessAbiLayoutRowsToolSourcePath()) &&
        CompilerHarnessAbiLayoutRowsPathKnown(CompilerHarnessAbiLayoutRowsExpectedPath());
}

