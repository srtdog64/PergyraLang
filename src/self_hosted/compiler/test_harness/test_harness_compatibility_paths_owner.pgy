// TestHarness compatibility path owner.

func CompilerHarnessCompatibilityCorpusSuiteName() -> String { return "compatibility-corpus-paths"; }
func CompilerHarnessCompatibilityCorpusToolSourcePath() -> String { return "src/self_hosted/tools/compatibility_evolution_checker/main.pgy"; }
func CompilerHarnessCompatibilityCorpusExpectedJsonPath() -> String { return "src/self_hosted/tools/compatibility_evolution_checker/expected/clean.json"; }
func CompilerHarnessCompatibilityCorpusMalformedRowExpectedJsonPath() -> String { return "src/self_hosted/tools/compatibility_evolution_checker/expected/malformed_row.json"; }
func CompilerHarnessCompatibilityCorpusInvalidCodefixExpectedJsonPath() -> String { return "src/self_hosted/tools/compatibility_evolution_checker/expected/invalid_codefix_status.json"; }
func CompilerHarnessCompatibilityCorpusInvalidDiagnosticIdExpectedJsonPath() -> String { return "src/self_hosted/tools/compatibility_evolution_checker/expected/invalid_diagnostic_id.json"; }
func CompilerHarnessCompatibilityCorpusInvalidMigrationUrlExpectedJsonPath() -> String { return "src/self_hosted/tools/compatibility_evolution_checker/expected/invalid_migration_url.json"; }
func CompilerHarnessCompatibilityCorpusInvalidChangeKindExpectedJsonPath() -> String { return "src/self_hosted/tools/compatibility_evolution_checker/expected/invalid_change_kind.json"; }
func CompilerHarnessCompatibilityCorpusInvalidObsoleteMigrationExpectedJsonPath() -> String { return "src/self_hosted/tools/compatibility_evolution_checker/expected/invalid_obsolete_migration.json"; }
func CompilerHarnessCompatibilityCorpusMissingSurfaceExpectedJsonPath() -> String { return "src/self_hosted/tools/compatibility_evolution_checker/expected/missing_surface.json"; }

func CompilerHarnessCompatibilityCorpusPathCount() -> Int {
    return 9;
}

func CompilerHarnessCompatibilityCorpusPathAt(index: Int) -> String {
    if index == 0 { return CompilerHarnessCompatibilityCorpusToolSourcePath(); }
    if index == 1 { return CompilerHarnessCompatibilityCorpusExpectedJsonPath(); }
    if index == 2 { return CompilerHarnessCompatibilityCorpusMalformedRowExpectedJsonPath(); }
    if index == 3 { return CompilerHarnessCompatibilityCorpusInvalidCodefixExpectedJsonPath(); }
    if index == 4 { return CompilerHarnessCompatibilityCorpusInvalidDiagnosticIdExpectedJsonPath(); }
    if index == 5 { return CompilerHarnessCompatibilityCorpusInvalidMigrationUrlExpectedJsonPath(); }
    if index == 6 { return CompilerHarnessCompatibilityCorpusInvalidChangeKindExpectedJsonPath(); }
    if index == 7 { return CompilerHarnessCompatibilityCorpusInvalidObsoleteMigrationExpectedJsonPath(); }
    if index == 8 { return CompilerHarnessCompatibilityCorpusMissingSurfaceExpectedJsonPath(); }
    return "";
}

func CompilerHarnessCompatibilityCorpusPathKnown(path: String) -> Bool {
    if path == CompilerHarnessCompatibilityCorpusToolSourcePath() { return true; }
    if path == CompilerHarnessCompatibilityCorpusExpectedJsonPath() { return true; }
    if path == CompilerHarnessCompatibilityCorpusMalformedRowExpectedJsonPath() { return true; }
    if path == CompilerHarnessCompatibilityCorpusInvalidCodefixExpectedJsonPath() { return true; }
    if path == CompilerHarnessCompatibilityCorpusInvalidDiagnosticIdExpectedJsonPath() { return true; }
    if path == CompilerHarnessCompatibilityCorpusInvalidMigrationUrlExpectedJsonPath() { return true; }
    if path == CompilerHarnessCompatibilityCorpusInvalidChangeKindExpectedJsonPath() { return true; }
    if path == CompilerHarnessCompatibilityCorpusInvalidObsoleteMigrationExpectedJsonPath() { return true; }
    if path == CompilerHarnessCompatibilityCorpusMissingSurfaceExpectedJsonPath() { return true; }
    return false;
}

func CompilerHarnessCompatibilityCorpusReady() -> Bool {
    return CompilerHarnessCompatibilityCorpusSuiteName() != "" &&
        CompilerHarnessCompatibilityCorpusPathCount() > 0 &&
        CompilerHarnessCompatibilityCorpusPathAt(CompilerHarnessCompatibilityCorpusPathCount()) == "" &&
        CompilerHarnessCompatibilityCorpusPathKnown(CompilerHarnessCompatibilityCorpusToolSourcePath()) &&
        CompilerHarnessCompatibilityCorpusPathKnown(CompilerHarnessCompatibilityCorpusExpectedJsonPath()) &&
        CompilerHarnessCompatibilityCorpusPathKnown(CompilerHarnessCompatibilityCorpusMalformedRowExpectedJsonPath()) &&
        CompilerHarnessCompatibilityCorpusPathKnown(CompilerHarnessCompatibilityCorpusInvalidCodefixExpectedJsonPath()) &&
        CompilerHarnessCompatibilityCorpusPathKnown(CompilerHarnessCompatibilityCorpusInvalidDiagnosticIdExpectedJsonPath()) &&
        CompilerHarnessCompatibilityCorpusPathKnown(CompilerHarnessCompatibilityCorpusInvalidMigrationUrlExpectedJsonPath()) &&
        CompilerHarnessCompatibilityCorpusPathKnown(CompilerHarnessCompatibilityCorpusInvalidChangeKindExpectedJsonPath()) &&
        CompilerHarnessCompatibilityCorpusPathKnown(CompilerHarnessCompatibilityCorpusInvalidObsoleteMigrationExpectedJsonPath()) &&
        CompilerHarnessCompatibilityCorpusPathKnown(CompilerHarnessCompatibilityCorpusMissingSurfaceExpectedJsonPath());
}

func CompilerHarnessCompatibilityEvolutionSuiteName() -> String {
    return "compatibility-evolution";
}

func CompilerHarnessCompatibilityEvolutionToolSourcePath() -> String {
    return "src/self_hosted/compiler/compatibility_evolution_manifest.pgy";
}

func CompilerHarnessCompatibilityEvolutionExpectedPath() -> String {
    return "src/self_hosted/compiler/expected/compatibility_evolution.txt";
}

func CompilerHarnessCompatibilityEvolutionPathCount() -> Int {
    return 2;
}

func CompilerHarnessCompatibilityEvolutionPathAt(index: Int) -> String {
    if index == 0 { return CompilerHarnessCompatibilityEvolutionToolSourcePath(); }
    if index == 1 { return CompilerHarnessCompatibilityEvolutionExpectedPath(); }
    return "";
}

func CompilerHarnessCompatibilityEvolutionPathKnown(path: String) -> Bool {
    if path == CompilerHarnessCompatibilityEvolutionToolSourcePath() { return true; }
    if path == CompilerHarnessCompatibilityEvolutionExpectedPath() { return true; }
    return false;
}

func CompilerHarnessCompatibilityEvolutionReady() -> Bool {
    return CompilerHarnessCompatibilityEvolutionSuiteName() != "" &&
        CompilerHarnessCompatibilityEvolutionPathCount() > 0 &&
        CompilerHarnessCompatibilityEvolutionPathAt(CompilerHarnessCompatibilityEvolutionPathCount()) == "" &&
        CompilerHarnessCompatibilityEvolutionPathKnown(CompilerHarnessCompatibilityEvolutionToolSourcePath()) &&
        CompilerHarnessCompatibilityEvolutionPathKnown(CompilerHarnessCompatibilityEvolutionExpectedPath());
}
