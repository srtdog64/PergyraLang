// TestHarness AIR graph consumer path owner.
//
// Keeps AIR graph consumer parity suites out of the generic tool-path owner.
// Shell may execute these rows, but path ownership lives here.

func CompilerHarnessAirGraphScanOwnerPath() -> String {
    return "src/self_hosted/tools/air_graph_json_validator/scan_owner.pgy";
}

func CompilerHarnessAirGraphJsonValidatorSuiteName() -> String {
    return "air-graph-json-validator-paths";
}

func CompilerHarnessAirGraphJsonValidatorToolSourcePath() -> String {
    return "src/self_hosted/tools/air_graph_json_validator/main.pgy";
}

func CompilerHarnessAirGraphJsonValidatorAirEvidenceOwnerPath() -> String {
    return "src/self_hosted/compiler/air_evidence_owner.pgy";
}

func CompilerHarnessAirGraphJsonValidatorExpectedJsonPath() -> String {
