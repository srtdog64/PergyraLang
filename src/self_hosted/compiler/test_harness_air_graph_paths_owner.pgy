// TestHarness AIR graph consumer path owner.
//
// Keeps AIR graph consumer parity suites out of the generic tool-path owner.
// Shell may execute these rows, but path ownership lives here.

func CompilerHarnessAirGraphScanOwnerPath() -> String {
    return "src/self_hosted/tools/air_graph_json_validator/scan_owner.pgy";
}

func CompilerHarnessAirGraphIdUniquenessSuiteName() -> String {
    return "air-graph-id-uniqueness-paths";
}

func CompilerHarnessAirGraphIdUniquenessPathCount() -> Int {
    return 5;
}

func CompilerHarnessAirGraphIdUniquenessPathAt(index: Int) -> String {
    if index == 0 { return "src/self_hosted/tools/air_graph_id_uniqueness/main.pgy"; }
    if index == 1 { return CompilerHarnessAirGraphScanOwnerPath(); }
    if index == 2 { return "src/self_hosted/tools/air_graph_id_uniqueness/expected/clean.json"; }
    if index == 3 { return "src/self_hosted/tools/air_graph_id_uniqueness/fixture/graph_ids.json"; }
    if index == 4 { return "src/self_hosted/tools/air_graph_id_uniqueness/fixture/graph_ids_dup.json"; }
    return "";
}

func CompilerHarnessAirGraphIdUniquenessReady() -> Bool {
    return CompilerHarnessAirGraphIdUniquenessSuiteName() != "" &&
        CompilerHarnessAirGraphIdUniquenessPathCount() == 5 &&
        CompilerHarnessAirGraphIdUniquenessPathAt(0) != "" &&
        CompilerHarnessAirGraphIdUniquenessPathAt(4) != "";
}

