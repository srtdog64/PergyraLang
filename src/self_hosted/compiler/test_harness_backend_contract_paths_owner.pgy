// TestHarness backend-emitter contract path owner.

func CompilerHarnessBackendEmitterContractSuiteName() -> String {
    return "backend-emitter-contract-paths";
}

func CompilerHarnessBackendEmitterContractToolSourcePath() -> String {
    return "src/self_hosted/tools/backend_emitter_contract_checker/main.pgy";
}

func CompilerHarnessBackendEmitterContractExpectedJsonPath() -> String {
    return "src/self_hosted/tools/backend_emitter_contract_checker/expected/clean.json";
}

func CompilerHarnessBackendEmitterContractMissingRequiredJsonPath() -> String {
    return "src/self_hosted/tools/backend_emitter_contract_checker/expected/missing_required.json";
}

func CompilerHarnessBackendEmitterContractForbiddenHitJsonPath() -> String {
    return "src/self_hosted/tools/backend_emitter_contract_checker/expected/forbidden_hit.json";
}

func CompilerHarnessBackendEmitterContractPathCount() -> Int {
    return 4;
}

func CompilerHarnessBackendEmitterContractPathAt(index: Int) -> String {
    if index == 0 { return CompilerHarnessBackendEmitterContractToolSourcePath(); }
    if index == 1 { return CompilerHarnessBackendEmitterContractExpectedJsonPath(); }
    if index == 2 { return CompilerHarnessBackendEmitterContractMissingRequiredJsonPath(); }
    if index == 3 { return CompilerHarnessBackendEmitterContractForbiddenHitJsonPath(); }
    return "";
}

func CompilerHarnessBackendEmitterContractReady() -> Bool {
    return CompilerHarnessBackendEmitterContractSuiteName() != "" &&
        CompilerHarnessBackendEmitterContractPathCount() == 4 &&
        CompilerHarnessBackendEmitterContractPathAt(0) == CompilerHarnessBackendEmitterContractToolSourcePath() &&
        CompilerHarnessBackendEmitterContractPathAt(1) == CompilerHarnessBackendEmitterContractExpectedJsonPath() &&
        CompilerHarnessBackendEmitterContractPathAt(2) == CompilerHarnessBackendEmitterContractMissingRequiredJsonPath() &&
        CompilerHarnessBackendEmitterContractPathAt(3) == CompilerHarnessBackendEmitterContractForbiddenHitJsonPath();
}
