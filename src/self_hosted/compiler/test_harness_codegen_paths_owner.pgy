// Self-host codegen parity path owner.
//
// Keeps the codegen parity runner's executable/input paths behind TestHarness
// without growing the generic tool path owner past the source-size cap.

func CompilerHarnessCodegenParitySuiteName() -> String {
    return "codegen-parity-paths";
}

func CompilerHarnessCodegenToolSourcePath() -> String {
    return "src/self_hosted/codegen/main.pgy";
}

func CompilerHarnessCodegenParserSourcePath() -> String {
    return "src/self_hosted/parser/main.pgy";
}

func CompilerHarnessCodegenComparatorSourcePath() -> String {
    return "src/self_hosted/tools/backend_output_comparator/main.pgy";
}

func CompilerHarnessCodegenFixtureDirPath() -> String {
    return "src/self_hosted/codegen/fixture";
}

func CompilerHarnessCodegenExpectedDirPath() -> String {
    return "src/self_hosted/codegen/expected";
}

func CompilerHarnessCodegenRejectSourcePath() -> String {
    return "src/self_hosted/codegen/reject_fixture/enum_payload.pgy";
}

func CompilerHarnessCodegenRejectExpectedPath() -> String {
    return "src/self_hosted/codegen/reject_expected/enum_payload_stdout.txt";
}

func CompilerHarnessCodegenRoleSourcePath() -> String {
    return "src/self_hosted/codegen/role_fixture/operator_add.pgy";
}

func CompilerHarnessCodegenRoleExpectedPath() -> String {
    return "src/self_hosted/codegen/role_expected/operator_add_stdout.txt";
}

func CompilerHarnessCodegenEventRejectSourcePath() -> String {
    return "src/self_hosted/codegen/reject_fixture/event_decl.pgy";
}

func CompilerHarnessCodegenEventRejectExpectedPath() -> String {
    return "src/self_hosted/codegen/reject_expected/event_decl_stdout.txt";
}

func CompilerHarnessOptionAssignmentProbeSourcePath() -> String {
    return "src/self_hosted/tools/option_assignment_projection_probe/main.pgy";
}

func CompilerHarnessOptionAssignmentProbeExpectedPath() -> String {
    return "src/self_hosted/tools/option_assignment_projection_probe/expected.txt";
}

func CompilerHarnessCodegenPathCount() -> Int {
    return 13;
}

func CompilerHarnessCodegenPathAt(index: Int) -> String {
    if index == 0 { return CompilerHarnessCodegenToolSourcePath(); }
    if index == 1 { return CompilerHarnessCodegenParserSourcePath(); }
    if index == 2 { return CompilerHarnessCodegenComparatorSourcePath(); }
    if index == 3 { return CompilerHarnessCodegenFixtureDirPath(); }
    if index == 4 { return CompilerHarnessCodegenExpectedDirPath(); }
    if index == 5 { return CompilerHarnessCodegenRejectSourcePath(); }
    if index == 6 { return CompilerHarnessCodegenRejectExpectedPath(); }
    if index == 7 { return CompilerHarnessCodegenRoleSourcePath(); }
    if index == 8 { return CompilerHarnessCodegenRoleExpectedPath(); }
    if index == 9 { return CompilerHarnessCodegenEventRejectSourcePath(); }
    if index == 10 { return CompilerHarnessCodegenEventRejectExpectedPath(); }
    if index == 11 { return CompilerHarnessOptionAssignmentProbeSourcePath(); }
    if index == 12 { return CompilerHarnessOptionAssignmentProbeExpectedPath(); }
    return "";
}

func CompilerHarnessCodegenParityReady() -> Bool {
    if CompilerHarnessCodegenPathCount() != 13 {
        return false;
    }
    let i: Int = 0;
    while i < CompilerHarnessCodegenPathCount() {
        if CompilerHarnessCodegenPathAt(i) == "" {
            return false;
        }
        i = i + 1;
    }
    return CompilerHarnessCodegenParitySuiteName() != "";
}
