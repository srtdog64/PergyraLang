// TestHarness diagnostic path owner.
//
// Owns diagnostic-catalog checker source, expected artifact, and oracle path
// suites. Shell may execute these rows, but must not own them.

func CompilerHarnessDiagnosticCatalogSuiteName() -> String {
    return "diagnostic-catalog-paths";
}

func CompilerHarnessDiagnosticCatalogToolSourcePath() -> String {
    return "src/self_hosted/tools/diagnostic_catalog_checker/main.pgy";
}

func CompilerHarnessDiagnosticCatalogExpectedJsonPath() -> String {
    return "src/self_hosted/tools/diagnostic_catalog_checker/expected/clean.json";
}

func CompilerHarnessDiagnosticCatalogMissingCodeJsonPath() -> String {
    return "src/self_hosted/tools/diagnostic_catalog_checker/expected/missing_code.json";
}

func CompilerHarnessDiagnosticCatalogMissingInputJsonPath() -> String {
    return "src/self_hosted/tools/diagnostic_catalog_checker/expected/missing_input.json";
}

func CompilerHarnessDiagnosticCatalogCodeOwnerPath() -> String {
    return "src/semantic/diag_codes.h";
}

func CompilerHarnessDiagnosticCatalogDocsOwnerPath() -> String {
    return "docs/72_diagnostic_codes.md";
}

func CompilerHarnessDiagnosticCatalogCOraclePath() -> String {
    return "tests/diagnostic_registry_smoke.sh";
}

func CompilerHarnessDiagnosticCatalogPathCount() -> Int {
    return 7;
}

func CompilerHarnessDiagnosticCatalogPathAt(index: Int) -> String {
    if index == 0 { return CompilerHarnessDiagnosticCatalogToolSourcePath(); }
    if index == 1 { return CompilerHarnessDiagnosticCatalogExpectedJsonPath(); }
    if index == 2 { return CompilerHarnessDiagnosticCatalogMissingCodeJsonPath(); }
    if index == 3 { return CompilerHarnessDiagnosticCatalogMissingInputJsonPath(); }
    if index == 4 { return CompilerHarnessDiagnosticCatalogCodeOwnerPath(); }
    if index == 5 { return CompilerHarnessDiagnosticCatalogDocsOwnerPath(); }
    if index == 6 { return CompilerHarnessDiagnosticCatalogCOraclePath(); }
    return "";
}

func CompilerHarnessDiagnosticCatalogPathKnown(path: String) -> Bool {
    if path == CompilerHarnessDiagnosticCatalogToolSourcePath() { return true; }
    if path == CompilerHarnessDiagnosticCatalogExpectedJsonPath() { return true; }
    if path == CompilerHarnessDiagnosticCatalogMissingCodeJsonPath() { return true; }
    if path == CompilerHarnessDiagnosticCatalogMissingInputJsonPath() { return true; }
    if path == CompilerHarnessDiagnosticCatalogCodeOwnerPath() { return true; }
    if path == CompilerHarnessDiagnosticCatalogDocsOwnerPath() { return true; }
    if path == CompilerHarnessDiagnosticCatalogCOraclePath() { return true; }
    return false;
}

func CompilerHarnessDiagnosticCatalogReady() -> Bool {
    return CompilerHarnessDiagnosticCatalogSuiteName() != "" &&
        CompilerHarnessDiagnosticCatalogPathCount() > 0 &&
        CompilerHarnessDiagnosticCatalogPathAt(CompilerHarnessDiagnosticCatalogPathCount()) == "" &&
        CompilerHarnessDiagnosticCatalogPathKnown(CompilerHarnessDiagnosticCatalogToolSourcePath()) &&
        CompilerHarnessDiagnosticCatalogPathKnown(CompilerHarnessDiagnosticCatalogExpectedJsonPath()) &&
        CompilerHarnessDiagnosticCatalogPathKnown(CompilerHarnessDiagnosticCatalogMissingCodeJsonPath()) &&
        CompilerHarnessDiagnosticCatalogPathKnown(CompilerHarnessDiagnosticCatalogMissingInputJsonPath()) &&
        CompilerHarnessDiagnosticCatalogPathKnown(CompilerHarnessDiagnosticCatalogCodeOwnerPath()) &&
        CompilerHarnessDiagnosticCatalogPathKnown(CompilerHarnessDiagnosticCatalogDocsOwnerPath()) &&
        CompilerHarnessDiagnosticCatalogPathKnown(CompilerHarnessDiagnosticCatalogCOraclePath());
}
