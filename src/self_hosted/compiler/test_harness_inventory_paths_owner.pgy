// TestHarness inventory-checker path owner.
//
// Owns inventory checker source/input paths plus their negative finding
// vocabulary. Shell runners may mutate scratch fixtures, but must not own the
// semantic finding strings.

func CompilerHarnessModuleManifestResolverSuiteName() -> String {
    return "module-manifest-resolver-paths";
}

func CompilerHarnessModuleManifestResolverToolSourcePath() -> String {
    return "src/self_hosted/tools/module_manifest_resolver/main.pgy";
}

func CompilerHarnessModuleManifestResolverExpectedJsonPath() -> String {
    return "src/self_hosted/tools/module_manifest_resolver/expected/clean.json";
}

func CompilerHarnessModuleManifestResolverInputManifestPath() -> String {
    return "docs/language_module_manifest.json";
}

func CompilerHarnessModuleManifestResolverMissingModulesFixtureJson() -> String {
    return "{\"schema\":1,\"NOTMODULES\":[]}";
}

func CompilerHarnessModuleManifestResolverNestedModulesFixtureJson() -> String {
    return "{\"schema\":1,\"metadata\":{\"modules\":[]}}";
}

func CompilerHarnessModuleManifestResolverNestedFieldFixtureJson() -> String {
    return "{\"schema\":1,\"modules\":[{\"name\":\"pgy.synthetic\",\"status\":\"stable-subset\",\"beta_blocker\":true,\"surfaces\":[{\"layer\":\"not-a-module-layer\"}]}]}";
}

func CompilerHarnessModuleManifestResolverMissingModulesExpectedJsonPath() -> String {
    return "src/self_hosted/tools/module_manifest_resolver/expected/missing_modules_key.json";
}

func CompilerHarnessModuleManifestResolverNestedModulesExpectedJsonPath() -> String {
    return "src/self_hosted/tools/module_manifest_resolver/expected/nested_modules_key.json";
}

func CompilerHarnessModuleManifestResolverNestedFieldExpectedJsonPath() -> String {
    return "src/self_hosted/tools/module_manifest_resolver/expected/nested_field_layer.json";
}

func CompilerHarnessModuleManifestResolverPathCount() -> Int {
    return 9;
}

func CompilerHarnessModuleManifestResolverPathAt(index: Int) -> String {
    if index == 0 { return CompilerHarnessModuleManifestResolverToolSourcePath(); }
    if index == 1 { return CompilerHarnessModuleManifestResolverExpectedJsonPath(); }
    if index == 2 { return CompilerHarnessModuleManifestResolverInputManifestPath(); }
    if index == 3 { return CompilerHarnessModuleManifestResolverMissingModulesFixtureJson(); }
    if index == 4 { return CompilerHarnessModuleManifestResolverNestedModulesFixtureJson(); }
    if index == 5 { return CompilerHarnessModuleManifestResolverNestedFieldFixtureJson(); }
    if index == 6 { return CompilerHarnessModuleManifestResolverMissingModulesExpectedJsonPath(); }
    if index == 7 { return CompilerHarnessModuleManifestResolverNestedModulesExpectedJsonPath(); }
    if index == 8 { return CompilerHarnessModuleManifestResolverNestedFieldExpectedJsonPath(); }
    return "";
}

func CompilerHarnessModuleManifestResolverReady() -> Bool {
    if CompilerHarnessModuleManifestResolverPathCount() != 9 {
        return false;
    }
    let i: Int = 0;
    while i < CompilerHarnessModuleManifestResolverPathCount() {
        if CompilerHarnessModuleManifestResolverPathAt(i) == "" {
            return false;
        }
        i = i + 1;
    }
    return CompilerHarnessModuleManifestResolverSuiteName() != "";
}

