func CompilerHarnessLspTransportFramePathAt(index: Int) -> String {
    if index == 0 { return CompilerHarnessLspToolSourcePath(); }
    if index == 1 { return "src/self_hosted/lsp/expected/transport_frame.json"; }
    if index == 2 { return "src/self_hosted/lsp/expected/transport_frame_incomplete.json"; }
    return "";
}

