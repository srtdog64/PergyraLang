// TestHarness LSP path owner.
//
// Owns LSP parity tool, fixture, and expected artifact paths. Shell parity
// runners may execute these rows, but must not own the path constants.

func CompilerHarnessLspToolSourcePath() -> String {
    return "src/self_hosted/lsp/main.pgy";
}

func CompilerHarnessLspDiagnosticsSuiteName() -> String {
    return "lsp-diagnostics-paths";
}

func CompilerHarnessLspDiagnosticsFixtureCount() -> Int {
    return 6;
}

func CompilerHarnessLspDiagnosticsFixtureBaseAt(index: Int) -> String {
    if index == 0 { return "valid_int_return"; }
    if index == 1 { return "bad_logical_right"; }
    if index == 2 { return "bad_undefined_return"; }
    if index == 3 { return "bad_return_type"; }
    if index == 4 { return "bad_while_condition"; }
    if index == 5 { return "bad_not_operand"; }
    return "";
}

func CompilerHarnessLspDiagnosticsFixturePathAt(index: Int) -> String {
    let base: String = CompilerHarnessLspDiagnosticsFixtureBaseAt(index);
    if base == "" { return ""; }
    return Concat(Concat("src/self_hosted/lsp/fixture/", base), ".pgy");
}

func CompilerHarnessLspDiagnosticsExpectedPathAt(index: Int) -> String {
    let base: String = CompilerHarnessLspDiagnosticsFixtureBaseAt(index);
    if base == "" { return ""; }
    return Concat(Concat("src/self_hosted/lsp/expected/", base), ".json");
}

func CompilerHarnessLspSquigglePolicyExpectedPath() -> String {
    return "src/self_hosted/lsp/expected/squiggle_policy.json";
}

func CompilerHarnessLspDiagnosticsPathCount() -> Int {
    return 2 + CompilerHarnessLspDiagnosticsFixtureCount() * 2;
}

func CompilerHarnessLspDiagnosticsPathAt(index: Int) -> String {
    if index == 0 { return CompilerHarnessLspToolSourcePath(); }
    if index == 1 { return CompilerHarnessLspSquigglePolicyExpectedPath(); }
    let shifted: Int = index - 2;
    let fixture_count: Int = CompilerHarnessLspDiagnosticsFixtureCount();
    if shifted >= 0 && shifted < fixture_count {
        return CompilerHarnessLspDiagnosticsFixturePathAt(shifted);
    }
    if shifted >= fixture_count && shifted < fixture_count * 2 {
        return CompilerHarnessLspDiagnosticsExpectedPathAt(shifted - fixture_count);
    }
    return "";
}

func CompilerHarnessLspDiagnosticsReady() -> Bool {
    if CompilerHarnessLspDiagnosticsSuiteName() == "" {
        return false;
    }
    if CompilerHarnessLspDiagnosticsPathCount() != 14 {
        return false;
    }
    let i: Int = 0;
    while i < CompilerHarnessLspDiagnosticsPathCount() {
        if CompilerHarnessLspDiagnosticsPathAt(i) == "" {
            return false;
        }
        i = i + 1;
    }
    return true;
}

