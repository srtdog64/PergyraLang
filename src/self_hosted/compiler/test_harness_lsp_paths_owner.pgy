func CompilerHarnessLspDocumentStoreSuiteName() -> String {
    return "lsp-document-store-paths";
}

func CompilerHarnessLspDocumentStorePathCount() -> Int {
    return 9;
}

func CompilerHarnessLspDocumentStorePathAt(index: Int) -> String {
    if index == 0 { return CompilerHarnessLspToolSourcePath(); }
    if index == 1 { return "src/self_hosted/lsp/expected/document_store.json"; }
    if index == 2 { return "src/self_hosted/lsp/expected/document_store_multi_uri.json"; }
    if index == 3 { return "{\"jsonrpc\":\"2.0\",\"method\":\"initialized\"}"; }
    if index == 4 { return "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file:///main.pgy\",\"version\":1,\"text\":\"Log(1);\"}}}"; }
    if index == 5 { return "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"file:///main.pgy\",\"version\":2},\"contentChanges\":[{\"text\":\"Log(2);\"}]}}"; }
    if index == 6 { return "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file:///a.pgy\",\"version\":1,\"text\":\"A\"}}}"; }
    if index == 7 { return "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file:///b.pgy\",\"version\":1,\"text\":\"B0\"}}}"; }
    if index == 8 { return "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"file:///b.pgy\",\"version\":2},\"contentChanges\":[{\"text\":\"B\"}]}}"; }
    return "";
}

func CompilerHarnessLspSessionStateSuiteName() -> String {
    return "lsp-session-state-paths";
}

func CompilerHarnessLspSessionStatePathCount() -> Int {
    return 4;
}

func CompilerHarnessLspSessionStatePathAt(index: Int) -> String {
    if index == 0 { return CompilerHarnessLspToolSourcePath(); }
    if index == 1 { return "src/self_hosted/lsp/expected/session_state.json"; }
    if index == 2 { return "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file:///main.pgy\",\"version\":1,\"text\":\"Log(1);\"}}}"; }
    if index == 3 { return "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"textDocument/hover\",\"params\":{}}"; }
    return "";
}

func CompilerHarnessLspHoverContentSuiteName() -> String {
    return "lsp-hover-content-paths";
}

func CompilerHarnessLspHoverContentPathCount() -> Int {
    return 5;
}

func CompilerHarnessLspHoverContentPathAt(index: Int) -> String {
    if index == 0 { return CompilerHarnessLspToolSourcePath(); }
    if index == 1 { return "src/self_hosted/lsp/expected/hover_content.json"; }
    if index == 2 { return "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file:///main.pgy\",\"version\":1,\"text\":\"func Main() -> Void {}\"}}}"; }
    if index == 3 { return "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"textDocument/hover\",\"params\":{\"textDocument\":{\"uri\":\"file:///main.pgy\"},\"position\":{\"line\":0,\"character\":1}}}"; }
    if index == 4 { return "{\"jsonrpc\":\"2.0\",\"id\":8,\"method\":\"textDocument/hover\",\"params\":{\"textDocument\":{\"uri\":\"file:///main.pgy\"},\"position\":{\"line\":0,\"character\":8}}}"; }
    return "";
}

func CompilerHarnessLspPathSuiteReady(count: Int, last_path: String) -> Bool {
    return count >= 2 &&
        CompilerHarnessLspToolSourcePath() != "" &&
        last_path != "";
}

func CompilerHarnessLspPathsReady() -> Bool {
    return CompilerHarnessLspDiagnosticsReady() &&
        CompilerHarnessLspPathSuiteReady(
            CompilerHarnessLspTransportFramePathCount(),
            CompilerHarnessLspTransportFramePathAt(2)
        ) &&
        CompilerHarnessLspPathSuiteReady(
            CompilerHarnessLspTransportStreamPathCount(),
            CompilerHarnessLspTransportStreamPathAt(2)
        ) &&
        CompilerHarnessLspPathSuiteReady(
            CompilerHarnessLspRequestDispatchPathCount(),
            CompilerHarnessLspRequestDispatchPathAt(2)
        ) &&
        CompilerHarnessLspPathSuiteReady(
            CompilerHarnessLspResponseEmissionPathCount(),
            CompilerHarnessLspResponseEmissionPathAt(3)
        ) &&
        CompilerHarnessLspPathSuiteReady(
            CompilerHarnessLspSessionReplayPathCount(),
            CompilerHarnessLspSessionReplayPathAt(3)
        ) &&
        CompilerHarnessLspPathSuiteReady(
            CompilerHarnessLspDocumentStorePathCount(),
            CompilerHarnessLspDocumentStorePathAt(2)
        ) &&
        CompilerHarnessLspPathSuiteReady(
            CompilerHarnessLspSessionStatePathCount(),
            CompilerHarnessLspSessionStatePathAt(1)
        ) &&
        CompilerHarnessLspPathSuiteReady(
            CompilerHarnessLspHoverContentPathCount(),
            CompilerHarnessLspHoverContentPathAt(1)
        );
}
