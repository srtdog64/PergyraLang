}

func EmitSelfHostCompletenessLexParseSemanticBaseline() -> Void {
    EmitCompilerCompletenessLexParseSemanticBaseline();
}

func EmitSelfHostCompletenessFullPipelineBaseline() -> Void {
    EmitCompilerCompletenessFullPipelineBaseline();
}

func Main() -> Void {
    let args: Array<String> = Args();
    if !CompilerTestHarnessReady() {
        Log("HARNESS ERROR: test harness owner rows not ready");
        Exit(1);
        return;
    }
    if ArrayLength(args) == 0 || args[0] == CompilerHarnessBackendTriSmokeSuiteName() {
        EmitBackendTriSmokeCases();
        return;
    }
    if args[0] == CompilerHarnessBackendTriExtendedSuiteName() {
        EmitBackendTriExtendedCases();
        return;
    }
    if args[0] == CompilerHarnessLinterParitySuiteName() {
        EmitLinterParityPaths();
        return;
    }
    if args[0] == CompilerHarnessModuleManifestResolverSuiteName() {
        EmitModuleManifestResolverPaths();
        return;
    }
    if args[0] == CompilerHarnessStableSubsetSectionSuiteName() {
        EmitStableSubsetSectionPaths();
        return;
    }
    if args[0] == CompilerHarnessRuntimeBoundarySuiteName() {
        EmitRuntimeBoundaryPaths();
        return;
    }
    if args[0] == CompilerHarnessDocLinkCheckerSuiteName() {
        EmitDocLinkCheckerPaths();
        return;
    }
    if args[0] == CompilerHarnessExamplesInventorySuiteName() {
        EmitExamplesInventoryPaths();
        return;
    }
    if args[0] == CompilerHarnessLexerParitySuiteName() {
        EmitLexerParityPaths();
        return;
    }
    if args[0] == CompilerHarnessBackendOutputComparatorSuiteName() {
        EmitBackendOutputComparatorPaths();
        return;
    }
    if args[0] == CompilerHarnessAirGraphJsonValidatorSuiteName() {
        EmitAirGraphJsonValidatorPaths();
        return;
    }
    if args[0] == CompilerHarnessAirGraphIdUniquenessSuiteName() {
        EmitAirGraphIdUniquenessPaths();
        return;
    }
    if args[0] == CompilerHarnessAirGraphNodeCountSuiteName() {
        EmitAirGraphNodeCountPaths();
        return;
    }
    if args[0] == CompilerHarnessAirGraphReachabilitySuiteName() {
        EmitAirGraphReachabilityPaths();
        return;
    }
    if args[0] == CompilerHarnessAirGraphRefIntegritySuiteName() {
        EmitAirGraphRefIntegrityPaths();
        return;
    }
    if args[0] == CompilerHarnessAirGraphRefLiveSuiteName() {
        EmitAirGraphRefLivePaths();
        return;
    }
    if args[0] == CompilerHarnessDiagnosticCatalogSuiteName() {
        EmitDiagnosticCatalogPaths();
        return;
    }
    if args[0] == CompilerHarnessAstReadSurfaceSuiteName() {
        EmitAstReadSurfacePaths();
        return;
    }
    if args[0] == CompilerHarnessStdlibDispatchInventorySuiteName() {
        EmitStdlibDispatchInventoryPaths();
        return;
    }
    if args[0] == CompilerHarnessProductionCSizeSuiteName() {
        EmitProductionCSizePaths();
        return;
    }
    if args[0] == CompilerHarnessProductionHeaderSizeSuiteName() {
        EmitProductionHeaderSizePaths();
        return;
    }
    if args[0] == CompilerHarnessDriverRung0SuiteName() {
        EmitDriverRung0Paths();
        return;
    }
    if args[0] == CompilerHarnessDriverRung1SuiteName() {
        EmitDriverRung1Paths();
        return;
    }
    if args[0] == CompilerCompletenessSourcesSuiteName() {
        EmitSelfHostCompletenessSources();
        return;
    }
    if args[0] == CompilerCompletenessStagesSuiteName() {
        EmitSelfHostCompletenessStages();
        return;
    }
    if args[0] == CompilerCompletenessSemanticTargetsSuiteName() {
        EmitSelfHostCompletenessSemanticTargets();
        return;
    }
    if args[0] == CompilerCompletenessBaselineSuiteName() {
        EmitSelfHostCompletenessBaseline();
        return;
    }
    if args[0] == CompilerCompletenessLexParseBaselineSuiteName() {
        EmitSelfHostCompletenessLexParseBaseline();
        return;
    }
    if args[0] == CompilerCompletenessLexParseSemanticBaselineSuiteName() {
        EmitSelfHostCompletenessLexParseSemanticBaseline();
        return;
    }
    if args[0] == CompilerCompletenessFullPipelineBaselineSuiteName() {
        EmitSelfHostCompletenessFullPipelineBaseline();
        return;
    }
    Log(Concat("HARNESS ERROR: unknown manifest suite: ", args[0]));
    Exit(1);
}
