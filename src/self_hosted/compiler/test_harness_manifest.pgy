    }
}

func Main() -> Void {
    let args: Array<String> = Args();
    if !CompilerTestHarnessReady() {
        Log("HARNESS ERROR: test harness owner rows not ready");
        Exit(1);
        return;
    }
    if ArrayLength(args) == 0 || args[0] == CompilerHarnessBackendTriSmokeSuiteName() {
        EmitBackendTriSmokeCases();
        return;
    }
    if args[0] == CompilerHarnessBackendTriExtendedSuiteName() {
        EmitBackendTriExtendedCases();
        return;
    }
    if args[0] == CompilerHarnessLinterParitySuiteName() {
        EmitLinterParityPaths();
        return;
    }
    if args[0] == CompilerHarnessModuleManifestResolverSuiteName() {
        EmitModuleManifestResolverPaths();
        return;
    }
    if args[0] == CompilerHarnessStableSubsetSectionSuiteName() {
        EmitStableSubsetSectionPaths();
        return;
    }
    if args[0] == CompilerHarnessRuntimeBoundarySuiteName() {
        EmitRuntimeBoundaryPaths();
        return;
    }
    if args[0] == CompilerHarnessDocLinkCheckerSuiteName() {
        EmitDocLinkCheckerPaths();
        return;
    }
    if args[0] == CompilerHarnessExamplesInventorySuiteName() {
        EmitExamplesInventoryPaths();
        return;
    }
    if args[0] == CompilerHarnessAstReadSurfaceSuiteName() {
        EmitAstReadSurfacePaths();
        return;
    }
    if args[0] == CompilerHarnessProductionCSizeSuiteName() {
        EmitProductionCSizePaths();
        return;
    }
    if args[0] == CompilerHarnessProductionHeaderSizeSuiteName() {
        EmitProductionHeaderSizePaths();
        return;
    }
    Log(Concat("HARNESS ERROR: unknown manifest suite: ", args[0]));
    Exit(1);
}
