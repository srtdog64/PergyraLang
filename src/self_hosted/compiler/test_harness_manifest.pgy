func EmitSelfHostCompletenessSources() -> Void {
    EmitCompilerCompletenessSourceInventory();
}

func EmitSelfHostCompletenessStages() -> Void {
    EmitCompilerCompletenessStages();
}

func EmitSelfHostCompletenessSemanticTargets() -> Void {
    EmitCompilerCompletenessSemanticTargets();
}

func EmitSelfHostCompletenessBaseline() -> Void {
    EmitCompilerCompletenessBaseline();
}

