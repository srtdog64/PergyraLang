// TestHarness manifest projection entrypoint.
//
// Emits line-oriented harness records owned by test_harness_owner.pgy. Shell
// parity scripts may execute these records, but must not own the suite list.

import "test_harness_owner.pgy";

func EmitBackendTriSmokeCases() -> Void {
    let i: Int = 0;
    while i < CompilerHarnessBackendTriSmokeCaseCount() {
        Log(CompilerHarnessBackendTriSmokeCaseAt(i));
        i = i + 1;
    }
}

func EmitBackendTriExtendedCases() -> Void {
    let i: Int = 0;
    while i < CompilerHarnessBackendTriExtendedCaseCount() {
        Log(CompilerHarnessBackendTriExtendedCaseAt(i));
        i = i + 1;
    }
}

func EmitLinterParityPaths() -> Void {
    let i: Int = 0;
    while i < CompilerHarnessLinterPathCount() {
        Log(CompilerHarnessLinterPathAt(i));
        i = i + 1;
    }
}

func EmitModuleManifestResolverPaths() -> Void {
    let i: Int = 0;
    while i < CompilerHarnessModuleManifestResolverPathCount() {
        Log(CompilerHarnessModuleManifestResolverPathAt(i));
        i = i + 1;
    }
}

func Main() -> Void {
    let args: Array<String> = Args();
    if !CompilerTestHarnessReady() {
        Log("HARNESS ERROR: test harness owner rows not ready");
        Exit(1);
        return;
    }
    if ArrayLength(args) == 0 || args[0] == CompilerHarnessBackendTriSmokeSuiteName() {
        EmitBackendTriSmokeCases();
        return;
    }
    if args[0] == CompilerHarnessBackendTriExtendedSuiteName() {
        EmitBackendTriExtendedCases();
        return;
    }
    if args[0] == CompilerHarnessLinterParitySuiteName() {
        EmitLinterParityPaths();
        return;
    }
    if args[0] == CompilerHarnessModuleManifestResolverSuiteName() {
        EmitModuleManifestResolverPaths();
        return;
    }
    Log(Concat("HARNESS ERROR: unknown manifest suite: ", args[0]));
    Exit(1);
}
