// TestHarness manifest projection entrypoint.
//
// Emits line-oriented harness records owned by test_harness_owner.pgy. Shell
// parity scripts may execute these records, but must not own the suite list.

import "test_harness_owner.pgy";
import "test_harness_tool_paths_owner.pgy";
import "test_harness_inventory_paths_owner.pgy";
import "test_harness_size_paths_owner.pgy";
import "test_harness_air_graph_paths_owner.pgy";
import "test_harness_driver_paths_owner.pgy";
import "test_harness_codegen_paths_owner.pgy";
import "test_harness_parser_paths_owner.pgy";
import "test_harness_semantic_paths_owner.pgy";
import "test_harness_mir_json_paths_owner.pgy";
import "test_harness_codegen_bootstrap_paths_owner.pgy";
import "test_harness_lsp_paths_owner.pgy";
import "completeness_ledger_owner.pgy";
import "path_manifest_owner.pgy";

func EmitBackendTriSmokeCases() -> Void {
    let i: Int = 0;
    while i < CompilerHarnessBackendTriSmokeCaseCount() {
        Log(CompilerHarnessBackendTriSmokeCaseAt(i));
        i = i + 1;
    }
}

