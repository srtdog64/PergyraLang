// Self-host compiler test-harness owner.
//
// Owns the fixture/result row vocabulary for hard self-host parity.

import "test_harness_tool_paths_owner.pgy";
import "test_harness_abi_paths_owner.pgy";
import "test_harness_execution_lane_paths_owner.pgy";
import "test_harness_compatibility_paths_owner.pgy";
import "test_harness_target_paths_owner.pgy";
import "test_harness_backend_contract_paths_owner.pgy";
import "test_harness_comparator_paths_owner.pgy";
import "test_harness_backend_compare_paths_owner.pgy";
import "test_harness_inventory_paths_owner.pgy";
import "test_harness_size_paths_owner.pgy";
import "test_harness_air_graph_paths_owner.pgy";
import "test_harness_driver_paths_owner.pgy";
import "test_harness_codegen_paths_owner.pgy";
import "test_harness_parser_paths_owner.pgy";
import "test_harness_semantic_paths_owner.pgy";
import "test_harness_mir_json_paths_owner.pgy";
import "test_harness_codegen_bootstrap_paths_owner.pgy";
import "test_harness_lsp_paths_owner.pgy";
import "completeness_ledger_owner.pgy";
import "incremental_fact_graph_owner.pgy";

func CompilerTestHarnessSchema() -> String {
    return "pgy.selfhost.test-harness.v1";
}

func CompilerHarnessRowCount() -> Int {
    return 8;
}

func CompilerHarnessSourcePathRow() -> String {
    return "source_path";
}

func CompilerHarnessExpectedDiagnosticRow() -> String {
    return "expected_diagnostic";
}

func CompilerHarnessExpectedAirJsonRow() -> String {
    return "expected_air_json";
}

func CompilerHarnessExpectedMirJsonRow() -> String {
    return "expected_mir_json";
}

func CompilerHarnessExpectedAbiLayoutRow() -> String {
    return "expected_abi_layout";
}

func CompilerHarnessExpectedStdoutRow() -> String {
    return "expected_stdout";
}

func CompilerHarnessExpectedExitRow() -> String {
    return "expected_exit";
}

func CompilerHarnessProjectionRow() -> String {
    return "projection";
}

func CompilerHarnessRowIndexKnown(index: Int) -> Bool {
    return index >= 0 &&
        index < CompilerHarnessRowCount() &&
        CompilerHarnessRowAt(index) != "";
}

func CompilerHarnessRowKnown(row: String) -> Bool {
    let index: Int = 0;
    while index < CompilerHarnessRowCount() {
        if CompilerHarnessRowAt(index) == row {
            return true;
        }
        index = index + 1;
    }
    return false;
}

func CompilerHarnessRowAt(index: Int) -> String {
    if index == 0 { return CompilerHarnessSourcePathRow(); }
    if index == 1 { return CompilerHarnessExpectedDiagnosticRow(); }
    if index == 2 { return CompilerHarnessExpectedAirJsonRow(); }
    if index == 3 { return CompilerHarnessExpectedMirJsonRow(); }
    if index == 4 { return CompilerHarnessExpectedAbiLayoutRow(); }
    if index == 5 { return CompilerHarnessExpectedStdoutRow(); }
    if index == 6 { return CompilerHarnessExpectedExitRow(); }
    if index == 7 { return CompilerHarnessProjectionRow(); }
    return "";
}

func CompilerHarnessProjectionCount() -> Int {
    return 3;
}

func CompilerHarnessCOracleProjection() -> String {
    return "c_oracle";
}

func CompilerHarnessLlvmOracleProjection() -> String {
    return "llvm_oracle";
}

func CompilerHarnessSelfHostedProjection() -> String {
    return "self_hosted";
}

func CompilerHarnessProjectionAt(index: Int) -> String {
    if index == 0 { return CompilerHarnessCOracleProjection(); }
    if index == 1 { return CompilerHarnessLlvmOracleProjection(); }
    if index == 2 { return CompilerHarnessSelfHostedProjection(); }
    return "";
}

func CompilerHarnessProjectionIndexKnown(index: Int) -> Bool {
    return index >= 0 &&
        index < CompilerHarnessProjectionCount() &&
        CompilerHarnessProjectionAt(index) != "";
}

func CompilerHarnessProjectionKnown(projection: String) -> Bool {
    let index: Int = 0;
    while index < CompilerHarnessProjectionCount() {
        if CompilerHarnessProjectionAt(index) == projection {
            return true;
        }
        index = index + 1;
    }
    return false;
}

func CompilerHarnessProjectionOrExit(index: Int) -> String {
    if !CompilerHarnessProjectionIndexKnown(index) {
        Log("HARNESS ERROR: unknown projection row");
        Exit(1);
        return "";
    }
    return CompilerHarnessProjectionAt(index);
}

func CompilerHarnessFindingCap() -> Int {
    return 8;
}

func CompilerTestHarnessReady() -> Bool {
    return CompilerHarnessRowCount() > 0 &&
        CompilerHarnessRowKnown(CompilerHarnessSourcePathRow()) &&
        CompilerHarnessRowKnown(CompilerHarnessExpectedDiagnosticRow()) &&
        CompilerHarnessRowKnown(CompilerHarnessExpectedAirJsonRow()) &&
        CompilerHarnessRowKnown(CompilerHarnessExpectedMirJsonRow()) &&
        CompilerHarnessRowKnown(CompilerHarnessExpectedAbiLayoutRow()) &&
        CompilerHarnessRowKnown(CompilerHarnessExpectedStdoutRow()) &&
        CompilerHarnessRowKnown(CompilerHarnessExpectedExitRow()) &&
        CompilerHarnessRowKnown(CompilerHarnessProjectionRow()) &&
        CompilerHarnessRowIndexKnown(0) &&
        CompilerHarnessRowIndexKnown(CompilerHarnessRowCount() - 1) &&
        !CompilerHarnessRowIndexKnown(CompilerHarnessRowCount()) &&
        CompilerHarnessProjectionCount() > 0 &&
        CompilerHarnessProjectionKnown(CompilerHarnessCOracleProjection()) &&
        CompilerHarnessProjectionKnown(CompilerHarnessLlvmOracleProjection()) &&
        CompilerHarnessProjectionKnown(CompilerHarnessSelfHostedProjection()) &&
        CompilerHarnessProjectionIndexKnown(0) &&
        CompilerHarnessProjectionIndexKnown(1) &&
        CompilerHarnessProjectionIndexKnown(CompilerHarnessProjectionCount() - 1) &&
        !CompilerHarnessProjectionIndexKnown(CompilerHarnessProjectionCount()) &&
        CompilerHarnessComparableArtifactPathCount() > 0 &&
        CompilerHarnessComparableArtifactPathKnown(CompilerHarnessExpectedComparableArtifactPath()) &&
        CompilerHarnessComparableArtifactPathKnown(CompilerHarnessActualComparableArtifactPath()) &&
        CompilerHarnessComparableArtifactPathAt(CompilerHarnessComparableArtifactPathCount()) == "" &&
        CompilerHarnessFindingCap() > 0 &&
        CompilerHarnessAbiLayoutRowsReady() &&
        CompilerHarnessRuntimeCallAbiRowsReady() &&
        CompilerHarnessTargetCapabilityEnvelopeReady() &&
        CompilerHarnessSandboxCapabilityReady() &&
        CompilerHarnessBackendEmitterContractReady() &&
        CompilerHarnessBackendAirAccessReady() &&
        CompilerHarnessBackendAbiLayoutContractReady() &&
        CompilerHarnessCompatibilityEvolutionReady() &&
        CompilerHarnessExecutionLaneParityReady() &&
        CompilerHarnessLinterParityReady() &&
        CompilerHarnessCompatibilityCorpusReady() &&
        CompilerHarnessModuleManifestResolverReady() &&
        CompilerHarnessStableSubsetSectionReady() &&
        CompilerHarnessRuntimeBoundaryReady() &&
        CompilerHarnessDocLinkCheckerReady() &&
        CompilerHarnessExamplesInventoryReady() &&
        CompilerHarnessLexerParityReady() &&
        CompilerHarnessCodegenParityReady() &&
        CompilerHarnessParserParityReady() &&
        CompilerHarnessSemanticParityReady() &&
        CompilerHarnessMirJsonParityReady() &&
        CompilerHarnessCodegenBootstrapRowsReady() &&
        CompilerCompletenessLedgerReady() &&
        CompilerIncrementalFactGraphReady() &&
        CompilerHarnessBackendOutputComparatorReady() &&
        CompilerHarnessAirGraphJsonValidatorReady() &&
        CompilerHarnessDiagnosticCatalogReady() &&
        CompilerHarnessAstReadSurfaceReady() &&
        CompilerHarnessStdlibDispatchInventoryReady() &&
        CompilerHarnessProductionCSizeReady() &&
        CompilerHarnessProductionHeaderSizeReady() &&
        CompilerHarnessAirGraphConsumersReady() &&
        CompilerHarnessLspPathsReady() &&
        CompilerHarnessDriverPathsReady() &&
        CompilerHarnessBackendTriSuiteReady();
}
