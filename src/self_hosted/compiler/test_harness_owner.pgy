// Self-host compiler test-harness owner.
//
// Owns the fixture/result row vocabulary for hard self-host parity.

import "test_harness_tool_paths_owner.pgy";

func CompilerTestHarnessSchema() -> String {
    return "pgy.selfhost.test-harness.v1";
}

func CompilerHarnessRowCount() -> Int {
    return 8;
}

func CompilerHarnessSourcePathRow() -> String {
    return "source_path";
}

func CompilerHarnessExpectedDiagnosticRow() -> String {
    return "expected_diagnostic";
}

func CompilerHarnessExpectedAirJsonRow() -> String {
    return "expected_air_json";
}

func CompilerHarnessExpectedMirJsonRow() -> String {
    return "expected_mir_json";
}

func CompilerHarnessExpectedAbiLayoutRow() -> String {
    return "expected_abi_layout";
}

func CompilerHarnessExpectedStdoutRow() -> String {
    return "expected_stdout";
}

func CompilerHarnessExpectedExitRow() -> String {
    return "expected_exit";
}

func CompilerHarnessProjectionRow() -> String {
    return "projection";
}

func CompilerHarnessRowAt(index: Int) -> String {
    if index == 0 { return CompilerHarnessSourcePathRow(); }
    if index == 1 { return CompilerHarnessExpectedDiagnosticRow(); }
    if index == 2 { return CompilerHarnessExpectedAirJsonRow(); }
    if index == 3 { return CompilerHarnessExpectedMirJsonRow(); }
    if index == 4 { return CompilerHarnessExpectedAbiLayoutRow(); }
    if index == 5 { return CompilerHarnessExpectedStdoutRow(); }
    if index == 6 { return CompilerHarnessExpectedExitRow(); }
    if index == 7 { return CompilerHarnessProjectionRow(); }
    return "";
}

func CompilerHarnessProjectionCount() -> Int {
    return 3;
}

func CompilerHarnessCOracleProjection() -> String {
    return "c_oracle";
}

func CompilerHarnessLlvmOracleProjection() -> String {
    return "llvm_oracle";
}

func CompilerHarnessSelfHostedProjection() -> String {
    return "self_hosted";
}

func CompilerHarnessProjectionAt(index: Int) -> String {
    if index == 0 { return CompilerHarnessCOracleProjection(); }
    if index == 1 { return CompilerHarnessLlvmOracleProjection(); }
    if index == 2 { return CompilerHarnessSelfHostedProjection(); }
    return "";
}

func CompilerHarnessProjectionIndexKnown(index: Int) -> Bool {
    return index >= 0 &&
        index < CompilerHarnessProjectionCount() &&
        CompilerHarnessProjectionAt(index) != "";
}

func CompilerHarnessProjectionOrExit(index: Int) -> String {
    if !CompilerHarnessProjectionIndexKnown(index) {
        Log("HARNESS ERROR: unknown projection row");
        Exit(1);
        return "";
    }
    return CompilerHarnessProjectionAt(index);
}

func CompilerHarnessComparableArtifactPathCount() -> Int {
    return 2;
}

func CompilerHarnessExpectedComparableArtifactPath() -> String {
    return "src/self_hosted/tools/backend_output_comparator/fixture/expected.txt";
}

func CompilerHarnessActualComparableArtifactPath() -> String {
    return "src/self_hosted/tools/backend_output_comparator/fixture/actual.txt";
}

func CompilerHarnessComparableArtifactPathAt(index: Int) -> String {
    if index == 0 { return CompilerHarnessExpectedComparableArtifactPath(); }
    if index == 1 { return CompilerHarnessActualComparableArtifactPath(); }
    return "";
}

func CompilerHarnessFindingCap() -> Int {
    return 8;
}

func CompilerHarnessBackendTriSmokeSuiteName() -> String {
    return "backend-tri-smoke";
}

func CompilerHarnessBackendTriExtendedSuiteName() -> String {
    return "backend-tri-extended";
}

func CompilerHarnessBackendTriSmokeCaseCount() -> Int {
    return 14;
}

func CompilerHarnessBackendTriSmokeCaseAt(index: Int) -> String {
    if index == 0 { return "tests/cases/backend_compare/basic"; }
    if index == 1 { return "tests/cases/backend_compare/arith_grand_total"; }
    if index == 2 { return "tests/cases/backend_compare/array_builtins"; }
    if index == 3 { return "tests/cases/backend_compare/allocator_lane_boxarray"; }
    if index == 4 { return "tests/cases/backend_compare/allocator_defer_cleanup"; }
    if index == 5 { return "tests/cases/backend_compare/class_factory_field_method"; }
    if index == 6 { return "tests/cases/backend_compare/channel_send_recv_basic"; }
    if index == 7 { return "tests/cases/backend_compare/async_spawn_await"; }
    if index == 8 { return "tests/cases/backend_compare/slice_surface"; }
    if index == 9 { return "tests/cases/backend_compare/slice_copy"; }
    if index == 10 { return "tests/cases/backend_compare/string_interpolation"; }
    if index == 11 { return "tests/cases/backend_compare/pin_write_view_block"; }
    if index == 12 { return "tests/cases/backend_compare/secure_slot_view"; }
    if index == 13 { return "tests/cases/backend_compare/intent_zone_binding"; }
    return "";
}

func CompilerHarnessBackendTriExtendedCaseCount() -> Int {
    return 17;
}

func CompilerHarnessBackendTriExtendedCaseAt(index: Int) -> String {
    if index == 0 { return "tests/cases/backend_compare/file_handle_io"; }
    if index == 1 { return "tests/cases/backend_compare/io_string_negative_paths"; }
    if index == 2 { return "tests/cases/backend_compare/rc_weak_lifecycle"; }
    if index == 3 { return "tests/cases/backend_compare/hashmap_basic_ops"; }
    if index == 4 { return "tests/cases/backend_compare/list_mutation_ops"; }
    if index == 5 { return "tests/cases/backend_compare/queue_state_ops"; }
    if index == 6 { return "tests/cases/backend_compare/set_membership_ops"; }
    if index == 7 { return "tests/cases/backend_compare/try_operator_result"; }
    if index == 8 { return "tests/cases/backend_compare/future_cancel_state"; }
    if index == 9 { return "tests/cases/backend_compare/select_single_ready"; }
    if index == 10 { return "tests/cases/backend_compare/unsafe_lexical_boundary"; }
    if index == 11 { return "tests/cases/backend_compare/top_level_visibility_decl"; }
    if index == 12 { return "tests/cases/backend_compare/event_system"; }
    if index == 13 { return "tests/cases/backend_compare/generic_future_spawn_multi_arg"; }
    if index == 14 { return "tests/cases/backend_compare/runtime_seeded_random"; }
    if index == 15 { return "tests/cases/backend_compare/map_ops"; }
    if index == 16 { return "tests/cases/backend_compare/zone_host_method_abi_combo"; }
    return "";
}

func CompilerHarnessBackendTriSmokeCasesReady() -> Bool {
    if CompilerHarnessBackendTriSmokeCaseCount() != 14 {
        return false;
    }
    let i: Int = 0;
    while i < CompilerHarnessBackendTriSmokeCaseCount() {
        if CompilerHarnessBackendTriSmokeCaseAt(i) == "" {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func CompilerHarnessBackendTriExtendedCasesReady() -> Bool {
    if CompilerHarnessBackendTriExtendedCaseCount() != 17 {
        return false;
    }
    let i: Int = 0;
    while i < CompilerHarnessBackendTriExtendedCaseCount() {
        if CompilerHarnessBackendTriExtendedCaseAt(i) == "" {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func CompilerHarnessBackendTriSuiteReady() -> Bool {
    return CompilerHarnessBackendTriSmokeSuiteName() != "" &&
        CompilerHarnessBackendTriExtendedSuiteName() != "" &&
        CompilerHarnessBackendTriSmokeCasesReady() &&
        CompilerHarnessBackendTriExtendedCasesReady();
}

func CompilerTestHarnessReady() -> Bool {
    return CompilerHarnessRowCount() == 8 &&
        CompilerHarnessRowAt(0) == CompilerHarnessSourcePathRow() &&
        CompilerHarnessRowAt(1) == CompilerHarnessExpectedDiagnosticRow() &&
        CompilerHarnessRowAt(2) == CompilerHarnessExpectedAirJsonRow() &&
        CompilerHarnessRowAt(3) == CompilerHarnessExpectedMirJsonRow() &&
        CompilerHarnessRowAt(4) == CompilerHarnessExpectedAbiLayoutRow() &&
        CompilerHarnessRowAt(5) == CompilerHarnessExpectedStdoutRow() &&
        CompilerHarnessRowAt(6) == CompilerHarnessExpectedExitRow() &&
        CompilerHarnessRowAt(7) == CompilerHarnessProjectionRow() &&
        CompilerHarnessProjectionCount() == 3 &&
        CompilerHarnessProjectionAt(0) == CompilerHarnessCOracleProjection() &&
        CompilerHarnessProjectionAt(1) == CompilerHarnessLlvmOracleProjection() &&
        CompilerHarnessProjectionAt(2) == CompilerHarnessSelfHostedProjection() &&
        CompilerHarnessProjectionIndexKnown(0) &&
        CompilerHarnessProjectionIndexKnown(1) &&
        CompilerHarnessProjectionIndexKnown(2) &&
        CompilerHarnessComparableArtifactPathCount() == 2 &&
        CompilerHarnessComparableArtifactPathAt(0) == CompilerHarnessExpectedComparableArtifactPath() &&
        CompilerHarnessComparableArtifactPathAt(1) == CompilerHarnessActualComparableArtifactPath() &&
        CompilerHarnessFindingCap() > 0 &&
        CompilerHarnessLinterParityReady() &&
        CompilerHarnessModuleManifestResolverReady() &&
        CompilerHarnessStableSubsetSectionReady() &&
        CompilerHarnessRuntimeBoundaryReady() &&
        CompilerHarnessDocLinkCheckerReady() &&
        CompilerHarnessExamplesInventoryReady() &&
        CompilerHarnessAstReadSurfaceReady() &&
        CompilerHarnessProductionCSizeReady() &&
        CompilerHarnessProductionHeaderSizeReady() &&
        CompilerHarnessBackendTriSuiteReady();
}
