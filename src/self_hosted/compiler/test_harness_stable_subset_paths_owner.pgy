// TestHarness stable-subset path owner.
//
// Owns the self-host stable-subset section checker path suite separately from
// generic audit tools. The stable subset document is a beta surface contract,
// so its checker paths are a named TestHarness responsibility.

func CompilerHarnessStableSubsetSectionSuiteName() -> String {
    return "stable-subset-section-paths";
}

func CompilerHarnessStableSubsetSectionToolSourcePath() -> String {
    return "src/self_hosted/tools/stable_subset_section_checker/main.pgy";
}

func CompilerHarnessStableSubsetSectionExpectedJsonPath() -> String {
    return "src/self_hosted/tools/stable_subset_section_checker/expected/clean.json";
}

func CompilerHarnessStableSubsetSectionInputManifestPath() -> String {
    return "docs/107_beta_stable_subset.md";
}

func CompilerHarnessStableSubsetSectionMissingAnchor() -> String {
    return "## 3. Ownership Stable Subset";
}

func CompilerHarnessStableSubsetSectionMissingJsonPath() -> String {
    return "src/self_hosted/tools/stable_subset_section_checker/expected/missing_section.json";
}

func CompilerHarnessStableSubsetSectionPathCount() -> Int {
    return 5;
}

func CompilerHarnessStableSubsetSectionPathAt(index: Int) -> String {
    if index == 0 { return CompilerHarnessStableSubsetSectionToolSourcePath(); }
    if index == 1 { return CompilerHarnessStableSubsetSectionExpectedJsonPath(); }
    if index == 2 { return CompilerHarnessStableSubsetSectionInputManifestPath(); }
    if index == 3 { return CompilerHarnessStableSubsetSectionMissingAnchor(); }
    if index == 4 { return CompilerHarnessStableSubsetSectionMissingJsonPath(); }
    return "";
}

func CompilerHarnessStableSubsetSectionPathKnown(path: String) -> Bool {
    let i: Int = 0;
    while i < CompilerHarnessStableSubsetSectionPathCount() {
        if CompilerHarnessStableSubsetSectionPathAt(i) == path {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func CompilerHarnessStableSubsetSectionReady() -> Bool {
    return CompilerHarnessStableSubsetSectionPathCount() > 0 &&
        CompilerHarnessStableSubsetSectionSuiteName() != "" &&
        CompilerHarnessStableSubsetSectionPathKnown(CompilerHarnessStableSubsetSectionToolSourcePath()) &&
        CompilerHarnessStableSubsetSectionPathKnown(CompilerHarnessStableSubsetSectionExpectedJsonPath()) &&
        CompilerHarnessStableSubsetSectionPathKnown(CompilerHarnessStableSubsetSectionInputManifestPath()) &&
        CompilerHarnessStableSubsetSectionPathKnown(CompilerHarnessStableSubsetSectionMissingAnchor()) &&
        CompilerHarnessStableSubsetSectionPathKnown(CompilerHarnessStableSubsetSectionMissingJsonPath()) &&
        CompilerHarnessStableSubsetSectionPathAt(CompilerHarnessStableSubsetSectionPathCount()) == "";
}
