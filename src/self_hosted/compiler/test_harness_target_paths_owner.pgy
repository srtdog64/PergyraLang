    if index == 0 { return CompilerHarnessSandboxCapabilityToolSourcePath(); }
    if index == 1 { return CompilerHarnessSandboxCapabilityExpectedPath(); }
    if index == 2 { return CompilerHarnessSandboxCapabilityMissingBudgetExpectedPath(); }
