// TestHarness tool-path owner.
//
// Owns concrete tool, expected artifact, and fixture/input path suites for
// self-host parity scripts. Shell may execute these rows, but must not own
// them.

func CompilerHarnessLinterParitySuiteName() -> String {
    return "linter-parity-paths";
}

func CompilerHarnessLinterToolSourcePath() -> String {
    return "src/self_hosted/tools/linter/main.pgy";
}

func CompilerHarnessLinterExpectedDiagnosticsPath() -> String {
    return "src/self_hosted/tools/linter/expected/diagnostics.json";
}

func CompilerHarnessLinterFixturePath() -> String {
    return "src/self_hosted/tools/linter/fixture.pgy";
}

func CompilerHarnessLinterPathCount() -> Int {
    return 3;
}

func CompilerHarnessLinterPathAt(index: Int) -> String {
    if index == 0 { return CompilerHarnessLinterToolSourcePath(); }
    if index == 1 { return CompilerHarnessLinterExpectedDiagnosticsPath(); }
    if index == 2 { return CompilerHarnessLinterFixturePath(); }
    return "";
}

func CompilerHarnessLinterParityReady() -> Bool {
    if CompilerHarnessLinterPathCount() != 3 {
        return false;
    }
    let i: Int = 0;
    while i < CompilerHarnessLinterPathCount() {
        if CompilerHarnessLinterPathAt(i) == "" {
            return false;
        }
        i = i + 1;
    }
    return CompilerHarnessLinterParitySuiteName() != "";
}

func CompilerHarnessDocLinkCheckerSuiteName() -> String {
    return "doc-link-checker-paths";
}

func CompilerHarnessDocLinkCheckerToolSourcePath() -> String {
    return "src/self_hosted/tools/doc_link_checker/main.pgy";
}

func CompilerHarnessDocLinkCheckerExpectedJsonPath() -> String {
    return "src/self_hosted/tools/doc_link_checker/expected/clean.json";
}

func CompilerHarnessDocLinkCheckerIndexPath() -> String {
    return "docs/INDEX.md";
}

func CompilerHarnessDocLinkCheckerDeadLinkSourcePath() -> String {
    return "100_beta_readiness_checklist.md";
}

func CompilerHarnessDocLinkCheckerDeadLinkTargetPath() -> String {
    return "XX_NONEXISTENT_FAKE_DRIFT.md";
}

func CompilerHarnessDocLinkCheckerDeadLinkExpectedJsonPath() -> String {
    return "src/self_hosted/tools/doc_link_checker/expected/dead_link.json";
}

func CompilerHarnessDocLinkCheckerPathCount() -> Int {
    return 6;
}

func CompilerHarnessDocLinkCheckerPathAt(index: Int) -> String {
    if index == 0 { return CompilerHarnessDocLinkCheckerToolSourcePath(); }
    if index == 1 { return CompilerHarnessDocLinkCheckerExpectedJsonPath(); }
    if index == 2 { return CompilerHarnessDocLinkCheckerIndexPath(); }
    if index == 3 { return CompilerHarnessDocLinkCheckerDeadLinkSourcePath(); }
    if index == 4 { return CompilerHarnessDocLinkCheckerDeadLinkTargetPath(); }
    if index == 5 { return CompilerHarnessDocLinkCheckerDeadLinkExpectedJsonPath(); }
    return "";
}

func CompilerHarnessDocLinkCheckerReady() -> Bool {
    if CompilerHarnessDocLinkCheckerPathCount() != 6 {
        return false;
    }
    let i: Int = 0;
    while i < CompilerHarnessDocLinkCheckerPathCount() {
        if CompilerHarnessDocLinkCheckerPathAt(i) == "" {
            return false;
        }
        i = i + 1;
    }
    return CompilerHarnessDocLinkCheckerSuiteName() != "";
}
