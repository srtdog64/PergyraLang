import "path_manifest_owner.pgy";
import "target_capability_owner.pgy";
import "compatibility_evolution_owner.pgy";
import "air_evidence_owner.pgy";
import "sandbox_capability_owner.pgy";
import "artifact_zone_owner.pgy";
import "test_harness_owner.pgy";
import "subprocess_runner_owner.pgy";
import "abi_layout_row_owner.pgy";
import "symbol_table_owner.pgy";
import "stage_artifact_owner.pgy";
import "driver_rung2_execution_owner.pgy";
import "driver_source_mir_execution_owner.pgy";
import "driver_source_c_execution_owner.pgy";
subject SourceUnit {
    let path: String;
    action Read(self, paths: StagePathManifest) -> Bool
        requires SourceReading within SourceIntakeZone authorized by self {
        return CompilerStagePathManifestReady();
    }
}
subject LexerStage {
    let name: String;
    action Scan(self) -> Bool
        requires TokenScanning within TokenStreamZone authorized by self {
        return CompilerTokenStreamFactReady();
    }
}
subject ParserStage {
    let name: String;
    action BuildAst(self) -> Bool
        requires AstConstruction within AstTreeZone authorized by self {
        return CompilerAstTreeFactReady();
    }
}

subject SemanticStage {
    let name: String;
    action Check(self) -> Bool
        requires FactProving
        within SemanticVerdictZone
        authorized by self {
        return CompilerSemanticVerdictFactReady();
    }
}

subject MirLowerStage {
    let name: String;
    action Lower(self) -> Bool
        requires MirFactLowering within MirFactGraphZone authorized by self {
        return CompilerMirFactGraphReady();
    }
}

subject ProgramEmitter {
    let name: String;
    action Emit(self, types: TypeEnvZone, abi_layout: AbiLayoutZone, target_capability: TargetCapabilityZone) -> Bool
        requires ArtifactEmission
        within EmissionZone
        authorized by self {
        return CompilerEmissionFactReady() &&
            CompilerAbiLayoutRowsReady() &&
            CompilerSymbolTableReady() &&
            CompilerTargetCapabilityEnvelopeReady();
    }
}

subject TargetProjectionPlanner {
    let name: String;
    action Plan(self) -> Bool
        requires TargetProjectionPlanning within TargetCapabilityZone authorized by self {
        return CompilerTargetCapabilityEnvelopeReady();
    }
}

subject CompatibilityEvolutionOwner {
    let name: String;

    action Own(self) -> Bool
        requires CompatibilityFactOwnership within CompatibilityEvolutionZone authorized by self { return CompilerCompatibilityEvolutionReady(); }
}

subject AirEvidenceOwner {
    let name: String;

    action Verify(self) -> Bool
        requires AirEvidenceProving within AirEvidenceZone authorized by self { return CompilerAirEvidenceEnvelopeReady(); }
}

subject SandboxCapabilityOwner {
    let name: String;

    action Own(self) -> Bool { return CompilerSandboxCapabilityEnvelopeReady(); }
}

subject SymbolTableOwner {
    let name: String;

    action Own(self) -> Bool
        requires SymbolFactOwnership within SymbolFactTableZone authorized by self { return CompilerSymbolTableReady(); }
}

subject AbiRowProjector {
    let name: String;

    action Project(self) -> Bool
        requires AbiRowProjection within AbiRowProjectionZone authorized by self { return CompilerAbiLayoutRowsReady(); }
}

subject ArtifactSink {
    let name: String;

    action Collect(self) -> Bool
        requires ArtifactCollection within ArtifactZone authorized by self { return CompilerArtifactZoneReady(); }
}

subject TestHarnessRunner {
    let name: String;

    action Prepare(self) -> Bool
        requires TestHarnessPreparation within TestHarnessZone authorized by self { return CompilerTestHarnessReady(); }
}

subject SubprocessRunner {
    let name: String;

    action Plan(self) -> Bool
        requires SubprocessDiscipline
        within SubprocessRunnerZone
        authorized by self {
        return CompilerSubprocessRunnerReady();
    }
}

subject OraclePair {
    let c_backend: String;
    let llvm_backend: String;

    action Compare(self) -> Bool
        requires ParityJudging
        within ParityZone
        authorized by self {
        return CompilerArtifactZoneReady() && CompilerTestHarnessReady();
    }
}

object SourceBatch { schema: String; }

object StagePathManifest {
    root: String;
    source_dir: String;
    test_dir: String;
    parity_dir: String;
    compiler_world: String;
    lexer: String;
    parser: String;
    semantic: String;
    mir_lower: String;
    codegen: String;
}

object TokenStream { schema: String; }
object AstTree { schema: String; }
object SemanticVerdict { schema: String; }
object MirFactGraph { schema: String; }
object TypeEnvironment { schema: String; }
object AbiLayoutFacts { schema: String; }
object TargetCapabilityEnvelope { schema: String; }
object CompatibilityEvolutionFacts { schema: String; }
object AirEvidenceFacts { schema: String; }
object SandboxCapabilityFacts { schema: String; }
object SymbolFactTable { schema: String; }
object AbiLayoutRows { schema: String; }
object EmittedC { schema: String; }
object ArtifactEvidence { schema: String; }
object TestHarnessFacts { schema: String; }
object SubprocessCapabilityEnvelope { schema: String; }
tobject ParityVerdict { schema: String; }

import "stage_intents.pgy";
import "authority_owner.pgy";

zone SourceIntakeZone {
    subject slot source: SourceUnit
    object slot paths: StagePathManifest
    object slot imports: SourceBatch
    authority source requires SourceReading
}
zone TokenStreamZone {
    subject slot lexer: LexerStage
    object slot tokens: TokenStream
    authority lexer requires TokenScanning
}
zone AstTreeZone {
    subject slot parser: ParserStage
    object slot ast: AstTree
    authority parser requires AstConstruction
}
zone SemanticVerdictZone {
    subject slot checker: SemanticStage
    object slot verdict: SemanticVerdict
    authority checker requires FactProving
}

zone MirFactGraphZone {
    subject slot lowerer: MirLowerStage
    object slot mir: MirFactGraph
    authority lowerer requires MirFactLowering
}
zone TypeEnvZone {
    object slot bindings: TypeEnvironment
}

zone AbiLayoutZone {
    object slot layouts: AbiLayoutFacts
}

zone TargetCapabilityZone {
    subject slot planner: TargetProjectionPlanner
    object slot envelope: TargetCapabilityEnvelope
    authority planner requires TargetProjectionPlanning
}
zone CompatibilityEvolutionZone {
    subject slot owner: CompatibilityEvolutionOwner
    object slot facts: CompatibilityEvolutionFacts
    authority owner requires CompatibilityFactOwnership
}
zone AirEvidenceZone {
    subject slot owner: AirEvidenceOwner
    object slot facts: AirEvidenceFacts
    authority owner requires AirEvidenceProving
}
zone SandboxCapabilityZone {
    subject slot owner: SandboxCapabilityOwner
    object slot facts: SandboxCapabilityFacts
}

zone SymbolFactTableZone {
    subject slot owner: SymbolTableOwner
    object slot symbols: SymbolFactTable
    authority owner requires SymbolFactOwnership
}
zone AbiRowProjectionZone {
    subject slot projector: AbiRowProjector
    object slot rows: AbiLayoutRows
    authority projector requires AbiRowProjection
}
zone EmissionZone {
    subject slot emitter: ProgramEmitter
    object slot c_output: EmittedC
    authority emitter requires ArtifactEmission
}

zone ArtifactZone {
    subject slot sink: ArtifactSink
    object slot evidence: ArtifactEvidence
    authority sink requires ArtifactCollection
}
zone TestHarnessZone {
    subject slot runner: TestHarnessRunner
    object slot facts: TestHarnessFacts
    authority runner requires TestHarnessPreparation
}
zone SubprocessRunnerZone {
    subject slot runner: SubprocessRunner
    object slot envelope: SubprocessCapabilityEnvelope
    authority runner requires SubprocessDiscipline
}

zone ParityZone {
    subject slot oracle: OraclePair
    tobject slot verdict: ParityVerdict
    authority oracle requires ParityJudging
}

world PgyCompilerWorld {
    // Only executable zones are world members. The remaining declared zones
    // stay target topology until their production bypass is deleted; missing
    // required world facts may not be supplied by aggregate zero-fill.
    zone direct_mir: DriverRung2DirectMirZone
    zone source_mir: DriverSourceMirZone
    zone source_c: DriverSourceCZone

    func EmitDirectMir(
        self, mir_json_path: String, output_path: String,
        machine_declaration: SelfHostMachineLayerDeclaration, request: DriverRung2DirectMirRequest,
        observe_pressure: Bool
    ) -> DriverRung2ExecutionOutcome with caps io_read, io_write {
        return self.direct_mir.execution.EmitDirectMir(mir_json_path,
            output_path, machine_declaration, request, observe_pressure);
    }

    func PublishMirCArtifact(self, mir_json_path: String, output_path: String,
        machine_declaration: SelfHostMachineLayerDeclaration, request: DriverRung2MirCRequest
    ) -> DriverRung2ExecutionOutcome with caps io_read, io_write {
        return self.direct_mir.execution.PublishMirCArtifact(mir_json_path,
            output_path, machine_declaration, request);
    }
    func ProduceSourceMir(self, source_path: String,
        machine_declaration: SelfHostMachineLayerDeclaration, request: DriverSourceMirRequest
    ) -> DriverSourceMirExecutionOutcome with caps io_read {
        return self.source_mir.execution.ProduceSourceMir(source_path,
            machine_declaration, request);
    }

    func PublishSourceMirArtifact(self, source_path: String, output_path: String,
        machine_declaration: SelfHostMachineLayerDeclaration, request: DriverSourceMirRequest
    ) -> DriverSourceMirExecutionOutcome with caps io_read, io_write {
        return self.source_mir.execution.PublishSourceMirArtifact(source_path,
            output_path, machine_declaration, request);
    }

    func PublishSourceCArtifact(self, source_path: String, output_path: String,
        machine_declaration: SelfHostMachineLayerDeclaration
    ) -> DriverSourceCExecutionOutcome with caps io_read, io_write {
        return self.source_c.execution.PublishSourceCArtifact(source_path,
            output_path, machine_declaration);
    }
}

intent IntakeSource(intake: SourceIntakeZone, source: SourceUnit, paths: StagePathManifest) {
    exclusive;

    step ReadRoot {
        where: SourceIntakeZone;
        using: intake;
        who: source;
        on: source.Read(paths);
        expect: true;
    }

    success: true;
    failure: false;
}

intent LexSource(tokens: TokenStreamZone, lexer: LexerStage) {
    exclusive;

    step Scan {
        using: tokens;
        on: lexer.Scan();
        expect: true;
    }

    success: true;
    failure: false;
}

intent ParseTokens(ast: AstTreeZone, parser: ParserStage) {
    exclusive;

    step BuildAst {
        using: ast;
        on: parser.BuildAst();
        expect: true;
    }

    success: true;
    failure: false;
}

intent CheckProgramSemantics(semantic_zone: SemanticVerdictZone, checker: SemanticStage) {
    exclusive;

    step ProveFacts {
        using: semantic_zone;
        who: checker;
        on: checker.Check();
        expect: true;
    }

    success: true;
    failure: false;
}

intent LowerProgramFacts(lower_zone: MirFactGraphZone, lowerer: MirLowerStage) {
    exclusive;

    step BuildMir {
        where: MirFactGraphZone;
        using: lower_zone;
        who: lowerer;
        on: lowerer.Lower();
        expect: true;
    }

    success: true;
    failure: false;
}

intent EmitProgramArtifact(emit_zone: EmissionZone, types: TypeEnvZone, abi_layout: AbiLayoutZone, target_capability: TargetCapabilityZone, emitter: ProgramEmitter) {
    exclusive;

    step EmitC {
        using: emit_zone;
        who: emitter;
        on: emitter.Emit(types, abi_layout, target_capability);
        expect: true;
    }

    success: true;
    failure: false;
}

intent PlanTargetProjection(targets: TargetCapabilityZone, planner: TargetProjectionPlanner) {
    exclusive;

    step OwnEnvelope {
        where: TargetCapabilityZone;
        using: targets;
        who: planner;
        on: planner.Plan();
        expect: true;
    }

    success: true;
    failure: false;
}

intent ProveHardSelfHostEvidence(
    air: AirEvidenceZone,
    compatibility: CompatibilityEvolutionZone,
    symbols: SymbolFactTableZone,
    abi_rows: AbiRowProjectionZone,
    artifacts: ArtifactZone,
    harness: TestHarnessZone,
    subprocess: SubprocessRunnerZone,
    evidence_owner: AirEvidenceOwner,
    compatibility_owner: CompatibilityEvolutionOwner,
    symbol_owner: SymbolTableOwner,
    abi_projector: AbiRowProjector,
    artifact_sink: ArtifactSink,
    harness_runner: TestHarnessRunner,
    subprocess_runner: SubprocessRunner
) {
    exclusive;

    step AirEvidence {
        where: AirEvidenceZone;
        using: air;
        who: evidence_owner;
        on: evidence_owner.Verify();
        expect: true;
    }

    step CompatibilityEvolution {
        where: CompatibilityEvolutionZone;
        using: compatibility;
        who: compatibility_owner;
        on: compatibility_owner.Own();
        expect: true;
    }

    step SymbolFacts {
        where: SymbolFactTableZone;
        using: symbols;
        who: symbol_owner;
        on: symbol_owner.Own();
        expect: true;
    }

    step AbiRows {
        where: AbiRowProjectionZone;
        using: abi_rows;
        who: abi_projector;
        on: abi_projector.Project();
        expect: true;
    }

    step Artifacts {
        where: ArtifactZone;
        using: artifacts;
        who: artifact_sink;
        on: artifact_sink.Collect();
        expect: true;
    }

    step Harness {
        where: TestHarnessZone;
        using: harness;
        who: harness_runner;
        on: harness_runner.Prepare();
        expect: true;
    }

    step Subprocess {
        using: subprocess;
        who: subprocess_runner;
        on: subprocess_runner.Plan();
        expect: true;
    }

    success: true;
    failure: false;
}

intent ProveSelfHostedParity(parity_zone: ParityZone, oracle: OraclePair) {
    exclusive;

    step CompareArtifacts {
        using: parity_zone;
        who: oracle;
        on: oracle.Compare();
        expect: true;
    }

    success: true;
    failure: false;
}

intent CompilePergyraProgram(
    intake: SourceIntakeZone,
    tokens: TokenStreamZone,
    ast: AstTreeZone,
    semantic_zone: SemanticVerdictZone,
    lower_zone: MirFactGraphZone,
    types: TypeEnvZone,
    abi_layout: AbiLayoutZone,
    target_capability_zone: TargetCapabilityZone,
    compatibility_zone: CompatibilityEvolutionZone,
    air_evidence_zone: AirEvidenceZone,
    symbol_zone: SymbolFactTableZone,
    abi_row_zone: AbiRowProjectionZone,
    emit_zone: EmissionZone,
    artifact_zone: ArtifactZone,
    harness_zone: TestHarnessZone,
    subprocess_zone: SubprocessRunnerZone,
    parity_zone: ParityZone,
    source: SourceUnit,
    paths: StagePathManifest,
    lexer: LexerStage,
    parser: ParserStage,
    checker: SemanticStage,
    lowerer: MirLowerStage,
    emitter: ProgramEmitter,
    target_planner: TargetProjectionPlanner,
    compatibility_owner: CompatibilityEvolutionOwner,
    evidence_owner: AirEvidenceOwner,
    symbol_owner: SymbolTableOwner,
    abi_projector: AbiRowProjector,
    artifact_sink: ArtifactSink,
    harness_runner: TestHarnessRunner,
    subprocess_runner: SubprocessRunner,
    oracle: OraclePair
) {
    exclusive;

    step Frontend {
        where: SourceIntakeZone;
        using: intake;
        who: source;
        authorized by: source;
        on: FrontendPipeline(intake, tokens, ast, paths, source, lexer, parser);
        expect: true;
    }

    step MiddleEnd {
        where: SemanticVerdictZone;
        using: semantic_zone;
        who: checker;
        authorized by: checker;
        on: MiddleEndPipeline(semantic_zone, lower_zone, checker, lowerer);
        expect: true;
    }

    step Evidence {
        where: AirEvidenceZone;
        using: air_evidence_zone;
        who: evidence_owner;
        requires: AirEvidenceProving;
        authorized by: evidence_owner;
        on: ProveHardSelfHostEvidence(
            air_evidence_zone, compatibility_zone, symbol_zone, abi_row_zone,
            artifact_zone, harness_zone, subprocess_zone, evidence_owner,
            compatibility_owner, symbol_owner,
            abi_projector, artifact_sink, harness_runner, subprocess_runner);
        expect: true;
    }

    step Backend {
        where: EmissionZone;
        using: emit_zone;
        who: emitter;
        authorized by: emitter;
        on: BackendPipeline(types, abi_layout, target_capability_zone, emit_zone, target_planner, emitter);
        expect: true;
    }

    step SelfProof {
        where: ParityZone;
        using: parity_zone;
        who: oracle;
        authorized by: oracle;
        on: SelfProofPipeline(parity_zone, oracle);
        expect: true;
    }

    success: true;
    failure: false;
}
