import "path_manifest_owner.pgy";
import "target_capability_owner.pgy";
import "air_evidence_owner.pgy";
import "artifact_zone_owner.pgy";
import "test_harness_owner.pgy";
import "subprocess_runner_owner.pgy";
import "abi_layout_row_owner.pgy";
import "symbol_table_owner.pgy";
import "stage_artifact_owner.pgy";

subject SourceUnit {
    let path: String;

    action Read(self, paths: StagePathManifest) -> Bool {
        return CompilerStagePathManifestReady();
    }
}

subject LexerStage {
    let name: String;

    action Scan(self) -> Bool {
        return CompilerTokenStreamFactReady();
    }
}

subject ParserStage {
    let name: String;

    action BuildAst(self) -> Bool {
        return CompilerAstTreeFactReady();
    }
}

subject SemanticStage {
    let name: String;

    action Check(self) -> Bool {
        return CompilerSemanticVerdictFactReady();
    }
}

subject MirLowerStage {
    let name: String;

    action Lower(self) -> Bool {
        return CompilerMirFactGraphReady();
    }
}

subject ProgramEmitter {
    let name: String;

    action Emit(self, types: TypeEnvZone, abi_layout: AbiLayoutZone, target_capability: TargetCapabilityZone) -> Bool {
        return CompilerEmissionFactReady() &&
            CompilerAbiLayoutRowsReady() &&
            CompilerSymbolTableReady() &&
            CompilerTargetCapabilityEnvelopeReady();
    }
}

subject TargetProjectionPlanner {
    let name: String;

    action Plan(self) -> Bool {
        return CompilerTargetCapabilityEnvelopeReady();
    }
}

subject AirEvidenceOwner {
    let name: String;

    action Verify(self) -> Bool { return CompilerAirEvidenceEnvelopeReady(); }
}

subject SymbolTableOwner {
    let name: String;

    action Own(self) -> Bool { return CompilerSymbolTableReady(); }
}

subject AbiRowProjector {
    let name: String;

    action Project(self) -> Bool { return CompilerAbiLayoutRowsReady(); }
}

subject ArtifactSink {
    let name: String;

    action Collect(self) -> Bool { return CompilerArtifactZoneReady(); }
}

subject TestHarnessRunner {
    let name: String;

    action Prepare(self) -> Bool { return CompilerTestHarnessReady(); }
}

subject SubprocessRunner {
    let name: String;

    action Plan(self) -> Bool { return CompilerSubprocessRunnerReady(); }
}

subject OraclePair {
    let c_backend: String;
    let llvm_backend: String;

    action Compare(self) -> Bool {
        return CompilerArtifactZoneReady() && CompilerTestHarnessReady();
    }
}

object SourceBatch { schema: String; }

object StagePathManifest {
    root: String;
    source_dir: String;
    test_dir: String;
    parity_dir: String;
    compiler_world: String;
    lexer: String;
    parser: String;
    semantic: String;
    mir_lower: String;
    codegen: String;
}

object TokenStream { schema: String; }
object AstTree { schema: String; }
object SemanticVerdict { schema: String; }
object MirFactGraph { schema: String; }
object TypeEnvironment { schema: String; }
object AbiLayoutFacts { schema: String; }
object TargetCapabilityEnvelope { schema: String; }
object AirEvidenceFacts { schema: String; }
object SymbolFactTable { schema: String; }
object AbiLayoutRows { schema: String; }
object EmittedC { schema: String; }
object ArtifactEvidence { schema: String; }
object TestHarnessFacts { schema: String; }
object SubprocessCapabilityEnvelope { schema: String; }
tobject ParityVerdict { schema: String; }

import "stage_intents.pgy";
import "authority_owner.pgy";

zone SourceIntakeZone {
    subject slot source: SourceUnit
    object slot paths: StagePathManifest
    object slot imports: SourceBatch
}

zone TokenStreamZone {
    subject slot lexer: LexerStage
    object slot tokens: TokenStream
}

zone AstTreeZone {
    subject slot parser: ParserStage
    object slot ast: AstTree
}

zone SemanticVerdictZone {
    subject slot checker: SemanticStage
    object slot verdict: SemanticVerdict
    authority checker requires FactProving
}

zone MirFactGraphZone {
    subject slot lowerer: MirLowerStage
    object slot mir: MirFactGraph
}

zone TypeEnvZone {
    object slot bindings: TypeEnvironment
}

zone AbiLayoutZone {
    object slot layouts: AbiLayoutFacts
}

zone TargetCapabilityZone {
    subject slot planner: TargetProjectionPlanner
    object slot envelope: TargetCapabilityEnvelope
}

zone AirEvidenceZone {
    subject slot owner: AirEvidenceOwner
    object slot facts: AirEvidenceFacts
}

zone SymbolFactTableZone {
    subject slot owner: SymbolTableOwner
    object slot symbols: SymbolFactTable
}

zone AbiRowProjectionZone {
    subject slot projector: AbiRowProjector
    object slot rows: AbiLayoutRows
}

zone EmissionZone {
    subject slot emitter: ProgramEmitter
    object slot c_output: EmittedC
    authority emitter requires ArtifactEmission
}

zone ArtifactZone {
    subject slot sink: ArtifactSink
    object slot evidence: ArtifactEvidence
}

zone TestHarnessZone {
    subject slot runner: TestHarnessRunner
    object slot facts: TestHarnessFacts
}

zone SubprocessRunnerZone {
    subject slot runner: SubprocessRunner
    object slot envelope: SubprocessCapabilityEnvelope
    authority runner requires SubprocessDiscipline
}

zone ParityZone {
    subject slot oracle: OraclePair
    tobject slot verdict: ParityVerdict
    authority oracle requires ParityJudging
}

zone SelfHostCompiler {
    subject slot source: SourceUnit
    subject slot lexer: LexerStage
    subject slot parser: ParserStage
    subject slot checker: SemanticStage
    subject slot lowerer: MirLowerStage
    subject slot emitter: ProgramEmitter
    subject slot target_planner: TargetProjectionPlanner
    subject slot evidence_owner: AirEvidenceOwner
    subject slot symbol_owner: SymbolTableOwner
    subject slot abi_projector: AbiRowProjector
    subject slot artifact_sink: ArtifactSink
    subject slot harness_runner: TestHarnessRunner
    subject slot subprocess_runner: SubprocessRunner
    subject slot oracle: OraclePair
    object slot paths: StagePathManifest
    object slot source_batch: SourceBatch
    object slot tokens: TokenStream
    object slot ast: AstTree
    object slot semantic: SemanticVerdict
    object slot mir: MirFactGraph
    object slot type_env: TypeEnvironment
    object slot abi_layout: AbiLayoutFacts
    object slot target_capability: TargetCapabilityEnvelope
    object slot air_evidence: AirEvidenceFacts
    object slot symbols: SymbolFactTable
    object slot abi_rows: AbiLayoutRows
    object slot c_output: EmittedC
    object slot artifacts: ArtifactEvidence
    object slot harness: TestHarnessFacts
    object slot subprocess: SubprocessCapabilityEnvelope
    tobject slot parity: ParityVerdict
}

world PgyCompilerWorld {
    zone compiler: SelfHostCompiler
    zone source_intake: SourceIntakeZone
    zone tokens: TokenStreamZone
    zone ast: AstTreeZone
    zone semantic: SemanticVerdictZone
    zone mir: MirFactGraphZone
    zone type_env: TypeEnvZone
    zone abi_layout: AbiLayoutZone
    zone target_capability: TargetCapabilityZone
    zone air_evidence: AirEvidenceZone
    zone symbols: SymbolFactTableZone
    zone abi_rows: AbiRowProjectionZone
    zone emission: EmissionZone
    zone artifacts: ArtifactZone
    zone harness: TestHarnessZone
    zone subprocess: SubprocessRunnerZone
    zone parity: ParityZone
}

intent IntakeSource(intake: SourceIntakeZone, source: SourceUnit, paths: StagePathManifest) {
    exclusive;

    step ReadRoot {
        where: SourceIntakeZone;
        using: intake;
        who: source;
        on: source.Read(paths);
        expect: true;
    }

    success: true;
    failure: false;
}

intent LexSource(tokens: TokenStreamZone, lexer: LexerStage) {
    exclusive;

    step Scan {
        where: TokenStreamZone;
        using: tokens;
        who: lexer;
        on: lexer.Scan();
        expect: true;
    }

    success: true;
    failure: false;
}

intent ParseTokens(ast: AstTreeZone, parser: ParserStage) {
    exclusive;

    step BuildAst {
        where: AstTreeZone;
        using: ast;
        who: parser;
        on: parser.BuildAst();
        expect: true;
    }

    success: true;
    failure: false;
}

intent CheckProgramSemantics(semantic_zone: SemanticVerdictZone, checker: SemanticStage) {
    exclusive;

    step ProveFacts {
        where: SemanticVerdictZone;
        using: semantic_zone;
        who: checker;
        on: checker.Check();
        requires: FactProving;
        authorized by: checker;
        expect: true;
    }

    success: true;
    failure: false;
}

intent LowerProgramFacts(lower_zone: MirFactGraphZone, lowerer: MirLowerStage) {
    exclusive;

    step BuildMir {
        where: MirFactGraphZone;
        using: lower_zone;
        who: lowerer;
        on: lowerer.Lower();
        expect: true;
    }

    success: true;
    failure: false;
}

intent EmitProgramArtifact(emit_zone: EmissionZone, types: TypeEnvZone, abi_layout: AbiLayoutZone, target_capability: TargetCapabilityZone, emitter: ProgramEmitter) {
    exclusive;

    step EmitC {
        where: EmissionZone;
        using: emit_zone;
        who: emitter;
        on: emitter.Emit(types, abi_layout, target_capability);
        requires: ArtifactEmission;
        authorized by: emitter;
        expect: true;
    }

    success: true;
    failure: false;
}

intent PlanTargetProjection(targets: TargetCapabilityZone, planner: TargetProjectionPlanner) {
    exclusive;

    step OwnEnvelope {
        where: TargetCapabilityZone;
        using: targets;
        who: planner;
        on: planner.Plan();
        expect: true;
    }

    success: true;
    failure: false;
}

intent ProveHardSelfHostEvidence(
    air: AirEvidenceZone,
    symbols: SymbolFactTableZone,
    abi_rows: AbiRowProjectionZone,
    artifacts: ArtifactZone,
    harness: TestHarnessZone,
    subprocess: SubprocessRunnerZone,
    evidence_owner: AirEvidenceOwner,
    symbol_owner: SymbolTableOwner,
    abi_projector: AbiRowProjector,
    artifact_sink: ArtifactSink,
    harness_runner: TestHarnessRunner,
    subprocess_runner: SubprocessRunner
) {
    exclusive;

    step AirEvidence {
        where: AirEvidenceZone;
        using: air;
        who: evidence_owner;
        on: evidence_owner.Verify();
        expect: true;
    }

    step SymbolFacts {
        where: SymbolFactTableZone;
        using: symbols;
        who: symbol_owner;
        on: symbol_owner.Own();
        expect: true;
    }

    step AbiRows {
        where: AbiRowProjectionZone;
        using: abi_rows;
        who: abi_projector;
        on: abi_projector.Project();
        expect: true;
    }

    step Artifacts {
        where: ArtifactZone;
        using: artifacts;
        who: artifact_sink;
        on: artifact_sink.Collect();
        expect: true;
    }

    step Harness {
        where: TestHarnessZone;
        using: harness;
        who: harness_runner;
        on: harness_runner.Prepare();
        expect: true;
    }

    step Subprocess {
        where: SubprocessRunnerZone;
        using: subprocess;
        who: subprocess_runner;
        on: subprocess_runner.Plan();
        requires: SubprocessDiscipline;
        authorized by: subprocess_runner;
        expect: true;
    }

    success: true;
    failure: false;
}

intent ProveSelfHostedParity(parity_zone: ParityZone, oracle: OraclePair) {
    exclusive;

    step CompareArtifacts {
        where: ParityZone;
        using: parity_zone;
        who: oracle;
        on: oracle.Compare();
        requires: ParityJudging;
        authorized by: oracle;
        expect: true;
    }

    success: true;
    failure: false;
}

intent CompilePergyraProgram(
    compiler: SelfHostCompiler,
    intake: SourceIntakeZone,
    tokens: TokenStreamZone,
    ast: AstTreeZone,
    semantic_zone: SemanticVerdictZone,
    lower_zone: MirFactGraphZone,
    types: TypeEnvZone,
    abi_layout: AbiLayoutZone,
    target_capability_zone: TargetCapabilityZone,
    air_evidence_zone: AirEvidenceZone,
    symbol_zone: SymbolFactTableZone,
    abi_row_zone: AbiRowProjectionZone,
    emit_zone: EmissionZone,
    artifact_zone: ArtifactZone,
    harness_zone: TestHarnessZone,
    subprocess_zone: SubprocessRunnerZone,
    parity_zone: ParityZone,
    source: SourceUnit,
    paths: StagePathManifest,
    lexer: LexerStage,
    parser: ParserStage,
    checker: SemanticStage,
    lowerer: MirLowerStage,
    emitter: ProgramEmitter,
    target_planner: TargetProjectionPlanner,
    evidence_owner: AirEvidenceOwner,
    symbol_owner: SymbolTableOwner,
    abi_projector: AbiRowProjector,
    artifact_sink: ArtifactSink,
    harness_runner: TestHarnessRunner,
    subprocess_runner: SubprocessRunner,
    oracle: OraclePair
) {
    exclusive;

    step Frontend {
        where: SourceIntakeZone;
        using: intake;
        who: source;
        on: FrontendPipeline(intake, tokens, ast, paths, source, lexer, parser);
        expect: true;
    }

    step MiddleEnd {
        where: SemanticVerdictZone;
        using: semantic_zone;
        who: checker;
        on: MiddleEndPipeline(semantic_zone, lower_zone, checker, lowerer);
        expect: true;
    }

    step Evidence {
        where: AirEvidenceZone;
        using: air_evidence_zone;
        who: evidence_owner;
        on: ProveHardSelfHostEvidence(
            air_evidence_zone, symbol_zone, abi_row_zone, artifact_zone,
            harness_zone, subprocess_zone, evidence_owner, symbol_owner,
            abi_projector, artifact_sink, harness_runner, subprocess_runner);
        expect: true;
    }

    step Backend {
        where: EmissionZone;
        using: emit_zone;
        who: emitter;
        on: BackendPipeline(types, abi_layout, target_capability_zone, emit_zone, target_planner, emitter);
        expect: true;
    }

    step SelfProof {
        where: ParityZone;
        using: parity_zone;
        who: oracle;
        on: SelfProofPipeline(parity_zone, oracle);
        expect: true;
    }

    success: true;
    failure: false;
}
