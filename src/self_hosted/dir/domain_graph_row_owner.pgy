// Canonical self-host DIR graph row carrier and identity mutation owner.
//
// The program inventory owner decides which admitted semantic facts become
// graph rows.  This owner alone assigns DIR-local node indexes, appends exact
// edge rows, and resolves those identities without reopening source text.
import "../mir/declaration_fact_owner.pgy";

struct SelfDirGraphNodeRows {
    kinds: Array<String>;
    names: Array<String>;
    source_syntax_ids: Array<Int>;
    owner_source_syntax_ids: Array<Int>;
    declaration_indices: Array<Int>;
}

struct SelfDirGraphEdgeRows {
    kinds: Array<String>;
    from_node_ids: Array<Int>;
    to_node_ids: Array<Int>;
    labels: Array<String>;
    target_names: Array<String>;
}

struct SelfDirGraphInventoryFacts {
    ok: Bool;
    diagnostic_message: String;
    nodes: SelfDirGraphNodeRows;
    edges: SelfDirGraphEdgeRows;
}

func SelfDirGraphInventoryEmpty() -> SelfDirGraphInventoryFacts {
    let strings0: Array<String> = [];
    let strings1: Array<String> = [];
    let strings2: Array<String> = [];
    let strings3: Array<String> = [];
    let strings4: Array<String> = [];
    let ints0: Array<Int> = [];
    let ints1: Array<Int> = [];
    let ints2: Array<Int> = [];
    let ints3: Array<Int> = [];
    let ints4: Array<Int> = [];
    return SelfDirGraphInventoryFacts(
        true, "",
        SelfDirGraphNodeRows(strings0, strings1, ints0, ints1, ints2),
        SelfDirGraphEdgeRows(strings2, ints3, ints4, strings3, strings4)
    );
}

func SelfDirGraphInventoryError(
    message: String
) -> SelfDirGraphInventoryFacts {
    let facts: SelfDirGraphInventoryFacts = SelfDirGraphInventoryEmpty();
    facts.ok = false;
    facts.diagnostic_message = message;
    return facts;
}

func SelfDirGraphInventoryAppendNode(
    inout facts: SelfDirGraphInventoryFacts,
    kind: String,
    name: String,
    source_syntax_id: Int,
    owner_source_syntax_id: Int,
    declaration_index: Int
) -> Int {
    if kind == "" || name == "" || source_syntax_id <= 0 ||
        owner_source_syntax_id < 0 {
        return 0 - 1;
    }
    let kinds: Array<String> = facts.nodes.kinds;
    let names: Array<String> = facts.nodes.names;
    let source_syntax_ids: Array<Int> = facts.nodes.source_syntax_ids;
    let owner_source_syntax_ids: Array<Int> =
        facts.nodes.owner_source_syntax_ids;
    let declaration_indices: Array<Int> = facts.nodes.declaration_indices;
    let i: Int = 0;
    while i < ArrayLength(kinds) {
        if kinds[i] == kind && names[i] == name {
            return 0 - 1;
        }
        i = i + 1;
    }
    let node_id: Int = ArrayLength(kinds);
    ArrayPush(kinds, kind);
    ArrayPush(names, name);
    ArrayPush(source_syntax_ids, source_syntax_id);
    ArrayPush(owner_source_syntax_ids, owner_source_syntax_id);
    ArrayPush(declaration_indices, declaration_index);
    let nodes: SelfDirGraphNodeRows = SelfDirGraphNodeRows(
        kinds, names, source_syntax_ids, owner_source_syntax_ids,
        declaration_indices
    );
    facts = SelfDirGraphInventoryFacts(
        facts.ok, facts.diagnostic_message, nodes, facts.edges
    );
    return node_id;
}

func SelfDirGraphInventoryAppendEdge(
    inout facts: SelfDirGraphInventoryFacts,
    kind: String,
    from_node_id: Int,
    to_node_id: Int,
    label: String,
    target_name: String
) -> Bool {
    if kind == "" || from_node_id < 0 ||
        from_node_id >= ArrayLength(facts.nodes.kinds) || to_node_id < -1 ||
        to_node_id >= ArrayLength(facts.nodes.kinds) {
        return false;
    }
    let kinds: Array<String> = facts.edges.kinds;
    let from_node_ids: Array<Int> = facts.edges.from_node_ids;
    let to_node_ids: Array<Int> = facts.edges.to_node_ids;
    let labels: Array<String> = facts.edges.labels;
    let target_names: Array<String> = facts.edges.target_names;
    ArrayPush(kinds, kind);
    ArrayPush(from_node_ids, from_node_id);
    ArrayPush(to_node_ids, to_node_id);
    ArrayPush(labels, label);
    ArrayPush(target_names, target_name);
    let edges: SelfDirGraphEdgeRows = SelfDirGraphEdgeRows(
        kinds, from_node_ids, to_node_ids, labels, target_names
    );
    facts = SelfDirGraphInventoryFacts(
        facts.ok, facts.diagnostic_message, facts.nodes, edges
    );
    return true;
}

func SelfDirGraphInventoryNodeIndex(
    facts: SelfDirGraphInventoryFacts,
    kind: String,
    name: String
) -> Int {
    let i: Int = 0;
    while i < ArrayLength(facts.nodes.kinds) {
        if facts.nodes.kinds[i] == kind && facts.nodes.names[i] == name {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

func SelfDirGraphInventoryDomainOwnerNodeIndex(
    facts: SelfDirGraphInventoryFacts,
    name: String
) -> Int {
    let node_id: Int = SelfDirGraphInventoryNodeIndex(facts, "zone", name);
    if node_id >= 0 { return node_id; }
    node_id = SelfDirGraphInventoryNodeIndex(facts, "relation", name);
    if node_id >= 0 { return node_id; }
    return SelfDirGraphInventoryNodeIndex(facts, "effect", name);
}

func SelfDirGraphInventoryDeclarationKind(
    rows: SelfMirDeclarationRows,
    declaration_index: Int
) -> String {
    if rows.kinds[declaration_index] == "ability" { return "ability"; }
    if rows.kinds[declaration_index] == "role" { return "role"; }
    if rows.nominal_kinds[declaration_index] == "party" { return "party"; }
    if rows.nominal_kinds[declaration_index] == "roster" { return "roster"; }
    if rows.nominal_kinds[declaration_index] == "world" { return "world"; }
    if rows.nominal_kinds[declaration_index] == "relation" { return "relation"; }
    if rows.nominal_kinds[declaration_index] == "effect" { return "effect"; }
    if rows.nominal_kinds[declaration_index] == "zone" { return "zone"; }
    if rows.nominal_kinds[declaration_index] == "extern" { return ""; }
    return "type";
}

func SelfDirGraphInventoryQualifiedName(
    owner_name: String,
    slot_name: String
) -> String {
    return Concat(owner_name, Concat(".", slot_name));
}
