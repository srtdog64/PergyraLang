// Typed self-host DIR intent participant and step graph owner.
// The step resolver consumes semantic action contracts; this owner assembles
// exact intent ranges and validates the resulting edge census locally.

import "../hir/ast_text_arena_projection_owner.pgy";
import "../semantic/ast_intent_signature_fact_owner.pgy";
import "../semantic/ast_intent_transition_fact_owner.pgy";
import "../semantic/ast_expression_surface_fact_owner.pgy";
import "../semantic/ast_signature_fact_owner.pgy";
import "../mir/declaration_fact_owner.pgy";
import "domain_topology_row_owner.pgy";
import "intent_row_owner.pgy";
import "intent_step_fact_owner.pgy";
import "intent_step_carriage_contract_owner.pgy";
import "intent_step_target_contract_owner.pgy";
import "intent_outcome_contract_owner.pgy";
import "intent_result_contract_owner.pgy";

func SelfDirIntentDirectChildAllowed(kind: Int) -> Bool {
    return kind == TypedAstKindIntentModeTag() ||
        kind == TypedAstKindIntentRollbackTag() ||
        kind == TypedAstKindIntentRetryTag() ||
        kind == TypedAstKindIntentInvolvesTag() ||
        kind == TypedAstKindIntentValueTag() ||
        kind == TypedAstKindIntentStepTag() ||
        kind == TypedAstKindIntentSuccessTag() ||
        kind == TypedAstKindIntentFailureTag() ||
        kind == TypedAstKindIntentReturnsTag() ||
        kind == TypedAstKindIntentTerminalSuccessTag() ||
        kind == TypedAstKindIntentTerminalFailureTag();
}

func SelfDirIntentFactsFromArtifact(
    artifact: AstTreeArtifact,
    rows: SelfMirDeclarationRows,
    signatures: SemanticAstFunctionSignatureFacts,
    ref signature_facts: SemanticAstIntentSignatureFacts,
    transition_facts: SemanticAstIntentTransitionFacts,
    ref expression_surfaces: SemanticAstExpressionSurfaceFacts
) -> SelfDirIntentFacts {
    let required: Bool = SemanticAstIntentSignatureCount(signature_facts) > 0;
    if !required {
        return SelfDirIntentFactsEmpty(false, true, "", artifact.count);
    }
    if !AstTreeArtifactReady(artifact) || !signatures.ok ||
        !SemanticAstActionContractFactsReady(
            artifact, signatures.action_contracts
        ) || !SemanticAstIntentSignatureFactsReady(artifact, signature_facts) ||
        !SemanticAstExpressionSurfaceBorrowReady(
            artifact, expression_surfaces
        ) {
        return SelfDirIntentFactsError(
            "self-host DIR intent inputs are incomplete", artifact.count
        );
    }
    if !SemanticAstIntentTransitionFactsReady(artifact, transition_facts) {
        return SelfDirIntentFactsError(
            transition_facts.diagnostic_message, artifact.count
        );
    }

    let intent_node_ids: Array<Int> = [];
    let intent_names: Array<String> = [];
    let intent_result_modes: Array<String> = [];
    let intent_return_type_names: Array<String> = [];
    let participant_starts: Array<Int> = [];
    let participant_counts: Array<Int> = [];
    let participant_node_ids: Array<Int> = [];
    let participant_is_values: Array<Bool> = [];
    let participant_aliases: Array<String> = [];
    let participant_type_names: Array<String> = [];
    let participant_declaration_indices: Array<Int> = [];
    let step_starts: Array<Int> = [];
    let step_counts: Array<Int> = [];
    let step_node_ids: Array<Int> = [];
    let step_names: Array<String> = [];
    let step_where_zone_names: Array<String> = [];
    let step_where_declaration_indices: Array<Int> = [];
    let step_using_aliases: Array<String> = [];
    let step_receiver_aliases: Array<String> = [];
    let step_action_names: Array<String> = [];
    let step_action_signature_indices: Array<Int> = [];
    let step_target_kinds: Array<String> = [];
    let step_target_declaration_node_ids: Array<Int> = [];
    let step_target_indices: Array<Int> = [];
    let step_target_names: Array<String> = [];
    let step_target_return_type_names: Array<String> = [];
    let step_target_param_counts: Array<Int> = [];
    let step_outcome_node_ids: Array<Int> = [];
    let step_outcome_names: Array<String> = [];
    let step_outcome_type_names: Array<String> = [];
    let step_on_node_ids: Array<Int> = [];
    let step_guard_node_ids: Array<Int> = [];
    let step_post_node_ids: Array<Int> = [];
    let step_expect_node_ids: Array<Int> = [];
    let step_compensate_starts: Array<Int> = [];
    let step_compensate_counts: Array<Int> = [];
    let step_compensate_node_ids: Array<Int> = [];
    let step_child_counts: Array<Int> = [];
    let step_predecessor_indices: Array<Int> = [];
    let step_causes_names: Array<String> = [];
    let step_causes_declaration_indices: Array<Int> = [];
    let who_starts: Array<Int> = [];
    let who_counts: Array<Int> = [];
    let who_names: Array<String> = [];
    let requires_starts: Array<Int> = [];
    let requires_counts: Array<Int> = [];
    let requires_names: Array<String> = [];
    let requires_declaration_indices: Array<Int> = [];
    let authorized_starts: Array<Int> = [];
    let authorized_counts: Array<Int> = [];
    let authorized_names: Array<String> = [];
    let edge_count: Int = 0;

    let intent_index: Int = 0;
    while intent_index < SemanticAstIntentSignatureCount(signature_facts) {
        let intent_node_id: Int = signature_facts.intent_node_ids[intent_index];
        let participant_start: Int = ArrayLength(participant_node_ids);
        let source_start: Int = signature_facts.param_starts[intent_index];
        let p: Int = 0;
        while p < signature_facts.param_counts[intent_index] {
            let source_row: Int = source_start + p;
            let type_name: String = signature_facts.param_types[source_row];
            let is_value: Bool = signature_facts.param_is_values[source_row];
            let declaration_index: Int = SelfDirDeclarationIndexForName(
                rows, type_name
            );
            if !is_value && declaration_index < 0 {
                return SelfDirIntentFactsError(
                    "self-host DIR intent participant type is unresolved",
                    artifact.count
                );
            }
            ArrayPush(participant_node_ids,
                signature_facts.param_node_ids[source_row]);
            ArrayPush(participant_is_values, is_value);
            ArrayPush(participant_aliases,
                signature_facts.param_names[source_row]);
            ArrayPush(participant_type_names, type_name);
            ArrayPush(participant_declaration_indices, declaration_index);
            edge_count = edge_count + 1;
            p = p + 1;
        }
        let participant_count: Int =
            ArrayLength(participant_node_ids) - participant_start;
        let step_start: Int = ArrayLength(step_node_ids);
        let child_index: Int = 0;
        let child: Option<Int> = TypedAstArenaChildAt(
            artifact.arena, intent_node_id, child_index
        );
        while IsSome(child) {
            let child_id: Int = UnwrapOption(child);
            let kind_opt: Option<Int> = TypedAstArenaNodeKind(
                artifact.arena, child_id
            );
            if !IsSome(kind_opt) ||
                !SelfDirIntentDirectChildAllowed(UnwrapOption(kind_opt)) {
                return SelfDirIntentFactsError(
                    "self-host DIR intent child row kind is unsupported",
                    artifact.count
                );
            }
            if UnwrapOption(kind_opt) == TypedAstKindIntentStepTag() {
                let local_step_index: Int =
                    ArrayLength(step_node_ids) - step_start;
                let resolved: SelfDirIntentResolvedStep =
                    SelfDirIntentStepFromArtifact(
                        artifact, rows, signatures, signature_facts,
                        expression_surfaces, child_id,
                        participant_aliases, participant_type_names,
                        participant_is_values, participant_start,
                        participant_count, local_step_index,
                        signature_facts.result_modes[intent_index] ==
                            "typed_enum"
                    );
                if !resolved.ok {
                    return SelfDirIntentFactsError(
                        resolved.diagnostic_message, artifact.count
                    );
                }
                let who_start: Int = ArrayLength(who_names);
                let i: Int = 0;
                while i < ArrayLength(resolved.who_names) {
                    ArrayPush(who_names, resolved.who_names[i]);
                    i = i + 1;
                }
                let requires_start: Int = ArrayLength(requires_names);
                i = 0;
                while i < ArrayLength(resolved.requires_names) {
                    ArrayPush(requires_names, resolved.requires_names[i]);
                    ArrayPush(requires_declaration_indices,
                        resolved.requires_declaration_indices[i]);
                    i = i + 1;
                }
                let authorized_start: Int = ArrayLength(authorized_names);
                i = 0;
                while i < ArrayLength(resolved.authorized_names) {
                    ArrayPush(authorized_names, resolved.authorized_names[i]);
                    i = i + 1;
                }
                let compensate_start: Int =
                    ArrayLength(step_compensate_node_ids);
                i = 0;
                while i < ArrayLength(resolved.compensate_node_ids) {
                    ArrayPush(step_compensate_node_ids,
                        resolved.compensate_node_ids[i]);
                    i = i + 1;
                }
                ArrayPush(step_node_ids, resolved.node_id);
                ArrayPush(step_names, resolved.name);
                ArrayPush(step_where_zone_names, resolved.where_zone_name);
                ArrayPush(step_where_declaration_indices,
                    resolved.where_declaration_index);
                ArrayPush(step_using_aliases, resolved.using_alias);
                ArrayPush(step_receiver_aliases, resolved.receiver_alias);
                ArrayPush(step_action_names, resolved.action_name);
                ArrayPush(step_action_signature_indices,
                    resolved.action_signature_index);
                ArrayPush(step_target_kinds, resolved.target_kind);
                ArrayPush(
                    step_target_declaration_node_ids,
                    resolved.target_declaration_node_id
                );
                ArrayPush(step_target_indices, resolved.target_index);
                ArrayPush(step_target_names, resolved.target_name);
                ArrayPush(
                    step_target_return_type_names,
                    resolved.target_return_type_name
                );
                ArrayPush(
                    step_target_param_counts, resolved.target_param_count
                );
                ArrayPush(step_outcome_node_ids, resolved.outcome_node_id);
                ArrayPush(step_outcome_names, resolved.outcome_name);
                ArrayPush(step_outcome_type_names,
                    resolved.outcome_type_name);
                ArrayPush(step_on_node_ids, resolved.on_node_id);
                ArrayPush(step_guard_node_ids, resolved.guard_node_id);
                ArrayPush(step_post_node_ids, resolved.post_node_id);
                ArrayPush(step_expect_node_ids, resolved.expect_node_id);
                ArrayPush(step_compensate_starts, compensate_start);
                ArrayPush(step_compensate_counts,
                    ArrayLength(resolved.compensate_node_ids));
                ArrayPush(step_child_counts, resolved.child_count);
                ArrayPush(step_predecessor_indices,
                    resolved.predecessor_step_index);
                ArrayPush(step_causes_names, resolved.causes_name);
                ArrayPush(step_causes_declaration_indices,
                    resolved.causes_declaration_index);
                ArrayPush(who_starts, who_start);
                ArrayPush(who_counts, ArrayLength(resolved.who_names));
                ArrayPush(requires_starts, requires_start);
                ArrayPush(requires_counts,
                    ArrayLength(resolved.requires_names));
                ArrayPush(authorized_starts, authorized_start);
                ArrayPush(authorized_counts,
                    ArrayLength(resolved.authorized_names));
                edge_count = edge_count + resolved.edge_count;
                let transition_row: Int = ArrayLength(step_node_ids) - 1;
                if transition_facts.step_requireds[transition_row] &&
                    transition_facts.predecessor_step_indices[transition_row] >= 0 {
                    edge_count = edge_count + 1;
                }
            }
            child_index = child_index + 1;
            child = TypedAstArenaChildAt(
                artifact.arena, intent_node_id, child_index
            );
        }
        ArrayPush(intent_node_ids, intent_node_id);
        ArrayPush(intent_names, signature_facts.names[intent_index]);
        ArrayPush(
            intent_result_modes, signature_facts.result_modes[intent_index]
        );
        ArrayPush(
            intent_return_type_names,
            signature_facts.return_type_names[intent_index]
        );
        ArrayPush(participant_starts, participant_start);
        ArrayPush(participant_counts, participant_count);
        ArrayPush(step_starts, step_start);
        ArrayPush(step_counts, ArrayLength(step_node_ids) - step_start);
        intent_index = intent_index + 1;
    }

    return SelfDirIntentFacts(
        true, true, "", artifact.count,
        intent_node_ids, intent_names, intent_result_modes,
        intent_return_type_names, participant_starts, participant_counts,
        SelfDirIntentParticipantFacts(
            participant_node_ids, participant_is_values, participant_aliases,
            participant_type_names, participant_declaration_indices
        ),
        step_starts, step_counts,
        SelfDirIntentStepFacts(
            step_node_ids, step_names, step_where_zone_names,
            step_where_declaration_indices, step_using_aliases,
            step_receiver_aliases, step_action_names,
            step_action_signature_indices, step_target_kinds,
            step_target_declaration_node_ids, step_target_indices,
            step_target_names, step_target_return_type_names,
            step_target_param_counts, step_outcome_node_ids,
            step_outcome_names, step_outcome_type_names, step_on_node_ids,
            step_guard_node_ids, step_post_node_ids, step_expect_node_ids,
            step_compensate_starts, step_compensate_counts,
            step_compensate_node_ids, step_child_counts,
            step_predecessor_indices, step_causes_names,
            step_causes_declaration_indices, who_starts, who_counts, who_names,
            requires_starts, requires_counts, requires_names,
            requires_declaration_indices, authorized_starts, authorized_counts,
            authorized_names
        ),
        transition_facts,
        edge_count
    );
}

func SelfDirIntentFactsReady(
    artifact: AstTreeArtifact,
    rows: SelfMirDeclarationRows,
    signatures: SemanticAstFunctionSignatureFacts,
    ref intent_signatures: SemanticAstIntentSignatureFacts,
    facts: SelfDirIntentFacts
) -> Bool {
    if !facts.ok || !signatures.ok || facts.diagnostic_message != "" ||
        facts.artifact_node_count != artifact.count ||
        !SelfDirIntentFactsShapeReady(facts) ||
        !SelfDirIntentStepCarriageReady(artifact, facts.steps) ||
        !SemanticAstIntentTransitionFactsReady(artifact, facts.transitions) ||
        !SemanticAstIntentSignatureFactsReady(
            artifact, intent_signatures
        ) {
        return false;
    }
    let intent_count: Int = ArrayLength(facts.intent_node_ids);
    let participant_count: Int = ArrayLength(facts.participants.node_ids);
    let step_count: Int = ArrayLength(facts.steps.node_ids);
    if !facts.required {
        return intent_count == 0 && participant_count == 0 && step_count == 0 &&
            facts.edge_count == 0;
    }
    let expected_participant_start: Int = 0;
    let expected_step_start: Int = 0;
    let expected_who_start: Int = 0;
    let expected_requires_start: Int = 0;
    let expected_authorized_start: Int = 0;
    let expected_edges: Int = 0;
    let intent_i: Int = 0;
    while intent_i < intent_count {
        let p_start: Int = facts.participant_starts[intent_i];
        let p_count: Int = facts.participant_counts[intent_i];
        let s_start: Int = facts.step_starts[intent_i];
        let s_count: Int = facts.step_counts[intent_i];
        if facts.intent_node_ids[intent_i] < 0 ||
            facts.names[intent_i] == "" ||
            !SelfDirIntentResultContractReady(facts, intent_i) ||
            !TypedAstArenaNodeKindIs(
                artifact.arena, facts.intent_node_ids[intent_i],
                TypedAstKindIntentDeclTag()
            ) || p_start != expected_participant_start ||
            s_start != expected_step_start || p_count < 0 || s_count < 0 {
            return false;
        }
        let local_step: Int = 0;
        while local_step < s_count {
            let step_row: Int = s_start + local_step;
            let expected_predecessor: Int = -1;
            if !facts.transitions.step_requireds[step_row] && local_step > 0 {
                expected_predecessor = local_step - 1;
            }
            let who_start: Int = facts.steps.who_starts[step_row];
            let who_count: Int = facts.steps.who_counts[step_row];
            let requires_start: Int = facts.steps.requires_starts[step_row];
            let requires_count: Int = facts.steps.requires_counts[step_row];
            let authorized_start: Int =
                facts.steps.authorized_starts[step_row];
            let authorized_count: Int =
                facts.steps.authorized_counts[step_row];
            if facts.steps.predecessor_step_indices[step_row] !=
                    expected_predecessor ||
                who_start != expected_who_start || who_count < 0 ||
                (facts.steps.target_kinds[step_row] == "action" &&
                 who_count == 0) ||
                who_start + who_count > ArrayLength(facts.steps.who_names) ||
                requires_start != expected_requires_start ||
                requires_count < 0 ||
                requires_start + requires_count >
                    ArrayLength(facts.steps.requires_names) ||
                authorized_start != expected_authorized_start ||
                authorized_count < 0 ||
                authorized_start + authorized_count >
                    ArrayLength(facts.steps.authorized_names) {
                return false;
            }
            let using_row: Int = SelfDirIntentParticipantIndex(
                facts.participants.aliases, p_start, p_count,
                facts.steps.using_aliases[step_row]
            );
            if using_row < 0 || facts.participants.is_values[using_row] ||
                facts.participants.type_names[using_row] !=
                    facts.steps.where_zone_names[step_row] {
                return false;
            }
            if facts.steps.target_kinds[step_row] == "action" {
                let receiver_row: Int = SelfDirIntentParticipantIndex(
                    facts.participants.aliases, p_start, p_count,
                    facts.steps.receiver_aliases[step_row]
                );
                if receiver_row < 0 ||
                    facts.participants.is_values[receiver_row] {
                    return false;
                }
            } else if facts.steps.target_kinds[step_row] == "intent" {
                if facts.steps.receiver_aliases[step_row] != "" {
                    return false;
                }
            } else {
                return false;
            }
            let name_i: Int = 0;
            while name_i < who_count {
                let participant_row: Int = SelfDirIntentParticipantIndex(
                    facts.participants.aliases, p_start, p_count,
                    facts.steps.who_names[who_start + name_i]
                );
                if participant_row < 0 ||
                    facts.participants.is_values[participant_row] {
                    return false;
                }
                name_i = name_i + 1;
            }
            name_i = 0;
            while name_i < authorized_count {
                let participant_row: Int = SelfDirIntentParticipantIndex(
                    facts.participants.aliases, p_start, p_count,
                    facts.steps.authorized_names[authorized_start + name_i]
                );
                if participant_row < 0 ||
                    facts.participants.is_values[participant_row] {
                    return false;
                }
                name_i = name_i + 1;
            }
            expected_who_start = expected_who_start + who_count;
            expected_requires_start = expected_requires_start + requires_count;
            expected_authorized_start =
                expected_authorized_start + authorized_count;
            local_step = local_step + 1;
        }
        expected_participant_start = expected_participant_start + p_count;
        expected_step_start = expected_step_start + s_count;
        intent_i = intent_i + 1;
    }
    if expected_participant_start != participant_count ||
        expected_step_start != step_count ||
        expected_who_start != ArrayLength(facts.steps.who_names) ||
        expected_requires_start != ArrayLength(facts.steps.requires_names) ||
        expected_authorized_start != ArrayLength(facts.steps.authorized_names) {
        return false;
    }
    let i: Int = 0;
    while i < participant_count {
        let expected_kind: Int = TypedAstKindIntentInvolvesTag();
        if facts.participants.is_values[i] {
            expected_kind = TypedAstKindIntentValueTag();
        }
        if !TypedAstArenaNodeKindIs(
                artifact.arena, facts.participants.node_ids[i], expected_kind
            ) || facts.participants.aliases[i] == "" ||
            facts.participants.type_names[i] == "" ||
            (!facts.participants.is_values[i] &&
             (facts.participants.declaration_indices[i] < 0 ||
              facts.participants.declaration_indices[i] >= ArrayLength(rows.names) ||
              rows.names[facts.participants.declaration_indices[i]] !=
                facts.participants.type_names[i])) {
            return false;
        }
        expected_edges = expected_edges + 1;
        i = i + 1;
    }
    i = 0;
    while i < step_count {
        if facts.transitions.step_node_ids[i] != facts.steps.node_ids[i] ||
            facts.steps.where_zone_names[i] == "" ||
            facts.steps.where_declaration_indices[i] < 0 ||
            facts.steps.where_declaration_indices[i] >= ArrayLength(rows.names) ||
            rows.nominal_kinds[facts.steps.where_declaration_indices[i]] != "zone" ||
            rows.names[facts.steps.where_declaration_indices[i]] !=
                facts.steps.where_zone_names[i] ||
            facts.steps.using_aliases[i] == "" ||
            facts.steps.who_starts[i] < 0 || facts.steps.who_counts[i] < 0 ||
            facts.steps.who_starts[i] + facts.steps.who_counts[i] >
                ArrayLength(facts.steps.who_names) ||
            facts.steps.requires_starts[i] < 0 ||
            facts.steps.requires_counts[i] < 0 ||
            facts.steps.requires_starts[i] + facts.steps.requires_counts[i] >
                ArrayLength(facts.steps.requires_names) ||
            facts.steps.authorized_starts[i] < 0 ||
            facts.steps.authorized_counts[i] < 0 ||
            facts.steps.authorized_starts[i] + facts.steps.authorized_counts[i] >
                ArrayLength(facts.steps.authorized_names) {
            return false;
        }
        if !SelfDirIntentStepTargetContractReady(
            signatures, intent_signatures, facts.steps, i
        ) {
            return false;
        }
        if !SelfDirIntentStepOutcomeContractReady(
            artifact, signatures, intent_signatures, facts.participants,
            facts.participant_starts, facts.participant_counts,
            facts.step_starts, facts.step_counts, facts.steps, i
        ) {
            return false;
        }
        let requirement_i: Int = 0;
        while requirement_i < facts.steps.requires_counts[i] {
            let requirement_row: Int =
                facts.steps.requires_starts[i] + requirement_i;
            let declaration_index: Int =
                facts.steps.requires_declaration_indices[requirement_row];
            if declaration_index < 0 ||
                declaration_index >= ArrayLength(rows.names) ||
                rows.kinds[declaration_index] != "ability" ||
                rows.names[declaration_index] !=
                    facts.steps.requires_names[requirement_row] {
                return false;
            }
            requirement_i = requirement_i + 1;
        }
        expected_edges = expected_edges + 1 + facts.steps.who_counts[i] +
            facts.steps.requires_counts[i] + facts.steps.authorized_counts[i];
        if facts.steps.causes_names[i] != "" {
            let cause_index: Int = facts.steps.causes_declaration_indices[i];
            if cause_index < 0 || cause_index >= ArrayLength(rows.names) ||
                rows.nominal_kinds[cause_index] != "effect" ||
                rows.names[cause_index] != facts.steps.causes_names[i] {
                return false;
            }
            expected_edges = expected_edges + 1;
        }
        if facts.steps.predecessor_step_indices[i] >= 0 {
            expected_edges = expected_edges + 1;
        }
        if facts.transitions.step_requireds[i] &&
            facts.transitions.predecessor_step_indices[i] >= 0 {
            expected_edges = expected_edges + 1;
        }
        i = i + 1;
    }
    return expected_edges == facts.edge_count;
}

func SelfDirIntentCount(facts: SelfDirIntentFacts) -> Int {
    return ArrayLength(facts.intent_node_ids);
}
