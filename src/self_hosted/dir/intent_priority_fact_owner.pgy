// Admitted intent-priority identity for self-host DIR.
// The parser owns the expression graph. This owner validates one direct
// priority child per intent and carries its typed graph root without
// reparsing source text or inventing a default expression.

import "../hir/ast_text_arena_projection_owner.pgy";
import "../semantic/ast_expression_graph_scalar_type_owner.pgy";
import "../semantic/ast_expression_graph_view_owner.pgy";
import "../semantic/ast_expression_function_table_fact_owner.pgy";
import "../semantic/ast_intent_parameter_environment_owner.pgy";
import "../semantic/ast_intent_signature_fact_owner.pgy";
import "../semantic/ast_nominal_constructor_fact_owner.pgy";

struct SelfDirIntentPriorityFact {
    ok: Bool;
    diagnostic_message: String;
    node_id: Int;
    expression_root_id: Int;
}

struct SelfDirIntentPriorityFacts {
    ok: Bool;
    diagnostic_message: String;
    artifact_node_count: Int;
    node_ids: Array<Int>;
    expression_root_ids: Array<Int>;
}

func SelfDirIntentPriorityFactsEmpty(
    artifact_node_count: Int
) -> SelfDirIntentPriorityFacts {
    let node_ids: Array<Int> = [];
    let expression_root_ids: Array<Int> = [];
    return SelfDirIntentPriorityFacts(
        true, "", artifact_node_count, node_ids, expression_root_ids
    );
}

func SelfDirIntentPriorityFactsError(
    message: String, artifact_node_count: Int
) -> SelfDirIntentPriorityFacts {
    let facts: SelfDirIntentPriorityFacts =
        SelfDirIntentPriorityFactsEmpty(artifact_node_count);
    facts.ok = false;
    facts.diagnostic_message = message;
    return facts;
}

func SelfDirIntentPriorityFactAbsent() -> SelfDirIntentPriorityFact {
    return SelfDirIntentPriorityFact(true, "", -1, -1);
}

func SelfDirIntentPriorityFactError(
    message: String
) -> SelfDirIntentPriorityFact {
    return SelfDirIntentPriorityFact(false, message, -1, -1);
}

func SelfDirIntentPriorityFactFromAdmittedFacts(
    artifact: AstTreeArtifact,
    ref intent_signatures: SemanticAstIntentSignatureFacts,
    ref expression_surfaces: SemanticAstExpressionSurfaceFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    function_tables: SemanticAstExpressionFunctionTableFacts,
    intent_node_id: Int
) -> SelfDirIntentPriorityFact {
    let priority_node_id: Int = -1;
    let priority_count: Int = 0;
    let child_index: Int = 0;
    let child: Option<Int> = TypedAstArenaChildAt(
        artifact.arena, intent_node_id, child_index
    );
    while IsSome(child) {
        let child_id: Int = UnwrapOption(child);
        if TypedAstArenaNodeKindIs(
            artifact.arena, child_id, TypedAstKindIntentPriorityTag()
        ) {
            priority_count = priority_count + 1;
            priority_node_id = child_id;
        }
        child_index = child_index + 1;
        child = TypedAstArenaChildAt(
            artifact.arena, intent_node_id, child_index
        );
    }
    if priority_count == 0 { return SelfDirIntentPriorityFactAbsent(); }
    if priority_count != 1 {
        return SelfDirIntentPriorityFactError(
            "self-host DIR intent priority must have one owner row"
        );
    }
    let root: Option<Int> = SemanticAstExpressionGraphRootForNode(
        expression_surfaces, priority_node_id, AstExpressionLaneAtom()
    );
    if !IsSome(root) {
        return SelfDirIntentPriorityFactError(
            "self-host DIR intent priority expression graph is missing"
        );
    }
    let names: Array<String> = [];
    let types: Array<String> = [];
    let modes: Array<String> = [];
    if !SemanticAstIntentExpressionSeedParameters(
            intent_signatures, intent_node_id, names, types, modes
        ) || ArrayLength(names) != ArrayLength(modes) {
        return SelfDirIntentPriorityFactError(
            "self-host DIR intent priority environment is incomplete"
        );
    }
    let type_name: String = SemanticExpressionGraphScalarTypeName(
        expression_surfaces.expression_graph, UnwrapOption(root),
        constructors, names, types, function_tables.names,
        function_tables.returns
    );
    if type_name != "Int" {
        return SelfDirIntentPriorityFactError(
            "self-host DIR intent priority expression must be Int"
        );
    }
    return SelfDirIntentPriorityFact(
        true, "", priority_node_id, UnwrapOption(root)
    );
}

func SelfDirIntentPriorityRowReady(
    artifact: AstTreeArtifact,
    ref expression_surfaces: SemanticAstExpressionSurfaceFacts,
    intent_node_id: Int,
    node_id: Int,
    expression_root_id: Int
) -> Bool {
    if node_id < 0 {
        return node_id == -1 && expression_root_id == -1;
    }
    let parent: Option<Int> = TypedAstArenaParentId(
        artifact.arena, node_id
    );
    let root: Option<Int> = SemanticAstExpressionGraphRootForNode(
        expression_surfaces, node_id, AstExpressionLaneAtom()
    );
    return IsSome(parent) && UnwrapOption(parent) == intent_node_id &&
        TypedAstArenaNodeKindIs(
            artifact.arena, node_id, TypedAstKindIntentPriorityTag()
        ) && IsSome(root) && UnwrapOption(root) == expression_root_id;
}

func SelfDirIntentPriorityFactsFromArtifact(
    artifact: AstTreeArtifact,
    ref intent_signatures: SemanticAstIntentSignatureFacts,
    ref expression_surfaces: SemanticAstExpressionSurfaceFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    function_tables: SemanticAstExpressionFunctionTableFacts
) -> SelfDirIntentPriorityFacts {
    if !SemanticAstIntentSignatureFactsReady(
            artifact, intent_signatures
        ) || !SemanticAstExpressionSurfaceBorrowReady(
            artifact, expression_surfaces
        ) || !constructors.ok ||
        constructors.artifact_node_count != artifact.count ||
        !SemanticAstExpressionFunctionTableFactsReady(function_tables) {
        return SelfDirIntentPriorityFactsError(
            "self-host DIR intent priority inputs are incomplete",
            artifact.count
        );
    }
    let node_ids: Array<Int> = [];
    let expression_root_ids: Array<Int> = [];
    let i: Int = 0;
    while i < SemanticAstIntentSignatureCount(intent_signatures) {
        let row: SelfDirIntentPriorityFact =
            SelfDirIntentPriorityFactFromAdmittedFacts(
                artifact, intent_signatures, expression_surfaces,
                constructors, function_tables,
                intent_signatures.intent_node_ids[i]
            );
        if !row.ok {
            return SelfDirIntentPriorityFactsError(
                row.diagnostic_message, artifact.count
            );
        }
        ArrayPush(node_ids, row.node_id);
        ArrayPush(expression_root_ids, row.expression_root_id);
        i = i + 1;
    }
    return SelfDirIntentPriorityFacts(
        true, "", artifact.count, node_ids, expression_root_ids
    );
}

func SelfDirIntentPriorityFactsReady(
    artifact: AstTreeArtifact,
    ref expression_surfaces: SemanticAstExpressionSurfaceFacts,
    intent_node_ids: Array<Int>,
    ref facts: SelfDirIntentPriorityFacts
) -> Bool {
    if !facts.ok || facts.diagnostic_message != "" ||
        facts.artifact_node_count != artifact.count ||
        ArrayLength(facts.node_ids) != ArrayLength(intent_node_ids) ||
        ArrayLength(facts.expression_root_ids) !=
            ArrayLength(intent_node_ids) {
        return false;
    }
    let i: Int = 0;
    while i < ArrayLength(intent_node_ids) {
        if !SelfDirIntentPriorityRowReady(
            artifact, expression_surfaces, intent_node_ids[i],
            facts.node_ids[i], facts.expression_root_ids[i]
        ) { return false; }
        i = i + 1;
    }
    return true;
}
