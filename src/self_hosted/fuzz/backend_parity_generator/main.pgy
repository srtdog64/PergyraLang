// Deterministic backend-parity fuzz corpus generator.
//
// Usage after compiling this file:
//   backend_parity_generator <seed> <count> <out_dir>
//
// The shell parity driver owns directory creation and backend execution. This
// Pergyra program owns the generated source text and manifest shape.

func Die(message: String) -> Void {
    Log(Concat("FUZZ GENERATOR ERROR ", message));
    Exit(1);
}

func JoinPath(dir: String, name: String) -> String {
    return Concat(Concat(dir, "/"), name);
}

func JsonHeader(seed: Int, count: Int) -> String {
    let out: Array<String> = [];
    ArrayPush(out, "{\"schema\":\"pgy.selfhost.backend-parity-fuzz-generator.v1\",");
    ArrayPush(out, "\"kind\":\"header\",");
    ArrayPush(out, "\"seed\":");
    ArrayPush(out, ToString(seed));
    ArrayPush(out, ",\"count\":");
    ArrayPush(out, ToString(count));
    ArrayPush(out, "}");
    return StringJoin(out, "");
}

func JsonCase(index: Int, file: String, variant: Int) -> String {
    let out: Array<String> = [];
    ArrayPush(out, "{\"kind\":\"case\",");
    ArrayPush(out, "\"index\":");
    ArrayPush(out, ToString(index));
    ArrayPush(out, ",\"file\":\"");
    ArrayPush(out, file);
    ArrayPush(out, "\",\"variant\":");
    ArrayPush(out, ToString(variant));
    ArrayPush(out, "}");
    return StringJoin(out, "");
}

func Summary(seed: Int, count: Int) -> String {
    let out: Array<String> = [];
    ArrayPush(out, "{\"schema\":\"pgy.selfhost.backend-parity-fuzz-generator.v1\",");
    ArrayPush(out, "\"ok\":true,");
    ArrayPush(out, "\"seed\":");
    ArrayPush(out, ToString(seed));
    ArrayPush(out, ",\"count\":");
    ArrayPush(out, ToString(count));
    ArrayPush(out, "}");
    return StringJoin(out, "");
}

func RenderArithmeticCase(index: Int, base: Int, twist: Int) -> String {
    let lines: Array<String> = [];
    ArrayPush(lines, "func Mix(x: Int, y: Int) -> Int {");
    ArrayPush(lines, "    let v: Int = x * 3 + y;");
    ArrayPush(lines, "    if v % 2 == 0 {");
    ArrayPush(lines, "        return v / 2;");
    ArrayPush(lines, "    }");
    ArrayPush(lines, "    return v + 5;");
    ArrayPush(lines, "}");
    ArrayPush(lines, "");
    ArrayPush(lines, "func Main() -> Void {");
    ArrayPush(lines, Concat("    let base: Int = ", Concat(ToString(base), ";")));
    ArrayPush(lines, Concat("    let twist: Int = ", Concat(ToString(twist), ";")));
    ArrayPush(lines, "    let mut acc: Int = 0;");
    ArrayPush(lines, "    for i in 0..5 {");
    ArrayPush(lines, "        acc = acc + Mix(base + i, twist);");
    ArrayPush(lines, "    }");
    ArrayPush(lines, "    if (acc > 10) && (twist >= 0) {");
    ArrayPush(lines, "        Log(Concat(\"arith:\", ToString(acc)));");
    ArrayPush(lines, "    } else {");
    ArrayPush(lines, "        Log(\"arith:small\");");
    ArrayPush(lines, "    }");
    ArrayPush(lines, "}");
    return Concat(StringJoin(lines, "\n"), "\n");
}

func RenderWhileArrayCase(index: Int, base: Int, twist: Int) -> String {
    let lines: Array<String> = [];
    ArrayPush(lines, "func Main() -> Void {");
    ArrayPush(lines, Concat("    let base: Int = ", Concat(ToString(base), ";")));
    ArrayPush(lines, Concat("    let limit: Int = ", Concat(ToString(4 + twist % 4), ";")));
    ArrayPush(lines, "    let xs: Array<Int> = [];");
    ArrayPush(lines, "    let mut i: Int = 0;");
    ArrayPush(lines, "    while i < limit {");
    ArrayPush(lines, "        ArrayPush(xs, base + i);");
    ArrayPush(lines, "        i = i + 1;");
    ArrayPush(lines, "    }");
    ArrayPush(lines, "    let mut total: Int = 0;");
    ArrayPush(lines, "    for j in 0..limit {");
    ArrayPush(lines, "        total = total + xs[j];");
    ArrayPush(lines, "    }");
    ArrayPush(lines, "    Log(Concat(\"array:\", ToString(total + ArrayLength(xs))));");
    ArrayPush(lines, "}");
    return Concat(StringJoin(lines, "\n"), "\n");
}

func RenderStringCase(index: Int, base: Int, twist: Int) -> String {
    let lines: Array<String> = [];
    ArrayPush(lines, "func Tag(x: Int) -> String {");
    ArrayPush(lines, "    if x < 10 {");
    ArrayPush(lines, "        return Concat(\"lo\", ToString(x));");
    ArrayPush(lines, "    }");
    ArrayPush(lines, "    return Concat(\"hi\", ToString(x));");
    ArrayPush(lines, "}");
    ArrayPush(lines, "");
    ArrayPush(lines, "func Main() -> Void {");
    ArrayPush(lines, Concat("    let base: Int = ", Concat(ToString(base), ";")));
    ArrayPush(lines, Concat("    let twist: Int = ", Concat(ToString(twist), ";")));
    ArrayPush(lines, "    let parts: Array<String> = [];");
    ArrayPush(lines, "    ArrayPush(parts, Tag(base));");
    ArrayPush(lines, "    ArrayPush(parts, Tag(base + twist));");
    ArrayPush(lines, "    ArrayPush(parts, ToString(StringLength(\"seed\")));");
    ArrayPush(lines, "    Log(StringJoin(parts, \"|\"));");
    ArrayPush(lines, "}");
    return Concat(StringJoin(lines, "\n"), "\n");
}

func RenderBranchCase(index: Int, base: Int, twist: Int) -> String {
    let lines: Array<String> = [];
    ArrayPush(lines, "func FuzzClamp(x: Int) -> Int {");
    ArrayPush(lines, "    if x < 0 {");
    ArrayPush(lines, "        return 0;");
    ArrayPush(lines, "    }");
    ArrayPush(lines, "    if x > 40 {");
    ArrayPush(lines, "        return 40;");
    ArrayPush(lines, "    }");
    ArrayPush(lines, "    return x;");
    ArrayPush(lines, "}");
    ArrayPush(lines, "");
    ArrayPush(lines, "func Main() -> Void {");
    ArrayPush(lines, Concat("    let base: Int = ", Concat(ToString(base), ";")));
    ArrayPush(lines, Concat("    let twist: Int = ", Concat(ToString(twist), ";")));
    ArrayPush(lines, "    let left: Int = FuzzClamp(base * 2 - twist);");
    ArrayPush(lines, "    let right: Int = FuzzClamp(base + twist * 3);");
    ArrayPush(lines, "    if (left == right) || (left < right) {");
    ArrayPush(lines, "        Log(Concat(\"branch:\", ToString(right - left)));");
    ArrayPush(lines, "    } else {");
    ArrayPush(lines, "        Log(Concat(\"branch:\", ToString(left - right)));");
    ArrayPush(lines, "    }");
    ArrayPush(lines, "}");
    return Concat(StringJoin(lines, "\n"), "\n");
}

func RenderStructCase(index: Int, base: Int, twist: Int) -> String {
    let lines: Array<String> = [];
    ArrayPush(lines, "struct FuzzPair {");
    ArrayPush(lines, "    let a: Int;");
    ArrayPush(lines, "    let b: Int;");
    ArrayPush(lines, "}");
    ArrayPush(lines, "");
    ArrayPush(lines, "func FuzzPairScore(p: FuzzPair, delta: Int) -> Int {");
    ArrayPush(lines, "    return p.a * 2 + p.b + delta;");
    ArrayPush(lines, "}");
    ArrayPush(lines, "");
    ArrayPush(lines, "func Main() -> Void {");
    ArrayPush(lines, Concat("    let base: Int = ", Concat(ToString(base), ";")));
    ArrayPush(lines, Concat("    let twist: Int = ", Concat(ToString(twist), ";")));
    ArrayPush(lines, "    let left: FuzzPair = FuzzPair(base, twist);");
    ArrayPush(lines, "    let right: FuzzPair = FuzzPair(base + 1, twist + 2);");
    ArrayPush(lines, "    let score: Int = FuzzPairScore(left, 3) + FuzzPairScore(right, 4);");
    ArrayPush(lines, "    Log(Concat(\"struct:\", ToString(score)));");
    ArrayPush(lines, "}");
    return Concat(StringJoin(lines, "\n"), "\n");
}

func RenderSlotCase(index: Int, base: Int, twist: Int) -> String {
    let lines: Array<String> = [];
    ArrayPush(lines, "func Main() -> Void {");
    ArrayPush(lines, Concat("    let base: Int = ", Concat(ToString(base), ";")));
    ArrayPush(lines, Concat("    let twist: Int = ", Concat(ToString(twist), ";")));
    ArrayPush(lines, "    let s: Slot<Int> = ClaimSlot();");
    ArrayPush(lines, "    Write(s, base);");
    ArrayPush(lines, "    let first: Int = Read(s);");
    ArrayPush(lines, "    Write(s, first + twist);");
    ArrayPush(lines, "    let second: Int = Read(s);");
    ArrayPush(lines, "    Log(Concat(\"slot:\", ToString(first + second)));");
    ArrayPush(lines, "    Release(s);");
    ArrayPush(lines, "}");
    return Concat(StringJoin(lines, "\n"), "\n");
}

func RenderStringWindowCase(index: Int, base: Int, twist: Int) -> String {
    let lines: Array<String> = [];
    ArrayPush(lines, "func FuzzRun(s: String) -> Int {");
    ArrayPush(lines, "    let n: Int = StringLength(s);");
    ArrayPush(lines, "    if n == 0 {");
    ArrayPush(lines, "        return 0;");
    ArrayPush(lines, "    }");
    ArrayPush(lines, "    let mut best: Int = 1;");
    ArrayPush(lines, "    let mut cur: Int = 1;");
    ArrayPush(lines, "    let mut i: Int = 1;");
    ArrayPush(lines, "    while i < n {");
    ArrayPush(lines, "        if Substring(s, i, i + 1) == Substring(s, i - 1, i) {");
    ArrayPush(lines, "            cur = cur + 1;");
    ArrayPush(lines, "            if cur > best {");
    ArrayPush(lines, "                best = cur;");
    ArrayPush(lines, "            }");
    ArrayPush(lines, "        } else {");
    ArrayPush(lines, "            cur = 1;");
    ArrayPush(lines, "        }");
    ArrayPush(lines, "        i = i + 1;");
    ArrayPush(lines, "    }");
    ArrayPush(lines, "    return best;");
    ArrayPush(lines, "}");
    ArrayPush(lines, "");
    ArrayPush(lines, "func Main() -> Void {");
    ArrayPush(lines, "    Log(Concat(\"window:\", ToString(FuzzRun(\"aaabbcccc\"))));");
    ArrayPush(lines, "    Log(Concat(\"window:\", ToString(FuzzRun(\"abcdef\"))));");
    ArrayPush(lines, "}");
    return Concat(StringJoin(lines, "\n"), "\n");
}

func RenderArrayParamCase(index: Int, base: Int, twist: Int) -> String {
    let lines: Array<String> = [];
    ArrayPush(lines, "func FuzzSum(xs: Array<Int>) -> Int {");
    ArrayPush(lines, "    let mut total: Int = 0;");
    ArrayPush(lines, "    let mut i: Int = 0;");
    ArrayPush(lines, "    while i < ArrayLength(xs) {");
    ArrayPush(lines, "        total = total + xs[i];");
    ArrayPush(lines, "        i = i + 1;");
    ArrayPush(lines, "    }");
    ArrayPush(lines, "    return total;");
    ArrayPush(lines, "}");
    ArrayPush(lines, "");
    ArrayPush(lines, "func FuzzBuild(base: Int, n: Int) -> Array<Int> {");
    ArrayPush(lines, "    let xs: Array<Int> = [];");
    ArrayPush(lines, "    let mut i: Int = 0;");
    ArrayPush(lines, "    while i < n {");
    ArrayPush(lines, "        ArrayPush(xs, base + i * 2);");
    ArrayPush(lines, "        i = i + 1;");
    ArrayPush(lines, "    }");
    ArrayPush(lines, "    return xs;");
    ArrayPush(lines, "}");
    ArrayPush(lines, "");
    ArrayPush(lines, "func Main() -> Void {");
    ArrayPush(lines, Concat("    let base: Int = ", Concat(ToString(base), ";")));
    ArrayPush(lines, Concat("    let n: Int = ", Concat(ToString(3 + twist % 4), ";")));
    ArrayPush(lines, "    let xs: Array<Int> = FuzzBuild(base, n);");
    ArrayPush(lines, "    Log(Concat(\"array-param:\", ToString(FuzzSum(xs) + ArrayLength(xs))));");
    ArrayPush(lines, "}");
    return Concat(StringJoin(lines, "\n"), "\n");
}

func RenderPredicateCursorCase(index: Int, base: Int, twist: Int) -> String {
    let lines: Array<String> = [];
    ArrayPush(lines, "func TokenAt(pos: Int) -> Int {");
    ArrayPush(lines, "    let normalized: Int = pos % 6;");
    ArrayPush(lines, "    if normalized == 0 { return 4; }");
    ArrayPush(lines, "    if normalized == 1 { return 8; }");
    ArrayPush(lines, "    if normalized == 2 { return 4; }");
    ArrayPush(lines, "    if normalized == 3 { return 3; }");
    ArrayPush(lines, "    if normalized == 4 { return 4; }");
    ArrayPush(lines, "    return 9;");
    ArrayPush(lines, "}");
    ArrayPush(lines, "");
    ArrayPush(lines, "func ConsumeBranch(pos: Int, expected: Int) -> Int {");
    ArrayPush(lines, "    if TokenAt(pos) == expected {");
    ArrayPush(lines, "        return pos + 1;");
    ArrayPush(lines, "    }");
    ArrayPush(lines, "    return pos;");
    ArrayPush(lines, "}");
    ArrayPush(lines, "");
    ArrayPush(lines, "func ConsumePredicated(pos: Int, expected: Int) -> Int {");
    ArrayPush(lines, "    let hit: Bool = TokenAt(pos) == expected;");
    ArrayPush(lines, "    let delta: Int = 0;");
    ArrayPush(lines, "    if hit {");
    ArrayPush(lines, "        delta = 1;");
    ArrayPush(lines, "    }");
    ArrayPush(lines, "    return pos + delta;");
    ArrayPush(lines, "}");
    ArrayPush(lines, "");
    ArrayPush(lines, "func RunCursor(expected: Int, rounds: Int) -> Int {");
    ArrayPush(lines, "    let branch_pos: Int = 0;");
    ArrayPush(lines, "    let pred_pos: Int = 0;");
    ArrayPush(lines, "    let i: Int = 0;");
    ArrayPush(lines, "    while i < rounds {");
    ArrayPush(lines, "        branch_pos = ConsumeBranch(branch_pos, expected);");
    ArrayPush(lines, "        pred_pos = ConsumePredicated(pred_pos, expected);");
    ArrayPush(lines, "        if branch_pos != pred_pos {");
    ArrayPush(lines, "            Log(\"FUZZ_MISMATCH predicate-cursor\");");
    ArrayPush(lines, "            Exit(1);");
    ArrayPush(lines, "        }");
    ArrayPush(lines, "        i = i + 1;");
    ArrayPush(lines, "    }");
    ArrayPush(lines, "    return pred_pos;");
    ArrayPush(lines, "}");
    ArrayPush(lines, "");
    ArrayPush(lines, "func Main() -> Void {");
    ArrayPush(lines, Concat("    let rounds: Int = ", Concat(ToString(4 + twist % 5), ";")));
    ArrayPush(lines, "    Log(Concat(\"predicate-cursor:\", ToString(RunCursor(4, rounds))));");
    ArrayPush(lines, "    Log(Concat(\"predicate-cursor:\", ToString(RunCursor(8, rounds + 1))));");
    ArrayPush(lines, "}");
    return Concat(StringJoin(lines, "\n"), "\n");
}

func RenderProgram(index: Int, variant: Int) -> String {
    let base: Int = 1 + Random(17);
    let twist: Int = 1 + Random(9);
    if variant == 0 {
        return RenderArithmeticCase(index, base, twist);
    }
    if variant == 1 {
        return RenderWhileArrayCase(index, base, twist);
    }
    if variant == 2 {
        return RenderStringCase(index, base, twist);
    }
    if variant == 3 {
        return RenderBranchCase(index, base, twist);
    }
    if variant == 4 {
        return RenderStructCase(index, base, twist);
    }
    if variant == 5 {
        return RenderSlotCase(index, base, twist);
    }
    if variant == 6 {
        return RenderStringWindowCase(index, base, twist);
    }
    if variant == 7 {
        return RenderPredicateCursorCase(index, base, twist);
    }
    return RenderArrayParamCase(index, base, twist);
}

func Main() -> Void {
    let args: Array<String> = Args();
    if ArrayLength(args) < 3 {
        Die("usage: <seed> <count> <out_dir>");
    }

    let seed: Int = ToInt(args[0]);
    let count: Int = ToInt(args[1]);
    let out_dir: String = args[2];
    if count <= 0 {
        Die("count must be positive");
    }

    SeedRandom(seed);

    let manifest: Array<String> = [];
    ArrayPush(manifest, JsonHeader(seed, count));

    let mut i: Int = 0;
    while i < count {
        let variant: Int = Random(9);
        if i == 0 {
            variant = 7;
        }
        let name: String = Concat("f", Concat(ToString(i), ".pgy"));
        let source: String = RenderProgram(i, variant);
        WriteFile(JoinPath(out_dir, name), source);
        ArrayPush(manifest, JsonCase(i, name, variant));
        i = i + 1;
    }

    WriteFile(JoinPath(out_dir, "manifest.jsonl"), Concat(StringJoin(manifest, "\n"), "\n"));
    Log(Summary(seed, count));
}
