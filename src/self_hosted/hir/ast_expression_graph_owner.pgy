// Parser-owned recursive expression rows carried by the typed AST artifact.

import "ast_node_kind_owner.pgy";
import "ast_text_scan_owner.pgy";

struct AstExpressionArena {
    node_kinds: Array<Int>;
    node_texts: Array<String>;
    left_children: Array<Int>;
    right_children: Array<Int>;
}

struct AstExpressionGraphRows {
    ok: Bool;
    root_owner_kinds: Array<Int>;
    root_lanes: Array<Int>;
    roots: Array<Int>;
    arena: AstExpressionArena;
}

func AstExpressionLaneAtom() -> Int { return 0; }
func AstExpressionLaneValue() -> Int { return 1; }
func AstExpressionLaneAuxiliary() -> Int { return 2; }

func AstExpressionNodeLeaf() -> Int { return 0; }
func AstExpressionNodeLogicalOr() -> Int { return 1; }
func AstExpressionNodeLogicalAnd() -> Int { return 2; }
func AstExpressionNodeEquality() -> Int { return 3; }
func AstExpressionNodeInequality() -> Int { return 4; }
func AstExpressionNodeLess() -> Int { return 5; }
func AstExpressionNodeLessEqual() -> Int { return 6; }
func AstExpressionNodeGreater() -> Int { return 7; }
func AstExpressionNodeGreaterEqual() -> Int { return 8; }
func AstExpressionNodeAdd() -> Int { return 9; }
func AstExpressionNodeSubtract() -> Int { return 10; }
func AstExpressionNodeMultiply() -> Int { return 11; }
func AstExpressionNodeDivide() -> Int { return 12; }
func AstExpressionNodeModulo() -> Int { return 13; }
func AstExpressionNodeIndex() -> Int { return 14; }
func AstExpressionNodeLogicalNot() -> Int { return 15; }
func AstExpressionNodeNegate() -> Int { return 16; }
func AstExpressionNodeCall() -> Int { return 17; }
func AstExpressionNodeCallArgument() -> Int { return 18; }
func AstExpressionNodeMemberAccess() -> Int { return 19; }
func AstExpressionNodeTry() -> Int { return 20; }
func AstExpressionNodeArrayLiteral() -> Int { return 21; }
func AstExpressionNodeArrayElement() -> Int { return 22; }
func AstExpressionNodeStructLiteral() -> Int { return 23; }
func AstExpressionNodeStructFieldBinding() -> Int { return 24; }
func AstExpressionNodeStructField() -> Int { return 25; }
func AstExpressionNodeStructFieldName() -> Int { return 26; }
func AstExpressionNodeGenericTypeActual() -> Int { return 27; }
func AstExpressionNodeGenericCallee() -> Int { return 28; }
func AstExpressionNodeFloatLiteral() -> Int { return 29; }
func AstExpressionNodeIntegerLiteral() -> Int { return 30; }
func AstExpressionNodeLongLiteral() -> Int { return 31; }
func AstExpressionNodeBoolLiteral() -> Int { return 32; }

func AstExpressionNodeKindKnown(kind: Int) -> Bool {
    return kind >= AstExpressionNodeLeaf() &&
        kind <= AstExpressionNodeBoolLiteral();
}

func AstExpressionNodeIsScalarLeaf(kind: Int) -> Bool {
    return kind == AstExpressionNodeLeaf() ||
        kind == AstExpressionNodeFloatLiteral() ||
        kind == AstExpressionNodeIntegerLiteral() ||
        kind == AstExpressionNodeLongLiteral() ||
        kind == AstExpressionNodeBoolLiteral();
}

func AstExpressionBoolLiteralPayloadReady(text: String) -> Bool {
    return text == "true" || text == "false";
}

func AstExpressionLongLiteralPayloadReady(text: String) -> Bool {
    let n: Int = StringLength(text);
    if n < 2 || CodegenCharAt(text, n - 1) != "L" { return false; }
    let i: Int = 0;
    while i < n - 1 {
        if StringIndexOf("0123456789", CodegenCharAt(text, i)) < 0 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func AstExpressionNodeIsUnaryOperator(kind: Int) -> Bool {
    return kind == AstExpressionNodeLogicalNot() ||
        kind == AstExpressionNodeNegate() ||
        kind == AstExpressionNodeTry();
}

func AstExpressionNodeIsCallSpine(kind: Int) -> Bool {
    return kind == AstExpressionNodeCall() ||
        kind == AstExpressionNodeCallArgument();
}

func AstExpressionNodeIsArrayLiteralSpine(kind: Int) -> Bool {
    return kind == AstExpressionNodeArrayLiteral() ||
        kind == AstExpressionNodeArrayElement();
}

func AstExpressionNodeIsStructLiteralSpine(kind: Int) -> Bool {
    return kind == AstExpressionNodeStructLiteral() ||
        kind == AstExpressionNodeStructField();
}

func AstExpressionNodeIsCallableCallee(kind: Int) -> Bool {
    return kind == AstExpressionNodeLeaf() ||
        kind == AstExpressionNodeMemberAccess() ||
        kind == AstExpressionNodeGenericCallee();
}

func AstExpressionNodeArityOpt(kind: Int) -> Option<Int> {
    if !AstExpressionNodeKindKnown(kind) { return None; }
    if AstExpressionNodeIsScalarLeaf(kind) ||
        kind == AstExpressionNodeStructFieldName() ||
        kind == AstExpressionNodeGenericTypeActual() ||
        kind == AstExpressionNodeArrayLiteral() {
        return Some(0);
    }
    if AstExpressionNodeIsUnaryOperator(kind) ||
        kind == AstExpressionNodeCall() ||
        kind == AstExpressionNodeStructLiteral() {
        return Some(1);
    }
    return Some(2);
}

func AstExpressionNodeArity(kind: Int) -> Int {
    let arity: Option<Int> = AstExpressionNodeArityOpt(kind);
    if !IsSome(arity) {
        Log("TYPED AST INVARIANT ERROR: unknown expression node kind");
        Exit(1);
    }
    return UnwrapOption(arity);
}

func AstExpressionArenaEmpty() -> AstExpressionArena {
    let kinds: Array<Int> = [];
    let texts: Array<String> = [];
    let left_children: Array<Int> = [];
    let right_children: Array<Int> = [];
    return AstExpressionArena(kinds, texts, left_children, right_children);
}

func AstExpressionGraphRowsEmpty() -> AstExpressionGraphRows {
    let owner_kinds: Array<Int> = [];
    let lanes: Array<Int> = [];
    let roots: Array<Int> = [];
    return AstExpressionGraphRows(
        true, owner_kinds, lanes, roots, AstExpressionArenaEmpty()
    );
}

func AstExpressionOwnerKindKnown(kind: Int) -> Bool {
    return TypedAstKindKnown(kind);
}

func AstExpressionArenaNodeCount(ref arena: AstExpressionArena) -> Int {
    return ArrayLength(arena.node_kinds);
}

func AstExpressionArenaReady(ref arena: AstExpressionArena) -> Bool {
    let count: Int = AstExpressionArenaNodeCount(arena);
    if ArrayLength(arena.node_texts) != count ||
        ArrayLength(arena.left_children) != count ||
        ArrayLength(arena.right_children) != count {
        return false;
    }
    let i: Int = 0;
    while i < count {
        let kind: Int = arena.node_kinds[i];
        let left: Int = arena.left_children[i];
        let right: Int = arena.right_children[i];
        if arena.node_texts[i] == "" ||
            !AstExpressionNodeKindKnown(kind) {
            return false;
        }
        if kind == AstExpressionNodeLongLiteral() &&
            !AstExpressionLongLiteralPayloadReady(arena.node_texts[i]) {
            return false;
        }
        if kind == AstExpressionNodeBoolLiteral() &&
            !AstExpressionBoolLiteralPayloadReady(arena.node_texts[i]) {
            return false;
        }
        let arity: Int = AstExpressionNodeArity(kind);
        if arity == 0 {
            if left != 0 || right != 0 { return false; }
        } else if left < 0 || left >= i {
            return false;
        } else if arity == 1 {
            if right != 0 { return false; }
        } else if right < 0 || right >= i {
            return false;
        }
        if kind == AstExpressionNodeCall() &&
            !AstExpressionNodeIsCallableCallee(arena.node_kinds[left]) {
            return false;
        }
        if kind == AstExpressionNodeCallArgument() &&
            !AstExpressionNodeIsCallSpine(arena.node_kinds[left]) {
            return false;
        }
        if kind == AstExpressionNodeMemberAccess() &&
            arena.node_kinds[right] != AstExpressionNodeLeaf() {
            return false;
        }
        if kind == AstExpressionNodeGenericCallee() &&
            (!AstExpressionNodeIsCallableCallee(arena.node_kinds[left]) ||
                arena.node_kinds[right] !=
                    AstExpressionNodeGenericTypeActual()) {
            return false;
        }
        if kind == AstExpressionNodeArrayElement() &&
            !AstExpressionNodeIsArrayLiteralSpine(
                arena.node_kinds[left]
            ) {
            return false;
        }
        if kind == AstExpressionNodeStructLiteral() &&
            arena.node_kinds[left] != AstExpressionNodeLeaf() {
            return false;
        }
        if kind == AstExpressionNodeStructFieldBinding() &&
            arena.node_kinds[left] != AstExpressionNodeStructFieldName() {
            return false;
        }
        if kind == AstExpressionNodeStructField() &&
            (!AstExpressionNodeIsStructLiteralSpine(
                arena.node_kinds[left]
            ) || arena.node_kinds[right] !=
                AstExpressionNodeStructFieldBinding()) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func AstExpressionGraphRowsReady(ref rows: AstExpressionGraphRows) -> Bool {
    if !rows.ok || !AstExpressionArenaReady(rows.arena) { return false; }
    let node_count: Int = AstExpressionArenaNodeCount(rows.arena);
    let root_count: Int = ArrayLength(rows.roots);
    if ArrayLength(rows.root_owner_kinds) != root_count ||
        ArrayLength(rows.root_lanes) != root_count {
        return false;
    }
    if root_count == 0 { return node_count == 0; }
    let seen: Array<Bool> = [];
    let stack: Array<Int> = [];
    let i: Int = 0;
    while i < node_count { ArrayPush(seen, false); i = i + 1; }
    i = 0;
    let previous_root: Int = -1;
    while i < root_count {
        let root: Int = rows.roots[i];
        if root < 0 || root >= node_count { return false; }
        if root <= previous_root ||
            !AstExpressionOwnerKindKnown(rows.root_owner_kinds[i]) ||
            rows.root_lanes[i] < AstExpressionLaneAtom() ||
            rows.root_lanes[i] > AstExpressionLaneAuxiliary() {
            return false;
        }
        ArrayPush(stack, root);
        previous_root = root;
        i = i + 1;
    }
    if previous_root != node_count - 1 { return false; }
    while ArrayLength(stack) > 0 {
        let node: Int = stack[ArrayLength(stack) - 1];
        ArrayPop(stack);
        if !seen[node] {
            ArraySet(seen, node, true);
            let arity: Int = AstExpressionNodeArity(
                rows.arena.node_kinds[node]
            );
            if arity >= 1 {
                ArrayPush(stack, rows.arena.left_children[node]);
            }
            if arity == 2 {
                ArrayPush(stack, rows.arena.right_children[node]);
            }
        }
    }
    i = 0;
    while i < node_count {
        if !seen[i] { return false; }
        i = i + 1;
    }
    return true;
}
