// Canonical bounded match-pattern facts from the typed MatchCase AST atom.

import "ast_text_arena_projection_owner.pgy";

struct AstMatchCasePatternFact {
    ok: Bool;
    pattern: String;
    variant: String;
    bindings: Array<String>;
}

func AstMatchCasePatternFactInvalid() -> AstMatchCasePatternFact {
    let bindings: Array<String> = [];
    return AstMatchCasePatternFact(false, "", "", bindings);
}

func AstMatchCasePatternFactDigest(
    ref fact: AstMatchCasePatternFact
) -> Int {
    if !fact.ok { return 0; }
    let modulus: Long = 268435456L;
    let hash: Long = AstTreeArtifactIdentityHashString(
        53L, fact.pattern, modulus
    );
    hash = AstTreeArtifactIdentityHashString(hash, fact.variant, modulus);
    hash = AstTreeArtifactIdentityHashInt(
        hash, ArrayLength(fact.bindings), modulus
    );
    let i: Int = 0;
    while i < ArrayLength(fact.bindings) {
        hash = AstTreeArtifactIdentityHashString(
            hash, fact.bindings[i], modulus
        );
        i = i + 1;
    }
    let digest: Int = hash as Int;
    if digest == 0 { return 1; }
    return digest;
}

// An or-pattern atom is `A | B`, the parser's canonical spelling. Each
// alternative is an Int literal or a payload-free name; the parser refuses
// a destructuring alternative.
func AstMatchCasePatternFactFromText(pattern: String) -> AstMatchCasePatternFact {
    let text: String = StringTrim(pattern);
    if StringIndexOf(text, " | ") >= 0 {
        let parts: Array<String> = Split(text, "|");
        let part: Int = 0;
        while part < ArrayLength(parts) {
            let alternative: String = StringTrim(parts[part]);
            if alternative == "" || (!IsIdentifier(alternative) &&
                ToString(ToInt(alternative)) != alternative) {
                return AstMatchCasePatternFactInvalid();
            }
            part = part + 1;
        }
        let no_bindings: Array<String> = [];
        return AstMatchCasePatternFact(true, text, "", no_bindings);
    }
    let open: Int = StringIndexOf(text, "(");
    if open < 0 {
        if !IsIdentifier(text) && ToString(ToInt(text)) != text {
            return AstMatchCasePatternFactInvalid();
        }
        let bindings: Array<String> = [];
        if text == "None" {
            return AstMatchCasePatternFact(true, text, "None", bindings);
        }
        return AstMatchCasePatternFact(true, text, "", bindings);
    }
    let close: Int = StringIndexOf(text, ")");
    if open <= 0 || close <= open || close != StringLength(text) - 1 {
        return AstMatchCasePatternFactInvalid();
    }
    let variant: String = StringTrim(Substring(text, 0, open));
    let payload: String = StringTrim(Substring(
        text, open + 1, close - open - 1
    ));
    if !IsIdentifier(variant) || payload == "" {
        return AstMatchCasePatternFactInvalid();
    }
    let parts: Array<String> = Split(payload, ",");
    let bindings: Array<String> = [];
    let i: Int = 0;
    while i < ArrayLength(parts) {
        let binding: String = StringTrim(parts[i]);
        if !IsIdentifier(binding) {
            return AstMatchCasePatternFactInvalid();
        }
        let prior: Int = 0;
        while prior < ArrayLength(bindings) {
            if bindings[prior] == binding {
                return AstMatchCasePatternFactInvalid();
            }
            prior = prior + 1;
        }
        ArrayPush(bindings, binding);
        i = i + 1;
    }
    return AstMatchCasePatternFact(true, text, variant, bindings);
}

// The values one arm accepts, in source order: the alternatives of an
// or-pattern, or the one pattern. Consumers read this instead of splitting
// the atom themselves.
func AstMatchCasePatternAlternatives(
    ref fact: AstMatchCasePatternFact
) -> Array<String> {
    let alternatives: Array<String> = [];
    if !fact.ok { return alternatives; }
    if fact.variant != "" || StringIndexOf(fact.pattern, " | ") < 0 {
        ArrayPush(alternatives, fact.pattern);
        return alternatives;
    }
    let parts: Array<String> = Split(fact.pattern, "|");
    let part: Int = 0;
    while part < ArrayLength(parts) {
        ArrayPush(alternatives, StringTrim(parts[part]));
        part = part + 1;
    }
    return alternatives;
}

func AstMatchCasePatternFactContractReady() -> Bool {
    let scalar: AstMatchCasePatternFact =
        AstMatchCasePatternFactFromText("1");
    let leaf: AstMatchCasePatternFact =
        AstMatchCasePatternFactFromText("Ready");
    let payload: AstMatchCasePatternFact =
        AstMatchCasePatternFactFromText("Pair(left, right)");
    let changed: AstMatchCasePatternFact = AstMatchCasePatternFact(
        true, payload.pattern, "Other", payload.bindings
    );
    let either: AstMatchCasePatternFact =
        AstMatchCasePatternFactFromText("0 | Ready");
    let either_values: Array<String> = AstMatchCasePatternAlternatives(either);
    let single_values: Array<String> = AstMatchCasePatternAlternatives(payload);
    return either.ok && either.variant == "" &&
        ArrayLength(either.bindings) == 0 &&
        ArrayLength(either_values) == 2 && either_values[0] == "0" &&
        either_values[1] == "Ready" &&
        ArrayLength(single_values) == 1 &&
        single_values[0] == "Pair(left, right)" &&
        !AstMatchCasePatternFactFromText("Pair(left) | Ready").ok &&
        !AstMatchCasePatternFactFromText("0 | ").ok &&
        scalar.ok && scalar.variant == "" &&
        AstMatchCasePatternFactDigest(scalar) != 0 &&
        ArrayLength(scalar.bindings) == 0 &&
        leaf.ok && leaf.pattern == "Ready" &&
        payload.ok && payload.variant == "Pair" &&
        AstMatchCasePatternFactDigest(payload) !=
            AstMatchCasePatternFactDigest(changed) &&
        ArrayLength(payload.bindings) == 2 &&
        payload.bindings[0] == "left" && payload.bindings[1] == "right" &&
        !AstMatchCasePatternFactFromText("").ok &&
        !AstMatchCasePatternFactFromText("\"text\"").ok &&
        !AstMatchCasePatternFactFromText("Pair(left, left)").ok &&
        !AstMatchCasePatternFactFromText("Pair(1)").ok &&
        !AstMatchCasePatternFactFromText("Pair()").ok;
}

// The caller has already proved AstTreeArtifactReady at its admission
// boundary. Keep the local node/kind/atom checks here, but do not reopen the
// whole artifact and expression-graph proof for every nested match use site.
func AstMatchCasePatternFactFromReadyArtifact(
    artifact: AstTreeArtifact,
    case_node_id: Int
) -> AstMatchCasePatternFact {
    if case_node_id < 0 || case_node_id >= artifact.count ||
        !TypedAstArenaNodeKindIs(
            artifact.arena, case_node_id, TypedAstKindMatchCaseStmtTag()
        ) {
        return AstMatchCasePatternFactInvalid();
    }
    let pattern: Option<String> = TypedAstArenaAtomText(
        artifact.arena, case_node_id
    );
    if !IsSome(pattern) {
        return AstMatchCasePatternFactInvalid();
    }
    return AstMatchCasePatternFactFromText(UnwrapOption(pattern));
}

func AstMatchCasePatternFactFromArtifact(
    artifact: AstTreeArtifact,
    case_node_id: Int
) -> AstMatchCasePatternFact {
    if !AstTreeArtifactReady(artifact) {
        return AstMatchCasePatternFactInvalid();
    }
    return AstMatchCasePatternFactFromReadyArtifact(
        artifact, case_node_id
    );
}
