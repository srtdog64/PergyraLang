// Canonical compact AST/HIR node-kind tags shared by all compiler stages.

func TypedAstKindUnknownTag() -> Int { return 1; }
func TypedAstKindParametersTag() -> Int { return 2; }
func TypedAstKindReturnsTag() -> Int { return 3; }
func TypedAstKindFieldsHeaderTag() -> Int { return 4; }
func TypedAstKindFieldTag() -> Int { return 5; }
func TypedAstKindFuncDeclTag() -> Int { return 6; }
func TypedAstKindRoleDeclTag() -> Int { return 7; }
func TypedAstKindNominalDeclTag() -> Int { return 8; }
func TypedAstKindEnumDeclTag() -> Int { return 9; }
func TypedAstKindEventDeclTag() -> Int { return 10; }
func TypedAstKindAbilityDeclTag() -> Int { return 11; }
func TypedAstKindParamTag() -> Int { return 12; }
func TypedAstKindLogStmtTag() -> Int { return 13; }
func TypedAstKindBareReturnStmtTag() -> Int { return 14; }
func TypedAstKindValueReturnStmtTag() -> Int { return 15; }
func TypedAstKindArrayPopStmtTag() -> Int { return 16; }
func TypedAstKindExitStmtTag() -> Int { return 17; }
func TypedAstKindArraySetStmtTag() -> Int { return 18; }
func TypedAstKindArrayPushStmtTag() -> Int { return 19; }
func TypedAstKindLetStmtTag() -> Int { return 20; }
func TypedAstKindAssignStmtTag() -> Int { return 21; }
func TypedAstKindForStmtTag() -> Int { return 22; }
func TypedAstKindWhileStmtTag() -> Int { return 23; }
func TypedAstKindIfStmtTag() -> Int { return 24; }
func TypedAstKindElseStmtTag() -> Int { return 25; }
func TypedAstKindDeferStmtTag() -> Int { return 26; }
func TypedAstKindBreakStmtTag() -> Int { return 27; }
func TypedAstKindContinueStmtTag() -> Int { return 28; }
func TypedAstKindBareCallStmtTag() -> Int { return 29; }
func TypedAstKindProgramTag() -> Int { return 30; }
func TypedAstKindBodyTag() -> Int { return 31; }
func TypedAstKindBlockTag() -> Int { return 32; }
func TypedAstKindThenTag() -> Int { return 33; }
func TypedAstKindMatchStmtTag() -> Int { return 34; }
func TypedAstKindMatchCaseStmtTag() -> Int { return 35; }
func TypedAstKindMatchDefaultStmtTag() -> Int { return 36; }
func TypedAstKindGenericParamsTag() -> Int { return 37; }
func TypedAstKindDestructureStmtTag() -> Int { return 38; }
func TypedAstKindRoleSlotTag() -> Int { return 39; }
func TypedAstKindImplAbilityTag() -> Int { return 40; }
func TypedAstKindBindStmtTag() -> Int { return 41; }
func TypedAstKindGenericConstraintsTag() -> Int { return 42; }
func TypedAstKindActionDeclTag() -> Int { return 43; }
func TypedAstKindActionRequiresTag() -> Int { return 44; }
func TypedAstKindActionWithinTag() -> Int { return 45; }
func TypedAstKindActionCausesTag() -> Int { return 46; }
func TypedAstKindActionAuthorizedByTag() -> Int { return 47; }
func TypedAstKindCallableCapsTag() -> Int { return 48; }
func TypedAstKindCallableEffectsTag() -> Int { return 49; }
func TypedAstKindZoneAuthorityTag() -> Int { return 50; }
func TypedAstKindDomainRefreshTag() -> Int { return 51; }
func TypedAstKindDomainPublishTag() -> Int { return 52; }
func TypedAstKindDomainProjectionBindTag() -> Int { return 53; }
func TypedAstKindDomainMaintainTag() -> Int { return 54; }
func TypedAstKindDomainLinkTag() -> Int { return 55; }
func TypedAstKindDomainApplyTag() -> Int { return 56; }
func TypedAstKindDomainDetachTag() -> Int { return 57; }
func TypedAstKindDomainUnlinkTag() -> Int { return 58; }
func TypedAstKindDomainStateTag() -> Int { return 59; }
func TypedAstKindRoleIncludeTag() -> Int { return 60; }
func TypedAstKindIntentDeclTag() -> Int { return 61; }
func TypedAstKindRosterDeclTag() -> Int { return 62; }
func TypedAstKindDomainProjectionMapEntryTag() -> Int { return 63; }
func TypedAstKindIntentModeTag() -> Int { return 64; }
func TypedAstKindIntentRollbackTag() -> Int { return 65; }
func TypedAstKindIntentRetryTag() -> Int { return 66; }
func TypedAstKindIntentInvolvesTag() -> Int { return 67; }
func TypedAstKindIntentValueTag() -> Int { return 68; }
func TypedAstKindIntentStepTag() -> Int { return 69; }
func TypedAstKindIntentSuccessTag() -> Int { return 70; }
func TypedAstKindIntentFailureTag() -> Int { return 71; }
func TypedAstKindIntentStepWhoTag() -> Int { return 72; }
func TypedAstKindIntentStepUsingTag() -> Int { return 73; }
func TypedAstKindIntentStepTransferTag() -> Int { return 74; }
func TypedAstKindIntentStepOnTag() -> Int { return 75; }
func TypedAstKindIntentStepCompensateTag() -> Int { return 76; }
func TypedAstKindIntentStepGuardTag() -> Int { return 77; }
func TypedAstKindIntentStepPostTag() -> Int { return 78; }
func TypedAstKindIntentStepAuthorizedByTag() -> Int { return 79; }
func TypedAstKindIntentStepExpectTag() -> Int { return 80; }
// Appended to preserve every previously published compact kind identity.
func TypedAstKindIntentStepOutcomeTag() -> Int { return 81; }
func TypedAstKindIntentReturnsTag() -> Int { return 82; }
func TypedAstKindIntentStepSuccessTag() -> Int { return 83; }
func TypedAstKindIntentStepFailureTag() -> Int { return 84; }
func TypedAstKindIntentTerminalSuccessTag() -> Int { return 85; }
func TypedAstKindIntentTerminalFailureTag() -> Int { return 86; }
// Host-ABI declaration container: `extern "ABI" { func SIG; ... }`. Members
// are body-less Function nodes, the shape ability members already carry.
func TypedAstKindExternBlockTag() -> Int { return 87; }
// Appended intent-step parser provenance; existing compact IDs never move.
func TypedAstKindIntentStepContractProvenanceTag() -> Int { return 88; }
func TypedAstKindIntentStepIntentTag() -> Int { return 89; }
// Appended intent declaration priority; existing compact IDs never move.
func TypedAstKindIntentPriorityTag() -> Int { return 90; }
// Format-admission-only surface rows. General self-host compilation does not
// admit these declarations until their semantic consumers own them.
func TypedAstKindUseDeclTag() -> Int { return 91; }
func TypedAstKindLifecycleDeclTag() -> Int { return 92; }
func TypedAstKindLifecycleTransitionTag() -> Int { return 93; }

func TypedAstKindIsIntentRow(kind: Int) -> Bool {
    return (kind >= TypedAstKindIntentModeTag() &&
        kind <= TypedAstKindIntentTerminalFailureTag()) ||
        kind == TypedAstKindIntentStepContractProvenanceTag() ||
        kind == TypedAstKindIntentStepIntentTag() ||
        kind == TypedAstKindIntentPriorityTag();
}

func TypedAstKindIsDomainTopologyDirective(kind: Int) -> Bool {
    return kind >= TypedAstKindDomainRefreshTag() &&
        kind <= TypedAstKindDomainStateTag();
}

func TypedAstKindIsCallableDecl(kind: Int) -> Bool {
    return kind == TypedAstKindFuncDeclTag() ||
        kind == TypedAstKindActionDeclTag();
}

func TypedAstKindKnown(kind: Int) -> Bool {
    return kind >= TypedAstKindUnknownTag() &&
        kind <= TypedAstKindLifecycleTransitionTag();
}

func TypedAstCallStatementKindForCallee(callee: String) -> Int {
    if callee == "Log" { return TypedAstKindLogStmtTag(); }
    if callee == "ArrayPop" { return TypedAstKindArrayPopStmtTag(); }
    if callee == "Exit" { return TypedAstKindExitStmtTag(); }
    if callee == "ArraySet" { return TypedAstKindArraySetStmtTag(); }
    if callee == "ArrayPush" { return TypedAstKindArrayPushStmtTag(); }
    if callee != "" { return TypedAstKindBareCallStmtTag(); }
    return TypedAstKindUnknownTag();
}

func TypedAstNominalSubkindNone() -> Int { return 0; }
func TypedAstNominalSubkindStruct() -> Int { return 1; }
func TypedAstNominalSubkindClass() -> Int { return 2; }
func TypedAstNominalSubkindSubject() -> Int { return 3; }
func TypedAstNominalSubkindObject() -> Int { return 4; }
func TypedAstNominalSubkindTObject() -> Int { return 5; }
func TypedAstNominalSubkindVessel() -> Int { return 6; }
func TypedAstNominalSubkindZone() -> Int { return 7; }
func TypedAstNominalSubkindWorld() -> Int { return 8; }
func TypedAstNominalSubkindParty() -> Int { return 9; }
func TypedAstNominalSubkindEffect() -> Int { return 10; }
func TypedAstNominalSubkindRelation() -> Int { return 11; }

func TypedAstNominalSubkindName(subkind: Int) -> String {
    if subkind == TypedAstNominalSubkindStruct() { return "struct"; }
    if subkind == TypedAstNominalSubkindClass() { return "class"; }
    if subkind == TypedAstNominalSubkindSubject() { return "subject"; }
    if subkind == TypedAstNominalSubkindObject() { return "object"; }
    if subkind == TypedAstNominalSubkindTObject() { return "tobject"; }
    if subkind == TypedAstNominalSubkindVessel() { return "vessel"; }
    if subkind == TypedAstNominalSubkindZone() { return "zone"; }
    if subkind == TypedAstNominalSubkindWorld() { return "world"; }
    if subkind == TypedAstNominalSubkindParty() { return "party"; }
    if subkind == TypedAstNominalSubkindEffect() { return "effect"; }
    if subkind == TypedAstNominalSubkindRelation() { return "relation"; }
    return "";
}

func TypedAstKindTags() -> Array<Int> {
    let tags: Array<Int> = [
        TypedAstKindUnknownTag(), TypedAstKindParametersTag(),
        TypedAstKindReturnsTag(), TypedAstKindFieldsHeaderTag(),
        TypedAstKindFieldTag(), TypedAstKindFuncDeclTag(),
        TypedAstKindRoleDeclTag(), TypedAstKindNominalDeclTag(),
        TypedAstKindEnumDeclTag(), TypedAstKindEventDeclTag(),
        TypedAstKindAbilityDeclTag(), TypedAstKindParamTag(),
        TypedAstKindLogStmtTag(), TypedAstKindBareReturnStmtTag(),
        TypedAstKindValueReturnStmtTag(), TypedAstKindArrayPopStmtTag(),
        TypedAstKindExitStmtTag(), TypedAstKindArraySetStmtTag(),
        TypedAstKindArrayPushStmtTag(), TypedAstKindLetStmtTag(),
        TypedAstKindAssignStmtTag(), TypedAstKindForStmtTag(),
        TypedAstKindWhileStmtTag(), TypedAstKindIfStmtTag(),
        TypedAstKindElseStmtTag(), TypedAstKindDeferStmtTag(),
        TypedAstKindBreakStmtTag(), TypedAstKindContinueStmtTag(),
        TypedAstKindBareCallStmtTag(), TypedAstKindProgramTag(),
        TypedAstKindBodyTag(), TypedAstKindBlockTag(), TypedAstKindThenTag(),
        TypedAstKindMatchStmtTag(), TypedAstKindMatchCaseStmtTag(),
        TypedAstKindMatchDefaultStmtTag(), TypedAstKindGenericParamsTag(),
        TypedAstKindDestructureStmtTag(), TypedAstKindRoleSlotTag(),
        TypedAstKindImplAbilityTag(), TypedAstKindBindStmtTag(),
        TypedAstKindGenericConstraintsTag(), TypedAstKindActionDeclTag(),
        TypedAstKindActionRequiresTag(), TypedAstKindActionWithinTag(),
        TypedAstKindActionCausesTag(), TypedAstKindActionAuthorizedByTag(),
        TypedAstKindCallableCapsTag(), TypedAstKindCallableEffectsTag(),
        TypedAstKindZoneAuthorityTag(),
        TypedAstKindDomainRefreshTag(), TypedAstKindDomainPublishTag(),
        TypedAstKindDomainProjectionBindTag(), TypedAstKindDomainMaintainTag(),
        TypedAstKindDomainLinkTag(), TypedAstKindDomainApplyTag(),
        TypedAstKindDomainDetachTag(), TypedAstKindDomainUnlinkTag(),
        TypedAstKindDomainStateTag(), TypedAstKindRoleIncludeTag(),
        TypedAstKindIntentDeclTag(), TypedAstKindRosterDeclTag(),
        TypedAstKindDomainProjectionMapEntryTag(),
        TypedAstKindIntentModeTag(), TypedAstKindIntentRollbackTag(),
        TypedAstKindIntentRetryTag(), TypedAstKindIntentInvolvesTag(),
        TypedAstKindIntentValueTag(), TypedAstKindIntentStepTag(),
        TypedAstKindIntentSuccessTag(), TypedAstKindIntentFailureTag(),
        TypedAstKindIntentStepWhoTag(), TypedAstKindIntentStepUsingTag(),
        TypedAstKindIntentStepTransferTag(), TypedAstKindIntentStepOnTag(),
        TypedAstKindIntentStepCompensateTag(), TypedAstKindIntentStepGuardTag(),
        TypedAstKindIntentStepPostTag(),
        TypedAstKindIntentStepAuthorizedByTag(),
        TypedAstKindIntentStepExpectTag(),
        TypedAstKindIntentStepOutcomeTag(), TypedAstKindIntentReturnsTag(),
        TypedAstKindIntentStepSuccessTag(),
        TypedAstKindIntentStepFailureTag(),
        TypedAstKindIntentTerminalSuccessTag(),
        TypedAstKindIntentTerminalFailureTag(),
        TypedAstKindExternBlockTag(),
        TypedAstKindIntentStepContractProvenanceTag(),
        TypedAstKindIntentStepIntentTag(),
        TypedAstKindIntentPriorityTag(), TypedAstKindUseDeclTag(),
        TypedAstKindLifecycleDeclTag(), TypedAstKindLifecycleTransitionTag()
    ];
    return tags;
}

func TypedAstKindOwnerReady() -> Bool {
    let tags: Array<Int> = TypedAstKindTags();
    if ArrayLength(tags) != 93 {
        return false;
    }
    let i: Int = 0;
    while i < ArrayLength(tags) {
        if tags[i] != TypedAstKindUnknownTag() + i {
            return false;
        }
        let j: Int = i + 1;
        while j < ArrayLength(tags) {
            if tags[i] == tags[j] {
                return false;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return TypedAstKindKnown(TypedAstKindUnknownTag()) &&
        TypedAstKindKnown(TypedAstKindDestructureStmtTag()) &&
        TypedAstKindKnown(TypedAstKindRoleSlotTag()) &&
        TypedAstKindKnown(TypedAstKindImplAbilityTag()) &&
        TypedAstKindKnown(TypedAstKindBindStmtTag()) &&
        TypedAstKindKnown(TypedAstKindGenericConstraintsTag()) &&
        TypedAstKindKnown(TypedAstKindActionDeclTag()) &&
        TypedAstKindKnown(TypedAstKindCallableEffectsTag()) &&
        TypedAstKindKnown(TypedAstKindZoneAuthorityTag()) &&
        TypedAstKindKnown(TypedAstKindDomainStateTag()) &&
        TypedAstKindKnown(TypedAstKindRoleIncludeTag()) &&
        TypedAstKindKnown(TypedAstKindIntentDeclTag()) &&
        TypedAstKindKnown(TypedAstKindRosterDeclTag()) &&
        TypedAstKindKnown(TypedAstKindDomainProjectionMapEntryTag()) &&
        TypedAstKindKnown(TypedAstKindIntentInvolvesTag()) &&
        TypedAstKindKnown(TypedAstKindIntentStepTag()) &&
        TypedAstKindKnown(TypedAstKindIntentStepAuthorizedByTag()) &&
        TypedAstKindKnown(TypedAstKindIntentStepExpectTag()) &&
        TypedAstKindKnown(TypedAstKindIntentStepOutcomeTag()) &&
        TypedAstKindKnown(TypedAstKindIntentReturnsTag()) &&
        TypedAstKindKnown(TypedAstKindIntentStepSuccessTag()) &&
        TypedAstKindKnown(TypedAstKindIntentStepFailureTag()) &&
        TypedAstKindKnown(TypedAstKindIntentTerminalSuccessTag()) &&
        TypedAstKindKnown(TypedAstKindIntentTerminalFailureTag()) &&
        TypedAstKindKnown(TypedAstKindIntentStepContractProvenanceTag()) &&
        TypedAstKindKnown(TypedAstKindIntentStepIntentTag()) &&
        TypedAstKindKnown(TypedAstKindIntentPriorityTag()) &&
        TypedAstKindKnown(TypedAstKindUseDeclTag()) &&
        TypedAstKindKnown(TypedAstKindLifecycleDeclTag()) &&
        TypedAstKindKnown(TypedAstKindLifecycleTransitionTag()) &&
        TypedAstKindIsIntentRow(TypedAstKindIntentModeTag()) &&
        TypedAstKindIsIntentRow(TypedAstKindIntentTerminalFailureTag()) &&
        TypedAstKindIsIntentRow(
            TypedAstKindIntentStepContractProvenanceTag()
        ) &&
        TypedAstKindIsIntentRow(TypedAstKindIntentStepIntentTag()) &&
        TypedAstKindIsIntentRow(TypedAstKindIntentPriorityTag()) &&
        !TypedAstKindIsIntentRow(TypedAstKindIntentDeclTag()) &&
        TypedAstKindIsDomainTopologyDirective(
            TypedAstKindDomainRefreshTag()
        ) &&
        !TypedAstKindIsDomainTopologyDirective(
            TypedAstKindZoneAuthorityTag()
        ) &&
        TypedAstKindIsCallableDecl(TypedAstKindFuncDeclTag()) &&
        TypedAstKindIsCallableDecl(TypedAstKindActionDeclTag()) &&
        !TypedAstKindIsCallableDecl(TypedAstKindActionRequiresTag()) &&
        !TypedAstKindKnown(TypedAstKindUnknownTag() - 1) &&
        !TypedAstKindKnown(
            TypedAstKindLifecycleTransitionTag() + 1
        ) &&
        TypedAstKindKnown(TypedAstKindExternBlockTag()) &&
        !TypedAstKindIsCallableDecl(TypedAstKindExternBlockTag()) &&
        TypedAstNominalSubkindName(TypedAstNominalSubkindStruct()) ==
            "struct" &&
        TypedAstNominalSubkindName(TypedAstNominalSubkindClass()) == "class" &&
        TypedAstNominalSubkindName(TypedAstNominalSubkindSubject()) ==
            "subject" &&
        TypedAstNominalSubkindName(TypedAstNominalSubkindObject()) ==
            "object" &&
        TypedAstNominalSubkindName(TypedAstNominalSubkindTObject()) ==
            "tobject" &&
        TypedAstNominalSubkindName(TypedAstNominalSubkindVessel()) ==
            "vessel" &&
        TypedAstNominalSubkindName(TypedAstNominalSubkindZone()) == "zone" &&
        TypedAstNominalSubkindName(TypedAstNominalSubkindWorld()) == "world" &&
        TypedAstNominalSubkindName(TypedAstNominalSubkindParty()) == "party" &&
        TypedAstNominalSubkindName(TypedAstNominalSubkindEffect()) ==
            "effect" &&
        TypedAstNominalSubkindName(TypedAstNominalSubkindRelation()) ==
            "relation" &&
        TypedAstNominalSubkindName(TypedAstNominalSubkindNone()) == "" &&
        TypedAstCallStatementKindForCallee("Log") ==
            TypedAstKindLogStmtTag() &&
        TypedAstCallStatementKindForCallee("ArrayPush") ==
            TypedAstKindArrayPushStmtTag() &&
        TypedAstCallStatementKindForCallee("Mutate") ==
            TypedAstKindBareCallStmtTag() &&
        TypedAstCallStatementKindForCallee("") ==
            TypedAstKindUnknownTag();
}
