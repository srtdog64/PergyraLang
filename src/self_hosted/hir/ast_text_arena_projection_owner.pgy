// Shared compact AST-text inventory to typed AstArena projection.

import "typed_ast_arena_owner.pgy";
import "ast_text_inventory_owner.pgy";
import "ast_expression_graph_owner.pgy";
import "ast_source_module_fact_owner.pgy";

func CodegenAstTextArenaAtomFor(node: CodegenAstTextNode) -> String {
    if node.name != "" {
        return node.name;
    }
    return node.payload;
}

func CodegenAstTextParentRows(
    nodes: Array<CodegenAstTextNode>,
    count: Int
) -> Array<Int> {
    let parents: Array<Int> = [];
    let active: Array<Int> = [];
    let i: Int = 0;
    while i < count {
        while ArrayLength(active) > 0 &&
            nodes[active[ArrayLength(active) - 1]].indent >= nodes[i].indent {
            ArrayPop(active);
        }
        if ArrayLength(active) == 0 {
            ArrayPush(parents, TypedAstNoParentRow());
        } else {
            ArrayPush(parents, active[ArrayLength(active) - 1]);
        }
        ArrayPush(active, i);
        i = i + 1;
    }
    return parents;
}

func CodegenAstTextNominalSubkindFor(node: CodegenAstTextNode) -> Int {
    if node.kind != TypedAstKindNominalDeclTag() {
        return TypedAstNominalSubkindNone();
    }
    if StartsWith(node.text, "Struct: ") {
        return TypedAstNominalSubkindStruct();
    }
    if StartsWith(node.text, "Class: ") {
        return TypedAstNominalSubkindClass();
    }
    if StartsWith(node.text, "Subject: ") {
        return TypedAstNominalSubkindSubject();
    }
    if StartsWith(node.text, "Object: ") {
        return TypedAstNominalSubkindObject();
    }
    if StartsWith(node.text, "TObject: ") {
        return TypedAstNominalSubkindTObject();
    }
    if StartsWith(node.text, "Vessel: ") {
        return TypedAstNominalSubkindVessel();
    }
    if StartsWith(node.text, "Zone: ") {
        return TypedAstNominalSubkindZone();
    }
    if StartsWith(node.text, "World: ") {
        return TypedAstNominalSubkindWorld();
    }
    if StartsWith(node.text, "Party: ") {
        return TypedAstNominalSubkindParty();
    }
    if StartsWith(node.text, "Effect: ") {
        return TypedAstNominalSubkindEffect();
    }
    if StartsWith(node.text, "Relation: ") {
        return TypedAstNominalSubkindRelation();
    }
    return TypedAstNominalSubkindNone();
}

func CodegenAstTextChildCounts(
    parents: Array<Int>,
    count: Int
) -> Array<Int> {
    let child_counts: Array<Int> = [];
    let i: Int = 0;
    while i < count {
        ArrayPush(child_counts, 0);
        i = i + 1;
    }
    i = 0;
    while i < count {
        let parent: Int = parents[i];
        if parent != TypedAstNoParentRow() {
            ArraySet(child_counts, parent, child_counts[parent] + 1);
        }
        i = i + 1;
    }
    return child_counts;
}

func CodegenAstTextFirstChildren(
    child_counts: Array<Int>
) -> Array<Int> {
    let first_children: Array<Int> = [];
    let next: Int = 0;
    let i: Int = 0;
    while i < ArrayLength(child_counts) {
        ArrayPush(first_children, next);
        next = next + child_counts[i];
        i = i + 1;
    }
    return first_children;
}

func CodegenAstTextChildren(
    parents: Array<Int>,
    first_children: Array<Int>,
    child_counts: Array<Int>
) -> Array<Int> {
    let children: Array<Int> = [];
    let offsets: Array<Int> = [];
    let total: Int = 0;
    let i: Int = 0;
    while i < ArrayLength(child_counts) {
        ArrayPush(offsets, first_children[i]);
        total = total + child_counts[i];
        i = i + 1;
    }
    i = 0;
    while i < total {
        ArrayPush(children, 0);
        i = i + 1;
    }
    i = 0;
    while i < ArrayLength(parents) {
        let parent: Int = parents[i];
        if parent != TypedAstNoParentRow() {
            let offset: Int = offsets[parent];
            ArraySet(children, offset, i);
            ArraySet(offsets, parent, offset + 1);
        }
        i = i + 1;
    }
    return children;
}

func CodegenAstTextTypedArenaFromNodes(nodes: Array<CodegenAstTextNode>, count: Int) -> AstArena {
    let kinds: Array<Int> = [];
    let nominal_subkinds: Array<Int> = [];
    let atoms: Array<Int> = [];
    let has_atoms: Array<Int> = [];
    let type_names: Array<Int> = [];
    let has_type_names: Array<Int> = [];
    let values: Array<Int> = [];
    let has_values: Array<Int> = [];
    let aux_values: Array<Int> = [];
    let has_aux_values: Array<Int> = [];
    let modes: Array<Int> = [];
    let parents: Array<Int> = CodegenAstTextParentRows(nodes, count);
    let child_counts: Array<Int> = CodegenAstTextChildCounts(parents, count);
    let first_children: Array<Int> = CodegenAstTextFirstChildren(child_counts);
    let children: Array<Int> = CodegenAstTextChildren(
        parents, first_children, child_counts
    );
    let indents: Array<Int> = [];
    let provenance_texts: Array<String> = [];
    let atom_table: Array<String> = [""];
    let i: Int = 0;
    while i < count {
        ArrayPush(kinds, nodes[i].kind);
        ArrayPush(
            nominal_subkinds, CodegenAstTextNominalSubkindFor(nodes[i])
        );
        let atom_text: String = CodegenAstTextArenaAtomFor(nodes[i]);
        if atom_text == "" {
            ArrayPush(atoms, 0);
            ArrayPush(has_atoms, 0);
        } else {
            ArrayPush(atom_table, atom_text);
            ArrayPush(atoms, ArrayLength(atom_table) - 1);
            ArrayPush(has_atoms, 1);
        }
        if nodes[i].type_name == "" {
            ArrayPush(type_names, 0);
            ArrayPush(has_type_names, 0);
        } else {
            ArrayPush(atom_table, nodes[i].type_name);
            ArrayPush(type_names, ArrayLength(atom_table) - 1);
            ArrayPush(has_type_names, 1);
        }
        if nodes[i].value == "" {
            ArrayPush(values, 0);
            ArrayPush(has_values, 0);
        } else {
            ArrayPush(atom_table, nodes[i].value);
            ArrayPush(values, ArrayLength(atom_table) - 1);
            ArrayPush(has_values, 1);
        }
        if nodes[i].aux_value == "" {
            ArrayPush(aux_values, 0);
            ArrayPush(has_aux_values, 0);
        } else {
            ArrayPush(atom_table, nodes[i].aux_value);
            ArrayPush(aux_values, ArrayLength(atom_table) - 1);
            ArrayPush(has_aux_values, 1);
        }
        ArrayPush(modes, nodes[i].mode);
        ArrayPush(indents, nodes[i].indent);
        ArrayPush(provenance_texts, nodes[i].text);
        i = i + 1;
    }
    return AstArena(kinds, nominal_subkinds, atoms, has_atoms,
        type_names, has_type_names,
        values, has_values, aux_values, has_aux_values, modes,
        first_children, child_counts, parents, indents, provenance_texts,
        children, atom_table);
}

func CodegenAstTextTypedArenaProjectionReady(nodes: Array<CodegenAstTextNode>, count: Int) -> Bool {
    let arena: AstArena = CodegenAstTextTypedArenaFromNodes(nodes, count);
    let expected_parents: Array<Int> = CodegenAstTextParentRows(nodes, count);
    if !TypedAstArenaParallelRowsReady(arena) || TypedAstArenaNodeCount(arena) != count {
        return false;
    }
    let i: Int = 0;
    while i < count {
        let kind: Option<Int> = TypedAstArenaNodeKind(arena, i);
        if !IsSome(kind) || UnwrapOption(kind) != nodes[i].kind {
            return false;
        }
        let expected_subkind: Int = CodegenAstTextNominalSubkindFor(nodes[i]);
        let subkind: Option<Int> = TypedAstArenaNominalSubkind(arena, i);
        if expected_subkind == TypedAstNominalSubkindNone() &&
            IsSome(subkind) {
            return false;
        }
        if expected_subkind != TypedAstNominalSubkindNone() &&
            (!IsSome(subkind) || UnwrapOption(subkind) != expected_subkind) {
            return false;
        }
        let parent: Option<Int> = TypedAstArenaParentId(arena, i);
        let expected_parent_row: Int = expected_parents[i];
        if expected_parent_row == TypedAstNoParentRow() && IsSome(parent) {
            return false;
        }
        if expected_parent_row != TypedAstNoParentRow() &&
            (!IsSome(parent) || UnwrapOption(parent) != expected_parent_row) {
            return false;
        }
        let indent: Option<Int> = TypedAstArenaIndent(arena, i);
        if !IsSome(indent) || UnwrapOption(indent) != nodes[i].indent {
            return false;
        }
        let provenance: Option<String> = TypedAstArenaProvenanceText(arena, i);
        if !IsSome(provenance) || UnwrapOption(provenance) != nodes[i].text {
            return false;
        }
        let atom_text: String = CodegenAstTextArenaAtomFor(nodes[i]);
        let atom: Option<String> = TypedAstArenaAtomText(arena, i);
        if atom_text == "" && IsSome(atom) {
            return false;
        }
        if atom_text != "" && (!IsSome(atom) || UnwrapOption(atom) != atom_text) {
            return false;
        }
        let type_name: Option<String> = TypedAstArenaTypeName(arena, i);
        if nodes[i].type_name == "" && IsSome(type_name) {
            return false;
        }
        if nodes[i].type_name != "" && (!IsSome(type_name) || UnwrapOption(type_name) != nodes[i].type_name) {
            return false;
        }
        let value: Option<String> = TypedAstArenaValueText(arena, i);
        if nodes[i].value == "" && IsSome(value) {
            return false;
        }
        if nodes[i].value != "" && (!IsSome(value) || UnwrapOption(value) != nodes[i].value) {
            return false;
        }
        let aux_value: Option<String> = TypedAstArenaAuxValueText(arena, i);
        if nodes[i].aux_value == "" && IsSome(aux_value) {
            return false;
        }
        if nodes[i].aux_value != "" && (!IsSome(aux_value) || UnwrapOption(aux_value) != nodes[i].aux_value) {
            return false;
        }
        let mode: Option<Int> = TypedAstArenaMode(arena, i);
        if !IsSome(mode) || UnwrapOption(mode) != nodes[i].mode {
            return false;
        }
        i = i + 1;
    }
    if count > 1 && !IsSome(TypedAstArenaChildAt(arena, 0, 0)) {
        return false;
    }
    return true;
}

struct AstTreeArtifact {
    tree_text: String;
    arena: AstArena;
    count: Int;
    expression_graphs: AstExpressionGraphRows;
    source_modules: AstSourceModuleFacts;
    identity_digest: Int;
}

func AstTreeArtifactPayloadSchema() -> String {
    return "pgy.selfhost.ast-tree-artifact.v5";
}

// Stable producer-time identity for the immutable tree-text epoch.  Semantic
// consumers compare this fixed-size value; they must not rebuild whole fact
// families merely to prove that an admitted analysis belongs to this artifact.
func AstTreeArtifactIdentityHashString(
    hash: Long, value: String, modulus: Long
) -> Long {
    let out: Long = (hash * 131L + (StringLength(value) as Long)) % modulus;
    let i: Int = 0;
    let length: Int = StringLength(value);
    while i < length {
        out = (out * 131L +
            (CharCode(value, length, i) as Long)) % modulus;
        i = i + 1;
    }
    return out;
}

func AstTreeArtifactIdentityHashInt(
    hash: Long, value: Int, modulus: Long
) -> Long {
    return (hash * 131L + ((value + 4096) as Long)) % modulus;
}

func AstTreeArtifactIdentityDigest(
    tree_text: String,
    node_count: Int,
    ref expression_graphs: AstExpressionGraphRows,
    ref source_modules: AstSourceModuleFacts
) -> Int {
    let modulus: Long = 268435456L;
    if !source_modules.ok ||
        ArrayLength(source_modules.declaration_node_ids) !=
            ArrayLength(source_modules.module_paths) ||
        (!source_modules.known &&
            (ArrayLength(source_modules.declaration_node_ids) != 0 ||
             ArrayLength(source_modules.module_paths) != 0)) ||
        ArrayLength(expression_graphs.root_owner_kinds) !=
            ArrayLength(expression_graphs.roots) ||
        ArrayLength(expression_graphs.root_lanes) !=
            ArrayLength(expression_graphs.roots) ||
        !ProgramExpressionGraphStorageRowsAligned(expression_graphs.arena) {
        return 0;
    }
    let hash: Long = AstTreeArtifactIdentityHashInt(
        17L, node_count, modulus
    );
    hash = AstTreeArtifactIdentityHashString(hash, tree_text, modulus);
    let source_known: Int = 0;
    if source_modules.known { source_known = 1; }
    hash = AstTreeArtifactIdentityHashInt(hash, source_known, modulus);
    hash = AstTreeArtifactIdentityHashInt(
        hash, ArrayLength(source_modules.declaration_node_ids), modulus
    );
    let source_row: Int = 0;
    while source_row < ArrayLength(source_modules.declaration_node_ids) {
        hash = AstTreeArtifactIdentityHashInt(
            hash, source_modules.declaration_node_ids[source_row], modulus
        );
        hash = AstTreeArtifactIdentityHashString(
            hash, source_modules.module_paths[source_row], modulus
        );
        source_row = source_row + 1;
    }
    let graph_ok: Int = 0;
    if expression_graphs.ok { graph_ok = 1; }
    hash = AstTreeArtifactIdentityHashInt(hash, graph_ok, modulus);
    hash = AstTreeArtifactIdentityHashInt(
        hash, ArrayLength(expression_graphs.roots), modulus
    );
    let i: Int = 0;
    while i < ArrayLength(expression_graphs.roots) {
        hash = AstTreeArtifactIdentityHashInt(
            hash, expression_graphs.root_owner_kinds[i], modulus
        );
        hash = AstTreeArtifactIdentityHashInt(
            hash, expression_graphs.root_lanes[i], modulus
        );
        hash = AstTreeArtifactIdentityHashInt(
            hash, expression_graphs.roots[i], modulus
        );
        i = i + 1;
    }
    hash = AstTreeArtifactIdentityHashInt(
        hash, AstExpressionArenaNodeCount(expression_graphs.arena), modulus
    );
    let node: Int = 0;
    while node < AstExpressionArenaNodeCount(expression_graphs.arena) {
        hash = AstTreeArtifactIdentityHashInt(
            hash, expression_graphs.arena.node_kinds[node], modulus
        );
        hash = AstTreeArtifactIdentityHashString(
            hash, expression_graphs.arena.node_texts[node], modulus
        );
        hash = AstTreeArtifactIdentityHashInt(
            hash, expression_graphs.arena.left_children[node], modulus
        );
        hash = AstTreeArtifactIdentityHashInt(
            hash, expression_graphs.arena.right_children[node], modulus
        );
        node = node + 1;
    }
    return (1073741824L + hash) as Int;
}

func AstTreeArtifactFromText(tree_text: String) -> AstTreeArtifact {
    let nodes: Array<CodegenAstTextNode> = [];
    let count_box: Array<Int> = [0];
    CodegenAstTextNodeInventory(tree_text, nodes, count_box);
    let count: Int = count_box[0];
    let arena: AstArena = CodegenAstTextTypedArenaFromNodes(nodes, count);
    let expression_graphs: AstExpressionGraphRows =
        AstExpressionGraphRowsEmpty();
    let source_modules: AstSourceModuleFacts = AstSourceModuleFactsUnknown();
    return AstTreeArtifact(
        tree_text, arena, count, expression_graphs, source_modules,
        AstTreeArtifactIdentityDigest(
            tree_text, count, expression_graphs, source_modules
        )
    );
}

func AstTreeArtifactReady(artifact: AstTreeArtifact) -> Bool {
    return TypedAstArenaParallelRowsReady(artifact.arena) &&
        TypedAstArenaNodeCount(artifact.arena) == artifact.count &&
        AstExpressionGraphRowsReady(artifact.expression_graphs) &&
        AstSourceModuleFactsReady(artifact.arena, artifact.source_modules) &&
        artifact.identity_digest > 0;
}

func AstTreeArtifactPayloadContractReady() -> Bool {
    let artifact: AstTreeArtifact = AstTreeArtifactFromText("Program:\n");
    let root_kind: Option<Int> = TypedAstArenaNodeKind(artifact.arena, 0);
    let no_owner_kinds: Array<Int> = [];
    let one_lane: Array<Int> = [1];
    let one_root: Array<Int> = [0];
    let invalid_root_rows: AstExpressionGraphRows = AstExpressionGraphRows(
        true, no_owner_kinds, one_lane, one_root, AstExpressionArenaEmpty()
    );
    let one_kind: Array<Int> = [1];
    let no_texts: Array<String> = [];
    let no_children: Array<Int> = [];
    let invalid_arena: AstExpressionArena = AstExpressionArena(
        one_kind, no_texts, no_children, no_children
    );
    let no_lanes: Array<Int> = [];
    let no_roots: Array<Int> = [];
    let invalid_arena_rows: AstExpressionGraphRows = AstExpressionGraphRows(
        true, no_owner_kinds, no_lanes, no_roots, invalid_arena
    );
    return AstTreeArtifactPayloadSchema() == "pgy.selfhost.ast-tree-artifact.v5" &&
        AstTreeArtifactReady(artifact) && artifact.count == 1 &&
        artifact.identity_digest == AstTreeArtifactIdentityDigest(
            artifact.tree_text, artifact.count, artifact.expression_graphs,
            artifact.source_modules
        ) &&
        AstTreeArtifactIdentityDigest(
            "Program:\n", 1, invalid_root_rows, artifact.source_modules
        ) == 0 &&
        AstTreeArtifactIdentityDigest(
            "Program:\n", 1, invalid_arena_rows, artifact.source_modules
        ) == 0 &&
        IsSome(root_kind) && UnwrapOption(root_kind) == TypedAstTextKindOf("Program:");
}
