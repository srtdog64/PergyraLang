// src/self_hosted/hir/ast_text_inventory_owner.pgy
//
// Owns the transitional AST-text line inventory consumed by self-host C emit.

import "ast_text_scan_owner.pgy";
import "ast_text_row_fact_owner.pgy";
import "ast_node_kind_owner.pgy";
import "../lib/nominal_field_kind_owner.pgy";

struct CodegenAstTextNode {
    let indent: Int;
    let text: String;
    let kind: Int;
    let payload: String;
    let aux_payload: String;
    let name: String;
    let type_name: String;
    let value: String;
    let aux_value: String;
    let mode: Int;
}

func TypedAstTextKindOf(text: String) -> Int {
    // Measured once: every prefix check below reads within it.
    let text_extent: Int = StringLength(text);
    if text == "Program:" {
        return TypedAstKindProgramTag();
    }
    if text == "Parameters:" {
        return TypedAstKindParametersTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Generic params:") {
        return TypedAstKindGenericParamsTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Constraints:") {
        return TypedAstKindGenericConstraintsTag();
    }
    if text == "Body:" {
        return TypedAstKindBodyTag();
    }
    if text == "Block:" {
        return TypedAstKindBlockTag();
    }
    if text == "Then:" {
        return TypedAstKindThenTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Returns:") {
        return TypedAstKindReturnsTag();
    }
    if text == "Fields:" {
        return TypedAstKindFieldsHeaderTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Field:") || SubStartsWithLen(text, text_extent, 0, "Shared:") ||
        SubStartsWithLen(text, text_extent, 0, "SubjectSlot:") ||
        SubStartsWithLen(text, text_extent, 0, "BindingSlot:") || SubStartsWithLen(text, text_extent, 0, "ObjectSlot:") ||
        SubStartsWithLen(text, text_extent, 0, "TObjectSlot:") ||
        SubStartsWithLen(text, text_extent, 0, "EffectSlot:") ||
        SubStartsWithLen(text, text_extent, 0, "RelationSlot:") || SubStartsWithLen(text, text_extent, 0, "EffectPool:") ||
        SubStartsWithLen(text, text_extent, 0, "RelationPool:") || SubStartsWithLen(text, text_extent, 0, "SystemicSlot:") ||
        SubStartsWithLen(text, text_extent, 0, "WorldSystemic:") || SubStartsWithLen(text, text_extent, 0, "WorldZone:") {
        return TypedAstKindFieldTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "RoleSlot:") {
        return TypedAstKindRoleSlotTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Impl ability:") {
        return TypedAstKindImplAbilityTag();
    }
    if text == "Override" {
        return TypedAstKindOverrideFuncTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Include role ") {
        return TypedAstKindRoleIncludeTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Function:") {
        return TypedAstKindFuncDeclTag();
    }
    if text == "AsyncBlock:" {
        return TypedAstKindAsyncBlockTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Action:") {
        return TypedAstKindActionDeclTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Requires:") {
        return TypedAstKindActionRequiresTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Within:") {
        return TypedAstKindActionWithinTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Causes:") {
        return TypedAstKindActionCausesTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Authorized by:") {
        return TypedAstKindActionAuthorizedByTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Caps:") {
        return TypedAstKindCallableCapsTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Effects:") {
        return TypedAstKindCallableEffectsTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Authority:") {
        return TypedAstKindZoneAuthorityTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Refresh:") { return TypedAstKindDomainRefreshTag(); }
    if SubStartsWithLen(text, text_extent, 0, "Publish:") { return TypedAstKindDomainPublishTag(); }
    if SubStartsWithLen(text, text_extent, 0, "Bind:") {
        return TypedAstKindDomainProjectionBindTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "ProjectionMap:") {
        return TypedAstKindDomainProjectionMapEntryTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Maintain:") { return TypedAstKindDomainMaintainTag(); }
    if SubStartsWithLen(text, text_extent, 0, "Link:") { return TypedAstKindDomainLinkTag(); }
    if SubStartsWithLen(text, text_extent, 0, "Apply:") { return TypedAstKindDomainApplyTag(); }
    if SubStartsWithLen(text, text_extent, 0, "Detach:") { return TypedAstKindDomainDetachTag(); }
    if SubStartsWithLen(text, text_extent, 0, "Unlink:") { return TypedAstKindDomainUnlinkTag(); }
    if SubStartsWithLen(text, text_extent, 0, "State:") { return TypedAstKindDomainStateTag(); }
    if SubStartsWithLen(text, text_extent, 0, "Role:") {
        return TypedAstKindRoleDeclTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "IntentMode:") {
        return TypedAstKindIntentModeTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "IntentRollback:") {
        return TypedAstKindIntentRollbackTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "IntentPriority:") {
        return TypedAstKindIntentPriorityTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "IntentRetry:") {
        return TypedAstKindIntentRetryTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "IntentInvolves:") {
        return TypedAstKindIntentInvolvesTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "IntentValue:") {
        return TypedAstKindIntentValueTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "IntentStep:") {
        return TypedAstKindIntentStepTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "IntentSuccess:") {
        return TypedAstKindIntentSuccessTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "IntentFailure:") {
        return TypedAstKindIntentFailureTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "IntentReturns:") {
        return TypedAstKindIntentReturnsTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "IntentStepSuccess:") {
        return TypedAstKindIntentStepSuccessTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "IntentStepFailure:") {
        return TypedAstKindIntentStepFailureTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "IntentTerminalSuccess:") {
        return TypedAstKindIntentTerminalSuccessTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "IntentTerminalFailure:") {
        return TypedAstKindIntentTerminalFailureTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Who:") {
        return TypedAstKindIntentStepWhoTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Using:") {
        return TypedAstKindIntentStepUsingTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Transfer:") {
        return TypedAstKindIntentStepTransferTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "On:") {
        return TypedAstKindIntentStepOnTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Outcome:") {
        return TypedAstKindIntentStepOutcomeTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Compensate:") {
        return TypedAstKindIntentStepCompensateTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Guard:") {
        return TypedAstKindIntentStepGuardTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Pre:") {
        return TypedAstKindIntentStepPreTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Invariant:") {
        return TypedAstKindIntentStepInvariantTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Post:") {
        return TypedAstKindIntentStepPostTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "AuthorizedBy:") {
        return TypedAstKindIntentStepAuthorizedByTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Expect:") {
        return TypedAstKindIntentStepExpectTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "ContractProvenance:") {
        return TypedAstKindIntentStepContractProvenanceTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Intent:") {
        return TypedAstKindIntentDeclTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Roster:") {
        return TypedAstKindRosterDeclTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Struct:") || SubStartsWithLen(text, text_extent, 0, "Class:") || SubStartsWithLen(text, text_extent, 0, "Subject:") ||
        SubStartsWithLen(text, text_extent, 0, "Object:") || SubStartsWithLen(text, text_extent, 0, "TObject:") ||
        SubStartsWithLen(text, text_extent, 0, "Vessel:") || SubStartsWithLen(text, text_extent, 0, "Zone:") ||
        SubStartsWithLen(text, text_extent, 0, "World:") || SubStartsWithLen(text, text_extent, 0, "Party:") ||
        SubStartsWithLen(text, text_extent, 0, "Effect:") || SubStartsWithLen(text, text_extent, 0, "Relation:") {
        return TypedAstKindNominalDeclTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Enum:") {
        return TypedAstKindEnumDeclTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Event:") {
        return TypedAstKindEventDeclTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Ability:") {
        return TypedAstKindAbilityDeclTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Extern Block (") {
        return TypedAstKindExternBlockTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Use: ") {
        return TypedAstKindUseDeclTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Lifecycle: ") {
        return TypedAstKindLifecycleDeclTag();
    }
    if text == "Return" {
        return TypedAstKindBareReturnStmtTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Return:") {
        return TypedAstKindValueReturnStmtTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Let: ") {
        return TypedAstKindLetStmtTag();
    }
    if text == "AST node type 6" {
        return TypedAstKindDestructureStmtTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Assign: ") {
        return TypedAstKindAssignStmtTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "BindStmt: ") {
        return TypedAstKindBindStmtTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "ChannelSend: ") {
        return TypedAstKindChannelSendStmtTag();
    }
    if text == "Parallel:" || text == "Parallel On:" {
        return TypedAstKindParallelBlockTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "With slot<") {
        return TypedAstKindWithStmtTag();
    }
    if text == "TransactionBlock:" {
        return TypedAstKindTransactionBlockTag();
    }
    if text == "UnsafeBlock:" { return TypedAstKindUnsafeBlockTag(); }
    if text == "Fail:" {
        return TypedAstKindFailStmtTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "EventSubscribe: ") {
        return TypedAstKindEventSubscribeStmtTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "EventUnsubscribe: ") {
        return TypedAstKindEventUnsubscribeStmtTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "For: ") {
        return TypedAstKindForStmtTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "While: ") {
        return TypedAstKindWhileStmtTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "If: ") {
        return TypedAstKindIfStmtTag();
    }
    if text == "Else:" {
        return TypedAstKindElseStmtTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Match: ") {
        return TypedAstKindMatchStmtTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Case: ") {
        return TypedAstKindMatchCaseStmtTag();
    }
    if text == "Default:" {
        return TypedAstKindMatchDefaultStmtTag();
    }
    if text == "Defer:" {
        return TypedAstKindDeferStmtTag();
    }
    if text == "Break" {
        return TypedAstKindBreakStmtTag();
    }
    if text == "Continue" {
        return TypedAstKindContinueStmtTag();
    }
    if SubStartsWithLen(text, text_extent, 0, "Call: ") {
        return TypedAstKindBareCallStmtTag();
    }
    if IsSingleCall(text) {
        let open: Int = StringIndexOf(text, "(");
        return TypedAstCallStatementKindForCallee(
            Substring(text, 0, open)
        );
    }
    return TypedAstKindUnknownTag();
}

func CodegenAstTextPayloadFor(text: String, kind: Int) -> String {
    if kind == TypedAstKindFuncDeclTag() {
        return Substring(text, 10, StringLength(text) - 10);
    }
    if kind == TypedAstKindActionDeclTag() {
        return Substring(text, 8, StringLength(text) - 8);
    }
    if kind == TypedAstKindReturnsTag() {
        return StringTrim(Substring(text, 8, StringLength(text) - 8));
    }
    if kind == TypedAstKindGenericParamsTag() {
        return StringTrim(Substring(text, 15, StringLength(text) - 15));
    }
    if kind == TypedAstKindGenericConstraintsTag() {
        return StringTrim(Substring(text, 12, StringLength(text) - 12));
    }
    if kind == TypedAstKindActionRequiresTag() {
        return StringTrim(Substring(text, 9, StringLength(text) - 9));
    }
    if kind == TypedAstKindActionWithinTag() {
        return StringTrim(Substring(text, 7, StringLength(text) - 7));
    }
    if kind == TypedAstKindActionCausesTag() {
        return StringTrim(Substring(text, 7, StringLength(text) - 7));
    }
    if kind == TypedAstKindActionAuthorizedByTag() {
        return StringTrim(Substring(text, 14, StringLength(text) - 14));
    }
    if kind == TypedAstKindCallableCapsTag() {
        return StringTrim(Substring(text, 5, StringLength(text) - 5));
    }
    if kind == TypedAstKindCallableEffectsTag() {
        return StringTrim(Substring(text, 8, StringLength(text) - 8));
    }
    if kind == TypedAstKindZoneAuthorityTag() {
        return StringTrim(Substring(text, 10, StringLength(text) - 10));
    }
    if TypedAstKindIsDomainTopologyDirective(kind) {
        let colon: Int = StringIndexOf(text, ":");
        if colon >= 0 {
            return StringTrim(Substring(
                text, colon + 1, StringLength(text) - colon - 1
            ));
        }
        return "";
    }
    if kind == TypedAstKindDomainProjectionMapEntryTag() {
        return StringTrim(Substring(
            text, 14, StringLength(text) - 14
        ));
    }
    if kind == TypedAstKindFieldTag() {
        if StartsWith(text, "Field: ") {
            return Substring(text, 7, StringLength(text) - 7);
        }
        let labels: Array<String> = [
            "Shared: ", "SubjectSlot: ", "BindingSlot: ", "ObjectSlot: ",
            "TObjectSlot: ",
            "EffectSlot: ", "RelationSlot: ", "EffectPool: ",
            "RelationPool: ", "SystemicSlot: ", "WorldSystemic: ",
            "WorldZone: "
        ];
        let label_i: Int = 0;
        while label_i < ArrayLength(labels) {
            if StartsWith(text, labels[label_i]) {
                return Substring(
                    text, StringLength(labels[label_i]),
                    StringLength(text) - StringLength(labels[label_i])
                );
            }
            label_i = label_i + 1;
        }
        return text;
    }
    if kind == TypedAstKindRoleSlotTag() {
        return Substring(text, 10, StringLength(text) - 10);
    }
    if kind == TypedAstKindImplAbilityTag() {
        return StringTrim(Substring(text, 13, StringLength(text) - 13));
    }
    if kind == TypedAstKindRoleIncludeTag() {
        return StringTrim(Substring(text, 13, StringLength(text) - 13));
    }
    if kind == TypedAstKindParamTag() {
        return text;
    }
    if kind == TypedAstKindRoleDeclTag() {
        return Substring(text, 6, StringLength(text) - 6);
    }
    if kind == TypedAstKindIntentTerminalSuccessTag() ||
        kind == TypedAstKindIntentTerminalFailureTag() {
        let arrow: Int = StringIndexOf(text, " => ");
        if arrow >= 0 {
            return StringTrim(Substring(
                text, arrow + 4, StringLength(text) - arrow - 4
            ));
        }
        return "";
    }
    if TypedAstKindIsIntentRow(kind) {
        let colon: Int = StringIndexOf(text, ":");
        if colon >= 0 {
            return StringTrim(Substring(
                text, colon + 1, StringLength(text) - colon - 1
            ));
        }
        return "";
    }
    if kind == TypedAstKindIntentDeclTag() {
        return Substring(text, 8, StringLength(text) - 8);
    }
    if kind == TypedAstKindRosterDeclTag() {
        return Substring(text, 8, StringLength(text) - 8);
    }
    if kind == TypedAstKindAbilityDeclTag() {
        return Substring(text, 9, StringLength(text) - 9);
    }
    if kind == TypedAstKindExternBlockTag() {
        // `Extern Block (ABI):` -- the payload is the ABI name alone.
        let open: Int = StringIndexOf(text, "(");
        let close: Int = StringIndexOf(text, ")");
        if open >= 0 && close > open + 1 {
            return Substring(text, open + 1, close - open - 1);
        }
        return "";
    }
    if kind == TypedAstKindUseDeclTag() {
        return StringTrim(Substring(text, 4, StringLength(text) - 4));
    }
    if kind == TypedAstKindLifecycleDeclTag() {
        return StringTrim(Substring(text, 10, StringLength(text) - 10));
    }
    if kind == TypedAstKindLifecycleTransitionTag() {
        return text;
    }
    if kind == TypedAstKindNominalDeclTag() {
        if StartsWith(text, "Struct: ") {
            return Substring(text, 8, StringLength(text) - 8);
        }
        if StartsWith(text, "Class: ") {
            return Substring(text, 7, StringLength(text) - 7);
        }
        if StartsWith(text, "Subject: ") {
            return Substring(text, 9, StringLength(text) - 9);
        }
        if StartsWith(text, "Vessel: ") {
            return Substring(text, 8, StringLength(text) - 8);
        }
        if StartsWith(text, "Object: ") {
            return Substring(text, 8, StringLength(text) - 8);
        }
        if StartsWith(text, "TObject: ") {
            return Substring(text, 9, StringLength(text) - 9);
        }
        if StartsWith(text, "Zone: ") {
            return Substring(text, 6, StringLength(text) - 6);
        }
        if StartsWith(text, "World: ") {
            return Substring(text, 7, StringLength(text) - 7);
        }
        if StartsWith(text, "Party: ") {
            return Substring(text, 7, StringLength(text) - 7);
        }
        if StartsWith(text, "Effect: ") {
            return Substring(text, 8, StringLength(text) - 8);
        }
        if StartsWith(text, "Relation: ") {
            return Substring(text, 10, StringLength(text) - 10);
        }
    }
    if kind == TypedAstKindEnumDeclTag() {
        let brace: Int = StringIndexOf(text, " { ");
        if brace >= 0 {
            return Substring(text, 6, brace - 6);
        }
    }
    if kind == TypedAstKindLogStmtTag() {
        let n: Int = StringLength(text);
        if CodegenCharCodeAt(text, n, n, n - 1) == 41 {
            return StringTrim(Substring(text, 4, StringLength(text) - 5));
        }
    }
    if kind == TypedAstKindValueReturnStmtTag() {
        return StringTrim(Substring(text, 7, StringLength(text) - 7));
    }
    if kind == TypedAstKindArrayPopStmtTag() {
        let n: Int = StringLength(text);
        if CodegenCharCodeAt(text, n, n, n - 1) == 41 {
            return StringTrim(Substring(text, 9, StringLength(text) - 10));
        }
    }
    if kind == TypedAstKindExitStmtTag() {
        let n: Int = StringLength(text);
        if CodegenCharCodeAt(text, n, n, n - 1) == 41 {
            return StringTrim(Substring(text, 5, StringLength(text) - 6));
        }
    }
    if kind == TypedAstKindArraySetStmtTag() {
        let n: Int = StringLength(text);
        if CodegenCharCodeAt(text, n, n, n - 1) == 41 {
            return Substring(text, 9, StringLength(text) - 10);
        }
    }
    if kind == TypedAstKindArrayPushStmtTag() {
        let n: Int = StringLength(text);
        if CodegenCharCodeAt(text, n, n, n - 1) == 41 {
            return Substring(text, 10, StringLength(text) - 11);
        }
    }
    if kind == TypedAstKindLetStmtTag() {
        return Substring(text, 5, StringLength(text) - 5);
    }
    if kind == TypedAstKindAssignStmtTag() {
        return Substring(text, 8, StringLength(text) - 8);
    }
    if kind == TypedAstKindBindStmtTag() {
        return Substring(text, 10, StringLength(text) - 10);
    }
    if kind == TypedAstKindForStmtTag() {
        return Substring(text, 5, StringLength(text) - 5);
    }
    if kind == TypedAstKindWhileStmtTag() {
        return Substring(text, 7, StringLength(text) - 7);
    }
    if kind == TypedAstKindIfStmtTag() {
        return Substring(text, 4, StringLength(text) - 4);
    }
    if kind == TypedAstKindMatchStmtTag() {
        return Substring(text, 7, StringLength(text) - 7);
    }
    if kind == TypedAstKindMatchCaseStmtTag() {
        return Substring(text, 6, StringLength(text) - 6);
    }
    if kind == TypedAstKindBareCallStmtTag() {
        if StartsWith(text, "Call: ") {
            return Substring(text, 6, StringLength(text) - 6);
        }
        return text;
    }
    return "";
}

func CodegenAstTextAuxPayloadFor(text: String, kind: Int) -> String {
    if kind == TypedAstKindIntentTerminalSuccessTag() ||
        kind == TypedAstKindIntentTerminalFailureTag() {
        let colon: Int = StringIndexOf(text, ":");
        let arrow: Int = StringIndexOf(text, " => ");
        if colon >= 0 && arrow > colon {
            return StringTrim(Substring(
                text, colon + 1, arrow - colon - 1
            ));
        }
        return "";
    }
    if kind == TypedAstKindEnumDeclTag() {
        let brace: Int = StringIndexOf(text, " { ");
        let n: Int = StringLength(text);
        if brace >= 0 && CodegenCharCodeAt(text, n, n, n - 1) == 125 {
            return StringTrim(Substring(text, brace + 3, StringLength(text) - (brace + 4)));
        }
    }
    if kind == TypedAstKindFieldTag() {
        if StartsWith(text, "Shared: ") { return NominalFieldKindSharedField(); }
        if StartsWith(text, "SubjectSlot: ") { return NominalFieldKindSubjectSlot(); }
        if StartsWith(text, "BindingSlot: ") { return NominalFieldKindBindingSlot(); }
        if StartsWith(text, "ObjectSlot: ") { return NominalFieldKindObjectSlot(); }
        if StartsWith(text, "TObjectSlot: ") { return NominalFieldKindTObjectSlot(); }
        if StartsWith(text, "EffectSlot: ") { return NominalFieldKindEffectSlot(); }
        if StartsWith(text, "RelationSlot: ") { return NominalFieldKindRelationSlot(); }
        if StartsWith(text, "EffectPool: ") { return NominalFieldKindEffectPool(); }
        if StartsWith(text, "RelationPool: ") { return NominalFieldKindRelationPool(); }
        if StartsWith(text, "SystemicSlot: ") { return NominalFieldKindRosterSlot(); }
        if StartsWith(text, "WorldSystemic: ") { return NominalFieldKindWorldRoster(); }
        if StartsWith(text, "WorldZone: ") { return NominalFieldKindWorldZone(); }
        return NominalFieldKindField();
    }
    return "";
}

func CodegenAstTextProvenance(node: CodegenAstTextNode) -> String {
    let provenance: String = node.text;
    return provenance;
}

func CodegenAstTextIndentOf(raw: String) -> Int {
    let n: Int = StringLength(raw);
    let i: Int = 0;
    while i < n && CodegenCharCodeAt(raw, n, n, i) == 32 {
        i = i + 1;
    }
    return i;
}

func CodegenAstTextNodeInventory(tree_text: String, inout nodes: Array<CodegenAstTextNode>, inout count_box: Array<Int>) -> Void {
    let lines: Array<String> = Split(tree_text, "\n");
    let line_index: Int = 0;
    let param_indent: Int = -1;
    let field_indent: Int = -1;
    let lifecycle_transition_indent: Int = -1;
    while line_index < ArrayLength(lines) {
        let raw_line: String = lines[line_index];
        let trimmed: String = StringTrim(raw_line);
        // Namespace/import functions are flattened to top-level exported
        // function lines by the current parser bridge.
        if StartsWith(trimmed, "[export] ") {
            trimmed = Substring(trimmed, 9, StringLength(trimmed) - 9);
        }
        if StringLength(trimmed) > 0 {
            let indent: Int = CodegenAstTextIndentOf(raw_line);
            let kind: Int = TypedAstTextKindOf(trimmed);
            if kind == TypedAstKindIntentDeclTag() && indent >= 6 {
                kind = TypedAstKindIntentStepIntentTag();
            }
            if param_indent >= 0 && indent < param_indent {
                param_indent = -1;
            }
            if field_indent >= 0 && indent < field_indent {
                field_indent = -1;
            }
            if lifecycle_transition_indent >= 0 &&
                indent < lifecycle_transition_indent {
                lifecycle_transition_indent = -1;
            }
            if kind == TypedAstKindParametersTag() {
                param_indent = indent + 2;
                field_indent = -1;
            } else if kind == TypedAstKindFieldsHeaderTag() {
                field_indent = indent + 2;
                param_indent = -1;
            } else if kind == TypedAstKindLifecycleDeclTag() {
                lifecycle_transition_indent = indent + 2;
            } else if lifecycle_transition_indent >= 0 &&
                indent == lifecycle_transition_indent &&
                StringIndexOf(trimmed, ": ") > 0 &&
                StringIndexOf(trimmed, " -> ") > 0 {
                kind = TypedAstKindLifecycleTransitionTag();
            } else if param_indent >= 0 && indent == param_indent &&
                (StringIndexOf(trimmed, ": ") >= 0 || trimmed == "self") {
                kind = TypedAstKindParamTag();
            } else if field_indent >= 0 && indent == field_indent && StringIndexOf(trimmed, ": ") >= 0 {
                kind = TypedAstKindFieldTag();
            }
            let payload: String = CodegenAstTextPayloadFor(trimmed, kind);
            let aux_payload: String = CodegenAstTextAuxPayloadFor(trimmed, kind);
            let mode: Int = CodegenAstTextNodeModeForPayload(kind, payload);
            let row_input: CodegenAstTextRowFactInput = CodegenAstTextRowFactInput(kind, payload, aux_payload, mode);
            ArrayPush(nodes, CodegenAstTextNode(
                indent,
                trimmed,
                kind,
                payload,
                aux_payload,
                CodegenAstTextNameFactFor(row_input),
                CodegenAstTextTypeNameFactFor(row_input),
                CodegenAstTextValueFactFor(row_input),
                CodegenAstTextAuxValueFactFor(row_input),
                mode
            ));
            ArraySet(count_box, 0, count_box[0] + 1);
        }
        line_index = line_index + 1;
    }
}
