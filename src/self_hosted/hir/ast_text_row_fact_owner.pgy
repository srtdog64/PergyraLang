// src/self_hosted/hir/ast_text_row_fact_owner.pgy
//
// Owns name/type/mode row facts derived from AST-text inventory payloads.

import "ast_text_scan_owner.pgy";
import "ast_node_kind_owner.pgy";

struct CodegenAstTextRowFactInput {
    let kind: Int;
    let payload: String;
    let aux_payload: String;
    let mode: Int;
}

func CodegenAstTextParamModeForPayload(kind: Int, payload: String) -> Int {
    if kind != TypedAstKindParamTag() {
        return 0;
    }
    if StartsWith(payload, "inout ") {
        return 1;
    }
    if StartsWith(payload, "own ") {
        return 2;
    }
    if StartsWith(payload, "ref ") {
        return 3;
    }
    return 0;
}

func CodegenAstTextParamPayloadForMode(payload: String, mode: Int) -> String {
    if mode == 0 {
        return payload;
    }
    let prefix_len: Int = 4;
    if mode == 1 {
        prefix_len = 6;
    }
    return Substring(payload, prefix_len, StringLength(payload) - prefix_len);
}

func CodegenAstTextNameFactFor(input: CodegenAstTextRowFactInput) -> String {
    let kind: Int = input.kind;
    let payload: String = input.payload;
    if TypedAstKindIsCallableDecl(kind) ||
        kind == TypedAstKindNominalDeclTag() ||
        kind == TypedAstKindEnumDeclTag() ||
        kind == TypedAstKindImplAbilityTag() {
        return payload;
    }
    if kind == TypedAstKindRoleDeclTag() {
        let pos: Int = StringIndexOf(payload, " for ");
        if pos >= 0 {
            return Substring(payload, 0, pos);
        }
        return "";
    }
    if kind == TypedAstKindAbilityDeclTag() {
        let generic_pos: Int = StringIndexOf(payload, "<");
        if generic_pos >= 0 {
            return StringTrim(Substring(payload, 0, generic_pos));
        }
        return payload;
    }
    if kind == TypedAstKindParamTag() {
        let row: String = CodegenAstTextParamPayloadForMode(payload, input.mode);
        if row == "self" {
            return "self";
        }
        let colon: Int = StringIndexOf(row, ": ");
        if colon >= 0 {
            return Substring(row, 0, colon);
        }
        return "";
    }
    if kind == TypedAstKindLetStmtTag() {
        let sep: Option<Int> = FindTextFrom(payload, " : ", 0);
        if IsSome(sep) {
            return Substring(payload, 0, UnwrapOption(sep));
        }
        let assign_sep: Option<Int> = FindTextFrom(payload, " = ", 0);
        if IsSome(assign_sep) {
            return StringTrim(Substring(payload, 0, UnwrapOption(assign_sep)));
        }
        return "";
    }
    if kind == TypedAstKindAssignStmtTag() {
        let assign_sep: Option<Int> = FindTextFrom(payload, " = ", 0);
        if IsSome(assign_sep) {
            return Substring(payload, 0, UnwrapOption(assign_sep));
        }
        return "";
    }
    if kind == TypedAstKindBindStmtTag() {
        let assign_sep: Option<Int> = FindTextFrom(payload, " = ", 0);
        if IsSome(assign_sep) {
            let target: String = Substring(payload, 0, UnwrapOption(assign_sep));
            let dot: Int = StringIndexOf(target, ".");
            if dot > 0 {
                return Substring(target, 0, dot);
            }
        }
        return "";
    }
    if kind == TypedAstKindArrayPushStmtTag() {
        let push_comma: Option<Int> = FindTopLevelComma(payload);
        if IsSome(push_comma) {
            return StringTrim(Substring(payload, 0, UnwrapOption(push_comma)));
        }
        return "";
    }
    if kind == TypedAstKindArraySetStmtTag() {
        let set_comma: Option<Int> = FindTopLevelComma(payload);
        if IsSome(set_comma) {
            return StringTrim(Substring(payload, 0, UnwrapOption(set_comma)));
        }
        return "";
    }
    if kind == TypedAstKindForStmtTag() {
        let in_pos: Option<Int> = FindTextFrom(payload, " in ", 0);
        if IsSome(in_pos) {
            return StringTrim(Substring(payload, 0, UnwrapOption(in_pos)));
        }
        return "";
    }
    if kind == TypedAstKindFieldTag() {
        let colon2: Int = StringIndexOf(payload, ": ");
        if colon2 >= 0 {
            return Substring(payload, 0, colon2);
        }
        return "";
    }
    if kind == TypedAstKindRoleSlotTag() {
        let requires_pos: Int = StringIndexOf(payload, " requires ");
        if requires_pos > 0 {
            return Substring(payload, 0, requires_pos);
        }
        return "";
    }
    if kind == TypedAstKindDomainRefreshTag() ||
        kind == TypedAstKindDomainPublishTag() ||
        kind == TypedAstKindDomainProjectionBindTag() {
        let from_pos: Int = StringIndexOf(payload, " from ");
        if from_pos > 0 {
            return StringTrim(Substring(payload, 0, from_pos));
        }
        return "";
    }
    if kind == TypedAstKindDomainProjectionMapEntryTag() {
        let arrow_pos: Int = StringIndexOf(payload, " <- ");
        if arrow_pos > 0 {
            return StringTrim(Substring(payload, 0, arrow_pos));
        }
        return "";
    }
    if kind == TypedAstKindDomainLinkTag() {
        let between_pos: Int = StringIndexOf(payload, " between ");
        if between_pos > 0 {
            return StringTrim(Substring(payload, 0, between_pos));
        }
        return "";
    }
    if kind == TypedAstKindDomainApplyTag() {
        let arrow_pos: Int = StringIndexOf(payload, " -> ");
        if arrow_pos > 0 {
            return StringTrim(Substring(payload, 0, arrow_pos));
        }
        return "";
    }
    return "";
}

func CodegenAstTextValueFactFor(input: CodegenAstTextRowFactInput) -> String {
    let kind: Int = input.kind;
    let payload: String = input.payload;
    if kind == TypedAstKindLetStmtTag() {
        let pos: Option<Int> = FindTextFrom(payload, " = ", 0);
        if IsSome(pos) {
            let start: Int = UnwrapOption(pos) + 3;
            return Substring(payload, start, StringLength(payload) - start);
        }
        return "";
    }
    if kind == TypedAstKindAssignStmtTag() {
        let pos2: Option<Int> = FindTextFrom(payload, " = ", 0);
        if IsSome(pos2) {
            let start2: Int = UnwrapOption(pos2) + 3;
            return Substring(payload, start2, StringLength(payload) - start2);
        }
        return "";
    }
    if kind == TypedAstKindBindStmtTag() {
        let bind_pos: Option<Int> = FindTextFrom(payload, " = ", 0);
        if IsSome(bind_pos) {
            let start: Int = UnwrapOption(bind_pos) + 3;
            return StringTrim(Substring(
                payload, start, StringLength(payload) - start
            ));
        }
        return "";
    }
    if kind == TypedAstKindArrayPushStmtTag() {
        let comma: Option<Int> = FindTopLevelComma(payload);
        if IsSome(comma) {
            let start3: Int = UnwrapOption(comma) + 1;
            return StringTrim(Substring(payload, start3, StringLength(payload) - start3));
        }
        return "";
    }
    if kind == TypedAstKindArraySetStmtTag() {
        let comma2: Option<Int> = FindTopLevelComma(payload);
        if IsSome(comma2) {
            let rest_start: Int = UnwrapOption(comma2) + 1;
            let rest: String = StringTrim(Substring(payload, rest_start, StringLength(payload) - rest_start));
            let second: Option<Int> = FindTopLevelComma(rest);
            if IsSome(second) {
                return StringTrim(Substring(rest, 0, UnwrapOption(second)));
            }
        }
        return "";
    }
    if kind == TypedAstKindForStmtTag() {
        let in_pos: Option<Int> = FindTextFrom(payload, " in ", 0);
        if IsSome(in_pos) {
            let iterable_start: Int = UnwrapOption(in_pos) + 4;
            let iterable: String = StringTrim(Substring(payload, iterable_start, StringLength(payload) - iterable_start));
            let dot_pos: Option<Int> = FindTextFrom(iterable, "..", 0);
            if IsSome(dot_pos) {
                return StringTrim(Substring(iterable, 0, UnwrapOption(dot_pos)));
            }
            return iterable;
        }
        return "";
    }
    if kind == TypedAstKindDomainLinkTag() {
        let between_pos: Int = StringIndexOf(payload, " between ");
        let comma_pos: Int = StringIndexOf(payload, ", ");
        if between_pos > 0 && comma_pos > between_pos + 9 {
            let start: Int = comma_pos + 2;
            let end: Int = StringIndexOf(payload, " by ");
            if end < start { end = StringLength(payload); }
            return StringTrim(Substring(payload, start, end - start));
        }
        return "";
    }
    return "";
}

func CodegenAstTextAuxValueFactFor(input: CodegenAstTextRowFactInput) -> String {
    let kind: Int = input.kind;
    let payload: String = input.payload;
    if kind == TypedAstKindEnumDeclTag() {
        return input.aux_payload;
    }
    if kind == TypedAstKindFieldTag() {
        return input.aux_payload;
    }
    if kind == TypedAstKindAssignStmtTag() {
        let target: String = CodegenAstTextNameFactFor(input);
        let open: Int = StringIndexOf(target, "[");
        let n: Int = StringLength(target);
        if open > 0 && open + 1 < n &&
            CodegenCharCodeAt(target, n, n - 1) == 93 {
            return target;
        }
        return "";
    }
    if kind == TypedAstKindBindStmtTag() {
        let bind_pos: Option<Int> = FindTextFrom(payload, " = ", 0);
        if IsSome(bind_pos) {
            let target: String = Substring(payload, 0, UnwrapOption(bind_pos));
            let dot: Int = StringIndexOf(target, ".");
            if dot > 0 && dot + 1 < StringLength(target) {
                return Substring(
                    target, dot + 1, StringLength(target) - (dot + 1)
                );
            }
        }
        return "";
    }
    if kind == TypedAstKindArraySetStmtTag() {
        let comma: Option<Int> = FindTopLevelComma(payload);
        if IsSome(comma) {
            let rest_start: Int = UnwrapOption(comma) + 1;
            let rest: String = StringTrim(Substring(payload, rest_start, StringLength(payload) - rest_start));
            let second: Option<Int> = FindTopLevelComma(rest);
            if IsSome(second) {
                let value_start: Int = UnwrapOption(second) + 1;
                return StringTrim(Substring(rest, value_start, StringLength(rest) - value_start));
            }
        }
        return "";
    }
    if kind == TypedAstKindForStmtTag() {
        let in_pos: Option<Int> = FindTextFrom(payload, " in ", 0);
        if IsSome(in_pos) {
            let iterable_start: Int = UnwrapOption(in_pos) + 4;
            let iterable: String = StringTrim(Substring(payload, iterable_start, StringLength(payload) - iterable_start));
            let dot_pos: Option<Int> = FindTextFrom(iterable, "..", 0);
            if IsSome(dot_pos) {
                let end_start: Int = UnwrapOption(dot_pos) + 2;
                return StringTrim(Substring(iterable, end_start, StringLength(iterable) - end_start));
            }
        }
        return "";
    }
    if kind == TypedAstKindDomainRefreshTag() ||
        kind == TypedAstKindDomainPublishTag() ||
        kind == TypedAstKindDomainProjectionBindTag() ||
        kind == TypedAstKindDomainLinkTag() ||
        kind == TypedAstKindDomainApplyTag() {
        let by_pos: Int = StringIndexOf(payload, " by ");
        if by_pos >= 0 {
            let start: Int = by_pos + 4;
            return StringTrim(Substring(
                payload, start, StringLength(payload) - start
            ));
        }
        return "";
    }
    return "";
}

func CodegenAstTextTypeNameFactFor(input: CodegenAstTextRowFactInput) -> String {
    let kind: Int = input.kind;
    let payload: String = input.payload;
    if kind == TypedAstKindReturnsTag() {
        return payload;
    }
    if kind == TypedAstKindRoleDeclTag() {
        let pos: Int = StringIndexOf(payload, " for ");
        if pos >= 0 {
            return Substring(payload, pos + 5, StringLength(payload) - (pos + 5));
        }
        return "";
    }
    if kind == TypedAstKindParamTag() {
        let row: String = CodegenAstTextParamPayloadForMode(payload, input.mode);
        if row == "self" {
            return "";
        }
        let colon: Int = StringIndexOf(row, ": ");
        if colon >= 0 {
            return Substring(row, colon + 2, StringLength(row) - (colon + 2));
        }
        return "";
    }
    if kind == TypedAstKindLetStmtTag() {
        let type_sep: Option<Int> = FindTextFrom(payload, " : ", 0);
        if IsSome(type_sep) {
            let type_start: Int = UnwrapOption(type_sep) + 3;
            let init_sep: Option<Int> = FindTextFrom(payload, " = ", type_start);
            if IsSome(init_sep) {
                return Substring(payload, type_start, UnwrapOption(init_sep) - type_start);
            }
        }
        return "";
    }
    if kind == TypedAstKindFieldTag() {
        let colon2: Int = StringIndexOf(payload, ": ");
        if colon2 >= 0 {
            let type_start: Int = colon2 + 2;
            let type_end: Int = StringIndexOf(payload, " = ");
            let capacity_start: Int = StringIndexOf(payload, " capacity ");
            if capacity_start >= type_start &&
                (type_end < type_start || capacity_start < type_end) {
                type_end = capacity_start;
            }
            if type_end < type_start {
                type_end = StringLength(payload);
            }
            return StringTrim(Substring(
                payload, type_start, type_end - type_start
            ));
        }
        return "";
    }
    if kind == TypedAstKindRoleSlotTag() {
        let requires_pos: Int = StringIndexOf(payload, " requires ");
        if requires_pos > 0 {
            let start: Int = requires_pos + 10;
            return StringTrim(Substring(
                payload, start, StringLength(payload) - start
            ));
        }
        return "";
    }
    if kind == TypedAstKindDomainRefreshTag() ||
        kind == TypedAstKindDomainPublishTag() ||
        kind == TypedAstKindDomainProjectionBindTag() {
        let from_pos: Int = StringIndexOf(payload, " from ");
        if from_pos > 0 {
            let start: Int = from_pos + 6;
            let end: Int = StringIndexOf(payload, " by ");
            if end < start { end = StringLength(payload); }
            return StringTrim(Substring(payload, start, end - start));
        }
        return "";
    }
    if kind == TypedAstKindDomainProjectionMapEntryTag() {
        let arrow_pos: Int = StringIndexOf(payload, " <- ");
        if arrow_pos > 0 {
            let start: Int = arrow_pos + 4;
            return StringTrim(Substring(
                payload, start, StringLength(payload) - start
            ));
        }
        return "";
    }
    if kind == TypedAstKindDomainLinkTag() {
        let between_pos: Int = StringIndexOf(payload, " between ");
        let comma_pos: Int = StringIndexOf(payload, ", ");
        if between_pos > 0 && comma_pos > between_pos + 9 {
            let start: Int = between_pos + 9;
            return StringTrim(Substring(payload, start, comma_pos - start));
        }
        return "";
    }
    if kind == TypedAstKindDomainApplyTag() {
        let arrow_pos: Int = StringIndexOf(payload, " -> ");
        if arrow_pos > 0 {
            let start: Int = arrow_pos + 4;
            let end: Int = StringIndexOf(payload, " by ");
            if end < start { end = StringLength(payload); }
            return StringTrim(Substring(payload, start, end - start));
        }
        return "";
    }
    return "";
}
