// Shared scanning facts for the transitional compact AST-text artifact.

func CodegenCharAt(s: String, i: Int) -> String {
    let n: Int = StringLength(s);
    if i < 0 || i >= n {
        return "";
    }
    return CharAtN(s, n, i);
}

func CodegenCharCodeAt(s: String, length: Int, i: Int) -> Int {
    return CharCode(s, length, i);
}

func IsIdentCode(c: Int) -> Bool {
    return (c >= 97 && c <= 122) ||
        (c >= 65 && c <= 90) ||
        (c >= 48 && c <= 57) || c == 95;
}

func IsIdentChar(c: String) -> Bool {
    let n: Int = StringLength(c);
    return n == 1 && IsIdentCode(CodegenCharCodeAt(c, n, 0));
}

func IsIdentifier(e: String) -> Bool {
    let n: Int = StringLength(e);
    if n == 0 {
        return false;
    }
    let first: Int = CodegenCharCodeAt(e, n, 0);
    if first >= 48 && first <= 57 {
        return false;
    }
    let i: Int = 0;
    while i < n {
        if !IsIdentCode(CodegenCharCodeAt(e, n, i)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func NextNewline(s: String, start: Int) -> Int {
    let n: Int = StringLength(s);
    if start < 0 || start >= n {
        return n;
    }
    let relative: Int = SubIndexOfWithLen(s, n, start, n - start, "\n");
    if relative < 0 {
        return n;
    }
    return start + relative;
}

func StartsWith(s: String, prefix: String) -> Bool {
    let pn: Int = StringLength(prefix);
    if StringLength(s) < pn {
        return false;
    }
    return SubEqualsWithLen(s, StringLength(s), 0, pn, prefix);
}

func FindTextFrom(hay: String, needle: String, start: Int) -> Option<Int> {
    let n: Int = StringLength(hay);
    if start < 0 || start > n {
        return None;
    }
    let k: Int = SubIndexOfWithLen(hay, n, start, n - start, needle);
    if k < 0 {
        return None;
    }
    return Some(start + k);
}

func FindTopLevelComma(s: String) -> Option<Int> {
    let n: Int = StringLength(s);
    let i: Int = 0;
    let depth: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: Int = CodegenCharCodeAt(s, n, i);
        if in_str {
            if c == 92 {
                i = i + 2;
                continue;
            }
            if c == 34 {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == 34 {
            in_str = true;
            i = i + 1;
            continue;
        }
        if c == 40 || c == 91 || c == 123 {
            depth = depth + 1;
            i = i + 1;
            continue;
        }
        if c == 41 || c == 93 || c == 125 {
            if depth > 0 {
                depth = depth - 1;
            }
            i = i + 1;
            continue;
        }
        if c == 44 && depth == 0 {
            return Some(i);
        }
        i = i + 1;
    }
    return None;
}

func FindMatchingParen(s: String, open_idx: Int) -> Option<Int> {
    let n: Int = StringLength(s);
    let i: Int = open_idx;
    let depth: Int = 0;
    let in_str: Bool = false;
    while i < n {
        let c: Int = CodegenCharCodeAt(s, n, i);
        if in_str {
            if c == 92 {
                i = i + 2;
                continue;
            }
            if c == 34 {
                in_str = false;
            }
            i = i + 1;
            continue;
        }
        if c == 34 {
            in_str = true;
        } else if c == 40 {
            depth = depth + 1;
        } else if c == 41 {
            depth = depth - 1;
            if depth == 0 {
                return Some(i);
            }
        }
        i = i + 1;
    }
    return None;
}

func IsSingleCall(e: String) -> Bool {
    let n: Int = StringLength(e);
    if n == 0 || CodegenCharCodeAt(e, n, n - 1) != 41 {
        return false;
    }
    let op: Int = StringIndexOf(e, "(");
    if op <= 0 {
        return false;
    }
    let prefix: String = Substring(e, 0, op);
    if !IsIdentifier(prefix) {
        return false;
    }
    let close: Option<Int> = FindMatchingParen(e, op);
    return IsSome(close) && UnwrapOption(close) == n - 1;
}
