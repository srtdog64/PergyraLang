// src/self_hosted/lexer/main.pgy
//
// Status: rung-1 parity (2026-06-18). Pergyra-written lexer that substitutes
// a bounded subset of src/lexer/lexer.c. Current gate: 6 committed source
// fixtures byte-equal to `pgy --tokens` on both C and LLVM-generated binaries,
// with a live oracle drift guard.
//
// Outputs the same text `pgy --tokens` does, byte-for-byte (with LF line
// endings; the parity script normalizes CRLF on Windows).
//
// Each tool invocation lexes the first process argument when present. The
// legacy `fixture/source.txt` override remains as a local fallback for probes
// that have not moved to argv yet.
//
// Contract: see intent.md in the same directory.

import "char_owner.pgy";
import "token_owner.pgy";
import "scan_owner.pgy";

func Main() -> Void {
    let run_args: Array<String> = Args();
    let override_path: String = "src/self_hosted/lexer/fixture/source.txt";
    let source_path: String = "examples/hello.pgy";
    if ArrayLength(run_args) > 0 {
        source_path = run_args[0];
    } else if FileExists(override_path) {
        let raw: String = ReadFile(override_path);
        let trimmed: String = StringTrim(raw);
        if StringLength(trimmed) > 0 {
            source_path = trimmed;
        }
    }

    if !FileExists(source_path) {
        Exit(1);
    }
    let content: String = ReadFile(source_path);
    Log(LexContent(source_path, content));
}
