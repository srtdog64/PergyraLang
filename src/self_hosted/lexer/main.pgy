// src/self_hosted/lexer/main.pgy
//
// Status: rung-1 parity (2026-06-18). Pergyra-written lexer that substitutes
// a bounded subset of src/lexer/lexer.c. Current gate: 6 committed source
// fixtures byte-equal to `pgy --tokens` on both C and LLVM-generated binaries,
// with a live oracle drift guard.
//
// Outputs the same text `pgy --tokens` does, byte-for-byte (with LF line
// endings; the parity script normalizes CRLF on Windows).
//
// Each tool invocation lexes the first process argument when present. The
// legacy `fixture/source.txt` override remains as a local fallback for probes
// that have not moved to argv yet.
//
// Contract: see intent.md in the same directory.

func CharAt(s: String, i: Int) -> String {
    let n: Int = StringLength(s);
    if i < 0 {
        return "";
    }
    if i >= n {
        return "";
    }
    return Substring(s, i, 1);
}

// Code of the first byte of a 1-char string literal, in O(1) and no allocation.
// Lets char comparisons stay readable (cc == Ord("x")) without magic numbers.
func Ord(ch: String) -> Int {
    return CharCode(ch, StringLength(ch), 0);
}

// Char-code classification (the allocation-free counterpart of IsAlpha/IsDigit,
// which took a 1-char String). Operates on a byte code from CharCode.
func IsAlphaCode(cc: Int) -> Bool {
    if cc >= Ord("a") && cc <= Ord("z") {
        return true;
    }
    if cc >= Ord("A") && cc <= Ord("Z") {
        return true;
    }
    return cc == Ord("_");
}

func IsDigitCode(cc: Int) -> Bool {
    return cc >= Ord("0") && cc <= Ord("9");
}

func IsAlphaNumCode(cc: Int) -> Bool {
    return IsAlphaCode(cc) || IsDigitCode(cc);
}

func KeywordType(text: String) -> String {
    if text == "func" {
        return "FUNC";
    }
    if text == "let" {
        return "LET";
    }
    if text == "if" {
        return "IF";
    }
    if text == "else" {
        return "ELSE";
    }
    if text == "while" {
        return "WHILE";
    }
    if text == "for" {
        return "FOR";
    }
    if text == "in" {
        return "IN";
    }
    if text == "return" {
        return "RETURN";
    }
    if text == "break" {
        return "BREAK";
    }
    if text == "continue" {
        return "CONTINUE";
    }
    if text == "true" {
        return "TRUE";
    }
    if text == "false" {
        return "FALSE";
    }
    if text == "import" {
        return "IMPORT";
    }
    if text == "export" {
        return "EXPORT";
    }
    if text == "namespace" {
        return "NAMESPACE";
    }
    if text == "ability" {
        return "ABILITY";
    }
    if text == "async" {
        return "ASYNC";
    }
    if text == "vessel" {
        return "VESSEL";
    }
    if text == "subject" {
        return "SUBJECT";
    }
    if text == "object" {
        return "OBJECT";
    }
    if text == "tobject" {
        return "TOBJECT";
    }
    if text == "event" {
        return "EVENT";
    }
    if text == "parallel" {
        return "PARALLEL";
    }
    if text == "class" {
        return "CLASS";
    }
    if text == "struct" {
        return "STRUCT";
    }
    if text == "enum" {
        return "ENUM";
    }
    if text == "role" {
        return "ROLE";
    }
    if text == "party" {
        return "PARTY";
    }
    if text == "roster" {
        return "ROSTER";
    }
    if text == "world" {
        return "WORLD";
    }
    if text == "zone" {
        return "ZONE";
    }
    if text == "relation" {
        return "RELATION";
    }
    if text == "effect" {
        return "EFFECT";
    }
    if text == "intent" {
        return "INTENT";
    }
    // NOTE: `projection` is NOT a keyword -- C lexer emits IDENTIFIER
    // (verified on handoff_world_state_frontier).
    // NOTE: `authority` and `handoff` are NOT keywords -- C lexer emits
    // IDENTIFIER for both (verified vs `pgy --tokens` on multiple files).
    if text == "spawn" {
        return "SPAWN";
    }
    if text == "await" {
        return "AWAIT";
    }
    if text == "channel" {
        return "CHANNEL";
    }
    if text == "select" {
        return "SELECT";
    }
    if text == "defer" {
        return "DEFER";
    }
    if text == "unsafe" {
        return "UNSAFE";
    }
    if text == "use" {
        return "USE";
    }
    if text == "slot" {
        return "SLOT";
    }
    if text == "match" {
        return "MATCH";
    }
    if text == "impl" {
        // C lexer reports `impl` as UNKNOWN (reserved-but-not-yet-keyword
        // identifier). Verified against pgy --tokens.
        return "UNKNOWN";
    }
    if text == "dyn" {
        return "DYN";
    }
    if text == "where" {
        return "WHERE";
    }
    if text == "shared" {
        return "SHARED";
    }
    if text == "case" {
        return "CASE";
    }
    if text == "bind" {
        return "BIND";
    }
    if text == "with" {
        return "WITH";
    }
    if text == "default" {
        return "DEFAULT";
    }
    if text == "type" {
        return "UNKNOWN";
    }
    if text == "secure" {
        return "SECURE";
    }
    if text == "as" {
        return "AS";
    }
    if text == "private" {
        return "PRIVATE";
    }
    if text == "public" {
        return "PUBLIC";
    }
    if text == "remote" {
        return "REMOTE";
    }
    if text == "extern" {
        return "EXTERN";
    }
    if text == "include" {
        return "INCLUDE";
    }
    if text == "ref" {
        return "UNKNOWN";
    }
    if text == "own" {
        return "UNKNOWN";
    }
    if text == "reflect" {
        return "REFLECT";
    }
    return "IDENTIFIER";
}

func PadLeft(s: String, width: Int) -> String {
    let n: Int = StringLength(s);
    if n >= width {
        return s;
    }
    let padding: Int = width - n;
    let result: String = "";
    let i: Int = 0;
    while i < padding {
        result = Concat(result, " ");
        i = i + 1;
    }
    return Concat(result, s);
}

func TokenLine(idx: Int, ttype: String, text: String, line: Int, col: Int) -> String {
    let parts: Array<String> = [
        PadLeft(ToString(idx), 4),
        "  Token{type: ",
        ttype,
        ", text: \"",
        text,
        "\", line: ",
        ToString(line),
        ", col: ",
        ToString(col),
        "}"
    ];
    return StringJoin(parts, "");
}

func Main() -> Void {
    let run_args: Array<String> = Args();
    let override_path: String = "src/self_hosted/lexer/fixture/source.txt";
    let source_path: String = "examples/hello.pgy";
    if ArrayLength(run_args) > 0 {
        source_path = run_args[0];
    } else if FileExists(override_path) {
        let raw: String = ReadFile(override_path);
        let trimmed: String = StringTrim(raw);
        if StringLength(trimmed) > 0 {
            source_path = trimmed;
        }
    }

    if !FileExists(source_path) {
        Exit(1);
    }
    let content: String = ReadFile(source_path);
    let n: Int = StringLength(content);

    let output_lines: Array<String> = [];
    ArrayPush(output_lines, Concat(Concat("=== tokens: ", source_path), " ==="));

    let i: Int = 0;
    let line: Int = 1;
    let col: Int = 1;
    let token_count: Int = 0;

    while i < n {
        let c: Int = CharCode(content, n, i);

        if c == Ord(" ") {
            i = i + 1;
            col = col + 1;
            continue;
        }
        if c == Ord("\t") {
            i = i + 1;
            col = col + 1;
            continue;
        }
        if c == Ord("\n") {
            i = i + 1;
            line = line + 1;
            col = 1;
            continue;
        }
        if c == Ord("\r") {
            i = i + 1;
            continue;
        }

        // /// doc comment -> DOC_COMMENT token. Mirrors the C oracle: skip the
        // three slashes, skip leading spaces/tabs, then the rest of the line is
        // the text; col points at the first slash.
        if c == Ord("/") && CharCode(content, n, i + 1) == Ord("/")
            && CharCode(content, n, i + 2) == Ord("/") {
            i = i + 3;
            col = col + 3;
            while i < n && (CharCode(content, n, i) == Ord(" ") || CharCode(content, n, i) == Ord("\t")) {
                i = i + 1;
                col = col + 1;
            }
            // col points at the text start (after `///` and leading whitespace),
            // matching the C oracle's DOC_COMMENT column.
            let dc_col: Int = col;
            let dc_start: Int = i;
            while i < n && CharCode(content, n, i) != Ord("\n") {
                i = i + 1;
                col = col + 1;
            }
            let dc_text: String = Substring(content, dc_start, i - dc_start);
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "DOC_COMMENT", dc_text, line, dc_col));
            continue;
        }

        if c == Ord("/") && CharCode(content, n, i + 1) == Ord("/") {
            while i < n && CharCode(content, n, i) != Ord("\n") {
                i = i + 1;
                col = col + 1;
            }
            continue;
        }

        // /* ... */ block comment (may span multiple lines)
        if c == Ord("/") && CharCode(content, n, i + 1) == Ord("*") {
            i = i + 2;
            col = col + 2;
            while i < n {
                let cc: Int = CharCode(content, n, i);
                if cc == Ord("*") && CharCode(content, n, i + 1) == Ord("/") {
                    i = i + 2;
                    col = col + 2;
                    break;
                }
                if cc == Ord("\n") {
                    i = i + 1;
                    line = line + 1;
                    col = 1;
                } else {
                    i = i + 1;
                    col = col + 1;
                }
            }
            continue;
        }

        if IsAlphaCode(c) {
            let start: Int = i;
            let start_col: Int = col;
            while IsAlphaNumCode(CharCode(content, n, i)) {
                i = i + 1;
                col = col + 1;
            }
            let text: String = Substring(content, start, i - start);
            let ttype: String = KeywordType(text);
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, ttype, text, line, start_col));
            continue;
        }

        if IsDigitCode(c) {
            let start: Int = i;
            let start_col: Int = col;
            while IsDigitCode(CharCode(content, n, i)) {
                i = i + 1;
                col = col + 1;
            }
            // Float literal: digits . digits. We must NOT consume `..` here
            // (that's the range operator), only a single `.` followed by a digit.
            if CharCode(content, n, i) == Ord(".") && IsDigitCode(CharCode(content, n, i + 1)) {
                i = i + 1;
                col = col + 1;
                while IsDigitCode(CharCode(content, n, i)) {
                    i = i + 1;
                    col = col + 1;
                }
            }
            // Long literal suffix: `L` appended to digits.
            if CharCode(content, n, i) == Ord("L") {
                i = i + 1;
                col = col + 1;
            }
            let text: String = Substring(content, start, i - start);
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "NUMBER", text, line, start_col));
            continue;
        }

        if c == Ord("\"") {
            let start: Int = i;
            let start_col: Int = col;
            i = i + 1;
            col = col + 1;
            while i < n && CharCode(content, n, i) != Ord("\"") {
                i = i + 1;
                col = col + 1;
            }
            if i < n {
                i = i + 1;
                col = col + 1;
            }
            let text: String = Substring(content, start, i - start);
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "STRING", text, line, start_col));
            continue;
        }

        let n2: Int = CharCode(content, n, i + 1);
        if c == Ord("-") && n2 == Ord(">") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "->", "->", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        if c == Ord("<") && n2 == Ord("-") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "<-", "<-", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        // Compound assignment operators
        if c == Ord("+") && n2 == Ord("=") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "+=", "+=", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        if c == Ord("-") && n2 == Ord("=") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "-=", "-=", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        if c == Ord("*") && n2 == Ord("=") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "*=", "*=", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        if c == Ord("/") && n2 == Ord("=") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "/=", "/=", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        // :: scope resolution
        if c == Ord(":") && n2 == Ord(":") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "::", "::", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        // => lambda arrow
        if c == Ord("=") && n2 == Ord(">") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "=>", "=>", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        // |> pipe
        if c == Ord("|") && n2 == Ord(">") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "|>", "|>", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        // := walrus
        if c == Ord(":") && n2 == Ord("=") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, ":=", ":=", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        // ?? null-coalesce
        if c == Ord("?") && n2 == Ord("?") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "??", "??", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        if c == Ord("=") && n2 == Ord("=") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "==", "==", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        if c == Ord("!") && n2 == Ord("=") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "!=", "!=", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        if c == Ord("<") && n2 == Ord("=") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "<=", "<=", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        if c == Ord(">") && n2 == Ord("=") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, ">=", ">=", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        if c == Ord("&") && n2 == Ord("&") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "&&", "&&", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        if c == Ord("|") && n2 == Ord("|") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "||", "||", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        if c == Ord(".") && n2 == Ord(".") {
            // C lexer reports the range operator with type="." (single dot)
            // and text=".." (two dots). Verified against pgy --tokens on
            // examples/break_continue.pgy's `for i in 0..100` loop.
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, ".", "..", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }

        let punct: String = "(){}[];,:.=+-*/!<>%&|?@";
        // Punctuation is rare relative to whitespace/identifiers, so materialize
        // the single-char token text here (the only remaining per-token alloc).
        let ch: String = CharAtN(content, n, i);
        if StringIndexOf(punct, ch) >= 0 {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, ch, ch, line, col));
            i = i + 1;
            col = col + 1;
            continue;
        }

        i = i + 1;
        col = col + 1;
    }

    token_count = token_count + 1;
    ArrayPush(output_lines, TokenLine(token_count, "EOF", "", line, col));

    // Footer: C lexer prefixes the count with a fixed 2-space lead
    // (NOT the width-4 padding used for token-index column). Verified
    // against `pgy --tokens` for 2-digit and 3-digit token counts.
    let footer: String = Concat("  ", Concat(ToString(token_count), " tokens total"));
    ArrayPush(output_lines, footer);

    Log(StringJoin(output_lines, "\n"));
}
