// Lexer run-boundary owner.
//
// Owns CLI mode selection for normal lexing vs fixture-manifest emission.
// `main.pgy` remains entrypoint-only.

import "scan_owner.pgy";
import "source_input_owner.pgy";
import "fixture_manifest_owner.pgy";

func RunLexerFromArgs(args: Array<String>) -> Void {
    if ArrayLength(args) > 0 && args[0] == "--fixture-manifest" {
        EmitLexerFixtureManifest();
        return;
    }
    if ArrayLength(args) > 0 && args[0] == "--check" {
        if ArrayLength(args) < 2 {
            Log("Diagnostic: pgy.selfhost.stage-check.v1");
            Log("Stage: lexer");
            Log("Status: error");
            Log("Reason: input_missing");
            Exit(1);
            return;
        }
        let check_path: String = args[1];
        let check_content: String = LexerReadSource(check_path);
        let check_tokens: String = LexContent(check_path, check_content);
        if StringLength(check_tokens) >= 0 {
            Log("Diagnostic: pgy.selfhost.stage-check.v1");
            Log("Stage: lexer");
            Log("Status: ok");
        }
        return;
    }

    let source_path: String = LexerDefaultSourcePath(args);
    let content: String = LexerReadSource(source_path);
    Log(LexContent(source_path, content));
}
