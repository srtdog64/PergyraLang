// Self-host lexer scan-loop owner.

import "char_owner.pgy";
import "token_owner.pgy";

func LexContent(source_path: String, content: String) -> String {
    let n: Int = StringLength(content);

    let output_lines: Array<String> = [];
    ArrayPush(output_lines, Concat(Concat("=== tokens: ", source_path), " ==="));

    let i: Int = 0;
    let line: Int = 1;
    let col: Int = 1;
    let token_count: Int = 0;

    while i < n {
        let c: Int = CharCode(content, n, i);

        if c == Ord(" ") {
            i = i + 1;
            col = col + 1;
            continue;
        }
        if c == Ord("\t") {
            i = i + 1;
            col = col + 1;
            continue;
        }
        if c == Ord("\n") {
            i = i + 1;
            line = line + 1;
            col = 1;
            continue;
        }
        if c == Ord("\r") {
            i = i + 1;
            continue;
        }

        // /// doc comment -> DOC_COMMENT token. Mirrors the C oracle: skip the
        // three slashes, skip leading spaces/tabs, then the rest of the line is
        // the text; col points at the first slash.
        if c == Ord("/") && CharCode(content, n, i + 1) == Ord("/")
            && CharCode(content, n, i + 2) == Ord("/") {
            i = i + 3;
            col = col + 3;
            while i < n && (CharCode(content, n, i) == Ord(" ") || CharCode(content, n, i) == Ord("\t")) {
                i = i + 1;
                col = col + 1;
            }
            // col points at the text start (after `///` and leading whitespace),
            // matching the C oracle's DOC_COMMENT column.
            let dc_col: Int = col;
            let dc_start: Int = i;
            while i < n && CharCode(content, n, i) != Ord("\n") {
                i = i + 1;
                col = col + 1;
            }
            let dc_text: String = Substring(content, dc_start, i - dc_start);
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "DOC_COMMENT", dc_text, line, dc_col));
            continue;
        }

        if c == Ord("/") && CharCode(content, n, i + 1) == Ord("/") {
            while i < n && CharCode(content, n, i) != Ord("\n") {
                i = i + 1;
                col = col + 1;
            }
            continue;
        }

        // /* ... */ block comment (may span multiple lines)
        if c == Ord("/") && CharCode(content, n, i + 1) == Ord("*") {
            i = i + 2;
            col = col + 2;
            while i < n {
                let cc: Int = CharCode(content, n, i);
                if cc == Ord("*") && CharCode(content, n, i + 1) == Ord("/") {
                    i = i + 2;
                    col = col + 2;
                    break;
                }
                if cc == Ord("\n") {
                    i = i + 1;
                    line = line + 1;
                    col = 1;
                } else {
                    i = i + 1;
                    col = col + 1;
                }
            }
            continue;
        }

        // Interpolated string with a `$"..."` or `f"..."` prefix. Mirrors the C
        // oracle: the prefix char is consumed, the token text and column start at
        // the opening quote, and backslash escapes do not terminate the string.
        // Checked before the identifier branch so `f"` is not lexed as `f`.
        if (c == Ord("$") || c == Ord("f")) && CharCode(content, n, i + 1) == Ord("\"") {
            i = i + 1;
            col = col + 1;
            let istart: Int = i;
            let istart_col: Int = col;
            i = i + 1;
            col = col + 1;
            while i < n && CharCode(content, n, i) != Ord("\"") {
                if CharCode(content, n, i) == Ord("\\") {
                    i = i + 1;
                    col = col + 1;
                    if i < n {
                        i = i + 1;
                        col = col + 1;
                    }
                } else {
                    i = i + 1;
                    col = col + 1;
                }
            }
            if i < n {
                i = i + 1;
                col = col + 1;
            }
            let itext: String = Substring(content, istart, i - istart);
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "INTERPOLATED_STRING", itext, line, istart_col));
            continue;
        }

        if IsAlphaCode(c) {
            let start: Int = i;
            let start_col: Int = col;
            while IsAlphaNumCode(CharCode(content, n, i)) {
                i = i + 1;
                col = col + 1;
            }
            let text: String = Substring(content, start, i - start);
            let ttype: String = KeywordType(text);
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, ttype, text, line, start_col));
            continue;
        }

        if IsDigitCode(c) {
            let start: Int = i;
            let start_col: Int = col;
            while IsDigitCode(CharCode(content, n, i)) {
                i = i + 1;
                col = col + 1;
            }
            // Float literal: digits . digits. We must NOT consume `..` here
            // (that's the range operator), only a single `.` followed by a digit.
            if CharCode(content, n, i) == Ord(".") && IsDigitCode(CharCode(content, n, i + 1)) {
                i = i + 1;
                col = col + 1;
                while IsDigitCode(CharCode(content, n, i)) {
                    i = i + 1;
                    col = col + 1;
                }
            }
            // Long literal suffix: `L` appended to digits.
            if CharCode(content, n, i) == Ord("L") {
                i = i + 1;
                col = col + 1;
            }
            let text: String = Substring(content, start, i - start);
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "NUMBER", text, line, start_col));
            continue;
        }

        if c == Ord("\"") {
            let start: Int = i;
            let start_col: Int = col;
            i = i + 1;
            col = col + 1;
            while i < n && CharCode(content, n, i) != Ord("\"") {
                if CharCode(content, n, i) == Ord("\\") {
                    i = i + 1;
                    col = col + 1;
                    if i < n {
                        i = i + 1;
                        col = col + 1;
                    }
                } else {
                    i = i + 1;
                    col = col + 1;
                }
            }
            if i < n {
                i = i + 1;
                col = col + 1;
            }
            let text: String = Substring(content, start, i - start);
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "STRING", text, line, start_col));
            continue;
        }

        let n2: Int = CharCode(content, n, i + 1);
        if c == Ord("-") && n2 == Ord(">") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "->", "->", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        if c == Ord("<") && n2 == Ord("-") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "<-", "<-", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        // Compound assignment operators
        if c == Ord("+") && n2 == Ord("=") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "+=", "+=", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        if c == Ord("-") && n2 == Ord("=") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "-=", "-=", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        if c == Ord("*") && n2 == Ord("=") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "*=", "*=", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        if c == Ord("/") && n2 == Ord("=") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "/=", "/=", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        // :: scope resolution
        if c == Ord(":") && n2 == Ord(":") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "::", "::", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        // => lambda arrow
        if c == Ord("=") && n2 == Ord(">") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "=>", "=>", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        // |> pipe
        if c == Ord("|") && n2 == Ord(">") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "|>", "|>", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        // := walrus
        if c == Ord(":") && n2 == Ord("=") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, ":=", ":=", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        // ?? null-coalesce
        if c == Ord("?") && n2 == Ord("?") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "??", "??", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        if c == Ord("=") && n2 == Ord("=") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "==", "==", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        if c == Ord("!") && n2 == Ord("=") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "!=", "!=", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        if c == Ord("<") && n2 == Ord("=") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "<=", "<=", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        if c == Ord(">") && n2 == Ord("=") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, ">=", ">=", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        if c == Ord("&") && n2 == Ord("&") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "&&", "&&", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        if c == Ord("|") && n2 == Ord("|") {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, "||", "||", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }
        if c == Ord(".") && n2 == Ord(".") {
            // C lexer reports the range operator with type="." (single dot)
            // and text=".." (two dots). Verified against pgy --tokens on
            // examples/break_continue.pgy's `for i in 0..100` loop.
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, ".", "..", line, col));
            i = i + 2;
            col = col + 2;
            continue;
        }

        let punct: String = "(){}[];,:.=+-*/!<>%&|?@";
        // Punctuation is rare relative to whitespace/identifiers, so materialize
        // the single-char token text here (the only remaining per-token alloc).
        let ch: String = CharAtN(content, n, i);
        if StringIndexOf(punct, ch) >= 0 {
            token_count = token_count + 1;
            ArrayPush(output_lines, TokenLine(token_count, ch, ch, line, col));
            i = i + 1;
            col = col + 1;
            continue;
        }

        i = i + 1;
        col = col + 1;
    }

    token_count = token_count + 1;
    ArrayPush(output_lines, TokenLine(token_count, "EOF", "", line, col));

    // Footer: C lexer prefixes the count with a fixed 2-space lead
    // (NOT the width-4 padding used for token-index column). Verified
    // against `pgy --tokens` for 2-digit and 3-digit token counts.
    let footer: String = Concat("  ", Concat(ToString(token_count), " tokens total"));
    ArrayPush(output_lines, footer);

    return StringJoin(output_lines, "\n");
}
