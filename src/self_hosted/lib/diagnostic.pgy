// src/self_hosted/lib/diagnostic.pgy
//
// Shared diagnostic rendering for self-host tools and compiler-internal
// substitution slices. The diagnostic value is the source of truth: stage,
// severity, stable code, reason, fix, optional span, and structured facts.
// Renderers turn that value into a stable text block for parity fixtures.
//
// Do not hand-build diagnostic strings in each tool. A tool may own its
// domain-specific code/reason/fix table, but the output shape belongs here.

namespace SelfHostDiagnostic {
    export func Fact1(k1: String, v1: String) -> String {
        return "- ${k1}: ${v1}";
    }

    export func Fact2(k1: String, v1: String, k2: String, v2: String) -> String {
        return "${Fact1(k1, v1)}\n${Fact1(k2, v2)}";
    }

    export func Fact3(k1: String, v1: String, k2: String, v2: String, k3: String, v3: String) -> String {
        return "${Fact2(k1, v1, k2, v2)}\n${Fact1(k3, v3)}";
    }

    export func RenderOk(schema: String) -> String {
        return "Diagnostic: ${schema}\nStatus: ok\nDiagnostics: none";
    }

    export func RenderError(schema: String, stage: String, severity: String, code: String, reason: String, fix: String, span: String, facts: String) -> String {
        return "Diagnostic: ${schema}\nStatus: error\nStage: ${stage}\nSeverity: ${severity}\nCode: ${code}\nReason: ${reason}\nFix: ${fix}\nSpan: ${span}\nFacts:\n${facts}";
    }
}
