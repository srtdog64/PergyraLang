// Shared JSON string-scan and emit primitives for self-hosted tools.
//
// This is not a full JSON DOM. It owns bounded read primitives plus JSON
// string, field, object, and array emission used by fact-shaped tools so each
// stage does not invent its own string scanning or quoting rules.
// Schema-specific object shape decisions still belong to the consuming owner.

func CharAt(s: String, i: Int) -> String {
    return Substring(s, i, 1);
}

func FindFrom(hay: String, needle: String, start: Int) -> Int {
    let n: Int = StringLength(hay);
    if start < 0 {
        return -1;
    }
    if start > n {
        return -1;
    }
    let rest: String = Substring(hay, start, n - start);
    let k: Int = StringIndexOf(rest, needle);
    if k < 0 {
        return -1;
    }
    return start + k;
}

func JsonArrayEnd(json: String, open: Int, limit: Int) -> Int {
    let n: Int = StringLength(json);
    let i: Int = open;
    let depth: Int = 0;
    let in_string: Bool = false;
    let escape: Bool = false;
    while i < n && i < limit {
        let c: String = CharAt(json, i);
        if in_string {
            if escape {
                escape = false;
            } else if c == "\\" {
                escape = true;
            } else if c == "\"" {
                in_string = false;
            }
        } else if c == "\"" {
            in_string = true;
        } else if c == "[" {
            depth = depth + 1;
        } else if c == "]" {
            depth = depth - 1;
            if depth == 0 {
                return i;
            }
        }
        i = i + 1;
    }
    return -1;
}

func JsonObjectEnd(json: String, open: Int, limit: Int) -> Int {
    let n: Int = StringLength(json);
    let i: Int = open;
    let depth: Int = 0;
    let in_string: Bool = false;
    let escape: Bool = false;
    while i < n && i < limit {
        let c: String = CharAt(json, i);
        if in_string {
            if escape {
                escape = false;
            } else if c == "\\" {
                escape = true;
            } else if c == "\"" {
                in_string = false;
            }
        } else if c == "\"" {
            in_string = true;
        } else if c == "{" {
            depth = depth + 1;
        } else if c == "}" {
            depth = depth - 1;
            if depth == 0 {
                return i + 1;
            }
        }
        i = i + 1;
    }
    return -1;
}

func ReadJsonString(json: String, open: Int, inout end: Array<Int>) -> String {
    let n: Int = StringLength(json);
    let i: Int = open + 1;
    let out: String = "";
    while i < n {
        let c: String = CharAt(json, i);
        if c == "\"" {
            ArraySet(end, 0, i + 1);
            return out;
        }
        if c == "\\" {
            if i + 1 >= n {
                return "";
            }
            let e: String = CharAt(json, i + 1);
            if e == "n" {
                out = Concat(out, "\n");
            } else if e == "r" {
                out = Concat(out, "\r");
            } else if e == "t" {
                out = Concat(out, "\t");
            } else if e == "\"" {
                out = Concat(out, "\"");
            } else if e == "\\" {
                out = Concat(out, "\\");
            } else {
                out = Concat(out, e);
            }
            i = i + 2;
        } else {
            out = Concat(out, c);
            i = i + 1;
        }
    }
    return "";
}

func JsonFieldString(json: String, start: Int, end: Int, key: String) -> String {
    let p: Int = FindFrom(json, key, start);
    if p < 0 || p >= end {
        return "";
    }
    let vstart: Int = p + StringLength(key);
    if vstart >= end {
        return "";
    }
    vstart = JsonSkipWhitespace(json, vstart, end);
    if vstart >= end || CharAt(json, vstart) != "\"" {
        return "";
    }
    let e: Array<Int> = [0];
    return ReadJsonString(json, vstart, e);
}

func JsonFieldKey(field: String) -> String {
    return Concat(Concat("\"", field), "\":");
}

func JsonDocumentObjectEnd(json: String) -> Int {
    let n: Int = StringLength(json);
    if n <= 0 {
        return -1;
    }
    if CharAt(json, 0) != "{" {
        return -1;
    }
    return JsonObjectEnd(json, 0, n);
}

func JsonDocumentStringFieldEquals(json: String, field: String, expected: String) -> Bool {
    let end: Int = JsonDocumentObjectEnd(json);
    if end <= 0 {
        return false;
    }
    let actual: String = JsonObjectStringField(json, 0, end, field);
    return actual == expected;
}

func JsonDocumentHasField(json: String, field: String) -> Bool {
    let end: Int = JsonDocumentObjectEnd(json);
    if end <= 0 {
        return false;
    }
    return JsonObjectHasField(json, 0, end, field);
}

func JsonFieldArrayBounds(json: String, start: Int, end: Int, field: String, inout bounds: Array<Int>) -> Bool {
    let p: Int = FindFrom(json, JsonFieldKey(field), start);
    if p < 0 || p >= end {
        return false;
    }
    let open: Int = FindFrom(json, "[", p);
    if open < 0 || open >= end {
        return false;
    }
    let close: Int = JsonArrayEnd(json, open, end);
    if close < 0 || close >= end {
        return false;
    }
    ArraySet(bounds, 0, open);
    ArraySet(bounds, 1, close + 1);
    return true;
}

func JsonDocumentNumberField(json: String, field: String) -> String {
    let end: Int = JsonDocumentObjectEnd(json);
    if end <= 0 {
        return "";
    }
    return JsonObjectNumberField(json, 0, end, field);
}

func JsonSkipWhitespace(json: String, index: Int, end: Int) -> Int {
    let i: Int = index;
    while i < end {
        let c: String = CharAt(json, i);
        if c != " " && c != "\n" && c != "\r" && c != "\t" {
            return i;
        }
        i = i + 1;
    }
    return i;
}

func JsonIsDigitChar(c: String) -> Bool {
    return c == "0" || c == "1" || c == "2" || c == "3" || c == "4"
        || c == "5" || c == "6" || c == "7" || c == "8" || c == "9";
}

func JsonEscapeString(value: String) -> String {
    let out: String = "";
    let i: Int = 0;
    let n: Int = StringLength(value);
    while i < n {
        let c: String = CharAt(value, i);
        if c == "\"" {
            out = Concat(out, "\\\"");
        } else if c == "\\" {
            out = Concat(out, "\\\\");
        } else if c == "\n" {
            out = Concat(out, "\\n");
        } else if c == "\r" {
            out = Concat(out, "\\r");
        } else if c == "\t" {
            out = Concat(out, "\\t");
        } else {
            out = Concat(out, c);
        }
        i = i + 1;
    }
    return out;
}

func JsonStringLiteral(value: String) -> String {
    return Concat("\"", Concat(JsonEscapeString(value), "\""));
}

func JsonEmitObject(fields: Array<String>) -> String {
    return Concat("{", Concat(StringJoin(fields, ","), "}"));
}

func JsonEmitArray(items: Array<String>) -> String {
    return Concat("[", Concat(StringJoin(items, ","), "]"));
}

func JsonEmitFieldRaw(key: String, raw_value: String) -> String {
    return Concat(JsonStringLiteral(key), Concat(":", raw_value));
}

func JsonEmitFieldString(key: String, value: String) -> String {
    return JsonEmitFieldRaw(key, JsonStringLiteral(value));
}

func JsonEmitFieldNumber(key: String, value: String) -> String {
    return JsonEmitFieldRaw(key, value);
}

func JsonEmitFieldBool(key: String, value: Bool) -> String {
    let raw: String = "false";
    if value {
        raw = "true";
    }
    return JsonEmitFieldRaw(key, raw);
}

func JsonFieldNumber(json: String, start: Int, end: Int, key: String) -> String {
    let p: Int = FindFrom(json, key, start);
    if p < 0 || p >= end {
        return "";
    }
    let i: Int = p + StringLength(key);
    i = JsonSkipWhitespace(json, i, end);
    let n: Int = StringLength(json);
    let out: String = "";
    while i < n && i < end {
        let c: String = CharAt(json, i);
        if !JsonIsDigitChar(c) {
            if StringLength(out) > 0 {
                return out;
            }
            return "";
        }
        out = Concat(out, c);
        i = i + 1;
    }
    return out;
}

func JsonValueEnd(json: String, value_start: Int, end: Int) -> Int {
    let i: Int = JsonSkipWhitespace(json, value_start, end);
    if i >= end {
        return -1;
    }
    let c: String = CharAt(json, i);
    if c == "\"" {
        let string_end: Array<Int> = [0];
        let ignored: String = ReadJsonString(json, i, string_end);
        if string_end[0] <= i {
            return -1;
        }
        return string_end[0];
    }
    if c == "{" {
        return JsonObjectEnd(json, i, end);
    }
    if c == "[" {
        let array_close: Int = JsonArrayEnd(json, i, end);
        if array_close < 0 {
            return -1;
        }
        return array_close + 1;
    }
    while i < end {
        let d: String = CharAt(json, i);
        if d == "," || d == "}" || d == "]" {
            return i;
        }
        i = i + 1;
    }
    return i;
}

func JsonObjectFieldValueBounds(json: String, start: Int, end: Int, field: String, inout bounds: Array<Int>) -> Bool {
    if start < 0 || end <= start {
        return false;
    }
    if CharAt(json, start) != "{" {
        return false;
    }
    let i: Int = start + 1;
    while i < end {
        i = JsonSkipWhitespace(json, i, end);
        if i >= end {
            return false;
        }
        let c: String = CharAt(json, i);
        if c == "}" {
            return false;
        }
        if c == "," {
            i = i + 1;
            continue;
        }
        if c != "\"" {
            return false;
        }
        let key_end: Array<Int> = [0];
        let key: String = ReadJsonString(json, i, key_end);
        if key_end[0] <= i {
            return false;
        }
        i = JsonSkipWhitespace(json, key_end[0], end);
        if i >= end || CharAt(json, i) != ":" {
            return false;
        }
        i = JsonSkipWhitespace(json, i + 1, end);
        let value_end: Int = JsonValueEnd(json, i, end);
        if value_end < 0 {
            return false;
        }
        if key == field {
            ArraySet(bounds, 0, i);
            ArraySet(bounds, 1, value_end);
            return true;
        }
        i = value_end;
    }
    return false;
}

func JsonObjectStringField(json: String, start: Int, end: Int, field: String) -> String {
    let bounds: Array<Int> = [0, 0];
    if !JsonObjectFieldValueBounds(json, start, end, field, bounds) {
        return "";
    }
    if bounds[0] >= bounds[1] || CharAt(json, bounds[0]) != "\"" {
        return "";
    }
    let string_end: Array<Int> = [0];
    return ReadJsonString(json, bounds[0], string_end);
}

func JsonObjectNumberField(json: String, start: Int, end: Int, field: String) -> String {
    let bounds: Array<Int> = [0, 0];
    if !JsonObjectFieldValueBounds(json, start, end, field, bounds) {
        return "";
    }
    let i: Int = bounds[0];
    let out: String = "";
    while i < bounds[1] {
        let c: String = CharAt(json, i);
        if !JsonIsDigitChar(c) {
            if StringLength(out) > 0 {
                return out;
            }
            return "";
        }
        out = Concat(out, c);
        i = i + 1;
    }
    return out;
}

func JsonObjectHasField(json: String, start: Int, end: Int, field: String) -> Bool {
    let bounds: Array<Int> = [0, 0];
    return JsonObjectFieldValueBounds(json, start, end, field, bounds);
}

func JsonObjectStringFieldEquals(json: String, start: Int, end: Int, field: String, expected: String) -> Bool {
    let actual: String = JsonObjectStringField(json, start, end, field);
    return actual == expected;
}

func JsonObjectBoolFieldEquals(json: String, start: Int, end: Int, field: String, expected: Bool) -> Bool {
    let bounds: Array<Int> = [0, 0];
    if !JsonObjectFieldValueBounds(json, start, end, field, bounds) {
        return false;
    }
    if expected {
        if bounds[0] + 4 > bounds[1] {
            return false;
        }
        return Substring(json, bounds[0], 4) == "true";
    }
    if bounds[0] + 5 > bounds[1] {
        return false;
    }
    return Substring(json, bounds[0], 5) == "false";
}

func JsonArrayObjectBoundsAt(json: String, array_open: Int, array_end: Int, target_index: Int, inout bounds: Array<Int>) -> Bool {
    if target_index < 0 {
        return false;
    }
    let row: Int = 0;
    let i: Int = array_open + 1;
    while i < array_end {
        i = JsonSkipWhitespace(json, i, array_end);
        if i >= array_end {
            return false;
        }
        let c: String = CharAt(json, i);
        if c == "]" {
            return false;
        }
        if c == "," {
            i = i + 1;
            continue;
        }
        if c != "{" {
            return false;
        }
        let obj_end: Int = JsonObjectEnd(json, i, array_end);
        if obj_end < 0 {
            return false;
        }
        if row == target_index {
            ArraySet(bounds, 0, i);
            ArraySet(bounds, 1, obj_end);
            return true;
        }
        row = row + 1;
        i = obj_end;
    }
    return false;
}

func JsonArrayObjectCount(json: String, array_open: Int, array_end: Int) -> Int {
    let count: Int = 0;
    let bounds: Array<Int> = [0, 0];
    while JsonArrayObjectBoundsAt(json, array_open, array_end, count, bounds) {
        count = count + 1;
    }
    return count;
}

func JsonArrayObjectFieldCount(json: String, array_open: Int, array_end: Int, field: String) -> Int {
    let count: Int = 0;
    let row: Int = 0;
    let bounds: Array<Int> = [0, 0];
    while JsonArrayObjectBoundsAt(json, array_open, array_end, row, bounds) {
        if JsonObjectHasField(json, bounds[0], bounds[1], field) {
            count = count + 1;
        }
        row = row + 1;
    }
    return count;
}

func JsonArrayObjectStringFieldEqualsCount(json: String, array_open: Int, array_end: Int, field: String, expected: String) -> Int {
    let count: Int = 0;
    let row: Int = 0;
    let bounds: Array<Int> = [0, 0];
    while JsonArrayObjectBoundsAt(json, array_open, array_end, row, bounds) {
        if JsonObjectStringFieldEquals(json, bounds[0], bounds[1], field, expected) {
            count = count + 1;
        }
        row = row + 1;
    }
    return count;
}

func JsonArrayObjectBoolFieldEqualsCount(json: String, array_open: Int, array_end: Int, field: String, expected: Bool) -> Int {
    let count: Int = 0;
    let row: Int = 0;
    let bounds: Array<Int> = [0, 0];
    while JsonArrayObjectBoundsAt(json, array_open, array_end, row, bounds) {
        if JsonObjectBoolFieldEquals(json, bounds[0], bounds[1], field, expected) {
            count = count + 1;
        }
        row = row + 1;
    }
    return count;
}

func JsonArrayStringAt(json: String, array_open: Int, array_end: Int, target_index: Int) -> String {
    if target_index < 0 {
        return "";
    }
    let row: Int = 0;
    let i: Int = array_open + 1;
    while i < array_end {
        i = JsonSkipWhitespace(json, i, array_end);
        if i >= array_end {
            return "";
        }
        let c: String = CharAt(json, i);
        if c == "]" {
            return "";
        }
        if c == "," {
            i = i + 1;
            continue;
        }
        if c != "\"" {
            return "";
        }
        let value_end: Array<Int> = [0];
        let value: String = ReadJsonString(json, i, value_end);
        if value_end[0] <= i {
            return "";
        }
        if row == target_index {
            return value;
        }
        row = row + 1;
        i = value_end[0];
    }
    return "";
}

func JsonArrayStringCount(json: String, array_open: Int, array_end: Int) -> Int {
    let count: Int = 0;
    let i: Int = array_open + 1;
    while i < array_end {
        i = JsonSkipWhitespace(json, i, array_end);
        if i >= array_end || CharAt(json, i) == "]" {
            return count;
        }
        if CharAt(json, i) == "," {
            i = i + 1;
            continue;
        }
        if CharAt(json, i) != "\"" {
            return count;
        }
        let value_end: Array<Int> = [0];
        let ignored: String = ReadJsonString(json, i, value_end);
        if value_end[0] <= i {
            return count;
        }
        count = count + 1;
        i = value_end[0];
    }
    return count;
}

func JsonObjectArrayStringAt(json: String, start: Int, end: Int, field: String, target_index: Int) -> String {
    let bounds: Array<Int> = [0, 0];
    if !JsonObjectFieldValueBounds(json, start, end, field, bounds) {
        return "";
    }
    if bounds[0] >= bounds[1] || CharAt(json, bounds[0]) != "[" {
        return "";
    }
    return JsonArrayStringAt(json, bounds[0], bounds[1], target_index);
}
