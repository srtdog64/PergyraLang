// Shared JSON string-scan and emit primitives for self-hosted tools.
//
// This is not a full JSON DOM. It owns bounded read primitives plus JSON
// string, field, object, and array emission used by fact-shaped tools so each
// stage does not invent its own string scanning or quoting rules.
// Schema-specific object shape decisions still belong to the consuming owner.

func CharAt(s: String, i: Int) -> String {
    return Substring(s, i, 1);
}

func FindFrom(hay: String, needle: String, start: Int) -> Int {
    let n: Int = StringLength(hay);
    if start < 0 {
        return -1;
    }
    if start > n {
        return -1;
    }
    let rest: String = Substring(hay, start, n - start);
    let k: Int = StringIndexOf(rest, needle);
    if k < 0 {
        return -1;
    }
    return start + k;
}

func JsonArrayEnd(json: String, open: Int, limit: Int) -> Int {
    let n: Int = StringLength(json);
    let i: Int = open;
    let depth: Int = 0;
    let in_string: Bool = false;
    let escape: Bool = false;
    while i < n && i < limit {
        let c: String = CharAt(json, i);
        if in_string {
            if escape {
                escape = false;
            } else if c == "\\" {
                escape = true;
            } else if c == "\"" {
                in_string = false;
            }
        } else if c == "\"" {
            in_string = true;
        } else if c == "[" {
            depth = depth + 1;
        } else if c == "]" {
            depth = depth - 1;
            if depth == 0 {
                return i;
            }
        }
        i = i + 1;
    }
    return -1;
}

func JsonObjectEnd(json: String, open: Int, limit: Int) -> Int {
    let n: Int = StringLength(json);
    let i: Int = open;
    let depth: Int = 0;
    let in_string: Bool = false;
    let escape: Bool = false;
    while i < n && i < limit {
        let c: String = CharAt(json, i);
        if in_string {
            if escape {
                escape = false;
            } else if c == "\\" {
                escape = true;
            } else if c == "\"" {
                in_string = false;
            }
        } else if c == "\"" {
            in_string = true;
        } else if c == "{" {
            depth = depth + 1;
        } else if c == "}" {
            depth = depth - 1;
            if depth == 0 {
                return i + 1;
            }
        }
        i = i + 1;
    }
    return -1;
}

func ReadJsonString(json: String, open: Int, inout end: Array<Int>) -> String {
    let n: Int = StringLength(json);
    let i: Int = open + 1;
    let out: String = "";
    while i < n {
        let c: String = CharAt(json, i);
        if c == "\"" {
            ArraySet(end, 0, i + 1);
            return out;
        }
        if c == "\\" {
            if i + 1 >= n {
                return "";
            }
            let e: String = CharAt(json, i + 1);
            if e == "n" {
                out = Concat(out, "\n");
            } else if e == "r" {
                out = Concat(out, "\r");
            } else if e == "t" {
                out = Concat(out, "\t");
            } else if e == "\"" {
                out = Concat(out, "\"");
            } else if e == "\\" {
                out = Concat(out, "\\");
            } else {
                out = Concat(out, e);
            }
            i = i + 2;
        } else {
            out = Concat(out, c);
            i = i + 1;
        }
    }
    return "";
}

func JsonFieldString(json: String, start: Int, end: Int, key: String) -> String {
    let p: Int = FindFrom(json, key, start);
    if p < 0 || p >= end {
        return "";
    }
    let vstart: Int = p + StringLength(key);
    if vstart >= end {
        return "";
    }
    vstart = JsonSkipWhitespace(json, vstart, end);
    if vstart >= end || CharAt(json, vstart) != "\"" {
        return "";
    }
    let e: Array<Int> = [0];
    return ReadJsonString(json, vstart, e);
}

func JsonFieldKey(field: String) -> String {
    return Concat(Concat("\"", field), "\":");
}

func JsonDocumentObjectEnd(json: String) -> Int {
    let n: Int = StringLength(json);
    if n <= 0 {
        return -1;
    }
    if CharAt(json, 0) != "{" {
        return -1;
    }
    return JsonObjectEnd(json, 0, n);
}

func JsonDocumentStringFieldEquals(json: String, field: String, expected: String) -> Bool {
    let end: Int = JsonDocumentObjectEnd(json);
    if end <= 0 {
        return false;
    }
    let actual: String = JsonFieldString(json, 0, end, JsonFieldKey(field));
    return actual == expected;
}

func JsonDocumentHasField(json: String, field: String) -> Bool {
    let end: Int = JsonDocumentObjectEnd(json);
    if end <= 0 {
        return false;
    }
    let key: String = JsonFieldKey(field);
    let p: Int = FindFrom(json, key, 0);
    return p >= 0 && p < end;
}

func JsonFieldArrayBounds(json: String, start: Int, end: Int, field: String, inout bounds: Array<Int>) -> Bool {
    let p: Int = FindFrom(json, JsonFieldKey(field), start);
    if p < 0 || p >= end {
        return false;
    }
    let open: Int = FindFrom(json, "[", p);
    if open < 0 || open >= end {
        return false;
    }
    let close: Int = JsonArrayEnd(json, open, end);
    if close < 0 || close >= end {
        return false;
    }
    ArraySet(bounds, 0, open);
    ArraySet(bounds, 1, close + 1);
    return true;
}

func JsonDocumentNumberField(json: String, field: String) -> String {
    let end: Int = JsonDocumentObjectEnd(json);
    if end <= 0 {
        return "";
    }
    return JsonFieldNumber(json, 0, end, JsonFieldKey(field));
}

func JsonSkipWhitespace(json: String, index: Int, end: Int) -> Int {
    let i: Int = index;
    while i < end {
        let c: String = CharAt(json, i);
        if c != " " && c != "\n" && c != "\r" && c != "\t" {
            return i;
        }
        i = i + 1;
    }
    return i;
}

func JsonIsDigitChar(c: String) -> Bool {
    return c == "0" || c == "1" || c == "2" || c == "3" || c == "4"
        || c == "5" || c == "6" || c == "7" || c == "8" || c == "9";
}

func JsonEscapeString(value: String) -> String {
    let out: String = "";
    let i: Int = 0;
    let n: Int = StringLength(value);
    while i < n {
        let c: String = CharAt(value, i);
        if c == "\"" {
            out = Concat(out, "\\\"");
        } else if c == "\\" {
            out = Concat(out, "\\\\");
        } else if c == "\n" {
            out = Concat(out, "\\n");
        } else if c == "\r" {
            out = Concat(out, "\\r");
        } else if c == "\t" {
            out = Concat(out, "\\t");
        } else {
            out = Concat(out, c);
        }
        i = i + 1;
    }
    return out;
}

func JsonStringLiteral(value: String) -> String {
    return Concat("\"", Concat(JsonEscapeString(value), "\""));
}

func JsonEmitObject(fields: Array<String>) -> String {
    return Concat("{", Concat(StringJoin(fields, ","), "}"));
}

func JsonEmitArray(items: Array<String>) -> String {
    return Concat("[", Concat(StringJoin(items, ","), "]"));
}

func JsonEmitFieldRaw(key: String, raw_value: String) -> String {
    return Concat(JsonStringLiteral(key), Concat(":", raw_value));
}

func JsonEmitFieldString(key: String, value: String) -> String {
    return JsonEmitFieldRaw(key, JsonStringLiteral(value));
}

func JsonEmitFieldNumber(key: String, value: String) -> String {
    return JsonEmitFieldRaw(key, value);
}

func JsonEmitFieldBool(key: String, value: Bool) -> String {
    let raw: String = "false";
    if value {
        raw = "true";
    }
    return JsonEmitFieldRaw(key, raw);
}

func JsonFieldNumber(json: String, start: Int, end: Int, key: String) -> String {
    let p: Int = FindFrom(json, key, start);
    if p < 0 || p >= end {
        return "";
    }
    let i: Int = p + StringLength(key);
    i = JsonSkipWhitespace(json, i, end);
    let n: Int = StringLength(json);
    let out: String = "";
    while i < n && i < end {
        let c: String = CharAt(json, i);
        if !JsonIsDigitChar(c) {
            if StringLength(out) > 0 {
                return out;
            }
            return "";
        }
        out = Concat(out, c);
        i = i + 1;
    }
    return out;
}

func JsonObjectHasField(json: String, start: Int, end: Int, field: String) -> Bool {
    let p: Int = FindFrom(json, JsonFieldKey(field), start);
    return p >= 0 && p < end;
}

func JsonObjectStringFieldEquals(json: String, start: Int, end: Int, field: String, expected: String) -> Bool {
    let actual: String = JsonFieldString(json, start, end, JsonFieldKey(field));
    return actual == expected;
}

func JsonObjectBoolFieldEquals(json: String, start: Int, end: Int, field: String, expected: Bool) -> Bool {
    let p: Int = FindFrom(json, JsonFieldKey(field), start);
    if p < 0 || p >= end {
        return false;
    }
    let value_start: Int = JsonSkipWhitespace(json, p + StringLength(JsonFieldKey(field)), end);
    if expected {
        if value_start + 4 > end {
            return false;
        }
        return Substring(json, value_start, 4) == "true";
    }
    if value_start + 5 > end {
        return false;
    }
    return Substring(json, value_start, 5) == "false";
}

func JsonArrayObjectCount(json: String, array_open: Int, array_end: Int) -> Int {
    let count: Int = 0;
    let i: Int = array_open + 1;
    while i < array_end {
        let obj_start: Int = FindFrom(json, "{", i);
        if obj_start < 0 || obj_start >= array_end {
            return count;
        }
        let obj_end: Int = JsonObjectEnd(json, obj_start, array_end);
        if obj_end < 0 {
            return count;
        }
        count = count + 1;
        i = obj_end;
    }
    return count;
}

func JsonArrayObjectFieldCount(json: String, array_open: Int, array_end: Int, field: String) -> Int {
    let count: Int = 0;
    let i: Int = array_open + 1;
    while i < array_end {
        let obj_start: Int = FindFrom(json, "{", i);
        if obj_start < 0 || obj_start >= array_end {
            return count;
        }
        let obj_end: Int = JsonObjectEnd(json, obj_start, array_end);
        if obj_end < 0 {
            return count;
        }
        if JsonObjectHasField(json, obj_start, obj_end, field) {
            count = count + 1;
        }
        i = obj_end;
    }
    return count;
}

func JsonArrayObjectStringFieldEqualsCount(json: String, array_open: Int, array_end: Int, field: String, expected: String) -> Int {
    let count: Int = 0;
    let i: Int = array_open + 1;
    while i < array_end {
        let obj_start: Int = FindFrom(json, "{", i);
        if obj_start < 0 || obj_start >= array_end {
            return count;
        }
        let obj_end: Int = JsonObjectEnd(json, obj_start, array_end);
        if obj_end < 0 {
            return count;
        }
        if JsonObjectStringFieldEquals(json, obj_start, obj_end, field, expected) {
            count = count + 1;
        }
        i = obj_end;
    }
    return count;
}

func JsonArrayObjectBoolFieldEqualsCount(json: String, array_open: Int, array_end: Int, field: String, expected: Bool) -> Int {
    let count: Int = 0;
    let i: Int = array_open + 1;
    while i < array_end {
        let obj_start: Int = FindFrom(json, "{", i);
        if obj_start < 0 || obj_start >= array_end {
            return count;
        }
        let obj_end: Int = JsonObjectEnd(json, obj_start, array_end);
        if obj_end < 0 {
            return count;
        }
        if JsonObjectBoolFieldEquals(json, obj_start, obj_end, field, expected) {
            count = count + 1;
        }
        i = obj_end;
    }
    return count;
}

func JsonFirstArrayString(json: String, start: Int, end: Int, key: String) -> String {
    let p: Int = FindFrom(json, key, start);
    if p < 0 || p >= end {
        return "";
    }
    let open: Int = FindFrom(json, "[", p);
    let close: Int = FindFrom(json, "]", open);
    if open < 0 || close < 0 || close >= end {
        return "";
    }
    let q: Int = FindFrom(json, "\"", open);
    if q < 0 || q >= close {
        return "";
    }
    let e: Array<Int> = [0];
    return ReadJsonString(json, q, e);
}
