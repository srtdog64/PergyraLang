// Shared JSON string-read primitives for self-hosted tools.
//
// This is not a full JSON DOM. It owns bounded read primitives plus JSON
// string, field, object, and array reads so each stage does not invent its own
// string scanning rules.
// Schema-specific object shape decisions still belong to the consuming owner.

import "json_scan.pgy";

func JsonArrayEnd(json: String, open: Int, limit: Int) -> Option<Int> {
    let n: Int = StringLength(json);
    let i: Int = open;
    let depth: Int = 0;
    let in_string: Bool = false;
    let escape: Bool = false;
    while i < n && i < limit {
        let c: Int = JsonCharCodeAt(json, n, i);
        if in_string {
            if escape {
                escape = false;
            } else if c == JsonAsciiCode("\\") {
                escape = true;
            } else if c == JsonAsciiCode("\"") {
                in_string = false;
            }
        } else if c == JsonAsciiCode("\"") {
            in_string = true;
        } else if c == JsonAsciiCode("[") {
            depth = depth + 1;
        } else if c == JsonAsciiCode("]") {
            depth = depth - 1;
            if depth == 0 {
                return Some(i);
            }
        }
        i = i + 1;
    }
    return None;
}

func JsonObjectEnd(json: String, open: Int, limit: Int) -> Option<Int> {
    let n: Int = StringLength(json);
    let bounded_limit: Int = limit;
    if bounded_limit > n {
        bounded_limit = n;
    }
    return JsonObjectEndWithin(json, open, bounded_limit);
}

func JsonObjectEndWithin(json: String, open: Int, limit: Int) -> Option<Int> {
    let n: Int = limit;
    let i: Int = open;
    let depth: Int = 0;
    let in_string: Bool = false;
    let escape: Bool = false;
    while i < limit {
        let c: Int = JsonCharCodeAt(json, n, i);
        if in_string {
            if escape { escape = false; }
            else if c == JsonAsciiCode("\\") { escape = true; }
            else if c == JsonAsciiCode("\"") { in_string = false; }
        } else if c == JsonAsciiCode("\"") { in_string = true; }
        else if c == JsonAsciiCode("{") { depth = depth + 1; }
        else if c == JsonAsciiCode("}") {
            depth = depth - 1;
            if depth == 0 { return Some(i + 1); }
        }
        i = i + 1;
    }
    return None;
}

func JsonStringEnd(json: String, open: Int, limit: Int) -> Option<Int> {
    let n: Int = StringLength(json);
    if open < 0 || open >= n || open >= limit || JsonCharCodeAt(json, n, open) != JsonAsciiCode("\"") {
        return None;
    }
    let i: Int = open + 1;
    while i < n && i < limit {
        let c: Int = JsonCharCodeAt(json, n, i);
        if c == JsonAsciiCode("\"") {
            return Some(i + 1);
        }
        if c == JsonAsciiCode("\\") {
            if i + 1 >= n || i + 1 >= limit {
                return None;
            }
            i = i + 2;
            continue;
        }
        i = i + 1;
    }
    return None;
}

func ReadJsonStringBounded(
    json: String,
    open: Int,
    limit: Int,
    inout end: Array<Int>
) -> String {
    let n: Int = limit;
    let close: Int = open + 1;
    let escaped: Bool = false;
    while close < n {
        let c: Int = JsonCharCodeAt(json, n, close);
        if c == JsonAsciiCode("\"") {
            ArraySet(end, 0, close + 1);
            if !escaped {
                if close == open + 1 { return ""; }
                return SubstringWithLen(json, n, open + 1, close - open - 1);
            }
            break;
        }
        if c == JsonAsciiCode("\\") {
            escaped = true;
            if close + 1 >= n { return ""; }
            close = close + 2;
        } else {
            close = close + 1;
        }
    }
    if close >= n { return ""; }
    let i: Int = open + 1;
    let chunks: Array<String> = [];
    while i < close {
        let c: Int = JsonCharCodeAt(json, n, i);
        if c == JsonAsciiCode("\\") {
            let e: Int = JsonCharCodeAt(json, n, i + 1);
            if e == JsonAsciiCode("n") {
                ArrayPush(chunks, "\n");
            } else if e == JsonAsciiCode("r") {
                ArrayPush(chunks, "\r");
            } else if e == JsonAsciiCode("t") {
                ArrayPush(chunks, "\t");
            } else if e == JsonAsciiCode("\"") {
                ArrayPush(chunks, "\"");
            } else if e == JsonAsciiCode("\\") {
                ArrayPush(chunks, "\\");
            } else {
                ArrayPush(chunks, CharAtN(json, n, i + 1));
            }
            i = i + 2;
        } else { ArrayPush(chunks, CharAtN(json, n, i)); i = i + 1; }
    }
    return StringJoin(chunks, "");
}

func ReadJsonString(json: String, open: Int, inout end: Array<Int>) -> String {
    return ReadJsonStringBounded(
        json, open, StringLength(json), end
    );
}

func JsonFieldString(json: String, start: Int, end: Int, key: String) -> String {
    let p_opt: Option<Int> = FindFrom(json, key, start);
    if !IsSome(p_opt) {
        return "";
    }
    let p: Int = UnwrapOption(p_opt);
    if p >= end {
        return "";
    }
    let vstart: Int = p + StringLength(key);
    if vstart >= end {
        return "";
    }
    vstart = JsonSkipWhitespace(json, vstart, end);
    if vstart >= end || JsonCharCodeAt(json, StringLength(json), vstart) != JsonAsciiCode("\"") {
        return "";
    }
    let e: Array<Int> = [0];
    return ReadJsonString(json, vstart, e);
}

func JsonFieldKey(field: String) -> String {
    return "\"${field}\":";
}

func JsonDocumentObjectEnd(json: String) -> Option<Int> {
    let n: Int = StringLength(json);
    if n <= 0 {
        return None;
    }
    if JsonCharCodeAt(json, n, 0) != JsonAsciiCode("{") {
        return None;
    }
    return JsonObjectEnd(json, 0, n);
}

func JsonFieldArrayBounds(json: String, start: Int, end: Int, field: String, inout bounds: Array<Int>) -> Bool {
    let p_opt: Option<Int> = FindFrom(json, JsonFieldKey(field), start);
    if !IsSome(p_opt) {
        return false;
    }
    let p: Int = UnwrapOption(p_opt);
    if p >= end {
        return false;
    }
    let open_opt: Option<Int> = FindFrom(json, "[", p);
    if !IsSome(open_opt) {
        return false;
    }
    let open: Int = UnwrapOption(open_opt);
    if open >= end {
        return false;
    }
    let close_opt: Option<Int> = JsonArrayEnd(json, open, end);
    if !IsSome(close_opt) {
        return false;
    }
    let close: Int = UnwrapOption(close_opt);
    if close >= end {
        return false;
    }
    ArraySet(bounds, 0, open);
    ArraySet(bounds, 1, close + 1);
    return true;
}

func JsonDocumentNumberField(json: String, field: String) -> String {
    let end_opt: Option<Int> = JsonDocumentObjectEnd(json);
    if !IsSome(end_opt) {
        return "";
    }
    return JsonObjectNumberField(json, 0, UnwrapOption(end_opt), field);
}

func JsonFieldNumber(json: String, start: Int, end: Int, key: String) -> String {
    let p_opt: Option<Int> = FindFrom(json, key, start);
    if !IsSome(p_opt) {
        return "";
    }
    let p: Int = UnwrapOption(p_opt);
    if p >= end {
        return "";
    }
    let i: Int = p + StringLength(key);
    i = JsonSkipWhitespace(json, i, end);
    let n: Int = StringLength(json);
    let number_start: Int = i;
    while i < n && i < end {
        let c: Int = JsonCharCodeAt(json, n, i);
        if !JsonIsDigitCode(c) {
            if i > number_start {
                return Substring(json, number_start, i - number_start);
            }
            return "";
        }
        i = i + 1;
    }
    return Substring(json, number_start, i - number_start);
}

func JsonValueEnd(json: String, value_start: Int, end: Int) -> Option<Int> {
    let i: Int = JsonSkipWhitespace(json, value_start, end);
    if i >= end {
        return None;
    }
    let n: Int = StringLength(json);
    let c: Int = JsonCharCodeAt(json, n, i);
    if c == JsonAsciiCode("\"") {
        return JsonStringEnd(json, i, end);
    }
    if c == JsonAsciiCode("{") {
        return JsonObjectEnd(json, i, end);
    }
    if c == JsonAsciiCode("[") {
        let array_close: Int = JsonArrayEnd(json, i, end)?;
        return Some(array_close + 1);
    }
    while i < end {
        let d: Int = JsonCharCodeAt(json, n, i);
        if d == JsonAsciiCode(",") || d == JsonAsciiCode("}") || d == JsonAsciiCode("]") {
            return Some(i);
        }
        i = i + 1;
    }
    return Some(i);
}

func JsonObjectFieldValueBounds(json: String, start: Int, end: Int, field: String, inout bounds: Array<Int>) -> Bool {
    if start < 0 || end <= start {
        return false;
    }
    let n: Int = StringLength(json);
    if JsonCharCodeAt(json, n, start) != JsonAsciiCode("{") {
        return false;
    }
    let i: Int = start + 1;
    while i < end {
        i = JsonSkipWhitespace(json, i, end);
        if i >= end {
            return false;
        }
        let c: Int = JsonCharCodeAt(json, n, i);
        if c == JsonAsciiCode("}") {
            return false;
        }
        if c == JsonAsciiCode(",") {
            i = i + 1;
            continue;
        }
        if c != JsonAsciiCode("\"") {
            return false;
        }
        let key_end: Array<Int> = [0];
        let key: String = ReadJsonString(json, i, key_end);
        if key_end[0] <= i {
            return false;
        }
        i = JsonSkipWhitespace(json, key_end[0], end);
        if i >= end || JsonCharCodeAt(json, n, i) != JsonAsciiCode(":") {
            return false;
        }
        i = JsonSkipWhitespace(json, i + 1, end);
        let value_end_opt: Option<Int> = JsonValueEnd(json, i, end);
        if !IsSome(value_end_opt) {
            return false;
        }
        let value_end: Int = UnwrapOption(value_end_opt);
        if key == field {
            ArraySet(bounds, 0, i);
            ArraySet(bounds, 1, value_end);
            return true;
        }
        i = value_end;
    }
    return false;
}

func JsonObjectStringField(json: String, start: Int, end: Int, field: String) -> String {
    let value: Option<String> = JsonObjectStringFieldOpt(json, start, end, field);
    if !IsSome(value) {
        return "";
    }
    return UnwrapOption(value);
}

func JsonObjectStringFieldOpt(json: String, start: Int, end: Int, field: String) -> Option<String> {
    let bounds: Array<Int> = [0, 0];
    if !JsonObjectFieldValueBounds(json, start, end, field, bounds) {
        return None;
    }
    if bounds[0] >= bounds[1] || JsonCharCodeAt(json, StringLength(json), bounds[0]) != JsonAsciiCode("\"") {
        return None;
    }
    let string_end: Array<Int> = [0];
    let value: String = ReadJsonString(json, bounds[0], string_end);
    if string_end[0] <= bounds[0] {
        return None;
    }
    return Some(value);
}

func JsonObjectNumberField(json: String, start: Int, end: Int, field: String) -> String {
    let value: Option<String> = JsonObjectNumberFieldOpt(json, start, end, field);
    if !IsSome(value) {
        return "";
    }
    return UnwrapOption(value);
}

func JsonObjectNumberFieldOpt(json: String, start: Int, end: Int, field: String) -> Option<String> {
    let bounds: Array<Int> = [0, 0];
    if !JsonObjectFieldValueBounds(json, start, end, field, bounds) {
        return None;
    }
    let i: Int = bounds[0];
    let n: Int = StringLength(json);
    if i < bounds[1] &&
        JsonCharCodeAt(json, n, i) == JsonAsciiCode("-") {
        i = i + 1;
        if i >= bounds[1] {
            return None;
        }
    }
    while i < bounds[1] {
        let c: Int = JsonCharCodeAt(json, n, i);
        if !JsonIsDigitCode(c) {
            return None;
        }
        i = i + 1;
    }
    if i == bounds[0] {
        return None;
    }
    return Some(Substring(json, bounds[0], i - bounds[0]));
}

func JsonObjectHasField(json: String, start: Int, end: Int, field: String) -> Bool {
    let bounds: Array<Int> = [0, 0];
    return JsonObjectFieldValueBounds(json, start, end, field, bounds);
}

func JsonObjectStringFieldEquals(json: String, start: Int, end: Int, field: String, expected: String) -> Bool {
    let actual: Option<String> = JsonObjectStringFieldOpt(json, start, end, field);
    if !IsSome(actual) {
        return false;
    }
    return UnwrapOption(actual) == expected;
}

func JsonObjectBoolFieldEquals(json: String, start: Int, end: Int, field: String, expected: Bool) -> Bool {
    let bounds: Array<Int> = [0, 0];
    if !JsonObjectFieldValueBounds(json, start, end, field, bounds) {
        return false;
    }
    if expected {
        if bounds[0] + 4 > bounds[1] {
            return false;
        }
        return Substring(json, bounds[0], 4) == "true";
    }
    if bounds[0] + 5 > bounds[1] {
        return false;
    }
    return Substring(json, bounds[0], 5) == "false";
}

func JsonArrayObjectBoundsAt(json: String, array_open: Int, array_end: Int, target_index: Int, inout bounds: Array<Int>) -> Bool {
    if target_index < 0 {
        return false;
    }
    let row: Int = 0;
    let i: Int = array_open + 1;
    while i < array_end {
        i = JsonSkipWhitespace(json, i, array_end);
        if i >= array_end {
            return false;
        }
        let c: Int = JsonCharCodeAt(json, StringLength(json), i);
        if c == JsonAsciiCode("]") {
            return false;
        }
        if c == JsonAsciiCode(",") {
            i = i + 1;
            continue;
        }
        if c != JsonAsciiCode("{") {
            return false;
        }
        let obj_end_opt: Option<Int> = JsonObjectEnd(json, i, array_end);
        if !IsSome(obj_end_opt) {
            return false;
        }
        let obj_end: Int = UnwrapOption(obj_end_opt);
        if row == target_index {
            ArraySet(bounds, 0, i);
            ArraySet(bounds, 1, obj_end);
            return true;
        }
        row = row + 1;
        i = obj_end;
    }
    return false;
}

func JsonArrayNextObjectBounds(json: String, cursor: Int, array_end: Int, inout bounds: Array<Int>) -> Bool {
    let n: Int = array_end;
    let i: Int = JsonSkipWhitespaceWithin(json, cursor, array_end);
    if i < array_end && JsonCharCodeAt(json, n, i) == JsonAsciiCode(",") {
        i = JsonSkipWhitespaceWithin(json, i + 1, array_end);
    }
    if i >= array_end || JsonCharCodeAt(json, n, i) == JsonAsciiCode("]") {
        return false;
    }
    if JsonCharCodeAt(json, n, i) != JsonAsciiCode("{") {
        return false;
    }
    let object_end_opt: Option<Int> = JsonObjectEndWithin(json, i, array_end);
    if !IsSome(object_end_opt) {
        return false;
    }
    ArraySet(bounds, 0, i);
    ArraySet(bounds, 1, UnwrapOption(object_end_opt));
    return true;
}

func JsonArrayObjectCount(json: String, array_open: Int, array_end: Int) -> Int {
    let count: Int = 0;
    let bounds: Array<Int> = [0, 0];
    while JsonArrayObjectBoundsAt(json, array_open, array_end, count, bounds) {
        count = count + 1;
    }
    return count;
}

func JsonArrayObjectFieldCount(json: String, array_open: Int, array_end: Int, field: String) -> Int {
    let count: Int = 0;
    let row: Int = 0;
    let bounds: Array<Int> = [0, 0];
    while JsonArrayObjectBoundsAt(json, array_open, array_end, row, bounds) {
        if JsonObjectHasField(json, bounds[0], bounds[1], field) {
            count = count + 1;
        }
        row = row + 1;
    }
    return count;
}

func JsonArrayObjectStringFieldEqualsCount(json: String, array_open: Int, array_end: Int, field: String, expected: String) -> Int {
    let count: Int = 0;
    let row: Int = 0;
    let bounds: Array<Int> = [0, 0];
    while JsonArrayObjectBoundsAt(json, array_open, array_end, row, bounds) {
        if JsonObjectStringFieldEquals(json, bounds[0], bounds[1], field, expected) {
            count = count + 1;
        }
        row = row + 1;
    }
    return count;
}

func JsonArrayObjectBoolFieldEqualsCount(json: String, array_open: Int, array_end: Int, field: String, expected: Bool) -> Int {
    let count: Int = 0;
    let row: Int = 0;
    let bounds: Array<Int> = [0, 0];
    while JsonArrayObjectBoundsAt(json, array_open, array_end, row, bounds) {
        if JsonObjectBoolFieldEquals(json, bounds[0], bounds[1], field, expected) {
            count = count + 1;
        }
        row = row + 1;
    }
    return count;
}
