// Exact-bound JSON fact reads for positions produced by a validated document.
//
// These functions never rediscover the whole document length.  Callers may use
// them only with end-exclusive bounds carried from the JSON structure owner.

import "json.pgy";
func JsonStringValueEqualsWithin(
    json: String,
    value_open: Int,
    value_end: Int,
    expected: String
) -> Bool {
    if value_open < 0 || value_end <= value_open + 1 ||
        JsonCharCodeAt(json, value_end, value_open) != JsonAsciiCode("\"") ||
        JsonCharCodeAt(json, value_end, value_end - 1) != JsonAsciiCode("\"") {
        return false;
    }
    let expected_length: Int = StringLength(expected);
    let raw_length: Int = value_end - value_open - 2;
    let row: Int = 0;
    while row < raw_length {
        let actual: Int = JsonCharCodeAt(
            json, value_end, value_open + 1 + row
        );
        if actual == JsonAsciiCode("\\") {
            let decoded_end: Array<Int> = [0];
            return ReadJsonStringBounded(
                json, value_open, value_end, decoded_end
            ) == expected && decoded_end[0] == value_end;
        }
        if row >= expected_length ||
            actual != JsonCharCodeAt(expected, expected_length, row) {
            return false;
        }
        row = row + 1;
    }
    return row == expected_length;
}

func JsonObjectKeyEqualsWithin(
    json: String, key_open: Int, key_end: Int, expected: String
) -> Bool {
    return JsonStringValueEqualsWithin(
        json, key_open, key_end, expected
    );
}

func JsonArrayEndWithin(
    json: String,
    open: Int,
    limit: Int
) -> Option<Int> {
    let n: Int = limit;
    let i: Int = open;
    let depth: Int = 0;
    let in_string: Bool = false;
    let escape: Bool = false;
    while i < limit {
        let c: Int = JsonCharCodeAt(json, n, i);
        if in_string {
            if escape {
                escape = false;
            } else if c == JsonAsciiCode("\\") {
                escape = true;
            } else if c == JsonAsciiCode("\"") {
                in_string = false;
            }
        } else if c == JsonAsciiCode("\"") {
            in_string = true;
        } else if c == JsonAsciiCode("[") {
            depth = depth + 1;
        } else if c == JsonAsciiCode("]") {
            depth = depth - 1;
            if depth == 0 { return Some(i); }
        }
        i = i + 1;
    }
    return None;
}

func JsonStringEndWithin(
    json: String,
    open: Int,
    limit: Int
) -> Option<Int> {
    let n: Int = limit;
    if open < 0 || open >= limit ||
        JsonCharCodeAt(json, n, open) != JsonAsciiCode("\"") {
        return None;
    }
    let i: Int = open + 1;
    while i < limit {
        let c: Int = JsonCharCodeAt(json, n, i);
        if c == JsonAsciiCode("\"") { return Some(i + 1); }
        if c == JsonAsciiCode("\\") {
            if i + 1 >= limit { return None; }
            i = i + 2;
            continue;
        }
        i = i + 1;
    }
    return None;
}

func JsonValueEndWithin(
    json: String,
    value_start: Int,
    end: Int
) -> Option<Int> {
    let i: Int = JsonSkipWhitespaceWithin(json, value_start, end);
    if i >= end { return None; }
    let n: Int = end;
    let c: Int = JsonCharCodeAt(json, n, i);
    if c == JsonAsciiCode("\"") {
        return JsonStringEndWithin(json, i, end);
    }
    if c == JsonAsciiCode("{") {
        return JsonObjectEndWithin(json, i, end);
    }
    if c == JsonAsciiCode("[") {
        let array_close: Int = JsonArrayEndWithin(json, i, end)?;
        return Some(array_close + 1);
    }
    while i < end {
        let d: Int = JsonCharCodeAt(json, n, i);
        if d == JsonAsciiCode(",") || d == JsonAsciiCode("}") ||
            d == JsonAsciiCode("]") {
            return Some(i);
        }
        i = i + 1;
    }
    return Some(i);
}

func JsonObjectFieldValueBoundsWithin(
    json: String,
    start: Int,
    end: Int,
    field: String,
    inout bounds: Array<Int>
) -> Bool {
    if start < 0 || end <= start { return false; }
    let n: Int = end;
    if JsonCharCodeAt(json, n, start) != JsonAsciiCode("{") {
        return false;
    }
    let i: Int = start + 1;
    while i < end {
        i = JsonSkipWhitespaceWithin(json, i, end);
        if i >= end { return false; }
        let c: Int = JsonCharCodeAt(json, n, i);
        if c == JsonAsciiCode("}") { return false; }
        if c == JsonAsciiCode(",") {
            i = i + 1;
            continue;
        }
        if c != JsonAsciiCode("\"") { return false; }
        let key_end_opt: Option<Int> = JsonStringEndWithin(json, i, end);
        if !IsSome(key_end_opt) { return false; }
        let key_end: Int = UnwrapOption(key_end_opt);
        let matches: Bool = JsonObjectKeyEqualsWithin(
            json, i, key_end, field
        );
        i = JsonSkipWhitespaceWithin(json, key_end, end);
        if i >= end || JsonCharCodeAt(json, n, i) != JsonAsciiCode(":") {
            return false;
        }
        i = JsonSkipWhitespaceWithin(json, i + 1, end);
        let value_end_opt: Option<Int> = JsonValueEndWithin(json, i, end);
        if !IsSome(value_end_opt) { return false; }
        let value_end: Int = UnwrapOption(value_end_opt);
        if matches {
            ArraySet(bounds, 0, i);
            ArraySet(bounds, 1, value_end);
            return true;
        }
        i = value_end;
    }
    return false;
}

func JsonObjectStringFieldOptWithin(
    json: String,
    start: Int,
    end: Int,
    field: String
) -> Option<String> {
    let bounds: Array<Int> = [0, 0];
    if !JsonObjectFieldValueBoundsWithin(
        json, start, end, field, bounds
    ) {
        return None;
    }
    if bounds[0] >= bounds[1] ||
        JsonCharCodeAt(json, bounds[1], bounds[0]) != JsonAsciiCode("\"") {
        return None;
    }
    let string_end: Array<Int> = [0];
    let value: String = ReadJsonStringBounded(
        json, bounds[0], bounds[1], string_end
    );
    if string_end[0] <= bounds[0] { return None; }
    return Some(value);
}

func JsonIntegerValueOptWithin(
    json: String, start: Int, end: Int
) -> Option<String> {
    let i: Int = start;
    if i < end && JsonCharCodeAt(json, end, i) == JsonAsciiCode("-") {
        i = i + 1;
        if i >= end { return None; }
    }
    while i < end {
        if !JsonIsDigitCode(JsonCharCodeAt(json, end, i)) { return None; }
        i = i + 1;
    }
    if i == start { return None; }
    return Some(SubstringWithLen(json, end, start, end - start));
}

func JsonBoolValueOptWithin(
    json: String, start: Int, end: Int
) -> Option<Bool> {
    if start + 4 == end && SubEqualsWithLen(
        json, end, start, 4, "true"
    ) { return Some(true); }
    if start + 5 == end && SubEqualsWithLen(
        json, end, start, 5, "false"
    ) { return Some(false); }
    return None;
}

func JsonObjectNumberFieldOptWithin(
    json: String,
    start: Int,
    end: Int,
    field: String
) -> Option<String> {
    let bounds: Array<Int> = [0, 0];
    if !JsonObjectFieldValueBoundsWithin(
        json, start, end, field, bounds
    ) {
        return None;
    }
    return JsonIntegerValueOptWithin(json, bounds[0], bounds[1]);
}

func JsonObjectBoolFieldEqualsWithin(
    json: String,
    start: Int,
    end: Int,
    field: String,
    expected: Bool
) -> Bool {
    let bounds: Array<Int> = [0, 0];
    if !JsonObjectFieldValueBoundsWithin(
        json, start, end, field, bounds
    ) {
        return false;
    }
    let value: Option<Bool> = JsonBoolValueOptWithin(
        json, bounds[0], bounds[1]
    );
    return IsSome(value) && UnwrapOption(value) == expected;
}

func JsonObjectTwoFieldValueBoundsWithin(
    json: String,
    start: Int,
    end: Int,
    first_field: String,
    second_field: String,
    inout first_bounds: Array<Int>,
    inout second_bounds: Array<Int>
) -> Bool {
    if start < 0 || end <= start { return false; }
    let n: Int = end;
    if JsonCharCodeAt(json, n, start) != JsonAsciiCode("{") {
        return false;
    }
    let first_found: Bool = false;
    let second_found: Bool = false;
    let i: Int = start + 1;
    while i < end {
        i = JsonSkipWhitespaceWithin(json, i, end);
        if i >= end { return false; }
        let c: Int = JsonCharCodeAt(json, n, i);
        if c == JsonAsciiCode("}") { return true; }
        if c == JsonAsciiCode(",") {
            i = i + 1;
            continue;
        }
        if c != JsonAsciiCode("\"") { return false; }
        let key_end_opt: Option<Int> = JsonStringEndWithin(json, i, end);
        if !IsSome(key_end_opt) { return false; }
        let key_end: Int = UnwrapOption(key_end_opt);
        let matches_first: Bool = JsonObjectKeyEqualsWithin(
            json, i, key_end, first_field
        );
        let matches_second: Bool = JsonObjectKeyEqualsWithin(
            json, i, key_end, second_field
        );
        i = JsonSkipWhitespaceWithin(json, key_end, end);
        if i >= end || JsonCharCodeAt(json, n, i) != JsonAsciiCode(":") {
            return false;
        }
        i = JsonSkipWhitespaceWithin(json, i + 1, end);
        let value_end_opt: Option<Int> = JsonValueEndWithin(json, i, end);
        if !IsSome(value_end_opt) { return false; }
        let value_end: Int = UnwrapOption(value_end_opt);
        if matches_first {
            ArraySet(first_bounds, 0, i);
            ArraySet(first_bounds, 1, value_end);
            first_found = true;
        }
        if matches_second {
            ArraySet(second_bounds, 0, i);
            ArraySet(second_bounds, 1, value_end);
            second_found = true;
        }
        if first_found && second_found { return true; }
        i = value_end;
    }
    return false;
}

struct JsonArrayStringFact {
    valid: Bool;
    count: Int;
    target_found: Bool;
    target_value: String;
}

func JsonArrayStringFactWithin(
    json: String,
    array_open: Int,
    array_end: Int,
    target_index: Int
) -> JsonArrayStringFact {
    if array_open < 0 || array_end <= array_open + 1 ||
        JsonCharCodeAt(json, array_end, array_open) != JsonAsciiCode("[") {
        return JsonArrayStringFact(false, 0, false, "");
    }
    let count: Int = 0;
    let target_found: Bool = false;
    let target_value: String = "";
    let expect_value: Bool = true;
    let after_comma: Bool = false;
    let i: Int = array_open + 1;
    while i < array_end {
        i = JsonSkipWhitespaceWithin(json, i, array_end);
        if i >= array_end {
            return JsonArrayStringFact(false, 0, false, "");
        }
        let c: Int = JsonCharCodeAt(json, array_end, i);
        if c == JsonAsciiCode("]") {
            if after_comma || i + 1 != array_end {
                return JsonArrayStringFact(false, 0, false, "");
            }
            return JsonArrayStringFact(
                true, count, target_found, target_value
            );
        }
        if !expect_value {
            if c != JsonAsciiCode(",") {
                return JsonArrayStringFact(false, 0, false, "");
            }
            expect_value = true;
            after_comma = true;
            i = i + 1;
            continue;
        }
        if c != JsonAsciiCode("\"") {
            return JsonArrayStringFact(false, 0, false, "");
        }
        let value_end_opt: Option<Int> = JsonStringEndWithin(
            json, i, array_end
        );
        if !IsSome(value_end_opt) {
            return JsonArrayStringFact(false, 0, false, "");
        }
        let value_end: Int = UnwrapOption(value_end_opt);
        if count == target_index {
            let decoded_end: Array<Int> = [0];
            target_value = ReadJsonStringBounded(
                json, i, value_end, decoded_end
            );
            if decoded_end[0] != value_end {
                return JsonArrayStringFact(false, 0, false, "");
            }
            target_found = true;
        }
        count = count + 1;
        i = value_end;
        expect_value = false;
        after_comma = false;
    }
    return JsonArrayStringFact(false, 0, false, "");
}

func JsonArrayStringAt(
    json: String, array_open: Int, array_end: Int, target_index: Int
) -> String {
    if target_index < 0 { return ""; }
    let fact: JsonArrayStringFact = JsonArrayStringFactWithin(
        json, array_open, array_end, target_index
    );
    if !fact.valid || !fact.target_found { return ""; }
    return fact.target_value;
}

func JsonArrayStringCount(
    json: String, array_open: Int, array_end: Int
) -> Int {
    let fact: JsonArrayStringFact = JsonArrayStringFactWithin(
        json, array_open, array_end, 0 - 1
    );
    if !fact.valid { return 0; }
    return fact.count;
}

func JsonObjectArrayStringAt(
    json: String, start: Int, end: Int,
    field: String, target_index: Int
) -> String {
    let bounds: Array<Int> = [0, 0];
    if !JsonObjectFieldValueBoundsWithin(
            json, start, end, field, bounds
        ) || bounds[0] >= bounds[1] ||
        JsonCharCodeAt(json, bounds[1], bounds[0]) != JsonAsciiCode("[") {
        return "";
    }
    return JsonArrayStringAt(
        json, bounds[0], bounds[1], target_index
    );
}
