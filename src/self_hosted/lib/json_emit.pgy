// Shared JSON emission primitives for self-hosted fact-shaped tools.

func JsonEscapeStringWithAllocator(
    value: String,
    result_allocator: Allocator
) -> String {
    let output: TextBuilder = TextBuilderNew(StringLength(value) + 1);
    let i: Int = 0;
    let n: Int = StringLength(value);
    let span_start: Int = 0;
    while i < n {
        let escaped: String = "";
        if SubEqualsWithLen(value, n, i, 1, "\"") {
            escaped = "\\\"";
        } else if SubEqualsWithLen(value, n, i, 1, "\\") {
            escaped = "\\\\";
        } else if SubEqualsWithLen(value, n, i, 1, "\n") {
            escaped = "\\n";
        } else if SubEqualsWithLen(value, n, i, 1, "\r") {
            escaped = "\\r";
        } else if SubEqualsWithLen(value, n, i, 1, "\t") {
            escaped = "\\t";
        }
        if escaped != "" {
            if i > span_start {
                TextBuilderAppend(
                    output, Substring(value, span_start, i - span_start)
                );
            }
            TextBuilderAppend(output, escaped);
            span_start = i + 1;
        }
        i = i + 1;
    }
    if span_start < n {
        TextBuilderAppend(
            output, Substring(value, span_start, n - span_start)
        );
    }
    let escaped_value: String = TextBuilderFinish(
        output, result_allocator
    );
    return escaped_value;
}

func JsonEscapeString(value: String) -> String {
    let result_allocator: Allocator = AllocatorResult();
    let escaped: String = JsonEscapeStringWithAllocator(
        value, result_allocator
    );
    AllocatorDestroy(result_allocator);
    return escaped;
}

func JsonStringLiteralWithAllocator(
    value: String,
    result_allocator: Allocator
) -> String {
    let escaped: String = JsonEscapeStringWithAllocator(
        value, result_allocator
    );
    let output: TextBuilder = TextBuilderNew(StringLength(escaped) + 3);
    TextBuilderAppend(output, "\"");
    TextBuilderAppend(output, escaped);
    TextBuilderAppend(output, "\"");
    let literal: String = TextBuilderFinish(output, result_allocator);
    return literal;
}

func JsonStringLiteral(value: String) -> String {
    let result_allocator: Allocator = AllocatorResult();
    let literal: String = JsonStringLiteralWithAllocator(
        value, result_allocator
    );
    AllocatorDestroy(result_allocator);
    return literal;
}

// FileWrite is synchronous on both native backends.  Keep the escaped and
// quoted transient bytes in one call-local pool and release them only after
// the write returns; production artifact writers must not retain the result.
func JsonStringLiteralWriteFile(
    output: Int,
    value: String
) -> Bool {
    let value_length: Int = StringLength(value);
    if value_length < 0 || value_length > 536870909 { return false; }
    let transient_allocator: Allocator = AllocatorPool(
        value_length * 4 + 8
    );
    let literal: String = JsonStringLiteralWithAllocator(
        value, transient_allocator
    );
    FileWrite(output, literal);
    AllocatorDestroy(transient_allocator);
    return true;
}

func JsonEmitCollection(
    items: Array<String>, open_token: String, close_token: String
) -> String {
    let capacity: Int = StringLength(open_token) +
        StringLength(close_token) + 1;
    let size_i: Int = 0;
    while size_i < ArrayLength(items) {
        capacity = capacity + StringLength(items[size_i]);
        if size_i > 0 { capacity = capacity + 1; }
        size_i = size_i + 1;
    }
    let output_allocator: Allocator = AllocatorResult();
    let output: TextBuilder = TextBuilderNew(capacity);
    TextBuilderAppend(output, open_token);
    let i: Int = 0;
    while i < ArrayLength(items) {
        if i > 0 { TextBuilderAppend(output, ","); }
        TextBuilderAppend(output, items[i]);
        i = i + 1;
    }
    TextBuilderAppend(output, close_token);
    let collection: String = TextBuilderFinish(output, output_allocator);
    AllocatorDestroy(output_allocator);
    return collection;
}

func JsonEmitObject(fields: Array<String>) -> String {
    return JsonEmitCollection(fields, "{", "}");
}

func JsonEmitArray(items: Array<String>) -> String {
    return JsonEmitCollection(items, "[", "]");
}

func JsonEmitFieldRaw(key: String, raw_value: String) -> String {
    let encoded_key: String = JsonStringLiteral(key);
    let output_allocator: Allocator = AllocatorResult();
    let output: TextBuilder = TextBuilderNew(
        StringLength(encoded_key) + StringLength(raw_value) + 2
    );
    TextBuilderAppend(output, encoded_key);
    TextBuilderAppend(output, ":");
    TextBuilderAppend(output, raw_value);
    let field: String = TextBuilderFinish(output, output_allocator);
    AllocatorDestroy(output_allocator);
    return field;
}

func JsonEmitFieldString(key: String, value: String) -> String {
    return JsonEmitFieldRaw(key, JsonStringLiteral(value));
}

func JsonEmitFieldNumber(key: String, value: String) -> String {
    return JsonEmitFieldRaw(key, value);
}

func JsonEmitFieldBool(key: String, value: Bool) -> String {
    let raw: String = "false";
    if value {
        raw = "true";
    }
    return JsonEmitFieldRaw(key, raw);
}
