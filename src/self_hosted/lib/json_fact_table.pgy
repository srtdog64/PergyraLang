// JSON object fact table owner for self-hosted tools.
//
// This owner captures one object boundary as the stable JSON fact. Consumers ask
// for field spans through accessors instead of discovering object bounds.

import "json.pgy";
import "json_bounded_fact_read.pgy";

struct JsonObjectFactTable {
    let valid: Bool;
    let json: String;
    let start: Int;
    let end: Int;
}

struct JsonArrayObjectFactTable {
    let valid: Bool;
    let json: String;
    let start: Int;
    let end: Int;
}

func JsonObjectFactTableSchema() -> String {
    return "pgy.selfhost.json-object-fact-table.v1";
}

func EmptyJsonObjectFactTable() -> JsonObjectFactTable {
    return JsonObjectFactTable(false, "", 0, 0);
}

func EmptyJsonArrayObjectFactTable() -> JsonArrayObjectFactTable {
    return JsonArrayObjectFactTable(false, "", 0, 0);
}

func JsonValueKindAt(json: String, start: Int, end: Int) -> String {
    let i: Int = JsonSkipWhitespace(json, start, end);
    if i >= end {
        return "invalid";
    }
    let c: Int = JsonCharCodeAt(json, end, i);
    if c == JsonAsciiCode("\"") {
        return "string";
    }
    if c == JsonAsciiCode("{") {
        return "object";
    }
    if c == JsonAsciiCode("[") {
        return "array";
    }
    if c == JsonAsciiCode("t") || c == JsonAsciiCode("f") {
        return "bool";
    }
    if c == JsonAsciiCode("n") {
        return "null";
    }
    if JsonIsDigitCode(c) {
        return "number";
    }
    return "scalar";
}

func JsonObjectFactTableFromBounds(json: String, start: Int, end: Int) -> JsonObjectFactTable {
    if start < 0 || end <= start {
        return EmptyJsonObjectFactTable();
    }
    if JsonCharCodeAt(json, end, start) != JsonAsciiCode("{") {
        return EmptyJsonObjectFactTable();
    }
    let object_end_opt: Option<Int> = JsonObjectEndWithin(json, start, end);
    if !IsSome(object_end_opt) {
        return EmptyJsonObjectFactTable();
    }
    if UnwrapOption(object_end_opt) != end {
        return EmptyJsonObjectFactTable();
    }
    return JsonObjectFactTable(true, json, start, end);
}

func JsonDocumentObjectFactTable(json: String) -> JsonObjectFactTable {
    let end_opt: Option<Int> = JsonDocumentObjectEnd(json);
    if !IsSome(end_opt) {
        return EmptyJsonObjectFactTable();
    }
    let end: Int = UnwrapOption(end_opt);
    return JsonObjectFactTable(true, json, 0, end);
}

func JsonObjectFactTableReady(ref table: JsonObjectFactTable) -> Bool {
    return table.valid && table.start >= 0 && table.end > table.start;
}

func JsonObjectFactCount(ref table: JsonObjectFactTable) -> Int {
    if !JsonObjectFactTableReady(table) {
        return 0;
    }
    let count: Int = 0;
    let i: Int = table.start + 1;
    while i < table.end {
        i = JsonSkipWhitespace(table.json, i, table.end);
        if i >= table.end {
            return 0;
        }
        let c: Int = JsonCharCodeAt(table.json, table.end, i);
        if c == JsonAsciiCode("}") {
            return count;
        }
        if c == JsonAsciiCode(",") {
            i = i + 1;
            continue;
        }
        if c != JsonAsciiCode("\"") {
            return 0;
        }
        let key_end: Array<Int> = [0];
        let ignored: String = ReadJsonStringBounded(
            table.json, i, table.end, key_end
        );
        if key_end[0] <= i {
            return 0;
        }
        i = JsonSkipWhitespace(table.json, key_end[0], table.end);
        if i >= table.end ||
            JsonCharCodeAt(table.json, table.end, i) != JsonAsciiCode(":") {
            return 0;
        }
        i = JsonSkipWhitespace(table.json, i + 1, table.end);
        let value_end_opt: Option<Int> = JsonValueEndWithin(
            table.json, i, table.end
        );
        if !IsSome(value_end_opt) {
            return 0;
        }
        count = count + 1;
        i = UnwrapOption(value_end_opt);
    }
    return 0;
}

func JsonObjectFactIndex(ref table: JsonObjectFactTable, field: String) -> Option<Int> {
    if !JsonObjectFactTableReady(table) {
        return None;
    }
    let i: Int = 0;
    let cursor: Int = table.start + 1;
    while cursor < table.end {
        cursor = JsonSkipWhitespace(table.json, cursor, table.end);
        if cursor >= table.end {
            return None;
        }
        let c: Int = JsonCharCodeAt(table.json, table.end, cursor);
        if c == JsonAsciiCode("}") {
            return None;
        }
        if c == JsonAsciiCode(",") {
            cursor = cursor + 1;
            continue;
        }
        if c != JsonAsciiCode("\"") {
            return None;
        }
        let key_end: Array<Int> = [0];
        let key: String = ReadJsonStringBounded(
            table.json, cursor, table.end, key_end
        );
        if key_end[0] <= cursor {
            return None;
        }
        cursor = JsonSkipWhitespace(table.json, key_end[0], table.end);
        if cursor >= table.end ||
            JsonCharCodeAt(table.json, table.end, cursor) != JsonAsciiCode(":") {
            return None;
        }
        cursor = JsonSkipWhitespace(table.json, cursor + 1, table.end);
        let value_end_opt: Option<Int> = JsonValueEndWithin(
            table.json, cursor, table.end
        );
        if !IsSome(value_end_opt) {
            return None;
        }
        if key == field {
            return Some(i);
        }
        i = i + 1;
        cursor = UnwrapOption(value_end_opt);
    }
    return None;
}

func JsonObjectFactHasField(ref table: JsonObjectFactTable, field: String) -> Bool {
    let index_opt: Option<Int> = JsonObjectFactIndex(table, field);
    return IsSome(index_opt);
}

func JsonObjectFactValueBounds(ref table: JsonObjectFactTable, field: String, inout bounds: Array<Int>) -> Bool {
    if !JsonObjectFactTableReady(table) {
        return false;
    }
    return JsonObjectFieldValueBoundsWithin(
        table.json, table.start, table.end, field, bounds
    );
}

func JsonObjectFactValueKind(ref table: JsonObjectFactTable, field: String) -> Option<String> {
    let bounds: Array<Int> = [0, 0];
    if !JsonObjectFactValueBounds(table, field, bounds) {
        return None;
    }
    return Some(JsonValueKindAt(table.json, bounds[0], bounds[1]));
}

func JsonObjectFactArrayBounds(ref table: JsonObjectFactTable, field: String, inout bounds: Array<Int>) -> Bool {
    let kind_opt: Option<String> = JsonObjectFactValueKind(table, field);
    if !IsSome(kind_opt) {
        return false;
    }
    if UnwrapOption(kind_opt) != "array" {
        return false;
    }
    return JsonObjectFactValueBounds(table, field, bounds);
}

func JsonObjectFactObjectTable(ref table: JsonObjectFactTable, field: String) -> JsonObjectFactTable {
    let kind_opt: Option<String> = JsonObjectFactValueKind(table, field);
    if !IsSome(kind_opt) {
        return EmptyJsonObjectFactTable();
    }
    if UnwrapOption(kind_opt) != "object" {
        return EmptyJsonObjectFactTable();
    }
    let bounds: Array<Int> = [0, 0];
    if !JsonObjectFactValueBounds(table, field, bounds) {
        return EmptyJsonObjectFactTable();
    }
    return JsonObjectFactTableFromBounds(table.json, bounds[0], bounds[1]);
}

func JsonObjectFactStringFieldOpt(ref table: JsonObjectFactTable, field: String) -> Option<String> {
    if !JsonObjectFactTableReady(table) {
        return None;
    }
    return JsonObjectStringFieldOptWithin(
        table.json, table.start, table.end, field
    );
}

func JsonObjectFactStringFieldEquals(ref table: JsonObjectFactTable, field: String, expected: String) -> Bool {
    let actual: Option<String> = JsonObjectFactStringFieldOpt(table, field);
    if !IsSome(actual) {
        return false;
    }
    return UnwrapOption(actual) == expected;
}

func JsonDocumentFactStringFieldEquals(json: String, field: String, expected: String) -> Bool {
    let root: JsonObjectFactTable = JsonDocumentObjectFactTable(json);
    return JsonObjectFactStringFieldEquals(root, field, expected);
}

func JsonObjectFactNumberFieldOpt(ref table: JsonObjectFactTable, field: String) -> Option<String> {
    if !JsonObjectFactTableReady(table) {
        return None;
    }
    return JsonObjectNumberFieldOptWithin(
        table.json, table.start, table.end, field
    );
}

func JsonScalarToken(json: String, start: Int, end: Int) -> String {
    let value_start: Int = JsonSkipWhitespace(json, start, end);
    if value_start >= end {
        return "";
    }
    if JsonCharCodeAt(json, end, value_start) == JsonAsciiCode("\"") {
        let string_end: Array<Int> = [0];
        return ReadJsonStringBounded(json, value_start, end, string_end);
    }
    return Substring(json, value_start, end - value_start);
}

func JsonCollectScalarFieldValues(
    json: String,
    start: Int,
    end: Int,
    field: String,
    inout values: Array<String>
) -> Void {
    if start < 0 || end <= start {
        return;
    }
    let n: Int = end;
    let open: Int = JsonCharCodeAt(json, n, start);
    if open == JsonAsciiCode("{") {
        let i: Int = start + 1;
        while i < end {
            i = JsonSkipWhitespace(json, i, end);
            if i >= end || JsonCharCodeAt(json, n, i) == JsonAsciiCode("}") {
                return;
            }
            if JsonCharCodeAt(json, n, i) == JsonAsciiCode(",") {
                i = i + 1;
                continue;
            }
            if JsonCharCodeAt(json, n, i) != JsonAsciiCode("\"") {
                return;
            }
            let key_end: Array<Int> = [0];
            let key: String = ReadJsonStringBounded(json, i, end, key_end);
            if key_end[0] <= i {
                return;
            }
            i = JsonSkipWhitespace(json, key_end[0], end);
            if i >= end || JsonCharCodeAt(json, n, i) != JsonAsciiCode(":") {
                return;
            }
            i = JsonSkipWhitespace(json, i + 1, end);
            let value_end_opt: Option<Int> = JsonValueEndWithin(json, i, end);
            if !IsSome(value_end_opt) {
                return;
            }
            let value_end: Int = UnwrapOption(value_end_opt);
            if key == field {
                ArrayPush(values, JsonScalarToken(json, i, value_end));
            }
            let value_open: Int = JsonCharCodeAt(json, n, i);
            if value_open == JsonAsciiCode("{") || value_open == JsonAsciiCode("[") {
                JsonCollectScalarFieldValues(json, i, value_end, field, values);
            }
            i = value_end;
        }
        return;
    }
    if open == JsonAsciiCode("[") {
        let j: Int = start + 1;
        while j < end {
            j = JsonSkipWhitespace(json, j, end);
            if j >= end || JsonCharCodeAt(json, n, j) == JsonAsciiCode("]") {
                return;
            }
            if JsonCharCodeAt(json, n, j) == JsonAsciiCode(",") {
                j = j + 1;
                continue;
            }
            let item_end_opt: Option<Int> = JsonValueEndWithin(json, j, end);
            if !IsSome(item_end_opt) {
                return;
            }
            let item_end: Int = UnwrapOption(item_end_opt);
            let item_open: Int = JsonCharCodeAt(json, n, j);
            if item_open == JsonAsciiCode("{") || item_open == JsonAsciiCode("[") {
                JsonCollectScalarFieldValues(json, j, item_end, field, values);
            }
            j = item_end;
        }
    }
}

func JsonScalarFieldValues(json: String, field: String) -> Array<String> {
    let values: Array<String> = [];
    let root: JsonObjectFactTable = JsonDocumentObjectFactTable(json);
    if !JsonObjectFactTableReady(root) {
        return values;
    }
    JsonCollectScalarFieldValues(json, root.start, root.end, field, values);
    return values;
}

func JsonArrayObjectFactTableFromBounds(json: String, start: Int, end: Int) -> JsonArrayObjectFactTable {
    if start < 0 || end <= start {
        return EmptyJsonArrayObjectFactTable();
    }
    if JsonCharCodeAt(json, end, start) != JsonAsciiCode("[") {
        return EmptyJsonArrayObjectFactTable();
    }
    let array_end_opt: Option<Int> = JsonArrayEndWithin(json, start, end);
    if !IsSome(array_end_opt) {
        return EmptyJsonArrayObjectFactTable();
    }
    if UnwrapOption(array_end_opt) + 1 != end {
        return EmptyJsonArrayObjectFactTable();
    }
    return JsonArrayObjectFactTable(true, json, start, end);
}

func JsonObjectFactArrayObjectTable(ref table: JsonObjectFactTable, field: String) -> JsonArrayObjectFactTable {
    let bounds: Array<Int> = [0, 0];
    if !JsonObjectFactArrayBounds(table, field, bounds) {
        return EmptyJsonArrayObjectFactTable();
    }
    return JsonArrayObjectFactTableFromBounds(table.json, bounds[0], bounds[1]);
}

func JsonArrayObjectFactTableReady(ref table: JsonArrayObjectFactTable) -> Bool {
    return table.valid && table.start >= 0 && table.end > table.start;
}

func JsonArrayObjectFactCount(ref table: JsonArrayObjectFactTable) -> Int {
    if !JsonArrayObjectFactTableReady(table) {
        return 0;
    }
    let count: Int = 0;
    let cursor: Int = table.start + 1;
    let bounds: Array<Int> = [0, 0];
    while JsonArrayNextObjectBounds(
        table.json, cursor, table.end, bounds
    ) {
        count = count + 1;
        cursor = bounds[1];
    }
    return count;
}

func JsonArrayObjectFactAt(ref table: JsonArrayObjectFactTable, index: Int) -> JsonObjectFactTable {
    if !JsonArrayObjectFactTableReady(table) {
        return EmptyJsonObjectFactTable();
    }
    if index < 0 { return EmptyJsonObjectFactTable(); }
    let row: Int = 0;
    let cursor: Int = table.start + 1;
    let bounds: Array<Int> = [0, 0];
    while JsonArrayNextObjectBounds(
        table.json, cursor, table.end, bounds
    ) {
        if row == index {
            return JsonObjectFactTableFromBounds(
                table.json, bounds[0], bounds[1]
            );
        }
        row = row + 1;
        cursor = bounds[1];
    }
    return EmptyJsonObjectFactTable();
}

func JsonArrayObjectFactFieldCount(ref table: JsonArrayObjectFactTable, field: String) -> Int {
    let count: Int = 0;
    let row: Int = 0;
    let row_fact: JsonObjectFactTable = JsonArrayObjectFactAt(table, row);
    while JsonObjectFactTableReady(row_fact) {
        if JsonObjectFactHasField(row_fact, field) {
            count = count + 1;
        }
        row = row + 1;
        row_fact = JsonArrayObjectFactAt(table, row);
    }
    return count;
}

func JsonArrayObjectFactStringFieldEqualsCount(
    ref table: JsonArrayObjectFactTable,
    field: String,
    expected: String
) -> Int {
    let count: Int = 0;
    let row: Int = 0;
    let row_fact: JsonObjectFactTable = JsonArrayObjectFactAt(table, row);
    while JsonObjectFactTableReady(row_fact) {
        let value_bounds: Array<Int> = [0, 0];
        if JsonObjectFactValueBounds(row_fact, field, value_bounds) {
            if value_bounds[0] < value_bounds[1] &&
                JsonCharCodeAt(
                    table.json, value_bounds[1], value_bounds[0]
                ) == JsonAsciiCode("\"") {
                let value_end: Array<Int> = [0];
                let actual: String = ReadJsonStringBounded(
                    table.json, value_bounds[0], value_bounds[1], value_end
                );
                if value_end[0] > value_bounds[0] && actual == expected {
                    count = count + 1;
                }
            }
        }
        row = row + 1;
        row_fact = JsonArrayObjectFactAt(table, row);
    }
    return count;
}

func JsonArrayObjectFactBoolFieldEqualsCount(
    ref table: JsonArrayObjectFactTable,
    field: String,
    expected: Bool
) -> Int {
    let count: Int = 0;
    let row: Int = 0;
    let row_fact: JsonObjectFactTable = JsonArrayObjectFactAt(table, row);
    while JsonObjectFactTableReady(row_fact) {
        let value_bounds: Array<Int> = [0, 0];
        if JsonObjectFactValueBounds(row_fact, field, value_bounds) {
            if expected {
                if value_bounds[0] + 4 <= value_bounds[1] &&
                    Substring(table.json, value_bounds[0], 4) == "true" {
                    count = count + 1;
                }
            } else if value_bounds[0] + 5 <= value_bounds[1] &&
                Substring(table.json, value_bounds[0], 5) == "false" {
                count = count + 1;
            }
        }
        row = row + 1;
        row_fact = JsonArrayObjectFactAt(table, row);
    }
    return count;
}
