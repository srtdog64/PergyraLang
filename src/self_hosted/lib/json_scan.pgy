// Shared JSON scan primitives for self-hosted tools.
//
// This owner deliberately stops at cursor/string scanning. JSON object shape
// and field semantics stay in json.pgy; emission stays in json_emit.pgy.

func JsonCharAt(s: String, i: Int) -> String {
    return CharAtN(s, StringLength(s), i);
}

func JsonCharCodeAt(s: String, length: Int, i: Int) -> Int {
    return CharCode(s, length, i);
}

func JsonAsciiCode(character: String) -> Int {
    return CharCode(character, StringLength(character), 0);
}

func FindFrom(hay: String, needle: String, start: Int) -> Option<Int> {
    let n: Int = StringLength(hay);
    if start < 0 {
        return None;
    }
    if start > n {
        return None;
    }
    let k: Int = SubIndexOfWithLen(hay, n, start, n - start, needle);
    if k < 0 {
        return None;
    }
    return Some(start + k);
}

func JsonSkipWhitespaceWithin(json: String, index: Int, end: Int) -> Int {
    let i: Int = index;
    let n: Int = end;
    while i < end {
        let c: Int = JsonCharCodeAt(json, n, i);
        if c != JsonAsciiCode(" ") && c != JsonAsciiCode("\n") && c != JsonAsciiCode("\r") && c != JsonAsciiCode("\t") {
            return i;
        }
        i = i + 1;
    }
    return i;
}

func JsonSkipWhitespace(json: String, index: Int, end: Int) -> Int {
    let i: Int = index;
    let n: Int = StringLength(json);
    while i < end {
        let c: Int = JsonCharCodeAt(json, n, i);
        if c != JsonAsciiCode(" ") && c != JsonAsciiCode("\n") &&
            c != JsonAsciiCode("\r") && c != JsonAsciiCode("\t") {
            return i;
        }
        i = i + 1;
    }
    return i;
}

func JsonIsDigitChar(c: String) -> Bool {
    return c == "0" || c == "1" || c == "2" || c == "3" || c == "4"
        || c == "5" || c == "6" || c == "7" || c == "8" || c == "9";
}

func JsonIsDigitCode(c: Int) -> Bool {
    return c >= JsonAsciiCode("0") && c <= JsonAsciiCode("9");
}
