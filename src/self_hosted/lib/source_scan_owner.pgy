// Shared source character and trivia scanning owner.

func SourceCharAt(s: String, i: Int) -> String {
    let n: Int = StringLength(s);
    if i < 0 || i >= n {
        return "";
    }
    return CharAtN(s, n, i);
}

func SourceByteAt(s: String, length: Int, i: Int) -> Int {
    return CharCode(s, length, i);
}

func SourceByteOf(character: String) -> Int {
    return CharCode(character, StringLength(character), 0);
}

func SourceByteIsAlpha(byte: Int) -> Bool {
    return (byte >= 97 && byte <= 122) ||
        (byte >= 65 && byte <= 90) || byte == 95;
}

func SourceByteIsDigit(byte: Int) -> Bool {
    return byte >= 48 && byte <= 57;
}

func SourceByteIsAlphaNum(byte: Int) -> Bool {
    return SourceByteIsAlpha(byte) || SourceByteIsDigit(byte);
}

func SourceByteIsWhitespace(byte: Int) -> Bool {
    return byte == 32 || byte == 9 || byte == 10 || byte == 13;
}

func IsAlpha(c: String) -> Bool {
    let n: Int = StringLength(c);
    return n == 1 && SourceByteIsAlpha(SourceByteAt(c, n, 0));
}

func IsDigit(c: String) -> Bool {
    let n: Int = StringLength(c);
    return n == 1 && SourceByteIsDigit(SourceByteAt(c, n, 0));
}

func IsAlphaNum(c: String) -> Bool {
    return IsAlpha(c) || IsDigit(c);
}

func SkipWhitespaceAndComments(content: String, start: Int) -> Int {
    let n: Int = StringLength(content);
    let i: Int = start;
    while i < n {
        let c: Int = SourceByteAt(content, n, i);
        if SourceByteIsWhitespace(c) {
            i = i + 1;
            continue;
        }
        if c == SourceByteOf("/") &&
            SourceByteAt(content, n, i + 1) == SourceByteOf("/") {
            while i < n && SourceByteAt(content, n, i) != SourceByteOf("\n") {
                i = i + 1;
            }
            continue;
        }
        if c == SourceByteOf("/") &&
            SourceByteAt(content, n, i + 1) == SourceByteOf("*") {
            i = i + 2;
            while i < n {
                if SourceByteAt(content, n, i) == SourceByteOf("*") &&
                    SourceByteAt(content, n, i + 1) == SourceByteOf("/") {
                    i = i + 2;
                    break;
                }
                i = i + 1;
            }
            continue;
        }
        return i;
    }
    return i;
}
