// Self-host LSP diagnostic payload entrypoint.

import "diagnostics_owner.pgy";
import "request_owner.pgy";
import "response_owner.pgy";
import "session_owner.pgy";
import "transport_owner.pgy";

func Main() -> Void with caps env, io_read {
    let args: Array<String> = Args();
    if LspTransportProbeRequested(args) {
        RunLspTransportFrameProbeFromArgs(args);
        return;
    }
    if LspTransportStreamProbeRequested(args) {
        RunLspTransportStreamProbeFromArgs(args);
        return;
    }
    if LspRequestDispatchProbeRequested(args) {
        RunLspRequestDispatchProbeFromArgs(args);
        return;
    }
    if LspResponseProbeRequested(args) {
        RunLspResponseProbeFromArgs(args);
        return;
    }
    if LspSessionReplayProbeRequested(args) {
        RunLspSessionReplayProbeFromArgs(args);
        return;
    }
    RunLspDiagnosticsFromArgs(args);
}
