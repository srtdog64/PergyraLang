// Self-host LSP request dispatch owner.
//
// LSP-2c consumes buffered transport bodies and JSON object facts to classify
// requests. It deliberately stops before the live session read loop, response
// emission, hover, completion, or document-store mutation.

import "../lib/json_emit.pgy";
import "../lib/json_fact_table.pgy";
import "transport_owner.pgy";

func LspRequestDispatchSchema() -> String {
    return "pgy.selfhost.lsp-request-dispatch.v1";
}

func LspRequestDispatchStreamSchema() -> String {
    return "pgy.selfhost.lsp-request-dispatch-stream.v1";
}

func LspRequestDispatchProbeMode() -> String {
    return "--request-dispatch-probe";
}

func LspRequestDispatchProbeRequested(args: Array<String>) -> Bool {
    return ArrayLength(args) > 0 && args[0] == LspRequestDispatchProbeMode();
}

func LspRequestKindForMethod(method: String) -> String {
    if method == "initialize" {
        return "initialize";
    }
    if method == "initialized" {
        return "initialized";
    }
    if method == "shutdown" {
        return "shutdown";
    }
    if method == "exit" {
        return "exit";
    }
    if method == "textDocument/didOpen" {
        return "didOpen";
    }
    if method == "textDocument/didChange" {
        return "didChange";
    }
    return "unsupported";
}

func LspRequestIdText(root: JsonObjectFactTable) -> String {
    let id_num: Option<String> = JsonObjectFactNumberFieldOpt(root, "id");
    if IsSome(id_num) {
        return UnwrapOption(id_num);
    }
    let id_str: Option<String> = JsonObjectFactStringFieldOpt(root, "id");
    if IsSome(id_str) {
        return UnwrapOption(id_str);
    }
    return "";
}

func LspRequestResponseRequired(method: String, has_id: Bool) -> Bool {
    if !has_id {
        return false;
    }
    if method == "initialized" || method == "exit" {
        return false;
    }
    if method == "textDocument/didOpen" || method == "textDocument/didChange" {
        return false;
    }
    return true;
}

func LspRequestPlanJsonError(reason: String) -> Option<String> {
    let fields: Array<String> = [];
    ArrayPush(fields, JsonEmitFieldString("schema", LspRequestDispatchSchema()));
    ArrayPush(fields, JsonEmitFieldBool("ok", false));
    ArrayPush(fields, JsonEmitFieldString("reason", reason));
    ArrayPush(fields, JsonEmitFieldString("method", ""));
    ArrayPush(fields, JsonEmitFieldString("requestKind", ""));
    ArrayPush(fields, JsonEmitFieldBool("hasId", false));
    ArrayPush(fields, JsonEmitFieldString("id", ""));
    ArrayPush(fields, JsonEmitFieldBool("responseRequired", false));
    ArrayPush(fields, JsonEmitFieldBool("paramsPresent", false));
    return Some(JsonEmitObject(fields));
}

func LspRequestPlanOk(body: String) -> Bool {
    let root: JsonObjectFactTable = JsonDocumentObjectFactTable(body);
    if !JsonObjectFactTableReady(root) {
        return false;
    }
    if !JsonObjectFactStringFieldEquals(root, "jsonrpc", "2.0") {
        return false;
    }
    let method_opt: Option<String> = JsonObjectFactStringFieldOpt(root, "method");
    return IsSome(method_opt);
}

func LspRequestPlanJson(body: String) -> Option<String> {
    let root: JsonObjectFactTable = JsonDocumentObjectFactTable(body);
    if !JsonObjectFactTableReady(root) {
        return LspRequestPlanJsonError("invalid_json");
    }
    if !JsonObjectFactStringFieldEquals(root, "jsonrpc", "2.0") {
        return LspRequestPlanJsonError("invalid_jsonrpc");
    }
    let method_opt: Option<String> = JsonObjectFactStringFieldOpt(root, "method");
    if !IsSome(method_opt) {
        return LspRequestPlanJsonError("missing_method");
    }

    let method: String = UnwrapOption(method_opt);
    let id: String = LspRequestIdText(root);
    let has_id: Bool = StringLength(id) > 0;
    let fields: Array<String> = [];
    ArrayPush(fields, JsonEmitFieldString("schema", LspRequestDispatchSchema()));
    ArrayPush(fields, JsonEmitFieldBool("ok", true));
    ArrayPush(fields, JsonEmitFieldString("reason", ""));
    ArrayPush(fields, JsonEmitFieldString("method", method));
    ArrayPush(fields, JsonEmitFieldString("requestKind", LspRequestKindForMethod(method)));
    ArrayPush(fields, JsonEmitFieldBool("hasId", has_id));
    ArrayPush(fields, JsonEmitFieldString("id", id));
    ArrayPush(fields, JsonEmitFieldBool("responseRequired", LspRequestResponseRequired(method, has_id)));
    ArrayPush(fields, JsonEmitFieldBool("paramsPresent", JsonObjectFactHasField(root, "params")));
    return Some(JsonEmitObject(fields));
}

func LspRequestDispatchStreamJson(buffer: String) -> Option<String> {
    let requests: Array<String> = [];
    let cursor: Int = 0;
    let partial_reason: Option<String> = None;
    let errors: Int = 0;
    while cursor < StringLength(buffer) {
        let tail: String = Substring(buffer, cursor, StringLength(buffer) - cursor);
        let complete_opt: Option<Int> = LspTransportCompleteFrameLength(tail);
        if !IsSome(complete_opt) {
            partial_reason = LspTransportPartialReason(tail);
            cursor = StringLength(buffer);
        } else {
            let body_opt: Option<String> = LspTransportFrameBody(tail);
            if !IsSome(body_opt) {
                partial_reason = Some("body_incomplete");
                cursor = StringLength(buffer);
            } else {
                let body: String = UnwrapOption(body_opt);
                if !LspRequestPlanOk(body) {
                    errors = errors + 1;
                }
                ArrayPush(requests, UnwrapOption(LspRequestPlanJson(body)));
                cursor = cursor + UnwrapOption(complete_opt);
            }
        }
    }

    let partial_reason_text: String = "";
    if IsSome(partial_reason) {
        partial_reason_text = UnwrapOption(partial_reason);
    }
    let fields: Array<String> = [];
    ArrayPush(fields, JsonEmitFieldString("schema", LspRequestDispatchStreamSchema()));
    ArrayPush(fields, JsonEmitFieldBool("ok", errors == 0 && !IsSome(partial_reason)));
    ArrayPush(fields, JsonEmitFieldNumber("frameCount", ToString(ArrayLength(requests))));
    ArrayPush(fields, JsonEmitFieldNumber("errors", ToString(errors)));
    ArrayPush(fields, JsonEmitFieldString("partialReason", partial_reason_text));
    ArrayPush(fields, JsonEmitFieldRaw("requests", JsonEmitArray(requests)));
    return Some(JsonEmitObject(fields));
}

func LspRequestDispatchContractReady() -> Bool {
    let body: String = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}";
    let plan: String = UnwrapOption(LspRequestPlanJson(body));
    if StringIndexOf(plan, LspRequestDispatchSchema()) < 0 {
        return false;
    }
    if StringIndexOf(plan, "\"method\":\"initialize\"") < 0 {
        return false;
    }
    if StringIndexOf(plan, "\"responseRequired\":true") < 0 {
        return false;
    }
    let bad: String = UnwrapOption(LspRequestPlanJson("{\"jsonrpc\":\"2.0\",\"id\":2}"));
    return StringIndexOf(bad, "\"reason\":\"missing_method\"") >= 0;
}

func RunLspRequestDispatchProbeFromArgs(args: Array<String>) -> Void with caps io_read {
    let max_bytes: Int = 4096;
    if ArrayLength(args) > 1 {
        max_bytes = ToInt(args[1]);
    }
    let buffer: String = ReadStdin(max_bytes);
    Log(UnwrapOption(LspRequestDispatchStreamJson(buffer)));
}
