// Shared AstTreeArtifact -> self-host MIR fact graph producer.
import "program_fact_owner.pgy";
import "program_domain_projection_owner.pgy";
import "../semantic/callable_receiver_carriage_policy_owner.pgy";
import "declaration_rows_owner.pgy";
import "routine_entry_owner.pgy";
import "routine_local_inventory_owner.pgy";
import "routine_receiver_carriage_owner.pgy";
import "routine_cfg_append_owner.pgy";
import "routine_build_storage_lifetime_owner.pgy";
import "ast_arena_storage_lifetime_owner.pgy";
import "intent_routine_owner.pgy";
import "intent_execution_source_plan_owner.pgy";
import "canonical_instruction_id_owner.pgy";
import "collection_ownership_receipt_projection_owner.pgy";
import "../dir/domain_graph_fact_owner.pgy";
import "../dir/domain_projection_map_row_owner.pgy";
import "../compiler/machine_layer_declaration_consumer.pgy";
import "../semantic/ast_statement_fact_owner.pgy";
import "../semantic/ast_statement_type_query_owner.pgy";
import "../semantic/ast_generic_specialization_query_owner.pgy";
import "../semantic/role_operator_resolution_owner.pgy";
func SelfMirAppendRoutine(facts: SelfMirProgramFacts, analysis: SemanticAstArtifactAnalysis,
    ref input: SelfMirRoutineInput, signature_index: Int, build: SelfMirRoutineBuild,
    initializer_types: SemanticAstInitializerTypeFacts,
    collection_ownership: SemanticAstCollectionOwnershipVerdict
) -> SelfMirProgramFacts {
    let function_node_id: Int = analysis.signatures.function_node_ids[signature_index];
    if !SelfMirDestructureTypeFactsReadyForRoutine(analysis, initializer_types, function_node_id
    ) {
        return SelfMirProgramFactsError(
            facts, "mir_destructure_type_fact_missing",
            "MIR producer requires verified semantic destructure type facts"
        );
    }
    // `facts` is the one functional-update owner. Grow its fields in place;
    // copying every descriptor into a second `rows` value before growth would
    // leave stale aliases whenever an Array reallocates.
    facts.routines.destructure_type_facts =
        SelfMirDestructureTypeFactRowsAppendRoutine(
            facts.routines.destructure_type_facts, analysis,
            initializer_types, function_node_id
        );
    facts.routines.loop_flows = SelfMirLoopFlowRowsAppendRoutine(
        facts.routines.loop_flows, analysis.statements, function_node_id
    );
    ArrayPush(
        facts.routines.node_ids,
        analysis.signatures.function_node_ids[signature_index]
    );
    ArrayPushOwnedString(
        facts.routines.names, analysis.signatures.names[signature_index]
    );
    let receiver: SelfMirRoutineReceiverFact = SelfMirRoutineReceiverForOwner(
        facts.declarations, analysis.signatures.owner_names[signature_index]
    );
    if !receiver.ok {
        return SelfMirProgramFactsError(
            facts, "mir_receiver_carriage_owner_invalid",
            "MIR receiver carriage requires one exact declaration owner"
        );
    }
    ArrayPushOwnedString(facts.routines.owners, receiver.owner);
    ArrayPushOwnedString(facts.routines.kinds, receiver.routine_kind);
    let source_module_path: String = analysis.signatures.module_paths[signature_index];
    if source_module_path == "" {
        return SelfMirProgramFactsError(facts, "mir_source_module_path_missing", "MIR routine requires admitted source module provenance");
    }
    ArrayPushOwnedString(
        facts.routines.source_module_paths, source_module_path
    );
    ArrayPushOwnedString(
        facts.routines.receiver_carriages, receiver.carriage
    );
    let owner: String = receiver.owner;
    ArrayPushOwnedString(
        facts.routines.return_types,
        analysis.signatures.return_types[signature_index]
    );
    ArrayPush(
        facts.routines.generic_starts,
        ArrayLength(facts.routines.generic_names)
    );
    ArrayPush(
        facts.routines.generic_counts,
        analysis.signatures.generic_counts[signature_index]
    );
    let generic_i: Int = 0;
    let generic_start: Int = analysis.signatures.generic_starts[signature_index];
    while generic_i < analysis.signatures.generic_counts[signature_index] {
        ArrayPushOwnedString(
            facts.routines.generic_names,
            analysis.signatures.generic_names[generic_start + generic_i]
        );
        ArrayPushOwnedString(facts.routines.generic_constraints,
            analysis.signatures.generic_constraint_type_names[
                generic_start + generic_i]);
        generic_i = generic_i + 1;
    }
    ArrayPush(
        facts.routines.param_starts,
        ArrayLength(facts.routines.param_names)
    );
    ArrayPush(
        facts.routines.param_counts,
        analysis.signatures.param_counts[signature_index]
    );
    let param_i: Int = 0;
    let param_start: Int = analysis.signatures.param_starts[signature_index];
    while param_i < analysis.signatures.param_counts[signature_index] {
        let row: Int = param_start + param_i;
        ArrayPushOwnedString(
            facts.routines.param_names, analysis.signatures.param_names[row]
        );
        ArrayPush(facts.routines.param_node_ids, analysis.signatures.param_node_ids[row]);
        let param_type: String = analysis.signatures.param_types[row];
        if owner != "" && analysis.signatures.param_names[row] == "self" {
            ArrayPushOwnedString(facts.routines.param_types, "");
        } else {
            ArrayPushOwnedString(facts.routines.param_types, param_type);
        }
        let abi_kind: Int = CallableParameterAbiKind(
            analysis.signatures.param_modes[row],
            analysis.signatures.param_names[row], param_type,
            analysis.constructors);
        ArrayPush(facts.routines.param_abi_kinds, abi_kind);
        ArrayPush(
            facts.routines.param_resource_kinds,
            SelfMirParamResourceKindForType(param_type)
        );
        param_i = param_i + 1;
    }
    ArrayPush(facts.routines.block_starts, ArrayLength(facts.cfg.blocks.ids));
    ArrayPush(facts.routines.block_counts, ArrayLength(build.cfg.blocks.ids));
    let inventory: SelfMirRoutineLocalInventory =
        SelfMirRoutineLocalInventoryFromInput(input, function_node_id);
    if !inventory.ok {
        return SelfMirProgramFactsError(
            facts, "mir_source_local_inventory_invalid",
            inventory.diagnostic_message
        );
    }
    ArrayPush(
        facts.routines.local_starts,
        ArrayLength(facts.routines.local_names)
    );
    ArrayPush(facts.routines.local_counts, ArrayLength(inventory.names));
    let local_i: Int = 0;
    while local_i < ArrayLength(inventory.names) {
        ArrayPushOwnedString(
            facts.routines.local_names, inventory.names[local_i]
        );
        ArrayPushOwnedString(
            facts.routines.local_types, inventory.types[local_i]
        );
        ArrayPush(facts.routines.local_binding_syntax_ids,
            inventory.binding_syntax_ids[local_i]);
        local_i = local_i + 1;
    }
    ArrayPush(
        facts.routines.iteration_starts,
        ArrayLength(facts.routines.iteration_node_ids)
    );
    let statement_range: SemanticAstLocalBindingFunctionRange =
        SemanticAstStatementRangeForFunction(
            analysis.statements, function_node_id
        );
    if !statement_range.ok {
        return SelfMirProgramFactsError(
            facts, "mir_iteration_function_range_invalid",
            "MIR iteration facts require a function-owned statement range"
        );
    }
    let iteration_count: Int = 0;
    let statement_i: Int = statement_range.start;
    while statement_i < statement_range.end {
        if analysis.statements.kind_tags[statement_i] ==
            TypedAstKindForStmtTag() {
            let iteration_row_opt: Option<Int> =
                SelfMirIterationRowForNodeFromReadyRows(
                    input.iterations, analysis.statements.node_ids[statement_i]
                );
            if !IsSome(iteration_row_opt) {
                return SelfMirProgramFactsError(
                    facts, "mir_iteration_type_fact_missing",
                    "MIR for-loop statement requires one iteration type row"
                );
            }
            let iteration_row: Int = UnwrapOption(iteration_row_opt);
            ArrayPush(
                facts.routines.iteration_node_ids,
                input.iterations.node_ids[iteration_row]
            );
            ArrayPushOwnedString(
                facts.routines.iteration_binding_types,
                input.iterations.binding_type_names[iteration_row]
            );
            ArrayPushOwnedString(
                facts.routines.iteration_iterable_types,
                input.iterations.iterable_type_names[iteration_row]
            );
            ArrayPush(
                facts.routines.iteration_collection_hoists,
                input.iterations.collection_hoists[iteration_row]
            );
            iteration_count = iteration_count + 1;
        }
        statement_i = statement_i + 1;
    }
    ArrayPush(facts.routines.iteration_counts, iteration_count);
    facts.routines.collection_ownership_facts =
        SelfMirCollectionOwnershipFactRowsAppendRoutine(
            facts.routines.collection_ownership_facts, collection_ownership,
            function_node_id, inventory.ok, inventory.names,
            inventory.types, inventory.binding_syntax_ids,
            analysis.signatures.param_types,
            analysis.signatures.param_node_ids, analysis.constructors
        );
    if facts.routines.collection_ownership_facts.routine_counts[
            ArrayLength(
                facts.routines.collection_ownership_facts.routine_counts
            ) - 1
        ] < 0 {
        return SelfMirProgramFactsError(
            facts, "mir_collection_ownership_fact_invalid",
            "MIR collection ownership rows are missing or inconsistent"
        );
    }
    facts.collection_ownership_receipts =
        SelfMirCollectionOwnershipReceiptRowsAppendRoutine(
            facts.collection_ownership_receipts,
            collection_ownership, analysis.expression_surfaces,
            function_node_id, build.cfg.instructions,
            build.cfg.local_refs
        );
    if !facts.collection_ownership_receipts.valid {
        return SelfMirProgramFactsError(
            facts, "mir_collection_ownership_receipt_invalid",
            "MIR collection ownership receipt identity did not attach exactly once"
        );
    }
    facts.cfg = SelfMirAppendCfg(facts.cfg, build.cfg);
    facts.instruction_abi_receipts =
        SelfMirInstructionAbiReceiptRowsAppend(
            facts.instruction_abi_receipts,
            build.cfg.instructions.abi_type_names, facts.declarations
        );
    return facts;
}

func SelfMirArtifactPressureStage(enabled: Bool, stage: String) -> Void {
    if enabled {
        Log(Concat("[driver-pressure-stage] mir-facts:", stage));
    }
}

func SelfMirArtifactRoutinePressureStage(
    enabled: Bool, kind: String, row: Int, state: String
) -> Void {
    if enabled {
        Log(Concat(
            "[driver-pressure-stage] mir-facts:",
            Concat(kind, Concat(":", Concat(ToString(row), Concat(":", state))))
        ));
    }
}

func SelfMirProgramFactsBeforeCanonicalIdsObserved(
    own artifact: AstTreeArtifact,
    analysis: SemanticAstArtifactAnalysis,
    initializer_types: SemanticAstInitializerTypeFacts,
    iteration_types: SemanticAstIterationTypeFacts, assignment_types: SemanticAstAssignmentTypeFacts,
    match_materializations: SemanticAstMatchMaterializationFacts,
    statement_types: SemanticAstStatementTypeFacts,
    collection_ownership: SemanticAstCollectionOwnershipVerdict,
    generic_specializations: SemanticAstGenericSpecializationFacts,
    machine_declaration: SelfHostMachineLayerDeclaration,
    observe_pressure: Bool
) -> SelfMirProgramFacts {
    // The routine appends only carry the semantic graph; it joins the facts
    // once they stop growing, so no append shares the analysis' storage.
    let facts: SelfMirProgramFacts = SelfMirProgramFactsEmpty(artifact.count);
    SelfMirArtifactPressureStage(observe_pressure, "iteration-validation:start");
    let iteration_i: Int = 0;
    while iteration_i < SemanticAstIterationTypeCount(iteration_types) {
        if iteration_types.verified[iteration_i] != 1 ||
            iteration_types.binding_type_names[iteration_i] == "" ||
            iteration_types.binding_type_names[iteration_i] == "Unknown" ||
            iteration_types.iterable_type_names[iteration_i] == "" ||
            iteration_types.iterable_type_names[iteration_i] == "Unknown" ||
            (iteration_types.collection_hoists[iteration_i] != 0 &&
             iteration_types.collection_hoists[iteration_i] != 1) {
            return SelfMirProgramFactsError(
                facts, "mir_artifact_invalid",
                "MIR producer requires verified iteration type rows"
            );
        }
        iteration_i = iteration_i + 1;
    }
    SelfMirArtifactPressureStage(observe_pressure, "iteration-validation:done");
    SelfMirArtifactPressureStage(observe_pressure, "generic-specializations:start");
    let generic_rows: SelfMirGenericSpecializationRows =
        SelfMirGenericSpecializationRowsFromSemantic(
            analysis, generic_specializations
        );
    if !SelfMirGenericSpecializationRowsReady(generic_rows) ||
        SelfMirGenericSpecializationCount(generic_rows) !=
            SemanticAstGenericSpecializationCount(generic_specializations) {
        return SelfMirProgramFactsError(
            facts, "mir_generic_specialization_missing",
            "MIR producer requires stable generic specialization rows"
        );
    }
    SelfMirArtifactPressureStage(observe_pressure, "generic-specializations:done");
    SelfMirArtifactPressureStage(observe_pressure, "domain-projection:start");
    let domain_projection: SelfMirProgramDomainProjection =
        SelfMirProgramDomainFactsFromReadyArtifact(artifact, analysis);
    let domain_facts: SelfMirProgramFacts = domain_projection.facts;
    if !domain_facts.ok { return domain_facts; }
    SelfMirArtifactPressureStage(observe_pressure, "domain-projection:done");
    let traversal_artifact: AstTreeArtifact =
        SelfMirAstArenaNonTraversalStorageRetireAfterDomainProjection(artifact);
    let declarations: SelfMirDeclarationRows = domain_facts.declarations;
    let domain_graph: SelfDirDomainGraphFacts =
        domain_projection.domain_graph;
    facts = SelfMirProgramFacts(
        true, "", "", traversal_artifact.count, declarations,
        domain_facts.domain_topology,
        domain_facts.domain_runtime_assignments, generic_rows,
        facts.parallel_captures, facts.routines, facts.cfg,
        facts.instruction_abi_receipts,
        facts.collection_ownership_receipts,
        facts.expression_graph, facts.intent_execution);
    let initializer_rows: SelfMirInitializerRows =
        SelfMirInitializerRowsFromSemantic(initializer_types);
    let iteration_rows: SelfMirIterationRows =
        SelfMirIterationRowsFromSemantic(iteration_types);
    let assignment_rows: SelfMirAssignmentRows = SelfMirAssignmentRowsFromSemantic(assignment_types);
    let input: SelfMirRoutineInput = SelfMirRoutineInput(
        traversal_artifact, analysis,
        initializer_rows, iteration_rows, assignment_rows,
        SelfMirMatchMaterializationRowsFromSemantic(match_materializations),
        statement_types,
        machine_declaration
    );
    if !SelfMirRoutineInputRowsReady(input) {
        let error: SelfMirProgramFacts = SelfMirProgramFactsError(
            facts, "mir_routine_input_invalid",
            "MIR routine input rows must be validated once before lowering"
        );
        SelfMirAstArenaTraversalStorageRetireAfterRoutineFacts(
            traversal_artifact
        );
        return error;
    }
    SelfMirArtifactPressureStage(observe_pressure, "routine-lowering:start");
    let i: Int = 0;
    while i < SemanticAstFunctionSignatureCount(analysis.signatures) {
        // Declaration-only signatures (for example an ability contract
        // method) have no executable body and therefore do not own a MIR
        // routine.  The native producer excludes them from its routine
        // inventory; keep the self-host producer on the same owner-directed
        // fact instead of asking the routine entry owner to invent a block.
        let function_node_id: Int =
            analysis.signatures.function_node_ids[i];
        if !IsSome(SelfMirFunctionBodyBlock(
            traversal_artifact.arena, function_node_id
        )) {
            i = i + 1;
            continue;
        }
        SelfMirArtifactRoutinePressureStage(
            observe_pressure, "routine", i, "start"
        );
        let build: SelfMirRoutineBuild = SelfMirRoutineFromInput(
            input, function_node_id
        );
        if !build.ok {
            let error: SelfMirProgramFacts = SelfMirProgramFactsError(
                facts, "mir_lower_unsupported", build.diagnostic_message
            );
            SelfMirRoutineBuildStorageRetireAfterLastConsumer(build);
            SelfMirAstArenaTraversalStorageRetireAfterRoutineFacts(
                traversal_artifact
            );
            return error;
        }
        SelfMirArtifactRoutinePressureStage(
            observe_pressure, "routine-build", i, "done"
        );
        facts = SelfMirAppendRoutine(
            facts, analysis, input, i, build,
            initializer_types, collection_ownership
        );
        SelfMirRoutineBuildStorageRetireAfterLastConsumer(build);
        if !facts.ok {
            SelfMirAstArenaTraversalStorageRetireAfterRoutineFacts(
                traversal_artifact
            );
            return facts;
        }
        SelfMirArtifactRoutinePressureStage(
            observe_pressure, "routine", i, "done"
        );
        i = i + 1;
    }
    SelfMirArtifactPressureStage(observe_pressure, "routine-lowering:done");
    if ArrayLength(
            facts.routines.collection_ownership_facts.binding_syntax_ids
        ) != ArrayLength(collection_ownership.binding_syntax_ids) {
        let error: SelfMirProgramFacts = SelfMirProgramFactsError(
            facts, "mir_collection_ownership_fact_unconsumed",
            "Every semantic collection ownership row must project to one routine"
        );
        SelfMirAstArenaTraversalStorageRetireAfterRoutineFacts(
            traversal_artifact
        );
        return error;
    }
    SelfMirArtifactPressureStage(observe_pressure, "intent-lowering:start");
    let intent_i: Int = 0;
    while intent_i < SelfDirIntentCount(domain_graph.intents) {
        let intent_source_module_path: String = "";
        let intent_source_module_path_opt: Option<String> = AstSourceModulePathForNode(
            traversal_artifact.source_modules, traversal_artifact.arena,
            domain_graph.intents.intent_node_ids[intent_i]
        );
        if IsSome(intent_source_module_path_opt) { intent_source_module_path = UnwrapOption(intent_source_module_path_opt); }
        SelfMirArtifactRoutinePressureStage(
            observe_pressure, "intent", intent_i, "start"
        );
        let intent_build: SelfMirRoutineBuild = SelfMirIntentRoutineBuild(
            input, facts.declarations, domain_graph.intents, intent_i
        );
        if !intent_build.ok {
            let error: SelfMirProgramFacts = SelfMirProgramFactsError(
                facts, "mir_intent_lower_unsupported",
                intent_build.diagnostic_message
            );
            SelfMirRoutineBuildStorageRetireAfterLastConsumer(intent_build);
            SelfMirAstArenaTraversalStorageRetireAfterRoutineFacts(
                traversal_artifact
            );
            return error;
        }
        facts = SelfMirAppendIntentRoutine(facts, domain_graph.intents, intent_i, intent_source_module_path, intent_build);
        facts = SelfMirIntentExecutionPlanAppend(facts, domain_graph.intents, intent_i);
        SelfMirRoutineBuildStorageRetireAfterLastConsumer(intent_build);
        if !facts.ok {
            SelfMirAstArenaTraversalStorageRetireAfterRoutineFacts(
                traversal_artifact
            );
            return facts;
        }
        SelfMirArtifactRoutinePressureStage(
            observe_pressure, "intent", intent_i, "done"
        );
        intent_i = intent_i + 1;
    }
    SelfMirArtifactPressureStage(observe_pressure, "intent-lowering:done");
    SelfMirAstArenaTraversalStorageRetireAfterRoutineFacts(
        traversal_artifact
    );
    facts.expression_graph = analysis.expression_surfaces.expression_graph;
    return facts;
}

func SelfMirProgramFactsFromReadyArtifactObserved(
    own artifact: AstTreeArtifact,
    analysis: SemanticAstArtifactAnalysis,
    initializer_types: SemanticAstInitializerTypeFacts,
    iteration_types: SemanticAstIterationTypeFacts, assignment_types: SemanticAstAssignmentTypeFacts,
    match_materializations: SemanticAstMatchMaterializationFacts,
    statement_types: SemanticAstStatementTypeFacts,
    collection_ownership: SemanticAstCollectionOwnershipVerdict,
    generic_specializations: SemanticAstGenericSpecializationFacts,
    machine_declaration: SelfHostMachineLayerDeclaration,
    observe_pressure: Bool
) -> SelfMirProgramFacts {
    let facts: SelfMirProgramFacts = SelfMirProgramFactsBeforeCanonicalIdsObserved(
        artifact, analysis, initializer_types, iteration_types,
        assignment_types, match_materializations, statement_types,
        collection_ownership, generic_specializations,
        machine_declaration, observe_pressure
    );
    SelfMirArtifactPressureStage(observe_pressure, "canonical-ids:start");
    facts = SelfMirCanonicalInstructionIds(facts);
    SelfMirArtifactPressureStage(observe_pressure, "canonical-ids:done");
    return facts;
}

func SelfMirProgramFactsFromReadyArtifact(
    own artifact: AstTreeArtifact,
    analysis: SemanticAstArtifactAnalysis,
    initializer_types: SemanticAstInitializerTypeFacts,
    iteration_types: SemanticAstIterationTypeFacts, assignment_types: SemanticAstAssignmentTypeFacts,
    match_materializations: SemanticAstMatchMaterializationFacts,
    statement_types: SemanticAstStatementTypeFacts,
    collection_ownership: SemanticAstCollectionOwnershipVerdict,
    generic_specializations: SemanticAstGenericSpecializationFacts,
    machine_declaration: SelfHostMachineLayerDeclaration
) -> SelfMirProgramFacts {
    return SelfMirProgramFactsFromReadyArtifactObserved(
        artifact, analysis, initializer_types, iteration_types,
        assignment_types, match_materializations, statement_types,
        collection_ownership, generic_specializations,
        machine_declaration, false
    );
}

func SelfMirProgramFactsFromArtifact(
    own artifact: AstTreeArtifact,
    analysis: SemanticAstArtifactAnalysis,
    initializer_types: SemanticAstInitializerTypeFacts,
    iteration_types: SemanticAstIterationTypeFacts, assignment_types: SemanticAstAssignmentTypeFacts,
    match_materializations: SemanticAstMatchMaterializationFacts,
    statement_types: SemanticAstStatementTypeFacts,
    collection_ownership: SemanticAstCollectionOwnershipVerdict,
    generic_specializations: SemanticAstGenericSpecializationFacts,
    machine_declaration: SelfHostMachineLayerDeclaration
) -> SelfMirProgramFacts {
    let facts: SelfMirProgramFacts = SelfMirProgramFactsEmpty(artifact.count);
    if !SemanticAstArtifactAnalysisMatches(artifact, analysis, true) {
        return SelfMirProgramFactsError(
            facts, "mir_artifact_invalid",
            "MIR producer requires matching semantic artifact facts"
        );
    }
    if !SemanticExpressionGraphCarriedCallTargetsReady(
        analysis.expression_surfaces.expression_graph
    ) || !SemanticExpressionGraphRoleOperatorTargetsReady(
        analysis.expression_surfaces.expression_graph, true
    ) || !SemanticAstInitializerTypeFactsReadyProjection(
        artifact, analysis.local_bindings, initializer_types
    ) || !SemanticAstIterationTypeFactsReadyForMirProjection(
        artifact, analysis.statements, iteration_types
    ) || !SemanticAstIterationSyntheticGraphRootsReady(
        artifact, analysis.statements, analysis.expression_surfaces,
        iteration_types
    ) || !SemanticAstAssignmentTypeFactsMatchArtifact(
        artifact, analysis.signatures, analysis.constructors,
        analysis.local_bindings, initializer_types, analysis.statements,
        analysis.expression_surfaces, iteration_types,
        analysis.assignments, analysis.enums, assignment_types
    ) || !SemanticAstStatementTypeFactsMatchArtifact(
        artifact, analysis.signatures, analysis.constructors,
        analysis.local_bindings, initializer_types,
        analysis.expression_surfaces, iteration_types,
        analysis.statements, statement_types
    ) || !SelfMirAssignmentRowsReady(
        SelfMirAssignmentRowsFromSemantic(assignment_types)
    ) || !SelfMirCollectionOwnershipFactCardinalityReady(
        collection_ownership
    ) || !SemanticAstGenericSpecializationFactsReady(
        generic_specializations
    ) || !SemanticAstGenericSpecializationFactsMatchExpressionGraph(
        generic_specializations, analysis.expression_surfaces
    ) {
        return SelfMirProgramFactsError(
            facts, "mir_artifact_invalid",
            "MIR producer requires matching initializer and iteration type facts"
        );
    }
    return SelfMirProgramFactsFromReadyArtifact(
        artifact, analysis, initializer_types, iteration_types,
        assignment_types, match_materializations, statement_types,
        collection_ownership, generic_specializations,
        machine_declaration
    );
}
