// Shared AstTreeArtifact -> self-host MIR fact graph producer.

import "program_fact_owner.pgy";
import "declaration_rows_owner.pgy";
import "routine_entry_owner.pgy";
import "routine_local_inventory_owner.pgy";
import "routine_receiver_carriage_owner.pgy";
import "routine_cfg_append_owner.pgy";
import "../dir/domain_graph_fact_owner.pgy";
import "../compiler/machine_layer_declaration_consumer.pgy";
import "../semantic/ast_statement_fact_owner.pgy";

func SelfMirAppendRoutine(
    facts: SelfMirProgramFacts,
    analysis: SemanticAstArtifactAnalysis,
    ref input: SelfMirRoutineInput,
    signature_index: Int,
    build: SelfMirRoutineBuild,
    iteration_types: SemanticAstIterationTypeFacts,
    initializer_types: SemanticAstInitializerTypeFacts
) -> SelfMirProgramFacts {
    let function_node_id: Int =
        analysis.signatures.function_node_ids[signature_index];
    if !SelfMirDestructureTypeFactsReadyForRoutine(
        analysis, initializer_types, function_node_id
    ) {
        return SelfMirProgramFactsError(
            facts, "mir_destructure_type_fact_missing",
            "MIR producer requires verified semantic destructure type facts"
        );
    }
    let rows: SelfMirRoutineRows = facts.routines;
    let node_ids: Array<Int> = rows.node_ids;
    let names: Array<String> = rows.names;
    let kinds: Array<String> = rows.kinds;
    let owners: Array<String> = rows.owners;
    let receiver_carriages: Array<String> = rows.receiver_carriages;
    let return_types: Array<String> = rows.return_types;
    let generic_starts: Array<Int> = rows.generic_starts;
    let generic_counts: Array<Int> = rows.generic_counts;
    let generic_names: Array<String> = rows.generic_names;
    let param_starts: Array<Int> = rows.param_starts;
    let param_counts: Array<Int> = rows.param_counts;
    let param_names: Array<String> = rows.param_names;
    let param_types: Array<String> = rows.param_types;
    let param_abi_kinds: Array<Int> = rows.param_abi_kinds;
    let param_resource_kinds: Array<Int> = rows.param_resource_kinds;
    let block_starts: Array<Int> = rows.block_starts;
    let block_counts: Array<Int> = rows.block_counts;
    let local_starts: Array<Int> = rows.local_starts;
    let local_counts: Array<Int> = rows.local_counts;
    let local_names: Array<String> = rows.local_names;
    let local_types: Array<String> = rows.local_types;
    let iteration_starts: Array<Int> = rows.iteration_starts;
    let iteration_counts: Array<Int> = rows.iteration_counts;
    let iteration_node_ids: Array<Int> = rows.iteration_node_ids;
    let iteration_binding_types: Array<String> = rows.iteration_binding_types;
    let iteration_iterable_types: Array<String> = rows.iteration_iterable_types;
    let iteration_collection_hoists: Array<Int> =
        rows.iteration_collection_hoists;
    let destructure_type_facts: SelfMirDestructureTypeFactRows =
        SelfMirDestructureTypeFactRowsAppendRoutine(
            rows.destructure_type_facts, analysis, initializer_types,
            function_node_id
        );
    let loop_flows: SelfMirLoopFlowRows = SelfMirLoopFlowRowsAppendRoutine(
        rows.loop_flows, analysis.statements,
        function_node_id
    );
    ArrayPush(node_ids, analysis.signatures.function_node_ids[signature_index]);
    ArrayPush(names, analysis.signatures.names[signature_index]);
    let receiver: SelfMirRoutineReceiverFact = SelfMirRoutineReceiverForOwner(
        facts.declarations, analysis.signatures.owner_names[signature_index]
    );
    if !receiver.ok {
        return SelfMirProgramFactsError(
            facts, "mir_receiver_carriage_owner_invalid",
            "MIR receiver carriage requires one exact declaration owner"
        );
    }
    ArrayPush(owners, receiver.owner);
    ArrayPush(kinds, receiver.routine_kind);
    ArrayPush(receiver_carriages, receiver.carriage);
    let owner: String = receiver.owner;
    ArrayPush(return_types, analysis.signatures.return_types[signature_index]);
    ArrayPush(generic_starts, ArrayLength(generic_names));
    ArrayPush(
        generic_counts, analysis.signatures.generic_counts[signature_index]
    );
    let generic_i: Int = 0;
    let generic_start: Int = analysis.signatures.generic_starts[signature_index];
    while generic_i < analysis.signatures.generic_counts[signature_index] {
        ArrayPush(
            generic_names,
            analysis.signatures.generic_names[generic_start + generic_i]
        );
        generic_i = generic_i + 1;
    }
    ArrayPush(param_starts, ArrayLength(param_names));
    ArrayPush(param_counts, analysis.signatures.param_counts[signature_index]);
    let param_i: Int = 0;
    let param_start: Int = analysis.signatures.param_starts[signature_index];
    while param_i < analysis.signatures.param_counts[signature_index] {
        let row: Int = param_start + param_i;
        ArrayPush(param_names, analysis.signatures.param_names[row]);
        let param_type: String = analysis.signatures.param_types[row];
        if owner != "" && analysis.signatures.param_names[row] == "self" {
            ArrayPush(param_types, "");
        } else {
            ArrayPush(param_types, param_type);
        }
        let abi_kind: Int = 0;
        let mode: Int = analysis.signatures.param_modes[row];
        if mode == 1 {
            abi_kind = 1;
        } else if mode == 2 {
            abi_kind = 2;
        } else if mode == 3 {
            abi_kind = 3;
            let constructor_i: Int = 0;
            while constructor_i < ArrayLength(analysis.constructors.names) {
                if analysis.constructors.names[constructor_i] == param_type {
                    abi_kind = 4;
                }
                constructor_i = constructor_i + 1;
            }
        }
        ArrayPush(param_abi_kinds, abi_kind);
        ArrayPush(
            param_resource_kinds,
            SelfMirParamResourceKindForType(param_type)
        );
        param_i = param_i + 1;
    }
    ArrayPush(block_starts, ArrayLength(facts.cfg.blocks.ids));
    ArrayPush(block_counts, ArrayLength(build.cfg.blocks.ids));
    let inventory: SelfMirRoutineLocalInventory =
        SelfMirRoutineLocalInventoryFromInput(input, function_node_id);
    if !inventory.ok {
        return SelfMirProgramFactsError(
            facts, "mir_source_local_inventory_invalid",
            inventory.diagnostic_message
        );
    }
    ArrayPush(local_starts, ArrayLength(local_names));
    ArrayPush(local_counts, ArrayLength(inventory.names));
    let local_i: Int = 0;
    while local_i < ArrayLength(inventory.names) {
        ArrayPush(local_names, inventory.names[local_i]);
        ArrayPush(local_types, inventory.types[local_i]);
        local_i = local_i + 1;
    }
    ArrayPush(iteration_starts, ArrayLength(iteration_node_ids));
    let iteration_count: Int = 0;
    let iteration_i: Int = 0;
    while iteration_i < SemanticAstIterationTypeCount(iteration_types) {
        let statement_index: Option<Int> = SemanticAstStatementIndexForNode(
            analysis.statements, iteration_types.node_ids[iteration_i]
        );
        if IsSome(statement_index) &&
            analysis.statements.function_node_ids[UnwrapOption(statement_index)] ==
                function_node_id {
            ArrayPush(iteration_node_ids, iteration_types.node_ids[iteration_i]);
            ArrayPush(
                iteration_binding_types,
                iteration_types.binding_type_names[iteration_i]
            );
            ArrayPush(
                iteration_iterable_types,
                iteration_types.iterable_type_names[iteration_i]
            );
            ArrayPush(
                iteration_collection_hoists,
                iteration_types.collection_hoists[iteration_i]
            );
            iteration_count = iteration_count + 1;
        }
        iteration_i = iteration_i + 1;
    }
    ArrayPush(iteration_counts, iteration_count);
    return SelfMirProgramFacts(
        facts.ok, facts.diagnostic_code, facts.diagnostic_message,
        facts.artifact_node_count, facts.declarations,
        facts.domain_topology,
        facts.generic_specializations, facts.parallel_captures,
        SelfMirRoutineRows(
            node_ids, names, kinds, owners, receiver_carriages, return_types,
            generic_starts, generic_counts, generic_names,
            param_starts, param_counts, param_names, param_types,
            param_abi_kinds, param_resource_kinds,
            block_starts, block_counts, local_starts, local_counts,
            local_names, local_types,
            iteration_starts, iteration_counts, iteration_node_ids,
            iteration_binding_types, iteration_iterable_types,
            iteration_collection_hoists, destructure_type_facts, loop_flows
        ),
        SelfMirAppendCfg(facts.cfg, build.cfg)
    );
}

func SelfMirInstructionIdPriority(kind: String) -> Int {
    if kind == "phi" || kind == "branch" {
        return 0;
    }
    if kind == "def" || kind == "loop-init" {
        return 1;
    }
    return 2;
}

func SelfMirCanonicalInstructionIds(
    facts: SelfMirProgramFacts
) -> SelfMirProgramFacts {
    let ids: Array<Int> = facts.cfg.instructions.ids;
    let routine_i: Int = 0;
    while routine_i < ArrayLength(facts.routines.names) {
        let next_id: Int = 0;
        let priority: Int = 0;
        while priority < 3 {
            let block_i: Int = 0;
            while block_i < facts.routines.block_counts[routine_i] {
                let block_row: Int =
                    facts.routines.block_starts[routine_i] + block_i;
                let instruction_i: Int = 0;
                while instruction_i <
                    facts.cfg.blocks.instruction_counts[block_row] {
                    let instruction_row: Int =
                        facts.cfg.blocks.instruction_starts[block_row] +
                        instruction_i;
                    if SelfMirInstructionIdPriority(
                        facts.cfg.instructions.kinds[instruction_row]
                    ) == priority {
                        ArraySet(ids, instruction_row, next_id);
                        next_id = next_id + 1;
                    }
                    instruction_i = instruction_i + 1;
                }
                block_i = block_i + 1;
            }
            priority = priority + 1;
        }
        routine_i = routine_i + 1;
    }
    let instructions: SelfMirInstructionRows = facts.cfg.instructions;
    return SelfMirProgramFacts(
        facts.ok, facts.diagnostic_code, facts.diagnostic_message,
        facts.artifact_node_count, facts.declarations,
        facts.domain_topology,
        facts.generic_specializations, facts.parallel_captures,
        facts.routines,
        SelfMirCfgRows(
            facts.cfg.blocks,
            SelfMirInstructionRows(
                ids, instructions.kinds, instructions.names,
                instructions.results, instructions.arg0s, instructions.arg1s,
                instructions.slot_anchors, instructions.expr0s,
                instructions.expr1s,
                instructions.source_types, instructions.machine_contact_kinds,
                instructions.machine_layer_manifest_ids,
                instructions.machine_layer_physical_grant_ids,
                instructions.machine_layer_physical_bases,
                instructions.machine_layer_physical_sizes,
                instructions.machine_layer_physical_modes,
                instructions.machine_layer_runtime_operations,
                instructions.machine_layer_hardware_adequate,
                instructions.machine_layer_authority_required,
                instructions.machine_layer_live_lease_required,
                instructions.use_starts, instructions.use_counts,
                instructions.uses,
                instructions.expr0_graphs, instructions.expr1_graphs,
                instructions.match_facts, instructions.destructure_facts,
                instructions.runtime_call_abi
            )
        )
    );
}

// Driver verification owns whole-semantic readiness before MIR materialization.
// This borrowed entrypoint must not repeat that graph-wide proof.
func SelfMirProgramFactsFromReadyArtifact(
    artifact: AstTreeArtifact,
    analysis: SemanticAstArtifactAnalysis,
    initializer_types: SemanticAstInitializerTypeFacts,
    iteration_types: SemanticAstIterationTypeFacts,
    assignment_types: SemanticAstAssignmentTypeFacts,
    statement_types: SemanticAstStatementTypeFacts,
    generic_specializations: SemanticAstGenericSpecializationFacts,
    machine_declaration: SelfHostMachineLayerDeclaration
) -> SelfMirProgramFacts {
    let facts: SelfMirProgramFacts = SelfMirProgramFactsEmpty(artifact.count);
    let iteration_i: Int = 0;
    while iteration_i < SemanticAstIterationTypeCount(iteration_types) {
        if iteration_types.verified[iteration_i] != 1 ||
            iteration_types.binding_type_names[iteration_i] == "" ||
            iteration_types.binding_type_names[iteration_i] == "Unknown" ||
            iteration_types.iterable_type_names[iteration_i] == "" ||
            iteration_types.iterable_type_names[iteration_i] == "Unknown" ||
            (iteration_types.collection_hoists[iteration_i] != 0 &&
             iteration_types.collection_hoists[iteration_i] != 1) {
            return SelfMirProgramFactsError(
                facts, "mir_artifact_invalid",
                "MIR producer requires verified iteration type rows"
            );
        }
        iteration_i = iteration_i + 1;
    }
    let enum_facts: SemanticAstEnumFacts = analysis.enums;
    if !enum_facts.ok {
        return SelfMirProgramFactsError(
            facts, "mir_artifact_invalid",
            "MIR producer requires complete enum variant facts"
        );
    }
    let generic_rows: SelfMirGenericSpecializationRows =
        SelfMirGenericSpecializationRowsFromSemantic(
            analysis, generic_specializations
        );
    if !SelfMirGenericSpecializationRowsReady(generic_rows) ||
        SelfMirGenericSpecializationCount(generic_rows) !=
            SemanticAstGenericSpecializationCount(generic_specializations) {
        return SelfMirProgramFactsError(
            facts, "mir_generic_specialization_missing",
            "MIR producer requires stable generic specialization rows"
        );
    }
    let declarations: SelfMirDeclarationRows = SelfMirDeclarationsFromAnalysis(artifact, analysis, enum_facts);
    let domain_graph: SelfDirDomainGraphFacts = SelfDirDomainGraphFactsFromArtifact(artifact, declarations);
    if !SelfDirDomainGraphFactsReady(domain_graph) {
        return SelfMirProgramFactsError(facts, "mir_domain_graph_invalid", domain_graph.diagnostic_message);
    }
    facts = SelfMirProgramFacts(
        true, "", "", artifact.count, declarations,
        SelfMirDomainTopologyFactsFromSelfDir(domain_graph), generic_rows,
        facts.parallel_captures, facts.routines, facts.cfg);
    let input: SelfMirRoutineInput = SelfMirRoutineInput(
        artifact, analysis,
        SelfMirInitializerRowsFromSemantic(initializer_types),
        SelfMirIterationRowsFromSemantic(iteration_types),
        SelfMirAssignmentRowsFromSemantic(assignment_types),
        statement_types,
        machine_declaration
    );
    let i: Int = 0;
    while i < SemanticAstFunctionSignatureCount(analysis.signatures) {
        // Declaration-only signatures (for example an ability contract
        // method) have no executable body and therefore do not own a MIR
        // routine.  The native producer excludes them from its routine
        // inventory; keep the self-host producer on the same owner-directed
        // fact instead of asking the routine entry owner to invent a block.
        let function_node_id: Int =
            analysis.signatures.function_node_ids[i];
        if !IsSome(SelfMirFunctionBodyBlock(
            artifact.arena, function_node_id
        )) {
            i = i + 1;
            continue;
        }
        let build: SelfMirRoutineBuild = SelfMirRoutineFromInput(
            input, function_node_id
        );
        if !build.ok {
            return SelfMirProgramFactsError(
                facts, "mir_lower_unsupported", build.diagnostic_message
            );
        }
        facts = SelfMirAppendRoutine(
            facts, analysis, input, i, build,
            iteration_types, initializer_types
        );
        i = i + 1;
    }
    return SelfMirCanonicalInstructionIds(facts);
}

func SelfMirProgramFactsFromArtifact(
    artifact: AstTreeArtifact,
    analysis: SemanticAstArtifactAnalysis,
    initializer_types: SemanticAstInitializerTypeFacts,
    iteration_types: SemanticAstIterationTypeFacts,
    assignment_types: SemanticAstAssignmentTypeFacts,
    statement_types: SemanticAstStatementTypeFacts,
    generic_specializations: SemanticAstGenericSpecializationFacts,
    machine_declaration: SelfHostMachineLayerDeclaration
) -> SelfMirProgramFacts {
    let facts: SelfMirProgramFacts = SelfMirProgramFactsEmpty(artifact.count);
    if !SemanticAstArtifactAnalysisMatches(artifact, analysis, true) {
        return SelfMirProgramFactsError(
            facts, "mir_artifact_invalid",
            "MIR producer requires matching semantic artifact facts"
        );
    }
    if !SemanticExpressionGraphCarriedCallTargetsReady(
        analysis.expression_surfaces.expression_graph
    ) || !SemanticAstInitializerTypeFactsReadyProjection(
        artifact, analysis.local_bindings, initializer_types
    ) || !SemanticAstIterationTypeFactsReadyForMirProjection(
        artifact, analysis.statements, iteration_types
    ) || !SemanticAstIterationSyntheticGraphRootsReady(
        artifact, analysis.statements, analysis.expression_surfaces,
        iteration_types
    ) || !SemanticAstAssignmentTypeFactsMatchArtifact(
        artifact, analysis.signatures, analysis.constructors,
        analysis.local_bindings, initializer_types, analysis.statements,
        analysis.expression_surfaces, iteration_types,
        analysis.assignments, analysis.enums, assignment_types
    ) || !SemanticAstStatementTypeFactsMatchArtifact(
        artifact, analysis.signatures, analysis.constructors,
        analysis.local_bindings, initializer_types,
        analysis.expression_surfaces, iteration_types,
        analysis.statements, statement_types
    ) || !SelfMirAssignmentRowsReady(
        SelfMirAssignmentRowsFromSemantic(assignment_types)
    ) || !SemanticAstGenericSpecializationFactsReady(
        generic_specializations
    ) || !SemanticAstGenericSpecializationFactsMatchExpressionGraph(
        generic_specializations, analysis.expression_surfaces
    ) {
        return SelfMirProgramFactsError(
            facts, "mir_artifact_invalid",
            "MIR producer requires matching initializer and iteration type facts"
        );
    }
    return SelfMirProgramFactsFromReadyArtifact(
        artifact, analysis, initializer_types, iteration_types,
        assignment_types, statement_types, generic_specializations,
        machine_declaration
    );
}
