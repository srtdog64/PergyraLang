// Retires semantic body-type Array carriers after MIR rows consume them.
// String elements remain shared with MIR facts and must not be freed.
// This boundary is MIR-only: source-C body views still borrow zone backings.

import "../semantic/ast_body_type_bundle_owner.pgy";

func SelfMirBodyTypeBundleStorageRetireAfterProgramFacts(
    own body_types: SemanticAstBodyTypeBundle
) -> Void {
    let initializer_node_ids: Array<Int> = body_types.initializer_types.node_ids;
    let initializer_inferred_types: Array<String> = body_types.initializer_types.inferred_type_names;
    let initializer_verified: Array<Int> = body_types.initializer_types.verified;
    let initializer_diagnostic_codes: Array<String> = body_types.initializer_types.diagnostic_codes;
    let initializer_diagnostic_messages: Array<String> = body_types.initializer_types.diagnostic_messages;
    let initializer_binding_kinds: Array<Int> = body_types.initializer_types.binding_kinds;
    let initializer_binding_indices: Array<Int> = body_types.initializer_types.binding_indices;
    let iteration_node_ids: Array<Int> = body_types.iteration_types.node_ids;
    let iteration_binding_types: Array<String> = body_types.iteration_types.binding_type_names;
    let iteration_iterable_types: Array<String> = body_types.iteration_types.iterable_type_names;
    let iteration_collection_hoists: Array<Int> = body_types.iteration_types.collection_hoists;
    let iteration_synthetic_names: Array<String> = body_types.iteration_types.synthetic_names;
    let iteration_synthetic_roots: Array<Int> = body_types.iteration_types.synthetic_graph_root_ids;
    let iteration_verified: Array<Int> = body_types.iteration_types.verified;
    let iteration_diagnostic_codes: Array<String> = body_types.iteration_types.diagnostic_codes;
    let iteration_diagnostic_messages: Array<String> = body_types.iteration_types.diagnostic_messages;
    let assignment_node_ids: Array<Int> = body_types.assignment_types.node_ids;
    let assignment_binding_modes: Array<String> = body_types.assignment_types.target_binding_modes;
    let assignment_target_types: Array<String> = body_types.assignment_types.target_type_names;
    let assignment_index_types: Array<String> = body_types.assignment_types.index_type_names;
    let assignment_expected_types: Array<String> = body_types.assignment_types.expected_type_names;
    let assignment_inferred_types: Array<String> = body_types.assignment_types.inferred_type_names;
    let assignment_verified: Array<Int> = body_types.assignment_types.verified;
    let assignment_diagnostic_codes: Array<String> = body_types.assignment_types.diagnostic_codes;
    let assignment_diagnostic_messages: Array<String> = body_types.assignment_types.diagnostic_messages;
    let statement_node_ids: Array<Int> = body_types.statement_types.node_ids;
    let statement_kind_tags: Array<Int> = body_types.statement_types.kind_tags;
    let statement_expected_types: Array<String> = body_types.statement_types.expected_type_names;
    let statement_inferred_types: Array<String> = body_types.statement_types.inferred_type_names;
    let statement_verified: Array<Int> = body_types.statement_types.verified;
    let statement_diagnostic_codes: Array<String> = body_types.statement_types.diagnostic_codes;
    let statement_diagnostic_messages: Array<String> = body_types.statement_types.diagnostic_messages;
    let match_materialization_node_ids: Array<Int> = body_types.match_materializations.node_ids;
    let match_materialization_function_node_ids: Array<Int> = body_types.match_materializations.function_node_ids;
    let match_materialization_type_names: Array<String> = body_types.match_materializations.type_names;
    let match_materialization_synthetic_names: Array<String> = body_types.match_materializations.synthetic_names;
    let match_materialization_synthetic_roots: Array<Int> = body_types.match_materializations.synthetic_graph_root_ids;
    let formal_nodes: Array<Int> = body_types.collection_formal_effects.inventory.formal_nodes;
    let formal_function_nodes: Array<Int> = body_types.collection_formal_effects.inventory.function_nodes;
    let formal_ordinals: Array<Int> = body_types.collection_formal_effects.inventory.ordinals;
    let formal_modes: Array<Int> = body_types.collection_formal_effects.inventory.modes;
    let formal_body_ready: Array<Bool> = body_types.collection_formal_effects.inventory.body_ready;
    let collection_function_ids: Array<Int> =
        body_types.collection_ownership.function_syntax_ids;
    let collection_binding_ids: Array<Int> =
        body_types.collection_ownership.binding_syntax_ids;
    let collection_origin_ids: Array<Int> =
        body_types.collection_ownership.origin_syntax_ids;
    let collection_source_ids: Array<Int> =
        body_types.collection_ownership.source_binding_syntax_ids;
    let collection_ownerships: Array<Int> =
        body_types.collection_ownership.element_ownerships;
    let collection_dispositions: Array<Int> =
        body_types.collection_ownership.dispositions;
    let collection_origins: Array<Int> =
        body_types.collection_ownership.origins;
    let receipt_function_ids: Array<Int> = body_types.collection_ownership.receipts.function_syntax_ids;
    let receipt_owner_ids: Array<Int> = body_types.collection_ownership.receipts.owner_node_ids;
    let receipt_lanes: Array<Int> = body_types.collection_ownership.receipts.lanes;
    let receipt_call_ordinals: Array<Int> = body_types.collection_ownership.receipts.local_call_ordinals;
    let receipt_effect_kinds: Array<Int> = body_types.collection_ownership.receipts.effect_kinds;
    let receipt_receiver_ids: Array<Int> = body_types.collection_ownership.receipts.receiver_binding_syntax_ids;
    let receipt_source_ids: Array<Int> = body_types.collection_ownership.receipts.source_binding_syntax_ids;
    let zone_fresh_local_ids: Array<Int> = body_types.zone_carriage.fresh_local_node_ids;
    let zone_resource_path_starts: Array<Int> = body_types.zone_carriage.resource_path_starts;
    let zone_resource_path_counts: Array<Int> = body_types.zone_carriage.resource_path_counts;
    let zone_resource_field_paths: Array<String> = body_types.zone_carriage.resource_field_paths;
    let zone_mutable_borrow_parameter_ids: Array<Int> = body_types.zone_carriage.mutable_borrow_parameter_node_ids;
    let capability_callable_ids: Array<Int> = body_types.capabilities.callable_node_ids;
    let capability_declared_masks: Array<Int> = body_types.capabilities.declared_masks;
    let capability_used_masks: Array<Int> = body_types.capabilities.used_masks;
    let capability_exported_masks: Array<Int> = body_types.capabilities.exported_masks;
    let capability_deferred_uses: Array<Bool> = body_types.capabilities.deferred_uses;
    let capability_declared_effects: Array<Int> = body_types.capabilities.declared_effects;
    let capability_known_call_effects: Array<Int> = body_types.capabilities.known_call_effects;
    let capability_unknown_call_effects: Array<Bool> = body_types.capabilities.unknown_call_effects;
    let generic_call_node_ids: Array<Int> = body_types.generic_specializations.call_node_ids;
    let generic_owner_node_ids: Array<Int> = body_types.generic_specializations.source_owner_node_ids;
    let generic_source_lanes: Array<Int> = body_types.generic_specializations.source_lanes;
    let generic_call_ordinals: Array<Int> = body_types.generic_specializations.source_call_ordinals;
    let generic_signature_indexes: Array<Int> = body_types.generic_specializations.signature_indexes;
    let generic_actual_starts: Array<Int> = body_types.generic_specializations.actual_starts;
    let generic_actual_counts: Array<Int> = body_types.generic_specializations.actual_counts;
    let generic_actual_types: Array<String> = body_types.generic_specializations.actual_type_names;
    let numeric_call_nodes: Array<Int> = body_types.numeric_string_allocations.call_nodes;
    let numeric_terminal_nodes: Array<Int> = body_types.numeric_string_allocations.terminal_nodes;
    let numeric_owner_nodes: Array<Int> = body_types.numeric_string_allocations.owner_node_ids;
    let numeric_lanes: Array<Int> = body_types.numeric_string_allocations.lanes;
    let numeric_ordinals: Array<Int> = body_types.numeric_string_allocations.local_call_ordinals;
    let numeric_operand_types: Array<String> = body_types.numeric_string_allocations.operand_types;
    let result_function_ids: Array<Int> = body_types.owned_string_result_domains.function_syntax_ids;
    let result_domain_kinds: Array<Int> = body_types.owned_string_result_domains.domain_kinds;
    let result_allocator_ids: Array<Int> = body_types.owned_string_result_domains.allocator_formal_syntax_ids;
    let result_allocator_ordinals: Array<Int> = body_types.owned_string_result_domains.allocator_formal_ordinals;
    let result_written_rows: Array<Int> = body_types.owned_string_result_domains.writes.written_binding_rows;
    let result_written_formals: Array<Int> = body_types.owned_string_result_domains.writes.written_parameter_syntax_ids;
    let exposure_call_nodes: Array<Int> = body_types.owned_string_result_domains.domain_exposures.call_nodes;
    let exposure_ordinals: Array<Int> = body_types.owned_string_result_domains.domain_exposures.argument_ordinals;
    let exposure_source_ids: Array<Int> = body_types.owned_string_result_domains.domain_exposures.source_syntax_ids;
    let exposure_written_ids: Array<Int> = body_types.owned_string_result_domains.domain_exposures.string_written_source_syntax_ids;
    CompilerRetireArrayStorage(initializer_node_ids); CompilerRetireArrayStorage(initializer_inferred_types);
    CompilerRetireArrayStorage(initializer_verified); CompilerRetireArrayStorage(initializer_diagnostic_codes);
    CompilerRetireArrayStorage(initializer_diagnostic_messages); CompilerRetireArrayStorage(initializer_binding_kinds);
    CompilerRetireArrayStorage(initializer_binding_indices); CompilerRetireArrayStorage(iteration_node_ids);
    CompilerRetireArrayStorage(iteration_binding_types); CompilerRetireArrayStorage(iteration_iterable_types);
    CompilerRetireArrayStorage(iteration_collection_hoists); CompilerRetireArrayStorage(iteration_synthetic_names);
    CompilerRetireArrayStorage(iteration_synthetic_roots); CompilerRetireArrayStorage(iteration_verified);
    CompilerRetireArrayStorage(iteration_diagnostic_codes); CompilerRetireArrayStorage(iteration_diagnostic_messages);
    CompilerRetireArrayStorage(assignment_node_ids); CompilerRetireArrayStorage(assignment_binding_modes);
    CompilerRetireArrayStorage(assignment_target_types); CompilerRetireArrayStorage(assignment_index_types);
    CompilerRetireArrayStorage(assignment_expected_types); CompilerRetireArrayStorage(assignment_inferred_types);
    CompilerRetireArrayStorage(assignment_verified); CompilerRetireArrayStorage(assignment_diagnostic_codes);
    CompilerRetireArrayStorage(assignment_diagnostic_messages); CompilerRetireArrayStorage(statement_node_ids);
    CompilerRetireArrayStorage(statement_kind_tags); CompilerRetireArrayStorage(statement_expected_types);
    CompilerRetireArrayStorage(statement_inferred_types); CompilerRetireArrayStorage(statement_verified);
    CompilerRetireArrayStorage(statement_diagnostic_codes); CompilerRetireArrayStorage(statement_diagnostic_messages);
    CompilerRetireArrayStorage(match_materialization_node_ids); CompilerRetireArrayStorage(match_materialization_function_node_ids);
    CompilerRetireArrayStorage(match_materialization_type_names); CompilerRetireArrayStorage(match_materialization_synthetic_names);
    CompilerRetireArrayStorage(match_materialization_synthetic_roots);
    CompilerRetireArrayStorage(formal_nodes); CompilerRetireArrayStorage(formal_function_nodes);
    CompilerRetireArrayStorage(formal_ordinals); CompilerRetireArrayStorage(formal_modes);
    CompilerRetireArrayStorage(formal_body_ready);
    CompilerRetireArrayStorage(collection_function_ids);
    CompilerRetireArrayStorage(collection_binding_ids);
    CompilerRetireArrayStorage(collection_origin_ids);
    CompilerRetireArrayStorage(collection_source_ids);
    CompilerRetireArrayStorage(collection_ownerships);
    CompilerRetireArrayStorage(collection_dispositions);
    CompilerRetireArrayStorage(collection_origins);
    CompilerRetireArrayStorage(receipt_function_ids); CompilerRetireArrayStorage(receipt_owner_ids);
    CompilerRetireArrayStorage(receipt_lanes); CompilerRetireArrayStorage(receipt_call_ordinals);
    CompilerRetireArrayStorage(receipt_effect_kinds); CompilerRetireArrayStorage(receipt_receiver_ids);
    CompilerRetireArrayStorage(receipt_source_ids); CompilerRetireArrayStorage(zone_fresh_local_ids);
    CompilerRetireArrayStorage(zone_resource_path_starts); CompilerRetireArrayStorage(zone_resource_path_counts);
    CompilerRetireArrayStorage(zone_resource_field_paths); CompilerRetireArrayStorage(zone_mutable_borrow_parameter_ids);
    CompilerRetireArrayStorage(capability_callable_ids); CompilerRetireArrayStorage(capability_declared_masks);
    CompilerRetireArrayStorage(capability_used_masks); CompilerRetireArrayStorage(capability_exported_masks);
    CompilerRetireArrayStorage(capability_deferred_uses); CompilerRetireArrayStorage(capability_declared_effects);
    CompilerRetireArrayStorage(capability_known_call_effects); CompilerRetireArrayStorage(capability_unknown_call_effects);
    CompilerRetireArrayStorage(generic_call_node_ids); CompilerRetireArrayStorage(generic_owner_node_ids);
    CompilerRetireArrayStorage(generic_source_lanes); CompilerRetireArrayStorage(generic_call_ordinals);
    CompilerRetireArrayStorage(generic_signature_indexes); CompilerRetireArrayStorage(generic_actual_starts);
    CompilerRetireArrayStorage(generic_actual_counts); CompilerRetireArrayStorage(generic_actual_types);
    CompilerRetireArrayStorage(numeric_call_nodes); CompilerRetireArrayStorage(numeric_terminal_nodes);
    CompilerRetireArrayStorage(numeric_owner_nodes); CompilerRetireArrayStorage(numeric_lanes);
    CompilerRetireArrayStorage(numeric_ordinals); CompilerRetireArrayStorage(numeric_operand_types);
    CompilerRetireArrayStorage(result_function_ids); CompilerRetireArrayStorage(result_domain_kinds);
    CompilerRetireArrayStorage(result_allocator_ids); CompilerRetireArrayStorage(result_allocator_ordinals);
    CompilerRetireArrayStorage(result_written_rows); CompilerRetireArrayStorage(result_written_formals);
    CompilerRetireArrayStorage(exposure_call_nodes); CompilerRetireArrayStorage(exposure_ordinals);
    CompilerRetireArrayStorage(exposure_source_ids); CompilerRetireArrayStorage(exposure_written_ids);
}
