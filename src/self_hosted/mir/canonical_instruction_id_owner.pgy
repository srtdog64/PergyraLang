// Canonical per-routine instruction identity projection.

import "program_fact_owner.pgy";
import "intent_execution_canonical_instruction_owner.pgy";
import "generic_specialization_occurrence_owner.pgy";

func SelfMirInstructionIdPriority(kind: String) -> Int {
    if kind == "phi" || kind == "branch" { return 0; }
    if kind == "def" || kind == "loop-init" { return 1; }
    return 2;
}

func SelfMirCanonicalInstructionIds(facts: SelfMirProgramFacts) -> SelfMirProgramFacts {
    if !facts.ok { return facts; }
    // Preserve the old IDs until every plan reference has been rebound.
    let ids: Array<Int> = [];
    let copy_i: Int = 0;
    while copy_i < ArrayLength(facts.cfg.instructions.ids) {
        ArrayPush(ids, facts.cfg.instructions.ids[copy_i]);
        copy_i = copy_i + 1;
    }
    let routine_i: Int = 0;
    while routine_i < ArrayLength(facts.routines.names) {
        let next_id: Int = 0;
        let priority: Int = 0;
        while priority < 3 {
            let block_i: Int = 0;
            while block_i < facts.routines.block_counts[routine_i] {
                let block_row: Int = facts.routines.block_starts[routine_i] + block_i;
                let instruction_i: Int = 0;
                while instruction_i <
                    facts.cfg.blocks.instruction_counts[block_row] {
                    let instruction_row: Int = facts.cfg.blocks.instruction_starts[block_row] +
                        instruction_i;
                    if SelfMirInstructionIdPriority(facts.cfg.instructions.kinds[instruction_row]
                    ) == priority {
                        ArraySet(ids, instruction_row, next_id);
                        next_id = next_id + 1;
                    }
                    instruction_i = instruction_i + 1;
                }
                block_i = block_i + 1;
            }
            priority = priority + 1;
        }
        routine_i = routine_i + 1;
    }
    let plan: MirIntentExecutionPlan = SelfMirIntentExecutionCanonicalPlan(facts, ids);
    if !plan.valid {
        return SelfMirProgramFactsError(facts, "mir_intent_plan_invalid",
            "typed Intent plan did not survive canonical instruction identity sealing");
    }
    let occurrences: SelfMirGenericCallOccurrenceRows = SelfMirGenericCallOccurrencesFromCfg(
        facts.generic_specializations, facts.routines, facts.cfg, facts.expression_graph);
    if !occurrences.sealed {
        return SelfMirProgramFactsError(facts, "mir_generic_call_occurrence_invalid",
            "generic specialization has no exact instruction-local call occurrence");
    }
    let instructions: SelfMirInstructionRows = facts.cfg.instructions;
    return SelfMirProgramFacts(facts.ok, facts.diagnostic_code, facts.diagnostic_message,
        facts.artifact_node_count, facts.declarations, facts.domain_topology,
        facts.domain_runtime_assignments,
        SelfMirGenericSpecializationWithOccurrences(facts.generic_specializations, occurrences),
        facts.parallel_captures, facts.routines,
        SelfMirCfgRows(
            facts.cfg.blocks,
            SelfMirInstructionRows(
                ids, instructions.kinds, instructions.names,
                instructions.results, instructions.arg0s, instructions.arg1s,
                instructions.slot_anchors, instructions.expr0s,
                instructions.expr1s, instructions.source_types,
                instructions.machine_contact_kinds,
                instructions.machine_layer_manifest_ids,
                instructions.machine_layer_physical_grant_ids,
                instructions.machine_layer_physical_bases,
                instructions.machine_layer_physical_sizes,
                instructions.machine_layer_physical_modes,
                instructions.machine_layer_runtime_operations,
                instructions.machine_layer_hardware_adequate,
                instructions.machine_layer_authority_required,
                instructions.machine_layer_live_lease_required,
                instructions.use_starts, instructions.use_counts,
                instructions.uses, instructions.expr0_graphs,
                instructions.expr1_graphs, instructions.match_facts,
                instructions.destructure_facts, instructions.abi_type_names,
                instructions.runtime_call_abi, instructions.binding_source_syntax_ids
            ), facts.cfg.local_refs
        ), facts.instruction_abi_receipts, facts.expression_graph, plan
    );
}
