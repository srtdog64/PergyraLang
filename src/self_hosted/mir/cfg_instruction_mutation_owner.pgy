// Canonical mutation operations over self-host MIR instruction rows.

import "program_fact_owner.pgy";

func SelfMirCfgSetInstructionUses(
    cfg: SelfMirCfgRows,
    instruction_index: Int,
    replacement: Array<String>
) -> SelfMirCfgRows {
    let instruction_count: Int = ArrayLength(cfg.instructions.ids);
    if instruction_index < 0 || instruction_index >= instruction_count {
        return cfg;
    }
    let use_starts: Array<Int> = [];
    let use_counts: Array<Int> = [];
    let uses: Array<String> = [];
    let row: Int = 0;
    while row < instruction_count {
        ArrayPush(use_starts, ArrayLength(uses));
        if row == instruction_index {
            ArrayPush(use_counts, ArrayLength(replacement));
            let replacement_i: Int = 0;
            while replacement_i < ArrayLength(replacement) {
                ArrayPush(uses, replacement[replacement_i]);
                replacement_i = replacement_i + 1;
            }
        } else {
            let old_start: Int = cfg.instructions.use_starts[row];
            let old_count: Int = cfg.instructions.use_counts[row];
            ArrayPush(use_counts, old_count);
            let old_i: Int = 0;
            while old_i < old_count {
                ArrayPush(uses, cfg.instructions.uses[old_start + old_i]);
                old_i = old_i + 1;
            }
        }
        row = row + 1;
    }
    let instructions: SelfMirInstructionRows = cfg.instructions;
    return SelfMirCfgRows(
        cfg.blocks,
        SelfMirInstructionRows(
            instructions.ids, instructions.kinds, instructions.names,
            instructions.results, instructions.arg0s, instructions.arg1s,
            instructions.slot_anchors, instructions.expr0s,
            instructions.expr1s,
            instructions.source_types, instructions.machine_contact_kinds,
            instructions.machine_layer_manifest_ids,
            instructions.machine_layer_physical_grant_ids,
            instructions.machine_layer_physical_bases,
            instructions.machine_layer_physical_sizes,
            instructions.machine_layer_physical_modes,
            instructions.machine_layer_runtime_operations,
            instructions.machine_layer_hardware_adequate,
            instructions.machine_layer_authority_required,
            instructions.machine_layer_live_lease_required,
            use_starts, use_counts, uses,
            instructions.expr0_graphs, instructions.expr1_graphs,
            instructions.match_facts, instructions.destructure_facts,
            instructions.abi_type_names, instructions.runtime_call_abi
        ), cfg.local_refs
    );
}

func SelfMirCfgAttachLastRuntimeCallAbiAux(
    cfg: SelfMirCfgRows,
    type_name: String,
    operation: String,
    fact: CompilerRuntimeCallAbiFact
) -> SelfMirCfgRows {
    let instructions: SelfMirInstructionRows = cfg.instructions;
    let runtime_call_abi: SelfMirRuntimeCallAbiRows =
        SelfMirRuntimeCallAbiRowsAttachLastAux(
            instructions.runtime_call_abi, type_name, operation, fact
        );
    return SelfMirCfgRows(
        cfg.blocks,
        SelfMirInstructionRows(
            instructions.ids, instructions.kinds, instructions.names,
            instructions.results, instructions.arg0s, instructions.arg1s,
            instructions.slot_anchors, instructions.expr0s,
            instructions.expr1s,
            instructions.source_types, instructions.machine_contact_kinds,
            instructions.machine_layer_manifest_ids,
            instructions.machine_layer_physical_grant_ids,
            instructions.machine_layer_physical_bases,
            instructions.machine_layer_physical_sizes,
            instructions.machine_layer_physical_modes,
            instructions.machine_layer_runtime_operations,
            instructions.machine_layer_hardware_adequate,
            instructions.machine_layer_authority_required,
            instructions.machine_layer_live_lease_required,
            instructions.use_starts, instructions.use_counts,
            instructions.uses, instructions.expr0_graphs,
            instructions.expr1_graphs, instructions.match_facts,
            instructions.destructure_facts, instructions.abi_type_names,
            runtime_call_abi
        ), cfg.local_refs
    );
}

func SelfMirCfgAttachLastRuntimeCallAbi(
    cfg: SelfMirCfgRows,
    type_name: String,
    operation: String,
    fact: CompilerRuntimeCallAbiFact
) -> SelfMirCfgRows {
    let instructions: SelfMirInstructionRows = cfg.instructions;
    let runtime_call_abi: SelfMirRuntimeCallAbiRows =
        SelfMirRuntimeCallAbiRowsAttachLast(
            instructions.runtime_call_abi, type_name, operation, fact
        );
    return SelfMirCfgRows(
        cfg.blocks,
        SelfMirInstructionRows(
            instructions.ids, instructions.kinds, instructions.names,
            instructions.results, instructions.arg0s, instructions.arg1s,
            instructions.slot_anchors, instructions.expr0s,
            instructions.expr1s,
            instructions.source_types, instructions.machine_contact_kinds,
            instructions.machine_layer_manifest_ids,
            instructions.machine_layer_physical_grant_ids,
            instructions.machine_layer_physical_bases,
            instructions.machine_layer_physical_sizes,
            instructions.machine_layer_physical_modes,
            instructions.machine_layer_runtime_operations,
            instructions.machine_layer_hardware_adequate,
            instructions.machine_layer_authority_required,
            instructions.machine_layer_live_lease_required,
            instructions.use_starts, instructions.use_counts,
            instructions.uses, instructions.expr0_graphs,
            instructions.expr1_graphs, instructions.match_facts,
            instructions.destructure_facts, instructions.abi_type_names,
            runtime_call_abi
        ), cfg.local_refs
    );
}
