// Stable semantic collection ownership rows carried into self-host MIR.
//
// Binding syntax identity is the join key. Names and Array<String> spelling
// only validate the typed inventory; they are never the lookup authority.

import "../semantic/ast_collection/ast_collection_ownership_verdict_owner.pgy";
import "../semantic/ast_nominal_constructor_lookup_owner.pgy";
import "collection_ownership_state_table_owner.pgy";

struct SelfMirCollectionOwnershipFactRows {
    routine_starts: Array<Int>;
    routine_counts: Array<Int>;
    function_syntax_ids: Array<Int>;
    binding_syntax_ids: Array<Int>;
    origin_syntax_ids: Array<Int>;
    source_binding_syntax_ids: Array<Int>;
    element_ownerships: Array<Int>;
    dispositions: Array<Int>;
    origins: Array<Int>;
}

func SelfMirCollectionOwnershipFactRowsEmpty(
) -> SelfMirCollectionOwnershipFactRows {
    let ints: Array<Int> = [];
    return SelfMirCollectionOwnershipFactRows(
        ints, ints, ints, ints, ints, ints, ints, ints, ints
    );
}

// Classification for exact identity publication, not release permission.
// Both typed rows and admitted wire rows consume these canonical labels.
func SelfMirCollectionOwnershipIdentityWireRequired(
    ref origin: String, ref ownership: String
) -> Bool {
    if origin == "empty-literal" { return true; }
    return (ownership == "owned-elements" || ownership == "map-keys-snapshot") &&
        (origin == "map-keys" || origin == "clone" ||
         origin == "owned-literal" || origin == "binding");
}

func SelfMirCollectionOwnershipRowRequiresExactLocalRef(
    ref rows: SelfMirCollectionOwnershipFactRows, row: Int
) -> Bool {
    if row < 0 || row >= ArrayLength(rows.origins) ||
        row >= ArrayLength(rows.element_ownerships) { return false; }
    let origin: String = SelfMirCollectionOriginName(rows.origins[row]);
    let ownership: String = SelfMirCollectionOwnershipName(rows.element_ownerships[row]);
    return SelfMirCollectionOwnershipIdentityWireRequired(origin, ownership);
}

func SelfMirCollectionOwnershipFactRowsAppendEmptyRoutine(
    rows: SelfMirCollectionOwnershipFactRows
) -> SelfMirCollectionOwnershipFactRows {
    var starts: Array<Int> = rows.routine_starts;
    var counts: Array<Int> = rows.routine_counts;
    ArrayPush(starts, ArrayLength(rows.binding_syntax_ids));
    ArrayPush(counts, 0);
    return SelfMirCollectionOwnershipFactRows(
        starts, counts, rows.function_syntax_ids, rows.binding_syntax_ids,
        rows.origin_syntax_ids, rows.source_binding_syntax_ids,
        rows.element_ownerships, rows.dispositions, rows.origins
    );
}

// Each name is the state's own; a value outside the vocabulary has none, so
// no row can carry it under another state's name.
func SelfMirCollectionOwnershipName(value: Int) -> String {
    if value == SemanticAstCollectionOwnershipUnknown() { return "unknown"; }
    if value == SemanticAstCollectionOwnershipBorrowedElements() {
        return "borrowed-elements";
    }
    if value == SemanticAstCollectionOwnershipOwnedElements() {
        return "owned-elements";
    }
    if value == SemanticAstCollectionOwnershipMapKeysSnapshot() {
        return "map-keys-snapshot";
    }
    if value == SemanticAstCollectionOwnershipRetired() { return "retired"; }
    return "";
}

func SelfMirCollectionDispositionName(value: Int) -> String {
    if value == SemanticAstCollectionDispositionRetired() {
        return "retired";
    }
    if value == SemanticAstCollectionDispositionLive() { return "live"; }
    return "";
}

func SelfMirCollectionOriginName(value: Int) -> String {
    if value == SemanticAstCollectionOriginUnknown() { return "unknown"; }
    if value == SemanticAstCollectionOriginBorrowedLiteral() {
        return "borrowed-literal";
    }
    if value == SemanticAstCollectionOriginMapKeys() { return "map-keys"; }
    if value == SemanticAstCollectionOriginBinding() { return "binding"; }
    if value == SemanticAstCollectionOriginEmptyLiteral() {
        return "empty-literal";
    }
    if value == SemanticAstCollectionOriginMemberMove() {
        return "member-move";
    }
    if value == SemanticAstCollectionOriginClone() { return "clone"; }
    if value == SemanticAstCollectionOriginCallResult() {
        return "call-result";
    }
    if value == SemanticAstCollectionOriginFormalStringTransfer() {
        return "formal-string-transfer";
    }
    if value == SemanticAstCollectionOriginLocalStringTransfer() {
        return "local-string-transfer";
    }
    if value == SemanticAstCollectionOriginOwnedLiteral() {
        return "owned-literal";
    }
    return "";
}

func SelfMirCollectionOwnershipFactRowsReady(
    rows: SelfMirCollectionOwnershipFactRows,
    routine_count: Int
) -> Bool {
    let count: Int = ArrayLength(rows.binding_syntax_ids);
    if ArrayLength(rows.routine_starts) != routine_count ||
        ArrayLength(rows.routine_counts) != routine_count ||
        ArrayLength(rows.function_syntax_ids) != count ||
        ArrayLength(rows.origin_syntax_ids) != count ||
        ArrayLength(rows.source_binding_syntax_ids) != count ||
        ArrayLength(rows.element_ownerships) != count ||
        ArrayLength(rows.dispositions) != count ||
        ArrayLength(rows.origins) != count {
        return false;
    }
    var cursor: Int = 0;
    var routine: Int = 0;
    while routine < routine_count {
        if rows.routine_starts[routine] != cursor ||
            rows.routine_counts[routine] < 0 ||
            rows.routine_counts[routine] > count - cursor {
            return false;
        }
        cursor = cursor + rows.routine_counts[routine];
        routine = routine + 1;
    }
    return cursor == count;
}

func SelfMirCollectionOwnershipFactCardinalityReady(
    facts: SemanticAstCollectionOwnershipVerdict
) -> Bool {
    let count: Int = ArrayLength(facts.binding_syntax_ids);
    if !facts.ok { return false; }
    if ArrayLength(facts.function_syntax_ids) != count ||
        ArrayLength(facts.origin_syntax_ids) != count ||
        ArrayLength(facts.source_binding_syntax_ids) != count ||
        ArrayLength(facts.member_path_starts) != count ||
        ArrayLength(facts.member_path_counts) != count ||
        ArrayLength(facts.element_ownerships) != count ||
        ArrayLength(facts.dispositions) != count ||
        ArrayLength(facts.origins) != count {
        return false;
    }
    var path_cursor: Int = 0;
    var row: Int = 0;
    while row < count {
        let path_count: Int = facts.member_path_counts[row];
        if facts.member_path_starts[row] != path_cursor || path_count < 0 ||
            path_cursor > ArrayLength(facts.member_path_field_syntax_ids) ||
            path_count > ArrayLength(facts.member_path_field_syntax_ids) -
                path_cursor ||
            (facts.origins[row] == SemanticAstCollectionOriginMemberMove() &&
                (path_count == 0 ||
                 facts.member_path_field_syntax_ids[
                    path_cursor + path_count - 1] !=
                    facts.origin_syntax_ids[row])) ||
            (facts.origins[row] != SemanticAstCollectionOriginMemberMove() &&
                path_count != 0) {
            return false;
        }
        var path_row: Int = 0;
        while path_row < path_count {
            if facts.member_path_field_syntax_ids[path_cursor + path_row] <= 0 {
                return false;
            }
            path_row = path_row + 1;
        }
        path_cursor = path_cursor + path_count;
        row = row + 1;
    }
    return path_cursor == ArrayLength(facts.member_path_field_syntax_ids);
}

func SelfMirCollectionOwnershipInventoryRow(
    ref binding_syntax_ids: Array<Int>,
    binding_syntax_id: Int
) -> Int {
    var found: Int = -1;
    var row: Int = 0;
    while row < ArrayLength(binding_syntax_ids) {
        if binding_syntax_ids[row] == binding_syntax_id {
            if found >= 0 { return -2; }
            found = row;
        }
        row = row + 1;
    }
    return found;
}

func SelfMirCollectionOwnershipRetiredSourceHasDestination(
    facts: SemanticAstCollectionOwnershipVerdict,
    function_syntax_id: Int,
    source_binding_syntax_id: Int,
    element_ownership: Int
) -> Bool {
    var matched: Int = 0;
    var row: Int = 0;
    while row < ArrayLength(facts.binding_syntax_ids) {
        if facts.function_syntax_ids[row] == function_syntax_id &&
            facts.origins[row] == SemanticAstCollectionOriginBinding() &&
            facts.source_binding_syntax_ids[row] ==
                source_binding_syntax_id &&
            facts.element_ownerships[row] == element_ownership {
            matched = matched + 1;
        }
        row = row + 1;
    }
    return matched == 1;
}

func SelfMirCollectionOwnershipBindingType(
    ref local_types: Array<String>,
    ref local_binding_syntax_ids: Array<Int>,
    ref parameter_types: Array<String>,
    ref parameter_binding_syntax_ids: Array<Int>,
    binding_syntax_id: Int
) -> String {
    // The selected type text leaves the readonly inventory's lifetime.
    let local_row: Int = SelfMirCollectionOwnershipInventoryRow(
        local_binding_syntax_ids, binding_syntax_id);
    if local_row >= 0 { return Concat("", local_types[local_row]); }
    var found: Int = -1;
    var row: Int = 0;
    while row < ArrayLength(parameter_binding_syntax_ids) {
        if parameter_binding_syntax_ids[row] == binding_syntax_id {
            if found >= 0 { return ""; }
            found = row;
        }
        row = row + 1;
    }
    if found >= 0 { return Concat("", parameter_types[found]); }
    return "";
}

func SelfMirCollectionOwnershipMemberPathReady(
    ref constructors: SemanticAstNominalConstructorFacts,
    source_type: String,
    ref field_path_syntax_ids: Array<Int>,
    path_start: Int,
    path_count: Int,
    expected_leaf_syntax_id: Int
) -> Bool {
    if !SemanticAstNominalConstructorRowsReady(constructors) ||
        source_type == "" || path_start < 0 || path_count <= 0 ||
        path_start > ArrayLength(field_path_syntax_ids) ||
        path_count > ArrayLength(field_path_syntax_ids) - path_start ||
        expected_leaf_syntax_id <= 0 ||
        field_path_syntax_ids[path_start + path_count - 1] !=
            expected_leaf_syntax_id {
        return false;
    }
    var current_type: String = Concat("", source_type);
    var path_row: Int = 0;
    while path_row < path_count {
        let shape: SemanticCanonicalTypeNameFact =
            SemanticCanonicalTypeNameFactFrom(current_type);
        let constructor: Option<Int> =
            SemanticAstNominalConstructorIndexForName(
                constructors, shape.nominal_base_name);
        if shape.nominal_base_name == "" || !IsSome(constructor) {
            return false;
        }
        let constructor_row: Int = UnwrapOption(constructor);
        var matched_field_row: Int = -1;
        var field: Int = 0;
        while field < constructors.param_counts[constructor_row] {
            let candidate_row: Int =
                constructors.param_starts[constructor_row] + field;
            if constructors.field_source_syntax_ids[candidate_row] ==
                    field_path_syntax_ids[path_start + path_row] {
                if matched_field_row >= 0 { return false; }
                matched_field_row = candidate_row;
            }
            field = field + 1;
        }
        if matched_field_row < 0 { return false; }
        current_type = Concat("",
            constructors.param_type_names[matched_field_row]);
        path_row = path_row + 1;
    }
    return SemanticCanonicalTypeName(current_type) == "Array<String>";
}

func SelfMirCollectionOwnershipMemberSourceReady(
    ref facts: SemanticAstCollectionOwnershipVerdict,
    fact_row: Int,
    ref constructors: SemanticAstNominalConstructorFacts,
    ref local_types: Array<String>,
    ref local_binding_syntax_ids: Array<Int>,
    ref parameter_types: Array<String>,
    ref parameter_binding_syntax_ids: Array<Int>,
    source_binding_syntax_id: Int,
    field_syntax_id: Int
) -> Bool {
    if fact_row < 0 || fact_row >= ArrayLength(facts.member_path_starts) ||
        fact_row >= ArrayLength(facts.member_path_counts) {
        return false;
    }
    let source_type: String = SelfMirCollectionOwnershipBindingType(
        local_types, local_binding_syntax_ids,
        parameter_types, parameter_binding_syntax_ids,
        source_binding_syntax_id);
    return SelfMirCollectionOwnershipMemberPathReady(
        constructors, source_type, facts.member_path_field_syntax_ids,
        facts.member_path_starts[fact_row],
        facts.member_path_counts[fact_row], field_syntax_id);
}

func SelfMirCollectionOwnershipFactRowsAppendRoutine(
    rows: SelfMirCollectionOwnershipFactRows,
    facts: SemanticAstCollectionOwnershipVerdict,
    function_syntax_id: Int,
    inventory_ok: Bool,
    ref inventory_names: Array<String>,
    ref inventory_types: Array<String>,
    ref inventory_binding_syntax_ids: Array<Int>,
    ref parameter_types: Array<String>,
    ref parameter_binding_syntax_ids: Array<Int>,
    ref constructors: SemanticAstNominalConstructorFacts
) -> SelfMirCollectionOwnershipFactRows {
    var starts: Array<Int> = rows.routine_starts;
    var counts: Array<Int> = rows.routine_counts;
    var function_ids: Array<Int> = rows.function_syntax_ids;
    var binding_ids: Array<Int> = rows.binding_syntax_ids;
    var origin_ids: Array<Int> = rows.origin_syntax_ids;
    var source_ids: Array<Int> = rows.source_binding_syntax_ids;
    var ownerships: Array<Int> = rows.element_ownerships;
    var dispositions: Array<Int> = rows.dispositions;
    var origins: Array<Int> = rows.origins;
    ArrayPush(starts, ArrayLength(binding_ids));
    var count: Int = 0;
    if !SelfMirCollectionOwnershipFactCardinalityReady(facts) ||
        !inventory_ok ||
        ArrayLength(inventory_names) != ArrayLength(inventory_types) ||
        ArrayLength(inventory_names) !=
            ArrayLength(inventory_binding_syntax_ids) {
        ArrayPush(counts, -1);
        return SelfMirCollectionOwnershipFactRows(
            starts, counts, function_ids, binding_ids, origin_ids,
            source_ids, ownerships, dispositions, origins
        );
    }
    var row: Int = 0;
    while row < ArrayLength(facts.binding_syntax_ids) {
        if facts.function_syntax_ids[row] == function_syntax_id {
            let binding_id: Int = facts.binding_syntax_ids[row];
            let source_id: Int = facts.source_binding_syntax_ids[row];
            let ownership: Int = facts.element_ownerships[row];
            let disposition: Int = facts.dispositions[row];
            let origin: Int = facts.origins[row];
            let inventory_row: Int = SelfMirCollectionOwnershipInventoryRow(
                inventory_binding_syntax_ids, binding_id
            );
            var source_row: Int = -1;
            var source_fact_row: Int = -1;
            if source_id > 0 {
                source_row = SelfMirCollectionOwnershipInventoryRow(
                    inventory_binding_syntax_ids, source_id
                );
            }
            var prior: Int = 0;
            var duplicate: Bool = false;
            while prior < ArrayLength(binding_ids) {
                if function_ids[prior] == function_syntax_id &&
                    binding_ids[prior] == binding_id {
                    duplicate = true;
                }
                if function_ids[prior] == function_syntax_id &&
                    binding_ids[prior] == source_id {
                    source_fact_row = prior;
                }
                prior = prior + 1;
            }
            let origin_name: String = SelfMirCollectionOriginName(origin);
            let ownership_name: String = SelfMirCollectionOwnershipName(ownership);
            // The state table owns which ownership each origin reaches; here
            // each origin's source identity is checked.
            let origin_consistent: Bool =
                MirCollectionOwnershipStateAdmitted(origin_name, ownership_name,
                    SelfMirCollectionDispositionName(disposition)) &&
                (((origin == SemanticAstCollectionOriginUnknown() ||
                   origin == SemanticAstCollectionOriginBorrowedLiteral() ||
                   origin == SemanticAstCollectionOriginMapKeys() ||
                   origin == SemanticAstCollectionOriginEmptyLiteral() ||
                   origin == SemanticAstCollectionOriginClone() ||
                   origin == SemanticAstCollectionOriginOwnedLiteral() ||
                   origin == SemanticAstCollectionOriginCallResult()) &&
                    source_id == 0) ||
                (origin == SemanticAstCollectionOriginMemberMove() &&
                    source_id > 0 && source_id != binding_id &&
                    SelfMirCollectionOwnershipMemberSourceReady(
                        facts, row, constructors, inventory_types,
                        inventory_binding_syntax_ids,
                        parameter_types, parameter_binding_syntax_ids,
                        source_id, facts.origin_syntax_ids[row])) ||
                ((origin == SemanticAstCollectionOriginFormalStringTransfer() ||
                  origin == SemanticAstCollectionOriginLocalStringTransfer()) &&
                    source_id > 0 && source_id != binding_id &&
                    source_id == facts.origin_syntax_ids[row]) ||
                (origin == SemanticAstCollectionOriginBinding() &&
                    source_id > 0 && source_id != binding_id &&
                    source_row >= 0 &&
                    inventory_types[source_row] == "Array<String>" &&
                    source_fact_row >= 0 &&
                    ownerships[source_fact_row] == ownership &&
                    dispositions[source_fact_row] ==
                        SemanticAstCollectionDispositionRetired()));
            if binding_id <= 0 || facts.origin_syntax_ids[row] <= 0 ||
                inventory_row < 0 ||
                inventory_types[inventory_row] != "Array<String>" ||
                (disposition == SemanticAstCollectionDispositionRetired() &&
                 !MirCollectionOwnershipRetiredWithoutDestination(origin_name, ownership_name) &&
                 !SelfMirCollectionOwnershipRetiredSourceHasDestination(
                    facts, function_syntax_id, binding_id, ownership)) ||
                !origin_consistent || duplicate {
                ArrayPush(counts, -1);
                return SelfMirCollectionOwnershipFactRows(
                    starts, counts, function_ids, binding_ids, origin_ids,
                    source_ids, ownerships, dispositions, origins
                );
            }
            ArrayPush(function_ids, function_syntax_id);
            ArrayPush(binding_ids, binding_id);
            ArrayPush(origin_ids, facts.origin_syntax_ids[row]);
            ArrayPush(source_ids, source_id);
            ArrayPush(ownerships, ownership);
            ArrayPush(dispositions, disposition);
            ArrayPush(origins, origin);
            count = count + 1;
        }
        row = row + 1;
    }
    ArrayPush(counts, count);
    return SelfMirCollectionOwnershipFactRows(
        starts, counts, function_ids, binding_ids, origin_ids,
        source_ids, ownerships, dispositions, origins
    );
}
