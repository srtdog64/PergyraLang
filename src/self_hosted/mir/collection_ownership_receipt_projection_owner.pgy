// Consume stable semantic event identities at the exact MIR instruction.

import "program_fact_owner.pgy";
import "collection_ownership_receipt_fact_owner.pgy";
import "../semantic/ast_collection_ownership_verdict_owner.pgy";
import "../semantic/ast_expression_call_identity_owner.pgy";

func SelfMirCollectionOwnershipReceiptFormalOrdinal(
    ref signatures: SemanticAstFunctionSignatureFacts,
    function_syntax_id: Int,
    binding_syntax_id: Int
) -> Option<Int> {
    let signature: Option<Int> =
        SemanticAstFunctionSignatureIndexForNode(
            signatures, function_syntax_id);
    if !IsSome(signature) { return None; }
    let signature_row: Int = UnwrapOption(signature);
    let start: Int = signatures.param_starts[signature_row];
    let count: Int = signatures.param_counts[signature_row];
    var matched: Int = -1;
    var ordinal: Int = 0;
    while ordinal < count {
        if signatures.param_node_ids[start + ordinal] == binding_syntax_id {
            if matched >= 0 { return None; }
            matched = ordinal;
        }
        ordinal = ordinal + 1;
    }
    if matched < 0 { return None; }
    return Some(matched);
}

func SelfMirCollectionOwnershipReceiptBindingReady(
    ref facts: SemanticAstCollectionOwnershipVerdict,
    ref signatures: SemanticAstFunctionSignatureFacts,
    function_syntax_id: Int,
    binding_syntax_id: Int, effect: Int
) -> Bool {
    var matched: Int = 0;
    var row: Int = 0;
    while row < ArrayLength(facts.binding_syntax_ids) {
        if facts.function_syntax_ids[row] == function_syntax_id &&
            facts.binding_syntax_ids[row] == binding_syntax_id {
            matched = matched + 1;
            let owned_effect: Bool =
                (effect == SemanticAstCollectionOwnershipEffectOwnedStringPush() ||
                 effect == SemanticAstCollectionOwnershipEffectDrop() ||
                 effect == SemanticAstCollectionOwnershipEffectOwnedStringSet() ||
                 effect == SemanticAstCollectionOwnershipEffectOwnedStringPop()) &&
                (facts.element_ownerships[row] == SemanticAstCollectionOwnershipOwnedElements() ||
                 facts.element_ownerships[row] == SemanticAstCollectionOwnershipMapKeysSnapshot()) &&
                (facts.origins[row] == SemanticAstCollectionOriginMapKeys() ||
                 facts.origins[row] == SemanticAstCollectionOriginClone() ||
                 facts.origins[row] == SemanticAstCollectionOriginOwnedLiteral() ||
                 facts.origins[row] == SemanticAstCollectionOriginBinding());
            if facts.origins[row] != SemanticAstCollectionOriginEmptyLiteral() &&
                !owned_effect {
                return false;
            }
        }
        row = row + 1;
    }
    if matched == 1 { return true; }
    if matched != 0 ||
        (effect != SemanticAstCollectionOwnershipEffectOwnedStringPush() &&
         effect != SemanticAstCollectionOwnershipEffectShallowMutation() &&
         effect != SemanticAstCollectionOwnershipEffectOwnedStringSet() &&
         effect != SemanticAstCollectionOwnershipEffectOwnedStringPop()) {
        return false;
    }
    let formal_ordinal: Option<Int> =
        SelfMirCollectionOwnershipReceiptFormalOrdinal(
            signatures, function_syntax_id, binding_syntax_id);
    if !IsSome(formal_ordinal) { return false; }
    let signature_row: Int = UnwrapOption(
        SemanticAstFunctionSignatureIndexForNode(
            signatures, function_syntax_id));
    let start: Int = signatures.param_starts[signature_row];
    let flat: Int = start + UnwrapOption(formal_ordinal);
    return signatures.param_modes[flat] == 1 &&
        SemanticAstCollectionOwnershipIsStringArray(
            signatures.param_types[flat]);
}

func SelfMirCollectionOwnershipReceiptRowsAppendRoutine(
    rows: SelfMirCollectionOwnershipReceiptRows,
    ref facts: SemanticAstCollectionOwnershipVerdict,
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    function_syntax_id: Int,
    ref instructions: SelfMirInstructionRows,
    ref local_refs: SelfMirInstructionLocalRefRows
) -> SelfMirCollectionOwnershipReceiptRows {
    let base: Int = ArrayLength(rows.effect_kinds);
    rows = SelfMirCollectionOwnershipReceiptRowsAppendEmptyInstructions(
        rows, ArrayLength(instructions.ids)
    );
    var effects: Array<Int> = rows.effect_kinds;
    var receiver_ids: Array<Int> = rows.receiver_binding_syntax_ids;
    var source_ids: Array<Int> = rows.source_binding_syntax_ids;
    var valid: Bool = rows.valid && facts.ok &&
        SemanticAstCollectionOwnershipReceiptRowsReady(facts.receipts);
    var receipt: Int = 0;
    while valid && receipt < ArrayLength(
            facts.receipts.function_syntax_ids) {
        if facts.receipts.function_syntax_ids[receipt] !=
                function_syntax_id {
            receipt = receipt + 1;
            continue;
        }
        var target_node: Int = -1;
        let ordinal: Int = facts.receipts.local_call_ordinals[receipt];
        if ordinal >= 0 {
            let node: Option<Int> = SemanticExpressionCallNodeForIdentity(
                surfaces,
                facts.receipts.owner_node_ids[receipt],
                facts.receipts.lanes[receipt], ordinal
            );
            if IsSome(node) { target_node = UnwrapOption(node); }
        }
        if (ordinal >= 0 && target_node < 0) ||
            !SelfMirCollectionOwnershipReceiptBindingReady(
                facts, signatures, function_syntax_id,
                facts.receipts.receiver_binding_syntax_ids[receipt],
                facts.receipts.effect_kinds[receipt]) {
            valid = false;
            continue;
        }
        var matched: Int = -1;
        let receiver_binding: Int =
            facts.receipts.receiver_binding_syntax_ids[receipt];
        var expected_ref: String = SelfMirLocalRef(
            "declaration", receiver_binding, 0);
        let formal_ordinal: Option<Int> =
            SelfMirCollectionOwnershipReceiptFormalOrdinal(
                signatures, function_syntax_id, receiver_binding);
        if IsSome(formal_ordinal) {
            expected_ref = SelfMirLocalRef(
                "parameter", function_syntax_id,
                UnwrapOption(formal_ordinal));
        }
        var instruction: Int = 0;
        while instruction < ArrayLength(instructions.ids) {
            let call_match: Bool = ordinal >= 0 &&
                instructions.expr0_graphs.has_roots[instruction] == 1 &&
                target_node >=
                    instructions.expr0_graphs.node_starts[instruction] &&
                target_node <
                    instructions.expr0_graphs.node_starts[instruction] +
                    instructions.expr0_graphs.node_counts[instruction];
            let statement_match: Bool = ordinal < 0 &&
                local_refs.source_statement_syntax_ids[instruction] ==
                    facts.receipts.owner_node_ids[receipt] &&
                local_refs.primary_refs[instruction] == expected_ref;
            if call_match || statement_match {
                if matched >= 0 { valid = false; }
                matched = instruction;
            }
            instruction = instruction + 1;
        }
        if matched < 0 || effects[base + matched] != 0 {
            valid = false;
            continue;
        }
        ArraySet(effects, base + matched,
            facts.receipts.effect_kinds[receipt]);
        ArraySet(receiver_ids, base + matched,
            facts.receipts.receiver_binding_syntax_ids[receipt]);
        ArraySet(source_ids, base + matched,
            facts.receipts.source_binding_syntax_ids[receipt]);
        receipt = receipt + 1;
    }
    return SelfMirCollectionOwnershipReceiptRows(
        valid, effects, receiver_ids, source_ids
    );
}
