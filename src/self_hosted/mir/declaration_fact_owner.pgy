// Flat MIR declaration rows shared by producer, verifier, JSON, and lowering.

import "../semantic/callable_receiver_carriage_policy_owner.pgy";
import "declaration_zone_authority_rows_owner.pgy";
import "nominal_abi_layout_fact_owner.pgy";
import "option_nominal_abi_layout_fact_owner.pgy";

struct SelfMirDeclarationRows {
    kinds: Array<String>;
    nominal_kinds: Array<String>;
    names: Array<String>;
    source_syntax_ids: Array<Int>;
    source_module_paths: Array<String>;
    target_types: Array<String>;
    uses_pointer_self: Array<Int>;
    field_starts: Array<Int>;
    field_counts: Array<Int>;
    field_names: Array<String>;
    field_kinds: Array<String>;
    field_types: Array<String>;
    field_source_syntax_ids: Array<Int>;
    method_starts: Array<Int>;
    method_counts: Array<Int>;
    method_names: Array<String>;
    method_returns: Array<String>;
    method_is_actions: Array<Int>;
    method_requires_starts: Array<Int>;
    method_requires_counts: Array<Int>;
    method_requires_names: Array<String>;
    method_within_zone_names: Array<String>;
    method_causes_names: Array<String>;
    method_authorized_by_starts: Array<Int>;
    method_authorized_by_counts: Array<Int>;
    method_authorized_by_names: Array<String>;
    method_caps_present: Array<Int>;
    method_cap_starts: Array<Int>;
    method_cap_counts: Array<Int>;
    method_cap_names: Array<String>;
    method_effects_present: Array<Int>;
    method_effect_starts: Array<Int>;
    method_effect_counts: Array<Int>;
    method_effect_names: Array<String>;
    variant_starts: Array<Int>;
    variant_counts: Array<Int>;
    variant_names: Array<String>;
    variant_param_starts: Array<Int>;
    variant_param_counts: Array<Int>;
    variant_param_type_names: Array<String>;
    generic_starts: Array<Int>;
    generic_counts: Array<Int>;
    generic_names: Array<String>;
    generic_constraint_type_names: Array<String>;
    generic_default_type_names: Array<String>;
    method_param_starts: Array<Int>;
    method_param_counts: Array<Int>;
    method_param_names: Array<String>;
    method_param_type_names: Array<String>;
    role_slot_starts: Array<Int>;
    role_slot_counts: Array<Int>;
    role_slot_names: Array<String>;
    role_slot_type_names: Array<String>;
    role_slot_dynamic: Array<Int>;
    role_impl_starts: Array<Int>;
    role_impl_counts: Array<Int>;
    role_impl_ability_names: Array<String>;
    role_impl_method_starts: Array<Int>;
    role_impl_method_counts: Array<Int>;
    zone_authorities: SelfMirDeclarationZoneAuthorityRows;
    nominal_abi_layouts: SelfMirNominalAbiLayoutRows;
    option_nominal_abi_layouts: SelfMirOptionNominalAbiLayoutRows;
}
func SelfMirDeclarationRowsEmpty() -> SelfMirDeclarationRows {
    let ints: Array<Int> = [];
    let strings: Array<String> = [];
    return SelfMirDeclarationRows(
        strings, strings, strings, ints, strings, strings, ints, ints, ints,
        strings, strings,
        strings, ints,
        ints, ints, strings, strings,
        ints, ints, ints, strings, strings, strings,
        ints, ints, strings, ints, ints, ints, strings,
        ints, ints, ints, strings,
        ints, ints, strings, ints, ints, strings,
        ints, ints, strings, strings, strings,
        ints, ints, strings, strings,
        ints, ints, strings, strings, ints,
        ints, ints, strings, ints, ints,
        SelfMirDeclarationZoneAuthorityRowsEmpty(),
        SelfMirNominalAbiLayoutRowsEmpty(),
        SelfMirOptionNominalAbiLayoutRowsEmpty()
    );
}

func SelfMirDeclarationUsesPointerSelf(nominal_kind: String) -> Int {
    if CallableReceiverNominalKindUsesMutableIdentity(nominal_kind) {
        return 1;
    }
    return 0;
}
