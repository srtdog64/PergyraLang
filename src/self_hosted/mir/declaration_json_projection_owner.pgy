// Declaration-specific pgy.mir.v1 projection rows.

import "declaration_rows_owner.pgy";
import "json_projection_support_owner.pgy";
import "nominal_abi_layout_json_projection_owner.pgy";
import "../lib/json_emit.pgy";
import "../semantic/ast_type_name_canonical_owner.pgy";

func SelfMirJsonDeclarationStringRange(
    values: Array<String>, start: Int, count: Int
) -> String {
    let rows: Array<String> = [];
    let i: Int = 0;
    while i < count {
        ArrayPush(rows, JsonStringLiteral(values[start + i]));
        i = i + 1;
    }
    return JsonEmitArray(rows);
}

func SelfMirJsonDeclarationRequires(
    rows: SelfMirDeclarationRows, method_row: Int
) -> String {
    let refs: Array<String> = [];
    let i: Int = 0;
    while i < rows.method_requires_counts[method_row] {
        let name: String = rows.method_requires_names[
            rows.method_requires_starts[method_row] + i
        ];
        let shape: SemanticConstructedTypeNameFact =
            SemanticConstructedTypeNameFactFrom(name);
        let base: String = name;
        let actuals: Array<String> = [];
        if shape.ok {
            base = shape.nominal_base_name;
            let actual_i: Int = 0;
            while actual_i < ArrayLength(shape.actual_type_names) {
                ArrayPush(
                    actuals,
                    JsonStringLiteral(shape.actual_type_names[actual_i])
                );
                actual_i = actual_i + 1;
            }
        }
        ArrayPush(refs, JsonEmitObject([
            JsonEmitFieldString("base", base),
            JsonEmitFieldRaw("actuals", JsonEmitArray(actuals))
        ]));
        i = i + 1;
    }
    return JsonEmitArray(refs);
}

func SelfMirJsonDeclarationMethodContract(
    rows: SelfMirDeclarationRows, method_row: Int
) -> String {
    return JsonEmitObject([
        JsonEmitFieldRaw(
            "requires", SelfMirJsonDeclarationRequires(rows, method_row)
        ),
        JsonEmitFieldRaw(
            "within", SelfMirJsonOptionalString(
                SelfMirOptionalString(rows.method_within_zone_names[method_row])
            )
        ),
        JsonEmitFieldRaw(
            "causes", SelfMirJsonOptionalString(
                SelfMirOptionalString(rows.method_causes_names[method_row])
            )
        ),
        JsonEmitFieldRaw(
            "authorized_by", SelfMirJsonDeclarationStringRange(
                rows.method_authorized_by_names,
                rows.method_authorized_by_starts[method_row],
                rows.method_authorized_by_counts[method_row]
            )
        ),
        JsonEmitFieldBool(
            "caps_present", rows.method_caps_present[method_row] == 1
        ),
        JsonEmitFieldRaw(
            "caps", SelfMirJsonDeclarationStringRange(
                rows.method_cap_names, rows.method_cap_starts[method_row],
                rows.method_cap_counts[method_row]
            )
        ),
        JsonEmitFieldBool(
            "effects_present", rows.method_effects_present[method_row] == 1
        ),
        JsonEmitFieldRaw(
            "effects", SelfMirJsonDeclarationStringRange(
                rows.method_effect_names,
                rows.method_effect_starts[method_row],
                rows.method_effect_counts[method_row]
            )
        )
    ]);
}

func SelfMirJsonDeclarationMethodParams(
    rows: SelfMirDeclarationRows,
    method_row: Int
) -> String {
    let params: Array<String> = [];
    let param_i: Int = 0;
    while param_i < rows.method_param_counts[method_row] {
        let param_row: Int = rows.method_param_starts[method_row] + param_i;
        ArrayPush(params, JsonEmitObject([
            JsonEmitFieldString("name", rows.method_param_names[param_row]),
            JsonEmitFieldRaw(
                "type", SelfMirJsonOptionalString(
                    SelfMirOptionalString(rows.method_param_type_names[param_row])
                )
            )
        ]));
        param_i = param_i + 1;
    }
    return JsonEmitArray(params);
}

func SelfMirJsonDeclarationGenericParams(
    rows: SelfMirDeclarationRows,
    declaration_index: Int
) -> String {
    let generics: Array<String> = [];
    let generic_i: Int = 0;
    while generic_i < rows.generic_counts[declaration_index] {
        let generic_row: Int = rows.generic_starts[declaration_index] +
            generic_i;
        ArrayPush(generics, JsonEmitObject([
            JsonEmitFieldString("name", rows.generic_names[generic_row]),
            JsonEmitFieldRaw(
                "constraint", SelfMirJsonOptionalString(
                    SelfMirOptionalString(
                        rows.generic_constraint_type_names[generic_row]
                    )
                )
            ),
            JsonEmitFieldRaw(
                "default_type", SelfMirJsonOptionalString(
                    SelfMirOptionalString(
                        rows.generic_default_type_names[generic_row]
                    )
                )
            )
        ]));
        generic_i = generic_i + 1;
    }
    return JsonEmitArray(generics);
}

func SelfMirJsonDeclarationRoleSlots(
    rows: SelfMirDeclarationRows,
    declaration_index: Int
) -> String {
    let slots: Array<String> = [];
    let no_ability_actuals: Array<String> = [];
    let slot_i: Int = 0;
    while slot_i < rows.role_slot_counts[declaration_index] {
        let slot_row: Int = rows.role_slot_starts[declaration_index] + slot_i;
        let ability_json: String = JsonEmitObject([
            JsonEmitFieldString("base", rows.role_slot_type_names[slot_row]),
            JsonEmitFieldRaw("actuals", JsonEmitArray(no_ability_actuals))
        ]);
        ArrayPush(slots, JsonEmitObject([
            JsonEmitFieldString("name", rows.role_slot_names[slot_row]),
            JsonEmitFieldBool(
                "dynamic", rows.role_slot_dynamic[slot_row] == 1
            ),
            JsonEmitFieldRaw("abilities", JsonEmitArray([ability_json]))
        ]));
        slot_i = slot_i + 1;
    }
    return JsonEmitArray(slots);
}

func SelfMirJsonDeclarationZoneAuthorities(
    rows: SelfMirDeclarationRows,
    declaration_index: Int
) -> String {
    let authorities: Array<String> = [];
    let authority_i: Int = 0;
    while authority_i <
        rows.zone_authorities.declaration_counts[declaration_index] {
        let authority_row: Int =
            rows.zone_authorities.declaration_starts[declaration_index] +
            authority_i;
        let required: Array<String> = [];
        let ability_i: Int = 0;
        while ability_i <
            rows.zone_authorities.required_ability_counts[authority_row] {
            let ability_row: Int =
                rows.zone_authorities.required_ability_starts[authority_row] +
                ability_i;
            let actuals: Array<String> = [];
            ArrayPush(required, JsonEmitObject([
                JsonEmitFieldString(
                    "base",
                    rows.zone_authorities.required_ability_names[ability_row]
                ),
                JsonEmitFieldRaw("actuals", JsonEmitArray(actuals))
            ]));
            ability_i = ability_i + 1;
        }
        ArrayPush(authorities, JsonEmitObject([
            JsonEmitFieldString(
                "subject_slot",
                rows.zone_authorities.subject_slot_names[authority_row]
            ),
            JsonEmitFieldRaw("requires", JsonEmitArray(required))
        ]));
        authority_i = authority_i + 1;
    }
    return JsonEmitArray(authorities);
}

func SelfMirJsonDeclarationRoleImpls(
    rows: SelfMirDeclarationRows,
    declaration_index: Int
) -> String {
    let impls: Array<String> = [];
    let no_impl_actuals: Array<String> = [];
    let impl_i: Int = 0;
    while impl_i < rows.role_impl_counts[declaration_index] {
        let impl_row: Int = rows.role_impl_starts[declaration_index] + impl_i;
        ArrayPush(impls, JsonEmitObject([
            JsonEmitFieldRaw("ability", JsonEmitObject([
                JsonEmitFieldString(
                    "base", rows.role_impl_ability_names[impl_row]
                ),
                JsonEmitFieldRaw(
                    "actuals", JsonEmitArray(no_impl_actuals)
                )
            ])),
            JsonEmitFieldNumber(
                "method_start", ToString(rows.role_impl_method_starts[impl_row])
            ),
            JsonEmitFieldNumber(
                "method_count", ToString(rows.role_impl_method_counts[impl_row])
            )
        ]));
        impl_i = impl_i + 1;
    }
    return JsonEmitArray(impls);
}

func SelfMirJsonDeclaration(
    facts: SelfMirProgramFacts,
    declaration_index: Int
) -> String {
    let rows: SelfMirDeclarationRows = facts.declarations;
    let fields_rows: Array<String> = [];
    let field_i: Int = 0;
    while field_i < rows.field_counts[declaration_index] {
        let row: Int = rows.field_starts[declaration_index] + field_i;
        ArrayPush(fields_rows, JsonEmitObject([
            JsonEmitFieldString("name", rows.field_names[row]),
            JsonEmitFieldString("type", rows.field_types[row]),
            JsonEmitFieldString("field_kind", rows.field_kinds[row]),
            JsonEmitFieldNumber(
                "source_syntax_id", ToString(rows.field_source_syntax_ids[row])
            )
        ]));
        field_i = field_i + 1;
    }
    let methods: Array<String> = [];
    let method_i: Int = 0;
    while method_i < rows.method_counts[declaration_index] {
        let row: Int = rows.method_starts[declaration_index] + method_i;
        let callable_kind: String = "function";
        if rows.method_is_actions[row] == 1 { callable_kind = "action"; }
        let method: Array<String> = [
            JsonEmitFieldString("name", rows.method_names[row]),
            JsonEmitFieldString("return", rows.method_returns[row]),
            JsonEmitFieldString("callable_kind", callable_kind),
            JsonEmitFieldRaw(
                "contract",
                SelfMirJsonDeclarationMethodContract(rows, row)
            )
        ];
        if rows.kinds[declaration_index] == "ability" ||
            rows.kinds[declaration_index] == "role" ||
            rows.kinds[declaration_index] == "extern" {
            ArrayPush(method, JsonEmitFieldRaw(
                "params", SelfMirJsonDeclarationMethodParams(rows, row)
            ));
        }
        ArrayPush(methods, JsonEmitObject(method));
        method_i = method_i + 1;
    }
    let variants: Array<String> = [];
    let variant_i: Int = 0;
    while variant_i < rows.variant_counts[declaration_index] {
        let variant_row: Int = rows.variant_starts[declaration_index] +
            variant_i;
        let variant: Array<String> = [
            JsonEmitFieldString("name", rows.variant_names[variant_row]),
            JsonEmitFieldNumber(
                "param_count", ToString(rows.variant_param_counts[variant_row])
            )
        ];
        let param_types: Array<String> = [];
        let param_index: Int = 0;
        while param_index < rows.variant_param_counts[variant_row] {
            ArrayPush(param_types, JsonStringLiteral(
                rows.variant_param_type_names[
                    rows.variant_param_starts[variant_row] + param_index
                ]
            ));
            param_index = param_index + 1;
        }
        ArrayPush(
            variant, JsonEmitFieldRaw("param_types", JsonEmitArray(param_types))
        );
        ArrayPush(variants, JsonEmitObject(variant));
        variant_i = variant_i + 1;
    }
    let fields: Array<String> = [
        JsonEmitFieldString("kind", rows.kinds[declaration_index]),
        JsonEmitFieldString(
            "nominal_kind", rows.nominal_kinds[declaration_index]
        ),
        JsonEmitFieldString("name", rows.names[declaration_index]),
        JsonEmitFieldNumber(
            "source_syntax_id",
            ToString(rows.source_syntax_ids[declaration_index])
        ),
        JsonEmitFieldString(
            "source_module_path", rows.source_module_paths[declaration_index]
        ),
        JsonEmitFieldRaw("fields", JsonEmitArray(fields_rows))
    ];
    if rows.nominal_kinds[declaration_index] == "struct" {
        let layout: String = SelfMirJsonNominalAbiLayout(
            rows.nominal_abi_layouts, declaration_index,
            rows.names[declaration_index]
        );
        ArrayPush(fields, JsonEmitFieldNumber(
            "abi_layout_id",
            ToString(rows.nominal_abi_layouts.layout_ids[declaration_index])
        ));
        ArrayPush(fields, JsonEmitFieldBool(
            "abi_layout_required", StringLength(layout) > 0
        ));
        let layout_wire: String = "null";
        if StringLength(layout) > 0 { layout_wire = layout; }
        ArrayPush(fields, JsonEmitFieldRaw("abi_layout", layout_wire));
    }
    if rows.nominal_kinds[declaration_index] == "zone" {
        ArrayPush(fields, JsonEmitFieldRaw(
            "zone_authorities",
            SelfMirJsonDeclarationZoneAuthorities(rows, declaration_index)
        ));
    }
    if rows.nominal_kinds[declaration_index] != "struct" {
        ArrayPush(fields, JsonEmitFieldRaw("methods", JsonEmitArray(methods)));
    }
    if rows.generic_counts[declaration_index] > 0 {
        ArrayPush(fields, JsonEmitFieldRaw(
            "generic_params",
            SelfMirJsonDeclarationGenericParams(rows, declaration_index)
        ));
    }
    if rows.role_slot_counts[declaration_index] > 0 {
        ArrayPush(fields, JsonEmitFieldRaw(
            "role_slots", SelfMirJsonDeclarationRoleSlots(
                rows, declaration_index
            )
        ));
    }
    if rows.kinds[declaration_index] == "role" {
        ArrayPush(fields, JsonEmitFieldString(
            "for_type", rows.target_types[declaration_index]
        ));
        ArrayPush(fields, JsonEmitFieldRaw(
            "impls", SelfMirJsonDeclarationRoleImpls(rows, declaration_index)
        ));
    }
    if rows.kinds[declaration_index] == "enum" {
        ArrayPush(fields, JsonEmitFieldRaw("variants", JsonEmitArray(variants)));
    }
    return JsonEmitObject(fields);
}
