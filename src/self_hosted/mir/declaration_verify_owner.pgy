// Structural verifier for flat MIR declaration row ranges.

import "declaration_fact_owner.pgy";
import "option_nominal_abi_layout_verify_owner.pgy";
import "enum_declaration_verify_owner.pgy";
import "../lib/callable_contract_vocabulary_projection_owner.pgy";
import "../lib/nominal_field_kind_owner.pgy";

func SelfMirDeclarationParallelCount(count: Int, rows: Array<Int>) -> Bool {
    return ArrayLength(rows) == count;
}
func SelfMirDeclarationParallelStringCount(
    count: Int, rows: Array<String>
) -> Bool {
    return ArrayLength(rows) == count;
}

func SelfMirDeclarationStringRangeReady(
    rows: Array<String>, start: Int, count: Int
) -> Bool {
    if start < 0 || count < 0 || start + count > ArrayLength(rows) {
        return false;
    }
    let i: Int = 0;
    while i < count {
        if rows[start + i] == "" { return false; }
        let j: Int = 0;
        while j < i {
            if rows[start + j] == rows[start + i] { return false; }
            j = j + 1;
        }
        i = i + 1;
    }
    return true;
}

func SelfMirDeclarationContractVocabularyRangeReady(
    rows: Array<String>, start: Int, count: Int, axis: Int
) -> Bool {
    if !SelfMirDeclarationStringRangeReady(rows, start, count) {
        return false;
    }
    let previous_rank: Int = -1;
    let i: Int = 0;
    while i < count {
        let index: Int = CallableContractVocabularyFindIndex(
            axis, rows[start + i]
        );
        if index < 0 ||
            CallableContractVocabularyCanonicalRankAt(index) <= previous_rank ||
            (CallableContractVocabularyZeroPolicyAt(index) ==
                CallableContractVocabularyZeroExclusive() && count != 1) {
            return false;
        }
        previous_rank = CallableContractVocabularyCanonicalRankAt(index);
        i = i + 1;
    }
    return true;
}

func SelfMirDeclarationRowsReady(rows: SelfMirDeclarationRows) -> Bool {
    let count: Int = ArrayLength(rows.names);
    if !SelfMirDeclarationParallelStringCount(count, rows.kinds) ||
        !SelfMirDeclarationParallelStringCount(count, rows.nominal_kinds) ||
        !SelfMirDeclarationParallelStringCount(count, rows.target_types) ||
        !SelfMirDeclarationParallelCount(count, rows.uses_pointer_self) ||
        !SelfMirDeclarationParallelCount(count, rows.field_starts) ||
        !SelfMirDeclarationParallelCount(count, rows.field_counts) ||
        !SelfMirDeclarationParallelCount(count, rows.method_starts) ||
        !SelfMirDeclarationParallelCount(count, rows.method_counts) ||
        !SelfMirDeclarationParallelCount(count, rows.variant_starts) ||
        !SelfMirDeclarationParallelCount(count, rows.variant_counts) ||
        !SelfMirDeclarationParallelCount(count, rows.generic_starts) ||
        !SelfMirDeclarationParallelCount(count, rows.generic_counts) ||
        !SelfMirDeclarationParallelCount(count, rows.role_slot_starts) ||
        !SelfMirDeclarationParallelCount(count, rows.role_slot_counts) ||
        !SelfMirDeclarationParallelCount(count, rows.role_impl_starts) ||
        !SelfMirDeclarationParallelCount(count, rows.role_impl_counts) ||
        ArrayLength(rows.field_names) != ArrayLength(rows.field_kinds) ||
        ArrayLength(rows.field_names) != ArrayLength(rows.field_types) ||
        ArrayLength(rows.field_names) !=
            ArrayLength(rows.field_source_syntax_ids) ||
        ArrayLength(rows.method_names) != ArrayLength(rows.method_returns) ||
        ArrayLength(rows.method_names) != ArrayLength(rows.method_is_actions) ||
        ArrayLength(rows.method_names) !=
            ArrayLength(rows.method_requires_starts) ||
        ArrayLength(rows.method_names) !=
            ArrayLength(rows.method_requires_counts) ||
        ArrayLength(rows.method_names) !=
            ArrayLength(rows.method_within_zone_names) ||
        ArrayLength(rows.method_names) !=
            ArrayLength(rows.method_causes_names) ||
        ArrayLength(rows.method_names) !=
            ArrayLength(rows.method_authorized_by_starts) ||
        ArrayLength(rows.method_names) !=
            ArrayLength(rows.method_authorized_by_counts) ||
        ArrayLength(rows.method_names) !=
            ArrayLength(rows.method_caps_present) ||
        ArrayLength(rows.method_names) != ArrayLength(rows.method_cap_starts) ||
        ArrayLength(rows.method_names) != ArrayLength(rows.method_cap_counts) ||
        ArrayLength(rows.method_names) !=
            ArrayLength(rows.method_effects_present) ||
        ArrayLength(rows.method_names) !=
            ArrayLength(rows.method_effect_starts) ||
        ArrayLength(rows.method_names) !=
            ArrayLength(rows.method_effect_counts) ||
        ArrayLength(rows.method_names) !=
            ArrayLength(rows.method_param_starts) ||
        ArrayLength(rows.method_names) !=
            ArrayLength(rows.method_param_counts) ||
        ArrayLength(rows.method_param_names) !=
            ArrayLength(rows.method_param_type_names) ||
        ArrayLength(rows.generic_names) !=
            ArrayLength(rows.generic_constraint_type_names) ||
        ArrayLength(rows.generic_names) !=
            ArrayLength(rows.generic_default_type_names) ||
        ArrayLength(rows.role_slot_names) !=
            ArrayLength(rows.role_slot_type_names) ||
        ArrayLength(rows.role_slot_names) !=
            ArrayLength(rows.role_slot_dynamic) ||
        ArrayLength(rows.role_impl_ability_names) !=
            ArrayLength(rows.role_impl_method_starts) ||
        ArrayLength(rows.role_impl_ability_names) !=
            ArrayLength(rows.role_impl_method_counts) ||
        !SelfMirDeclarationZoneAuthorityRowsReady(
            rows.zone_authorities, rows.names, rows.nominal_kinds
        ) || !SelfMirOptionNominalAbiLayoutRowsReady(
            rows.option_nominal_abi_layouts, rows.names,
            rows.nominal_kinds, rows.nominal_abi_layouts
        ) ||
        !SelfMirEnumDeclarationPayloadRowsReady(rows) {
        return false;
    }
    let field_cursor: Int = 0;
    let method_cursor: Int = 0;
    let variant_cursor: Int = 0;
    let generic_cursor: Int = 0;
    let role_slot_cursor: Int = 0;
    let role_impl_cursor: Int = 0;
    let i: Int = 0;
    while i < count {
        if rows.names[i] == "" || rows.kinds[i] == "" ||
            rows.nominal_kinds[i] == "" ||
            !CallableReceiverNominalKindKnown(rows.nominal_kinds[i]) ||
            rows.uses_pointer_self[i] !=
                SelfMirDeclarationUsesPointerSelf(rows.nominal_kinds[i]) ||
            (rows.kinds[i] == "role" && rows.target_types[i] == "") ||
            rows.field_starts[i] != field_cursor || rows.field_counts[i] < 0 ||
            rows.method_starts[i] != method_cursor ||
            rows.method_counts[i] < 0 ||
            rows.variant_starts[i] != variant_cursor ||
            rows.variant_counts[i] < 0 ||
            rows.generic_starts[i] != generic_cursor ||
            rows.generic_counts[i] < 0 ||
            rows.role_slot_starts[i] != role_slot_cursor ||
            rows.role_slot_counts[i] < 0 ||
            rows.role_impl_starts[i] != role_impl_cursor ||
            rows.role_impl_counts[i] < 0 {
            return false;
        }
        let subject_slot_count: Int = 0;
        let field_i: Int = 0;
        while field_i < rows.field_counts[i] {
            let field_row: Int = field_cursor + field_i;
            if rows.field_names[field_row] == "" ||
                rows.field_types[field_row] == "" ||
                rows.field_source_syntax_ids[field_row] <= 0 ||
                !NominalFieldKindAllowedForDeclaration(
                    rows.nominal_kinds[i], rows.field_kinds[field_row]
                ) {
                return false;
            }
            let prior_field_row: Int = 0;
            while prior_field_row < field_row {
                if rows.field_source_syntax_ids[prior_field_row] ==
                    rows.field_source_syntax_ids[field_row] { return false; }
                prior_field_row = prior_field_row + 1;
            }
            if rows.field_kinds[field_row] == NominalFieldKindSubjectSlot() ||
                rows.field_kinds[field_row] == NominalFieldKindBindingSlot() {
                subject_slot_count = subject_slot_count + 1;
            }
            field_i = field_i + 1;
        }
        if (rows.nominal_kinds[i] == "effect" && subject_slot_count != 1) ||
            (rows.nominal_kinds[i] == "relation" &&
                subject_slot_count != 2) {
            return false;
        }
        let authority_i: Int = 0;
        while authority_i <
            rows.zone_authorities.declaration_counts[i] {
            let authority_row: Int =
                rows.zone_authorities.declaration_starts[i] + authority_i;
            let slot_matches: Int = 0;
            let authority_field_i: Int = 0;
            while authority_field_i < rows.field_counts[i] {
                let authority_field_row: Int =
                    field_cursor + authority_field_i;
                if rows.field_kinds[authority_field_row] ==
                        NominalFieldKindSubjectSlot() &&
                    rows.field_names[authority_field_row] ==
                        rows.zone_authorities.subject_slot_names[authority_row] {
                    slot_matches = slot_matches + 1;
                }
                authority_field_i = authority_field_i + 1;
            }
            if slot_matches != 1 { return false; }
            authority_i = authority_i + 1;
        }
        field_cursor = field_cursor + rows.field_counts[i];
        method_cursor = method_cursor + rows.method_counts[i];
        variant_cursor = variant_cursor + rows.variant_counts[i];
        generic_cursor = generic_cursor + rows.generic_counts[i];
        role_slot_cursor = role_slot_cursor + rows.role_slot_counts[i];
        role_impl_cursor = role_impl_cursor + rows.role_impl_counts[i];
        i = i + 1;
    }
    if field_cursor != ArrayLength(rows.field_names) ||
        method_cursor != ArrayLength(rows.method_names) ||
        variant_cursor != ArrayLength(rows.variant_names) ||
        generic_cursor != ArrayLength(rows.generic_names) ||
        role_slot_cursor != ArrayLength(rows.role_slot_names) ||
        role_impl_cursor != ArrayLength(rows.role_impl_ability_names) {
        return false;
    }
    let method_param_cursor: Int = 0;
    let requires_cursor: Int = 0;
    let authority_cursor: Int = 0;
    let cap_cursor: Int = 0;
    let effect_cursor: Int = 0;
    i = 0;
    while i < ArrayLength(rows.method_names) {
        if rows.method_param_starts[i] != method_param_cursor ||
            rows.method_param_counts[i] < 0 ||
            rows.method_requires_starts[i] != requires_cursor ||
            !SelfMirDeclarationStringRangeReady(
                rows.method_requires_names, requires_cursor,
                rows.method_requires_counts[i]
            ) || rows.method_authorized_by_starts[i] != authority_cursor ||
            !SelfMirDeclarationStringRangeReady(
                rows.method_authorized_by_names, authority_cursor,
                rows.method_authorized_by_counts[i]
            ) || rows.method_cap_starts[i] != cap_cursor ||
            !SelfMirDeclarationContractVocabularyRangeReady(
                rows.method_cap_names, cap_cursor,
                rows.method_cap_counts[i],
                CallableContractVocabularyCapabilityAxis()
            ) || rows.method_effect_starts[i] != effect_cursor ||
            !SelfMirDeclarationContractVocabularyRangeReady(
                rows.method_effect_names, effect_cursor,
                rows.method_effect_counts[i],
                CallableContractVocabularyEffectAxis()
            ) || (rows.method_is_actions[i] != 0 &&
                rows.method_is_actions[i] != 1) ||
            (rows.method_caps_present[i] != 0 &&
                rows.method_caps_present[i] != 1) ||
            (rows.method_effects_present[i] != 0 &&
                rows.method_effects_present[i] != 1) ||
            (rows.method_caps_present[i] == 0 &&
                rows.method_cap_counts[i] != 0) ||
            (rows.method_caps_present[i] == 1 &&
                rows.method_cap_counts[i] == 0) ||
            (rows.method_effects_present[i] == 0 &&
                rows.method_effect_counts[i] != 0) ||
            (rows.method_effects_present[i] == 1 &&
                rows.method_effect_counts[i] == 0) ||
            (rows.method_is_actions[i] == 0 &&
                (rows.method_requires_counts[i] != 0 ||
                    rows.method_within_zone_names[i] != "" ||
                    rows.method_causes_names[i] != "" ||
                    rows.method_authorized_by_counts[i] != 0)) {
            return false;
        }
        method_param_cursor = method_param_cursor +
            rows.method_param_counts[i];
        requires_cursor = requires_cursor + rows.method_requires_counts[i];
        authority_cursor = authority_cursor +
            rows.method_authorized_by_counts[i];
        cap_cursor = cap_cursor + rows.method_cap_counts[i];
        effect_cursor = effect_cursor + rows.method_effect_counts[i];
        i = i + 1;
    }
    if method_param_cursor != ArrayLength(rows.method_param_names) ||
        requires_cursor != ArrayLength(rows.method_requires_names) ||
        authority_cursor != ArrayLength(rows.method_authorized_by_names) ||
        cap_cursor != ArrayLength(rows.method_cap_names) ||
        effect_cursor != ArrayLength(rows.method_effect_names) {
        return false;
    }
    return true;
}
