// Destructure-specific MIR facts keyed by instruction row.

struct SelfMirDestructureFactRows {
    instruction_indices: Array<Int>;
    element_types: Array<String>;
    binding_starts: Array<Int>;
    binding_counts: Array<Int>;
    bindings: Array<String>;
}

// Rows follow the match-fact row contract: inputs are readonly, and each row
// stores a fresh copy of every spelling. The copies are not released with a
// routine build; an owned-push transfer would need an exclusive-storage proof
// through the routine and program accumulators that only the MIR ownership
// pass can give (docs/semantics/27_ownership_clean.md section 5).

func SelfMirDestructureFactRowsEmpty() -> SelfMirDestructureFactRows {
    let instruction_indices: Array<Int> = [];
    let element_types: Array<String> = [];
    let binding_starts: Array<Int> = [];
    let binding_counts: Array<Int> = [];
    let bindings: Array<String> = [];
    return SelfMirDestructureFactRows(
        instruction_indices, element_types, binding_starts, binding_counts,
        bindings
    );
}

func SelfMirDestructureFactRowsAttach(
    inout rows: SelfMirDestructureFactRows,
    instruction_index: Int,
    element_type: String,
    ref bindings_in: Array<String>
) -> Void {
    let instruction_indices: Array<Int> = rows.instruction_indices;
    let element_types: Array<String> = rows.element_types;
    let binding_starts: Array<Int> = rows.binding_starts;
    let binding_counts: Array<Int> = rows.binding_counts;
    let bindings: Array<String> = rows.bindings;
    ArrayPush(instruction_indices, instruction_index);
    ArrayPush(element_types, Concat("", element_type));
    ArrayPush(binding_starts, ArrayLength(bindings));
    ArrayPush(binding_counts, ArrayLength(bindings_in));
    let i: Int = 0;
    while i < ArrayLength(bindings_in) {
        ArrayPush(bindings, Concat("", bindings_in[i]));
        i = i + 1;
    }
    rows.instruction_indices = instruction_indices;
    rows.element_types = element_types;
    rows.binding_starts = binding_starts;
    rows.binding_counts = binding_counts;
    rows.bindings = bindings;
}

func SelfMirDestructureFactRowsAppend(
    inout target: SelfMirDestructureFactRows,
    ref source: SelfMirDestructureFactRows,
    instruction_offset: Int
) -> Void {
    let instruction_indices: Array<Int> = target.instruction_indices;
    let element_types: Array<String> = target.element_types;
    let binding_starts: Array<Int> = target.binding_starts;
    let binding_counts: Array<Int> = target.binding_counts;
    let bindings: Array<String> = target.bindings;
    let row: Int = 0;
    while row < ArrayLength(source.instruction_indices) {
        ArrayPush(
            instruction_indices,
            source.instruction_indices[row] + instruction_offset
        );
        ArrayPush(
            element_types, Concat("", source.element_types[row])
        );
        ArrayPush(binding_starts, ArrayLength(bindings));
        ArrayPush(binding_counts, source.binding_counts[row]);
        let i: Int = 0;
        while i < source.binding_counts[row] {
            ArrayPush(
                bindings,
                Concat("", source.bindings[source.binding_starts[row] + i])
            );
            i = i + 1;
        }
        row = row + 1;
    }
    target.instruction_indices = instruction_indices;
    target.element_types = element_types;
    target.binding_starts = binding_starts;
    target.binding_counts = binding_counts;
    target.bindings = bindings;
}

func SelfMirDestructureFactIndexForInstruction(
    rows: SelfMirDestructureFactRows,
    instruction_index: Int
) -> Option<Int> {
    let i: Int = 0;
    while i < ArrayLength(rows.instruction_indices) {
        if rows.instruction_indices[i] == instruction_index { return Some(i); }
        i = i + 1;
    }
    return None;
}

func SelfMirDestructureFactRowsValidationError(
    rows: SelfMirDestructureFactRows,
    instruction_count: Int
) -> String {
    let count: Int = ArrayLength(rows.instruction_indices);
    if ArrayLength(rows.element_types) != count ||
        ArrayLength(rows.binding_starts) != count ||
        ArrayLength(rows.binding_counts) != count {
        return "destructure fact parallel row counts differ";
    }
    let cursor: Int = 0;
    let i: Int = 0;
    while i < count {
        if rows.instruction_indices[i] < 0 ||
            rows.instruction_indices[i] >= instruction_count ||
            (i > 0 && rows.instruction_indices[i - 1] >=
                rows.instruction_indices[i]) ||
            rows.element_types[i] == "" || rows.binding_starts[i] != cursor ||
            rows.binding_counts[i] <= 0 ||
            cursor + rows.binding_counts[i] > ArrayLength(rows.bindings) {
            return "destructure fact identity or payload is invalid";
        }
        let j: Int = 0;
        while j < rows.binding_counts[i] {
            if rows.bindings[cursor + j] == "" {
                return "destructure binding name is empty";
            }
            j = j + 1;
        }
        cursor = cursor + rows.binding_counts[i];
        i = i + 1;
    }
    if cursor != ArrayLength(rows.bindings) {
        return "destructure binding payload has orphan rows";
    }
    return "";
}
