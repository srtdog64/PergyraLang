// MIR expression token/use classification shared by routine lowering.

enum SelfMirExpressionKind {
    Binary,
    Call,
    Identifier
}

func SelfMirNoUses() -> Array<String> {
    let uses: Array<String> = [];
    return uses;
}

func SelfMirExpressionKindFromText(expression: String) -> SelfMirExpressionKind {
    let operators: Array<String> = [
        " + ", " - ", " * ", " / ", " < ", " <= ", " > ", " >= ",
        " == ", " != ", " && ", " || "
    ];
    let i: Int = 0;
    while i < ArrayLength(operators) {
        if StringIndexOf(expression, operators[i]) >= 0 {
            return SelfMirExpressionKind.Binary;
        }
        i = i + 1;
    }
    if StringIndexOf(expression, "(") >= 0 {
        return SelfMirExpressionKind.Call;
    }
    return SelfMirExpressionKind.Identifier;
}

func SelfMirExpressionSourceTypeName(kind: SelfMirExpressionKind) -> String {
    if kind == SelfMirExpressionKind.Binary { return "AST_BINARY"; }
    if kind == SelfMirExpressionKind.Call { return "AST_CALL"; }
    return "AST_IDENTIFIER";
}
