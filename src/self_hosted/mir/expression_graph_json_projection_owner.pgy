// JSON projection for the persisted expression-graph record.
//
// Split out of json_projection_owner.pgy to match its siblings: match,
// destructure, declaration, ABI layout and the rest each already own their
// own projection file. Keeping this one inline put the program projection
// over the 600-line owner cap.

import "expression_graph_kind_name_owner.pgy";
import "json_projection_support_owner.pgy";
import "../lib/json_emit.pgy";
import "program_verify_owner.pgy";
import "match_json_projection_owner.pgy";
import "destructure_json_projection_owner.pgy";
import "destructure_type_json_projection_owner.pgy";
import "generic_specialization_json_projection_owner.pgy";
import "declaration_json_projection_owner.pgy";
import "runtime_call_abi_json_projection_owner.pgy";
import "abi_layout_json_projection_owner.pgy";
import "machine_layer_json_projection_owner.pgy";
import "routine_param_json_projection_owner.pgy";
import "instruction_abi_receipt_json_projection_owner.pgy";
import "expression_identity_json_projection_owner.pgy";
import "domain_runtime_assignment_json_owner.pgy";
import "local_ref_json_projection_owner.pgy";
import "../semantic/ast_expression_graph_node_view_owner.pgy";

func SelfMirJsonExpressionGraph(rows: SelfMirExpressionGraphRows, ref graph: SemanticExpressionGraphFacts,
    instruction_index: Int
) -> String {
    if instruction_index < 0 ||
        instruction_index >= ArrayLength(rows.has_roots) ||
        rows.has_roots[instruction_index] != 1 {
        return "null";
    }
    let start: Int = rows.node_starts[instruction_index];
    let count: Int = rows.node_counts[instruction_index];
    let nodes: Array<String> = [];
    let i: Int = 0;
    while i < count {
        let node: Int = start + i;
        let kind_opt: Option<Int> = SemanticExpressionGraphNodeKind(
            graph, node
        );
        let text_opt: Option<String> = SemanticExpressionGraphNodeText(
            graph, node
        );
        let call_target_kind_opt: Option<Int> =
            SemanticExpressionGraphCallTargetKind(graph, node);
        let call_target_name_opt: Option<String> =
            SemanticExpressionGraphCallTargetName(graph, node);
        if !IsSome(kind_opt) || !IsSome(text_opt) ||
            !IsSome(call_target_kind_opt) || !IsSome(call_target_name_opt) {
            return "null";
        }
        let kind: Int = UnwrapOption(kind_opt);
        let fields: Array<String> = [
            JsonEmitFieldString(
                "kind", SelfMirExpressionGraphKindName(kind)
            ),
            JsonEmitFieldString("text", UnwrapOption(text_opt)),
            JsonEmitFieldString(
                "call_target_kind",
                SelfMirExpressionCallTargetKindName(
                    UnwrapOption(call_target_kind_opt)
                )
            ),
            JsonEmitFieldString("call_target_name", UnwrapOption(
                call_target_name_opt
            ))
        ];
        let identity_fields: Array<String> =
            SelfMirJsonExpressionIdentityFields(graph, node);
        if ArrayLength(identity_fields) != 5 { return "null"; }
        let identity_row: Int = 0;
        while identity_row < ArrayLength(identity_fields) {
            ArrayPush(fields, identity_fields[identity_row]);
            identity_row = identity_row + 1;
        }
        let arity: Int = AstExpressionNodeArity(kind);
        if arity == 0 {
            ArrayPush(fields, JsonEmitFieldRaw("left", "null"));
            ArrayPush(fields, JsonEmitFieldRaw("right", "null"));
        } else if arity == 1 {
            let left_opt: Option<Int> = SemanticExpressionGraphLeftChild(
                graph, node
            );
            if !IsSome(left_opt) { return "null"; }
            ArrayPush(fields, JsonEmitFieldNumber(
                "left", ToString(UnwrapOption(left_opt) - start)
            ));
            ArrayPush(fields, JsonEmitFieldRaw("right", "null"));
        } else {
            let left_opt: Option<Int> = SemanticExpressionGraphLeftChild(
                graph, node
            );
            let right_opt: Option<Int> = SemanticExpressionGraphRightChild(
                graph, node
            );
            if !IsSome(left_opt) || !IsSome(right_opt) { return "null"; }
            ArrayPush(fields, JsonEmitFieldNumber(
                "left", ToString(UnwrapOption(left_opt) - start)
            ));
            ArrayPush(fields, JsonEmitFieldNumber(
                "right", ToString(UnwrapOption(right_opt) - start)
            ));
        }
        ArrayPush(nodes, JsonEmitObject(fields));
        i = i + 1;
    }
    return JsonEmitObject([
        JsonEmitFieldNumber(
            "root", ToString(rows.roots[instruction_index] - start)
        ),
        JsonEmitFieldRaw("nodes", JsonEmitArray(nodes))
    ]);
}
