// MIR generic specialization JSON projection owner.

import "generic_specialization_owner.pgy";
import "program_fact_owner.pgy";
import "../lib/json_emit.pgy";

func SelfMirJsonGenericSpecialization(
    ref rows: SelfMirGenericSpecializationRows,
    ref routines: SelfMirRoutineRows,
    ref cfg: SelfMirCfgRows,
    index: Int
) -> String {
    let generic_params: Array<String> = [];
    let param_i: Int = 0;
    while param_i < rows.generic_param_counts[index] {
        ArrayPush(
            generic_params,
            JsonStringLiteral(rows.generic_param_names[
                rows.generic_param_starts[index] + param_i
            ])
        );
        param_i = param_i + 1;
    }
    let generic_actuals: Array<String> = [];
    let actual_i: Int = 0;
    while actual_i < rows.actual_counts[index] {
        ArrayPush(
            generic_actuals,
            JsonStringLiteral(rows.actual_type_names[
                rows.actual_starts[index] + actual_i
            ])
        );
        actual_i = actual_i + 1;
    }
    let occurrences: Array<String> = [];
    let occurrence: Int = rows.occurrences.starts[index];
    let end: Int = occurrence + rows.occurrences.counts[index];
    while occurrence < end {
        ArrayPush(occurrences, JsonEmitObject([
            JsonEmitFieldNumber("routine_syntax_id", ToString(
                routines.node_ids[rows.occurrences.routine_rows[occurrence]])),
            JsonEmitFieldNumber("block_id", ToString(
                cfg.blocks.ids[rows.occurrences.block_rows[occurrence]])),
            JsonEmitFieldNumber("instruction_id", ToString(
                cfg.instructions.ids[rows.occurrences.instruction_rows[occurrence]])),
            JsonEmitFieldNumber("expression_lane", ToString(rows.occurrences.lanes[occurrence])),
            JsonEmitFieldNumber("call_node", ToString(rows.occurrences.graph_nodes[occurrence]))
        ]));
        occurrence = occurrence + 1;
    }
    return JsonEmitObject([
        JsonEmitFieldNumber(
            "source_owner_syntax_id",
            ToString(rows.source_owner_node_ids[index])
        ),
        JsonEmitFieldNumber("source_lane", ToString(rows.source_lanes[index])),
        JsonEmitFieldNumber(
            "source_call_ordinal", ToString(rows.source_call_ordinals[index])
        ),
        JsonEmitFieldString(
            "target_kind",
            SelfMirGenericSpecializationTargetKindName(rows.target_kinds[index])
        ),
        JsonEmitFieldString("owner", rows.owner_names[index]),
        JsonEmitFieldString("callable", rows.callable_names[index]),
        JsonEmitFieldString(
            "specialized_symbol", rows.specialized_symbols[index]
        ),
        JsonEmitFieldRaw("generic_params", JsonEmitArray(generic_params)),
        JsonEmitFieldRaw("generic_actuals", JsonEmitArray(generic_actuals)),
        JsonEmitFieldNumber("call_target_syntax_id", ToString(rows.target_syntax_ids[index])),
        JsonEmitFieldRaw("occurrences", JsonEmitArray(occurrences))
    ]);
}

func SelfMirJsonGenericSpecializations(
    ref facts: SelfMirProgramFacts
) -> Array<String> {
    let projections: Array<String> = [];
    let i: Int = 0;
    while i < SelfMirGenericSpecializationCount(facts.generic_specializations) {
        ArrayPush(projections, SelfMirJsonGenericSpecialization(
            facts.generic_specializations, facts.routines, facts.cfg, i));
        i = i + 1;
    }
    return projections;
}
