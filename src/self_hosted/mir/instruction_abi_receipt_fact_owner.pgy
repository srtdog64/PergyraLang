// Producer-carried nominal ABI receipt for each MIR instruction.
//
// The declaration row is a stable program-local handle. JSON projection may
// dereference that exact row, but may not recover it from a type spelling.

import "declaration_fact_owner.pgy";
import "option_nominal_abi_layout_fact_owner.pgy";

struct SelfMirInstructionAbiReceiptRows {
    ready: Bool;
    kinds: Array<Int>;
    nominal_declaration_rows: Array<Int>;
    layout_ids: Array<Int>;
}

func SelfMirInstructionAbiReceiptRowsEmpty(
) -> SelfMirInstructionAbiReceiptRows {
    let ints: Array<Int> = [];
    return SelfMirInstructionAbiReceiptRows(true, ints, ints, ints);
}

func SelfMirInstructionAbiReceiptRowsAppend(
    target: SelfMirInstructionAbiReceiptRows,
    abi_type_names: Array<String>,
    ref declarations: SelfMirDeclarationRows
) -> SelfMirInstructionAbiReceiptRows {
    var kinds: Array<Int> = target.kinds;
    var declaration_rows: Array<Int> = target.nominal_declaration_rows;
    var layout_ids: Array<Int> = target.layout_ids;
    var ready: Bool = target.ready;
    var instruction_i: Int = 0;
    while instruction_i < ArrayLength(abi_type_names) {
        var declaration_row: Int = 0 - 1;
        var layout_id: Int = 0;
        var kind: Int = 0;
        let nominal: Option<Int> = SelfMirNominalUniqueStructIndex(
            declarations.names, declarations.nominal_kinds,
            abi_type_names, instruction_i
        );
        if IsSome(nominal) {
            declaration_row = UnwrapOption(nominal);
            if !declarations.nominal_abi_layouts.ready {
                ready = false;
            } else if declarations.nominal_abi_layouts.required[
                    declaration_row
                ] == 1 {
                kind = 1;
                layout_id = declarations.nominal_abi_layouts.layout_ids[
                    declaration_row
                ];
                if layout_id <= 0 { ready = false; }
            } else {
                declaration_row = 0 - 1;
            }
        } else {
            let option_row: Option<Int> =
                SelfMirOptionNominalAbiLayoutUniqueRowForType(
                    declarations.option_nominal_abi_layouts,
                    abi_type_names[instruction_i]
                );
            if IsSome(option_row) {
                declaration_row = UnwrapOption(option_row);
                if declarations.option_nominal_abi_layouts.required[
                        declaration_row
                    ] == 1 {
                    kind = 2;
                    let option_fact: SelfMirOptionNominalAbiLayoutFact =
                        SelfMirOptionNominalAbiLayoutFactAt(
                            declarations.option_nominal_abi_layouts,
                            declaration_row
                        );
                    if !SelfMirOptionNominalAbiLayoutFactReady(option_fact) {
                        ready = false;
                    }
                    layout_id = option_fact.layout_id;
                } else {
                    declaration_row = 0 - 1;
                }
            }
        }
        ArrayPush(kinds, kind);
        ArrayPush(declaration_rows, declaration_row);
        ArrayPush(layout_ids, layout_id);
        instruction_i = instruction_i + 1;
    }
    return SelfMirInstructionAbiReceiptRows(
        ready, kinds, declaration_rows, layout_ids
    );
}
