// JSON projection of an instruction's producer-carried ABI receipt.

import "instruction_abi_receipt_fact_owner.pgy";
import "nominal_abi_layout_json_projection_owner.pgy";

struct SelfMirInstructionAbiJsonProjection {
    ready: Bool;
    layout: String;
}

func SelfMirInstructionAbiJsonProjectionForRow(
    ref declarations: SelfMirDeclarationRows,
    ref receipts: SelfMirInstructionAbiReceiptRows,
    instruction_index: Int,
    type_name: String
) -> SelfMirInstructionAbiJsonProjection {
    if instruction_index < 0 || instruction_index >=
        ArrayLength(receipts.nominal_declaration_rows) {
        return SelfMirInstructionAbiJsonProjection(false, "");
    }
    let declaration_row: Int =
        receipts.nominal_declaration_rows[instruction_index];
    if declaration_row < 0 {
        if receipts.layout_ids[instruction_index] != 0 {
            return SelfMirInstructionAbiJsonProjection(false, "");
        }
        return SelfMirInstructionAbiJsonProjection(
            true, SelfMirJsonStaticAbiLayout(type_name)
        );
    }
    if declaration_row >= ArrayLength(declarations.names) ||
        declarations.nominal_kinds[declaration_row] != "struct" ||
        declarations.names[declaration_row] != type_name ||
        declarations.nominal_abi_layouts.required[declaration_row] != 1 ||
        declarations.nominal_abi_layouts.layout_ids[declaration_row] !=
            receipts.layout_ids[instruction_index] {
        return SelfMirInstructionAbiJsonProjection(false, "");
    }
    let layout: String = SelfMirJsonNominalAbiLayout(
        declarations.nominal_abi_layouts, declaration_row, type_name
    );
    if layout == "" || SelfMirJsonAbiLayoutId(layout) !=
        ToString(receipts.layout_ids[instruction_index]) {
        return SelfMirInstructionAbiJsonProjection(false, "");
    }
    return SelfMirInstructionAbiJsonProjection(true, layout);
}
