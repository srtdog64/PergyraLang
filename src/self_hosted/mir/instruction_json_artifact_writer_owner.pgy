// Sequential pgy.mir.v1 instruction artifact projection.
//
// SelfMirProgramFacts remains the semantic owner.  This file owns only the
// file framing for instruction-local rows whose expression graphs and lists
// are unbounded.  The String projection remains a bounded parity oracle; the
// production artifact path must not materialize a complete instruction or
// expression-graph String.

import "json_projection_owner.pgy";

func SelfMirJsonOptionalStringWriteFile(
    output: Int,
    value: String
) -> Bool {
    if value == "" {
        CompilerArtifactWrite(output, "null");
        return true;
    }
    return JsonStringLiteralWriteFile(output, value);
}

func SelfMirJsonExpressionGraphWriteFile(
    rows: SelfMirExpressionGraphRows,
    ref graph: SemanticExpressionGraphFacts,
    instruction_index: Int,
    output: Int
) -> Bool {
    if instruction_index < 0 ||
        instruction_index >= ArrayLength(rows.has_roots) {
        return false;
    }
    if rows.has_roots[instruction_index] != 1 {
        CompilerArtifactWrite(output, "null");
        return true;
    }

    let start: Int = rows.node_starts[instruction_index];
    let count: Int = rows.node_counts[instruction_index];
    CompilerArtifactWrite(output, "{\"root\":");
    CompilerArtifactWrite(output, ToString(rows.roots[instruction_index] - start));
    CompilerArtifactWrite(output, ",\"nodes\":[");
    let i: Int = 0;
    while i < count {
        let node: Int = start + i;
        let kind_opt: Option<Int> = SemanticExpressionGraphNodeKind(
            graph, node
        );
        let text_opt: Option<String> = SemanticExpressionGraphNodeText(
            graph, node
        );
        let call_target_kind_opt: Option<Int> =
            SemanticExpressionGraphCallTargetKind(graph, node);
        let call_target_name_opt: Option<String> =
            SemanticExpressionGraphCallTargetName(graph, node);
        if !IsSome(kind_opt) || !IsSome(text_opt) ||
            !IsSome(call_target_kind_opt) || !IsSome(call_target_name_opt) {
            return false;
        }

        let kind: Int = UnwrapOption(kind_opt);
        let arity: Int = AstExpressionNodeArity(kind);
        let left: Int = -1;
        let right: Int = -1;
        if arity == 1 || arity == 2 {
            let left_opt: Option<Int> = SemanticExpressionGraphLeftChild(
                graph, node
            );
            if !IsSome(left_opt) { return false; }
            left = UnwrapOption(left_opt) - start;
        }
        if arity == 2 {
            let right_opt: Option<Int> = SemanticExpressionGraphRightChild(
                graph, node
            );
            if !IsSome(right_opt) { return false; }
            right = UnwrapOption(right_opt) - start;
        }

        if i > 0 { CompilerArtifactWrite(output, ","); }
        CompilerArtifactWrite(output, "{\"kind\":");
        if !JsonStringLiteralWriteFile(output,
            SelfMirExpressionGraphKindName(kind)
        ) { return false; }
        CompilerArtifactWrite(output, ",\"text\":");
        if !JsonStringLiteralWriteFile(
            output, UnwrapOption(text_opt)
        ) { return false; }
        CompilerArtifactWrite(output, ",\"call_target_kind\":");
        if !JsonStringLiteralWriteFile(output,
            SelfMirExpressionCallTargetKindName(
                UnwrapOption(call_target_kind_opt)
            )
        ) { return false; }
        CompilerArtifactWrite(output, ",\"call_target_name\":");
        if !JsonStringLiteralWriteFile(output,
            UnwrapOption(call_target_name_opt)
        ) { return false; }
        CompilerArtifactWrite(output, ",\"left\":");
        if arity == 0 {
            CompilerArtifactWrite(output, "null");
        } else {
            CompilerArtifactWrite(output, ToString(left));
        }
        CompilerArtifactWrite(output, ",\"right\":");
        if arity == 2 {
            CompilerArtifactWrite(output, ToString(right));
        } else {
            CompilerArtifactWrite(output, "null");
        }
        CompilerArtifactWrite(output, "}");
        i = i + 1;
    }
    CompilerArtifactWrite(output, "]}");
    return true;
}

func SelfMirJsonMatchFieldsWriteFile(
    rows: SelfMirInstructionRows,
    instruction_index: Int,
    output: Int
) -> Bool {
    let fact_index: Option<Int> = SelfMirMatchFactIndexForInstruction(
        rows.match_facts, instruction_index
    );
    CompilerArtifactWrite(output, ",\"match_patterns\":[");
    if IsSome(fact_index) {
        let row: Int = UnwrapOption(fact_index);
        let pattern_i: Int = 0;
        while pattern_i < rows.match_facts.pattern_counts[row] {
            if pattern_i > 0 { CompilerArtifactWrite(output, ","); }
            if !JsonStringLiteralWriteFile(
                output, rows.match_facts.patterns[
                rows.match_facts.pattern_starts[row] + pattern_i
                ]
            ) { return false; }
            pattern_i = pattern_i + 1;
        }
    }
    CompilerArtifactWrite(output, "],\"match_variant\":");
    if IsSome(fact_index) &&
        rows.match_facts.variants[UnwrapOption(fact_index)] != "" {
        if !JsonStringLiteralWriteFile(
            output, rows.match_facts.variants[UnwrapOption(fact_index)]
        ) { return false; }
    } else {
        CompilerArtifactWrite(output, "null");
    }
    CompilerArtifactWrite(output, ",\"match_bindings\":[");
    if IsSome(fact_index) {
        let row: Int = UnwrapOption(fact_index);
        let binding_i: Int = 0;
        while binding_i < rows.match_facts.binding_counts[row] {
            if binding_i > 0 { CompilerArtifactWrite(output, ","); }
            if !JsonStringLiteralWriteFile(
                output, rows.match_facts.bindings[
                    rows.match_facts.binding_starts[row] + binding_i
                ]
            ) { return false; }
            binding_i = binding_i + 1;
        }
    }
    CompilerArtifactWrite(output, "],\"match_binding_types\":[");
    if IsSome(fact_index) {
        let row: Int = UnwrapOption(fact_index);
        let binding_i: Int = 0;
        while binding_i < rows.match_facts.binding_counts[row] {
            if binding_i > 0 { CompilerArtifactWrite(output, ","); }
            if !JsonStringLiteralWriteFile(output,
                rows.match_facts.binding_types[
                    rows.match_facts.binding_starts[row] + binding_i
                ]
            ) { return false; }
            binding_i = binding_i + 1;
        }
    }
    CompilerArtifactWrite(output, "]");
    return true;
}

func SelfMirJsonDestructureFieldsWriteFile(
    rows: SelfMirInstructionRows,
    instruction_index: Int,
    output: Int
) -> Bool {
    let fact_index: Option<Int> = SelfMirDestructureFactIndexForInstruction(
        rows.destructure_facts, instruction_index
    );
    CompilerArtifactWrite(output, ",\"destructure_element_type\":");
    if IsSome(fact_index) {
        if !JsonStringLiteralWriteFile(output,
            rows.destructure_facts.element_types[UnwrapOption(fact_index)]
        ) { return false; }
    } else {
        CompilerArtifactWrite(output, "null");
    }
    CompilerArtifactWrite(output, ",\"destructure_bindings\":[");
    if IsSome(fact_index) {
        let row: Int = UnwrapOption(fact_index);
        let binding_i: Int = 0;
        while binding_i < rows.destructure_facts.binding_counts[row] {
            if binding_i > 0 { CompilerArtifactWrite(output, ","); }
            if !JsonStringLiteralWriteFile(output,
                rows.destructure_facts.bindings[
                    rows.destructure_facts.binding_starts[row] + binding_i
                ]
            ) { return false; }
            binding_i = binding_i + 1;
        }
    }
    CompilerArtifactWrite(output, "]");
    return true;
}

func SelfMirJsonRuntimeCallAbiPrimaryWriteFile(
    rows: SelfMirInstructionRows,
    instruction_index: Int,
    output: Int
) -> Bool {
    if rows.runtime_call_abi.present[instruction_index] != 1 { return true; }
    CompilerArtifactWrite(output,
        ",\"runtime_call_abi_required\":true,\"runtime_call_abi\":{");
    CompilerArtifactWrite(output, "\"owner\":");
    if !JsonStringLiteralWriteFile(output,
        rows.runtime_call_abi.owners[instruction_index]
    ) { return false; }
    CompilerArtifactWrite(output, ",\"id\":");
    CompilerArtifactWrite(output, ToString(
        rows.runtime_call_abi.runtime_call_abi_ids[instruction_index]
    ));
    CompilerArtifactWrite(output, ",\"domain\":");
    if !JsonStringLiteralWriteFile(output,
        rows.runtime_call_abi.domains[instruction_index]
    ) { return false; }
    CompilerArtifactWrite(output, ",\"type\":");
    if !JsonStringLiteralWriteFile(output,
        rows.runtime_call_abi.type_names[instruction_index]
    ) { return false; }
    CompilerArtifactWrite(output, ",\"operation\":");
    if !JsonStringLiteralWriteFile(output,
        rows.runtime_call_abi.operations[instruction_index]
    ) { return false; }
    CompilerArtifactWrite(output, ",\"symbol\":");
    if !JsonStringLiteralWriteFile(output,
        rows.runtime_call_abi.symbols[instruction_index]
    ) { return false; }
    CompilerArtifactWrite(output, ",\"target_kind\":");
    if !JsonStringLiteralWriteFile(output,
        rows.runtime_call_abi.target_kinds[instruction_index]
    ) { return false; }
    CompilerArtifactWrite(output, ",\"materialization\":");
    if !JsonStringLiteralWriteFile(output,
        rows.runtime_call_abi.materializations[instruction_index]
    ) { return false; }
    CompilerArtifactWrite(output, ",\"call_shape\":");
    if !JsonStringLiteralWriteFile(output,
        rows.runtime_call_abi.call_shapes[instruction_index]
    ) { return false; }
    CompilerArtifactWrite(output, "}");
    return true;
}

func SelfMirJsonRuntimeCallAbiAuxWriteFile(
    rows: SelfMirInstructionRows,
    instruction_index: Int,
    output: Int
) -> Bool {
    let wrote: Bool = false;
    let i: Int = 0;
    while i < ArrayLength(rows.runtime_call_abi.aux_instruction_indices) {
        if rows.runtime_call_abi.aux_instruction_indices[i] ==
            instruction_index {
            if !wrote {
                CompilerArtifactWrite(output, ",\"runtime_call_abi_aux\":[");
                wrote = true;
            } else {
                CompilerArtifactWrite(output, ",");
            }
            CompilerArtifactWrite(output, "{\"owner\":");
            if !JsonStringLiteralWriteFile(output,
                rows.runtime_call_abi.aux_owners[i]
            ) { return false; }
            CompilerArtifactWrite(output, ",\"id\":");
            CompilerArtifactWrite(output, ToString(
                rows.runtime_call_abi.aux_runtime_call_abi_ids[i]
            ));
            CompilerArtifactWrite(output, ",\"domain\":");
            if !JsonStringLiteralWriteFile(output,
                rows.runtime_call_abi.aux_domains[i]
            ) { return false; }
            CompilerArtifactWrite(output, ",\"type\":");
            if !JsonStringLiteralWriteFile(output,
                rows.runtime_call_abi.aux_type_names[i]
            ) { return false; }
            CompilerArtifactWrite(output, ",\"operation\":");
            if !JsonStringLiteralWriteFile(output,
                rows.runtime_call_abi.aux_operations[i]
            ) { return false; }
            CompilerArtifactWrite(output, ",\"symbol\":");
            if !JsonStringLiteralWriteFile(output,
                rows.runtime_call_abi.aux_symbols[i]
            ) { return false; }
            CompilerArtifactWrite(output, ",\"target_kind\":");
            if !JsonStringLiteralWriteFile(output,
                rows.runtime_call_abi.aux_target_kinds[i]
            ) { return false; }
            CompilerArtifactWrite(output, ",\"materialization\":");
            if !JsonStringLiteralWriteFile(output,
                rows.runtime_call_abi.aux_materializations[i]
            ) { return false; }
            CompilerArtifactWrite(output, ",\"call_shape\":");
            if !JsonStringLiteralWriteFile(output,
                rows.runtime_call_abi.aux_call_shapes[i]
            ) { return false; }
            CompilerArtifactWrite(output, "}");
        }
        i = i + 1;
    }
    if wrote { CompilerArtifactWrite(output, "]"); }
    return true;
}

func SelfMirJsonInstructionWriteFile(
    facts: SelfMirProgramFacts,
    instruction_index: Int,
    output: Int
) -> Bool {
    let rows: SelfMirInstructionRows = facts.cfg.instructions;
    if instruction_index < 0 ||
        instruction_index >= ArrayLength(rows.ids) {
        return false;
    }

    let abi_type_name: String = SelfMirJsonAbiTypeName(
        rows, instruction_index
    );
    let abi_layout: String = SelfMirJsonStaticAbiLayout(abi_type_name);
    let abi_layout_required: Bool = StringLength(abi_layout) > 0;
    let machine: SelfMirMachineLayerProjection =
        SelfMirMachineLayerProjection(
            true,
            rows.machine_contact_kinds[instruction_index],
            rows.machine_layer_manifest_ids[instruction_index],
            rows.machine_layer_physical_grant_ids[instruction_index],
            rows.machine_layer_physical_bases[instruction_index],
            rows.machine_layer_physical_sizes[instruction_index],
            rows.machine_layer_physical_modes[instruction_index],
            rows.machine_layer_runtime_operations[instruction_index],
            rows.machine_layer_hardware_adequate[instruction_index],
            rows.machine_layer_authority_required[instruction_index],
            rows.machine_layer_live_lease_required[instruction_index]
        );

    CompilerArtifactWrite(output, "{\"id\":");
    CompilerArtifactWrite(output, ToString(rows.ids[instruction_index]));
    CompilerArtifactWrite(output, ",\"kind\":");
    if !JsonStringLiteralWriteFile(
        output, rows.kinds[instruction_index]
    ) { return false; }
    CompilerArtifactWrite(output, ",\"name\":");
    if !JsonStringLiteralWriteFile(
        output, rows.names[instruction_index]
    ) { return false; }
    CompilerArtifactWrite(output, ",\"result\":");
    if !SelfMirJsonOptionalStringWriteFile(
        output, rows.results[instruction_index]
    ) { return false; }
    CompilerArtifactWrite(output, ",\"arg0\":");
    if !SelfMirJsonOptionalStringWriteFile(
        output, rows.arg0s[instruction_index]
    ) { return false; }
    CompilerArtifactWrite(output, ",\"arg1\":");
    if !SelfMirJsonOptionalStringWriteFile(
        output, rows.arg1s[instruction_index]
    ) { return false; }
    CompilerArtifactWrite(output, ",\"slot_anchor\":");
    if !SelfMirJsonOptionalStringWriteFile(
        output, rows.slot_anchors[instruction_index]
    ) { return false; }
    CompilerArtifactWrite(output, ",\"abi_type_name\":");
    if !SelfMirJsonOptionalStringWriteFile(
        output, abi_type_name
    ) { return false; }
    CompilerArtifactWrite(output, ",\"abi_layout_id\":");
    CompilerArtifactWrite(output, SelfMirJsonAbiLayoutId(abi_layout));
    CompilerArtifactWrite(output, ",\"abi_layout_required\":");
    if abi_layout_required {
        CompilerArtifactWrite(output, "true");
    } else {
        CompilerArtifactWrite(output, "false");
    }
    CompilerArtifactWrite(output, ",\"abi_layout\":");
    if abi_layout_required {
        CompilerArtifactWrite(output, abi_layout);
    } else {
        CompilerArtifactWrite(output, "null");
    }
    CompilerArtifactWrite(output, ",\"expr0\":");
    if !SelfMirJsonOptionalStringWriteFile(
        output, rows.expr0s[instruction_index]
    ) { return false; }
    CompilerArtifactWrite(output, ",\"expr0_graph\":");
    if !SelfMirJsonExpressionGraphWriteFile(
        rows.expr0_graphs, facts.expression_graph, instruction_index, output
    ) { return false; }
    CompilerArtifactWrite(output, ",\"expr1\":");
    if !SelfMirJsonOptionalStringWriteFile(
        output, rows.expr1s[instruction_index]
    ) { return false; }
    CompilerArtifactWrite(output, ",\"expr1_graph\":");
    if !SelfMirJsonExpressionGraphWriteFile(
        rows.expr1_graphs, facts.expression_graph, instruction_index, output
    ) { return false; }
    CompilerArtifactWrite(output, ",\"source_type\":");
    if !SelfMirJsonOptionalStringWriteFile(
        output, rows.source_types[instruction_index]
    ) { return false; }
    CompilerArtifactWrite(output, ",\"machine_contact_kind\":");
    if !JsonStringLiteralWriteFile(
        output, machine.contact_kind
    ) { return false; }
    CompilerArtifactWrite(output, ",\"machine_layer\":");
    CompilerArtifactWrite(output, SelfMirJsonMachineLayer(machine));
    if !SelfMirJsonMatchFieldsWriteFile(
        rows, instruction_index, output
    ) { return false; }
    if !SelfMirJsonDestructureFieldsWriteFile(
        rows, instruction_index, output
    ) { return false; }
    CompilerArtifactWrite(output, ",\"uses\":[");
    let use_i: Int = 0;
    while use_i < rows.use_counts[instruction_index] {
        if use_i > 0 { CompilerArtifactWrite(output, ","); }
        if !JsonStringLiteralWriteFile(output,
            rows.uses[rows.use_starts[instruction_index] + use_i]
        ) { return false; }
        use_i = use_i + 1;
    }
    CompilerArtifactWrite(output, "]");
    if !SelfMirJsonRuntimeCallAbiPrimaryWriteFile(
        rows, instruction_index, output
    ) { return false; }
    if !SelfMirJsonRuntimeCallAbiAuxWriteFile(
        rows, instruction_index, output
    ) { return false; }
    CompilerArtifactWrite(output, "}");
    return true;
}
