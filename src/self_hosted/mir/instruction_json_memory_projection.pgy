func SelfMirJsonInstructionWriteMemory(
    facts: SelfMirProgramFacts,
    instruction_index: Int,
    inout fragments: Array<String>,
    emit_local_refs: Bool
) -> Bool {
    let rows: SelfMirInstructionRows = facts.cfg.instructions;
    if instruction_index < 0 ||
        instruction_index >= ArrayLength(rows.ids) {
        return false;
    }

    let abi_type_name: String = SelfMirJsonAbiTypeName(
        rows, instruction_index
    );
    let abi_projection: SelfMirInstructionAbiJsonProjection =
        SelfMirInstructionAbiJsonProjectionForRow(
            facts.declarations, facts.instruction_abi_receipts,
            instruction_index, abi_type_name
        );
    if !abi_projection.ready { return false; }
    let abi_layout: String = abi_projection.layout;
    let abi_layout_required: Bool = StringLength(abi_layout) > 0;
