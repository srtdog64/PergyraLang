func SelfMirJsonOptionalStringWriteMemory(
    inout fragments: Array<String>,
    value: String
) -> Bool {
    if value == "" {
        JsonProjectionAppend(fragments, "null");
        return true;
    }
    return JsonStringLiteralAppend(fragments, value);
}

func SelfMirJsonExpressionGraphWriteMemory(
    rows: SelfMirExpressionGraphRows,
    ref graph: SemanticExpressionGraphFacts,
    instruction_index: Int,
    inout fragments: Array<String>
) -> Bool {
    if instruction_index < 0 ||
        instruction_index >= ArrayLength(rows.has_roots) {
        return false;
    }
    if rows.has_roots[instruction_index] != 1 {
        JsonProjectionAppend(fragments, "null");
        return true;
    }

    let start: Int = rows.node_starts[instruction_index];
    let count: Int = rows.node_counts[instruction_index];
    JsonProjectionAppend(fragments, "{\"root\":");
    JsonOwnedFragmentAppend(
        fragments, ToString(rows.roots[instruction_index] - start)
    );
    let digest: Int = SelfMirExpressionGraphDigest(rows, graph, instruction_index);
    if digest <= 0 { return false; }
    JsonProjectionAppend(fragments, ",\"digest\":");
    JsonOwnedFragmentAppend(fragments, ToString(digest));
    JsonProjectionAppend(fragments, ",\"nodes\":[");
    var i: Int = 0;
    while i < count {
        let node: Int = start + i;
        let kind_opt: Option<Int> = SemanticExpressionGraphNodeKind(
            graph, node
        );
        let text_opt: Option<String> = SemanticExpressionGraphNodeText(
            graph, node
        );
        let call_target_kind_opt: Option<Int> =
            SemanticExpressionGraphCallTargetKind(graph, node);
        let call_target_name_opt: Option<String> =
            SemanticExpressionGraphCallTargetName(graph, node);
        if !IsSome(kind_opt) || !IsSome(text_opt) ||
            !IsSome(call_target_kind_opt) || !IsSome(call_target_name_opt) {
            return false;
        }

        let kind: Int = UnwrapOption(kind_opt);
        let arity: Int = AstExpressionNodeArity(kind);
        var left: Int = -1;
        var right: Int = -1;
        if arity == 1 || arity == 2 {
            let left_opt: Option<Int> = SemanticExpressionGraphLeftChild(
                graph, node
            );
            if !IsSome(left_opt) { return false; }
            left = UnwrapOption(left_opt) - start;
        }
        if arity == 2 {
            let right_opt: Option<Int> = SemanticExpressionGraphRightChild(
                graph, node
            );
            if !IsSome(right_opt) { return false; }
            right = UnwrapOption(right_opt) - start;
        }

        if i > 0 { JsonProjectionAppend(fragments, ","); }
        JsonProjectionAppend(fragments, "{\"kind\":");
        if !JsonStringLiteralAppend(fragments,
            SelfMirExpressionGraphKindName(kind)
        ) { return false; }
        JsonProjectionAppend(fragments, ",\"text\":");
        if !JsonStringLiteralAppend(
            fragments, UnwrapOption(text_opt)
        ) { return false; }
        JsonProjectionAppend(fragments, ",\"call_target_kind\":");
        if !JsonStringLiteralAppend(fragments,
            SelfMirExpressionCallTargetKindName(
                UnwrapOption(call_target_kind_opt)
            )
        ) { return false; }
        JsonProjectionAppend(fragments, ",\"call_target_name\":");
        if !JsonStringLiteralAppend(fragments,
            UnwrapOption(call_target_name_opt)
        ) { return false; }
        if !SelfMirJsonExpressionIdentityWriteMemory(graph, node, fragments) {
            return false;
        }
        JsonProjectionAppend(fragments, ",\"left\":");
        if arity == 0 {
            JsonProjectionAppend(fragments, "null");
        } else {
            JsonOwnedFragmentAppend(fragments, ToString(left));
        }
        JsonProjectionAppend(fragments, ",\"right\":");
        if arity == 2 {
            JsonOwnedFragmentAppend(fragments, ToString(right));
        } else {
            JsonProjectionAppend(fragments, "null");
        }
        JsonProjectionAppend(fragments, "}");
        i = i + 1;
    }
    JsonProjectionAppend(fragments, "]}");
    return true;
}

