            facts.collection_ownership_receipts, instruction_index
        );
    if collection_ownership_receipt == "" { return false; }
    let machine: SelfMirMachineLayerProjection =
        SelfMirMachineLayerProjection(
            true,
            rows.machine_contact_kinds[instruction_index],
            rows.machine_layer_manifest_ids[instruction_index],
            rows.machine_layer_physical_grant_ids[instruction_index],
            rows.machine_layer_physical_bases[instruction_index],
            rows.machine_layer_physical_sizes[instruction_index],
            rows.machine_layer_physical_modes[instruction_index],
            rows.machine_layer_runtime_operations[instruction_index],
            rows.machine_layer_hardware_adequate[instruction_index],
            rows.machine_layer_authority_required[instruction_index],
            rows.machine_layer_live_lease_required[instruction_index]
        );

    JsonProjectionAppend(fragments, "{\"id\":");
    JsonOwnedFragmentAppend(
        fragments, ToString(rows.ids[instruction_index])
    );
    JsonProjectionAppend(fragments, ",\"kind\":");
    if !JsonStringLiteralAppend(
        fragments, rows.kinds[instruction_index]
    ) { return false; }
    JsonProjectionAppend(fragments, ",\"name\":");
    if !JsonStringLiteralAppend(
        fragments, rows.names[instruction_index]
    ) { return false; }
    JsonProjectionAppend(fragments, ",\"result\":");
    if !SelfMirJsonOptionalStringWriteMemory(
        fragments, rows.results[instruction_index]
    ) { return false; }
    JsonProjectionAppend(fragments, ",\"arg0\":");
    if !SelfMirJsonOptionalStringWriteMemory(
        fragments, rows.arg0s[instruction_index]
    ) { return false; }
    JsonProjectionAppend(fragments, ",\"arg1\":");
    if !SelfMirJsonOptionalStringWriteMemory(
        fragments, rows.arg1s[instruction_index]
    ) { return false; }
    JsonProjectionAppend(fragments, ",\"slot_anchor\":");
    if !SelfMirJsonOptionalStringWriteMemory(
        fragments, rows.slot_anchors[instruction_index]
    ) { return false; }
    JsonProjectionAppend(fragments, ",\"abi_type_name\":");
    if !SelfMirJsonOptionalStringWriteMemory(
        fragments, abi_type_name
    ) { return false; }
    JsonProjectionAppend(fragments, ",\"abi_layout_id\":");
    if abi_layout_required {
        JsonProjectionAppend(fragments, SelfMirJsonAbiLayoutId(abi_layout));
    } else {
        JsonProjectionAppend(fragments, "0");
    }
    JsonProjectionAppend(fragments, ",\"abi_layout_required\":");
    if abi_layout_required {
        JsonProjectionAppend(fragments, "true");
    } else {
        JsonProjectionAppend(fragments, "false");
    }
    JsonProjectionAppend(fragments, ",\"abi_layout\":");
    if abi_layout_required {
        JsonProjectionAppend(fragments, abi_layout);
    } else {
        JsonProjectionAppend(fragments, "null");
    }
    JsonProjectionAppend(fragments, ",\"expr0\":");
    if !SelfMirJsonOptionalStringWriteMemory(
        fragments, rows.expr0s[instruction_index]
    ) { return false; }
    JsonProjectionAppend(fragments, ",\"expr0_graph\":");
    if !SelfMirJsonExpressionGraphWriteMemory(
        rows.expr0_graphs, facts.expression_graph, instruction_index, fragments
    ) { return false; }
    JsonProjectionAppend(fragments, ",\"expr1\":");
    if !SelfMirJsonOptionalStringWriteMemory(
        fragments, rows.expr1s[instruction_index]
    ) { return false; }
    JsonProjectionAppend(fragments, ",\"expr1_graph\":");
    if !SelfMirJsonExpressionGraphWriteMemory(
        rows.expr1_graphs, facts.expression_graph, instruction_index, fragments
    ) { return false; }
    if rows.kinds[instruction_index] == "stmt" &&
        rows.source_types[instruction_index] == "AST_CALL" &&
        (rows.arg0s[instruction_index] == "ArrayPush" ||
         rows.arg0s[instruction_index] == "ArraySet" ||
