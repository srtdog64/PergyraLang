        JsonProjectionAppend(
            fragments, ",\"collection_mutation_target_graph\":"
        );
        if !SelfMirJsonExpressionGraphWriteMemory(
            rows.collection_mutation_target_graphs,
            facts.expression_graph, instruction_index, fragments
        ) { return false; }
    }
    JsonProjectionAppend(fragments, ",\"collection_ownership_receipt\":");
    if facts.collection_ownership_receipts.effect_kinds[
            instruction_index] == 0 {
        JsonProjectionAppend(fragments, "null");
    } else {
        JsonProjectionAppend(fragments, collection_ownership_receipt);
    }
    JsonProjectionAppend(fragments, ",\"source_type\":");
    if !SelfMirJsonOptionalStringWriteMemory(
        fragments, rows.source_types[instruction_index]
    ) { return false; }
    JsonProjectionAppend(fragments, ",\"machine_contact_kind\":");
    if !JsonStringLiteralAppend(
        fragments, machine.contact_kind
    ) { return false; }
    JsonProjectionAppend(fragments, ",\"machine_layer\":");
    if machine.contact_kind == "" {
        JsonProjectionAppend(fragments, "null");
    } else {
        JsonProjectionAppend(fragments, SelfMirJsonMachineLayer(machine));
    }
    if !SelfMirJsonMatchFieldsWriteMemory(
        rows, instruction_index, fragments
    ) { return false; }
    if !SelfMirJsonDestructureFieldsWriteMemory(
        rows, instruction_index, fragments
    ) { return false; }
