    while use_i < rows.use_counts[instruction_index] {
        if use_i > 0 { JsonProjectionAppend(fragments, ","); }
        if !JsonStringLiteralAppend(fragments,
            rows.uses[rows.use_starts[instruction_index] + use_i]
        ) { return false; }
        use_i = use_i + 1;
    }
    JsonProjectionAppend(fragments, "]");
    if rows.binding_source_syntax_ids[instruction_index] > 0 {
        JsonProjectionAppend(fragments, ",\"binding_source_syntax_id\":");
        JsonOwnedFragmentAppend(fragments, ToString(rows.binding_source_syntax_ids[instruction_index]));
    }
    if emit_local_refs && !SelfMirJsonLocalRefsWriteMemory(
        facts.cfg.local_refs, instruction_index, fragments
    ) { return false; }
    if !SelfMirJsonRuntimeCallAbiPrimaryWriteMemory(
        rows, instruction_index, fragments
    ) { return false; }
    if !SelfMirJsonRuntimeCallAbiAuxWriteMemory(
        rows, instruction_index, fragments
    ) { return false; }
    JsonProjectionAppend(fragments, "}");
    return true;
}
