// Detailed structural validation for MIR instruction rows.

import "program_fact_owner.pgy";

func SelfMirIntentSemanticInstructionName(name: String) -> Bool {
    return name == "IntentBinding" || name == "IntentParticipant" ||
        name == "IntentValue" || name == "IntentStep" ||
        name == "IntentZoneWhere" || name == "IntentZoneAlias" ||
        name == "IntentInvalidationTarget" || name == "IntentWho" ||
        name == "IntentAuthorizedBy" || name == "IntentCauses" ||
        name == "IntentOutcomeBinding" || name == "IntentCheck" ||
        name == "IntentEval";
}

func SelfMirIntentCarrierInstruction(
    rows: SelfMirInstructionRows,
    index: Int
) -> Bool {
    let kind: String = rows.kinds[index];
    if kind == "resource-op" {
        return (rows.names[index] == "CommitIntent" ||
                rows.names[index] == "Read" ||
                rows.names[index] == "AttachEffect" ||
                rows.names[index] == "Authorize") &&
            rows.arg0s[index] != "" && rows.slot_anchors[index] != "" &&
            rows.expr0s[index] == "" && rows.expr1s[index] == "" &&
            (rows.source_types[index] == "AST_INTENT_DECL" ||
             rows.source_types[index] == "AST_INTENT_STEP");
    }
    if kind == "cleanup" {
        return (rows.names[index] == "cleanup-edge" ||
                rows.names[index] == "RollbackPolicy" ||
                rows.names[index] == "AbortIntent" ||
                rows.names[index] == "DetachInvalidation" ||
                rows.names[index] == "cleanup-edge-from-rollback" ||
                rows.names[index] == "cleanup-edge-from-invalidation") &&
            rows.arg0s[index] != "" && rows.expr0s[index] == "" &&
            rows.expr1s[index] == "";
    }
    if kind != "stmt" { return false; }
    if rows.names[index] == "stmt" {
        return rows.source_types[index] == "AST_INTENT_STEP" &&
            (rows.expr0s[index] == "" ||
             rows.expr0_graphs.has_roots[index] == 1);
    }
    if !SelfMirIntentSemanticInstructionName(rows.names[index]) ||
        rows.arg0s[index] == "" {
        return false;
    }
    if rows.names[index] == "IntentCheck" ||
        rows.names[index] == "IntentEval" {
        return rows.source_types[index] != "" &&
            rows.expr0s[index] != "" &&
            rows.expr0_graphs.has_roots[index] == 1 &&
            ((rows.results[index] == "" &&
              rows.abi_type_names[index] == "") ||
             (rows.names[index] == "IntentEval" &&
              rows.results[index] != "" &&
              rows.abi_type_names[index] != "" &&
              rows.abi_type_names[index] != "Unknown" &&
              rows.abi_type_names[index] != "Void"));
    }
    if rows.names[index] == "IntentOutcomeBinding" {
        return rows.source_types[index] == "AST_INTENT_STEP" &&
            rows.results[index] != "" && rows.arg0s[index] != "" &&
            ToInt(rows.arg0s[index]) > 0 &&
            ToString(ToInt(rows.arg0s[index])) == rows.arg0s[index] &&
            rows.arg1s[index] != "" &&
            rows.slot_anchors[index] == rows.results[index] &&
            rows.abi_type_names[index] != "" &&
            rows.abi_type_names[index] != "Unknown" &&
            rows.abi_type_names[index] != "Void" &&
            rows.use_counts[index] == 0 &&
            rows.expr0s[index] == "" && rows.expr1s[index] == "" &&
            rows.expr0_graphs.has_roots[index] == 0 &&
            rows.expr1_graphs.has_roots[index] == 0 &&
            rows.runtime_call_abi.present[index] == 0;
    }
    return (rows.source_types[index] == "AST_INTENT_STEP" ||
            rows.source_types[index] == "AST_INTENT_INVOLVES" ||
            rows.source_types[index] == "AST_INTENT_VALUE") &&
        rows.expr0s[index] == "" && rows.expr1s[index] == "";
}

func SelfMirInstructionRowsValidationError(
    rows: SelfMirInstructionRows
) -> String {
    let count: Int = ArrayLength(rows.ids);
    if ArrayLength(rows.kinds) != count { return "kind row count differs"; }
    if ArrayLength(rows.names) != count { return "name row count differs"; }
    if ArrayLength(rows.results) != count { return "result row count differs"; }
    if ArrayLength(rows.arg0s) != count { return "arg0 row count differs"; }
    if ArrayLength(rows.arg1s) != count { return "arg1 row count differs"; }
    if ArrayLength(rows.slot_anchors) != count {
        return "slot-anchor row count differs";
    }
    if ArrayLength(rows.expr0s) != count { return "expr0 row count differs"; }
    if ArrayLength(rows.expr1s) != count { return "expr1 row count differs"; }
    if ArrayLength(rows.source_types) != count {
        return "source-type row count differs";
    }
    if ArrayLength(rows.abi_type_names) != count {
        return "ABI type-name row count differs";
    }
    if ArrayLength(rows.machine_contact_kinds) != count {
        return "machine-contact row count differs";
    }
    if ArrayLength(rows.machine_layer_manifest_ids) != count {
        return "machine manifest row count differs";
    }
    if ArrayLength(rows.machine_layer_physical_grant_ids) != count {
        return "machine physical-grant row count differs";
    }
    if ArrayLength(rows.machine_layer_physical_bases) != count {
        return "machine physical-base row count differs";
    }
    if ArrayLength(rows.machine_layer_physical_sizes) != count {
        return "machine physical-size row count differs";
    }
    if ArrayLength(rows.machine_layer_physical_modes) != count {
        return "machine physical-mode row count differs";
    }
    if ArrayLength(rows.machine_layer_runtime_operations) != count {
        return "machine runtime-operation row count differs";
    }
    if ArrayLength(rows.machine_layer_hardware_adequate) != count {
        return "machine adequacy row count differs";
    }
    if ArrayLength(rows.machine_layer_authority_required) != count {
        return "machine authority row count differs";
    }
    if ArrayLength(rows.machine_layer_live_lease_required) != count {
        return "machine lease row count differs";
    }
    if !SelfMirRuntimeCallAbiRowsReady(rows.runtime_call_abi, count) {
        return "runtime-call ABI row count differs";
    }
    if ArrayLength(rows.use_starts) != count {
        return "use-start row count differs";
    }
    if ArrayLength(rows.use_counts) != count {
        return "use-count row count differs";
    }
    if !SelfMirExpressionGraphRowsReady(rows.expr0_graphs, count) {
        return "expr0 graph rows are invalid";
    }
    if !SelfMirExpressionGraphRowsReady(rows.expr1_graphs, count) {
        return "expr1 graph rows are invalid";
    }
    let match_error: String = SelfMirMatchFactRowsValidationError(
        rows.match_facts, count
    );
    if match_error != "" { return match_error; }
    let destructure_error: String = SelfMirDestructureFactRowsValidationError(
        rows.destructure_facts, count
    );
    if destructure_error != "" { return destructure_error; }
    let use_cursor: Int = 0;
    let i: Int = 0;
    while i < count {
        let kind: String = rows.kinds[i];
        let row_prefix: String = Concat("instruction=", ToString(i));
        if rows.use_starts[i] != use_cursor {
            return Concat(row_prefix, " use-start is non-canonical");
        }
        if rows.use_counts[i] < 0 {
            return Concat(row_prefix, " use-count is negative");
        }
        let intent_carrier: Bool = SelfMirIntentCarrierInstruction(rows, i);
        if kind != "def" && kind != "stmt" && kind != "return" &&
            kind != "branch" && kind != "phi" && kind != "loop-init" &&
            kind != "destructure" && !intent_carrier {
            return Concat(row_prefix, " instruction kind is unknown");
        }
        if kind == "branch" && rows.names[i] == "branch" &&
            rows.arg0s[i] == "" &&
            rows.source_types[i] != "AST_MATCH_CASE" &&
            rows.expr0_graphs.has_roots[i] != 1 {
            return Concat(row_prefix, " branch expression graph is missing");
        }
        if kind == "stmt" &&
            (rows.arg0s[i] == "" || rows.arg0s[i] == "Log" ||
             rows.arg0s[i] == "ArrayPush" || rows.arg0s[i] == "ArraySet" ||
             rows.arg0s[i] == "Exit") &&
            rows.source_types[i] == "AST_CALL" &&
            rows.expr0_graphs.has_roots[i] != 1 {
            return Concat(row_prefix, " statement expression graph is missing");
        }
        if kind == "def" &&
            (rows.arg0s[i] == "" || rows.expr0s[i] == "" ||
             rows.source_types[i] == "") {
            return Concat(row_prefix, " definition payload is incomplete");
        }
        let ability_bind: Bool = kind == "stmt" &&
            rows.source_types[i] == "AST_BIND_STMT" &&
            rows.names[i] == "bind" && rows.arg0s[i] != "" &&
            rows.arg1s[i] != "" && rows.slot_anchors[i] != "";
        if kind == "stmt" && rows.expr0s[i] == "" && !ability_bind &&
            !intent_carrier {
            return Concat(row_prefix, " statement payload is empty");
        }
        if rows.source_types[i] == "AST_BIND_STMT" && !ability_bind {
            return Concat(
                row_prefix, " ability-bind slot fact is missing or invalid"
            );
        }
        if rows.source_types[i] != "AST_BIND_STMT" && !intent_carrier &&
            rows.slot_anchors[i] != "" {
            return Concat(
                row_prefix, " slot anchor is attached to a non-bind row"
            );
        }
        let typed_defer: Bool = kind == "stmt" &&
            (rows.arg0s[i] == "Log" || rows.arg0s[i] == "Call") &&
            rows.expr0s[i] == "{...}" &&
            rows.expr0_graphs.has_roots[i] == 1;
        if rows.source_types[i] == "AST_DEFER_STMT" &&
            !typed_defer {
            return Concat(
                row_prefix, " typed defer body fact is missing or invalid"
            );
        }
        if kind == "stmt" && rows.arg0s[i] == "ArraySet" &&
            rows.source_types[i] == "AST_CALL" &&
            (rows.expr1s[i] == "" ||
             rows.expr1_graphs.has_roots[i] != 1) {
            return Concat(
                row_prefix, " ArraySet index graph is missing"
            );
        }
        if kind == "return" &&
            ((rows.expr0s[i] == "" &&
              rows.source_types[i] != "AST_RETURN_VOID") ||
             (rows.expr0s[i] != "" &&
              rows.source_types[i] == "AST_RETURN_VOID")) {
            return Concat(row_prefix, " return payload and type disagree");
        }
        if kind == "branch" && rows.expr0s[i] == "" {
            return Concat(row_prefix, " branch payload is empty");
        }
        let match_fact_index: Option<Int> =
            SelfMirMatchFactIndexForInstruction(rows.match_facts, i);
        if rows.source_types[i] == "AST_MATCH_CASE" {
            if kind != "branch" || rows.expr0_graphs.has_roots[i] != 1 ||
                !IsSome(match_fact_index) {
                return Concat(
                    row_prefix, " match branch fact is missing or invalid"
                );
            }
        } else if IsSome(match_fact_index) {
            return Concat(row_prefix, " match fact is attached to non-match");
        }
        let destructure_fact_index: Option<Int> =
            SelfMirDestructureFactIndexForInstruction(
                rows.destructure_facts, i
            );
        if kind == "destructure" {
            if rows.source_types[i] != "AST_LET_DESTRUCTURE" ||
                rows.expr0s[i] == "" ||
                rows.expr0_graphs.has_roots[i] != 1 ||
                !IsSome(destructure_fact_index) {
                return Concat(
                    row_prefix,
                    " destructure instruction fact is missing or invalid"
                );
            }
        } else if IsSome(destructure_fact_index) {
            return Concat(
                row_prefix, " destructure fact is attached to non-destructure"
            );
        }
        if kind == "phi" && rows.results[i] == "" {
            return Concat(row_prefix, " phi result is empty");
        }
        if kind == "loop-init" &&
            (rows.arg0s[i] == "" || rows.expr0s[i] == "" ||
             rows.expr1s[i] == "") {
            return Concat(row_prefix, " loop initializer is incomplete");
        }
        if !SelfMirAssignmentTargetGraphReady(rows, i) {
            return Concat(
                row_prefix,
                Concat(
                    " assignment target graph is invalid: ",
                    SelfMirAssignmentTargetGraphValidationError(rows, i)
                )
            );
        }
        let machine_row: SelfMirMachineLayerProjection =
            SelfMirMachineLayerProjection(
                true, rows.machine_contact_kinds[i],
                rows.machine_layer_manifest_ids[i],
                rows.machine_layer_physical_grant_ids[i],
                rows.machine_layer_physical_bases[i],
                rows.machine_layer_physical_sizes[i],
                rows.machine_layer_physical_modes[i],
                rows.machine_layer_runtime_operations[i],
                rows.machine_layer_hardware_adequate[i],
                rows.machine_layer_authority_required[i],
                rows.machine_layer_live_lease_required[i]
            );
        if !SelfMirMachineLayerProjectionShapeReady(machine_row) {
            return Concat(row_prefix, " machine-layer projection is invalid");
        }
        let runtime_abi_error: String =
            SelfMirRuntimeCallAbiRowValidationError(
                rows.runtime_call_abi, i,
                rows.machine_layer_runtime_operations[i]
            );
        if runtime_abi_error != "" {
            return Concat(row_prefix, Concat(" ", runtime_abi_error));
        }
        use_cursor = use_cursor + rows.use_counts[i];
        i = i + 1;
    }
    if use_cursor != ArrayLength(rows.uses) {
        return "instruction use payload total differs";
    }
    return "";
}
