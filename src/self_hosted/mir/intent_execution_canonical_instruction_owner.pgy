// Rebind typed Intent transitions to the canonical instruction epoch.
import "program_fact_owner.pgy";

func SelfMirIntentCanonicalInstructionId(
    ref facts: SelfMirProgramFacts, ref ids: Array<Int>,
    routine_id: Int, block_id: Int, old_id: Int
) -> Int {
    var found: Int = -1;
    var routine: Int = 0;
    while routine < ArrayLength(facts.routines.node_ids) {
        if facts.routines.node_ids[routine] == routine_id {
            var block: Int = facts.routines.block_starts[routine];
            let end: Int = block + facts.routines.block_counts[routine];
            while block < end {
                if facts.cfg.blocks.ids[block] == block_id {
                    var instruction: Int = facts.cfg.blocks.instruction_starts[block];
                    let instruction_end: Int = instruction + facts.cfg.blocks.instruction_counts[block];
                    while instruction < instruction_end {
                        if facts.cfg.instructions.ids[instruction] == old_id {
                            if found >= 0 { return -1; }
                            found = ids[instruction];
                        }
                        instruction = instruction + 1;
                    }
                }
                block = block + 1;
            }
        }
        routine = routine + 1;
    }
    return found;
}

func SelfMirIntentExecutionCanonicalPlan(
    facts: SelfMirProgramFacts, ref ids: Array<Int>
) -> MirIntentExecutionPlan {
    var steps: MirIntentStepTransitionFacts = facts.intent_execution.steps;
    var terminals: MirIntentTerminalTransitionFacts = facts.intent_execution.terminals;
    var step: Int = 0;
    while step < ArrayLength(steps.transition_ids) {
        let routine: Int = steps.routine_syntax_ids[step];
        ArraySet(steps.outcome_instruction_ids, step,
            SelfMirIntentCanonicalInstructionId(facts, ids, routine,
                steps.outcome_instruction_block_ids[step], steps.outcome_instruction_ids[step]));
        ArraySet(steps.branch_instruction_ids, step,
            SelfMirIntentCanonicalInstructionId(facts, ids, routine,
                steps.branch_block_ids[step], steps.branch_instruction_ids[step]));
        ArraySet(steps.completion_instruction_ids, step,
            SelfMirIntentCanonicalInstructionId(facts, ids, routine,
                steps.completion_block_ids[step], steps.completion_instruction_ids[step]));
        var compensation: Int = steps.compensation_starts[step];
        let end: Int = compensation + steps.compensation_counts[step];
        while compensation < end {
            ArraySet(steps.compensations.instruction_ids, compensation,
                SelfMirIntentCanonicalInstructionId(facts, ids, routine,
                    steps.compensations.instruction_block_ids[compensation],
                    steps.compensations.instruction_ids[compensation]));
            compensation = compensation + 1;
        }
        step = step + 1;
    }
    var terminal: Int = 0;
    while terminal < ArrayLength(terminals.terminal_transition_ids) {
        ArraySet(terminals.result_instruction_ids, terminal,
            SelfMirIntentCanonicalInstructionId(facts, ids,
                terminals.routine_syntax_ids[terminal],
                terminals.result_instruction_block_ids[terminal],
                terminals.result_instruction_ids[terminal]));
        terminal = terminal + 1;
    }
    return MirIntentExecutionPlanFromFacts(steps, terminals);
}
