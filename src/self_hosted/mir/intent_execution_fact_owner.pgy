// Canonical MIR execution facts for typed intent steps and terminal results.
//
// These rows are an execution authority, not a source reconstruction cache.
// A step transition keeps the action result definition, exact enum variant
// identities, branch targets, success-only completion, explicit predecessor,
// and compensation graph identity under one stable transition handle.
// Terminal rows separately consume a step payload and construct the declared
// intent result.  Neither owner classifies variants by spelling or recovers a
// predecessor from row position or textual sequencing.
struct MirIntentCompensationFacts {
    transition_ids: Array<Int>;
    expression_syntax_ids: Array<Int>;
    instruction_block_ids: Array<Int>;
    instruction_ids: Array<Int>;
    graph_root_ids: Array<Int>;
    graph_digests: Array<Int>;
    call_target_names: Array<String>;
    call_target_syntax_ids: Array<Int>;
}

struct MirIntentStepTransitionFacts {
    transition_ids: Array<Int>;
    routine_syntax_ids: Array<Int>;
    step_syntax_ids: Array<Int>;
    step_names: Array<String>;
    predecessor_transition_ids: Array<Int>;
    predecessor_step_syntax_ids: Array<Int>;
    predecessor_step_names: Array<String>;
    action_syntax_ids: Array<Int>;
    outcome_instruction_block_ids: Array<Int>;
    outcome_instruction_ids: Array<Int>;
    outcome_result_names: Array<String>;
    outcome_type_names: Array<String>;
    outcome_enum_names: Array<String>;
    outcome_enum_syntax_ids: Array<Int>;
    branch_block_ids: Array<Int>;
    branch_instruction_ids: Array<Int>;
    success_variant_indices: Array<Int>;
    success_variant_names: Array<String>;
    success_payload_names: Array<String>;
    success_payload_type_names: Array<String>;
    success_successor_block_ids: Array<Int>;
    failure_variant_indices: Array<Int>;
    failure_variant_names: Array<String>;
    failure_payload_names: Array<String>;
    failure_payload_type_names: Array<String>;
    failure_successor_block_ids: Array<Int>;
    completion_block_ids: Array<Int>;
    completion_instruction_ids: Array<Int>;
    compensation_starts: Array<Int>;
    compensation_counts: Array<Int>;
    compensations: MirIntentCompensationFacts;
}

struct MirIntentTerminalTransitionFacts {
    terminal_transition_ids: Array<Int>;
    routine_syntax_ids: Array<Int>;
    roles: Array<String>;
    source_transition_ids: Array<Int>;
    source_step_syntax_ids: Array<Int>;
    source_step_names: Array<String>;
    source_variant_indices: Array<Int>;
    source_variant_names: Array<String>;
    source_payload_names: Array<String>;
    source_payload_type_names: Array<String>;
    result_instruction_block_ids: Array<Int>;
    result_instruction_ids: Array<Int>;
    result_definition_names: Array<String>;
    result_type_names: Array<String>;
    result_enum_names: Array<String>;
    result_enum_syntax_ids: Array<Int>;
    result_variant_indices: Array<Int>;
    result_variant_names: Array<String>;
    result_payload_names: Array<String>;
    result_payload_type_names: Array<String>;
    expression_syntax_ids: Array<Int>;
    graph_root_ids: Array<Int>;
    graph_digests: Array<Int>;
}

struct MirIntentExecutionPlan {
    valid: Bool;
    present: Bool;
    schema: String;
    plan_digest: Int;
    steps: MirIntentStepTransitionFacts;
    terminals: MirIntentTerminalTransitionFacts;
}

func MirIntentExecutionPlanSchema() -> String {
    return "pgy.selfhost.mir-intent-execution-plan.v1";
}

func MirIntentCompensationFactsEmpty() -> MirIntentCompensationFacts {
    let ints: Array<Int> = [];
    let strings: Array<String> = [];
    return MirIntentCompensationFacts(
        ints, ints, ints, ints, ints, ints, strings, ints
    );
}

func MirIntentStepTransitionFactsEmpty(
) -> MirIntentStepTransitionFacts {
    let ints: Array<Int> = [];
    let strings: Array<String> = [];
    return MirIntentStepTransitionFacts(
        ints, ints, ints, strings, ints, ints, strings, ints, ints, ints,
        strings, strings, strings, ints, ints, ints, ints, strings, strings,
        strings, ints, ints, strings, strings, strings, ints, ints, ints,
        ints, ints, MirIntentCompensationFactsEmpty()
    );
}

func MirIntentTerminalTransitionFactsEmpty(
) -> MirIntentTerminalTransitionFacts {
    let ints: Array<Int> = [];
    let strings: Array<String> = [];
    return MirIntentTerminalTransitionFacts(
        ints, ints, strings, ints, ints, strings, ints, strings, strings,
        strings, ints, ints, strings, strings, strings, ints, ints, strings,
        strings, strings, ints, ints, ints
    );
}

func MirIntentExecutionPlanEmpty(
    valid: Bool, present: Bool
) -> MirIntentExecutionPlan {
    let plan: MirIntentExecutionPlan = MirIntentExecutionPlan(
        valid, present, MirIntentExecutionPlanSchema(), 0,
        MirIntentStepTransitionFactsEmpty(),
        MirIntentTerminalTransitionFactsEmpty()
    );
    if valid && !present {
        plan.plan_digest = MirIntentExecutionPlanDigest(plan);
    }
    return plan;
}

func MirIntentCompensationFactsAligned(
    ref rows: MirIntentCompensationFacts
) -> Bool {
    let count: Int = ArrayLength(rows.transition_ids);
    return count == ArrayLength(rows.expression_syntax_ids) &&
        count == ArrayLength(rows.instruction_block_ids) &&
        count == ArrayLength(rows.instruction_ids) &&
        count == ArrayLength(rows.graph_root_ids) &&
        count == ArrayLength(rows.graph_digests) &&
        count == ArrayLength(rows.call_target_names) &&
        count == ArrayLength(rows.call_target_syntax_ids);
}

func MirIntentStepTransitionFactsAligned(
    ref rows: MirIntentStepTransitionFacts
) -> Bool {
    let count: Int = ArrayLength(rows.transition_ids);
    return count == ArrayLength(rows.routine_syntax_ids) &&
        count == ArrayLength(rows.step_syntax_ids) &&
        count == ArrayLength(rows.step_names) &&
        count == ArrayLength(rows.predecessor_transition_ids) &&
        count == ArrayLength(rows.predecessor_step_syntax_ids) &&
        count == ArrayLength(rows.predecessor_step_names) &&
        count == ArrayLength(rows.action_syntax_ids) &&
        count == ArrayLength(rows.outcome_instruction_block_ids) &&
        count == ArrayLength(rows.outcome_instruction_ids) &&
        count == ArrayLength(rows.outcome_result_names) &&
        count == ArrayLength(rows.outcome_type_names) &&
        count == ArrayLength(rows.outcome_enum_names) &&
        count == ArrayLength(rows.outcome_enum_syntax_ids) &&
        count == ArrayLength(rows.branch_block_ids) &&
        count == ArrayLength(rows.branch_instruction_ids) &&
        count == ArrayLength(rows.success_variant_indices) &&
        count == ArrayLength(rows.success_variant_names) &&
        count == ArrayLength(rows.success_payload_names) &&
        count == ArrayLength(rows.success_payload_type_names) &&
        count == ArrayLength(rows.success_successor_block_ids) &&
        count == ArrayLength(rows.failure_variant_indices) &&
        count == ArrayLength(rows.failure_variant_names) &&
        count == ArrayLength(rows.failure_payload_names) &&
        count == ArrayLength(rows.failure_payload_type_names) &&
        count == ArrayLength(rows.failure_successor_block_ids) &&
        count == ArrayLength(rows.completion_block_ids) &&
        count == ArrayLength(rows.completion_instruction_ids) &&
        count == ArrayLength(rows.compensation_starts) &&
        count == ArrayLength(rows.compensation_counts) &&
        MirIntentCompensationFactsAligned(rows.compensations);
}

func MirIntentTerminalTransitionFactsAligned(
    ref rows: MirIntentTerminalTransitionFacts
) -> Bool {
    let count: Int = ArrayLength(rows.terminal_transition_ids);
    return count == ArrayLength(rows.routine_syntax_ids) &&
        count == ArrayLength(rows.roles) &&
        count == ArrayLength(rows.source_transition_ids) &&
        count == ArrayLength(rows.source_step_syntax_ids) &&
        count == ArrayLength(rows.source_step_names) &&
        count == ArrayLength(rows.source_variant_indices) &&
        count == ArrayLength(rows.source_variant_names) &&
        count == ArrayLength(rows.source_payload_names) &&
        count == ArrayLength(rows.source_payload_type_names) &&
        count == ArrayLength(rows.result_instruction_block_ids) &&
        count == ArrayLength(rows.result_instruction_ids) &&
        count == ArrayLength(rows.result_definition_names) &&
        count == ArrayLength(rows.result_type_names) &&
        count == ArrayLength(rows.result_enum_names) &&
        count == ArrayLength(rows.result_enum_syntax_ids) &&
        count == ArrayLength(rows.result_variant_indices) &&
        count == ArrayLength(rows.result_variant_names) &&
        count == ArrayLength(rows.result_payload_names) &&
        count == ArrayLength(rows.result_payload_type_names) &&
        count == ArrayLength(rows.expression_syntax_ids) &&
        count == ArrayLength(rows.graph_root_ids) &&
        count == ArrayLength(rows.graph_digests);
}

func MirIntentStepTransitionIndexByIdentity(
    ref rows: MirIntentStepTransitionFacts,
    transition_id: Int,
    step_syntax_id: Int,
    step_name: String
) -> Int {
    let found: Int = 0 - 1;
    let row: Int = 0;
    while row < ArrayLength(rows.transition_ids) {
        if rows.transition_ids[row] == transition_id &&
            rows.step_syntax_ids[row] == step_syntax_id &&
            rows.step_names[row] == step_name {
            if found >= 0 { return 0 - 1; }
            found = row;
        }
        row = row + 1;
    }
    return found;
}

func MirIntentStepTransitionIndexByHandle(
    ref rows: MirIntentStepTransitionFacts,
    transition_id: Int
) -> Int {
    let found: Int = 0 - 1;
    let row: Int = 0;
    while row < ArrayLength(rows.transition_ids) {
        if rows.transition_ids[row] == transition_id {
            if found >= 0 { return 0 - 1; }
            found = row;
        }
        row = row + 1;
    }
    return found;
}

func MirIntentStepTransitionCycleFreeFrom(
    ref rows: MirIntentStepTransitionFacts,
    start_row: Int
) -> Bool {
    let seen: Array<Bool> = [];
    let i: Int = 0;
    while i < ArrayLength(rows.transition_ids) {
        ArrayPush(seen, false);
        i = i + 1;
    }
    let row: Int = start_row;
    while row >= 0 {
        if row >= ArrayLength(seen) || seen[row] { return false; }
        ArraySet(seen, row, true);
        let predecessor_id: Int = rows.predecessor_transition_ids[row];
        if predecessor_id == 0 { return true; }
        row = MirIntentStepTransitionIndexByIdentity(
            rows, predecessor_id,
            rows.predecessor_step_syntax_ids[row],
            rows.predecessor_step_names[row]
        );
        if row < 0 { return false; }
    }
    return false;
}

func MirIntentStepTransitionFactsReady(
    ref rows: MirIntentStepTransitionFacts
) -> Bool {
    if !MirIntentStepTransitionFactsAligned(rows) { return false; }
    let count: Int = ArrayLength(rows.transition_ids);
    let expected_compensation_start: Int = 0;
    let row: Int = 0;
    while row < count {
        if rows.transition_ids[row] <= 0 ||
            rows.transition_ids[row] != rows.step_syntax_ids[row] ||
            rows.routine_syntax_ids[row] <= 0 || rows.step_names[row] == "" ||
            rows.action_syntax_ids[row] <= 0 ||
            rows.outcome_instruction_block_ids[row] < 0 ||
            rows.outcome_instruction_ids[row] < 0 ||
            rows.outcome_result_names[row] == "" ||
            rows.outcome_type_names[row] == "" ||
            rows.outcome_type_names[row] == "Unknown" ||
            rows.outcome_type_names[row] == "Void" ||
            rows.outcome_enum_names[row] != rows.outcome_type_names[row] ||
            rows.outcome_enum_syntax_ids[row] <= 0 ||
            rows.branch_block_ids[row] < 0 ||
            rows.branch_instruction_ids[row] < 0 ||
            rows.success_variant_indices[row] < 0 ||
            rows.success_variant_names[row] == "" ||
            rows.success_payload_names[row] == "" ||
            rows.success_payload_type_names[row] == "" ||
            rows.success_successor_block_ids[row] < 0 ||
            rows.failure_variant_indices[row] < 0 ||
            rows.failure_variant_names[row] == "" ||
            rows.failure_payload_names[row] == "" ||
            rows.failure_payload_type_names[row] == "" ||
            rows.failure_successor_block_ids[row] < 0 ||
            rows.success_variant_indices[row] ==
                rows.failure_variant_indices[row] ||
            rows.success_variant_names[row] == rows.failure_variant_names[row] ||
            rows.success_successor_block_ids[row] ==
                rows.failure_successor_block_ids[row] ||
            rows.completion_block_ids[row] !=
                rows.success_successor_block_ids[row] ||
            rows.completion_instruction_ids[row] < 0 ||
            rows.compensation_starts[row] != expected_compensation_start ||
            rows.compensation_counts[row] < 0 ||
            expected_compensation_start + rows.compensation_counts[row] >
                ArrayLength(rows.compensations.transition_ids) {
            return false;
        }
        if rows.predecessor_transition_ids[row] == 0 {
            if rows.predecessor_step_syntax_ids[row] != 0 ||
                rows.predecessor_step_names[row] != "" { return false; }
        } else {
            let predecessor: Int = MirIntentStepTransitionIndexByIdentity(
                rows, rows.predecessor_transition_ids[row],
                rows.predecessor_step_syntax_ids[row],
                rows.predecessor_step_names[row]
            );
            if predecessor < 0 || predecessor == row ||
                rows.routine_syntax_ids[predecessor] !=
                    rows.routine_syntax_ids[row] {
                return false;
            }
        }
        let prior: Int = 0;
        while prior < row {
            if rows.transition_ids[prior] == rows.transition_ids[row] ||
                rows.step_syntax_ids[prior] == rows.step_syntax_ids[row] ||
                (rows.routine_syntax_ids[prior] ==
                    rows.routine_syntax_ids[row] &&
                 rows.step_names[prior] == rows.step_names[row]) ||
                (rows.routine_syntax_ids[prior] ==
                    rows.routine_syntax_ids[row] &&
                 rows.outcome_result_names[prior] ==
                    rows.outcome_result_names[row]) {
                return false;
            }
            prior = prior + 1;
        }
        let compensation_at: Int = expected_compensation_start;
        let compensation_end: Int = compensation_at +
            rows.compensation_counts[row];
        while compensation_at < compensation_end {
            if rows.compensations.transition_ids[compensation_at] !=
                    rows.transition_ids[row] ||
                rows.compensations.expression_syntax_ids[compensation_at] <= 0 ||
                rows.compensations.instruction_block_ids[compensation_at] < 0 ||
                rows.compensations.instruction_ids[compensation_at] < 0 ||
                rows.compensations.graph_root_ids[compensation_at] < 0 ||
                rows.compensations.graph_digests[compensation_at] <= 0 ||
                rows.compensations.call_target_names[compensation_at] == "" ||
                rows.compensations.call_target_syntax_ids[compensation_at] <= 0 {
                return false;
            }
            compensation_at = compensation_at + 1;
        }
        expected_compensation_start = compensation_end;
        row = row + 1;
    }
    if expected_compensation_start !=
        ArrayLength(rows.compensations.transition_ids) {
        return false;
    }
    row = 0;
    while row < count {
        if !MirIntentStepTransitionCycleFreeFrom(rows, row) { return false; }
        row = row + 1;
    }
    row = 0;
    while row < count {
        let first_for_routine: Bool = true;
        let prior: Int = 0;
        while prior < row {
            if rows.routine_syntax_ids[prior] ==
                rows.routine_syntax_ids[row] {
                first_for_routine = false;
            }
            prior = prior + 1;
        }
        if first_for_routine {
            let root_count: Int = 0;
            let candidate: Int = 0;
            while candidate < count {
                if rows.routine_syntax_ids[candidate] ==
                        rows.routine_syntax_ids[row] &&
                    rows.predecessor_transition_ids[candidate] == 0 {
                    root_count = root_count + 1;
                }
                candidate = candidate + 1;
            }
            if root_count != 1 { return false; }
        }
        row = row + 1;
    }
    return true;
}

func MirIntentStepTransitionHasChild(
    ref rows: MirIntentStepTransitionFacts,
    transition_id: Int
) -> Bool {
    let row: Int = 0;
    while row < ArrayLength(rows.transition_ids) {
        if rows.predecessor_transition_ids[row] == transition_id {
            return true;
        }
        row = row + 1;
    }
    return false;
}

func MirIntentTerminalSourceMatchesStep(
    ref steps: MirIntentStepTransitionFacts,
    ref terminals: MirIntentTerminalTransitionFacts,
    terminal_row: Int,
    step_row: Int
) -> Bool {
    if terminals.routine_syntax_ids[terminal_row] !=
            steps.routine_syntax_ids[step_row] ||
        terminals.source_transition_ids[terminal_row] !=
            steps.transition_ids[step_row] ||
        terminals.source_step_syntax_ids[terminal_row] !=
            steps.step_syntax_ids[step_row] ||
        terminals.source_step_names[terminal_row] !=
            steps.step_names[step_row] {
        return false;
    }
    if terminals.roles[terminal_row] == "success" {
        return terminals.source_variant_indices[terminal_row] ==
                steps.success_variant_indices[step_row] &&
            terminals.source_variant_names[terminal_row] ==
                steps.success_variant_names[step_row] &&
            terminals.source_payload_names[terminal_row] ==
                steps.success_payload_names[step_row] &&
            terminals.source_payload_type_names[terminal_row] ==
                steps.success_payload_type_names[step_row];
    }
    if terminals.roles[terminal_row] == "failure" {
        return terminals.source_variant_indices[terminal_row] ==
                steps.failure_variant_indices[step_row] &&
            terminals.source_variant_names[terminal_row] ==
                steps.failure_variant_names[step_row] &&
            terminals.source_payload_names[terminal_row] ==
                steps.failure_payload_names[step_row] &&
            terminals.source_payload_type_names[terminal_row] ==
                steps.failure_payload_type_names[step_row];
    }
    return false;
}

func MirIntentTerminalTransitionFactsReady(
    ref steps: MirIntentStepTransitionFacts,
    ref rows: MirIntentTerminalTransitionFacts
) -> Bool {
    if !MirIntentTerminalTransitionFactsAligned(rows) { return false; }
    let count: Int = ArrayLength(rows.terminal_transition_ids);
    let row: Int = 0;
    while row < count {
        let step_row: Int = MirIntentStepTransitionIndexByIdentity(
            steps, rows.source_transition_ids[row],
            rows.source_step_syntax_ids[row], rows.source_step_names[row]
        );
        if rows.terminal_transition_ids[row] <= 0 ||
            rows.routine_syntax_ids[row] <= 0 ||
            (rows.roles[row] != "success" && rows.roles[row] != "failure") ||
            step_row < 0 ||
            !MirIntentTerminalSourceMatchesStep(steps, rows, row, step_row) ||
            (rows.roles[row] == "success" &&
                MirIntentStepTransitionHasChild(
                    steps, rows.source_transition_ids[row]
                )) ||
            rows.result_instruction_block_ids[row] < 0 ||
            rows.result_instruction_ids[row] < 0 ||
            rows.result_definition_names[row] == "" ||
            rows.result_type_names[row] == "" ||
            rows.result_type_names[row] == "Unknown" ||
            rows.result_type_names[row] == "Void" ||
            rows.result_enum_names[row] != rows.result_type_names[row] ||
            rows.result_enum_syntax_ids[row] <= 0 ||
            rows.result_variant_indices[row] < 0 ||
            rows.result_variant_names[row] == "" ||
            rows.result_payload_names[row] !=
                rows.source_payload_names[row] ||
            rows.result_payload_type_names[row] !=
                rows.source_payload_type_names[row] ||
            rows.expression_syntax_ids[row] <= 0 ||
            rows.graph_root_ids[row] < 0 || rows.graph_digests[row] <= 0 {
            return false;
        }
        let prior: Int = 0;
        while prior < row {
            if rows.terminal_transition_ids[prior] ==
                    rows.terminal_transition_ids[row] ||
                rows.expression_syntax_ids[prior] ==
                    rows.expression_syntax_ids[row] ||
                rows.result_definition_names[prior] ==
                    rows.result_definition_names[row] ||
                (rows.source_transition_ids[prior] ==
                    rows.source_transition_ids[row] &&
                 rows.roles[prior] == rows.roles[row]) ||
                (rows.result_enum_syntax_ids[prior] ==
                    rows.result_enum_syntax_ids[row] &&
                 rows.result_variant_indices[prior] ==
                    rows.result_variant_indices[row] &&
                 rows.result_variant_names[prior] ==
                    rows.result_variant_names[row]) ||
                (rows.routine_syntax_ids[prior] ==
                    rows.routine_syntax_ids[row] &&
                 (rows.result_type_names[prior] != rows.result_type_names[row] ||
                  rows.result_enum_names[prior] != rows.result_enum_names[row] ||
                  rows.result_enum_syntax_ids[prior] !=
                    rows.result_enum_syntax_ids[row])) {
                return false;
            }
            prior = prior + 1;
        }
        row = row + 1;
    }
    let step_row: Int = 0;
    while step_row < ArrayLength(steps.transition_ids) {
        let failure_count: Int = 0;
        let success_count: Int = 0;
        row = 0;
        while row < count {
            if rows.source_transition_ids[row] ==
                    steps.transition_ids[step_row] {
                if rows.roles[row] == "failure" {
                    failure_count = failure_count + 1;
                } else if rows.roles[row] == "success" {
                    success_count = success_count + 1;
                }
            }
            row = row + 1;
        }
        if failure_count != 1 ||
            (MirIntentStepTransitionHasChild(
                steps, steps.transition_ids[step_row]
             ) && success_count != 0) ||
            (!MirIntentStepTransitionHasChild(
                steps, steps.transition_ids[step_row]
             ) && success_count != 1) {
            return false;
        }
        step_row = step_row + 1;
    }
    return true;
}

func MirIntentExecutionHashString(hash: Long, value: String) -> Long {
    let modulus: Long = 268435456L;
    let out: Long =
        (hash * 131L + (StringLength(value) as Long)) % modulus;
    let i: Int = 0;
    while i < StringLength(value) {
        out = (out * 131L +
            (CharCode(value, StringLength(value), i) as Long)) % modulus;
        i = i + 1;
    }
    return out;
}

func MirIntentExecutionHashInt(hash: Long, value: Int) -> Long {
    return (hash * 131L + ((value + 2) as Long)) % 268435456L;
}

func MirIntentExecutionPlanDigest(
    ref plan: MirIntentExecutionPlan
) -> Int {
    if !plan.valid { return 0; }
    let hash: Long = MirIntentExecutionHashString(71L, plan.schema);
    let step: Int = 0;
    while step < ArrayLength(plan.steps.transition_ids) {
        hash = MirIntentExecutionHashInt(
            hash, plan.steps.transition_ids[step]
        );
        hash = MirIntentExecutionHashInt(
            hash, plan.steps.routine_syntax_ids[step]
        );
        hash = MirIntentExecutionHashString(
            hash, plan.steps.step_names[step]
        );
        hash = MirIntentExecutionHashInt(
            hash, plan.steps.predecessor_transition_ids[step]
        );
        hash = MirIntentExecutionHashString(
            hash, plan.steps.outcome_result_names[step]
        );
        hash = MirIntentExecutionHashString(
            hash, plan.steps.outcome_type_names[step]
        );
        hash = MirIntentExecutionHashInt(
            hash, plan.steps.outcome_enum_syntax_ids[step]
        );
        hash = MirIntentExecutionHashString(
            hash, plan.steps.success_variant_names[step]
        );
        hash = MirIntentExecutionHashString(
            hash, plan.steps.success_payload_type_names[step]
        );
        hash = MirIntentExecutionHashInt(
            hash, plan.steps.success_successor_block_ids[step]
        );
        hash = MirIntentExecutionHashString(
            hash, plan.steps.failure_variant_names[step]
        );
        hash = MirIntentExecutionHashString(
            hash, plan.steps.failure_payload_type_names[step]
        );
        hash = MirIntentExecutionHashInt(
            hash, plan.steps.failure_successor_block_ids[step]
        );
        hash = MirIntentExecutionHashInt(
            hash, plan.steps.completion_instruction_ids[step]
        );
        let compensation: Int = plan.steps.compensation_starts[step];
        let compensation_end: Int = compensation +
            plan.steps.compensation_counts[step];
        while compensation < compensation_end {
            hash = MirIntentExecutionHashInt(
                hash,
                plan.steps.compensations.expression_syntax_ids[compensation]
            );
            hash = MirIntentExecutionHashInt(
                hash, plan.steps.compensations.graph_digests[compensation]
            );
            hash = MirIntentExecutionHashInt(
                hash,
                plan.steps.compensations.call_target_syntax_ids[compensation]
            );
            compensation = compensation + 1;
        }
        step = step + 1;
    }
    let terminal: Int = 0;
    while terminal < ArrayLength(plan.terminals.terminal_transition_ids) {
        hash = MirIntentExecutionHashInt(
            hash, plan.terminals.terminal_transition_ids[terminal]
        );
        hash = MirIntentExecutionHashString(
            hash, plan.terminals.roles[terminal]
        );
        hash = MirIntentExecutionHashInt(
            hash, plan.terminals.source_transition_ids[terminal]
        );
        hash = MirIntentExecutionHashString(
            hash, plan.terminals.source_variant_names[terminal]
        );
        hash = MirIntentExecutionHashString(
            hash, plan.terminals.source_payload_type_names[terminal]
        );
        hash = MirIntentExecutionHashString(
            hash, plan.terminals.result_definition_names[terminal]
        );
        hash = MirIntentExecutionHashString(
            hash, plan.terminals.result_type_names[terminal]
        );
        hash = MirIntentExecutionHashInt(
            hash, plan.terminals.result_enum_syntax_ids[terminal]
        );
        hash = MirIntentExecutionHashString(
            hash, plan.terminals.result_variant_names[terminal]
        );
        hash = MirIntentExecutionHashInt(
            hash, plan.terminals.graph_digests[terminal]
        );
        terminal = terminal + 1;
    }
    return (1073741824L + hash) as Int;
}

func MirIntentExecutionPlanFromFacts(
    steps: MirIntentStepTransitionFacts,
    terminals: MirIntentTerminalTransitionFacts
) -> MirIntentExecutionPlan {
    let present: Bool = ArrayLength(steps.transition_ids) > 0 ||
        ArrayLength(terminals.terminal_transition_ids) > 0;
    let valid: Bool = (!present &&
            MirIntentStepTransitionFactsAligned(steps) &&
            MirIntentTerminalTransitionFactsAligned(terminals)) ||
        (present && ArrayLength(steps.transition_ids) > 0 &&
            MirIntentStepTransitionFactsReady(steps) &&
            MirIntentTerminalTransitionFactsReady(steps, terminals));
    let plan: MirIntentExecutionPlan = MirIntentExecutionPlan(
        valid, present, MirIntentExecutionPlanSchema(), 0, steps, terminals
    );
    if valid { plan.plan_digest = MirIntentExecutionPlanDigest(plan); }
    return plan;
}

func MirIntentExecutionPlanReady(
    ref plan: MirIntentExecutionPlan
) -> Bool {
    if !plan.valid || plan.schema != MirIntentExecutionPlanSchema() ||
        plan.plan_digest <= 0 ||
        plan.plan_digest != MirIntentExecutionPlanDigest(plan) {
        return false;
    }
    if !plan.present {
        return ArrayLength(plan.steps.transition_ids) == 0 &&
            ArrayLength(plan.terminals.terminal_transition_ids) == 0 &&
            MirIntentStepTransitionFactsAligned(plan.steps) &&
            MirIntentTerminalTransitionFactsAligned(plan.terminals);
    }
    return MirIntentStepTransitionFactsReady(plan.steps) &&
        MirIntentTerminalTransitionFactsReady(plan.steps, plan.terminals);
}
