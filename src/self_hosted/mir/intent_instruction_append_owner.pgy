// Canonical scalar attachment for instructions emitted by intent lowering.
import "routine_build_owner.pgy";

func SelfMirIntentAttachBindingSource(
    build: SelfMirRoutineBuild, source_syntax_id: Int
) -> SelfMirRoutineBuild {
    if !build.ok { return build; }
    let row: Int = ArrayLength(build.cfg.instructions.ids) - 1;
    if row < 0 || source_syntax_id <= 0 ||
        (build.cfg.instructions.names[row] != "IntentBinding" &&
         build.cfg.instructions.names[row] != "IntentParticipant" &&
         build.cfg.instructions.names[row] != "IntentValue") {
        return SelfMirRoutineBuildError(build, "MIR Intent binder source identity is missing");
    }
    ArraySet(build.cfg.instructions.binding_source_syntax_ids, row, source_syntax_id);
    return build;
}

func SelfMirIntentAddInstruction(
    build: SelfMirRoutineBuild,
    kind: String,
    name: String,
    arg0: String,
    arg1: String,
    slot_anchor: String,
    expr0: String,
    source_type: String,
    uses: Array<String>
) -> SelfMirRoutineBuild {
    build = SelfMirRoutineAddInstruction(
        build, kind, name, "", arg0, arg1, expr0, "", source_type, uses
    );
    if slot_anchor != "" {
        build = SelfMirRoutineWithCfg(
            build, SelfMirCfgAttachLastSlotAnchor(build.cfg, slot_anchor)
        );
    }
    return build;
}

func SelfMirIntentAddResultInstruction(
    build: SelfMirRoutineBuild,
    kind: String,
    name: String,
    result: String,
    arg0: String,
    arg1: String,
    slot_anchor: String,
    expr0: String,
    source_type: String,
    abi_type_name: String,
    uses: Array<String>
) -> SelfMirRoutineBuild {
    build = SelfMirRoutineAddInstruction(
        build, kind, name, result, arg0, arg1, expr0, "", source_type, uses
    );
    if slot_anchor != "" {
        build = SelfMirRoutineWithCfg(
            build, SelfMirCfgAttachLastSlotAnchor(build.cfg, slot_anchor)
        );
    }
    if abi_type_name != "" {
        build = SelfMirRoutineWithCfg(
            build,
            SelfMirCfgAttachLastAbiTypeName(build.cfg, abi_type_name)
        );
    }
    return build;
}
