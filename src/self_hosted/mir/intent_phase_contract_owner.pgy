// Shared scalar contract for executable intent phase carriers.
//
// DIR owns the clause facts. This owner only fixes their native-compatible
// MIR wire shape before any JSON artifact can be committed.

import "program_fact_owner.pgy";

func SelfMirIntentPhaseIsCheck(phase: String) -> Bool {
    return phase == "success" || phase == "guard" || phase == "expect" || phase == "post" ||
        phase == "pre" || phase == "invariant-pre" || phase == "invariant-post";
}

func SelfMirIntentPhaseIsEvaluation(phase: String) -> Bool {
    return phase == "on" || phase == "intent" || phase == "compensate";
}

func SelfMirIntentTargetPhase(target_kind: String) -> String {
    if target_kind == "action" { return "on"; }
    if target_kind == "intent" { return "intent"; }
    return "";
}

func SelfMirIntentPhaseResultDiagnostic(
    name: String, phase: String, result: String, type_name: String
) -> String {
    let check: Bool = name == "IntentCheck" && SelfMirIntentPhaseIsCheck(phase);
    let evaluation: Bool = name == "IntentEval" && SelfMirIntentPhaseIsEvaluation(phase);
    if !check && !evaluation {
        return "MIR intent phase carrier names an unknown phase";
    }
    if check && (result != "" || type_name != "") {
        return "MIR intent check result/type shape is invalid";
    }
    if phase == "compensate" && (result != "" || type_name != "") {
        return "MIR intent compensate result/type shape is invalid";
    }
    if phase == "intent" && (result != "" || type_name != "") {
        return "MIR intent nested result/type shape is invalid";
    }
    if phase == "on" && ((result == "") != (type_name == "") ||
        type_name == "Unknown" || type_name == "Void") {
        return "MIR intent on result/type shape is invalid";
    }
    return "";
}

func SelfMirIntentPhaseInstructionReady(
    rows: SelfMirInstructionRows,
    index: Int
) -> Bool {
    let name: String = rows.names[index];
    let phase: String = rows.arg0s[index];
    if name != "IntentCheck" && name != "IntentEval" { return false; }
    if rows.arg1s[index] == "" ||
        rows.slot_anchors[index] != rows.arg1s[index] ||
        rows.source_types[index] == "" || rows.expr0s[index] == "" ||
        rows.expr1s[index] != "" ||
        rows.expr0_graphs.has_roots[index] != 1 ||
        rows.expr1_graphs.has_roots[index] != 0 ||
        rows.runtime_call_abi.present[index] != 0 {
        return false;
    }
    return SelfMirIntentPhaseResultDiagnostic(name, phase,
        rows.results[index], rows.abi_type_names[index]) == "";
}
