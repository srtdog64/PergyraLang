// DIR-owned intent priority -> native-compatible MIR declaration carrier.
//
// Absence remains the language default and emits no invented expression.
// Presence carries the admitted graph root once as IntentEval(priority).

import "routine_build_owner.pgy";
import "routine_input_owner.pgy";
import "routine_expression_use_owner.pgy";
import "intent_instruction_append_owner.pgy";
import "intent_phase_emission_owner.pgy";
import "../dir/intent_result_contract_owner.pgy";

func SelfMirIntentAppendPriorityCarrier(
    build: SelfMirRoutineBuild,
    ref input: SelfMirRoutineInput,
    ref intents: SelfDirIntentFacts,
    intent_index: Int
) -> SelfMirRoutineBuild {
    if !build.ok { return build; }
    if intent_index < 0 ||
        intent_index >= ArrayLength(intents.intent_node_ids) ||
        intent_index >= ArrayLength(intents.names) ||
        intent_index >= ArrayLength(intents.priorities.present) ||
        intent_index >= ArrayLength(intents.priorities.node_ids) ||
        intent_index >= ArrayLength(
            intents.priorities.expression_root_ids
        ) {
        return SelfMirRoutineBuildError(
            build, "MIR intent priority owner row is missing"
        );
    }
    if !intents.priorities.present[intent_index] { return build; }
    let node_id: Int = intents.priorities.node_ids[intent_index];
    let admitted_root: Int =
        intents.priorities.expression_root_ids[intent_index];
    let text: String = SelfMirIntentExpressionText(
        input.analysis.expression_surfaces, node_id
    );
    let graph: SemanticExpressionGraphView =
        SemanticAstExpressionGraphForNode(
            input.analysis.expression_surfaces, node_id,
            AstExpressionLaneAtom()
        );
    if text == "" || !graph.ok || graph.root_id != admitted_root {
        return SelfMirRoutineBuildError(
            build, "MIR intent priority expression graph is missing"
        );
    }
    let source_type: String = SelfMirIntentExpressionSourceType(graph, text);
    if source_type == "" {
        return SelfMirRoutineBuildError(
            build, "MIR intent priority expression type is missing"
        );
    }
    let intent_name: String = intents.names[intent_index];
    if intent_name == "" {
        return SelfMirRoutineBuildError(
            build, "MIR intent priority identity is missing"
        );
    }
    let uses: Array<String> = SelfMirExpressionGraphUses(build, graph);
    build = SelfMirIntentAddInstruction(
        build, "stmt", "IntentEval", "priority", intent_name,
        intent_name, text, source_type, uses
    );
    return SelfMirRoutineAttachLastExpressionGraph(
        build, graph, input.machine_declaration
    );
}

func SelfMirIntentPriorityInstructionReady(
    rows: SelfMirInstructionRows,
    index: Int
) -> Bool {
    return rows.kinds[index] == "stmt" &&
        rows.names[index] == "IntentEval" &&
        rows.results[index] == "" &&
        rows.arg0s[index] == "priority" &&
        rows.arg1s[index] != "" &&
        rows.slot_anchors[index] == rows.arg1s[index] &&
        rows.abi_type_names[index] == "" &&
        rows.source_types[index] != "" &&
        rows.expr0s[index] != "" && rows.expr1s[index] == "" &&
        rows.expr0_graphs.has_roots[index] == 1 &&
        rows.expr1_graphs.has_roots[index] == 0 &&
        rows.runtime_call_abi.present[index] == 0;
}
