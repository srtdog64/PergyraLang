// pgy.mir.v1 JSON projection from verified self-host MIR fact rows.

import "program_verify_owner.pgy";
import "expression_graph_kind_name_owner.pgy";
import "match_json_projection_owner.pgy";
import "destructure_json_projection_owner.pgy";
import "destructure_type_json_projection_owner.pgy";
import "generic_specialization_json_projection_owner.pgy";
import "runtime_call_abi_json_projection_owner.pgy";
import "abi_layout_json_projection_owner.pgy";
import "machine_layer_json_projection_owner.pgy";
import "json_projection_support_owner.pgy";
import "../lib/json_emit.pgy";

func SelfMirJsonExpressionGraph(
    rows: SelfMirExpressionGraphRows,
    instruction_index: Int
) -> String {
    if instruction_index < 0 ||
        instruction_index >= ArrayLength(rows.has_roots) ||
        rows.has_roots[instruction_index] != 1 {
        return "null";
    }
    let start: Int = rows.node_starts[instruction_index];
    let count: Int = rows.node_counts[instruction_index];
    let nodes: Array<String> = [];
    let i: Int = 0;
    while i < count {
        let node: Int = start + i;
        let kind: Int = rows.node_kinds[node];
        let fields: Array<String> = [
            JsonEmitFieldString(
                "kind", SelfMirExpressionGraphKindName(kind)
            ),
            JsonEmitFieldString("text", rows.node_texts[node]),
            JsonEmitFieldString(
                "call_target_kind",
                SelfMirExpressionCallTargetKindName(
                    rows.call_target_kinds[node]
                )
            ),
            JsonEmitFieldString(
                "call_target_name", rows.call_target_names[node]
            )
        ];
        let arity: Int = AstExpressionNodeArity(kind);
        if arity == 0 {
            ArrayPush(fields, JsonEmitFieldRaw("left", "null"));
            ArrayPush(fields, JsonEmitFieldRaw("right", "null"));
        } else if arity == 1 {
            ArrayPush(fields, JsonEmitFieldNumber(
                "left", ToString(rows.left_children[node] - start)
            ));
            ArrayPush(fields, JsonEmitFieldRaw("right", "null"));
        } else {
            ArrayPush(fields, JsonEmitFieldNumber(
                "left", ToString(rows.left_children[node] - start)
            ));
            ArrayPush(fields, JsonEmitFieldNumber(
                "right", ToString(rows.right_children[node] - start)
            ));
        }
        ArrayPush(nodes, JsonEmitObject(fields));
        i = i + 1;
    }
    return JsonEmitObject([
        JsonEmitFieldNumber(
            "root", ToString(rows.roots[instruction_index] - start)
        ),
        JsonEmitFieldRaw("nodes", JsonEmitArray(nodes))
    ]);
}

func SelfMirJsonInstruction(
    facts: SelfMirProgramFacts,
    instruction_index: Int
) -> String {
    let rows: SelfMirInstructionRows = facts.cfg.instructions;
    let uses: Array<String> = [];
    let use_i: Int = 0;
    while use_i < rows.use_counts[instruction_index] {
        ArrayPush(
            uses,
            JsonStringLiteral(
                rows.uses[rows.use_starts[instruction_index] + use_i]
            )
        );
        use_i = use_i + 1;
    }
    let match_fields: SelfMirMatchJsonFields =
        SelfMirMatchJsonFieldsForInstruction(rows, instruction_index);
    let abi_type_name: String = SelfMirJsonAbiTypeName(
        rows, instruction_index);
    let machine: SelfMirMachineLayerProjection =
        SelfMirMachineLayerProjection(
            true,
            rows.machine_contact_kinds[instruction_index],
            rows.machine_layer_manifest_ids[instruction_index],
            rows.machine_layer_physical_grant_ids[instruction_index],
            rows.machine_layer_physical_bases[instruction_index],
            rows.machine_layer_physical_sizes[instruction_index],
            rows.machine_layer_physical_modes[instruction_index],
            rows.machine_layer_runtime_operations[instruction_index],
            rows.machine_layer_hardware_adequate[instruction_index],
            rows.machine_layer_authority_required[instruction_index],
            rows.machine_layer_live_lease_required[instruction_index]
        );
    // Static rows are producer-owned for the fixed ABI subset.  Unknown
    // and target-dependent rows retain the explicit dynamic tuple; that
    // form is a declared fact, not a backend lookup permission.
    let abi_layout: String = SelfMirJsonStaticAbiLayout(abi_type_name);
    let abi_layout_required: Bool = StringLength(abi_layout) > 0;
    let abi_layout_id: String = SelfMirJsonAbiLayoutId(abi_layout);
    let abi_layout_wire: String = "null";
    if abi_layout_required {
        abi_layout_wire = abi_layout;
    }
    let fields: Array<String> = [
        JsonEmitFieldNumber("id", ToString(rows.ids[instruction_index])),
        JsonEmitFieldString("kind", rows.kinds[instruction_index]),
        JsonEmitFieldString("name", rows.names[instruction_index]),
        JsonEmitFieldRaw(
            "result", SelfMirJsonOptionalString(
                SelfMirOptionalString(rows.results[instruction_index])
            )
        ),
        JsonEmitFieldRaw(
            "arg0", SelfMirJsonOptionalString(
                SelfMirOptionalString(rows.arg0s[instruction_index])
            )
        ),
        JsonEmitFieldRaw(
            "arg1", SelfMirJsonOptionalString(
                SelfMirOptionalString(rows.arg1s[instruction_index])
            )
        ),
        JsonEmitFieldRaw(
            "abi_type_name", SelfMirJsonOptionalString(
                SelfMirOptionalString(abi_type_name)
            )
        ),
        JsonEmitFieldNumber("abi_layout_id", abi_layout_id),
        JsonEmitFieldBool("abi_layout_required", abi_layout_required),
        JsonEmitFieldRaw("abi_layout", abi_layout_wire),
        JsonEmitFieldRaw(
            "expr0", SelfMirJsonOptionalString(
                SelfMirOptionalString(rows.expr0s[instruction_index])
            )
        ),
        JsonEmitFieldRaw(
            "expr0_graph", SelfMirJsonExpressionGraph(
                rows.expr0_graphs, instruction_index
            )
        ),
        JsonEmitFieldRaw(
            "expr1", SelfMirJsonOptionalString(
                SelfMirOptionalString(rows.expr1s[instruction_index])
            )
        ),
        JsonEmitFieldRaw(
            "expr1_graph", SelfMirJsonExpressionGraph(
                rows.expr1_graphs, instruction_index
            )
        ),
        JsonEmitFieldRaw(
            "source_type",
            SelfMirJsonOptionalString(
                SelfMirOptionalString(rows.source_types[instruction_index])
            )
        ),
        JsonEmitFieldString(
            "machine_contact_kind", machine.contact_kind
        ),
        JsonEmitFieldRaw(
            "machine_layer",
            SelfMirJsonMachineLayer(machine)
        ),
        JsonEmitFieldRaw("match_patterns", match_fields.patterns),
        JsonEmitFieldRaw("match_variant", match_fields.variant),
        JsonEmitFieldRaw("match_bindings", match_fields.bindings),
        JsonEmitFieldRaw(
            "match_binding_types", match_fields.binding_types
        ),
        JsonEmitFieldRaw(
            "destructure_element_type",
            SelfMirJsonDestructureElementType(rows, instruction_index)
        ),
        JsonEmitFieldRaw(
            "destructure_bindings",
            SelfMirJsonDestructureBindings(rows, instruction_index)
        ),
        JsonEmitFieldRaw("uses", JsonEmitArray(uses))
    ];
    SelfMirJsonAppendRuntimeCallAbiFields(rows, instruction_index, fields);
    return JsonEmitObject(fields);
}

func SelfMirJsonBlock(
    facts: SelfMirProgramFacts,
    block_index: Int
) -> String {
    let blocks: SelfMirBlockRows = facts.cfg.blocks;
    let instructions: Array<String> = [];
    let i: Int = 0;
    while i < blocks.instruction_counts[block_index] {
        ArrayPush(
            instructions,
            SelfMirJsonInstruction(
                facts, blocks.instruction_starts[block_index] + i
            )
        );
        i = i + 1;
    }
    let fields: Array<String> = [
        JsonEmitFieldNumber("id", ToString(blocks.ids[block_index])),
        JsonEmitFieldBool("reachable", blocks.reachable[block_index] == 1),
        JsonEmitFieldRaw("instructions", JsonEmitArray(instructions))
    ];
    if blocks.has_succ_true[block_index] == 1 {
        ArrayPush(
            fields,
            JsonEmitFieldNumber(
                "succ_true", ToString(blocks.succ_true[block_index])
            )
        );
    }
    if blocks.has_succ_false[block_index] == 1 {
        ArrayPush(
            fields,
            JsonEmitFieldNumber(
                "succ_false", ToString(blocks.succ_false[block_index])
            )
        );
    }
    return JsonEmitObject(fields);
}

func SelfMirJsonRoutine(
    facts: SelfMirProgramFacts,
    routine_index: Int
) -> String {
    let rows: SelfMirRoutineRows = facts.routines;
    let generics: Array<String> = [];
    let generic_i: Int = 0;
    while generic_i < rows.generic_counts[routine_index] {
        let generic_row: Int = rows.generic_starts[routine_index] + generic_i;
        ArrayPush(generics, JsonStringLiteral(rows.generic_names[generic_row]));
        generic_i = generic_i + 1;
    }
    let params: Array<String> = [];
    let param_i: Int = 0;
    while param_i < rows.param_counts[routine_index] {
        let row: Int = rows.param_starts[routine_index] + param_i;
        let fields: Array<String> = [
            JsonEmitFieldString("name", rows.param_names[row]),
            JsonEmitFieldRaw(
                "type",
                SelfMirJsonOptionalString(
                    SelfMirOptionalString(rows.param_types[row])
                )
            ),
            JsonEmitFieldString(
                "carriage", SelfMirParamCarriageName(rows.param_abi_kinds[row])
            ),
            JsonEmitFieldString(
                "resource",
                SelfMirParamResourceKindName(rows.param_resource_kinds[row])
            ),
            JsonEmitFieldString(
                "pass", SelfMirParamPassName(rows.param_abi_kinds[row])
            )
        ];
        ArrayPush(params, JsonEmitObject(fields));
        param_i = param_i + 1;
    }
    let blocks: Array<String> = [];
    let block_i: Int = 0;
    while block_i < rows.block_counts[routine_index] {
        ArrayPush(
            blocks,
            SelfMirJsonBlock(
                facts, rows.block_starts[routine_index] + block_i
            )
        );
        block_i = block_i + 1;
    }
    let locals: Array<String> = [];
    let local_i: Int = 0;
    while local_i < rows.local_counts[routine_index] {
        let row2: Int = rows.local_starts[routine_index] + local_i;
        let fields2: Array<String> = [
            JsonEmitFieldString("name", rows.local_names[row2]),
            JsonEmitFieldString("type", rows.local_types[row2])
        ];
        ArrayPush(locals, JsonEmitObject(fields2));
        local_i = local_i + 1;
    }
    // The self-host MIR producer does not own native semantic
    // ResourceFlowUniverse rows.  It still emits the schema's explicit empty
    // projection so consumers never infer absence or recover rows from text.
    let resource_flow_symbols: Array<String> = [];
    let loop_flow_summaries: Array<String> = [];
    let loop_rows: SelfMirLoopFlowRows = rows.loop_flows;
    let summary_start: Int = loop_rows.routine_starts[routine_index];
    let summary_i: Int = 0;
    while summary_i < loop_rows.routine_counts[routine_index] {
        let summary_row: Int = summary_start + summary_i;
        let summary_kind: String = "while";
        if loop_rows.summaries.kinds[summary_row] == 1 {
            summary_kind = "for";
        }
        ArrayPush(loop_flow_summaries, JsonEmitObject([
            JsonEmitFieldNumber(
                "loop_syntax_id",
                ToString(loop_rows.summaries.loop_node_ids[summary_row])
            ),
            JsonEmitFieldString("kind", summary_kind),
            JsonEmitFieldNumber(
                "effect_base",
                ToString(loop_rows.summaries.effect_bases[summary_row])
            ),
            JsonEmitFieldNumber(
                "effect_delta",
                ToString(loop_rows.summaries.effect_deltas[summary_row])
            ),
            JsonEmitFieldNumber(
                "flags", ToString(loop_rows.summaries.flags[summary_row])
            ),
            JsonEmitFieldNumber(
                "entry_state_start",
                ToString(loop_rows.summaries.entry_state_starts[summary_row])
            ),
            JsonEmitFieldNumber(
                "entry_state_count",
                ToString(loop_rows.summaries.entry_state_counts[summary_row])
            ),
            JsonEmitFieldNumber(
                "exit_state_start",
                ToString(loop_rows.summaries.exit_state_starts[summary_row])
            ),
            JsonEmitFieldNumber(
                "exit_state_count",
                ToString(loop_rows.summaries.exit_state_counts[summary_row])
            )
        ]));
        summary_i = summary_i + 1;
    }
    let loop_flow_states: Array<String> = [];
    let state_i: Int = 0;
    while state_i < ArrayLength(loop_rows.states.stable_indices) {
        ArrayPush(loop_flow_states, JsonEmitObject([
            JsonEmitFieldNumber(
                "stable_index", ToString(loop_rows.states.stable_indices[state_i])
            ),
            JsonEmitFieldBool(
                "is_consumed", loop_rows.states.consumed_flags[state_i] == 1
            ),
            JsonEmitFieldBool(
                "is_used", loop_rows.states.used_flags[state_i] == 1
            ),
            JsonEmitFieldNumber(
                "access_mask", ToString(loop_rows.states.access_masks[state_i])
            ),
            JsonEmitFieldNumber(
                "slot_state", ToString(loop_rows.states.slot_states[state_i])
            ),
            JsonEmitFieldNumber(
                "semantic_state",
                ToString(loop_rows.states.semantic_states[state_i])
            ),
            JsonEmitFieldNumber(
                "pool_id", ToString(loop_rows.states.pool_ids[state_i])
            )
        ]));
        state_i = state_i + 1;
    }
    let iteration_type_facts: Array<String> = [];
    let iteration_start: Int = rows.iteration_starts[routine_index];
    let iteration_i: Int = 0;
    while iteration_i < rows.iteration_counts[routine_index] {
        let iteration_row: Int = iteration_start + iteration_i;
        ArrayPush(
            iteration_type_facts,
            JsonEmitObject([
                JsonEmitFieldNumber(
                    "function_syntax_id",
                    ToString(rows.node_ids[routine_index])
                ),
                JsonEmitFieldNumber(
                    "iteration_syntax_id",
                    ToString(rows.iteration_node_ids[iteration_row])
                ),
                JsonEmitFieldString(
                    "binding_type",
                    rows.iteration_binding_types[iteration_row]
                ),
                JsonEmitFieldString(
                    "iterable_type",
                    rows.iteration_iterable_types[iteration_row]
                ),
                JsonEmitFieldBool(
                    "collection_hoisted",
                    rows.iteration_collection_hoists[iteration_row] == 1
                )
            ])
        );
        iteration_i = iteration_i + 1;
    }
    let fields3: Array<String> = [
        JsonEmitFieldString("name", rows.names[routine_index]),
        JsonEmitFieldString("kind", rows.kinds[routine_index])
    ];
    if rows.owners[routine_index] != "" {
        ArrayPush(fields3, JsonEmitFieldString("owner", rows.owners[routine_index]));
    }
    ArrayPush(fields3, JsonEmitFieldRaw("generics", JsonEmitArray(generics)));
    ArrayPush(fields3, JsonEmitFieldRaw("params", JsonEmitArray(params)));
    ArrayPush(fields3, JsonEmitFieldString("return", rows.return_types[routine_index]));
    ArrayPush(fields3, JsonEmitFieldNumber(
        "resource_flow_symbol_count", ToString(0)
    ));
    ArrayPush(fields3, JsonEmitFieldRaw(
        "resource_flow_symbols", JsonEmitArray(resource_flow_symbols)
    ));
    ArrayPush(fields3, JsonEmitFieldNumber(
        "loop_flow_summary_count", ToString(ArrayLength(loop_flow_summaries))
    ));
    ArrayPush(fields3, JsonEmitFieldRaw(
        "loop_flow_summaries", JsonEmitArray(loop_flow_summaries)
    ));
    ArrayPush(fields3, JsonEmitFieldNumber(
        "loop_flow_state_count", ToString(ArrayLength(loop_flow_states))
    ));
    ArrayPush(fields3, JsonEmitFieldRaw(
        "loop_flow_states", JsonEmitArray(loop_flow_states)
    ));
    ArrayPush(fields3, JsonEmitFieldNumber(
        "iteration_type_fact_count",
        ToString(rows.iteration_counts[routine_index])
    ));
    ArrayPush(fields3, JsonEmitFieldRaw(
        "iteration_type_facts", JsonEmitArray(iteration_type_facts)
    ));
    ArrayPush(fields3, JsonEmitFieldNumber("destructure_type_fact_count", ToString(rows.destructure_type_facts.routine_counts[routine_index])));
    ArrayPush(fields3, JsonEmitFieldRaw("destructure_type_facts", SelfMirJsonDestructureTypeFacts(rows, routine_index)));
    ArrayPush(fields3, JsonEmitFieldRaw("blocks", JsonEmitArray(blocks)));
    ArrayPush(fields3, JsonEmitFieldRaw("source_locals", JsonEmitArray(locals)));
    return JsonEmitObject(fields3);
}

func SelfMirJsonDeclaration(
    facts: SelfMirProgramFacts,
    declaration_index: Int
) -> String {
    let rows: SelfMirDeclarationRows = facts.declarations;
    let fields_rows: Array<String> = [];
    let field_i: Int = 0;
    while field_i < rows.field_counts[declaration_index] {
        let row: Int = rows.field_starts[declaration_index] + field_i;
        let field: Array<String> = [
            JsonEmitFieldString("name", rows.field_names[row]),
            JsonEmitFieldString("type", rows.field_types[row])
        ];
        ArrayPush(fields_rows, JsonEmitObject(field));
        field_i = field_i + 1;
    }
    let methods: Array<String> = [];
    let method_i: Int = 0;
    while method_i < rows.method_counts[declaration_index] {
        let row2: Int = rows.method_starts[declaration_index] + method_i;
        let method: Array<String> = [
            JsonEmitFieldString("name", rows.method_names[row2]),
            JsonEmitFieldString("return", rows.method_returns[row2])
        ];
        ArrayPush(methods, JsonEmitObject(method));
        method_i = method_i + 1;
    }
    let variants: Array<String> = [];
    let variant_i: Int = 0;
    while variant_i < rows.variant_counts[declaration_index] {
        let variant_row: Int =
            rows.variant_starts[declaration_index] + variant_i;
        let variant: Array<String> = [
            JsonEmitFieldString("name", rows.variant_names[variant_row]),
            JsonEmitFieldNumber(
                "param_count",
                ToString(rows.variant_param_counts[variant_row])
            )
        ];
        ArrayPush(variants, JsonEmitObject(variant));
        variant_i = variant_i + 1;
    }
    let fields: Array<String> = [
        JsonEmitFieldString("kind", rows.kinds[declaration_index]),
        JsonEmitFieldString(
            "nominal_kind", rows.nominal_kinds[declaration_index]
        ),
        JsonEmitFieldString("name", rows.names[declaration_index]),
        JsonEmitFieldRaw("fields", JsonEmitArray(fields_rows)),
        JsonEmitFieldRaw("methods", JsonEmitArray(methods))
    ];
    if rows.kinds[declaration_index] == "role" {
        ArrayPush(fields, JsonEmitFieldString(
            "for_type", rows.target_types[declaration_index]
        ));
    }
    if rows.kinds[declaration_index] == "enum" {
        ArrayPush(fields, JsonEmitFieldRaw("variants", JsonEmitArray(variants)));
    }
    return JsonEmitObject(fields);
}

func SelfMirJsonParallelCaptureBoundary(
    rows: SelfMirParallelCaptureRows,
    boundary_index: Int
) -> String {
    let captures: Array<String> = [];
    let i: Int = 0;
    while i < rows.row_counts[boundary_index] {
        let row: Int = rows.row_starts[boundary_index] + i;
        ArrayPush(captures, JsonEmitObject([
            JsonEmitFieldString("name", rows.names[row]),
            JsonEmitFieldString("kind", rows.kinds[row]),
            JsonEmitFieldNumber(
                "writer_task", ToString(rows.writer_tasks[row])
            )
        ]));
        i = i + 1;
    }
    return JsonEmitObject([
        JsonEmitFieldNumber(
            "source_stable_id",
            ToString(rows.source_stable_ids[boundary_index])
        ),
        JsonEmitFieldNumber(
            "task_count", ToString(rows.task_counts[boundary_index])
        ),
        JsonEmitFieldBool("sealed", rows.sealed[boundary_index] == 1),
        JsonEmitFieldRaw("rows", JsonEmitArray(captures))
    ]);
}

func SelfMirProgramJson(facts: SelfMirProgramFacts) -> String {
    if !SelfMirProgramFactsReady(facts) {
        return "";
    }
    let declarations: Array<String> = [];
    let i: Int = 0;
    while i < ArrayLength(facts.declarations.names) {
        ArrayPush(declarations, SelfMirJsonDeclaration(facts, i));
        i = i + 1;
    }
    let routines: Array<String> = [];
    let r: Int = 0;
    while r < ArrayLength(facts.routines.names) {
        ArrayPush(routines, SelfMirJsonRoutine(facts, r));
        r = r + 1;
    }
    let parallel_captures: Array<String> = [];
    let capture_i: Int = 0;
    while capture_i < ArrayLength(facts.parallel_captures.source_stable_ids) {
        ArrayPush(
            parallel_captures,
            SelfMirJsonParallelCaptureBoundary(
                facts.parallel_captures, capture_i
            )
        );
        capture_i = capture_i + 1;
    }
    let generic_specializations: Array<String> =
        SelfMirJsonGenericSpecializations(
            facts.generic_specializations
        );
    return JsonEmitObject([
        JsonEmitFieldString("schema", "pgy.mir.v1"),
        JsonEmitFieldRaw("decls", JsonEmitArray(declarations)),
        JsonEmitFieldRaw(
            "generic_method_specializations",
            JsonEmitArray(generic_specializations)
        ),
        JsonEmitFieldRaw(
            "parallel_capture_boundaries", JsonEmitArray(parallel_captures)
        ),
        JsonEmitFieldRaw("routines", JsonEmitArray(routines))
    ]);
}
