// Shared optional-value JSON projection for self-host MIR facts.

import "../lib/json_emit.pgy";

func SelfMirOptionalString(value: String) -> Option<String> {
    if value == "" { return None; }
    return Some(value);
}

func SelfMirJsonOptionalString(value: Option<String>) -> String {
    if !IsSome(value) { return "null"; }
    return JsonStringLiteral(UnwrapOption(value));
}

func SelfMirJsonTextArrayWireLength(items: Array<String>) -> Int {
    let length: Int = 2;
    let i: Int = 0;
    while i < ArrayLength(items) {
        length = length + StringLength(items[i]);
        if i > 0 { length = length + 1; }
        i = i + 1;
    }
    return length;
}
