// Stable lexical LocalRef facts carried beside MIR instructions.

import "../semantic/ast_expression_graph_fact_owner.pgy";
import "expression_graph_fact_owner.pgy";
import "local_ref_identity_owner.pgy";
import "../semantic/ast_expression_graph_node_view_owner.pgy";

struct SelfMirInstructionLocalRefRows {
    primary_refs: Array<String>;
    source_statement_syntax_ids: Array<Int>;
    expr0_starts: Array<Int>;
    expr0_counts: Array<Int>;
    expr0_nodes: Array<Int>;
    expr0_refs: Array<String>;
}
func SelfMirInstructionLocalRefRowsEmpty(
) -> SelfMirInstructionLocalRefRows {
    let primary: Array<String> = [];
    let statement_ids: Array<Int> = [];
    let starts: Array<Int> = [];
    let counts: Array<Int> = [];
    let nodes: Array<Int> = [];
    let refs: Array<String> = [];
    return SelfMirInstructionLocalRefRows(
        primary, statement_ids, starts, counts, nodes, refs
    );
}
func SelfMirInstructionLocalRefRowsAppendInstruction(
    rows: SelfMirInstructionLocalRefRows
) -> SelfMirInstructionLocalRefRows {
    ArrayPushOwnedString(rows.primary_refs, "");
    ArrayPush(rows.source_statement_syntax_ids, 0);
    ArrayPush(rows.expr0_starts, ArrayLength(rows.expr0_nodes));
    ArrayPush(rows.expr0_counts, 0);
    return rows;
}

func SelfMirInstructionLocalRefRowsAttachPrimary(
    rows: SelfMirInstructionLocalRefRows,
    local_ref: String
) -> SelfMirInstructionLocalRefRows {
    let index: Int = ArrayLength(rows.primary_refs) - 1;
    if index < 0 || local_ref == "" || rows.primary_refs[index] != "" {
        return rows;
    }
    ArraySet(rows.primary_refs, index, Concat("", local_ref));
    return rows;
}

func SelfMirInstructionLocalRefRowsAttachExpr0(
    rows: SelfMirInstructionLocalRefRows,
    view: SemanticExpressionGraphView,
    ref local_names: Array<String>,
    ref local_versions: Array<Int>,
    ref local_refs: Array<String>
) -> SelfMirInstructionLocalRefRows {
    let instruction: Int = ArrayLength(rows.primary_refs) - 1;
    if instruction < 0 || !view.ok ||
        ArrayLength(local_names) != ArrayLength(local_versions) ||
        ArrayLength(local_names) != ArrayLength(local_refs) ||
        rows.expr0_counts[instruction] != 0 {
        return rows;
    }
    let start_opt: Option<Int> = SemanticExpressionGraphSubtreeStart(
        view.graph, view.root_id
    );
    if !IsSome(start_opt) { return rows; }
    let start: Int = UnwrapOption(start_opt);
    var node: Int = start;
    while node <= view.root_id {
        let kind: Option<Int> = SemanticExpressionGraphNodeKind(
            view.graph, node
        );
        let text: Option<String> = SemanticExpressionGraphNodeText(
            view.graph, node
        );
        if IsSome(kind) && IsSome(text) &&
            UnwrapOption(kind) == AstExpressionNodeLeaf() {
            var local_binding: Int = ArrayLength(local_names) - 1;
            while local_binding >= 0 {
                if local_names[local_binding] == UnwrapOption(text) {
                    if local_versions[local_binding] == 0 && local_refs[local_binding] != "" {
                        ArrayPush(rows.expr0_nodes, node - start);
                        // LocalRef rows survive the source binding inventory.
                        ArrayPushOwnedString(rows.expr0_refs, local_refs[local_binding]);
                    }
                    break;
                }
                local_binding = local_binding - 1;
            }
        }
        node = node + 1;
    }
    ArraySet(rows.expr0_counts, instruction, ArrayLength(rows.expr0_nodes) - rows.expr0_starts[instruction]);
    return rows;
}

func SelfMirInstructionLocalRefRowsAppendRows(
    target: SelfMirInstructionLocalRefRows,
    ref source: SelfMirInstructionLocalRefRows
) -> SelfMirInstructionLocalRefRows {
    var row: Int = 0;
    while row < ArrayLength(source.primary_refs) {
        ArrayPushOwnedString(target.primary_refs, source.primary_refs[row]);
        ArrayPush(target.source_statement_syntax_ids, source.source_statement_syntax_ids[row]);
        ArrayPush(target.expr0_starts, ArrayLength(target.expr0_nodes));
        ArrayPush(target.expr0_counts, source.expr0_counts[row]);
        var use_entry: Int = 0;
        while use_entry < source.expr0_counts[row] {
            let source_use: Int = source.expr0_starts[row] + use_entry;
            ArrayPush(target.expr0_nodes, source.expr0_nodes[source_use]);
            ArrayPushOwnedString(target.expr0_refs, source.expr0_refs[source_use]);
            use_entry = use_entry + 1;
        }
        row = row + 1;
    }
    return target;
}
