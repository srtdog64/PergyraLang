// JSON field projection for instruction-keyed MIR match facts.

import "program_fact_owner.pgy";
import "../lib/json_emit.pgy";

struct SelfMirMatchJsonFields {
    patterns: String;
    variant: String;
    bindings: String;
    binding_types: String;
    // Raw JSON for match_subject_family; "" on rows that are not match cases.
    subject_family: String;
}

func SelfMirMatchJsonFieldsForInstruction(
    rows: SelfMirInstructionRows,
    instruction_index: Int
) -> SelfMirMatchJsonFields {
    let patterns: Array<String> = [];
    let bindings: Array<String> = [];
    let binding_types: Array<String> = [];
    let variant: String = "null";
    let subject_family: String = "";
    let fact_index: Option<Int> = SelfMirMatchFactIndexForInstruction(
        rows.match_facts, instruction_index
    );
    if IsSome(fact_index) {
        let row: Int = UnwrapOption(fact_index);
        let pattern_i: Int = 0;
        while pattern_i < rows.match_facts.pattern_counts[row] {
            ArrayPush(
                patterns,
                JsonStringLiteral(
                    rows.match_facts.patterns[
                        rows.match_facts.pattern_starts[row] + pattern_i
                    ]
                )
            );
            pattern_i = pattern_i + 1;
        }
        let binding_i: Int = 0;
        while binding_i < rows.match_facts.binding_counts[row] {
            ArrayPush(
                bindings,
                JsonStringLiteral(
                    rows.match_facts.bindings[
                        rows.match_facts.binding_starts[row] + binding_i
                    ]
                )
            );
            ArrayPush(
                binding_types,
                JsonStringLiteral(
                    rows.match_facts.binding_types[
                        rows.match_facts.binding_starts[row] + binding_i
                    ]
                )
            );
            binding_i = binding_i + 1;
        }
        subject_family = "null";
        if rows.match_facts.subject_families[row] != "" {
            subject_family = JsonStringLiteral(rows.match_facts.subject_families[row]);
        }
        if rows.match_facts.variants[row] != "" {
            variant = JsonStringLiteral(rows.match_facts.variants[row]);
        }
    }
    return SelfMirMatchJsonFields(
        JsonEmitArray(patterns), variant, JsonEmitArray(bindings),
        JsonEmitArray(binding_types), subject_family
    );
}
