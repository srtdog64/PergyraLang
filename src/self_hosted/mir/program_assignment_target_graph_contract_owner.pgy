// Assignment-target graph contract owner.
//
// This bounded fixture owns the positive and malformed row proof for the
// instruction validator; the production verifier consumes that validator and
// does not duplicate fixture construction.
import "program_fact_owner.pgy";
import "instruction_validation_owner.pgy";

func SelfMirInstructionRowsReady(
    rows: SelfMirInstructionRows,
    ref graph: SemanticExpressionGraphFacts
) -> Bool {
    return SelfMirInstructionRowsValidationError(rows, graph) == "";
}

func SelfMirAssignmentTargetGraphContractReady() -> Bool {
    let no_uses: Array<String> = [];
    let value_graph: SelfMirExpressionGraphContractFixture = SelfMirExpressionGraphContractFixtureFromLegacy(
            [1], [0], [0], [1], [AstExpressionNodeLeaf()], ["values[j]"],
            [0], [0], [SemanticCallTargetNone()], [""]
        );
    let target_graph: SelfMirExpressionGraphContractFixture = SelfMirExpressionGraphContractFixtureFromLegacy(
            [1], [2], [0], [3],
            [AstExpressionNodeLeaf(), AstExpressionNodeLeaf(),
             AstExpressionNodeIndex()],
            ["values", "i", "values[i]"], [0, 0, 0], [0, 0, 1],
            [SemanticCallTargetNone(), SemanticCallTargetNone(),
            SemanticCallTargetNone()], ["", "", ""]
        );
    let simple_value_graph: SelfMirExpressionGraphContractFixture = SelfMirExpressionGraphContractFixtureFromLegacy(
            [1], [0], [0], [1], [AstExpressionNodeLeaf()], ["1"],
            [0], [0], [SemanticCallTargetNone()], [""]
        );
    let simple_target_graph: SelfMirExpressionGraphContractFixture = SelfMirExpressionGraphContractFixtureFromLegacy(
            [1], [0], [0], [1], [AstExpressionNodeLeaf()], ["x"],
            [0], [0], [SemanticCallTargetNone()], [""]
        );
    let no_match_facts: SelfMirMatchFactRows = SelfMirMatchFactRowsEmpty();
    let no_destructure_facts: SelfMirDestructureFactRows = SelfMirDestructureFactRowsEmpty();
    let no_abi_type_names: Array<String> = [""];
    let no_runtime_call_abi: SelfMirRuntimeCallAbiRows = SelfMirRuntimeCallAbiRowsForInstructionCount(1);
    let member_target_graph: SelfMirExpressionGraphContractFixture = SelfMirExpressionGraphContractFixtureFromLegacy(
            [1], [2], [0], [3],
            [AstExpressionNodeLeaf(), AstExpressionNodeLeaf(),
             AstExpressionNodeMemberAccess()],
            ["base", "text", "base.text"], [0, 0, 0], [0, 0, 1],
            [SemanticCallTargetNone(), SemanticCallTargetNone(),
             SemanticCallTargetNone()], ["", "", ""]
        );
    let valid: SelfMirInstructionRows = SelfMirInstructionRows(
        [0], ["def"], ["ssa-def"], ["values.2"], ["values"], [""], [""],
        ["values[j]"], ["values[i]"], ["AST_ASSIGNMENT"],
        [""], [""], [""], [0], [0], [""], [""], [0], [0], [0], [0], [3],
        ["values.1", "i.1", "j.1"],
        value_graph.rows, target_graph.rows, no_match_facts, no_destructure_facts,
        no_abi_type_names, no_runtime_call_abi, [0]
    );
    let valid_simple: SelfMirInstructionRows = SelfMirInstructionRows(
        [0], ["def"], ["ssa-def"], ["x.2"], ["x"], [""], [""],
        ["1"], ["x"], ["AST_ASSIGNMENT"],
        [""], [""], [""], [0], [0], [""], [""], [0], [0], [0],
        [0], [0], no_uses,
        simple_value_graph.rows, simple_target_graph.rows, no_match_facts,
        no_destructure_facts, no_abi_type_names, no_runtime_call_abi, [0]
    );
    let valid_member: SelfMirInstructionRows = SelfMirInstructionRows(
        [0], ["def"], ["ssa-def"], ["base.2"], ["base"], [""], [""],
        ["1"], ["base.text"], ["AST_ASSIGNMENT"],
        [""], [""], [""], [0], [0], [""], [""], [0], [0], [0],
        [0], [1], ["base.1"], simple_value_graph.rows, member_target_graph.rows,
        no_match_facts, no_destructure_facts, no_abi_type_names,
        no_runtime_call_abi, [0]
    );
    let missing_base_use: SelfMirInstructionRows = SelfMirInstructionRows(
        [0], ["def"], ["ssa-def"], ["values.2"], ["values"], [""], [""],
        ["values[j]"], ["values[i]"], ["AST_ASSIGNMENT"],
        [""], [""], [""], [0], [0], [""], [""], [0], [0], [0], [0], [2],
        ["i.1", "j.1"], value_graph.rows, target_graph.rows, no_match_facts,
        no_destructure_facts, no_abi_type_names, no_runtime_call_abi, [0]
    );
    let missing_target_graph: SelfMirInstructionRows = SelfMirInstructionRows(
        [0], ["def"], ["ssa-def"], ["values.2"], ["values"], [""], [""],
        ["values[j]"], ["values[i]"], ["AST_ASSIGNMENT"],
        [""], [""], [""], [0], [0], [""], [""], [0], [0], [0], [0], [3],
        ["values.1", "i.1", "j.1"], value_graph.rows,
        SelfMirExpressionGraphRowsForInstructionCount(1), no_match_facts,
        no_destructure_facts, no_abi_type_names, no_runtime_call_abi, [0]
    );
    let missing_member_base_use: SelfMirInstructionRows =
        SelfMirInstructionRows(
            [0], ["def"], ["ssa-def"], ["base.2"], ["base"], [""], [""],
            ["1"], ["base.text"], ["AST_ASSIGNMENT"],
            [""], [""], [""], [0], [0], [""], [""], [0], [0], [0],
            [0], [0], no_uses, simple_value_graph.rows, member_target_graph.rows,
            no_match_facts, no_destructure_facts, no_abi_type_names,
            no_runtime_call_abi, [0]
        );
    let missing_simple_target_graph: SelfMirInstructionRows =
        SelfMirInstructionRows(
            [0], ["def"], ["ssa-def"], ["x.2"], ["x"], [""], [""],
            ["1"], ["x"], ["AST_ASSIGNMENT"],
            [""], [""], [""], [0], [0], [""], [""], [0], [0], [0],
            [0], [0], no_uses,
            simple_value_graph.rows,
            SelfMirExpressionGraphRowsForInstructionCount(1), no_match_facts,
            no_destructure_facts, no_abi_type_names, no_runtime_call_abi, [0]
        );
    let no_match_bindings: Array<String> = [];
    let no_match_binding_types: Array<String> = [];
    let scalar_match_facts: SelfMirMatchFactRows =
        SelfMirMatchFactRowsAttachCase(
            SelfMirMatchFactRowsEmpty(), 0, "1", "",
            no_match_bindings, no_match_binding_types, ""
        );
    let valid_match: SelfMirInstructionRows = SelfMirInstructionRows(
        [0], ["branch"], ["branch"], [""], [""], [""], [""],
        ["x"], [""], ["AST_MATCH_CASE"],
        [""], [""], [""], [0], [0], [""], [""], [0], [0], [0],
        [0], [1], ["x.1"], simple_target_graph.rows,
        SelfMirExpressionGraphRowsForInstructionCount(1), scalar_match_facts,
        no_destructure_facts, no_abi_type_names, no_runtime_call_abi, [0]
    );
    let missing_match: SelfMirInstructionRows = SelfMirInstructionRows(
        [0], ["branch"], ["branch"], [""], [""], [""], [""],
        ["x"], [""], ["AST_MATCH_CASE"],
        [""], [""], [""], [0], [0], [""], [""], [0], [0], [0],
        [0], [1], ["x.1"], simple_target_graph.rows,
        SelfMirExpressionGraphRowsForInstructionCount(1), no_match_facts,
        no_destructure_facts, no_abi_type_names, no_runtime_call_abi, [0]
    );
    let destructure_facts: SelfMirDestructureFactRows =
        SelfMirDestructureFactRowsAttach(
            SelfMirDestructureFactRowsEmpty(), 0, "String", ["a", "b"]
        );
    let valid_destructure: SelfMirInstructionRows = SelfMirInstructionRows(
        [0], ["destructure"], ["destructure"], [""], [""], [""], [""],
        ["Split(csv, \",\")"], [""], ["AST_LET_DESTRUCTURE"],
        [""], [""], [""], [0], [0], [""], [""], [0], [0], [0],
        [0], [0], no_uses, value_graph.rows,
        SelfMirExpressionGraphRowsForInstructionCount(1), no_match_facts,
        destructure_facts, no_abi_type_names, no_runtime_call_abi, [0]
    );
    let missing_destructure: SelfMirInstructionRows = SelfMirInstructionRows(
        [0], ["destructure"], ["destructure"], [""], [""], [""], [""],
        ["Split(csv, \",\")"], [""], ["AST_LET_DESTRUCTURE"],
        [""], [""], [""], [0], [0], [""], [""], [0], [0], [0],
        [0], [0], no_uses, value_graph.rows,
        SelfMirExpressionGraphRowsForInstructionCount(1), no_match_facts,
        no_destructure_facts, no_abi_type_names, no_runtime_call_abi, [0]
    );
    return SelfMirInstructionRowsReady(valid, target_graph.graph) &&
        SelfMirInstructionRowsReady(valid_simple, simple_target_graph.graph) &&
        SelfMirInstructionRowsReady(valid_member, member_target_graph.graph) &&
        SelfMirInstructionRowsReady(valid_match, simple_target_graph.graph) &&
        SelfMirInstructionRowsReady(valid_destructure, value_graph.graph) &&
        !SelfMirInstructionRowsReady(missing_base_use, target_graph.graph) &&
        !SelfMirInstructionRowsReady(missing_member_base_use, member_target_graph.graph) &&
        !SelfMirInstructionRowsReady(missing_target_graph, target_graph.graph) &&
        !SelfMirInstructionRowsReady(missing_simple_target_graph, simple_target_graph.graph) &&
        !SelfMirInstructionRowsReady(missing_match, simple_target_graph.graph) &&
        !SelfMirInstructionRowsReady(missing_destructure, value_graph.graph);
}
