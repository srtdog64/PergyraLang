// Flat self-host MIR fact graph owner.
//
// The producer writes declaration, routine, block, and instruction rows here.
// JSON and backend projections consume these rows; neither projection may
// recover semantic facts from source or AST provenance text.

import "declaration_fact_owner.pgy";
import "parallel_capture_fact_owner.pgy";
import "expression_graph_fact_owner.pgy";
import "machine_layer_projection_owner.pgy";
import "loop_flow_rows_owner.pgy";
import "match_fact_owner.pgy";
import "destructure_fact_owner.pgy";
import "destructure_type_fact_owner.pgy";
import "routine_match_pattern_owner.pgy";
import "generic_specialization_owner.pgy";
import "runtime_call_abi_fact_owner.pgy";
import "domain_topology_fact_owner.pgy";
import "domain_runtime_assignment_fact_owner.pgy";
import "instruction_abi_receipt_fact_owner.pgy";
import "local_ref_fact_owner.pgy";
import "intent_execution_fact_owner.pgy";
import "collection_ownership_fact_owner.pgy";
import "collection_ownership_receipt_fact_owner.pgy";

struct SelfMirInstructionRows {
    ids: Array<Int>;
    kinds: Array<String>;
    names: Array<String>;
    results: Array<String>;
    arg0s: Array<String>;
    arg1s: Array<String>;
    slot_anchors: Array<String>;
    expr0s: Array<String>;
    expr1s: Array<String>;
    source_types: Array<String>;
    machine_contact_kinds: Array<String>;
    machine_layer_manifest_ids: Array<String>;
    machine_layer_physical_grant_ids: Array<String>;
    machine_layer_physical_bases: Array<Int>;
    machine_layer_physical_sizes: Array<Int>;
    machine_layer_physical_modes: Array<String>;
    machine_layer_runtime_operations: Array<String>;
    machine_layer_hardware_adequate: Array<Int>;
    machine_layer_authority_required: Array<Int>;
    machine_layer_live_lease_required: Array<Int>;
    use_starts: Array<Int>;
    use_counts: Array<Int>;
    uses: Array<String>;
    expr0_graphs: SelfMirExpressionGraphRows;
    expr1_graphs: SelfMirExpressionGraphRows;
    match_facts: SelfMirMatchFactRows;
    destructure_facts: SelfMirDestructureFactRows;
    abi_type_names: Array<String>;
    runtime_call_abi: SelfMirRuntimeCallAbiRows;
    binding_source_syntax_ids: Array<Int>;
    collection_mutation_target_graphs: SelfMirExpressionGraphRows;
}
struct SelfMirBlockRows {
    ids: Array<Int>;
    reachable: Array<Int>;
    instruction_starts: Array<Int>;
    instruction_counts: Array<Int>;
    has_succ_true: Array<Int>;
    succ_true: Array<Int>;
    has_succ_false: Array<Int>;
    succ_false: Array<Int>;
    intent_roles: Array<String>;
}

struct SelfMirCfgRows {
    blocks: SelfMirBlockRows;
    instructions: SelfMirInstructionRows;
    local_refs: SelfMirInstructionLocalRefRows;
}

struct SelfMirRoutineRows {
    node_ids: Array<Int>;
    names: Array<String>;
    kinds: Array<String>;
    owners: Array<String>;
    source_module_paths: Array<String>;
    receiver_carriages: Array<String>;
    return_types: Array<String>;
    generic_starts: Array<Int>;
    generic_counts: Array<Int>;
    generic_names: Array<String>;
    generic_constraints: Array<String>;
    param_starts: Array<Int>;
    param_counts: Array<Int>;
    param_names: Array<String>;
    param_node_ids: Array<Int>;
    param_types: Array<String>;
    param_abi_kinds: Array<Int>;
    param_resource_kinds: Array<Int>;
    block_starts: Array<Int>;
    block_counts: Array<Int>;
    local_starts: Array<Int>;
    local_counts: Array<Int>;
    local_names: Array<String>;
    local_types: Array<String>;
    local_binding_syntax_ids: Array<Int>;
    iteration_starts: Array<Int>;
    iteration_counts: Array<Int>;
    iteration_node_ids: Array<Int>;
    iteration_binding_types: Array<String>;
    iteration_iterable_types: Array<String>;
    iteration_collection_hoists: Array<Int>;
    collection_ownership_facts: SelfMirCollectionOwnershipFactRows;
    destructure_type_facts: SelfMirDestructureTypeFactRows;
    loop_flows: SelfMirLoopFlowRows;
}

struct SelfMirProgramFacts {
    ok: Bool;
    diagnostic_code: String;
    diagnostic_message: String;
    artifact_node_count: Int;
    declarations: SelfMirDeclarationRows;
    domain_topology: SelfMirDomainTopologyFacts;
    domain_runtime_assignments: SelfMirDomainRuntimeAssignmentFacts;
    generic_specializations: SelfMirGenericSpecializationRows;
    parallel_captures: SelfMirParallelCaptureRows;
    routines: SelfMirRoutineRows;
    cfg: SelfMirCfgRows;
    instruction_abi_receipts: SelfMirInstructionAbiReceiptRows;
    collection_ownership_receipts: SelfMirCollectionOwnershipReceiptRows;
    expression_graph: SemanticExpressionGraphFacts;
    intent_execution: MirIntentExecutionPlan;
}

func SelfMirParamCarriageName(abi_kind: Int) -> String {
    if abi_kind == 1 { return "value-result"; }
    if abi_kind == 2 { return "owner-handle"; }
    if abi_kind == 3 || abi_kind == 4 { return "readonly-ref"; }
    if abi_kind == 5 { return "mutable-identity"; }
    return "value";
}

func SelfMirParamPassName(abi_kind: Int) -> String {
    if abi_kind == 4 || abi_kind == 5 { return "indirect"; }
    return "direct";
}

func SelfMirParamResourceKindForType(type_name: String) -> Int {
    if StringLength(type_name) >= 6 &&
        Substring(type_name, 0, 5) == "Slot<" { return 1; }
    if StringLength(type_name) >= 12 &&
        Substring(type_name, 0, 11) == "SecureSlot<" { return 2; }
    if StringLength(type_name) >= 12 &&
        Substring(type_name, 0, 11) == "DeviceSlot<" { return 3; }
    return 0;
}

func SelfMirParamResourceKindName(resource_kind: Int) -> String {
    if resource_kind == 1 { return "slot"; }
    if resource_kind == 2 { return "secure-slot"; }
    if resource_kind == 3 { return "device-slot"; }
    return "none";
}

func SelfMirInstructionRowsEmpty() -> SelfMirInstructionRows {
    let ints: Array<Int> = [];
    let strings: Array<String> = [];
    return SelfMirInstructionRows(
        ints, strings, strings, strings, strings, strings, strings, strings,
        strings, strings, strings, strings, strings, ints, ints, strings, strings,
        ints, ints, ints, ints, ints, strings,
        SelfMirExpressionGraphRowsEmpty(),
        SelfMirExpressionGraphRowsEmpty(), SelfMirMatchFactRowsEmpty(),
        SelfMirDestructureFactRowsEmpty(), strings,
        SelfMirRuntimeCallAbiRowsEmpty(), ints,
        SelfMirExpressionGraphRowsEmpty()
    );
}

func SelfMirBlockRowsEmpty() -> SelfMirBlockRows {
    let ints: Array<Int> = [];
    let roles: Array<String> = [];
    return SelfMirBlockRows(ints, ints, ints, ints, ints, ints, ints, ints, roles);
}

func SelfMirCfgRowsEmpty() -> SelfMirCfgRows {
    return SelfMirCfgRows(
        SelfMirBlockRowsEmpty(), SelfMirInstructionRowsEmpty(),
        SelfMirInstructionLocalRefRowsEmpty()
    );
}

func SelfMirRoutineRowsEmpty() -> SelfMirRoutineRows {
    let ints: Array<Int> = [];
    let strings: Array<String> = [];
    return SelfMirRoutineRows(
        ints, strings, strings, strings, strings, strings, strings,
        ints, ints, strings, strings, ints, ints, strings,
        ints, strings, ints, ints, ints, ints, ints, ints, strings, strings,
        ints, ints, ints, ints, strings, strings, ints,
        SelfMirCollectionOwnershipFactRowsEmpty(),
        SelfMirDestructureTypeFactRowsEmpty(),
        SelfMirLoopFlowRowsEmpty()
    );
}

// Initial facts own no semantic graph. The successful lowering path attaches
// the admitted graph once, after every growable MIR row has stopped changing.
func SelfMirProgramFactsEmpty(
    artifact_node_count: Int
) -> SelfMirProgramFacts {
    return SelfMirProgramFacts(
        true, "", "", artifact_node_count,
        SelfMirDeclarationRowsEmpty(),
        SelfMirDomainTopologyFactsAbsent(),
        SelfMirDomainRuntimeAssignmentFactsEmpty(true, false),
        SelfMirGenericSpecializationRowsEmpty(),
        SelfMirParallelCaptureRowsEmpty(),
        SelfMirRoutineRowsEmpty(),
        SelfMirCfgRowsEmpty(),
        SelfMirInstructionAbiReceiptRowsEmpty(),
        SelfMirCollectionOwnershipReceiptRowsEmpty(),
        SemanticExpressionGraphFactsEmpty(), MirIntentExecutionPlanFromFacts(
            MirIntentStepTransitionFactsEmpty(), MirIntentTerminalTransitionFactsEmpty())
    );
}

// A failed program carries only its diagnostic. The failing facts may name
// row storage a growth already released, so none of it travels with the
// error; the admitted semantic graph is borrowed, not built here.
func SelfMirProgramFactsError(
    facts: SelfMirProgramFacts,
    code: String,
    message: String
) -> SelfMirProgramFacts {
    var failed: SelfMirProgramFacts =
        SelfMirProgramFactsEmpty(facts.artifact_node_count);
    failed.ok = false;
    failed.diagnostic_code = code;
    failed.diagnostic_message = message;
    return failed;
}

func SelfMirProgramFactsWithDomainTopology(
    facts: SelfMirProgramFacts,
    domain_topology: SelfMirDomainTopologyFacts
) -> SelfMirProgramFacts {
    return SelfMirProgramFacts(
        facts.ok, facts.diagnostic_code, facts.diagnostic_message,
        facts.artifact_node_count, facts.declarations, domain_topology,
        facts.domain_runtime_assignments,
        facts.generic_specializations, facts.parallel_captures,
        facts.routines, facts.cfg,
        facts.instruction_abi_receipts,
        facts.collection_ownership_receipts,
        facts.expression_graph, facts.intent_execution
    );
}

func SelfMirCfgAddBlock(cfg: SelfMirCfgRows) -> SelfMirCfgRows {
    ArrayPush(cfg.blocks.ids, ArrayLength(cfg.blocks.ids));
    ArrayPush(cfg.blocks.reachable, 1);
    ArrayPush(cfg.blocks.instruction_starts, ArrayLength(cfg.instructions.ids));
    ArrayPush(cfg.blocks.instruction_counts, 0);
    ArrayPush(cfg.blocks.has_succ_true, 0);
    ArrayPush(cfg.blocks.succ_true, 0);
    ArrayPush(cfg.blocks.has_succ_false, 0);
    ArrayPush(cfg.blocks.succ_false, 0);
    ArrayPushOwnedString(cfg.blocks.intent_roles, "");
    return cfg;
}

func SelfMirCfgSetSuccessors(
    cfg: SelfMirCfgRows,
    block_index: Int,
    true_target: Int,
    false_target: Int
) -> SelfMirCfgRows {
    if true_target >= 0 {
        ArraySet(cfg.blocks.has_succ_true, block_index, 1);
        ArraySet(cfg.blocks.succ_true, block_index, true_target);
    }
    if false_target >= 0 {
        ArraySet(cfg.blocks.has_succ_false, block_index, 1);
        ArraySet(cfg.blocks.succ_false, block_index, false_target);
    }
    return cfg;
}

func SelfMirCfgAddInstruction(
    cfg: SelfMirCfgRows,
    block_index: Int,
    id: Int,
    kind: String,
    name: String,
    result: String,
    arg0: String,
    arg1: String,
    expr0: String,
    expr1: String,
    source_type: String,
    ref row_uses: Array<String>
) -> SelfMirCfgRows {
    // Retained input Strings are copied once at their store boundary.
    // The CFG remains the owner while a row grows. Rebuilding its sibling
    // fields would publish copies of every preceding String instruction.
    cfg.instructions.expr0_graphs = SelfMirExpressionGraphAppendInstruction(
        cfg.instructions.expr0_graphs);
    cfg.instructions.expr1_graphs = SelfMirExpressionGraphAppendInstruction(
        cfg.instructions.expr1_graphs);
    cfg.instructions.collection_mutation_target_graphs =
        SelfMirExpressionGraphAppendInstruction(
            cfg.instructions.collection_mutation_target_graphs);
    cfg.instructions.runtime_call_abi = SelfMirRuntimeCallAbiRowsAppendInstruction(
        cfg.instructions.runtime_call_abi);
    ArrayPush(cfg.instructions.ids, id);
    ArrayPush(cfg.instructions.binding_source_syntax_ids, 0);
    ArrayPushOwnedString(cfg.instructions.kinds, kind);
    ArrayPushOwnedString(cfg.instructions.names, name);
    ArrayPushOwnedString(cfg.instructions.results, result);
    ArrayPushOwnedString(cfg.instructions.arg0s, arg0);
    ArrayPushOwnedString(cfg.instructions.arg1s, arg1);
    ArrayPushOwnedString(cfg.instructions.slot_anchors, "");
    ArrayPushOwnedString(cfg.instructions.expr0s, expr0);
    ArrayPushOwnedString(cfg.instructions.expr1s, expr1);
    ArrayPushOwnedString(cfg.instructions.source_types, source_type);
    ArrayPushOwnedString(cfg.instructions.machine_contact_kinds, "");
    ArrayPushOwnedString(cfg.instructions.machine_layer_manifest_ids, "");
    ArrayPushOwnedString(cfg.instructions.machine_layer_physical_grant_ids, "");
    ArrayPush(cfg.instructions.machine_layer_physical_bases, 0);
    ArrayPush(cfg.instructions.machine_layer_physical_sizes, 0);
    ArrayPushOwnedString(cfg.instructions.machine_layer_physical_modes, "");
    ArrayPushOwnedString(cfg.instructions.machine_layer_runtime_operations, "");
    ArrayPush(cfg.instructions.machine_layer_hardware_adequate, 0);
    ArrayPush(cfg.instructions.machine_layer_authority_required, 0);
    ArrayPush(cfg.instructions.machine_layer_live_lease_required, 0);
    ArrayPushOwnedString(cfg.instructions.abi_type_names, "");
    ArrayPush(cfg.instructions.use_starts, ArrayLength(cfg.instructions.uses));
    ArrayPush(cfg.instructions.use_counts, ArrayLength(row_uses));
    var i: Int = 0;
    while i < ArrayLength(row_uses) {
        // Retained uses still cross an ownership boundary from the input view.
        ArrayPushOwnedString(cfg.instructions.uses, row_uses[i]);
        i = i + 1;
    }
    ArraySet(cfg.blocks.instruction_counts, block_index,
        ArrayLength(cfg.instructions.ids) -
            cfg.blocks.instruction_starts[block_index]);
    cfg.local_refs = SelfMirInstructionLocalRefRowsAppendInstruction(cfg.local_refs);
    return cfg;
}

func SelfMirCfgAttachLastExpr0Graph(
    cfg: SelfMirCfgRows,
    view: SemanticExpressionGraphView,
    declaration: SelfHostMachineLayerDeclaration
) -> SelfMirCfgRows {
    cfg.instructions.expr0_graphs = SelfMirExpressionGraphAttachLast(
        cfg.instructions.expr0_graphs, view);
    let machine: SelfMirMachineLayerProjection =
        SelfMirMachineLayerProjectionForGraph(
            view.graph, view.root_id, declaration
        );
    let instruction_index: Int = ArrayLength(cfg.instructions.ids) - 1;
    if instruction_index >= 0 {
        ArraySet(cfg.instructions.machine_contact_kinds, instruction_index, Clone(machine.contact_kind));
        ArraySet(
            cfg.instructions.machine_layer_manifest_ids, instruction_index, Clone(machine.manifest_id)
        );
        ArraySet(
            cfg.instructions.machine_layer_physical_grant_ids, instruction_index,
            Clone(machine.physical_grant)
        );
        ArraySet(
            cfg.instructions.machine_layer_physical_bases, instruction_index,
            machine.physical_base
        );
        ArraySet(
            cfg.instructions.machine_layer_physical_sizes, instruction_index,
            machine.physical_size
        );
        ArraySet(
            cfg.instructions.machine_layer_physical_modes, instruction_index,
            Clone(machine.physical_mode)
        );
        ArraySet(
            cfg.instructions.machine_layer_runtime_operations, instruction_index,
            Clone(machine.runtime_operation)
        );
        ArraySet(
            cfg.instructions.machine_layer_hardware_adequate, instruction_index,
            machine.hardware_adequate
        );
        ArraySet(
            cfg.instructions.machine_layer_authority_required, instruction_index,
            machine.authority_required
        );
        ArraySet(
            cfg.instructions.machine_layer_live_lease_required, instruction_index,
            machine.live_lease_required
        );
    }
    return cfg;
}

func SelfMirCfgAttachLastExpr1Graph(
    cfg: SelfMirCfgRows,
    view: SemanticExpressionGraphView
) -> SelfMirCfgRows {
    cfg.instructions.expr1_graphs = SelfMirExpressionGraphAttachLast(
        cfg.instructions.expr1_graphs, view);
    return cfg;
}

func SelfMirCfgAttachLastCollectionMutationTargetGraph(
    cfg: SelfMirCfgRows,
    view: SemanticExpressionGraphView
) -> SelfMirCfgRows {
    cfg.instructions.collection_mutation_target_graphs =
        SelfMirExpressionGraphAttachLast(
            cfg.instructions.collection_mutation_target_graphs, view);
    return cfg;
}

func SelfMirCfgAttachLastMatchCase(
    cfg: SelfMirCfgRows,
    fact: SelfMirMatchCaseFact
) -> SelfMirCfgRows {
    let instruction_index: Int = ArrayLength(cfg.instructions.ids) - 1;
    if instruction_index < 0 || !fact.ok || fact.pattern == "" {
        return cfg;
    }
    cfg.instructions.match_facts = SelfMirMatchFactRowsAttachCase(
        cfg.instructions.match_facts, instruction_index,
        fact.patterns, fact.variant, fact.bindings, fact.binding_types,
        fact.subject_family);
    return cfg;
}
