// Flat self-host MIR fact graph owner.
//
// The producer writes declaration, routine, block, and instruction rows here.
// JSON and backend projections consume these rows; neither projection may
// recover semantic facts from source or AST provenance text.

import "parallel_capture_fact_owner.pgy";
import "expression_graph_fact_owner.pgy";
import "machine_layer_projection_owner.pgy";
import "loop_flow_rows_owner.pgy";
import "match_fact_owner.pgy";
import "destructure_fact_owner.pgy";
import "destructure_type_fact_owner.pgy";
import "routine_match_pattern_owner.pgy";
import "generic_specialization_owner.pgy";

struct SelfMirInstructionRows {
    ids: Array<Int>;
    kinds: Array<String>;
    names: Array<String>;
    results: Array<String>;
    arg0s: Array<String>;
    arg1s: Array<String>;
    expr0s: Array<String>;
    expr1s: Array<String>;
    source_types: Array<String>;
    machine_contact_kinds: Array<String>;
    machine_layer_manifest_ids: Array<String>;
    machine_layer_physical_grant_ids: Array<String>;
    machine_layer_physical_bases: Array<Int>;
    machine_layer_physical_sizes: Array<Int>;
    machine_layer_physical_modes: Array<String>;
    machine_layer_runtime_operations: Array<String>;
    machine_layer_hardware_adequate: Array<Int>;
    machine_layer_authority_required: Array<Int>;
    machine_layer_live_lease_required: Array<Int>;
    use_starts: Array<Int>;
    use_counts: Array<Int>;
    uses: Array<String>;
    expr0_graphs: SelfMirExpressionGraphRows;
    expr1_graphs: SelfMirExpressionGraphRows;
    match_facts: SelfMirMatchFactRows;
    destructure_facts: SelfMirDestructureFactRows;
}

struct SelfMirBlockRows {
    ids: Array<Int>;
    reachable: Array<Int>;
    instruction_starts: Array<Int>;
    instruction_counts: Array<Int>;
    has_succ_true: Array<Int>;
    succ_true: Array<Int>;
    has_succ_false: Array<Int>;
    succ_false: Array<Int>;
}

struct SelfMirCfgRows {
    blocks: SelfMirBlockRows;
    instructions: SelfMirInstructionRows;
}

struct SelfMirDeclarationRows {
    kinds: Array<String>;
    nominal_kinds: Array<String>;
    names: Array<String>;
    target_types: Array<String>;
    field_starts: Array<Int>;
    field_counts: Array<Int>;
    field_names: Array<String>;
    field_types: Array<String>;
    method_starts: Array<Int>;
    method_counts: Array<Int>;
    method_names: Array<String>;
    method_returns: Array<String>;
    variant_starts: Array<Int>;
    variant_counts: Array<Int>;
    variant_names: Array<String>;
    variant_param_counts: Array<Int>;
}

struct SelfMirRoutineRows {
    node_ids: Array<Int>;
    names: Array<String>;
    kinds: Array<String>;
    owners: Array<String>;
    return_types: Array<String>;
    generic_starts: Array<Int>;
    generic_counts: Array<Int>;
    generic_names: Array<String>;
    param_starts: Array<Int>;
    param_counts: Array<Int>;
    param_names: Array<String>;
    param_types: Array<String>;
    param_abi_kinds: Array<Int>;
    block_starts: Array<Int>;
    block_counts: Array<Int>;
    local_starts: Array<Int>;
    local_counts: Array<Int>;
    local_names: Array<String>;
    local_types: Array<String>;
    iteration_starts: Array<Int>;
    iteration_counts: Array<Int>;
    iteration_node_ids: Array<Int>;
    iteration_binding_types: Array<String>;
    iteration_iterable_types: Array<String>;
    iteration_collection_hoists: Array<Int>;
    destructure_type_facts: SelfMirDestructureTypeFactRows;
    loop_flows: SelfMirLoopFlowRows;
}

struct SelfMirProgramFacts {
    ok: Bool;
    diagnostic_code: String;
    diagnostic_message: String;
    artifact_node_count: Int;
    declarations: SelfMirDeclarationRows;
    generic_specializations: SelfMirGenericSpecializationRows;
    parallel_captures: SelfMirParallelCaptureRows;
    routines: SelfMirRoutineRows;
    cfg: SelfMirCfgRows;
}

func SelfMirParamCarriageName(abi_kind: Int) -> String {
    if abi_kind == 1 { return "value-result"; }
    if abi_kind == 2 { return "owner-handle"; }
    if abi_kind == 3 || abi_kind == 4 { return "readonly-ref"; }
    return "value";
}

func SelfMirParamPassName(abi_kind: Int) -> String {
    if abi_kind == 4 { return "indirect"; }
    return "direct";
}

func SelfMirInstructionRowsEmpty() -> SelfMirInstructionRows {
    let ints: Array<Int> = [];
    let strings: Array<String> = [];
    return SelfMirInstructionRows(
        ints, strings, strings, strings, strings, strings, strings, strings,
        strings, strings, strings, strings, ints, ints, strings, strings,
        ints, ints, ints, ints, ints, strings,
        SelfMirExpressionGraphRowsEmpty(),
        SelfMirExpressionGraphRowsEmpty(), SelfMirMatchFactRowsEmpty(),
        SelfMirDestructureFactRowsEmpty()
    );
}

func SelfMirBlockRowsEmpty() -> SelfMirBlockRows {
    let ints: Array<Int> = [];
    return SelfMirBlockRows(ints, ints, ints, ints, ints, ints, ints, ints);
}

func SelfMirCfgRowsEmpty() -> SelfMirCfgRows {
    return SelfMirCfgRows(
        SelfMirBlockRowsEmpty(), SelfMirInstructionRowsEmpty()
    );
}

func SelfMirDeclarationRowsEmpty() -> SelfMirDeclarationRows {
    let ints: Array<Int> = [];
    let strings: Array<String> = [];
    return SelfMirDeclarationRows(
        strings, strings, strings, strings, ints, ints, strings, strings,
        ints, ints, strings, strings, ints, ints, strings, ints
    );
}

func SelfMirRoutineRowsEmpty() -> SelfMirRoutineRows {
    let ints: Array<Int> = [];
    let strings: Array<String> = [];
    return SelfMirRoutineRows(
        ints, strings, strings, strings, strings,
        ints, ints, strings, ints, ints, strings,
        strings, ints, ints, ints, ints, ints, strings, strings,
        ints, ints, ints, strings, strings, ints,
        SelfMirDestructureTypeFactRowsEmpty(),
        SelfMirLoopFlowRowsEmpty()
    );
}

func SelfMirProgramFactsEmpty(artifact_node_count: Int) -> SelfMirProgramFacts {
    return SelfMirProgramFacts(
        true, "", "", artifact_node_count,
        SelfMirDeclarationRowsEmpty(),
        SelfMirGenericSpecializationRowsEmpty(),
        SelfMirParallelCaptureRowsEmpty(),
        SelfMirRoutineRowsEmpty(),
        SelfMirCfgRowsEmpty()
    );
}

func SelfMirProgramFactsError(
    facts: SelfMirProgramFacts,
    code: String,
    message: String
) -> SelfMirProgramFacts {
    return SelfMirProgramFacts(
        false, code, message, facts.artifact_node_count,
        facts.declarations, facts.generic_specializations,
        facts.parallel_captures, facts.routines, facts.cfg
    );
}

func SelfMirCfgAddBlock(cfg: SelfMirCfgRows) -> SelfMirCfgRows {
    let blocks: SelfMirBlockRows = cfg.blocks;
    let ids: Array<Int> = blocks.ids;
    let reachable: Array<Int> = blocks.reachable;
    let instruction_starts: Array<Int> = blocks.instruction_starts;
    let instruction_counts: Array<Int> = blocks.instruction_counts;
    let has_true: Array<Int> = blocks.has_succ_true;
    let succ_true: Array<Int> = blocks.succ_true;
    let has_false: Array<Int> = blocks.has_succ_false;
    let succ_false: Array<Int> = blocks.succ_false;
    ArrayPush(ids, ArrayLength(ids));
    ArrayPush(reachable, 1);
    ArrayPush(instruction_starts, ArrayLength(cfg.instructions.ids));
    ArrayPush(instruction_counts, 0);
    ArrayPush(has_true, 0);
    ArrayPush(succ_true, 0);
    ArrayPush(has_false, 0);
    ArrayPush(succ_false, 0);
    return SelfMirCfgRows(
        SelfMirBlockRows(
            ids, reachable, instruction_starts, instruction_counts,
            has_true, succ_true, has_false, succ_false
        ),
        cfg.instructions
    );
}

func SelfMirCfgSetSuccessors(
    cfg: SelfMirCfgRows,
    block_index: Int,
    true_target: Int,
    false_target: Int
) -> SelfMirCfgRows {
    let blocks: SelfMirBlockRows = cfg.blocks;
    let has_true: Array<Int> = blocks.has_succ_true;
    let succ_true: Array<Int> = blocks.succ_true;
    let has_false: Array<Int> = blocks.has_succ_false;
    let succ_false: Array<Int> = blocks.succ_false;
    if true_target >= 0 {
        ArraySet(has_true, block_index, 1);
        ArraySet(succ_true, block_index, true_target);
    }
    if false_target >= 0 {
        ArraySet(has_false, block_index, 1);
        ArraySet(succ_false, block_index, false_target);
    }
    return SelfMirCfgRows(
        SelfMirBlockRows(
            blocks.ids, blocks.reachable, blocks.instruction_starts,
            blocks.instruction_counts, has_true, succ_true,
            has_false, succ_false
        ),
        cfg.instructions
    );
}

func SelfMirCfgAddInstruction(
    cfg: SelfMirCfgRows,
    block_index: Int,
    id: Int,
    kind: String,
    name: String,
    result: String,
    arg0: String,
    arg1: String,
    expr0: String,
    expr1: String,
    source_type: String,
    row_uses: Array<String>
) -> SelfMirCfgRows {
    let instructions: SelfMirInstructionRows = cfg.instructions;
    let ids: Array<Int> = instructions.ids;
    let kinds: Array<String> = instructions.kinds;
    let names: Array<String> = instructions.names;
    let results: Array<String> = instructions.results;
    let arg0s: Array<String> = instructions.arg0s;
    let arg1s: Array<String> = instructions.arg1s;
    let expr0s: Array<String> = instructions.expr0s;
    let expr1s: Array<String> = instructions.expr1s;
    let source_types: Array<String> = instructions.source_types;
    let machine_contact_kinds: Array<String> =
        instructions.machine_contact_kinds;
    let machine_layer_manifest_ids: Array<String> =
        instructions.machine_layer_manifest_ids;
    let machine_layer_physical_grant_ids: Array<String> =
        instructions.machine_layer_physical_grant_ids;
    let machine_layer_physical_bases: Array<Int> =
        instructions.machine_layer_physical_bases;
    let machine_layer_physical_sizes: Array<Int> =
        instructions.machine_layer_physical_sizes;
    let machine_layer_physical_modes: Array<String> =
        instructions.machine_layer_physical_modes;
    let machine_layer_runtime_operations: Array<String> =
        instructions.machine_layer_runtime_operations;
    let machine_layer_hardware_adequate: Array<Int> =
        instructions.machine_layer_hardware_adequate;
    let machine_layer_authority_required: Array<Int> =
        instructions.machine_layer_authority_required;
    let machine_layer_live_lease_required: Array<Int> =
        instructions.machine_layer_live_lease_required;
    let use_starts: Array<Int> = instructions.use_starts;
    let use_counts: Array<Int> = instructions.use_counts;
    let uses: Array<String> = instructions.uses;
    let expr0_graphs: SelfMirExpressionGraphRows =
        SelfMirExpressionGraphAppendInstruction(
            instructions.expr0_graphs
        );
    let expr1_graphs: SelfMirExpressionGraphRows =
        SelfMirExpressionGraphAppendInstruction(
            instructions.expr1_graphs
        );
    ArrayPush(ids, id);
    ArrayPush(kinds, kind);
    ArrayPush(names, name);
    ArrayPush(results, result);
    ArrayPush(arg0s, arg0);
    ArrayPush(arg1s, arg1);
    ArrayPush(expr0s, expr0);
    ArrayPush(expr1s, expr1);
    ArrayPush(source_types, source_type);
    ArrayPush(machine_contact_kinds, "");
    ArrayPush(machine_layer_manifest_ids, "");
    ArrayPush(machine_layer_physical_grant_ids, "");
    ArrayPush(machine_layer_physical_bases, 0);
    ArrayPush(machine_layer_physical_sizes, 0);
    ArrayPush(machine_layer_physical_modes, "");
    ArrayPush(machine_layer_runtime_operations, "");
    ArrayPush(machine_layer_hardware_adequate, 0);
    ArrayPush(machine_layer_authority_required, 0);
    ArrayPush(machine_layer_live_lease_required, 0);
    ArrayPush(use_starts, ArrayLength(uses));
    ArrayPush(use_counts, ArrayLength(row_uses));
    let i: Int = 0;
    while i < ArrayLength(row_uses) {
        ArrayPush(uses, row_uses[i]);
        i = i + 1;
    }
    let counts: Array<Int> = cfg.blocks.instruction_counts;
    ArraySet(
        counts, block_index,
        ArrayLength(ids) - cfg.blocks.instruction_starts[block_index]
    );
    return SelfMirCfgRows(
        SelfMirBlockRows(
            cfg.blocks.ids, cfg.blocks.reachable,
            cfg.blocks.instruction_starts, counts,
            cfg.blocks.has_succ_true, cfg.blocks.succ_true,
            cfg.blocks.has_succ_false, cfg.blocks.succ_false
        ),
        SelfMirInstructionRows(
            ids, kinds, names, results, arg0s, arg1s, expr0s, expr1s,
            source_types, machine_contact_kinds, machine_layer_manifest_ids,
            machine_layer_physical_grant_ids, machine_layer_physical_bases,
            machine_layer_physical_sizes, machine_layer_physical_modes,
            machine_layer_runtime_operations, machine_layer_hardware_adequate,
            machine_layer_authority_required, machine_layer_live_lease_required,
            use_starts, use_counts, uses,
            expr0_graphs, expr1_graphs, instructions.match_facts,
            instructions.destructure_facts
        )
    );
}

// Replace one instruction's complete use row while preserving the canonical
// flattened owner arrays and all subsequent row starts.
func SelfMirCfgSetInstructionUses(
    cfg: SelfMirCfgRows,
    instruction_index: Int,
    replacement: Array<String>
) -> SelfMirCfgRows {
    let instruction_count: Int = ArrayLength(cfg.instructions.ids);
    if instruction_index < 0 || instruction_index >= instruction_count {
        return cfg;
    }
    let use_starts: Array<Int> = [];
    let use_counts: Array<Int> = [];
    let uses: Array<String> = [];
    let row: Int = 0;
    while row < instruction_count {
        ArrayPush(use_starts, ArrayLength(uses));
        if row == instruction_index {
            ArrayPush(use_counts, ArrayLength(replacement));
            let replacement_i: Int = 0;
            while replacement_i < ArrayLength(replacement) {
                ArrayPush(uses, replacement[replacement_i]);
                replacement_i = replacement_i + 1;
            }
        } else {
            let old_start: Int = cfg.instructions.use_starts[row];
            let old_count: Int = cfg.instructions.use_counts[row];
            ArrayPush(use_counts, old_count);
            let old_i: Int = 0;
            while old_i < old_count {
                ArrayPush(uses, cfg.instructions.uses[old_start + old_i]);
                old_i = old_i + 1;
            }
        }
        row = row + 1;
    }
    let instructions: SelfMirInstructionRows = cfg.instructions;
    return SelfMirCfgRows(
        cfg.blocks,
        SelfMirInstructionRows(
            instructions.ids, instructions.kinds, instructions.names,
            instructions.results, instructions.arg0s, instructions.arg1s,
            instructions.expr0s, instructions.expr1s,
            instructions.source_types, instructions.machine_contact_kinds,
            instructions.machine_layer_manifest_ids,
            instructions.machine_layer_physical_grant_ids,
            instructions.machine_layer_physical_bases,
            instructions.machine_layer_physical_sizes,
            instructions.machine_layer_physical_modes,
            instructions.machine_layer_runtime_operations,
            instructions.machine_layer_hardware_adequate,
            instructions.machine_layer_authority_required,
            instructions.machine_layer_live_lease_required,
            use_starts, use_counts, uses,
            instructions.expr0_graphs, instructions.expr1_graphs,
            instructions.match_facts, instructions.destructure_facts
        )
    );
}

func SelfMirCfgAttachLastExpr0Graph(
    cfg: SelfMirCfgRows,
    view: SemanticExpressionGraphView,
    declaration: SelfHostMachineLayerDeclaration
) -> SelfMirCfgRows {
    let instructions: SelfMirInstructionRows = cfg.instructions;
    let graphs: SelfMirExpressionGraphRows =
        SelfMirExpressionGraphAttachLast(
        instructions.expr0_graphs, view
        );
    let machine: SelfMirMachineLayerProjection =
        SelfMirMachineLayerProjectionForGraph(
            view.graph, view.root_id, declaration
        );
    let instruction_index: Int = ArrayLength(instructions.ids) - 1;
    let machine_contact_kinds: Array<String> =
        instructions.machine_contact_kinds;
    let machine_layer_manifest_ids: Array<String> =
        instructions.machine_layer_manifest_ids;
    let machine_layer_physical_grant_ids: Array<String> =
        instructions.machine_layer_physical_grant_ids;
    let machine_layer_physical_bases: Array<Int> =
        instructions.machine_layer_physical_bases;
    let machine_layer_physical_sizes: Array<Int> =
        instructions.machine_layer_physical_sizes;
    let machine_layer_physical_modes: Array<String> =
        instructions.machine_layer_physical_modes;
    let machine_layer_runtime_operations: Array<String> =
        instructions.machine_layer_runtime_operations;
    let machine_layer_hardware_adequate: Array<Int> =
        instructions.machine_layer_hardware_adequate;
    let machine_layer_authority_required: Array<Int> =
        instructions.machine_layer_authority_required;
    let machine_layer_live_lease_required: Array<Int> =
        instructions.machine_layer_live_lease_required;
    if instruction_index >= 0 {
        ArraySet(machine_contact_kinds, instruction_index, machine.contact_kind);
        ArraySet(
            machine_layer_manifest_ids, instruction_index, machine.manifest_id
        );
        ArraySet(
            machine_layer_physical_grant_ids, instruction_index,
            machine.physical_grant
        );
        ArraySet(
            machine_layer_physical_bases, instruction_index,
            machine.physical_base
        );
        ArraySet(
            machine_layer_physical_sizes, instruction_index,
            machine.physical_size
        );
        ArraySet(
            machine_layer_physical_modes, instruction_index,
            machine.physical_mode
        );
        ArraySet(
            machine_layer_runtime_operations, instruction_index,
            machine.runtime_operation
        );
        ArraySet(
            machine_layer_hardware_adequate, instruction_index,
            machine.hardware_adequate
        );
        ArraySet(
            machine_layer_authority_required, instruction_index,
            machine.authority_required
        );
        ArraySet(
            machine_layer_live_lease_required, instruction_index,
            machine.live_lease_required
        );
    }
    return SelfMirCfgRows(
        cfg.blocks,
        SelfMirInstructionRows(
            instructions.ids, instructions.kinds, instructions.names,
            instructions.results, instructions.arg0s, instructions.arg1s,
            instructions.expr0s, instructions.expr1s,
            instructions.source_types, machine_contact_kinds,
            machine_layer_manifest_ids, machine_layer_physical_grant_ids,
            machine_layer_physical_bases, machine_layer_physical_sizes,
            machine_layer_physical_modes, machine_layer_runtime_operations,
            machine_layer_hardware_adequate, machine_layer_authority_required,
            machine_layer_live_lease_required, instructions.use_starts,
            instructions.use_counts, instructions.uses, graphs,
            instructions.expr1_graphs, instructions.match_facts,
            instructions.destructure_facts
        )
    );
}

func SelfMirCfgAttachLastExpr1Graph(
    cfg: SelfMirCfgRows,
    view: SemanticExpressionGraphView
) -> SelfMirCfgRows {
    let instructions: SelfMirInstructionRows = cfg.instructions;
    let graphs: SelfMirExpressionGraphRows =
        SelfMirExpressionGraphAttachLast(
            instructions.expr1_graphs, view
        );
    return SelfMirCfgRows(
        cfg.blocks,
        SelfMirInstructionRows(
            instructions.ids, instructions.kinds, instructions.names,
            instructions.results, instructions.arg0s, instructions.arg1s,
            instructions.expr0s, instructions.expr1s,
            instructions.source_types, instructions.machine_contact_kinds,
            instructions.machine_layer_manifest_ids,
            instructions.machine_layer_physical_grant_ids,
            instructions.machine_layer_physical_bases,
            instructions.machine_layer_physical_sizes,
            instructions.machine_layer_physical_modes,
            instructions.machine_layer_runtime_operations,
            instructions.machine_layer_hardware_adequate,
            instructions.machine_layer_authority_required,
            instructions.machine_layer_live_lease_required,
            instructions.use_starts, instructions.use_counts, instructions.uses,
            instructions.expr0_graphs, graphs, instructions.match_facts,
            instructions.destructure_facts
        )
    );
}

func SelfMirCfgAttachLastMatchCase(
    cfg: SelfMirCfgRows,
    fact: SelfMirMatchCaseFact
) -> SelfMirCfgRows {
    let instructions: SelfMirInstructionRows = cfg.instructions;
    let instruction_index: Int = ArrayLength(instructions.ids) - 1;
    if instruction_index < 0 || !fact.ok || fact.pattern == "" {
        return cfg;
    }
    let match_facts: SelfMirMatchFactRows =
        SelfMirMatchFactRowsAttachCase(
            instructions.match_facts, instruction_index,
            fact.pattern, fact.variant, fact.binding
        );
    return SelfMirCfgRows(
        cfg.blocks,
        SelfMirInstructionRows(
            instructions.ids, instructions.kinds, instructions.names,
            instructions.results, instructions.arg0s, instructions.arg1s,
            instructions.expr0s, instructions.expr1s,
            instructions.source_types, instructions.machine_contact_kinds,
            instructions.machine_layer_manifest_ids,
            instructions.machine_layer_physical_grant_ids,
            instructions.machine_layer_physical_bases,
            instructions.machine_layer_physical_sizes,
            instructions.machine_layer_physical_modes,
            instructions.machine_layer_runtime_operations,
            instructions.machine_layer_hardware_adequate,
            instructions.machine_layer_authority_required,
            instructions.machine_layer_live_lease_required,
            instructions.use_starts, instructions.use_counts,
            instructions.uses, instructions.expr0_graphs,
            instructions.expr1_graphs, match_facts,
            instructions.destructure_facts
        )
    );
}

func SelfMirCfgBlockCount(cfg: SelfMirCfgRows) -> Int {
    return ArrayLength(cfg.blocks.ids);
}

func SelfMirCfgInstructionCount(cfg: SelfMirCfgRows) -> Int {
    return ArrayLength(cfg.instructions.ids);
}
