func SelfMirProgramJsonRowsWriteMemory(
    facts: SelfMirProgramFacts, inout fragments: Array<String>
) -> Bool {
    JsonProjectionAppend(fragments, "{\"schema\":\"pgy.mir.v1\",\"decls\":[");
    var declaration_i: Int = 0;
    while declaration_i < ArrayLength(facts.declarations.names) {
        if declaration_i > 0 { JsonProjectionAppend(fragments, ","); }
        JsonOwnedFragmentAppend(
            fragments, SelfMirJsonDeclaration(facts, declaration_i)
        );
        declaration_i = declaration_i + 1;
    }

    JsonProjectionAppend(fragments, "],\"generic_method_specializations\":[");
    var specialization_i: Int = 0;
    while specialization_i <
        SelfMirGenericSpecializationCount(facts.generic_specializations) {
        if specialization_i > 0 { JsonProjectionAppend(fragments, ","); }
        JsonOwnedFragmentAppend(fragments, SelfMirJsonGenericSpecialization(
            facts.generic_specializations, facts.routines, facts.cfg, specialization_i
        ));
        specialization_i = specialization_i + 1;
    }

    JsonProjectionAppend(fragments, "],\"parallel_capture_boundaries\":[");
    var parallel_i: Int = 0;
    while parallel_i <
        ArrayLength(facts.parallel_captures.source_stable_ids) {
        if parallel_i > 0 { JsonProjectionAppend(fragments, ","); }
        JsonOwnedFragmentAppend(fragments, SelfMirJsonParallelCaptureBoundary(
            facts.parallel_captures, parallel_i
        ));
        parallel_i = parallel_i + 1;
    }

    JsonProjectionAppend(fragments, "]");
    // Absent prefixes are borrowed empty literals, not allocation results.
    if facts.domain_topology.present {
        JsonProjectionAppend(fragments, SelfMirDomainTopologyJsonPrefix(facts.domain_topology));
    }
    if facts.domain_runtime_assignments.present &&
        (ArrayLength(facts.domain_runtime_assignments.participant_roles.roles) > 0 ||
         ArrayLength(facts.domain_runtime_assignments.projection_members.owner_names) > 0) {
        JsonProjectionAppend(fragments, SelfMirDomainRuntimeAssignmentsJsonPrefix(
            facts.domain_runtime_assignments
        ));
    }
    JsonProjectionAppend(fragments, ",\"routines\":[");
    var routine_i: Int = 0;
    while routine_i < ArrayLength(facts.routines.names) {
        if routine_i > 0 { JsonProjectionAppend(fragments, ","); }
        if !SelfMirJsonRoutineWriteMemory(facts, routine_i, fragments) {
            return false;
        }
        routine_i = routine_i + 1;
    }
    JsonProjectionAppend(fragments, "]");
    if !SelfMirIntentExecutionJsonWriteMemory(facts.intent_execution, fragments) {
        return false;
    }
    JsonProjectionAppend(fragments, "}");
    return true;
}

func SelfMirProgramJson(facts: SelfMirProgramFacts) -> String {
    if !SelfMirProgramFactsReady(facts) { return ""; }
    var fragments: Array<String> = [];
    var json: String = "";
    if SelfMirProgramJsonRowsWriteMemory(facts, fragments) {
        json = StringJoin(fragments, "");
    }
    // One cleanup exit for success and rejection; StringJoin copies bytes.
    ArrayDropOwnedStrings(fragments);
    return json;
}
