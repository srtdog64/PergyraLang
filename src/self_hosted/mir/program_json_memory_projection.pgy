func SelfMirJsonBlockWriteMemory(
    facts: SelfMirProgramFacts,
    block_index: Int,
    inout fragments: Array<String>,
    emit_local_refs: Bool
) -> Bool {
    let blocks: SelfMirBlockRows = facts.cfg.blocks;
    JsonProjectionAppend(fragments, "{");
    JsonOwnedFragmentAppend(fragments, JsonEmitFieldNumber(
        "id", ToString(blocks.ids[block_index])
    ));
    JsonProjectionAppend(fragments, ",");
    JsonOwnedFragmentAppend(fragments, JsonEmitFieldBool(
        "reachable", blocks.reachable[block_index] == 1
    ));
    JsonProjectionAppend(fragments, ",\"instructions\":[");
    var instruction_i: Int = 0;
    while instruction_i < blocks.instruction_counts[block_index] {
        if instruction_i > 0 { JsonProjectionAppend(fragments, ","); }
        if !SelfMirJsonInstructionWriteMemory(
            facts,
            blocks.instruction_starts[block_index] + instruction_i,
            fragments, emit_local_refs
        ) { return false; }
        instruction_i = instruction_i + 1;
    }
    JsonProjectionAppend(fragments, "]");
    if blocks.intent_roles[block_index] != "" {
        JsonProjectionAppend(fragments, ",");
        JsonOwnedFragmentAppend(fragments, JsonEmitFieldString(
            "intent_block_role", blocks.intent_roles[block_index]));
    }
    if blocks.has_succ_true[block_index] == 1 {
        JsonProjectionAppend(fragments, ",");
        JsonOwnedFragmentAppend(fragments, JsonEmitFieldNumber(
            "succ_true", ToString(blocks.succ_true[block_index])
        ));
    }
    if blocks.has_succ_false[block_index] == 1 {
        JsonProjectionAppend(fragments, ",");
        JsonOwnedFragmentAppend(fragments, JsonEmitFieldNumber(
            "succ_false", ToString(blocks.succ_false[block_index])
        ));
    }
    JsonProjectionAppend(fragments, "}");
    return true;
}

