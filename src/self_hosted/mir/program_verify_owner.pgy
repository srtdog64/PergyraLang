// Structural verifier for the self-host MIR fact graph.

import "program_fact_owner.pgy";

func SelfMirParallelCount(count: Int, rows: Array<Int>) -> Bool {
    return ArrayLength(rows) == count;
}

func SelfMirParallelStringCount(count: Int, rows: Array<String>) -> Bool {
    return ArrayLength(rows) == count;
}

func SelfMirInstructionUsesLocalVersion(
    rows: SelfMirInstructionRows,
    instruction_index: Int,
    local_name: String
) -> Bool {
    let prefix: String = Concat(local_name, ".");
    let i: Int = 0;
    while i < rows.use_counts[instruction_index] {
        let use_name: String = rows.uses[
            rows.use_starts[instruction_index] + i
        ];
        if StringLength(use_name) > StringLength(prefix) &&
            Substring(use_name, 0, StringLength(prefix)) == prefix {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func SelfMirIndexedAssignmentUseReady(
    rows: SelfMirInstructionRows,
    instruction_index: Int
) -> Bool {
    if rows.source_types[instruction_index] != "AST_ASSIGNMENT" {
        return true;
    }
    let target: String = rows.expr1s[instruction_index];
    if target == "" {
        return false;
    }
    let index_open: Int = StringIndexOf(target, "[");
    if index_open < 0 {
        return true;
    }
    let base_name: String = StringTrim(Substring(target, 0, index_open));
    return base_name != "" && SelfMirInstructionUsesLocalVersion(
        rows, instruction_index, base_name
    );
}

func SelfMirDeclarationRowsReady(rows: SelfMirDeclarationRows) -> Bool {
    let count: Int = ArrayLength(rows.names);
    if !SelfMirParallelStringCount(count, rows.kinds) ||
        !SelfMirParallelStringCount(count, rows.nominal_kinds) ||
        !SelfMirParallelCount(count, rows.field_starts) ||
        !SelfMirParallelCount(count, rows.field_counts) ||
        !SelfMirParallelCount(count, rows.method_starts) ||
        !SelfMirParallelCount(count, rows.method_counts) ||
        !SelfMirParallelCount(count, rows.variant_starts) ||
        !SelfMirParallelCount(count, rows.variant_counts) ||
        ArrayLength(rows.field_names) != ArrayLength(rows.field_types) ||
        ArrayLength(rows.method_names) != ArrayLength(rows.method_returns) ||
        ArrayLength(rows.variant_names) !=
            ArrayLength(rows.variant_param_counts) {
        return false;
    }
    let field_cursor: Int = 0;
    let method_cursor: Int = 0;
    let variant_cursor: Int = 0;
    let i: Int = 0;
    while i < count {
        if rows.names[i] == "" || rows.kinds[i] == "" ||
            rows.nominal_kinds[i] == "" ||
            rows.field_starts[i] != field_cursor || rows.field_counts[i] < 0 ||
            rows.method_starts[i] != method_cursor ||
            rows.method_counts[i] < 0 ||
            rows.variant_starts[i] != variant_cursor ||
            rows.variant_counts[i] < 0 {
            return false;
        }
        field_cursor = field_cursor + rows.field_counts[i];
        method_cursor = method_cursor + rows.method_counts[i];
        variant_cursor = variant_cursor + rows.variant_counts[i];
        i = i + 1;
    }
    if field_cursor != ArrayLength(rows.field_names) ||
        method_cursor != ArrayLength(rows.method_names) ||
        variant_cursor != ArrayLength(rows.variant_names) {
        return false;
    }
    let variant_i: Int = 0;
    while variant_i < ArrayLength(rows.variant_names) {
        if rows.variant_names[variant_i] == "" ||
            rows.variant_param_counts[variant_i] < 0 {
            return false;
        }
        variant_i = variant_i + 1;
    }
    return true;
}

func SelfMirInstructionRowsReady(rows: SelfMirInstructionRows) -> Bool {
    let count: Int = ArrayLength(rows.ids);
    if !SelfMirParallelStringCount(count, rows.kinds) ||
        !SelfMirParallelStringCount(count, rows.names) ||
        !SelfMirParallelStringCount(count, rows.results) ||
        !SelfMirParallelStringCount(count, rows.arg0s) ||
        !SelfMirParallelStringCount(count, rows.arg1s) ||
        !SelfMirParallelStringCount(count, rows.expr0s) ||
        !SelfMirParallelStringCount(count, rows.expr1s) ||
        !SelfMirParallelStringCount(count, rows.source_types) ||
        !SelfMirParallelCount(count, rows.use_starts) ||
        !SelfMirParallelCount(count, rows.use_counts) ||
        !SelfMirExpressionGraphRowsReady(rows.expression_graphs, count) {
        return false;
    }
    let use_cursor: Int = 0;
    let i: Int = 0;
    while i < count {
        let kind: String = rows.kinds[i];
        if rows.use_starts[i] != use_cursor || rows.use_counts[i] < 0 ||
            (kind != "def" && kind != "stmt" && kind != "return" &&
             kind != "branch" && kind != "phi" && kind != "loop-init") {
            return false;
        }
        if kind == "branch" && rows.names[i] == "branch" &&
            rows.arg0s[i] == "" &&
            rows.source_types[i] != "AST_MATCH_CASE" &&
            rows.expression_graphs.has_roots[i] != 1 {
            return false;
        }
        if (kind == "def" &&
            (rows.arg0s[i] == "" || rows.expr0s[i] == "" ||
             rows.source_types[i] == "")) ||
            (kind == "stmt" && rows.expr0s[i] == "") ||
            (kind == "return" &&
             ((rows.expr0s[i] == "" &&
               rows.source_types[i] != "AST_RETURN_VOID") ||
              (rows.expr0s[i] != "" &&
               rows.source_types[i] == "AST_RETURN_VOID"))) ||
            (kind == "branch" && rows.expr0s[i] == "") ||
            (kind == "phi" && rows.results[i] == "") ||
            (kind == "loop-init" &&
             (rows.arg0s[i] == "" || rows.expr0s[i] == "" ||
              rows.expr1s[i] == "")) {
            return false;
        }
        if !SelfMirIndexedAssignmentUseReady(rows, i) {
            return false;
        }
        use_cursor = use_cursor + rows.use_counts[i];
        i = i + 1;
    }
    return use_cursor == ArrayLength(rows.uses);
}

func SelfMirIndexedAssignmentUseContractReady() -> Bool {
    let valid: SelfMirInstructionRows = SelfMirInstructionRows(
        [0], ["def"], ["ssa-def"], ["values.2"], ["values"], [""],
        ["values[j]"], ["values[i]"], ["AST_ASSIGNMENT"], [0], [3],
        ["values.1", "i.1", "j.1"],
        SelfMirExpressionGraphRowsForInstructionCount(1)
    );
    let missing_base_use: SelfMirInstructionRows = SelfMirInstructionRows(
        [0], ["def"], ["ssa-def"], ["values.2"], ["values"], [""],
        ["values[j]"], ["values[i]"], ["AST_ASSIGNMENT"], [0], [2],
        ["i.1", "j.1"], SelfMirExpressionGraphRowsForInstructionCount(1)
    );
    return SelfMirInstructionRowsReady(valid) &&
        !SelfMirInstructionRowsReady(missing_base_use);
}

func SelfMirBlockRowsValidationError(
    blocks: SelfMirBlockRows,
    instruction_count: Int
) -> String {
    let count: Int = ArrayLength(blocks.ids);
    if !SelfMirParallelCount(count, blocks.reachable) ||
        !SelfMirParallelCount(count, blocks.instruction_starts) ||
        !SelfMirParallelCount(count, blocks.instruction_counts) ||
        !SelfMirParallelCount(count, blocks.has_succ_true) ||
        !SelfMirParallelCount(count, blocks.succ_true) ||
        !SelfMirParallelCount(count, blocks.has_succ_false) ||
        !SelfMirParallelCount(count, blocks.succ_false) {
        return "MIR block parallel row counts differ";
    }
    let instruction_cursor: Int = 0;
    let i: Int = 0;
    while i < count {
        if blocks.instruction_starts[i] != instruction_cursor {
            let previous_fact: String = "";
            if i > 0 {
                previous_fact = Concat(" previous_start=", Concat(
                    ToString(blocks.instruction_starts[i - 1]), Concat(
                        " previous_count=", ToString(
                            blocks.instruction_counts[i - 1]
                        )
                    )
                ));
            }
            return Concat(
                "MIR block instruction start mismatch: block=", Concat(
                    ToString(i), Concat(" expected=", Concat(
                        ToString(instruction_cursor), Concat(
                            " actual=", Concat(
                                ToString(blocks.instruction_starts[i]),
                                previous_fact
                            )
                        )
                    ))
                )
            );
        }
        if blocks.instruction_counts[i] < 0 {
            return Concat("MIR block instruction count is negative: block=", ToString(i));
        }
        if (blocks.reachable[i] != 0 && blocks.reachable[i] != 1) ||
            (blocks.has_succ_true[i] != 0 && blocks.has_succ_true[i] != 1) ||
            (blocks.has_succ_false[i] != 0 && blocks.has_succ_false[i] != 1) {
            return Concat("MIR block flag is not binary: block=", ToString(i));
        }
        instruction_cursor = instruction_cursor + blocks.instruction_counts[i];
        i = i + 1;
    }
    if instruction_cursor != instruction_count {
        return Concat(
            "MIR block instruction total mismatch: expected=", Concat(
                ToString(instruction_count), Concat(
                    " actual=", ToString(instruction_cursor)
                )
            )
        );
    }
    return "";
}

func SelfMirBlockRowsFirstInstructionStartMismatch(
    blocks: SelfMirBlockRows
) -> Option<Int> {
    let instruction_cursor: Int = 0;
    let i: Int = 0;
    while i < ArrayLength(blocks.ids) {
        if blocks.instruction_starts[i] != instruction_cursor {
            return Some(i);
        }
        instruction_cursor = instruction_cursor + blocks.instruction_counts[i];
        i = i + 1;
    }
    return None;
}

func SelfMirRoutineNameForBlockRow(
    rows: SelfMirRoutineRows,
    block_row: Int
) -> String {
    let i: Int = 0;
    while i < ArrayLength(rows.node_ids) {
        if block_row >= rows.block_starts[i] &&
            block_row < rows.block_starts[i] + rows.block_counts[i] {
            return rows.names[i];
        }
        i = i + 1;
    }
    return "";
}

func SelfMirBlockRowsReady(
    blocks: SelfMirBlockRows,
    instruction_count: Int
) -> Bool {
    return SelfMirBlockRowsValidationError(blocks, instruction_count) == "";
}

func SelfMirRoutineRowsReady(
    rows: SelfMirRoutineRows,
    blocks: SelfMirBlockRows
) -> Bool {
    let count: Int = ArrayLength(rows.node_ids);
    if !SelfMirParallelStringCount(count, rows.names) ||
        !SelfMirParallelStringCount(count, rows.kinds) ||
        !SelfMirParallelStringCount(count, rows.owners) ||
        !SelfMirParallelStringCount(count, rows.return_types) ||
        !SelfMirParallelCount(count, rows.param_starts) ||
        !SelfMirParallelCount(count, rows.param_counts) ||
        !SelfMirParallelCount(count, rows.block_starts) ||
        !SelfMirParallelCount(count, rows.block_counts) ||
        !SelfMirParallelCount(count, rows.local_starts) ||
        !SelfMirParallelCount(count, rows.local_counts) ||
        ArrayLength(rows.param_names) != ArrayLength(rows.param_types) ||
        ArrayLength(rows.param_names) != ArrayLength(rows.param_abi_kinds) ||
        ArrayLength(rows.local_names) != ArrayLength(rows.local_types) {
        return false;
    }
    let param_cursor: Int = 0;
    let block_cursor: Int = 0;
    let local_cursor: Int = 0;
    let i: Int = 0;
    while i < count {
        if rows.names[i] == "" || rows.return_types[i] == "" ||
            (rows.kinds[i] != "function" && rows.kinds[i] != "method") ||
            (rows.kinds[i] == "method" && rows.owners[i] == "") ||
            rows.param_starts[i] != param_cursor || rows.param_counts[i] < 0 ||
            rows.block_starts[i] != block_cursor || rows.block_counts[i] <= 0 ||
            rows.local_starts[i] != local_cursor || rows.local_counts[i] < 0 {
            return false;
        }
        let block_i: Int = 0;
        while block_i < rows.block_counts[i] {
            let row: Int = rows.block_starts[i] + block_i;
            if blocks.ids[row] != block_i ||
                (blocks.has_succ_true[row] == 1 &&
                 (blocks.succ_true[row] < 0 ||
                  blocks.succ_true[row] >= rows.block_counts[i])) ||
                (blocks.has_succ_false[row] == 1 &&
                 (blocks.succ_false[row] < 0 ||
                  blocks.succ_false[row] >= rows.block_counts[i])) {
                return false;
            }
            block_i = block_i + 1;
        }
        param_cursor = param_cursor + rows.param_counts[i];
        block_cursor = block_cursor + rows.block_counts[i];
        local_cursor = local_cursor + rows.local_counts[i];
        i = i + 1;
    }
    let param_i: Int = 0;
    while param_i < ArrayLength(rows.param_abi_kinds) {
        if rows.param_abi_kinds[param_i] < 0 ||
            rows.param_abi_kinds[param_i] > 4 {
            return false;
        }
        param_i = param_i + 1;
    }
    return param_cursor == ArrayLength(rows.param_names) &&
        block_cursor == ArrayLength(blocks.ids) &&
        local_cursor == ArrayLength(rows.local_names);
}

func SelfMirProgramFactsValidationError(facts: SelfMirProgramFacts) -> String {
    if !facts.ok {
        if facts.diagnostic_message != "" { return facts.diagnostic_message; }
        return "MIR producer status is not ok";
    }
    if facts.artifact_node_count <= 0 { return "MIR artifact node count is empty"; }
    if !SelfMirDeclarationRowsReady(facts.declarations) {
        return "MIR declaration rows are invalid";
    }
    if !SelfMirParallelCaptureRowsReady(facts.parallel_captures) {
        return "MIR parallel capture rows are invalid";
    }
    if !SelfMirInstructionRowsReady(facts.cfg.instructions) {
        return "MIR instruction rows are invalid";
    }
    if !SelfMirBlockRowsReady(
        facts.cfg.blocks, ArrayLength(facts.cfg.instructions.ids)
    ) {
        let block_error: String = SelfMirBlockRowsValidationError(
            facts.cfg.blocks, ArrayLength(facts.cfg.instructions.ids)
        );
        let block_row: Option<Int> = SelfMirBlockRowsFirstInstructionStartMismatch(
            facts.cfg.blocks
        );
        if IsSome(block_row) {
            return Concat(block_error, Concat(
                " routine=", SelfMirRoutineNameForBlockRow(
                    facts.routines, UnwrapOption(block_row)
                )
            ));
        }
        return block_error;
    }
    if !SelfMirRoutineRowsReady(facts.routines, facts.cfg.blocks) {
        return "MIR routine rows are invalid";
    }
    if ArrayLength(facts.routines.node_ids) == 0 {
        return "MIR routine inventory is empty";
    }
    return "";
}

func SelfMirProgramFactsReady(facts: SelfMirProgramFacts) -> Bool {
    return SelfMirProgramFactsValidationError(facts) == "";
}
