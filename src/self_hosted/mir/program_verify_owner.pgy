// Structural verifier for the self-host MIR fact graph.

import "program_fact_owner.pgy";
import "instruction_validation_owner.pgy";

func SelfMirParallelCount(count: Int, rows: Array<Int>) -> Bool {
    return ArrayLength(rows) == count;
}

func SelfMirParallelStringCount(count: Int, rows: Array<String>) -> Bool {
    return ArrayLength(rows) == count;
}

func SelfMirInstructionUsesLocalVersion(
    rows: SelfMirInstructionRows,
    instruction_index: Int,
    local_name: String
) -> Bool {
    let prefix: String = Concat(local_name, ".");
    let i: Int = 0;
    while i < rows.use_counts[instruction_index] {
        let use_name: String = rows.uses[
            rows.use_starts[instruction_index] + i
        ];
        if StringLength(use_name) > StringLength(prefix) &&
            Substring(use_name, 0, StringLength(prefix)) == prefix {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func SelfMirAssignmentTargetGraphBaseText(
    ref rows: SelfMirExpressionGraphRows,
    root: Int
) -> Option<String> {
    let cursor: Int = root;
    let traversed: Int = 0;
    while cursor >= 0 && cursor < ArrayLength(rows.node_kinds) &&
        traversed < ArrayLength(rows.node_kinds) {
        let kind: Int = rows.node_kinds[cursor];
        if kind == AstExpressionNodeLeaf() {
            return Some(rows.node_texts[cursor]);
        }
        if kind != AstExpressionNodeIndex() &&
            kind != AstExpressionNodeMemberAccess() {
            return None;
        }
        cursor = rows.left_children[cursor];
        traversed = traversed + 1;
    }
    return None;
}

func SelfMirAssignmentTargetGraphValidationError(
    rows: SelfMirInstructionRows,
    instruction_index: Int
) -> String {
    if rows.source_types[instruction_index] != "AST_ASSIGNMENT" {
        return "";
    }
    let target: String = rows.expr1s[instruction_index];
    let base_name: String = rows.arg0s[instruction_index];
    if target == "" || base_name == "" {
        return Concat(
            "target/base is empty: target=", Concat(
                target, Concat(" base=", base_name)
            )
        );
    }
    if rows.expr1_graphs.has_roots[instruction_index] != 1 {
        return "target graph root is missing";
    }
    let root: Int = rows.expr1_graphs.roots[instruction_index];
    if target == base_name {
        if rows.expr1_graphs.node_kinds[root] != AstExpressionNodeLeaf() {
            return Concat(
                "simple target root kind differs: target=", target
            );
        }
        if rows.expr1_graphs.node_texts[root] != target {
            return Concat(
                "simple target root text differs: target=", Concat(
                    target, Concat(
                        " graph=", rows.expr1_graphs.node_texts[root]
                    )
                )
            );
        }
        return "";
    }
    let root_kind: Int = rows.expr1_graphs.node_kinds[root];
    if (root_kind != AstExpressionNodeIndex() &&
        root_kind != AstExpressionNodeMemberAccess()) ||
        rows.expr1_graphs.node_texts[root] != target {
        return Concat(
            "projected target root differs: target=", Concat(
                target, Concat(
                    " graph=", rows.expr1_graphs.node_texts[root]
                )
            )
        );
    }
    let graph_base: Option<String> = SelfMirAssignmentTargetGraphBaseText(
        rows.expr1_graphs, root
    );
    if !IsSome(graph_base) || UnwrapOption(graph_base) != base_name {
        let graph_base_text: String = "<missing>";
        if IsSome(graph_base) { graph_base_text = UnwrapOption(graph_base); }
        return Concat(
            "projected target receiver differs: base=", Concat(
                base_name, Concat(
                    " graph=", graph_base_text
                )
            )
        );
    }
    if !SelfMirInstructionUsesLocalVersion(
        rows, instruction_index, base_name
    ) {
        return Concat(
            "projected target base use is missing: base=", base_name
        );
    }
    return "";
}

func SelfMirAssignmentTargetGraphReady(
    rows: SelfMirInstructionRows,
    instruction_index: Int
) -> Bool {
    return SelfMirAssignmentTargetGraphValidationError(
        rows, instruction_index
    ) == "";
}

func SelfMirDeclarationRowsReady(rows: SelfMirDeclarationRows) -> Bool {
    let count: Int = ArrayLength(rows.names);
    if !SelfMirParallelStringCount(count, rows.kinds) ||
        !SelfMirParallelStringCount(count, rows.nominal_kinds) ||
        !SelfMirParallelStringCount(count, rows.target_types) ||
        !SelfMirParallelCount(count, rows.field_starts) ||
        !SelfMirParallelCount(count, rows.field_counts) ||
        !SelfMirParallelCount(count, rows.method_starts) ||
        !SelfMirParallelCount(count, rows.method_counts) ||
        !SelfMirParallelCount(count, rows.variant_starts) ||
        !SelfMirParallelCount(count, rows.variant_counts) ||
        ArrayLength(rows.field_names) != ArrayLength(rows.field_types) ||
        ArrayLength(rows.method_names) != ArrayLength(rows.method_returns) ||
        ArrayLength(rows.variant_names) !=
            ArrayLength(rows.variant_param_counts) {
        return false;
    }
    let field_cursor: Int = 0;
    let method_cursor: Int = 0;
    let variant_cursor: Int = 0;
    let i: Int = 0;
    while i < count {
        if rows.names[i] == "" || rows.kinds[i] == "" ||
            rows.nominal_kinds[i] == "" ||
            (rows.kinds[i] == "role" && rows.target_types[i] == "") ||
            rows.field_starts[i] != field_cursor || rows.field_counts[i] < 0 ||
            rows.method_starts[i] != method_cursor ||
            rows.method_counts[i] < 0 ||
            rows.variant_starts[i] != variant_cursor ||
            rows.variant_counts[i] < 0 {
            return false;
        }
        field_cursor = field_cursor + rows.field_counts[i];
        method_cursor = method_cursor + rows.method_counts[i];
        variant_cursor = variant_cursor + rows.variant_counts[i];
        i = i + 1;
    }
    if field_cursor != ArrayLength(rows.field_names) ||
        method_cursor != ArrayLength(rows.method_names) ||
        variant_cursor != ArrayLength(rows.variant_names) {
        return false;
    }
    let variant_i: Int = 0;
    while variant_i < ArrayLength(rows.variant_names) {
        if rows.variant_names[variant_i] == "" ||
            rows.variant_param_counts[variant_i] < 0 {
            return false;
        }
        variant_i = variant_i + 1;
    }
    return true;
}

func SelfMirInstructionRowsReady(rows: SelfMirInstructionRows) -> Bool {
    return SelfMirInstructionRowsValidationError(rows) == "";
}

func SelfMirAssignmentTargetGraphContractReady() -> Bool {
    let no_uses: Array<String> = [];
    let value_graph: SelfMirExpressionGraphRows =
        SelfMirExpressionGraphRows(
            [1], [0], [0], [1], [AstExpressionNodeLeaf()], ["values[j]"],
            [0], [0], [SemanticCallTargetNone()], [""]
        );
    let target_graph: SelfMirExpressionGraphRows =
        SelfMirExpressionGraphRows(
            [1], [2], [0], [3],
            [AstExpressionNodeLeaf(), AstExpressionNodeLeaf(),
             AstExpressionNodeIndex()],
            ["values", "i", "values[i]"], [0, 0, 0], [0, 0, 1],
            [SemanticCallTargetNone(), SemanticCallTargetNone(),
            SemanticCallTargetNone()], ["", "", ""]
        );
    let simple_value_graph: SelfMirExpressionGraphRows =
        SelfMirExpressionGraphRows(
            [1], [0], [0], [1], [AstExpressionNodeLeaf()], ["1"],
            [0], [0], [SemanticCallTargetNone()], [""]
        );
    let simple_target_graph: SelfMirExpressionGraphRows =
        SelfMirExpressionGraphRows(
            [1], [0], [0], [1], [AstExpressionNodeLeaf()], ["x"],
            [0], [0], [SemanticCallTargetNone()], [""]
        );
    let no_match_facts: SelfMirMatchFactRows = SelfMirMatchFactRowsEmpty();
    let no_destructure_facts: SelfMirDestructureFactRows =
        SelfMirDestructureFactRowsEmpty();
    let member_target_graph: SelfMirExpressionGraphRows =
        SelfMirExpressionGraphRows(
            [1], [2], [0], [3],
            [AstExpressionNodeLeaf(), AstExpressionNodeLeaf(),
             AstExpressionNodeMemberAccess()],
            ["base", "text", "base.text"], [0, 0, 0], [0, 0, 1],
            [SemanticCallTargetNone(), SemanticCallTargetNone(),
             SemanticCallTargetNone()], ["", "", ""]
        );
    let valid: SelfMirInstructionRows = SelfMirInstructionRows(
        [0], ["def"], ["ssa-def"], ["values.2"], ["values"], [""],
        ["values[j]"], ["values[i]"], ["AST_ASSIGNMENT"],
        [""], [""], [""], [0], [0], [""], [""], [0], [0], [0], [0], [3],
        ["values.1", "i.1", "j.1"],
        value_graph, target_graph, no_match_facts, no_destructure_facts
    );
    let valid_simple: SelfMirInstructionRows = SelfMirInstructionRows(
        [0], ["def"], ["ssa-def"], ["x.2"], ["x"], [""],
        ["1"], ["x"], ["AST_ASSIGNMENT"],
        [""], [""], [""], [0], [0], [""], [""], [0], [0], [0],
        [0], [0], no_uses,
        simple_value_graph, simple_target_graph, no_match_facts,
        no_destructure_facts
    );
    let valid_member: SelfMirInstructionRows = SelfMirInstructionRows(
        [0], ["def"], ["ssa-def"], ["base.2"], ["base"], [""],
        ["1"], ["base.text"], ["AST_ASSIGNMENT"],
        [""], [""], [""], [0], [0], [""], [""], [0], [0], [0],
        [0], [1], ["base.1"], simple_value_graph, member_target_graph,
        no_match_facts, no_destructure_facts
    );
    let missing_base_use: SelfMirInstructionRows = SelfMirInstructionRows(
        [0], ["def"], ["ssa-def"], ["values.2"], ["values"], [""],
        ["values[j]"], ["values[i]"], ["AST_ASSIGNMENT"],
        [""], [""], [""], [0], [0], [""], [""], [0], [0], [0], [0], [2],
        ["i.1", "j.1"], value_graph, target_graph, no_match_facts,
        no_destructure_facts
    );
    let missing_target_graph: SelfMirInstructionRows = SelfMirInstructionRows(
        [0], ["def"], ["ssa-def"], ["values.2"], ["values"], [""],
        ["values[j]"], ["values[i]"], ["AST_ASSIGNMENT"],
        [""], [""], [""], [0], [0], [""], [""], [0], [0], [0], [0], [3],
        ["values.1", "i.1", "j.1"], value_graph,
        SelfMirExpressionGraphRowsForInstructionCount(1), no_match_facts,
        no_destructure_facts
    );
    let missing_member_base_use: SelfMirInstructionRows =
        SelfMirInstructionRows(
            [0], ["def"], ["ssa-def"], ["base.2"], ["base"], [""],
            ["1"], ["base.text"], ["AST_ASSIGNMENT"],
            [""], [""], [""], [0], [0], [""], [""], [0], [0], [0],
            [0], [0], no_uses, simple_value_graph, member_target_graph,
            no_match_facts, no_destructure_facts
        );
    let missing_simple_target_graph: SelfMirInstructionRows =
        SelfMirInstructionRows(
            [0], ["def"], ["ssa-def"], ["x.2"], ["x"], [""],
            ["1"], ["x"], ["AST_ASSIGNMENT"],
            [""], [""], [""], [0], [0], [""], [""], [0], [0], [0],
            [0], [0], no_uses,
            simple_value_graph,
            SelfMirExpressionGraphRowsForInstructionCount(1), no_match_facts,
            no_destructure_facts
        );
    let scalar_match_facts: SelfMirMatchFactRows =
        SelfMirMatchFactRowsAttachCase(
            SelfMirMatchFactRowsEmpty(), 0, "1", "", ""
        );
    let valid_match: SelfMirInstructionRows = SelfMirInstructionRows(
        [0], ["branch"], ["branch"], [""], [""], [""],
        ["x"], [""], ["AST_MATCH_CASE"],
        [""], [""], [""], [0], [0], [""], [""], [0], [0], [0],
        [0], [1], ["x.1"], simple_target_graph,
        SelfMirExpressionGraphRowsForInstructionCount(1), scalar_match_facts,
        no_destructure_facts
    );
    let missing_match: SelfMirInstructionRows = SelfMirInstructionRows(
        [0], ["branch"], ["branch"], [""], [""], [""],
        ["x"], [""], ["AST_MATCH_CASE"],
        [""], [""], [""], [0], [0], [""], [""], [0], [0], [0],
        [0], [1], ["x.1"], simple_target_graph,
        SelfMirExpressionGraphRowsForInstructionCount(1), no_match_facts,
        no_destructure_facts
    );
    let destructure_facts: SelfMirDestructureFactRows =
        SelfMirDestructureFactRowsAttach(
            SelfMirDestructureFactRowsEmpty(), 0, "String", ["a", "b"]
        );
    let valid_destructure: SelfMirInstructionRows = SelfMirInstructionRows(
        [0], ["destructure"], ["destructure"], [""], [""], [""],
        ["Split(csv, \",\")"], [""], ["AST_LET_DESTRUCTURE"],
        [""], [""], [""], [0], [0], [""], [""], [0], [0], [0],
        [0], [0], no_uses, value_graph,
        SelfMirExpressionGraphRowsForInstructionCount(1), no_match_facts,
        destructure_facts
    );
    let missing_destructure: SelfMirInstructionRows = SelfMirInstructionRows(
        [0], ["destructure"], ["destructure"], [""], [""], [""],
        ["Split(csv, \",\")"], [""], ["AST_LET_DESTRUCTURE"],
        [""], [""], [""], [0], [0], [""], [""], [0], [0], [0],
        [0], [0], no_uses, value_graph,
        SelfMirExpressionGraphRowsForInstructionCount(1), no_match_facts,
        no_destructure_facts
    );
    return SelfMirInstructionRowsReady(valid) &&
        SelfMirInstructionRowsReady(valid_simple) &&
        SelfMirInstructionRowsReady(valid_member) &&
        SelfMirInstructionRowsReady(valid_match) &&
        SelfMirInstructionRowsReady(valid_destructure) &&
        !SelfMirInstructionRowsReady(missing_base_use) &&
        !SelfMirInstructionRowsReady(missing_member_base_use) &&
        !SelfMirInstructionRowsReady(missing_target_graph) &&
        !SelfMirInstructionRowsReady(missing_simple_target_graph) &&
        !SelfMirInstructionRowsReady(missing_match) &&
        !SelfMirInstructionRowsReady(missing_destructure);
}

func SelfMirBlockRowsValidationError(
    blocks: SelfMirBlockRows,
    instruction_count: Int
) -> String {
    let count: Int = ArrayLength(blocks.ids);
    if !SelfMirParallelCount(count, blocks.reachable) ||
        !SelfMirParallelCount(count, blocks.instruction_starts) ||
        !SelfMirParallelCount(count, blocks.instruction_counts) ||
        !SelfMirParallelCount(count, blocks.has_succ_true) ||
        !SelfMirParallelCount(count, blocks.succ_true) ||
        !SelfMirParallelCount(count, blocks.has_succ_false) ||
        !SelfMirParallelCount(count, blocks.succ_false) {
        return "MIR block parallel row counts differ";
    }
    let instruction_cursor: Int = 0;
    let i: Int = 0;
    while i < count {
        if blocks.instruction_starts[i] != instruction_cursor {
            let previous_fact: String = "";
            if i > 0 {
                previous_fact = Concat(" previous_start=", Concat(
                    ToString(blocks.instruction_starts[i - 1]), Concat(
                        " previous_count=", ToString(
                            blocks.instruction_counts[i - 1]
                        )
                    )
                ));
            }
            return Concat(
                "MIR block instruction start mismatch: block=", Concat(
                    ToString(i), Concat(" expected=", Concat(
                        ToString(instruction_cursor), Concat(
                            " actual=", Concat(
                                ToString(blocks.instruction_starts[i]),
                                previous_fact
                            )
                        )
                    ))
                )
            );
        }
        if blocks.instruction_counts[i] < 0 {
            return Concat("MIR block instruction count is negative: block=", ToString(i));
        }
        if (blocks.reachable[i] != 0 && blocks.reachable[i] != 1) ||
            (blocks.has_succ_true[i] != 0 && blocks.has_succ_true[i] != 1) ||
            (blocks.has_succ_false[i] != 0 && blocks.has_succ_false[i] != 1) {
            return Concat("MIR block flag is not binary: block=", ToString(i));
        }
        instruction_cursor = instruction_cursor + blocks.instruction_counts[i];
        i = i + 1;
    }
    if instruction_cursor != instruction_count {
        return Concat(
            "MIR block instruction total mismatch: expected=", Concat(
                ToString(instruction_count), Concat(
                    " actual=", ToString(instruction_cursor)
                )
            )
        );
    }
    return "";
}

func SelfMirBlockRowsFirstInstructionStartMismatch(
    blocks: SelfMirBlockRows
) -> Option<Int> {
    let instruction_cursor: Int = 0;
    let i: Int = 0;
    while i < ArrayLength(blocks.ids) {
        if blocks.instruction_starts[i] != instruction_cursor {
            return Some(i);
        }
        instruction_cursor = instruction_cursor + blocks.instruction_counts[i];
        i = i + 1;
    }
    return None;
}

func SelfMirRoutineNameForBlockRow(
    rows: SelfMirRoutineRows,
    block_row: Int
) -> String {
    let i: Int = 0;
    while i < ArrayLength(rows.node_ids) {
        if block_row >= rows.block_starts[i] &&
            block_row < rows.block_starts[i] + rows.block_counts[i] {
            return rows.names[i];
        }
        i = i + 1;
    }
    return "";
}

func SelfMirBlockRowsReady(
    blocks: SelfMirBlockRows,
    instruction_count: Int
) -> Bool {
    return SelfMirBlockRowsValidationError(blocks, instruction_count) == "";
}

func SelfMirRoutineRowsReady(
    rows: SelfMirRoutineRows,
    blocks: SelfMirBlockRows
) -> Bool {
    let count: Int = ArrayLength(rows.node_ids);
    if !SelfMirParallelStringCount(count, rows.names) ||
        !SelfMirParallelStringCount(count, rows.kinds) ||
        !SelfMirParallelStringCount(count, rows.owners) ||
        !SelfMirParallelStringCount(count, rows.return_types) ||
        !SelfMirParallelCount(count, rows.generic_starts) ||
        !SelfMirParallelCount(count, rows.generic_counts) ||
        !SelfMirParallelCount(count, rows.param_starts) ||
        !SelfMirParallelCount(count, rows.param_counts) ||
        !SelfMirParallelCount(count, rows.block_starts) ||
        !SelfMirParallelCount(count, rows.block_counts) ||
        !SelfMirParallelCount(count, rows.local_starts) ||
        !SelfMirParallelCount(count, rows.local_counts) ||
        ArrayLength(rows.param_names) != ArrayLength(rows.param_types) ||
        ArrayLength(rows.param_names) != ArrayLength(rows.param_abi_kinds) ||
        ArrayLength(rows.local_names) != ArrayLength(rows.local_types) ||
        !SelfMirDestructureTypeFactRowsReady(
            rows.destructure_type_facts, count
        ) ||
        !SelfMirLoopFlowRowsReady(rows.loop_flows, count) {
        return false;
    }
    let param_cursor: Int = 0;
    let generic_cursor: Int = 0;
    let block_cursor: Int = 0;
    let local_cursor: Int = 0;
    let i: Int = 0;
    while i < count {
        if rows.names[i] == "" || rows.return_types[i] == "" ||
            (rows.kinds[i] != "function" && rows.kinds[i] != "method") ||
            (rows.kinds[i] == "method" && rows.owners[i] == "") ||
            rows.generic_starts[i] != generic_cursor ||
            rows.generic_counts[i] < 0 ||
            rows.param_starts[i] != param_cursor || rows.param_counts[i] < 0 ||
            rows.block_starts[i] != block_cursor || rows.block_counts[i] <= 0 ||
            rows.local_starts[i] != local_cursor || rows.local_counts[i] < 0 {
            return false;
        }
        let block_i: Int = 0;
        while block_i < rows.block_counts[i] {
            let row: Int = rows.block_starts[i] + block_i;
            if blocks.ids[row] != block_i ||
                (blocks.has_succ_true[row] == 1 &&
                 (blocks.succ_true[row] < 0 ||
                  blocks.succ_true[row] >= rows.block_counts[i])) ||
                (blocks.has_succ_false[row] == 1 &&
                 (blocks.succ_false[row] < 0 ||
                  blocks.succ_false[row] >= rows.block_counts[i])) {
                return false;
            }
            block_i = block_i + 1;
        }
        let generic_i: Int = 0;
        while generic_i < rows.generic_counts[i] {
            if rows.generic_names[generic_cursor + generic_i] == "" {
                return false;
            }
            generic_i = generic_i + 1;
        }
        let destructure_i: Int = 0;
        let destructure_start: Int =
            rows.destructure_type_facts.routine_starts[i];
        while destructure_i <
            rows.destructure_type_facts.routine_counts[i] {
            let destructure_row: Int = destructure_start + destructure_i;
            if rows.destructure_type_facts.function_syntax_ids[
                    destructure_row
                ] != rows.node_ids[i] {
                return false;
            }
            destructure_i = destructure_i + 1;
        }
        generic_cursor = generic_cursor + rows.generic_counts[i];
        param_cursor = param_cursor + rows.param_counts[i];
        block_cursor = block_cursor + rows.block_counts[i];
        local_cursor = local_cursor + rows.local_counts[i];
        i = i + 1;
    }
    let param_i: Int = 0;
    while param_i < ArrayLength(rows.param_abi_kinds) {
        if rows.param_abi_kinds[param_i] < 0 ||
            rows.param_abi_kinds[param_i] > 4 {
            return false;
        }
        param_i = param_i + 1;
    }
    return generic_cursor == ArrayLength(rows.generic_names) &&
        param_cursor == ArrayLength(rows.param_names) &&
        block_cursor == ArrayLength(blocks.ids) &&
        local_cursor == ArrayLength(rows.local_names);
}

func SelfMirProgramFactsValidationError(facts: SelfMirProgramFacts) -> String {
    if !facts.ok {
        if facts.diagnostic_message != "" { return facts.diagnostic_message; }
        return "MIR producer status is not ok";
    }
    if facts.artifact_node_count <= 0 { return "MIR artifact node count is empty"; }
    if !SelfMirDeclarationRowsReady(facts.declarations) {
        return "MIR declaration rows are invalid";
    }
    if !SelfMirGenericSpecializationRowsReady(
        facts.generic_specializations
    ) {
        return "MIR generic specialization rows are invalid";
    }
    if !SelfMirParallelCaptureRowsReady(facts.parallel_captures) {
        return "MIR parallel capture rows are invalid";
    }
    if !SelfMirInstructionRowsReady(facts.cfg.instructions) {
        return Concat(
            "MIR instruction rows are invalid: ",
            SelfMirInstructionRowsValidationError(facts.cfg.instructions)
        );
    }
    if !SelfMirBlockRowsReady(
        facts.cfg.blocks, ArrayLength(facts.cfg.instructions.ids)
    ) {
        let block_error: String = SelfMirBlockRowsValidationError(
            facts.cfg.blocks, ArrayLength(facts.cfg.instructions.ids)
        );
        let block_row: Option<Int> = SelfMirBlockRowsFirstInstructionStartMismatch(
            facts.cfg.blocks
        );
        if IsSome(block_row) {
            return Concat(block_error, Concat(
                " routine=", SelfMirRoutineNameForBlockRow(
                    facts.routines, UnwrapOption(block_row)
                )
            ));
        }
        return block_error;
    }
    if !SelfMirRoutineRowsReady(facts.routines, facts.cfg.blocks) {
        return "MIR routine rows are invalid";
    }
    if ArrayLength(facts.routines.node_ids) == 0 {
        return "MIR routine inventory is empty";
    }
    return "";
}

func SelfMirProgramFactsReady(facts: SelfMirProgramFacts) -> Bool {
    return SelfMirProgramFactsValidationError(facts) == "";
}
