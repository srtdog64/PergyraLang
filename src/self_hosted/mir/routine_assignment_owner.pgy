// MIR assignment state transformer.

import "routine_input_owner.pgy";
import "routine_build_owner.pgy";
import "routine_local_ref_attachment_owner.pgy";
import "routine_source_statement_attachment_owner.pgy";
import "routine_expression_use_owner.pgy";
import "expression_fact_owner.pgy";
import "../semantic/callable_receiver_carriage_policy_owner.pgy";
import "../semantic/ast_nominal_constructor_lookup_owner.pgy";

// A member store through a mutable-identity receiver (`self.value = ...` in a
// subject action) writes the receiver's cell in place. It is an `assign` with
// no new SSA version of `self`, the shape the native producer emits: an SSA
// definition would name a receiver copy, and reads after it would see that
// copy instead of the cell.
func SelfMirAssignmentStoresThroughIdentityReceiver(
    ref input: SelfMirRoutineInput, ref build: SelfMirRoutineBuild,
    assignment_index: Int, local_index: Int, target: String, target_text: String
) -> Bool {
    if target_text == target { return false; }
    let function_node_id: Int =
        input.analysis.assignments.function_node_ids[assignment_index];
    if build.local_refs[local_index] != SelfMirLocalRef("parameter", function_node_id, 0) {
        return false;
    }
    let signature_opt: Option<Int> = SemanticAstFunctionSignatureIndexForNode(
        input.analysis.signatures, function_node_id);
    if !IsSome(signature_opt) { return false; }
    let signature: Int = UnwrapOption(signature_opt);
    if input.analysis.signatures.receiver_source_param_offsets[signature] != 1 { return false; }
    let owner: String = Concat("", input.analysis.signatures.owner_names[signature]);
    let row: Option<Int> = SemanticAstNominalConstructorIndexForName(
        input.analysis.constructors, owner);
    return IsSome(row) && CallableReceiverNominalKindUsesMutableIdentity(
        input.analysis.constructors.nominal_kinds[UnwrapOption(row)]);
}

func SelfMirLowerAssignmentFromArtifact(
    ref input: SelfMirRoutineInput,
    build: SelfMirRoutineBuild,
    node_id: Int
) -> SelfMirRoutineBuild {
    let assignment_index_opt: Option<Int> =
        SemanticAstAssignmentIndexForNode(
            input.analysis.assignments, node_id
        );
    if !IsSome(assignment_index_opt) {
        return SelfMirRoutineBuildError(
            build, "MIR assignment is missing semantic facts"
        );
    }
    let assignment_index: Int = UnwrapOption(assignment_index_opt);
    let operation: Int = input.analysis.assignments.operations[assignment_index];
    let opcode: Option<String> = AssignmentOperationMirName(operation);
    if !IsSome(opcode) { return SelfMirRoutineBuildError(build, "MIR assignment operation is missing"); }
    let target: String =
        input.analysis.assignments.target_root_names[assignment_index];
    let target_text: String =
        input.analysis.assignments.target_texts[assignment_index];
    let binding_row_opt: Option<Int> = SelfMirAssignmentRowForNodeFromReadyRows(
        input.assignments, node_id
    );
    if !IsSome(binding_row_opt) {
        return SelfMirRoutineBuildError(
            build, "MIR assignment target binding fact is missing"
        );
    }
    let binding_row: Int = UnwrapOption(binding_row_opt);
    let binding_mode: String =
        input.assignments.target_binding_modes[binding_row];
    var local_opt: Option<Int> = SelfMirRoutineLocalIndex(build, target);
    if !IsSome(local_opt) && binding_mode == "mutable_owner_field" {
        build = SelfMirRoutineAddLocal(
            build, target,
            input.assignments.target_type_names[binding_row], 0,
            SelfMirLocalRef("owner-field", node_id, 0)
        );
        local_opt = SelfMirRoutineLocalIndex(build, target);
    }
    if !IsSome(local_opt) {
        return SelfMirRoutineBuildError(
            build, Concat("MIR assignment target is unknown: ", target)
        );
    }
    let local_index: Int = UnwrapOption(local_opt);
    if target_text == target &&
        build.local_types[local_index] !=
        input.assignments.target_type_names[binding_row] {
        return SelfMirRoutineBuildError(
            build, Concat(
                "MIR assignment target binding type drifted: target=",
                Concat(target, Concat(
                    " node=", Concat(ToString(node_id), Concat(
                        " local_type=", Concat(
                            build.local_types[local_index], Concat(
                                " semantic_type=",
                                input.assignments.target_type_names[binding_row]
                            )
                        )
                    ))
                ))
            )
        );
    }
    let expression: String =
        input.analysis.assignments.value_texts[assignment_index];
    let value_graph: SemanticExpressionGraphView =
        SemanticAstExpressionGraphForNode(
            input.analysis.expression_surfaces,
            node_id, AstExpressionLaneValue()
        );
    let target_graph: SemanticExpressionGraphView =
        SemanticAstExpressionGraphForNode(
            input.analysis.expression_surfaces,
            node_id, AstExpressionLaneAtom()
        );
    var uses: Array<String> = [];
    if binding_mode == "mutable_owner_field" &&
        SelfMirExpressionGraphContainsLeafBinding(value_graph, target) {
        SelfMirUsesAppendUnique(uses, SelfMirSsaName(target, 0));
    }
    if target_text != target || operation != 0 {
        if binding_mode == "mutable_owner_field" &&
            SelfMirExpressionGraphContainsLeafBinding(target_graph, target) {
            SelfMirUsesAppendUnique(uses, SelfMirSsaName(target, 0));
        }
        let target_uses: Array<String> =
            SelfMirExpressionGraphUses(build, target_graph);
        var target_use_i: Int = 0;
        while target_use_i < ArrayLength(target_uses) {
            SelfMirUsesAppendUnique(uses, Concat("", target_uses[target_use_i]));
            target_use_i = target_use_i + 1;
        }
    }
    let value_uses: Array<String> =
        SelfMirExpressionGraphUses(build, value_graph);
    var value_use_i: Int = 0;
    while value_use_i < ArrayLength(value_uses) {
        SelfMirUsesAppendUnique(uses, Concat("", value_uses[value_use_i]));
        value_use_i = value_use_i + 1;
    }
    if SelfMirAssignmentStoresThroughIdentityReceiver(
            input, build, assignment_index, local_index, target, target_text) {
        // A plain store is named `assign`, as the native producer names it.
        var store_name: String = UnwrapOption(opcode);
        if operation == 0 { store_name = "assign"; }
        build = SelfMirRoutineAddInstruction(
            build, "assign", store_name, "", "",
            SemanticAssignmentMirCarriage(binding_mode), target_text, expression,
            "AST_ASSIGNMENT", uses
        );
        build = SelfMirRoutineAttachLastSourceStatement(build, node_id);
        build = SelfMirRoutineAttachLastExpressionGraph(
            build, target_graph, input.machine_declaration
        );
        return SelfMirRoutineAttachLastSecondaryExpressionGraph(build, value_graph);
    }
    build = SelfMirRoutineAdvanceLocalVersion(build, local_index);
    let version: Int = build.local_versions[local_index];
    build = SelfMirRoutineAddInstruction(
        build, "def", UnwrapOption(opcode), SelfMirSsaName(target, version),
        target, SemanticAssignmentMirCarriage(binding_mode), expression, target_text,
        "AST_ASSIGNMENT", uses
    );
    build = SelfMirRoutineAttachLastPrimaryLocalRef(build, local_index);
    // The statement is this instruction's source: an indexed assignment's
    // collection ownership receipt attaches here by that identity.
    build = SelfMirRoutineAttachLastSourceStatement(build, node_id);
    build = SelfMirRoutineAttachLastAbiTypeName(
        build, build.local_types[local_index]
    );
    build = SelfMirRoutineAttachLastExpressionGraph(
        build, value_graph, input.machine_declaration
    );
    build = SelfMirRoutineAttachLastSecondaryExpressionGraph(
        build, target_graph
    );
    return build;
}
