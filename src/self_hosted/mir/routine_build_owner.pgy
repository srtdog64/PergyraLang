// Canonical state transformations for one bounded MIR routine build.

import "program_fact_owner.pgy";
import "cfg_instruction_mutation_owner.pgy";
import "expression_fact_owner.pgy";
import "expression_runtime_abi_owner.pgy";

struct SelfMirRoutineBuild {
    ok: Bool;
    diagnostic_message: String;
    cfg: SelfMirCfgRows;
    current_block: Int;
    next_instruction_id: Int;
    terminated: Array<Int>;
    local_names: Array<String>;
    local_types: Array<String>;
    local_versions: Array<Int>;
}

func SelfMirSsaName(name: String, version: Int) -> String {
    return Concat(name, Concat(".", ToString(version)));
}

func SelfMirRoutineBuildEmpty() -> SelfMirRoutineBuild {
    let cfg: SelfMirCfgRows = SelfMirCfgAddBlock(SelfMirCfgRowsEmpty());
    let empty_strings: Array<String> = [];
    let empty_ints: Array<Int> = [];
    return SelfMirRoutineBuild(
        true, "", cfg, 0, 0, [0], empty_strings, empty_strings, empty_ints
    );
}

func SelfMirRoutineBuildError(
    build: SelfMirRoutineBuild,
    message: String
) -> SelfMirRoutineBuild {
    return SelfMirRoutineBuild(
        false, message, build.cfg, build.current_block,
        build.next_instruction_id, build.terminated,
        build.local_names, build.local_types, build.local_versions
    );
}

func SelfMirRoutineAddBlock(build: SelfMirRoutineBuild) -> SelfMirRoutineBuild {
    let cfg: SelfMirCfgRows = SelfMirCfgAddBlock(build.cfg);
    let terminated: Array<Int> = build.terminated;
    ArrayPush(terminated, 0);
    return SelfMirRoutineBuild(
        build.ok, build.diagnostic_message, cfg, build.current_block,
        build.next_instruction_id, terminated,
        build.local_names, build.local_types, build.local_versions
    );
}

func SelfMirRoutineAtBlock(
    build: SelfMirRoutineBuild,
    block_index: Int
) -> SelfMirRoutineBuild {
    return SelfMirRoutineBuild(
        build.ok, build.diagnostic_message, build.cfg, block_index,
        build.next_instruction_id, build.terminated,
        build.local_names, build.local_types, build.local_versions
    );
}

func SelfMirRoutineSetSuccessors(
    build: SelfMirRoutineBuild,
    block_index: Int,
    true_target: Int,
    false_target: Int
) -> SelfMirRoutineBuild {
    let cfg: SelfMirCfgRows = SelfMirCfgSetSuccessors(
        build.cfg, block_index, true_target, false_target
    );
    return SelfMirRoutineBuild(
        build.ok, build.diagnostic_message, cfg, build.current_block,
        build.next_instruction_id, build.terminated,
        build.local_names, build.local_types, build.local_versions
    );
}

func SelfMirRoutineWithCfg(
    build: SelfMirRoutineBuild,
    cfg: SelfMirCfgRows
) -> SelfMirRoutineBuild {
    return SelfMirRoutineBuild(
        build.ok, build.diagnostic_message, cfg, build.current_block,
        build.next_instruction_id, build.terminated,
        build.local_names, build.local_types, build.local_versions
    );
}

func SelfMirRoutineTerminate(build: SelfMirRoutineBuild) -> SelfMirRoutineBuild {
    let terminated: Array<Int> = build.terminated;
    ArraySet(terminated, build.current_block, 1);
    return SelfMirRoutineBuild(
        build.ok, build.diagnostic_message, build.cfg, build.current_block,
        build.next_instruction_id, terminated,
        build.local_names, build.local_types, build.local_versions
    );
}

func SelfMirRoutineAddInstruction(
    build: SelfMirRoutineBuild,
    kind: String,
    name: String,
    result: String,
    arg0: String,
    arg1: String,
    expr0: String,
    expr1: String,
    source_type: String,
    uses: Array<String>
) -> SelfMirRoutineBuild {
    let cfg: SelfMirCfgRows = SelfMirCfgAddInstruction(
        build.cfg, build.current_block, build.next_instruction_id,
        kind, name, result, arg0, arg1, expr0, expr1, source_type, uses
    );
    return SelfMirRoutineBuild(
        build.ok, build.diagnostic_message, cfg, build.current_block,
        build.next_instruction_id + 1, build.terminated,
        build.local_names, build.local_types, build.local_versions
    );
}

func SelfMirSsaBaseName(ssa_name: String) -> String {
    let separator: Int = StringIndexOf(ssa_name, ".");
    if separator < 0 { return ssa_name; }
    return Substring(ssa_name, 0, separator);
}

func SelfMirRoutineResourceTypeForInstruction(
    build: SelfMirRoutineBuild,
    cfg: SelfMirCfgRows,
    instruction_index: Int,
    operation: String
) -> String {
    if operation == "Claim" {
        return cfg.instructions.expr1s[instruction_index];
    }
    if cfg.instructions.use_counts[instruction_index] > 0 {
        let use_name: String = cfg.instructions.uses[
            cfg.instructions.use_starts[instruction_index]
        ];
        let local_index: Option<Int> = SelfMirRoutineLocalIndex(
            build, SelfMirSsaBaseName(use_name)
        );
        if IsSome(local_index) {
            return build.local_types[UnwrapOption(local_index)];
        }
    }

    /* Resource rows for a borrowed/owned parameter intentionally carry no
       ordinary SSA use edge (parameter version 0 is not a def).  Their
       runtime ABI type is nevertheless already owned by the routine local
       type facts.  For a value-producing resource call, use the carried
       expression surface only to match that known local; this is not an AST
       rescan or a type inference fallback.  A standalone resource-op row has
       no expr0, so its arg0 is the explicit resource local handle. */
    let expression: String = cfg.instructions.expr0s[instruction_index];
    if expression != "" {
        let i: Int = 0;
        while i < ArrayLength(build.local_names) {
            if SelfMirTextContainsIdentifier(
                expression, build.local_names[i]
            ) {
                return build.local_types[i];
            }
            i = i + 1;
        }
    }
    let resource_arg: String = cfg.instructions.arg0s[instruction_index];
    let resource_local: Option<Int> = SelfMirRoutineLocalIndex(
        build, SelfMirSsaBaseName(resource_arg)
    );
    if IsSome(resource_local) {
        return build.local_types[UnwrapOption(resource_local)];
    }
    return "";
}

func SelfMirRoutineAttachLastExpressionGraph(
    build: SelfMirRoutineBuild,
    view: SemanticExpressionGraphView,
    declaration: SelfHostMachineLayerDeclaration
) -> SelfMirRoutineBuild {
    if !view.ok {
        return SelfMirRoutineBuildError(
            build, "MIR instruction is missing its semantic expression graph"
        );
    }
    let cfg: SelfMirCfgRows = SelfMirCfgAttachLastExpr0Graph(
        build.cfg, view, declaration
    );
    let instruction_index: Int = ArrayLength(cfg.instructions.ids) - 1;
    if instruction_index < 0 ||
        cfg.instructions.expr0_graphs.has_roots[instruction_index] != 1 {
        return SelfMirRoutineBuildError(
            build, "MIR expression graph attachment failed"
        );
    }
    let operation: String =
        cfg.instructions.machine_layer_runtime_operations[instruction_index];
    if operation != "" {
        let resource_type: String = SelfMirRoutineResourceTypeForInstruction(
            build, cfg, instruction_index, operation
        );
        if resource_type == "" {
            return SelfMirRoutineBuildError(
                build,
                "MIR resource runtime-call ABI row is missing its type fact"
            );
        }
        let abi_fact: CompilerRuntimeCallAbiFact =
            CompilerRuntimeCallAbiFactForNativeResource(
                resource_type, operation
            );
        if !abi_fact.ok {
            return SelfMirRoutineBuildError(
                build,
                "MIR resource runtime-call ABI row is not declared"
            );
        }
        cfg = SelfMirCfgAttachLastRuntimeCallAbi(
            cfg, resource_type, operation, abi_fact
        );
        if cfg.instructions.runtime_call_abi.present[instruction_index] != 1 {
            return SelfMirRoutineBuildError(
                build,
                "MIR resource runtime-call ABI row attachment failed"
            );
        }
    } else {
        let projection: SelfMirExpressionRuntimeAbiProjection =
            SelfMirExpressionRuntimeAbiProjectionFromGraph(
                view, cfg.instructions.expr1s[instruction_index],
                build.local_names, build.local_types
            );
        if !projection.ok {
            return SelfMirRoutineBuildError(
                build, projection.diagnostic_message
            );
        }
        let abi_i: Int = 0;
        while abi_i < ArrayLength(projection.operations) {
            let abi_fact: CompilerRuntimeCallAbiFact =
                CompilerRuntimeCallAbiFactForNativeResource(
                    projection.type_names[abi_i],
                    projection.operations[abi_i]
                );
            if !abi_fact.ok {
                return SelfMirRoutineBuildError(
                    build, "MIR Slot runtime-call ABI row is not declared"
                );
            }
            if abi_i == 0 {
                cfg = SelfMirCfgAttachLastRuntimeCallAbi(
                    cfg, projection.type_names[abi_i],
                    projection.operations[abi_i], abi_fact
                );
            } else {
                cfg = SelfMirCfgAttachLastRuntimeCallAbiAux(
                    cfg, projection.type_names[abi_i],
                    projection.operations[abi_i], abi_fact
                );
            }
            abi_i = abi_i + 1;
        }
    }
    return SelfMirRoutineBuild(
        build.ok, build.diagnostic_message, cfg, build.current_block,
        build.next_instruction_id, build.terminated,
        build.local_names, build.local_types, build.local_versions
    );
}

func SelfMirRoutineAttachLastSecondaryExpressionGraph(
    build: SelfMirRoutineBuild,
    view: SemanticExpressionGraphView
) -> SelfMirRoutineBuild {
    if !view.ok {
        return SelfMirRoutineBuildError(
            build, "MIR secondary expression graph is missing"
        );
    }
    let cfg: SelfMirCfgRows = SelfMirCfgAttachLastExpr1Graph(
        build.cfg, view
    );
    let instruction_index: Int = ArrayLength(cfg.instructions.ids) - 1;
    if instruction_index < 0 ||
        cfg.instructions.expr1_graphs.has_roots[instruction_index] != 1 {
        return SelfMirRoutineBuildError(
            build, "MIR secondary expression graph attachment failed"
        );
    }
    return SelfMirRoutineBuild(
        build.ok, build.diagnostic_message, cfg, build.current_block,
        build.next_instruction_id, build.terminated,
        build.local_names, build.local_types, build.local_versions
    );
}

func SelfMirRoutineAttachLastMatchCase(
    build: SelfMirRoutineBuild,
    fact: SelfMirMatchCaseFact
) -> SelfMirRoutineBuild {
    if !fact.ok || fact.pattern == "" {
        return SelfMirRoutineBuildError(build, "MIR match case fact is empty");
    }
    let cfg: SelfMirCfgRows = SelfMirCfgAttachLastMatchCase(
        build.cfg, fact
    );
    let instruction_index: Int = ArrayLength(cfg.instructions.ids) - 1;
    if instruction_index < 0 || !IsSome(
        SelfMirMatchFactIndexForInstruction(
            cfg.instructions.match_facts, instruction_index
        )
    ) {
        return SelfMirRoutineBuildError(
            build, "MIR match case attachment failed"
        );
    }
    return SelfMirRoutineBuild(
        build.ok, build.diagnostic_message, cfg, build.current_block,
        build.next_instruction_id, build.terminated,
        build.local_names, build.local_types, build.local_versions
    );
}

func SelfMirRoutineLocalIndex(
    build: SelfMirRoutineBuild,
    name: String
) -> Option<Int> {
    let i: Int = 0;
    while i < ArrayLength(build.local_names) {
        if build.local_names[i] == name { return Some(i); }
        i = i + 1;
    }
    return None;
}

func SelfMirRoutineAddLocal(
    build: SelfMirRoutineBuild,
    name: String,
    type_name: String,
    initial_version: Int
) -> SelfMirRoutineBuild {
    let existing_opt: Option<Int> = SelfMirRoutineLocalIndex(build, name);
    if IsSome(existing_opt) {
        let existing: Int = UnwrapOption(existing_opt);
        if build.local_types[existing] != type_name {
            return SelfMirRoutineBuildError(
                build, Concat("MIR shadowed local type changed: ", name)
            );
        }
        let versions2: Array<Int> = build.local_versions;
        let next_version: Int = versions2[existing] + 1;
        ArraySet(versions2, existing, next_version);
        return SelfMirRoutineBuild(
            build.ok, build.diagnostic_message, build.cfg,
            build.current_block, build.next_instruction_id,
            build.terminated, build.local_names, build.local_types, versions2
        );
    }
    let names: Array<String> = build.local_names;
    let types: Array<String> = build.local_types;
    let versions: Array<Int> = build.local_versions;
    ArrayPush(names, name);
    ArrayPush(types, type_name);
    ArrayPush(versions, initial_version);
    return SelfMirRoutineBuild(
        build.ok, build.diagnostic_message, build.cfg, build.current_block,
        build.next_instruction_id, build.terminated, names, types, versions
    );
}

func SelfMirRoutineSetLocalVersion(
    build: SelfMirRoutineBuild,
    local_index: Int,
    version: Int
) -> SelfMirRoutineBuild {
    let versions: Array<Int> = build.local_versions;
    ArraySet(versions, local_index, version);
    return SelfMirRoutineBuild(
        build.ok, build.diagnostic_message, build.cfg, build.current_block,
        build.next_instruction_id, build.terminated,
        build.local_names, build.local_types, versions
    );
}

func SelfMirRoutineAdvanceLocalVersion(
    build: SelfMirRoutineBuild,
    local_index: Int
) -> SelfMirRoutineBuild {
    return SelfMirRoutineSetLocalVersion(
        build, local_index, build.next_instruction_id + 1
    );
}

func SelfMirLocalVersionsSnapshot(versions: Array<Int>) -> Array<Int> {
    let snapshot: Array<Int> = [];
    let i: Int = 0;
    while i < ArrayLength(versions) {
        ArrayPush(snapshot, versions[i]);
        i = i + 1;
    }
    return snapshot;
}

func SelfMirRoutineAtLocalVersions(
    build: SelfMirRoutineBuild,
    versions: Array<Int>
) -> SelfMirRoutineBuild {
    let restored: Array<Int> = SelfMirLocalVersionsSnapshot(versions);
    if ArrayLength(restored) > ArrayLength(build.local_names) {
        return SelfMirRoutineBuildError(
            build, "MIR restored local versions exceed local inventory"
        );
    }
    while ArrayLength(restored) < ArrayLength(build.local_names) {
        ArrayPush(restored, 0);
    }
    return SelfMirRoutineBuild(
        build.ok, build.diagnostic_message, build.cfg, build.current_block,
        build.next_instruction_id, build.terminated,
        build.local_names, build.local_types, restored
    );
}
