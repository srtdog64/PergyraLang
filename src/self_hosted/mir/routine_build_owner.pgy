// Canonical state transformations for one bounded MIR routine build.

import "program_fact_owner.pgy";
import "cfg_view_owner.pgy";
import "instruction_scalar_mutation_owner.pgy";
import "cfg_instruction_mutation_owner.pgy";
import "expression_fact_owner.pgy";
import "expression_runtime_abi_owner.pgy";
import "routine_expression_runtime_abi_owner.pgy";
import "../semantic/ast_expression_graph_node_view_owner.pgy";

struct SelfMirRoutineBuild {
    ok: Bool;
    diagnostic_message: String;
    cfg: SelfMirCfgRows;
    current_block: Int;
    next_instruction_id: Int;
    terminated: Array<Int>;
    local_names: Array<String>;
    local_types: Array<String>;
    local_versions: Array<Int>;
    local_refs: Array<String>;
}

func SelfMirSsaName(name: String, version: Int) -> String {
    return Concat(name, Concat(".", ToString(version)));
}

func SelfMirRoutineBuildEmpty() -> SelfMirRoutineBuild {
    let cfg: SelfMirCfgRows = SelfMirCfgAddBlock(SelfMirCfgRowsEmpty());
    let empty_strings: Array<String> = [];
    let empty_ints: Array<Int> = [];
    return SelfMirRoutineBuild(
        true, "", cfg, 0, 0, [0], empty_strings, empty_strings, empty_ints,
        empty_strings
    );
}

// A failed build carries only its diagnostic. The failing state may name
// storage a growth already released, and the last consumer retires the
// failed build, so none of that storage travels with the error.
func SelfMirRoutineBuildError(
    build: SelfMirRoutineBuild,
    message: String
) -> SelfMirRoutineBuild {
    var failed: SelfMirRoutineBuild = SelfMirRoutineBuildEmpty();
    failed.ok = false;
    failed.diagnostic_message = message;
    return failed;
}

func SelfMirRoutineAddBlock(build: SelfMirRoutineBuild) -> SelfMirRoutineBuild {
    let cfg: SelfMirCfgRows = SelfMirCfgAddBlock(build.cfg);
    var terminated: Array<Int> = build.terminated;
    ArrayPush(terminated, 0);
    return SelfMirRoutineBuild(
        build.ok, build.diagnostic_message, cfg, build.current_block,
        build.next_instruction_id, terminated,
        build.local_names, build.local_types, build.local_versions,
        build.local_refs
    );
}

func SelfMirRoutineAtBlock(
    build: SelfMirRoutineBuild,
    block_index: Int
) -> SelfMirRoutineBuild {
    return SelfMirRoutineBuild(
        build.ok, build.diagnostic_message, build.cfg, block_index,
        build.next_instruction_id, build.terminated,
        build.local_names, build.local_types, build.local_versions,
        build.local_refs
    );
}

func SelfMirRoutineSetSuccessors(
    build: SelfMirRoutineBuild,
    block_index: Int,
    true_target: Int,
    false_target: Int
) -> SelfMirRoutineBuild {
    let cfg: SelfMirCfgRows = SelfMirCfgSetSuccessors(
        build.cfg, block_index, true_target, false_target
    );
    return SelfMirRoutineBuild(
        build.ok, build.diagnostic_message, cfg, build.current_block,
        build.next_instruction_id, build.terminated,
        build.local_names, build.local_types, build.local_versions,
        build.local_refs
    );
}

func SelfMirRoutineWithCfg(
    build: SelfMirRoutineBuild,
    cfg: SelfMirCfgRows
) -> SelfMirRoutineBuild {
    return SelfMirRoutineBuild(
        build.ok, build.diagnostic_message, cfg, build.current_block,
        build.next_instruction_id, build.terminated,
        build.local_names, build.local_types, build.local_versions,
        build.local_refs
    );
}

func SelfMirRoutineTerminate(build: SelfMirRoutineBuild) -> SelfMirRoutineBuild {
    ArraySet(build.terminated, build.current_block, 1);
    return build;
}

func SelfMirRoutineAddInstruction(
    build: SelfMirRoutineBuild,
    kind: String,
    name: String,
    result: String,
    arg0: String,
    arg1: String,
    expr0: String,
    expr1: String,
    source_type: String,
    ref uses: Array<String>
) -> SelfMirRoutineBuild {
    let cfg: SelfMirCfgRows = SelfMirCfgAddInstruction(
        build.cfg, build.current_block, build.next_instruction_id,
        kind, name, result, arg0, arg1, expr0, expr1, source_type, uses
    );
    build.cfg = cfg;
    build.next_instruction_id = build.next_instruction_id + 1;
    return build;
}

func SelfMirRoutineAttachLastAbiTypeName(
    build: SelfMirRoutineBuild,
    abi_type_name: String
) -> SelfMirRoutineBuild {
    return SelfMirRoutineWithCfg(
        build, SelfMirCfgAttachLastAbiTypeName(build.cfg, abi_type_name)
    );
}

func SelfMirRoutineAttachLastExpressionGraph(
    build: SelfMirRoutineBuild,
    view: SemanticExpressionGraphView,
    declaration: SelfHostMachineLayerDeclaration
) -> SelfMirRoutineBuild {
    if !view.ok {
        return SelfMirRoutineBuildError(
            build, "MIR instruction is missing its semantic expression graph"
        );
    }
    var cfg: SelfMirCfgRows = SelfMirCfgAttachLastExpr0Graph(
        build.cfg, view, declaration
    );
    let instruction_index: Int = ArrayLength(cfg.instructions.ids) - 1;
    if instruction_index < 0 ||
        cfg.instructions.expr0_graphs.has_roots[instruction_index] != 1 {
        return SelfMirRoutineBuildError(
            build, "MIR expression graph attachment failed"
        );
    }
    let runtime_abi: SelfMirRoutineExpressionRuntimeAbiResult =
        SelfMirRoutineExpressionRuntimeAbiAttach(
            cfg, view, build.local_names, build.local_types);
    if !runtime_abi.ok {
        return SelfMirRoutineBuildError(
            build, runtime_abi.diagnostic_message);
    }
    cfg = runtime_abi.cfg;
    cfg = SelfMirCfgRows(
        cfg.blocks, cfg.instructions,
        SelfMirInstructionLocalRefRowsAttachExpr0(
            cfg.local_refs, view, build.local_names,
            build.local_versions, build.local_refs
        )
    );
    build.cfg = cfg;
    return build;
}

func SelfMirRoutineAttachLastSecondaryExpressionGraph(
    build: SelfMirRoutineBuild,
    view: SemanticExpressionGraphView
) -> SelfMirRoutineBuild {
    if !view.ok {
        return SelfMirRoutineBuildError(
            build, "MIR secondary expression graph is missing"
        );
    }
    let cfg: SelfMirCfgRows = SelfMirCfgAttachLastExpr1Graph(
        build.cfg, view
    );
    let instruction_index: Int = ArrayLength(cfg.instructions.ids) - 1;
    if instruction_index < 0 ||
        cfg.instructions.expr1_graphs.has_roots[instruction_index] != 1 {
        return SelfMirRoutineBuildError(
            build, "MIR secondary expression graph attachment failed"
        );
    }
    build.cfg = cfg;
    return build;
}

func SelfMirRoutineAttachLastCollectionMutationTargetGraph(
    build: SelfMirRoutineBuild,
    view: SemanticExpressionGraphView
) -> SelfMirRoutineBuild {
    if !view.ok {
        return SelfMirRoutineBuildError(
            build, "MIR collection mutation target graph is missing"
        );
    }
    let cfg: SelfMirCfgRows =
        SelfMirCfgAttachLastCollectionMutationTargetGraph(build.cfg, view);
    let instruction_index: Int = ArrayLength(cfg.instructions.ids) - 1;
    if instruction_index < 0 ||
        cfg.instructions.collection_mutation_target_graphs.has_roots[
            instruction_index] != 1 {
        return SelfMirRoutineBuildError(
            build, "MIR collection mutation target graph attachment failed"
        );
    }
    build.cfg = cfg;
    return build;
}

func SelfMirRoutineAttachLastMatchCase(
    build: SelfMirRoutineBuild,
    fact: SelfMirMatchCaseFact
) -> SelfMirRoutineBuild {
    if !fact.ok || fact.pattern == "" {
        return SelfMirRoutineBuildError(build, "MIR match case fact is empty");
    }
    let cfg: SelfMirCfgRows = SelfMirCfgAttachLastMatchCase(
        build.cfg, fact
    );
    let instruction_index: Int = ArrayLength(cfg.instructions.ids) - 1;
    if instruction_index < 0 || !IsSome(
        SelfMirMatchFactIndexForInstruction(
            cfg.instructions.match_facts, instruction_index
        )
    ) {
        return SelfMirRoutineBuildError(
            build, "MIR match case attachment failed"
        );
    }
    return SelfMirRoutineBuild(
        build.ok, build.diagnostic_message, cfg, build.current_block,
        build.next_instruction_id, build.terminated,
        build.local_names, build.local_types, build.local_versions,
        build.local_refs
    );
}

func SelfMirRoutineLocalIndex(
    build: SelfMirRoutineBuild,
    name: String
) -> Option<Int> {
    var i: Int = ArrayLength(build.local_names) - 1;
    while i >= 0 {
        if build.local_names[i] == name { return Some(i); }
        i = i - 1;
    }
    return None;
}

func SelfMirRoutineDeclareLocal(
    build: SelfMirRoutineBuild,
    name: String,
    type_name: String,
    binding_version: Int,
    local_ref: String
) -> SelfMirRoutineBuild {
    if name == "" || type_name == "" || binding_version <= 0 ||
        ArrayLength(build.local_names) != ArrayLength(build.local_types) ||
        ArrayLength(build.local_names) != ArrayLength(build.local_versions) ||
        ArrayLength(build.local_names) != ArrayLength(build.local_refs) ||
        local_ref == "" {
        return SelfMirRoutineBuildError(
            build, "MIR semantic local declaration identity is invalid"
        );
    }
    var version: Int = binding_version;
    let active: Option<Int> = SelfMirRoutineLocalIndex(build, name);
    if IsSome(active) {
        let active_row: Int = UnwrapOption(active);
        if build.local_versions[active_row] >= version {
            version = build.local_versions[active_row] + 1;
        }
    }
    return SelfMirRoutinePushLocal(
        build, name, type_name, version, local_ref
    );
}

func SelfMirRoutinePushLocal(
    build: SelfMirRoutineBuild,
    name: String,
    type_name: String,
    initial_version: Int,
    local_ref: String
) -> SelfMirRoutineBuild {
    if name == "" || type_name == "" || initial_version < 0 ||
        ArrayLength(build.local_names) != ArrayLength(build.local_types) ||
        ArrayLength(build.local_names) != ArrayLength(build.local_versions) ||
        ArrayLength(build.local_names) != ArrayLength(build.local_refs) ||
        local_ref == "" {
        return SelfMirRoutineBuildError(
            build, "MIR lexical local identity is invalid"
        );
    }
    ArrayPushOwnedString(build.local_names, name);
    ArrayPushOwnedString(build.local_types, type_name);
    ArrayPush(build.local_versions, initial_version);
    ArrayPushOwnedString(build.local_refs, local_ref);
    return build;
}

func SelfMirRoutineAddLocal(
    build: SelfMirRoutineBuild,
    name: String,
    type_name: String,
    initial_version: Int,
    local_ref: String
) -> SelfMirRoutineBuild {
    let existing_opt: Option<Int> = SelfMirRoutineLocalIndex(build, name);
    if IsSome(existing_opt) {
        let existing: Int = UnwrapOption(existing_opt);
        if build.local_types[existing] != type_name ||
            build.local_refs[existing] != local_ref {
            return SelfMirRoutineBuildError(
                build, Concat("MIR shadowed local type changed: ", name)
            );
        }
        let next_version: Int = build.local_versions[existing] + 1;
        ArraySet(build.local_versions, existing, next_version);
        return build;
    }
    ArrayPushOwnedString(build.local_names, name);
    ArrayPushOwnedString(build.local_types, type_name);
    ArrayPush(build.local_versions, initial_version);
    ArrayPushOwnedString(build.local_refs, local_ref);
    return build;
}

func SelfMirRoutineSetLocalVersion(
    build: SelfMirRoutineBuild,
    local_index: Int,
    version: Int
) -> SelfMirRoutineBuild {
    var versions: Array<Int> = build.local_versions;
    ArraySet(versions, local_index, version);
    return SelfMirRoutineBuild(
        build.ok, build.diagnostic_message, build.cfg, build.current_block,
        build.next_instruction_id, build.terminated,
        build.local_names, build.local_types, versions, build.local_refs
    );
}

func SelfMirRoutineAdvanceLocalVersion(
    build: SelfMirRoutineBuild,
    local_index: Int
) -> SelfMirRoutineBuild {
    return SelfMirRoutineSetLocalVersion(
        build, local_index, build.next_instruction_id + 1
    );
}

func SelfMirLocalVersionsSnapshot(versions: Array<Int>) -> Array<Int> {
    var snapshot: Array<Int> = [];
    var i: Int = 0;
    while i < ArrayLength(versions) {
        ArrayPush(snapshot, versions[i]);
        i = i + 1;
    }
    return snapshot;
}

func SelfMirLocalVersionsPrefix(
    versions: Array<Int>, count: Int
) -> Array<Int> {
    var snapshot: Array<Int> = [];
    if count < 0 || count > ArrayLength(versions) { return snapshot; }
    var i: Int = 0;
    while i < count {
        ArrayPush(snapshot, versions[i]);
        i = i + 1;
    }
    return snapshot;
}

func SelfMirRoutineAtLocalVersions(
    build: SelfMirRoutineBuild,
    ref versions: Array<Int>
) -> SelfMirRoutineBuild {
    var restored: Array<Int> = build.local_versions;
    if ArrayLength(versions) > ArrayLength(build.local_names) ||
        ArrayLength(restored) != ArrayLength(build.local_names) ||
        ArrayLength(restored) != ArrayLength(build.local_types) ||
        ArrayLength(restored) != ArrayLength(build.local_refs) {
        return SelfMirRoutineBuildError(
            build, "MIR restored local versions exceed local inventory"
        );
    }
    var i: Int = 0;
    while i < ArrayLength(restored) {
        var version: Int = 0;
        if i < ArrayLength(versions) { version = versions[i]; }
        ArraySet(restored, i, version);
        i = i + 1;
    }
    return SelfMirRoutineBuild(
        build.ok, build.diagnostic_message, build.cfg, build.current_block,
        build.next_instruction_id, build.terminated,
        build.local_names, build.local_types, restored, build.local_refs
    );
}

func SelfMirRoutineAtLocalCount(
    build: SelfMirRoutineBuild,
    local_count: Int
) -> SelfMirRoutineBuild {
    if local_count < 0 || local_count > ArrayLength(build.local_names) ||
        ArrayLength(build.local_names) != ArrayLength(build.local_types) ||
        ArrayLength(build.local_names) != ArrayLength(build.local_versions) ||
        ArrayLength(build.local_names) != ArrayLength(build.local_refs) {
        return SelfMirRoutineBuildError(
            build, "MIR lexical local inventory boundary is invalid"
        );
    }
    while ArrayLength(build.local_names) > local_count {
        ArrayPop(build.local_names); ArrayPop(build.local_types); ArrayPop(build.local_versions); ArrayPop(build.local_refs);
    }
    return build;
}
