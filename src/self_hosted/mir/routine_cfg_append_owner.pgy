// CFG row append and offset-rebinding owner.

import "program_fact_owner.pgy";

func SelfMirAppendCfg(
    target: SelfMirCfgRows,
    source: SelfMirCfgRows
) -> SelfMirCfgRows {
    let instruction_offset: Int = ArrayLength(target.instructions.ids);
    var block_i: Int = 0;
    while block_i < ArrayLength(source.blocks.ids) {
        ArrayPush(target.blocks.ids, source.blocks.ids[block_i]);
        ArrayPush(target.blocks.reachable, source.blocks.reachable[block_i]);
        ArrayPushOwnedString(
            target.blocks.intent_roles, source.blocks.intent_roles[block_i]
        );
        ArrayPush(
            target.blocks.instruction_starts,
            source.blocks.instruction_starts[block_i] + instruction_offset
        );
        ArrayPush(
            target.blocks.instruction_counts,
            source.blocks.instruction_counts[block_i]
        );
        ArrayPush(
            target.blocks.has_succ_true,
            source.blocks.has_succ_true[block_i]
        );
        ArrayPush(
            target.blocks.succ_true, source.blocks.succ_true[block_i]
        );
        ArrayPush(
            target.blocks.has_succ_false,
            source.blocks.has_succ_false[block_i]
        );
        ArrayPush(
            target.blocks.succ_false, source.blocks.succ_false[block_i]
        );
        block_i = block_i + 1;
    }

    let use_offset: Int = ArrayLength(target.instructions.uses);
    var instruction_i: Int = 0;
    while instruction_i < ArrayLength(source.instructions.ids) {
        ArrayPush(
            target.instructions.ids, source.instructions.ids[instruction_i]
        );
        ArrayPush(
            target.instructions.binding_source_syntax_ids,
            source.instructions.binding_source_syntax_ids[instruction_i]
        );
        ArrayPushOwnedString(
            target.instructions.kinds,
            source.instructions.kinds[instruction_i]
        );
        ArrayPushOwnedString(
            target.instructions.names,
            source.instructions.names[instruction_i]
        );
        ArrayPushOwnedString(
            target.instructions.results,
            source.instructions.results[instruction_i]
        );
        ArrayPushOwnedString(
            target.instructions.arg0s,
            source.instructions.arg0s[instruction_i]
        );
        ArrayPushOwnedString(
            target.instructions.arg1s,
            source.instructions.arg1s[instruction_i]
        );
        ArrayPushOwnedString(
            target.instructions.slot_anchors,
            source.instructions.slot_anchors[instruction_i]
        );
        ArrayPushOwnedString(
            target.instructions.expr0s,
            source.instructions.expr0s[instruction_i]
        );
        ArrayPushOwnedString(
            target.instructions.expr1s,
            source.instructions.expr1s[instruction_i]
        );
        ArrayPushOwnedString(
            target.instructions.source_types,
            source.instructions.source_types[instruction_i]
        );
        ArrayPushOwnedString(
            target.instructions.machine_contact_kinds,
            source.instructions.machine_contact_kinds[instruction_i]
        );
        ArrayPushOwnedString(
            target.instructions.machine_layer_manifest_ids,
            source.instructions.machine_layer_manifest_ids[instruction_i]
        );
        ArrayPushOwnedString(
            target.instructions.machine_layer_physical_grant_ids,
            source.instructions.machine_layer_physical_grant_ids[instruction_i]
        );
        ArrayPush(
            target.instructions.machine_layer_physical_bases,
            source.instructions.machine_layer_physical_bases[instruction_i]
        );
        ArrayPush(
            target.instructions.machine_layer_physical_sizes,
            source.instructions.machine_layer_physical_sizes[instruction_i]
        );
        ArrayPushOwnedString(
            target.instructions.machine_layer_physical_modes,
            source.instructions.machine_layer_physical_modes[instruction_i]
        );
        ArrayPushOwnedString(
            target.instructions.machine_layer_runtime_operations,
            source.instructions.machine_layer_runtime_operations[instruction_i]
        );
        ArrayPush(
            target.instructions.machine_layer_hardware_adequate,
            source.instructions.machine_layer_hardware_adequate[instruction_i]
        );
        ArrayPush(
            target.instructions.machine_layer_authority_required,
            source.instructions.machine_layer_authority_required[instruction_i]
        );
        ArrayPush(
            target.instructions.machine_layer_live_lease_required,
            source.instructions.machine_layer_live_lease_required[instruction_i]
        );
        ArrayPush(
            target.instructions.use_starts,
            source.instructions.use_starts[instruction_i] + use_offset
        );
        ArrayPush(
            target.instructions.use_counts,
            source.instructions.use_counts[instruction_i]
        );
        ArrayPushOwnedString(
            target.instructions.abi_type_names,
            source.instructions.abi_type_names[instruction_i]
        );
        instruction_i = instruction_i + 1;
    }
    var use_i: Int = 0;
    while use_i < ArrayLength(source.instructions.uses) {
        ArrayPushOwnedString(
            target.instructions.uses, source.instructions.uses[use_i]
        );
        use_i = use_i + 1;
    }
    target.instructions.expr0_graphs =
        SelfMirExpressionGraphRowsAppendRows(
            target.instructions.expr0_graphs,
            source.instructions.expr0_graphs
        );
    target.instructions.expr1_graphs =
        SelfMirExpressionGraphRowsAppendRows(
            target.instructions.expr1_graphs,
            source.instructions.expr1_graphs
        );
    target.instructions.collection_mutation_target_graphs =
        SelfMirExpressionGraphRowsAppendRows(
            target.instructions.collection_mutation_target_graphs,
            source.instructions.collection_mutation_target_graphs
        );
    target.instructions.runtime_call_abi =
        SelfMirRuntimeCallAbiRowsAppendRows(
            target.instructions.runtime_call_abi,
            source.instructions.runtime_call_abi
        );
    target.instructions.match_facts = SelfMirMatchFactRowsAppend(
        target.instructions.match_facts,
        source.instructions.match_facts,
        instruction_offset
    );
    var destructure_facts: SelfMirDestructureFactRows =
        target.instructions.destructure_facts;
    SelfMirDestructureFactRowsAppend(
        destructure_facts,
        source.instructions.destructure_facts,
        instruction_offset
    );
    target.instructions.destructure_facts = destructure_facts;
    target.local_refs = SelfMirInstructionLocalRefRowsAppendRows(
        target.local_refs, source.local_refs
    );
    return target;
}
