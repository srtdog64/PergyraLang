// Typed MIR lowering for the bounded single-statement defer body.

import "routine_input_owner.pgy";
import "routine_build_owner.pgy";

func SelfMirLowerDeferFromArtifact(
    ref input: SelfMirRoutineInput,
    build: SelfMirRoutineBuild,
    node_id: Int
) -> SelfMirRoutineBuild {
    let body_opt: Option<Int> = SelfMirControlBodyBlock(
        input.artifact.arena, node_id
    );
    if !IsSome(body_opt) {
        return SelfMirRoutineBuildError(
            build, "defer statement is missing its body block"
        );
    }
    let body_node_id: Int = UnwrapOption(body_opt);
    let stmt_opt: Option<Int> = TypedAstArenaChildAt(
        input.artifact.arena, body_node_id, 0
    );
    if !IsSome(stmt_opt) || IsSome(TypedAstArenaChildAt(
        input.artifact.arena, body_node_id, 1
    )) {
        return SelfMirRoutineBuildError(
            build, "defer body is outside the bounded single-statement rung"
        );
    }
    let stmt_node_id: Int = UnwrapOption(stmt_opt);
    let empty_uses: Array<String> = [];
    if TypedAstArenaNodeKindIs(
        input.artifact.arena, stmt_node_id, TypedAstKindLogStmtTag()
    ) {
        let next: SelfMirRoutineBuild = SelfMirRoutineAddInstruction(
            build, "stmt", "stmt", "", "Log", "", "{...}", "",
            "AST_DEFER_STMT", empty_uses
        );
        return SelfMirRoutineAttachLastExpressionGraph(
            next,
            SemanticAstExpressionGraphForNode(
                input.analysis.expression_surfaces,
                stmt_node_id, AstExpressionLaneAtom()
            ),
            input.machine_declaration
        );
    }
    if !TypedAstArenaNodeKindIs(
        input.artifact.arena, stmt_node_id, TypedAstKindBareCallStmtTag()
    ) {
        return SelfMirRoutineBuildError(
            build, "defer body is outside the bounded call rung"
        );
    }
    let next: SelfMirRoutineBuild = SelfMirRoutineAddInstruction(
        build, "stmt", "stmt", "", "Call", "", "{...}", "",
        "AST_DEFER_STMT", empty_uses
    );
    return SelfMirRoutineAttachLastExpressionGraph(
        next,
        SemanticAstExpressionGraphForNode(
            input.analysis.expression_surfaces,
            stmt_node_id, AstExpressionLaneAtom()
        ),
        input.machine_declaration
    );
}
