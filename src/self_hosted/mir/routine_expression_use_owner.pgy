// SSA use edges derived from the routine's current local-version facts.

import "routine_build_owner.pgy";

func SelfMirExpressionGraphContainsLeafBinding(
    view: SemanticExpressionGraphView, name: String
) -> Bool {
    if !view.ok || name == "" { return false; }
    let start_opt: Option<Int> = SelfMirExpressionGraphSubtreeStart(
        view.graph, view.root_id
    );
    if !IsSome(start_opt) { return false; }
    let node: Int = UnwrapOption(start_opt);
    while node <= view.root_id {
        let kind: Option<Int> = SemanticExpressionGraphNodeKind(
            view.graph, node
        );
        let text: Option<String> = SemanticExpressionGraphNodeText(
            view.graph, node
        );
        if IsSome(kind) && IsSome(text) &&
            UnwrapOption(kind) == AstExpressionNodeLeaf() &&
            UnwrapOption(text) == name {
            return true;
        }
        node = node + 1;
    }
    return false;
}

func SelfMirUsesAppendUnique(
    inout uses: Array<String>, use_name: String
) -> Void {
    let i: Int = 0;
    while i < ArrayLength(uses) {
        if uses[i] == use_name { return; }
        i = i + 1;
    }
    ArrayPush(uses, use_name);
}

func SelfMirExpressionGraphUses(
    build: SelfMirRoutineBuild,
    view: SemanticExpressionGraphView
) -> Array<String> {
    let uses: Array<String> = [];
    if !view.ok { return uses; }
    let start_opt: Option<Int> = SelfMirExpressionGraphSubtreeStart(
        view.graph, view.root_id
    );
    if !IsSome(start_opt) { return uses; }
    let node: Int = UnwrapOption(start_opt);
    while node <= view.root_id {
        let kind: Option<Int> = SemanticExpressionGraphNodeKind(
            view.graph, node
        );
        let name_opt: Option<String> = SemanticExpressionGraphNodeText(
            view.graph, node
        );
        if IsSome(kind) && IsSome(name_opt) &&
            UnwrapOption(kind) == AstExpressionNodeLeaf() {
            let local_opt: Option<Int> = SelfMirRoutineLocalIndex(
                build, UnwrapOption(name_opt)
            );
            if IsSome(local_opt) {
                let local_index: Int = UnwrapOption(local_opt);
                if build.local_versions[local_index] > 0 {
                    SelfMirUsesAppendUnique(uses, SelfMirSsaName(
                        build.local_names[local_index],
                        build.local_versions[local_index]
                    ));
                }
            }
        }
        node = node + 1;
    }
    return uses;
}

func SelfMirExpressionUses(
    build: SelfMirRoutineBuild,
    expression: String
) -> Array<String> {
    let uses: Array<String> = [];
    let i: Int = ArrayLength(build.local_names) - 1;
    while i >= 0 {
        let shadowed: Bool = false;
        let use_i: Int = 0;
        while use_i < ArrayLength(uses) {
            if SelfMirSsaBaseName(uses[use_i]) == build.local_names[i] {
                shadowed = true;
            }
            use_i = use_i + 1;
        }
        if !shadowed && build.local_versions[i] > 0 &&
            SelfMirTextContainsIdentifier(
            expression, build.local_names[i]
        ) {
            ArrayPush(
                uses,
                SelfMirSsaName(build.local_names[i], build.local_versions[i])
            );
        }
        i = i - 1;
    }
    return uses;
}
