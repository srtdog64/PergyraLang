// MIR for/foreach CFG state transformer.

import "routine_input_owner.pgy";
import "routine_build_owner.pgy";
import "routine_iteration_owner.pgy";
import "routine_break_exit_fact_owner.pgy";
import "loop_reachability_fact_owner.pgy";
import "routine_loop_header_phi_owner.pgy";
import "routine_loop_exit_phi_owner.pgy";

func SelfMirLowerForFromArtifact(
    ref input: SelfMirRoutineInput,
    build: SelfMirRoutineBuild,
    node_id: Int,
    statement_index: Int
) -> SelfMirRoutineBuild {
    let iteration: SelfMirIterationLoweringFact =
        SelfMirIterationLoweringFactForNode(input, node_id, statement_index);
    if !iteration.ok {
        return SelfMirRoutineBuildError(
            build, iteration.diagnostic_message
        );
    }
    let body_opt: Option<Int> = SelfMirControlBodyBlock(
        input.artifact.arena, node_id
    );
    if !IsSome(body_opt) {
        return SelfMirRoutineBuildError(build, "MIR for body block is missing");
    }
    let reachability: SelfMirLoopReachabilityFact =
        SelfMirLoopReachabilityForBlock(
            input.artifact.arena, UnwrapOption(body_opt)
        );
    if !reachability.ok {
        return SelfMirRoutineBuildError(
            build, "MIR for-loop reachability fact is missing"
        );
    }
    let planned_backedge: Bool = reachability.reaches_backedge ||
        reachability.falls_through;
    let source_graph: SemanticExpressionGraphView =
        SemanticAstExpressionGraphForNode(
            input.analysis.expression_surfaces,
            node_id, AstExpressionLaneValue()
        );
    if !source_graph.ok {
        return SelfMirRoutineBuildError(
            build, "MIR for source expression graph is missing"
        );
    }
    let binding: String = iteration.binding_name;
    let start: String = iteration.start_expression;
    let stop: String = iteration.stop_expression;
    let iteration_graph: SemanticExpressionGraphView = source_graph;
    if iteration.collection_hoisted {
        iteration_graph = SelfMirIterationSyntheticGraphView(
            input.analysis.expression_surfaces, iteration
        );
        if !iteration_graph.ok {
            return SelfMirRoutineBuildError(
                build, "MIR foreach synthetic graph root is missing"
            );
        }
    }
    build = SelfMirPrepareIterationCollection(
        build, iteration, source_graph, input.machine_declaration
    );
    build = SelfMirRoutineAddLocal(
        build, binding, iteration.binding_type_name, 0
    );
    let preheader: Int = build.current_block;
    build = SelfMirRoutineAddInstruction(
        build, "loop-init", "loop-init", "", binding, "",
        start, stop, "AST_FOR_LOOP", SelfMirNoUses()
    );
    if iteration.collection_hoisted {
        build = SelfMirRoutineAttachLastExpressionGraph(
            build, iteration_graph,
            input.machine_declaration
        );
    } else {
        build = SelfMirRoutineAttachLastExpressionGraph(
            build, SemanticAstExpressionGraphForNode(
                input.analysis.expression_surfaces,
                node_id, AstExpressionLaneValue()
            ), input.machine_declaration
        );
    }
    build = SelfMirRoutineAddBlock(build);
    let header: Int = SelfMirCfgBlockCount(build.cfg) - 1;
    build = SelfMirRoutineSetSuccessors(build, preheader, header, -1);
    build = SelfMirRoutineAtBlock(build, header);
    build = SelfMirLoopPrepareHeaderLocalVersions(
        input, build, UnwrapOption(body_opt), planned_backedge
    );
    let branch_graph: SemanticExpressionGraphView = iteration_graph;
    if iteration.is_foreach && !branch_graph.ok {
        return SelfMirRoutineBuildError(
            build, "MIR foreach branch expression graph is missing"
        );
    }
    let branch_uses: Array<String> =
        SelfMirIterationBranchUses(build, iteration, branch_graph);
    build = SelfMirRoutineAddInstruction(
        build, "branch", "branch", "", binding, "", start,
        stop, "AST_FOR_LOOP", branch_uses
    );
    if iteration.collection_hoisted {
        build = SelfMirRoutineAttachLastExpressionGraph(
            build, branch_graph,
            input.machine_declaration
        );
    } else if iteration.is_foreach {
        build = SelfMirRoutineAttachLastExpressionGraph(
            build, branch_graph, input.machine_declaration
        );
    } else {
        build = SelfMirRoutineAttachLastExpressionGraph(
            build, SemanticAstExpressionGraphForNode(
                input.analysis.expression_surfaces,
                node_id, AstExpressionLaneAuxiliary()
            ), input.machine_declaration
        );
    }
    let header_versions: Array<Int> =
        SelfMirLocalVersionsSnapshot(build.local_versions);
    build = SelfMirRoutineAddBlock(build);
    let body: Int = SelfMirCfgBlockCount(build.cfg) - 1;
    build = SelfMirRoutineAtBlock(build, body);
    let break_exits: SelfMirBreakExitFacts = SelfMirBreakExitFactsEmpty();
    let body_local_count: Int = ArrayLength(build.local_names);
    build = SelfMirLowerBlockFromArtifact(
        input, build, UnwrapOption(body_opt),
        break_exits, header, body_local_count
    );
    let body_exit: Int = build.current_block;
    let observed_backedge: Bool = build.terminated[body_exit] == 0;
    let body_block: Int = body;
    while body_block < SelfMirCfgBlockCount(build.cfg) {
        if (build.cfg.blocks.has_succ_true[body_block] == 1 &&
            build.cfg.blocks.succ_true[body_block] == header) ||
            (build.cfg.blocks.has_succ_false[body_block] == 1 &&
             build.cfg.blocks.succ_false[body_block] == header) {
            observed_backedge = true;
        }
        body_block = body_block + 1;
    }
    if observed_backedge != planned_backedge {
        return SelfMirRoutineBuildError(
            build, "MIR for-loop reachability fact disagrees with CFG"
        );
    }
    build = SelfMirLoopBindHeaderBackedgeLocalVersions(
        build, header, observed_backedge
    );
    if build.terminated[body_exit] == 0 {
        build = SelfMirRoutineSetSuccessors(build, body_exit, header, -1);
    }
    build = SelfMirRoutineAddBlock(build);
    let loop_exit: Int = SelfMirCfgBlockCount(build.cfg) - 1;
    let break_i: Int = 0;
    while break_i < ArrayLength(break_exits.blocks) {
        build = SelfMirRoutineSetSuccessors(
            build, break_exits.blocks[break_i], loop_exit, -1
        );
        break_i = break_i + 1;
    }
    build = SelfMirRoutineSetSuccessors(build, header, body, loop_exit);
    return SelfMirLoopExitMergeLocalVersions(
        build, header_versions, break_exits, true, loop_exit
    );
}
