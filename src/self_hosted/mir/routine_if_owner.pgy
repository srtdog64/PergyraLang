// MIR branch/merge state transformer.
//
// SelfMirLowerBlockFromArtifact is the recursive dispatcher defined by the
// importing owner. Pergyra resolves this mutual recursion before lowering.

import "routine_input_owner.pgy";
import "routine_build_owner.pgy";
import "routine_local_ref_attachment_owner.pgy";
import "routine_expression_use_owner.pgy";
import "expression_fact_owner.pgy";
import "routine_local_predecessor_snapshot_owner.pgy";

struct SelfMirIfVersionSnapshot {
    ok: Bool;
    versions: Array<Int>;
}

func SelfMirIfFrameVersionsAt(
    ref frames: SelfMirLocalPredecessorSnapshots,
    frame_index: Int
) -> SelfMirIfVersionSnapshot {
    let versions: Array<Int> = [];
    if frame_index < 0 || frame_index >= ArrayLength(frames.blocks) ||
        frame_index >= ArrayLength(frames.version_starts) ||
        frame_index >= ArrayLength(frames.version_counts) {
        return SelfMirIfVersionSnapshot(false, versions);
    }
    let start: Int = frames.version_starts[frame_index];
    let count: Int = frames.version_counts[frame_index];
    if start < 0 || count < 0 || start + count > ArrayLength(frames.versions) {
        return SelfMirIfVersionSnapshot(false, versions);
    }
    let local_index: Int = 0;
    while local_index < count {
        ArrayPush(versions, frames.versions[start + local_index]);
        local_index = local_index + 1;
    }
    return SelfMirIfVersionSnapshot(true, versions);
}

func SelfMirMergeIfBranches(
    build: SelfMirRoutineBuild,
    branch_block: Int,
    then_block: Int,
    then_exit: Int,
    then_versions: Array<Int>,
    else_block: Int,
    else_exit: Int,
    else_versions: Array<Int>,
    entry_versions: Array<Int>
) -> SelfMirRoutineBuild {
    let then_live: Bool = build.terminated[then_exit] == 0;
    let else_live: Bool =
        else_exit < 0 || build.terminated[else_exit] == 0;
    if ArrayLength(then_versions) < ArrayLength(entry_versions) ||
        ArrayLength(else_versions) < ArrayLength(entry_versions) {
        return SelfMirRoutineBuildError(
            build, "MIR branch local-version cardinality drifted"
        );
    }
    if !then_live && !else_live {
        if else_block < 0 || else_exit < 0 {
            return SelfMirRoutineBuildError(
                build, "MIR terminated branch pair lacks an else exit"
            );
        }
        build = SelfMirRoutineSetSuccessors(
            build, branch_block, then_block, else_block
        );
        return SelfMirRoutineAtBlock(build, else_exit);
    }
    build = SelfMirRoutineAddBlock(build);
    let merge_block: Int = SelfMirCfgBlockCount(build.cfg) - 1;
    build = SelfMirRoutineAtBlock(build, merge_block);
    if build.terminated[then_exit] == 0 {
        build = SelfMirRoutineSetSuccessors(
            build, then_exit, merge_block, -1
        );
    }
    if else_exit >= 0 && build.terminated[else_exit] == 0 {
        build = SelfMirRoutineSetSuccessors(
            build, else_exit, merge_block, -1
        );
    }
    let false_block: Int = merge_block;
    if else_block >= 0 { false_block = else_block; }
    build = SelfMirRoutineSetSuccessors(
        build, branch_block, then_block, false_block
    );
    let merge_local_i: Int = 0;
    while merge_local_i < ArrayLength(entry_versions) {
        // Version zero means the name is not live in the enclosing lexical
        // scope. A declaration in either arm cannot manufacture an outer phi.
        if entry_versions[merge_local_i] == 0 {
            build = SelfMirRoutineSetLocalVersion(build, merge_local_i, 0);
            merge_local_i = merge_local_i + 1;
            continue;
        }
        let then_version: Int = then_versions[merge_local_i];
        let else_version: Int = else_versions[merge_local_i];
        if then_live && else_live && then_version != else_version {
            let phi_uses: Array<String> = [
                SelfMirSsaName(
                    build.local_names[merge_local_i], then_version
                ),
                SelfMirSsaName(
                    build.local_names[merge_local_i], else_version
                )
            ];
            build = SelfMirRoutineAdvanceLocalVersion(build, merge_local_i);
            build = SelfMirRoutineAddInstruction(
                build, "phi", build.local_names[merge_local_i],
                SelfMirSsaName(
                    build.local_names[merge_local_i],
                    build.local_versions[merge_local_i]
                ),
                "phi", "", "", "", "", phi_uses
            );
            build = SelfMirRoutineAttachLastPrimaryLocalRef(
                build, merge_local_i
            );
        } else if then_live {
            build = SelfMirRoutineSetLocalVersion(
                build, merge_local_i, then_version
            );
        } else if else_live {
            build = SelfMirRoutineSetLocalVersion(
                build, merge_local_i, else_version
            );
        } else {
            build = SelfMirRoutineSetLocalVersion(
                build, merge_local_i, entry_versions[merge_local_i]
            );
        }
        merge_local_i = merge_local_i + 1;
    }
    while merge_local_i < ArrayLength(build.local_names) {
        build = SelfMirRoutineSetLocalVersion(build, merge_local_i, 0);
        merge_local_i = merge_local_i + 1;
    }
    return build;
}

func SelfMirLowerIfFromArtifact(
    ref input: SelfMirRoutineInput,
    build: SelfMirRoutineBuild,
    node_id: Int,
    condition: String,
    inout break_exits: SelfMirLocalPredecessorSnapshots,
    inout backedge_snapshots: SelfMirLocalPredecessorSnapshots,
    continue_target: Int
) -> SelfMirRoutineBuild {
    let entry_frames: SelfMirLocalPredecessorSnapshots =
        SelfMirLocalPredecessorSnapshotsEmpty();
    let then_frames: SelfMirLocalPredecessorSnapshots =
        SelfMirLocalPredecessorSnapshotsEmpty();
    let then_blocks: Array<Int> = [];
    let else_blocks: Array<Int> = [];
    let active_node_id: Int = node_id;
    let active_condition: String = condition;
    let terminal_else_exit: Int = -1;
    let terminal_else_versions: Array<Int> = [];
    let descending: Bool = true;
    while descending && build.ok {
        let condition_graph: SemanticExpressionGraphView =
            SemanticAstExpressionGraphForNode(
                input.analysis.expression_surfaces,
                active_node_id, AstExpressionLaneAtom()
            );
        if !condition_graph.ok {
            return SelfMirRoutineBuildError(
                build, "MIR if condition expression graph is missing"
            );
        }
        build = SelfMirRoutineAddInstruction(
            build, "branch", "branch", "", "", "", active_condition, "",
            SelfMirExpressionSourceTypeName(
                SelfMirExpressionKindFromText(active_condition)
            ),
            SelfMirExpressionGraphUses(build, condition_graph)
        );
        build = SelfMirRoutineAttachLastExpressionGraph(
            build, condition_graph, input.machine_declaration
        );
        let body_opt: Option<Int> = SelfMirControlBodyBlock(
            input.artifact.arena, active_node_id
        );
        if !IsSome(body_opt) {
            return SelfMirRoutineBuildError(
                build, "MIR if body block is missing"
            );
        }
        let else_body_opt: Option<Int> = SelfMirIfElseLoweringRoot(
            input.artifact.arena, active_node_id
        );
        let nested_if_opt: Option<Int> = SelfMirIfElseNestedIfRoot(
            input.artifact.arena, active_node_id
        );
        entry_frames = SelfMirLocalPredecessorSnapshotsAppend(
            entry_frames, build
        );
        let entry_local_count: Int = ArrayLength(build.local_names);
        build = SelfMirRoutineAddBlock(build);
        let then_block: Int = SelfMirCfgBlockCount(build.cfg) - 1;
        build = SelfMirRoutineAtBlock(build, then_block);
        build = SelfMirLowerBlockFromArtifact(
            input, build, UnwrapOption(body_opt),
            break_exits, backedge_snapshots, continue_target,
            entry_local_count
        );
        if !build.ok { return build; }
        then_frames = SelfMirLocalPredecessorSnapshotsAppend(
            then_frames, build
        );
        let else_block: Int = -1;
        if IsSome(else_body_opt) {
            build = SelfMirRoutineAddBlock(build);
            else_block = SelfMirCfgBlockCount(build.cfg) - 1;
            build = SelfMirRoutineAtBlock(build, else_block);
            let entry_frame: SelfMirIfVersionSnapshot =
                SelfMirIfFrameVersionsAt(
                    entry_frames, ArrayLength(entry_frames.blocks) - 1
                );
            if !entry_frame.ok {
                return SelfMirRoutineBuildError(
                    build, "MIR if entry-version frame is invalid"
                );
            }
            build = SelfMirRoutineAtLocalVersions(
                build, entry_frame.versions
            );
        }
        ArrayPush(then_blocks, then_block);
        ArrayPush(else_blocks, else_block);
        if IsSome(nested_if_opt) {
            active_node_id = UnwrapOption(nested_if_opt);
            let statement_index_opt: Option<Int> =
                SemanticAstStatementIndexForNode(
                    input.analysis.statements, active_node_id
                );
            if !IsSome(statement_index_opt) {
                return SelfMirRoutineBuildError(
                    build, "MIR nested else-if statement fact is missing"
                );
            }
            let statement_index: Int = UnwrapOption(statement_index_opt);
            if input.analysis.statements.kind_tags[statement_index] !=
                TypedAstKindIfStmtTag() {
                return SelfMirRoutineBuildError(
                    build, "MIR nested else-if statement kind drifted"
                );
            }
            active_condition =
                input.analysis.statements.payload_texts[statement_index];
            continue;
        }
        if IsSome(else_body_opt) {
            build = SelfMirLowerBlockFromArtifact(
                input, build, UnwrapOption(else_body_opt),
                break_exits, backedge_snapshots, continue_target,
                entry_local_count
            );
            if !build.ok { return build; }
            terminal_else_exit = build.current_block;
            terminal_else_versions =
                SelfMirLocalVersionsSnapshot(build.local_versions);
        } else {
            let entry_frame: SelfMirIfVersionSnapshot =
                SelfMirIfFrameVersionsAt(
                    entry_frames, ArrayLength(entry_frames.blocks) - 1
                );
            if !entry_frame.ok {
                return SelfMirRoutineBuildError(
                    build, "MIR if terminal entry-version frame is invalid"
                );
            }
            terminal_else_versions = entry_frame.versions;
        }
        descending = false;
    }
    if !build.ok { return build; }
    if ArrayLength(entry_frames.blocks) == 0 ||
        ArrayLength(entry_frames.blocks) != ArrayLength(then_frames.blocks) ||
        ArrayLength(entry_frames.blocks) != ArrayLength(then_blocks) ||
        ArrayLength(entry_frames.blocks) != ArrayLength(else_blocks) {
        return SelfMirRoutineBuildError(
            build, "MIR else-if frame cardinality drifted"
        );
    }
    let frame_index: Int = ArrayLength(entry_frames.blocks) - 1;
    let else_exit: Int = terminal_else_exit;
    let else_versions: Array<Int> = terminal_else_versions;
    while frame_index >= 0 {
        let entry_frame: SelfMirIfVersionSnapshot =
            SelfMirIfFrameVersionsAt(entry_frames, frame_index);
        let then_frame: SelfMirIfVersionSnapshot =
            SelfMirIfFrameVersionsAt(then_frames, frame_index);
        if !entry_frame.ok || !then_frame.ok {
            return SelfMirRoutineBuildError(
                build, "MIR else-if local-version frame is invalid"
            );
        }
        build = SelfMirMergeIfBranches(
            build,
            entry_frames.blocks[frame_index],
            then_blocks[frame_index],
            then_frames.blocks[frame_index],
            then_frame.versions,
            else_blocks[frame_index],
            else_exit,
            else_versions,
            entry_frame.versions
        );
        if !build.ok { return build; }
        frame_index = frame_index - 1;
        if frame_index >= 0 {
            build = SelfMirRoutineAtLocalCount(
                build, entry_frames.version_counts[frame_index]
            );
            else_exit = build.current_block;
            else_versions =
                SelfMirLocalVersionsSnapshot(build.local_versions);
        }
    }
    return build;
}
