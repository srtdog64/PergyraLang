// Immutable typed-artifact and semantic-fact bundle for MIR routine lowering.

import "../semantic/ast_artifact_verdict_owner.pgy";
import "../semantic/ast_iteration_type_fact_owner.pgy";
import "../compiler/machine_layer_declaration_consumer.pgy";

struct SelfMirInitializerRows {
    node_ids: Array<Int>;
    inferred_type_names: Array<String>;
    binding_kinds: Array<Int>;
    binding_indices: Array<Int>;
}

struct SelfMirIterationRows {
    node_ids: Array<Int>;
    binding_type_names: Array<String>;
    iterable_type_names: Array<String>;
    collection_hoists: Array<Int>;
}

struct SelfMirRoutineInput {
    artifact: AstTreeArtifact;
    analysis: SemanticAstArtifactAnalysis;
    initializers: SelfMirInitializerRows;
    iterations: SelfMirIterationRows;
    machine_declaration: SelfHostMachineLayerDeclaration;
}

func SelfMirInitializerRowsFromSemantic(
    facts: SemanticAstInitializerTypeFacts
) -> SelfMirInitializerRows {
    return SelfMirInitializerRows(
        facts.node_ids, facts.inferred_type_names,
        facts.binding_kinds, facts.binding_indices
    );
}

func SelfMirInitializerRowsReady(rows: SelfMirInitializerRows) -> Bool {
    let count: Int = ArrayLength(rows.node_ids);
    if ArrayLength(rows.inferred_type_names) != count ||
        ArrayLength(rows.binding_kinds) != count ||
        ArrayLength(rows.binding_indices) != count {
        return false;
    }
    let i: Int = 0;
    while i < count {
        if rows.node_ids[i] < 0 || rows.inferred_type_names[i] == "" ||
            rows.inferred_type_names[i] == "Unknown" {
            return false;
        }
        if rows.binding_kinds[i] == SemanticAstLocalBindingKindNormal() {
            if rows.binding_indices[i] != 0 ||
                (i > 0 && rows.node_ids[i - 1] == rows.node_ids[i]) {
                return false;
            }
        } else if rows.binding_kinds[i] ==
            SemanticAstLocalBindingKindDestructure() {
            if rows.binding_indices[i] < 0 ||
                (rows.binding_indices[i] == 0 &&
                 i > 0 && rows.node_ids[i - 1] == rows.node_ids[i]) ||
                (rows.binding_indices[i] > 0 &&
                 (i == 0 || rows.node_ids[i - 1] != rows.node_ids[i] ||
                  rows.binding_indices[i - 1] + 1 !=
                    rows.binding_indices[i])) {
                return false;
            }
        } else {
            return false;
        }
        if i > 0 && rows.node_ids[i] < rows.node_ids[i - 1] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func SelfMirInitializerRangeForNode(
    rows: SelfMirInitializerRows,
    node_id: Int
) -> SemanticAstLocalBindingFunctionRange {
    if !SelfMirInitializerRowsReady(rows) {
        return SemanticAstLocalBindingFunctionRange(false, 0, 0);
    }
    let start: Int = 0;
    while start < ArrayLength(rows.node_ids) && rows.node_ids[start] < node_id {
        start = start + 1;
    }
    let end: Int = start;
    while end < ArrayLength(rows.node_ids) && rows.node_ids[end] == node_id {
        end = end + 1;
    }
    return SemanticAstLocalBindingFunctionRange(start < end, start, end);
}

func SelfMirInitializerIndexForNode(
    rows: SelfMirInitializerRows,
    node_id: Int
) -> Option<Int> {
    if !SelfMirInitializerRowsReady(rows) { return None; }
    let i: Int = 0;
    while i < ArrayLength(rows.node_ids) {
        if rows.node_ids[i] == node_id { return Some(i); }
        i = i + 1;
    }
    return None;
}

func SelfMirIterationRowsFromSemantic(
    facts: SemanticAstIterationTypeFacts
) -> SelfMirIterationRows {
    return SelfMirIterationRows(
        facts.node_ids, facts.binding_type_names,
        facts.iterable_type_names, facts.collection_hoists
    );
}

func SelfMirIterationRowsReady(rows: SelfMirIterationRows) -> Bool {
    let n: Int = ArrayLength(rows.node_ids);
    if ArrayLength(rows.binding_type_names) != n ||
        ArrayLength(rows.iterable_type_names) != n ||
        ArrayLength(rows.collection_hoists) != n {
        return false;
    }
    let i: Int = 0;
    while i < n {
        if rows.node_ids[i] < 0 || rows.binding_type_names[i] == "" ||
            rows.binding_type_names[i] == "Unknown" ||
            rows.iterable_type_names[i] == "" ||
            rows.iterable_type_names[i] == "Unknown" ||
            (rows.collection_hoists[i] != 0 &&
             rows.collection_hoists[i] != 1) {
            return false;
        }
        let prior: Int = 0;
        while prior < i {
            if rows.node_ids[prior] == rows.node_ids[i] { return false; }
            prior = prior + 1;
        }
        i = i + 1;
    }
    return true;
}

func SelfMirNodeDescendsFrom(
    arena: AstArena, node_id: Int, ancestor_id: Int
) -> Bool {
    let cursor: Option<Int> = Some(node_id);
    let remaining: Int = TypedAstArenaNodeCount(arena) + 1;
    while IsSome(cursor) && remaining > 0 {
        let current: Int = UnwrapOption(cursor);
        if current == ancestor_id { return true; }
        cursor = TypedAstArenaParentId(arena, current);
        remaining = remaining - 1;
    }
    return false;
}

func SelfMirForEachSyntheticOrdinal(
    ref input: SelfMirRoutineInput, node_id: Int
) -> Option<Int> {
    if !SelfMirIterationRowsReady(input.iterations) { return None; }
    let found: Bool = false;
    let ordinal: Int = 0;
    let i: Int = 0;
    while i < ArrayLength(input.iterations.node_ids) {
        let candidate: Int = input.iterations.node_ids[i];
        if candidate == node_id && input.iterations.collection_hoists[i] == 1 {
            found = true;
        } else if input.iterations.collection_hoists[i] == 1 {
            let candidate_is_nested: Bool = SelfMirNodeDescendsFrom(
                input.artifact.arena, candidate, node_id
            );
            let current_is_nested: Bool = SelfMirNodeDescendsFrom(
                input.artifact.arena, node_id, candidate
            );
            if candidate_is_nested ||
                (!current_is_nested && candidate < node_id) {
                ordinal = ordinal + 1;
            }
        }
        i = i + 1;
    }
    if !found { return None; }
    return Some(ordinal);
}

func SelfMirControlBodyBlock(arena: AstArena, node_id: Int) -> Option<Int> {
    let child_index: Int = 0;
    let child_opt: Option<Int> = TypedAstArenaChildAt(
        arena, node_id, child_index
    );
    while IsSome(child_opt) {
        let child_id: Int = UnwrapOption(child_opt);
        if TypedAstArenaNodeKindIs(arena, child_id, TypedAstKindBlockTag()) {
            return Some(child_id);
        }
        let nested_index: Int = 0;
        let nested_opt: Option<Int> = TypedAstArenaChildAt(
            arena, child_id, nested_index
        );
        while IsSome(nested_opt) {
            let nested_id: Int = UnwrapOption(nested_opt);
            if TypedAstArenaNodeKindIs(
                arena, nested_id, TypedAstKindBlockTag()
            ) {
                return Some(nested_id);
            }
            nested_index = nested_index + 1;
            nested_opt = TypedAstArenaChildAt(
                arena, child_id, nested_index
            );
        }
        child_index = child_index + 1;
        child_opt = TypedAstArenaChildAt(arena, node_id, child_index);
    }
    return None;
}

func SelfMirIfElseLoweringRoot(arena: AstArena, if_node_id: Int) -> Option<Int> {
    let child_index: Int = 0;
    let child_opt: Option<Int> = TypedAstArenaChildAt(
        arena, if_node_id, child_index
    );
    while IsSome(child_opt) {
        let child_id: Int = UnwrapOption(child_opt);
        if TypedAstArenaNodeKindIs(arena, child_id, TypedAstKindElseStmtTag()) {
            let body_opt: Option<Int> = SelfMirControlBodyBlock(arena, child_id);
            if IsSome(body_opt) { return body_opt; }
            return Some(child_id);
        }
        child_index = child_index + 1;
        child_opt = TypedAstArenaChildAt(arena, if_node_id, child_index);
    }
    return None;
}

func SelfMirFunctionBodyBlock(
    arena: AstArena, function_node_id: Int
) -> Option<Int> {
    let child_index: Int = 0;
    let child_opt: Option<Int> = TypedAstArenaChildAt(
        arena, function_node_id, child_index
    );
    while IsSome(child_opt) {
        let child_id: Int = UnwrapOption(child_opt);
        if TypedAstArenaNodeKindIs(arena, child_id, TypedAstKindBodyTag()) {
            return SelfMirControlBodyBlock(arena, child_id);
        }
        child_index = child_index + 1;
        child_opt = TypedAstArenaChildAt(
            arena, function_node_id, child_index
        );
    }
    return None;
}

func SelfMirTypeIsNominal(
    ref input: SelfMirRoutineInput, type_name: String
) -> Bool {
    let i: Int = 0;
    while i < SemanticAstNominalConstructorCount(input.analysis.constructors) {
        if input.analysis.constructors.names[i] == type_name { return true; }
        i = i + 1;
    }
    return false;
}

func SelfMirLoopAssignedLocal(
    ref input: SelfMirRoutineInput, body_node_id: Int, local_name: String
) -> Bool {
    let i: Int = 0;
    while i < SemanticAstAssignmentCount(input.analysis.assignments) {
        if input.analysis.assignments.target_root_names[i] == local_name &&
            SelfMirNodeDescendsFrom(
                input.artifact.arena,
                input.analysis.assignments.node_ids[i], body_node_id
            ) {
            return true;
        }
        i = i + 1;
    }
    return false;
}
