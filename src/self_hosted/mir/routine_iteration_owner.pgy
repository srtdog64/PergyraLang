// MIR-owned projection of verified semantic iteration rows.

import "routine_input_owner.pgy";
import "routine_build_owner.pgy";
import "routine_expression_use_owner.pgy";
import "expression_fact_owner.pgy";

struct SelfMirIterationLoweringFact {
    ok: Bool;
    diagnostic_message: String;
    binding_name: String;
    binding_type_name: String;
    iterable_type_name: String;
    source_expression: String;
    start_expression: String;
    stop_expression: String;
    is_foreach: Bool;
    collection_hoisted: Bool;
    synthetic_name: String;
    synthetic_graph_root_id: Int;
}

func SelfMirIterationLoweringError(
    message: String
) -> SelfMirIterationLoweringFact {
    return SelfMirIterationLoweringFact(
        false, message, "", "", "", "", "", "", false, false, "", -1
    );
}

func SelfMirIterationLoweringFactForNode(
    ref input: SelfMirRoutineInput,
    node_id: Int,
    statement_index: Int
) -> SelfMirIterationLoweringFact {
    if !SelfMirIterationRowsReady(input.iterations) ||
        statement_index < 0 ||
        statement_index >= SemanticAstStatementCount(input.analysis.statements) ||
        input.analysis.statements.node_ids[statement_index] != node_id ||
        input.analysis.statements.kind_tags[statement_index] !=
            TypedAstKindForStmtTag() {
        return SelfMirIterationLoweringError(
            "MIR for-loop statement fact is invalid"
        );
    }
    let binding_type: String = "";
    let iterable_type: String = "";
    let collection_hoist: Int = 0;
    let synthetic_name: String = "";
    let synthetic_graph_root_id: Int = -1;
    let found_iteration: Bool = false;
    let i: Int = 0;
    while i < ArrayLength(input.iterations.node_ids) {
        if input.iterations.node_ids[i] == node_id {
            binding_type = input.iterations.binding_type_names[i];
            iterable_type = input.iterations.iterable_type_names[i];
            collection_hoist = input.iterations.collection_hoists[i];
            synthetic_name = input.iterations.synthetic_names[i];
            synthetic_graph_root_id =
                input.iterations.synthetic_graph_root_ids[i];
            found_iteration = true;
            break;
        }
        i = i + 1;
    }
    if !found_iteration {
        return SelfMirIterationLoweringError(
            "MIR for-loop iteration type fact is missing"
        );
    }
    let binding: String = input.analysis.statements.payload_texts[
        statement_index
    ];
    let start: String = input.analysis.statements.value_texts[statement_index];
    let auxiliary: String = input.analysis.statements.auxiliary_texts[
        statement_index
    ];
    if binding == "" || start == "" || binding_type == "" ||
        binding_type == "Unknown" || iterable_type == "" ||
        iterable_type == "Unknown" {
        return SelfMirIterationLoweringError(
            "MIR for-loop iteration fact is incomplete"
        );
    }
    let is_foreach: Bool = auxiliary == "";
    let stop: String = auxiliary;
    let canonical_start: String = start;
    if is_foreach {
        if collection_hoist == 1 {
            if synthetic_name == "" || synthetic_graph_root_id < 0 {
                return SelfMirIterationLoweringError(
                    "MIR foreach synthetic graph root is missing"
                );
            }
            canonical_start = synthetic_name;
        } else if synthetic_name != "" || synthetic_graph_root_id != -1 {
            return SelfMirIterationLoweringError(
                "MIR foreach synthetic graph root is unexpected"
            );
        }
        stop = canonical_start;
    } else if binding_type != "Int" {
        return SelfMirIterationLoweringError(
            "MIR range loop binding type must be Int"
        );
    }
    return SelfMirIterationLoweringFact(
        true, "", binding, binding_type, iterable_type, start,
        canonical_start, stop, is_foreach, collection_hoist == 1,
        synthetic_name, synthetic_graph_root_id
    );
}

func SelfMirIterationSyntheticGraphView(
    expression_surfaces: SemanticAstExpressionSurfaceFacts,
    fact: SelfMirIterationLoweringFact
) -> SemanticExpressionGraphView {
    return SemanticExpressionGraphView(
        fact.collection_hoisted && fact.synthetic_graph_root_id >= 0 &&
            fact.synthetic_graph_root_id <
                SemanticExpressionGraphArenaNodeCount(
                    expression_surfaces.expression_graph.arena
                ),
        fact.synthetic_graph_root_id,
        expression_surfaces.expression_graph
    );
}

func SelfMirPrepareIterationCollection(
    build: SelfMirRoutineBuild,
    fact: SelfMirIterationLoweringFact,
    source_graph: SemanticExpressionGraphView,
    declaration: SelfHostMachineLayerDeclaration
) -> SelfMirRoutineBuild {
    if !fact.collection_hoisted { return build; }
    if !source_graph.ok {
        return SelfMirRoutineBuildError(
            build, "MIR foreach collection expression graph is missing"
        );
    }
    let uses: Array<String> = SelfMirExpressionGraphUses(
        build, source_graph
    );
    build = SelfMirRoutineAddLocal(
        build, fact.synthetic_name, fact.iterable_type_name, 1
    );
    build = SelfMirRoutineAddInstruction(
        build, "def", "ssa-def", SelfMirSsaName(fact.synthetic_name, 1),
        fact.synthetic_name, "", fact.source_expression,
        fact.iterable_type_name, "AST_LET_DECL", uses
    );
    return SelfMirRoutineAttachLastExpressionGraph(
        build, source_graph, declaration
    );
}

func SelfMirIterationBranchUses(
    build: SelfMirRoutineBuild,
    fact: SelfMirIterationLoweringFact,
    branch_graph: SemanticExpressionGraphView
) -> Array<String> {
    if !fact.is_foreach {
        return SelfMirNoUses();
    }
    return SelfMirExpressionGraphUses(build, branch_graph);
}
