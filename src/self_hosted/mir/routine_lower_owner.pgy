// Artifact-native routine CFG lowering for the bounded hard self-host frontier.

import "program_fact_owner.pgy";
import "expression_fact_owner.pgy";
import "../semantic/ast_artifact_verdict_owner.pgy";
import "routine_input_owner.pgy";
import "routine_build_owner.pgy";

struct SelfMirRoutineState {
    input: SelfMirRoutineInput;
    build: SelfMirRoutineBuild;
}

func SelfMirSsaName(name: String, version: Int) -> String {
    return Concat(name, Concat(".", ToString(version)));
}

func SelfMirExpressionUses(
    build: SelfMirRoutineBuild,
    expression: String
) -> Array<String> {
    let uses: Array<String> = [];
    let i: Int = 0;
    while i < ArrayLength(build.local_names) {
        if build.local_versions[i] > 0 && SelfMirTextContainsIdentifier(
            expression, build.local_names[i]
        ) {
            ArrayPush(
                uses,
                SelfMirSsaName(build.local_names[i], build.local_versions[i])
            );
        }
        i = i + 1;
    }
    return uses;
}

func SelfMirLowerBlockFromArtifact(
    state: SelfMirRoutineState,
    block_node_id: Int,
    inout break_blocks: Array<Int>,
    continue_target: Int
) -> SelfMirRoutineState {
    let build: SelfMirRoutineBuild = state.build;
    let child_index: Int = 0;
    let child_opt: Option<Int> = TypedAstArenaChildAt(
        state.input.artifact.arena, block_node_id, child_index
    );
    while IsSome(child_opt) && build.ok {
        let node_id: Int = UnwrapOption(child_opt);
        if build.terminated[build.current_block] == 1 {
            // MIR owns executable CFG only; a terminal instruction erases its
            // source block's unreachable suffix.
            return SelfMirRoutineState(state.input, build);
        }
        let kind_opt: Option<Int> = TypedAstArenaNodeKind(
            state.input.artifact.arena, node_id
        );
        if !IsSome(kind_opt) {
            return SelfMirRoutineState(
                state.input,
                SelfMirRoutineBuildError(build, "MIR node kind is missing")
            );
        }
        let kind: Int = UnwrapOption(kind_opt);
        if kind == TypedAstKindLetStmtTag() {
            let local_index_opt: Option<Int> =
                SemanticAstLocalBindingIndexForNode(
                    state.input.analysis.local_bindings, node_id
                );
            if !IsSome(local_index_opt) {
                return SelfMirRoutineState(
                    state.input, SelfMirRoutineBuildError(
                        build, "MIR let is missing semantic local facts"
                    )
                );
            }
            let local_index: Int = UnwrapOption(local_index_opt);
            if state.input.analysis.local_bindings.has_declared_types[local_index] != 1 {
                return SelfMirRoutineState(
                    state.input, SelfMirRoutineBuildError(
                        build, "bounded MIR producer requires a local type fact"
                    )
                );
            }
            let local_name: String = state.input.analysis.local_bindings.names[local_index];
            let local_type: String =
                state.input.analysis.local_bindings.declared_type_names[local_index];
            let expression: String =
                state.input.analysis.local_bindings.initializer_texts[local_index];
            let initializer_uses: Array<String> =
                SelfMirExpressionUses(build, expression);
            build = SelfMirRoutineAddLocal(build, local_name, local_type, 1);
            let added_local_opt: Option<Int> =
                SelfMirRoutineLocalIndex(build, local_name);
            if !IsSome(added_local_opt) {
                return SelfMirRoutineState(
                    state.input, SelfMirRoutineBuildError(
                        build, "MIR local registration did not produce an identity"
                    )
                );
            }
            let local_version: Int = build.local_versions[
                UnwrapOption(added_local_opt)
            ];
            let arg1: String = "";
            if SelfMirTypeIsNominal(state.input, local_type) {
                arg1 = local_type;
            }
            build = SelfMirRoutineAddInstruction(
                build, "def", "ssa-def",
                SelfMirSsaName(local_name, local_version),
                local_name, arg1, expression, local_type,
                "AST_LET_DECL", initializer_uses
            );
        } else if kind == TypedAstKindAssignStmtTag() {
            let assignment_index_opt: Option<Int> =
                SemanticAstAssignmentIndexForNode(
                    state.input.analysis.assignments, node_id
                );
            if !IsSome(assignment_index_opt) {
                return SelfMirRoutineState(
                    state.input, SelfMirRoutineBuildError(
                        build, "MIR assignment is missing semantic facts"
                    )
                );
            }
            let assignment_index: Int = UnwrapOption(assignment_index_opt);
            let target: String =
                state.input.analysis.assignments.target_base_names[assignment_index];
            let local_opt: Option<Int> = SelfMirRoutineLocalIndex(build, target);
            if !IsSome(local_opt) {
                return SelfMirRoutineState(
                    state.input, SelfMirRoutineBuildError(
                        build,
                        Concat("MIR assignment target is unknown: ", target)
                    )
                );
            }
            let local_index: Int = UnwrapOption(local_opt);
            let expression: String =
                state.input.analysis.assignments.value_texts[assignment_index];
            let uses: Array<String> = SelfMirExpressionUses(build, expression);
            let version: Int = build.local_versions[local_index] + 1;
            build = SelfMirRoutineSetLocalVersion(build, local_index, version);
            build = SelfMirRoutineAddInstruction(
                build, "def", "ssa-def", SelfMirSsaName(target, version),
                target, "", expression, target, "AST_ASSIGNMENT", uses
            );
        } else if kind == TypedAstKindBreakStmtTag() ||
            kind == TypedAstKindContinueStmtTag() {
            let control_name: String = "break";
            let source_type: String = "AST_BREAK";
            if kind == TypedAstKindContinueStmtTag() {
                control_name = "continue";
                source_type = "AST_CONTINUE";
            }
            if continue_target < 0 {
                return SelfMirRoutineState(
                    state.input, SelfMirRoutineBuildError(
                        build, Concat("MIR loop control is outside a loop: ", control_name)
                    )
                );
            }
            if IsSome(TypedAstArenaChildAt(
                state.input.artifact.arena, block_node_id, child_index + 1
            )) {
                return SelfMirRoutineState(
                    state.input, SelfMirRoutineBuildError(
                        build,
                        Concat("bounded MIR producer only accepts terminal loop control: ", control_name)
                    )
                );
            }
            build = SelfMirRoutineAddInstruction(
                build, "branch", control_name, "", "", "", control_name, "",
                source_type, SelfMirNoUses()
            );
            if kind == TypedAstKindBreakStmtTag() {
                ArrayPush(break_blocks, build.current_block);
            } else {
                build = SelfMirRoutineSetSuccessors(
                    build, build.current_block, continue_target, -1
                );
            }
            build = SelfMirRoutineTerminate(build);
        } else if SemanticAstStatementKindTracked(kind) {
            let statement_index_opt: Option<Int> =
                SemanticAstStatementIndexForNode(
                    state.input.analysis.statements, node_id
                );
            if !IsSome(statement_index_opt) {
                return SelfMirRoutineState(
                    state.input, SelfMirRoutineBuildError(
                        build, "MIR statement is missing semantic facts"
                    )
                );
            }
            let statement_index: Int = UnwrapOption(statement_index_opt);
            let payload: String =
                state.input.analysis.statements.payload_texts[statement_index];
            let value_payload: String = state.input.analysis.statements.value_texts[statement_index];
            let auxiliary_payload: String = state.input.analysis.statements.auxiliary_texts[statement_index];
            if kind == TypedAstKindLogStmtTag() ||
                kind == TypedAstKindBareCallStmtTag() ||
                kind == TypedAstKindArrayPopStmtTag() ||
                kind == TypedAstKindArraySetStmtTag() ||
                kind == TypedAstKindArrayPushStmtTag() ||
                kind == TypedAstKindExitStmtTag() {
                let expression: String = payload;
                let arg0: String = "";
                if kind == TypedAstKindLogStmtTag() {
                    expression = Concat("Log(", Concat(payload, ")"));
                    arg0 = "Log";
                } else if kind == TypedAstKindArrayPopStmtTag() {
                    expression = Concat("ArrayPop(", Concat(payload, ")"));
                    arg0 = "ArrayPop";
                } else if kind == TypedAstKindArraySetStmtTag() {
                    expression = Concat(
                        "ArraySet(", Concat(payload, Concat(", ", Concat(
                            value_payload, Concat(", ", Concat(auxiliary_payload, ")"))
                        )))
                    );
                    arg0 = "ArraySet";
                } else if kind == TypedAstKindArrayPushStmtTag() {
                    expression = Concat(
                        "ArrayPush(", Concat(payload, Concat(", ", Concat(value_payload, ")")))
                    );
                    arg0 = "ArrayPush";
                } else if kind == TypedAstKindExitStmtTag() {
                    expression = Concat("Exit(", Concat(payload, ")"));
                    arg0 = "Exit";
                }
                build = SelfMirRoutineAddInstruction(
                    build, "stmt", "stmt", "", arg0, "", expression, "",
                    "AST_CALL", SelfMirExpressionUses(build, expression)
                );
                if kind == TypedAstKindExitStmtTag() { build = SelfMirRoutineTerminate(build); }
            } else if kind == TypedAstKindBareReturnStmtTag() ||
                kind == TypedAstKindValueReturnStmtTag() {
                let return_source_type: String = "AST_RETURN_VOID";
                if kind == TypedAstKindValueReturnStmtTag() {
                    return_source_type = SelfMirExpressionSourceTypeName(
                        SelfMirExpressionKindFromText(payload)
                    );
                }
                build = SelfMirRoutineAddInstruction(
                    build, "return", "return", "", "", "", payload, "",
                    return_source_type,
                    SelfMirExpressionUses(build, payload)
                );
                build = SelfMirRoutineTerminate(build);
            } else if kind == TypedAstKindIfStmtTag() {
                let condition: String = payload;
                let branch_block: Int = build.current_block;
                build = SelfMirRoutineAddInstruction(
                    build, "branch", "branch", "", "", "", condition, "",
                    SelfMirExpressionSourceTypeName(
                        SelfMirExpressionKindFromText(condition)
                    ),
                    SelfMirExpressionUses(build, condition)
                );
                let body_opt: Option<Int> = SelfMirControlBodyBlock(
                    state.input.artifact.arena, node_id
                );
                if !IsSome(body_opt) {
                    return SelfMirRoutineState(
                        state.input, SelfMirRoutineBuildError(
                            build, "MIR if body block is missing"
                        )
                    );
                }
                build = SelfMirRoutineAddBlock(build);
                let then_block: Int = SelfMirCfgBlockCount(build.cfg) - 1;
                build = SelfMirRoutineAtBlock(build, then_block);
                let then_state: SelfMirRoutineState =
                    SelfMirLowerBlockFromArtifact(
                        SelfMirRoutineState(state.input, build),
                        UnwrapOption(body_opt), break_blocks, continue_target
                    );
                build = then_state.build;
                let then_exit: Int = build.current_block;
                build = SelfMirRoutineAddBlock(build);
                let merge_block: Int = SelfMirCfgBlockCount(build.cfg) - 1;
                if build.terminated[then_exit] == 0 {
                    build = SelfMirRoutineSetSuccessors(
                        build, then_exit, merge_block, -1
                    );
                }
                build = SelfMirRoutineSetSuccessors(
                    build, branch_block, then_block, merge_block
                );
            } else if kind == TypedAstKindWhileStmtTag() {
                let body_opt2: Option<Int> = SelfMirControlBodyBlock(
                    state.input.artifact.arena, node_id
                );
                if !IsSome(body_opt2) {
                    return SelfMirRoutineState(
                        state.input, SelfMirRoutineBuildError(
                            build, "MIR while body block is missing"
                        )
                    );
                }
                let preheader: Int = build.current_block;
                build = SelfMirRoutineAddBlock(build);
                let header: Int = SelfMirCfgBlockCount(build.cfg) - 1;
                build = SelfMirRoutineSetSuccessors(
                    build, preheader, header, -1
                );
                build = SelfMirRoutineAtBlock(build, header);
                let local_i: Int = 0;
                while local_i < ArrayLength(build.local_names) {
                    if SelfMirLoopAssignedLocal(
                        state.input, UnwrapOption(body_opt2),
                        build.local_names[local_i]
                    ) {
                        let old_version: Int = build.local_versions[local_i];
                        let phi_version: Int = old_version + 1;
                        let future_version: Int = phi_version + 1;
                        let phi_uses: Array<String> = [
                            SelfMirSsaName(
                                build.local_names[local_i], old_version
                            ),
                            SelfMirSsaName(
                                build.local_names[local_i], future_version
                            )
                        ];
                        build = SelfMirRoutineAddInstruction(
                            build, "phi", build.local_names[local_i],
                            SelfMirSsaName(
                                build.local_names[local_i], phi_version
                            ),
                            "phi", "", "", "", "", phi_uses
                        );
                        build = SelfMirRoutineSetLocalVersion(
                            build, local_i, phi_version
                        );
                    }
                    local_i = local_i + 1;
                }
                let condition2: String = payload;
                build = SelfMirRoutineAddInstruction(
                    build, "branch", "branch", "", "", "", condition2, "",
                    SelfMirExpressionSourceTypeName(
                        SelfMirExpressionKindFromText(condition2)
                    ),
                    SelfMirExpressionUses(build, condition2)
                );
                build = SelfMirRoutineAddBlock(build);
                let loop_body: Int = SelfMirCfgBlockCount(build.cfg) - 1;
                build = SelfMirRoutineAtBlock(build, loop_body);
                let while_break_blocks: Array<Int> = [];
                let while_state: SelfMirRoutineState =
                    SelfMirLowerBlockFromArtifact(
                        SelfMirRoutineState(state.input, build),
                        UnwrapOption(body_opt2), while_break_blocks, header
                    );
                build = while_state.build;
                let body_exit: Int = build.current_block;
                if build.terminated[body_exit] == 0 {
                    build = SelfMirRoutineSetSuccessors(
                        build, body_exit, header, -1
                    );
                }
                build = SelfMirRoutineAddBlock(build);
                let loop_exit: Int = SelfMirCfgBlockCount(build.cfg) - 1;
                let while_break_i: Int = 0;
                while while_break_i < ArrayLength(while_break_blocks) {
                    build = SelfMirRoutineSetSuccessors(
                        build, while_break_blocks[while_break_i], loop_exit, -1
                    );
                    while_break_i = while_break_i + 1;
                }
                build = SelfMirRoutineSetSuccessors(
                    build, header, loop_body, loop_exit
                );
            } else if kind == TypedAstKindForStmtTag() {
                let body_opt3: Option<Int> = SelfMirControlBodyBlock(
                    state.input.artifact.arena, node_id
                );
                if !IsSome(body_opt3) {
                    return SelfMirRoutineState(
                        state.input, SelfMirRoutineBuildError(
                            build, "MIR for body block is missing"
                        )
                    );
                }
                let binding: String = payload;
                let start: String = state.input.analysis.statements.value_texts[
                    statement_index
                ];
                let stop: String = state.input.analysis.statements.auxiliary_texts[
                    statement_index
                ];
                build = SelfMirRoutineAddLocal(build, binding, "Int", 0);
                let for_preheader: Int = build.current_block;
                build = SelfMirRoutineAddInstruction(
                    build, "loop-init", "loop-init", "", binding, "",
                    start, stop, "AST_FOR_LOOP", SelfMirNoUses()
                );
                build = SelfMirRoutineAddBlock(build);
                let for_header: Int = SelfMirCfgBlockCount(build.cfg) - 1;
                build = SelfMirRoutineSetSuccessors(
                    build, for_preheader, for_header, -1
                );
                build = SelfMirRoutineAtBlock(build, for_header);
                build = SelfMirRoutineAddInstruction(
                    build, "branch", "branch", "", binding, "", start,
                    stop, "AST_FOR_LOOP", SelfMirNoUses()
                );
                build = SelfMirRoutineAddBlock(build);
                let for_body: Int = SelfMirCfgBlockCount(build.cfg) - 1;
                build = SelfMirRoutineAtBlock(build, for_body);
                let for_break_blocks: Array<Int> = [];
                let for_state: SelfMirRoutineState =
                    SelfMirLowerBlockFromArtifact(
                        SelfMirRoutineState(state.input, build),
                        UnwrapOption(body_opt3), for_break_blocks, for_header
                    );
                build = for_state.build;
                let for_body_exit: Int = build.current_block;
                if build.terminated[for_body_exit] == 0 {
                    build = SelfMirRoutineSetSuccessors(
                        build, for_body_exit, for_header, -1
                    );
                }
                build = SelfMirRoutineAddBlock(build);
                let for_exit: Int = SelfMirCfgBlockCount(build.cfg) - 1;
                let for_break_i: Int = 0;
                while for_break_i < ArrayLength(for_break_blocks) {
                    build = SelfMirRoutineSetSuccessors(
                        build, for_break_blocks[for_break_i], for_exit, -1
                    );
                    for_break_i = for_break_i + 1;
                }
                build = SelfMirRoutineSetSuccessors(
                    build, for_header, for_body, for_exit
                );
            } else {
                return SelfMirRoutineState(
                    state.input, SelfMirRoutineBuildError(
                        build, "statement kind is outside bounded MIR producer"
                    )
                );
            }
        } else {
            return SelfMirRoutineState(
                state.input, SelfMirRoutineBuildError(
                    build, Concat(
                        "AST node is outside bounded MIR producer: node_id=",
                        Concat(ToString(node_id), Concat(
                            " kind=", ToString(kind)
                        ))
                    )
                )
            );
        }
        if kind == TypedAstKindIfStmtTag() ||
            kind == TypedAstKindWhileStmtTag() ||
            kind == TypedAstKindForStmtTag() {
            build = SelfMirRoutineAtBlock(
                build, SelfMirCfgBlockCount(build.cfg) - 1
            );
        }
        child_index = child_index + 1;
        child_opt = TypedAstArenaChildAt(
            state.input.artifact.arena, block_node_id, child_index
        );
    }
    return SelfMirRoutineState(state.input, build);
}

func SelfMirRoutineFromInput(
    input: SelfMirRoutineInput,
    function_node_id: Int
) -> SelfMirRoutineBuild {
    let body_opt: Option<Int> = SelfMirFunctionBodyBlock(
        input.artifact.arena, function_node_id
    );
    let build: SelfMirRoutineBuild = SelfMirRoutineBuildEmpty();
    if !IsSome(body_opt) {
        return SelfMirRoutineBuildError(build, "function body block is missing");
    }
    let signature_index_opt: Option<Int> =
        SemanticAstFunctionSignatureIndexForNode(
            input.analysis.signatures, function_node_id
        );
    if !IsSome(signature_index_opt) {
        return SelfMirRoutineBuildError(
            build, "function signature is missing for MIR parameter seeding"
        );
    }
    let signature_index: Int = UnwrapOption(signature_index_opt);
    let param_count_opt: Option<Int> = SemanticAstFunctionParamCountAt(
        input.analysis.signatures, signature_index
    );
    if !IsSome(param_count_opt) {
        return SelfMirRoutineBuildError(
            build, "function parameter count is missing for MIR"
        );
    }
    let p: Int = 0;
    while p < UnwrapOption(param_count_opt) {
        let param_name: Option<String> = SemanticAstFunctionParamNameAt(
            input.analysis.signatures, signature_index, p
        );
        let param_type: Option<String> = SemanticAstFunctionParamTypeAt(
            input.analysis.signatures, signature_index, p
        );
        if !IsSome(param_name) || !IsSome(param_type) {
            return SelfMirRoutineBuildError(
                build, "function parameter fact is incomplete for MIR"
            );
        }
        build = SelfMirRoutineAddLocal(
            build, UnwrapOption(param_name), UnwrapOption(param_type), 1
        );
        p = p + 1;
    }
    let root_break_blocks: Array<Int> = [];
    let state: SelfMirRoutineState = SelfMirLowerBlockFromArtifact(
        SelfMirRoutineState(input, build), UnwrapOption(body_opt),
        root_break_blocks, -1
    );
    return state.build;
}
