// Artifact-native routine CFG dispatcher for the hard self-host frontier.
//
// The compiler-scale input is a non-escaping read-only view. Recursive block
// lowering carries only the routine build state; it must not copy the full
// semantic artifact into every control-flow frame.

import "program_fact_owner.pgy";
import "expression_fact_owner.pgy";
import "routine_input_owner.pgy";
import "routine_build_owner.pgy";
import "routine_expression_use_owner.pgy";
import "routine_let_owner.pgy";
import "routine_destructure_owner.pgy";
import "routine_assignment_owner.pgy";
import "routine_control_transfer_owner.pgy";
import "routine_tracked_statement_owner.pgy";

func SelfMirLowerBlockFromArtifact(
    ref input: SelfMirRoutineInput,
    build: SelfMirRoutineBuild,
    block_node_id: Int,
    inout break_blocks: Array<Int>,
    continue_target: Int
) -> SelfMirRoutineBuild {
    let child_index: Int = 0;
    let child_opt: Option<Int> = TypedAstArenaChildAt(
        input.artifact.arena, block_node_id, child_index
    );
    while IsSome(child_opt) && build.ok {
        let node_id: Int = UnwrapOption(child_opt);
        if build.terminated[build.current_block] == 1 {
            // MIR owns executable CFG only; a terminal instruction erases its
            // source block's unreachable suffix.
            return build;
        }
        let kind_opt: Option<Int> = TypedAstArenaNodeKind(
            input.artifact.arena, node_id
        );
        if !IsSome(kind_opt) {
            return SelfMirRoutineBuildError(
                build, "MIR node kind is missing"
            );
        }
        let kind: Int = UnwrapOption(kind_opt);
        if kind == TypedAstKindLetStmtTag() {
            build = SelfMirLowerLetFromArtifact(input, build, node_id);
        } else if kind == TypedAstKindDestructureStmtTag() {
            build = SelfMirLowerDestructureFromArtifact(
                input, build, node_id
            );
        } else if kind == TypedAstKindAssignStmtTag() {
            build = SelfMirLowerAssignmentFromArtifact(
                input, build, node_id
            );
        } else if kind == TypedAstKindBreakStmtTag() ||
            kind == TypedAstKindContinueStmtTag() {
            build = SelfMirLowerControlTransferFromArtifact(
                input, build, block_node_id, child_index, kind,
                break_blocks, continue_target
            );
        } else if SemanticAstStatementKindTracked(kind) {
            build = SelfMirLowerTrackedStatementFromArtifact(
                input, build, node_id, kind,
                break_blocks, continue_target
            );
        } else {
            return SelfMirRoutineBuildError(
                build, Concat(
                    "AST node is outside bounded MIR producer: node_id=",
                    Concat(
                        ToString(node_id),
                        Concat(" kind=", ToString(kind))
                    )
                )
            );
        }
        if !build.ok { return build; }
        if kind == TypedAstKindIfStmtTag() ||
            kind == TypedAstKindWhileStmtTag() ||
            kind == TypedAstKindForStmtTag() {
            build = SelfMirRoutineAtBlock(
                build, SelfMirCfgBlockCount(build.cfg) - 1
            );
        }
        child_index = child_index + 1;
        child_opt = TypedAstArenaChildAt(
            input.artifact.arena, block_node_id, child_index
        );
    }
    return build;
}
