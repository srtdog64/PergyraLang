// Bounded scalar/Option match CFG state transformer.
//
// The active hard rung accepts one scalar pattern per case plus an optional
// final default. Match arms carry live exit/version rows to the N-way merge
// owner. Case shape comes only from the parser-owned expression graph.

import "routine_input_owner.pgy";
import "routine_build_owner.pgy";
import "routine_expression_use_owner.pgy";
import "routine_match_merge_owner.pgy";
import "routine_match_pattern_owner.pgy";
import "expression_fact_owner.pgy";
import "../semantic/wrapper_type_owner.pgy";

func SelfMirMatchCaseFactForNode(
    ref input: SelfMirRoutineInput,
    case_node_id: Int
) -> SelfMirMatchCaseFact {
    let index_opt: Option<Int> = SemanticAstStatementIndexForNode(
        input.analysis.statements, case_node_id
    );
    if !IsSome(index_opt) { return SelfMirMatchCaseFactInvalid(); }
    let index: Int = UnwrapOption(index_opt);
    if input.analysis.statements.kind_tags[index] !=
        TypedAstKindMatchCaseStmtTag() {
        return SelfMirMatchCaseFactInvalid();
    }
    return SelfMirMatchCaseFactFromArtifact(input.artifact, case_node_id);
}

func SelfMirMatchSubjectType(
    ref input: SelfMirRoutineInput,
    match_node_id: Int
) -> Option<String> {
    return SemanticAstStatementInferredTypeForNode(
        input.statement_types, match_node_id,
        TypedAstKindMatchStmtTag()
    );
}

func SelfMirMatchCaseSubjectReady(
    ref input: SelfMirRoutineInput,
    build: SelfMirRoutineBuild,
    match_node_id: Int,
    match_value: String,
    fact: SelfMirMatchCaseFact
) -> Bool {
    if fact.variant == "" &&
        ToString(ToInt(fact.pattern)) == fact.pattern {
        return ArrayLength(fact.bindings) == 0;
    }
    let subject_type_opt: Option<String> = SelfMirMatchSubjectType(
        input, match_node_id
    );
    if !IsSome(subject_type_opt) { return false; }
    let subject_type: String = UnwrapOption(subject_type_opt);
    if fact.variant == "Some" {
        return StartsWith(subject_type, "Option<") &&
            ArrayLength(fact.bindings) == 1;
    }
    if fact.variant == "None" {
        return StartsWith(subject_type, "Option<") &&
            ArrayLength(fact.bindings) == 0;
    }
    if fact.variant == "Ok" || fact.variant == "Err" {
        return StartsWith(subject_type, "Result<") &&
            ArrayLength(fact.bindings) == 1;
    }
    if fact.variant != "" {
        let i: Int = 0;
        while i < ArrayLength(input.analysis.enums.variant_names) {
            if input.analysis.enums.variant_enum_names[i] == subject_type &&
                input.analysis.enums.variant_names[i] == fact.variant {
                let param_count: Int =
                    input.analysis.enums.variant_param_counts[i];
                if param_count != ArrayLength(fact.bindings) {
                    return false;
                }
                let payload_index: Int = 0;
                while payload_index < param_count {
                    if !IsSome(SemanticAstEnumVariantPayloadTypeAt(
                        input.analysis.enums, subject_type,
                        fact.variant, payload_index
                    )) {
                        return false;
                    }
                    payload_index = payload_index + 1;
                }
                return true;
            }
            i = i + 1;
        }
        return false;
    }
    if ArrayLength(fact.bindings) != 0 {
        return false;
    }
    let i: Int = 0;
    while i < ArrayLength(input.analysis.enums.variant_names) {
        if input.analysis.enums.variant_enum_names[i] == subject_type &&
            input.analysis.enums.variant_names[i] == fact.pattern &&
            input.analysis.enums.variant_param_counts[i] == 0 {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func SelfMirMatchBindingTypes(
    ref input: SelfMirRoutineInput,
    match_node_id: Int,
    fact: SelfMirMatchCaseFact,
    inout binding_types: Array<String>
) -> Bool {
    if ArrayLength(fact.bindings) == 0 { return true; }
    let subject_type: Option<String> = SelfMirMatchSubjectType(
        input, match_node_id
    );
    if !IsSome(subject_type) { return false; }
    let wrapper_type: Option<String> = None;
    if fact.variant == "Some" {
        wrapper_type = OptionPayloadTypeOpt(UnwrapOption(subject_type));
    } else if fact.variant == "Ok" {
        wrapper_type = ResultPayloadTypeOpt(UnwrapOption(subject_type));
    } else if fact.variant == "Err" {
        wrapper_type = ResultErrorTypeOpt(UnwrapOption(subject_type));
    }
    if IsSome(wrapper_type) {
        if ArrayLength(fact.bindings) != 1 ||
            UnwrapOption(wrapper_type) == "" ||
            UnwrapOption(wrapper_type) == "Unknown" {
            return false;
        }
        ArrayPush(binding_types, UnwrapOption(wrapper_type));
        return true;
    }
    let i: Int = 0;
    while i < ArrayLength(input.analysis.enums.variant_names) {
        if input.analysis.enums.variant_enum_names[i] ==
                UnwrapOption(subject_type) &&
            input.analysis.enums.variant_names[i] == fact.variant {
            let param_count: Int =
                input.analysis.enums.variant_param_counts[i];
            if param_count != ArrayLength(fact.bindings) {
                return false;
            }
            let payload_index: Int = 0;
            while payload_index < param_count {
                let payload_type: Option<String> =
                    SemanticAstEnumVariantPayloadTypeAt(
                        input.analysis.enums, UnwrapOption(subject_type),
                        fact.variant, payload_index
                    );
                if !IsSome(payload_type) || UnwrapOption(payload_type) == "" ||
                    UnwrapOption(payload_type) == "Unknown" {
                    return false;
                }
                ArrayPush(binding_types, UnwrapOption(payload_type));
                payload_index = payload_index + 1;
            }
            return true;
        }
        i = i + 1;
    }
    return false;
}

func SelfMirLowerMatchCaseBranch(
    ref input: SelfMirRoutineInput,
    build: SelfMirRoutineBuild,
    match_node_id: Int,
    match_value: String,
    fact: SelfMirMatchCaseFact
) -> SelfMirRoutineBuild {
    if !SelfMirMatchCaseSubjectReady(
        input, build, match_node_id, match_value, fact
    ) {
        return SelfMirRoutineBuildError(
            build, "MIR match subject type or variant fact is missing"
        );
    }
    let binding_types: Array<String> = [];
    if !SelfMirMatchBindingTypes(
        input, match_node_id, fact, binding_types
    ) || ArrayLength(binding_types) != ArrayLength(fact.bindings) {
        return SelfMirRoutineBuildError(
            build, "MIR match binding type fact is missing"
        );
    }
    let carried_fact: SelfMirMatchCaseFact = SelfMirMatchCaseFact(
        fact.ok, fact.pattern, fact.variant, fact.bindings, binding_types
    );
    let match_graph: SemanticExpressionGraphView =
        SemanticAstExpressionGraphForNode(
            input.analysis.expression_surfaces,
            match_node_id, AstExpressionLaneAtom()
        );
    if !match_graph.ok {
        return SelfMirRoutineBuildError(
            build, "MIR match subject expression graph is missing"
        );
    }
    build = SelfMirRoutineAddInstruction(
        build, "branch", "branch", "", "", "", match_value, "",
        "AST_MATCH_CASE", SelfMirExpressionGraphUses(build, match_graph)
    );
    build = SelfMirRoutineAttachLastExpressionGraph(
        build, match_graph, input.machine_declaration
    );
    if !build.ok { return build; }
    return SelfMirRoutineAttachLastMatchCase(build, carried_fact);
}

func SelfMirLowerMatchFromArtifact(
    ref input: SelfMirRoutineInput,
    build: SelfMirRoutineBuild,
    node_id: Int,
    match_value: String,
    inout break_blocks: Array<Int>,
    continue_target: Int
) -> SelfMirRoutineBuild {
    let first_child: Option<Int> = TypedAstArenaChildAt(
        input.artifact.arena, node_id, 0
    );
    if match_value == "" || !IsSome(first_child) {
        return SelfMirRoutineBuildError(
            build, "MIR match subject or case inventory is missing"
        );
    }
    let entry_versions: Array<Int> =
        SelfMirLocalVersionsSnapshot(build.local_versions);
    let arm_exits: Array<Int> = [];
    let arm_versions: Array<Int> = [];
    let final_unmatched_block: Int = -1;
    let case_count: Int = 0;
    let child_index: Int = 0;
    let child_opt: Option<Int> = first_child;
    while IsSome(child_opt) && build.ok {
        let child_id: Int = UnwrapOption(child_opt);
        let kind_opt: Option<Int> = TypedAstArenaNodeKind(
            input.artifact.arena, child_id
        );
        if !IsSome(kind_opt) {
            return SelfMirRoutineBuildError(
                build, "MIR match child kind is missing"
            );
        }
        let kind: Int = UnwrapOption(kind_opt);
        let next_child: Option<Int> = TypedAstArenaChildAt(
            input.artifact.arena, node_id, child_index + 1
        );
        if kind == TypedAstKindMatchCaseStmtTag() {
            let case_fact: SelfMirMatchCaseFact = SelfMirMatchCaseFactForNode(
                input, child_id
            );
            if !case_fact.ok {
                return SelfMirRoutineBuildError(
                    build, "MIR match case graph fact is missing"
                );
            }
            let branch_block: Int = build.current_block;
            build = SelfMirLowerMatchCaseBranch(
                input, build, node_id, match_value, case_fact
            );
            if !build.ok { return build; }
            let body_opt: Option<Int> = SelfMirControlBodyBlock(
                input.artifact.arena, child_id
            );
            if !IsSome(body_opt) {
                return SelfMirRoutineBuildError(
                    build, "MIR match case body is missing"
                );
            }
            build = SelfMirRoutineAddBlock(build);
            let body_block: Int = SelfMirCfgBlockCount(build.cfg) - 1;
            build = SelfMirRoutineAtBlock(build, body_block);
            build = SelfMirRoutineAtLocalVersions(
                build, SelfMirLocalVersionsSnapshot(entry_versions)
            );
            let body_local_count: Int = ArrayLength(build.local_names);
            build = SelfMirLowerBlockFromArtifact(
                input, build, UnwrapOption(body_opt),
                break_blocks, continue_target, body_local_count
            );
            if !build.ok { return build; }
            let body_exit: Int = build.current_block;
            if ArrayLength(build.local_versions) <
                ArrayLength(entry_versions) {
                return SelfMirRoutineBuildError(
                    build, "MIR match arm local-version cardinality drifted"
                );
            }
            ArrayPush(arm_exits, body_exit);
            arm_versions = SelfMirMatchArmVersionsAppend(
                arm_versions, build.local_versions,
                ArrayLength(entry_versions)
            );
            if IsSome(next_child) {
                build = SelfMirRoutineAddBlock(build);
                let next_block: Int = SelfMirCfgBlockCount(build.cfg) - 1;
                build = SelfMirRoutineSetSuccessors(
                    build, branch_block, body_block, next_block
                );
                build = SelfMirRoutineAtBlock(build, next_block);
                build = SelfMirRoutineAtLocalVersions(
                    build, SelfMirLocalVersionsSnapshot(entry_versions)
                );
            } else {
                build = SelfMirRoutineSetSuccessors(
                    build, branch_block, body_block, -1
                );
                final_unmatched_block = branch_block;
            }
            case_count = case_count + 1;
        } else if kind == TypedAstKindMatchDefaultStmtTag() {
            if case_count == 0 || IsSome(next_child) {
                return SelfMirRoutineBuildError(
                    build, "MIR match default must be final after a case"
                );
            }
            let default_body_opt: Option<Int> = SelfMirControlBodyBlock(
                input.artifact.arena, child_id
            );
            if !IsSome(default_body_opt) {
                return SelfMirRoutineBuildError(
                    build, "MIR match default body is missing"
                );
            }
            let default_local_count: Int = ArrayLength(build.local_names);
            build = SelfMirLowerBlockFromArtifact(
                input, build, UnwrapOption(default_body_opt),
                break_blocks, continue_target, default_local_count
            );
            if !build.ok { return build; }
            let default_exit: Int = build.current_block;
            if ArrayLength(build.local_versions) <
                ArrayLength(entry_versions) {
                return SelfMirRoutineBuildError(
                    build, "MIR match default local-version cardinality drifted"
                );
            }
            ArrayPush(arm_exits, default_exit);
            arm_versions = SelfMirMatchArmVersionsAppend(
                arm_versions, build.local_versions,
                ArrayLength(entry_versions)
            );
            final_unmatched_block = -1;
        } else {
            return SelfMirRoutineBuildError(
                build, "MIR match child is neither case nor default"
            );
        }
        child_index = child_index + 1;
        child_opt = next_child;
    }
    if case_count == 0 {
        return SelfMirRoutineBuildError(build, "MIR match has no cases");
    }
    return SelfMirMergeMatchArms(
        build, arm_exits, arm_versions, entry_versions,
        final_unmatched_block
    );
}
