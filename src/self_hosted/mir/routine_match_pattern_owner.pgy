// MIR view of the canonical HIR-owned bounded match-pattern fact.

import "../hir/ast_match_pattern_fact_owner.pgy";

struct SelfMirMatchCaseFact {
    ok: Bool;
    pattern: String;
    variant: String;
    bindings: Array<String>;
    binding_types: Array<String>;
}

func SelfMirMatchCaseFactInvalid() -> SelfMirMatchCaseFact {
    let strings: Array<String> = [];
    return SelfMirMatchCaseFact(false, "", "", strings, strings);
}

func SelfMirMatchCaseFactFromArtifact(
    artifact: AstTreeArtifact,
    case_node_id: Int
) -> SelfMirMatchCaseFact {
    let fact: AstMatchCasePatternFact =
        AstMatchCasePatternFactFromArtifact(artifact, case_node_id);
    if !fact.ok {
        return SelfMirMatchCaseFactInvalid();
    }
    let binding_types: Array<String> = [];
    return SelfMirMatchCaseFact(
        true, fact.pattern, fact.variant, fact.bindings, binding_types
    );
}
