// MIR lowering owner for payload-only call-shaped statements.

import "routine_build_owner.pgy";
import "routine_expression_use_owner.pgy";
import "routine_local_ref_attachment_owner.pgy";
import "../semantic/ast_statement_fact_owner.pgy";
import "../semantic/ast_expression_graph_fact_owner.pgy";

func SelfMirSimpleStatementKind(kind: Int) -> Bool {
    return kind == TypedAstKindLogStmtTag() ||
        kind == TypedAstKindBareCallStmtTag() ||
        kind == TypedAstKindExitStmtTag() ||
        kind == TypedAstKindBindStmtTag();
}

func SelfMirSimpleStatementExpressionGraphLane(
    kind: Int
) -> Option<Int> {
    if kind == TypedAstKindArrayPushStmtTag() {
        return Some(AstExpressionLaneValue());
    }
    if kind == TypedAstKindArraySetStmtTag() {
        return Some(AstExpressionLaneAuxiliary());
    }
    return None;
}

func SelfMirSimpleStatementGraphOwnedKind(kind: Int) -> Bool {
    return kind == TypedAstKindLogStmtTag() ||
        kind == TypedAstKindBareCallStmtTag() ||
        kind == TypedAstKindExitStmtTag();
}

func SelfMirCollectionMutationKind(kind: Int) -> Bool {
    return kind == TypedAstKindArrayPopStmtTag() ||
        kind == TypedAstKindArrayPushStmtTag() ||
        kind == TypedAstKindArraySetStmtTag();
}

func SelfMirCollectionMutationTargetLocal(
    build: SelfMirRoutineBuild,
    target_graph: SemanticExpressionGraphView
) -> Option<Int> {
    if !target_graph.ok { return None; }
    let kind: Option<Int> = SemanticExpressionGraphNodeKind(
        target_graph.graph, target_graph.root_id
    );
    let text: Option<String> = SemanticExpressionGraphNodeText(
        target_graph.graph, target_graph.root_id
    );
    if !IsSome(kind) || !IsSome(text) ||
        UnwrapOption(kind) != AstExpressionNodeLeaf() {
        return None;
    }
    return SelfMirRoutineLocalIndex(build, UnwrapOption(text));
}

func SelfMirLowerGraphOwnedSimpleStatement(
    build: SelfMirRoutineBuild,
    kind: Int,
    payload: String,
    graph: SemanticExpressionGraphView
) -> SelfMirRoutineBuild {
    if !graph.ok {
        return SelfMirRoutineBuildError(
            build, "MIR graph-owned simple statement graph is missing"
        );
    }
    let expression: String = payload;
    let arg0: String = "";
    if kind == TypedAstKindLogStmtTag() {
        expression = Concat("Log(", Concat(payload, ")"));
        arg0 = "Log";
    } else if kind == TypedAstKindExitStmtTag() {
        expression = Concat("Exit(", Concat(payload, ")"));
        arg0 = "Exit";
    }
    build = SelfMirRoutineAddInstruction(
        build, "stmt", "stmt", "", arg0, "", expression, "",
        "AST_CALL", SelfMirExpressionGraphUses(build, graph)
    );
    if kind == TypedAstKindExitStmtTag() {
        build = SelfMirRoutineTerminate(build);
    }
    return build;
}

func SelfMirLowerCollectionMutationGraphOwnedSimpleStatement(
    build: SelfMirRoutineBuild,
    kind: Int,
    payload: String,
    value_payload: String,
    auxiliary_payload: String,
    target_graph: SemanticExpressionGraphView,
    value_graph: SemanticExpressionGraphView,
    auxiliary_graph: SemanticExpressionGraphView
) -> SelfMirRoutineBuild {
    let target_local: Option<Int> =
        SelfMirCollectionMutationTargetLocal(build, target_graph);
    if !IsSome(target_local) {
        return SelfMirRoutineBuildError(
            build, "MIR collection mutation target binding is missing"
        );
    }
    let uses: Array<String> = [];
    if !SelfMirExpressionGraphUsesAppend(build, uses, target_graph) {
        return SelfMirRoutineBuildError(
            build, "MIR collection mutation target expression graph is missing"
        );
    }
    if kind == TypedAstKindArrayPushStmtTag() ||
        kind == TypedAstKindArraySetStmtTag() {
        if !SelfMirExpressionGraphUsesAppend(build, uses, value_graph) {
            return SelfMirRoutineBuildError(
                build, "MIR collection mutation value expression graph is missing"
            );
        }
    }
    if kind == TypedAstKindArraySetStmtTag() &&
        !SelfMirExpressionGraphUsesAppend(build, uses, auxiliary_graph) {
        return SelfMirRoutineBuildError(
            build, "MIR collection mutation auxiliary expression graph is missing"
        );
    }
    let expression: String = payload;
    let secondary_expression: String = "";
    let arg0: String = "";
    if kind == TypedAstKindArrayPopStmtTag() {
        expression = Concat("ArrayPop(", Concat(payload, ")"));
        arg0 = "ArrayPop";
    } else if kind == TypedAstKindArraySetStmtTag() {
        secondary_expression = value_payload;
        expression = Concat(
            "ArraySet(", Concat(payload, Concat(", ", Concat(
                value_payload, Concat(", ", Concat(auxiliary_payload, ")"))
            )))
        );
        arg0 = "ArraySet";
    } else {
        expression = Concat(
            "ArrayPush(", Concat(
                payload, Concat(", ", Concat(value_payload, ")"))
            )
        );
        arg0 = "ArrayPush";
    }
    build = SelfMirRoutineAddInstruction(
        build, "stmt", "stmt", "", arg0, "", expression,
        secondary_expression, "AST_CALL", uses
    );
    return SelfMirRoutineAttachLastPrimaryLocalRef(
        build, UnwrapOption(target_local)
    );
}

func SelfMirLowerSimpleStatement(
    build: SelfMirRoutineBuild,
    kind: Int,
    payload: String,
    value_payload: String,
    auxiliary_payload: String
) -> SelfMirRoutineBuild {
    if kind == TypedAstKindBindStmtTag() {
        if payload == "" || value_payload == "" ||
            auxiliary_payload == "" {
            return SelfMirRoutineBuildError(
                build, "ability bind is missing party/slot/role facts"
            );
        }
        let bind_uses: Array<String> = [];
        build = SelfMirRoutineAddInstruction(
            build, "stmt", "bind", "", payload, value_payload,
            "", "", "AST_BIND_STMT", bind_uses
        );
        return SelfMirRoutineWithCfg(
            build,
            SelfMirCfgAttachLastSlotAnchor(
                build.cfg, auxiliary_payload
            )
        );
    }
    return SelfMirRoutineBuildError(
        build, "MIR simple statement requires an owned lowering lane"
    );
}
