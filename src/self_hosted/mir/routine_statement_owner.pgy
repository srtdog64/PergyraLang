// MIR lowering owner for payload-only call-shaped statements.

import "routine_build_owner.pgy";
import "routine_expression_use_owner.pgy";
import "../semantic/ast_statement_fact_owner.pgy";

func SelfMirSimpleStatementKind(kind: Int) -> Bool {
    return kind == TypedAstKindLogStmtTag() ||
        kind == TypedAstKindBareCallStmtTag() ||
        kind == TypedAstKindArrayPopStmtTag() ||
        kind == TypedAstKindArraySetStmtTag() ||
        kind == TypedAstKindArrayPushStmtTag() ||
        kind == TypedAstKindExitStmtTag() ||
        kind == TypedAstKindBindStmtTag();
}

func SelfMirSimpleStatementExpressionGraphLane(
    kind: Int
) -> Option<Int> {
    if kind == TypedAstKindLogStmtTag() ||
        kind == TypedAstKindBareCallStmtTag() ||
        kind == TypedAstKindExitStmtTag() {
        return Some(AstExpressionLaneAtom());
    }
    if kind == TypedAstKindArrayPushStmtTag() {
        return Some(AstExpressionLaneValue());
    }
    if kind == TypedAstKindArraySetStmtTag() {
        return Some(AstExpressionLaneAuxiliary());
    }
    return None;
}

func SelfMirLowerSimpleStatement(
    build: SelfMirRoutineBuild,
    kind: Int,
    payload: String,
    value_payload: String,
    auxiliary_payload: String
) -> SelfMirRoutineBuild {
    if kind == TypedAstKindBindStmtTag() {
        if payload == "" || value_payload == "" ||
            auxiliary_payload == "" {
            return SelfMirRoutineBuildError(
                build, "ability bind is missing party/slot/role facts"
            );
        }
        let bind_uses: Array<String> = [];
        build = SelfMirRoutineAddInstruction(
            build, "stmt", "bind", "", payload, value_payload,
            "", "", "AST_BIND_STMT", bind_uses
        );
        return SelfMirRoutineWithCfg(
            build,
            SelfMirCfgAttachLastSlotAnchor(
                build.cfg, auxiliary_payload
            )
        );
    }
    let expression: String = payload;
    let secondary_expression: String = "";
    let arg0: String = "";
    if kind == TypedAstKindLogStmtTag() {
        expression = Concat("Log(", Concat(payload, ")"));
        arg0 = "Log";
    } else if kind == TypedAstKindArrayPopStmtTag() {
        expression = Concat("ArrayPop(", Concat(payload, ")"));
        arg0 = "ArrayPop";
    } else if kind == TypedAstKindArraySetStmtTag() {
        secondary_expression = value_payload;
        expression = Concat(
            "ArraySet(", Concat(payload, Concat(", ", Concat(
                value_payload, Concat(", ", Concat(auxiliary_payload, ")"))
            )))
        );
        arg0 = "ArraySet";
    } else if kind == TypedAstKindArrayPushStmtTag() {
        expression = Concat(
            "ArrayPush(", Concat(
                payload, Concat(", ", Concat(value_payload, ")"))
            )
        );
        arg0 = "ArrayPush";
    } else if kind == TypedAstKindExitStmtTag() {
        expression = Concat("Exit(", Concat(payload, ")"));
        arg0 = "Exit";
    }
    build = SelfMirRoutineAddInstruction(
        build, "stmt", "stmt", "", arg0, "", expression,
        secondary_expression,
        "AST_CALL", SelfMirExpressionUses(build, expression)
    );
    if kind == TypedAstKindExitStmtTag() {
        build = SelfMirRoutineTerminate(build);
    }
    return build;
}
