// MIR dispatch for semantic statement rows.

import "routine_input_owner.pgy";
import "routine_build_owner.pgy";
import "routine_statement_owner.pgy";
import "routine_if_owner.pgy";
import "routine_while_owner.pgy";
import "routine_for_owner.pgy";

func SelfMirLowerTrackedStatementFromArtifact(
    ref input: SelfMirRoutineInput,
    build: SelfMirRoutineBuild,
    node_id: Int,
    kind: Int,
    inout break_blocks: Array<Int>,
    continue_target: Int
) -> SelfMirRoutineBuild {
    let statement_index_opt: Option<Int> =
        SemanticAstStatementIndexForNode(
            input.analysis.statements, node_id
        );
    if !IsSome(statement_index_opt) {
        return SelfMirRoutineBuildError(
            build, "MIR statement is missing semantic facts"
        );
    }
    let statement_index: Int = UnwrapOption(statement_index_opt);
    let payload: String =
        input.analysis.statements.payload_texts[statement_index];
    let value_payload: String =
        input.analysis.statements.value_texts[statement_index];
    let auxiliary_payload: String =
        input.analysis.statements.auxiliary_texts[statement_index];
    if SelfMirSimpleStatementKind(kind) {
        build = SelfMirLowerSimpleStatement(
            build, kind, payload, value_payload, auxiliary_payload
        );
        let graph_lane: Option<Int> =
            SelfMirSimpleStatementExpressionGraphLane(kind);
        if IsSome(graph_lane) {
            build = SelfMirRoutineAttachLastExpressionGraph(
                build, SemanticAstExpressionGraphForNode(
                    input.analysis.expression_surfaces,
                    node_id, UnwrapOption(graph_lane)
                ), input.machine_declaration
            );
        }
        if kind == TypedAstKindArraySetStmtTag() {
            build = SelfMirRoutineAttachLastSecondaryExpressionGraph(
                build, SemanticAstExpressionGraphForNode(
                    input.analysis.expression_surfaces,
                    node_id, AstExpressionLaneValue()
                )
            );
        }
        return build;
    }
    if kind == TypedAstKindBareReturnStmtTag() ||
        kind == TypedAstKindValueReturnStmtTag() {
        let return_source_type: String = "AST_RETURN_VOID";
        if kind == TypedAstKindValueReturnStmtTag() {
            return_source_type = SelfMirExpressionSourceTypeName(
                SelfMirExpressionKindFromText(payload)
            );
        }
        build = SelfMirRoutineAddInstruction(
            build, "return", "return", "", "", "", payload, "",
            return_source_type, SelfMirExpressionUses(build, payload)
        );
        if kind == TypedAstKindValueReturnStmtTag() {
            build = SelfMirRoutineAttachLastExpressionGraph(
                build, SemanticAstExpressionGraphForNode(
                    input.analysis.expression_surfaces,
                    node_id, AstExpressionLaneAtom()
                ), input.machine_declaration
            );
        }
        return SelfMirRoutineTerminate(build);
    }
    if kind == TypedAstKindIfStmtTag() {
        return SelfMirLowerIfFromArtifact(
            input, build, node_id, payload,
            break_blocks, continue_target
        );
    }
    if kind == TypedAstKindWhileStmtTag() {
        return SelfMirLowerWhileFromArtifact(input, build, node_id, payload);
    }
    if kind == TypedAstKindForStmtTag() {
        return SelfMirLowerForFromArtifact(
            input, build, node_id, statement_index
        );
    }
    return SelfMirRoutineBuildError(
        build, "statement kind is outside bounded MIR producer"
    );
}
