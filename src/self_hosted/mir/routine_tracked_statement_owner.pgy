// MIR dispatch for semantic statement rows.

import "routine_input_owner.pgy";
import "routine_build_owner.pgy";
import "routine_expression_use_owner.pgy";
import "routine_statement_owner.pgy";
import "routine_break_exit_fact_owner.pgy";
import "routine_if_owner.pgy";
import "routine_while_owner.pgy";
import "routine_for_owner.pgy";
import "routine_match_owner.pgy";
import "routine_defer_owner.pgy";

func SelfMirValueReturnSourceType(
    graph: SemanticExpressionGraphView,
    expression: String
) -> String {
    let kind_opt: Option<Int> = SemanticExpressionGraphNodeKind(
        graph.graph, graph.root_id
    );
    if IsSome(kind_opt) && AstExpressionNodeIsArrayLiteralSpine(
        UnwrapOption(kind_opt)
    ) {
        return "AST_ARRAY_LITERAL";
    }
    return SelfMirExpressionSourceTypeName(
        SelfMirExpressionKindFromText(expression)
    );
}

func SelfMirLowerTrackedStatementFromArtifact(
    ref input: SelfMirRoutineInput,
    build: SelfMirRoutineBuild,
    node_id: Int,
    kind: Int,
    inout break_exits: SelfMirBreakExitFacts,
    continue_target: Int
) -> SelfMirRoutineBuild {
    let statement_index_opt: Option<Int> =
        SemanticAstStatementIndexForNode(
            input.analysis.statements, node_id
        );
    if !IsSome(statement_index_opt) {
        return SelfMirRoutineBuildError(
            build, "MIR statement is missing semantic facts"
        );
    }
    let statement_index: Int = UnwrapOption(statement_index_opt);
    let payload: String =
        input.analysis.statements.payload_texts[statement_index];
    let value_payload: String =
        input.analysis.statements.value_texts[statement_index];
    let auxiliary_payload: String =
        input.analysis.statements.auxiliary_texts[statement_index];
    if SelfMirSimpleStatementGraphOwnedKind(kind) {
        let simple_graph: SemanticExpressionGraphView =
            SemanticAstExpressionGraphForNode(
                input.analysis.expression_surfaces,
                node_id, AstExpressionLaneAtom()
            );
        if !simple_graph.ok {
            return SelfMirRoutineBuildError(
                build, "MIR graph-owned simple statement graph is missing"
            );
        }
        build = SelfMirLowerGraphOwnedSimpleStatement(
            build, kind, payload, simple_graph
        );
        return SelfMirRoutineAttachLastExpressionGraph(
            build, simple_graph, input.machine_declaration
        );
    }
    if SelfMirCollectionMutationKind(kind) {
        let target_graph: SemanticExpressionGraphView =
            SemanticAstExpressionGraphForNode(
                input.analysis.expression_surfaces,
                node_id, AstExpressionLaneAtom()
            );
        let value_graph: SemanticExpressionGraphView =
            SemanticAstExpressionGraphForNode(
                input.analysis.expression_surfaces,
                node_id, AstExpressionLaneValue()
            );
        let auxiliary_graph: SemanticExpressionGraphView =
            SemanticAstExpressionGraphForNode(
                input.analysis.expression_surfaces,
                node_id, AstExpressionLaneAuxiliary()
            );
        if !target_graph.ok {
            return SelfMirRoutineBuildError(
                build, "MIR collection mutation target expression graph is missing"
            );
        }
        if (kind == TypedAstKindArrayPushStmtTag() ||
            kind == TypedAstKindArraySetStmtTag()) && !value_graph.ok {
            return SelfMirRoutineBuildError(
                build, "MIR collection mutation value expression graph is missing"
            );
        }
        if kind == TypedAstKindArraySetStmtTag() && !auxiliary_graph.ok {
            return SelfMirRoutineBuildError(
                build, "MIR collection mutation auxiliary expression graph is missing"
            );
        }
        build = SelfMirLowerCollectionMutationGraphOwnedSimpleStatement(
            build, kind, payload, value_payload, auxiliary_payload,
            target_graph, value_graph, auxiliary_graph
        );
        let graph_lane: Option<Int> =
            SelfMirSimpleStatementExpressionGraphLane(kind);
        if IsSome(graph_lane) {
            build = SelfMirRoutineAttachLastExpressionGraph(
                build, SemanticAstExpressionGraphForNode(
                    input.analysis.expression_surfaces,
                    node_id, UnwrapOption(graph_lane)
                ), input.machine_declaration
            );
        }
        if kind == TypedAstKindArraySetStmtTag() {
            build = SelfMirRoutineAttachLastSecondaryExpressionGraph(
                build, SemanticAstExpressionGraphForNode(
                    input.analysis.expression_surfaces,
                    node_id, AstExpressionLaneValue()
                )
            );
        }
        return build;
    }
    if SelfMirSimpleStatementKind(kind) {
        build = SelfMirLowerSimpleStatement(
            build, kind, payload, value_payload, auxiliary_payload
        );
        let graph_lane: Option<Int> =
            SelfMirSimpleStatementExpressionGraphLane(kind);
        if IsSome(graph_lane) {
            build = SelfMirRoutineAttachLastExpressionGraph(
                build, SemanticAstExpressionGraphForNode(
                    input.analysis.expression_surfaces,
                    node_id, UnwrapOption(graph_lane)
                ), input.machine_declaration
            );
        }
        return build;
    }
    if kind == TypedAstKindBareReturnStmtTag() {
        build = SelfMirRoutineAddInstruction(
            build, "return", "return", "", "", "", payload, "",
            "AST_RETURN_VOID", SelfMirNoUses()
        );
        return SelfMirRoutineTerminate(build);
    }
    if kind == TypedAstKindValueReturnStmtTag() {
        let return_graph: SemanticExpressionGraphView =
            SemanticAstExpressionGraphForNode(
                input.analysis.expression_surfaces,
                node_id, AstExpressionLaneAtom()
            );
        if !return_graph.ok {
            return SelfMirRoutineBuildError(
                build, "MIR value return expression graph is missing"
            );
        }
        let return_source_type: String = SelfMirValueReturnSourceType(
            return_graph, payload
        );
        let return_type: Option<String> =
            SemanticAstStatementInferredTypeForNode(
                input.statement_types, node_id, kind
            );
        if !IsSome(return_type) {
            return SelfMirRoutineBuildError(
                build, "MIR value return type fact is missing"
            );
        }
        build = SelfMirRoutineAddInstruction(
            build, "return", "return", "", "", "", payload, "",
            return_source_type,
            SelfMirExpressionGraphUses(build, return_graph)
        );
        build = SelfMirRoutineAttachLastAbiTypeName(
            build, UnwrapOption(return_type)
        );
        build = SelfMirRoutineAttachLastExpressionGraph(
            build, return_graph, input.machine_declaration
        );
        return SelfMirRoutineTerminate(build);
    }
    if kind == TypedAstKindIfStmtTag() {
        return SelfMirLowerIfFromArtifact(
            input, build, node_id, payload,
            break_exits, continue_target
        );
    }
    if kind == TypedAstKindWhileStmtTag() {
        return SelfMirLowerWhileFromArtifact(input, build, node_id, payload);
    }
    if kind == TypedAstKindForStmtTag() {
        return SelfMirLowerForFromArtifact(
            input, build, node_id, statement_index
        );
    }
    if kind == TypedAstKindMatchStmtTag() {
        return SelfMirLowerMatchFromArtifact(
            input, build, node_id, payload,
            break_exits, continue_target
        );
    }
    if kind == TypedAstKindDeferStmtTag() {
        return SelfMirLowerDeferFromArtifact(input, build, node_id);
    }
    return SelfMirRoutineBuildError(
        build, "statement kind is outside bounded MIR producer"
    );
}
