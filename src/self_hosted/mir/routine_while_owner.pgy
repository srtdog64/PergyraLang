// MIR while-loop CFG and loop-carried SSA state transformer.

import "routine_input_owner.pgy";
import "routine_build_owner.pgy";
import "routine_expression_use_owner.pgy";
import "expression_fact_owner.pgy";
import "loop_reachability_fact_owner.pgy";
import "routine_loop_header_phi_owner.pgy";
import "routine_loop_header_backedge_binding_owner.pgy";
import "routine_loop_exit_phi_owner.pgy";

func SelfMirLowerWhileFromArtifact(
    ref input: SelfMirRoutineInput,
    build: SelfMirRoutineBuild,
    node_id: Int,
    condition: String
) -> SelfMirRoutineBuild {
    let condition_graph: SemanticExpressionGraphView =
        SemanticAstExpressionGraphForNode(
            input.analysis.expression_surfaces,
            node_id, AstExpressionLaneAtom()
        );
    if !condition_graph.ok {
        return SelfMirRoutineBuildError(
            build, "MIR while condition expression graph is missing"
        );
    }
    let body_opt: Option<Int> = SelfMirControlBodyBlock(
        input.artifact.arena, node_id
    );
    if !IsSome(body_opt) {
        return SelfMirRoutineBuildError(
            build, "MIR while body block is missing"
        );
    }
    let reachability: SelfMirLoopReachabilityFact =
        SelfMirLoopReachabilityForBlock(
            input.artifact.arena, UnwrapOption(body_opt)
        );
    if !reachability.ok {
        return SelfMirRoutineBuildError(
            build, "MIR loop reachability fact is missing"
        );
    }
    let planned_backedge: Bool = reachability.reaches_backedge ||
        reachability.falls_through;
    let preheader: Int = build.current_block;
    build = SelfMirRoutineAddBlock(build);
    let header: Int = SelfMirCfgBlockCount(build.cfg) - 1;
    build = SelfMirRoutineSetSuccessors(build, preheader, header, -1);
    build = SelfMirRoutineAtBlock(build, header);
    build = SelfMirLoopPrepareHeaderLocalVersions(
        input, build, UnwrapOption(body_opt), planned_backedge,
        ArrayLength(build.local_names)
    );
    build = SelfMirRoutineAddInstruction(
        build, "branch", "branch", "", "", "", condition, "",
        SelfMirExpressionSourceTypeName(
            SelfMirExpressionKindFromText(condition)
        ),
        SelfMirExpressionGraphUses(build, condition_graph)
    );
    build = SelfMirRoutineAttachLastExpressionGraph(
        build, condition_graph, input.machine_declaration
    );
    let header_versions: Array<Int> =
        SelfMirLocalVersionsSnapshot(build.local_versions);
    build = SelfMirRoutineAddBlock(build);
    let loop_body: Int = SelfMirCfgBlockCount(build.cfg) - 1;
    build = SelfMirRoutineAtBlock(build, loop_body);
    let while_break_exits: SelfMirLocalPredecessorSnapshots =
        SelfMirLocalPredecessorSnapshotsEmpty();
    let backedge_snapshots: SelfMirLocalPredecessorSnapshots =
        SelfMirLocalPredecessorSnapshotsEmpty();
    let body_local_count: Int = ArrayLength(build.local_names);
    build = SelfMirLowerBlockFromArtifact(
        input, build, UnwrapOption(body_opt),
        while_break_exits, backedge_snapshots, header, body_local_count
    );
    let body_exit: Int = build.current_block;
    if build.terminated[body_exit] == 0 {
        backedge_snapshots = SelfMirLocalPredecessorSnapshotsAppend(
            backedge_snapshots, build
        );
        build = SelfMirRoutineSetSuccessors(build, body_exit, header, -1);
    }
    let observed_backedge: Bool =
        ArrayLength(backedge_snapshots.blocks) > 0;
    if observed_backedge != planned_backedge {
        return SelfMirRoutineBuildError(
            build, "MIR loop reachability fact disagrees with CFG"
        );
    }
    build = SelfMirLoopBindHeaderBackedgeLocalVersions(
        build, header, backedge_snapshots
    );
    build = SelfMirRoutineAddBlock(build);
    let loop_exit: Int = SelfMirCfgBlockCount(build.cfg) - 1;
    let break_i: Int = 0;
    while break_i < ArrayLength(while_break_exits.blocks) {
        build = SelfMirRoutineSetSuccessors(
            build, while_break_exits.blocks[break_i], loop_exit, -1
        );
        break_i = break_i + 1;
    }
    let condition_exit: Int = loop_exit;
    if SelfMirLoopConstantTrueExitInfeasible(
        condition_graph, reachability, ArrayLength(while_break_exits.blocks)
    ) {
        condition_exit = -1;
    }
    build = SelfMirRoutineSetSuccessors(
        build, header, loop_body, condition_exit
    );
    return SelfMirLoopExitMergeLocalVersions(
        build, header_versions, while_break_exits,
        condition_exit >= 0, loop_exit
    );
}
