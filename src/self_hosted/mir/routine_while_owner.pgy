// MIR while-loop CFG and loop-carried SSA state transformer.

import "routine_input_owner.pgy";
import "routine_build_owner.pgy";
import "routine_expression_use_owner.pgy";
import "expression_fact_owner.pgy";
import "loop_reachability_fact_owner.pgy";

func SelfMirLowerWhileFromArtifact(
    ref input: SelfMirRoutineInput,
    build: SelfMirRoutineBuild,
    node_id: Int,
    condition: String
) -> SelfMirRoutineBuild {
    let body_opt: Option<Int> = SelfMirControlBodyBlock(
        input.artifact.arena, node_id
    );
    if !IsSome(body_opt) {
        return SelfMirRoutineBuildError(
            build, "MIR while body block is missing"
        );
    }
    let reachability: SelfMirLoopReachabilityFact =
        SelfMirLoopReachabilityForBlock(
            input.artifact.arena, UnwrapOption(body_opt)
        );
    if !reachability.ok {
        return SelfMirRoutineBuildError(
            build, "MIR loop reachability fact is missing"
        );
    }
    let planned_backedge: Bool = reachability.reaches_backedge ||
        reachability.falls_through;
    let preheader: Int = build.current_block;
    build = SelfMirRoutineAddBlock(build);
    let header: Int = SelfMirCfgBlockCount(build.cfg) - 1;
    build = SelfMirRoutineSetSuccessors(build, preheader, header, -1);
    build = SelfMirRoutineAtBlock(build, header);
    let local_i: Int = 0;
    while local_i < ArrayLength(build.local_names) {
        if planned_backedge && SelfMirLoopAssignedLocal(
            input, UnwrapOption(body_opt), build.local_names[local_i]
        ) {
            let old_version: Int = build.local_versions[local_i];
            let phi_version: Int = build.next_instruction_id + 1;
            let future_version: Int = phi_version + 2;
            let phi_uses: Array<String> = [
                SelfMirSsaName(build.local_names[local_i], old_version),
                SelfMirSsaName(build.local_names[local_i], future_version)
            ];
            build = SelfMirRoutineAddInstruction(
                build, "phi", build.local_names[local_i],
                SelfMirSsaName(build.local_names[local_i], phi_version),
                "phi", "", "", "", "", phi_uses
            );
            // The phi result itself is the current version.  Advancing once
            // more would advertise a version with no defining instruction
            // to nested branch merges in the loop body.
            build = SelfMirRoutineSetLocalVersion(
                build, local_i, phi_version
            );
        }
        local_i = local_i + 1;
    }
    build = SelfMirRoutineAddInstruction(
        build, "branch", "branch", "", "", "", condition, "",
        SelfMirExpressionSourceTypeName(
            SelfMirExpressionKindFromText(condition)
        ),
        SelfMirExpressionUses(build, condition)
    );
    build = SelfMirRoutineAttachLastExpressionGraph(
        build, SemanticAstExpressionGraphForNode(
            input.analysis.expression_surfaces,
            node_id, AstExpressionLaneAtom()
        ), input.machine_declaration
    );
    build = SelfMirRoutineAddBlock(build);
    let loop_body: Int = SelfMirCfgBlockCount(build.cfg) - 1;
    build = SelfMirRoutineAtBlock(build, loop_body);
    let while_break_blocks: Array<Int> = [];
    let body_local_count: Int = ArrayLength(build.local_names);
    build = SelfMirLowerBlockFromArtifact(
        input, build, UnwrapOption(body_opt),
        while_break_blocks, header, body_local_count
    );
    let body_exit: Int = build.current_block;
    let observed_backedge: Bool = build.terminated[body_exit] == 0;
    let body_block_i: Int = loop_body;
    while body_block_i < SelfMirCfgBlockCount(build.cfg) {
        if (build.cfg.blocks.has_succ_true[body_block_i] == 1 &&
            build.cfg.blocks.succ_true[body_block_i] == header) ||
            (build.cfg.blocks.has_succ_false[body_block_i] == 1 &&
             build.cfg.blocks.succ_false[body_block_i] == header) {
            observed_backedge = true;
        }
        body_block_i = body_block_i + 1;
    }
    if observed_backedge != planned_backedge {
        return SelfMirRoutineBuildError(
            build, "MIR loop reachability fact disagrees with CFG"
        );
    }
    // The completed CFG owns whether the loop actually has a backedge.  A
    // loop whose every path breaks has only the preheader predecessor; normal
    // fallthrough and explicit continue retain the live local as input two.
    let phi_instruction_i: Int = build.cfg.blocks.instruction_starts[header];
    let phi_instruction_end: Int = phi_instruction_i +
        build.cfg.blocks.instruction_counts[header];
    while phi_instruction_i < phi_instruction_end {
        if build.cfg.instructions.kinds[phi_instruction_i] == "phi" {
            let phi_name: String = build.cfg.instructions.names[
                phi_instruction_i
            ];
            let local_opt: Option<Int> = SelfMirRoutineLocalIndex(
                build, phi_name
            );
            if IsSome(local_opt) {
                let use_count: Int = build.cfg.instructions.use_counts[
                    phi_instruction_i
                ];
                if use_count == 2 {
                    let use_start: Int =
                        build.cfg.instructions.use_starts[phi_instruction_i];
                    let phi_uses: Array<String> = [
                        build.cfg.instructions.uses[use_start]
                    ];
                    if planned_backedge {
                        let local_i: Int = UnwrapOption(local_opt);
                        ArrayPush(
                            phi_uses,
                            SelfMirSsaName(
                                phi_name, build.local_versions[local_i]
                            )
                        );
                    }
                    build = SelfMirRoutineWithCfg(
                        build, SelfMirCfgSetInstructionUses(
                            build.cfg, phi_instruction_i, phi_uses
                        )
                    );
                }
            }
        }
        phi_instruction_i = phi_instruction_i + 1;
    }
    if build.terminated[body_exit] == 0 {
        build = SelfMirRoutineSetSuccessors(build, body_exit, header, -1);
    }
    build = SelfMirRoutineAddBlock(build);
    let loop_exit: Int = SelfMirCfgBlockCount(build.cfg) - 1;
    let break_i: Int = 0;
    while break_i < ArrayLength(while_break_blocks) {
        build = SelfMirRoutineSetSuccessors(
            build, while_break_blocks[break_i], loop_exit, -1
        );
        break_i = break_i + 1;
    }
    return SelfMirRoutineSetSuccessors(
        build, header, loop_body, loop_exit
    );
}
