// Runtime-call ABI facts attached to self-host MIR instruction rows.
//
// The compiler ABI projection supplies the structured row. This owner only
// stores it beside the instruction that consumes it; it never reconstructs a
// row from source text, emitted code, or backend spelling.

import "../compiler/runtime_call_abi_structured_fact_owner.pgy";

struct SelfMirRuntimeCallAbiRows {
    present: Array<Int>;
    owners: Array<String>;
    domains: Array<String>;
    type_names: Array<String>;
    operations: Array<String>;
    symbols: Array<String>;
    target_kinds: Array<String>;
    materializations: Array<String>;
    call_shapes: Array<String>;
    runtime_call_abi_ids: Array<Int>;
    aux_instruction_indices: Array<Int>;
    aux_owners: Array<String>;
    aux_domains: Array<String>;
    aux_type_names: Array<String>;
    aux_operations: Array<String>;
    aux_symbols: Array<String>;
    aux_target_kinds: Array<String>;
    aux_materializations: Array<String>;
    aux_call_shapes: Array<String>;
    aux_runtime_call_abi_ids: Array<Int>;
}

func SelfMirRuntimeCallAbiRowsEmpty() -> SelfMirRuntimeCallAbiRows {
    let ints: Array<Int> = [];
    let strings: Array<String> = [];
    let ids: Array<Int> = [];
    return SelfMirRuntimeCallAbiRows(
        ints, strings, strings, strings, strings, strings, strings, strings,
        strings, ids, ints, strings, strings, strings, strings, strings,
        strings, strings, strings, ids
    );
}

func SelfMirRuntimeCallAbiRowsAppendInstruction(
    rows: SelfMirRuntimeCallAbiRows
) -> SelfMirRuntimeCallAbiRows {
    let present: Array<Int> = rows.present;
    let owners: Array<String> = rows.owners;
    let domains: Array<String> = rows.domains;
    let type_names: Array<String> = rows.type_names;
    let operations: Array<String> = rows.operations;
    let symbols: Array<String> = rows.symbols;
    let target_kinds: Array<String> = rows.target_kinds;
    let materializations: Array<String> = rows.materializations;
    let call_shapes: Array<String> = rows.call_shapes;
    let runtime_call_abi_ids: Array<Int> = rows.runtime_call_abi_ids;
    ArrayPush(present, 0);
    ArrayPush(owners, "");
    ArrayPush(domains, "");
    ArrayPush(type_names, "");
    ArrayPush(operations, "");
    ArrayPush(symbols, "");
    ArrayPush(target_kinds, "");
    ArrayPush(materializations, "");
    ArrayPush(call_shapes, "");
    ArrayPush(runtime_call_abi_ids, 0);
    return SelfMirRuntimeCallAbiRows(
        present, owners, domains, type_names, operations, symbols,
        target_kinds, materializations, call_shapes, runtime_call_abi_ids,
        rows.aux_instruction_indices, rows.aux_owners, rows.aux_domains,
        rows.aux_type_names, rows.aux_operations, rows.aux_symbols,
        rows.aux_target_kinds, rows.aux_materializations,
        rows.aux_call_shapes, rows.aux_runtime_call_abi_ids
    );
}

func SelfMirRuntimeCallAbiRowsForInstructionCount(
    instruction_count: Int
) -> SelfMirRuntimeCallAbiRows {
    let rows: SelfMirRuntimeCallAbiRows =
        SelfMirRuntimeCallAbiRowsEmpty();
    let i: Int = 0;
    while i < instruction_count {
        rows = SelfMirRuntimeCallAbiRowsAppendInstruction(rows);
        i = i + 1;
    }
    return rows;
}

func SelfMirRuntimeCallAbiRowsAppendRows(
    target: SelfMirRuntimeCallAbiRows,
    source: SelfMirRuntimeCallAbiRows
) -> SelfMirRuntimeCallAbiRows {
    let instruction_offset: Int = ArrayLength(target.present);
    let present: Array<Int> = target.present;
    let owners: Array<String> = target.owners;
    let domains: Array<String> = target.domains;
    let type_names: Array<String> = target.type_names;
    let operations: Array<String> = target.operations;
    let symbols: Array<String> = target.symbols;
    let target_kinds: Array<String> = target.target_kinds;
    let materializations: Array<String> = target.materializations;
    let call_shapes: Array<String> = target.call_shapes;
    let runtime_call_abi_ids: Array<Int> = target.runtime_call_abi_ids;
    let aux_instruction_indices: Array<Int> = target.aux_instruction_indices;
    let aux_owners: Array<String> = target.aux_owners;
    let aux_domains: Array<String> = target.aux_domains;
    let aux_type_names: Array<String> = target.aux_type_names;
    let aux_operations: Array<String> = target.aux_operations;
    let aux_symbols: Array<String> = target.aux_symbols;
    let aux_target_kinds: Array<String> = target.aux_target_kinds;
    let aux_materializations: Array<String> = target.aux_materializations;
    let aux_call_shapes: Array<String> = target.aux_call_shapes;
    let aux_runtime_call_abi_ids: Array<Int> =
        target.aux_runtime_call_abi_ids;
    let i: Int = 0;
    while i < ArrayLength(source.present) {
        ArrayPush(present, source.present[i]);
        ArrayPush(owners, source.owners[i]);
        ArrayPush(domains, source.domains[i]);
        ArrayPush(type_names, source.type_names[i]);
        ArrayPush(operations, source.operations[i]);
        ArrayPush(symbols, source.symbols[i]);
        ArrayPush(target_kinds, source.target_kinds[i]);
        ArrayPush(materializations, source.materializations[i]);
        ArrayPush(call_shapes, source.call_shapes[i]);
        ArrayPush(runtime_call_abi_ids, source.runtime_call_abi_ids[i]);
        i = i + 1;
    }
    i = 0;
    while i < ArrayLength(source.aux_instruction_indices) {
        ArrayPush(
            aux_instruction_indices,
            source.aux_instruction_indices[i] + instruction_offset
        );
        ArrayPush(aux_owners, source.aux_owners[i]);
        ArrayPush(aux_domains, source.aux_domains[i]);
        ArrayPush(aux_type_names, source.aux_type_names[i]);
        ArrayPush(aux_operations, source.aux_operations[i]);
        ArrayPush(aux_symbols, source.aux_symbols[i]);
        ArrayPush(aux_target_kinds, source.aux_target_kinds[i]);
        ArrayPush(aux_materializations, source.aux_materializations[i]);
        ArrayPush(aux_call_shapes, source.aux_call_shapes[i]);
        ArrayPush(
            aux_runtime_call_abi_ids,
            source.aux_runtime_call_abi_ids[i]
        );
        i = i + 1;
    }
    return SelfMirRuntimeCallAbiRows(
        present, owners, domains, type_names, operations, symbols,
        target_kinds, materializations, call_shapes, runtime_call_abi_ids,
        aux_instruction_indices, aux_owners, aux_domains, aux_type_names,
        aux_operations, aux_symbols, aux_target_kinds,
        aux_materializations, aux_call_shapes, aux_runtime_call_abi_ids
    );
}

func SelfMirRuntimeCallAbiRowsAttachLast(
    rows: SelfMirRuntimeCallAbiRows,
    type_name: String,
    operation: String,
    fact: CompilerRuntimeCallAbiFact
) -> SelfMirRuntimeCallAbiRows {
    let index: Int = ArrayLength(rows.present) - 1;
    if index < 0 || !fact.ok {
        return rows;
    }
    let present: Array<Int> = rows.present;
    let owners: Array<String> = rows.owners;
    let domains: Array<String> = rows.domains;
    let type_names: Array<String> = rows.type_names;
    let operations: Array<String> = rows.operations;
    let symbols: Array<String> = rows.symbols;
    let target_kinds: Array<String> = rows.target_kinds;
    let materializations: Array<String> = rows.materializations;
    let call_shapes: Array<String> = rows.call_shapes;
    let runtime_call_abi_ids: Array<Int> = rows.runtime_call_abi_ids;
    ArraySet(present, index, 1);
    ArraySet(owners, index, "MIRResource");
    ArraySet(domains, index, fact.domain);
    ArraySet(type_names, index, type_name);
    ArraySet(operations, index, operation);
    ArraySet(symbols, index, fact.symbol);
    ArraySet(target_kinds, index, fact.symbol_kind);
    ArraySet(materializations, index, fact.materialization);
    ArraySet(call_shapes, index, fact.call_shape);
    ArraySet(runtime_call_abi_ids, index, fact.runtime_call_abi_id);
    return SelfMirRuntimeCallAbiRows(
        present, owners, domains, type_names, operations, symbols,
        target_kinds, materializations, call_shapes, runtime_call_abi_ids,
        rows.aux_instruction_indices, rows.aux_owners, rows.aux_domains,
        rows.aux_type_names, rows.aux_operations, rows.aux_symbols,
        rows.aux_target_kinds, rows.aux_materializations,
        rows.aux_call_shapes, rows.aux_runtime_call_abi_ids
    );
}

func SelfMirRuntimeCallAbiRowsAttachLastAux(
    rows: SelfMirRuntimeCallAbiRows,
    type_name: String,
    operation: String,
    fact: CompilerRuntimeCallAbiFact
) -> SelfMirRuntimeCallAbiRows {
    let instruction_index: Int = ArrayLength(rows.present) - 1;
    if instruction_index < 0 || !fact.ok { return rows; }
    let aux_instruction_indices: Array<Int> = rows.aux_instruction_indices;
    let aux_owners: Array<String> = rows.aux_owners;
    let aux_domains: Array<String> = rows.aux_domains;
    let aux_type_names: Array<String> = rows.aux_type_names;
    let aux_operations: Array<String> = rows.aux_operations;
    let aux_symbols: Array<String> = rows.aux_symbols;
    let aux_target_kinds: Array<String> = rows.aux_target_kinds;
    let aux_materializations: Array<String> = rows.aux_materializations;
    let aux_call_shapes: Array<String> = rows.aux_call_shapes;
    let aux_runtime_call_abi_ids: Array<Int> = rows.aux_runtime_call_abi_ids;
    ArrayPush(aux_instruction_indices, instruction_index);
    ArrayPush(aux_owners, "MIRResource");
    ArrayPush(aux_domains, fact.domain);
    ArrayPush(aux_type_names, type_name);
    ArrayPush(aux_operations, operation);
    ArrayPush(aux_symbols, fact.symbol);
    ArrayPush(aux_target_kinds, fact.symbol_kind);
    ArrayPush(aux_materializations, fact.materialization);
    ArrayPush(aux_call_shapes, fact.call_shape);
    ArrayPush(aux_runtime_call_abi_ids, fact.runtime_call_abi_id);
    return SelfMirRuntimeCallAbiRows(
        rows.present, rows.owners, rows.domains, rows.type_names,
        rows.operations, rows.symbols, rows.target_kinds,
        rows.materializations, rows.call_shapes, rows.runtime_call_abi_ids,
        aux_instruction_indices, aux_owners, aux_domains, aux_type_names,
        aux_operations, aux_symbols, aux_target_kinds,
        aux_materializations, aux_call_shapes, aux_runtime_call_abi_ids
    );
}

func SelfMirRuntimeCallAbiRowsReady(
    rows: SelfMirRuntimeCallAbiRows,
    instruction_count: Int
) -> Bool {
    return ArrayLength(rows.present) == instruction_count &&
        ArrayLength(rows.owners) == instruction_count &&
        ArrayLength(rows.domains) == instruction_count &&
        ArrayLength(rows.type_names) == instruction_count &&
        ArrayLength(rows.operations) == instruction_count &&
        ArrayLength(rows.symbols) == instruction_count &&
        ArrayLength(rows.target_kinds) == instruction_count &&
        ArrayLength(rows.materializations) == instruction_count &&
        ArrayLength(rows.call_shapes) == instruction_count &&
        ArrayLength(rows.runtime_call_abi_ids) == instruction_count &&
        ArrayLength(rows.aux_owners) ==
            ArrayLength(rows.aux_instruction_indices) &&
        ArrayLength(rows.aux_domains) ==
            ArrayLength(rows.aux_instruction_indices) &&
        ArrayLength(rows.aux_type_names) ==
            ArrayLength(rows.aux_instruction_indices) &&
        ArrayLength(rows.aux_operations) ==
            ArrayLength(rows.aux_instruction_indices) &&
        ArrayLength(rows.aux_symbols) ==
            ArrayLength(rows.aux_instruction_indices) &&
        ArrayLength(rows.aux_target_kinds) ==
            ArrayLength(rows.aux_instruction_indices) &&
        ArrayLength(rows.aux_materializations) ==
            ArrayLength(rows.aux_instruction_indices) &&
        ArrayLength(rows.aux_call_shapes) ==
            ArrayLength(rows.aux_instruction_indices) &&
        ArrayLength(rows.aux_runtime_call_abi_ids) ==
            ArrayLength(rows.aux_instruction_indices);
}

func SelfMirRuntimeCallAbiRowValidationError(
    rows: SelfMirRuntimeCallAbiRows,
    instruction_index: Int,
    expected_operation: String
) -> String {
    if expected_operation == "" && rows.present[instruction_index] == 1 {
        expected_operation = rows.operations[instruction_index];
    }
    if expected_operation == "" {
        if rows.present[instruction_index] != 0 ||
            rows.owners[instruction_index] != "" ||
            rows.domains[instruction_index] != "" ||
            rows.type_names[instruction_index] != "" ||
            rows.operations[instruction_index] != "" ||
            rows.symbols[instruction_index] != "" ||
            rows.target_kinds[instruction_index] != "" ||
            rows.materializations[instruction_index] != "" ||
            rows.call_shapes[instruction_index] != "" ||
            rows.runtime_call_abi_ids[instruction_index] != 0 {
            return "runtime-call ABI row is attached without an operation";
        }
        let aux_index: Int = 0;
        while aux_index < ArrayLength(rows.aux_instruction_indices) {
            if rows.aux_instruction_indices[aux_index] == instruction_index {
                return "runtime-call ABI auxiliary row has no primary row";
            }
            aux_index = aux_index + 1;
        }
        return "";
    }
    if rows.present[instruction_index] != 1 {
        return "resource instruction is missing its runtime-call ABI row";
    }
    let type_name: String = rows.type_names[instruction_index];
    let expected: CompilerRuntimeCallAbiFact =
        CompilerRuntimeCallAbiFactForNativeResource(
            type_name, expected_operation
        );
    if !expected.ok {
        return "resource runtime-call ABI row has no declared projection";
    }
    if rows.owners[instruction_index] != "MIRResource" ||
        rows.domains[instruction_index] != expected.domain ||
        rows.operations[instruction_index] != expected_operation ||
        rows.symbols[instruction_index] != expected.symbol ||
        rows.target_kinds[instruction_index] != expected.symbol_kind ||
        rows.materializations[instruction_index] !=
            expected.materialization ||
        rows.call_shapes[instruction_index] != expected.call_shape {
        return "resource runtime-call ABI row differs from its owner";
    }
    if rows.runtime_call_abi_ids[instruction_index] <= 0 ||
        rows.runtime_call_abi_ids[instruction_index] !=
            expected.runtime_call_abi_id {
        return "resource runtime-call ABI row has an invalid stable identity";
    }
    let aux_index: Int = 0;
    while aux_index < ArrayLength(rows.aux_instruction_indices) {
        if rows.aux_instruction_indices[aux_index] == instruction_index {
            let aux_operation: String = rows.aux_operations[aux_index];
            let aux_type: String = rows.aux_type_names[aux_index];
            let aux_expected: CompilerRuntimeCallAbiFact =
                CompilerRuntimeCallAbiFactForNativeResource(
                    aux_type, aux_operation
                );
            if aux_operation == expected_operation ||
                aux_type != type_name || !aux_expected.ok ||
                rows.aux_owners[aux_index] != "MIRResource" ||
                rows.aux_domains[aux_index] != aux_expected.domain ||
                rows.aux_symbols[aux_index] != aux_expected.symbol ||
                rows.aux_target_kinds[aux_index] !=
                    aux_expected.symbol_kind ||
                rows.aux_materializations[aux_index] !=
                    aux_expected.materialization ||
                rows.aux_call_shapes[aux_index] !=
                    aux_expected.call_shape ||
                rows.aux_runtime_call_abi_ids[aux_index] !=
                    aux_expected.runtime_call_abi_id {
                return "resource runtime-call ABI auxiliary row differs from its owner";
            }
            let prior: Int = 0;
            while prior < aux_index {
                if rows.aux_instruction_indices[prior] == instruction_index &&
                    rows.aux_operations[prior] == aux_operation {
                    return "resource runtime-call ABI auxiliary operation is duplicated";
                }
                prior = prior + 1;
            }
        }
        aux_index = aux_index + 1;
    }
    return "";
}
