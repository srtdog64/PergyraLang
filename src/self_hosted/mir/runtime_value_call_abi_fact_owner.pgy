// Runtime-value call ABI rows attached to self-host MIR instructions.
//
// A root direct builtin call is admitted by semantic identity and projected
// from CompilerRuntimeValueCallAbiFact.  These rows intentionally do not share
// the resource-call schema: native MIR serializes owner/source and both target
// shapes for Allocator/TextBuilder calls.

import "../compiler/runtime_value_call_abi_owner.pgy";

struct SelfMirRuntimeValueCallAbiRows {
    present: Array<Int>;
    owners: Array<String>;
    sources: Array<String>;
    operations: Array<String>;
    c_symbols: Array<String>;
    llvm_symbols: Array<String>;
    c_shapes: Array<String>;
    llvm_shapes: Array<String>;
    runtime_call_abi_ids: Array<Int>;
}

func SelfMirRuntimeValueCallAbiRowsEmpty(
) -> SelfMirRuntimeValueCallAbiRows {
    let ints: Array<Int> = [];
    let strings: Array<String> = [];
    return SelfMirRuntimeValueCallAbiRows(
        ints, strings, strings, strings, strings, strings, strings, strings,
        ints);
}

func SelfMirRuntimeValueCallAbiRowsAppendInstruction(
    rows: SelfMirRuntimeValueCallAbiRows
) -> SelfMirRuntimeValueCallAbiRows {
    ArrayPush(rows.present, 0);
    ArrayPushOwnedString(rows.owners, "");
    ArrayPushOwnedString(rows.sources, "");
    ArrayPushOwnedString(rows.operations, "");
    ArrayPushOwnedString(rows.c_symbols, "");
    ArrayPushOwnedString(rows.llvm_symbols, "");
    ArrayPushOwnedString(rows.c_shapes, "");
    ArrayPushOwnedString(rows.llvm_shapes, "");
    ArrayPush(rows.runtime_call_abi_ids, 0);
    return rows;
}

func SelfMirRuntimeValueCallAbiRowsAppendRows(
    target: SelfMirRuntimeValueCallAbiRows,
    source: SelfMirRuntimeValueCallAbiRows
) -> SelfMirRuntimeValueCallAbiRows {
    var i: Int = 0;
    while i < ArrayLength(source.present) {
        ArrayPush(target.present, source.present[i]);
        ArrayPushOwnedString(target.owners, source.owners[i]);
        ArrayPushOwnedString(target.sources, source.sources[i]);
        ArrayPushOwnedString(target.operations, source.operations[i]);
        ArrayPushOwnedString(target.c_symbols, source.c_symbols[i]);
        ArrayPushOwnedString(target.llvm_symbols, source.llvm_symbols[i]);
        ArrayPushOwnedString(target.c_shapes, source.c_shapes[i]);
        ArrayPushOwnedString(target.llvm_shapes, source.llvm_shapes[i]);
        ArrayPush(target.runtime_call_abi_ids, source.runtime_call_abi_ids[i]);
        i = i + 1;
    }
    return target;
}

func SelfMirRuntimeValueCallAbiRowsAttachLast(
    rows: SelfMirRuntimeValueCallAbiRows,
    ref fact: CompilerRuntimeValueCallAbiFact
) -> SelfMirRuntimeValueCallAbiRows {
    let index: Int = ArrayLength(rows.present) - 1;
    if index < 0 || !fact.valid || rows.present[index] != 0 {
        return rows;
    }
    ArraySet(rows.present, index, 1);
    ArraySet(rows.owners, index, Clone(fact.owner_name));
    ArraySet(rows.sources, index, Clone(fact.source_name));
    ArraySet(rows.operations, index, Clone(fact.native_operation));
    ArraySet(rows.c_symbols, index, Clone(fact.c_symbol));
    ArraySet(rows.llvm_symbols, index, Clone(fact.llvm_symbol));
    ArraySet(rows.c_shapes, index, Clone(fact.c_shape));
    ArraySet(rows.llvm_shapes, index, Clone(fact.llvm_shape));
    ArraySet(rows.runtime_call_abi_ids, index, fact.registry.runtime_call_abi_id);
    return rows;
}
func SelfMirRuntimeValueCallAbiRowsReady(
    ref rows: SelfMirRuntimeValueCallAbiRows,
    instruction_count: Int
) -> Bool {
    return ArrayLength(rows.present) == instruction_count &&
        ArrayLength(rows.owners) == instruction_count &&
        ArrayLength(rows.sources) == instruction_count &&
        ArrayLength(rows.operations) == instruction_count &&
        ArrayLength(rows.c_symbols) == instruction_count &&
        ArrayLength(rows.llvm_symbols) == instruction_count &&
        ArrayLength(rows.c_shapes) == instruction_count &&
        ArrayLength(rows.llvm_shapes) == instruction_count &&
        ArrayLength(rows.runtime_call_abi_ids) == instruction_count;
}

func SelfMirRuntimeValueCallAbiRowValidationError(
    ref rows: SelfMirRuntimeValueCallAbiRows,
    instruction_index: Int
) -> String {
    if rows.present[instruction_index] == 0 {
        if rows.owners[instruction_index] != "" ||
            rows.sources[instruction_index] != "" ||
            rows.operations[instruction_index] != "" ||
            rows.c_symbols[instruction_index] != "" ||
            rows.llvm_symbols[instruction_index] != "" ||
            rows.c_shapes[instruction_index] != "" ||
            rows.llvm_shapes[instruction_index] != "" ||
            rows.runtime_call_abi_ids[instruction_index] != 0 {
            return "runtime-value call ABI payload is present without a row";
        }
        return "";
    }
    if rows.present[instruction_index] != 1 {
        return "runtime-value call ABI presence is invalid";
    }
    let expected: CompilerRuntimeValueCallAbiIdentity =
        CompilerRuntimeValueCallAbiIdentityForId(
            rows.runtime_call_abi_ids[instruction_index]);
    if !expected.valid ||
        rows.owners[instruction_index] != expected.owner_name ||
        rows.sources[instruction_index] != expected.source_name ||
        rows.operations[instruction_index] != expected.native_operation ||
        rows.c_symbols[instruction_index] != expected.c_symbol ||
        rows.llvm_symbols[instruction_index] != expected.llvm_symbol ||
        rows.c_shapes[instruction_index] != expected.c_shape ||
        rows.llvm_shapes[instruction_index] != expected.llvm_shape {
        return "runtime-value call ABI row differs from its canonical owner";
    }
    return "";
}
