// MIR JSON assignment binding modes must match the semantic fact owner.

import "program_routine_index_owner.pgy";
import "structured_expression_emission_order_owner.pgy";
import "routine_instruction_scalar_capture_owner.pgy";
import "../semantic/ast_assignment_type_fact_owner.pgy";

func MirAssignmentBindingModesMatchSemanticFacts(
    ref routines: MirProgramRoutineIndex,
    ref order: MirStructuredExpressionEmissionOrder,
    facts: SemanticAstAssignmentTypeFacts
) -> Bool {
    let semantic_count: Int = ArrayLength(facts.target_binding_modes);
    if !facts.ok || semantic_count != ArrayLength(facts.node_ids) ||
        !MirProgramRoutineIndexStructureReady(routines) ||
        !MirStructuredExpressionEmissionOrderReady(order) {
        return false;
    }
    let assignment_i: Int = 0;
    let order_i: Int = 0;
    let order_count: Int = ArrayLength(order.global_instruction_rows);
    let instruction_count: Int = ArrayLength(routines.instruction_starts);
    while order_i < order_count {
        let global_row: Int = order.global_instruction_rows[order_i];
        if global_row < 0 || global_row >= instruction_count {
            return false;
        }
        let instruction_kind: String =
            routines.instruction_kinds[global_row];
        let source: String = routines.instruction_source_types[global_row];
        let assignment_source: Bool = source == "AST_ASSIGNMENT";
        let scalar: MirRoutineInstructionScalarCapture =
            InvalidMirRoutineInstructionScalarCapture();
        if assignment_source || source == "AST_DEFER_STMT" {
            scalar = MirRoutineInstructionScalarCaptureWithin(
                routines.source_json,
                routines.instruction_starts[global_row],
                routines.instruction_ends[global_row]
            );
        }
        // A defer assignment row (docs/205 F5) has no binding-mode slot; its
        // producer admits only a local target.
        let defer_assignment: Bool = source == "AST_DEFER_STMT" &&
            scalar.valid && scalar.arg0 == "Assign";
        if instruction_kind == "assign" && !assignment_source {
            return false;
        }
        if !assignment_source && !defer_assignment {
            order_i = order_i + 1;
            continue;
        }
        if assignment_source && instruction_kind != "assign" &&
            instruction_kind != "def" {
            return false;
        }
        let value_i: Int = order_i + 1;
        if order.lanes[order_i] != AstExpressionLaneAtom() ||
            order.derived_ordinals[order_i] != 0 || value_i >= order_count ||
            order.global_instruction_rows[value_i] != global_row ||
            order.lanes[value_i] != AstExpressionLaneValue() ||
            order.derived_ordinals[value_i] != 0 ||
            assignment_i >= semantic_count ||
            facts.target_binding_modes[assignment_i] == "" {
            return false;
        }
        if defer_assignment {
            if facts.target_binding_modes[assignment_i] != "local" {
                return false;
            }
        } else if !scalar.valid || scalar.arg1 == "" ||
            scalar.arg1 != facts.target_binding_modes[assignment_i] {
            return false;
        }
        assignment_i = assignment_i + 1;
        order_i = value_i + 1;
    }
    return assignment_i == semantic_count;
}
