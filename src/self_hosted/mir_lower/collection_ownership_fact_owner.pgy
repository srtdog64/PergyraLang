// Fail-closed reader for semantic-owned Array<String> lifetime rows.

import "json_fact_read.pgy";
import "program_routine_index_owner.pgy";
import "program_instruction_expression_index_owner.pgy";
import "expression_graph_sequence_owner.pgy";
import "../hir/ast_expression_graph_owner.pgy";
import "../semantic/ast_type_name_canonical_owner.pgy";

struct MirCollectionOwnershipFacts {
    valid: Bool;
    validation_stage: String;
    function_syntax_ids: Array<Int>;
    binding_syntax_ids: Array<Int>;
    origin_syntax_ids: Array<Int>;
    source_binding_syntax_ids: Array<Int>;
    element_ownerships: Array<String>;
    dispositions: Array<String>;
    origins: Array<String>;
}

func MirCollectionOwnershipLocalRow(
    ref local_binding_syntax_ids: Array<Int>,
    binding_syntax_id: Int
) -> Int {
    let found: Int = -1;
    let row: Int = 0;
    while row < ArrayLength(local_binding_syntax_ids) {
        if local_binding_syntax_ids[row] == binding_syntax_id {
            if found >= 0 { return -2; }
            found = row;
        }
        row = row + 1;
    }
    return found;
}

func MirCollectionOwnershipParameterType(
    json: String,
    routine_start: Int,
    routine_end: Int,
    binding_syntax_id: Int
) -> String {
    let bounds: Array<Int> = [0, 0];
    if binding_syntax_id <= 0 || !MirObjectArrayBoundsAtBounds(
        json, routine_start, routine_end, "params", bounds
    ) { return ""; }
    let cursor: Int = bounds[0] + 1;
    let row_bounds: Array<Int> = [0, 0];
    let matched: Int = 0;
    let found_type: String = "";
    while JsonArrayNextObjectBounds(json, cursor, bounds[1], row_bounds) {
        let source_id: String = MirObjectNumberFactAtBounds(
            json, row_bounds[0], row_bounds[1], "source_syntax_id");
        let type_name: String = MirObjectStringFactAtBounds(
            json, row_bounds[0], row_bounds[1], "type");
        if MirObjectFieldOccurrenceCountAtBounds(
                json, row_bounds[0], row_bounds[1], "source_syntax_id") != 1 ||
            MirObjectFieldOccurrenceCountAtBounds(
                json, row_bounds[0], row_bounds[1], "type") != 1 ||
            source_id == "" || ToString(ToInt(source_id)) != source_id ||
            ToInt(source_id) <= 0 || type_name == "" {
            return "";
        }
        if ToInt(source_id) == binding_syntax_id {
            matched = matched + 1;
            found_type = type_name;
        }
        cursor = row_bounds[1];
    }
    if matched == 1 { return found_type; }
    return "";
}

func MirCollectionOwnershipMemberSourceReady(
    ref routines: MirProgramRoutineIndex,
    routine_start: Int,
    routine_end: Int,
    ref local_types: Array<String>,
    ref local_binding_syntax_ids: Array<Int>,
    source_binding_syntax_id: Int,
    field_syntax_id: Int
) -> Bool {
    let source_type: String = "";
    let source_row: Int = MirCollectionOwnershipLocalRow(
        local_binding_syntax_ids, source_binding_syntax_id);
    if source_row >= 0 {
        source_type = local_types[source_row];
    } else {
        source_type = MirCollectionOwnershipParameterType(
            routines.source_json, routine_start, routine_end,
            source_binding_syntax_id);
    }
    if source_type == "" || field_syntax_id <= 0 { return false; }
    let source_shape: SemanticCanonicalTypeNameFact =
        SemanticCanonicalTypeNameFactFrom(source_type);
    return MirProgramDeclarationFieldIdentitySourceMatchesType(
        routines.declarations.field_identities,
        source_shape.nominal_base_name, ToString(field_syntax_id),
        "Array<String>"
    );
}

func MirCollectionOwnershipEmptyLiteralReceipt(
    ref routines: MirProgramRoutineIndex,
    routine_row: Int,
    binding_syntax_id: Int
) -> Bool {
    if !MirProgramRoutineIndexRowReady(routines, routine_row) ||
        binding_syntax_id <= 0 {
        return false;
    }
    let expected_ref: String = Concat(
        "declaration:", Concat(ToString(binding_syntax_id), ":0")
    );
    let matched: Int = 0;
    let receipt_ok: Bool = false;
    let block_offset: Int = 0;
    let block_start: Int = routines.routine_block_starts[routine_row];
    let block_count: Int = routines.routine_block_counts[routine_row];
    while block_offset < block_count {
        let block: Int = block_start + block_offset;
        let instruction_offset: Int = 0;
        let instruction_start: Int =
            routines.block_instruction_starts[block];
        let instruction_count: Int =
            routines.block_instruction_counts[block];
        while instruction_offset < instruction_count {
            let instruction: Int = instruction_start + instruction_offset;
            let start: Int = routines.instruction_starts[instruction];
            let end: Int = routines.instruction_ends[instruction];
            let local_ref: String = "";
            if MirObjectFieldOccurrenceCountAtBounds(
                    routines.source_json, start, end, "local_ref") == 1 {
                local_ref = MirObjectStringFactAtBounds(
                    routines.source_json, start, end, "local_ref"
                );
            }
            if local_ref == expected_ref &&
                routines.instruction_kinds[instruction] == "def" &&
                routines.instruction_source_types[instruction] ==
                    "AST_LET_DECL" {
                matched = matched + 1;
                let expression: MirProgramInstructionExpressionFact =
                    MirProgramInstructionExpressionIndexAt(
                        routines.instruction_expressions, instruction
                    );
                let graph: JsonObjectFactTable =
                    MirProgramInstructionExpressionGraphTable(
                        routines.source_json, expression, 0
                    );
                let sequence: MirExpressionGraphSequence =
                    MirExpressionGraphSequenceAppend(
                        MirExpressionGraphSequenceEmpty(), graph
                    );
                let root: Int = 0 - 1;
                if ArrayLength(sequence.roots) == 1 {
                    root = sequence.roots[0];
                }
                let exact_empty_graph: Bool = sequence.ok &&
                    sequence.ready_node_count == 1 && root == 0 &&
                    ArrayLength(sequence.arena.topology.node_kinds) == 1 &&
                    sequence.arena.topology.node_kinds[root] ==
                        AstExpressionNodeArrayLiteral();
                if !exact_empty_graph {
                    return false;
                }
                receipt_ok = true;
            }
            instruction_offset = instruction_offset + 1;
        }
        block_offset = block_offset + 1;
    }
    return matched == 1 && receipt_ok;
}

func BuildMirCollectionOwnershipFacts(
    ref routines: MirProgramRoutineIndex,
    routine_row: Int,
    json: String,
    routine_start: Int,
    routine_end: Int,
    routine_syntax_id: String,
    ref local_types: Array<String>,
    ref local_binding_syntax_ids: Array<Int>
) -> MirCollectionOwnershipFacts {
    let function_ids: Array<Int> = [];
    let binding_ids: Array<Int> = [];
    let origin_ids: Array<Int> = [];
    let source_ids: Array<Int> = [];
    let ownerships: Array<String> = [];
    let dispositions: Array<String> = [];
    let origins: Array<String> = [];
    let valid: Bool = StringLength(routine_syntax_id) > 0 &&
        ArrayLength(local_types) == ArrayLength(local_binding_syntax_ids);
    let stage: String = "ok";
    let declared_count: String = MirObjectNumberFactAtBounds(
        json, routine_start, routine_end,
        "collection_ownership_fact_count"
    );
    let bounds: Array<Int> = [0, 0];
    if MirObjectFieldOccurrenceCountAtBounds(
            json, routine_start, routine_end,
            "collection_ownership_fact_count") != 1 ||
        MirObjectFieldOccurrenceCountAtBounds(
            json, routine_start, routine_end,
            "collection_ownership_facts") != 1 ||
        declared_count == "" ||
        ToString(ToInt(declared_count)) != declared_count ||
        ToInt(declared_count) < 0 ||
        !MirObjectArrayBoundsAtBounds(
            json, routine_start, routine_end,
            "collection_ownership_facts", bounds) {
        valid = false;
        stage = "collection_ownership_shape";
    } else {
        let cursor: Int = bounds[0] + 1;
        let row_bounds: Array<Int> = [0, 0];
        while JsonArrayNextObjectBounds(
            json, cursor, bounds[1], row_bounds
        ) {
            let function_id: String = MirObjectNumberFactAtBounds(
                json, row_bounds[0], row_bounds[1], "function_syntax_id");
            let binding_id: String = MirObjectNumberFactAtBounds(
                json, row_bounds[0], row_bounds[1], "binding_syntax_id");
            let origin_id: String = MirObjectNumberFactAtBounds(
                json, row_bounds[0], row_bounds[1], "origin_syntax_id");
            let source_id: String = MirObjectNumberFactAtBounds(
                json, row_bounds[0], row_bounds[1],
                "source_binding_syntax_id");
            let ownership: String = MirObjectStringFactAtBounds(
                json, row_bounds[0], row_bounds[1], "element_ownership");
            let disposition: String = MirObjectStringFactAtBounds(
                json, row_bounds[0], row_bounds[1], "disposition");
            let origin: String = MirObjectStringFactAtBounds(
                json, row_bounds[0], row_bounds[1], "origin");
            let exact_fields: Bool = true;
            let field_names: Array<String> = [
                "function_syntax_id", "binding_syntax_id",
                "origin_syntax_id", "source_binding_syntax_id",
                "element_ownership", "disposition", "origin"
            ];
            let field: Int = 0;
            while field < ArrayLength(field_names) {
                if MirObjectFieldOccurrenceCountAtBounds(
                    json, row_bounds[0], row_bounds[1], field_names[field]
                ) != 1 { exact_fields = false; }
                field = field + 1;
            }
            let numeric: Bool = function_id != "" && binding_id != "" &&
                origin_id != "" && source_id != "" &&
                ToString(ToInt(function_id)) == function_id &&
                ToString(ToInt(binding_id)) == binding_id &&
                ToString(ToInt(origin_id)) == origin_id &&
                ToString(ToInt(source_id)) == source_id;
            let local_row: Int = -1;
            let source_row: Int = -1;
            let source_fact_row: Int = -1;
            if numeric {
                local_row = MirCollectionOwnershipLocalRow(
                    local_binding_syntax_ids, ToInt(binding_id));
                if ToInt(source_id) > 0 {
                    source_row = MirCollectionOwnershipLocalRow(
                        local_binding_syntax_ids, ToInt(source_id));
                    let source_candidate: Int = 0;
                    while source_candidate < ArrayLength(binding_ids) {
                        if binding_ids[source_candidate] == ToInt(source_id) {
                            source_fact_row = source_candidate;
                        }
                        source_candidate = source_candidate + 1;
                    }
                }
            }
            let origin_consistent: Bool =
                (origin == "unknown" &&
                    ownership == "unknown" &&
                    source_id == "0") ||
                (origin == "borrowed-literal" &&
                    ownership == "borrowed-elements" && source_id == "0") ||
                (origin == "map-keys" &&
                    ownership == "map-keys-snapshot" && source_id == "0") ||
                (origin == "empty-literal" &&
                    ownership == "unknown" && source_id == "0" &&
                    numeric &&
                    MirCollectionOwnershipEmptyLiteralReceipt(
                        routines, routine_row, ToInt(binding_id))) ||
                (origin == "member-move" && numeric &&
                    ownership == "unknown" &&
                    ToInt(source_id) > 0 &&
                    ToInt(source_id) != ToInt(binding_id) &&
                    MirCollectionOwnershipMemberSourceReady(
                        routines, routine_start, routine_end,
                        local_types, local_binding_syntax_ids,
                        ToInt(source_id), ToInt(origin_id))) ||
                (origin == "clone" &&
                    ownership == "owned-elements" && source_id == "0") ||
                (origin == "binding" && numeric &&
                    ToInt(source_id) > 0 &&
                    ToInt(source_id) != ToInt(binding_id) &&
                    source_row >= 0 &&
                    local_types[source_row] == "Array<String>" &&
                    source_fact_row >= 0 &&
                    ownerships[source_fact_row] == ownership &&
                    dispositions[source_fact_row] == "live");
            let duplicate: Bool = false;
            let prior: Int = 0;
            while numeric && prior < ArrayLength(binding_ids) {
                if function_ids[prior] == ToInt(function_id) &&
                    binding_ids[prior] == ToInt(binding_id) {
                    duplicate = true;
                }
                prior = prior + 1;
            }
            if !exact_fields || !numeric || function_id != routine_syntax_id ||
                ToInt(binding_id) <= 0 || ToInt(origin_id) <= 0 ||
                ToInt(source_id) < 0 || local_row < 0 ||
                local_types[local_row] != "Array<String>" ||
                (ownership != "unknown" &&
                 ownership != "borrowed-elements" &&
                 ownership != "owned-elements" &&
                 ownership != "map-keys-snapshot") ||
                (disposition != "live" && disposition != "retired") ||
                (disposition == "retired" && origin != "member-move" &&
                 ownership != "owned-elements" &&
                 ownership != "map-keys-snapshot") ||
                (origin == "binding" && disposition != "live") ||
                !origin_consistent || duplicate {
                valid = false;
                stage = "collection_ownership_row";
            } else {
                ArrayPush(function_ids, ToInt(function_id));
                ArrayPush(binding_ids, ToInt(binding_id));
                ArrayPush(origin_ids, ToInt(origin_id));
                ArrayPush(source_ids, ToInt(source_id));
                ArrayPush(ownerships, ownership);
                ArrayPush(dispositions, disposition);
                ArrayPush(origins, origin);
            }
            cursor = row_bounds[1];
        }
    }
    if declared_count == "" ||
        ToInt(declared_count) != ArrayLength(binding_ids) {
        valid = false;
        stage = "collection_ownership_count";
    }
    return MirCollectionOwnershipFacts(
        valid, stage, function_ids, binding_ids, origin_ids, source_ids,
        ownerships, dispositions, origins
    );
}
