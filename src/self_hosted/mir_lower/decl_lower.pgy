// MIR declaration inventory -> AST-tree declaration reconstruction owner.
//
// This module owns the supported declaration fact surface for self-hosted
// mir_lower: structs, nominal class-family declarations, owner-qualified
// methods, and payload-free enums. Unsupported declaration facts fail closed
// here. JSON row/bounds lookup belongs to json_fact_read.pgy.

import "error_owner.pgy";
import "json_fact_read.pgy";
import "program_routine_index_owner.pgy";
import "routine_lower.pgy";

func EmitDeclFields(json: String, decl_start: Int, decl_end: Int, owner_name: String) -> String {
    let out: String = "";
    let field_bounds: Array<Int> = [0, 0];
    let row: Int = 0;
    while MirObjectArrayObjectBoundsAt(json, decl_start, decl_end, "fields", row, field_bounds) {
        let fname: String = MirObjectStringFact(json, field_bounds[0], field_bounds[1], "name");
        if StringLength(fname) == 0 {
            MirLowerFailClosed(Concat("malformed field name fact: ", owner_name));
        }
        let ftype: String = MirObjectStringFact(json, field_bounds[0], field_bounds[1], "type");
        if StringLength(ftype) == 0 {
            MirLowerFailClosed(Concat("field is missing type fact: ", fname));
        }
        out = Concat(out, Concat("      ", Concat(fname, Concat(": ", Concat(ftype, "\n")))));
        row = row + 1;
    }
    return out;
}

func EmitClassMethods(ref routines: MirProgramRoutineIndex, json: String,
                      decl_start: Int, decl_end: Int, owner_name: String) -> String {
    let out: String = "";
    let method_bounds: Array<Int> = [0, 0];
    let row: Int = 0;
    while MirObjectArrayObjectBoundsAt(json, decl_start, decl_end, "methods", row, method_bounds) {
        let mname: String = MirObjectStringFact(json, method_bounds[0], method_bounds[1], "name");
        if StringLength(mname) == 0 {
            MirLowerFailClosed(Concat("class declaration has unnamed method fact: ", owner_name));
        }
        let routine_pos: Option<Int> = MirProgramRoutineIndexFind(routines, owner_name, mname);
        if !IsSome(routine_pos) {
            MirLowerFailClosed(Concat("class method is missing routine fact: ", Concat(owner_name, Concat(".", mname))));
        }
        out = Concat(out, EmitRoutineTree(json, UnwrapOption(routine_pos), "      "));
        row = row + 1;
    }
    if StringLength(out) > 0 {
        return Concat("    Methods:\n", out);
    }
    return "";
}

func EmitAbilityMethodParams(json: String, method_start: Int, method_end: Int, ability_name: String, method_name: String) -> String {
    let params_bounds: Array<Int> = [0, 0];
    if !MirObjectArrayBounds(json, method_start, method_end, "params", params_bounds) {
        MirLowerFailClosed(Concat("ability method is missing params fact: ", Concat(ability_name, Concat(".", method_name))));
    }
    let out: String = "";
    let param_bounds: Array<Int> = [0, 0];
    let row: Int = 0;
    while MirObjectArrayObjectBoundsAt(json, method_start, method_end, "params", row, param_bounds) {
        let pname: String = MirObjectStringFact(json, param_bounds[0], param_bounds[1], "name");
        if StringLength(pname) == 0 {
            MirLowerFailClosed(Concat("ability method has unnamed param fact: ", Concat(ability_name, Concat(".", method_name))));
        }
        let ptype: String = MirObjectStringFact(json, param_bounds[0], param_bounds[1], "type");
        out = Concat(out, Concat("        ", pname));
        if StringLength(ptype) > 0 {
            out = Concat(out, Concat(": ", ptype));
        }
        out = Concat(out, "\n");
        row = row + 1;
    }
    return out;
}

func EmitAbilityMethods(json: String, decl_start: Int, decl_end: Int, ability_name: String) -> String {
    let methods_bounds: Array<Int> = [0, 0];
    if !MirObjectArrayBounds(json, decl_start, decl_end, "methods", methods_bounds) {
        MirLowerFailClosed(Concat("ability declaration is missing methods fact: ", ability_name));
    }
    let out: String = "";
    let method_bounds: Array<Int> = [0, 0];
    let row: Int = 0;
    while MirObjectArrayObjectBoundsAt(json, decl_start, decl_end, "methods", row, method_bounds) {
        let mname: String = MirObjectStringFact(json, method_bounds[0], method_bounds[1], "name");
        if StringLength(mname) == 0 {
            MirLowerFailClosed(Concat("ability declaration has unnamed method fact: ", ability_name));
        }
        let ret: String = MirObjectStringFact(json, method_bounds[0], method_bounds[1], "return");
        if StringLength(ret) == 0 {
            MirLowerFailClosed(Concat("ability method is missing return fact: ", Concat(ability_name, Concat(".", mname))));
        }
        out = Concat(out, Concat("    Function: ", Concat(mname, "\n")));
        out = Concat(out, "      Parameters:\n");
        out = Concat(out, EmitAbilityMethodParams(json, method_bounds[0], method_bounds[1], ability_name, mname));
        out = Concat(out, Concat("      Returns: ", Concat(ret, "\n")));
        row = row + 1;
    }
    return out;
}

func EmitAbilityDecl(json: String, decl_start: Int, decl_end: Int, ability_name: String) -> String {
    let out: String = Concat("  [export] Ability: ", Concat(ability_name, "\n"));
    return Concat(out, EmitAbilityMethods(json, decl_start, decl_end, ability_name));
}

func EmitRoleMethods(ref routines: MirProgramRoutineIndex, json: String,
                     decl_start: Int, decl_end: Int, role_name: String, for_type: String) -> String {
    let out: String = "";
    let methods_bounds: Array<Int> = [0, 0];
    if !MirObjectArrayBounds(json, decl_start, decl_end, "methods", methods_bounds) {
        MirLowerFailClosed(Concat("role declaration is missing methods fact: ", role_name));
    }
    let method_bounds: Array<Int> = [0, 0];
    let row: Int = 0;
    while MirObjectArrayObjectBoundsAt(json, decl_start, decl_end, "methods", row, method_bounds) {
        let mname: String = MirObjectStringFact(json, method_bounds[0], method_bounds[1], "name");
        if StringLength(mname) == 0 {
            MirLowerFailClosed(Concat("role declaration has unnamed method fact: ", role_name));
        }
        let routine_pos: Option<Int> = MirProgramRoutineIndexFind(routines, role_name, mname);
        if !IsSome(routine_pos) {
            MirLowerFailClosed(Concat("role method is missing routine fact: ", Concat(role_name, Concat(".", mname))));
        }
        out = Concat(out, EmitRoutineTreeWithSelfType(json, UnwrapOption(routine_pos), "      ", for_type));
        row = row + 1;
    }
    if StringLength(out) > 0 {
        // Reconstruct the parser-owned role shape.  A generic Methods block
        // is not an AST role owner and causes the method routine's expression
        // graph to disappear on the MIR -> AST round trip.
        return Concat("    Impl ability: (null)\n", out);
    }
    return "";
}

func EmitRoleDecl(ref routines: MirProgramRoutineIndex, json: String,
                  decl_start: Int, decl_end: Int, role_name: String, for_type: String) -> String {
    let out: String = Concat("  Role: ", Concat(role_name, Concat(" for ", Concat(for_type, "\n"))));
    return Concat(out, EmitRoleMethods(routines, json, decl_start, decl_end, role_name, for_type));
}

func EmitEnumDecl(json: String, decl_start: Int, decl_end: Int, enum_name: String) -> String {
    let variants_bounds: Array<Int> = [0, 0];
    if !MirObjectArrayBounds(json, decl_start, decl_end, "variants", variants_bounds) {
        MirLowerFailClosed(Concat("enum declaration is missing variants fact: ", enum_name));
    }
    let out: String = "";
    let variant_bounds: Array<Int> = [0, 0];
    let row: Int = 0;
    while MirObjectArrayObjectBoundsAt(json, decl_start, decl_end, "variants", row, variant_bounds) {
        let vname: String = MirObjectStringFact(json, variant_bounds[0], variant_bounds[1], "name");
        if StringLength(vname) == 0 {
            MirLowerFailClosed(Concat("malformed enum variant name fact: ", enum_name));
        }
        let pc: String = MirObjectNumberFact(json, variant_bounds[0], variant_bounds[1], "param_count");
        if pc != "0" {
            MirLowerFailClosed(Concat("payload enum variants are not supported in self-host subset: ", Concat(enum_name, Concat(".", vname))));
        }
        if StringLength(out) > 0 {
            out = Concat(out, ", ");
        }
        out = Concat(out, vname);
        row = row + 1;
    }
    return Concat("  Enum: ", Concat(enum_name, Concat(" { ", Concat(out, " }\n"))));
}

func NominalAstLabel(nominal_kind: String) -> String {
    if nominal_kind == "subject" {
        return "Subject";
    }
    if nominal_kind == "vessel" {
        return "Vessel";
    }
    if nominal_kind == "object" {
        return "Object";
    }
    if nominal_kind == "tobject" {
        return "TObject";
    }
    if nominal_kind == "zone" {
        return "Zone";
    }
    if nominal_kind == "world" {
        return "World";
    }
    return "Class";
}

func EmitStructDecls(ref routines: MirProgramRoutineIndex, json: String) -> String {
    let chunks: Array<String> = [];
    let decl_bounds: Array<Int> = [0, 0];
    let row: Int = 0;
    while MirDeclObjectBoundsAt(json, row, decl_bounds) {
        let kind: String = MirObjectStringFact(json, decl_bounds[0], decl_bounds[1], "kind");
        if kind == "unsupported" {
            let ast_type: String = MirObjectStringFact(json, decl_bounds[0], decl_bounds[1], "ast_type");
            let nominal_kind: String = MirObjectStringFact(json, decl_bounds[0], decl_bounds[1], "nominal_kind");
            let uname: String = MirObjectStringFact(json, decl_bounds[0], decl_bounds[1], "name");
            let display_kind: String = ast_type;
            if ast_type == "AST_CLASS_DECL" && StringLength(nominal_kind) > 0 {
                display_kind = nominal_kind;
            }
            MirLowerFailClosed(Concat("unsupported MIR declaration in self-host subset: ", Concat(display_kind, Concat(" ", uname))));
        }
        let sname: String = MirObjectStringFact(json, decl_bounds[0], decl_bounds[1], "name");
        if StringLength(sname) == 0 {
            MirLowerFailClosed(Concat(kind, " declaration is missing name fact"));
        }
        if kind == "role" {
            let for_type: String = MirObjectStringFact(json, decl_bounds[0], decl_bounds[1], "for_type");
            if StringLength(for_type) == 0 {
                MirLowerFailClosed(Concat("role declaration is missing for_type fact: ", sname));
            }
            ArrayPush(chunks, EmitRoleDecl(routines, json, decl_bounds[0], decl_bounds[1], sname, for_type));
        }
        if kind == "struct" {
            ArrayPush(chunks, Concat("  Struct: ", Concat(sname, "\n")));
            let fields: String = EmitDeclFields(json, decl_bounds[0], decl_bounds[1], sname);
            if StringLength(fields) > 0 {
                ArrayPush(chunks, "    Fields:\n");
                ArrayPush(chunks, fields);
            }
        } else if kind == "class" || kind == "subject" ||
            kind == "object" || kind == "tobject" ||
            kind == "vessel" || kind == "zone" || kind == "world" {
            let nominal_kind: String = MirObjectStringFact(json, decl_bounds[0], decl_bounds[1], "nominal_kind");
            ArrayPush(chunks, Concat("  ", Concat(NominalAstLabel(nominal_kind), Concat(": ", Concat(sname, "\n")))));
            let cfields: String = EmitDeclFields(json, decl_bounds[0], decl_bounds[1], sname);
            if StringLength(cfields) > 0 {
                ArrayPush(chunks, "    Fields:\n");
                ArrayPush(chunks, cfields);
            }
            ArrayPush(chunks, EmitClassMethods(routines, json, decl_bounds[0], decl_bounds[1], sname));
        } else if kind == "enum" {
            ArrayPush(chunks, EmitEnumDecl(json, decl_bounds[0], decl_bounds[1], sname));
        } else if kind == "ability" {
            ArrayPush(chunks, EmitAbilityDecl(json, decl_bounds[0], decl_bounds[1], sname));
        }
        row = row + 1;
    }
    return StringJoin(chunks, "");
}
