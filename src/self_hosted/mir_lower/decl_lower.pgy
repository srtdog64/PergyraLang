// MIR declaration inventory -> AST-tree declaration reconstruction owner.
//
// This module owns the supported declaration fact surface for self-hosted
// mir_lower: structs, nominal class-family declarations, owner-qualified
// methods, and enum declarations with owner-provided payload type facts.
// here. JSON row/bounds lookup belongs to json_fact_read.pgy.

import "error_owner.pgy";
import "json_fact_read.pgy";
import "program_declaration_index_owner.pgy";
import "program_routine_index_owner.pgy";
import "routine_lower.pgy";

func EmitDeclFields(json: String, decl_start: Int, decl_end: Int, owner_name: String) -> String {
    let out: String = "";
    let fields_bounds: Array<Int> = [0, 0];
    if !MirObjectArrayBoundsAtBounds(json, decl_start, decl_end, "fields", fields_bounds) { return out; }
    let field_bounds: Array<Int> = [0, 0];
    let cursor: Int = fields_bounds[0] + 1;
    while JsonArrayNextObjectBounds(json, cursor, fields_bounds[1], field_bounds) {
        let fname: String = MirObjectStringFactAtBounds(json, field_bounds[0], field_bounds[1], "name");
        if StringLength(fname) == 0 {
            MirLowerFailClosed(Concat("malformed field name fact: ", owner_name));
        }
        let ftype: String = MirObjectStringFactAtBounds(json, field_bounds[0], field_bounds[1], "type");
        if StringLength(ftype) == 0 {
            MirLowerFailClosed(Concat("field is missing type fact: ", fname));
        }
        out = Concat(out, Concat("      ", Concat(fname, Concat(": ", Concat(ftype, "\n")))));
        cursor = field_bounds[1];
    }
    return out;
}

func EmitDeclRoleSlots(
    json: String, decl_start: Int, decl_end: Int, owner_name: String
) -> String {
    let out: String = "";
    let slot_bounds: Array<Int> = [0, 0];
    let row: Int = 0;
    while MirObjectArrayObjectBoundsAt(
        json, decl_start, decl_end, "role_slots", row, slot_bounds
    ) {
        let slot_name: String = MirObjectStringFact(
            json, slot_bounds[0], slot_bounds[1], "name"
        );
        let ability_bounds: Array<Int> = [0, 0];
        if slot_name == "" || !MirObjectArrayObjectBoundsAt(
            json, slot_bounds[0], slot_bounds[1], "abilities", 0,
            ability_bounds
        ) {
            MirLowerFailClosed(Concat(
                "party role slot is missing its ability fact: ", owner_name
            ));
        }
        let ability_name: String = MirObjectStringFact(
            json, ability_bounds[0], ability_bounds[1], "base"
        );
        if ability_name == "" || MirObjectArrayObjectBoundsAt(
            json, slot_bounds[0], slot_bounds[1], "abilities", 1,
            ability_bounds
        ) {
            MirLowerFailClosed(Concat(
                "party role slot requires exactly one ability: ", slot_name
            ));
        }
        out = Concat(out, Concat(
            "    RoleSlot: ", Concat(
                slot_name, Concat(" requires ", Concat(ability_name, "\n"))
            )
        ));
        row = row + 1;
    }
    return out;
}

func EmitDeclGenericParams(
    json: String, decl_start: Int, decl_end: Int, owner_name: String
) -> String {
    let bounds: Array<Int> = [0, 0];
    if !MirObjectArrayBounds(
        json, decl_start, decl_end, "generic_params", bounds
    ) {
        return "";
    }
    let out: String = "    Generic params: <";
    let row: Int = 0;
    while true {
        let row_bounds: Array<Int> = [0, 0];
        if !MirObjectArrayObjectBoundsAt(
            json, decl_start, decl_end, "generic_params", row, row_bounds
        ) {
            break;
        }
        let name: String = MirObjectStringFact(
            json, row_bounds[0], row_bounds[1], "name"
        );
        if name == "" {
            MirLowerFailClosed(
                Concat("generic parameter is missing name fact: ", owner_name)
            );
        }
        if row > 0 { out = Concat(out, ", "); }
        out = Concat(out, name);
        let default_type: String = MirObjectStringFact(
            json, row_bounds[0], row_bounds[1], "default_type"
        );
        if default_type != "" {
            out = Concat(out, Concat(" = ", default_type));
        }
        row = row + 1;
    }
    return Concat(out, ">\n");
}

func EmitDeclGenericConstraints(
    json: String, decl_start: Int, decl_end: Int, owner_name: String
) -> String {
    let bounds: Array<Int> = [0, 0];
    if !MirObjectArrayBounds(
        json, decl_start, decl_end, "generic_params", bounds
    ) {
        return "";
    }
    let out: String = "";
    let row: Int = 0;
    while true {
        let row_bounds: Array<Int> = [0, 0];
        if !MirObjectArrayObjectBoundsAt(
            json, decl_start, decl_end, "generic_params", row, row_bounds
        ) {
            break;
        }
        let constraint: String = MirObjectStringFact(
            json, row_bounds[0], row_bounds[1], "constraint"
        );
        if constraint != "" {
            let name: String = MirObjectStringFact(
                json, row_bounds[0], row_bounds[1], "name"
            );
            if name == "" {
                MirLowerFailClosed(Concat(
                    "generic constraint is missing parameter name fact: ",
                    owner_name
                ));
            }
            if out == "" {
                out = "    Constraints: where ";
            } else {
                out = Concat(out, ", ");
            }
            out = Concat(out, Concat(name, Concat(": ", constraint)));
        }
        row = row + 1;
    }
    if out == "" { return ""; }
    return Concat(out, "\n");
}

func EmitClassMethods(ref routines: MirProgramRoutineIndex, json: String,
                      decl_start: Int, decl_end: Int, owner_name: String) -> String {
    let out: String = "";
    let method_bounds: Array<Int> = [0, 0];
    let row: Int = 0;
    while MirObjectArrayObjectBoundsAt(json, decl_start, decl_end, "methods", row, method_bounds) {
        let mname: String = MirObjectStringFact(json, method_bounds[0], method_bounds[1], "name");
        if StringLength(mname) == 0 {
            MirLowerFailClosed(Concat("class declaration has unnamed method fact: ", owner_name));
        }
        let routine_row: Option<Int> = MirProgramRoutineIndexFindMethodRow(routines, owner_name, mname);
        if !IsSome(routine_row) {
            MirLowerFailClosed(Concat("class method is missing routine fact: ", Concat(owner_name, Concat(".", mname))));
        }
        let routine_index: Int = UnwrapOption(routine_row);
        out = Concat(out, EmitRoutineTreeAtSpan(json,
            routines.starts[routine_index], routines.ends[routine_index], "      ", false));
        row = row + 1;
    }
    if StringLength(out) > 0 {
        return Concat("    Methods:\n", out);
    }
    return "";
}

func EmitAbilityMethodParams(json: String, method_start: Int, method_end: Int, ability_name: String, method_name: String) -> String {
    let params_bounds: Array<Int> = [0, 0];
    if !MirObjectArrayBounds(json, method_start, method_end, "params", params_bounds) {
        MirLowerFailClosed(Concat("ability method is missing params fact: ", Concat(ability_name, Concat(".", method_name))));
    }
    let out: String = "";
    let param_bounds: Array<Int> = [0, 0];
    let row: Int = 0;
    while MirObjectArrayObjectBoundsAt(json, method_start, method_end, "params", row, param_bounds) {
        let pname: String = MirObjectStringFact(json, param_bounds[0], param_bounds[1], "name");
        if StringLength(pname) == 0 {
            MirLowerFailClosed(Concat("ability method has unnamed param fact: ", Concat(ability_name, Concat(".", method_name))));
        }
        let ptype: String = MirObjectStringFact(json, param_bounds[0], param_bounds[1], "type");
        out = Concat(out, Concat("        ", pname));
        if StringLength(ptype) > 0 {
            out = Concat(out, Concat(": ", ptype));
        }
        out = Concat(out, "\n");
        row = row + 1;
    }
    return out;
}

func EmitAbilityMethods(json: String, decl_start: Int, decl_end: Int, ability_name: String) -> String {
    let methods_bounds: Array<Int> = [0, 0];
    if !MirObjectArrayBounds(json, decl_start, decl_end, "methods", methods_bounds) {
        MirLowerFailClosed(Concat("ability declaration is missing methods fact: ", ability_name));
    }
    let out: String = "";
    let method_bounds: Array<Int> = [0, 0];
    let row: Int = 0;
    while MirObjectArrayObjectBoundsAt(json, decl_start, decl_end, "methods", row, method_bounds) {
        let mname: String = MirObjectStringFact(json, method_bounds[0], method_bounds[1], "name");
        if StringLength(mname) == 0 {
            MirLowerFailClosed(Concat("ability declaration has unnamed method fact: ", ability_name));
        }
        let ret: String = MirObjectStringFact(json, method_bounds[0], method_bounds[1], "return");
        if StringLength(ret) == 0 {
            MirLowerFailClosed(Concat("ability method is missing return fact: ", Concat(ability_name, Concat(".", mname))));
        }
        out = Concat(out, Concat("    Function: ", Concat(mname, "\n")));
        out = Concat(out, "      Parameters:\n");
        out = Concat(out, EmitAbilityMethodParams(json, method_bounds[0], method_bounds[1], ability_name, mname));
        out = Concat(out, Concat("      Returns: ", Concat(ret, "\n")));
        row = row + 1;
    }
    return out;
}

func EmitAbilityDecl(json: String, decl_start: Int, decl_end: Int, ability_name: String) -> String {
    let out: String = Concat("  [export] Ability: ", Concat(ability_name, "\n"));
    return Concat(
        out,
        Concat(
            EmitDeclGenericParams(json, decl_start, decl_end, ability_name),
            Concat(
                EmitDeclGenericConstraints(
                    json, decl_start, decl_end, ability_name
                ),
                EmitAbilityMethods(json, decl_start, decl_end, ability_name)
            )
        )
    );
}

func EmitRoleImplBlocks(ref routines: MirProgramRoutineIndex, json: String,
                        decl_start: Int, decl_end: Int, role_name: String,
                        for_type: String) -> String {
    let impls_bounds: Array<Int> = [0, 0];
    let methods_bounds: Array<Int> = [0, 0];
    if !MirObjectArrayBounds(
        json, decl_start, decl_end, "impls", impls_bounds
    ) || !MirObjectArrayBounds(
        json, decl_start, decl_end, "methods", methods_bounds
    ) {
        MirLowerFailClosed(Concat(
            "role declaration is missing impl/method facts: ", role_name
        ));
    }
    let out: String = "";
    let impl_index: Int = 0;
    let impl_bounds: Array<Int> = [0, 0];
    while MirObjectArrayObjectBoundsAt(
        json, decl_start, decl_end, "impls", impl_index, impl_bounds
    ) {
        let ability_bounds: Array<Int> = [0, 0];
        if !MirObjectFieldValueBounds(
            json, impl_bounds[0], impl_bounds[1], "ability", ability_bounds
        ) {
            MirLowerFailClosed(Concat(
                "role impl is missing ability fact: ", role_name
            ));
        }
        let ability_name: String = MirObjectStringFact(
            json, ability_bounds[0], ability_bounds[1], "base"
        );
        let method_start_text: String = MirObjectNumberFact(
            json, impl_bounds[0], impl_bounds[1], "method_start"
        );
        let method_count_text: String = MirObjectNumberFact(
            json, impl_bounds[0], impl_bounds[1], "method_count"
        );
        let method_start: Int = ToInt(method_start_text);
        let method_count: Int = ToInt(method_count_text);
        if ability_name == "" || method_start < 0 || method_count < 0 ||
            ToString(method_start) != method_start_text ||
            ToString(method_count) != method_count_text {
            MirLowerFailClosed(Concat(
                "role impl range fact is invalid: ", role_name
            ));
        }
        out = Concat(out, Concat(
            "    Impl ability: ", Concat(ability_name, "\n")
        ));
        let local_method_index: Int = 0;
        while local_method_index < method_count {
            let method_row: Int = method_start + local_method_index;
            let method_bounds: Array<Int> = [0, 0];
            if !MirObjectArrayObjectBoundsAt(
                json, decl_start, decl_end, "methods", method_row,
                method_bounds
            ) {
                MirLowerFailClosed(Concat(
                    "role impl method range exceeds method facts: ", role_name
                ));
            }
            let method_name: String = MirObjectStringFact(
                json, method_bounds[0], method_bounds[1], "name"
            );
            let routine_row: Option<Int> = MirProgramRoutineIndexFindMethodRow(routines, role_name, method_name);
            if method_name == "" || !IsSome(routine_row) {
                MirLowerFailClosed(Concat(
                    "role impl method is missing routine fact: ",
                    Concat(role_name, Concat(".", method_name))
                ));
            }
            let routine_index: Int = UnwrapOption(routine_row);
            out = Concat(out, EmitRoutineTreeWithSelfTypeAtSpan(json,
                routines.starts[routine_index], routines.ends[routine_index],
                "      ", for_type, false));
            local_method_index = local_method_index + 1;
        }
        impl_index = impl_index + 1;
    }
    return out;
}

func EmitRoleDecl(ref routines: MirProgramRoutineIndex, json: String,
                  decl_start: Int, decl_end: Int, role_name: String, for_type: String) -> String {
    let out: String = Concat("  Role: ", Concat(role_name, Concat(" for ", Concat(for_type, "\n"))));
    return Concat(
        out,
        Concat(
            EmitDeclGenericParams(json, decl_start, decl_end, role_name),
            Concat(
                EmitDeclGenericConstraints(
                    json, decl_start, decl_end, role_name
                ),
                EmitRoleImplBlocks(
                    routines, json, decl_start, decl_end,
                    role_name, for_type
                )
            )
        )
    );
}

func EmitEnumDecl(json: String, decl_start: Int, decl_end: Int, enum_name: String) -> String {
    let variants_bounds: Array<Int> = [0, 0];
    if !MirObjectArrayBounds(json, decl_start, decl_end, "variants", variants_bounds) {
        MirLowerFailClosed(Concat("enum declaration is missing variants fact: ", enum_name));
    }
    let out: String = "";
    let variant_bounds: Array<Int> = [0, 0];
    let row: Int = 0;
    while MirObjectArrayObjectBoundsAt(json, decl_start, decl_end, "variants", row, variant_bounds) {
        let vname: String = MirObjectStringFact(json, variant_bounds[0], variant_bounds[1], "name");
        if StringLength(vname) == 0 {
            MirLowerFailClosed(Concat("malformed enum variant name fact: ", enum_name));
        }
        let pc: String = MirObjectNumberFact(
            json, variant_bounds[0], variant_bounds[1], "param_count"
        );
        let param_count: Int = ToInt(pc);
        if param_count < 0 || ToString(param_count) != pc {
            MirLowerFailClosed(Concat(
                "enum payload count fact is invalid: ",
                Concat(enum_name, Concat(".", vname))
            ));
        }
        let param_types_bounds: Array<Int> = [0, 0];
        if !MirObjectArrayBounds(
            json, variant_bounds[0], variant_bounds[1],
            "param_types", param_types_bounds
        ) || MirObjectArrayStringFactCount(
            json, variant_bounds[0], variant_bounds[1], "param_types"
        ) != param_count {
            MirLowerFailClosed(Concat(
                "enum payload type fact count is invalid: ",
                Concat(enum_name, Concat(".", vname))
            ));
        }
        let payload_types: String = "";
        let payload_index: Int = 0;
        while payload_index < param_count {
            let payload_type: String = MirObjectArrayStringFactAt(
                json, variant_bounds[0], variant_bounds[1],
                "param_types", payload_index
            );
            if payload_type == "" || payload_type == "Unknown" {
                MirLowerFailClosed(Concat(
                    "enum payload type fact is missing: ",
                    Concat(enum_name, Concat(".", vname))
                ));
            }
            if payload_index > 0 {
                payload_types = Concat(payload_types, ", ");
            }
            payload_types = Concat(payload_types, payload_type);
            payload_index = payload_index + 1;
        }
        if StringLength(out) > 0 {
            out = Concat(out, ", ");
        }
        out = Concat(out, vname);
        if param_count > 0 {
            out = Concat(out, Concat("(", Concat(payload_types, ")")));
        }
        row = row + 1;
    }
    return Concat("  Enum: ", Concat(enum_name, Concat(" { ", Concat(out, " }\n"))));
}

func NominalAstLabel(nominal_kind: String) -> String {
    if nominal_kind == "subject" {
        return "Subject";
    }
    if nominal_kind == "vessel" {
        return "Vessel";
    }
    if nominal_kind == "object" {
        return "Object";
    }
    if nominal_kind == "tobject" {
        return "TObject";
    }
    if nominal_kind == "zone" {
        return "Zone";
    }
    if nominal_kind == "world" {
        return "World";
    }
    if nominal_kind == "party" {
        return "Party";
    }
    return "Class";
}

func MirCanonicalDeclarationPhase(kind: String) -> Int {
    if kind == "struct" || kind == "class" || kind == "subject" ||
        kind == "object" || kind == "tobject" || kind == "vessel" ||
        kind == "zone" || kind == "world" || kind == "party" {
        return 0;
    }
    if kind == "role" { return 1; }
    if kind == "ability" { return 2; }
    if kind == "enum" { return 3; }
    return -1;
}

func EmitCanonicalNominalDecl(
    ref routines: MirProgramRoutineIndex,
    json: String,
    decl_start: Int,
    decl_end: Int,
    kind: String,
    name: String
) -> String {
    let chunks: Array<String> = [];
    if kind == "struct" {
        ArrayPush(chunks, Concat("  Struct: ", Concat(name, "\n")));
        let fields: String = EmitDeclFields(
            json, decl_start, decl_end, name
        );
        if StringLength(fields) > 0 {
            ArrayPush(chunks, "    Fields:\n");
            ArrayPush(chunks, fields);
        }
        return StringJoin(chunks, "");
    }
    let nominal_kind: String = MirObjectStringFact(
        json, decl_start, decl_end, "nominal_kind"
    );
    ArrayPush(chunks, Concat(
        "  ", Concat(
            NominalAstLabel(nominal_kind), Concat(": ", Concat(name, "\n"))
        )
    ));
    ArrayPush(chunks, EmitDeclGenericParams(
        json, decl_start, decl_end, name
    ));
    ArrayPush(chunks, EmitDeclGenericConstraints(
        json, decl_start, decl_end, name
    ));
    let fields: String = EmitDeclFields(json, decl_start, decl_end, name);
    if StringLength(fields) > 0 {
        ArrayPush(chunks, "    Fields:\n");
        ArrayPush(chunks, fields);
    }
    if nominal_kind == "party" {
        ArrayPush(chunks, EmitDeclRoleSlots(
            json, decl_start, decl_end, name
        ));
    }
    ArrayPush(chunks, EmitClassMethods(
        routines, json, decl_start, decl_end, name
    ));
    return StringJoin(chunks, "");
}

func EmitCanonicalDeclRow(
    ref routines: MirProgramRoutineIndex,
    json: String,
    decl_start: Int,
    decl_end: Int,
    kind: String,
    name: String
) -> String {
    if MirCanonicalDeclarationPhase(kind) == 0 {
        return EmitCanonicalNominalDecl(
            routines, json, decl_start, decl_end, kind, name
        );
    }
    if kind == "role" {
        let for_type: String = MirObjectStringFact(
            json, decl_start, decl_end, "for_type"
        );
        if StringLength(for_type) == 0 {
            MirLowerFailClosed(Concat(
                "role declaration is missing for_type fact: ", name
            ));
        }
        return EmitRoleDecl(
            routines, json, decl_start, decl_end, name, for_type
        );
    }
    if kind == "ability" {
        return EmitAbilityDecl(json, decl_start, decl_end, name);
    }
    if kind == "enum" {
        return EmitEnumDecl(json, decl_start, decl_end, name);
    }
    MirLowerFailClosed(Concat(
        "unsupported MIR declaration in self-host subset: ",
        Concat(kind, Concat(" ", name))
    ));
    return "";
}

func EmitStructDecls(ref routines: MirProgramRoutineIndex, json: String) -> String {
    let chunks: Array<String> = [];
    let declarations: MirProgramDeclarationIndex =
        BuildMirProgramDeclarationIndex(json);
    if !declarations.valid {
        MirLowerFailClosed("MIR declaration inventory is missing");
    }
    let phase: Int = 0;
    while phase < 4 {
        let row: Int = 0;
        while row < MirProgramDeclarationIndexCount(declarations) {
            let decl_start: Int = declarations.starts[row];
            let decl_end: Int = declarations.ends[row];
            let kind: String = declarations.kinds[row];
            if kind == "unsupported" {
                let ast_type: String = MirObjectStringFact(
                    json, decl_start, decl_end, "ast_type"
                );
                let nominal_kind: String = MirObjectStringFact(
                    json, decl_start, decl_end, "nominal_kind"
                );
                let name: String = declarations.names[row];
                let display_kind: String = ast_type;
                if ast_type == "AST_CLASS_DECL" && nominal_kind != "" {
                    display_kind = nominal_kind;
                }
                MirLowerFailClosed(Concat(
                    "unsupported MIR declaration in self-host subset: ",
                    Concat(display_kind, Concat(" ", name))
                ));
            }
            let canonical_phase: Int = MirCanonicalDeclarationPhase(kind);
            if canonical_phase < 0 {
                MirLowerFailClosed(Concat(
                    "unsupported MIR declaration in self-host subset: ", kind
                ));
            }
            if canonical_phase == phase {
                let name: String = declarations.names[row];
                if StringLength(name) == 0 {
                    MirLowerFailClosed(Concat(
                        kind, " declaration is missing name fact"
                    ));
                }
                ArrayPush(chunks, EmitCanonicalDeclRow(
                    routines, json, decl_start, decl_end,
                    kind, name
                ));
            }
            row = row + 1;
        }
        phase = phase + 1;
    }
    return StringJoin(chunks, "");
}
