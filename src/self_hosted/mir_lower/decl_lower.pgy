// MIR declaration inventory -> AST-tree declaration reconstruction owner.
//
// This module owns the supported declaration fact surface for self-hosted
// mir_lower: structs, nominal class-family declarations, owner-qualified
// methods, and enum declarations with owner-provided payload type facts.
// here. JSON row/bounds lookup belongs to json_fact_read.pgy.

import "error_owner.pgy";
import "json_fact_read.pgy";
import "program_declaration_index_owner.pgy";
import "program_routine_index_owner.pgy";
import "structured_expression_emission_order_owner.pgy";
import "declaration_callable_lower_owner.pgy";
import "declaration_zone_authority_projection_owner.pgy";
import "../lib/nominal_field_kind_owner.pgy";

func EmitDeclFields(
    json: String,
    decl_start: Int,
    decl_end: Int,
    owner_name: String,
    nominal_kind: String,
    inout storage_rows: Array<String>,
    inout slot_rows: Array<String>,
    inout subject_slot_names: Array<String>
) -> Int {
    let subject_slot_count: Int = 0;
    let fields_bounds: Array<Int> = [0, 0];
    if !MirObjectArrayBoundsAtBounds(
        json, decl_start, decl_end, "fields", fields_bounds
    ) {
        return 0;
    }
    let field_bounds: Array<Int> = [0, 0];
    let cursor: Int = fields_bounds[0] + 1;
    while JsonArrayNextObjectBounds(json, cursor, fields_bounds[1], field_bounds) {
        let fname: String = MirObjectStringFactAtBounds(json, field_bounds[0], field_bounds[1], "name");
        if StringLength(fname) == 0 {
            MirLowerFailClosed(Concat("malformed field name fact: ", owner_name));
        }
        let ftype: String = MirObjectStringFactAtBounds(json, field_bounds[0], field_bounds[1], "type");
        if StringLength(ftype) == 0 {
            MirLowerFailClosed(Concat("field is missing type fact: ", fname));
        }
        let field_kind: String = MirObjectStringFactAtBounds(
            json, field_bounds[0], field_bounds[1], "field_kind"
        );
        if !NominalFieldKindAllowedForDeclaration(nominal_kind, field_kind) {
            MirLowerFailClosed(Concat(
                "field kind is invalid for nominal declaration: ",
                Concat(owner_name, Concat(".", fname))
            ));
        }
        if field_kind == NominalFieldKindField() {
            ArrayPush(storage_rows, Concat(
                "      ", Concat(fname, Concat(": ", Concat(ftype, "\n")))
            ));
        } else {
            if field_kind == NominalFieldKindSubjectSlot() {
                subject_slot_count = subject_slot_count + 1;
                ArrayPush(subject_slot_names, fname);
            }
            if field_kind == NominalFieldKindEffectPool() ||
                field_kind == NominalFieldKindRelationPool() {
                MirLowerFailClosed(Concat(
                    "pool field is missing capacity fact: ",
                    Concat(owner_name, Concat(".", fname))
                ));
            }
            let label: String = NominalFieldKindAstLabel(field_kind);
            if label == "" {
                MirLowerFailClosed(Concat(
                    "field kind has no canonical AST projection: ", field_kind
                ));
            }
            ArrayPush(slot_rows, Concat(
                "    ", Concat(label, Concat(
                    ": ", Concat(fname, Concat(": ", Concat(ftype, "\n")))
                ))
            ));
        }
        cursor = field_bounds[1];
    }
    return subject_slot_count;
}
func EmitDeclRoleSlots(
    json: String, decl_start: Int, decl_end: Int, owner_name: String
) -> String {
    let out: String = "";
    let slots_bounds: Array<Int> = [0, 0];
    if !MirObjectArrayBoundsAtBounds(
        json, decl_start, decl_end, "role_slots", slots_bounds
    ) { return out; }
    let slot_bounds: Array<Int> = [0, 0];
    let cursor: Int = slots_bounds[0] + 1;
    while JsonArrayNextObjectBounds(
        json, cursor, slots_bounds[1], slot_bounds
    ) {
        let slot_name: String = MirObjectStringFactAtBounds(
            json, slot_bounds[0], slot_bounds[1], "name"
        );
        let abilities_bounds: Array<Int> = [0, 0];
        let ability_bounds: Array<Int> = [0, 0];
        if slot_name == "" || !MirObjectArrayBoundsAtBounds(
            json, slot_bounds[0], slot_bounds[1], "abilities",
            abilities_bounds
        ) || !JsonArrayNextObjectBounds(
            json, abilities_bounds[0] + 1, abilities_bounds[1], ability_bounds
        ) {
            MirLowerFailClosed(Concat(
                "party role slot is missing its ability fact: ", owner_name
            ));
        }
        let ability_name: String = MirObjectStringFactAtBounds(
            json, ability_bounds[0], ability_bounds[1], "base"
        );
        if ability_name == "" || JsonArrayNextObjectBounds(
            json, ability_bounds[1], abilities_bounds[1], ability_bounds
        ) {
            MirLowerFailClosed(Concat(
                "party role slot requires exactly one ability: ", slot_name
            ));
        }
        out = Concat(out, Concat(
            "    RoleSlot: ", Concat(
                slot_name, Concat(" requires ", Concat(ability_name, "\n"))
            )
        ));
        cursor = slot_bounds[1];
    }
    return out;
}
func EmitDeclGenericParams(
    json: String, decl_start: Int, decl_end: Int, owner_name: String
) -> String {
    let bounds: Array<Int> = [0, 0];
    if !MirObjectArrayBoundsAtBounds(
        json, decl_start, decl_end, "generic_params", bounds
    ) {
        return "";
    }
    let out: String = "    Generic params: <";
    let row: Int = 0;
    let row_bounds: Array<Int> = [0, 0];
    let cursor: Int = bounds[0] + 1;
    while JsonArrayNextObjectBounds(json, cursor, bounds[1], row_bounds) {
        let name: String = MirObjectStringFactAtBounds(
            json, row_bounds[0], row_bounds[1], "name"
        );
        if name == "" {
            MirLowerFailClosed(
                Concat("generic parameter is missing name fact: ", owner_name)
            );
        }
        if row > 0 { out = Concat(out, ", "); }
        out = Concat(out, name);
        let default_type: String = MirObjectStringFactAtBounds(
            json, row_bounds[0], row_bounds[1], "default_type"
        );
        if default_type != "" {
            out = Concat(out, Concat(" = ", default_type));
        }
        row = row + 1;
        cursor = row_bounds[1];
    }
    return Concat(out, ">\n");
}
func EmitDeclGenericConstraints(
    json: String, decl_start: Int, decl_end: Int, owner_name: String
) -> String {
    let bounds: Array<Int> = [0, 0];
    if !MirObjectArrayBoundsAtBounds(
        json, decl_start, decl_end, "generic_params", bounds
    ) {
        return "";
    }
    let out: String = "";
    let row_bounds: Array<Int> = [0, 0];
    let cursor: Int = bounds[0] + 1;
    while JsonArrayNextObjectBounds(json, cursor, bounds[1], row_bounds) {
        let constraint: String = MirObjectStringFactAtBounds(
            json, row_bounds[0], row_bounds[1], "constraint"
        );
        if constraint != "" {
            let name: String = MirObjectStringFactAtBounds(
                json, row_bounds[0], row_bounds[1], "name"
            );
            if name == "" {
                MirLowerFailClosed(Concat(
                    "generic constraint is missing parameter name fact: ",
                    owner_name
                ));
            }
            if out == "" {
                out = "    Constraints: where ";
            } else {
                out = Concat(out, ", ");
            }
            out = Concat(out, Concat(name, Concat(": ", constraint)));
        }
        cursor = row_bounds[1];
    }
    if out == "" { return ""; }
    return Concat(out, "\n");
}
func EmitAbilityDecl(json: String, decl_start: Int, decl_end: Int, ability_name: String) -> String {
    let out: String = Concat("  [export] Ability: ", Concat(ability_name, "\n"));
    return Concat(
        out,
        Concat(
            EmitDeclGenericParams(json, decl_start, decl_end, ability_name),
            Concat(
                EmitDeclGenericConstraints(
                    json, decl_start, decl_end, ability_name
                ),
                EmitAbilityMethods(json, decl_start, decl_end, ability_name)
            )
        )
    );
}

func EmitRoleDecl(ref routines: MirProgramRoutineIndex, decl_start: Int,
    decl_end: Int, role_name: String, for_type: String,
    inout expression_order: MirStructuredExpressionEmissionOrder,
    inout abi_validation: MirAbiLayoutValidationSession) -> String {
    let json: String = routines.source_json;
    let out: String = Concat("  Role: ", Concat(role_name, Concat(" for ", Concat(for_type, "\n"))));
    return Concat(
        out,
        Concat(
            EmitDeclGenericParams(json, decl_start, decl_end, role_name),
            Concat(
                EmitDeclGenericConstraints(
                    json, decl_start, decl_end, role_name
                ),
                EmitRoleImplBlocks(routines, decl_start, decl_end,
                    role_name, for_type, expression_order, abi_validation)
            )
        )
    );
}

func EmitEnumDecl(json: String, decl_start: Int, decl_end: Int, enum_name: String) -> String {
    let variants_bounds: Array<Int> = [0, 0];
    if !MirObjectArrayBoundsAtBounds(
        json, decl_start, decl_end, "variants", variants_bounds
    ) {
        MirLowerFailClosed(Concat("enum declaration is missing variants fact: ", enum_name));
    }
    let out: String = "";
    let variant_bounds: Array<Int> = [0, 0];
    let cursor: Int = variants_bounds[0] + 1;
    while JsonArrayNextObjectBounds(
        json, cursor, variants_bounds[1], variant_bounds
    ) {
        let vname: String = MirObjectStringFactAtBounds(
            json, variant_bounds[0], variant_bounds[1], "name"
        );
        if StringLength(vname) == 0 {
            MirLowerFailClosed(Concat("malformed enum variant name fact: ", enum_name));
        }
        let pc: String = MirObjectNumberFactAtBounds(
            json, variant_bounds[0], variant_bounds[1], "param_count"
        );
        let param_count: Int = ToInt(pc);
        if param_count < 0 || ToString(param_count) != pc {
            MirLowerFailClosed(Concat(
                "enum payload count fact is invalid: ",
                Concat(enum_name, Concat(".", vname))
            ));
        }
        let param_types: Array<String> = MirObjectArrayStringFactsAtBounds(
            json, variant_bounds[0], variant_bounds[1], "param_types"
        );
        if ArrayLength(param_types) != param_count {
            MirLowerFailClosed(Concat(
                "enum payload type fact count is invalid: ",
                Concat(enum_name, Concat(".", vname))
            ));
        }
        let payload_types: String = "";
        let payload_index: Int = 0;
        while payload_index < param_count {
            let payload_type: String = param_types[payload_index];
            if payload_type == "" || payload_type == "Unknown" {
                MirLowerFailClosed(Concat(
                    "enum payload type fact is missing: ",
                    Concat(enum_name, Concat(".", vname))
                ));
            }
            if payload_index > 0 {
                payload_types = Concat(payload_types, ", ");
            }
            payload_types = Concat(payload_types, payload_type);
            payload_index = payload_index + 1;
        }
        if StringLength(out) > 0 {
            out = Concat(out, ", ");
        }
        out = Concat(out, vname);
        if param_count > 0 {
            out = Concat(out, Concat("(", Concat(payload_types, ")")));
        }
        cursor = variant_bounds[1];
    }
    return Concat("  Enum: ", Concat(enum_name, Concat(" { ", Concat(out, " }\n"))));
}

func NominalAstLabel(nominal_kind: String) -> String {
    if nominal_kind == "subject" {
        return "Subject";
    }
    if nominal_kind == "vessel" {
        return "Vessel";
    }
    if nominal_kind == "object" {
        return "Object";
    }
    if nominal_kind == "tobject" {
        return "TObject";
    }
    if nominal_kind == "zone" {
        return "Zone";
    }
    if nominal_kind == "world" {
        return "World";
    }
    if nominal_kind == "party" {
        return "Party";
    }
    if nominal_kind == "effect" {
        return "Effect";
    }
    if nominal_kind == "relation" {
        return "Relation";
    }
    return "Class";
}

func MirCanonicalDeclarationPhase(kind: String) -> Int {
    if kind == "struct" || kind == "class" || kind == "subject" ||
        kind == "object" || kind == "tobject" || kind == "vessel" ||
        kind == "zone" || kind == "world" || kind == "party" ||
        kind == "effect" || kind == "relation" {
        return 0;
    }
    if kind == "role" { return 1; }
    if kind == "ability" { return 2; }
    if kind == "enum" { return 3; }
    if kind == "extern" { return 4; }
    return -1;
}

func EmitCanonicalNominalDecl(
    ref declarations: MirProgramDeclarationIndex,
    ref routines: MirProgramRoutineIndex,
    decl_start: Int, decl_end: Int, kind: String, name: String,
    observe_pressure: Bool,
    inout expression_order: MirStructuredExpressionEmissionOrder,
    inout abi_validation: MirAbiLayoutValidationSession
) -> String {
    let json: String = routines.source_json;
    let chunks: Array<String> = [];
    if kind == "struct" {
        ArrayPush(chunks, Concat("  Struct: ", Concat(name, "\n")));
        let storage_rows: Array<String> = [];
        let slot_rows: Array<String> = [];
        let subject_slot_names: Array<String> = [];
        let subject_slot_count: Int = EmitDeclFields(
            json, decl_start, decl_end, name, "struct",
            storage_rows, slot_rows, subject_slot_names
        );
        if observe_pressure {
            Log(Concat(
                "[driver-pressure-stage] consumer:mir-to-ast:declaration-step:fields:",
                name
            ));
        }
        if ArrayLength(slot_rows) > 0 || subject_slot_count != 0 {
            MirLowerFailClosed(Concat(
                "struct declaration contains a domain slot: ", name
            ));
        }
        if ArrayLength(storage_rows) > 0 {
            ArrayPush(chunks, "    Fields:\n");
            ArrayPush(chunks, StringJoin(storage_rows, ""));
        }
        return StringJoin(chunks, "");
    }
    let nominal_kind: String = MirObjectStringFactAtBounds(
        json, decl_start, decl_end, "nominal_kind"
    );
    let direct_kind: Bool = kind == "struct" || kind == "subject" ||
        kind == "object" || kind == "tobject" || kind == "vessel" ||
        kind == "zone" || kind == "world" || kind == "party" ||
        kind == "effect" || kind == "relation";
    if (direct_kind && nominal_kind != kind) ||
        (kind == "class" && nominal_kind == "effect") {
        MirLowerFailClosed(Concat(
            "nominal declaration identity drifted: ", name
        ));
    }
    ArrayPush(chunks, Concat(
        "  ", Concat(
            NominalAstLabel(nominal_kind), Concat(": ", Concat(name, "\n"))
        )
    ));
    ArrayPush(chunks, EmitDeclGenericParams(
        json, decl_start, decl_end, name
    ));
    if observe_pressure {
        Log(Concat(
            "[driver-pressure-stage] consumer:mir-to-ast:declaration-step:generic-params:",
            name
        ));
    }
    ArrayPush(chunks, EmitDeclGenericConstraints(
        json, decl_start, decl_end, name
    ));
    if observe_pressure {
        Log(Concat(
            "[driver-pressure-stage] consumer:mir-to-ast:declaration-step:generic-constraints:",
            name
        ));
    }
    let storage_rows: Array<String> = [];
    let slot_rows: Array<String> = [];
    let subject_slot_names: Array<String> = [];
    let subject_slot_count: Int = EmitDeclFields(
        json, decl_start, decl_end, name, nominal_kind,
        storage_rows, slot_rows, subject_slot_names
    );
    if observe_pressure {
        Log(Concat(
            "[driver-pressure-stage] consumer:mir-to-ast:declaration-step:fields:",
            name
        ));
    }
    if (nominal_kind == "effect" && subject_slot_count != 1) ||
        (nominal_kind == "relation" && subject_slot_count != 2) {
        MirLowerFailClosed(Concat(
            "nominal declaration participant shape is invalid: ", name
        ));
    }
    if ArrayLength(storage_rows) > 0 {
        ArrayPush(chunks, "    Fields:\n");
        ArrayPush(chunks, StringJoin(storage_rows, ""));
    }
    if ArrayLength(slot_rows) > 0 {
        ArrayPush(chunks, StringJoin(slot_rows, ""));
    }
    ArrayPush(chunks, EmitDeclZoneAuthorities(
        json, decl_start, decl_end, name, nominal_kind, subject_slot_names
    ));
    if nominal_kind == "party" {
        ArrayPush(chunks, EmitDeclRoleSlots(
            json, decl_start, decl_end, name
        ));
    }
    if observe_pressure {
        Log(Concat(
            "[driver-pressure-stage] consumer:mir-to-ast:declaration-step:methods-start:",
            name
        ));
    }
    ArrayPush(chunks, EmitClassMethods(
        declarations, routines, decl_start, decl_end, name, nominal_kind,
        observe_pressure, expression_order, abi_validation
    ));
    if observe_pressure {
        Log(Concat(
            "[driver-pressure-stage] consumer:mir-to-ast:declaration-step:methods-done:",
            name
        ));
    }
    return StringJoin(chunks, "");
}

func EmitCanonicalDeclRow(
    ref declarations: MirProgramDeclarationIndex,
    ref routines: MirProgramRoutineIndex,
    decl_start: Int, decl_end: Int, kind: String, name: String,
    observe_pressure: Bool,
    inout expression_order: MirStructuredExpressionEmissionOrder,
    inout abi_validation: MirAbiLayoutValidationSession
) -> String {
    let json: String = routines.source_json;
    if MirCanonicalDeclarationPhase(kind) == 0 {
        return EmitCanonicalNominalDecl(
            declarations, routines, decl_start, decl_end, kind, name,
            observe_pressure, expression_order, abi_validation
        );
    }
    if kind == "role" {
        let for_type: String = MirObjectStringFactAtBounds(
            json, decl_start, decl_end, "for_type"
        );
        if StringLength(for_type) == 0 {
            MirLowerFailClosed(Concat(
                "role declaration is missing for_type fact: ", name
            ));
        }
        return EmitRoleDecl(routines, decl_start, decl_end, name, for_type,
            expression_order, abi_validation);
    }
    if kind == "ability" {
        return EmitAbilityDecl(json, decl_start, decl_end, name);
    }
    if kind == "enum" {
        return EmitEnumDecl(json, decl_start, decl_end, name);
    }
    if kind == "extern" {
        return EmitExternBlockDecl(json, decl_start, decl_end, name);
    }
    MirLowerFailClosed(Concat(
        "unsupported MIR declaration in self-host subset: ",
        Concat(kind, Concat(" ", name))
    ));
    return "";
}

func EmitStructDecls(
    ref routines: MirProgramRoutineIndex,
    observe_pressure: Bool,
    inout expression_order: MirStructuredExpressionEmissionOrder,
    inout abi_validation: MirAbiLayoutValidationSession
) -> String {
    let json: String = routines.source_json;
    let chunks: Array<String> = [];
    if !routines.declarations.valid {
        MirLowerFailClosed("MIR declaration inventory is missing");
    }
    let phase: Int = 0;
    while phase < 5 {
        let row: Int = 0;
        while row < MirProgramDeclarationIndexCount(routines.declarations) {
            let decl_start: Int = routines.declarations.starts[row];
            let decl_end: Int = routines.declarations.ends[row];
            let kind: String = routines.declarations.kinds[row];
            if kind == "unsupported" {
                let ast_type: String = MirObjectStringFactAtBounds(
                    json, decl_start, decl_end, "ast_type"
                );
                let nominal_kind: String = MirObjectStringFactAtBounds(
                    json, decl_start, decl_end, "nominal_kind"
                );
                let name: String = routines.declarations.names[row];
                let display_kind: String = ast_type;
                if ast_type == "AST_CLASS_DECL" && nominal_kind != "" {
                    display_kind = nominal_kind;
                }
                MirLowerFailClosed(Concat(
                    "unsupported MIR declaration in self-host subset: ",
                    Concat(display_kind, Concat(" ", name))
                ));
            }
            let canonical_phase: Int = MirCanonicalDeclarationPhase(kind);
            if canonical_phase < 0 {
                MirLowerFailClosed(Concat(
                    "unsupported MIR declaration in self-host subset: ", kind
                ));
            }
            if canonical_phase == phase {
                let name: String = routines.declarations.names[row];
                if StringLength(name) == 0 {
                    MirLowerFailClosed(Concat(
                        kind, " declaration is missing name fact"
                    ));
                }
                if observe_pressure {
                    Log(Concat(
                        "[driver-pressure-stage] consumer:mir-to-ast:declaration:start:",
                        Concat(ToString(row), Concat(":", Concat(kind, Concat(":", name))))
                    ));
                }
                let decl_text: String = EmitCanonicalDeclRow(
                    routines.declarations, routines, decl_start, decl_end,
                    kind, name, observe_pressure,
                    expression_order, abi_validation
                );
                ArrayPush(chunks, decl_text);
                if observe_pressure {
                    Log(Concat(
                        "[driver-pressure-stage] consumer:mir-to-ast:declaration:done:",
                        Concat(ToString(row), Concat(":", Concat(kind, Concat(":", name))))
                    ));
                }
            }
            row = row + 1;
        }
        phase = phase + 1;
    }
    return StringJoin(chunks, "");
}
