// Callable-bearing declaration reconstruction owner.
//
// Nominal, ability, and role declaration shells stay in decl_lower.pgy. This
// owner binds each method row to its one contract fact and, for runtime
// methods, to its routine row.

import "error_owner.pgy";
import "json_fact_read.pgy";
import "program_declaration_index_owner.pgy";
import "program_routine_index_owner.pgy";
import "structured_expression_emission_order_owner.pgy";
import "declaration_method_contract_fact_owner.pgy";
import "routine_lower.pgy";

func EmitClassMethods(
    ref declarations: MirProgramDeclarationIndex,
    ref routines: MirProgramRoutineIndex, decl_start: Int,
    decl_end: Int, owner_name: String, nominal_kind: String,
    inout expression_order: MirStructuredExpressionEmissionOrder,
    inout abi_validation: MirAbiLayoutValidationSession) -> String {
    let json: String = routines.source_json;
    let out: String = "";
    let method_bounds: Array<Int> = [0, 0];
    let row: Int = 0;
    while MirObjectArrayObjectBoundsAt(
        json, decl_start, decl_end, "methods", row, method_bounds
    ) {
        let mname: String = MirObjectStringFact(
            json, method_bounds[0], method_bounds[1], "name"
        );
        if StringLength(mname) == 0 {
            MirLowerFailClosed(Concat(
                "class declaration has unnamed method fact: ", owner_name
            ));
        }
        let contract: MirDeclarationMethodContractFact =
            MirDeclarationMethodContractFactFromBounds(
                json, method_bounds[0], method_bounds[1]
            );
        if !contract.valid {
            MirLowerFailClosed(Concat(
                "class method contract is invalid: ",
                Concat(owner_name, Concat(".", Concat(
                    mname, Concat(" [", Concat(contract.diagnostic, "]"))
                )))
            ));
        }
        if contract.callable_kind == "action" && nominal_kind != "subject" {
            MirLowerFailClosed(Concat(
                "action method requires a subject owner: ",
                Concat(owner_name, Concat(".", mname))
            ));
        }
        if StringLength(contract.within_zone) > 0 &&
            !MirProgramDeclarationIndexContains(
                declarations, "zone", contract.within_zone
            ) {
            MirLowerFailClosed(Concat(
                "action contract references an unknown zone: ",
                contract.within_zone
            ));
        }
        let routine_row: Option<Int> = MirProgramRoutineIndexFindMethodRow(
            routines, owner_name, mname
        );
        if !IsSome(routine_row) {
            MirLowerFailClosed(Concat(
                "class method is missing routine fact: ",
                Concat(owner_name, Concat(".", mname))
            ));
        }
        let contract_rows: String = MirDeclarationMethodContractRows(
            contract, "        "
        );
        out = Concat(out, EmitRoutineTreeWithContractAtRowWithExpressionOrder(
            routines, UnwrapOption(routine_row), "      ", "",
            contract.callable_kind, contract_rows, false, false,
            expression_order, abi_validation
        ));
        row = row + 1;
    }
    if StringLength(out) > 0 { return Concat("    Methods:\n", out); }
    return "";
}

func EmitAbilityMethodParams(
    json: String, method_start: Int, method_end: Int,
    ability_name: String, method_name: String
) -> String {
    let params_bounds: Array<Int> = [0, 0];
    if !MirObjectArrayBounds(
        json, method_start, method_end, "params", params_bounds
    ) {
        MirLowerFailClosed(Concat(
            "ability method is missing params fact: ",
            Concat(ability_name, Concat(".", method_name))
        ));
    }
    let out: String = "";
    let param_bounds: Array<Int> = [0, 0];
    let row: Int = 0;
    while MirObjectArrayObjectBoundsAt(
        json, method_start, method_end, "params", row, param_bounds
    ) {
        let pname: String = MirObjectStringFact(
            json, param_bounds[0], param_bounds[1], "name"
        );
        if StringLength(pname) == 0 {
            MirLowerFailClosed(Concat(
                "ability method has unnamed param fact: ",
                Concat(ability_name, Concat(".", method_name))
            ));
        }
        let ptype: String = MirObjectStringFact(
            json, param_bounds[0], param_bounds[1], "type"
        );
        out = Concat(out, Concat("        ", pname));
        if StringLength(ptype) > 0 { out = Concat(out, Concat(": ", ptype)); }
        out = Concat(out, "\n");
        row = row + 1;
    }
    return out;
}

func EmitAbilityMethods(
    json: String, decl_start: Int, decl_end: Int, ability_name: String
) -> String {
    let methods_bounds: Array<Int> = [0, 0];
    if !MirObjectArrayBounds(
        json, decl_start, decl_end, "methods", methods_bounds
    ) {
        MirLowerFailClosed(Concat(
            "ability declaration is missing methods fact: ", ability_name
        ));
    }
    let out: String = "";
    let method_bounds: Array<Int> = [0, 0];
    let row: Int = 0;
    while MirObjectArrayObjectBoundsAt(
        json, decl_start, decl_end, "methods", row, method_bounds
    ) {
        let mname: String = MirObjectStringFact(
            json, method_bounds[0], method_bounds[1], "name"
        );
        if StringLength(mname) == 0 {
            MirLowerFailClosed(Concat(
                "ability declaration has unnamed method fact: ", ability_name
            ));
        }
        let contract: MirDeclarationMethodContractFact =
            MirDeclarationMethodContractFactFromBounds(
                json, method_bounds[0], method_bounds[1]
            );
        if !contract.valid || contract.callable_kind != "function" {
            MirLowerFailClosed(Concat(
                "ability method contract is invalid: ",
                Concat(ability_name, Concat(".", mname))
            ));
        }
        let ret: String = MirObjectStringFact(
            json, method_bounds[0], method_bounds[1], "return"
        );
        if StringLength(ret) == 0 {
            MirLowerFailClosed(Concat(
                "ability method is missing return fact: ",
                Concat(ability_name, Concat(".", mname))
            ));
        }
        out = Concat(out, Concat("    Function: ", Concat(mname, "\n")));
        out = Concat(out, "      Parameters:\n");
        out = Concat(out, EmitAbilityMethodParams(
            json, method_bounds[0], method_bounds[1], ability_name, mname
        ));
        out = Concat(out, Concat("      Returns: ", Concat(ret, "\n")));
        out = Concat(out, MirDeclarationMethodContractRows(
            contract, "      "
        ));
        row = row + 1;
    }
    return out;
}

func EmitRoleImplBlocks(ref routines: MirProgramRoutineIndex, decl_start: Int,
    decl_end: Int, role_name: String, for_type: String,
    inout expression_order: MirStructuredExpressionEmissionOrder,
    inout abi_validation: MirAbiLayoutValidationSession) -> String {
    let json: String = routines.source_json;
    let impls_bounds: Array<Int> = [0, 0];
    let methods_bounds: Array<Int> = [0, 0];
    if !MirObjectArrayBounds(
        json, decl_start, decl_end, "impls", impls_bounds
    ) || !MirObjectArrayBounds(
        json, decl_start, decl_end, "methods", methods_bounds
    ) {
        MirLowerFailClosed(Concat(
            "role declaration is missing impl/method facts: ", role_name
        ));
    }
    let out: String = "";
    let impl_index: Int = 0;
    let impl_bounds: Array<Int> = [0, 0];
    while MirObjectArrayObjectBoundsAt(
        json, decl_start, decl_end, "impls", impl_index, impl_bounds
    ) {
        let ability_bounds: Array<Int> = [0, 0];
        if !MirObjectFieldValueBounds(
            json, impl_bounds[0], impl_bounds[1], "ability", ability_bounds
        ) {
            MirLowerFailClosed(Concat(
                "role impl is missing ability fact: ", role_name
            ));
        }
        let ability_name: String = MirObjectStringFact(
            json, ability_bounds[0], ability_bounds[1], "base"
        );
        let method_start_text: String = MirObjectNumberFact(
            json, impl_bounds[0], impl_bounds[1], "method_start"
        );
        let method_count_text: String = MirObjectNumberFact(
            json, impl_bounds[0], impl_bounds[1], "method_count"
        );
        let method_start: Int = ToInt(method_start_text);
        let method_count: Int = ToInt(method_count_text);
        if ability_name == "" || method_start < 0 || method_count < 0 ||
            ToString(method_start) != method_start_text ||
            ToString(method_count) != method_count_text {
            MirLowerFailClosed(Concat(
                "role impl range fact is invalid: ", role_name
            ));
        }
        out = Concat(out, Concat(
            "    Impl ability: ", Concat(ability_name, "\n")
        ));
        let local_method_index: Int = 0;
        while local_method_index < method_count {
            let method_row: Int = method_start + local_method_index;
            let method_bounds: Array<Int> = [0, 0];
            if !MirObjectArrayObjectBoundsAt(
                json, decl_start, decl_end, "methods", method_row,
                method_bounds
            ) {
                MirLowerFailClosed(Concat(
                    "role impl method range exceeds method facts: ", role_name
                ));
            }
            let method_name: String = MirObjectStringFact(
                json, method_bounds[0], method_bounds[1], "name"
            );
            let routine_row: Option<Int> = MirProgramRoutineIndexFindMethodRow(
                routines, role_name, method_name
            );
            if method_name == "" || !IsSome(routine_row) {
                MirLowerFailClosed(Concat(
                    "role impl method is missing routine fact: ",
                    Concat(role_name, Concat(".", method_name))
                ));
            }
            let contract: MirDeclarationMethodContractFact =
                MirDeclarationMethodContractFactFromBounds(
                    json, method_bounds[0], method_bounds[1]
                );
            if !contract.valid || contract.callable_kind != "function" {
                MirLowerFailClosed(Concat(
                    "role method contract is invalid: ",
                    Concat(role_name, Concat(".", method_name))
                ));
            }
            let contract_rows: String = MirDeclarationMethodContractRows(
                contract, "        "
            );
            out = Concat(out, EmitRoutineTreeWithContractAtRowWithExpressionOrder(
                routines, UnwrapOption(routine_row), "      ", for_type,
                contract.callable_kind, contract_rows, false, false,
                expression_order, abi_validation
            ));
            local_method_index = local_method_index + 1;
        }
        impl_index = impl_index + 1;
    }
    return out;
}
