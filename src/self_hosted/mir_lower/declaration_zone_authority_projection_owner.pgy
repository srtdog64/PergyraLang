// pgy.mir.v1 zone-authority declaration -> canonical AST rows.
//
// The MIR declaration is the only accepted source here. Missing authority
// rows on a zone fail closed; no action contract or subject type may recreate
// them heuristically.

import "error_owner.pgy";
import "json_fact_read.pgy";

func MirDeclarationZoneAuthorityAbilityType(
    json: String, start: Int, end: Int
) -> String {
    let base: String = MirObjectStringFactAtBounds(
        json, start, end, "base"
    );
    let actual_bounds: Array<Int> = [0, 0];
    if base == "" || !MirObjectArrayBoundsAtBounds(
        json, start, end, "actuals", actual_bounds
    ) {
        MirLowerFailClosed("zone authority ability reference is malformed");
    }
    let actuals: Array<String> = MirObjectArrayStringFactsAtBounds(
        json, start, end, "actuals"
    );
    let out: String = base;
    if ArrayLength(actuals) == 0 { return out; }
    out = Concat(out, "<");
    let actual_i: Int = 0;
    while actual_i < ArrayLength(actuals) {
        if actuals[actual_i] == "" {
            MirLowerFailClosed(
                "zone authority ability actual type is missing"
            );
        }
        if actual_i > 0 { out = Concat(out, ", "); }
        out = Concat(out, actuals[actual_i]);
        actual_i = actual_i + 1;
    }
    return Concat(out, ">");
}

func EmitDeclZoneAuthorities(
    json: String, decl_start: Int, decl_end: Int,
    owner_name: String, nominal_kind: String,
    subject_slot_names: Array<String>
) -> String {
    let bounds: Array<Int> = [0, 0];
    let present: Bool = MirObjectArrayBoundsAtBounds(
        json, decl_start, decl_end, "zone_authorities", bounds
    );
    if nominal_kind != "zone" {
        if present {
            MirLowerFailClosed(Concat(
                "non-zone declaration carries zone authority facts: ",
                owner_name
            ));
        }
        return "";
    }
    if !present {
        MirLowerFailClosed(Concat(
            "zone declaration is missing authority fact inventory: ",
            owner_name
        ));
    }
    let out: String = "";
    let seen_slots: Array<String> = [];
    let authority_bounds: Array<Int> = [0, 0];
    let cursor: Int = bounds[0] + 1;
    while JsonArrayNextObjectBounds(
        json, cursor, bounds[1], authority_bounds
    ) {
        let slot: String = MirObjectStringFactAtBounds(
            json, authority_bounds[0], authority_bounds[1], "subject_slot"
        );
        if slot == "" {
            MirLowerFailClosed(Concat(
                "zone authority subject slot is missing: ", owner_name
            ));
        }
        let slot_matches: Int = 0;
        let declared_slot: Int = 0;
        while declared_slot < ArrayLength(subject_slot_names) {
            if subject_slot_names[declared_slot] == slot {
                slot_matches = slot_matches + 1;
            }
            declared_slot = declared_slot + 1;
        }
        if slot_matches != 1 {
            MirLowerFailClosed(Concat(
                "zone authority subject slot is not declared: ",
                Concat(owner_name, Concat(".", slot))
            ));
        }
        let prior_slot: Int = 0;
        while prior_slot < ArrayLength(seen_slots) {
            if seen_slots[prior_slot] == slot {
                MirLowerFailClosed(Concat(
                    "zone authority subject slot is duplicated: ",
                    Concat(owner_name, Concat(".", slot))
                ));
            }
            prior_slot = prior_slot + 1;
        }
        ArrayPush(seen_slots, slot);
        out = Concat(out, Concat(
            "    Authority: ", Concat(slot, "\n")
        ));
        let required_bounds: Array<Int> = [0, 0];
        if !MirObjectArrayBoundsAtBounds(
            json, authority_bounds[0], authority_bounds[1],
            "requires", required_bounds
        ) {
            MirLowerFailClosed(Concat(
                "zone authority is missing required ability inventory: ",
                Concat(owner_name, Concat(".", slot))
            ));
        }
        let required: Array<String> = [];
        let ability_bounds: Array<Int> = [0, 0];
        let ability_cursor: Int = required_bounds[0] + 1;
        while JsonArrayNextObjectBounds(
            json, ability_cursor, required_bounds[1], ability_bounds
        ) {
            let ability_type: String = MirDeclarationZoneAuthorityAbilityType(
                json, ability_bounds[0], ability_bounds[1]
            );
            let prior_ability: Int = 0;
            while prior_ability < ArrayLength(required) {
                if required[prior_ability] == ability_type {
                    MirLowerFailClosed(Concat(
                        "zone authority required ability is duplicated: ",
                        ability_type
                    ));
                }
                prior_ability = prior_ability + 1;
            }
            ArrayPush(required, ability_type);
            ability_cursor = ability_bounds[1];
        }
        if ArrayLength(required) > 0 {
            out = Concat(out, Concat(
                "      Requires: ", Concat(StringJoin(required, ", "), "\n")
            ));
        }
        cursor = authority_bounds[1];
    }
    return out;
}
