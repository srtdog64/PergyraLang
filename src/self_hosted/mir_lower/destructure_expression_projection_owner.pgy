// MIR destructure facts -> canonical let-expression graph sequence.

import "expression_graph_sequence_owner.pgy";

func MirDestructureNeedsTemp(expr0: String) -> Bool {
    let init: String = StringTrim(expr0);
    return StringIndexOf(init, "(") >= 0 || StringIndexOf(init, "[") >= 0 ||
        StringIndexOf(init, " ") >= 0 || StringIndexOf(init, ",") >= 0;
}

func MirDestructureTempName(first_binding: String) -> String {
    if first_binding == "" { return ""; }
    return Concat("_pgy_destructure_", first_binding);
}

func MirExpressionGraphSequenceAppendIndexProjection(
    sequence: MirExpressionGraphSequence,
    source: String,
    index: Int
) -> MirExpressionGraphSequence {
    if !sequence.ok || source == "" || index < 0 {
        return MirExpressionGraphSequenceError(sequence);
    }
    let kinds: Array<Int> = sequence.arena.topology.node_kinds;
    let texts: Array<String> = sequence.arena.node_texts;
    let lefts: Array<Int> = sequence.arena.topology.left_children;
    let rights: Array<Int> = sequence.arena.topology.right_children;
    let target_kinds: Array<Int> = sequence.arena.call_target_kinds;
    let target_names: Array<String> = sequence.arena.call_target_names;
    let place_kinds: Array<Int> = sequence.arena.place_kinds;
    let offset: Int = ArrayLength(kinds);
    if ArrayLength(texts) != offset || ArrayLength(lefts) != offset ||
        ArrayLength(rights) != offset ||
        ArrayLength(target_kinds) != offset ||
        ArrayLength(target_names) != offset ||
        ArrayLength(place_kinds) != offset {
        return MirExpressionGraphSequenceError(sequence); }
    let index_text: String = ToString(index);
    ArrayPush(kinds, AstExpressionNodeLeaf());
    ArrayPush(texts, source);
    ArrayPush(lefts, 0); ArrayPush(rights, 0);
    ArrayPush(target_kinds, SemanticCallTargetNone());
    ArrayPush(target_names, "");
    ArrayPush(place_kinds, SemanticExpressionPlaceUnknown());
    ArrayPush(kinds, AstExpressionNodeIntegerLiteral());
    ArrayPush(texts, index_text);
    ArrayPush(lefts, 0); ArrayPush(rights, 0);
    ArrayPush(target_kinds, SemanticCallTargetNone());
    ArrayPush(target_names, "");
    ArrayPush(place_kinds, SemanticExpressionPlaceUnknown());
    ArrayPush(kinds, AstExpressionNodeIndex());
    ArrayPush(texts, Concat(source, Concat("[", Concat(index_text, "]"))));
    ArrayPush(lefts, offset);
    ArrayPush(rights, offset + 1);
    ArrayPush(target_kinds, SemanticCallTargetNone());
    ArrayPush(target_names, "");
    ArrayPush(place_kinds, SemanticExpressionPlaceUnknown());
    let roots: Array<Int> = sequence.roots;
    ArrayPush(roots, offset + 2);
    let extended: MirExpressionGraphSequence =
        MirExpressionGraphSequenceFromExtendedRows(
            sequence, roots, kinds, texts, lefts, rights,
            target_kinds, target_names, place_kinds
        );
    if !extended.ok || !MirExpressionGraphRangeReachable(
            extended.arena, offset, 3, offset + 2) {
        return MirExpressionGraphSequenceError(sequence);
    }
    return extended;
}

func MirExpressionGraphSequenceAppendDestructureOccurrence(
    sequence: MirExpressionGraphSequence,
    instruction: JsonObjectFactTable,
    graph: JsonObjectFactTable,
    ordinal: Int
) -> MirExpressionGraphSequence {
    let expr0: Option<String> = JsonObjectFactStringFieldOpt(instruction, "expr0");
    let element_type: Option<String> = JsonObjectFactStringFieldOpt(instruction, "destructure_element_type");
    let binding_bounds: Array<Int> = [0, 0];
    if ordinal < 0 || !IsSome(expr0) || UnwrapOption(expr0) == "" ||
        !IsSome(element_type) || UnwrapOption(element_type) == "" ||
        !JsonObjectFactArrayBounds(
            instruction, "destructure_bindings", binding_bounds
        ) {
        return MirExpressionGraphSequenceError(sequence);
    }
    let binding_count: Int = JsonArrayStringCount(instruction.json, binding_bounds[0], binding_bounds[1]);
    if binding_count <= 0 { return MirExpressionGraphSequenceError(sequence); }
    let first_binding: String = JsonArrayStringAt(instruction.json, binding_bounds[0], binding_bounds[1], 0);
    if first_binding == "" { return MirExpressionGraphSequenceError(sequence); }
    let init: String = UnwrapOption(expr0);
    let needs_temp: Bool = MirDestructureNeedsTemp(init);
    if (needs_temp && ordinal > binding_count) ||
        (!needs_temp && ordinal >= binding_count) {
        return MirExpressionGraphSequenceError(sequence);
    }
    if needs_temp && ordinal == 0 {
        if !JsonObjectFactTableReady(graph) {
            return MirExpressionGraphSequenceError(sequence);
        }
        return MirExpressionGraphSequenceAppend(sequence, graph);
    }
    let binding_index: Int = ordinal;
    let source: String = init;
    if needs_temp {
        binding_index = ordinal - 1;
        source = MirDestructureTempName(first_binding);
    }
    if binding_index < 0 || binding_index >= binding_count ||
        JsonArrayStringAt(
            instruction.json, binding_bounds[0], binding_bounds[1],
            binding_index
        ) == "" {
        return MirExpressionGraphSequenceError(sequence);
    }
    return MirExpressionGraphSequenceAppendIndexProjection(
        sequence, source, binding_index
    );
}
