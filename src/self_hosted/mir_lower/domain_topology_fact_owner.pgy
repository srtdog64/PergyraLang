// Typed admission owner for the program-global pgy.mir.v1 domain topology.
//
// DIR remains the semantic owner.  This module accepts only its lossless MIR
// carrier, joins row names to declaration field kinds, and never reconstructs
// refresh/link policy from source or AST text.

import "json_fact_read.pgy";
import "program_declaration_index_owner.pgy";
import "../lib/nominal_field_kind_owner.pgy";

struct MirDomainTopologyFacts {
    let valid: Bool;
    let present: Bool;
    let domain_graph_id: String;
    let owner_names: Array<String>;
    let owner_source_syntax_ids: Array<String>;
    let source_syntax_ids: Array<String>;
    let kinds: Array<String>;
    let projection_slot_names: Array<String>;
    let projection_slot_source_syntax_ids: Array<String>;
    let source_slot_names: Array<String>;
    let source_slot_source_syntax_ids: Array<String>;
    let layer_slot_names: Array<String>;
    let layer_slot_source_syntax_ids: Array<String>;
    let target_slot_names: Array<String>;
    let target_slot_source_syntax_ids: Array<String>;
    let left_slot_names: Array<String>;
    let left_slot_source_syntax_ids: Array<String>;
    let right_slot_names: Array<String>;
    let right_slot_source_syntax_ids: Array<String>;
    let participant_slot_names: Array<String>;
    let participant_slot_source_syntax_ids: Array<String>;
}

func EmptyMirDomainTopologyFacts(present: Bool) -> MirDomainTopologyFacts {
    let strings0: Array<String> = [];
    let strings1: Array<String> = [];
    let strings2: Array<String> = [];
    let strings3: Array<String> = [];
    let strings4: Array<String> = [];
    let strings5: Array<String> = [];
    let strings6: Array<String> = [];
    let strings7: Array<String> = [];
    let strings8: Array<String> = [];
    let strings9: Array<String> = [];
    let strings10: Array<String> = [];
    let strings11: Array<String> = [];
    let strings12: Array<String> = [];
    let strings13: Array<String> = [];
    let strings14: Array<String> = [];
    let strings15: Array<String> = [];
    let strings16: Array<String> = [];
    let strings17: Array<String> = [];
    return MirDomainTopologyFacts(
        !present, present, "", strings0, strings1, strings2, strings3,
        strings4, strings5, strings6, strings7, strings8, strings9,
        strings10, strings11, strings12, strings13, strings14, strings15,
        strings16, strings17
    );
}

func MirDomainTopologyPositiveDecimal(value: String) -> Bool {
    let n: Int = StringLength(value);
    if n <= 0 || CharCode(value, n, 0) == CharCode("0", 1, 0) {
        return false;
    }
    let i: Int = 0;
    while i < n {
        let code: Int = CharCode(value, n, i);
        if code < CharCode("0", 1, 0) || code > CharCode("9", 1, 0) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func MirDomainTopologyKnownKind(kind: String) -> Bool {
    return kind == "refresh" || kind == "publish" || kind == "bind" ||
        kind == "maintain-effect" || kind == "link-relation";
}

func MirDomainTopologyNullableNameId(
    ref row: JsonObjectFactTable,
    name_field: String,
    id_field: String,
    inout name_out: Array<String>,
    inout id_out: Array<String>
) -> Bool {
    if !JsonObjectFactHasField(row, name_field) ||
        !JsonObjectFactHasField(row, id_field) {
        return false;
    }
    let id_opt: Option<String> = JsonObjectFactNumberFieldOpt(row, id_field);
    let kind_opt: Option<String> = JsonObjectFactValueKind(row, name_field);
    if !IsSome(id_opt) || !IsSome(kind_opt) { return false; }
    let id: String = UnwrapOption(id_opt);
    let value_kind: String = UnwrapOption(kind_opt);
    if value_kind == "null" {
        if id != "0" { return false; }
        ArrayPush(name_out, "");
        ArrayPush(id_out, id);
        return true;
    }
    if value_kind != "string" || !MirDomainTopologyPositiveDecimal(id) {
        return false;
    }
    let name_opt: Option<String> = JsonObjectFactStringFieldOpt(row, name_field);
    if !IsSome(name_opt) || StringLength(UnwrapOption(name_opt)) == 0 {
        return false;
    }
    ArrayPush(name_out, UnwrapOption(name_opt));
    ArrayPush(id_out, id);
    return true;
}

func MirDomainTopologyRequiredForDocument(
    ref document: MirDocumentFactIndex
) -> Bool {
    let count: Int = JsonArrayObjectFactCount(document.declarations);
    let i: Int = 0;
    while i < count {
        let declaration: JsonObjectFactTable = JsonArrayObjectFactAt(
            document.declarations, i
        );
        let nominal_opt: Option<String> = JsonObjectFactStringFieldOpt(
            declaration, "nominal_kind"
        );
        if IsSome(nominal_opt) &&
            (UnwrapOption(nominal_opt) == "zone" ||
             UnwrapOption(nominal_opt) == "effect" ||
             UnwrapOption(nominal_opt) == "relation") {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func MirDomainTopologyRelationDeclarationReady(
    ref identities: MirProgramDeclarationFieldIdentityIndex,
    owner_name: String
) -> Bool {
    if !MirProgramDeclarationFieldIdentityDeclarationIs(
        identities, owner_name, "relation", "relation"
    ) {
        return false;
    }
    return MirProgramDeclarationFieldIdentityKindCount(
        identities, owner_name, NominalFieldKindSubjectSlot()
    ) == 2;
}

func MirDomainTopologyProjectionSourceIdentityReady(
    ref identities: MirProgramDeclarationFieldIdentityIndex,
    owner_name: String,
    field_name: String,
    source_syntax_id: String
) -> Bool {
    return MirProgramDeclarationFieldIdentityMatches(
            identities, owner_name, field_name, source_syntax_id,
            NominalFieldKindSubjectSlot()
        ) || MirProgramDeclarationFieldIdentityMatches(
            identities, owner_name, field_name, source_syntax_id,
            NominalFieldKindObjectSlot()
        ) || MirProgramDeclarationFieldIdentityMatches(
            identities, owner_name, field_name, source_syntax_id,
            NominalFieldKindTObjectSlot()
        ) || MirProgramDeclarationFieldIdentityMatches(
            identities, owner_name, field_name, source_syntax_id,
            NominalFieldKindBindingSlot()
        );
}

func MirDomainTopologyOptionalSubjectIdentityReady(
    ref identities: MirProgramDeclarationFieldIdentityIndex,
    owner_name: String,
    field_name: String,
    source_syntax_id: String
) -> Bool {
    if field_name == "" { return source_syntax_id == "0"; }
    return MirProgramDeclarationFieldIdentityMatches(
        identities, owner_name, field_name, source_syntax_id,
        NominalFieldKindSubjectSlot()
    );
}

func MirDomainTopologyRowDeclarationJoinReady(
    ref identities: MirProgramDeclarationFieldIdentityIndex,
    owner_name: String,
    kind: String,
    projection_name: String,
    projection_id: String,
    source_name: String,
    source_id: String,
    layer_name: String,
    layer_id: String,
    target_name: String,
    target_id: String,
    left_name: String,
    left_id: String,
    right_name: String,
    right_id: String,
    participant_name: String,
    participant_id: String
) -> Bool {
    let owner_kind: String =
        MirProgramDeclarationFieldIdentityNominalKind(
            identities, owner_name
        );
    if !MirDomainTopologyOptionalSubjectIdentityReady(
        identities, owner_name, participant_name, participant_id
    ) {
        return false;
    }
    if kind == "refresh" || kind == "publish" || kind == "bind" {
        if owner_kind != "effect" && owner_kind != "relation" &&
            owner_kind != "zone" {
            return false;
        }
        if !MirProgramDeclarationFieldIdentityMatches(
                identities, owner_name, projection_name, projection_id,
                NominalFieldKindObjectSlot()
            ) && !MirProgramDeclarationFieldIdentityMatches(
                identities, owner_name, projection_name, projection_id,
                NominalFieldKindTObjectSlot()
            ) {
            return false;
        }
        if !MirDomainTopologyProjectionSourceIdentityReady(
            identities, owner_name, source_name, source_id
        ) {
            return false;
        }
        return layer_name == "" && layer_id == "0" &&
            target_name == "" && target_id == "0" &&
            left_name == "" && left_id == "0" &&
            right_name == "" && right_id == "0";
    }
    if owner_kind != "zone" || projection_name != "" ||
        projection_id != "0" || source_name != "" || source_id != "0" {
        return false;
    }
    if kind == "maintain-effect" {
        return MirProgramDeclarationFieldIdentityMatches(
                identities, owner_name, layer_name, layer_id,
                NominalFieldKindEffectSlot()
            ) && MirProgramDeclarationFieldIdentityMatches(
                identities, owner_name, target_name, target_id,
                NominalFieldKindSubjectSlot()
            ) && left_name == "" && left_id == "0" &&
            right_name == "" && right_id == "0";
    }
    if kind == "link-relation" {
        return MirProgramDeclarationFieldIdentityMatches(
                identities, owner_name, layer_name, layer_id,
                NominalFieldKindRelationSlot()
            ) && MirProgramDeclarationFieldIdentityMatches(
                identities, owner_name, left_name, left_id,
                NominalFieldKindSubjectSlot()
            ) && MirProgramDeclarationFieldIdentityMatches(
                identities, owner_name, right_name, right_id,
                NominalFieldKindSubjectSlot()
            ) && target_name == "" && target_id == "0";
    }
    return false;
}

func MirDomainTopologyDeclarationIndexReady(
    ref declarations: MirProgramDeclarationIndex
) -> Bool {
    return declarations.valid && declarations.field_identities.valid &&
        MirProgramDeclarationIndexCount(declarations) ==
            ArrayLength(declarations.field_identities.declaration_names);
}

func MirDomainTopologyFactsFromDocument(
    ref document: MirDocumentFactIndex
) -> MirDomainTopologyFacts {
    if !document.valid || !JsonObjectFactTableReady(document.domain_topology) {
        return EmptyMirDomainTopologyFacts(false);
    }
    let graph_id_opt: Option<String> = JsonObjectFactNumberFieldOpt(
        document.domain_topology, "domain_graph_id"
    );
    let rows: JsonArrayObjectFactTable = JsonObjectFactArrayObjectTable(
        document.domain_topology, "rows"
    );
    if JsonObjectFactCount(document.domain_topology) != 2 ||
        !IsSome(graph_id_opt) ||
        !MirDomainTopologyPositiveDecimal(UnwrapOption(graph_id_opt)) ||
        !JsonArrayObjectFactTableReady(rows) {
        return EmptyMirDomainTopologyFacts(true);
    }
    let declarations: MirProgramDeclarationIndex =
        BuildMirProgramDeclarationIndex(document.root.json);
    if !MirDomainTopologyDeclarationIndexReady(declarations) {
        return EmptyMirDomainTopologyFacts(true);
    }

    let owner_names: Array<String> = [];
    let owner_ids: Array<String> = [];
    let source_ids: Array<String> = [];
    let kinds: Array<String> = [];
    let projection_names: Array<String> = [];
    let projection_ids: Array<String> = [];
    let source_names: Array<String> = [];
    let source_slot_ids: Array<String> = [];
    let layer_names: Array<String> = [];
    let layer_ids: Array<String> = [];
    let target_names: Array<String> = [];
    let target_ids: Array<String> = [];
    let left_names: Array<String> = [];
    let left_ids: Array<String> = [];
    let right_names: Array<String> = [];
    let right_ids: Array<String> = [];
    let participant_names: Array<String> = [];
    let participant_ids: Array<String> = [];
    let row_index: Int = 0;
    while row_index < JsonArrayObjectFactCount(rows) {
        let row: JsonObjectFactTable = JsonArrayObjectFactAt(rows, row_index);
        let owner_opt: Option<String> = JsonObjectFactStringFieldOpt(
            row, "owner_name"
        );
        let owner_id_opt: Option<String> = JsonObjectFactNumberFieldOpt(
            row, "owner_source_syntax_id"
        );
        let source_id_opt: Option<String> = JsonObjectFactNumberFieldOpt(
            row, "source_syntax_id"
        );
        let kind_opt: Option<String> = JsonObjectFactStringFieldOpt(row, "kind");
        if JsonObjectFactCount(row) != 18 || !IsSome(owner_opt) ||
            StringLength(UnwrapOption(owner_opt)) == 0 ||
            !IsSome(owner_id_opt) ||
            !MirDomainTopologyPositiveDecimal(UnwrapOption(owner_id_opt)) ||
            !IsSome(source_id_opt) ||
            !MirDomainTopologyPositiveDecimal(UnwrapOption(source_id_opt)) ||
            !IsSome(kind_opt) ||
            !MirDomainTopologyKnownKind(UnwrapOption(kind_opt)) {
            return EmptyMirDomainTopologyFacts(true);
        }
        ArrayPush(owner_names, UnwrapOption(owner_opt));
        ArrayPush(owner_ids, UnwrapOption(owner_id_opt));
        ArrayPush(source_ids, UnwrapOption(source_id_opt));
        ArrayPush(kinds, UnwrapOption(kind_opt));
        if !MirDomainTopologyNullableNameId(
                row, "projection_slot_name",
                "projection_slot_source_syntax_id",
                projection_names, projection_ids
            ) || !MirDomainTopologyNullableNameId(
                row, "source_slot_name", "source_slot_source_syntax_id",
                source_names, source_slot_ids
            ) || !MirDomainTopologyNullableNameId(
                row, "layer_slot_name", "layer_slot_source_syntax_id",
                layer_names, layer_ids
            ) || !MirDomainTopologyNullableNameId(
                row, "target_slot_name", "target_slot_source_syntax_id",
                target_names, target_ids
            ) || !MirDomainTopologyNullableNameId(
                row, "left_slot_name", "left_slot_source_syntax_id",
                left_names, left_ids
            ) || !MirDomainTopologyNullableNameId(
                row, "right_slot_name", "right_slot_source_syntax_id",
                right_names, right_ids
            ) || !MirDomainTopologyNullableNameId(
                row, "participant_slot_name",
                "participant_slot_source_syntax_id",
                participant_names, participant_ids
            ) {
            return EmptyMirDomainTopologyFacts(true);
        }
        if !MirDomainTopologyRowDeclarationJoinReady(
            declarations.field_identities,
            owner_names[row_index], kinds[row_index],
            projection_names[row_index], projection_ids[row_index],
            source_names[row_index], source_slot_ids[row_index],
            layer_names[row_index], layer_ids[row_index],
            target_names[row_index], target_ids[row_index],
            left_names[row_index], left_ids[row_index],
            right_names[row_index], right_ids[row_index],
            participant_names[row_index], participant_ids[row_index]
        ) {
            return EmptyMirDomainTopologyFacts(true);
        }
        let prior: Int = 0;
        while prior < row_index {
            if source_ids[prior] == source_ids[row_index] ||
                ((owner_names[prior] == owner_names[row_index]) !=
                    (owner_ids[prior] == owner_ids[row_index])) {
                return EmptyMirDomainTopologyFacts(true);
            }
            prior = prior + 1;
        }
        row_index = row_index + 1;
    }
    let relation_index: Int = 0;
    while relation_index < ArrayLength(
        declarations.field_identities.declaration_names
    ) {
        if declarations.field_identities.declaration_nominal_kinds[
                relation_index
            ] == "relation" {
            if !MirDomainTopologyRelationDeclarationReady(
                declarations.field_identities,
                declarations.field_identities.declaration_names[relation_index]
            ) {
                return EmptyMirDomainTopologyFacts(true);
            }
        }
        relation_index = relation_index + 1;
    }
    return MirDomainTopologyFacts(
        true, true, UnwrapOption(graph_id_opt), owner_names, owner_ids,
        source_ids, kinds, projection_names, projection_ids, source_names,
        source_slot_ids, layer_names, layer_ids, target_names, target_ids,
        left_names, left_ids, right_names, right_ids, participant_names,
        participant_ids
    );
}
