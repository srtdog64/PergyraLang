// A call spine's own identity against its own children.
//
// A persisted call node renders its callee and a call-argument node extends the
// spine before it, so a graph whose call text names one callee while its callee
// leaf names another describes a call nobody wrote. Only that spine prefix is
// pinned here. How an argument renders itself belongs to the surface that
// produced it, and a drifted argument is a typed fact whose own owner reports
// it -- pinning the whole rendering would pre-empt that diagnostic.

import "../hir/ast_expression_graph_owner.pgy";
import "../hir/ast_text_scan_owner.pgy";

func MirExpressionGraphCallArgumentTextReady(
    text: String, ref kinds: Array<Int>, ref texts: Array<String>, left: Int
) -> Bool {
    let base: String = texts[left];
    let length: Int = StringLength(base);
    if length < 1 || CodegenCharAt(base, length - 1) != ")" { return false; }
    let stem: String = Substring(base, 0, length - 1);
    if kinds[left] == AstExpressionNodeCallArgument() {
        stem = Concat(stem, ", ");
    }
    let length_text: Int = StringLength(text);
    if length_text < StringLength(stem) + 1 ||
        CodegenCharAt(text, length_text - 1) != ")" { return false; }
    return Substring(text, 0, StringLength(stem)) == stem;
}

func MirExpressionGraphCallSpineTextReady(
    kind: Int, text: String, ref kinds: Array<Int>, ref texts: Array<String>,
    left: Int, right: Int
) -> Bool {
    if kind == AstExpressionNodeCall() {
        return text == Concat(texts[left], "()");
    }
    if kind == AstExpressionNodeCallArgument() {
        return MirExpressionGraphCallArgumentTextReady(
            text, kinds, texts, left);
    }
    return true;
}
