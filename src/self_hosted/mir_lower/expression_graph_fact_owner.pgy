// MIR graph facts bound to structured AST expression occurrence identity.
import "../semantic/ast_expression_surface_fact_owner.pgy";
import "../semantic/ast_expression_call_target_fact_owner.pgy";
import "program_routine_index_owner.pgy";
import "program_instruction_routing_span_owner.pgy";
import "structured_expression_emission_order_owner.pgy";
import "expression_graph_occurrence_owner.pgy";
import "expression_graph_parser_bridge_owner.pgy";
import "intent_execution_graph_target_owner.pgy";
import "expression_identity_epoch_owner.pgy";
func MirExpressionGraphFactPressureStage(
    enabled: Bool,
    stage: String
) -> Void {
    if enabled {
        Log(Concat("[driver-pressure-stage] ", stage));
    }
}
func MirExpressionGraphFactsForArtifactObserved(
    ref routines: MirProgramRoutineIndex,
    artifact: AstTreeArtifact,
    ref order: MirStructuredExpressionEmissionOrder,
    ref intent_execution_plan: MirIntentExecutionPlan,
    observe_pressure: Bool
) -> SemanticExpressionGraphFacts {
    let surfaces: SemanticAstExpressionSurfaceFacts =
        SemanticAstExpressionSurfaceRowsFromArtifact(artifact);
    MirExpressionGraphFactPressureStage(observe_pressure,
        "consumer:expression-graph:surfaces:done");
    let sequence: MirExpressionGraphSequence =
        MirExpressionGraphSequenceEmpty();
    let roots: Array<Int> = [];
    let has_roots: Array<Bool> = [];
    let valid: Bool = MirProgramRoutineIndexStructureReady(routines) &&
        MirStructuredExpressionEmissionOrderReady(order);
    let order_i: Int = 0;
    let order_count: Int = ArrayLength(order.global_instruction_rows);
    let instruction_count: Int = ArrayLength(routines.instruction_starts);
    let expr0_seen: Array<Bool> = [];
    let expr1_seen: Array<Bool> = [];
    let seen_i: Int = 0;
    while seen_i < instruction_count {
        ArrayPush(expr0_seen, false);
        ArrayPush(expr1_seen, false);
        seen_i = seen_i + 1;
    }
    let covered_i: Int = 0;
    while covered_i < ArrayLength(order.covered_producer_rows) {
        let covered_row: Int = order.covered_producer_rows[covered_i];
        if covered_row < 0 || covered_row >= instruction_count {
            valid = false;
        } else {
            let covered_expression: MirProgramInstructionExpressionFact =
                MirProgramInstructionExpressionIndexAt(
                    routines.instruction_expressions, covered_row
                );
            if !MirInstructionExpressionRequiresExpr0Graph(
                    routines.source_json,
                    routines.instruction_kinds[covered_row],
                    routines.instruction_source_types[covered_row],
                    covered_expression
                ) || MirInstructionExpressionRequiresExpr1Graph(
                    routines.source_json, routines.instruction_kinds[covered_row],
                    routines.instruction_source_types[covered_row],
                    covered_expression
                ) {
                valid = false;
            } else {
                ArraySet(expr0_seen, covered_row, true);
            }
        }
        covered_i = covered_i + 1;
    }
    MirExpressionGraphFactPressureStage(observe_pressure,
        "consumer:expression-graph:covered:done");
    let i: Int = 0;
    while i < SemanticAstExpressionSurfaceCount(surfaces) {
        let node_id: Int = surfaces.node_ids[i];
        let lane: Int = AstExpressionLaneAtom();
        while lane <= AstExpressionLaneAuxiliary() {
            let required: Bool = false;
            let producer_only: Bool = false;
            let expected_text: String = "";
            if lane == AstExpressionLaneAtom() {
                required = surfaces.has_atoms[i] &&
                    SemanticAstExpressionGraphAtomLaneRequired(
                        artifact, node_id
                    );
                producer_only = surfaces.has_atoms[i] &&
                    SemanticAstExpressionGraphAtomLaneProducerOnly(
                        artifact, node_id
                    );
                expected_text = surfaces.normalized_atoms[i];
            } else if lane == AstExpressionLaneValue() {
                required = surfaces.has_values[i] &&
                    SemanticAstExpressionGraphValueLaneRequired(
                        artifact, node_id
                    );
                expected_text = surfaces.normalized_values[i];
            } else {
                required = surfaces.has_auxiliary_values[i] &&
                    SemanticAstExpressionGraphAuxiliaryLaneRequired(
                        artifact, node_id
                    );
                expected_text = surfaces.normalized_auxiliary_values[i];
            }
            if required || producer_only {
                let occurrence_valid: Bool = valid;
                let root: Int = 0;
                let has_root: Bool = false;
                if order_i >= order_count {
                    occurrence_valid = false;
                } else {
                    let global_row: Int =
                        order.global_instruction_rows[order_i];
                    let ordinal: Int = order.derived_ordinals[order_i];
                    if order.lanes[order_i] != lane || global_row < 0 ||
                        global_row >= instruction_count {
                        occurrence_valid = false;
                    } else {
                        let expression:
                            MirProgramInstructionExpressionFact =
                            MirProgramInstructionExpressionIndexAt(
                                routines.instruction_expressions, global_row
                            );
                        let kind: String =
                            routines.instruction_kinds[global_row];
                        let source: String =
                            routines.instruction_source_types[global_row];
                        let instruction: JsonObjectFactTable =
                            JsonObjectFactTable(
                                expression.valid,
                                routines.source_json,
                                routines.instruction_starts[global_row],
                                routines.instruction_ends[global_row]
                            );
                        let prior_root_count: Int =
                            ArrayLength(sequence.roots);
                        let prior_node_count: Int =
                            SemanticExpressionGraphArenaNodeCount(
                                sequence.arena
                            );
                        let graph_slot: Int = MirExpressionGraphSlotNone();
                        if producer_only {
                            if !MirExpressionGraphProducerOnlyOccurrenceAllowed(
                                    routines.source_json, kind, source,
                                    expression, lane, ordinal
                                ) {
                                occurrence_valid = false;
                            } else {
                                sequence =
                                    MirExpressionGraphSequenceAppendParserBridge(
                                        sequence, expected_text
                                    );
                            }
                        } else {
                            graph_slot = MirExpressionGraphOccurrenceGraphSlot(
                                routines.source_json, kind, source,
                                expression, lane, ordinal
                            );
                            sequence = MirExpressionGraphSequenceAppendOccurrence(
                                sequence, routines.declarations.enum_variants,
                                instruction, expression, kind, source,
                                lane, ordinal
                            );
                            let target_projection:
                                MirIntentExecutionGraphTargetProjection =
                                    MirIntentExecutionGraphTargetProjection(
                                        true, false, "", ""
                                    );
                            if MirProgramInstructionExpressionRoutingEquals(
                                routines.source_json, expression, 0, "IntentEval") {
                                target_projection =
                                    MirIntentExecutionGraphTargetForInstruction(
                                        routines, intent_execution_plan,
                                        global_row
                                    );
                            }
                            sequence = MirIntentExecutionGraphTargetProject(
                                sequence, prior_node_count,
                                target_projection
                            );
                        }
                        if !sequence.ok ||
                            ArrayLength(sequence.roots) != prior_root_count + 1 {
                            occurrence_valid = false;
                        } else {
                            root = sequence.roots[prior_root_count];
                            has_root = true;
                            if graph_slot == MirExpressionGraphSlotExpr0() {
                                ArraySet(expr0_seen, global_row, true);
                            }
                            if graph_slot == MirExpressionGraphSlotExpr1() {
                                ArraySet(expr1_seen, global_row, true);
                            }
                            if sequence.arena.node_texts[root] != expected_text {
                                occurrence_valid = false;
                            }
                        }
                    }
                    order_i = order_i + 1;
                }
                if !occurrence_valid {
                    valid = false;
                    has_root = false;
                }
                ArrayPush(roots, root);
                ArrayPush(has_roots, has_root);
            } else {
                ArrayPush(roots, 0);
                ArrayPush(has_roots, false);
            }
            lane = lane + 1;
        }
        i = i + 1;
        if observe_pressure && i % 4096 == 0 {
            MirExpressionGraphFactPressureStage(true, Concat(
                "consumer:expression-graph:surface-row:", ToString(i)));
        }
    }
    if order_i != order_count || !sequence.ok ||
        !SemanticExpressionGraphArenaReady(sequence.arena) {
        valid = false;
    }
    MirExpressionGraphFactPressureStage(observe_pressure, Concat(
        "consumer:expression-graph:sequence:done:valid:", ToString(valid)));
    let coverage_i: Int = 0;
    while coverage_i < instruction_count {
        let expression: MirProgramInstructionExpressionFact =
            MirProgramInstructionExpressionIndexAt(
                routines.instruction_expressions, coverage_i
            );
        let kind: String = routines.instruction_kinds[coverage_i];
        let source: String = routines.instruction_source_types[coverage_i];
        let expr0_required: Bool = MirInstructionExpressionRequiresExpr0Graph(
            routines.source_json, kind, source, expression
        );
        let expr1_required: Bool = MirInstructionExpressionRequiresExpr1Graph(
            routines.source_json, kind, source, expression
        );
        let special_expr0_required: Bool =
            source == "AST_MATCH_CASE" ||
            (kind == "destructure" &&
             MirProgramInstructionExpressionTextPresent(expression, 0) &&
             MirDestructureNeedsTemp(MirProgramInstructionExpressionText(
                 routines.source_json, expression, 0)));
        if (expr0_required || special_expr0_required) &&
            !expr0_seen[coverage_i] {
            valid = false;
        }
        if expr1_required && !expr1_seen[coverage_i] {
            valid = false;
        }
        coverage_i = coverage_i + 1;
    }
    MirExpressionGraphFactPressureStage(observe_pressure, Concat(
        "consumer:expression-graph:coverage:done:valid:", ToString(valid)));
    let source_facts: SemanticExpressionGraphFacts =
        SemanticExpressionGraphFacts(valid, roots, has_roots, sequence.arena);
    let facts: SemanticExpressionGraphFacts =
        MirExpressionIdentityEpochRebindGraphForArtifact(
            source_facts, routines, artifact);
    if !facts.ok || !SemanticExpressionGraphCarriedCallTargetsReady(facts) {
        return SemanticExpressionGraphFacts(
            false, roots, has_roots, facts.arena
        );
    }
    return facts;
}

func MirExpressionGraphFactsForArtifact(
    ref routines: MirProgramRoutineIndex,
    artifact: AstTreeArtifact,
    ref order: MirStructuredExpressionEmissionOrder,
    ref intent_execution_plan: MirIntentExecutionPlan
) -> SemanticExpressionGraphFacts {
    return MirExpressionGraphFactsForArtifactObserved(
        routines, artifact, order, intent_execution_plan, false
    );
}
