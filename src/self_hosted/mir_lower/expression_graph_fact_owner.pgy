// MIR JSON expression graph facts bound to reconstructed artifact NodeIds.

import "../lib/json_fact_table.pgy";
import "../semantic/ast_expression_surface_fact_owner.pgy";
import "program_routine_index_owner.pgy";
import "routine_fact_index_owner.pgy";

struct MirExpressionGraphSequence {
    ok: Bool;
    roots: Array<Int>;
    arena: SemanticExpressionGraphArena;
}

func MirExpressionGraphSequenceEmpty() -> MirExpressionGraphSequence {
    let roots: Array<Int> = [];
    return MirExpressionGraphSequence(
        true, roots, SemanticExpressionGraphArenaEmpty()
    );
}

func MirExpressionGraphSequenceError(
    sequence: MirExpressionGraphSequence
) -> MirExpressionGraphSequence {
    return MirExpressionGraphSequence(false, sequence.roots, sequence.arena);
}

func MirExpressionGraphKindCode(kind: String) -> Option<Int> {
    if kind == "leaf" { return Some(AstExpressionNodeLeaf()); }
    if kind == "logical_or" {
        return Some(AstExpressionNodeLogicalOr());
    }
    if kind == "logical_and" {
        return Some(AstExpressionNodeLogicalAnd());
    }
    if kind == "equality" {
        return Some(AstExpressionNodeEquality());
    }
    if kind == "inequality" {
        return Some(AstExpressionNodeInequality());
    }
    if kind == "less" { return Some(AstExpressionNodeLess()); }
    if kind == "less_equal" {
        return Some(AstExpressionNodeLessEqual());
    }
    if kind == "greater" { return Some(AstExpressionNodeGreater()); }
    if kind == "greater_equal" {
        return Some(AstExpressionNodeGreaterEqual());
    }
    if kind == "add" { return Some(AstExpressionNodeAdd()); }
    if kind == "subtract" { return Some(AstExpressionNodeSubtract()); }
    if kind == "multiply" { return Some(AstExpressionNodeMultiply()); }
    if kind == "divide" { return Some(AstExpressionNodeDivide()); }
    if kind == "modulo" { return Some(AstExpressionNodeModulo()); }
    if kind == "index" { return Some(AstExpressionNodeIndex()); }
    if kind == "logical_not" {
        return Some(AstExpressionNodeLogicalNot());
    }
    if kind == "negate" { return Some(AstExpressionNodeNegate()); }
    if kind == "call" { return Some(AstExpressionNodeCall()); }
    if kind == "call_argument" {
        return Some(AstExpressionNodeCallArgument());
    }
    if kind == "member_access" {
        return Some(AstExpressionNodeMemberAccess());
    }
    if kind == "try" { return Some(AstExpressionNodeTry()); }
    if kind == "array_literal" {
        return Some(AstExpressionNodeArrayLiteral());
    }
    if kind == "array_element" {
        return Some(AstExpressionNodeArrayElement());
    }
    if kind == "struct_literal" {
        return Some(AstExpressionNodeStructLiteral());
    }
    if kind == "struct_field_binding" {
        return Some(AstExpressionNodeStructFieldBinding());
    }
    if kind == "struct_field" {
        return Some(AstExpressionNodeStructField());
    }
    if kind == "struct_field_name" {
        return Some(AstExpressionNodeStructFieldName());
    }
    if kind == "generic_type_actual" {
        return Some(AstExpressionNodeGenericTypeActual());
    }
    if kind == "generic_callee" {
        return Some(AstExpressionNodeGenericCallee());
    }
    return None;
}

func MirExpressionCallTargetKindCode(kind: String) -> Option<Int> {
    if kind == "none" { return Some(SemanticCallTargetNone()); }
    if kind == "direct" { return Some(SemanticCallTargetDirect()); }
    if kind == "namespace" {
        return Some(SemanticCallTargetNamespace());
    }
    if kind == "member" { return Some(SemanticCallTargetMember()); }
    return None;
}

func MirExpressionGraphRangeReachable(
    ref arena: SemanticExpressionGraphArena,
    start: Int,
    count: Int,
    root: Int
) -> Bool {
    let seen: Array<Bool> = [];
    let i: Int = 0;
    while i < count {
        ArrayPush(seen, false);
        i = i + 1;
    }
    let pending: Array<Int> = [root];
    let visited: Int = 0;
    while ArrayLength(pending) > 0 {
        let last: Int = ArrayLength(pending) - 1;
        let node: Int = pending[last];
        ArrayPop(pending);
        if node < start || node >= start + count { return false; }
        let local_index: Int = node - start;
        if seen[local_index] { continue; }
        ArraySet(seen, local_index, true);
        visited = visited + 1;
        let arity: Int = AstExpressionNodeArity(arena.node_kinds[node]);
        if arity >= 1 {
            ArrayPush(pending, arena.left_children[node]);
        }
        if arity == 2 {
            ArrayPush(pending, arena.right_children[node]);
        }
    }
    return visited == count;
}

func MirExpressionGraphSequenceAppend(
    sequence: MirExpressionGraphSequence,
    graph: JsonObjectFactTable
) -> MirExpressionGraphSequence {
    if !sequence.ok || !JsonObjectFactTableReady(graph) {
        return MirExpressionGraphSequenceError(sequence);
    }
    let root_opt: Option<String> = JsonObjectFactNumberFieldOpt(
        graph, "root"
    );
    let nodes: JsonArrayObjectFactTable =
        JsonObjectFactArrayObjectTable(graph, "nodes");
    if !IsSome(root_opt) || !JsonArrayObjectFactTableReady(nodes) {
        return MirExpressionGraphSequenceError(sequence);
    }
    let count: Int = JsonArrayObjectFactCount(nodes);
    let local_root: Int = ToInt(UnwrapOption(root_opt));
    if count == 0 || local_root < 0 || local_root >= count {
        return MirExpressionGraphSequenceError(sequence);
    }
    let kinds: Array<Int> = sequence.arena.node_kinds;
    let texts: Array<String> = sequence.arena.node_texts;
    let left_children: Array<Int> = sequence.arena.left_children;
    let right_children: Array<Int> = sequence.arena.right_children;
    let call_target_kinds: Array<Int> =
        sequence.arena.call_target_kinds;
    let call_target_names: Array<String> = sequence.arena.call_target_names;
    let offset: Int = ArrayLength(kinds);
    let i: Int = 0;
    while i < count {
        let node: JsonObjectFactTable = JsonArrayObjectFactAt(nodes, i);
        let kind_text: Option<String> = JsonObjectFactStringFieldOpt(
            node, "kind"
        );
        let text: Option<String> = JsonObjectFactStringFieldOpt(node, "text");
        let target_kind_text: Option<String> = JsonObjectFactStringFieldOpt(
            node, "call_target_kind"
        );
        let target_name: Option<String> = JsonObjectFactStringFieldOpt(
            node, "call_target_name"
        );
        if !IsSome(kind_text) || !IsSome(text) || UnwrapOption(text) == "" ||
            !IsSome(target_kind_text) || !IsSome(target_name) {
            return MirExpressionGraphSequenceError(sequence);
        }
        let kind_opt: Option<Int> = MirExpressionGraphKindCode(
            UnwrapOption(kind_text)
        );
        if !IsSome(kind_opt) {
            return MirExpressionGraphSequenceError(sequence);
        }
        let target_kind_opt: Option<Int> = MirExpressionCallTargetKindCode(
            UnwrapOption(target_kind_text)
        );
        if !IsSome(target_kind_opt) {
            return MirExpressionGraphSequenceError(sequence);
        }
        let target_kind: Int = UnwrapOption(target_kind_opt);
        if (target_kind == SemanticCallTargetNone() &&
                UnwrapOption(target_name) != "") ||
            ((target_kind == SemanticCallTargetDirect() ||
                target_kind == SemanticCallTargetNamespace() ||
                target_kind == SemanticCallTargetMember()) &&
                UnwrapOption(target_name) == "") {
            return MirExpressionGraphSequenceError(sequence);
        }
        let kind: Int = UnwrapOption(kind_opt);
        let left: Int = 0;
        let right: Int = 0;
        let left_opt: Option<String> = JsonObjectFactNumberFieldOpt(
            node, "left"
        );
        let right_opt: Option<String> = JsonObjectFactNumberFieldOpt(
            node, "right"
        );
        let arity: Int = AstExpressionNodeArity(kind);
        if arity == 0 {
            if IsSome(left_opt) || IsSome(right_opt) {
                return MirExpressionGraphSequenceError(sequence);
            }
        } else if arity == 1 {
            if !IsSome(left_opt) || IsSome(right_opt) {
                return MirExpressionGraphSequenceError(sequence);
            }
            let local_left: Int = ToInt(UnwrapOption(left_opt));
            if local_left < 0 || local_left >= i {
                return MirExpressionGraphSequenceError(sequence);
            }
            left = offset + local_left;
            right = 0;
        } else {
            if !IsSome(left_opt) || !IsSome(right_opt) {
                return MirExpressionGraphSequenceError(sequence);
            }
            let local_left: Int = ToInt(UnwrapOption(left_opt));
            let local_right: Int = ToInt(UnwrapOption(right_opt));
            if local_left < 0 || local_right < 0 ||
                local_left >= i || local_right >= i {
                return MirExpressionGraphSequenceError(sequence);
            }
            left = offset + local_left;
            right = offset + local_right;
        }
        ArrayPush(kinds, kind);
        ArrayPush(texts, UnwrapOption(text));
        ArrayPush(left_children, left);
        ArrayPush(right_children, right);
        ArrayPush(call_target_kinds, target_kind);
        ArrayPush(call_target_names, UnwrapOption(target_name));
        i = i + 1;
    }
    let roots: Array<Int> = sequence.roots;
    ArrayPush(roots, offset + local_root);
    let arena: SemanticExpressionGraphArena = SemanticExpressionGraphArena(
        kinds, texts, left_children, right_children,
        call_target_kinds, call_target_names
    );
    if !SemanticExpressionGraphArenaReady(arena) ||
        !MirExpressionGraphRangeReachable(
            arena, offset, count, offset + local_root
        ) {
        return MirExpressionGraphSequenceError(sequence);
    }
    return MirExpressionGraphSequence(true, roots, arena);
}

func MirInstructionRequiresExpressionGraph(
    instruction: JsonObjectFactTable
) -> Bool {
    let kind: Option<String> = JsonObjectFactStringFieldOpt(
        instruction, "kind"
    );
    let name: Option<String> = JsonObjectFactStringFieldOpt(
        instruction, "name"
    );
    let arg0: Option<String> = JsonObjectFactStringFieldOpt(
        instruction, "arg0"
    );
    let source_type: Option<String> = JsonObjectFactStringFieldOpt(
        instruction, "source_type"
    );
    let expr0: Option<String> = JsonObjectFactStringFieldOpt(
        instruction, "expr0"
    );
    let expr1: Option<String> = JsonObjectFactStringFieldOpt(
        instruction, "expr1"
    );
    if !IsSome(kind) || !IsSome(name) || !IsSome(source_type) ||
        !IsSome(expr0) {
        return false;
    }
    let instruction_kind: String = UnwrapOption(kind);
    let instruction_name: String = UnwrapOption(name);
    let source: String = UnwrapOption(source_type);
    if source == "AST_FOR_LOOP" {
        if instruction_kind == "loop-init" { return true; }
        return instruction_kind == "branch" && IsSome(expr1) &&
            UnwrapOption(expr0) != UnwrapOption(expr1);
    }
    if instruction_kind == "branch" && instruction_name == "branch" &&
        !IsSome(arg0) && source != "AST_MATCH_CASE" {
        return true;
    }
    if instruction_kind == "def" &&
        (source == "AST_LET_DECL" || source == "AST_ASSIGNMENT") {
        return true;
    }
    if instruction_kind == "stmt" && source == "AST_CALL" {
        return !IsSome(arg0) || UnwrapOption(arg0) == "" ||
            UnwrapOption(arg0) == "Log" ||
            UnwrapOption(arg0) == "ArrayPush" ||
            UnwrapOption(arg0) == "ArraySet";
    }
    return instruction_kind == "return" && source != "AST_RETURN_VOID";
}

func MirInstructionRequiresTargetExpressionGraph(
    instruction: JsonObjectFactTable
) -> Bool {
    let kind: Option<String> = JsonObjectFactStringFieldOpt(
        instruction, "kind"
    );
    let arg0: Option<String> = JsonObjectFactStringFieldOpt(
        instruction, "arg0"
    );
    let source_type: Option<String> = JsonObjectFactStringFieldOpt(
        instruction, "source_type"
    );
    let expr1: Option<String> = JsonObjectFactStringFieldOpt(
        instruction, "expr1"
    );
    return IsSome(kind) && UnwrapOption(kind) == "def" &&
        IsSome(source_type) && UnwrapOption(source_type) == "AST_ASSIGNMENT" &&
        IsSome(arg0) && IsSome(expr1) &&
        UnwrapOption(arg0) != "" && UnwrapOption(expr1) != "";
}

func MirExpressionGraphSequenceFromJson(
    json: String
) -> MirExpressionGraphSequence {
    let sequence: MirExpressionGraphSequence =
        MirExpressionGraphSequenceEmpty();
    let routines: MirProgramRoutineIndex = BuildMirProgramRoutineIndex(json);
    if !routines.valid {
        return MirExpressionGraphSequenceError(sequence);
    }
    let routine_i: Int = 0;
    while routine_i < MirProgramRoutineIndexCount(routines) {
        let index: MirRoutineFactIndex = BuildMirRoutineFactIndex(
            json, routines.starts[routine_i], routines.ends[routine_i]
        );
        if !index.valid {
            return MirExpressionGraphSequenceError(sequence);
        }
        let instruction_i: Int = 0;
        while instruction_i < ArrayLength(index.instruction_starts) {
            let instruction: JsonObjectFactTable =
                JsonObjectFactTableFromBounds(
                    json, index.instruction_starts[instruction_i],
                    index.instruction_ends[instruction_i]
                );
            let graph: JsonObjectFactTable = JsonObjectFactObjectTable(
                instruction, "expr0_graph"
            );
            let target_graph: JsonObjectFactTable =
                JsonObjectFactObjectTable(instruction, "expr1_graph");
            if MirInstructionRequiresTargetExpressionGraph(instruction) {
                if !JsonObjectFactTableReady(target_graph) {
                    return MirExpressionGraphSequenceError(sequence);
                }
                sequence = MirExpressionGraphSequenceAppend(
                    sequence, target_graph
                );
            }
            if MirInstructionRequiresExpressionGraph(instruction) {
                if !JsonObjectFactTableReady(graph) {
                    return MirExpressionGraphSequenceError(sequence);
                }
                sequence = MirExpressionGraphSequenceAppend(sequence, graph);
            }
            instruction_i = instruction_i + 1;
        }
        routine_i = routine_i + 1;
    }
    return sequence;
}

func MirExpressionGraphFactsForArtifact(
    json: String,
    artifact: AstTreeArtifact
) -> SemanticExpressionGraphFacts {
    let surfaces: SemanticAstExpressionSurfaceFacts =
        SemanticAstExpressionSurfaceRowsFromArtifact(artifact);
    let sequence: MirExpressionGraphSequence =
        MirExpressionGraphSequenceFromJson(json);
    if !sequence.ok {
        let invalid_roots: Array<Int> = [];
        let invalid_has_roots: Array<Bool> = [];
        return SemanticExpressionGraphFacts(
            false, invalid_roots, invalid_has_roots, sequence.arena
        );
    }
    let roots: Array<Int> = [];
    let has_roots: Array<Bool> = [];
    let sequence_i: Int = 0;
    let valid: Bool = true;
    let i: Int = 0;
    while i < SemanticAstExpressionSurfaceCount(surfaces) {
        let node_id: Int = surfaces.node_ids[i];
        let lane: Int = AstExpressionLaneAtom();
        while lane <= AstExpressionLaneAuxiliary() {
            let required: Bool = false;
            let expected_text: String = "";
            if lane == AstExpressionLaneAtom() {
                required = surfaces.has_atoms[i] &&
                    SemanticAstExpressionGraphAtomLaneRequired(
                        artifact, node_id
                    );
                expected_text = surfaces.normalized_atoms[i];
            } else if lane == AstExpressionLaneValue() {
                required = surfaces.has_values[i] &&
                    SemanticAstExpressionGraphValueLaneRequired(
                        artifact, node_id
                    );
                expected_text = surfaces.normalized_values[i];
            } else if lane == AstExpressionLaneAuxiliary() {
                required = surfaces.has_auxiliary_values[i] &&
                    SemanticAstExpressionGraphAuxiliaryLaneRequired(
                        artifact, node_id
                    );
                expected_text = surfaces.normalized_auxiliary_values[i];
            }
            if required {
                if sequence_i >= ArrayLength(sequence.roots) {
                    valid = false;
                    ArrayPush(roots, 0);
                    ArrayPush(has_roots, false);
                } else {
                    let root: Int = sequence.roots[sequence_i];
                    if root < 0 ||
                        root >= SemanticExpressionGraphArenaNodeCount(
                            sequence.arena
                        ) || sequence.arena.node_texts[root] != expected_text {
                        valid = false;
                    }
                    ArrayPush(roots, root);
                    ArrayPush(has_roots, true);
                    sequence_i = sequence_i + 1;
                }
            } else {
                ArrayPush(roots, 0);
                ArrayPush(has_roots, false);
            }
            lane = lane + 1;
        }
        i = i + 1;
    }
    if sequence_i != ArrayLength(sequence.roots) {
        valid = false;
    }
    return SemanticExpressionGraphFacts(
        valid, roots, has_roots, sequence.arena
    );
}
