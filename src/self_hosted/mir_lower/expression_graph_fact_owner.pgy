// MIR graph facts bound to structured AST expression occurrence identity.

import "../semantic/ast_expression_surface_fact_owner.pgy";
import "../semantic/ast_expression_call_target_fact_owner.pgy";
import "program_routine_index_owner.pgy";
import "structured_expression_emission_order_owner.pgy";
import "expression_graph_occurrence_owner.pgy";
import "expression_graph_parser_bridge_owner.pgy";

func MirExpressionGraphFactsForArtifact(
    ref routines: MirProgramRoutineIndex,
    artifact: AstTreeArtifact,
    ref order: MirStructuredExpressionEmissionOrder
) -> SemanticExpressionGraphFacts {
    let surfaces: SemanticAstExpressionSurfaceFacts =
        SemanticAstExpressionSurfaceRowsFromArtifact(artifact);
    let sequence: MirExpressionGraphSequence =
        MirExpressionGraphSequenceEmpty();
    let roots: Array<Int> = [];
    let has_roots: Array<Bool> = [];
    let valid: Bool = MirProgramRoutineIndexStructureReady(routines) &&
        MirStructuredExpressionEmissionOrderReady(order);
    let order_i: Int = 0;
    let order_count: Int = ArrayLength(order.global_instruction_rows);
    let instruction_count: Int = ArrayLength(routines.instruction_starts);
    let expr0_seen: Array<Bool> = [];
    let expr1_seen: Array<Bool> = [];
    let seen_i: Int = 0;
    while seen_i < instruction_count {
        ArrayPush(expr0_seen, false);
        ArrayPush(expr1_seen, false);
        seen_i = seen_i + 1;
    }
    let i: Int = 0;
    while i < SemanticAstExpressionSurfaceCount(surfaces) {
        let node_id: Int = surfaces.node_ids[i];
        let lane: Int = AstExpressionLaneAtom();
        while lane <= AstExpressionLaneAuxiliary() {
            let required: Bool = false;
            let producer_only: Bool = false;
            let expected_text: String = "";
            if lane == AstExpressionLaneAtom() {
                required = surfaces.has_atoms[i] &&
                    SemanticAstExpressionGraphAtomLaneRequired(
                        artifact, node_id
                    );
                producer_only = surfaces.has_atoms[i] &&
                    SemanticAstExpressionGraphAtomLaneProducerOnly(
                        artifact, node_id
                    );
                expected_text = surfaces.normalized_atoms[i];
            } else if lane == AstExpressionLaneValue() {
                required = surfaces.has_values[i] &&
                    SemanticAstExpressionGraphValueLaneRequired(
                        artifact, node_id
                    );
                expected_text = surfaces.normalized_values[i];
            } else {
                required = surfaces.has_auxiliary_values[i] &&
                    SemanticAstExpressionGraphAuxiliaryLaneRequired(
                        artifact, node_id
                    );
                expected_text = surfaces.normalized_auxiliary_values[i];
            }
            if required || producer_only {
                let occurrence_valid: Bool = valid;
                let root: Int = 0;
                let has_root: Bool = false;
                if order_i >= order_count {
                    occurrence_valid = false;
                } else {
                    let global_row: Int =
                        order.global_instruction_rows[order_i];
                    let ordinal: Int = order.derived_ordinals[order_i];
                    if order.lanes[order_i] != lane || global_row < 0 ||
                        global_row >= instruction_count {
                        occurrence_valid = false;
                    } else {
                        let instruction: JsonObjectFactTable =
                            JsonObjectFactTableFromBounds(
                                routines.source_json,
                                routines.instruction_starts[global_row],
                                routines.instruction_ends[global_row]
                            );
                        let prior_root_count: Int =
                            ArrayLength(sequence.roots);
                        let graph_slot: Int = MirExpressionGraphSlotNone();
                        if producer_only {
                            if !MirExpressionGraphProducerOnlyOccurrenceAllowed(
                                    instruction, lane, ordinal
                                ) {
                                occurrence_valid = false;
                            } else {
                                sequence =
                                    MirExpressionGraphSequenceAppendParserBridge(
                                        sequence, expected_text
                                    );
                            }
                        } else {
                            graph_slot = MirExpressionGraphOccurrenceGraphSlot(
                                instruction, lane, ordinal
                            );
                            sequence = MirExpressionGraphSequenceAppendOccurrence(
                                sequence, instruction, lane, ordinal
                            );
                        }
                        if !sequence.ok ||
                            ArrayLength(sequence.roots) != prior_root_count + 1 {
                            occurrence_valid = false;
                        } else {
                            root = sequence.roots[prior_root_count];
                            has_root = true;
                            if graph_slot == MirExpressionGraphSlotExpr0() {
                                ArraySet(expr0_seen, global_row, true);
                            }
                            if graph_slot == MirExpressionGraphSlotExpr1() {
                                ArraySet(expr1_seen, global_row, true);
                            }
                            if sequence.arena.node_texts[root] != expected_text {
                                occurrence_valid = false;
                            }
                        }
                    }
                    order_i = order_i + 1;
                }
                if !occurrence_valid {
                    valid = false;
                    has_root = false;
                }
                ArrayPush(roots, root);
                ArrayPush(has_roots, has_root);
            } else {
                ArrayPush(roots, 0);
                ArrayPush(has_roots, false);
            }
            lane = lane + 1;
        }
        i = i + 1;
    }
    if order_i != order_count || !sequence.ok ||
        !SemanticExpressionGraphArenaReady(sequence.arena) {
        valid = false;
    }
    let coverage_i: Int = 0;
    while coverage_i < instruction_count {
        let instruction: JsonObjectFactTable = JsonObjectFactTableFromBounds(
            routines.source_json, routines.instruction_starts[coverage_i],
            routines.instruction_ends[coverage_i]
        );
        let kind: Option<String> = JsonObjectFactStringFieldOpt(
            instruction, "kind"
        );
        let source: Option<String> = JsonObjectFactStringFieldOpt(
            instruction, "source_type"
        );
        let expr0: Option<String> = JsonObjectFactStringFieldOpt(
            instruction, "expr0"
        );
        let special_expr0_required: Bool =
            (IsSome(source) &&
                UnwrapOption(source) == "AST_MATCH_CASE") ||
            (IsSome(kind) && UnwrapOption(kind) == "destructure" &&
                IsSome(expr0) &&
                MirDestructureNeedsTemp(UnwrapOption(expr0)));
        if (MirInstructionRequiresExpr0Graph(instruction) ||
                special_expr0_required) && !expr0_seen[coverage_i] {
            valid = false;
        }
        if MirInstructionRequiresExpr1Graph(instruction) &&
            !expr1_seen[coverage_i] {
            valid = false;
        }
        coverage_i = coverage_i + 1;
    }
    let facts: SemanticExpressionGraphFacts = SemanticExpressionGraphFacts(
        valid, roots, has_roots, sequence.arena
    );
    if !valid || !SemanticExpressionGraphCarriedCallTargetsReady(facts) {
        return SemanticExpressionGraphFacts(
            false, roots, has_roots, sequence.arena
        );
    }
    return facts;
}
