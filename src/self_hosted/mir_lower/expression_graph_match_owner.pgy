// Match-condition expression graphs derived from MIR match facts.

import "expression_graph_sequence_owner.pgy";
import "expression_graph_option_match_owner.pgy";
import "expression_graph_tagged_enum_match_owner.pgy";
import "match_json_fact_owner.pgy";
import "json_fact_read.pgy";

func MirExpressionGraphSequenceAppendMatchCondition(
    sequence: MirExpressionGraphSequence,
    instruction: JsonObjectFactTable,
    subject_graph: JsonObjectFactTable
) -> MirExpressionGraphSequence {
    let source_type: Option<String> =
        JsonObjectFactStringFieldOpt(instruction, "source_type");
    let match_value: Option<String> =
        JsonObjectFactStringFieldOpt(instruction, "expr0");
    let pattern_count: Option<Int> = MirMatchPatternCount(instruction);
    let binding_count: Option<Int> = MirMatchBindingCount(instruction);
    let binding_type_count: Option<Int> =
        MirMatchBindingTypeCount(instruction);
    if !IsSome(source_type) ||
        UnwrapOption(source_type) != "AST_MATCH_CASE" ||
        !IsSome(match_value) || UnwrapOption(match_value) == "" ||
        !IsSome(pattern_count) || UnwrapOption(pattern_count) != 1 ||
        !IsSome(binding_count) || !IsSome(binding_type_count) ||
        UnwrapOption(binding_type_count) != UnwrapOption(binding_count) {
        return MirExpressionGraphSequenceError(sequence);
    }
    let match_value_text: String = UnwrapOption(match_value);
    let pattern_opt: Option<String> = MirMatchPatternAt(instruction, 0);
    if !IsSome(pattern_opt) {
        return MirExpressionGraphSequenceError(sequence);
    }
    let variant_opt: Option<String> = MirMatchVariant(instruction);
    if IsSome(variant_opt) &&
        (UnwrapOption(variant_opt) == "Some" ||
            UnwrapOption(variant_opt) == "None" ||
            UnwrapOption(variant_opt) == "Ok" ||
            UnwrapOption(variant_opt) == "Err") {
        let variant: String = UnwrapOption(variant_opt);
        if (variant == "Some" &&
                (UnwrapOption(binding_count) != 1 ||
                    !IsSome(MirMatchBindingAt(instruction, 0)) ||
                    !IsSome(MirMatchBindingTypeAt(instruction, 0)))) ||
            (variant == "None" && UnwrapOption(binding_count) != 0) ||
            ((variant == "Ok" || variant == "Err") &&
                (UnwrapOption(binding_count) != 1 ||
                    !IsSome(MirMatchBindingAt(instruction, 0)) ||
                    !IsSome(MirMatchBindingTypeAt(instruction, 0)))) {
            return MirExpressionGraphSequenceError(sequence);
        }
        if variant == "Ok" || variant == "Err" {
            let condition_name: String = "IsOk";
            let unwrap_name: String = "Unwrap";
            if variant == "Err" {
                condition_name = "IsErr";
                unwrap_name = "UnwrapErr";
            }
            let result_condition: MirExpressionGraphSequence =
                MirExpressionGraphSequenceAppendUnaryCall(
                    sequence, subject_graph, condition_name,
                    match_value_text, false
                );
            if !result_condition.ok { return result_condition; }
            return MirExpressionGraphSequenceAppendUnaryCall(
                result_condition, subject_graph, unwrap_name,
                match_value_text, false
            );
        }
        let condition: MirExpressionGraphSequence =
            MirExpressionGraphSequenceAppendUnaryCall(
                sequence, subject_graph, "IsSome",
                match_value_text,
                variant == "None"
            );
        if !condition.ok || variant == "None" {
            return condition;
        }
        return MirExpressionGraphSequenceAppendUnaryCall(
            condition, subject_graph, "UnwrapOption",
            match_value_text, false
        );
    }
    return MirExpressionGraphSequenceAppendTaggedEnumMatch(
        sequence, instruction, subject_graph, match_value_text,
        UnwrapOption(pattern_opt), variant_opt, UnwrapOption(binding_count)
    );
}
