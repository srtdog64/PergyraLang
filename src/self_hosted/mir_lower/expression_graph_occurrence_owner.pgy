// Selects one MIR graph slot by structured AST expression occurrence identity.

import "expression_graph_sequence_owner.pgy";
import "expression_graph_instruction_policy_owner.pgy";
import "expression_graph_indexed_instruction_policy_owner.pgy";
import "program_instruction_expression_index_owner.pgy";
import "program_instruction_routing_span_owner.pgy";
import "expression_graph_match_owner.pgy";
import "destructure_expression_projection_owner.pgy";

func MirExpressionGraphSlotNone() -> Int { return 0; }
func MirExpressionGraphSlotExpr0() -> Int { return 1; }
func MirExpressionGraphSlotExpr1() -> Int { return 2; }

func MirExpressionGraphProducerOnlyOccurrenceAllowed(
    json: String,
    kind: String,
    source_type: String,
    ref expression: MirProgramInstructionExpressionFact,
    lane: Int,
    ordinal: Int
) -> Bool {
    if lane != AstExpressionLaneAtom() || ordinal != 0 ||
        !expression.valid || kind != "stmt" || source_type != "AST_CALL" ||
        !MirProgramInstructionExpressionRoutingPresent(expression, 1) {
        return false;
    }
    return MirProgramInstructionExpressionRoutingEquals(
            json, expression, 1, "ArrayPop") ||
        MirProgramInstructionExpressionRoutingEquals(
            json, expression, 1, "ArrayPush") ||
        MirProgramInstructionExpressionRoutingEquals(
            json, expression, 1, "ArraySet");
}

func MirExpressionGraphOccurrenceGraphSlot(
    json: String,
    kind: String,
    source: String,
    ref expression: MirProgramInstructionExpressionFact,
    lane: Int,
    ordinal: Int
) -> Int {
    if !expression.valid || kind == "" || source == "" || ordinal < 0 {
        return MirExpressionGraphSlotNone();
    }
    if source == "AST_MATCH_CASE" {
        return MirExpressionGraphSlotExpr0();
    }
    if kind == "destructure" {
        if lane == AstExpressionLaneValue() && ordinal == 0 &&
            MirProgramInstructionExpressionTextPresent(expression, 0) &&
            MirDestructureNeedsTemp(
                MirProgramInstructionExpressionText(json, expression, 0)
            ) {
            return MirExpressionGraphSlotExpr0();
        }
        return MirExpressionGraphSlotNone();
    }
    if ordinal != 0 { return MirExpressionGraphSlotNone(); }
    if source == "AST_FOR_LOOP" &&
        ((kind == "loop-init" && lane == AstExpressionLaneValue()) ||
         (kind == "branch" && lane == AstExpressionLaneAuxiliary())) {
        return MirExpressionGraphSlotExpr0();
    }
    if source == "AST_ASSIGNMENT" && kind == "assign" {
        if lane == AstExpressionLaneAtom() {
            return MirExpressionGraphSlotExpr0();
        }
        if lane == AstExpressionLaneValue() {
            return MirExpressionGraphSlotExpr1();
        }
    }
    if source == "AST_ASSIGNMENT" && kind == "def" {
        if lane == AstExpressionLaneAtom() {
            return MirExpressionGraphSlotExpr1();
        }
        if lane == AstExpressionLaneValue() {
            return MirExpressionGraphSlotExpr0();
        }
    }
    if source == "AST_LET_DECL" && kind == "def" &&
        lane == AstExpressionLaneValue() {
        return MirExpressionGraphSlotExpr0();
    }
    if source == "AST_CALL" && kind == "stmt" {
        if MirProgramInstructionExpressionRoutingEquals(
                json, expression, 1, "ArrayPush") &&
            lane == AstExpressionLaneValue() {
            return MirExpressionGraphSlotExpr0();
        }
        if MirProgramInstructionExpressionRoutingEquals(
            json, expression, 1, "ArraySet"
        ) {
            if lane == AstExpressionLaneValue() {
                return MirExpressionGraphSlotExpr1();
            }
            if lane == AstExpressionLaneAuxiliary() {
                return MirExpressionGraphSlotExpr0();
            }
        }
        if lane == AstExpressionLaneAtom() &&
            !MirProgramInstructionExpressionRoutingEquals(
                json, expression, 1, "ArrayPop") {
            return MirExpressionGraphSlotExpr0();
        }
    }
    if source == "AST_DEFER_STMT" && lane == AstExpressionLaneAtom() {
        return MirExpressionGraphSlotExpr0();
    }
    if kind == "stmt" && lane == AstExpressionLaneAtom() &&
        (MirProgramInstructionExpressionRoutingEquals(
             json, expression, 0, "IntentCheck") ||
         (MirProgramInstructionExpressionRoutingEquals(
              json, expression, 0, "IntentEval") &&
          (MirProgramInstructionExpressionRoutingEquals(
               json, expression, 1, "on") ||
           MirProgramInstructionExpressionRoutingEquals(
               json, expression, 1, "compensate")))) {
        return MirExpressionGraphSlotExpr0();
    }
    if kind == "branch" && lane == AstExpressionLaneAtom() {
        return MirExpressionGraphSlotExpr0();
    }
    if kind == "return" && lane == AstExpressionLaneAtom() {
        return MirExpressionGraphSlotExpr0();
    }
    return MirExpressionGraphSlotNone();
}

func MirExpressionGraphSequenceAppendOccurrence(
    sequence: MirExpressionGraphSequence,
    ref enum_variants: MirProgramEnumVariantIndex,
    instruction: JsonObjectFactTable,
    ref expression: MirProgramInstructionExpressionFact,
    kind: String,
    source: String,
    lane: Int,
    ordinal: Int
) -> MirExpressionGraphSequence {
    if !sequence.ok || !JsonObjectFactTableReady(instruction) ||
        !expression.valid || kind == "" || source == "" ||
        lane < AstExpressionLaneAtom() ||
        lane > AstExpressionLaneAuxiliary() || ordinal < 0 {
        return MirExpressionGraphSequenceError(sequence);
    }
    let expr0_graph: JsonObjectFactTable =
        MirProgramInstructionExpressionGraphTable(
            instruction.json, expression, 0
        );
    if kind == "destructure" {
        if lane != AstExpressionLaneValue() {
            return MirExpressionGraphSequenceError(sequence);
        }
        return MirExpressionGraphSequenceAppendDestructureOccurrence(
            sequence, instruction, expr0_graph, ordinal
        );
    }
    if source == "AST_MATCH_CASE" {
        return MirExpressionGraphSequenceAppendMatchOccurrence(
            sequence, enum_variants, instruction, expr0_graph, lane, ordinal
        );
    }
    let slot: Int = MirExpressionGraphOccurrenceGraphSlot(
        instruction.json, kind, source, expression, lane, ordinal
    );
    if slot == MirExpressionGraphSlotExpr0() &&
        MirInstructionExpressionRequiresExpr0Graph(
            instruction.json, kind, source, expression
        ) {
        return MirExpressionGraphSequenceAppend(sequence, expr0_graph);
    }
    if slot == MirExpressionGraphSlotExpr1() &&
        MirInstructionExpressionRequiresExpr1Graph(
            instruction.json, kind, source, expression
        ) {
        return MirExpressionGraphSequenceAppend(
            sequence, MirProgramInstructionExpressionGraphTable(
                instruction.json, expression, 1
            )
        );
    }
    return MirExpressionGraphSequenceError(sequence);
}
