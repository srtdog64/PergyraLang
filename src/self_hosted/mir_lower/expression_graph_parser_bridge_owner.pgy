// Rebuilds only collection receiver roots absent from the MIR v1 graph slots.

import "expression_graph_sequence_owner.pgy";
import "expression_graph_parser_bridge_row_alignment_owner.pgy";

func MirExpressionGraphSequenceAppendParserBridge(sequence: MirExpressionGraphSequence,
    expression: String
) -> MirExpressionGraphSequence {
    if !sequence.ok || expression == "" {
        return MirExpressionGraphSequenceError(sequence);
    }
    let arena: SemanticExpressionGraphArena = sequence.arena;
    var kinds: Array<Int> = arena.topology.node_kinds;
    var topology_texts: Array<String> = arena.topology.node_texts;
    var texts: Array<String> = arena.node_texts;
    var left_children: Array<Int> = arena.topology.left_children;
    var right_children: Array<Int> = arena.topology.right_children;
    var call_target_kinds: Array<Int> = arena.call_target_kinds;
    var call_target_names: Array<String> = arena.call_target_names;
    var call_return_type_names: Array<String> =
        arena.call_return_type_names;
    var call_target_syntax_ids: Array<Int> =
        arena.identities.call_target_syntax_ids;
    var runtime_call_abi_ids: Array<Int> = arena.identities.runtime_call_abi_ids;
    var binding_syntax_ids: Array<Int> = arena.identities.binding_syntax_ids;
    var binding_kinds: Array<Int> = arena.identities.binding_kinds;
    var binding_ordinals: Array<Int> =
        arena.identities.binding_ordinals;
    var place_kinds: Array<Int> = arena.place_kinds;
    var roots: Array<Int> = sequence.roots;
    let prior_program_call_ordinals: Array<Int> =
        sequence.program_call_ordinals;
    let offset: Int = ArrayLength(kinds);
    var append_ok: Bool = MirExpressionGraphParserBridgeRowsAligned(
        offset, topology_texts, texts, left_children, right_children,
        call_target_kinds, call_target_names, call_return_type_names,
        call_target_syntax_ids, runtime_call_abi_ids, binding_syntax_ids,
        binding_kinds, binding_ordinals, place_kinds);
    var build: SemanticExpressionGraphBuild =
        SemanticExpressionGraphInvalidBuild();
    if append_ok {
        build = SemanticExpressionGraphImportSerializedParserFact(
            kinds, texts, left_children, right_children,
            call_target_kinds, call_target_names, expression
        );
        append_ok = build.ok;
    }
    if append_ok {
        var i: Int = offset;
        while i < ArrayLength(kinds) {
            // The topology keeps its own text rows; an attach grows each of
            // them and owns every String row independently.
            ArrayPushOwnedString(topology_texts, Concat("", texts[i]));
            ArrayPushOwnedString(call_return_type_names, Concat("", ""));
            ArrayPush(call_target_syntax_ids, 0);
            ArrayPush(runtime_call_abi_ids, 0);
            ArrayPush(binding_syntax_ids, 0);
            ArrayPush(binding_kinds, SemanticExpressionBindingNone());
            ArrayPush(binding_ordinals, -1);
            ArrayPush(place_kinds, SemanticExpressionPlaceUnknown());
            i = i + 1;
        }
        ArrayPush(roots, build.root_id);
    }
    let extended: SemanticExpressionGraphArena =
        SemanticExpressionGraphArenaFromTopologyWithIdentities(
            AstExpressionArena(
                kinds, topology_texts, left_children, right_children
            ),
            texts, call_target_kinds, call_target_names,
            call_return_type_names,
            SemanticExpressionIdentityRows(
                call_target_syntax_ids, runtime_call_abi_ids,
                binding_syntax_ids, binding_kinds, binding_ordinals, [], false, 0
            ), place_kinds
        );
    if append_ok {
        append_ok = MirExpressionGraphRangeReachable(
            extended, offset, ArrayLength(kinds) - offset, build.root_id
        );
    }
    // Once the arena fields move out, every path returns their current
    // descriptors.  An invalid result remains unreadable (`ok=false`) but it
    // still owns the one cleanup responsibility; no path reuses `sequence`'s
    // stale pre-growth descriptors.
    var program_call_ordinals: Array<Int> = prior_program_call_ordinals;
    if append_ok {
        program_call_ordinals = [];
    }
    return MirExpressionGraphSequence(
        append_ok, ArrayLength(kinds), roots, extended,
        program_call_ordinals
    );
}
