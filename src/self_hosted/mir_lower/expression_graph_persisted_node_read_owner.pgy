// Reads one persisted expression-graph NODE record out of a JSON fact table.
import "../lib/json_fact_table.pgy";
import "expression_graph_kind_code_owner.pgy";
import "expression_graph_persisted_read_owner.pgy";

struct MirExpressionGraphNodeCapture {
    let valid: Bool;
    let end: Int;
    let kind: Int;
    let text: String;
    let target_kind: Int;
    let target_name: String;
    let call_target_syntax_id: Int;
    let runtime_call_abi_id: Int;
    let binding_kind: Int;
    let has_binding_ordinal: Bool;
    let binding_ordinal: Int;
    let has_left: Bool;
    let left: Int;
    let has_right: Bool;
    let right: Int;
}

func InvalidMirExpressionGraphNodeCapture(
) -> MirExpressionGraphNodeCapture {
    return MirExpressionGraphNodeCapture(
        false, 0 - 1, 0 - 1, "", 0 - 1, "", 0, 0,
        SemanticExpressionBindingNone(), false, 0,
        false, 0, false, 0
    );
}

func MirExpressionGraphNodeCaptureWithin(
    json: String, start: Int, array_end: Int,
    inout string_end_scratch: Array<Int>
) -> MirExpressionGraphNodeCapture {
    if start < 0 || start >= array_end ||
        JsonCharCodeAt(json, array_end, start) != JsonAsciiCode("{") {
        return InvalidMirExpressionGraphNodeCapture();
    }
    let kind: Int = 0 - 1; let text: String = "";
    let target_kind: Int = 0 - 1; let target_name: String = "";
    let call_target_syntax_id: Int = 0; let runtime_call_abi_id: Int = 0;
    let binding_kind: Int = SemanticExpressionBindingNone();
    let has_binding_ordinal: Bool = false; let binding_ordinal: Int = 0;
    let has_left: Bool = false; let left: Int = 0;
    let has_right: Bool = false; let right: Int = 0;
    let kind_seen: Bool = false; let text_seen: Bool = false;
    let target_kind_seen: Bool = false; let target_name_seen: Bool = false;
    let target_syntax_seen: Bool = false; let runtime_call_abi_seen: Bool = false;
    let binding_kind_seen: Bool = false; let binding_ordinal_seen: Bool = false;
    let left_seen: Bool = false; let right_seen: Bool = false;
    let member_count: Int = 0; let expect_member: Bool = true;
    let after_comma: Bool = false;
    let i: Int = start + 1;
    while i < array_end {
        i = JsonSkipWhitespaceWithin(json, i, array_end);
        if i >= array_end {
            return InvalidMirExpressionGraphNodeCapture();
        }
        let c: Int = JsonCharCodeAt(json, array_end, i);
        if c == JsonAsciiCode("}") {
            let legacy: Bool = member_count == 6 && !target_syntax_seen &&
                !binding_kind_seen && !binding_ordinal_seen && !runtime_call_abi_seen;
            let extended: Bool = member_count == 9 && target_syntax_seen &&
                binding_kind_seen && binding_ordinal_seen && !runtime_call_abi_seen;
            let runtime_only: Bool = member_count == 7 && !target_syntax_seen &&
                !binding_kind_seen && !binding_ordinal_seen && runtime_call_abi_seen;
            let complete: Bool = member_count == 10 && target_syntax_seen &&
                binding_kind_seen && binding_ordinal_seen && runtime_call_abi_seen;
            if after_comma ||
                (!legacy && !extended && !runtime_only && !complete) ||
                !kind_seen ||
                !text_seen || !target_kind_seen || !target_name_seen ||
                !left_seen || !right_seen {
                return InvalidMirExpressionGraphNodeCapture();
            }
            if !legacy && ((call_target_syntax_id > 0 &&
                    target_kind != SemanticCallTargetDirect() &&
                    target_kind != SemanticCallTargetNamespace()) ||
                (target_kind == SemanticCallTargetNone() &&
                    (call_target_syntax_id != 0 ||
                     runtime_call_abi_id != 0)) ||
                (runtime_call_abi_id > 0 &&
                    (target_kind != SemanticCallTargetDirect() ||
                     call_target_syntax_id != 0)) ||
                (binding_kind == SemanticExpressionBindingNone() &&
                    has_binding_ordinal) ||
                (binding_kind == SemanticExpressionBindingFormalParameter() &&
                    !has_binding_ordinal) ||
                (binding_kind != SemanticExpressionBindingNone() &&
                    binding_kind !=
                        SemanticExpressionBindingFormalParameter())) {
                return InvalidMirExpressionGraphNodeCapture();
            }
            return MirExpressionGraphNodeCapture(
                true, i + 1, kind, text, target_kind, target_name,
                call_target_syntax_id, runtime_call_abi_id, binding_kind,
                has_binding_ordinal, binding_ordinal,
                has_left, left, has_right, right
            );
        }
        if !expect_member {
            if c != JsonAsciiCode(",") {
                return InvalidMirExpressionGraphNodeCapture();
            }
            expect_member = true;
            after_comma = true;
            i = i + 1;
            continue;
        }
        if c != JsonAsciiCode("\"") {
            return InvalidMirExpressionGraphNodeCapture();
        }
        let key_end_opt: Option<Int> = JsonStringEndWithin(
            json, i, array_end
        );
        if !IsSome(key_end_opt) {
            return InvalidMirExpressionGraphNodeCapture();
        }
        let key_end: Int = UnwrapOption(key_end_opt);
        let field_kind: Int = 0;
        if JsonObjectKeyEqualsWithin(json, i, key_end, "kind") {
            field_kind = 1;
        } else if JsonObjectKeyEqualsWithin(json, i, key_end, "text") {
            field_kind = 2;
        } else if JsonObjectKeyEqualsWithin(
            json, i, key_end, "call_target_kind") {
            field_kind = 3;
        } else if JsonObjectKeyEqualsWithin(
            json, i, key_end, "call_target_name") {
            field_kind = 4;
        } else if JsonObjectKeyEqualsWithin(
            json, i, key_end, "call_target_syntax_id") {
            field_kind = 7;
        } else if JsonObjectKeyEqualsWithin(
            json, i, key_end, "runtime_call_abi_id") {
            field_kind = 10;
        } else if JsonObjectKeyEqualsWithin(
            json, i, key_end, "binding_kind") {
            field_kind = 8;
        } else if JsonObjectKeyEqualsWithin(
            json, i, key_end, "binding_ordinal") {
            field_kind = 9;
        } else if JsonObjectKeyEqualsWithin(json, i, key_end, "left") {
            field_kind = 5;
        } else if JsonObjectKeyEqualsWithin(json, i, key_end, "right") {
            field_kind = 6;
        }
        if field_kind == 0 {
            return InvalidMirExpressionGraphNodeCapture();
        }
        i = JsonSkipWhitespaceWithin(json, key_end, array_end);
        if i >= array_end ||
            JsonCharCodeAt(json, array_end, i) != JsonAsciiCode(":") {
            return InvalidMirExpressionGraphNodeCapture();
        }
        i = JsonSkipWhitespaceWithin(json, i + 1, array_end);
        let value_end_opt: Option<Int> = JsonValueEndWithin(
            json, i, array_end
        );
        if !IsSome(value_end_opt) {
            return InvalidMirExpressionGraphNodeCapture();
        }
        let value_end: Int = UnwrapOption(value_end_opt);
        if field_kind == 1 {
            if kind_seen { return InvalidMirExpressionGraphNodeCapture(); }
            let value: Option<Int> = MirExpressionGraphKindCodeWithin(
                json, i, value_end
            );
            if !IsSome(value) {
                return InvalidMirExpressionGraphNodeCapture();
            }
            kind = UnwrapOption(value);
            kind_seen = true;
        } else if field_kind == 3 {
            if target_kind_seen {
                return InvalidMirExpressionGraphNodeCapture();
            }
            let value: Option<Int> = MirExpressionCallTargetKindCodeWithin(
                json, i, value_end
            );
            if !IsSome(value) {
                return InvalidMirExpressionGraphNodeCapture();
            }
            target_kind = UnwrapOption(value);
            target_kind_seen = true;
        } else if field_kind == 8 {
            if binding_kind_seen {
                return InvalidMirExpressionGraphNodeCapture();
            }
            let value: Option<Int> = MirExpressionBindingKindCodeWithin(
                json, i, value_end
            );
            if !IsSome(value) {
                return InvalidMirExpressionGraphNodeCapture();
            }
            binding_kind = UnwrapOption(value);
            binding_kind_seen = true;
        } else if field_kind == 2 || field_kind == 4 {
            if JsonValueKindAt(json, i, value_end) != "string" ||
                (field_kind == 2 && text_seen) ||
                (field_kind == 4 && target_name_seen) {
                return InvalidMirExpressionGraphNodeCapture();
            }
            ArraySet(string_end_scratch, 0, 0);
            let value: String = ReadJsonStringBounded(
                json, i, value_end, string_end_scratch
            );
            if string_end_scratch[0] != value_end {
                return InvalidMirExpressionGraphNodeCapture();
            }
            if field_kind == 2 { text = value; text_seen = true; }
            if field_kind == 4 {
                target_name = value;
                target_name_seen = true;
            }
        } else if field_kind == 7 {
            if target_syntax_seen ||
                JsonValueKindAt(json, i, value_end) != "number" {
                return InvalidMirExpressionGraphNodeCapture();
            }
            let value: Option<Int> = MirExpressionGraphIndexWithin(
                json, i, value_end
            );
            if !IsSome(value) {
                return InvalidMirExpressionGraphNodeCapture();
            }
            call_target_syntax_id = UnwrapOption(value);
            target_syntax_seen = true;
        } else if field_kind == 10 {
            if runtime_call_abi_seen ||
                JsonValueKindAt(json, i, value_end) != "number" {
                return InvalidMirExpressionGraphNodeCapture();
            }
            let value: Option<Int> = MirExpressionGraphIndexWithin(
                json, i, value_end);
            if !IsSome(value) {
                return InvalidMirExpressionGraphNodeCapture();
            }
            runtime_call_abi_id = UnwrapOption(value);
            runtime_call_abi_seen = true;
        } else if field_kind == 9 {
            if binding_ordinal_seen {
                return InvalidMirExpressionGraphNodeCapture();
            }
            let value_kind: String = JsonValueKindAt(json, i, value_end);
            if value_kind == "number" {
                let value: Option<Int> = MirExpressionGraphIndexWithin(
                    json, i, value_end
                );
                if !IsSome(value) {
                    return InvalidMirExpressionGraphNodeCapture();
                }
                has_binding_ordinal = true;
                binding_ordinal = UnwrapOption(value);
            } else if value_kind != "null" {
                return InvalidMirExpressionGraphNodeCapture();
            }
            binding_ordinal_seen = true;
        } else {
            if (field_kind == 5 && left_seen) ||
                (field_kind == 6 && right_seen) {
                return InvalidMirExpressionGraphNodeCapture();
            }
            let value_kind: String = JsonValueKindAt(
                json, i, value_end
            );
            let present: Bool = false;
            let child: Int = 0;
            if value_kind == "number" {
                let child_opt: Option<Int> = MirExpressionGraphIndexWithin(
                    json, i, value_end
                );
                if !IsSome(child_opt) {
                    return InvalidMirExpressionGraphNodeCapture();
                }
                child = UnwrapOption(child_opt);
                present = true;
            } else if value_kind != "null" {
                return InvalidMirExpressionGraphNodeCapture();
            }
            if field_kind == 5 {
                has_left = present;
                left = child;
                left_seen = true;
            } else {
                has_right = present;
                right = child;
                right_seen = true;
            }
        }
        member_count = member_count + 1;
        i = value_end;
        expect_member = false;
        after_comma = false;
    }
    return InvalidMirExpressionGraphNodeCapture();
}
