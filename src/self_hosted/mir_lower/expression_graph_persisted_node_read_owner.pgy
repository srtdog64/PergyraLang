// Reads one persisted expression-graph NODE record out of a JSON fact table.
import "../lib/json_fact_table.pgy";
import "expression_graph_kind_code_owner.pgy";
import "expression_graph_persisted_read_owner.pgy";
import "expression_graph_persisted_node_identity_owner.pgy";

struct MirExpressionGraphNodeCapture {
    let valid: Bool;
    let end: Int;
    let kind: Int;
    let text: String;
    let target_kind: Int;
    let target_name: String;
    let call_target_syntax_id: Int;
    let runtime_call_abi_id: Int;
    let binding_syntax_id: Int;
    let binding_kind: Int;
    let has_binding_ordinal: Bool;
    let binding_ordinal: Int;
    let has_left: Bool;
    let left: Int;
    let has_right: Bool;
    let right: Int;
}

func InvalidMirExpressionGraphNodeCapture(
) -> MirExpressionGraphNodeCapture {
    return MirExpressionGraphNodeCapture(
        false, 0 - 1, 0 - 1, "", 0 - 1, "", 0, 0, 0,
        SemanticExpressionBindingNone(), false, 0,
        false, 0, false, 0
    );
}

func MirExpressionGraphNodeCaptureWithin(
    json: String, json_extent: Int, start: Int, array_end: Int,
    inout string_end_scratch: Array<Int>
) -> MirExpressionGraphNodeCapture {
    if start < 0 || start >= array_end ||
        JsonCharCodeAt(json, json_extent, array_end, start) != JsonAsciiCode("{") {
        return InvalidMirExpressionGraphNodeCapture();
    }
    var kind: Int = 0 - 1; var text: String = "";
    var target_kind: Int = 0 - 1; var target_name: String = "";
    var call_target_syntax_id: Int = 0; var runtime_call_abi_id: Int = 0; var binding_syntax_id: Int = 0;
    var binding_kind: Int = SemanticExpressionBindingNone();
    var has_binding_ordinal: Bool = false; var binding_ordinal: Int = 0;
    var has_left: Bool = false; var left: Int = 0;
    var has_right: Bool = false; var right: Int = 0;
    var kind_seen: Bool = false; var text_seen: Bool = false;
    var target_kind_seen: Bool = false; var target_name_seen: Bool = false;
    var target_syntax_seen: Bool = false; var runtime_call_abi_seen: Bool = false; var binding_syntax_seen: Bool = false;
    var binding_kind_seen: Bool = false; var binding_ordinal_seen: Bool = false; var source_binding_seen: Bool = false; var source_binding: Int = 0;
    var left_seen: Bool = false; var right_seen: Bool = false;
    var member_count: Int = 0; var expect_member: Bool = true;
    var after_comma: Bool = false;
    var i: Int = start + 1;
    while i < array_end {
        i = JsonSkipWhitespaceWithin(json, json_extent, i, array_end);
        if i >= array_end {
            return InvalidMirExpressionGraphNodeCapture();
        }
        let c: Int = JsonCharCodeAt(json, json_extent, array_end, i);
        if c == JsonAsciiCode("}") {
            let legacy: Bool = member_count == 6 && !target_syntax_seen &&
                !binding_kind_seen && !binding_ordinal_seen && !runtime_call_abi_seen;
            let extended: Bool = member_count == 9 && target_syntax_seen &&
                binding_kind_seen && binding_ordinal_seen && !runtime_call_abi_seen;
            let runtime_only: Bool = member_count == 7 && !target_syntax_seen &&
                !binding_kind_seen && !binding_ordinal_seen && runtime_call_abi_seen;
            let complete: Bool = (member_count == 11 || member_count == 12) && target_syntax_seen &&
                runtime_call_abi_seen && binding_syntax_seen &&
                binding_kind_seen && binding_ordinal_seen;
            if after_comma ||
                (!legacy && !extended && !runtime_only && !complete) ||
                !kind_seen ||
                !text_seen || !target_kind_seen || !target_name_seen ||
                !left_seen || !right_seen {
                return InvalidMirExpressionGraphNodeCapture();
            }
            // Cleanup/proof consumes native identity; AST reissues it separately from formal binding.
            if source_binding > 0 && kind != AstExpressionNodeLeaf() { return InvalidMirExpressionGraphNodeCapture(); }
            if !legacy && !MirExpressionGraphPersistedNodeIdentityReady(
                kind, target_kind, call_target_syntax_id,
                runtime_call_abi_id, binding_syntax_id, binding_kind,
                has_binding_ordinal
            ) {
                return InvalidMirExpressionGraphNodeCapture();
            }
            return MirExpressionGraphNodeCapture(
                true, i + 1, kind, text, target_kind, target_name,
                call_target_syntax_id, runtime_call_abi_id,
                binding_syntax_id, binding_kind,
                has_binding_ordinal, binding_ordinal,
                has_left, left, has_right, right
            );
        }
        if !expect_member {
            if c != JsonAsciiCode(",") {
                return InvalidMirExpressionGraphNodeCapture();
            }
            expect_member = true;
            after_comma = true;
            i = i + 1;
            continue;
        }
        if c != JsonAsciiCode("\"") {
            return InvalidMirExpressionGraphNodeCapture();
        }
        let key_end_opt: Option<Int> = JsonStringEndWithin(
            json, json_extent, i, array_end
        );
        if !IsSome(key_end_opt) {
            return InvalidMirExpressionGraphNodeCapture();
        }
        let key_end: Int = UnwrapOption(key_end_opt);
        var field_kind: Int = 0;
        if JsonObjectKeyEqualsWithin(json, json_extent, i, key_end, "kind") {
            field_kind = 1;
        } else if JsonObjectKeyEqualsWithin(json, json_extent, i, key_end, "text") {
            field_kind = 2;
        } else if JsonObjectKeyEqualsWithin(
            json, json_extent, i, key_end, "call_target_kind") {
            field_kind = 3;
        } else if JsonObjectKeyEqualsWithin(
            json, json_extent, i, key_end, "call_target_name") {
            field_kind = 4;
        } else if JsonObjectKeyEqualsWithin(
            json, json_extent, i, key_end, "call_target_syntax_id") {
            field_kind = 7;
        } else if JsonObjectKeyEqualsWithin(
            json, json_extent, i, key_end, "runtime_call_abi_id") {
            field_kind = 10;
        } else if JsonObjectKeyEqualsWithin(
            json, json_extent, i, key_end, "binding_kind") {
            field_kind = 8;
        } else if JsonObjectKeyEqualsWithin(json, json_extent, i, key_end, "binding_syntax_id") {
            field_kind = 11;
        } else if JsonObjectKeyEqualsWithin(json, json_extent, i, key_end, "source_binding_syntax_id") { field_kind = 12;
        } else if JsonObjectKeyEqualsWithin(
            json, json_extent, i, key_end, "binding_ordinal") {
            field_kind = 9;
        } else if JsonObjectKeyEqualsWithin(json, json_extent, i, key_end, "left") {
            field_kind = 5;
        } else if JsonObjectKeyEqualsWithin(json, json_extent, i, key_end, "right") {
            field_kind = 6;
        }
        if field_kind == 0 {
            return InvalidMirExpressionGraphNodeCapture();
        }
        i = JsonSkipWhitespaceWithin(json, json_extent, key_end, array_end);
        if i >= array_end ||
            JsonCharCodeAt(json, json_extent, array_end, i) != JsonAsciiCode(":") {
            return InvalidMirExpressionGraphNodeCapture();
        }
        i = JsonSkipWhitespaceWithin(json, json_extent, i + 1, array_end);
        let value_end_opt: Option<Int> = JsonValueEndWithin(
            json, json_extent, i, array_end
        );
        if !IsSome(value_end_opt) {
            return InvalidMirExpressionGraphNodeCapture();
        }
        let value_end: Int = UnwrapOption(value_end_opt);
        if field_kind == 1 {
            if kind_seen { return InvalidMirExpressionGraphNodeCapture(); }
            let value: Option<Int> = MirExpressionGraphKindCodeWithin(
                json, json_extent, i, value_end
            );
            if !IsSome(value) {
                return InvalidMirExpressionGraphNodeCapture();
            }
            kind = UnwrapOption(value);
            kind_seen = true;
        } else if field_kind == 3 {
            if target_kind_seen {
                return InvalidMirExpressionGraphNodeCapture();
            }
            let value: Option<Int> = MirExpressionCallTargetKindCodeWithin(
                json, json_extent, i, value_end
            );
            if !IsSome(value) {
                return InvalidMirExpressionGraphNodeCapture();
            }
            target_kind = UnwrapOption(value);
            target_kind_seen = true;
        } else if field_kind == 8 {
            if binding_kind_seen {
                return InvalidMirExpressionGraphNodeCapture();
            }
            let value: Option<Int> = MirExpressionBindingKindCodeWithin(
                json, json_extent, i, value_end
            );
            if !IsSome(value) {
                return InvalidMirExpressionGraphNodeCapture();
            }
            binding_kind = UnwrapOption(value);
            binding_kind_seen = true;
        } else if field_kind == 2 || field_kind == 4 {
            if JsonValueKindAt(json, json_extent, i, value_end) != "string" ||
                (field_kind == 2 && text_seen) ||
                (field_kind == 4 && target_name_seen) {
                return InvalidMirExpressionGraphNodeCapture();
            }
            let decoded: Option<String> = JsonStringValueSpanning(json, json_extent, i, value_end);
            if !IsSome(decoded) {
                return InvalidMirExpressionGraphNodeCapture();
            }
            let value: String = UnwrapOption(decoded);
            if field_kind == 2 { text = value; text_seen = true; }
            if field_kind == 4 {
                target_name = value;
                target_name_seen = true;
            }
        } else if field_kind == 7 {
            if target_syntax_seen { return InvalidMirExpressionGraphNodeCapture(); }
            let value: Option<Int> =
                MirExpressionGraphPersistedNodeIdentityValueWithin(
                json, json_extent, i, value_end
            );
            if !IsSome(value) {
                return InvalidMirExpressionGraphNodeCapture();
            }
            call_target_syntax_id = UnwrapOption(value);
            target_syntax_seen = true;
        } else if field_kind == 10 || field_kind == 12 {
            if (field_kind == 10 && runtime_call_abi_seen) ||
                (field_kind == 12 && source_binding_seen) { return InvalidMirExpressionGraphNodeCapture(); }
            let value: Option<Int> =
                MirExpressionGraphPersistedNodeIdentityValueWithin(
                    json, json_extent, i, value_end);
            if !IsSome(value) { return InvalidMirExpressionGraphNodeCapture(); }
            if field_kind == 10 { runtime_call_abi_id = UnwrapOption(value); runtime_call_abi_seen = true; }
            else { source_binding = UnwrapOption(value); source_binding_seen = true; }
        } else if field_kind == 11 {
            if binding_syntax_seen { return InvalidMirExpressionGraphNodeCapture(); }
            let value: Option<Int> =
                MirExpressionGraphPersistedNodeIdentityValueWithin(
                    json, json_extent, i, value_end);
            if !IsSome(value) {
                return InvalidMirExpressionGraphNodeCapture();
            }
            binding_syntax_id = UnwrapOption(value);
            binding_syntax_seen = true;
        } else if field_kind == 9 {
            if binding_ordinal_seen {
                return InvalidMirExpressionGraphNodeCapture();
            }
            let value_kind: String = JsonValueKindAt(json, json_extent, i, value_end);
            if value_kind == "number" {
                let value: Option<Int> = MirExpressionGraphIndexWithin(
                    json, json_extent, i, value_end
                );
                if !IsSome(value) {
                    return InvalidMirExpressionGraphNodeCapture();
                }
                has_binding_ordinal = true;
                binding_ordinal = UnwrapOption(value);
            } else if value_kind != "null" {
                return InvalidMirExpressionGraphNodeCapture();
            }
            binding_ordinal_seen = true;
        } else {
            if (field_kind == 5 && left_seen) ||
                (field_kind == 6 && right_seen) {
                return InvalidMirExpressionGraphNodeCapture();
            }
            let value_kind: String = JsonValueKindAt(
                json, json_extent, i, value_end
            );
            var present: Bool = false;
            var child: Int = 0;
            if value_kind == "number" {
                let child_opt: Option<Int> = MirExpressionGraphIndexWithin(
                    json, json_extent, i, value_end
                );
                if !IsSome(child_opt) {
                    return InvalidMirExpressionGraphNodeCapture();
                }
                child = UnwrapOption(child_opt);
                present = true;
            } else if value_kind != "null" {
                return InvalidMirExpressionGraphNodeCapture();
            }
            if field_kind == 5 {
                has_left = present;
                left = child;
                left_seen = true;
            } else {
                has_right = present;
                right = child;
                right_seen = true;
            }
        }
        member_count = member_count + 1;
        i = value_end;
        expect_member = false;
        after_comma = false;
    }
    return InvalidMirExpressionGraphNodeCapture();
}
