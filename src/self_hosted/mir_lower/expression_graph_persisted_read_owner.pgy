// One-pass persisted MIR expression-graph reader.
//
// The admitted instruction span already owns JSON object boundaries. This
// reader validates the exact persisted graph and node shapes while capturing
// their fields in one pass, instead of rescanning every object once per field.

import "../lib/json_fact_table.pgy";

func MirExpressionGraphIndexWithin(
    json: String, start: Int, end: Int
) -> Option<Int> {
    let i: Int = JsonSkipWhitespaceWithin(json, start, end);
    if i >= end { return None; }
    let zero: Int = JsonAsciiCode("0");
    let first: Int = JsonCharCodeAt(json, end, i);
    if !JsonIsDigitCode(first) || (first == zero && i + 1 != end) {
        return None;
    }
    let value: Int = 0;
    let cursor: Int = i;
    while cursor < end {
        let code: Int = JsonCharCodeAt(json, end, cursor);
        if !JsonIsDigitCode(code) { return None; }
        let digit: Int = code - zero;
        if value > (2147483647 - digit) / 10 { return None; }
        value = value * 10 + digit;
        cursor = cursor + 1;
    }
    return Some(value);
}

struct MirExpressionGraphHeaderCapture {
    let valid: Bool;
    let root: Int;
    let nodes_start: Int;
    let nodes_end: Int;
}

func InvalidMirExpressionGraphHeaderCapture(
) -> MirExpressionGraphHeaderCapture {
    return MirExpressionGraphHeaderCapture(false, 0, 0 - 1, 0 - 1);
}

func MirExpressionGraphHeaderCaptureFromTable(
    ref graph: JsonObjectFactTable
) -> MirExpressionGraphHeaderCapture {
    if !JsonObjectFactTableReady(graph) ||
        JsonCharCodeAt(graph.json, graph.end, graph.start) !=
            JsonAsciiCode("{") {
        return InvalidMirExpressionGraphHeaderCapture();
    }
    let root: Int = 0;
    let nodes_start: Int = 0 - 1;
    let nodes_end: Int = 0 - 1;
    let root_seen: Bool = false;
    let nodes_seen: Bool = false;
    let digest_seen: Bool = false;
    let member_count: Int = 0;
    let expect_member: Bool = true;
    let after_comma: Bool = false;
    let i: Int = graph.start + 1;
    while i < graph.end {
        i = JsonSkipWhitespaceWithin(graph.json, i, graph.end);
        if i >= graph.end {
            return InvalidMirExpressionGraphHeaderCapture();
        }
        let c: Int = JsonCharCodeAt(graph.json, graph.end, i);
        if c == JsonAsciiCode("}") {
            if after_comma || !root_seen || !nodes_seen ||
                (member_count != 2 && member_count != 3) ||
                (member_count == 3 && !digest_seen) {
                return InvalidMirExpressionGraphHeaderCapture();
            }
            return MirExpressionGraphHeaderCapture(
                true, root, nodes_start, nodes_end
            );
        }
        if !expect_member {
            if c != JsonAsciiCode(",") {
                return InvalidMirExpressionGraphHeaderCapture();
            }
            expect_member = true;
            after_comma = true;
            i = i + 1;
            continue;
        }
        if c != JsonAsciiCode("\"") {
            return InvalidMirExpressionGraphHeaderCapture();
        }
        let key_end_opt: Option<Int> = JsonStringEndWithin(
            graph.json, i, graph.end
        );
        if !IsSome(key_end_opt) {
            return InvalidMirExpressionGraphHeaderCapture();
        }
        let key_end: Int = UnwrapOption(key_end_opt);
        let field_kind: Int = 0;
        if JsonObjectKeyEqualsWithin(graph.json, i, key_end, "root") {
            field_kind = 1;
        } else if JsonObjectKeyEqualsWithin(
            graph.json, i, key_end, "nodes"
        ) {
            field_kind = 2;
        } else if JsonObjectKeyEqualsWithin(
            graph.json, i, key_end, "digest"
        ) {
            field_kind = 3;
        }
        if field_kind == 0 {
            return InvalidMirExpressionGraphHeaderCapture();
        }
        i = JsonSkipWhitespaceWithin(graph.json, key_end, graph.end);
        if i >= graph.end ||
            JsonCharCodeAt(graph.json, graph.end, i) != JsonAsciiCode(":") {
            return InvalidMirExpressionGraphHeaderCapture();
        }
        i = JsonSkipWhitespaceWithin(graph.json, i + 1, graph.end);
        let value_end_opt: Option<Int> = JsonValueEndWithin(
            graph.json, i, graph.end
        );
        if !IsSome(value_end_opt) {
            return InvalidMirExpressionGraphHeaderCapture();
        }
        let value_end: Int = UnwrapOption(value_end_opt);
        if field_kind == 1 {
            if root_seen || JsonValueKindAt(graph.json, i, value_end) !=
                    "number" {
                return InvalidMirExpressionGraphHeaderCapture();
            }
            let root_opt: Option<Int> = MirExpressionGraphIndexWithin(
                graph.json, i, value_end
            );
            if !IsSome(root_opt) {
                return InvalidMirExpressionGraphHeaderCapture();
            }
            root = UnwrapOption(root_opt);
            root_seen = true;
        } else if field_kind == 2 {
            if nodes_seen || JsonValueKindAt(graph.json, i, value_end) !=
                    "array" {
                return InvalidMirExpressionGraphHeaderCapture();
            }
            nodes_start = i;
            nodes_end = value_end;
            nodes_seen = true;
        } else {
            if digest_seen || JsonValueKindAt(graph.json, i, value_end) !=
                    "number" {
                return InvalidMirExpressionGraphHeaderCapture();
            }
            let digest_opt: Option<Int> = MirExpressionGraphIndexWithin(
                graph.json, i, value_end
            );
            if !IsSome(digest_opt) || UnwrapOption(digest_opt) <= 0 {
                return InvalidMirExpressionGraphHeaderCapture();
            }
            digest_seen = true;
        }
        member_count = member_count + 1;
        i = value_end;
        expect_member = false;
        after_comma = false;
    }
    return InvalidMirExpressionGraphHeaderCapture();
}

struct MirExpressionGraphNodeCapture {
    let valid: Bool;
    let end: Int;
    let kind: String;
    let text: String;
    let target_kind: String;
    let target_name: String;
    let call_target_syntax_id: Int;
    let binding_kind: String;
    let has_binding_ordinal: Bool;
    let binding_ordinal: Int;
    let has_left: Bool;
    let left: Int;
    let has_right: Bool;
    let right: Int;
}

func InvalidMirExpressionGraphNodeCapture(
) -> MirExpressionGraphNodeCapture {
    return MirExpressionGraphNodeCapture(
        false, 0 - 1, "", "", "", "", 0, "none", false, 0,
        false, 0, false, 0
    );
}

func MirExpressionGraphNodeCaptureWithin(
    json: String, start: Int, array_end: Int
) -> MirExpressionGraphNodeCapture {
    if start < 0 || start >= array_end ||
        JsonCharCodeAt(json, array_end, start) != JsonAsciiCode("{") {
        return InvalidMirExpressionGraphNodeCapture();
    }
    let kind: String = "";
    let text: String = "";
    let target_kind: String = "";
    let target_name: String = "";
    let call_target_syntax_id: Int = 0;
    let binding_kind: String = "none";
    let has_binding_ordinal: Bool = false;
    let binding_ordinal: Int = 0;
    let has_left: Bool = false;
    let left: Int = 0;
    let has_right: Bool = false;
    let right: Int = 0;
    let kind_seen: Bool = false;
    let text_seen: Bool = false;
    let target_kind_seen: Bool = false;
    let target_name_seen: Bool = false;
    let target_syntax_seen: Bool = false;
    let binding_kind_seen: Bool = false;
    let binding_ordinal_seen: Bool = false;
    let left_seen: Bool = false;
    let right_seen: Bool = false;
    let member_count: Int = 0;
    let expect_member: Bool = true;
    let after_comma: Bool = false;
    let i: Int = start + 1;
    while i < array_end {
        i = JsonSkipWhitespaceWithin(json, i, array_end);
        if i >= array_end {
            return InvalidMirExpressionGraphNodeCapture();
        }
        let c: Int = JsonCharCodeAt(json, array_end, i);
        if c == JsonAsciiCode("}") {
            let legacy: Bool = member_count == 6 &&
                !target_syntax_seen && !binding_kind_seen &&
                !binding_ordinal_seen;
            let extended: Bool = member_count == 9 &&
                target_syntax_seen && binding_kind_seen &&
                binding_ordinal_seen;
            if after_comma || (!legacy && !extended) || !kind_seen ||
                !text_seen || !target_kind_seen || !target_name_seen ||
                !left_seen || !right_seen {
                return InvalidMirExpressionGraphNodeCapture();
            }
            if extended && ((call_target_syntax_id > 0 &&
                    target_kind != "direct") ||
                (target_kind == "none" && call_target_syntax_id != 0) ||
                (binding_kind == "none" && has_binding_ordinal) ||
                (binding_kind == "formal_parameter" &&
                    !has_binding_ordinal) ||
                (binding_kind != "none" &&
                    binding_kind != "formal_parameter")) {
                return InvalidMirExpressionGraphNodeCapture();
            }
            return MirExpressionGraphNodeCapture(
                true, i + 1, kind, text, target_kind, target_name,
                call_target_syntax_id, binding_kind,
                has_binding_ordinal, binding_ordinal,
                has_left, left, has_right, right
            );
        }
        if !expect_member {
            if c != JsonAsciiCode(",") {
                return InvalidMirExpressionGraphNodeCapture();
            }
            expect_member = true;
            after_comma = true;
            i = i + 1;
            continue;
        }
        if c != JsonAsciiCode("\"") {
            return InvalidMirExpressionGraphNodeCapture();
        }
        let key_end_opt: Option<Int> = JsonStringEndWithin(
            json, i, array_end
        );
        if !IsSome(key_end_opt) {
            return InvalidMirExpressionGraphNodeCapture();
        }
        let key_end: Int = UnwrapOption(key_end_opt);
        let field_kind: Int = 0;
        if JsonObjectKeyEqualsWithin(json, i, key_end, "kind") {
            field_kind = 1;
        } else if JsonObjectKeyEqualsWithin(
            json, i, key_end, "text"
        ) {
            field_kind = 2;
        } else if JsonObjectKeyEqualsWithin(
            json, i, key_end, "call_target_kind"
        ) {
            field_kind = 3;
        } else if JsonObjectKeyEqualsWithin(
            json, i, key_end, "call_target_name"
        ) {
            field_kind = 4;
        } else if JsonObjectKeyEqualsWithin(
            json, i, key_end, "call_target_syntax_id"
        ) {
            field_kind = 7;
        } else if JsonObjectKeyEqualsWithin(
            json, i, key_end, "binding_kind"
        ) {
            field_kind = 8;
        } else if JsonObjectKeyEqualsWithin(
            json, i, key_end, "binding_ordinal"
        ) {
            field_kind = 9;
        } else if JsonObjectKeyEqualsWithin(
            json, i, key_end, "left"
        ) {
            field_kind = 5;
        } else if JsonObjectKeyEqualsWithin(
            json, i, key_end, "right"
        ) {
            field_kind = 6;
        }
        if field_kind == 0 {
            return InvalidMirExpressionGraphNodeCapture();
        }
        i = JsonSkipWhitespaceWithin(json, key_end, array_end);
        if i >= array_end ||
            JsonCharCodeAt(json, array_end, i) != JsonAsciiCode(":") {
            return InvalidMirExpressionGraphNodeCapture();
        }
        i = JsonSkipWhitespaceWithin(json, i + 1, array_end);
        let value_end_opt: Option<Int> = JsonValueEndWithin(
            json, i, array_end
        );
        if !IsSome(value_end_opt) {
            return InvalidMirExpressionGraphNodeCapture();
        }
        let value_end: Int = UnwrapOption(value_end_opt);
        if field_kind <= 4 || field_kind == 8 {
            if JsonValueKindAt(json, i, value_end) != "string" ||
                (field_kind == 1 && kind_seen) ||
                (field_kind == 2 && text_seen) ||
                (field_kind == 3 && target_kind_seen) ||
                (field_kind == 4 && target_name_seen) ||
                (field_kind == 8 && binding_kind_seen) {
                return InvalidMirExpressionGraphNodeCapture();
            }
            let decoded_end: Array<Int> = [0];
            let value: String = ReadJsonStringBounded(
                json, i, value_end, decoded_end
            );
            if decoded_end[0] != value_end {
                return InvalidMirExpressionGraphNodeCapture();
            }
            if field_kind == 1 { kind = value; kind_seen = true; }
            if field_kind == 2 { text = value; text_seen = true; }
            if field_kind == 3 {
                target_kind = value;
                target_kind_seen = true;
            }
            if field_kind == 4 {
                target_name = value;
                target_name_seen = true;
            }
            if field_kind == 8 {
                binding_kind = value;
                binding_kind_seen = true;
            }
        } else if field_kind == 7 {
            if target_syntax_seen ||
                JsonValueKindAt(json, i, value_end) != "number" {
                return InvalidMirExpressionGraphNodeCapture();
            }
            let value: Option<Int> = MirExpressionGraphIndexWithin(
                json, i, value_end
            );
            if !IsSome(value) {
                return InvalidMirExpressionGraphNodeCapture();
            }
            call_target_syntax_id = UnwrapOption(value);
            target_syntax_seen = true;
        } else if field_kind == 9 {
            if binding_ordinal_seen {
                return InvalidMirExpressionGraphNodeCapture();
            }
            let value_kind: String = JsonValueKindAt(json, i, value_end);
            if value_kind == "number" {
                let value: Option<Int> = MirExpressionGraphIndexWithin(
                    json, i, value_end
                );
                if !IsSome(value) {
                    return InvalidMirExpressionGraphNodeCapture();
                }
                has_binding_ordinal = true;
                binding_ordinal = UnwrapOption(value);
            } else if value_kind != "null" {
                return InvalidMirExpressionGraphNodeCapture();
            }
            binding_ordinal_seen = true;
        } else {
            if (field_kind == 5 && left_seen) ||
                (field_kind == 6 && right_seen) {
                return InvalidMirExpressionGraphNodeCapture();
            }
            let value_kind: String = JsonValueKindAt(
                json, i, value_end
            );
            let present: Bool = false;
            let child: Int = 0;
            if value_kind == "number" {
                let child_opt: Option<Int> = MirExpressionGraphIndexWithin(
                    json, i, value_end
                );
                if !IsSome(child_opt) {
                    return InvalidMirExpressionGraphNodeCapture();
                }
                child = UnwrapOption(child_opt);
                present = true;
            } else if value_kind != "null" {
                return InvalidMirExpressionGraphNodeCapture();
            }
            if field_kind == 5 {
                has_left = present;
                left = child;
                left_seen = true;
            } else {
                has_right = present;
                right = child;
                right_seen = true;
            }
        }
        member_count = member_count + 1;
        i = value_end;
        expect_member = false;
        after_comma = false;
    }
    return InvalidMirExpressionGraphNodeCapture();
}
