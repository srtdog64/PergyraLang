// MIR JSON expression graph sequence construction.

import "../lib/json_fact_table.pgy";
import "../semantic/ast_expression_surface_fact_owner.pgy";
import "../semantic/role_operator_vocabulary_owner.pgy";
import "expression_graph_persisted_shape_owner.pgy";
import "expression_graph_persisted_read_owner.pgy";
struct MirExpressionGraphSequence {
    ok: Bool;
    ready_node_count: Int;
    roots: Array<Int>;
    arena: SemanticExpressionGraphArena;
}

func MirExpressionGraphSequenceEmpty() -> MirExpressionGraphSequence {
    let roots: Array<Int> = [];
    return MirExpressionGraphSequence(
        true, 0, roots, SemanticExpressionGraphArenaEmpty()
    );
}

func MirExpressionGraphSequenceError(
    sequence: MirExpressionGraphSequence
) -> MirExpressionGraphSequence {
    return MirExpressionGraphSequence(
        false, sequence.ready_node_count, sequence.roots, sequence.arena
    );
}

func MirExpressionGraphKindCode(kind: String) -> Option<Int> {
    if kind == "leaf" { return Some(AstExpressionNodeLeaf()); }
    if kind == "logical_or" { return Some(AstExpressionNodeLogicalOr()); }
    if kind == "logical_and" { return Some(AstExpressionNodeLogicalAnd()); }
    if kind == "equality" { return Some(AstExpressionNodeEquality()); }
    if kind == "inequality" { return Some(AstExpressionNodeInequality()); }
    if kind == "less" { return Some(AstExpressionNodeLess()); }
    if kind == "less_equal" { return Some(AstExpressionNodeLessEqual()); }
    if kind == "greater" { return Some(AstExpressionNodeGreater()); }
    if kind == "greater_equal" { return Some(AstExpressionNodeGreaterEqual()); }
    if kind == "add" { return Some(AstExpressionNodeAdd()); }
    if kind == "subtract" { return Some(AstExpressionNodeSubtract()); }
    if kind == "multiply" { return Some(AstExpressionNodeMultiply()); }
    if kind == "divide" { return Some(AstExpressionNodeDivide()); }
    if kind == "modulo" { return Some(AstExpressionNodeModulo()); }
    if kind == "index" { return Some(AstExpressionNodeIndex()); }
    if kind == "logical_not" { return Some(AstExpressionNodeLogicalNot()); }
    if kind == "negate" { return Some(AstExpressionNodeNegate()); }
    if kind == "float_literal" { return Some(AstExpressionNodeFloatLiteral()); }
    if kind == "integer_literal" { return Some(AstExpressionNodeIntegerLiteral()); }
    if kind == "long_literal" { return Some(AstExpressionNodeLongLiteral()); }
    if kind == "bool_literal" { return Some(AstExpressionNodeBoolLiteral()); }
    if kind == "string_literal" { return Some(AstExpressionNodeStringLiteral()); }
    if kind == "call" { return Some(AstExpressionNodeCall()); }
    if kind == "call_argument" { return Some(AstExpressionNodeCallArgument()); }
    if kind == "member_access" { return Some(AstExpressionNodeMemberAccess()); }
    if kind == "try" { return Some(AstExpressionNodeTry()); }
    if kind == "array_literal" { return Some(AstExpressionNodeArrayLiteral()); }
    if kind == "array_element" { return Some(AstExpressionNodeArrayElement()); }
    if kind == "struct_literal" { return Some(AstExpressionNodeStructLiteral()); }
    if kind == "struct_field_binding" { return Some(AstExpressionNodeStructFieldBinding()); }
    if kind == "struct_field" { return Some(AstExpressionNodeStructField()); }
    if kind == "struct_field_name" { return Some(AstExpressionNodeStructFieldName()); }
    if kind == "generic_type_actual" { return Some(AstExpressionNodeGenericTypeActual()); }
    if kind == "generic_callee" { return Some(AstExpressionNodeGenericCallee()); }
    if kind == "type_name" { return Some(AstExpressionNodeTypeName()); }
    if kind == "cast" { return Some(AstExpressionNodeCast()); }
    if kind == "await" { return Some(AstExpressionNodeAwait()); }
    if kind == "coalesce" { return Some(AstExpressionNodeCoalesce()); }
    if kind == "spawn" { return Some(AstExpressionNodeSpawn()); }
    if kind == "set_literal" { return Some(AstExpressionNodeSetLiteral()); }
    if kind == "set_element" { return Some(AstExpressionNodeSetElement()); }
    return None;
}

func MirExpressionCallTargetKindCode(kind: String) -> Option<Int> {
    if kind == "none" { return Some(SemanticCallTargetNone()); }
    if kind == "direct" { return Some(SemanticCallTargetDirect()); }
    if kind == "namespace" {
        return Some(SemanticCallTargetNamespace());
    }
    if kind == "member" { return Some(SemanticCallTargetMember()); }
    if kind == "role_operator" { return Some(SemanticCallTargetRoleOperator()); }
    return None;
}

func MirExpressionGraphRangeReachable(
    ref arena: SemanticExpressionGraphArena,
    start: Int,
    count: Int,
    root: Int
) -> Bool {
    let seen: Array<Bool> = [];
    let i: Int = 0;
    while i < count {
        ArrayPush(seen, false);
        i = i + 1;
    }
    let pending: Array<Int> = [root];
    let visited: Int = 0;
    while ArrayLength(pending) > 0 {
        let last: Int = ArrayLength(pending) - 1;
        let node: Int = pending[last];
        ArrayPop(pending);
        if node < start || node >= start + count { return false; }
        let local_index: Int = node - start;
        if seen[local_index] { continue; }
        ArraySet(seen, local_index, true);
        visited = visited + 1;
        let arity: Int = AstExpressionNodeArity(
            arena.topology.node_kinds[node]
        );
        if arity >= 1 {
            ArrayPush(pending, arena.topology.left_children[node]);
        }
        if arity == 2 {
            ArrayPush(pending, arena.topology.right_children[node]);
        }
    }
    return visited == count;
}

func MirExpressionGraphSequenceAppend(
    sequence: MirExpressionGraphSequence,
    graph: JsonObjectFactTable
) -> MirExpressionGraphSequence {
    let header: MirExpressionGraphHeaderCapture =
        MirExpressionGraphHeaderCaptureFromTable(graph);
    if !sequence.ok || !header.valid {
        return MirExpressionGraphSequenceError(sequence);
    }
    let local_root: Int = header.root;
    let kinds: Array<Int> = sequence.arena.topology.node_kinds;
    let texts: Array<String> = sequence.arena.node_texts;
    let left_children: Array<Int> = sequence.arena.topology.left_children;
    let right_children: Array<Int> = sequence.arena.topology.right_children;
    let call_target_kinds: Array<Int> =
        sequence.arena.call_target_kinds;
    let call_target_names: Array<String> = sequence.arena.call_target_names;
    let call_return_type_names: Array<String> =
        sequence.arena.call_return_type_names;
    let call_target_syntax_ids: Array<Int> =
        sequence.arena.identities.call_target_syntax_ids;
    let binding_kinds: Array<Int> =
        sequence.arena.identities.binding_kinds;
    let binding_ordinals: Array<Int> =
        sequence.arena.identities.binding_ordinals;
    let place_kinds: Array<Int> = sequence.arena.place_kinds;
    let offset: Int = ArrayLength(kinds);
    if sequence.ready_node_count != offset ||
        ArrayLength(texts) != offset || ArrayLength(left_children) != offset ||
        ArrayLength(right_children) != offset ||
        ArrayLength(call_target_kinds) != offset ||
        ArrayLength(call_target_names) != offset ||
        ArrayLength(call_return_type_names) != offset ||
        ArrayLength(call_target_syntax_ids) != offset ||
        ArrayLength(binding_kinds) != offset ||
        ArrayLength(binding_ordinals) != offset ||
        ArrayLength(place_kinds) != offset {
        return MirExpressionGraphSequenceError(sequence);
    }
    let i: Int = 0;
    let cursor: Int = header.nodes_start + 1;
    while cursor < header.nodes_end {
        cursor = JsonSkipWhitespaceWithin(
            graph.json, cursor, header.nodes_end
        );
        if cursor >= header.nodes_end {
            return MirExpressionGraphSequenceError(sequence);
        }
        let cursor_char: Int = JsonCharCodeAt(
            graph.json, header.nodes_end, cursor
        );
        if cursor_char == JsonAsciiCode("]") { break; }
        if cursor_char == JsonAsciiCode(",") {
            cursor = cursor + 1;
            continue;
        }
        let node: MirExpressionGraphNodeCapture =
            MirExpressionGraphNodeCaptureWithin(
                graph.json, cursor, header.nodes_end
            );
        if !node.valid || node.text == "" {
            return MirExpressionGraphSequenceError(sequence);
        }
        let kind_opt: Option<Int> = MirExpressionGraphKindCode(
            node.kind
        );
        if !IsSome(kind_opt) {
            return MirExpressionGraphSequenceError(sequence);
        }
        let target_kind_opt: Option<Int> = MirExpressionCallTargetKindCode(
            node.target_kind
        );
        if !IsSome(target_kind_opt) {
            return MirExpressionGraphSequenceError(sequence);
        }
        let target_kind: Int = UnwrapOption(target_kind_opt);
        if (target_kind == SemanticCallTargetNone() &&
                node.target_name != "") ||
            ((target_kind == SemanticCallTargetDirect() ||
                target_kind == SemanticCallTargetNamespace() ||
                target_kind == SemanticCallTargetMember()) &&
                (node.target_name == "" ||
                    UnwrapOption(kind_opt) != AstExpressionNodeCall())) ||
            (target_kind == SemanticCallTargetRoleOperator() &&
                (node.target_name == "" ||
                    !SemanticRoleOperatorKindSupported(
                        UnwrapOption(kind_opt)
                    ))) {
            return MirExpressionGraphSequenceError(sequence);
        }
        let kind: Int = UnwrapOption(kind_opt);
        let node_text: String = node.text;
        if (kind == AstExpressionNodeLongLiteral() &&
                !AstExpressionLongLiteralPayloadReady(node_text)) ||
            (kind == AstExpressionNodeBoolLiteral() &&
                !AstExpressionBoolLiteralPayloadReady(node_text)) ||
            (kind == AstExpressionNodeStringLiteral() &&
                !AstExpressionStringLiteralPayloadReady(node_text)) {
            return MirExpressionGraphSequenceError(sequence);
        }
        let left: Int = 0;
        let right: Int = 0;
        let arity: Int = AstExpressionNodeArity(kind);
        if arity == 0 {
            if node.has_left || node.has_right {
                return MirExpressionGraphSequenceError(sequence);
            }
        } else if arity == 1 {
            if !node.has_left || node.has_right {
                return MirExpressionGraphSequenceError(sequence);
            }
            let local_left: Int = node.left;
            if local_left < 0 || local_left >= i {
                return MirExpressionGraphSequenceError(sequence);
            }
            left = offset + local_left;
            right = 0;
        } else {
            if !node.has_left || !node.has_right {
                return MirExpressionGraphSequenceError(sequence);
            }
            let local_left: Int = node.left;
            let local_right: Int = node.right;
            if local_left < 0 || local_right < 0 ||
                local_left >= i || local_right >= i {
                return MirExpressionGraphSequenceError(sequence);
            }
            left = offset + local_left;
            right = offset + local_right;
        }
        if (kind == AstExpressionNodeCall() &&
                !AstExpressionNodeIsCallableCallee(kinds[left])) ||
            (kind == AstExpressionNodeCallArgument() &&
                !AstExpressionNodeIsCallSpine(kinds[left])) ||
            (kind == AstExpressionNodeMemberAccess() &&
                kinds[right] != AstExpressionNodeLeaf()) ||
            (kind == AstExpressionNodeGenericCallee() &&
                (!AstExpressionNodeIsCallableCallee(kinds[left]) ||
                    kinds[right] != AstExpressionNodeGenericTypeActual())) ||
            (kind == AstExpressionNodeCast() &&
                kinds[right] != AstExpressionNodeTypeName()) ||
            (kind == AstExpressionNodeArrayElement() &&
                !AstExpressionNodeIsArrayLiteralSpine(kinds[left])) ||
            (kind == AstExpressionNodeSetElement() &&
                !AstExpressionNodeIsSetLiteralSpine(kinds[left])) ||
            (kind == AstExpressionNodeStructLiteral() &&
                kinds[left] != AstExpressionNodeLeaf()) ||
            (kind == AstExpressionNodeStructFieldBinding() &&
                kinds[left] != AstExpressionNodeStructFieldName()) ||
            (kind == AstExpressionNodeStructField() &&
                (!AstExpressionNodeIsStructLiteralSpine(kinds[left]) ||
                    kinds[right] != AstExpressionNodeStructFieldBinding())) {
            return MirExpressionGraphSequenceError(sequence);
        }
        ArrayPush(kinds, kind);
        ArrayPush(texts, node_text);
        ArrayPush(left_children, left);
        ArrayPush(right_children, right);
        ArrayPush(call_target_kinds, target_kind);
        ArrayPush(call_target_names, node.target_name);
        ArrayPush(call_return_type_names, "");
        ArrayPush(call_target_syntax_ids, node.call_target_syntax_id);
        if node.binding_kind == "formal_parameter" {
            ArrayPush(
                binding_kinds,
                SemanticExpressionBindingFormalParameter()
            );
        } else {
            ArrayPush(binding_kinds, SemanticExpressionBindingNone());
        }
        if node.has_binding_ordinal {
            ArrayPush(binding_ordinals, node.binding_ordinal);
        } else {
            ArrayPush(binding_ordinals, -1);
        }
        ArrayPush(place_kinds, SemanticExpressionPlaceUnknown());
        i = i + 1;
        cursor = node.end;
    }
    let count: Int = i;
    if count == 0 || local_root >= count {
        return MirExpressionGraphSequenceError(sequence);
    }
    let roots: Array<Int> = sequence.roots;
    ArrayPush(roots, offset + local_root);
    let arena: SemanticExpressionGraphArena =
        SemanticExpressionGraphArenaFromTopology(
            AstExpressionArena(
                kinds, texts, left_children, right_children
            ),
            texts, call_target_kinds, call_target_names,
            call_return_type_names, place_kinds
        );
    arena.identities = SemanticExpressionIdentityRows(
        call_target_syntax_ids, binding_kinds, binding_ordinals
    );
    if !MirExpressionGraphRangeReachable(
            arena, offset, count, offset + local_root
        ) {
        return MirExpressionGraphSequenceError(sequence);
    }
    return MirExpressionGraphSequence(
        true, ArrayLength(kinds), roots, arena
    );
}
