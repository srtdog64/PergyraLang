// Copies one semantic graph view into the next canonical sequence range.

import "expression_graph_sequence_owner.pgy";

func MirExpressionGraphSequenceAppendView(
    sequence: MirExpressionGraphSequence,
    view: SemanticExpressionGraphView
) -> MirExpressionGraphSequence {
    if !sequence.ok || !view.ok {
        return MirExpressionGraphSequenceError(sequence);
    }
    let start_opt: Option<Int> = SemanticExpressionGraphSubtreeStart(
        view.graph, view.root_id
    );
    if !IsSome(start_opt) {
        return MirExpressionGraphSequenceError(sequence);
    }
    let start: Int = UnwrapOption(start_opt);
    let kinds: Array<Int> = sequence.arena.topology.node_kinds;
    let texts: Array<String> = sequence.arena.node_texts;
    let left_children: Array<Int> = sequence.arena.topology.left_children;
    let right_children: Array<Int> = sequence.arena.topology.right_children;
    let call_target_kinds: Array<Int> = sequence.arena.call_target_kinds;
    let call_target_names: Array<String> = sequence.arena.call_target_names;
    let place_kinds: Array<Int> = sequence.arena.place_kinds;
    let offset: Int = ArrayLength(kinds);
    if ArrayLength(texts) != offset || ArrayLength(left_children) != offset ||
        ArrayLength(right_children) != offset ||
        ArrayLength(call_target_kinds) != offset ||
        ArrayLength(call_target_names) != offset ||
        ArrayLength(place_kinds) != offset {
        return MirExpressionGraphSequenceError(sequence);
    }
    let source_i: Int = start;
    while source_i <= view.root_id {
        let kind: Int = view.graph.arena.topology.node_kinds[source_i];
        let arity: Int = AstExpressionNodeArity(kind);
        let left: Int = 0;
        let right: Int = 0;
        if arity >= 1 {
            let source_left: Int =
                view.graph.arena.topology.left_children[source_i];
            if source_left < start || source_left >= source_i {
                return MirExpressionGraphSequenceError(sequence);
            }
            left = offset + source_left - start;
        }
        if arity == 2 {
            let source_right: Int =
                view.graph.arena.topology.right_children[source_i];
            if source_right < start || source_right >= source_i {
                return MirExpressionGraphSequenceError(sequence);
            }
            right = offset + source_right - start;
        }
        ArrayPush(kinds, kind);
        ArrayPush(texts, view.graph.arena.node_texts[source_i]);
        ArrayPush(left_children, left);
        ArrayPush(right_children, right);
        ArrayPush(
            call_target_kinds,
            view.graph.arena.call_target_kinds[source_i]
        );
        ArrayPush(
            call_target_names,
            view.graph.arena.call_target_names[source_i]
        );
        ArrayPush(place_kinds, SemanticExpressionPlaceUnknown());
        source_i = source_i + 1;
    }
    let roots: Array<Int> = sequence.roots;
    let root: Int = offset + view.root_id - start;
    ArrayPush(roots, root);
    let arena: SemanticExpressionGraphArena =
        SemanticExpressionGraphArenaFromRows(
            kinds, texts, left_children, right_children,
            call_target_kinds, call_target_names, place_kinds
        );
    if !MirExpressionGraphRangeReachable(
            arena, offset, view.root_id - start + 1, root
        ) {
        return MirExpressionGraphSequenceError(sequence);
    }
    return MirExpressionGraphSequence(true, roots, arena);
}
