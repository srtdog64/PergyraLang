// One ordered tagged-enum match expression occurrence.

import "expression_graph_sequence_owner.pgy";
import "match_json_fact_owner.pgy";
import "program_enum_variant_index_owner.pgy";

func MirExpressionGraphSequenceAppendTaggedEnumMatchOccurrence(
    sequence: MirExpressionGraphSequence,
    ref enum_variants: MirProgramEnumVariantIndex,
    instruction: JsonObjectFactTable,
    subject_graph: JsonObjectFactTable,
    match_value: String,
    pattern: String,
    variant_opt: Option<String>,
    binding_count: Int,
    lane: Int,
    ordinal: Int
) -> MirExpressionGraphSequence {
    if ordinal < 0 || binding_count < 0 ||
        (!IsSome(variant_opt) && binding_count != 0) ||
        (lane != AstExpressionLaneAtom() &&
            lane != AstExpressionLaneValue()) {
        return MirExpressionGraphSequenceError(sequence);
    }
    if lane == AstExpressionLaneAtom() && ordinal != 0 {
        return MirExpressionGraphSequenceError(sequence);
    }
    if lane == AstExpressionLaneValue() &&
        (!IsSome(variant_opt) || ordinal >= binding_count ||
            !IsSome(MirMatchBindingAt(instruction, ordinal)) ||
            !IsSome(MirMatchBindingTypeAt(instruction, ordinal))) {
        return MirExpressionGraphSequenceError(sequence);
    }
    let appended: MirExpressionGraphSequence =
        MirExpressionGraphSequenceAppend(sequence, subject_graph);
    if !appended.ok || ArrayLength(appended.roots) == 0 {
        return MirExpressionGraphSequenceError(appended);
    }
    let roots: Array<Int> = appended.roots;
    let arena: SemanticExpressionGraphArena = appended.arena;
    let kinds: Array<Int> = arena.topology.node_kinds;
    let texts: Array<String> = arena.node_texts;
    let left: Array<Int> = arena.topology.left_children;
    let right: Array<Int> = arena.topology.right_children;
    let target_kinds: Array<Int> = arena.call_target_kinds;
    let target_names: Array<String> = arena.call_target_names;
    let places: Array<Int> = arena.place_kinds;
    let subject_root: Int = roots[ArrayLength(roots) - 1];
    let variant_name: String = pattern;
    if IsSome(variant_opt) { variant_name = UnwrapOption(variant_opt); }
    if lane == AstExpressionLaneAtom() {
        let pattern_node: Int = ArrayLength(kinds);
        let condition_pattern: String = pattern;
        if ToString(ToInt(pattern)) == pattern {
            ArrayPush(kinds, AstExpressionNodeIntegerLiteral());
            ArrayPush(texts, pattern);
            ArrayPush(left, 0); ArrayPush(right, 0);
            ArrayPush(target_kinds, SemanticCallTargetNone());
            ArrayPush(target_names, "");
            ArrayPush(places, SemanticExpressionPlaceUnknown());
        } else {
            let enum_owner: String = MirProgramEnumVariantOwnerForName(
                enum_variants, variant_name
            );
            if enum_owner == "" {
                return MirExpressionGraphSequenceError(appended);
            }
            let enum_owner_node: Int = ArrayLength(kinds);
            ArrayPush(kinds, AstExpressionNodeLeaf());
            ArrayPush(texts, enum_owner);
            ArrayPush(left, 0); ArrayPush(right, 0);
            ArrayPush(target_kinds, SemanticCallTargetNone());
            ArrayPush(target_names, "");
            ArrayPush(places, SemanticExpressionPlaceUnknown());
            let enum_variant_node: Int = ArrayLength(kinds);
            ArrayPush(kinds, AstExpressionNodeLeaf());
            ArrayPush(texts, variant_name);
            ArrayPush(left, 0); ArrayPush(right, 0);
            ArrayPush(target_kinds, SemanticCallTargetNone());
            ArrayPush(target_names, "");
            ArrayPush(places, SemanticExpressionPlaceUnknown());
            pattern_node = ArrayLength(kinds);
            condition_pattern = Concat(enum_owner, Concat(".", variant_name));
            ArrayPush(kinds, AstExpressionNodeMemberAccess());
            ArrayPush(texts, condition_pattern);
            ArrayPush(left, enum_owner_node);
            ArrayPush(right, enum_variant_node);
            ArrayPush(target_kinds, SemanticCallTargetNone());
            ArrayPush(target_names, "");
            ArrayPush(places, SemanticExpressionPlaceUnknown());
        }
        let equality_root: Int = ArrayLength(kinds);
        ArrayPush(kinds, AstExpressionNodeEquality());
        ArrayPush(texts, Concat(match_value, Concat(" == ", condition_pattern)));
        ArrayPush(left, subject_root); ArrayPush(right, pattern_node);
        ArrayPush(target_kinds, SemanticCallTargetNone());
        ArrayPush(target_names, "");
        ArrayPush(places, SemanticExpressionPlaceUnknown());
        ArraySet(roots, ArrayLength(roots) - 1, equality_root);
    } else {
        let variant_leaf: Int = ArrayLength(kinds);
        ArrayPush(kinds, AstExpressionNodeLeaf());
        ArrayPush(texts, variant_name);
        ArrayPush(left, 0); ArrayPush(right, 0);
        ArrayPush(target_kinds, SemanticCallTargetNone());
        ArrayPush(target_names, "");
        ArrayPush(places, SemanticExpressionPlaceUnknown());
        let variant_member: Int = ArrayLength(kinds);
        ArrayPush(kinds, AstExpressionNodeMemberAccess());
        ArrayPush(texts, Concat(match_value, Concat(".", variant_name)));
        ArrayPush(left, subject_root); ArrayPush(right, variant_leaf);
        ArrayPush(target_kinds, SemanticCallTargetNone());
        ArrayPush(target_names, "");
        ArrayPush(places, SemanticExpressionPlaceUnknown());
        let field_name: String = Concat("_", ToString(ordinal));
        let payload_leaf: Int = ArrayLength(kinds);
        ArrayPush(kinds, AstExpressionNodeLeaf());
        ArrayPush(texts, field_name);
        ArrayPush(left, 0); ArrayPush(right, 0);
        ArrayPush(target_kinds, SemanticCallTargetNone());
        ArrayPush(target_names, "");
        ArrayPush(places, SemanticExpressionPlaceUnknown());
        let payload_root: Int = ArrayLength(kinds);
        ArrayPush(kinds, AstExpressionNodeMemberAccess());
        ArrayPush(texts, Concat(match_value, Concat(
            ".", Concat(variant_name, Concat(".", field_name))
        )));
        ArrayPush(left, variant_member); ArrayPush(right, payload_leaf);
        ArrayPush(target_kinds, SemanticCallTargetNone());
        ArrayPush(target_names, "");
        ArrayPush(places, SemanticExpressionPlaceUnknown());
        ArraySet(roots, ArrayLength(roots) - 1, payload_root);
    }
    return MirExpressionGraphSequenceFromExtendedRows(
        appended, roots, kinds, texts, left, right,
        target_kinds, target_names, places
    );
}

// An or-pattern condition: one equality per alternative, folded left to
// right into `||`, the shape of the condition text
// (structured_condition_emission_owner) and of native's
// `(s == 401) || (s == 403)`.
func MirExpressionGraphSequenceAppendOrPatternMatchOccurrence(
    sequence: MirExpressionGraphSequence,
    ref enum_variants: MirProgramEnumVariantIndex,
    instruction: JsonObjectFactTable,
    subject_graph: JsonObjectFactTable,
    match_value: String,
    patterns: Array<String>
) -> MirExpressionGraphSequence {
    let base_root_count: Int = ArrayLength(sequence.roots);
    let current: MirExpressionGraphSequence = sequence;
    let no_variant: Option<String> = None;
    let alternative: Int = 0;
    while alternative < ArrayLength(patterns) {
        current = MirExpressionGraphSequenceAppendTaggedEnumMatchOccurrence(
            current, enum_variants, instruction, subject_graph, match_value,
            patterns[alternative], no_variant, 0, AstExpressionLaneAtom(), 0
        );
        if !current.ok { return current; }
        alternative = alternative + 1;
    }
    let roots: Array<Int> = current.roots;
    if ArrayLength(patterns) < 2 ||
        ArrayLength(roots) != base_root_count + ArrayLength(patterns) {
        return MirExpressionGraphSequenceError(current);
    }
    let arena: SemanticExpressionGraphArena = current.arena;
    let kinds: Array<Int> = arena.topology.node_kinds;
    let texts: Array<String> = arena.node_texts;
    let left: Array<Int> = arena.topology.left_children;
    let right: Array<Int> = arena.topology.right_children;
    let target_kinds: Array<Int> = arena.call_target_kinds;
    let target_names: Array<String> = arena.call_target_names;
    let places: Array<Int> = arena.place_kinds;
    let folded: Int = roots[base_root_count];
    let folded_text: String = texts[folded];
    let next: Int = 1;
    while next < ArrayLength(patterns) {
        let equality: Int = roots[base_root_count + next];
        folded_text = Concat(folded_text, Concat(" || ", texts[equality]));
        let or_node: Int = ArrayLength(kinds);
        ArrayPush(kinds, AstExpressionNodeLogicalOr());
        ArrayPush(texts, folded_text);
        ArrayPush(left, folded); ArrayPush(right, equality);
        ArrayPush(target_kinds, SemanticCallTargetNone());
        ArrayPush(target_names, "");
        ArrayPush(places, SemanticExpressionPlaceUnknown());
        folded = or_node;
        next = next + 1;
    }
    let kept: Array<Int> = [];
    let root_index: Int = 0;
    while root_index < base_root_count {
        ArrayPush(kept, roots[root_index]);
        root_index = root_index + 1;
    }
    ArrayPush(kept, folded);
    return MirExpressionGraphSequenceFromExtendedRows(
        current, kept, kinds, texts, left, right,
        target_kinds, target_names, places
    );
}
