// Ordered tagged-enum match condition and payload projection graphs.

import "expression_graph_sequence_owner.pgy";
import "match_json_fact_owner.pgy";
import "json_fact_read.pgy";

func MirExpressionGraphSequenceAppendTaggedEnumMatch(
    sequence: MirExpressionGraphSequence,
    instruction: JsonObjectFactTable,
    subject_graph: JsonObjectFactTable,
    match_value: String,
    pattern: String,
    variant_opt: Option<String>,
    binding_count: Int
) -> MirExpressionGraphSequence {
    if (!IsSome(variant_opt) && binding_count != 0) || binding_count < 0 {
        return MirExpressionGraphSequenceError(sequence);
    }
    let appended: MirExpressionGraphSequence =
        MirExpressionGraphSequenceAppend(sequence, subject_graph);
    if !appended.ok || ArrayLength(appended.roots) == 0 {
        return MirExpressionGraphSequenceError(appended);
    }
    let roots: Array<Int> = appended.roots;
    let arena: SemanticExpressionGraphArena = appended.arena;
    let kinds: Array<Int> = arena.topology.node_kinds;
    let texts: Array<String> = arena.node_texts;
    let left: Array<Int> = arena.topology.left_children;
    let right: Array<Int> = arena.topology.right_children;
    let target_kinds: Array<Int> = arena.call_target_kinds;
    let target_names: Array<String> = arena.call_target_names;
    let places: Array<Int> = arena.place_kinds;
    let subject_root: Int = roots[ArrayLength(roots) - 1];
    let pattern_node: Int = ArrayLength(kinds);
    let condition_pattern: String = pattern;
    let variant_name: String = pattern;
    if IsSome(variant_opt) { variant_name = UnwrapOption(variant_opt); }
    if ToString(ToInt(pattern)) == pattern {
        ArrayPush(kinds, AstExpressionNodeIntegerLiteral());
        ArrayPush(texts, pattern);
        ArrayPush(left, 0); ArrayPush(right, 0);
        ArrayPush(target_kinds, SemanticCallTargetNone());
        ArrayPush(target_names, "");
        ArrayPush(places, SemanticExpressionPlaceUnknown());
    } else {
        let enum_owner: String = MirEnumOwnerForVariant(
            instruction.json, variant_name
        );
        if enum_owner == "" {
            return MirExpressionGraphSequenceError(appended);
        }
        let enum_owner_node: Int = ArrayLength(kinds);
        ArrayPush(kinds, AstExpressionNodeLeaf());
        ArrayPush(texts, enum_owner);
        ArrayPush(left, 0); ArrayPush(right, 0);
        ArrayPush(target_kinds, SemanticCallTargetNone());
        ArrayPush(target_names, "");
        ArrayPush(places, SemanticExpressionPlaceUnknown());
        condition_pattern = Concat(enum_owner, Concat(".", variant_name));
        let enum_variant_node: Int = ArrayLength(kinds);
        ArrayPush(kinds, AstExpressionNodeLeaf());
        ArrayPush(texts, variant_name);
        ArrayPush(left, 0); ArrayPush(right, 0);
        ArrayPush(target_kinds, SemanticCallTargetNone());
        ArrayPush(target_names, "");
        ArrayPush(places, SemanticExpressionPlaceUnknown());
        pattern_node = ArrayLength(kinds);
        ArrayPush(kinds, AstExpressionNodeMemberAccess());
        ArrayPush(texts, condition_pattern);
        ArrayPush(left, enum_owner_node);
        ArrayPush(right, enum_variant_node);
        ArrayPush(target_kinds, SemanticCallTargetNone());
        ArrayPush(target_names, "");
        ArrayPush(places, SemanticExpressionPlaceUnknown());
    }
    let equality_root: Int = ArrayLength(kinds);
    ArrayPush(kinds, AstExpressionNodeEquality());
    ArrayPush(texts, Concat(match_value, Concat(" == ", condition_pattern)));
    ArrayPush(left, subject_root); ArrayPush(right, pattern_node);
    ArrayPush(target_kinds, SemanticCallTargetNone());
    ArrayPush(target_names, "");
    ArrayPush(places, SemanticExpressionPlaceUnknown());
    ArraySet(roots, ArrayLength(roots) - 1, equality_root);
    let final_arena: SemanticExpressionGraphArena =
        SemanticExpressionGraphArenaFromRows(
            kinds, texts, left, right, target_kinds, target_names, places
        );
    if !SemanticExpressionGraphArenaReady(final_arena) {
        return MirExpressionGraphSequenceError(appended);
    }
    let result: MirExpressionGraphSequence =
        MirExpressionGraphSequence(true, roots, final_arena);
    if !IsSome(variant_opt) { return result; }
    if binding_count == 0 {
        return MirExpressionGraphSequenceError(result);
    }
    let binding_index: Int = 0;
    while binding_index < binding_count {
        if !IsSome(MirMatchBindingAt(instruction, binding_index)) ||
            !IsSome(MirMatchBindingTypeAt(instruction, binding_index)) {
            return MirExpressionGraphSequenceError(result);
        }
        result = MirExpressionGraphSequenceAppend(result, subject_graph);
        if !result.ok { return result; }
        let payload_roots: Array<Int> = result.roots;
        let payload_arena: SemanticExpressionGraphArena = result.arena;
        let payload_kinds: Array<Int> = payload_arena.topology.node_kinds;
        let payload_texts: Array<String> = payload_arena.node_texts;
        let payload_left: Array<Int> = payload_arena.topology.left_children;
        let payload_right: Array<Int> = payload_arena.topology.right_children;
        let payload_target_kinds: Array<Int> =
            payload_arena.call_target_kinds;
        let payload_target_names: Array<String> =
            payload_arena.call_target_names;
        let payload_places: Array<Int> = payload_arena.place_kinds;
        let payload_subject: Int =
            payload_roots[ArrayLength(payload_roots) - 1];
        let variant_leaf: Int = ArrayLength(payload_kinds);
        ArrayPush(payload_kinds, AstExpressionNodeLeaf());
        ArrayPush(payload_texts, variant_name);
        ArrayPush(payload_left, 0); ArrayPush(payload_right, 0);
        ArrayPush(payload_target_kinds, SemanticCallTargetNone());
        ArrayPush(payload_target_names, "");
        ArrayPush(payload_places, SemanticExpressionPlaceUnknown());
        let variant_member: Int = ArrayLength(payload_kinds);
        ArrayPush(payload_kinds, AstExpressionNodeMemberAccess());
        ArrayPush(
            payload_texts, Concat(match_value, Concat(".", variant_name))
        );
        ArrayPush(payload_left, payload_subject);
        ArrayPush(payload_right, variant_leaf);
        ArrayPush(payload_target_kinds, SemanticCallTargetNone());
        ArrayPush(payload_target_names, "");
        ArrayPush(payload_places, SemanticExpressionPlaceUnknown());
        let field_name: String = Concat("_", ToString(binding_index));
        let payload_leaf: Int = ArrayLength(payload_kinds);
        ArrayPush(payload_kinds, AstExpressionNodeLeaf());
        ArrayPush(payload_texts, field_name);
        ArrayPush(payload_left, 0); ArrayPush(payload_right, 0);
        ArrayPush(payload_target_kinds, SemanticCallTargetNone());
        ArrayPush(payload_target_names, "");
        ArrayPush(payload_places, SemanticExpressionPlaceUnknown());
        let payload_root: Int = ArrayLength(payload_kinds);
        ArrayPush(payload_kinds, AstExpressionNodeMemberAccess());
        ArrayPush(payload_texts, Concat(match_value, Concat(
            ".", Concat(variant_name, Concat(".", field_name))
        )));
        ArrayPush(payload_left, variant_member);
        ArrayPush(payload_right, payload_leaf);
        ArrayPush(payload_target_kinds, SemanticCallTargetNone());
        ArrayPush(payload_target_names, "");
        ArrayPush(payload_places, SemanticExpressionPlaceUnknown());
        ArraySet(
            payload_roots, ArrayLength(payload_roots) - 1, payload_root
        );
        let completed_arena: SemanticExpressionGraphArena =
            SemanticExpressionGraphArenaFromRows(
                payload_kinds, payload_texts, payload_left, payload_right,
                payload_target_kinds, payload_target_names, payload_places
            );
        if !SemanticExpressionGraphArenaReady(completed_arena) {
            return MirExpressionGraphSequenceError(result);
        }
        result = MirExpressionGraphSequence(
            true, payload_roots, completed_arena
        );
        binding_index = binding_index + 1;
    }
    return result;
}
