// Canonical identity-epoch rebinding for persisted MIR expression rows.
//
// MIR carries producer-AST SyntaxNodeIds. MIR-to-AST reconstruction creates a
// different canonical arena, so semantic consumers must receive one exact
// producer-to-canonical join rather than compare the two numeric epochs or
// recover identity from expression spelling.

import "program_routine_index_owner.pgy";
import "routine_inventory_owner.pgy";
import "../semantic/ast_expression/ast_expression_graph_fact_owner.pgy";
import "../semantic/ast_signature_fact_owner.pgy";
import "../semantic/ast_signature_artifact_match_owner.pgy";
import "../semantic/ast_intent_signature_fact_owner.pgy";
import "../semantic/callable_resolution_owner.pgy";
import "expression_identity_epoch_fact_owner.pgy";
import "expression_constructor_identity_epoch_owner.pgy";

func MirExpressionIdentityEpochFromArtifactWithSignatures(
    ref routines: MirProgramRoutineIndex,
    artifact: AstTreeArtifact,
    signatures: SemanticAstFunctionSignatureFacts
) -> MirExpressionIdentityEpoch {
    var routine_canonical_ids: Array<Int> = [];
    var source_ids: Array<Int> = [];
    var canonical_ids: Array<Int> = [];
    let intents: SemanticAstIntentSignatureFacts =
        SemanticAstIntentSignatureFactsFromArtifact(artifact);
    var ok: Bool = MirProgramRoutineIndexStructureReady(routines) &&
        SemanticAstFunctionSignatureFactsMatchArtifact(
            artifact, signatures
        ) && SemanticAstIntentSignatureFactsReady(artifact, intents);
    var routine: Int = 0;
    while routine < MirProgramRoutineIndexCount(routines) && ok {
        let header: MirRoutineHeaderFacts = BuildMirRoutineHeaderFacts(
            routines.source_json, routines.source_json_extent, routines.starts[routine],
            routines.ends[routine]
        );
        let source_routine_id: Int = ToInt(
            routines.source_syntax_ids[routine]
        );
        var canonical_routine_id: Int = -1;
        var canonical_param_start: Int = -1;
        var canonical_param_count: Int = -1;
        var matches: Int = 0;
        if routines.kinds[routine] == "intent" {
            var intent_index: Int = 0;
            while intent_index < ArrayLength(intents.intent_node_ids) {
                if intents.names[intent_index] == routines.names[routine] {
                    canonical_routine_id =
                        intents.intent_node_ids[intent_index];
                    canonical_param_start =
                        intents.param_starts[intent_index];
                    canonical_param_count =
                        intents.param_counts[intent_index];
                    matches = matches + 1;
                }
                intent_index = intent_index + 1;
            }
        } else if routines.kinds[routine] == "function" ||
            routines.kinds[routine] == "method" {
            var signature: Int = 0;
            while signature <
                SemanticAstFunctionSignatureCount(signatures) {
                if signatures.owner_names[signature] ==
                        routines.owners[routine] &&
                    signatures.names[signature] == routines.names[routine] &&
                    signatures.module_paths[signature] ==
                        routines.source_module_paths[routine] {
                    canonical_routine_id =
                        signatures.function_node_ids[signature];
                    canonical_param_start =
                        signatures.param_starts[signature];
                    canonical_param_count =
                        signatures.param_counts[signature];
                    matches = matches + 1;
                }
                signature = signature + 1;
            }
        }
        var parameter_shape_matches: Bool =
            canonical_param_count == ArrayLength(header.param_names);
        if routines.kinds[routine] == "intent" {
            // Intent participants are owned by the admitted intent execution
            // plan, not by MIR routine formal-parameter rows.  Do not make
            // those two fact families a shared numeric epoch.
            parameter_shape_matches = ArrayLength(header.param_names) == 0;
        }
        if matches != 1 || source_routine_id <= 0 ||
            !MirRoutineHeaderParameterRowsReady(header) ||
            !parameter_shape_matches ||
            !MirExpressionIdentityEpochAppend(
                source_routine_id, canonical_routine_id,
                source_ids, canonical_ids
            ) {
            Log("CODEGEN ERROR: MIR routine identity mismatch row=${routine} source=${source_routine_id} canonical=${canonical_routine_id} matches=${matches} source_params=" + ToString(ArrayLength(header.param_names)) + " canonical_params=${canonical_param_count}");
            ok = false;
        } else {
            ArrayPush(routine_canonical_ids, canonical_routine_id);
        }
        var param: Int = 0;
        while param < ArrayLength(header.param_names) && ok {
            let canonical_param: Int = canonical_param_start + param;
            var canonical_param_id: Int = -1;
            var canonical_param_name: String = "";
            var canonical_param_type: String = "";
            if routines.kinds[routine] == "intent" {
                canonical_param_id = intents.param_node_ids[canonical_param];
                canonical_param_name = intents.param_names[canonical_param];
                canonical_param_type = intents.param_types[canonical_param];
            } else {
                canonical_param_id =
                    signatures.param_node_ids[canonical_param];
                canonical_param_name = signatures.param_names[canonical_param];
                canonical_param_type = signatures.param_types[canonical_param];
            }
            let source_param_id: Int =
                header.param_source_syntax_ids[param];
            let implicit_receiver: Bool =
                routines.owners[routine] != "" &&
                header.param_names[param] == "self" &&
                header.param_types[param] == "";
            if canonical_param_name != header.param_names[param] ||
                (!implicit_receiver &&
                 canonical_param_type != header.param_types[param]) {
                Log("CODEGEN ERROR: MIR parameter identity mismatch routine=${routine} ordinal=${param}");
                ok = false;
            } else if source_param_id > 0 &&
                !MirExpressionIdentityEpochAppend(
                    source_param_id, canonical_param_id,
                    source_ids, canonical_ids
                ) {
                ok = false;
            }
            param = param + 1;
        }
        routine = routine + 1;
    }
    if ok {
        ok = MirExpressionIdentityEpochAppendDeclarationMethods(
            routines, signatures, source_ids, canonical_ids
        );
    }
    if ok {
        ok = MirExpressionIdentityEpochAppendEnums(routines, artifact, source_ids, canonical_ids);
    }
    if ok {
        ok = MirExpressionIdentityEpochAppendNominals(routines, artifact, source_ids, canonical_ids);
    }
    return MirExpressionIdentityEpoch(
        ok && ArrayLength(routine_canonical_ids) ==
            MirProgramRoutineIndexCount(routines),
        routine_canonical_ids, source_ids, canonical_ids
    );
}


// Declaration-only callables have no routine row. Runtime method declarations
// must agree with their already admitted routine identity, not register twice.
func MirExpressionIdentityEpochAppendDeclarationMethods(
    ref routines: MirProgramRoutineIndex,
    signatures: SemanticAstFunctionSignatureFacts,
    inout source_ids: Array<Int>,
    inout canonical_ids: Array<Int>
) -> Bool {
    var seen: Array<Int> = [];
    var declaration: Int = 0;
    while declaration < MirProgramDeclarationIndexCount(routines.declarations) {
        var methods: Array<Int> = [0, 0];
        if MirObjectArrayBoundsAtBounds(
            routines.source_json, routines.source_json_extent, routines.declarations.starts[declaration],
            routines.declarations.ends[declaration], "methods", methods
        ) {
            var owner: String = routines.declarations.names[declaration];
            let declaration_only: Bool =
                routines.declarations.kinds[declaration] == "ability" ||
                routines.declarations.kinds[declaration] == "extern";
            if routines.declarations.kinds[declaration] == "extern" { owner = ""; }
            var method: Array<Int> = [0, 0];
            var cursor: Int = methods[0] + 1;
            while JsonArrayNextObjectBounds(
                routines.source_json, routines.source_json_extent, cursor, methods[1], method
            ) {
                let name: String = MirObjectStringFactAtBounds(
                    routines.source_json, routines.source_json_extent, method[0], method[1], "name"
                );
                let source_text: String = MirObjectNumberFactAtBounds(
                    routines.source_json, routines.source_json_extent, method[0], method[1],
                    "source_syntax_id"
                );
                let source_id: Int = ToInt(source_text);
                if source_id <= 0 || ToString(source_id) != source_text ||
                    name == "" { return false; }
                var previous: Int = 0;
                while previous < ArrayLength(seen) {
                    if seen[previous] == source_id { return false; }
                    previous = previous + 1;
                }
                ArrayPush(seen, source_id);
                var canonical_id: Int = -1;
                var matches: Int = 0;
                var signature: Int = 0;
                while signature < SemanticAstFunctionSignatureCount(signatures) {
                    if signatures.owner_names[signature] == owner &&
                        signatures.names[signature] == name &&
                        signatures.module_paths[signature] ==
                            routines.declarations.source_module_paths[declaration] &&
                        signatures.runtime_callables[signature] !=
                            declaration_only {
                        canonical_id = signatures.function_node_ids[signature];
                        matches = matches + 1;
                    }
                    signature = signature + 1;
                }
                if matches != 1 { Log("CODEGEN ERROR: MIR declaration method identity mismatch owner=${owner} name=${name} matches=${matches}"); return false; }
                if declaration_only {
                    if !MirExpressionIdentityEpochAppend(
                        source_id, canonical_id, source_ids, canonical_ids
                    ) { return false; }
                } else {
                    let existing: Option<Int> = MirExpressionIdentityEpochLookupRows(
                        source_ids, canonical_ids, source_id);
                    if !IsSome(existing) || UnwrapOption(existing) != canonical_id {
                        Log("CODEGEN ERROR: MIR declaration method does not match its routine owner=${owner} name=${name} source=${source_id} canonical=${canonical_id}");
                        return false;
                    }
                }
                cursor = method[1];
            }
            if !MirProgramDeclarationIndexCursorAtEnd(
                routines.source_json, routines.source_json_extent, cursor, methods[1]
            ) { return false; }
        }
        declaration = declaration + 1;
    }
    return true;
}

func MirExpressionIdentityEpochFromArtifact(
    ref routines: MirProgramRoutineIndex,
    artifact: AstTreeArtifact
) -> MirExpressionIdentityEpoch {
    return MirExpressionIdentityEpochFromArtifactWithSignatures(
        routines, artifact,
        SemanticAstFunctionSignatureFactsFromArtifact(artifact)
    );
}

func MirExpressionIdentityEpochRebindGraph(
    graph: SemanticExpressionGraphFacts,
    ref epoch: MirExpressionIdentityEpoch,
    member_source_names: Array<String>, member_canonical_names: Array<String>
) -> SemanticExpressionGraphFacts {
    let source: SemanticExpressionGraphArena = graph.arena;
    var targets: Array<Int> =
        source.identities.call_target_syntax_ids;
    var bindings: Array<Int> = source.identities.binding_syntax_ids;
    var target_names: Array<String> = source.call_target_names;
    let node_count: Int = SemanticExpressionGraphArenaNodeCount(source);
    var valid: Bool = graph.ok && epoch.ok &&
        SemanticExpressionIdentityRowsReady(
            source.identities, node_count
        );
    var node: Int = 0;
    while node < node_count && valid {
        if targets[node] > 0 {
            let target: Option<Int> =
                MirExpressionIdentityEpochLookup(epoch, targets[node]);
            if !IsSome(target) {
                Log("CODEGEN ERROR: MIR call identity has no canonical target node=${node} source=" + ToString(targets[node]));
                valid = false;
            } else {
                let canonical_id: Int = UnwrapOption(target);
                if source.call_target_kinds[node] == SemanticCallTargetMember() {
                    if canonical_id >= ArrayLength(member_source_names) ||
                        canonical_id >= ArrayLength(member_canonical_names) ||
                        member_source_names[canonical_id] == "" ||
                        member_canonical_names[canonical_id] == "" ||
                        (target_names[node] != member_source_names[canonical_id] &&
                         target_names[node] != member_canonical_names[canonical_id]) {
                        valid = false;
                    } else {
                        ArraySet(target_names, node, Concat("", member_canonical_names[canonical_id]));
                    }
                }
                ArraySet(targets, node, canonical_id);
            }
        }
        if bindings[node] > 0 {
            let binding: Option<Int> =
                MirExpressionIdentityEpochLookup(epoch, bindings[node]);
            if !IsSome(binding) {
                Log("CODEGEN ERROR: MIR binding identity has no canonical target node=${node} source=" + ToString(bindings[node]));
                valid = false;
            } else {
                ArraySet(bindings, node, UnwrapOption(binding));
            }
        }
        node = node + 1;
    }
    let rebound: SemanticExpressionIdentityRows =
        SemanticExpressionIdentityRows(
            targets, source.identities.runtime_call_abi_ids,
            bindings, source.identities.binding_kinds,
            source.identities.binding_ordinals,
            source.identities.builtin_argument_retention_calls,
            false, 0
        );
    let arena: SemanticExpressionGraphArena =
        SemanticExpressionGraphArenaFromTopologyWithIdentities(
            source.topology, source.node_texts,
            source.call_target_kinds, target_names,
            source.call_return_type_names, rebound,
            source.place_kinds
        );
    return SemanticExpressionGraphFacts(
        valid && SemanticExpressionGraphArenaReady(arena),
        graph.roots, graph.has_roots, arena
    );
}

// A dynamic ability dispatch names the abstract member, not the concrete
// role body, so its canonical id arrives from the declaration-method epoch
// rows rather than from a routine row. Carry those spellings too: without
// them the member rebind below reads an empty name and refuses a legal
// dispatch.
func MirExpressionIdentityEpochDeclarationMemberNames(
    ref routines: MirProgramRoutineIndex,
    ref epoch: MirExpressionIdentityEpoch,
    inout source_names: Array<String>,
    inout canonical_names: Array<String>
) -> Bool {
    var declaration: Int = 0;
    while declaration < MirProgramDeclarationIndexCount(routines.declarations) {
        var methods: Array<Int> = [0, 0];
        if routines.declarations.kinds[declaration] == "ability" &&
            MirObjectArrayBoundsAtBounds(
                routines.source_json, routines.source_json_extent,
                routines.declarations.starts[declaration],
                routines.declarations.ends[declaration], "methods", methods
            ) {
            let owner: String = routines.declarations.names[declaration];
            var method: Array<Int> = [0, 0];
            var cursor: Int = methods[0] + 1;
            while JsonArrayNextObjectBounds(
                routines.source_json, routines.source_json_extent, cursor, methods[1], method
            ) {
                let name: String = MirObjectStringFactAtBounds(
                    routines.source_json, routines.source_json_extent, method[0], method[1], "name"
                );
                let source_id: Int = ToInt(MirObjectNumberFactAtBounds(
                    routines.source_json, routines.source_json_extent, method[0], method[1],
                    "source_syntax_id"
                ));
                let canonical: Option<Int> =
                    MirExpressionIdentityEpochLookup(epoch, source_id);
                if name == "" || owner == "" || !IsSome(canonical) {
                    return false;
                }
                let canonical_id: Int = UnwrapOption(canonical);
                if canonical_id <= 0 ||
                    canonical_id >= ArrayLength(source_names) ||
                    canonical_id >= ArrayLength(canonical_names) {
                    return false;
                }
                ArraySet(source_names, canonical_id, name);
                ArraySet(canonical_names, canonical_id,
                    SemanticCallableCanonicalDeclaredName(owner, name));
                cursor = method[1];
            }
        }
        declaration = declaration + 1;
    }
    return true;
}

func MirExpressionIdentityEpochRebindGraphForArtifact(
    graph: SemanticExpressionGraphFacts,
    ref routines: MirProgramRoutineIndex,
    artifact: AstTreeArtifact
) -> SemanticExpressionGraphFacts {
    var epoch: MirExpressionIdentityEpoch =
        MirExpressionIdentityEpochFromArtifact(routines, artifact);
    if !MirExpressionIdentityEpochEnumTargetsReady(routines, graph) {
        Log("CODEGEN ERROR: MIR enum constructor does not belong to its declared target");
        epoch.ok = false;
    }
    if !MirExpressionIdentityEpochNominalTargetsReady(routines, graph) {
        Log("CODEGEN ERROR: MIR nominal constructor does not belong to its declared target");
        epoch.ok = false;
    }
    // The existing routine epoch selects these spellings. Neither spelling
    // can select a declaration, and no source/AST name lookup is reopened.
    var source_names: Array<String> = [];
    var canonical_names: Array<String> = [];
    // Syntax id 0 is the Program sentinel in every admitted AST artifact.
    // Establish its owned String generation before the fill loop so later
    // indexed replacement never depends on a loop-path inference to prove
    // that the table already owns the element being retired.
    if artifact.count <= 0 {
        epoch.ok = false;
        return MirExpressionIdentityEpochRebindGraph(
            graph, epoch, source_names, canonical_names
        );
    }
    ArrayPushOwnedString(source_names, "");
    ArrayPushOwnedString(canonical_names, "");
    var node: Int = 1;
    while node < artifact.count {
        ArrayPushOwnedString(source_names, "");
        ArrayPushOwnedString(canonical_names, "");
        node = node + 1;
    }
    if !epoch.ok { Log("CODEGEN ERROR: MIR expression identity epoch construction failed"); }
    var row: Int = 0;
    while row < ArrayLength(epoch.routine_canonical_ids) && epoch.ok {
        let id: Int = epoch.routine_canonical_ids[row];
        if id <= 0 || id >= artifact.count {
            epoch.ok = false;
        } else if routines.kinds[row] == "method" && routines.owners[row] != "" {
            ArraySet(source_names, id, routines.names[row]);
            ArraySet(canonical_names, id, SemanticCallableCanonicalDeclaredName(
                routines.owners[row], routines.names[row]));
        }
        row = row + 1;
    }
    if epoch.ok && !MirExpressionIdentityEpochDeclarationMemberNames(
        routines, epoch, source_names, canonical_names
    ) { epoch.ok = false; }
    return MirExpressionIdentityEpochRebindGraph(graph, epoch, source_names, canonical_names);
}
