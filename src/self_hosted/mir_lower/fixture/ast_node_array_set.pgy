struct CodegenAstTextNode {
    indent: Int,
    text: String,
    parent: Int,
    kind: Int
}

func Main() -> Void {
    let nodes: Array<CodegenAstTextNode> = [];
    ArrayPush(nodes, CodegenAstTextNode(0, "Old", 0, 0));
    ArraySet(nodes, 0, CodegenAstTextNode(2, "Let", 0, 8));
    Log(ToString(ArrayLength(nodes)));
}
