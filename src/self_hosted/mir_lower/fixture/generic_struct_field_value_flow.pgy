struct Pair {
    left: Int;
    right: Int;
}

func Identity<T>(value: T) -> T {
    return value;
}

func BuildPair(base: Int) -> Pair {
    return Pair {
        left: Identity<Int>(base + 1),
        right: Identity<Int>(base + 2)
    };
}

func Main() -> Void {
    let pair: Pair = Pair {
        left: Identity<Int>(1),
        right: Identity<Int>(2)
    };
    let built: Pair = BuildPair(pair.right);
    Log(ToString(built.left + built.right));
}
