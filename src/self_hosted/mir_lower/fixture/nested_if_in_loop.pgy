func Main() -> Void {
    let cur: Int = 0;
    let size: Int = 2;
    let largest: Int = cur;
    while true {
        let right: Int = 1;
        if right < size {
            largest = right;
        }
        if largest == cur {
            break;
        }
        Log(largest);
        break;
    }
    Log(largest);
}
