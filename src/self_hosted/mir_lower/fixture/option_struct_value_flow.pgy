struct Pair {
    left: Int;
    right: Int;
}

func BuildPair(base: Int) -> Option<Pair> {
    return Some(Pair { left: base, right: base + 1 });
}

func Main() -> Void {
    let mut picked: Option<Pair> = Some(Pair { left: 1, right: 2 });
    picked = Some(Pair { left: 3, right: 4 });
    let pair: Pair = UnwrapOption(picked);
    Log(ToString(pair.left + pair.right));
    let built: Option<Pair> = BuildPair(5);
    let unwrapped: Pair = UnwrapOption(built);
    Log(ToString(unwrapped.left + unwrapped.right));
}
