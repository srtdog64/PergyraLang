// MIR-lower parity fixture manifest owner.
//
// The MIR JSON parity gate needs a curated set of source programs whose
// `pgy --mir-json` output is in the supported fact subset. The shell runner
// consumes this manifest, but does not own the rows.

func MirParityFixtureCount() -> Int {
    return 95;
}

func MirParityCodegenFixtureDir() -> String {
    return "src/self_hosted/codegen/fixture";
}

func MirParityPathEndsWith(path: String, suffix: String) -> Bool {
    let path_len: Int = StringLength(path);
    let suffix_len: Int = StringLength(suffix);
    if suffix_len > path_len {
        return false;
    }
    return Substring(path, path_len - suffix_len, suffix_len) == suffix;
}

