// MIR-lower parity fixture manifest owner.
//
// The MIR JSON parity gate needs a curated set of source programs whose
// `pgy --mir-json` output is in the supported fact subset. The shell runner
// consumes this manifest, but does not own the rows.

import "../codegen/fixture_manifest_owner.pgy";

func MirParityCoreFixtureCount() -> Int {
    return 28;
}

func MirParityExampleFixtureCount() -> Int {
    return 1;
}

func MirParityFixtureCount() -> Int {
    return MirParityCoreFixtureCount() + CodegenParityFixtureExpectedCount() +
        MirParityExampleFixtureCount();
}

func MirParityFixtureAt(index: Int) -> String {
    if index == 0 { return "src/self_hosted/mir_lower/fixture/let_log.pgy"; }
    if index == 1 { return "src/self_hosted/mir_lower/fixture/multilet.pgy"; }
    if index == 2 { return "src/self_hosted/mir_lower/fixture/arith.pgy"; }
    if index == 3 { return "src/self_hosted/mir_lower/fixture/strlog.pgy"; }
    if index == 4 { return "src/self_hosted/mir_lower/fixture/funcparam.pgy"; }
    if index == 5 { return "src/self_hosted/mir_lower/fixture/multi_func_void.pgy"; }
    if index == 6 { return "src/self_hosted/mir_lower/fixture/break_after_stmt.pgy"; }
    if index == 7 { return "src/self_hosted/mir_lower/fixture/random_inferred_let.pgy"; }
    if index == 8 { return "src/self_hosted/mir_lower/fixture/class_decl.pgy"; }
    if index == 9 { return "src/self_hosted/mir_lower/fixture/class_method.pgy"; }
    if index == 10 { return "src/self_hosted/mir_lower/fixture/nominal_subject.pgy"; }
    if index == 11 { return "src/self_hosted/mir_lower/fixture/nominal_object.pgy"; }
    if index == 12 { return "src/self_hosted/mir_lower/fixture/nominal_tobject.pgy"; }
    if index == 13 { return "src/self_hosted/mir_lower/fixture/nominal_vessel.pgy"; }
    if index == 14 { return "src/self_hosted/mir_lower/fixture/ability_decl.pgy"; }
    if index == 15 { return "src/self_hosted/mir_lower/fixture/enum_simple.pgy"; }
    if index == 16 { return "src/self_hosted/mir_lower/fixture/match_case_int.pgy"; }
    if index == 17 { return "src/self_hosted/mir_lower/fixture/nested_if_in_loop.pgy"; }
    if index == 18 { return "src/self_hosted/mir_lower/fixture/option_match.pgy"; }
    if index == 19 { return "src/self_hosted/mir_lower/fixture/array_destructure.pgy"; }
    if index == 20 { return "src/self_hosted/mir_lower/fixture/role_operator_dispatch.pgy"; }
    if index == 21 { return "src/self_hosted/mir_lower/fixture/ifelse.pgy"; }
    if index == 22 { return "src/self_hosted/mir_lower/fixture/nestedif.pgy"; }
    if index == 23 { return "src/self_hosted/mir_lower/fixture/reassign_block.pgy"; }
    if index == 24 { return "src/self_hosted/mir_lower/fixture/whileloop.pgy"; }
    if index == 25 { return "src/self_hosted/mir_lower/fixture/forloop.pgy"; }
    if index == 26 {
        return "src/self_hosted/mir_lower/fixture/enum_option_payload.pgy";
    }
    if index == 27 {
        return "src/self_hosted/mir_lower/fixture/enum_multi_payload.pgy";
    }

    let codegen_start: Int = MirParityCoreFixtureCount();
    let codegen_end: Int = MirParityCoreFixtureCount() +
        CodegenParityFixtureExpectedCount();
    if index >= codegen_start && index < codegen_end {
        let bases: Array<String> = CodegenParityFixtureManifestRows();
        let codegen_index: Int = index - codegen_start;
        if codegen_index < 0 || codegen_index >= ArrayLength(bases) {
            return "";
        }
        return CodegenParityFixtureSourcePath(bases[codegen_index]);
    }

    if index == MirParityCoreFixtureCount() +
        CodegenParityFixtureExpectedCount() {
        return "examples/binary_search.pgy";
    }
    return "";
}

func MirParityManifestContains(path: String) -> Bool {
    let i: Int = 0;
    while i < MirParityFixtureCount() {
        if MirParityFixtureAt(i) == path {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func MirParityCodegenFixtureCoverageReady() -> Bool with caps io_read {
    let bases: Array<String> = CodegenParityFixtureManifestRows();
    if ArrayLength(bases) != CodegenParityFixtureExpectedCount() {
        return false;
    }
    let i: Int = 0;
    while i < ArrayLength(bases) {
        let path: String = CodegenParityFixtureSourcePath(bases[i]);
        if !FileExists(path) {
            return false;
        }
        if MirParityFixtureAt(MirParityCoreFixtureCount() + i) != path {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func MirParityFixtureManifestReady() -> Bool with caps io_read {
    let i: Int = 0;
    while i < MirParityFixtureCount() {
        let fixture: String = MirParityFixtureAt(i);
        if fixture == "" || !FileExists(fixture) {
            return false;
        }
        i = i + 1;
    }
    return MirParityCodegenFixtureCoverageReady();
}

func EmitMirParityFixtureManifest() -> Void with caps io_read {
    if !MirParityFixtureManifestReady() {
        Exit(1);
    }
    let i: Int = 0;
    while i < MirParityFixtureCount() {
        Log(MirParityFixtureAt(i));
        i = i + 1;
    }
}
