// Canonical binding/step projection from admitted intent semantic carriers.
import "error_owner.pgy";
import "routine_fact_index_owner.pgy";
import "intent_routine_carrier_projection_schema_owner.pgy";

struct MirIntentBindingProjection {
    ok: Bool;
    intent_source_syntax_id: Int;
    aliases: Array<String>;
    type_names: Array<String>;
    kinds: Array<String>;
    source_syntax_ids: Array<Int>;
    step_names: Array<String>;
    tree_lines: String;
}

func MirIntentTreeAppendLine(text: String, line: String) -> String {
    return Concat(text, Concat(line, "\n"));
}

func MirIntentCarrierCount(ref names: Array<String>, expected: String) -> Int {
    let count: Int = 0;
    let i: Int = 0;
    while i < ArrayLength(names) {
        if names[i] == expected { count = count + 1; }
        i = i + 1;
    }
    return count;
}

func MirIntentBindingProjectionInvalid() -> MirIntentBindingProjection {
    let strings: Array<String> = [];
    let ids: Array<Int> = [];
    return MirIntentBindingProjection(
        false, 0, strings, strings, strings, ids, strings, ""
    );
}

func MirIntentBindingRowForAlias(
    ref bindings: MirIntentBindingProjection, alias: String
) -> Int {
    if !bindings.ok || ArrayLength(bindings.aliases) != ArrayLength(bindings.type_names) ||
        ArrayLength(bindings.aliases) != ArrayLength(bindings.kinds) ||
        ArrayLength(bindings.aliases) != ArrayLength(bindings.source_syntax_ids) {
        MirLowerFailClosed("MIR intent binding inventory is invalid");
    }
    if alias == "" { return -1; }
    let found: Int = -1;
    let row: Int = 0;
    while row < ArrayLength(bindings.aliases) {
        if bindings.aliases[row] == alias {
            if found >= 0 { MirLowerFailClosed("MIR intent binding alias is duplicated"); }
            found = row;
        }
        row = row + 1;
    }
    return found;
}

func MirIntentScalarAt(
    ref index: MirRoutineFactIndex,
    instruction: MirRoutineInstructionView
) -> MirRoutineInstructionScalarCapture {
    if !instruction.valid { return InvalidMirRoutineInstructionScalarCapture(); }
    return MirRoutineInstructionFactBundleAtGlobal(
        index.instruction_facts, instruction.global_row
    );
}

func MirIntentKnownSemanticCarrier(name: String) -> Bool {
    return name == "IntentBinding" || name == "IntentParticipant" ||
        name == "IntentValue" || name == "IntentStep" ||
        name == "IntentZoneWhere" || name == "IntentZoneAlias" ||
        name == "IntentInvalidationTarget" || name == "IntentWho" ||
        name == "IntentAuthorizedBy" || name == "IntentCauses" ||
        name == "IntentOutcomeBinding" || name == "IntentCheck" ||
        name == "IntentEval" || name == "IntentMode";
}

// The carrier spine is borrowed whole; bindings keep owned copies of rows.
func MirIntentBindingProjectionFromCarriers(
    ref carriers: MirIntentRoutineCarrierProjection,
    intent_name: String,
    intent_source_syntax_id: Int
) -> MirIntentBindingProjection {
    if intent_source_syntax_id <= 0 || ArrayLength(carriers.carrier_names) != ArrayLength(carriers.carrier_arg0s) ||
        ArrayLength(carriers.carrier_names) != ArrayLength(carriers.carrier_arg1s) ||
        ArrayLength(carriers.carrier_names) != ArrayLength(carriers.carrier_slots) ||
        ArrayLength(carriers.carrier_names) != ArrayLength(carriers.carrier_binding_source_syntax_ids) {
        return MirIntentBindingProjectionInvalid();
    }
    let aliases: Array<String> = [];
    let type_names: Array<String> = [];
    let kinds: Array<String> = [];
    let source_syntax_ids: Array<Int> = [];
    let step_names: Array<String> = [];
    let row: Int = 0;
    while row < ArrayLength(carriers.carrier_names) {
        if carriers.carrier_names[row] == "IntentBinding" {
            let binding_kind: String = Concat("", carriers.carrier_slots[row]);
            if carriers.carrier_arg0s[row] == "" || carriers.carrier_arg1s[row] == "" ||
                carriers.carrier_binding_source_syntax_ids[row] <= 0 ||
                (binding_kind != "participant" && binding_kind != "value") {
                return MirIntentBindingProjectionInvalid();
            }
            let prior: Int = 0;
            while prior < ArrayLength(aliases) {
                if aliases[prior] == carriers.carrier_arg0s[row] ||
                    source_syntax_ids[prior] == carriers.carrier_binding_source_syntax_ids[row] {
                    return MirIntentBindingProjectionInvalid();
                }
                prior = prior + 1;
            }
            ArrayPush(aliases, Concat("", carriers.carrier_arg0s[row]));
            ArrayPush(type_names, Concat("", carriers.carrier_arg1s[row]));
            ArrayPush(kinds, binding_kind);
            ArrayPush(source_syntax_ids, carriers.carrier_binding_source_syntax_ids[row]);
        } else if carriers.carrier_names[row] == "IntentStep" {
            if carriers.carrier_arg0s[row] == "" ||
                carriers.carrier_arg0s[row] != carriers.carrier_arg1s[row] ||
                carriers.carrier_slots[row] != carriers.carrier_arg0s[row] {
                return MirIntentBindingProjectionInvalid();
            }
            ArrayPush(step_names, Concat("", carriers.carrier_arg0s[row]));
        }
        row = row + 1;
    }
    if ArrayLength(aliases) == 0 || ArrayLength(step_names) == 0 ||
        MirIntentCarrierCount(carriers.carrier_names, "IntentParticipant") +
            MirIntentCarrierCount(carriers.carrier_names, "IntentValue") != ArrayLength(aliases) {
        return MirIntentBindingProjectionInvalid();
    }
    let tree_lines: String = "";
    let binding_index: Int = 0;
    while binding_index < ArrayLength(aliases) {
        let expected_carrier: String = "IntentParticipant";
        let row_prefix: String = "    IntentInvolves: ";
        if kinds[binding_index] == "value" {
            expected_carrier = "IntentValue";
            row_prefix = "    IntentValue: ";
        }
        let match_count: Int = 0;
        row = 0;
        while row < ArrayLength(carriers.carrier_names) {
            if carriers.carrier_names[row] == expected_carrier &&
                carriers.carrier_arg0s[row] == aliases[binding_index] &&
                carriers.carrier_arg1s[row] == type_names[binding_index] &&
                carriers.carrier_binding_source_syntax_ids[row] == source_syntax_ids[binding_index] &&
                carriers.carrier_slots[row] == intent_name {
                match_count = match_count + 1;
            }
            row = row + 1;
        }
        if match_count != 1 { return MirIntentBindingProjectionInvalid(); }
        tree_lines = Concat(tree_lines, Concat(
            row_prefix, Concat(aliases[binding_index], Concat(
                ": ", Concat(type_names[binding_index], "\n")
            ))
        ));
        binding_index = binding_index + 1;
    }
    return MirIntentBindingProjection(
        true, intent_source_syntax_id, aliases, type_names, kinds, source_syntax_ids, step_names, tree_lines
    );
}
