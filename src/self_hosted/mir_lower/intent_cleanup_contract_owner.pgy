// Rollback and invalidation block contracts for reconstructed intents.
import "routine_fact_index_owner.pgy";
import "intent_execution_plan_fact_owner.pgy";

struct MirIntentRoutineBlockTopology {
    let valid: Bool;
    let entry: Int;
    let cleanup: Int;
    let rollback: Int;
    let invalidation: Int;
    let body_rows: Array<Int>;
    let execution_rows: Array<Int>;
    let mirror_rows: Array<Int>;
}

func MirIntentRoutineBlockTopologyInvalid() -> MirIntentRoutineBlockTopology {
    let rows: Array<Int> = [];
    return MirIntentRoutineBlockTopology(false, -1, -1, -1, -1, rows, rows, rows);
}

// Roles originate in producer CFG ownership, never in block count or position.
// The carrier body must be one complete normal path; typed execution blocks
// are cross-checked separately against the already admitted execution plan.
func MirIntentRoutineBlockTopologyFromIndex(
    ref routines: MirProgramRoutineIndex, ref index: MirRoutineFactIndex, routine_row: Int
) -> MirIntentRoutineBlockTopology {
    let invalid: MirIntentRoutineBlockTopology = MirIntentRoutineBlockTopologyInvalid();
    if !MirProgramRoutineIndexRowReady(routines, routine_row) || !index.valid ||
        routines.kinds[routine_row] != "intent" || routines.owners[routine_row] != "" ||
        routines.receiver_carriages[routine_row] != "none" { return invalid; }
    let start: Int = routines.routine_block_starts[routine_row];
    let count: Int = routines.routine_block_counts[routine_row];
    if count != ArrayLength(index.block_instruction_counts) { return invalid; }
    let entry: Int = -1; let cleanup: Int = -1; let rollback: Int = -1; let invalidation: Int = -1;
    let body_count: Int = 0;
    let body: Array<Int> = []; let execution: Array<Int> = []; let mirrors: Array<Int> = [];
    let visited: Array<Bool> = [];
    let row: Int = 0;
    while row < count {
        ArrayPush(visited, false);
        let role: String = routines.block_intent_roles[start + row];
        if role == "entry" { if entry >= 0 { return invalid; } entry = row; body_count = body_count + 1; }
        else if role == "body" { body_count = body_count + 1; }
        else if role == "cleanup" { if cleanup >= 0 { return invalid; } cleanup = row; }
        else if role == "rollback" { if rollback >= 0 { return invalid; } rollback = row; }
        else if role == "invalidation" { if invalidation >= 0 { return invalid; } invalidation = row; }
        else if role == "execution" { ArrayPush(execution, row); }
        else if role == "mirror" {
            if index.block_reachable[row] || index.block_succ_true[row] != -1 ||
                index.block_succ_false[row] != -1 { return invalid; }
            ArrayPush(mirrors, row);
        }
        else { return invalid; }
        if role == "cleanup" || role == "rollback" || role == "invalidation" {
            if !index.block_reachable[row] || index.block_succ_true[row] != -1 ||
                index.block_succ_false[row] != -1 { return invalid; }
        }
        row = row + 1;
    }
    // The routine-index CFG contract retains canonical local entry ID zero.
    if entry != 0 || cleanup < 0 || rollback < 0 || invalidation < 0 ||
        index.block_instruction_counts[cleanup] != 0 ||
        index.block_instruction_counts[rollback] < 3 ||
        index.block_instruction_counts[invalidation] < 2 { return invalid; }
    row = entry;
    while row >= 0 {
        if row >= count || !index.block_reachable[row] ||
            index.block_instruction_counts[row] <= 0 || index.block_succ_false[row] != -1 { return invalid; }
        let role: String = routines.block_intent_roles[start + row];
        if role != "entry" && role != "body" { return invalid; }
        if visited[row] { return invalid; }
        ArraySet(visited, row, true);
        ArrayPush(body, row);
        let next: Int = index.block_succ_true[row];
        if next < -1 || next >= count { return invalid; }
        if next >= 0 && routines.block_intent_roles[start + next] == "execution" { break; }
        row = next;
    }
    if ArrayLength(body) != body_count { return invalid; }
    return MirIntentRoutineBlockTopology(true, entry, cleanup, rollback, invalidation, body, execution, mirrors);
}

func MirIntentRoutineStructureReady(
    ref routines: MirProgramRoutineIndex,
    ref index: MirRoutineFactIndex,
    routine_row: Int
) -> Bool {
    let topology: MirIntentRoutineBlockTopology = MirIntentRoutineBlockTopologyFromIndex(routines, index, routine_row);
    return topology.valid && ArrayLength(topology.execution_rows) == 0 && ArrayLength(topology.mirror_rows) == 0;
}

func MirIntentCleanupScalarAt(
    ref index: MirRoutineFactIndex,
    instruction: MirRoutineInstructionView
) -> MirRoutineInstructionScalarCapture {
    if !instruction.valid { return InvalidMirRoutineInstructionScalarCapture(); }
    return MirRoutineInstructionFactBundleAtGlobal(
        index.instruction_facts, instruction.global_row
    );
}

func MirIntentRollbackContractError(
    ref routines: MirProgramRoutineIndex,
    ref index: MirRoutineFactIndex,
    routine_row: Int,
    intent_name: String
) -> String {
    let topology: MirIntentRoutineBlockTopology = MirIntentRoutineBlockTopologyFromIndex(routines, index, routine_row);
    if !topology.valid { return "MIR intent rollback block topology is invalid"; }
    let rollback_count: Int = 0;
    let abort_count: Int = 0;
    let edge_count: Int = 0;
    let instruction_row: Int = 0;
    while instruction_row < index.block_instruction_counts[topology.rollback] {
        let instruction: MirRoutineInstructionView =
            MirRoutineInstructionViewAt(
                routines, routine_row, topology.rollback, instruction_row
            );
        let scalar: MirRoutineInstructionScalarCapture =
            MirIntentCleanupScalarAt(index, instruction);
        if !instruction.valid || !scalar.valid ||
            instruction.kind != "cleanup" {
            return "MIR intent rollback block is invalid";
        }
        if scalar.name == "RollbackPolicy" && scalar.arg0 == "full" {
            rollback_count = rollback_count + 1;
        } else if scalar.name == "AbortIntent" &&
            scalar.arg0 == intent_name && scalar.arg1 == "full" &&
            scalar.slot_anchor == intent_name {
            abort_count = abort_count + 1;
        } else if scalar.name == "cleanup-edge-from-rollback" &&
            scalar.arg0 == "cleanup" {
            edge_count = edge_count + 1;
        } else {
            return "MIR intent rollback carrier is invalid";
        }
        instruction_row = instruction_row + 1;
    }
    if rollback_count != 1 || abort_count != 1 || edge_count != 1 {
        return "MIR intent rollback facts are incomplete";
    }
    return "";
}

func MirIntentRollbackContractErrorAtBlockId(
    ref routines: MirProgramRoutineIndex,
    ref index: MirRoutineFactIndex,
    routine_row: Int,
    intent_name: String,
    block_id: Int,
    ref plan: MirIntentExecutionPlan,
    routine_syntax_id: Int
) -> String {
    let block_row: Int = MirIntentExecutionRoutineBlockRowById(
        routines, routine_row, block_id
    );
    if block_row < 0 { return "MIR intent rollback block is missing"; }
    let rollback_count: Int = 0;
    let abort_count: Int = 0;
    let edge_count: Int = 0;
    let compensation_count: Int = 0;
    let matched_compensations: Array<Bool> = [];
    let compensation_row: Int = 0;
    while compensation_row <
            ArrayLength(plan.steps.compensations.transition_ids) {
        let owner_step: Int = MirIntentStepTransitionIndexByHandle(
            plan.steps,
            plan.steps.compensations.transition_ids[compensation_row]
        );
        if owner_step >= 0 &&
            plan.steps.routine_syntax_ids[owner_step] == routine_syntax_id {
            ArrayPush(matched_compensations, false);
        } else {
            ArrayPush(matched_compensations, true);
        }
        compensation_row = compensation_row + 1;
    }
    let local_row: Int = 0;
    while local_row < routines.block_instruction_counts[block_row] {
        let global_row: Int = routines.block_instruction_starts[block_row] +
            local_row;
        let scalar: MirRoutineInstructionScalarCapture =
            MirRoutineInstructionFactBundleAtGlobal(
                index.instruction_facts, global_row
            );
        if !scalar.valid || routines.instruction_kinds[global_row] !=
            "cleanup" {
            return "MIR intent rollback block is invalid";
        }
        if scalar.name == "RollbackPolicy" && scalar.arg0 == "full" {
            rollback_count = rollback_count + 1;
        } else if scalar.name == "CompensateIntentStep" &&
            scalar.arg0 != "" {
            let matched_row: Int = 0 - 1;
            compensation_row = 0;
            while compensation_row <
                    ArrayLength(plan.steps.compensations.transition_ids) {
                let owner_step: Int = MirIntentStepTransitionIndexByHandle(
                    plan.steps,
                    plan.steps.compensations.transition_ids[compensation_row]
                );
                if owner_step >= 0 && !matched_compensations[compensation_row] &&
                    plan.steps.routine_syntax_ids[owner_step] ==
                        routine_syntax_id &&
                    scalar.arg0 == plan.steps.step_names[owner_step] &&
                    scalar.slot_anchor == plan.steps.step_names[owner_step] &&
                    scalar.arg1 == plan.steps.compensations.call_target_names[
                        compensation_row
                    ] {
                    matched_row = compensation_row;
                    break;
                }
                compensation_row = compensation_row + 1;
            }
            if matched_row < 0 {
                return "MIR intent rollback compensation identity is invalid";
            }
            ArraySet(matched_compensations, matched_row, true);
            compensation_count = compensation_count + 1;
        } else if scalar.name == "AbortIntent" &&
            scalar.arg0 == intent_name && scalar.arg1 == "full" &&
            scalar.slot_anchor == intent_name {
            abort_count = abort_count + 1;
        } else if scalar.name == "cleanup-edge-from-rollback" &&
            scalar.arg0 == "cleanup" {
            edge_count = edge_count + 1;
        } else {
            return "MIR intent rollback carrier is invalid";
        }
        local_row = local_row + 1;
    }
    let expected_compensation_count: Int = 0;
    compensation_row = 0;
    while compensation_row < ArrayLength(matched_compensations) {
        let owner_step: Int = MirIntentStepTransitionIndexByHandle(
            plan.steps,
            plan.steps.compensations.transition_ids[compensation_row]
        );
        if owner_step >= 0 &&
            plan.steps.routine_syntax_ids[owner_step] == routine_syntax_id {
            expected_compensation_count = expected_compensation_count + 1;
            if !matched_compensations[compensation_row] {
                return "MIR intent rollback compensation identity is missing";
            }
        }
        compensation_row = compensation_row + 1;
    }
    if rollback_count != 1 || abort_count != 1 || edge_count != 1 ||
        compensation_count != expected_compensation_count {
        return "MIR intent rollback facts are incomplete";
    }
    return "";
}

func MirIntentInvalidationContractError(
    ref routines: MirProgramRoutineIndex,
    ref index: MirRoutineFactIndex,
    routine_row: Int
) -> String {
    let topology: MirIntentRoutineBlockTopology = MirIntentRoutineBlockTopologyFromIndex(routines, index, routine_row);
    if !topology.valid { return "MIR intent invalidation block topology is invalid"; }
    let edge_count: Int = 0;
    let detach_count: Int = 0;
    let instruction_row: Int = 0;
    while instruction_row < index.block_instruction_counts[topology.invalidation] {
        let instruction: MirRoutineInstructionView =
            MirRoutineInstructionViewAt(
                routines, routine_row, topology.invalidation, instruction_row
            );
        let scalar: MirRoutineInstructionScalarCapture =
            MirIntentCleanupScalarAt(index, instruction);
        if !instruction.valid || !scalar.valid ||
            instruction.kind != "cleanup" {
            return "MIR intent invalidation block is invalid";
        }
        if scalar.name == "DetachInvalidation" && scalar.arg0 != "" {
            detach_count = detach_count + 1;
        } else if scalar.name == "cleanup-edge-from-invalidation" &&
            scalar.arg0 == "cleanup" {
            edge_count = edge_count + 1;
        } else {
            return "MIR intent invalidation carrier is invalid";
        }
        instruction_row = instruction_row + 1;
    }
    if detach_count == 0 || edge_count != 1 {
        return "MIR intent invalidation facts are incomplete";
    }
    return "";
}

func MirIntentInvalidationContractErrorAtBlockId(
    ref routines: MirProgramRoutineIndex,
    ref index: MirRoutineFactIndex,
    routine_row: Int,
    block_id: Int
) -> String {
    let block_row: Int = MirIntentExecutionRoutineBlockRowById(
        routines, routine_row, block_id
    );
    if block_row < 0 { return "MIR intent invalidation block is missing"; }
    let edge_count: Int = 0;
    let detach_count: Int = 0;
    let local_row: Int = 0;
    while local_row < routines.block_instruction_counts[block_row] {
        let global_row: Int = routines.block_instruction_starts[block_row] +
            local_row;
        let scalar: MirRoutineInstructionScalarCapture =
            MirRoutineInstructionFactBundleAtGlobal(
                index.instruction_facts, global_row
            );
        if !scalar.valid || routines.instruction_kinds[global_row] !=
            "cleanup" {
            return "MIR intent invalidation block is invalid";
        }
        if scalar.name == "DetachInvalidation" && scalar.arg0 != "" {
            detach_count = detach_count + 1;
        } else if scalar.name == "cleanup-edge-from-invalidation" &&
            scalar.arg0 == "cleanup" {
            edge_count = edge_count + 1;
        } else {
            return "MIR intent invalidation carrier is invalid";
        }
        local_row = local_row + 1;
    }
    if detach_count == 0 || edge_count != 1 {
        return "MIR intent invalidation facts are incomplete";
    }
    return "";
}
