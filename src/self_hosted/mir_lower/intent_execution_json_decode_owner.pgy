// Exact field-order and scalar decoding for the native typed-intent JSON wire.
// This owner knows JSON shape only; semantic identity joins live elsewhere.

import "json_fact_read.pgy";

struct MirIntentExecutionExactFields {
    valid: Bool;
    starts: Array<Int>;
    ends: Array<Int>;
}
struct MirIntentExecutionStringValue {
    valid: Bool;
    value: String;
}

struct MirIntentExecutionIntValue {
    valid: Bool;
    value: Int;
}

struct MirIntentExecutionBoolValue {
    valid: Bool;
    value: Bool;
}

struct MirIntentExecutionStringArray {
    valid: Bool;
    values: Array<String>;
}

func MirIntentExecutionExactObjectFields(
    json: String, start: Int, end: Int, expected: Array<String>
) -> MirIntentExecutionExactFields {
    let starts: Array<Int> = [];
    let ends: Array<Int> = [];
    if start < 0 || end <= start + 1 ||
        JsonCharCodeAt(json, end, start) != JsonAsciiCode("{") {
        return MirIntentExecutionExactFields(false, starts, ends);
    }
    let cursor: Int = start + 1;
    let row: Int = 0;
    while row < ArrayLength(expected) {
        cursor = JsonSkipWhitespaceWithin(json, cursor, end);
        if row > 0 {
            if cursor >= end ||
                JsonCharCodeAt(json, end, cursor) != JsonAsciiCode(",") {
                return MirIntentExecutionExactFields(false, starts, ends);
            }
            cursor = JsonSkipWhitespaceWithin(json, cursor + 1, end);
        }
        if cursor >= end ||
            JsonCharCodeAt(json, end, cursor) != JsonAsciiCode("\"") {
            return MirIntentExecutionExactFields(false, starts, ends);
        }
        let key_end_opt: Option<Int> = JsonStringEndWithin(json, cursor, end);
        if !IsSome(key_end_opt) {
            return MirIntentExecutionExactFields(false, starts, ends);
        }
        let key_end: Int = UnwrapOption(key_end_opt);
        if !JsonObjectKeyEqualsWithin(
            json, cursor, key_end, expected[row]
        ) {
            return MirIntentExecutionExactFields(false, starts, ends);
        }
        cursor = JsonSkipWhitespaceWithin(json, key_end, end);
        if cursor >= end ||
            JsonCharCodeAt(json, end, cursor) != JsonAsciiCode(":") {
            return MirIntentExecutionExactFields(false, starts, ends);
        }
        cursor = JsonSkipWhitespaceWithin(json, cursor + 1, end);
        let value_end_opt: Option<Int> = JsonValueEndWithin(json, cursor, end);
        if !IsSome(value_end_opt) {
            return MirIntentExecutionExactFields(false, starts, ends);
        }
        let value_end: Int = UnwrapOption(value_end_opt);
        if value_end <= cursor {
            return MirIntentExecutionExactFields(false, starts, ends);
        }
        ArrayPush(starts, cursor);
        ArrayPush(ends, value_end);
        cursor = value_end;
        row = row + 1;
    }
    cursor = JsonSkipWhitespaceWithin(json, cursor, end);
    if cursor + 1 != end ||
        JsonCharCodeAt(json, end, cursor) != JsonAsciiCode("}") {
        return MirIntentExecutionExactFields(false, starts, ends);
    }
    return MirIntentExecutionExactFields(true, starts, ends);
}

func MirIntentExecutionStringAt(
    json: String, ref fields: MirIntentExecutionExactFields,
    row: Int, nullable: Bool
) -> MirIntentExecutionStringValue {
    if !fields.valid || row < 0 || row >= ArrayLength(fields.starts) ||
        row >= ArrayLength(fields.ends) {
        return MirIntentExecutionStringValue(false, "");
    }
    let start: Int = fields.starts[row];
    let end: Int = fields.ends[row];
    if start < end &&
        JsonCharCodeAt(json, end, start) == JsonAsciiCode("\"") {
        let decoded_end: Array<Int> = [0];
        let value: String = ReadJsonStringBounded(
            json, start, end, decoded_end
        );
        return MirIntentExecutionStringValue(
            decoded_end[0] == end, value
        );
    }
    if nullable && end == start + 4 &&
        SubEqualsWithLen(json, end, start, 4, "null") {
        return MirIntentExecutionStringValue(true, "");
    }
    return MirIntentExecutionStringValue(false, "");
}

func MirIntentExecutionIntAt(
    json: String, ref fields: MirIntentExecutionExactFields, row: Int
) -> MirIntentExecutionIntValue {
    if !fields.valid || row < 0 || row >= ArrayLength(fields.starts) ||
        row >= ArrayLength(fields.ends) {
        return MirIntentExecutionIntValue(false, 0);
    }
    let text: String = Substring(
        json, fields.starts[row], fields.ends[row] - fields.starts[row]
    );
    if text == "" || ToString(ToInt(text)) != text || ToInt(text) < 0 {
        return MirIntentExecutionIntValue(false, 0);
    }
    return MirIntentExecutionIntValue(true, ToInt(text));
}

func MirIntentExecutionBoolAt(
    json: String, ref fields: MirIntentExecutionExactFields, row: Int
) -> MirIntentExecutionBoolValue {
    if !fields.valid || row < 0 || row >= ArrayLength(fields.starts) ||
        row >= ArrayLength(fields.ends) {
        return MirIntentExecutionBoolValue(false, false);
    }
    let start: Int = fields.starts[row];
    let end: Int = fields.ends[row];
    if end == start + 4 &&
        SubEqualsWithLen(json, end, start, 4, "true") {
        return MirIntentExecutionBoolValue(true, true);
    }
    if end == start + 5 &&
        SubEqualsWithLen(json, end, start, 5, "false") {
        return MirIntentExecutionBoolValue(true, false);
    }
    return MirIntentExecutionBoolValue(false, false);
}

func MirIntentExecutionStringArrayAt(
    json: String, ref fields: MirIntentExecutionExactFields, row: Int
) -> MirIntentExecutionStringArray {
    let values: Array<String> = [];
    if !fields.valid || row < 0 || row >= ArrayLength(fields.starts) ||
        row >= ArrayLength(fields.ends) {
        return MirIntentExecutionStringArray(false, values);
    }
    let start: Int = fields.starts[row];
    let end: Int = fields.ends[row];
    if start >= end ||
        JsonCharCodeAt(json, end, start) != JsonAsciiCode("[") {
        return MirIntentExecutionStringArray(false, values);
    }
    let cursor: Int = start + 1;
    let first: Bool = true;
    while cursor < end {
        cursor = JsonSkipWhitespaceWithin(json, cursor, end);
        if cursor < end &&
            JsonCharCodeAt(json, end, cursor) == JsonAsciiCode("]") {
            return MirIntentExecutionStringArray(cursor + 1 == end, values);
        }
        if !first {
            if cursor >= end ||
                JsonCharCodeAt(json, end, cursor) != JsonAsciiCode(",") {
                return MirIntentExecutionStringArray(false, values);
            }
            cursor = JsonSkipWhitespaceWithin(json, cursor + 1, end);
        }
        if cursor >= end ||
            JsonCharCodeAt(json, end, cursor) != JsonAsciiCode("\"") {
            return MirIntentExecutionStringArray(false, values);
        }
        let value_end: Array<Int> = [0];
        let value: String = ReadJsonStringBounded(
            json, cursor, end, value_end
        );
        if value_end[0] <= cursor || value == "" {
            return MirIntentExecutionStringArray(false, values);
        }
        ArrayPush(values, value);
        cursor = value_end[0];
        first = false;
    }
    return MirIntentExecutionStringArray(false, values);
}

func MirIntentExecutionObjectFieldOccurrenceCount(
    json: String, start: Int, end: Int, field: String
) -> Int {
    if start < 0 || end <= start ||
        JsonCharCodeAt(json, end, start) != JsonAsciiCode("{") {
        return 0;
    }
    let count: Int = 0;
    let cursor: Int = start + 1;
    while cursor < end {
        cursor = JsonSkipWhitespaceWithin(json, cursor, end);
        if cursor >= end ||
            JsonCharCodeAt(json, end, cursor) == JsonAsciiCode("}") {
            return count;
        }
        if JsonCharCodeAt(json, end, cursor) == JsonAsciiCode(",") {
            cursor = cursor + 1;
            continue;
        }
        if JsonCharCodeAt(json, end, cursor) != JsonAsciiCode("\"") {
            return 0;
        }
        let key_end_opt: Option<Int> = JsonStringEndWithin(json, cursor, end);
        if !IsSome(key_end_opt) { return 0; }
        let key_end: Int = UnwrapOption(key_end_opt);
        let matches: Bool = JsonObjectKeyEqualsWithin(
            json, cursor, key_end, field
        );
        cursor = JsonSkipWhitespaceWithin(json, key_end, end);
        if cursor >= end ||
            JsonCharCodeAt(json, end, cursor) != JsonAsciiCode(":") {
            return 0;
        }
        cursor = JsonSkipWhitespaceWithin(json, cursor + 1, end);
        let value_end_opt: Option<Int> = JsonValueEndWithin(json, cursor, end);
        if !IsSome(value_end_opt) { return 0; }
        if matches { count = count + 1; }
        cursor = UnwrapOption(value_end_opt);
    }
    return 0;
}

func MirIntentExecutionUniqueStringField(
    json: String, start: Int, end: Int, field: String
) -> MirIntentExecutionStringValue {
    if MirIntentExecutionObjectFieldOccurrenceCount(
        json, start, end, field
    ) != 1 {
        return MirIntentExecutionStringValue(false, "");
    }
    let value: Option<String> = JsonObjectStringFieldOptWithin(
        json, start, end, field
    );
    if !IsSome(value) {
        return MirIntentExecutionStringValue(false, "");
    }
    return MirIntentExecutionStringValue(true, UnwrapOption(value));
}

func MirIntentExecutionUniqueIntField(
    json: String, start: Int, end: Int, field: String
) -> MirIntentExecutionIntValue {
    if MirIntentExecutionObjectFieldOccurrenceCount(
        json, start, end, field
    ) != 1 {
        return MirIntentExecutionIntValue(false, 0);
    }
    let value: Option<String> = JsonObjectNumberFieldOptWithin(
        json, start, end, field
    );
    if !IsSome(value) || UnwrapOption(value) == "" ||
        ToString(ToInt(UnwrapOption(value))) != UnwrapOption(value) ||
        ToInt(UnwrapOption(value)) < 0 {
        return MirIntentExecutionIntValue(false, 0);
    }
    return MirIntentExecutionIntValue(true, ToInt(UnwrapOption(value)));
}
