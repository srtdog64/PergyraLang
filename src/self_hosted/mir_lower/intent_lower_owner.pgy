// Executable intent MIR -> compact AST projection owner.
//
// This consumer reconstructs intent syntax only from admitted MIR carrier
// rows.  It never reads source text or searches the original AST.

import "routine_fact_index_owner.pgy";
import "structured_expression_emission_order_owner.pgy";

func MirIntentTreeAppendLine(text: String, line: String) -> String {
    return Concat(text, Concat(line, "\n"));
}

func MirIntentScalarAt(
    ref index: MirRoutineFactIndex,
    instruction: MirRoutineInstructionView
) -> MirRoutineInstructionScalarCapture {
    if !instruction.valid { return InvalidMirRoutineInstructionScalarCapture(); }
    return MirRoutineInstructionFactBundleAtGlobal(
        index.instruction_facts, instruction.global_row
    );
}

func MirIntentKnownSemanticCarrier(name: String) -> Bool {
    return name == "IntentBinding" || name == "IntentParticipant" ||
        name == "IntentValue" || name == "IntentStep" ||
        name == "IntentZoneWhere" || name == "IntentZoneAlias" ||
        name == "IntentInvalidationTarget" || name == "IntentWho" ||
        name == "IntentAuthorizedBy" || name == "IntentCauses" ||
        name == "IntentCheck" || name == "IntentEval";
}

func EmitMirIntentTreeAtRow(
    ref routines: MirProgramRoutineIndex,
    routine_row: Int,
    inout expression_order: MirStructuredExpressionEmissionOrder
) -> String {
    let index: MirRoutineFactIndex = BuildMirRoutineFactIndex(
        routines, routine_row
    );
    if !index.valid || routines.kinds[routine_row] != "intent" ||
        routines.owners[routine_row] != "" ||
        routines.receiver_carriages[routine_row] != "none" ||
        ArrayLength(index.block_instruction_counts) != 4 ||
        index.block_instruction_counts[0] <= 0 ||
        index.block_instruction_counts[1] != 0 ||
        index.block_instruction_counts[2] != 3 ||
        index.block_instruction_counts[3] < 2 {
        MirLowerFailClosed("MIR intent routine structure is invalid");
    }
    let intent_name: String = routines.names[routine_row];
    if intent_name == "" { MirLowerFailClosed("MIR intent name is missing"); }

    let carrier_names: Array<String> = [];
    let carrier_arg0s: Array<String> = [];
    let carrier_arg1s: Array<String> = [];
    let carrier_slots: Array<String> = [];
    let carrier_expr0s: Array<String> = [];
    let carrier_rows: Array<Int> = [];
    let resource_names: Array<String> = [];
    let resource_arg0s: Array<String> = [];
    let resource_arg1s: Array<String> = [];
    let resource_slots: Array<String> = [];
    let executable_step_exprs: Array<String> = [];
    let executable_step_rows: Array<Int> = [];
    let commit_count: Int = 0;
    let block0_count: Int = MirProgramRoutineIndexBlockInstructionCountAt(
        routines, routine_row, 0
    );
    let instruction_row: Int = 0;
    while instruction_row < block0_count {
        let instruction: MirRoutineInstructionView =
            MirRoutineInstructionViewAt(
                routines, routine_row, 0, instruction_row
            );
        let scalar: MirRoutineInstructionScalarCapture =
            MirIntentScalarAt(index, instruction);
        if !instruction.valid || !scalar.valid {
            MirLowerFailClosed("MIR intent instruction facts are invalid");
        }
        if instruction.kind == "resource-op" {
            if scalar.name != "CommitIntent" && scalar.name != "Read" &&
                scalar.name != "AttachEffect" && scalar.name != "Authorize" {
                MirLowerFailClosed("MIR intent resource carrier is unknown");
            }
            if scalar.name == "CommitIntent" {
                commit_count = commit_count + 1;
                if scalar.arg0 != intent_name ||
                    scalar.slot_anchor != intent_name {
                    MirLowerFailClosed("MIR intent commit identity is invalid");
                }
            }
            ArrayPush(resource_names, scalar.name);
            ArrayPush(resource_arg0s, scalar.arg0);
            ArrayPush(resource_arg1s, scalar.arg1);
            ArrayPush(resource_slots, scalar.slot_anchor);
        } else if instruction.kind == "stmt" &&
            MirIntentKnownSemanticCarrier(scalar.name) {
            ArrayPush(carrier_names, scalar.name);
            ArrayPush(carrier_arg0s, scalar.arg0);
            ArrayPush(carrier_arg1s, scalar.arg1);
            ArrayPush(carrier_slots, scalar.slot_anchor);
            ArrayPush(carrier_expr0s, scalar.expr0);
            ArrayPush(carrier_rows, instruction.global_row);
        } else if instruction.kind == "stmt" && scalar.name == "stmt" {
            if scalar.expr0 == "" &&
                instruction.source_type != "AST_INTENT_STEP" {
                MirLowerFailClosed("MIR intent executable step row is invalid");
            }
            if scalar.expr0 != "" {
                if instruction.source_type == "" {
                    MirLowerFailClosed(
                        "MIR intent executable expression type is missing"
                    );
                }
                ArrayPush(executable_step_exprs, scalar.expr0);
                ArrayPush(executable_step_rows, instruction.global_row);
            }
        } else if instruction.kind == "cleanup" &&
            scalar.name == "cleanup-edge" {
            if instruction_row + 1 != block0_count {
                MirLowerFailClosed("MIR intent cleanup edge is not terminal");
            }
        } else {
            MirLowerFailClosed("MIR intent block contains an unknown row");
        }
        instruction_row = instruction_row + 1;
    }
    if commit_count != 1 {
        MirLowerFailClosed("MIR intent commit carrier is missing or duplicated");
    }

    let binding_aliases: Array<String> = [];
    let binding_types: Array<String> = [];
    let binding_kinds: Array<String> = [];
    let step_names: Array<String> = [];
    let carrier_row: Int = 0;
    while carrier_row < ArrayLength(carrier_names) {
        if carrier_names[carrier_row] == "IntentBinding" {
            let binding_kind: String = carrier_slots[carrier_row];
            if carrier_arg0s[carrier_row] == "" ||
                carrier_arg1s[carrier_row] == "" ||
                (binding_kind != "participant" && binding_kind != "value") {
                MirLowerFailClosed("MIR intent binding carrier is invalid");
            }
            ArrayPush(binding_aliases, carrier_arg0s[carrier_row]);
            ArrayPush(binding_types, carrier_arg1s[carrier_row]);
            ArrayPush(binding_kinds, binding_kind);
        } else if carrier_names[carrier_row] == "IntentStep" {
            if carrier_arg0s[carrier_row] == "" ||
                carrier_arg0s[carrier_row] != carrier_arg1s[carrier_row] ||
                carrier_slots[carrier_row] != carrier_arg0s[carrier_row] {
                MirLowerFailClosed("MIR intent step identity is invalid");
            }
            ArrayPush(step_names, carrier_arg0s[carrier_row]);
        }
        carrier_row = carrier_row + 1;
    }
    if ArrayLength(binding_aliases) == 0 || ArrayLength(step_names) == 0 {
        MirLowerFailClosed("MIR intent bindings or steps are missing");
    }

    let tree: String = MirIntentTreeAppendLine(
        "", Concat("  Intent: ", intent_name)
    );
    tree = MirIntentTreeAppendLine(tree, "    IntentMode: exclusive");

    let rollback_count: Int = 0;
    let abort_count: Int = 0;
    let rollback_edge_count: Int = 0;
    instruction_row = 0;
    while instruction_row < index.block_instruction_counts[2] {
        let instruction: MirRoutineInstructionView =
            MirRoutineInstructionViewAt(
                routines, routine_row, 2, instruction_row
            );
        let scalar: MirRoutineInstructionScalarCapture =
            MirIntentScalarAt(index, instruction);
        if !instruction.valid || !scalar.valid ||
            instruction.kind != "cleanup" {
            MirLowerFailClosed("MIR intent rollback block is invalid");
        }
        if scalar.name == "RollbackPolicy" && scalar.arg0 == "full" {
            rollback_count = rollback_count + 1;
        } else if scalar.name == "AbortIntent" &&
            scalar.arg0 == intent_name && scalar.arg1 == "full" &&
            scalar.slot_anchor == intent_name {
            abort_count = abort_count + 1;
        } else if scalar.name == "cleanup-edge-from-rollback" &&
            scalar.arg0 == "cleanup" {
            rollback_edge_count = rollback_edge_count + 1;
        } else {
            MirLowerFailClosed("MIR intent rollback carrier is invalid");
        }
        instruction_row = instruction_row + 1;
    }
    if rollback_count != 1 || abort_count != 1 || rollback_edge_count != 1 {
        MirLowerFailClosed("MIR intent rollback facts are incomplete");
    }
    tree = MirIntentTreeAppendLine(tree, "    IntentRollback: full");

    let binding_index: Int = 0;
    while binding_index < ArrayLength(binding_aliases) {
        let expected_carrier: String = "IntentParticipant";
        let row_prefix: String = "    IntentInvolves: ";
        if binding_kinds[binding_index] == "value" {
            expected_carrier = "IntentValue";
            row_prefix = "    IntentValue: ";
        }
        let match_count: Int = 0;
        carrier_row = 0;
        while carrier_row < ArrayLength(carrier_names) {
            if carrier_names[carrier_row] == expected_carrier &&
                carrier_arg0s[carrier_row] == binding_aliases[binding_index] &&
                carrier_arg1s[carrier_row] == binding_types[binding_index] &&
                carrier_slots[carrier_row] == intent_name {
                match_count = match_count + 1;
            }
            carrier_row = carrier_row + 1;
        }
        if match_count != 1 {
            MirLowerFailClosed("MIR intent ordered binding carrier is incomplete");
        }
        tree = MirIntentTreeAppendLine(tree, Concat(
            row_prefix, Concat(binding_aliases[binding_index], Concat(
                ": ", binding_types[binding_index]
            ))
        ));
        binding_index = binding_index + 1;
    }

    let step_index: Int = 0;
    while step_index < ArrayLength(step_names) {
        let step_name: String = step_names[step_index];
        let zone_name: String = "";
        let zone_alias: String = "";
        let who_name: String = "";
        let authority_name: String = "";
        let eval_text: String = "";
        let expect_text: String = "";
        let eval_row: Int = 0 - 1;
        let expect_row: Int = 0 - 1;
        let zone_count: Int = 0;
        let alias_count: Int = 0;
        let invalidation_count: Int = 0;
        let who_count: Int = 0;
        let authority_count: Int = 0;
        let cause_count: Int = 0;
        let eval_count: Int = 0;
        let expect_count: Int = 0;
        carrier_row = 0;
        while carrier_row < ArrayLength(carrier_names) {
            if carrier_arg1s[carrier_row] == step_name &&
                carrier_slots[carrier_row] == step_name {
                let carrier_name: String = carrier_names[carrier_row];
                if carrier_name == "IntentZoneWhere" {
                    zone_count = zone_count + 1;
                    zone_name = carrier_arg0s[carrier_row];
                } else if carrier_name == "IntentZoneAlias" {
                    alias_count = alias_count + 1;
                    zone_alias = carrier_arg0s[carrier_row];
                } else if carrier_name == "IntentInvalidationTarget" {
                    invalidation_count = invalidation_count + 1;
                } else if carrier_name == "IntentWho" {
                    who_count = who_count + 1;
                    who_name = carrier_arg0s[carrier_row];
                } else if carrier_name == "IntentAuthorizedBy" {
                    authority_count = authority_count + 1;
                    authority_name = carrier_arg0s[carrier_row];
                } else if carrier_name == "IntentCauses" {
                    cause_count = cause_count + 1;
                } else if carrier_name == "IntentEval" {
                    eval_count = eval_count + 1;
                    eval_text = carrier_expr0s[carrier_row];
                    eval_row = carrier_rows[carrier_row];
                } else if carrier_name == "IntentCheck" {
                    expect_count = expect_count + 1;
                    expect_text = carrier_expr0s[carrier_row];
                    expect_row = carrier_rows[carrier_row];
                }
            }
            carrier_row = carrier_row + 1;
        }
        if zone_count != 1 || alias_count != 1 ||
            invalidation_count != 1 || who_count != 1 ||
            authority_count != 1 || who_name == "" ||
            authority_name != who_name || cause_count > 1 ||
            eval_count != 1 ||
            expect_count > 1 || zone_name == "" || zone_alias == "" ||
            eval_text == "" || eval_row < 0 {
            MirLowerFailClosed("MIR intent step semantic carriers are incomplete");
        }
        let read_count: Int = 0;
        let authorize_count: Int = 0;
        let resource_row: Int = 0;
        while resource_row < ArrayLength(resource_names) {
            if resource_names[resource_row] == "Read" &&
                resource_arg0s[resource_row] == zone_alias &&
                resource_arg1s[resource_row] == step_name &&
                resource_slots[resource_row] == zone_alias {
                read_count = read_count + 1;
            }
            if resource_names[resource_row] == "Authorize" &&
                resource_arg0s[resource_row] == authority_name &&
                resource_arg1s[resource_row] == step_name &&
                resource_slots[resource_row] == authority_name {
                authorize_count = authorize_count + 1;
            }
            resource_row = resource_row + 1;
        }
        if read_count != 1 || authorize_count != 1 {
            MirLowerFailClosed("MIR intent step resource carrier is incomplete");
        }
        let executable_count: Int = 0;
        let executable_row: Int = 0 - 1;
        let executable_index: Int = 0;
        while executable_index < ArrayLength(executable_step_exprs) {
            if executable_step_exprs[executable_index] == eval_text {
                executable_count = executable_count + 1;
                executable_row = executable_step_rows[executable_index];
            }
            executable_index = executable_index + 1;
        }
        if executable_count != 1 {
            MirLowerFailClosed(
                "MIR intent executable and semantic step facts disagree"
            );
        }
        tree = MirIntentTreeAppendLine(
            tree, Concat("    IntentStep: ", step_name)
        );
        tree = MirIntentTreeAppendLine(
            tree, Concat("      Who: ", who_name)
        );
        tree = MirIntentTreeAppendLine(
            tree, Concat("      Using: ", zone_alias)
        );
        tree = MirIntentTreeAppendLine(
            tree, Concat("      AuthorizedBy: ", authority_name)
        );
        tree = MirIntentTreeAppendLine(
            tree, Concat("      On: ", eval_text)
        );
        if !MirStructuredExpressionEmissionOrderAppend(
            expression_order, executable_row, AstExpressionLaneAtom(), 0
        ) {
            MirLowerFailClosed("MIR intent On expression order is invalid");
        }
        if expect_count == 1 {
            if expect_text == "" || expect_row < 0 {
                MirLowerFailClosed("MIR intent Expect carrier is invalid");
            }
            tree = MirIntentTreeAppendLine(
                tree, Concat("      Expect: ", expect_text)
            );
            if !MirStructuredExpressionEmissionOrderAppend(
                expression_order, expect_row, AstExpressionLaneAtom(), 0
            ) {
                MirLowerFailClosed(
                    "MIR intent Expect expression order is invalid"
                );
            }
        }
        step_index = step_index + 1;
    }

    let invalidation_edge_count: Int = 0;
    let detach_count: Int = 0;
    instruction_row = 0;
    while instruction_row < index.block_instruction_counts[3] {
        let instruction: MirRoutineInstructionView =
            MirRoutineInstructionViewAt(
                routines, routine_row, 3, instruction_row
            );
        let scalar: MirRoutineInstructionScalarCapture =
            MirIntentScalarAt(index, instruction);
        if !instruction.valid || !scalar.valid ||
            instruction.kind != "cleanup" {
            MirLowerFailClosed("MIR intent invalidation block is invalid");
        }
        if scalar.name == "DetachInvalidation" && scalar.arg0 != "" {
            detach_count = detach_count + 1;
        } else if scalar.name == "cleanup-edge-from-invalidation" &&
            scalar.arg0 == "cleanup" {
            invalidation_edge_count = invalidation_edge_count + 1;
        } else {
            MirLowerFailClosed("MIR intent invalidation carrier is invalid");
        }
        instruction_row = instruction_row + 1;
    }
    if detach_count == 0 || invalidation_edge_count != 1 {
        MirLowerFailClosed("MIR intent invalidation facts are incomplete");
    }
    return tree;
}
