// Executable intent MIR -> compact AST projection owner.
//
// This consumer reconstructs intent syntax only from admitted MIR carrier
// rows.  It never reads source text or searches the original AST.

import "routine_fact_index_owner.pgy";
import "structured_expression_emission_order_owner.pgy";
import "intent_action_contract_owner.pgy";
import "intent_carrier_projection_owner.pgy";
import "intent_phase_projection_owner.pgy";
import "intent_phase_tree_owner.pgy";
import "intent_cleanup_contract_owner.pgy";
import "../hir/ast_text_scan_owner.pgy";

func EmitMirIntentTreeAtRow(
    ref routines: MirProgramRoutineIndex,
    routine_row: Int,
    inout expression_order: MirStructuredExpressionEmissionOrder
) -> String {
    let index: MirRoutineFactIndex = BuildMirRoutineFactIndex(
        routines, routine_row
    );
    if !MirIntentRoutineStructureReady(routines, index, routine_row) {
        MirLowerFailClosed("MIR intent routine structure is invalid");
    }
    let intent_name: String = routines.names[routine_row];
    if intent_name == "" { MirLowerFailClosed("MIR intent name is missing"); }

    let carrier_names: Array<String> = [];
    let carrier_arg0s: Array<String> = [];
    let carrier_arg1s: Array<String> = [];
    let carrier_slots: Array<String> = [];
    let carrier_results: Array<String> = [];
    let carrier_abi_type_names: Array<String> = [];
    let carrier_source_types: Array<String> = [];
    let carrier_expr0s: Array<String> = [];
    let carrier_rows: Array<Int> = [];
    let resource_names: Array<String> = [];
    let resource_arg0s: Array<String> = [];
    let resource_arg1s: Array<String> = [];
    let resource_slots: Array<String> = [];
    let executable_step_exprs: Array<String> = [];
    let executable_step_rows: Array<Int> = [];
    let commit_count: Int = 0;
    let block0_count: Int = MirProgramRoutineIndexBlockInstructionCountAt(
        routines, routine_row, 0
    );
    let instruction_row: Int = 0;
    while instruction_row < block0_count {
        let instruction: MirRoutineInstructionView =
            MirRoutineInstructionViewAt(
                routines, routine_row, 0, instruction_row
            );
        let scalar: MirRoutineInstructionScalarCapture =
            MirIntentScalarAt(index, instruction);
        if !instruction.valid || !scalar.valid {
            MirLowerFailClosed("MIR intent instruction facts are invalid");
        }
        if instruction.kind == "resource-op" {
            if scalar.name != "CommitIntent" && scalar.name != "Read" &&
                scalar.name != "AttachEffect" && scalar.name != "Authorize" {
                MirLowerFailClosed("MIR intent resource carrier is unknown");
            }
            if scalar.name == "CommitIntent" {
                commit_count = commit_count + 1;
                if scalar.arg0 != intent_name ||
                    scalar.slot_anchor != intent_name {
                    MirLowerFailClosed("MIR intent commit identity is invalid");
                }
            }
            ArrayPush(resource_names, scalar.name);
            ArrayPush(resource_arg0s, scalar.arg0);
            ArrayPush(resource_arg1s, scalar.arg1);
            ArrayPush(resource_slots, scalar.slot_anchor);
        } else if instruction.kind == "stmt" &&
            MirIntentKnownSemanticCarrier(scalar.name) {
            ArrayPush(carrier_names, scalar.name);
            ArrayPush(carrier_arg0s, scalar.arg0);
            ArrayPush(carrier_arg1s, scalar.arg1);
            ArrayPush(carrier_slots, scalar.slot_anchor);
            ArrayPush(carrier_results, scalar.result);
            ArrayPush(carrier_abi_type_names, scalar.abi_type_name);
            ArrayPush(carrier_source_types, instruction.source_type);
            ArrayPush(carrier_expr0s, scalar.expr0);
            ArrayPush(carrier_rows, instruction.global_row);
        } else if instruction.kind == "stmt" && scalar.name == "stmt" {
            if scalar.expr0 == "" &&
                instruction.source_type != "AST_INTENT_STEP" {
                MirLowerFailClosed("MIR intent executable step row is invalid");
            }
            if scalar.expr0 != "" {
                if instruction.source_type == "" {
                    MirLowerFailClosed(
                        "MIR intent executable expression type is missing"
                    );
                }
                ArrayPush(executable_step_exprs, scalar.expr0);
                ArrayPush(executable_step_rows, instruction.global_row);
            }
        } else if instruction.kind == "cleanup" &&
            scalar.name == "cleanup-edge" {
            if instruction_row + 1 != block0_count {
                MirLowerFailClosed("MIR intent cleanup edge is not terminal");
            }
        } else {
            MirLowerFailClosed("MIR intent block contains an unknown row");
        }
        instruction_row = instruction_row + 1;
    }
    if commit_count != 1 {
        MirLowerFailClosed("MIR intent commit carrier is missing or duplicated");
    }

    let binding_projection: MirIntentBindingProjection =
        MirIntentBindingProjectionFromCarriers(
            carrier_names, carrier_arg0s, carrier_arg1s, carrier_slots,
            intent_name
        );
    if !binding_projection.ok {
        MirLowerFailClosed("MIR intent bindings or steps are missing");
    }
    let binding_aliases: Array<String> = binding_projection.aliases;
    let binding_types: Array<String> = binding_projection.type_names;
    let binding_kinds: Array<String> = binding_projection.kinds;
    let step_names: Array<String> = binding_projection.step_names;
    let phase_projection: MirIntentPhaseProjection =
        MirIntentPhaseProjectionFromCarriers(
            routines, step_names, carrier_names, carrier_arg0s,
            carrier_arg1s, carrier_slots, carrier_results,
            carrier_abi_type_names, carrier_source_types, carrier_expr0s,
            carrier_rows
        );
    if !phase_projection.ok {
        MirLowerFailClosed(phase_projection.diagnostic_message);
    }
    let carrier_row: Int = 0;

    let tree: String = MirIntentTreeAppendLine(
        "", Concat("  Intent: ", intent_name)
    );
    tree = MirIntentTreeAppendLine(tree, "    IntentMode: exclusive");

    let rollback_error: String = MirIntentRollbackContractError(
        routines, index, routine_row, intent_name
    );
    if rollback_error != "" { MirLowerFailClosed(rollback_error); }
    tree = MirIntentTreeAppendLine(tree, "    IntentRollback: full");
    tree = Concat(tree, binding_projection.tree_lines);

    let total_outcome_carrier_count: Int = MirIntentCarrierCount(
        carrier_names, "IntentOutcomeBinding"
    );
    let outcome_result_names: Array<String> = [];
    let step_index: Int = 0;
    while step_index < ArrayLength(step_names) {
        let step_name: String = step_names[step_index];
        let zone_name: String = "";
        let zone_alias: String = "";
        let who_name: String = "";
        let authority_name: String = "";
        let eval_text: String = phase_projection.on_texts[step_index];
        let outcome_name: String = "";
        let outcome_type_name: String = "";
        let outcome_action_syntax_id: String = "";
        let eval_result: String = phase_projection.on_results[step_index];
        let eval_type_name: String =
            phase_projection.on_type_names[step_index];
        let eval_row: Int = phase_projection.on_rows[step_index];
        let zone_count: Int = 0;
        let alias_count: Int = 0;
        let invalidation_count: Int = 0;
        let who_count: Int = 0;
        let authority_count: Int = 0;
        let cause_count: Int = 0;
        let outcome_count: Int = 0;
        carrier_row = 0;
        while carrier_row < ArrayLength(carrier_names) {
            let carrier_name: String = carrier_names[carrier_row];
            let carrier_belongs_to_step: Bool =
                carrier_arg1s[carrier_row] == step_name &&
                ((carrier_name == "IntentOutcomeBinding" &&
                  carrier_slots[carrier_row] ==
                    carrier_results[carrier_row]) ||
                 (carrier_name != "IntentOutcomeBinding" &&
                  carrier_slots[carrier_row] == step_name));
            if carrier_belongs_to_step {
                if carrier_name == "IntentZoneWhere" {
                    zone_count = zone_count + 1;
                    zone_name = carrier_arg0s[carrier_row];
                } else if carrier_name == "IntentZoneAlias" {
                    alias_count = alias_count + 1;
                    zone_alias = carrier_arg0s[carrier_row];
                } else if carrier_name == "IntentInvalidationTarget" {
                    invalidation_count = invalidation_count + 1;
                } else if carrier_name == "IntentWho" {
                    who_count = who_count + 1;
                    who_name = carrier_arg0s[carrier_row];
                } else if carrier_name == "IntentAuthorizedBy" {
                    authority_count = authority_count + 1;
                    authority_name = carrier_arg0s[carrier_row];
                } else if carrier_name == "IntentCauses" {
                    cause_count = cause_count + 1;
                } else if carrier_name == "IntentOutcomeBinding" {
                    if carrier_source_types[carrier_row] !=
                            "AST_INTENT_STEP" ||
                        carrier_expr0s[carrier_row] != "" ||
                        carrier_arg0s[carrier_row] == "" ||
                        ToInt(carrier_arg0s[carrier_row]) <= 0 ||
                        ToString(ToInt(carrier_arg0s[carrier_row])) !=
                            carrier_arg0s[carrier_row] ||
                        MirObjectArrayStringFactCount(
                            routines.source_json,
                            routines.instruction_starts[
                                carrier_rows[carrier_row]
                            ],
                            routines.instruction_ends[
                                carrier_rows[carrier_row]
                            ],
                            "uses"
                        ) != 0 {
                        MirLowerFailClosed(
                            "MIR intent outcome carrier shape is invalid"
                        );
                    }
                    outcome_count = outcome_count + 1;
                    outcome_name = carrier_results[carrier_row];
                    outcome_type_name =
                        carrier_abi_type_names[carrier_row];
                    outcome_action_syntax_id = carrier_arg0s[carrier_row];
                }
            }
            carrier_row = carrier_row + 1;
        }
        if zone_count != 1 || alias_count != 1 ||
            invalidation_count != 1 || who_count != 1 ||
            authority_count != 1 || who_name == "" ||
            authority_name != who_name || cause_count > 1 ||
            zone_name == "" || zone_alias == "" ||
            eval_text == "" || eval_row < 0 {
            MirLowerFailClosed("MIR intent step semantic carriers are incomplete");
        }
        if outcome_count > 1 ||
            (outcome_count == 0 && eval_result != "") ||
            (outcome_count == 1 &&
                (!IsIdentifier(outcome_name) || outcome_type_name == "" ||
                 outcome_type_name == "Unknown" ||
                 outcome_type_name == "Void" ||
                 eval_result != outcome_name ||
                 eval_type_name != outcome_type_name)) {
            MirLowerFailClosed("MIR intent step outcome binding is invalid");
        }
        if outcome_count == 0 {
            if eval_type_name != "" {
                MirLowerFailClosed(
                    "MIR legacy intent step carries outcome type"
                );
            }
        } else {
            let prior_outcome: Int = 0;
            while prior_outcome < ArrayLength(outcome_result_names) {
                if outcome_result_names[prior_outcome] == outcome_name {
                    MirLowerFailClosed(
                        "MIR intent outcome result name is duplicated"
                    );
                }
                prior_outcome = prior_outcome + 1;
            }
            ArrayPush(outcome_result_names, outcome_name);
        }
        let read_count: Int = 0;
        let authorize_count: Int = 0;
        let resource_row: Int = 0;
        while resource_row < ArrayLength(resource_names) {
            if resource_names[resource_row] == "Read" &&
                resource_arg0s[resource_row] == zone_alias &&
                resource_arg1s[resource_row] == step_name &&
                resource_slots[resource_row] == zone_alias {
                read_count = read_count + 1;
            }
            if resource_names[resource_row] == "Authorize" &&
                resource_arg0s[resource_row] == authority_name &&
                resource_arg1s[resource_row] == step_name &&
                resource_slots[resource_row] == authority_name {
                authorize_count = authorize_count + 1;
            }
            resource_row = resource_row + 1;
        }
        if read_count != 1 || authorize_count != 1 {
            MirLowerFailClosed("MIR intent step resource carrier is incomplete");
        }
        let executable_count: Int = 0;
        let executable_row: Int = 0 - 1;
        let executable_index: Int = 0;
        while executable_index < ArrayLength(executable_step_exprs) {
            if executable_step_exprs[executable_index] == eval_text {
                executable_count = executable_count + 1;
                executable_row = executable_step_rows[executable_index];
            }
            executable_index = executable_index + 1;
        }
        if executable_count != 1 {
            MirLowerFailClosed(
                "MIR intent executable and semantic step facts disagree"
            );
        }
        let eval_action: MirIntentActionGraphFact =
            MirIntentActionGraphFromInstruction(
                routines, eval_row, eval_text
            );
        let executable_action: MirIntentActionGraphFact =
            MirIntentActionGraphFromInstruction(
                routines, executable_row, eval_text
            );
        if !eval_action.ok || !executable_action.ok ||
            eval_action.receiver_alias != executable_action.receiver_alias ||
            eval_action.action_name != executable_action.action_name ||
            eval_action.call_target_name !=
                executable_action.call_target_name {
            MirLowerFailClosed(
                "MIR intent action expression graph identity is invalid"
            );
        }
        let receiver_binding_row: Int = 0 - 1;
        let receiver_match_count: Int = 0;
        let binding_scan: Int = 0;
        while binding_scan < ArrayLength(binding_aliases) {
            if binding_aliases[binding_scan] == eval_action.receiver_alias {
                receiver_match_count = receiver_match_count + 1;
                receiver_binding_row = binding_scan;
            }
            if outcome_count == 1 &&
                binding_aliases[binding_scan] == outcome_name {
                MirLowerFailClosed(
                    "MIR intent outcome binding collides with a participant"
                );
            }
            binding_scan = binding_scan + 1;
        }
        if receiver_match_count != 1 || receiver_binding_row < 0 ||
            binding_kinds[receiver_binding_row] != "participant" {
            MirLowerFailClosed(
                "MIR intent action receiver binding is invalid"
            );
        }
        let receiver_type: String = binding_types[receiver_binding_row];
        if eval_action.call_target_name != Concat(
            receiver_type, Concat("_", eval_action.action_name)
        ) {
            MirLowerFailClosed(
                "MIR intent action call target identity is invalid"
            );
        }
        let action_contract: MirIntentActionContractFact =
            MirIntentActionContract(
                routines, receiver_type, eval_action.action_name
            );
        if !action_contract.ok ||
            (outcome_count == 1 && action_contract.return_type_name !=
                outcome_type_name) ||
            (outcome_count == 1 && action_contract.action_syntax_id !=
                outcome_action_syntax_id) {
            MirLowerFailClosed(
                "MIR intent action outcome contract is invalid"
            );
        }
        tree = MirIntentTreeAppendLine(
            tree, Concat("    IntentStep: ", step_name)
        );
        tree = MirIntentTreeAppendLine(
            tree, Concat("      Who: ", who_name)
        );
        tree = MirIntentTreeAppendLine(
            tree, Concat("      Using: ", zone_alias)
        );
        tree = MirIntentTreeAppendLine(
            tree, Concat("      AuthorizedBy: ", authority_name)
        );
        if outcome_count == 1 {
            tree = MirIntentTreeAppendLine(
                tree, Concat("      Outcome: ", outcome_name)
            );
        }
        let phase_tree: String = MirIntentPhaseTreeLines(
            phase_projection, step_index
        );
        if phase_tree == "" ||
            !MirIntentPhaseAppendExpressionOrder(
                phase_projection, step_index, executable_row,
                expression_order
            ) {
            MirLowerFailClosed(
                "MIR intent phase tree projection is invalid"
            );
        }
        tree = Concat(tree, phase_tree);
        step_index = step_index + 1;
    }
    if ArrayLength(outcome_result_names) != total_outcome_carrier_count {
        MirLowerFailClosed(
            "MIR intent outcome carrier step identity is invalid"
        );
    }

    let invalidation_error: String = MirIntentInvalidationContractError(
        routines, index, routine_row
    );
    if invalidation_error != "" { MirLowerFailClosed(invalidation_error); }
    return tree;
}
