// Exact MIR IntentMode carrier -> reconstructed AST mode row.
import "intent_routine_carrier_projection_owner.pgy";

struct MirIntentModeProjection {
    valid: Bool;
    diagnostic_message: String;
    mode: String;
}

// Carrier rows stay fields of the borrowed projection; the mode is copied out.
func MirIntentModeProjectionFromCarriers(
    intent_name: String, ref carriers: MirIntentRoutineCarrierProjection
) -> MirIntentModeProjection {
    let count: Int = ArrayLength(carriers.carrier_names);
    if intent_name == "" || ArrayLength(carriers.carrier_arg0s) != count ||
        ArrayLength(carriers.carrier_arg1s) != count ||
        ArrayLength(carriers.carrier_slots) != count ||
        ArrayLength(carriers.carrier_results) != count ||
        ArrayLength(carriers.carrier_abi_type_names) != count ||
        ArrayLength(carriers.carrier_source_types) != count ||
        ArrayLength(carriers.carrier_expr0s) != count {
        return MirIntentModeProjection(
            false, "MIR intent mode carrier arrays are misaligned", ""
        );
    }
    let matches: Int = 0;
    let mode: String = "";
    let row: Int = 0;
    while row < count {
        if carriers.carrier_names[row] == "IntentMode" {
            matches = matches + 1;
            if (carriers.carrier_arg0s[row] != "exclusive" &&
                carriers.carrier_arg0s[row] != "concurrent") ||
                carriers.carrier_arg1s[row] != intent_name ||
                carriers.carrier_slots[row] != intent_name ||
                carriers.carrier_results[row] != "" ||
                carriers.carrier_abi_type_names[row] != "" ||
                carriers.carrier_source_types[row] != "AST_INTENT_DECL" ||
                carriers.carrier_expr0s[row] != "" {
                return MirIntentModeProjection(
                    false, "MIR intent mode carrier shape is invalid", ""
                );
            }
            mode = Concat("", carriers.carrier_arg0s[row]);
        }
        row = row + 1;
    }
    if matches == 0 {
        return MirIntentModeProjection(
            false, "MIR intent mode carrier is missing", ""
        );
    }
    if matches != 1 {
        return MirIntentModeProjection(
            false, "MIR intent mode carrier is duplicated", ""
        );
    }
    return MirIntentModeProjection(true, "", mode);
}
