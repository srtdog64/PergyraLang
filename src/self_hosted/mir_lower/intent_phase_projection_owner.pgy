// One admitted intent phase plan derived from native-compatible MIR carriers.
// This owner validates phase vocabulary, exact step attachment, scalar shape,
// expression-graph presence, singleton cardinality, and ordered compensation.
// It never reads source or AST text.
import "routine_fact_index_owner.pgy";
import "intent_routine_carrier_projection_schema_owner.pgy";
import "intent_expression_carrier_contract_owner.pgy";
import "../mir/intent_phase_contract_owner.pgy";
struct MirIntentPhaseProjection {
    ok: Bool;
    diagnostic_message: String;
    success_text: String;
    success_row: Int;
    on_texts: Array<String>;
    on_results: Array<String>;
    on_type_names: Array<String>;
    on_rows: Array<Int>;
    guard_texts: Array<String>;
    guard_rows: Array<Int>;
    expect_texts: Array<String>;
    expect_rows: Array<Int>;
    post_texts: Array<String>;
    post_rows: Array<Int>;
    pre_texts: Array<String>;
    pre_rows: Array<Int>;
    invariant_texts: Array<String>;
    invariant_pre_rows: Array<Int>;
    invariant_post_rows: Array<Int>;
    compensate_starts: Array<Int>;
    compensate_counts: Array<Int>;
    compensate_texts: Array<String>;
    compensate_rows: Array<Int>;
    on_phases: Array<String>;
}
func MirIntentPhaseProjectionError(projection: MirIntentPhaseProjection, message: String
) -> MirIntentPhaseProjection {
    projection.ok = false;
    projection.diagnostic_message = message;
    return projection;
}
// The carrier spine is borrowed whole; phase rows keep owned text copies.
func MirIntentPhaseProjectionFromCarriers(ref routines: MirProgramRoutineIndex,
    routine_row: Int, typed_execution: Bool, step_names: Array<String>,
    ref carriers: MirIntentRoutineCarrierProjection) -> MirIntentPhaseProjection {
    let strings: Array<String> = [];
    let ints: Array<Int> = [];
    let projection: MirIntentPhaseProjection = MirIntentPhaseProjection(
        true, "", "", -1, strings, strings, strings, ints, strings, ints,
        strings, ints, strings, ints, strings, ints, strings, ints, ints,
        ints, ints, strings, ints, strings);
    var on_texts: Array<String> = [];
    var on_results: Array<String> = [];
    var on_type_names: Array<String> = [];
    var on_rows: Array<Int> = [];
    var on_phases: Array<String> = [];
    var guard_texts: Array<String> = [];
    var guard_rows: Array<Int> = [];
    var expect_texts: Array<String> = [];
    var expect_rows: Array<Int> = [];
    var post_texts: Array<String> = [];
    var post_rows: Array<Int> = [];
    var pre_texts: Array<String> = [];
    var pre_rows: Array<Int> = [];
    var invariant_texts: Array<String> = [];
    var invariant_pre_rows: Array<Int> = [];
    var invariant_post_rows: Array<Int> = [];
    var compensate_starts: Array<Int> = [];
    var compensate_counts: Array<Int> = [];
    var compensate_texts: Array<String> = [];
    var compensate_rows: Array<Int> = [];
    var success_text: String = "";
    var success_row: Int = -1;
    let count: Int = ArrayLength(carriers.carrier_names);
    if ArrayLength(carriers.carrier_arg0s) != count || ArrayLength(carriers.carrier_arg1s) != count ||
        ArrayLength(carriers.carrier_slots) != count || ArrayLength(carriers.carrier_results) != count ||
        ArrayLength(carriers.carrier_abi_type_names) != count ||
        ArrayLength(carriers.carrier_source_types) != count || ArrayLength(carriers.carrier_expr0s) != count ||
        ArrayLength(carriers.carrier_rows) != count || ArrayLength(step_names) == 0 {
        return MirIntentPhaseProjectionError(
            projection, "MIR intent phase carrier arrays are misaligned");
    }
    var step_i: Int = 0;
    var row: Int = 0;
    if !MirProgramRoutineIndexRowReady(routines, routine_row) ||
        routines.kinds[routine_row] != "intent" {
        return MirIntentPhaseProjectionError(projection, "MIR intent phase purpose identity is invalid");
    }
    while row < count {
        let name: String = carriers.carrier_names[row];
        if (name == "IntentCheck" || name == "IntentEval") && !(name == "IntentEval" &&
              carriers.carrier_arg0s[row] == "priority") {
            let shape_error: String = SelfMirIntentPhaseResultDiagnostic(
                name, carriers.carrier_arg0s[row], carriers.carrier_results[row], carriers.carrier_abi_type_names[row]);
            if shape_error != "" {
                return MirIntentPhaseProjectionError(projection, shape_error);
            }
            if name == "IntentCheck" && carriers.carrier_arg0s[row] == "success" {
                let global_row: Int = carriers.carrier_rows[row];
                if typed_execution || success_row >= 0 || global_row < 0 ||
                    global_row >= ArrayLength(routines.instruction_starts) ||
                    global_row >= ArrayLength(routines.instruction_ends) ||
                    carriers.carrier_arg1s[row] != routines.names[routine_row] ||
                    carriers.carrier_slots[row] != routines.names[routine_row] ||
                    routines.instruction_starts[global_row] < routines.starts[routine_row] ||
                    routines.instruction_ends[global_row] > routines.ends[routine_row] {
                    return MirIntentPhaseProjectionError(projection,
                        "MIR intent completion purpose or cardinality is invalid");
                }
                success_text = Concat("", carriers.carrier_expr0s[row]);
                success_row = global_row;
            } else {
                var step_match_count: Int = 0;
                step_i = 0;
                while step_i < ArrayLength(step_names) {
                    if step_names[step_i] == carriers.carrier_arg1s[row] {
                        step_match_count = step_match_count + 1;
                    }
                    step_i = step_i + 1;
                }
                if step_match_count != 1 || carriers.carrier_arg1s[row] == "" ||
                    carriers.carrier_slots[row] != carriers.carrier_arg1s[row] {
                    return MirIntentPhaseProjectionError(
                        projection, "MIR intent phase carrier step identity is invalid");
                }
            }
            if carriers.carrier_source_types[row] == "" || carriers.carrier_expr0s[row] == "" ||
                !MirIntentExpressionCarrierGraphPresent(routines, carriers.carrier_rows[row]) {
                return MirIntentPhaseProjectionError(
                    projection, "MIR intent phase carrier expression graph is missing");
            }
        }
        row = row + 1;
    }
    if !typed_execution && success_row < 0 {
        return MirIntentPhaseProjectionError(projection, "MIR intent completion expression is missing");
    }
    step_i = 0;
    while step_i < ArrayLength(step_names) {
        ArrayPush(compensate_starts, ArrayLength(compensate_texts));
        var compensate_count: Int = 0;
        var on_text: String = "";
        var on_result: String = "";
        var on_type_name: String = "";
        var on_row: Int = -1;
        var on_phase: String = "";
        var guard_text: String = "";
        var guard_row: Int = -1;
        var expect_text: String = "";
        var expect_row: Int = -1;
        var post_text: String = "";
        var post_row: Int = -1;
        var pre_text: String = "";
        var pre_row: Int = -1;
        var invariant_text: String = "";
        var invariant_pre_row: Int = -1;
        var invariant_post_row: Int = -1;
        row = 0;
        while row < count {
            if carriers.carrier_arg1s[row] == step_names[step_i] &&
                carriers.carrier_slots[row] == step_names[step_i] {
                let name: String = carriers.carrier_names[row];
                // The carrier owns this element. Projection mutates several
                // owned String arrays before the last phase comparison, so
                // retain one independent scalar snapshot for this row.
                let phase: String = Concat("", carriers.carrier_arg0s[row]);
                if name == "IntentEval" && (phase == "on" || phase == "intent") {
                    if on_row >= 0 {
                        return MirIntentPhaseProjectionError(
                            projection, "MIR intent on phase cardinality is invalid");
                    }
                    on_text = Concat("", carriers.carrier_expr0s[row]);
                    on_result = Concat("", carriers.carrier_results[row]);
                    on_type_name = Concat("", carriers.carrier_abi_type_names[row]);
                    on_row = carriers.carrier_rows[row];
                    on_phase = Concat("", phase);
                } else if name == "IntentCheck" && phase == "guard" {
                    if guard_row >= 0 {
                        return MirIntentPhaseProjectionError(
                            projection, "MIR intent guard phase cardinality is invalid");
                    }
                    guard_text = Concat("", carriers.carrier_expr0s[row]);
                    guard_row = carriers.carrier_rows[row];
                } else if name == "IntentCheck" && phase == "expect" {
                    if expect_row >= 0 {
                        return MirIntentPhaseProjectionError(
                            projection, "MIR intent expect phase cardinality is invalid");
                    }
                    expect_text = Concat("", carriers.carrier_expr0s[row]);
                    expect_row = carriers.carrier_rows[row];
                } else if name == "IntentCheck" && phase == "post" {
                    if post_row >= 0 {
                        return MirIntentPhaseProjectionError(
                            projection, "MIR intent post phase cardinality is invalid"
                        );
                    }
                    post_text = Concat("", carriers.carrier_expr0s[row]);
                    post_row = carriers.carrier_rows[row];
                } else if name == "IntentCheck" && phase == "pre" {
                    if pre_row >= 0 {
                        return MirIntentPhaseProjectionError(projection,
                            "MIR intent pre phase cardinality is invalid");
                    }
                    pre_text = Concat("", carriers.carrier_expr0s[row]);
                    pre_row = carriers.carrier_rows[row];
                } else if name == "IntentCheck" &&
                    (phase == "invariant-pre" || phase == "invariant-post") {
                    if (phase == "invariant-pre" && invariant_pre_row >= 0) ||
                        (phase == "invariant-post" && invariant_post_row >= 0) ||
                        (invariant_text != "" &&
                         invariant_text != carriers.carrier_expr0s[row]) {
                        return MirIntentPhaseProjectionError(projection,
                            "MIR intent invariant phase identity/cardinality is invalid");
                    }
                    if invariant_text == "" {
                        invariant_text = Concat("", carriers.carrier_expr0s[row]);
                    }
                    if phase == "invariant-pre" {
                        invariant_pre_row = carriers.carrier_rows[row];
                    } else {
                        invariant_post_row = carriers.carrier_rows[row];
                    }
                } else if name == "IntentEval" && phase == "compensate" {
                    ArrayPush(compensate_texts, Concat("", carriers.carrier_expr0s[row]));
                    ArrayPush(compensate_rows, carriers.carrier_rows[row]);
                    compensate_count = compensate_count + 1;
                }
            }
            row = row + 1;
        }
        if on_row < 0 {
            return MirIntentPhaseProjectionError(
                projection, "MIR intent on phase cardinality is invalid"
            );
        }
        if (invariant_pre_row >= 0 || invariant_post_row >= 0) &&
            !MirIntentInvariantCarrierGraphsEqual(routines,
                invariant_pre_row, invariant_post_row) {
            return MirIntentPhaseProjectionError(projection,
                "MIR intent invariant pre/post graphs do not share one expression");
        }
        ArrayPushOwnedString(on_texts, on_text);
        ArrayPushOwnedString(on_results, on_result);
        ArrayPushOwnedString(on_type_names, on_type_name);
        ArrayPush(on_rows, on_row);
        ArrayPushOwnedString(on_phases, on_phase);
        ArrayPushOwnedString(guard_texts, guard_text);
        ArrayPush(guard_rows, guard_row);
        ArrayPushOwnedString(expect_texts, expect_text);
        ArrayPush(expect_rows, expect_row);
        ArrayPushOwnedString(post_texts, post_text);
        ArrayPush(post_rows, post_row);
        ArrayPushOwnedString(pre_texts, pre_text);
        ArrayPush(pre_rows, pre_row);
        ArrayPushOwnedString(invariant_texts, invariant_text);
        ArrayPush(invariant_pre_rows, invariant_pre_row);
        ArrayPush(invariant_post_rows, invariant_post_row);
        ArrayPush(compensate_counts, compensate_count);
        step_i = step_i + 1;
    }
    return MirIntentPhaseProjection(
        true, "", success_text, success_row, on_texts, on_results, on_type_names, on_rows,
        guard_texts, guard_rows, expect_texts, expect_rows,
        post_texts, post_rows, pre_texts, pre_rows, invariant_texts,
        invariant_pre_rows, invariant_post_rows, compensate_starts, compensate_counts,
        compensate_texts, compensate_rows, on_phases
    );
}
