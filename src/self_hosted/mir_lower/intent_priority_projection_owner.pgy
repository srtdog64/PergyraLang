// Exact MIR intent priority carrier -> reconstructed AST priority row.
//
// This consumer never reads source or invents a priority expression. A
// missing carrier means the language default; a present carrier is unique.

import "intent_expression_carrier_contract_owner.pgy";
import "structured_expression_emission_order_owner.pgy";
import "intent_routine_carrier_projection_owner.pgy";

struct MirIntentPriorityProjection {
    valid: Bool;
    diagnostic_message: String;
    present: Bool;
    text: String;
    global_row: Int;
}

// Carrier rows stay fields of the borrowed projection; the text is copied out.
func MirIntentPriorityProjectionFromCarriers(
    ref routines: MirProgramRoutineIndex,
    intent_name: String, ref carriers: MirIntentRoutineCarrierProjection
) -> MirIntentPriorityProjection {
    let count: Int = ArrayLength(carriers.carrier_names);
    if intent_name == "" || ArrayLength(carriers.carrier_arg0s) != count ||
        ArrayLength(carriers.carrier_arg1s) != count ||
        ArrayLength(carriers.carrier_slots) != count ||
        ArrayLength(carriers.carrier_results) != count ||
        ArrayLength(carriers.carrier_abi_type_names) != count ||
        ArrayLength(carriers.carrier_source_types) != count ||
        ArrayLength(carriers.carrier_expr0s) != count ||
        ArrayLength(carriers.carrier_rows) != count {
        return MirIntentPriorityProjection(
            false, "MIR intent priority carrier arrays are misaligned",
            false, "", -1
        );
    }
    let matches: Int = 0;
    let text: String = "";
    let global_row: Int = 0 - 1;
    let row: Int = 0;
    while row < count {
        if carriers.carrier_names[row] == "IntentEval" &&
            carriers.carrier_arg0s[row] == "priority" {
            matches = matches + 1;
            if carriers.carrier_arg1s[row] != intent_name ||
                carriers.carrier_slots[row] != intent_name ||
                carriers.carrier_results[row] != "" ||
                carriers.carrier_abi_type_names[row] != "" ||
                carriers.carrier_source_types[row] == "" ||
                carriers.carrier_expr0s[row] == "" ||
                !MirIntentExpressionCarrierGraphPresent(
                    routines, carriers.carrier_rows[row]
                ) {
                return MirIntentPriorityProjection(
                    false, "MIR intent priority carrier shape is invalid",
                    false, "", -1
                );
            }
            text = Concat("", carriers.carrier_expr0s[row]);
            global_row = carriers.carrier_rows[row];
        }
        row = row + 1;
    }
    if matches > 1 {
        return MirIntentPriorityProjection(
            false, "MIR intent priority carrier is duplicated",
            false, "", -1
        );
    }
    if matches == 0 {
        return MirIntentPriorityProjection(true, "", false, "", -1);
    }
    return MirIntentPriorityProjection(true, "", true, text, global_row);
}

func MirIntentPriorityAppendExpressionOrder(
    ref priority: MirIntentPriorityProjection,
    inout expression_order: MirStructuredExpressionEmissionOrder
) -> Bool {
    if !priority.valid { return false; }
    if !priority.present { return true; }
    return MirStructuredExpressionEmissionOrderAppend(
        expression_order, priority.global_row, AstExpressionLaneAtom(), 0
    );
}
