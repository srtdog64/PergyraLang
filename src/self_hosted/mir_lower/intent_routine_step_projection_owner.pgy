// Tree and expression-order projection from the admitted Intent step plan.
// Placement, participant and action admission belong to the plan owner.
import "intent_routine_step_plan_owner.pgy";
import "intent_execution_tree_projection_owner.pgy";
import "intent_phase_tree_owner.pgy";
import "structured_expression_emission_order_owner.pgy";

func MirIntentRoutineStepTreeLines(
    ref plan: MirIntentRoutineStepPlan,
    ref intent_execution_plan: MirIntentExecutionPlan,
    ref phase_projection: MirIntentPhaseProjection,
    inout expression_order: MirStructuredExpressionEmissionOrder
) -> String {
    let tree: String = "";
    let step_index: Int = 0;
    while step_index < ArrayLength(plan.steps) {
        if plan.typed_execution {
            let step_header: String = MirIntentExecutionStepHeader(
                intent_execution_plan, plan.steps[step_index].typed_step_row, plan.steps[step_index].zone_alias);
            if step_header == "" {
                MirLowerFailClosed("typed MIR intent step header is invalid");
            }
            tree = MirIntentTreeAppendLine(tree, step_header);
        } else {
            tree = MirIntentTreeAppendLine(
                tree, Concat("    IntentStep: ", plan.steps[step_index].name));
            tree = MirIntentTreeAppendLine(
                tree, Concat("      Who: ", plan.steps[step_index].who_name));
        }
        if plan.steps[step_index].placement.present {
            tree = MirIntentTreeAppendLine(
                tree, Concat("      Using: ", plan.steps[step_index].zone_alias));
        }
        if !plan.typed_execution && plan.steps[step_index].authority_present {
            tree = MirIntentTreeAppendLine(
                tree, Concat("      AuthorizedBy: ", plan.steps[step_index].authority_name));
        }
        if plan.steps[step_index].outcome_name != "" {
            tree = MirIntentTreeAppendLine(
                tree, Concat("      Outcome: ", plan.steps[step_index].outcome_name));
        }
        let phase_tree: String = "";
        if plan.typed_execution {
            phase_tree = MirIntentExecutionPhaseTreeLines(
                phase_projection, step_index, intent_execution_plan,
                plan.steps[step_index].typed_step_row);
        } else {
            phase_tree = MirIntentPhaseTreeLines(
                phase_projection, step_index, plan.steps[step_index].nested_target);
        }
        if phase_tree == "" ||
            !MirIntentPhaseAppendExpressionOrder(
                phase_projection, step_index, plan.steps[step_index].on_row,
                plan.steps[step_index].nested_target, expression_order) {
            MirLowerFailClosed("MIR intent phase tree projection is invalid");
        }
        tree = Concat(tree, phase_tree);
        step_index = step_index + 1;
    }
    return tree;
}
