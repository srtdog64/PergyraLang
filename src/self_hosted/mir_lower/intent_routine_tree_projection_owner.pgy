// AST tree and expression-order projection from the admitted Intent routine.
// Routine semantics remain in intent_routine_plan_owner, shared with GraphPlan.
import "intent_routine_plan_owner.pgy";
import "intent_routine_step_projection_owner.pgy";
import "intent_execution_tree_projection_owner.pgy";
import "intent_execution_graph_mirror_owner.pgy";

func EmitMirIntentTreeAtRowWithExecutionPlan(
    ref routines: MirProgramRoutineIndex,
    routine_row: Int,
    inout expression_order: MirStructuredExpressionEmissionOrder,
    ref intent_execution_plan: MirIntentExecutionPlan
) -> String {
    let index: MirRoutineFactIndex = BuildMirRoutineFactIndex(routines, routine_row);
    let plan: MirIntentRoutinePlan = MirIntentRoutinePlanFromOwners(
        routines, index, routine_row, intent_execution_plan);
    if plan.typed_execution && !MirIntentExecutionCoverLegacyGraphMirrors(
            routines, routine_row, intent_execution_plan, plan.source_syntax_id,
            plan.typed_body_mirror_rows, expression_order) {
        MirLowerFailClosed("typed MIR intent legacy graph mirror multiset is inconsistent");
    }
    let tree: String = MirIntentTreeAppendLine("", Concat("  Intent: ", plan.name));
    if plan.typed_execution {
        let return_type: String = MirIntentExecutionReturnTypeForRoutine(
            intent_execution_plan, plan.source_syntax_id);
        if return_type == "" { MirLowerFailClosed("typed MIR intent result type is missing"); }
        tree = MirIntentTreeAppendLine(tree, Concat("    IntentReturns: ", return_type));
    }
    tree = MirIntentTreeAppendLine(tree, Concat("    IntentMode: ", plan.mode.mode));
    tree = MirIntentTreeAppendLine(tree, "    IntentRollback: full");
    if plan.priority.present {
        tree = MirIntentTreeAppendLine(tree, Concat("    IntentPriority: ", plan.priority.text));
    }
    if !MirIntentPriorityAppendExpressionOrder(plan.priority, expression_order) {
        MirLowerFailClosed("MIR intent priority expression order is invalid");
    }
    tree = Concat(tree, plan.bindings.tree_lines);
    tree = Concat(tree, MirIntentRoutineStepTreeLines(
        plan.steps, intent_execution_plan, plan.phases, expression_order));
    if plan.typed_execution {
        let terminals: String = MirIntentExecutionAppendTerminalLines(
            routines, routine_row, intent_execution_plan, plan.source_syntax_id, expression_order);
        if terminals == "" { MirLowerFailClosed("typed MIR intent terminals are incomplete"); }
        tree = Concat(tree, terminals);
    } else {
        if !MirStructuredExpressionEmissionOrderAppend(expression_order,
                plan.phases.success_row, AstExpressionLaneAtom(), 0) {
            MirLowerFailClosed("MIR intent completion expression order is invalid");
        }
        tree = MirIntentTreeAppendLine(tree, Concat("    IntentSuccess: ", plan.phases.success_text));
    }
    return tree;
}

func EmitMirIntentTreeAtRow(
    ref routines: MirProgramRoutineIndex,
    routine_row: Int,
    inout expression_order: MirStructuredExpressionEmissionOrder
) -> String {
    let plan: MirIntentExecutionPlan = MirIntentExecutionPlanEmpty(true, false);
    return EmitMirIntentTreeAtRowWithExecutionPlan(routines, routine_row, expression_order, plan);
}
