// Assemble an admitted step's exact actor, optional authority, and Zone
// boundary from responsibility-named declaration and subject-slot owners.

import "intent_carrier_projection_owner.pgy";
import "program_declaration_index_owner.pgy";
import "intent_step_subject_binding_owner.pgy";

struct MirIntentStepPlacementBinding {
    present: Bool;
    zone_binding_row: Int;
    actor_binding_row: Int;
    authority_binding_row: Int;
    zone_declaration_row: Int;
    actor_declaration_row: Int;
    authority_declaration_row: Int;
    actor_slot_field_row: Int;
    authority_slot_field_row: Int;
    actor_slot_source_syntax_id: String;
    authority_slot_source_syntax_id: String;
    actor_slot_name: String;
    authority_slot_name: String;
    authority_present: Bool;
}

func MirIntentStepPlacementBindingFromOwners(
    ref declarations: MirProgramDeclarationIndex,
    ref bindings: MirIntentBindingProjection, present: Bool,
    zone_name: String, zone_alias: String, actor: Int,
    authority_present: Bool, authority_alias: String
) -> MirIntentStepPlacementBinding {
    if !present {
        if authority_present || authority_alias != "" {
            MirLowerFailClosed(
                "MIR intent authority cannot escape an absent placement"
            );
        }
        return MirIntentStepPlacementBinding(
            false, -1, -1, -1, -1, -1, -1, -1, -1,
            "", "", "", "", false
        );
    }
    if !declarations.valid || !bindings.ok ||
        authority_present != (authority_alias != "") {
        MirLowerFailClosed("MIR intent placement owners are invalid");
    }
    let zone: Int = MirIntentBindingRowForAlias(bindings, zone_alias);
    let zone_declaration: Int =
        MirProgramDeclarationFieldIdentityDeclarationIndex(
            declarations.field_identities, zone_name
        );
    if zone < 0 || zone >= ArrayLength(bindings.aliases) ||
        actor < 0 || actor >= ArrayLength(bindings.aliases) || actor == zone ||
        bindings.type_names[zone] != zone_name ||
        zone_declaration < 0 ||
        declarations.field_identities.declaration_nominal_kinds[
            zone_declaration
        ] != "zone" {
        MirLowerFailClosed(
            "MIR intent placement nominal declarations are inconsistent"
        );
    }
    let actor_binding: MirIntentStepSubjectBinding =
        MirIntentStepSubjectBindingFromOwners(
            declarations, bindings, zone_declaration, actor,
            bindings.aliases[actor], false
        );
    let authority_binding: MirIntentStepSubjectBinding =
        MirIntentStepSubjectBindingEmpty();
    if authority_present {
        let authority: Int =
            MirIntentBindingRowForAlias(bindings, authority_alias);
        if authority == zone {
            MirLowerFailClosed(
                "MIR intent authority participant is missing or invalid"
            );
        }
        authority_binding = MirIntentStepSubjectBindingFromOwners(
            declarations, bindings, zone_declaration, authority,
            authority_alias, true
        );
    }
    return MirIntentStepPlacementBinding(
        true, zone, actor_binding.binding_row,
        authority_binding.binding_row, zone_declaration,
        actor_binding.declaration_row, authority_binding.declaration_row,
        actor_binding.slot_field_row, authority_binding.slot_field_row,
        actor_binding.slot_source_syntax_id,
        authority_binding.slot_source_syntax_id,
        actor_binding.slot_name, authority_binding.slot_name,
        authority_present
    );
}
