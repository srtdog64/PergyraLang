// MIR JSON fact reader owner for self-hosted mir_lower.
//
// Generic JSON string-scan primitives live in ../lib/json.pgy. This module owns
// MIR-specific fact lookup so lowering owners do not rescan source text or hide
// schema decisions in their local control flow.

import "../lib/json.pgy";
import "../lib/json_bounded_fact_read.pgy";
import "../lib/json_fact_table.pgy";

struct MirDocumentFactIndex {
    let valid: Bool;
    let root: JsonObjectFactTable;
    let declarations: JsonArrayObjectFactTable;
    let domain_topology: JsonObjectFactTable;
    let domain_runtime_assignments: JsonObjectFactTable;
    let intent_execution: JsonObjectFactTable;
    let routines: JsonArrayObjectFactTable;
    let parallel_capture_boundaries: JsonArrayObjectFactTable;
}

func BuildMirDocumentFactIndex(json: String) -> MirDocumentFactIndex {
    let root: JsonObjectFactTable = EmptyJsonObjectFactTable();
    let declarations: JsonArrayObjectFactTable =
        EmptyJsonArrayObjectFactTable();
    let domain_topology: JsonObjectFactTable = EmptyJsonObjectFactTable();
    let domain_runtime_assignments: JsonObjectFactTable =
        EmptyJsonObjectFactTable();
    let intent_execution: JsonObjectFactTable = EmptyJsonObjectFactTable();
    let routines: JsonArrayObjectFactTable = EmptyJsonArrayObjectFactTable();
    let boundaries: JsonArrayObjectFactTable =
        EmptyJsonArrayObjectFactTable();
    let intent_execution_seen: Bool = false;
    let n: Int = StringLength(json);
    if n <= 0 || JsonCharCodeAt(json, n, 0) != JsonAsciiCode("{") {
        return MirDocumentFactIndex(
            false, root, declarations, domain_topology,
            domain_runtime_assignments, intent_execution, routines, boundaries
        );
    }
    let cursor: Int = 1;
    while cursor < n {
        cursor = JsonSkipWhitespaceWithin(json, cursor, n);
        if cursor >= n { break; }
        let code: Int = JsonCharCodeAt(json, n, cursor);
        if code == JsonAsciiCode("}") {
            root = JsonObjectFactTable(true, json, 0, cursor + 1);
            return MirDocumentFactIndex(
                true, root, declarations, domain_topology,
                domain_runtime_assignments, intent_execution, routines, boundaries
            );
        }
        if code == JsonAsciiCode(",") {
            cursor = cursor + 1;
            continue;
        }
        if code != JsonAsciiCode("\"") { break; }
        let key_start: Int = cursor;
        let key_end_opt: Option<Int> = JsonStringEndWithin(
            json, key_start, n
        );
        if !IsSome(key_end_opt) { break; }
        let key_end: Int = UnwrapOption(key_end_opt);
        cursor = JsonSkipWhitespaceWithin(json, key_end, n);
        if cursor >= n ||
            JsonCharCodeAt(json, n, cursor) != JsonAsciiCode(":") {
            break;
        }
        let value_start: Int = JsonSkipWhitespaceWithin(
            json, cursor + 1, n
        );
        let value_end_opt: Option<Int> = JsonValueEndWithin(
            json, value_start, n
        );
        if !IsSome(value_end_opt) { break; }
        let value_end: Int = UnwrapOption(value_end_opt);
        let is_intent_execution: Bool = JsonObjectKeyEqualsWithin(
            json, key_start, key_end, "intent_execution"
        );
        if is_intent_execution && intent_execution_seen {
            break;
        }
        if value_start < value_end &&
            JsonCharCodeAt(json, value_end, value_start) ==
                JsonAsciiCode("[") {
            let table: JsonArrayObjectFactTable = JsonArrayObjectFactTable(
                true, json, value_start, value_end
            );
            if JsonObjectKeyEqualsWithin(
                json, key_start, key_end, "decls"
            ) {
                declarations = table;
            } else if JsonObjectKeyEqualsWithin(
                json, key_start, key_end, "routines"
            ) {
                routines = table;
            } else if JsonObjectKeyEqualsWithin(
                json, key_start, key_end, "parallel_capture_boundaries"
            ) {
                boundaries = table;
            }
        } else if value_start < value_end &&
            JsonCharCodeAt(json, value_end, value_start) ==
                JsonAsciiCode("{") {
            if JsonObjectKeyEqualsWithin(
                json, key_start, key_end, "domain_topology"
            ) {
                domain_topology = JsonObjectFactTableFromBounds(
                    json, value_start, value_end
                );
            } else if JsonObjectKeyEqualsWithin(
                json, key_start, key_end, "domain_runtime_assignments"
            ) {
                domain_runtime_assignments = JsonObjectFactTableFromBounds(
                    json, value_start, value_end
                );
            } else if is_intent_execution {
                intent_execution = JsonObjectFactTableFromBounds(
                    json, value_start, value_end
                );
                intent_execution_seen = true;
            }
        } else if is_intent_execution {
            break;
        }
        cursor = value_end;
    }
    return MirDocumentFactIndex(
        false, root, declarations, domain_topology,
        domain_runtime_assignments, intent_execution, routines, boundaries
    );
}

func MirFactObjectStart(json: String, start: Int) -> Int {
    if start < 0 {
        return start;
    }
    let n: Int = StringLength(json);
    if JsonCharCodeAt(json, n, start) == JsonAsciiCode("{") {
        return start;
    }
    let i: Int = start - 1;
    while i >= 0 {
        let c: Int = JsonCharCodeAt(json, n, i);
        if c == JsonAsciiCode("{") {
            return i;
        }
        if c == JsonAsciiCode("}") || c == JsonAsciiCode("]") {
            return start;
        }
        i = i - 1;
    }
    return start;
}

func MirObjectStringFactAtBounds(
    json: String,
    start: Int,
    end: Int,
    field: String
) -> String {
    let value: Option<String> = JsonObjectStringFieldOptWithin(
        json, start, end, field
    );
    if !IsSome(value) { return ""; }
    return UnwrapOption(value);
}

func MirObjectNumberFactAtBounds(
    json: String,
    start: Int,
    end: Int,
    field: String
) -> String {
    let value: Option<String> = JsonObjectNumberFieldOptWithin(
        json, start, end, field
    );
    if !IsSome(value) { return ""; }
    return UnwrapOption(value);
}

func MirObjectFieldValueBoundsAtBounds(
    json: String,
    start: Int,
    end: Int,
    field: String,
    inout bounds: Array<Int>
) -> Bool {
    return JsonObjectFieldValueBoundsWithin(
        json, start, end, field, bounds
    );
}

func MirObjectArrayBoundsAtBounds(
    json: String,
    start: Int,
    end: Int,
    field: String,
    inout bounds: Array<Int>
) -> Bool {
    if !JsonObjectFieldValueBoundsWithin(
        json, start, end, field, bounds
    ) {
        return false;
    }
    return bounds[0] < bounds[1] &&
        JsonCharCodeAt(json, bounds[1], bounds[0]) == JsonAsciiCode("[");
}

func MirDocumentSchemaEquals(json: String, expected: String) -> Bool {
    return JsonDocumentFactStringFieldEquals(json, "schema", expected);
}

func MirObjectStringFact(json: String, start: Int, end: Int, field: String) -> String {
    let value: Option<String> = MirObjectStringFactOpt(json, start, end, field);
    if !IsSome(value) {
        return "";
    }
    return UnwrapOption(value);
}

func MirObjectStringFactOpt(json: String, start: Int, end: Int, field: String) -> Option<String> {
    return JsonObjectStringFieldOpt(json, MirFactObjectStart(json, start), end, field);
}

func MirObjectNumberFact(json: String, start: Int, end: Int, field: String) -> String {
    let value: Option<String> = MirObjectNumberFactOpt(json, start, end, field);
    if !IsSome(value) {
        return "";
    }
    return UnwrapOption(value);
}

func MirObjectNumberFactOpt(json: String, start: Int, end: Int, field: String) -> Option<String> {
    return JsonObjectNumberFieldOpt(json, MirFactObjectStart(json, start), end, field);
}

func MirObjectEnd(json: String, start: Int, limit: Int) -> Option<Int> {
    return JsonObjectEnd(json, MirFactObjectStart(json, start), limit);
}

func MirObjectFieldValueBounds(json: String, start: Int, end: Int, field: String, inout bounds: Array<Int>) -> Bool {
    return JsonObjectFieldValueBounds(json, MirFactObjectStart(json, start), end, field, bounds);
}

func MirObjectArrayStringFactAt(json: String, start: Int, end: Int, field: String, row: Int) -> String {
    return JsonObjectArrayStringAt(json, MirFactObjectStart(json, start), end, field, row);
}

func MirObjectArrayStringFactCount(json: String, start: Int, end: Int, field: String) -> Int {
    let bounds: Array<Int> = [0, 0];
    if !MirObjectArrayBounds(json, start, end, field, bounds) {
        return 0;
    }
    return JsonArrayStringCount(json, bounds[0], bounds[1]);
}

func MirObjectArrayBounds(json: String, start: Int, end: Int, field: String, inout bounds: Array<Int>) -> Bool {
    if !JsonObjectFieldValueBounds(json, MirFactObjectStart(json, start), end, field, bounds) {
        return false;
    }
    if bounds[0] >= bounds[1] {
        return false;
    }
    return JsonCharCodeAt(json, StringLength(json), bounds[0]) == JsonAsciiCode("[");
}

func MirObjectArrayObjectBoundsAt(
    json: String,
    start: Int,
    end: Int,
    field: String,
    row: Int,
    inout bounds: Array<Int>
) -> Bool {
    let array_bounds: Array<Int> = [0, 0];
    if !MirObjectArrayBounds(json, start, end, field, array_bounds) {
        return false;
    }
    return JsonArrayObjectBoundsAt(json, array_bounds[0], array_bounds[1], row, bounds);
}

func MirObjectArrayStringFactsAtBounds(
    json: String,
    start: Int,
    end: Int,
    field: String
) -> Array<String> {
    let values: Array<String> = [];
    let array_bounds: Array<Int> = [0, 0];
    if !MirObjectArrayBoundsAtBounds(
        json, start, end, field, array_bounds
    ) { return values; }
    let cursor: Int = array_bounds[0] + 1;
    while cursor < array_bounds[1] {
        cursor = JsonSkipWhitespaceWithin(json, cursor, array_bounds[1]);
        if cursor >= array_bounds[1] { return values; }
        let code: Int = JsonCharCodeAt(json, array_bounds[1], cursor);
        if code == JsonAsciiCode("]") { return values; }
        if code == JsonAsciiCode(",") {
            cursor = cursor + 1;
            continue;
        }
        if code != JsonAsciiCode("\"") { return values; }
        let value_end: Array<Int> = [0];
        let value: String = ReadJsonStringBounded(
            json, cursor, array_bounds[1], value_end
        );
        if value_end[0] <= cursor { return values; }
        ArrayPush(values, value);
        cursor = value_end[0];
    }
    return values;
}

func MirDeclArrayObjectFactTable(json: String) -> JsonArrayObjectFactTable {
    let root: JsonObjectFactTable = JsonDocumentObjectFactTable(json);
    return JsonObjectFactArrayObjectTable(root, "decls");
}

func MirDeclArrayBounds(json: String, inout bounds: Array<Int>) -> Bool {
    let table: JsonArrayObjectFactTable = MirDeclArrayObjectFactTable(json);
    if !JsonArrayObjectFactTableReady(table) {
        return false;
    }
    bounds[0] = table.start;
    bounds[1] = table.end;
    return true;
}

func MirDeclObjectBoundsAt(json: String, row: Int, inout bounds: Array<Int>) -> Bool {
    let declarations: JsonArrayObjectFactTable =
        MirDeclArrayObjectFactTable(json);
    let row_fact: JsonObjectFactTable =
        JsonArrayObjectFactAt(declarations, row);
    if !JsonObjectFactTableReady(row_fact) {
        return false;
    }
    bounds[0] = row_fact.start;
    bounds[1] = row_fact.end;
    return true;
}

// Resolve a payload-free enum variant to its declaration owner from the MIR
// declaration facts.  An empty result is deliberately ambiguous/unknown; the
// lowering layer must then fail closed instead of guessing a qualification.
func MirEnumOwnerForVariant(json: String, variant: String) -> String {
    if StringLength(variant) == 0 {
        return "";
    }
    let owner: String = "";
    let ambiguous: Bool = false;
    let decl_bounds: Array<Int> = [0, 0];
    let row: Int = 0;
    while MirDeclObjectBoundsAt(json, row, decl_bounds) {
        if MirObjectStringFact(json, decl_bounds[0], decl_bounds[1], "kind") == "enum" {
            let variants_bounds: Array<Int> = [0, 0];
            if MirObjectArrayBounds(json, decl_bounds[0], decl_bounds[1], "variants", variants_bounds) {
                let variant_bounds: Array<Int> = [0, 0];
                let variant_row: Int = 0;
                while MirObjectArrayObjectBoundsAt(
                    json, decl_bounds[0], decl_bounds[1], "variants",
                    variant_row, variant_bounds
                ) {
                    let name: String = MirObjectStringFact(
                        json, variant_bounds[0], variant_bounds[1], "name");
                    if name == variant {
                        let enum_name: String = MirObjectStringFact(
                            json, decl_bounds[0], decl_bounds[1], "name");
                        if StringLength(enum_name) > 0 {
                            if StringLength(owner) == 0 {
                                owner = enum_name;
                            } else if owner != enum_name {
                                ambiguous = true;
                            }
                        }
                    }
                    variant_row = variant_row + 1;
                }
            }
        }
        row = row + 1;
    }
    if ambiguous {
        return "";
    }
    return owner;
}

func MirRoutineArrayObjectFactTable(json: String) -> JsonArrayObjectFactTable {
    let root: JsonObjectFactTable = JsonDocumentObjectFactTable(json);
    return JsonObjectFactArrayObjectTable(root, "routines");
}

func MirRoutineArrayBounds(json: String, inout bounds: Array<Int>) -> Bool {
    let table: JsonArrayObjectFactTable = MirRoutineArrayObjectFactTable(json);
    if !JsonArrayObjectFactTableReady(table) {
        return false;
    }
    bounds[0] = table.start;
    bounds[1] = table.end;
    return true;
}

func MirRoutineObjectBoundsAt(json: String, row: Int, inout bounds: Array<Int>) -> Bool {
    let routines: JsonArrayObjectFactTable =
        MirRoutineArrayObjectFactTable(json);
    let row_fact: JsonObjectFactTable =
        JsonArrayObjectFactAt(routines, row);
    if !JsonObjectFactTableReady(row_fact) {
        return false;
    }
    bounds[0] = row_fact.start;
    bounds[1] = row_fact.end;
    return true;
}
