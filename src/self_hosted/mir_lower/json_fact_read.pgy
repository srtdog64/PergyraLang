// MIR JSON fact reader owner for self-hosted mir_lower.
//
// Generic JSON string-scan primitives live in ../lib/json.pgy. This module owns
// MIR-specific fact lookup so lowering owners do not rescan source text or hide
// schema decisions in their local control flow.

import "../lib/json.pgy";
import "../lib/json_fact_table.pgy";

func MirFactObjectStart(json: String, start: Int) -> Int {
    if start < 0 {
        return start;
    }
    let n: Int = StringLength(json);
    if JsonCharCodeAt(json, n, start) == JsonAsciiCode("{") {
        return start;
    }
    let i: Int = start - 1;
    while i >= 0 {
        let c: Int = JsonCharCodeAt(json, n, i);
        if c == JsonAsciiCode("{") {
            return i;
        }
        if c == JsonAsciiCode("}") || c == JsonAsciiCode("]") {
            return start;
        }
        i = i - 1;
    }
    return start;
}

func MirDocumentSchemaEquals(json: String, expected: String) -> Bool {
    return JsonDocumentFactStringFieldEquals(json, "schema", expected);
}

func MirObjectStringFact(json: String, start: Int, end: Int, field: String) -> String {
    let value: Option<String> = MirObjectStringFactOpt(json, start, end, field);
    if !IsSome(value) {
        return "";
    }
    return UnwrapOption(value);
}

func MirObjectStringFactOpt(json: String, start: Int, end: Int, field: String) -> Option<String> {
    return JsonObjectStringFieldOpt(json, MirFactObjectStart(json, start), end, field);
}

func MirObjectNumberFact(json: String, start: Int, end: Int, field: String) -> String {
    let value: Option<String> = MirObjectNumberFactOpt(json, start, end, field);
    if !IsSome(value) {
        return "";
    }
    return UnwrapOption(value);
}

func MirObjectNumberFactOpt(json: String, start: Int, end: Int, field: String) -> Option<String> {
    return JsonObjectNumberFieldOpt(json, MirFactObjectStart(json, start), end, field);
}

func MirObjectEnd(json: String, start: Int, limit: Int) -> Option<Int> {
    return JsonObjectEnd(json, MirFactObjectStart(json, start), limit);
}

func MirObjectFieldValueBounds(json: String, start: Int, end: Int, field: String, inout bounds: Array<Int>) -> Bool {
    return JsonObjectFieldValueBounds(json, MirFactObjectStart(json, start), end, field, bounds);
}

func MirObjectArrayStringFactAt(json: String, start: Int, end: Int, field: String, row: Int) -> String {
    return JsonObjectArrayStringAt(json, MirFactObjectStart(json, start), end, field, row);
}

func MirObjectArrayStringFactCount(json: String, start: Int, end: Int, field: String) -> Int {
    let bounds: Array<Int> = [0, 0];
    if !MirObjectArrayBounds(json, start, end, field, bounds) {
        return 0;
    }
    return JsonArrayStringCount(json, bounds[0], bounds[1]);
}

func MirObjectArrayBounds(json: String, start: Int, end: Int, field: String, inout bounds: Array<Int>) -> Bool {
    if !JsonObjectFieldValueBounds(json, MirFactObjectStart(json, start), end, field, bounds) {
        return false;
    }
    if bounds[0] >= bounds[1] {
        return false;
    }
    return JsonCharCodeAt(json, StringLength(json), bounds[0]) == JsonAsciiCode("[");
}

func MirObjectArrayObjectBoundsAt(
    json: String,
    start: Int,
    end: Int,
    field: String,
    row: Int,
    inout bounds: Array<Int>
) -> Bool {
    let array_bounds: Array<Int> = [0, 0];
    if !MirObjectArrayBounds(json, start, end, field, array_bounds) {
        return false;
    }
    return JsonArrayObjectBoundsAt(json, array_bounds[0], array_bounds[1], row, bounds);
}

func MirDeclArrayObjectFactTable(json: String) -> JsonArrayObjectFactTable {
    let root: JsonObjectFactTable = JsonDocumentObjectFactTable(json);
    return JsonObjectFactArrayObjectTable(root, "decls");
}

func MirDeclArrayBounds(json: String, inout bounds: Array<Int>) -> Bool {
    let table: JsonArrayObjectFactTable = MirDeclArrayObjectFactTable(json);
    if !JsonArrayObjectFactTableReady(table) {
        return false;
    }
    bounds[0] = table.start;
    bounds[1] = table.end;
    return true;
}

func MirDeclObjectBoundsAt(json: String, row: Int, inout bounds: Array<Int>) -> Bool {
    let row_fact: JsonObjectFactTable = JsonArrayObjectFactAt(MirDeclArrayObjectFactTable(json), row);
    if !JsonObjectFactTableReady(row_fact) {
        return false;
    }
    bounds[0] = row_fact.start;
    bounds[1] = row_fact.end;
    return true;
}

func MirRoutineArrayObjectFactTable(json: String) -> JsonArrayObjectFactTable {
    let root: JsonObjectFactTable = JsonDocumentObjectFactTable(json);
    return JsonObjectFactArrayObjectTable(root, "routines");
}

func MirRoutineArrayBounds(json: String, inout bounds: Array<Int>) -> Bool {
    let table: JsonArrayObjectFactTable = MirRoutineArrayObjectFactTable(json);
    if !JsonArrayObjectFactTableReady(table) {
        return false;
    }
    bounds[0] = table.start;
    bounds[1] = table.end;
    return true;
}

func MirRoutineObjectBoundsAt(json: String, row: Int, inout bounds: Array<Int>) -> Bool {
    let row_fact: JsonObjectFactTable = JsonArrayObjectFactAt(MirRoutineArrayObjectFactTable(json), row);
    if !JsonObjectFactTableReady(row_fact) {
        return false;
    }
    bounds[0] = row_fact.start;
    bounds[1] = row_fact.end;
    return true;
}
