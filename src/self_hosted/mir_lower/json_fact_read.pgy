// MIR JSON fact reader owner for self-hosted mir_lower.
//
// Generic JSON string-scan primitives live in ../lib/json.pgy. This module owns
// MIR-specific fact lookup so lowering owners do not rescan source text or hide
// schema decisions in their local control flow.

import "../lib/json.pgy";

func MirObjectStringFact(json: String, start: Int, end: Int, field: String) -> String {
    return JsonObjectStringField(json, start, end, field);
}

func MirObjectNumberFact(json: String, start: Int, end: Int, field: String) -> String {
    return JsonObjectNumberField(json, start, end, field);
}

func MirObjectArrayBounds(json: String, start: Int, end: Int, field: String, inout bounds: Array<Int>) -> Bool {
    if !JsonObjectFieldValueBounds(json, start, end, field, bounds) {
        return false;
    }
    if bounds[0] >= bounds[1] {
        return false;
    }
    return CharAt(json, bounds[0]) == "[";
}

func MirObjectArrayObjectBoundsAt(
    json: String,
    start: Int,
    end: Int,
    field: String,
    row: Int,
    inout bounds: Array<Int>
) -> Bool {
    let array_bounds: Array<Int> = [0, 0];
    if !MirObjectArrayBounds(json, start, end, field, array_bounds) {
        return false;
    }
    return JsonArrayObjectBoundsAt(json, array_bounds[0], array_bounds[1], row, bounds);
}

func MirDeclArrayBounds(json: String, inout bounds: Array<Int>) -> Bool {
    let doc_end: Int = JsonDocumentObjectEnd(json);
    if doc_end <= 0 {
        return false;
    }
    return JsonFieldArrayBounds(json, 0, doc_end, "decls", bounds);
}

func MirDeclObjectBoundsAt(json: String, row: Int, inout bounds: Array<Int>) -> Bool {
    let decls: Array<Int> = [0, 0];
    if !MirDeclArrayBounds(json, decls) {
        return false;
    }
    return JsonArrayObjectBoundsAt(json, decls[0], decls[1], row, bounds);
}

// Find a MIR source-local type fact in the current routine span. This is the
// self-hosted mirror of MIRRoutine::source_local_types; mir_lower uses it
// before the transitional statement text when reconstructing Let: lines.
func SourceLocalType(json: String, start: Int, end: Int, name: String) -> String {
    let sp: Int = FindFrom(json, "\"source_locals\":[", start);
    if sp < 0 || sp >= end {
        return "";
    }
    let pk: Int = FindFrom(json, "\"name\":", sp);
    while pk >= 0 && pk < end {
        let nq: Int = FindFrom(json, "\"", pk + 7);
        if nq < 0 || nq >= end {
            return "";
        }
        let ne: Array<Int> = [0];
        let n: String = ReadJsonString(json, nq, ne);
        let tk: Int = FindFrom(json, "\"type\":", ne[0]);
        if tk < 0 || tk >= end {
            return "";
        }
        let tq: Int = FindFrom(json, "\"", tk + 7);
        if tq < 0 || tq >= end {
            return "";
        }
        let te: Array<Int> = [0];
        let t: String = ReadJsonString(json, tq, te);
        if n == name {
            return t;
        }
        pk = FindFrom(json, "\"name\":", te[0]);
    }
    return "";
}
