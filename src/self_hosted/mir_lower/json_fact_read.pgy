// MIR JSON fact reader owner for self-hosted mir_lower.
//
// This module owns the string-level JSON accessors used by the MIR fact
// consumer. Lowering decisions stay in main/block owners; they should call these
// accessors instead of re-scanning raw JSON shape locally.

// Single-character substring at index `i` (the codegen subset has no native
// indexing builtin for strings).
func CharAt(s: String, i: Int) -> String {
    return Substring(s, i, 1);
}

// First index of `needle` in `hay` at or after offset `start`, or -1.
func FindFrom(hay: String, needle: String, start: Int) -> Int {
    let n: Int = StringLength(hay);
    if start < 0 {
        return -1;
    }
    if start > n {
        return -1;
    }
    let rest: String = Substring(hay, start, n - start);
    let k: Int = StringIndexOf(rest, needle);
    if k < 0 {
        return -1;
    }
    return start + k;
}

func JsonArrayEnd(json: String, open: Int, limit: Int) -> Int {
    let n: Int = StringLength(json);
    let i: Int = open;
    let depth: Int = 0;
    let in_string: Bool = false;
    let escape: Bool = false;
    while i < n && i < limit {
        let c: String = CharAt(json, i);
        if in_string {
            if escape {
                escape = false;
            } else if c == "\\" {
                escape = true;
            } else if c == "\"" {
                in_string = false;
            }
        } else if c == "\"" {
            in_string = true;
        } else if c == "[" {
            depth = depth + 1;
        } else if c == "]" {
            depth = depth - 1;
            if depth == 0 {
                return i;
            }
        }
        i = i + 1;
    }
    return -1;
}

func JsonObjectEnd(json: String, open: Int, limit: Int) -> Int {
    let n: Int = StringLength(json);
    let i: Int = open;
    let depth: Int = 0;
    let in_string: Bool = false;
    let escape: Bool = false;
    while i < n && i < limit {
        let c: String = CharAt(json, i);
        if in_string {
            if escape {
                escape = false;
            } else if c == "\\" {
                escape = true;
            } else if c == "\"" {
                in_string = false;
            }
        } else if c == "\"" {
            in_string = true;
        } else if c == "{" {
            depth = depth + 1;
        } else if c == "}" {
            depth = depth - 1;
            if depth == 0 {
                return i + 1;
            }
        }
        i = i + 1;
    }
    return -1;
}

// Read a JSON string literal whose opening quote is at index `open`. Returns the
// decoded value and sets end[0] to the index just past the closing quote.
// Handles \" \\ \n \r \t escapes.
func ReadJsonString(json: String, open: Int, inout end: Array<Int>) -> String {
    let n: Int = StringLength(json);
    let i: Int = open + 1;
    let out: String = "";
    while i < n {
        let c: String = CharAt(json, i);
        if c == "\"" {
            ArraySet(end, 0, i + 1);
            return out;
        }
        if c == "\\" {
            if i + 1 >= n {
                Die("truncated escape in JSON string");
            }
            let e: String = CharAt(json, i + 1);
            if e == "n" {
                out = Concat(out, "\n");
            } else if e == "r" {
                out = Concat(out, "\r");
            } else if e == "t" {
                out = Concat(out, "\t");
            } else if e == "\"" {
                out = Concat(out, "\"");
            } else if e == "\\" {
                out = Concat(out, "\\");
            } else {
                out = Concat(out, e);
            }
            i = i + 2;
        } else {
            out = Concat(out, c);
            i = i + 1;
        }
    }
    Die("unterminated JSON string");
    return "";
}

// Read a string-valued JSON field inside [start,end). Missing, null, or
// non-string fields return "" so callers can fail closed or skip unsupported
// non-statement facts without accepting malformed required facts.
func JsonFieldString(json: String, start: Int, end: Int, key: String) -> String {
    let p: Int = FindFrom(json, key, start);
    if p < 0 || p >= end {
        return "";
    }
    let vstart: Int = p + StringLength(key);
    if vstart >= end {
        return "";
    }
    if CharAt(json, vstart) != "\"" {
        return "";
    }
    let e: Array<Int> = [0];
    return ReadJsonString(json, vstart, e);
}

func IsDigitChar(c: String) -> Bool {
    return c == "0" || c == "1" || c == "2" || c == "3" || c == "4"
        || c == "5" || c == "6" || c == "7" || c == "8" || c == "9";
}

func JsonFieldNumber(json: String, start: Int, end: Int, key: String) -> String {
    let p: Int = FindFrom(json, key, start);
    if p < 0 || p >= end {
        return "";
    }
    let i: Int = p + StringLength(key);
    let n: Int = StringLength(json);
    let out: String = "";
    while i < n && i < end {
        let c: String = CharAt(json, i);
        if !IsDigitChar(c) {
            if StringLength(out) > 0 {
                return out;
            }
            return "";
        }
        out = Concat(out, c);
        i = i + 1;
    }
    return out;
}

// Find a MIR source-local type fact in the current routine span. This is the
// self-hosted mirror of MIRRoutine::source_local_types; `mir_lower` uses it
// before the transitional statement text when reconstructing `Let:` lines.
func SourceLocalType(json: String, start: Int, end: Int, name: String) -> String {
    let sp: Int = FindFrom(json, "\"source_locals\":[", start);
    if sp < 0 || sp >= end {
        return "";
    }
    let pk: Int = FindFrom(json, "\"name\":", sp);
    while pk >= 0 && pk < end {
        let nq: Int = FindFrom(json, "\"", pk + 7);
        if nq < 0 || nq >= end {
            return "";
        }
        let ne: Array<Int> = [0];
        let n: String = ReadJsonString(json, nq, ne);
        let tk: Int = FindFrom(json, "\"type\":", ne[0]);
        if tk < 0 || tk >= end {
            return "";
        }
        let tq: Int = FindFrom(json, "\"", tk + 7);
        if tq < 0 || tq >= end {
            return "";
        }
        let te: Array<Int> = [0];
        let t: String = ReadJsonString(json, tq, te);
        if n == name {
            return t;
        }
        pk = FindFrom(json, "\"name\":", te[0]);
    }
    return "";
}

func JsonFirstArrayString(json: String, start: Int, end: Int, key: String) -> String {
    let p: Int = FindFrom(json, key, start);
    if p < 0 || p >= end {
        return "";
    }
    let open: Int = FindFrom(json, "[", p);
    let close: Int = FindFrom(json, "]", open);
    if open < 0 || close < 0 || close >= end {
        return "";
    }
    let q: Int = FindFrom(json, "\"", open);
    if q < 0 || q >= close {
        return "";
    }
    let e: Array<Int> = [0];
    return ReadJsonString(json, q, e);
}
