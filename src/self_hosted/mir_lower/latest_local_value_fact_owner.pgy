// Canonical latest dominating ValueId for one source-local use point.

import "routine_definition_dominance_fact_owner.pgy";

func MirRoutineLatestDominatingLocalValueRow(
    ref index: MirRoutineFactIndex,
    ref value_names: Array<String>, ref value_local_rows: Array<Int>,
    local_row: Int, use_block: Int, use_instruction_row: Int
) -> Option<Int> {
    if local_row < 0 || ArrayLength(value_names) !=
            ArrayLength(value_local_rows) { return None; }
    let latest: Int = -1;
    let row: Int = 0;
    while row < ArrayLength(value_names) {
        let candidate: MirRoutineResultDefinitionFact =
            MirRoutineFactIndexUniqueResultDefinition(index, value_names[row]);
        if value_local_rows[row] == local_row &&
            MirRoutineDefinitionDominatesInstruction(
                index, candidate, use_block, use_instruction_row) {
            if latest >= 0 {
                let prior: MirRoutineResultDefinitionFact =
                    MirRoutineFactIndexUniqueResultDefinition(
                        index, value_names[latest]);
                if MirRoutineDefinitionStrictlyPrecedes(
                        index, prior, candidate) { latest = row;
                } else if !MirRoutineDefinitionStrictlyPrecedes(
                        index, candidate, prior) { return None; }
            } else { latest = row; }
        }
        row = row + 1;
    }
    if latest < 0 { return None; }
    return Some(latest);
}

func MirRoutineLatestDominatingLocalValueMatches(
    ref index: MirRoutineFactIndex,
    ref value_names: Array<String>,
    ref value_local_rows: Array<Int>,
    selected_value_row: Int,
    use_block: Int,
    use_instruction_row: Int
) -> Bool {
    if selected_value_row < 0 ||
        selected_value_row >= ArrayLength(value_names) ||
        ArrayLength(value_names) != ArrayLength(value_local_rows) {
        return false;
    }
    let latest_row: Option<Int> = MirRoutineLatestDominatingLocalValueRow(
        index, value_names, value_local_rows,
        value_local_rows[selected_value_row], use_block,
        use_instruction_row);
    if !IsSome(latest_row) { return false; }
    let latest_value: Int = UnwrapOption(latest_row);
    return selected_value_row == latest_value;
}
