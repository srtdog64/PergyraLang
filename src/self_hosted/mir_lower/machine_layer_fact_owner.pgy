// Self-hosted MIR machine-contact fact consumer.
//
// The native machine manifest remains the semantic SoT.  This module only
// consumes the checked projection row exported by the self-host runtime ABI
// owner and validates that every machine_layer object in MIR JSON still cites
// that identity and its operation mapping.  It must not invent a fallback
// operation or infer a device contact from syntax payloads.

import "json_fact_read.pgy";
import "program_routine_index_owner.pgy";
import "../compiler/machine_layer_runtime_projection_owner.pgy";
import "../compiler/machine_layer_declaration_consumer.pgy";

// Typed proof carrier for a MIR document admitted by the one machine-layer
// validator.  Consumers must carry the declaration used for admission with the
// JSON instead of validating the JSON and then accepting a separate declaration.
struct MirMachineLayerAdmittedJsonInput {
    let json: String;
    let machine_declaration: SelfHostMachineLayerDeclaration;
    let routines: MirProgramRoutineIndex;
}

func MirMachineLayerPressureStage(enabled: Bool, stage: String) -> Void {
    if enabled {
        Log(Concat("[driver-pressure-stage] ", stage));
    }
}

func MirMachineLayerContactIndex(operation: String) -> Int {
    let row: Int = 0;
    while row < CompilerRuntimeCallAbiMachineLayerContactCount() {
        if CompilerRuntimeCallAbiMachineLayerContactNameAt(row) == operation {
            return row;
        }
        row = row + 1;
    }
    return 0 - 1;
}

func MirMachineLayerObjectReady(
    json: String,
    start: Int,
    end: Int,
    declaration: SelfHostMachineLayerDeclaration
) -> Bool {
    let manifest: String = MirObjectStringFactAtBounds(
        json, start, end, "manifest");
    let operation: String = MirObjectStringFactAtBounds(
        json, start, end, "operation");
    let physical_grant: String = MirObjectStringFactAtBounds(
        json, start, end, "physical_grant");
    let physical_base: String = MirObjectNumberFactAtBounds(
        json, start, end, "physical_base");
    let physical_size: String = MirObjectNumberFactAtBounds(
        json, start, end, "physical_size");
    let physical_mode: String = MirObjectStringFactAtBounds(
        json, start, end, "physical_mode");
    let runtime_operation: String = MirObjectStringFactAtBounds(
        json, start, end, "runtime_operation");
    let contact_index: Int = MirMachineLayerContactIndex(operation);
    if !SelfHostMachineLayerDeclarationReady(declaration) ||
        manifest != CompilerRuntimeCallAbiMachineLayerManifestId() ||
        physical_grant != declaration.grant_id ||
        physical_base != ToString(declaration.grant_base) ||
        physical_size != ToString(declaration.grant_size) ||
        physical_mode != declaration.grant_mode ||
        contact_index < 0 ||
        runtime_operation != CompilerRuntimeCallAbiMachineLayerRuntimeOperationAt(contact_index) {
        return false;
    }
    return JsonObjectBoolFieldEqualsWithin(
            json, start, end,
            "hardware_adequate", true) &&
        JsonObjectBoolFieldEqualsWithin(
            json, start, end,
            "authority_required", true) &&
        JsonObjectBoolFieldEqualsWithin(
            json, start, end,
            "live_lease_required", true);
}

func MirMachineLayerInstructionReady(
    json: String,
    start: Int,
    end: Int,
    declaration: SelfHostMachineLayerDeclaration
) -> Bool {
    let contact_bounds: Array<Int> = [0 - 1, 0 - 1];
    let value_bounds: Array<Int> = [0 - 1, 0 - 1];
    if !JsonObjectTwoFieldValueBoundsWithin(
        json, start, end,
        "machine_contact_kind", "machine_layer",
        contact_bounds, value_bounds
    ) {
        return false;
    }
    let contact_kind: String = "";
    if contact_bounds[0] >= 0 {
        let contact_value_kind: Int = JsonCharCodeAt(
            json, contact_bounds[1], contact_bounds[0]
        );
        if contact_value_kind == JsonAsciiCode("\"") {
            let contact_end: Array<Int> = [0];
            contact_kind = ReadJsonStringBounded(
                json, contact_bounds[0], contact_bounds[1], contact_end
            );
            if contact_end[0] != contact_bounds[1] { return false; }
        } else if contact_value_kind != JsonAsciiCode("n") ||
            contact_bounds[0] + 4 != contact_bounds[1] ||
            !SubEqualsWithLen(
                json, contact_bounds[1], contact_bounds[0], 4, "null"
            ) {
            return false;
        }
    }
    if value_bounds[0] < 0 {
        return StringLength(contact_kind) == 0;
    }
    let value_kind: Int = JsonCharCodeAt(
        json, value_bounds[1], value_bounds[0]);
    if value_kind == JsonAsciiCode("n") {
        return StringLength(contact_kind) == 0 &&
            value_bounds[0] + 4 == value_bounds[1] &&
            SubEqualsWithLen(
                json, value_bounds[1], value_bounds[0], 4, "null"
            );
    }
    if value_kind != JsonAsciiCode("{") {
        return false;
    }
    return StringLength(contact_kind) > 0 &&
        contact_kind == MirObjectStringFactAtBounds(
            json, value_bounds[0], value_bounds[1], "operation") &&
        MirMachineLayerObjectReady(
            json, value_bounds[0], value_bounds[1], declaration
        );
}

func MirMachineLayerInstructionRuntimeOperation(
    json: String, start: Int, end: Int
) -> String {
    let value_bounds: Array<Int> = [0, 0];
    if !MirObjectFieldValueBoundsAtBounds(
        json, start, end, "machine_layer", value_bounds) {
        return "";
    }
    if JsonCharCodeAt(json, value_bounds[1], value_bounds[0]) !=
        JsonAsciiCode("{") {
        return "";
    }
    return MirObjectStringFactAtBounds(
        json, value_bounds[0], value_bounds[1], "runtime_operation");
}

// Validate all machine-layer objects without rebuilding the native manifest
// or walking source/AST data.  Missing/null machine_layer is permitted for
// non-contact instructions; a present malformed object is always fatal.
func MirMachineLayerRoutineIndexFactsReady(
    json: String,
    declaration: SelfHostMachineLayerDeclaration,
    ref routines: MirProgramRoutineIndex
) -> Bool {
    if !CompilerRuntimeCallAbiMachineLayerProjectionReady() {
        return false;
    }
    if !routines.valid { return false; }
    let routine_row: Int = 0;
    while routine_row < MirProgramRoutineIndexCount(routines) {
        let routine_start: Int = routines.starts[routine_row];
        let routine_end: Int = routines.ends[routine_row];
        let blocks_bounds: Array<Int> = [0, 0];
        if !MirObjectArrayBoundsAtBounds(
            json, routine_start, routine_end, "blocks", blocks_bounds) {
            return false;
        }
        let block_cursor: Int = blocks_bounds[0] + 1;
        let block_bounds: Array<Int> = [0, 0];
        while JsonArrayNextObjectBounds(
            json, block_cursor, blocks_bounds[1], block_bounds) {
            let instructions_bounds: Array<Int> = [0, 0];
            if MirObjectArrayBoundsAtBounds(
                json, block_bounds[0], block_bounds[1],
                "instructions", instructions_bounds) {
                let instruction_cursor: Int = instructions_bounds[0] + 1;
                let instruction_bounds: Array<Int> = [0, 0];
                while JsonArrayNextObjectBounds(
                    json, instruction_cursor, instructions_bounds[1],
                    instruction_bounds) {
                    if !MirMachineLayerInstructionReady(
                        json, instruction_bounds[0], instruction_bounds[1],
                        declaration) {
                        return false;
                    }
                    instruction_cursor = instruction_bounds[1];
                }
            }
            block_cursor = block_bounds[1];
        }
        routine_row = routine_row + 1;
    }
    return true;
}

func MirMachineLayerAdmitJsonInputObserved(
    json: String,
    machine_declaration: SelfHostMachineLayerDeclaration,
    observe_pressure: Bool
) -> Option<MirMachineLayerAdmittedJsonInput> {
    let document: MirDocumentFactIndex = BuildMirDocumentFactIndex(json);
    if !document.valid { return None; }
    return MirMachineLayerAdmitDocumentObserved(
        json, machine_declaration, document, observe_pressure
    );
}

func MirMachineLayerAdmitDocumentObserved(
    json: String,
    machine_declaration: SelfHostMachineLayerDeclaration,
    document: MirDocumentFactIndex,
    observe_pressure: Bool
) -> Option<MirMachineLayerAdmittedJsonInput> {
    if !document.valid { return None; }
    MirMachineLayerPressureStage(
        observe_pressure, "consumer:input:machine-layer:routine-index:start"
    );
    let routines: MirProgramRoutineIndex = BuildMirProgramRoutineIndexFromTable(
        document.routines
    );
    if !routines.valid {
        return None;
    }
    MirMachineLayerPressureStage(
        observe_pressure, "consumer:input:machine-layer:routine-index:done"
    );
    MirMachineLayerPressureStage(
        observe_pressure, "consumer:input:machine-layer:instruction-scan:start"
    );
    if !MirMachineLayerRoutineIndexFactsReady(
        json, machine_declaration, routines
    ) {
        return None;
    }
    MirMachineLayerPressureStage(
        observe_pressure, "consumer:input:machine-layer:instruction-scan:done"
    );
    return Some(MirMachineLayerAdmittedJsonInput(
        json, machine_declaration, routines
    ));
}

func MirMachineLayerAdmitJsonInput(
    json: String,
    machine_declaration: SelfHostMachineLayerDeclaration
) -> Option<MirMachineLayerAdmittedJsonInput> {
    return MirMachineLayerAdmitJsonInputObserved(
        json, machine_declaration, false
    );
}

func MirMachineLayerFactsReady(
    json: String,
    declaration: SelfHostMachineLayerDeclaration
) -> Bool {
    return IsSome(MirMachineLayerAdmitJsonInput(json, declaration));
}
