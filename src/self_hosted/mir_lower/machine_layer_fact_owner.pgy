// Self-hosted MIR machine-contact fact consumer.
//
// The native machine manifest remains the semantic SoT.  This module only
// consumes the checked projection row exported by the self-host runtime ABI
// owner and validates that every machine_layer object in MIR JSON still cites
// that identity and its operation mapping.  It must not invent a fallback
// operation or infer a device contact from syntax payloads.

import "json_fact_read.pgy";
import "domain_topology_fact_owner.pgy";
import "domain_topology_graph_plan_owner.pgy";
import "domain_runtime_assignment_fact_owner.pgy";
import "domain_runtime_plan_owner.pgy";
import "program_routine_index_owner.pgy";
import "intent_execution_plan_fact_owner.pgy";
import "program_declaration_index_owner.pgy";
import "../compiler/machine_layer_runtime_projection_owner.pgy";
import "../compiler/machine_layer_declaration_consumer.pgy";

// Domain-only admission receipt shared by the source semantic C path and the
// complete machine-layer consumer.  Domain codegen must not depend on routine
// machine contacts or intent-plan admission, but it must consume the exact
// same topology/assignment validators as that complete consumer.
struct MirDomainRuntimeAdmittedDocument {
    let document: MirDocumentFactIndex;
    let declarations: MirProgramDeclarationIndex;
    let domain_topology: MirDomainTopologyFacts;
    let domain_topology_plan: MirDomainTopologyGraphPlan;
    let domain_runtime_assignments: MirDomainRuntimeAssignmentFacts;
    let domain_runtime_plan: MirDomainRuntimePlan;
}

// Typed proof carrier for a MIR document admitted by the one machine-layer
// validator.  Consumers must carry the declaration used for admission with the
// JSON instead of validating the JSON and then accepting a separate declaration.
struct MirMachineLayerAdmittedJsonInput {
    let machine_declaration: SelfHostMachineLayerDeclaration;
    let document: MirDocumentFactIndex;
    let domain_topology: MirDomainTopologyFacts;
    let domain_topology_plan: MirDomainTopologyGraphPlan;
    let domain_runtime_assignments: MirDomainRuntimeAssignmentFacts;
    let domain_runtime_plan: MirDomainRuntimePlan;
    let routines: MirProgramRoutineIndex;
    let intent_execution_plan: MirIntentExecutionPlan;
    let domain_runtime_admission: MirDomainRuntimeAdmittedDocument;
}

func MirDomainRuntimeAdmitDocumentWithTopologyAndDeclarations(
    document: MirDocumentFactIndex,
    domain_topology: MirDomainTopologyFacts,
    declarations: MirProgramDeclarationIndex
) -> Option<MirDomainRuntimeAdmittedDocument> {
    if !document.valid ||
        !MirDomainTopologyDeclarationIndexReady(declarations) ||
        ((MirDomainTopologyRequiredForDocument(document) &&
            (!domain_topology.present || !domain_topology.valid)) ||
         (domain_topology.present && !domain_topology.valid)) {
        return None;
    }
    let domain_topology_plan: MirDomainTopologyGraphPlan =
        MirDomainTopologyGraphPlanFromFacts(domain_topology);
    if !MirDomainTopologyGraphPlanReady(domain_topology_plan) ||
        domain_topology_plan.present != domain_topology.present ||
        (domain_topology.present &&
            domain_topology_plan.domain_graph_id !=
                domain_topology.domain_graph_id) {
        return None;
    }
    let domain_runtime_assignments: MirDomainRuntimeAssignmentFacts =
        MirDomainRuntimeAssignmentFactsFromDocumentWithDeclarations(
            document, domain_topology, declarations
        );
    let runtime_assignments_required: Bool =
        MirDomainRuntimeAssignmentsRequiredForTopology(domain_topology);
    if (runtime_assignments_required &&
            (!domain_runtime_assignments.present ||
             !domain_runtime_assignments.valid)) ||
        (domain_runtime_assignments.present &&
            !domain_runtime_assignments.valid) {
        return None;
    }
    let domain_runtime_plan: MirDomainRuntimePlan =
        MirDomainRuntimePlanFromFacts(
            document, domain_topology, domain_runtime_assignments
        );
    if !MirDomainRuntimePlanReady(domain_runtime_plan) ||
        domain_runtime_plan.present != domain_runtime_assignments.present ||
        (runtime_assignments_required && !domain_runtime_plan.present) ||
        (domain_runtime_plan.present &&
            domain_runtime_plan.domain_graph_id !=
                domain_topology.domain_graph_id) {
        return None;
    }
    return Some(MirDomainRuntimeAdmittedDocument(
        document, declarations, domain_topology, domain_topology_plan,
        domain_runtime_assignments, domain_runtime_plan
    ));
}

func MirDomainRuntimeAdmitDocumentWithTopology(
    document: MirDocumentFactIndex,
    domain_topology: MirDomainTopologyFacts
) -> Option<MirDomainRuntimeAdmittedDocument> {
    let declarations: MirProgramDeclarationIndex =
        BuildMirProgramDeclarationIndexFromTable(document.declarations);
    return MirDomainRuntimeAdmitDocumentWithTopologyAndDeclarations(
        document, domain_topology, declarations
    );
}

func MirDomainRuntimeAdmitDocument(
    document: MirDocumentFactIndex
) -> Option<MirDomainRuntimeAdmittedDocument> {
    if !document.valid { return None; }
    let declarations: MirProgramDeclarationIndex =
        BuildMirProgramDeclarationIndexFromTable(document.declarations);
    let topology: MirDomainTopologyFacts =
        MirDomainTopologyFactsFromDocumentWithDeclarations(
            document, declarations
        );
    return MirDomainRuntimeAdmitDocumentWithTopologyAndDeclarations(
        document, topology, declarations
    );
}

func MirMachineLayerPressureStage(enabled: Bool, stage: String) -> Void {
    if enabled {
        Log(Concat("[driver-pressure-stage] ", stage));
    }
}

func MirMachineLayerContactIndex(operation: String) -> Int {
    let row: Int = 0;
    while row < CompilerRuntimeCallAbiMachineLayerContactCount() {
        if CompilerRuntimeCallAbiMachineLayerContactNameAt(row) == operation {
            return row;
        }
        row = row + 1;
    }
    return 0 - 1;
}

func MirMachineLayerObjectReady(
    json: String,
    start: Int,
    end: Int,
    declaration: SelfHostMachineLayerDeclaration
) -> Bool {
    let manifest: String = MirObjectStringFactAtBounds(
        json, start, end, "manifest");
    let operation: String = MirObjectStringFactAtBounds(
        json, start, end, "operation");
    let physical_grant: String = MirObjectStringFactAtBounds(
        json, start, end, "physical_grant");
    let physical_base: String = MirObjectNumberFactAtBounds(
        json, start, end, "physical_base");
    let physical_size: String = MirObjectNumberFactAtBounds(
        json, start, end, "physical_size");
    let physical_mode: String = MirObjectStringFactAtBounds(
        json, start, end, "physical_mode");
    let runtime_operation: String = MirObjectStringFactAtBounds(
        json, start, end, "runtime_operation");
    let contact_index: Int = MirMachineLayerContactIndex(operation);
    if !SelfHostMachineLayerDeclarationReady(declaration) ||
        manifest != CompilerRuntimeCallAbiMachineLayerManifestId() ||
        physical_grant != declaration.grant_id ||
        physical_base != ToString(declaration.grant_base) ||
        physical_size != ToString(declaration.grant_size) ||
        physical_mode != declaration.grant_mode ||
        contact_index < 0 ||
        runtime_operation != CompilerRuntimeCallAbiMachineLayerRuntimeOperationAt(contact_index) {
        return false;
    }
    return JsonObjectBoolFieldEqualsWithin(
            json, start, end,
            "hardware_adequate", true) &&
        JsonObjectBoolFieldEqualsWithin(
            json, start, end,
            "authority_required", true) &&
        JsonObjectBoolFieldEqualsWithin(
            json, start, end,
            "live_lease_required", true);
}

func MirMachineLayerInstructionBoundsReady(
    json: String,
    contact_start: Int,
    contact_end: Int,
    value_start: Int,
    value_end: Int,
    declaration: SelfHostMachineLayerDeclaration
) -> Bool {
    let contact_kind: String = "";
    if contact_start >= 0 {
        let contact_value_kind: Int = JsonCharCodeAt(
            json, contact_end, contact_start
        );
        if contact_value_kind == JsonAsciiCode("\"") {
            let decoded_end: Array<Int> = [0];
            contact_kind = ReadJsonStringBounded(
                json, contact_start, contact_end, decoded_end
            );
            if decoded_end[0] != contact_end { return false; }
        } else if contact_value_kind != JsonAsciiCode("n") ||
            contact_start + 4 != contact_end ||
            !SubEqualsWithLen(
                json, contact_end, contact_start, 4, "null"
            ) {
            return false;
        }
    }
    if value_start < 0 {
        return StringLength(contact_kind) == 0;
    }
    let value_kind: Int = JsonCharCodeAt(
        json, value_end, value_start);
    if value_kind == JsonAsciiCode("n") {
        return StringLength(contact_kind) == 0 &&
            value_start + 4 == value_end &&
            SubEqualsWithLen(
                json, value_end, value_start, 4, "null"
            );
    }
    if value_kind != JsonAsciiCode("{") {
        return false;
    }
    return StringLength(contact_kind) > 0 &&
        contact_kind == MirObjectStringFactAtBounds(
            json, value_start, value_end, "operation") &&
        MirMachineLayerObjectReady(
            json, value_start, value_end, declaration
        );
}

func MirMachineLayerInstructionReady(
    json: String,
    start: Int,
    end: Int,
    declaration: SelfHostMachineLayerDeclaration
) -> Bool {
    let contact_bounds: Array<Int> = [0 - 1, 0 - 1];
    let value_bounds: Array<Int> = [0 - 1, 0 - 1];
    if !JsonObjectTwoFieldValueBoundsWithin(
        json, start, end,
        "machine_contact_kind", "machine_layer",
        contact_bounds, value_bounds
    ) {
        return false;
    }
    return MirMachineLayerInstructionBoundsReady(
        json, contact_bounds[0], contact_bounds[1],
        value_bounds[0], value_bounds[1], declaration
    );
}

func MirMachineLayerInstructionRuntimeOperationAtBounds(
    json: String, value_start: Int, value_end: Int
) -> String {
    if value_start < 0 || value_end <= value_start ||
        JsonCharCodeAt(json, value_end, value_start) !=
        JsonAsciiCode("{") {
        return "";
    }
    return MirObjectStringFactAtBounds(
        json, value_start, value_end, "runtime_operation");
}

func MirMachineLayerInstructionRuntimeOperation(
    json: String, start: Int, end: Int
) -> String {
    let value_bounds: Array<Int> = [0, 0];
    if !MirObjectFieldValueBoundsAtBounds(
        json, start, end, "machine_layer", value_bounds) { return ""; }
    return MirMachineLayerInstructionRuntimeOperationAtBounds(
        json, value_bounds[0], value_bounds[1]
    );
}

// Validate all machine-layer objects without rebuilding the native manifest
// or walking source/AST data.  Missing/null machine_layer is permitted for
// non-contact instructions; a present malformed object is always fatal.
func MirMachineLayerRoutineIndexFactsReady(
    declaration: SelfHostMachineLayerDeclaration,
    ref routines: MirProgramRoutineIndex
) -> Bool {
    let json: String = routines.source_json;
    if !CompilerRuntimeCallAbiMachineLayerProjectionReady() {
        return false;
    }
    if !MirProgramRoutineIndexStructureReady(routines) { return false; }
    let instruction_row: Int = 0;
    while instruction_row < ArrayLength(routines.instruction_starts) {
        if !MirMachineLayerInstructionBoundsReady(
            json,
            routines.instruction_machine_contact_starts[instruction_row],
            routines.instruction_machine_contact_ends[instruction_row],
            routines.instruction_machine_layer_starts[instruction_row],
            routines.instruction_machine_layer_ends[instruction_row],
            declaration
        ) {
            return false;
        }
        instruction_row = instruction_row + 1;
    }
    return true;
}

func MirMachineLayerAdmitJsonInputObserved(
    json: String,
    machine_declaration: SelfHostMachineLayerDeclaration,
    observe_pressure: Bool
) -> Option<MirMachineLayerAdmittedJsonInput> {
    let document: MirDocumentFactIndex = BuildMirDocumentFactIndex(json);
    if !document.valid { return None; }
    return MirMachineLayerAdmitDocumentObserved(
        machine_declaration, document, observe_pressure
    );
}

func MirMachineLayerAdmitDocumentObserved(
    machine_declaration: SelfHostMachineLayerDeclaration,
    document: MirDocumentFactIndex,
    observe_pressure: Bool
) -> Option<MirMachineLayerAdmittedJsonInput> {
    if !document.valid { return None; }
    let declarations: MirProgramDeclarationIndex =
        BuildMirProgramDeclarationIndexFromTable(document.declarations);
    let domain_topology: MirDomainTopologyFacts =
        MirDomainTopologyFactsFromDocumentWithDeclarations(
            document, declarations
        );
    return MirMachineLayerAdmitDocumentWithTopologyAndDeclarationsObserved(
        machine_declaration, document, domain_topology, declarations,
        observe_pressure
    );
}

func MirMachineLayerAdmitDocumentWithTopologyObserved(
    machine_declaration: SelfHostMachineLayerDeclaration,
    document: MirDocumentFactIndex,
    domain_topology: MirDomainTopologyFacts,
    observe_pressure: Bool
) -> Option<MirMachineLayerAdmittedJsonInput> {
    let declarations: MirProgramDeclarationIndex =
        BuildMirProgramDeclarationIndexFromTable(document.declarations);
    return MirMachineLayerAdmitDocumentWithTopologyAndDeclarationsObserved(
        machine_declaration, document, domain_topology, declarations,
        observe_pressure
    );
}

func MirMachineLayerAdmitDocumentWithTopologyAndDeclarationsObserved(
    machine_declaration: SelfHostMachineLayerDeclaration,
    document: MirDocumentFactIndex,
    domain_topology: MirDomainTopologyFacts,
    declarations: MirProgramDeclarationIndex,
    observe_pressure: Bool
) -> Option<MirMachineLayerAdmittedJsonInput> {
    let domain_admission_opt: Option<MirDomainRuntimeAdmittedDocument> =
        MirDomainRuntimeAdmitDocumentWithTopologyAndDeclarations(
            document, domain_topology, declarations
        );
    if !IsSome(domain_admission_opt) {
        return None;
    }
    let domain_admission: MirDomainRuntimeAdmittedDocument =
        UnwrapOption(domain_admission_opt);
    let domain_topology_plan: MirDomainTopologyGraphPlan =
        domain_admission.domain_topology_plan;
    let domain_runtime_assignments: MirDomainRuntimeAssignmentFacts =
        domain_admission.domain_runtime_assignments;
    let domain_runtime_plan: MirDomainRuntimePlan =
        domain_admission.domain_runtime_plan;
    let json: String = document.routines.json;
    MirMachineLayerPressureStage(
        observe_pressure, "consumer:input:machine-layer:routine-index:start"
    );
    let routines: MirProgramRoutineIndex = BuildMirProgramRoutineIndexFromTable(
        document.routines, declarations
    );
    if !routines.valid {
        return None;
    }
    MirMachineLayerPressureStage(
        observe_pressure, "consumer:input:machine-layer:routine-index:done"
    );
    MirMachineLayerPressureStage(
        observe_pressure, "consumer:input:machine-layer:instruction-scan:start"
    );
    if !MirMachineLayerRoutineIndexFactsReady(
        machine_declaration, routines
    ) {
        return None;
    }
    MirMachineLayerPressureStage(
        observe_pressure, "consumer:input:machine-layer:instruction-scan:done"
    );
    let intent_execution_plan: MirIntentExecutionPlan =
        MirIntentExecutionPlanFromDocument(document, routines);
    if !MirIntentExecutionPlanReady(intent_execution_plan) {
        return None;
    }
    if intent_execution_plan.present &&
        !MirIntentExecutionPlanSemanticCrossSealFromDocument(
            intent_execution_plan, document, routines
        ) {
        return None;
    }
    return Some(MirMachineLayerAdmittedJsonInput(
        machine_declaration, document, domain_topology,
        domain_topology_plan, domain_runtime_assignments,
        domain_runtime_plan, routines, intent_execution_plan,
        domain_admission
    ));
}

func MirMachineLayerAdmitJsonInput(
    json: String,
    machine_declaration: SelfHostMachineLayerDeclaration
) -> Option<MirMachineLayerAdmittedJsonInput> {
    return MirMachineLayerAdmitJsonInputObserved(
        json, machine_declaration, false
    );
}

func MirMachineLayerFactsReady(
    json: String,
    declaration: SelfHostMachineLayerDeclaration
) -> Bool {
    return IsSome(MirMachineLayerAdmitJsonInput(json, declaration));
}
