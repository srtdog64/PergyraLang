// Self-hosted MIR machine-contact fact consumer.
//
// The native machine manifest remains the semantic SoT.  This module only
// consumes the checked projection row exported by the self-host runtime ABI
// owner and validates that every machine_layer object in MIR JSON still cites
// that identity and its operation mapping.  It must not invent a fallback
// operation or infer a device contact from syntax payloads.

import "json_fact_read.pgy";
import "../compiler/machine_layer_runtime_projection_owner.pgy";
import "../compiler/machine_layer_declaration_consumer.pgy";

func MirMachineLayerContactIndex(operation: String) -> Int {
    let row: Int = 0;
    while row < CompilerRuntimeCallAbiMachineLayerContactCount() {
        if CompilerRuntimeCallAbiMachineLayerContactNameAt(row) == operation {
            return row;
        }
        row = row + 1;
    }
    return 0 - 1;
}

func MirMachineLayerObjectReady(
    json: String,
    start: Int,
    end: Int,
    declaration: SelfHostMachineLayerDeclaration
) -> Bool {
    let manifest: String = MirObjectStringFact(json, start, end, "manifest");
    let operation: String = MirObjectStringFact(json, start, end, "operation");
    let physical_grant: String = MirObjectStringFact(
        json, start, end, "physical_grant");
    let physical_base: String = MirObjectNumberFact(
        json, start, end, "physical_base");
    let physical_size: String = MirObjectNumberFact(
        json, start, end, "physical_size");
    let physical_mode: String = MirObjectStringFact(
        json, start, end, "physical_mode");
    let runtime_operation: String = MirObjectStringFact(
        json, start, end, "runtime_operation");
    let contact_index: Int = MirMachineLayerContactIndex(operation);
    if !SelfHostMachineLayerDeclarationReady(declaration) ||
        manifest != CompilerRuntimeCallAbiMachineLayerManifestId() ||
        physical_grant != declaration.grant_id ||
        physical_base != ToString(declaration.grant_base) ||
        physical_size != ToString(declaration.grant_size) ||
        physical_mode != declaration.grant_mode ||
        contact_index < 0 ||
        runtime_operation != CompilerRuntimeCallAbiMachineLayerRuntimeOperationAt(contact_index) {
        return false;
    }
    return JsonObjectBoolFieldEquals(
            json, MirFactObjectStart(json, start), end,
            "hardware_adequate", true) &&
        JsonObjectBoolFieldEquals(
            json, MirFactObjectStart(json, start), end,
            "authority_required", true) &&
        JsonObjectBoolFieldEquals(
            json, MirFactObjectStart(json, start), end,
            "live_lease_required", true);
}

func MirMachineLayerInstructionReady(
    json: String,
    start: Int,
    end: Int,
    declaration: SelfHostMachineLayerDeclaration
) -> Bool {
    let value_bounds: Array<Int> = [0, 0];
    let contact_kind: String = MirObjectStringFact(
        json, start, end, "machine_contact_kind");
    if !MirObjectFieldValueBounds(json, start, end, "machine_layer", value_bounds) {
        return StringLength(contact_kind) == 0;
    }
    let value_kind: Int = JsonCharCodeAt(
        json, StringLength(json), value_bounds[0]);
    if value_kind == JsonAsciiCode("n") {
        return StringLength(contact_kind) == 0;
    }
    if value_kind != JsonAsciiCode("{") {
        return false;
    }
    return StringLength(contact_kind) > 0 &&
        contact_kind == MirObjectStringFact(
            json, value_bounds[0], value_bounds[1], "operation") &&
        MirMachineLayerObjectReady(
            json, value_bounds[0], value_bounds[1], declaration
        );
}

// Validate all machine-layer objects without rebuilding the native manifest
// or walking source/AST data.  Missing/null machine_layer is permitted for
// non-contact instructions; a present malformed object is always fatal.
func MirMachineLayerFactsReady(
    json: String,
    declaration: SelfHostMachineLayerDeclaration
) -> Bool {
    if !CompilerRuntimeCallAbiMachineLayerProjectionReady() {
        return false;
    }
    let routine_row: Int = 0;
    let routine_bounds: Array<Int> = [0, 0];
    while MirRoutineObjectBoundsAt(json, routine_row, routine_bounds) {
        let blocks_bounds: Array<Int> = [0, 0];
        if !MirObjectArrayBounds(
            json, routine_bounds[0], routine_bounds[1], "blocks", blocks_bounds) {
            return false;
        }
        let block_row: Int = 0;
        let block_bounds: Array<Int> = [0, 0];
        while MirObjectArrayObjectBoundsAt(
            json, routine_bounds[0], routine_bounds[1], "blocks",
            block_row, block_bounds) {
            let instructions_bounds: Array<Int> = [0, 0];
            if MirObjectArrayBounds(
                json, block_bounds[0], block_bounds[1],
                "instructions", instructions_bounds) {
                let instruction_row: Int = 0;
                let instruction_bounds: Array<Int> = [0, 0];
                while MirObjectArrayObjectBoundsAt(
                    json, block_bounds[0], block_bounds[1],
                    "instructions", instruction_row, instruction_bounds) {
                    if !MirMachineLayerInstructionReady(
                        json, instruction_bounds[0], instruction_bounds[1],
                        declaration) {
                        return false;
                    }
                    instruction_row = instruction_row + 1;
                }
            }
            block_row = block_row + 1;
        }
        routine_row = routine_row + 1;
    }
    return true;
}
