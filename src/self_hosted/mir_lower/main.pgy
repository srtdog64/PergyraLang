// mir_lower -- Pergyra-origin MIR-JSON -> AST-tree reconstructor (self-host
// path (a), rung-0b-part2). Consumes `pgy --mir-json` output (schema pgy.mir.v1)
// and reconstructs the `pgy --ast` tree text, which the existing self-host
// codegen then lowers to C. Together they form a Pergyra MIR -> C lowering:
// the C backend's MIR consumption is substituted.
//
// rung-0 scope: a single routine `Main`, a single linear block, and the
// statement forms the codegen already supports (Int `let`, `Log(...)`). The
// reconstructor consumes MIR JSON facts (`source_type`, `arg0`, `expr0`,
// `expr1`, and `source_locals`) only; out-of-scope input is an
// observable MIR-LOWER ERROR (no silent fallback, per the no-hidden-flow rule).

func Die(msg: String) -> Void {
    Log(Concat("MIR-LOWER ERROR: ", msg));
    Exit(1);
}

// Single-character substring at index `i` (the codegen subset has no native
// indexing builtin for strings).
func CharAt(s: String, i: Int) -> String {
    return Substring(s, i, 1);
}

// First index of `needle` in `hay` at or after offset `start`, or -1.
func FindFrom(hay: String, needle: String, start: Int) -> Int {
    let n: Int = StringLength(hay);
    if start < 0 {
        return -1;
    }
    if start > n {
        return -1;
    }
    let rest: String = Substring(hay, start, n - start);
    let k: Int = StringIndexOf(rest, needle);
    if k < 0 {
        return -1;
    }
    return start + k;
}

// Read a JSON string literal whose opening quote is at index `open`. Returns the
// decoded value and sets end[0] to the index just past the closing quote.
// Handles \" \\ \n \r \t escapes.
func ReadJsonString(json: String, open: Int, end: Array<Int>) -> String {
    let n: Int = StringLength(json);
    let i: Int = open + 1;
    let out: String = "";
    while i < n {
        let c: String = CharAt(json, i);
        if c == "\"" {
            ArraySet(end, 0, i + 1);
            return out;
        }
        if c == "\\" {
            if i + 1 >= n {
                Die("truncated escape in JSON string");
            }
            let e: String = CharAt(json, i + 1);
            if e == "n" {
                out = Concat(out, "\n");
            } else if e == "r" {
                out = Concat(out, "\r");
            } else if e == "t" {
                out = Concat(out, "\t");
            } else if e == "\"" {
                out = Concat(out, "\"");
            } else if e == "\\" {
                out = Concat(out, "\\");
            } else {
                out = Concat(out, e);
            }
            i = i + 2;
        } else {
            out = Concat(out, c);
            i = i + 1;
        }
    }
    Die("unterminated JSON string");
    return "";
}

// Read a string-valued JSON field inside [start,end). Missing, null, or
// non-string fields return "" so callers can fail closed or skip unsupported
// non-statement facts without accepting malformed required facts.
func JsonFieldString(json: String, start: Int, end: Int, key: String) -> String {
    let p: Int = FindFrom(json, key, start);
    if p < 0 || p >= end {
        return "";
    }
    let vstart: Int = p + StringLength(key);
    if vstart >= end {
        return "";
    }
    if CharAt(json, vstart) != "\"" {
        return "";
    }
    let e: Array<Int> = [0];
    return ReadJsonString(json, vstart, e);
}

// Find a MIR source-local type fact in the current routine span. This is the
// self-hosted mirror of MIRRoutine::source_local_types; `mir_lower` uses it
// before the transitional statement text when reconstructing `Let:` lines.
func SourceLocalType(json: String, start: Int, end: Int, name: String) -> String {
    let sp: Int = FindFrom(json, "\"source_locals\":[", start);
    if sp < 0 || sp >= end {
        return "";
    }
    let pk: Int = FindFrom(json, "\"name\":", sp);
    while pk >= 0 && pk < end {
        let nq: Int = FindFrom(json, "\"", pk + 7);
        if nq < 0 || nq >= end {
            return "";
        }
        let ne: Array<Int> = [0];
        let n: String = ReadJsonString(json, nq, ne);
        let tk: Int = FindFrom(json, "\"type\":", ne[0]);
        if tk < 0 || tk >= end {
            return "";
        }
        let tq: Int = FindFrom(json, "\"", tk + 7);
        if tq < 0 || tq >= end {
            return "";
        }
        let te: Array<Int> = [0];
        let t: String = ReadJsonString(json, tq, te);
        if n == name {
            return t;
        }
        pk = FindFrom(json, "\"name\":", te[0]);
    }
    return "";
}

// Convert one fact-rendered statement text to its AST-tree line. `Log(...)` and
// bare calls pass through unchanged; `let NAME: T = V` becomes
// `Let: NAME : T = V`.
func StmtToTreeLine(stmt: String) -> String {
    let s: String = StringTrim(stmt);
    if StringLength(s) >= 4 && Substring(s, 0, 4) == "let " {
        let rest: String = Substring(s, 4, StringLength(s) - 4);
        let colon: Int = StringIndexOf(rest, ":");
        if colon < 0 {
            Die(Concat("let without type annotation: ", s));
        }
        let name: String = StringTrim(Substring(rest, 0, colon));
        let after: String = StringTrim(Substring(rest, colon + 1, StringLength(rest) - (colon + 1)));
        return Concat("Let: ", Concat(name, Concat(" : ", after)));
    }
    return s;
}

func RenderStmtFromFacts(kind: String, source_type: String,
                         arg0: String, expr0: String, expr1: String,
                         local_type: String) -> String {
    let value: String = expr0;
    if kind == "return" {
        return Concat("Return: ", value);
    }
    if kind == "def" {
        if source_type == "AST_LET_DECL"
            && StringLength(arg0) > 0
            && StringLength(local_type) > 0
            && StringLength(expr0) > 0 {
            return Concat("Let: ", Concat(arg0, Concat(" : ", Concat(local_type, Concat(" = ", expr0)))));
        }
        if StringLength(expr1) > 0 && StringLength(expr0) > 0 {
            return Concat("Assign: ", Concat(expr1, Concat(" = ", expr0)));
        }
        return Concat("Assign: ", value);
    }
    return StmtToTreeLine(value);
}

// Find the next routine declaration: a `"name":` whose object is a function
// (`,"kind":"function"` follows the value). Instruction `"name":"stmt"` entries
// are skipped. Returns the position of the routine's `"name":` key, or -1.
func FindRoutine(json: String, from: Int) -> Int {
    let p: Int = FindFrom(json, "\"name\":", from);
    while p >= 0 {
        let q: Int = FindFrom(json, "\"", p + 7);
        if q < 0 {
            return -1;
        }
        let e: Array<Int> = [0];
        let v: String = ReadJsonString(json, q, e);
        if StringLength(v) >= 0 && Substring(json, e[0], 18) == ",\"kind\":\"function\"" {
            return p;
        }
        p = FindFrom(json, "\"name\":", e[0]);
    }
    return -1;
}

// ---------------------------------------------------------------------------
// Control-flow reconstruction (CFG -> structured AST).
//
// The MIR-JSON carries per-block `succ_true`/`succ_false` edges. For non-loop
// routines we follow those edges to rebuild `If: / Then: / Else:` structure
// instead of flattening. Loop routines (while/for) still take the flat walk
// (detected below) -- they need back-edge handling, a separate increment.
// Block ids are sequential digit strings ("0".."n"); we key on them as text.
// ---------------------------------------------------------------------------

func IsDigit(c: String) -> Bool {
    return c == "0" || c == "1" || c == "2" || c == "3" || c == "4"
        || c == "5" || c == "6" || c == "7" || c == "8" || c == "9";
}

// Read the run of digits starting at `p`; "" if none.
func ReadDigits(s: String, p: Int) -> String {
    let r: String = "";
    let i: Int = p;
    let n: Int = StringLength(s);
    while i < n {
        let c: String = CharAt(s, i);
        if IsDigit(c) {
            r = Concat(r, c);
            i = i + 1;
        } else {
            i = n;
        }
    }
    return r;
}

// Successor id (digit string) for `kw` (e.g. "\"succ_true\":") within [bs,be);
// "" when the key is absent (no such edge).
func ReadSucc(json: String, bs: Int, be: Int, kw: String) -> String {
    let p: Int = FindFrom(json, kw, bs);
    if p < 0 || p >= be {
        return "";
    }
    return ReadDigits(json, p + StringLength(kw));
}

// Resolve block `id` to its JSON span [o[0], o[1]); false if not found. The span
// runs from this block's `"id":<id>,"reachable"` to the next block's marker.
func BlockBounds(json: String, bp: Int, span_end: Int, id: String, o: Array<Int>) -> Bool {
    let key: String = Concat("\"id\":", Concat(id, ",\"reachable\""));
    let p: Int = FindFrom(json, key, bp);
    if p < 0 || p >= span_end {
        return false;
    }
    let nb: Int = FindFrom(json, ",\"reachable\"", p + StringLength(key));
    if nb < 0 || nb > span_end {
        nb = span_end;
    }
    o[0] = p;
    o[1] = nb;
    return true;
}

// Branch condition within [bs,be); "" if the block does not end in a branch or
// the branch does not carry the required MIR fact.
func BlockCond(json: String, bs: Int, be: Int) -> String {
    let kp: Int = FindFrom(json, "\"kind\":\"branch\"", bs);
    if kp < 0 || kp >= be {
        return "";
    }
    let next_kp: Int = FindFrom(json, "\"kind\":", kp + 8);
    let inst_end: Int = be;
    if next_kp >= 0 && next_kp < be {
        inst_end = next_kp;
    }
    let source_type: String = JsonFieldString(json, kp, inst_end, "\"source_type\":");
    if source_type == "AST_FOR_LOOP" {
        let binding: String = JsonFieldString(json, kp, inst_end, "\"arg0\":");
        let start: String = JsonFieldString(json, kp, inst_end, "\"expr0\":");
        let stop: String = JsonFieldString(json, kp, inst_end, "\"expr1\":");
        if StringLength(binding) > 0 && StringLength(start) > 0 && StringLength(stop) > 0 {
            return Concat("for ", Concat(binding, Concat(" in ", Concat(start, Concat("..", stop)))));
        }
    }
    let cond: String = JsonFieldString(json, kp, inst_end, "\"expr0\":");
    if StringLength(cond) > 0 {
        return cond;
    }
    return "";
}

// Emit the non-branch statement lines of block [bs,be) at `indent`. `phi`
// instructions carry no statement fact and are skipped by the string-value
// guard.
func EmitBlockStmts(json: String, routine_start: Int, routine_end: Int,
                    bs: Int, be: Int, indent: String) -> String {
    let out: String = "";
    let kp: Int = FindFrom(json, "\"kind\":", bs);
    while kp >= 0 && kp < be {
        let kq: Int = FindFrom(json, "\"", kp + 7);
        let ke: Array<Int> = [0];
        let ikind: String = ReadJsonString(json, kq, ke);
        let next_kp: Int = FindFrom(json, "\"kind\":", ke[0]);
        if ikind != "branch" && ikind != "loop-init" {
            let inst_end: Int = be;
            if next_kp >= 0 && next_kp < be {
                inst_end = next_kp;
            }
            let expr0: String = JsonFieldString(json, kp, inst_end, "\"expr0\":");
            let expr1: String = JsonFieldString(json, kp, inst_end, "\"expr1\":");
            let arg0: String = JsonFieldString(json, kp, inst_end, "\"arg0\":");
            let source_type: String = JsonFieldString(json, kp, inst_end, "\"source_type\":");
            let local_type: String = SourceLocalType(json, routine_start, routine_end, arg0);
            if StringLength(expr0) > 0 {
                out = Concat(out, Concat(indent, Concat(RenderStmtFromFacts(ikind, source_type, arg0, expr0, expr1, local_type), "\n")));
            }
        }
        kp = next_kp;
    }
    return out;
}

// True if block [bs,be) carries a `phi` -- the marker of a loop header (a
// `while` header is a block holding both a phi and a branch).
func BlockHasPhi(json: String, bs: Int, be: Int) -> Bool {
    let p: Int = FindFrom(json, "\"kind\":\"phi\"", bs);
    return p >= 0 && p < be;
}

// Render a loop header. A `for` branch carries `for <binding>` as its condition
// (`For: i in 0..3`); anything else is a `while` (`While: (i < 3)`).
func LoopHeaderLine(cond: String) -> String {
    if StringLength(cond) >= 4 && Substring(cond, 0, 4) == "for " {
        return Concat("For: ", Substring(cond, 4, StringLength(cond) - 4));
    }
    return Concat("While: ", cond);
}

// The block at which the single-entry region starting at `start` rejoins its
// parent (the if's merge / post-dominator). Plain blocks fall through to their
// successor; branch blocks recurse to skip past their own if. "" = no exit.
func RegionExit(json: String, bp: Int, span_end: Int, start: String) -> String {
    let cur: String = start;
    let guard: Int = 0;
    while StringLength(cur) > 0 && guard < 100000 {
        guard = guard + 1;
        let o: Array<Int> = [0, 0];
        if !BlockBounds(json, bp, span_end, cur, o) {
            return "";
        }
        let cond: String = BlockCond(json, o[0], o[1]);
        if StringLength(cond) == 0 {
            return ReadSucc(json, o[0], o[1], "\"succ_true\":");
        }
        let t: String = ReadSucc(json, o[0], o[1], "\"succ_true\":");
        let f: String = ReadSucc(json, o[0], o[1], "\"succ_false\":");
        let te: String = RegionExit(json, bp, span_end, t);
        if te == f {
            cur = f;
        } else {
            cur = te;
        }
    }
    return "";
}

// Emit the structured tree for blocks from `start` until reaching `stop`
// (exclusive). Straight-line blocks emit their statements; a branch block emits
// `If:/Then:/Else:` and recurses into the then/else regions, then continues from
// the merge. `indent` is the leading whitespace for statements at this level.
func EmitRegion(json: String, routine_start: Int, bp: Int, span_end: Int,
                start: String, stop: String, indent: String) -> String {
    let out: String = "";
    let cur: String = start;
    let guard: Int = 0;
    while StringLength(cur) > 0 && cur != stop && guard < 100000 {
        guard = guard + 1;
        let o: Array<Int> = [0, 0];
        if !BlockBounds(json, bp, span_end, cur, o) {
            return out;
        }
        let bs: Int = o[0];
        let be: Int = o[1];
        out = Concat(out, EmitBlockStmts(json, routine_start, span_end, bs, be, indent));
        let cond: String = BlockCond(json, bs, be);
        if StringLength(cond) == 0 {
            cur = ReadSucc(json, bs, be, "\"succ_true\":");
        } else {
            let t: String = ReadSucc(json, bs, be, "\"succ_true\":");
            let f: String = ReadSucc(json, bs, be, "\"succ_false\":");
            let isFor: Bool = StringLength(cond) >= 4 && Substring(cond, 0, 4) == "for ";
            if BlockHasPhi(json, bs, be) || isFor {
                // Loop header: the body region (succ_true) flows back here, so we
                // bound it by `cur` (this header); the loop exit is succ_false.
                out = Concat(out, Concat(indent, Concat(LoopHeaderLine(cond), "\n")));
                out = Concat(out, Concat(indent, "  Block:\n"));
                out = Concat(out, EmitRegion(json, routine_start, bp, span_end, t, cur, Concat(indent, "    ")));
                cur = f;
            } else {
                let te: String = RegionExit(json, bp, span_end, t);
                let merge: String = "";
                let hasElse: Bool = false;
                if te == f {
                    merge = f;
                } else {
                    merge = te;
                    hasElse = true;
                }
                out = Concat(out, Concat(indent, Concat("If: ", Concat(cond, "\n"))));
                out = Concat(out, Concat(indent, "  Then:\n"));
                out = Concat(out, Concat(indent, "    Block:\n"));
                out = Concat(out, EmitRegion(json, routine_start, bp, span_end, t, merge, Concat(indent, "      ")));
                if hasElse {
                    out = Concat(out, Concat(indent, "  Else:\n"));
                    out = Concat(out, Concat(indent, "    Block:\n"));
                    out = Concat(out, EmitRegion(json, routine_start, bp, span_end, f, merge, Concat(indent, "      ")));
                }
                cur = merge;
            }
        }
    }
    return out;
}

func Main() -> Void {
    let args: Array<String> = Args();
    if ArrayLength(args) < 1 {
        Die("usage: mir_lower <mir-json-file>");
    }
    let path: String = args[0];
    let json: String = ReadFile(path);
    if StringLength(json) == 0 {
        Die(Concat("empty or unreadable MIR-JSON file: ", path));
    }
    if StringIndexOf(json, "\"schema\":\"pgy.mir.v1\"") < 0 {
        Die("input is not a pgy.mir.v1 MIR-JSON document");
    }

    // Iterate every routine in document order. The current rung reconstructs
    // signatures plus the supported CFG subset from explicit MIR JSON facts;
    // unsupported shapes remain an observable MIR-LOWER ERROR. A routine span
    // is bounded by the next routine's `"name":` key.
    let out: String = "Program:\n";
    let total: Int = 0;
    let rpos: Int = FindRoutine(json, 0);
    if rpos < 0 {
        Die("no routine name in MIR-JSON");
    }
    while rpos >= 0 {
        let nq: Int = FindFrom(json, "\"", rpos + 7);
        if nq < 0 {
            Die("malformed routine name");
        }
        let nend: Array<Int> = [0];
        let routine: String = ReadJsonString(json, nq, nend);

        // Bound this routine's instructions by the next routine declaration.
        let next_rpos: Int = FindRoutine(json, nend[0]);
        let span_end: Int = next_rpos;
        if span_end < 0 {
            span_end = StringLength(json);
        }

        out = Concat(out, Concat("  Function: ", Concat(routine, "\n")));

        // Parameters + return type from the routine signature fields, scoped to
        // [nend, blk) where blk is this routine's "blocks": key (instruction
        // "name" entries sit past it).
        let blk: Int = FindFrom(json, "\"blocks\":", nend[0]);
        out = Concat(out, "    Parameters:\n");
        let pp: Int = FindFrom(json, "\"params\":[", nend[0]);
        if pp >= 0 && (blk < 0 || pp < blk) {
            let pk: Int = FindFrom(json, "\"name\":", pp);
            while pk >= 0 && (blk < 0 || pk < blk) {
                let pnq: Int = FindFrom(json, "\"", pk + 7);
                let pne: Array<Int> = [0];
                let pname: String = ReadJsonString(json, pnq, pne);
                let tk: Int = FindFrom(json, "\"type\":", pne[0]);
                let tnq: Int = FindFrom(json, "\"", tk + 7);
                let tne: Array<Int> = [0];
                let ptype: String = ReadJsonString(json, tnq, tne);
                out = Concat(out, Concat("      ", Concat(pname, Concat(": ", Concat(ptype, "\n")))));
                pk = FindFrom(json, "\"name\":", tne[0]);
            }
        }
        let rtype: String = "Void";
        let rk: Int = FindFrom(json, "\"return\":", nend[0]);
        if rk >= 0 && (blk < 0 || rk < blk) {
            let rnq: Int = FindFrom(json, "\"", rk + 9);
            let rne: Array<Int> = [0];
            rtype = ReadJsonString(json, rnq, rne);
        }
        out = Concat(out, Concat("    Returns: ", Concat(rtype, "\n")));
        out = Concat(out, "    Body:\n");
        out = Concat(out, "      Block:\n");

        // The routine's own `"kind":"function"` precedes `"blocks":`, so block
        // scanning starts there. CFG-structured reconstruction (EmitRegion, from
        // the entry block "0") rebuilds `If:`/`While:`/`For:` by following the
        // succ edges. If the structurer yields nothing (an unstructured shape we
        // do not model yet), fall back to the flat instruction walk so no source
        // statement is silently dropped.
        let bp: Int = FindFrom(json, "\"blocks\":", nend[0]);
        let region: String = EmitRegion(json, nend[0], bp, span_end, "0", "", "        ");
        if StringLength(region) > 0 {
            out = Concat(out, region);
            total = total + 1;
        } else {
            let kp: Int = FindFrom(json, "\"kind\":", bp);
            while kp >= 0 && kp < span_end {
                let kq: Int = FindFrom(json, "\"", kp + 7);
                let ke: Array<Int> = [0];
                let ikind: String = ReadJsonString(json, kq, ke);
                let next_kp: Int = FindFrom(json, "\"kind\":", ke[0]);
                let inst_end: Int = span_end;
                if next_kp >= 0 && next_kp < span_end {
                    inst_end = next_kp;
                }
                let expr0: String = JsonFieldString(json, kp, inst_end, "\"expr0\":");
                let expr1: String = JsonFieldString(json, kp, inst_end, "\"expr1\":");
                let arg0: String = JsonFieldString(json, kp, inst_end, "\"arg0\":");
                let source_type: String = JsonFieldString(json, kp, inst_end, "\"source_type\":");
                let local_type: String = SourceLocalType(json, nend[0], span_end, arg0);
                if StringLength(expr0) > 0 {
                    out = Concat(out, Concat("        ", Concat(RenderStmtFromFacts(ikind, source_type, arg0, expr0, expr1, local_type), "\n")));
                    total = total + 1;
                }
                kp = next_kp;
            }
        }

        rpos = next_rpos;
    }

    if total == 0 {
        Die("no source statements found in MIR-JSON routine");
    }
    Print(out);
}
