// mir_lower -- Pergyra-origin MIR-JSON -> AST-tree reconstructor (self-host
// path (a), rung-0b-part2). Consumes `pgy --mir-json` output (schema pgy.mir.v1)
// and reconstructs the `pgy --ast` tree text, which the existing self-host
// codegen then lowers to C. Together they form a Pergyra MIR -> C lowering:
// the C backend's MIR consumption is substituted.
//
// rung-0b scope: function signatures plus the supported CFG subset
// (straight-line blocks, if/else, while, for, and loop continue/break edge
// blocks). The reconstructor consumes MIR JSON facts (`source_type`, `arg0`,
// `expr0`, `expr1`, `source_locals`, and successor edges) only; out-of-scope
// input is an observable MIR-LOWER ERROR (no source-text fallback, per the
// no-hidden-flow rule).

func Die(msg: String) -> Void {
    Log(Concat("MIR-LOWER ERROR: ", msg));
    Exit(1);
}

// Single-character substring at index `i` (the codegen subset has no native
// indexing builtin for strings).
func CharAt(s: String, i: Int) -> String {
    return Substring(s, i, 1);
}

// First index of `needle` in `hay` at or after offset `start`, or -1.
func FindFrom(hay: String, needle: String, start: Int) -> Int {
    let n: Int = StringLength(hay);
    if start < 0 {
        return -1;
    }
    if start > n {
        return -1;
    }
    let rest: String = Substring(hay, start, n - start);
    let k: Int = StringIndexOf(rest, needle);
    if k < 0 {
        return -1;
    }
    return start + k;
}

// Read a JSON string literal whose opening quote is at index `open`. Returns the
// decoded value and sets end[0] to the index just past the closing quote.
// Handles \" \\ \n \r \t escapes.
func ReadJsonString(json: String, open: Int, inout end: Array<Int>) -> String {
    let n: Int = StringLength(json);
    let i: Int = open + 1;
    let out: String = "";
    while i < n {
        let c: String = CharAt(json, i);
        if c == "\"" {
            ArraySet(end, 0, i + 1);
            return out;
        }
        if c == "\\" {
            if i + 1 >= n {
                Die("truncated escape in JSON string");
            }
            let e: String = CharAt(json, i + 1);
            if e == "n" {
                out = Concat(out, "\n");
            } else if e == "r" {
                out = Concat(out, "\r");
            } else if e == "t" {
                out = Concat(out, "\t");
            } else if e == "\"" {
                out = Concat(out, "\"");
            } else if e == "\\" {
                out = Concat(out, "\\");
            } else {
                out = Concat(out, e);
            }
            i = i + 2;
        } else {
            out = Concat(out, c);
            i = i + 1;
        }
    }
    Die("unterminated JSON string");
    return "";
}

// Read a string-valued JSON field inside [start,end). Missing, null, or
// non-string fields return "" so callers can fail closed or skip unsupported
// non-statement facts without accepting malformed required facts.
func JsonFieldString(json: String, start: Int, end: Int, key: String) -> String {
    let p: Int = FindFrom(json, key, start);
    if p < 0 || p >= end {
        return "";
    }
    let vstart: Int = p + StringLength(key);
    if vstart >= end {
        return "";
    }
    if CharAt(json, vstart) != "\"" {
        return "";
    }
    let e: Array<Int> = [0];
    return ReadJsonString(json, vstart, e);
}

func IsDigitChar(c: String) -> Bool {
    return c == "0" || c == "1" || c == "2" || c == "3" || c == "4"
        || c == "5" || c == "6" || c == "7" || c == "8" || c == "9";
}

func JsonFieldNumber(json: String, start: Int, end: Int, key: String) -> String {
    let p: Int = FindFrom(json, key, start);
    if p < 0 || p >= end {
        return "";
    }
    let i: Int = p + StringLength(key);
    let n: Int = StringLength(json);
    let out: String = "";
    while i < n && i < end {
        let c: String = CharAt(json, i);
        if !IsDigitChar(c) {
            if StringLength(out) > 0 {
                return out;
            }
            return "";
        }
        out = Concat(out, c);
        i = i + 1;
    }
    return out;
}

// Find a MIR source-local type fact in the current routine span. This is the
// self-hosted mirror of MIRRoutine::source_local_types; `mir_lower` uses it
// before the transitional statement text when reconstructing `Let:` lines.
func SourceLocalType(json: String, start: Int, end: Int, name: String) -> String {
    let sp: Int = FindFrom(json, "\"source_locals\":[", start);
    if sp < 0 || sp >= end {
        return "";
    }
    let pk: Int = FindFrom(json, "\"name\":", sp);
    while pk >= 0 && pk < end {
        let nq: Int = FindFrom(json, "\"", pk + 7);
        if nq < 0 || nq >= end {
            return "";
        }
        let ne: Array<Int> = [0];
        let n: String = ReadJsonString(json, nq, ne);
        let tk: Int = FindFrom(json, "\"type\":", ne[0]);
        if tk < 0 || tk >= end {
            return "";
        }
        let tq: Int = FindFrom(json, "\"", tk + 7);
        if tq < 0 || tq >= end {
            return "";
        }
        let te: Array<Int> = [0];
        let t: String = ReadJsonString(json, tq, te);
        if n == name {
            return t;
        }
        pk = FindFrom(json, "\"name\":", te[0]);
    }
    return "";
}

func TextStartsWith(text: String, prefix: String) -> Bool {
    return StringLength(text) >= StringLength(prefix)
        && Substring(text, 0, StringLength(prefix)) == prefix;
}

func ArrayElementTypeName(type_name: String) -> String {
    if StringIndexOf(type_name, "String") >= 0 {
        return "String";
    }
    if StringIndexOf(type_name, "Int") >= 0 {
        return "Int";
    }
    if StringIndexOf(type_name, "Bool") >= 0 {
        return "Bool";
    }
    if StringIndexOf(type_name, "Float") >= 0 {
        return "Float";
    }
    return "";
}

func DestructureElementType(json: String, routine_start: Int, routine_end: Int,
                            expr0: String) -> String {
    let init: String = StringTrim(expr0);
    if TextStartsWith(init, "Split(") {
        return "String";
    }
    return ArrayElementTypeName(SourceLocalType(json, routine_start, routine_end, init));
}

func DestructureNeedsTemp(expr0: String) -> Bool {
    let init: String = StringTrim(expr0);
    return StringIndexOf(init, "(") >= 0 || StringIndexOf(init, "[") >= 0
        || StringIndexOf(init, " ") >= 0 || StringIndexOf(init, ",") >= 0;
}

func RenderDestructureFromFacts(json: String, routine_start: Int, routine_end: Int,
                                inst_start: Int, inst_end: Int, indent: String,
                                expr0: String) -> String {
    let init: String = StringTrim(expr0);
    let elem_type: String = DestructureElementType(json, routine_start, routine_end, init);
    if StringLength(init) == 0 {
        Die("destructure instruction is missing initializer fact");
    }
    if StringLength(elem_type) == 0 {
        Die(Concat("destructure initializer element type is unknown: ", init));
    }
    let bindings: Int = FindFrom(json, "\"destructure_bindings\":[", inst_start);
    if bindings < 0 || bindings >= inst_end {
        Die("destructure instruction is missing binding-name facts");
    }
    let open: Int = FindFrom(json, "[", bindings);
    if open < 0 || open >= inst_end {
        Die("malformed destructure binding-name facts");
    }
    let close: Int = FindFrom(json, "]", open);
    if close < 0 || close >= inst_end {
        Die("malformed destructure binding-name facts");
    }

    let out: String = "";
    let source: String = init;
    if DestructureNeedsTemp(init) {
        source = Concat("_pgy_destructure_", ToString(inst_start));
        out = Concat(out, Concat(indent, Concat("Let: ", Concat(source,
            Concat(" : Array<", Concat(elem_type, Concat("> = ", Concat(init, "\n"))))))));
    }

    let pos: Int = open + 1;
    let index: Int = 0;
    let q: Int = FindFrom(json, "\"", pos);
    while q >= 0 && q < close {
        let end: Array<Int> = [0];
        let name: String = ReadJsonString(json, q, end);
        if StringLength(name) > 0 {
            out = Concat(out, Concat(indent, Concat("Let: ", Concat(name,
                Concat(" : ", Concat(elem_type, Concat(" = ", Concat(source,
                    Concat("[", Concat(ToString(index), "]\n"))))))))));
            index = index + 1;
        }
        q = FindFrom(json, "\"", end[0]);
    }
    if index == 0 {
        Die("destructure instruction has no binding-name facts");
    }
    return out;
}

func DeclObjectEnd(json: String, p: Int, decls_end: Int) -> Int {
    let next: Int = FindFrom(json, "},{\"kind\":", p + 1);
    if next >= 0 && next < decls_end {
        return next;
    }
    return decls_end;
}

func EmitDeclFields(json: String, decl_start: Int, decl_end: Int, owner_name: String) -> String {
    let out: String = "";
    let fk0: Int = FindFrom(json, "\"fields\":[", decl_start);
    if fk0 < 0 || fk0 >= decl_end {
        return out;
    }
    let fields_end: Int = FindFrom(json, "]", fk0);
    if fields_end < 0 || fields_end >= decl_end {
        Die(Concat("declaration has malformed fields fact: ", owner_name));
    }
    let fk: Int = FindFrom(json, "\"name\":", fk0);
    while fk >= 0 && fk < fields_end {
        let fnq: Int = FindFrom(json, "\"", fk + 7);
        if fnq < 0 || fnq >= fields_end {
            Die(Concat("malformed field name fact: ", owner_name));
        }
        let fne: Array<Int> = [0];
        let fname: String = ReadJsonString(json, fnq, fne);
        let tk: Int = FindFrom(json, "\"type\":", fne[0]);
        if tk < 0 || tk >= fields_end {
            Die(Concat("field is missing type fact: ", fname));
        }
        let tq: Int = FindFrom(json, "\"", tk + 7);
        if tq < 0 || tq >= fields_end {
            Die(Concat("malformed field type fact: ", fname));
        }
        let te: Array<Int> = [0];
        let ftype: String = ReadJsonString(json, tq, te);
        out = Concat(out, Concat("      ", Concat(fname, Concat(": ", Concat(ftype, "\n")))));
        fk = FindFrom(json, "\"name\":", te[0]);
    }
    return out;
}

func EmitClassMethods(json: String, decl_start: Int, decl_end: Int, owner_name: String) -> String {
    let out: String = "";
    let mk: Int = FindFrom(json, "\"methods\":[", decl_start);
    if mk < 0 || mk >= decl_end {
        return out;
    }
    let mend: Int = FindFrom(json, "]", mk);
    if mend < 0 || mend >= decl_end {
        Die(Concat("class declaration has malformed methods fact: ", owner_name));
    }
    let mp: Int = FindFrom(json, "\"name\":", mk);
    while mp >= 0 && mp < mend {
        let mnq: Int = FindFrom(json, "\"", mp + 7);
        if mnq < 0 || mnq >= mend {
            Die(Concat("malformed class method name fact: ", owner_name));
        }
        let mne: Array<Int> = [0];
        let mname: String = ReadJsonString(json, mnq, mne);
        let routine_pos: Int = FindRoutineByOwnerName(json, owner_name, mname);
        if routine_pos < 0 {
            Die(Concat("class method is missing routine fact: ", Concat(owner_name, Concat(".", mname))));
        }
        out = Concat(out, EmitRoutineTree(json, routine_pos, "      "));
        mp = FindFrom(json, "\"name\":", mne[0]);
    }
    if StringLength(out) > 0 {
        return Concat("    Methods:\n", out);
    }
    return "";
}

func VariantObjectEnd(json: String, p: Int, variants_end: Int) -> Int {
    let next: Int = FindFrom(json, "},{\"name\":", p + 1);
    if next >= 0 && next < variants_end {
        return next;
    }
    return variants_end;
}

func EmitEnumDecl(json: String, decl_start: Int, decl_end: Int, enum_name: String) -> String {
    let vk: Int = FindFrom(json, "\"variants\":[", decl_start);
    if vk < 0 || vk >= decl_end {
        Die(Concat("enum declaration is missing variants fact: ", enum_name));
    }
    let variants_end: Int = FindFrom(json, "]", vk);
    if variants_end < 0 || variants_end >= decl_end {
        Die(Concat("enum declaration has malformed variants fact: ", enum_name));
    }
    let out: String = "";
    let vp: Int = FindFrom(json, "\"name\":", vk);
    while vp >= 0 && vp < variants_end {
        let vend: Int = VariantObjectEnd(json, vp, variants_end);
        let nq: Int = FindFrom(json, "\"", vp + 7);
        if nq < 0 || nq >= vend {
            Die(Concat("malformed enum variant name fact: ", enum_name));
        }
        let ne: Array<Int> = [0];
        let vname: String = ReadJsonString(json, nq, ne);
        let pc: String = JsonFieldNumber(json, vp, vend, "\"param_count\":");
        if pc != "0" {
            Die(Concat("payload enum variants are not supported in self-host subset: ", Concat(enum_name, Concat(".", vname))));
        }
        if StringLength(out) > 0 {
            out = Concat(out, ", ");
        }
        out = Concat(out, vname);
        vp = FindFrom(json, "\"name\":", vend);
    }
    return Concat("  Enum: ", Concat(enum_name, Concat(" { ", Concat(out, " }\n"))));
}

func EmitStructDecls(json: String) -> String {
    let out: String = "";
    let ds: Int = FindFrom(json, "\"decls\":[", 0);
    if ds < 0 {
        return out;
    }
    let de: Int = FindFrom(json, "],\"routines\":[", ds);
    if de < 0 {
        return out;
    }
    let p: Int = FindFrom(json, "\"kind\":", ds);
    while p >= 0 && p < de {
        let decl_end: Int = DeclObjectEnd(json, p, de);
        let kind: String = JsonFieldString(json, p, decl_end, "\"kind\":");
        if kind == "unsupported" {
            let ast_type: String = JsonFieldString(json, p, decl_end, "\"ast_type\":");
            let nominal_kind: String = JsonFieldString(json, p, decl_end, "\"nominal_kind\":");
            let uname: String = JsonFieldString(json, p, decl_end, "\"name\":");
            let display_kind: String = ast_type;
            if ast_type == "AST_CLASS_DECL" && StringLength(nominal_kind) > 0 {
                display_kind = nominal_kind;
            }
            Die(Concat("unsupported MIR declaration in self-host subset: ", Concat(display_kind, Concat(" ", uname))));
        }
        let nk: Int = FindFrom(json, "\"name\":", p);
        if nk < 0 || nk >= decl_end {
            Die(Concat(kind, " declaration is missing name fact"));
        }
        let nq: Int = FindFrom(json, "\"", nk + 7);
        if nq < 0 || nq >= decl_end {
            Die(Concat("malformed ", Concat(kind, " declaration name fact")));
        }
        let ne: Array<Int> = [0];
        let sname: String = ReadJsonString(json, nq, ne);
        if kind == "struct" {
            out = Concat(out, Concat("  Struct: ", Concat(sname, "\n")));
            let fields: String = EmitDeclFields(json, p, decl_end, sname);
            if StringLength(fields) > 0 {
                out = Concat(out, "    Fields:\n");
                out = Concat(out, fields);
            }
        } else if kind == "class" {
            let nominal_kind: String = JsonFieldString(json, p, decl_end, "\"nominal_kind\":");
            if nominal_kind != "class" {
                Die(Concat("unsupported nominal class kind in self-host subset: ", Concat(nominal_kind, Concat(" ", sname))));
            }
            out = Concat(out, Concat("  Class: ", Concat(sname, "\n")));
            let cfields: String = EmitDeclFields(json, p, decl_end, sname);
            if StringLength(cfields) > 0 {
                out = Concat(out, "    Fields:\n");
                out = Concat(out, cfields);
            }
            out = Concat(out, EmitClassMethods(json, p, decl_end, sname));
        } else if kind == "enum" {
            out = Concat(out, EmitEnumDecl(json, p, decl_end, sname));
        }
        p = FindFrom(json, "\"kind\":", decl_end);
    }
    return out;
}

// Convert one fact-rendered statement text to its AST-tree line. `Log(...)` and
// bare calls pass through unchanged; `let NAME: T = V` becomes
// `Let: NAME : T = V`.
func StmtToTreeLine(stmt: String) -> String {
    let s: String = StringTrim(stmt);
    if StringLength(s) >= 4 && Substring(s, 0, 4) == "let " {
        let rest: String = Substring(s, 4, StringLength(s) - 4);
        let colon: Int = StringIndexOf(rest, ":");
        if colon < 0 {
            Die(Concat("let without type annotation: ", s));
        }
        let name: String = StringTrim(Substring(rest, 0, colon));
        let after: String = StringTrim(Substring(rest, colon + 1, StringLength(rest) - (colon + 1)));
        return Concat("Let: ", Concat(name, Concat(" : ", after)));
    }
    return s;
}

func RenderDeferFromFacts(json: String, inst_start: Int, inst_end: Int,
                          indent: String) -> String {
    let key: Int = FindFrom(json, "\"defer_body\":[", inst_start);
    if key < 0 || key >= inst_end {
        Die("defer instruction is missing body facts");
    }
    let open: Int = FindFrom(json, "[", key);
    let close: Int = FindFrom(json, "]", open);
    if open < 0 || close < 0 || close >= inst_end {
        Die("defer instruction has malformed body facts");
    }

    let out: String = Concat(indent, "Defer:\n");
    out = Concat(out, Concat(indent, "  Block:\n"));
    let q: Int = FindFrom(json, "\"", open);
    let emitted: Int = 0;
    while q >= 0 && q < close {
        let e: Array<Int> = [0];
        let stmt: String = ReadJsonString(json, q, e);
        if StringLength(stmt) > 0 {
            out = Concat(out, Concat(indent, Concat("    ", Concat(StmtToTreeLine(stmt), "\n"))));
            emitted = emitted + 1;
        }
        q = FindFrom(json, "\"", e[0]);
    }
    if emitted == 0 {
        Die("defer instruction body facts are empty");
    }
    return out;
}

func RenderStmtFromFacts(kind: String, source_type: String,
                         arg0: String, expr0: String, expr1: String,
                         local_type: String) -> String {
    let value: String = expr0;
    if kind == "return" {
        return Concat("Return: ", value);
    }
    if kind == "assign" {
        if StringLength(expr0) > 0 && StringLength(expr1) > 0 {
            return Concat("Assign: ", Concat(expr0, Concat(" = ", expr1)));
        }
        Die("assignment instruction is missing target/value MIR facts");
        return "";
    }
    if kind == "def" {
        if source_type == "AST_LET_DECL"
            && StringLength(arg0) > 0
            && StringLength(local_type) > 0
            && StringLength(expr0) > 0 {
            return Concat("Let: ", Concat(arg0, Concat(" : ", Concat(local_type, Concat(" = ", expr0)))));
        }
        if StringLength(expr1) > 0 && StringLength(expr0) > 0 {
            return Concat("Assign: ", Concat(expr1, Concat(" = ", expr0)));
        }
        return Concat("Assign: ", value);
    }
    return StmtToTreeLine(value);
}

// Find the next routine declaration: a `"name":` whose object is a function or
// method (`,"kind":"function|method"` follows the value). Instruction
// `"name":"stmt"` entries are skipped. Returns the position of the routine's
// `"name":` key, or -1.
func FindRoutine(json: String, from: Int) -> Int {
    let p: Int = FindFrom(json, "\"name\":", from);
    while p >= 0 {
        let q: Int = FindFrom(json, "\"", p + 7);
        if q < 0 {
            return -1;
        }
        let e: Array<Int> = [0];
        let v: String = ReadJsonString(json, q, e);
        if StringLength(v) >= 0 && Substring(json, e[0], 18) == ",\"kind\":\"function\"" {
            return p;
        }
        if StringLength(v) >= 0 && Substring(json, e[0], 16) == ",\"kind\":\"method\"" {
            return p;
        }
        p = FindFrom(json, "\"name\":", e[0]);
    }
    return -1;
}

func RoutineSpanEnd(json: String, routine_name_end: Int) -> Int {
    let next_rpos: Int = FindRoutine(json, routine_name_end);
    if next_rpos >= 0 {
        return next_rpos;
    }
    return StringLength(json);
}

func RoutineHeaderEnd(json: String, routine_name_end: Int, span_end: Int) -> Int {
    let blk: Int = FindFrom(json, "\"blocks\":", routine_name_end);
    if blk >= 0 && blk < span_end {
        return blk;
    }
    return span_end;
}

func RoutineKind(json: String, rpos: Int, routine_name_end: Int, span_end: Int) -> String {
    return JsonFieldString(json, rpos, RoutineHeaderEnd(json, routine_name_end, span_end), "\"kind\":");
}

func RoutineOwner(json: String, rpos: Int, routine_name_end: Int, span_end: Int) -> String {
    return JsonFieldString(json, rpos, RoutineHeaderEnd(json, routine_name_end, span_end), "\"owner\":");
}

func FindRoutineByOwnerName(json: String, owner: String, name: String) -> Int {
    let rpos: Int = FindRoutine(json, 0);
    while rpos >= 0 {
        let nq: Int = FindFrom(json, "\"", rpos + 7);
        if nq < 0 {
            return -1;
        }
        let nend: Array<Int> = [0];
        let routine: String = ReadJsonString(json, nq, nend);
        let span_end: Int = RoutineSpanEnd(json, nend[0]);
        let kind: String = RoutineKind(json, rpos, nend[0], span_end);
        let ro: String = RoutineOwner(json, rpos, nend[0], span_end);
        if kind == "method" && ro == owner && routine == name {
            return rpos;
        }
        rpos = FindRoutine(json, nend[0]);
    }
    return -1;
}

// ---------------------------------------------------------------------------
// Control-flow reconstruction (CFG -> structured AST).
//
// The MIR-JSON carries per-block `succ_true`/`succ_false` edges. For non-loop
// routines we follow those edges to rebuild `If: / Then: / Else:` structure
// instead of flattening. Loop routines (while/for) still take the flat walk
// (detected below) -- they need back-edge handling, a separate increment.
// Block ids are sequential digit strings ("0".."n"); we key on them as text.
// ---------------------------------------------------------------------------

func IsDigit(c: String) -> Bool {
    return c == "0" || c == "1" || c == "2" || c == "3" || c == "4"
        || c == "5" || c == "6" || c == "7" || c == "8" || c == "9";
}

// Read the run of digits starting at `p`; "" if none.
func ReadDigits(s: String, p: Int) -> String {
    let r: String = "";
    let i: Int = p;
    let n: Int = StringLength(s);
    while i < n {
        let c: String = CharAt(s, i);
        if IsDigit(c) {
            r = Concat(r, c);
            i = i + 1;
        } else {
            i = n;
        }
    }
    return r;
}

// Successor id (digit string) for `kw` (e.g. "\"succ_true\":") within [bs,be);
// "" when the key is absent (no such edge).
func ReadSucc(json: String, bs: Int, be: Int, kw: String) -> String {
    let p: Int = FindFrom(json, kw, bs);
    if p < 0 || p >= be {
        return "";
    }
    return ReadDigits(json, p + StringLength(kw));
}

// Resolve block `id` to its JSON span [o[0], o[1]); false if not found. The span
// runs from this block's `"id":<id>,"reachable"` to the next block's marker.
func BlockBounds(json: String, bp: Int, span_end: Int, id: String, inout o: Array<Int>) -> Bool {
    let key: String = Concat("\"id\":", Concat(id, ",\"reachable\""));
    let p: Int = FindFrom(json, key, bp);
    if p < 0 || p >= span_end {
        return false;
    }
    let nb: Int = FindFrom(json, ",\"reachable\"", p + StringLength(key));
    if nb < 0 || nb > span_end {
        nb = span_end;
    }
    o[0] = p;
    o[1] = nb;
    return true;
}

// Branch condition within [bs,be); "" if the block does not end in a branch or
// the branch does not carry the required MIR fact.
func BlockCond(json: String, routine_start: Int, routine_end: Int, bs: Int, be: Int) -> String {
    let kp: Int = FindFrom(json, "\"kind\":\"branch\"", bs);
    if kp < 0 || kp >= be {
        return "";
    }
    let next_kp: Int = FindFrom(json, "\"kind\":", kp + 8);
    let inst_end: Int = be;
    if next_kp >= 0 && next_kp < be {
        inst_end = next_kp;
    }
    let source_type: String = JsonFieldString(json, kp, inst_end, "\"source_type\":");
    if source_type == "AST_MATCH_CASE" {
        let match_subject: String = JsonFieldString(json, kp, inst_end, "\"expr0\":");
        let pk: Int = FindFrom(json, "\"match_patterns\":[", kp);
        if StringLength(match_subject) == 0 || pk < 0 || pk >= inst_end {
            Die("match-case branch is missing MIR subject/pattern facts");
        }
        let pe: Int = FindFrom(json, "]", pk);
        if pe < 0 || pe >= inst_end {
            Die("match-case branch has malformed MIR pattern facts");
        }
        let pq: Int = FindFrom(json, "\"", pk + StringLength("\"match_patterns\":["));
        if pq < 0 || pq >= pe {
            Die("match-case branch has no MIR pattern fact");
        }
        let end: Array<Int> = [0];
        let pattern: String = ReadJsonString(json, pq, end);
        let next: Int = FindFrom(json, "\"", end[0]);
        if next >= 0 && next < pe {
            Die("multi-pattern match cases are outside the self-host MIR subset");
        }
        return Concat(match_subject, Concat(" == ", pattern));
    }
    if source_type == "AST_FOR_LOOP" {
        let binding: String = JsonFieldString(json, kp, inst_end, "\"arg0\":");
        let start: String = JsonFieldString(json, kp, inst_end, "\"expr0\":");
        let stop: String = JsonFieldString(json, kp, inst_end, "\"expr1\":");
        if StringLength(binding) > 0 && StringLength(start) > 0 && StringLength(stop) > 0 {
            let iter_type: String = SourceLocalType(json, routine_start, routine_end, start);
            if start == stop && StringLength(iter_type) >= 6 && Substring(iter_type, 0, 6) == "Array<" {
                return Concat("for ", Concat(binding, Concat(" in ", start)));
            }
            return Concat("for ", Concat(binding, Concat(" in ", Concat(start, Concat("..", stop)))));
        }
    }
    let cond: String = JsonFieldString(json, kp, inst_end, "\"expr0\":");
    if StringLength(cond) > 0 {
        return cond;
    }
    return "";
}

// Emit the non-branch statement lines of block [bs,be) at `indent`. `phi`
// instructions carry no statement fact and are skipped by the string-value
// guard.
func EmitBlockStmts(json: String, routine_start: Int, routine_end: Int,
                    bs: Int, be: Int, indent: String) -> String {
    let out: String = "";
    let kp: Int = FindFrom(json, "\"kind\":", bs);
    while kp >= 0 && kp < be {
        let kq: Int = FindFrom(json, "\"", kp + 7);
        let ke: Array<Int> = [0];
        let ikind: String = ReadJsonString(json, kq, ke);
        let next_kp: Int = FindFrom(json, "\"kind\":", ke[0]);
        let inst_end: Int = be;
        if next_kp >= 0 && next_kp < be {
            inst_end = next_kp;
        }
        if ikind == "destructure" {
            let d_expr0: String = JsonFieldString(json, kp, inst_end, "\"expr0\":");
            out = Concat(out, RenderDestructureFromFacts(
                json, routine_start, routine_end, kp, inst_end, indent,
                d_expr0));
        }
        if ikind != "branch" && ikind != "loop-init" {
            let expr0: String = JsonFieldString(json, kp, inst_end, "\"expr0\":");
            let expr1: String = JsonFieldString(json, kp, inst_end, "\"expr1\":");
            let arg0: String = JsonFieldString(json, kp, inst_end, "\"arg0\":");
            let source_type: String = JsonFieldString(json, kp, inst_end, "\"source_type\":");
            let local_type: String = SourceLocalType(json, routine_start, routine_end, arg0);
            if ikind != "destructure" && source_type == "AST_DEFER_STMT" {
                out = Concat(out, RenderDeferFromFacts(json, kp, inst_end, indent));
            } else if ikind != "destructure" && StringLength(expr0) > 0 {
                out = Concat(out, Concat(indent, Concat(RenderStmtFromFacts(ikind, source_type, arg0, expr0, expr1, local_type), "\n")));
            }
        }
        kp = next_kp;
    }
    return out;
}

// True if block [bs,be) carries a `phi` -- the marker of a loop header (a
// `while` header is a block holding both a phi and a branch).
func BlockHasPhi(json: String, bs: Int, be: Int) -> Bool {
    let p: Int = FindFrom(json, "\"kind\":\"phi\"", bs);
    return p >= 0 && p < be;
}

// Render a loop header. A `for` branch carries `for <binding>` as its condition
// (`For: i in 0..3`); anything else is a `while` (`While: (i < 3)`).
func LoopHeaderLine(cond: String) -> String {
    if StringLength(cond) >= 4 && Substring(cond, 0, 4) == "for " {
        return Concat("For: ", Substring(cond, 4, StringLength(cond) - 4));
    }
    return Concat("While: ", cond);
}

// The block at which the single-entry region starting at `start` rejoins its
// parent (the if's merge / post-dominator). Plain blocks fall through to their
// successor; branch blocks recurse to skip past their own if. "" = no exit.
func RegionExit(json: String, routine_start: Int, bp: Int, span_end: Int, start: String) -> String {
    let cur: String = start;
    let guard: Int = 0;
    while StringLength(cur) > 0 && guard < 100000 {
        guard = guard + 1;
        let o: Array<Int> = [0, 0];
        if !BlockBounds(json, bp, span_end, cur, o) {
            return "";
        }
        let cond: String = BlockCond(json, routine_start, span_end, o[0], o[1]);
        if StringLength(cond) == 0 {
            return ReadSucc(json, o[0], o[1], "\"succ_true\":");
        }
        let t: String = ReadSucc(json, o[0], o[1], "\"succ_true\":");
        let f: String = ReadSucc(json, o[0], o[1], "\"succ_false\":");
        let te: String = RegionExit(json, routine_start, bp, span_end, t);
        if te == f {
            cur = f;
        } else {
            cur = te;
        }
    }
    return "";
}

func IsLoopAbrupt(id: String, loop_header: String, loop_exit: String) -> Bool {
    if StringLength(id) == 0 {
        return false;
    }
    if StringLength(loop_header) > 0 && id == loop_header {
        return true;
    }
    if StringLength(loop_exit) > 0 && id == loop_exit {
        return true;
    }
    return false;
}

func BlockHasIncomingBackedge(json: String, bp: Int, span_end: Int, want: String) -> Bool {
    if StringLength(want) == 0 {
        return false;
    }
    let i: Int = ToInt(want) + 1;
    while i < 1000 {
        let id: String = ToString(i);
        let o: Array<Int> = [0, 0];
        if !BlockBounds(json, bp, span_end, id, o) {
            return false;
        }
        if ReadSucc(json, o[0], o[1], "\"succ_true\":") == want {
            return true;
        }
        if ReadSucc(json, o[0], o[1], "\"succ_false\":") == want {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Emit the structured tree for blocks from `start` until reaching `stop`
// (exclusive). Straight-line blocks emit their statements; a branch block emits
// `If:/Then:/Else:` and recurses into the then/else regions, then continues from
// the merge. `indent` is the leading whitespace for statements at this level.
func EmitRegion(json: String, routine_start: Int, bp: Int, span_end: Int,
                start: String, stop: String, indent: String,
                loop_header: String, loop_exit: String) -> String {
    let out: String = "";
    let cur: String = start;
    let guard: Int = 0;
    while StringLength(cur) > 0 && cur != stop && guard < 100000 {
        guard = guard + 1;
        let o: Array<Int> = [0, 0];
        if !BlockBounds(json, bp, span_end, cur, o) {
            return out;
        }
        let bs: Int = o[0];
        let be: Int = o[1];
        let stmts: String = EmitBlockStmts(json, routine_start, span_end, bs, be, indent);
        let had_stmts: Bool = StringLength(stmts) > 0;
        out = Concat(out, stmts);
        let cond: String = BlockCond(json, routine_start, span_end, bs, be);
        if StringLength(cond) == 0 {
            let next: String = ReadSucc(json, bs, be, "\"succ_true\":");
            if StringLength(loop_header) > 0 && next == loop_header {
                out = Concat(out, Concat(indent, "Continue\n"));
                cur = stop;
            } else if StringLength(loop_exit) > 0 && next == loop_exit {
                out = Concat(out, Concat(indent, "Break\n"));
                cur = stop;
            } else {
                cur = next;
            }
        } else {
            let t: String = ReadSucc(json, bs, be, "\"succ_true\":");
            let f: String = ReadSucc(json, bs, be, "\"succ_false\":");
            let isFor: Bool = StringLength(cond) >= 4 && Substring(cond, 0, 4) == "for ";
            let isLoop: Bool = isFor || (BlockHasPhi(json, bs, be)
                && BlockHasIncomingBackedge(json, bp, span_end, cur));
            if isLoop {
                // Loop header: the body region (succ_true) flows back here, so we
                // bound it by `cur` (this header); the loop exit is succ_false.
                out = Concat(out, Concat(indent, Concat(LoopHeaderLine(cond), "\n")));
                out = Concat(out, Concat(indent, "  Block:\n"));
                out = Concat(out, EmitRegion(json, routine_start, bp, span_end, t, cur, Concat(indent, "    "), cur, f));
                cur = f;
            } else {
                let te: String = RegionExit(json, routine_start, bp, span_end, t);
                let merge: String = "";
                let hasElse: Bool = false;
                if IsLoopAbrupt(te, loop_header, loop_exit) {
                    merge = f;
                } else if te == f {
                    merge = f;
                } else {
                    merge = te;
                    hasElse = true;
                }
                out = Concat(out, Concat(indent, Concat("If: ", Concat(cond, "\n"))));
                out = Concat(out, Concat(indent, "  Then:\n"));
                out = Concat(out, Concat(indent, "    Block:\n"));
                out = Concat(out, EmitRegion(json, routine_start, bp, span_end, t, merge, Concat(indent, "      "), loop_header, loop_exit));
                if hasElse {
                    out = Concat(out, Concat(indent, "  Else:\n"));
                    out = Concat(out, Concat(indent, "    Block:\n"));
                    out = Concat(out, EmitRegion(json, routine_start, bp, span_end, f, merge, Concat(indent, "      "), loop_header, loop_exit));
                }
                cur = merge;
            }
        }
    }
    return out;
}

func EmitRoutineTree(json: String, rpos: Int, routine_indent: String) -> String {
    let nq: Int = FindFrom(json, "\"", rpos + 7);
    if nq < 0 {
        Die("malformed routine name");
    }
    let nend: Array<Int> = [0];
    let routine: String = ReadJsonString(json, nq, nend);
    let span_end: Int = RoutineSpanEnd(json, nend[0]);
    let header_end: Int = RoutineHeaderEnd(json, nend[0], span_end);
    let ppad: String = Concat(routine_indent, "  ");
    let item_pad: String = Concat(routine_indent, "    ");
    let out: String = Concat(routine_indent, Concat("Function: ", Concat(routine, "\n")));

    out = Concat(out, Concat(ppad, "Parameters:\n"));
    let pp: Int = FindFrom(json, "\"params\":[", nend[0]);
    if pp >= 0 && pp < header_end {
        let pk: Int = FindFrom(json, "\"name\":", pp);
        while pk >= 0 && pk < header_end {
            let pnq: Int = FindFrom(json, "\"", pk + 7);
            let pne: Array<Int> = [0];
            let pname: String = ReadJsonString(json, pnq, pne);
            let tk: Int = FindFrom(json, "\"type\":", pne[0]);
            let ptype: String = "";
            let after_type: Int = pne[0];
            if tk >= 0 && tk < header_end {
                let tv: Int = tk + 7;
                if tv < header_end && CharAt(json, tv) == "\"" {
                    let tne: Array<Int> = [0];
                    ptype = ReadJsonString(json, tv, tne);
                    after_type = tne[0];
                } else {
                    after_type = tv;
                }
            }
            if StringLength(ptype) > 0 {
                out = Concat(out, Concat(item_pad, Concat(pname, Concat(": ", Concat(ptype, "\n")))));
            } else {
                out = Concat(out, Concat(item_pad, Concat(pname, "\n")));
            }
            pk = FindFrom(json, "\"name\":", after_type);
        }
    }

    let rtype: String = "Void";
    let rk: Int = FindFrom(json, "\"return\":", nend[0]);
    if rk >= 0 && rk < header_end {
        let rnq: Int = FindFrom(json, "\"", rk + 9);
        let rne: Array<Int> = [0];
        rtype = ReadJsonString(json, rnq, rne);
    }
    out = Concat(out, Concat(ppad, Concat("Returns: ", Concat(rtype, "\n"))));
    out = Concat(out, Concat(ppad, "Body:\n"));
    out = Concat(out, Concat(item_pad, "Block:\n"));

    let bp: Int = FindFrom(json, "\"blocks\":", nend[0]);
    let region: String = EmitRegion(json, nend[0], bp, span_end, "0", "",
        Concat(item_pad, "  "), "", "");
    if StringLength(region) == 0 {
        Die(Concat("unsupported or empty MIR CFG shape in routine: ", routine));
    }
    return Concat(out, region);
}

func Main() -> Void {
    let args: Array<String> = Args();
    if ArrayLength(args) < 1 {
        Die("usage: mir_lower <mir-json-file>");
    }
    let path: String = args[0];
    let json: String = ReadFile(path);
    if StringLength(json) == 0 {
        Die(Concat("empty or unreadable MIR-JSON file: ", path));
    }
    if StringIndexOf(json, "\"schema\":\"pgy.mir.v1\"") < 0 {
        Die("input is not a pgy.mir.v1 MIR-JSON document");
    }

    // Iterate every routine in document order. The current rung reconstructs
    // signatures plus the supported CFG subset from explicit MIR JSON facts;
    // unsupported shapes remain an observable MIR-LOWER ERROR. A routine span
    // is bounded by the next routine's `"name":` key.
    let out: String = Concat("Program:\n", EmitStructDecls(json));
    let total: Int = 0;
    let rpos: Int = FindRoutine(json, 0);
    if rpos < 0 {
        Die("no routine name in MIR-JSON");
    }
    while rpos >= 0 {
        let nq: Int = FindFrom(json, "\"", rpos + 7);
        if nq < 0 {
            Die("malformed routine name");
        }
        let nend: Array<Int> = [0];
        let unused_name: String = ReadJsonString(json, nq, nend);
        let span_end: Int = RoutineSpanEnd(json, nend[0]);
        let kind: String = RoutineKind(json, rpos, nend[0], span_end);
        let owner: String = RoutineOwner(json, rpos, nend[0], span_end);
        if kind == "function" || StringLength(owner) == 0 {
            out = Concat(out, EmitRoutineTree(json, rpos, "  "));
            total = total + 1;
        }
        rpos = FindRoutine(json, nend[0]);
    }

    if total == 0 {
        Die("no supported routines found in MIR-JSON document");
    }
    Print(out);
}
