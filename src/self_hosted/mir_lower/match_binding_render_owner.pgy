// Match binding statement reconstruction from carried MIR facts.
//
// Option/Result wrapper cases are recognized by the carried
// `match_subject_family` fact, not by the `match_variant` spelling: a user
// enum may declare a variant spelled `Ok` (docs/205 section 2.3, formerly L3 in
// docs/audits/2026-09-22_mir_lower_stmt_render_review.md). A case without a
// family, such as a compiler-synthesized match, keeps the spelling rule.

import "error_owner.pgy";
import "json_fact_read.pgy";

func MirMatchBindingLineForInstruction(
    json: String,
    instruction_start: Int,
    instruction_end: Int,
    source_type: String,
    match_variant: String,
    match_subject: String,
    indent: String
) -> String {
    if source_type != "AST_MATCH_CASE" { return ""; }
    let variant: String = match_variant;
    if variant == "" {
        return "";
    }
    if match_subject == "" {
        MirLowerFailClosed(Concat(
            variant, " match case is missing subject MIR fact"
        ));
    }
    let bindings: Array<String> = [];
    let binding_types: Array<String> = [];
    let binding_bounds: Array<Int> = [0, 0];
    let type_bounds: Array<Int> = [0, 0];
    if !MirObjectArrayBoundsAtBounds(
            json, instruction_start, instruction_end, "match_bindings",
            binding_bounds
        ) ||
        !JsonArrayStringsWithin(
            json, binding_bounds[0], binding_bounds[1], bindings
        ) ||
        !MirObjectArrayBoundsAtBounds(
            json, instruction_start, instruction_end, "match_binding_types",
            type_bounds
        ) ||
        !JsonArrayStringsWithin(
            json, type_bounds[0], type_bounds[1], binding_types
        ) {
        MirLowerFailClosed(Concat(
            variant,
            " match case match_bindings/match_binding_types facts are missing or malformed"
        ));
    }
    let binding_count: Int = ArrayLength(bindings);
    if binding_count != ArrayLength(binding_types) {
        MirLowerFailClosed(Concat(
            variant,
            " match case match_bindings/match_binding_types cardinality is inconsistent"
        ));
    }
    if binding_count == 0 { return ""; }
    let is_wrapper: Bool =
        variant == "Some" || variant == "Ok" || variant == "Err";
    let family: Option<String> = JsonObjectStringFieldOptWithin(
        json, instruction_start, instruction_end, "match_subject_family"
    );
    if IsSome(family) {
        let subject_family: String = UnwrapOption(family);
        is_wrapper = subject_family == "option" || subject_family == "result";
        if (subject_family == "option" && variant != "Some") ||
            (subject_family == "result" && variant != "Ok" &&
                variant != "Err") {
            MirLowerFailClosed(Concat(
                variant, " match case disagrees with its subject family"
            ));
        }
    }
    if is_wrapper && binding_count != 1 {
        MirLowerFailClosed(Concat(
            variant, " wrapper match case binding cardinality is invalid"
        ));
    }
    let unwrap_name: String = "UnwrapOption";
    if variant == "Ok" { unwrap_name = "Unwrap"; }
    if variant == "Err" { unwrap_name = "UnwrapErr"; }
    let lines: Array<String> = [];
    let binding_index: Int = 0;
    while binding_index < binding_count {
        let binding: String = bindings[binding_index];
        let binding_type: String = binding_types[binding_index];
        if binding == "" || binding_type == "" ||
            binding_type == "Unknown" {
            MirLowerFailClosed(Concat(
                variant,
                " match case is missing a concrete match_binding_type MIR fact"
            ));
        }
        let initializer: String = "";
        if is_wrapper {
            let unwrap_parts: Array<String> = [
                unwrap_name, "(", match_subject, ")"
            ];
            initializer = StringJoin(unwrap_parts, "");
        } else {
            let payload_parts: Array<String> = [
                match_subject, ".", variant, "._", ToString(binding_index)
            ];
            initializer = StringJoin(payload_parts, "");
        }
        let line: Array<String> = [
            indent, "Let: ", binding, " : ", binding_type, " = ",
            initializer, "\n"
        ];
        ArrayPush(lines, StringJoin(line, ""));
        binding_index = binding_index + 1;
    }
    return StringJoin(lines, "");
}
