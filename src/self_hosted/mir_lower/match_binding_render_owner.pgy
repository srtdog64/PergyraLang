// Match binding statement reconstruction from carried MIR facts.

import "error_owner.pgy";
import "json_fact_read.pgy";

func MirMatchBindingLineForInstruction(
    json: String,
    instruction_start: Int,
    instruction_end: Int,
    source_type: String,
    indent: String
) -> String {
    if source_type != "AST_MATCH_CASE" { return ""; }
    let variant: String = MirObjectStringFactAtBounds(
        json, instruction_start, instruction_end, "match_variant"
    );
    if variant == "" {
        return "";
    }
    let match_subject: String = MirObjectStringFactAtBounds(
        json, instruction_start, instruction_end, "expr0"
    );
    if match_subject == "" {
        MirLowerFailClosed(Concat(
            variant, " match case is missing subject MIR fact"
        ));
    }
    let bindings: Array<String> = MirObjectArrayStringFactsAtBounds(
        json, instruction_start, instruction_end, "match_bindings"
    );
    let binding_types: Array<String> = MirObjectArrayStringFactsAtBounds(
        json, instruction_start, instruction_end, "match_binding_types"
    );
    let binding_count: Int = ArrayLength(bindings);
    let binding_type_count: Int = ArrayLength(binding_types);
    if binding_count != binding_type_count {
        MirLowerFailClosed(Concat(
            variant, " match case binding/type cardinality is inconsistent"
        ));
    }
    if binding_count == 0 { return ""; }
    if (variant == "Some" || variant == "Ok" || variant == "Err") &&
        binding_count != 1 {
        MirLowerFailClosed(Concat(
            variant, " wrapper match case binding cardinality is invalid"
        ));
    }
    let out: String = "";
    let binding_index: Int = 0;
    while binding_index < binding_count {
        let binding: String = bindings[binding_index];
        let binding_type: String = binding_types[binding_index];
        if binding == "" || binding_type == "" ||
            binding_type == "Unknown" {
            MirLowerFailClosed(Concat(
                variant,
                " match case is missing a concrete binding type MIR fact"
            ));
        }
        let initializer: String = "";
        if variant == "Some" || variant == "Ok" || variant == "Err" {
            let unwrap_name: String = "UnwrapOption";
            if variant == "Ok" { unwrap_name = "Unwrap"; }
            if variant == "Err" { unwrap_name = "UnwrapErr"; }
            initializer = Concat(
                unwrap_name, Concat("(", Concat(match_subject, ")\n"))
            );
        } else {
            initializer = Concat(
                match_subject,
                Concat(".", Concat(
                    variant, Concat("._", Concat(
                        ToString(binding_index), "\n"
                    ))
                ))
            );
        }
        out = Concat(out, Concat(indent, Concat("Let: ", Concat(
            binding, Concat(" : ", Concat(
                binding_type, Concat(" = ", initializer)
            ))
        ))));
        binding_index = binding_index + 1;
    }
    return out;
}
