// Match binding statement reconstruction from carried MIR facts.

import "error_owner.pgy";
import "json_fact_read.pgy";

func MirMatchBindingLineForInstruction(
    json: String,
    instruction_start: Int,
    instruction_end: Int,
    indent: String
) -> String {
    let source_type: String = MirObjectStringFact(
        json, instruction_start, instruction_end, "source_type"
    );
    if source_type != "AST_MATCH_CASE" { return ""; }
    let variant: String = MirObjectStringFact(
        json, instruction_start, instruction_end, "match_variant"
    );
    if variant != "Some" && variant != "Ok" && variant != "Err" {
        return "";
    }
    let match_subject: String = MirObjectStringFact(
        json, instruction_start, instruction_end, "expr0"
    );
    let binding: String = MirObjectArrayStringFactAt(
        json, instruction_start, instruction_end, "match_bindings", 0
    );
    let binding_type: String = MirObjectArrayStringFactAt(
        json, instruction_start, instruction_end, "match_binding_types", 0
    );
    if match_subject == "" || binding == "" {
        MirLowerFailClosed(Concat(
            variant, " match case is missing subject or binding MIR fact"
        ));
    }
    if binding_type == "" || binding_type == "Unknown" {
        MirLowerFailClosed(Concat(
            variant, " match case is missing a concrete binding type MIR fact"
        ));
    }
    let unwrap_name: String = "UnwrapOption";
    if variant == "Ok" { unwrap_name = "Unwrap"; }
    if variant == "Err" { unwrap_name = "UnwrapErr"; }
    let type_annotation: String = Concat(" : ", binding_type);
    let initializer: String = Concat(
        unwrap_name, Concat("(", Concat(match_subject, ")\n"))
    );
    return Concat(indent, Concat("Let: ", Concat(
        binding, Concat(type_annotation, Concat(" = ", initializer))
    )));
}
