// Typed reads for match-specific MIR JSON facts.

import "../lib/json_fact_table.pgy";

func MirMatchPatternCount(
    ref instruction: JsonObjectFactTable
) -> Option<Int> {
    let bounds: Array<Int> = [0, 0];
    if !JsonObjectFactArrayBounds(instruction, "match_patterns", bounds) {
        return None;
    }
    let fact: JsonArrayStringFact = JsonArrayStringFactWithin(
        instruction.json, bounds[0], bounds[1], -1);
    if !fact.valid { return None; }
    return Some(fact.count);
}

func MirMatchPatternAt(
    ref instruction: JsonObjectFactTable,
    index: Int
) -> Option<String> {
    let count: Option<Int> = MirMatchPatternCount(instruction);
    if !IsSome(count) || index < 0 || index >= UnwrapOption(count) {
        return None;
    }
    let bounds: Array<Int> = [0, 0];
    if !JsonObjectFactArrayBounds(instruction, "match_patterns", bounds) {
        return None;
    }
    let pattern: String = JsonArrayStringAt(
        instruction.json, bounds[0], bounds[1], index
    );
    if pattern == "" { return None; }
    return Some(pattern);
}

func MirMatchVariant(
    ref instruction: JsonObjectFactTable
) -> Option<String> {
    return JsonObjectFactStringFieldOpt(instruction, "match_variant");
}

func MirMatchBindingCount(
    ref instruction: JsonObjectFactTable
) -> Option<Int> {
    let bounds: Array<Int> = [0, 0];
    if !JsonObjectFactArrayBounds(instruction, "match_bindings", bounds) {
        return None;
    }
    let fact: JsonArrayStringFact = JsonArrayStringFactWithin(
        instruction.json, bounds[0], bounds[1], -1);
    if !fact.valid { return None; }
    return Some(fact.count);
}

func MirMatchBindingAt(
    ref instruction: JsonObjectFactTable,
    index: Int
) -> Option<String> {
    let count: Option<Int> = MirMatchBindingCount(instruction);
    if !IsSome(count) || index < 0 || index >= UnwrapOption(count) {
        return None;
    }
    let bounds: Array<Int> = [0, 0];
    if !JsonObjectFactArrayBounds(instruction, "match_bindings", bounds) {
        return None;
    }
    let binding: String = JsonArrayStringAt(
        instruction.json, bounds[0], bounds[1], index
    );
    if binding == "" { return None; }
    return Some(binding);
}

func MirMatchBindingTypeCount(
    ref instruction: JsonObjectFactTable
) -> Option<Int> {
    let bounds: Array<Int> = [0, 0];
    if !JsonObjectFactArrayBounds(
        instruction, "match_binding_types", bounds
    ) {
        return None;
    }
    let fact: JsonArrayStringFact = JsonArrayStringFactWithin(
        instruction.json, bounds[0], bounds[1], -1);
    if !fact.valid { return None; }
    return Some(fact.count);
}

func MirMatchBindingTypeAt(
    ref instruction: JsonObjectFactTable,
    index: Int
) -> Option<String> {
    let count: Option<Int> = MirMatchBindingTypeCount(instruction);
    if !IsSome(count) || index < 0 || index >= UnwrapOption(count) {
        return None;
    }
    let bounds: Array<Int> = [0, 0];
    if !JsonObjectFactArrayBounds(
        instruction, "match_binding_types", bounds
    ) {
        return None;
    }
    let binding_type: String = JsonArrayStringAt(
        instruction.json, bounds[0], bounds[1], index
    );
    if binding_type == "" || binding_type == "Unknown" { return None; }
    return Some(binding_type);
}

struct MirMatchInstructionCapture {
    let valid: Bool;
    let pattern_count: Int;
    let pattern: String;
    let variant: String;
    let binding_count: Int;
    let bindings: Array<String>;
    let binding_type_count: Int;
    let binding_types: Array<String>;
}

func MirMatchInstructionCaptureFromTable(
    ref instruction: JsonObjectFactTable
) -> MirMatchInstructionCapture {
    let patterns: Option<Int> = MirMatchPatternCount(instruction);
    let bindings: Option<Int> = MirMatchBindingCount(instruction);
    let binding_types: Option<Int> = MirMatchBindingTypeCount(instruction);
    let variant: Option<String> = MirMatchVariant(instruction);
    let names: Array<String> = [];
    let types: Array<String> = [];
    if !IsSome(patterns) || !IsSome(bindings) ||
        !IsSome(binding_types) || UnwrapOption(patterns) > 1 ||
        UnwrapOption(bindings) != UnwrapOption(binding_types) {
        return MirMatchInstructionCapture(
            false, 0, "", "", 0, names, 0, types
        );
    }
    let pattern: String = "";
    if UnwrapOption(patterns) == 1 {
        let value: Option<String> = MirMatchPatternAt(instruction, 0);
        if !IsSome(value) { return MirMatchInstructionCapture(
            false, 0, "", "", 0, names, 0, types); }
        pattern = UnwrapOption(value);
    }
    let ordinal: Int = 0;
    while ordinal < UnwrapOption(bindings) {
        let name: Option<String> = MirMatchBindingAt(instruction, ordinal);
        let type_name: Option<String> =
            MirMatchBindingTypeAt(instruction, ordinal);
        if !IsSome(name) || !IsSome(type_name) {
            return MirMatchInstructionCapture(
                false, 0, "", "", 0, names, 0, types);
        }
        let prior: Int = 0;
        while prior < ordinal {
            if names[prior] == UnwrapOption(name) {
                return MirMatchInstructionCapture(
                    false, 0, "", "", 0, names, 0, types);
            }
            prior = prior + 1;
        }
        ArrayPush(names, UnwrapOption(name));
        ArrayPush(types, UnwrapOption(type_name));
        ordinal = ordinal + 1;
    }
    let variant_value: String = "";
    if IsSome(variant) { variant_value = UnwrapOption(variant); }
    return MirMatchInstructionCapture(
        true, UnwrapOption(patterns), pattern, variant_value,
        UnwrapOption(bindings), names, UnwrapOption(binding_types), types
    );
}
