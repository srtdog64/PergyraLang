// Pure CFG queries used while building a per-routine MIR fact index.

func MirRoutineGraphDistances(
    block_succ_true: Array<Int>,
    block_succ_false: Array<Int>,
    start: Int
) -> Array<Int> {
    let block_count: Int = ArrayLength(block_succ_true);
    let distances: Array<Int> = [];
    let row: Int = 0;
    while row < block_count {
        ArrayPush(distances, 0 - 1);
        row = row + 1;
    }
    if start < 0 || start >= block_count {
        return distances;
    }
    let queue: Array<Int> = [start];
    ArraySet(distances, start, 0);
    let cursor: Int = 0;
    while cursor < ArrayLength(queue) {
        let block: Int = queue[cursor];
        let next_distance: Int = distances[block] + 1;
        let true_succ: Int = block_succ_true[block];
        if true_succ >= 0 {
            let target: Int = true_succ;
            if target >= 0 && target < block_count && distances[target] < 0 {
                ArraySet(distances, target, next_distance);
                ArrayPush(queue, target);
            }
        }
        let false_succ: Int = block_succ_false[block];
        if false_succ >= 0 {
            let target: Int = false_succ;
            if target >= 0 && target < block_count && distances[target] < 0 {
                ArraySet(distances, target, next_distance);
                ArrayPush(queue, target);
            }
        }
        cursor = cursor + 1;
    }
    return distances;
}

func MirRoutineGraphDistancesAvoiding(
    block_succ_true: Array<Int>,
    block_succ_false: Array<Int>,
    start: Int,
    blocked: Int
) -> Array<Int> {
    let block_count: Int = ArrayLength(block_succ_true);
    let distances: Array<Int> = [];
    let row: Int = 0;
    while row < block_count {
        ArrayPush(distances, 0 - 1);
        row = row + 1;
    }
    if start < 0 || start >= block_count || start == blocked {
        return distances;
    }
    let queue: Array<Int> = [start];
    ArraySet(distances, start, 0);
    let cursor: Int = 0;
    while cursor < ArrayLength(queue) {
        let block: Int = queue[cursor];
        let next_distance: Int = distances[block] + 1;
        let true_succ: Int = block_succ_true[block];
        if true_succ >= 0 {
            let target: Int = true_succ;
            if target >= 0 && target < block_count && target != blocked &&
                distances[target] < 0 {
                ArraySet(distances, target, next_distance);
                ArrayPush(queue, target);
            }
        }
        let false_succ: Int = block_succ_false[block];
        if false_succ >= 0 {
            let target: Int = false_succ;
            if target >= 0 && target < block_count && target != blocked &&
                distances[target] < 0 {
                ArraySet(distances, target, next_distance);
                ArrayPush(queue, target);
            }
        }
        cursor = cursor + 1;
    }
    return distances;
}

func MirRoutineGraphCanReachAvoiding(
    block_succ_true: Array<Int>,
    block_succ_false: Array<Int>,
    start: Int, want: Int, blocked: Int
) -> Bool {
    if want < 0 || want >= ArrayLength(block_succ_true) { return false; }
    let distances: Array<Int> = MirRoutineGraphDistancesAvoiding(
        block_succ_true, block_succ_false, start, blocked
    );
    return distances[want] >= 0;
}

func MirRoutineGraphStructuralMerge(
    block_succ_true: Array<Int>,
    block_succ_false: Array<Int>,
    branch: Int, true_start: Int, false_start: Int
) -> Int {
    let block_count: Int = ArrayLength(block_succ_true);
    let merge: Int = 0 - 1;
    if branch < 0 || branch >= block_count ||
        true_start < 0 || true_start >= block_count ||
        false_start < 0 || false_start >= block_count {
        return merge;
    }
    // A terminal true arm with exactly one incoming edge cannot be reached
    // from the false arm. Preserve the canonical false-start fallback without
    // allocating four whole-CFG distance inventories for guard/return chains.
    if block_succ_true[true_start] < 0 &&
        block_succ_false[true_start] < 0 {
        let true_start_incoming: Int = 0;
        let source: Int = 0;
        while source < block_count {
            if block_succ_true[source] == true_start {
                true_start_incoming = true_start_incoming + 1;
            }
            if block_succ_false[source] == true_start {
                true_start_incoming = true_start_incoming + 1;
            }
            source = source + 1;
        }
        if true_start_incoming == 1 { return false_start; }
    }
    let true_distance: Array<Int> = MirRoutineGraphDistances(
        block_succ_true, block_succ_false, true_start
    );
    let false_distance: Array<Int> = MirRoutineGraphDistances(
        block_succ_true, block_succ_false, false_start
    );
    let true_without_branch: Array<Int> = MirRoutineGraphDistancesAvoiding(
        block_succ_true, block_succ_false, true_start, branch
    );
    let false_without_branch: Array<Int> = MirRoutineGraphDistancesAvoiding(
        block_succ_true, block_succ_false, false_start, branch
    );
    let best_distance: Int = 2147483647;
    let candidate: Int = 0;
    while candidate < block_count {
        if candidate != branch && true_distance[candidate] >= 0 &&
            false_distance[candidate] >= 0 &&
            true_without_branch[candidate] >= 0 &&
            false_without_branch[candidate] >= 0 {
            let distance: Int = true_distance[candidate] +
                false_distance[candidate];
            if distance < best_distance {
                best_distance = distance;
                merge = candidate;
            }
        }
        candidate = candidate + 1;
    }
    return merge;
}

func MirRoutineBackedgeHeaders(
    block_succ_true: Array<Int>,
    block_succ_false: Array<Int>
) -> Array<Int> {
    let block_count: Int = ArrayLength(block_succ_true);
    let invalid: Array<Int> = [];
    if ArrayLength(block_succ_false) != block_count { return invalid; }

    // Validate every owner-directed edge before indexing the target set. A
    // malformed graph fails closed instead of returning a partial loop view.
    let strictly_forward: Bool = true;
    let row: Int = 0;
    while row < block_count {
        let true_target: Int = block_succ_true[row];
        let false_target: Int = block_succ_false[row];
        if true_target < (0 - 1) || true_target >= block_count ||
            false_target < (0 - 1) || false_target >= block_count {
            return invalid;
        }
        if true_target >= 0 && !(true_target > row) {
            strictly_forward = false;
        }
        if false_target >= 0 && !(false_target > row) {
            strictly_forward = false;
        }
        row = row + 1;
    }
    let headers: Array<Int> = [];
    row = 0;
    while row < block_count {
        ArrayPush(headers, 0);
        row = row + 1;
    }
    // Block identity is row identity. Strictly forward edges form a DAG, so
    // no target can dominate a cycle-closing incoming source.
    if strictly_forward { return headers; }

    let targeted: Array<Int> = [];
    row = 0;
    while row < block_count {
        ArrayPush(targeted, 0);
        row = row + 1;
    }
    row = 0;
    while row < block_count {
        let true_target: Int = block_succ_true[row];
        let false_target: Int = block_succ_false[row];
        if true_target >= 0 { ArraySet(targeted, true_target, 1); }
        if false_target >= 0 { ArraySet(targeted, false_target, 1); }
        row = row + 1;
    }

    // Entry reachability is routine-owned and invariant across every edge.
    // For a distinct target, one avoiding traversal answers all incoming
    // source queries; target-major inspection prevents duplicate work.
    let reachable: Array<Int> = MirRoutineGraphDistances(
        block_succ_true, block_succ_false, 0
    );
    let target: Int = 0;
    while target < block_count {
        if targeted[target] == 1 && reachable[target] >= 0 {
            let avoiding_target: Array<Int> = MirRoutineGraphDistancesAvoiding(
                block_succ_true, block_succ_false, 0, target
            );
            let source: Int = 0;
            while source < block_count && headers[target] == 0 {
                if reachable[source] >= 0 &&
                    (block_succ_true[source] == target ||
                        block_succ_false[source] == target) &&
                    (source == target || avoiding_target[source] < 0) {
                    ArraySet(headers, target, 1);
                }
                source = source + 1;
            }
        }
        target = target + 1;
    }
    return headers;
}
