// Pure CFG queries used while building a per-routine MIR fact index.

func MirRoutineGraphDistances(
    block_succ_true: Array<Int>,
    block_succ_false: Array<Int>,
    start: Int
) -> Array<Int> {
    let block_count: Int = ArrayLength(block_succ_true);
    let distances: Array<Int> = [];
    let row: Int = 0;
    while row < block_count {
        ArrayPush(distances, 0 - 1);
        row = row + 1;
    }
    if start < 0 || start >= block_count {
        return distances;
    }
    let queue: Array<Int> = [start];
    ArraySet(distances, start, 0);
    let cursor: Int = 0;
    while cursor < ArrayLength(queue) {
        let block: Int = queue[cursor];
        let next_distance: Int = distances[block] + 1;
        let true_succ: Int = block_succ_true[block];
        if true_succ >= 0 {
            let target: Int = true_succ;
            if target >= 0 && target < block_count && distances[target] < 0 {
                ArraySet(distances, target, next_distance);
                ArrayPush(queue, target);
            }
        }
        let false_succ: Int = block_succ_false[block];
        if false_succ >= 0 {
            let target: Int = false_succ;
            if target >= 0 && target < block_count && distances[target] < 0 {
                ArraySet(distances, target, next_distance);
                ArrayPush(queue, target);
            }
        }
        cursor = cursor + 1;
    }
    return distances;
}

func MirRoutineGraphDistancesAvoiding(
    block_succ_true: Array<Int>,
    block_succ_false: Array<Int>,
    start: Int,
    blocked: Int
) -> Array<Int> {
    let block_count: Int = ArrayLength(block_succ_true);
    let distances: Array<Int> = [];
    let row: Int = 0;
    while row < block_count {
        ArrayPush(distances, 0 - 1);
        row = row + 1;
    }
    if start < 0 || start >= block_count || start == blocked {
        return distances;
    }
    let queue: Array<Int> = [start];
    ArraySet(distances, start, 0);
    let cursor: Int = 0;
    while cursor < ArrayLength(queue) {
        let block: Int = queue[cursor];
        let next_distance: Int = distances[block] + 1;
        let true_succ: Int = block_succ_true[block];
        if true_succ >= 0 {
            let target: Int = true_succ;
            if target >= 0 && target < block_count && target != blocked &&
                distances[target] < 0 {
                ArraySet(distances, target, next_distance);
                ArrayPush(queue, target);
            }
        }
        let false_succ: Int = block_succ_false[block];
        if false_succ >= 0 {
            let target: Int = false_succ;
            if target >= 0 && target < block_count && target != blocked &&
                distances[target] < 0 {
                ArraySet(distances, target, next_distance);
                ArrayPush(queue, target);
            }
        }
        cursor = cursor + 1;
    }
    return distances;
}

func MirRoutineGraphCanReachAvoiding(
    block_succ_true: Array<Int>,
    block_succ_false: Array<Int>,
    start: Int, want: Int, blocked: Int
) -> Bool {
    if want < 0 || want >= ArrayLength(block_succ_true) { return false; }
    let distances: Array<Int> = MirRoutineGraphDistancesAvoiding(
        block_succ_true, block_succ_false, start, blocked
    );
    return distances[want] >= 0;
}

func MirRoutineGraphStructuralMerge(
    block_succ_true: Array<Int>,
    block_succ_false: Array<Int>,
    branch: Int, true_start: Int, false_start: Int
) -> Int {
    let block_count: Int = ArrayLength(block_succ_true);
    let merge: Int = 0 - 1;
    if branch < 0 || branch >= block_count ||
        true_start < 0 || true_start >= block_count ||
        false_start < 0 || false_start >= block_count {
        return merge;
    }
    let true_distance: Array<Int> = MirRoutineGraphDistances(
        block_succ_true, block_succ_false, true_start
    );
    let false_distance: Array<Int> = MirRoutineGraphDistances(
        block_succ_true, block_succ_false, false_start
    );
    let true_without_branch: Array<Int> = MirRoutineGraphDistancesAvoiding(
        block_succ_true, block_succ_false, true_start, branch
    );
    let false_without_branch: Array<Int> = MirRoutineGraphDistancesAvoiding(
        block_succ_true, block_succ_false, false_start, branch
    );
    let best_distance: Int = 2147483647;
    let candidate: Int = 0;
    while candidate < block_count {
        if candidate != branch && true_distance[candidate] >= 0 &&
            false_distance[candidate] >= 0 &&
            true_without_branch[candidate] >= 0 &&
            false_without_branch[candidate] >= 0 {
            let distance: Int = true_distance[candidate] +
                false_distance[candidate];
            if distance < best_distance {
                best_distance = distance;
                merge = candidate;
            }
        }
        candidate = candidate + 1;
    }
    if merge < 0 && block_succ_true[true_start] < 0 &&
        block_succ_false[true_start] < 0 {
        merge = false_start;
    }
    return merge;
}

func MirRoutineEdgeTargetsDominator(
    block_succ_true: Array<Int>,
    block_succ_false: Array<Int>,
    source: Int,
    target: Int
) -> Bool {
    if source < 0 || source >= ArrayLength(block_succ_true) ||
        target < 0 || target >= ArrayLength(block_succ_true) {
        return false;
    }
    // An unreachable component must not manufacture a loop header merely
    // because the entry cannot reach its source while avoiding the target.
    // Back-edge classification is only meaningful for the reachable CFG.
    let reachable: Array<Int> = MirRoutineGraphDistances(
        block_succ_true, block_succ_false, 0
    );
    if reachable[source] < 0 || reachable[target] < 0 {
        return false;
    }
    if source == target { return true; }
    let avoiding_target: Array<Int> = MirRoutineGraphDistancesAvoiding(
        block_succ_true, block_succ_false, 0, target
    );
    return avoiding_target[source] < 0;
}
