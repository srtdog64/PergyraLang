// Stable human-readable projection of one fully admitted pgy.mir.v1 document.
//
// This view deliberately omits native lifecycle, liveness, cleanup, source-
// location, and speculation facts: the admitted program index does not own
// them.  Rows below are projection coordinates, never serialized MIR ids.

import "mir_json_input_owner.pgy";
import "routine_instruction_fact_bundle_owner.pgy";
import "../lib/json_emit.pgy";

func MirDiagnosticProjectionSchema() -> String {
    return "pgy.mir.diagnostic.v1";
}

func MirDiagnosticBool(value: Bool) -> String {
    if value { return "yes"; }
    return "no";
}

func MirDiagnosticSuccessor(value: Int) -> String {
    if value < 0 { return "-"; }
    return ToString(value);
}

func MirDiagnosticProjectionFromAdmitted(
    ref admitted: MirMachineLayerAdmittedJsonInput
) -> String {
    if !MirProgramRoutineIndexStructureReady(admitted.routines) {
        MirLowerFailClosed("MIR diagnostic routine structure is invalid");
    }
    let output_allocator: Allocator = AllocatorResult();
    let output: TextBuilder = TextBuilderNew(1024);
    let projection_diagnostic: String = "";
    let projection_value: String = "";
    let routine_count: Int = MirProgramRoutineIndexCount(admitted.routines);
    TextBuilderAppend(output, "Pergyra MIR diagnostic");
    TextBuilderAppend(output, "\n  schema: ");
    TextBuilderAppend(output, MirDiagnosticProjectionSchema());
    TextBuilderAppend(output, "\n  mir-schema: pgy.mir.v1");
    TextBuilderAppend(output, "\n  routines: ");
    TextBuilderAppend(output, ToString(routine_count));

    let routine_row: Int = 0;
    while routine_row < routine_count && projection_diagnostic == "" {
        if !MirProgramRoutineIndexRowReady(admitted.routines, routine_row) {
            projection_diagnostic = "MIR diagnostic routine row is invalid";
            continue;
        }
        let block_count: Int =
            admitted.routines.routine_block_counts[routine_row];
        let instruction_facts: MirRoutineInstructionFactBundle =
            BuildMirRoutineInstructionFactBundle(
                admitted.routines, routine_row
            );
        if !MirRoutineInstructionFactBundleReady(
            instruction_facts, block_count
        ) {
            projection_diagnostic =
                "MIR diagnostic instruction facts are invalid";
            continue;
        }
        let instruction_count: Int = ArrayLength(instruction_facts.starts);
        TextBuilderAppend(output, "\n  routine[");
        TextBuilderAppend(output, ToString(routine_row));
        TextBuilderAppend(output, "] kind=");
        projection_value = admitted.routines.kinds[routine_row];
        if projection_value == "" { projection_value = "-"; } else { projection_value = JsonStringLiteral(projection_value); }
        TextBuilderAppend(output, projection_value);
        TextBuilderAppend(output, " owner=");
        projection_value = admitted.routines.owners[routine_row];
        if projection_value == "" { projection_value = "-"; } else { projection_value = JsonStringLiteral(projection_value); }
        TextBuilderAppend(output, projection_value);
        TextBuilderAppend(output, " name=");
        projection_value = admitted.routines.names[routine_row];
        if projection_value == "" { projection_value = "-"; } else { projection_value = JsonStringLiteral(projection_value); }
        TextBuilderAppend(output, projection_value);
        TextBuilderAppend(output, " receiver=");
        projection_value = admitted.routines.receiver_carriages[routine_row];
        if projection_value == "" { projection_value = "-"; } else { projection_value = JsonStringLiteral(projection_value); }
        TextBuilderAppend(output, projection_value);
        TextBuilderAppend(output, " syntax=");
        TextBuilderAppend(output,
            admitted.routines.source_syntax_ids[routine_row]);
        TextBuilderAppend(output, " blocks=");
        TextBuilderAppend(output, ToString(block_count));
        TextBuilderAppend(output, " instructions=");
        TextBuilderAppend(output, ToString(instruction_count));
        let block_row: Int = 0;
        while block_row < block_count && projection_diagnostic == "" {
            let global_block: Int =
                admitted.routines.routine_block_starts[routine_row] +
                    block_row;
            let block_instruction_count: Int =
                MirProgramRoutineIndexBlockInstructionCountAt(
                    admitted.routines, routine_row, block_row
                );
            if global_block < 0 ||
                global_block >= ArrayLength(
                    admitted.routines.block_reachable) ||
                global_block >= ArrayLength(
                    admitted.routines.block_succ_true) ||
                global_block >= ArrayLength(
                    admitted.routines.block_succ_false) ||
                block_instruction_count < 0 {
                projection_diagnostic = "MIR diagnostic block row is invalid";
                continue;
            }
            TextBuilderAppend(output, "\n    block[");
            TextBuilderAppend(output, ToString(block_row));
            TextBuilderAppend(output, "] reachable=");
            TextBuilderAppend(output,
                MirDiagnosticBool(
                    admitted.routines.block_reachable[global_block]));
            TextBuilderAppend(output, " succ-true=");
            TextBuilderAppend(output,
                MirDiagnosticSuccessor(
                    admitted.routines.block_succ_true[global_block]));
            TextBuilderAppend(output, " succ-false=");
            TextBuilderAppend(output,
                MirDiagnosticSuccessor(
                    admitted.routines.block_succ_false[global_block]));
            TextBuilderAppend(output, " instructions=");
            TextBuilderAppend(output, ToString(block_instruction_count));
            let instruction_row: Int = 0;
            while instruction_row < block_instruction_count &&
                projection_diagnostic == "" {
                let global_instruction: Int =
                    MirProgramRoutineIndexGlobalInstructionRow(
                        admitted.routines, routine_row, block_row,
                        instruction_row
                    );
                let scalar: MirRoutineInstructionScalarCapture =
                    MirRoutineInstructionFactBundleAtGlobal(
                        instruction_facts, global_instruction
                    );
                if global_instruction < 0 || !scalar.valid {
                    projection_diagnostic =
                        "MIR diagnostic instruction row is invalid";
                    continue;
                }
                TextBuilderAppend(output, "\n      inst[");
                TextBuilderAppend(output, ToString(instruction_row));
                TextBuilderAppend(output, "] kind=");
                projection_value =
                    admitted.routines.instruction_kinds[global_instruction];
                if projection_value == "" { projection_value = "-"; } else { projection_value = JsonStringLiteral(projection_value); }
                TextBuilderAppend(output, projection_value);
                TextBuilderAppend(output, " slot=");
                projection_value = scalar.slot_anchor;
                if projection_value == "" { projection_value = "-"; } else { projection_value = JsonStringLiteral(projection_value); }
                TextBuilderAppend(output, projection_value);
                TextBuilderAppend(output, " name=");
                projection_value = scalar.name;
                if projection_value == "" { projection_value = "-"; } else { projection_value = JsonStringLiteral(projection_value); }
                TextBuilderAppend(output, projection_value);
                TextBuilderAppend(output, " result=");
                projection_value = scalar.result;
                if projection_value == "" { projection_value = "-"; } else { projection_value = JsonStringLiteral(projection_value); }
                TextBuilderAppend(output, projection_value);
                TextBuilderAppend(output, " arg0=");
                projection_value = scalar.arg0;
                if projection_value == "" { projection_value = "-"; } else { projection_value = JsonStringLiteral(projection_value); }
                TextBuilderAppend(output, projection_value);
                TextBuilderAppend(output, " arg1=");
                projection_value = scalar.arg1;
                if projection_value == "" { projection_value = "-"; } else { projection_value = JsonStringLiteral(projection_value); }
                TextBuilderAppend(output, projection_value);
                TextBuilderAppend(output, " expr0=");
                projection_value = scalar.expr0;
                if projection_value == "" { projection_value = "-"; } else { projection_value = JsonStringLiteral(projection_value); }
                TextBuilderAppend(output, projection_value);
                TextBuilderAppend(output, " expr1=");
                projection_value = scalar.expr1;
                if projection_value == "" { projection_value = "-"; } else { projection_value = JsonStringLiteral(projection_value); }
                TextBuilderAppend(output, projection_value);
                TextBuilderAppend(output, " source-type=");
                projection_value = admitted.routines.instruction_source_types[
                    global_instruction];
                if projection_value == "" { projection_value = "-"; } else { projection_value = JsonStringLiteral(projection_value); }
                TextBuilderAppend(output, projection_value);
                TextBuilderAppend(output, " abi-type=");
                projection_value = scalar.abi_type_name;
                if projection_value == "" { projection_value = "-"; } else { projection_value = JsonStringLiteral(projection_value); }
                TextBuilderAppend(output, projection_value);
                instruction_row = instruction_row + 1;
            }
            block_row = block_row + 1;
        }
        routine_row = routine_row + 1;
    }
    let text: String = TextBuilderFinish(output, output_allocator);
    AllocatorDestroy(output_allocator);
    if projection_diagnostic != "" {
        Log(Concat("MIR-LOWER ERROR: ", projection_diagnostic));
        Exit(1);
    }
    return text;
}
