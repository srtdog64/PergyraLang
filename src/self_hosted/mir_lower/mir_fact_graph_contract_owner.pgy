// MIR fact graph payload contract owner.

import "json_fact_read.pgy";
import "fixture_manifest_owner.pgy";

func MirFactGraphPayloadSchema() -> String {
    return "pgy.mir.v1";
}

func MirFactGraphPayloadFixtureCount() -> Int {
    return 90;
}

func MirFactGraphPayloadRootReady() -> Bool {
    let json: String = "{\"schema\":\"pgy.mir.v1\",\"decls\":[],\"routines\":[{\"name\":\"Main\",\"source_locals\":[],\"body\":[{\"source_type\":\"AST_LOG_CALL\",\"expr0\":\"1\"}]}]}";
    if !MirDocumentSchemaEquals(json, MirFactGraphPayloadSchema()) {
        return false;
    }

    let decls: Array<Int> = [0, 0];
    if !MirDeclArrayBounds(json, decls) {
        return false;
    }

    let routine: Array<Int> = [0, 0];
    if !MirRoutineObjectBoundsAt(json, 0, routine) {
        return false;
    }
    let routine_name: Option<String> = MirObjectStringFactOpt(json, routine[0], routine[1], "name");
    if !IsSome(routine_name) || UnwrapOption(routine_name) != "Main" {
        return false;
    }

    let source_locals: Array<Int> = [0, 0];
    if !MirObjectArrayBounds(json, routine[0], routine[1], "source_locals", source_locals) {
        return false;
    }

    let inst: Array<Int> = [0, 0];
    if !MirObjectArrayObjectBoundsAt(json, routine[0], routine[1], "body", 0, inst) {
        return false;
    }
    let source_type: Option<String> = MirObjectStringFactOpt(json, inst[0], inst[1], "source_type");
    if !IsSome(source_type) || UnwrapOption(source_type) != "AST_LOG_CALL" {
        return false;
    }
    let expr0: Option<String> = MirObjectStringFactOpt(json, inst[0], inst[1], "expr0");
    if !IsSome(expr0) || UnwrapOption(expr0) != "1" {
        return false;
    }
    return true;
}

func MirFactGraphPayloadContractReady() -> Bool {
    if MirFactGraphPayloadSchema() != "pgy.mir.v1" {
        return false;
    }
    if MirFactGraphPayloadFixtureCount() != 90 {
        return false;
    }
    if MirParityFixtureCount() != MirFactGraphPayloadFixtureCount() {
        return false;
    }
    if !MirFactGraphPayloadRootReady() {
        return false;
    }
    return true;
}
