// MIR JSON input owner for self-hosted mir_lower.
//
// Owns CLI argument validation, file-read diagnostics, and schema gating for
// the MIR JSON document consumed by the lowering owners.

import "error_owner.pgy";
import "json_fact_read.pgy";
import "domain_topology_fact_owner.pgy";
import "parallel_capture_fact_owner.pgy";
import "machine_layer_fact_owner.pgy";
import "../compiler/machine_layer_declaration_consumer.pgy";

func MirJsonInputPath(args: Array<String>) -> String {
    if ArrayLength(args) < 1 {
        MirLowerFailClosed("usage: mir_lower <mir-json-file>");
    }
    return args[0];
}

func MirJsonInputPressureStage(enabled: Bool, stage: String) -> Void {
    if enabled {
        Log(Concat("[driver-pressure-stage] ", stage));
    }
}

func MirJsonReadMachineAdmittedInputObserved(
    path: String,
    declaration: SelfHostMachineLayerDeclaration,
    observe_pressure: Bool
) -> MirMachineLayerAdmittedJsonInput {
    let json: String = ReadFile(path);
    if StringLength(json) == 0 {
        MirLowerFailClosed(Concat("empty or unreadable MIR-JSON file: ", path));
    }
    MirJsonInputPressureStage(
        observe_pressure, "consumer:input:file-read:done"
    );
    let document: MirDocumentFactIndex = BuildMirDocumentFactIndex(json);
    if !document.valid || !JsonObjectFactStringFieldEquals(
        document.root, "schema", "pgy.mir.v1"
    ) {
        MirLowerFailClosed("input is not a pgy.mir.v1 MIR-JSON document");
    }
    MirJsonInputPressureStage(
        observe_pressure, "consumer:input:schema:done"
    );
    MirJsonInputPressureStage(
        observe_pressure, "consumer:input:parallel-capture:start"
    );
    if !MirParallelCaptureFactsFromTableReady(
        document.parallel_capture_boundaries
    ) {
        MirLowerFailClosed("MIR parallel capture facts are missing or invalid");
    }
    MirJsonInputPressureStage(
        observe_pressure, "consumer:input:parallel-capture:done"
    );
    let topology_required: Bool = MirDomainTopologyRequiredForDocument(document);
    let topology: MirDomainTopologyFacts = MirDomainTopologyFactsFromDocument(
        document
    );
    if (topology_required && (!topology.present || !topology.valid)) ||
        (topology.present && !topology.valid) {
        MirLowerFailClosed("MIR domain topology facts are missing or invalid");
    }
    MirJsonInputPressureStage(
        observe_pressure, "consumer:input:machine-layer:start"
    );
    let admitted_opt: Option<MirMachineLayerAdmittedJsonInput> =
        MirMachineLayerAdmitDocumentWithTopologyObserved(
            declaration, document, topology, observe_pressure
        );
    if !IsSome(admitted_opt) {
        MirLowerFailClosed("MIR machine-layer facts are missing or invalid");
    }
    MirJsonInputPressureStage(
        observe_pressure, "consumer:input:machine-layer:done"
    );
    return UnwrapOption(admitted_opt);
}

func MirJsonReadMachineAdmittedInput(
    path: String,
    declaration: SelfHostMachineLayerDeclaration
) -> MirMachineLayerAdmittedJsonInput {
    return MirJsonReadMachineAdmittedInputObserved(
        path, declaration, false
    );
}

func MirJsonReadInputObserved(
    path: String,
    declaration: SelfHostMachineLayerDeclaration,
    observe_pressure: Bool
) -> String {
    let admitted: MirMachineLayerAdmittedJsonInput =
        MirJsonReadMachineAdmittedInputObserved(
            path, declaration, observe_pressure
        );
    return admitted.routines.source_json;
}

func MirJsonReadInput(
    path: String,
    declaration: SelfHostMachineLayerDeclaration
) -> String {
    return MirJsonReadInputObserved(path, declaration, false);
}
