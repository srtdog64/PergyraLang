// MIR JSON input owner for self-hosted mir_lower.
//
// Owns CLI argument validation, file-read diagnostics, and schema gating for
// the MIR JSON document consumed by the lowering owners.

import "error_owner.pgy";
import "json_fact_read.pgy";

func MirJsonInputPath(args: Array<String>) -> String {
    if ArrayLength(args) < 1 {
        MirLowerFailClosed("usage: mir_lower <mir-json-file>");
    }
    return args[0];
}

func MirJsonReadInput(path: String) -> String {
    let json: String = ReadFile(path);
    if StringLength(json) == 0 {
        MirLowerFailClosed(Concat("empty or unreadable MIR-JSON file: ", path));
    }
    if !MirDocumentSchemaEquals(json, "pgy.mir.v1") {
        MirLowerFailClosed("input is not a pgy.mir.v1 MIR-JSON document");
    }
    return json;
}
