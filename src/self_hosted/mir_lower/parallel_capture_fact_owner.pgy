// Parallel capture fact owner for self-hosted MIR JSON consumption.
//
// Validates the same boundary/row invariants as the C MIR verifier. Lowering
// owners may consume only documents admitted here; unknown kinds and malformed
// writer rows fail closed instead of being ignored as extension text.

import "json_fact_read.pgy";

func MirParallelCaptureBoundaryTable(json: String) -> JsonArrayObjectFactTable {
    let root: JsonObjectFactTable = JsonDocumentObjectFactTable(json);
    return JsonObjectFactArrayObjectTable(root, "parallel_capture_boundaries");
}

func MirParallelCaptureBoolEquals(
    row: JsonObjectFactTable,
    field: String,
    expected: Bool
) -> Bool {
    let bounds: Array<Int> = [0, 0];
    if !JsonObjectFactValueBounds(row, field, bounds) {
        return false;
    }
    let token: String = JsonScalarToken(row.json, bounds[0], bounds[1]);
    if expected {
        return token == "true";
    }
    return token == "false";
}

func MirParallelCaptureRowReady(
    row: JsonObjectFactTable,
    task_count: Int
) -> Bool {
    let name_opt: Option<String> = JsonObjectFactStringFieldOpt(row, "name");
    let kind_opt: Option<String> = JsonObjectFactStringFieldOpt(row, "kind");
    let writer_opt: Option<String> = JsonObjectFactNumberFieldOpt(row, "writer_task");
    if !IsSome(name_opt) || !IsSome(kind_opt) || !IsSome(writer_opt) {
        return false;
    }
    let name: String = UnwrapOption(name_opt);
    let kind: String = UnwrapOption(kind_opt);
    let writer_text: String = UnwrapOption(writer_opt);
    if StringLength(name) == 0 {
        return false;
    }
    let writer: Int = ToInt(writer_text);
    if kind == "snapshot_copy" {
        return writer >= 0 && writer < task_count;
    }
    if kind == "join_index_disjoint" || kind == "join_readonly" {
        return writer == 0;
    }
    return false;
}

func MirParallelCaptureBoundaryReady(row: JsonObjectFactTable) -> Bool {
    let id_opt: Option<String> = JsonObjectFactNumberFieldOpt(row, "source_stable_id");
    let tasks_opt: Option<String> = JsonObjectFactNumberFieldOpt(row, "task_count");
    if !IsSome(id_opt) || !IsSome(tasks_opt) ||
       !MirParallelCaptureBoolEquals(row, "sealed", true) {
        return false;
    }
    let id_text: String = UnwrapOption(id_opt);
    let task_count_text: String = UnwrapOption(tasks_opt);
    if ToInt(id_text) <= 0 || ToInt(task_count_text) < 0 {
        return false;
    }
    let rows: JsonArrayObjectFactTable = JsonObjectFactArrayObjectTable(row, "rows");
    if !JsonArrayObjectFactTableReady(rows) {
        return false;
    }
    let task_count: Int = ToInt(task_count_text);
    let row_count: Int = JsonArrayObjectFactCount(rows);
    let i: Int = 0;
    while i < row_count {
        let capture: JsonObjectFactTable = JsonArrayObjectFactAt(rows, i);
        if !MirParallelCaptureRowReady(capture, task_count) {
            return false;
        }
        let capture_name_opt: Option<String> =
            JsonObjectFactStringFieldOpt(capture, "name");
        if !IsSome(capture_name_opt) {
            return false;
        }
        let name: String = UnwrapOption(capture_name_opt);
        let j: Int = 0;
        while j < i {
            let prior: JsonObjectFactTable = JsonArrayObjectFactAt(rows, j);
            let prior_name: Option<String> =
                JsonObjectFactStringFieldOpt(prior, "name");
            if IsSome(prior_name) && UnwrapOption(prior_name) == name {
                return false;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return true;
}

func MirParallelCaptureFactsFromTableReady(
    boundaries: JsonArrayObjectFactTable
) -> Bool {
    if !JsonArrayObjectFactTableReady(boundaries) {
        return false;
    }
    let count: Int = JsonArrayObjectFactCount(boundaries);
    let i: Int = 0;
    while i < count {
        let boundary: JsonObjectFactTable =
            JsonArrayObjectFactAt(boundaries, i);
        if !MirParallelCaptureBoundaryReady(boundary) {
            return false;
        }
        let id_opt: Option<String> =
            JsonObjectFactNumberFieldOpt(boundary, "source_stable_id");
        if !IsSome(id_opt) {
            return false;
        }
        let id_text: String = UnwrapOption(id_opt);
        let id: Int = ToInt(id_text);
        let j: Int = 0;
        while j < i {
            let prior: JsonObjectFactTable =
                JsonArrayObjectFactAt(boundaries, j);
            let prior_id: Option<String> =
                JsonObjectFactNumberFieldOpt(prior, "source_stable_id");
            if IsSome(prior_id) {
                let prior_id_text: String = UnwrapOption(prior_id);
                if ToInt(prior_id_text) == id {
                    return false;
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return true;
}

func MirParallelCaptureFactsReady(json: String) -> Bool {
    let document: MirDocumentFactIndex = BuildMirDocumentFactIndex(json);
    if !document.valid { return false; }
    return MirParallelCaptureFactsFromTableReady(
        document.parallel_capture_boundaries
    );
}
