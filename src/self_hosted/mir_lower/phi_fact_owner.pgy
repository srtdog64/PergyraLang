// MIR phi arity and local-identity verifier.

import "json_fact_read.pgy";
import "routine_fact_index_owner.pgy";
import "routine_instruction_view_owner.pgy";
import "ssa_identity_owner.pgy";

func MirPhiPredecessorCount(
    ref index: MirRoutineFactIndex, block_id: Int
) -> Int {
    let count: Int = 0;
    let row: Int = 0;
    while row < ArrayLength(index.block_starts) {
        if index.block_succ_true[row] == block_id {
            count = count + 1;
        }
        // A conditional with identical arms still has one distinct
        // predecessor block, hence one phi input.
        if index.block_succ_false[row] == block_id &&
            index.block_succ_true[row] != block_id {
            count = count + 1;
        }
        row = row + 1;
    }
    return count;
}

func MirPhiResultExists(ref index: MirRoutineFactIndex, wanted: String) -> Bool {
    return MirRoutineFactIndexResultExists(index, wanted);
}

func MirPhiParameterEntryExists(
    ref index: MirRoutineFactIndex,
    json: String,
    local_name: String,
    wanted: String
) -> Bool {
    if wanted != Concat(local_name, ".0") { return false; }
    let params_bounds: Array<Int> = [0, 0];
    if !MirObjectArrayBoundsAtBounds(
        json, index.routine_start, index.routine_end,
        "params", params_bounds
    ) { return false; }
    let cursor: Int = params_bounds[0] + 1;
    let bounds: Array<Int> = [0, 0];
    while JsonArrayNextObjectBounds(
        json, cursor, params_bounds[1], bounds
    ) {
        if MirObjectStringFactAtBounds(
            json, bounds[0], bounds[1], "name"
        ) == local_name {
            return true;
        }
        cursor = bounds[1];
    }
    return false;
}

func MirRoutinePhiFactsReady(
    ref index: MirRoutineFactIndex,
    ref routines: MirProgramRoutineIndex,
    routine_row: Int
) -> Bool {
    let json: String = routines.source_json;
    if !index.valid ||
        !MirProgramRoutineIndexRowReady(routines, routine_row) {
        return false;
    }
    let block_count: Int = routines.routine_block_counts[routine_row];
    if block_count != ArrayLength(index.block_starts) ||
        block_count != ArrayLength(index.block_instruction_starts) ||
        block_count != ArrayLength(index.block_instruction_counts) ||
        !MirRoutineInstructionFactBundleReady(
            index.instruction_facts, block_count
        ) { return false; }
    let block_id: Int = 0;
    while block_id < block_count {
        let phi_prefix_count: Int =
            index.instruction_facts.block_phi_prefix_counts[block_id];
        if phi_prefix_count < 0 || phi_prefix_count >
            index.block_instruction_counts[block_id] {
            return false;
        }
        let predecessor_count: Int = 0;
        let has_backedge: Bool = false;
        if phi_prefix_count > 0 {
            predecessor_count = MirPhiPredecessorCount(index, block_id);
            has_backedge = MirRoutineFactIndexHasIncomingBackedge(
                index, block_id
            );
            if predecessor_count < 2 { return false; }
        }
        let instruction_row: Int = 0;
        while instruction_row < phi_prefix_count {
            let instruction: MirRoutineInstructionView =
                MirRoutineInstructionViewAt(
                    routines, routine_row, block_id, instruction_row
                );
            if !instruction.valid || instruction.kind != "phi" {
                return false;
            }
            let name: String = MirObjectStringFactAtBounds(
                json, instruction.start, instruction.end, "name"
            );
            let result_row: Int =
                index.block_instruction_starts[block_id] + instruction_row;
            if result_row < 0 ||
                result_row >= ArrayLength(index.instruction_facts.results) {
                return false;
            }
            let result: String = index.instruction_facts.results[result_row];
            let uses: Array<String> = MirObjectArrayStringFactsAtBounds(
                json, instruction.start, instruction.end, "uses"
            );
            let use_count: Int = ArrayLength(uses);
            // The self-host MIR wire owns an incoming value inventory,
            // not a predecessor-indexed machine phi table. Several
            // continue edges can therefore carry the same loop value.
            // Require at least the entry/backedge pair and never accept
            // more values than the CFG has predecessor edges.
            if use_count < 2 || use_count > predecessor_count ||
                !MirSsaNameMatches(result, name, false) {
                return false;
            }
            let use_i: Int = 0;
            while use_i < use_count {
                let use_name: String = uses[use_i];
                // A loop-carried phi may name its own result on the
                // incoming back-edge.  This is the canonical SSA
                // representation of the value preserved by a continue
                // path; accept it only when the CFG owner proved that
                // this block is a loop header with a back-edge.
                let self_backedge: Bool = use_name == result && has_backedge;
                if (!self_backedge && use_name == result) ||
                    !MirSsaNameMatches(use_name, name, true) ||
                    (!self_backedge && !MirPhiResultExists(index, use_name) &&
                        !MirPhiParameterEntryExists(
                            index, json, name, use_name
                        )) {
                    return false;
                }
                use_i = use_i + 1;
            }
            instruction_row = instruction_row + 1;
        }
        block_id = block_id + 1;
    }
    return true;
}
