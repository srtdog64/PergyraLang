// MIR phi arity and local-identity verifier.

import "routine_fact_index_owner.pgy";
import "routine_instruction_view_owner.pgy";
import "routine_instruction_use_fact_owner.pgy";
import "routine_result_definition_fact_owner.pgy";
import "ssa_identity_owner.pgy";
func MirPhiPredecessorCount(
    ref index: MirRoutineFactIndex, block_id: Int
) -> Int {
    let count: Int = 0;
    let row: Int = 0;
    while row < ArrayLength(index.block_starts) {
        if index.block_succ_true[row] == block_id {
            count = count + 1;
        }
        // A conditional with identical arms still has one distinct
        // predecessor block, hence one phi input.
        if index.block_succ_false[row] == block_id &&
            index.block_succ_true[row] != block_id {
            count = count + 1;
        }
        row = row + 1;
    }
    return count;
}
struct MirRoutinePhiFact {
    let valid: Bool;
    let block_id: Int;
    let global_row: Int;
    let block_instruction_row: Int;
    let local_name: String;
    let result_name: String;
    let predecessor_count: Int;
    let incoming_results: Array<String>;
    let incoming_definition_blocks: Array<Int>;
}

func MirRoutinePhiFactEmpty() -> MirRoutinePhiFact {
    let incoming_results: Array<String> = [];
    let incoming_definition_blocks: Array<Int> = [];
    return MirRoutinePhiFact(
        false, 0 - 1, 0 - 1, 0 - 1, "", "", 0,
        incoming_results, incoming_definition_blocks
    );
}
func MirRoutinePhiFactAt(
    ref index: MirRoutineFactIndex,
    ref routines: MirProgramRoutineIndex,
    ref use_facts: MirRoutineInstructionUseFacts,
    routine_row: Int,
    block_id: Int,
    block_instruction_row: Int
) -> MirRoutinePhiFact {
    let block_count: Int = ArrayLength(index.block_starts);
    let instruction_count: Int = ArrayLength(index.instruction_facts.starts);
    if !index.valid ||
        !MirProgramRoutineIndexRowReady(routines, routine_row) ||
        block_count != routines.routine_block_counts[routine_row] ||
        block_count != ArrayLength(index.block_instruction_starts) ||
        block_count != ArrayLength(index.block_instruction_counts) ||
        !MirRoutineInstructionFactBundleReady(
            index.instruction_facts, block_count
        ) || !MirRoutineInstructionUseFactsReady(
            use_facts, instruction_count
        ) || block_id < 0 || block_id >= block_count ||
        block_instruction_row < 0 ||
        block_instruction_row >=
            index.instruction_facts.block_phi_prefix_counts[block_id] {
        return MirRoutinePhiFactEmpty();
    }

    let instruction: MirRoutineInstructionView =
        MirRoutineInstructionViewAt(
            routines, routine_row, block_id, block_instruction_row
        );
    if !instruction.valid || instruction.kind != "phi" ||
        instruction.source_type != "" {
        return MirRoutinePhiFactEmpty();
    }
    let scalar: MirRoutineInstructionScalarCapture =
        MirRoutineInstructionFactBundleAtGlobal(
            index.instruction_facts, instruction.global_row
        );
    if !scalar.valid || StringLength(scalar.name) == 0 ||
        scalar.arg0 != "phi" || scalar.arg1 != "" ||
        !MirSsaNameMatches(scalar.result, scalar.name, false) {
        return MirRoutinePhiFactEmpty();
    }
    let result_definition: MirRoutineResultDefinitionFact =
        MirRoutineFactIndexUniqueResultDefinition(index, scalar.result);
    if !MirRoutineResultDefinitionFactReady(result_definition) ||
        result_definition.global_row != instruction.global_row ||
        result_definition.block_id != block_id ||
        result_definition.block_instruction_row != block_instruction_row {
        return MirRoutinePhiFactEmpty();
    }

    let predecessor_count: Int = MirPhiPredecessorCount(index, block_id);
    let use_count: Int = MirRoutineInstructionUseCountAtGlobal(
        use_facts, instruction.global_row
    );
    if predecessor_count < 2 || use_count < 2 ||
        use_count > predecessor_count {
        return MirRoutinePhiFactEmpty();
    }
    let has_backedge: Bool = MirRoutineFactIndexHasIncomingBackedge(
        index, block_id
    );
    let incoming_results: Array<String> = [];
    let incoming_definition_blocks: Array<Int> = [];
    let use_i: Int = 0;
    while use_i < use_count {
        let use_opt: Option<String> = MirRoutineInstructionUseAtGlobal(
            use_facts, instruction.global_row, use_i
        );
        if !IsSome(use_opt) {
            return MirRoutinePhiFactEmpty();
        }
        let use_name: String = UnwrapOption(use_opt);
        if !MirSsaNameMatches(use_name, scalar.name, true) {
            return MirRoutinePhiFactEmpty();
        }

        let self_backedge: Bool = use_name == scalar.result;
        if self_backedge && !has_backedge {
            return MirRoutinePhiFactEmpty();
        }
        let definition: MirRoutineResultDefinitionFact =
            MirRoutineFactIndexUniqueResultDefinition(index, use_name);
        let definition_block: Int = 0 - 1;
        if MirRoutineResultDefinitionFactReady(definition) {
            if self_backedge &&
                (definition.global_row != instruction.global_row ||
                 definition.block_id != block_id) {
                return MirRoutinePhiFactEmpty();
            }
            definition_block = definition.block_id;
        } else {
            if self_backedge || !definition.valid || definition.found ||
                !MirPhiParameterEntryExists(
                    index, routines.source_json, scalar.name, use_name
                ) {
                return MirRoutinePhiFactEmpty();
            }
        }
        ArrayPush(incoming_results, use_name);
        ArrayPush(incoming_definition_blocks, definition_block);
        use_i = use_i + 1;
    }
    return MirRoutinePhiFact(
        true, block_id, instruction.global_row, block_instruction_row,
        scalar.name, scalar.result, predecessor_count,
        incoming_results, incoming_definition_blocks
    );
}

func MirRoutinePhiFactsReady(
    ref index: MirRoutineFactIndex,
    ref routines: MirProgramRoutineIndex,
    ref use_facts: MirRoutineInstructionUseFacts,
    routine_row: Int
) -> Bool {
    if !index.valid ||
        !MirProgramRoutineIndexRowReady(routines, routine_row) {
        return false;
    }
    let block_count: Int = routines.routine_block_counts[routine_row];
    if block_count != ArrayLength(index.block_starts) ||
        block_count != ArrayLength(index.block_instruction_starts) ||
        block_count != ArrayLength(index.block_instruction_counts) ||
        !MirRoutineInstructionFactBundleReady(
            index.instruction_facts, block_count
        ) || !MirRoutineInstructionUseFactsReady(
            use_facts, ArrayLength(index.instruction_facts.starts)
        ) { return false; }
    let block_id: Int = 0;
    while block_id < block_count {
        let phi_prefix_count: Int =
            index.instruction_facts.block_phi_prefix_counts[block_id];
        if phi_prefix_count < 0 || phi_prefix_count >
            index.block_instruction_counts[block_id] {
            return false;
        }
        if phi_prefix_count > 0 {
            if MirPhiPredecessorCount(index, block_id) < 2 { return false; }
        }
        let instruction_row: Int = 0;
        while instruction_row < phi_prefix_count {
            let fact: MirRoutinePhiFact = MirRoutinePhiFactAt(
                index, routines, use_facts, routine_row,
                block_id, instruction_row
            );
            if !fact.valid { return false; }
            instruction_row = instruction_row + 1;
        }
        block_id = block_id + 1;
    }
    return true;
}
