// Exact predecessor -> incoming ValueId bindings for one MIR phi.
//
// The `uses` row order is not a predecessor order.  This owner selects the
// latest incoming definition that dominates each predecessor and consumes
// each incoming slot once. Equal ValueIds may occupy distinct predecessor
// slots; distinct non-shadowed values remain ambiguous.

import "phi_fact_owner.pgy";
import "routine_result_definition_fact_owner.pgy";
import "routine_definition_dominance_fact_owner.pgy";

struct MirPhiPredecessorBindingFact {
    let valid: Bool;
    let predecessor_blocks: Array<Int>;
    let incoming_rows: Array<Int>;
}

func MirPhiPredecessorBindingFactEmpty() -> MirPhiPredecessorBindingFact {
    let empty: Array<Int> = [];
    return MirPhiPredecessorBindingFact(false, empty, empty);
}

func MirPhiPredecessorBindingFactFromOwners(
    ref index: MirRoutineFactIndex,
    ref phi: MirRoutinePhiFact
) -> MirPhiPredecessorBindingFact {
    if !phi.valid || phi.predecessor_count < 2 ||
        ArrayLength(phi.incoming_results) < 2 ||
        ArrayLength(phi.incoming_results) !=
            ArrayLength(phi.incoming_definition_blocks) {
        return MirPhiPredecessorBindingFactEmpty();
    }
    let predecessors: Array<Int> = [];
    let block: Int = 0;
    while block < ArrayLength(index.block_starts) {
        if index.block_succ_true[block] == phi.block_id ||
            index.block_succ_false[block] == phi.block_id {
            ArrayPush(predecessors, block);
        }
        block = block + 1;
    }
    if ArrayLength(predecessors) != phi.predecessor_count {
        return MirPhiPredecessorBindingFactEmpty();
    }
    let incoming_rows: Array<Int> = [];
    let selected_counts: Array<Int> = [];
    let incoming: Int = 0;
    while incoming < ArrayLength(phi.incoming_results) {
        ArrayPush(selected_counts, 0);
        incoming = incoming + 1;
    }
    let predecessor_row: Int = 0;
    while predecessor_row < ArrayLength(predecessors) {
        let predecessor: Int = predecessors[predecessor_row];
        let selected: Int = 0 - 1;
        let candidate: Int = 0;
        while candidate < ArrayLength(phi.incoming_results) {
            if selected_counts[candidate] != 0 {
                candidate = candidate + 1;
                continue;
            }
            let definition: MirRoutineResultDefinitionFact =
                MirRoutineFactIndexUniqueResultDefinition(
                    index, phi.incoming_results[candidate]
                );
            let parameter_entry: Bool =
                phi.incoming_definition_blocks[candidate] == -1;
            if (!parameter_entry &&
                (!MirRoutineResultDefinitionFactReady(definition) ||
                 definition.block_id !=
                    phi.incoming_definition_blocks[candidate] ||
                 !MirRoutineBlockDominates(
                    index, definition.block_id, predecessor))) ||
                (parameter_entry && phi.incoming_results[candidate] !=
                    Concat(phi.local_name, ".0")) {
                candidate = candidate + 1;
                continue;
            }
            let shadowed: Bool = false;
            let other: Int = 0;
            while other < ArrayLength(index.instruction_facts.results) {
                let later_name: String = index.instruction_facts.results[other];
                if later_name != phi.incoming_results[candidate] &&
                    MirSsaNameMatches(later_name, phi.local_name, true) {
                    let later: MirRoutineResultDefinitionFact =
                        MirRoutineFactIndexUniqueResultDefinition(
                            index, later_name
                        );
                    if MirRoutineResultDefinitionFactReady(later) &&
                        MirRoutineBlockDominates(
                            index, later.block_id, predecessor
                        ) && (parameter_entry ||
                         MirRoutineDefinitionStrictlyPrecedes(
                            index, definition, later)) {
                        shadowed = true;
                    }
                }
                other = other + 1;
            }
            if !shadowed {
                if selected >= 0 && phi.incoming_results[selected] !=
                    phi.incoming_results[candidate] {
                    return MirPhiPredecessorBindingFactEmpty();
                }
                if selected < 0 { selected = candidate; }
            }
            candidate = candidate + 1;
        }
        if selected < 0 { return MirPhiPredecessorBindingFactEmpty(); }
        ArrayPush(incoming_rows, selected);
        ArraySet(selected_counts, selected, selected_counts[selected] + 1);
        predecessor_row = predecessor_row + 1;
    }
    let selected_row: Int = 0;
    while selected_row < ArrayLength(selected_counts) {
        if selected_counts[selected_row] == 0 {
            return MirPhiPredecessorBindingFactEmpty();
        }
        selected_row = selected_row + 1;
    }
    return MirPhiPredecessorBindingFact(true, predecessors, incoming_rows);
}

func MirPhiPredecessorBindingFactReady(
    ref fact: MirPhiPredecessorBindingFact,
    expected_predecessors: Int
) -> Bool {
    return fact.valid && expected_predecessors >= 2 &&
        ArrayLength(fact.predecessor_blocks) == expected_predecessors &&
        ArrayLength(fact.incoming_rows) == expected_predecessors;
}

// Routine-wide predecessor binding readiness.
//
// `MirRoutinePhiFactsReady` in phi_fact_owner.pgy answers arity and local
// identity: every `uses` entry names the same local, and a self reference
// names this phi's own row on a block that has a back-edge. It cannot answer
// which predecessor each entry arrives from, so a phi whose incoming values
// leave one predecessor with nothing to carry still reads as consistent.
// This owner already decides those bindings for the graph route; running the
// same decision over every phi of a routine lets the reconstruction refuse
// such an artifact instead of reconstructing a phi it cannot place.
//
// Call it after MirRoutinePhiFactsReady: the index and row preconditions it
// checks are this function's preconditions too.
func MirRoutinePhiPredecessorBindingsReady(
    ref index: MirRoutineFactIndex,
    ref routines: MirProgramRoutineIndex,
    ref use_facts: MirRoutineInstructionUseFacts,
    routine_row: Int
) -> Bool {
    let block_id: Int = 0;
    while block_id < ArrayLength(index.block_starts) {
        let phi_prefix_count: Int =
            index.instruction_facts.block_phi_prefix_counts[block_id];
        let instruction_row: Int = 0;
        while instruction_row < phi_prefix_count {
            let phi: MirRoutinePhiFact = MirRoutinePhiFactAt(
                index, routines, use_facts, routine_row,
                block_id, instruction_row
            );
            if !phi.valid {
                return false;
            }
            let binding: MirPhiPredecessorBindingFact =
                MirPhiPredecessorBindingFactFromOwners(index, phi);
            if !MirPhiPredecessorBindingFactReady(
                binding, phi.predecessor_count
            ) {
                return false;
            }
            instruction_row = instruction_row + 1;
        }
        block_id = block_id + 1;
    }
    return true;
}
