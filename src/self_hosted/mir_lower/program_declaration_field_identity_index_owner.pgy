// Exact declaration-field identity index for pgy.mir.v1 consumers.
//
// Field identity is captured once from declarations[].fields[].  Consumers
// join owner, spelling, stable source identity, and field kind together; they
// never accept a name-only match or rediscover field rows per topology edge.

import "json_fact_read.pgy";

struct MirProgramDeclarationFieldIdentityIndex {
    let valid: Bool;
    let declaration_names: Array<String>;
    let declaration_kinds: Array<String>;
    let declaration_nominal_kinds: Array<String>;
    let field_owner_indices: Array<Int>;
    let field_names: Array<String>;
    let field_source_syntax_ids: Array<String>;
    let field_kinds: Array<String>;
    let field_type_names: Array<String>;
}

func MirProgramDeclarationFieldIdentityPositiveDecimal(
    value: String
) -> Bool {
    let n: Int = StringLength(value);
    if n <= 0 || CharCode(value, n, 0) == CharCode("0", 1, 0) {
        return false;
    }
    let i: Int = 0;
    while i < n {
        let code: Int = CharCode(value, n, i);
        if code < CharCode("0", 1, 0) || code > CharCode("9", 1, 0) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func EmptyMirProgramDeclarationFieldIdentityIndex(
) -> MirProgramDeclarationFieldIdentityIndex {
    let names: Array<String> = [];
    let kinds: Array<String> = [];
    let nominal_kinds: Array<String> = [];
    let owner_indices: Array<Int> = [];
    let field_names: Array<String> = [];
    let field_ids: Array<String> = [];
    let field_kinds: Array<String> = [];
    let field_types: Array<String> = [];
    return MirProgramDeclarationFieldIdentityIndex(
        false, names, kinds, nominal_kinds, owner_indices,
        field_names, field_ids, field_kinds, field_types
    );
}

func BuildMirProgramDeclarationFieldIdentityIndexFromDeclarationSpans(
    json: String,
    starts: Array<Int>,
    ends: Array<Int>,
    declaration_names: Array<String>,
    declaration_kinds: Array<String>,
    declaration_nominal_kinds: Array<String>
) -> MirProgramDeclarationFieldIdentityIndex {
    let names: Array<String> = [];
    let kinds: Array<String> = [];
    let nominal_kinds: Array<String> = [];
    let owner_indices: Array<Int> = [];
    let field_names: Array<String> = [];
    let field_ids: Array<String> = [];
    let field_kinds: Array<String> = [];
    let field_types: Array<String> = [];
    if ArrayLength(starts) != ArrayLength(ends) ||
        ArrayLength(starts) != ArrayLength(declaration_names) ||
        ArrayLength(starts) != ArrayLength(declaration_kinds) ||
        ArrayLength(starts) != ArrayLength(declaration_nominal_kinds) {
        return EmptyMirProgramDeclarationFieldIdentityIndex();
    }
    let declaration_index: Int = 0;
    while declaration_index < ArrayLength(starts) {
        let declaration: JsonObjectFactTable = JsonObjectFactTableFromBounds(
            json, starts[declaration_index], ends[declaration_index]
        );
        let name: String = declaration_names[declaration_index];
        let kind: String = declaration_kinds[declaration_index];
        let nominal_kind: String =
            declaration_nominal_kinds[declaration_index];
        if !JsonObjectFactTableReady(declaration) || StringLength(name) == 0 ||
            StringLength(kind) == 0 {
            return EmptyMirProgramDeclarationFieldIdentityIndex();
        }
        let prior_declaration: Int = 0;
        while prior_declaration < ArrayLength(names) {
            if names[prior_declaration] == name {
                return EmptyMirProgramDeclarationFieldIdentityIndex();
            }
            prior_declaration = prior_declaration + 1;
        }
        ArrayPush(names, name);
        ArrayPush(kinds, kind);
        ArrayPush(nominal_kinds, nominal_kind);
        if JsonObjectFactHasField(declaration, "fields") {
            let fields: JsonArrayObjectFactTable =
                JsonObjectFactArrayObjectTable(declaration, "fields");
            if !JsonArrayObjectFactTableReady(fields) {
                return EmptyMirProgramDeclarationFieldIdentityIndex();
            }
            let field_index: Int = 0;
            while field_index < JsonArrayObjectFactCount(fields) {
                let field: JsonObjectFactTable = JsonArrayObjectFactAt(
                    fields, field_index
                );
                let field_name_opt: Option<String> =
                    JsonObjectFactStringFieldOpt(field, "name");
                let field_id_opt: Option<String> =
                    JsonObjectFactNumberFieldOpt(field, "source_syntax_id");
                let field_kind_opt: Option<String> =
                    JsonObjectFactStringFieldOpt(field, "field_kind");
                let field_type_opt: Option<String> =
                    JsonObjectFactStringFieldOpt(field, "type");
                if !IsSome(field_name_opt) ||
                    StringLength(UnwrapOption(field_name_opt)) == 0 ||
                    !IsSome(field_id_opt) ||
                    !MirProgramDeclarationFieldIdentityPositiveDecimal(
                        UnwrapOption(field_id_opt)
                    ) || !IsSome(field_kind_opt) ||
                    StringLength(UnwrapOption(field_kind_opt)) == 0 ||
                    !IsSome(field_type_opt) ||
                    StringLength(UnwrapOption(field_type_opt)) == 0 {
                    return EmptyMirProgramDeclarationFieldIdentityIndex();
                }
                let prior_field: Int = 0;
                while prior_field < ArrayLength(field_names) {
                    if field_ids[prior_field] == UnwrapOption(field_id_opt) ||
                        (owner_indices[prior_field] == declaration_index &&
                         field_names[prior_field] ==
                            UnwrapOption(field_name_opt)) {
                        return EmptyMirProgramDeclarationFieldIdentityIndex();
                    }
                    prior_field = prior_field + 1;
                }
                ArrayPush(owner_indices, declaration_index);
                ArrayPush(field_names, UnwrapOption(field_name_opt));
                ArrayPush(field_ids, UnwrapOption(field_id_opt));
                ArrayPush(field_kinds, UnwrapOption(field_kind_opt));
                ArrayPush(field_types, UnwrapOption(field_type_opt));
                field_index = field_index + 1;
            }
        }
        declaration_index = declaration_index + 1;
    }
    return MirProgramDeclarationFieldIdentityIndex(
        true, names, kinds, nominal_kinds, owner_indices,
        field_names, field_ids, field_kinds, field_types
    );
}

func MirProgramDeclarationFieldIdentityFieldIndex(
    ref index: MirProgramDeclarationFieldIdentityIndex,
    owner_name: String,
    field_name: String,
    source_syntax_id: String
) -> Int {
    let owner_index: Int =
        MirProgramDeclarationFieldIdentityDeclarationIndex(index, owner_name);
    if owner_index < 0 || StringLength(field_name) == 0 ||
        !MirProgramDeclarationFieldIdentityPositiveDecimal(source_syntax_id) {
        return 0 - 1;
    }
    let i: Int = 0;
    while i < ArrayLength(index.field_names) {
        if index.field_owner_indices[i] == owner_index &&
            index.field_names[i] == field_name &&
            index.field_source_syntax_ids[i] == source_syntax_id {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

func MirProgramDeclarationFieldIdentityMatchesType(
    ref index: MirProgramDeclarationFieldIdentityIndex,
    owner_name: String,
    field_name: String,
    source_syntax_id: String,
    expected_type_name: String
) -> Bool {
    let i: Int = MirProgramDeclarationFieldIdentityFieldIndex(
        index, owner_name, field_name, source_syntax_id
    );
    return i >= 0 && StringLength(expected_type_name) > 0 &&
        index.field_type_names[i] == expected_type_name;
}

func MirProgramDeclarationFieldIdentityDeclarationIndex(
    ref index: MirProgramDeclarationFieldIdentityIndex,
    owner_name: String
) -> Int {
    if !index.valid || StringLength(owner_name) == 0 { return 0 - 1; }
    let i: Int = 0;
    while i < ArrayLength(index.declaration_names) {
        if index.declaration_names[i] == owner_name { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

func MirProgramDeclarationFieldIdentityDeclarationIs(
    ref index: MirProgramDeclarationFieldIdentityIndex,
    owner_name: String,
    kind: String,
    nominal_kind: String
) -> Bool {
    let i: Int = MirProgramDeclarationFieldIdentityDeclarationIndex(
        index, owner_name
    );
    return i >= 0 && index.declaration_kinds[i] == kind &&
        index.declaration_nominal_kinds[i] == nominal_kind;
}

func MirProgramDeclarationFieldIdentityNominalKind(
    ref index: MirProgramDeclarationFieldIdentityIndex,
    owner_name: String
) -> String {
    let i: Int = MirProgramDeclarationFieldIdentityDeclarationIndex(
        index, owner_name
    );
    if i < 0 { return ""; }
    return index.declaration_nominal_kinds[i];
}

func MirProgramDeclarationFieldIdentityMatches(
    ref index: MirProgramDeclarationFieldIdentityIndex,
    owner_name: String,
    field_name: String,
    source_syntax_id: String,
    expected_field_kind: String
) -> Bool {
    let owner_index: Int =
        MirProgramDeclarationFieldIdentityDeclarationIndex(index, owner_name);
    if owner_index < 0 || StringLength(field_name) == 0 ||
        !MirProgramDeclarationFieldIdentityPositiveDecimal(source_syntax_id) ||
        StringLength(expected_field_kind) == 0 {
        return false;
    }
    let i: Int = 0;
    while i < ArrayLength(index.field_names) {
        if index.field_owner_indices[i] == owner_index &&
            index.field_names[i] == field_name &&
            index.field_source_syntax_ids[i] == source_syntax_id &&
            index.field_kinds[i] == expected_field_kind {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func MirProgramDeclarationFieldIdentityKindCount(
    ref index: MirProgramDeclarationFieldIdentityIndex,
    owner_name: String,
    field_kind: String
) -> Int {
    let owner_index: Int =
        MirProgramDeclarationFieldIdentityDeclarationIndex(index, owner_name);
    if owner_index < 0 { return 0; }
    let count: Int = 0;
    let i: Int = 0;
    while i < ArrayLength(index.field_names) {
        if index.field_owner_indices[i] == owner_index &&
            index.field_kinds[i] == field_kind {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}
