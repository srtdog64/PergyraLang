// MIR program declaration inventory index.
//
// Captured once from the pgy.mir.v1 declaration array.  Canonical declaration
// family ordering remains a lowering policy; this owner preserves document
// identity and spans so each policy phase does not rediscover JSON rows.

import "json_fact_read.pgy";
import "program_declaration_field_identity_index_owner.pgy";
import "program_enum_variant_index_owner.pgy";
struct MirProgramDeclarationIndex {
    let valid: Bool;
    let starts: Array<Int>;
    let ends: Array<Int>;
    let kinds: Array<String>;
    let nominal_kinds: Array<String>;
    let names: Array<String>;
    let source_module_paths: Array<String>;
    let field_identities: MirProgramDeclarationFieldIdentityIndex;
    let enum_variants: MirProgramEnumVariantIndex;
}

func MirProgramDeclarationIndexCursorAtEnd(
    json: String,
    cursor: Int,
    array_end: Int
) -> Bool {
    let i: Int = JsonSkipWhitespace(json, cursor, array_end);
    return i >= 0 && i + 1 == array_end &&
        JsonCharCodeAt(json, array_end, i) == JsonAsciiCode("]");
}

func BuildMirProgramDeclarationIndexFromTable(
    ref declarations: JsonArrayObjectFactTable
) -> MirProgramDeclarationIndex {
    let json: String = declarations.json;
    let declaration_start: Int = declarations.start;
    let declaration_end: Int = declarations.end;
    let starts: Array<Int> = [];
    let ends: Array<Int> = [];
    let kinds: Array<String> = [];
    let nominal_kinds: Array<String> = [];
    let names: Array<String> = [];
    let source_module_paths: Array<String> = [];
    let field_identities: MirProgramDeclarationFieldIdentityIndex = EmptyMirProgramDeclarationFieldIdentityIndex();
    let enum_variants: MirProgramEnumVariantIndex = EmptyMirProgramEnumVariantIndex();
    let valid: Bool = true;
    if !JsonArrayObjectFactTableReady(declarations) ||
        JsonCharCodeAt(json, declaration_end, declaration_start) !=
            JsonAsciiCode("[") {
        return MirProgramDeclarationIndex(
            false, starts, ends, kinds, nominal_kinds, names,
            source_module_paths, field_identities, enum_variants
        );
    }
    let cursor: Int = declaration_start + 1;
    let bounds: Array<Int> = [0, 0];
    while JsonArrayNextObjectBounds(
        json, cursor, declaration_end, bounds
    ) {
        ArrayPush(starts, bounds[0]);
        ArrayPush(ends, bounds[1]);
        ArrayPush(kinds, MirObjectStringFactAtBounds(
            json, bounds[0], bounds[1], "kind"
        ));
        ArrayPush(nominal_kinds, MirObjectStringFactAtBounds(
            json, bounds[0], bounds[1], "nominal_kind"
        ));
        ArrayPush(names, MirObjectStringFactAtBounds(
            json, bounds[0], bounds[1], "name"
        ));
        let source_module_path: String = MirObjectStringFactAtBounds(json, bounds[0], bounds[1], "source_module_path");
        valid = valid && source_module_path != "";
        ArrayPush(source_module_paths, source_module_path);
        cursor = bounds[1];
    }
    valid = valid && MirProgramDeclarationIndexCursorAtEnd(
        json, cursor, declaration_end
    ) && ArrayLength(starts) == ArrayLength(ends) &&
        ArrayLength(starts) == ArrayLength(kinds) &&
        ArrayLength(starts) == ArrayLength(nominal_kinds) &&
        ArrayLength(starts) == ArrayLength(names) && ArrayLength(starts) == ArrayLength(source_module_paths);
    field_identities =
        BuildMirProgramDeclarationFieldIdentityIndexFromDeclarationSpans(
            json, starts, ends, names, kinds, nominal_kinds
        );
    enum_variants = BuildMirProgramEnumVariantIndexFromDeclarationSpans(
        json, starts, ends, kinds, names
    );
    return MirProgramDeclarationIndex(
        valid && enum_variants.valid, starts, ends, kinds, nominal_kinds, names, source_module_paths, field_identities, enum_variants
    );
}

func BuildMirProgramDeclarationIndex(json: String) -> MirProgramDeclarationIndex {
    let document: MirDocumentFactIndex = BuildMirDocumentFactIndex(json);
    return BuildMirProgramDeclarationIndexFromTable(document.declarations);
}

func MirProgramDeclarationIndexCount(
    ref index: MirProgramDeclarationIndex
) -> Int {
    return ArrayLength(index.starts);
}

func MirProgramDeclarationIndexContains(
    ref index: MirProgramDeclarationIndex, kind: String, name: String
) -> Bool {
    if !index.valid || StringLength(kind) == 0 || StringLength(name) == 0 {
        return false;
    }
    let i: Int = 0;
    while i < ArrayLength(index.kinds) {
        if (index.kinds[i] == kind || index.nominal_kinds[i] == kind) &&
            index.names[i] == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}
