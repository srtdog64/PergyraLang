// Program-owned payload-free enum variant identity index.
//
// Declaration admission captures each variant once.  Match consumers query
// these rows instead of rebuilding the declaration graph from the JSON root.

import "json_fact_read.pgy";

struct MirProgramEnumVariantIndex {
    let valid: Bool;
    let names: Array<String>;
    let owners: Array<String>;
    let ordinals: Array<Int>;
    let param_counts: Array<Int>;
    let param_type_starts: Array<Int>;
    let param_types: Array<String>;
}

func EmptyMirProgramEnumVariantIndex() -> MirProgramEnumVariantIndex {
    let names: Array<String> = [];
    let owners: Array<String> = [];
    let ordinals: Array<Int> = [];
    let param_counts: Array<Int> = [];
    let param_type_starts: Array<Int> = [];
    let param_types: Array<String> = [];
    return MirProgramEnumVariantIndex(
        false, names, owners, ordinals, param_counts, param_type_starts,
        param_types
    );
}

func MirProgramEnumVariantArrayCursorAtEnd(
    json: String, cursor: Int, array_end: Int
) -> Bool {
    let json_extent: Int = StringLength(json);
    let i: Int = JsonSkipWhitespace(json, cursor, array_end);
    return i < array_end &&
        JsonCharCodeAt(json, json_extent, json_extent, i) == JsonAsciiCode("]");
}

func BuildMirProgramEnumVariantIndexFromDeclarationSpans(
    json: String, json_extent: Int,
    declaration_starts: Array<Int>,
    declaration_ends: Array<Int>,
    declaration_kinds: Array<String>,
    declaration_names: Array<String>
) -> MirProgramEnumVariantIndex {
    var names: Array<String> = [];
    var owners: Array<String> = [];
    var ordinals: Array<Int> = [];
    var param_counts: Array<Int> = [];
    var param_type_starts: Array<Int> = [];
    var param_types: Array<String> = [];
    let declaration_count: Int = ArrayLength(declaration_starts);
    if ArrayLength(declaration_ends) != declaration_count ||
        ArrayLength(declaration_kinds) != declaration_count ||
        ArrayLength(declaration_names) != declaration_count {
        return MirProgramEnumVariantIndex(
            false, names, owners, ordinals, param_counts,
            param_type_starts, param_types
        );
    }
    var valid: Bool = true;
    var declaration_row: Int = 0;
    while declaration_row < declaration_count {
        if declaration_kinds[declaration_row] == "enum" {
            var variants: Array<Int> = [0, 0];
            if !MirObjectArrayBoundsAtBounds(
                json, json_extent, declaration_starts[declaration_row],
                declaration_ends[declaration_row], "variants", variants
            ) || declaration_names[declaration_row] == "" {
                valid = false;
            } else {
                var cursor: Int = variants[0] + 1;
                var variant: Array<Int> = [0, 0];
                var ordinal: Int = 0;
                while JsonArrayNextObjectBounds(
                    json, json_extent, cursor, variants[1], variant
                ) {
                    let name: String = MirObjectStringFactAtBounds(
                        json, json_extent, variant[0], variant[1], "name"
                    );
                    let count_text: String = MirObjectNumberFactAtBounds(
                        json, json_extent, variant[0], variant[1], "param_count"
                    );
                    var payload_bounds: Array<Int> = [0, 0];
                    var payloads: Array<String> = [];
                    if MirObjectArrayBoundsAtBounds(
                        json, json_extent, variant[0], variant[1], "param_types",
                        payload_bounds
                    ) {
                        payloads = MirObjectArrayStringFactsAtBounds(
                            json, json_extent, variant[0], variant[1], "param_types"
                        );
                    } else {
                        valid = false;
                    }
                    let param_count: Int = ToInt(count_text);
                    let variant_table: JsonObjectFactTable =
                        JsonObjectFactTableFromBounds(
                            json, json_extent, variant[0], variant[1]
                        );
                    if JsonObjectFactCount(variant_table) != 3 ||
                        name == "" || count_text == "" ||
                        ToString(param_count) != count_text ||
                        param_count < 0 || param_count != ArrayLength(payloads) {
                        valid = false;
                    }
                    var prior: Int = 0;
                    while prior < ArrayLength(names) {
                        if owners[prior] == declaration_names[declaration_row] &&
                            names[prior] == name {
                            valid = false;
                        }
                        prior = prior + 1;
                    }
                    ArrayPush(names, name);
                    ArrayPush(owners, Concat("", declaration_names[declaration_row]));
                    ArrayPush(ordinals, ordinal);
                    ArrayPush(param_counts, param_count);
                    ArrayPush(param_type_starts, ArrayLength(param_types));
                    var payload: Int = 0;
                    while payload < ArrayLength(payloads) {
                        if payloads[payload] == "" { valid = false; }
                        ArrayPush(param_types, payloads[payload]);
                        payload = payload + 1;
                    }
                    ordinal = ordinal + 1;
                    cursor = variant[1];
                }
                if !MirProgramEnumVariantArrayCursorAtEnd(
                    json, cursor, variants[1]
                ) { valid = false; }
            }
        }
        declaration_row = declaration_row + 1;
    }
    return MirProgramEnumVariantIndex(
        valid && ArrayLength(names) == ArrayLength(owners) &&
            ArrayLength(names) == ArrayLength(ordinals) &&
            ArrayLength(names) == ArrayLength(param_counts) &&
            ArrayLength(names) == ArrayLength(param_type_starts),
        names, owners, ordinals, param_counts, param_type_starts, param_types
    );
}

func MirProgramEnumVariantIndexReady(
    ref index: MirProgramEnumVariantIndex
) -> Bool {
    let count: Int = ArrayLength(index.names);
    if !index.valid || count != ArrayLength(index.owners) ||
        count != ArrayLength(index.ordinals) ||
        count != ArrayLength(index.param_counts) ||
        count != ArrayLength(index.param_type_starts) {
        return false;
    }
    var expected_payload_start: Int = 0;
    var row: Int = 0;
    while row < count {
        if index.names[row] == "" || index.owners[row] == "" ||
            index.ordinals[row] < 0 || index.param_counts[row] < 0 ||
            index.param_type_starts[row] != expected_payload_start ||
            expected_payload_start + index.param_counts[row] >
                ArrayLength(index.param_types) {
            return false;
        }
        expected_payload_start = expected_payload_start +
            index.param_counts[row];
        row = row + 1;
    }
    return expected_payload_start == ArrayLength(index.param_types);
}

func MirProgramEnumVariantRowForOwnerAndName(
    ref index: MirProgramEnumVariantIndex, owner: String, name: String
) -> Option<Int> {
    if !MirProgramEnumVariantIndexReady(index) || owner == "" || name == "" {
        return None;
    }
    var found: Int = 0 - 1;
    var row: Int = 0;
    while row < ArrayLength(index.names) {
        if index.owners[row] == owner && index.names[row] == name {
            if found >= 0 { return None; }
            found = row;
        }
        row = row + 1;
    }
    if found < 0 { return None; }
    return Some(found);
}

func MirProgramEnumVariantPayloadFreeAt(
    ref index: MirProgramEnumVariantIndex, row: Int
) -> Bool {
    return MirProgramEnumVariantIndexReady(index) && row >= 0 &&
        row < ArrayLength(index.names) && index.param_counts[row] == 0;
}

func MirProgramEnumVariantOwnerForName(
    ref index: MirProgramEnumVariantIndex, variant: String
) -> String {
    if !MirProgramEnumVariantIndexReady(index) || variant == "" {
        return "";
    }
    var owner: String = "";
    var ambiguous: Bool = false;
    var row: Int = 0;
    while row < ArrayLength(index.names) {
        if index.names[row] == variant {
            if owner == "" {
                owner = index.owners[row];
            } else if owner != index.owners[row] {
                ambiguous = true;
            }
        }
        row = row + 1;
    }
    if ambiguous { return ""; }
    return owner;
}
