// MIR document -> compact AST Program owner for self-hosted mir_lower.
//
// Owns document-order declaration/routine assembly. `main.pgy` supplies an
// already validated MIR JSON document and prints this owner's result.

import "error_owner.pgy";
import "decl_lower.pgy";
import "routine_inventory_owner.pgy";
import "routine_lower.pgy";

func EmitMirProgramTree(json: String) -> String {
    let out: String = Concat("Program:\n", EmitStructDecls(json));
    let total: Int = 0;
    let rpos_opt: Option<Int> = FindRoutine(json, 0);
    if !IsSome(rpos_opt) {
        MirLowerFailClosed("no routine name in MIR-JSON");
    }
    while IsSome(rpos_opt) {
        let rpos: Int = UnwrapOption(rpos_opt);
        let nend_opt: Option<Int> = RoutineNameEnd(json, rpos);
        if !IsSome(nend_opt) {
            MirLowerFailClosed("malformed routine name");
        }
        let nend: Int = UnwrapOption(nend_opt);
        let span_end: Int = RoutineSpanEnd(json, nend);
        let kind: String = RoutineKind(json, rpos, nend, span_end);
        let owner: String = RoutineOwner(json, rpos, nend, span_end);
        if kind == "function" || StringLength(owner) == 0 {
            out = Concat(out, EmitRoutineTree(json, rpos, "  "));
            total = total + 1;
        }
        rpos_opt = FindRoutine(json, span_end);
    }

    if total == 0 {
        MirLowerFailClosed("no supported routines found in MIR-JSON document");
    }
    return out;
}
