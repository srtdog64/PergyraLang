// MIR document -> compact AST Program owner for self-hosted mir_lower.
//
// Owns document-order declaration/routine assembly. `main.pgy` supplies an
// already validated MIR JSON document and prints this owner's result.

import "error_owner.pgy";
import "decl_lower.pgy";
import "program_routine_index_owner.pgy";
import "routine_inventory_owner.pgy";
import "routine_lower.pgy";

func MirProgramLowerPressureStage(enabled: Bool, stage: String) -> Void {
    if enabled {
        Log(Concat("[driver-pressure-stage] ", stage));
    }
}

func EmitMirProgramTreeFromRoutineIndexObserved(
    ref routines: MirProgramRoutineIndex,
    observe_pressure: Bool
) -> String {
    if !routines.valid {
        MirLowerFailClosed("MIR routine inventory is missing");
    }
    let chunks: Array<String> = ["Program:\n", EmitStructDecls(routines)];
    MirProgramLowerPressureStage(
        observe_pressure, "consumer:mir-to-ast:declarations:done"
    );
    let total: Int = 0;
    let row: Int = 0;
    if MirProgramRoutineIndexCount(routines) == 0 {
        MirLowerFailClosed("no routine name in MIR-JSON");
    }
    while row < MirProgramRoutineIndexCount(routines) {
        let kind: String = routines.kinds[row];
        let owner: String = routines.owners[row];
        if kind == "function" || StringLength(owner) == 0 {
            ArrayPush(chunks, EmitRoutineTreeAtRow(
                routines, row, "  ",
                observe_pressure && total == 0,
                observe_pressure && total == 16
            ));
            if observe_pressure && total == 0 {
                MirProgramLowerPressureStage(
                    true, "consumer:mir-to-ast:first-top-level-routine:done"
                );
            }
            total = total + 1;
            if observe_pressure && total == 16 {
                MirProgramLowerPressureStage(
                    true, "consumer:mir-to-ast:top-level-routines:16"
                );
            }
            if observe_pressure && total % 64 == 0 {
                MirProgramLowerPressureStage(
                    true, Concat(
                        "consumer:mir-to-ast:top-level-routines:",
                        ToString(total)
                    )
                );
            }
        }
        row = row + 1;
    }

    if total == 0 {
        MirLowerFailClosed("no supported routines found in MIR-JSON document");
    }
    MirProgramLowerPressureStage(
        observe_pressure, "consumer:mir-to-ast:top-level-routines:done"
    );
    return StringJoin(chunks, "");
}

func EmitMirProgramTreeFromRoutineIndex(
    ref routines: MirProgramRoutineIndex
) -> String {
    return EmitMirProgramTreeFromRoutineIndexObserved(routines, false);
}

func EmitMirProgramTree(json: String) -> String {
    let routines: MirProgramRoutineIndex = BuildMirProgramRoutineIndex(json);
    return EmitMirProgramTreeFromRoutineIndex(routines);
}
