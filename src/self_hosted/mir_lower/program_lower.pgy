// MIR document -> compact AST Program owner for self-hosted mir_lower.
//
// Owns document-order declaration/routine assembly. `main.pgy` supplies an
// already validated MIR JSON document and prints this owner's result.

import "error_owner.pgy";
import "decl_lower.pgy";
import "program_routine_index_owner.pgy";
import "routine_inventory_owner.pgy";
import "structured_expression_emission_order_owner.pgy";
import "routine_lower.pgy";

struct MirProgramTreeEmission {
    let ok: Bool;
    let text: String;
    let expression_order: MirStructuredExpressionEmissionOrder;
}

func MirProgramLowerPressureStage(enabled: Bool, stage: String) -> Void {
    if enabled {
        Log(Concat("[driver-pressure-stage] ", stage));
    }
}

func EmitMirProgramTreeProjectionFromRoutineIndexObserved(
    ref routines: MirProgramRoutineIndex,
    observe_pressure: Bool
) -> MirProgramTreeEmission {
    if !routines.valid {
        MirLowerFailClosed("MIR routine inventory is missing");
    }
    let expression_order: MirStructuredExpressionEmissionOrder =
        MirStructuredExpressionEmissionOrderEmpty();
    let abi_validation: MirAbiLayoutValidationSession =
        NewMirAbiLayoutValidationSession();
    let chunks: Array<String> = [
        "Program:\n", EmitStructDecls(
            routines, expression_order, abi_validation
        )
    ];
    MirProgramLowerPressureStage(
        observe_pressure, "consumer:mir-to-ast:declarations:done"
    );
    let total: Int = 0;
    let row: Int = 0;
    if MirProgramRoutineIndexCount(routines) == 0 {
        MirLowerFailClosed("no routine name in MIR-JSON");
    }
    while row < MirProgramRoutineIndexCount(routines) {
        let kind: String = routines.kinds[row];
        let owner: String = routines.owners[row];
        if kind == "function" || StringLength(owner) == 0 {
            let observe_focused_routine: Bool = observe_pressure &&
                (total == 16 || total == 184 || total == 185 ||
                 total == 191 || total == 242);
            if observe_focused_routine {
                MirProgramLowerPressureStage(
                    true, Concat(
                        "consumer:mir-to-ast:focused-routine:start:",
                        ToString(total)
                    )
                );
            }
            ArrayPush(chunks, EmitRoutineTreeAtRowWithExpressionOrder(
                routines, row, "  ",
                observe_pressure && total == 0,
                observe_focused_routine, expression_order, abi_validation
            ));
            if observe_pressure && total == 0 {
                MirProgramLowerPressureStage(
                    true, "consumer:mir-to-ast:first-top-level-routine:done"
                );
            }
            total = total + 1;
            if observe_pressure && total == 16 {
                MirProgramLowerPressureStage(
                    true, "consumer:mir-to-ast:top-level-routines:16"
                );
            }
            if observe_pressure && total % 64 == 0 {
                MirProgramLowerPressureStage(
                    true, Concat(
                        "consumer:mir-to-ast:top-level-routines:",
                        ToString(total)
                    )
                );
            }
            // The full-driver pressure rung currently accumulates its first
            // unresolved CPU interval between 128 and 256. Keep the detailed
            // cursor with the document-order assembly owner, and expose it
            // only in the explicit observation lane.
            if observe_pressure && total >= 128 && total <= 256 &&
                total % 8 == 0 && total % 64 != 0 {
                MirProgramLowerPressureStage(
                    true, Concat(
                        "consumer:mir-to-ast:top-level-routines-detail:",
                        ToString(total)
                    )
                );
            }
            if observe_pressure &&
                ((total >= 184 && total <= 192) ||
                 (total >= 240 && total <= 248)) &&
                total % 8 != 0 {
                MirProgramLowerPressureStage(
                    true, Concat(
                        "consumer:mir-to-ast:top-level-routine-hot:",
                        ToString(total)
                    )
                );
            }
        }
        row = row + 1;
    }

    if total == 0 {
        MirLowerFailClosed("no supported routines found in MIR-JSON document");
    }
    let abi_ready: Bool =
        MirAbiLayoutValidationSessionReady(abi_validation);
    let expression_order_ready: Bool =
        MirStructuredExpressionEmissionOrderReady(expression_order);
    if !abi_ready {
        MirLowerFailClosed("MIR ABI validation session is inconsistent");
    }
    if !expression_order_ready {
        MirLowerFailClosed("MIR expression emission order is inconsistent");
    }
    let projection_ready: Bool =
        routines.valid && abi_ready && expression_order_ready;
    MirProgramLowerPressureStage(
        observe_pressure, "consumer:mir-to-ast:top-level-routines:done"
    );
    return MirProgramTreeEmission(
        projection_ready, StringJoin(chunks, ""), expression_order
    );
}

func EmitMirProgramTreeFromRoutineIndexObserved(
    ref routines: MirProgramRoutineIndex,
    observe_pressure: Bool
) -> String {
    return EmitMirProgramTreeProjectionFromRoutineIndexObserved(
        routines, observe_pressure
    ).text;
}

func EmitMirProgramTreeProjectionFromRoutineIndex(
    ref routines: MirProgramRoutineIndex
) -> MirProgramTreeEmission {
    return EmitMirProgramTreeProjectionFromRoutineIndexObserved(
        routines, false
    );
}

func EmitMirProgramTreeFromRoutineIndex(
    ref routines: MirProgramRoutineIndex
) -> String {
    return EmitMirProgramTreeFromRoutineIndexObserved(routines, false);
}

func EmitMirProgramTree(json: String) -> String {
    let routines: MirProgramRoutineIndex = BuildMirProgramRoutineIndex(json);
    return EmitMirProgramTreeFromRoutineIndex(routines);
}
