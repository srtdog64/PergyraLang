// One pgy.mir.v1 routine/block/instruction inventory shared by declaration,
// machine admission, and reconstruction consumers.

import "json_fact_read.pgy";
import "program_declaration_index_owner.pgy";
import "program_routine_block_fact_owner.pgy";
import "program_routine_receiver_identity_owner.pgy";
import "program_instruction_expression_index_owner.pgy";

func MirProgramRoutineArrayCursorAtEnd(
    json: String,
    cursor: Int,
    array_end: Int
) -> Bool {
    let i: Int = JsonSkipWhitespaceWithin(json, cursor, array_end);
    return i < array_end &&
        JsonCharCodeAt(json, array_end, i) == JsonAsciiCode("]");
}

struct MirProgramRoutineIndex {
    let valid: Bool;
    let source_json: String;
    let source_length: Int;
    let declarations: MirProgramDeclarationIndex;
    let starts: Array<Int>;
    let ends: Array<Int>;
    let kinds: Array<String>;
    let owners: Array<String>;
    let names: Array<String>;
    let source_syntax_ids: Array<String>;
    let source_module_paths: Array<String>;
    let receiver_carriages: Array<String>;
    let owner_nominal_kinds: Array<String>;
    let owner_declaration_rows: Array<Int>;
    let routine_block_starts: Array<Int>;
    let routine_block_counts: Array<Int>;
    let block_starts: Array<Int>;
    let block_ends: Array<Int>;
    let block_reachable: Array<Bool>;
    let block_succ_true: Array<Int>;
    let block_succ_false: Array<Int>;
    let block_instruction_starts: Array<Int>;
    let block_instruction_counts: Array<Int>;
    let instruction_starts: Array<Int>;
    let instruction_ends: Array<Int>;
    let instruction_kinds: Array<String>;
    let instruction_source_types: Array<String>;
    let instruction_abi_type_names: Array<String>;
    let instruction_machine_contact_starts: Array<Int>;
    let instruction_machine_contact_ends: Array<Int>;
    let instruction_machine_layer_starts: Array<Int>;
    let instruction_machine_layer_ends: Array<Int>;
    let instruction_expressions: MirProgramInstructionExpressionIndex;
}

func BuildMirProgramRoutineIndexFromTable(
    ref routines: JsonArrayObjectFactTable,
    declarations: MirProgramDeclarationIndex
) -> MirProgramRoutineIndex {
    let json: String = routines.json;
    let starts: Array<Int> = [];
    let ends: Array<Int> = [];
    let kinds: Array<String> = [];
    let owners: Array<String> = [];
    let names: Array<String> = [];
    let source_syntax_ids: Array<String> = [];
    let source_module_paths: Array<String> = [];
    let receiver_carriages: Array<String> = [];
    let owner_nominal_kinds: Array<String> = [];
    let owner_declaration_rows: Array<Int> = [];
    let routine_block_starts: Array<Int> = [];
    let routine_block_counts: Array<Int> = [];
    let block_starts: Array<Int> = [];
    let block_ends: Array<Int> = [];
    let block_reachable: Array<Bool> = [];
    let block_succ_true: Array<Int> = [];
    let block_succ_false: Array<Int> = [];
    let block_instruction_starts: Array<Int> = [];
    let block_instruction_counts: Array<Int> = [];
    let instruction_starts: Array<Int> = [];
    let instruction_ends: Array<Int> = [];
    let instruction_kinds: Array<String> = [];
    let instruction_source_types: Array<String> = [];
    let instruction_abi_type_names: Array<String> = [];
    let instruction_machine_contact_starts: Array<Int> = [];
    let instruction_machine_contact_ends: Array<Int> = [];
    let instruction_machine_layer_starts: Array<Int> = [];
    let instruction_machine_layer_ends: Array<Int> = [];
    let instruction_expressions: MirProgramInstructionExpressionIndex =
        MirProgramInstructionExpressionIndexEmpty();
    let expression_routing_bounds: Array<Int> =
        instruction_expressions.routing_bounds;
    let expression_text_bounds: Array<Int> =
        instruction_expressions.text_bounds;
    let expression_graph_bounds: Array<Int> =
        instruction_expressions.graph_bounds;
    let valid: Bool =
        declarations.valid && declarations.field_identities.valid;
    if !JsonArrayObjectFactTableReady(routines) {
        return MirProgramRoutineIndex(
            false, json, StringLength(json), declarations,
            starts, ends, kinds, owners, names,
            source_syntax_ids, source_module_paths, receiver_carriages,
            owner_nominal_kinds,
            owner_declaration_rows,
            routine_block_starts, routine_block_counts,
            block_starts, block_ends, block_reachable,
            block_succ_true, block_succ_false,
            block_instruction_starts, block_instruction_counts,
            instruction_starts, instruction_ends,
            instruction_kinds, instruction_source_types,
            instruction_abi_type_names,
            instruction_machine_contact_starts,
            instruction_machine_contact_ends,
            instruction_machine_layer_starts,
            instruction_machine_layer_ends, instruction_expressions
        );
    }

    let cursor: Int = routines.start + 1;
    let bounds: Array<Int> = [0, 0];
    while JsonArrayNextObjectBounds(json, cursor, routines.end, bounds) {
        ArrayPush(starts, bounds[0]);
        ArrayPush(ends, bounds[1]);
        let routine_kind: String = MirObjectStringFactAtBounds(
            json, bounds[0], bounds[1], "kind"
        );
        let routine_name: String = MirObjectStringFactAtBounds(
            json, bounds[0], bounds[1], "name"
        );
        let owner: String = MirObjectStringFactAtBounds(
            json, bounds[0], bounds[1], "owner"
        );
        let source_syntax_id: String = MirObjectNumberFactAtBounds(
            json, bounds[0], bounds[1], "source_syntax_id"
        );
        let source_module_path: String = MirObjectStringFactAtBounds(
            json, bounds[0], bounds[1], "source_module_path"
        );
        let receiver_carriage: String = MirObjectStringFactAtBounds(
            json, bounds[0], bounds[1], "receiver_carriage"
        );
        let receiver_identity: MirProgramRoutineReceiverIdentityCapture =
            CaptureMirProgramRoutineReceiverIdentity(
                declarations, routine_kind, owner, source_syntax_id,
                receiver_carriage, source_syntax_ids);
        if routine_kind == "" || routine_name == "" ||
            source_module_path == "" ||
            !receiver_identity.valid {
            valid = false;
        }
        ArrayPush(kinds, routine_kind);
        ArrayPush(owners, owner);
        ArrayPush(names, routine_name);
        ArrayPush(source_syntax_ids, receiver_identity.source_syntax_id);
        ArrayPush(source_module_paths, source_module_path);
        ArrayPush(receiver_carriages, receiver_identity.receiver_carriage);
        ArrayPush(owner_nominal_kinds, receiver_identity.owner_nominal_kind);
        ArrayPush(owner_declaration_rows,
            receiver_identity.owner_declaration_row);
        ArrayPush(routine_block_starts, ArrayLength(block_starts));
        let routine_block_count: Int = 0;
        let blocks_bounds: Array<Int> = [0, 0];
        if !MirObjectArrayBoundsAtBounds(
            json, bounds[0], bounds[1], "blocks", blocks_bounds
        ) {
            valid = false;
        } else {
            let block_cursor: Int = blocks_bounds[0] + 1;
            let block_bounds: Array<Int> = [0, 0];
            while JsonArrayNextObjectBounds(
                json, block_cursor, blocks_bounds[1], block_bounds
            ) {
                let block_fact: MirProgramRoutineBlockCapture =
                    MirProgramRoutineBlockCaptureWithin(
                        json, block_bounds[0], block_bounds[1]
                    );
                if !block_fact.valid ||
                    block_fact.id != ToString(routine_block_count) {
                    valid = false;
                }
                ArrayPush(block_starts, block_bounds[0]);
                ArrayPush(block_ends, block_bounds[1]);
                ArrayPush(block_reachable, block_fact.reachable);
                ArrayPush(block_succ_true, block_fact.succ_true);
                ArrayPush(block_succ_false, block_fact.succ_false);
                ArrayPush(
                    block_instruction_starts, ArrayLength(instruction_starts)
                );
                let instruction_count: Int = 0;
                if block_fact.valid {
                    let instruction_cursor: Int =
                        block_fact.instructions_start + 1;
                    let instruction_bounds: Array<Int> = [0, 0];
                    while JsonArrayNextObjectBounds(
                        json, instruction_cursor, block_fact.instructions_end,
                        instruction_bounds
                    ) {
                        ArrayPush(instruction_starts, instruction_bounds[0]);
                        ArrayPush(instruction_ends, instruction_bounds[1]);
                        let expression:
                            MirProgramInstructionExpressionCapture =
                            MirProgramInstructionExpressionCaptureWithin(
                                json, instruction_bounds[0],
                                instruction_bounds[1]
                            );
                        if !MirProgramInstructionExpressionRowsAppend(
                            expression_routing_bounds,
                            expression_text_bounds,
                            expression_graph_bounds, expression
                        ) { valid = false; }
                        ArrayPush(instruction_kinds, expression.kind);
                        ArrayPush(
                            instruction_source_types, expression.source_type
                        );
                        ArrayPush(instruction_abi_type_names,
                            MirObjectStringFactAtBounds(
                                json, instruction_bounds[0],
                                instruction_bounds[1], "abi_type_name"));
                        ArrayPush(
                            instruction_machine_contact_starts,
                            expression.machine_contact_start
                        );
                        ArrayPush(
                            instruction_machine_contact_ends,
                            expression.machine_contact_end
                        );
                        ArrayPush(
                            instruction_machine_layer_starts,
                            expression.machine_layer_start
                        );
                        ArrayPush(
                            instruction_machine_layer_ends,
                            expression.machine_layer_end
                        );
                        instruction_count = instruction_count + 1;
                        instruction_cursor = instruction_bounds[1];
                    }
                    if !MirProgramRoutineArrayCursorAtEnd(
                        json, instruction_cursor, block_fact.instructions_end
                    ) { valid = false; }
                } else {
                    valid = false;
                }
                ArrayPush(block_instruction_counts, instruction_count);
                routine_block_count = routine_block_count + 1;
                block_cursor = block_bounds[1];
            }
            if !MirProgramRoutineArrayCursorAtEnd(
                json, block_cursor, blocks_bounds[1]
            ) { valid = false; }
        }
        ArrayPush(routine_block_counts, routine_block_count);
        cursor = bounds[1];
    }
    if !MirProgramRoutineArrayCursorAtEnd(json, cursor, routines.end) {
        valid = false;
    }
    instruction_expressions = MirProgramInstructionExpressionIndexFromRows(
        expression_routing_bounds,
        expression_text_bounds, expression_graph_bounds
    );
    return MirProgramRoutineIndex(
        valid, json, StringLength(json), declarations,
        starts, ends, kinds, owners, names,
        source_syntax_ids, source_module_paths, receiver_carriages,
        owner_nominal_kinds,
        owner_declaration_rows,
        routine_block_starts, routine_block_counts,
        block_starts, block_ends, block_reachable,
        block_succ_true, block_succ_false,
        block_instruction_starts, block_instruction_counts,
        instruction_starts, instruction_ends,
        instruction_kinds, instruction_source_types,
        instruction_abi_type_names,
        instruction_machine_contact_starts,
        instruction_machine_contact_ends,
        instruction_machine_layer_starts,
        instruction_machine_layer_ends, instruction_expressions
    );
}

func BuildMirProgramRoutineIndex(json: String) -> MirProgramRoutineIndex {
    let document: MirDocumentFactIndex = BuildMirDocumentFactIndex(json);
    let declarations: MirProgramDeclarationIndex =
        BuildMirProgramDeclarationIndexFromTable(document.declarations);
    return BuildMirProgramRoutineIndexFromTable(
        document.routines, declarations
    );
}

func MirProgramRoutineIndexCount(ref index: MirProgramRoutineIndex) -> Int {
    return ArrayLength(index.starts);
}
func MirProgramRoutineIndexRowReady(
    ref index: MirProgramRoutineIndex, row: Int) -> Bool {
    let routine_count: Int = ArrayLength(index.starts);
    if !index.valid || row < 0 || row >= routine_count ||
        routine_count != ArrayLength(index.ends) || routine_count != ArrayLength(index.kinds) ||
        routine_count != ArrayLength(index.owners) || routine_count != ArrayLength(index.names) ||
        routine_count != ArrayLength(index.source_syntax_ids) ||
        routine_count != ArrayLength(index.source_module_paths) ||
        routine_count != ArrayLength(index.receiver_carriages) ||
        routine_count != ArrayLength(index.owner_nominal_kinds) || routine_count != ArrayLength(index.owner_declaration_rows) ||
        routine_count != ArrayLength(index.routine_block_starts) ||
        routine_count != ArrayLength(index.routine_block_counts) {
        return false;
    }
    let block_start: Int = index.routine_block_starts[row];
    let block_count: Int = index.routine_block_counts[row];
    let receiver_ready: Bool = MirProgramRoutineReceiverIdentityReady(
        index.kinds[row], index.owners[row], index.owner_nominal_kinds[row], index.receiver_carriages[row]);
    let owner_ready: Bool = index.owner_declaration_rows[row] == (0 - 1);
    if index.kinds[row] == "method" {
        let owner_row: Int = index.owner_declaration_rows[row];
        owner_ready = owner_row >= 0 && owner_row < ArrayLength(index.declarations.names) &&
            owner_row < ArrayLength(index.declarations.nominal_kinds) &&
            index.declarations.names[owner_row] == index.owners[row] &&
            MirProgramRoutineOwnerNominalKindAt(index.declarations, owner_row) ==
                index.owner_nominal_kinds[row];
    }
    return index.starts[row] >= 0 && index.ends[row] > index.starts[row] &&
        index.ends[row] <= index.source_length &&
        index.kinds[row] != "" && index.names[row] != "" &&
        index.source_module_paths[row] != "" &&
        MirProgramDeclarationFieldIdentityPositiveDecimal(index.source_syntax_ids[row]) &&
        receiver_ready && owner_ready &&
        block_start >= 0 && block_count >= 0 &&
        block_start + block_count <= ArrayLength(index.block_starts);
}

func MirProgramRoutineIndexGlobalInstructionRow(
    ref index: MirProgramRoutineIndex,
    routine_row: Int,
    routine_block_row: Int,
    block_instruction_row: Int
) -> Int {
    if !MirProgramRoutineIndexRowReady(index, routine_row) ||
        routine_block_row < 0 || block_instruction_row < 0 ||
        routine_block_row >= index.routine_block_counts[routine_row] {
        return 0 - 1;
    }
    let block_row: Int =
        index.routine_block_starts[routine_row] + routine_block_row;
    if block_row < 0 ||
        block_row >= ArrayLength(index.block_instruction_starts) ||
        block_row >= ArrayLength(index.block_instruction_counts) ||
        block_instruction_row >= index.block_instruction_counts[block_row] {
        return 0 - 1;
    }
    let instruction_row: Int =
        index.block_instruction_starts[block_row] + block_instruction_row;
    if instruction_row < 0 ||
        instruction_row >= ArrayLength(index.instruction_starts) ||
        instruction_row >= ArrayLength(index.instruction_ends) ||
        instruction_row >= ArrayLength(index.instruction_kinds) ||
        instruction_row >= ArrayLength(index.instruction_source_types) ||
        instruction_row >= ArrayLength(index.instruction_abi_type_names) ||
        instruction_row >= ArrayLength(
            index.instruction_machine_contact_starts) ||
        instruction_row >= ArrayLength(
            index.instruction_machine_contact_ends) ||
        instruction_row >= ArrayLength(
            index.instruction_machine_layer_starts) ||
        instruction_row >= ArrayLength(
            index.instruction_machine_layer_ends) {
        return 0 - 1;
    }
    let instruction_start: Int = index.instruction_starts[instruction_row];
    let instruction_end: Int = index.instruction_ends[instruction_row];
    if instruction_start < index.block_starts[block_row] ||
        instruction_end > index.block_ends[block_row] ||
        instruction_end <= instruction_start ||
        instruction_end > index.source_length {
        return 0 - 1;
    }
    return instruction_row;
}

func MirProgramRoutineIndexBlockInstructionCountAt(
    ref index: MirProgramRoutineIndex,
    routine_row: Int,
    routine_block_row: Int
) -> Int {
    if !MirProgramRoutineIndexRowReady(index, routine_row) ||
        routine_block_row < 0 ||
        routine_block_row >= index.routine_block_counts[routine_row] {
        return 0 - 1;
    }
    let block_row: Int =
        index.routine_block_starts[routine_row] + routine_block_row;
    if block_row < 0 ||
        block_row >= ArrayLength(index.block_instruction_counts) {
        return 0 - 1;
    }
    return index.block_instruction_counts[block_row];
}

func MirProgramRoutineIndexStructureReady(
    ref index: MirProgramRoutineIndex
) -> Bool {
    let routine_count: Int = ArrayLength(index.starts);
    let block_count: Int = ArrayLength(index.block_starts);
    let instruction_count: Int = ArrayLength(index.instruction_starts);
    if !index.valid ||
        index.source_length != StringLength(index.source_json) ||
        routine_count != ArrayLength(index.ends) ||
        routine_count != ArrayLength(index.kinds) {
        return false;
    }
    if routine_count != ArrayLength(index.owners) ||
        routine_count != ArrayLength(index.names) ||
        routine_count != ArrayLength(index.source_syntax_ids) ||
        routine_count != ArrayLength(index.source_module_paths) ||
        routine_count != ArrayLength(index.receiver_carriages) ||
        routine_count != ArrayLength(index.owner_nominal_kinds) ||
        routine_count != ArrayLength(index.owner_declaration_rows) ||
        routine_count != ArrayLength(index.routine_block_starts) ||
        routine_count != ArrayLength(index.routine_block_counts) ||
        block_count != ArrayLength(index.block_ends) ||
        block_count != ArrayLength(index.block_reachable) ||
        block_count != ArrayLength(index.block_succ_true) ||
        block_count != ArrayLength(index.block_succ_false) ||
        block_count != ArrayLength(index.block_instruction_starts) ||
        block_count != ArrayLength(index.block_instruction_counts) ||
        instruction_count != ArrayLength(index.instruction_ends) ||
        instruction_count != ArrayLength(index.instruction_kinds) ||
        instruction_count != ArrayLength(index.instruction_source_types) ||
        instruction_count != ArrayLength(index.instruction_abi_type_names) ||
        instruction_count != ArrayLength(
            index.instruction_machine_contact_starts) ||
        instruction_count != ArrayLength(
            index.instruction_machine_contact_ends) ||
        instruction_count != ArrayLength(
            index.instruction_machine_layer_starts) ||
        instruction_count != ArrayLength(
            index.instruction_machine_layer_ends) ||
        !MirProgramInstructionExpressionIndexReady(
            index.instruction_expressions, instruction_count
        ) {
        return false;
    }
    let expected_block: Int = 0;
    let routine_row: Int = 0;
    while routine_row < routine_count {
        let count: Int = index.routine_block_counts[routine_row];
        if index.starts[routine_row] < 0 ||
            index.ends[routine_row] > index.source_length ||
            index.ends[routine_row] <= index.starts[routine_row] ||
            index.kinds[routine_row] == "" || index.names[routine_row] == "" ||
            index.source_module_paths[routine_row] == "" ||
            !MirProgramRoutineReceiverIdentityRowReady(
                index.declarations, index.kinds[routine_row],
                index.owners[routine_row],
                index.source_syntax_ids[routine_row],
                index.receiver_carriages[routine_row],
                index.owner_nominal_kinds[routine_row],
                index.owner_declaration_rows[routine_row],
                index.source_syntax_ids, routine_row
            ) ||
            index.routine_block_starts[routine_row] != expected_block ||
            count < 0 || expected_block + count > block_count {
            return false;
        }
        let local_block: Int = 0;
        while local_block < count {
            let block_row: Int = expected_block + local_block;
            if index.block_starts[block_row] < index.starts[routine_row] ||
                index.block_ends[block_row] > index.ends[routine_row] ||
                index.block_ends[block_row] <= index.block_starts[block_row] {
                return false;
            }
            local_block = local_block + 1;
        }
        expected_block = expected_block + count;
        routine_row = routine_row + 1;
    }
    if expected_block != block_count { return false; }
    let expected_instruction: Int = 0;
    let block_row: Int = 0;
    while block_row < block_count {
        let count: Int = index.block_instruction_counts[block_row];
        if index.block_instruction_starts[block_row] != expected_instruction ||
            count < 0 || expected_instruction + count > instruction_count {
            return false;
        }
        let local_instruction: Int = 0;
        while local_instruction < count {
            let instruction_row: Int = expected_instruction + local_instruction;
            let instruction_start: Int = index.instruction_starts[instruction_row];
            let instruction_end: Int = index.instruction_ends[instruction_row];
            let contact_start: Int =
                index.instruction_machine_contact_starts[instruction_row];
            let contact_end: Int =
                index.instruction_machine_contact_ends[instruction_row];
            let machine_start: Int =
                index.instruction_machine_layer_starts[instruction_row];
            let machine_end: Int =
                index.instruction_machine_layer_ends[instruction_row];
            if index.instruction_kinds[instruction_row] == "" ||
                instruction_start <
                    index.block_starts[block_row] ||
                instruction_end >
                    index.block_ends[block_row] ||
                instruction_end <= instruction_start ||
                ((contact_start < 0 || contact_end < 0) &&
                    (contact_start != (0 - 1) || contact_end != (0 - 1))) ||
                (contact_start >= 0 &&
                    (contact_start < instruction_start ||
                     contact_end > instruction_end ||
                     contact_end <= contact_start)) ||
                ((machine_start < 0 || machine_end < 0) &&
                    (machine_start != (0 - 1) || machine_end != (0 - 1))) ||
                (machine_start >= 0 &&
                    (machine_start < instruction_start ||
                     machine_end > instruction_end ||
                     machine_end <= machine_start)) {
                return false;
            }
            local_instruction = local_instruction + 1;
        }
        expected_instruction = expected_instruction + count;
        block_row = block_row + 1;
    }
    return expected_instruction == instruction_count;
}

func MirProgramRoutineIndexFindMethodRow(
    ref index: MirProgramRoutineIndex,
    owner: String,
    name: String
) -> Option<Int> {
    let row: Int = 0;
    while row < ArrayLength(index.starts) {
        if index.kinds[row] == "method" &&
            index.owners[row] == owner && index.names[row] == name {
            return Some(row);
        }
        row = row + 1;
    }
    return None;
}
