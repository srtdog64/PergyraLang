// MIR resource runtime-call row consumer for the self-hosted lowering lane.
// The native MIR producer owns row materialization; this owner only validates
// the carried fact before resource instructions are skipped by reconstruction.

import "json_fact_read.pgy";
import "machine_layer_fact_owner.pgy";
import "routine_instruction_view_owner.pgy";
import "../mir/runtime_call_abi_fact_owner.pgy";
import "../compiler/runtime_call_abi_structured_fact_owner.pgy";

func MirResourceRuntimeRowRequired(operation: String) -> Bool {
    return operation == "Claim" || operation == "Read" ||
        operation == "Write" || operation == "Release" ||
        operation == "PinRead" || operation == "PinWrite" ||
        operation == "PinReadInit" || operation == "PinWriteInit" ||
        operation == "Unpin" || operation == "UnpinCleanup" ||
        operation == "SubmitRead";
}

// Auxiliary rows are still MIR-owned facts.  A slot definition may carry a
// primary Claim row together with the concrete Read/Write or pin lifecycle
// rows that a backend consumer will use.  The self-hosted lane must validate
// those rows in place; accepting only the primary row would silently reopen
// global ABI-table reconstruction for the auxiliary operation.
func MirResourceRuntimeAuxRowFactReady(
    ref row: JsonObjectFactTable,
    type_name: String
) -> Bool {
    if !JsonObjectFactTableReady(row) ||
        !JsonObjectFactStringFieldEquals(row, "owner", "MIRResource") ||
        !JsonObjectFactStringFieldEquals(row, "type", type_name) {
        return false;
    }
    let operation_opt: Option<String> = JsonObjectFactStringFieldOpt(
        row, "operation");
    let id_opt: Option<String> = JsonObjectFactNumberFieldOpt(row, "id");
    let domain_opt: Option<String> = JsonObjectFactStringFieldOpt(
        row, "domain");
    if !IsSome(operation_opt) || !IsSome(id_opt) || !IsSome(domain_opt) {
        return false;
    }
    let operation: String = UnwrapOption(operation_opt);
    let domain: String = UnwrapOption(domain_opt);
    if !MirResourceRuntimeRowRequired(operation) {
        return false;
    }
    let expected: CompilerRuntimeCallAbiFact =
        CompilerRuntimeCallAbiFactForNativeResource(type_name, operation);
    if !expected.ok || domain != expected.domain ||
        !JsonObjectFactStringFieldEquals(row, "symbol", expected.symbol) ||
        !JsonObjectFactStringFieldEquals(
            row, "target_kind", expected.symbol_kind) ||
        !JsonObjectFactStringFieldEquals(
            row, "materialization", expected.materialization) ||
        !JsonObjectFactStringFieldEquals(
            row, "call_shape", expected.call_shape) {
        return false;
    }
    return ToInt(UnwrapOption(id_opt)) > 0 &&
        ToInt(UnwrapOption(id_opt)) == CompilerRuntimeCallAbiRowId(
            domain, type_name, operation);
}

func MirResourceRuntimeRowFactReady(
    ref routines: MirProgramRoutineIndex,
    instruction_view: MirRoutineInstructionView
) -> Bool {
    if !instruction_view.valid { return false; }
    let json: String = routines.source_json;
    let inst_start: Int = instruction_view.start;
    let inst_end: Int = instruction_view.end;
    if inst_start < 0 || inst_end <= inst_start ||
        JsonCharCodeAt(json, inst_end, inst_start) != JsonAsciiCode("{") {
        return false;
    }
    let name_start: Int = 0 - 1;
    let name_end: Int = 0 - 1;
    let required_start: Int = 0 - 1;
    let required_end: Int = 0 - 1;
    let row_start: Int = 0 - 1;
    let row_end: Int = 0 - 1;
    let aux_start: Int = 0 - 1;
    let aux_end: Int = 0 - 1;
    let object_closed: Bool = false;
    let i: Int = inst_start + 1;
    while i < inst_end {
        i = JsonSkipWhitespaceWithin(json, i, inst_end);
        if i >= inst_end { return false; }
        let code: Int = JsonCharCodeAt(json, inst_end, i);
        if code == JsonAsciiCode("}") {
            if i + 1 != inst_end { return false; }
            object_closed = true;
            i = inst_end;
            continue;
        }
        if code == JsonAsciiCode(",") {
            i = i + 1;
            continue;
        }
        if code != JsonAsciiCode("\"") { return false; }
        let key_end_opt: Option<Int> = JsonStringEndWithin(
            json, i, inst_end
        );
        if !IsSome(key_end_opt) { return false; }
        let key_end: Int = UnwrapOption(key_end_opt);
        let raw_key_length: Int = key_end - i - 2;
        let key_has_escape: Bool = false;
        let key_row: Int = i + 1;
        while key_row < key_end - 1 {
            if JsonCharCodeAt(json, key_end, key_row) ==
                JsonAsciiCode("\\") {
                key_has_escape = true;
            }
            key_row = key_row + 1;
        }
        let is_name: Bool = (key_has_escape || raw_key_length == 4) &&
            JsonObjectKeyEqualsWithin(
            json, i, key_end, "name"
        );
        let is_required: Bool =
            (key_has_escape || raw_key_length == 25) &&
            JsonObjectKeyEqualsWithin(
            json, i, key_end, "runtime_call_abi_required"
        );
        let is_row: Bool = (key_has_escape || raw_key_length == 16) &&
            JsonObjectKeyEqualsWithin(
            json, i, key_end, "runtime_call_abi"
        );
        let is_aux: Bool = (key_has_escape || raw_key_length == 20) &&
            JsonObjectKeyEqualsWithin(
            json, i, key_end, "runtime_call_abi_aux"
        );
        i = JsonSkipWhitespaceWithin(json, key_end, inst_end);
        if i >= inst_end ||
            JsonCharCodeAt(json, inst_end, i) != JsonAsciiCode(":") {
            return false;
        }
        i = JsonSkipWhitespaceWithin(json, i + 1, inst_end);
        let value_end_opt: Option<Int> = JsonValueEndWithin(
            json, i, inst_end
        );
        if !IsSome(value_end_opt) { return false; }
        let value_end: Int = UnwrapOption(value_end_opt);
        if value_end <= i { return false; }
        if is_name {
            if name_start >= 0 { return false; }
            name_start = i;
            name_end = value_end;
        } else if is_required {
            if required_start >= 0 { return false; }
            required_start = i;
            required_end = value_end;
        } else if is_row {
            if row_start >= 0 { return false; }
            row_start = i;
            row_end = value_end;
        } else if is_aux {
            if aux_start >= 0 { return false; }
            aux_start = i;
            aux_end = value_end;
        }
        i = value_end;
    }
    if !object_closed { return false; }
    if (name_start < 0 || name_end < 0) &&
        (name_start != 0 - 1 || name_end != 0 - 1) {
        return false;
    }
    if (required_start < 0 || required_end < 0) &&
        (required_start != 0 - 1 || required_end != 0 - 1) {
        return false;
    }
    if (row_start < 0 || row_end < 0) &&
        (row_start != 0 - 1 || row_end != 0 - 1) {
        return false;
    }
    if (aux_start < 0 || aux_end < 0) &&
        (aux_start != 0 - 1 || aux_end != 0 - 1) {
        return false;
    }
    let operation: String = "";
    if name_start >= 0 {
        if name_start + 4 == name_end && SubEqualsWithLen(
            json, name_end, name_start, 4, "null"
        ) {
            operation = "";
        } else if JsonCharCodeAt(json, name_end, name_start) !=
            JsonAsciiCode("\"") {
            return false;
        } else {
            let decoded_end: Array<Int> = [0];
            operation = ReadJsonStringBounded(
                json, name_start, name_end, decoded_end
            );
            if decoded_end[0] != name_end { return false; }
        }
    }
    let required: Bool = required_start >= 0;
    if required && !(required_start + 4 == required_end &&
        SubEqualsWithLen(
            json, required_end, required_start, 4, "true"
        )) {
        return false;
    }
    let machine_operation: String =
        MirMachineLayerInstructionRuntimeOperationAtBounds(
            json, instruction_view.machine_layer_start,
            instruction_view.machine_layer_end);
    let expected_operation: String = operation;
    if !MirResourceRuntimeRowRequired(expected_operation) {
        expected_operation = machine_operation;
    }
    let has_row: Bool = row_start >= 0;
    if !MirResourceRuntimeRowRequired(expected_operation) {
        if has_row && row_start < row_end &&
            JsonCharCodeAt(json, row_end, row_start) ==
                JsonAsciiCode("{") {
            expected_operation = MirObjectStringFactAtBounds(
                json, row_start, row_end, "operation");
        }
    }
    let has_aux: Bool = aux_start >= 0;
    if !MirResourceRuntimeRowRequired(expected_operation) {
        return !required && !has_row && !has_aux;
    }
    if !has_row || row_start >= row_end ||
        JsonCharCodeAt(json, row_end, row_start) !=
            JsonAsciiCode("{") {
        return false;
    }
    let row: JsonObjectFactTable = JsonObjectFactTableFromBounds(
        json, row_start, row_end);
    if !JsonObjectFactTableReady(row) ||
        !JsonObjectFactStringFieldEquals(row, "owner", "MIRResource") ||
        !JsonObjectFactStringFieldEquals(
            row, "operation", expected_operation) {
        return false;
    }
    let id_opt: Option<String> = JsonObjectFactNumberFieldOpt(row, "id");
    let domain_opt: Option<String> = JsonObjectFactStringFieldOpt(
        row, "domain"
    );
    let type_opt: Option<String> = JsonObjectFactStringFieldOpt(row, "type");
    if !IsSome(id_opt) || !IsSome(domain_opt) || !IsSome(type_opt) {
        return false;
    }
    let id: Int = ToInt(UnwrapOption(id_opt));
    let domain: String = UnwrapOption(domain_opt);
    let type_name: String = UnwrapOption(type_opt);
    if id <= 0 || id != CompilerRuntimeCallAbiRowId(
        domain, type_name, expected_operation
    ) {
        return false;
    }
    let expected: CompilerRuntimeCallAbiFact =
        CompilerRuntimeCallAbiFactForNativeResource(
            type_name, expected_operation);
    if !expected.ok || domain != expected.domain ||
        !JsonObjectFactStringFieldEquals(row, "symbol", expected.symbol) ||
        !JsonObjectFactStringFieldEquals(
            row, "target_kind", expected.symbol_kind) ||
        !JsonObjectFactStringFieldEquals(
            row, "materialization", expected.materialization) ||
        !JsonObjectFactStringFieldEquals(
            row, "call_shape", expected.call_shape) {
        return false;
    }
    // The primary row is not the complete owner surface when the instruction
    // carries runtime_call_abi_aux.  Validate every auxiliary row against the
    // same MIRResource owner and canonical type; absence remains valid for an
    // instruction with no auxiliary operations.
    if has_aux {
        let aux_rows: JsonArrayObjectFactTable =
            JsonArrayObjectFactTableFromBounds(
                json, aux_start, aux_end);
        if !JsonArrayObjectFactTableReady(aux_rows) {
            return false;
        }
        let aux_index: Int = 0;
        while aux_index < JsonArrayObjectFactCount(aux_rows) {
            let aux_row: JsonObjectFactTable =
                JsonArrayObjectFactAt(aux_rows, aux_index);
            let aux_operation_opt: Option<String> =
                JsonObjectFactStringFieldOpt(aux_row, "operation");
            if !IsSome(aux_operation_opt) ||
                UnwrapOption(aux_operation_opt) == expected_operation ||
                !MirResourceRuntimeAuxRowFactReady(aux_row, type_name) {
                return false;
            }
            let prior_index: Int = 0;
            while prior_index < aux_index {
                let prior_row: JsonObjectFactTable =
                    JsonArrayObjectFactAt(aux_rows, prior_index);
                if JsonObjectFactStringFieldEquals(
                    prior_row, "operation", UnwrapOption(aux_operation_opt)) {
                    return false;
                }
                prior_index = prior_index + 1;
            }
            aux_index = aux_index + 1;
        }
    }
    return true;
}
