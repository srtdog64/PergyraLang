// MIR resource runtime-call row consumer for the self-hosted lowering lane.
// The native MIR producer owns row materialization; this owner only validates
// the carried fact before resource instructions are skipped by reconstruction.

import "json_fact_read.pgy";
import "machine_layer_fact_owner.pgy";
import "../mir/runtime_call_abi_fact_owner.pgy";
import "../compiler/runtime_call_abi_structured_fact_owner.pgy";

func MirResourceRuntimeRowRequired(operation: String) -> Bool {
    return operation == "Claim" || operation == "Read" ||
        operation == "Write" || operation == "Release" ||
        operation == "PinRead" || operation == "PinWrite" ||
        operation == "PinReadInit" || operation == "PinWriteInit" ||
        operation == "Unpin" || operation == "UnpinCleanup" ||
        operation == "SubmitRead";
}

func MirResourceRuntimeRowFactReady(
    json: String, inst_start: Int, inst_end: Int
) -> Bool {
    let operation: String = MirObjectStringFact(
        json, inst_start, inst_end, "name");
    let machine_operation: String =
        MirMachineLayerInstructionRuntimeOperation(
            json, inst_start, inst_end);
    let expected_operation: String = operation;
    if !MirResourceRuntimeRowRequired(expected_operation) {
        expected_operation = machine_operation;
    }
    if !MirResourceRuntimeRowRequired(expected_operation) {
        return true;
    }
    let instruction: JsonObjectFactTable = JsonObjectFactTableFromBounds(
        json, MirFactObjectStart(json, inst_start), inst_end);
    let row: JsonObjectFactTable = JsonObjectFactObjectTable(
        instruction, "runtime_call_abi");
    if !JsonObjectFactTableReady(row) ||
        !JsonObjectFactStringFieldEquals(row, "owner", "MIRResource") ||
        !JsonObjectFactStringFieldEquals(
            row, "operation", expected_operation) {
        return false;
    }
    let id_opt: Option<String> = JsonObjectFactNumberFieldOpt(row, "id");
    let domain_opt: Option<String> = JsonObjectFactStringFieldOpt(
        row, "domain"
    );
    let type_opt: Option<String> = JsonObjectFactStringFieldOpt(row, "type");
    if !IsSome(id_opt) || !IsSome(domain_opt) || !IsSome(type_opt) {
        return false;
    }
    let id: Int = ToInt(UnwrapOption(id_opt));
    let domain: String = UnwrapOption(domain_opt);
    let type_name: String = UnwrapOption(type_opt);
    if id <= 0 || id != CompilerRuntimeCallAbiRowId(
        domain, type_name, expected_operation
    ) {
        return false;
    }
    let expected: CompilerRuntimeCallAbiFact =
        CompilerRuntimeCallAbiFactForNativeResource(
            type_name, expected_operation);
    if !expected.ok || domain != expected.domain ||
        !JsonObjectFactStringFieldEquals(row, "symbol", expected.symbol) ||
        !JsonObjectFactStringFieldEquals(
            row, "target_kind", expected.symbol_kind) ||
        !JsonObjectFactStringFieldEquals(
            row, "materialization", expected.materialization) ||
        !JsonObjectFactStringFieldEquals(
            row, "call_shape", expected.call_shape) {
        return false;
    }
    return true;
}
