// Routine-local CFG projection queries used by structured MIR reconstruction.
//
// Successor, block identity, loop header, and loop-exit classification stay
// behind the admitted routine fact index. This owner does not rescan program
// roots or infer a replacement CFG from source text.

import "routine_fact_index_owner.pgy";

func RoutineCfgBlockRow(
    ref index: MirRoutineFactIndex, id: String
) -> Int {
    let row: Int = ToInt(id);
    if StringLength(id) == 0 || ToString(row) != id || row < 0 ||
        row >= ArrayLength(index.block_starts) {
        return 0 - 1;
    }
    return row;
}

func ReadSucc(
    ref index: MirRoutineFactIndex, id: String, false_edge: Bool
) -> String {
    let row: Int = RoutineCfgBlockRow(index, id);
    if row < 0 { return ""; }
    return MirRoutineFactIndexBlockSuccessor(index, row, false_edge);
}

func LoopHeaderLine(cond: String) -> String {
    if StringLength(cond) >= 4 && Substring(cond, 0, 4) == "for " {
        return Concat("For: ", Substring(cond, 4, StringLength(cond) - 4));
    }
    return Concat("While: ", cond);
}

func IsLoopAbrupt(
    id: String, loop_header: String, loop_exit: String
) -> Bool {
    if StringLength(id) == 0 { return false; }
    if StringLength(loop_header) > 0 && id == loop_header { return true; }
    return StringLength(loop_exit) > 0 && id == loop_exit;
}

func BlockHasIncomingBackedge(
    ref index: MirRoutineFactIndex, want: String
) -> Bool {
    let row: Int = RoutineCfgBlockRow(index, want);
    return row >= 0 && MirRoutineFactIndexHasIncomingBackedge(index, row);
}

// A pruned constant-true loop carries no condition-exit edge, but its
// terminal break branches still name the loop exit. The smallest break
// target past the header is this loop's exit, so sequential pruned loops
// each bind their own; nested pruned constant-true loops stay outside
// this bounded consumer (the parity gates judge that shape).
func RoutineCfgPrunedConstantTrueBreakExit(
    ref index: MirRoutineFactIndex,
    ref routines: MirProgramRoutineIndex,
    routine_row: Int,
    header_row: Int
) -> String {
    let exit_row: Int = 0 - 1;
    let block_row: Int = header_row + 1;
    while block_row < ArrayLength(index.block_starts) {
        let selection: MirRoutineInstructionSelection =
            MirRoutineFactIndexBranchAtBlock(
                index, routines, routine_row, block_row
            );
        if selection.valid && selection.found &&
            selection.instruction.source_type == "AST_BREAK" {
            let target_row: Int = RoutineCfgBlockRow(
                index, MirRoutineFactIndexBlockSuccessor(
                    index, block_row, false
                )
            );
            if target_row > header_row &&
                (exit_row < 0 || target_row < exit_row) {
                exit_row = target_row;
            }
        }
        block_row = block_row + 1;
    }
    if exit_row < 0 { return ""; }
    return ToString(exit_row);
}
