// Stable per-routine MIR JSON span index.
//
// The MIR document String remains owned by the caller. This fact carries only
// integer spans and decoded source-local rows, so recursive CFG reconstruction
// does not rediscover array rows from the beginning of the JSON document.
import "json_fact_read.pgy";
import "program_routine_index_owner.pgy";
import "loop_flow_fact_owner.pgy";
import "iteration_type_fact_owner.pgy";
import "match_binding_local_fact_owner.pgy";
import "mir_cfg_graph_owner.pgy";
import "resource_flow_fact_owner.pgy";
struct MirRoutineFactIndex {
    let valid: Bool;
    let validation_stage: String;
    let loop_flow_facts_valid: Bool;
    let routine_start: Int;
    let routine_end: Int;
    let block_starts: Array<Int>;
    let block_ends: Array<Int>;
    let backedge_headers: Array<Int>;
    let block_succ_true: Array<Int>;
    let block_succ_false: Array<Int>;
    let block_has_conditional_branch: Array<Int>;
    let block_structural_merges: Array<Int>;
    let block_instruction_starts: Array<Int>;
    let block_instruction_counts: Array<Int>;
    let instruction_starts: Array<Int>;
    let instruction_ends: Array<Int>;
    let instruction_results: Array<String>;
    let source_local_names: Array<String>;
    let source_local_types: Array<String>;
    let source_syntax_id: String;
    let iteration_type_facts: MirIterationTypeFacts;
    let function_param_flow_parameter_indices: Array<Int>;
    let function_param_flow_masks: Array<Int>;
    let resource_flow_symbol_declared_count: String;
    let resource_flow_stable_indices: Array<Int>;
    let resource_flow_declaration_syntax_ids: Array<Int>;
    let resource_flow_symbol_kinds: Array<Int>;
    let resource_flow_parameter_flags: Array<Int>;
    let resource_flow_parameter_indices: Array<Int>;
    let resource_flow_names: Array<String>;
    let loop_flow_summary_declared_count: String;
    let loop_flow_summary_loop_ids: Array<Int>;
    let loop_flow_summary_kinds: Array<Int>;
    let loop_flow_summary_effect_bases: Array<Int>;
    let loop_flow_summary_effect_deltas: Array<Int>;
    let loop_flow_summary_flags: Array<Int>;
    let loop_flow_summary_entry_starts: Array<Int>;
    let loop_flow_summary_entry_counts: Array<Int>;
    let loop_flow_summary_exit_starts: Array<Int>;
    let loop_flow_summary_exit_counts: Array<Int>;
    let loop_flow_state_declared_count: String;
    let loop_flow_state_stable_indices: Array<Int>;
    let loop_flow_state_consumed_flags: Array<Int>;
    let loop_flow_state_used_flags: Array<Int>;
    let loop_flow_state_access_masks: Array<Int>;
    let loop_flow_state_slot_states: Array<Int>;
    let loop_flow_state_semantic_states: Array<Int>;
    let loop_flow_state_pool_ids: Array<Int>;
}
func BuildMirRoutineFactIndex(ref routines: MirProgramRoutineIndex, routine_row: Int) -> MirRoutineFactIndex {
    let json: String = routines.source_json;
    let routine_start: Int = 0;
    let routine_end: Int = 0;
    let routine_row_ready: Bool = MirProgramRoutineIndexRowReady(routines, routine_row);
    if routine_row_ready { routine_start = routines.starts[routine_row]; routine_end = routines.ends[routine_row]; }
    let block_starts: Array<Int> = [];
    let block_ends: Array<Int> = [];
    let backedge_headers: Array<Int> = [];
    let block_succ_true: Array<Int> = [];
    let block_succ_false: Array<Int> = [];
    let block_has_conditional_branch: Array<Int> = [];
    let block_structural_merges: Array<Int> = [];
    let block_instruction_starts: Array<Int> = [];
    let block_instruction_counts: Array<Int> = [];
    let instruction_starts: Array<Int> = [];
    let instruction_ends: Array<Int> = [];
    let instruction_results: Array<String> = [];
    let source_local_names: Array<String> = [];
    let source_local_types: Array<String> = [];
    let source_syntax_id: String = MirObjectNumberFactAtBounds(
        json, routine_start, routine_end, "source_syntax_id");
    let iteration_type_facts: MirIterationTypeFacts = BuildMirIterationTypeFacts(
        json, routine_start, routine_end, source_syntax_id);
    let function_param_flow_summary_count: String = MirObjectNumberFactAtBounds(
        json, routine_start, routine_end, "function_param_flow_summary_count");
    let function_param_flow_parameter_indices: Array<Int> = [];
    let function_param_flow_masks: Array<Int> = [];
    let resource_flow_symbol_declared_count: String = MirObjectNumberFactAtBounds(
        json, routine_start, routine_end, "resource_flow_symbol_count");
    let valid: Bool = routine_row_ready;
    let validation_stage: String = "ok";
    if !routine_row_ready { validation_stage = "program_structure"; }
    let resource_facts: MirResourceFlowFacts = BuildMirResourceFlowFacts(
        json, routine_start, routine_end);
    if !iteration_type_facts.valid { valid = false; validation_stage = "iteration_type_facts"; }
    let resource_flow_stable_indices: Array<Int> =
        resource_facts.stable_indices;
    let resource_flow_declaration_syntax_ids: Array<Int> =
        resource_facts.declaration_syntax_ids;
    let resource_flow_symbol_kinds: Array<Int> = resource_facts.symbol_kinds;
    let resource_flow_parameter_flags: Array<Int> = resource_facts.parameter_flags;
    let resource_flow_parameter_indices: Array<Int> =
        resource_facts.parameter_indices;
    let resource_flow_names: Array<String> = resource_facts.names;
    if !resource_facts.valid {
        valid = false;
        validation_stage = "resource_flow";
    }
    let loop_facts: MirLoopFlowFacts = BuildMirLoopFlowFacts(
        json, routine_start, routine_end);
    let loop_flow_summary_declared_count: String =
        loop_facts.summary_declared_count;
    let loop_flow_summary_loop_ids: Array<Int> = loop_facts.summary_loop_ids;
    let loop_flow_summary_kinds: Array<Int> = loop_facts.summary_kinds;
    let loop_flow_summary_effect_bases: Array<Int> =
        loop_facts.summary_effect_bases;
    let loop_flow_summary_effect_deltas: Array<Int> =
        loop_facts.summary_effect_deltas;
    let loop_flow_summary_flags: Array<Int> = loop_facts.summary_flags;
    let loop_flow_summary_entry_starts: Array<Int> =
        loop_facts.summary_entry_starts;
    let loop_flow_summary_entry_counts: Array<Int> =
        loop_facts.summary_entry_counts;
    let loop_flow_summary_exit_starts: Array<Int> =
        loop_facts.summary_exit_starts;
    let loop_flow_summary_exit_counts: Array<Int> =
        loop_facts.summary_exit_counts;
    let loop_flow_state_declared_count: String = loop_facts.state_declared_count;
    let loop_flow_state_stable_indices: Array<Int> =
        loop_facts.state_stable_indices;
    let loop_flow_state_consumed_flags: Array<Int> =
        loop_facts.state_consumed_flags;
    let loop_flow_state_used_flags: Array<Int> = loop_facts.state_used_flags;
    let loop_flow_state_access_masks: Array<Int> = loop_facts.state_access_masks;
    let loop_flow_state_slot_states: Array<Int> = loop_facts.state_slot_states;
    let loop_flow_state_semantic_states: Array<Int> =
        loop_facts.state_semantic_states;
    let loop_flow_state_pool_ids: Array<Int> = loop_facts.state_pool_ids;
    let loop_flow_facts_valid: Bool = loop_facts.valid;
    let flow_bounds: Array<Int> = [0, 0];
    if MirObjectArrayBoundsAtBounds(
        json, routine_start, routine_end,
        "function_param_flow_summaries", flow_bounds) {
        let flow_cursor: Int = flow_bounds[0] + 1;
        let flow_row_bounds: Array<Int> = [0, 0];
        while JsonArrayNextObjectBounds(
            json, flow_cursor, flow_bounds[1], flow_row_bounds) {
            let parameter_index: String = MirObjectNumberFactAtBounds(
                json, flow_row_bounds[0], flow_row_bounds[1], "parameter_index");
            let mask: String = MirObjectNumberFactAtBounds(
                json, flow_row_bounds[0], flow_row_bounds[1], "mask");
            if StringLength(parameter_index) == 0 || StringLength(mask) == 0 {
                valid = false;
            } else {
                ArrayPush(function_param_flow_parameter_indices, ToInt(parameter_index));
                ArrayPush(function_param_flow_masks, ToInt(mask));
            }
            flow_cursor = flow_row_bounds[1];
        }
    }
    if StringLength(function_param_flow_summary_count) > 0 &&
        ToInt(function_param_flow_summary_count) !=
            ArrayLength(function_param_flow_parameter_indices) {
        valid = false;
        validation_stage = "function_param_count";
    }
    let global_block_start: Int = 0;
    let routine_block_count: Int = 0;
    if routine_row_ready { global_block_start = routines.routine_block_starts[routine_row]; routine_block_count = routines.routine_block_counts[routine_row]; }
    if !routine_row_ready ||
        global_block_start < 0 || routine_block_count < 0 ||
        global_block_start + routine_block_count > ArrayLength(routines.block_starts) {
        valid = false;
        validation_stage = "program_structure";
    } else {
        let block_offset: Int = 0;
        while block_offset < routine_block_count {
            let global_block: Int = global_block_start + block_offset;
            let block_start: Int = routines.block_starts[global_block];
            let block_end: Int = routines.block_ends[global_block];
            ArrayPush(block_starts, block_start);
            ArrayPush(block_ends, block_end);
            ArrayPush(backedge_headers, 0);
            let true_successor_fact: String = MirObjectNumberFactAtBounds(json, block_start, block_end, "succ_true");
            let true_successor: Int = 0 - 1;
            if StringLength(true_successor_fact) > 0 { true_successor = ToInt(true_successor_fact); if true_successor < 0 { valid = false; validation_stage = "cfg_successor"; } }
            ArrayPush(block_succ_true, true_successor);
            let false_successor_fact: String = MirObjectNumberFactAtBounds(json, block_start, block_end, "succ_false");
            let false_successor: Int = 0 - 1;
            if StringLength(false_successor_fact) > 0 { false_successor = ToInt(false_successor_fact); if false_successor < 0 { valid = false; validation_stage = "cfg_successor"; } }
            ArrayPush(block_succ_false, false_successor);
            ArrayPush(block_instruction_starts, ArrayLength(instruction_starts));
            let instruction_count: Int = routines.block_instruction_counts[global_block];
            let global_instruction_start: Int = routines.block_instruction_starts[global_block];
            let has_conditional_branch: Int = 0;
            if global_instruction_start < 0 || instruction_count < 0 ||
                global_instruction_start + instruction_count > ArrayLength(routines.instruction_starts) {
                valid = false;
                validation_stage = "program_structure";
            } else {
                let instruction_offset: Int = 0;
                while instruction_offset < instruction_count {
                    let global_instruction: Int = global_instruction_start + instruction_offset;
                    let instruction_start: Int = routines.instruction_starts[global_instruction];
                    let instruction_end: Int = routines.instruction_ends[global_instruction];
                    ArrayPush(instruction_starts, instruction_start);
                    ArrayPush(instruction_ends, instruction_end);
                    ArrayPush(
                        instruction_results,
                        MirObjectStringFactAtBounds(
                            json, instruction_start, instruction_end, "result"
                        )
                    );
                    if routines.instruction_kinds[global_instruction] ==
                        "branch" {
                        let source_type: String = routines.instruction_source_types[global_instruction];
                        if source_type != "AST_CONTINUE" && source_type != "AST_BREAK" {
                            has_conditional_branch = 1;
                        }
                    }
                    instruction_offset = instruction_offset + 1;
                }
            }
            ArrayPush(block_instruction_counts, instruction_count);
            ArrayPush(block_has_conditional_branch, has_conditional_branch);
            block_offset = block_offset + 1;
        }
    }
    // Successor rows are owner facts, not optional hints.  Reject an out of
    // range target before any graph query so malformed input cannot turn a
    // negative index into a fabricated loop/backedge fact.
    let successor_block_count: Int = ArrayLength(block_starts);
    let successor_row: Int = 0;
    while successor_row < successor_block_count {
        let true_target: Int = block_succ_true[successor_row];
        if true_target >= successor_block_count {
            valid = false;
            validation_stage = "cfg_successor";
        }
        let false_target: Int = block_succ_false[successor_row];
        if false_target >= successor_block_count {
            valid = false;
            validation_stage = "cfg_successor";
        }
        successor_row = successor_row + 1;
    }

    // A numerically backward edge is not necessarily a CFG backedge: an
    // if/else arm can legitimately flow to an earlier merge block.  Mark an
    // edge as a loop backedge only when the target can actually reach the
    // source, i.e. the edge closes a cycle in the owner-directed CFG.
    let block_row: Int = 0;
    while block_row < ArrayLength(block_starts) {
        let true_succ: Int = block_succ_true[block_row];
        if true_succ >= 0 {
            let target: Int = true_succ;
            if target < ArrayLength(backedge_headers) &&
                MirRoutineEdgeTargetsDominator(
                    block_succ_true, block_succ_false, block_row, target) {
                ArraySet(backedge_headers, target, 1);
            }
        }
        let false_succ: Int = block_succ_false[block_row];
        if false_succ >= 0 {
            let target: Int = false_succ;
            if target < ArrayLength(backedge_headers) &&
                MirRoutineEdgeTargetsDominator(
                    block_succ_true, block_succ_false, block_row, target) {
                ArraySet(backedge_headers, target, 1);
            }
        }
        block_row = block_row + 1;
    }

    let block_count: Int = ArrayLength(block_starts);
    let block: Int = 0;
    while block < block_count {
        let merge: Int = 0 - 1;
        let true_id: Int = 0 - 1;
        if block_succ_true[block] >= 0 { true_id = block_succ_true[block]; }
        let false_id: Int = 0 - 1;
        if block_succ_false[block] >= 0 { false_id = block_succ_false[block]; }
        if true_id >= 0 && false_id >= 0 {
            merge = MirRoutineGraphStructuralMerge(
                block_succ_true, block_succ_false, block,
                true_id, false_id
            );
        }
        ArrayPush(block_structural_merges, merge);
        block = block + 1;
    }

    let locals_bounds: Array<Int> = [0, 0];
    if MirObjectArrayBoundsAtBounds(json, routine_start, routine_end, "source_locals", locals_bounds) {
        let local_cursor: Int = locals_bounds[0] + 1;
        let local_bounds: Array<Int> = [0, 0];
        while JsonArrayNextObjectBounds(json, local_cursor, locals_bounds[1], local_bounds) {
            ArrayPush(source_local_names,
                MirObjectStringFactAtBounds(json, local_bounds[0], local_bounds[1], "name"));
            ArrayPush(source_local_types,
                MirObjectStringFactAtBounds(json, local_bounds[0], local_bounds[1], "type"));
            local_cursor = local_bounds[1];
        }
    }

    let match_locals: MirMatchBindingLocalFacts = BuildMirMatchBindingLocalFacts(json, instruction_starts, instruction_ends, source_local_names, source_local_types);
    source_local_names = match_locals.names;
    source_local_types = match_locals.types;
    if !match_locals.valid { valid = false; validation_stage = match_locals.validation_stage; }

    return MirRoutineFactIndex(valid, validation_stage, loop_flow_facts_valid,
        routine_start, routine_end,
        block_starts, block_ends, backedge_headers, block_succ_true,
        block_succ_false, block_has_conditional_branch, block_structural_merges,
        block_instruction_starts,
        block_instruction_counts, instruction_starts, instruction_ends, instruction_results,
        source_local_names, source_local_types, source_syntax_id, iteration_type_facts,
        function_param_flow_parameter_indices, function_param_flow_masks,
        resource_flow_symbol_declared_count, resource_flow_stable_indices,
        resource_flow_declaration_syntax_ids, resource_flow_symbol_kinds,
        resource_flow_parameter_flags, resource_flow_parameter_indices,
        resource_flow_names,
        loop_flow_summary_declared_count, loop_flow_summary_loop_ids,
        loop_flow_summary_kinds, loop_flow_summary_effect_bases,
        loop_flow_summary_effect_deltas, loop_flow_summary_flags,
        loop_flow_summary_entry_starts, loop_flow_summary_entry_counts,
        loop_flow_summary_exit_starts, loop_flow_summary_exit_counts,
        loop_flow_state_declared_count, loop_flow_state_stable_indices,
        loop_flow_state_consumed_flags, loop_flow_state_used_flags,
        loop_flow_state_access_masks, loop_flow_state_slot_states,
        loop_flow_state_semantic_states, loop_flow_state_pool_ids);
}

func MirRoutineFactIndexResourceFlowFactsValid(
    ref index: MirRoutineFactIndex
) -> Bool {
    if !index.valid || StringLength(index.resource_flow_symbol_declared_count) == 0 {
        return false;
    }
    let count: Int = ArrayLength(index.resource_flow_stable_indices);
    if ToInt(index.resource_flow_symbol_declared_count) != count ||
        count != ArrayLength(index.resource_flow_declaration_syntax_ids) ||
        count != ArrayLength(index.resource_flow_symbol_kinds) ||
        count != ArrayLength(index.resource_flow_parameter_flags) ||
        count != ArrayLength(index.resource_flow_parameter_indices) ||
        count != ArrayLength(index.resource_flow_names) {
        return false;
    }
    let row: Int = 0;
    while row < count {
        if index.resource_flow_stable_indices[row] < 0 ||
            index.resource_flow_declaration_syntax_ids[row] < 0 ||
            index.resource_flow_symbol_kinds[row] < 0 ||
            (index.resource_flow_parameter_flags[row] != 0 &&
                index.resource_flow_parameter_flags[row] != 1) ||
            index.resource_flow_parameter_indices[row] < 0 ||
            StringLength(index.resource_flow_names[row]) == 0 {
            return false;
        }
        let prior: Int = 0;
        while prior < row {
            if index.resource_flow_stable_indices[prior] ==
                index.resource_flow_stable_indices[row] {
                return false;
            }
            prior = prior + 1;
        }
        row = row + 1;
    }
    return true;
}

func MirRoutineFactIndexResourceFlowIndexKnown(ref index: MirRoutineFactIndex, stable_index: Int) -> Bool {
    let row: Int = 0;
    while row < ArrayLength(index.resource_flow_stable_indices) {
        if index.resource_flow_stable_indices[row] == stable_index {
            return true;
        }
        row = row + 1;
    }
    return false;
}

func MirRoutineFactIndexLoopFlowFactsValid(
    ref index: MirRoutineFactIndex
) -> Bool {
    if !index.valid || !index.loop_flow_facts_valid ||
        StringLength(index.loop_flow_summary_declared_count) == 0 ||
        StringLength(index.loop_flow_state_declared_count) == 0 {
        return false;
    }
    let summary_count: Int = ArrayLength(index.loop_flow_summary_loop_ids);
    let state_count: Int = ArrayLength(index.loop_flow_state_stable_indices);
    if ToInt(index.loop_flow_summary_declared_count) != summary_count ||
        ToInt(index.loop_flow_state_declared_count) != state_count ||
        summary_count != ArrayLength(index.loop_flow_summary_kinds) ||
        summary_count != ArrayLength(index.loop_flow_summary_effect_bases) ||
        summary_count != ArrayLength(index.loop_flow_summary_effect_deltas) ||
        summary_count != ArrayLength(index.loop_flow_summary_flags) ||
        summary_count != ArrayLength(index.loop_flow_summary_entry_starts) ||
        summary_count != ArrayLength(index.loop_flow_summary_entry_counts) ||
        summary_count != ArrayLength(index.loop_flow_summary_exit_starts) ||
        summary_count != ArrayLength(index.loop_flow_summary_exit_counts) ||
        state_count != ArrayLength(index.loop_flow_state_consumed_flags) ||
        state_count != ArrayLength(index.loop_flow_state_used_flags) ||
        state_count != ArrayLength(index.loop_flow_state_access_masks) ||
        state_count != ArrayLength(index.loop_flow_state_slot_states) ||
        state_count != ArrayLength(index.loop_flow_state_semantic_states) ||
        state_count != ArrayLength(index.loop_flow_state_pool_ids) {
        return false;
    }
    let row: Int = 0;
    while row < summary_count {
        if index.loop_flow_summary_loop_ids[row] <= 0 ||
            (index.loop_flow_summary_kinds[row] != 0 &&
                index.loop_flow_summary_kinds[row] != 1) ||
            index.loop_flow_summary_effect_bases[row] < 0 ||
            index.loop_flow_summary_effect_deltas[row] < 0 ||
            index.loop_flow_summary_flags[row] < 0 ||
            index.loop_flow_summary_entry_starts[row] < 0 ||
            index.loop_flow_summary_entry_counts[row] < 0 ||
            index.loop_flow_summary_exit_starts[row] < 0 ||
            index.loop_flow_summary_exit_counts[row] < 0 ||
            index.loop_flow_summary_entry_starts[row] > state_count ||
            index.loop_flow_summary_entry_counts[row] >
                state_count - index.loop_flow_summary_entry_starts[row] ||
            index.loop_flow_summary_exit_starts[row] > state_count ||
            index.loop_flow_summary_exit_counts[row] >
                state_count - index.loop_flow_summary_exit_starts[row] {
            return false;
        }
        let prior: Int = 0;
        while prior < row {
            if index.loop_flow_summary_loop_ids[prior] ==
                index.loop_flow_summary_loop_ids[row] {
                return false;
            }
            prior = prior + 1;
        }
        row = row + 1;
    }
    row = 0;
    while row < state_count {
        if index.loop_flow_state_stable_indices[row] < 0 ||
            !MirRoutineFactIndexResourceFlowIndexKnown(
                index, index.loop_flow_state_stable_indices[row]) ||
            (index.loop_flow_state_consumed_flags[row] != 0 &&
                index.loop_flow_state_consumed_flags[row] != 1) ||
            (index.loop_flow_state_used_flags[row] != 0 &&
                index.loop_flow_state_used_flags[row] != 1) ||
            index.loop_flow_state_access_masks[row] < 0 ||
            index.loop_flow_state_slot_states[row] < 0 ||
            index.loop_flow_state_semantic_states[row] < 0 {
            return false;
        }
        row = row + 1;
    }
    return true;
}

func MirRoutineFactIndexFunctionParamFlowFactsValid(
    ref index: MirRoutineFactIndex
) -> Bool {
    if !index.valid {
        return false;
    }
    let count: Int = ArrayLength(index.function_param_flow_parameter_indices);
    if count == 0 {
        return true;
    }
    if StringLength(index.source_syntax_id) == 0 || ToInt(index.source_syntax_id) <= 0 {
        return false;
    }
    if count != ArrayLength(index.function_param_flow_masks) {
        return false;
    }
    let row: Int = 0;
    while row < count {
        if index.function_param_flow_parameter_indices[row] < 0 ||
            index.function_param_flow_masks[row] < 0 {
            return false;
        }
        let prior: Int = 0;
        while prior < row {
            if index.function_param_flow_parameter_indices[prior] ==
                index.function_param_flow_parameter_indices[row] {
                return false;
            }
            prior = prior + 1;
        }
        row = row + 1;
    }
    return true;
}

func MirRoutineFactIndexHasIncomingBackedge(ref index: MirRoutineFactIndex, block_id: Int) -> Bool {
    return block_id >= 0 && block_id < ArrayLength(index.backedge_headers) &&
        index.backedge_headers[block_id] == 1;
}

func MirRoutineFactIndexBlockSuccessor(
    ref index: MirRoutineFactIndex,
    block_id: Int,
    false_edge: Bool
) -> String {
    if block_id < 0 || block_id >= ArrayLength(index.block_succ_true) ||
        block_id >= ArrayLength(index.block_succ_false) {
        return "";
    }
    if false_edge {
        if index.block_succ_false[block_id] < 0 { return ""; }
        return ToString(index.block_succ_false[block_id]);
    }
    if index.block_succ_true[block_id] < 0 { return ""; }
    return ToString(index.block_succ_true[block_id]);
}

func MirRoutineFactIndexBlockHasConditionalBranch(
    ref index: MirRoutineFactIndex,
    block_start: Int
) -> Bool {
    let block_row: Int = MirRoutineFactIndexBlockRow(index, block_start);
    return block_row >= 0 && index.block_has_conditional_branch[block_row] == 1;
}

func MirRoutineFactIndexBlockStructuralMerge(
    ref index: MirRoutineFactIndex,
    block_id: Int
) -> String {
    if block_id < 0 || block_id >= ArrayLength(index.block_structural_merges) {
        return "";
    }
    let merge: Int = index.block_structural_merges[block_id];
    if merge < 0 {
        return "";
    }
    return ToString(merge);
}

func MirRoutineFactIndexBlockIsTerminal(
    ref index: MirRoutineFactIndex,
    block_id: Int
) -> Bool {
    if block_id < 0 || block_id >= ArrayLength(index.block_succ_true) {
        return false;
    }
    return index.block_succ_true[block_id] < 0 &&
        index.block_succ_false[block_id] < 0;
}

func MirRoutineFactIndexBlockBounds(ref index: MirRoutineFactIndex, block_id: Int, inout bounds: Array<Int>) -> Bool {
    if !index.valid || block_id < 0 || block_id >= ArrayLength(index.block_starts) { return false; }
    ArraySet(bounds, 0, index.block_starts[block_id]);
    ArraySet(bounds, 1, index.block_ends[block_id]);
    return true;
}

func MirRoutineFactIndexBlockRow(ref index: MirRoutineFactIndex, block_start: Int) -> Int {
    let row: Int = 0;
    while row < ArrayLength(index.block_starts) {
        if index.block_starts[row] == block_start { return row; }
        row = row + 1;
    }
    return 0 - 1;
}

func MirRoutineFactIndexInstructionBounds(ref index: MirRoutineFactIndex, block_start: Int, instruction_row: Int, inout bounds: Array<Int>) -> Bool {
    let block_row: Int = MirRoutineFactIndexBlockRow(index, block_start);
    if block_row < 0 || instruction_row < 0 ||
        instruction_row >= index.block_instruction_counts[block_row] { return false; }
    let row: Int = index.block_instruction_starts[block_row] + instruction_row;
    ArraySet(bounds, 0, index.instruction_starts[row]);
    ArraySet(bounds, 1, index.instruction_ends[row]);
    return true;
}

func MirRoutineFactIndexResultExists(ref index: MirRoutineFactIndex, wanted: String) -> Bool {
    if !index.valid || wanted == "" { return false; }
    if ArrayLength(index.instruction_results) != ArrayLength(index.instruction_starts) { return false; }
    let row: Int = 0;
    while row < ArrayLength(index.instruction_results) {
        if index.instruction_results[row] == wanted { return true; }
        row = row + 1;
    }
    return false;
}

func MirRoutineFactIndexSourceLocalType(ref index: MirRoutineFactIndex, name: String) -> String {
    let row: Int = 0;
    while row < ArrayLength(index.source_local_names) {
        if index.source_local_names[row] == name { return index.source_local_types[row]; }
        row = row + 1;
    }
    return "";
}
