// Routine-local scalar instruction facts captured once from program-owned
// instruction spans.
//
// Global structure/identity remains in MirProgramRoutineIndex. This bundle
// keeps render-local values at routine lifetime and prevents consumers from
// rescanning one instruction object independently for each field.

import "program_routine_index_owner.pgy";

struct MirRoutineInstructionScalarCapture {
    let valid: Bool;
    let result: String;
    let expr0: String;
    let expr1: String;
    let arg0: String;
    let arg1: String;
    let slot_anchor: String;
    let abi_type_name: String;
    let match_variant: String;
}

func InvalidMirRoutineInstructionScalarCapture(
) -> MirRoutineInstructionScalarCapture {
    return MirRoutineInstructionScalarCapture(
        false, "", "", "", "", "", "", "", ""
    );
}

func MirRoutineInstructionScalarCaptureWithin(
    json: String, start: Int, end: Int
) -> MirRoutineInstructionScalarCapture {
    if start < 0 || end <= start ||
        JsonCharCodeAt(json, end, start) != JsonAsciiCode("{") {
        return InvalidMirRoutineInstructionScalarCapture();
    }
    let result: String = "";
    let expr0: String = "";
    let expr1: String = "";
    let arg0: String = "";
    let arg1: String = "";
    let slot_anchor: String = "";
    let abi_type_name: String = "";
    let match_variant: String = "";
    let result_seen: Bool = false;
    let expr0_seen: Bool = false;
    let expr1_seen: Bool = false;
    let arg0_seen: Bool = false;
    let arg1_seen: Bool = false;
    let slot_anchor_seen: Bool = false;
    let abi_type_name_seen: Bool = false;
    let match_variant_seen: Bool = false;
    let i: Int = start + 1;
    while i < end {
        i = JsonSkipWhitespaceWithin(json, i, end);
        if i >= end { return InvalidMirRoutineInstructionScalarCapture(); }
        let c: Int = JsonCharCodeAt(json, end, i);
        if c == JsonAsciiCode("}") {
            return MirRoutineInstructionScalarCapture(
                true, result, expr0, expr1, arg0, arg1, slot_anchor,
                abi_type_name, match_variant
            );
        }
        if c == JsonAsciiCode(",") {
            i = i + 1;
            continue;
        }
        if c != JsonAsciiCode("\"") {
            return InvalidMirRoutineInstructionScalarCapture();
        }
        let key_end_opt: Option<Int> = JsonStringEndWithin(json, i, end);
        if !IsSome(key_end_opt) {
            return InvalidMirRoutineInstructionScalarCapture();
        }
        let key_end: Int = UnwrapOption(key_end_opt);
        let is_result: Bool =
            JsonObjectKeyEqualsWithin(json, i, key_end, "result");
        let is_expr0: Bool =
            JsonObjectKeyEqualsWithin(json, i, key_end, "expr0");
        let is_expr1: Bool =
            JsonObjectKeyEqualsWithin(json, i, key_end, "expr1");
        let is_arg0: Bool =
            JsonObjectKeyEqualsWithin(json, i, key_end, "arg0");
        let is_arg1: Bool =
            JsonObjectKeyEqualsWithin(json, i, key_end, "arg1");
        let is_slot_anchor: Bool =
            JsonObjectKeyEqualsWithin(json, i, key_end, "slot_anchor");
        let is_abi_type_name: Bool =
            JsonObjectKeyEqualsWithin(json, i, key_end, "abi_type_name");
        let is_match_variant: Bool =
            JsonObjectKeyEqualsWithin(json, i, key_end, "match_variant");
        i = JsonSkipWhitespaceWithin(json, key_end, end);
        if i >= end || JsonCharCodeAt(json, end, i) != JsonAsciiCode(":") {
            return InvalidMirRoutineInstructionScalarCapture();
        }
        i = JsonSkipWhitespaceWithin(json, i + 1, end);
        let value_end_opt: Option<Int> = JsonValueEndWithin(json, i, end);
        if !IsSome(value_end_opt) {
            return InvalidMirRoutineInstructionScalarCapture();
        }
        let value_end: Int = UnwrapOption(value_end_opt);
        let selected: Bool = is_result || is_expr0 || is_expr1 || is_arg0 ||
            is_arg1 || is_slot_anchor || is_abi_type_name || is_match_variant;
        if selected {
            if (is_result && result_seen) || (is_expr0 && expr0_seen) ||
                (is_expr1 && expr1_seen) || (is_arg0 && arg0_seen) ||
                (is_arg1 && arg1_seen) ||
                (is_slot_anchor && slot_anchor_seen) ||
                (is_abi_type_name && abi_type_name_seen) ||
                (is_match_variant && match_variant_seen) {
                return InvalidMirRoutineInstructionScalarCapture();
            }
            let value: String = "";
            if JsonCharCodeAt(json, value_end, i) == JsonAsciiCode("\"") {
                let decoded_end: Array<Int> = [0];
                value = ReadJsonStringBounded(
                    json, i, value_end, decoded_end
                );
                if decoded_end[0] != value_end {
                    return InvalidMirRoutineInstructionScalarCapture();
                }
            } else if !(i + 4 == value_end &&
                SubEqualsWithLen(json, value_end, i, 4, "null")) {
                return InvalidMirRoutineInstructionScalarCapture();
            }
            if is_result { result = value; result_seen = true; }
            if is_expr0 { expr0 = value; expr0_seen = true; }
            if is_expr1 { expr1 = value; expr1_seen = true; }
            if is_arg0 { arg0 = value; arg0_seen = true; }
            if is_arg1 { arg1 = value; arg1_seen = true; }
            if is_slot_anchor {
                slot_anchor = value; slot_anchor_seen = true;
            }
            if is_abi_type_name {
                abi_type_name = value; abi_type_name_seen = true;
            }
            if is_match_variant {
                match_variant = value; match_variant_seen = true;
            }
        }
        i = value_end;
    }
    return InvalidMirRoutineInstructionScalarCapture();
}

struct MirRoutineInstructionFactBundle {
    let valid: Bool;
    let global_start: Int;
    let starts: Array<Int>;
    let ends: Array<Int>;
    let results: Array<String>;
    let expr0s: Array<String>;
    let expr1s: Array<String>;
    let arg0s: Array<String>;
    let arg1s: Array<String>;
    let slot_anchors: Array<String>;
    let abi_type_names: Array<String>;
    let match_variants: Array<String>;
    let block_has_conditional_branch: Array<Int>;
}

func BuildMirRoutineInstructionFactBundle(
    ref routines: MirProgramRoutineIndex,
    routine_row: Int
) -> MirRoutineInstructionFactBundle {
    let starts: Array<Int> = [];
    let ends: Array<Int> = [];
    let results: Array<String> = [];
    let expr0s: Array<String> = [];
    let expr1s: Array<String> = [];
    let arg0s: Array<String> = [];
    let arg1s: Array<String> = [];
    let slot_anchors: Array<String> = [];
    let abi_type_names: Array<String> = [];
    let match_variants: Array<String> = [];
    let block_has_conditional_branch: Array<Int> = [];
    let valid: Bool = MirProgramRoutineIndexRowReady(routines, routine_row);
    let global_start: Int = 0 - 1;
    let block_start: Int = 0;
    let block_count: Int = 0;
    if valid {
        block_start = routines.routine_block_starts[routine_row];
        block_count = routines.routine_block_counts[routine_row];
    }
    let block_offset: Int = 0;
    while valid && block_offset < block_count {
        let global_block: Int = block_start + block_offset;
        if global_block < 0 || global_block >= ArrayLength(
                routines.block_instruction_starts
            ) || global_block >= ArrayLength(
                routines.block_instruction_counts
            ) {
            valid = false;
            continue;
        }
        let instruction_start: Int =
            routines.block_instruction_starts[global_block];
        let instruction_count: Int =
            routines.block_instruction_counts[global_block];
        let expected_instruction_end: Int =
            ArrayLength(routines.instruction_starts);
        if global_block + 1 < ArrayLength(
            routines.block_instruction_starts
        ) {
            expected_instruction_end =
                routines.block_instruction_starts[global_block + 1];
        }
        if instruction_start < 0 || instruction_count < 0 ||
            instruction_start + instruction_count !=
                expected_instruction_end ||
            instruction_start + instruction_count > ArrayLength(
                routines.instruction_starts
            ) || instruction_start + instruction_count > ArrayLength(
                routines.instruction_ends
            ) || instruction_start + instruction_count > ArrayLength(
                routines.instruction_kinds
            ) || instruction_start + instruction_count > ArrayLength(
                routines.instruction_source_types
            ) {
            valid = false;
            continue;
        }
        if global_start < 0 { global_start = instruction_start; }
        let has_conditional_branch: Int = 0;
        let instruction_offset: Int = 0;
        while instruction_offset < instruction_count {
            let global_row: Int = instruction_start + instruction_offset;
            let scalar: MirRoutineInstructionScalarCapture =
                MirRoutineInstructionScalarCaptureWithin(
                    routines.source_json,
                    routines.instruction_starts[global_row],
                    routines.instruction_ends[global_row]
                );
            if !scalar.valid { valid = false; }
            ArrayPush(starts, routines.instruction_starts[global_row]);
            ArrayPush(ends, routines.instruction_ends[global_row]);
            ArrayPush(results, scalar.result);
            ArrayPush(expr0s, scalar.expr0);
            ArrayPush(expr1s, scalar.expr1);
            ArrayPush(arg0s, scalar.arg0);
            ArrayPush(arg1s, scalar.arg1);
            ArrayPush(slot_anchors, scalar.slot_anchor);
            ArrayPush(abi_type_names, scalar.abi_type_name);
            ArrayPush(match_variants, scalar.match_variant);
            if routines.instruction_kinds[global_row] == "branch" &&
                routines.instruction_source_types[global_row] !=
                    "AST_CONTINUE" &&
                routines.instruction_source_types[global_row] != "AST_BREAK" {
                has_conditional_branch = 1;
            }
            instruction_offset = instruction_offset + 1;
        }
        ArrayPush(
            block_has_conditional_branch, has_conditional_branch
        );
        block_offset = block_offset + 1;
    }
    return MirRoutineInstructionFactBundle(
        valid, global_start, starts, ends, results, expr0s, expr1s,
        arg0s, arg1s, slot_anchors, abi_type_names, match_variants,
        block_has_conditional_branch
    );
}

func MirRoutineInstructionFactBundleReady(
    ref facts: MirRoutineInstructionFactBundle,
    expected_block_count: Int
) -> Bool {
    let count: Int = ArrayLength(facts.starts);
    return facts.valid && expected_block_count >= 0 &&
        (count == 0 || facts.global_start >= 0) &&
        expected_block_count == ArrayLength(
            facts.block_has_conditional_branch
        ) && count == ArrayLength(facts.ends) &&
        count == ArrayLength(facts.results) &&
        count == ArrayLength(facts.expr0s) &&
        count == ArrayLength(facts.expr1s) &&
        count == ArrayLength(facts.arg0s) &&
        count == ArrayLength(facts.arg1s) &&
        count == ArrayLength(facts.slot_anchors) &&
        count == ArrayLength(facts.abi_type_names) &&
        count == ArrayLength(facts.match_variants);
}

func MirRoutineInstructionFactBundleAtGlobal(
    ref facts: MirRoutineInstructionFactBundle,
    global_row: Int
) -> MirRoutineInstructionScalarCapture {
    let row: Int = global_row - facts.global_start;
    let count: Int = ArrayLength(facts.starts);
    if !facts.valid || facts.global_start < 0 || row < 0 || row >= count ||
        count != ArrayLength(facts.ends) ||
        count != ArrayLength(facts.results) ||
        count != ArrayLength(facts.expr0s) ||
        count != ArrayLength(facts.expr1s) ||
        count != ArrayLength(facts.arg0s) ||
        count != ArrayLength(facts.arg1s) ||
        count != ArrayLength(facts.slot_anchors) ||
        count != ArrayLength(facts.abi_type_names) ||
        count != ArrayLength(facts.match_variants) {
        return InvalidMirRoutineInstructionScalarCapture();
    }
    return MirRoutineInstructionScalarCapture(
        true, facts.results[row], facts.expr0s[row], facts.expr1s[row],
        facts.arg0s[row], facts.arg1s[row], facts.slot_anchors[row],
        facts.abi_type_names[row], facts.match_variants[row]
    );
}
