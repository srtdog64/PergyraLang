// MIR routine inventory fact owner for self-hosted mir_lower.
//
// This module owns discovery of routine declarations and bounded routine
// header facts in pgy.mir.v1 JSON. CFG reconstruction and AST-tree emission
// belong to routine_lower.pgy.

import "json_fact_read.pgy";

// Find the next routine declaration row after `from`. Routine discovery is
// owned by the MIR `routines` array; instruction/name payloads are not scanned.
// Returns the containing routine object position when present.
func FindRoutine(json: String, from: Int) -> Option<Int> {
    let row: Int = 0;
    let bounds: Array<Int> = [0, 0];
    while MirRoutineObjectBoundsAt(json, row, bounds) {
        if bounds[0] >= from {
            let kind: String = MirObjectStringFact(json, bounds[0], bounds[1], "kind");
            if kind == "function" || kind == "method" {
                return Some(bounds[0]);
            }
        }
        row = row + 1;
    }
    return None;
}

func RoutineObjectEnd(json: String, rpos: Int) -> Option<Int> {
    return MirObjectEnd(json, rpos, StringLength(json));
}

func RoutineSpanEnd(json: String, routine_name_end: Int) -> Int {
    let object_end_opt: Option<Int> = MirObjectEnd(json, routine_name_end, StringLength(json));
    if IsSome(object_end_opt) {
        let object_end: Int = UnwrapOption(object_end_opt);
        if object_end > routine_name_end {
            return object_end;
        }
    }
    return StringLength(json);
}

func RoutineBlocksBounds(json: String, routine_name_end: Int, span_end: Int, inout bounds: Array<Int>) -> Bool {
    return MirObjectArrayBounds(json, routine_name_end, span_end, "blocks", bounds);
}

func RoutineHeaderEnd(json: String, routine_name_end: Int, span_end: Int) -> Int {
    let bounds: Array<Int> = [0, 0];
    if RoutineBlocksBounds(json, routine_name_end, span_end, bounds) {
        return bounds[0];
    }
    return span_end;
}

func RoutineNameEnd(json: String, rpos: Int) -> Option<Int> {
    let object_end: Int = RoutineObjectEnd(json, rpos)?;
    let bounds: Array<Int> = [0, 0];
    if object_end <= rpos || !MirObjectFieldValueBounds(json, rpos, object_end, "name", bounds) {
        return None;
    }
    return Some(bounds[1]);
}

func RoutineName(json: String, rpos: Int) -> String {
    let object_end_opt: Option<Int> = RoutineObjectEnd(json, rpos);
    if !IsSome(object_end_opt) {
        return "";
    }
    return MirObjectStringFact(json, rpos, UnwrapOption(object_end_opt), "name");
}

func RoutineKind(json: String, rpos: Int, routine_name_end: Int, span_end: Int) -> String {
    return MirObjectStringFact(json, rpos, RoutineHeaderEnd(json, routine_name_end, span_end), "kind");
}

func RoutineOwner(json: String, rpos: Int, routine_name_end: Int, span_end: Int) -> String {
    return MirObjectStringFact(json, rpos, RoutineHeaderEnd(json, routine_name_end, span_end), "owner");
}

func RoutineParamCount(json: String, rpos: Int, header_end: Int) -> Int {
    let count: Int = 0;
    let bounds: Array<Int> = [0, 0];
    while MirObjectArrayObjectBoundsAt(json, rpos, header_end, "params", count, bounds) {
        count = count + 1;
    }
    return count;
}

func RoutineParamNameAt(json: String, rpos: Int, header_end: Int, row: Int) -> String {
    let bounds: Array<Int> = [0, 0];
    if !MirObjectArrayObjectBoundsAt(json, rpos, header_end, "params", row, bounds) {
        return "";
    }
    return MirObjectStringFact(json, bounds[0], bounds[1], "name");
}

func RoutineParamTypeAt(json: String, rpos: Int, header_end: Int, row: Int) -> String {
    let bounds: Array<Int> = [0, 0];
    if !MirObjectArrayObjectBoundsAt(json, rpos, header_end, "params", row, bounds) {
        return "";
    }
    return MirObjectStringFact(json, bounds[0], bounds[1], "type");
}

func RoutineReturnType(json: String, rpos: Int, header_end: Int) -> String {
    let rtype: String = MirObjectStringFact(json, rpos, header_end, "return");
    if StringLength(rtype) == 0 {
        return "Void";
    }
    return rtype;
}

func RoutineBlocksStart(json: String, routine_name_end: Int, span_end: Int) -> Option<Int> {
    let bounds: Array<Int> = [0, 0];
    if RoutineBlocksBounds(json, routine_name_end, span_end, bounds) {
        return Some(bounds[0]);
    }
    return None;
}

func FindRoutineByOwnerName(json: String, owner: String, name: String) -> Option<Int> {
    let rpos_opt: Option<Int> = FindRoutine(json, 0);
    while IsSome(rpos_opt) {
        let rpos: Int = UnwrapOption(rpos_opt);
        let nend: Int = RoutineNameEnd(json, rpos)?;
        let routine: String = RoutineName(json, rpos);
        let span_end: Int = RoutineSpanEnd(json, nend);
        let kind: String = RoutineKind(json, rpos, nend, span_end);
        let ro: String = RoutineOwner(json, rpos, nend, span_end);
        if kind == "method" && ro == owner && routine == name {
            return Some(rpos);
        }
        rpos_opt = FindRoutine(json, span_end);
    }
    return None;
}
