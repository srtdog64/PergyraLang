// MIR routine CFG fact lowering owner for self-hosted mir_lower.
//
// This module owns CFG structured reconstruction and function AST-tree
// emission from MIR JSON facts. Routine inventory discovery belongs to
// routine_inventory_owner.pgy.

// ---------------------------------------------------------------------------
// Control-flow reconstruction (CFG -> structured AST).
//
// The MIR-JSON carries per-block `succ_true`/`succ_false` edges. For non-loop
// routines we follow those edges to rebuild `If: / Then: / Else:` structure
// instead of flattening. Loop routines (while/for) still take the flat walk
// (detected below) -- they need back-edge handling, a separate increment.
// Block ids are sequential digit strings ("0".."n"); block lookup consumes the
// MIR `blocks` row and verifies the row's `id` fact.
// ---------------------------------------------------------------------------

// Successor id fact for `field` (`succ_true` / `succ_false`) within a block.
// "" when the field is absent (no such edge).
func ReadSucc(json: String, bs: Int, be: Int, field: String) -> String {
    return MirObjectNumberFact(json, bs, be, field);
}

func BlockInstructionBoundsAt(json: String, bs: Int, be: Int, row: Int, inout bounds: Array<Int>) -> Bool {
    return MirObjectArrayObjectBoundsAt(json, bs, be, "instructions", row, bounds);
}

func BlockInstructionKind(json: String, inst_start: Int, inst_end: Int) -> String {
    return MirObjectStringFact(json, inst_start, inst_end, "kind");
}

func BlockInstructionOfKindBounds(
    json: String,
    bs: Int,
    be: Int,
    wanted: String,
    inout bounds: Array<Int>
) -> Bool {
    let row: Int = 0;
    while BlockInstructionBoundsAt(json, bs, be, row, bounds) {
        if BlockInstructionKind(json, bounds[0], bounds[1]) == wanted {
            return true;
        }
        row = row + 1;
    }
    return false;
}

func OptionInnerTypeName(type_name: String) -> String {
    let lt: Int = StringIndexOf(type_name, "<");
    if lt < 0 {
        return "";
    }
    let gt: Int = StringIndexOf(type_name, ">");
    if gt <= lt {
        return "";
    }
    let inner: String = StringTrim(Substring(type_name, lt + 1, gt - lt - 1));
    let colon: Int = StringIndexOf(inner, ":");
    if colon >= 0 {
        inner = StringTrim(Substring(inner, 0, colon));
    }
    return inner;
}

// Resolve block `id` to its MIR `blocks` row span [o[0], o[1]); false if not
// found. The supported MIR subset uses sequential block ids, but we still check
// the row's `id` fact before returning it.
func BlockBounds(json: String, routine_start: Int, routine_end: Int, id: String, inout o: Array<Int>) -> Bool {
    if StringLength(id) == 0 {
        return false;
    }
    if !MirObjectArrayObjectBoundsAt(json, routine_start, routine_end, "blocks", ToInt(id), o) {
        return false;
    }
    return MirObjectNumberFact(json, o[0], o[1], "id") == id;
}

// Branch condition within [bs,be); "" if the block does not end in a branch or
// the branch does not carry the required MIR fact.
func BlockCond(json: String, routine_start: Int, routine_end: Int, bs: Int, be: Int) -> String {
    let inst_bounds: Array<Int> = [0, 0];
    if !BlockInstructionOfKindBounds(json, bs, be, "branch", inst_bounds) {
        return "";
    }
    let kp: Int = inst_bounds[0];
    let inst_end: Int = inst_bounds[1];
    let source_type: String = MirObjectStringFact(json, kp, inst_end, "source_type");
    if source_type == "AST_MATCH_CASE" {
        let match_subject: String = MirObjectStringFact(json, kp, inst_end, "expr0");
        let pattern_count: Int = MirObjectArrayStringFactCount(json, kp, inst_end, "match_patterns");
        if StringLength(match_subject) == 0 || pattern_count == 0 {
            Die("match-case branch is missing MIR subject/pattern facts");
        }
        if pattern_count > 1 {
            Die("multi-pattern match cases are outside the self-host MIR subset");
        }
        let pattern: String = MirObjectArrayStringFactAt(json, kp, inst_end, "match_patterns", 0);
        let variant: String = MirObjectStringFact(json, kp, inst_end, "match_variant");
        if variant == "Some" {
            return Concat("IsSome(", Concat(match_subject, ")"));
        }
        if variant == "None" {
            return Concat("!IsSome(", Concat(match_subject, ")"));
        }
        return Concat(match_subject, Concat(" == ", pattern));
    }
    if source_type == "AST_FOR_LOOP" {
        let binding: String = MirObjectStringFact(json, kp, inst_end, "arg0");
        let start: String = MirObjectStringFact(json, kp, inst_end, "expr0");
        let stop: String = MirObjectStringFact(json, kp, inst_end, "expr1");
        if StringLength(binding) > 0 && StringLength(start) > 0 && StringLength(stop) > 0 {
            let iter_type: String = SourceLocalType(json, routine_start, routine_end, start);
            if start == stop && StringLength(iter_type) >= 6 && Substring(iter_type, 0, 6) == "Array<" {
                return Concat("for ", Concat(binding, Concat(" in ", start)));
            }
            return Concat("for ", Concat(binding, Concat(" in ", Concat(start, Concat("..", stop)))));
        }
    }
    let cond: String = MirObjectStringFact(json, kp, inst_end, "expr0");
    if StringLength(cond) > 0 {
        return cond;
    }
    return "";
}

func BlockMatchBindingLine(json: String, routine_start: Int, routine_end: Int,
                           bs: Int, be: Int, indent: String) -> String {
    let inst_bounds: Array<Int> = [0, 0];
    if !BlockInstructionOfKindBounds(json, bs, be, "branch", inst_bounds) {
        return "";
    }
    let kp: Int = inst_bounds[0];
    let inst_end: Int = inst_bounds[1];
    let source_type: String = MirObjectStringFact(json, kp, inst_end, "source_type");
    if source_type != "AST_MATCH_CASE" {
        return "";
    }
    let variant: String = MirObjectStringFact(json, kp, inst_end, "match_variant");
    if variant != "Some" {
        return "";
    }
    let match_subject2: String = MirObjectStringFact(json, kp, inst_end, "expr0");
    let binding: String = MirObjectArrayStringFactAt(json, kp, inst_end, "match_bindings", 0);
    if StringLength(match_subject2) == 0 || StringLength(binding) == 0 {
        Die("Some match case is missing subject or binding MIR fact");
    }
    let subject_type: String = SourceLocalType(json, routine_start, routine_end, match_subject2);
    let inner_type: String = OptionInnerTypeName(subject_type);
    if StringLength(inner_type) == 0 {
        Die(Concat("Some match case subject is not a known Option type: ", match_subject2));
    }
    return Concat(indent, Concat("Let: ", Concat(binding, Concat(" : ",
        Concat(inner_type, Concat(" = UnwrapOption(", Concat(match_subject2, ")\n")))))));
}

// Emit the non-branch statement lines of block [bs,be) at `indent`. `phi`
// instructions carry no statement fact and are skipped by the string-value
// guard.
func EmitBlockStmts(json: String, routine_start: Int, routine_end: Int,
                    bs: Int, be: Int, indent: String) -> String {
    let out: String = "";
    let row: Int = 0;
    let inst_bounds: Array<Int> = [0, 0];
    while BlockInstructionBoundsAt(json, bs, be, row, inst_bounds) {
        let kp: Int = inst_bounds[0];
        let inst_end: Int = inst_bounds[1];
        let ikind: String = BlockInstructionKind(json, kp, inst_end);
        if ikind == "destructure" {
            let d_expr0: String = MirObjectStringFact(json, kp, inst_end, "expr0");
            out = Concat(out, RenderDestructureFromFacts(
                json, routine_start, routine_end, kp, inst_end, indent,
                d_expr0));
        }
        if ikind != "branch" && ikind != "loop-init" {
            let expr0: String = MirObjectStringFact(json, kp, inst_end, "expr0");
            let expr1: String = MirObjectStringFact(json, kp, inst_end, "expr1");
            let arg0: String = MirObjectStringFact(json, kp, inst_end, "arg0");
            let source_type: String = MirObjectStringFact(json, kp, inst_end, "source_type");
            let local_type: String = SourceLocalType(json, routine_start, routine_end, arg0);
            if ikind != "destructure" && source_type == "AST_DEFER_STMT" {
                out = Concat(out, RenderDeferFromFacts(json, kp, inst_end, indent));
            } else if ikind != "destructure" && StringLength(expr0) > 0 {
                out = Concat(out, Concat(indent, Concat(RenderStmtFromFacts(ikind, source_type, arg0, expr0, expr1, local_type), "\n")));
            }
        }
        row = row + 1;
    }
    return out;
}

// True if block [bs,be) carries a `phi` -- the marker of a loop header (a
// `while` header is a block holding both a phi and a branch).
func BlockHasPhi(json: String, bs: Int, be: Int) -> Bool {
    let inst_bounds: Array<Int> = [0, 0];
    return BlockInstructionOfKindBounds(json, bs, be, "phi", inst_bounds);
}

// Render a loop header. A `for` branch carries `for <binding>` as its condition
// (`For: i in 0..3`); anything else is a `while` (`While: (i < 3)`).
func LoopHeaderLine(cond: String) -> String {
    if StringLength(cond) >= 4 && Substring(cond, 0, 4) == "for " {
        return Concat("For: ", Substring(cond, 4, StringLength(cond) - 4));
    }
    return Concat("While: ", cond);
}

// The block at which the single-entry region starting at `start` rejoins its
// parent (the if's merge / post-dominator). Plain blocks fall through to their
// successor; branch blocks recurse to skip past their own if. "" = no exit.
func RegionExit(json: String, routine_start: Int, span_end: Int, start: String) -> String {
    let cur: String = start;
    let guard: Int = 0;
    while StringLength(cur) > 0 && guard < 100000 {
        guard = guard + 1;
        let o: Array<Int> = [0, 0];
        if !BlockBounds(json, routine_start, span_end, cur, o) {
            return "";
        }
        let cond: String = BlockCond(json, routine_start, span_end, o[0], o[1]);
        if StringLength(cond) == 0 {
            return ReadSucc(json, o[0], o[1], "succ_true");
        }
        let t: String = ReadSucc(json, o[0], o[1], "succ_true");
        let f: String = ReadSucc(json, o[0], o[1], "succ_false");
        let te: String = RegionExit(json, routine_start, span_end, t);
        if te == f {
            cur = f;
        } else {
            cur = te;
        }
    }
    return "";
}

func IsLoopAbrupt(id: String, loop_header: String, loop_exit: String) -> Bool {
    if StringLength(id) == 0 {
        return false;
    }
    if StringLength(loop_header) > 0 && id == loop_header {
        return true;
    }
    if StringLength(loop_exit) > 0 && id == loop_exit {
        return true;
    }
    return false;
}

func BlockHasIncomingBackedge(json: String, routine_start: Int, span_end: Int, want: String) -> Bool {
    if StringLength(want) == 0 {
        return false;
    }
    let i: Int = ToInt(want) + 1;
    while i < 1000 {
        let id: String = ToString(i);
        let o: Array<Int> = [0, 0];
        if !BlockBounds(json, routine_start, span_end, id, o) {
            return false;
        }
        if ReadSucc(json, o[0], o[1], "succ_true") == want {
            return true;
        }
        if ReadSucc(json, o[0], o[1], "succ_false") == want {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Emit the structured tree for blocks from `start` until reaching `stop`
// (exclusive). Straight-line blocks emit their statements; a branch block emits
// `If:/Then:/Else:` and recurses into the then/else regions, then continues from
// the merge. `indent` is the leading whitespace for statements at this level.
func EmitRegion(json: String, routine_start: Int, span_end: Int,
                start: String, stop: String, indent: String,
                loop_header: String, loop_exit: String) -> String {
    let out: String = "";
    let cur: String = start;
    let guard: Int = 0;
    while StringLength(cur) > 0 && cur != stop && guard < 100000 {
        guard = guard + 1;
        let o: Array<Int> = [0, 0];
        if !BlockBounds(json, routine_start, span_end, cur, o) {
            return out;
        }
        let bs: Int = o[0];
        let be: Int = o[1];
        let stmts: String = EmitBlockStmts(json, routine_start, span_end, bs, be, indent);
        let had_stmts: Bool = StringLength(stmts) > 0;
        out = Concat(out, stmts);
        let cond: String = BlockCond(json, routine_start, span_end, bs, be);
        if StringLength(cond) == 0 {
            let next: String = ReadSucc(json, bs, be, "succ_true");
            if StringLength(loop_header) > 0 && next == loop_header {
                out = Concat(out, Concat(indent, "Continue\n"));
                cur = stop;
            } else if StringLength(loop_exit) > 0 && next == loop_exit {
                out = Concat(out, Concat(indent, "Break\n"));
                cur = stop;
            } else {
                cur = next;
            }
        } else {
            let t: String = ReadSucc(json, bs, be, "succ_true");
            let f: String = ReadSucc(json, bs, be, "succ_false");
            let isFor: Bool = StringLength(cond) >= 4 && Substring(cond, 0, 4) == "for ";
            let isLoop: Bool = isFor || (BlockHasPhi(json, bs, be)
                && BlockHasIncomingBackedge(json, routine_start, span_end, cur));
            if isLoop {
                // Loop header: the body region (succ_true) flows back here, so we
                // bound it by `cur` (this header); the loop exit is succ_false.
                out = Concat(out, Concat(indent, Concat(LoopHeaderLine(cond), "\n")));
                out = Concat(out, Concat(indent, "  Block:\n"));
                out = Concat(out, EmitRegion(json, routine_start, span_end, t, cur, Concat(indent, "    "), cur, f));
                cur = f;
            } else {
                let te: String = RegionExit(json, routine_start, span_end, t);
                let merge: String = "";
                let hasElse: Bool = false;
                if IsLoopAbrupt(te, loop_header, loop_exit) {
                    merge = f;
                } else if te == f {
                    merge = f;
                } else {
                    merge = te;
                    hasElse = true;
                }
                out = Concat(out, Concat(indent, Concat("If: ", Concat(cond, "\n"))));
                out = Concat(out, Concat(indent, "  Then:\n"));
                out = Concat(out, Concat(indent, "    Block:\n"));
                out = Concat(out, BlockMatchBindingLine(json, routine_start, span_end, bs, be, Concat(indent, "      ")));
                out = Concat(out, EmitRegion(json, routine_start, span_end, t, merge, Concat(indent, "      "), loop_header, loop_exit));
                if hasElse {
                    out = Concat(out, Concat(indent, "  Else:\n"));
                    out = Concat(out, Concat(indent, "    Block:\n"));
                    out = Concat(out, EmitRegion(json, routine_start, span_end, f, merge, Concat(indent, "      "), loop_header, loop_exit));
                }
                cur = merge;
            }
        }
    }
    return out;
}

func EmitRoutineTreeWithSelfType(json: String, rpos: Int, routine_indent: String, self_type: String) -> String {
    let routine_name_end_opt: Option<Int> = RoutineNameEnd(json, rpos);
    if !IsSome(routine_name_end_opt) {
        Die("malformed routine name");
    }
    let routine_name_end: Int = UnwrapOption(routine_name_end_opt);
    let routine: String = RoutineName(json, rpos);
    let span_end: Int = RoutineSpanEnd(json, routine_name_end);
    let header_end: Int = RoutineHeaderEnd(json, routine_name_end, span_end);
    let ppad: String = Concat(routine_indent, "  ");
    let item_pad: String = Concat(routine_indent, "    ");
    let out: String = Concat(routine_indent, Concat("Function: ", Concat(routine, "\n")));

    out = Concat(out, Concat(ppad, "Parameters:\n"));
    let param_count: Int = RoutineParamCount(json, rpos, header_end);
    let param_row: Int = 0;
    while param_row < param_count {
        let pname: String = RoutineParamNameAt(json, rpos, header_end, param_row);
        if StringLength(pname) == 0 {
            Die(Concat("routine parameter is missing name fact: ", routine));
        }
        let ptype: String = RoutineParamTypeAt(json, rpos, header_end, param_row);
        if StringLength(ptype) == 0 && pname == "self" && StringLength(self_type) > 0 {
            ptype = self_type;
        }
        if StringLength(ptype) > 0 {
            out = Concat(out, Concat(item_pad, Concat(pname, Concat(": ", Concat(ptype, "\n")))));
        } else {
            out = Concat(out, Concat(item_pad, Concat(pname, "\n")));
        }
        param_row = param_row + 1;
    }

    let rtype: String = RoutineReturnType(json, rpos, header_end);
    out = Concat(out, Concat(ppad, Concat("Returns: ", Concat(rtype, "\n"))));
    out = Concat(out, Concat(ppad, "Body:\n"));
    out = Concat(out, Concat(item_pad, "Block:\n"));

    let bp: Option<Int> = RoutineBlocksStart(json, routine_name_end, span_end);
    if !IsSome(bp) {
        Die(Concat("routine is missing blocks fact: ", routine));
    }
    let region: String = EmitRegion(json, routine_name_end, span_end, "0", "",
        Concat(item_pad, "  "), "", "");
    if StringLength(region) == 0 {
        Die(Concat("unsupported or empty MIR CFG shape in routine: ", routine));
    }
    return Concat(out, region);
}

func EmitRoutineTree(json: String, rpos: Int, routine_indent: String) -> String {
    return EmitRoutineTreeWithSelfType(json, rpos, routine_indent, "");
}
