// MIR routine CFG fact lowering owner for self-hosted mir_lower.
//
// This module owns CFG structured reconstruction and function AST-tree
// emission from MIR JSON facts. Routine inventory discovery belongs to
// routine_inventory_owner.pgy.
import "error_owner.pgy";
import "json_fact_read.pgy";
import "match_binding_render_owner.pgy";
import "routine_inventory_owner.pgy";
import "routine_fact_index_owner.pgy";
import "routine_cfg_projection_owner.pgy";
import "routine_instruction_view_owner.pgy";
import "phi_fact_owner.pgy";
import "stmt_render.pgy";
import "resource_runtime_abi_fact_owner.pgy";
import "abi_layout_fact_owner.pgy";
func RoutineParamResourceMatchesType(
    resource_kind: String,
    type_name: String
) -> Bool {
    if resource_kind == "none" {
        return !(StringLength(type_name) >= 6 &&
                 Substring(type_name, 0, 5) == "Slot<") &&
            !(StringLength(type_name) >= 12 &&
              Substring(type_name, 0, 11) == "SecureSlot<") &&
            !(StringLength(type_name) >= 12 &&
              Substring(type_name, 0, 11) == "DeviceSlot<");
    }
    if resource_kind == "slot" {
        return StringLength(type_name) >= 6 &&
            Substring(type_name, 0, 5) == "Slot<";
    }
    if resource_kind == "secure-slot" {
        return StringLength(type_name) >= 12 &&
            Substring(type_name, 0, 11) == "SecureSlot<";
    }
    if resource_kind == "device-slot" {
        return StringLength(type_name) >= 12 &&
            Substring(type_name, 0, 11) == "DeviceSlot<";
    }
    return false;
}
// ---------------------------------------------------------------------------
// Control-flow reconstruction (CFG -> structured AST).
//
// The MIR-JSON carries per-block `succ_true`/`succ_false` edges. For non-loop
// routines we follow those edges to rebuild `If: / Then: / Else:` structure
// instead of flattening. Loop routines (while/for) still take the flat walk
// (detected below) -- they need back-edge handling, a separate increment.
// Block ids are sequential digit strings ("0".."n"); block lookup consumes the
// MIR `blocks` row and verifies the row's `id` fact.
// ---------------------------------------------------------------------------
// Branch condition within [bs,be); "" if the block does not end in a branch or
// the branch does not carry the required MIR fact.
func BlockCond(ref index: MirRoutineFactIndex,
    ref routines: MirProgramRoutineIndex, routine_row: Int,
    block_row: Int) -> String {
    let json: String = routines.source_json;
    let selection: MirRoutineInstructionSelection =
        MirRoutineInstructionViewOfKind(
            routines, routine_row, block_row, "branch"
        );
    if !selection.valid { MirLowerFailClosed("invalid branch instruction view"); }
    if !selection.found { return ""; }
    let instruction: MirRoutineInstructionView = selection.instruction;
    let scalar: MirRoutineInstructionScalarCapture =
        MirRoutineInstructionFactBundleAtGlobal(
            index.instruction_facts, instruction.global_row
        );
    if !scalar.valid { MirLowerFailClosed("invalid branch scalar facts"); }
    let kp: Int = instruction.start;
    let inst_end: Int = instruction.end;
    let source_type: String = instruction.source_type;
    if source_type == "AST_CONTINUE" || source_type == "AST_BREAK" {
        return "";
    }
    if source_type == "AST_MATCH_CASE" {
        let match_subject: String = scalar.expr0;
        let patterns: Array<String> = MirObjectArrayStringFactsAtBounds(
            json, kp, inst_end, "match_patterns"
        );
        let pattern_count: Int = ArrayLength(patterns);
        if StringLength(match_subject) == 0 || pattern_count == 0 {
            MirLowerFailClosed("match-case branch is missing MIR subject/pattern facts");
        }
        if pattern_count > 1 {
            MirLowerFailClosed("multi-pattern match cases are outside the self-host MIR subset");
        }
        let pattern: String = patterns[0];
        let variant: String = scalar.match_variant;
        if variant == "Some" {
            return Concat("IsSome(", Concat(match_subject, ")"));
        }
        if variant == "None" {
            return Concat("!IsSome(", Concat(match_subject, ")"));
        }
        if variant == "Ok" {
            return Concat("IsOk(", Concat(match_subject, ")"));
        }
        if variant == "Err" {
            return Concat("IsErr(", Concat(match_subject, ")"));
        }
        let variant_name: String = variant;
        if variant_name == "" { variant_name = pattern; }
        let enum_owner: String = MirEnumOwnerForVariant(json, variant_name);
        if StringLength(enum_owner) > 0 {
            return Concat(match_subject, Concat(" == ", Concat(enum_owner, Concat(".", variant_name))));
        }
        if ToString(ToInt(pattern)) != pattern {
            MirLowerFailClosed(
                "match enum variant declaration fact is missing"
            );
        }
        return Concat(match_subject, Concat(" == ", pattern));
    }
    if source_type == "AST_FOR_LOOP" {
        let binding: String = scalar.arg0;
        let start: String = scalar.expr0;
        let stop: String = scalar.expr1;
        if StringLength(binding) > 0 && StringLength(start) > 0 && StringLength(stop) > 0 {
            let iter_type: String = MirRoutineFactIndexSourceLocalType(index, start);
            let binding_type: String =
                MirRoutineFactIndexSourceLocalType(index, binding);
            let header: String = MirIterationHeaderTextFromFacts(
                index.iteration_type_facts, binding, start, stop,
                binding_type, iter_type
            );
            if header == "" {
                MirLowerFailClosed("for-each iteration type fact is missing or invalid");
            }
            return header;
        }
    }
    let cond: String = scalar.expr0;
    if StringLength(cond) > 0 {
        return cond;
    }
    return "";
}

func BlockMatchBindingLine(ref index: MirRoutineFactIndex,
    ref routines: MirProgramRoutineIndex, routine_row: Int,
    block_row: Int, indent: String) -> String {
    let json: String = routines.source_json;
    let selection: MirRoutineInstructionSelection =
        MirRoutineInstructionViewOfKind(
            routines, routine_row, block_row, "branch"
        );
    if !selection.valid { MirLowerFailClosed("invalid match instruction view"); }
    if !selection.found { return ""; }
    let instruction: MirRoutineInstructionView = selection.instruction;
    let scalar: MirRoutineInstructionScalarCapture =
        MirRoutineInstructionFactBundleAtGlobal(
            index.instruction_facts, instruction.global_row
        );
    if !scalar.valid { MirLowerFailClosed("invalid match scalar facts"); }
    return MirMatchBindingLineForInstruction(
        json, instruction.start, instruction.end,
        instruction.source_type, scalar.match_variant,
        scalar.expr0, indent
    );
}

// Emit the non-branch statement lines of one admitted block row. `phi`
// instructions carry no statement fact and are skipped by the string-value
// guard.
func EmitBlockStmts(ref index: MirRoutineFactIndex,
    ref routines: MirProgramRoutineIndex, routine_row: Int,
    block_row: Int, indent: String, observe_instruction: Bool) -> String {
    let json: String = routines.source_json;
    let chunks: Array<String> = [];
    let instruction_count: Int =
        MirProgramRoutineIndexBlockInstructionCountAt(
            routines, routine_row, block_row
        );
    if instruction_count < 0 { MirLowerFailClosed("invalid block instruction view"); }
    let row: Int = 0;
    while row < instruction_count {
        let instruction: MirRoutineInstructionView =
            MirRoutineInstructionViewAt(
                routines, routine_row, block_row, row
            );
        if !instruction.valid { MirLowerFailClosed("invalid instruction view row"); }
        let scalar: MirRoutineInstructionScalarCapture =
            MirRoutineInstructionFactBundleAtGlobal(
                index.instruction_facts, instruction.global_row
            );
        if !scalar.valid { MirLowerFailClosed("invalid instruction scalar facts"); }
        let kp: Int = instruction.start;
        let inst_end: Int = instruction.end;
        let ikind: String = instruction.kind;
        let source_type: String = instruction.source_type;
        if !MirCapturedAbiLayoutFactReady(
            json, scalar.abi_type_start, scalar.abi_type_end, scalar.abi_layout_id_start, scalar.abi_layout_id_end,
            scalar.abi_layout_required_start, scalar.abi_layout_required_end, scalar.abi_layout_start, scalar.abi_layout_end) {
            MirLowerFailClosed("instruction is missing or carries an invalid MIR ABI layout fact");
        }
        if observe_instruction { Log(Concat("[driver-pressure-stage] consumer:mir-to-ast:focused-routine:instruction:", Concat(ToString(block_row), Concat(":", Concat(ToString(row), ":abi:done"))))); }
        if !MirResourceRuntimeRowFactReady(routines, instruction) {
            MirLowerFailClosed(
                "resource instruction or consumer is missing its lowered runtime-call ABI row"
            );
        }
        if observe_instruction { Log(Concat("[driver-pressure-stage] consumer:mir-to-ast:focused-routine:instruction:", Concat(ToString(block_row), Concat(":", Concat(ToString(row), ":resource:done"))))); }
        if ikind == "destructure" {
            ArrayPush(chunks, RenderDestructureFromFacts(
                json, kp, inst_end, indent, scalar.expr0));
        }
        // Resource-op rows are MIR evidence for an already-owned executable
        // def/stmt row.  Re-emitting expr0 here would manufacture a second
        // source statement (for example, a machine Write row becomes the bare
        // expression `current`) and reopen AST inference during canonicalization.
        if ikind != "branch" && ikind != "loop-init" &&
            ikind != "resource-op" {
            let expr0: String = scalar.expr0;
            let expr1: String = scalar.expr1;
            let arg0: String = scalar.arg0;
            let arg1: String = scalar.arg1;
            let slot_anchor: String = scalar.slot_anchor;
            let local_type: String = MirDeclaredLocalTypeFact(
                ikind, source_type, scalar.abi_type_name
            );
            if ikind == "stmt" && source_type == "AST_BIND_STMT" {
                if arg0 == "" || arg1 == "" || slot_anchor == "" ||
                    expr0 != "" || expr1 != "" {
                    MirLowerFailClosed(
                        "ability bind is missing party/slot/role MIR facts"
                    );
                }
                ArrayPush(chunks, Concat(
                    indent, Concat(
                        "BindStmt: ", Concat(
                            arg0, Concat(
                                ".", Concat(
                                    slot_anchor, Concat(" = ", Concat(arg1, "\n"))
                                )
                            )
                        )
                    )
                ));
            } else if ikind != "destructure" && source_type == "AST_DEFER_STMT" {
                ArrayPush(chunks, RenderDeferFromFacts(
                    json, kp, inst_end, indent, arg0
                ));
            } else if (ikind == "return" && StringLength(expr0) == 0) ||
                (ikind != "destructure" && source_type == "AST_RETURN_VOID") {
                ArrayPush(chunks, Concat(indent, "Return\n"));
            } else if ikind != "destructure" && StringLength(expr0) > 0 {
                ArrayPush(chunks, Concat(indent, Concat(RenderStmtFromFacts(ikind, source_type, arg0, expr0, expr1, local_type), "\n")));
            }
        }
        if observe_instruction { Log(Concat("[driver-pressure-stage] consumer:mir-to-ast:focused-routine:instruction:", Concat(ToString(block_row), Concat(":", Concat(ToString(row), ":render:done"))))); }
        row = row + 1;
    }
    return StringJoin(chunks, "");
}

// A loop whose every body path transfers out (for example, `break` on both
// branches) has no CFG backedge to project.  Its native summary is still
// authoritative; detect that shape from the branch facts without reopening
// the source body.  `while true` is the other canonical no-backedge shape.
func BlockHasLoopTransfer(ref index: MirRoutineFactIndex,
    ref routines: MirProgramRoutineIndex, routine_row: Int,
    block_row: Int) -> Bool {
    let selection: MirRoutineInstructionSelection =
        MirRoutineInstructionViewOfKind(
            routines, routine_row, block_row, "branch"
        );
    if !selection.valid { return false; }
    if !selection.found { return false; }
    let instruction: MirRoutineInstructionView = selection.instruction;
    let scalar: MirRoutineInstructionScalarCapture =
        MirRoutineInstructionFactBundleAtGlobal(
            index.instruction_facts, instruction.global_row
        );
    if !scalar.valid { return false; }
    let source_type: String = instruction.source_type;
    let condition: String = scalar.expr0;
    return source_type == "AST_BREAK" || source_type == "AST_CONTINUE" ||
        condition == "true";
}

// A semantic producer is the only source of loop transfer facts.  The
// self-host projection may use CFG shape to locate the loop headers it will
// render, but it must admit exactly the already-proven summary rows and may
// not synthesize a replacement summary from those edges.
func LoopFlowSummaryProjectionReady(
    ref index: MirRoutineFactIndex,
    ref routines: MirProgramRoutineIndex,
    routine_row: Int
) -> Bool {
    let summary_count: Int = ArrayLength(index.loop_flow_summary_loop_ids);
    let summary_row: Int = 0;
    let block_row: Int = 0;
    let has_backedge: Bool = false;
    let has_loop_transfer: Bool = false;
    while block_row < ArrayLength(index.backedge_headers) {
        let block_is_backedge: Bool =
            index.backedge_headers[block_row] == 1;
        let cond: String = BlockCond(
            index, routines, routine_row, block_row
        );
        let is_for: Bool = StringLength(cond) >= 4 &&
            Substring(cond, 0, 4) == "for ";
        // Backedge analysis can mark an inner merge target in the same cycle
        // as the real loop header.  Only a backedge target carrying a branch
        // condition is a renderable loop header; the merge remains ordinary
        // body CFG.
        let is_loop: Bool = is_for ||
            (block_is_backedge && StringLength(cond) > 0);
        if block_is_backedge {
            has_backedge = true;
        }
        if BlockHasLoopTransfer(
            index, routines, routine_row, block_row
        ) {
            has_loop_transfer = true;
        }
        if is_loop {
            if summary_row >= summary_count {
                return false;
            }
            let expected_kind: Int = index.loop_flow_summary_kinds[summary_row];
            if (expected_kind == 1) != is_for {
                return false;
            }
            summary_row = summary_row + 1;
        }
        block_row = block_row + 1;
    }
    if summary_row == summary_count {
        return true;
    }
    // No backedge means no structured loop node will be emitted.  Permit the
    // already-proven while summaries only when the CFG contains an explicit
    // loop transfer; a forged `for` kind remains rejected.
    if summary_row == 0 && summary_count > 0 && !has_backedge &&
        has_loop_transfer {
        let row: Int = 0;
        while row < summary_count {
            if index.loop_flow_summary_kinds[row] != 0 {
                return false;
            }
            row = row + 1;
        }
        return true;
    }
    return false;
}

// Emit the structured tree for blocks from `start` until reaching `stop`
// (exclusive). Straight-line blocks emit their statements; a branch block emits
// `If:/Then:/Else:` and recurses into the then/else regions, then continues from
// the merge. `indent` is the leading whitespace for statements at this level.
func EmitRegion(ref index: MirRoutineFactIndex,
    ref routines: MirProgramRoutineIndex, routine_row: Int,
    start: String, stop: String, indent: String,
    loop_header: String, loop_exit: String,
    observe_first_block: Bool) -> String {
    let chunks: Array<String> = [];
    let cur: String = start;
    let guard: Int = 0;
    while StringLength(cur) > 0 && cur != stop && guard < 100000 {
        guard = guard + 1;
        let block_row: Int = RoutineCfgBlockRow(index, cur);
        if block_row < 0 {
            MirLowerFailClosed("CFG successor names an invalid block identity");
        }
        if observe_first_block { Log(Concat("[driver-pressure-stage] consumer:mir-to-ast:focused-routine:region:block:", Concat(ToString(block_row), ":bounds:done"))); }
        let stmts: String = EmitBlockStmts(
            index, routines, routine_row, block_row, indent,
            observe_first_block
        );
        if observe_first_block { Log(Concat("[driver-pressure-stage] consumer:mir-to-ast:focused-routine:region:block:", Concat(ToString(block_row), ":statements:done"))); }
        ArrayPush(chunks, stmts);
        let cond: String = BlockCond(
            index, routines, routine_row, block_row
        );
        if observe_first_block { Log(Concat("[driver-pressure-stage] consumer:mir-to-ast:focused-routine:region:block:", Concat(ToString(block_row), ":condition:done"))); }
        if StringLength(cond) == 0 {
            let next: String = ReadSucc(index, cur, false);
            if StringLength(loop_header) > 0 && next == loop_header {
                ArrayPush(chunks, Concat(indent, "Continue\n"));
                cur = stop;
            } else if StringLength(loop_exit) > 0 && next == loop_exit {
                ArrayPush(chunks, Concat(indent, "Break\n"));
                cur = stop;
            } else {
                cur = next;
            }
        } else {
            let t: String = ReadSucc(index, cur, false);
            let f: String = ReadSucc(index, cur, true);
            let isFor: Bool = StringLength(cond) >= 4 && Substring(cond, 0, 4) == "for ";
            let isLoop: Bool = isFor ||
                BlockHasIncomingBackedge(index, cur);
            if isLoop {
                // Loop header: the body region (succ_true) flows back here, so we
                // bound it by `cur` (this header); the loop exit is succ_false.
                ArrayPush(chunks, Concat(indent, Concat(LoopHeaderLine(cond), "\n")));
                ArrayPush(chunks, Concat(indent, "  Block:\n"));
                ArrayPush(chunks, EmitRegion(index, routines, routine_row,
                    t, cur, Concat(indent, "    "), cur, f, observe_first_block));
                cur = f;
            } else {
                let structural_merge: String =
                    MirRoutineFactIndexBlockStructuralMerge(index, ToInt(cur));
                let merge: String = structural_merge;
                // In a no-else source branch whose then arm exits the loop,
                // the cyclic CFG can make a later iteration's then block look
                // like the nearest common merge.  Consume the arm successor
                // fact before projecting the fallthrough arm as continuation.
                let then_terminates_or_flows_to_loop_exit: Bool = false;
                if structural_merge == t {
                    let then_row: Int = RoutineCfgBlockRow(index, t);
                    then_terminates_or_flows_to_loop_exit =
                        MirRoutineFactIndexBlockIsTerminal(index, then_row);
                    if !then_terminates_or_flows_to_loop_exit &&
                        then_row >= 0 {
                        then_terminates_or_flows_to_loop_exit = IsLoopAbrupt(
                            ReadSucc(index, t, false),
                            loop_header, loop_exit
                        );
                    }
                }
                if IsLoopAbrupt(structural_merge, loop_header, loop_exit) ||
                    then_terminates_or_flows_to_loop_exit {
                    merge = f;
                }
                let hasElse: Bool = StringLength(f) > 0 && f != merge;
                ArrayPush(chunks, Concat(indent, Concat("If: ", Concat(cond, "\n"))));
                ArrayPush(chunks, Concat(indent, "  Then:\n"));
                ArrayPush(chunks, Concat(indent, "    Block:\n"));
                ArrayPush(chunks, BlockMatchBindingLine(index, routines,
                    routine_row, block_row, Concat(indent, "      ")));
                ArrayPush(chunks, EmitRegion(index, routines, routine_row,
                    t, merge, Concat(indent, "      "), loop_header, loop_exit,
                    observe_first_block));
                if hasElse {
                    ArrayPush(chunks, Concat(indent, "  Else:\n"));
                    ArrayPush(chunks, Concat(indent, "    Block:\n"));
                    ArrayPush(chunks, EmitRegion(index, routines, routine_row,
                        f, merge, Concat(indent, "      "), loop_header,
                        loop_exit, observe_first_block));
                }
                cur = merge;
            }
        }
    }
    return StringJoin(chunks, "");
}

func EmitRoutineTreeWithSelfTypeAtRow(ref routines: MirProgramRoutineIndex, routine_row: Int,
    routine_indent: String, self_type: String,
    observe_fact_index: Bool, observe_focused_routine: Bool) -> String {
    if !MirProgramRoutineIndexRowReady(routines, routine_row) { MirLowerFailClosed("malformed routine index row"); }
    let json: String = routines.source_json;
    let routine_start: Int = routines.starts[routine_row];
    let routine_end: Int = routines.ends[routine_row];
    let routine: String = routines.names[routine_row];
    if routine_end <= routine_start || routine == "" {
        MirLowerFailClosed("malformed routine name");
    }
    if observe_focused_routine { Log("[driver-pressure-stage] consumer:mir-to-ast:focused-routine:fact-index:start"); }
    let index: MirRoutineFactIndex = BuildMirRoutineFactIndex(routines, routine_row);
    if !index.valid {
        MirLowerFailClosed(Concat(
            "routine MIR fact index is incomplete: ",
            Concat(routine, Concat(" [", Concat(index.validation_stage, "]")))
        ));
    }
    if observe_fact_index { Log("[driver-pressure-stage] consumer:mir-to-ast:first-top-level-routine-fact-index:done"); }
    if observe_focused_routine { Log("[driver-pressure-stage] consumer:mir-to-ast:focused-routine:fact-index:done"); }
    if !MirRoutinePhiFactsReady(index, routines, routine_row) {
        MirLowerFailClosed(Concat(
            "MIR phi facts are missing or inconsistent: ", routine
        ));
    }
    if !MirRoutineFactIndexFunctionParamFlowFactsValid(index) {
        MirLowerFailClosed(Concat(
            "routine function parameter flow summary facts are incomplete: ",
            routine
        ));
    }
    if !MirRoutineFactIndexResourceFlowFactsValid(index) {
        MirLowerFailClosed(Concat(
            "routine ResourceFlowUniverse facts are incomplete: ",
            routine
        ));
    }
    if !MirRoutineFactIndexLoopFlowFactsValid(index) {
        MirLowerFailClosed(Concat(
            "routine LoopFlowSummary facts are incomplete: ",
            routine
        ));
    }
    if !LoopFlowSummaryProjectionReady(index, routines, routine_row) {
        MirLowerFailClosed(Concat(
            "routine LoopFlowSummary facts do not match CFG loop projection: ",
            routine
        ));
    }
    if observe_fact_index { Log("[driver-pressure-stage] consumer:mir-to-ast:first-top-level-routine-validation:done"); }
    if observe_focused_routine { Log("[driver-pressure-stage] consumer:mir-to-ast:focused-routine:validation:done"); }
    let header: MirRoutineHeaderFacts = BuildMirRoutineHeaderFacts(
        json, routine_start, routine_end
    );
    if observe_focused_routine { Log("[driver-pressure-stage] consumer:mir-to-ast:focused-routine:header:done"); }
    let ppad: String = Concat(routine_indent, "  ");
    let item_pad: String = Concat(routine_indent, "    ");
    let chunks: Array<String> = [Concat(routine_indent, Concat("Function: ", Concat(routine, "\n")))];

    let generic_count: Int = ArrayLength(header.generic_names);
    if generic_count > 0 {
        let generic_text: String = "";
        let generic_i: Int = 0;
        while generic_i < generic_count {
            let generic_name: String = header.generic_names[generic_i];
            if generic_name == "" {
                MirLowerFailClosed(Concat(
                    "routine generic parameter is missing name fact: ", routine
                ));
            }
            if generic_i > 0 {
                generic_text = Concat(generic_text, ", ");
            }
            generic_text = Concat(generic_text, generic_name);
            generic_i = generic_i + 1;
        }
        ArrayPush(
            chunks,
            Concat(ppad, Concat(
                "Generic params: <", Concat(generic_text, ">\n")
            ))
        );
    }
    ArrayPush(chunks, Concat(ppad, "Parameters:\n"));
    let param_count: Int = ArrayLength(header.param_names);
    let param_row: Int = 0;
    while param_row < param_count {
        let pname: String = header.param_names[param_row];
        if StringLength(pname) == 0 {
            MirLowerFailClosed(Concat("routine parameter is missing name fact: ", routine));
        }
        let ptype: String = header.param_types[param_row];
        let carriage: String = header.param_carriages[param_row];
        let resource_kind: String = header.param_resources[param_row];
        let pass_shape: String = header.param_pass_shapes[param_row];
        if (carriage != "value" && carriage != "value-result" &&
            carriage != "owner-handle" && carriage != "readonly-ref") ||
            (pass_shape != "direct" && pass_shape != "indirect") ||
            (pass_shape == "indirect" && carriage != "readonly-ref") ||
            !RoutineParamResourceMatchesType(resource_kind, ptype) {
            MirLowerFailClosed(Concat(
                "routine parameter ABI fact is invalid: ", pname
            ));
        }
        let param_prefix: String = "";
        if carriage == "value-result" {
            param_prefix = "inout ";
        } else if carriage == "owner-handle" {
            param_prefix = "own ";
        } else if carriage == "readonly-ref" {
            param_prefix = "ref ";
        }
        let rendered_name: String = Concat(param_prefix, pname);
        if StringLength(ptype) == 0 && pname == "self" && StringLength(self_type) > 0 {
            ptype = self_type;
        }
        if StringLength(ptype) > 0 {
            ArrayPush(chunks, Concat(item_pad, Concat(rendered_name, Concat(": ", Concat(ptype, "\n")))));
        } else {
            ArrayPush(chunks, Concat(item_pad, Concat(rendered_name, "\n")));
        }
        param_row = param_row + 1;
    }

    let rtype: String = header.return_type;
    ArrayPush(chunks, Concat(ppad, Concat("Returns: ", Concat(rtype, "\n"))));
    ArrayPush(chunks, Concat(ppad, "Body:\n"));
    ArrayPush(chunks, Concat(item_pad, "Block:\n"));

    let region: String = EmitRegion(index, routines, routine_row,
        "0", "", Concat(item_pad, "  "), "", "", observe_focused_routine);
    if StringLength(region) == 0 {
        MirLowerFailClosed(Concat("unsupported or empty MIR CFG shape in routine: ", routine));
    }
    if observe_focused_routine { Log("[driver-pressure-stage] consumer:mir-to-ast:focused-routine:region:done"); }
    ArrayPush(chunks, region);
    return StringJoin(chunks, "");
}

func EmitRoutineTreeAtRow(ref routines: MirProgramRoutineIndex,
    routine_row: Int, routine_indent: String,
    observe_fact_index: Bool, observe_focused_routine: Bool) -> String {
    return EmitRoutineTreeWithSelfTypeAtRow(
        routines, routine_row, routine_indent, "",
        observe_fact_index, observe_focused_routine
    );
}
