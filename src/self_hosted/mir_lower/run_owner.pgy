// MIR-lower CLI run boundary owner.

import "error_owner.pgy";
import "mir_fact_graph_contract_owner.pgy";
import "mir_json_input_owner.pgy";
import "fixture_manifest_owner.pgy";
import "json_fact_read.pgy";
import "stmt_render.pgy";
import "program_routine_index_owner.pgy";
import "routine_inventory_owner.pgy";
import "routine_fact_index_owner.pgy";
import "phi_fact_owner.pgy";
import "routine_lower.pgy";
import "decl_lower.pgy";
import "program_lower.pgy";
import "../compiler/machine_layer_declaration_consumer.pgy";

func RunMirLowerFromArgs(args: Array<String>) -> Void with caps io_read, io_write {
    if ArrayLength(args) > 0 && args[0] == "--fixture-manifest" {
        EmitMirParityFixtureManifest();
        return;
    }
    if ArrayLength(args) > 0 && args[0] == "--verify-input" {
        if ArrayLength(args) != 2 && ArrayLength(args) != 3 {
            MirLowerFailClosed(
                "usage: mir_lower --verify-input <mir-json-file> [machine-manifest-json-file]"
            );
        }
        let declaration: SelfHostMachineLayerDeclaration =
            SelfHostMachineLayerDeclarationEmpty();
        if ArrayLength(args) == 3 {
            declaration = SelfHostMachineLayerDeclarationFromPath(args[2]);
        }
        MirJsonReadInput(
            args[1], declaration
        );
        Log("pgy.mir.v1 input verified");
        return;
    }
    let path: String = MirJsonInputPath(args);
    let declaration_path: String = "";
    if ArrayLength(args) > 1 { declaration_path = args[1]; }
    let json: String = MirJsonReadInput(
        path, SelfHostMachineLayerDeclarationFromPath(declaration_path)
    );
    Print(EmitMirProgramTree(json));
}
