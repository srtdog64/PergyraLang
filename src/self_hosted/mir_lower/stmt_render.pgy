// MIR instruction facts -> AST-tree statement rendering owner.

import "error_owner.pgy";
import "json_fact_read.pgy";
import "destructure_expression_projection_owner.pgy";
import "expression_graph_sequence_owner.pgy";

func RenderDestructureFromFacts(json: String, inst_start: Int, inst_end: Int,
                                indent: String, expr0: String) -> String {
    let init: String = StringTrim(expr0);
    let elem_type: String = MirObjectStringFactAtBounds(
        json, inst_start, inst_end, "destructure_element_type"
    );
    if StringLength(init) == 0 {
        MirLowerFailClosed("destructure instruction is missing initializer fact");
    }
    if StringLength(elem_type) == 0 {
        MirLowerFailClosed(Concat("destructure initializer element type is unknown: ", init));
    }
    let binding_bounds: Array<Int> = [0, 0];
    if !MirObjectArrayBoundsAtBounds(
        json, inst_start, inst_end, "destructure_bindings", binding_bounds
    ) {
        MirLowerFailClosed("destructure instruction is missing binding-name facts");
    }
    let bindings: Array<String> = MirObjectArrayStringFactsAtBounds(
        json, inst_start, inst_end, "destructure_bindings"
    );
    if ArrayLength(bindings) == 0 || bindings[0] == "" {
        MirLowerFailClosed("destructure instruction has no binding-name facts");
    }
    let first_binding: String = bindings[0];

    let out: String = "";
    let source: String = init;
    if MirDestructureNeedsTemp(init) {
        source = MirDestructureTempName(first_binding);
        out = Concat(out, Concat(indent, Concat("Let: ", Concat(source,
            Concat(" : Array<", Concat(elem_type, Concat("> = ", Concat(init, "\n"))))))));
    }

    let index: Int = 0;
    while index < ArrayLength(bindings) &&
        StringLength(bindings[index]) > 0 {
        let name: String = bindings[index];
        out = Concat(out, Concat(indent, Concat("Let: ", Concat(name,
            Concat(" : ", Concat(elem_type, Concat(" = ", Concat(source,
                Concat("[", Concat(ToString(index), "]\n"))))))))));
        index = index + 1;
    }
    if index == 0 {
        MirLowerFailClosed("destructure instruction has no binding-name facts");
    }
    return out;
}

// Convert one fact-rendered statement text to its AST-tree line. `Log(...)` and
// bare calls pass through unchanged; `let NAME: T = V` becomes
// `Let: NAME : T = V`.
func StmtToTreeLine(stmt: String) -> String {
    let s: String = StringTrim(stmt);
    if StringLength(s) >= 4 && Substring(s, 0, 4) == "let " {
        let rest: String = Substring(s, 4, StringLength(s) - 4);
        let colon: Int = StringIndexOf(rest, ":");
        if colon < 0 {
            MirLowerFailClosed(Concat("let without type annotation: ", s));
        }
        let name: String = StringTrim(Substring(rest, 0, colon));
        let after: String = StringTrim(Substring(rest, colon + 1, StringLength(rest) - (colon + 1)));
        return Concat("Let: ", Concat(name, Concat(" : ", after)));
    }
    return s;
}

func MirDeclaredLocalTypeFact(
    kind: String, source_type: String, abi_type_name: String
) -> String {
    if kind != "def" || source_type != "AST_LET_DECL" { return ""; }
    if StringLength(abi_type_name) == 0 {
        MirLowerFailClosed("local declaration is missing its MIR ABI type fact");
    }
    return abi_type_name;
}

func RenderDirectDeferCallFromGraph(
    ref arena: SemanticExpressionGraphArena,
    root: Int
) -> String {
    let arguments: Array<String> = [];
    let call_node: Int = root;
    while call_node >= 0 &&
        call_node < ArrayLength(arena.topology.node_kinds) &&
        arena.topology.node_kinds[call_node] ==
            AstExpressionNodeCallArgument() {
        let argument_node: Int = arena.topology.right_children[call_node];
        if argument_node < 0 || argument_node >= ArrayLength(arena.node_texts) ||
            arena.node_texts[argument_node] == "" {
            MirLowerFailClosed("defer body graph has an invalid call argument fact");
        }
        ArrayPush(arguments, arena.node_texts[argument_node]);
        call_node = arena.topology.left_children[call_node];
    }
    if call_node < 0 ||
        call_node >= ArrayLength(arena.topology.node_kinds) ||
        arena.topology.node_kinds[call_node] != AstExpressionNodeCall() ||
        arena.call_target_kinds[call_node] != SemanticCallTargetDirect() ||
        arena.call_target_names[call_node] == "" {
        MirLowerFailClosed("defer body graph has no direct call target fact");
    }
    let target: String = arena.call_target_names[call_node];
    let callee_node: Int = arena.topology.left_children[call_node];
    let empty_call: String = Concat(target, "()");
    if callee_node < 0 || callee_node >= ArrayLength(arena.node_texts) ||
        arena.topology.node_kinds[callee_node] != AstExpressionNodeLeaf() ||
        arena.node_texts[callee_node] != target ||
        arena.node_texts[call_node] != empty_call {
        MirLowerFailClosed(
            "defer body graph disagrees with direct call target fact"
        );
    }
    let body: String = Concat(target, "(");
    let i: Int = ArrayLength(arguments);
    while i > 0 {
        i = i - 1;
        if i + 1 < ArrayLength(arguments) { body = Concat(body, ", "); }
        body = Concat(body, arguments[i]);
    }
    body = Concat(body, ")");
    if arena.node_texts[root] != body {
        MirLowerFailClosed(
            "defer body graph disagrees with direct call target fact"
        );
    }
    return body;
}

func RenderDeferFromFacts(json: String, inst_start: Int, inst_end: Int,
                          indent: String, arg0: String) -> String {
    if arg0 != "Log" && arg0 != "Call" {
        MirLowerFailClosed("defer instruction has no typed body kind");
    }
    let instruction: JsonObjectFactTable = JsonObjectFactTableFromBounds(
        json, inst_start, inst_end
    );
    let graph: JsonObjectFactTable = JsonObjectFactObjectTable(
        instruction, "expr0_graph"
    );
    let sequence: MirExpressionGraphSequence =
        MirExpressionGraphSequenceAppend(
            MirExpressionGraphSequenceEmpty(), graph
        );
    if !sequence.ok || ArrayLength(sequence.roots) != 1 {
        MirLowerFailClosed(
            "MIR instruction expression graph is missing or invalid: defer typed body graph required"
        );
    }
    let root: Int = sequence.roots[0];
    if root < 0 || root >= ArrayLength(sequence.arena.node_texts) ||
        sequence.arena.node_texts[root] == "" {
        MirLowerFailClosed("defer body graph has no root expression");
    }
    let body: String = "";
    if arg0 == "Log" {
        body = Concat("Log(", Concat(sequence.arena.node_texts[root], ")"));
    } else {
        body = RenderDirectDeferCallFromGraph(sequence.arena, root);
    }
    let out: String = Concat(indent, "Defer:\n");
    out = Concat(out, Concat(indent, "  Block:\n"));
    return Concat(
        out,
        Concat(indent, Concat("    ", Concat(body, "\n")))
    );
}

func RenderStmtFromFacts(kind: String, source_type: String,
                         arg0: String, expr0: String, expr1: String,
                         local_type: String) -> String {
    let value: String = expr0;
    if kind == "return" {
        return Concat("Return: ", value);
    }
    if kind == "assign" {
        if StringLength(expr0) > 0 && StringLength(expr1) > 0 {
            return Concat("Assign: ", Concat(expr0, Concat(" = ", expr1)));
        }
        MirLowerFailClosed("assignment instruction is missing target/value MIR facts");
        return "";
    }
    if kind == "def" {
        if source_type == "AST_LET_DECL"
            && StringLength(arg0) > 0
            && StringLength(local_type) > 0
            && StringLength(expr0) > 0 {
            return Concat("Let: ", Concat(arg0, Concat(" : ", Concat(local_type, Concat(" = ", expr0)))));
        }
        if StringLength(expr1) > 0 && StringLength(expr0) > 0 {
            return Concat("Assign: ", Concat(expr1, Concat(" = ", expr0)));
        }
        return Concat("Assign: ", value);
    }
    if kind == "stmt" && source_type == "AST_CALL" && arg0 == "" &&
        value != "" {
        return Concat("Call: ", value);
    }
    return StmtToTreeLine(value);
}
