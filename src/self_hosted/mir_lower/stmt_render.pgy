// MIR instruction facts -> AST-tree statement rendering owner.

import "error_owner.pgy";
import "json_fact_read.pgy";
import "destructure_temporary_owner.pgy";
import "expression_graph_sequence_owner.pgy";
import "structured_expression_emission_order_owner.pgy";

func RenderDestructureFromFactsWithExpressionOrder(
    json: String,
    inst_start: Int,
    inst_end: Int,
    indent: String,
    expr0: String,
    ref routines: MirProgramRoutineIndex,
    global_instruction_row: Int,
    inout expression_order: MirStructuredExpressionEmissionOrder
) -> String {
    let init: String = StringTrim(expr0);
    let elem_type: String = MirObjectStringFactAtBounds(
        json, inst_start, inst_end, "destructure_element_type"
    );
    if StringLength(init) == 0 {
        MirLowerFailClosed("destructure instruction is missing initializer fact");
    }
    if StringLength(elem_type) == 0 || elem_type == "Unknown" {
        MirLowerFailClosed(Concat("destructure initializer element type is unknown: ", init));
    }
    let bindings: Array<String> = [];
    let binding_bounds: Array<Int> = [0, 0];
    if !MirObjectArrayBoundsAtBounds(
            json, inst_start, inst_end, "destructure_bindings", binding_bounds
        ) ||
        !JsonArrayStringsWithin(
            json, binding_bounds[0], binding_bounds[1], bindings
        ) {
        MirLowerFailClosed("destructure instruction is missing binding-name facts");
    }
    if ArrayLength(bindings) == 0 {
        MirLowerFailClosed("destructure instruction has no binding-name facts");
    }
    let checked: Int = 0;
    while checked < ArrayLength(bindings) {
        if bindings[checked] == "" {
            MirLowerFailClosed(Concat(
                "destructure binding-name fact is empty at index ",
                ToString(checked)
            ));
        }
        checked = checked + 1;
    }

    let lines: Array<String> = [];
    let source: String = init;
    let ordinal_base: Int = 0;
    // destructure_temporary_owner.pgy decides the temporary; "" reads the
    // initializer in place.
    let temporary: Option<String> = MirDestructureTemporaryAt(
        routines, global_instruction_row, bindings[0]);
    if !IsSome(temporary) {
        MirLowerFailClosed("destructure temporary cannot be decided from its facts");
    }
    if UnwrapOption(temporary) != "" {
        source = UnwrapOption(temporary);
        let temp_line: Array<String> = [
            indent, "Let: ", source, " : Array<", elem_type, "> = ", init, "\n"
        ];
        ArrayPush(lines, StringJoin(temp_line, ""));
        if !MirStructuredExpressionEmissionOrderAppend(
            expression_order, global_instruction_row,
            AstExpressionLaneValue(), 0
        ) {
            MirLowerFailClosed(
                "destructure temporary expression occurrence is invalid"
            );
        }
        ordinal_base = 1;
    }

    let index: Int = 0;
    while index < ArrayLength(bindings) {
        let name: String = bindings[index];
        let binding_line: Array<String> = [
            indent, "Let: ", name, " : ", elem_type, " = ",
            source, "[", ToString(index), "]\n"
        ];
        ArrayPush(lines, StringJoin(binding_line, ""));
        if !MirStructuredExpressionEmissionOrderAppend(
            expression_order, global_instruction_row,
            AstExpressionLaneValue(), ordinal_base + index
        ) {
            MirLowerFailClosed(
                "destructure binding expression occurrence is invalid"
            );
        }
        index = index + 1;
    }
    return StringJoin(lines, "");
}

// Convert one fact-rendered statement text to its AST-tree line. `Log(...)` and
// bare calls pass through unchanged; `let NAME: T = V` becomes
// `Let: NAME : T = V`. A `let` whose first `:` does not separate a name from a
// type before the `=` is rejected instead of splitting inside the value.
func StmtToTreeLine(stmt: String) -> String {
    let s: String = StringTrim(stmt);
    if StringLength(s) < 4 || Substring(s, 0, 4) != "let " { return s; }
    let rest: String = Substring(s, 4, StringLength(s) - 4);
    let colon: Int = StringIndexOf(rest, ":");
    let equals: Int = StringIndexOf(rest, "=");
    if colon <= 0 || equals < 0 || equals < colon {
        MirLowerFailClosed(Concat("let without type annotation: ", s));
    }
    let name: String = StringTrim(Substring(rest, 0, colon));
    let after: String = StringTrim(Substring(rest, colon + 1, StringLength(rest) - (colon + 1)));
    return Concat("Let: ", Concat(name, Concat(" : ", after)));
}

func MirDeclaredLocalTypeFact(
    kind: String, source_type: String, abi_type_name: String
) -> String {
    if kind != "def" || source_type != "AST_LET_DECL" { return ""; }
    if StringLength(abi_type_name) == 0 {
        MirLowerFailClosed("local declaration is missing its MIR ABI type fact");
    }
    return abi_type_name;
}

func RenderDirectDeferCallFromGraph(
    ref arena: SemanticExpressionGraphArena,
    root: Int
) -> String {
    let node_count: Int = ArrayLength(arena.topology.node_kinds);
    if ArrayLength(arena.node_texts) != node_count ||
        ArrayLength(arena.topology.left_children) != node_count ||
        ArrayLength(arena.topology.right_children) != node_count ||
        ArrayLength(arena.call_target_kinds) != node_count ||
        ArrayLength(arena.call_target_names) != node_count {
        MirLowerFailClosed("defer body graph arena columns disagree in length");
    }
    let arguments: Array<String> = [];
    let call_node: Int = root;
    let steps: Int = 0;
    while call_node >= 0 && call_node < node_count &&
        arena.topology.node_kinds[call_node] ==
            AstExpressionNodeCallArgument() {
        if steps >= node_count {
            MirLowerFailClosed("defer body graph call-argument chain is cyclic");
        }
        steps = steps + 1;
        let argument_node: Int = arena.topology.right_children[call_node];
        if argument_node < 0 || argument_node >= node_count ||
            arena.node_texts[argument_node] == "" {
            MirLowerFailClosed("defer body graph has an invalid call argument fact");
        }
        ArrayPush(arguments, arena.node_texts[argument_node]);
        call_node = arena.topology.left_children[call_node];
    }
    if call_node < 0 || call_node >= node_count ||
        arena.topology.node_kinds[call_node] != AstExpressionNodeCall() ||
        arena.call_target_kinds[call_node] != SemanticCallTargetDirect() ||
        arena.call_target_names[call_node] == "" {
        MirLowerFailClosed("defer body graph has no direct call target fact");
    }
    let target: String = arena.call_target_names[call_node];
    let callee_node: Int = arena.topology.left_children[call_node];
    let empty_call: String = Concat(target, "()");
    if callee_node < 0 || callee_node >= node_count ||
        arena.topology.node_kinds[callee_node] != AstExpressionNodeLeaf() ||
        arena.node_texts[callee_node] != target ||
        arena.node_texts[call_node] != empty_call {
        MirLowerFailClosed(
            "defer body graph disagrees with direct call target fact"
        );
    }
    let body: String = Concat(target, "(");
    let i: Int = ArrayLength(arguments);
    while i > 0 {
        i = i - 1;
        if i + 1 < ArrayLength(arguments) { body = Concat(body, ", "); }
        body = Concat(body, arguments[i]);
    }
    body = Concat(body, ")");
    if arena.node_texts[root] != body {
        MirLowerFailClosed(
            "defer body graph disagrees with direct call target fact"
        );
    }
    return body;
}

// Defer bodies use the same statement spelling as the non-deferred path:
// `Log(...)` stays bare and a direct user call is tagged `Call: `, so the AST
// inventory classifies a call the same way inside and outside a defer block.
func RenderDeferFromFactsWithExpressionOrder(
    json: String,
    inst_start: Int,
    inst_end: Int,
    indent: String,
    arg0: String,
    global_instruction_row: Int,
    inout expression_order: MirStructuredExpressionEmissionOrder
) -> String {
    if arg0 != "Log" && arg0 != "Call" {
        MirLowerFailClosed("defer instruction has no typed body kind");
    }
    let instruction: JsonObjectFactTable = JsonObjectFactTableFromBounds(
        json, inst_start, inst_end
    );
    let graph: JsonObjectFactTable = JsonObjectFactObjectTable(
        instruction, "expr0_graph"
    );
    let sequence: MirExpressionGraphSequence =
        MirExpressionGraphSequenceAppend(
            MirExpressionGraphSequenceEmpty(), graph
        );
    if !sequence.ok || ArrayLength(sequence.roots) != 1 {
        MirLowerFailClosed(
            "MIR instruction expression graph is missing or invalid: defer typed body graph required"
        );
    }
    let root: Int = sequence.roots[0];
    if root < 0 || root >= ArrayLength(sequence.arena.node_texts) ||
        sequence.arena.node_texts[root] == "" {
        MirLowerFailClosed("defer body graph has no root expression");
    }
    let body: String = "";
    if arg0 == "Log" {
        body = Concat("Log(", Concat(sequence.arena.node_texts[root], ")"));
    } else {
        body = Concat(
            "Call: ", RenderDirectDeferCallFromGraph(sequence.arena, root)
        );
    }
    if !MirStructuredExpressionEmissionOrderAppend(
        expression_order, global_instruction_row,
        AstExpressionLaneAtom(), 0
    ) {
        MirLowerFailClosed("defer expression occurrence is invalid");
    }
    let lines: Array<String> = [
        indent, "Defer:\n",
        indent, "  Block:\n",
        indent, "    ", body, "\n"
    ];
    return StringJoin(lines, "");
}

// Render one non-structural MIR statement row. Every accepted kind has an
// explicit spelling; a row that reaches here without its required facts, or
// with a kind that has no statement form, stops lowering instead of being
// reclassified (for example a nameless `let` becoming an assignment).
func RenderStmtFromFacts(kind: String, source_type: String,
                         arg0: String, expr0: String, expr1: String,
                         local_type: String) -> String {
    if expr0 == "" {
        MirLowerFailClosed(Concat(kind, " instruction is missing its expr0 statement fact"));
    }
    if kind == "return" {
        return Concat("Return: ", expr0);
    }
    if kind == "assign" {
        if expr1 == "" {
            MirLowerFailClosed("assignment instruction is missing target/value MIR facts");
        }
        let assign_parts: Array<String> = ["Assign: ", expr0, " = ", expr1];
        return StringJoin(assign_parts, "");
    }
    if kind == "def" && source_type == "AST_LET_DECL" {
        if arg0 == "" {
            MirLowerFailClosed(Concat("local declaration is missing its binding-name fact: ", expr0));
        }
        if local_type == "" {
            MirLowerFailClosed("local declaration is missing its MIR ABI type fact");
        }
        let let_parts: Array<String> = ["Let: ", arg0, " : ", local_type, " = ", expr0];
        return StringJoin(let_parts, "");
    }
    if kind == "def" {
        if expr1 == "" {
            MirLowerFailClosed(Concat("definition is missing its assignment target fact: ", expr0));
        }
        let def_parts: Array<String> = ["Assign: ", expr1, " = ", expr0];
        return StringJoin(def_parts, "");
    }
    if kind != "stmt" {
        MirLowerFailClosed(Concat("instruction kind has no statement rendering: ", kind));
    }
    if source_type == "AST_CALL" && arg0 == "" {
        return Concat("Call: ", expr0);
    }
    return StmtToTreeLine(expr0);
}
