// Self-host parser source cursor and token-read owner.

import "error_owner.pgy";

func ParserCharAt(s: String, i: Int) -> String {
    let n: Int = StringLength(s);
    if i < 0 {
        return "";
    }
    if i >= n {
        return "";
    }
    return Substring(s, i, 1);
}

func IsAlpha(c: String) -> Bool {
    if StringLength(c) != 1 {
        return false;
    }
    let chars: String = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_";
    return StringIndexOf(chars, c) >= 0;
}

func IsDigit(c: String) -> Bool {
    if StringLength(c) != 1 {
        return false;
    }
    let digits: String = "0123456789";
    return StringIndexOf(digits, c) >= 0;
}

func IsAlphaNum(c: String) -> Bool {
    if !IsAlpha(c) {
        let digits: String = "0123456789";
        if StringLength(c) != 1 {
            return false;
        }
        return StringIndexOf(digits, c) >= 0;
    }
    return true;
}

func SkipWhitespaceAndComments(content: String, start: Int) -> Int {
    let n: Int = StringLength(content);
    let i: Int = start;
    while i < n {
        let c: String = ParserCharAt(content, i);
        if c == " " || c == "\t" || c == "\n" || c == "\r" {
            i = i + 1;
            continue;
        }
        if c == "/" && ParserCharAt(content, i + 1) == "/" {
            while i < n && ParserCharAt(content, i) != "\n" {
                i = i + 1;
            }
            continue;
        }
        if c == "/" && ParserCharAt(content, i + 1) == "*" {
            i = i + 2;
            while i < n {
                if ParserCharAt(content, i) == "*" && ParserCharAt(content, i + 1) == "/" {
                    i = i + 2;
                    break;
                }
                i = i + 1;
            }
            continue;
        }
        return i;
    }
    return i;
}

// Read an identifier (sequence of alphanum/underscore). Returns the
// identifier text; advances the cursor by storing in an out-array of 1.
func ReadIdent(content: String, start: Int, inout cursor_out: Array<Int>) -> String {
    let n: Int = StringLength(content);
    let i: Int = start;
    while i < n && IsAlphaNum(ParserCharAt(content, i)) {
        i = i + 1;
    }
    ArraySet(cursor_out, 0, i);
    return Substring(content, start, i - start);
}

// True if the `len` chars at `i` exactly match `kw` and the byte right after
// is not a word char, so `else` matches but `elsewhere` does not.
func MatchKeyword(content: String, i: Int, kw: String) -> Bool {
    let n: Int = StringLength(content);
    let kl: Int = StringLength(kw);
    if i + kl > n {
        return false;
    }
    if Substring(content, i, kl) != kw {
        return false;
    }
    if i + kl == n {
        return true;
    }
    let next: String = ParserCharAt(content, i + kl);
    return !IsAlphaNum(next);
}

// Read a numeric literal (integer or float). Returns the text as the
// C printer emits it: trailing zeros after the decimal point are
// trimmed, and a bare trailing `.` is dropped - so `2.0` lexes to `2`,
// `1.50` to `1.5`, and `3.14` stays `3.14`. Only consumes the `.` when
// followed by a digit, so `0..10` lexes as `0`, `..`, `10`.
func ReadNumber(content: String, start: Int, inout cursor_out: Array<Int>) -> String {
    let n: Int = StringLength(content);
    let i: Int = start;
    while i < n && IsDigit(ParserCharAt(content, i)) {
        i = i + 1;
    }
    let has_frac: Bool = false;
    let frac_start: Int = 0;
    if i + 1 < n && ParserCharAt(content, i) == "." && IsDigit(ParserCharAt(content, i + 1)) {
        has_frac = true;
        frac_start = i;
        i = i + 1;
        while i < n && IsDigit(ParserCharAt(content, i)) {
            i = i + 1;
        }
    }
    ArraySet(cursor_out, 0, i);
    let text: String = Substring(content, start, i - start);
    if has_frac {
        // dot_idx in `text` is (frac_start - start).
        let dot_idx: Int = frac_start - start;
        let trim_to: Int = StringLength(text);
        while trim_to > dot_idx + 1 && Substring(text, trim_to - 1, 1) == "0" {
            trim_to = trim_to - 1;
        }
        if trim_to == dot_idx + 1 {
            trim_to = dot_idx;
        }
        text = Substring(text, 0, trim_to);
    } else if StringLength(text) > 6 && ParserCharAt(text, 0) == "1" {
        let all_zero_tail: Bool = true;
        let zi: Int = 1;
        while zi < StringLength(text) {
            if ParserCharAt(text, zi) != "0" {
                all_zero_tail = false;
            }
            zi = zi + 1;
        }
        if all_zero_tail {
            let exp_text: String = ToString(StringLength(text) - 1);
            if StringLength(exp_text) == 1 {
                exp_text = Concat("0", exp_text);
            }
            return Concat("1e+", exp_text);
        }
    }
    return text;
}

// Read a literal string including the surrounding double-quotes.
func ReadString(content: String, start: Int, inout cursor_out: Array<Int>) -> String {
    let n: Int = StringLength(content);
    let i: Int = start + 1;
    while i < n {
        if ParserCharAt(content, i) == "\\" {
            i = i + 1;
            if i < n {
                i = i + 1;
            }
            continue;
        }
        if ParserCharAt(content, i) == "\"" {
            break;
        }
        i = i + 1;
    }
    if i < n {
        i = i + 1;
    }
    ArraySet(cursor_out, 0, i);
    return Substring(content, start, i - start);
}

// Expect the literal `tok` at the cursor, skipping leading whitespace/comments.
func ExpectOpt(content: String, start: Int, tok: String) -> Option<Int> {
    let i: Int = SkipWhitespaceAndComments(content, start);
    let tlen: Int = StringLength(tok);
    let n: Int = StringLength(content);
    if i + tlen > n {
        return None;
    }
    let slice: String = Substring(content, i, tlen);
    if slice != tok {
        return None;
    }
    return Some(i + tlen);
}

func Expect(content: String, start: Int, tok: String) -> Int {
    let next: Option<Int> = ExpectOpt(content, start, tok);
    if IsSome(next) {
        return UnwrapOption(next);
    }
    Fail(Concat("expected token `", Concat(tok, "`")), content, start);
    return start;
}

func ConsumeStmtTerminatorOpt(content: String, start: Int) -> Option<Int> {
    let n: Int = StringLength(content);
    let i: Int = start;
    while i < n {
        let c: String = ParserCharAt(content, i);
        if c == " " || c == "\t" || c == "\r" {
            i = i + 1;
            continue;
        }
        if c == ";" {
            return Some(i + 1);
        }
        if c == "\n" {
            return Some(i + 1);
        }
        if c == "}" {
            return Some(i);
        }
        if c == "/" && ParserCharAt(content, i + 1) == "/" {
            while i < n && ParserCharAt(content, i) != "\n" {
                i = i + 1;
            }
            return Some(i);
        }
        break;
    }
    return None;
}

func ConsumeStmtTerminator(content: String, start: Int) -> Int {
    let next: Option<Int> = ConsumeStmtTerminatorOpt(content, start);
    if IsSome(next) {
        return UnwrapOption(next);
    }
    Fail("expected statement terminator", content, start);
    return start;
}
