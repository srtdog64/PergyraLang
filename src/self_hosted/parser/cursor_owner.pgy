// Self-host parser source cursor and token-read owner.

import "error_owner.pgy";
import "../lib/source_scan_owner.pgy";

func ParserCharAt(s: String, i: Int) -> String {
    let n: Int = StringLength(s);
    if i < 0 {
        return "";
    }
    if i >= n {
        return "";
    }
    return CharAtN(s, n, i);
}

// Read an identifier (sequence of alphanum/underscore). Returns the
// identifier text; advances the cursor by storing in an out-array of 1.
func ReadIdent(content: String, start: Int, inout cursor_out: Array<Int>) -> String {
    let n: Int = StringLength(content);
    let i: Int = start;
    while i < n && SourceByteIsAlphaNum(SourceByteAt(content, n, i)) {
        i = i + 1;
    }
    ArraySet(cursor_out, 0, i);
    return Substring(content, start, i - start);
}

// True if the `len` chars at `i` exactly match `kw` and the byte right after
// is not a word char, so `else` matches but `elsewhere` does not.
func MatchKeyword(content: String, i: Int, kw: String) -> Bool {
    let n: Int = StringLength(content);
    let kl: Int = StringLength(kw);
    if i + kl > n {
        return false;
    }
    if !SubEqualsWithLen(content, n, i, kl, kw) {
        return false;
    }
    if i + kl == n {
        return true;
    }
    return !SourceByteIsAlphaNum(SourceByteAt(content, n, i + kl));
}

// Read a numeric literal (integer or float). Returns the text as the
// C printer emits it: trailing zeros after the decimal point are
// trimmed while one fractional zero preserves Float kind - so `2.0`
// stays `2.0`,
// `1.50` to `1.5`, and `3.14` stays `3.14`. Only consumes the `.` when
// followed by a digit, so `0..10` lexes as `0`, `..`, `10`.
func ReadNumber(content: String, start: Int, inout cursor_out: Array<Int>) -> String {
    let n: Int = StringLength(content);
    let i: Int = start;
    while i < n && SourceByteIsDigit(SourceByteAt(content, n, i)) {
        i = i + 1;
    }
    let has_frac: Bool = false;
    let frac_start: Int = 0;
    if i + 1 < n && SourceByteAt(content, n, i) == SourceByteOf(".") &&
        SourceByteIsDigit(SourceByteAt(content, n, i + 1)) {
        has_frac = true;
        frac_start = i;
        i = i + 1;
        while i < n && SourceByteIsDigit(SourceByteAt(content, n, i)) {
            i = i + 1;
        }
    }
    ArraySet(cursor_out, 0, i);
    let text: String = Substring(content, start, i - start);
    if has_frac {
        // dot_idx in `text` is (frac_start - start).
        let dot_idx: Int = frac_start - start;
        let trim_to: Int = StringLength(text);
        let text_len: Int = StringLength(text);
        while trim_to > dot_idx + 1 &&
            SourceByteAt(text, text_len, trim_to - 1) == SourceByteOf("0") {
            trim_to = trim_to - 1;
        }
        if trim_to == dot_idx + 1 {
            return Concat(Substring(text, 0, dot_idx), ".0");
        }
        text = Substring(text, 0, trim_to);
    }
    return text;
}

func ParserNumberSpellingContractReady() -> Bool {
    let cursor: Array<Int> = [0];
    if ReadNumber("16.0", 0, cursor) != "16.0" || cursor[0] != 4 {
        return false;
    }
    ArraySet(cursor, 0, 0);
    if ReadNumber("1.50", 0, cursor) != "1.5" || cursor[0] != 4 {
        return false;
    }
    ArraySet(cursor, 0, 0);
    if ReadNumber("16", 0, cursor) != "16" || cursor[0] != 2 {
        return false;
    }
    ArraySet(cursor, 0, 0);
    return ReadNumber("1000000", 0, cursor) == "1000000" &&
        cursor[0] == 7;
}

// Read a literal string including the surrounding double-quotes.
func ReadString(content: String, start: Int, inout cursor_out: Array<Int>) -> String {
    let n: Int = StringLength(content);
    let i: Int = start + 1;
    while i < n {
        if SourceByteAt(content, n, i) == SourceByteOf("\\") {
            i = i + 1;
            if i < n {
                i = i + 1;
            }
            continue;
        }
        if SourceByteAt(content, n, i) == SourceByteOf("\"") {
            break;
        }
        i = i + 1;
    }
    if i < n {
        i = i + 1;
    }
    ArraySet(cursor_out, 0, i);
    return Substring(content, start, i - start);
}

// Expect the literal `tok` at the cursor, skipping leading whitespace/comments.
func ExpectOpt(content: String, start: Int, tok: String) -> Option<Int> {
    let i: Int = SkipWhitespaceAndComments(content, start);
    let tlen: Int = StringLength(tok);
    let n: Int = StringLength(content);
    if i + tlen > n {
        return None;
    }
    if !SubEqualsWithLen(content, n, i, tlen, tok) {
        return None;
    }
    return Some(i + tlen);
}

func Expect(content: String, start: Int, tok: String) -> Int {
    let next: Option<Int> = ExpectOpt(content, start, tok);
    if IsSome(next) {
        return UnwrapOption(next);
    }
    Fail(Concat("expected token `", Concat(tok, "`")), content, start);
    return start;
}

func ConsumeStmtTerminatorOpt(content: String, start: Int) -> Option<Int> {
    let n: Int = StringLength(content);
    let i: Int = start;
    while i < n {
        let c: Int = SourceByteAt(content, n, i);
        if c == SourceByteOf(" ") || c == SourceByteOf("\t") ||
            c == SourceByteOf("\r") {
            i = i + 1;
            continue;
        }
        if c == SourceByteOf(";") {
            return Some(i + 1);
        }
        if c == SourceByteOf("\n") {
            return Some(i + 1);
        }
        if c == SourceByteOf("}") {
            return Some(i);
        }
        if c == SourceByteOf("/") &&
            SourceByteAt(content, n, i + 1) == SourceByteOf("/") {
            while i < n && SourceByteAt(content, n, i) != SourceByteOf("\n") {
                i = i + 1;
            }
            return Some(i);
        }
        break;
    }
    return None;
}

func ConsumeStmtTerminator(content: String, start: Int) -> Int {
    let next: Option<Int> = ConsumeStmtTerminatorOpt(content, start);
    if IsSome(next) {
        return UnwrapOption(next);
    }
    Fail("expected statement terminator", content, start);
    return start;
}
