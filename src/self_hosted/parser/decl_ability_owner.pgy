// Self-host parser ability declaration owner.

import "cursor_owner.pgy";
import "tree_text_owner.pgy";
import "type_name_owner.pgy";
import "function_decl_owner.pgy";
import "generic_parameter_list_owner.pgy";

// `ability NAME { func SIG; ... }` declares an interface-shaped collection of
// function signatures. AST emits as `  [export] Ability: NAME`.
func ParseAbilityDecl(
    content: String,
    start: Int,
    inout cursor_out: Array<Int>,
    decl_prefix: String,
    inout expression_graphs: Array<AstExpressionGraphRows>
) -> String {
    let i: Int = start + 7;
    let n: Int = StringLength(content);
    i = SkipWhitespaceAndComments(content, i);
    ArraySet(cursor_out, 0, i);
    let ab_name: String = ReadIdent(content, i, cursor_out);
    i = cursor_out[0];
    if StringLength(ab_name) == 0 {
        Exit(1);
    }
    ArraySet(cursor_out, 0, i);
    let generic_parameters: String = ParseGenericParameterListText(
        content, i, cursor_out
    );
    i = cursor_out[0];
    if generic_parameters != "" {
        ab_name = Concat(ab_name, generic_parameters);
    }
    let constraint_clause: String = "";
    i = SkipWhitespaceAndComments(content, i);
    if MatchKeyword(content, i, "where") {
        let where_start: Int = i;
        while i < n && ParserCharAt(content, i) != "{" {
            i = i + 1;
        }
        constraint_clause = StringTrim(Substring(
            content, where_start, i - where_start
        ));
    }
    i = Expect(content, i, "{");
    if i < 0 {
        Exit(1);
    }
    let sig_blocks: String = "";
    while true {
        i = SkipWhitespaceAndComments(content, i);
        if i >= n {
            Exit(1);
        }
        if ParserCharAt(content, i) == "}" {
            i = i + 1;
            break;
        }
        if MatchKeyword(content, i, "fields") {
            i = i + 6;
            i = SkipWhitespaceAndComments(content, i);
            ArraySet(cursor_out, 0, i);
            let req_name: String = ReadIdent(content, i, cursor_out);
            i = cursor_out[0];
            if StringLength(req_name) == 0 {
                Exit(1);
            }
            i = Expect(content, i, ":");
            if i < 0 {
                Exit(1);
            }
            ArraySet(cursor_out, 0, i);
            let req_type: String = ReadType(content, i, cursor_out);
            i = cursor_out[0];
            if StringLength(req_type) == 0 {
                Exit(1);
            }
            i = ConsumeStmtTerminator(content, i);
            if i < 0 {
                Exit(1);
            }
            sig_blocks = AppendLine(sig_blocks, Concat("    Require: ", Concat(req_name, Concat(": ", req_type))));
            continue;
        }
        if !MatchKeyword(content, i, "func") {
            Exit(1);
        }
        ArraySet(cursor_out, 0, i);
        let sig: String = ParseFunction(
            content, i, cursor_out, "", false, 4, "func", "Function: ",
            true, "", expression_graphs
        );
        i = cursor_out[0];
        sig_blocks = AppendLine(sig_blocks, sig);
    }
    let ability_out: String = Concat("  [export] Ability: ", Concat(decl_prefix, ab_name));
    if generic_parameters != "" {
        ability_out = AppendLine(
            ability_out,
            Concat("    Generic params: ", generic_parameters)
        );
    }
    if constraint_clause != "" {
        ability_out = AppendLine(
            ability_out,
            Concat("    Constraints: ", constraint_clause)
        );
    }
    if StringLength(sig_blocks) > 0 {
        ability_out = AppendLine(ability_out, sig_blocks);
    }
    ArraySet(cursor_out, 0, i);
    return ability_out;
}
