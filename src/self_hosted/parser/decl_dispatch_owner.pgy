// Self-host parser top-level declaration dispatch owner.

import "../lib/path.pgy";
import "cursor_owner.pgy";
import "source_path_owner.pgy";
import "tree_text_owner.pgy";
import "stmt_owner.pgy";
import "function_decl_owner.pgy";
import "decl_type_owner.pgy";
import "decl_ability_owner.pgy";
import "decl_event_owner.pgy";
import "decl_enum_owner.pgy";
import "decl_zone_owner.pgy";
import "decl_effect_relation_owner.pgy";
import "decl_role_owner.pgy";
import "decl_intent_owner.pgy";
import "decl_nominal_owner.pgy";
import "diagnostic_owner.pgy";
import "source_location_observation_owner.pgy";

// Imported-module visibility is a token fact, not a substring fact. Comments
// and string literals may legitimately contain the word `export`; treating
// either as a declaration modifier would rename every ordinary declaration in
// the module and leave its type references pointing at a different identity.
func ParserImportedSourceHasExplicitExport(content: String) -> Bool {
    let n: Int = StringLength(content);
    let cursor: Array<Int> = [0];
    let i: Int = 0;
    while i < n {
        i = SkipWhitespaceAndCommentsWithin(content, n, i);
        if i >= n {
            return false;
        }
        if SourceByteAt(content, n, i) == SourceByteOf("\"") {
            ArraySet(cursor, 0, i);
            ReadString(content, i, cursor);
            if cursor[0] <= i {
                return false;
            }
            i = cursor[0];
            continue;
        }
        if MatchLanguageWord(content, i, LanguageWordId.WordExport) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Parse zero or more top-level declarations. `name_prefix` is prepended
// to each emitted decl name and is non-empty inside `namespace` blocks
// (e.g. `Math_` for `namespace Math { ... }`, `Outer_Inner_` for nested
// namespaces). When `until_brace` is true, parsing stops at `}` (used
// by the namespace branch); otherwise it stops at EOF.
func ParseDeclsInto(
    content: String,
    start: Int,
    inout cursor_out: Array<Int>,
    name_prefix: String,
    until_brace: Bool,
    source_dir: String,
    source_path: String,
    force_export: Bool,
    follow_imports: Bool,
    within_zone: String,
    inout involve_types: Array<String>,
    inout import_paths: Set<String>,
    inout expression_graphs: Array<AstExpressionGraphRows>,
    inout script_graphs: Array<AstExpressionGraphRows>,
    inout source_locations: Array<ParserSourceLocationObservation>,
    inout script_source_locations: Array<ParserSourceLocationObservation>,
    inout out_blocks: Array<String>,
    inout out_module_paths: Array<String>,
    inout script_blocks: Array<String>
) -> Void {
    let location_context: ParserSourceLocationContext =
        ParserSourceLocationContextFromSource(source_path, content);
    let i: Int = start;
    let n: Int = StringLength(content);
    let active_within_zone: String = within_zone;
    let collect_script: Bool = !until_brace && !force_export && StringLength(name_prefix) == 0 && StringLength(active_within_zone) == 0;

    let is_imported: Bool = StringIndexOf(content, "__imported__") >= 0;
    let has_exports: Bool = is_imported &&
        ParserImportedSourceHasExplicitExport(content);

    while true {
        i = SkipWhitespaceAndComments(content, i);
        if until_brace {
            if i >= n {
                Exit(1);
            }
            if ParserCharAt(content, i) == "}" {
                i = i + 1;
                ArraySet(cursor_out, 0, i);
                break;
            }
        } else {
            if i >= n {
                ArraySet(cursor_out, 0, i);
                break;
            }
        }

        // `import "PATH.pgy";` — read the referenced file (relative to
        // the source's directory), parse it as a sub-document, and
        // inline its decls here. The C parser treats all top-level
        // functions in an imported file as exported, so we pass
        // `force_export=true` into the recursive call so each emitted
        // function gets `[export] Function:`.
        if MatchLanguageWord(content, i, LanguageWordId.WordImport) {
            i = LanguageWordEnd(i, LanguageWordId.WordImport);
            i = SkipWhitespaceAndComments(content, i);
            if ParserCharAt(content, i) != "\"" {
                Exit(1);
            }
            ArraySet(cursor_out, 0, i);
            let raw_path: String = ReadString(content, i, cursor_out);
            i = cursor_out[0];
            i = Expect(content, i, ";");
            if i < 0 {
                Exit(1);
            }
            // Strip the leading and trailing `"` from raw_path.
            let rp_len: Int = StringLength(raw_path);
            let imp_rel: String = Substring(raw_path, 1, rp_len - 2);
            if follow_imports {
                let imp_path: String = SelfHostPath.NormalizeImportRelative(source_dir, imp_rel);
                if ParserImportGraphSeen(import_paths, imp_path) {
                    continue;
                }
                SetAdd(import_paths, imp_path);
                let imp_content: String = ParserReadImportedSource(imp_path);
                let imp_dir: String = SelfHostPath.Dirname(imp_path);
                let imp_cursor: Array<Int> = [0];
                ParseDeclsInto(
                    imp_content, 0, imp_cursor, name_prefix, false, imp_dir,
                    imp_path, true, true, active_within_zone, involve_types,
                    import_paths, expression_graphs, script_graphs,
                    source_locations, script_source_locations,
                    out_blocks, out_module_paths, script_blocks
                );
            }
            continue;
        }

        // `namespace NAME { ... }` recurses with a deeper prefix and
        // inlines the resulting decls; the namespace itself emits no
        // wrapper AST node.
        if MatchLanguageWord(content, i, LanguageWordId.WordNamespace) {
            i = LanguageWordEnd(i, LanguageWordId.WordNamespace);
            i = SkipWhitespaceAndComments(content, i);
            ArraySet(cursor_out, 0, i);
            let ns_name: String = ReadIdent(content, i, cursor_out);
            i = cursor_out[0];
            if StringLength(ns_name) == 0 {
                Exit(1);
            }
            i = Expect(content, i, "{");
            if i < 0 {
                Exit(1);
            }
            let new_prefix: String = Concat(name_prefix, Concat(ns_name, "_"));
            ArraySet(cursor_out, 0, i);
            ParseDeclsInto(
                content, i, cursor_out, new_prefix, true, source_dir,
                source_path, force_export, follow_imports, active_within_zone,
                involve_types, import_paths, expression_graphs, script_graphs,
                source_locations, script_source_locations,
                out_blocks, out_module_paths, script_blocks
            );
            i = cursor_out[0];
            continue;
        }

        // `within ZONE { ... }` parses the body recursively but binds
        // the zone name as `within_zone` for all nested actions/functions.
        if MatchLanguageWord(content, i, LanguageWordId.WordWithin) {
            i = LanguageWordEnd(i, LanguageWordId.WordWithin);
            i = SkipWhitespaceAndComments(content, i);
            ArraySet(cursor_out, 0, i);
            let wz_name: String = ReadIdent(content, i, cursor_out);
            i = cursor_out[0];
            if StringLength(wz_name) == 0 {
                Exit(1);
            }
            i = Expect(content, i, "{");
            if i < 0 {
                Exit(1);
            }
            ArraySet(cursor_out, 0, i);
            ParseDeclsInto(
                content, i, cursor_out, name_prefix, true, source_dir,
                source_path, force_export, follow_imports, wz_name, involve_types,
                import_paths, expression_graphs, script_graphs,
                source_locations, script_source_locations,
                out_blocks, out_module_paths, script_blocks
            );
            i = cursor_out[0];
            continue;
        }

        // Surfaces the native parser accepts but this parser does not cover
        // yet. Refusing them here with a named diagnostic keeps the failure
        // at the layer that owns it; falling through to statement parsing
        // reported "expected statement terminator", which reads as a syntax
        // bug in the source rather than a coverage gap in this compiler.
        // `use` and `extern` are reserved words, so the word alone decides.
        // `lifecycle` is contextual, so it only counts as this surface when
        // the declaration shape (`lifecycle NAME {`) follows -- a plain
        // identifier spelled lifecycle still parses as a statement.
        if MatchLanguageWord(content, i, LanguageWordId.WordUse) {
            ParseDiagnosticReportUncoveredSurface("use");
            Exit(1);
        }

        // `extern "ABI" { func NAME(params) -> Type; ... }` declares host
        // functions with no Pergyra body. The native printer emits the block
        // header with the ABI name and nests each signature one level deeper
        // than a top-level func, so members parse at base_indent=4 with
        // is_signature=true -- the same proven shape ability members use.
        if MatchLanguageWord(content, i, LanguageWordId.WordExtern) {
            i = LanguageWordEnd(i, LanguageWordId.WordExtern);
            i = SkipWhitespaceAndComments(content, i);
            if ParserCharAt(content, i) != "\"" {
                Exit(1);
            }
            ArraySet(cursor_out, 0, i);
            let raw_abi: String = ReadString(content, i, cursor_out);
            i = cursor_out[0];
            let abi_len: Int = StringLength(raw_abi);
            if abi_len < 2 {
                Exit(1);
            }
            let abi_name: String = Substring(raw_abi, 1, abi_len - 2);
            i = Expect(content, i, "{");
            if i < 0 {
                Exit(1);
            }
            let extern_out: String = Concat("  Extern Block (", Concat(abi_name, "):"));
            while true {
                i = SkipWhitespaceAndComments(content, i);
                if i >= n {
                    Exit(1);
                }
                if ParserCharAt(content, i) == "}" {
                    i = i + 1;
                    break;
                }
                if !MatchLanguageWord(content, i, LanguageWordId.WordFunc) {
                    Exit(1);
                }
                ArraySet(cursor_out, 0, i);
                // ABI names are never namespaced: the member's C symbol is
                // the declared name itself, so no decl prefix applies.
                let extern_sig: String = ParseFunction(
                    content, i, cursor_out, "", false, 4,
                    "func", "Function: ", true, "", expression_graphs
                );
                i = cursor_out[0];
                extern_out = AppendLine(extern_out, extern_sig);
            }
            ArrayPush(out_blocks, extern_out);
            ArrayPush(out_module_paths, source_path);
            continue;
        }
        if MatchLanguageWord(content, i, LanguageWordId.WordLifecycle) {
            let lc_probe: Int = LanguageWordEnd(i, LanguageWordId.WordLifecycle);
            lc_probe = SkipWhitespaceAndComments(content, lc_probe);
            let lc_cursor: Array<Int> = [lc_probe];
            let lc_name: String = ReadIdent(content, lc_probe, lc_cursor);
            lc_probe = SkipWhitespaceAndComments(content, lc_cursor[0]);
            if StringLength(lc_name) > 0 && ParserCharAt(content, lc_probe) == "{" {
                ParseDiagnosticReportUncoveredSurface("lifecycle");
                Exit(1);
            }
        }

        // Optional top-level visibility prefix on the next declaration.
        // Native AST identity maps both `export` and `public` to `[export]`;
        // `private` is explicit but carries the ordinary non-export shape.
        let is_export: Bool = false;
        if MatchLanguageWord(content, i, LanguageWordId.WordExport) ||
            MatchLanguageWord(content, i, LanguageWordId.WordPublic) {
            if MatchLanguageWord(content, i, LanguageWordId.WordExport) {
                i = LanguageWordEnd(i, LanguageWordId.WordExport);
            } else {
                i = LanguageWordEnd(i, LanguageWordId.WordPublic);
            }
            i = SkipWhitespaceAndComments(content, i);
            is_export = true;
        } else if MatchLanguageWord(content, i, LanguageWordId.WordPrivate) {
            i = LanguageWordEnd(i, LanguageWordId.WordPrivate);
            i = SkipWhitespaceAndComments(content, i);
        }

        let effective_export: Bool = is_export;
        if force_export {
            if is_imported {
                if has_exports {
                    effective_export = is_export;
                } else {
                    effective_export = true;
                }
            } else {
                effective_export = true;
            }
        }

        let decl_prefix: String = name_prefix;
        if is_imported && has_exports && !is_export {
            decl_prefix = Concat("__imp0_", name_prefix);
        }

        if MatchLanguageWord(content, i, LanguageWordId.WordType) {
            let type_block: String = ParseTypeDecl(content, i, cursor_out, decl_prefix);
            i = cursor_out[0];
            ArrayPush(out_blocks, type_block);
            ArrayPush(out_module_paths, source_path);
            continue;
        }

        if MatchLanguageWord(content, i, LanguageWordId.WordAbility) {
            let ability_block: String = ParseAbilityDecl(
                content, i, cursor_out, decl_prefix, expression_graphs
            );
            i = cursor_out[0];
            ArrayPush(out_blocks, ability_block);
            ArrayPush(out_module_paths, source_path);
            continue;
        }

        if MatchLanguageWord(content, i, LanguageWordId.WordZone) {
            let zone_block: String = ParseZoneDecl(
                content, i, cursor_out, decl_prefix, involve_types,
                expression_graphs
            );
            i = cursor_out[0];
            ArrayPush(out_blocks, zone_block);
            ArrayPush(out_module_paths, source_path);
            continue;
        }


        if MatchLanguageWord(content, i, LanguageWordId.WordEffect) {
            let effect_block: String = ParseEffectDecl(content, i, cursor_out, decl_prefix);
            i = cursor_out[0];
            ArrayPush(out_blocks, effect_block);
            ArrayPush(out_module_paths, source_path);
            continue;
        }


        if MatchLanguageWord(content, i, LanguageWordId.WordRelation) {
            let relation_block: String = ParseRelationDecl(content, i, cursor_out, decl_prefix);
            i = cursor_out[0];
            ArrayPush(out_blocks, relation_block);
            ArrayPush(out_module_paths, source_path);
            continue;
        }


        if MatchLanguageWord(content, i, LanguageWordId.WordRole) {
            let role_block: String = ParseRoleDecl(
                content, i, cursor_out, decl_prefix, active_within_zone,
                expression_graphs
            );
            i = cursor_out[0];
            ArrayPush(out_blocks, role_block);
            ArrayPush(out_module_paths, source_path);
            continue;
        }


        if MatchLanguageWord(content, i, LanguageWordId.WordIntent) {
            let intent_block: String = ParseIntentDecl(
                content, i, cursor_out, decl_prefix, expression_graphs
            );
            i = cursor_out[0];
            ArrayPush(out_blocks, intent_block);
            ArrayPush(out_module_paths, source_path);
            continue;
        }


        if MatchLanguageWord(content, i, LanguageWordId.WordSubject) || MatchLanguageWord(content, i, LanguageWordId.WordClass) || MatchLanguageWord(content, i, LanguageWordId.WordVessel) || MatchLanguageWord(content, i, LanguageWordId.WordStruct) || MatchLanguageWord(content, i, LanguageWordId.WordObject) || MatchLanguageWord(content, i, LanguageWordId.WordTobject) || MatchLanguageWord(content, i, LanguageWordId.WordParty) || MatchLanguageWord(content, i, LanguageWordId.WordRoster) || MatchLanguageWord(content, i, LanguageWordId.WordWorld) {
            let nominal_block: String = ParseNominalDecl(
                content, i, cursor_out, decl_prefix, is_export,
                active_within_zone,
                involve_types, expression_graphs
            );
            i = cursor_out[0];
            ArrayPush(out_blocks, nominal_block);
            ArrayPush(out_module_paths, source_path);
            continue;
        }


        if MatchLanguageWord(content, i, LanguageWordId.WordEvent) {
            let event_block: String = ParseEventDecl(content, i, cursor_out, decl_prefix);
            i = cursor_out[0];
            ArrayPush(out_blocks, event_block);
            ArrayPush(out_module_paths, source_path);
            continue;
        }

        if MatchLanguageWord(content, i, LanguageWordId.WordEnum) {
            let enum_block: String = ParseEnumDecl(content, i, cursor_out, decl_prefix);
            i = cursor_out[0];
            ArrayPush(out_blocks, enum_block);
            ArrayPush(out_module_paths, source_path);
            continue;
        }

        // Optional `async` modifier on the next `func` — the C printer
        // drops it from the AST output, so we just consume and ignore.
        if MatchLanguageWord(content, i, LanguageWordId.WordAsync) {
            i = LanguageWordEnd(i, LanguageWordId.WordAsync);
            i = SkipWhitespaceAndComments(content, i);
        }

        // `func NAME(params) -> Type { body }` at top level (base_indent=2).
        if MatchLanguageWord(content, i, LanguageWordId.WordFunc) {
            ArraySet(cursor_out, 0, i);
            let fn_block: String = ParseFunctionObserved(
                content, i, cursor_out, decl_prefix, effective_export, 2,
                "func", "Function: ", false, active_within_zone,
                expression_graphs, location_context, source_locations
            );
            i = cursor_out[0];
            ArrayPush(out_blocks, fn_block);
            ArrayPush(out_module_paths, source_path);
            continue;
        }

        // Top-level statement (let/if/while/for/break/continue/match,
        // bare call, or assignment). Root script statements are collected
        // under the implicit Main function to match the C parser oracle.
        if is_export {
            Exit(1);
        }
        ArraySet(cursor_out, 0, i);
        let stmt_indent: Int = 2;
        if collect_script {
            stmt_indent = 8;
        }
        let statement_graphs: Array<AstExpressionGraphRows> = [];
        ParserExpressionGraphRowsBoxStart(
            statement_graphs, AstExpressionGraphRowsEmpty()
        );
        let stmt_block: String = "";
        if collect_script {
            stmt_block = ParseOneStmtObserved(
                content, i, cursor_out, stmt_indent, statement_graphs,
                location_context, script_source_locations
            );
        } else {
            stmt_block = ParseOneStmtObserved(
                content, i, cursor_out, stmt_indent, statement_graphs,
                location_context, source_locations
            );
        }
        i = cursor_out[0];
        if collect_script {
            ArrayPush(script_blocks, stmt_block);
            ParserExpressionGraphsAppendRowsInto(script_graphs, statement_graphs[0]);
        } else {
            ArrayPush(out_blocks, stmt_block);
            ArrayPush(out_module_paths, source_path);
            ParserExpressionGraphsAppendRowsInto(expression_graphs, statement_graphs[0]);
        }
    }
    return;
}

func ParseDecls(
    content: String,
    start: Int,
    inout cursor_out: Array<Int>,
    name_prefix: String,
    until_brace: Bool,
    source_dir: String,
    source_path: String,
    force_export: Bool,
    follow_imports: Bool,
    within_zone: String,
    inout involve_types: Array<String>,
    inout import_paths: Set<String>,
    inout expression_graphs: Array<AstExpressionGraphRows>,
    inout source_locations: Array<ParserSourceLocationObservation>,
    inout declaration_module_paths: Array<String>
) -> String {
    let out_blocks: Array<String> = [];
    let script_blocks: Array<String> = [];
    let script_graphs: Array<AstExpressionGraphRows> = [];
    let script_source_locations: Array<ParserSourceLocationObservation> = [];
    ParserExpressionGraphRowsBoxStart(
        script_graphs, AstExpressionGraphRowsEmpty()
    );
    ParseDeclsInto(
        content, start, cursor_out, name_prefix, until_brace, source_dir,
        source_path, force_export, follow_imports, within_zone, involve_types,
        import_paths, expression_graphs, script_graphs,
        source_locations, script_source_locations,
        out_blocks, declaration_module_paths, script_blocks
    );
    ParserExpressionGraphsAppendRowsInto(expression_graphs, script_graphs[0]);
    let out: TextBuilder = TextBuilderNew(4096);
    let block_index: Int = 0;
    while block_index < ArrayLength(out_blocks) {
        if block_index > 0 { TextBuilderAppend(out, "\n"); }
        TextBuilderAppend(out, out_blocks[block_index]);
        block_index = block_index + 1;
    }
    let output_allocator: Allocator = AllocatorResult();
    let output_text: String = TextBuilderFinish(out, output_allocator);
    let script_body: TextBuilder = TextBuilderNew(512);
    block_index = 0;
    while block_index < ArrayLength(script_blocks) {
        if block_index > 0 { TextBuilderAppend(script_body, "\n"); }
        TextBuilderAppend(script_body, script_blocks[block_index]);
        block_index = block_index + 1;
    }
    let script_allocator: Allocator = AllocatorResult();
    let script_text: String = TextBuilderFinish(
        script_body, script_allocator
    );
    let program_text: String = AppendImplicitMain(output_text, script_text);
    if ArrayLength(script_blocks) > 0 {
        ArrayPush(declaration_module_paths, source_path);
        if ArrayLength(script_source_locations) == 0 {
            Exit(1);
        }
        let first_script: ParserSourceLocationObservation =
            script_source_locations[0];
        ParserSourceLocationAppendSynthetic(
            TypedAstKindFuncDeclTag(), first_script.source_path,
            first_script.source_line, first_script.source_offset, "Main",
            source_locations
        );
        ParserSourceLocationAppendSynthetic(
            TypedAstKindBlockTag(), first_script.source_path,
            first_script.source_line, first_script.source_offset, "",
            source_locations
        );
        let script_location_index: Int = 0;
        while script_location_index < ArrayLength(script_source_locations) {
            ArrayPush(
                source_locations,
                script_source_locations[script_location_index]
            );
            script_location_index = script_location_index + 1;
        }
    }
    AllocatorDestroy(script_allocator);
    AllocatorDestroy(output_allocator);
    return program_text;
}
