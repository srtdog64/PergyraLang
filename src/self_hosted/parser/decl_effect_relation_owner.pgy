// Self-host parser effect/relation declaration owner.
//
// Every refusal names its code and the position the cursor held. A form the
// native parser admits and this parser does not (a method, a body `for`, a
// subject, vessel or binding slot, a projection group, a header with another
// participant count) is refused as surface_not_covered, not as a syntax error.

import "cursor_owner.pgy";
import "tree_text_owner.pgy";
import "type_name_owner.pgy";
import "domain_projection_map_owner.pgy";
import "source_refusal_owner.pgy";

func DomainHeaderParticipantSlotLabel(content: String, i: Int) -> String {
    if MatchLanguageWord(content, i, LanguageWordId.WordObject) {
        return "BindingSlot";
    }
    return "SubjectSlot";
}

// Body members native admits in an effect or relation body and this parser
// does not cover yet.
func DomainBodyUncoveredMemberRefusal(
    context: ParserSourceLocationContext,
    content: String, i: Int, construct: String
) -> Void {
    let surface: String = "";
    if MatchLanguageWord(content, i, LanguageWordId.WordFunc) {
        surface = Concat(construct, " method");
    } else if MatchLanguageWord(content, i, LanguageWordId.WordFor) {
        surface = Concat(construct, " body participant");
    } else if MatchLanguageWord(content, i, LanguageWordId.WordSubject) {
        surface = Concat(construct, " subject slot");
    } else if MatchLanguageWord(content, i, LanguageWordId.WordVessel) {
        surface = Concat(construct, " vessel slot");
    } else if MatchLanguageWord(content, i, LanguageWordId.WordBinding) &&
        MatchLanguageWord(content, SkipWhitespaceAndComments(content,
            LanguageWordEnd(i, LanguageWordId.WordBinding)), LanguageWordId.WordSlot) {
        surface = Concat(construct, " binding slot");
    }
    if surface != "" {
        ParseRefuse(context, i, "surface_not_covered",
            "surface", surface, "construct", construct);
    }
}

func ParseEffectRelationProjectionDirective(
    context: ParserSourceLocationContext,
    content: String,
    start: Int,
    inout cursor_out: Array<Int>
) -> String {
    let i: Int = start;
    let label: String = "";
    let target_expected: String = "";
    if MatchLanguageWord(content, i, LanguageWordId.WordRefresh) {
        label = "Refresh";
        target_expected = "object slot name";
        i = LanguageWordEnd(i, LanguageWordId.WordRefresh);
    } else if MatchLanguageWord(content, i, LanguageWordId.WordPublish) {
        label = "Publish";
        target_expected = "tobject slot name";
        i = LanguageWordEnd(i, LanguageWordId.WordPublish);
    } else if MatchLanguageWord(content, i, LanguageWordId.WordBind) {
        label = "Bind";
        target_expected = "object/tobject slot name";
        i = LanguageWordEnd(i, LanguageWordId.WordBind);
    } else {
        ParseRefuse(context, i, "expected_token", "expected",
            "refresh, publish or bind", "construct", "projection");
    }
    i = SkipWhitespaceAndComments(content, i);
    if ParserCharAt(content, i) == "[" {
        ParseRefuse(context, i, "surface_not_covered", "surface",
            "projection slot group", "construct", "projection");
    }
    let projection_name: String = ParseNameIn(context, content, i,
        target_expected, "projection", cursor_out);
    i = SkipWhitespaceAndComments(content, cursor_out[0]);
    if !MatchLanguageWord(content, i, LanguageWordId.WordFrom) {
        ParseRefuse(context, i, "expected_token", "expected", "from",
            "construct", "projection");
    }
    // Native takes no `by PARTICIPANT` here (only a zone names one); a `by`
    // is refused as the next body member, at native's position.
    let source_name: String = ParseNameIn(context, content,
        LanguageWordEnd(i, LanguageWordId.WordFrom), "source slot name",
        "projection", cursor_out);
    i = cursor_out[0];
    let projection_map: ParserDomainProjectionMapRows =
        ParseDomainProjectionMapRows(context, content, i, cursor_out);
    i = cursor_out[0];
    i = SkipWhitespaceAndComments(content, i);
    if i < StringLength(content) && ParserCharAt(content, i) == ";" {
        i = i + 1;
    }
    ArraySet(cursor_out, 0, i);
    let row: String = Concat(
        "    ", Concat(label, Concat(": ", Concat(
            projection_name, Concat(" from ", source_name)
        )))
    );
    if projection_map.present {
        row = AppendLine(row, projection_map.tree_rows);
    }
    return row;
}

func ParseEffectRelationProjectionSlot(
    context: ParserSourceLocationContext,
    content: String,
    start: Int,
    inout cursor_out: Array<Int>
) -> String {
    let i: Int = start;
    let label: String = "";
    if MatchLanguageWord(content, i, LanguageWordId.WordObject) {
        label = "ObjectSlot";
        i = LanguageWordEnd(i, LanguageWordId.WordObject);
    } else if MatchLanguageWord(content, i, LanguageWordId.WordTobject) {
        label = "TObjectSlot";
        i = LanguageWordEnd(i, LanguageWordId.WordTobject);
    } else {
        ParseRefuse(context, i, "expected_token", "expected",
            "object or tobject", "construct", "projection_slot");
    }
    i = SkipWhitespaceAndComments(content, i);
    if !MatchLanguageWord(content, i, LanguageWordId.WordSlot) {
        ParseRefuse(context, i, "expected_token", "expected", "slot",
            "construct", "projection_slot");
    }
    i = LanguageWordEnd(i, LanguageWordId.WordSlot);
    let slot_name: String = ParseNameIn(context, content, i, "slot name",
        "projection_slot", cursor_out);
    i = ParseExpectIn(context, content, cursor_out[0], ":", "projection_slot");
    ArraySet(cursor_out, 0, i);
    let slot_type: String = ReadTypeIn(context, content, i, cursor_out);
    i = cursor_out[0];
    if slot_type == "" {
        ParseRefuse(context, i, "type_name_invalid",
            "construct", "projection_slot", "", "");
    }
    i = SkipWhitespaceAndComments(content, i);
    if i < StringLength(content) && ParserCharAt(content, i) == ";" {
        i = i + 1;
    }
    ArraySet(cursor_out, 0, i);
    return Concat(
        "    ", Concat(label, Concat(": ", Concat(
            slot_name, Concat(": ", slot_type)
        )))
    );
}

func ParseEffectDecl(content: String, start: Int, inout cursor_out: Array<Int>, decl_prefix: String,
    location_context: ParserSourceLocationContext) -> String {
    let i: Int = start;
    let n: Int = StringLength(content);
    let out: String = "";
    i = LanguageWordEnd(i, LanguageWordId.WordEffect);
    i = SkipWhitespaceAndComments(content, i);
    ArraySet(cursor_out, 0, i);
    let eff_name: String = ReadIdent(content, i, cursor_out);
    i = cursor_out[0];
    if eff_name == "" {
        ParseRefuse(location_context, i, "declaration_name_missing", "construct", "effect", "", "");
    }
    i = SkipWhitespaceAndComments(content, i);
    if !MatchLanguageWord(content, i, LanguageWordId.WordFor) {
        if ParserCharAt(content, i) == "{" {
            ParseRefuse(location_context, i, "surface_not_covered", "surface",
                "effect without a participant", "construct", "effect");
        }
        ParseRefuse(location_context, i, "expected_token", "expected", "for", "construct", "effect");
    }
    i = LanguageWordEnd(i, LanguageWordId.WordFor);
    i = SkipWhitespaceAndComments(content, i);
    let eff_slot_label: String = DomainHeaderParticipantSlotLabel(content, i);
    if MatchLanguageWord(content, i, LanguageWordId.WordObject) {
        i = LanguageWordEnd(i, LanguageWordId.WordObject);
        i = SkipWhitespaceAndComments(content, i);
    } else {
        if MatchLanguageWord(content, i, LanguageWordId.WordSubject) {
            i = LanguageWordEnd(i, LanguageWordId.WordSubject);
            i = SkipWhitespaceAndComments(content, i);
        }
    }
    ArraySet(cursor_out, 0, i);
    let eff_param_name: String = ReadIdent(content, i, cursor_out);
    i = cursor_out[0];
    if eff_param_name == "" {
        ParseRefuse(location_context, i, "declaration_name_missing", "construct", "effect_participant", "", "");
    }
    i = ParseExpectIn(location_context, content, i, ":", "effect");
    ArraySet(cursor_out, 0, i);
    let eff_param_type: String = ReadTypeIn(location_context, content, i, cursor_out);
    i = cursor_out[0];
    if eff_param_type == "" {
        ParseRefuse(location_context, i, "type_name_invalid", "construct", "effect_participant", "", "");
    }
    i = SkipWhitespaceAndComments(content, i);
    if ParserCharAt(content, i) == "," {
        ParseRefuse(location_context, i, "surface_not_covered", "surface",
            "effect with more than one participant", "construct", "effect");
    }
    let open_at: Int = i;
    i = ParseExpectIn(location_context, content, i, "{", "effect");

    let eff_fields: String = "";
    while true {
        i = SkipWhitespaceAndComments(content, i);
        if i >= n {
            ParseRefuse(location_context, open_at, "block_unclosed", "construct", "effect", "", "");
        }
        if ParserCharAt(content, i) == "}" {
            i = i + 1;
            break;
        }
        DomainBodyUncoveredMemberRefusal(location_context, content, i, "effect");
        if MatchLanguageWord(content, i, LanguageWordId.WordObject) ||
            MatchLanguageWord(content, i, LanguageWordId.WordTobject) {
            ArraySet(cursor_out, 0, i);
            eff_fields = AppendLine(
                eff_fields,
                ParseEffectRelationProjectionSlot(location_context, content, i, cursor_out)
            );
            i = cursor_out[0];
            continue;
        }
        if MatchLanguageWord(content, i, LanguageWordId.WordRefresh) ||
            MatchLanguageWord(content, i, LanguageWordId.WordPublish) ||
            MatchLanguageWord(content, i, LanguageWordId.WordBind) {
            ArraySet(cursor_out, 0, i);
            eff_fields = AppendLine(
                eff_fields,
                ParseEffectRelationProjectionDirective(location_context, content, i, cursor_out)
            );
            i = cursor_out[0];
            continue;
        }
        // Native admits only `shared` fields here and refuses `let x: T` and
        // a bare `x: T` at their first token.
        if !MatchLanguageWord(content, i, LanguageWordId.WordShared) {
            ParseRefuse(location_context, i, "expected_token", "expected", "effect member", "construct", "effect");
        }
        i = SkipWhitespaceAndComments(content, LanguageWordEnd(i, LanguageWordId.WordShared));
        ArraySet(cursor_out, 0, i);
        let f_name: String = ReadIdent(content, i, cursor_out);
        i = cursor_out[0];
        if f_name == "" {
            ParseRefuse(location_context, i, "declaration_name_missing", "construct", "effect_field", "", "");
        }
        i = ParseExpectIn(location_context, content, i, ":", "effect_field");
        ArraySet(cursor_out, 0, i);
        let f_type: String = ReadTypeIn(location_context, content, i, cursor_out);
        i = cursor_out[0];
        if f_type == "" {
            ParseRefuse(location_context, i, "type_name_invalid", "construct", "effect_field", "", "");
        }
        if ParserCharAt(content, SkipWhitespaceAndComments(content, i)) == "=" {
            ParseRefuse(location_context, SkipWhitespaceAndComments(content, i), "surface_not_covered", "surface",
                "effect field initializer", "construct", "effect_field");
        }
        i = ParseExpectIn(location_context, content, i, ";", "effect_field");
        eff_fields = AppendLine(eff_fields, Concat("    Shared: ", Concat(f_name, Concat(": ", f_type))));
    }
    out = AppendLine(out, Concat("  Effect: ", Concat(decl_prefix, eff_name)));
    out = AppendLine(out, Concat("    ", Concat(eff_slot_label, Concat(": ", Concat(eff_param_name, Concat(": ", eff_param_type))))));
    if StringLength(eff_fields) > 0 {
        out = AppendLine(out, eff_fields);
    }
    ArraySet(cursor_out, 0, i); return out;
}

func ParseRelationDecl(content: String, start: Int, inout cursor_out: Array<Int>, decl_prefix: String,
    location_context: ParserSourceLocationContext) -> String {
    let i: Int = start;
    let n: Int = StringLength(content);
    let out: String = "";
    i = LanguageWordEnd(i, LanguageWordId.WordRelation);
    i = SkipWhitespaceAndComments(content, i);
    ArraySet(cursor_out, 0, i);
    let rel_name: String = ReadIdent(content, i, cursor_out);
    i = cursor_out[0];
    if rel_name == "" {
        ParseRefuse(location_context, i, "declaration_name_missing", "construct", "relation", "", "");
    }
    i = SkipWhitespaceAndComments(content, i);
    if MatchLanguageWord(content, i, LanguageWordId.WordBetween) {
        ParseRefuse(location_context, i, "surface_not_covered", "surface",
            "relation between clause", "construct", "relation");
    }
    if !MatchLanguageWord(content, i, LanguageWordId.WordFor) {
        if ParserCharAt(content, i) == "{" {
            ParseRefuse(location_context, i, "surface_not_covered", "surface",
                "relation without participants", "construct", "relation");
        }
        ParseRefuse(location_context, i, "expected_token", "expected", "for", "construct", "relation");
    }
    i = LanguageWordEnd(i, LanguageWordId.WordFor);

    // Param 1
    i = SkipWhitespaceAndComments(content, i);
    let p1_slot_label: String = DomainHeaderParticipantSlotLabel(content, i);
    if MatchLanguageWord(content, i, LanguageWordId.WordObject) {
        i = LanguageWordEnd(i, LanguageWordId.WordObject);
        i = SkipWhitespaceAndComments(content, i);
    } else {
        if MatchLanguageWord(content, i, LanguageWordId.WordSubject) {
            i = LanguageWordEnd(i, LanguageWordId.WordSubject);
            i = SkipWhitespaceAndComments(content, i);
        }
    }
    ArraySet(cursor_out, 0, i);
    let p1_name: String = ReadIdent(content, i, cursor_out);
    i = cursor_out[0];
    if p1_name == "" {
        ParseRefuse(location_context, i, "declaration_name_missing", "construct", "relation_participant", "", "");
    }
    i = ParseExpectIn(location_context, content, i, ":", "relation");
    ArraySet(cursor_out, 0, i);
    let p1_type: String = ReadTypeIn(location_context, content, i, cursor_out);
    i = cursor_out[0];
    if p1_type == "" {
        ParseRefuse(location_context, i, "type_name_invalid", "construct", "relation_participant", "", "");
    }

    // Comma
    i = SkipWhitespaceAndComments(content, i);
    if ParserCharAt(content, i) == "{" {
        ParseRefuse(location_context, i, "surface_not_covered", "surface",
            "relation with one participant", "construct", "relation");
    }
    i = ParseExpectIn(location_context, content, i, ",", "relation");

    // Param 2
    i = SkipWhitespaceAndComments(content, i);
    let p2_slot_label: String = DomainHeaderParticipantSlotLabel(content, i);
    if MatchLanguageWord(content, i, LanguageWordId.WordObject) {
        i = LanguageWordEnd(i, LanguageWordId.WordObject);
        i = SkipWhitespaceAndComments(content, i);
    } else {
        if MatchLanguageWord(content, i, LanguageWordId.WordSubject) {
            i = LanguageWordEnd(i, LanguageWordId.WordSubject);
            i = SkipWhitespaceAndComments(content, i);
        }
    }
    ArraySet(cursor_out, 0, i);
    let p2_name: String = ReadIdent(content, i, cursor_out);
    i = cursor_out[0];
    if p2_name == "" {
        ParseRefuse(location_context, i, "declaration_name_missing", "construct", "relation_participant", "", "");
    }
    i = ParseExpectIn(location_context, content, i, ":", "relation");
    ArraySet(cursor_out, 0, i);
    let p2_type: String = ReadTypeIn(location_context, content, i, cursor_out);
    i = cursor_out[0];
    if p2_type == "" {
        ParseRefuse(location_context, i, "type_name_invalid", "construct", "relation_participant", "", "");
    }
    i = SkipWhitespaceAndComments(content, i);
    if ParserCharAt(content, i) == "," {
        ParseRefuse(location_context, i, "surface_not_covered", "surface",
            "relation with more than two participants", "construct", "relation");
    }
    let open_at: Int = i;
    i = ParseExpectIn(location_context, content, i, "{", "relation");

    // Fields
    let rel_fields: String = "";
    while true {
        i = SkipWhitespaceAndComments(content, i);
        if i >= n {
            ParseRefuse(location_context, open_at, "block_unclosed", "construct", "relation", "", "");
        }
        if ParserCharAt(content, i) == "}" {
            i = i + 1;
            break;
        }
        DomainBodyUncoveredMemberRefusal(location_context, content, i, "relation");
        if MatchLanguageWord(content, i, LanguageWordId.WordObject) ||
            MatchLanguageWord(content, i, LanguageWordId.WordTobject) {
            ArraySet(cursor_out, 0, i);
            rel_fields = AppendLine(
                rel_fields,
                ParseEffectRelationProjectionSlot(location_context, content, i, cursor_out)
            );
            i = cursor_out[0];
            continue;
        }
        if MatchLanguageWord(content, i, LanguageWordId.WordRefresh) ||
            MatchLanguageWord(content, i, LanguageWordId.WordPublish) ||
            MatchLanguageWord(content, i, LanguageWordId.WordBind) {
            ArraySet(cursor_out, 0, i);
            rel_fields = AppendLine(
                rel_fields,
                ParseEffectRelationProjectionDirective(location_context, content, i, cursor_out)
            );
            i = cursor_out[0];
            continue;
        }
        if !MatchLanguageWord(content, i, LanguageWordId.WordShared) {
            ParseRefuse(location_context, i, "expected_token", "expected", "relation member", "construct", "relation");
        }
        i = SkipWhitespaceAndComments(content, LanguageWordEnd(i, LanguageWordId.WordShared));
        ArraySet(cursor_out, 0, i);
        let f_name: String = ReadIdent(content, i, cursor_out);
        i = cursor_out[0];
        if f_name == "" {
            ParseRefuse(location_context, i, "declaration_name_missing", "construct", "relation_field", "", "");
        }
        i = ParseExpectIn(location_context, content, i, ":", "relation_field");
        ArraySet(cursor_out, 0, i);
        let f_type: String = ReadTypeIn(location_context, content, i, cursor_out);
        i = cursor_out[0];
        if f_type == "" {
            ParseRefuse(location_context, i, "type_name_invalid", "construct", "relation_field", "", "");
        }
        if ParserCharAt(content, SkipWhitespaceAndComments(content, i)) == "=" {
            ParseRefuse(location_context, SkipWhitespaceAndComments(content, i), "surface_not_covered", "surface",
                "relation field initializer", "construct", "relation_field");
        }
        i = ParseExpectIn(location_context, content, i, ";", "relation_field");
        rel_fields = AppendLine(rel_fields, Concat("    Shared: ", Concat(f_name, Concat(": ", f_type))));
    }

    out = AppendLine(out, Concat("  Relation: ", Concat(decl_prefix, rel_name)));
    out = AppendLine(out, Concat("    ", Concat(p1_slot_label, Concat(": ", Concat(p1_name, Concat(": ", p1_type))))));
    out = AppendLine(out, Concat("    ", Concat(p2_slot_label, Concat(": ", Concat(p2_name, Concat(": ", p2_type))))));
    if StringLength(rel_fields) > 0 {
        out = AppendLine(out, rel_fields);
    }
    ArraySet(cursor_out, 0, i); return out;
}
