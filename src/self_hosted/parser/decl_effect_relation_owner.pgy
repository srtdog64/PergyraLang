// Self-host parser effect/relation declaration owner.

import "cursor_owner.pgy";
import "tree_text_owner.pgy";
import "type_name_owner.pgy";
import "domain_projection_map_owner.pgy";

func ParseEffectRelationProjectionDirective(
    content: String,
    start: Int,
    inout cursor_out: Array<Int>
) -> String {
    let i: Int = start;
    let label: String = "";
    if MatchLanguageWord(content, i, LanguageWordId.WordRefresh) {
        label = "Refresh";
        i = LanguageWordEnd(i, LanguageWordId.WordRefresh);
    } else if MatchLanguageWord(content, i, LanguageWordId.WordPublish) {
        label = "Publish";
        i = LanguageWordEnd(i, LanguageWordId.WordPublish);
    } else if MatchLanguageWord(content, i, LanguageWordId.WordBind) {
        label = "Bind";
        i = LanguageWordEnd(i, LanguageWordId.WordBind);
    } else {
        Exit(1);
    }
    i = SkipWhitespaceAndComments(content, i);
    ArraySet(cursor_out, 0, i);
    let projection_name: String = ReadIdent(content, i, cursor_out);
    i = cursor_out[0];
    i = SkipWhitespaceAndComments(content, i);
    if projection_name == "" ||
        !MatchLanguageWord(content, i, LanguageWordId.WordFrom) {
        Exit(1);
    }
    i = LanguageWordEnd(i, LanguageWordId.WordFrom);
    i = SkipWhitespaceAndComments(content, i);
    ArraySet(cursor_out, 0, i);
    let source_name: String = ReadIdent(content, i, cursor_out);
    i = cursor_out[0];
    i = SkipWhitespaceAndComments(content, i);
    let participant_name: String = "";
    if MatchLanguageWord(content, i, LanguageWordId.WordBy) {
        i = LanguageWordEnd(i, LanguageWordId.WordBy);
        i = SkipWhitespaceAndComments(content, i);
        ArraySet(cursor_out, 0, i);
        participant_name = ReadIdent(content, i, cursor_out);
        i = cursor_out[0];
        i = SkipWhitespaceAndComments(content, i);
    }
    ArraySet(cursor_out, 0, i);
    let projection_map: ParserDomainProjectionMapRows =
        ParseDomainProjectionMapRows(content, i, cursor_out);
    i = cursor_out[0];
    i = SkipWhitespaceAndComments(content, i);
    if i < StringLength(content) && ParserCharAt(content, i) == ";" {
        i = i + 1;
    }
    if source_name == "" { Exit(1); }
    ArraySet(cursor_out, 0, i);
    let row: String = Concat(
        "    ", Concat(label, Concat(": ", Concat(
            projection_name, Concat(" from ", source_name)
        )))
    );
    if participant_name != "" {
        row = Concat(row, Concat(" by ", participant_name));
    }
    if projection_map.present {
        row = AppendLine(row, projection_map.tree_rows);
    }
    return row;
}

func ParseEffectRelationProjectionSlot(
    content: String,
    start: Int,
    inout cursor_out: Array<Int>
) -> String {
    let i: Int = start;
    let label: String = "";
    if MatchLanguageWord(content, i, LanguageWordId.WordObject) {
        label = "ObjectSlot";
        i = LanguageWordEnd(i, LanguageWordId.WordObject);
    } else if MatchLanguageWord(content, i, LanguageWordId.WordTobject) {
        label = "TObjectSlot";
        i = LanguageWordEnd(i, LanguageWordId.WordTobject);
    } else {
        Exit(1);
    }
    i = SkipWhitespaceAndComments(content, i);
    if !MatchLanguageWord(content, i, LanguageWordId.WordSlot) { Exit(1); }
    i = LanguageWordEnd(i, LanguageWordId.WordSlot);
    i = SkipWhitespaceAndComments(content, i);
    ArraySet(cursor_out, 0, i);
    let slot_name: String = ReadIdent(content, i, cursor_out);
    i = cursor_out[0];
    i = Expect(content, i, ":");
    if i < 0 || slot_name == "" { Exit(1); }
    ArraySet(cursor_out, 0, i);
    let slot_type: String = ReadType(content, i, cursor_out);
    i = cursor_out[0];
    i = SkipWhitespaceAndComments(content, i);
    if i < StringLength(content) && ParserCharAt(content, i) == ";" {
        i = i + 1;
    }
    if slot_type == "" { Exit(1); }
    ArraySet(cursor_out, 0, i);
    return Concat(
        "    ", Concat(label, Concat(": ", Concat(
            slot_name, Concat(": ", slot_type)
        )))
    );
}

func ParseEffectDecl(content: String, start: Int, inout cursor_out: Array<Int>, decl_prefix: String) -> String {
    let i: Int = start;
    let n: Int = StringLength(content);
    let out: String = "";
    i = LanguageWordEnd(i, LanguageWordId.WordEffect);
    i = SkipWhitespaceAndComments(content, i);
    ArraySet(cursor_out, 0, i);
    let eff_name: String = ReadIdent(content, i, cursor_out);
    i = cursor_out[0];
    i = SkipWhitespaceAndComments(content, i);
    if !MatchLanguageWord(content, i, LanguageWordId.WordFor) {
        Exit(1);
    }
    i = LanguageWordEnd(i, LanguageWordId.WordFor);
    i = SkipWhitespaceAndComments(content, i);
    ArraySet(cursor_out, 0, i);
    let eff_param_name: String = ReadIdent(content, i, cursor_out);
    i = cursor_out[0];
    i = Expect(content, i, ":");
    if i < 0 {
        Exit(1);
    }
    ArraySet(cursor_out, 0, i);
    let eff_param_type: String = ReadType(content, i, cursor_out);
    i = cursor_out[0];
    i = Expect(content, i, "{");
    if i < 0 {
        Exit(1);
    }

    let eff_fields: String = "";
    while true {
        i = SkipWhitespaceAndComments(content, i);
        if i >= n { Exit(1); }
        if ParserCharAt(content, i) == "}" {
            i = i + 1;
            break;
        }
        if MatchLanguageWord(content, i, LanguageWordId.WordObject) ||
            MatchLanguageWord(content, i, LanguageWordId.WordTobject) {
            ArraySet(cursor_out, 0, i);
            eff_fields = AppendLine(
                eff_fields,
                ParseEffectRelationProjectionSlot(content, i, cursor_out)
            );
            i = cursor_out[0];
            continue;
        }
        if MatchLanguageWord(content, i, LanguageWordId.WordRefresh) ||
            MatchLanguageWord(content, i, LanguageWordId.WordPublish) ||
            MatchLanguageWord(content, i, LanguageWordId.WordBind) {
            ArraySet(cursor_out, 0, i);
            eff_fields = AppendLine(
                eff_fields,
                ParseEffectRelationProjectionDirective(content, i, cursor_out)
            );
            i = cursor_out[0];
            continue;
        }
        let is_shared_eff: Bool = false;
        if MatchLanguageWord(content, i, LanguageWordId.WordLet) {
            i = LanguageWordEnd(i, LanguageWordId.WordLet);
            i = SkipWhitespaceAndComments(content, i);
        } else if MatchLanguageWord(content, i, LanguageWordId.WordShared) {
            i = LanguageWordEnd(i, LanguageWordId.WordShared);
            i = SkipWhitespaceAndComments(content, i);
            is_shared_eff = true;
        }
        ArraySet(cursor_out, 0, i);
        let f_name: String = ReadIdent(content, i, cursor_out);
        i = cursor_out[0];
        if StringLength(f_name) == 0 { Exit(1); }
        i = Expect(content, i, ":");
        if i < 0 { Exit(1); }
        ArraySet(cursor_out, 0, i);
        let f_type: String = ReadType(content, i, cursor_out);
        i = cursor_out[0];
        i = Expect(content, i, ";");
        if i < 0 { Exit(1); }

        if is_shared_eff {
            eff_fields = AppendLine(eff_fields, Concat("    Shared: ", Concat(f_name, Concat(": ", f_type))));
        } else {
            eff_fields = AppendLine(eff_fields, Concat("    ", Concat(f_name, Concat(": ", f_type))));
        }
    }
    out = AppendLine(out, Concat("  Effect: ", Concat(decl_prefix, eff_name)));
    out = AppendLine(out, Concat("    SubjectSlot: ", Concat(eff_param_name, Concat(": ", eff_param_type))));
    if StringLength(eff_fields) > 0 {
        out = AppendLine(out, eff_fields);
    }
    ArraySet(cursor_out, 0, i); return out;
}

func ParseRelationDecl(content: String, start: Int, inout cursor_out: Array<Int>, decl_prefix: String) -> String {
    let i: Int = start;
    let n: Int = StringLength(content);
    let out: String = "";
    i = LanguageWordEnd(i, LanguageWordId.WordRelation);
    i = SkipWhitespaceAndComments(content, i);
    ArraySet(cursor_out, 0, i);
    let rel_name: String = ReadIdent(content, i, cursor_out);
    i = cursor_out[0];
    i = SkipWhitespaceAndComments(content, i);
    if !MatchLanguageWord(content, i, LanguageWordId.WordFor) { Exit(1); }
    i = LanguageWordEnd(i, LanguageWordId.WordFor);

    // Param 1
    i = SkipWhitespaceAndComments(content, i);
    ArraySet(cursor_out, 0, i);
    let p1_name: String = ReadIdent(content, i, cursor_out);
    i = cursor_out[0];
    i = Expect(content, i, ":");
    if i < 0 { Exit(1); }
    ArraySet(cursor_out, 0, i);
    let p1_type: String = ReadType(content, i, cursor_out);
    i = cursor_out[0];

    // Comma
    i = Expect(content, i, ",");
    if i < 0 { Exit(1); }

    // Param 2
    i = SkipWhitespaceAndComments(content, i);
    ArraySet(cursor_out, 0, i);
    let p2_name: String = ReadIdent(content, i, cursor_out);
    i = cursor_out[0];
    i = Expect(content, i, ":");
    if i < 0 { Exit(1); }
    ArraySet(cursor_out, 0, i);
    let p2_type: String = ReadType(content, i, cursor_out);
    i = cursor_out[0];

    i = Expect(content, i, "{");
    if i < 0 { Exit(1); }

    // Fields
    let rel_fields: String = "";
    while true {
        i = SkipWhitespaceAndComments(content, i);
        if i >= n { Exit(1); }
        if ParserCharAt(content, i) == "}" {
            i = i + 1;
            break;
        }
        if MatchLanguageWord(content, i, LanguageWordId.WordObject) ||
            MatchLanguageWord(content, i, LanguageWordId.WordTobject) {
            ArraySet(cursor_out, 0, i);
            rel_fields = AppendLine(
                rel_fields,
                ParseEffectRelationProjectionSlot(content, i, cursor_out)
            );
            i = cursor_out[0];
            continue;
        }
        if MatchLanguageWord(content, i, LanguageWordId.WordRefresh) ||
            MatchLanguageWord(content, i, LanguageWordId.WordPublish) ||
            MatchLanguageWord(content, i, LanguageWordId.WordBind) {
            ArraySet(cursor_out, 0, i);
            rel_fields = AppendLine(
                rel_fields,
                ParseEffectRelationProjectionDirective(content, i, cursor_out)
            );
            i = cursor_out[0];
            continue;
        }
        let is_shared_rel: Bool = false;
        if MatchLanguageWord(content, i, LanguageWordId.WordLet) {
            i = LanguageWordEnd(i, LanguageWordId.WordLet);
            i = SkipWhitespaceAndComments(content, i);
        } else if MatchLanguageWord(content, i, LanguageWordId.WordShared) {
            i = LanguageWordEnd(i, LanguageWordId.WordShared);
            i = SkipWhitespaceAndComments(content, i);
            is_shared_rel = true;
        }
        ArraySet(cursor_out, 0, i);
        let f_name: String = ReadIdent(content, i, cursor_out);
        i = cursor_out[0];
        if StringLength(f_name) == 0 { Exit(1); }
        i = Expect(content, i, ":");
        if i < 0 { Exit(1); }
        ArraySet(cursor_out, 0, i);
        let f_type: String = ReadType(content, i, cursor_out);
        i = cursor_out[0];
        i = Expect(content, i, ";");
        if i < 0 { Exit(1); }

        if is_shared_rel {
            rel_fields = AppendLine(rel_fields, Concat("    Shared: ", Concat(f_name, Concat(": ", f_type))));
        } else {
            rel_fields = AppendLine(rel_fields, Concat("    ", Concat(f_name, Concat(": ", f_type))));
        }
    }

    out = AppendLine(out, Concat("  Relation: ", Concat(decl_prefix, rel_name)));
    out = AppendLine(out, Concat("    SubjectSlot: ", Concat(p1_name, Concat(": ", p1_type))));
    out = AppendLine(out, Concat("    SubjectSlot: ", Concat(p2_name, Concat(": ", p2_type))));
    if StringLength(rel_fields) > 0 {
        out = AppendLine(out, rel_fields);
    }
    ArraySet(cursor_out, 0, i); return out;
}
