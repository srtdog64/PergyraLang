// Self-host parser enum declaration owner.

import "cursor_owner.pgy";
import "tree_text_owner.pgy";
import "type_name_owner.pgy";
import "function_decl_owner.pgy";
import "source_refusal_owner.pgy";

// `enum NAME { V1, V2(T), V3 }` single-line canonical emission. An enum body
// may also declare methods in any position; they are children of the enum
// line, like the C printer's `ast_print(method, indent + 1)`.
func ParseEnumDecl(
    content: String,
    start: Int,
    inout cursor_out: Array<Int>,
    decl_prefix: String,
    inout expression_graphs: Array<AstExpressionGraphRows>,
    location_context: ParserSourceLocationContext
) -> String {
    let i: Int = LanguageWordEnd(start, LanguageWordId.WordEnum);
    let n: Int = StringLength(content);
    i = SkipWhitespaceAndComments(content, i);
    ArraySet(cursor_out, 0, i);
    let enum_name: String = ReadIdent(content, i, cursor_out);
    i = cursor_out[0];
    if StringLength(enum_name) == 0 {
        ParseRefuse(location_context, i, "declaration_name_missing", "construct", "enum", "", "");
    }
    let open_at: Int = SkipWhitespaceAndComments(content, i);
    i = ParseExpectIn(location_context, content, i, "{", "enum");
    let variants: String = "";
    let method_blocks: String = "";
    while true {
        i = SkipWhitespaceAndComments(content, i);
        if i >= n {
            ParseRefuse(location_context, open_at, "block_unclosed", "construct", "enum", "", "");
        }
        if ParserCharAt(content, i) == "}" {
            i = i + 1;
            break;
        }
        if MatchLanguageWord(content, i, LanguageWordId.WordFunc) {
            ArraySet(cursor_out, 0, i);
            let method_block: String = ParseFunction(
                content, i, cursor_out, "", false, 4,
                LanguageWordId.WordFunc, "Function: ", false, "",
                expression_graphs, location_context
            );
            i = cursor_out[0];
            method_blocks = AppendLine(method_blocks, method_block);
            continue;
        }
        ArraySet(cursor_out, 0, i);
        let v_name: String = ReadIdent(content, i, cursor_out);
        i = cursor_out[0];
        if StringLength(v_name) == 0 {
            ParseRefuse(location_context, i, "declaration_name_missing", "construct", "enum_variant", "", "");
        }
        let variant_text: String = v_name;
        i = SkipWhitespaceAndComments(content, i);
        if ParserCharAt(content, i) == "(" {
            i = i + 1;
            let params: String = "";
            while true {
                i = SkipWhitespaceAndComments(content, i);
                if ParserCharAt(content, i) == ")" {
                    i = i + 1;
                    break;
                }
                let type_start: Int = i;
                ArraySet(cursor_out, 0, i);
                let possible_label: String = ReadIdent(content, i, cursor_out);
                let after_label: Int = SkipWhitespaceAndComments(
                    content, cursor_out[0]
                );
                if StringLength(possible_label) > 0 &&
                    ParserCharAt(content, after_label) == ":" {
                    i = after_label + 1;
                } else {
                    i = type_start;
                }
                ArraySet(cursor_out, 0, i);
                let param_type: String = ReadTypeIn(location_context, content, i, cursor_out);
                if StringLength(param_type) == 0 {
                    ParseRefuse(location_context, cursor_out[0], "type_name_invalid", "construct", "enum_variant", "", "");
                }
                i = cursor_out[0];
                if StringLength(params) == 0 {
                    params = param_type;
                } else {
                    params = Concat(params, Concat(", ", param_type));
                }
                i = SkipWhitespaceAndComments(content, i);
                if ParserCharAt(content, i) == "," {
                    i = i + 1;
                    continue;
                }
                if ParserCharAt(content, i) != ")" {
                    ParseRefuse(location_context, i, "expected_token", "expected", ")", "construct", "enum_variant");
                }
            }
            if StringLength(params) > 0 {
                variant_text = Concat(v_name, Concat("(", Concat(params, ")")));
            }
        }
        if StringLength(variants) == 0 {
            variants = variant_text;
        } else {
            variants = Concat(variants, Concat(", ", variant_text));
        }
        i = SkipWhitespaceAndComments(content, i);
        if ParserCharAt(content, i) == "," {
            i = i + 1;
            continue;
        }
    }
    ArraySet(cursor_out, 0, i);
    let variant_group: String = "";
    if StringLength(variants) > 0 {
        variant_group = Concat(" { ", Concat(variants, " }"));
    }
    let enum_line: String = Concat("  Enum: ", Concat(decl_prefix, Concat(enum_name, variant_group)));
    if StringLength(method_blocks) == 0 {
        return enum_line;
    }
    return AppendLine(enum_line, method_blocks);
}
