// Self-host parser enum declaration owner.

import "cursor_owner.pgy";

// `enum NAME { V1, V2, V3 }` single-line emission. Variant payload tuples are
// consumed but not printed, matching the C AST printer.
func ParseEnumDecl(content: String, start: Int, inout cursor_out: Array<Int>, decl_prefix: String) -> String {
    let i: Int = start + 4;
    let n: Int = StringLength(content);
    i = SkipWhitespaceAndComments(content, i);
    ArraySet(cursor_out, 0, i);
    let enum_name: String = ReadIdent(content, i, cursor_out);
    i = cursor_out[0];
    if StringLength(enum_name) == 0 {
        Exit(1);
    }
    i = Expect(content, i, "{");
    if i < 0 {
        Exit(1);
    }
    let variants: String = "";
    while true {
        i = SkipWhitespaceAndComments(content, i);
        if i >= n {
            Exit(1);
        }
        if CharAt(content, i) == "}" {
            i = i + 1;
            break;
        }
        ArraySet(cursor_out, 0, i);
        let v_name: String = ReadIdent(content, i, cursor_out);
        i = cursor_out[0];
        if StringLength(v_name) == 0 {
            Exit(1);
        }
        i = SkipWhitespaceAndComments(content, i);
        if CharAt(content, i) == "(" {
            let depth: Int = 1;
            i = i + 1;
            while i < n && depth > 0 {
                let ch: String = CharAt(content, i);
                if ch == "(" {
                    depth = depth + 1;
                } else if ch == ")" {
                    depth = depth - 1;
                    if depth == 0 {
                        i = i + 1;
                        break;
                    }
                }
                i = i + 1;
            }
        }
        if StringLength(variants) == 0 {
            variants = v_name;
        } else {
            variants = Concat(variants, Concat(", ", v_name));
        }
        i = SkipWhitespaceAndComments(content, i);
        if CharAt(content, i) == "," {
            i = i + 1;
            continue;
        }
    }
    ArraySet(cursor_out, 0, i);
    return Concat("  Enum: ", Concat(decl_prefix, Concat(enum_name, Concat(" { ", Concat(variants, " }")))));
}
