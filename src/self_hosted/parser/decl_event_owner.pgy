// Self-host parser event declaration owner.

import "cursor_owner.pgy";
import "tree_text_owner.pgy";
import "type_name_owner.pgy";
import "source_refusal_owner.pgy";

// `event NAME(PNAME: PTYPE, ...);` top-level event signature.
func ParseEventDecl(content: String, start: Int, inout cursor_out: Array<Int>, decl_prefix: String,
    location_context: ParserSourceLocationContext) -> String {
    let i: Int = LanguageWordEnd(start, LanguageWordId.WordEvent);
    i = SkipWhitespaceAndComments(content, i);
    ArraySet(cursor_out, 0, i);
    let ev_name: String = ReadIdent(content, i, cursor_out);
    i = cursor_out[0];
    if StringLength(ev_name) == 0 {
        ParseRefuse(location_context, i, "declaration_name_missing", "construct", "event", "", "");
    }
    i = SkipWhitespaceAndComments(content, i);
    if ParserCharAt(content, i) == ":" {
        i = i + 1;
    }
    i = ParseExpectIn(location_context, content, i, "(", "event");
    let ev_params: Array<String> = [];
    i = SkipWhitespaceAndComments(content, i);
    if ParserCharAt(content, i) != ")" {
        while true {
            i = SkipWhitespaceAndComments(content, i);
            ArraySet(cursor_out, 0, i);
            let p_name: String = ReadIdent(content, i, cursor_out);
            i = cursor_out[0];
            if StringLength(p_name) == 0 {
                ParseRefuse(location_context, i, "declaration_name_missing", "construct", "event_parameter", "", "");
            }
            i = ParseExpectIn(location_context, content, i, ":", "event_parameter");
            ArraySet(cursor_out, 0, i);
            let p_type: String = ReadTypeIn(location_context, content, i, cursor_out);
            i = cursor_out[0];
            if StringLength(p_type) == 0 {
                ParseRefuse(location_context, i, "type_name_invalid", "construct", "event_parameter", "", "");
            }
            ArrayPush(ev_params, Concat("      Let: ", Concat(p_name, Concat(" : ", Concat(p_type, " = (null)")))));
            i = SkipWhitespaceAndComments(content, i);
            if ParserCharAt(content, i) == "," {
                i = i + 1;
                continue;
            }
            break;
        }
    }
    i = ParseExpectIn(location_context, content, i, ")", "event");
    i = ParseExpectIn(location_context, content, i, ";", "event");
    let event_out: String = Concat("  Event: ", Concat(decl_prefix, ev_name));
    let ev_len: Int = ArrayLength(ev_params);
    if ev_len > 0 {
        event_out = AppendLine(event_out, "    Parameters:");
        let ei: Int = 0;
        while ei < ev_len {
            event_out = AppendLine(event_out, ev_params[ei]);
            ei = ei + 1;
        }
    }
    ArraySet(cursor_out, 0, i);
    return event_out;
}
