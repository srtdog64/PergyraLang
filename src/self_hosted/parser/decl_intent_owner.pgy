// Self-host parser intent declaration owner. Every refusal is coded and positioned; a
// typed-intent shape rule native checks in semantic is refused as intent_shape_invalid.
import "cursor_owner.pgy";
import "tree_text_owner.pgy";
import "type_name_owner.pgy";
import "expr_owner.pgy";
import "intent_variant_binding_owner.pgy";
import "intent_terminal_clause_owner.pgy";
import "intent_default_clause_owner.pgy";
import "intent_policy_clause_owner.pgy";
import "source_refusal_owner.pgy";
func ParseIntentDecl(content: String, start: Int, inout cursor_out: Array<Int>, decl_prefix: String,
    inout expression_graphs: Array<AstExpressionGraphRows>, location_context: ParserSourceLocationContext) -> String {
    let i: Int = start;
    let n: Int = StringLength(content);
    let out: String = "";
    i = LanguageWordEnd(i, LanguageWordId.WordIntent);
    i = SkipWhitespaceAndComments(content, i);
    ArraySet(cursor_out, 0, i);
    let intent_name: String = ReadIdent(content, i, cursor_out);
    i = cursor_out[0];
    if StringLength(intent_name) == 0 {
        ParseRefuse(location_context, i, "declaration_name_missing", "construct", "intent", "", "");
    }
    i = SkipWhitespaceAndComments(content, i);
    if ParserCharAt(content, i) == "{" {
        ParseRefuse(location_context, i, "surface_not_covered", "surface", "intent without a parameter list", "construct", "intent");
    }
    i = ParseExpectIn(location_context, content, i, "(", "intent");
    // Classify each parameter without changing its source order. Call sites and
    // the semantic signature owner consume this same positional contract.
    let parameter_lines: Array<String> = [];
    i = SkipWhitespaceAndComments(content, i);
    if ParserCharAt(content, i) != ")" {
        while true {
            i = SkipWhitespaceAndComments(content, i);
            ArraySet(cursor_out, 0, i);
            let ip_name: String = ReadIdent(content, i, cursor_out);
            i = cursor_out[0];
            if StringLength(ip_name) == 0 {
                ParseRefuse(location_context, i, "declaration_name_missing", "construct", "intent_parameter", "", "");
            }
            i = ParseExpectIn(location_context, content, i, ":", "intent_parameter");
            i = SkipWhitespaceAndComments(content, i);
            ArraySet(cursor_out, 0, i);
            let ip_type: String = ReadTypeIn(location_context, content, i, cursor_out);
            i = cursor_out[0];
            if StringLength(ip_type) == 0 {
                ParseRefuse(location_context, i, "type_name_invalid", "construct", "intent_parameter", "", "");
            }
            let row: String = Concat(ip_name, Concat(": ", ip_type));
            // Final role classification is deferred until the complete import
            // graph has registered every subject and zone declaration.
            ArrayPush(parameter_lines, Concat("IntentBinding: ", row));
            i = SkipWhitespaceAndComments(content, i);
            if ParserCharAt(content, i) == "," {
                i = i + 1;
                continue;
            }
            break;
        }
    }
    i = ParseExpectIn(location_context, content, i, ")", "intent");
    let intent_return_type: String = "";
    i = SkipWhitespaceAndComments(content, i);
    if ParserCharAt(content, i) == "-" && ParserCharAt(content, i + 1) == ">" {
        i = i + 2;
        i = SkipWhitespaceAndComments(content, i);
        ArraySet(cursor_out, 0, i);
        intent_return_type = ReadTypeIn(location_context, content, i, cursor_out);
        i = cursor_out[0];
        if intent_return_type == "" {
            ParseRefuse(location_context, i, "type_name_invalid", "construct", "intent_return", "", "");
        }
    }
    let intent_retry: String = "";
    i = SkipWhitespaceAndComments(content, i);
    if MatchLanguageWord(content, i, LanguageWordId.WordWith) {
        i = LanguageWordEnd(i, LanguageWordId.WordWith);
        i = SkipWhitespaceAndComments(content, i);
        if MatchLanguageWord(content, i, LanguageWordId.WordTimeout) ||
            MatchLanguageWord(content, i, LanguageWordId.WordBackoff) {
            ParseRefuse(location_context, i, "declaration_clause_invalid", "rule", "timeout and backoff are reserved but not implemented", "construct", "intent_resilience");
        }
        if !MatchLanguageWord(content, i, LanguageWordId.WordRetry) {
            ParseRefuse(location_context, i, "expected_token", "expected", "retry", "construct", "intent_resilience");
        }
        i = LanguageWordEnd(i, LanguageWordId.WordRetry);
        i = ParseExpectIn(location_context, content, i, "(", "intent_resilience");
        i = SkipWhitespaceAndComments(content, i);
        let retry_start: Int = i;
        ArraySet(cursor_out, 0, i);
        intent_retry = ReadNumber(content, i, cursor_out);
        i = cursor_out[0];
        let retry_length: Int = StringLength(intent_retry);
        let retry_count: Int = 0;
        let retry_index: Int = 0;
        let retry_digits: Bool = true;
        while retry_index < retry_length {
            let digit: Int = SourceByteAt(intent_retry, retry_length, retry_index) - SourceByteOf("0");
            if digit < 0 || digit > 9 || retry_count > (2147483647 - digit) / 10 { retry_digits = false; break; }
            retry_count = retry_count * 10 + digit;
            retry_index = retry_index + 1;
        }
        if !retry_digits || retry_count == 0 {
            ParseRefuse(location_context, retry_start, "declaration_clause_invalid", "rule", "retry(n) requires a positive integer attempt count", "construct", "intent_resilience");
        }
        intent_retry = ToString(retry_count);
        i = ParseExpectIn(location_context, content, i, ")", "intent_resilience");
    }
    let open_at: Int = SkipWhitespaceAndComments(content, i);
    i = ParseExpectIn(location_context, content, i, "{", "intent");
    // Walk the body collecting mode, steps, success, failure.
    let intent_policy: ParserIntentPolicyClause = ParserIntentPolicyClauseDefault();
    let step_blocks: String = "";
    let success_text: String = "";
    let failure_text: String = "";
    let success_fact: ParserExpressionFact = ParserExpressionInvalid();
    let failure_fact: ParserExpressionFact = ParserExpressionInvalid();
    let default_who: String = "";
    let default_where: String = "";
    let terminal_success_steps: Array<String> = [];
    let terminal_success_texts: Array<String> = [];
    let terminal_success_graphs: AstExpressionGraphRows = AstExpressionGraphRowsEmpty();
    let terminal_failure_steps: Array<String> = [];
    let terminal_failure_texts: Array<String> = [];
    let terminal_failure_graphs: AstExpressionGraphRows = AstExpressionGraphRowsEmpty();
    let intent_expression_graphs: Array<AstExpressionGraphRows> = [];
    ParserExpressionGraphRowsBoxStart(intent_expression_graphs, AstExpressionGraphRowsEmpty());
    while true {
        i = SkipWhitespaceAndComments(content, i);
        if i >= n {
            ParseRefuse(location_context, open_at, "block_unclosed", "construct", "intent", "", "");
        }
        if ParserCharAt(content, i) == "}" {
            i = i + 1;
            break;
        }
        let item_at: Int = i;
        let policy_clause: ParserIntentPolicyClause = ParserIntentPolicyClauseFromSource(location_context, content, i, intent_policy);
        if policy_clause.matched {
            intent_policy = policy_clause;
            i = policy_clause.next;
            continue;
        }
        let default_clause: ParserIntentDefaultClause = ParserIntentDefaultClauseFromSource(location_context, content, i);
        if default_clause.matched {
            if (default_clause.who_names != "" && default_who != "") ||
                (default_clause.where_type != "" && default_where != "") {
                ParseRefuse(location_context, item_at, "declaration_clause_duplicate", "clause", "intent-level default", "construct", "intent");
            }
            if default_clause.who_names != "" { default_who = default_clause.who_names; }
            if default_clause.where_type != "" { default_where = default_clause.where_type; }
            i = default_clause.next;
            continue;
        }
        // Only a typed intent labels a terminal with its step; native refuses the other spelling.
        let terminal_label: String = "terminal step name";
        if intent_return_type == "" { terminal_label = ":"; }
        if MatchLanguageWord(content, i, LanguageWordId.WordSuccess) {
            i = LanguageWordEnd(i, LanguageWordId.WordSuccess);
            ArraySet(cursor_out, 0, i);
            let terminal: ParserIntentTerminalClause = ParseIntentTerminalClause(location_context, content, i, cursor_out);
            i = cursor_out[0];
            if (terminal.step_name == "" && intent_return_type != "") ||
                (terminal.step_name != "" && intent_return_type == "") {
                ParseRefuse(location_context, terminal.step_offset, "expected_token", "expected", terminal_label, "construct", "intent_success");
            }
            if success_text != "" || ArrayLength(terminal_success_steps) > 0 {
                ParseRefuse(location_context, item_at, "declaration_clause_duplicate", "clause", "success", "construct", "intent");
            }
            if terminal.step_name == "" {
                success_text = terminal.expression.text;
                success_fact = terminal.expression;
            } else {
                ArrayPush(terminal_success_steps, terminal.step_name);
                ArrayPush(terminal_success_texts, terminal.expression.text);
                terminal_success_graphs = ParserExpressionGraphsAppend(terminal_success_graphs,
                    TypedAstKindIntentTerminalSuccessTag(), AstExpressionLaneAtom(), terminal.expression);
            }
            continue;
        }
        if MatchLanguageWord(content, i, LanguageWordId.WordFailure) {
            i = LanguageWordEnd(i, LanguageWordId.WordFailure);
            ArraySet(cursor_out, 0, i);
            let terminal: ParserIntentTerminalClause = ParseIntentTerminalClause(location_context, content, i, cursor_out);
            i = cursor_out[0];
            if (terminal.step_name == "" && intent_return_type != "") ||
                (terminal.step_name != "" && intent_return_type == "") {
                ParseRefuse(location_context, terminal.step_offset, "expected_token", "expected", terminal_label, "construct", "intent_failure");
            }
            if failure_text != "" {
                ParseRefuse(location_context, item_at, "declaration_clause_duplicate", "clause", "failure", "construct", "intent");
            }
            if terminal.step_name == "" {
                failure_text = terminal.expression.text;
                failure_fact = terminal.expression;
            } else {
                ArrayPush(terminal_failure_steps, terminal.step_name);
                ArrayPush(terminal_failure_texts, terminal.expression.text);
                terminal_failure_graphs = ParserExpressionGraphsAppend(terminal_failure_graphs,
                    TypedAstKindIntentTerminalFailureTag(), AstExpressionLaneAtom(), terminal.expression);
            }
            continue;
        }
        if MatchLanguageWord(content, i, LanguageWordId.WordStep) {
            i = LanguageWordEnd(i, LanguageWordId.WordStep);
            i = SkipWhitespaceAndComments(content, i);
            ArraySet(cursor_out, 0, i);
            let step_name: String = ReadIdent(content, i, cursor_out);
            i = cursor_out[0];
            if StringLength(step_name) == 0 {
                ParseRefuse(location_context, i, "declaration_name_missing", "construct", "intent_step", "", "");
            }
            let predecessor_name: String = "";
            i = SkipWhitespaceAndComments(content, i);
            if MatchLanguageWord(content, i, LanguageWordId.WordAfter) {
                if intent_return_type == "" {
                    ParseRefuse(location_context, i, "intent_shape_invalid", "rule", "a step of an untyped intent names no predecessor", "construct", "intent_step");
                }
                i = LanguageWordEnd(i, LanguageWordId.WordAfter);
                i = SkipWhitespaceAndComments(content, i);
                ArraySet(cursor_out, 0, i);
                predecessor_name = ReadIdent(content, i, cursor_out);
                i = cursor_out[0];
                if predecessor_name == "" {
                    ParseRefuse(location_context, i, "expected_token", "expected", "predecessor step name", "construct", "intent_step");
                }
            }
            let step_open_at: Int = SkipWhitespaceAndComments(content, i);
            i = ParseExpectIn(location_context, content, i, "{", "intent_step");
            let s_where: String = "";
            let s_using: String = "";
            let s_who: String = "";
            let s_on: String = "";
            let s_outcome: String = "";
            let s_success_pattern: String = "";
            let s_failure_pattern: String = "";
            let s_on_seen: Bool = false;
            let s_guard: String = "";
            let s_guard_seen: Bool = false;
            let s_pre: String = "";
            let s_invariant: String = "";
            let s_expect: String = "";
            let s_expect_seen: Bool = false;
            let s_requires: String = "";
            let s_auth: String = "";
            let s_causes: String = "";
            let s_transfer: String = "";
            let s_compensates: Array<String> = [];
            let s_post: String = "";
            let s_post_seen: Bool = false;
            let s_intent: String = "";
            let s_on_fact: ParserExpressionFact = ParserExpressionInvalid();
            let s_guard_fact: ParserExpressionFact = ParserExpressionInvalid();
            let s_pre_fact: ParserExpressionFact = ParserExpressionInvalid();
            let s_invariant_fact: ParserExpressionFact = ParserExpressionInvalid();
            let s_expect_fact: ParserExpressionFact = ParserExpressionInvalid();
            let s_compensate_graphs: AstExpressionGraphRows = AstExpressionGraphRowsEmpty();
            let s_post_fact: ParserExpressionFact = ParserExpressionInvalid();
            let s_intent_fact: ParserExpressionFact = ParserExpressionInvalid();
            while true {
                i = SkipWhitespaceAndComments(content, i);
                if i >= n {
                    ParseRefuse(location_context, step_open_at, "block_unclosed", "construct", "intent_step", "", "");
                }
                if ParserCharAt(content, i) == "}" {
                    i = i + 1;
                    break;
                }
                ArraySet(cursor_out, 0, i);
                let clause_start: Int = i;
                let clause: String = ReadIdent(content, i, cursor_out);
                i = cursor_out[0];
                if StringLength(clause) == 0 {
                    ParseRefuse(location_context, i, "expected_token", "expected", "intent step clause", "construct", "intent_step");
                }
                let is_transfer: Bool = false;
                if MatchLanguageWord(content, clause_start, LanguageWordId.WordMove) {
                    is_transfer = true;
                } else if MatchLanguageWord(content, clause_start, LanguageWordId.WordTransfer) {
                    let peek_colon: Int = SkipWhitespaceAndComments(content, i);
                    if ParserCharAt(content, peek_colon) != ":" {
                        is_transfer = true;
                    }
                }
                if is_transfer {
                    i = SkipWhitespaceAndComments(content, i);
                    ArraySet(cursor_out, 0, i);
                    let t_from: String = ParseExprFactIn(location_context, content, i, cursor_out).text;
                    i = cursor_out[0];
                    i = SkipWhitespaceAndComments(content, i);
                    if !MatchLanguageWord(content, i, LanguageWordId.WordTo) {
                        ParseRefuse(location_context, i, "expected_token", "expected", "to", "construct", "intent_step_transfer");
                    }
                    i = LanguageWordEnd(i, LanguageWordId.WordTo);
                    i = SkipWhitespaceAndComments(content, i);
                    ArraySet(cursor_out, 0, i);
                    let t_to: String = ParseExprFactIn(location_context, content, i, cursor_out).text;
                    i = ParseExpectIn(location_context, content, cursor_out[0], ";", "intent_step_transfer");
                    s_transfer = Concat(t_from, Concat(" -> ", t_to));
                    continue;
                }
                if MatchLanguageWord(content, clause_start, LanguageWordId.WordSuccess) || MatchLanguageWord(content, clause_start, LanguageWordId.WordFailure) {
                    if intent_return_type == "" {
                        ParseRefuse(location_context, clause_start, "intent_shape_invalid", "rule", "a step of an untyped intent declares no outcome patterns", "construct", "intent_step");
                    }
                    if (MatchLanguageWord(content, clause_start, LanguageWordId.WordSuccess) && s_success_pattern != "") ||
                        (MatchLanguageWord(content, clause_start, LanguageWordId.WordFailure) && s_failure_pattern != "") {
                        ParseRefuse(location_context, clause_start, "declaration_clause_duplicate", "clause", clause, "construct", "intent_step");
                    }
                    i = ParseExpectIn(location_context, content, i, ":", "intent_step_outcome");
                    ArraySet(cursor_out, 0, i);
                    let pattern: ParserIntentVariantBinding = ParseIntentVariantBinding(location_context, content, i, cursor_out);
                    i = ParseExpectIn(location_context, content, cursor_out[0], ";", "intent_step_outcome");
                    if MatchLanguageWord(content, clause_start, LanguageWordId.WordSuccess) {
                        s_success_pattern = pattern.text;
                    } else {
                        s_failure_pattern = pattern.text;
                    }
                    continue;
                }
                if MatchLanguageWord(content, clause_start, LanguageWordId.WordAuthorized) {
                    let peek_by: Int = SkipWhitespaceAndComments(content, i);
                    if MatchLanguageWord(content, peek_by, LanguageWordId.WordBy) {
                        i = LanguageWordEnd(peek_by, LanguageWordId.WordBy);
                        clause = "authorized by";
                    }
                }
                let repeated: Bool = (MatchLanguageWord(content, clause_start, LanguageWordId.WordPre) && s_pre != "") || (MatchLanguageWord(content, clause_start, LanguageWordId.WordInvariant) && s_invariant != "");
                let on_clause: Bool = false;
                if MatchLanguageWord(content, clause_start, LanguageWordId.WordOn) { on_clause = true; }
                if MatchLanguageWord(content, clause_start, LanguageWordId.WordGuard) { repeated = s_guard_seen; s_guard_seen = true; }
                if MatchLanguageWord(content, clause_start, LanguageWordId.WordPost) { repeated = s_post_seen; s_post_seen = true; }
                if MatchLanguageWord(content, clause_start, LanguageWordId.WordExpect) { repeated = s_expect_seen; s_expect_seen = true; }
                if repeated {
                    ParseRefuse(location_context, clause_start, "declaration_clause_duplicate", "clause", clause, "construct", "intent_step");
                }
                if on_clause {
                    let on_head: Int = SkipWhitespaceAndComments(content, i);
                    let binds_outcome: Bool = ParserCharAt(content, on_head) != ":";
                    // Native binds one outcome but keeps every `on:` expression; this parser carries one.
                    if s_on_seen && binds_outcome && s_outcome != "" {
                        ParseRefuse(location_context, clause_start, "declaration_clause_duplicate", "clause", "on outcome binding", "construct", "intent_step");
                    }
                    if s_on_seen {
                        ParseRefuse(location_context, clause_start, "surface_not_covered", "surface", "repeated intent step on clause", "construct", "intent_step");
                    }
                    s_on_seen = true;
                    if binds_outcome {
                        if on_head >= n || !SourceByteIsAlpha(SourceByteAt(content, n, on_head)) {
                            ParseRefuse(location_context, on_head, "expected_token", "expected", "outcome binding or :", "construct", "intent_step_on");
                        }
                        ArraySet(cursor_out, 0, on_head);
                        s_outcome = ReadIdent(content, on_head, cursor_out);
                        i = cursor_out[0];
                    }
                }
                i = ParseExpectIn(location_context, content, i, ":", "intent_step_clause");
                let val: String = "";
                if MatchLanguageWord(content, clause_start, LanguageWordId.WordTransfer) {
                    i = SkipWhitespaceAndComments(content, i);
                    let t_start: Int = i;
                    while i < n && ParserCharAt(content, i) != ";" {
                        i = i + 1;
                    }
                    val = Substring(content, t_start, i - t_start);
                    val = StringTrim(val);
                    ArraySet(cursor_out, 0, i);
                } else {
                    ArraySet(cursor_out, 0, i);
                    let val_fact: ParserExpressionFact = ParseExprFactIn(location_context, content, i, cursor_out);
                    val = val_fact.text;
                    if MatchLanguageWord(content, clause_start, LanguageWordId.WordOn) { s_on_fact = val_fact; }
                    if MatchLanguageWord(content, clause_start, LanguageWordId.WordGuard) { s_guard_fact = val_fact; }
                    if MatchLanguageWord(content, clause_start, LanguageWordId.WordPre) { s_pre_fact = val_fact; }
                    if MatchLanguageWord(content, clause_start, LanguageWordId.WordInvariant) { s_invariant_fact = val_fact; }
                    if MatchLanguageWord(content, clause_start, LanguageWordId.WordExpect) { s_expect_fact = val_fact; }
                    if MatchLanguageWord(content, clause_start, LanguageWordId.WordCompensate) {
                        s_compensate_graphs = ParserExpressionGraphsAppend(s_compensate_graphs,
                            TypedAstKindIntentStepCompensateTag(), AstExpressionLaneAtom(), val_fact);
                    }
                    if MatchLanguageWord(content, clause_start, LanguageWordId.WordPost) { s_post_fact = val_fact; }
                    if MatchLanguageWord(content, clause_start, LanguageWordId.WordIntent) { s_intent_fact = val_fact; }
                    i = cursor_out[0];
                }
                i = ParseExpectIn(location_context, content, i, ";", "intent_step_clause");
                if MatchLanguageWord(content, clause_start, LanguageWordId.WordWhere) {
                    s_where = val;
                } else if MatchLanguageWord(content, clause_start, LanguageWordId.WordUsing) {
                    s_using = val;
                } else if MatchLanguageWord(content, clause_start, LanguageWordId.WordWho) {
                    s_who = val;
                } else if MatchLanguageWord(content, clause_start, LanguageWordId.WordOn) {
                    s_on = val;
                } else if MatchLanguageWord(content, clause_start, LanguageWordId.WordGuard) {
                    s_guard = val;
                } else if MatchLanguageWord(content, clause_start, LanguageWordId.WordPre) {
                    s_pre = val;
                } else if MatchLanguageWord(content, clause_start, LanguageWordId.WordInvariant) {
                    s_invariant = val;
                } else if MatchLanguageWord(content, clause_start, LanguageWordId.WordExpect) {
                    s_expect = val;
                } else if MatchLanguageWord(content, clause_start, LanguageWordId.WordRequires) {
                    s_requires = val;
                } else if clause == "authorized by" {
                    s_auth = val;
                } else if MatchLanguageWord(content, clause_start, LanguageWordId.WordCauses) {
                    s_causes = val;
                } else if MatchLanguageWord(content, clause_start, LanguageWordId.WordCompensate) {
                    ArrayPush(s_compensates, val);
                } else if MatchLanguageWord(content, clause_start, LanguageWordId.WordPost) {
                    s_post = val;
                } else if MatchLanguageWord(content, clause_start, LanguageWordId.WordIntent) {
                    s_intent = val;
                } else if MatchLanguageWord(content, clause_start, LanguageWordId.WordTransfer) {
                    s_transfer = val;
                } else {
                    ParseRefuse(location_context, clause_start, "expected_token", "expected", "intent step clause", "construct", "intent_step");
                }
            }
            let defaults: ParserIntentStepDefaults = ParserIntentStepDefaultsResolve(
                default_who, default_where, s_who, s_where);
            s_who = defaults.who_names;
            s_where = defaults.where_type;
            let step_header: String = Concat("    IntentStep: ", step_name);
            if predecessor_name != "" {
                step_header = Concat(step_header, Concat(" after ", predecessor_name));
            }
            if StringLength(s_where) > 0 {
                step_header = Concat(step_header, Concat(" where ", s_where));
            }
            if StringLength(s_using) > 0 {
                step_header = Concat(step_header, Concat(" using ", s_using));
            }
            if StringLength(s_intent) > 0 {
                step_header = Concat(step_header, Concat(" intent ", s_intent));
            }
            if StringLength(s_transfer) > 0 {
                step_header = Concat(step_header, Concat(" transfer ", s_transfer));
            }
            let step_out: String = step_header;
            if StringLength(s_who) > 0 {
                step_out = AppendLine(step_out, Concat("      Who: ", s_who));
            }
            if StringLength(s_using) > 0 {
                step_out = AppendLine(step_out, Concat("      Using: ", s_using));
            }
            if StringLength(s_transfer) > 0 {
                step_out = AppendLine(step_out, Concat("      Transfer: ", s_transfer));
            }
            if StringLength(s_intent) > 0 {
                step_out = AppendLine(step_out, Concat("      Intent: ", s_intent));
            }
            if StringLength(s_outcome) > 0 {
                step_out = AppendLine(step_out, Concat("      Outcome: ", s_outcome));
            }
            if StringLength(s_on) > 0 {
                step_out = AppendLine(step_out, Concat("      On: ", s_on));
            }
            if StringLength(s_success_pattern) > 0 {
                step_out = AppendLine(step_out, Concat("      IntentStepSuccess: ", s_success_pattern));
            }
            if StringLength(s_failure_pattern) > 0 {
                step_out = AppendLine(step_out, Concat("      IntentStepFailure: ", s_failure_pattern));
            }
            let compensate_i: Int = 0;
            while compensate_i < ArrayLength(s_compensates) {
                step_out = AppendLine(step_out, Concat("      Compensate: ", s_compensates[compensate_i]));
                compensate_i = compensate_i + 1;
            }
            if StringLength(s_guard) > 0 {
                step_out = AppendLine(step_out, Concat("      Guard: ", s_guard));
            }
            if StringLength(s_post) > 0 {
                step_out = AppendLine(step_out, Concat("      Post: ", s_post));
            }
            if s_pre != "" {
                step_out = AppendLine(step_out, Concat("      Pre: ", s_pre));
            }
            if s_invariant != "" {
                step_out = AppendLine(step_out, Concat("      Invariant: ", s_invariant));
            }
            if StringLength(s_requires) > 0 {
                step_out = AppendLine(step_out, Concat("      Requires: ", s_requires));
            }
            if StringLength(s_auth) > 0 {
                step_out = AppendLine(step_out, Concat("      AuthorizedBy: ", s_auth));
            }
            if StringLength(s_causes) > 0 {
                step_out = AppendLine(step_out, Concat("      Causes: ", s_causes));
            }
            if StringLength(s_expect) > 0 {
                step_out = AppendLine(step_out, Concat("      Expect: ", s_expect));
            }
            if defaults.provenance_text != "" {
                step_out = AppendLine(step_out, Concat("      ContractProvenance: ", defaults.provenance_text));
            }
            if StringLength(s_on) > 0 {
                ParserExpressionGraphsAppendInto(intent_expression_graphs, TypedAstKindIntentStepOnTag(),
                    AstExpressionLaneAtom(), s_on_fact);
            }
            if StringLength(s_intent) > 0 {
                ParserExpressionGraphsAppendInto(
                    intent_expression_graphs, TypedAstKindIntentStepIntentTag(), AstExpressionLaneAtom(), s_intent_fact
                );
            }
            ParserExpressionGraphsAppendRowsInto(intent_expression_graphs, s_compensate_graphs);
            if StringLength(s_guard) > 0 {
                ParserExpressionGraphsAppendInto(intent_expression_graphs, TypedAstKindIntentStepGuardTag(),
                    AstExpressionLaneAtom(), s_guard_fact);
            }
            if StringLength(s_post) > 0 {
                ParserExpressionGraphsAppendInto(intent_expression_graphs, TypedAstKindIntentStepPostTag(),
                    AstExpressionLaneAtom(), s_post_fact);
            }
            if s_pre != "" {
                ParserExpressionGraphsAppendInto(intent_expression_graphs, TypedAstKindIntentStepPreTag(),
                    AstExpressionLaneAtom(), s_pre_fact);
            }
            if s_invariant != "" {
                ParserExpressionGraphsAppendInto(intent_expression_graphs, TypedAstKindIntentStepInvariantTag(),
                    AstExpressionLaneAtom(), s_invariant_fact);
            }
            if StringLength(s_expect) > 0 {
                ParserExpressionGraphsAppendInto(intent_expression_graphs, TypedAstKindIntentStepExpectTag(),
                    AstExpressionLaneAtom(), s_expect_fact);
            }
            step_blocks = AppendLine(step_blocks, step_out);
            if intent_return_type != "" && (s_outcome == "" || s_success_pattern == "" || s_failure_pattern == "" ||
                 s_success_pattern == s_failure_pattern) {
                ParseRefuse(location_context, item_at, "intent_shape_invalid", "rule", "a typed intent step binds an action outcome and distinct success and failure patterns", "construct", "intent_step");
            }
            continue;
        }
        // Native admits these intent members; this parser does not cover them yet.
        if MatchLanguageWord(content, i, LanguageWordId.WordInvolves) || MatchLanguageWord(content, i, LanguageWordId.WordWith) {
            ParseRefuse(location_context, i, "surface_not_covered", "surface", "intent binding declaration", "construct", "intent");
        }
        ParseRefuse(location_context, i, "expected_token", "expected", "intent member", "construct", "intent");
    }
    // The terminal clauses above already refuse a label an untyped intent
    // cannot carry, an unlabeled typed terminal, and a second success.
    let typed_result: Bool = intent_return_type != "";
    if typed_result && (ArrayLength(terminal_success_steps) == 0 || ArrayLength(terminal_failure_steps) == 0) {
        ParseRefuse(location_context, start, "intent_shape_invalid", "rule", "a typed intent has one labeled success terminal and a labeled failure terminal", "construct", "intent");
    }
    if !typed_result && success_text == "" {
        success_text = "true";
        success_fact = ParserExpressionBoolLiteral("true");
    }
    out = AppendLine(out, Concat("  Intent: ", Concat(decl_prefix, intent_name)));
    if typed_result { out = AppendLine(out, Concat("    IntentReturns: ", intent_return_type)); }
    out = ParserIntentPolicyTreeAppend(out, expression_graphs, intent_policy);
    if StringLength(intent_retry) > 0 {
        out = AppendLine(out, Concat("    IntentRetry: ", intent_retry));
    }
    let parameter_i: Int = 0;
    while parameter_i < ArrayLength(parameter_lines) {
        out = AppendLine(out, Concat("    ", parameter_lines[parameter_i]));
        parameter_i = parameter_i + 1;
    }
    if StringLength(step_blocks) > 0 {
        out = AppendLine(out, step_blocks);
    }
    if StringLength(success_text) > 0 {
        out = AppendLine(out, Concat("    IntentSuccess: ", success_text));
        ParserExpressionGraphsAppendInto(intent_expression_graphs,
            TypedAstKindIntentSuccessTag(), AstExpressionLaneAtom(), success_fact);
    }
    if StringLength(failure_text) > 0 {
        out = AppendLine(out, Concat("    IntentFailure: ", failure_text));
        ParserExpressionGraphsAppendInto(intent_expression_graphs,
            TypedAstKindIntentFailureTag(), AstExpressionLaneAtom(), failure_fact);
    }
    let terminal_i: Int = 0;
    while terminal_i < ArrayLength(terminal_success_steps) {
        out = AppendLine(out, Concat("    IntentTerminalSuccess: ", Concat(terminal_success_steps[terminal_i],
                Concat(" => ", terminal_success_texts[terminal_i]))));
        terminal_i = terminal_i + 1;
    }
    ParserExpressionGraphsAppendRowsInto(intent_expression_graphs, terminal_success_graphs);
    terminal_i = 0;
    while terminal_i < ArrayLength(terminal_failure_steps) {
        out = AppendLine(out, Concat(
            "    IntentTerminalFailure: ", Concat(
                terminal_failure_steps[terminal_i],
                Concat(" => ", terminal_failure_texts[terminal_i]))
        ));
        terminal_i = terminal_i + 1;
    }
    ParserExpressionGraphsAppendRowsInto(intent_expression_graphs, terminal_failure_graphs);
    ParserExpressionGraphsAppendRowsInto(expression_graphs, intent_expression_graphs[0]);
    ArraySet(cursor_out, 0, i); return out;
}
