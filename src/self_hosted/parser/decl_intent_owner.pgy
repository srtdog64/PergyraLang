// Self-host parser intent declaration owner.
import "cursor_owner.pgy";
import "tree_text_owner.pgy";
import "type_name_owner.pgy";
import "expr_owner.pgy";
import "intent_variant_binding_owner.pgy";
import "intent_terminal_clause_owner.pgy";
import "intent_default_clause_owner.pgy";
import "intent_policy_clause_owner.pgy";
func ParseIntentDecl(
    content: String, start: Int, inout cursor_out: Array<Int>,
    decl_prefix: String,
    inout expression_graphs: Array<AstExpressionGraphRows>
) -> String {
    let i: Int = start;
    let n: Int = StringLength(content);
    let out: String = "";
    i = LanguageWordEnd(i, LanguageWordId.WordIntent);
    i = SkipWhitespaceAndComments(content, i);
    ArraySet(cursor_out, 0, i);
    let intent_name: String = ReadIdent(content, i, cursor_out);
    i = cursor_out[0];
    if StringLength(intent_name) == 0 {
        Exit(1);
    }
    i = Expect(content, i, "(");
    if i < 0 {
        Exit(1);
    }
    // Classify each parameter without changing its source order. Call sites and
    // the semantic signature owner consume this same positional contract.
    let parameter_lines: Array<String> = [];
    i = SkipWhitespaceAndComments(content, i);
    if ParserCharAt(content, i) != ")" {
        while true {
            i = SkipWhitespaceAndComments(content, i);
            ArraySet(cursor_out, 0, i);
            let ip_name: String = ReadIdent(content, i, cursor_out);
            i = cursor_out[0];
            if StringLength(ip_name) == 0 {
                Exit(1);
            }
            i = Expect(content, i, ":");
            if i < 0 {
                Exit(1);
            }
            i = SkipWhitespaceAndComments(content, i);
            ArraySet(cursor_out, 0, i);
            let ip_type: String = ReadType(content, i, cursor_out);
            i = cursor_out[0];
            if StringLength(ip_type) == 0 {
                Exit(1);
            }
            let row: String = Concat(ip_name, Concat(": ", ip_type));
            // Final role classification is deferred until the complete import
            // graph has registered every subject and zone declaration.
            ArrayPush(parameter_lines, Concat("IntentBinding: ", row));
            i = SkipWhitespaceAndComments(content, i);
            if ParserCharAt(content, i) == "," {
                i = i + 1;
                continue;
            }
            break;
        }
    }
    i = Expect(content, i, ")");
    if i < 0 {
        Exit(1);
    }
    let intent_return_type: String = "";
    i = SkipWhitespaceAndComments(content, i);
    if ParserCharAt(content, i) == "-" && ParserCharAt(content, i + 1) == ">" {
        i = i + 2;
        i = SkipWhitespaceAndComments(content, i);
        ArraySet(cursor_out, 0, i);
        intent_return_type = ReadType(content, i, cursor_out);
        i = cursor_out[0];
        if intent_return_type == "" { Exit(1); }
    }
    let intent_retry: String = "";
    i = SkipWhitespaceAndComments(content, i);
    if MatchLanguageWord(content, i, LanguageWordId.WordWith) {
        i = LanguageWordEnd(i, LanguageWordId.WordWith);
        i = SkipWhitespaceAndComments(content, i);
        if !MatchLanguageWord(content, i, LanguageWordId.WordRetry) {
            Exit(1);
        }
        i = LanguageWordEnd(i, LanguageWordId.WordRetry);
        i = Expect(content, i, "(");
        if i < 0 {
            Exit(1);
        }
        i = SkipWhitespaceAndComments(content, i);
        ArraySet(cursor_out, 0, i);
        intent_retry = ReadNumber(content, i, cursor_out);
        i = cursor_out[0];
        if StringLength(intent_retry) == 0 {
            Exit(1);
        }
        i = Expect(content, i, ")");
        if i < 0 {
            Exit(1);
        }
    }
    i = Expect(content, i, "{");
    if i < 0 {
        Exit(1);
    }
    // Walk the body collecting mode, steps, success, failure.
    let intent_policy: ParserIntentPolicyClause =
        ParserIntentPolicyClauseDefault();
    let step_blocks: String = "";
    let success_text: String = "";
    let failure_text: String = "";
    let default_who: String = "";
    let default_where: String = "";
    let terminal_success_steps: Array<String> = [];
    let terminal_success_texts: Array<String> = [];
    let terminal_success_graphs: AstExpressionGraphRows = AstExpressionGraphRowsEmpty();
    let terminal_failure_steps: Array<String> = [];
    let terminal_failure_texts: Array<String> = [];
    let terminal_failure_graphs: AstExpressionGraphRows = AstExpressionGraphRowsEmpty();
    let intent_expression_graphs: Array<AstExpressionGraphRows> = [];
    ParserExpressionGraphRowsBoxStart(
        intent_expression_graphs, AstExpressionGraphRowsEmpty()
    );
    while true {
        i = SkipWhitespaceAndComments(content, i);
        if i >= n {
            Exit(1);
        }
        if ParserCharAt(content, i) == "}" {
            i = i + 1;
            break;
        }
        let policy_clause: ParserIntentPolicyClause =
            ParserIntentPolicyClauseFromSource(content, i, intent_policy);
        if policy_clause.matched {
            if !policy_clause.ok { Exit(1); }
            intent_policy = policy_clause;
            i = policy_clause.next;
            continue;
        }
        let default_clause: ParserIntentDefaultClause = ParserIntentDefaultClauseFromSource(content, i);
        if default_clause.matched {
            if !default_clause.ok ||
                (default_clause.who_names != "" && default_who != "") ||
                (default_clause.where_type != "" && default_where != "") { Exit(1); }
            if default_clause.who_names != "" { default_who = default_clause.who_names; }
            if default_clause.where_type != "" { default_where = default_clause.where_type; }
            i = default_clause.next;
            continue;
        }
        if MatchLanguageWord(content, i, LanguageWordId.WordSuccess) {
            i = LanguageWordEnd(i, LanguageWordId.WordSuccess);
            ArraySet(cursor_out, 0, i);
            let terminal: ParserIntentTerminalClause =
                ParseIntentTerminalClause(
                content, i, cursor_out
            );
            if !terminal.ok { Exit(1); }
            i = cursor_out[0];
            if terminal.step_name == "" {
                if success_text != "" { Exit(1); }
                success_text = terminal.expression.text;
            } else {
                ArrayPush(terminal_success_steps, terminal.step_name);
                ArrayPush(terminal_success_texts, terminal.expression.text);
                terminal_success_graphs = ParserExpressionGraphsAppend(
                    terminal_success_graphs,
                    TypedAstKindIntentTerminalSuccessTag(),
                    AstExpressionLaneAtom(), terminal.expression
                );
            }
            continue;
        }
        if MatchLanguageWord(content, i, LanguageWordId.WordFailure) {
            i = LanguageWordEnd(i, LanguageWordId.WordFailure);
            ArraySet(cursor_out, 0, i);
            let terminal: ParserIntentTerminalClause =
                ParseIntentTerminalClause(
                content, i, cursor_out
            );
            if !terminal.ok { Exit(1); }
            i = cursor_out[0];
            if terminal.step_name == "" {
                if failure_text != "" { Exit(1); }
                failure_text = terminal.expression.text;
            } else {
                ArrayPush(terminal_failure_steps, terminal.step_name);
                ArrayPush(terminal_failure_texts, terminal.expression.text);
                terminal_failure_graphs = ParserExpressionGraphsAppend(
                    terminal_failure_graphs,
                    TypedAstKindIntentTerminalFailureTag(),
                    AstExpressionLaneAtom(), terminal.expression
                );
            }
            continue;
        }
        if MatchLanguageWord(content, i, LanguageWordId.WordStep) {
            i = LanguageWordEnd(i, LanguageWordId.WordStep);
            i = SkipWhitespaceAndComments(content, i);
            ArraySet(cursor_out, 0, i);
            let step_name: String = ReadIdent(content, i, cursor_out);
            i = cursor_out[0];
            if StringLength(step_name) == 0 {
                Exit(1);
            }
            let predecessor_name: String = "";
            i = SkipWhitespaceAndComments(content, i);
            if MatchLanguageWord(content, i, LanguageWordId.WordAfter) {
                if intent_return_type == "" { Exit(1); }
                i = LanguageWordEnd(i, LanguageWordId.WordAfter);
                i = SkipWhitespaceAndComments(content, i);
                ArraySet(cursor_out, 0, i);
                predecessor_name = ReadIdent(content, i, cursor_out);
                i = cursor_out[0];
                if predecessor_name == "" { Exit(1); }
            }
            i = Expect(content, i, "{");
            if i < 0 {
                Exit(1);
            }
            let s_where: String = "";
            let s_using: String = "";
            let s_who: String = "";
            let s_on: String = "";
            let s_outcome: String = "";
            let s_success_pattern: String = "";
            let s_failure_pattern: String = "";
            let s_on_seen: Bool = false;
            let s_guard: String = "";
            let s_guard_seen: Bool = false;
            let s_expect: String = "";
            let s_expect_seen: Bool = false;
            let s_requires: String = "";
            let s_auth: String = "";
            let s_causes: String = "";
            let s_transfer: String = "";
            let s_compensates: Array<String> = [];
            let s_post: String = "";
            let s_post_seen: Bool = false;
            let s_intent: String = "";
            let s_on_fact: ParserExpressionFact = ParserExpressionInvalid();
            let s_guard_fact: ParserExpressionFact = ParserExpressionInvalid();
            let s_expect_fact: ParserExpressionFact = ParserExpressionInvalid();
            let s_compensate_graphs: AstExpressionGraphRows = AstExpressionGraphRowsEmpty();
            let s_post_fact: ParserExpressionFact = ParserExpressionInvalid();
            let s_intent_fact: ParserExpressionFact = ParserExpressionInvalid();
            while true {
                i = SkipWhitespaceAndComments(content, i);
                if i >= n {
                    Exit(1);
                }
                if ParserCharAt(content, i) == "}" {
                    i = i + 1;
                    break;
                }
                ArraySet(cursor_out, 0, i);
                let clause: String = ReadIdent(content, i, cursor_out);
                i = cursor_out[0];
                if StringLength(clause) == 0 {
                    Exit(1);
                }
                let is_transfer: Bool = false;
                if clause == "move" {
                    is_transfer = true;
                } else if clause == "transfer" {
                    let peek_colon: Int = SkipWhitespaceAndComments(content, i);
                    if ParserCharAt(content, peek_colon) != ":" {
                        is_transfer = true;
                    }
                }
                if is_transfer {
                    i = SkipWhitespaceAndComments(content, i);
                    ArraySet(cursor_out, 0, i);
                    let t_from: String = ParseExpr(content, i, cursor_out);
                    i = cursor_out[0];
                    i = SkipWhitespaceAndComments(content, i);
                    if !MatchLanguageWord(content, i, LanguageWordId.WordTo) {
                        Exit(1);
                    }
                    i = LanguageWordEnd(i, LanguageWordId.WordTo);
                    i = SkipWhitespaceAndComments(content, i);
                    ArraySet(cursor_out, 0, i);
                    let t_to: String = ParseExpr(content, i, cursor_out);
                    i = cursor_out[0];
                    i = Expect(content, i, ";");
                    if i < 0 {
                        Exit(1);
                    }
                    s_transfer = Concat(t_from, Concat(" -> ", t_to));
                    continue;
                }
                if clause == "success" || clause == "failure" {
                    if intent_return_type == "" { Exit(1); }
                    if clause == "success" && s_success_pattern != "" {
                        Exit(1);
                    }
                    if clause == "failure" && s_failure_pattern != "" {
                        Exit(1);
                    }
                    i = Expect(content, i, ":");
                    if i < 0 { Exit(1); }
                    ArraySet(cursor_out, 0, i);
                    let pattern: ParserIntentVariantBinding =
                        ParseIntentVariantBinding(content, i, cursor_out);
                    if !pattern.ok { Exit(1); }
                    i = cursor_out[0];
                    i = Expect(content, i, ";");
                    if i < 0 { Exit(1); }
                    if clause == "success" {
                        s_success_pattern = pattern.text;
                    } else {
                        s_failure_pattern = pattern.text;
                    }
                    continue;
                }
                if clause == "authorized" {
                    let peek_by: Int = SkipWhitespaceAndComments(content, i);
                    if MatchLanguageWord(content, peek_by, LanguageWordId.WordBy) {
                        i = LanguageWordEnd(peek_by, LanguageWordId.WordBy);
                        clause = "authorized by";
                    }
                }
                if clause == "on" {
                    if s_on_seen { Exit(1); }
                    s_on_seen = true;
                    let on_head: Int = SkipWhitespaceAndComments(content, i);
                    if ParserCharAt(content, on_head) != ":" {
                        if on_head >= n || !SourceByteIsAlpha(
                            SourceByteAt(content, n, on_head)
                        ) { Exit(1); }
                        ArraySet(cursor_out, 0, on_head);
                        s_outcome = ReadIdent(content, on_head, cursor_out);
                        i = cursor_out[0];
                        if s_outcome == "" { Exit(1); }
                    }
                }
                if clause == "guard" {
                    if s_guard_seen { Exit(1); }
                    s_guard_seen = true;
                }
                if clause == "post" {
                    if s_post_seen { Exit(1); }
                    s_post_seen = true;
                }
                if clause == "expect" {
                    if s_expect_seen { Exit(1); }
                    s_expect_seen = true;
                }
                i = Expect(content, i, ":");
                if i < 0 {
                    Exit(1);
                }
                let val: String = "";
                if clause == "transfer" {
                    i = SkipWhitespaceAndComments(content, i);
                    let t_start: Int = i;
                    while i < n && ParserCharAt(content, i) != ";" {
                        i = i + 1;
                    }
                    val = Substring(content, t_start, i - t_start);
                    val = StringTrim(val);
                    ArraySet(cursor_out, 0, i);
                } else {
                    ArraySet(cursor_out, 0, i);
                    let val_fact: ParserExpressionFact = ParseExprFact(
                        content, i, cursor_out
                    );
                    if !val_fact.ok { Exit(1); }
                    val = val_fact.text;
                    if clause == "on" { s_on_fact = val_fact; }
                    if clause == "guard" { s_guard_fact = val_fact; }
                    if clause == "expect" { s_expect_fact = val_fact; }
                    if clause == "compensate" {
                        s_compensate_graphs = ParserExpressionGraphsAppend(
                            s_compensate_graphs,
                            TypedAstKindIntentStepCompensateTag(),
                            AstExpressionLaneAtom(), val_fact
                        );
                    }
                    if clause == "post" { s_post_fact = val_fact; }
                    if clause == "intent" { s_intent_fact = val_fact; }
                    i = cursor_out[0];
                }
                i = Expect(content, i, ";");
                if i < 0 {
                    Exit(1);
                }
                if clause == "where" {
                    s_where = val;
                } else if clause == "using" {
                    s_using = val;
                } else if clause == "who" {
                    s_who = val;
                } else if clause == "on" {
                    s_on = val;
                } else if clause == "guard" {
                    s_guard = val;
                } else if clause == "expect" {
                    s_expect = val;
                } else if clause == "requires" {
                    s_requires = val;
                } else if clause == "authorized by" {
                    s_auth = val;
                } else if clause == "causes" {
                    s_causes = val;
                } else if clause == "compensate" {
                    ArrayPush(s_compensates, val);
                } else if clause == "post" {
                    s_post = val;
                } else if clause == "intent" {
                    s_intent = val;
                } else if clause == "transfer" {
                    s_transfer = val;
                } else {
                    Exit(1);
                }
            }
            let defaults: ParserIntentStepDefaults = ParserIntentStepDefaultsResolve(
                default_who, default_where, s_who, s_where
            );
            s_who = defaults.who_names;
            s_where = defaults.where_type;
            let step_header: String = Concat("    IntentStep: ", step_name);
            if predecessor_name != "" {
                step_header = Concat(
                    step_header, Concat(" after ", predecessor_name)
                );
            }
            if StringLength(s_where) > 0 {
                step_header = Concat(step_header, Concat(" where ", s_where));
            }
            if StringLength(s_using) > 0 {
                step_header = Concat(step_header, Concat(" using ", s_using));
            }
            if StringLength(s_intent) > 0 {
                step_header = Concat(step_header, Concat(" intent ", s_intent));
            }
            if StringLength(s_transfer) > 0 {
                step_header = Concat(step_header, Concat(" transfer ", s_transfer));
            }
            let step_out: String = step_header;
            if StringLength(s_who) > 0 {
                step_out = AppendLine(step_out, Concat("      Who: ", s_who));
            }
            if StringLength(s_using) > 0 {
                step_out = AppendLine(step_out, Concat("      Using: ", s_using));
            }
            if StringLength(s_transfer) > 0 {
                step_out = AppendLine(step_out, Concat("      Transfer: ", s_transfer));
            }
            if StringLength(s_intent) > 0 {
                step_out = AppendLine(step_out, Concat("      Intent: ", s_intent));
            }
            if StringLength(s_outcome) > 0 {
                step_out = AppendLine(step_out, Concat("      Outcome: ", s_outcome));
            }
            if StringLength(s_on) > 0 {
                step_out = AppendLine(step_out, Concat("      On: ", s_on));
            }
            if StringLength(s_success_pattern) > 0 {
                step_out = AppendLine(step_out, Concat(
                    "      IntentStepSuccess: ", s_success_pattern
                ));
            }
            if StringLength(s_failure_pattern) > 0 {
                step_out = AppendLine(step_out, Concat(
                    "      IntentStepFailure: ", s_failure_pattern
                ));
            }
            let compensate_i: Int = 0;
            while compensate_i < ArrayLength(s_compensates) {
                step_out = AppendLine(step_out, Concat(
                    "      Compensate: ", s_compensates[compensate_i]
                ));
                compensate_i = compensate_i + 1;
            }
            if StringLength(s_guard) > 0 {
                step_out = AppendLine(step_out, Concat("      Guard: ", s_guard));
            }
            if StringLength(s_post) > 0 {
                step_out = AppendLine(step_out, Concat("      Post: ", s_post));
            }
            if StringLength(s_requires) > 0 {
                step_out = AppendLine(step_out, Concat("      Requires: ", s_requires));
            }
            if StringLength(s_auth) > 0 {
                step_out = AppendLine(step_out, Concat("      AuthorizedBy: ", s_auth));
            }
            if StringLength(s_causes) > 0 {
                step_out = AppendLine(step_out, Concat("      Causes: ", s_causes));
            }
            if StringLength(s_expect) > 0 {
                step_out = AppendLine(step_out, Concat("      Expect: ", s_expect));
            }
            if defaults.provenance_text != "" {
                step_out = AppendLine(step_out, Concat("      ContractProvenance: ", defaults.provenance_text));
            }
            if StringLength(s_on) > 0 {
                ParserExpressionGraphsAppendInto(
                    intent_expression_graphs, TypedAstKindIntentStepOnTag(),
                    AstExpressionLaneAtom(), s_on_fact
                );
            }
            if StringLength(s_intent) > 0 {
                ParserExpressionGraphsAppendInto(
                    intent_expression_graphs, TypedAstKindIntentStepIntentTag(), AstExpressionLaneAtom(), s_intent_fact
                );
            }
            ParserExpressionGraphsAppendRowsInto(intent_expression_graphs, s_compensate_graphs);
            if StringLength(s_guard) > 0 {
                ParserExpressionGraphsAppendInto(
                    intent_expression_graphs, TypedAstKindIntentStepGuardTag(),
                    AstExpressionLaneAtom(), s_guard_fact
                );
            }
            if StringLength(s_post) > 0 {
                ParserExpressionGraphsAppendInto(
                    intent_expression_graphs, TypedAstKindIntentStepPostTag(),
                    AstExpressionLaneAtom(), s_post_fact
                );
            }
            if StringLength(s_expect) > 0 {
                ParserExpressionGraphsAppendInto(
                    intent_expression_graphs, TypedAstKindIntentStepExpectTag(),
                    AstExpressionLaneAtom(), s_expect_fact
                );
            }
            step_blocks = AppendLine(step_blocks, step_out);
            if intent_return_type != "" &&
                (s_outcome == "" || s_success_pattern == "" ||
                 s_failure_pattern == "" ||
                 s_success_pattern == s_failure_pattern) {
                Exit(1); }
            continue;
        }
        Exit(1);
    }
    let typed_result: Bool = intent_return_type != "";
    if typed_result {
        if success_text != "" || failure_text != "" ||
            ArrayLength(terminal_success_steps) != 1 ||
            ArrayLength(terminal_failure_steps) == 0 {
            Exit(1); }
    } else if ArrayLength(terminal_success_steps) > 0 ||
        ArrayLength(terminal_failure_steps) > 0 {
        Exit(1);
    }
    out = AppendLine(out, Concat("  Intent: ", Concat(decl_prefix, intent_name)));
    if typed_result { out = AppendLine(out, Concat(
        "    IntentReturns: ", intent_return_type)); }
    out = ParserIntentPolicyTreeAppend(out, expression_graphs, intent_policy);
    if StringLength(intent_retry) > 0 {
        out = AppendLine(out, Concat("    IntentRetry: ", intent_retry));
    }
    let parameter_i: Int = 0;
    while parameter_i < ArrayLength(parameter_lines) {
        out = AppendLine(out, Concat("    ", parameter_lines[parameter_i]));
        parameter_i = parameter_i + 1;
    }
    if StringLength(step_blocks) > 0 {
        out = AppendLine(out, step_blocks);
    }
    if StringLength(success_text) > 0 {
        out = AppendLine(out, Concat("    IntentSuccess: ", success_text));
    }
    if StringLength(failure_text) > 0 {
        out = AppendLine(out, Concat("    IntentFailure: ", failure_text));
    }
    let terminal_i: Int = 0;
    while terminal_i < ArrayLength(terminal_success_steps) {
        out = AppendLine(out, Concat(
            "    IntentTerminalSuccess: ", Concat(
                terminal_success_steps[terminal_i],
                Concat(" => ", terminal_success_texts[terminal_i]))
        ));
        terminal_i = terminal_i + 1;
    }
    ParserExpressionGraphsAppendRowsInto(intent_expression_graphs, terminal_success_graphs);
    terminal_i = 0;
    while terminal_i < ArrayLength(terminal_failure_steps) {
        out = AppendLine(out, Concat(
            "    IntentTerminalFailure: ", Concat(
                terminal_failure_steps[terminal_i],
                Concat(" => ", terminal_failure_texts[terminal_i]))
        ));
        terminal_i = terminal_i + 1;
    }
    ParserExpressionGraphsAppendRowsInto(intent_expression_graphs, terminal_failure_graphs);
    ParserExpressionGraphsAppendRowsInto(expression_graphs, intent_expression_graphs[0]);
    ArraySet(cursor_out, 0, i); return out;
}
