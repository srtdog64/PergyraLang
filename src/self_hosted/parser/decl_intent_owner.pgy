// Self-host parser intent declaration owner.

import "cursor_owner.pgy";
import "tree_text_owner.pgy";
import "type_name_owner.pgy";
import "expr_owner.pgy";

func ParseIntentDecl(
    content: String, start: Int, inout cursor_out: Array<Int>,
    decl_prefix: String, inout involve_types: Array<String>,
    inout expression_graphs: Array<AstExpressionGraphRows>
) -> String {
    let i: Int = start;
    let n: Int = StringLength(content);
    let out: String = "";
    i = LanguageWordEnd(i, LanguageWordId.WordIntent);
    i = SkipWhitespaceAndComments(content, i);
    ArraySet(cursor_out, 0, i);
    let intent_name: String = ReadIdent(content, i, cursor_out);
    i = cursor_out[0];
    if StringLength(intent_name) == 0 {
        Exit(1);
    }
    i = Expect(content, i, "(");
    if i < 0 {
        Exit(1);
    }
    // Parse params and split into Involves vs Value by type.
    let involves_lines: Array<String> = [];
    let value_lines: Array<String> = [];
    i = SkipWhitespaceAndComments(content, i);
    if ParserCharAt(content, i) != ")" {
        while true {
            i = SkipWhitespaceAndComments(content, i);
            ArraySet(cursor_out, 0, i);
            let ip_name: String = ReadIdent(content, i, cursor_out);
            i = cursor_out[0];
            if StringLength(ip_name) == 0 {
                Exit(1);
            }
            i = Expect(content, i, ":");
            if i < 0 {
                Exit(1);
            }
            i = SkipWhitespaceAndComments(content, i);
            // Snapshot the base type name before ReadType
            // mangles it; primitive-ness is decided on the
            // base, not on the full `Map<String: String, ...>`
            // print form.
            let probe_i: Int = i;
            ArraySet(cursor_out, 0, probe_i);
            let base_name: String = ReadIdent(content, probe_i, cursor_out);
            ArraySet(cursor_out, 0, i);
            let ip_type: String = ReadType(content, i, cursor_out);
            i = cursor_out[0];
            if StringLength(ip_type) == 0 {
                Exit(1);
            }
            let row: String = Concat(ip_name, Concat(": ", ip_type));
            let is_involve: Bool = false;
            let k: Int = 0;
            let n_inv: Int = ArrayLength(involve_types);
            while k < n_inv {
                if base_name == involve_types[k] {
                    is_involve = true;
                }
                k = k + 1;
            }
            if is_involve {
                ArrayPush(involves_lines, row);
            } else {
                ArrayPush(value_lines, row);
            }
            i = SkipWhitespaceAndComments(content, i);
            if ParserCharAt(content, i) == "," {
                i = i + 1;
                continue;
            }
            break;
        }
    }
    i = Expect(content, i, ")");
    if i < 0 {
        Exit(1);
    }
    let intent_retry: String = "";
    i = SkipWhitespaceAndComments(content, i);
    if MatchLanguageWord(content, i, LanguageWordId.WordWith) {
        i = LanguageWordEnd(i, LanguageWordId.WordWith);
        i = SkipWhitespaceAndComments(content, i);
        if !MatchLanguageWord(content, i, LanguageWordId.WordRetry) {
            Exit(1);
        }
        i = LanguageWordEnd(i, LanguageWordId.WordRetry);
        i = Expect(content, i, "(");
        if i < 0 {
            Exit(1);
        }
        i = SkipWhitespaceAndComments(content, i);
        ArraySet(cursor_out, 0, i);
        intent_retry = ReadNumber(content, i, cursor_out);
        i = cursor_out[0];
        if StringLength(intent_retry) == 0 {
            Exit(1);
        }
        i = Expect(content, i, ")");
        if i < 0 {
            Exit(1);
        }
    }
    i = Expect(content, i, "{");
    if i < 0 {
        Exit(1);
    }
    // Walk the body collecting mode, steps, success, failure.
    let intent_mode: String = "exclusive";
    let step_blocks: String = "";
    let success_text: String = "";
    let failure_text: String = "";
    while true {
        i = SkipWhitespaceAndComments(content, i);
        if i >= n {
            Exit(1);
        }
        if ParserCharAt(content, i) == "}" {
            i = i + 1;
            break;
        }
        if MatchLanguageWord(content, i, LanguageWordId.WordExclusive) {
            i = LanguageWordEnd(i, LanguageWordId.WordExclusive);
            i = Expect(content, i, ";");
            if i < 0 {
                Exit(1);
            }
            intent_mode = "exclusive";
            continue;
        }
        if MatchLanguageWord(content, i, LanguageWordId.WordConcurrent) {
            i = LanguageWordEnd(i, LanguageWordId.WordConcurrent);
            i = Expect(content, i, ";");
            if i < 0 {
                Exit(1);
            }
            intent_mode = "concurrent";
            continue;
        }
        if MatchLanguageWord(content, i, LanguageWordId.WordSuccess) {
            i = LanguageWordEnd(i, LanguageWordId.WordSuccess);
            i = Expect(content, i, ":");
            if i < 0 {
                Exit(1);
            }
            ArraySet(cursor_out, 0, i);
            success_text = ParseExpr(content, i, cursor_out);
            i = cursor_out[0];
            i = Expect(content, i, ";");
            if i < 0 {
                Exit(1);
            }
            continue;
        }
        if MatchLanguageWord(content, i, LanguageWordId.WordFailure) {
            i = LanguageWordEnd(i, LanguageWordId.WordFailure);
            i = Expect(content, i, ":");
            if i < 0 {
                Exit(1);
            }
            ArraySet(cursor_out, 0, i);
            failure_text = ParseExpr(content, i, cursor_out);
            i = cursor_out[0];
            i = Expect(content, i, ";");
            if i < 0 {
                Exit(1);
            }
            continue;
        }
        if MatchLanguageWord(content, i, LanguageWordId.WordStep) {
            i = LanguageWordEnd(i, LanguageWordId.WordStep);
            i = SkipWhitespaceAndComments(content, i);
            ArraySet(cursor_out, 0, i);
            let step_name: String = ReadIdent(content, i, cursor_out);
            i = cursor_out[0];
            if StringLength(step_name) == 0 {
                Exit(1);
            }
            i = Expect(content, i, "{");
            if i < 0 {
                Exit(1);
            }
            let s_where: String = "";
            let s_using: String = "";
            let s_who: String = "";
            let s_on: String = "";
            let s_outcome: String = "";
            let s_on_seen: Bool = false;
            let s_guard: String = "";
            let s_guard_seen: Bool = false;
            let s_expect: String = "";
            let s_expect_seen: Bool = false;
            let s_requires: String = "";
            let s_auth: String = "";
            let s_causes: String = "";
            let s_transfer: String = "";
            let s_compensates: Array<String> = [];
            let s_post: String = "";
            let s_post_seen: Bool = false;
            let s_intent: String = "";
            let s_on_fact: ParserExpressionFact = ParserExpressionInvalid();
            let s_guard_fact: ParserExpressionFact = ParserExpressionInvalid();
            let s_expect_fact: ParserExpressionFact = ParserExpressionInvalid();
            let s_compensate_facts: Array<ParserExpressionFact> = [];
            let s_post_fact: ParserExpressionFact = ParserExpressionInvalid();
            while true {
                i = SkipWhitespaceAndComments(content, i);
                if i >= n {
                    Exit(1);
                }
                if ParserCharAt(content, i) == "}" {
                    i = i + 1;
                    break;
                }
                ArraySet(cursor_out, 0, i);
                let clause: String = ReadIdent(content, i, cursor_out);
                i = cursor_out[0];
                if StringLength(clause) == 0 {
                    Exit(1);
                }

                let is_transfer: Bool = false;
                if clause == "move" {
                    is_transfer = true;
                } else if clause == "transfer" {
                    let peek_colon: Int = SkipWhitespaceAndComments(content, i);
                    if ParserCharAt(content, peek_colon) != ":" {
                        is_transfer = true;
                    }
                }
                if is_transfer {
                    i = SkipWhitespaceAndComments(content, i);
                    ArraySet(cursor_out, 0, i);
                    let t_from: String = ParseExpr(content, i, cursor_out);
                    i = cursor_out[0];
                    i = SkipWhitespaceAndComments(content, i);
                    if !MatchLanguageWord(content, i, LanguageWordId.WordTo) {
                        Exit(1);
                    }
                    i = LanguageWordEnd(i, LanguageWordId.WordTo);
                    i = SkipWhitespaceAndComments(content, i);
                    ArraySet(cursor_out, 0, i);
                    let t_to: String = ParseExpr(content, i, cursor_out);
                    i = cursor_out[0];
                    i = Expect(content, i, ";");
                    if i < 0 {
                        Exit(1);
                    }
                    s_transfer = Concat(t_from, Concat(" -> ", t_to));
                    continue;
                }

                if clause == "authorized" {
                    let peek_by: Int = SkipWhitespaceAndComments(content, i);
                    if MatchLanguageWord(content, peek_by, LanguageWordId.WordBy) {
                        i = LanguageWordEnd(peek_by, LanguageWordId.WordBy);
                        clause = "authorized by";
                    }
                }
                if clause == "on" {
                    if s_on_seen { Exit(1); }
                    s_on_seen = true;
                    let on_head: Int = SkipWhitespaceAndComments(content, i);
                    if ParserCharAt(content, on_head) != ":" {
                        if on_head >= n || !SourceByteIsAlpha(
                            SourceByteAt(content, n, on_head)
                        ) { Exit(1); }
                        ArraySet(cursor_out, 0, on_head);
                        s_outcome = ReadIdent(content, on_head, cursor_out);
                        i = cursor_out[0];
                        if s_outcome == "" { Exit(1); }
                    }
                }
                if clause == "guard" {
                    if s_guard_seen { Exit(1); }
                    s_guard_seen = true;
                }
                if clause == "post" {
                    if s_post_seen { Exit(1); }
                    s_post_seen = true;
                }
                if clause == "expect" {
                    if s_expect_seen { Exit(1); }
                    s_expect_seen = true;
                }
                i = Expect(content, i, ":");
                if i < 0 {
                    Exit(1);
                }
                let val: String = "";
                if clause == "transfer" {
                    i = SkipWhitespaceAndComments(content, i);
                    let t_start: Int = i;
                    while i < n && ParserCharAt(content, i) != ";" {
                        i = i + 1;
                    }
                    val = Substring(content, t_start, i - t_start);
                    val = StringTrim(val);
                    ArraySet(cursor_out, 0, i);
                } else {
                    ArraySet(cursor_out, 0, i);
                    let val_fact: ParserExpressionFact = ParseExprFact(
                        content, i, cursor_out
                    );
                    if !val_fact.ok { Exit(1); }
                    val = val_fact.text;
                    if clause == "on" { s_on_fact = val_fact; }
                    if clause == "guard" { s_guard_fact = val_fact; }
                    if clause == "expect" { s_expect_fact = val_fact; }
                    if clause == "compensate" {
                        ArrayPush(s_compensate_facts, val_fact);
                    }
                    if clause == "post" { s_post_fact = val_fact; }
                    i = cursor_out[0];
                }
                i = Expect(content, i, ";");
                if i < 0 {
                    Exit(1);
                }
                if clause == "where" {
                    s_where = val;
                } else if clause == "using" {
                    s_using = val;
                } else if clause == "who" {
                    s_who = val;
                } else if clause == "on" {
                    s_on = val;
                } else if clause == "guard" {
                    s_guard = val;
                } else if clause == "expect" {
                    s_expect = val;
                } else if clause == "requires" {
                    s_requires = val;
                } else if clause == "authorized by" {
                    s_auth = val;
                } else if clause == "causes" {
                    s_causes = val;
                } else if clause == "compensate" {
                    ArrayPush(s_compensates, val);
                } else if clause == "post" {
                    s_post = val;
                } else if clause == "intent" {
                    s_intent = val;
                } else if clause == "transfer" {
                    s_transfer = val;
                } else {
                    Exit(1);
                }
            }
            let step_header: String = Concat("    IntentStep: ", step_name);
            if StringLength(s_intent) > 0 {
                step_header = Concat(step_header, Concat(" intent ", s_intent));
            }
            if StringLength(s_where) > 0 {
                step_header = Concat(step_header, Concat(" where ", s_where));
            }
            if StringLength(s_using) > 0 {
                step_header = Concat(step_header, Concat(" using ", s_using));
            }
            if StringLength(s_transfer) > 0 {
                step_header = Concat(step_header, Concat(" transfer ", s_transfer));
            }
            let step_out: String = step_header;
            if StringLength(s_who) > 0 {
                step_out = AppendLine(step_out, Concat("      Who: ", s_who));
            }
            if StringLength(s_using) > 0 {
                step_out = AppendLine(step_out, Concat("      Using: ", s_using));
            }
            if StringLength(s_transfer) > 0 {
                step_out = AppendLine(step_out, Concat("      Transfer: ", s_transfer));
            }
            if StringLength(s_intent) > 0 {
                step_out = AppendLine(step_out, Concat("      Intent: ", s_intent));
            }
            if StringLength(s_outcome) > 0 {
                step_out = AppendLine(step_out, Concat("      Outcome: ", s_outcome));
            }
            if StringLength(s_on) > 0 {
                step_out = AppendLine(step_out, Concat("      On: ", s_on));
            }
            let compensate_i: Int = 0;
            while compensate_i < ArrayLength(s_compensates) {
                step_out = AppendLine(step_out, Concat(
                    "      Compensate: ", s_compensates[compensate_i]
                ));
                compensate_i = compensate_i + 1;
            }
            if StringLength(s_guard) > 0 {
                step_out = AppendLine(step_out, Concat("      Guard: ", s_guard));
            }
            if StringLength(s_post) > 0 {
                step_out = AppendLine(step_out, Concat("      Post: ", s_post));
            }
            if StringLength(s_requires) > 0 {
                step_out = AppendLine(step_out, Concat("      Requires: ", s_requires));
            }
            if StringLength(s_auth) > 0 {
                step_out = AppendLine(step_out, Concat("      AuthorizedBy: ", s_auth));
            }
            if StringLength(s_causes) > 0 {
                step_out = AppendLine(step_out, Concat("      Causes: ", s_causes));
            }
            if StringLength(s_expect) > 0 {
                step_out = AppendLine(step_out, Concat("      Expect: ", s_expect));
            }
            if StringLength(s_on) > 0 {
                ArraySet(expression_graphs, 0, ParserExpressionGraphsAppend(
                    expression_graphs[0], TypedAstKindIntentStepOnTag(),
                    AstExpressionLaneAtom(), s_on_fact
                ));
            }
            compensate_i = 0;
            while compensate_i < ArrayLength(s_compensate_facts) {
                ArraySet(expression_graphs, 0, ParserExpressionGraphsAppend(
                    expression_graphs[0],
                    TypedAstKindIntentStepCompensateTag(),
                    AstExpressionLaneAtom(), s_compensate_facts[compensate_i]
                ));
                compensate_i = compensate_i + 1;
            }
            if StringLength(s_guard) > 0 {
                ArraySet(expression_graphs, 0, ParserExpressionGraphsAppend(
                    expression_graphs[0], TypedAstKindIntentStepGuardTag(),
                    AstExpressionLaneAtom(), s_guard_fact
                ));
            }
            if StringLength(s_post) > 0 {
                ArraySet(expression_graphs, 0, ParserExpressionGraphsAppend(
                    expression_graphs[0], TypedAstKindIntentStepPostTag(),
                    AstExpressionLaneAtom(), s_post_fact
                ));
            }
            if StringLength(s_expect) > 0 {
                ArraySet(expression_graphs, 0, ParserExpressionGraphsAppend(
                    expression_graphs[0], TypedAstKindIntentStepExpectTag(),
                    AstExpressionLaneAtom(), s_expect_fact
                ));
            }
            step_blocks = AppendLine(step_blocks, step_out);
            continue;
        }
        Exit(1);
    }
    out = AppendLine(out, Concat("  Intent: ", Concat(decl_prefix, intent_name)));
    out = AppendLine(out, Concat("    IntentMode: ", intent_mode));
    out = AppendLine(out, "    IntentRollback: full");
    if StringLength(intent_retry) > 0 {
        out = AppendLine(out, Concat("    IntentRetry: ", intent_retry));
    }
    let inv_len: Int = ArrayLength(involves_lines);
    let inv_i: Int = 0;
    while inv_i < inv_len {
        out = AppendLine(out, Concat("    IntentInvolves: ", involves_lines[inv_i]));
        inv_i = inv_i + 1;
    }
    let val_len: Int = ArrayLength(value_lines);
    let val_i: Int = 0;
    while val_i < val_len {
        out = AppendLine(out, Concat("    IntentValue: ", value_lines[val_i]));
        val_i = val_i + 1;
    }
    if StringLength(step_blocks) > 0 {
        out = AppendLine(out, step_blocks);
    }
    if StringLength(success_text) > 0 {
        out = AppendLine(out, Concat("    IntentSuccess: ", success_text));
    }
    if StringLength(failure_text) > 0 {
        out = AppendLine(out, Concat("    IntentFailure: ", failure_text));
    }
    ArraySet(cursor_out, 0, i); return out;
}
