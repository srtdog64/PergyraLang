// Self-host parser nominal/domain host declaration owner.

import "cursor_owner.pgy";
import "tree_text_owner.pgy";
import "type_name_owner.pgy";
import "expr_owner.pgy";
import "function_decl_owner.pgy";
import "generic_parameter_list_owner.pgy";

func ParseNominalDecl(
    content: String,
    start: Int,
    inout cursor_out: Array<Int>,
    decl_prefix: String,
    within_zone: String,
    inout involve_types: Array<String>,
    inout expression_graphs: Array<AstExpressionGraphRows>
) -> String {
    let i: Int = start;
    let n: Int = StringLength(content);
    let out: String = "";
    let decl_label: String = "";
    let decl_kw_len: Int = 0;
    if MatchLanguageWord(content, i, LanguageWordId.WordSubject) {
        decl_label = "Subject";
        decl_kw_len = LanguageWordLength(LanguageWordId.WordSubject);
    } else if MatchLanguageWord(content, i, LanguageWordId.WordClass) {
        decl_label = "Class";
        decl_kw_len = LanguageWordLength(LanguageWordId.WordClass);
    } else if MatchLanguageWord(content, i, LanguageWordId.WordVessel) {
        decl_label = "Vessel";
        decl_kw_len = LanguageWordLength(LanguageWordId.WordVessel);
    } else if MatchLanguageWord(content, i, LanguageWordId.WordStruct) {
        decl_label = "Struct";
        decl_kw_len = LanguageWordLength(LanguageWordId.WordStruct);
    } else if MatchLanguageWord(content, i, LanguageWordId.WordObject) {
        decl_label = "Object";
        decl_kw_len = LanguageWordLength(LanguageWordId.WordObject);
    } else if MatchLanguageWord(content, i, LanguageWordId.WordTobject) {
        decl_label = "TObject";
        decl_kw_len = LanguageWordLength(LanguageWordId.WordTobject);
    } else if MatchLanguageWord(content, i, LanguageWordId.WordParty) {
        decl_label = "Party";
        decl_kw_len = LanguageWordLength(LanguageWordId.WordParty);
    } else if MatchLanguageWord(content, i, LanguageWordId.WordRoster) {
        decl_label = "Roster";
        decl_kw_len = LanguageWordLength(LanguageWordId.WordRoster);
    } else if MatchLanguageWord(content, i, LanguageWordId.WordWorld) {
        decl_label = "World";
        decl_kw_len = LanguageWordLength(LanguageWordId.WordWorld);
    }
    if decl_kw_len > 0 {
        i = i + decl_kw_len;
        i = SkipWhitespaceAndComments(content, i);
        ArraySet(cursor_out, 0, i);
        let decl_name: String = ReadIdent(content, i, cursor_out);
        i = cursor_out[0];
        if StringLength(decl_name) == 0 {
            Exit(1);
        }
        if decl_label == "Subject" {
            ArrayPush(involve_types, decl_name);
        }
        // Optional generic parameter list `<T, U>` after the type
        // name — emitted on its own `Generic params:` line at +4
        // before `Fields:` / `Methods:`.
        ArraySet(cursor_out, 0, i);
        let decl_generic: String = ParseGenericParameterListText(
            content, i, cursor_out
        );
        i = cursor_out[0];
        let decl_suffix: String = "";
        i = SkipWhitespaceAndComments(content, i);
        if MatchLanguageWord(content, i, LanguageWordId.WordExtends) {
            i = LanguageWordEnd(i, LanguageWordId.WordExtends);
            i = SkipWhitespaceAndComments(content, i);
            ArraySet(cursor_out, 0, i);
            let parent_name: String = ReadType(content, i, cursor_out);
            i = cursor_out[0];
            if StringLength(parent_name) == 0 {
                Exit(1);
            }
            decl_suffix = Concat(" extends ", parent_name);
        }
        i = SkipWhitespaceAndComments(content, i);
        if MatchLanguageWord(content, i, LanguageWordId.WordWhere) {
            while i < n && ParserCharAt(content, i) != "{" {
                i = i + 1;
            }
        }
        i = Expect(content, i, "{");
        if i < 0 {
            Exit(1);
        }
        // Body accepts both `let f: T;` fields and `func NAME(...) ...`
        // methods, in any order. Methods are emitted with base_indent
        // 6 for nominal class-like declarations and base_indent 4 for
        // domain host declarations whose methods are direct children.
        let host_method_indent: Int = 6;
        if decl_label == "Party" || decl_label == "World" || decl_label == "Roster" {
            host_method_indent = 4;
        }
        let field_blocks: String = "";
        let world_systemic_blocks: String = "";
        let world_zone_blocks: String = "";
        let method_blocks: String = "";
        while true {
            i = SkipWhitespaceAndComments(content, i);
            if i >= n {
                Exit(1);
            }
            if ParserCharAt(content, i) == "}" {
                i = i + 1;
                break;
            }
            if MatchLanguageWord(content, i, LanguageWordId.WordPublic) {
                i = LanguageWordEnd(i, LanguageWordId.WordPublic);
                i = SkipWhitespaceAndComments(content, i);
            } else if MatchLanguageWord(content, i, LanguageWordId.WordPrivate) {
                i = LanguageWordEnd(i, LanguageWordId.WordPrivate);
                i = SkipWhitespaceAndComments(content, i);
            }
            if MatchLanguageWord(content, i, LanguageWordId.WordFunc) {
                ArraySet(cursor_out, 0, i);
                let m_block: String = ParseFunction(
                    content, i, cursor_out, "", false, host_method_indent,
                    "func", "Function: ", false, within_zone,
                    expression_graphs
                );
                i = cursor_out[0];
                method_blocks = AppendLine(method_blocks, m_block);
                continue;
            }
            // `action NAME(...) -> TYPE { body }` — emits `Action:`
            // instead of `Function:` but keeps the same shape and
            // base_indent.
            if MatchLanguageWord(content, i, LanguageWordId.WordAction) {
                ArraySet(cursor_out, 0, i);
                let a_block: String = ParseFunction(
                    content, i, cursor_out, "", false, host_method_indent,
                    "action", "Action: ", false, within_zone,
                    expression_graphs
                );
                i = cursor_out[0];
                method_blocks = AppendLine(method_blocks, a_block);
                continue;
            }
            // Field: `(let|vessel)? IDENT : TYPE ;`. `let` is the
            // source form for subject/class; `vessel` is allowed
            // inside subject bodies (battle_minimal etc.) and
            // emits the same plain `NAME: TYPE` row. vessel/struct
            // bodies omit both. Either prefix is consumed and
            // discarded.
            let is_role_slot: Bool = false;
            let is_shared: Bool = false;
            let is_world_zone: Bool = false;
            let is_systemic_slot: Bool = false;
            if MatchLanguageWord(content, i, LanguageWordId.WordLet) {
                i = LanguageWordEnd(i, LanguageWordId.WordLet);
                i = SkipWhitespaceAndComments(content, i);
                if MatchLanguageWord(content, i, LanguageWordId.WordMut) {
                    i = LanguageWordEnd(i, LanguageWordId.WordMut);
                    i = SkipWhitespaceAndComments(content, i);
                }
            } else if MatchLanguageWord(content, i, LanguageWordId.WordVessel) {
                i = LanguageWordEnd(i, LanguageWordId.WordVessel);
                i = SkipWhitespaceAndComments(content, i);
            } else if MatchLanguageWord(content, i, LanguageWordId.WordZone) {
                i = LanguageWordEnd(i, LanguageWordId.WordZone);
                i = SkipWhitespaceAndComments(content, i);
                is_world_zone = true;
            } else if MatchLanguageWord(content, i, LanguageWordId.WordRoster) {
                i = LanguageWordEnd(i, LanguageWordId.WordRoster);
                i = SkipWhitespaceAndComments(content, i);
                is_systemic_slot = true;
            } else if MatchLanguageWord(content, i, LanguageWordId.WordParty) {
                i = LanguageWordEnd(i, LanguageWordId.WordParty);
                i = SkipWhitespaceAndComments(content, i);
                if !MatchLanguageWord(content, i, LanguageWordId.WordSlot) {
                    Exit(1);
                }
                i = LanguageWordEnd(i, LanguageWordId.WordSlot);
                i = SkipWhitespaceAndComments(content, i);
                is_systemic_slot = true;
            } else if MatchLanguageWord(content, i, LanguageWordId.WordRole) {
                let next_role_i: Int = SkipWhitespaceAndComments(content, LanguageWordEnd(i, LanguageWordId.WordRole));
                if MatchLanguageWord(content, next_role_i, LanguageWordId.WordSlot) {
                    i = LanguageWordEnd(next_role_i, LanguageWordId.WordSlot);
                    i = SkipWhitespaceAndComments(content, i);
                    is_role_slot = true;
                }
            } else if MatchLanguageWord(content, i, LanguageWordId.WordDyn) {
                let next_i: Int = SkipWhitespaceAndComments(content, LanguageWordEnd(i, LanguageWordId.WordDyn));
                if MatchLanguageWord(content, next_i, LanguageWordId.WordRole) {
                    let next_next_i: Int = SkipWhitespaceAndComments(content, LanguageWordEnd(next_i, LanguageWordId.WordRole));
                    if MatchLanguageWord(content, next_next_i, LanguageWordId.WordSlot) {
                        i = LanguageWordEnd(next_next_i, LanguageWordId.WordSlot);
                        i = SkipWhitespaceAndComments(content, i);
                        is_role_slot = true;
                    }
                }
            } else if MatchLanguageWord(content, i, LanguageWordId.WordShared) {
                i = LanguageWordEnd(i, LanguageWordId.WordShared);
                i = SkipWhitespaceAndComments(content, i);
                is_shared = true;
            }
            if ParserCharAt(content, i) == "(" {
                i = i + 1;
                let destructure_fields: Array<String> = [];
                while true {
                    i = SkipWhitespaceAndComments(content, i);
                    ArraySet(cursor_out, 0, i);
                    let df_name: String = ReadIdent(content, i, cursor_out);
                    i = cursor_out[0];
                    if StringLength(df_name) == 0 {
                        Exit(1);
                    }
                    ArrayPush(destructure_fields, df_name);
                    i = SkipWhitespaceAndComments(content, i);
                    if ParserCharAt(content, i) == "," {
                        i = i + 1;
                        continue;
                    }
                    break;
                }
                i = Expect(content, i, ")");
                if i < 0 {
                    Exit(1);
                }
                i = Expect(content, i, "=");
                if i < 0 {
                    Exit(1);
                }
                ArraySet(cursor_out, 0, i);
                let df_init: String = ParseExpr(content, i, cursor_out);
                i = cursor_out[0];
                df_init = df_init;
                let df_end: Int = i;
                while ParserCharAt(content, df_end) == " " || ParserCharAt(content, df_end) == "\t" || ParserCharAt(content, df_end) == "\r" {
                    df_end = df_end + 1;
                }
                if ParserCharAt(content, df_end) == "," {
                    i = df_end + 1;
                } else {
                    i = ConsumeStmtTerminator(content, df_end);
                    if i < 0 {
                        Exit(1);
                    }
                }
                let df_len: Int = ArrayLength(destructure_fields);
                let df_i: Int = 0;
                while df_i < df_len {
                    field_blocks = AppendLine(field_blocks, Concat("      ", Concat(destructure_fields[df_i], ": (null)")));
                    df_i = df_i + 1;
                }
                continue;
            }
            ArraySet(cursor_out, 0, i);
            let f_name: String = ReadIdent(content, i, cursor_out);
            i = cursor_out[0];
            if StringLength(f_name) == 0 {
                Exit(1);
            }
            i = Expect(content, i, ":");
            if i < 0 {
                Exit(1);
            }
            ArraySet(cursor_out, 0, i);
            let f_type: String = ReadType(content, i, cursor_out);
            i = cursor_out[0];
            if StringLength(f_type) == 0 {
                Exit(1);
            }
            let default_text: String = "";
            let after_type: Int = i;
            while ParserCharAt(content, after_type) == " " || ParserCharAt(content, after_type) == "\t" || ParserCharAt(content, after_type) == "\r" {
                after_type = after_type + 1;
            }
            if ParserCharAt(content, after_type) == "=" {
                i = after_type + 1;
                ArraySet(cursor_out, 0, i);
                let default_expr: String = ParseExpr(content, i, cursor_out);
                i = cursor_out[0];
                default_text = default_expr;
            } else {
                i = after_type;
            }
            let field_end: Int = i;
            while ParserCharAt(content, field_end) == " " || ParserCharAt(content, field_end) == "\t" || ParserCharAt(content, field_end) == "\r" {
                field_end = field_end + 1;
            }
            if ParserCharAt(content, field_end) == "," {
                i = field_end + 1;
            } else {
                i = ConsumeStmtTerminator(content, field_end);
                if i < 0 {
                    Exit(1);
                }
            }
            if is_role_slot {
                field_blocks = AppendLine(field_blocks, Concat("    RoleSlot: ", Concat(f_name, Concat(" requires ", f_type))));
            } else if is_shared {
                let shared_row: String = Concat("    Shared: ", Concat(f_name, Concat(": ", f_type)));
                if StringLength(default_text) > 0 {
                    shared_row = Concat(shared_row, Concat(" = ", default_text));
                }
                field_blocks = AppendLine(field_blocks, shared_row);
            } else if is_world_zone {
                let world_zone_row: String = Concat("    WorldZone: ", Concat(f_name, Concat(": ", f_type)));
                if decl_label == "World" {
                    world_zone_blocks = AppendLine(world_zone_blocks, world_zone_row);
                } else {
                    field_blocks = AppendLine(field_blocks, world_zone_row);
                }
            } else if is_systemic_slot {
                if decl_label == "World" {
                    world_systemic_blocks = AppendLine(world_systemic_blocks, Concat("    WorldSystemic: ", Concat(f_name, Concat(": ", f_type))));
                } else {
                    field_blocks = AppendLine(field_blocks, Concat("    SystemicSlot: ", Concat(f_name, Concat(": ", f_type))));
                }
            } else {
                field_blocks = AppendLine(field_blocks, Concat("      ", Concat(f_name, Concat(": ", f_type))));
            }
        }
        let decl_display_name: String = Concat(decl_prefix, Concat(decl_name, decl_suffix));
        if decl_label == "Party" && StringLength(decl_generic) > 0 {
            decl_display_name = Concat(decl_prefix, Concat(decl_name, decl_generic));
        }
        out = AppendLine(out, Concat("  ", Concat(decl_label, Concat(": ", decl_display_name))));
        if StringLength(decl_generic) > 0 && decl_label != "Party" {
            out = AppendLine(out, Concat("    Generic params: ", decl_generic));
        }
        if decl_label == "World" {
            if StringLength(world_systemic_blocks) > 0 {
                out = AppendLine(out, world_systemic_blocks);
            }
            if StringLength(world_zone_blocks) > 0 {
                out = AppendLine(out, world_zone_blocks);
            }
        }
        if StringLength(field_blocks) > 0 {
            if decl_label == "Party" {
                out = AppendLine(out, field_blocks);
            } else if decl_label == "Roster" {
                out = AppendLine(out, field_blocks);
            } else if decl_label == "World" {
                out = AppendLine(out, field_blocks);
            } else {
                out = AppendLine(out, "    Fields:");
                out = AppendLine(out, field_blocks);
            }
        }
        if StringLength(method_blocks) > 0 {
            if decl_label == "World" {
                out = AppendLine(out, method_blocks);
            } else if decl_label == "Party" {
                out = AppendLine(out, method_blocks);
            } else if decl_label == "Roster" {
                out = AppendLine(out, method_blocks);
            } else {
                out = AppendLine(out, "    Methods:");
                out = AppendLine(out, method_blocks);
            }
        }
        ArraySet(cursor_out, 0, i); return out;
    }
    Exit(1);
    return "";
}
