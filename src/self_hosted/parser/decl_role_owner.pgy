// Self-host parser role declaration owner.

import "cursor_owner.pgy";
import "tree_text_owner.pgy";
import "type_name_owner.pgy";
import "stmt_owner.pgy";
import "function_decl_owner.pgy";
import "source_refusal_owner.pgy";

func ParseRoleDecl(
    content: String,
    start: Int,
    inout cursor_out: Array<Int>,
    decl_prefix: String,
    within_zone: String,
    inout expression_graphs: Array<AstExpressionGraphRows>,
    location_context: ParserSourceLocationContext
) -> String {
    let i: Int = start;
    let n: Int = StringLength(content);
    let out: String = "";
    i = LanguageWordEnd(i, LanguageWordId.WordRole);
    i = SkipWhitespaceAndComments(content, i);
    ArraySet(cursor_out, 0, i);
    let role_name: String = ReadIdent(content, i, cursor_out);
    i = cursor_out[0];
    if StringLength(role_name) == 0 {
        ParseRefuse(location_context, i, "declaration_name_missing", "construct", "role", "", "");
    }
    i = SkipWhitespaceAndComments(content, i);
    if !MatchLanguageWord(content, i, LanguageWordId.WordFor) {
        ParseRefuse(location_context, i, "expected_token", "expected", "for", "construct", "role");
    }
    i = LanguageWordEnd(i, LanguageWordId.WordFor);
    i = SkipWhitespaceAndComments(content, i);
    ArraySet(cursor_out, 0, i);
    let role_subj: String = ReadIdent(content, i, cursor_out);
    i = cursor_out[0];
    if StringLength(role_subj) == 0 {
        ParseRefuse(location_context, i, "type_name_invalid", "construct", "role", "", "");
    }
    let compact_impl: String = "";
    i = SkipWhitespaceAndComments(content, i);
    if MatchLanguageWord(content, i, LanguageWordId.WordImpl) {
        i = LanguageWordEnd(i, LanguageWordId.WordImpl);
        i = SkipWhitespaceAndComments(content, i);
        if MatchLanguageWord(content, i, LanguageWordId.WordAbility) {
            i = LanguageWordEnd(i, LanguageWordId.WordAbility);
            i = SkipWhitespaceAndComments(content, i);
        }
        ArraySet(cursor_out, 0, i);
        compact_impl = ReadTypeIn(location_context, content, i, cursor_out);
        i = cursor_out[0];
        if StringLength(compact_impl) == 0 {
            ParseRefuse(location_context, i, "type_name_invalid", "construct", "role_impl", "", "");
        }
    }
    let open_at: Int = SkipWhitespaceAndComments(content, i);
    i = ParseExpectIn(location_context, content, i, "{", "role");
    let impl_blocks: String = "";
    if StringLength(compact_impl) > 0 {
        impl_blocks = AppendLine(impl_blocks, Concat("    Impl ability: ", compact_impl));
    }
    while true {
        i = SkipWhitespaceAndComments(content, i);
        if i >= n {
            ParseRefuse(location_context, open_at, "block_unclosed", "construct", "role", "", "");
        }
        if ParserCharAt(content, i) == "}" {
            i = i + 1;
            break;
        }
        if MatchLanguageWord(content, i, LanguageWordId.WordParallel) {
            ArraySet(cursor_out, 0, i);
            let role_parallel: String = ParseOneStmt(
                content, i, cursor_out, 4, expression_graphs
            );
            i = cursor_out[0];
            impl_blocks = AppendLine(impl_blocks, role_parallel);
            continue;
        }
        if StringLength(compact_impl) > 0 && MatchLanguageWord(content, i, LanguageWordId.WordFunc) {
            ArraySet(cursor_out, 0, i);
            let compact_m: String = ParseFunction(
                content, i, cursor_out, "", false, 6, "func", "Function: ",
                false, within_zone, expression_graphs, location_context
            );
            i = cursor_out[0];
            impl_blocks = AppendLine(impl_blocks, "    Impl ability: (null)");
            impl_blocks = AppendLine(impl_blocks, compact_m);
            continue;
        }
        if MatchLanguageWord(content, i, LanguageWordId.WordOverride) {
            i = LanguageWordEnd(i, LanguageWordId.WordOverride);
            i = SkipWhitespaceAndComments(content, i);
            if !MatchLanguageWord(content, i, LanguageWordId.WordFunc) {
                ParseRefuse(location_context, i, "expected_token", "expected", "func", "construct", "role_override");
            }
            ArraySet(cursor_out, 0, i);
            let override_method: String = ParseFunction(
                content, i, cursor_out, "", false, 6, "func", "Function: ",
                false, within_zone, expression_graphs, location_context
            );
            i = cursor_out[0];
            impl_blocks = AppendLine(impl_blocks, "    Override");
            impl_blocks = AppendLine(impl_blocks, override_method);
            continue;
        }
        // Native also admits `include ROLE;` and a bare method in a role
        // without a compact `impl`; this parser does not cover them yet.
        if MatchLanguageWord(content, i, LanguageWordId.WordInclude) {
            ParseRefuse(location_context, i, "surface_not_covered", "surface", "role include", "construct", "role");
        }
        if MatchLanguageWord(content, i, LanguageWordId.WordFunc) {
            ParseRefuse(location_context, i, "surface_not_covered", "surface", "role method outside an impl", "construct", "role");
        }
        if !MatchLanguageWord(content, i, LanguageWordId.WordImpl) {
            ParseRefuse(location_context, i, "expected_token", "expected", "impl, override or func", "construct", "role");
        }
        i = LanguageWordEnd(i, LanguageWordId.WordImpl);
        i = SkipWhitespaceAndComments(content, i);
        if MatchLanguageWord(content, i, LanguageWordId.WordAbility) {
            i = LanguageWordEnd(i, LanguageWordId.WordAbility);
            i = SkipWhitespaceAndComments(content, i);
        }
        ArraySet(cursor_out, 0, i);
        let ab_name_impl: String = ReadTypeIn(location_context, content, i, cursor_out);
        i = cursor_out[0];
        if StringLength(ab_name_impl) == 0 {
            ParseRefuse(location_context, i, "type_name_invalid", "construct", "role_impl", "", "");
        }
        let impl_open_at: Int = SkipWhitespaceAndComments(content, i);
        i = ParseExpectIn(location_context, content, i, "{", "role_impl");
        let impl_methods: String = "";
        while true {
            i = SkipWhitespaceAndComments(content, i);
            if i >= n {
                ParseRefuse(location_context, impl_open_at, "block_unclosed", "construct", "role_impl", "", "");
            }
            if ParserCharAt(content, i) == "}" {
                i = i + 1;
                break;
            }
            if !MatchLanguageWord(content, i, LanguageWordId.WordFunc) {
                ParseRefuse(location_context, i, "expected_token", "expected", "func", "construct", "role_impl");
            }
            ArraySet(cursor_out, 0, i);
            let m_block: String = ParseFunction(
                content, i, cursor_out, "", false, 6, "func", "Function: ",
                false, within_zone, expression_graphs, location_context
            );
            i = cursor_out[0];
            impl_methods = AppendLine(impl_methods, m_block);
        }
        impl_blocks = AppendLine(impl_blocks, Concat("    Impl ability: ", ab_name_impl));
        if StringLength(impl_methods) > 0 {
            impl_blocks = AppendLine(impl_blocks, impl_methods);
        }
    }
    out = AppendLine(out, Concat("  Role: ", Concat(decl_prefix, Concat(role_name, Concat(" for ", role_subj)))));
    if StringLength(impl_blocks) > 0 {
        out = AppendLine(out, impl_blocks);
    }
    ArraySet(cursor_out, 0, i); return out;
}
