// Self-host parser zone declaration owner.

import "cursor_owner.pgy";
import "tree_text_owner.pgy";
import "type_name_owner.pgy";
import "expr_owner.pgy";
import "function_decl_owner.pgy";
import "domain_projection_map_owner.pgy";

func ParseZoneDecl(
    content: String,
    start: Int,
    inout cursor_out: Array<Int>,
    decl_prefix: String,
    inout involve_types: Array<String>,
    inout expression_graphs: Array<AstExpressionGraphRows>
) -> String {
    let i: Int = start;
    let n: Int = StringLength(content);
    let out: String = "";
    i = LanguageWordEnd(i, LanguageWordId.WordZone);
    i = SkipWhitespaceAndComments(content, i);
    ArraySet(cursor_out, 0, i);
    let zone_name: String = ReadIdent(content, i, cursor_out);
    i = cursor_out[0];
    if StringLength(zone_name) == 0 {
        Exit(1);
    }
    if StringLength(zone_name) > 0 {
        ArrayPush(involve_types, zone_name);
    }
    i = Expect(content, i, "{");
    if i < 0 {
        Exit(1);
    }
    let slot_accum: String = "";
    let apply_accum: String = "";
    let link_accum: String = "";
    let auth_accum: String = "";
    let state_accum: String = "";
    let bind_accum: String = "";
    while true {
        i = SkipWhitespaceAndComments(content, i);
        if i >= n {
            Exit(1);
        }
        if ParserCharAt(content, i) == "}" {
            i = i + 1;
            break;
        }
        // Zone body slot lines: `subject slot NAME: TYPE`,
        // `object slot NAME: TYPE`, or `tobject slot NAME: TYPE`.
        // Each emits `SubjectSlot:` / `ObjectSlot:` / `TObjectSlot:`
        // with the same `NAME: TYPE` payload.
        let slot_label: String = "";
        let is_auth: Bool = false;
        if MatchLanguageWord(content, i, LanguageWordId.WordSubject) {
            slot_label = "SubjectSlot";
            i = LanguageWordEnd(i, LanguageWordId.WordSubject);
        } else if MatchLanguageWord(content, i, LanguageWordId.WordObject) {
            slot_label = "ObjectSlot";
            i = LanguageWordEnd(i, LanguageWordId.WordObject);
        } else if MatchLanguageWord(content, i, LanguageWordId.WordTobject) {
            slot_label = "TObjectSlot";
            i = LanguageWordEnd(i, LanguageWordId.WordTobject);
        } else if MatchLanguageWord(content, i, LanguageWordId.WordEffect) {
            slot_label = "EffectSlot";
            i = LanguageWordEnd(i, LanguageWordId.WordEffect);
        } else if MatchLanguageWord(content, i, LanguageWordId.WordRelation) {
            slot_label = "RelationSlot";
            i = LanguageWordEnd(i, LanguageWordId.WordRelation);
        } else if MatchLanguageWord(content, i, LanguageWordId.WordAuthority) {
            is_auth = true;
            i = LanguageWordEnd(i, LanguageWordId.WordAuthority);
        } else if MatchLanguageWord(content, i, LanguageWordId.WordApply) {
            i = LanguageWordEnd(i, LanguageWordId.WordApply);
            i = SkipWhitespaceAndComments(content, i);
            ArraySet(cursor_out, 0, i);
            let a_eff: String = ReadIdent(content, i, cursor_out);
            i = cursor_out[0];
            i = SkipWhitespaceAndComments(content, i);
            if !MatchLanguageWord(content, i, LanguageWordId.WordTo) { Exit(1); }
            i = LanguageWordEnd(i, LanguageWordId.WordTo);
            i = SkipWhitespaceAndComments(content, i);
            ArraySet(cursor_out, 0, i);
	                    let a_dest: String = ReadIdent(content, i, cursor_out);
	                    i = cursor_out[0];
	                    i = SkipWhitespaceAndComments(content, i);
	                    let a_by: String = "";
	                    if MatchLanguageWord(content, i, LanguageWordId.WordBy) {
	                        i = LanguageWordEnd(i, LanguageWordId.WordBy);
	                        i = SkipWhitespaceAndComments(content, i);
	                        ArraySet(cursor_out, 0, i);
	                        a_by = ReadIdent(content, i, cursor_out);
	                        i = cursor_out[0];
	                    }
	                    if i < n && ParserCharAt(content, i) == ";" {
	                        i = i + 1;
	                    }
	                    let apply_row: String = Concat("    Apply: ", Concat(a_eff, Concat(" -> ", a_dest)));
	                    if StringLength(a_by) > 0 {
	                        apply_row = Concat(apply_row, Concat(" by ", a_by));
	                    }
	                    apply_accum = AppendLine(apply_accum, apply_row);
	                    continue;
	                } else if MatchLanguageWord(content, i, LanguageWordId.WordLink) {
            i = LanguageWordEnd(i, LanguageWordId.WordLink);
            i = SkipWhitespaceAndComments(content, i);
            ArraySet(cursor_out, 0, i);
            let l_rel: String = ReadIdent(content, i, cursor_out);
            i = cursor_out[0];
            i = SkipWhitespaceAndComments(content, i);
            if !MatchLanguageWord(content, i, LanguageWordId.WordBetween) { Exit(1); }
            i = LanguageWordEnd(i, LanguageWordId.WordBetween);
            i = SkipWhitespaceAndComments(content, i);
            ArraySet(cursor_out, 0, i);
            let l_p1: String = ReadIdent(content, i, cursor_out);
            i = cursor_out[0];
            i = Expect(content, i, ",");
            if i < 0 { Exit(1); }
            i = SkipWhitespaceAndComments(content, i);
            ArraySet(cursor_out, 0, i);
	                    let l_p2: String = ReadIdent(content, i, cursor_out);
	                    i = cursor_out[0];
	                    i = SkipWhitespaceAndComments(content, i);
	                    let l_by: String = "";
	                    if MatchLanguageWord(content, i, LanguageWordId.WordBy) {
	                        i = LanguageWordEnd(i, LanguageWordId.WordBy);
	                        i = SkipWhitespaceAndComments(content, i);
	                        ArraySet(cursor_out, 0, i);
	                        l_by = ReadIdent(content, i, cursor_out);
	                        i = cursor_out[0];
	                    }
	                    if i < n && ParserCharAt(content, i) == ";" {
	                        i = i + 1;
	                    }
	                    let link_row: String = Concat("    Link: ", Concat(l_rel, Concat(" between ", Concat(l_p1, Concat(", ", l_p2)))));
	                    if StringLength(l_by) > 0 {
	                        link_row = Concat(link_row, Concat(" by ", l_by));
	                    }
	                    link_accum = AppendLine(link_accum, link_row);
	                    continue;
        } else if MatchLanguageWord(content, i, LanguageWordId.WordState) {
            i = LanguageWordEnd(i, LanguageWordId.WordState);
            i = SkipWhitespaceAndComments(content, i);
            ArraySet(cursor_out, 0, i);
            let st_name: String = ReadIdent(content, i, cursor_out);
            i = cursor_out[0];
            i = Expect(content, i, ":");
            if i < 0 { Exit(1); }
            i = SkipWhitespaceAndComments(content, i);
            let st_start: Int = i;
            while i < n && ParserCharAt(content, i) != ";" {
                i = i + 1;
            }
            let st_val: String = Substring(content, st_start, i - st_start);
            i = Expect(content, i, ";");
            if i < 0 { Exit(1); }
            state_accum = AppendLine(state_accum, Concat("    State: ", Concat(st_name, Concat(": ", st_val))));
            continue;
        } else if MatchLanguageWord(content, i, LanguageWordId.WordBind) {
            i = LanguageWordEnd(i, LanguageWordId.WordBind);
            i = SkipWhitespaceAndComments(content, i);
            let list_start: Int = i;
            if ParserCharAt(content, i) == "[" {
                i = i + 1;
                while true {
                    i = SkipWhitespaceAndComments(content, i);
                    ArraySet(cursor_out, 0, i);
                    let dummy: String = ReadIdent(content, i, cursor_out);
                    i = cursor_out[0];
                    if StringLength(dummy) == 0 { Exit(1); }
                    i = SkipWhitespaceAndComments(content, i);
                    if ParserCharAt(content, i) == "," {
                        i = i + 1;
                        continue;
                    }
                    break;
                }
                i = Expect(content, i, "]");
                if i < 0 { Exit(1); }
            } else {
                ArraySet(cursor_out, 0, i);
                let dummy: String = ReadIdent(content, i, cursor_out);
                i = cursor_out[0];
                if StringLength(dummy) == 0 { Exit(1); }
            }
            i = SkipWhitespaceAndComments(content, i);
            if !MatchLanguageWord(content, i, LanguageWordId.WordFrom) { Exit(1); }
            i = LanguageWordEnd(i, LanguageWordId.WordFrom);
            i = SkipWhitespaceAndComments(content, i);
            ArraySet(cursor_out, 0, i);
            let from_name: String = ReadIdent(content, i, cursor_out);
            i = cursor_out[0];
            i = SkipWhitespaceAndComments(content, i);
            if ParserCharAt(content, i) == ";" {
                i = i + 1;
            }
            ArraySet(cursor_out, 0, i);

            let k: Int = list_start;
            if ParserCharAt(content, k) == "[" {
                k = k + 1;
                while true {
                    k = SkipWhitespaceAndComments(content, k);
                    ArraySet(cursor_out, 0, k);
                    let t_name: String = ReadIdent(content, k, cursor_out);
                    k = cursor_out[0];
                    bind_accum = AppendLine(bind_accum, Concat("    Bind: ", Concat(t_name, Concat(" from ", from_name))));
                    k = SkipWhitespaceAndComments(content, k);
                    if ParserCharAt(content, k) == "," {
                        k = k + 1;
                        continue;
                    }
                    break;
                }
            } else {
                ArraySet(cursor_out, 0, k);
                let t_name: String = ReadIdent(content, k, cursor_out);
                bind_accum = AppendLine(bind_accum, Concat("    Bind: ", Concat(t_name, Concat(" from ", from_name))));
            }
            ArraySet(cursor_out, 0, i);
            continue;
        } else if MatchLanguageWord(content, i, LanguageWordId.WordRefresh) || MatchLanguageWord(content, i, LanguageWordId.WordPublish) {
            let is_ref: Bool = MatchLanguageWord(content, i, LanguageWordId.WordRefresh);
            let ref_pub_label: String = "Publish";
            let ref_pub_kw_len: Int = LanguageWordLength(LanguageWordId.WordPublish);
            if is_ref {
                ref_pub_label = "Refresh";
                ref_pub_kw_len = LanguageWordLength(LanguageWordId.WordRefresh);
            }
            i = i + ref_pub_kw_len;
            i = SkipWhitespaceAndComments(content, i);
            let list_start: Int = i;
            let target_count: Int = 0;
            if ParserCharAt(content, i) == "[" {
                i = i + 1;
                while true {
                    i = SkipWhitespaceAndComments(content, i);
                    ArraySet(cursor_out, 0, i);
                    let dummy: String = ReadIdent(content, i, cursor_out);
                    i = cursor_out[0];
                    if StringLength(dummy) == 0 { Exit(1); }
                    target_count = target_count + 1;
                    i = SkipWhitespaceAndComments(content, i);
                    if ParserCharAt(content, i) == "," {
                        i = i + 1;
                        continue;
                    }
                    break;
                }
                i = Expect(content, i, "]");
                if i < 0 { Exit(1); }
            } else {
                ArraySet(cursor_out, 0, i);
                let dummy: String = ReadIdent(content, i, cursor_out);
                i = cursor_out[0];
                if StringLength(dummy) == 0 { Exit(1); }
                target_count = 1;
            }
            i = SkipWhitespaceAndComments(content, i);
            if !MatchLanguageWord(content, i, LanguageWordId.WordFrom) { Exit(1); }
            i = LanguageWordEnd(i, LanguageWordId.WordFrom);
            i = SkipWhitespaceAndComments(content, i);
            ArraySet(cursor_out, 0, i);
            let from_name: String = ReadIdent(content, i, cursor_out);
            i = cursor_out[0];
            i = SkipWhitespaceAndComments(content, i);
            if !MatchLanguageWord(content, i, LanguageWordId.WordBy) { Exit(1); }
            i = LanguageWordEnd(i, LanguageWordId.WordBy);
            i = SkipWhitespaceAndComments(content, i);
            ArraySet(cursor_out, 0, i);
            let by_name: String = ReadIdent(content, i, cursor_out);
            i = cursor_out[0];
            i = SkipWhitespaceAndComments(content, i);
            ArraySet(cursor_out, 0, i);
            let projection_map: ParserDomainProjectionMapRows =
                ParseDomainProjectionMapRows(content, i, cursor_out);
            i = cursor_out[0];
            if projection_map.present && target_count != 1 { Exit(1); }
            i = SkipWhitespaceAndComments(content, i);
            if i < n && ParserCharAt(content, i) == ";" {
                i = i + 1;
            }

            let k: Int = list_start;
            if ParserCharAt(content, k) == "[" {
                k = k + 1;
                while true {
                    k = SkipWhitespaceAndComments(content, k);
                    ArraySet(cursor_out, 0, k);
                    let t_name: String = ReadIdent(content, k, cursor_out);
                    k = cursor_out[0];
                    let projection_row: String = Concat("    ", Concat(ref_pub_label, Concat(": ", Concat(t_name, Concat(" from ", Concat(from_name, Concat(" by ", by_name)))))));
                    bind_accum = AppendLine(bind_accum, projection_row);
                    k = SkipWhitespaceAndComments(content, k);
                    if ParserCharAt(content, k) == "," {
                        k = k + 1;
                        continue;
                    }
                    break;
                }
            } else {
                ArraySet(cursor_out, 0, k);
                let t_name: String = ReadIdent(content, k, cursor_out);
                let projection_row: String = Concat("    ", Concat(ref_pub_label, Concat(": ", Concat(t_name, Concat(" from ", Concat(from_name, Concat(" by ", by_name)))))));
                bind_accum = AppendLine(bind_accum, projection_row);
                if projection_map.present {
                    bind_accum = AppendLine(
                        bind_accum, projection_map.tree_rows
                    );
                }
            }
            ArraySet(cursor_out, 0, i);
            continue;
        } else if MatchLanguageWord(content, i, LanguageWordId.WordFunc) {
            ArraySet(cursor_out, 0, i);
            let m_block: String = ParseFunction(
                content, i, cursor_out, "", false, 4, "func", "Function: ",
                false, "", expression_graphs
            );
            i = cursor_out[0];
            auth_accum = AppendLine(auth_accum, m_block);
            continue;
        } else {
            Exit(1);
        }
        i = SkipWhitespaceAndComments(content, i);
        if is_auth {
            ArraySet(cursor_out, 0, i);
            let auth_name: String = ReadIdent(content, i, cursor_out);
            i = cursor_out[0];
            i = SkipWhitespaceAndComments(content, i);
            let auth_req: String = "";
            if MatchLanguageWord(content, i, LanguageWordId.WordRequires) {
                i = LanguageWordEnd(i, LanguageWordId.WordRequires);
                i = SkipWhitespaceAndComments(content, i);
                ArraySet(cursor_out, 0, i);
                auth_req = ReadType(content, i, cursor_out);
                i = cursor_out[0];
                while true {
                    i = SkipWhitespaceAndComments(content, i);
                    if ParserCharAt(content, i) == "," {
                        i = i + 1;
                        i = SkipWhitespaceAndComments(content, i);
                        ArraySet(cursor_out, 0, i);
                        let next_req: String = ReadType(content, i, cursor_out);
                        i = cursor_out[0];
                        auth_req = Concat(auth_req, Concat(", ", next_req));
                        continue;
                    }
                    break;
                }
            }
            i = SkipWhitespaceAndComments(content, i);
            if ParserCharAt(content, i) == ";" {
                i = i + 1;
            }
            auth_accum = AppendLine(auth_accum, Concat("    Authority: ", auth_name));
            if StringLength(auth_req) > 0 {
                auth_accum = AppendLine(auth_accum, Concat("      Requires: ", auth_req));
            }
        } else {
            if !MatchLanguageWord(content, i, LanguageWordId.WordSlot) {
                Exit(1);
            }
            i = LanguageWordEnd(i, LanguageWordId.WordSlot);
            i = SkipWhitespaceAndComments(content, i);
            ArraySet(cursor_out, 0, i);
            let s_name: String = ReadIdent(content, i, cursor_out);
            i = cursor_out[0];
            if StringLength(s_name) == 0 {
                Exit(1);
            }
            i = Expect(content, i, ":");
            if i < 0 {
                Exit(1);
            }
            ArraySet(cursor_out, 0, i);
            let s_type: String = ReadType(content, i, cursor_out);
            i = cursor_out[0];
            if StringLength(s_type) == 0 {
                Exit(1);
            }
            i = SkipWhitespaceAndComments(content, i);
            // A zone object/effect slot may carry a declaration-time default
            // (`slot mirror: BuyerView = BuyerView(0)`).  The executable
            // constructor fact owns the slot type; consume the default here
            // so it cannot be mistaken for a second zone declaration.
            if ParserCharAt(content, i) == "=" {
                i = i + 1;
                while i < n && ParserCharAt(content, i) != ";" &&
                    ParserCharAt(content, i) != "}" {
                    i = i + 1;
                }
            }
            if ParserCharAt(content, i) == ";" {
                i = i + 1;
            }
            slot_accum = AppendLine(slot_accum, Concat("    ", Concat(slot_label, Concat(": ", Concat(s_name, Concat(": ", s_type))))));
        }
    }
    out = AppendLine(out, Concat("  Zone: ", Concat(decl_prefix, zone_name)));
    let zone_body: String = "";
    if StringLength(slot_accum) > 0 {
        zone_body = AppendLine(zone_body, slot_accum);
    }
    if StringLength(bind_accum) > 0 {
        zone_body = AppendLine(zone_body, bind_accum);
    }
    if StringLength(apply_accum) > 0 {
        zone_body = AppendLine(zone_body, apply_accum);
    }
    if StringLength(link_accum) > 0 {
        zone_body = AppendLine(zone_body, link_accum);
    }
    if StringLength(auth_accum) > 0 {
        zone_body = AppendLine(zone_body, auth_accum);
    }
    if StringLength(state_accum) > 0 {
        zone_body = AppendLine(zone_body, state_accum);
    }
    if StringLength(zone_body) > 0 {
        out = AppendLine(out, zone_body);
    }
    ArraySet(cursor_out, 0, i); return out;
}
