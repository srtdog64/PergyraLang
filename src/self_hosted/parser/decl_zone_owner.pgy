// Self-host parser zone declaration owner.

import "cursor_owner.pgy";
import "tree_text_owner.pgy";
import "type_name_owner.pgy";
import "expr_owner.pgy";
import "function_decl_owner.pgy";
import "domain_projection_map_owner.pgy";
import "decl_zone_slot_group_owner.pgy";
import "source_refusal_owner.pgy";

func ParseZoneDecl(
    content: String,
    start: Int,
    inout cursor_out: Array<Int>,
    decl_prefix: String,
    inout involve_types: Array<String>,
    inout expression_graphs: Array<AstExpressionGraphRows>,
    location_context: ParserSourceLocationContext
) -> String {
    let i: Int = start;
    let n: Int = StringLength(content);
    let out: String = "";
    i = LanguageWordEnd(i, LanguageWordId.WordZone);
    i = SkipWhitespaceAndComments(content, i);
    ArraySet(cursor_out, 0, i);
    let zone_name: String = ReadIdent(content, i, cursor_out);
    i = cursor_out[0];
    if StringLength(zone_name) == 0 {
        ParseRefuse(location_context, i, "declaration_name_missing", "construct", "zone", "", "");
    }
    ArrayPush(involve_types, zone_name);
    let open_at: Int = SkipWhitespaceAndComments(content, i);
    i = ParseExpectIn(location_context, content, i, "{", "zone");
    let slot_accum: String = "";
    // Effect and relation slots, pools and groups print after every
    // subject/object/tobject/binding slot, as native keeps them apart.
    let layer_accum: String = "";
    let shared_accum: String = "";
    let apply_accum: String = "";
    let link_accum: String = "";
    let auth_accum: String = "";
    let state_accum: String = "";
    let bind_accum: String = "";
    while true {
        i = SkipWhitespaceAndComments(content, i);
        if i >= n {
            ParseRefuse(location_context, open_at, "block_unclosed", "construct", "zone", "", "");
        }
        if ParserCharAt(content, i) == "}" {
            i = i + 1;
            break;
        }
        // Zone body slot lines: `subject slot NAME: TYPE`,
        // `binding slot NAME: TYPE`, `object slot NAME: TYPE`, or
        // `tobject slot NAME: TYPE`. Each emits the corresponding typed slot
        // with the same `NAME: TYPE` payload.
        let slot_label: String = "";
        let is_auth: Bool = false;
        // `forbids unsafe` sets a zone flag the native tree does not print.
        if MatchLanguageWord(content, i, LanguageWordId.WordForbids) {
            i = SkipWhitespaceAndComments(content, LanguageWordEnd(i, LanguageWordId.WordForbids));
            if !MatchLanguageWord(content, i, LanguageWordId.WordUnsafe) {
                ParseRefuse(location_context, i, "expected_token", "expected", "unsafe", "construct", "zone_forbids");
            }
            i = SkipWhitespaceAndComments(content, LanguageWordEnd(i, LanguageWordId.WordUnsafe));
            if ParserCharAt(content, i) == ";" { i = i + 1; }
            continue;
        }
        let group: ParserZoneSlotGroupRows =
            ParseZoneSlotGroupRows(location_context, content, i, cursor_out);
        if group.present {
            i = SkipWhitespaceAndComments(content, cursor_out[0]);
            if ParserCharAt(content, i) == ";" { i = i + 1; }
            if group.layer {
                layer_accum = AppendLine(layer_accum, group.tree_rows);
            } else {
                slot_accum = AppendLine(slot_accum, group.tree_rows);
            }
            continue;
        }
        if MatchLanguageWord(content, i, LanguageWordId.WordSubject) {
            slot_label = "SubjectSlot";
            i = LanguageWordEnd(i, LanguageWordId.WordSubject);
        } else if MatchLanguageWord(content, i, LanguageWordId.WordObject) {
            slot_label = "ObjectSlot";
            i = LanguageWordEnd(i, LanguageWordId.WordObject);
        } else if MatchLanguageWord(content, i, LanguageWordId.WordTobject) {
            slot_label = "TObjectSlot";
            i = LanguageWordEnd(i, LanguageWordId.WordTobject);
        } else if MatchLanguageWord(content, i, LanguageWordId.WordBinding) {
            slot_label = "BindingSlot";
            i = LanguageWordEnd(i, LanguageWordId.WordBinding);
        } else if MatchLanguageWord(content, i, LanguageWordId.WordEffect) {
            slot_label = "EffectSlot";
            i = LanguageWordEnd(i, LanguageWordId.WordEffect);
        } else if MatchLanguageWord(content, i, LanguageWordId.WordRelation) {
            slot_label = "RelationSlot";
            i = LanguageWordEnd(i, LanguageWordId.WordRelation);
        } else if MatchLanguageWord(content, i, LanguageWordId.WordAuthority) {
            is_auth = true;
            i = LanguageWordEnd(i, LanguageWordId.WordAuthority);
        } else if MatchLanguageWord(content, i, LanguageWordId.WordApply) {
            let apply_at: Int = i;
            i = LanguageWordEnd(i, LanguageWordId.WordApply);
            let a_eff: String = ParseNameIn(location_context, content, i,
                "effect slot name or state name", "zone_apply", cursor_out);
            i = SkipWhitespaceAndComments(content, cursor_out[0]);
            // Native also admits `apply STATE` without a target.
            if !MatchLanguageWord(content, i, LanguageWordId.WordTo) {
                ParseRefuse(location_context, apply_at, "surface_not_covered", "surface", "zone apply of a state", "construct", "zone");
            }
            i = LanguageWordEnd(i, LanguageWordId.WordTo);
	                    let a_dest: String = ParseNameIn(location_context, content, i,
	                        "target slot name", "zone_apply", cursor_out);
	                    i = SkipWhitespaceAndComments(content, cursor_out[0]);
	                    let a_by: String = "";
	                    if MatchLanguageWord(content, i, LanguageWordId.WordBy) {
	                        a_by = ParseNameIn(location_context, content,
	                            LanguageWordEnd(i, LanguageWordId.WordBy),
	                            "subject slot name", "zone_apply", cursor_out);
	                        i = cursor_out[0];
	                    }
	                    if i < n && ParserCharAt(content, i) == ";" {
	                        i = i + 1;
	                    }
	                    let apply_row: String = Concat("    Apply: ", Concat(a_eff, Concat(" -> ", a_dest)));
	                    if StringLength(a_by) > 0 {
	                        apply_row = Concat(apply_row, Concat(" by ", a_by));
	                    }
	                    apply_accum = AppendLine(apply_accum, apply_row);
	                    continue;
	                } else if MatchLanguageWord(content, i, LanguageWordId.WordLink) {
            let link_at: Int = i;
            i = LanguageWordEnd(i, LanguageWordId.WordLink);
            let l_rel: String = ParseNameIn(location_context, content, i,
                "relation slot name or state name", "zone_link", cursor_out);
            i = SkipWhitespaceAndComments(content, cursor_out[0]);
            // Native also admits `link STATE` without `between`.
            if !MatchLanguageWord(content, i, LanguageWordId.WordBetween) {
                ParseRefuse(location_context, link_at, "surface_not_covered", "surface", "zone link of a state", "construct", "zone");
            }
            i = LanguageWordEnd(i, LanguageWordId.WordBetween);
            let l_p1: String = ParseNameIn(location_context, content, i,
                "left slot name", "zone_link", cursor_out);
            i = ParseExpectIn(location_context, content, cursor_out[0], ",", "zone_link");
	                    let l_p2: String = ParseNameIn(location_context, content, i,
	                        "right slot name", "zone_link", cursor_out);
	                    i = SkipWhitespaceAndComments(content, cursor_out[0]);
	                    let l_by: String = "";
	                    if MatchLanguageWord(content, i, LanguageWordId.WordBy) {
	                        l_by = ParseNameIn(location_context, content,
	                            LanguageWordEnd(i, LanguageWordId.WordBy),
	                            "subject slot name", "zone_link", cursor_out);
	                        i = cursor_out[0];
	                    }
	                    if i < n && ParserCharAt(content, i) == ";" {
	                        i = i + 1;
	                    }
	                    let link_row: String = Concat("    Link: ", Concat(l_rel, Concat(" between ", Concat(l_p1, Concat(", ", l_p2)))));
	                    if StringLength(l_by) > 0 {
	                        link_row = Concat(link_row, Concat(" by ", l_by));
	                    }
	                    link_accum = AppendLine(link_accum, link_row);
	                    continue;
        } else if MatchLanguageWord(content, i, LanguageWordId.WordShared) {
            i = LanguageWordEnd(i, LanguageWordId.WordShared);
            i = SkipWhitespaceAndComments(content, i);
            ArraySet(cursor_out, 0, i);
            let field_name: String = ReadIdent(content, i, cursor_out);
            i = cursor_out[0];
            if field_name == "" {
                ParseRefuse(location_context, i, "declaration_name_missing", "construct", "zone_shared", "", "");
            }
            i = ParseExpectIn(location_context, content, i, ":", "zone_shared");
            ArraySet(cursor_out, 0, i);
            let field_type: String = ReadTypeIn(location_context, content, i, cursor_out);
            i = cursor_out[0];
            if field_type == "" {
                ParseRefuse(location_context, i, "type_name_invalid", "construct", "zone_shared", "", "");
            }
            i = SkipWhitespaceAndComments(content, i);
            let default_text: String = "";
            if ParserCharAt(content, i) == "=" {
                i = i + 1;
                ArraySet(cursor_out, 0, i);
                default_text = ParseExprFactIn(location_context, content, i, cursor_out).text;
                i = cursor_out[0];
            }
            i = ParseStatementTerminatorIn(location_context, content, i, "zone_shared");
            let shared_row: String = Concat(
                "    Shared: ", Concat(field_name, Concat(": ", field_type))
            );
            if default_text != "" {
                shared_row = Concat(shared_row, Concat(" = ", default_text));
            }
            shared_accum = AppendLine(shared_accum, shared_row);
            continue;
        } else if MatchLanguageWord(content, i, LanguageWordId.WordState) {
            i = LanguageWordEnd(i, LanguageWordId.WordState);
            let st_name: String = ParseNameIn(location_context, content, i,
                "state name", "zone_state", cursor_out);
            i = ParseExpectIn(location_context, content, cursor_out[0], ":", "zone_state");
            i = SkipWhitespaceAndComments(content, i);
            let st_start: Int = i;
            // The tree keeps the value as text; its layer and slot names are
            // read here so a non-name refuses where native refuses it.
            if MatchLanguageWord(content, st_start, LanguageWordId.WordEffect) {
                let st_effect: String = ParseNameIn(location_context, content,
                    LanguageWordEnd(st_start, LanguageWordId.WordEffect), "effect slot name", "zone_state", cursor_out);
                i = SkipWhitespaceAndComments(content, cursor_out[0]);
                if !MatchLanguageWord(content, i, LanguageWordId.WordOn) {
                    ParseRefuse(location_context, i, "expected_token", "expected", "on", "construct", "zone_state");
                }
                let st_target: String = ParseNameIn(location_context, content,
                    LanguageWordEnd(i, LanguageWordId.WordOn), "target slot name", "zone_state", cursor_out);
            } else if MatchLanguageWord(content, st_start, LanguageWordId.WordRelation) {
                let st_relation: String = ParseNameIn(location_context, content,
                    LanguageWordEnd(st_start, LanguageWordId.WordRelation), "relation slot name", "zone_state", cursor_out);
                i = SkipWhitespaceAndComments(content, cursor_out[0]);
                if !MatchLanguageWord(content, i, LanguageWordId.WordBetween) {
                    ParseRefuse(location_context, i, "expected_token", "expected", "between", "construct", "zone_state");
                }
                let st_left: String = ParseNameIn(location_context, content,
                    LanguageWordEnd(i, LanguageWordId.WordBetween), "left slot name", "zone_state", cursor_out);
                i = ParseExpectIn(location_context, content, cursor_out[0], ",", "zone_state");
                let st_right: String = ParseNameIn(location_context, content, i, "right slot name", "zone_state", cursor_out);
            } else {
                ParseRefuse(location_context, st_start, "expected_token", "expected", "effect or relation", "construct", "zone_state");
            }
            i = st_start;
            while i < n && ParserCharAt(content, i) != ";" &&
                ParserCharAt(content, i) != "\n" &&
                ParserCharAt(content, i) != "\r" &&
                ParserCharAt(content, i) != "}" {
                i = i + 1;
            }
            let st_val: String = StringTrim(
                Substring(content, st_start, i - st_start)
            );
            if i < n && ParserCharAt(content, i) == ";" { i = i + 1; }
            state_accum = AppendLine(state_accum, Concat("    State: ", Concat(st_name, Concat(": ", st_val))));
            continue;
        } else if MatchLanguageWord(content, i, LanguageWordId.WordBind) {
            i = LanguageWordEnd(i, LanguageWordId.WordBind);
            i = SkipWhitespaceAndComments(content, i);
            let list_start: Int = i;
            if ParserCharAt(content, i) == "[" {
                i = i + 1;
                while true {
                    let dummy: String = ParseNameIn(location_context, content, i,
                        "object/tobject slot name", "zone_bind", cursor_out);
                    i = SkipWhitespaceAndComments(content, cursor_out[0]);
                    if ParserCharAt(content, i) == "," {
                        i = i + 1;
                        continue;
                    }
                    break;
                }
                i = ParseExpectIn(location_context, content, i, "]", "zone_bind");
            } else {
                let dummy: String = ParseNameIn(location_context, content, i,
                    "object/tobject slot name", "zone_bind", cursor_out);
                i = cursor_out[0];
            }
            i = SkipWhitespaceAndComments(content, i);
            if !MatchLanguageWord(content, i, LanguageWordId.WordFrom) {
                ParseRefuse(location_context, i, "expected_token", "expected", "from", "construct", "zone_bind");
            }
            let from_name: String = ParseNameIn(location_context, content,
                LanguageWordEnd(i, LanguageWordId.WordFrom), "source slot name", "zone_bind", cursor_out);
            i = SkipWhitespaceAndComments(content, cursor_out[0]);
            // Native also admits `bind ... by PARTICIPANT` and a projection map.
            if MatchLanguageWord(content, i, LanguageWordId.WordBy) || MatchLanguageWord(content, i, LanguageWordId.WordMap) {
                ParseRefuse(location_context, i, "surface_not_covered", "surface", "zone bind participant or map", "construct", "zone");
            }
            if ParserCharAt(content, i) == ";" {
                i = i + 1;
            }
            ArraySet(cursor_out, 0, i);

            let k: Int = list_start;
            if ParserCharAt(content, k) == "[" {
                k = k + 1;
                while true {
                    k = SkipWhitespaceAndComments(content, k);
                    ArraySet(cursor_out, 0, k);
                    let t_name: String = ReadIdent(content, k, cursor_out);
                    k = cursor_out[0];
                    bind_accum = AppendLine(bind_accum, Concat("    Bind: ", Concat(t_name, Concat(" from ", from_name))));
                    k = SkipWhitespaceAndComments(content, k);
                    if ParserCharAt(content, k) == "," {
                        k = k + 1;
                        continue;
                    }
                    break;
                }
            } else {
                ArraySet(cursor_out, 0, k);
                let t_name: String = ReadIdent(content, k, cursor_out);
                bind_accum = AppendLine(bind_accum, Concat("    Bind: ", Concat(t_name, Concat(" from ", from_name))));
            }
            ArraySet(cursor_out, 0, i);
            continue;
        } else if MatchLanguageWord(content, i, LanguageWordId.WordRefresh) || MatchLanguageWord(content, i, LanguageWordId.WordPublish) {
            let is_ref: Bool = MatchLanguageWord(content, i, LanguageWordId.WordRefresh);
            let ref_pub_label: String = "Publish";
            let ref_pub_kw_len: Int = LanguageWordLength(LanguageWordId.WordPublish);
            if is_ref {
                ref_pub_label = "Refresh";
                ref_pub_kw_len = LanguageWordLength(LanguageWordId.WordRefresh);
            }
            i = i + ref_pub_kw_len;
            i = SkipWhitespaceAndComments(content, i);
            let list_start: Int = i;
            let target_count: Int = 0;
            let target_expected: String = "tobject slot name";
            if is_ref { target_expected = "object slot name"; }
            if ParserCharAt(content, i) == "[" {
                i = i + 1;
                while true {
                    let dummy: String = ParseNameIn(location_context, content, i,
                        target_expected, "zone_projection", cursor_out);
                    target_count = target_count + 1;
                    i = SkipWhitespaceAndComments(content, cursor_out[0]);
                    if ParserCharAt(content, i) == "," {
                        i = i + 1;
                        continue;
                    }
                    break;
                }
                i = ParseExpectIn(location_context, content, i, "]", "zone_projection");
            } else {
                let dummy: String = ParseNameIn(location_context, content, i,
                    target_expected, "zone_projection", cursor_out);
                i = cursor_out[0];
                target_count = 1;
            }
            i = SkipWhitespaceAndComments(content, i);
            if !MatchLanguageWord(content, i, LanguageWordId.WordFrom) {
                ParseRefuse(location_context, i, "expected_token", "expected", "from", "construct", "zone_projection");
            }
            let from_name: String = ParseNameIn(location_context, content,
                LanguageWordEnd(i, LanguageWordId.WordFrom), "source slot name", "zone_projection", cursor_out);
            i = SkipWhitespaceAndComments(content, cursor_out[0]);
            let by_name: String = "";
            if MatchLanguageWord(content, i, LanguageWordId.WordBy) {
                by_name = ParseNameIn(location_context, content,
                    LanguageWordEnd(i, LanguageWordId.WordBy), "subject slot name", "zone_projection", cursor_out);
                i = cursor_out[0];
            }
            i = SkipWhitespaceAndComments(content, i);
            let map_at: Int = i;
            ArraySet(cursor_out, 0, i);
            let projection_map: ParserDomainProjectionMapRows =
                ParseDomainProjectionMapRows(location_context, content, i, cursor_out);
            i = cursor_out[0];
            if projection_map.present && target_count != 1 {
                ParseRefuse(location_context, map_at, "declaration_clause_invalid",
                    "rule", "a projection map needs a single target slot", "construct", "zone_projection");
            }
            i = SkipWhitespaceAndComments(content, i);
            if i < n && ParserCharAt(content, i) == ";" {
                i = i + 1;
            }

            let k: Int = list_start;
            if ParserCharAt(content, k) == "[" {
                k = k + 1;
                while true {
                    k = SkipWhitespaceAndComments(content, k);
                    ArraySet(cursor_out, 0, k);
                    let t_name: String = ReadIdent(content, k, cursor_out);
                    k = cursor_out[0];
                    let projection_row: String = Concat(
                        "    ", Concat(ref_pub_label, Concat(
                            ": ", Concat(t_name, Concat(" from ", from_name))
                        ))
                    );
                    if StringLength(by_name) > 0 {
                        projection_row = Concat(
                            projection_row, Concat(" by ", by_name)
                        );
                    }
                    bind_accum = AppendLine(bind_accum, projection_row);
                    k = SkipWhitespaceAndComments(content, k);
                    if ParserCharAt(content, k) == "," {
                        k = k + 1;
                        continue;
                    }
                    break;
                }
            } else {
                ArraySet(cursor_out, 0, k);
                let t_name: String = ReadIdent(content, k, cursor_out);
                let projection_row: String = Concat(
                    "    ", Concat(ref_pub_label, Concat(
                        ": ", Concat(t_name, Concat(" from ", from_name))
                    ))
                );
                if StringLength(by_name) > 0 {
                    projection_row = Concat(
                        projection_row, Concat(" by ", by_name)
                    );
                }
                bind_accum = AppendLine(bind_accum, projection_row);
                if projection_map.present {
                    bind_accum = AppendLine(
                        bind_accum, projection_map.tree_rows
                    );
                }
            }
            ArraySet(cursor_out, 0, i);
            continue;
        } else if MatchLanguageWord(content, i, LanguageWordId.WordFunc) {
            ArraySet(cursor_out, 0, i);
            let m_block: String = ParseFunction(
                content, i, cursor_out, "", false, 4, LanguageWordId.WordFunc, "Function: ",
                false, "", expression_graphs, location_context
            );
            i = cursor_out[0];
            auth_accum = AppendLine(auth_accum, m_block);
            continue;
        } else {
            // Zone members native admits and this parser does not cover yet.
            if MatchLanguageWord(content, i, LanguageWordId.WordVessel) || MatchLanguageWord(content, i, LanguageWordId.WordDetach) ||
                MatchLanguageWord(content, i, LanguageWordId.WordUnlink) || MatchLanguageWord(content, i, LanguageWordId.WordMaintain) {
                ParseRefuse(location_context, i, "surface_not_covered", "surface", Concat("zone ", ReadIdent(content, i, cursor_out)), "construct", "zone");
            }
            ParseRefuse(location_context, i, "expected_token", "expected", "zone member", "construct", "zone");
        }
        i = SkipWhitespaceAndComments(content, i);
        if is_auth {
            let auth_name: String = ParseNameIn(location_context, content, i,
                "subject slot name", "zone_authority", cursor_out);
            i = SkipWhitespaceAndComments(content, cursor_out[0]);
            let auth_req: String = "";
            if MatchLanguageWord(content, i, LanguageWordId.WordRequires) {
                i = LanguageWordEnd(i, LanguageWordId.WordRequires);
                i = SkipWhitespaceAndComments(content, i);
                ArraySet(cursor_out, 0, i);
                auth_req = ReadTypeIn(location_context, content, i, cursor_out);
                i = cursor_out[0];
                while true {
                    i = SkipWhitespaceAndComments(content, i);
                    if ParserCharAt(content, i) == "," {
                        i = i + 1;
                        i = SkipWhitespaceAndComments(content, i);
                        ArraySet(cursor_out, 0, i);
                        let next_req: String = ReadTypeIn(location_context, content, i, cursor_out);
                        i = cursor_out[0];
                        auth_req = Concat(auth_req, Concat(", ", next_req));
                        continue;
                    }
                    break;
                }
            }
            i = SkipWhitespaceAndComments(content, i);
            if ParserCharAt(content, i) == ";" {
                i = i + 1;
            }
            auth_accum = AppendLine(auth_accum, Concat("    Authority: ", auth_name));
            if StringLength(auth_req) > 0 {
                auth_accum = AppendLine(auth_accum, Concat("      Requires: ", auth_req));
            }
        } else {
            // `effect pool NAME: TYPE capacity N`; only an effect takes a pool.
            if slot_label == "EffectSlot" && MatchLanguageWord(content, i, LanguageWordId.WordPool) {
                let pool_name: String = ParseNameIn(location_context, content,
                    LanguageWordEnd(i, LanguageWordId.WordPool), "pool name", "zone_pool", cursor_out);
                i = ParseExpectIn(location_context, content, cursor_out[0], ":", "zone_pool");
                let pool_type: String = ParseNameIn(location_context, content, i,
                    "effect type", "zone_pool", cursor_out);
                i = SkipWhitespaceAndComments(content, cursor_out[0]);
                if !MatchLanguageWord(content, i, LanguageWordId.WordCapacity) {
                    ParseRefuse(location_context, i, "expected_token", "expected", "capacity", "construct", "zone_pool");
                }
                i = SkipWhitespaceAndComments(content, LanguageWordEnd(i, LanguageWordId.WordCapacity));
                let capacity_at: Int = i;
                ArraySet(cursor_out, 0, i);
                let capacity: String = ReadNumber(content, i, cursor_out);
                i = cursor_out[0];
                if StringLength(capacity) == 0 || StringIndexOf(capacity, ".") >= 0 ||
                    ToInt(capacity) <= 0 {
                    ParseRefuse(location_context, capacity_at, "expected_token", "expected",
                        "positive pool capacity", "construct", "zone_pool");
                }
                i = SkipWhitespaceAndComments(content, i);
                if ParserCharAt(content, i) == ";" { i = i + 1; }
                layer_accum = AppendLine(layer_accum, Concat("    EffectPool: ", Concat(pool_name,
                    Concat(": ", Concat(pool_type, Concat(" capacity ", ToString(ToInt(capacity))))))));
                continue;
            }
            if !MatchLanguageWord(content, i, LanguageWordId.WordSlot) {
                ParseRefuse(location_context, i, "expected_token", "expected", "slot", "construct", "zone_slot");
            }
            i = LanguageWordEnd(i, LanguageWordId.WordSlot);
            let s_name: String = ParseNameIn(location_context, content, i, "slot name", "zone_slot", cursor_out);
            i = ParseExpectIn(location_context, content, cursor_out[0], ":", "zone_slot");
            ArraySet(cursor_out, 0, i);
            let s_type: String = ReadTypeIn(location_context, content, i, cursor_out);
            i = cursor_out[0];
            if StringLength(s_type) == 0 {
                ParseRefuse(location_context, i, "type_name_invalid", "construct", "zone_slot", "", "");
            }
            i = SkipWhitespaceAndComments(content, i);
            if ParserCharAt(content, i) == "=" {
                // Projection initializers have no DIR/MIR/runtime owner.
                // Preserve native fail-closed behavior instead of silently
                // discarding a second source/materialization path.
                if slot_label == "ObjectSlot" ||
                    slot_label == "TObjectSlot" {
                    ParseRefuse(location_context, i, "declaration_clause_invalid",
                        "rule", "an object or tobject slot takes no initializer", "construct", "zone_slot");
                }
                i = i + 1;
                while i < n && ParserCharAt(content, i) != ";" &&
                    ParserCharAt(content, i) != "}" {
                    i = i + 1;
                }
            }
            if ParserCharAt(content, i) == ";" {
                i = i + 1;
            }
            let slot_row: String = Concat("    ", Concat(slot_label, Concat(": ", Concat(s_name, Concat(": ", s_type)))));
            if slot_label == "EffectSlot" || slot_label == "RelationSlot" {
                layer_accum = AppendLine(layer_accum, slot_row);
            } else {
                slot_accum = AppendLine(slot_accum, slot_row);
            }
        }
    }
    out = AppendLine(out, Concat("  Zone: ", Concat(decl_prefix, zone_name)));
    let zone_body: String = "";
    if StringLength(slot_accum) > 0 {
        zone_body = AppendLine(zone_body, slot_accum);
    }
    if StringLength(layer_accum) > 0 {
        zone_body = AppendLine(zone_body, layer_accum);
    }
    if StringLength(shared_accum) > 0 {
        zone_body = AppendLine(zone_body, shared_accum);
    }
    if StringLength(bind_accum) > 0 {
        zone_body = AppendLine(zone_body, bind_accum);
    }
    if StringLength(apply_accum) > 0 {
        zone_body = AppendLine(zone_body, apply_accum);
    }
    if StringLength(link_accum) > 0 {
        zone_body = AppendLine(zone_body, link_accum);
    }
    if StringLength(auth_accum) > 0 {
        zone_body = AppendLine(zone_body, auth_accum);
    }
    if StringLength(state_accum) > 0 {
        zone_body = AppendLine(zone_body, state_accum);
    }
    if StringLength(zone_body) > 0 {
        out = AppendLine(out, zone_body);
    }
    ArraySet(cursor_out, 0, i); return out;
}
