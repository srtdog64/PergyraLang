// Parse-stage diagnostics for the self-hosted parser.
//
// The parser rejected programs in silence: 318 bare `Exit(1)` sites against
// five that said anything, so a refused source produced no output at all. The
// parser knew why it refused -- duplicate name, unknown name, exclusive effect
// -- and dropped the reason on the way out.
//
// The semantic stage already emits a structured envelope. This is that same
// envelope for the parse stage, with the parser's own code/reason/fix table,
// which is exactly the split lib/diagnostic.pgy asks for: a tool owns its
// domain codes, the shared library owns the output shape.

import "../lib/diagnostic.pgy";
import "../lib/public_diagnostic_receipt_owner.pgy";
import "../lib/callable_contract_vocabulary_projection_owner.pgy";

enum ParseDiagnosticProjection {
    ParseDiagnosticText,
    ParseDiagnosticPublicJson,
}

func ParseDiagnosticProjectionFromPublicJsonRequest(
    emit_public_json: Bool
) -> ParseDiagnosticProjection {
    if emit_public_json { return ParseDiagnosticPublicJson; }
    return ParseDiagnosticText;
}

func ParseDiagnosticProjectionPublishesPublicJson(
    projection: ParseDiagnosticProjection
) -> Bool {
    match projection {
        case ParseDiagnosticText: return false;
        case ParseDiagnosticPublicJson: return true;
    }
}

func ParseDiagnosticSchema() -> String {
    return "pgy.selfhost.parse.v1";
}

// One row per code: reason and fix travel together, so the two texts cannot
// drift apart the way parallel per-code lookup tables can.
struct ParseDiagnosticRow {
    reason: String;
    fix: String;
}

func ParseDiagnosticRowForCode(code: String) -> ParseDiagnosticRow {
    if code == "callable_contract_duplicate_name" {
        return ParseDiagnosticRow(
            "the same contract name is listed twice in one clause",
            "remove the repeated name from the clause"
        );
    }
    if code == "callable_contract_unknown_name" {
        return ParseDiagnosticRow(
            "the contract name is not in the callable contract vocabulary",
            "use a name declared in src/semantic/callable_contract_vocabulary.def"
        );
    }
    if code == "callable_contract_exclusive_effect" {
        return ParseDiagnosticRow(
            "an exclusive effect cannot be combined with other effects",
            "declare the exclusive effect alone, or drop it"
        );
    }
    if code == "surface_not_covered" {
        return ParseDiagnosticRow(
            "this source surface is not yet covered by the self-hosted parser",
            "compile through --native-pipeline until the self-hosted compiler covers this surface"
        );
    }
    if code == "vision_surface_not_executable" {
        return ParseDiagnosticRow(
            "this form is a declared vision surface (docs/181); neither pipeline executes it yet",
            "remove the form; docs/181 names the rung that will open it"
        );
    }
    if code == "expression_statement_terminator" {
        return ParseDiagnosticRow(
            "an expression is followed by a token that cannot terminate its statement",
            "add `;` before the following token or end the statement with a newline"
        );
    }
    if code == "statement_head_unexpected_token" {
        return ParseDiagnosticRow(
            "a token cannot begin a statement",
            "start the statement with a supported declaration, control word, or expression name"
        );
    }
    if code == "block_unclosed" {
        return ParseDiagnosticRow(
            "the block opened here reaches the end of the file without its `}`",
            "add the matching `}` to close the block"
        );
    }
    if code == "expected_token" {
        return ParseDiagnosticRow(
            "a required token is missing at this position",
            "insert the expected token or remove what stands in its place"
        );
    }
    if code == "expression_invalid" {
        return ParseDiagnosticRow(
            "the expression starting here cannot be parsed",
            "complete the expression or remove the stray token"
        );
    }
    if code == "string_unterminated" {
        return ParseDiagnosticRow(
            "the string literal starting here is never closed",
            "add the closing `\"` or escape the quote inside the string"
        );
    }
    if code == "binding_name_reserved" {
        return ParseDiagnosticRow(
            "a reserved language word cannot name a local binding",
            "rename the binding, for example by adding a suffix"
        );
    }
    if code == "declaration_name_missing" {
        return ParseDiagnosticRow(
            "the declaration has no name at this position",
            "write the declaration name after its keyword"
        );
    }
    if code == "type_name_invalid" {
        return ParseDiagnosticRow(
            "a type name is missing or malformed at this position",
            "write a complete type, closing every `<` with `>`"
        );
    }
    if code == "int_literal_out_of_range" {
        return ParseDiagnosticRow(
            "Int literal is outside the signed 32-bit range",
            "write a Long literal with the L suffix"
        );
    }
    if code == "duration_literal_invalid" {
        return ParseDiagnosticRow(
            "a duration literal takes a bare integer count and must stay within 2^53 nanoseconds",
            "write a whole count directly before its unit: ns, us, ms, s or min"
        );
    }
    if code == "long_literal_out_of_range" {
        return ParseDiagnosticRow(
            "Long literal is outside the signed 64-bit range",
            "write a value between -9223372036854775808 and 9223372036854775807"
        );
    }
    if code == "statement_kind_unsupported" {
        return ParseDiagnosticRow(
            "the self-hosted compiler has no statement form for this expression",
            "call a function, assign the value, or compile through --native-pipeline"
        );
    }
    if code == "import_source_missing" {
        return ParseDiagnosticRow(
            "the imported file does not exist",
            "fix the import path; it is relative to the importing file"
        );
    }
    if code == "builtin_type_name_taken" {
        return ParseDiagnosticRow(
            "this program declares a builtin type name; IoError is the error enum of TryReadFile and TryWriteFile",
            "rename the declaration"
        );
    }
    if code == "script_statement_with_main" {
        return ParseDiagnosticRow(
            "top-level statements form the program's Main, and the program also declares func Main",
            "move the statements into func Main, or remove func Main and keep them at top level"
        );
    }
    if code == "declaration_clause_duplicate" {
        return ParseDiagnosticRow(
            "a clause the declaration admits once is written again",
            "remove the repeated clause"
        );
    }
    if code == "declaration_clause_invalid" {
        return ParseDiagnosticRow(
            "the clause breaks the rule named in the facts",
            "rewrite the clause so it keeps that rule"
        );
    }
    if code == "intent_shape_invalid" {
        return ParseDiagnosticRow(
            "the intent's steps and terminals do not have the shape its return type requires",
            "follow the rule named in the facts: a typed intent labels its terminals, and each of its steps binds one action outcome"
        );
    }
    return ParseDiagnosticRow(
        "the parser rejected this source",
        "check the reported source position"
    );
}

func ParseDiagnosticAxisLabel(axis: Int) -> String {
    if axis == CallableContractVocabularyCapabilityAxis() {
        return "capability";
    }
    if axis == CallableContractVocabularyEffectAxis() {
        return "effect";
    }
    return "unknown";
}

struct ParsePublicDiagnosticIdentity {
    ready: Bool;
    code: String;
    cause_ir: String;
    fix_source: String;
}

func ParsePublicDiagnosticIdentityForOwnedCode(
    code: String
) -> ParsePublicDiagnosticIdentity {
    if code == "callable_contract_duplicate_name" ||
        code == "callable_contract_unknown_name" ||
        code == "callable_contract_exclusive_effect" ||
        code == "expression_statement_terminator" ||
        code == "statement_head_unexpected_token" ||
        code == "block_unclosed" || code == "expected_token" ||
        code == "expression_invalid" || code == "binding_name_reserved" ||
        code == "declaration_name_missing" || code == "type_name_invalid" ||
        code == "import_source_missing" ||
        code == "statement_kind_unsupported" ||
        code == "int_literal_out_of_range" ||
        code == "long_literal_out_of_range" ||
        code == "duration_literal_invalid" ||
        code == "script_statement_with_main" ||
        code == "surface_not_covered" ||
        code == "vision_surface_not_executable" ||
        code == "declaration_clause_duplicate" ||
        code == "declaration_clause_invalid" {
        return ParsePublicDiagnosticIdentity(
            true, "PGY_PARSE_SYNTAX", "parse:unexpected_token", "check-syntax"
        );
    }
    // Native checks the typed-intent outcome shape in semantic; keep its identity.
    if code == "intent_shape_invalid" {
        return ParsePublicDiagnosticIdentity(
            true, "PGY_SEM_INTENT_STEP_INVALID", "semantic:intent_step",
            "check-intent-step-lowering"
        );
    }
    if code == "builtin_type_name_taken" {
        return ParsePublicDiagnosticIdentity(
            true, "PGY_SEM_REDECLARATION", "semantic:scope:duplicate_symbol",
            "rename-or-remove-duplicate"
        );
    }
    // Native reports an unclosed string from its lexer; keep that identity.
    if code == "string_unterminated" {
        return ParsePublicDiagnosticIdentity(
            true, "PGY_LEX_INVALID_TOKEN", "lex:invalid_token",
            "remove-or-escape-character"
        );
    }
    return ParsePublicDiagnosticIdentity(false, "", "", "");
}

func ParseDiagnosticPayload2(
    projection: ParseDiagnosticProjection,
    code: String,
    k1: String, v1: String,
    k2: String, v2: String
) -> String {
    return ParseDiagnosticPayloadAt2(projection, code, "", 0, 0, k1, v1, k2, v2);
}

// The parser cursor owned `file:line:column` when it refused, so text
// carries it in `Span:` and JSON in `location`; an unknown position is
// `none` / `null`.
func ParseDiagnosticPayloadAt2(
    projection: ParseDiagnosticProjection,
    code: String,
    file: String, line: Int, column: Int,
    k1: String, v1: String,
    k2: String, v2: String
) -> String {
    let row: ParseDiagnosticRow = ParseDiagnosticRowForCode(code);
    let span: String = "none";
    if file != "" && line >= 1 && column >= 1 {
        span = Concat(file, Concat(":", Concat(ToString(line),
            Concat(":", ToString(column)))));
    }
    // An unused fact pair (empty key) is left out rather than printed as `- : `.
    let facts: String = SelfHostDiagnostic.Fact2(k1, v1, k2, v2);
    if k2 == "" { facts = SelfHostDiagnostic.Fact1(k1, v1); }
    let text: String = SelfHostDiagnostic.RenderError(
        ParseDiagnosticSchema(), "parse", "error",
        code, row.reason, row.fix, span, facts
    );
    if !ParseDiagnosticProjectionPublishesPublicJson(projection) {
        return text;
    }
    let identity: ParsePublicDiagnosticIdentity =
        ParsePublicDiagnosticIdentityForOwnedCode(code);
    if !identity.ready {
        // Empty output makes the opaque transport fail closed without
        // recovering identity from rendered parser wording.
        return "";
    }
    return SelfHostPublicDiagnosticReceiptWireFromOwnedFacts(
        "parse", "syntax", identity.code, identity.cause_ir,
        identity.fix_source, text,
        SelfHostDiagnostic.LocationJson(file, line, column)
    );
}

// Reports only. The caller still owns the decision to stop, so the rejection
// stays one observable branch rather than a hidden exit inside a helper.
func ParseDiagnosticReport2(
    projection: ParseDiagnosticProjection,
    code: String,
    k1: String, v1: String,
    k2: String, v2: String
) -> Void {
    Log(ParseDiagnosticPayload2(projection, code, k1, v1, k2, v2));
}

func ParseDiagnosticReportContractName(
    projection: ParseDiagnosticProjection,
    code: String, axis: Int, name: String
) -> Void {
    ParseDiagnosticReport2(
        projection, code,
        "axis", ParseDiagnosticAxisLabel(axis), "name", name
    );
}
