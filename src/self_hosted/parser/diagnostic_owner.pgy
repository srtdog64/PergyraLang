// Parse-stage diagnostics for the self-hosted parser.
//
// The parser rejected programs in silence: 318 bare `Exit(1)` sites against
// five that said anything, so a refused source produced no output at all. The
// parser knew why it refused -- duplicate name, unknown name, exclusive effect
// -- and dropped the reason on the way out.
//
// The semantic stage already emits a structured envelope. This is that same
// envelope for the parse stage, with the parser's own code/reason/fix table,
// which is exactly the split lib/diagnostic.pgy asks for: a tool owns its
// domain codes, the shared library owns the output shape.

import "../lib/diagnostic.pgy";
import "../lib/callable_contract_vocabulary_projection_owner.pgy";

func ParseDiagnosticSchema() -> String {
    return "pgy.selfhost.parse.v1";
}

// One row per code: reason and fix travel together, so the two texts cannot
// drift apart the way parallel per-code lookup tables can.
struct ParseDiagnosticRow {
    reason: String;
    fix: String;
}

func ParseDiagnosticRowForCode(code: String) -> ParseDiagnosticRow {
    if code == "callable_contract_duplicate_name" {
        return ParseDiagnosticRow(
            "the same contract name is listed twice in one clause",
            "remove the repeated name from the clause"
        );
    }
    if code == "callable_contract_unknown_name" {
        return ParseDiagnosticRow(
            "the contract name is not in the callable contract vocabulary",
            "use a name declared in src/semantic/callable_contract_vocabulary.def"
        );
    }
    if code == "callable_contract_exclusive_effect" {
        return ParseDiagnosticRow(
            "an exclusive effect cannot be combined with other effects",
            "declare the exclusive effect alone, or drop it"
        );
    }
    if code == "surface_not_covered" {
        return ParseDiagnosticRow(
            "this source surface is not yet covered by the self-hosted parser",
            "compile through --native-pipeline until the self-hosted compiler covers this surface"
        );
    }
    return ParseDiagnosticRow(
        "the parser rejected this source",
        "check the reported source position"
    );
}

func ParseDiagnosticAxisLabel(axis: Int) -> String {
    if axis == CallableContractVocabularyCapabilityAxis() {
        return "capability";
    }
    if axis == CallableContractVocabularyEffectAxis() {
        return "effect";
    }
    return "unknown";
}

// Reports only. The caller still owns the decision to stop, so the rejection
// stays one observable branch rather than a hidden exit inside a helper.
func ParseDiagnosticReport2(
    code: String,
    k1: String, v1: String,
    k2: String, v2: String
) -> Void {
    let row: ParseDiagnosticRow = ParseDiagnosticRowForCode(code);
    Log(SelfHostDiagnostic.RenderError(
        ParseDiagnosticSchema(), "parse", "error",
        code,
        row.reason,
        row.fix,
        "none",
        SelfHostDiagnostic.Fact2(k1, v1, k2, v2)));
}

func ParseDiagnosticReportContractName(
    code: String, axis: Int, name: String
) -> Void {
    ParseDiagnosticReport2(
        code, "axis", ParseDiagnosticAxisLabel(axis), "name", name
    );
}

// A surface the self-hosted parser knows it does not cover yet -- lifecycle,
// use, extern. Naming the surface keeps the refusal honest: the old path fell
// through to statement parsing and reported "expected statement terminator",
// which sent the reader to the wrong layer. Fail-closed is unchanged; only
// the reason is now true.
func ParseDiagnosticReportUncoveredSurface(surface: String) -> Void {
    ParseDiagnosticReport2(
        "surface_not_covered",
        "surface", surface,
        "position", "top_level_declaration"
    );
}
