// Parser-owned syntax carriage for `map { target <- source }` projection
// entries.  This owner preserves spelling and parent structure only; DIR and
// semantic owners resolve declaration and field identity later. A malformed
// map is refused where it goes wrong.

import "cursor_owner.pgy";
import "tree_text_owner.pgy";
import "source_refusal_owner.pgy";

struct ParserDomainProjectionMapRows {
    present: Bool;
    entry_count: Int;
    tree_rows: String;
}

func ParserDomainProjectionMapRowsAbsent() -> ParserDomainProjectionMapRows {
    return ParserDomainProjectionMapRows(false, 0, "");
}

func ParseDomainProjectionMapRows(
    context: ParserSourceLocationContext,
    content: String,
    start: Int,
    inout cursor_out: Array<Int>
) -> ParserDomainProjectionMapRows {
    let i: Int = SkipWhitespaceAndComments(content, start);
    if !MatchLanguageWord(content, i, LanguageWordId.WordMap) {
        ArraySet(cursor_out, 0, i);
        return ParserDomainProjectionMapRowsAbsent();
    }
    i = LanguageWordEnd(i, LanguageWordId.WordMap);
    let open_at: Int = SkipWhitespaceAndComments(content, i);
    i = ParseExpectIn(context, content, i, "{", "projection_map");

    let rows: String = "";
    let count: Int = 0;
    while true {
        i = SkipWhitespaceAndComments(content, i);
        if i >= StringLength(content) {
            ParseRefuse(context, open_at, "block_unclosed",
                "construct", "projection_map", "", "");
        }
        if ParserCharAt(content, i) == "}" {
            if count == 0 {
                ParseRefuse(context, i, "expected_token", "expected",
                    "target <- source", "construct", "projection_map");
            }
            i = i + 1;
            break;
        }

        ArraySet(cursor_out, 0, i);
        let target_name: String = ReadIdent(content, i, cursor_out);
        i = cursor_out[0];
        if target_name == "" {
            ParseRefuse(context, i, "expected_token", "expected",
                "target field name", "construct", "projection_map");
        }
        i = ParseExpectIn(context, content, i, "<-", "projection_map");
        i = SkipWhitespaceAndComments(content, i);
        ArraySet(cursor_out, 0, i);
        let source_name: String = ReadIdent(content, i, cursor_out);
        i = cursor_out[0];
        if source_name == "" {
            ParseRefuse(context, i, "expected_token", "expected",
                "source field name", "construct", "projection_map");
        }

        rows = AppendLine(rows, Concat(
            "      ProjectionMap: ", Concat(
                target_name, Concat(" <- ", source_name)
            )
        ));
        count = count + 1;
        i = SkipWhitespaceAndComments(content, i);
        if i < StringLength(content) && ParserCharAt(content, i) == ";" {
            i = i + 1;
        }
    }
    ArraySet(cursor_out, 0, i);
    return ParserDomainProjectionMapRows(true, count, rows);
}
