// Self-host parser postfix expression owner.

import "cursor_owner.pgy";
import "expression_graph_owner.pgy";
import "expression_generic_actual_owner.pgy";
import "type_name_owner.pgy";

func ParserExpressionCallableCallee(
    fact: ParserExpressionFact
) -> Bool {
    if !fact.ok || !AstExpressionNodeIsCallableCallee(
        fact.arena.node_kinds[fact.root]
    ) {
        return false;
    }
    if fact.arena.node_kinds[fact.root] ==
            AstExpressionNodeMemberAccess() ||
        fact.arena.node_kinds[fact.root] ==
            AstExpressionNodeGenericCallee() {
        return true;
    }
    if fact.text == "" || !IsAlpha(ParserCharAt(fact.text, 0)) {
        return false;
    }
    let i: Int = 1;
    while i < StringLength(fact.text) &&
        IsAlphaNum(ParserCharAt(fact.text, i)) {
        i = i + 1;
    }
    return i == StringLength(fact.text);
}

func ApplyPostfixFact(
    content: String,
    base_start: ParserExpressionFact,
    after_base: Int,
    inout cursor_out: Array<Int>
) -> ParserExpressionFact {
    let base: ParserExpressionFact = base_start;
    let i: Int = after_base;

    // Postfix loop: call, indexing, try, member access, object init, and a
    // leading turbofish whose ordered type actuals belong to the call graph.
    while true {
        let after_ws: Int = SkipWhitespaceAndComments(content, i);
        let nc: String = ParserCharAt(content, after_ws);
        if nc == "<" {
            // First prove this is a call suffix. Comparison `<` remains owned
            // by precedence parsing and is never consumed here. The probe is
            // lexical and local: it must not search through an expression for
            // an unrelated later `>(` pair.
            let tf: Int = after_ws + 1;
            let tf_depth: Int = 1;
            let tf_ok: Bool = false;
            let tf_first: Int = SkipWhitespaceAndComments(content, tf);
            let tf_scanning: Bool = IsAlpha(
                ParserCharAt(content, tf_first)
            ) || (ParserCharAt(content, tf_first) == "(" &&
                ParserCharAt(content, tf_first + 1) == ")");
            while tf_scanning && tf < StringLength(content) &&
                tf_depth > 0 {
                let tf_after_trivia: Int =
                    SkipWhitespaceAndComments(content, tf);
                if tf_after_trivia > tf {
                    tf = tf_after_trivia;
                    continue;
                }
                let tc: String = ParserCharAt(content, tf);
                if tc == "<" {
                    tf_depth = tf_depth + 1;
                } else if tc == ">" {
                    tf_depth = tf_depth - 1;
                } else if IsAlphaNum(tc) || tc == "," {
                    // Written type-name surface.
                } else if tc == "(" &&
                    ParserCharAt(content, tf + 1) == ")" {
                    // Written Void type `()`.
                    tf = tf + 1;
                } else if tc == "&" &&
                    ParserCharAt(content, tf + 1) != "&" {
                    // Type intersection.
                } else if tc == "-" &&
                    ParserCharAt(content, tf + 1) == ">" {
                    // Function-type arrow; its `>` does not close the
                    // surrounding generic actual list.
                    tf = tf + 1;
                } else {
                    tf_scanning = false;
                }
                tf = tf + 1;
            }
            if tf_scanning && tf_depth == 0 {
                let after_gt: Int = SkipWhitespaceAndComments(content, tf);
                if ParserCharAt(content, after_gt) == "(" {
                    tf_ok = true;
                    i = tf;
                }
            }
            if tf_ok {
                let actual_cursor: Int = after_ws + 1;
                let actual_count: Int = 0;
                let generic_callee: ParserExpressionFact = base;
                while true {
                    actual_cursor = SkipWhitespaceAndComments(
                        content, actual_cursor
                    );
                    ArraySet(cursor_out, 0, actual_cursor);
                    let actual_type: String = ReadType(
                        content, actual_cursor, cursor_out
                    );
                    actual_cursor = cursor_out[0];
                    if actual_type == "" {
                        Exit(1);
                    }
                    generic_callee = ParserExpressionGenericCalleeActual(
                        generic_callee, actual_type
                    );
                    if !generic_callee.ok { Exit(1); }
                    actual_count = actual_count + 1;
                    actual_cursor = SkipWhitespaceAndComments(
                        content, actual_cursor
                    );
                    if ParserCharAt(content, actual_cursor) == "," {
                        actual_cursor = actual_cursor + 1;
                        continue;
                    }
                    break;
                }
                if actual_count == 0 ||
                    ParserCharAt(content, actual_cursor) != ">" {
                    Exit(1);
                }
                base = generic_callee;
                continue;
            }
            ArraySet(cursor_out, 0, i);
            break;
        }
        if nc == "{" {
            let field_probe: Int = SkipWhitespaceAndComments(content, after_ws + 1);
            let probe: Int = field_probe;
            while IsAlphaNum(ParserCharAt(content, probe)) {
                probe = probe + 1;
            }
            let after_field_probe: Int = SkipWhitespaceAndComments(content, probe);
            if !IsAlpha(ParserCharAt(content, field_probe)) || ParserCharAt(content, after_field_probe) != ":" {
                ArraySet(cursor_out, 0, i);
                break;
            }
            i = after_ws + 1;
            let init_args: String = "";
            let struct_literal: ParserExpressionFact =
                ParserExpressionStructLiteral(
                    Concat(base.text, " { }"), base
                );
            if !struct_literal.ok { Exit(1); }
            i = SkipWhitespaceAndComments(content, i);
            if ParserCharAt(content, i) != "}" {
                while true {
                    i = SkipWhitespaceAndComments(content, i);
                    ArraySet(cursor_out, 0, i);
                    let init_name: String = ReadIdent(content, i, cursor_out);
                    i = cursor_out[0];
                    if StringLength(init_name) == 0 {
                        Exit(1);
                    }
                    i = Expect(content, i, ":");
                    if i < 0 {
                        Exit(1);
                    }
                    ArraySet(cursor_out, 0, i);
                    let init_value: ParserExpressionFact = ParseExprFact(
                        content, i, cursor_out
                    );
                    if !init_value.ok { Exit(1); }
                    i = cursor_out[0];
                    let init_pair: String = Concat(
                        init_name, Concat(": ", init_value.text)
                    );
                    if StringLength(init_args) == 0 {
                        init_args = init_pair;
                    } else {
                        init_args = Concat(init_args, Concat(", ", init_pair));
                    }
                    let binding: ParserExpressionFact =
                        ParserExpressionStructFieldBinding(
                            init_pair, init_name, init_value
                        );
                    struct_literal = ParserExpressionStructField(
                        Concat(base.text, Concat(
                            " { ", Concat(init_args, " }")
                        )),
                        struct_literal, binding
                    );
                    if !struct_literal.ok { Exit(1); }
                    i = SkipWhitespaceAndComments(content, i);
                    if ParserCharAt(content, i) == "," {
                        i = i + 1;
                        continue;
                    }
                    break;
                }
            }
            i = Expect(content, i, "}");
            if i < 0 {
                Exit(1);
            }
            base = struct_literal;
            continue;
        }
        if nc == "(" {
            i = after_ws + 1;
            let arg_text: String = "";
            let graph_call: Bool = ParserExpressionCallableCallee(base);
            let call: ParserExpressionFact = ParserExpressionInvalid();
            if graph_call {
                call = ParserExpressionCall(
                    Concat(base.text, "()"), base
                );
                if !call.ok { Exit(1); }
            }
            i = SkipWhitespaceAndComments(content, i);
            if ParserCharAt(content, i) != ")" {
                while true {
                    ArraySet(cursor_out, 0, i);
                    let argument: ParserExpressionFact = ParseExprFact(
                        content, i, cursor_out
                    );
                    if !argument.ok { Exit(1); }
                    i = cursor_out[0];
                    if StringLength(arg_text) == 0 {
                        arg_text = argument.text;
                    } else {
                        arg_text = Concat(
                            arg_text, Concat(", ", argument.text)
                        );
                    }
                    if graph_call {
                        call = ParserExpressionCallArgument(
                            Concat(base.text, Concat(
                                "(", Concat(arg_text, ")")
                            )),
                            call, argument
                        );
                        if !call.ok { Exit(1); }
                    }
                    i = SkipWhitespaceAndComments(content, i);
                    if ParserCharAt(content, i) == "," {
                        i = i + 1;
                        continue;
                    }
                    break;
                }
            }
            i = Expect(content, i, ")");
            if i < 0 {
                Exit(1);
            }
            if graph_call {
                base = call;
            } else {
                base = ParserExpressionLeaf(Concat(
                    base.text, Concat("(", Concat(arg_text, ")"))
                ));
            }
            continue;
        }
        if nc == "[" {
            i = after_ws + 1;
            ArraySet(cursor_out, 0, i);
            let idx: ParserExpressionFact = ParseExprFact(
                content, i, cursor_out
            );
            if !idx.ok { Exit(1); }
            i = cursor_out[0];
            i = Expect(content, i, "]");
            if i < 0 {
                Exit(1);
            }
            let rendered: String = Concat(
                base.text, Concat("[", Concat(idx.text, "]"))
            );
            base = ParserExpressionBinary(
                AstExpressionNodeIndex(), rendered, base, idx
            );
            if !base.ok { Exit(1); }
            continue;
        }
        if nc == "?" && ParserCharAt(content, after_ws + 1) != "?" {
            i = after_ws + 1;
            let try_text: String = Concat("?", base.text);
            base = ParserExpressionUnary(
                AstExpressionNodeTry(), try_text, base
            );
            if !base.ok { Exit(1); }
            base.text = Concat("(", Concat(try_text, ")"));
            continue;
        }
        if nc == "." && ParserCharAt(content, after_ws + 1) != "." {
            i = after_ws + 1;
            i = SkipWhitespaceAndComments(content, i);
            ArraySet(cursor_out, 0, i);
            let member: String = ReadIdent(content, i, cursor_out);
            i = cursor_out[0];
            if StringLength(member) == 0 {
                Exit(1);
            }
            let rendered_member: String = Concat(
                base.text, Concat(".", member)
            );
            base = ParserExpressionBinary(
                AstExpressionNodeMemberAccess(), rendered_member,
                base, ParserExpressionLeaf(member)
            );
            if !base.ok { Exit(1); }
            continue;
        }
        break;
    }

    ArraySet(cursor_out, 0, i);
    return base;
}

func ParserExpressionPostfixGraphContractReady() -> Bool {
    let source: String = "values[1 + 2]";
    let cursor: Array<Int> = [0];
    let fact: ParserExpressionFact = ParseExprFact(source, 0, cursor);
    if !fact.ok || cursor[0] != StringLength(source) ||
        fact.arena.node_kinds[fact.root] != AstExpressionNodeIndex() {
        return false;
    }
    let base: Int = fact.arena.left_children[fact.root];
    let index: Int = fact.arena.right_children[fact.root];
    return fact.arena.node_kinds[base] == AstExpressionNodeLeaf() &&
        fact.arena.node_texts[base] == "values" &&
        fact.arena.node_kinds[index] == AstExpressionNodeAdd();
}

func ParserExpressionTryGraphContractReady() -> Bool {
    let source: String = "Pick(3)?";
    let cursor: Array<Int> = [0];
    let fact: ParserExpressionFact = ParseExprFact(source, 0, cursor);
    if !fact.ok || cursor[0] != StringLength(source) ||
        fact.text != "(?Pick(3))" ||
        fact.arena.node_kinds[fact.root] != AstExpressionNodeTry() ||
        fact.arena.node_texts[fact.root] != "?Pick(3)" {
        return false;
    }
    let operand: Int = fact.arena.left_children[fact.root];
    if fact.arena.node_kinds[operand] !=
        AstExpressionNodeCallArgument() {
        return false;
    }
    let call: Int = fact.arena.left_children[operand];
    let argument: Int = fact.arena.right_children[operand];
    let callee: Int = fact.arena.left_children[call];
    return fact.arena.node_kinds[call] == AstExpressionNodeCall() &&
        fact.arena.node_texts[callee] == "Pick" &&
        fact.arena.node_texts[argument] == "3";
}

func ParserExpressionCallGraphContractReady() -> Bool {
    let source: String = "Pick(1 + Next(2), values[0])";
    let cursor: Array<Int> = [0];
    let fact: ParserExpressionFact = ParseExprFact(source, 0, cursor);
    if !fact.ok || cursor[0] != StringLength(source) ||
        fact.arena.node_kinds[fact.root] !=
            AstExpressionNodeCallArgument() {
        return false;
    }
    let previous: Int = fact.arena.left_children[fact.root];
    let second_argument: Int = fact.arena.right_children[fact.root];
    if fact.arena.node_kinds[previous] !=
            AstExpressionNodeCallArgument() ||
        fact.arena.node_kinds[second_argument] != AstExpressionNodeIndex() {
        return false;
    }
    let call: Int = fact.arena.left_children[previous];
    let first_argument: Int = fact.arena.right_children[previous];
    if fact.arena.node_kinds[call] != AstExpressionNodeCall() ||
        fact.arena.node_kinds[first_argument] != AstExpressionNodeAdd() {
        return false;
    }
    let callee: Int = fact.arena.left_children[call];
    if fact.arena.node_kinds[callee] != AstExpressionNodeLeaf() ||
        fact.arena.node_texts[callee] != "Pick" {
        return false;
    }

    let colon_source: String = "Concat(\"head:\", Summary())";
    let colon_cursor: Array<Int> = [0];
    let colon_fact: ParserExpressionFact = ParseExprFact(
        colon_source, 0, colon_cursor
    );
    if !colon_fact.ok ||
        colon_cursor[0] != StringLength(colon_source) ||
        colon_fact.text != colon_source ||
        colon_fact.arena.node_kinds[colon_fact.root] !=
            AstExpressionNodeCallArgument() {
        return false;
    }
    let colon_previous: Int =
        colon_fact.arena.left_children[colon_fact.root];
    let summary_argument: Int =
        colon_fact.arena.right_children[colon_fact.root];
    if colon_fact.arena.node_kinds[colon_previous] !=
            AstExpressionNodeCallArgument() ||
        colon_fact.arena.node_kinds[summary_argument] !=
            AstExpressionNodeCall() {
        return false;
    }
    let colon_call: Int = colon_fact.arena.left_children[colon_previous];
    let colon_literal: Int = colon_fact.arena.right_children[colon_previous];
    let summary_callee: Int =
        colon_fact.arena.left_children[summary_argument];
    let colon_callee: Int = colon_fact.arena.left_children[colon_call];
    return colon_fact.arena.node_texts[colon_callee] == "Concat" &&
        colon_fact.arena.node_texts[colon_literal] == "\"head:\"" &&
        colon_fact.arena.node_texts[summary_callee] == "Summary";
}

func ParserExpressionExplicitGenericCallGraphContractReady() -> Bool {
    let comparison_source: String =
        "index.a[row] < 0 || (index.b[row] > (state_count))";
    let comparison_cursor: Array<Int> = [0];
    let comparison_fact: ParserExpressionFact = ParseExprFact(
        comparison_source, 0, comparison_cursor
    );
    if !comparison_fact.ok ||
        comparison_cursor[0] != StringLength(comparison_source) ||
        comparison_fact.arena.node_kinds[comparison_fact.root] !=
            AstExpressionNodeLogicalOr() {
        return false;
    }
    let comparison_left: Int =
        comparison_fact.arena.left_children[comparison_fact.root];
    let comparison_right: Int =
        comparison_fact.arena.right_children[comparison_fact.root];
    if comparison_fact.arena.node_kinds[comparison_left] !=
            AstExpressionNodeLess() ||
        comparison_fact.arena.node_kinds[comparison_right] !=
            AstExpressionNodeGreater() {
        return false;
    }

    let void_source: String = "Make<()>()";
    let void_cursor: Array<Int> = [0];
    let void_fact: ParserExpressionFact = ParseExprFact(
        void_source, 0, void_cursor
    );
    if !void_fact.ok || void_cursor[0] != StringLength(void_source) ||
        void_fact.arena.node_kinds[void_fact.root] !=
            AstExpressionNodeCall() {
        return false;
    }

    let source: String = "Pair<Array<Int>, String>(values)";
    let cursor: Array<Int> = [0];
    let fact: ParserExpressionFact = ParseExprFact(source, 0, cursor);
    if !fact.ok || cursor[0] != StringLength(source) ||
        fact.text != "Pair<Array<Int: Int>, String>(values)" ||
        fact.arena.node_kinds[fact.root] !=
            AstExpressionNodeCallArgument() {
        return false;
    }
    let call: Int = fact.arena.left_children[fact.root];
    if fact.arena.node_kinds[call] != AstExpressionNodeCall() {
        return false;
    }
    let second_callee: Int = fact.arena.left_children[call];
    if fact.arena.node_kinds[second_callee] !=
            AstExpressionNodeGenericCallee() {
        return false;
    }
    let first_callee: Int = fact.arena.left_children[second_callee];
    let second_actual: Int = fact.arena.right_children[second_callee];
    if fact.arena.node_kinds[first_callee] !=
            AstExpressionNodeGenericCallee() {
        return false;
    }
    let callee: Int = fact.arena.left_children[first_callee];
    let first_actual: Int = fact.arena.right_children[first_callee];
    return fact.arena.node_kinds[callee] == AstExpressionNodeLeaf() &&
        fact.arena.node_texts[callee] == "Pair" &&
        fact.arena.node_kinds[first_actual] ==
            AstExpressionNodeGenericTypeActual() &&
        fact.arena.node_texts[first_actual] == "Array<Int: Int>" &&
        fact.arena.node_kinds[second_actual] ==
            AstExpressionNodeGenericTypeActual() &&
        fact.arena.node_texts[second_actual] == "String";
}

func ParserExpressionMemberGraphContractReady() -> Bool {
    let source: String = "value.field.Method(1 + 2)";
    let cursor: Array<Int> = [0];
    let fact: ParserExpressionFact = ParseExprFact(source, 0, cursor);
    if !fact.ok || cursor[0] != StringLength(source) ||
        fact.arena.node_kinds[fact.root] !=
            AstExpressionNodeCallArgument() {
        return false;
    }
    let call: Int = fact.arena.left_children[fact.root];
    let argument: Int = fact.arena.right_children[fact.root];
    if fact.arena.node_kinds[call] != AstExpressionNodeCall() ||
        fact.arena.node_kinds[argument] != AstExpressionNodeAdd() {
        return false;
    }
    let method_access: Int = fact.arena.left_children[call];
    if fact.arena.node_kinds[method_access] !=
        AstExpressionNodeMemberAccess() {
        return false;
    }
    let field_access: Int = fact.arena.left_children[method_access];
    let method_name: Int = fact.arena.right_children[method_access];
    return fact.arena.node_kinds[field_access] ==
            AstExpressionNodeMemberAccess() &&
        fact.arena.node_texts[method_name] == "Method";
}
