// Self-host parser expression precedence owner.

import "cursor_owner.pgy";
import "expression_graph_owner.pgy";
import "type_name_owner.pgy";

func ParseUnaryFact(
    content: String,
    start: Int,
    cursor_out: Array<Int>
) -> ParserExpressionFact {
    let i: Int = SkipWhitespaceAndComments(content, start);
    if ParserCharAt(content, i) == "!" && ParserCharAt(content, i + 1) != "=" {
        i = i + 1;
        let operand: ParserExpressionFact = ParseUnaryFact(content, i, cursor_out);
        return ParserExpressionUnary(
            AstExpressionNodeLogicalNot(),
            Concat("(!", Concat(operand.text, ")")), operand
        );
    }
    if ParserCharAt(content, i) == "-" {
        i = i + 1;
        let operand: ParserExpressionFact = ParseUnaryFact(content, i, cursor_out);
        return ParserExpressionUnary(
            AstExpressionNodeNegate(),
            Concat("(-", Concat(operand.text, ")")), operand
        );
    }
    if ParserCharAt(content, i) == "&" && ParserCharAt(content, i + 1) != "&" {
        i = i + 1;
        let operand: ParserExpressionFact = ParseUnaryFact(content, i, cursor_out);
        return ParserExpressionLeaf(Concat("(&", Concat(operand.text, ")")));
    }
    if ParserCharAt(content, i) == "<" && ParserCharAt(content, i + 1) == "-" {
        i = i + 2;
        let operand: ParserExpressionFact = ParseUnaryFact(content, i, cursor_out);
        return ParserExpressionLeaf(Concat("<-", operand.text));
    }
    if MatchKeyword(content, i, "spawn") {
        i = i + 5;
        let after_spawn: Int = SkipWhitespaceAndComments(content, i);
        if MatchKeyword(content, after_spawn, "blocking") { i = after_spawn + 8; }
        let operand: ParserExpressionFact = ParseUnaryFact(content, i, cursor_out);
        return ParserExpressionLeaf(Concat("spawn ", operand.text));
    }
    if MatchKeyword(content, i, "await") {
        i = i + 5;
        let operand: ParserExpressionFact = ParseUnaryFact(content, i, cursor_out);
        return ParserExpressionLeaf(Concat("await ", operand.text));
    }
    return ParsePrimaryFact(content, i, cursor_out);
}

func ParseCastFact(
    content: String,
    start: Int,
    inout cursor_out: Array<Int>
) -> ParserExpressionFact {
    let left: ParserExpressionFact = ParseUnaryFact(
        content, start, cursor_out
    );
    let i: Int = cursor_out[0];
    while true {
        let before_ws: Int = i;
        i = SkipWhitespaceAndComments(content, i);
        if !MatchKeyword(content, i, "as") {
            ArraySet(cursor_out, 0, before_ws);
            return left;
        }
        i = i + 2;
        ArraySet(cursor_out, 0, i);
        let target_type: String = ReadType(content, i, cursor_out);
        i = cursor_out[0];
        if target_type == "" { return ParserExpressionInvalid(); }
        if target_type == "String" {
            let call: ParserExpressionFact = ParserExpressionCall(
                "ToString()", ParserExpressionLeaf("ToString")
            );
            left = ParserExpressionCallArgument(
                Concat("ToString(", Concat(left.text, ")")), call, left
            );
        } else {
            left = ParserExpressionCast(
                Concat(left.text, Concat(" as ", target_type)),
                left, target_type
            );
        }
        if !left.ok { return left; }
    }
    return left;
}

func ParseMulFact(
    content: String,
    start: Int,
    inout cursor_out: Array<Int>
) -> ParserExpressionFact {
    let left: ParserExpressionFact = ParseCastFact(content, start, cursor_out);
    let i: Int = cursor_out[0];
    while true {
        let before_ws: Int = i;
        i = SkipWhitespaceAndComments(content, i);
        let op: String = ParserCharAt(content, i);
        if op != "*" && op != "/" && op != "%" {
            ArraySet(cursor_out, 0, before_ws);
            return left;
        }
        i = i + 1;
        let right: ParserExpressionFact = ParseCastFact(content, i, cursor_out);
        i = cursor_out[0];
        let kind: Int = AstExpressionNodeMultiply();
        if op == "/" { kind = AstExpressionNodeDivide(); }
        else if op == "%" { kind = AstExpressionNodeModulo(); }
        let text: String = Concat(
            "(", Concat(left.text, Concat(" ", Concat(
                op, Concat(" ", Concat(right.text, ")"))
            )))
        );
        left = ParserExpressionBinary(kind, text, left, right);
    }
    return left;
}

func ParseAdditiveFact(
    content: String,
    start: Int,
    inout cursor_out: Array<Int>
) -> ParserExpressionFact {
    let left: ParserExpressionFact = ParseMulFact(content, start, cursor_out);
    let i: Int = cursor_out[0];
    while true {
        let before_ws: Int = i;
        i = SkipWhitespaceAndComments(content, i);
        let op: String = ParserCharAt(content, i);
        if op != "+" && op != "-" {
            ArraySet(cursor_out, 0, before_ws);
            return left;
        }
        i = i + 1;
        let right: ParserExpressionFact = ParseMulFact(content, i, cursor_out);
        i = cursor_out[0];
        let kind: Int = AstExpressionNodeAdd();
        if op == "-" { kind = AstExpressionNodeSubtract(); }
        let text: String = Concat(
            "(", Concat(left.text, Concat(" ", Concat(
                op, Concat(" ", Concat(right.text, ")"))
            )))
        );
        left = ParserExpressionBinary(kind, text, left, right);
    }
    return left;
}

func ParsePipeFact(
    content: String,
    start: Int,
    inout cursor_out: Array<Int>
) -> ParserExpressionFact {
    let left: ParserExpressionFact = ParseAdditiveFact(content, start, cursor_out);
    let i: Int = cursor_out[0];
    while true {
        let before_ws: Int = i;
        i = SkipWhitespaceAndComments(content, i);
        if ParserCharAt(content, i) != "|" || ParserCharAt(content, i + 1) != ">" {
            ArraySet(cursor_out, 0, before_ws);
            return left;
        }
        i = SkipWhitespaceAndComments(content, i + 2);
        ArraySet(cursor_out, 0, i);
        let fn_name: String = ReadIdent(content, i, cursor_out);
        i = cursor_out[0];
        if fn_name == "" { Exit(1); }
        let after_fn: Int = SkipWhitespaceAndComments(content, i);
        let combined_args: String = left.text;
        let call: ParserExpressionFact = ParserExpressionCall(
            Concat(fn_name, "()"), ParserExpressionLeaf(fn_name)
        );
        if !call.ok { Exit(1); }
        call = ParserExpressionCallArgument(
            Concat(fn_name, Concat("(", Concat(combined_args, ")"))),
            call, left
        );
        if !call.ok { Exit(1); }
        if ParserCharAt(content, after_fn) == "(" {
            i = SkipWhitespaceAndComments(content, after_fn + 1);
            if ParserCharAt(content, i) != ")" {
                while true {
                    ArraySet(cursor_out, 0, i);
                    let argument: ParserExpressionFact = ParseExprFact(
                        content, i, cursor_out
                    );
                    if !argument.ok { Exit(1); }
                    i = cursor_out[0];
                    combined_args = Concat(
                        combined_args, Concat(", ", argument.text)
                    );
                    call = ParserExpressionCallArgument(
                        Concat(fn_name, Concat(
                            "(", Concat(combined_args, ")")
                        )),
                        call, argument
                    );
                    if !call.ok { Exit(1); }
                    i = SkipWhitespaceAndComments(content, i);
                    if ParserCharAt(content, i) == "," { i = i + 1; continue; }
                    break;
                }
            }
            i = Expect(content, i, ")");
            if i < 0 { Exit(1); }
        }
        left = call;
    }
    return left;
}

func ParseComparisonFact(
    content: String,
    start: Int,
    inout cursor_out: Array<Int>
) -> ParserExpressionFact {
    let left: ParserExpressionFact = ParsePipeFact(content, start, cursor_out);
    let i: Int = cursor_out[0];
    while true {
        let before_ws: Int = i;
        i = SkipWhitespaceAndComments(content, i);
        let c0: String = ParserCharAt(content, i);
        let c1: String = ParserCharAt(content, i + 1);
        let op: String = "";
        if c0 == "=" && c1 == "=" { op = "=="; }
        else if c0 == "!" && c1 == "=" { op = "!="; }
        else if c0 == "<" && c1 == "=" { op = "<="; }
        else if c0 == ">" && c1 == "=" { op = ">="; }
        else if c0 == "<" { op = "<"; }
        else if c0 == ">" { op = ">"; }
        if op == "" {
            ArraySet(cursor_out, 0, before_ws);
            return left;
        }
        i = i + StringLength(op);
        let right: ParserExpressionFact = ParseAdditiveFact(content, i, cursor_out);
        i = cursor_out[0];
        let text: String = Concat("(", Concat(left.text, Concat(
            " ", Concat(op, Concat(" ", Concat(right.text, ")")))
        )));
        if op == "==" {
            left = ParserExpressionBinary(
                AstExpressionNodeEquality(), text, left, right
            );
        } else if op == "!=" {
            left = ParserExpressionBinary(
                AstExpressionNodeInequality(), text, left, right
            );
        } else if op == "<" {
            left = ParserExpressionBinary(
                AstExpressionNodeLess(), text, left, right
            );
        } else if op == "<=" {
            left = ParserExpressionBinary(
                AstExpressionNodeLessEqual(), text, left, right
            );
        } else if op == ">" {
            left = ParserExpressionBinary(
                AstExpressionNodeGreater(), text, left, right
            );
        } else if op == ">=" {
            left = ParserExpressionBinary(
                AstExpressionNodeGreaterEqual(), text, left, right
            );
        } else {
            return ParserExpressionInvalid();
        }
    }
    return left;
}

func ParseLogicalAndFact(
    content: String,
    start: Int,
    inout cursor_out: Array<Int>
) -> ParserExpressionFact {
    let left: ParserExpressionFact = ParseComparisonFact(content, start, cursor_out);
    let i: Int = cursor_out[0];
    while true {
        let before_ws: Int = i;
        i = SkipWhitespaceAndComments(content, i);
        if ParserCharAt(content, i) != "&" || ParserCharAt(content, i + 1) != "&" {
            ArraySet(cursor_out, 0, before_ws);
            return left;
        }
        i = i + 2;
        let right: ParserExpressionFact = ParseComparisonFact(content, i, cursor_out);
        i = cursor_out[0];
        let text: String = Concat(
            "(", Concat(left.text, Concat(" && ", Concat(right.text, ")")))
        );
        left = ParserExpressionBinary(
            AstExpressionNodeLogicalAnd(), text, left, right
        );
    }
    return left;
}

func ParseLogicalOrFact(
    content: String,
    start: Int,
    inout cursor_out: Array<Int>
) -> ParserExpressionFact {
    let left: ParserExpressionFact = ParseLogicalAndFact(content, start, cursor_out);
    let i: Int = cursor_out[0];
    while true {
        let before_ws: Int = i;
        i = SkipWhitespaceAndComments(content, i);
        if ParserCharAt(content, i) != "|" || ParserCharAt(content, i + 1) != "|" {
            ArraySet(cursor_out, 0, before_ws);
            return left;
        }
        i = i + 2;
        let right: ParserExpressionFact = ParseLogicalAndFact(content, i, cursor_out);
        i = cursor_out[0];
        let text: String = Concat(
            "(", Concat(left.text, Concat(" || ", Concat(right.text, ")")))
        );
        left = ParserExpressionBinary(
            AstExpressionNodeLogicalOr(), text, left, right
        );
    }
    return left;
}

func ParseExprFact(
    content: String,
    start: Int,
    cursor_out: Array<Int>
) -> ParserExpressionFact {
    return ParseLogicalOrFact(content, start, cursor_out);
}

func ParserExpressionPrecedenceGraphContractReady() -> Bool {
    let source: String = "1 + 2 * 3 >= 7 && 5 % 2 != 0";
    let cursor: Array<Int> = [0];
    let fact: ParserExpressionFact = ParseExprFact(source, 0, cursor);
    if !fact.ok || cursor[0] != StringLength(source) {
        return false;
    }
    let root: Int = fact.root;
    if fact.arena.node_kinds[root] != AstExpressionNodeLogicalAnd() {
        return false;
    }
    let comparison: Int = fact.arena.left_children[root];
    let inequality: Int = fact.arena.right_children[root];
    if fact.arena.node_kinds[comparison] !=
        AstExpressionNodeGreaterEqual() ||
        fact.arena.node_kinds[inequality] !=
            AstExpressionNodeInequality() {
        return false;
    }
    let addition: Int = fact.arena.left_children[comparison];
    let modulo: Int = fact.arena.left_children[inequality];
    return fact.arena.node_kinds[addition] == AstExpressionNodeAdd() &&
        fact.arena.node_kinds[fact.arena.right_children[addition]] ==
            AstExpressionNodeMultiply() &&
        fact.arena.node_kinds[modulo] == AstExpressionNodeModulo();
}

func ParserExpressionCastGraphContractReady() -> Bool {
    let source: String = "i as Float + g";
    let cursor: Array<Int> = [0];
    let fact: ParserExpressionFact = ParseExprFact(source, 0, cursor);
    let string_source: String = "i as String";
    let string_cursor: Array<Int> = [0];
    let string_fact: ParserExpressionFact = ParseExprFact(
        string_source, 0, string_cursor
    );
    if !fact.ok || !string_fact.ok ||
        cursor[0] != StringLength(source) ||
        string_cursor[0] != StringLength(string_source) ||
        fact.arena.node_kinds[fact.root] != AstExpressionNodeAdd() ||
        string_fact.arena.node_kinds[string_fact.root] !=
            AstExpressionNodeCallArgument() {
        return false;
    }
    let cast_node: Int = fact.arena.left_children[fact.root];
    let target_node: Int = fact.arena.right_children[cast_node];
    return fact.arena.node_kinds[cast_node] == AstExpressionNodeCast() &&
        fact.arena.node_kinds[target_node] ==
            AstExpressionNodeTypeName() &&
        fact.arena.node_texts[target_node] == "Float" &&
        string_fact.arena.node_texts[string_fact.root] == "ToString(i)";
}

func ParserExpressionUnaryGraphContractReady() -> Bool {
    let logical_cursor: Array<Int> = [0];
    let logical: ParserExpressionFact = ParseExprFact(
        "!!flag", 0, logical_cursor
    );
    let numeric_cursor: Array<Int> = [0];
    let numeric: ParserExpressionFact = ParseExprFact(
        "-(-value)", 0, numeric_cursor
    );
    if !logical.ok || !numeric.ok || logical_cursor[0] != 6 ||
        numeric_cursor[0] != 9 ||
        logical.arena.node_kinds[logical.root] !=
            AstExpressionNodeLogicalNot() ||
        numeric.arena.node_kinds[numeric.root] != AstExpressionNodeNegate() ||
        logical.arena.right_children[logical.root] != 0 ||
        numeric.arena.right_children[numeric.root] != 0 {
        return false;
    }
    let logical_operand: Int = logical.arena.left_children[logical.root];
    let numeric_operand: Int = numeric.arena.left_children[numeric.root];
    return logical.arena.node_kinds[logical_operand] ==
            AstExpressionNodeLogicalNot() &&
        numeric.arena.node_kinds[numeric_operand] ==
            AstExpressionNodeNegate();
}

func ParserExpressionPipeGraphContractReady() -> Bool {
    let source: String = "5 |> Double |> Add(3)";
    let cursor: Array<Int> = [0];
    let fact: ParserExpressionFact = ParseExprFact(source, 0, cursor);
    if !fact.ok || cursor[0] != StringLength(source) ||
        fact.text != "Add(Double(5), 3)" ||
        fact.arena.node_kinds[fact.root] !=
            AstExpressionNodeCallArgument() {
        return false;
    }
    let add_with_left: Int = fact.arena.left_children[fact.root];
    let add_extra: Int = fact.arena.right_children[fact.root];
    if fact.arena.node_kinds[add_with_left] !=
            AstExpressionNodeCallArgument() ||
        fact.arena.node_texts[add_extra] != "3" {
        return false;
    }
    let add_call: Int = fact.arena.left_children[add_with_left];
    let doubled: Int = fact.arena.right_children[add_with_left];
    let add_name: Int = fact.arena.left_children[add_call];
    if fact.arena.node_texts[add_name] != "Add" ||
        fact.arena.node_kinds[doubled] !=
            AstExpressionNodeCallArgument() {
        return false;
    }
    let double_call: Int = fact.arena.left_children[doubled];
    let double_arg: Int = fact.arena.right_children[doubled];
    let double_name: Int = fact.arena.left_children[double_call];
    return fact.arena.node_texts[double_name] == "Double" &&
        fact.arena.node_texts[double_arg] == "5";
}

// Compatibility text is a projection of the canonical parser fact, never a
// second parse path.
func ParseExpr(content: String, start: Int, cursor_out: Array<Int>) -> String {
    return ParseExprFact(content, start, cursor_out).text;
}
