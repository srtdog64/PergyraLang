// Self-host parser expression precedence owner.

import "cursor_owner.pgy";
import "expression_graph_owner.pgy";

func ParseUnaryFact(
    content: String,
    start: Int,
    cursor_out: Array<Int>
) -> ParserExpressionFact {
    let i: Int = SkipWhitespaceAndComments(content, start);
    if ParserCharAt(content, i) == "!" && ParserCharAt(content, i + 1) != "=" {
        i = i + 1;
        let operand: ParserExpressionFact = ParseUnaryFact(content, i, cursor_out);
        return ParserExpressionLeaf(Concat("(!", Concat(operand.text, ")")));
    }
    if ParserCharAt(content, i) == "-" {
        i = i + 1;
        let operand: ParserExpressionFact = ParseUnaryFact(content, i, cursor_out);
        return ParserExpressionLeaf(Concat("(-", Concat(operand.text, ")")));
    }
    if ParserCharAt(content, i) == "&" && ParserCharAt(content, i + 1) != "&" {
        i = i + 1;
        let operand: ParserExpressionFact = ParseUnaryFact(content, i, cursor_out);
        return ParserExpressionLeaf(Concat("(&", Concat(operand.text, ")")));
    }
    if ParserCharAt(content, i) == "<" && ParserCharAt(content, i + 1) == "-" {
        i = i + 2;
        let operand: ParserExpressionFact = ParseUnaryFact(content, i, cursor_out);
        return ParserExpressionLeaf(Concat("<-", operand.text));
    }
    if MatchKeyword(content, i, "spawn") {
        i = i + 5;
        let after_spawn: Int = SkipWhitespaceAndComments(content, i);
        if MatchKeyword(content, after_spawn, "blocking") { i = after_spawn + 8; }
        let operand: ParserExpressionFact = ParseUnaryFact(content, i, cursor_out);
        return ParserExpressionLeaf(Concat("spawn ", operand.text));
    }
    if MatchKeyword(content, i, "await") {
        i = i + 5;
        let operand: ParserExpressionFact = ParseUnaryFact(content, i, cursor_out);
        return ParserExpressionLeaf(Concat("await ", operand.text));
    }
    return ParsePrimaryFact(content, i, cursor_out);
}

func ParseMulFact(
    content: String,
    start: Int,
    inout cursor_out: Array<Int>
) -> ParserExpressionFact {
    let left: ParserExpressionFact = ParseUnaryFact(content, start, cursor_out);
    let i: Int = cursor_out[0];
    while true {
        let before_ws: Int = i;
        i = SkipWhitespaceAndComments(content, i);
        let op: String = ParserCharAt(content, i);
        if op != "*" && op != "/" && op != "%" {
            ArraySet(cursor_out, 0, before_ws);
            return left;
        }
        i = i + 1;
        let right: ParserExpressionFact = ParseUnaryFact(content, i, cursor_out);
        i = cursor_out[0];
        left = ParserExpressionLeaf(Concat(
            "(", Concat(left.text, Concat(" ", Concat(
                op, Concat(" ", Concat(right.text, ")"))
            )))
        ));
    }
    return left;
}

func ParseAdditiveFact(
    content: String,
    start: Int,
    inout cursor_out: Array<Int>
) -> ParserExpressionFact {
    let left: ParserExpressionFact = ParseMulFact(content, start, cursor_out);
    let i: Int = cursor_out[0];
    while true {
        let before_ws: Int = i;
        i = SkipWhitespaceAndComments(content, i);
        let op: String = ParserCharAt(content, i);
        if op != "+" && op != "-" {
            ArraySet(cursor_out, 0, before_ws);
            return left;
        }
        i = i + 1;
        let right: ParserExpressionFact = ParseMulFact(content, i, cursor_out);
        i = cursor_out[0];
        left = ParserExpressionLeaf(Concat(
            "(", Concat(left.text, Concat(" ", Concat(
                op, Concat(" ", Concat(right.text, ")"))
            )))
        ));
    }
    return left;
}

func ParsePipeFact(
    content: String,
    start: Int,
    inout cursor_out: Array<Int>
) -> ParserExpressionFact {
    let left: ParserExpressionFact = ParseAdditiveFact(content, start, cursor_out);
    let i: Int = cursor_out[0];
    while true {
        let before_ws: Int = i;
        i = SkipWhitespaceAndComments(content, i);
        if ParserCharAt(content, i) != "|" || ParserCharAt(content, i + 1) != ">" {
            ArraySet(cursor_out, 0, before_ws);
            return left;
        }
        i = SkipWhitespaceAndComments(content, i + 2);
        ArraySet(cursor_out, 0, i);
        let fn_name: String = ReadIdent(content, i, cursor_out);
        i = cursor_out[0];
        if fn_name == "" { Exit(1); }
        let after_fn: Int = SkipWhitespaceAndComments(content, i);
        let combined_args: String = left.text;
        if ParserCharAt(content, after_fn) == "(" {
            i = SkipWhitespaceAndComments(content, after_fn + 1);
            let extra_args: String = "";
            if ParserCharAt(content, i) != ")" {
                while true {
                    ArraySet(cursor_out, 0, i);
                    let argument: String = ParseExpr(content, i, cursor_out);
                    i = cursor_out[0];
                    if extra_args == "" { extra_args = argument; }
                    else { extra_args = Concat(extra_args, Concat(", ", argument)); }
                    i = SkipWhitespaceAndComments(content, i);
                    if ParserCharAt(content, i) == "," { i = i + 1; continue; }
                    break;
                }
            }
            i = Expect(content, i, ")");
            if i < 0 { Exit(1); }
            if extra_args != "" {
                combined_args = Concat(left.text, Concat(", ", extra_args));
            }
        }
        left = ParserExpressionLeaf(Concat(
            fn_name, Concat("(", Concat(combined_args, ")"))
        ));
    }
    return left;
}

func ParseComparisonFact(
    content: String,
    start: Int,
    inout cursor_out: Array<Int>
) -> ParserExpressionFact {
    let left: ParserExpressionFact = ParsePipeFact(content, start, cursor_out);
    let i: Int = cursor_out[0];
    while true {
        let before_ws: Int = i;
        i = SkipWhitespaceAndComments(content, i);
        let c0: String = ParserCharAt(content, i);
        let c1: String = ParserCharAt(content, i + 1);
        let op: String = "";
        if c0 == "=" && c1 == "=" { op = "=="; }
        else if c0 == "!" && c1 == "=" { op = "!="; }
        else if c0 == "<" && c1 == "=" { op = "<="; }
        else if c0 == ">" && c1 == "=" { op = ">="; }
        else if c0 == "<" { op = "<"; }
        else if c0 == ">" { op = ">"; }
        if op == "" {
            ArraySet(cursor_out, 0, before_ws);
            return left;
        }
        i = i + StringLength(op);
        let right: ParserExpressionFact = ParseAdditiveFact(content, i, cursor_out);
        i = cursor_out[0];
        let text: String = Concat("(", Concat(left.text, Concat(
            " ", Concat(op, Concat(" ", Concat(right.text, ")")))
        )));
        if op == "==" {
            left = ParserExpressionBinary(
                AstExpressionNodeEquality(), text, left, right
            );
        } else if op == "!=" {
            left = ParserExpressionBinary(
                AstExpressionNodeInequality(), text, left, right
            );
        } else {
            left = ParserExpressionLeaf(text);
        }
    }
    return left;
}

func ParseLogicalAndFact(
    content: String,
    start: Int,
    inout cursor_out: Array<Int>
) -> ParserExpressionFact {
    let left: ParserExpressionFact = ParseComparisonFact(content, start, cursor_out);
    let i: Int = cursor_out[0];
    while true {
        let before_ws: Int = i;
        i = SkipWhitespaceAndComments(content, i);
        if ParserCharAt(content, i) != "&" || ParserCharAt(content, i + 1) != "&" {
            ArraySet(cursor_out, 0, before_ws);
            return left;
        }
        i = i + 2;
        let right: ParserExpressionFact = ParseComparisonFact(content, i, cursor_out);
        i = cursor_out[0];
        let text: String = Concat(
            "(", Concat(left.text, Concat(" && ", Concat(right.text, ")")))
        );
        left = ParserExpressionBinary(
            AstExpressionNodeLogicalAnd(), text, left, right
        );
    }
    return left;
}

func ParseLogicalOrFact(
    content: String,
    start: Int,
    inout cursor_out: Array<Int>
) -> ParserExpressionFact {
    let left: ParserExpressionFact = ParseLogicalAndFact(content, start, cursor_out);
    let i: Int = cursor_out[0];
    while true {
        let before_ws: Int = i;
        i = SkipWhitespaceAndComments(content, i);
        if ParserCharAt(content, i) != "|" || ParserCharAt(content, i + 1) != "|" {
            ArraySet(cursor_out, 0, before_ws);
            return left;
        }
        i = i + 2;
        let right: ParserExpressionFact = ParseLogicalAndFact(content, i, cursor_out);
        i = cursor_out[0];
        let text: String = Concat(
            "(", Concat(left.text, Concat(" || ", Concat(right.text, ")")))
        );
        left = ParserExpressionBinary(
            AstExpressionNodeLogicalOr(), text, left, right
        );
    }
    return left;
}

func ParseExprFact(
    content: String,
    start: Int,
    cursor_out: Array<Int>
) -> ParserExpressionFact {
    return ParseLogicalOrFact(content, start, cursor_out);
}

// Compatibility text is a projection of the canonical parser fact, never a
// second parse path.
func ParseExpr(content: String, start: Int, cursor_out: Array<Int>) -> String {
    return ParseExprFact(content, start, cursor_out).text;
}
