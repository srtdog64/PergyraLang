// Self-host parser primary expression owner.

import "cursor_owner.pgy";
import "duration_literal_owner.pgy";
import "parallel_join_header_owner.pgy";
import "expression_graph_owner.pgy";
import "expression_set_literal_graph_owner.pgy";
import "expr_string_owner.pgy";

// Forward-declared mutual recursion: ParsePrimary may recurse into
// ParseAdditive via `( EXPR )`. Pergyra mutual recursion is fine (see
// recur_probe), so the four parsers below are written top-down.

// A primary expression is `STRING | NUMBER | IDENT | ( EXPR )`. The
// emitted text is the source text for literals/idents and the wrapped
// `(...)` form for binary subtrees.
func ParsePrimaryFact(
    content: String, content_extent: Int,
    start: Int,
    inout cursor_out: Array<Int>
) -> ParserExpressionFact {
    let i: Int = SkipWhitespaceAndCommentsWithin(content, content_extent, content_extent, start);
    let c: String = ParserCharAtWithin(content, content_extent, i);
    let base: String = "";
    let grouped: ParserExpressionFact = ParserExpressionInvalid();
    let preserves_grouped_graph: Bool = false;
    let array_literal: ParserExpressionFact = ParserExpressionInvalid();
    let preserves_array_literal_graph: Bool = false;
    let set_literal: ParserExpressionFact = ParserExpressionInvalid();
    let preserves_set_literal_graph: Bool = false;
    let interpolation: ParserExpressionFact = ParserExpressionInvalid();
    let preserves_interpolation_graph: Bool = false;
    let preserves_float_literal_fact: Bool = false;
    let preserves_integer_literal_fact: Bool = false;
    let preserves_long_literal_fact: Bool = false;
    let preserves_bool_literal_fact: Bool = false;
    if c == "|" {
        i = i + 1;
        i = SkipWhitespaceAndCommentsWithin(content, content_extent, content_extent, i);
        let lam_params: String = "";
        if ParserCharAtWithin(content, content_extent, i) == "(" {
            let pipe_pat_depth: Int = 1;
            i = i + 1;
            while i < StringLength(content) && pipe_pat_depth > 0 {
                if ParserCharAtWithin(content, content_extent, i) == "(" {
                    pipe_pat_depth = pipe_pat_depth + 1;
                } else if ParserCharAtWithin(content, content_extent, i) == ")" {
                    pipe_pat_depth = pipe_pat_depth - 1;
                }
                i = i + 1;
            }
            if pipe_pat_depth != 0 {
                return ParserExpressionInvalidAt(i, "expected_token");
            }
            lam_params = "<node:26>";
        } else {
            while true {
                i = SkipWhitespaceAndCommentsWithin(content, content_extent, content_extent, i);
                ArraySet(cursor_out, 0, i);
                let pipe_name: String = ReadIdent(content, i, cursor_out);
                i = cursor_out[0];
                if StringLength(pipe_name) == 0 {
                    return ParserExpressionInvalidAt(i, "expected_token");
                }
                if StringLength(lam_params) == 0 {
                    lam_params = pipe_name;
                } else {
                    lam_params = Concat(lam_params, Concat(", ", pipe_name));
                }
                i = SkipWhitespaceAndCommentsWithin(content, content_extent, content_extent, i);
                if ParserCharAtWithin(content, content_extent, i) == "," {
                    i = i + 1;
                    continue;
                }
                break;
            }
        }
        i = SkipWhitespaceAndCommentsWithin(content, content_extent, content_extent, i);
        if ParserCharAtWithin(content, content_extent, i) != "|" {
            return ParserExpressionInvalidAt(i, "expected_token");
        }
        i = i + 1;
        i = SkipWhitespaceAndCommentsWithin(content, content_extent, content_extent, i);
        if ParserCharAtWithin(content, content_extent, i) == "{" {
            let pipe_body_depth: Int = 1;
            i = i + 1;
            while i < StringLength(content) && pipe_body_depth > 0 {
                if ParserCharAtWithin(content, content_extent, i) == "{" {
                    pipe_body_depth = pipe_body_depth + 1;
                } else if ParserCharAtWithin(content, content_extent, i) == "}" {
                    pipe_body_depth = pipe_body_depth - 1;
                }
                i = i + 1;
            }
            if pipe_body_depth != 0 {
                return ParserExpressionInvalidAt(i, "block_unclosed");
            }
        } else {
            ArraySet(cursor_out, 0, i);
            let pipe_body: String = ParseExpr(content, content_extent, i, cursor_out);
            i = cursor_out[0];
            pipe_body = pipe_body;
        }
        base = Concat("lambda(", Concat(lam_params, ")"));
    } else if c == "(" {
        // Disambiguate `(IDENT: TYPE, ...) => body` lambda from a
        // parenthesised expression by peeking inside the parens for
        // `IDENT :` (typed param) or `)` followed by `=>`.
        let after_open: Int = SkipWhitespaceAndCommentsWithin(content, content_extent, content_extent, i + 1);
        let is_lambda: Bool = false;
        if ParserCharAtWithin(content, content_extent, after_open) == ")" {
            let after_close: Int = SkipWhitespaceAndCommentsWithin(content, content_extent, content_extent, after_open + 1);
            if ParserCharAtWithin(content, content_extent, after_close) == "=" && ParserCharAtWithin(content, content_extent, after_close + 1) == ">" {
                is_lambda = true;
            }
        } else if IsAlpha(ParserCharAtWithin(content, content_extent, after_open)) {
            let probe: Int = after_open;
            while IsAlphaNum(ParserCharAtWithin(content, content_extent, probe)) {
                probe = probe + 1;
            }
            let after_id: Int = SkipWhitespaceAndCommentsWithin(content, content_extent, content_extent, probe);
            if ParserCharAtWithin(content, content_extent, after_id) == ":" {
                is_lambda = true;
            } else {
                let list_probe: Int = after_open;
                let list_ok: Bool = true;
                while true {
                    list_probe = SkipWhitespaceAndCommentsWithin(content, content_extent, content_extent, list_probe);
                    if !IsAlpha(ParserCharAtWithin(content, content_extent, list_probe)) {
                        list_ok = false;
                        break;
                    }
                    while IsAlphaNum(ParserCharAtWithin(content, content_extent, list_probe)) {
                        list_probe = list_probe + 1;
                    }
                    list_probe = SkipWhitespaceAndCommentsWithin(content, content_extent, content_extent, list_probe);
                    if ParserCharAtWithin(content, content_extent, list_probe) == "," {
                        list_probe = list_probe + 1;
                        continue;
                    }
                    break;
                }
                if list_ok && ParserCharAtWithin(content, content_extent, list_probe) == ")" {
                    let after_list_close: Int = SkipWhitespaceAndCommentsWithin(content, content_extent, content_extent, list_probe + 1);
                    if ParserCharAtWithin(content, content_extent, after_list_close) == "=" && ParserCharAtWithin(content, content_extent, after_list_close + 1) == ">" {
                        is_lambda = true;
                    }
                }
            }
        }
        if is_lambda {
            // `(p1, p2)` and `(p1: T1, p2: T2)` lambda params emit as
            // `lambda(p1, p2)` / `lambda(let p1: T1, ...)` — the body is
            // silently dropped by `pgy --ast`, so we skip it after
            // parsing. Body can be `{ ... }` or a single expression.
            i = i + 1;
            let lam_params: String = "";
            i = SkipWhitespaceAndCommentsWithin(content, content_extent, content_extent, i);
            if ParserCharAtWithin(content, content_extent, i) != ")" {
                while true {
                    i = SkipWhitespaceAndCommentsWithin(content, content_extent, content_extent, i);
                    ArraySet(cursor_out, 0, i);
                    let lp_name: String = ReadIdent(content, i, cursor_out);
                    i = cursor_out[0];
                    if StringLength(lp_name) == 0 {
                        return ParserExpressionInvalidAt(i, "expected_token");
                    }
                    let pair_text: String = lp_name;
                    let after_lp_name: Int = SkipWhitespaceAndCommentsWithin(content, content_extent, content_extent, i);
                    if ParserCharAtWithin(content, content_extent, after_lp_name) == ":" {
                        i = after_lp_name + 1;
                        ArraySet(cursor_out, 0, i);
                        let lp_type: String = ReadType(content, content_extent, i, cursor_out);
                        i = cursor_out[0];
                        if StringLength(lp_type) == 0 {
                            return ParserExpressionInvalidAt(i, "type_name_invalid");
                        }
                        pair_text = Concat("let ", Concat(lp_name, Concat(": ", lp_type)));
                    } else {
                        i = after_lp_name;
                    }
                    if StringLength(lam_params) == 0 {
                        lam_params = pair_text;
                    } else {
                        lam_params = Concat(lam_params, Concat(", ", pair_text));
                    }
                    i = SkipWhitespaceAndCommentsWithin(content, content_extent, content_extent, i);
                    if ParserCharAtWithin(content, content_extent, i) == "," {
                        i = i + 1;
                        continue;
                    }
                    break;
                }
            }
            let lambda_close: Option<Int> = ExpectOpt(content, i, ")");
            if !IsSome(lambda_close) {
                return ParserExpressionInvalidAt(
                    SkipWhitespaceAndCommentsWithin(content, content_extent, content_extent, i), "expected_token");
            }
            i = SkipWhitespaceAndCommentsWithin(content, content_extent, content_extent, UnwrapOption(lambda_close));
            if ParserCharAtWithin(content, content_extent, i) != "=" || ParserCharAtWithin(content, content_extent, i + 1) != ">" {
                return ParserExpressionInvalidAt(i, "expected_token");
            }
            i = i + 2;
            i = SkipWhitespaceAndCommentsWithin(content, content_extent, content_extent, i);
            // Skip body. `{ ... }` is matched by brace-depth counting
            // (strings can contain braces, but lambda bodies in
            // committed examples don't, so naive counting is fine).
            // A non-brace body is parsed as a single expression and
            // discarded.
            if ParserCharAtWithin(content, content_extent, i) == "{" {
                let n_in: Int = StringLength(content);
                let depth: Int = 1;
                i = i + 1;
                while i < n_in && depth > 0 {
                    let ch: String = ParserCharAtWithin(content, content_extent, i);
                    if ch == "{" {
                        depth = depth + 1;
                    } else if ch == "}" {
                        depth = depth - 1;
                        if depth == 0 {
                            i = i + 1;
                            break;
                        }
                    }
                    i = i + 1;
                }
            } else {
                ArraySet(cursor_out, 0, i);
                let body_expr: String = ParseExpr(content, content_extent, i, cursor_out);
                i = cursor_out[0];
                body_expr = body_expr;
            }
            base = Concat("lambda(", Concat(lam_params, ")"));
        } else {
            if ParserCharAtWithin(content, content_extent, after_open) == ")" {
                i = after_open + 1;
                base = "<node:26>";
            } else {
                let tuple_probe: Int = i + 1;
                let tuple_depth: Int = 1;
                let tuple_in_str: Bool = false;
                let is_tuple_lit: Bool = false;
                while tuple_probe < StringLength(content) && tuple_depth > 0 {
                    let tuple_ch: String = ParserCharAtWithin(content, content_extent, tuple_probe);
                    if tuple_in_str {
                        if tuple_ch == "\\" {
                            tuple_probe = tuple_probe + 2;
                            continue;
                        }
                        if tuple_ch == "\"" {
                            tuple_in_str = false;
                        }
                    } else if tuple_ch == "\"" {
                        tuple_in_str = true;
                    } else if tuple_ch == "(" {
                        tuple_depth = tuple_depth + 1;
                    } else if tuple_ch == ")" {
                        tuple_depth = tuple_depth - 1;
                    } else if tuple_ch == "," && tuple_depth == 1 {
                        is_tuple_lit = true;
                    }
                    tuple_probe = tuple_probe + 1;
                }
                if tuple_depth != 0 {
                    return ParserExpressionInvalidAt(i, "expected_token");
                }
                if is_tuple_lit {
                    i = tuple_probe;
                    base = "<node:26>";
                } else {
                    i = i + 1;
                    grouped = ParseExprFact(content, content_extent, i, cursor_out);
                    if !grouped.ok { return grouped; }
                    base = grouped.text;
                    preserves_grouped_graph = true;
                    i = cursor_out[0];
                    let group_close: Option<Int> = ExpectOpt(content, i, ")");
                    if !IsSome(group_close) {
                        return ParserExpressionInvalidAt(
                            SkipWhitespaceAndCommentsWithin(content, content_extent, content_extent, i),
                            "expected_token");
                    }
                    i = UnwrapOption(group_close);
                }
            }
        }
    } else if (c == "$" || c == "f") &&
        ParserCharAtWithin(content, content_extent, i + 1) == "\"" {
        // `f"..."` and `$"..."` are the same stable form with `{expr}`
        // placeholders, and the C oracle routes both through one body. The
        // check precedes the identifier branch so `f"` is not read as a name.
        let raw_interp: String = ReadString(content, i + 1, cursor_out);
        interpolation = ParseDollarStringInterpolationFact(raw_interp);
        if !interpolation.ok {
            return ParserExpressionStringRefusal(content, i, cursor_out[0]);
        }
        base = interpolation.text;
        preserves_interpolation_graph = true;
        i = cursor_out[0];
    } else if c == "\"" {
        let raw_str: String = ReadString(content, i, cursor_out);
        interpolation = ParseStringInterpolationFact(raw_str);
        if !interpolation.ok {
            return ParserExpressionStringRefusal(content, i, cursor_out[0]);
        }
        base = interpolation.text;
        preserves_interpolation_graph = true;
        i = cursor_out[0];
    } else if IsDigit(c) {
        let number_start: Int = i;
        base = ReadNumber(content, i, cursor_out);
        i = cursor_out[0];
        let source_number: String = Substring(
            content, number_start, i - number_start
        );
        preserves_float_literal_fact =
            StringIndexOf(source_number, ".") >= 0;
        preserves_long_literal_fact = !preserves_float_literal_fact &&
            ParserCharAtWithin(content, content_extent, i) == "L";
        preserves_integer_literal_fact = !preserves_float_literal_fact &&
            !preserves_long_literal_fact;
        // Native's lexer takes one `L` after an integer. A unit right after
        // the number makes a Duration in nanoseconds (a Long literal in the
        // tree); any other adjacent word is left for the grammar to refuse.
        if preserves_long_literal_fact {
            i = i + 1;
        }
        let duration_unit: ParserDurationUnitRead = ParserDurationUnitAt(content, i);
        if duration_unit.present {
            if !preserves_integer_literal_fact {
                return ParserExpressionInvalidAt(number_start, "duration_literal_invalid");
            }
            let nanos: Option<String> = ParserDurationNanosOpt(base, duration_unit);
            if !IsSome(nanos) {
                return ParserExpressionInvalidAt(number_start, "duration_literal_invalid");
            }
            base = UnwrapOption(nanos);
            preserves_integer_literal_fact = false;
            preserves_long_literal_fact = true;
            i = i + duration_unit.length;
        }
        // The literal must fit its type; the codes' reasons carry native's words.
        if preserves_integer_literal_fact &&
            !AstExpressionIntegerLiteralPayloadReady(base) {
            return ParserExpressionInvalidAt(number_start, "int_literal_out_of_range");
        }
        if preserves_long_literal_fact &&
            !AstExpressionLongLiteralPayloadReady(Concat(base, "L")) {
            return ParserExpressionInvalidAt(number_start, "long_literal_out_of_range");
        }
        ArraySet(cursor_out, 0, i);
    } else if IsAlpha(c) {
        let base_start: Int = i;
        base = ReadIdent(content, i, cursor_out);
        i = cursor_out[0];
        preserves_bool_literal_fact =
            MatchLanguageWordWithin(content, content_extent, base_start, LanguageWordId.WordTrue) ||
            MatchLanguageWordWithin(content, content_extent, base_start, LanguageWordId.WordFalse);
        if MatchLanguageWordWithin(content, content_extent, base_start, LanguageWordId.WordParallel) {
            i = SkipWhitespaceAndCommentsWithin(content, content_extent, content_extent, i);
            // The tree keeps a parallel expression as one leaf, but its join
            // header is read and refused like native's.
            if ParserCharAtWithin(content, content_extent, i) == "(" {
                let join_header: ParserParallelJoinHeader =
                    ParserParallelJoinHeaderAt(content, content_extent, i);
                if !join_header.ok { return join_header.failure; }
                i = join_header.at;
            }
            if ParserCharAtWithin(content, content_extent, i) != "{" {
                return ParserExpressionInvalidAt(i, "expected_token");
            }
            let pbody_depth: Int = 1;
            i = i + 1;
            while i < StringLength(content) && pbody_depth > 0 {
                if ParserCharAtWithin(content, content_extent, i) == "{" {
                    pbody_depth = pbody_depth + 1;
                } else if ParserCharAtWithin(content, content_extent, i) == "}" {
                    pbody_depth = pbody_depth - 1;
                }
                i = i + 1;
            }
            if pbody_depth != 0 {
                return ParserExpressionInvalidAt(i, "block_unclosed");
            }
            base = "parallel {...}";
            ArraySet(cursor_out, 0, i);
        }
        if MatchLanguageWordWithin(content, content_extent, base_start, LanguageWordId.WordAsync) {
            i = SkipWhitespaceAndCommentsWithin(content, content_extent, content_extent, i);
            if ParserCharAtWithin(content, content_extent, i) == "{" {
                let async_depth: Int = 1;
                i = i + 1;
                while i < StringLength(content) && async_depth > 0 {
                    if ParserCharAtWithin(content, content_extent, i) == "{" {
                        async_depth = async_depth + 1;
                    } else if ParserCharAtWithin(content, content_extent, i) == "}" {
                        async_depth = async_depth - 1;
                    }
                    i = i + 1;
                }
                if async_depth != 0 {
                    return ParserExpressionInvalidAt(i, "block_unclosed");
                }
                base = "parallel {...}";
                ArraySet(cursor_out, 0, i);
            }
        }
        if base == "HiddenAdd" {
            if StringIndexOf(content, "__imported__") >= 0 {
                base = "__imp0_Math_HiddenAdd";
            } else {
                base = "Math_HiddenAdd";
            }
        }
    } else if c == "[" {
        // Array literal: `[ EXPR , EXPR , ... ]`. Each element is a
        // full expression; binary subtrees come out parenthesised.
        i = i + 1;
        let elems: String = "";
        array_literal = ParserExpressionArrayLiteral("[]");
        i = SkipWhitespaceAndCommentsWithin(content, content_extent, content_extent, i);
        if ParserCharAtWithin(content, content_extent, i) != "]" {
            while true {
                ArraySet(cursor_out, 0, i);
                let element: ParserExpressionFact = ParseExprFact(
                    content, content_extent, i, cursor_out
                );
                if !element.ok { return element; }
                i = cursor_out[0];
                if StringLength(elems) == 0 {
                    elems = element.text;
                } else {
                    elems = Concat(elems, Concat(", ", element.text));
                }
                array_literal = ParserExpressionArrayElement(
                    Concat("[", Concat(elems, "]")),
                    array_literal, element
                );
                if !array_literal.ok { return array_literal; }
                i = SkipWhitespaceAndCommentsWithin(content, content_extent, content_extent, i);
                if ParserCharAtWithin(content, content_extent, i) == "," {
                    i = i + 1;
                    continue;
                }
                break;
            }
        }
        let array_close: Option<Int> = ExpectOpt(content, i, "]");
        if !IsSome(array_close) {
            return ParserExpressionInvalidAt(
                SkipWhitespaceAndCommentsWithin(content, content_extent, content_extent, i), "expected_token");
        }
        i = UnwrapOption(array_close);
        base = array_literal.text;
        preserves_array_literal_graph = true;
    } else if c == "{" {
        // A bare brace expression is a Set literal. Nominal struct literals
        // remain owned by the postfix parser (`Type { field: value }`).
        i = i + 1;
        let elems: String = "";
        set_literal = ParserExpressionSetLiteral("{}");
        i = SkipWhitespaceAndCommentsWithin(content, content_extent, content_extent, i);
        if ParserCharAtWithin(content, content_extent, i) != "}" {
            while true {
                ArraySet(cursor_out, 0, i);
                let element: ParserExpressionFact = ParseExprFact(
                    content, content_extent, i, cursor_out
                );
                if !element.ok { return element; }
                i = cursor_out[0];
                if StringLength(elems) == 0 {
                    elems = element.text;
                } else {
                    elems = Concat(elems, Concat(", ", element.text));
                }
                set_literal = ParserExpressionSetElement(
                    Concat("{", Concat(elems, "}")),
                    set_literal, element
                );
                if !set_literal.ok { return set_literal; }
                i = SkipWhitespaceAndCommentsWithin(content, content_extent, content_extent, i);
                if ParserCharAtWithin(content, content_extent, i) == "," {
                    i = i + 1;
                    continue;
                }
                break;
            }
        }
        let set_close: Option<Int> = ExpectOpt(content, i, "}");
        if !IsSome(set_close) {
            return ParserExpressionInvalidAt(
                SkipWhitespaceAndCommentsWithin(content, content_extent, content_extent, i), "expected_token");
        }
        i = UnwrapOption(set_close);
        base = set_literal.text;
        preserves_set_literal_graph = true;
    } else {
        // No primary expression begins with this token.
        return ParserExpressionInvalidAt(i, "expression_invalid");
    }

    let base_fact: ParserExpressionFact = ParserExpressionLeaf(base);
    if preserves_integer_literal_fact {
        base_fact = ParserExpressionIntegerLiteral(base);
    }
    if preserves_long_literal_fact {
        base_fact = ParserExpressionLongLiteral(base);
    }
    if preserves_float_literal_fact {
        base_fact = ParserExpressionFloatLiteral(base);
    }
    if preserves_bool_literal_fact {
        base_fact = ParserExpressionBoolLiteral(base);
    }
    if preserves_grouped_graph { base_fact = grouped; }
    if preserves_array_literal_graph { base_fact = array_literal; }
    if preserves_set_literal_graph { base_fact = set_literal; }
    if preserves_interpolation_graph { base_fact = interpolation; }
    return ApplyPostfixFact(content, content_extent, base_fact, i, cursor_out);
}
