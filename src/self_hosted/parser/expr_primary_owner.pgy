// Self-host parser primary and postfix expression owner.

// Forward-declared mutual recursion: ParsePrimary may recurse into
// ParseAdditive via `( EXPR )`. Pergyra mutual recursion is fine (see
// recur_probe), so the four parsers below are written top-down.

// A primary expression is `STRING | NUMBER | IDENT | ( EXPR )`. The
// emitted text is the source text for literals/idents and the wrapped
// `(...)` form for binary subtrees.
func ParsePrimary(content: String, start: Int, inout cursor_out: Array<Int>) -> String {
    let i: Int = SkipWhitespaceAndComments(content, start);
    let c: String = CharAt(content, i);
    let base: String = "";
    if c == "|" {
        i = i + 1;
        i = SkipWhitespaceAndComments(content, i);
        let lam_params: String = "";
        if CharAt(content, i) == "(" {
            let pipe_pat_depth: Int = 1;
            i = i + 1;
            while i < StringLength(content) && pipe_pat_depth > 0 {
                if CharAt(content, i) == "(" {
                    pipe_pat_depth = pipe_pat_depth + 1;
                } else if CharAt(content, i) == ")" {
                    pipe_pat_depth = pipe_pat_depth - 1;
                }
                i = i + 1;
            }
            if pipe_pat_depth != 0 {
                Exit(1);
            }
            lam_params = "<node:26>";
        } else {
            while true {
                i = SkipWhitespaceAndComments(content, i);
                ArraySet(cursor_out, 0, i);
                let pipe_name: String = ReadIdent(content, i, cursor_out);
                i = cursor_out[0];
                if StringLength(pipe_name) == 0 {
                    Exit(1);
                }
                if StringLength(lam_params) == 0 {
                    lam_params = pipe_name;
                } else {
                    lam_params = Concat(lam_params, Concat(", ", pipe_name));
                }
                i = SkipWhitespaceAndComments(content, i);
                if CharAt(content, i) == "," {
                    i = i + 1;
                    continue;
                }
                break;
            }
        }
        i = SkipWhitespaceAndComments(content, i);
        if CharAt(content, i) != "|" {
            Exit(1);
        }
        i = i + 1;
        i = SkipWhitespaceAndComments(content, i);
        if CharAt(content, i) == "{" {
            let pipe_body_depth: Int = 1;
            i = i + 1;
            while i < StringLength(content) && pipe_body_depth > 0 {
                if CharAt(content, i) == "{" {
                    pipe_body_depth = pipe_body_depth + 1;
                } else if CharAt(content, i) == "}" {
                    pipe_body_depth = pipe_body_depth - 1;
                }
                i = i + 1;
            }
            if pipe_body_depth != 0 {
                Exit(1);
            }
        } else {
            ArraySet(cursor_out, 0, i);
            let pipe_body: String = ParseExpr(content, i, cursor_out);
            i = cursor_out[0];
            pipe_body = pipe_body;
        }
        base = Concat("lambda(", Concat(lam_params, ")"));
    } else if c == "(" {
        // Disambiguate `(IDENT: TYPE, ...) => body` lambda from a
        // parenthesised expression by peeking inside the parens for
        // `IDENT :` (typed param) or `)` followed by `=>`.
        let after_open: Int = SkipWhitespaceAndComments(content, i + 1);
        let is_lambda: Bool = false;
        if CharAt(content, after_open) == ")" {
            let after_close: Int = SkipWhitespaceAndComments(content, after_open + 1);
            if CharAt(content, after_close) == "=" && CharAt(content, after_close + 1) == ">" {
                is_lambda = true;
            }
        } else if IsAlpha(CharAt(content, after_open)) {
            let probe: Int = after_open;
            while IsAlphaNum(CharAt(content, probe)) {
                probe = probe + 1;
            }
            let after_id: Int = SkipWhitespaceAndComments(content, probe);
            if CharAt(content, after_id) == ":" {
                is_lambda = true;
            } else {
                let list_probe: Int = after_open;
                let list_ok: Bool = true;
                while true {
                    list_probe = SkipWhitespaceAndComments(content, list_probe);
                    if !IsAlpha(CharAt(content, list_probe)) {
                        list_ok = false;
                        break;
                    }
                    while IsAlphaNum(CharAt(content, list_probe)) {
                        list_probe = list_probe + 1;
                    }
                    list_probe = SkipWhitespaceAndComments(content, list_probe);
                    if CharAt(content, list_probe) == "," {
                        list_probe = list_probe + 1;
                        continue;
                    }
                    break;
                }
                if list_ok && CharAt(content, list_probe) == ")" {
                    let after_list_close: Int = SkipWhitespaceAndComments(content, list_probe + 1);
                    if CharAt(content, after_list_close) == "=" && CharAt(content, after_list_close + 1) == ">" {
                        is_lambda = true;
                    }
                }
            }
        }
        if is_lambda {
            // `(p1, p2)` and `(p1: T1, p2: T2)` lambda params emit as
            // `lambda(p1, p2)` / `lambda(let p1: T1, ...)` — the body is
            // silently dropped by `pgy --ast`, so we skip it after
            // parsing. Body can be `{ ... }` or a single expression.
            i = i + 1;
            let lam_params: String = "";
            i = SkipWhitespaceAndComments(content, i);
            if CharAt(content, i) != ")" {
                while true {
                    i = SkipWhitespaceAndComments(content, i);
                    ArraySet(cursor_out, 0, i);
                    let lp_name: String = ReadIdent(content, i, cursor_out);
                    i = cursor_out[0];
                    if StringLength(lp_name) == 0 {
                        Exit(1);
                    }
                    let pair_text: String = lp_name;
                    let after_lp_name: Int = SkipWhitespaceAndComments(content, i);
                    if CharAt(content, after_lp_name) == ":" {
                        i = after_lp_name + 1;
                        ArraySet(cursor_out, 0, i);
                        let lp_type: String = ReadType(content, i, cursor_out);
                        i = cursor_out[0];
                        if StringLength(lp_type) == 0 {
                            Exit(1);
                        }
                        pair_text = Concat("let ", Concat(lp_name, Concat(": ", lp_type)));
                    } else {
                        i = after_lp_name;
                    }
                    if StringLength(lam_params) == 0 {
                        lam_params = pair_text;
                    } else {
                        lam_params = Concat(lam_params, Concat(", ", pair_text));
                    }
                    i = SkipWhitespaceAndComments(content, i);
                    if CharAt(content, i) == "," {
                        i = i + 1;
                        continue;
                    }
                    break;
                }
            }
            i = Expect(content, i, ")");
            if i < 0 {
                Exit(1);
            }
            i = SkipWhitespaceAndComments(content, i);
            if CharAt(content, i) != "=" || CharAt(content, i + 1) != ">" {
                Exit(1);
            }
            i = i + 2;
            i = SkipWhitespaceAndComments(content, i);
            // Skip body. `{ ... }` is matched by brace-depth counting
            // (strings can contain braces, but lambda bodies in
            // committed examples don't, so naive counting is fine).
            // A non-brace body is parsed as a single expression and
            // discarded.
            if CharAt(content, i) == "{" {
                let n_in: Int = StringLength(content);
                let depth: Int = 1;
                i = i + 1;
                while i < n_in && depth > 0 {
                    let ch: String = CharAt(content, i);
                    if ch == "{" {
                        depth = depth + 1;
                    } else if ch == "}" {
                        depth = depth - 1;
                        if depth == 0 {
                            i = i + 1;
                            break;
                        }
                    }
                    i = i + 1;
                }
            } else {
                ArraySet(cursor_out, 0, i);
                let body_expr: String = ParseExpr(content, i, cursor_out);
                i = cursor_out[0];
                body_expr = body_expr;
            }
            base = Concat("lambda(", Concat(lam_params, ")"));
        } else {
            if CharAt(content, after_open) == ")" {
                i = after_open + 1;
                base = "<node:26>";
            } else {
                let tuple_probe: Int = i + 1;
                let tuple_depth: Int = 1;
                let is_tuple_lit: Bool = false;
                while tuple_probe < StringLength(content) && tuple_depth > 0 {
                    let tuple_ch: String = CharAt(content, tuple_probe);
                    if tuple_ch == "(" {
                        tuple_depth = tuple_depth + 1;
                    } else if tuple_ch == ")" {
                        tuple_depth = tuple_depth - 1;
                    } else if tuple_ch == "," && tuple_depth == 1 {
                        is_tuple_lit = true;
                    }
                    tuple_probe = tuple_probe + 1;
                }
                if tuple_depth != 0 {
                    Exit(1);
                }
                if is_tuple_lit {
                    i = tuple_probe;
                    base = "<node:26>";
                } else {
                    i = i + 1;
                    base = ParseLogicalOr(content, i, cursor_out);
                    i = cursor_out[0];
                    i = Expect(content, i, ")");
                    if i < 0 {
                        Exit(1);
                    }
                }
            }
        }
    } else if c == "$" && CharAt(content, i + 1) == "\"" {
        let raw_interp: String = ReadString(content, i + 1, cursor_out);
        base = DesugarDollarStringInterpolation(raw_interp);
        i = cursor_out[0];
    } else if c == "\"" {
        let raw_str: String = ReadString(content, i, cursor_out);
        base = DesugarStringInterpolation(raw_str);
        i = cursor_out[0];
    } else if IsDigit(c) {
        base = ReadNumber(content, i, cursor_out);
        i = cursor_out[0];
        while IsAlpha(CharAt(content, i)) {
            i = i + 1;
        }
        ArraySet(cursor_out, 0, i);
    } else if IsAlpha(c) {
        base = ReadIdent(content, i, cursor_out);
        i = cursor_out[0];
        if base == "parallel" {
            i = SkipWhitespaceAndComments(content, i);
            if CharAt(content, i) == "(" {
                let pexpr_depth: Int = 1;
                i = i + 1;
                while i < StringLength(content) && pexpr_depth > 0 {
                    if CharAt(content, i) == "(" {
                        pexpr_depth = pexpr_depth + 1;
                    } else if CharAt(content, i) == ")" {
                        pexpr_depth = pexpr_depth - 1;
                    }
                    i = i + 1;
                }
                if pexpr_depth != 0 {
                    Exit(1);
                }
            }
            i = SkipWhitespaceAndComments(content, i);
            if MatchKeyword(content, i, "join") {
                while i < StringLength(content) && CharAt(content, i) != "{" {
                    i = i + 1;
                }
            }
            if CharAt(content, i) == "{" {
                let pbody_depth: Int = 1;
                i = i + 1;
                while i < StringLength(content) && pbody_depth > 0 {
                    if CharAt(content, i) == "{" {
                        pbody_depth = pbody_depth + 1;
                    } else if CharAt(content, i) == "}" {
                        pbody_depth = pbody_depth - 1;
                    }
                    i = i + 1;
                }
                if pbody_depth != 0 {
                    Exit(1);
                }
                base = "parallel {...}";
                ArraySet(cursor_out, 0, i);
            }
        }
        if base == "async" {
            i = SkipWhitespaceAndComments(content, i);
            if CharAt(content, i) == "{" {
                let async_depth: Int = 1;
                i = i + 1;
                while i < StringLength(content) && async_depth > 0 {
                    if CharAt(content, i) == "{" {
                        async_depth = async_depth + 1;
                    } else if CharAt(content, i) == "}" {
                        async_depth = async_depth - 1;
                    }
                    i = i + 1;
                }
                if async_depth != 0 {
                    Exit(1);
                }
                base = "parallel {...}";
                ArraySet(cursor_out, 0, i);
            }
        }
        if base == "HiddenAdd" {
            if StringIndexOf(content, "__imported__") >= 0 {
                base = "__imp0_Math_HiddenAdd";
            } else {
                base = "Math_HiddenAdd";
            }
        }
    } else if c == "[" {
        // Array literal: `[ EXPR , EXPR , ... ]`. Each element is a
        // full expression; binary subtrees come out parenthesised.
        i = i + 1;
        let elems: String = "";
        i = SkipWhitespaceAndComments(content, i);
        if CharAt(content, i) != "]" {
            while true {
                ArraySet(cursor_out, 0, i);
                let e: String = ParseExpr(content, i, cursor_out);
                i = cursor_out[0];
                if StringLength(elems) == 0 {
                    elems = e;
                } else {
                    elems = Concat(elems, Concat(", ", e));
                }
                i = SkipWhitespaceAndComments(content, i);
                if CharAt(content, i) == "," {
                    i = i + 1;
                    continue;
                }
                break;
            }
        }
        i = Expect(content, i, "]");
        if i < 0 {
            Exit(1);
        }
        base = Concat("[", Concat(elems, "]"));
    } else {
        Exit(1);
    }

    // Postfix loop: `IDENT(args)` call form, `EXPR[idx]` indexing, and
    // `.member` access chain freely (`a()[0]`, `a[0].b()`). A leading
    // turbofish `<TYPE,...>` between the base and `(` is consumed and
    // dropped — `pgy --ast` prints `ClaimSlot<Int>()` as `ClaimSlot()`,
    // ignoring the type-arg list.
    while true {
        let after_ws: Int = SkipWhitespaceAndComments(content, i);
        let nc: String = CharAt(content, after_ws);
        if nc == "<" {
            // Tentatively skip a nested `<...>` type-argument list and only
            // commit if the char after the matching `>` is `(`. Otherwise
            // leave `<` for comparison parsing.
            let tf: Int = after_ws + 1;
            let tf_depth: Int = 1;
            let tf_ok: Bool = false;
            while tf < StringLength(content) && tf_depth > 0 {
                if CharAt(content, tf) == "<" {
                    tf_depth = tf_depth + 1;
                } else if CharAt(content, tf) == ">" {
                    tf_depth = tf_depth - 1;
                }
                tf = tf + 1;
            }
            if tf_depth == 0 {
                let after_gt: Int = SkipWhitespaceAndComments(content, tf);
                if CharAt(content, after_gt) == "(" {
                    tf_ok = true;
                    i = tf;
                }
            }
            if tf_ok {
                continue;
            }
            ArraySet(cursor_out, 0, i);
            break;
        }
        if nc == "{" {
            let field_probe: Int = SkipWhitespaceAndComments(content, after_ws + 1);
            let probe: Int = field_probe;
            while IsAlphaNum(CharAt(content, probe)) {
                probe = probe + 1;
            }
            let after_field_probe: Int = SkipWhitespaceAndComments(content, probe);
            if !IsAlpha(CharAt(content, field_probe)) || CharAt(content, after_field_probe) != ":" {
                ArraySet(cursor_out, 0, i);
                break;
            }
            i = after_ws + 1;
            let init_args: String = "";
            i = SkipWhitespaceAndComments(content, i);
            if CharAt(content, i) != "}" {
                while true {
                    i = SkipWhitespaceAndComments(content, i);
                    ArraySet(cursor_out, 0, i);
                    let init_name: String = ReadIdent(content, i, cursor_out);
                    i = cursor_out[0];
                    if StringLength(init_name) == 0 {
                        Exit(1);
                    }
                    i = Expect(content, i, ":");
                    if i < 0 {
                        Exit(1);
                    }
                    ArraySet(cursor_out, 0, i);
                    let init_value: String = ParseExpr(content, i, cursor_out);
                    i = cursor_out[0];
                    let init_pair: String = Concat(init_name, Concat(": ", init_value));
                    if StringLength(init_args) == 0 {
                        init_args = init_pair;
                    } else {
                        init_args = Concat(init_args, Concat(", ", init_pair));
                    }
                    i = SkipWhitespaceAndComments(content, i);
                    if CharAt(content, i) == "," {
                        i = i + 1;
                        continue;
                    }
                    break;
                }
            }
            i = Expect(content, i, "}");
            if i < 0 {
                Exit(1);
            }
            base = Concat(base, Concat("(", Concat(init_args, ")")));
            continue;
        }
        if nc == "(" {
            i = after_ws + 1;
            let arg_text: String = "";
            i = SkipWhitespaceAndComments(content, i);
            if CharAt(content, i) != ")" {
                while true {
                    ArraySet(cursor_out, 0, i);
                    let a: String = ParseExpr(content, i, cursor_out);
                    i = cursor_out[0];
                    if StringLength(arg_text) == 0 {
                        arg_text = a;
                    } else {
                        arg_text = Concat(arg_text, Concat(", ", a));
                    }
                    i = SkipWhitespaceAndComments(content, i);
                    if CharAt(content, i) == "," {
                        i = i + 1;
                        continue;
                    }
                    break;
                }
            }
            i = Expect(content, i, ")");
            if i < 0 {
                Exit(1);
            }
            base = Concat(base, Concat("(", Concat(arg_text, ")")));
            continue;
        }
        if nc == "[" {
            i = after_ws + 1;
            ArraySet(cursor_out, 0, i);
            let idx: String = ParseExpr(content, i, cursor_out);
            i = cursor_out[0];
            i = Expect(content, i, "]");
            if i < 0 {
                Exit(1);
            }
            base = Concat(base, Concat("[", Concat(idx, "]")));
            continue;
        }
        if nc == "?" {
            // Postfix try-operator `EXPR?` — the C printer rewrites it
            // as a prefix form wrapped in parens (`(?EXPR)`).
            i = after_ws + 1;
            base = Concat("(?", Concat(base, ")"));
            continue;
        }
        if nc == "." && CharAt(content, after_ws + 1) != "." {
            // Member access — distinguished from the `..` range operator
            // by requiring the next char to NOT be another `.`. Emitted
            // bare as `<base>.<member>` (no parens, even when chained).
            i = after_ws + 1;
            i = SkipWhitespaceAndComments(content, i);
            ArraySet(cursor_out, 0, i);
            let member: String = ReadIdent(content, i, cursor_out);
            i = cursor_out[0];
            if StringLength(member) == 0 {
                Exit(1);
            }
            base = Concat(base, Concat(".", member));
            continue;
        }
        break;
    }

    ArraySet(cursor_out, 0, i);
    return base;
}
