// Self-host parser expression string/interpolation graph owner.

import "cursor_owner.pgy";
import "expression_graph_owner.pgy";

func ParserExpressionInterpolationAppend(
    expression: ParserExpressionFact,
    part: ParserExpressionFact
) -> ParserExpressionFact {
    if !part.ok { return ParserExpressionInvalid(); }
    if !expression.ok { return part; }
    let text: String = Concat(
        "(", Concat(expression.text, Concat(" + ", Concat(part.text, ")")))
    );
    return ParserExpressionBinary(
        AstExpressionNodeAdd(), text, expression, part
    );
}

func ParserExpressionInterpolationValue(
    value: ParserExpressionFact
) -> ParserExpressionFact {
    if !value.ok { return ParserExpressionInvalid(); }
    let call: ParserExpressionFact = ParserExpressionCall(
        "ToString()", ParserExpressionLeaf("ToString")
    );
    return ParserExpressionCallArgument(
        Concat("ToString(", Concat(value.text, ")")), call, value
    );
}

func ParseStringInterpolationFact(s: String) -> ParserExpressionFact {
    let n: Int = StringLength(s);
    if StringIndexOf(s, "${") < 0 {
        return ParserExpressionStringLiteral(s);
    }
    let i: Int = 1;
    let segment_start: Int = 1;
    let expression: ParserExpressionFact = ParserExpressionInvalid();
    let content_end: Int = n - 1;
    while i < content_end {
        if ParserCharAt(s, i) == "$" && ParserCharAt(s, i + 1) == "{" {
            if i > segment_start {
                let part: String = Substring(
                    s, segment_start, i - segment_start
                );
                expression = ParserExpressionInterpolationAppend(
                    expression,
                    ParserExpressionStringLiteral(
                        Concat("\"", Concat(part, "\""))
                    )
                );
            }
            i = i + 2;
            let value_start: Int = i;
            while i < content_end && ParserCharAt(s, i) != "}" {
                i = i + 1;
            }
            if i >= content_end {
                return ParserExpressionStringLiteral(s);
            }
            expression = ParserExpressionInterpolationAppend(
                expression,
                ParserExpressionInterpolationValue(ParserExpressionLeaf(
                    Substring(s, value_start, i - value_start)
                ))
            );
            i = i + 1;
            segment_start = i;
            continue;
        }
        i = i + 1;
    }
    if segment_start < content_end {
        let tail: String = Substring(
            s, segment_start, content_end - segment_start
        );
        expression = ParserExpressionInterpolationAppend(
            expression,
            ParserExpressionStringLiteral(
                Concat("\"", Concat(tail, "\""))
            )
        );
    }
    if !expression.ok { return ParserExpressionStringLiteral("\"\""); }
    return expression;
}

func ParseDollarStringInterpolationFact(s: String) -> ParserExpressionFact {
    let n: Int = StringLength(s);
    if StringIndexOf(s, "{") < 0 {
        return ParserExpressionStringLiteral(s);
    }
    let i: Int = 1;
    let segment_start: Int = 1;
    let expression: ParserExpressionFact = ParserExpressionInvalid();
    let content_end: Int = n - 1;
    while i < content_end {
        if ParserCharAt(s, i) == "{" {
            if i > segment_start {
                let part: String = Substring(
                    s, segment_start, i - segment_start
                );
                expression = ParserExpressionInterpolationAppend(
                    expression,
                    ParserExpressionStringLiteral(
                        Concat("\"", Concat(part, "\""))
                    )
                );
            }
            i = i + 1;
            let value_start: Int = i;
            while i < content_end && ParserCharAt(s, i) != "}" {
                i = i + 1;
            }
            if i >= content_end {
                return ParserExpressionStringLiteral(s);
            }
            let value_source: String = Substring(
                s, value_start, i - value_start
            );
            let value_cursor: Array<Int> = [0];
            let value: ParserExpressionFact = ParseExprFact(
                value_source, 0, value_cursor
            );
            if !value.ok ||
                value_cursor[0] != StringLength(value_source) {
                return ParserExpressionStringLiteral(s);
            }
            expression = ParserExpressionInterpolationAppend(
                expression, ParserExpressionInterpolationValue(value)
            );
            i = i + 1;
            segment_start = i;
            continue;
        }
        i = i + 1;
    }
    if segment_start < content_end {
        let tail: String = Substring(
            s, segment_start, content_end - segment_start
        );
        expression = ParserExpressionInterpolationAppend(
            expression,
            ParserExpressionStringLiteral(
                Concat("\"", Concat(tail, "\""))
            )
        );
    }
    if !expression.ok { return ParserExpressionStringLiteral(s); }
    return expression;
}

func ParserExpressionInterpolationGraphContractReady() -> Bool {
    let fact: ParserExpressionFact = ParseStringInterpolationFact(
        Concat("\"hello ", Concat("$", "{lang}!\""))
    );
    if !fact.ok ||
        fact.arena.node_kinds[fact.root] != AstExpressionNodeAdd() {
        return false;
    }
    let left: Int = fact.arena.left_children[fact.root];
    let value_call: Int = fact.arena.right_children[left];
    return fact.text == "((\"hello \" + ToString(lang)) + \"!\")" &&
        fact.arena.node_kinds[left] == AstExpressionNodeAdd() &&
        fact.arena.node_kinds[value_call] ==
            AstExpressionNodeCallArgument();
}
