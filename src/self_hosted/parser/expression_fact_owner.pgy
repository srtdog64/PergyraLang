// Canonical parser expression result and unclassified leaf constructor.

import "../hir/ast_expression_graph_owner.pgy";

struct ParserExpressionFact {
    ok: Bool;
    text: String;
    root: Int;
    arena: AstExpressionArena;
}

func ParserExpressionInvalid() -> ParserExpressionFact {
    return ParserExpressionFact(false, "", 0, AstExpressionArenaEmpty());
}

func ParserExpressionLeaf(text: String) -> ParserExpressionFact {
    if text == "" { return ParserExpressionInvalid(); }
    let kinds: Array<Int> = [AstExpressionNodeLeaf()];
    let texts: Array<String> = [text];
    let left_children: Array<Int> = [0];
    let right_children: Array<Int> = [0];
    return ParserExpressionFact(
        true, text, 0,
        AstExpressionArena(kinds, texts, left_children, right_children)
    );
}
