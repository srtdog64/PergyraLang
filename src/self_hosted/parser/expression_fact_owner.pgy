// Canonical parser expression result and scalar leaf constructors.

import "../hir/ast_expression_graph_owner.pgy";

struct ParserExpressionFact {
    ok: Bool;
    text: String;
    root: Int;
    arena: AstExpressionArena;
}

func ParserExpressionInvalid() -> ParserExpressionFact {
    return ParserExpressionFact(false, "", 0, AstExpressionArenaEmpty());
}

func ParserExpressionLeaf(text: String) -> ParserExpressionFact {
    if text == "" { return ParserExpressionInvalid(); }
    let kinds: Array<Int> = [AstExpressionNodeLeaf()];
    let texts: Array<String> = [text];
    let left_children: Array<Int> = [0];
    let right_children: Array<Int> = [0];
    return ParserExpressionFact(
        true, text, 0,
        AstExpressionArena(kinds, texts, left_children, right_children)
    );
}

func ParserExpressionFloatLiteral(text: String) -> ParserExpressionFact {
    if text == "" { return ParserExpressionInvalid(); }
    let kinds: Array<Int> = [AstExpressionNodeFloatLiteral()];
    let texts: Array<String> = [text];
    let children: Array<Int> = [0];
    return ParserExpressionFact(
        true, text, 0, AstExpressionArena(kinds, texts, children, children)
    );
}

func ParserExpressionFactContractReady() -> Bool {
    let integer: ParserExpressionFact = ParserExpressionLeaf("16");
    let floating: ParserExpressionFact = ParserExpressionFloatLiteral("16");
    return integer.ok && floating.ok &&
        integer.arena.node_kinds[integer.root] == AstExpressionNodeLeaf() &&
        floating.arena.node_kinds[floating.root] ==
            AstExpressionNodeFloatLiteral() &&
        integer.text == floating.text;
}
