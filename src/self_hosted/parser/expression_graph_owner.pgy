// Recursive expression graph construction over parser-owned expression facts.

import "expression_scalar_fact_owner.pgy";

func ParserExpressionStructFieldName(text: String) -> ParserExpressionFact {
    if text == "" { return ParserExpressionInvalid(); }
    let kinds: Array<Int> = [AstExpressionNodeStructFieldName()];
    let texts: Array<String> = [text];
    let left_children: Array<Int> = [0];
    let right_children: Array<Int> = [0];
    return ParserExpressionFact(
        true, text, 0,
        AstExpressionArena(kinds, texts, left_children, right_children)
    );
}

func ParserExpressionUnary(
    kind: Int, text: String, operand: ParserExpressionFact
) -> ParserExpressionFact {
    if !operand.ok || text == "" ||
        !AstExpressionNodeIsUnaryOperator(kind) {
        return ParserExpressionInvalid();
    }
    let kinds: Array<Int> = operand.arena.node_kinds;
    let texts: Array<String> = operand.arena.node_texts;
    let left_children: Array<Int> = operand.arena.left_children;
    let right_children: Array<Int> = operand.arena.right_children;
    let root: Int = ArrayLength(kinds);
    ArrayPush(kinds, kind);
    ArrayPush(texts, text);
    ArrayPush(left_children, operand.root);
    ArrayPush(right_children, 0);
    let arena: AstExpressionArena = AstExpressionArena(
        kinds, texts, left_children, right_children
    );
    return ParserExpressionFact(
        AstExpressionArenaReady(arena), text, root, arena
    );
}

func ParserExpressionCall(
    text: String,
    callee: ParserExpressionFact
) -> ParserExpressionFact {
    if !callee.ok || text == "" ||
        !AstExpressionNodeIsCallableCallee(
            callee.arena.node_kinds[callee.root]
        ) {
        return ParserExpressionInvalid();
    }
    let kinds: Array<Int> = callee.arena.node_kinds;
    let texts: Array<String> = callee.arena.node_texts;
    let left_children: Array<Int> = callee.arena.left_children;
    let right_children: Array<Int> = callee.arena.right_children;
    let root: Int = ArrayLength(kinds);
    ArrayPush(kinds, AstExpressionNodeCall());
    ArrayPush(texts, text);
    ArrayPush(left_children, callee.root);
    ArrayPush(right_children, 0);
    let arena: AstExpressionArena = AstExpressionArena(
        kinds, texts, left_children, right_children
    );
    return ParserExpressionFact(
        AstExpressionArenaReady(arena), text, root, arena
    );
}

func ParserExpressionCallArgument(
    text: String,
    call: ParserExpressionFact,
    argument: ParserExpressionFact
) -> ParserExpressionFact {
    if !call.ok || !argument.ok ||
        !AstExpressionNodeIsCallSpine(
            call.arena.node_kinds[call.root]
        ) {
        return ParserExpressionInvalid();
    }
    return ParserExpressionBinary(
        AstExpressionNodeCallArgument(), text, call, argument
    );
}

func ParserExpressionArrayLiteral(text: String) -> ParserExpressionFact {
    if text == "" { return ParserExpressionInvalid(); }
    let kinds: Array<Int> = [AstExpressionNodeArrayLiteral()];
    let texts: Array<String> = [text];
    let left_children: Array<Int> = [0];
    let right_children: Array<Int> = [0];
    return ParserExpressionFact(
        true, text, 0,
        AstExpressionArena(kinds, texts, left_children, right_children)
    );
}

func ParserExpressionArrayElement(
    text: String,
    literal: ParserExpressionFact,
    element: ParserExpressionFact
) -> ParserExpressionFact {
    if !literal.ok || !AstExpressionNodeIsArrayLiteralSpine(
        literal.arena.node_kinds[literal.root]
    ) {
        return ParserExpressionInvalid();
    }
    return ParserExpressionBinary(
        AstExpressionNodeArrayElement(), text, literal, element
    );
}

func ParserExpressionStructLiteral(
    text: String,
    type_expression: ParserExpressionFact
) -> ParserExpressionFact {
    if !type_expression.ok || text == "" ||
        type_expression.arena.node_kinds[type_expression.root] !=
            AstExpressionNodeLeaf() {
        return ParserExpressionInvalid();
    }
    let kinds: Array<Int> = type_expression.arena.node_kinds;
    let texts: Array<String> = type_expression.arena.node_texts;
    let left_children: Array<Int> = type_expression.arena.left_children;
    let right_children: Array<Int> = type_expression.arena.right_children;
    let root: Int = ArrayLength(kinds);
    ArrayPush(kinds, AstExpressionNodeStructLiteral());
    ArrayPush(texts, text);
    ArrayPush(left_children, type_expression.root);
    ArrayPush(right_children, 0);
    let arena: AstExpressionArena = AstExpressionArena(
        kinds, texts, left_children, right_children
    );
    return ParserExpressionFact(
        AstExpressionArenaReady(arena), text, root, arena
    );
}

func ParserExpressionStructFieldBinding(
    text: String,
    field_name: String,
    value: ParserExpressionFact
) -> ParserExpressionFact {
    if field_name == "" || !value.ok {
        return ParserExpressionInvalid();
    }
    return ParserExpressionBinary(
        AstExpressionNodeStructFieldBinding(), text,
        ParserExpressionStructFieldName(field_name), value
    );
}

func ParserExpressionStructField(
    text: String,
    literal: ParserExpressionFact,
    binding: ParserExpressionFact
) -> ParserExpressionFact {
    if !literal.ok || !binding.ok ||
        !AstExpressionNodeIsStructLiteralSpine(
            literal.arena.node_kinds[literal.root]
        ) || binding.arena.node_kinds[binding.root] !=
            AstExpressionNodeStructFieldBinding() {
        return ParserExpressionInvalid();
    }
    return ParserExpressionBinary(
        AstExpressionNodeStructField(), text, literal, binding
    );
}

func ParserExpressionBinary(
    kind: Int,
    text: String,
    left: ParserExpressionFact,
    right: ParserExpressionFact
) -> ParserExpressionFact {
    if !left.ok || !right.ok || text == "" ||
        kind == AstExpressionNodeLeaf() ||
        !AstExpressionNodeKindKnown(kind) {
        return ParserExpressionInvalid();
    }
    let kinds: Array<Int> = [];
    let texts: Array<String> = [];
    let left_children: Array<Int> = [];
    let right_children: Array<Int> = [];
    let left_count: Int = AstExpressionArenaNodeCount(left.arena);
    let i: Int = 0;
    while i < left_count {
        ArrayPush(kinds, left.arena.node_kinds[i]);
        ArrayPush(texts, left.arena.node_texts[i]);
        ArrayPush(left_children, left.arena.left_children[i]);
        ArrayPush(right_children, left.arena.right_children[i]);
        i = i + 1;
    }
    let right_count: Int = AstExpressionArenaNodeCount(right.arena);
    i = 0;
    while i < right_count {
        ArrayPush(kinds, right.arena.node_kinds[i]);
        ArrayPush(texts, right.arena.node_texts[i]);
        let child_left: Int = right.arena.left_children[i];
        let child_right: Int = right.arena.right_children[i];
        let arity: Int = AstExpressionNodeArity(
            right.arena.node_kinds[i]
        );
        if arity >= 1 {
            child_left = child_left + left_count;
        }
        if arity == 2 {
            child_right = child_right + left_count;
        }
        ArrayPush(left_children, child_left);
        ArrayPush(right_children, child_right);
        i = i + 1;
    }
    let root: Int = ArrayLength(kinds);
    ArrayPush(kinds, kind);
    ArrayPush(texts, text);
    ArrayPush(left_children, left.root);
    ArrayPush(right_children, right.root + left_count);
    let arena: AstExpressionArena = AstExpressionArena(
        kinds, texts, left_children, right_children
    );
    return ParserExpressionFact(
        AstExpressionArenaReady(arena), text, root, arena
    );
}

func ParserExpressionGraphsAppend(
    rows: AstExpressionGraphRows,
    owner_kind: Int,
    lane: Int,
    fact: ParserExpressionFact
) -> AstExpressionGraphRows {
    if !rows.ok || !fact.ok || !AstExpressionOwnerKindKnown(owner_kind) ||
        lane < AstExpressionLaneAtom() || lane > AstExpressionLaneAuxiliary() {
        return AstExpressionGraphRows(
            false, rows.root_owner_kinds, rows.root_lanes,
            rows.roots, rows.arena
        );
    }
    let kinds: Array<Int> = rows.arena.node_kinds;
    let texts: Array<String> = rows.arena.node_texts;
    let left_children: Array<Int> = rows.arena.left_children;
    let right_children: Array<Int> = rows.arena.right_children;
    let owner_kinds: Array<Int> = rows.root_owner_kinds;
    let lanes: Array<Int> = rows.root_lanes;
    let roots: Array<Int> = rows.roots;
    let offset: Int = ArrayLength(kinds);
    let i: Int = 0;
    while i < AstExpressionArenaNodeCount(fact.arena) {
        ArrayPush(kinds, fact.arena.node_kinds[i]);
        ArrayPush(texts, fact.arena.node_texts[i]);
        let left: Int = fact.arena.left_children[i];
        let right: Int = fact.arena.right_children[i];
        let arity: Int = AstExpressionNodeArity(fact.arena.node_kinds[i]);
        if arity >= 1 {
            left = left + offset;
        }
        if arity == 2 {
            right = right + offset;
        }
        ArrayPush(left_children, left);
        ArrayPush(right_children, right);
        i = i + 1;
    }
    ArrayPush(owner_kinds, owner_kind);
    ArrayPush(lanes, lane);
    ArrayPush(roots, fact.root + offset);
    let arena: AstExpressionArena = AstExpressionArena(
        kinds, texts, left_children, right_children
    );
    let next: AstExpressionGraphRows = AstExpressionGraphRows(
        AstExpressionArenaReady(arena), owner_kinds, lanes, roots, arena
    );
    return next;
}

func ParserExpressionGraphsAppendRows(
    target: AstExpressionGraphRows,
    source: AstExpressionGraphRows
) -> AstExpressionGraphRows {
    if !target.ok || !AstExpressionGraphRowsReady(source) {
        return AstExpressionGraphRows(
            false, target.root_owner_kinds, target.root_lanes,
            target.roots, target.arena
        );
    }
    let next: AstExpressionGraphRows = target;
    let root_index: Int = 0;
    let previous_start: Int = 0;
    while root_index < ArrayLength(source.roots) {
        let root: Int = source.roots[root_index];
        let start: Int = previous_start;
        let end: Int = root + 1;
        let kinds: Array<Int> = [];
        let texts: Array<String> = [];
        let left_children: Array<Int> = [];
        let right_children: Array<Int> = [];
        let i: Int = start;
        while i < end {
            ArrayPush(kinds, source.arena.node_kinds[i]);
            ArrayPush(texts, source.arena.node_texts[i]);
            let left: Int = source.arena.left_children[i];
            let right: Int = source.arena.right_children[i];
            let arity: Int = AstExpressionNodeArity(
                source.arena.node_kinds[i]
            );
            if arity >= 1 {
                left = left - start;
            }
            if arity == 2 {
                right = right - start;
            }
            ArrayPush(left_children, left);
            ArrayPush(right_children, right);
            i = i + 1;
        }
        let fact: ParserExpressionFact = ParserExpressionFact(
            true, texts[ArrayLength(texts) - 1], root - start,
            AstExpressionArena(kinds, texts, left_children, right_children)
        );
        next = ParserExpressionGraphsAppend(
            next, source.root_owner_kinds[root_index],
            source.root_lanes[root_index], fact
        );
        previous_start = end;
        root_index = root_index + 1;
    }
    return next;
}

func ParserExpressionSubtree(
    fact: ParserExpressionFact,
    root: Int
) -> ParserExpressionFact {
    let count: Int = AstExpressionArenaNodeCount(fact.arena);
    if !fact.ok || root < 0 || root >= count {
        return ParserExpressionInvalid();
    }
    let pending: Array<Int> = [root];
    let start: Int = root;
    while ArrayLength(pending) > 0 {
        let node: Int = pending[ArrayLength(pending) - 1];
        ArrayPop(pending);
        if node < start { start = node; }
        let arity: Int = AstExpressionNodeArity(
            fact.arena.node_kinds[node]
        );
        if arity >= 1 {
            ArrayPush(pending, fact.arena.left_children[node]);
        }
        if arity == 2 {
            ArrayPush(pending, fact.arena.right_children[node]);
        }
    }
    let kinds: Array<Int> = [];
    let texts: Array<String> = [];
    let left_children: Array<Int> = [];
    let right_children: Array<Int> = [];
    let i: Int = start;
    while i <= root {
        let kind: Int = fact.arena.node_kinds[i];
        let left: Int = fact.arena.left_children[i];
        let right: Int = fact.arena.right_children[i];
        let arity: Int = AstExpressionNodeArity(kind);
        if arity >= 1 { left = left - start; }
        if arity == 2 { right = right - start; }
        ArrayPush(kinds, kind);
        ArrayPush(texts, fact.arena.node_texts[i]);
        ArrayPush(left_children, left);
        ArrayPush(right_children, right);
        i = i + 1;
    }
    let local_root: Int = root - start;
    let arena: AstExpressionArena = AstExpressionArena(
        kinds, texts, left_children, right_children
    );
    let rows: AstExpressionGraphRows = AstExpressionGraphRows(
        true, [TypedAstKindBareCallStmtTag()],
        [AstExpressionLaneAtom()], [local_root], arena
    );
    return ParserExpressionFact(
        AstExpressionGraphRowsReady(rows), texts[local_root],
        local_root, arena
    );
}

func ParserExpressionNamedCallArgumentAt(
    fact: ParserExpressionFact,
    expected_callee: String,
    argument_index: Int
) -> ParserExpressionFact {
    if !fact.ok || expected_callee == "" || argument_index < 0 {
        return ParserExpressionInvalid();
    }
    let reversed_arguments: Array<Int> = [];
    let call: Int = fact.root;
    while fact.arena.node_kinds[call] == AstExpressionNodeCallArgument() {
        ArrayPush(reversed_arguments, fact.arena.right_children[call]);
        call = fact.arena.left_children[call];
    }
    if fact.arena.node_kinds[call] != AstExpressionNodeCall() ||
        argument_index >= ArrayLength(reversed_arguments) {
        return ParserExpressionInvalid();
    }
    let callee: Int = fact.arena.left_children[call];
    while fact.arena.node_kinds[callee] ==
        AstExpressionNodeGenericCallee() {
        callee = fact.arena.left_children[callee];
    }
    if fact.arena.node_kinds[callee] != AstExpressionNodeLeaf() ||
        fact.arena.node_texts[callee] != expected_callee {
        return ParserExpressionInvalid();
    }
    return ParserExpressionSubtree(
        fact,
        reversed_arguments[ArrayLength(reversed_arguments) - argument_index - 1]
    );
}

func ParserExpressionNamedSingleCallArgument(
    fact: ParserExpressionFact,
    expected_callee: String
) -> ParserExpressionFact {
    if !fact.ok || fact.arena.node_kinds[fact.root] !=
            AstExpressionNodeCallArgument() ||
        fact.arena.node_kinds[fact.arena.left_children[fact.root]] !=
            AstExpressionNodeCall() {
        return ParserExpressionInvalid();
    }
    return ParserExpressionNamedCallArgumentAt(fact, expected_callee, 0);
}

func ParserExpressionDirectCallCalleeName(
    fact: ParserExpressionFact
) -> Option<String> {
    if !fact.ok { return None; }
    let node: Int = fact.root;
    while fact.arena.node_kinds[node] ==
        AstExpressionNodeCallArgument() {
        node = fact.arena.left_children[node];
    }
    if fact.arena.node_kinds[node] != AstExpressionNodeCall() {
        return None;
    }
    let callee: Int = fact.arena.left_children[node];
    while fact.arena.node_kinds[callee] ==
        AstExpressionNodeGenericCallee() {
        callee = fact.arena.left_children[callee];
    }
    if fact.arena.node_kinds[callee] != AstExpressionNodeLeaf() ||
        !IsIdentifier(fact.arena.node_texts[callee]) {
        return None;
    }
    return Some(fact.arena.node_texts[callee]);
}

func ParserExpressionDirectCallCalleeContractReady() -> Bool {
    let cursor: Array<Int> = [0];
    let source: String = "Mutate(value)";
    let call: ParserExpressionFact = ParseExprFact(source, 0, cursor);
    let callee: Option<String> = ParserExpressionDirectCallCalleeName(call);
    return call.ok && cursor[0] == StringLength(source) &&
        IsSome(callee) && UnwrapOption(callee) == "Mutate";
}

func ParserExpressionArrayLiteralGraphContractReady() -> Bool {
    let source: String = "[1 + 2, Double(4)]";
    let cursor: Array<Int> = [0];
    let fact: ParserExpressionFact = ParseExprFact(source, 0, cursor);
    if !fact.ok || cursor[0] != StringLength(source) ||
        fact.arena.node_kinds[fact.root] !=
            AstExpressionNodeArrayElement() {
        return false;
    }
    let previous: Int = fact.arena.left_children[fact.root];
    let second: Int = fact.arena.right_children[fact.root];
    if fact.arena.node_kinds[previous] !=
            AstExpressionNodeArrayElement() ||
        fact.arena.node_kinds[second] !=
            AstExpressionNodeCallArgument() {
        return false;
    }
    let empty: Int = fact.arena.left_children[previous];
    let first: Int = fact.arena.right_children[previous];
    return fact.arena.node_kinds[empty] ==
            AstExpressionNodeArrayLiteral() &&
        fact.arena.node_kinds[first] == AstExpressionNodeAdd();
}

func ParserExpressionStructLiteralGraphContractReady() -> Bool {
    let source: String =
        "Pair { left: 1 + 2, right: Next(3) }";
    let canonical: String =
        "Pair { left: (1 + 2), right: Next(3) }";
    let cursor: Array<Int> = [0];
    let fact: ParserExpressionFact = ParseExprFact(source, 0, cursor);
    if !fact.ok || cursor[0] != StringLength(source) ||
        fact.arena.node_kinds[fact.root] !=
            AstExpressionNodeStructField() || fact.text != canonical ||
        fact.arena.node_texts[fact.root] != canonical {
        return false;
    }
    let previous: Int = fact.arena.left_children[fact.root];
    let right_binding: Int = fact.arena.right_children[fact.root];
    if fact.arena.node_kinds[previous] !=
            AstExpressionNodeStructField() ||
        fact.arena.node_kinds[right_binding] !=
            AstExpressionNodeStructFieldBinding() {
        return false;
    }
    let literal: Int = fact.arena.left_children[previous];
    let left_binding: Int = fact.arena.right_children[previous];
    let type_node: Int = fact.arena.left_children[literal];
    let left_name: Int = fact.arena.left_children[left_binding];
    let left_value: Int = fact.arena.right_children[left_binding];
    let right_name: Int = fact.arena.left_children[right_binding];
    let right_value: Int = fact.arena.right_children[right_binding];
    return fact.arena.node_kinds[literal] ==
            AstExpressionNodeStructLiteral() &&
        fact.arena.node_texts[type_node] == "Pair" &&
        fact.arena.node_kinds[left_name] ==
            AstExpressionNodeStructFieldName() &&
        fact.arena.node_texts[left_name] == "left" &&
        fact.arena.node_kinds[left_value] == AstExpressionNodeAdd() &&
        fact.arena.node_texts[right_name] == "right" &&
        fact.arena.node_kinds[right_value] ==
            AstExpressionNodeCallArgument();
}

func ParserExpressionNamedSingleCallArgumentContractReady() -> Bool {
    let cursor: Array<Int> = [0];
    let source: String = "Log(ToString(20 + 22))";
    let call: ParserExpressionFact = ParseExprFact(source, 0, cursor);
    let argument: ParserExpressionFact =
        ParserExpressionNamedSingleCallArgument(call, "Log");
    return call.ok && argument.ok &&
        cursor[0] == StringLength(source) &&
        argument.text == "ToString((20 + 22))" &&
        argument.arena.node_kinds[argument.root] ==
            AstExpressionNodeCallArgument();
}

func ParserExpressionNamedCallArgumentAtContractReady() -> Bool {
    let cursor: Array<Int> = [0];
    let source: String = "ArrayPush(nodes, Node(2, \"Let\"))";
    let call: ParserExpressionFact = ParseExprFact(source, 0, cursor);
    let argument: ParserExpressionFact =
        ParserExpressionNamedCallArgumentAt(call, "ArrayPush", 1);
    return call.ok && argument.ok &&
        cursor[0] == StringLength(source) &&
        argument.text == "Node(2, \"Let\")" &&
        argument.arena.node_kinds[argument.root] ==
            AstExpressionNodeCallArgument();
}

func ParserExpressionGraphContractReady() -> Bool {
    let left: ParserExpressionFact = ParserExpressionLeaf("a");
    let right: ParserExpressionFact = ParserExpressionLeaf("b");
    let fact: ParserExpressionFact = ParserExpressionBinary(
        AstExpressionNodeLogicalAnd(), "(a && b)", left, right
    );
    let rows: AstExpressionGraphRows = ParserExpressionGraphsAppend(
        AstExpressionGraphRowsEmpty(), TypedAstKindIfStmtTag(),
        AstExpressionLaneAtom(), fact
    );
    let malformed: AstExpressionGraphRows = AstExpressionGraphRows(
        true, [TypedAstKindIfStmtTag()], [AstExpressionLaneAtom()], [2],
        AstExpressionArena(
            [
                AstExpressionNodeLeaf(), AstExpressionNodeLeaf(),
                AstExpressionNodeLogicalAnd(), AstExpressionNodeLeaf()
            ],
            ["a", "b", "(a && b)", "unreachable"],
            [0, 0, 0, 0],
            [0, 0, 1, 0]
        )
    );
    return fact.ok && fact.root == 2 && AstExpressionGraphRowsReady(rows) &&
        !AstExpressionGraphRowsReady(malformed);
}
