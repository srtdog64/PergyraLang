// Executable parser contract for the Set-literal graph spine.

import "expr_owner.pgy";

func ParserExpressionSetLiteralGraphContractReady() -> Bool {
    let source: String = "{1, 2, 2}";
    let cursor: Array<Int> = [0];
    let fact: ParserExpressionFact = ParseExprFact(source, 0, cursor);
    if !fact.ok || cursor[0] != StringLength(source) ||
        fact.arena.node_kinds[fact.root] != AstExpressionNodeSetElement() {
        return false;
    }
    let spine: Int = fact.root;
    while fact.arena.node_kinds[spine] == AstExpressionNodeSetElement() {
        spine = fact.arena.left_children[spine];
    }
    let empty_cursor: Array<Int> = [0];
    let empty: ParserExpressionFact = ParseExprFact(
        "{}", 0, empty_cursor
    );
    return fact.arena.node_kinds[spine] == AstExpressionNodeSetLiteral() &&
        fact.arena.node_texts[spine] == "{}" && empty.ok &&
        empty_cursor[0] == 2 &&
        empty.arena.node_kinds[empty.root] == AstExpressionNodeSetLiteral();
}
