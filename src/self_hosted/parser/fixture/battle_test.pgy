vessel HP {
    current: Int;
    max: Int;

    func IsAlive(self) -> Bool {
        return current > 0;
    }

    func Hit(self, dmg: Int) -> Void {
        current = current - dmg;
    }
}

let a = HP(100, 100);
a.Hit(30);
let alive: Bool = a.IsAlive();
Log(ToString(a.current));
if alive {
    Log("still alive");
}

if !alive {
    Log("dead");
}
