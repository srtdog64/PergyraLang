// dyn keyword test — runtime vtable swapping via bind
// Expected output:
//   10
//   20

subject Fighter {
    let power: Int;
}

ability Combatable {
    func Attack(self) -> Int;
}

role Warrior for Fighter {
    impl Combatable {
        func Attack(self) -> Int {
            return self.power;
        }
    }
}

role Archer for Fighter {
    impl Combatable {
        func Attack(self) -> Int {
            return self.power * 2;
        }
    }
}

party Team {
    dyn role slot fighter: Combatable;
    shared hp: Int;
}

func Main() -> Void {
    let team: Team = Team();
    let hero: Fighter = Fighter(10);

    // Bind hero through Warrior → vtable dispatch, hero is self
    bind team.fighter = hero as Warrior;
    Log(team.fighter.Attack());

    // Swap to Archer at runtime → same call, different result
    bind team.fighter = hero as Archer;
    Log(team.fighter.Attack());
}
