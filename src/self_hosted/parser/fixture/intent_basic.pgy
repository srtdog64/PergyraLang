subject Buyer {
    let hp: Int;
}

zone CheckoutZone {
    subject slot buyer: Buyer
}

intent Checkout(zone: CheckoutZone, buyer: Buyer, price: Int) {
    exclusive;
    step Pay {
        where: CheckoutZone;
        using: zone;
        who: buyer;
        expect: true;
    }
    success: true;
    failure: false;
}

func Main() -> Void { Log("ok"); }
