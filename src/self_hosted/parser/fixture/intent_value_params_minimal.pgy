subject Buyer {
    let hp: Int;
    action Pay(self) -> Void { }
}

zone CheckoutZone {
    subject slot buyer: Buyer
}

intent Checkout(checkout: CheckoutZone, price: Int, buyer: Buyer, adjustments: Array<Int>) {
    step pay {
        where: CheckoutZone;
        using: checkout;
        who: buyer;
        guard: price > 0;
        expect: ArrayLength(adjustments) == 2;
        on: buyer.Pay();
    }
    success: true;
    failure: false;
}

func Main() -> Void {
    let buyer: Buyer = Buyer(3);
    let checkout: CheckoutZone = CheckoutZone(buyer);
    Log("intent value params minimal");
    Log(Checkout(checkout, 7, buyer, [1, 2]));
}
