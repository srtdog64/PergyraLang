// producer_consumer.pgy — Slot + Channel 기반 생산자-소비자 패턴
//
// Channel<Int>는 스레드 안전 링버퍼다.
// parallel 블록에서 생산자는 send, 소비자는 recv.
// 뮤텍스, 조건변수, 링버퍼 관리는 전부 런타임이 처리한다.

func Main() -> Void {
    let ch: Channel<Int> = Channel(8);
    let result: Slot<Int> = ClaimSlot<Int>();

    // 생산자-소비자: 병렬로 send/recv
    parallel {
        ch <- 10;
        ch <- 20;
        ch <- 30;
    }

    // 소비자: 순차적으로 수신 후 합산
    let a: Int = <- ch;
    let b: Int = <- ch;
    let c: Int = <- ch;
    Write(result, a + b + c);

    Log(Read(result));  // 기대: 60
    Release(result);

    // ChannelReady: 데이터 남았는지 확인
    if ChannelReady(ch) {
        Log(1);  // 도달하면 안 됨
    }
    if ChannelReady(ch) == false {
        Log(0);  // 기대: 0 (채널 비었음)
    }
}
