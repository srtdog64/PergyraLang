// zone_context_minimal.pgy
//
// Stable zone-first entry example:
// - a lexical `within Zone { ... }` block injects the default action zone
// - authority is introduced only where the zone needs an audited boundary

within BattleZone {
    subject Hero {
        let hp: Int;

        action Guard(self) authorized by self {
            self.hp = self.hp + 1;
        }
    }
}

zone BattleZone {
    subject slot hero: Hero
    authority hero
}

func Main() -> Void {
    Log("zone context minimal");
}
