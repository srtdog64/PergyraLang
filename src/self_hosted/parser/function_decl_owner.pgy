// Self-host parser function declaration owner.

import "cursor_owner.pgy";
import "tree_text_owner.pgy";
import "type_name_owner.pgy";
import "expr_owner.pgy";
import "stmt_owner.pgy";
import "generic_parameter_list_owner.pgy";
import "../lib/callable_contract_vocabulary_projection_owner.pgy";
import "diagnostic_owner.pgy";

func ParserCallableContractContains(names: Array<String>, name: String) -> Bool {
    let i: Int = 0;
    while i < ArrayLength(names) {
        if names[i] == name { return true; }
        i = i + 1;
    }
    return false;
}

func ParserCallableContractAppendName(
    inout names: Array<String>, name: String, axis: Int
) -> Bool {
    let index: Int = CallableContractVocabularyFindIndex(axis, name);
    // Each rejection reports before it returns. The three reasons used to
    // collapse into one bare `false`, and the caller then exited without a
    // word, so a rejected contract clause produced no output at all.
    if StringLength(name) == 0 || index < 0 {
        ParseDiagnosticReportContractName(
            "callable_contract_unknown_name", axis, name
        );
        return false;
    }
    if ParserCallableContractContains(names, name) {
        ParseDiagnosticReportContractName(
            "callable_contract_duplicate_name", axis, name
        );
        return false;
    }
    let zero_policy: Int = CallableContractVocabularyZeroPolicyAt(index);
    if zero_policy == CallableContractVocabularyZeroExclusive() &&
        ArrayLength(names) > 0 {
        ParseDiagnosticReportContractName(
            "callable_contract_exclusive_effect", axis, name
        );
        return false;
    }
    let i: Int = 0;
    while i < ArrayLength(names) {
        let existing: Int = CallableContractVocabularyFindIndex(
            axis, names[i]
        );
        if existing >= 0 && CallableContractVocabularyZeroPolicyAt(existing) ==
            CallableContractVocabularyZeroExclusive() {
            ParseDiagnosticReportContractName(
                "callable_contract_exclusive_effect", axis, names[i]
            );
            return false;
        }
        i = i + 1;
    }
    ArrayPush(names, name);
    return true;
}

func ParserCallableContractCanonicalNames(
    names: Array<String>, axis: Int
) -> String {
    let out: String = "";
    let rank: Int = 0;
    while rank < 9 {
        let index: Int = CallableContractVocabularyIndexAtRank(axis, rank);
        if index >= 0 && ParserCallableContractContains(
            names, CallableContractVocabularySpellingAt(index)
        ) {
            if StringLength(out) > 0 { out = Concat(out, ", "); }
            out = Concat(out, CallableContractVocabularySpellingAt(index));
        }
        rank = rank + 1;
    }
    return out;
}

func ParserCallableContractCanonicalEffects(names: Array<String>) -> String {
    return ParserCallableContractCanonicalNames(
        names, CallableContractVocabularyEffectAxis()
    );
}

func ParserCallableContractCanonicalCaps(names: Array<String>) -> String {
    return ParserCallableContractCanonicalNames(
        names, CallableContractVocabularyCapabilityAxis()
    );
}

// Parse one `func IDENT(params) -> RET { body }` declaration starting
// at the `func` keyword. Returns the formatted multi-line block.
// `base_indent` is the column at which `Function:` appears; child rows
// (`Parameters:`, `Returns:`, `Body:`) are at `base_indent + 2`,
// parameter lines at `base_indent + 4`, `Block:` at `base_indent + 4`,
// and statements inside the body at `base_indent + 6`.
//
// Used at both top level (base_indent = 2) and inside subject/class
// `Methods:` blocks (base_indent = 6).
func ParseFunction(
    content: String,
    start: Int,
    inout cursor_out: Array<Int>,
    name_prefix: String,
    is_export: Bool,
    base_indent: Int,
    fn_keyword: String,
    fn_label: String,
    is_signature: Bool,
    within_zone_arg: String,
    inout expression_graphs: Array<AstExpressionGraphRows>
) -> String {
    let kw: String = fn_keyword;
    if StringLength(kw) == 0 {
        kw = "func";
    }
    let i: Int = Expect(content, start, kw);
    if i < 0 {
        Exit(1);
    }
    i = SkipWhitespaceAndComments(content, i);
    ArraySet(cursor_out, 0, i);
    let fn_name: String = ReadIdent(content, i, cursor_out);
    i = cursor_out[0];
    if StringLength(fn_name) == 0 {
        Exit(1);
    }
    // Optional generic parameter list: `func IDENT<T, U>(...)`. AST adds
    // a `    Generic params: <T, U>` line after `Function: NAME`.
    ArraySet(cursor_out, 0, i);
    let generic_params: String = ParseGenericParameterListText(
        content, i, cursor_out
    );
    i = cursor_out[0];
    i = Expect(content, i, "(");
    if i < 0 {
        Exit(1);
    }
    let param_lines: Array<String> = [];
    i = SkipWhitespaceAndComments(content, i);
    if ParserCharAt(content, i) != ")" {
        while true {
            i = SkipWhitespaceAndComments(content, i);
            let param_mode_prefix: String = "";
            if MatchLanguageWord(content, i, LanguageWordId.WordInout) {
                param_mode_prefix = "inout ";
                i = LanguageWordEnd(i, LanguageWordId.WordInout);
                i = SkipWhitespaceAndComments(content, i);
            } else if MatchLanguageWord(content, i, LanguageWordId.WordOwn) {
                param_mode_prefix = "own ";
                i = LanguageWordEnd(i, LanguageWordId.WordOwn);
                i = SkipWhitespaceAndComments(content, i);
            } else if MatchLanguageWord(content, i, LanguageWordId.WordRef) {
                param_mode_prefix = "ref ";
                i = LanguageWordEnd(i, LanguageWordId.WordRef);
                i = SkipWhitespaceAndComments(content, i);
            } else if ParserCharAt(content, i) == "&" {
                param_mode_prefix = "ref ";
                i = i + 1;
                i = SkipWhitespaceAndComments(content, i);
            }
            ArraySet(cursor_out, 0, i);
            let p_name: String = ReadIdent(content, i, cursor_out);
            i = cursor_out[0];
            if StringLength(p_name) == 0 {
                Exit(1);
            }
            // `self` parameter has no `: TYPE` annotation. Emit a bare
            // `self` row when the name is `self` and the next char is
            // not `:`.
            let after_pname: Int = SkipWhitespaceAndComments(content, i);
            if p_name == "self" && ParserCharAt(content, after_pname) != ":" {
                ArrayPush(param_lines, Concat(IndentStr(base_indent + 4), Concat(param_mode_prefix, "self")));
                i = after_pname;
                if ParserCharAt(content, i) == "," {
                    i = i + 1;
                    continue;
                }
                break;
            }
            i = Expect(content, i, ":");
            if i < 0 {
                Exit(1);
            }
            ArraySet(cursor_out, 0, i);
            let p_type: String = ReadType(content, i, cursor_out);
            i = cursor_out[0];
            if StringLength(p_type) == 0 {
                Exit(1);
            }
            ArrayPush(param_lines, Concat(IndentStr(base_indent + 4), Concat(param_mode_prefix, Concat(p_name, Concat(": ", p_type)))));
            i = SkipWhitespaceAndComments(content, i);
            if ParserCharAt(content, i) == "," {
                i = i + 1;
                continue;
            }
            break;
        }
    }
    i = Expect(content, i, ")");
    if i < 0 {
        Exit(1);
    }
    let signature_done: Bool = false;
    if is_signature {
        let sig_probe: Int = i;
        while ParserCharAt(content, sig_probe) == " " || ParserCharAt(content, sig_probe) == "\t" || ParserCharAt(content, sig_probe) == "\r" {
            sig_probe = sig_probe + 1;
        }
        if ParserCharAt(content, sig_probe) == "\n" || ParserCharAt(content, sig_probe) == ";" || ParserCharAt(content, sig_probe) == "}" {
            i = ConsumeStmtTerminator(content, i);
            if i < 0 {
                Exit(1);
            }
            signature_done = true;
        }
    }
    let ret_type: String = "";
    let req_type: String = "";
    let within_zone: String = within_zone_arg;
    let causes_effect: String = "";
    let auth_by: String = "";
    let constraint_clause: String = "";
    let cap_names: Array<String> = [];
    let effect_names: Array<String> = [];
    let saw_requires: Bool = false;
    let saw_within: Bool = StringLength(within_zone_arg) > 0;
    let saw_causes: Bool = false;
    let saw_authorized_by: Bool = false;
    let saw_caps: Bool = false;
    let saw_effects: Bool = false;
    let is_action: Bool = fn_keyword == "action";
    if !signature_done {
    i = SkipWhitespaceAndComments(content, i);
    if ParserCharAt(content, i) == "-" && ParserCharAt(content, i + 1) == ">" {
        i = i + 2;
        i = SkipWhitespaceAndComments(content, i);
        ArraySet(cursor_out, 0, i);
        ret_type = ReadType(content, i, cursor_out);
        i = cursor_out[0];
    }
    if is_signature {
        let ret_term_probe: Int = i;
        while ParserCharAt(content, ret_term_probe) == " " || ParserCharAt(content, ret_term_probe) == "\t" || ParserCharAt(content, ret_term_probe) == "\r" {
            ret_term_probe = ret_term_probe + 1;
        }
        if ParserCharAt(content, ret_term_probe) == "\n" || ParserCharAt(content, ret_term_probe) == ";" || ParserCharAt(content, ret_term_probe) == "}" {
            i = ConsumeStmtTerminator(content, i);
            if i < 0 {
                Exit(1);
            }
            signature_done = true;
        }
    }
    
    while true {
        i = SkipWhitespaceAndComments(content, i);
        if MatchLanguageWord(content, i, LanguageWordId.WordRequires) {
            if !is_action || saw_requires { Exit(1); }
            saw_requires = true;
            i = LanguageWordEnd(i, LanguageWordId.WordRequires);
            i = SkipWhitespaceAndComments(content, i);
            ArraySet(cursor_out, 0, i);
            req_type = ReadType(content, i, cursor_out);
            i = cursor_out[0];
            while true {
                i = SkipWhitespaceAndComments(content, i);
                if ParserCharAt(content, i) == "," {
                    i = i + 1;
                    i = SkipWhitespaceAndComments(content, i);
                    ArraySet(cursor_out, 0, i);
                    let next_req: String = ReadType(content, i, cursor_out);
                    i = cursor_out[0];
                    req_type = Concat(req_type, Concat(", ", next_req));
                    continue;
                }
                break;
            }
            continue;
        }
        if MatchLanguageWord(content, i, LanguageWordId.WordWithin) {
            if !is_action || saw_within { Exit(1); }
            saw_within = true;
            i = LanguageWordEnd(i, LanguageWordId.WordWithin);
            i = SkipWhitespaceAndComments(content, i);
            ArraySet(cursor_out, 0, i);
            within_zone = ReadIdent(content, i, cursor_out);
            i = cursor_out[0];
            continue;
        }
        if MatchLanguageWord(content, i, LanguageWordId.WordCauses) {
            if !is_action || saw_causes { Exit(1); }
            saw_causes = true;
            i = LanguageWordEnd(i, LanguageWordId.WordCauses);
            i = SkipWhitespaceAndComments(content, i);
            ArraySet(cursor_out, 0, i);
            causes_effect = ReadIdent(content, i, cursor_out);
            i = cursor_out[0];
            continue;
        }
        if MatchLanguageWord(content, i, LanguageWordId.WordAuthorized) {
            if !is_action || saw_authorized_by { Exit(1); }
            let next_i: Int = SkipWhitespaceAndComments(content, LanguageWordEnd(i, LanguageWordId.WordAuthorized));
            if MatchLanguageWord(content, next_i, LanguageWordId.WordBy) {
                saw_authorized_by = true;
                i = LanguageWordEnd(next_i, LanguageWordId.WordBy);
                i = SkipWhitespaceAndComments(content, i);
                ArraySet(cursor_out, 0, i);
                auth_by = ReadIdent(content, i, cursor_out);
                i = cursor_out[0];
                if StringLength(auth_by) == 0 { Exit(1); }
                while true {
                    i = SkipWhitespaceAndComments(content, i);
                    if ParserCharAt(content, i) == "," {
                        i = i + 1;
                        i = SkipWhitespaceAndComments(content, i);
                        ArraySet(cursor_out, 0, i);
                        let next_auth: String = ReadIdent(content, i, cursor_out);
                        i = cursor_out[0];
                        if StringLength(next_auth) == 0 { Exit(1); }
                        auth_by = Concat(auth_by, Concat(", ", next_auth));
                        continue;
                    }
                    break;
                }
                continue;
            }
        }
        if MatchLanguageWord(content, i, LanguageWordId.WordWith) {
            let next_i: Int = SkipWhitespaceAndComments(content, LanguageWordEnd(i, LanguageWordId.WordWith));
            if MatchLanguageWord(content, next_i, LanguageWordId.WordEffects) {
                if saw_effects { Exit(1); }
                saw_effects = true;
                i = LanguageWordEnd(next_i, LanguageWordId.WordEffects);
                while true {
                    i = SkipWhitespaceAndComments(content, i);
                    ArraySet(cursor_out, 0, i);
                    let effect_name: String = ReadIdent(content, i, cursor_out);
                    i = cursor_out[0];
                    if !ParserCallableContractAppendName(
                        effect_names, effect_name,
                        CallableContractVocabularyEffectAxis()
                    ) { Exit(1); }
                    i = SkipWhitespaceAndComments(content, i);
                    if ParserCharAt(content, i) == "," {
                        i = i + 1;
                        continue;
                    }
                    break;
                }
                continue;
            }
            if MatchLanguageWord(content, next_i, LanguageWordId.WordCaps) {
                if saw_caps { Exit(1); }
                saw_caps = true;
                i = LanguageWordEnd(next_i, LanguageWordId.WordCaps);
                while true {
                    i = SkipWhitespaceAndComments(content, i);
                    ArraySet(cursor_out, 0, i);
                    let cap_name: String = ReadIdent(content, i, cursor_out);
                    i = cursor_out[0];
                    if !ParserCallableContractAppendName(
                        cap_names, cap_name,
                        CallableContractVocabularyCapabilityAxis()
                    ) { Exit(1); }
                    i = SkipWhitespaceAndComments(content, i);
                    if ParserCharAt(content, i) == "," {
                        i = i + 1;
                        continue;
                    }
                    break;
                }
                continue;
            }
        }
        if MatchLanguageWord(content, i, LanguageWordId.WordWhere) {
            let where_start: Int = i;
            i = LanguageWordEnd(i, LanguageWordId.WordWhere);
            let n_content: Int = StringLength(content);
            while i < n_content && ParserCharAt(content, i) != "{" && ParserCharAt(content, i) != ";" {
                i = i + 1;
            }
            constraint_clause = StringTrim(Substring(content, where_start, i - where_start));
            continue;
        }
        break;
    }
    }
    let body_text: String = "";
    if is_signature {
        // Ability function signatures can end at `;` or a member-boundary
        // newline; both print as signature rows with no body.
        if !signature_done {
            i = ConsumeStmtTerminator(content, i);
            if i < 0 {
                Exit(1);
            }
        }
    } else {
        ArraySet(cursor_out, 0, i);
        body_text = ParseBlock(
            content, i, cursor_out, base_indent + 6, expression_graphs
        );
        i = cursor_out[0];
    }

    let header_prefix: String = IndentStr(base_indent);
    let label_text: String = fn_label;
    if StringLength(label_text) == 0 {
        label_text = "Function: ";
    }
    if is_export {
        label_text = Concat("[export] ", label_text);
    }
    let block: String = Concat(header_prefix, Concat(label_text, Concat(name_prefix, fn_name)));
    if StringLength(generic_params) > 0 {
        block = AppendLine(block, Concat(IndentStr(base_indent + 2), Concat("Generic params: ", generic_params)));
    }
    if StringLength(constraint_clause) > 0 {
        block = AppendLine(block, Concat(IndentStr(base_indent + 2), Concat("Constraints: ", constraint_clause)));
    }
    block = AppendLine(block, Concat(IndentStr(base_indent + 2), "Parameters:"));
    let p_len: Int = ArrayLength(param_lines);
    let pi: Int = 0;
    while pi < p_len {
        block = AppendLine(block, param_lines[pi]);
        pi = pi + 1;
    }
    if StringLength(ret_type) > 0 {
        block = AppendLine(block, Concat(IndentStr(base_indent + 2), Concat("Returns: ", ret_type)));
    }
    if StringLength(req_type) > 0 {
        block = AppendLine(block, Concat(IndentStr(base_indent + 2), Concat("Requires: ", req_type)));
    }
    if StringLength(within_zone) > 0 {
        block = AppendLine(block, Concat(IndentStr(base_indent + 2), Concat("Within: ", within_zone)));
    }
    if StringLength(causes_effect) > 0 {
        block = AppendLine(block, Concat(IndentStr(base_indent + 2), Concat("Causes: ", causes_effect)));
    }
    if StringLength(auth_by) > 0 {
        block = AppendLine(block, Concat(IndentStr(base_indent + 2), Concat("Authorized by: ", auth_by)));
    }
    if saw_caps {
        let caps: String = ParserCallableContractCanonicalCaps(cap_names);
        if StringLength(caps) == 0 { Exit(1); }
        block = AppendLine(block, Concat(
            IndentStr(base_indent + 2), Concat("Caps: ", caps)
        ));
    }
    if saw_effects {
        let effects: String = ParserCallableContractCanonicalEffects(
            effect_names
        );
        if StringLength(effects) == 0 { Exit(1); }
        block = AppendLine(block, Concat(
            IndentStr(base_indent + 2), Concat("Effects: ", effects)
        ));
    }
    if is_signature {
        ArraySet(cursor_out, 0, i);
        return block;
    }
    block = AppendLine(block, Concat(IndentStr(base_indent + 2), "Body:"));
    block = AppendLine(block, Concat(IndentStr(base_indent + 4), "Block:"));
    if StringLength(body_text) > 0 {
        block = AppendLine(block, body_text);
    }
    return block;
}
