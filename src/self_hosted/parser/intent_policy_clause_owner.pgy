// Intent declaration mode/priority and explicit default-rollback clause owner.
// A malformed or repeated clause is refused where it goes wrong.

import "cursor_owner.pgy";
import "expr_owner.pgy";
import "tree_text_owner.pgy";
import "source_refusal_owner.pgy";

struct ParserIntentPolicyClause {
    matched: Bool;
    next: Int;
    mode: String;
    priority_text: String;
    priority_expression: ParserExpressionFact;
    mode_explicit: Bool;
    rollback_explicit: Bool;
}

func ParserIntentPolicyClauseDefault() -> ParserIntentPolicyClause {
    return ParserIntentPolicyClause(
        false, 0, "exclusive", "", ParserExpressionInvalid(), false, false
    );
}

func ParserIntentPolicyClauseFromSource(
    context: ParserSourceLocationContext,
    content: String, start: Int, current: ParserIntentPolicyClause
) -> ParserIntentPolicyClause {
    if MatchLanguageWord(content, start, LanguageWordId.WordExclusive) ||
        MatchLanguageWord(content, start, LanguageWordId.WordConcurrent) {
        if current.mode_explicit {
            ParseRefuse(context, start, "declaration_clause_duplicate",
                "clause", "execution mode", "construct", "intent");
        }
        let mode: String = "exclusive";
        let word: LanguageWordId = LanguageWordId.WordExclusive;
        if MatchLanguageWord(
            content, start, LanguageWordId.WordConcurrent
        ) {
            mode = "concurrent";
            word = LanguageWordId.WordConcurrent;
        }
        let next: Int = ParseExpectIn(
            context, content, LanguageWordEnd(start, word), ";", "intent_mode");
        return ParserIntentPolicyClause(
            true, next, mode, current.priority_text,
            current.priority_expression, true, current.rollback_explicit
        );
    }
    if MatchLanguageWord(content, start, LanguageWordId.WordRollback) {
        if current.rollback_explicit {
            ParseRefuse(context, start, "declaration_clause_duplicate",
                "clause", "rollback policy", "construct", "intent");
        }
        let value_start: Int = ParseExpectIn(context, content,
            LanguageWordEnd(start, LanguageWordId.WordRollback), ":", "intent_rollback");
        value_start = SkipWhitespaceAndComments(content, value_start);
        // Only the existing full-rollback execution owner is substituted.
        // Native's other policies are refused as uncovered, never accepted
        // and erased to this default.
        if MatchLanguageWord(content, value_start, LanguageWordId.WordCurrent) {
            ParseRefuse(context, value_start, "surface_not_covered",
                "surface", "intent rollback current", "construct", "intent");
        }
        if MatchLanguageWord(content, value_start, LanguageWordId.WordNone) {
            ParseRefuse(context, value_start, "surface_not_covered",
                "surface", "intent rollback none", "construct", "intent");
        }
        if !MatchLanguageWord(content, value_start, LanguageWordId.WordFull) {
            ParseRefuse(context, value_start, "expected_token",
                "expected", "full, current or none", "construct", "intent_rollback");
        }
        let next: Int = ParseExpectIn(context, content,
            LanguageWordEnd(value_start, LanguageWordId.WordFull), ";", "intent_rollback");
        return ParserIntentPolicyClause(
            true, next, current.mode, current.priority_text,
            current.priority_expression, current.mode_explicit, true);
    }
    if !MatchLanguageWord(content, start, LanguageWordId.WordPriority) {
        return ParserIntentPolicyClause(
            false, start, current.mode, current.priority_text,
            current.priority_expression, current.mode_explicit, current.rollback_explicit
        );
    }
    if current.priority_text != "" {
        ParseRefuse(context, start, "declaration_clause_duplicate",
            "clause", "priority", "construct", "intent");
    }
    let expression_start: Int = ParseExpectIn(context, content,
        LanguageWordEnd(start, LanguageWordId.WordPriority), ":", "intent_priority");
    let cursor: Array<Int> = [expression_start];
    let expression: ParserExpressionFact = ParseExprFactIn(
        context, content, expression_start, cursor
    );
    let next: Int = ParseExpectIn(context, content, cursor[0], ";", "intent_priority");
    return ParserIntentPolicyClause(
        true, next, current.mode, expression.text, expression,
        current.mode_explicit, current.rollback_explicit
    );
}

func ParserIntentPolicyTreeAppend(
    out: String,
    inout expression_graphs: Array<AstExpressionGraphRows>,
    policy: ParserIntentPolicyClause
) -> String {
    let result: String = AppendLine(
        out, Concat("    IntentMode: ", policy.mode)
    );
    result = AppendLine(result, "    IntentRollback: full");
    if policy.priority_text != "" {
        result = AppendLine(
            result, Concat("    IntentPriority: ", policy.priority_text)
        );
        ParserExpressionGraphsAppendInto(
            expression_graphs, TypedAstKindIntentPriorityTag(),
            AstExpressionLaneAtom(), policy.priority_expression
        );
    }
    return result;
}
