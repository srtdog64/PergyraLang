// src/self_hosted/parser/main.pgy
//
// Status: rung-1 expanding (2026-06-18). Pergyra-origin parser substitute.
// Emits the same compact text tree that `pgy --ast` produces, byte-equal, for
// the committed parity fixture set. Current gate: 188 sources byte-equal on C
// and LLVM parser binaries; scale probe: 120 of 121 examples byte-equal
// (zero drift, zero self-host parser exits, 1 C-oracle skip).
//
// Contract: see intent.md in the same directory.

import "error_owner.pgy";
import "cursor_owner.pgy";
import "tree_text_owner.pgy";
import "type_name_owner.pgy";
import "expr_string_owner.pgy";
import "expr_primary_owner.pgy";
import "expr_precedence_owner.pgy";
import "stmt_if_owner.pgy";
import "stmt_parallel_owner.pgy";
import "stmt_match_owner.pgy";
import "stmt_owner.pgy";
import "function_decl_owner.pgy";
import "decl_type_owner.pgy";
import "decl_ability_owner.pgy";
import "decl_event_owner.pgy";
import "decl_enum_owner.pgy";
import "decl_zone_owner.pgy";
import "decl_effect_relation_owner.pgy";
import "decl_role_owner.pgy";
import "decl_intent_owner.pgy";
import "decl_nominal_owner.pgy";

import "decl_dispatch_owner.pgy";

func Main() -> Void with caps env, io_read {
    // Default source = examples/hello.pgy; parity harness passes argv[0].
    let run_args: Array<String> = Args();
    let source_path: String = "examples/hello.pgy";
    if ArrayLength(run_args) > 0 {
        source_path = run_args[0];
    }
    if !FileExists(source_path) {
        Exit(1);
    }
    let content: String = ReadFile(source_path);

    let cursor: Array<Int> = [0];
    let i: Int = SkipWhitespaceAndComments(content, 0);
    ArraySet(cursor, 0, i);
    // Compute source_dir as everything before the last `/` in
    // source_path so `import "X.pgy";` resolves relative to that.
    let src_dir: String = "";
    let last_slash: Int = -1;
    let sp_len: Int = StringLength(source_path);
    let sp_i: Int = 0;
    while sp_i < sp_len {
        if CharAt(source_path, sp_i) == "/" {
            last_slash = sp_i;
        }
        sp_i = sp_i + 1;
    }
    if last_slash >= 0 {
        src_dir = Substring(source_path, 0, last_slash);
    }
    let involve_types: Array<String> = [];
    let decls: String = ParseDecls(content, i, cursor, "", false, src_dir, false, "", involve_types);
    if StringLength(decls) == 0 {
        Log("Program:");
    } else {
        Log(Concat("Program:\n", decls));
    }
}
