// Status: rung-1 expanding (2026-06-18). Pergyra-origin parser substitute.
// Emits the same compact text tree that `pgy --ast` produces, byte-equal, for
// the committed parity fixture set. Current gate: 186 sources byte-equal on C
// and LLVM parser binaries; scale probe: 120 of 121 examples byte-equal
// (zero drift, zero self-host parser exits, 1 C-oracle skip).
//
// Contract: see intent.md in the same directory.

import "source_path_owner.pgy";
import "program_parse_owner.pgy";

func Main() -> Void with caps env, io_read {
    let run_args: Array<String> = Args();
    let source_path: String = ParserDefaultSourcePath(run_args);
    Log(ParseRootProgram(source_path));
}
