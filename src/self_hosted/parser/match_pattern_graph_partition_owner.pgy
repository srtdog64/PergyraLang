// Separates pattern syntax graphs from executable expression graphs.

import "expression_graph_owner.pgy";

func ParserExpressionGraphsSelectMatchCases(
    rows: AstExpressionGraphRows,
    select_match_cases: Bool
) -> AstExpressionGraphRows {
    let owner_kinds: Array<Int> = [];
    let lanes: Array<Int> = [];
    let roots: Array<Int> = [];
    let kinds: Array<Int> = [];
    let texts: Array<String> = [];
    let left_children: Array<Int> = [];
    let right_children: Array<Int> = [];
    if !AstExpressionGraphRowsReady(rows) {
        return AstExpressionGraphRows(
            false, owner_kinds, lanes, roots,
            AstExpressionArena(kinds, texts, left_children, right_children)
        );
    }
    let source_start: Int = 0;
    let row: Int = 0;
    let valid: Bool = true;
    while row < ArrayLength(rows.roots) && valid {
        let source_root: Int = rows.roots[row];
        if source_root < source_start ||
            source_root >= AstExpressionArenaNodeCount(rows.arena) {
            valid = false;
        } else if (rows.root_owner_kinds[row] ==
                TypedAstKindMatchCaseStmtTag()) == select_match_cases {
            let target_start: Int = ArrayLength(kinds);
            let node: Int = source_start;
            while node <= source_root && valid {
                let kind: Int = rows.arena.node_kinds[node];
                let arity: Int = AstExpressionNodeArity(kind);
                let left: Int = rows.arena.left_children[node];
                let right: Int = rows.arena.right_children[node];
                if arity >= 1 {
                    if left < source_start || left >= node {
                        valid = false;
                    } else {
                        left = target_start + left - source_start;
                    }
                }
                if arity >= 2 {
                    if right < source_start || right >= node {
                        valid = false;
                    } else {
                        right = target_start + right - source_start;
                    }
                }
                if valid {
                    ArrayPush(kinds, kind);
                    ArrayPush(texts, rows.arena.node_texts[node]);
                    ArrayPush(left_children, left);
                    ArrayPush(right_children, right);
                }
                node = node + 1;
            }
            if valid {
                ArrayPush(owner_kinds, rows.root_owner_kinds[row]);
                ArrayPush(lanes, rows.root_lanes[row]);
                ArrayPush(roots, ArrayLength(kinds) - 1);
            }
        }
        source_start = source_root + 1;
        row = row + 1;
    }
    let arena: AstExpressionArena = AstExpressionArena(
        kinds, texts, left_children, right_children
    );
    let selected: AstExpressionGraphRows = AstExpressionGraphRows(
        valid && source_start == AstExpressionArenaNodeCount(rows.arena),
        owner_kinds, lanes, roots, arena
    );
    return AstExpressionGraphRows(
        AstExpressionGraphRowsReady(selected), owner_kinds, lanes, roots, arena
    );
}
