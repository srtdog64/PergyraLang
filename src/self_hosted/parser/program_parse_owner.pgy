// Parser root Program owner.
//
// Owns root source reads, root cursor initialization, and compact AST Program
// assembly for the self-hosted parser entrypoint.

import "../lib/path.pgy";
import "../hir/ast_text_arena_projection_owner.pgy";
import "../hir/ast_expression_owner_kind_binding.pgy";
import "../hir/ast_destructure_graph_owner.pgy";
import "cursor_owner.pgy";
import "decl_dispatch_owner.pgy";
import "intent_parameter_resolution_owner.pgy";

struct ParserProgramBuild {
    tree_text: String;
    expression_graphs: AstExpressionGraphRows;
    declaration_module_paths: Array<String>;
    source_location_kinds: Array<Int>;
    source_location_paths: Array<String>;
    source_location_lines: Array<Int>;
    source_location_offsets: Array<Int>;
    source_location_callable_names: Array<String>;
}

func ParserProgramBuildSourceLocationRowsReady(
    build: ParserProgramBuild
) -> Bool {
    let count: Int = ArrayLength(build.source_location_kinds);
    if count == 0 || ArrayLength(build.source_location_paths) != count ||
        ArrayLength(build.source_location_lines) != count ||
        ArrayLength(build.source_location_offsets) != count ||
        ArrayLength(build.source_location_callable_names) != count {
        return false;
    }
    let row: Int = 0;
    while row < count {
        if !TypedAstKindKnown(build.source_location_kinds[row]) ||
            build.source_location_kinds[row] == TypedAstKindUnknownTag() ||
            build.source_location_paths[row] == "" ||
            build.source_location_lines[row] < 1 ||
            build.source_location_offsets[row] < 0 {
            return false;
        }
        row = row + 1;
    }
    return true;
}

func ParserProgramGraphFail(reason: String) -> Void {
    Log(Concat("PARSER GRAPH ERROR: ", reason));
    Exit(1);
}

func ParseProgramBuildContentWithImportPolicyObserved(
    source_path: String,
    content: String,
    follow_imports: Bool,
    observe_phases: Bool,
    admit_format_surfaces: Bool
) -> ParserProgramBuild {
    let cursor: Array<Int> = [0];
    let i: Int = SkipWhitespaceAndComments(content, 0);
    ArraySet(cursor, 0, i);

    let src_dir: String = SelfHostPath.Dirname(source_path);
    let involve_types: Array<String> = [];
    let import_paths: Set<String> = SetNew();
    SetAdd(import_paths, source_path);
    let expression_graphs: Array<AstExpressionGraphRows> = [];
    ParserExpressionGraphRowsBoxStart(
        expression_graphs, AstExpressionGraphRowsEmpty()
    );
    let declaration_module_paths: Array<String> = [];
    let source_locations: Array<ParserSourceLocationObservation> = [];
    if observe_phases { Log("Phase: declaration-composition:start"); }
    let decls: String = ParseDecls(
        content, i, cursor, "", false, src_dir, source_path, false,
        follow_imports, admit_format_surfaces, "", involve_types,
        import_paths, expression_graphs,
        source_locations, declaration_module_paths
    );
    if observe_phases { Log("Phase: declaration-composition:done"); }
    if !ParserIntentParameterResolutionContractReady() {
        ParserProgramGraphFail("intent parameter resolution contract drifted");
    }
    if observe_phases { Log("Phase: intent-resolution:start"); }
    let resolved_intents: ParserIntentParameterResolution =
        ParserIntentParameterRowsResolve(decls, involve_types);
    if !resolved_intents.ok {
        ParserProgramGraphFail(
            "intent parameter role resolution failed after import composition"
        );
    }
    decls = resolved_intents.tree_text;
    if observe_phases { Log("Phase: intent-resolution:done"); }
    let composed_rows: AstExpressionGraphRows = expression_graphs[0];
    if !ParserSourceLocationObservationsReady(source_locations) {
        ParserProgramGraphFail(
            "source-location observation rows are incomplete"
        );
    }
    let source_location_kinds: Array<Int> = [];
    let source_location_paths: Array<String> = [];
    let source_location_lines: Array<Int> = [];
    let source_location_offsets: Array<Int> = [];
    let source_location_callable_names: Array<String> = [];
    let source_location_row: Int = 0;
    while source_location_row < ArrayLength(source_locations) {
        let source_location: ParserSourceLocationObservation =
            source_locations[source_location_row];
        ArrayPush(source_location_kinds, source_location.kind);
        ArrayPush(source_location_paths, source_location.source_path);
        ArrayPush(source_location_lines, source_location.source_line);
        ArrayPush(source_location_offsets, source_location.source_offset);
        ArrayPush(
            source_location_callable_names, source_location.callable_name
        );
        source_location_row = source_location_row + 1;
    }
    if observe_phases { Log("Phase: expression-graph-admission:start"); }
    if !AstExpressionGraphRowsReady(composed_rows) {
        ParserProgramGraphFail(
            "import composition produced invalid expression graph rows"
        );
    }
    if observe_phases { Log("Phase: expression-graph-admission:done"); }
    if StringLength(decls) == 0 {
        let empty_program: String = "Program:";
        return ParserProgramBuild(
            Concat(empty_program, "\n"), composed_rows,
            declaration_module_paths, source_location_kinds,
            source_location_paths, source_location_lines,
            source_location_offsets, source_location_callable_names
        );
    }
    let program_text: String = Concat("Program:\n", decls);
    return ParserProgramBuild(
        Concat(program_text, "\n"), composed_rows,
        declaration_module_paths, source_location_kinds,
        source_location_paths, source_location_lines,
        source_location_offsets, source_location_callable_names
    );
}

func ParseProgramBuildWithImportPolicyObserved(
    source_path: String,
    follow_imports: Bool,
    observe_phases: Bool
) -> ParserProgramBuild {
    if !FileExists(source_path) { Exit(1); }
    if observe_phases { Log("Phase: source-read:start"); }
    let content: String = ReadFile(source_path);
    if observe_phases { Log("Phase: source-read:done"); }
    return ParseProgramBuildContentWithImportPolicyObserved(
        source_path, content, follow_imports, observe_phases, false
    );
}

func ParseProgramBuildContentWithImportPolicy(
    source_path: String,
    content: String,
    follow_imports: Bool
) -> ParserProgramBuild {
    return ParseProgramBuildContentWithImportPolicyObserved(
        source_path, content, follow_imports, false, false
    );
}

func ParseFormatProgramBuildContent(
    source_path: String,
    content: String
) -> ParserProgramBuild {
    return ParseProgramBuildContentWithImportPolicyObserved(
        source_path, content, false, false, true
    );
}

func ParseProgramBuildWithImportPolicy(
    source_path: String,
    follow_imports: Bool
) -> ParserProgramBuild {
    return ParseProgramBuildWithImportPolicyObserved(
        source_path, follow_imports, false
    );
}

func ParseRootProgramBuild(source_path: String) -> ParserProgramBuild {
    return ParseProgramBuildWithImportPolicy(source_path, true);
}

func ParseObservedRootProgramBuild(source_path: String) -> ParserProgramBuild {
    return ParseProgramBuildWithImportPolicyObserved(source_path, true, true);
}

func ParseRootProgram(source_path: String) -> String {
    return ParseRootProgramBuild(source_path).tree_text;
}

func ParserProgramArtifactFromBuild(
    build: ParserProgramBuild
) -> AstTreeArtifact {
    let artifact: AstTreeArtifact = AstTreeArtifactFromText(build.tree_text);
    let source_modules: AstSourceModuleFacts =
        AstSourceModuleFactsFromTopLevelPaths(
            artifact.arena, build.declaration_module_paths
        );
    let typed: AstTreeArtifact = AstTreeArtifact(
        artifact.tree_text, artifact.arena, artifact.count,
        build.expression_graphs, source_modules, AstTreeArtifactIdentityDigest(
            artifact.tree_text, artifact.count, build.expression_graphs,
            source_modules
        )
    );
    let owner_bound: AstTreeArtifact =
        AstTreeArtifactBindExpressionOwnerKinds(typed);
    return AstTreeArtifactBindDestructurePayloads(owner_bound);
}

func ParseRootProgramArtifact(source_path: String) -> AstTreeArtifact {
    return ParserProgramArtifactFromBuild(ParseRootProgramBuild(source_path));
}
