// Parser-produced source-location observations for executable AST nodes.
//
// These rows are captured while the parser cursor owns the source offset.
// They are not reconstructed from emitted AST text and they do not own
// parsing or semantic meaning. A later consumer must join kind/order against
// the admitted AstTreeArtifact and fail closed on any mismatch.
//
// The same context carries the file's display spelling and the requested
// diagnostic projection, so a parse refusal can name its file, line and
// column in the form the caller asked for without a second source scan.

import "../hir/ast_text_inventory_owner.pgy";
import "diagnostic_owner.pgy";

struct ParserSourceLocationContext {
    known: Bool;
    observe: Bool;
    source_path: String;
    display_path: String;
    source_length: Int;
    line_starts: Array<Int>;
    projection: ParseDiagnosticProjection;
}

struct ParserSourceLocationObservation {
    kind: Int;
    source_path: String;
    source_line: Int;
    source_column: Int;
    source_offset: Int;
    callable_name: String;
}

struct ParserSourcePoint {
    known: Bool;
    line: Int;
    column: Int;
}

func ParserSourceLocationContextUnknownProjected(
    projection: ParseDiagnosticProjection
) -> ParserSourceLocationContext {
    let no_starts: Array<Int> = [];
    return ParserSourceLocationContext(
        false, false, "", "", 0, no_starts, projection
    );
}

func ParserSourceLocationContextUnknown() -> ParserSourceLocationContext {
    return ParserSourceLocationContextUnknownProjected(ParseDiagnosticText);
}

func ParserSourceLocationContextFromSource(
    source_path: String,
    display_path: String,
    content: String,
    projection: ParseDiagnosticProjection
) -> ParserSourceLocationContext {
    let starts: Array<Int> = [0];
    let length: Int = StringLength(content);
    let i: Int = 0;
    while i < length {
        if CharCode(content, length, i) == 10 {
            ArrayPush(starts, i + 1);
        }
        i = i + 1;
    }
    return ParserSourceLocationContext(
        source_path != "", source_path != "", source_path, display_path,
        length, starts, projection
    );
}

// Positions stay known for refusals; only the observation rows stop. Method
// bodies parse under this view so their rows cannot shift the preorder join.
func ParserSourceLocationContextWithoutObservation(
    context: ParserSourceLocationContext
) -> ParserSourceLocationContext {
    return ParserSourceLocationContext(
        context.known, false, context.source_path, context.display_path,
        context.source_length, context.line_starts, context.projection
    );
}

func ParserSourcePointForOffset(
    context: ParserSourceLocationContext,
    offset: Int
) -> ParserSourcePoint {
    if !context.known || offset < 0 || offset > context.source_length ||
        ArrayLength(context.line_starts) == 0 {
        return ParserSourcePoint(false, 0, 0);
    }
    let low: Int = 0;
    let high: Int = ArrayLength(context.line_starts);
    while low + 1 < high {
        let middle: Int = low + ((high - low) / 2);
        if context.line_starts[middle] <= offset {
            low = middle;
        } else {
            high = middle;
        }
    }
    return ParserSourcePoint(
        true, low + 1, offset - context.line_starts[low] + 1
    );
}

func ParserSourceLocationReserve(
    context: ParserSourceLocationContext,
    source_offset: Int,
    inout observations: Array<ParserSourceLocationObservation>
) -> Int {
    if !context.observe {
        return 0 - 1;
    }
    let point: ParserSourcePoint = ParserSourcePointForOffset(
        context, source_offset
    );
    if !point.known {
        return 0 - 1;
    }
    let slot: Int = ArrayLength(observations);
    ArrayPush(
        observations,
        ParserSourceLocationObservation(
            TypedAstKindUnknownTag(), context.source_path,
            point.line, point.column, source_offset, ""
        )
    );
    return slot;
}

func ParserSourceLocationCommit(
    slot: Int,
    kind: Int,
    callable_name: String,
    inout observations: Array<ParserSourceLocationObservation>
) -> Void {
    if slot < 0 || slot >= ArrayLength(observations) ||
        !TypedAstKindKnown(kind) || kind == TypedAstKindUnknownTag() {
        return;
    }
    let prior: ParserSourceLocationObservation = observations[slot];
    ArraySet(
        observations,
        slot,
        ParserSourceLocationObservation(
            kind, prior.source_path, prior.source_line,
            prior.source_column, prior.source_offset, callable_name
        )
    );
}

func ParserObservedStatementFinish(
    tree_text: String,
    slot: Int,
    owner_kind: Int,
    inout observations: Array<ParserSourceLocationObservation>
) -> String {
    if slot < 0 {
        return tree_text;
    }
    let observed_kind: Int = owner_kind;
    if observed_kind == TypedAstKindUnknownTag() {
        let newline: Int = StringIndexOf(tree_text, "\n");
        let first_line: String = tree_text;
        if newline >= 0 {
            first_line = Substring(tree_text, 0, newline);
        }
        observed_kind = TypedAstTextKindOf(StringTrim(first_line));
    }
    ParserSourceLocationCommit(
        slot, observed_kind, "", observations
    );
    return tree_text;
}

// A top-level declaration other than a function records its start after its
// block is parsed; its members record no rows, so the row still precedes
// every later one in preorder. The block's first line names the kind, the
// same classification the arena uses; an unclassified block records none.
func ParserObservedDeclarationRow(
    context: ParserSourceLocationContext,
    start: Int,
    block_text: String,
    inout observations: Array<ParserSourceLocationObservation>
) -> String {
    let newline: Int = StringIndexOf(block_text, "\n");
    let first_line: String = block_text;
    if newline >= 0 { first_line = Substring(block_text, 0, newline); }
    let kind: Int = TypedAstTextKindOf(StringTrim(first_line));
    let point: ParserSourcePoint = ParserSourcePointForOffset(context, start);
    if !context.observe || !point.known || !TypedAstKindKnown(kind) ||
        kind == TypedAstKindUnknownTag() || kind == TypedAstKindFuncDeclTag() {
        return block_text;
    }
    ArrayPush(observations, ParserSourceLocationObservation(
        kind, context.source_path, point.line, point.column, start, ""));
    return block_text;
}

func ParserSourceLocationAppendSynthetic(
    kind: Int,
    source_path: String,
    source_line: Int,
    source_column: Int,
    source_offset: Int,
    callable_name: String,
    inout observations: Array<ParserSourceLocationObservation>
) -> Void {
    if !TypedAstKindKnown(kind) || kind == TypedAstKindUnknownTag() ||
        source_path == "" || source_line < 1 || source_column < 1 ||
        source_offset < 0 {
        return;
    }
    ArrayPush(
        observations,
        ParserSourceLocationObservation(
            kind, source_path, source_line, source_column, source_offset,
            callable_name
        )
    );
}

func ParserSourceLocationObservationsReady(
    observations: Array<ParserSourceLocationObservation>
) -> Bool {
    let i: Int = 0;
    while i < ArrayLength(observations) {
        let row: ParserSourceLocationObservation = observations[i];
        if !TypedAstKindKnown(row.kind) ||
            row.kind == TypedAstKindUnknownTag() ||
            row.source_path == "" || row.source_line < 1 ||
            row.source_column < 1 || row.source_offset < 0 {
            return false;
        }
        i = i + 1;
    }
    return true;
}
