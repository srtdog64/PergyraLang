// Parser source-path owner.
//
// This module owns the parser tool's source input path and imported-source
// marker. Shared path string facts live in SelfHostPath.

import "source_refusal_owner.pgy";

func ParserDefaultSourcePath(args: Array<String>) -> String {
    if ArrayLength(args) > 0 {
        return args[0];
    }
    return "examples/hello.pgy";
}

// A missing import is refused at the importing declaration's position.
func ParserReadImportedSource(
    context: ParserSourceLocationContext,
    import_offset: Int,
    import_path: String
) -> String {
    if !FileExists(import_path) {
        ParseRefuse(context, import_offset, "import_source_missing",
            "path", import_path, "", "");
    }
    return Concat(ReadFile(import_path), "\n// __imported__\n");
}

func ParserImportGraphSeen(paths: Set<String>, path: String) -> Bool {
    return SetHas(paths, path);
}

// `chain` is the import path from the entry file to the file being parsed.
// An import of a file on it is a cycle. A file seen on another branch is a
// shared import and is composed once.
func ParserImportChainHolds(chain: Array<String>, path: String) -> Bool {
    let i: Int = 0;
    while i < ArrayLength(chain) {
        if chain[i] == path { return true; }
        i = i + 1;
    }
    return false;
}
