// Self-host parser statement branch owner.

import "cursor_owner.pgy";

func ParseIfLetPayload(content: String, start: Int, inout cursor_out: Array<Int>) -> String {
    let i: Int = SkipWhitespaceAndComments(content, start);
    if ParserCharAt(content, i) == "(" {
        let pat_depth: Int = 1;
        i = i + 1;
        while i < StringLength(content) && pat_depth > 0 {
            if ParserCharAt(content, i) == "(" {
                pat_depth = pat_depth + 1;
            } else if ParserCharAt(content, i) == ")" {
                pat_depth = pat_depth - 1;
            }
            i = i + 1;
        }
        if pat_depth != 0 {
            Exit(1);
        }
        ArraySet(cursor_out, 0, i);
        return "<node:26>";
    }

    ArraySet(cursor_out, 0, i);
    let payload: String = ReadIdent(content, i, cursor_out);
    if StringLength(payload) == 0 {
        Exit(1);
    }
    return payload;
}

func ParseIfStmt(
    content: String,
    after_head: Int,
    inout cursor_out: Array<Int>,
    stmt_indent: Int,
    inout expression_graphs: Array<AstExpressionGraphRows>
) -> String {
    let i: Int = after_head;
    let if_probe: Int = SkipWhitespaceAndComments(content, i);
    if MatchKeyword(content, if_probe, "let") {
        i = if_probe + 3;
        i = SkipWhitespaceAndComments(content, i);
        ArraySet(cursor_out, 0, i);
        let variant_name: String = ReadIdent(content, i, cursor_out);
        i = cursor_out[0];
        if StringLength(variant_name) == 0 {
            Exit(1);
        }
        i = Expect(content, i, "(");
        if i < 0 {
            Exit(1);
        }
        i = SkipWhitespaceAndComments(content, i);
        ArraySet(cursor_out, 0, i);
        let case_payload: String = ParseIfLetPayload(content, i, cursor_out);
        i = cursor_out[0];
        i = Expect(content, i, ")");
        if i < 0 {
            Exit(1);
        }
        i = Expect(content, i, "=");
        if i < 0 {
            Exit(1);
        }
        ArraySet(cursor_out, 0, i);
        let match_expr: String = ParseExpr(content, i, cursor_out);
        i = cursor_out[0];
        let match_out: String = Concat(IndentStr(stmt_indent), Concat("Match: ", match_expr));
        match_out = AppendLine(match_out, Concat(IndentStr(stmt_indent + 2), Concat("Case: ", Concat(variant_name, Concat("(", Concat(case_payload, ")"))))));
        match_out = AppendLine(match_out, Concat(IndentStr(stmt_indent + 4), "Block:"));
        ArraySet(cursor_out, 0, i);
        let match_body: String = ParseBlock(
            content, i, cursor_out, stmt_indent + 6, expression_graphs
        );
        i = cursor_out[0];
        if StringLength(match_body) > 0 {
            match_out = AppendLine(match_out, match_body);
        }
        ArraySet(cursor_out, 0, i);
        return match_out;
    }
    ArraySet(cursor_out, 0, i);
    let condition: ParserExpressionFact = ParseExprFact(content, i, cursor_out);
    if !condition.ok { Exit(1); }
    ArraySet(
        expression_graphs, 0,
        ParserExpressionGraphsAppend(
            expression_graphs[0], TypedAstKindIfStmtTag(),
            AstExpressionLaneAtom(), condition
        )
    );
    let cond: String = condition.text;
    i = cursor_out[0];
    let out: String = Concat(IndentStr(stmt_indent), Concat("If: ", cond));
    out = Concat(out, Concat("\n", Concat(IndentStr(stmt_indent + 2), "Then:")));
    out = Concat(out, Concat("\n", Concat(IndentStr(stmt_indent + 4), "Block:")));
    ArraySet(cursor_out, 0, i);
    let then_body: String = ParseBlock(
        content, i, cursor_out, stmt_indent + 6, expression_graphs
    );
    i = cursor_out[0];
    if StringLength(then_body) > 0 {
        out = Concat(out, Concat("\n", then_body));
    }
    let saved_i: Int = i;
    let after_ws: Int = SkipWhitespaceAndComments(content, i);
    if MatchKeyword(content, after_ws, "else") {
        i = after_ws + 4;
        i = SkipWhitespaceAndComments(content, i);
        // `else if` chains: emit the nested `If:` directly under
        // `Else:` with no intermediate `Block:`. The nested If's
        // column equals the Block: column of a plain else
        // (`stmt_indent + 4`), so ParseOneStmt is invoked with that
        // as its stmt_indent.
        if MatchKeyword(content, i, "if") {
            out = Concat(out, Concat("\n", Concat(IndentStr(stmt_indent + 2), "Else:")));
            ArraySet(cursor_out, 0, i);
            let nested_if: String = ParseOneStmt(
                content, i, cursor_out, stmt_indent + 4, expression_graphs
            );
            i = cursor_out[0];
            if StringLength(nested_if) > 0 {
                out = Concat(out, Concat("\n", nested_if));
            }
        } else {
            out = Concat(out, Concat("\n", Concat(IndentStr(stmt_indent + 2), "Else:")));
            out = Concat(out, Concat("\n", Concat(IndentStr(stmt_indent + 4), "Block:")));
            ArraySet(cursor_out, 0, i);
            let else_body: String = ParseBlock(
                content, i, cursor_out, stmt_indent + 6, expression_graphs
            );
            i = cursor_out[0];
            if StringLength(else_body) > 0 {
                out = Concat(out, Concat("\n", else_body));
            }
        }
    } else {
        i = saved_i;
    }
    ArraySet(cursor_out, 0, i);
    return out;
}
