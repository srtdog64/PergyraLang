// Self-host parser loop statement branch owner.

import "cursor_owner.pgy";

func ParseWhileStmt(
    content: String,
    after_head: Int,
    inout cursor_out: Array<Int>,
    stmt_indent: Int,
    inout expression_graphs: Array<AstExpressionGraphRows>
) -> String {
    let i: Int = after_head;
    ArraySet(cursor_out, 0, i);
    let condition: ParserExpressionFact = ParseExprFact(content, i, cursor_out);
    if !condition.ok { Exit(1); }
    ArraySet(
        expression_graphs, 0,
        ParserExpressionGraphsAppend(
            expression_graphs[0], TypedAstKindWhileStmtTag(),
            AstExpressionLaneAtom(), condition
        )
    );
    let cond: String = condition.text;
    i = cursor_out[0];
    let out: String = Concat(IndentStr(stmt_indent), Concat("While: ", cond));
    out = Concat(out, Concat("\n", Concat(IndentStr(stmt_indent + 2), "Block:")));
    ArraySet(cursor_out, 0, i);
    let body: String = ParseBlock(
        content, i, cursor_out, stmt_indent + 4, expression_graphs
    );
    i = cursor_out[0];
    if StringLength(body) > 0 {
        out = Concat(out, Concat("\n", body));
    }
    ArraySet(cursor_out, 0, i);
    return out;
}

func ParseLoopStmt(
    content: String,
    after_head: Int,
    inout cursor_out: Array<Int>,
    stmt_indent: Int,
    inout expression_graphs: Array<AstExpressionGraphRows>
) -> String {
    let i: Int = after_head;
    let out: String = Concat(IndentStr(stmt_indent), "While: true");
    ArraySet(
        expression_graphs, 0,
        ParserExpressionGraphsAppend(
            expression_graphs[0], TypedAstKindWhileStmtTag(),
            AstExpressionLaneAtom(), ParserExpressionLeaf("true")
        )
    );
    out = Concat(out, Concat("\n", Concat(IndentStr(stmt_indent + 2), "Block:")));
    ArraySet(cursor_out, 0, i);
    let body: String = ParseBlock(
        content, i, cursor_out, stmt_indent + 4, expression_graphs
    );
    i = cursor_out[0];
    if StringLength(body) > 0 {
        out = Concat(out, Concat("\n", body));
    }
    ArraySet(cursor_out, 0, i);
    return out;
}

func ParseForStmt(
    content: String,
    after_head: Int,
    inout cursor_out: Array<Int>,
    stmt_indent: Int,
    inout expression_graphs: Array<AstExpressionGraphRows>
) -> String {
    // `for IDENT in EXPR..EXPR { ... }`. Range bounds use ParseExpr so `..`
    // terminates the lower bound and this owner consumes the upper explicitly.
    let i: Int = SkipWhitespaceAndComments(content, after_head);
    ArraySet(cursor_out, 0, i);
    let var_name: String = ReadIdent(content, i, cursor_out);
    i = cursor_out[0];
    if StringLength(var_name) == 0 {
        Exit(1);
    }
    i = SkipWhitespaceAndComments(content, i);
    if !MatchLanguageWord(content, i, LanguageWordId.WordIn) {
        Exit(1);
    }
    i = LanguageWordEnd(i, LanguageWordId.WordIn);
    ArraySet(cursor_out, 0, i);
    let lower_fact: ParserExpressionFact = ParseExprFact(
        content, i, cursor_out
    );
    if !lower_fact.ok { Exit(1); }
    let lower: String = lower_fact.text;
    ArraySet(
        expression_graphs, 0,
        ParserExpressionGraphsAppend(
            expression_graphs[0], TypedAstKindForStmtTag(),
            AstExpressionLaneValue(), lower_fact
        )
    );
    i = cursor_out[0];
    let range_text: String = "";
    let after_lower: Int = SkipWhitespaceAndComments(content, i);
    if ParserCharAt(content, after_lower) == "." && ParserCharAt(content, after_lower + 1) == "." {
        i = after_lower + 2;
        ArraySet(cursor_out, 0, i);
        let upper_fact: ParserExpressionFact = ParseExprFact(
            content, i, cursor_out
        );
        if !upper_fact.ok { Exit(1); }
        let upper: String = upper_fact.text;
        ArraySet(
            expression_graphs, 0,
            ParserExpressionGraphsAppend(
                expression_graphs[0], TypedAstKindForStmtTag(),
                AstExpressionLaneAuxiliary(), upper_fact
            )
        );
        i = cursor_out[0];
        range_text = Concat(lower, Concat("..", upper));
    } else {
        range_text = lower;
        i = after_lower;
    }
    let header: String = Concat("For: ", Concat(var_name, Concat(" in ", range_text)));
    let out: String = Concat(IndentStr(stmt_indent), header);
    out = Concat(out, Concat("\n", Concat(IndentStr(stmt_indent + 2), "Block:")));
    ArraySet(cursor_out, 0, i);
    let body: String = ParseBlock(
        content, i, cursor_out, stmt_indent + 4, expression_graphs
    );
    i = cursor_out[0];
    if StringLength(body) > 0 {
        out = Concat(out, Concat("\n", body));
    }
    ArraySet(cursor_out, 0, i);
    return out;
}
