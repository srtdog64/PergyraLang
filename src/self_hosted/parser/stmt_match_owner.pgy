// Self-host parser statement branch owner.

import "cursor_owner.pgy";
import "source_location_observation_owner.pgy";

func ParseMatchStmt(
    content: String,
    after_head: Int,
    inout cursor_out: Array<Int>,
    stmt_indent: Int,
    inout expression_graphs: Array<AstExpressionGraphRows>,
    location_context: ParserSourceLocationContext,
    inout source_locations: Array<ParserSourceLocationObservation>
) -> String {
    let i: Int = after_head;
    // `match EXPR { (case EXPR : STMT | default : STMT)* }`. Each
    // case/default body is a single statement (the C parser
    // currently rejects `{ ... }` brace bodies as object-literal
    // syntax that isn't implemented). AST shape:
    //   Match: <scrutinee>          (stmt_indent)
    //     Case: <label>              (+2)
    //       Block:                   (+4)
    //         <body stmt at +6>
    //     Default:                   (+2)
    //       Block:                   (+4)
    //         <body stmt at +6>
    ArraySet(cursor_out, 0, i);
    let scrutinee: ParserExpressionFact = ParseExprFact(
        content, i, cursor_out
    );
    if !scrutinee.ok { ParseExpressionRefuse(location_context, scrutinee, i, "statement"); }
    ParserExpressionGraphsAppendInto(
        expression_graphs, TypedAstKindMatchStmtTag(),
        AstExpressionLaneAtom(), scrutinee
    );
    let scrut: String = scrutinee.text;
    i = cursor_out[0];
    i = ParseExpectIn(location_context, content, i, "{", "statement");
    let out: String = Concat(IndentStr(stmt_indent), Concat("Match: ", scrut));
    let n_m: Int = StringLength(content);
    while true {
        i = SkipWhitespaceAndComments(content, i);
        if i >= n_m {
            ParseRefuse(location_context, i, "block_unclosed", "construct", "statement", "source_offset", ToString(i));
        }
        if ParserCharAt(content, i) == "}" {
            i = i + 1;
            break;
        }
        let case_label: String = "";
        if MatchLanguageWord(content, i, LanguageWordId.WordCase) {
            i = LanguageWordEnd(i, LanguageWordId.WordCase);
            i = SkipWhitespaceAndComments(content, i);
            ArraySet(cursor_out, 0, i);
            let case_pattern: ParserExpressionFact = ParseExprFact(
                content, i, cursor_out
            );
            if !case_pattern.ok { ParseExpressionRefuse(location_context, case_pattern, i, "statement"); }
            case_label = case_pattern.text;
            i = cursor_out[0];
            i = ParseExpectIn(location_context, content, i, ":", "statement");
            out = AppendLine(out, Concat(IndentStr(stmt_indent + 2), Concat("Case: ", case_label)));
        } else if MatchLanguageWord(content, i, LanguageWordId.WordDefault) {
            i = LanguageWordEnd(i, LanguageWordId.WordDefault);
            i = SkipWhitespaceAndComments(content, i);
            i = ParseExpectIn(location_context, content, i, ":", "statement");
            out = AppendLine(out, Concat(IndentStr(stmt_indent + 2), "Default:"));
        } else {
            ParseRefuse(location_context, i, "expected_token", "construct", "statement", "source_offset", ToString(i));
        }
        out = AppendLine(out, Concat(IndentStr(stmt_indent + 4), "Block:"));
        while true {
            i = SkipWhitespaceAndComments(content, i);
            if i >= n_m {
                ParseRefuse(location_context, i, "block_unclosed", "construct", "statement", "source_offset", ToString(i));
            }
            if ParserCharAt(content, i) == "}" || MatchLanguageWord(content, i, LanguageWordId.WordCase) || MatchLanguageWord(content, i, LanguageWordId.WordDefault) {
                break;
            }
            ArraySet(cursor_out, 0, i);
            let case_body: String = ParseOneStmtObserved(
                content, i, cursor_out, stmt_indent + 6, expression_graphs,
                location_context, source_locations
            );
            i = cursor_out[0];
            if StringLength(case_body) > 0 {
                out = AppendLine(out, case_body);
            }
        }
    }
    ArraySet(cursor_out, 0, i);
    return out;
}
