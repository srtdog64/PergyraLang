// Self-host parser statement and block owner.
//
// Statement parsing is a mutually recursive grammar cluster: branch owners
// need ParseBlock/ParseOneStmt, while this dispatch owner calls those branch
// owners. Native imports reject circular imports, so this file is the public
// statement boundary and imports branch participants as one cluster.

import "cursor_owner.pgy";
import "error_owner.pgy";
import "tree_text_owner.pgy";
import "type_name_owner.pgy";
import "expr_owner.pgy";
import "stmt_call_graph_owner.pgy";
import "stmt_collection_graph_owner.pgy";
import "stmt_destructure_owner.pgy";
import "stmt_if_owner.pgy";
import "stmt_loop_owner.pgy";
import "stmt_parallel_owner.pgy";
import "stmt_match_owner.pgy";
import "source_location_observation_owner.pgy";
// Parse one statement. Returns its formatted AST lines joined by "\n";
// empty string only if a parse error path was reached (which Exits anyway).
// Mutually recursive with ParseBlock for `if` and `while` bodies.
func ParseOneStmtCore(
    content: String,
    start: Int,
    inout cursor_out: Array<Int>,
    stmt_indent: Int,
    inout expression_graphs: Array<AstExpressionGraphRows>,
    location_context: ParserSourceLocationContext,
    inout source_locations: Array<ParserSourceLocationObservation>, inout owner_kind_out: Array<Int>
) -> String {
    let i: Int = SkipWhitespaceAndComments(content, start);
    let head_start: Int = i;
    ArraySet(cursor_out, 0, i);
    let head: String = ReadIdent(content, i, cursor_out);
    i = cursor_out[0];
    if StringLength(head) == 0 {
        Exit(1);
    }

    if head == "bind" {
        i = SkipWhitespaceAndComments(content, i);
        ArraySet(cursor_out, 0, i);
        let bind_lhs: String = ParseExpr(content, i, cursor_out);
        i = cursor_out[0];
        i = Expect(content, i, "=");
        if i < 0 {
            Exit(1);
        }
        ArraySet(cursor_out, 0, i);
        let bind_rhs: String = ParseExpr(content, i, cursor_out);
        i = cursor_out[0];
        i = ConsumeStmtTerminator(content, i);
        if i < 0 {
            Exit(1);
        }
        ArraySet(cursor_out, 0, i);
        return Concat(IndentStr(stmt_indent), Concat("BindStmt: ", Concat(bind_lhs, Concat(" = ", bind_rhs))));
    }

    if head == "if" {
        return ParseIfStmt(
            content, i, cursor_out, stmt_indent, expression_graphs,
            location_context, source_locations
        );
    }

    if head == "while" {
        return ParseWhileStmt(
            content, i, cursor_out, stmt_indent, expression_graphs,
            location_context, source_locations
        );
    }

    if head == "loop" {
        return ParseLoopStmt(
            content, i, cursor_out, stmt_indent, expression_graphs,
            location_context, source_locations
        );
    }

    if head == "with" {
        // `with slot<TYPE> as VAR { stmts }` — scoped slot binding.
        // AST:
        //   With slot<TYPE> as VAR
        //     Block:
        //       <body at stmt_indent + 4>
        i = SkipWhitespaceAndComments(content, i);
        if !MatchLanguageWord(content, i, LanguageWordId.WordSlot) {
            Exit(1);
        }
        i = LanguageWordEnd(i, LanguageWordId.WordSlot);
        i = SkipWhitespaceAndComments(content, i);
        if ParserCharAt(content, i) != "<" {
            Exit(1);
        }
        i = i + 1;
        ArraySet(cursor_out, 0, i);
        let with_type: String = ReadType(content, i, cursor_out);
        i = cursor_out[0];
        if ParserCharAt(content, i) != ">" {
            Exit(1);
        }
        i = i + 1;
        i = SkipWhitespaceAndComments(content, i);
        if !MatchLanguageWord(content, i, LanguageWordId.WordAs) {
            Exit(1);
        }
        i = LanguageWordEnd(i, LanguageWordId.WordAs);
        i = SkipWhitespaceAndComments(content, i);
        ArraySet(cursor_out, 0, i);
        let as_name: String = ReadIdent(content, i, cursor_out);
        i = cursor_out[0];
        if StringLength(as_name) == 0 {
            Exit(1);
        }
        ArraySet(cursor_out, 0, i);
        let with_body: String = ParseBlockObserved(
            content, i, cursor_out, stmt_indent + 4, expression_graphs,
            location_context, source_locations
        );
        i = cursor_out[0];
        let with_out: String = Concat(IndentStr(stmt_indent), Concat("With slot<", Concat(with_type, Concat("> as ", as_name))));
        with_out = Concat(with_out, Concat("\n", Concat(IndentStr(stmt_indent + 2), "Block:")));
        if StringLength(with_body) > 0 {
            with_out = Concat(with_out, Concat("\n", with_body));
        }
        ArraySet(cursor_out, 0, i);
        return with_out;
    }

    if head == "parallel" {
        return ParseParallelStmt(
            content, i, cursor_out, stmt_indent, expression_graphs,
            location_context, source_locations
        );
    }

    if head == "transaction" {
        // `transaction { ... }` owns top-level `compensate EXPR` handlers.
        // The C AST printer stores compensations on the transaction node but
        // does not print them; only non-compensate statements remain in body.
        i = Expect(content, i, "{");
        if i < 0 {
            Exit(1);
        }
        let tx_out: String = Concat(IndentStr(stmt_indent), "TransactionBlock:");
        tx_out = AppendLine(tx_out, Concat(IndentStr(stmt_indent + 2), "Block:"));
        let n_tx: Int = StringLength(content);
        while true {
            i = SkipWhitespaceAndComments(content, i);
            if i >= n_tx {
                Exit(1);
            }
            if ParserCharAt(content, i) == "}" {
                i = i + 1;
                break;
            }
            if MatchLanguageWord(content, i, LanguageWordId.WordCompensate) {
                i = LanguageWordEnd(i, LanguageWordId.WordCompensate);
                ArraySet(cursor_out, 0, i);
                let handler_expr: String = ParseExpr(content, i, cursor_out);
                i = cursor_out[0];
                handler_expr = handler_expr;
                i = ConsumeStmtTerminator(content, i);
                if i < 0 {
                    Exit(1);
                }
                continue;
            }
            ArraySet(cursor_out, 0, i);
            let tx_stmt: String = ParseOneStmtObserved(
                content, i, cursor_out, stmt_indent + 4, expression_graphs,
                location_context, source_locations
            );
            i = cursor_out[0];
            if StringLength(tx_stmt) > 0 {
                tx_out = AppendLine(tx_out, tx_stmt);
            }
        }
        ArraySet(cursor_out, 0, i);
        return tx_out;
    }

    if head == "defer" {
        // `defer { stmts } ;` — block with trailing semicolon. AST:
        //   Defer:
        //     Block:
        //       <body at stmt_indent + 4>
        i = SkipWhitespaceAndComments(content, i);
        let out: String = Concat(IndentStr(stmt_indent), "Defer:");
        out = Concat(out, Concat("\n", Concat(IndentStr(stmt_indent + 2), "Block:")));
        ArraySet(cursor_out, 0, i);
        let body: String = ParseBlockObserved(
            content, i, cursor_out, stmt_indent + 4, expression_graphs,
            location_context, source_locations
        );
        i = cursor_out[0];
        if StringLength(body) > 0 {
            out = Concat(out, Concat("\n", body));
        }
        i = ConsumeStmtTerminator(content, i);
        if i < 0 {
            Exit(1);
        }
        ArraySet(cursor_out, 0, i);
        return out;
    }

    if head == "break" {
        i = ConsumeStmtTerminator(content, i);
        if i < 0 {
            Exit(1);
        }
        ArraySet(cursor_out, 0, i);
        return Concat(IndentStr(stmt_indent), "Break");
    }

    if head == "continue" {
        i = ConsumeStmtTerminator(content, i);
        if i < 0 {
            Exit(1);
        }
        ArraySet(cursor_out, 0, i);
        return Concat(IndentStr(stmt_indent), "Continue");
    }

    if head == "fail" {
        // `fail` prints as a transaction rollback marker. A reason is present
        // only when it begins on the same source line.
        let fail_cursor: Int = i;
        let reason_start: Int = i;
        while ParserCharAt(content, reason_start) == " " || ParserCharAt(content, reason_start) == "\t" || ParserCharAt(content, reason_start) == "\r" {
            reason_start = reason_start + 1;
        }
        let fail_out: String = Concat(IndentStr(stmt_indent), "Fail:");
        if ParserCharAt(content, reason_start) == "\n" || ParserCharAt(content, reason_start) == ";" || ParserCharAt(content, reason_start) == "}" {
            i = ConsumeStmtTerminator(content, fail_cursor);
            if i < 0 {
                Exit(1);
            }
            ArraySet(cursor_out, 0, i);
            return AppendLine(fail_out, Concat(IndentStr(stmt_indent + 2), "(null)"));
        }
        ArraySet(cursor_out, 0, reason_start);
        let fail_reason: String = ParseExpr(content, reason_start, cursor_out);
        i = cursor_out[0];
        i = ConsumeStmtTerminator(content, i);
        if i < 0 {
            Exit(1);
        }
        ArraySet(cursor_out, 0, i);
        return AppendLine(fail_out, Concat(IndentStr(stmt_indent + 2), fail_reason));
    }

    if head == "match" {
        return ParseMatchStmt(
            content, i, cursor_out, stmt_indent, expression_graphs,
            location_context, source_locations
        );
    }

    if head == "for" {
        return ParseForStmt(
            content, i, cursor_out, stmt_indent, expression_graphs,
            location_context, source_locations
        );
    }

    if head == "return" {
        // `return ;`  or  `return EXPR ;`
        i = SkipWhitespaceAndComments(content, i);
        if ParserCharAt(content, i) == ";" {
            i = i + 1;
            ArraySet(cursor_out, 0, i);
            return Concat(IndentStr(stmt_indent), "Return");
        }
        ArraySet(cursor_out, 0, i);
        let value_fact: ParserExpressionFact = ParseExprFact(
            content, i, cursor_out
        );
        if !value_fact.ok { Exit(1); }
        ParserExpressionGraphsAppendInto(
            expression_graphs, TypedAstKindValueReturnStmtTag(),
            AstExpressionLaneAtom(), value_fact
        );
        let val_text: String = value_fact.text;
        i = cursor_out[0];
        i = ConsumeStmtTerminator(content, i);
        if i < 0 {
            Exit(1);
        }
        ArraySet(cursor_out, 0, i);
        return Concat(IndentStr(stmt_indent), Concat("Return: ", val_text));
    }

    if head == "let" {
        // `let IDENT (: TYPE)? = EXPR ;`. The `: TYPE` annotation is
        // optional; without it the AST emits `Let: IDENT = EXPR` (no
        // `:` segment), matching type-inferred bindings.
        i = SkipWhitespaceAndComments(content, i);
        if ParserCharAt(content, i) == "(" {
            return ParseDestructureLetStmt(
                content, i, cursor_out, stmt_indent, expression_graphs
            );
        }
        ArraySet(cursor_out, 0, i);
        if MatchLanguageWord(content, i, LanguageWordId.WordMut) {
            i = LanguageWordEnd(i, LanguageWordId.WordMut);
            i = SkipWhitespaceAndComments(content, i);
            ArraySet(cursor_out, 0, i);
        }
        let var_name: String = ReadIdent(content, i, cursor_out);
        i = cursor_out[0];
        if StringLength(var_name) == 0 {
            Exit(1);
        }
        i = SkipWhitespaceAndComments(content, i);
        let var_type: String = "";
        let has_type: Bool = false;
        if ParserCharAt(content, i) == ":" {
            i = i + 1;
            ArraySet(cursor_out, 0, i);
            var_type = ReadType(content, i, cursor_out);
            i = cursor_out[0];
            if StringLength(var_type) == 0 {
                Exit(1);
            }
            has_type = true;
        }
        i = Expect(content, i, "=");
        if i < 0 {
            Exit(1);
        }
        ArraySet(cursor_out, 0, i);
        let value_fact: ParserExpressionFact = ParseExprFact(
            content, i, cursor_out
        );
        if !value_fact.ok { Exit(1); }
        ParserExpressionGraphsAppendInto(
            expression_graphs, TypedAstKindLetStmtTag(),
            AstExpressionLaneValue(), value_fact
        );
        let val_text: String = value_fact.text;
        i = cursor_out[0];
        i = ConsumeStmtTerminator(content, i);
        if i < 0 {
            Exit(1);
        }
        ArraySet(cursor_out, 0, i);
        let let_text: String = "";
        if has_type {
            let_text = Concat("Let: ", Concat(var_name, Concat(" : ", Concat(var_type, Concat(" = ", val_text)))));
        } else {
            let_text = Concat("Let: ", Concat(var_name, Concat(" = ", val_text)));
        }
        return Concat(IndentStr(stmt_indent), let_text);
    }

    // Rewind to head's start and parse a primary as the assignment LHS
    // candidate. ParsePrimary handles postfix `.member`, `[idx]`, and
    // `(args)` chains, so `p.x = 5;` and `arr[0] = 5;` are LHS shapes
    // alongside the simple `x = 5;`. If `=` (not `==`) doesn't follow
    // the primary, this is an expression statement — rewind once more
    // and parse a full expression (so `a + b;` and `obj.Greet();` both
    // work).
    ArraySet(cursor_out, 0, head_start);
    let lhs_fact: ParserExpressionFact = ParsePrimaryFact(
        content, head_start, cursor_out
    );
    if !lhs_fact.ok { Exit(1); }
    let lhs: String = lhs_fact.text;
    let i_after_lhs: Int = cursor_out[0];
    let peek: Int = SkipWhitespaceAndComments(content, i_after_lhs);
    // Event subscription: `LHS += RHS ;` emits
    //   EventSubscribe: LHS += RHS
    // at the statement indent. The C parser uses this shape for
    // `event += handler` registration; non-event `+=` is a parse error
    // upstream so we don't need to reject misuse here.
    if ParserCharAt(content, peek) == "+" && ParserCharAt(content, peek + 1) == "=" {
        i = peek + 2;
        ArraySet(cursor_out, 0, i);
        let rhs: String = ParseExpr(content, i, cursor_out);
        i = cursor_out[0];
        i = ConsumeStmtTerminator(content, i);
        if i < 0 {
            Exit(1);
        }
        ArraySet(cursor_out, 0, i);
        let sub_text: String = Concat("EventSubscribe: ", Concat(lhs, Concat(" += ", rhs)));
        return Concat(IndentStr(stmt_indent), sub_text);
    }
    // Event unsubscription: `LHS -= RHS ;` emits
    //   EventUnsubscribe: LHS -= RHS
    if ParserCharAt(content, peek) == "-" && ParserCharAt(content, peek + 1) == "=" {
        i = peek + 2;
        ArraySet(cursor_out, 0, i);
        let unsub_rhs: String = ParseExpr(content, i, cursor_out);
        i = cursor_out[0];
        i = ConsumeStmtTerminator(content, i);
        if i < 0 {
            Exit(1);
        }
        ArraySet(cursor_out, 0, i);
        let unsub_text: String = Concat("EventUnsubscribe: ", Concat(lhs, Concat(" -= ", unsub_rhs)));
        return Concat(IndentStr(stmt_indent), unsub_text);
    }
    // Channel send statement: `LHS <- RHS ;` emits
    //   ChannelSend: LHS <- RHS
    // at the statement indent.
    if ParserCharAt(content, peek) == "<" && ParserCharAt(content, peek + 1) == "-" {
        i = peek + 2;
        ArraySet(cursor_out, 0, i);
        let send_rhs: String = ParseExpr(content, i, cursor_out);
        i = cursor_out[0];
        i = ConsumeStmtTerminator(content, i);
        if i < 0 {
            Exit(1);
        }
        ArraySet(cursor_out, 0, i);
        let send_text: String = Concat("ChannelSend: ", Concat(lhs, Concat(" <- ", send_rhs)));
        return Concat(IndentStr(stmt_indent), send_text);
    }
    if ParserCharAt(content, peek) == "=" && ParserCharAt(content, peek + 1) != "=" {
        i = peek + 1;
        ArraySet(cursor_out, 0, i);
        let rhs_fact: ParserExpressionFact = ParseExprFact(
            content, i, cursor_out
        );
        if !rhs_fact.ok { Exit(1); }
        ParserExpressionGraphsAppendInto(
            expression_graphs, TypedAstKindAssignStmtTag(),
            AstExpressionLaneAtom(), lhs_fact
        );
        ParserExpressionGraphsAppendInto(
            expression_graphs, TypedAstKindAssignStmtTag(),
            AstExpressionLaneValue(), rhs_fact
        );
        let rhs: String = rhs_fact.text;
        i = cursor_out[0];
        i = ConsumeStmtTerminator(content, i);
        if i < 0 {
            Exit(1);
        }
        ArraySet(cursor_out, 0, i);
        let assign_text: String = Concat("Assign: ", Concat(lhs, Concat(" = ", rhs)));
        return Concat(IndentStr(stmt_indent), assign_text);
    }

    // Expression statement fallback.
    ArraySet(cursor_out, 0, head_start);
    let expr_fact: ParserExpressionFact = ParseExprFact(
        content, head_start, cursor_out
    );
    if !expr_fact.ok { Exit(1); }
    let owner_kind: Int = ParserExpressionCallStatementKind(expr_fact);
    ArraySet(owner_kind_out, 0, owner_kind);
    if owner_kind != TypedAstKindUnknownTag() {
        if owner_kind == TypedAstKindLogStmtTag() {
            let log_argument: ParserExpressionFact =
                ParserExpressionNamedSingleCallArgument(expr_fact, "Log");
            if log_argument.ok {
                ParserExpressionGraphsAppendInto(
                    expression_graphs, owner_kind,
                    AstExpressionLaneAtom(), log_argument
                );
            }
        } else if owner_kind == TypedAstKindExitStmtTag() {
            let exit_argument: ParserExpressionFact =
                ParserExpressionNamedSingleCallArgument(expr_fact, "Exit");
            if !exit_argument.ok { Exit(1); }
            ParserExpressionGraphsAppendInto(
                expression_graphs, owner_kind,
                AstExpressionLaneAtom(), exit_argument
            );
        } else if owner_kind == TypedAstKindArrayPopStmtTag() ||
            owner_kind == TypedAstKindArrayPushStmtTag() ||
            owner_kind == TypedAstKindArraySetStmtTag() {
            ArraySet(
                expression_graphs, 0,
                ParserCollectionStatementGraphsAppend(
                    expression_graphs[0], owner_kind, expr_fact
                )
            );
        } else if owner_kind == TypedAstKindBareCallStmtTag() {
            ParserExpressionGraphsAppendInto(
                expression_graphs, owner_kind,
                AstExpressionLaneAtom(), expr_fact
            );
        }
    }
    let expr_text: String = expr_fact.text;
    i = cursor_out[0];
    i = ConsumeStmtTerminator(content, i);
    if i < 0 {
        Fail("Semicolon missing in expression statement", content, cursor_out[0]);
    }
    ArraySet(cursor_out, 0, i);
    return Concat(IndentStr(stmt_indent), expr_text);
}

// Parse a `{ stmt* }` block. Returns formatted lines joined by "\n".
// stmt_indent is the column at which each child statement's first line
// starts; nested blocks (if/while) compute their own deeper indents.
func ParseOneStmtObserved(
    content: String,
    start: Int,
    inout cursor_out: Array<Int>,
    stmt_indent: Int,
    inout expression_graphs: Array<AstExpressionGraphRows>,
    location_context: ParserSourceLocationContext,
    inout source_locations: Array<ParserSourceLocationObservation>
) -> String {
    let observed_start: Int = SkipWhitespaceAndComments(content, start);
    let slot: Int = ParserSourceLocationReserve(
        location_context, observed_start, source_locations
    );
    let owner_kind: Array<Int> = [TypedAstKindUnknownTag()];
    let tree_text: String = ParseOneStmtCore(
        content, start, cursor_out, stmt_indent, expression_graphs,
        location_context, source_locations, owner_kind
    );
    return ParserObservedStatementFinish(tree_text, slot, owner_kind[0], source_locations);
}
func ParseOneStmt(
    content: String,
    start: Int,
    inout cursor_out: Array<Int>,
    stmt_indent: Int,
    inout expression_graphs: Array<AstExpressionGraphRows>
) -> String {
    let context: ParserSourceLocationContext = ParserSourceLocationContextUnknown();
    let locations: Array<ParserSourceLocationObservation> = [];
    return ParseOneStmtObserved(content, start, cursor_out, stmt_indent,
        expression_graphs, context, locations);
}

func ParseBlockObserved(
    content: String,
    start: Int,
    inout cursor_out: Array<Int>,
    stmt_indent: Int,
    inout expression_graphs: Array<AstExpressionGraphRows>,
    location_context: ParserSourceLocationContext,
    inout source_locations: Array<ParserSourceLocationObservation>
) -> String {
    let block_start: Int = SkipWhitespaceAndComments(content, start);
    let block_slot: Int = ParserSourceLocationReserve(
        location_context, block_start, source_locations
    );
    ParserSourceLocationCommit(
        block_slot, TypedAstKindBlockTag(), "", source_locations
    );
    let i: Int = Expect(content, start, "{");
    if i < 0 {
        Exit(1);
    }
    let n: Int = StringLength(content);
    let out: String = "";
    while true {
        i = SkipWhitespaceAndComments(content, i);
        if i >= n {
            Exit(1);
        }
        if ParserCharAt(content, i) == "}" {
            i = i + 1;
            ArraySet(cursor_out, 0, i);
            return out;
        }
        ArraySet(cursor_out, 0, i);
        let stmt: String = ParseOneStmtObserved(
            content, i, cursor_out, stmt_indent, expression_graphs,
            location_context, source_locations
        );
        i = cursor_out[0];
        if StringLength(out) == 0 {
            out = stmt;
        } else {
            out = Concat(out, Concat("\n", stmt));
        }
    }
    return out;
}

func ParseBlock(
    content: String,
    start: Int,
    inout cursor_out: Array<Int>,
    stmt_indent: Int,
    inout expression_graphs: Array<AstExpressionGraphRows>
) -> String {
    let context: ParserSourceLocationContext =
        ParserSourceLocationContextUnknown();
    let locations: Array<ParserSourceLocationObservation> = [];
    return ParseBlockObserved(
        content, start, cursor_out, stmt_indent, expression_graphs,
        context, locations
    );
}
