// Self-host parser compact AST text formatting owner.

// Produce a string of `n` ASCII spaces, used to indent AST output.
func IndentStr(n: Int) -> String {
    let s: String = "";
    let k: Int = 0;
    while k < n {
        s = Concat(s, " ");
        k = k + 1;
    }
    return s;
}

// Append a line to a string accumulator, inserting `\n` between
// existing content and the new line. The decl-emission code uses this
// shape pervasively; pulling it into a helper keeps the per-decl
// branches readable.
func AppendLine(acc: String, line: String) -> String {
    if StringLength(acc) == 0 {
        return line;
    }
    return Concat(acc, Concat("\n", line));
}

func AppendImplicitMain(decls: String, body: String) -> String {
    if StringLength(body) == 0 {
        return decls;
    }
    let main_block: String = "  Function: Main";
    main_block = AppendLine(main_block, "    Parameters:");
    main_block = AppendLine(main_block, "    Returns: Void");
    main_block = AppendLine(main_block, "    Body:");
    main_block = AppendLine(main_block, "      Block:");
    main_block = AppendLine(main_block, body);
    return AppendLine(decls, main_block);
}
