// src/self_hosted/sea/execution_lane.pgy
//
// SEA ExecutionLane classifier — the self-host (Pergyra) mirror of the C policy
// in src/compiler/execution_lane.c. This is the self-host side of the async
// wiring (docs/146): the compiler decides which runtime lane a task's evidence
// permits, and the self-host compiler must be able to make the SAME decision.
//
// Idiomatic Pergyra, not C-shaped: the lane is a typed `enum` value returned
// directly, never an out-of-band integer; "not found / rejected" is the
// first-class `Reject` variant, never a -1 sentinel. The ordering of the rules
// is the contract, identical to the C policy (pin -> effect -> movability).

enum ExecutionLane {
    Reject,
    Inline,
    PinnedZone,
    BlockingPool,
    LocalAsync,
    WorkerPool,
    MovableScheduler
}

enum BoundaryKind {
    BoundaryKindUnknown,
    BoundaryKindZone,
    BoundaryKindWorld,
    BoundaryKindIO,
    BoundaryKindParallel,
    BoundaryKindChannel,
    BoundaryKindExecution
}

struct BoundaryCaptureFact {
    let captures_pin: Bool;
    let captures_live_view: Bool;
    let captures_raw_slot: Bool;
    let captures_raw_channel: Bool;
    let captures_value_only: Bool;
    let crosses_authority_boundary: Bool;
    let requires_movability: Bool;
    let has_io_or_ffi_effect: Bool;
    let is_await_heavy_local: Bool;
    let is_deterministic_fork_join: Bool;
    let is_concurrent_site: Bool;
}

struct BoundaryLaneInputFact {
    let kind: BoundaryKind;
    let authority_required: Bool;
    let authority_count: Int;
    let has_rir_await_local_evidence: Bool;
    let has_rir_movability_requirement_evidence: Bool;
    let has_rir_deterministic_fork_join_evidence: Bool;
    let has_rir_raw_channel_capture_evidence: Bool;
    let has_rir_raw_slot_capture_evidence: Bool;
    let has_rir_live_view_capture_evidence: Bool;
    let has_mir_pin_cleanup_evidence: Bool;
    let has_mir_value_capture_evidence: Bool;
    let has_rir_zone_pin_evidence: Bool;
}

func ClassifyLane(fact: BoundaryCaptureFact) -> ExecutionLane {
    if !fact.is_concurrent_site {
        return ExecutionLane.Inline;
    }
    if fact.captures_pin || fact.captures_live_view || fact.captures_raw_slot || fact.captures_raw_channel {
        if fact.requires_movability {
            return ExecutionLane.Reject;
        }
        return ExecutionLane.PinnedZone;
    }
    if fact.has_io_or_ffi_effect {
        return ExecutionLane.BlockingPool;
    }
    if fact.is_await_heavy_local {
        return ExecutionLane.LocalAsync;
    }
    if fact.is_deterministic_fork_join {
        return ExecutionLane.WorkerPool;
    }
    if fact.captures_value_only && fact.crosses_authority_boundary {
        return ExecutionLane.MovableScheduler;
    }
    if fact.captures_value_only {
        return ExecutionLane.WorkerPool;
    }
    return ExecutionLane.LocalAsync;
}

func LaneName(lane: ExecutionLane) -> String {
    match lane {
        case Reject: return "Reject";
        case Inline: return "Inline";
        case PinnedZone: return "PinnedZone";
        case BlockingPool: return "BlockingPool";
        case LocalAsync: return "LocalAsync";
        case WorkerPool: return "WorkerPool";
        case MovableScheduler: return "MovableScheduler";
    }
}

func CaptureFactFromBoundaryFact(fact: BoundaryLaneInputFact) -> BoundaryCaptureFact {
    let crosses_authority: Bool = fact.authority_required && fact.authority_count > 0;
    match fact.kind {
        case BoundaryKindZone:
            return BoundaryCaptureFact(fact.has_rir_zone_pin_evidence, fact.has_rir_live_view_capture_evidence, fact.has_rir_raw_slot_capture_evidence, false, fact.has_mir_value_capture_evidence, crosses_authority, false, false, false, false, true);
        case BoundaryKindChannel:
            return BoundaryCaptureFact(false, fact.has_rir_live_view_capture_evidence, fact.has_rir_raw_slot_capture_evidence, fact.has_rir_raw_channel_capture_evidence, fact.has_mir_value_capture_evidence, crosses_authority, false, false, false, false, true);
        case BoundaryKindIO:
            return BoundaryCaptureFact(false, fact.has_rir_live_view_capture_evidence, fact.has_rir_raw_slot_capture_evidence, false, fact.has_mir_value_capture_evidence, crosses_authority, false, true, false, false, true);
        case BoundaryKindParallel:
            return BoundaryCaptureFact(false, fact.has_rir_live_view_capture_evidence, fact.has_rir_raw_slot_capture_evidence, false, fact.has_mir_value_capture_evidence, crosses_authority, fact.has_rir_movability_requirement_evidence, false, fact.has_rir_await_local_evidence, fact.has_rir_deterministic_fork_join_evidence, true);
        case BoundaryKindWorld:
            return BoundaryCaptureFact(false, fact.has_rir_live_view_capture_evidence, fact.has_rir_raw_slot_capture_evidence, false, fact.has_mir_value_capture_evidence, crosses_authority, false, false, false, false, true);
        case BoundaryKindExecution:
            if fact.has_mir_pin_cleanup_evidence {
                return BoundaryCaptureFact(true, fact.has_rir_live_view_capture_evidence, fact.has_rir_raw_slot_capture_evidence, false, fact.has_mir_value_capture_evidence, crosses_authority, false, false, false, false, true);
            }
            return BoundaryCaptureFact(false, fact.has_rir_live_view_capture_evidence, fact.has_rir_raw_slot_capture_evidence, false, fact.has_mir_value_capture_evidence, crosses_authority, false, false, false, false, true);
        case BoundaryKindUnknown:
            return BoundaryCaptureFact(false, false, false, false, false, crosses_authority, false, false, false, false, false);
    }
}

func LaneFromBoundaryFact(fact: BoundaryLaneInputFact) -> ExecutionLane {
    return ClassifyLane(CaptureFactFromBoundaryFact(fact));
}

// The 10 decision-table cases, in the same order as the C proof
// (src/tests/execution_lane_policy_test.c), so the two policies can be diffed.
func Main() -> Void {
    Log(LaneName(ClassifyLane(BoundaryCaptureFact(false, false, false, false, false, false, false, false, false, false, false))));
    Log(LaneName(ClassifyLane(BoundaryCaptureFact(true,  false, false, false, false, false, false, false, false, false, true))));
    Log(LaneName(ClassifyLane(BoundaryCaptureFact(false, false, true,  false, false, false, false, false, false, false, true))));
    Log(LaneName(ClassifyLane(BoundaryCaptureFact(true,  false, false, false, false, false, true,  false, false, false, true))));
    Log(LaneName(ClassifyLane(BoundaryCaptureFact(false, false, false, false, true,  true,  false, true,  false, false, true))));
    Log(LaneName(ClassifyLane(BoundaryCaptureFact(false, false, false, false, false, false, false, false, true,  false, true))));
    Log(LaneName(ClassifyLane(BoundaryCaptureFact(false, false, false, false, true,  true,  false, false, false, true,  true))));
    Log(LaneName(ClassifyLane(BoundaryCaptureFact(false, false, false, false, true,  true,  false, false, false, false, true))));
    Log(LaneName(ClassifyLane(BoundaryCaptureFact(false, false, false, false, true,  false, false, false, false, false, true))));
    Log(LaneName(ClassifyLane(BoundaryCaptureFact(false, false, false, false, false, false, false, false, false, false, true))));
    Log(LaneName(LaneFromBoundaryFact(BoundaryLaneInputFact(BoundaryKind.BoundaryKindParallel, false, 0, false, false, true, false, false, false, false, false, false))));
    Log(LaneName(LaneFromBoundaryFact(BoundaryLaneInputFact(BoundaryKind.BoundaryKindParallel, false, 0, false, false, true, false, false, false, false, false, false))));
    Log(LaneName(LaneFromBoundaryFact(BoundaryLaneInputFact(BoundaryKind.BoundaryKindParallel, false, 0, false, false, false, false, false, false, false, false, false))));
    Log(LaneName(LaneFromBoundaryFact(BoundaryLaneInputFact(BoundaryKind.BoundaryKindParallel, false, 0, false, false, false, false, false, false, false, false, false))));
    Log(LaneName(LaneFromBoundaryFact(BoundaryLaneInputFact(BoundaryKind.BoundaryKindParallel, false, 0, true, false, false, false, false, false, false, false, false))));
    Log(LaneName(LaneFromBoundaryFact(BoundaryLaneInputFact(BoundaryKind.BoundaryKindParallel, false, 0, true, false, false, false, false, false, false, false, false))));
    Log(LaneName(LaneFromBoundaryFact(BoundaryLaneInputFact(BoundaryKind.BoundaryKindParallel, false, 0, false, true, false, false, false, false, false, false, false))));
    Log(LaneName(LaneFromBoundaryFact(BoundaryLaneInputFact(BoundaryKind.BoundaryKindParallel, false, 0, false, true, false, false, true, false, false, false, false))));
    Log(LaneName(LaneFromBoundaryFact(BoundaryLaneInputFact(BoundaryKind.BoundaryKindParallel, true, 1, false, true, false, false, false, false, false, true, false))));
    Log(LaneName(LaneFromBoundaryFact(BoundaryLaneInputFact(BoundaryKind.BoundaryKindParallel, false, 0, false, false, true, false, true, false, false, false, false))));
    Log(LaneName(LaneFromBoundaryFact(BoundaryLaneInputFact(BoundaryKind.BoundaryKindParallel, false, 0, false, false, false, false, false, false, false, true, false))));
    Log(LaneName(LaneFromBoundaryFact(BoundaryLaneInputFact(BoundaryKind.BoundaryKindParallel, false, 0, true, false, false, false, false, true, false, false, false))));
    Log(LaneName(LaneFromBoundaryFact(BoundaryLaneInputFact(BoundaryKind.BoundaryKindParallel, false, 0, false, false, false, false, false, false, false, false, false))));
    Log(LaneName(LaneFromBoundaryFact(BoundaryLaneInputFact(BoundaryKind.BoundaryKindZone, false, 0, false, false, false, false, false, false, false, false, false))));
    Log(LaneName(LaneFromBoundaryFact(BoundaryLaneInputFact(BoundaryKind.BoundaryKindZone, false, 0, false, false, false, false, false, false, false, false, true))));
    Log(LaneName(LaneFromBoundaryFact(BoundaryLaneInputFact(BoundaryKind.BoundaryKindChannel, false, 0, false, false, false, true, false, false, false, false, false))));
    Log(LaneName(LaneFromBoundaryFact(BoundaryLaneInputFact(BoundaryKind.BoundaryKindChannel, false, 0, false, false, false, false, false, false, false, false, false))));
    Log(LaneName(LaneFromBoundaryFact(BoundaryLaneInputFact(BoundaryKind.BoundaryKindExecution, false, 0, false, false, false, false, false, false, false, false, false))));
    Log(LaneName(LaneFromBoundaryFact(BoundaryLaneInputFact(BoundaryKind.BoundaryKindExecution, false, 0, false, false, false, false, false, false, true, false, false))));
}
