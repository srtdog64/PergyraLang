// src/self_hosted/sea/execution_lane.pgy
//
// SEA ExecutionLane classifier — the self-host (Pergyra) mirror of the C policy
// in src/compiler/execution_lane.c. This is the self-host side of the async
// wiring (docs/146): the compiler decides which runtime lane a task's evidence
// permits, and the self-host compiler must be able to make the SAME decision.
//
// Idiomatic Pergyra, not C-shaped: the lane is a typed `enum` value returned
// directly, never an out-of-band integer; "not found / rejected" is the
// first-class `Reject` variant, never a -1 sentinel. The ordering of the rules
// is the contract, identical to the C policy (pin -> effect -> movability).

enum ExecutionLane {
    Reject,
    Inline,
    PinnedZone,
    BlockingPool,
    LocalAsync,
    WorkerPool,
    MovableScheduler
}

struct BoundaryCaptureFact {
    let captures_pin: Bool;
    let captures_live_view: Bool;
    let captures_raw_slot: Bool;
    let captures_raw_channel: Bool;
    let captures_value_only: Bool;
    let crosses_authority_boundary: Bool;
    let requires_movability: Bool;
    let has_io_or_ffi_effect: Bool;
    let is_await_heavy_local: Bool;
    let is_deterministic_fork_join: Bool;
    let is_concurrent_site: Bool;
}

func ClassifyLane(fact: BoundaryCaptureFact) -> ExecutionLane {
    if !fact.is_concurrent_site {
        return ExecutionLane.Inline;
    }
    if fact.captures_pin || fact.captures_live_view || fact.captures_raw_slot || fact.captures_raw_channel {
        if fact.requires_movability {
            return ExecutionLane.Reject;
        }
        return ExecutionLane.PinnedZone;
    }
    if fact.has_io_or_ffi_effect {
        return ExecutionLane.BlockingPool;
    }
    if fact.is_await_heavy_local {
        return ExecutionLane.LocalAsync;
    }
    if fact.is_deterministic_fork_join {
        return ExecutionLane.WorkerPool;
    }
    if fact.captures_value_only && fact.crosses_authority_boundary {
        return ExecutionLane.MovableScheduler;
    }
    if fact.captures_value_only {
        return ExecutionLane.WorkerPool;
    }
    return ExecutionLane.LocalAsync;
}

func LaneName(lane: ExecutionLane) -> String {
    match lane {
        case Reject: return "Reject";
        case Inline: return "Inline";
        case PinnedZone: return "PinnedZone";
        case BlockingPool: return "BlockingPool";
        case LocalAsync: return "LocalAsync";
        case WorkerPool: return "WorkerPool";
        case MovableScheduler: return "MovableScheduler";
    }
}

// The 10 decision-table cases, in the same order as the C proof
// (src/tests/execution_lane_policy_test.c), so the two policies can be diffed.
func Main() -> Void {
    Log(LaneName(ClassifyLane(BoundaryCaptureFact(false, false, false, false, false, false, false, false, false, false, false))));
    Log(LaneName(ClassifyLane(BoundaryCaptureFact(true,  false, false, false, false, false, false, false, false, false, true))));
    Log(LaneName(ClassifyLane(BoundaryCaptureFact(false, false, true,  false, false, false, false, false, false, false, true))));
    Log(LaneName(ClassifyLane(BoundaryCaptureFact(true,  false, false, false, false, false, true,  false, false, false, true))));
    Log(LaneName(ClassifyLane(BoundaryCaptureFact(false, false, false, false, true,  true,  false, true,  false, false, true))));
    Log(LaneName(ClassifyLane(BoundaryCaptureFact(false, false, false, false, false, false, false, false, true,  false, true))));
    Log(LaneName(ClassifyLane(BoundaryCaptureFact(false, false, false, false, true,  true,  false, false, false, true,  true))));
    Log(LaneName(ClassifyLane(BoundaryCaptureFact(false, false, false, false, true,  true,  false, false, false, false, true))));
    Log(LaneName(ClassifyLane(BoundaryCaptureFact(false, false, false, false, true,  false, false, false, false, false, true))));
    Log(LaneName(ClassifyLane(BoundaryCaptureFact(false, false, false, false, false, false, false, false, false, false, true))));
}
