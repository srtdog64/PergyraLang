// Canonical Array<T> shape facts without expression-verdict dependencies.

import "../lib/source_scan_owner.pgy";

func SemanticArrayElementType(type_name: String) -> Option<String> {
    if StringLength(type_name) >= 8 && StartsWith(type_name, "Array<") &&
        SourceCharAt(type_name, StringLength(type_name) - 1) == ">" {
        return Some(Substring(type_name, 6, StringLength(type_name) - 7));
    }
    return None;
}

func SemanticOwnedSequenceElementType(type_name: String) -> Option<String> {
    if IsSome(SemanticArrayElementType(type_name)) {
        return SemanticArrayElementType(type_name);
    }
    let prefixes: Array<String> = ["List<", "Queue<"];
    let i: Int = 0;
    while i < ArrayLength(prefixes) {
        let prefix: String = prefixes[i];
        if StringLength(type_name) > StringLength(prefix) &&
            StartsWith(type_name, prefix) &&
            SourceCharAt(type_name, StringLength(type_name) - 1) == ">" {
            return Some(Substring(
                type_name, StringLength(prefix),
                StringLength(type_name) - StringLength(prefix) - 1
            ));
        }
        i = i + 1;
    }
    return None;
}

func SemanticSequenceElementType(type_name: String) -> Option<String> {
    let owned_element: Option<String> =
        SemanticOwnedSequenceElementType(type_name);
    if IsSome(owned_element) { return owned_element; }
    if StringLength(type_name) > 6 && StartsWith(type_name, "Slice<") &&
        SourceCharAt(type_name, StringLength(type_name) - 1) == ">" {
        return Some(Substring(type_name, 6, StringLength(type_name) - 7));
    }
    return None;
}

func SemanticArrayTypeShapeContractReady() -> Bool {
    let element: Option<String> = SemanticArrayElementType("Array<Int>");
    return IsSome(element) && UnwrapOption(element) == "Int" &&
        !IsSome(SemanticArrayElementType("Int")) &&
        !IsSome(SemanticArrayElementType("Array<Int")) &&
        IsSome(SemanticOwnedSequenceElementType("List<Int>")) &&
        UnwrapOption(SemanticOwnedSequenceElementType("Queue<String>")) ==
            "String" &&
        !IsSome(SemanticOwnedSequenceElementType("Slice<Int>")) &&
        IsSome(SemanticSequenceElementType("List<Int>")) &&
        IsSome(SemanticSequenceElementType("Slice<Int>")) &&
        UnwrapOption(SemanticSequenceElementType("Queue<String>")) ==
            "String" &&
        !IsSome(SemanticSequenceElementType("Int"));
}
