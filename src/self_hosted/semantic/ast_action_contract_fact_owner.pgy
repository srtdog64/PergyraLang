// Single typed owner for callable/action contract facts.
// Consumers use these rows; they do not skip unknown AST text on the way to Body.

import "../hir/ast_text_arena_projection_owner.pgy";
import "../hir/ast_text_scan_owner.pgy";
import "../hir/ast_node_kind_owner.pgy";
import "../lib/callable_contract_vocabulary_projection_owner.pgy";

struct SemanticAstActionContractFacts {
    ok: Bool;
    diagnostic_message: String;
    artifact_node_count: Int;
    callable_node_ids: Array<Int>;
    is_actions: Array<Bool>;
    owner_nominal_subkinds: Array<Int>;
    body_node_ids: Array<Int>;
    requires_node_ids: Array<Int>;
    requires_starts: Array<Int>;
    requires_counts: Array<Int>;
    requires_names: Array<String>;
    within_node_ids: Array<Int>;
    within_zone_names: Array<String>;
    causes_node_ids: Array<Int>;
    causes_names: Array<String>;
    authorized_by_node_ids: Array<Int>;
    authorized_by_starts: Array<Int>;
    authorized_by_counts: Array<Int>;
    authorized_by_names: Array<String>;
    caps_node_ids: Array<Int>;
    cap_starts: Array<Int>;
    cap_counts: Array<Int>;
    cap_names: Array<String>;
    effects_node_ids: Array<Int>;
    effect_starts: Array<Int>;
    effect_counts: Array<Int>;
    effect_names: Array<String>;
}

func SemanticAstActionContractRangeContains(
    names: Array<String>, start: Int, name: String
) -> Bool {
    let i: Int = start;
    while i < ArrayLength(names) {
        if names[i] == name { return true; }
        i = i + 1;
    }
    return false;
}

func SemanticAstActionContractAppendList(
    payload: String,
    vocabulary_axis: Int,
    inout names: Array<String>
) -> Bool {
    let start: Int = ArrayLength(names);
    let rest: String = StringTrim(payload);
    if StringLength(rest) == 0 { return false; }
    while StringLength(rest) > 0 {
        let comma: Option<Int> = FindTopLevelComma(rest);
        let item: String = rest;
        if IsSome(comma) {
            item = StringTrim(Substring(rest, 0, UnwrapOption(comma)));
            let next: Int = UnwrapOption(comma) + 1;
            rest = StringTrim(Substring(
                rest, next, StringLength(rest) - next
            ));
        } else {
            item = StringTrim(rest);
            rest = "";
        }
        let vocabulary_index: Int = -1;
        if vocabulary_axis > 0 {
            vocabulary_index = CallableContractVocabularyFindIndex(
                vocabulary_axis, item
            );
        }
        if StringLength(item) == 0 ||
            (vocabulary_axis > 0 && vocabulary_index < 0) ||
            SemanticAstActionContractRangeContains(names, start, item) {
            return false;
        }
        if vocabulary_axis == CallableContractVocabularyEffectAxis() {
            let item_zero: Bool = CallableContractVocabularyZeroPolicyAt(
                vocabulary_index
            ) == CallableContractVocabularyZeroExclusive();
            let i: Int = start;
            while i < ArrayLength(names) {
                let existing: Int = CallableContractVocabularyFindIndex(
                    vocabulary_axis, names[i]
                );
                if item_zero || (existing >= 0 &&
                    CallableContractVocabularyZeroPolicyAt(existing) ==
                        CallableContractVocabularyZeroExclusive()) {
                    return false;
                }
                i = i + 1;
            }
        }
        ArrayPush(names, item);
    }
    return ArrayLength(names) > start;
}

func SemanticAstActionContractOwnerNominalSubkind(
    arena: AstArena, callable_node_id: Int
) -> Option<Int> {
    let parent: Option<Int> = TypedAstArenaParentId(arena, callable_node_id);
    let remaining: Int = TypedAstArenaNodeCount(arena);
    while IsSome(parent) && remaining > 0 {
        let parent_id: Int = UnwrapOption(parent);
        if TypedAstArenaNodeKindIs(
            arena, parent_id, TypedAstKindNominalDeclTag()
        ) {
            return TypedAstArenaNominalSubkind(arena, parent_id);
        }
        parent = TypedAstArenaParentId(arena, parent_id);
        remaining = remaining - 1;
    }
    if IsSome(parent) { return None; }
    return Some(TypedAstNominalSubkindNone());
}

func SemanticAstActionContractFactsFromArtifact(
    artifact: AstTreeArtifact,
    callable_node_ids: Array<Int>,
    runtime_callables: Array<Bool>
) -> SemanticAstActionContractFacts {
    let is_actions: Array<Bool> = [];
    let owner_nominal_subkinds: Array<Int> = [];
    let body_node_ids: Array<Int> = [];
    let requires_node_ids: Array<Int> = [];
    let requires_starts: Array<Int> = [];
    let requires_counts: Array<Int> = [];
    let requires_names: Array<String> = [];
    let within_node_ids: Array<Int> = [];
    let within_zone_names: Array<String> = [];
    let causes_node_ids: Array<Int> = [];
    let causes_names: Array<String> = [];
    let authorized_by_node_ids: Array<Int> = [];
    let authorized_by_starts: Array<Int> = [];
    let authorized_by_counts: Array<Int> = [];
    let authorized_by_names: Array<String> = [];
    let caps_node_ids: Array<Int> = [];
    let cap_starts: Array<Int> = [];
    let cap_counts: Array<Int> = [];
    let cap_names: Array<String> = [];
    let effects_node_ids: Array<Int> = [];
    let effect_starts: Array<Int> = [];
    let effect_counts: Array<Int> = [];
    let effect_names: Array<String> = [];
    let ok: Bool = AstTreeArtifactReady(artifact) &&
        ArrayLength(callable_node_ids) == ArrayLength(runtime_callables);
    let diagnostic_message: String = "";
    let callable_index: Int = 0;
    while callable_index < ArrayLength(callable_node_ids) && ok {
        let callable_node_id: Int = callable_node_ids[callable_index];
        let kind: Option<Int> = TypedAstArenaNodeKind(
            artifact.arena, callable_node_id
        );
        if !IsSome(kind) || !TypedAstKindIsCallableDecl(UnwrapOption(kind)) {
            ok = false;
            diagnostic_message = "action contract callable identity is missing";
            continue;
        }
        let is_action: Bool = UnwrapOption(kind) ==
            TypedAstKindActionDeclTag();
        let owner_subkind: Option<Int> =
            SemanticAstActionContractOwnerNominalSubkind(
                artifact.arena, callable_node_id
            );
        if !IsSome(owner_subkind) ||
            (is_action && UnwrapOption(owner_subkind) !=
                TypedAstNominalSubkindSubject()) {
            ok = false;
            diagnostic_message = "action declaration requires a subject owner";
            continue;
        }

        let body_node_id: Int = -1;
        let requires_node_id: Int = -1;
        let within_node_id: Int = -1;
        let within_zone_name: String = "";
        let causes_node_id: Int = -1;
        let causes_name: String = "";
        let authorized_by_node_id: Int = -1;
        let caps_node_id: Int = -1;
        let effects_node_id: Int = -1;
        let requires_start: Int = ArrayLength(requires_names);
        let authorized_by_start: Int = ArrayLength(authorized_by_names);
        let cap_start: Int = ArrayLength(cap_names);
        let effect_start: Int = ArrayLength(effect_names);
        let contract_order: Int = 0;
        let child_index: Int = 0;
        let child: Option<Int> = TypedAstArenaChildAt(
            artifact.arena, callable_node_id, child_index
        );
        while IsSome(child) && ok {
            let child_id: Int = UnwrapOption(child);
            let child_kind: Option<Int> = TypedAstArenaNodeKind(
                artifact.arena, child_id
            );
            if !IsSome(child_kind) {
                ok = false;
                diagnostic_message = "action contract child kind is missing";
                continue;
            }
            let row_kind: Int = UnwrapOption(child_kind);
            let next_order: Int = 0;
            if row_kind == TypedAstKindActionRequiresTag() { next_order = 1; }
            else if row_kind == TypedAstKindActionWithinTag() { next_order = 2; }
            else if row_kind == TypedAstKindActionCausesTag() { next_order = 3; }
            else if row_kind == TypedAstKindActionAuthorizedByTag() { next_order = 4; }
            else if row_kind == TypedAstKindCallableCapsTag() { next_order = 5; }
            else if row_kind == TypedAstKindCallableEffectsTag() { next_order = 6; }
            else if row_kind == TypedAstKindBodyTag() { next_order = 7; }
            if next_order > 0 {
                if next_order < contract_order ||
                    (next_order == contract_order && next_order != 7) {
                    ok = false;
                    diagnostic_message = "action contract row order is invalid";
                    continue;
                }
                contract_order = next_order;
            }
            if row_kind == TypedAstKindActionRequiresTag() {
                if !is_action || requires_node_id >= 0 {
                    ok = false;
                    diagnostic_message = "requires is action-only and unique";
                    continue;
                }
                let payload: Option<String> = TypedAstArenaAtomText(
                    artifact.arena, child_id
                );
                if !IsSome(payload) || !SemanticAstActionContractAppendList(
                    UnwrapOption(payload), 0,
                    requires_names
                ) {
                    ok = false;
                    diagnostic_message = "action requires list is invalid";
                    continue;
                }
                requires_node_id = child_id;
            } else if row_kind == TypedAstKindActionWithinTag() {
                if !is_action || within_node_id >= 0 {
                    ok = false;
                    diagnostic_message = "within is action-only and unique";
                    continue;
                }
                let payload: Option<String> = TypedAstArenaAtomText(
                    artifact.arena, child_id
                );
                if !IsSome(payload) || StringLength(UnwrapOption(payload)) == 0 {
                    ok = false;
                    diagnostic_message = "action within zone is missing";
                    continue;
                }
                within_node_id = child_id;
                within_zone_name = UnwrapOption(payload);
            } else if row_kind == TypedAstKindActionCausesTag() {
                if !is_action || causes_node_id >= 0 {
                    ok = false;
                    diagnostic_message = "causes is action-only and unique";
                    continue;
                }
                let payload: Option<String> = TypedAstArenaAtomText(
                    artifact.arena, child_id
                );
                if !IsSome(payload) || StringLength(UnwrapOption(payload)) == 0 {
                    ok = false;
                    diagnostic_message = "action cause is missing";
                    continue;
                }
                causes_node_id = child_id;
                causes_name = UnwrapOption(payload);
            } else if row_kind == TypedAstKindActionAuthorizedByTag() {
                if !is_action || authorized_by_node_id >= 0 {
                    ok = false;
                    diagnostic_message = "authorized by is action-only and unique";
                    continue;
                }
                let payload: Option<String> = TypedAstArenaAtomText(
                    artifact.arena, child_id
                );
                if !IsSome(payload) || !SemanticAstActionContractAppendList(
                    UnwrapOption(payload), 0,
                    authorized_by_names
                ) {
                    ok = false;
                    diagnostic_message = "action authority list is invalid";
                    continue;
                }
                authorized_by_node_id = child_id;
            } else if row_kind == TypedAstKindCallableCapsTag() {
                if caps_node_id >= 0 {
                    ok = false;
                    diagnostic_message = "callable caps row is duplicated";
                    continue;
                }
                let payload: Option<String> = TypedAstArenaAtomText(
                    artifact.arena, child_id
                );
                if !IsSome(payload) || !SemanticAstActionContractAppendList(
                    UnwrapOption(payload),
                    CallableContractVocabularyCapabilityAxis(), cap_names
                ) {
                    ok = false;
                    diagnostic_message = "callable capability list is invalid";
                    continue;
                }
                caps_node_id = child_id;
            } else if row_kind == TypedAstKindCallableEffectsTag() {
                if effects_node_id >= 0 {
                    ok = false;
                    diagnostic_message = "callable effects row is duplicated";
                    continue;
                }
                let payload: Option<String> = TypedAstArenaAtomText(
                    artifact.arena, child_id
                );
                if !IsSome(payload) || !SemanticAstActionContractAppendList(
                    UnwrapOption(payload),
                    CallableContractVocabularyEffectAxis(), effect_names
                ) {
                    ok = false;
                    diagnostic_message = "callable effect list is invalid";
                    continue;
                }
                effects_node_id = child_id;
            } else if row_kind == TypedAstKindBodyTag() {
                if body_node_id >= 0 {
                    ok = false;
                    diagnostic_message = "callable body row is duplicated";
                    continue;
                }
                body_node_id = child_id;
            }
            child_index = child_index + 1;
            child = TypedAstArenaChildAt(
                artifact.arena, callable_node_id, child_index
            );
        }
        if ok && runtime_callables[callable_index] && body_node_id < 0 {
            ok = false;
            diagnostic_message = "runtime callable body row is missing";
            continue;
        }
        if ok && !runtime_callables[callable_index] && body_node_id >= 0 {
            ok = false;
            diagnostic_message = "signature-only callable owns a body row";
            continue;
        }
        if !ok { continue; }
        ArrayPush(is_actions, is_action);
        ArrayPush(owner_nominal_subkinds, UnwrapOption(owner_subkind));
        ArrayPush(body_node_ids, body_node_id);
        ArrayPush(requires_node_ids, requires_node_id);
        ArrayPush(requires_starts, requires_start);
        ArrayPush(requires_counts, ArrayLength(requires_names) - requires_start);
        ArrayPush(within_node_ids, within_node_id);
        ArrayPush(within_zone_names, within_zone_name);
        ArrayPush(causes_node_ids, causes_node_id);
        ArrayPush(causes_names, causes_name);
        ArrayPush(authorized_by_node_ids, authorized_by_node_id);
        ArrayPush(authorized_by_starts, authorized_by_start);
        ArrayPush(
            authorized_by_counts,
            ArrayLength(authorized_by_names) - authorized_by_start
        );
        ArrayPush(caps_node_ids, caps_node_id);
        ArrayPush(cap_starts, cap_start);
        ArrayPush(cap_counts, ArrayLength(cap_names) - cap_start);
        ArrayPush(effects_node_ids, effects_node_id);
        ArrayPush(effect_starts, effect_start);
        ArrayPush(effect_counts, ArrayLength(effect_names) - effect_start);
        callable_index = callable_index + 1;
    }
    return SemanticAstActionContractFacts(
        ok, diagnostic_message, artifact.count, callable_node_ids,
        is_actions, owner_nominal_subkinds, body_node_ids,
        requires_node_ids, requires_starts, requires_counts, requires_names,
        within_node_ids, within_zone_names, causes_node_ids, causes_names,
        authorized_by_node_ids, authorized_by_starts, authorized_by_counts,
        authorized_by_names, caps_node_ids, cap_starts, cap_counts, cap_names,
        effects_node_ids, effect_starts, effect_counts, effect_names
    );
}

func SemanticAstActionContractFactsReady(
    artifact: AstTreeArtifact, facts: SemanticAstActionContractFacts
) -> Bool {
    let count: Int = ArrayLength(facts.callable_node_ids);
    if !facts.ok || facts.artifact_node_count != artifact.count ||
        count != ArrayLength(facts.is_actions) ||
        count != ArrayLength(facts.owner_nominal_subkinds) ||
        count != ArrayLength(facts.body_node_ids) ||
        count != ArrayLength(facts.requires_node_ids) ||
        count != ArrayLength(facts.requires_starts) ||
        count != ArrayLength(facts.requires_counts) ||
        count != ArrayLength(facts.within_node_ids) ||
        count != ArrayLength(facts.within_zone_names) ||
        count != ArrayLength(facts.causes_node_ids) ||
        count != ArrayLength(facts.causes_names) ||
        count != ArrayLength(facts.authorized_by_node_ids) ||
        count != ArrayLength(facts.authorized_by_starts) ||
        count != ArrayLength(facts.authorized_by_counts) ||
        count != ArrayLength(facts.caps_node_ids) ||
        count != ArrayLength(facts.cap_starts) ||
        count != ArrayLength(facts.cap_counts) ||
        count != ArrayLength(facts.effects_node_ids) ||
        count != ArrayLength(facts.effect_starts) ||
        count != ArrayLength(facts.effect_counts) {
        return false;
    }
    let i: Int = 0;
    while i < count {
        if !TypedAstArenaNodeKindIsCallable(
            artifact.arena, facts.callable_node_ids[i]
        ) || facts.is_actions[i] != TypedAstArenaNodeKindIs(
            artifact.arena, facts.callable_node_ids[i],
            TypedAstKindActionDeclTag()
        ) || facts.requires_starts[i] < 0 || facts.requires_counts[i] < 0 ||
            facts.requires_starts[i] + facts.requires_counts[i] >
                ArrayLength(facts.requires_names) ||
            facts.authorized_by_starts[i] < 0 ||
            facts.authorized_by_counts[i] < 0 ||
            facts.authorized_by_starts[i] + facts.authorized_by_counts[i] >
                ArrayLength(facts.authorized_by_names) ||
            facts.cap_starts[i] < 0 || facts.cap_counts[i] < 0 ||
            facts.cap_starts[i] + facts.cap_counts[i] >
                ArrayLength(facts.cap_names) ||
            facts.effect_starts[i] < 0 || facts.effect_counts[i] < 0 ||
            facts.effect_starts[i] + facts.effect_counts[i] >
                ArrayLength(facts.effect_names) {
            return false;
        }
        if facts.body_node_ids[i] >= 0 && !TypedAstArenaNodeKindIs(
            artifact.arena, facts.body_node_ids[i], TypedAstKindBodyTag()
        ) { return false; }
        i = i + 1;
    }
    return true;
}

func SemanticAstActionContractJoinRange(
    names: Array<String>, start: Int, count: Int
) -> String {
    let out: String = "";
    let i: Int = 0;
    while i < count {
        if i > 0 { out = Concat(out, ", "); }
        out = Concat(out, names[start + i]);
        i = i + 1;
    }
    return out;
}

func SemanticAstActionContractChildCount(
    arena: AstArena, callable_node_id: Int, expected_kind: Int
) -> Int {
    let count: Int = 0;
    let child_index: Int = 0;
    let child: Option<Int> = TypedAstArenaChildAt(
        arena, callable_node_id, child_index
    );
    while IsSome(child) {
        if TypedAstArenaNodeKindIs(
            arena, UnwrapOption(child), expected_kind
        ) { count = count + 1; }
        child_index = child_index + 1;
        child = TypedAstArenaChildAt(arena, callable_node_id, child_index);
    }
    return count;
}

func SemanticAstActionContractNodeMatches(
    arena: AstArena,
    callable_node_id: Int,
    node_id: Int,
    expected_kind: Int,
    expected_payload: String
) -> Bool {
    let expected_count: Int = 0;
    if node_id >= 0 { expected_count = 1; }
    if SemanticAstActionContractChildCount(
        arena, callable_node_id, expected_kind
    ) != expected_count {
        return false;
    }
    if node_id < 0 { return StringLength(expected_payload) == 0; }
    let parent: Option<Int> = TypedAstArenaParentId(arena, node_id);
    let payload: Option<String> = TypedAstArenaAtomText(arena, node_id);
    return IsSome(parent) && UnwrapOption(parent) == callable_node_id &&
        TypedAstArenaNodeKindIs(arena, node_id, expected_kind) &&
        IsSome(payload) && UnwrapOption(payload) == expected_payload;
}

func SemanticAstActionContractFactsMatchArtifact(
    artifact: AstTreeArtifact, facts: SemanticAstActionContractFacts
) -> Bool {
    if !SemanticAstActionContractFactsReady(artifact, facts) {
        return false;
    }
    let i: Int = 0;
    while i < ArrayLength(facts.callable_node_ids) {
        let callable_node_id: Int = facts.callable_node_ids[i];
        let owner_subkind: Option<Int> =
            SemanticAstActionContractOwnerNominalSubkind(
                artifact.arena, callable_node_id
            );
        if !IsSome(owner_subkind) || UnwrapOption(owner_subkind) !=
            facts.owner_nominal_subkinds[i] ||
            (facts.is_actions[i] && UnwrapOption(owner_subkind) !=
                TypedAstNominalSubkindSubject()) {
            return false;
        }
        let requires_payload: String =
            SemanticAstActionContractJoinRange(
                facts.requires_names, facts.requires_starts[i],
                facts.requires_counts[i]
            );
        let authority_payload: String =
            SemanticAstActionContractJoinRange(
                facts.authorized_by_names, facts.authorized_by_starts[i],
                facts.authorized_by_counts[i]
            );
        let caps_payload: String = SemanticAstActionContractJoinRange(
            facts.cap_names, facts.cap_starts[i], facts.cap_counts[i]
        );
        let effects_payload: String = SemanticAstActionContractJoinRange(
            facts.effect_names, facts.effect_starts[i], facts.effect_counts[i]
        );
        if !SemanticAstActionContractNodeMatches(
            artifact.arena, callable_node_id, facts.requires_node_ids[i],
            TypedAstKindActionRequiresTag(), requires_payload
        ) || !SemanticAstActionContractNodeMatches(
            artifact.arena, callable_node_id, facts.within_node_ids[i],
            TypedAstKindActionWithinTag(), facts.within_zone_names[i]
        ) || !SemanticAstActionContractNodeMatches(
            artifact.arena, callable_node_id, facts.causes_node_ids[i],
            TypedAstKindActionCausesTag(), facts.causes_names[i]
        ) || !SemanticAstActionContractNodeMatches(
            artifact.arena, callable_node_id,
            facts.authorized_by_node_ids[i],
            TypedAstKindActionAuthorizedByTag(), authority_payload
        ) || !SemanticAstActionContractNodeMatches(
            artifact.arena, callable_node_id, facts.caps_node_ids[i],
            TypedAstKindCallableCapsTag(), caps_payload
        ) || !SemanticAstActionContractNodeMatches(
            artifact.arena, callable_node_id, facts.effects_node_ids[i],
            TypedAstKindCallableEffectsTag(), effects_payload
        ) {
            return false;
        }
        let body_expected: Int = 0;
        if facts.body_node_ids[i] >= 0 { body_expected = 1; }
        let body_parent: Option<Int> = None;
        if facts.body_node_ids[i] >= 0 {
            body_parent = TypedAstArenaParentId(
                artifact.arena, facts.body_node_ids[i]
            );
        }
        if SemanticAstActionContractChildCount(
            artifact.arena, callable_node_id, TypedAstKindBodyTag()
        ) != body_expected ||
            (facts.body_node_ids[i] >= 0 &&
                (!IsSome(body_parent) ||
                    UnwrapOption(body_parent) != callable_node_id)) {
            return false;
        }
        if !facts.is_actions[i] &&
            (facts.requires_counts[i] > 0 ||
                StringLength(facts.within_zone_names[i]) > 0 ||
                StringLength(facts.causes_names[i]) > 0 ||
                facts.authorized_by_counts[i] > 0) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func SemanticAstActionContractIndexForNode(
    facts: SemanticAstActionContractFacts, callable_node_id: Int
) -> Option<Int> {
    let i: Int = 0;
    while i < ArrayLength(facts.callable_node_ids) {
        if facts.callable_node_ids[i] == callable_node_id { return Some(i); }
        i = i + 1;
    }
    return None;
}
