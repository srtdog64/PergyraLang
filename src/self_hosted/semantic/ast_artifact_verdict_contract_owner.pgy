// Executable contract for semantic artifact identity and entrypoint verdicts.

import "ast_artifact_verdict_owner.pgy";

func SemanticAstArtifactVerdictContractReady() -> Bool {
    let valid: AstTreeArtifact = AstTreeArtifactFromText(
        "Program:\n  Enum: Direction { North, East }\n  Function: Main\n    Parameters:\n    Returns: Void\n    Body:\n      Block:\n        Let: x : Int = 1\n"
    );
    let valid_analysis: SemanticAstArtifactAnalysis =
        SemanticAstArtifactAnalyzeCompactBridge(valid, true);
    if !SemanticAstArtifactAnalysisMatches(valid, valid_analysis, true) ||
        valid_analysis.verdict.main_count != 1 ||
        SemanticAstFunctionSignatureCount(valid_analysis.signatures) != 1 ||
        SemanticAstNominalConstructorCount(valid_analysis.constructors) != 0 ||
        SemanticAstLocalBindingCount(valid_analysis.local_bindings) != 1 ||
        SemanticAstAssignmentCount(valid_analysis.assignments) != 0 ||
        SemanticAstStatementCount(valid_analysis.statements) != 0 ||
        SemanticAstEnumCount(valid_analysis.enums) != 1 ||
        valid_analysis.enums.enum_names[0] != "Direction" ||
        ArrayLength(valid_analysis.enums.variant_names) != 2 {
        return false;
    }
    let stale_same_count: AstTreeArtifact = AstTreeArtifactFromText(
        "Program:\n  Enum: Direction { South, West }\n  Function: Other\n    Parameters:\n    Returns: Void\n    Body:\n      Block:\n        Let: y : Int = 2\n"
    );
    if stale_same_count.count != valid.count ||
        stale_same_count.identity_digest == valid.identity_digest ||
        SemanticAstArtifactAdmissionReady(
            stale_same_count, valid_analysis, true
        ) {
        return false;
    }
    let mutated_graph: AstExpressionGraphRows = AstExpressionGraphRows(
        true, [TypedAstKindLetStmtTag()], [AstExpressionLaneValue()], [0],
        AstExpressionArena([AstExpressionNodeLeaf()], ["1"], [0], [0])
    );
    let stale_same_tree: AstTreeArtifact = AstTreeArtifact(
        valid.tree_text, valid.arena, valid.count, mutated_graph, valid.source_modules,
        AstTreeArtifactIdentityDigest(
            valid.tree_text, valid.count, mutated_graph, valid.source_modules
        )
    );
    if !AstTreeArtifactReady(stale_same_tree) ||
        stale_same_tree.identity_digest == valid.identity_digest ||
        SemanticAstArtifactAdmissionReady(
            stale_same_tree, valid_analysis, true
        ) {
        return false;
    }
    let missing: AstTreeArtifact = AstTreeArtifactFromText("Program:\n");
    let missing_signatures: SemanticAstFunctionSignatureFacts =
        SemanticAstFunctionSignatureFactsFromArtifact(missing);
    let missing_verdict: SemanticAstArtifactVerdict =
        SemanticAstArtifactEntrypointVerdict(missing, missing_signatures, true);
    if missing_verdict.ok ||
        missing_verdict.diagnostic_code != "entrypoint_cardinality" {
        return false;
    }
    let duplicate: AstTreeArtifact = AstTreeArtifactFromText(
        "Program:\n  Function: Main\n    Parameters:\n    Returns: Void\n    Body:\n      Block:\n  Function: Main\n    Parameters:\n    Returns: Void\n    Body:\n      Block:\n"
    );
    let duplicate_signatures: SemanticAstFunctionSignatureFacts =
        SemanticAstFunctionSignatureFactsFromArtifact(duplicate);
    let duplicate_verdict: SemanticAstArtifactVerdict =
        SemanticAstArtifactEntrypointVerdict(
            duplicate, duplicate_signatures, true
        );
    return !duplicate_verdict.ok && duplicate_verdict.main_count == 2 &&
        duplicate_verdict.diagnostic_code == "entrypoint_cardinality";
}
