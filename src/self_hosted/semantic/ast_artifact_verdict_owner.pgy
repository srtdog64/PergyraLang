// Semantic verdicts derived from the shared parser-owned AST artifact.

import "../hir/ast_text_arena_projection_owner.pgy";
import "diagnostic_owner.pgy";
import "ast_signature_artifact_match_owner.pgy";
import "ast_nominal_constructor_fact_owner.pgy";
import "ast_zone_authority_fact_owner.pgy";
import "ast_local_binding_fact_owner.pgy";
import "ast_assignment_fact_owner.pgy";
import "ast_statement_fact_owner.pgy";
import "ast_enum_fact_owner.pgy";
import "ast_role_fact_owner.pgy";
import "ast_ability_generic_bound_verdict_owner.pgy";
import "ast_expression_surface_fact_owner.pgy";
import "ast_expression_call_target_capture_owner.pgy";
import "ast_expression_function_table_fact_owner.pgy";
import "ast_expression_typed_binding_owner.pgy";
import "ast_intent_signature_fact_owner.pgy";
import "ast_intent_transition_fact_owner.pgy";
import "ast_type_surface_fact_owner.pgy";
import "ast_kind_surface_fact_owner.pgy";
import "ast_function_scope_fact_owner.pgy";

struct SemanticAstArtifactVerdict {
    ok: Bool;
    diagnostic_code: String;
    diagnostic_message: String;
    node_count: Int;
    artifact_identity_digest: Int;
    main_count: Int;
    requires_entrypoint: Bool;
}

struct SemanticAstArtifactAnalysis {
    verdict: SemanticAstArtifactVerdict;
    signatures: SemanticAstFunctionSignatureFacts;
    intent_signatures: SemanticAstIntentSignatureFacts;
    intent_transitions: SemanticAstIntentTransitionFacts;
    constructors: SemanticAstNominalConstructorFacts;
    zone_authorities: SemanticAstZoneAuthorityFacts;
    local_bindings: SemanticAstLocalBindingFacts;
    assignments: SemanticAstAssignmentFacts;
    statements: SemanticAstStatementFacts;
    enums: SemanticAstEnumFacts;
    roles: SemanticAstRoleFacts;
    expression_surfaces: SemanticAstExpressionSurfaceFacts;
    type_surfaces: SemanticAstTypeSurfaceFacts;
    kind_surfaces: SemanticAstKindSurfaceFacts;
    function_tables: SemanticAstExpressionFunctionTableFacts;
    function_scopes: SemanticAstFunctionScopeFacts;
}

func SemanticAstArtifactVerdictOk(node_count: Int, artifact_identity_digest: Int,
                                  main_count: Int,
                                  requires_entrypoint: Bool) -> SemanticAstArtifactVerdict {
    return SemanticAstArtifactVerdict(
        true, "", "", node_count, artifact_identity_digest,
        main_count, requires_entrypoint
    );
}

func SemanticAstArtifactVerdictError(code: String, message: String,
                                     node_count: Int, artifact_identity_digest: Int,
                                     main_count: Int,
                                     requires_entrypoint: Bool) -> SemanticAstArtifactVerdict {
    return SemanticAstArtifactVerdict(
        false, code, message, node_count, artifact_identity_digest,
        main_count, requires_entrypoint
    );
}

func SemanticAstArtifactEntrypointVerdict(
    artifact: AstTreeArtifact,
    signatures: SemanticAstFunctionSignatureFacts,
    requires_entrypoint: Bool
) -> SemanticAstArtifactVerdict {
    if !SemanticAstFunctionSignatureFactsMatchArtifact(artifact, signatures) {
        return SemanticAstArtifactVerdictError(
            "ast_artifact_invalid",
            SemanticError2(
                "ast_artifact_invalid",
                "node_count", ToString(artifact.count),
                "owner", "SemanticAstFunctionSignatureFacts"
            ),
            artifact.count,
            artifact.identity_digest,
            0,
            requires_entrypoint
        );
    }
    let main_count: Int = 0;
    let i: Int = 0;
    while i < SemanticAstFunctionSignatureCount(signatures) {
        let name: Option<String> = SemanticAstFunctionNameAt(signatures, i);
        if IsSome(name) && UnwrapOption(name) == "Main" {
            main_count = main_count + 1;
        }
        i = i + 1;
    }
    if requires_entrypoint && main_count != 1 {
        return SemanticAstArtifactVerdictError(
            "entrypoint_cardinality",
            SemanticError2(
                "entrypoint_cardinality",
                "expected", "exactly_one",
                "actual", ToString(main_count)
            ),
            artifact.count,
            artifact.identity_digest,
            main_count,
            requires_entrypoint
        );
    }
    if !requires_entrypoint && main_count > 1 {
        return SemanticAstArtifactVerdictError(
            "entrypoint_cardinality",
            SemanticError2(
                "entrypoint_cardinality",
                "expected", "at_most_one",
                "actual", ToString(main_count)
            ),
            artifact.count,
            artifact.identity_digest,
            main_count,
            requires_entrypoint
        );
    }
    return SemanticAstArtifactVerdictOk(
        artifact.count, artifact.identity_digest, main_count,
        requires_entrypoint
    );
}

func SemanticAstArtifactVerdictMatches(
    artifact: AstTreeArtifact,
    verdict: SemanticAstArtifactVerdict,
    requires_entrypoint: Bool
) -> Bool {
    return verdict.ok &&
        verdict.node_count == artifact.count &&
        verdict.artifact_identity_digest == artifact.identity_digest &&
        verdict.requires_entrypoint == requires_entrypoint;
}

// Fixed-size admission check used after the semantic owner has already built
// and admitted the fact bundle.  This compares the producer-time artifact
// identity carried by the verdict; it deliberately does not reconstruct any
// semantic fact family from the AST.
func SemanticAstArtifactAdmissionReady(
    artifact: AstTreeArtifact,
    ref analysis: SemanticAstArtifactAnalysis,
    requires_entrypoint: Bool
) -> Bool {
    return artifact.identity_digest > 0 && analysis.verdict.ok &&
        SemanticAstArtifactVerdictMatches(
            artifact, analysis.verdict, requires_entrypoint
        );
}

func SemanticAstArtifactAnalyzeFromExpressionSurfaces(
    artifact: AstTreeArtifact,
    requires_entrypoint: Bool,
    input_expression_surfaces: SemanticAstExpressionSurfaceFacts,
    require_carried_call_targets: Bool
) -> SemanticAstArtifactAnalysis {
    let signatures: SemanticAstFunctionSignatureFacts =
        SemanticAstFunctionSignatureFactsFromArtifact(artifact);
    let intent_signatures: SemanticAstIntentSignatureFacts =
        SemanticAstIntentSignatureFactsFromArtifact(artifact);
    let intent_transitions: SemanticAstIntentTransitionFacts =
        SemanticAstIntentTransitionFactsFromArtifact(
            artifact, signatures, intent_signatures
        );
    let function_scopes: SemanticAstFunctionScopeFacts = SemanticAstFunctionScopeFactsFromArtifact(artifact);
    let constructors: SemanticAstNominalConstructorFacts =
        SemanticAstNominalConstructorFactsFromArtifact(artifact);
    let zone_authorities: SemanticAstZoneAuthorityFacts =
        SemanticAstZoneAuthorityFactsFromArtifact(artifact, constructors);
    let enums: SemanticAstEnumFacts = SemanticAstEnumFactsFromArtifact(artifact);
    let function_tables: SemanticAstExpressionFunctionTableFacts =
        SemanticAstExpressionFunctionTableFactsFromArtifact(
            artifact, signatures, constructors, enums
        );
    let expression_surfaces: SemanticAstExpressionSurfaceFacts =
        input_expression_surfaces;
    if signatures.ok && constructors.ok && input_expression_surfaces.ok {
        let target_graph: SemanticExpressionGraphFacts =
            SemanticExpressionGraphCallTargetsFromSignatures(
                input_expression_surfaces.expression_graph,
                signatures, constructors, enums,
                require_carried_call_targets, function_tables
            );
        expression_surfaces = SemanticAstExpressionSurfaceFactsWithGraph(
            artifact, input_expression_surfaces, target_graph
        );
    }
    let roles: SemanticAstRoleFacts = SemanticAstRoleFactsFromArtifact(artifact);
    let ability_generic_bounds: SemanticAstAbilityGenericBoundVerdict =
        SemanticAstAbilityGenericBoundsVerdict(roles);
    let type_surfaces: SemanticAstTypeSurfaceFacts =
        SemanticAstTypeSurfaceFactsFromArtifact(artifact);
    let kind_surfaces: SemanticAstKindSurfaceFacts =
        SemanticAstKindSurfaceFactsFromArtifact(artifact);
    if !signatures.ok || !intent_signatures.ok || !intent_transitions.ok || !function_scopes.ok {
        let signature_diagnostic_code: String = signatures.diagnostic_code;
        let signature_diagnostic_message: String = signatures.diagnostic_message;
        if signatures.ok {
            signature_diagnostic_code = intent_signatures.diagnostic_code;
            signature_diagnostic_message = intent_signatures.diagnostic_message;
        }
        if signatures.ok && intent_signatures.ok {
            signature_diagnostic_code = "ast_artifact_invalid";
            signature_diagnostic_message =
                intent_transitions.diagnostic_message;
        }
        if signatures.ok && intent_signatures.ok && intent_transitions.ok {
            signature_diagnostic_code = "ast_artifact_invalid";
            signature_diagnostic_message = SemanticError1("ast_artifact_invalid", "owner", "SemanticAstFunctionScopeFacts");
        }
        let rejected: SemanticAstArtifactVerdict = SemanticAstArtifactVerdictError(
            signature_diagnostic_code,
            signature_diagnostic_message,
            artifact.count,
            artifact.identity_digest,
            0,
            requires_entrypoint
        );
        let empty_locals: SemanticAstLocalBindingFacts =
            SemanticAstLocalBindingFactsFromArtifact(artifact, signatures);
        let empty_assignments: SemanticAstAssignmentFacts =
            SemanticAstAssignmentFactsFromArtifact(artifact, signatures);
        let empty_statements: SemanticAstStatementFacts =
            SemanticAstStatementFactsFromArtifact(artifact, signatures);
        return SemanticAstArtifactAnalysis(
            rejected, signatures, intent_signatures, intent_transitions,
            constructors, zone_authorities,
            empty_locals, empty_assignments,
            empty_statements, enums, roles, expression_surfaces, type_surfaces,
            kind_surfaces, function_tables, function_scopes
        );
    }
    if !constructors.ok {
        let rejected_constructor: SemanticAstArtifactVerdict =
            SemanticAstArtifactVerdictError(
                constructors.diagnostic_code,
                constructors.diagnostic_message,
                artifact.count,
                artifact.identity_digest,
                0,
                requires_entrypoint
            );
        let constructor_locals: SemanticAstLocalBindingFacts =
            SemanticAstLocalBindingFactsFromArtifact(artifact, signatures);
        let constructor_assignments: SemanticAstAssignmentFacts =
            SemanticAstAssignmentFactsFromArtifact(artifact, signatures);
        let constructor_statements: SemanticAstStatementFacts =
            SemanticAstStatementFactsFromArtifact(artifact, signatures);
        return SemanticAstArtifactAnalysis(
            rejected_constructor, signatures, intent_signatures,
            intent_transitions, constructors, zone_authorities,
            constructor_locals, constructor_assignments,
            constructor_statements, enums, roles, expression_surfaces,
            type_surfaces, kind_surfaces, function_tables, function_scopes
        );
    }
    if !zone_authorities.ok {
        let rejected_zone_authority: SemanticAstArtifactVerdict =
            SemanticAstArtifactVerdictError(
                "ast_artifact_invalid",
                SemanticError1(
                    "ast_artifact_invalid", "owner",
                    "SemanticAstZoneAuthorityFacts"
                ),
                artifact.count, artifact.identity_digest,
                0, requires_entrypoint
            );
        return SemanticAstArtifactAnalysis(
            rejected_zone_authority, signatures, intent_signatures,
            intent_transitions, constructors, zone_authorities,
            SemanticAstLocalBindingFactsFromArtifact(artifact, signatures),
            SemanticAstAssignmentFactsFromArtifact(artifact, signatures),
            SemanticAstStatementFactsFromArtifact(artifact, signatures),
            enums, roles, expression_surfaces, type_surfaces, kind_surfaces,
            function_tables, function_scopes
        );
    }
    if !enums.ok {
        let rejected_enum: SemanticAstArtifactVerdict =
            SemanticAstArtifactVerdictError(
                "ast_artifact_invalid",
                SemanticError1("ast_artifact_invalid", "owner", "SemanticAstEnumFacts"),
                artifact.count,
                artifact.identity_digest,
                0,
                requires_entrypoint
            );
        return SemanticAstArtifactAnalysis(
            rejected_enum, signatures, intent_signatures, intent_transitions,
            constructors, zone_authorities,
            SemanticAstLocalBindingFactsFromArtifact(artifact, signatures),
            SemanticAstAssignmentFactsFromArtifact(artifact, signatures),
            SemanticAstStatementFactsFromArtifact(artifact, signatures),
            enums, roles, expression_surfaces, type_surfaces, kind_surfaces,
            function_tables, function_scopes
        );
    }
    if !roles.ok {
        let rejected_role: SemanticAstArtifactVerdict =
            SemanticAstArtifactVerdictError(
                "ast_artifact_invalid",
                SemanticError1("ast_artifact_invalid", "owner", "SemanticAstRoleFacts"),
                artifact.count,
                artifact.identity_digest,
                0,
                requires_entrypoint
            );
        return SemanticAstArtifactAnalysis(
            rejected_role, signatures, intent_signatures, intent_transitions,
            constructors, zone_authorities,
            SemanticAstLocalBindingFactsFromArtifact(artifact, signatures),
            SemanticAstAssignmentFactsFromArtifact(artifact, signatures),
            SemanticAstStatementFactsFromArtifact(artifact, signatures),
            enums, roles, expression_surfaces, type_surfaces, kind_surfaces,
            function_tables, function_scopes
        );
    }
    if !ability_generic_bounds.ok {
        let rejected_ability_generic_bound: SemanticAstArtifactVerdict =
            SemanticAstArtifactVerdictError(
                "ast_artifact_invalid",
                SemanticError3(
                    "ast_artifact_invalid",
                    "owner", "SemanticAstAbilityGenericBoundVerdict",
                    "ability", ability_generic_bounds.ability_name,
                    "broken_bound", ability_generic_bounds.broken_bound_name
                ),
                artifact.count,
                artifact.identity_digest,
                0,
                requires_entrypoint
            );
        return SemanticAstArtifactAnalysis(
            rejected_ability_generic_bound, signatures, intent_signatures,
            intent_transitions, constructors, zone_authorities,
            SemanticAstLocalBindingFactsFromArtifact(artifact, signatures),
            SemanticAstAssignmentFactsFromArtifact(artifact, signatures),
            SemanticAstStatementFactsFromArtifact(artifact, signatures),
            enums, roles, expression_surfaces, type_surfaces, kind_surfaces,
            function_tables, function_scopes
        );
    }
    if !expression_surfaces.ok {
        let rejected_expression_surface: SemanticAstArtifactVerdict =
            SemanticAstArtifactVerdictError(
                "ast_artifact_invalid",
                SemanticError3(
                    "ast_artifact_invalid",
                    "owner", "SemanticAstExpressionSurfaceFacts",
                    "node", ToString(expression_surfaces.failure_node_id),
                    "lane", expression_surfaces.failure_lane
                ),
                artifact.count, artifact.identity_digest,
                0, requires_entrypoint
            );
        return SemanticAstArtifactAnalysis(
            rejected_expression_surface, signatures, intent_signatures,
            intent_transitions, constructors, zone_authorities,
            SemanticAstLocalBindingFactsFromArtifact(artifact, signatures),
            SemanticAstAssignmentFactsFromArtifact(artifact, signatures),
            SemanticAstStatementFactsFromArtifact(artifact, signatures),
            enums, roles, expression_surfaces, type_surfaces, kind_surfaces,
            function_tables, function_scopes
        );
    }
    if !type_surfaces.ok {
        let rejected_type_surface: SemanticAstArtifactVerdict =
            SemanticAstArtifactVerdictError(
                "ast_artifact_invalid",
                SemanticError1(
                    "ast_artifact_invalid", "owner", "SemanticAstTypeSurfaceFacts"
                ),
                artifact.count, artifact.identity_digest,
                0, requires_entrypoint
            );
        return SemanticAstArtifactAnalysis(
            rejected_type_surface, signatures, intent_signatures,
            intent_transitions, constructors, zone_authorities,
            SemanticAstLocalBindingFactsFromArtifact(artifact, signatures),
            SemanticAstAssignmentFactsFromArtifact(artifact, signatures),
            SemanticAstStatementFactsFromArtifact(artifact, signatures),
            enums, roles, expression_surfaces, type_surfaces, kind_surfaces,
            function_tables, function_scopes
        );
    }
    if !kind_surfaces.ok {
        let rejected_kind_surface: SemanticAstArtifactVerdict =
            SemanticAstArtifactVerdictError(
                "ast_artifact_invalid",
                SemanticError1(
                    "ast_artifact_invalid", "owner", "SemanticAstKindSurfaceFacts"
                ),
                artifact.count, artifact.identity_digest,
                0, requires_entrypoint
            );
        return SemanticAstArtifactAnalysis(
            rejected_kind_surface, signatures, intent_signatures,
            intent_transitions, constructors, zone_authorities,
            SemanticAstLocalBindingFactsFromArtifact(artifact, signatures),
            SemanticAstAssignmentFactsFromArtifact(artifact, signatures),
            SemanticAstStatementFactsFromArtifact(artifact, signatures),
            enums, roles, expression_surfaces, type_surfaces, kind_surfaces,
            function_tables, function_scopes
        );
    }
    let local_bindings: SemanticAstLocalBindingFacts =
        SemanticAstLocalBindingFactsFromArtifact(artifact, signatures);
    if !local_bindings.ok {
        let rejected2: SemanticAstArtifactVerdict = SemanticAstArtifactVerdictError(
            local_bindings.diagnostic_code,
            local_bindings.diagnostic_message,
            artifact.count,
            artifact.identity_digest,
            0,
            requires_entrypoint
        );
        let rejected_assignments: SemanticAstAssignmentFacts =
            SemanticAstAssignmentFactsFromArtifact(artifact, signatures);
        let rejected_statements: SemanticAstStatementFacts =
            SemanticAstStatementFactsFromArtifact(artifact, signatures);
        return SemanticAstArtifactAnalysis(
            rejected2, signatures, intent_signatures, intent_transitions,
            constructors, zone_authorities,
            local_bindings,
            rejected_assignments,
            rejected_statements, enums, roles, expression_surfaces, type_surfaces,
            kind_surfaces, function_tables, function_scopes
        );
    }
    let assignments: SemanticAstAssignmentFacts =
        SemanticAstAssignmentFactsFromArtifact(artifact, signatures);
    if !assignments.ok {
        let rejected3: SemanticAstArtifactVerdict = SemanticAstArtifactVerdictError(
            assignments.diagnostic_code,
            assignments.diagnostic_message,
            artifact.count,
            artifact.identity_digest,
            0,
            requires_entrypoint
        );
        return SemanticAstArtifactAnalysis(
            rejected3, signatures, intent_signatures, intent_transitions,
            constructors, zone_authorities,
            local_bindings, assignments,
            SemanticAstStatementFactsFromArtifact(artifact, signatures), enums,
            roles, expression_surfaces, type_surfaces, kind_surfaces,
            function_tables, function_scopes
        );
    }
    let statements: SemanticAstStatementFacts =
        SemanticAstStatementFactsFromArtifact(artifact, signatures);
    if !statements.ok {
        let rejected4: SemanticAstArtifactVerdict = SemanticAstArtifactVerdictError(
            statements.diagnostic_code,
            statements.diagnostic_message,
            artifact.count,
            artifact.identity_digest,
            0,
            requires_entrypoint
        );
        return SemanticAstArtifactAnalysis(
            rejected4, signatures, intent_signatures, intent_transitions,
            constructors, zone_authorities,
            local_bindings,
            assignments, statements, enums, roles, expression_surfaces,
            type_surfaces, kind_surfaces, function_tables, function_scopes
        );
    }
    let verdict: SemanticAstArtifactVerdict =
        SemanticAstArtifactEntrypointVerdict(
            artifact, signatures, requires_entrypoint
        );
    return SemanticAstArtifactAnalysis(
        verdict, signatures, intent_signatures, intent_transitions,
        constructors, zone_authorities,
        local_bindings, assignments,
        statements, enums, roles, expression_surfaces, type_surfaces,
        kind_surfaces, function_tables, function_scopes
    );
}

func SemanticAstArtifactAnalyzeCompactBridge(
    artifact: AstTreeArtifact,
    requires_entrypoint: Bool
) -> SemanticAstArtifactAnalysis {
    return SemanticAstArtifactAnalyzeFromExpressionSurfaces(
        artifact, requires_entrypoint,
        SemanticAstExpressionSurfaceFactsFromArtifactCompactBridge(artifact),
        false
    );
}

func SemanticAstArtifactAnalyzeTyped(
    artifact: AstTreeArtifact,
    requires_entrypoint: Bool
) -> SemanticAstArtifactAnalysis {
    return SemanticAstArtifactAnalyzeFromExpressionSurfaces(
        artifact, requires_entrypoint,
        SemanticAstExpressionSurfaceFactsFromTypedArtifact(artifact),
        false
    );
}

func SemanticAstArtifactAnalyzeWithExpressionGraph(
    artifact: AstTreeArtifact,
    requires_entrypoint: Bool,
    graph: SemanticExpressionGraphFacts
) -> SemanticAstArtifactAnalysis {
    let expression_surfaces: SemanticAstExpressionSurfaceFacts =
        SemanticAstExpressionSurfaceFactsWithGraph(
            artifact,
            SemanticAstExpressionSurfaceRowsFromArtifact(artifact),
            graph
        );
    return SemanticAstArtifactAnalyzeFromExpressionSurfaces(
        artifact, requires_entrypoint, expression_surfaces, true
    );
}

func SemanticAstArtifactAnalysisMatches(
    artifact: AstTreeArtifact,
    analysis: SemanticAstArtifactAnalysis,
    requires_entrypoint: Bool
) -> Bool {
    return SemanticAstArtifactAdmissionReady(
        artifact, analysis, requires_entrypoint
    ) && SemanticAstFunctionSignatureFactsMatchArtifact(
        artifact, analysis.signatures
    ) && SemanticAstNominalConstructorFactsMatchArtifact(
        artifact, analysis.constructors
    ) && SemanticAstLocalBindingFactsMatchArtifact(
        artifact, analysis.signatures, analysis.local_bindings
    ) && SemanticAstAssignmentFactsMatchArtifact(
        artifact, analysis.signatures, analysis.assignments
    ) && SemanticAstStatementFactsMatchArtifact(
        artifact, analysis.signatures, analysis.statements
    ) && SemanticAstEnumFactsMatchArtifact(
        artifact, analysis.enums
    ) && SemanticAstRoleFactsMatchArtifact(
        artifact, analysis.roles
    ) && SemanticAstExpressionSurfaceFactsMatchArtifact(
        artifact, analysis.expression_surfaces
    ) && SemanticAstTypeSurfaceFactsMatchArtifact(
        artifact, analysis.type_surfaces
    ) && SemanticAstKindSurfaceFactsMatchArtifact(
        artifact, analysis.kind_surfaces
    ) && SemanticAstFunctionScopeFactsMatchArtifact(
        artifact, analysis.function_scopes
    );
}
