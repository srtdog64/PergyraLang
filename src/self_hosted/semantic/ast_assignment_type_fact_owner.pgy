// Semantic assignment type verdicts derived from artifact-owned facts.
//
// This owner joins assignment rows with signature, scope, local, and
// initializer type facts. Unknown types fail closed; no backend guesses them.

import "ast_assignment_fact_owner.pgy";
import "../lib/source_scan_owner.pgy";
import "ast_expression_environment_owner.pgy";
import "ast_initializer_type_fact_owner.pgy";
import "ast_iteration_type_fact_owner.pgy";
import "expr_type_owner.pgy";
import "ast_expression_verdict_owner.pgy";
import "array_type_owner.pgy";
import "projection_type_owner.pgy";
import "ast_enum_fact_owner.pgy";
import "ast_expression_graph_view_owner.pgy";

struct SemanticAstAssignmentTypeFacts {
    ok: Bool;
    diagnostic_code: String;
    diagnostic_message: String;
    artifact_node_count: Int;
    node_ids: Array<Int>;
    target_texts: Array<String>;
    expected_type_names: Array<String>;
    inferred_type_names: Array<String>;
    verified: Array<Int>;
    diagnostic_codes: Array<String>;
    diagnostic_messages: Array<String>;
}

func SemanticAstAssignmentTypeStructuralError(
    artifact: AstTreeArtifact
) -> SemanticAstAssignmentTypeFacts {
    let empty_ints: Array<Int> = [];
    let empty_strings: Array<String> = [];
    return SemanticAstAssignmentTypeFacts(
        false,
        "ast_artifact_invalid",
        SemanticError2(
            "ast_artifact_invalid",
            "node_count", ToString(artifact.count),
            "owner", "SemanticAstAssignmentTypeFacts"
        ),
        artifact.count,
        empty_ints, empty_strings, empty_strings, empty_strings, empty_ints,
        empty_strings, empty_strings
    );
}

func SemanticAstAssignmentTypeFactsFromArtifact(
    artifact: AstTreeArtifact,
    signatures: SemanticAstFunctionSignatureFacts,
    constructors: SemanticAstNominalConstructorFacts,
    locals: SemanticAstLocalBindingFacts,
    initializer_types: SemanticAstInitializerTypeFacts,
    statements: SemanticAstStatementFacts,
    expression_surfaces: SemanticAstExpressionSurfaceFacts,
    iteration_types: SemanticAstIterationTypeFacts,
    assignments: SemanticAstAssignmentFacts
) -> SemanticAstAssignmentTypeFacts {
    if !AstTreeArtifactReady(artifact) ||
        !SemanticAstFunctionSignatureFactsMatchArtifact(
            artifact, signatures
        ) || !SemanticAstNominalConstructorFactsMatchArtifact(
            artifact, constructors
        ) || !SemanticAstLocalBindingFactsMatchArtifact(
            artifact, signatures, locals
        ) || !SemanticAstInitializerTypeFactsMatchArtifact(
            artifact, signatures, constructors, locals,
            expression_surfaces, initializer_types
        ) || !SemanticAstIterationTypeFactsMatchArtifact(
            artifact, signatures, constructors, locals, initializer_types,
            statements, expression_surfaces, iteration_types
        ) || !SemanticAstAssignmentFactsMatchArtifact(
            artifact, signatures, assignments
        ) {
        return SemanticAstAssignmentTypeStructuralError(artifact);
    }

    let function_names: Array<String> = [];
    let function_returns: Array<String> = [];
    let function_params: Array<String> = [];
    if !SemanticAstExpressionFunctionTables(
        signatures, constructors,
        function_names, function_returns, function_params
    ) {
        return SemanticAstAssignmentTypeStructuralError(artifact);
    }

    let node_ids: Array<Int> = [];
    let target_texts: Array<String> = [];
    let expected_type_names: Array<String> = [];
    let inferred_type_names: Array<String> = [];
    let verified: Array<Int> = [];
    let diagnostic_codes: Array<String> = [];
    let diagnostic_messages: Array<String> = [];
    let enum_facts: SemanticAstEnumFacts =
        SemanticAstEnumFactsFromArtifact(artifact);
    if !enum_facts.ok {
        return SemanticAstAssignmentTypeStructuralError(artifact);
    }
    let member_root_names: Array<String> = [];
    if !SemanticAstExpressionMemberRootNames(
        constructors, enum_facts, member_root_names
    ) {
        return SemanticAstAssignmentTypeStructuralError(artifact);
    }
    let i: Int = 0;
    while i < SemanticAstAssignmentCount(assignments) {
        let names: Array<String> = [];
        let types: Array<String> = [];
        let modes: Array<String> = [];
        if !SemanticAstExpressionSeedParameters(
            signatures, assignments.function_node_ids[i], names, types
        ) || !SemanticAstExpressionSeedParameterModes(
            signatures, assignments.function_node_ids[i], modes
        ) || !SemanticAstExpressionSeedVisibleLocals(
            artifact, locals, initializer_types.inferred_type_names,
            assignments.function_node_ids[i], assignments.node_ids[i],
            names, types
        ) || !SemanticAstExpressionSeedVisibleLocalModes(
            artifact, locals, assignments.function_node_ids[i],
            assignments.node_ids[i], modes
        ) || !SemanticAstIterationSeedVisibleBindings(
            artifact, statements, iteration_types,
            assignments.function_node_ids[i], assignments.node_ids[i],
            names, types, modes
        ) || ArrayLength(names) != ArrayLength(modes) {
            return SemanticAstAssignmentTypeStructuralError(artifact);
        }
        let target_base: String = assignments.target_base_names[i];
        let expected: String = "";
        let inferred: String = "Unknown";
        let row_verified: Int = 0;
        let row_code: String = "";
        let row_message: String = "";
        if !EnvContainsName(names, target_base) {
            row_code = "undefined_symbol";
            row_message = SemanticError1(
                "undefined_symbol", "name", target_base
            );
        } else {
            expected = EnvLookup(names, types, target_base);
            if assignments.target_is_indexed[i] == 1 {
                let element_type_opt: Option<String> =
                    SemanticArrayElementType(expected);
                let index_verdict: SemanticAstExpressionVerdict =
                    SemanticAstExpressionVerdictFromPayload(
                        assignments.target_index_texts[i], names, types, modes,
                        function_names, function_returns, function_params
                    );
                if !index_verdict.ok {
                    row_code = index_verdict.diagnostic_code;
                    row_message = index_verdict.diagnostic_message;
                } else if !IsSome(element_type_opt) ||
                    index_verdict.inferred_type_name != "Int" {
                    if IsSome(element_type_opt) {
                        expected = UnwrapOption(element_type_opt);
                    }
                    row_code = "assignment_type_unresolved";
                    row_message = SemanticError2(
                        "assignment_type_unresolved",
                        "target", assignments.target_texts[i],
                        "value", assignments.value_texts[i]
                    );
                } else {
                    expected = UnwrapOption(element_type_opt);
                }
            }
            if row_code == "" {
                let value_root: Option<Int> =
                    SemanticAstExpressionGraphRootForNode(
                        expression_surfaces, assignments.node_ids[i],
                        AstExpressionLaneValue()
                    );
                if !IsSome(value_root) {
                    return SemanticAstAssignmentTypeStructuralError(artifact);
                }
                let value_verdict: SemanticAstExpressionVerdict =
                    SemanticAstExpressionVerdictFromGraph(
                        assignments.value_texts[i],
                        expression_surfaces.expression_graph,
                        UnwrapOption(value_root), constructors,
                        names, types, modes,
                        function_names, function_returns, function_params,
                        member_root_names
                    );
                inferred = value_verdict.inferred_type_name;
                if !value_verdict.ok {
                    row_code = value_verdict.diagnostic_code;
                    row_message = value_verdict.diagnostic_message;
                } else {
                    if inferred == "Unknown" || inferred == "" {
                        if SemanticProjectionArrayLiteralMatchesDeclaredType(
                            assignments.value_texts[i], expected, constructors,
                            names, types, modes,
                            function_names, function_returns, function_params
                        ) {
                            inferred = expected;
                        }
                    }
                    if inferred == "Unknown" || inferred == "" {
                        let enum_type: Option<String> =
                            SemanticAstEnumExpressionType(
                                enum_facts, assignments.value_texts[i]
                            );
                        if IsSome(enum_type) {
                            inferred = UnwrapOption(enum_type);
                        }
                    }
                    if inferred == "Unknown" || inferred == "" {
                        let projection_type: Option<String> =
                            SemanticProjectionExpressionType(
                                assignments.value_texts[i], constructors,
                                names, types, modes,
                                function_names, function_returns,
                                function_params
                            );
                        if IsSome(projection_type) {
                            inferred = UnwrapOption(projection_type);
                        }
                    }
                    if inferred == "Unknown" || inferred == "" {
                        row_code = "assignment_type_unresolved";
                        row_message = SemanticError2(
                            "assignment_type_unresolved",
                            "target", assignments.target_texts[i],
                            "value", assignments.value_texts[i]
                        );
                    } else if !ExpressionAssignableTo(
                        expected, inferred, assignments.value_texts[i]
                    ) {
                        row_code = "assign_type_mismatch";
                        row_message = SemanticError2(
                            "assign_type_mismatch",
                            "expected", expected,
                            "actual", inferred
                        );
                    } else {
                        row_verified = 1;
                    }
                }
            }
        }
        ArrayPush(node_ids, assignments.node_ids[i]);
        ArrayPush(target_texts, assignments.target_texts[i]);
        ArrayPush(expected_type_names, expected);
        ArrayPush(inferred_type_names, inferred);
        ArrayPush(verified, row_verified);
        ArrayPush(diagnostic_codes, row_code);
        ArrayPush(diagnostic_messages, row_message);
        i = i + 1;
    }
    return SemanticAstAssignmentTypeFacts(
        true, "", "", artifact.count, node_ids, target_texts,
        expected_type_names, inferred_type_names, verified,
        diagnostic_codes, diagnostic_messages
    );
}

func SemanticAstAssignmentTypesAllVerified(
    ref facts: SemanticAstAssignmentTypeFacts
) -> Bool {
    if !facts.ok {
        return false;
    }
    let i: Int = 0;
    while i < ArrayLength(facts.node_ids) {
        if facts.verified[i] != 1 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func SemanticAstAssignmentFirstDiagnosticCode(
    facts: SemanticAstAssignmentTypeFacts
) -> String {
    if !facts.ok {
        return facts.diagnostic_code;
    }
    let i: Int = 0;
    while i < ArrayLength(facts.node_ids) {
        if facts.verified[i] != 1 {
            return facts.diagnostic_codes[i];
        }
        i = i + 1;
    }
    return "";
}

func SemanticAstAssignmentFirstDiagnosticMessage(
    facts: SemanticAstAssignmentTypeFacts
) -> String {
    if !facts.ok {
        return facts.diagnostic_message;
    }
    let i: Int = 0;
    while i < ArrayLength(facts.node_ids) {
        if facts.verified[i] != 1 {
            return facts.diagnostic_messages[i];
        }
        i = i + 1;
    }
    return "";
}

func SemanticAstAssignmentTypeFactsMatchArtifact(
    artifact: AstTreeArtifact,
    signatures: SemanticAstFunctionSignatureFacts,
    constructors: SemanticAstNominalConstructorFacts,
    locals: SemanticAstLocalBindingFacts,
    initializer_types: SemanticAstInitializerTypeFacts,
    statements: SemanticAstStatementFacts,
    expression_surfaces: SemanticAstExpressionSurfaceFacts,
    iteration_types: SemanticAstIterationTypeFacts,
    assignments: SemanticAstAssignmentFacts,
    facts: SemanticAstAssignmentTypeFacts
) -> Bool {
    let rebuilt: SemanticAstAssignmentTypeFacts =
        SemanticAstAssignmentTypeFactsFromArtifact(
            artifact, signatures, constructors, locals, initializer_types,
            statements, expression_surfaces, iteration_types, assignments
        );
    let n: Int = ArrayLength(facts.node_ids);
    if !facts.ok || !rebuilt.ok ||
        facts.artifact_node_count != artifact.count ||
        ArrayLength(rebuilt.node_ids) != n ||
        ArrayLength(facts.target_texts) != n ||
        ArrayLength(facts.expected_type_names) != n ||
        ArrayLength(facts.inferred_type_names) != n ||
        ArrayLength(facts.verified) != n ||
        ArrayLength(facts.diagnostic_codes) != n ||
        ArrayLength(facts.diagnostic_messages) != n {
        return false;
    }
    let i: Int = 0;
    while i < n {
        if rebuilt.node_ids[i] != facts.node_ids[i] ||
            rebuilt.target_texts[i] != facts.target_texts[i] ||
            rebuilt.expected_type_names[i] != facts.expected_type_names[i] ||
            rebuilt.inferred_type_names[i] != facts.inferred_type_names[i] ||
            rebuilt.verified[i] != facts.verified[i] ||
            rebuilt.diagnostic_codes[i] != facts.diagnostic_codes[i] ||
            rebuilt.diagnostic_messages[i] != facts.diagnostic_messages[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func SemanticAstAssignmentTypeFactsContractReady() -> Bool {
    let valid: AstTreeArtifact = AstTreeArtifactFromText(
        "Program:\n  Function: Main\n    Parameters:\n    Returns: Void\n    Body:\n      Block:\n        Let: x : Int = 1\n        Assign: x = x + 1\n        Let: xs : Array<Int> = [1]\n        Assign: xs[0] = x\n"
    );
    let signatures: SemanticAstFunctionSignatureFacts =
        SemanticAstFunctionSignatureFactsFromArtifact(valid);
    let constructors: SemanticAstNominalConstructorFacts =
        SemanticAstNominalConstructorFactsFromArtifact(valid);
    let locals: SemanticAstLocalBindingFacts =
        SemanticAstLocalBindingFactsFromArtifact(valid, signatures);
    let expression_surfaces: SemanticAstExpressionSurfaceFacts =
        SemanticAstExpressionSurfaceFactsFromArtifactCompactBridge(valid);
    let initializers: SemanticAstInitializerTypeFacts =
        SemanticAstInitializerTypeFactsFromArtifact(
            valid, signatures, constructors, locals, expression_surfaces
        );
    let assignments: SemanticAstAssignmentFacts =
        SemanticAstAssignmentFactsFromArtifact(valid, signatures);
    let statements: SemanticAstStatementFacts =
        SemanticAstStatementFactsFromArtifact(valid, signatures);
    let iterations: SemanticAstIterationTypeFacts =
        SemanticAstIterationTypeFactsFromArtifact(
            valid, signatures, constructors, locals, initializers, statements,
            expression_surfaces
        );
    let valid_facts: SemanticAstAssignmentTypeFacts =
        SemanticAstAssignmentTypeFactsFromArtifact(
            valid, signatures, constructors, locals, initializers, statements,
            expression_surfaces, iterations, assignments
        );
    if !SemanticAstAssignmentTypeFactsMatchArtifact(
        valid, signatures, constructors, locals, initializers, statements,
        expression_surfaces, iterations, assignments, valid_facts
    ) || !SemanticAstAssignmentTypesAllVerified(valid_facts) ||
        ArrayLength(valid_facts.node_ids) != 2 ||
        valid_facts.expected_type_names[0] != "Int" ||
        valid_facts.expected_type_names[1] != "Int" {
        return false;
    }

    let mismatch: AstTreeArtifact = AstTreeArtifactFromText(
        "Program:\n  Function: Main\n    Parameters:\n    Returns: Void\n    Body:\n      Block:\n        Let: x : Int = 1\n        Assign: x = \"bad\"\n"
    );
    let mismatch_signatures: SemanticAstFunctionSignatureFacts =
        SemanticAstFunctionSignatureFactsFromArtifact(mismatch);
    let mismatch_constructors: SemanticAstNominalConstructorFacts =
        SemanticAstNominalConstructorFactsFromArtifact(mismatch);
    let mismatch_locals: SemanticAstLocalBindingFacts =
        SemanticAstLocalBindingFactsFromArtifact(
            mismatch, mismatch_signatures
        );
    let mismatch_expression_surfaces: SemanticAstExpressionSurfaceFacts =
        SemanticAstExpressionSurfaceFactsFromArtifactCompactBridge(mismatch);
    let mismatch_initializers: SemanticAstInitializerTypeFacts =
        SemanticAstInitializerTypeFactsFromArtifact(
            mismatch, mismatch_signatures, mismatch_constructors,
            mismatch_locals, mismatch_expression_surfaces
        );
    let mismatch_assignments: SemanticAstAssignmentFacts =
        SemanticAstAssignmentFactsFromArtifact(
            mismatch, mismatch_signatures
        );
    let mismatch_statements: SemanticAstStatementFacts =
        SemanticAstStatementFactsFromArtifact(
            mismatch, mismatch_signatures
        );
    let mismatch_iterations: SemanticAstIterationTypeFacts =
        SemanticAstIterationTypeFactsFromArtifact(
            mismatch, mismatch_signatures, mismatch_constructors,
            mismatch_locals,
            mismatch_initializers, mismatch_statements,
            mismatch_expression_surfaces
        );
    let mismatch_facts: SemanticAstAssignmentTypeFacts =
        SemanticAstAssignmentTypeFactsFromArtifact(
            mismatch, mismatch_signatures, mismatch_constructors,
            mismatch_locals,
            mismatch_initializers, mismatch_statements,
            mismatch_expression_surfaces, mismatch_iterations,
            mismatch_assignments
        );
    return !SemanticAstAssignmentTypesAllVerified(mismatch_facts) &&
        SemanticAstAssignmentFirstDiagnosticCode(mismatch_facts) ==
            "assign_type_mismatch";
}
