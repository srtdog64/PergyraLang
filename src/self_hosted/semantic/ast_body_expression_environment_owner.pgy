// One body-expression environment policy for ordinary callables and intents.

import "ast_artifact_verdict_owner.pgy";
import "ast_iteration_type_fact_owner.pgy";
import "ast_match_binding_environment_owner.pgy";
import "ast_expression/ast_expression_function_table_fact_owner.pgy";
import "ast_intent_expression_environment_owner.pgy";

func SemanticAstBodyExpressionEnvironmentSeed(
    ref artifact: AstTreeArtifact,
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    ref local_bindings: SemanticAstLocalBindingFacts,
    ref statements: SemanticAstStatementFacts,
    expression_surfaces_ok: Bool,
    expression_surface_artifact_node_count: Int,
    ref expression_surface_node_ids: Array<Int>,
    ref expression_graph: SemanticExpressionGraphFacts,
    enums: SemanticAstEnumFacts,
    function_scopes: SemanticAstFunctionScopeFacts,
    ref intent_transitions: SemanticAstIntentTransitionFacts,
    ref inferred_types: Array<String>,
    iteration_types: SemanticAstIterationTypeFacts,
    function_tables: SemanticAstExpressionFunctionTableFacts,
    ref intent_signatures: SemanticAstIntentSignatureFacts,
    function_node_id: Option<Int>,
    intent_node_id: Option<Int>,
    use_node_id: Int,
    inout names: Array<String>,
    inout types: Array<String>,
    inout modes: Array<String>
) -> Bool {
    let no_enum_values: SemanticAstEnumValueScope = SemanticAstEnumValueScopeEmpty();
    var environment_ok: Bool = false;
    if IsSome(function_node_id) {
        environment_ok =
            SemanticAstExpressionSeedOwnerFieldsFromAdmittedConstructors(
            signatures, constructors,
            UnwrapOption(function_node_id), names, types, modes
        ) && SemanticAstExpressionSeedParameters(
            signatures, constructors, UnwrapOption(function_node_id), names, types
        ) && SemanticAstExpressionSeedParameterModes(
            signatures, UnwrapOption(function_node_id), modes
        ) && SemanticAstExpressionSeedVisibleLocals(
            artifact, local_bindings, inferred_types,
            UnwrapOption(function_node_id), use_node_id, names, types, modes
        ) && SemanticAstIterationSeedVisibleBindings(
            artifact, statements, iteration_types,
            UnwrapOption(function_node_id), use_node_id, names, types, modes
        ) && SemanticAstExpressionSeedVisibleMatchBindingsFromProjection(
            artifact, statements,
            expression_surfaces_ok, expression_surface_artifact_node_count,
            expression_surface_node_ids, expression_graph, constructors,
            enums, function_scopes,
            UnwrapOption(function_node_id), use_node_id, names, types, modes,
            function_tables
        );
    } else if IsSome(intent_node_id) {
        environment_ok = SemanticAstExpressionSeedEnumValues(
            enums, names, types, modes
        ) && SemanticAstIntentExpressionSeedEnvironment(
            artifact, signatures, intent_signatures,
            intent_transitions,
            UnwrapOption(intent_node_id), use_node_id, names, types, modes, no_enum_values
        );
    }
    return environment_ok && ArrayLength(names) == ArrayLength(modes) &&
        ArrayLength(names) == ArrayLength(types);
}
