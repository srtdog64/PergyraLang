// One body-expression environment policy for ordinary callables and intents.

import "ast_artifact_verdict_owner.pgy";
import "ast_iteration_type_fact_owner.pgy";
import "ast_match_binding_environment_owner.pgy";
import "ast_expression_function_table_fact_owner.pgy";
import "ast_intent_expression_environment_owner.pgy";

func SemanticAstBodyExpressionEnvironmentSeed(
    artifact: AstTreeArtifact,
    ref analysis: SemanticAstArtifactAnalysis,
    inferred_types: Array<String>,
    iteration_types: SemanticAstIterationTypeFacts,
    function_tables: SemanticAstExpressionFunctionTableFacts,
    ref intent_signatures: SemanticAstIntentSignatureFacts,
    function_node_id: Option<Int>,
    intent_node_id: Option<Int>,
    use_node_id: Int,
    inout names: Array<String>,
    inout types: Array<String>,
    inout modes: Array<String>
) -> Bool {
    let environment_ok: Bool = false;
    if IsSome(function_node_id) {
        environment_ok =
            SemanticAstExpressionSeedOwnerFieldsFromAdmittedConstructors(
            analysis.signatures, analysis.constructors,
            UnwrapOption(function_node_id), names, types, modes
        ) && SemanticAstExpressionSeedParameters(
            analysis.signatures, UnwrapOption(function_node_id), names, types
        ) && SemanticAstExpressionSeedParameterModes(
            analysis.signatures, UnwrapOption(function_node_id), modes
        ) && SemanticAstExpressionSeedVisibleLocals(
            artifact, analysis.local_bindings, inferred_types,
            UnwrapOption(function_node_id), use_node_id, names, types
        ) && SemanticAstExpressionSeedVisibleLocalModes(
            artifact, analysis.local_bindings,
            UnwrapOption(function_node_id), use_node_id, modes
        ) && SemanticAstIterationSeedVisibleBindings(
            artifact, analysis.statements, iteration_types,
            UnwrapOption(function_node_id), use_node_id, names, types, modes
        ) && SemanticAstExpressionSeedVisibleMatchBindingsFromAdmittedFacts(
            artifact, analysis.expression_surfaces, analysis.constructors,
            analysis.enums, analysis.function_scopes,
            UnwrapOption(function_node_id), use_node_id, names, types, modes,
            function_tables
        );
    } else if IsSome(intent_node_id) {
        environment_ok = SemanticAstExpressionSeedEnumValues(
            analysis.enums, names, types, modes
        ) && SemanticAstIntentExpressionSeedEnvironment(
            artifact, analysis.signatures, intent_signatures,
            analysis.intent_transitions,
            UnwrapOption(intent_node_id), use_node_id, names, types, modes
        );
    }
    return environment_ok && ArrayLength(names) == ArrayLength(modes) &&
        ArrayLength(names) == ArrayLength(types);
}
