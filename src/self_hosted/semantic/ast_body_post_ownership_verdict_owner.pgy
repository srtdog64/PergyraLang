// Applies post-ownership boundaries whose facts remain borrowed by the bundle.
import "array_storage_release_verdict_owner.pgy";
import "string_window_extent_owner.pgy";
import "ast_zone_spawn_transport_verdict_owner.pgy";
import "ast_single_owner_handle_verdict_owner.pgy";
import "ast_expression_call_return_type_owner.pgy";
import "ast_capability_fact_owner.pgy";
import "ast_body_type_stage_observer_owner.pgy";
import "ast_containment_boundary_verdict_owner.pgy";
import "ast_enum_payload_variant_provenance_verdict_owner.pgy";
import "ast_body_flow_verdict_owner.pgy";
import "ast_slice_write_permission_owner.pgy";
import "ast_indexed_assignment_loan_owner.pgy";

struct SemanticAstBodyCapabilityVerdict {
    verdict: SemanticAstBodyVerdict,
    capabilities: SemanticAstCapabilityFacts
}

func SemanticAstBodyPostOwnershipPreVerdictFromFacts(
    artifact: AstTreeArtifact, inout analysis: SemanticAstArtifactAnalysis,
    verdict: SemanticAstBodyVerdict,
    ref initializer_types: SemanticAstInitializerTypeFacts,
    ref assignment_types: SemanticAstAssignmentTypeFacts,
    ref statement_types: SemanticAstStatementTypeFacts,
    ref resolved_leaf_types: Array<String>,
    ref generic_specializations: SemanticAstGenericSpecializationFacts,
    ref call_roots: SemanticCallSpineRoots,
    ref exhaustive_match_nodes: Array<Int>,
    ref occurrence_order: SemanticExpressionGraphSurfaceOrder,
    require_source_body_flow: Bool
) -> SemanticAstBodyVerdict {
    if verdict.ok {
        verdict = SemanticAstIndexedAssignmentLoanVerdict(
            artifact, analysis, initializer_types, resolved_leaf_types, call_roots);
    }
    if verdict.ok {
        verdict = SemanticAstSliceWritePermissionVerdict(
            artifact, analysis, initializer_types, resolved_leaf_types, call_roots);
    }
    if verdict.ok {
        verdict = SemanticArrayStorageReleaseVerdict(
            artifact, analysis, initializer_types, resolved_leaf_types,
            assignment_types, statement_types, exhaustive_match_nodes,
            occurrence_order);
    }
    if verdict.ok && require_source_body_flow {
        verdict = SemanticStringWindowExtentVerdict(
            artifact, analysis, initializer_types, call_roots);
    }
    verdict = SemanticAstBodyZoneSpawnBoundaryVerdictFromAdmittedFacts(
        verdict, artifact, analysis.signatures, analysis.constructors,
        analysis.expression_surfaces);
    if verdict.ok {
        verdict = SemanticAstSingleOwnerHandleVerdictFromResolvedFacts(
            artifact, analysis, initializer_types, assignment_types,
            generic_specializations, resolved_leaf_types);
    }
    if verdict.ok && !SemanticAstAnalysisResolveCallReturnTypes(
            artifact, analysis, generic_specializations) {
        verdict = SemanticAstBodyVerdictError(
            "call_return_type_unresolved",
            "semantic call return type rows are incomplete", -1);
    }
    return verdict;
}

func SemanticAstBodyCapabilityVerdictFromFacts(
    artifact: AstTreeArtifact, inout analysis: SemanticAstArtifactAnalysis,
    verdict: SemanticAstBodyVerdict,
    ref iteration_types: SemanticAstIterationTypeFacts,
    ref match_materializations: SemanticAstMatchMaterializationFacts,
    observe_pressure: Bool
) -> SemanticAstBodyCapabilityVerdict {
    var capabilities: SemanticAstCapabilityFacts =
        SemanticAstCapabilityFactsError(
            artifact, "body admission did not reach capability inference");
    if verdict.ok {
        SemanticAstBodyTypeStage(observe_pressure, "capability:start");
        capabilities = SemanticAstCapabilityFactsFromAdmittedBody(
            artifact, analysis, verdict, iteration_types,
            match_materializations);
        if !SemanticAstCapabilityFactsReady(
                artifact, analysis, capabilities) {
            verdict = SemanticAstBodyVerdictError(
                "capability_fact_invalid",
                SemanticError1("capability_fact_invalid", "detail",
                    capabilities.diagnostic_message), -1);
        } else if !capabilities.contract_ok {
            verdict = SemanticAstBodyVerdictError(
                capabilities.diagnostic_code,
                SemanticError1(capabilities.diagnostic_code, "detail",
                    capabilities.diagnostic_message),
                capabilities.first_node_id);
        }
        SemanticAstBodyTypeStage(observe_pressure, "capability:done");
    }
    return SemanticAstBodyCapabilityVerdict(verdict, capabilities);
}

func SemanticAstBodySourceBoundaryVerdictFromFacts(
    artifact: AstTreeArtifact, ref analysis: SemanticAstArtifactAnalysis,
    verdict: SemanticAstBodyVerdict,
    ref initializer_types: SemanticAstInitializerTypeFacts,
    ref statement_types: SemanticAstStatementTypeFacts,
    ref resolved_leaf_types: Array<String>,
    ref exhaustive_match_nodes: Array<Int>,
    require_source_body_flow: Bool,
    require_enum_payload_variant_proof: Bool,
    observe_pressure: Bool
) -> SemanticAstBodyVerdict {
    if verdict.ok {
        verdict = SemanticAstContainmentBoundaryVerdictFromResolvedFacts(
            analysis.constructors, analysis.expression_surfaces,
            resolved_leaf_types);
    }
    if verdict.ok && require_enum_payload_variant_proof {
        SemanticAstBodyTypeStage(observe_pressure, "enum-payload-variant:start");
        let payload: SemanticAstEnumPayloadVariantProvenanceVerdict =
            SemanticAstEnumPayloadVariantProvenanceVerdictFromAdmittedFacts(
                artifact, analysis.signatures, analysis.constructors,
                analysis.local_bindings, initializer_types,
                analysis.assignments, analysis.statements,
                analysis.expression_surfaces, analysis.enums);
        if !payload.ok {
            verdict = SemanticAstBodyVerdictError(
                payload.diagnostic_code, payload.diagnostic_message,
                payload.syntax_node_id);
        }
        SemanticAstBodyTypeStage(observe_pressure, "enum-payload-variant:done");
    }
    if verdict.ok && require_source_body_flow {
        verdict = SemanticAstBodyFlowVerdictFromFacts(
            artifact, analysis.signatures, analysis.statements,
            statement_types, analysis.expression_surfaces,
            exhaustive_match_nodes);
    }
    return verdict;
}
