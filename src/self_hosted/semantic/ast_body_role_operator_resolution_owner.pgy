// Body-fixpoint carriage of exact role-operator callable identities.

import "ast_artifact_verdict_owner.pgy";
import "ast_iteration_type_fact_owner.pgy";
import "ast_expression_function_table_fact_owner.pgy";
import "ast_body_expression_environment_owner.pgy";
import "ast_intent_expression_environment_owner.pgy";
import "role_operator_resolution_owner.pgy";

func SemanticAstRoleOperatorDeclarationPresence(
    roles: SemanticAstRoleFacts,
    signatures: SemanticAstFunctionSignatureFacts
) -> Option<Bool> {
    var role_index: Int = 0;
    while role_index < SemanticAstRoleCount(roles) {
        let method_count: Option<Int> = SemanticAstRoleMethodCountAt(
            roles, role_index
        );
        if !IsSome(method_count) { return None; }
        var method_index: Int = 0;
        while method_index < UnwrapOption(method_count) {
            let method_node: Option<Int> = SemanticAstRoleMethodNodeAt(
                roles, role_index, method_index
            );
            let ability_name: Option<String> =
                SemanticAstRoleMethodAbilityNameAt(
                    roles, role_index, method_index
                );
            if !IsSome(method_node) || !IsSome(ability_name) { return None; }
            let signature: Option<Int> =
                SemanticAstFunctionSignatureIndexForNode(
                    signatures, UnwrapOption(method_node)
                );
            if !IsSome(signature) { return None; }
            let name: Option<String> = SemanticAstFunctionNameAt(
                signatures, UnwrapOption(signature)
            );
            if !IsSome(name) { return None; }
            if UnwrapOption(ability_name) != "" &&
                IsSome(SemanticRoleOperatorKindForMethodName(
                UnwrapOption(name)
            )) {
                return Some(true);
            }
            method_index = method_index + 1;
        }
        role_index = role_index + 1;
    }
    return Some(false);
}

func SemanticExpressionGraphHasRoleOperatorTarget(
    ref graph: SemanticExpressionGraphFacts
) -> Bool {
    var node_id: Int = 0;
    while node_id < SemanticExpressionGraphArenaNodeCount(graph.arena) {
        if graph.arena.call_target_kinds[node_id] ==
            SemanticCallTargetRoleOperator() {
            return true;
        }
        node_id = node_id + 1;
    }
    return false;
}

func SemanticAstAnalysisResolveRoleOperatorTargetsFromAdmittedBody(
    artifact: AstTreeArtifact,
    inout analysis: SemanticAstArtifactAnalysis,
    inferred_types: Array<String>,
    iteration_types: SemanticAstIterationTypeFacts,
    function_tables: SemanticAstExpressionFunctionTableFacts
) -> Bool {
    if !analysis.verdict.ok || !analysis.signatures.ok ||
        !analysis.constructors.ok || !analysis.roles.ok ||
        ArrayLength(inferred_types) !=
            SemanticAstLocalBindingCount(analysis.local_bindings) ||
        !SemanticAstExpressionFunctionTableFactsReady(function_tables) ||
        !SemanticAstIntentSignatureFactsAdmittedReady(
            artifact, analysis.intent_signatures
        ) {
        return false;
    }
    let declaration_presence: Option<Bool> =
        SemanticAstRoleOperatorDeclarationPresence(
            analysis.roles, analysis.signatures
        );
    if !IsSome(declaration_presence) { return false; }
    if !UnwrapOption(declaration_presence) {
        return !SemanticExpressionGraphHasRoleOperatorTarget(
            analysis.expression_surfaces.expression_graph);
    }
    var last_root: Int = -1;
    var root_slot: Int = 0;
    var valid: Bool = true;
    while root_slot < ArrayLength(
        analysis.expression_surfaces.expression_graph.roots) && valid {
        if analysis.expression_surfaces.expression_graph.has_roots[root_slot] {
            let root_id: Int =
                analysis.expression_surfaces.expression_graph.roots[root_slot];
            let surface_index: Int = root_slot / 3;
            if surface_index < 0 || surface_index >= ArrayLength(
                analysis.expression_surfaces.node_ids
            ) || root_id <= last_root {
                valid = false;
            } else {
                var names: Array<String> = [];
                var types: Array<String> = [];
                var modes: Array<String> = [];
                let use_node_id: Int =
                    analysis.expression_surfaces.node_ids[surface_index];
                let function_node_id: Option<Int> =
                    SemanticAstExpressionFunctionNodeAt(
                        analysis.expression_surfaces,
                        analysis.signatures, surface_index
                    );
                let intent_node_id: Option<Int> =
                    SemanticAstExpressionIntentNodeAt(
                        analysis.expression_surfaces, analysis.intent_signatures, surface_index);
                if !SemanticAstBodyExpressionEnvironmentSeed(
                    artifact, analysis.signatures, analysis.constructors,
                    analysis.local_bindings, analysis.statements,
                    analysis.expression_surfaces.ok,
                    analysis.expression_surfaces.artifact_node_count,
                    analysis.expression_surfaces.node_ids,
                    analysis.expression_surfaces.expression_graph,
                    analysis.enums, analysis.function_scopes,
                    analysis.intent_transitions, inferred_types, iteration_types,
                    function_tables, analysis.intent_signatures,
                    function_node_id, intent_node_id, use_node_id,
                    names, types, modes
                ) {
                    valid = false;
                }
                if valid {
                    var node_id: Int = last_root + 1;
                    while node_id <= root_id && valid {
                        let kind: Int = analysis.expression_surfaces
                            .expression_graph.arena.topology.node_kinds[node_id];
                        if SemanticRoleOperatorKindSupported(kind) {
                            let resolved: SemanticRoleOperatorResolution =
                                SemanticRoleOperatorResolutionForNode(
                                    analysis.expression_surfaces.expression_graph,
                                    node_id, analysis.constructors,
                                    analysis.roles, analysis.signatures,
                                    names, types, function_tables.callables,
                                    function_tables.returns
                                );
                            if !resolved.ok {
                                valid = false;
                            } else {
                                let carried_kind: Int =
                                    analysis.expression_surfaces.expression_graph
                                        .arena.call_target_kinds[node_id];
                                let carried_name: String =
                                    analysis.expression_surfaces.expression_graph
                                        .arena.call_target_names[node_id];
                                let carried_result: String =
                                    analysis.expression_surfaces.expression_graph
                                        .arena.call_return_type_names[node_id];
                                if resolved.applies {
                                    if carried_kind != SemanticCallTargetNone() ||
                                        carried_name != "" ||
                                        carried_result != "" {
                                        // Carried kind/name must match exactly.
                                        // The result row is derived here and
                                        // only here, so pre-carried targets
                                        // (initial capture, persisted MIR)
                                        // legitimately arrive with an empty
                                        // result: fill it once; reject only a
                                        // conflicting non-empty carriage.
                                        if carried_kind !=
                                                SemanticCallTargetRoleOperator() ||
                                            carried_name != resolved.target_name ||
                                            (carried_result != "" &&
                                                carried_result !=
                                                    resolved.result_type_name) {
                                            valid = false;
                                        } else if carried_result == "" {
                                            analysis.expression_surfaces
                                                .expression_graph.arena
                                                .call_return_type_names[node_id] =
                                                resolved.result_type_name;
                                        }
                                    } else {
                                        analysis.expression_surfaces
                                            .expression_graph.arena
                                            .call_target_kinds[node_id] =
                                            SemanticCallTargetRoleOperator();
                                        analysis.expression_surfaces
                                            .expression_graph.arena
                                            .call_target_names[node_id] =
                                            resolved.target_name;
                                        analysis.expression_surfaces
                                            .expression_graph.arena
                                            .call_return_type_names[node_id] =
                                            resolved.result_type_name;
                                    }
                                } else if carried_kind !=
                                        SemanticCallTargetNone() ||
                                    carried_name != "" || carried_result != "" {
                                    valid = false;
                                }
                            }
                        }
                        node_id = node_id + 1;
                    }
                }
                SemanticAstExpressionEnvironmentClear(names, types, modes);
            }
            last_root = root_id;
        }
        root_slot = root_slot + 1;
    }
    if last_root + 1 != SemanticExpressionGraphArenaNodeCount(
        analysis.expression_surfaces.expression_graph.arena) {
        valid = false;
    }
    return valid && SemanticExpressionGraphRoleOperatorTargetsReady(
        analysis.expression_surfaces.expression_graph, true
    );
}
