// Canonical semantic assembly of body-level type facts.
// Driver/codegen consume this bundle and may not rebuild its body-type rows.
import "ast_body_analysis_admission_owner.pgy";
import "ast_body_verdict_owner.pgy";
import "ast_body_call_target_resolution_owner.pgy";
import "ast_expression/ast_expression_call_return_type_owner.pgy";
import "ast_generic_specialization_fact_owner.pgy";
import "ast_generic_specialization_query_owner.pgy";
import "ast_generic_specialization_constraint_owner.pgy";
import "ast_initializer_iteration_refinement_owner.pgy";
import "ast_expression/ast_expression_place_fact_owner.pgy";
import "ast_expression/ast_expression_identity_resolution_owner.pgy";
import "ast_initializer_type_function_table_bridge_owner.pgy";
import "ast_iteration_graph_root_owner.pgy";
import "ast_match_materialization_fact_owner.pgy";
import "ast_body_role_operator_resolution_owner.pgy";
import "ast_body_type_bundle_readiness_owner.pgy";
import "ast_named_value_boundary_verdict_owner.pgy";
import "ast_collection/ast_collection_ownership_verdict_owner.pgy";
import "ast_collection/ast_collection_formal_effect_admission_owner.pgy";
import "ast_owned_string_result_fact_owner.pgy";
import "array_storage_release_verdict_owner.pgy";
import "string_window_extent_owner.pgy";
import "ast_zone_value_carriage_verdict_owner.pgy";
import "ast_zone_spawn_transport_verdict_owner.pgy";
import "ast_subject_value_boundary_owner.pgy";
import "ast_containment_boundary_verdict_owner.pgy";
import "ast_single_owner_handle_verdict_owner.pgy";
import "ast_match_coverage_owner.pgy";
import "ast_body_flow_verdict_owner.pgy";
import "ast_intent_retry_admission_owner.pgy";
import "ast_intent_step_clause_admission_owner.pgy";
import "ast_intent_boundary_predicate_admission_owner.pgy";
import "ast_action_contract_admission_owner.pgy";
import "ast_future_lifecycle_admission_owner.pgy";
import "ast_cancel_admission_owner.pgy";
import "ast_unsafe_block_admission_owner.pgy";
import "ast_enum_payload_variant_provenance_verdict_owner.pgy";
import "ast_capability_fact_owner.pgy";
import "ast_body_type_bundle_schema_owner.pgy";
import "ast_local_name_rule_owner.pgy";
import "ast_bound_party_escape_owner.pgy";
import "ast_body_collection_ownership_stage_owner.pgy";
import "ast_owned_string_store_landing_plan_owner.pgy";
import "ast_body_type_stage_observer_owner.pgy";
import "ast_body_base_verdict_owner.pgy";
import "ast_body_post_ownership_verdict_owner.pgy";
func SemanticAstBodyTypeBundleFromAdmittedAnalysisObservedWithIdentityPolicy(
    artifact: AstTreeArtifact, inout analysis: SemanticAstArtifactAnalysis, observe_pressure: Bool,
    require_carried_expression_identities: Bool, require_enum_payload_variant_proof: Bool,
    require_source_body_flow: Bool
) -> SemanticAstBodyTypeBundle {
    if !SemanticAstBodyAnalysisAdmissionReady(artifact, analysis) {
        return SemanticAstBodyTypeBundleAdmissionError(
            artifact, "semantic body analysis admission is missing or stale");
    }
    let function_tables: SemanticAstExpressionFunctionTableFacts = analysis.function_tables;
    SemanticAstBodyTypeStage(observe_pressure, "base-initializer:start");
    let base_initializer_types: SemanticAstInitializerTypeFacts =
        SemanticAstInitializerTypeFactsFromAdmittedArtifactObservedWithFunctionTables(
            artifact, analysis.signatures, analysis.constructors,
            analysis.local_bindings, analysis.statements, analysis.expression_surfaces,
            analysis.enums, analysis.function_scopes, observe_pressure, function_tables);
    SemanticAstBodyTypeStage(observe_pressure, "base-initializer:done");
    SemanticAstBodyTypeStage(observe_pressure, "iteration:start");
    var iteration_types: SemanticAstIterationTypeFacts =
        SemanticAstIterationTypeFactsFromAdmittedArtifactWithFunctionTables(
            artifact, analysis.signatures, analysis.constructors,
            analysis.local_bindings, base_initializer_types, analysis.statements,
            analysis.expression_surfaces, analysis.enums, analysis.function_scopes, function_tables
        );
    SemanticAstBodyTypeStage(observe_pressure, "iteration:done");
    SemanticAstBodyTypeStage(observe_pressure, "call-targets:start");
    let call_targets_resolved: Bool = SemanticAstAnalysisResolveCallTargetsFromAdmittedBody(
            artifact, analysis, base_initializer_types.inferred_type_names,
            iteration_types, function_tables);
    SemanticAstBodyTypeStage(observe_pressure, "call-targets:done");
    SemanticAstBodyTypeStage(observe_pressure, "initializer-refine:start");
    let initializer_types: SemanticAstInitializerTypeFacts =
        SemanticAstInitializerTypeFactsRefinedByIterationsFromAdmittedFactsWithFunctionTables(
            artifact, analysis.signatures, analysis.constructors, analysis.local_bindings, analysis.expression_surfaces,
            analysis.enums, analysis.function_scopes, analysis.statements, base_initializer_types, iteration_types, function_tables);
    SemanticAstBodyTypeStage(observe_pressure, "initializer-refine:done");
    SemanticAstBodyTypeStage(observe_pressure, "role-operators:start");
    let role_operators_resolved: Bool =
        SemanticAstAnalysisResolveRoleOperatorTargetsFromAdmittedBody(
            artifact, analysis, initializer_types.inferred_type_names,
            iteration_types, function_tables);
    SemanticAstBodyTypeStage(observe_pressure, "role-operators:done");
    SemanticAstBodyTypeStage(observe_pressure, "expression-places:start");
    let expression_places_resolved: Bool =
        SemanticAstAnalysisResolveExpressionPlacesFromAdmittedBody(
            artifact, analysis, initializer_types, iteration_types, function_tables);
    SemanticAstBodyTypeStage(observe_pressure, "expression-places:done");
    SemanticAstBodyTypeStage(observe_pressure, "assignment:start");
    let assignment_types: SemanticAstAssignmentTypeFacts = SemanticAstAssignmentTypeFactsFromAdmittedArtifact(
        artifact, analysis.signatures, analysis.constructors, analysis.local_bindings, initializer_types, analysis.statements,
        analysis.expression_surfaces, iteration_types, analysis.assignments, analysis.enums, analysis.function_scopes, function_tables);
    SemanticAstBodyTypeStage(observe_pressure, "assignment:done");
    SemanticAstBodyTypeStage(observe_pressure, "statement:start");
    let statement_types: SemanticAstStatementTypeFacts = SemanticAstStatementTypeFactsFromAdmittedArtifact(
        artifact, analysis.signatures, analysis.constructors, analysis.local_bindings, initializer_types,
        analysis.expression_surfaces, iteration_types, analysis.statements, analysis.enums, analysis.roles, analysis.function_scopes, function_tables);
    SemanticAstBodyTypeStage(observe_pressure, "statement:done");
    let match_materializations: SemanticAstMatchMaterializationFacts =
        SemanticAstMatchMaterializationFactsAttach(artifact, analysis, statement_types);
    let iteration_graph_roots_attached: Bool =
        SemanticAstIterationSyntheticGraphRootsAttach(
            artifact, analysis, iteration_types
        );
    // Boundary admission consumes stable binding identity. Produce that fact
    // before the consumer instead of making the boundary reconstruct formal
    // parameters from their spelling. Local, formal and callable identities
    // now have one owner and one lifetime within this body bundle.
    SemanticAstBodyTypeStage(observe_pressure, "expression-identity:start");
    var resolved_leaf_types: Array<String> = [];
    var numeric_string_allocations: SemanticAstNumericStringAllocationCalls =
        SemanticAstNumericStringAllocationCallsEmpty();
    let call_roots: SemanticCallSpineRoots =
        SemanticCallSpineRootsFromGraph(
            analysis.expression_surfaces.expression_graph
        );
    let expression_identities_resolved: Bool =
        iteration_graph_roots_attached && call_roots.ok &&
        SemanticAstAnalysisResolveExpressionIdentities(
            artifact, analysis, initializer_types.inferred_type_names,
            iteration_types, match_materializations.synthetic_graph_root_ids,
            function_tables, call_roots,
            require_carried_expression_identities,
            resolved_leaf_types, numeric_string_allocations
        ) && numeric_string_allocations.ok;
    SemanticAstBodyTypeStage(observe_pressure, "expression-identity:done");
    SemanticAstBodyTypeStage(observe_pressure, "named-boundary:start");
    var named_boundary: SemanticAstNamedValueBoundaryVerdict =
        SemanticAstNamedValueBoundaryVerdictOk();
    if expression_identities_resolved {
        named_boundary =
            SemanticAstNamedValueBoundaryVerdictFromResolvedFacts(
                artifact, analysis.constructors, analysis.local_bindings,
                initializer_types.inferred_type_names, analysis.signatures,
                analysis.expression_surfaces.expression_graph,
                analysis.expression_surfaces, statement_types
            );
    }
    SemanticAstBodyTypeStage(observe_pressure, "named-boundary:done");
    SemanticAstBodyTypeStage(observe_pressure, "zone-carriage:start");
    let zone_carriage: SemanticAstZoneValueCarriageVerdict =
        SemanticAstZoneCarriageVerdictFromAdmittedFacts(
            artifact, analysis.signatures, analysis.constructors,
            analysis.local_bindings, initializer_types, analysis.assignments,
            assignment_types, analysis.expression_surfaces);
    SemanticAstBodyTypeStage(observe_pressure, "zone-carriage:done");
    SemanticAstBodyTypeStage(observe_pressure, "generic:start");
    let generic_specializations: SemanticAstGenericSpecializationFacts =
        SemanticAstGenericSpecializationFactsFromAdmittedBody(
            artifact, analysis.signatures, analysis.constructors,
            analysis.local_bindings, initializer_types,
            analysis.statements, analysis.expression_surfaces,
            function_tables, analysis.enums, analysis.intent_signatures,
            analysis.intent_transitions, analysis.function_scopes);
    SemanticAstBodyTypeStage(observe_pressure, "generic:done");
    SemanticAstBodyTypeStage(observe_pressure, "verdict:start");
    var verdict: SemanticAstBodyVerdict = SemanticAstBodyVerdictFromFacts(
        initializer_types, iteration_types, assignment_types, statement_types);
    verdict = SemanticAstBodyBaseVerdict(
        artifact, analysis, verdict, statement_types, match_materializations,
        function_tables, named_boundary, zone_carriage,
        generic_specializations, call_targets_resolved,
        role_operators_resolved, expression_places_resolved,
        iteration_graph_roots_attached, expression_identities_resolved,
        require_source_body_flow);
    var exhaustive_match_nodes: Array<Int> = [];
    if verdict.ok {
        verdict = SemanticAstNamedEnumMatchCoverageFromFacts(
            artifact, analysis.enums, analysis.statements, statement_types, exhaustive_match_nodes);
    }
    if verdict.ok {
        verdict = SemanticAstSubjectValueBoundaryFromFacts(
            artifact, analysis.signatures, analysis.constructors,
            analysis.local_bindings, initializer_types, analysis.expression_surfaces);
    }
    // One body-owned projection is shared by admission and downstream readers.
    var owned_string_result_domains: SemanticAstOwnedStringResultFacts = SemanticAstOwnedStringResultFactsEmpty();
    SemanticAstBodyTypeStage(observe_pressure, "owned-string-results:start");
    if verdict.ok {
        owned_string_result_domains = SemanticAstOwnedStringResultFactsFromResolvedFacts(
            artifact, analysis.signatures, analysis.constructors, analysis.local_bindings, initializer_types,
            analysis.expression_surfaces, numeric_string_allocations, call_roots, analysis.statements,
            analysis.assignments, assignment_types);
        if !SemanticAstOwnedStringResultFactsReady(owned_string_result_domains, analysis.signatures) {
            verdict = SemanticAstBodyVerdictError("ast_artifact_invalid",
                SemanticError1("ast_artifact_invalid", "owner", "SemanticAstOwnedStringResultFacts"), -1);
        }
    }
    SemanticAstBodyTypeStage(observe_pressure, "owned-string-results:done");
    var owned_literal_facts: SemanticAstOwnedStringLiteralOwnershipFacts =
        SemanticAstOwnedStringLiteralOwnershipFactsEmpty();
    if verdict.ok {
        owned_literal_facts =
            SemanticAstOwnedStringLiteralOwnershipFactsFromResolvedFacts(
                artifact, analysis.signatures, analysis.local_bindings,
                initializer_types, analysis.expression_surfaces,
                owned_string_result_domains, numeric_string_allocations);
        if !SemanticAstOwnedStringLiteralOwnershipFactsReady(
                owned_literal_facts, analysis.local_bindings) {
            verdict = SemanticAstBodyVerdictError(
                "ast_artifact_invalid",
                SemanticError1("ast_artifact_invalid", "owner",
                    "owned_string_literal_ownership"), -1);
        }
    }
    var owned_string_store_clone_nodes: Array<Int> = [];
    var owned_string_store_nodes: Array<Int> = [];
    let no_collection_formal_effects:
        SemanticAstCollectionFormalEffects =
        SemanticAstCollectionFormalEffectsEmpty();
    if verdict.ok && !SemanticAstOwnedStringStoreLandingPlanSelect(
            artifact, analysis.signatures, analysis.local_bindings,
            initializer_types, analysis.expression_surfaces,
            analysis.statements, analysis.assignments,
            owned_string_result_domains, numeric_string_allocations,
            owned_literal_facts,
            no_collection_formal_effects,
            owned_string_store_clone_nodes,
            owned_string_store_nodes) {
        verdict = SemanticAstBodyVerdictError(
            "ast_artifact_invalid",
            SemanticError1("ast_artifact_invalid", "owner",
                "owned_string_store_landing_plan"), -1);
    }
    // Formal effects are a body-owned projection. Collection admission and
    // downstream identity checks consume this same result; neither rescans the
    // whole expression graph to reconstruct it.
    var collection_formal_effects: SemanticAstCollectionFormalEffects =
        SemanticAstCollectionFormalEffectsEmpty();
    let occurrence_order: SemanticExpressionGraphSurfaceOrder = SemanticExpressionGraphSurfaceOrderFromFacts(
        analysis.expression_surfaces, iteration_types.synthetic_graph_root_ids, match_materializations.synthetic_graph_root_ids);
    SemanticAstBodyTypeStage(observe_pressure, "collection-formal-effects:start");
    if verdict.ok {
        collection_formal_effects =
            SemanticAstCollectionFormalEffectsWithSurfaceOrderAndOwnedStoreLandings(
                artifact, analysis.signatures, analysis.function_scopes,
                analysis.local_bindings, initializer_types,
                analysis.expression_surfaces, analysis.statements,
                owned_string_result_domains,
                owned_string_store_nodes, occurrence_order);
    }
    if verdict.ok && !SemanticAstOwnedStringStoreLandingPlanSelect(
            artifact, analysis.signatures, analysis.local_bindings,
            initializer_types, analysis.expression_surfaces,
            analysis.statements, analysis.assignments,
            owned_string_result_domains, numeric_string_allocations,
            owned_literal_facts,
            collection_formal_effects, owned_string_store_clone_nodes,
            owned_string_store_nodes) {
        verdict = SemanticAstBodyVerdictError(
            "ast_artifact_invalid",
            SemanticError1("ast_artifact_invalid", "owner",
                "owned_string_store_caller_landing_plan"), -1);
    }
    SemanticAstBodyTypeStage(observe_pressure, "collection-formal-effects:done");
    var body_termination: SemanticAstBodyTerminationFacts =
        SemanticAstBodyTerminationFactsEmpty();
    if verdict.ok {
        body_termination = SemanticAstBodyTerminationFactsFromFacts(
            artifact, analysis.signatures, analysis.statements,
            statement_types, analysis.expression_surfaces,
            exhaustive_match_nodes);
        if !SemanticAstBodyTerminationFactsReady(
                artifact, analysis.signatures, body_termination) {
            verdict = SemanticAstBodyVerdictError(
                "ast_artifact_invalid",
                SemanticError1("ast_artifact_invalid", "owner",
                    "body_termination_facts"), -1);
        }
    }
    var collection_ownership: SemanticAstCollectionOwnershipVerdict = SemanticAstCollectionOwnershipVerdictOk();
    var collection_focus_recovery: SemanticAstCollectionFocusRecoveryFacts = SemanticAstCollectionFocusRecoveryFactsEmpty();
    SemanticAstBodyTypeStage(observe_pressure, "collection-ownership:start");
    SemanticAstBodyCollectionOwnershipStage(artifact, analysis, initializer_types, resolved_leaf_types,
        numeric_string_allocations, call_roots, owned_string_result_domains, assignment_types,
        collection_formal_effects, owned_literal_facts,
        owned_string_store_clone_nodes,
        owned_string_store_nodes,
        body_termination,
        verdict, collection_ownership, collection_focus_recovery);
    SemanticAstBodyTypeStage(observe_pressure, "collection-ownership:done");
    verdict = SemanticAstBodyPostOwnershipPreVerdictFromFacts(
        artifact, analysis, verdict, initializer_types, assignment_types,
        statement_types, resolved_leaf_types, generic_specializations,
        call_roots, exhaustive_match_nodes, occurrence_order,
        require_source_body_flow);
    if verdict.ok {
        verdict = SemanticAstCancelAdmissionFromFacts(
            artifact, analysis, initializer_types, iteration_types,
            function_tables);
    }
    if verdict.ok {
        verdict = SemanticAstUnsafeBlockAdmissionFromStatements(
            artifact, analysis.statements);
    }
    if verdict.ok {
        verdict = SemanticAstFutureLifecycleAdmissionFromFacts(
            artifact, analysis.signatures, analysis.constructors,
            analysis.local_bindings, initializer_types,
            analysis.expression_surfaces, analysis.enums,
            exhaustive_match_nodes);
    }
    verdict = SemanticAstBodySourceBoundaryVerdictFromFacts(
        artifact, analysis, verdict, initializer_types, statement_types,
        resolved_leaf_types, exhaustive_match_nodes,
        require_source_body_flow, require_enum_payload_variant_proof,
        observe_pressure);
    let capability_verdict: SemanticAstBodyCapabilityVerdict =
        SemanticAstBodyCapabilityVerdictFromFacts(
            artifact, analysis, verdict, iteration_types,
            match_materializations, observe_pressure);
    verdict = capability_verdict.verdict;
    let capabilities: SemanticAstCapabilityFacts =
        capability_verdict.capabilities;
    SemanticAstBodyTypeStage(observe_pressure, "verdict:done");
    return SemanticAstBodyTypeBundle(verdict,
        initializer_types, iteration_types, assignment_types, statement_types, match_materializations,
        collection_formal_effects,
        collection_ownership, collection_focus_recovery,
        zone_carriage, generic_specializations, capabilities, numeric_string_allocations, owned_string_result_domains);
}
