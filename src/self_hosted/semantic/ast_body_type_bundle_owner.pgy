// Canonical semantic assembly of body-level type facts.
//
// Driver and codegen consume this bundle. Neither may independently rebuild
// initializer, iteration, assignment, or statement type rows.

import "ast_artifact_verdict_owner.pgy";
import "ast_body_verdict_owner.pgy";
import "ast_body_call_target_resolution_owner.pgy";
import "ast_generic_specialization_fact_owner.pgy";

struct SemanticAstBodyTypeBundle {
    verdict: SemanticAstBodyVerdict;
    initializer_types: SemanticAstInitializerTypeFacts;
    iteration_types: SemanticAstIterationTypeFacts;
    assignment_types: SemanticAstAssignmentTypeFacts;
    statement_types: SemanticAstStatementTypeFacts;
    generic_specializations: SemanticAstGenericSpecializationFacts;
}

func SemanticAstBodyTypeBundleFromAnalysis(
    artifact: AstTreeArtifact,
    inout analysis: SemanticAstArtifactAnalysis
) -> SemanticAstBodyTypeBundle {
    let initializer_types: SemanticAstInitializerTypeFacts =
        SemanticAstInitializerTypeFactsFromArtifact(
            artifact, analysis.signatures, analysis.constructors,
            analysis.local_bindings, analysis.expression_surfaces
        );
    let call_targets_resolved: Bool =
        SemanticAstAnalysisResolveCallTargetsFromBody(
            artifact, analysis, initializer_types.inferred_type_names
        );
    let iteration_types: SemanticAstIterationTypeFacts =
        SemanticAstIterationTypeFactsFromArtifact(
            artifact, analysis.signatures, analysis.constructors,
            analysis.local_bindings, initializer_types, analysis.statements,
            analysis.expression_surfaces
        );
    let assignment_types: SemanticAstAssignmentTypeFacts =
        SemanticAstAssignmentTypeFactsFromArtifact(
            artifact, analysis.signatures, analysis.constructors,
            analysis.local_bindings, initializer_types, analysis.statements,
            analysis.expression_surfaces, iteration_types,
            analysis.assignments
        );
    let statement_types: SemanticAstStatementTypeFacts =
        SemanticAstStatementTypeFactsFromArtifact(
            artifact, analysis.signatures, analysis.constructors,
            analysis.local_bindings, initializer_types,
            analysis.expression_surfaces, iteration_types,
            analysis.statements
        );
    let generic_specializations: SemanticAstGenericSpecializationFacts =
        SemanticAstGenericSpecializationFactsFromBody(
            artifact, analysis.signatures, analysis.constructors,
            analysis.local_bindings, initializer_types,
            analysis.expression_surfaces
        );
    let verdict: SemanticAstBodyVerdict = SemanticAstBodyVerdictFromFacts(
        initializer_types, iteration_types, assignment_types,
        statement_types
    );
    if verdict.ok && !call_targets_resolved {
        verdict = SemanticAstBodyVerdictError(
            "call_target_unresolved",
            "semantic call target rows are incomplete after body fixpoint",
            -1
        );
    } else if verdict.ok && !generic_specializations.ok {
        verdict = SemanticAstBodyVerdictError(
            generic_specializations.diagnostic_code,
            generic_specializations.diagnostic_message, -1
        );
    }
    return SemanticAstBodyTypeBundle(
        verdict,
        initializer_types, iteration_types, assignment_types, statement_types,
        generic_specializations
    );
}

func SemanticAstBodyTypeBundleReady(
    artifact: AstTreeArtifact,
    ref analysis: SemanticAstArtifactAnalysis,
    ref bundle: SemanticAstBodyTypeBundle
) -> Bool {
    return SemanticAstBodyTypeBundleReadinessError(
        artifact, analysis, bundle
    ) == "";
}

func SemanticAstBodyTypeBundleReadinessError(
    artifact: AstTreeArtifact,
    ref analysis: SemanticAstArtifactAnalysis,
    ref bundle: SemanticAstBodyTypeBundle
) -> String {
    if !analysis.verdict.ok {
        return Concat(
            "analysis_verdict:", Concat(
                analysis.verdict.diagnostic_code,
                Concat(":", analysis.verdict.diagnostic_message)
            )
        );
    }
    if !bundle.verdict.ok {
        return Concat(
            "bundle_verdict:", Concat(
                bundle.verdict.diagnostic_code,
                Concat(":node=", Concat(
                    ToString(bundle.verdict.first_node_id),
                    Concat(":", bundle.verdict.diagnostic_message)
                ))
            )
        );
    }
    if !SemanticAstExpressionSurfaceBorrowReady(
        artifact, analysis.expression_surfaces
    ) { return "expression_surface_borrow"; }
    if !SemanticExpressionGraphCarriedCallTargetsReady(
        analysis.expression_surfaces.expression_graph
    ) { return "call_target_rows"; }
    if !bundle.initializer_types.ok { return "initializer_types"; }
    if !bundle.iteration_types.ok { return "iteration_types"; }
    if !bundle.assignment_types.ok { return "assignment_types"; }
    if !bundle.statement_types.ok { return "statement_types"; }
    if !SemanticAstGenericSpecializationFactsReady(
        bundle.generic_specializations
    ) { return "generic_specializations"; }
    if bundle.initializer_types.artifact_node_count != artifact.count {
        return "initializer_node_count";
    }
    if bundle.iteration_types.artifact_node_count != artifact.count {
        return "iteration_node_count";
    }
    if bundle.assignment_types.artifact_node_count != artifact.count {
        return "assignment_node_count";
    }
    if bundle.statement_types.artifact_node_count != artifact.count {
        return "statement_node_count";
    }
    return "";
}

func SemanticAstBodyTypeBundleContractError() -> String {
    let artifact: AstTreeArtifact = AstTreeArtifactFromText(
        "Program:\n  Class: Box\n    Fields:\n      value: Int\n    Methods:\n  Function: Main\n    Parameters:\n    Returns: Int\n    Body:\n      Block:\n        Let: x : Int = 1\n        Assign: x = x + 1\n        Return: x\n"
    );
    let analysis: SemanticAstArtifactAnalysis =
        SemanticAstArtifactAnalyzeCompactBridge(artifact, true);
    let bundle: SemanticAstBodyTypeBundle =
        SemanticAstBodyTypeBundleFromAnalysis(artifact, analysis);
    return SemanticAstBodyTypeBundleReadinessError(
        artifact, analysis, bundle
    );
}

func SemanticAstBodyTypeBundleContractReady() -> Bool {
    return SemanticAstBodyTypeBundleContractError() == "";
}
