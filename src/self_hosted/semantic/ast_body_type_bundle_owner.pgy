// Public body-type bundle entrypoints over the one graph-wide assembly owner.
import "ast_body_type_bundle_assembly_owner.pgy";

func SemanticAstBodyTypeBundleFromAdmittedAnalysisObserved(artifact: AstTreeArtifact,
    inout analysis: SemanticAstArtifactAnalysis, observe_pressure: Bool
) -> SemanticAstBodyTypeBundle {
    return SemanticAstBodyTypeBundleFromAdmittedAnalysisObservedWithIdentityPolicy(
        artifact, analysis, observe_pressure, false, true, true);
}
func SemanticAstBodyTypeBundleFromAnalysisObserved(artifact: AstTreeArtifact,
    inout analysis: SemanticAstArtifactAnalysis, observe_pressure: Bool
) -> SemanticAstBodyTypeBundle {
    if !SemanticAstArtifactAnalysisMatches(artifact, analysis, analysis.verdict.requires_entrypoint
    ) {
        return SemanticAstBodyTypeBundleAdmissionError(
            artifact, "semantic body analysis deep proof failed");
    }
    return SemanticAstBodyTypeBundleFromAdmittedAnalysisObserved(
        artifact, analysis, observe_pressure);
}
func SemanticAstBodyTypeBundleFromAdmittedAnalysis(artifact: AstTreeArtifact,
    inout analysis: SemanticAstArtifactAnalysis) -> SemanticAstBodyTypeBundle {
    return SemanticAstBodyTypeBundleFromAdmittedAnalysisObserved(artifact, analysis, false);
}
func SemanticAstBodyTypeBundleFromAnalysis(artifact: AstTreeArtifact,
    inout analysis: SemanticAstArtifactAnalysis) -> SemanticAstBodyTypeBundle {
    return SemanticAstBodyTypeBundleFromAnalysisObserved(artifact, analysis, false);
}
func SemanticAstBodyTypeBundleReady(artifact: AstTreeArtifact,
    ref analysis: SemanticAstArtifactAnalysis, ref bundle: SemanticAstBodyTypeBundle) -> Bool {
    return SemanticAstBodyTypeBundleReadinessError(
        artifact, analysis, bundle
    ) == "";
}
