// Resolved builtin-call identity joined to the canonical retention registry.
// A source spelling alone never issues a row. The expression identity resolver
// records only selected, direct builtin calls after their identities are sealed.
import "ast_collection_ownership_identity_owner.pgy";
import "ast_builtin_argument_retention_call_fact_validation_owner.pgy";
import "ast_expression_call_identity_owner.pgy";
import "ast_expression_function_table_fact_owner.pgy";
import "builtin_argument_retention_projection_owner.pgy";
import "builtin_shadow_owner.pgy";
import "builtin_signature_owner.pgy";
func SemanticAstBuiltinArgumentRetentionSelectionFromFacts(
    signatures: SemanticAstFunctionSignatureFacts,
    function_tables: SemanticAstExpressionFunctionTableFacts
) -> Int {
    if !signatures.ok ||
        !SemanticAstExpressionFunctionTableFactsReady(function_tables) ||
        !SemanticBuiltinArgumentRetentionProjectionReady() { return -1; }
    let selected_mask: Int = 0;
    let selected_bit: Int = 1;
    let retention_row: Int = 0;
    while retention_row < SemanticBuiltinArgumentRetentionCount() {
        let retention: SemanticBuiltinArgumentRetentionRow =
            SemanticBuiltinArgumentRetentionRowAt(retention_row);
        if !retention.valid || retention.source_name == "" ||
            retention.builtin_identity == "" { return -1; }
        if SemanticBuiltinSignatureSelectedForProgram(
                signatures, retention.source_name) &&
            SemanticBuiltinRetentionSourceSignatureKnown(retention.source_name) {
            let matches: Int = 0;
            let table_row: Int = 0;
            while table_row < ArrayLength(function_tables.names) {
                if function_tables.names[table_row] == retention.source_name {
                    if !SemanticBuiltinRetentionSourceSignatureMatches(
                            retention.source_name,
                            function_tables.returns[table_row],
                            function_tables.params[table_row]) { return -1; }
                    matches = matches + 1;
                }
                table_row = table_row + 1;
            }
            if matches != 1 { return -1; }
            selected_mask = selected_mask + selected_bit;
        }
        retention_row = retention_row + 1;
        selected_bit = selected_bit * 2;
    }
    return selected_mask;
}

func SemanticAstBuiltinArgumentRetentionRecordResolvedCall(
    selected_mask: Int,
    inout graph: SemanticExpressionGraphFacts,
    owner_node_id: Int, lane: Int, local_call_ordinal: Int,
    call_node: Int
) -> Bool {
    let name: Option<String> =
        SemanticExpressionGraphCallTargetName(graph, call_node);
    if !IsSome(name) { return true; }
    if selected_mask < 0 { return false; }
    let retention_row: Int = -1;
    let selected: Int = 0;
    let selected_bit: Int = 1;
    while selected < SemanticBuiltinArgumentRetentionCount() {
        let candidate: SemanticBuiltinArgumentRetentionRow =
            SemanticBuiltinArgumentRetentionRowAt(selected);
        if !candidate.valid { return false; }
        if (selected_mask / selected_bit) % 2 == 1 &&
            candidate.source_name == UnwrapOption(name) {
            if retention_row >= 0 { return false; }
            retention_row = selected;
        }
        selected = selected + 1;
        selected_bit = selected_bit * 2;
    }
    if retention_row < 0 ||
        !SemanticAstCollectionOwnershipBuiltinCall(
            graph, call_node, UnwrapOption(name)) { return true; }
    if owner_node_id < 0 || lane < AstExpressionLaneAtom() ||
        lane > AstExpressionLaneAuxiliary() || local_call_ordinal < 0 {
        return false;
    }
    let existing: Int = 0;
    while existing < ArrayLength(graph.arena.identities.builtin_argument_retention_calls) &&
        graph.arena.identities.builtin_argument_retention_calls[existing]
            .call_node < call_node {
        existing = existing + 1;
    }
    if existing < ArrayLength(graph.arena.identities.builtin_argument_retention_calls) &&
        graph.arena.identities.builtin_argument_retention_calls[existing]
            .call_node == call_node {
        return graph.arena.identities.builtin_argument_retention_calls[existing]
                .owner_node_id == owner_node_id &&
            graph.arena.identities.builtin_argument_retention_calls[existing].lane == lane &&
            graph.arena.identities.builtin_argument_retention_calls[existing]
                .local_call_ordinal == local_call_ordinal &&
            graph.arena.identities.builtin_argument_retention_calls[existing]
                .retention_row == retention_row;
    }
    if existing != ArrayLength(graph.arena.identities.builtin_argument_retention_calls) { return false; }
    ArrayPush(
        graph.arena.identities.builtin_argument_retention_calls,
        SemanticAstBuiltinArgumentRetentionCallFact(
            call_node, owner_node_id, lane, local_call_ordinal,
            retention_row));
    return true;
}

// The owning consumer must validate CallFactsReady once before repeated use.
func SemanticAstBuiltinArgumentRetentionIdentityForReadyCallFacts(
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    call_node: Int
) -> Option<String> {
    let low: Int = 0;
    let high: Int = ArrayLength(surfaces.expression_graph.arena.identities.builtin_argument_retention_calls);
    while low < high {
        let middle: Int = low + (high - low) / 2;
        if surfaces.expression_graph.arena.identities.builtin_argument_retention_calls[middle]
                .call_node < call_node { low = middle + 1; }
        else { high = middle; }
    }
    if low >= ArrayLength(surfaces.expression_graph.arena.identities.builtin_argument_retention_calls) ||
        surfaces.expression_graph.arena.identities
            .builtin_argument_retention_calls[low].call_node != call_node {
        return None;
    }
    let retention: SemanticBuiltinArgumentRetentionRow =
        SemanticBuiltinArgumentRetentionRowAt(surfaces.expression_graph.arena.identities
            .builtin_argument_retention_calls[low].retention_row);
    let identity: SemanticExpressionCallIdentity =
        SemanticExpressionCallIdentityForNode(surfaces, call_node);
    if !retention.valid ||
        !SemanticBuiltinRetentionSourceSignatureKnown(retention.source_name) ||
        !identity.ok ||
        !SemanticAstCollectionOwnershipBuiltinCall(
            surfaces.expression_graph, call_node, retention.source_name) ||
        !SemanticExpressionCallIdentityEqual(
            surfaces.expression_graph.arena.identities.builtin_argument_retention_calls[low]
                .owner_node_id,
            surfaces.expression_graph.arena.identities.builtin_argument_retention_calls[low].lane,
            surfaces.expression_graph.arena.identities.builtin_argument_retention_calls[low]
                .local_call_ordinal,
            identity.owner_node_id, identity.lane,
            identity.local_call_ordinal) { return None; }
    return Some(retention.builtin_identity);
}

func SemanticAstBuiltinArgumentRetentionIdentityForCall(
    ref surfaces: SemanticAstExpressionSurfaceFacts, call_node: Int
) -> Option<String> {
    if !SemanticAstBuiltinArgumentRetentionCallFactsReady(surfaces) { return None; }
    return SemanticAstBuiltinArgumentRetentionIdentityForReadyCallFacts(
        surfaces, call_node);
}
