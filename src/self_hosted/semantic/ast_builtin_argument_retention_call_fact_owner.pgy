// Resolved builtin-call identity joined to the canonical retention registry.
// A source spelling alone never issues a row. The expression identity resolver
// records only selected, direct builtin calls after their identities are sealed.

import "ast_collection_ownership_identity_owner.pgy";
import "ast_expression_call_identity_owner.pgy";
import "ast_expression_function_table_fact_owner.pgy";
import "builtin_argument_retention_projection_owner.pgy";
import "builtin_shadow_owner.pgy";

struct SemanticAstBuiltinArgumentRetentionSelection {
    ok: Bool;
    identity_by_source_name: HashMap<String, String>;
}

struct SemanticAstBuiltinArgumentRetentionCallFacts {
    ok: Bool;
    call_nodes: Array<Int>;
    owner_node_ids: Array<Int>;
    lanes: Array<Int>;
    local_call_ordinals: Array<Int>;
    builtin_identities: Array<String>;
}

func SemanticAstBuiltinArgumentRetentionCallFactsEmpty(
) -> SemanticAstBuiltinArgumentRetentionCallFacts {
    return SemanticAstBuiltinArgumentRetentionCallFacts(
        false, [], [], [], [], []);
}

func SemanticAstBuiltinArgumentRetentionCanonicalSignatureIndex(
    rows: Array<String>, source_name: String
) -> Int {
    let found: Int = -1;
    let row: Int = 0;
    while row < ArrayLength(rows) {
        let parts: Array<String> = Split(rows[row], "^");
        if ArrayLength(parts) != 3 { return -2; }
        if parts[0] == source_name {
            if found >= 0 { return -2; }
            found = row;
        }
        row = row + 1;
    }
    return found;
}

func SemanticAstBuiltinArgumentRetentionSelectionFromFacts(
    signatures: SemanticAstFunctionSignatureFacts,
    function_tables: SemanticAstExpressionFunctionTableFacts
) -> SemanticAstBuiltinArgumentRetentionSelection {
    let selected: HashMap<String, String> = MapNew();
    if !signatures.ok ||
        !SemanticAstExpressionFunctionTableFactsReady(function_tables) ||
        !SemanticBuiltinArgumentRetentionProjectionReady() {
        return SemanticAstBuiltinArgumentRetentionSelection(false, selected);
    }
    let signature_rows: Array<String> = SemanticBuiltinSignatureRows();
    let retention_row: Int = 0;
    while retention_row < SemanticBuiltinArgumentRetentionCount() {
        let retention: SemanticBuiltinArgumentRetentionRow =
            SemanticBuiltinArgumentRetentionRowAt(retention_row);
        if !retention.valid || retention.source_name == "" ||
            retention.builtin_identity == "" {
            return SemanticAstBuiltinArgumentRetentionSelection(false, selected);
        }
        let signature_row: Int =
            SemanticAstBuiltinArgumentRetentionCanonicalSignatureIndex(
                signature_rows, retention.source_name);
        if signature_row == -2 {
            return SemanticAstBuiltinArgumentRetentionSelection(false, selected);
        }
        if signature_row >= 0 &&
            SemanticBuiltinSignatureSelectedForProgram(
                signatures, retention.source_name) {
            let parts: Array<String> = Split(signature_rows[signature_row], "^");
            let expected_params: String = parts[2];
            if expected_params == "none" { expected_params = ""; }
            let matches: Int = 0;
            let table_row: Int = 0;
            while table_row < ArrayLength(function_tables.names) {
                if function_tables.names[table_row] == retention.source_name {
                    if function_tables.returns[table_row] != parts[1] ||
                        function_tables.params[table_row] != expected_params {
                        return SemanticAstBuiltinArgumentRetentionSelection(
                            false, selected);
                    }
                    matches = matches + 1;
                }
                table_row = table_row + 1;
            }
            if matches != 1 || MapHas(selected, retention.source_name) {
                return SemanticAstBuiltinArgumentRetentionSelection(false, selected);
            }
            MapSet(selected, retention.source_name,
                retention.builtin_identity);
        }
        retention_row = retention_row + 1;
    }
    return SemanticAstBuiltinArgumentRetentionSelection(true, selected);
}

func SemanticAstBuiltinArgumentRetentionCallFactsReady(
    ref facts: SemanticAstBuiltinArgumentRetentionCallFacts
) -> Bool {
    let count: Int = ArrayLength(facts.call_nodes);
    if !facts.ok || ArrayLength(facts.owner_node_ids) != count ||
        ArrayLength(facts.lanes) != count ||
        ArrayLength(facts.local_call_ordinals) != count ||
        ArrayLength(facts.builtin_identities) != count {
        return false;
    }
    let row: Int = 0;
    while row < count {
        if facts.call_nodes[row] < 0 || facts.owner_node_ids[row] < 0 ||
            facts.lanes[row] < AstExpressionLaneAtom() ||
            facts.lanes[row] > AstExpressionLaneAuxiliary() ||
            facts.local_call_ordinals[row] < 0 ||
            !IsSome(SemanticBuiltinArgumentRetentionSourceNameForIdentity(
                facts.builtin_identities[row])) ||
            (row > 0 && facts.call_nodes[row - 1] >= facts.call_nodes[row]) {
            return false;
        }
        row = row + 1;
    }
    return true;
}

func SemanticAstBuiltinArgumentRetentionRecordResolvedCall(
    inout facts: SemanticAstBuiltinArgumentRetentionCallFacts,
    selection: SemanticAstBuiltinArgumentRetentionSelection,
    ref graph: SemanticExpressionGraphFacts,
    owner_node_id: Int, lane: Int, local_call_ordinal: Int,
    call_node: Int
) -> Bool {
    if !selection.ok { return false; }
    let name: Option<String> =
        SemanticExpressionGraphCallTargetName(graph, call_node);
    if !IsSome(name) ||
        !MapHas(selection.identity_by_source_name, UnwrapOption(name)) ||
        !SemanticAstCollectionOwnershipBuiltinCall(
            graph, call_node, UnwrapOption(name)) {
        return true;
    }
    if owner_node_id < 0 || lane < AstExpressionLaneAtom() ||
        lane > AstExpressionLaneAuxiliary() || local_call_ordinal < 0 ||
        (ArrayLength(facts.call_nodes) > 0 &&
         facts.call_nodes[ArrayLength(facts.call_nodes) - 1] >= call_node) {
        return false;
    }
    ArrayPush(facts.call_nodes, call_node);
    ArrayPush(facts.owner_node_ids, owner_node_id);
    ArrayPush(facts.lanes, lane);
    ArrayPush(facts.local_call_ordinals, local_call_ordinal);
    ArrayPushOwnedString(facts.builtin_identities,
        MapGet(selection.identity_by_source_name, UnwrapOption(name)));
    return true;
}

func SemanticAstBuiltinArgumentRetentionIdentityForCall(
    ref facts: SemanticAstBuiltinArgumentRetentionCallFacts,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    call_node: Int
) -> Option<String> {
    if !SemanticAstBuiltinArgumentRetentionCallFactsReady(facts) {
        return None;
    }
    let low: Int = 0;
    let high: Int = ArrayLength(facts.call_nodes);
    while low < high {
        let middle: Int = low + (high - low) / 2;
        if facts.call_nodes[middle] < call_node { low = middle + 1; }
        else { high = middle; }
    }
    if low >= ArrayLength(facts.call_nodes) ||
        facts.call_nodes[low] != call_node { return None; }
    let source_name: Option<String> =
        SemanticBuiltinArgumentRetentionSourceNameForIdentity(
            facts.builtin_identities[low]);
    let identity: SemanticExpressionCallIdentity =
        SemanticExpressionCallIdentityForNode(surfaces, call_node);
    if !IsSome(source_name) || !identity.ok ||
        !SemanticAstCollectionOwnershipBuiltinCall(
            surfaces.expression_graph, call_node,
            UnwrapOption(source_name)) ||
        !SemanticExpressionCallIdentityEqual(
            facts.owner_node_ids[low], facts.lanes[low],
            facts.local_call_ordinals[low], identity.owner_node_id,
            identity.lane, identity.local_call_ordinal) {
        return None;
    }
    return Some(facts.builtin_identities[low]);
}
