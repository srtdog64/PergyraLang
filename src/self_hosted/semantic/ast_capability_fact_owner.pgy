// Program and callable capability facts derived from admitted expression-call
// identities. This owner is the self-host equivalent of the native semantic
// capability accumulator; renderers consume its masks and never rescan names.

import "ast_artifact_verdict_owner.pgy";
import "ast_body_verdict_owner.pgy";
import "ast_match_materialization_fact_owner.pgy";
import "ast_capability_instantiation_owner.pgy";
import "ast_expression_graph_node_view_owner.pgy";
import "ast_expression_call_target_fact_owner.pgy";
import "callable_resolution_owner.pgy";
import "builtin_capability_projection_owner.pgy";
import "capability_mask_owner.pgy";
import "../lib/callable_contract_vocabulary_projection_owner.pgy";

struct SemanticAstCapabilityFacts {
    ok: Bool;
    contract_ok: Bool;
    diagnostic_code: String;
    diagnostic_message: String;
    first_node_id: Int;
    artifact_node_count: Int;
    artifact_identity_digest: Int;
    program_used_mask: Int;
    callable_node_ids: Array<Int>;
    declared_masks: Array<Int>;
    used_masks: Array<Int>;
    exported_masks: Array<Int>;
    // Known masks do not claim purity for unsaturated callable templates.
    deferred_uses: Array<Bool>;
    instantiation_count: Int;
    instantiation_reuses: Int;
    // Callable effects include owned statements and calls; still a lower bound.
    declared_effects: Array<Int>;
    known_call_effects: Array<Int>;
    unknown_call_effects: Array<Bool>;
}

func SemanticAstCapabilityFactsError(
    artifact: AstTreeArtifact, message: String
) -> SemanticAstCapabilityFacts {
    let empty: Array<Int> = [];
    let deferred: Array<Bool> = [];
    return SemanticAstCapabilityFacts(
        false, false, "capability_fact_invalid", message, -1,
        artifact.count, artifact.identity_digest, 0, empty, empty, empty, empty, deferred, 0, 0,
        empty, empty, deferred);
}

func SemanticAstCapabilityFactsFromAdmittedBody(
    artifact: AstTreeArtifact,
    ref analysis: SemanticAstArtifactAnalysis,
    ref verdict: SemanticAstBodyVerdict,
    ref iterations: SemanticAstIterationTypeFacts,
    ref matches: SemanticAstMatchMaterializationFacts
) -> SemanticAstCapabilityFacts {
    let function_count: Int = SemanticAstFunctionSignatureCount(analysis.signatures);
    let callable_count: Int = function_count + SemanticAstIntentSignatureCount(analysis.intent_signatures);
    let state: SemanticAstCapabilityCallGraph = SemanticAstCapabilityCallGraphFromSignatures(artifact, analysis);
    let roots: SemanticCallSpineRoots = SemanticCallSpineRootsFromGraph(analysis.expression_surfaces.expression_graph);
    state.ok = state.ok && verdict.ok && roots.ok &&
        SemanticBuiltinCapabilityProjectionReady() && CallableContractVocabularyProjectionReady();
    // Seed direct statement effects on the same exact callable as call facts.
    let statement: Int = 0;
    while statement < ArrayLength(analysis.statements.node_ids) && state.ok {
        if analysis.statements.kind_tags[statement] == TypedAstKindUnsafeBlockTag() {
            let owner_node: Int = analysis.statements.function_node_ids[statement];
            if owner_node <= 0 || owner_node >= ArrayLength(state.declaration_rows) {
                state.ok = false;
            } else {
                let callable: Int = state.declaration_rows[owner_node];
                let effect: Int = SemanticEffectMaskForWord("unsafe");
                if callable < 0 || callable >= callable_count || effect < 0 {
                    state.ok = false;
                } else {
                    state.direct_effects[callable] = SemanticEffectMaskJoin(state.direct_effects[callable], effect);
                }
            }
        }
        statement = statement + 1;
    }
    let last_root: Int = -1;
    let root_slot: Int = 0;
    while root_slot < ArrayLength(
        analysis.expression_surfaces.expression_graph.roots
    ) && state.ok {
        if analysis.expression_surfaces.expression_graph.has_roots[root_slot] {
            let root: Int =
                analysis.expression_surfaces.expression_graph.roots[root_slot];
            let surface: Int = root_slot / 3;
            if surface < 0 || surface >= ArrayLength(
                analysis.expression_surfaces.function_node_ids
            ) || root <= last_root {
                state.ok = false;
            } else {
                let owner_index: Int = callable_count;
                let owner_node_id: Int =
                    analysis.expression_surfaces.function_node_ids[surface];
                if owner_node_id < 0 {
                    owner_node_id = analysis.expression_surfaces.intent_node_ids[surface];
                }
                if owner_node_id >= 0 {
                    let found: Option<Int> =
                        SemanticAstCapabilityCallableIndexForNode(
                            analysis.signatures, analysis.intent_signatures, owner_node_id
                        );
                    if !IsSome(found) { state.ok = false; }
                    else { owner_index = UnwrapOption(found); }
                }
                if state.ok {
                    SemanticAstCapabilityObserveCallRange(
                        analysis.expression_surfaces.expression_graph,
                        roots, analysis.signatures, last_root + 1, root,
                        owner_index, state
                    );
                }
            }
            last_root = root;
        }
        root_slot = root_slot + 1;
    }
    // The identity owner already admitted these isolated binding tails.
    // They carry no call and must cover exactly the remaining arena nodes.
    let match_row: Int = 0;
    while match_row < ArrayLength(matches.synthetic_graph_root_ids) && state.ok {
        let root: Int = matches.synthetic_graph_root_ids[match_row];
        if root != last_root + 1 ||
            analysis.expression_surfaces.expression_graph.arena.topology.node_kinds[root] != AstExpressionNodeLeaf() {
            state.ok = false;
        }
        last_root = root;
        match_row = match_row + 1;
    }
    let iteration_row: Int = 0;
    while iteration_row < ArrayLength(
        iterations.synthetic_graph_root_ids
    ) && state.ok {
        let root: Int = iterations.synthetic_graph_root_ids[
            iteration_row
        ];
        if root >= 0 {
            if root != last_root + 1 ||
                analysis.expression_surfaces.expression_graph.arena.topology.node_kinds[root] != AstExpressionNodeLeaf() {
                state.ok = false;
            }
            last_root = root;
        }
        iteration_row = iteration_row + 1;
    }
    if last_root + 1 != SemanticExpressionGraphArenaNodeCount(
        analysis.expression_surfaces.expression_graph.arena
    ) {
        state.ok = false;
    }
    if !state.ok {
        return SemanticAstCapabilityFactsError(
            artifact, "semantic capability call inventory is incomplete");
    }
    let instances: SemanticAstCapabilityInstantiations = SemanticAstCapabilityInstantiationsFromGraph(state);
    if !instances.ok {
        return SemanticAstCapabilityFactsError(artifact,
            "semantic capability argument substitution is incomplete");
    }
    let callable_node_ids: Array<Int> = [];
    let declared_masks: Array<Int> = [];
    let used_masks: Array<Int> = [];
    let exported_masks: Array<Int> = [];
    let deferred_uses: Array<Bool> = [];
    let declared_effects: Array<Int> = [];
    let known_call_effects: Array<Int> = [];
    let unknown_call_effects: Array<Bool> = [];
    let callable: Int = 0;
    while callable < callable_count {
        ArrayPush(callable_node_ids, state.callable_node_ids[callable]);
        ArrayPush(declared_masks, state.declared_masks[callable]);
        ArrayPush(used_masks, 0);
        ArrayPush(exported_masks, 0);
        ArrayPush(deferred_uses, false);
        ArrayPush(declared_effects, state.declared_effects[callable]);
        ArrayPush(known_call_effects, 0);
        ArrayPush(unknown_call_effects, false);
        callable = callable + 1;
    }
    let program_used_mask: Int = 0;
    let context: Int = 0;
    while context < ArrayLength(instances.callable_rows) {
        callable = instances.callable_rows[context];
        let used: Int = instances.used_masks[context];
        program_used_mask = SemanticCapabilityMaskJoin(program_used_mask, used);
        if callable < callable_count {
            ArraySet(used_masks, callable, SemanticCapabilityMaskJoin(used_masks[callable], used));
            if instances.deferred[context] { ArraySet(deferred_uses, callable, true); }
            known_call_effects[callable] = SemanticEffectMaskJoin(known_call_effects[callable], instances.used_effects[context]);
            if instances.unknown_effects[context] { unknown_call_effects[callable] = true; }
        }
        context = context + 1;
    }
    callable = 0;
    while callable < callable_count {
        ArraySet(exported_masks, callable, SemanticCapabilityMaskJoin(declared_masks[callable], used_masks[callable]));
        callable = callable + 1;
    }
    let contract_ok: Bool = true;
    let diagnostic: String = "";
    let diagnostic_code: String = "";
    let first_node_id: Int = -1;
    callable = 0;
    while callable < function_count && contract_ok {
        if analysis.signatures.action_contracts.caps_node_ids[callable] >= 0 {
            let missing: Int = SemanticCapabilityMaskDifference(
                used_masks[callable], declared_masks[callable]
            );
            if missing != 0 {
                contract_ok = false;
                diagnostic_code = "declared_capability_missing";
                first_node_id = callable_node_ids[callable];
                diagnostic = Concat(
                    "Function '", Concat(
                        analysis.signatures.names[callable], Concat(
                            "' is missing declared capabilities: ", Concat(
                                SemanticCapabilityMaskNames(missing, false),
                                Concat(" (declared: ", Concat(
                                    SemanticCapabilityMaskNames(
                                        declared_masks[callable], false
                                    ), Concat(", used by body: ", Concat(
                                        SemanticCapabilityMaskNames(
                                            used_masks[callable], false
                                        ), ")"
                                    ))
                                ))
                            )
                        )
                    )
                );
            }
        }
        if contract_ok && analysis.signatures.action_contracts.effects_node_ids[callable] >= 0 {
            let missing_effects: Int = SemanticEffectMaskDifference(known_call_effects[callable], declared_effects[callable]);
            if missing_effects != 0 {
                contract_ok = false;
                diagnostic_code = "declared_effect_missing";
                first_node_id = callable_node_ids[callable];
                diagnostic = "Function '" + analysis.signatures.names[callable] +
                    "' is missing declared effects: " + SemanticEffectMaskNames(missing_effects) +
                    " (declared: " + SemanticEffectMaskNames(declared_effects[callable]) +
                    ", derived from callable body: " + SemanticEffectMaskNames(known_call_effects[callable]) + ")";
            } else if unknown_call_effects[callable] {
                contract_ok = false;
                diagnostic_code = "call_effect_fact_unavailable";
                first_node_id = callable_node_ids[callable];
                diagnostic = "Function '" + analysis.signatures.names[callable] +
                    "' has an unclassified call effect; its declared effect bound cannot be verified";
            }
        }
        callable = callable + 1;
    }
    return SemanticAstCapabilityFacts(
        true, contract_ok, diagnostic_code, diagnostic, first_node_id,
        artifact.count, artifact.identity_digest, program_used_mask,
        callable_node_ids, declared_masks, used_masks, exported_masks,
        deferred_uses, ArrayLength(instances.callable_rows), instances.reuses,
        declared_effects, known_call_effects, unknown_call_effects
    );
}

func SemanticAstCapabilityFactsReady(
    artifact: AstTreeArtifact,
    ref analysis: SemanticAstArtifactAnalysis,
    ref facts: SemanticAstCapabilityFacts
) -> Bool {
    let function_count: Int = SemanticAstFunctionSignatureCount(analysis.signatures);
    let count: Int = function_count + SemanticAstIntentSignatureCount(analysis.intent_signatures);
    if !facts.ok || facts.artifact_node_count != artifact.count ||
        facts.artifact_identity_digest != artifact.identity_digest ||
        facts.program_used_mask < 0 ||
        SemanticCapabilityMaskJoin(0, facts.program_used_mask) != facts.program_used_mask ||
        ArrayLength(facts.callable_node_ids) != count ||
        ArrayLength(facts.declared_masks) != count ||
        ArrayLength(facts.used_masks) != count ||
        ArrayLength(facts.exported_masks) != count ||
        ArrayLength(facts.deferred_uses) != count ||
        ArrayLength(facts.declared_effects) != count ||
        ArrayLength(facts.known_call_effects) != count ||
        ArrayLength(facts.unknown_call_effects) != count ||
        facts.instantiation_count < count + 1 || facts.instantiation_reuses < 0 { return false; }
    let row: Int = 0;
    while row < count {
        let node_id: Int = -1;
        if row < function_count { node_id = analysis.signatures.function_node_ids[row]; }
        else {
            node_id = analysis.intent_signatures.intent_node_ids[row - function_count];
            if facts.declared_masks[row] != 0 { return false; }
        }
        if facts.deferred_uses[row] {
            if row >= function_count { return false; }
            let has_parameter: Bool = false;
            let parameter: Int = 0;
            while parameter < analysis.signatures.param_counts[row] {
                if SemanticAstCallableTypeShapeFromName(
                    analysis.signatures.param_types[analysis.signatures.param_starts[row] + parameter]).ok {
                    has_parameter = true;
                }
                parameter = parameter + 1;
            }
            if !has_parameter { return false; }
        }
        if facts.callable_node_ids[row] != node_id ||
            facts.declared_effects[row] < 0 || facts.known_call_effects[row] < 0 ||
            SemanticEffectMaskClosure(facts.declared_effects[row]) != facts.declared_effects[row] ||
            SemanticEffectMaskClosure(facts.known_call_effects[row]) != facts.known_call_effects[row] ||
            facts.declared_masks[row] < 0 || facts.used_masks[row] < 0 ||
            SemanticCapabilityMaskJoin(0, facts.declared_masks[row]) != facts.declared_masks[row] ||
            SemanticCapabilityMaskJoin(0, facts.used_masks[row]) != facts.used_masks[row] ||
            facts.exported_masks[row] != SemanticCapabilityMaskJoin(
                facts.declared_masks[row], facts.used_masks[row]) { return false; }
        row = row + 1;
    }
    return true;
}
