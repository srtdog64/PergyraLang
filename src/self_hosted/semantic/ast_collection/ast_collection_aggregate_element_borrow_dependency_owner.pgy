// Transfer and mutation dependencies that can keep an aggregate element loan alive.

import "ast_collection_aggregate_release_plan_schema_owner.pgy";
import "ast_collection_aggregate_field_entry_requirement_owner.pgy";
import "ast_collection_aggregate_sink_consumption_owner.pgy";
import "ast_collection_aggregate_value_lineage_owner.pgy";
import "ast_collection_builtin_release_identity_owner.pgy";
import "ast_collection_formal_effect_identity_owner.pgy";
import "ast_collection_exclusive_value_flow_owner.pgy";
import "ast_collection_ownership_member_result_owner.pgy";
import "ast_collection_ownership_member_move_owner.pgy";
import "ast_collection_storage_mutation_owner.pgy";
import "ast_collection_exclusive_compiler_clone_owner.pgy";
import "../ast_string_formal_text_containment_owner.pgy";
import "../ast_expression/ast_expression_surface_fact_owner.pgy";
import "../ast_local_binding_fact_owner.pgy";
import "../ast_local_binding_identity_owner.pgy";

// A scalar lookup does not retain the escape map's container descriptor.
func SemanticAstCollectionAggregateForwardedTransferAt(
    ref plan: SemanticAstCollectionAggregateReleasePlan,
    root: Int, site: Int
) -> Bool {
    if root <= 0 || site <= 0 ||
        ArrayLength(plan.forwarded_transfer_root_ids) !=
            ArrayLength(plan.forwarded_transfer_syntax_ids) {
        return false;
    }
    var matches: Int = 0;
    var row: Int = 0;
    while row < ArrayLength(plan.forwarded_transfer_root_ids) {
        if plan.forwarded_transfer_root_ids[row] == root &&
            plan.forwarded_transfer_syntax_ids[row] == site {
            matches = matches + 1;
        }
        row = row + 1;
    }
    return matches == 1;
}
// A traced aggregate lineage call carries the whole protected value. It is
// not a String element borrow, but only the exact call site on a demand for
// this root may discharge the element-escape projection.
func SemanticAstCollectionAggregateLineageTransferAt(
    ref plan: SemanticAstCollectionAggregateReleasePlan,
    root: Int, site: Int
) -> Bool {
    if root <= 0 || site <= 0 ||
        ArrayLength(plan.call_edge_nodes) !=
            ArrayLength(plan.call_syntax_ids) {
        return false;
    }
    var demand: Int = 0;
    while demand < ArrayLength(plan.aggregate_origin_ids) {
        if plan.aggregate_origin_ids[demand] == root {
            let chain_start: Int = plan.demand_chain_starts[demand];
            var chain_end: Int = ArrayLength(plan.demand_chain_edges);
            if demand + 1 < ArrayLength(plan.demand_chain_starts) {
                chain_end = plan.demand_chain_starts[demand + 1];
            }
            if chain_start < 0 || chain_end < chain_start ||
                chain_end > ArrayLength(plan.demand_chain_edges) {
                return false;
            }
            var chain: Int = chain_start;
            while chain < chain_end {
                var call: Int = 0;
                while call < ArrayLength(plan.call_edge_nodes) {
                    if plan.call_edge_nodes[call] ==
                            plan.demand_chain_edges[chain] &&
                        plan.call_syntax_ids[call] == site {
                        return true;
                    }
                    call = call + 1;
                }
                chain = chain + 1;
            }
            let path_start: Int = plan.demand_invocation_starts[demand];
            var path_end: Int = ArrayLength(plan.demand_invocation_nodes);
            if demand + 1 < ArrayLength(plan.demand_invocation_starts) {
                path_end = plan.demand_invocation_starts[demand + 1];
            }
            if path_start < 0 || path_end < path_start ||
                path_end > ArrayLength(plan.demand_invocation_nodes) {
                return false;
            }
            var path: Int = path_start;
            while path < path_end {
                if SemanticAstCollectionAggregateReleaseCallSyntaxForNode(
                        plan, plan.demand_invocation_nodes[path]) == site {
                    return true;
                }
                path = path + 1;
            }
        }
        demand = demand + 1;
    }
    return false;
}

// A field carrier is the same storage responsibility under a local name.
// Every exact recorded mutation step may invalidate an element borrow;
// unrelated calls with the same type do not qualify.
func SemanticAstCollectionAggregateCarrierTransferAt(
    ref plan: SemanticAstCollectionAggregateReleasePlan,
    root: Int, site: Int
) -> Bool {
    if root <= 0 || site <= 0 ||
        ArrayLength(plan.carrier_local_ids) !=
            ArrayLength(plan.carrier_source_binding_ids) ||
        ArrayLength(plan.carrier_mutation_step_local_ids) !=
            ArrayLength(plan.carrier_mutation_step_edge_nodes) {
        return false;
    }
    var carrier: Int = 0;
    while carrier < ArrayLength(plan.carrier_local_ids) {
        if plan.carrier_local_ids[carrier] == root ||
            plan.carrier_source_binding_ids[carrier] == root {
            var mutation: Int = 0;
            while mutation <
                    ArrayLength(plan.carrier_mutation_step_local_ids) {
                if plan.carrier_mutation_step_local_ids[mutation] ==
                        plan.carrier_local_ids[carrier] {
                    var call: Int = 0;
                    while call < ArrayLength(plan.call_edge_nodes) {
                        if plan.call_edge_nodes[call] ==
                                plan.carrier_mutation_step_edge_nodes[
                                    mutation] &&
                            plan.call_syntax_ids[call] == site {
                            return true;
                        }
                        call = call + 1;
                    }
                }
                mutation = mutation + 1;
            }
        }
        carrier = carrier + 1;
    }
    return false;
}

// Match one whole aggregate or carrier root to the exact call argument that
// can mutate the field supplying a borrowed element. The aggregate field
// entry owner already records exact deep-drop and owned-push paths; this
// consumer only joins that fact to the call row and protected first field.
func SemanticAstCollectionAggregateRootMutationAt(
    artifact: AstTreeArtifact,
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    ref locals: SemanticAstLocalBindingFacts,
    ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref plan: SemanticAstCollectionAggregateReleasePlan,
    ref requirements: SemanticAstCollectionAggregateFieldEntryRequirements,
    formal_effects: HashMap<String, Int>,
    root: Int, source_field: String, site: Int
) -> Bool {
    if root <= 0 || site <= 0 || source_field == "" ||
        !SemanticAstCollectionAggregateReleasePlanShapeReady(plan) ||
        !SemanticAstCollectionAggregateFieldEntryRequirementsReady(
            requirements) {
        return false;
    }
    var call: Int = 0;
    while call < ArrayLength(plan.call_syntax_ids) {
        if plan.call_syntax_ids[call] == site {
            let place: SemanticAstCollectionAggregateSinkPlace =
                SemanticAstCollectionAggregateSinkPlaceForNode(
                    artifact, signatures, locals, inferred_types, surfaces,
                    plan.call_function_ids[call], site,
                    plan.call_argument_nodes[call]);
            var argument_root: Int = 0;
            if place.ok && !place.temporary &&
                ArrayLength(place.chain) == 0 {
                if place.key >= 0 && place.key < ArrayLength(locals.node_ids) {
                    argument_root = locals.node_ids[place.key];
                } else if place.key < 0 {
                    argument_root = 0 - place.key;
                }
            }
            if argument_root == root {
                let formal: SemanticAstCollectionArgumentFormalTarget =
                    SemanticAstCollectionArgumentFormalTargetForArgument(
                        signatures, surfaces.expression_graph,
                        plan.call_nodes[call], plan.call_ordinals[call]);
                let builtin_mutation: Bool = plan.call_ordinals[call] == 0 &&
                    (SemanticAstCollectionStorageMutationKind(
                        surfaces.expression_graph, plan.call_nodes[call]) > 0 ||
                     SemanticAstCollectionBuiltinReleaseArgument(
                        surfaces.expression_graph, plan.call_nodes[call],
                        plan.call_ordinals[call]) ||
                     SemanticAstCollectionOwnershipBuiltinCall(
                        surfaces.expression_graph, plan.call_nodes[call],
                        "ArraySet"));
                var proved_mutation: Bool = false;
                var field_mutation: Bool = false;
                if formal.ok {
                    let formal_key: String = ToString(formal.syntax_id);
                    if MapHas(formal_effects, formal_key) {
                        let effect: Int = MapGet(formal_effects, formal_key);
                        proved_mutation = effect == 2 || effect ==
                            SemanticAstCollectionFormalShallowMutationEffect();
                    }
                    var requirement: Int = 0;
                    while requirement < ArrayLength(requirements.formal_ids) {
                        if requirements.formal_ids[requirement] ==
                                formal.syntax_id &&
                            (SemanticAstCollectionAggregateRequirementHasEffect(
                                requirements.effect_masks[requirement],
                                SemanticAstCollectionAggregateFieldEntryEffectDeepDrop()) ||
                             SemanticAstCollectionAggregateRequirementHasEffect(
                                requirements.effect_masks[requirement],
                                SemanticAstCollectionAggregateFieldEntryEffectOwnedPush())) {
                            let path_start: Int =
                                requirements.path_starts[requirement];
                            let field_id: Int =
                                requirements.path_field_ids[path_start];
                            var field: Int = 0;
                            while field < ArrayLength(
                                    constructors.field_source_syntax_ids) {
                                if constructors.field_source_syntax_ids[field] ==
                                        field_id &&
                                    constructors.field_names[field] ==
                                        source_field {
                                    field_mutation = true;
                                }
                                field = field + 1;
                            }
                        }
                        requirement = requirement + 1;
                    }
                }
                if builtin_mutation || proved_mutation || field_mutation {
                    return true;
                }
            }
        }
        call = call + 1;
    }
    return false;
}

// Recover the first declared field of every indexed String element at this
// exact escape site. The result is usable only when all matching occurrences
// under the protected root agree; an absent or ambiguous path fails closed.
func SemanticAstCollectionAggregateElementBorrowSourceField(
    artifact: AstTreeArtifact,
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    ref locals: SemanticAstLocalBindingFacts,
    ref inferred_types: Array<String>,
    ref resolved_leaf_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    root: Int, site: Int
) -> String {
    var selected: String = "";
    let surface: Option<Int> =
        SemanticAstExpressionSurfaceIndexForNode(surfaces, site);
    if !IsSome(surface) { return selected; }
    let surface_row: Int = UnwrapOption(surface);
    let function_id: Int = surfaces.function_node_ids[surface_row];
    var lane: Int = 0;
    while lane < 3 {
        let expression: Option<Int> =
            SemanticAstExpressionGraphRootForNode(surfaces, site, lane);
        if IsSome(expression) {
            let expression_root: Int = UnwrapOption(expression);
            let start: Option<Int> = SemanticExpressionGraphSubtreeStart(
                surfaces.expression_graph, expression_root);
            if !IsSome(start) { return ""; }
            var node: Int = UnwrapOption(start);
            while node <= expression_root {
                if surfaces.expression_graph.arena.topology.node_kinds[node] ==
                        AstExpressionNodeIndex() {
                    let base: Option<Int> = SemanticExpressionGraphLeftChild(
                        surfaces.expression_graph, node);
                    if IsSome(base) {
                        let identity: SemanticAstCollectionMemberMoveIdentity =
                            SemanticAstCollectionMemberMoveIdentityForNode(
                                artifact, signatures, constructors, locals,
                                inferred_types, resolved_leaf_types,
                                function_id, site, surfaces.expression_graph,
                                UnwrapOption(base));
                        if identity.ok && identity.string_array_field &&
                            identity.source_binding_syntax_id == root &&
                            ArrayLength(identity.field_path_ids) > 0 {
                            let field_id: Int = identity.field_path_ids[0];
                            var field_name: String = "";
                            var field: Int = 0;
                            while field < ArrayLength(
                                    constructors.field_source_syntax_ids) {
                                if constructors.field_source_syntax_ids[field] ==
                                        field_id {
                                    field_name = constructors.field_names[field];
                                }
                                field = field + 1;
                            }
                            if field_name == "" ||
                                (selected != "" && selected != field_name) {
                                return "";
                            }
                            selected = field_name;
                        }
                    }
                }
                node = node + 1;
            }
        }
        lane = lane + 1;
    }
    return selected;
}

// The exclusive-value owner resolves a caller local back to the formal whose
// storage it carries. Follow only one recorded dependency row; a merely equal
// type or field spelling never makes a release boundary.
func SemanticAstCollectionAggregateDependentTransferAt(
    artifact: AstTreeArtifact,
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    ref locals: SemanticAstLocalBindingFacts,
    ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref plan: SemanticAstCollectionAggregateReleasePlan,
    ref exclusive_values: SemanticAstCollectionExclusiveValueFacts,
    ref requirements: SemanticAstCollectionAggregateFieldEntryRequirements,
    formal_effects: HashMap<String, Int>,
    root: Int, source_field: String, site: Int
) -> Bool {
    if SemanticAstCollectionAggregateLineageTransferAt(
            plan, root, site) ||
        SemanticAstCollectionAggregateCarrierTransferAt(
            plan, root, site) {
        return true;
    }
    if SemanticAstCollectionAggregateRootMutationAt(
            artifact, signatures, constructors, locals,
            inferred_types, surfaces, plan, requirements, formal_effects,
            root, source_field, site) {
        return true;
    }
    if !exclusive_values.ok ||
        ArrayLength(exclusive_values.dep_locals) !=
            ArrayLength(exclusive_values.dep_formals) ||
        ArrayLength(exclusive_values.dep_locals) !=
            ArrayLength(exclusive_values.dep_paths) ||
        ArrayLength(exclusive_values.paths) % 2 != 0 {
        return false;
    }
    var row: Int = 0;
    while row < ArrayLength(exclusive_values.dep_locals) {
        let candidate: Int = exclusive_values.dep_locals[row];
        let path_row: Int = exclusive_values.dep_paths[row];
        var source_matches: Bool = path_row < 0;
        if path_row >= 0 &&
            path_row < ArrayLength(exclusive_values.paths) / 2 {
            let recorded_source: String =
                exclusive_values.paths[2 * path_row + 1];
            source_matches = recorded_source == "" ||
                (source_field != "" && recorded_source == source_field);
        }
        if exclusive_values.dep_formals[row] == root && candidate > 0 &&
            source_matches &&
            !MapHas(exclusive_values.shared_locals, ToString(candidate)) &&
            (SemanticAstCollectionAggregateMutatingLocalArgumentAt(
                 artifact, signatures, locals, inferred_types, surfaces,
                 plan, formal_effects, candidate, site) ||
             SemanticAstCollectionAggregateRootMutationAt(
                 artifact, signatures, constructors, locals,
                 inferred_types, surfaces, plan, requirements, formal_effects,
                 candidate, source_field, site) ||
             SemanticAstCollectionAggregateCarrierTransferAt(
                 plan, candidate, site)) {
            return true;
        }
        row = row + 1;
    }
    return false;
}

