// Effective element-escape projection and the final protected-borrow site query.

import "ast_collection_aggregate_release_plan_schema_owner.pgy";
import "ast_collection_aggregate_field_entry_requirement_owner.pgy";
import "ast_collection_aggregate_sink_consumption_owner.pgy";
import "ast_collection_aggregate_value_lineage_owner.pgy";
import "ast_collection_builtin_release_identity_owner.pgy";
import "ast_collection_formal_effect_identity_owner.pgy";
import "ast_collection_exclusive_value_flow_owner.pgy";
import "ast_collection_ownership_member_result_owner.pgy";
import "ast_collection_ownership_member_move_owner.pgy";
import "ast_collection_storage_mutation_owner.pgy";
import "ast_collection_exclusive_compiler_clone_owner.pgy";
import "../ast_string_formal_text_containment_owner.pgy";
import "../ast_expression/ast_expression_surface_fact_owner.pgy";
import "../ast_local_binding_fact_owner.pgy";
import "../ast_local_binding_identity_owner.pgy";
import "ast_collection_aggregate_element_borrow_dependency_owner.pgy";

struct SemanticAstCollectionAggregateElementEscapeProjection {
    ok: Bool;
    roots: HashMap<String, Int>;
}

// The ordered ownership scan may cut an indexed String loan by selecting an
// exact compiler Clone at the call argument.  That cut discharges this later
// aggregate-release check only when the selected argument enters a declared
// String formal and the call returns a nominal aggregate that can own the
// copied text.  A String-returning identity call remains an escape.
func SemanticAstCollectionAggregateElementBorrowCloneLandedAt(
    artifact: AstTreeArtifact,
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    ref locals: SemanticAstLocalBindingFacts,
    ref inferred_types: Array<String>,
    ref resolved_leaf_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref assignments: SemanticAstAssignmentFacts,
    borrowed_text: HashMap<String, Int>,
    inout compiler_clone_expression_node_ids: Array<Int>,
    root: Int, site: Int
) -> Bool {
    let surface: Option<Int> =
        SemanticAstExpressionSurfaceIndexForNode(surfaces, site);
    if root <= 0 || site <= 0 || !IsSome(surface) { return false; }
    let surface_row: Int = UnwrapOption(surface);
    let function_id: Int = surfaces.function_node_ids[surface_row];
    var matched: Int = 0;
    var lane: Int = 0;
    while lane < 3 {
        let slot: Int = surface_row * 3 + lane;
        if slot < 0 ||
            slot >= ArrayLength(surfaces.expression_graph.roots) ||
            slot >= ArrayLength(surfaces.expression_graph.has_roots) {
            return false;
        }
        if surfaces.expression_graph.has_roots[slot] {
            let expression_root: Int =
                surfaces.expression_graph.roots[slot];
            let start: Option<Int> = SemanticExpressionGraphSubtreeStart(
                surfaces.expression_graph, expression_root);
            if !IsSome(start) { return false; }
            var node: Int = UnwrapOption(start);
            while node <= expression_root {
                let place_use: SemanticAstCollectionMemberPlaceUse =
                    SemanticAstCollectionMemberPlaceUseAt(
                        artifact, signatures, constructors, locals,
                        inferred_types, resolved_leaf_types, surfaces,
                        borrowed_text, slot, UnwrapOption(start), node,
                        expression_root,
                        lane == AstExpressionLaneAtom() &&
                            SemanticAstAssignmentContainsNode(
                                assignments, site));
                if place_use.escapes && place_use.root == root {
                    var text: Int = node;
                    var consumer: Int = SemanticAstBorrowedTextConsumer(
                        surfaces.expression_graph, text, expression_root);
                    while consumer >= 0 &&
                        SemanticAstBorrowedTextThroughToString(
                            surfaces.expression_graph, consumer, text) {
                        text = consumer;
                        consumer = SemanticAstBorrowedTextConsumer(
                            surfaces.expression_graph, text,
                            expression_root);
                    }
                    if consumer < 0 ||
                        surfaces.expression_graph.arena.topology.node_kinds[
                            consumer] != AstExpressionNodeCallArgument() {
                        return false;
                    }
                    let edge: SemanticCallArgumentEdgeView =
                        SemanticCallArgumentEdgeFromGraph(
                            surfaces.expression_graph, consumer);
                    if !edge.ok || edge.argument_node != text { return false; }
                    let target: SemanticAstCollectionArgumentFormalTarget =
                        SemanticAstCollectionArgumentFormalTargetForArgument(
                            signatures, surfaces.expression_graph,
                            edge.call_node, edge.ordinal);
                    if !target.ok || target.signature_row < 0 ||
                        target.signature_row >=
                            ArrayLength(signatures.return_types) {
                        return false;
                    }
                    let flat: Int = signatures.param_starts[
                        target.signature_row] + target.ordinal;
                    if flat < 0 || flat >=
                            ArrayLength(signatures.param_types) ||
                        signatures.param_types[flat] != "String" ||
                        (signatures.param_modes[flat] != 0 &&
                         signatures.param_modes[flat] != 2) ||
                        !SemanticAstCollectionMemberTypeIsAggregate(
                            constructors,
                            signatures.return_types[
                                target.signature_row]) {
                        return false;
                    }
                    // The whole-program escape closure is the first owner
                    // that knows this exact indexed occurrence outlives its
                    // backing store. Publish the same compiler-Clone fact
                    // consumed by codegen instead of requiring an earlier
                    // local release scan to have guessed the later escape.
                    if !SemanticAstCollectionExclusiveCompilerCloneNodeSelected(
                            compiler_clone_expression_node_ids, text) &&
                        !SemanticAstCollectionExclusiveSelectCompilerCloneNode(
                            compiler_clone_expression_node_ids, text) {
                        return false;
                    }
                    matched = matched + 1;
                }
                node = node + 1;
            }
        }
        lane = lane + 1;
    }
    return matched > 0;
}

// A String local borrowed from a protected element is harmless only when its
// text stays frame-contained and every occurrence ends before the first exact
// lineage call that may mutate or release that root. With no such call, the
// callee frame ends before a caller can retire its readonly input. A later use,
// an unknown local, or an unproved control order remains an element escape.
func SemanticAstCollectionAggregateElementBorrowExpiresBeforeLineage(
    artifact: AstTreeArtifact,
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    ref locals: SemanticAstLocalBindingFacts,
    ref inferred_types: Array<String>,
    ref resolved_leaf_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref plan: SemanticAstCollectionAggregateReleasePlan,
    ref exclusive_values: SemanticAstCollectionExclusiveValueFacts,
    ref requirements: SemanticAstCollectionAggregateFieldEntryRequirements,
    formal_effects: HashMap<String, Int>,
    borrowed_text: HashMap<String, Int>,
    root: Int, site: Int
) -> Bool {
    let local_index: Option<Int> =
        SemanticAstLocalBindingIndexForNode(locals, site);
    if !IsSome(local_index) || UnwrapOption(local_index) < 0 ||
        UnwrapOption(local_index) >= ArrayLength(inferred_types) ||
        inferred_types[UnwrapOption(local_index)] != "String" {
        return false;
    }
    let local_row: Int = UnwrapOption(local_index);
    let function_id: Int = locals.function_node_ids[local_row];
    if !SemanticAstBorrowedTextLocalContainedAt(
            artifact, signatures, locals, inferred_types, surfaces,
            borrowed_text, site) {
        return false;
    }
    let source_field: String =
        SemanticAstCollectionAggregateElementBorrowSourceField(
            artifact, signatures, constructors, locals, inferred_types,
            resolved_leaf_types, surfaces, root, site);
    if source_field == "" {
        return false;
    }
    var boundary: Int = -1;
    var may_retire_after_site: Bool = false;
    var call: Int = 0;
    while call < ArrayLength(plan.call_syntax_ids) {
        let syntax_id: Int = plan.call_syntax_ids[call];
        if plan.call_function_ids[call] == function_id &&
            syntax_id > site &&
            SemanticAstCollectionAggregateDependentTransferAt(
                artifact, signatures, constructors, locals,
                inferred_types, surfaces,
                plan, exclusive_values, requirements, formal_effects,
                root, source_field, syntax_id) {
            may_retire_after_site = true;
            // A conditional or loop-contained retirement may still execute.
            // If the local order owner cannot prove that every continuing
            // path crosses it, this local borrow cannot be discharged.
            if !SemanticAstCollectionExclusiveRunsAfter(
                    artifact, site, syntax_id) {
                return false;
            }
            if boundary < 0 || syntax_id < boundary {
                boundary = syntax_id;
            }
        }
        call = call + 1;
    }
    if !may_retire_after_site { return true; }
    if boundary <= 0 { return false; }

    var slot: Int = 0;
    while slot < ArrayLength(surfaces.expression_graph.roots) {
        if surfaces.expression_graph.has_roots[slot] &&
            surfaces.function_node_ids[slot / 3] == function_id {
            let syntax_id: Int = surfaces.node_ids[slot / 3];
            let after_boundary: Bool = syntax_id == boundary ||
                SemanticAstCollectionExclusiveRunsAfter(
                    artifact, boundary, syntax_id);
            if after_boundary {
                let expression_root: Int =
                    surfaces.expression_graph.roots[slot];
                let start: Option<Int> =
                    SemanticExpressionGraphSubtreeStart(
                        surfaces.expression_graph, expression_root);
                if !IsSome(start) { return false; }
                var node: Int = UnwrapOption(start);
                while node <= expression_root {
                    let occurrence: SemanticAstLocalBindingIdentity =
                        SemanticAstScopedLocalBindingIdentityForGraphLeaf(
                            artifact, locals, inferred_types, function_id,
                            syntax_id, surfaces.expression_graph, node);
                    if occurrence.ok && occurrence.row == local_row {
                        return false;
                    }
                    node = node + 1;
                }
            }
        }
        slot = slot + 1;
    }
    return true;
}

// Rebuild the lending closure only after the ordered scan has selected every
// compiler Clone. The member transition owner publishes direct escape sites
// and lending edges; this last consumer removes only a direct escape whose
// exact String occurrence is independently copied or whose local text is
// proved frame-contained. Propagated caller roots then disappear naturally.
func SemanticAstCollectionAggregateEffectiveElementEscapes(
    artifact: AstTreeArtifact,
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    ref locals: SemanticAstLocalBindingFacts,
    ref inferred_types: Array<String>,
    ref resolved_leaf_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref assignments: SemanticAstAssignmentFacts,
    ref plan: SemanticAstCollectionAggregateReleasePlan,
    ref exclusive_values: SemanticAstCollectionExclusiveValueFacts,
    ref requirements: SemanticAstCollectionAggregateFieldEntryRequirements,
    formal_effects: HashMap<String, Int>,
    borrowed_text: HashMap<String, Int>,
    inout compiler_clone_expression_node_ids: Array<Int>,
    ref moved_use: SemanticAstCollectionMemberMoveUse
) -> SemanticAstCollectionAggregateElementEscapeProjection {
    var roots: HashMap<String, Int> = MapNew();
    if !moved_use.read_permission_ready ||
        ArrayLength(moved_use.direct_element_escape_root_ids) !=
            ArrayLength(moved_use.direct_element_escape_syntax_ids) ||
        ArrayLength(moved_use.element_escape_source_ids) !=
            ArrayLength(moved_use.element_escape_target_ids) ||
        ArrayLength(moved_use.element_escape_source_ids) !=
            ArrayLength(moved_use.element_escape_lending_syntax_ids) {
        return SemanticAstCollectionAggregateElementEscapeProjection(
            false, roots);
    }
    var direct: Int = 0;
    while direct < ArrayLength(
            moved_use.direct_element_escape_root_ids) {
        let root: Int = moved_use.direct_element_escape_root_ids[direct];
        let site: Int = moved_use.direct_element_escape_syntax_ids[direct];
        let key: String = ToString(root);
        if root <= 0 || site <= 0 ||
            !MapHas(moved_use.element_escape_roots, key) {
            return SemanticAstCollectionAggregateElementEscapeProjection(
                false, roots);
        }
        let discharged: Bool =
            SemanticAstCollectionAggregateElementBorrowCloneLandedAt(
                artifact, signatures, constructors, locals, inferred_types,
                resolved_leaf_types, surfaces, assignments, borrowed_text,
                compiler_clone_expression_node_ids, root, site) ||
            SemanticAstCollectionAggregateElementBorrowExpiresBeforeLineage(
                artifact, signatures, constructors, locals, inferred_types,
                resolved_leaf_types, surfaces, plan, exclusive_values,
                requirements, formal_effects, borrowed_text, root, site);
        if !discharged && !MapHas(roots, key) { MapSet(roots, key, site); }
        direct = direct + 1;
    }
    if !SemanticAstCollectionMemberElementEscapeClosure(
            moved_use.element_escape_source_ids,
            moved_use.element_escape_target_ids,
            moved_use.element_escape_lending_syntax_ids, roots) {
        return SemanticAstCollectionAggregateElementEscapeProjection(
            false, roots);
    }
    return SemanticAstCollectionAggregateElementEscapeProjection(true, roots);
}

func SemanticAstCollectionAggregateElementBorrowSiteIn(
    artifact: AstTreeArtifact,
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    ref locals: SemanticAstLocalBindingFacts,
    ref inferred_types: Array<String>,
    ref resolved_leaf_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref plan: SemanticAstCollectionAggregateReleasePlan,
    ref exclusive_values: SemanticAstCollectionExclusiveValueFacts,
    ref requirements: SemanticAstCollectionAggregateFieldEntryRequirements,
    formal_effects: HashMap<String, Int>,
    borrowed_text: HashMap<String, Int>,
    ref bindings: Array<Int>, escaped: HashMap<String, Int>
) -> Int {
    var row: Int = 0;
    while row < ArrayLength(bindings) {
        if bindings[row] > 0 && MapHas(escaped, ToString(bindings[row])) {
            let site: Int = MapGet(escaped, ToString(bindings[row]));
            if !SemanticAstCollectionAggregateForwardedTransferAt(
                    plan, bindings[row], site) &&
                !SemanticAstCollectionAggregateLineageTransferAt(
                    plan, bindings[row], site) &&
                !SemanticAstCollectionAggregateElementBorrowExpiresBeforeLineage(
                    artifact, signatures, constructors, locals,
                    inferred_types, resolved_leaf_types, surfaces,
                    plan, exclusive_values, requirements, formal_effects,
                    borrowed_text,
                    bindings[row], site) {
                return site;
            }
        }
        row = row + 1;
    }
    return 0;
}

// The first borrow site of a protected root, or 0.
func SemanticAstCollectionAggregateReleaseElementBorrowSite(
    artifact: AstTreeArtifact,
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    ref locals: SemanticAstLocalBindingFacts,
    ref inferred_types: Array<String>,
    ref resolved_leaf_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref assignments: SemanticAstAssignmentFacts,
    ref plan: SemanticAstCollectionAggregateReleasePlan,
    ref exclusive_values: SemanticAstCollectionExclusiveValueFacts,
    ref requirements: SemanticAstCollectionAggregateFieldEntryRequirements,
    formal_effects: HashMap<String, Int>,
    borrowed_text: HashMap<String, Int>,
    inout compiler_clone_expression_node_ids: Array<Int>,
    ref moved_use: SemanticAstCollectionMemberMoveUse
) -> Int {
    let effective: SemanticAstCollectionAggregateElementEscapeProjection =
        SemanticAstCollectionAggregateEffectiveElementEscapes(
            artifact, signatures, constructors, locals, inferred_types,
            resolved_leaf_types, surfaces, assignments, plan,
            exclusive_values, requirements, formal_effects, borrowed_text,
            compiler_clone_expression_node_ids, moved_use);
    if !effective.ok { return -1; }
    var site: Int = SemanticAstCollectionAggregateElementBorrowSiteIn(
        artifact, signatures, constructors, locals, inferred_types,
        resolved_leaf_types, surfaces, plan,
        exclusive_values, requirements, formal_effects, borrowed_text,
        plan.aggregate_origin_ids, effective.roots);
    if site > 0 { return site; }
    site = SemanticAstCollectionAggregateElementBorrowSiteIn(
        artifact, signatures, constructors, locals, inferred_types,
        resolved_leaf_types, surfaces, plan,
        exclusive_values, requirements, formal_effects, borrowed_text,
        plan.carrier_local_ids, effective.roots);
    if site > 0 { return site; }
    site = SemanticAstCollectionAggregateElementBorrowSiteIn(
        artifact, signatures, constructors, locals, inferred_types,
        resolved_leaf_types, surfaces, plan,
        exclusive_values, requirements, formal_effects, borrowed_text,
        plan.carrier_source_binding_ids, effective.roots);
    if site > 0 { return site; }
    return SemanticAstCollectionAggregateElementBorrowSiteIn(
        artifact, signatures, constructors, locals, inferred_types,
        resolved_leaf_types, surfaces, plan,
        exclusive_values, requirements, formal_effects, borrowed_text,
        plan.protected_binding_ids, effective.roots);
}

