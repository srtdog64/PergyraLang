// Exact callable-formal slice admitted by aggregate field-entry recording.
import "../ast_signature_fact_owner.pgy";

struct SemanticAstCollectionAggregateFieldEntryFormal {
    ok: Bool,
    signature_row: Int,
    parameter_count: Int
}

func SemanticAstCollectionAggregateFieldEntryFormalForFunction(
    ref signatures: SemanticAstFunctionSignatureFacts,
    function_id: Int
) -> SemanticAstCollectionAggregateFieldEntryFormal {
    let invalid: SemanticAstCollectionAggregateFieldEntryFormal =
        SemanticAstCollectionAggregateFieldEntryFormal(false, -1, 0);
    let signature: Option<Int> =
        SemanticAstFunctionSignatureIndexForNode(signatures, function_id);
    if !IsSome(signature) { return invalid; }
    let selected: Int = UnwrapOption(signature);
    let start: Int = signatures.param_starts[selected];
    let length: Int = signatures.param_counts[selected];
    if start < 0 || length < 0 ||
        start > ArrayLength(signatures.param_node_ids) ||
        length > ArrayLength(signatures.param_node_ids) - start {
        return invalid;
    }
    let count: Option<Int> =
        SemanticAstFunctionParamCountAt(signatures, selected);
    if !IsSome(count) ||
        (selected > 0 &&
         signatures.function_node_ids[selected - 1] == function_id) ||
        (selected + 1 < ArrayLength(signatures.function_node_ids) &&
         signatures.function_node_ids[selected + 1] == function_id) {
        return invalid;
    }
    var ordinal: Int = 0;
    while ordinal < UnwrapOption(count) {
        let node: Option<Int> =
            SemanticAstFunctionParamNodeAt(signatures, selected, ordinal);
        let mode: Option<Int> =
            SemanticAstFunctionParamModeAt(signatures, selected, ordinal);
        if !IsSome(node) || UnwrapOption(node) <= 0 || !IsSome(mode) ||
            UnwrapOption(mode) < 0 || UnwrapOption(mode) > 3 {
            return invalid;
        }
        var prior: Int = 0;
        while prior < ordinal {
            let prior_node: Option<Int> =
                SemanticAstFunctionParamNodeAt(signatures, selected, prior);
            if !IsSome(prior_node) ||
                UnwrapOption(prior_node) == UnwrapOption(node) {
                return invalid;
            }
            prior = prior + 1;
        }
        ordinal = ordinal + 1;
    }
    return SemanticAstCollectionAggregateFieldEntryFormal(
        true, selected, UnwrapOption(count));
}
