func SemanticAstCollectionAggregateMemberStorageBindingForNode(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref resolved_leaf_types: Array<String>, function_id: Int, syntax_id: Int,
    ref surfaces: SemanticAstExpressionSurfaceFacts, node: Int
) -> Int {
    let member: SemanticMemberAccessView =
        SemanticMemberAccessViewFromGraph(surfaces.expression_graph, node);
    if !member.ok {
        return SemanticAstCollectionAggregateValueBindingForNode(
            artifact, signatures, locals, inferred_types, resolved_leaf_types,
            function_id, syntax_id, surfaces, node);
    }
    let spine: SemanticExpressionGraphValueReceiverSpine =
        SemanticExpressionGraphValueReceiverSpineFromGraph(surfaces.expression_graph, node);
    // A member of a call result: its declared return type projects the member.
    if spine.ok && spine.leaf_node < 0 && spine.call_node >= 0 {
        var returned: Option<String> = SemanticExpressionGraphCallReturnTypeName(surfaces.expression_graph, spine.call_node);
        let target: Option<Int> = SemanticExpressionGraphCallTargetSyntaxId(surfaces.expression_graph, spine.call_node);
        if !IsSome(returned) && IsSome(target) {
            let signature: Option<Int> = SemanticAstFunctionSignatureIndexForNode(signatures, UnwrapOption(target));
            if IsSome(signature) { returned = Some(Concat("", signatures.return_types[UnwrapOption(signature)])); }
        }
        if !IsSome(returned) { return -1; }
        let member_type: Option<String> = SemanticAstCollectionMemberPathTypeName(
            locals, inferred_types, surfaces, constructors, syntax_id, node, spine.depth, UnwrapOption(returned));
        if !IsSome(member_type) || SemanticAstCollectionOwnershipIsStringArray(UnwrapOption(member_type)) { return -1; }
        return 0;
    }
    if !spine.ok || spine.leaf_node < 0 { return -1; }
    let root: SemanticAstCollectionMemberRootIdentity =
        SemanticAstCollectionMemberRootIdentityForNode(
            artifact, signatures, locals, inferred_types, resolved_leaf_types,
            function_id, syntax_id, surfaces.expression_graph, spine.leaf_node);
    if !root.ok {
        // A path from a static name, such as an enum variant, starts at no
        // local or formal and names no storage the plan releases.
        let leaf_local: SemanticAstLocalBindingIdentity = SemanticAstScopedLocalBindingIdentityForGraphLeaf(
            artifact, locals, inferred_types, function_id, syntax_id, surfaces.expression_graph, spine.leaf_node);
        let leaf_binding: SemanticExpressionBindingIdentityFact =
            SemanticExpressionGraphBindingIdentity(surfaces.expression_graph, spine.leaf_node);
        if !leaf_local.ok && leaf_binding.ok && leaf_binding.kind == SemanticExpressionBindingNone() { return 0; }
        return -1;
    }
    let projected: Option<String> = SemanticAstCollectionMemberPathTypeName(
        locals, inferred_types, surfaces, constructors, syntax_id, node, spine.depth, root.type_name);
    if !IsSome(projected) { return -1; }
    if !SemanticAstCollectionOwnershipIsStringArray(UnwrapOption(projected)) { return 0; }
    return root.source_binding_syntax_id;
}

struct SemanticAstCollectionAggregateResultTransfer {
    ready: Bool;
    site_count: Int;
    first_syntax_id: Int;
    last_syntax_id: Int;
    matched_return_syntax_ids: Array<Int>;
    matched_source_holder_ids: Array<Int>;
    matched_source_argument_nodes: Array<Int>;
}

// The extracted Array local is a whole holder.  Its fixed-point dependency
// must name one formal and one exact source path; a partly shared or
// multi-source local cannot transfer its cleanup responsibility through a
// later aggregate holder.
func SemanticAstCollectionAggregateLocalDependencyOrigin(
    ref facts: SemanticAstCollectionExclusiveValueFacts,
    local_id: Int, formal_id: Int
) -> Option<String> {
    if local_id <= 0 || formal_id <= 0 ||
        ArrayLength(facts.dep_locals) != ArrayLength(facts.dep_formals) ||
        ArrayLength(facts.dep_locals) != ArrayLength(facts.dep_paths) ||
        ArrayLength(facts.paths) % 2 != 0 ||
        MapHas(facts.shared_locals, ToString(local_id)) ||
        MapHas(facts.shared_locals, Concat(ToString(local_id), ".*")) {
        return None;
    }
    var rows: Int = 0;
    var matches: Int = 0;
    var origin: String = "";
    var row: Int = 0;
    while row < ArrayLength(facts.dep_locals) {
        if facts.dep_locals[row] == local_id {
            rows = rows + 1;
            if facts.dep_formals[row] == formal_id {
                let path: Int = facts.dep_paths[row];
                if path < 0 {
                    matches = matches + 1;
                    origin = "";
                } else if path < ArrayLength(facts.paths) / 2 &&
                    facts.paths[2 * path] == "" {
                    matches = matches + 1;
                    origin = Concat("", facts.paths[2 * path + 1]);
                }
            }
        }
        row = row + 1;
    }
    if rows != 1 || matches != 1 { return None; }
    return Some(origin);
}

// A whole returned aggregate may carry the extracted local below one field.
// Consume only the existing exclusive dependency row and require one exact
// occurrence of the same formal source path. A holder with two source rows is
// marked shared and fails closed; the sibling-field swap fixture preserves
// that falsifying case.
func SemanticAstCollectionAggregateHolderCarriesOrigin(
    ref facts: SemanticAstCollectionExclusiveValueFacts,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    holder_id: Int, formal_id: Int, holder_node: Int,
    origin: String, required_destination_field: String
) -> Bool {
    if holder_id <= 0 || formal_id <= 0 ||
        required_destination_field == "" ||
        ArrayLength(facts.dep_locals) != ArrayLength(facts.dep_formals) ||
        ArrayLength(facts.dep_locals) != ArrayLength(facts.dep_paths) ||
        ArrayLength(facts.paths) % 2 != 0 ||
        MapHas(facts.shared_locals, ToString(holder_id)) ||
        MapHas(facts.shared_locals, Concat(ToString(holder_id), ".*")) {
        return false;
    }
    let spine: SemanticExpressionGraphValueReceiverSpine =
        SemanticExpressionGraphValueReceiverSpineFromGraph(
            surfaces.expression_graph, holder_node);
    if !spine.ok || spine.leaf_node < 0 { return false; }
    let holder_path: String =
        SemanticAstCollectionExclusiveMemberPathAbove(
            surfaces, spine.leaf_node, holder_node);
    var matches: Int = 0;
    var row: Int = 0;
    while row < ArrayLength(facts.dep_locals) {
        if facts.dep_locals[row] == holder_id &&
            facts.dep_formals[row] == formal_id {
            var destination: String = "";
            var source: String = "";
            let path: Int = facts.dep_paths[row];
            if path >= 0 && path < ArrayLength(facts.paths) / 2 {
                destination = facts.paths[2 * path];
                source = facts.paths[2 * path + 1];
            }
            if source == origin &&
                destination == required_destination_field &&
                (holder_path == "" || destination == holder_path) {
                matches = matches + 1;
            }
        }
        row = row + 1;
    }
    return matches == 1;
}

func SemanticAstCollectionAggregateCarryingPathRecorded(
    ref facts: SemanticAstCollectionExclusiveValueFacts,
    formal_id: Int, origin: String, result_path: String
) -> Bool {
    if formal_id <= 0 || !MapHas(
            facts.carrying, ToString(formal_id)) {
        return false;
    }
    let key: String = ToString(formal_id);
    let count: Int = SemanticAstCollectionExclusiveCopyCount(
        facts.carrying, Concat("cn:", key));
    var matches: Int = 0;
    var row: Int = 0;
    while row < count {
        let path: Int = MapGet(
            facts.carrying,
            Concat("ci:", Concat(key, Concat(":", ToString(row)))));
        if path >= 0 && path < ArrayLength(facts.paths) / 2 &&
            facts.paths[2 * path] == result_path &&
            facts.paths[2 * path + 1] == origin {
            matches = matches + 1;
        }
        row = row + 1;
    }
    return matches == 1;
}

// One owned local may discharge its restoration obligation by becoming the
// exact field path carried from its originating default formal to the function
// result. Requirements and extracted field carriers share this owner: both
// must prove one local, one source formal, and one returned field path. Every
// terminal return after the carrier becomes live must carry that same path;
// alternative return sites form one transfer set, not duplicate ownership.
// This is a transfer, not an implicit copy or a guessed type match.
func SemanticAstCollectionAggregateOwnedLocalResultTransfer(
    artifact: AstTreeArtifact,
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    ref locals: SemanticAstLocalBindingFacts,
    ref inferred_types: Array<String>,
    ref resolved_leaf_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref statements: SemanticAstStatementFacts,
    ref body_termination: SemanticAstBodyTerminationFacts,
    ref facts: SemanticAstCollectionExclusiveValueFacts,
    function_id: Int, local_id: Int, formal_id: Int,
    after_syntax_id: Int, required_destination_field: String
) -> SemanticAstCollectionAggregateResultTransfer {
    var matched_return_syntax_ids: Array<Int> = [];
    var matched_source_holder_ids: Array<Int> = [];
    var matched_source_argument_nodes: Array<Int> = [];
    var formal_matches: Int = 0;
    var default_formal: Bool = false;
    var parameter: Int = 0;
    while parameter < ArrayLength(signatures.param_node_ids) {
        if signatures.param_node_ids[parameter] == formal_id {
            formal_matches = formal_matches + 1;
            default_formal = signatures.param_modes[parameter] == 0;
        }
        parameter = parameter + 1;
    }
    if formal_matches != 1 || !default_formal {
        return SemanticAstCollectionAggregateResultTransfer(
            false, 0, -1, -1, matched_return_syntax_ids,
            matched_source_holder_ids, matched_source_argument_nodes);
    }
    var expected_returns: Int = 0;
    var terminal_coverage_ready: Bool = true;
    var matched: Int = 0;
    var first_transfer_syntax: Int = -1;
    var last_transfer_syntax: Int = -1;
    var statement: Int = 0;
    while statement < ArrayLength(statements.node_ids) {
        if statements.function_node_ids[statement] == function_id &&
            statements.node_ids[statement] > local_id &&
            SemanticAstBodyStatementReachable(
                artifact, signatures, body_termination, function_id,
                statements.node_ids[statement]) {
            let kind: Int = statements.kind_tags[statement];
            if kind == TypedAstKindValueReturnStmtTag() {
                expected_returns = expected_returns + 1;
                let syntax_id: Int = statements.node_ids[statement];
                if syntax_id <= after_syntax_id {
                    terminal_coverage_ready = false;
                } else {
                    let returned_root: Option<Int> =
                        SemanticAstExpressionGraphRootForNode(
                            surfaces, syntax_id, AstExpressionLaneAtom());
                    var surface_matches: Int = 0;
                    var surface_row: Int = -1;
                    var surface_index: Int = 0;
                    while surface_index < ArrayLength(surfaces.node_ids) {
                        if surfaces.node_ids[surface_index] == syntax_id &&
                            surfaces.function_node_ids[surface_index] ==
                                function_id {
                            surface_matches = surface_matches + 1;
                            surface_row = surface_index;
                        }
                        surface_index = surface_index + 1;
                    }
                    if !IsSome(returned_root) || surface_matches != 1 {
                        terminal_coverage_ready = false;
                    } else {
                        let root: Int = UnwrapOption(returned_root);
                        let start: Option<Int> =
                            SemanticExpressionGraphSubtreeStart(
                                surfaces.expression_graph, root);
                        if !IsSome(start) {
                            terminal_coverage_ready = false;
                        } else {
                            var return_matches: Int = 0;
                            var node: Int = UnwrapOption(start);
                            while node <= root {
                                let edge: SemanticCallArgumentEdgeView =
                                    SemanticCallArgumentEdgeFromGraph(
                                        surfaces.expression_graph, node);
                                if edge.ok {
                                    let source: Int =
                                        SemanticAstCollectionAggregateMemberStorageBindingForNode(
                                            artifact, signatures, constructors,
                                            locals, inferred_types,
                                            resolved_leaf_types, function_id,
                                            syntax_id, surfaces,
                                            edge.argument_node);
                                    var carries_local: Bool =
                                        source == local_id;
                                    var carried_origin: Option<String> = None;
                                    if source > 0 && source != local_id &&
                                        required_destination_field != "" {
                                        carried_origin =
                                            SemanticAstCollectionAggregateLocalDependencyOrigin(
                                                facts, local_id, formal_id);
                                        carries_local =
                                            IsSome(carried_origin) &&
                                            SemanticAstCollectionAggregateHolderCarriesOrigin(
                                                facts, surfaces, source,
                                                formal_id, edge.argument_node,
                                                UnwrapOption(carried_origin),
                                                required_destination_field);
                                    }
                                    if carries_local {
                                        let result_path: Option<String> =
                                            SemanticAstCollectionAggregateReturnedResultPath(
                                                artifact, signatures,
                                                constructors, locals,
                                                inferred_types, surfaces,
                                                facts, surface_row, root, edge,
                                                "");
                                        var returned_ready: Bool = false;
                                        var returned_formal: Int = 0;
                                        if source == local_id {
                                            returned_formal =
                                                SemanticAstCollectionAggregateResultPathFormal(
                                                    facts, surfaces, local_id,
                                                    edge.argument_node);
                                            returned_ready =
                                                returned_formal == formal_id &&
                                                IsSome(result_path) &&
                                                SemanticAstCollectionAggregateResultPathReturned(
                                                    facts, surfaces, local_id,
                                                    formal_id,
                                                    edge.argument_node,
                                                    UnwrapOption(result_path));
                                        } else if IsSome(result_path) &&
                                            IsSome(carried_origin) {
                                            returned_ready =
                                                SemanticAstCollectionAggregateCarryingPathRecorded(
                                                    facts, formal_id,
                                                    UnwrapOption(carried_origin),
                                                    UnwrapOption(result_path));
                                        }
                                        if returned_ready {
                                            return_matches =
                                                return_matches + 1;
                                            ArrayPush(
                                                matched_return_syntax_ids,
                                                syntax_id);
                                            ArrayPush(
                                                matched_source_holder_ids,
                                                source);
                                            ArrayPush(
                                                matched_source_argument_nodes,
                                                edge.argument_node);
                                        }
                                    }
                                }
                                node = node + 1;
                            }
                            if return_matches == 1 {
                                matched = matched + 1;
                                if first_transfer_syntax < 0 ||
                                    syntax_id < first_transfer_syntax {
                                    first_transfer_syntax = syntax_id;
                                }
                                if syntax_id > last_transfer_syntax {
                                    last_transfer_syntax = syntax_id;
                                }
                            } else {
                                terminal_coverage_ready = false;
                            }
                        }
                    }
                }
            } else if kind == TypedAstKindBareReturnStmtTag() ||
                kind == TypedAstKindExitStmtTag() ||
                kind == TypedAstKindFailStmtTag() {
                terminal_coverage_ready = false;
            }
        }
        statement = statement + 1;
    }
    return SemanticAstCollectionAggregateResultTransfer(
        terminal_coverage_ready && expected_returns > 0 &&
            matched == expected_returns &&
            ArrayLength(matched_return_syntax_ids) == matched &&
            ArrayLength(matched_source_holder_ids) == matched &&
            ArrayLength(matched_source_argument_nodes) == matched,
        matched, first_transfer_syntax, last_transfer_syntax,
        matched_return_syntax_ids, matched_source_holder_ids,
        matched_source_argument_nodes);
}

func SemanticAstCollectionAggregateResultTransferAt(
    ref transfer: SemanticAstCollectionAggregateResultTransfer,
    ref statements: SemanticAstStatementFacts,
    function_id: Int, syntax_id: Int
) -> Bool {
    if !transfer.ready || transfer.site_count <= 0 ||
        syntax_id < transfer.first_syntax_id ||
        syntax_id > transfer.last_syntax_id {
        return false;
    }
    var statement: Int = 0;
    while statement < ArrayLength(statements.node_ids) {
        if statements.function_node_ids[statement] == function_id &&
            statements.node_ids[statement] == syntax_id &&
            statements.kind_tags[statement] ==
                TypedAstKindValueReturnStmtTag() {
            return true;
        }
        statement = statement + 1;
    }
    return false;
}


func SemanticAstCollectionAggregateArgumentAliasReady(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts, ref locals: SemanticAstLocalBindingFacts,
    ref inferred_types: Array<String>, ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref formal_effects: SemanticAstCollectionFormalEffects,
    ref moved_use: SemanticAstCollectionMemberMoveUse,
    ref aggregate_release_plan: SemanticAstCollectionAggregateReleasePlan,
    slot: Int, edge_node: Int,
    edge: SemanticCallArgumentEdgeView, source: Int
) -> Bool {
    if source < 0 || !formal_effects.ok ||
        !SemanticAstCollectionFormalExecutionContextCallableReady(
            artifact, formal_effects.execution_contexts, surfaces.function_node_ids[slot / 3]) {
        return false;
    }
    let effect: SemanticAstCollectionArgumentPermissionEffect =
        SemanticAstCollectionArgumentPermissionEffectFromEdge(
            artifact, signatures, constructors, locals, inferred_types,
            surfaces, slot / 3, edge, formal_effects.inventory.row_by_formal,
            formal_effects.inventory.modes, formal_effects.effects);
    let readonly_effect: Bool = effect.ok && !effect.unknown &&
        !effect.retiring && !effect.storage_escape &&
        !effect.descriptor_retiring;
    let member: SemanticMemberAccessView = SemanticMemberAccessViewFromGraph(
        surfaces.expression_graph, edge.argument_node);
    if member.ok { return readonly_effect; }
    if readonly_effect && SemanticAstCollectionAggregateExactCarrierReadAt(
            aggregate_release_plan, source, edge_node) {
        return true;
    }
    let target: SemanticAstCollectionArgumentFormalTarget =
        SemanticAstCollectionMemberReadCallTarget(
            artifact, signatures, surfaces.expression_graph, edge.call_node, edge.ordinal);
    return moved_use.read_permission_ready && target.ok &&
        SemanticAstCollectionFormalExecutionContextCallableReady(
            artifact, formal_effects.execution_contexts,
            signatures.function_node_ids[target.signature_row]) &&
        !SemanticAstCollectionMemberReadRootBlocked(
            moved_use.unproved_read_roots, target.syntax_id);
}

