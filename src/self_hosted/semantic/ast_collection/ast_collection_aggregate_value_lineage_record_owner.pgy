import "ast_collection_call_effect_fact_owner.pgy";
import "ast_collection_formal_effect_identity_owner.pgy";
import "ast_collection_ownership_identity_owner.pgy";
import "ast_collection_ownership_member_move_owner.pgy";
import "ast_collection_ownership_member_root_identity_owner.pgy";
import "ast_collection_storage_mutation_owner.pgy";
import "../ast_expression/ast_expression_graph_member_view_owner.pgy";
import "../ast_nominal_constructor_lookup_owner.pgy";
import "../nominal_constructor_argument_policy_owner.pgy";
