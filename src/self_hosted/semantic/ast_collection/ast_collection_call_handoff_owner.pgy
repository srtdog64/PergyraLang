// Call hand-off of a local Array<String> (decisions 2026-10-18 and
// 2026-11-15, docs/truth/decisions/2026-11-15_handed_off_array_storage_is_not_released.md).
//
// A named local passed whole to a default-mode formal is handed off when
// the call hand-off rule (call_handoff_rule_projection_owner.pgy, generated
// from src/semantic/call_handoff_rule.def) gives HAND_OFF for the formal's
// class: its effect code (an owned or shallow mutation is Grow) joined with
// Keep when it keeps the descriptor (stores or returns it). Neither the
// caller nor the callee releases it afterwards; both front ends leak that
// storage. This owner issues the hand-off on the binding's row at that
// exact call edge. A later use of the binding is refused or copied by the
// descriptor-retention and exclusive argument owners before this point, so
// the site's later use is read from its repetition alone (divergence
// SELF_LATER_USE_NOT_READ), and only loops and defer repeat it (divergence
// SELF_REPEAT_SKIPS_DETACHED_BODY). An unproved effect is not a move here
// (divergence SELF_UNPROVED_EFFECT_NOT_MOVING).
//
// No hand-off is issued, and the row keeps its state, when:
// - a Clone landed at the argument (the copy, a fresh value, is handed over
//   instead);
// - the binding is a member move, whose storage returns to its aggregate;
// - the formal is not default-mode (an own formal retires the row through
//   descriptor retention; a ref or inout formal leaves the storage with the
//   caller);
// - the binding has another definition;
// - the call runs again without a new definition of the binding (a loop
//   that does not declare it).
// A live row passed by value is then still checked by the direct MIR
// storage-sharing owner, which refuses a release it cannot prove.
import "ast_collection_ownership_state_owner.pgy";
import "ast_collection_definition_fact_owner.pgy";
import "ast_collection_call_retirement_owner.pgy";
import "ast_collection_formal_descriptor_retention_owner.pgy";
import "ast_collection_formal_effect_identity_owner.pgy";
import "ast_collection_exclusive_compiler_clone_owner.pgy";
import "../call_handoff_rule_projection_owner.pgy";
import "ast_collection_call_handoff_ledger_owner.pgy";
import "ast_collection_ownership_identity_owner.pgy";

func SemanticAstCollectionCallHandOffApplyAtCall(
    ref artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref surfaces: SemanticAstExpressionSurfaceFacts, edge: SemanticCallArgumentEdgeView,
    syntax_id: Int, binding_id: Int, row: Int, effect: Int, retains_descriptor: Bool,
    moves_descriptor: Bool, ref definitions: SemanticAstCollectionDefinitionFacts,
    ref compiler_clone_expression_node_ids: Array<Int>, ref origins: Array<Int>,
    ref ownership: Array<Int>, inout dispositions: Array<Int>,
    ref inferred_types: Array<String>, surface_row: Int,
    inout ledger: SemanticAstCollectionCallHandoffLedger
) -> Void {
    if row < 0 || row >= ArrayLength(dispositions) || row >= ArrayLength(ownership) ||
        row >= ArrayLength(origins) || moves_descriptor {
        return;
    }
    // The ledger records the site of a tracked local row: an Array<String>
    // local of a declared routine.
    let function_id: Int = surfaces.function_node_ids[surface_row];
    let tracked: Bool = row < ArrayLength(inferred_types) &&
        SemanticAstCollectionOwnershipIsStringArray(inferred_types[row]);
    let formal: SemanticAstCollectionArgumentFormalTarget = SemanticAstCollectionArgumentFormalTargetForArgument(
        signatures, surfaces.expression_graph, edge.call_node, edge.ordinal);
    if !formal.ok || formal.signature_row < 0 ||
        signatures.param_starts[formal.signature_row] + formal.ordinal >= ArrayLength(signatures.param_modes) ||
        signatures.param_modes[signatures.param_starts[formal.signature_row] + formal.ordinal] != 0 {
        return;
    }
    let divergences: Int = SemanticCallHandoffDivergenceSelfUnprovedEffectNotMoving();
    var members: Int = SemanticCallHandoffMembersForSelfHostEffect(effect, divergences);
    var divergence: Int = -1;
    if members != SemanticCallHandoffMembersForSelfHostEffect(effect, 0) {
        divergence = SemanticCallHandoffDivergenceIdSelfUnprovedEffectNotMoving();
    }
    if retains_descriptor {
        members = SemanticCallHandoffJoin(members, SemanticCallHandoffMemberKeep());
    }
    // A Clone landed at this argument hands over the copy, not the binding.
    var origin: Int = SemanticCallHandoffOriginLocal();
    let landed: Bool = SemanticAstCollectionExclusiveCompilerCloneNodeSelected(
        compiler_clone_expression_node_ids, edge.argument_node);
    if landed { origin = SemanticCallHandoffOriginFresh(); }
    var definition_count: Int = 0;
    var candidate: Int = 0;
    while candidate < ArrayLength(definitions.binding_rows) {
        if definitions.binding_rows[candidate] == row { definition_count = definition_count + 1; }
        candidate = candidate + 1;
    }
    var later: Int = SemanticCallHandoffLaterUsedAgain();
    if SemanticAstCollectionEffectSiteTerminatesFlow(artifact, syntax_id) ||
        SemanticAstCollectionCallRetirementSiteForOrigin(artifact, syntax_id, binding_id) > 0 {
        later = SemanticCallHandoffLaterOnce();
    }
    // The renderer refuses a rule that hands off a site used again, so the
    // answer for the site's own later use decides.
    let action_code: Int = SemanticCallHandoffAction(members, origin, later,
        SemanticCallHandoffContextSync(), SemanticCallHandoffElementsAsGiven(), divergences);
    let handed_off: Bool = action_code == SemanticCallHandoffActionHandOff() &&
        definition_count == 1 &&
        origins[row] != SemanticAstCollectionOriginMemberMove() &&
        dispositions[row] == SemanticAstCollectionDispositionLive() &&
        ownership[row] != SemanticAstCollectionOwnershipRetired();
    if tracked && function_id > 0 {
        SemanticAstCollectionCallHandoffLedgerNoteClass(ledger,
            signatures.function_node_ids[formal.signature_row], formal.ordinal, members, divergence);
        SemanticAstCollectionCallHandoffLedgerAppendAction(ledger, function_id, edge.call_node,
            surfaces.expression_graph.arena.call_target_names[edge.call_node], formal.ordinal,
            binding_id, landed, members, origin, later, SemanticCallHandoffContextSync(),
            SemanticCallHandoffElementsAsGiven(), action_code, divergence, handed_off);
    }
    // The element ownership stays the state at the hand-off.
    if handed_off { dispositions[row] = SemanticAstCollectionDispositionHandedOff(); }
}
