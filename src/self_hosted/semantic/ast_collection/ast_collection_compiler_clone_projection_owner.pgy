// One readiness seam joins the ownership-selected Clone occurrences to the
// graph overlay consumed by code generation.
import "ast_collection_exclusive_compiler_clone_owner.pgy";
import "../ast_expression/ast_expression_graph_compiler_clone_owner.pgy";

func SemanticAstCollectionCompilerCloneProjectionReady(
    copies: HashMap<String, Int>, ref selected_nodes: Array<Int>,
    ref graph: SemanticExpressionGraphFacts
) -> Bool {
    return SemanticAstCollectionExclusiveCompilerCloneProjectionReady(
            copies, selected_nodes) &&
        SemanticExpressionGraphCompilerCloneLandingsReady(
            graph, selected_nodes);
}
