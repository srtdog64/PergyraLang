// Exclusive-value call-argument boundary: whether an aggregate argument may
// enter its callee as it is, takes a compiler Clone where the call takes it
// (decisions 2026-10-22 and 2026-11-12), or is refused, and why.
import "ast_collection_exclusive_value_mutation_owner.pgy";

// A root that grows in this routine may not be handed, while it stays live, to
// a formal whose storage flows into a result or to a constructor: the result
// would keep the buffer the growth frees.
func SemanticAstCollectionExclusiveSharingUseReady(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts, ref assignments: SemanticAstAssignmentFacts,
    carrying: HashMap<String, Int>, surface_starts: HashMap<String, Int>, surface_ends: HashMap<String, Int>,
    field_reads: HashMap<String, Int>, copies: HashMap<String, Int>, mutating: HashMap<String, Int>,
    growth_sites: HashMap<String, Int>,
    inout consumed: HashMap<String, Int>, function_id: Int, syntax_id: Int, edge: SemanticCallArgumentEdgeView
) -> Bool {
    if !edge.ok { return false; }
    let place: SemanticAstCollectionAggregateSinkPlace = SemanticAstCollectionAggregateSinkPlaceForNode(
        artifact, signatures, locals, inferred_types, surfaces, function_id, syntax_id, edge.argument_node);
    if !place.ok || place.temporary { return true; }
    var root_id: Int = 0 - place.key;
    if place.key >= 0 { root_id = locals.node_ids[place.key]; }
    if !MapHas(mutating, Concat("root:", ToString(root_id))) { return true; }
    // Growth that runs only before this hand-off leaves the result the buffer
    // it took; only a later (or loop-repeated) growth frees it.
    if !SemanticAstCollectionExclusiveRootGrowsAfter(artifact, growth_sites, root_id, syntax_id) { return true; }
    // Storage the routine never grows is never freed by its growth.
    let grown_key: String = Concat("g:", Concat(ToString(root_id), ":"));
    if ArrayLength(place.chain) > 0 && !MapHas(mutating, Concat(grown_key, "*")) {
        let first: Option<String> = SemanticExpressionGraphNodeText(surfaces.expression_graph, place.chain[0]);
        if IsSome(first) && !MapHas(mutating, Concat(grown_key, UnwrapOption(first))) { return true; }
    }
    var carried: Bool = false;
    let constructor: Option<Int> = SemanticExpressionGraphNominalConstructorRow(
        constructors, surfaces.expression_graph, edge.call_node);
    if IsSome(constructor) {
        carried = true;
    } else {
        let formal: SemanticAstCollectionArgumentFormalTarget = SemanticAstCollectionArgumentFormalTargetForArgument(
            signatures, surfaces.expression_graph, edge.call_node, edge.ordinal);
        carried = formal.ok && MapHas(carrying, ToString(formal.syntax_id));
    }
    if !carried { return true; }
    // A copy the fixed point follows into this definition is checked at the
    // growth instead: the alias that grows must outlive every use of it.
    var holder: Int = 0;
    let declared: Option<Int> = SemanticAstLocalBindingIndexForNode(locals, syntax_id);
    let written: Option<Int> = SemanticAstExpressionGraphRootForNode(surfaces, syntax_id, AstExpressionLaneAtom());
    if IsSome(declared) { holder = locals.node_ids[UnwrapOption(declared)]; }
    else if IsSome(SemanticAstAssignmentIndexForNode(assignments, syntax_id)) && IsSome(written) {
        let written_place: SemanticAstCollectionAggregateSinkPlace = SemanticAstCollectionAggregateSinkPlaceForNode(
            artifact, signatures, locals, inferred_types, surfaces, function_id, syntax_id, UnwrapOption(written));
        if written_place.ok && !written_place.temporary && ArrayLength(written_place.chain) == 0 {
            holder = SemanticAstCollectionExclusivePlaceRoot(locals, written_place);
        }
    }
    // A definition that rebuilds the root itself retires the old value here.
    if holder > 0 && (holder == root_id ||
            SemanticAstCollectionExclusiveCopyHeld(copies, surfaces, root_id, place.chain, holder)) {
        return true;
    }
    return SemanticAstCollectionExclusiveConsumedAt(artifact, signatures, constructors, locals, inferred_types,
        surfaces, assignments, surface_starts, surface_ends, field_reads, copies, consumed, function_id, syntax_id,
        edge.argument_node);
}

// A default-mode argument the callee grows, that the caller cannot hand over
// (it is used again, or shared), is copied where the call takes it when Clone
// copies the formal's type whole (decisions 2026-10-22 and 2026-11-12): the
// callee then changes its own copy. Any other such argument stays refused.
func SemanticAstCollectionExclusiveLandMovedArgument(
    ref signatures: SemanticAstFunctionSignatureFacts, ref constructors: SemanticAstNominalConstructorFacts,
    ref surfaces: SemanticAstExpressionSurfaceFacts, mutating: HashMap<String, Int>,
    edge: SemanticCallArgumentEdgeView, inout compiler_clone_expression_node_ids: Array<Int>
) -> Bool {
    if !edge.ok { return false; }
    let formal: SemanticAstCollectionArgumentFormalTarget = SemanticAstCollectionArgumentFormalTargetForArgument(
        signatures, surfaces.expression_graph, edge.call_node, edge.ordinal);
    if !formal.ok || !MapHas(mutating, ToString(formal.syntax_id)) { return false; }
    return SemanticAstCollectionExclusiveLandArgumentCopy(signatures, constructors, formal, edge,
        compiler_clone_expression_node_ids);
}

// A Clone lands at a default-mode argument whose formal type Clone copies whole.
func SemanticAstCollectionExclusiveLandArgumentCopy(
    ref signatures: SemanticAstFunctionSignatureFacts, ref constructors: SemanticAstNominalConstructorFacts,
    formal: SemanticAstCollectionArgumentFormalTarget, edge: SemanticCallArgumentEdgeView,
    inout compiler_clone_expression_node_ids: Array<Int>
) -> Bool {
    if !formal.ok { return false; }
    let mode: Option<Int> = SemanticAstFunctionParamModeAt(signatures, formal.signature_row, formal.ordinal);
    if !IsSome(mode) || UnwrapOption(mode) != 0 { return false; }
    let type_name: String = signatures.param_types[signatures.param_starts[formal.signature_row] + formal.ordinal];
    if !SemanticAstCollectionExclusiveCloneCopiesWhole(constructors, type_name, 0) { return false; }
    if SemanticAstCollectionExclusiveCompilerCloneNodeSelected(compiler_clone_expression_node_ids, edge.argument_node) {
        return true;
    }
    return SemanticAstCollectionExclusiveSelectCompilerCloneNode(compiler_clone_expression_node_ids, edge.argument_node);
}

// A whole local an inout callee grows grows in place exactly as a statement
// push on it does: its own definition shares nothing, no copy of it made
// before the call (or carried round a loop to it) survives, and no followed
// copy is read from the call on. Copies made only after the call name the new
// buffer.
func SemanticAstCollectionExclusiveLocalGrowsInPlace(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts, ref copies: HashMap<String, Int>,
    surface_starts: HashMap<String, Int>, surface_ends: HashMap<String, Int>,
    function_id: Int, syntax_id: Int, row: Int
) -> Bool {
    let key: String = ToString(function_id);
    let local_key: String = ToString(locals.node_ids[row]);
    // A local no copy edge, copy site or shared definition names shares its
    // buffer with nothing, in any order (a routine with a defer has none).
    if !MapHas(copies, Concat("d:", local_key)) &&
        SemanticAstCollectionExclusiveCopyCount(copies, Concat("s_n:", local_key)) == 0 &&
        SemanticAstCollectionExclusiveCopyCount(copies, Concat("from:", local_key)) == 0 &&
        SemanticAstCollectionExclusiveCopyCount(copies, Concat("into:", local_key)) == 0 { return true; }
    if MapHas(copies, Concat("d:", local_key)) || !MapHas(surface_starts, key) ||
        !MapHas(surface_ends, key) || MapGet(surface_starts, key) < 0 { return false; }
    var copy_index: Int = 0;
    while copy_index < SemanticAstCollectionExclusiveCopyCount(copies, Concat("s_n:", local_key)) {
        let copied_at: Int = MapGet(copies, Concat("s_i:", Concat(local_key, Concat(":", ToString(copy_index)))));
        if copied_at <= syntax_id ||
            SemanticAstCollectionExclusiveLoopCarries(artifact, locals.node_ids[row], syntax_id, copied_at) {
            return false;
        }
        copy_index = copy_index + 1;
    }
    let no_chain: Array<Int> = [];
    let whole: SemanticAstCollectionAggregateSinkPlace = SemanticAstCollectionAggregateSinkPlace(
        true, false, row, locals.node_ids[row], 0, no_chain);
    let no_uses: Array<Int> = [];
    let no_grown: Array<String> = [];
    let no_sources: Array<Int> = [];
    return SemanticAstCollectionExclusiveCopiesUnread(artifact, signatures, locals, inferred_types, surfaces,
        copies, whole, MapGet(surface_starts, key), MapGet(surface_ends, key), function_id, syntax_id,
        false, 0, no_uses, false, no_grown, no_sources);
}

// An active focus part handed to the one inout formal of a callee whose result
// is a scalar: the callee can only change the part's storage in place, as a
// statement push on the part does, which the admitted recovery group already
// proved no other copy reads before the part is assigned back.
func SemanticAstCollectionExclusiveFocusPartGrownInPlace(
    ref signatures: SemanticAstFunctionSignatureFacts, ref surfaces: SemanticAstExpressionSurfaceFacts,
    edge: SemanticCallArgumentEdgeView
) -> Bool {
    let formal: SemanticAstCollectionArgumentFormalTarget = SemanticAstCollectionArgumentFormalTargetForArgument(
        signatures, surfaces.expression_graph, edge.call_node, edge.ordinal);
    if !edge.ok || !formal.ok ||
        signatures.param_modes[signatures.param_starts[formal.signature_row] + formal.ordinal] != 1 { return false; }
    let result: String = signatures.return_types[formal.signature_row];
    if result != "Int" && result != "Bool" && result != "Void" && result != "Long" { return false; }
    var inout_count: Int = 0;
    var parameter: Int = signatures.param_starts[formal.signature_row];
    let end: Int = parameter + signatures.param_counts[formal.signature_row];
    while parameter < end {
        if signatures.param_modes[parameter] == 1 { inout_count = inout_count + 1; }
        parameter = parameter + 1;
    }
    return inout_count == 1;
}

// Another argument of the same call names storage overlapping this one's and
// enters an inout formal the callee grows: the growth may free the storage
// this argument still names inside the call.
// Another argument of the same call hands storage overlapping this
// argument's place, or a later argument names its root, or this argument sits
// in a later argument of an enclosing call whose earlier argument hands
// overlapping storage: every argument is evaluated before the callee runs, so
// one argument would read or change the storage another hands over. Native
// refuses such a call instead of copying (call argument move order), and so
// does this owner.
func SemanticAstCollectionExclusiveSiblingArgumentSharesPlace(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    function_id: Int, syntax_id: Int, edge: SemanticCallArgumentEdgeView, end_node: Int
) -> Bool {
    let here: SemanticAstCollectionAggregateSinkPlace = SemanticAstCollectionAggregateSinkPlaceForNode(
        artifact, signatures, locals, inferred_types, surfaces, function_id, syntax_id, edge.argument_node);
    if !edge.ok || !here.ok || here.temporary { return false; }
    let start: Option<Int> = SemanticExpressionGraphSubtreeStart(surfaces.expression_graph, end_node);
    if !IsSome(start) { return true; }
    var node: Int = UnwrapOption(start);
    while node <= end_node {
        let sibling: SemanticCallArgumentEdgeView = SemanticCallArgumentEdgeFromGraph(surfaces.expression_graph, node);
        if sibling.ok && sibling.call_node == edge.call_node && sibling.ordinal != edge.ordinal {
            let there: SemanticAstCollectionAggregateSinkPlace = SemanticAstCollectionAggregateSinkPlaceForNode(
                artifact, signatures, locals, inferred_types, surfaces, function_id, syntax_id, sibling.argument_node);
            if there.ok && !there.temporary && SemanticAstCollectionExclusivePlacesOverlap(surfaces, here, there) {
                return true;
            }
            let leaves: Option<Int> = SemanticExpressionGraphSubtreeStart(surfaces.expression_graph, sibling.argument_node);
            var leaf: Int = sibling.argument_node;
            if IsSome(leaves) { leaf = UnwrapOption(leaves); }
            while sibling.ordinal > edge.ordinal && leaf <= sibling.argument_node {
                if surfaces.expression_graph.arena.topology.node_kinds[leaf] == AstExpressionNodeLeaf() {
                    let named: SemanticAstCollectionAggregateSinkPlace = SemanticAstCollectionAggregateSinkPlaceForNode(
                        artifact, signatures, locals, inferred_types, surfaces, function_id, syntax_id, leaf);
                    if named.ok && !named.temporary && named.key == here.key { return true; }
                }
                leaf = leaf + 1;
            }
        }
        let outer: SemanticCallArgumentEdgeView = SemanticCallArgumentEdgeFromGraph(surfaces.expression_graph, node);
        let outer_start: Option<Int> = SemanticExpressionGraphSubtreeStart(surfaces.expression_graph, outer.argument_node);
        if outer.ok && outer.call_node != edge.call_node && IsSome(outer_start) &&
            UnwrapOption(outer_start) <= edge.argument_node && edge.argument_node < outer.argument_node {
            var other: Int = UnwrapOption(start);
            while other <= end_node {
                let earlier: SemanticCallArgumentEdgeView = SemanticCallArgumentEdgeFromGraph(surfaces.expression_graph, other);
                if earlier.ok && earlier.call_node == outer.call_node && earlier.ordinal < outer.ordinal {
                    let handed: SemanticAstCollectionAggregateSinkPlace = SemanticAstCollectionAggregateSinkPlaceForNode(
                        artifact, signatures, locals, inferred_types, surfaces, function_id, syntax_id, earlier.argument_node);
                    if handed.ok && !handed.temporary && SemanticAstCollectionExclusivePlacesOverlap(surfaces, here, handed) {
                        return true;
                    }
                }
                other = other + 1;
            }
        }
        node = node + 1;
    }
    return false;
}

func SemanticAstCollectionExclusiveSiblingInoutGrows(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts, mutating: HashMap<String, Int>,
    function_id: Int, syntax_id: Int, edge: SemanticCallArgumentEdgeView, end_node: Int
) -> Bool {
    let here: SemanticAstCollectionAggregateSinkPlace = SemanticAstCollectionAggregateSinkPlaceForNode(
        artifact, signatures, locals, inferred_types, surfaces, function_id, syntax_id, edge.argument_node);
    if !edge.ok || !here.ok || here.temporary { return false; }
    let start: Option<Int> = SemanticExpressionGraphSubtreeStart(surfaces.expression_graph, end_node);
    if !IsSome(start) { return false; }
    var node: Int = UnwrapOption(start);
    while node <= end_node {
        let sibling: SemanticCallArgumentEdgeView = SemanticCallArgumentEdgeFromGraph(surfaces.expression_graph, node);
        if sibling.ok && sibling.call_node == edge.call_node && sibling.ordinal != edge.ordinal {
            let formal: SemanticAstCollectionArgumentFormalTarget = SemanticAstCollectionArgumentFormalTargetForArgument(
                signatures, surfaces.expression_graph, sibling.call_node, sibling.ordinal);
            var mode: Int = -1;
            if formal.ok {
                let found: Option<Int> = SemanticAstFunctionParamModeAt(signatures, formal.signature_row, formal.ordinal);
                if IsSome(found) { mode = UnwrapOption(found); }
            }
            let there: SemanticAstCollectionAggregateSinkPlace = SemanticAstCollectionAggregateSinkPlaceForNode(
                artifact, signatures, locals, inferred_types, surfaces, function_id, syntax_id, sibling.argument_node);
            if mode == 1 && MapHas(mutating, ToString(formal.syntax_id)) &&
                SemanticAstCollectionExclusivePlacesOverlap(surfaces, here, there) { return true; }
        }
        node = node + 1;
    }
    return false;
}

// The exclusive-value boundary an argument edge breaks, or "": a mutating
// formal needs an exclusive, consumed argument, and a growing root handed to
// a carrying formal must be consumed there.
func SemanticAstCollectionExclusiveArgumentBoundary(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts, ref assignments: SemanticAstAssignmentFacts,
    inout values: SemanticAstCollectionExclusiveValueFacts, mutating: HashMap<String, Int>,
    inout consumed: HashMap<String, Int>, function_id: Int, syntax_id: Int, edge: SemanticCallArgumentEdgeView,
    ref focus: SemanticAstCollectionFocusRecoveryFacts, ref formal_effects: SemanticAstCollectionFormalEffects, end_node: Int,
    inout compiler_clone_expression_node_ids: Array<Int>
) -> String {
    let binding: SemanticAstLocalBindingIdentity = SemanticAstScopedLocalBindingIdentityForGraphLeaf(
        artifact, locals, inferred_types, function_id, syntax_id, surfaces.expression_graph, edge.argument_node);
    if binding.ok && SemanticAstCollectionFocusRecoveryLocalActive(artifact, focus, function_id, syntax_id,
            locals.node_ids[binding.row]) && SemanticAstCollectionFocusRecoveryCallTargetReady(artifact, signatures,
                surfaces.expression_graph, formal_effects, focus, edge, inferred_types[binding.row], end_node) { return ""; }
    if binding.ok && SemanticAstCollectionFocusRecoveryLocalActive(artifact, focus, function_id, syntax_id,
            locals.node_ids[binding.row]) &&
        SemanticAstCollectionExclusiveFocusPartGrownInPlace(signatures, surfaces, edge) { return ""; }
    // A write-back copy handed to an inout formal comes back to the copy,
    // which the routine assigns back to its source path (see the owner).
    let inout_formal: SemanticAstCollectionArgumentFormalTarget = SemanticAstCollectionArgumentFormalTargetForArgument(
        signatures, surfaces.expression_graph, edge.call_node, edge.ordinal);
    if binding.ok && inout_formal.ok &&
        signatures.param_modes[signatures.param_starts[inout_formal.signature_row] + inout_formal.ordinal] == 1 &&
        SemanticAstCollectionExclusiveWriteBackCopy(artifact, signatures, locals, inferred_types,
            surfaces, assignments, function_id, locals.node_ids[binding.row]) { return ""; }
    // A by-value argument beside an inout argument the callee grows over the
    // same storage takes a copy where the call takes it, or is refused.
    let argument_formal: SemanticAstCollectionArgumentFormalTarget = SemanticAstCollectionArgumentFormalTargetForArgument(
        signatures, surfaces.expression_graph, edge.call_node, edge.ordinal);
    var argument_mode: Int = -1;
    if argument_formal.ok {
        let found_mode: Option<Int> = SemanticAstFunctionParamModeAt(
            signatures, argument_formal.signature_row, argument_formal.ordinal);
        if IsSome(found_mode) { argument_mode = UnwrapOption(found_mode); }
    }
    if argument_mode != 1 && SemanticAstCollectionExclusiveSiblingInoutGrows(artifact, signatures, locals,
            inferred_types, surfaces, mutating, function_id, syntax_id, edge, end_node) {
        if argument_mode == 0 && SemanticAstCollectionExclusiveLandArgumentCopy(signatures, constructors,
                argument_formal, edge, compiler_clone_expression_node_ids) {
            return "";
        }
        return "inout_sibling_grown";
    }
    // The copies map moves out for the entry check and back before any read.
    var copies: HashMap<String, Int> = values.copies;
    let entry_ready: Bool = SemanticAstCollectionExclusiveSinkEntryReady(artifact, signatures, constructors, locals,
            inferred_types, surfaces, assignments, values.shared_results, values.carrying, values.shared_locals,
            values.dep_locals, values.dep_formals, values.dep_paths, values.paths, values.surface_starts,
            values.surface_ends, mutating, consumed, values.empty_locals, values.field_reads, copies, function_id,
            syntax_id, edge);
    values.copies = copies;
    if !entry_ready {
        if !SemanticAstCollectionExclusiveSiblingArgumentSharesPlace(artifact, signatures, locals, inferred_types,
                surfaces, function_id, syntax_id, edge, end_node) &&
            SemanticAstCollectionExclusiveLandMovedArgument(signatures, constructors, surfaces, mutating, edge,
                compiler_clone_expression_node_ids) {
            return "";
        }
        if binding.ok && inout_formal.ok &&
            signatures.param_modes[signatures.param_starts[inout_formal.signature_row] + inout_formal.ordinal] == 1 &&
            SemanticAstCollectionExclusiveLocalGrowsInPlace(artifact, signatures, locals, inferred_types, surfaces,
                values.copies, values.surface_starts, values.surface_ends, function_id, syntax_id, binding.row) {
            return "";
        }
        return "unproved_exclusive_sink_entry";
    }
    if !SemanticAstCollectionExclusiveSharingUseReady(artifact, signatures, constructors, locals, inferred_types,
            surfaces, assignments, values.carrying, values.surface_starts, values.surface_ends, values.field_reads,
            values.copies, mutating, values.growth_sites, consumed, function_id, syntax_id, edge) {
        return "exclusive_root_shared";
    }
    return "";
}
