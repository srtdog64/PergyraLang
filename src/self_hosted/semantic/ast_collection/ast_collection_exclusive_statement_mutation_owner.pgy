// Statement-form exclusive mutation admission and exact compiler-Clone
// detachment proof. General argument/member mutation remains owned by
// ast_collection_exclusive_value_mutation_owner.pgy.
import "ast_collection_exclusive_value_mutation_owner.pgy";
import "ast_collection_call_effect_fact_owner.pgy";

struct SemanticAstCollectionExclusiveStatementMutationProof {
    ok: Bool;
    compiler_clone_storage_detached: Bool;
}

func SemanticAstCollectionExclusiveStatementMutationProofReady(
    compiler_clone_storage_detached: Bool
) -> SemanticAstCollectionExclusiveStatementMutationProof {
    return SemanticAstCollectionExclusiveStatementMutationProof(
        true, compiler_clone_storage_detached);
}

func SemanticAstCollectionExclusiveStatementMutationProofInvalid(
) -> SemanticAstCollectionExclusiveStatementMutationProof {
    return SemanticAstCollectionExclusiveStatementMutationProof(false, false);
}

// A constructor escape no longer names the caller's storage only when every
// reached input of the current definition has an exact compiler Clone. Other
// retained-formal escapes remain owned by the call-effect fact and fail closed.
func SemanticAstCollectionExclusiveCompilerClonesDetachStorageAt(
    artifact: AstTreeArtifact,
    ref call_effects: SemanticAstCollectionCallEffectFacts,
    binding_row: Int, binding_id: Int, current_definition: Int,
    function_id: Int, syntax_id: Int,
    ref compiler_clone_expression_node_ids: Array<Int>
) -> Bool {
    if binding_row < 0 ||
        binding_row >= ArrayLength(call_effects.first_storage_escape_sites) ||
        current_definition < 0 ||
        current_definition >=
            ArrayLength(call_effects.definition_storage_escape_sites) ||
        !SemanticAstCollectionConstructorFieldInputsShapeReady(
            call_effects.constructor_inputs) { return false; }
    let first_escape: Int =
        call_effects.first_storage_escape_sites[binding_row];
    if first_escape <= 0 ||
        !SemanticAstCollectionMutableCallMayBeRetired(
            artifact, syntax_id, first_escape) { return false; }
    var matched: Bool = false;
    var earliest: Int = -1;
    var input: Int = 0;
    while input < ArrayLength(
            call_effects.constructor_inputs.argument_nodes) {
        if call_effects.constructor_inputs.function_ids[input] == function_id &&
            call_effects.constructor_inputs.definition_rows[input] ==
                current_definition &&
            call_effects.constructor_inputs.binding_ids[input] == binding_id {
            let site: Int = SemanticAstCollectionCallRetirementSite(
                artifact,
                call_effects.constructor_inputs.syntax_ids[input]);
            if site <= 0 &&
                SemanticAstCollectionMutableCallMayBeRetired(
                    artifact, syntax_id, site) { return false; }
            if site > 0 &&
                SemanticAstCollectionMutableCallMayBeRetired(
                    artifact, syntax_id, site) {
                matched = true;
                if earliest < 0 || site < earliest { earliest = site; }
                if !SemanticAstCollectionExclusiveCompilerCloneNodeSelected(
                        compiler_clone_expression_node_ids,
                        call_effects.constructor_inputs.argument_nodes[input]) {
                    return false;
                }
            }
        }
        input = input + 1;
    }
    if !matched || earliest != first_escape { return false; }
    var row: Int = 0;
    while row < ArrayLength(
            call_effects.formal_descriptor_retention.local_definitions) {
        if call_effects.formal_descriptor_retention.local_definitions[row] ==
                current_definition &&
            call_effects.formal_descriptor_retention.local_bindings[row] ==
                binding_row &&
            !call_effects.formal_descriptor_retention.local_terminal[row] &&
            SemanticAstCollectionMutableCallMayBeRetired(
                artifact, syntax_id,
                call_effects.formal_descriptor_retention.local_sites[row]) {
            var retained: Bool = false;
            var formal: Int = 0;
            while formal < ArrayLength(
                    call_effects.formal_descriptor_retention.retained_formals) {
                if call_effects.formal_descriptor_retention.retained_formals[formal] ==
                    call_effects.formal_descriptor_retention.local_targets[row] {
                    retained = true;
                }
                formal = formal + 1;
            }
            if retained { return false; }
        }
        row = row + 1;
    }
    return true;
}

// Select the exact earlier carrier when a later mutation would otherwise be
// observed through a surviving copy.  Copy-site rows are produced beside the
// structural copy edge; this source-order consumer never reconstructs them
// from spelling or from a codegen type. With `earlier_only`, a copy the
// mutating statement makes itself is not selected.
func SemanticAstCollectionExclusiveSelectCopiesBeforeMutation(
    artifact: AstTreeArtifact,
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref locals: SemanticAstLocalBindingFacts,
    ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    surface_starts: HashMap<String, Int>,
    surface_ends: HashMap<String, Int>,
    ref copies: HashMap<String, Int>,
    inout compiler_clone_expression_node_ids: Array<Int>, function_id: Int,
    syntax_id: Int, changed_binding: Int, earlier_only: Bool
) -> Bool {
    let function_key: String = ToString(function_id);
    if !MapHas(surface_starts, function_key) ||
        !MapHas(surface_ends, function_key) ||
        MapGet(surface_starts, function_key) < 0 { return false; }
    let count: Int = SemanticAstCollectionExclusiveCopyCount(
        copies, "copy_site_count");
    let function_count: Int = SemanticAstCollectionExclusiveCopyCount(
        copies, Concat("copy_site_function_count:", function_key));
    let site_prefix: String = Concat("copy_site_function_site:", Concat(function_key, ":"));
    let no_uses: Array<Int> = [];
    var position: Int = 0;
    while position < function_count {
        let site_row: String = Concat(site_prefix, ToString(position));
        if !MapHas(copies, site_row) { return false; }
        let site: Int = MapGet(copies, site_row);
        if site < 0 || site >= count { return false; }
        let key: String = ToString(site);
        let function_row: String = Concat("copy_site_function:", key);
        let syntax_row: String = Concat("copy_site_syntax:", key);
        let node_row: String = Concat("copy_site_node:", key);
        let root_row: String = Concat("copy_site_root:", key);
        let source_field_row: String = Concat(
            "copy_site_source_field:", key);
        let holder_row: String = Concat("copy_site_holder:", key);
        let destination_field_row: String = Concat(
            "copy_site_destination_field:", key);
        if !MapHas(copies, function_row) || !MapHas(copies, syntax_row) ||
            !MapHas(copies, node_row) || !MapHas(copies, root_row) ||
            !MapHas(copies, source_field_row) || !MapHas(copies, holder_row) ||
            !MapHas(copies, destination_field_row) { return false; }
        if MapGet(copies, function_row) != function_id { return false; }
        let copy_syntax: Int = MapGet(copies, syntax_row);
        if copy_syntax < syntax_id || (!earlier_only && copy_syntax == syntax_id) {
            let root: Int = MapGet(copies, root_row);
            let holder: Int = MapGet(copies, holder_row);
            var other: Int = 0;
            if root == changed_binding {
                other = holder;
            } else if holder == changed_binding {
                other = root;
            }
            if other > 0 &&
                !SemanticAstCollectionExclusiveBindingUnreadAfter(
                    artifact, signatures, locals, inferred_types, surfaces,
                    MapGet(surface_starts, function_key),
                    MapGet(surface_ends, function_key), function_id,
                    syntax_id, false, 0, no_uses, false, other) {
                SemanticAstCollectionExclusiveSelectCompilerCloneNode(
                    compiler_clone_expression_node_ids,
                    MapGet(copies, node_row));
            }
        }
        position = position + 1;
    }
    return true;
}

// A call-form in-place write in any lane of the statement at `syntax_id`
// (ArraySet, ArraySort or ArrayReverse, decision
// 2026-10-21_array_sort_permutes_in_place) changes the storage of the local
// its first argument names, and a hand-off to an inout formal its callee
// grows or writes in place changes the local handed: the copies of that local a later read sees are
// selected as compiler Clones first, as for a statement-form ArraySet. For
// the hand-off only copies taken in earlier statements are selected: a copy
// the call statement makes (a callee result holding its inout argument) is
// formed after the callee writes, and its node is the inout argument itself.
// A write-back copy (a local defined from a member path and assigned back to
// it) and a local the focus recovery owner holds at the statement keep the
// sharing admitted before, as for a statement-form change of a member path
// (the write-back gap is recorded at SemanticAstCollectionExclusiveWriteBackCopy).
// A receiver that is no local binding (a formal, a member path, a temporary)
// is the formal summary's (ast_collection_exclusive_value_growth_owner.pgy).
func SemanticAstCollectionExclusiveSelectCopiesBeforeInPlaceCalls(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    mutating: HashMap<String, Int>, ref focus: SemanticAstCollectionFocusRecoveryFacts,
    ref assignments: SemanticAstAssignmentFacts,
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    surface_starts: HashMap<String, Int>, surface_ends: HashMap<String, Int>,
    ref copies: HashMap<String, Int>,
    inout compiler_clone_expression_node_ids: Array<Int>, function_id: Int,
    syntax_id: Int
) -> Bool {
    let function_key: String = ToString(function_id);
    if !MapHas(surface_starts, function_key) || !MapHas(surface_ends, function_key) ||
        MapGet(surface_starts, function_key) < 0 { return true; }
    var surface: Int = MapGet(surface_starts, function_key);
    while surface < MapGet(surface_ends, function_key) {
        if surfaces.node_ids[surface] == syntax_id {
            var lane: Int = 0;
            while lane < 3 {
                let slot: Int = surface * 3 + lane;
                if slot < ArrayLength(surfaces.expression_graph.has_roots) && surfaces.expression_graph.has_roots[slot] {
                    let root: Int = surfaces.expression_graph.roots[slot];
                    let start: Option<Int> = SemanticExpressionGraphSubtreeStart(surfaces.expression_graph, root);
                    var node: Int = root + 1;
                    if IsSome(start) { node = UnwrapOption(start); }
                    while node <= root {
                        if surfaces.expression_graph.arena.topology.node_kinds[node] == AstExpressionNodeCallArgument() {
                            let edge: SemanticCallArgumentEdgeView = SemanticCallArgumentEdgeFromGraph(
                                surfaces.expression_graph, node);
                            let formal: SemanticAstCollectionArgumentFormalTarget = SemanticAstCollectionArgumentFormalTargetForArgument(
                                signatures, surfaces.expression_graph, edge.call_node, edge.ordinal);
                            // An inout formal the callee grows or writes in place changes
                            // the local handed to it (decision 2026-10-21 rule 2).
                            let inout_writer: Bool = formal.ok &&
                                signatures.param_modes[signatures.param_starts[formal.signature_row] + formal.ordinal] == 1 &&
                                (MapHas(mutating, ToString(formal.syntax_id)) ||
                                 MapHas(mutating, Concat("w:", ToString(formal.syntax_id))));
                            let in_place: Bool = edge.ordinal == 0 &&
                                SemanticAstCollectionStorageInPlaceWrite(surfaces.expression_graph, edge.call_node);
                            if edge.ok && (inout_writer || in_place) {
                                let written: SemanticAstLocalBindingIdentity = SemanticAstCollectionOwnershipLocalForArgument(
                                    artifact, locals, inferred_types, surfaces, surface, edge.argument_node);
                                if written.ok && !SemanticAstCollectionFocusRecoveryLocalActive(
                                        artifact, focus, function_id, syntax_id, locals.node_ids[written.row]) &&
                                    !SemanticAstCollectionExclusiveWriteBackCopy(artifact, signatures, locals,
                                        inferred_types, surfaces, assignments, function_id, locals.node_ids[written.row]) &&
                                    !SemanticAstCollectionExclusiveSelectCopiesBeforeMutation(
                                        artifact, signatures, locals, inferred_types, surfaces,
                                        surface_starts, surface_ends, copies,
                                        compiler_clone_expression_node_ids, function_id, syntax_id,
                                        locals.node_ids[written.row], !in_place) {
                                    return false;
                                }
                            }
                        }
                        node = node + 1;
                    }
                }
                lane = lane + 1;
            }
        }
        surface = surface + 1;
    }
    return true;
}

// A statement-form change whose receiver is a member path of a local changes
// that local's storage at the path's first field. Copies a later reader would
// see changed are selected as compiler Clones first, as for a local receiver.
// A growth retires the buffer every copy of that storage names, so it is
// admitted only where the local may grow in place: its own definition shares
// nothing, no copy of it made before the growth survives, neither the local
// nor the field the growth reaches is shared, and no followed copy is read
// from here on. A receiver whose root is no binding fails closed; a call or
// constructor result is a temporary no other value names. A formal receiver
// and a write-back copy keep their earlier admission (see the growth owner).
func SemanticAstCollectionExclusivePlaceStatementRootReady(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts, ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts, ref assignments: SemanticAstAssignmentFacts,
    shared_locals: HashMap<String, Int>,
    function_id: Int, syntax_id: Int, kind: Int, ref focus: SemanticAstCollectionFocusRecoveryFacts,
    ref copies: HashMap<String, Int>, inout compiler_clone_expression_node_ids: Array<Int>,
    surface_starts: HashMap<String, Int>, surface_ends: HashMap<String, Int>
) -> SemanticAstCollectionExclusiveStatementMutationProof {
    let place: SemanticAstCollectionAggregateSinkPlace = SemanticAstCollectionExclusiveStatementTargetPlace(
        artifact, signatures, locals, inferred_types, surfaces, function_id, syntax_id);
    if !place.ok { return SemanticAstCollectionExclusiveStatementMutationProofInvalid(); }
    if place.temporary { return SemanticAstCollectionExclusiveStatementMutationProofReady(false); }
    let root: Int = SemanticAstCollectionExclusivePlaceRoot(locals, place);
    // A formal root grows the caller's argument: the mutating-formal summary
    // carries that to every call site, which copies or refuses there.
    if place.key < 0 || SemanticAstCollectionExclusiveWriteBackCopy(artifact, signatures, locals, inferred_types,
            surfaces, assignments, function_id, root) {
        return SemanticAstCollectionExclusiveStatementMutationProofReady(false);
    }
    var field: String = "*";
    if ArrayLength(place.chain) > 0 {
        let first: Option<String> = SemanticExpressionGraphNodeText(surfaces.expression_graph, place.chain[0]);
        if !IsSome(first) { return SemanticAstCollectionExclusiveStatementMutationProofInvalid(); }
        field = UnwrapOption(first);
    }
    if place.key >= 0 && SemanticAstCollectionFocusRecoveryLocalActive(artifact, focus, function_id, syntax_id, root) {
        return SemanticAstCollectionExclusiveStatementMutationProofReady(false);
    }
    if !SemanticAstCollectionExclusiveSelectCopiesBeforeMutation(
            artifact, signatures, locals, inferred_types, surfaces,
            surface_starts, surface_ends, copies,
            compiler_clone_expression_node_ids, function_id, syntax_id, root, false) {
        return SemanticAstCollectionExclusiveStatementMutationProofInvalid();
    }
    let key: String = ToString(function_id);
    if kind != TypedAstKindArrayPushStmtTag() && kind != TypedAstKindArrayPopStmtTag() {
        if place.key >= 0 && SemanticAstCollectionExclusiveInPlaceWriteUnfollowed(artifact, signatures, locals,
                inferred_types, surfaces, assignments, copies, surface_starts, surface_ends, function_id,
                syntax_id, root) {
            return SemanticAstCollectionExclusiveStatementMutationProofInvalid();
        }
        return SemanticAstCollectionExclusiveStatementMutationProofReady(false);
    }
    let root_key: String = ToString(root);
    // A field whose defining constructor argument is a landed Clone owns a
    // copy no other value names, whatever its sibling fields share.
    let field_landed: Bool = field != "*" && SemanticAstCollectionExclusiveFieldArgumentLanded(
        constructors, locals, surfaces, compiler_clone_expression_node_ids, root, field);
    if place.key >= 0 && !field_landed && MapHas(copies, Concat("d:", root_key)) {
        return SemanticAstCollectionExclusiveStatementMutationProofInvalid();
    }
    var copy_index: Int = 0;
    while copy_index < SemanticAstCollectionExclusiveCopyCount(copies, Concat("s_n:", root_key)) {
        let copied_at: Int = MapGet(copies, Concat("s_i:", Concat(root_key, Concat(":", ToString(copy_index)))));
        if copied_at <= syntax_id || SemanticAstCollectionExclusiveLoopCarries(artifact, root, syntax_id, copied_at) {
            return SemanticAstCollectionExclusiveStatementMutationProofInvalid();
        }
        copy_index = copy_index + 1;
    }
    // The root's value, or the first field the growth reaches, is not shared
    // (a local whose definition or a constructor input shares that field);
    // a landed field shares nothing, but a shared root value still refuses.
    if !SemanticAstCollectionExclusiveMemberRootReady(signatures, locals, shared_locals, function_id, root, field) &&
        (MapHas(shared_locals, root_key) || !field_landed) {
        return SemanticAstCollectionExclusiveStatementMutationProofInvalid();
    }
    let no_uses: Array<Int> = [];
    let no_grown: Array<String> = [];
    let no_sources: Array<Int> = [];
    let ready: Bool = SemanticAstCollectionExclusiveCopiesUnread(artifact, signatures, locals, inferred_types, surfaces,
        copies, place, MapGet(surface_starts, key), MapGet(surface_ends, key), function_id, syntax_id,
        false, 0, no_uses, false, no_grown, no_sources);
    return SemanticAstCollectionExclusiveStatementMutationProof(ready, false);
}

// The binding a copy statement gives the copy to: a local's declaration, or
// the whole local or formal an assignment rebinds; 0 for any other statement.
func SemanticAstCollectionExclusiveCopyStatementHolder(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts, ref assignments: SemanticAstAssignmentFacts,
    function_id: Int, statement: Int
) -> Int {
    if IsSome(SemanticAstLocalBindingIndexForNode(locals, statement)) { return statement; }
    let assigned: Option<Int> = SemanticAstAssignmentIndexForNode(assignments, statement);
    if !IsSome(assigned) || assignments.target_is_indexed[UnwrapOption(assigned)] != 0 { return 0; }
    let target: Option<Int> = SemanticAstExpressionGraphRootForNode(surfaces, statement, AstExpressionLaneAtom());
    if !IsSome(target) { return 0; }
    let place: SemanticAstCollectionAggregateSinkPlace = SemanticAstCollectionAggregateSinkPlaceForNode(
        artifact, signatures, locals, inferred_types, surfaces, function_id, statement, UnwrapOption(target));
    if !place.ok || place.temporary || ArrayLength(place.chain) > 0 { return 0; }
    return SemanticAstCollectionExclusivePlaceRoot(locals, place);
}

// An in-place write at `syntax_id` through the local `root` changes storage a
// name the analysis does not follow reads later: a copy of the root made
// before the write (or carried round a loop to it) went to an unfollowed
// holder that is read from here on, or to no binding; or the root's own
// definition copied another local's storage without following it, and that
// local is read from here on. Native lands a copy at that copy; this front end
// has no followed site there, so the write is refused. A root whose
// definition is a call or constructor result (a Slice view among them) keeps
// its earlier admission, as does a copy of a formal's storage.
func SemanticAstCollectionExclusiveInPlaceWriteUnfollowed(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts, ref assignments: SemanticAstAssignmentFacts,
    ref copies: HashMap<String, Int>, surface_starts: HashMap<String, Int>, surface_ends: HashMap<String, Int>,
    function_id: Int, syntax_id: Int, root: Int
) -> Bool {
    let key: String = ToString(function_id);
    let root_key: String = ToString(root);
    let ordered: Bool = MapHas(surface_starts, key) && MapHas(surface_ends, key) &&
        MapGet(surface_starts, key) >= 0;
    let no_uses: Array<Int> = [];
    var copy_index: Int = 0;
    while copy_index < SemanticAstCollectionExclusiveCopyCount(copies, Concat("s_n:", root_key)) {
        let copied_at: Int = MapGet(copies, Concat("s_i:", Concat(root_key, Concat(":", ToString(copy_index)))));
        if copied_at <= syntax_id || SemanticAstCollectionExclusiveLoopCarries(artifact, root, syntax_id, copied_at) {
            let holder: Int = SemanticAstCollectionExclusiveCopyStatementHolder(artifact, signatures, locals,
                inferred_types, surfaces, assignments, function_id, copied_at);
            if holder != root && (holder <= 0 || !ordered ||
                    !SemanticAstCollectionExclusiveBindingUnreadAfter(artifact, signatures, locals, inferred_types,
                        surfaces, MapGet(surface_starts, key), MapGet(surface_ends, key), function_id, syntax_id,
                        false, 0, no_uses, false, holder)) {
                return true;
            }
        }
        copy_index = copy_index + 1;
    }
    if !MapHas(copies, Concat("d:", root_key)) { return false; }
    let value: Option<Int> = SemanticAstExpressionGraphRootForNode(surfaces, root, AstExpressionLaneValue());
    if !IsSome(value) { return false; }
    let source: SemanticAstCollectionAggregateSinkPlace = SemanticAstCollectionAggregateSinkPlaceForNode(
        artifact, signatures, locals, inferred_types, surfaces, function_id, root, UnwrapOption(value));
    if !source.ok || source.temporary || source.key < 0 { return false; }
    let from: Int = SemanticAstCollectionExclusivePlaceRoot(locals, source);
    return from != root && (!ordered ||
        !SemanticAstCollectionExclusiveBindingUnreadAfter(artifact, signatures, locals, inferred_types, surfaces,
            MapGet(surface_starts, key), MapGet(surface_ends, key), function_id, syntax_id, false, 0, no_uses,
            false, from));
}

// The local `root` is defined by a nominal constructor whose argument for
// `field` is a landed compiler Clone.
func SemanticAstCollectionExclusiveFieldArgumentLanded(
    ref constructors: SemanticAstNominalConstructorFacts, ref locals: SemanticAstLocalBindingFacts,
    ref surfaces: SemanticAstExpressionSurfaceFacts, ref compiler_clone_expression_node_ids: Array<Int>,
    root: Int, field: String
) -> Bool {
    if !IsSome(SemanticAstLocalBindingIndexForNode(locals, root)) { return false; }
    let value: Option<Int> = SemanticAstExpressionGraphRootForNode(surfaces, root, AstExpressionLaneValue());
    if !IsSome(value) { return false; }
    let call: SemanticCallSpineView = SemanticCallSpineViewFromGraph(surfaces.expression_graph, UnwrapOption(value));
    if !call.ok { return false; }
    let row: Option<Int> = SemanticExpressionGraphNominalConstructorRow(constructors, surfaces.expression_graph, call.call_node);
    if !IsSome(row) || constructors.param_counts[UnwrapOption(row)] != ArrayLength(call.argument_nodes) { return false; }
    let start: Int = constructors.param_starts[UnwrapOption(row)];
    var ordinal: Int = 0;
    while ordinal < ArrayLength(call.argument_nodes) {
        if constructors.field_names[start + ordinal] == field {
            return SemanticAstCollectionExclusiveCompilerCloneNodeSelected(
                compiler_clone_expression_node_ids, call.argument_nodes[ordinal]);
        }
        ordinal = ordinal + 1;
    }
    return false;
}

// The statement-form mutation at `syntax_id` targets no member alias, or one
// whose root may grow in place.
func SemanticAstCollectionExclusiveStatementRootReady(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts, ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts, ref statements: SemanticAstStatementFacts,
    ref assignments: SemanticAstAssignmentFacts, shared_locals: HashMap<String, Int>,
    mutating: HashMap<String, Int>, ref origins: Array<Int>, ref source_binding_syntax_ids: Array<Int>,
    function_id: Int, syntax_id: Int, ref focus: SemanticAstCollectionFocusRecoveryFacts,
    ref copies: HashMap<String, Int>,
    inout compiler_clone_expression_node_ids: Array<Int>,
    ref call_effects: SemanticAstCollectionCallEffectFacts,
    ref current_definitions: Array<Int>,
    surface_starts: HashMap<String, Int>, surface_ends: HashMap<String, Int>
) -> SemanticAstCollectionExclusiveStatementMutationProof {
    if !SemanticAstCollectionExclusiveSelectCopiesBeforeInPlaceCalls(
            artifact, signatures, mutating, focus, assignments, locals, inferred_types, surfaces,
            surface_starts, surface_ends, copies,
            compiler_clone_expression_node_ids, function_id, syntax_id) {
        return SemanticAstCollectionExclusiveStatementMutationProofInvalid();
    }
    // Only a reallocating mutation retires the buffer other copies name;
    // ArraySet and an indexed assignment write in place. The statement facts
    // track no assignment, so an indexed assignment is found in the
    // assignment facts and keeps its own statement kind.
    let indexed: Option<Int> = SemanticAstStatementIndexForNode(statements, syntax_id);
    let assignment: Option<Int> = SemanticAstAssignmentIndexForNode(
        assignments, syntax_id);
    let indexed_assignment: Bool = IsSome(assignment) &&
        assignments.target_is_indexed[UnwrapOption(assignment)] != 0;
    if !IsSome(indexed) && !indexed_assignment {
        return SemanticAstCollectionExclusiveStatementMutationProofReady(false);
    }
    var kind: Int = TypedAstKindAssignStmtTag();
    if IsSome(indexed) { kind = statements.kind_tags[UnwrapOption(indexed)]; }
    let mutates_storage: Bool = kind == TypedAstKindArrayPushStmtTag() ||
        kind == TypedAstKindArrayPopStmtTag() ||
        kind == TypedAstKindArraySetStmtTag() || indexed_assignment;
    if !mutates_storage {
        return SemanticAstCollectionExclusiveStatementMutationProofReady(false);
    }
    let target: SemanticAstLocalBindingIdentity = SemanticAstCollectionOwnershipLocalForStatementTarget(
        artifact, locals, inferred_types, surfaces, function_id, syntax_id);
    if !target.ok {
        return SemanticAstCollectionExclusivePlaceStatementRootReady(artifact, signatures, constructors, locals,
            inferred_types, surfaces, assignments, shared_locals, function_id, syntax_id, kind, focus, copies,
            compiler_clone_expression_node_ids, surface_starts, surface_ends);
    }
    // A routine with a defer has no single ordered surface range, so copy
    // selection cannot run there. A focus part grows the field copy the
    // admitted recovery group restores, and that admission already proved its
    // copies unread; it is admitted without the selection. Every other
    // routine still selects its copies below.
    let function_key: String = ToString(function_id);
    let ordered: Bool = MapHas(surface_starts, function_key) && MapGet(surface_starts, function_key) >= 0;
    if !ordered && (kind == TypedAstKindArrayPushStmtTag() || kind == TypedAstKindArrayPopStmtTag()) &&
        SemanticAstCollectionFocusRecoveryLocalActive(artifact, focus, function_id, syntax_id, locals.node_ids[target.row]) {
        return SemanticAstCollectionExclusiveStatementMutationProofReady(false);
    }
    if !SemanticAstCollectionExclusiveSelectCopiesBeforeMutation(
            artifact, signatures, locals, inferred_types, surfaces,
            surface_starts, surface_ends, copies,
            compiler_clone_expression_node_ids,
            function_id, syntax_id, locals.node_ids[target.row], false) {
        return SemanticAstCollectionExclusiveStatementMutationProofInvalid();
    }
    // In-place element writes need independent value semantics but do not
    // retire the shared descriptor: no name the copies above do not follow
    // may read the write. A focus part writes the field copy its admitted
    // recovery group lands. Growth keeps the existing exclusivity admission
    // below.
    if kind != TypedAstKindArrayPushStmtTag() &&
        kind != TypedAstKindArrayPopStmtTag() {
        if !SemanticAstCollectionFocusRecoveryLocalActive(artifact, focus, function_id, syntax_id,
                locals.node_ids[target.row]) &&
            SemanticAstCollectionExclusiveInPlaceWriteUnfollowed(artifact, signatures, locals, inferred_types,
                surfaces, assignments, copies, surface_starts, surface_ends, function_id, syntax_id,
                locals.node_ids[target.row]) {
            return SemanticAstCollectionExclusiveStatementMutationProofInvalid();
        }
        var detached: Bool = false;
        if target.row < ArrayLength(current_definitions) {
            detached = SemanticAstCollectionExclusiveCompilerClonesDetachStorageAt(
                artifact, call_effects, target.row,
                locals.node_ids[target.row], current_definitions[target.row],
                function_id, syntax_id,
                compiler_clone_expression_node_ids);
        }
        return SemanticAstCollectionExclusiveStatementMutationProofReady(
            detached);
    }
    if target.row >= ArrayLength(origins) {
        return SemanticAstCollectionExclusiveStatementMutationProofReady(false);
    }
    if SemanticAstCollectionFocusRecoveryLocalActive(artifact, focus, function_id, syntax_id, locals.node_ids[target.row]) {
        return SemanticAstCollectionExclusiveStatementMutationProofReady(false);
    }
    // A local that shares its buffer grows it under every other name: its
    // own definition names shared storage, a copy of it made before the
    // growth (or carried round a loop to it) survives, or a followed copy is
    // read from here on. A copy made after the growth names the new buffer.
    if origins[target.row] != SemanticAstCollectionOriginMemberMove() {
        let key: String = ToString(function_id);
        let local_key: String = ToString(locals.node_ids[target.row]);
        if MapHas(copies, Concat("d:", local_key)) || !MapHas(surface_starts, key) ||
            !MapHas(surface_ends, key) || MapGet(surface_starts, key) < 0 {
            return SemanticAstCollectionExclusiveStatementMutationProofInvalid();
        }
        var copy_index: Int = 0;
        while copy_index < SemanticAstCollectionExclusiveCopyCount(copies, Concat("s_n:", local_key)) {
            let copied_at: Int = MapGet(copies, Concat("s_i:", Concat(local_key, Concat(":", ToString(copy_index)))));
            if copied_at <= syntax_id ||
                SemanticAstCollectionExclusiveLoopCarries(artifact, locals.node_ids[target.row], syntax_id, copied_at) {
                return SemanticAstCollectionExclusiveStatementMutationProofInvalid();
            }
            copy_index = copy_index + 1;
        }
        let no_chain: Array<Int> = [];
        let grown_place: SemanticAstCollectionAggregateSinkPlace = SemanticAstCollectionAggregateSinkPlace(
            true, false, target.row, locals.node_ids[target.row], 0, no_chain);
        let no_uses: Array<Int> = [];
        let no_grown: Array<String> = [];
        let no_sources: Array<Int> = [];
        let ready: Bool = SemanticAstCollectionExclusiveCopiesUnread(artifact, signatures, locals, inferred_types, surfaces,
            copies, grown_place, MapGet(surface_starts, key), MapGet(surface_ends, key), function_id, syntax_id,
            false, 0, no_uses, false, no_grown, no_sources);
        return SemanticAstCollectionExclusiveStatementMutationProof(
            ready, false);
    }
    // The alias must have consumed its source: no later read sees the old buffer.
    if MapHas(shared_locals, ToString(locals.node_ids[target.row])) {
        return SemanticAstCollectionExclusiveStatementMutationProofInvalid();
    }
    let ready: Bool = SemanticAstCollectionExclusiveMemberRootReady(signatures, locals, shared_locals, function_id,
        source_binding_syntax_ids[target.row], SemanticAstCollectionExclusiveAliasField(surfaces, locals,
            mutating, target.row));
    return SemanticAstCollectionExclusiveStatementMutationProof(
        ready, false);
}

// Whether a member alias of the first field `field` ("*": unknown) of the root
// binding `root_id` may grow in place: an exclusive local, or a formal that is
// not ref, whose field shares no storage.
