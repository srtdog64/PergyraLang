// Exclusive-value fact allocation and program construction.

import "ast_collection_exclusive_value_class_owner.pgy";
import "../ast_expression/ast_expression_graph_collection_call_protocol_owner.pgy";
import "ast_collection_exclusive_value_dead_definition_owner.pgy";
import "../ast_expression/ast_expression_graph_call_view_owner.pgy";
import "../ast_expression/ast_expression_graph_array_literal_owner.pgy";
import "../ast_nominal_constructor_lookup_owner.pgy";
import "ast_collection_ownership_state_owner.pgy";
import "../ast_type_name_canonical_owner.pgy";
import "ast_collection_exclusive_copy_site_projection_owner.pgy";
import "ast_collection_exclusive_whole_carried_field_owner.pgy";
import "ast_collection_exclusive_value_classification_owner.pgy";

// Locals every definition of which is an empty array literal and that are
// never the receiver of a growth or an inout argument.
func SemanticAstCollectionExclusiveEmptyLocals(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts, ref assignments: SemanticAstAssignmentFacts,
    ref statements: SemanticAstStatementFacts
) -> HashMap<String, Int> {
    var grown: HashMap<String, Int> = MapNew();
    var statement: Int = 0;
    while statement < ArrayLength(statements.node_ids) {
        let kind: Int = statements.kind_tags[statement];
        if kind == TypedAstKindArrayPushStmtTag() || kind == TypedAstKindArraySetStmtTag() ||
            kind == TypedAstKindArrayPopStmtTag() {
            let target: SemanticAstLocalBindingIdentity = SemanticAstCollectionOwnershipLocalForStatementTarget(
                artifact, locals, inferred_types, surfaces, statements.function_node_ids[statement],
                statements.node_ids[statement]);
            if target.ok { MapSet(grown, ToString(locals.node_ids[target.row]), 1); }
        }
        statement = statement + 1;
    }
    var assignment: Int = 0;
    while assignment < ArrayLength(assignments.node_ids) {
        if assignments.target_is_indexed[assignment] != 0 {
            let target: SemanticAstLocalBindingIdentity = SemanticAstCollectionOwnershipLocalForStatementTarget(
                artifact, locals, inferred_types, surfaces, assignments.function_node_ids[assignment],
                assignments.node_ids[assignment]);
            if target.ok { MapSet(grown, ToString(locals.node_ids[target.row]), 1); }
        }
        assignment = assignment + 1;
    }
    var slot: Int = 0;
    while slot < ArrayLength(surfaces.expression_graph.roots) {
        if surfaces.expression_graph.has_roots[slot] {
            let root: Int = surfaces.expression_graph.roots[slot];
            let start: Option<Int> = SemanticExpressionGraphSubtreeStart(surfaces.expression_graph, root);
            var node: Int = root + 1;
            if IsSome(start) { node = UnwrapOption(start); }
            while node <= root {
                if surfaces.expression_graph.arena.topology.node_kinds[node] == AstExpressionNodeCallArgument() {
                    let edge: SemanticCallArgumentEdgeView = SemanticCallArgumentEdgeFromGraph(surfaces.expression_graph, node);
                    if edge.ok {
                        let binding: SemanticAstLocalBindingIdentity = SemanticAstCollectionOwnershipLocalForArgument(
                            artifact, locals, inferred_types, surfaces, slot / 3, edge.argument_node);
                        let formal: SemanticAstCollectionArgumentFormalTarget = SemanticAstCollectionArgumentFormalTargetForArgument(
                            signatures, surfaces.expression_graph, edge.call_node, edge.ordinal);
                        var inout_formal: Bool = false;
                        if formal.ok {
                            let mode: Option<Int> = SemanticAstFunctionParamModeAt(signatures, formal.signature_row, formal.ordinal);
                            inout_formal = !IsSome(mode) || UnwrapOption(mode) == 1;
                        }
                        let builtin_growth: Bool = edge.ordinal == 0 &&
                            (SemanticAstCollectionOwnershipBuiltinCall(surfaces.expression_graph, edge.call_node, "ArrayPush") ||
                             SemanticAstCollectionOwnershipBuiltinCall(surfaces.expression_graph, edge.call_node, "ArraySet") ||
                             SemanticAstCollectionOwnershipBuiltinCall(surfaces.expression_graph, edge.call_node, "ArrayPop") ||
                             SemanticAstCollectionOwnershipBuiltinCall(surfaces.expression_graph, edge.call_node, "ArrayPushOwnedString"));
                        if binding.ok && (inout_formal || builtin_growth) {
                            MapSet(grown, ToString(locals.node_ids[binding.row]), 1);
                        }
                    }
                }
                node = node + 1;
            }
        }
        slot = slot + 1;
    }
    var candidates: HashMap<String, Int> = MapNew();
    var disqualified: HashMap<String, Int> = MapNew();
    var row: Int = 0;
    while row < ArrayLength(locals.node_ids) {
        let value: Option<Int> = SemanticAstExpressionGraphRootForNode(
            surfaces, locals.node_ids[row], AstExpressionLaneValue());
        if IsSome(value) {
            let literal: SemanticArrayLiteralView = SemanticArrayLiteralViewFromGraph(
                surfaces.expression_graph, UnwrapOption(value));
            if literal.ok && ArrayLength(literal.element_nodes) == 0 {
                MapSet(candidates, ToString(locals.node_ids[row]), 1);
            }
        }
        row = row + 1;
    }
    row = 0;
    while row < ArrayLength(assignments.node_ids) {
        let target: Option<Int> = SemanticAstExpressionGraphRootForNode(
            surfaces, assignments.node_ids[row], AstExpressionLaneAtom());
        let value: Option<Int> = SemanticAstExpressionGraphRootForNode(
            surfaces, assignments.node_ids[row], AstExpressionLaneValue());
        if IsSome(target) {
            let written: SemanticAstCollectionAggregateSinkPlace = SemanticAstCollectionAggregateSinkPlaceForNode(
                artifact, signatures, locals, inferred_types, surfaces, assignments.function_node_ids[row],
                assignments.node_ids[row], UnwrapOption(target));
            if written.ok && !written.temporary && written.key >= 0 {
                var empty_value: Bool = false;
                if IsSome(value) {
                    let literal: SemanticArrayLiteralView = SemanticArrayLiteralViewFromGraph(
                        surfaces.expression_graph, UnwrapOption(value));
                    empty_value = literal.ok && ArrayLength(literal.element_nodes) == 0;
                }
                if !empty_value || ArrayLength(written.chain) != 0 ||
                    assignments.target_is_indexed[row] != 0 {
                    MapSet(disqualified, ToString(locals.node_ids[written.key]), 1);
                }
            }
        }
        row = row + 1;
    }
    var empty_locals: HashMap<String, Int> = MapNew();
    let keys: Array<String> = MapKeys(candidates);
    var index: Int = 0;
    while index < ArrayLength(keys) {
        if !MapHas(disqualified, keys[index]) && !MapHas(grown, keys[index]) {
            MapSet(empty_locals, keys[index], 1);
        }
        index = index + 1;
    }
    return empty_locals;
}

// The greatest fixed point over every routine: results and locals start
// exclusive, and a round only marks more of them shared or adds dependencies.
// A table that has not converged within its bound is not admitted.
func SemanticAstCollectionExclusiveValueFactsFrom(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts, ref assignments: SemanticAstAssignmentFacts,
    ref statements: SemanticAstStatementFacts
) -> SemanticAstCollectionExclusiveValueFacts {
    var starts: HashMap<String, Int> = MapNew();
    var ends: HashMap<String, Int> = MapNew();
    SemanticAstCollectionExclusiveSurfaceRanges(artifact, surfaces, starts, ends);
    let shared_results: HashMap<String, Int> = MapNew();
    let carrying: HashMap<String, Int> = MapNew();
    let shared_locals: HashMap<String, Int> = MapNew();
    let dep_locals: Array<Int> = [];
    let dep_formals: Array<Int> = [];
    let dep_paths: Array<Int> = [];
    let paths: Array<String> = [];
    let consumed_uses: HashMap<String, Int> = MapNew();
    let empty_locals: HashMap<String, Int> = SemanticAstCollectionExclusiveEmptyLocals(
        artifact, signatures, locals, inferred_types, surfaces, assignments, statements);
    let field_reads: HashMap<String, Int> = SemanticAstCollectionExclusiveFieldReads(artifact, signatures, surfaces);
    let no_copies: HashMap<String, Int> = MapNew();
    var facts: SemanticAstCollectionExclusiveValueFacts = SemanticAstCollectionExclusiveValueFacts(
        false, shared_results, carrying, shared_locals, dep_locals, dep_formals, dep_paths, paths, starts, ends, consumed_uses,
        empty_locals, field_reads, no_copies);
    if !locals.ok || !assignments.ok || !statements.ok ||
        ArrayLength(inferred_types) != ArrayLength(locals.node_ids) ||
        MapHas(field_reads, "unconverged") { return facts; }
    // A definition of a place no path reads aliases nothing.
    var dead_definitions: HashMap<String, Int> = MapNew();
    var dead_row: Int = 0;
    while dead_row < ArrayLength(locals.node_ids) {
        let dead_function: String = ToString(locals.function_node_ids[dead_row]);
        let dead_value: Option<Int> = SemanticAstExpressionGraphRootForNode(
            surfaces, locals.node_ids[dead_row], AstExpressionLaneValue());
        if !SemanticAstCollectionExclusiveUntrackedType(inferred_types[dead_row]) && IsSome(dead_value) &&
            MapHas(starts, dead_function) && MapHas(ends, dead_function) && MapGet(starts, dead_function) >= 0 {
            let source: SemanticAstCollectionAggregateSinkPlace = SemanticAstCollectionAggregateSinkPlaceForNode(
                artifact, signatures, locals, inferred_types, surfaces, locals.function_node_ids[dead_row],
                locals.node_ids[dead_row], UnwrapOption(dead_value));
            if source.ok && !source.temporary && SemanticAstCollectionExclusiveDefinitionDead(artifact, signatures,
                    locals, inferred_types, surfaces, locals.function_node_ids[dead_row],
                    MapGet(starts, dead_function), MapGet(ends, dead_function), locals.node_ids[dead_row]) {
                MapSet(dead_definitions, ToString(locals.node_ids[dead_row]), 1);
            }
        }
        dead_row = dead_row + 1;
    }
    // Whole-local assignment targets, resolved once.
    var assigned_rows: Array<Int> = [];
    var assigned_formals: Array<Int> = [];
    var row: Int = 0;
    while row < ArrayLength(assignments.node_ids) {
        var target_row: Int = -1;
        var target_formal: Int = 0;
        let target: Option<Int> = SemanticAstExpressionGraphRootForNode(
            surfaces, assignments.node_ids[row], AstExpressionLaneAtom());
        if IsSome(target) && assignments.target_is_indexed[row] == 0 {
            let written: SemanticAstCollectionAggregateSinkPlace = SemanticAstCollectionAggregateSinkPlaceForNode(
                artifact, signatures, locals, inferred_types, surfaces, assignments.function_node_ids[row],
                assignments.node_ids[row], UnwrapOption(target));
            if written.ok && !written.temporary && written.key >= 0 && ArrayLength(written.chain) == 0 {
                target_row = written.key;
            }
            if written.ok && !written.temporary && written.key < 0 && ArrayLength(written.chain) == 0 {
                target_formal = 0 - written.key;
            }
        }
        ArrayPush(assigned_rows, target_row);
        ArrayPush(assigned_formals, target_formal);
        row = row + 1;
    }
    var consumed: HashMap<String, Int> = facts.consumed;
    var copied: HashMap<String, Int> = MapNew();
    var edges_seen: Int = 0;
    let bound: Int = ArrayLength(signatures.function_node_ids) + ArrayLength(locals.node_ids) + 2;
    var changed: Bool = true;
    var round: Int = 0;
    while changed && round < bound {
        changed = false;
        var local_row: Int = 0;
        while local_row < ArrayLength(locals.node_ids) {
            if !SemanticAstCollectionExclusiveUntrackedType(inferred_types[local_row]) &&
                !MapHas(dead_definitions, ToString(locals.node_ids[local_row])) {
                let value: Option<Int> = SemanticAstExpressionGraphRootForNode(
                    surfaces, locals.node_ids[local_row], AstExpressionLaneValue());
                if IsSome(value) {
                    let part: SemanticAstCollectionExclusiveClass = SemanticAstCollectionExclusiveClassify(
                        artifact, signatures, constructors, locals, inferred_types, surfaces, assignments,
                        facts.shared_results, facts.carrying, facts.shared_locals, facts.dep_locals,
                        facts.dep_formals, facts.dep_paths, facts.paths, starts, ends, consumed, copied, facts.empty_locals, facts.field_reads,
                        locals.function_node_ids[local_row],
                        locals.node_ids[local_row], UnwrapOption(value), true, 0, locals.node_ids[local_row]);
                    if !part.exclusive { MapSet(copied, Concat("d:", ToString(locals.node_ids[local_row])), 1); }
                    if SemanticAstCollectionExclusiveRecordLocal(facts, locals.node_ids[local_row], part) {
                        changed = true;
                    }
                }
            }
            local_row = local_row + 1;
        }
        row = 0;
        while row < ArrayLength(assignments.node_ids) {
            let target_row: Int = assigned_rows[row];
            var target_id: Int = assigned_formals[row];
            if target_row >= 0 && !SemanticAstCollectionExclusiveUntrackedType(inferred_types[target_row]) {
                target_id = locals.node_ids[target_row];
            }
            if target_id > 0 {
                let value: Option<Int> = SemanticAstExpressionGraphRootForNode(
                    surfaces, assignments.node_ids[row], AstExpressionLaneValue());
                var part: SemanticAstCollectionExclusiveClass = SemanticAstCollectionExclusiveShared();
                if IsSome(value) {
                    part = SemanticAstCollectionExclusiveClassify(
                        artifact, signatures, constructors, locals, inferred_types, surfaces, assignments,
                        facts.shared_results, facts.carrying, facts.shared_locals, facts.dep_locals,
                        facts.dep_formals, facts.dep_paths, facts.paths, starts, ends, consumed, copied, facts.empty_locals, facts.field_reads,
                        assignments.function_node_ids[row],
                        assignments.node_ids[row], UnwrapOption(value), true, 0, target_id);
                }
                if !part.exclusive { MapSet(copied, Concat("d:", ToString(target_id)), 1); }
                if SemanticAstCollectionExclusiveRecordLocal(facts, target_id, part) {
                    changed = true;
                }
            }
            row = row + 1;
        }
        row = 0;
        while row < ArrayLength(statements.node_ids) {
            if statements.kind_tags[row] == TypedAstKindValueReturnStmtTag() {
                let function_id: Int = statements.function_node_ids[row];
                let signature: Option<Int> = SemanticAstFunctionSignatureIndexForNode(signatures, function_id);
                if IsSome(signature) &&
                    !SemanticAstCollectionExclusiveUntrackedType(signatures.return_types[UnwrapOption(signature)]) {
                    // A return carries its value in the Atom lane.
                    let value: Option<Int> = SemanticAstExpressionGraphRootForNode(
                        surfaces, statements.node_ids[row], AstExpressionLaneAtom());
                    var part: SemanticAstCollectionExclusiveClass = SemanticAstCollectionExclusiveShared();
                    if IsSome(value) {
                        part = SemanticAstCollectionExclusiveClassify(
                            artifact, signatures, constructors, locals, inferred_types, surfaces, assignments,
                            facts.shared_results, facts.carrying, facts.shared_locals, facts.dep_locals,
                            facts.dep_formals, facts.dep_paths, facts.paths, starts, ends, consumed, copied, facts.empty_locals, facts.field_reads, function_id,
                            statements.node_ids[row], UnwrapOption(value), false, 0, 0);
                    }
                    if SemanticAstCollectionExclusiveRecordReturn(facts, function_id, part) { changed = true; }
                }
            }
            row = row + 1;
        }
        let copies: Array<String> = MapKeys(copied);
        var shared_rows: HashMap<String, Int> = facts.shared_locals;
        var copy: Int = 0;
        while copy < ArrayLength(copies) {
            let shared_key: String = Substring(copies[copy], 2, StringLength(copies[copy]) - 2);
            if StartsWith(copies[copy], "s:") && !MapHas(shared_rows, shared_key) {
                MapSet(shared_rows, shared_key, 1);
                changed = true;
            }
            copy = copy + 1;
        }
        facts.shared_locals = shared_rows;
        // New copy edges or landings add readers: proofs that read them are redone.
        let edge_count: Int = SemanticAstCollectionExclusiveCopyCount(copied, "edges") +
            SemanticAstCollectionExclusiveCopyCount(copied, "landings");
        if edge_count != edges_seen {
            edges_seen = edge_count;
            changed = true;
        }
        round = round + 1;
    }
    facts.consumed = consumed;
    facts.copies = copied;
    facts.ok = !changed;
    return facts;
}

