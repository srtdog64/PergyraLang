// Functions whose String result never borrows storage an argument reaches.
//
// Every value return of a row is a String literal, a builtin whose result is
// fresh text (the call hand-off rule, TextBuilderFinish), a call to a function
// already in the plan, or a normal String local whose every definition (its
// initializer and each whole-local assignment) is one of those and that no
// call may rebind (the domain exposure facts). A bare return, a formal, an
// element read, a member access, ToString or Clone of a String, or anything
// else leaves the function out, as does an assignment in it whose target does
// not resolve. Bounded fixed point, as the fresh owned Array<String> plan.
import "../ast_assignment_fact_owner.pgy";
import "../ast_declared_runtime_call_identity_owner.pgy";
import "../ast_local_binding_identity_owner.pgy";
import "../ast_statement_fact_owner.pgy";
import "../ast_owned_string_result_domain_owner.pgy";
import "../call_handoff_rule_projection_owner.pgy";
import "ast_collection_ownership_identity_owner.pgy";
import "ast_collection_indexed_string_borrow_call_result_owner.pgy";

struct SemanticAstFreshStringResultPlan {
    ok: Bool;
    functions: HashMap<String, Int>;
}

// The String locals a return may read, and their definitions' value roots.
struct SemanticAstFreshStringResultLocals {
    eligible: Array<Bool>;
    definition_rows: Array<Int>;
    definition_values: Array<Int>;
}

// A direct call whose String result the plan proves fresh: it borrows nothing.
func SemanticAstFreshStringResultCall(
    ref plan: SemanticAstFreshStringResultPlan, ref graph: SemanticExpressionGraphFacts, root: Int
) -> Bool {
    let call: SemanticCallSpineView = SemanticCallSpineViewFromGraph(graph, root);
    if !plan.ok || !call.ok || !SemanticAstIndexedStringBorrowDirectCall(graph, call.call_node) { return false; }
    let target: Option<Int> = SemanticExpressionGraphCallTargetSyntaxId(graph, call.call_node);
    return IsSome(target) && MapHas(plan.functions, ToString(UnwrapOption(target)));
}

func SemanticAstFreshStringResultDirect(
    ref signatures: SemanticAstFunctionSignatureFacts, ref graph: SemanticExpressionGraphFacts,
    ref functions: HashMap<String, Int>, root: Int
) -> Bool {
    let kind: Option<Int> = SemanticExpressionGraphNodeKind(graph, root);
    if !IsSome(kind) { return false; }
    if UnwrapOption(kind) == AstExpressionNodeStringLiteral() { return true; }
    let call: SemanticCallSpineView = SemanticCallSpineViewFromGraph(graph, root);
    if !call.ok { return false; }
    let arity: Int = ArrayLength(call.argument_nodes);
    let name: Option<String> = SemanticExpressionGraphCallTargetName(graph, call.call_node);
    if IsSome(name) && SemanticAstCollectionOwnershipBuiltinCall(graph, call.call_node, UnwrapOption(name)) {
        return UnwrapOption(name) == "TextBuilderFinish" ||
            SemanticCallHandoffStringResultFresh(UnwrapOption(name), arity, "");
    }
    let signature: Option<Int> = SemanticAstDeclaredRuntimeCallSignature(signatures, graph, call.call_node);
    if !IsSome(signature) { return false; }
    let row: Int = UnwrapOption(signature);
    return signatures.return_types[row] == "String" && signatures.param_counts[row] == arity &&
        MapHas(functions, ToString(signatures.function_node_ids[row]));
}

func SemanticAstFreshStringResultLocalsFrom(
    artifact: AstTreeArtifact, ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts, ref assignments: SemanticAstAssignmentFacts,
    ref exposures: SemanticAstOwnedStringDomainExposureFacts, inout tainted: HashMap<String, Int>
) -> SemanticAstFreshStringResultLocals {
    var eligible: Array<Bool> = [];
    var rows: Array<Int> = [];
    var values: Array<Int> = [];
    var rebound: HashMap<String, Int> = MapNew();
    var row: Int = 0;
    while row < ArrayLength(exposures.string_written_source_syntax_ids) {
        MapSet(rebound, ToString(exposures.string_written_source_syntax_ids[row]), 1);
        row = row + 1;
    }
    row = 0;
    while row < ArrayLength(locals.node_ids) {
        let root: Option<Int> = SemanticAstExpressionGraphRootForNode(surfaces, locals.node_ids[row], AstExpressionLaneValue());
        let candidate: Bool = inferred_types[row] == "String" && IsSome(root) &&
            locals.binding_kinds[row] == SemanticAstLocalBindingKindNormal() && locals.binding_indices[row] == 0 &&
            !MapHas(rebound, ToString(locals.node_ids[row]));
        ArrayPush(eligible, candidate);
        if candidate { ArrayPush(rows, row); ArrayPush(values, UnwrapOption(root)); }
        row = row + 1;
    }
    row = 0;
    while row < ArrayLength(assignments.node_ids) {
        if assignments.target_is_indexed[row] == 0 && assignments.target_texts[row] == assignments.target_root_names[row] {
            let target: Option<Int> = SemanticAstExpressionGraphRootForNode(surfaces, assignments.node_ids[row], AstExpressionLaneAtom());
            let value: Option<Int> = SemanticAstExpressionGraphRootForNode(surfaces, assignments.node_ids[row], AstExpressionLaneValue());
            var binding: SemanticAstLocalBindingIdentity = SemanticAstLocalBindingIdentityUnresolved();
            if IsSome(target) {
                binding = SemanticAstScopedLocalBindingIdentityForGraphLeaf(artifact, locals, inferred_types,
                    assignments.function_node_ids[row], assignments.node_ids[row], surfaces.expression_graph, UnwrapOption(target));
            }
            if !binding.ok || binding.row < 0 || binding.row >= ArrayLength(eligible) || !IsSome(value) {
                // An unresolved write may rebind any String local of its routine.
                MapSet(tainted, ToString(assignments.function_node_ids[row]), 1);
            } else if eligible[binding.row] {
                ArrayPush(rows, binding.row);
                ArrayPush(values, UnwrapOption(value));
            }
        }
        row = row + 1;
    }
    return SemanticAstFreshStringResultLocals(eligible, rows, values);
}

// A local is fresh while every definition is fresh under the current plan.
func SemanticAstFreshStringResultLocalsFresh(
    ref signatures: SemanticAstFunctionSignatureFacts, ref graph: SemanticExpressionGraphFacts,
    ref functions: HashMap<String, Int>, ref candidates: SemanticAstFreshStringResultLocals, inout fresh: Array<Bool>
) -> Void {
    var row: Int = 0;
    while row < ArrayLength(fresh) { fresh[row] = candidates.eligible[row]; row = row + 1; }
    row = 0;
    while row < ArrayLength(candidates.definition_rows) {
        let local_row: Int = candidates.definition_rows[row];
        if fresh[local_row] && !SemanticAstFreshStringResultDirect(signatures, graph, functions, candidates.definition_values[row]) {
            fresh[local_row] = false;
        }
        row = row + 1;
    }
}

func SemanticAstFreshStringResultCandidate(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts, ref locals: SemanticAstLocalBindingFacts,
    ref inferred_types: Array<String>, ref surfaces: SemanticAstExpressionSurfaceFacts, ref statements: SemanticAstStatementFacts,
    ref functions: HashMap<String, Int>, ref fresh: Array<Bool>, signature_row: Int
) -> Bool {
    if !signatures.runtime_callables[signature_row] || signatures.return_types[signature_row] != "String" { return false; }
    let function_id: Int = signatures.function_node_ids[signature_row];
    let range: SemanticAstLocalBindingFunctionRange = SemanticAstStatementRangeForFunction(statements, function_id);
    if !range.ok { return false; }
    var saw_return: Bool = false;
    var row: Int = range.start;
    while row < range.end {
        if statements.kind_tags[row] == TypedAstKindBareReturnStmtTag() { return false; }
        if statements.kind_tags[row] == TypedAstKindValueReturnStmtTag() {
            let root: Option<Int> = SemanticAstExpressionGraphRootForNode(surfaces, statements.node_ids[row], AstExpressionLaneAtom());
            if !IsSome(root) { return false; }
            if !SemanticAstFreshStringResultDirect(signatures, surfaces.expression_graph, functions, UnwrapOption(root)) {
                let binding: SemanticAstLocalBindingIdentity = SemanticAstScopedLocalBindingIdentityForGraphLeaf(artifact, locals,
                    inferred_types, function_id, statements.node_ids[row], surfaces.expression_graph, UnwrapOption(root));
                if !binding.ok || binding.row < 0 || binding.row >= ArrayLength(fresh) || !fresh[binding.row] { return false; }
            }
            saw_return = true;
        }
        row = row + 1;
    }
    return saw_return;
}

func SemanticAstFreshStringResultPlanFromResolvedFacts(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts, ref locals: SemanticAstLocalBindingFacts,
    ref initializer_types: SemanticAstInitializerTypeFacts, ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref statements: SemanticAstStatementFacts, ref assignments: SemanticAstAssignmentFacts,
    ref owned_string_results: SemanticAstOwnedStringResultFacts
) -> SemanticAstFreshStringResultPlan {
    let functions: HashMap<String, Int> = MapNew();
    var plan: SemanticAstFreshStringResultPlan = SemanticAstFreshStringResultPlan(false, functions);
    if !signatures.ok || !surfaces.ok || !statements.ok || !assignments.ok || !owned_string_results.domain_exposures.ok ||
        !SemanticAstLocalBindingIdentityRowsReady(locals, initializer_types.inferred_type_names) {
        return plan;
    }
    var tainted: HashMap<String, Int> = MapNew();
    let candidates: SemanticAstFreshStringResultLocals = SemanticAstFreshStringResultLocalsFrom(artifact, locals,
        initializer_types.inferred_type_names, surfaces, assignments, owned_string_results.domain_exposures, tainted);
    var fresh: Array<Bool> = [];
    var row: Int = 0;
    while row < ArrayLength(locals.node_ids) { ArrayPush(fresh, false); row = row + 1; }
    plan.ok = true;
    var remaining: Int = ArrayLength(signatures.function_node_ids);
    var changed: Bool = true;
    while changed && remaining > 0 {
        changed = false;
        SemanticAstFreshStringResultLocalsFresh(signatures, surfaces.expression_graph, plan.functions, candidates, fresh);
        row = 0;
        while row < ArrayLength(signatures.function_node_ids) {
            let function_id: Int = signatures.function_node_ids[row];
            if !MapHas(plan.functions, ToString(function_id)) && !MapHas(tainted, ToString(function_id)) &&
                SemanticAstRuntimeCallableSignatureRowReady(signatures, row) &&
                SemanticAstFreshStringResultCandidate(artifact, signatures, locals, initializer_types.inferred_type_names,
                    surfaces, statements, plan.functions, fresh, row) {
                MapSet(plan.functions, ToString(function_id), 1);
                changed = true;
            }
            row = row + 1;
        }
        remaining = remaining - 1;
    }
    return plan;
}
