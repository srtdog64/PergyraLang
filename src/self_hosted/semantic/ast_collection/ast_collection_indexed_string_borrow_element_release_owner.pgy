// Array<String> element releases end the String loans of the released
// storage. An owned pop or set (collection receipt effects 5 and 4) frees one
// element; a call that hands the array to a formal with an element
// requirement lets its callee free any. The receipt producer and the
// requirement owner decide that an element is released; this owner decides
// which loans that release ends, and refuses a loan a loop reads again.
import "../ast_assignment_fact_owner.pgy";
import "../ast_local_binding_fact_owner.pgy";
import "../ast_signature_fact_owner.pgy";
import "ast_collection_call_retirement_owner.pgy";
import "ast_collection_definition_storage_authority_owner.pgy";
import "ast_collection_exclusive_value_exit_flow_owner.pgy";
import "ast_collection_formal_effect_identity_owner.pgy";
import "ast_collection_indexed_string_borrow_owner.pgy";
import "ast_collection_ownership_identity_owner.pgy";
import "ast_collection_ownership_receipt_owner.pgy";
import "ast_collection_ownership_verdict_carrier_owner.pgy";

// A direct release may free the element a loan borrows when the loan is
// proved to borrow that storage, when the loan's source is unresolved or
// joined (-1, -2), or when the released storage is unresolved, as a direct
// deep drop retires. A release inside a callee ends only the loans proved to
// borrow the one known storage it is handed. A proved-independent value (0)
// and a map payload loan (below -2) borrow no Array<String> element.
func SemanticAstIndexedStringBorrowEndsAtElementRelease(
    borrow: Int, released: Int, direct: Bool
) -> Bool {
    if borrow == 0 || borrow < -2 { return false; }
    if !direct { return released > 0 && borrow == released; }
    return borrow < 0 || released <= 0 || borrow == released;
}

// The storage source of the Array<String> local that `receiver_id` declares,
// or -1 when it names a formal, a local with no proved storage, or rows with
// different storage.
func SemanticAstIndexedStringBorrowReleasedSource(
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref definitions: SemanticAstCollectionDefinitionFacts,
    ref storage: SemanticAstCollectionStorageAuthorityFacts,
    ref current_definitions: Array<Int>, receiver_id: Int
) -> Int {
    let first: Option<Int> = SemanticAstLocalBindingIndexForNode(locals, receiver_id);
    if !IsSome(first) { return -1; }
    var released: Int = 0;
    var row: Int = UnwrapOption(first);
    while row < ArrayLength(locals.node_ids) && locals.node_ids[row] == receiver_id {
        if row < ArrayLength(inferred_types) && row < ArrayLength(current_definitions) &&
            SemanticAstCollectionOwnershipIsStringArray(inferred_types[row]) {
            let source: Int = SemanticAstCollectionDefinitionStorageSource(
                storage, definitions, row, current_definitions[row]);
            if source <= 0 || (released != 0 && released != source) { return -1; }
            released = source;
        }
        row = row + 1;
    }
    if released == 0 { return -1; }
    return released;
}

// The loan `row` is read inside the outermost loop around the release at
// `surface` that does not also declare the row, at or before the release:
// the loop's next pass reads it after the release. Overwriting the whole
// local is no read. A walk that cannot finish counts as a read.
func SemanticAstIndexedStringBorrowLoopReadsAfterRelease(
    artifact: AstTreeArtifact, ref locals: SemanticAstLocalBindingFacts,
    ref inferred_types: Array<String>, ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref assignments: SemanticAstAssignmentFacts, row: Int, surface: Int
) -> Bool {
    var outer_loop: Int = -1;
    var ancestor: Option<Int> = Some(surfaces.node_ids[surface]);
    var remaining: Int = artifact.count;
    while IsSome(ancestor) && remaining > 0 {
        let candidate: Int = UnwrapOption(ancestor);
        if TypedAstArenaNodeKindIs(artifact.arena, candidate, TypedAstKindWhileStmtTag()) ||
            TypedAstArenaNodeKindIs(artifact.arena, candidate, TypedAstKindForStmtTag()) {
            if SemanticAstCollectionNodeEnclosedBy(artifact, locals.node_ids[row], candidate) { break; }
            outer_loop = candidate;
        }
        ancestor = TypedAstArenaParentId(artifact.arena, candidate);
        remaining = remaining - 1;
    }
    if remaining == 0 { return true; }
    if outer_loop < 0 { return false; }
    // A parent's syntax id precedes its children's, so the loop's surfaces
    // lie between the loop node and the release.
    var earlier: Int = surface;
    while earlier >= 0 && surfaces.node_ids[earlier] >= outer_loop {
        let syntax: Int = surfaces.node_ids[earlier];
        let assigned: Option<Int> = SemanticAstAssignmentIndexForNode(assignments, syntax);
        let overwrite: Bool = IsSome(assigned) && assignments.target_is_indexed[UnwrapOption(assigned)] == 0;
        var lane: Int = 0;
        if !SemanticAstCollectionNodeEnclosedBy(artifact, syntax, outer_loop) { lane = 3; }
        while lane < 3 {
            let slot: Int = earlier * 3 + lane;
            if surfaces.expression_graph.has_roots[slot] {
                let root: Int = surfaces.expression_graph.roots[slot];
                let start: Option<Int> = SemanticExpressionGraphSubtreeStart(surfaces.expression_graph, root);
                if !IsSome(start) { return true; }
                var leaf: Int = UnwrapOption(start);
                while leaf <= root {
                    let target: Bool = overwrite && lane == AstExpressionLaneAtom() && leaf == root;
                    if !target && !SemanticAstCollectionExclusiveMemberName(surfaces, leaf, root) {
                        let binding: SemanticAstLocalBindingIdentity = SemanticAstScopedLocalBindingIdentityForGraphLeaf(
                            artifact, locals, inferred_types, surfaces.function_node_ids[earlier], syntax,
                            surfaces.expression_graph, leaf);
                        if binding.ok && binding.row == row { return true; }
                    }
                    leaf = leaf + 1;
                }
            }
            lane = lane + 1;
        }
        earlier = earlier - 1;
    }
    return false;
}

// Ends the loans of the release's function that the release of `released`
// at `surface` may free, and refuses one that a loop reads again after it.
func SemanticAstIndexedStringBorrowReleaseElements(
    artifact: AstTreeArtifact, ref locals: SemanticAstLocalBindingFacts,
    ref inferred_types: Array<String>, ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref assignments: SemanticAstAssignmentFacts,
    inout state: SemanticAstIndexedStringBorrowState,
    released: Int, direct: Bool, surface: Int, node: Int
) -> SemanticAstCollectionOwnershipVerdict {
    let function_id: Int = surfaces.function_node_ids[surface];
    var row: Int = 0;
    while row < ArrayLength(state.source_storage_ids) && row < ArrayLength(locals.function_node_ids) {
        if locals.function_node_ids[row] == function_id &&
            SemanticAstIndexedStringBorrowEndsAtElementRelease(state.source_storage_ids[row], released, direct) {
            state.invalidated[row] = true;
            state.release_sites[row] = surfaces.node_ids[surface];
            if SemanticAstIndexedStringBorrowLoopReadsAfterRelease(
                    artifact, locals, inferred_types, surfaces, assignments, row, surface) {
                return SemanticAstCollectionOwnershipVerdictError("borrow_boundary_escape",
                    SemanticError3("borrow_boundary_escape", "boundary",
                        "indexed_string_loop_use_after_element_release", "type", "String",
                        "binding", Concat("", locals.names[row])),
                    surfaces.node_ids[surface], node);
            }
        }
        row = row + 1;
    }
    return SemanticAstCollectionOwnershipVerdictOk();
}

// One slot's loan completion. After the last lane of a syntax, each owned pop
// or set receipt that syntax issued (statement or call form) releases one
// element of its receiver. The receipts of one syntax are the table's suffix.
func SemanticAstIndexedStringBorrowCompleteSlot(
    artifact: AstTreeArtifact, ref locals: SemanticAstLocalBindingFacts,
    ref inferred_types: Array<String>, ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref assignments: SemanticAstAssignmentFacts,
    ref definitions: SemanticAstCollectionDefinitionFacts,
    ref storage: SemanticAstCollectionStorageAuthorityFacts,
    ref current_definitions: Array<Int>, ref clone_nodes: Array<Int>,
    ref fresh_string_results: SemanticAstFreshStringResultPlan, ref receipts: SemanticAstCollectionOwnershipReceiptRows,
    inout state: SemanticAstIndexedStringBorrowState, root_slot: Int
) -> SemanticAstCollectionOwnershipVerdict {
    let surface: Int = root_slot / 3;
    if !SemanticAstIndexedStringBorrowCompleteValue(artifact, locals, inferred_types, surfaces, assignments,
            definitions, storage, current_definitions, clone_nodes, fresh_string_results, state, root_slot) {
        return SemanticAstCollectionOwnershipVerdictError("ast_artifact_invalid",
            SemanticError1("ast_artifact_invalid", "owner", "indexed_string_borrow_completion"),
            surfaces.node_ids[surface], -1);
    }
    if root_slot % 3 != AstExpressionLaneAuxiliary() { return SemanticAstCollectionOwnershipVerdictOk(); }
    var receipt: Int = ArrayLength(receipts.owner_node_ids) - 1;
    while receipt >= 0 && receipts.owner_node_ids[receipt] == surfaces.node_ids[surface] {
        let effect: Int = receipts.effect_kinds[receipt];
        if effect == SemanticAstCollectionOwnershipEffectOwnedStringPop() ||
            effect == SemanticAstCollectionOwnershipEffectOwnedStringSet() {
            let released: Int = SemanticAstIndexedStringBorrowReleasedSource(locals, inferred_types,
                definitions, storage, current_definitions, receipts.receiver_binding_syntax_ids[receipt]);
            let verdict: SemanticAstCollectionOwnershipVerdict = SemanticAstIndexedStringBorrowReleaseElements(
                artifact, locals, inferred_types, surfaces, assignments, state, released, true, surface, -1);
            if !verdict.ok { return verdict; }
        }
        receipt = receipt - 1;
    }
    return SemanticAstCollectionOwnershipVerdictOk();
}

// A selected compiler Clone between `leaf` and the releasing call copies the
// value the leaf reads where its argument is taken, before the call runs.
func SemanticAstIndexedStringBorrowCopiedWhereTaken(
    ref graph: SemanticExpressionGraphFacts, ref clone_nodes: Array<Int>, leaf: Int, call_node: Int
) -> Bool {
    var clone: Int = 0;
    while clone < ArrayLength(clone_nodes) {
        let node: Int = clone_nodes[clone];
        if node >= leaf && node < call_node {
            let start: Option<Int> = SemanticExpressionGraphSubtreeStart(graph, node);
            if IsSome(start) && UnwrapOption(start) <= leaf { return true; }
        }
        clone = clone + 1;
    }
    return false;
}

// A completed call releases loans twice over: a direct deep drop retires its
// argument's storage, and an argument handed to a formal with an element
// requirement (its callee pops or deep-drops that formal) has its elements
// released by the callee. A loan this call or an enclosing call took as an
// earlier argument is read after that release, unless a compiler Clone landed
// where the argument was taken copies it first.
func SemanticAstIndexedStringBorrowReleaseAtCallCompletion(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts, ref assignments: SemanticAstAssignmentFacts,
    ref definitions: SemanticAstCollectionDefinitionFacts,
    ref storage: SemanticAstCollectionStorageAuthorityFacts, ref current_definitions: Array<Int>,
    ref element_requirements: HashMap<String, Int>, ref clone_nodes: Array<Int>,
    inout state: SemanticAstIndexedStringBorrowState,
    root_slot: Int, call_node: Int, terminal_root: Int
) -> SemanticAstCollectionOwnershipVerdict {
    let surface_row: Int = root_slot / 3;
    if !SemanticAstIndexedStringBorrowRecordDeepDrop(artifact, locals, inferred_types, surfaces,
            definitions, storage, current_definitions, state, surface_row, call_node, terminal_root) {
        return SemanticAstCollectionOwnershipVerdictError("ast_artifact_invalid",
            SemanticError1("ast_artifact_invalid", "owner", "indexed_string_deep_drop"),
            surfaces.node_ids[surface_row], terminal_root);
    }
    let call: SemanticCallSpineView = SemanticCallSpineViewFromGraph(surfaces.expression_graph, terminal_root);
    if !call.ok || call.call_node != call_node { return SemanticAstCollectionOwnershipVerdictOk(); }
    var released_any: Bool = false;
    var ordinal: Int = 0;
    while ordinal < ArrayLength(call.argument_nodes) {
        let formal: SemanticAstCollectionArgumentFormalTarget = SemanticAstCollectionArgumentFormalTargetForArgument(
            signatures, surfaces.expression_graph, call_node, ordinal);
        var requirement: Bool = false;
        if formal.ok {
            // Only an Array<String> formal carries an element requirement.
            let formal_type: Option<String> = SemanticAstFunctionParamTypeAt(signatures, formal.signature_row, formal.ordinal);
            requirement = IsSome(formal_type) && SemanticAstCollectionOwnershipIsStringArray(UnwrapOption(formal_type)) &&
                MapHas(element_requirements, ToString(formal.syntax_id));
        }
        if requirement {
            var released: Int = -1;
            let handed: SemanticAstLocalBindingIdentity = SemanticAstCollectionOwnershipLocalForArgument(
                artifact, locals, inferred_types, surfaces, surface_row, call.argument_nodes[ordinal]);
            if handed.ok {
                released = SemanticAstIndexedStringBorrowReleasedSource(locals, inferred_types,
                    definitions, storage, current_definitions, locals.node_ids[handed.row]);
            }
            let verdict: SemanticAstCollectionOwnershipVerdict = SemanticAstIndexedStringBorrowReleaseElements(
                artifact, locals, inferred_types, surfaces, assignments, state, released, false,
                surface_row, terminal_root);
            if !verdict.ok { return verdict; }
            released_any = true;
        }
        ordinal = ordinal + 1;
    }
    if !released_any { return SemanticAstCollectionOwnershipVerdictOk(); }
    // Post-order: every value evaluated before the call completes lies
    // between the slot root's subtree start and the call node.
    let root: Int = surfaces.expression_graph.roots[root_slot];
    let start: Option<Int> = SemanticExpressionGraphSubtreeStart(surfaces.expression_graph, root);
    if !IsSome(start) || UnwrapOption(start) > call_node {
        return SemanticAstCollectionOwnershipVerdictError("ast_artifact_invalid",
            SemanticError1("ast_artifact_invalid", "owner", "element_release_argument_order"),
            surfaces.node_ids[surface_row], call_node);
    }
    var leaf: Int = UnwrapOption(start);
    while leaf < call_node {
        let binding: SemanticAstLocalBindingIdentity = SemanticAstScopedLocalBindingIdentityForGraphLeaf(
            artifact, locals, inferred_types, surfaces.function_node_ids[surface_row],
            surfaces.node_ids[surface_row], surfaces.expression_graph, leaf);
        if binding.ok && binding.row < ArrayLength(state.release_sites) && state.invalidated[binding.row] &&
            state.release_sites[binding.row] == surfaces.node_ids[surface_row] &&
            !SemanticAstCollectionExclusiveMemberName(surfaces, leaf, root) &&
            !SemanticAstIndexedStringBorrowCopiedWhereTaken(surfaces.expression_graph, clone_nodes, leaf, call_node) {
            return SemanticAstCollectionOwnershipVerdictError("borrow_boundary_escape",
                SemanticError2("borrow_boundary_escape", "boundary",
                    "indexed_string_use_after_element_release", "type", "String"),
                surfaces.node_ids[surface_row], leaf);
        }
        leaf = leaf + 1;
    }
    return SemanticAstCollectionOwnershipVerdictOk();
}
