// One terminal publication owner returns the evidence carriers and retires
// only temporary arrays. Early move errors preserve partial evidence
// and never run the final closures; final closures retain short-circuit order.
import "ast_collection_member_read_permission_owner.pgy";
import "ast_collection_member_place_use_owner.pgy";
import "ast_collection_member_capture_obligation_owner.pgy";

struct SemanticAstCollectionMemberMoveUse {
    found: Bool;
    syntax_node_id: Int;
    expression_node_id: Int;
    restored_binding_syntax_ids: Array<Int>;
    restoration_syntax_ids: Array<Int>;
    readable_members: HashMap<String, Int>;
    unproved_read_roots: HashMap<String, Int>;
    read_hazards: SemanticAstCollectionMemberReadHazardSites;
    // Root binding -> first site where its member storage may outlive a release.
    element_escape_roots: HashMap<String, Int>;
    // Direct element escapes and readonly lending edges are retained so the
    // last aggregate-release consumer can apply source-ordered Clone and
    // local-containment facts before rebuilding the escape closure.
    direct_element_escape_root_ids: Array<Int>;
    direct_element_escape_syntax_ids: Array<Int>;
    element_escape_source_ids: Array<Int>;
    element_escape_target_ids: Array<Int>;
    element_escape_lending_syntax_ids: Array<Int>;
    capture_syntax_node_id: Int;
    capture_expression_node_id: Int;
    read_permission_ready: Bool;
}

func SemanticAstCollectionMemberMoveUsePublish(
    ref artifact: AstTreeArtifact, ref contexts: SemanticAstCollectionFormalExecutionContexts,
    found: Bool, syntax_id: Int, node: Int, capture: SemanticAstCollectionMemberCaptureWitness,
    own restored: Array<Int>, own restoration_sites: Array<Int>,
    own readable_members: HashMap<String, Int>, own unproved_read_roots: HashMap<String, Int>,
    own read_hazards: SemanticAstCollectionMemberReadHazardSites,
    own element_escape_roots: HashMap<String, Int>,
    own direct_escape_roots: Array<Int>, own direct_escape_sites: Array<Int>,
    own nested_blocked: HashMap<String, Int>,
    own readonly_origins: Array<Int>,
    own read_sources: Array<Int>, own read_targets: Array<Int>,
    own escape_sources: Array<Int>, own escape_targets: Array<Int>, own escape_sites: Array<Int>,
    own nested_nodes: Array<Int>, own nested_roots: Array<Int>,
    own nested_lend_sources: Array<Int>, own nested_lend_targets: Array<Int>
) -> SemanticAstCollectionMemberMoveUse {
    var ready: Bool = true;
    if !found {
        ready = capture.ready && contexts.ok && contexts.artifact_identity_digest == artifact.identity_digest &&
            contexts.artifact_node_count == artifact.count &&
            SemanticAstCollectionMemberReadBlockedRootsClosure(artifact, read_sources, read_targets, unproved_read_roots, read_hazards) &&
            SemanticAstCollectionMemberReadHazardSitesAdmit(artifact, unproved_read_roots, read_hazards) &&
            SemanticAstCollectionMemberElementEscapeClosure(escape_sources, escape_targets, escape_sites, element_escape_roots) &&
            SemanticAstCollectionMemberNestedReadAdmit(nested_nodes, nested_roots, nested_lend_sources, nested_lend_targets,
                unproved_read_roots, nested_blocked, readable_members);
    }
    ArrayDrop(read_sources);
    ArrayDrop(read_targets);
    ArrayDrop(nested_nodes);
    ArrayDrop(nested_roots);
    ArrayDrop(nested_lend_sources);
    ArrayDrop(nested_lend_targets);
    ArrayDrop(readonly_origins);
    return SemanticAstCollectionMemberMoveUse(found, syntax_id, node, restored, restoration_sites,
        readable_members, unproved_read_roots, read_hazards,
        element_escape_roots, direct_escape_roots, direct_escape_sites,
        escape_sources, escape_targets, escape_sites,
        capture.syntax_id, capture.expression_id, ready);
}
