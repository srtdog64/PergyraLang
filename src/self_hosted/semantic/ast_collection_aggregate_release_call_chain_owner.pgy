// Release call identity, chain divergence, and forwarded-push readiness.

import "ast_collection_aggregate_release_plan_schema_owner.pgy";
import "ast_collection_call_effect_fact_owner.pgy";
import "ast_collection_call_retirement_owner.pgy";
import "ast_collection_aggregate_field_entry_requirement_owner.pgy";
import "ast_collection_definition_storage_authority_owner.pgy";
import "ast_collection_aggregate_named_input_reservation_owner.pgy";
import "ast_collection_aggregate_value_exclusivity_owner.pgy";
import "ast_collection_aggregate_value_lineage_owner.pgy";
import "ast_collection_exclusive_value_flow_owner.pgy";
import "ast_collection_exclusive_value_class_owner.pgy";
import "ast_nominal_constructor_fact_owner.pgy";
import "ast_signature_param_node_query_owner.pgy";
import "ast_collection_aggregate_source_path_uniqueness_owner.pgy";

func SemanticAstCollectionAggregateReleaseCallTargetForNode(
    ref plan: SemanticAstCollectionAggregateReleasePlan, call_node: Int
) -> Int {
    if call_node < 0 { return 0; }
    var target: Int = 0;
    var row: Int = 0;
    while row < ArrayLength(plan.call_nodes) {
        if plan.call_nodes[row] == call_node {
            if plan.call_target_ids[row] <= 0 ||
                (target > 0 && target != plan.call_target_ids[row]) {
                return 0;
            }
            target = plan.call_target_ids[row];
        }
        row = row + 1;
    }
    return target;
}

func SemanticAstCollectionAggregateReleaseCallFunctionForNode(
    ref plan: SemanticAstCollectionAggregateReleasePlan, call_node: Int
) -> Int {
    if call_node < 0 { return 0; }
    var function_id: Int = 0;
    var row: Int = 0;
    while row < ArrayLength(plan.call_nodes) {
        if plan.call_nodes[row] == call_node {
            if plan.call_function_ids[row] <= 0 ||
                (function_id > 0 && function_id !=
                    plan.call_function_ids[row]) {
                return 0;
            }
            function_id = plan.call_function_ids[row];
        }
        row = row + 1;
    }
    return function_id;
}

func SemanticAstCollectionAggregateReleaseCallSyntaxForNode(
    ref plan: SemanticAstCollectionAggregateReleasePlan, call_node: Int
) -> Int {
    if call_node < 0 { return 0; }
    var syntax_id: Int = 0;
    var row: Int = 0;
    while row < ArrayLength(plan.call_nodes) {
        if plan.call_nodes[row] == call_node {
            if plan.call_syntax_ids[row] <= 0 ||
                (syntax_id > 0 && syntax_id != plan.call_syntax_ids[row]) {
                return 0;
            }
            syntax_id = plan.call_syntax_ids[row];
        }
        row = row + 1;
    }
    return syntax_id;
}

func SemanticAstCollectionAggregateReleaseDemandCallRow(
    ref plan: SemanticAstCollectionAggregateReleasePlan, demand: Int
) -> Int {
    if demand < 0 || demand >= ArrayLength(plan.demand_edge_nodes) { return -1; }
    return SemanticAstCollectionAggregateReleasePlanCallRowForEdge(
        plan, plan.demand_edge_nodes[demand]);
}

func SemanticAstCollectionAggregateReleaseChainEnd(
    ref plan: SemanticAstCollectionAggregateReleasePlan, demand: Int
) -> Int {
    if demand + 1 < ArrayLength(plan.demand_chain_starts) {
        return plan.demand_chain_starts[demand + 1];
    }
    return ArrayLength(plan.demand_chain_edges);
}

// Two demands of one origin are ordered at the first edge where their caller
// chains differ: up to there both descend through the same calls, so the two
// differing edges sit in one function. A chain that is a prefix of the other
// nests one demand inside the other's call and has no order (-1).
func SemanticAstCollectionAggregateReleaseChainDivergence(
    ref plan: SemanticAstCollectionAggregateReleasePlan,
    prior: Int, current: Int
) -> Int {
    if prior < 0 || current < 0 ||
        current >= ArrayLength(plan.demand_chain_starts) ||
        prior >= ArrayLength(plan.demand_chain_starts) { return -1; }
    let a: Int = plan.demand_chain_starts[prior];
    let b: Int = plan.demand_chain_starts[current];
    let a_end: Int = SemanticAstCollectionAggregateReleaseChainEnd(plan, prior);
    let b_end: Int = SemanticAstCollectionAggregateReleaseChainEnd(plan, current);
    var depth: Int = 0;
    while a + depth < a_end && b + depth < b_end {
        if plan.demand_chain_edges[a + depth] != plan.demand_chain_edges[b + depth] {
            return depth;
        }
        depth = depth + 1;
    }
    return -1;
}

// A releasing demand reached through callees must not repeat below the
// divergence point: every deeper edge of its chain is loop-free.
func SemanticAstCollectionAggregateReleaseDeepChainLoopFree(
    artifact: AstTreeArtifact,
    ref plan: SemanticAstCollectionAggregateReleasePlan,
    demand: Int, divergence: Int
) -> Bool {
    let requirement: Int = plan.requirement_rows[demand];
    let mask: Int = plan.requirement_effect_masks[requirement];
    if mask != SemanticAstCollectionAggregateFieldEntryEffectDeepDrop() && mask != 3 { return true; }
    var edge: Int = plan.demand_chain_starts[demand] + divergence + 1;
    let end: Int = SemanticAstCollectionAggregateReleaseChainEnd(plan, demand);
    while edge < end {
        let row: Int = SemanticAstCollectionAggregateReleasePlanCallRowForEdge(
            plan, plan.demand_chain_edges[edge]);
        if row < 0 || SemanticAstCollectionCallRetirementSite(artifact, plan.call_syntax_ids[row]) <= 0 { return false; }
        edge = edge + 1;
    }
    return true;
}

// An owned-push summary at an outer formal and its one nested leaf effect are
// one demand, not two executions.  Admit only an exact strict-prefix call
// chain over the same constructor input.  Adjacent edges must be the actual
// caller-to-callee continuation and no target may recur.
func SemanticAstCollectionAggregateReleaseForwardedOwnedPushReady(
    ref plan: SemanticAstCollectionAggregateReleasePlan,
    prior: Int, current: Int
) -> Bool {
    if prior < 0 || current <= prior ||
        current >= ArrayLength(plan.requirement_rows) ||
        prior >= ArrayLength(plan.requirement_rows) ||
        plan.constructor_input_rows[prior] !=
            plan.constructor_input_rows[current] {
        return false;
    }
    let prior_requirement: Int = plan.requirement_rows[prior];
    let current_requirement: Int = plan.requirement_rows[current];
    if prior_requirement < 0 || current_requirement < 0 ||
        prior_requirement >= ArrayLength(plan.requirement_effect_masks) ||
        current_requirement >= ArrayLength(plan.requirement_effect_masks) ||
        plan.requirement_effect_masks[prior_requirement] !=
            SemanticAstCollectionAggregateFieldEntryEffectOwnedPush() ||
        plan.requirement_effect_masks[current_requirement] !=
            SemanticAstCollectionAggregateFieldEntryEffectOwnedPush() {
        return false;
    }
    let prior_start: Int = plan.demand_chain_starts[prior];
    let current_start: Int = plan.demand_chain_starts[current];
    let prior_end: Int = SemanticAstCollectionAggregateReleaseChainEnd(
        plan, prior);
    let current_end: Int = SemanticAstCollectionAggregateReleaseChainEnd(
        plan, current);
    let prior_count: Int = prior_end - prior_start;
    let current_count: Int = current_end - current_start;
    if prior_count <= 0 || current_count <= 0 ||
        prior_count == current_count {
        return false;
    }
    var shorter_start: Int = prior_start;
    var shorter_count: Int = prior_count;
    var longer_start: Int = current_start;
    var longer_count: Int = current_count;
    var shorter_demand: Int = prior;
    var longer_demand: Int = current;
    if current_count < prior_count {
        shorter_start = current_start;
        shorter_count = current_count;
        longer_start = prior_start;
        longer_count = prior_count;
        shorter_demand = current;
        longer_demand = prior;
    }
    if plan.demand_chain_edges[shorter_start + shorter_count - 1] !=
            plan.demand_edge_nodes[shorter_demand] ||
        plan.demand_chain_edges[longer_start + longer_count - 1] !=
            plan.demand_edge_nodes[longer_demand] {
        return false;
    }
    var offset: Int = 0;
    while offset < shorter_count {
        if plan.demand_chain_edges[shorter_start + offset] !=
                plan.demand_chain_edges[longer_start + offset] {
            return false;
        }
        offset = offset + 1;
    }
    var edge_offset: Int = 0;
    while edge_offset < longer_count {
        let edge_row: Int =
            SemanticAstCollectionAggregateReleasePlanCallRowForEdge(
                plan, plan.demand_chain_edges[longer_start + edge_offset]);
        if edge_row < 0 || plan.call_target_ids[edge_row] <= 0 {
            return false;
        }
        if edge_offset + 1 < longer_count {
            let next_row: Int =
                SemanticAstCollectionAggregateReleasePlanCallRowForEdge(
                    plan,
                    plan.demand_chain_edges[longer_start + edge_offset + 1]);
            if next_row < 0 || plan.call_target_ids[edge_row] !=
                    plan.call_function_ids[next_row] {
                return false;
            }
        }
        var earlier: Int = 0;
        while earlier < edge_offset {
            let earlier_row: Int =
                SemanticAstCollectionAggregateReleasePlanCallRowForEdge(
                    plan,
                    plan.demand_chain_edges[longer_start + earlier]);
            if earlier_row < 0 || plan.call_target_ids[earlier_row] ==
                    plan.call_target_ids[edge_row] {
                return false;
            }
            earlier = earlier + 1;
        }
        edge_offset = edge_offset + 1;
    }
    return true;
}

