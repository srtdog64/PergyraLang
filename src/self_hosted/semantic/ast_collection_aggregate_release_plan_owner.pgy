// Final aggregate release plan construction and uniqueness validation.

import "ast_collection_aggregate_release_plan_schema_owner.pgy";
import "ast_collection_aggregate_value_lineage_owner.pgy";
import "ast_collection_aggregate_field_entry_requirement_owner.pgy";
import "ast_collection_call_effect_fact_owner.pgy";
import "ast_collection_definition_storage_authority_owner.pgy";

func SemanticAstCollectionAggregateReleasePlanUnique(
    ref plan: SemanticAstCollectionAggregateReleasePlan,
    ref inputs: SemanticAstCollectionConstructorFieldInputs,
    ref storage: SemanticAstCollectionStorageAuthorityFacts,
    ref definitions: SemanticAstCollectionDefinitionFacts
) -> Bool {
    let row: Int = 0;
    while row < ArrayLength(plan.constructor_input_rows) {
        let input: Int = plan.constructor_input_rows[row];
        if input < 0 || input >= ArrayLength(inputs.producer_kinds) {
            return false;
        }
        let prior: Int = 0;
        while prior < row {
            let prior_input: Int = plan.constructor_input_rows[prior];
            if plan.aggregate_origin_ids[prior] ==
                    plan.aggregate_origin_ids[row] &&
                inputs.field_ids[prior_input] == inputs.field_ids[input] {
                return false;
            }
            if inputs.producer_kinds[prior_input] == 1 &&
                inputs.producer_kinds[input] == 1 {
                let prior_source: Int =
                    SemanticAstCollectionDefinitionStorageSource(
                        storage, definitions,
                        definitions.binding_rows[
                            inputs.definition_rows[prior_input]],
                        inputs.definition_rows[prior_input]);
                let source: Int =
                    SemanticAstCollectionDefinitionStorageSource(
                        storage, definitions,
                        definitions.binding_rows[
                            inputs.definition_rows[input]],
                        inputs.definition_rows[input]);
                if prior_source <= 0 || source <= 0 ||
                    (prior_source == source &&
                     ((prior_input != input &&
                       inputs.function_ids[prior_input] ==
                            inputs.function_ids[input]) ||
                      plan.aggregate_origin_ids[prior] ==
                            plan.aggregate_origin_ids[row])) {
                    return false;
                }
            }
            prior = prior + 1;
        }
        row = row + 1;
    }
    return true;
}

func SemanticAstCollectionAggregateReleasePlanFromRequirements(
    artifact: AstTreeArtifact,
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    ref locals: SemanticAstLocalBindingFacts,
    ref inferred_types: Array<String>,
    ref resolved_leaf_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref statements: SemanticAstStatementFacts,
    ref assignments: SemanticAstAssignmentFacts,
    ref requirements: SemanticAstCollectionAggregateFieldEntryRequirements,
    ref call_effects: SemanticAstCollectionCallEffectFacts,
    ref storage: SemanticAstCollectionStorageAuthorityFacts,
    ref definitions: SemanticAstCollectionDefinitionFacts
) -> SemanticAstCollectionAggregateReleasePlan {
    let plan: SemanticAstCollectionAggregateReleasePlan =
        SemanticAstCollectionAggregateReleasePlanEmpty();
    if !SemanticAstCollectionAggregateFieldEntryRequirementsReady(
            requirements) ||
        !SemanticAstCollectionConstructorFieldInputsShapeReady(
            call_effects.constructor_inputs) ||
        !SemanticAstCollectionAggregateReleasePlanCallInventory(
            surfaces, plan) {
        plan.ok = false; return plan;
    }
    let trace: SemanticAstCollectionAggregateTrace =
        SemanticAstCollectionAggregateTraceEmpty();
    let row: Int = 0;
    while row < ArrayLength(requirements.local_ids) {
        if requirements.formal_modes[row] != 1 &&
            requirements.formal_modes[row] != 2 {
            plan.ok = false;
            plan.diagnostic_syntax_id = requirements.local_ids[row];
            return plan;
        }
        ArrayPush(plan.requirement_local_ids,
            requirements.local_ids[row]);
        ArrayPush(plan.drop_syntax_ids, -1);
        ArrayPush(plan.drop_expression_nodes, -1);
        let path_row: Int =
            SemanticAstCollectionAggregateTracePathAppend(
                requirements.field_ids[row], -1, trace);
        if path_row < 0 {
            plan.ok = false;
            plan.diagnostic_syntax_id = requirements.local_ids[row];
            return plan;
        }
        let signature: Option<Int> =
            SemanticAstFunctionSignatureIndexForNode(
                signatures, requirements.function_ids[row]);
        if !IsSome(signature) {
            plan.ok = false;
            plan.diagnostic_syntax_id = requirements.local_ids[row];
            return plan;
        }
        let explicit_ordinal: Int = requirements.formal_ordinals[row] -
            signatures.receiver_source_param_offsets[UnwrapOption(signature)];
        if explicit_ordinal < 0 {
            plan.ok = false;
            plan.diagnostic_syntax_id = requirements.local_ids[row];
            return plan;
        }
        let call: Int = 0;
        while call < ArrayLength(plan.call_nodes) {
            if plan.call_target_ids[call] == requirements.function_ids[row] &&
                plan.call_ordinals[call] == explicit_ordinal &&
                !SemanticAstCollectionAggregateTraceExpression(
                    artifact, signatures, constructors, locals,
                    inferred_types, resolved_leaf_types, surfaces,
                    statements, assignments,
                    call_effects.constructor_inputs,
                    plan.call_function_ids[call],
                    plan.call_syntax_ids[call],
                    plan.call_argument_nodes[call], path_row, 0, 0,
                    plan.call_edge_nodes[call], row, 0, trace, plan, 0) {
                plan.ok = false;
                plan.diagnostic_syntax_id = plan.call_syntax_ids[call];
                return plan;
            }
            call = call + 1;
        }
        row = row + 1;
    }
    if !SemanticAstCollectionAggregateReleasePlanUnique(
            plan, call_effects.constructor_inputs, storage, definitions) {
        plan.ok = false;
        if plan.diagnostic_syntax_id < 0 &&
            ArrayLength(requirements.local_ids) > 0 {
            plan.diagnostic_syntax_id = requirements.local_ids[0];
        }
    }
    return plan;
}
