// Aggregate release-plan recording and edge lookup.

import "ast_expression_graph_call_argument_edge_owner.pgy";
import "ast_expression_graph_call_view_owner.pgy";
import "ast_collection_aggregate_release_plan_record_schema_owner.pgy";
import "ast_collection_aggregate_release_plan_readiness_owner.pgy";

func SemanticAstCollectionAggregateReleaseRecordProtectedBinding(
    binding_id: Int, inout plan: SemanticAstCollectionAggregateReleasePlan
) -> Bool {
    if binding_id <= 0 { return false; }
    var row: Int = 0;
    while row < ArrayLength(plan.protected_binding_ids) {
        if plan.protected_binding_ids[row] == binding_id { return true; }
        row = row + 1;
    }
    ArrayPush(plan.protected_binding_ids, binding_id);
    return true;
}

func SemanticAstCollectionAggregateReleaseRecordLineageEdge(
    edge_node: Int, inout plan: SemanticAstCollectionAggregateReleasePlan
) -> Bool {
    if edge_node < 0 { return false; }
    var row: Int = 0;
    while row < ArrayLength(plan.lineage_call_edge_nodes) {
        if plan.lineage_call_edge_nodes[row] == edge_node { return true; }
        row = row + 1;
    }
    ArrayPush(plan.lineage_call_edge_nodes, edge_node);
    return true;
}

func SemanticAstCollectionAggregateReleaseRecordReconstruction(
    binding_id: Int, syntax_id: Int,
    inout plan: SemanticAstCollectionAggregateReleasePlan
) -> Bool {
    if binding_id <= 0 || syntax_id <= 0 ||
        ArrayLength(plan.reconstructed_binding_ids) !=
            ArrayLength(plan.reconstruction_syntax_ids) {
        return false;
    }
    var row: Int = 0;
    while row < ArrayLength(plan.reconstructed_binding_ids) {
        if plan.reconstruction_syntax_ids[row] == syntax_id {
            return plan.reconstructed_binding_ids[row] == binding_id;
        }
        row = row + 1;
    }
    ArrayPush(plan.reconstructed_binding_ids, binding_id);
    ArrayPush(plan.reconstruction_syntax_ids, syntax_id);
    return true;
}

// An existing demand with the same requirement, release edge, origin, input,
// caller chain and producer invocation path is the same flow reached again
// through an alternative return path of one callee; it executes once.
func SemanticAstCollectionAggregateReleaseDemandRecorded(
    ref plan: SemanticAstCollectionAggregateReleasePlan,
    ref trace: SemanticAstCollectionAggregateTrace,
    requirement_row: Int, demand_edge_node: Int, aggregate_origin_id: Int, input_row: Int
) -> Bool {
    var demand: Int = 0;
    while demand < ArrayLength(plan.constructor_input_rows) {
        var chain_end: Int = ArrayLength(plan.demand_chain_edges);
        var path_end: Int = ArrayLength(plan.demand_invocation_nodes);
        if demand + 1 < ArrayLength(plan.constructor_input_rows) {
            chain_end = plan.demand_chain_starts[demand + 1];
            path_end = plan.demand_invocation_starts[demand + 1];
        }
        let chain: Int = plan.demand_chain_starts[demand];
        let path: Int = plan.demand_invocation_starts[demand];
        var same: Bool = plan.requirement_rows[demand] == requirement_row &&
            plan.demand_edge_nodes[demand] == demand_edge_node &&
            plan.aggregate_origin_ids[demand] == aggregate_origin_id &&
            plan.constructor_input_rows[demand] == input_row &&
            chain_end - chain == ArrayLength(trace.entry_edges) + 1 &&
            path_end - path == ArrayLength(trace.invocation_call_nodes);
        var index: Int = 0;
        while same && index < ArrayLength(trace.entry_edges) {
            same = plan.demand_chain_edges[chain + index] ==
                trace.entry_edges[ArrayLength(trace.entry_edges) - 1 - index];
            index = index + 1;
        }
        index = 0;
        while same && index < ArrayLength(trace.invocation_call_nodes) {
            same = plan.demand_invocation_nodes[path + index] == trace.invocation_call_nodes[index];
            index = index + 1;
        }
        if same { return true; }
        demand = demand + 1;
    }
    return false;
}

func SemanticAstCollectionAggregateReleasePlanCallInventory(
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    inout plan: SemanticAstCollectionAggregateReleasePlan
) -> Bool {
    var last: Int = -1;
    var slot: Int = 0;
    while slot < ArrayLength(surfaces.expression_graph.roots) {
        if surfaces.expression_graph.has_roots[slot] {
            let root: Int = surfaces.expression_graph.roots[slot];
            if root <= last || slot / 3 >= ArrayLength(surfaces.node_ids) ||
                slot / 3 >= ArrayLength(surfaces.function_node_ids) {
                return false;
            }
            var node: Int = last + 1;
            while node <= root {
                if surfaces.expression_graph.arena.topology.node_kinds[node] ==
                    AstExpressionNodeCallArgument() {
                    let edge: SemanticCallArgumentEdgeView =
                        SemanticCallArgumentEdgeFromGraph(
                            surfaces.expression_graph, node
                        );
                    let target: Option<Int> =
                        SemanticExpressionGraphCallTargetSyntaxId(
                            surfaces.expression_graph, edge.call_node
                        );
                    if !edge.ok || !IsSome(target) { return false; }
                    ArrayPush(plan.call_surface_rows, slot / 3);
                    ArrayPush(plan.call_function_ids,
                        surfaces.function_node_ids[slot / 3]);
                    ArrayPush(plan.call_syntax_ids,
                        surfaces.node_ids[slot / 3]);
                    ArrayPush(plan.call_edge_nodes, node);
                    ArrayPush(plan.call_nodes, edge.call_node);
                    ArrayPush(plan.call_argument_nodes, edge.argument_node);
                    ArrayPush(plan.call_ordinals, edge.ordinal);
                    ArrayPush(plan.call_target_ids, UnwrapOption(target));
                }
                node = node + 1;
            }
            last = root;
        }
        slot = slot + 1;
    }
    return true;
}

// Expression-graph edge identity and source-syntax identity are different ID
// spaces.  This plan inventory is the sole bridge between them; consumers may
// not treat an edge node as a syntax node merely because both are Int values.
func SemanticAstCollectionAggregateReleasePlanCallRowForEdge(
    ref plan: SemanticAstCollectionAggregateReleasePlan, edge_node: Int
) -> Int {
    if edge_node < 0 ||
        ArrayLength(plan.call_edge_nodes) !=
            ArrayLength(plan.call_syntax_ids) {
        return -1;
    }
    var found: Int = -1;
    var row: Int = 0;
    while row < ArrayLength(plan.call_edge_nodes) {
        if plan.call_edge_nodes[row] == edge_node {
            if found >= 0 { return -1; }
            found = row;
        }
        row = row + 1;
    }
    return found;
}

func SemanticAstCollectionAggregateReleasePlanSyntaxForEdge(
    ref plan: SemanticAstCollectionAggregateReleasePlan, edge_node: Int
) -> Int {
    let row: Int =
        SemanticAstCollectionAggregateReleasePlanCallRowForEdge(
            plan, edge_node);
    if row < 0 { return -1; }
    return plan.call_syntax_ids[row];
}

