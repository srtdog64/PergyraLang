// Unique storage reservations and ordered sharing for one aggregate generation.
// Failure retains the conflicting demand's syntax, not an unrelated requirement.
import "ast_collection_aggregate_release_plan_schema_owner.pgy";
import "ast_collection_call_effect_fact_owner.pgy";
import "ast_collection_call_retirement_owner.pgy";
import "ast_collection_aggregate_field_entry_requirement_owner.pgy";
import "ast_collection_definition_storage_authority_owner.pgy";

func SemanticAstCollectionAggregateReleaseEdgeCallRow(
    ref plan: SemanticAstCollectionAggregateReleasePlan, edge: Int
) -> Int {
    let found: Int = -1;
    let row: Int = 0;
    while row < ArrayLength(plan.call_edge_nodes) {
        if plan.call_edge_nodes[row] == edge {
            if found >= 0 { return -1; }
            found = row;
        }
        row = row + 1;
    }
    return found;
}

func SemanticAstCollectionAggregateReleaseDemandCallRow(
    ref plan: SemanticAstCollectionAggregateReleasePlan, demand: Int
) -> Int {
    if demand < 0 || demand >= ArrayLength(plan.demand_edge_nodes) { return -1; }
    return SemanticAstCollectionAggregateReleaseEdgeCallRow(
        plan, plan.demand_edge_nodes[demand]);
}

func SemanticAstCollectionAggregateReleaseChainEnd(
    ref plan: SemanticAstCollectionAggregateReleasePlan, demand: Int
) -> Int {
    if demand + 1 < ArrayLength(plan.demand_chain_starts) {
        return plan.demand_chain_starts[demand + 1];
    }
    return ArrayLength(plan.demand_chain_edges);
}

// Two demands of one origin are ordered at the first edge where their caller
// chains differ: up to there both descend through the same calls, so the two
// differing edges sit in one function. A chain that is a prefix of the other
// nests one demand inside the other's call and has no order (-1).
func SemanticAstCollectionAggregateReleaseChainDivergence(
    ref plan: SemanticAstCollectionAggregateReleasePlan,
    prior: Int, current: Int
) -> Int {
    if prior < 0 || current < 0 ||
        current >= ArrayLength(plan.demand_chain_starts) ||
        prior >= ArrayLength(plan.demand_chain_starts) { return -1; }
    let a: Int = plan.demand_chain_starts[prior];
    let b: Int = plan.demand_chain_starts[current];
    let a_end: Int = SemanticAstCollectionAggregateReleaseChainEnd(plan, prior);
    let b_end: Int = SemanticAstCollectionAggregateReleaseChainEnd(plan, current);
    let depth: Int = 0;
    while a + depth < a_end && b + depth < b_end {
        if plan.demand_chain_edges[a + depth] != plan.demand_chain_edges[b + depth] {
            return depth;
        }
        depth = depth + 1;
    }
    return -1;
}

// A releasing demand reached through callees must not repeat below the
// divergence point: every deeper edge of its chain is loop-free.
func SemanticAstCollectionAggregateReleaseDeepChainLoopFree(
    artifact: AstTreeArtifact,
    ref plan: SemanticAstCollectionAggregateReleasePlan,
    demand: Int, divergence: Int
) -> Bool {
    let requirement: Int = plan.requirement_rows[demand];
    let mask: Int = plan.requirement_effect_masks[requirement];
    if mask != SemanticAstCollectionAggregateFieldEntryEffectDeepDrop() && mask != 3 { return true; }
    let edge: Int = plan.demand_chain_starts[demand] + divergence + 1;
    let end: Int = SemanticAstCollectionAggregateReleaseChainEnd(plan, demand);
    while edge < end {
        let row: Int = SemanticAstCollectionAggregateReleaseEdgeCallRow(plan, plan.demand_chain_edges[edge]);
        if row < 0 || SemanticAstCollectionCallRetirementSite(artifact, plan.call_syntax_ids[row]) <= 0 { return false; }
        edge = edge + 1;
    }
    return true;
}

func SemanticAstCollectionAggregateReleaseSharedDemandReady(
    artifact: AstTreeArtifact,
    ref plan: SemanticAstCollectionAggregateReleasePlan,
    ref inputs: SemanticAstCollectionConstructorFieldInputs,
    prior: Int, current: Int
) -> Bool {
    if prior < 0 || current <= prior ||
        current >= ArrayLength(plan.requirement_rows) ||
        prior >= ArrayLength(plan.requirement_rows) ||
        plan.aggregate_origin_ids[prior] != plan.aggregate_origin_ids[current] { return false; }
    let prior_input: Int = plan.constructor_input_rows[prior];
    let current_input: Int = plan.constructor_input_rows[current];
    if prior_input < 0 || current_input < 0 ||
        prior_input >= ArrayLength(inputs.field_ids) ||
        current_input >= ArrayLength(inputs.field_ids) ||
        inputs.field_ids[prior_input] != inputs.field_ids[current_input] { return false; }
    let prior_requirement: Int = plan.requirement_rows[prior];
    let current_requirement: Int = plan.requirement_rows[current];
    if prior_requirement < 0 || current_requirement < 0 ||
        prior_requirement >= ArrayLength(plan.requirement_effect_masks) ||
        current_requirement >= ArrayLength(plan.requirement_effect_masks) { return false; }
    let divergence: Int = SemanticAstCollectionAggregateReleaseChainDivergence(plan, prior, current);
    if divergence < 0 { return false; }
    let prior_call: Int = SemanticAstCollectionAggregateReleaseEdgeCallRow(plan,
        plan.demand_chain_edges[plan.demand_chain_starts[prior] + divergence]);
    let current_call: Int = SemanticAstCollectionAggregateReleaseEdgeCallRow(plan,
        plan.demand_chain_edges[plan.demand_chain_starts[current] + divergence]);
    if prior_call < 0 || current_call < 0 ||
        plan.call_function_ids[prior_call] != plan.call_function_ids[current_call] ||
        plan.call_syntax_ids[prior_call] == plan.call_syntax_ids[current_call] { return false; }
    // Edges in the origin's own function (divergence 0) are judged against the
    // origin's loop scope; edges deeper in a callee keep the loop-free rule.
    let origin: Int = plan.aggregate_origin_ids[prior];
    if divergence == 0 {
        if SemanticAstCollectionCallRetirementSiteForOrigin(artifact, plan.call_syntax_ids[prior_call], origin) <= 0 ||
            SemanticAstCollectionCallRetirementSiteForOrigin(artifact, plan.call_syntax_ids[current_call], origin) <= 0 { return false; }
    } else if SemanticAstCollectionCallRetirementSite(artifact, plan.call_syntax_ids[prior_call]) <= 0 ||
        SemanticAstCollectionCallRetirementSite(artifact, plan.call_syntax_ids[current_call]) <= 0 { return false; }
    if !SemanticAstCollectionAggregateReleaseDeepChainLoopFree(artifact, plan, prior, divergence) ||
        !SemanticAstCollectionAggregateReleaseDeepChainLoopFree(artifact, plan, current, divergence) { return false; }
    let earlier_requirement: Int = prior_requirement;
    let earlier_call: Int = prior_call;
    if plan.call_syntax_ids[current_call] < plan.call_syntax_ids[prior_call] {
        earlier_requirement = current_requirement;
        earlier_call = current_call;
    }
    let earlier_mask: Int = plan.requirement_effect_masks[earlier_requirement];
    // An earlier deep drop is ordered only when its statement is followed by
    // one that leaves the routine, so the later call cannot run after it.
    if earlier_mask == SemanticAstCollectionAggregateFieldEntryEffectDeepDrop() || earlier_mask == 3 {
        return earlier_call < ArrayLength(plan.call_ends_routine) && plan.call_ends_routine[earlier_call];
    }
    return true;
}

func SemanticAstCollectionAggregateReleaseInvocationEnd(
    ref plan: SemanticAstCollectionAggregateReleasePlan, demand: Int
) -> Int {
    if demand + 1 < ArrayLength(plan.demand_invocation_starts) {
        return plan.demand_invocation_starts[demand + 1];
    }
    return ArrayLength(plan.demand_invocation_nodes);
}

// Two demands of one origin site reach distinct storage when their producer
// invocation paths differ at a common depth: each differing call node is a
// separate invocation, so its constructor runs separately. A path that is a
// prefix of the other (recursion) or an equal path shares one invocation.
func SemanticAstCollectionAggregateReleaseDistinctInvocations(
    ref plan: SemanticAstCollectionAggregateReleasePlan, prior: Int, current: Int
) -> Bool {
    if prior < 0 || current < 0 || prior >= ArrayLength(plan.demand_invocation_starts) ||
        current >= ArrayLength(plan.demand_invocation_starts) { return false; }
    let a: Int = plan.demand_invocation_starts[prior];
    let b: Int = plan.demand_invocation_starts[current];
    let a_end: Int = SemanticAstCollectionAggregateReleaseInvocationEnd(plan, prior);
    let b_end: Int = SemanticAstCollectionAggregateReleaseInvocationEnd(plan, current);
    let depth: Int = 0;
    while a + depth < a_end && b + depth < b_end {
        if plan.demand_invocation_nodes[a + depth] != plan.demand_invocation_nodes[b + depth] {
            return true;
        }
        depth = depth + 1;
    }
    return false;
}

func SemanticAstCollectionAggregateReleasePlanUnique(
    artifact: AstTreeArtifact,
    inout plan: SemanticAstCollectionAggregateReleasePlan,
    ref inputs: SemanticAstCollectionConstructorFieldInputs,
    ref storage: SemanticAstCollectionStorageAuthorityFacts,
    ref definitions: SemanticAstCollectionDefinitionFacts
) -> Bool {
    let row: Int = 0;
    while row < ArrayLength(plan.constructor_input_rows) {
        let input: Int = plan.constructor_input_rows[row];
        if input < 0 || input >= ArrayLength(inputs.producer_kinds) {
            return false;
        }
        let demand_call: Int = SemanticAstCollectionAggregateReleaseDemandCallRow(plan, row);
        let prior: Int = 0;
        while prior < row {
            let prior_input: Int = plan.constructor_input_rows[prior];
            if SemanticAstCollectionAggregateReleaseDistinctInvocations(plan, prior, row) {
                prior = prior + 1;
                continue;
            }
            if plan.aggregate_origin_ids[prior] ==
                    plan.aggregate_origin_ids[row] &&
                inputs.field_ids[prior_input] == inputs.field_ids[input] &&
                !SemanticAstCollectionAggregateReleaseSharedDemandReady(
                    artifact, plan, inputs, prior, row) {
                if demand_call >= 0 {
                    plan.diagnostic_syntax_id = plan.call_syntax_ids[demand_call];
                }
                return false;
            }
            if inputs.producer_kinds[prior_input] == 1 &&
                inputs.producer_kinds[input] == 1 {
                let prior_source: Int =
                    SemanticAstCollectionDefinitionStorageSource(
                        storage, definitions,
                        definitions.binding_rows[
                            inputs.definition_rows[prior_input]],
                        inputs.definition_rows[prior_input]);
                let source: Int =
                    SemanticAstCollectionDefinitionStorageSource(
                        storage, definitions,
                        definitions.binding_rows[
                            inputs.definition_rows[input]],
                        inputs.definition_rows[input]);
                if prior_source <= 0 || source <= 0 ||
                    (prior_source == source &&
                     ((prior_input != input &&
                       inputs.function_ids[prior_input] ==
                            inputs.function_ids[input]) ||
                      (plan.aggregate_origin_ids[prior] ==
                            plan.aggregate_origin_ids[row] &&
                       !SemanticAstCollectionAggregateReleaseSharedDemandReady(
                            artifact, plan, inputs, prior, row)))) {
                    if demand_call >= 0 {
                        plan.diagnostic_syntax_id = plan.call_syntax_ids[demand_call];
                    }
                    return false;
                }
            }
            prior = prior + 1;
        }
        row = row + 1;
    }
    return true;
}
