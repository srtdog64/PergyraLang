// Terminal owned-local and field-pack path transfer admission.

import "ast_collection_aggregate_release_plan_schema_owner.pgy";
import "ast_collection_ownership_member_move_owner.pgy";
import "ast_collection_ownership_member_root_identity_owner.pgy";
import "ast_assignment_fact_owner.pgy";
import "ast_expression_graph_call_argument_edge_owner.pgy";
import "ast_statement_fact_owner.pgy";
import "ast_expression_graph_receiver_type_owner.pgy";
import "ast_collection_member_path_type_owner.pgy";
import "ast_collection_argument_permission_effect_owner.pgy";
import "ast_collection_ownership_member_result_owner.pgy";
import "ast_local_binding_identity_owner.pgy";
import "ast_collection_constructor_storage_escape_owner.pgy";
import "ast_collection_exclusive_value_consumption_owner.pgy";
import "ast_collection_exclusive_value_owner.pgy";
import "ast_expression_storage_place_identity_owner.pgy";
import "ast_body_flow_verdict_owner.pgy";
import "ast_collection_aggregate_carrier_identity_owner.pgy";
import "ast_collection_aggregate_field_pack_restoration_owner.pgy";
import "ast_collection_aggregate_result_path_owner.pgy";

// A locally owned place may leave through a terminal return call when the
// existing exclusive-value summary proves that the callee carries this exact
// argument into its result. The place must occur once in that call and this
// statement must consume its last use. This does not authorize a borrow, an
// inout alias, a duplicate argument or a merely type-compatible result.
func SemanticAstCollectionAggregateTerminalOwnedLocalPathTransfer(
    artifact: AstTreeArtifact,
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    ref locals: SemanticAstLocalBindingFacts,
    ref inferred_types: Array<String>,
    ref resolved_leaf_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref assignments: SemanticAstAssignmentFacts,
    ref statements: SemanticAstStatementFacts,
    ref body_termination: SemanticAstBodyTerminationFacts,
    ref facts: SemanticAstCollectionExclusiveValueFacts,
    surface_row: Int, edge: SemanticCallArgumentEdgeView,
    source_binding_id: Int
) -> Bool {
    if !facts.ok || !edge.ok || source_binding_id <= 0 ||
        surface_row < 0 || surface_row >= ArrayLength(surfaces.node_ids) {
        return false;
    }
    let syntax_id: Int = surfaces.node_ids[surface_row];
    let function_id: Int = surfaces.function_node_ids[surface_row];
    if !SemanticAstBodyStatementReachable(
            artifact, signatures, body_termination, function_id,
            syntax_id) ||
        MapHas(facts.shared_locals, ToString(source_binding_id)) {
        return false;
    }
    var return_matches: Int = 0;
    var statement: Int = 0;
    while statement < ArrayLength(statements.node_ids) {
        if statements.node_ids[statement] == syntax_id &&
            statements.function_node_ids[statement] == function_id &&
            statements.kind_tags[statement] ==
                TypedAstKindValueReturnStmtTag() {
            return_matches = return_matches + 1;
        }
        statement = statement + 1;
    }
    if return_matches != 1 { return false; }

    var local_matches: Int = 0;
    var local_row: Int = -1;
    var local_index: Int = 0;
    while local_index < ArrayLength(locals.node_ids) {
        if locals.node_ids[local_index] == source_binding_id &&
            locals.function_node_ids[local_index] == function_id &&
            locals.binding_kinds[local_index] ==
                SemanticAstLocalBindingKindNormal() {
            local_matches = local_matches + 1;
            local_row = local_index;
        }
        local_index = local_index + 1;
    }
    if local_matches != 1 || local_row < 0 ||
        source_binding_id >= syntax_id {
        return false;
    }
    let place: SemanticAstCollectionAggregateSinkPlace =
        SemanticAstCollectionAggregateSinkPlaceForNode(
            artifact, signatures, locals, inferred_types, surfaces,
            function_id, syntax_id, edge.argument_node);
    if !place.ok || place.temporary || place.key != local_row {
        return false;
    }
    let formal: SemanticAstCollectionArgumentFormalTarget =
        SemanticAstCollectionArgumentFormalTargetForArgument(
            signatures, surfaces.expression_graph,
            edge.call_node, edge.ordinal);
    var mode: Option<Int> = None;
    if formal.ok {
        mode = SemanticAstFunctionParamModeAt(
            signatures, formal.signature_row, formal.ordinal);
    }
    // Typed AST modes are 1=inout, 2=own and 3=ref. Only a default value
    // argument or an explicit own argument may authorize terminal transfer;
    // a ref formal identifies a borrow and must remain rejected here.
    if !formal.ok || !IsSome(mode) ||
        (UnwrapOption(mode) != 0 && UnwrapOption(mode) != 2) {
        return false;
    }
    let returned_root: Option<Int> =
        SemanticAstExpressionGraphRootForNode(
            surfaces, syntax_id, AstExpressionLaneAtom());
    if !IsSome(returned_root) { return false; }
    let result_path: Option<String> =
        SemanticAstCollectionAggregateReturnedResultPath(
            artifact, signatures, constructors, locals, inferred_types,
                surfaces, facts, surface_row, UnwrapOption(returned_root), edge,
                "");
    if !IsSome(result_path) || formal.signature_row < 0 ||
        formal.signature_row >= ArrayLength(signatures.function_node_ids) {
        return false;
    }
    let required_formals: Array<Int> = [formal.syntax_id];
    let result_path_value: String = UnwrapOption(result_path);
    let required_result_paths: Array<String> = [result_path_value];
    if !SemanticAstCollectionAggregateFieldPackTerminalReturnsReady(
            artifact, signatures, constructors, locals, inferred_types,
            resolved_leaf_types, surfaces, assignments, statements,
            body_termination, facts,
            signatures.function_node_ids[formal.signature_row],
            required_formals, required_result_paths) {
        return false;
    }
    var aliases: Int = 0;
    let start: Option<Int> = SemanticExpressionGraphSubtreeStart(
        surfaces.expression_graph, UnwrapOption(returned_root));
    if !IsSome(start) { return false; }
    var node: Int = UnwrapOption(start);
    while node <= UnwrapOption(returned_root) {
        let candidate: SemanticCallArgumentEdgeView =
            SemanticCallArgumentEdgeFromGraph(
                surfaces.expression_graph, node);
        if candidate.ok && candidate.call_node == edge.call_node &&
            SemanticAstExpressionStoragePlaceEqual(
                artifact, locals, inferred_types, function_id, syntax_id,
                edge.argument_node, syntax_id, candidate.argument_node,
                surfaces.expression_graph) {
            aliases = aliases + 1;
        }
        node = node + 1;
    }
    if aliases != 1 { return false; }
    let no_fields: Array<String> = [];
    let no_sources: Array<Int> = [];
    let no_field_ids: Array<Int> = [];
    var recovery_only: Bool = false;
    return SemanticAstCollectionExclusivePlaceConsumed(
        artifact, signatures, constructors, locals, inferred_types,
        surfaces, assignments, facts.surface_starts, facts.surface_ends,
        facts.field_reads, facts.copies, function_id, syntax_id,
        edge.argument_node, no_fields, no_sources, no_field_ids,
        true, recovery_only);
}

// The carrying summary is a may-flow union, so it cannot by itself authorize
// a caller-side field pack. Replay each terminal return of the one callee and
// require every storage-bearing formal to occur exactly once at its promised
// result path on every return. The existing dependency facts resolve a local
// result holder back to its formal; fresh, crossed and ambiguous holders fail.
func SemanticAstCollectionAggregateFieldPackTerminalReturnsReady(
    artifact: AstTreeArtifact,
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    ref locals: SemanticAstLocalBindingFacts,
    ref inferred_types: Array<String>,
    ref resolved_leaf_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref assignments: SemanticAstAssignmentFacts,
    ref statements: SemanticAstStatementFacts,
    ref body_termination: SemanticAstBodyTerminationFacts,
    ref facts: SemanticAstCollectionExclusiveValueFacts,
    function_id: Int, ref required_formals: Array<Int>,
    ref required_result_paths: Array<String>
) -> Bool {
    if function_id <= 0 || ArrayLength(required_formals) == 0 ||
        ArrayLength(required_formals) !=
            ArrayLength(required_result_paths) {
        return false;
    }
    let key: String = ToString(function_id);
    if !MapHas(facts.surface_starts, key) ||
        !MapHas(facts.surface_ends, key) {
        return false;
    }
    let surface_start: Int = MapGet(facts.surface_starts, key);
    let surface_end: Int = MapGet(facts.surface_ends, key);
    if surface_start < 0 || surface_end <= surface_start ||
        surface_end > ArrayLength(surfaces.node_ids) {
        return false;
    }
    var expected_returns: Int = 0;
    var matched_returns: Int = 0;
    var statement: Int = 0;
    while statement < ArrayLength(statements.node_ids) {
        if statements.function_node_ids[statement] == function_id &&
            SemanticAstBodyStatementReachable(
                artifact, signatures, body_termination, function_id,
                statements.node_ids[statement]) {
            let kind: Int = statements.kind_tags[statement];
            if kind == TypedAstKindValueReturnStmtTag() {
                expected_returns = expected_returns + 1;
                let syntax_id: Int = statements.node_ids[statement];
                var surface_matches: Int = 0;
                var surface_row: Int = -1;
                var surface: Int = surface_start;
                while surface < surface_end {
                    if surfaces.node_ids[surface] == syntax_id &&
                        surfaces.function_node_ids[surface] == function_id {
                        surface_matches = surface_matches + 1;
                        surface_row = surface;
                    }
                    surface = surface + 1;
                }
                let root: Option<Int> =
                    SemanticAstExpressionGraphRootForNode(
                        surfaces, syntax_id, AstExpressionLaneAtom());
                if surface_matches != 1 || !IsSome(root) {
                    return false;
                }
                let subtree_start: Option<Int> =
                    SemanticExpressionGraphSubtreeStart(
                        surfaces.expression_graph, UnwrapOption(root));
                if !IsSome(subtree_start) { return false; }
                var required: Int = 0;
                while required < ArrayLength(required_formals) {
                    var matches: Int = 0;
                    var node: Int = UnwrapOption(subtree_start);
                    while node <= UnwrapOption(root) {
                        let edge: SemanticCallArgumentEdgeView =
                            SemanticCallArgumentEdgeFromGraph(
                                surfaces.expression_graph, node);
                        if edge.ok {
                            let source: Int =
                                SemanticAstCollectionAggregateMemberStorageBindingForNode(
                                    artifact, signatures, constructors,
                                    locals, inferred_types,
                                    resolved_leaf_types, function_id,
                                    syntax_id, surfaces,
                                    edge.argument_node);
                            let direct_formal: Bool = source > 0 &&
                                SemanticAstCollectionAggregateResultPathFormal(
                                    facts, surfaces, source,
                                    edge.argument_node) ==
                                    required_formals[required];
                            let reconstructed_formal: Bool = source > 0 &&
                                !direct_formal &&
                                SemanticAstCollectionAggregateHolderRestoresFormalWhole(
                                    signatures, constructors, locals,
                                    inferred_types, surfaces, facts, source,
                                    edge.argument_node,
                                    required_formals[required]);
                            var projected_formal_path: Option<String> = None;
                            if source > 0 && !direct_formal &&
                                !reconstructed_formal {
                                projected_formal_path =
                                    SemanticAstCollectionAggregateWholeHolderFormalPath(
                                        artifact, signatures, locals,
                                        inferred_types, resolved_leaf_types,
                                        facts, surfaces, assignments,
                                        function_id, syntax_id, source,
                                        edge.argument_node,
                                        required_formals[required]);
                            }
                            if direct_formal || reconstructed_formal ||
                                IsSome(projected_formal_path) {
                                var initial_source_path: String = "";
                                if IsSome(projected_formal_path) {
                                    initial_source_path = Concat("",
                                        UnwrapOption(projected_formal_path));
                                }
                                let result_path: Option<String> =
                                    SemanticAstCollectionAggregateReturnedResultPath(
                                        artifact, signatures, constructors,
                                        locals, inferred_types, surfaces,
                                        facts, surface_row,
                                        UnwrapOption(root), edge,
                                        initial_source_path);
                                let path_proved: Bool = IsSome(result_path) &&
                                    UnwrapOption(result_path) ==
                                        required_result_paths[required];
                                if path_proved && (reconstructed_formal ||
                                    IsSome(projected_formal_path) ||
                                    SemanticAstCollectionAggregateResultPathReturned(
                                        facts, surfaces, source,
                                        required_formals[required],
                                        edge.argument_node,
                                        UnwrapOption(result_path))) {
                                    matches = matches + 1;
                                }
                            }
                        }
                        node = node + 1;
                    }
                    if matches != 1 { return false; }
                    required = required + 1;
                }
                matched_returns = matched_returns + 1;
            } else if kind == TypedAstKindBareReturnStmtTag() ||
                kind == TypedAstKindExitStmtTag() ||
                kind == TypedAstKindFailStmtTag() {
                return false;
            }
        }
        statement = statement + 1;
    }
    return expected_returns > 0 && matched_returns == expected_returns;
}

