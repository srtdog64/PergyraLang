// Current aggregate generation and no-copy proof for release-bound values.
// A nominal type or matching field name never substitutes for exact binding,
// field, occurrence, and restoration identities.

import "ast_collection_aggregate_release_plan_schema_owner.pgy";
import "ast_collection_ownership_member_move_owner.pgy";
import "ast_collection_ownership_member_root_identity_owner.pgy";
import "ast_assignment_fact_owner.pgy";
import "ast_expression_graph_call_argument_edge_owner.pgy";
import "ast_statement_fact_owner.pgy";
import "ast_expression_graph_receiver_type_owner.pgy";
import "ast_collection_argument_permission_effect_owner.pgy";
import "ast_collection_ownership_member_result_owner.pgy";
import "ast_local_binding_identity_owner.pgy";

func SemanticAstCollectionAggregateValueBindingForNode(
    artifact: AstTreeArtifact,
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref locals: SemanticAstLocalBindingFacts,
    ref inferred_types: Array<String>,
    ref resolved_leaf_types: Array<String>,
    function_id: Int, syntax_id: Int,
    ref surfaces: SemanticAstExpressionSurfaceFacts, node: Int
) -> Int {
    let identity: SemanticAstCollectionMemberRootIdentity =
        SemanticAstCollectionMemberRootIdentityForNode(
            artifact, signatures, locals, inferred_types,
            resolved_leaf_types, function_id, syntax_id,
            surfaces.expression_graph, node);
    if !identity.ok { return 0; }
    return identity.source_binding_syntax_id;
}

func SemanticAstCollectionAggregateFieldCurrentAtUse(
    artifact: AstTreeArtifact,
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    ref locals: SemanticAstLocalBindingFacts,
    ref inferred_types: Array<String>,
    ref resolved_leaf_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref assignments: SemanticAstAssignmentFacts,
    function_id: Int, source_binding_id: Int,
    field_id: Int, use_syntax_id: Int
) -> Bool {
    if function_id <= 0 || source_binding_id <= 0 || field_id <= 0 ||
        use_syntax_id <= 0 { return false; }
    let row: Int = 0;
    while row < ArrayLength(assignments.node_ids) {
        let syntax_id: Int = assignments.node_ids[row];
        if assignments.function_node_ids[row] == function_id &&
            syntax_id < use_syntax_id {
            let atom: Option<Int> = SemanticAstExpressionGraphRootForNode(
                surfaces, syntax_id, AstExpressionLaneAtom());
            if IsSome(atom) {
                let member: SemanticAstCollectionMemberMoveIdentity =
                    SemanticAstCollectionMemberMoveIdentityForNode(
                        artifact, signatures, constructors, locals,
                        inferred_types, resolved_leaf_types, function_id,
                        syntax_id, surfaces.expression_graph,
                        UnwrapOption(atom));
                if member.ok &&
                    member.source_binding_syntax_id == source_binding_id &&
                    member.field_syntax_id == field_id {
                    return false;
                }
                let target_binding: Int =
                    SemanticAstCollectionAggregateValueBindingForNode(
                        artifact, signatures, locals, inferred_types,
                        resolved_leaf_types, function_id, syntax_id,
                        surfaces, UnwrapOption(atom));
                if target_binding == source_binding_id { return false; }
            }
        }
        row = row + 1;
    }
    return true;
}

func SemanticAstCollectionAggregateProtectedBinding(
    ref plan: SemanticAstCollectionAggregateReleasePlan,
    binding_id: Int
) -> Bool {
    if binding_id <= 0 { return false; }
    let row: Int = 0;
    while row < ArrayLength(plan.aggregate_origin_ids) {
        if plan.aggregate_origin_ids[row] == binding_id { return true; }
        row = row + 1;
    }
    row = 0;
    while row < ArrayLength(plan.carrier_local_ids) {
        if plan.carrier_local_ids[row] == binding_id ||
            plan.carrier_source_binding_ids[row] == binding_id {
            return true;
        }
        row = row + 1;
    }
    row = 0;
    while row < ArrayLength(plan.protected_binding_ids) {
        if plan.protected_binding_ids[row] == binding_id { return true; }
        row = row + 1;
    }
    return false;
}

func SemanticAstCollectionAggregateLineageEdge(
    ref plan: SemanticAstCollectionAggregateReleasePlan, edge_node: Int
) -> Bool {
    let row: Int = 0;
    while row < ArrayLength(plan.demand_edge_nodes) {
        if plan.demand_edge_nodes[row] == edge_node { return true; }
        row = row + 1;
    }
    row = 0;
    while row < ArrayLength(plan.lineage_call_edge_nodes) {
        if plan.lineage_call_edge_nodes[row] == edge_node { return true; }
        row = row + 1;
    }
    return false;
}

func SemanticAstCollectionAggregateRestorationForValue(
    ref plan: SemanticAstCollectionAggregateReleasePlan,
    ref moved_use: SemanticAstCollectionMemberMoveUse,
    binding_id: Int, syntax_id: Int
) -> Bool {
    let matched: Int = 0;
    let row: Int = 0;
    while row < ArrayLength(plan.carrier_local_ids) {
        if plan.carrier_local_ids[row] == binding_id &&
            plan.carrier_restoration_syntax_ids[row] == syntax_id {
            matched = matched + 1;
        }
        row = row + 1;
    }
    row = 0;
    while row < ArrayLength(moved_use.restored_binding_syntax_ids) {
        if moved_use.restored_binding_syntax_ids[row] == binding_id &&
            moved_use.restoration_syntax_ids[row] == syntax_id {
            matched = matched + 1;
        }
        row = row + 1;
    }
    return matched == 1;
}

func SemanticAstCollectionAggregateMemberStorageBindingForNode(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref resolved_leaf_types: Array<String>, function_id: Int, syntax_id: Int,
    ref surfaces: SemanticAstExpressionSurfaceFacts, node: Int
) -> Int {
    let member: SemanticMemberAccessView =
        SemanticMemberAccessViewFromGraph(surfaces.expression_graph, node);
    if !member.ok {
        return SemanticAstCollectionAggregateValueBindingForNode(
            artifact, signatures, locals, inferred_types, resolved_leaf_types,
            function_id, syntax_id, surfaces, node);
    }
    let spine: SemanticExpressionGraphValueReceiverSpine =
        SemanticExpressionGraphValueReceiverSpineFromGraph(surfaces.expression_graph, node);
    // A member of a call result: its declared return type projects the member.
    if spine.ok && spine.leaf_node < 0 && spine.call_node >= 0 {
        let returned: Option<String> = SemanticExpressionGraphCallReturnTypeName(surfaces.expression_graph, spine.call_node);
        let target: Option<Int> = SemanticExpressionGraphCallTargetSyntaxId(surfaces.expression_graph, spine.call_node);
        if !IsSome(returned) && IsSome(target) {
            let signature: Option<Int> = SemanticAstFunctionSignatureIndexForNode(signatures, UnwrapOption(target));
            if IsSome(signature) { returned = Some(Concat("", signatures.return_types[UnwrapOption(signature)])); }
        }
        if !IsSome(returned) { return -1; }
        let member_type: Option<String> = SemanticExpressionGraphValueReceiverProjectedTypeName(
            surfaces.expression_graph, node, constructors, spine.depth, UnwrapOption(returned));
        if !IsSome(member_type) || SemanticAstCollectionOwnershipIsStringArray(UnwrapOption(member_type)) { return -1; }
        return 0;
    }
    if !spine.ok || spine.leaf_node < 0 { return -1; }
    let root: SemanticAstCollectionMemberRootIdentity =
        SemanticAstCollectionMemberRootIdentityForNode(
            artifact, signatures, locals, inferred_types, resolved_leaf_types,
            function_id, syntax_id, surfaces.expression_graph, spine.leaf_node);
    if !root.ok {
        // A path from a static name, such as an enum variant, starts at no
        // local or formal and names no storage the plan releases.
        let leaf_local: SemanticAstLocalBindingIdentity = SemanticAstScopedLocalBindingIdentityForGraphLeaf(
            artifact, locals, inferred_types, function_id, syntax_id, surfaces.expression_graph, spine.leaf_node);
        let leaf_binding: SemanticExpressionBindingIdentityFact =
            SemanticExpressionGraphBindingIdentity(surfaces.expression_graph, spine.leaf_node);
        if !leaf_local.ok && leaf_binding.ok && leaf_binding.kind == SemanticExpressionBindingNone() { return 0; }
        return -1;
    }
    let projected: Option<String> = SemanticExpressionGraphValueReceiverProjectedTypeName(
        surfaces.expression_graph, node, constructors, spine.depth, root.type_name);
    if !IsSome(projected) { return -1; }
    if !SemanticAstCollectionOwnershipIsStringArray(UnwrapOption(projected)) { return 0; }
    return root.source_binding_syntax_id;
}


func SemanticAstCollectionAggregateArgumentAliasReady(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts, ref locals: SemanticAstLocalBindingFacts,
    ref inferred_types: Array<String>, ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref formal_effects: SemanticAstCollectionFormalEffects,
    ref moved_use: SemanticAstCollectionMemberMoveUse, slot: Int,
    edge: SemanticCallArgumentEdgeView, source: Int
) -> Bool {
    if source < 0 || !formal_effects.ok ||
        !SemanticAstCollectionFormalExecutionContextCallableReady(
            artifact, formal_effects.execution_contexts, surfaces.function_node_ids[slot / 3]) {
        return false;
    }
    let member: SemanticMemberAccessView =
        SemanticMemberAccessViewFromGraph(surfaces.expression_graph, edge.argument_node);
    if member.ok {
        let effect: SemanticAstCollectionArgumentPermissionEffect =
            SemanticAstCollectionArgumentPermissionEffectFromEdge(
                artifact, signatures, constructors, locals, inferred_types,
                surfaces, slot / 3, edge, formal_effects.inventory.row_by_formal,
                formal_effects.inventory.modes, formal_effects.effects);
        return effect.ok && !effect.unknown && !effect.retiring &&
            !effect.storage_escape && !effect.descriptor_retiring;
    }
    let target: SemanticAstCollectionArgumentFormalTarget =
        SemanticAstCollectionMemberReadCallTarget(
            artifact, signatures, surfaces.expression_graph, edge.call_node, edge.ordinal);
    return moved_use.read_permission_ready && target.ok &&
        SemanticAstCollectionFormalExecutionContextCallableReady(
            artifact, formal_effects.execution_contexts,
            signatures.function_node_ids[target.signature_row]) &&
        !SemanticAstCollectionMemberReadRootBlocked(
            moved_use.unproved_read_roots, target.syntax_id);
}
