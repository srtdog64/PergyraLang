// One admitted argument edge consumes physical descriptor effects for locals and
// formals. Content and liveness grants remain with their existing owners.
import "ast_collection_constructor_storage_escape_owner.pgy";
import "ast_collection_formal_effect_owner.pgy";
import "ast_collection_builtin_release_identity_owner.pgy";

struct SemanticAstCollectionArgumentPermissionEffect {
    ok: Bool;
    unknown: Bool;
    retiring: Bool;
    non_deep: Bool;
    storage_escape: Bool;
    constructor_field: SemanticAstCollectionConstructorFieldIdentity;
    descriptor_retiring: Bool;
}

func SemanticAstCollectionArgumentPermissionEffectFromEdge(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts, surface: Int,
    edge: SemanticCallArgumentEdgeView, formal_rows: HashMap<String, Int>,
    ref formal_modes: Array<Int>, descriptor_effects: HashMap<String, Int>
) -> SemanticAstCollectionArgumentPermissionEffect {
    let absent: SemanticAstCollectionConstructorFieldIdentity = SemanticAstCollectionConstructorFieldIdentity(true, 0, 0, "", -1, -1);
    let effect: SemanticAstCollectionArgumentPermissionEffect = SemanticAstCollectionArgumentPermissionEffect(false, false, false, false, false, absent, false);
    let escape: SemanticAstCollectionConstructorFieldIdentity = SemanticAstCollectionConstructorStorageEscapeField(
        artifact, constructors, locals, inferred_types, surfaces, surface, edge);
    if !escape.ok { return effect; }
    effect.constructor_field = escape;
    effect.storage_escape = effect.constructor_field.field_syntax_id > 0;
    let target: Option<Int> = SemanticExpressionGraphCallTargetSyntaxId(surfaces.expression_graph, edge.call_node);
    let callee: Option<Int> = SemanticCallBaseCalleeFromGraph(surfaces.expression_graph, edge.call_node);
    if !edge.ok || !IsSome(target) || !IsSome(callee) { return effect; }
    let identity: SemanticExpressionBindingIdentityFact = SemanticExpressionGraphBindingIdentity(surfaces.expression_graph, UnwrapOption(callee));
    if !identity.ok { return effect; }
    let declared: Bool = identity.kind != SemanticExpressionBindingNone() || identity.syntax_id > 0;
    let deep_drop: Bool = SemanticAstCollectionOwnershipBuiltinCall(surfaces.expression_graph, edge.call_node, "ArrayDropOwnedStrings");
    let releasing: Bool = SemanticAstCollectionBuiltinReleaseArgument(
        surfaces.expression_graph, edge.call_node, edge.ordinal);
    if edge.ordinal >= 0 && (UnwrapOption(target) > 0 || declared || releasing) {
        let formal: Int = SemanticAstCollectionSourceArrayFormalForArgument(signatures, surfaces.expression_graph, edge.call_node, edge.ordinal);
        let key: String = ToString(formal);
        let consuming: Bool = releasing;
        // A ref formal is a read-only borrow: both checkers refuse growth,
        // drops and moves through it, so it retires nothing of the argument.
        let borrowed: Bool = false;
        if MapHas(formal_rows, key) {
            let row: Int = MapGet(formal_rows, key);
            if row < 0 || row >= ArrayLength(formal_modes) { return effect; }
            consuming = formal_modes[row] == 2;
            borrowed = formal_modes[row] == 3;
        }
        let opaque: Bool = MapHas(descriptor_effects, key) && MapGet(descriptor_effects, key) ==
            SemanticAstCollectionFormalOpaqueExecutionEffect();
        let shallow: Bool = MapHas(descriptor_effects, key) && MapGet(descriptor_effects, key) ==
            SemanticAstCollectionFormalShallowMutationEffect();
        let unproved: Bool = !MapHas(descriptor_effects, key) || opaque ||
            MapGet(descriptor_effects, key) ==
                SemanticAstCollectionFormalUnprovedElementUseEffect();
        // Only a formal the effect analysis read in a body keeps that contract.
        borrowed = borrowed && MapHas(proved, key) && !opaque;
        effect.storage_escape = effect.storage_escape || opaque;
        effect.unknown = !consuming && unproved && !borrowed;
        effect.retiring = consuming || ((unproved || shallow) && !borrowed);
        effect.non_deep = effect.retiring && !deep_drop;
        // Shallow copyout invalidates siblings, not the descriptor written
        // back to the exact caller binding. Consumption still invalidates both.
        effect.descriptor_retiring = consuming || (unproved && !borrowed);
    }
    effect.ok = true;
    return effect;
}

func SemanticAstCollectionRecordFormalPermissionEffectAtSite(
    source: Int, site: Int, effect: SemanticAstCollectionArgumentPermissionEffect,
    inout unknown: HashMap<String, Int>, inout retiring: HashMap<String, Int>,
    inout non_deep: HashMap<String, Int>, inout escaping: HashMap<String, Int>,
    inout descriptor_retiring: HashMap<String, Int>
) -> Void {
    let key: String = ToString(source);
    if effect.unknown && (!MapHas(unknown, key) || site < MapGet(unknown, key)) { MapSet(unknown, key, site); }
    if effect.retiring && (!MapHas(retiring, key) || site < MapGet(retiring, key)) { MapSet(retiring, key, site); }
    if effect.non_deep && (!MapHas(non_deep, key) || site < MapGet(non_deep, key)) { MapSet(non_deep, key, site); }
    if effect.storage_escape && (!MapHas(escaping, key) || site < MapGet(escaping, key)) { MapSet(escaping, key, site); }
    if effect.descriptor_retiring && (!MapHas(descriptor_retiring, key) || site < MapGet(descriptor_retiring, key)) { MapSet(descriptor_retiring, key, site); }
}
