// Effect-specific argument admission after the physical edge, binding and
// storage source have been resolved by the orchestration owner.
import "ast_collection_call_effect_owner.pgy";
import "ast_collection_ownership_verdict_carrier_owner.pgy";
import "ast_collection_formal_storage_permission_owner.pgy";
import "ast_collection_aggregate_field_entry_requirement_owner.pgy";

func SemanticAstCollectionFormalIndexedReadReady(
    artifact: AstTreeArtifact,
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    surface_row: Int, argument_node: Int,
    ref call_effects: SemanticAstCollectionCallEffectFacts
) -> Bool {
    let formal: SemanticAstCollectionFormalStorageIdentity =
        SemanticAstCollectionStringArrayFormalIdentity(
            signatures, surfaces.function_node_ids[surface_row],
            surfaces.expression_graph, argument_node);
    return formal.ok && formal.mode != 2 &&
        !SemanticAstCollectionFormalCurrentDescriptorPermissionUnproved(
            artifact, surfaces.node_ids[surface_row],
            formal.syntax_id, call_effects);
}

func SemanticAstCollectionCallArgumentEffectVerdict(
    artifact: AstTreeArtifact,
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref locals: SemanticAstLocalBindingFacts,
    ref surfaces: SemanticAstExpressionSurfaceFacts, surface_row: Int,
    edge: SemanticCallArgumentEdgeView,
    literal_read_ready: Bool, member_read_ready: Bool, proved: HashMap<String, Int>, effect: Int,
    owned_push_leaf_formals: HashMap<String, Int>,
    ref field_requirements:
        SemanticAstCollectionAggregateFieldEntryRequirements,
    binding: SemanticAstLocalBindingIdentity,
    unknown: Bool, borrowed_storage: Bool, owned_storage: Bool,
    repeated_fresh_generation: Bool, current_definition: Int,
    retains_descriptor: Bool,
    inout ownership: Array<Int>, ref dispositions: Array<Int>,
    ref origins: Array<Int>, inout transition_states: Array<Int>,
    ref call_effects: SemanticAstCollectionCallEffectFacts, admitted_own_read_entry: Bool
) -> SemanticAstCollectionOwnershipVerdict {
    if effect == SemanticAstCollectionFormalShallowMutationEffect() {
        if binding.ok {
            let borrowed: Bool = ownership[binding.row] ==
                    SemanticAstCollectionOwnershipBorrowedElements() ||
                borrowed_storage || owned_storage;
            let current_empty_descriptor: Bool = false;
            let exact_retention_entry: Bool = retains_descriptor &&
                call_effects.first_storage_escape_sites[binding.row] ==
                    surfaces.node_ids[surface_row];
            if origins[binding.row] == SemanticAstCollectionOriginEmptyLiteral() {
                borrowed = owned_storage || transition_states[binding.row] ==
                        SemanticAstCollectionTransitionEmpty() ||
                    transition_states[binding.row] ==
                        SemanticAstCollectionTransitionBorrowed();
                // The current exclusive descriptor receives shallow copyout;
                // sibling invalidation is not its consumption. The separate
                // definition-bound negative fact includes real retirement.
                current_empty_descriptor = owned_storage &&
                    SemanticAstCollectionCurrentDescriptorLiveAtUse(
                        artifact, call_effects, current_definition,
                        surfaces.node_ids[surface_row]) &&
                    !SemanticAstCollectionFormalEffectSyntaxIsDeferred(
                        artifact, surfaces.node_ids[surface_row]);
            }
            if unknown || !borrowed ||
                dispositions[binding.row] ==
                    SemanticAstCollectionDispositionRetired() ||
                (SemanticAstCollectionStorageEscapedAtUse(
                    artifact, call_effects, binding.row,
                    surfaces.node_ids[surface_row]) &&
                    !exact_retention_entry) ||
                (SemanticAstCollectionShallowMutationHasPriorEffect(
                        artifact, surfaces.node_ids[surface_row],
                        call_effects.first_retiring_sites[binding.row],
                        call_effects.first_non_deep_drop_retiring_sites[
                            binding.row]) &&
                    !current_empty_descriptor) {
                return SemanticAstCollectionOwnershipVerdictError(
                    "borrow_boundary_escape",
                    SemanticError3("borrow_boundary_escape", "boundary",
                        "unproved_shallow_mutation_entry", "type",
                        "Array<String>", "binding",
                        Concat("", locals.names[binding.row])),
                    surfaces.node_ids[surface_row], edge.call_node);
            }
            if origins[binding.row] == SemanticAstCollectionOriginEmptyLiteral() &&
                owned_storage && transition_states[binding.row] !=
                    SemanticAstCollectionTransitionBorrowed() {
                transition_states[binding.row] =
                    SemanticAstCollectionTransitionBorrowed();
            }
        } else {
            let actual_formal: SemanticAstCollectionFormalStorageIdentity =
                SemanticAstCollectionStringArrayFormalIdentity(
                    signatures, surfaces.function_node_ids[surface_row],
                    surfaces.expression_graph, edge.argument_node);
            // An `own` formal is already the exclusive storage authority in
            // this body. That authority is checked independently of a caller-side
            // element summary. Borrowed/inout formals still require their exact
            // fixed-point effect before they may be forwarded to a shallow
            // mutator.
            let actual_effect_ready: Bool = actual_formal.ok &&
                actual_formal.mode == 2;
            if actual_formal.ok && actual_formal.mode != 2 {
                let actual_key: String = ToString(actual_formal.syntax_id);
                if MapHas(proved, actual_key) {
                    let actual_effect: Int = MapGet(proved, actual_key);
                    actual_effect_ready = actual_effect !=
                            SemanticAstCollectionFormalOpaqueExecutionEffect() &&
                        actual_effect !=
                            SemanticAstCollectionFormalUnprovedElementUseEffect();
                }
            }
            if !actual_formal.ok ||
                (actual_formal.mode != 1 && actual_formal.mode != 2) ||
                !actual_effect_ready ||
                SemanticAstCollectionFormalCurrentDescriptorPermissionUnproved(
                    artifact, surfaces.node_ids[surface_row],
                    actual_formal.syntax_id, call_effects) {
                return SemanticAstCollectionOwnershipVerdictError(
                    "borrow_boundary_escape",
                    SemanticError2(
                        "borrow_boundary_escape", "boundary",
                        "unproved_formal_shallow_mutation_entry",
                        "type", "Array<String>"),
                    surfaces.node_ids[surface_row], edge.call_node);
            }
        }
    }
    if effect == 2 || effect == 3 {
        if binding.ok {
            let aggregate_owned_push_entry: Bool = false;
            if effect == 2 && origins[binding.row] ==
                    SemanticAstCollectionOriginMemberMove() {
                let target_formal: Int =
                    SemanticAstCollectionSourceArrayFormalForArgument(
                        signatures, surfaces.expression_graph,
                        edge.call_node, edge.ordinal);
                let requirement_row: Int =
                    SemanticAstCollectionAggregateFieldEntryIndexRow(
                        field_requirements.row_by_local,
                        locals.node_ids[binding.row]);
                aggregate_owned_push_entry = target_formal > 0 &&
                    MapHas(owned_push_leaf_formals,
                        ToString(target_formal)) &&
                    requirement_row >= 0 &&
                    requirement_row <
                        ArrayLength(field_requirements.effect_masks) &&
                    SemanticAstCollectionAggregateRequirementHasEffect(
                        field_requirements.effect_masks[requirement_row],
                        SemanticAstCollectionAggregateFieldEntryEffectOwnedPush());
            }
            let clean: Bool = ownership[binding.row] ==
                    SemanticAstCollectionOwnershipOwnedElements() ||
                ownership[binding.row] ==
                    SemanticAstCollectionOwnershipMapKeysSnapshot() ||
                aggregate_owned_push_entry;
            if origins[binding.row] == SemanticAstCollectionOriginEmptyLiteral() {
                clean = SemanticAstCollectionTransitionAllowsOwned(
                    transition_states[binding.row]);
            }
            // A proved shallow call writes the grown descriptor back to this
            // fresh local. The borrowed transition permits reads, not owned
            // elements. Its own retirement fact, not a sibling invalidation
            // bound, decides liveness. Detached reads earn no exception.
            let current_borrowed_read: Bool = effect == 3 && owned_storage &&
                origins[binding.row] == SemanticAstCollectionOriginEmptyLiteral() &&
                transition_states[binding.row] == SemanticAstCollectionTransitionBorrowed() &&
                SemanticAstCollectionCurrentDescriptorLiveAtUse(artifact,
                    call_effects, current_definition, surfaces.node_ids[surface_row]) &&
                !SemanticAstCollectionStorageEscapedAtUse(artifact, call_effects,
                    binding.row, surfaces.node_ids[surface_row]) &&
                !SemanticAstCollectionFormalEffectSyntaxIsDeferred(artifact, surfaces.node_ids[surface_row]);
            if unknown || (effect == 2 && !clean) ||
                dispositions[binding.row] ==
                    SemanticAstCollectionDispositionRetired() ||
                (effect == 2 && SemanticAstCollectionStorageEscapedAtUse(
                    artifact, call_effects, binding.row,
                    surfaces.node_ids[surface_row])) ||
                (SemanticAstCollectionMutableCallMayBeRetired(
                    artifact, surfaces.node_ids[surface_row],
                    call_effects.first_retiring_sites[binding.row]) &&
                    !repeated_fresh_generation && !current_borrowed_read && !admitted_own_read_entry) {
                let boundary: String = "unproved_inout_copy_entry";
                if effect == 3 { boundary = "unproved_indexed_read_entry"; }
                return SemanticAstCollectionOwnershipVerdictError(
                    "borrow_boundary_escape",
                    SemanticError3("borrow_boundary_escape", "boundary",
                        boundary, "type", "Array<String>", "binding",
                        Concat("", locals.names[binding.row])),
                    surfaces.node_ids[surface_row], edge.call_node);
            }
            if effect == 2 &&
                origins[binding.row] == SemanticAstCollectionOriginEmptyLiteral() &&
                transition_states[binding.row] ==
                    SemanticAstCollectionTransitionEmpty() {
                transition_states[binding.row] =
                    SemanticAstCollectionTransitionClean();
            }
        } else {
            let formal_read_ready: Bool = effect == 3 &&
                SemanticAstCollectionFormalIndexedReadReady(
                    artifact, signatures, surfaces, surface_row,
                    edge.argument_node, call_effects);
            if SemanticAstCollectionOwnershipParameterModeForArgument(
                    signatures, surfaces, surface_row,
                    edge.argument_node) == 3 ||
                (effect == 3 && !literal_read_ready && !formal_read_ready && !member_read_ready) {
                let boundary: String = "unproved_own_formal_copy_entry";
                if effect == 3 {
                    boundary = "unproved_formal_indexed_read_entry";
                }
                return SemanticAstCollectionOwnershipVerdictError(
                    "borrow_boundary_escape",
                    SemanticError2("borrow_boundary_escape", "boundary",
                        boundary, "type", "Array<String>"),
                    surfaces.node_ids[surface_row], edge.call_node);
            }
        }
    }
    return SemanticAstCollectionOwnershipVerdictOk();
}
