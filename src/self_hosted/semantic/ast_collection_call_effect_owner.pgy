// Possible effects are syntax bounds, never permission changes in a prepass.
import "ast_collection_formal_effect_owner.pgy";
import "ast_collection_ownership_identity_owner.pgy";
import "ast_collection_ownership_state_owner.pgy";
import "ast_collection_call_retirement_owner.pgy";
import "ast_collection_call_effect_fact_owner.pgy";
import "ast_collection_definition_storage_authority_owner.pgy";
import "ast_collection_argument_permission_effect_owner.pgy";
import "ast_collection_definition_effect_closure_owner.pgy";
import "ast_collection_owned_parameter_identity_owner.pgy";
import "ast_collection_owned_generation_order_owner.pgy";

func SemanticAstCollectionCallEffectFactsFromResolvedFacts(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    formal_rows: HashMap<String, Int>, ref formal_modes: Array<Int>,
    proved: HashMap<String, Int>, ref definitions: SemanticAstCollectionDefinitionFacts,
    ref storage: SemanticAstCollectionStorageAuthorityFacts
) -> SemanticAstCollectionCallEffectFacts {
    let unknown: Array<Int> = [];
    let retiring: Array<Int> = [];
    let non_deep_drop: Array<Int> = [];
    let escaping: Array<Int> = [];
    let descriptor_retiring: Array<Int> = [];
    let local_unknown: Array<Int> = [];
    let local_retiring: Array<Int> = [];
    let local_non_deep: Array<Int> = [];
    let local_escape: Array<Int> = [];
    let zero_unknown: Array<Bool> = [];
    let zero_retiring: Array<Bool> = [];
    let zero_non_deep: Array<Bool> = [];
    let zero_escape: Array<Bool> = [];
    let zero_descriptor_retiring: Array<Bool> = [];
    let formal_escape: HashMap<String, Int> = MapNew();
    let formal_unknown: HashMap<String, Int> = MapNew();
    let formal_retiring: HashMap<String, Int> = MapNew();
    let formal_non_deep: HashMap<String, Int> = MapNew();
    let formal_descriptor_retiring: HashMap<String, Int> = MapNew();
    let constructor_inputs: SemanticAstCollectionConstructorFieldInputs = SemanticAstCollectionConstructorFieldInputsEmpty();
    let retention: SemanticAstCollectionFormalDescriptorRetention =
        SemanticAstCollectionFormalDescriptorRetentionEmpty();
    let parents: Array<Int> = [];
    let count: Int = ArrayLength(definitions.syntax_ids);
    let current: Array<Int> = SemanticAstCollectionInitialDefinitions(definitions);
    if !definitions.ok || !storage.ok || ArrayLength(storage.borrowed_definitions) != count ||
        ArrayLength(storage.borrowed_seed_sources) != count ||
        ArrayLength(storage.producer_source_ids) != count ||
        ArrayLength(inferred_types) != definitions.local_count ||
        !SemanticAstExpressionSurfaceBorrowReady(artifact, surfaces) {
        return SemanticAstCollectionCallEffectFacts(false, local_unknown, local_retiring, local_non_deep, unknown, retiring, non_deep_drop, local_escape, escaping, formal_escape, formal_unknown, formal_retiring, formal_non_deep, constructor_inputs, descriptor_retiring, formal_descriptor_retiring, retention);
    }
    let row: Int = 0;
    while row < count {
        ArrayPush(unknown, -1); ArrayPush(retiring, -1); ArrayPush(non_deep_drop, -1); ArrayPush(parents, storage.borrowed_seed_sources[row]);
        ArrayPush(escaping, -1);
        ArrayPush(descriptor_retiring, -1);
        if row < definitions.local_count {
            ArrayPush(local_unknown, -1); ArrayPush(local_retiring, -1); ArrayPush(local_non_deep, -1);
            ArrayPush(local_escape, -1); ArrayPush(zero_escape, false);
            ArrayPush(zero_descriptor_retiring, false);
            ArrayPush(zero_unknown, false); ArrayPush(zero_retiring, false); ArrayPush(zero_non_deep, false);
        }
        row = row + 1;
    }
    let last: Int = -1;
    let slot: Int = 0;
    while slot < ArrayLength(surfaces.expression_graph.roots) {
        if surfaces.expression_graph.has_roots[slot] {
            let root: Int = surfaces.expression_graph.roots[slot];
            let node: Int = last + 1;
            while node <= root {
                if surfaces.expression_graph.arena.topology.node_kinds[node] == AstExpressionNodeCallArgument() {
                    let call: SemanticCallArgumentEdgeView = SemanticCallArgumentEdgeFromGraph(surfaces.expression_graph, node);
                    if !call.ok { return SemanticAstCollectionCallEffectFacts(false, local_unknown, local_retiring, local_non_deep, unknown, retiring, non_deep_drop, local_escape, escaping, formal_escape, formal_unknown, formal_retiring, formal_non_deep, constructor_inputs, descriptor_retiring, formal_descriptor_retiring, retention); }
                    let binding: SemanticAstLocalBindingIdentity = SemanticAstCollectionOwnershipLocalForArgument(
                        artifact, locals, inferred_types, surfaces, slot / 3, call.argument_node);
                    let source: Int = 0;
                    if !binding.ok {
                        let formal: SemanticAstCollectionFormalStorageIdentity =
                            SemanticAstCollectionStringArrayFormalIdentity(
                                signatures,
                                surfaces.function_node_ids[slot / 3],
                                surfaces.expression_graph,
                                call.argument_node);
                        if formal.ok {
                            source = formal.syntax_id;
                        }
                    }
                    let local_array: Bool = binding.ok && SemanticAstCollectionOwnershipIsStringArray(Concat("", inferred_types[binding.row]));
                    if source <= 0 && !local_array && !SemanticAstCollectionConstructorFieldInputCandidate(surfaces.expression_graph, call.argument_node, binding) {
                        node = node + 1;
                        continue;
                    }
                    let effect: SemanticAstCollectionArgumentPermissionEffect = SemanticAstCollectionArgumentPermissionEffectFromEdge(
                        artifact, signatures, constructors, locals, inferred_types, surfaces, slot / 3, call, formal_rows, formal_modes, proved);
                    if !effect.ok { return SemanticAstCollectionCallEffectFacts(false, local_unknown, local_retiring, local_non_deep, unknown, retiring, non_deep_drop, local_escape, escaping, formal_escape, formal_unknown, formal_retiring, formal_non_deep, constructor_inputs, descriptor_retiring, formal_descriptor_retiring, retention); }
                    if effect.constructor_field.field_syntax_id > 0 && SemanticAstCollectionOwnershipIsStringArray(effect.constructor_field.field_type_name) {
                        let input_binding: Int = -1;
                        if local_array { input_binding = binding.row; }
                        if !SemanticAstCollectionConstructorFieldInputRecord(locals, definitions, surfaces, slot, node, call,
                            effect.constructor_field, input_binding, current, constructor_inputs) {
                            return SemanticAstCollectionCallEffectFacts(false, local_unknown, local_retiring, local_non_deep, unknown, retiring, non_deep_drop, local_escape, escaping, formal_escape, formal_unknown, formal_retiring, formal_non_deep, constructor_inputs, descriptor_retiring, formal_descriptor_retiring, retention);
                        }
                    }
                    if source > 0 || local_array {
                        let site: Int = SemanticAstCollectionCallRetirementSite(artifact, surfaces.node_ids[slot / 3]);
                        let terminal: Bool = SemanticAstCollectionEffectSiteTerminatesFlow(
                            artifact, surfaces.node_ids[slot / 3]);
                        let target_formal: Int = SemanticAstCollectionSourceArrayFormalForArgument(
                            signatures, surfaces.expression_graph, call.call_node, call.ordinal);
                        let definition: Int = -1;
                        if local_array { definition = current[binding.row]; }
                        // A proved loop-local generation is consumed at this
                        // event, not by every iteration's future cleanup.
                        // An exact constructor field retains only this
                        // generation; the next iteration binds a fresh one.
                        // Opaque, escaping and nested/reordered events retain
                        // the conservative sentinel and sibling obligations.
                        let field_escape: Bool = effect.storage_escape && !effect.retiring &&
                            effect.constructor_field.field_syntax_id > 0;
                        if site == 0 && local_array && !effect.unknown &&
                            ((effect.descriptor_retiring && !effect.storage_escape) || field_escape) &&
                            SemanticAstCollectionFreshLocalGenerationAtUse(
                                artifact, locals, definitions, binding.row,
                                definition, surfaces.node_ids[slot / 3], false) &&
                            SemanticAstCollectionDefinitionStorageSource(
                                storage, definitions, binding.row, definition) > 0 {
                            site = surfaces.node_ids[slot / 3];
                            // Keep same-scope post-transfer checking with the
                            // ordered owner, without erasing later normal effects.
                            terminal = terminal || (!field_escape &&
                                SemanticAstCollectionTerminatingRetirementScope(
                                    artifact, site, false) >= 0);
                        }
                        SemanticAstCollectionFormalDescriptorRetentionRecord(retention,
                            source, target_formal, effect.storage_escape, definition,
                            binding.row, site, terminal);
                        if source > 0 && !terminal {
                            SemanticAstCollectionRecordFormalPermissionEffectAtSite(
                                source, site, effect, formal_unknown, formal_retiring, formal_non_deep, formal_escape, formal_descriptor_retiring);
                        }
                        if local_array && !terminal {
                            if effect.storage_escape && (escaping[definition] < 0 || site < escaping[definition]) { escaping[definition] = site; }
                            if effect.retiring && (retiring[definition] < 0 || site < retiring[definition]) { retiring[definition] = site; }
                            if effect.non_deep && (non_deep_drop[definition] < 0 || site < non_deep_drop[definition]) { non_deep_drop[definition] = site; }
                            if effect.unknown && (unknown[definition] < 0 || site < unknown[definition]) { unknown[definition] = site; }
                            if effect.descriptor_retiring && (descriptor_retiring[definition] < 0 || site < descriptor_retiring[definition]) { descriptor_retiring[definition] = site; }
                            // Repeat/reorder reads the binding later, not a
                            // proved snapshot of this definition's storage.
                            if site == 0 {
                                if effect.storage_escape { zero_escape[binding.row] = true; }
                                if effect.retiring { zero_retiring[binding.row] = true; }
                                if effect.non_deep { zero_non_deep[binding.row] = true; }
                                if effect.unknown { zero_unknown[binding.row] = true; }
                                if effect.descriptor_retiring { zero_descriptor_retiring[binding.row] = true; }
                            }
                        }
                    }
                }
                node = node + 1;
            }
            last = root;
            if slot % 3 == AstExpressionLaneValue() {
                let assigned: Int = definitions.surface_rows[slot / 3];
                if assigned >= definitions.local_count {
                    let completed: Int = SemanticAstCollectionDefinitionCompletedAtSlot(definitions, locals, surfaces, slot);
                    current[definitions.binding_rows[completed]] = completed;
                } else {
                    let declared: Option<Int> = SemanticAstLocalBindingIndexForNode(locals, surfaces.node_ids[slot / 3]);
                    if IsSome(declared) && definitions.local_sources[UnwrapOption(declared)] >= 0 {
                        parents[UnwrapOption(declared)] = current[definitions.local_sources[UnwrapOption(declared)]];
                    }
                }
            }
        }
        slot = slot + 1;
    }
    if !SemanticAstCollectionFormalDescriptorRetentionSeal(
            retention, formal_escape, escaping, zero_escape) {
        return SemanticAstCollectionCallEffectFacts(false, local_unknown, local_retiring, local_non_deep, unknown, retiring, non_deep_drop, local_escape, escaping, formal_escape, formal_unknown, formal_retiring, formal_non_deep, constructor_inputs, descriptor_retiring, formal_descriptor_retiring, retention);
    }
    row = 0;
    while row < count {
        let binding: Int = definitions.binding_rows[row];
        if zero_unknown[binding] { unknown[row] = 0; }
        if zero_retiring[binding] { retiring[row] = 0; }
        if zero_non_deep[binding] { non_deep_drop[row] = 0; }
        if zero_escape[binding] { escaping[row] = 0; }
        if zero_descriptor_retiring[binding] { descriptor_retiring[row] = 0; }
        row = row + 1;
    }
    SemanticAstCollectionDefinitionEffectClosure(
        definitions, storage, parents, unknown, retiring, non_deep_drop, escaping, descriptor_retiring);
    let facts: SemanticAstCollectionCallEffectFacts = SemanticAstCollectionCallEffectFacts(
        true, local_unknown, local_retiring, local_non_deep, unknown, retiring, non_deep_drop, local_escape, escaping, formal_escape, formal_unknown, formal_retiring, formal_non_deep, constructor_inputs, descriptor_retiring, formal_descriptor_retiring, retention);
    facts.ok = SemanticAstCollectionConstructorFieldInputsPendingReady(
        artifact, constructor_inputs, constructors, locals, inferred_types, definitions, surfaces);
    row = 0;
    while row < definitions.local_count { SemanticAstCollectionSelectDefinitionEffects(facts, row, row); row = row + 1; }
    return facts;
}
