// Conservative syntax-order bounds, not graph-row invocation order.
// 0 means retirement may repeat/reorder; -1 means no admitted retirement site.
import "../hir/ast_text_arena_projection_owner.pgy";

func SemanticAstCollectionCallRetirementSite(
    artifact: AstTreeArtifact, syntax_id: Int
) -> Int {
    let ancestor: Int = syntax_id;
    let remaining: Int = artifact.count;
    while ancestor >= 0 && remaining > 0 {
        if TypedAstArenaNodeKindIs(artifact.arena, ancestor, TypedAstKindWhileStmtTag()) ||
            TypedAstArenaNodeKindIs(artifact.arena, ancestor, TypedAstKindForStmtTag()) ||
            TypedAstArenaNodeKindIs(artifact.arena, ancestor, TypedAstKindDeferStmtTag()) { return 0; }
        let parent: Option<Int> = TypedAstArenaParentId(artifact.arena, ancestor);
        if !IsSome(parent) { return syntax_id; }
        ancestor = UnwrapOption(parent);
        remaining = remaining - 1;
    }
    return 0;
}

// A fresh local definition inside one repeated body starts a new storage
// generation on every iteration.  Exact lexical binding owns visibility; this
// owner only proves that the selected definition and use share that generation
// and that deferred execution cannot reorder the use past its cleanup.
func SemanticAstCollectionRepeatedLocalGenerationPrecedesUse(
    ref artifact: AstTreeArtifact, definition_syntax_id: Int,
    use_syntax_id: Int, scope_syntax_id: Int
) -> Bool {
    // The collection verdict entrypoint already admitted the artifact.  This
    // per-argument predicate must not repeat the whole-artifact readiness walk.
    if (artifact.count <= 0 || definition_syntax_id < 0 || use_syntax_id < 0 ||
        definition_syntax_id >= use_syntax_id ||
        definition_syntax_id >= artifact.count ||
        use_syntax_id >= artifact.count || scope_syntax_id < 0 ||
        scope_syntax_id >= artifact.count ||
        ArrayLength(artifact.arena.parents) != artifact.count ||
        ArrayLength(artifact.arena.kinds) != artifact.count) {
        return false;
    }
    let definition_parent: Int =
        artifact.arena.parents[definition_syntax_id];
    let use_parent: Int = artifact.arena.parents[use_syntax_id];
    let repeated_owner: Int = artifact.arena.parents[scope_syntax_id];
    if definition_parent != scope_syntax_id ||
        use_parent != scope_syntax_id || repeated_owner < 0 ||
        repeated_owner >= artifact.count {
        return false;
    }
    let use_kind: Int = artifact.arena.kinds[use_syntax_id];
    if use_kind == TypedAstKindDeferStmtTag() ||
        use_kind == TypedAstKindParallelBlockTag() ||
        use_kind == TypedAstKindAsyncBlockTag() {
        return false;
    }
    let repeated_kind: Int = artifact.arena.kinds[repeated_owner];
    return repeated_kind == TypedAstKindWhileStmtTag() ||
        repeated_kind == TypedAstKindForStmtTag();
}

func SemanticAstCollectionMutableCallMayBeRetired(
    ref artifact: AstTreeArtifact, syntax_id: Int, first_retiring_syntax_id: Int
) -> Bool {
    if first_retiring_syntax_id < 0 { return false; }
    // Equality also closes nested own consumption during argument evaluation.
    if first_retiring_syntax_id <= syntax_id { return true; }
    if syntax_id < 0 || syntax_id >= artifact.count ||
        ArrayLength(artifact.arena.parents) != artifact.count ||
        ArrayLength(artifact.arena.kinds) != artifact.count { return true; }
    let ancestor: Int = syntax_id;
    let remaining: Int = artifact.count;
    while ancestor >= 0 && remaining > 0 {
        if ancestor >= artifact.count || artifact.arena.kinds[ancestor] == TypedAstKindDeferStmtTag() { return true; }
        let parent: Int = artifact.arena.parents[ancestor];
        if parent < 0 { return false; }
        ancestor = parent;
        remaining = remaining - 1;
    }
    return true;
}

func SemanticAstCollectionMutationMayBeRetired(
    artifact: AstTreeArtifact, syntax_id: Int,
    first_retiring_site: Int, first_non_deep_drop_site: Int
) -> Bool {
    let bound: Int = first_non_deep_drop_site;
    // A deferred/repeated mutation can execute after a lexically later drop.
    // Ordinary mutation still precedes a known future deferred cleanup.
    if first_retiring_site >= 0 && SemanticAstCollectionCallRetirementSite(artifact, syntax_id) == 0 {
        bound = first_retiring_site;
    }
    return SemanticAstCollectionMutableCallMayBeRetired(artifact, syntax_id, bound);
}

// A proved shallow mutation owns its exact straight-line event. It invalidates
// sibling descriptors after that event, but must not reject the mutation call
// merely because the precomputed bound includes the call itself. A repeated or
// reordered site has bound zero and cannot claim this exception.
func SemanticAstCollectionShallowMutationHasPriorEffect(
    artifact: AstTreeArtifact, syntax_id: Int,
    first_retiring_site: Int, first_non_deep_site: Int
) -> Bool {
    let current_site: Int = SemanticAstCollectionCallRetirementSite(
        artifact, syntax_id);
    let bound: Int = first_non_deep_site;
    if current_site == 0 {
        return first_retiring_site >= 0 || first_non_deep_site >= 0;
    }
    if bound < 0 { return false; }
    return bound < current_site;
}
