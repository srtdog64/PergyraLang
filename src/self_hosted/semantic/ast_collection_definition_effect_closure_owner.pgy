// One definition graph owns effect inheritance. Borrowed storage shares real
// effects bidirectionally; consuming moves only inherit. No state is granted.
import "ast_collection_definition_storage_authority_owner.pgy";

func SemanticAstCollectionMergeDefinitionEffectBounds(
    inout unknown: Array<Int>, inout retiring: Array<Int>,
    inout non_deep: Array<Int>, inout escaping: Array<Int>,
    inout descriptor_retiring: Array<Int>,
    source: Int, target: Int
) -> Bool {
    let changed: Bool = false;
    let site: Int = unknown[source];
    if site >= 0 && (unknown[target] < 0 || site < unknown[target]) { unknown[target] = site; changed = true; }
    site = retiring[source];
    if site >= 0 && (retiring[target] < 0 || site < retiring[target]) { retiring[target] = site; changed = true; }
    site = non_deep[source];
    if site >= 0 && (non_deep[target] < 0 || site < non_deep[target]) { non_deep[target] = site; changed = true; }
    site = escaping[source];
    if site >= 0 && (escaping[target] < 0 || site < escaping[target]) { escaping[target] = site; changed = true; }
    site = descriptor_retiring[source];
    if site >= 0 && (descriptor_retiring[target] < 0 || site < descriptor_retiring[target]) { descriptor_retiring[target] = site; changed = true; }
    return changed;
}

func SemanticAstCollectionDefinitionEffectClosure(
    ref definitions: SemanticAstCollectionDefinitionFacts,
    ref storage: SemanticAstCollectionStorageAuthorityFacts, ref parents: Array<Int>,
    inout unknown: Array<Int>, inout retiring: Array<Int>,
    inout non_deep: Array<Int>, inout escaping: Array<Int>,
    inout descriptor_retiring: Array<Int>
) -> Void {
    let count: Int = ArrayLength(definitions.syntax_ids);
    let pass: Int = 0;
    while pass < 2 {
        let changed: Bool = true;
        let remaining: Int = count + 1;
        while changed && remaining > 0 {
            changed = false;
            let row: Int = 0;
            while row < count {
                let source: Int = parents[row];
                if source >= 0 {
                    if SemanticAstCollectionMergeDefinitionEffectBounds(unknown, retiring, non_deep, escaping, descriptor_retiring, source, row) { changed = true; }
                    if pass == 0 && SemanticAstCollectionDefinitionStorageBorrowed(storage, row) &&
                        SemanticAstCollectionMergeDefinitionEffectBounds(unknown, retiring, non_deep, escaping, descriptor_retiring, row, source) { changed = true; }
                }
                row = row + 1;
            }
            remaining = remaining - 1;
        }
        // Unsupported Assign loses local permission, not an earlier alias's
        // known content or storage authority. An exact shallow assignment of
        // borrowed storage is a supported descriptor alias: its real effects
        // continue to propagate in both directions and keep their event site.
        if pass == 0 {
            let row: Int = definitions.local_count;
            while row < count {
                if !definitions.fresh[row] &&
                    !(SemanticAstCollectionDefinitionShallowAliasAdmitted(
                          definitions, row) &&
                      SemanticAstCollectionDefinitionStorageBorrowed(
                          storage, row)) {
                    unknown[row] = 0;
                    retiring[row] = 0;
                    non_deep[row] = 0;
                    descriptor_retiring[row] = 0;
                }
                row = row + 1;
            }
        }
        pass = pass + 1;
    }
}
