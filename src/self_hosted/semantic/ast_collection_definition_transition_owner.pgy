// Value evaluation finishes before a storage definition becomes current.
// Element provenance is the RHS fact; `own` transfers storage only.
import "ast_collection_definition_storage_authority_owner.pgy";
import "ast_collection_call_effect_fact_owner.pgy";
import "ast_collection_ownership_verdict_carrier_owner.pgy";

func SemanticAstCollectionCompleteDefinition(
    artifact: AstTreeArtifact, ref locals: SemanticAstLocalBindingFacts,
    ref surfaces: SemanticAstExpressionSurfaceFacts, ref definitions: SemanticAstCollectionDefinitionFacts,
    ref storage: SemanticAstCollectionStorageAuthorityFacts,
    slot: Int, inout current: Array<Int>, inout effects: SemanticAstCollectionCallEffectFacts,
    inout ownership: Array<Int>, inout dispositions: Array<Int>, inout origins: Array<Int>,
    inout transitions: Array<Int>, inout source_binding_ids: Array<Int>
) -> SemanticAstCollectionOwnershipVerdict {
    let definition: Int = SemanticAstCollectionDefinitionCompletedAtSlot(definitions, locals, surfaces, slot);
    if definition < 0 { return SemanticAstCollectionOwnershipVerdictOk(); }
    if definition >= ArrayLength(
            definitions.owned_result_function_syntax_ids) {
        return SemanticAstCollectionOwnershipVerdictError(
            "ast_artifact_invalid",
            SemanticError1("ast_artifact_invalid", "owner",
                "collection_owned_result_definition"),
            definitions.syntax_ids[definition], -1);
    }
    let row: Int = definitions.binding_rows[definition];
    // Current value follows every completed typed write. Freshness may restore
    // Live, but cannot select an earlier value or prove storage ownership.
    current[row] = definition;
    let owned_result_function: Int =
        definitions.owned_result_function_syntax_ids[definition];
    if owned_result_function > 0 {
        if definition >= definitions.local_count ||
            SemanticAstCollectionDefinitionStorageSource(
                storage, definitions, row, definition) <= 0 {
            return SemanticAstCollectionOwnershipVerdictError(
                "ast_artifact_invalid",
                SemanticError1("ast_artifact_invalid", "owner",
                    "collection_owned_result_activation"),
                definitions.syntax_ids[definition],
                definitions.value_nodes[definition]);
        }
        ownership[row] = SemanticAstCollectionOwnershipOwnedElements();
        dispositions[row] = SemanticAstCollectionDispositionLive();
        origins[row] = SemanticAstCollectionOriginCallResult();
        transitions[row] = SemanticAstCollectionTransitionOwned();
        source_binding_ids[row] = 0;
    } else if definition >= definitions.local_count {
        ownership[row] = definitions.ownerships[definition];
        origins[row] = definitions.origins[definition];
        transitions[row] = definitions.transitions[definition];
        source_binding_ids[row] = 0;
        if definitions.fresh[definition] { dispositions[row] = SemanticAstCollectionDispositionLive(); }
        SemanticAstCollectionSelectDefinitionEffects(effects, row, definition);
    } else if definitions.local_sources[definition] >= 0 {
        let source: Int = definitions.local_sources[definition];
        if SemanticAstCollectionDefinitionStorageBorrowed(storage, definition) {
            ownership[row] = SemanticAstCollectionOwnershipUnknown(); origins[row] = SemanticAstCollectionOriginUnknown();
            transitions[row] = SemanticAstCollectionTransitionUntracked(); source_binding_ids[row] = 0;
            return SemanticAstCollectionOwnershipVerdictOk();
        }
        SemanticAstCollectionApplyUnknownCallStateAtUse(artifact, effects, source, definitions.syntax_ids[definition], ownership, dispositions, transitions);
        if dispositions[source] == SemanticAstCollectionDispositionRetired() {
            return SemanticAstCollectionOwnershipVerdictError("move_from_released",
                SemanticError2("move_from_released", "boundary", "binding_move", "type", "Array<String>"), definitions.syntax_ids[definition], definitions.value_nodes[definition]);
        }
        if origins[source] == SemanticAstCollectionOriginEmptyLiteral() || origins[source] == SemanticAstCollectionOriginBinding() {
            return SemanticAstCollectionOwnershipVerdictError("borrow_boundary_escape",
                SemanticError2("borrow_boundary_escape", "boundary", "untracked_binding_move", "type", "Array<String>"), definitions.syntax_ids[definition], definitions.value_nodes[definition]);
        }
        ownership[row] = ownership[source];
        origins[row] = SemanticAstCollectionOriginBinding();
        source_binding_ids[row] = locals.node_ids[source];
        dispositions[source] = SemanticAstCollectionDispositionRetired();
    }
    return SemanticAstCollectionOwnershipVerdictOk();
}
