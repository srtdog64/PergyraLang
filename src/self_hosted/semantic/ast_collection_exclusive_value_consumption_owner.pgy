// Exclusive-value consumption: a use is the last use of its place when no
// later statement that runs after it reads overlapping storage. The field-read
// owner narrows the overlap of whole-value reads; the flow owner supplies
// exit scopes, write-backs, loop rebinding and inout exits.

import "ast_collection_exclusive_value_consumption_core_owner.pgy";
import "ast_collection_exclusive_value_consumption_result_owner.pgy";
