// Exclusive-value control-flow ordering and write-back admission.

import "ast_collection_aggregate_sink_consumption_owner.pgy";
import "ast_collection_call_retirement_owner.pgy";
import "ast_collection_formal_descriptor_retention_owner.pgy";
import "ast_statement_fact_owner.pgy";
import "ast_assignment_fact_owner.pgy";
import "ast_string_formal_borrow_owner.pgy";
import "ast_collection_ownership_identity_owner.pgy";
import "ast_expression_graph_call_argument_edge_owner.pgy";
import "ast_collection_storage_observation_owner.pgy";

func SemanticAstCollectionExclusiveSurfaceRanges(
    artifact: AstTreeArtifact, ref surfaces: SemanticAstExpressionSurfaceFacts,
    inout starts: HashMap<String, Int>, inout ends: HashMap<String, Int>
) -> Void {
    var broken: HashMap<String, Int> = MapNew();
    var row: Int = 0;
    var previous: Int = -1;
    while row < ArrayLength(surfaces.function_node_ids) {
        let function_id: Int = surfaces.function_node_ids[row];
        let key: String = ToString(function_id);
        var ancestor: Int = surfaces.node_ids[row];
        var remaining: Int = artifact.count;
        while ancestor >= 0 && ancestor < artifact.count && ancestor != function_id && remaining > 0 {
            if TypedAstArenaNodeKindIs(artifact.arena, ancestor, TypedAstKindDeferStmtTag()) {
                MapSet(broken, key, 1);
            }
            let parent: Option<Int> = TypedAstArenaParentId(artifact.arena, ancestor);
            ancestor = -1;
            if IsSome(parent) { ancestor = UnwrapOption(parent); }
            remaining = remaining - 1;
        }
        if function_id != previous {
            if MapHas(starts, key) { MapSet(broken, key, 1); }
            else { MapSet(starts, key, row); }
            if previous >= 0 { MapSet(ends, ToString(previous), row); }
            previous = function_id;
        }
        row = row + 1;
    }
    if previous >= 0 { MapSet(ends, ToString(previous), row); }
    let keys: Array<String> = MapKeys(broken);
    var index: Int = 0;
    while index < ArrayLength(keys) {
        MapSet(starts, keys[index], -1);
        index = index + 1;
    }
}

// The statement at `syntax_id` assigns the consumed place itself, so later
// statements read the new value.
func SemanticAstCollectionExclusiveRedefinesPlace(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts, ref assignments: SemanticAstAssignmentFacts,
    function_id: Int, syntax_id: Int, ref place: SemanticAstCollectionAggregateSinkPlace
) -> Bool {
    let assigned: Option<Int> = SemanticAstAssignmentIndexForNode(assignments, syntax_id);
    if !IsSome(assigned) || assignments.target_is_indexed[UnwrapOption(assigned)] != 0 { return false; }
    let target: Option<Int> = SemanticAstExpressionGraphRootForNode(surfaces, syntax_id, AstExpressionLaneAtom());
    if !IsSome(target) { return false; }
    let written: SemanticAstCollectionAggregateSinkPlace = SemanticAstCollectionAggregateSinkPlaceForNode(
        artifact, signatures, locals, inferred_types, surfaces, function_id, syntax_id, UnwrapOption(target));
    // Writing the place or an ancestor of it ends the old value.
    if !written.ok || written.temporary || written.key != place.key ||
        ArrayLength(written.chain) > ArrayLength(place.chain) { return false; }
    var index: Int = 0;
    while index < ArrayLength(written.chain) {
        let left: Option<String> = SemanticExpressionGraphNodeText(surfaces.expression_graph, written.chain[index]);
        let right: Option<String> = SemanticExpressionGraphNodeText(surfaces.expression_graph, place.chain[index]);
        if !IsSome(left) || !IsSome(right) || UnwrapOption(left) != UnwrapOption(right) { return false; }
        index = index + 1;
    }
    return true;
}

// No break or continue inside `block`, in its statements from `from` up to
// `before`, leaves it. A jump outside them cannot keep a path that starts at
// `from` from running `before`.
func SemanticAstCollectionExclusiveBlockJumpFree(ref artifact: AstTreeArtifact, block: Int, from: Int, before: Int) -> Bool {
    var pending: Array<Int> = [block];
    while ArrayLength(pending) > 0 {
        let node: Int = pending[ArrayLength(pending) - 1];
        ArrayPop(pending);
        if node < 0 || node >= artifact.count { return false; }
        let kind: Int = artifact.arena.kinds[node];
        if kind == TypedAstKindBreakStmtTag() || kind == TypedAstKindContinueStmtTag() {
            // Only a jump to a loop inside the block stays in it.
            var inner: Bool = false;
            var ancestor: Int = artifact.arena.parents[node];
            while ancestor >= 0 && ancestor != block && !inner {
                inner = artifact.arena.kinds[ancestor] == TypedAstKindWhileStmtTag() ||
                    artifact.arena.kinds[ancestor] == TypedAstKindForStmtTag();
                ancestor = artifact.arena.parents[ancestor];
            }
            if !inner { return false; }
        }
        var index: Int = 0;
        while index < artifact.arena.child_counts[node] {
            let slot: Int = artifact.arena.first_children[node] + index;
            if slot < 0 || slot >= ArrayLength(artifact.arena.children) { return false; }
            if node != block || (artifact.arena.children[slot] >= from && artifact.arena.children[slot] < before) {
                ArrayPush(pending, artifact.arena.children[slot]);
            }
            index = index + 1;
        }
    }
    return true;
}

// The block `block` ends in a function exit at or after its child `child`, and
// no break or continue inside it leaves it.
func SemanticAstCollectionExclusiveBlockExits(ref artifact: AstTreeArtifact, block: Int, child: Int) -> Bool {
    let count: Int = artifact.arena.child_counts[block];
    let edge: Int = artifact.arena.first_children[block] + count - 1;
    if count <= 0 || edge < 0 || edge >= ArrayLength(artifact.arena.children) { return false; }
    let terminal: Int = artifact.arena.children[edge];
    if terminal < child || terminal >= artifact.count ||
        !SemanticAstCollectionEffectSiteTerminatesFlow(artifact, terminal) { return false; }
    return SemanticAstCollectionExclusiveBlockJumpFree(artifact, block, 0, artifact.count);
}

// Every path from `definition` that goes on runs `statement`: it sits directly
// in a block around the definition that no jump leaves between them. The
// block's statements before the one holding the definition ran already.
func SemanticAstCollectionExclusiveRunsAfter(ref artifact: AstTreeArtifact, definition: Int, statement: Int) -> Bool {
    if statement <= definition || statement >= artifact.count { return false; }
    let block: Int = artifact.arena.parents[statement];
    if block < 0 || block >= artifact.count || artifact.arena.kinds[block] != TypedAstKindBlockTag() { return false; }
    var head: Int = definition;
    while head >= 0 && head < artifact.count && artifact.arena.parents[head] != block {
        head = artifact.arena.parents[head];
    }
    return head >= 0 && head < artifact.count &&
        SemanticAstCollectionExclusiveBlockJumpFree(artifact, block, head, statement);
}

// If execution continues from `origin` to `use_site`, it must first run
// `restoration`. RunsAfter owns the local branch proof. The enclosing block
// order then proves that a later reached statement cannot enter ahead of the
// restored branch. Callable, deferred and concurrent bodies are separate
// execution contexts and never inherit this proof from source order.
func SemanticAstCollectionExclusiveContinuationRestoredBeforeUse(
    ref artifact: AstTreeArtifact,
    origin: Int, restoration: Int, use_site: Int
) -> Bool {
    if origin < 0 || origin >= artifact.count ||
        restoration <= origin || restoration >= artifact.count ||
        use_site <= restoration || use_site >= artifact.count ||
        !SemanticAstCollectionExclusiveRunsAfter(
            artifact, origin, restoration) {
        return false;
    }
    var use_head: Int = use_site;
    var use_remaining: Int = artifact.count;
    while use_head >= 0 && use_head < artifact.count &&
        use_remaining > 0 {
        let kind: Int = artifact.arena.kinds[use_head];
        if kind == TypedAstKindDeferStmtTag() ||
            kind == TypedAstKindAsyncBlockTag() ||
            kind == TypedAstKindParallelBlockTag() ||
            TypedAstKindIsCallableDecl(kind) ||
            kind == TypedAstKindOverrideFuncTag() {
            return false;
        }
        let block: Int = artifact.arena.parents[use_head];
        if block >= 0 && block < artifact.count &&
            artifact.arena.kinds[block] == TypedAstKindBlockTag() {
            var origin_head: Int = origin;
            var origin_remaining: Int = artifact.count;
            while origin_head >= 0 && origin_head < artifact.count &&
                artifact.arena.parents[origin_head] != block &&
                origin_remaining > 0 {
                let origin_kind: Int = artifact.arena.kinds[origin_head];
                if origin_kind == TypedAstKindDeferStmtTag() ||
                    origin_kind == TypedAstKindAsyncBlockTag() ||
                    origin_kind == TypedAstKindParallelBlockTag() ||
                    TypedAstKindIsCallableDecl(origin_kind) ||
                    origin_kind == TypedAstKindOverrideFuncTag() {
                    // This candidate block is inside another branch or
                    // execution context. It is not a common block; keep
                    // climbing the use side instead of treating the failed
                    // candidate as evidence about the final common block.
                    origin_head = -1;
                    origin_remaining = 0;
                } else {
                    origin_head = artifact.arena.parents[origin_head];
                    origin_remaining = origin_remaining - 1;
                }
            }
            if origin_remaining > 0 &&
                origin_head >= 0 && origin_head < artifact.count &&
                artifact.arena.parents[origin_head] == block &&
                origin_head != use_head {
                var origin_index: Int = -1;
                var use_index: Int = -1;
                var child_index: Int = 0;
                while child_index < artifact.arena.child_counts[block] {
                    let slot: Int = artifact.arena.first_children[block] +
                        child_index;
                    if slot < 0 || slot >= ArrayLength(artifact.arena.children) {
                        return false;
                    }
                    let child: Int = artifact.arena.children[slot];
                    if child == origin_head { origin_index = child_index; }
                    if child == use_head { use_index = child_index; }
                    child_index = child_index + 1;
                }
                if origin_index >= 0 && use_index > origin_index {
                    return true;
                }
            }
        }
        use_head = artifact.arena.parents[use_head];
        use_remaining = use_remaining - 1;
    }
    return false;
}

// The last node of the `if` at `statement` when each of its branches, every
// `else if` and a final `else`, writes the place: directly in the branch block
// with no jump leaving the block before, or by ending in a function exit.
// Writes at `settle_from` or later settle the place. -1 otherwise.
func SemanticAstCollectionExclusiveBranchesWrite(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts, ref assignments: SemanticAstAssignmentFacts,
    function_id: Int, statement: Int, ref place: SemanticAstCollectionAggregateSinkPlace, settle_from: Int
) -> Int {
    if !TypedAstArenaNodeKindIs(artifact.arena, statement, TypedAstKindIfStmtTag()) { return -1; }
    var blocks: Array<Int> = [];
    var branch: Int = statement;
    while branch >= 0 {
        let then_node: Option<Int> = TypedAstArenaChildAt(artifact.arena, branch, 0);
        let else_node: Option<Int> = TypedAstArenaChildAt(artifact.arena, branch, 1);
        if !IsSome(then_node) || !IsSome(else_node) { return -1; }
        let then_block: Option<Int> = TypedAstArenaChildAt(artifact.arena, UnwrapOption(then_node), 0);
        let target: Option<Int> = TypedAstArenaChildAt(artifact.arena, UnwrapOption(else_node), 0);
        if !IsSome(then_block) || !IsSome(target) { return -1; }
        ArrayPush(blocks, UnwrapOption(then_block));
        branch = -1;
        if TypedAstArenaNodeKindIs(artifact.arena, UnwrapOption(target), TypedAstKindIfStmtTag()) {
            branch = UnwrapOption(target);
        } else { ArrayPush(blocks, UnwrapOption(target)); }
    }
    var index: Int = 0;
    while index < ArrayLength(blocks) {
        let block: Int = blocks[index];
        if !TypedAstArenaNodeKindIs(artifact.arena, block, TypedAstKindBlockTag()) { return -1; }
        let count: Int = artifact.arena.child_counts[block];
        var written: Bool = false;
        var child_index: Int = 0;
        while child_index < count && !written {
            let child: Int = artifact.arena.children[artifact.arena.first_children[block] + child_index];
            written = ((child >= settle_from && SemanticAstCollectionExclusiveRedefinesPlace(artifact, signatures,
                    locals, inferred_types, surfaces, assignments, function_id, child, place)) ||
                (child_index == count - 1 && SemanticAstCollectionEffectSiteTerminatesFlow(artifact, child))) &&
                SemanticAstCollectionExclusiveBlockJumpFree(artifact, block, 0, child);
            child_index = child_index + 1;
        }
        if !written { return -1; }
        index = index + 1;
    }
    var last: Int = blocks[ArrayLength(blocks) - 1];
    while artifact.arena.child_counts[last] > 0 {
        last = artifact.arena.children[artifact.arena.first_children[last] + artifact.arena.child_counts[last] - 1];
    }
    return last;
}

// Every loop that repeats `use_site` but keeps the binding declared at
// `origin` also holds the rebinding at `rebind`, so each iteration rebinds
// before the next one reads.
func SemanticAstCollectionExclusiveRebindsEachIteration(
    ref artifact: AstTreeArtifact, use_site: Int, rebind: Int, origin: Int
) -> Bool {
    var ancestor: Int = use_site;
    var remaining: Int = artifact.count;
    while ancestor >= 0 && remaining > 0 {
        if (TypedAstArenaNodeKindIs(artifact.arena, ancestor, TypedAstKindWhileStmtTag()) ||
            TypedAstArenaNodeKindIs(artifact.arena, ancestor, TypedAstKindForStmtTag())) &&
            !SemanticAstCollectionNodeEnclosedBy(artifact, origin, ancestor) &&
            !SemanticAstCollectionNodeEnclosedBy(artifact, rebind, ancestor) { return false; }
        if TypedAstArenaNodeKindIs(artifact.arena, ancestor, TypedAstKindDeferStmtTag()) { return false; }
        let parent: Option<Int> = TypedAstArenaParentId(artifact.arena, ancestor);
        if !IsSome(parent) { return true; }
        ancestor = UnwrapOption(parent);
        remaining = remaining - 1;
    }
    return false;
}

// A write in `writes` runs on every path to the exit at `exit_site`: it sits
// earlier, directly in a jump-free block around the exit.
func SemanticAstCollectionExclusiveWriteCoversExit(
    ref artifact: AstTreeArtifact, ref writes: Array<Int>, exit_site: Int
) -> Bool {
    var index: Int = 0;
    while index < ArrayLength(writes) {
        let write: Int = writes[index];
        var block: Int = -1;
        if write >= 0 && write < artifact.count { block = artifact.arena.parents[write]; }
        if write < exit_site && block >= 0 && block < artifact.count &&
            artifact.arena.kinds[block] == TypedAstKindBlockTag() &&
            SemanticAstCollectionNodeEnclosedBy(artifact, exit_site, block) &&
            SemanticAstCollectionExclusiveBlockJumpFree(artifact, block, 0, artifact.count) { return true; }
        index = index + 1;
    }
    return false;
}

