// Copy landing consumers use the admitted source/destination field pair.
import "ast_collection_exclusive_value_consumption_owner.pgy";


func SemanticAstCollectionExclusiveSinkArgumentConsumed(
    artifact: AstTreeArtifact, ref exit_facts: SemanticAstCollectionExclusiveExitFacts, ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts, ref assignments: SemanticAstAssignmentFacts,
    surface_starts: HashMap<String, Int>, surface_ends: HashMap<String, Int>,
    field_reads: HashMap<String, Int>, copies: HashMap<String, Int>,
    inout consumed: HashMap<String, Int>, function_id: Int, syntax_id: Int, node: Int,
    ref grown: Array<String>, ref ignored_sources: Array<Int>
) -> Bool {
    if !exit_facts.ok { return false; }
    let place: SemanticAstCollectionAggregateSinkPlace = SemanticAstCollectionAggregateSinkPlaceForNode(
        artifact, signatures, locals, inferred_types, surfaces, function_id, syntax_id, node);
    if !place.ok || place.temporary { return false; }
    let signature: String = SemanticAstCollectionExclusiveCopySignature(copies, constructors,
        SemanticAstCollectionExclusivePlaceRoot(locals, place));
    if signature == "" { return false; }
    let key: String = Concat("sink:", Concat(ToString(syntax_id), Concat(":", ToString(node))));
    let index: Int = 0;
    while index < ArrayLength(grown) { key = Concat(key, Concat(",", grown[index])); index = index + 1; }
    index = 0;
    while index < ArrayLength(ignored_sources) {
        key = Concat(key, Concat(";", ToString(ignored_sources[index])));
        index = index + 1;
    }
    key = Concat(key, Concat("@", signature));
    if MapHas(consumed, key) { return MapGet(consumed, key) == 1; }
    let recovery_only: Bool = false;
    let result: Bool = SemanticAstCollectionExclusivePlaceConsumed(artifact, exit_facts, signatures, constructors, locals,
        inferred_types, surfaces, assignments, surface_starts, surface_ends, field_reads, copies, function_id,
        syntax_id, node, grown, ignored_sources, recovery_only);
    if !result && recovery_only { MapSet(consumed, Concat("recovery:", key), 1); }
    if result { MapSet(consumed, key, 1); } else { MapSet(consumed, key, 2); }
    return result;
}

// Ignore a source only when every admitted landing from it is outside growth.
func SemanticAstCollectionExclusiveUngrownSources(
    ref constructors: SemanticAstNominalConstructorFacts, copies: HashMap<String, Int>, root: Int, ref grown: Array<String>
) -> Array<Int> {
    let ignored: Array<Int> = [];
    let prefix: String = Concat("into:", ToString(root));
    let count: Int = SemanticAstCollectionExclusiveCopyCount(copies, prefix);
    let index: Int = 0;
    while index < count {
        let key: String = Concat(prefix, Concat(":", ToString(index)));
        if !MapHas(copies, key) { return []; }
        let edge: SemanticAstCollectionExclusiveCopyEdge = SemanticAstCollectionExclusiveCopyEdgeAt(copies, constructors, MapGet(copies, key));
        if !edge.ok || edge.holder != root { return []; }
        let outside: Bool = true;
        let row: Int = 0;
        while row < count && outside {
            let other_key: String = Concat(prefix, Concat(":", ToString(row)));
            if !MapHas(copies, other_key) { return []; }
            let other: SemanticAstCollectionExclusiveCopyEdge = SemanticAstCollectionExclusiveCopyEdgeAt(copies, constructors, MapGet(copies, other_key));
            if !other.ok || other.holder != root { return []; }
            if other.root == edge.root && SemanticAstCollectionExclusiveCopyFieldGrown(constructors, other.destination_field, grown) {
                outside = false;
            }
            row = row + 1;
        }
        if outside { ArrayPush(ignored, edge.root); }
        index = index + 1;
    }
    return ignored;
}
