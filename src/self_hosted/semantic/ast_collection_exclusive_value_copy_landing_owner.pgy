// Exclusive-value copy landings: the first fields of a root its copies
// reach, and the last-use proofs that read only the copies a growth can
// reach (a sink argument, or a place whose other readers are its copies).
import "ast_collection_exclusive_value_consumption_owner.pgy";

// Where the copies of `root` reach it: first fields of holders' copies of a
// root field, a ref source's copies at the root's shared fields, and a formal
// source's copies at the fields its dependency paths land at. Not `ok` when a
// copy is whole or comes from a local.
struct SemanticAstCollectionExclusiveCopyLanding {
    ok: Bool;
    fields: Array<String>;
    sources: Array<Int>;
}

func SemanticAstCollectionExclusiveCopyLandingFor(
    ref signatures: SemanticAstFunctionSignatureFacts, ref constructors: SemanticAstNominalConstructorFacts,
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>, copies: HashMap<String, Int>,
    shared_locals: HashMap<String, Int>, ref dep_locals: Array<Int>, ref dep_formals: Array<Int>,
    ref dep_paths: Array<Int>, ref paths: Array<String>, function_id: Int, root: Int
) -> SemanticAstCollectionExclusiveCopyLanding {
    let fields: Array<String> = [];
    let sources: Array<Int> = [];
    let root_fields: Array<String> = SemanticAstCollectionExclusiveTypeFields(constructors,
        SemanticAstCollectionExclusiveRootType(signatures, locals, inferred_types, function_id, root));
    let from: String = Concat("from:", ToString(root));
    let index: Int = 0;
    while index < SemanticAstCollectionExclusiveCopyCount(copies, from) {
        let edge: String = ToString(MapGet(copies, Concat(from, Concat(":", ToString(index)))));
        if MapHas(copies, Concat("edge_whole:", edge)) {
            return SemanticAstCollectionExclusiveCopyLanding(false, fields, sources);
        }
        let field_index: Int = 0;
        while field_index < ArrayLength(root_fields) {
            if MapHas(copies, Concat("edge_field:", Concat(edge, Concat(":", root_fields[field_index])))) {
                ArrayPush(fields, root_fields[field_index]);
            }
            field_index = field_index + 1;
        }
        index = index + 1;
    }
    let into: String = Concat("into:", ToString(root));
    index = 0;
    while index < SemanticAstCollectionExclusiveCopyCount(copies, into) {
        let source: Int = MapGet(copies, Concat("edge_root:", ToString(MapGet(copies,
            Concat(into, Concat(":", ToString(index)))))));
        let mode: Int = SemanticAstCollectionExclusiveRootMode(signatures, function_id, source);
        let landed: Int = ArrayLength(fields);
        if mode == 3 {
            let field_index: Int = 0;
            while field_index < ArrayLength(root_fields) {
                if MapHas(shared_locals, Concat(ToString(root), Concat(".", root_fields[field_index]))) {
                    ArrayPush(fields, root_fields[field_index]);
                }
                field_index = field_index + 1;
            }
        } else if mode >= 0 {
            let row: Int = 0;
            while row < ArrayLength(dep_locals) {
                if dep_locals[row] == root && dep_formals[row] == source {
                    if dep_paths[row] < 0 || paths[2 * dep_paths[row]] == "" {
                        return SemanticAstCollectionExclusiveCopyLanding(false, fields, sources);
                    }
                    ArrayPush(fields, paths[2 * dep_paths[row]]);
                }
                row = row + 1;
            }
        }
        if ArrayLength(fields) == landed { return SemanticAstCollectionExclusiveCopyLanding(false, fields, sources); }
        ArrayPush(sources, source);
        index = index + 1;
    }
    return SemanticAstCollectionExclusiveCopyLanding(ArrayLength(fields) > 0, fields, sources);
}

// The last-use proof of a sink argument that grows only the first fields
// `grown`: a copy outside them is not a reader of grown storage.
func SemanticAstCollectionExclusiveSinkArgumentConsumed(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts, ref assignments: SemanticAstAssignmentFacts,
    surface_starts: HashMap<String, Int>, surface_ends: HashMap<String, Int>,
    field_reads: HashMap<String, Int>, copies: HashMap<String, Int>,
    inout consumed: HashMap<String, Int>, function_id: Int, syntax_id: Int, node: Int,
    ref grown: Array<String>, ref ignored_sources: Array<Int>
) -> Bool {
    let place: SemanticAstCollectionAggregateSinkPlace = SemanticAstCollectionAggregateSinkPlaceForNode(
        artifact, signatures, locals, inferred_types, surfaces, function_id, syntax_id, node);
    if !place.ok { return false; }
    let root: Int = 0;
    if !place.temporary { root = SemanticAstCollectionExclusivePlaceRoot(locals, place); }
    let signature: String = SemanticAstCollectionExclusiveCopySignature(copies, root);
    let key: String = Concat("sink:", Concat(ToString(syntax_id), Concat(":", ToString(node))));
    let index: Int = 0;
    while index < ArrayLength(grown) { key = Concat(key, Concat(",", grown[index])); index = index + 1; }
    index = 0;
    while index < ArrayLength(ignored_sources) {
        key = Concat(key, Concat(";", ToString(ignored_sources[index])));
        index = index + 1;
    }
    key = Concat(key, Concat("@", signature));
    if MapHas(consumed, key) { return MapGet(consumed, key) == 1; }
    let recovery_only: Bool = false;
    let result: Bool = SemanticAstCollectionExclusivePlaceConsumed(artifact, signatures, constructors, locals,
        inferred_types, surfaces, assignments, surface_starts, surface_ends, field_reads, copies, function_id,
        syntax_id, node, grown, ignored_sources, recovery_only);
    if !result && recovery_only { MapSet(consumed, Concat("recovery:", key), 1); }
    if result { MapSet(consumed, key, 1); } else { MapSet(consumed, key, 2); }
    return result;
}

// The formal sources of copies `root` holds whose every recorded path lands
// at a first field of `root` outside `grown`.
func SemanticAstCollectionExclusiveUngrownSources(
    ref signatures: SemanticAstFunctionSignatureFacts, ref locals: SemanticAstLocalBindingFacts,
    copies: HashMap<String, Int>, shared_locals: HashMap<String, Int>, ref dep_locals: Array<Int>,
    ref dep_formals: Array<Int>, ref dep_paths: Array<Int>, ref paths: Array<String>, function_id: Int, root: Int,
    ref grown: Array<String>
) -> Array<Int> {
    // A ref source classifies shared, so its copies land at shared fields.
    let shared_outside: Bool = !MapHas(shared_locals, ToString(root));
    let grown_index: Int = 0;
    while grown_index < ArrayLength(grown) {
        if MapHas(shared_locals, Concat(ToString(root), Concat(".", grown[grown_index]))) { shared_outside = false; }
        grown_index = grown_index + 1;
    }
    let ignored: Array<Int> = [];
    let into: String = Concat("into:", ToString(root));
    let index: Int = 0;
    while index < SemanticAstCollectionExclusiveCopyCount(copies, into) {
        let source: Int = MapGet(copies, Concat("edge_root:", ToString(MapGet(copies,
            Concat(into, Concat(":", ToString(index)))))));
        let mode: Int = SemanticAstCollectionExclusiveRootMode(signatures, function_id, source);
        let lands: Bool = mode == 3 && shared_outside;
        let outside: Bool = mode >= 0;
        let row: Int = 0;
        while row < ArrayLength(dep_locals) && outside && mode != 3 {
            if dep_locals[row] == root && dep_formals[row] == source {
                lands = true;
                if dep_paths[row] < 0 || paths[2 * dep_paths[row]] == "" { outside = false; }
                let field_index: Int = 0;
                while outside && field_index < ArrayLength(grown) {
                    if dep_paths[row] >= 0 && paths[2 * dep_paths[row]] == grown[field_index] { outside = false; }
                    field_index = field_index + 1;
                }
            }
            row = row + 1;
        }
        if lands && outside { ArrayPush(ignored, source); }
        index = index + 1;
    }
    return ignored;
}

// The first fields of the holder a copy at `node` lands in, none when
// unknown: the field of the constructor that is the whole value of the
// definition at `syntax_id` whose argument holds the node, or the result
// fields the callee's returns carry that argument's formal into.
func SemanticAstCollectionExclusiveCopyLandingFields(
    ref signatures: SemanticAstFunctionSignatureFacts, ref constructors: SemanticAstNominalConstructorFacts,
    ref surfaces: SemanticAstExpressionSurfaceFacts, carrying: HashMap<String, Int>, ref paths: Array<String>,
    syntax_id: Int, node: Int
) -> Array<String> {
    let fields: Array<String> = [];
    let value: Option<Int> = SemanticAstExpressionGraphRootForNode(surfaces, syntax_id, AstExpressionLaneValue());
    if !IsSome(value) { return fields; }
    let call: SemanticCallSpineView = SemanticCallSpineViewFromGraph(surfaces.expression_graph, UnwrapOption(value));
    if !call.ok { return fields; }
    let target: Option<Int> = SemanticExpressionGraphCallTargetSyntaxId(surfaces.expression_graph, call.call_node);
    let name: Option<String> = SemanticExpressionGraphCallTargetName(surfaces.expression_graph, call.call_node);
    if !IsSome(target) || !IsSome(name) { return fields; }
    let argument: Int = -1;
    let index: Int = 0;
    while index < ArrayLength(call.argument_nodes) {
        let start: Option<Int> = SemanticExpressionGraphSubtreeStart(surfaces.expression_graph,
            call.argument_nodes[index]);
        if IsSome(start) && node >= UnwrapOption(start) && node <= call.argument_nodes[index] { argument = index; }
        index = index + 1;
    }
    if argument < 0 { return fields; }
    if UnwrapOption(target) != 0 {
        let formal: SemanticAstCollectionArgumentFormalTarget = SemanticAstCollectionArgumentFormalTargetForArgument(
            signatures, surfaces.expression_graph, call.call_node, argument);
        if !formal.ok { return fields; }
        let formal_key: String = ToString(formal.syntax_id);
        let carried: Int = 0;
        while carried < SemanticAstCollectionExclusiveCopyCount(carrying, Concat("cn:", formal_key)) {
            let path: Int = MapGet(carrying, Concat("ci:", Concat(formal_key, Concat(":", ToString(carried)))));
            // A path to the whole result lands anywhere.
            if paths[2 * path] == "" { let anywhere: Array<String> = []; return anywhere; }
            ArrayPush(fields, Concat("", paths[2 * path]));
            carried = carried + 1;
        }
        return fields;
    }
    let type_name: String = UnwrapOption(name);
    let callee_text: Option<String> = SemanticExpressionGraphNodeText(surfaces.expression_graph, call.callee_node);
    if type_name == "" && IsSome(callee_text) { type_name = UnwrapOption(callee_text); }
    let constructor: Option<Int> = SemanticAstNominalConstructorIndexForName(constructors, type_name);
    if !IsSome(constructor) ||
        constructors.param_counts[UnwrapOption(constructor)] != ArrayLength(call.argument_nodes) { return fields; }
    ArrayPush(fields, Concat("", constructors.field_names[constructors.param_starts[UnwrapOption(constructor)] + argument]));
    return fields;
}
