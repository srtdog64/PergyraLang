// Exclusive-value copies: a definition that copies a place inside a call or
// constructor without consuming it makes its destination a second holder of
// that storage. The holder keeps the source's dependencies; instead of
// sharing the source forever, each later use of either side is a read of the
// other. A holder that leaves the tracked definitions (a push, a statement
// call, a match) falls back to sharing its source.
//
// Edge rows live in one map, keyed explicitly:
// - "edges" -> count; "edge_root:k", "edge_holder:k" -> binding ids;
//   "edge_whole:k" or "edge_field:k:<field>" -> 1;
// - "edge_landing:k:<field>" -> 1 for each holder first field the copy
//   lands in, or "edge_landing_any:k" -> 1 when one landing is unknown;
//   "landings" and "landings:<holder>" count the landings recorded;
// - "from:<root>" and "from:<root>:i" -> edges out of a source binding;
// - "into:<holder>" and "into:<holder>:i" -> edges into a holder binding;
// - "pair:<root>:<field>:<holder>" -> edge + 1 (one row per edge);
// - "contained:<holder>" -> 1 contained, 2 escaping (memoized);
// - "s_n:<root>" and "s_i:<root>:i" -> statements of copies of a root the
//   fixed point could not follow; "d:<binding>" -> 1 when a definition of the
//   binding itself names shared storage.
import "ast_collection_exclusive_value_flow_owner.pgy";
import "array_type_shape_owner.pgy";

// The binding a place is rooted at: a local declaration or a formal.
func SemanticAstCollectionExclusivePlaceRoot(
    ref locals: SemanticAstLocalBindingFacts, ref place: SemanticAstCollectionAggregateSinkPlace
) -> Int {
    if place.key >= 0 { return locals.node_ids[place.key]; }
    return 0 - place.key;
}

func SemanticAstCollectionExclusiveCopyCount(copies: HashMap<String, Int>, key: String) -> Int {
    if !MapHas(copies, key) { return 0; }
    return MapGet(copies, key);
}

// One edge from `root` (or its first field `field`) into `holder`, landing
// in the holder's first field `landing` ("" when unknown). Returns whether
// the edge is new; a known edge still records the landing.
func SemanticAstCollectionExclusiveRecordCopyEdge(
    inout copies: HashMap<String, Int>, root: Int, field: String, holder: Int, landing: String
) -> Bool {
    let pair: String = Concat("pair:", Concat(ToString(root), Concat(":", Concat(field,
        Concat(":", ToString(holder))))));
    if root == holder { return false; }
    let fresh: Bool = !MapHas(copies, pair);
    let edge: Int = SemanticAstCollectionExclusiveCopyCount(copies, "edges");
    if !fresh { edge = MapGet(copies, pair) - 1; }
    let key: String = ToString(edge);
    let landing_key: String = Concat("edge_landing_any:", key);
    if landing != "" { landing_key = Concat("edge_landing:", Concat(key, Concat(":", landing))); }
    if !MapHas(copies, landing_key) {
        MapSet(copies, landing_key, 1);
        MapSet(copies, "landings", SemanticAstCollectionExclusiveCopyCount(copies, "landings") + 1);
        let holder_landings: String = Concat("landings:", ToString(holder));
        MapSet(copies, holder_landings, SemanticAstCollectionExclusiveCopyCount(copies, holder_landings) + 1);
    }
    if !fresh { return false; }
    MapSet(copies, pair, edge + 1);
    MapSet(copies, "edges", edge + 1);
    MapSet(copies, Concat("edge_root:", key), root);
    MapSet(copies, Concat("edge_holder:", key), holder);
    if field == "" { MapSet(copies, Concat("edge_whole:", key), 1); }
    else { MapSet(copies, Concat("edge_field:", Concat(key, Concat(":", field))), 1); }
    let from: String = Concat("from:", ToString(root));
    let out: Int = SemanticAstCollectionExclusiveCopyCount(copies, from);
    MapSet(copies, Concat(from, Concat(":", ToString(out))), edge);
    MapSet(copies, from, out + 1);
    let into: String = Concat("into:", ToString(holder));
    let inward: Int = SemanticAstCollectionExclusiveCopyCount(copies, into);
    MapSet(copies, Concat(into, Concat(":", ToString(inward))), edge);
    MapSet(copies, into, inward + 1);
    return true;
}

// The copy edges a last-use proof of `root` reads: its holders, the sources
// it holds, and the other holders of those sources. Edges are only added, so
// the counts change exactly when that set does.
func SemanticAstCollectionExclusiveCopySignature(copies: HashMap<String, Int>, root: Int) -> String {
    let into: String = Concat("into:", ToString(root));
    let count: Int = SemanticAstCollectionExclusiveCopyCount(copies, into);
    let siblings: Int = 0;
    let index: Int = 0;
    while index < count {
        let edge: Int = MapGet(copies, Concat(into, Concat(":", ToString(index))));
        siblings = siblings + SemanticAstCollectionExclusiveCopyCount(copies,
            Concat("from:", ToString(MapGet(copies, Concat("edge_root:", ToString(edge))))));
        index = index + 1;
    }
    return Concat(ToString(SemanticAstCollectionExclusiveCopyCount(copies, Concat("from:", ToString(root)))),
        Concat(",", Concat(ToString(count), Concat(",", Concat(ToString(siblings), Concat(",",
            ToString(SemanticAstCollectionExclusiveCopyCount(copies, Concat("landings:", ToString(root))))))))));
}

// The edge copies the whole source or one of the `grown` first fields (any
// field when `grown` is empty).
func SemanticAstCollectionExclusiveCopyEdgeGrown(
    copies: HashMap<String, Int>, edge: Int, ref grown: Array<String>
) -> Bool {
    let key: String = ToString(edge);
    if ArrayLength(grown) == 0 || MapHas(copies, Concat("edge_whole:", key)) { return true; }
    let index: Int = 0;
    while index < ArrayLength(grown) {
        if MapHas(copies, Concat("edge_field:", Concat(key, Concat(":", grown[index])))) { return true; }
        index = index + 1;
    }
    return false;
}

// The edge's field, or "" for a whole-value copy.
func SemanticAstCollectionExclusiveCopyEdgeField(
    copies: HashMap<String, Int>, ref surfaces: SemanticAstExpressionSurfaceFacts,
    edge: Int, ref chain: Array<Int>
) -> Bool {
    let key: String = ToString(edge);
    if MapHas(copies, Concat("edge_whole:", key)) || ArrayLength(chain) == 0 { return true; }
    let field: Option<String> = SemanticExpressionGraphNodeText(surfaces.expression_graph, chain[0]);
    return !IsSome(field) || MapHas(copies, Concat("edge_field:", Concat(key, Concat(":", UnwrapOption(field)))));
}

// The edge's copy lands where the place `chain` of its holder names, within
// the first fields `grown` (any field when empty): one landing is unknown, or
// it is the chain's first field, or for the whole holder one of `grown`.
func SemanticAstCollectionExclusiveCopyEdgeLands(
    copies: HashMap<String, Int>, ref surfaces: SemanticAstExpressionSurfaceFacts,
    edge: Int, ref chain: Array<Int>, ref grown: Array<String>
) -> Bool {
    let key: String = ToString(edge);
    if MapHas(copies, Concat("edge_landing_any:", key)) { return true; }
    if ArrayLength(chain) > 0 {
        let field: Option<String> = SemanticExpressionGraphNodeText(surfaces.expression_graph, chain[0]);
        return !IsSome(field) || MapHas(copies, Concat("edge_landing:", Concat(key, Concat(":", UnwrapOption(field)))));
    }
    if ArrayLength(grown) == 0 { return true; }
    let index: Int = 0;
    while index < ArrayLength(grown) {
        if MapHas(copies, Concat("edge_landing:", Concat(key, Concat(":", grown[index])))) { return true; }
        index = index + 1;
    }
    return false;
}

// The fixed point follows a copy of `root` (at the first step of `chain`)
// into `holder`.
func SemanticAstCollectionExclusiveCopyHeld(
    copies: HashMap<String, Int>, ref surfaces: SemanticAstExpressionSurfaceFacts,
    root: Int, ref chain: Array<Int>, holder: Int
) -> Bool {
    let prefix: String = Concat("pair:", Concat(ToString(root), ":"));
    let suffix: String = Concat(":", ToString(holder));
    if MapHas(copies, Concat(prefix, suffix)) { return true; }
    if ArrayLength(chain) == 0 { return false; }
    let field: Option<String> = SemanticExpressionGraphNodeText(surfaces.expression_graph, chain[0]);
    return IsSome(field) && MapHas(copies, Concat(prefix, Concat(UnwrapOption(field), suffix)));
}

// A holder moving into `holder` carries every edge it holds, widened to a
// whole-value copy of each source. A move of its first field `field` ("" for
// the whole holder) carries only the edges landing there.
func SemanticAstCollectionExclusivePropagateCopies(
    inout copies: HashMap<String, Int>, from_holder: Int, holder: Int, field: String
) -> Bool {
    let changed: Bool = false;
    let into: String = Concat("into:", ToString(from_holder));
    let count: Int = SemanticAstCollectionExclusiveCopyCount(copies, into);
    let index: Int = 0;
    while index < count {
        let edge: String = ToString(MapGet(copies, Concat(into, Concat(":", ToString(index)))));
        let root: Int = MapGet(copies, Concat("edge_root:", edge));
        let carried: Bool = field == "" || MapHas(copies, Concat("edge_landing_any:", edge)) ||
            MapHas(copies, Concat("edge_landing:", Concat(edge, Concat(":", field))));
        if carried && SemanticAstCollectionExclusiveRecordCopyEdge(copies, root, "", holder, "") { changed = true; }
        index = index + 1;
    }
    return changed;
}

// Every use of `holder` stays where the fixed point sees it: reads,
// conditions, logs, returns, rebinding, and the values of definitions.
func SemanticAstCollectionExclusiveHolderContained(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts, first_surface: Int, end_surface: Int,
    function_id: Int, holder: Int
) -> Bool {
    // An in-place write of a scalar or text element neither retires nor
    // shares the holder's buffer.
    let scalar_elements: Bool = false;
    let holder_row: Option<Int> = SemanticAstLocalBindingIndexForNode(locals, holder);
    if IsSome(holder_row) && UnwrapOption(holder_row) < ArrayLength(inferred_types) {
        let element: Option<String> = SemanticArrayElementType(inferred_types[UnwrapOption(holder_row)]);
        scalar_elements = IsSome(element) && (UnwrapOption(element) == "String" || UnwrapOption(element) == "Int" ||
            UnwrapOption(element) == "Bool" || UnwrapOption(element) == "Long" || UnwrapOption(element) == "Float" ||
            UnwrapOption(element) == "Double" || UnwrapOption(element) == "Char");
    }
    let surface: Int = first_surface;
    while surface < end_surface {
        let statement: Int = surfaces.node_ids[surface];
        let defines: Bool = TypedAstArenaNodeKindIs(artifact.arena, statement, TypedAstKindLetStmtTag()) ||
            TypedAstArenaNodeKindIs(artifact.arena, statement, TypedAstKindAssignStmtTag()) ||
            TypedAstArenaNodeKindIs(artifact.arena, statement, TypedAstKindValueReturnStmtTag());
        let observes: Bool = TypedAstArenaNodeKindIs(artifact.arena, statement, TypedAstKindIfStmtTag()) ||
            TypedAstArenaNodeKindIs(artifact.arena, statement, TypedAstKindWhileStmtTag()) ||
            TypedAstArenaNodeKindIs(artifact.arena, statement, TypedAstKindLogStmtTag());
        let lane: Int = 0;
        while lane < 3 {
            let slot: Int = surface * 3 + lane;
            if slot < ArrayLength(surfaces.expression_graph.has_roots) && surfaces.expression_graph.has_roots[slot] {
                let root: Int = surfaces.expression_graph.roots[slot];
                let start: Option<Int> = SemanticExpressionGraphSubtreeStart(surfaces.expression_graph, root);
                let node: Int = root + 1;
                if IsSome(start) { node = UnwrapOption(start); }
                while node <= root {
                    if surfaces.expression_graph.arena.topology.node_kinds[node] == AstExpressionNodeLeaf() &&
                        !SemanticAstCollectionExclusiveMemberName(surfaces, node, root) {
                        let place: SemanticAstCollectionAggregateSinkPlace = SemanticAstCollectionAggregateSinkPlaceForNode(
                            artifact, signatures, locals, inferred_types, surfaces, function_id, statement, node);
                        let consumer: Int = SemanticAstBorrowedTextConsumer(surfaces.expression_graph, node, root);
                        let set_edge: SemanticCallArgumentEdgeView = SemanticCallArgumentEdgeFromGraph(
                            surfaces.expression_graph, consumer);
                        let written: Bool = scalar_elements && consumer >= 0 && set_edge.ok && set_edge.ordinal == 0 &&
                            set_edge.argument_node == node &&
                            SemanticAstCollectionOwnershipBuiltinCall(surfaces.expression_graph, set_edge.call_node, "ArraySet");
                        // An ArraySet statement names its target as the atom lane root.
                        if scalar_elements && consumer < 0 && lane == AstExpressionLaneAtom() && node == root &&
                            TypedAstArenaNodeKindIs(artifact.arena, statement, TypedAstKindArraySetStmtTag()) {
                            written = true;
                        }
                        // So does a read of one scalar or text element.
                        let indexed_base: Option<Int> = SemanticExpressionGraphLeftChild(surfaces.expression_graph, consumer);
                        if scalar_elements && consumer >= 0 && IsSome(indexed_base) && UnwrapOption(indexed_base) == node &&
                            surfaces.expression_graph.arena.topology.node_kinds[consumer] == AstExpressionNodeIndex() {
                            written = true;
                        }
                        if place.ok && !place.temporary &&
                            SemanticAstCollectionExclusivePlaceRoot(locals, place) == holder && !defines && !observes &&
                            !written && !SemanticAstCollectionExclusiveFamilyRead(artifact, surfaces, statement, lane, root,
                                node, false) {
                            return false;
                        }
                    }
                    node = node + 1;
                }
            }
            lane = lane + 1;
        }
        surface = surface + 1;
    }
    return true;
}

// No statement from `syntax_id` on in its exit scope uses `binding`, except
// a later return before the consumed family is first used.
func SemanticAstCollectionExclusiveBindingUnreadAfter(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts, first_surface: Int, end_surface: Int,
    function_id: Int, syntax_id: Int, scoped: Bool, scope: Int, ref uses: Array<Int>, early_returns: Bool,
    binding: Int
) -> Bool {
    // A whole write of the binding that every path runs gives it a new
    // value; its target is no read.
    let rebound: Int = -1;
    let surface: Int = first_surface;
    while surface < end_surface {
        let statement: Int = surfaces.node_ids[surface];
        // A statement before the use that a loop around both runs again, while
        // the binding stays declared outside it, also runs after the use.
        let carried: Bool = statement < syntax_id &&
            SemanticAstCollectionExclusiveLoopCarries(artifact, binding, syntax_id, statement);
        let rewrites: Bool = (carried || (statement >= syntax_id && (rebound < 0 || statement <= rebound))) &&
            SemanticAstCollectionExclusiveRebindsBinding(artifact, signatures, locals, inferred_types, surfaces,
                function_id, statement, binding);
        if rewrites && !carried &&
            (statement == syntax_id || SemanticAstCollectionExclusiveRunsAfter(artifact, syntax_id, statement)) {
            rebound = statement;
        }
        let early: Bool = early_returns &&
            TypedAstArenaNodeKindIs(artifact.arena, statement, TypedAstKindValueReturnStmtTag()) &&
            SemanticAstCollectionExclusiveReturnBeforeUses(artifact, syntax_id, statement, uses);
        // The consuming statement itself counts: a holder in a sibling
        // argument reaches the same call.
        if (carried || (statement >= syntax_id && (rebound < 0 || statement <= rebound))) && !early &&
            (!scoped || SemanticAstCollectionNodeEnclosedBy(artifact, statement, scope)) {
            let lane: Int = 0;
            while lane < 3 {
                let slot: Int = surface * 3 + lane;
                if (!rewrites || lane != AstExpressionLaneAtom()) &&
                    slot < ArrayLength(surfaces.expression_graph.has_roots) && surfaces.expression_graph.has_roots[slot] {
                    let root: Int = surfaces.expression_graph.roots[slot];
                    let start: Option<Int> = SemanticExpressionGraphSubtreeStart(surfaces.expression_graph, root);
                    let node: Int = root + 1;
                    if IsSome(start) { node = UnwrapOption(start); }
                    while node <= root {
                        if surfaces.expression_graph.arena.topology.node_kinds[node] == AstExpressionNodeLeaf() &&
                            !SemanticAstCollectionExclusiveMemberName(surfaces, node, root) {
                            let place: SemanticAstCollectionAggregateSinkPlace =
                                SemanticAstCollectionAggregateSinkPlaceForNode(artifact, signatures, locals,
                                    inferred_types, surfaces, function_id, statement, node);
                            if place.ok && !place.temporary &&
                                SemanticAstCollectionExclusivePlaceRoot(locals, place) == binding { return false; }
                        }
                        node = node + 1;
                    }
                }
                lane = lane + 1;
            }
        }
        surface = surface + 1;
    }
    return true;
}

// The binding the statement at `statement` defines or wholly assigns, or 0.
func SemanticAstCollectionExclusiveStatementBinding(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts, function_id: Int, statement: Int
) -> Int {
    let declared: Option<Int> = SemanticAstLocalBindingIndexForNode(locals, statement);
    if IsSome(declared) { return locals.node_ids[UnwrapOption(declared)]; }
    if !TypedAstArenaNodeKindIs(artifact.arena, statement, TypedAstKindAssignStmtTag()) { return 0; }
    let target: Option<Int> = SemanticAstExpressionGraphRootForNode(surfaces, statement, AstExpressionLaneAtom());
    if !IsSome(target) { return 0; }
    let written: SemanticAstCollectionAggregateSinkPlace = SemanticAstCollectionAggregateSinkPlaceForNode(
        artifact, signatures, locals, inferred_types, surfaces, function_id, statement, UnwrapOption(target));
    if !written.ok || written.temporary || ArrayLength(written.chain) != 0 { return 0; }
    return SemanticAstCollectionExclusivePlaceRoot(locals, written);
}

// The assignment at `statement` writes the whole binding `binding`.
func SemanticAstCollectionExclusiveRebindsBinding(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts, function_id: Int, statement: Int, binding: Int
) -> Bool {
    if !TypedAstArenaNodeKindIs(artifact.arena, statement, TypedAstKindAssignStmtTag()) { return false; }
    let target: Option<Int> = SemanticAstExpressionGraphRootForNode(surfaces, statement, AstExpressionLaneAtom());
    if !IsSome(target) { return false; }
    let written: SemanticAstCollectionAggregateSinkPlace = SemanticAstCollectionAggregateSinkPlaceForNode(
        artifact, signatures, locals, inferred_types, surfaces, function_id, statement, UnwrapOption(target));
    return written.ok && !written.temporary && ArrayLength(written.chain) == 0 &&
        SemanticAstCollectionExclusivePlaceRoot(locals, written) == binding;
}

// A local declared at or after `syntax_id` holds only copies made there or
// later: any older storage reaches it through a later read the scan checks.
func SemanticAstCollectionExclusiveDeclaredFrom(
    ref locals: SemanticAstLocalBindingFacts, binding: Int, syntax_id: Int
) -> Bool {
    return binding >= syntax_id && IsSome(SemanticAstLocalBindingIndexForNode(locals, binding));
}

// A use of `place` at `syntax_id` is the last one only if no holder of a
// copy of it, and no source of a copy it holds, is used later.
func SemanticAstCollectionExclusiveCopiesUnread(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts, copies: HashMap<String, Int>,
    ref place: SemanticAstCollectionAggregateSinkPlace, first_surface: Int, end_surface: Int,
    function_id: Int, syntax_id: Int, scoped: Bool, scope: Int, ref uses: Array<Int>, early_returns: Bool,
    ref grown: Array<String>, ref ignored_sources: Array<Int>
) -> Bool {
    let root: Int = SemanticAstCollectionExclusivePlaceRoot(locals, place);
    // The statement's own destination receives the moved value.
    let destination: Int = SemanticAstCollectionExclusiveStatementBinding(artifact, signatures, locals,
        inferred_types, surfaces, function_id, syntax_id);
    let from: String = Concat("from:", ToString(root));
    let index: Int = 0;
    while index < SemanticAstCollectionExclusiveCopyCount(copies, from) {
        let edge: Int = MapGet(copies, Concat(from, Concat(":", ToString(index))));
        let holder: Int = MapGet(copies, Concat("edge_holder:", ToString(edge)));
        if holder != destination && !SemanticAstCollectionExclusiveDeclaredFrom(locals, holder, syntax_id) &&
            SemanticAstCollectionExclusiveCopyEdgeField(copies, surfaces, edge, place.chain) &&
            SemanticAstCollectionExclusiveCopyEdgeGrown(copies, edge, grown) &&
            !SemanticAstCollectionExclusiveBindingUnreadAfter(artifact, signatures, locals, inferred_types,
                surfaces, first_surface, end_surface, function_id, syntax_id, scoped, scope, uses,
                early_returns, holder) {
            return false;
        }
        index = index + 1;
    }
    // A holder shares its storage with the source and every other holder of
    // it, in the first fields the copy lands in.
    let into: String = Concat("into:", ToString(root));
    index = 0;
    while index < SemanticAstCollectionExclusiveCopyCount(copies, into) {
        let edge: Int = MapGet(copies, Concat(into, Concat(":", ToString(index))));
        let source: Int = MapGet(copies, Concat("edge_root:", ToString(edge)));
        let ignored: Bool = SemanticAstCollectionExclusiveDeclaredFrom(locals, source, syntax_id) ||
            !SemanticAstCollectionExclusiveCopyEdgeLands(copies, surfaces, edge, place.chain, grown);
        let ignored_index: Int = 0;
        while ignored_index < ArrayLength(ignored_sources) {
            if ignored_sources[ignored_index] == source { ignored = true; }
            ignored_index = ignored_index + 1;
        }
        if !ignored && !SemanticAstCollectionExclusiveBindingUnreadAfter(artifact, signatures, locals, inferred_types,
                surfaces, first_surface, end_surface, function_id, syntax_id, scoped, scope, uses,
                early_returns, source) {
            return false;
        }
        let sibling_from: String = Concat("from:", ToString(source));
        let sibling: Int = 0;
        while sibling < SemanticAstCollectionExclusiveCopyCount(copies, sibling_from) {
            let other: Int = MapGet(copies, Concat("edge_holder:", ToString(MapGet(copies,
                Concat(sibling_from, Concat(":", ToString(sibling)))))));
            if !ignored && other != root && !SemanticAstCollectionExclusiveDeclaredFrom(locals, other, syntax_id) &&
                !SemanticAstCollectionExclusiveBindingUnreadAfter(artifact, signatures, locals,
                    inferred_types, surfaces, first_surface, end_surface, function_id, syntax_id, scoped, scope,
                    uses, early_returns, other) {
                return false;
            }
            sibling = sibling + 1;
        }
        index = index + 1;
    }
    return true;
}

// A copy of `place` at `syntax_id` the fixed point cannot follow shares the
// root, or its first field, from then on: "s:root", or "s:root.field" with
// "s:root.*". The copy's statement is kept for growth ordering.
func SemanticAstCollectionExclusiveRecordCopy(
    ref surfaces: SemanticAstExpressionSurfaceFacts, ref locals: SemanticAstLocalBindingFacts,
    ref place: SemanticAstCollectionAggregateSinkPlace, inout copied: HashMap<String, Int>, syntax_id: Int
) -> Void {
    let root: String = ToString(SemanticAstCollectionExclusivePlaceRoot(locals, place));
    let count_key: String = Concat("s_n:", root);
    let count: Int = SemanticAstCollectionExclusiveCopyCount(copied, count_key);
    let seen: Bool = false;
    let index: Int = 0;
    while index < count && !seen {
        seen = MapGet(copied, Concat("s_i:", Concat(root, Concat(":", ToString(index))))) == syntax_id;
        index = index + 1;
    }
    if !seen {
        MapSet(copied, Concat("s_i:", Concat(root, Concat(":", ToString(count)))), syntax_id);
        MapSet(copied, count_key, count + 1);
    }
    let field: Option<String> = None;
    if ArrayLength(place.chain) > 0 {
        field = SemanticExpressionGraphNodeText(surfaces.expression_graph, place.chain[0]);
    }
    if !IsSome(field) { MapSet(copied, Concat("s:", root), 1); return; }
    MapSet(copied, Concat("s:", Concat(root, Concat(".", UnwrapOption(field)))), 1);
    MapSet(copied, Concat("s:", Concat(root, ".*")), 1);
}

// The place names storage an unconsumed copy shares.
func SemanticAstCollectionExclusiveCopiedPlace(
    ref surfaces: SemanticAstExpressionSurfaceFacts, ref locals: SemanticAstLocalBindingFacts,
    shared_locals: HashMap<String, Int>, ref place: SemanticAstCollectionAggregateSinkPlace
) -> Bool {
    let root: String = ToString(SemanticAstCollectionExclusivePlaceRoot(locals, place));
    if ArrayLength(place.chain) == 0 { return MapHas(shared_locals, Concat(root, ".*")); }
    let field: Option<String> = SemanticExpressionGraphNodeText(surfaces.expression_graph, place.chain[0]);
    return !IsSome(field) || MapHas(shared_locals, Concat(root, Concat(".", UnwrapOption(field))));
}

// `holder` follows every copy it receives: each of its uses stays where the
// fixed point sees it (memoized in `copied`).
func SemanticAstCollectionExclusiveHolderFollowed(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts, surface_starts: HashMap<String, Int>,
    surface_ends: HashMap<String, Int>, inout copied: HashMap<String, Int>, function_id: Int, holder: Int
) -> Bool {
    let memo: String = Concat("contained:", ToString(holder));
    if MapHas(copied, memo) { return MapGet(copied, memo) == 1; }
    let key: String = ToString(function_id);
    let followed: Bool = MapHas(surface_starts, key) && MapHas(surface_ends, key) &&
        MapGet(surface_starts, key) >= 0 &&
        SemanticAstCollectionExclusiveHolderContained(artifact, signatures, locals, inferred_types, surfaces,
            MapGet(surface_starts, key), MapGet(surface_ends, key), function_id, holder);
    if followed { MapSet(copied, memo, 1); } else { MapSet(copied, memo, 2); }
    return followed;
}
