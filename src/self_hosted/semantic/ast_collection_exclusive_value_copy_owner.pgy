// Copy graph projection and holder containment. Immutable edge admission
// belongs to the edge owner; readers never reconstruct a landing from uses.
import "ast_collection_exclusive_value_copy_edge_owner.pgy";

// Seal the reached copy cut before any last-use memo lookup. New landings
// are new immutable pairs, so their adjacency counts change the epoch.
func SemanticAstCollectionExclusiveCopySignature(
    copies: HashMap<String, Int>, ref constructors: SemanticAstNominalConstructorFacts, root: Int
) -> String {
    if !SemanticAstCollectionExclusiveCopyFieldReady(constructors, -1) { return ""; }
    let from: String = Concat("from:", ToString(root));
    let outward: Int = SemanticAstCollectionExclusiveCopyCount(copies, from);
    if outward < 0 || (outward == 0 && MapHas(copies, Concat(from, ":0"))) { return ""; }
    let index: Int = 0;
    while index < outward {
        let key: String = Concat(from, Concat(":", ToString(index)));
        if !MapHas(copies, key) { return ""; }
        let edge: SemanticAstCollectionExclusiveCopyEdge = SemanticAstCollectionExclusiveCopyEdgeAt(copies, constructors, MapGet(copies, key));
        if !edge.ok || edge.root != root { return ""; }
        index = index + 1;
    }
    let into: String = Concat("into:", ToString(root));
    let count: Int = SemanticAstCollectionExclusiveCopyCount(copies, into);
    if count < 0 || (count == 0 && MapHas(copies, Concat(into, ":0"))) { return ""; }
    let siblings: Int = 0;
    index = 0;
    while index < count {
        let key: String = Concat(into, Concat(":", ToString(index)));
        if !MapHas(copies, key) { return ""; }
        let edge: SemanticAstCollectionExclusiveCopyEdge = SemanticAstCollectionExclusiveCopyEdgeAt(copies, constructors, MapGet(copies, key));
        if !edge.ok || edge.holder != root { return ""; }
        let sibling_from: String = Concat("from:", ToString(edge.root));
        let sibling_count: Int = SemanticAstCollectionExclusiveCopyCount(copies, sibling_from);
        if sibling_count < 0 || (sibling_count == 0 && MapHas(copies, Concat(sibling_from, ":0"))) { return ""; }
        let sibling: Int = 0;
        while sibling < sibling_count {
            let sibling_key: String = Concat(sibling_from, Concat(":", ToString(sibling)));
            if !MapHas(copies, sibling_key) { return ""; }
            let row: SemanticAstCollectionExclusiveCopyEdge = SemanticAstCollectionExclusiveCopyEdgeAt(copies, constructors, MapGet(copies, sibling_key));
            if !row.ok || row.root != edge.root { return ""; }
            sibling = sibling + 1;
        }
        siblings = siblings + sibling_count;
        index = index + 1;
    }
    if outward < 0 || count < 0 { return ""; }
    return Concat(ToString(constructors.artifact_node_count), Concat("/", Concat(ToString(ArrayLength(constructors.field_names)),
        Concat("/", Concat(ToString(outward), Concat(",", Concat(ToString(count), Concat(",", ToString(siblings)))))))));
}

func SemanticAstCollectionExclusiveCopyHeld(
    copies: HashMap<String, Int>, ref constructors: SemanticAstNominalConstructorFacts,
    ref surfaces: SemanticAstExpressionSurfaceFacts, root: Int, ref chain: Array<Int>, holder: Int
) -> Bool {
    let from: String = Concat("from:", ToString(root));
    let index: Int = 0;
    while index < SemanticAstCollectionExclusiveCopyCount(copies, from) {
        let key: String = Concat(from, Concat(":", ToString(index)));
        if !MapHas(copies, key) { return false; }
        let edge: SemanticAstCollectionExclusiveCopyEdge = SemanticAstCollectionExclusiveCopyEdgeAt(copies, constructors, MapGet(copies, key));
        if !edge.ok || edge.root != root { return false; }
        if edge.holder == holder {
            if edge.source_field == -1 || ArrayLength(chain) == 0 { return true; }
            let field: Option<String> = SemanticExpressionGraphNodeText(surfaces.expression_graph, chain[0]);
            if IsSome(field) && constructors.field_names[edge.source_field] == UnwrapOption(field) { return true; }
        }
        index = index + 1;
    }
    return false;
}

// A field extraction follows only copies landing in that field. Whole copies
// keep known destination fields; an unknown whole source remains conservative.
func SemanticAstCollectionExclusivePropagateCopies(
    inout copies: HashMap<String, Int>, ref constructors: SemanticAstNominalConstructorFacts,
    from_holder: Int, source_projection: Int, holder: Int, destination_landing: Int
) -> SemanticAstCollectionExclusiveCopyAdmission {
    if !SemanticAstCollectionExclusiveCopyFieldReady(constructors, source_projection) ||
        !SemanticAstCollectionExclusiveCopyFieldReady(constructors, destination_landing) {
        return SemanticAstCollectionExclusiveCopyAdmission(false, false);
    }
    let changed: Bool = false;
    let into: String = Concat("into:", ToString(from_holder));
    let count: Int = SemanticAstCollectionExclusiveCopyCount(copies, into);
    let index: Int = 0;
    while index < count {
        let key: String = Concat(into, Concat(":", ToString(index)));
        if !MapHas(copies, key) { return SemanticAstCollectionExclusiveCopyAdmission(false, changed); }
        let edge: SemanticAstCollectionExclusiveCopyEdge = SemanticAstCollectionExclusiveCopyEdgeAt(copies, constructors, MapGet(copies, key));
        if !edge.ok || edge.holder != from_holder { return SemanticAstCollectionExclusiveCopyAdmission(false, changed); }
        if SemanticAstCollectionExclusiveCopyFieldsOverlap(constructors, edge.destination_field, source_projection) {
            let destination: Int = destination_landing;
            if source_projection == -1 && destination_landing == -1 { destination = edge.destination_field; }
            let admitted: SemanticAstCollectionExclusiveCopyAdmission = SemanticAstCollectionExclusiveRecordCopyEdge(
                copies, constructors, edge.root, edge.source_field, holder, destination);
            if !admitted.ok { return SemanticAstCollectionExclusiveCopyAdmission(false, changed); }
            if admitted.changed { changed = true; }
        }
        index = index + 1;
    }
    return SemanticAstCollectionExclusiveCopyAdmission(true, changed);
}

// Shared-storage classification is separate from immutable copy edges.
func SemanticAstCollectionExclusiveRecordCopy(
    ref surfaces: SemanticAstExpressionSurfaceFacts, ref locals: SemanticAstLocalBindingFacts,
    ref place: SemanticAstCollectionAggregateSinkPlace, inout copied: HashMap<String, Int>
) -> Void {
    let root: String = ToString(SemanticAstCollectionExclusivePlaceRoot(locals, place));
    let field: Option<String> = None;
    if ArrayLength(place.chain) > 0 {
        field = SemanticExpressionGraphNodeText(surfaces.expression_graph, place.chain[0]);
    }
    if !IsSome(field) { MapSet(copied, Concat("s:", root), 1); return; }
    MapSet(copied, Concat("s:", Concat(root, Concat(".", UnwrapOption(field)))), 1);
    MapSet(copied, Concat("s:", Concat(root, ".*")), 1);
}

func SemanticAstCollectionExclusiveCopiedPlace(
    ref surfaces: SemanticAstExpressionSurfaceFacts, ref locals: SemanticAstLocalBindingFacts,
    shared_locals: HashMap<String, Int>, ref place: SemanticAstCollectionAggregateSinkPlace
) -> Bool {
    let root: String = ToString(SemanticAstCollectionExclusivePlaceRoot(locals, place));
    if ArrayLength(place.chain) == 0 { return MapHas(shared_locals, Concat(root, ".*")); }
    let field: Option<String> = SemanticExpressionGraphNodeText(surfaces.expression_graph, place.chain[0]);
    return !IsSome(field) || MapHas(shared_locals, Concat(root, Concat(".", UnwrapOption(field))));
}

// Holder containment is sealed for the fixed routine surface generation.
func SemanticAstCollectionExclusiveHolderFollowed(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts, surface_starts: HashMap<String, Int>,
    surface_ends: HashMap<String, Int>, inout copied: HashMap<String, Int>, function_id: Int, holder: Int
) -> Bool {
    let memo: String = Concat("contained:", ToString(holder));
    if MapHas(copied, memo) { return MapGet(copied, memo) == 1; }
    let key: String = ToString(function_id);
    let followed: Bool = MapHas(surface_starts, key) && MapHas(surface_ends, key) &&
        MapGet(surface_starts, key) >= 0 &&
        SemanticAstCollectionExclusiveHolderContained(artifact, signatures, locals, inferred_types, surfaces,
            MapGet(surface_starts, key), MapGet(surface_ends, key), function_id, holder);
    if followed { MapSet(copied, memo, 1); } else { MapSet(copied, memo, 2); }
    return followed;
}

// Every use of `holder` stays where the fixed point sees it: reads,
// conditions, logs, returns, rebinding, and the values of definitions.
func SemanticAstCollectionExclusiveHolderContained(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts, first_surface: Int, end_surface: Int,
    function_id: Int, holder: Int
) -> Bool {
    let surface: Int = first_surface;
    while surface < end_surface {
        let statement: Int = surfaces.node_ids[surface];
        let defines: Bool = TypedAstArenaNodeKindIs(artifact.arena, statement, TypedAstKindLetStmtTag()) ||
            TypedAstArenaNodeKindIs(artifact.arena, statement, TypedAstKindAssignStmtTag()) ||
            TypedAstArenaNodeKindIs(artifact.arena, statement, TypedAstKindValueReturnStmtTag());
        let observes: Bool = TypedAstArenaNodeKindIs(artifact.arena, statement, TypedAstKindIfStmtTag()) ||
            TypedAstArenaNodeKindIs(artifact.arena, statement, TypedAstKindWhileStmtTag()) ||
            TypedAstArenaNodeKindIs(artifact.arena, statement, TypedAstKindLogStmtTag());
        let lane: Int = 0;
        while lane < 3 {
            let slot: Int = surface * 3 + lane;
            if slot < ArrayLength(surfaces.expression_graph.has_roots) && surfaces.expression_graph.has_roots[slot] {
                let root: Int = surfaces.expression_graph.roots[slot];
                let start: Option<Int> = SemanticExpressionGraphSubtreeStart(surfaces.expression_graph, root);
                let node: Int = root + 1;
                if IsSome(start) { node = UnwrapOption(start); }
                while node <= root {
                    if surfaces.expression_graph.arena.topology.node_kinds[node] == AstExpressionNodeLeaf() &&
                        !SemanticAstCollectionExclusiveMemberName(surfaces, node, root) {
                        let place: SemanticAstCollectionAggregateSinkPlace = SemanticAstCollectionAggregateSinkPlaceForNode(
                            artifact, signatures, locals, inferred_types, surfaces, function_id, statement, node);
                        let read_type: String = SemanticAstCollectionStorageObservedType(
                            signatures, inferred_types, surfaces, function_id, node, place);
                        if place.ok && !place.temporary &&
                            SemanticAstCollectionExclusivePlaceRoot(locals, place) == holder && !defines && !observes &&
                            !SemanticAstCollectionExclusiveFamilyRead(artifact, surfaces, statement, lane, root, node,
                                false, read_type) {
                            return false;
                        }
                    }
                    node = node + 1;
                }
            }
            lane = lane + 1;
        }
        surface = surface + 1;
    }
    return true;
}
