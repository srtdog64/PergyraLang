// Exclusive aggregate values (docs/semantics/27_ownership_clean.md section
// 2.3 step 7, for the storage the collection verdict tracks). A value is
// exclusive when no other live value names an Array buffer it reaches. Only
// such a buffer may grow through a member alias, because growth frees the
// old buffer every other copy still names.
//
// - An array literal, a Clone and a MapKeys result are fresh.
// - A constructor is exclusive when every tracked argument is exclusive,
//   consumed, and distinct from the other arguments.
// - A user call is exclusive when its routine's result is, and the argument
//   of each formal that flows into that result is exclusive and consumed.
// - A local is exclusive when every definition is (a greatest fixed point,
//   so `x = F(x)` threading keeps it), and a member path when its root is.
// - A default or inout formal is exclusive under its callers' obligation; the
//   classification records it as a dependency. An own formal is exclusive.
// - An indexed read, a ref formal and anything else may be shared.
import "ast_collection_exclusive_value_class_owner.pgy";
import "ast_collection_exclusive_value_dead_definition_owner.pgy";
import "ast_expression_graph_call_view_owner.pgy";
import "ast_expression_graph_array_literal_owner.pgy";
import "ast_nominal_constructor_lookup_owner.pgy";
import "ast_collection_ownership_state_owner.pgy";

// Two tracked constructor arguments name overlapping storage.
func SemanticAstCollectionExclusivePlacesOverlap(
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref left: SemanticAstCollectionAggregateSinkPlace, ref right: SemanticAstCollectionAggregateSinkPlace
) -> Bool {
    if !left.ok || !right.ok || left.temporary || right.temporary || left.key != right.key { return false; }
    let shorter: Int = ArrayLength(left.chain);
    if ArrayLength(right.chain) < shorter { shorter = ArrayLength(right.chain); }
    let index: Int = 0;
    while index < shorter {
        let a: Option<String> = SemanticExpressionGraphNodeText(surfaces.expression_graph, left.chain[index]);
        let b: Option<String> = SemanticExpressionGraphNodeText(surfaces.expression_graph, right.chain[index]);
        if !IsSome(a) || !IsSome(b) || UnwrapOption(a) != UnwrapOption(b) { return false; }
        index = index + 1;
    }
    return true;
}

// The classification of the value at `node` in statement `syntax_id`. With
// `consume`, a binding or member path must also be the last use of its place.
// `holder` is the binding the definition writes, or 0.
func SemanticAstCollectionExclusiveClassify(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts, ref assignments: SemanticAstAssignmentFacts,
    shared_results: HashMap<String, Int>, carrying: HashMap<String, Int>,
    shared_locals: HashMap<String, Int>, ref dep_locals: Array<Int>, ref dep_formals: Array<Int>,
    ref dep_paths: Array<Int>, ref paths: Array<String>,
    surface_starts: HashMap<String, Int>, surface_ends: HashMap<String, Int>,
    inout consumed: HashMap<String, Int>, inout copied: HashMap<String, Int>,
    empty_locals: HashMap<String, Int>, field_reads: HashMap<String, Int>,
    function_id: Int, syntax_id: Int, node: Int, consume: Bool, depth: Int, holder: Int
) -> SemanticAstCollectionExclusiveClass {
    if depth > 32 { return SemanticAstCollectionExclusiveShared(); }
    let literal: SemanticArrayLiteralView = SemanticArrayLiteralViewFromGraph(surfaces.expression_graph, node);
    if literal.ok { return SemanticAstCollectionExclusiveFresh(); }
    let call: SemanticCallSpineView = SemanticCallSpineViewFromGraph(surfaces.expression_graph, node);
    if call.ok {
        if SemanticAstCollectionOwnershipBuiltinCall(surfaces.expression_graph, call.call_node, "Clone") ||
            SemanticAstCollectionOwnershipBuiltinCall(surfaces.expression_graph, call.call_node, "MapKeys") {
            return SemanticAstCollectionExclusiveFresh();
        }
        let target: Option<Int> = SemanticExpressionGraphCallTargetSyntaxId(surfaces.expression_graph, call.call_node);
        let name: Option<String> = SemanticExpressionGraphCallTargetName(surfaces.expression_graph, call.call_node);
        if !IsSome(target) || !IsSome(name) { return SemanticAstCollectionExclusiveShared(); }
        let result: SemanticAstCollectionExclusiveClass = SemanticAstCollectionExclusiveFresh();
        if UnwrapOption(target) == 0 {
            // A constructor call carries no target; its callee names the type.
            let type_name: String = UnwrapOption(name);
            let callee_text: Option<String> = SemanticExpressionGraphNodeText(surfaces.expression_graph, call.callee_node);
            if type_name == "" && IsSome(callee_text) { type_name = UnwrapOption(callee_text); }
            let constructor: Option<Int> = SemanticAstNominalConstructorIndexForName(constructors, type_name);
            if !IsSome(constructor) ||
                constructors.param_counts[UnwrapOption(constructor)] != ArrayLength(call.argument_nodes) {
                return SemanticAstCollectionExclusiveShared();
            }
            let start: Int = constructors.param_starts[UnwrapOption(constructor)];
            let index: Int = 0;
            while index < ArrayLength(call.argument_nodes) {
                if !SemanticAstCollectionExclusiveUntrackedType(constructors.param_type_names[start + index]) {
                    let part: SemanticAstCollectionExclusiveClass = SemanticAstCollectionExclusiveClassify(
                        artifact, signatures, constructors, locals, inferred_types, surfaces, assignments,
                        shared_results, carrying, shared_locals, dep_locals, dep_formals, dep_paths, paths,
                        surface_starts, surface_ends, consumed, copied, empty_locals, field_reads, function_id, syntax_id,
                        call.argument_nodes[index], true, depth + 1, holder);
                    SemanticAstCollectionExclusiveJoinField(result, part,
                        constructors.field_names[start + index]);
                    let here: SemanticAstCollectionAggregateSinkPlace = SemanticAstCollectionAggregateSinkPlaceForNode(
                        artifact, signatures, locals, inferred_types, surfaces, function_id, syntax_id,
                        call.argument_nodes[index]);
                    let other: Int = 0;
                    while other < index {
                        if !SemanticAstCollectionExclusiveUntrackedType(constructors.param_type_names[start + other]) {
                            let there: SemanticAstCollectionAggregateSinkPlace = SemanticAstCollectionAggregateSinkPlaceForNode(
                                artifact, signatures, locals, inferred_types, surfaces, function_id, syntax_id,
                                call.argument_nodes[other]);
                            if SemanticAstCollectionExclusivePlacesOverlap(surfaces, here, there) &&
                                !(here.key >= 0 && ArrayLength(here.chain) == 0 &&
                                  MapHas(empty_locals, ToString(locals.node_ids[here.key]))) {
                                return SemanticAstCollectionExclusiveShared();
                            }
                        }
                        other = other + 1;
                    }
                }
                index = index + 1;
            }
            return result;
        }
        let signature: Option<Int> = SemanticAstFunctionSignatureIndexForNode(signatures, UnwrapOption(target));
        if !IsSome(signature) || MapHas(shared_results, ToString(UnwrapOption(target))) {
            return SemanticAstCollectionExclusiveShared();
        }
        // Result fields some return of the routine shares.
        let target_key: String = ToString(UnwrapOption(target));
        let shared_count: Int = SemanticAstCollectionExclusiveCopyCount(shared_results, Concat("rfn:", target_key));
        let shared_index: Int = 0;
        while shared_index < shared_count {
            let shared_path: Int = MapGet(shared_results, Concat("rfi:", Concat(target_key,
                Concat(":", ToString(shared_index)))));
            SemanticAstCollectionExclusiveAddSharedField(result, paths[2 * shared_path]);
            shared_index = shared_index + 1;
        }
        let ordinal: Int = 0;
        while ordinal < ArrayLength(call.argument_nodes) {
            let formal: SemanticAstCollectionArgumentFormalTarget = SemanticAstCollectionArgumentFormalTargetForArgument(
                signatures, surfaces.expression_graph, call.call_node, ordinal);
            if !formal.ok { return SemanticAstCollectionExclusiveShared(); }
            if MapHas(carrying, ToString(formal.syntax_id)) {
                let part: SemanticAstCollectionExclusiveClass = SemanticAstCollectionExclusiveClassify(
                    artifact, signatures, constructors, locals, inferred_types, surfaces, assignments,
                    shared_results, carrying, shared_locals, dep_locals, dep_formals, dep_paths, paths,
                    surface_starts, surface_ends, consumed, copied, empty_locals, field_reads, function_id, syntax_id,
                    call.argument_nodes[ordinal], true, depth + 1, holder);
                // Each carried path lands the argument (or its source field)
                // at the result (or a result field).
                let formal_key: String = ToString(formal.syntax_id);
                let carried: Int = SemanticAstCollectionExclusiveCopyCount(carrying, Concat("cn:", formal_key));
                if carried == 0 { SemanticAstCollectionExclusiveJoin(result, part); }
                let carried_index: Int = 0;
                while carried_index < carried {
                    let path: Int = MapGet(carrying, Concat("ci:", Concat(formal_key,
                        Concat(":", ToString(carried_index)))));
                    let piece: SemanticAstCollectionExclusiveClass = part;
                    if paths[2 * path + 1] != "" {
                        piece = SemanticAstCollectionExclusiveFieldOf(part, paths[2 * path + 1]);
                    }
                    if paths[2 * path] == "" { SemanticAstCollectionExclusiveJoin(result, piece); }
                    else { SemanticAstCollectionExclusiveJoinField(result, piece, paths[2 * path]); }
                    carried_index = carried_index + 1;
                }
            }
            ordinal = ordinal + 1;
        }
        return result;
    }
    let place: SemanticAstCollectionAggregateSinkPlace = SemanticAstCollectionAggregateSinkPlaceForNode(
        artifact, signatures, locals, inferred_types, surfaces, function_id, syntax_id, node);
    if !place.ok { return SemanticAstCollectionExclusiveShared(); }
    if place.temporary {
        // A member of a call or constructor result has the result's class.
        let receiver: Int = node;
        let member: SemanticMemberAccessView = SemanticMemberAccessViewFromGraph(surfaces.expression_graph, receiver);
        while member.ok {
            receiver = member.receiver_node;
            member = SemanticMemberAccessViewFromGraph(surfaces.expression_graph, receiver);
        }
        if receiver == node { return SemanticAstCollectionExclusiveShared(); }
        return SemanticAstCollectionExclusiveClassify(artifact, signatures, constructors, locals, inferred_types,
            surfaces, assignments, shared_results, carrying, shared_locals, dep_locals, dep_formals, dep_paths, paths,
            surface_starts, surface_ends, consumed, copied, empty_locals, field_reads, function_id, syntax_id, receiver, consume,
            depth + 1, holder);
    }
    if place.key >= 0 && ArrayLength(place.chain) == 0 &&
        MapHas(empty_locals, ToString(locals.node_ids[place.key])) {
        return SemanticAstCollectionExclusiveFresh();
    }
    let root_id: Int = SemanticAstCollectionExclusivePlaceRoot(locals, place);
    let followed: Bool = holder > 0 && holder != root_id &&
        SemanticAstCollectionExclusiveHolderFollowed(artifact, signatures, locals, inferred_types, surfaces,
            surface_starts, surface_ends, copied, function_id, holder);
    let copy_shared: Array<String> = [];
    if consume && !SemanticAstCollectionExclusiveConsumedAt(artifact, signatures, constructors, locals,
            inferred_types, surfaces, assignments, surface_starts, surface_ends, field_reads, copied, consumed,
            function_id, syntax_id, node) {
        // A place whose only later readers are copies it shares moves, and
        // stays exclusive outside the fields those copies reach.
        let only_copies: Bool = false;
        if depth == 0 || followed || holder == root_id {
            let landing: SemanticAstCollectionExclusiveCopyLanding = SemanticAstCollectionExclusiveCopyLandingFor(
                signatures, constructors, locals, inferred_types, copied, shared_locals, dep_locals, dep_formals,
                dep_paths, paths, function_id, root_id);
            let whole_copies: Array<String> = ["*"];
            only_copies = landing.ok && SemanticAstCollectionExclusiveSinkArgumentConsumed(artifact, signatures,
                constructors, locals, inferred_types, surfaces, assignments, surface_starts, surface_ends,
                field_reads, copied, consumed, function_id, syntax_id, node, whole_copies, landing.sources);
            if only_copies { copy_shared = landing.fields; }
        }
        // A copy inside a call or constructor makes the destination a second
        // holder that keeps the place's dependencies. A plain alias, or a
        // holder the fixed point cannot follow, shares the place instead.
        if !only_copies && (depth == 0 || !followed) {
            SemanticAstCollectionExclusiveRecordCopy(surfaces, locals, place, copied);
            return SemanticAstCollectionExclusiveShared();
        }
        let field: String = "";
        if ArrayLength(place.chain) > 0 {
            let first: Option<String> = SemanticExpressionGraphNodeText(surfaces.expression_graph, place.chain[0]);
            if !IsSome(first) { return SemanticAstCollectionExclusiveShared(); }
            field = UnwrapOption(first);
        }
        if depth > 0 { SemanticAstCollectionExclusiveRecordCopyEdge(copied, root_id, field, holder); }
    }
    // The destination of a holder holds what it holds.
    if holder > 0 && holder != root_id && followed {
        SemanticAstCollectionExclusivePropagateCopies(copied, root_id, holder);
    }
    // A whole root whose fields were shared one by one keeps the rest.
    let partly_shared: Array<String> = [];
    if ArrayLength(place.chain) == 0 && MapHas(shared_locals, Concat(ToString(root_id), ".*")) {
        let root_fields: Array<String> = SemanticAstCollectionExclusiveTypeFields(constructors,
            SemanticAstCollectionExclusiveRootType(signatures, locals, inferred_types, function_id, root_id));
        if ArrayLength(root_fields) == 0 { return SemanticAstCollectionExclusiveShared(); }
        let root_field: Int = 0;
        while root_field < ArrayLength(root_fields) {
            if MapHas(shared_locals, Concat(ToString(root_id), Concat(".", root_fields[root_field]))) {
                ArrayPush(partly_shared, root_fields[root_field]);
            }
            root_field = root_field + 1;
        }
    } else if SemanticAstCollectionExclusiveCopiedPlace(surfaces, locals, shared_locals, place) {
        return SemanticAstCollectionExclusiveShared();
    }
    let copy_index: Int = 0;
    while copy_index < ArrayLength(copy_shared) {
        let known: Bool = false;
        let seen: Int = 0;
        while seen < ArrayLength(partly_shared) {
            if partly_shared[seen] == copy_shared[copy_index] { known = true; }
            seen = seen + 1;
        }
        if !known { ArrayPush(partly_shared, copy_shared[copy_index]); }
        copy_index = copy_index + 1;
    }
    let first_field: String = "";
    if ArrayLength(place.chain) > 0 {
        let first_text: Option<String> = SemanticExpressionGraphNodeText(surfaces.expression_graph, place.chain[0]);
        if !IsSome(first_text) { return SemanticAstCollectionExclusiveShared(); }
        first_field = UnwrapOption(first_text);
    }
    if place.key >= 0 {
        let local_id: Int = locals.node_ids[place.key];
        if MapHas(shared_locals, ToString(local_id)) { return SemanticAstCollectionExclusiveShared(); }
        let local_class: SemanticAstCollectionExclusiveClass =
            SemanticAstCollectionExclusiveLocalDeps(dep_locals, dep_formals, dep_paths, paths, local_id);
        local_class.shared_fields = partly_shared;
        if first_field != "" { return SemanticAstCollectionExclusiveFieldOf(local_class, first_field); }
        return local_class;
    }
    if place.formal_mode != 0 && place.formal_mode != 1 && place.formal_mode != 2 {
        return SemanticAstCollectionExclusiveShared();
    }
    // A reassigned formal also holds every value assigned to it.
    let formal_id: Int = 0 - place.key;
    if MapHas(shared_locals, ToString(formal_id)) { return SemanticAstCollectionExclusiveShared(); }
    let result: SemanticAstCollectionExclusiveClass = SemanticAstCollectionExclusiveLocalDeps(
        dep_locals, dep_formals, dep_paths, paths, formal_id);
    result.shared_fields = partly_shared;
    if first_field != "" { result = SemanticAstCollectionExclusiveFieldOf(result, first_field); }
    if place.formal_mode == 2 { return result; }
    SemanticAstCollectionExclusiveAddDep(result, formal_id, "", first_field);
    return result;
}

// Locals every definition of which is an empty array literal and that are
// never the receiver of a growth or an inout argument.
func SemanticAstCollectionExclusiveEmptyLocals(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts, ref assignments: SemanticAstAssignmentFacts,
    ref statements: SemanticAstStatementFacts
) -> HashMap<String, Int> {
    let grown: HashMap<String, Int> = MapNew();
    let statement: Int = 0;
    while statement < ArrayLength(statements.node_ids) {
        let kind: Int = statements.kind_tags[statement];
        if kind == TypedAstKindArrayPushStmtTag() || kind == TypedAstKindArraySetStmtTag() ||
            kind == TypedAstKindArrayPopStmtTag() {
            let target: SemanticAstLocalBindingIdentity = SemanticAstCollectionOwnershipLocalForStatementTarget(
                artifact, locals, inferred_types, surfaces, statements.function_node_ids[statement],
                statements.node_ids[statement]);
            if target.ok { MapSet(grown, ToString(locals.node_ids[target.row]), 1); }
        }
        statement = statement + 1;
    }
    let assignment: Int = 0;
    while assignment < ArrayLength(assignments.node_ids) {
        if assignments.target_is_indexed[assignment] != 0 {
            let target: SemanticAstLocalBindingIdentity = SemanticAstCollectionOwnershipLocalForStatementTarget(
                artifact, locals, inferred_types, surfaces, assignments.function_node_ids[assignment],
                assignments.node_ids[assignment]);
            if target.ok { MapSet(grown, ToString(locals.node_ids[target.row]), 1); }
        }
        assignment = assignment + 1;
    }
    let slot: Int = 0;
    while slot < ArrayLength(surfaces.expression_graph.roots) {
        if surfaces.expression_graph.has_roots[slot] {
            let root: Int = surfaces.expression_graph.roots[slot];
            let start: Option<Int> = SemanticExpressionGraphSubtreeStart(surfaces.expression_graph, root);
            let node: Int = root + 1;
            if IsSome(start) { node = UnwrapOption(start); }
            while node <= root {
                if surfaces.expression_graph.arena.topology.node_kinds[node] == AstExpressionNodeCallArgument() {
                    let edge: SemanticCallArgumentEdgeView = SemanticCallArgumentEdgeFromGraph(surfaces.expression_graph, node);
                    if edge.ok {
                        let binding: SemanticAstLocalBindingIdentity = SemanticAstCollectionOwnershipLocalForArgument(
                            artifact, locals, inferred_types, surfaces, slot / 3, edge.argument_node);
                        let formal: SemanticAstCollectionArgumentFormalTarget = SemanticAstCollectionArgumentFormalTargetForArgument(
                            signatures, surfaces.expression_graph, edge.call_node, edge.ordinal);
                        let inout_formal: Bool = false;
                        if formal.ok {
                            let mode: Option<Int> = SemanticAstFunctionParamModeAt(signatures, formal.signature_row, formal.ordinal);
                            inout_formal = !IsSome(mode) || UnwrapOption(mode) == 1;
                        }
                        let builtin_growth: Bool = edge.ordinal == 0 &&
                            (SemanticAstCollectionOwnershipBuiltinCall(surfaces.expression_graph, edge.call_node, "ArrayPush") ||
                             SemanticAstCollectionOwnershipBuiltinCall(surfaces.expression_graph, edge.call_node, "ArraySet") ||
                             SemanticAstCollectionOwnershipBuiltinCall(surfaces.expression_graph, edge.call_node, "ArrayPop") ||
                             SemanticAstCollectionOwnershipBuiltinCall(surfaces.expression_graph, edge.call_node, "ArrayPushOwnedString"));
                        if binding.ok && (inout_formal || builtin_growth) {
                            MapSet(grown, ToString(locals.node_ids[binding.row]), 1);
                        }
                    }
                }
                node = node + 1;
            }
        }
        slot = slot + 1;
    }
    let candidates: HashMap<String, Int> = MapNew();
    let disqualified: HashMap<String, Int> = MapNew();
    let row: Int = 0;
    while row < ArrayLength(locals.node_ids) {
        let value: Option<Int> = SemanticAstExpressionGraphRootForNode(
            surfaces, locals.node_ids[row], AstExpressionLaneValue());
        if IsSome(value) {
            let literal: SemanticArrayLiteralView = SemanticArrayLiteralViewFromGraph(
                surfaces.expression_graph, UnwrapOption(value));
            if literal.ok && ArrayLength(literal.element_nodes) == 0 {
                MapSet(candidates, ToString(locals.node_ids[row]), 1);
            }
        }
        row = row + 1;
    }
    row = 0;
    while row < ArrayLength(assignments.node_ids) {
        let target: Option<Int> = SemanticAstExpressionGraphRootForNode(
            surfaces, assignments.node_ids[row], AstExpressionLaneAtom());
        let value: Option<Int> = SemanticAstExpressionGraphRootForNode(
            surfaces, assignments.node_ids[row], AstExpressionLaneValue());
        if IsSome(target) {
            let written: SemanticAstCollectionAggregateSinkPlace = SemanticAstCollectionAggregateSinkPlaceForNode(
                artifact, signatures, locals, inferred_types, surfaces, assignments.function_node_ids[row],
                assignments.node_ids[row], UnwrapOption(target));
            if written.ok && !written.temporary && written.key >= 0 {
                let empty_value: Bool = false;
                if IsSome(value) {
                    let literal: SemanticArrayLiteralView = SemanticArrayLiteralViewFromGraph(
                        surfaces.expression_graph, UnwrapOption(value));
                    empty_value = literal.ok && ArrayLength(literal.element_nodes) == 0;
                }
                if !empty_value || ArrayLength(written.chain) != 0 ||
                    assignments.target_is_indexed[row] != 0 {
                    MapSet(disqualified, ToString(locals.node_ids[written.key]), 1);
                }
            }
        }
        row = row + 1;
    }
    let empty_locals: HashMap<String, Int> = MapNew();
    let keys: Array<String> = MapKeys(candidates);
    let index: Int = 0;
    while index < ArrayLength(keys) {
        if !MapHas(disqualified, keys[index]) && !MapHas(grown, keys[index]) {
            MapSet(empty_locals, keys[index], 1);
        }
        index = index + 1;
    }
    return empty_locals;
}

// The greatest fixed point over every routine: results and locals start
// exclusive, and a round only marks more of them shared or adds dependencies.
// A table that has not converged within its bound is not admitted.
func SemanticAstCollectionExclusiveValueFactsFrom(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts, ref assignments: SemanticAstAssignmentFacts,
    ref statements: SemanticAstStatementFacts
) -> SemanticAstCollectionExclusiveValueFacts {
    let starts: HashMap<String, Int> = MapNew();
    let ends: HashMap<String, Int> = MapNew();
    SemanticAstCollectionExclusiveSurfaceRanges(artifact, surfaces, starts, ends);
    let shared_results: HashMap<String, Int> = MapNew();
    let carrying: HashMap<String, Int> = MapNew();
    let shared_locals: HashMap<String, Int> = MapNew();
    let dep_locals: Array<Int> = [];
    let dep_formals: Array<Int> = [];
    let dep_paths: Array<Int> = [];
    let paths: Array<String> = [];
    let consumed_uses: HashMap<String, Int> = MapNew();
    let empty_locals: HashMap<String, Int> = SemanticAstCollectionExclusiveEmptyLocals(
        artifact, signatures, locals, inferred_types, surfaces, assignments, statements);
    let field_reads: HashMap<String, Int> = SemanticAstCollectionExclusiveFieldReads(artifact, signatures, surfaces);
    let no_copies: HashMap<String, Int> = MapNew();
    let facts: SemanticAstCollectionExclusiveValueFacts = SemanticAstCollectionExclusiveValueFacts(
        false, shared_results, carrying, shared_locals, dep_locals, dep_formals, dep_paths, paths, starts, ends, consumed_uses,
        empty_locals, field_reads, no_copies);
    if !locals.ok || !assignments.ok || !statements.ok ||
        ArrayLength(inferred_types) != ArrayLength(locals.node_ids) ||
        MapHas(field_reads, "unconverged") { return facts; }
    // A definition of a place no path reads aliases nothing.
    let dead_definitions: HashMap<String, Int> = MapNew();
    let dead_row: Int = 0;
    while dead_row < ArrayLength(locals.node_ids) {
        let dead_function: String = ToString(locals.function_node_ids[dead_row]);
        let dead_value: Option<Int> = SemanticAstExpressionGraphRootForNode(
            surfaces, locals.node_ids[dead_row], AstExpressionLaneValue());
        if !SemanticAstCollectionExclusiveUntrackedType(inferred_types[dead_row]) && IsSome(dead_value) &&
            MapHas(starts, dead_function) && MapHas(ends, dead_function) && MapGet(starts, dead_function) >= 0 {
            let source: SemanticAstCollectionAggregateSinkPlace = SemanticAstCollectionAggregateSinkPlaceForNode(
                artifact, signatures, locals, inferred_types, surfaces, locals.function_node_ids[dead_row],
                locals.node_ids[dead_row], UnwrapOption(dead_value));
            if source.ok && !source.temporary && SemanticAstCollectionExclusiveDefinitionDead(artifact, signatures,
                    locals, inferred_types, surfaces, locals.function_node_ids[dead_row],
                    MapGet(starts, dead_function), MapGet(ends, dead_function), locals.node_ids[dead_row]) {
                MapSet(dead_definitions, ToString(locals.node_ids[dead_row]), 1);
            }
        }
        dead_row = dead_row + 1;
    }
    // Whole-local assignment targets, resolved once.
    let assigned_rows: Array<Int> = [];
    let assigned_formals: Array<Int> = [];
    let row: Int = 0;
    while row < ArrayLength(assignments.node_ids) {
        let target_row: Int = -1;
        let target_formal: Int = 0;
        let target: Option<Int> = SemanticAstExpressionGraphRootForNode(
            surfaces, assignments.node_ids[row], AstExpressionLaneAtom());
        if IsSome(target) && assignments.target_is_indexed[row] == 0 {
            let written: SemanticAstCollectionAggregateSinkPlace = SemanticAstCollectionAggregateSinkPlaceForNode(
                artifact, signatures, locals, inferred_types, surfaces, assignments.function_node_ids[row],
                assignments.node_ids[row], UnwrapOption(target));
            if written.ok && !written.temporary && written.key >= 0 && ArrayLength(written.chain) == 0 {
                target_row = written.key;
            }
            if written.ok && !written.temporary && written.key < 0 && ArrayLength(written.chain) == 0 {
                target_formal = 0 - written.key;
            }
        }
        ArrayPush(assigned_rows, target_row);
        ArrayPush(assigned_formals, target_formal);
        row = row + 1;
    }
    let consumed: HashMap<String, Int> = facts.consumed;
    let copied: HashMap<String, Int> = MapNew();
    let edges_seen: Int = 0;
    let bound: Int = ArrayLength(signatures.function_node_ids) + ArrayLength(locals.node_ids) + 2;
    let changed: Bool = true;
    let round: Int = 0;
    while changed && round < bound {
        changed = false;
        let local_row: Int = 0;
        while local_row < ArrayLength(locals.node_ids) {
            if !SemanticAstCollectionExclusiveUntrackedType(inferred_types[local_row]) &&
                !MapHas(dead_definitions, ToString(locals.node_ids[local_row])) {
                let value: Option<Int> = SemanticAstExpressionGraphRootForNode(
                    surfaces, locals.node_ids[local_row], AstExpressionLaneValue());
                if IsSome(value) {
                    let part: SemanticAstCollectionExclusiveClass = SemanticAstCollectionExclusiveClassify(
                        artifact, signatures, constructors, locals, inferred_types, surfaces, assignments,
                        facts.shared_results, facts.carrying, facts.shared_locals, facts.dep_locals,
                        facts.dep_formals, facts.dep_paths, facts.paths, starts, ends, consumed, copied, facts.empty_locals, facts.field_reads,
                        locals.function_node_ids[local_row],
                        locals.node_ids[local_row], UnwrapOption(value), true, 0, locals.node_ids[local_row]);
                    if SemanticAstCollectionExclusiveRecordLocal(facts, locals.node_ids[local_row], part) {
                        changed = true;
                    }
                }
            }
            local_row = local_row + 1;
        }
        row = 0;
        while row < ArrayLength(assignments.node_ids) {
            let target_row: Int = assigned_rows[row];
            let target_id: Int = assigned_formals[row];
            if target_row >= 0 && !SemanticAstCollectionExclusiveUntrackedType(inferred_types[target_row]) {
                target_id = locals.node_ids[target_row];
            }
            if target_id > 0 {
                let value: Option<Int> = SemanticAstExpressionGraphRootForNode(
                    surfaces, assignments.node_ids[row], AstExpressionLaneValue());
                let part: SemanticAstCollectionExclusiveClass = SemanticAstCollectionExclusiveShared();
                if IsSome(value) {
                    part = SemanticAstCollectionExclusiveClassify(
                        artifact, signatures, constructors, locals, inferred_types, surfaces, assignments,
                        facts.shared_results, facts.carrying, facts.shared_locals, facts.dep_locals,
                        facts.dep_formals, facts.dep_paths, facts.paths, starts, ends, consumed, copied, facts.empty_locals, facts.field_reads,
                        assignments.function_node_ids[row],
                        assignments.node_ids[row], UnwrapOption(value), true, 0, target_id);
                }
                if SemanticAstCollectionExclusiveRecordLocal(facts, target_id, part) {
                    changed = true;
                }
            }
            row = row + 1;
        }
        row = 0;
        while row < ArrayLength(statements.node_ids) {
            if statements.kind_tags[row] == TypedAstKindValueReturnStmtTag() {
                let function_id: Int = statements.function_node_ids[row];
                let signature: Option<Int> = SemanticAstFunctionSignatureIndexForNode(signatures, function_id);
                if IsSome(signature) &&
                    !SemanticAstCollectionExclusiveUntrackedType(signatures.return_types[UnwrapOption(signature)]) {
                    // A return carries its value in the Atom lane.
                    let value: Option<Int> = SemanticAstExpressionGraphRootForNode(
                        surfaces, statements.node_ids[row], AstExpressionLaneAtom());
                    let part: SemanticAstCollectionExclusiveClass = SemanticAstCollectionExclusiveShared();
                    if IsSome(value) {
                        part = SemanticAstCollectionExclusiveClassify(
                            artifact, signatures, constructors, locals, inferred_types, surfaces, assignments,
                            facts.shared_results, facts.carrying, facts.shared_locals, facts.dep_locals,
                            facts.dep_formals, facts.dep_paths, facts.paths, starts, ends, consumed, copied, facts.empty_locals, facts.field_reads, function_id,
                            statements.node_ids[row], UnwrapOption(value), false, 0, 0);
                    }
                    if SemanticAstCollectionExclusiveRecordReturn(facts, function_id, part) { changed = true; }
                }
            }
            row = row + 1;
        }
        let copies: Array<String> = MapKeys(copied);
        let shared_rows: HashMap<String, Int> = facts.shared_locals;
        let copy: Int = 0;
        while copy < ArrayLength(copies) {
            let shared_key: String = Substring(copies[copy], 2, StringLength(copies[copy]) - 2);
            if StartsWith(copies[copy], "s:") && !MapHas(shared_rows, shared_key) {
                MapSet(shared_rows, shared_key, 1);
                changed = true;
            }
            copy = copy + 1;
        }
        facts.shared_locals = shared_rows;
        // New copy edges add readers: proofs that read them are redone.
        let edge_count: Int = SemanticAstCollectionExclusiveCopyCount(copied, "edges");
        if edge_count != edges_seen {
            edges_seen = edge_count;
            changed = true;
        }
        round = round + 1;
    }
    facts.consumed = consumed;
    facts.copies = copied;
    facts.ok = !changed;
    return facts;
}
