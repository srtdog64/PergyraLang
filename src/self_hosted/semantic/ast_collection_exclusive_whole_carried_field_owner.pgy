// Whole-carried formal field classification.

import "ast_collection_exclusive_value_class_owner.pgy";
import "ast_expression_graph_collection_call_protocol_owner.pgy";
import "ast_collection_exclusive_value_dead_definition_owner.pgy";
import "ast_expression_graph_call_view_owner.pgy";
import "ast_expression_graph_array_literal_owner.pgy";
import "ast_nominal_constructor_lookup_owner.pgy";
import "ast_collection_ownership_state_owner.pgy";
import "ast_type_name_canonical_owner.pgy";
import "ast_collection_exclusive_copy_site_projection_owner.pgy";

func SemanticAstCollectionExclusivePlacesOverlap(
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref left: SemanticAstCollectionAggregateSinkPlace, ref right: SemanticAstCollectionAggregateSinkPlace
) -> Bool {
    if !left.ok || !right.ok || left.temporary || right.temporary || left.key != right.key { return false; }
    var shorter: Int = ArrayLength(left.chain);
    if ArrayLength(right.chain) < shorter { shorter = ArrayLength(right.chain); }
    var index: Int = 0;
    while index < shorter {
        let a: Option<String> = SemanticExpressionGraphNodeText(surfaces.expression_graph, left.chain[index]);
        let b: Option<String> = SemanticExpressionGraphNodeText(surfaces.expression_graph, right.chain[index]);
        if !IsSome(a) || !IsSome(b) || UnwrapOption(a) != UnwrapOption(b) { return false; }
        index = index + 1;
    }
    return true;
}

struct SemanticAstCollectionExclusiveWholeCarriedField {
    ok: Bool;
    field: String;
}

// A path-insensitive formal may contain its initial whole dependency plus a
// later exact field-by-field self reconstruction. For storage ownership those
// rows still denote one whole formal, but only when every tracked field maps
// to itself exactly once and no other formal or shared field participates.
func SemanticAstCollectionExclusiveCollapseWholeFormalClass(
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    inout part: SemanticAstCollectionExclusiveClass
) -> Bool {
    if !part.exclusive || ArrayLength(part.shared_fields) != 0 ||
        ArrayLength(part.deps) == 0 ||
        ArrayLength(part.deps) != ArrayLength(part.dep_fields) ||
        ArrayLength(part.deps) != ArrayLength(part.dep_sources) ||
        ArrayLength(signatures.param_node_ids) !=
            ArrayLength(signatures.param_types) {
        return false;
    }
    let formal_id: Int = part.deps[0];
    var parameter_matches: Int = 0;
    var parameter_type: String = "";
    var parameter: Int = 0;
    while parameter < ArrayLength(signatures.param_node_ids) {
        if signatures.param_node_ids[parameter] == formal_id {
            parameter_matches = parameter_matches + 1;
            parameter_type = Concat("", signatures.param_types[parameter]);
        }
        parameter = parameter + 1;
    }
    if formal_id <= 0 || parameter_matches != 1 {
        return false;
    }
    let canonical: SemanticCanonicalTypeNameFact =
        SemanticCanonicalTypeNameFactFrom(parameter_type);
    if canonical.canonical_name == "" || canonical.canonical_name !=
            canonical.nominal_base_name {
        return false;
    }
    let constructor: Option<Int> =
        SemanticAstNominalConstructorIndexForName(
            constructors, canonical.nominal_base_name);
    if !IsSome(constructor) { return false; }
    let constructor_row: Int = UnwrapOption(constructor);
    if constructor_row < 0 ||
        constructor_row >= ArrayLength(constructors.param_starts) ||
        constructor_row >= ArrayLength(constructors.param_counts) {
        return false;
    }
    let start: Int = constructors.param_starts[constructor_row];
    let count: Int = constructors.param_counts[constructor_row];
    if start < 0 || count < 0 ||
        start + count > ArrayLength(constructors.field_names) ||
        start + count > ArrayLength(constructors.param_type_names) {
        return false;
    }
    var whole_rows: Int = 0;
    var dependency: Int = 0;
    while dependency < ArrayLength(part.deps) {
        if part.deps[dependency] != formal_id { return false; }
        if part.dep_fields[dependency] == "" &&
            part.dep_sources[dependency] == "" {
            whole_rows = whole_rows + 1;
        }
        dependency = dependency + 1;
    }
    if whole_rows > 1 { return false; }
    var tracked: Int = 0;
    var field_index: Int = 0;
    while field_index < count {
        let field_row: Int = start + field_index;
        if !SemanticAstCollectionExclusiveUntrackedType(
                constructors.param_type_names[field_row]) {
            let field_name: String = constructors.field_names[field_row];
            var matches: Int = 0;
            dependency = 0;
            while dependency < ArrayLength(part.deps) {
                if part.dep_fields[dependency] == field_name &&
                    part.dep_sources[dependency] == field_name {
                    matches = matches + 1;
                }
                dependency = dependency + 1;
            }
            if matches != 1 { return false; }
            tracked = tracked + 1;
        }
        field_index = field_index + 1;
    }
    if tracked <= 0 || ArrayLength(part.deps) != tracked + whole_rows {
        return false;
    }
    var collapsed: SemanticAstCollectionExclusiveClass =
        SemanticAstCollectionExclusiveFresh();
    SemanticAstCollectionExclusiveAddDep(
        collapsed, formal_id, "", "");
    part = collapsed;
    return true;
}

// A callee may carry every tracked field of one aggregate formal either into
// one result field or into the same-named field of the result value. The
// former returns that field name; the latter returns an empty field with
// `ok=true`, denoting one whole-value transfer. Collapse only an exact,
// duplicate-free cover; partial, crossed and unknown summaries stay split.
func SemanticAstCollectionExclusiveWholeCarriedFieldForFormal(
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    carrying: HashMap<String, Int>, ref paths: Array<String>,
    ref formal: SemanticAstCollectionArgumentFormalTarget
) -> SemanticAstCollectionExclusiveWholeCarriedField {
    let invalid: SemanticAstCollectionExclusiveWholeCarriedField =
        SemanticAstCollectionExclusiveWholeCarriedField(false, "");
    if !formal.ok || formal.signature_row < 0 ||
        formal.signature_row >= ArrayLength(signatures.param_starts) ||
        formal.ordinal < 0 ||
        formal.ordinal >= signatures.param_counts[formal.signature_row] {
        return invalid;
    }
    let parameter: Int = signatures.param_starts[formal.signature_row] +
        formal.ordinal;
    if parameter < 0 || parameter >= ArrayLength(signatures.param_types) {
        return invalid;
    }
    let canonical: SemanticCanonicalTypeNameFact =
        SemanticCanonicalTypeNameFactFrom(signatures.param_types[parameter]);
    if canonical.canonical_name == "" || canonical.canonical_name !=
            canonical.nominal_base_name {
        return invalid;
    }
    let constructor: Option<Int> =
        SemanticAstNominalConstructorIndexForName(
            constructors, canonical.nominal_base_name);
    if !IsSome(constructor) { return invalid; }
    let constructor_row: Int = UnwrapOption(constructor);
    if constructor_row < 0 ||
        constructor_row >= ArrayLength(constructors.param_starts) ||
        constructor_row >= ArrayLength(constructors.param_counts) {
        return invalid;
    }
    let start: Int = constructors.param_starts[constructor_row];
    let count: Int = constructors.param_counts[constructor_row];
    if start < 0 || count < 0 ||
        start + count > ArrayLength(constructors.field_names) ||
        start + count > ArrayLength(constructors.param_type_names) {
        return invalid;
    }
    let formal_key: String = ToString(formal.syntax_id);
    let carried_count: Int = SemanticAstCollectionExclusiveCopyCount(
        carrying, Concat("cn:", formal_key));
    if carried_count <= 0 { return invalid; }
    var checked: Int = 0;
    while checked < carried_count {
        let checked_path: Int = MapGet(
            carrying, Concat("ci:", Concat(formal_key,
                Concat(":", ToString(checked)))));
        if checked_path < 0 || checked_path >= ArrayLength(paths) / 2 {
            return invalid;
        }
        checked = checked + 1;
    }
    // An identity-wide pack is the formal itself. It must contain every
    // tracked field exactly once at the same destination, with at most one
    // redundant whole-value row and no other carrying row.
    var identity: Bool = true;
    var identity_whole_rows: Int = 0;
    var identity_carried: Int = 0;
    while identity_carried < carried_count {
        let identity_path: Int = MapGet(
            carrying, Concat("ci:", Concat(formal_key,
                Concat(":", ToString(identity_carried)))));
        let identity_destination: String = paths[2 * identity_path];
        let identity_source: String = paths[2 * identity_path + 1];
        if identity_source == "" {
            if identity_destination != "" { identity = false; }
            else { identity_whole_rows = identity_whole_rows + 1; }
        } else if identity_destination != identity_source {
            identity = false;
        }
        identity_carried = identity_carried + 1;
    }
    if identity_whole_rows > 1 { identity = false; }
    var identity_tracked: Int = 0;
    var identity_field_index: Int = 0;
    while identity_field_index < count {
        let identity_row: Int = start + identity_field_index;
        if !SemanticAstCollectionExclusiveUntrackedType(
                constructors.param_type_names[identity_row]) {
            let identity_field: String =
                constructors.field_names[identity_row];
            var identity_matches: Int = 0;
            identity_carried = 0;
            while identity_carried < carried_count {
                let identity_path: Int = MapGet(
                    carrying, Concat("ci:", Concat(formal_key,
                        Concat(":", ToString(identity_carried)))));
                if paths[2 * identity_path] == identity_field &&
                    paths[2 * identity_path + 1] == identity_field {
                    identity_matches = identity_matches + 1;
                }
                identity_carried = identity_carried + 1;
            }
            if identity_matches != 1 { identity = false; }
            identity_tracked = identity_tracked + 1;
        }
        identity_field_index = identity_field_index + 1;
    }
    if identity && identity_tracked > 0 &&
        carried_count == identity_tracked + identity_whole_rows {
        return SemanticAstCollectionExclusiveWholeCarriedField(true, "");
    }
    var result_field: String = "";
    var whole_rows: Int = 0;
    var carried: Int = 0;
    while carried < carried_count {
        let path: Int = MapGet(
            carrying, Concat("ci:", Concat(formal_key,
                Concat(":", ToString(carried)))));
        if paths[2 * path + 1] == "" {
            if paths[2 * path] == "" ||
                (result_field != "" && result_field != paths[2 * path]) {
                return invalid;
            }
            result_field = Concat("", paths[2 * path]);
            whole_rows = whole_rows + 1;
        }
        carried = carried + 1;
    }
    if whole_rows > 1 { return invalid; }
    var tracked: Int = 0;
    var field_index: Int = 0;
    while field_index < count {
        let row: Int = start + field_index;
        if !SemanticAstCollectionExclusiveUntrackedType(
                constructors.param_type_names[row]) {
            let source_field: String = constructors.field_names[row];
            var matches: Int = 0;
            carried = 0;
            while carried < carried_count {
                let path: Int = MapGet(
                    carrying, Concat("ci:", Concat(formal_key,
                        Concat(":", ToString(carried)))));
                if path < 0 || path >= ArrayLength(paths) / 2 {
                    return invalid;
                }
                if paths[2 * path + 1] == source_field {
                    if paths[2 * path] == "" ||
                        (result_field != "" &&
                         result_field != paths[2 * path]) {
                        return invalid;
                    }
                    result_field = Concat("", paths[2 * path]);
                    matches = matches + 1;
                }
                carried = carried + 1;
            }
            if matches != 1 { return invalid; }
            tracked = tracked + 1;
        }
        field_index = field_index + 1;
    }
    if tracked <= 0 || result_field == "" { return invalid; }
    if carried_count != tracked + whole_rows {
        return invalid;
    }
    return SemanticAstCollectionExclusiveWholeCarriedField(
        true, result_field);
}

