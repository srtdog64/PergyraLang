// Generation-bound execution-context facts and shared control predicates.
import "ast_collection_formal_effect_identity_owner.pgy";
import "ast_function_scope_fact_owner.pgy";
import "ast_statement_fact_owner.pgy";

struct SemanticAstCollectionFormalExecutionContexts {
    ok: Bool;
    artifact_identity_digest: Int;
    artifact_node_count: Int;
    candidate_functions: HashMap<String, Int>;
    unsafe_functions: HashMap<String, Int>;
}
// Borrow the two row sets directly. LLVM map receivers require named formals;
// copying a ref record's descriptors into locals would extend their borrow.
// This lookup alone is not permission: the generation guard below owns that.
func SemanticAstCollectionFormalExecutionContextCallableRowsObserved(
    ref candidates: HashMap<String, Int>,
    ref unsafe_functions: HashMap<String, Int>, function_id: Int
) -> Bool {
    if function_id <= 0 { return false; }
    let key: String = ToString(function_id);
    return MapHas(candidates, key) && !MapHas(unsafe_functions, key);
}
// Absence from the unsafe set proves nothing without current-generation
// candidate coverage. This owns the permission lookup for every consumer.
func SemanticAstCollectionFormalExecutionContextCallableReady(
    ref artifact: AstTreeArtifact,
    ref contexts: SemanticAstCollectionFormalExecutionContexts,
    function_id: Int
) -> Bool {
    if !contexts.ok || artifact.identity_digest <= 0 ||
        contexts.artifact_identity_digest != artifact.identity_digest ||
        contexts.artifact_node_count != artifact.count ||
        function_id <= 0 || function_id >= artifact.count { return false; }
    return SemanticAstCollectionFormalExecutionContextCallableRowsObserved(
        contexts.candidate_functions, contexts.unsafe_functions, function_id);
}

// The callable body is not a synchronous, fully observed effect program.
// Calls carrying an Array<String> across this boundary must fail closed.
func SemanticAstCollectionFormalOpaqueExecutionEffect() -> Int { return 4; }

// One shared predicate owns the control forms that prevent a lexical call
// site from proving one unconditional synchronous effect. Aggregate field
// transitions and leaf-formal receipts must agree on this boundary.
func SemanticAstCollectionSynchronousStraightLineControlKind(
    kind: Int
) -> Bool {
    return kind == TypedAstKindForStmtTag() ||
        kind == TypedAstKindWhileStmtTag() ||
        kind == TypedAstKindIfStmtTag() ||
        kind == TypedAstKindElseStmtTag() ||
        kind == TypedAstKindDeferStmtTag() ||
        kind == TypedAstKindBreakStmtTag() ||
        kind == TypedAstKindContinueStmtTag() ||
        kind == TypedAstKindMatchStmtTag() ||
        kind == TypedAstKindMatchCaseStmtTag() ||
        kind == TypedAstKindMatchDefaultStmtTag() ||
        kind == TypedAstKindBareReturnStmtTag() ||
        kind == TypedAstKindValueReturnStmtTag() ||
        kind == TypedAstKindExitStmtTag() ||
        kind == TypedAstKindFailStmtTag();
}

func SemanticAstCollectionSynchronousStraightLineFunction(
    ref statements: SemanticAstStatementFacts, function_id: Int
) -> Bool {
    let count: Int = ArrayLength(statements.node_ids);
    if !statements.ok || function_id <= 0 ||
        ArrayLength(statements.kind_tags) != count ||
        ArrayLength(statements.function_node_ids) != count {
        return false;
    }
    let row: Int = 0;
    while row < count {
        if statements.function_node_ids[row] == function_id &&
            SemanticAstCollectionSynchronousStraightLineControlKind(
                statements.kind_tags[row]) { return false; }
        row = row + 1;
    }
    return true;
}

// Build the negative set once for compiler-scale formal inventories. Calling
// the full statement scan once per candidate is quadratic in program size.
func SemanticAstCollectionNonStraightLineFunctions(
    ref statements: SemanticAstStatementFacts
) -> HashMap<String, Int> {
    let functions: HashMap<String, Int> = MapNew();
    let count: Int = ArrayLength(statements.node_ids);
    if !statements.ok ||
        ArrayLength(statements.kind_tags) != count ||
        ArrayLength(statements.function_node_ids) != count {
        return functions;
    }
    let row: Int = 0;
    while row < count {
        if SemanticAstCollectionSynchronousStraightLineControlKind(
                statements.kind_tags[row]) {
            MapSet(functions,
                ToString(statements.function_node_ids[row]), 1);
        }
        row = row + 1;
    }
    return functions;
}
func SemanticAstCollectionFormalEffectSyntaxIsDeferred(ref artifact: AstTreeArtifact,
    syntax_id: Int) -> Bool {
    if syntax_id < 0 || syntax_id >= artifact.count ||
        ArrayLength(artifact.arena.parents) != artifact.count ||
        ArrayLength(artifact.arena.kinds) != artifact.count { return true; }
    let ancestor: Int = syntax_id;
    let remaining: Int = artifact.count;
    while ancestor >= 0 && remaining > 0 {
        if ancestor >= artifact.count { return true; }
        let kind: Int = artifact.arena.kinds[ancestor];
        if kind == TypedAstKindDeferStmtTag() ||
            kind == TypedAstKindParallelBlockTag() ||
            kind == TypedAstKindAsyncBlockTag() {
            return true;
        }
        let parent: Int = artifact.arena.parents[ancestor];
        if parent < 0 { return false; }
        ancestor = parent;
        remaining = remaining - 1;
    }
    return true;
}
