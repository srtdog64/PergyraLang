// Recursive formal-effect closure over reverse physical-use adjacency. Every
// scratch collection is owned and retired inside this boundary.
import "ast_collection_formal_effect_graph_owner.pgy";

func SemanticAstCollectionFormalEffectResolveRecursive(
    ref incoming_heads: Array<Int>, ref next_edges: Array<Int>,
    ref inventory: SemanticAstCollectionFormalEffectInventory,
    ref local_blocked: Array<Bool>, ref local_mutations: Array<Bool>,
    ref local_shallow: Array<Bool>, ref local_reads: Array<Bool>,
    ref sources: Array<Int>,
    inout effects: HashMap<String, Int>,
    inout status: SemanticAstCollectionFormalEffectResolutionStatus
) -> Void {
    if !status.ok { return; }
    let count: Int = ArrayLength(inventory.formal_nodes);
    if ArrayLength(local_blocked) != count ||
        ArrayLength(local_mutations) != count ||
        ArrayLength(local_shallow) != count ||
        ArrayLength(local_reads) != count ||
        ArrayLength(incoming_heads) != count ||
        ArrayLength(next_edges) != ArrayLength(sources) {
        status.ok = false; return;
    }

    let grounded: Array<Bool> = [];
    let blocked: Array<Bool> = [];
    let mutations: Array<Bool> = [];
    let shallow: Array<Bool> = [];
    let reads: Array<Bool> = [];
    let opaque: Array<Bool> = [];
    let unproved: Array<Bool> = [];
    let unresolved: Array<Bool> = [];
    let pending: Array<Bool> = [];
    let queue: Array<Int> = [];
    let row: Int = 0;
    while row < count {
        let key: String = ToString(inventory.formal_nodes[row]);
        let has_effect: Bool = MapHas(effects, key);
        let effect: Int = 0;
        if has_effect {
            effect = MapGet(effects, key);
            if effect < 1 || effect > 6 { status.ok = false; }
        }
        ArrayPush(grounded, false); ArrayPush(blocked, false);
        ArrayPush(mutations, false); ArrayPush(shallow, false);
        ArrayPush(reads, false); ArrayPush(opaque, false);
        ArrayPush(unproved, false);
        ArrayPush(unresolved, false);
        ArrayPush(pending, false);
        // Materialize borrowed inputs through scalar control flow. The local
        // worklists own literals, never elements retained from caller arrays.
        if has_effect || local_mutations[row] || local_shallow[row] ||
            local_reads[row] { grounded[row] = true; }
        if local_blocked[row] { blocked[row] = true; }
        if local_mutations[row] || effect == 2 { mutations[row] = true; }
        if local_shallow[row] ||
            effect == SemanticAstCollectionFormalShallowMutationEffect() {
            shallow[row] = true;
        }
        if local_reads[row] || effect == 3 { reads[row] = true; }
        if effect == SemanticAstCollectionFormalOpaqueExecutionEffect() {
            opaque[row] = true;
        }
        if effect == SemanticAstCollectionFormalUnprovedElementUseEffect() {
            unproved[row] = true;
        }
        row = row + 1;
    }
    row = 0;
    while row < count {
        if grounded[row] || blocked[row] || mutations[row] || shallow[row] ||
            reads[row] || opaque[row] || unproved[row] {
            pending[row] = true;
            ArrayPush(queue, row);
        }
        row = row + 1;
    }
    let cursor: Int = 0;
    let edge: Int = 0;
    while status.ok && cursor < ArrayLength(queue) {
        let target: Int = queue[cursor];
        pending[target] = false;
        edge = incoming_heads[target];
        while edge >= 0 {
            let source: Int = sources[edge];
            let changed: Bool = false;
            if grounded[target] && !grounded[source] {
                grounded[source] = true; changed = true;
            }
            if blocked[target] && !blocked[source] {
                blocked[source] = true; changed = true;
            }
            if mutations[target] && !mutations[source] {
                mutations[source] = true; changed = true;
            }
            if shallow[target] && !shallow[source] {
                shallow[source] = true; changed = true;
            }
            if reads[target] && !reads[source] {
                reads[source] = true; changed = true;
            }
            if opaque[target] && !opaque[source] {
                opaque[source] = true; changed = true;
            }
            if unproved[target] && !unproved[source] {
                unproved[source] = true; changed = true;
            }
            if changed && !pending[source] {
                pending[source] = true;
                ArrayPush(queue, source);
            }
            edge = next_edges[edge];
        }
        cursor = cursor + 1;
    }

    let unresolved_queue: Array<Int> = [];
    row = 0;
    while row < count {
        unresolved[row] = !grounded[row];
        if unresolved[row] { ArrayPush(unresolved_queue, row); }
        row = row + 1;
    }
    cursor = 0;
    while status.ok && cursor < ArrayLength(unresolved_queue) {
        let target: Int = unresolved_queue[cursor];
        edge = incoming_heads[target];
        while edge >= 0 {
            let source: Int = sources[edge];
            if !unresolved[source] {
                unresolved[source] = true;
                ArrayPush(unresolved_queue, source);
            }
            edge = next_edges[edge];
        }
        cursor = cursor + 1;
    }
    row = 0;
    while status.ok && row < count {
        let key: String = ToString(inventory.formal_nodes[row]);
        if grounded[row] && !unresolved[row] && !MapHas(effects, key) {
            let row_blocked: Bool = blocked[row];
            let row_mutation: Bool = mutations[row];
            let row_shallow: Bool = shallow[row];
            let row_read: Bool = reads[row];
            let row_opaque: Bool = opaque[row];
            let row_unproved: Bool = unproved[row];
            let resolved: Option<Int> = SemanticAstCollectionFormalEffectFromFlags(
                row_blocked, row_mutation, row_shallow, row_read,
                row_opaque, row_unproved);
            if IsSome(resolved) {
                MapSet(effects, key, UnwrapOption(resolved));
            }
        }
        row = row + 1;
    }
    ArrayDrop(grounded); ArrayDrop(blocked); ArrayDrop(mutations);
    ArrayDrop(shallow); ArrayDrop(reads); ArrayDrop(opaque);
    ArrayDrop(unproved); ArrayDrop(unresolved); ArrayDrop(pending);
    ArrayDrop(queue); ArrayDrop(unresolved_queue);
}
