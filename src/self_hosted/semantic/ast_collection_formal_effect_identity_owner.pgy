// Exact formal inventory and source-argument joins; no lifetime permission.
import "ast_collection_ownership_identity_owner.pgy";
import "ast_callable_receiver_source_parameter_owner.pgy";
import "ast_type_name_canonical_owner.pgy";

struct SemanticAstCollectionFormalEffectInventory {
    ok: Bool;
    formal_nodes: Array<Int>;
    function_nodes: Array<Int>;
    ordinals: Array<Int>;
    modes: Array<Int>;
    body_ready: Array<Bool>;
    row_by_formal: HashMap<String, Int>;
}

struct SemanticAstCollectionArgumentFormalTarget {
    ok: Bool;
    syntax_id: Int;
    signature_row: Int;
    ordinal: Int;
}

func SemanticAstCollectionFormalUnprovedElementUseEffect() -> Int {
    return 5;
}

func SemanticAstCollectionFormalShallowMutationEffect() -> Int {
    return 6;
}

// A typed inventory domain, not storage, retention or freshness permission.
func SemanticAstCollectionFormalScalarMapType(type_name: String) -> Bool {
    let shape: SemanticConstructedTypeNameFact = SemanticConstructedTypeNameFactFrom(type_name);
    return shape.ok && shape.nominal_base_name == "HashMap" &&
        ArrayLength(shape.actual_type_names) == 2 &&
        shape.actual_type_names[0] == "String" && shape.actual_type_names[1] == "Int";
}

func SemanticAstCollectionFormalEffectTrackedType(type_name: String) -> Bool {
    return SemanticAstCollectionOwnershipIsStringSequence(type_name) ||
        SemanticAstCollectionFormalScalarMapType(type_name);
}


func SemanticAstCollectionFormalEffectInventoryFromSignatures(
    ref signatures: SemanticAstFunctionSignatureFacts
) -> SemanticAstCollectionFormalEffectInventory {
    let nodes: Array<Int> = [];
    let functions: Array<Int> = [];
    let ordinals: Array<Int> = [];
    let modes: Array<Int> = [];
    let bodies: Array<Bool> = [];
    let rows: HashMap<String, Int> = MapNew();
    let count: Int = ArrayLength(signatures.function_node_ids);
    let flat_count: Int = ArrayLength(signatures.param_node_ids);
    let ok: Bool = signatures.ok && signatures.action_contracts.ok &&
        ArrayLength(signatures.param_starts) == count &&
        ArrayLength(signatures.param_counts) == count &&
        ArrayLength(signatures.action_contracts.callable_node_ids) == count &&
        ArrayLength(signatures.action_contracts.body_node_ids) == count &&
        ArrayLength(signatures.param_types) == flat_count &&
        ArrayLength(signatures.param_modes) == flat_count;
    let row: Int = 0;
    let flat: Int = 0;
    while ok && row < count {
        let function: Int = signatures.function_node_ids[row];
        let size: Int = signatures.param_counts[row];
        if function <= 0 || signatures.param_starts[row] != flat || size < 0 ||
            size > flat_count - flat ||
            signatures.action_contracts.callable_node_ids[row] != function {
            ok = false; break;
        }
        let ordinal: Int = 0;
        while ok && ordinal < size {
            let node: Int = signatures.param_node_ids[flat + ordinal];
            let mode: Int = signatures.param_modes[flat + ordinal];
            if node <= 0 || mode < 0 || mode > 3 { ok = false; break; }
            if SemanticAstCollectionFormalEffectTrackedType(
                    signatures.param_types[flat + ordinal]) {
                let key: String = ToString(node);
                if MapHas(rows, key) { ok = false; break; }
                MapSet(rows, key, ArrayLength(nodes));
                ArrayPush(nodes, node);
                ArrayPush(functions, function);
                ArrayPush(ordinals, ordinal);
                ArrayPush(modes, mode);
                // Body availability is independent of the parameter mode.
                // Consumption permission is proved at the caller and ordered use.
                ArrayPush(bodies,
                    signatures.action_contracts.body_node_ids[row] > 0);
            }
            ordinal = ordinal + 1;
        }
        flat = flat + size;
        row = row + 1;
    }
    ok = ok && flat == flat_count;
    return SemanticAstCollectionFormalEffectInventory(
        ok, nodes, functions, ordinals, modes, bodies, rows);
}

func SemanticAstCollectionArgumentFormalTargetForArgument(
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref graph: SemanticExpressionGraphFacts,
    call_node: Int, argument_ordinal: Int
) -> SemanticAstCollectionArgumentFormalTarget {
    let missing: SemanticAstCollectionArgumentFormalTarget =
        SemanticAstCollectionArgumentFormalTarget(false, 0, -1, -1);
    let target: Option<Int> = SemanticExpressionGraphCallTargetSyntaxId(graph, call_node);
    let kind: Option<Int> = SemanticExpressionGraphCallTargetKind(graph, call_node);
    if !IsSome(target) || UnwrapOption(target) <= 0 ||
        !IsSome(kind) || argument_ordinal < 0 { return missing; }
    let signature: Option<Int> = SemanticAstFunctionSignatureIndexForNode(
        signatures, UnwrapOption(target));
    if !IsSome(signature) { return missing; }
    let row: Int = UnwrapOption(signature);
    if !signatures.ok || !graph.ok || row < 0 ||
        row >= ArrayLength(signatures.function_node_ids) || row >= ArrayLength(signatures.names) ||
        row >= ArrayLength(signatures.param_starts) || row >= ArrayLength(signatures.param_counts) ||
        row >= ArrayLength(signatures.action_contracts.body_node_ids) { return missing; }
    let start: Int = signatures.param_starts[row];
    let count: Int = signatures.param_counts[row];
    if start < 0 || count < 0 || start > ArrayLength(signatures.param_node_ids) ||
        count > ArrayLength(signatures.param_node_ids) - start ||
        start > ArrayLength(signatures.param_types) || count > ArrayLength(signatures.param_types) - start ||
        start > ArrayLength(signatures.param_modes) || count > ArrayLength(signatures.param_modes) - start { return missing; }
    let offset: Int = 0;
    if UnwrapOption(kind) == SemanticCallTargetMember() {
        // Borrow the source-signature offset row; a projected name is not self.
        if ArrayLength(signatures.receiver_source_param_offsets) !=
                ArrayLength(signatures.function_node_ids) { return missing; }
        offset = signatures.receiver_source_param_offsets[row];
        if offset < 0 || offset > 1 || offset > signatures.param_counts[row] {
            return missing;
        }
    }
    let ordinal: Int = argument_ordinal + offset;
    let node: Option<Int> = SemanticAstFunctionParamNodeAt(signatures, row, ordinal);
    if !IsSome(node) || UnwrapOption(node) <= 0 { return missing; }
    return SemanticAstCollectionArgumentFormalTarget(
        true, UnwrapOption(node), row, ordinal);
}

func SemanticAstCollectionSourceArrayFormalForArgument(
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref graph: SemanticExpressionGraphFacts,
    call_node: Int, argument_ordinal: Int
) -> Int {
    let target: SemanticAstCollectionArgumentFormalTarget =
        SemanticAstCollectionArgumentFormalTargetForArgument(
            signatures, graph, call_node, argument_ordinal);
    if !target.ok { return 0; }
    let type_name: Option<String> = SemanticAstFunctionParamTypeAt(
        signatures, target.signature_row, target.ordinal);
    if !IsSome(type_name) ||
        !SemanticAstCollectionOwnershipIsStringArray(
            UnwrapOption(type_name)) { return 0; }
    return target.syntax_id;
}

func SemanticAstCollectionSourceStringSequenceFormalForArgument(
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref graph: SemanticExpressionGraphFacts,
    call_node: Int, argument_ordinal: Int
) -> Int {
    let target: SemanticAstCollectionArgumentFormalTarget =
        SemanticAstCollectionArgumentFormalTargetForArgument(
            signatures, graph, call_node, argument_ordinal);
    if !target.ok { return 0; }
    let type_name: Option<String> = SemanticAstFunctionParamTypeAt(
        signatures, target.signature_row, target.ordinal);
    if !IsSome(type_name) ||
        !SemanticAstCollectionOwnershipIsStringSequence(
            UnwrapOption(type_name)) { return 0; }
    return target.syntax_id;
}

func SemanticAstCollectionSourceStringSliceFormalForArgument(
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref graph: SemanticExpressionGraphFacts,
    call_node: Int, argument_ordinal: Int
) -> Int {
    let target: SemanticAstCollectionArgumentFormalTarget =
        SemanticAstCollectionArgumentFormalTargetForArgument(
            signatures, graph, call_node, argument_ordinal);
    if !target.ok { return 0; }
    let type_name: Option<String> = SemanticAstFunctionParamTypeAt(
        signatures, target.signature_row, target.ordinal);
    if !IsSome(type_name) ||
        !SemanticAstCollectionOwnershipIsStringSlice(
            UnwrapOption(type_name)) { return 0; }
    return target.syntax_id;
}
