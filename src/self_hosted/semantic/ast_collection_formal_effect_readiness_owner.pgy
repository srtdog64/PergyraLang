// Exact readiness and compact receipt facts for the retained body-owned
// formal-effect projection. This validates identity without rescanning the
// expression graph that originally produced the effects.
import "ast_collection_formal_effect_fact_owner.pgy";

func SemanticAstCollectionFormalEffectRowIndexMatches(
    rows: HashMap<String, Int>, key: String, expected: Int
) -> Bool {
    if !MapHas(rows, key) { return false; }
    return MapGet(rows, key) == expected;
}

func SemanticAstCollectionFormalEffectForNode(
    effects: HashMap<String, Int>, node: Int
) -> Int {
    let key: String = ToString(node);
    if !MapHas(effects, key) { return 0; }
    return MapGet(effects, key);
}

func SemanticAstCollectionFormalEffectsReadyFor(
    facts: SemanticAstCollectionFormalEffects,
    ref signatures: SemanticAstFunctionSignatureFacts
) -> Bool {
    let count: Int = ArrayLength(facts.inventory.formal_nodes);
    let owned_push_leaf_formals: HashMap<String, Int> =
        facts.owned_push_leaf_formals;
    let signature_count: Int = ArrayLength(signatures.function_node_ids);
    let flat_count: Int = ArrayLength(signatures.param_node_ids);
    if !facts.ok || !facts.inventory.ok || !signatures.ok ||
        !signatures.action_contracts.ok ||
        ArrayLength(facts.inventory.function_nodes) != count ||
        ArrayLength(facts.inventory.ordinals) != count ||
        ArrayLength(facts.inventory.modes) != count ||
        ArrayLength(facts.inventory.body_ready) != count ||
        ArrayLength(signatures.param_starts) != signature_count ||
        ArrayLength(signatures.param_counts) != signature_count ||
        ArrayLength(signatures.param_types) != flat_count ||
        ArrayLength(signatures.param_modes) != flat_count ||
        ArrayLength(signatures.action_contracts.callable_node_ids) !=
            signature_count ||
        ArrayLength(signatures.action_contracts.body_node_ids) !=
            signature_count { return false; }
    let signature: Int = 0;
    let flat: Int = 0;
    let expected: Int = 0;
    let owned_push_leaf_count: Int = 0;
    while signature < signature_count {
        let function: Int = signatures.function_node_ids[signature];
        let size: Int = signatures.param_counts[signature];
        if function <= 0 || signatures.param_starts[signature] != flat ||
            size < 0 || size > flat_count - flat ||
            signatures.action_contracts.callable_node_ids[signature] !=
                function { return false; }
        let ordinal: Int = 0;
        while ordinal < size {
            let parameter: Int = flat + ordinal;
            let mode: Int = signatures.param_modes[parameter];
            if mode < 0 || mode > 3 { return false; }
            if SemanticAstCollectionFormalEffectTrackedType(
                    signatures.param_types[parameter]) {
                if expected >= count { return false; }
                let node: Int = signatures.param_node_ids[parameter];
                let key: String = ToString(node);
                if node <= 0 ||
                    facts.inventory.formal_nodes[expected] != node {
                    return false;
                }
                if facts.inventory.function_nodes[expected] != function ||
                    facts.inventory.ordinals[expected] != ordinal ||
                    facts.inventory.modes[expected] != mode {
                    return false;
                }
                if facts.inventory.body_ready[expected] !=
                    (signatures.action_contracts.body_node_ids[signature] > 0) {
                    return false;
                }
                if !SemanticAstCollectionFormalEffectRowIndexMatches(
                        facts.inventory.row_by_formal, key, expected) {
                    return false;
                }
                let effect: Int = SemanticAstCollectionFormalEffectForNode(
                    facts.effects, node);
                if effect != 0 {
                    if effect < 1 || effect > 6 { return false; }
                }
                if MapHas(owned_push_leaf_formals, key) {
                    if !SemanticAstCollectionOwnershipIsStringArray(
                            signatures.param_types[parameter]) ||
                        facts.inventory.modes[expected] != 1 ||
                        !facts.inventory.body_ready[expected] || effect != 2 ||
                        MapGet(owned_push_leaf_formals, key) < 0 {
                        return false;
                    }
                    owned_push_leaf_count = owned_push_leaf_count + 1;
                }
                expected = expected + 1;
            }
            ordinal = ordinal + 1;
        }
        flat = flat + size;
        signature = signature + 1;
    }
    return flat == flat_count && expected == count &&
        owned_push_leaf_count == MapSize(owned_push_leaf_formals);
}

// The body admission validates the complete carrier once; this lookup checks
// the exact selected argument/formal and its current execution-frame proof.
func SemanticAstCollectionFormalScalarMapReadArgumentReady(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref graph: SemanticExpressionGraphFacts, ref facts: SemanticAstCollectionFormalEffects,
    edge: SemanticCallArgumentEdgeView, end_node: Int
) -> Bool {
    if !edge.ok || !graph.ok || !facts.ok || !facts.inventory.ok || !signatures.ok ||
        signatures.artifact_node_count != artifact.count { return false; }
    let formal: SemanticAstCollectionArgumentFormalTarget = SemanticAstCollectionArgumentFormalTargetForArgument(
        signatures, graph, edge.call_node, edge.ordinal);
    if !formal.ok || formal.signature_row >= ArrayLength(signatures.param_starts) ||
        formal.signature_row >= ArrayLength(signatures.param_counts) ||
        formal.signature_row >= ArrayLength(signatures.names) ||
        formal.signature_row >= ArrayLength(signatures.action_contracts.body_node_ids) { return false; }
    let parameter: Int = signatures.param_starts[formal.signature_row] + formal.ordinal;
    if parameter < 0 || parameter >= ArrayLength(signatures.param_types) || parameter >= ArrayLength(signatures.param_modes) ||
        !SemanticAstCollectionFormalScalarMapType(signatures.param_types[parameter]) ||
        (signatures.param_modes[parameter] != 0 && signatures.param_modes[parameter] != 3) ||
        signatures.action_contracts.body_node_ids[formal.signature_row] <= 0 { return false; }
    let call: SemanticCallSpineView = SemanticCallSpineViewForCallNodeWithin(graph, edge.call_node, end_node);
    let identity: SemanticExpressionBindingIdentityFact = SemanticExpressionGraphBindingIdentity(graph, call.callee_node);
    let name: Option<String> = SemanticExpressionGraphNodeText(graph, call.callee_node);
    let target_kind: Option<Int> = SemanticExpressionGraphCallTargetKind(graph, edge.call_node);
    let target_name: Option<String> = SemanticExpressionGraphCallTargetName(graph, edge.call_node);
    let target_syntax: Option<Int> = SemanticExpressionGraphCallTargetSyntaxId(graph, edge.call_node);
    let target_abi: Option<Int> = SemanticExpressionGraphRuntimeCallAbiId(graph, edge.call_node);
    if !call.ok || edge.ordinal < 0 || edge.ordinal >= ArrayLength(call.argument_nodes) ||
        call.argument_nodes[edge.ordinal] != edge.argument_node || formal.ordinal != edge.ordinal ||
        ArrayLength(call.argument_nodes) != signatures.param_counts[formal.signature_row] || !identity.ok ||
        identity.kind != SemanticExpressionBindingDeclaredCallable() || identity.syntax_id != signatures.function_node_ids[formal.signature_row] ||
        !IsSome(name) || UnwrapOption(name) != signatures.names[formal.signature_row] ||
        !IsSome(target_kind) || UnwrapOption(target_kind) != SemanticCallTargetDirect() ||
        !IsSome(target_name) || UnwrapOption(target_name) != UnwrapOption(name) ||
        !IsSome(target_syntax) || UnwrapOption(target_syntax) != identity.syntax_id ||
        !IsSome(target_abi) || UnwrapOption(target_abi) != 0 { return false; }
    let key: String = ToString(formal.syntax_id);
    if !MapHas(facts.inventory.row_by_formal, key) { return false; }
    let row: Int = MapGet(facts.inventory.row_by_formal, key);
    if row < 0 || row >= ArrayLength(facts.inventory.formal_nodes) || row >= ArrayLength(facts.inventory.function_nodes) ||
        row >= ArrayLength(facts.inventory.ordinals) || row >= ArrayLength(facts.inventory.modes) || row >= ArrayLength(facts.inventory.body_ready) ||
        facts.inventory.formal_nodes[row] != formal.syntax_id || facts.inventory.function_nodes[row] != identity.syntax_id ||
        facts.inventory.ordinals[row] != formal.ordinal || facts.inventory.modes[row] != signatures.param_modes[parameter] ||
        !facts.inventory.body_ready[row] ||
        !SemanticAstCollectionFormalExecutionContextCallableReady(artifact, facts.execution_contexts, identity.syntax_id) { return false; }
    let effect: Int = SemanticAstCollectionFormalEffectForNode(facts.effects, formal.syntax_id);
    return effect == 1 || effect == 3;
}

func SemanticAstCollectionFormalEffectProvedCount(
    facts: SemanticAstCollectionFormalEffects
) -> Int {
    let count: Int = 0;
    let row: Int = 0;
    while row < ArrayLength(facts.inventory.formal_nodes) {
        if SemanticAstCollectionFormalEffectForNode(
                facts.effects, facts.inventory.formal_nodes[row]) != 0 {
            count = count + 1;
        }
        row = row + 1;
    }
    return count;
}

func SemanticAstCollectionFormalEffectReceiptDigest(
    facts: SemanticAstCollectionFormalEffects
) -> Int {
    let digest: Int = 17;
    let owned_push_leaf_formals: HashMap<String, Int> =
        facts.owned_push_leaf_formals;
    let row: Int = 0;
    while row < ArrayLength(facts.inventory.formal_nodes) {
        let node: Int = facts.inventory.formal_nodes[row];
        let effect: Int = SemanticAstCollectionFormalEffectForNode(
            facts.effects, node);
        let owned_push_leaf_call: Int = -1;
        let key: String = ToString(node);
        if MapHas(owned_push_leaf_formals, key) {
            owned_push_leaf_call =
                MapGet(owned_push_leaf_formals, key);
        }
        // Keep every intermediate inside signed Int. With a 15,000,000
        // modulus the largest valid step remains below Int32 max.
        digest = ((digest * 131) + ((node % 104729) * 7) +
            (((owned_push_leaf_call + 1) % 104729) * 11) +
            effect + 1) % 15000000;
        row = row + 1;
    }
    return digest;
}
