// Whole-expression use inventory consumed by the formal-effect fixed point.
import "ast_collection_formal_execution_context_owner.pgy";
import "ast_collection_formal_effect_fixed_point_owner.pgy";
import "ast_expression_graph_view_owner.pgy";
import "ast_expression_graph_call_argument_edge_owner.pgy";
import "ast_builtin_argument_retention_call_fact_owner.pgy";
import "ast_statement_fact_owner.pgy";
import "ast_owned_string_call_result_admission_owner.pgy";
import "ast_collection_formal_statement_effect_owner.pgy";
import "ast_collection_builtin_release_identity_owner.pgy";
import "ast_string_formal_borrow_owner.pgy";
import "ast_string_formal_text_containment_owner.pgy";
import "ast_collection_descriptor_effect_owner.pgy";
import "ast_collection_formal_use_entry_owner.pgy";
import "ast_collection_owned_push_leaf_resolution_owner.pgy";

func SemanticAstCollectionFormalEffectsWithSurfaceOrderAndOwnedStoreLandings(
    artifact: AstTreeArtifact,
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref scopes: SemanticAstFunctionScopeFacts,
    ref locals: SemanticAstLocalBindingFacts,
    ref initializer_types: SemanticAstInitializerTypeFacts,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref statements: SemanticAstStatementFacts,
    ref owned_string_results: SemanticAstOwnedStringResultFacts,
    ref owned_store_expression_node_ids: Array<Int>,
    ref order: SemanticExpressionGraphSurfaceOrder
) -> SemanticAstCollectionFormalEffects {
    let inventory: SemanticAstCollectionFormalEffectInventory =
        SemanticAstCollectionFormalEffectInventoryFromSignatures(signatures);
    // The canonical shape check must precede every parameter-row consumer.
    if !inventory.ok { return SemanticAstCollectionFormalEffectsEmpty(); }
    let contexts: SemanticAstCollectionFormalExecutionContexts =
        SemanticAstCollectionFormalExecutionContextsWithSurfaceOrder(
            artifact, signatures.function_node_ids, scopes, surfaces, order);
    // Invalid global coverage is not an admitted opaque callable effect.
    if !contexts.ok { return SemanticAstCollectionFormalEffectsEmpty(); }
    var effects: HashMap<String, Int> = MapNew();
    var descriptor_effects: HashMap<String, Int> = MapNew();
    // An empty, validated String-sequence formal inventory has no element-use
    // obligations. Unrelated plain-array uses belong to their storage owner.
    let borrowed_text: HashMap<String, Int> = SemanticAstStringFormalBorrowOnlyFacts(artifact, signatures, surfaces);
    if inventory.ok && ArrayLength(inventory.formal_nodes) == 0 {
        let no_owned_push: HashMap<String, Int> = MapNew();
        return SemanticAstCollectionFormalEffects(
            contexts.ok, inventory, effects, descriptor_effects, no_owned_push, contexts, borrowed_text);
    }
    let formal_rows: HashMap<String, Int> = inventory.row_by_formal;
    var blocked: Array<Bool> = [];
    // An element kept only inside a text escape-free body never outlives it.
    var escape_free: Array<Bool> = [];
    // A formal whose only open use is its text's escape; its body may still
    // keep that text in the frame.
    var text_escapes: Array<Bool> = [];
    var mutations: Array<Bool> = [];
    var shallow_mutations: Array<Bool> = [];
    var element_reads: Array<Bool> = [];
    var scalar_maps: Array<Bool> = [];
    var owned_mutation_site_counts: Array<Int> = [];
    var owned_mutation_site_nodes: Array<Int> = [];
    var forwarding_counts: Array<Int> = [];
    var owned_push_leaf_disqualified: Array<Bool> = [];
    var node_rows: Array<Int> = [];
    var element_rows: Array<Int> = [];
    var slice_member_rows: Array<Int> = [];
    var slice_value_rows: Array<Int> = [];
    var sources: Array<Int> = [];
    var targets: Array<Int> = [];
    let count: Int = ArrayLength(inventory.formal_nodes);
    let statement_effects: SemanticAstCollectionFormalStatementEffects =
        SemanticAstCollectionFormalStatementEffectsFromFacts(
            artifact, signatures, locals, initializer_types, surfaces,
            statements, owned_string_results,
            owned_store_expression_node_ids, inventory, formal_rows);
    let statement_owned_formals: HashMap<String, Int> =
        statement_effects.owned_formals;
    let statement_shallow_formals: HashMap<String, Int> =
        statement_effects.shallow_formals;
    let statement_target_rows: HashMap<String, Int> =
        statement_effects.target_rows;
    let statement_owned_sites: HashMap<String, Int> =
        statement_effects.owned_site_nodes;
    let statement_site_shape_ready: Bool =
        MapSize(statement_owned_formals) == MapSize(statement_owned_sites);
    var row: Int = 0;
    while row < count {
        let formal_key: String = ToString(inventory.formal_nodes[row]);
        let opaque: Bool = !SemanticAstCollectionFormalExecutionContextCallableReady(
            artifact, contexts, inventory.function_nodes[row]);
        ArrayPush(blocked, !inventory.body_ready[row] || opaque);
        let signature_row: Option<Int> = SemanticAstFunctionSignatureIndexForNode(
            signatures, inventory.function_nodes[row]);
        ArrayPush(scalar_maps, IsSome(signature_row) && SemanticAstCollectionFormalScalarMapType(
            signatures.param_types[signatures.param_starts[UnwrapOption(signature_row)] + inventory.ordinals[row]]));
        ArrayPush(escape_free, IsSome(signature_row) &&
            SemanticAstFunctionTextEscapeFree(artifact, signatures, UnwrapOption(signature_row)));
        ArrayPush(text_escapes, false);
        ArrayPush(mutations, MapHas(
            statement_owned_formals, formal_key));
        ArrayPush(shallow_mutations, MapHas(
            statement_shallow_formals, formal_key));
        ArrayPush(element_reads, false);
        var owned_site: Int = -1;
        var owned_site_count: Int = 0;
        if MapHas(statement_owned_sites, formal_key) {
            owned_site = MapGet(statement_owned_sites, formal_key);
            owned_site_count = 1;
            if owned_site < 0 { owned_site_count = 2; }
        }
        ArrayPush(owned_mutation_site_counts, owned_site_count);
        ArrayPush(owned_mutation_site_nodes, owned_site);
        ArrayPush(forwarding_counts, 0);
        ArrayPush(owned_push_leaf_disqualified,
            MapHas(statement_shallow_formals, formal_key));
        if opaque {
            MapSet(descriptor_effects, formal_key,
                SemanticAstCollectionFormalOpaqueExecutionEffect());
            MapSet(effects, ToString(inventory.formal_nodes[row]),
                SemanticAstCollectionFormalOpaqueExecutionEffect());
        }
        row = row + 1;
    }
    var ok: Bool = contexts.ok && inventory.ok && signatures.ok &&
        SemanticBuiltinArgumentRetentionProjectionReady() &&
        statement_effects.ok && statement_site_shape_ready;
    var last: Int = -1;
    var root: Int = 0;
    while ok && root < ArrayLength(order.slots_by_root) {
        let slot: Int = order.slots_by_root[root];
        if slot == -2 {
            ArrayPush(node_rows, -1); ArrayPush(element_rows, -1);
            ArrayPush(slice_member_rows, -1); ArrayPush(slice_value_rows, -1);
            last = root;
        }
        if slot >= 0 {
            var node: Int = last + 1;
            while ok && node <= root {
                let binding: SemanticExpressionBindingIdentityFact =
                    SemanticExpressionGraphBindingIdentity(
                        surfaces.expression_graph, node);
                if !binding.ok { ok = false; break; }
                var formal_row: Int = -1;
                if binding.kind ==
                    SemanticExpressionBindingFormalParameter() {
                    let signature: Option<Int> =
                        SemanticAstFunctionSignatureIndexForNode(
                            signatures,
                            surfaces.function_node_ids[slot / 3]);
                    if !IsSome(signature) || !binding.has_ordinal {
                        ok = false; break;
                    }
                    let parameter: Option<Int> =
                        SemanticAstFunctionParamNodeAt(
                            signatures, UnwrapOption(signature),
                            binding.ordinal);
                    if !IsSome(parameter) ||
                        UnwrapOption(parameter) != binding.syntax_id {
                        ok = false; break;
                    }
                    let key: String = ToString(binding.syntax_id);
                    if MapHas(formal_rows, key) {
                        formal_row = MapGet(formal_rows, key);
                        if binding.ordinal != inventory.ordinals[formal_row] ||
                            surfaces.function_node_ids[slot / 3] !=
                                inventory.function_nodes[formal_row] {
                            ok = false; break;
                        }
                    }
                }
                ArrayPush(node_rows, formal_row);
                ArrayPush(element_rows, -1);
                ArrayPush(slice_member_rows, -1);
                ArrayPush(slice_value_rows, -1);
                let kind: Int =
                    surfaces.expression_graph.arena.topology.node_kinds[node];
                let call_kind: Option<Int> =
                    SemanticExpressionGraphCallTargetKind(
                        surfaces.expression_graph, node);
                let primitive: Bool = IsSome(call_kind) &&
                    UnwrapOption(call_kind) == SemanticCallTargetNone();
                var edge: Int = 0;
                while ok && edge < 2 {
                    var child: Option<Int> =
                        SemanticExpressionGraphLeftChild(
                            surfaces.expression_graph, node);
                    if edge == 1 {
                        child = SemanticExpressionGraphRightChild(
                            surfaces.expression_graph, node);
                    }
                    if IsSome(child) && UnwrapOption(child) >= 0 &&
                        UnwrapOption(child) < node {
                        let child_node: Int = UnwrapOption(child);
                        let used_row: Int = node_rows[child_node];
                        let borrowed_row: Int = element_rows[child_node];
                        let slice_member_row: Int =
                            slice_member_rows[child_node];
                        let slice_value_row: Int =
                            slice_value_rows[child_node];
                        if slice_member_row >= 0 {
                            if edge == 0 && kind == AstExpressionNodeCall() &&
                                SemanticAstCollectionOwnershipArraySliceCall(
                                    surfaces.expression_graph, node) {
                                slice_value_rows[node] = slice_member_row;
                            } else {
                                blocked[slice_member_row] = true;
                            }
                        }
                        if slice_value_row >= 0 {
                            if edge == 0 && kind ==
                                    AstExpressionNodeCallArgument() {
                                let continuation: SemanticCallArgumentEdgeView =
                                    SemanticCallArgumentEdgeFromGraph(
                                        surfaces.expression_graph, node);
                                if continuation.ok &&
                                    SemanticAstCollectionOwnershipArraySliceCall(
                                        surfaces.expression_graph,
                                        continuation.call_node) {
                                    slice_value_rows[node] = slice_value_row;
                                } else {
                                    blocked[slice_value_row] = true;
                                }
                            } else if edge == 0 && primitive &&
                                    kind == AstExpressionNodeIndex() {
                                element_reads[slice_value_row] = true;
                                element_rows[node] = slice_value_row;
                            } else if edge == 1 && kind ==
                                    AstExpressionNodeCallArgument() {
                                let slice_argument:
                                    SemanticCallArgumentEdgeView =
                                    SemanticCallArgumentEdgeFromGraph(
                                        surfaces.expression_graph, node);
                                if !slice_argument.ok ||
                                    slice_argument.argument_node != child_node {
                                    ok = false; break;
                                }
                                if slice_argument.ordinal == 0 &&
                                    SemanticAstCollectionOwnershipBuiltinCall(
                                        surfaces.expression_graph,
                                        slice_argument.call_node,
                                        "ArrayLength") {
                                } else {
                                    let slice_target: Int =
                                        SemanticAstCollectionSourceStringSliceFormalForArgument(
                                            signatures,
                                            surfaces.expression_graph,
                                            slice_argument.call_node,
                                            slice_argument.ordinal);
                                    let slice_target_key: String =
                                        ToString(slice_target);
                                    if slice_target <= 0 ||
                                        !MapHas(formal_rows,
                                            slice_target_key) {
                                        blocked[slice_value_row] = true;
                                    } else {
                                        ArrayPush(sources, slice_value_row);
                                        ArrayPush(targets, MapGet(
                                            formal_rows, slice_target_key));
                                        forwarding_counts[slice_value_row] =
                                            forwarding_counts[slice_value_row] + 1;
                                    }
                                }
                            } else {
                                blocked[slice_value_row] = true;
                            }
                        }
                        var observed_element: Bool = false;
                        // A moving transfer can release text even in an
                        // escape-free body; ArrayPushOwnedString copies.
                        var owning_consumer: Bool = false;
                        if borrowed_row >= 0 && edge == 1 &&
                            kind == AstExpressionNodeCallArgument() {
                            let argument: SemanticCallArgumentEdgeView =
                                SemanticCallArgumentEdgeFromGraph(
                                    surfaces.expression_graph, node);
                            owning_consumer = argument.ok && argument.argument_node == child_node &&
                                (SemanticAstCollectionOwnershipBuiltinCall(
                                    surfaces.expression_graph, argument.call_node, "ArrayPushOwned") ||
                                 SemanticAstCollectionOwnStringFormalArgument(
                                    signatures, surfaces.expression_graph, argument.call_node, argument.ordinal));
                            let identity: Option<String> =
                                SemanticAstBuiltinArgumentRetentionIdentityForReadyCallContext(
                                    surfaces, argument.call_node, last + 1,
                                    surfaces.node_ids[slot / 3], slot % 3);
                            // Interpolation's ToString of the element keeps
                            // the same borrow; its own consumer decides.
                            if argument.ok && argument.argument_node == child_node &&
                                SemanticAstBorrowedTextThroughToString(
                                    surfaces.expression_graph, node, child_node) {
                                element_rows[node] = borrowed_row;
                            }
                            // A borrow-only user String formal admits the
                            // element exactly as a borrowed builtin argument.
                            observed_element = element_rows[node] == borrowed_row || (argument.ok &&
                                argument.argument_node == child_node &&
                                ((IsSome(identity) &&
                                SemanticBuiltinArgumentBorrowedForIdentity(
                                    UnwrapOption(identity), argument.ordinal)) ||
                                SemanticAstStringFormalBorrowedArgument(signatures,
                                    surfaces.expression_graph, borrowed_text,
                                    argument.call_node, argument.ordinal)));
                        }
                        if borrowed_row >= 0 && !observed_element &&
                            (!escape_free[borrowed_row] || owning_consumer) &&
                            (!primitive ||
                             (kind != AstExpressionNodeEquality() &&
                              kind != AstExpressionNodeInequality() &&
                              kind != AstExpressionNodeAdd())) {
                            if owning_consumer { blocked[borrowed_row] = true; }
                            else { text_escapes[borrowed_row] = true; }
                        }
                        if used_row >= 0 {
                            var leaf_compatible_use: Bool = false;
                            if scalar_maps[used_row] {
                                let call: SemanticCallArgumentEdgeView = SemanticCallArgumentEdgeFromGraph(
                                    surfaces.expression_graph, node);
                                let spine: SemanticCallSpineView = SemanticCallSpineViewForCallNodeWithin(
                                    surfaces.expression_graph, call.call_node, root);
                                let operation: Option<String> = SemanticExpressionGraphCallTargetName(
                                    surfaces.expression_graph, call.call_node);
                                let callee_text: Option<String> = SemanticExpressionGraphNodeText(surfaces.expression_graph, spine.callee_node);
                                var read: Bool = false;
                                if edge == 1 && kind == AstExpressionNodeCallArgument() && call.ok &&
                                    call.argument_node == child_node && call.ordinal == 0 && spine.ok && IsSome(operation) {
                                    let protocol: SemanticExpressionGraphCollectionCallProtocolFact =
                                        SemanticExpressionGraphCollectionCallProtocolFromName(UnwrapOption(operation));
                                    read = protocol.applies && protocol.family == "HashMap" &&
                                        protocol.receiver_argument_index == call.ordinal &&
                                        ArrayLength(spine.argument_nodes) == protocol.expected_arity && IsSome(callee_text) &&
                                        UnwrapOption(callee_text) == protocol.operation && spine.argument_nodes[0] == child_node &&
                                        (protocol.operation == "MapHas" || protocol.operation == "MapGet" || protocol.operation == "MapSize") &&
                                        SemanticAstCollectionOwnershipBuiltinCall(surfaces.expression_graph, call.call_node, protocol.operation);
                                }
                                if read { element_reads[used_row] = true; }
                                else if edge == 1 && kind == AstExpressionNodeCallArgument() && call.ok && call.argument_node == child_node {
                                    let target: SemanticAstCollectionArgumentFormalTarget = SemanticAstCollectionArgumentFormalTargetForArgument(
                                        signatures, surfaces.expression_graph, call.call_node, call.ordinal);
                                    let key: String = ToString(target.syntax_id);
                                    let identity: SemanticExpressionBindingIdentityFact = SemanticExpressionGraphBindingIdentity(
                                        surfaces.expression_graph, spine.callee_node);
                                    let target_kind: Option<Int> = SemanticExpressionGraphCallTargetKind(surfaces.expression_graph, call.call_node);
                                    let target_syntax: Option<Int> = SemanticExpressionGraphCallTargetSyntaxId(surfaces.expression_graph, call.call_node);
                                    let target_abi: Option<Int> = SemanticExpressionGraphRuntimeCallAbiId(surfaces.expression_graph, call.call_node);
                                    if !target.ok || !spine.ok || !MapHas(formal_rows, key) ||
                                        MapGet(formal_rows, key) < 0 || MapGet(formal_rows, key) >= ArrayLength(scalar_maps) ||
                                        !scalar_maps[MapGet(formal_rows, key)] || !identity.ok ||
                                        !IsSome(target_kind) || UnwrapOption(target_kind) != SemanticCallTargetDirect() ||
                                        !IsSome(target_syntax) || UnwrapOption(target_syntax) != identity.syntax_id ||
                                        !IsSome(target_abi) || UnwrapOption(target_abi) != 0 || !IsSome(operation) || !IsSome(callee_text) ||
                                        UnwrapOption(operation) != signatures.names[target.signature_row] || UnwrapOption(callee_text) != UnwrapOption(operation) ||
                                        identity.kind != SemanticExpressionBindingDeclaredCallable() ||
                                        identity.syntax_id != signatures.function_node_ids[target.signature_row] ||
                                        ArrayLength(spine.argument_nodes) != signatures.param_counts[target.signature_row] ||
                                        target.ordinal != call.ordinal { blocked[used_row] = true; }
                                    else {
                                        ArrayPush(sources, used_row);
                                        ArrayPush(targets, MapGet(formal_rows, key));
                                        forwarding_counts[used_row] =
                                            forwarding_counts[used_row] + 1;
                                        leaf_compatible_use = true;
                                    }
                                } else { blocked[used_row] = true; }
                            } else if edge == 0 && primitive &&
                                kind == AstExpressionNodeIndex() {
                                element_reads[used_row] = true;
                                element_rows[node] = used_row;
                            } else if edge == 0 && primitive &&
                                kind == AstExpressionNodeMemberAccess() {
                                slice_member_rows[node] = used_row;
                            } else if edge != 1 || kind !=
                                    AstExpressionNodeCallArgument() {
                                blocked[used_row] = true;
                            } else {
                                let call: SemanticCallArgumentEdgeView =
                                    SemanticCallArgumentEdgeFromGraph(
                                        surfaces.expression_graph, node);
                                let ordinal: Int = call.ordinal;
                                if !call.ok || ordinal < 0 {
                                    ok = false; break;
                                }
                                if ordinal == 0 &&
                                    SemanticAstCollectionOwnershipBuiltinCall(
                                        surfaces.expression_graph,
                                        call.call_node, "ArrayLength") {
                                    leaf_compatible_use = true;
                                } else if inventory.modes[used_row] == 2 &&
                                    SemanticAstCollectionBuiltinReleaseArgument(
                                        surfaces.expression_graph,
                                        call.call_node, ordinal) {
                                    // An own formal has a consumption obligation,
                                    // not an unresolved user-formal forwarding edge.
                                    // Caller content and ordered-use checks still apply.
                                } else if ordinal == 0 &&
                                    SemanticAstCollectionOwnershipBuiltinCall(
                                        surfaces.expression_graph,
                                        call.call_node,
                                        "ArrayPushOwnedString") {
                                    mutations[used_row] = true;
                                    leaf_compatible_use = true;
                                    owned_mutation_site_counts[used_row] =
                                        owned_mutation_site_counts[used_row] + 1;
                                    if owned_mutation_site_nodes[used_row] < 0 {
                                        owned_mutation_site_nodes[used_row] =
                                            call.call_node;
                                    }
                                } else if ordinal == 0 &&
                                    (SemanticAstCollectionOwnershipBuiltinCall(
                                        surfaces.expression_graph,
                                        call.call_node, "ArrayPush") ||
                                     SemanticAstCollectionOwnershipBuiltinCall(
                                        surfaces.expression_graph,
                                        call.call_node, "ArraySet") ||
                                     SemanticAstCollectionOwnershipBuiltinCall(
                                        surfaces.expression_graph,
                                        call.call_node, "ArrayPop")) {
                                    shallow_mutations[used_row] = true;
                                } else {
                                    let target: Int =
                                        SemanticAstCollectionSourceStringSequenceFormalForArgument(
                                            signatures,
                                            surfaces.expression_graph,
                                            call.call_node, ordinal);
                                    let target_key: String = ToString(target);
                                    if target <= 0 ||
                                        !MapHas(formal_rows, target_key) {
                                        blocked[used_row] = true;
                                    } else {
                                        ArrayPush(sources, used_row);
                                        ArrayPush(targets,
                                            MapGet(formal_rows, target_key));
                                        forwarding_counts[used_row] =
                                            forwarding_counts[used_row] + 1;
                                        leaf_compatible_use = true;
                                    }
                                }
                                if !leaf_compatible_use {
                                    owned_push_leaf_disqualified[used_row] = true;
                                }
                            }
                        }
                    }
                    edge = edge + 1;
                }
                node = node + 1;
            }
            var statement_mutation_row: Int = -1;
            // Failed traversal may leave root rows unbuilt; guard reads first.
            if ok && (node_rows[root] >= 0 || element_rows[root] >= 0) {
                let root_key: String = ToString(root);
                if MapHas(statement_target_rows, root_key) {
                    statement_mutation_row = MapGet(
                        statement_target_rows, root_key);
                }
            }
            if ok && node_rows[root] >= 0 &&
                node_rows[root] != statement_mutation_row {
                blocked[node_rows[root]] = true;
                owned_push_leaf_disqualified[node_rows[root]] = true;
            }
            if ok && element_rows[root] >= 0 {
                let source_row: Int = element_rows[root];
                // A borrowed element stored into another growable descriptor
                // needs a cross-storage lifetime relation. Parameter order or
                // an inout target does not express that relation, so this use
                // remains fail-closed until the language has an owned transfer.
                // A text escape-free body is that relation: its storage dies
                // before the element's owner can release it.
                if source_row != statement_mutation_row && !escape_free[source_row] {
                    text_escapes[source_row] = true;
                }
            }
            if ok && slice_member_rows[root] >= 0 {
                blocked[slice_member_rows[root]] = true;
            }
            if ok && slice_value_rows[root] >= 0 {
                blocked[slice_value_rows[root]] = true;
            }
            last = root;
        }
        root = root + 1;
    }
    ok = ok && ArrayLength(node_rows) ==
        SemanticExpressionGraphArenaNodeCount(
            surfaces.expression_graph.arena);
    ok = ok && ArrayLength(element_rows) == ArrayLength(node_rows) &&
        ArrayLength(slice_member_rows) == ArrayLength(node_rows) &&
        ArrayLength(slice_value_rows) == ArrayLength(node_rows);
    ok = ok && ArrayLength(scalar_maps) == count && ArrayLength(blocked) == count &&
        ArrayLength(mutations) == count &&
        ArrayLength(shallow_mutations) == count &&
        ArrayLength(element_reads) == count &&
        ArrayLength(owned_mutation_site_counts) == count &&
        ArrayLength(owned_mutation_site_nodes) == count &&
        ArrayLength(forwarding_counts) == count &&
        ArrayLength(owned_push_leaf_disqualified) == count &&
        ArrayLength(sources) == ArrayLength(targets);
    var fixed_point_status: SemanticAstCollectionFormalEffectResolutionStatus =
        SemanticAstCollectionFormalEffectResolutionStatus(ok);
    SemanticAstCollectionFormalEffectFacetsResolve(
        artifact, signatures, locals, initializer_types.inferred_type_names, surfaces, borrowed_text,
        inventory, blocked, mutations, shallow_mutations, element_reads, text_escapes,
        sources, targets, effects, descriptor_effects, fixed_point_status);
    ok = fixed_point_status.ok;
    let owned_push_leaf_formals: HashMap<String, Int> =
        SemanticAstCollectionOwnedPushLeafFormals(
            artifact, contexts, inventory, effects,
            owned_mutation_site_counts, owned_mutation_site_nodes,
            forwarding_counts, owned_push_leaf_disqualified,
            sources, targets, ok);
    ArrayDrop(node_rows); ArrayDrop(element_rows);
    ArrayDrop(slice_member_rows); ArrayDrop(slice_value_rows);
    ArrayDrop(blocked); ArrayDrop(escape_free); ArrayDrop(text_escapes); ArrayDrop(mutations); ArrayDrop(shallow_mutations);
    ArrayDrop(element_reads);
    ArrayDrop(scalar_maps);
    return SemanticAstCollectionFormalEffects(
        ok, inventory, effects, descriptor_effects, owned_push_leaf_formals, contexts, borrowed_text);
}
