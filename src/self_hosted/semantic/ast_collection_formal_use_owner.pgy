// Whole-expression use inventory and its collection-formal proof fixed point.
import "ast_collection_formal_execution_context_owner.pgy";
import "ast_expression_graph_view_owner.pgy";
import "ast_expression_graph_call_argument_edge_owner.pgy";
import "ast_builtin_argument_retention_call_fact_owner.pgy";
struct SemanticAstCollectionFormalEffects {
    ok: Bool;
    inventory: SemanticAstCollectionFormalEffectInventory;
    effects: HashMap<String, Int>;
}
func SemanticAstCollectionFormalEffectsWithReadyBuiltinRetention(
    artifact: AstTreeArtifact,
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref scopes: SemanticAstFunctionScopeFacts,
    ref surfaces: SemanticAstExpressionSurfaceFacts
) -> SemanticAstCollectionFormalEffects {
    let inventory: SemanticAstCollectionFormalEffectInventory =
        SemanticAstCollectionFormalEffectInventoryFromSignatures(signatures);
    let effects: HashMap<String, Int> = MapNew();
    let contexts: SemanticAstCollectionFormalExecutionContexts =
        SemanticAstCollectionFormalExecutionContextsFromFacts(
            artifact, inventory, scopes, surfaces);
    let unsafe_functions: HashMap<String, Int> = contexts.unsafe_functions;
    let formal_rows: HashMap<String, Int> = inventory.row_by_formal;
    let blocked: Array<Bool> = [];
    let mutations: Array<Bool> = [];
    let element_reads: Array<Bool> = [];
    let node_rows: Array<Int> = [];
    let element_rows: Array<Int> = [];
    let sources: Array<Int> = [];
    let targets: Array<Int> = [];
    let count: Int = ArrayLength(inventory.formal_nodes);
    let row: Int = 0;
    while row < count {
        let opaque: Bool = MapHas(unsafe_functions,
            ToString(inventory.function_nodes[row]));
        ArrayPush(blocked, !inventory.body_ready[row] || opaque);
        ArrayPush(mutations, false);
        ArrayPush(element_reads, false);
        if opaque {
            MapSet(effects, ToString(inventory.formal_nodes[row]),
                SemanticAstCollectionFormalOpaqueExecutionEffect());
        }
        row = row + 1;
    }
    let ok: Bool = contexts.ok && inventory.ok && signatures.ok &&
        SemanticBuiltinArgumentRetentionProjectionReady();
    let last: Int = -1;
    let slot: Int = 0;
    while ok && slot < ArrayLength(surfaces.expression_graph.roots) {
        if surfaces.expression_graph.has_roots[slot] {
            let root: Int = surfaces.expression_graph.roots[slot];
            let node: Int = last + 1;
            while ok && node <= root {
                let binding: SemanticExpressionBindingIdentityFact =
                    SemanticExpressionGraphBindingIdentity(
                        surfaces.expression_graph, node);
                if !binding.ok { ok = false; break; }
                let formal_row: Int = -1;
                let key: String = ToString(binding.syntax_id);
                if binding.kind ==
                    SemanticExpressionBindingFormalParameter() {
                    let signature: Option<Int> =
                        SemanticAstFunctionSignatureIndexForNode(
                            signatures,
                            surfaces.function_node_ids[slot / 3]);
                    if !IsSome(signature) || !binding.has_ordinal {
                        ok = false; break;
                    }
                    let parameter: Option<Int> =
                        SemanticAstFunctionParamNodeAt(
                            signatures, UnwrapOption(signature),
                            binding.ordinal);
                    if !IsSome(parameter) ||
                        UnwrapOption(parameter) != binding.syntax_id {
                        ok = false; break;
                    }
                    if MapHas(formal_rows, key) {
                        formal_row = MapGet(formal_rows, key);
                        if binding.ordinal != inventory.ordinals[formal_row] ||
                            surfaces.function_node_ids[slot / 3] !=
                                inventory.function_nodes[formal_row] {
                            ok = false; break;
                        }
                    }
                }
                ArrayPush(node_rows, formal_row);
                ArrayPush(element_rows, -1);
                let kind: Int =
                    surfaces.expression_graph.arena.topology.node_kinds[node];
                let call_kind: Option<Int> =
                    SemanticExpressionGraphCallTargetKind(
                        surfaces.expression_graph, node);
                let primitive: Bool = IsSome(call_kind) &&
                    UnwrapOption(call_kind) == SemanticCallTargetNone();
                let edge: Int = 0;
                while ok && edge < 2 {
                    let child: Option<Int> =
                        SemanticExpressionGraphLeftChild(
                            surfaces.expression_graph, node);
                    if edge == 1 {
                        child = SemanticExpressionGraphRightChild(
                            surfaces.expression_graph, node);
                    }
                    if IsSome(child) && UnwrapOption(child) >= 0 &&
                        UnwrapOption(child) < node {
                        let child_node: Int = UnwrapOption(child);
                        let used_row: Int = node_rows[child_node];
                        let borrowed_row: Int = element_rows[child_node];
                        let observed_element: Bool = false;
                        if borrowed_row >= 0 && edge == 1 &&
                            kind == AstExpressionNodeCallArgument() {
                            let argument: SemanticCallArgumentEdgeView =
                                SemanticCallArgumentEdgeFromGraph(
                                    surfaces.expression_graph, node);
                            let identity: Option<String> =
                                SemanticAstBuiltinArgumentRetentionIdentityForReadyCallFacts(
                                    surfaces, argument.call_node);
                            observed_element = argument.ok &&
                                argument.argument_node == child_node &&
                                IsSome(identity) &&
                                SemanticBuiltinArgumentBorrowedForIdentity(
                                    UnwrapOption(identity), argument.ordinal);
                        }
                        if borrowed_row >= 0 && !observed_element &&
                            (!primitive ||
                             (kind != AstExpressionNodeEquality() &&
                              kind != AstExpressionNodeInequality())) {
                            blocked[borrowed_row] = true;
                        }
                        if used_row >= 0 {
                            if edge == 0 && primitive &&
                                kind == AstExpressionNodeIndex() {
                                element_reads[used_row] = true;
                                element_rows[node] = used_row;
                            } else if edge != 1 || kind !=
                                    AstExpressionNodeCallArgument() {
                                blocked[used_row] = true;
                            } else {
                                let call: SemanticCallArgumentEdgeView =
                                    SemanticCallArgumentEdgeFromGraph(
                                        surfaces.expression_graph, node);
                                let ordinal: Int = call.ordinal;
                                if !call.ok || ordinal < 0 {
                                    ok = false; break;
                                }
                                if ordinal == 0 &&
                                    SemanticAstCollectionOwnershipBuiltinCall(
                                        surfaces.expression_graph,
                                        call.call_node, "ArrayLength") {
                                } else if ordinal == 0 &&
                                    SemanticAstCollectionOwnershipBuiltinCall(
                                        surfaces.expression_graph,
                                        call.call_node,
                                        "ArrayPushOwnedString") {
                                    mutations[used_row] = true;
                                } else {
                                    let target: Int =
                                        SemanticAstCollectionSourceArrayFormalForArgument(
                                            signatures,
                                            surfaces.expression_graph,
                                            call.call_node, ordinal);
                                    let target_key: String = ToString(target);
                                    if target <= 0 ||
                                        !MapHas(formal_rows, target_key) {
                                        blocked[used_row] = true;
                                    } else {
                                        ArrayPush(sources, used_row);
                                        ArrayPush(targets,
                                            MapGet(formal_rows, target_key));
                                    }
                                }
                            }
                        }
                    }
                    edge = edge + 1;
                }
                node = node + 1;
            }
            if ok && node_rows[root] >= 0 {
                blocked[node_rows[root]] = true;
            }
            if ok && element_rows[root] >= 0 {
                blocked[element_rows[root]] = true;
            }
            last = root;
        }
        slot = slot + 1;
    }
    ok = ok && ArrayLength(node_rows) ==
        SemanticExpressionGraphArenaNodeCount(
            surfaces.expression_graph.arena);
    ok = ok && ArrayLength(blocked) == count &&
        ArrayLength(mutations) == count &&
        ArrayLength(element_reads) == count &&
        ArrayLength(sources) == ArrayLength(targets);
    // Least proof fixed point: a forwarding cycle without a proved sink
    // grants nothing.
    let changed: Bool = true;
    let remaining: Int = count + 1;
    while ok && changed && remaining > 0 {
        changed = false;
        row = 0;
        while row < count {
            let formal_key: String = ToString(inventory.formal_nodes[row]);
            if blocked[row] && element_reads[row] &&
                !MapHas(effects, formal_key) {
                MapSet(effects, formal_key, SemanticAstCollectionFormalUnprovedElementUseEffect()); changed = true;
            } else if !blocked[row] && !MapHas(effects, formal_key) {
                let ready: Bool = true;
                let mutation: Bool = mutations[row];
                let reads_elements: Bool = element_reads[row];
                let opaque: Bool = false;
                let unproved_element: Bool = false;
                let use_edge: Int = 0;
                while use_edge < ArrayLength(sources) {
                    if sources[use_edge] == row {
                        let target_key: String = ToString(inventory.formal_nodes[targets[use_edge]]);
                        if !MapHas(effects, target_key) { ready = false; }
                        else if MapGet(effects, target_key) ==
                                SemanticAstCollectionFormalOpaqueExecutionEffect() { opaque = true; }
                        else if MapGet(effects, target_key) == 2 {
                            mutation = true;
                        } else if MapGet(effects, target_key) == 3 {
                            reads_elements = true;
                        } else if MapGet(effects, target_key) == SemanticAstCollectionFormalUnprovedElementUseEffect() {
                            unproved_element = true; }
                    }
                    use_edge = use_edge + 1;
                }
                if ready {
                    let effect: Int = 1;
                    if reads_elements { effect = 3; }
                    if mutation { effect = 2; }
                    if unproved_element { effect = SemanticAstCollectionFormalUnprovedElementUseEffect(); }
                    if opaque {
                        effect = SemanticAstCollectionFormalOpaqueExecutionEffect();
                    }
                    MapSet(effects, formal_key, effect);
                    changed = true;
                }
            }
            row = row + 1;
        }
        remaining = remaining - 1;
    }
    ArrayDrop(node_rows);
    ArrayDrop(element_rows);
    ArrayDrop(blocked); ArrayDrop(mutations); ArrayDrop(element_reads);
    ArrayDrop(sources); ArrayDrop(targets);
    return SemanticAstCollectionFormalEffects(ok, inventory, effects);
}
func SemanticAstCollectionFormalEffectsFromResolvedFacts(artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref scopes: SemanticAstFunctionScopeFacts, ref surfaces: SemanticAstExpressionSurfaceFacts) -> SemanticAstCollectionFormalEffects {
    if !SemanticAstBuiltinArgumentRetentionCallFactsReady(surfaces) {
        let no_effects: HashMap<String, Int> = MapNew();
        return SemanticAstCollectionFormalEffects(false, SemanticAstCollectionFormalEffectInventoryFromSignatures(signatures), no_effects);
    }
    return SemanticAstCollectionFormalEffectsWithReadyBuiltinRetention(artifact, signatures, scopes, surfaces);
}
