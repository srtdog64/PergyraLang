// Payload use occurs at completion, after every operand was evaluated.
// Local loan liveness and loop backedges use the same admitted String sources.
import "ast_collection_map_payload_event_owner.pgy";
import "ast_collection_element_escape_entry_owner.pgy";

func SemanticAstMapStringPayloadAtValueCompletion(
    artifact: AstTreeArtifact, ref locals: SemanticAstLocalBindingFacts,
    ref inferred_types: Array<String>, ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref assignments: SemanticAstAssignmentFacts, ref definitions: SemanticAstCollectionDefinitionFacts,
    ref storage: SemanticAstCollectionStorageAuthorityFacts, ref current_definitions: Array<Int>,
    ref borrow_sources: Array<Int>, inout loans: SemanticAstIndexedStringBorrowState,
    root_slot: Int, node: Int
) -> SemanticAstCollectionOwnershipVerdict {
    let surface: Int = root_slot / 3;
    let kind: Option<Int> = SemanticExpressionGraphNodeKind(surfaces.expression_graph, node);
    if !IsSome(kind) { return SemanticAstCollectionOwnershipVerdictOk(); }
    if UnwrapOption(kind) == AstExpressionNodeArrayElement() {
        let element: SemanticArrayLiteralElementEdge = SemanticArrayLiteralElementEdgeFromGraph(
            surfaces.expression_graph, node);
        if !element.ok { return SemanticAstMapStringPayloadBoundary(
            surfaces, surface, node, "map_string_array_element_unproved"); }
        let element_source: Int = SemanticAstIndexedStringBorrowSourceForRoot(artifact, locals, inferred_types,
            surfaces, definitions, storage, current_definitions, borrow_sources,
            loans.map_payload_sources, surface, element.element_node);
        if element_source < -1 { return SemanticAstMapStringPayloadBoundary(
            surfaces, surface, node, "map_string_array_element_escape"); }
    }
    if UnwrapOption(kind) == AstExpressionNodeAdd() || UnwrapOption(kind) == AstExpressionNodeEquality() ||
        UnwrapOption(kind) == AstExpressionNodeInequality() {
        let left: Option<Int> = SemanticExpressionGraphLeftChild(surfaces.expression_graph, node);
        let right: Option<Int> = SemanticExpressionGraphRightChild(surfaces.expression_graph, node);
        if !IsSome(left) || !IsSome(right) { return SemanticAstMapStringPayloadBoundary(
            surfaces, surface, node, "map_string_operand_unproved"); }
        let left_source: Int = SemanticAstIndexedStringBorrowSourceForRoot(artifact, locals, inferred_types,
            surfaces, definitions, storage, current_definitions, borrow_sources, loans.map_payload_sources, surface, UnwrapOption(left));
        let right_source: Int = SemanticAstIndexedStringBorrowSourceForRoot(artifact, locals, inferred_types,
            surfaces, definitions, storage, current_definitions, borrow_sources, loans.map_payload_sources, surface, UnwrapOption(right));
        if SemanticAstMapStringPayloadInvalidated(artifact, surfaces, loans, left_source, surfaces.node_ids[surface]) ||
            SemanticAstMapStringPayloadInvalidated(artifact, surfaces, loans, right_source, surfaces.node_ids[surface]) {
            return SemanticAstMapStringPayloadBoundary(surfaces, surface, node, "map_string_use_after_mutation");
        }
    }
    if surfaces.expression_graph.roots[root_slot] == node && root_slot % 3 == AstExpressionLaneValue() {
        let source: Int = SemanticAstIndexedStringBorrowSourceForRoot(artifact, locals, inferred_types,
            surfaces, definitions, storage, current_definitions, borrow_sources, loans.map_payload_sources, surface, node);
        if source < -1 {
            let declared: Option<Int> = SemanticAstLocalBindingIndexForNode(locals, surfaces.node_ids[surface]);
            let stored: Bool = IsSome(declared) && inferred_types[UnwrapOption(declared)] == "String";
            if !stored { stored = SemanticAstCollectionAssignedStringLocal(artifact, locals, inferred_types,
                surfaces, surfaces.node_ids[surface], surface); }
            if !stored && !TypedAstArenaNodeKindIs(artifact.arena, surfaces.node_ids[surface], TypedAstKindLogStmtTag()) &&
                !TypedAstArenaNodeKindIs(artifact.arena, surfaces.node_ids[surface], TypedAstKindMatchStmtTag()) {
                return SemanticAstMapStringPayloadBoundary(surfaces, surface, node, "map_string_borrow_escape");
            }
        }
    }
    return SemanticAstCollectionOwnershipVerdictOk();
}

func SemanticAstMapStringPayloadLoopUseAtMutation(
    artifact: AstTreeArtifact, ref locals: SemanticAstLocalBindingFacts,
    ref inferred_types: Array<String>, ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref borrow_sources: Array<Int>, inout loans: SemanticAstIndexedStringBorrowState,
    root_slot: Int, node: Int
) -> SemanticAstCollectionOwnershipVerdict {
    let surface: Int = root_slot / 3;
    let row: Int = 0;
    while row < ArrayLength(borrow_sources) {
        if inferred_types[row] == "String" && SemanticAstMapStringPayloadInvalidated(
                artifact, surfaces, loans, borrow_sources[row], surfaces.node_ids[surface]) &&
            SemanticAstCollectionExclusiveLoopCarries(artifact, locals.node_ids[row],
                surfaces.node_ids[surface], surfaces.node_ids[surface]) {
            let earlier: Int = 0;
            while earlier <= surface {
                if surfaces.function_node_ids[earlier] == surfaces.function_node_ids[surface] &&
                    SemanticAstCollectionExclusiveLoopCarries(artifact, locals.node_ids[row],
                        surfaces.node_ids[earlier], surfaces.node_ids[surface]) {
                    let lane: Int = 0;
                    while lane < 3 {
                        let slot: Int = earlier * 3 + lane;
                        if surfaces.expression_graph.has_roots[slot] {
                            let root: Int = surfaces.expression_graph.roots[slot];
                            let start: Option<Int> = SemanticExpressionGraphSubtreeStart(surfaces.expression_graph, root);
                            let leaf: Int = root + 1;
                            if IsSome(start) { leaf = UnwrapOption(start); }
                            while leaf <= root {
                                if !SemanticAstCollectionExclusiveMemberName(surfaces, leaf, root) {
                                    let binding: SemanticAstLocalBindingIdentity = SemanticAstScopedLocalBindingIdentityForGraphLeaf(
                                        artifact, locals, inferred_types, surfaces.function_node_ids[earlier],
                                        surfaces.node_ids[earlier], surfaces.expression_graph, leaf);
                                    if binding.ok && binding.row == row { return SemanticAstMapStringPayloadBoundary(
                                        surfaces, surface, node, "map_string_loop_use_after_mutation"); }
                                }
                                leaf = leaf + 1;
                            }
                        }
                        lane = lane + 1;
                    }
                }
                earlier = earlier + 1;
            }
        }
        row = row + 1;
    }
    return SemanticAstCollectionOwnershipVerdictOk();
}
