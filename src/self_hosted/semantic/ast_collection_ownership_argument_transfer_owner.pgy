// Ordered `own Array<String>` transfer keyed only by admitted SyntaxNodeIds.
import "ast_collection_ownership_identity_owner.pgy";
import "ast_collection_owned_parameter_identity_owner.pgy";
import "ast_collection_call_retirement_owner.pgy";
import "ast_expression_graph_call_view_owner.pgy";
import "ast_signature_fact_owner.pgy";
struct SemanticAstCollectionOwnedArgumentUse {
    found: Bool;
    diagnostic_code: String;
    boundary: String;
    syntax_node_id: Int;
    expression_node_id: Int;
}
func SemanticAstCollectionFirstInvalidOwnedArgumentUse(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref locals: SemanticAstLocalBindingFacts, ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    proved: HashMap<String, Int>
) -> SemanticAstCollectionOwnedArgumentUse {
    let roots: SemanticCallSpineRoots = SemanticCallSpineRootsFromGraph(surfaces.expression_graph);
    if !roots.ok {
        return SemanticAstCollectionOwnedArgumentUse(
            true, "ast_artifact_invalid", "owned_argument_call_roots", -1, -1);
    }
    let retired: HashMap<String, Int> = MapNew();
    let unknown: HashMap<String, Int> = MapNew();
    let root_slot: Int = 0;
    while root_slot < ArrayLength(surfaces.expression_graph.roots) {
        if surfaces.expression_graph.has_roots[root_slot] {
            let surface: Int = root_slot / 3;
            let syntax_id: Int = surfaces.node_ids[surface];
            let root_id: Int = surfaces.expression_graph.roots[root_slot];
            let start: Option<Int> = SemanticExpressionGraphSubtreeStart(
                surfaces.expression_graph, root_id);
            if IsSome(start) {
                let node: Int = UnwrapOption(start);
                while node <= root_id {
                    if surfaces.expression_graph.arena.topology.node_kinds[node] == AstExpressionNodeCallArgument() {
                        let edge: SemanticCallArgumentEdgeView = SemanticCallArgumentEdgeFromGraph(surfaces.expression_graph, node);
                        let source: Int = SemanticAstCollectionOwnStringArrayFormalNode(signatures,
                            surfaces.function_node_ids[surface], surfaces.expression_graph, edge.argument_node);
                        let target: Option<Int> = SemanticExpressionGraphCallTargetSyntaxId(surfaces.expression_graph, edge.call_node);
                        let formal: Int = SemanticAstCollectionSourceArrayFormalForArgument(signatures,
                            surfaces.expression_graph, edge.call_node, edge.ordinal);
                        if edge.ok && source > 0 && IsSome(target) && UnwrapOption(target) > 0 &&
                            SemanticAstCollectionOwnStringArrayParameterNode(signatures, surfaces.expression_graph, edge.call_node, edge.ordinal) <= 0 &&
                            !MapHas(proved, ToString(formal)) {
                            MapSet(unknown, ToString(source), SemanticAstCollectionCallRetirementSite(artifact, syntax_id));
                        }
                    }
                    let carried: SemanticExpressionBindingIdentityFact =
                        SemanticExpressionGraphBindingIdentity(
                            surfaces.expression_graph, node);
                    let is_callable: Bool = carried.ok && carried.kind ==
                        SemanticExpressionBindingDeclaredCallable();
                    let is_member_name: Bool = node + 1 <= root_id &&
                        surfaces.expression_graph.arena.topology.node_kinds[
                            node + 1] == AstExpressionNodeMemberAccess() &&
                        surfaces.expression_graph.arena.topology.right_children[
                            node + 1] == node;
                    let binding: SemanticAstLocalBindingIdentity =
                        SemanticAstLocalBindingIdentityUnresolved();
                    if !is_callable && !is_member_name {
                        binding = SemanticAstScopedLocalBindingIdentityForGraphLeaf(
                            artifact, locals, inferred_types,
                            surfaces.function_node_ids[surface], syntax_id,
                            surfaces.expression_graph, node);
                    }
                    let key: String = "";
                    if binding.ok { key = ToString(binding.declaration_node_id); }
                    if !binding.ok && !is_callable && !is_member_name {
                        let formal: Int = SemanticAstCollectionOwnStringArrayFormalNode(
                            signatures, surfaces.function_node_ids[surface],
                            surfaces.expression_graph, node);
                        if formal > 0 { key = ToString(formal); }
                    }
                    if key != "" && MapHas(retired, key) &&
                        SemanticAstCollectionMutableCallMayBeRetired(
                            artifact, syntax_id, MapGet(retired, key)) {
                        return SemanticAstCollectionOwnedArgumentUse(
                            true, "move_from_released",
                            "owned_argument_use_after_move", syntax_id, node);
                    }
                    node = node + 1;
                }
                node = UnwrapOption(start);
                while node <= root_id {
                    let kind: Option<Int> = SemanticExpressionGraphNodeKind(
                        surfaces.expression_graph, node);
                    if IsSome(kind) && UnwrapOption(kind) ==
                            AstExpressionNodeCall() {
                        let call: SemanticCallSpineView = SemanticCallSpineViewFromGraph(
                            surfaces.expression_graph, roots.root_nodes[node]);
                        if call.ok && call.call_node == node {
                            let argument: Int = 0;
                            while argument < ArrayLength(call.argument_nodes) {
                                let parameter_node: Int = SemanticAstCollectionOwnStringArrayParameterNode(
                                    signatures, surfaces.expression_graph, node, argument);
                                if parameter_node > 0 {
                                    let binding: SemanticAstLocalBindingIdentity =
                                        SemanticAstCollectionOwnershipLocalForArgument(
                                            artifact, locals, inferred_types, surfaces,
                                            surface, call.argument_nodes[argument]);
                                    let source_id: Int = 0;
                                    if binding.ok { source_id = binding.declaration_node_id; }
                                    else {
                                        source_id = SemanticAstCollectionOwnStringArrayFormalNode(
                                            signatures, surfaces.function_node_ids[surface],
                                            surfaces.expression_graph, call.argument_nodes[argument]);
                                    }
                                    let key: String = ToString(source_id);
                                    if source_id > 0 && MapHas(retired, key) &&
                                        SemanticAstCollectionMutableCallMayBeRetired(
                                            artifact, syntax_id, MapGet(retired, key)) {
                                        return SemanticAstCollectionOwnedArgumentUse(
                                            true, "move_from_released", "owned_argument_use_after_move",
                                            syntax_id, call.argument_nodes[argument]);
                                    }
                                    if !binding.ok && source_id > 0 &&
                                        (SemanticAstCollectionCallRetirementSite(artifact, syntax_id) == 0 ||
                                         (MapHas(unknown, key) && SemanticAstCollectionMutableCallMayBeRetired(
                                            artifact, syntax_id, MapGet(unknown, key)))) {
                                        return SemanticAstCollectionOwnedArgumentUse(
                                            true, "borrow_boundary_escape",
                                            "owned_argument_storage_unproved",
                                            syntax_id, call.argument_nodes[argument]);
                                    }
                                    if source_id > 0 {
                                        // Return still needs same-expression duplicate/nested refusal.
                                        MapSet(retired, key, SemanticAstCollectionCallRetirementSite(artifact, syntax_id));
                                    }
                                }
                                argument = argument + 1;
                            }
                            let releasing: Bool = ArrayLength(call.argument_nodes) == 1 &&
                                (SemanticAstCollectionOwnershipBuiltinCall(surfaces.expression_graph, node, "ArrayDropOwnedStrings") ||
                                 SemanticAstCollectionOwnershipBuiltinCall(surfaces.expression_graph, node, "ArrayDrop") ||
                                 SemanticAstCollectionOwnershipBuiltinCall(surfaces.expression_graph, node, "CompilerRetireArrayStorage"));
                            if releasing {
                                let source: Int = SemanticAstCollectionOwnStringArrayFormalNode(signatures,
                                    surfaces.function_node_ids[surface], surfaces.expression_graph, call.argument_nodes[0]);
                                if source > 0 { MapSet(retired, ToString(source), SemanticAstCollectionCallRetirementSite(artifact, syntax_id)); }
                            }
                        }
                    }
                    node = node + 1;
                }
            }
        }
        root_slot = root_slot + 1;
    }
    return SemanticAstCollectionOwnedArgumentUse(false, "", "", -1, -1);
}
