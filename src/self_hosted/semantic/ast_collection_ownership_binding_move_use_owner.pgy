// Direct binding moves retire one storage definition, not every future value
// ever stored under that local declaration.
import "ast_collection_assignment_definition_owner.pgy";

struct SemanticAstCollectionBindingMoveUse {
    found: Bool;
    syntax_node_id: Int;
    expression_node_id: Int;
}

func SemanticAstCollectionFirstInvalidBindingMoveUse(
    artifact: AstTreeArtifact,
    ref locals: SemanticAstLocalBindingFacts,
    ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts, ref definitions: SemanticAstCollectionDefinitionFacts
) -> SemanticAstCollectionBindingMoveUse {
    let move_points: HashMap<String, Int> = MapNew();
    let current: Array<Int> = SemanticAstCollectionInitialDefinitions(definitions);
    let root_slot: Int = 0;
    while root_slot < ArrayLength(surfaces.expression_graph.roots) {
        if surfaces.expression_graph.has_roots[root_slot] {
            let surface: Int = root_slot / 3;
            let syntax_id: Int = surfaces.node_ids[surface];
            let root_id: Int = surfaces.expression_graph.roots[root_slot];
            let start: Option<Int> = SemanticExpressionGraphSubtreeStart(
                surfaces.expression_graph, root_id);
            if IsSome(start) {
                let node: Int = UnwrapOption(start);
                while node <= root_id {
                    let carried: SemanticExpressionBindingIdentityFact =
                        SemanticExpressionGraphBindingIdentity(
                            surfaces.expression_graph, node);
                    let is_callable: Bool = carried.ok && carried.kind ==
                        SemanticExpressionBindingDeclaredCallable();
                    let is_member_name: Bool = node + 1 <= root_id &&
                        surfaces.expression_graph.arena.topology.node_kinds[
                            node + 1] == AstExpressionNodeMemberAccess() &&
                        surfaces.expression_graph.arena.topology.right_children[
                            node + 1] == node;
                    if !is_callable && !is_member_name && !SemanticAstCollectionDefinitionWriteTarget(definitions, root_slot, node) {
                        let binding: SemanticAstLocalBindingIdentity =
                            SemanticAstScopedLocalBindingIdentityForGraphLeaf(
                                artifact, locals, inferred_types,
                                surfaces.function_node_ids[surface], syntax_id,
                                surfaces.expression_graph, node);
                        if binding.ok {
                            let key: String = ToString(
                                definitions.syntax_ids[current[binding.row]]);
                            if MapHas(move_points, key) && syntax_id >
                                    MapGet(move_points, key) {
                                return SemanticAstCollectionBindingMoveUse(
                                    true, syntax_id, node);
                            }
                        }
                    }
                    node = node + 1;
                }
            }
            let completed: Int = SemanticAstCollectionDefinitionCompletedAtSlot(definitions, locals, surfaces, root_slot);
            if completed >= 0 {
                let source: Int = definitions.local_sources[completed];
                if source >= 0 { MapSet(move_points, ToString(definitions.syntax_ids[current[source]]), syntax_id); }
                if definitions.fresh[completed] { current[definitions.binding_rows[completed]] = completed; }
            }
        }
        root_slot = root_slot + 1;
    }
    return SemanticAstCollectionBindingMoveUse(false, -1, -1);
}
