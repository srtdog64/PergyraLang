// Stable binding and callable identity queries for collection ownership.

import "ast_expression_graph_array_literal_owner.pgy";
import "ast_expression_graph_call_view_owner.pgy";
import "ast_expression_graph_call_argument_edge_owner.pgy";
import "ast_expression_graph_member_view_owner.pgy";
import "ast_expression_call_target_fact_owner.pgy";
import "ast_expression_graph_node_view_owner.pgy";
import "ast_expression_graph_view_owner.pgy";
import "ast_local_binding_identity_owner.pgy";
import "ast_initializer_type_fact_owner.pgy";
import "ast_statement_fact_owner.pgy";
import "ast_signature_fact_owner.pgy";
import "array_type_shape_owner.pgy";
import "builtin_signature_owner.pgy";

func SemanticAstCollectionOwnershipBuiltinCall(
    ref graph: SemanticExpressionGraphFacts,
    call_node_id: Int, expected_name: String
) -> Bool {
    let kind: Option<Int> = SemanticExpressionGraphCallTargetKind(
        graph, call_node_id);
    let name: Option<String> = SemanticExpressionGraphCallTargetName(
        graph, call_node_id);
    let syntax_id: Option<Int> =
        SemanticExpressionGraphCallTargetSyntaxId(graph, call_node_id);
    let runtime_abi_id: Option<Int> =
        SemanticExpressionGraphRuntimeCallAbiId(graph, call_node_id);
    let callee: Option<Int> = SemanticCallBaseCalleeFromGraph(graph, call_node_id);
    if !IsSome(callee) { return false; }
    let binding: SemanticExpressionBindingIdentityFact =
        SemanticExpressionGraphBindingIdentity(graph, UnwrapOption(callee));
    return IsSome(kind) && IsSome(name) && IsSome(syntax_id) &&
        IsSome(runtime_abi_id) &&
        binding.ok && binding.kind == SemanticExpressionBindingNone() &&
        binding.syntax_id == 0 &&
        UnwrapOption(kind) == SemanticCallTargetDirect() &&
        UnwrapOption(name) == expected_name &&
        UnwrapOption(syntax_id) == 0 && UnwrapOption(runtime_abi_id) == 0;
}

// Array.Slice is a member builtin, not a direct builtin call. Admit only the
// carried canonical identity and the registry-owned source member spelling.
// This proves the view constructor; whether the view may escape remains with
// the formal-use graph and its last consumer.
func SemanticAstCollectionOwnershipArraySliceCall(
    ref graph: SemanticExpressionGraphFacts, call_node_id: Int
) -> Bool {
    let kind: Option<Int> = SemanticExpressionGraphCallTargetKind(
        graph, call_node_id);
    let name: Option<String> = SemanticExpressionGraphCallTargetName(
        graph, call_node_id);
    let syntax_id: Option<Int> =
        SemanticExpressionGraphCallTargetSyntaxId(graph, call_node_id);
    let runtime_abi_id: Option<Int> =
        SemanticExpressionGraphRuntimeCallAbiId(graph, call_node_id);
    let callee: Option<Int> = SemanticCallBaseCalleeFromGraph(
        graph, call_node_id);
    if !IsSome(kind) || !IsSome(name) || !IsSome(syntax_id) ||
        !IsSome(runtime_abi_id) || !IsSome(callee) ||
        UnwrapOption(kind) != SemanticCallTargetMember() ||
        UnwrapOption(name) != "Array_Slice" ||
        UnwrapOption(syntax_id) != 0 || UnwrapOption(runtime_abi_id) != 0 {
        return false;
    }
    let call: SemanticCallSpineView = SemanticCallSpineViewFromGraph(
        graph, call_node_id);
    let member: SemanticMemberAccessView =
        SemanticMemberAccessViewFromGraph(graph, UnwrapOption(callee));
    if !call.ok || call.call_node != call_node_id ||
        call.callee_node != UnwrapOption(callee) || !member.ok {
        return false;
    }
    let source_member: Option<String> = SemanticExpressionGraphNodeText(
        graph, member.member_node);
    return IsSome(source_member) && SemanticBuiltinMemberCallableMatches(
        "Array_Slice", UnwrapOption(source_member));
}

func SemanticAstCollectionOwnershipIsStringArray(type_name: String) -> Bool {
    let element: Option<String> = SemanticArrayElementType(type_name);
    return IsSome(element) && UnwrapOption(element) == "String";
}

func SemanticAstCollectionOwnershipIsStringSlice(type_name: String) -> Bool {
    let element: Option<String> = SemanticSliceElementType(type_name);
    return IsSome(element) && UnwrapOption(element) == "String";
}

func SemanticAstCollectionOwnershipIsStringSequence(
    type_name: String
) -> Bool {
    return SemanticAstCollectionOwnershipIsStringArray(type_name) ||
        SemanticAstCollectionOwnershipIsStringSlice(type_name);
}

func SemanticAstCollectionOwnershipLiteralIsBorrowed(
    ref graph: SemanticExpressionGraphFacts, root_id: Int
) -> Bool {
    let literal: SemanticArrayLiteralView =
        SemanticArrayLiteralViewFromGraph(graph, root_id);
    if !literal.ok || ArrayLength(literal.element_nodes) == 0 { return false; }
    let i: Int = 0;
    while i < ArrayLength(literal.element_nodes) {
        let kind: Option<Int> = SemanticExpressionGraphNodeKind(
            graph, literal.element_nodes[i]);
        if !IsSome(kind) ||
            UnwrapOption(kind) != AstExpressionNodeStringLiteral() {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func SemanticAstCollectionOwnershipLiteralIsEmpty(
    ref graph: SemanticExpressionGraphFacts, root_id: Int
) -> Bool {
    let literal: SemanticArrayLiteralView =
        SemanticArrayLiteralViewFromGraph(graph, root_id);
    return literal.ok && ArrayLength(literal.element_nodes) == 0;
}

func SemanticAstCollectionOwnershipRootCallName(
    ref graph: SemanticExpressionGraphFacts, root_id: Int
) -> String {
    let call: SemanticCallSpineView = SemanticCallSpineViewFromGraph(
        graph, root_id);
    if !call.ok { return ""; }
    let name: Option<String> = SemanticExpressionGraphCallTargetName(
        graph, call.call_node);
    if !IsSome(name) || !SemanticAstCollectionOwnershipBuiltinCall(
        graph, call.call_node, UnwrapOption(name)) {
        return "";
    }
    return UnwrapOption(name);
}

func SemanticAstCollectionOwnershipLocalForArgument(
    artifact: AstTreeArtifact,
    ref locals: SemanticAstLocalBindingFacts,
    ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    surface_index: Int,
    argument_node_id: Int
) -> SemanticAstLocalBindingIdentity {
    if surface_index < 0 ||
        surface_index >= ArrayLength(surfaces.node_ids) ||
        surface_index >= ArrayLength(surfaces.function_node_ids) {
        return SemanticAstLocalBindingIdentityUnresolved();
    }
    return SemanticAstScopedLocalBindingIdentityForGraphLeaf(
        artifact, locals, inferred_types,
        surfaces.function_node_ids[surface_index],
        surfaces.node_ids[surface_index], surfaces.expression_graph,
        argument_node_id
    );
}

func SemanticAstCollectionOwnershipLocalForStatementTarget(
    artifact: AstTreeArtifact,
    ref locals: SemanticAstLocalBindingFacts,
    ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    function_id: Int, syntax_id: Int
) -> SemanticAstLocalBindingIdentity {
    if function_id < 0 || syntax_id < 0 || syntax_id >= artifact.count {
        return SemanticAstLocalBindingIdentityUnresolved();
    }
    let target_root: Option<Int> = SemanticAstExpressionGraphRootForNode(
        surfaces, syntax_id, AstExpressionLaneAtom());
    if !IsSome(target_root) {
        return SemanticAstLocalBindingIdentityUnresolved();
    }
    let target_node: Int = UnwrapOption(target_root);
    let target_kind: Option<Int> = SemanticExpressionGraphNodeKind(surfaces.expression_graph, target_node);
    if IsSome(target_kind) && UnwrapOption(target_kind) == AstExpressionNodeIndex() {
        let base: Option<Int> = SemanticExpressionGraphLeftChild(surfaces.expression_graph, target_node);
        if !IsSome(base) { return SemanticAstLocalBindingIdentityUnresolved(); }
        target_node = UnwrapOption(base);
    }
    return SemanticAstScopedLocalBindingIdentityForGraphLeaf(
        artifact, locals, inferred_types,
        function_id, syntax_id, surfaces.expression_graph,
        target_node
    );
}

struct SemanticAstCollectionFormalStorageIdentity {
    ok: Bool;
    syntax_id: Int;
    ordinal: Int;
    mode: Int;
    declared_type_name: String;
    signature_row: Int;
}

// Source-formal ordinals already include a hosted receiver. Only a callee
// argument projection applies the source-signature receiver offset.
// This join owns identity only; neither mode nor declared type grants lifetime.
func SemanticAstCollectionSourceFormalIdentity(
    ref signatures: SemanticAstFunctionSignatureFacts, function_node_id: Int,
    ref graph: SemanticExpressionGraphFacts, node: Int
) -> SemanticAstCollectionFormalStorageIdentity {
    let missing: SemanticAstCollectionFormalStorageIdentity = SemanticAstCollectionFormalStorageIdentity(false, 0, -1, -1, "", -1);
    let binding: SemanticExpressionBindingIdentityFact = SemanticExpressionGraphBindingIdentity(graph, node);
    let kind: Option<Int> = SemanticExpressionGraphNodeKind(graph, node);
    let signature: Option<Int> = SemanticAstFunctionSignatureIndexForNode(signatures, function_node_id);
    if !signatures.ok || !binding.ok || binding.kind != SemanticExpressionBindingFormalParameter() ||
        binding.syntax_id <= 0 || !binding.has_ordinal || !IsSome(kind) ||
        UnwrapOption(kind) != AstExpressionNodeLeaf() || !IsSome(signature) { return missing; }
    let row: Int = UnwrapOption(signature);
    if ArrayLength(signatures.param_starts) != ArrayLength(signatures.function_node_ids) ||
        ArrayLength(signatures.param_counts) != ArrayLength(signatures.function_node_ids) ||
        ArrayLength(signatures.param_types) != ArrayLength(signatures.param_node_ids) ||
        ArrayLength(signatures.param_modes) != ArrayLength(signatures.param_node_ids) ||
        signatures.param_starts[row] < 0 || signatures.param_counts[row] < 0 ||
        signatures.param_starts[row] > ArrayLength(signatures.param_node_ids) ||
        signatures.param_counts[row] > ArrayLength(signatures.param_node_ids) - signatures.param_starts[row] ||
        binding.ordinal < 0 || binding.ordinal >= signatures.param_counts[row] { return missing; }
    let parameter: Int = signatures.param_starts[row] + binding.ordinal;
    if signatures.param_node_ids[parameter] != binding.syntax_id ||
        signatures.param_types[parameter] == "" || signatures.param_types[parameter] == "Unknown" ||
        signatures.param_modes[parameter] < 0 || signatures.param_modes[parameter] > 3 { return missing; }
    return SemanticAstCollectionFormalStorageIdentity(true, binding.syntax_id, binding.ordinal,
        signatures.param_modes[parameter], signatures.param_types[parameter], row);
}

func SemanticAstCollectionStringArrayFormalIdentity(
    ref signatures: SemanticAstFunctionSignatureFacts, function_node_id: Int,
    ref graph: SemanticExpressionGraphFacts, node: Int
) -> SemanticAstCollectionFormalStorageIdentity {
    let formal: SemanticAstCollectionFormalStorageIdentity = SemanticAstCollectionSourceFormalIdentity(
        signatures, function_node_id, graph, node);
    if !formal.ok || !SemanticAstCollectionOwnershipIsStringArray(formal.declared_type_name) {
        return SemanticAstCollectionFormalStorageIdentity(false, 0, -1, -1, "", -1);
    }
    return formal;
}

// mode+1 distinguishes valid default mode0 from a missing source-formal fact.
func SemanticAstCollectionOwnershipParameterModeForArgument(
    ref signatures: SemanticAstFunctionSignatureFacts, ref surfaces: SemanticAstExpressionSurfaceFacts,
    surface_index: Int, argument_node_id: Int
) -> Int {
    if surface_index < 0 || surface_index >= ArrayLength(surfaces.function_node_ids) { return 0; }
    let formal: SemanticAstCollectionFormalStorageIdentity = SemanticAstCollectionStringArrayFormalIdentity(
        signatures, surfaces.function_node_ids[surface_index], surfaces.expression_graph, argument_node_id);
    if !formal.ok { return 0; }
    return formal.mode + 1;
}
