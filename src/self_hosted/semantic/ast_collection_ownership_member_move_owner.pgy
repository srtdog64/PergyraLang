// Stable direct-field identity and one-pass use-after-move detection for
// Array<String> extraction. A field-to-local value transfer is a move; Clone
// is the explicit operation that preserves both source and destination.

import "ast_expression_graph_member_view_owner.pgy";
import "ast_expression_graph_view_owner.pgy";
import "ast_collection_ownership_member_root_identity_owner.pgy";
import "ast_nominal_constructor_lookup_owner.pgy";
import "ast_type_name_canonical_owner.pgy";

struct SemanticAstCollectionMemberMoveIdentity {
    ok: Bool;
    key: String;
    source_binding_syntax_id: Int;
    field_syntax_id: Int;
}

func SemanticAstCollectionMemberMoveIdentityForNode(
    artifact: AstTreeArtifact,
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    ref locals: SemanticAstLocalBindingFacts,
    ref inferred_types: Array<String>,
    ref resolved_leaf_types: Array<String>,
    function_node_id: Int, use_node_id: Int,
    ref graph: SemanticExpressionGraphFacts, node_id: Int
) -> SemanticAstCollectionMemberMoveIdentity {
    let unresolved: SemanticAstCollectionMemberMoveIdentity =
        SemanticAstCollectionMemberMoveIdentity(false, "", 0, 0);
    let member: SemanticMemberAccessView =
        SemanticMemberAccessViewFromGraph(graph, node_id);
    if !member.ok { return unresolved; }
    let root: SemanticAstCollectionMemberRootIdentity =
        SemanticAstCollectionMemberRootIdentityForNode(
            artifact, signatures, locals, inferred_types, resolved_leaf_types, function_node_id,
            use_node_id, graph, member.receiver_node);
    let field_name: Option<String> = SemanticExpressionGraphNodeText(
        graph, member.member_node);
    if !root.ok || !IsSome(field_name) { return unresolved; }
    let root_type: SemanticCanonicalTypeNameFact =
        SemanticCanonicalTypeNameFactFrom(root.type_name);
    let constructor: Option<Int> = SemanticAstNominalConstructorIndexForName(
        constructors, root_type.nominal_base_name);
    if !IsSome(constructor) { return unresolved; }
    let field: Option<Int> = SemanticAstNominalConstructorFieldRowForName(
        constructors, UnwrapOption(constructor), UnwrapOption(field_name));
    if !IsSome(field) || UnwrapOption(field) >= ArrayLength(constructors.field_source_syntax_ids) {
        return unresolved;
    }
    let field_id: Int = constructors.field_source_syntax_ids[UnwrapOption(field)];
    if field_id <= 0 { return unresolved; }
    let key: String = Concat(ToString(function_node_id),
        Concat(":", Concat(ToString(root.source_binding_syntax_id), Concat(":", ToString(field_id)))));
    return SemanticAstCollectionMemberMoveIdentity(true, key, root.source_binding_syntax_id, field_id);
}
