// Ordered field-move transitions over the admitted expression graph.
// Exact field <- moved-local assignment restores the field and retires the
// temporary; every other source-field or retired-local reuse fails closed.
import "ast_assignment_fact_owner.pgy";
import "ast_collection_ownership_member_move_owner.pgy";
import "ast_collection_member_read_permission_owner.pgy";
import "ast_collection_member_read_local_root_owner.pgy";
import "ast_collection_member_place_use_owner.pgy";
import "ast_collection_member_capture_obligation_owner.pgy";
import "ast_collection_ownership_member_result_owner.pgy";
func SemanticAstCollectionFirstInvalidMemberMoveUse(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts, ref locals: SemanticAstLocalBindingFacts,
    ref inferred_types: Array<String>, ref resolved_leaf_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts, ref assignments: SemanticAstAssignmentFacts,
    ref statements: SemanticAstStatementFacts,
    ref contexts: SemanticAstCollectionFormalExecutionContexts, borrowed_text: HashMap<String, Int>,
    own move_destinations: HashMap<String, Int>
) -> SemanticAstCollectionMemberMoveUse {
    let active_members: HashMap<String, Int> = MapNew();
    let retired_locals: HashMap<String, Int> = MapNew();
    let restored: Array<Int> = [];
    let restoration_sites: Array<Int> = [];
    let readable_members: HashMap<String, Int> = MapNew();
    let unproved_read_roots: HashMap<String, Int> = MapNew();
    let read_sources: Array<Int> = [];
    let read_targets: Array<Int> = [];
    let element_escape_roots: HashMap<String, Int> = MapNew();
    let escape_sources: Array<Int> = []; let escape_targets: Array<Int> = []; let escape_sites: Array<Int> = [];
    let nested_nodes: Array<Int> = []; let nested_roots: Array<Int> = [];
    let nested_lend_sources: Array<Int> = []; let nested_lend_targets: Array<Int> = [];
    let nested_blocked: HashMap<String, Int> = MapNew();
    let readonly_origins: Array<Int> = [];
    let capture: SemanticAstCollectionMemberCaptureWitness = SemanticAstCollectionMemberCaptureWitness(true, -1, -1);
    let root_slot: Int = 0;
    while root_slot < ArrayLength(surfaces.expression_graph.roots) {
        if surfaces.expression_graph.has_roots[root_slot] {
            let surface: Int = root_slot / 3;
            let syntax_id: Int = surfaces.node_ids[surface];
            let root_id: Int = surfaces.expression_graph.roots[root_slot];
            let start: Option<Int> = SemanticExpressionGraphSubtreeStart(
                surfaces.expression_graph, root_id);
            if IsSome(start) {
                let subtree_start: Int = UnwrapOption(start);
                let node: Int = subtree_start;
                while node <= root_id {
                    capture = SemanticAstCollectionMemberCaptureObligationAt(
                        artifact, signatures, constructors, locals, inferred_types, resolved_leaf_types, surfaces, assignments,
                        statements, root_slot, node, root_id, capture, readonly_origins, unproved_read_roots);
                    let read_use: SemanticAstCollectionMemberRootReadOccurrence = SemanticAstCollectionMemberRootReadOccurrenceFromGraph(
                        artifact, signatures, constructors, resolved_leaf_types, surfaces.expression_graph, contexts,
                        surfaces.function_node_ids[surface], node, root_id);
                    if read_use.blocked { MapSet(unproved_read_roots, ToString(read_use.source), 1); }
                    if read_use.target > 0 {
                        ArrayPush(read_sources, read_use.source); ArrayPush(read_targets, read_use.target);
                    }
                    let place_use: SemanticAstCollectionMemberPlaceUse = SemanticAstCollectionMemberPlaceUseAt(
                        artifact, signatures, constructors, locals, inferred_types, resolved_leaf_types,
                        surfaces, borrowed_text, root_slot, subtree_start, node, root_id,
                        root_slot % 3 == AstExpressionLaneAtom() && SemanticAstAssignmentContainsNode(assignments, syntax_id));
                    if place_use.escapes && !MapHas(element_escape_roots, ToString(place_use.root)) {
                        MapSet(element_escape_roots, ToString(place_use.root), syntax_id);
                    }
                    if place_use.lent_target > 0 {
                        ArrayPush(escape_sources, place_use.root); ArrayPush(escape_targets, place_use.lent_target);
                        ArrayPush(escape_sites, syntax_id);
                    }
                    if place_use.nested_hazard || (place_use.lent_function > 0 &&
                        !SemanticAstCollectionFormalExecutionContextCallableReady(artifact, contexts, place_use.lent_function)) {
                        MapSet(nested_blocked, ToString(place_use.root), 1);
                    }
                    if place_use.lent_function > 0 {
                        ArrayPush(nested_lend_sources, place_use.root); ArrayPush(nested_lend_targets, place_use.lent_target);
                    }
                    if place_use.nested_read { ArrayPush(nested_nodes, node); ArrayPush(nested_roots, place_use.root); }
                    let identity: SemanticAstCollectionMemberMoveIdentity =
                        SemanticAstCollectionMemberMoveIdentityForNode(
                            artifact, signatures, constructors, locals,
                            inferred_types, resolved_leaf_types,
                            surfaces.function_node_ids[surface], syntax_id,
                            surfaces.expression_graph, node);
                    if identity.ok {
                        let event_key: String = SemanticAstCollectionMemberMoveEventKey(
                            identity, syntax_id);
                        if MapHas(move_destinations, event_key) {
                            MapSet(unproved_read_roots, ToString(identity.source_binding_syntax_id), 1);
                            // A new extraction cannot overwrite an outstanding move.
                            if MapHas(active_members, identity.key) && MapGet(active_members, identity.key) > 0 {
                                return SemanticAstCollectionMemberMoveUsePublish(artifact, contexts, true, syntax_id, node, capture,
                                    restored, restoration_sites, readable_members, unproved_read_roots, element_escape_roots, nested_blocked,
                                    readonly_origins,
                                    read_sources, read_targets, escape_sources, escape_targets, escape_sites,
                                    nested_nodes, nested_roots, nested_lend_sources, nested_lend_targets);
                            }
                            MapSet(active_members, identity.key,
                                MapGet(move_destinations, event_key));
                        } else if MapHas(active_members, identity.key) &&
                                MapGet(active_members, identity.key) > 0 {
                            let source_id: Int =
                                MapGet(active_members, identity.key);
                            let assignment_exists: Bool =
                                SemanticAstAssignmentContainsNode(assignments, syntax_id);
                            let is_restore: Bool = false;
                            if root_slot % 3 == AstExpressionLaneAtom() &&
                                assignment_exists && node == root_id {
                                let value_root: Option<Int> =
                                    SemanticAstExpressionGraphRootForNode(
                                        surfaces, syntax_id,
                                        AstExpressionLaneValue());
                                if IsSome(value_root) {
                                    let source: SemanticAstLocalBindingIdentity =
                                        SemanticAstScopedLocalBindingIdentityForGraphLeaf(
                                            artifact, locals, inferred_types,
                                            surfaces.function_node_ids[surface],
                                            syntax_id, surfaces.expression_graph,
                                            UnwrapOption(value_root));
                                    if source.ok &&
                                        source.declaration_node_id == source_id {
                                        is_restore = true;
                                        MapSet(active_members, identity.key, 0);
                                        MapSet(retired_locals,
                                            ToString(source_id), syntax_id);
                                        ArrayPush(restored, source_id);
                                        ArrayPush(restoration_sites,
                                            syntax_id);
                                    }
                                }
                            }
                            if !is_restore {
                                return SemanticAstCollectionMemberMoveUsePublish(artifact, contexts, true, syntax_id, node, capture,
                                    restored, restoration_sites, readable_members, unproved_read_roots, element_escape_roots, nested_blocked,
                                    readonly_origins,
                                    read_sources, read_targets, escape_sources, escape_targets, escape_sites,
                                    nested_nodes, nested_roots, nested_lend_sources, nested_lend_targets);
                            }
                        }
                        let read_root: Int = SemanticAstCollectionMemberReadFormalRoot(
                            artifact, signatures, surfaces.expression_graph,
                            surfaces.function_node_ids[surface], syntax_id, node, identity);
                        if read_root == 0 { read_root = SemanticAstCollectionMemberReadLocalRoot(artifact, locals,
                            inferred_types, surfaces.expression_graph, surfaces.function_node_ids[surface], syntax_id, node, identity); }
                        if read_root > 0 { MapSet(readable_members, ToString(node), read_root); }
                    }
                    // Postfix graph member selectors are leaves, but they are
                    // field identity, not lexical local use.  The expression
                    // identity owner applies the same topology rule when it
                    // carries binding identities.
                    let next_member: SemanticMemberAccessView =
                        SemanticMemberAccessViewFromGraph(surfaces.expression_graph, node + 1);
                    let binding_use: SemanticAstLocalBindingIdentity =
                        SemanticAstLocalBindingIdentityUnresolved();
                    if node + 1 > root_id || !next_member.ok || next_member.member_node != node {
                        binding_use =
                            SemanticAstScopedLocalBindingIdentityForGraphLeaf(
                                artifact, locals, inferred_types,
                                surfaces.function_node_ids[surface], syntax_id,
                                surfaces.expression_graph, node);
                    }
                    if binding_use.ok {
                        let local_use: Int = SemanticAstCollectionMemberReadLocalRootUse(
                            artifact, signatures, constructors, locals, inferred_types, resolved_leaf_types,
                            surfaces.expression_graph, contexts, surfaces.function_node_ids[surface], syntax_id,
                            root_slot % 3 == AstExpressionLaneAtom() && SemanticAstAssignmentContainsNode(assignments, syntax_id),
                            node, root_id);
                        if local_use < 0 { MapSet(unproved_read_roots, ToString(binding_use.declaration_node_id), 1); }
                    }
                    if binding_use.ok && MapHas(retired_locals,
                            ToString(binding_use.declaration_node_id)) &&
                        syntax_id > MapGet(retired_locals,
                            ToString(binding_use.declaration_node_id)) {
                        return SemanticAstCollectionMemberMoveUsePublish(artifact, contexts, true, syntax_id, node, capture,
                            restored, restoration_sites, readable_members, unproved_read_roots, element_escape_roots, nested_blocked,
                            readonly_origins,
                            read_sources, read_targets, escape_sources, escape_targets, escape_sites,
                            nested_nodes, nested_roots, nested_lend_sources, nested_lend_targets);
                    }
                    node = node + 1;
                }
            }
        }
        root_slot = root_slot + 1;
    }
    return SemanticAstCollectionMemberMoveUsePublish(artifact, contexts, false, -1, -1, capture,
        restored, restoration_sites, readable_members, unproved_read_roots, element_escape_roots, nested_blocked,
        readonly_origins,
        read_sources, read_targets, escape_sources, escape_targets, escape_sites,
        nested_nodes, nested_roots, nested_lend_sources, nested_lend_targets);
}
