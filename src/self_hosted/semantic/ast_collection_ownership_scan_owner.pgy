// One ordered ownership scan over admitted facts. The caller owns scratch
// retirement; every normal exit fills the same typed verdict before returning.
// Void execution keeps scratch mutation separate from resource-result carriage.
import "ast_collection_ownership_statement_transition_owner.pgy";
import "ast_collection_lifetime_event_order_owner.pgy";
import "ast_collection_indexed_string_borrow_owner.pgy";
import "ast_collection_map_payload_use_owner.pgy";
import "ast_collection_aggregate_release_transition_owner.pgy";
import "ast_owned_string_literal_transfer_owner.pgy";
import "ast_collection_read_literal_argument_owner.pgy";
import "ast_collection_call_argument_verdict_owner.pgy";
import "ast_collection_element_escape_entry_owner.pgy";
import "ast_collection_exclusive_value_mutation_owner.pgy";
import "ast_collection_exclusive_statement_mutation_owner.pgy";
import "ast_collection_builtin_transition_owner.pgy";
import "ast_collection_definition_transition_owner.pgy";
import "ast_collection_owned_result_return_owner.pgy";
import "ast_collection_ownership_argument_transfer_owner.pgy";
import "ast_collection_ownership_member_restoration_owner.pgy";
import "ast_collection_aggregate_release_element_borrow_owner.pgy";
import "ast_collection_call_effect_owner.pgy";
import "ast_collection_ownership_receipt_owner.pgy";
import "ast_collection_ownership_verdict_carrier_owner.pgy";
import "ast_collection_member_read_completion_owner.pgy";
import "ast_body_flow_verdict_owner.pgy";
import "ast_collection_ownership_finalization_owner.pgy";
import "ast_collection_ownership_projection_owner.pgy";

func SemanticAstCollectionOwnershipScanIntoVerdict(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    ref locals: SemanticAstLocalBindingFacts,
    ref initializer_types: SemanticAstInitializerTypeFacts,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref resolved_leaf_types: Array<String>,
    ref numeric_string_allocations: SemanticAstNumericStringAllocationCalls,
    ref owned_string_results: SemanticAstOwnedStringResultFacts,
    ref statements: SemanticAstStatementFacts, ref assignments: SemanticAstAssignmentFacts,
    ref formal_effects: SemanticAstCollectionFormalEffects,
    ref owned_string_store_clone_nodes: Array<Int>,
    ref owned_string_store_nodes: Array<Int>,
    ref body_termination: SemanticAstBodyTerminationFacts,
    ref owned_result_plan: SemanticAstFreshOwnedStringArrayResultPlan,
    ref definitions: SemanticAstCollectionDefinitionFacts,
    ref storage: SemanticAstCollectionStorageAuthorityFacts,
    ref moved_use: SemanticAstCollectionMemberMoveUse,
    ref element_requirements: HashMap<String, Int>,
    ref field_requirements: SemanticAstCollectionAggregateFieldEntryRequirements,
    inout ownership: Array<Int>, inout dispositions: Array<Int>,
    inout origins: Array<Int>, inout transition_states: Array<Int>,
    inout origin_syntax_ids: Array<Int>, inout source_binding_syntax_ids: Array<Int>,
    ref member_path_starts: Array<Int>, ref member_path_counts: Array<Int>,
    ref member_path_field_syntax_ids: Array<Int>,
    inout current_definitions: Array<Int>,
    own receipts: SemanticAstCollectionOwnershipReceiptRows,
    inout literal_transfers: SemanticAstOwnedStringLiteralTransferFacts,
    inout call_effects: SemanticAstCollectionCallEffectFacts,
    inout aggregate_release_plan: SemanticAstCollectionAggregateReleasePlan,
    inout indexed_string_borrows: SemanticAstIndexedStringBorrowState,
    inout retained_definitions: Array<Bool>,
    inout exclusive_values: SemanticAstCollectionExclusiveValueFacts,
    mutating_formals: HashMap<String, Int>,
    ref focus_recovery: SemanticAstCollectionFocusRecoveryFacts,
    inout verdict: SemanticAstCollectionOwnershipVerdict
) -> Void {
    // Unpublished exact-consumption scratch. This descriptor cannot escape
    // the scan; physical HashMap reclamation remains the backend's contract.
    var retired_arguments: HashMap<String, Int> = MapNew();
    var sink_consumed: HashMap<String, Int> = MapNew();
    let released_fields: SemanticAstCollectionReleasedFields =
        SemanticAstCollectionReleasedFieldsFrom(constructors, field_requirements);
    var root_slot: Int = 0;
    // Constructor selections precede source-ordered mutation selections.
    // Keep the exact landing projection separate from the structural copy
    // graph so the scan never copies that graph merely to append a node id.
    var compiler_clone_expression_node_ids: Array<Int> =
        SemanticAstCollectionExclusiveCompilerCloneNodes(
            exclusive_values.copies);
    var planned_clone: Int = 0;
    while planned_clone < ArrayLength(owned_string_store_clone_nodes) {
        let node: Int = owned_string_store_clone_nodes[planned_clone];
        if !SemanticAstCollectionExclusiveCompilerCloneNodeSelected(
                compiler_clone_expression_node_ids, node) &&
            !SemanticAstCollectionExclusiveSelectCompilerCloneNode(
                compiler_clone_expression_node_ids, node) {
            verdict = SemanticAstCollectionOwnershipVerdictError(
                "ast_artifact_invalid",
                SemanticError1("ast_artifact_invalid", "owner",
                    "owned_string_store_landing_projection"), -1, -1);
            return;
        }
        planned_clone = planned_clone + 1;
    }
    while root_slot < ArrayLength(surfaces.expression_graph.roots) {
        // Each syntax event precedes its own call lanes, not every call in the
        // program. Keeping statements first also closes same-syntax RHS effects.
        if root_slot % 3 == 0 {
            let mutation_proof: SemanticAstCollectionExclusiveStatementMutationProof = SemanticAstCollectionExclusiveStatementRootReady(artifact, signatures, locals,
                    initializer_types.inferred_type_names, surfaces, statements, assignments,
                    exclusive_values.shared_locals, mutating_formals, origins, source_binding_syntax_ids,
                    surfaces.function_node_ids[root_slot / 3], surfaces.node_ids[root_slot / 3], focus_recovery,
                    exclusive_values.copies, compiler_clone_expression_node_ids, call_effects, current_definitions, exclusive_values.surface_starts, exclusive_values.surface_ends);
            if !mutation_proof.ok {
                verdict = SemanticAstCollectionOwnershipVerdictError("borrow_boundary_escape",
                    SemanticError2("borrow_boundary_escape", "boundary", "unproved_exclusive_member_mutation",
                        "type", "Array<String>"),
                    surfaces.node_ids[root_slot / 3], -1); return;
            }
            let statement_transitions: SemanticAstCollectionStatementTransitionResult = SemanticAstCollectionStatementTransitionForSyntax(artifact, signatures, locals, initializer_types,
                    surfaces, statements, assignments, surfaces.node_ids[root_slot / 3], call_effects, definitions,
                    storage, current_definitions, ownership, dispositions, origins, transition_states,
                    owned_string_results, numeric_string_allocations,
                    compiler_clone_expression_node_ids,
                    owned_string_store_nodes,
                    element_requirements,
                    mutation_proof.compiler_clone_storage_detached, receipts);
            if !statement_transitions.ok {
                verdict = SemanticAstCollectionOwnershipVerdictError(statement_transitions.diagnostic_code,
                    statement_transitions.diagnostic_message, statement_transitions.syntax_node_id, -1); return;
            }
        }
        if surfaces.expression_graph.has_roots[root_slot] {
            let root: Int = surfaces.expression_graph.roots[root_slot];
            if !SemanticAstCollectionLifetimeRootReady(surfaces.expression_graph, root) {
                verdict = SemanticAstCollectionOwnershipVerdictError("ast_artifact_invalid",
                    SemanticError1("ast_artifact_invalid", "owner", "collection_lifetime_event_order"),
                    surfaces.node_ids[root_slot / 3], root); return;
            }
            var pending: Array<Int> = [root];
            var prefixes: Array<Bool> = [false];
            while ArrayLength(pending) > 0 {
                let entry: Int = pending[ArrayLength(pending) - 1];
                let prefix: Bool = prefixes[ArrayLength(prefixes) - 1];
                ArrayPop(pending); ArrayPop(prefixes);
                let step: SemanticAstCollectionLifetimeEventStep = SemanticAstCollectionLifetimeEventStepFromGraph(
                    surfaces.expression_graph, entry, prefix);
                if !step.ok {
                    ArrayDrop(pending); ArrayDrop(prefixes);
                    verdict = SemanticAstCollectionOwnershipVerdictError("ast_artifact_invalid",
                        SemanticError1("ast_artifact_invalid", "owner", "collection_lifetime_event_order"),
                        surfaces.node_ids[root_slot / 3], root); return;
                }
                if step.completion < 0 { ArrayPush(pending, step.completion); ArrayPush(prefixes, prefix); }
                if step.right >= 0 { ArrayPush(pending, step.right); ArrayPush(prefixes, false); }
                if step.left >= 0 { ArrayPush(pending, step.left); ArrayPush(prefixes, step.left_prefix); }
                let node: Int = step.event_node;
                let indexed_string_use: SemanticAstCollectionOwnershipVerdict =
                    SemanticAstIndexedStringBorrowUseAtEvent(
                        artifact, locals,
                        initializer_types.inferred_type_names, surfaces,
                        assignments, indexed_string_borrows, root_slot, node
                    );
                if !indexed_string_use.ok {
                    ArrayDrop(pending); ArrayDrop(prefixes);
                    verdict = indexed_string_use; return;
                }
                let owned_element_use: SemanticAstCollectionOwnershipVerdict =
                    SemanticAstCollectionOwnedElementEscapeAtEvent(
                        artifact, signatures, constructors, locals,
                        initializer_types.inferred_type_names, resolved_leaf_types, surfaces,
                        assignments, formal_effects.borrowed_text_formals,
                        released_fields.ok, released_fields.field_ids, released_fields.names,
                        ownership, origins, transition_states,
                        origin_syntax_ids,
                        compiler_clone_expression_node_ids,
                        root_slot, node);
                if !owned_element_use.ok {
                    ArrayDrop(pending); ArrayDrop(prefixes);
                    verdict = owned_element_use; return;
                }
                let aggregate_source_use:
                    SemanticAstCollectionOwnershipVerdict =
                    SemanticAstCollectionAggregateReleaseSourceUseAtEvent(
                        artifact, locals,
                        initializer_types.inferred_type_names, surfaces,
                        root_slot, node, definitions, current_definitions,
                        call_effects.constructor_inputs,
                        aggregate_release_plan);
                if !aggregate_source_use.ok {
                    ArrayDrop(pending); ArrayDrop(prefixes);
                    verdict = aggregate_source_use; return;
                }
                let kind: Option<Int> = SemanticExpressionGraphNodeKind(surfaces.expression_graph, node);
                if IsSome(kind) && UnwrapOption(kind) == AstExpressionNodeLeaf() {
                    let exact_use: SemanticAstCollectionOwnedArgumentUse = SemanticAstCollectionOwnedArgumentUseAtEvent(
                        artifact, signatures, locals, initializer_types.inferred_type_names, surfaces,
                        definitions, call_effects, current_definitions, retired_arguments, root_slot, node);
                    if exact_use.found {
                        ArrayDrop(pending); ArrayDrop(prefixes);
                        verdict = SemanticAstCollectionOwnershipVerdictError(exact_use.diagnostic_code,
                            SemanticError2(exact_use.diagnostic_code, "boundary", exact_use.boundary, "type", "Array<String>"),
                            exact_use.syntax_node_id, exact_use.expression_node_id); return;
                    }
                }
                if IsSome(kind) && UnwrapOption(kind) ==
                        AstExpressionNodeArrayElement() &&
                    !SemanticAstOwnedStringLiteralTransferObserveElement(
                        node, literal_transfers) {
                    ArrayDrop(pending); ArrayDrop(prefixes);
                    verdict = SemanticAstCollectionOwnershipVerdictError(
                        "borrow_boundary_escape",
                        SemanticError2("borrow_boundary_escape", "boundary",
                            "owned_string_literal_transfer", "type",
                            "String"), surfaces.node_ids[root_slot / 3], node); return;
                }
                if IsSome(kind) && UnwrapOption(kind) == AstExpressionNodeCallArgument() {
                    let edge: SemanticCallArgumentEdgeView = SemanticCallArgumentEdgeFromGraph(surfaces.expression_graph, node);
                    let scalar_transfer_verdict: SemanticAstCollectionOwnershipVerdict =
                        SemanticAstOwnedStringLiteralTransferCallArgumentVerdict(
                            artifact, signatures, locals, initializer_types,
                            surfaces, owned_string_results,
                            numeric_string_allocations,
                            literal_transfers,
                            root_slot / 3, root_slot % 3, edge);
                    if !scalar_transfer_verdict.ok {
                        ArrayDrop(pending); ArrayDrop(prefixes);
                        verdict = scalar_transfer_verdict; return;
                    }
                    let exact_use: SemanticAstCollectionOwnedArgumentUse = SemanticAstCollectionOwnedArgumentUseAtEvent(
                        artifact, signatures, locals, initializer_types.inferred_type_names, surfaces,
                        definitions, call_effects, current_definitions, retired_arguments, root_slot, node);
                    if exact_use.found {
                        ArrayDrop(pending); ArrayDrop(prefixes);
                        verdict = SemanticAstCollectionOwnershipVerdictError(exact_use.diagnostic_code,
                            SemanticError2(exact_use.diagnostic_code, "boundary", exact_use.boundary, "type", "Array<String>"),
                            exact_use.syntax_node_id, exact_use.expression_node_id); return;
                    }
                    let literal_read_ready: Bool =
                        SemanticAstCollectionReadLiteralArgumentReady(
                            artifact, signatures, locals, initializer_types,
                            surfaces, owned_string_results,
                            numeric_string_allocations, formal_effects.effects,
                            root_slot / 3, root_slot % 3, edge);
                    let exclusive_boundary: String = SemanticAstCollectionExclusiveArgumentBoundary(
                        artifact, signatures, constructors, locals, initializer_types.inferred_type_names, surfaces,
                        assignments, exclusive_values, mutating_formals, sink_consumed,
                        surfaces.function_node_ids[root_slot / 3], surfaces.node_ids[root_slot / 3], edge, focus_recovery,
                        formal_effects, surfaces.expression_graph.roots[root_slot]);
                    if exclusive_boundary != "" {
                        ArrayDrop(pending); ArrayDrop(prefixes);
                        verdict = SemanticAstCollectionOwnershipVerdictError("borrow_boundary_escape",
                            SemanticError2("borrow_boundary_escape", "boundary", exclusive_boundary,
                                "type", "nominal aggregate"),
                            surfaces.node_ids[root_slot / 3], edge.call_node); return;
                    }
                    let member_root_ready: Bool = SemanticAstCollectionExclusiveAliasRootReadyAt(
                        artifact, signatures, locals, initializer_types.inferred_type_names, surfaces,
                        exclusive_values.shared_locals, mutating_formals, origins, source_binding_syntax_ids,
                        root_slot / 3, edge.argument_node, focus_recovery);
                    let element_escape_ready: Bool = SemanticAstCollectionElementEscapeEntryReady(
                        artifact, signatures, constructors, locals, initializer_types.inferred_type_names,
                        resolved_leaf_types, surfaces, root_slot / 3,
                        edge, formal_effects.effects, released_fields.ok, released_fields.field_ids,
                        released_fields.names, ownership, dispositions, origins,
                        transition_states, origin_syntax_ids);
                    let argument_verdict: SemanticAstCollectionOwnershipVerdict = SemanticAstCollectionCallArgumentVerdict(
                        artifact, signatures, locals, initializer_types.inferred_type_names, surfaces, root_slot / 3,
                        edge, literal_read_ready, SemanticAstCollectionMemberIndexedReadReady(
                            artifact, signatures, surfaces, moved_use, formal_effects, call_effects,
                            root_slot / 3, edge),
                        element_escape_ready, member_root_ready, formal_effects.effects,
                        formal_effects.owned_push_leaf_formals,
                        element_requirements, field_requirements,
                        ownership, dispositions, origins,
                        transition_states, call_effects, storage, definitions,
                        current_definitions, retained_definitions);
                    if !argument_verdict.ok {
                        ArrayDrop(pending); ArrayDrop(prefixes);
                        verdict = argument_verdict; return;
                    }
                    if exact_use.retirement_source > 0 {
                        MapSet(retired_arguments, ToString(exact_use.retirement_source), exact_use.retirement_site);
                    }
                }
                if step.completed_call >= 0 {
                    // A MapGet String is a loan of the map value; MapSet,
                    // MapRemove and a mutating hand-off of the map end it.
                    let map_payload_event: SemanticAstCollectionOwnershipVerdict =
                        SemanticAstMapStringPayloadAtCallCompletion(artifact, signatures, constructors,
                            locals, initializer_types.inferred_type_names, surfaces, assignments,
                            definitions, storage, current_definitions,
                            formal_effects.borrowed_text_formals, mutating_formals,
                            indexed_string_borrows, root_slot, step.completed_call, node);
                    if !map_payload_event.ok {
                        ArrayDrop(pending); ArrayDrop(prefixes);
                        verdict = map_payload_event; return;
                    }
                    let aggregate_reservation:
                        SemanticAstCollectionOwnershipVerdict =
                        SemanticAstCollectionAggregateReleaseReserveAtCompletion(
                            artifact, constructors, locals, initializer_types.inferred_type_names, surfaces, root_slot / 3,
                            step.completed_call, call_effects, storage,
                            definitions, current_definitions, ownership,
                            dispositions, origins, transition_states,
                            aggregate_release_plan);
                    if !aggregate_reservation.ok {
                        ArrayDrop(pending); ArrayDrop(prefixes);
                        verdict = aggregate_reservation; return;
                    }
                    let aggregate_owned_push_leaf:
                        SemanticAstCollectionOwnershipVerdict =
                        SemanticAstCollectionAggregateOwnedPushLeafAtCompletion(
                            artifact, signatures, locals,
                            initializer_types.inferred_type_names,
                            surfaces, root_slot / 3,
                            step.completed_call, node,
                            formal_effects.owned_push_leaf_formals,
                            field_requirements, aggregate_release_plan,
                            ownership, dispositions, origins,
                            transition_states);
                    if !aggregate_owned_push_leaf.ok {
                        ArrayDrop(pending); ArrayDrop(prefixes);
                        verdict = aggregate_owned_push_leaf; return;
                    }
                    let completed: SemanticCallSpineView = SemanticCallSpineViewFromGraph(surfaces.expression_graph, node);
                    var receiver_root_ready: Bool = true;
                    if completed.ok && ArrayLength(completed.argument_nodes) > 0 {
                        receiver_root_ready = SemanticAstCollectionExclusiveAliasRootReadyAt(
                            artifact, signatures, locals, initializer_types.inferred_type_names, surfaces,
                            exclusive_values.shared_locals, mutating_formals, origins, source_binding_syntax_ids,
                            root_slot / 3, completed.argument_nodes[0], focus_recovery);
                    }
                    let builtin_transition: SemanticAstCollectionOwnershipVerdict = SemanticAstCollectionBuiltinTransitionAtCompletion(
                        artifact, locals, initializer_types.inferred_type_names, signatures, surfaces, root_slot / 3,
                        step.completed_call, node, receiver_root_ready, call_effects,
                        field_requirements, aggregate_release_plan,
                        ownership, dispositions, origins, transition_states,
                        receipts);
                    if !builtin_transition.ok {
                        ArrayDrop(pending); ArrayDrop(prefixes);
                        verdict = builtin_transition; return;
                    }
                    if !SemanticAstIndexedStringBorrowRecordDeepDrop(
                            artifact, locals,
                            initializer_types.inferred_type_names, surfaces,
                            definitions, storage, current_definitions,
                            indexed_string_borrows, root_slot / 3,
                            step.completed_call, node) {
                        ArrayDrop(pending); ArrayDrop(prefixes);
                        verdict = SemanticAstCollectionOwnershipVerdictError(
                            "ast_artifact_invalid",
                            SemanticError1("ast_artifact_invalid", "owner",
                                "indexed_string_deep_drop"),
                            surfaces.node_ids[root_slot / 3], node
                        ); return;
                    }
                    let loop_use: SemanticAstCollectionOwnershipVerdict = SemanticAstMapStringPayloadLoopUseAtMutation(
                        artifact, locals, initializer_types.inferred_type_names, surfaces,
                        indexed_string_borrows, root_slot, node);
                    if !loop_use.ok { ArrayDrop(pending); ArrayDrop(prefixes); verdict = loop_use; return; }
                }
                if entry < 0 {
                    let completed_value: SemanticAstCollectionOwnershipVerdict = SemanticAstMapStringPayloadAtValueCompletion(
                        artifact, locals, initializer_types.inferred_type_names, surfaces, assignments, definitions, storage,
                        current_definitions, indexed_string_borrows, root_slot, 0 - entry - 1);
                    if !completed_value.ok { ArrayDrop(pending); ArrayDrop(prefixes); verdict = completed_value; return; }
                }
            }
            ArrayDrop(pending); ArrayDrop(prefixes);
            let definition_use: SemanticAstCollectionOwnedArgumentUse = SemanticAstCollectionOwnedArgumentDefinitionAtSlot(
                artifact, signatures, locals, surfaces, definitions, call_effects, statements, assignments, root_slot, root);
            if definition_use.found {
                verdict = SemanticAstCollectionOwnershipVerdictError(definition_use.diagnostic_code,
                    SemanticError2(definition_use.diagnostic_code, "boundary", definition_use.boundary, "type", "Array<String>"),
                    definition_use.syntax_node_id, definition_use.expression_node_id); return;
            }
            if definition_use.retirement_source > 0 {
                MapSet(retired_arguments, ToString(definition_use.retirement_source), definition_use.retirement_site);
            }
        }
        let completed: SemanticAstCollectionOwnershipVerdict = SemanticAstCollectionCompleteDefinition(
            artifact, locals, surfaces, definitions, storage, root_slot, current_definitions, call_effects,
            ownership, dispositions, origins, origin_syntax_ids, transition_states, source_binding_syntax_ids);
        if !completed.ok { verdict = completed; return; }
        let completed_definition: Int =
            SemanticAstCollectionDefinitionCompletedAtSlot(
                definitions, locals, surfaces, root_slot);
        if !SemanticAstOwnedStringLiteralTransferCompleteDefinition(
                root_slot, completed_definition, literal_transfers,
                ownership, dispositions, origins, transition_states,
                origin_syntax_ids, source_binding_syntax_ids) {
            verdict = SemanticAstCollectionOwnershipVerdictError(
                "borrow_boundary_escape",
                SemanticError2("borrow_boundary_escape", "boundary",
                    "owned_string_literal_transfer_completion", "type",
                    "String"), surfaces.node_ids[root_slot / 3], -1); return;
        }
        let returned_owned_result: SemanticAstCollectionOwnershipVerdict =
            SemanticAstFreshOwnedStringArrayReturnTransfer(
                artifact, signatures, locals, initializer_types, surfaces,
                statements, owned_result_plan, definitions, storage,
                call_effects, current_definitions, root_slot, ownership,
                dispositions, origins, transition_states);
        if !returned_owned_result.ok { verdict = returned_owned_result; return; }
        if !SemanticAstIndexedStringBorrowCompleteValue(
                artifact, locals, initializer_types.inferred_type_names,
                surfaces, assignments, definitions, storage,
                current_definitions, indexed_string_borrows, root_slot) {
            verdict = SemanticAstCollectionOwnershipVerdictError(
                "ast_artifact_invalid",
                SemanticError1("ast_artifact_invalid", "owner",
                    "indexed_string_borrow_completion"),
                surfaces.node_ids[root_slot / 3], -1
            ); return;
        }
        root_slot = root_slot + 1;
    }
    let finalized: SemanticAstCollectionOwnershipVerdict =
        SemanticAstCollectionOwnershipFinalize(
            artifact, signatures, constructors, locals,
            initializer_types.inferred_type_names, resolved_leaf_types,
            surfaces, assignments, literal_transfers, moved_use,
            aggregate_release_plan, exclusive_values, field_requirements,
            formal_effects, compiler_clone_expression_node_ids, call_effects,
            statements, body_termination, ownership, dispositions,
            transition_states);
    if !finalized.ok { verdict = finalized; return; }
    verdict = SemanticAstCollectionOwnershipProjectFacts(
        locals, initializer_types.inferred_type_names,
        origin_syntax_ids, source_binding_syntax_ids,
        member_path_starts, member_path_counts,
        member_path_field_syntax_ids, ownership, dispositions, origins,
        owned_result_plan, compiler_clone_expression_node_ids, receipts);
    return;
}
