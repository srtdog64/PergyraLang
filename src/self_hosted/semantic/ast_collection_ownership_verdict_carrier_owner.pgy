// Collection-ownership verdict carrier and its canonical constructors.
//
// State policy lives in ast_collection_ownership_state_owner.pgy; callers must
// not rebuild success/error carriers with a parallel field order.

import "ast_collection_ownership_receipt_owner.pgy";

// One joint unpack/repack plan. Rows are subordinate to collection admission;
// neither a field name nor an exit kind is an ownership permission by itself.
struct SemanticAstCollectionFocusRecoveryFacts {
    ok: Bool;
    artifact_node_count: Int;
    artifact_identity_digest: Int;
    mutating_formals: HashMap<String, Int>;
    exclusive_copies: HashMap<String, Int>;
    exclusive_field_reads: HashMap<String, Int>;
    exclusive_copy_count: Int;
    exclusive_field_read_count: Int;
    group_function_ids: Array<Int>;
    group_root_binding_ids: Array<Int>;
    group_scope_ids: Array<Int>;
    group_activation_ids: Array<Int>;
    group_end_ids: Array<Int>;
    group_part_starts: Array<Int>;
    group_part_counts: Array<Int>;
    group_root_type_names: Array<String>;
    group_copy_signatures: Array<String>;
    part_local_binding_ids: Array<Int>;
    part_definition_ids: Array<Int>;
    part_field_ids: Array<Int>;
    part_field_names: Array<String>;
    part_type_names: Array<String>;
    exit_group_indices: Array<Int>;
    exit_function_ids: Array<Int>;
    exit_scope_ids: Array<Int>;
    exit_syntax_ids: Array<Int>;
    exit_kinds: Array<Int>;
    exit_part_starts: Array<Int>;
    exit_part_counts: Array<Int>;
    active_part_indices: Array<Int>;
    active_definition_ids: Array<Int>;
}

func SemanticAstCollectionFocusRecoveryFactsEmpty() -> SemanticAstCollectionFocusRecoveryFacts {
    let ints: Array<Int> = [];
    let names: Array<String> = [];
    let mutating: HashMap<String, Int> = MapNew();
    let copies: HashMap<String, Int> = MapNew();
    let field_reads: HashMap<String, Int> = MapNew();
    return SemanticAstCollectionFocusRecoveryFacts(false, 0, 0,
        mutating, copies, field_reads, 0, 0,
        ints, ints, ints, ints, ints, ints, ints, names, names,
        ints, ints, ints, names, names,
        ints, ints, ints, ints, ints, ints, ints, ints, ints);
}

func SemanticAstCollectionFocusExitValueReturn() -> Int { return 1; }
func SemanticAstCollectionFocusExitBareReturn() -> Int { return 2; }
func SemanticAstCollectionFocusExitFallthrough() -> Int { return 3; }
func SemanticAstCollectionFocusExitBreak() -> Int { return 4; }
func SemanticAstCollectionFocusExitContinue() -> Int { return 5; }
func SemanticAstCollectionFocusExitTryError() -> Int { return 6; }

struct SemanticAstCollectionOwnershipVerdict {
    ok: Bool;
    diagnostic_code: String;
    diagnostic_message: String;
    syntax_node_id: Int;
    expression_node_id: Int;
    function_syntax_ids: Array<Int>;
    binding_syntax_ids: Array<Int>;
    origin_syntax_ids: Array<Int>;
    source_binding_syntax_ids: Array<Int>;
    element_ownerships: Array<Int>;
    dispositions: Array<Int>;
    origins: Array<Int>;
    fresh_owned_result_function_syntax_ids: Array<Int>;
    receipts: SemanticAstCollectionOwnershipReceiptRows;
    focus_recovery: SemanticAstCollectionFocusRecoveryFacts;
}

func SemanticAstCollectionOwnershipVerdictOk(
) -> SemanticAstCollectionOwnershipVerdict {
    let function_syntax_ids: Array<Int> = [];
    let binding_syntax_ids: Array<Int> = [];
    let origin_syntax_ids: Array<Int> = [];
    let source_binding_syntax_ids: Array<Int> = [];
    let element_ownerships: Array<Int> = [];
    let dispositions: Array<Int> = [];
    let origins: Array<Int> = [];
    let fresh_owned_result_function_syntax_ids: Array<Int> = [];
    return SemanticAstCollectionOwnershipVerdict(
        true, "", "", -1, -1,
        function_syntax_ids, binding_syntax_ids, origin_syntax_ids,
        source_binding_syntax_ids, element_ownerships, dispositions, origins,
        fresh_owned_result_function_syntax_ids,
        SemanticAstCollectionOwnershipReceiptRowsEmpty(),
        SemanticAstCollectionFocusRecoveryFactsEmpty()
    );
}

func SemanticAstCollectionOwnershipVerdictOkWithFacts(
    function_syntax_ids: Array<Int>,
    binding_syntax_ids: Array<Int>,
    origin_syntax_ids: Array<Int>,
    source_binding_syntax_ids: Array<Int>,
    element_ownerships: Array<Int>,
    dispositions: Array<Int>,
    origins: Array<Int>,
    fresh_owned_result_function_syntax_ids: Array<Int>,
    receipts: SemanticAstCollectionOwnershipReceiptRows
) -> SemanticAstCollectionOwnershipVerdict {
    return SemanticAstCollectionOwnershipVerdict(
        true, "", "", -1, -1,
        function_syntax_ids, binding_syntax_ids, origin_syntax_ids,
        source_binding_syntax_ids, element_ownerships, dispositions, origins,
        fresh_owned_result_function_syntax_ids,
        receipts, SemanticAstCollectionFocusRecoveryFactsEmpty()
    );
}

func SemanticAstCollectionOwnershipVerdictError(
    code: String, message: String,
    syntax_node_id: Int, expression_node_id: Int
) -> SemanticAstCollectionOwnershipVerdict {
    let function_syntax_ids: Array<Int> = [];
    let binding_syntax_ids: Array<Int> = [];
    let origin_syntax_ids: Array<Int> = [];
    let source_binding_syntax_ids: Array<Int> = [];
    let element_ownerships: Array<Int> = [];
    let dispositions: Array<Int> = [];
    let origins: Array<Int> = [];
    let fresh_owned_result_function_syntax_ids: Array<Int> = [];
    return SemanticAstCollectionOwnershipVerdict(
        false, code, message,
        syntax_node_id, expression_node_id,
        function_syntax_ids, binding_syntax_ids, origin_syntax_ids,
        source_binding_syntax_ids, element_ownerships, dispositions, origins,
        fresh_owned_result_function_syntax_ids,
        SemanticAstCollectionOwnershipReceiptRowsEmpty(),
        SemanticAstCollectionFocusRecoveryFactsEmpty()
    );
}
