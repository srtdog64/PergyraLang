// Array<String> element-lifetime provenance at semantic call boundaries.
//
// Stable local declaration identity owns the state.  This verdict consumes the
// already admitted expression graph once; MIR and backends may not infer deep
// release permission from the projected Array<String> type.

import "ast_artifact_verdict_owner.pgy";
import "ast_expression_graph_array_literal_owner.pgy";
import "ast_expression_graph_call_view_owner.pgy";
import "ast_expression_call_target_fact_owner.pgy";
import "ast_expression_graph_node_view_owner.pgy";
import "ast_expression_graph_view_owner.pgy";
import "ast_expression_call_identity_owner.pgy";
import "ast_local_binding_identity_owner.pgy";
import "ast_initializer_type_fact_owner.pgy";
import "ast_statement_fact_owner.pgy";
import "ast_assignment_fact_owner.pgy";
import "ast_assignment_type_fact_owner.pgy";
import "ast_collection_ownership_receipt_owner.pgy";
import "ast_collection_ownership_state_owner.pgy";
import "ast_collection_ownership_verdict_carrier_owner.pgy";
import "ast_collection_ownership_identity_owner.pgy";
import "ast_collection_ownership_assignment_alias_owner.pgy";
import "ast_collection_definition_transition_owner.pgy";
import "ast_collection_owned_result_plan_owner.pgy";
import "ast_collection_owned_result_definition_owner.pgy";
import "ast_collection_owned_result_return_owner.pgy";
import "ast_collection_ownership_binding_move_use_owner.pgy";
import "ast_collection_ownership_member_transition_owner.pgy";
import "ast_collection_ownership_argument_transfer_owner.pgy";
import "ast_collection_owned_element_parameter_requirement_owner.pgy";
import "ast_collection_ownership_statement_transition_owner.pgy";
import "ast_collection_call_effect_owner.pgy";
import "ast_collection_call_argument_verdict_owner.pgy";
import "ast_collection_read_literal_argument_owner.pgy";
import "ast_collection_lifetime_event_order_owner.pgy";
import "ast_collection_builtin_transition_owner.pgy";
import "ast_collection_indexed_string_borrow_owner.pgy";
import "ast_collection_aggregate_release_plan_owner.pgy";
import "ast_collection_aggregate_release_transition_owner.pgy";
import "ast_collection_formal_use_owner.pgy";
import "ast_owned_string_result_domain_owner.pgy";
import "ast_owned_string_literal_transfer_owner.pgy";
import "ast_builtin_argument_retention_call_fact_owner.pgy";
import "ast_signature_fact_owner.pgy";
import "array_type_shape_owner.pgy";
import "diagnostic_owner.pgy";
import "ast_collection_ownership_scan_owner.pgy";

func SemanticAstCollectionOwnershipVerdictFromResolvedFactsWithFormalEffects(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts, ref locals: SemanticAstLocalBindingFacts,
    ref initializer_types: SemanticAstInitializerTypeFacts, ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref function_scopes: SemanticAstFunctionScopeFacts,
    ref resolved_leaf_types: Array<String>,
    ref numeric_string_allocations: SemanticAstNumericStringAllocationCalls,
    ref call_roots: SemanticCallSpineRoots,
    ref owned_string_results: SemanticAstOwnedStringResultFacts,
    ref statements: SemanticAstStatementFacts, ref assignments: SemanticAstAssignmentFacts,
    ref assignment_types: SemanticAstAssignmentTypeFacts,
    ref formal_effects: SemanticAstCollectionFormalEffects
) -> SemanticAstCollectionOwnershipVerdict {
    let local_count: Int = ArrayLength(locals.node_ids);
    if !SemanticAstExpressionSurfaceBorrowReady(artifact, surfaces) ||
        !SemanticAstLocalBindingIdentityRowsReady(
            locals, initializer_types.inferred_type_names) ||
        ArrayLength(initializer_types.node_ids) != local_count ||
        !SemanticExpressionGraphCarriedCallTargetsReady(
            surfaces.expression_graph) || !statements.ok ||
        ArrayLength(resolved_leaf_types) != SemanticExpressionGraphArenaNodeCount(surfaces.expression_graph.arena) ||
        !SemanticAstNumericStringAllocationCallsReady(numeric_string_allocations) ||
        !SemanticAstBuiltinArgumentRetentionCallFactsReady(
            surfaces) ||
        !call_roots.ok || ArrayLength(call_roots.root_nodes) != SemanticExpressionGraphArenaNodeCount(surfaces.expression_graph.arena) ||
        !assignments.ok || !assignment_types.ok ||
        ArrayLength(assignments.node_ids) !=
            ArrayLength(assignment_types.node_ids) {
        return SemanticAstCollectionOwnershipVerdictError(
            "ast_artifact_invalid",
            SemanticError1("ast_artifact_invalid", "owner",
                "SemanticAstCollectionOwnershipVerdict"), -1, -1);
    }
    let owned_result_plan: SemanticAstFreshOwnedStringArrayResultPlan =
        SemanticAstFreshOwnedStringArrayResultPlanFromResolvedFacts(
            artifact, signatures, locals, initializer_types, surfaces,
            statements);
    if !SemanticAstFreshOwnedStringArrayResultPlanReady(
            owned_result_plan, signatures) {
        return SemanticAstCollectionOwnershipVerdictError(
            "ast_artifact_invalid",
            SemanticError1("ast_artifact_invalid", "owner",
                "collection_owned_result_plan"), -1, -1);
    }
    let definitions: SemanticAstCollectionDefinitionFacts = SemanticAstCollectionDefinitionFactsFromResolvedFacts(
        artifact, signatures, locals, initializer_types.inferred_type_names, surfaces, assignments, assignment_types);
    if !definitions.ok {
        return SemanticAstCollectionOwnershipVerdictError("ast_artifact_invalid",
            SemanticError1("ast_artifact_invalid", "owner", "collection_assignment_definition"), -1, -1);
    }
    if !SemanticAstCollectionOwnedResultDefinitionsApply(
            signatures, surfaces, owned_result_plan, definitions) {
        return SemanticAstCollectionOwnershipVerdictError(
            "ast_artifact_invalid",
            SemanticError1("ast_artifact_invalid", "owner",
                "collection_owned_result_definition"), -1, -1);
    }
    let storage: SemanticAstCollectionStorageAuthorityFacts = SemanticAstCollectionStorageAuthorityFromDefinitions(
        signatures, locals, surfaces, definitions);
    if !storage.ok {
        return SemanticAstCollectionOwnershipVerdictError("ast_artifact_invalid",
            SemanticError1("ast_artifact_invalid", "owner", "collection_storage_authority"), -1, -1);
    }
    let literal_transfers: SemanticAstOwnedStringLiteralTransferFacts =
        SemanticAstOwnedStringLiteralTransferFactsFromDefinitions(
            artifact, signatures, locals, initializer_types, surfaces,
            owned_string_results, numeric_string_allocations, definitions);
    if !SemanticAstOwnedStringLiteralTransferFactsReady(literal_transfers) {
        return SemanticAstCollectionOwnershipVerdictError(
            "ast_artifact_invalid",
            SemanticError1("ast_artifact_invalid", "owner",
                "owned_string_literal_transfer"), -1, -1);
    }
    let ownership: Array<Int> = [];
    let dispositions: Array<Int> = [];
    let origins: Array<Int> = [];
    let transition_states: Array<Int> = [];
    let origin_syntax_ids: Array<Int> = [];
    let source_binding_syntax_ids: Array<Int> = [];
    let receipts: SemanticAstCollectionOwnershipReceiptRows =
        SemanticAstCollectionOwnershipReceiptRowsEmpty();
    let move_destinations: HashMap<String, Int> = MapNew();
    // Inventory rows are not evaluated values. Only Value completion selects
    // a definition, so a producer cannot authorize its own unfinished RHS.
    let current_definitions: Array<Int> = [];
    if !SemanticAstOwnedStringResultFactsReady(owned_string_results, signatures) {
        return SemanticAstCollectionOwnershipVerdictError(
            "ast_artifact_invalid",
            SemanticError1("ast_artifact_invalid", "owner",
                "SemanticAstOwnedStringResultFacts"), -1, -1);
    }
    let local_row: Int = 0;
    while local_row < local_count {
        ArrayPush(current_definitions, -1);
        ArrayPush(ownership, SemanticAstCollectionOwnershipUnknown());
        ArrayPush(dispositions, SemanticAstCollectionDispositionLive());
        ArrayPush(origins, SemanticAstCollectionOriginUnknown());
        ArrayPush(
            transition_states,
            SemanticAstCollectionTransitionUntracked()
        );
        ArrayPush(origin_syntax_ids, locals.node_ids[local_row]);
        ArrayPush(source_binding_syntax_ids, 0);
        if !SemanticAstCollectionOwnershipIsStringArray(
            initializer_types.inferred_type_names[local_row]) {
            local_row = local_row + 1;
            continue;
        }
        if locals.binding_kinds[local_row] !=
                SemanticAstLocalBindingKindNormal() ||
            locals.binding_indices[local_row] != 0 {
            return SemanticAstCollectionOwnershipVerdictError(
                "collection_ownership_unresolved",
                SemanticError2("collection_ownership_unresolved",
                    "boundary", "destructure_binding",
                    "type", "Array<String>"),
                locals.node_ids[local_row], -1);
        }
        let root: Option<Int> = SemanticAstExpressionGraphRootForNode(
            surfaces, locals.node_ids[local_row], AstExpressionLaneValue());
        if !IsSome(root) {
            return SemanticAstCollectionOwnershipVerdictError(
                "ast_artifact_invalid",
                SemanticError1("ast_artifact_invalid", "owner",
                    "collection_ownership_initializer_graph"),
                locals.node_ids[local_row], -1);
        }
        let root_id: Int = UnwrapOption(root);
        let root_kind: Option<Int> = SemanticExpressionGraphNodeKind(
            surfaces.expression_graph, root_id);
        if SemanticAstCollectionOwnershipLiteralIsEmpty(
            surfaces.expression_graph, root_id) {
            // Origin is exact; mutation/call-effect receipts must own any
            // later current-state refinement away from UNKNOWN.
            origins[local_row] = SemanticAstCollectionOriginEmptyLiteral();
            transition_states[local_row] =
                SemanticAstCollectionTransitionEmpty();
        } else if SemanticAstCollectionOwnershipLiteralIsBorrowed(
            surfaces.expression_graph, root_id) {
            ownership[local_row] =
                SemanticAstCollectionOwnershipBorrowedElements();
            origins[local_row] =
                SemanticAstCollectionOriginBorrowedLiteral();
        } else if SemanticAstCollectionOwnershipRootCallName(
            surfaces.expression_graph, root_id) == "MapKeys" {
            ownership[local_row] =
                SemanticAstCollectionOwnershipMapKeysSnapshot();
            origins[local_row] = SemanticAstCollectionOriginMapKeys();
        } else if SemanticAstCollectionOwnershipRootCallName(
            surfaces.expression_graph, root_id) == "Clone" {
            ownership[local_row] =
                SemanticAstCollectionOwnershipOwnedElements();
            origins[local_row] = SemanticAstCollectionOriginClone();
        } else if IsSome(root_kind) && UnwrapOption(root_kind) ==
                AstExpressionNodeCall() {
            let call_target: Option<Int> =
                SemanticExpressionGraphCallTargetSyntaxId(
                    surfaces.expression_graph, root_id
                );
            if IsSome(call_target) && UnwrapOption(call_target) > 0 {
                origins[local_row] =
                    SemanticAstCollectionOriginCallResult();
                origin_syntax_ids[local_row] = UnwrapOption(call_target);
            }
        } else if IsSome(root_kind) && UnwrapOption(root_kind) ==
                AstExpressionNodeMemberAccess() {
            let moved: SemanticAstCollectionMemberMoveIdentity =
                SemanticAstCollectionMemberMoveIdentityForNode(
                    artifact, signatures, constructors, locals, initializer_types.inferred_type_names, resolved_leaf_types,
                    locals.function_node_ids[local_row],
                    locals.node_ids[local_row], surfaces.expression_graph,
                    root_id);
            if moved.ok {
                origins[local_row] =
                    SemanticAstCollectionOriginMemberMove();
                origin_syntax_ids[local_row] = moved.field_syntax_id;
                source_binding_syntax_ids[local_row] =
                    moved.source_binding_syntax_id;
                MapSet(move_destinations,
                    SemanticAstCollectionMemberMoveEventKey(
                        moved, locals.node_ids[local_row]), locals.node_ids[local_row]);
            }
        } else {
            let source: SemanticAstLocalBindingIdentity =
                SemanticAstScopedLocalBindingIdentityForGraphLeaf(
                    artifact, locals, initializer_types.inferred_type_names,
                    locals.function_node_ids[local_row],
                    locals.node_ids[local_row],
                    surfaces.expression_graph, root_id);
            if source.ok {
                // The current RHS definition, not this initializer inventory,
                // owns element state and source retirement at Value completion.
                origins[local_row] = SemanticAstCollectionOriginBinding();
                source_binding_syntax_ids[local_row] =
                    locals.node_ids[source.row];
            }
        }
        local_row = local_row + 1;
    }
    let binding_move_use: SemanticAstCollectionBindingMoveUse =
        SemanticAstCollectionFirstInvalidBindingMoveUse(
            artifact, locals, initializer_types.inferred_type_names,
            surfaces, definitions, storage);
    if binding_move_use.found {
        return SemanticAstCollectionOwnershipVerdictError(
            "move_from_released",
            SemanticError2("move_from_released", "boundary",
                "binding_use_after_move", "type", "Array<String>"),
            binding_move_use.syntax_node_id,
            binding_move_use.expression_node_id);
    }
    let moved_use: SemanticAstCollectionMemberMoveUse =
        SemanticAstCollectionFirstInvalidMemberMoveUse(
            artifact, signatures, constructors, locals, initializer_types.inferred_type_names, resolved_leaf_types,
            surfaces, assignments, formal_effects.execution_contexts, move_destinations);
    if !moved_use.read_permission_ready {
        return SemanticAstCollectionOwnershipVerdictError("ast_artifact_invalid",
            SemanticError1("ast_artifact_invalid", "owner", "collection_member_read_permission"), -1, -1);
    }
    if moved_use.found {
        return SemanticAstCollectionOwnershipVerdictError(
            "move_from_released",
            SemanticError2("move_from_released", "boundary",
                "member_use_after_move", "type", "Array<String>"),
            moved_use.syntax_node_id, moved_use.expression_node_id);
    }
    let assignment_row: Int = 0;
    while assignment_row < ArrayLength(assignments.node_ids) {
        let alias: SemanticAstCollectionOwnershipAssignmentAliasFact =
            SemanticAstCollectionOwnershipAssignmentAliasAt(
                artifact, locals, initializer_types, surfaces,
                assignments, assignment_types, assignment_row);
        if !alias.ok {
            return SemanticAstCollectionOwnershipVerdictError(
                "ast_artifact_invalid",
                SemanticError1("ast_artifact_invalid", "owner",
                    "collection_ownership_assignment_join"),
                assignments.node_ids[assignment_row], -1);
        }
        if alias.candidate {
            return SemanticAstCollectionOwnershipVerdictError(
                "borrow_boundary_escape",
                SemanticError2("borrow_boundary_escape",
                    "boundary", "shallow_assignment",
                    "type", "Array<String>"),
                alias.syntax_node_id, alias.expression_node_id);
        }
        assignment_row = assignment_row + 1;
    }

    if !formal_effects.ok {
        return SemanticAstCollectionOwnershipVerdictError("ast_artifact_invalid",
            SemanticError1("ast_artifact_invalid", "owner", "collection_formal_effect"), -1, -1);
    }
    let call_effects: SemanticAstCollectionCallEffectFacts = SemanticAstCollectionCallEffectFactsFromResolvedFacts(
        artifact, signatures, constructors, locals, initializer_types.inferred_type_names,
        surfaces, formal_effects.inventory.row_by_formal,
        formal_effects.inventory.modes, formal_effects.effects,
        definitions, storage);
    if !SemanticAstCollectionCallEffectFactsReady(call_effects, local_count) {
        return SemanticAstCollectionOwnershipVerdictError("ast_artifact_invalid",
            SemanticError1("ast_artifact_invalid", "owner", "collection_call_effect_facts"), -1, -1);
    }

    let field_requirements: SemanticAstCollectionAggregateFieldEntryRequirements = SemanticAstCollectionAggregateFieldEntryRequirementsEmpty();
    let element_requirements: HashMap<String, Int> = SemanticAstCollectionOwnedElementParameterRequirements(
        artifact, locals, initializer_types.inferred_type_names, origins, source_binding_syntax_ids, origin_syntax_ids,
        signatures, surfaces, call_roots,
        formal_effects.owned_push_leaf_formals, field_requirements);
    if !SemanticAstCollectionAggregateFieldEntryRequirementsReady(field_requirements) {
        return SemanticAstCollectionOwnershipVerdictError("ast_artifact_invalid",
            SemanticError1("ast_artifact_invalid", "owner", "aggregate_field_entry_requirements"), -1, -1);
    }
    let aggregate_release_plan: SemanticAstCollectionAggregateReleasePlan =
        SemanticAstCollectionAggregateReleasePlanFromRequirements(
            artifact, signatures, constructors, locals,
            initializer_types.inferred_type_names, resolved_leaf_types,
            surfaces, statements, assignments, field_requirements,
            call_effects, storage, definitions);
    if !SemanticAstCollectionAggregateReleasePlanShapeReady(
            aggregate_release_plan) {
        return SemanticAstCollectionOwnershipVerdictError(
            "borrow_boundary_escape",
            SemanticError2("borrow_boundary_escape", "boundary",
                "aggregate_release_plan_unproved", "type",
                "Array<String>"),
            aggregate_release_plan.diagnostic_syntax_id, -1);
    }
    let indexed_string_borrows: SemanticAstIndexedStringBorrowState =
        SemanticAstIndexedStringBorrowStateForLocals(locals);
    if !indexed_string_borrows.ok {
        SemanticAstIndexedStringBorrowStateRetire(indexed_string_borrows);
        return SemanticAstCollectionOwnershipVerdictError(
            "ast_artifact_invalid",
            SemanticError1("ast_artifact_invalid", "owner",
                "indexed_string_borrow_state"), -1, -1);
    }
    // A continuing retention is an observed call transition of one definition,
    // never inferred from Unknown provenance or a future conservative bound.
    let retained_definitions: Array<Bool> = [];
    let retained_row: Int = 0;
    while retained_row < ArrayLength(definitions.syntax_ids) {
        ArrayPush(retained_definitions, false); retained_row = retained_row + 1;
    }
    // The scan fills one typed result on every normal exit. Scratch stays with
    // this caller, which closes its lifetime for success and failure alike.
    let verdict: SemanticAstCollectionOwnershipVerdict =
        SemanticAstCollectionOwnershipVerdictError("ast_artifact_invalid",
            SemanticError1("ast_artifact_invalid", "owner",
                "collection_ownership_scan_verdict"), -1, -1);
    SemanticAstCollectionOwnershipScanIntoVerdict(
        artifact, signatures, constructors, locals, initializer_types, surfaces,
        resolved_leaf_types, numeric_string_allocations, owned_string_results,
        statements, assignments, formal_effects, owned_result_plan,
        definitions, storage, moved_use, element_requirements, field_requirements,
        ownership, dispositions, origins, transition_states, origin_syntax_ids,
        source_binding_syntax_ids, current_definitions, receipts, literal_transfers,
        call_effects, aggregate_release_plan, indexed_string_borrows,
        retained_definitions, verdict);
    SemanticAstIndexedStringBorrowStateRetire(indexed_string_borrows);
    ArrayDrop(retained_definitions);
    return verdict;
}

func SemanticAstCollectionOwnershipVerdictFromResolvedFacts(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    ref locals: SemanticAstLocalBindingFacts,
    ref initializer_types: SemanticAstInitializerTypeFacts,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref function_scopes: SemanticAstFunctionScopeFacts,
    ref resolved_leaf_types: Array<String>,
    ref numeric_string_allocations: SemanticAstNumericStringAllocationCalls,
    ref call_roots: SemanticCallSpineRoots,
    ref owned_string_results: SemanticAstOwnedStringResultFacts,
    ref statements: SemanticAstStatementFacts,
    ref assignments: SemanticAstAssignmentFacts,
    ref assignment_types: SemanticAstAssignmentTypeFacts
) -> SemanticAstCollectionOwnershipVerdict {
    let formal_effects: SemanticAstCollectionFormalEffects =
        SemanticAstCollectionFormalEffectsWithReadyBuiltinRetention(
            artifact, signatures, function_scopes, locals,
            initializer_types, surfaces, statements,
            owned_string_results);
    return SemanticAstCollectionOwnershipVerdictFromResolvedFactsWithFormalEffects(
        artifact, signatures, constructors, locals, initializer_types,
        surfaces, function_scopes, resolved_leaf_types,
        numeric_string_allocations, call_roots, owned_string_results,
        statements, assignments, assignment_types, formal_effects);
}
