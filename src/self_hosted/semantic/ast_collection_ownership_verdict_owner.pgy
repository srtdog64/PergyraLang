// Array<String> element-lifetime provenance at semantic call boundaries.
//
// Stable local declaration identity owns the state.  This verdict consumes the
// already admitted expression graph once; MIR and backends may not infer deep
// release permission from the projected Array<String> type.

import "ast_artifact_verdict_owner.pgy";
import "ast_expression_graph_array_literal_owner.pgy";
import "ast_expression_graph_call_view_owner.pgy";
import "ast_expression_call_target_fact_owner.pgy";
import "ast_expression_graph_node_view_owner.pgy";
import "ast_expression_graph_view_owner.pgy";
import "ast_expression_call_identity_owner.pgy";
import "ast_local_binding_identity_owner.pgy";
import "ast_initializer_type_fact_owner.pgy";
import "ast_statement_fact_owner.pgy";
import "ast_assignment_fact_owner.pgy";
import "ast_assignment_type_fact_owner.pgy";
import "ast_collection_ownership_receipt_owner.pgy";
import "ast_collection_ownership_state_owner.pgy";
import "ast_collection_ownership_verdict_carrier_owner.pgy";
import "ast_collection_ownership_identity_owner.pgy";
import "ast_collection_ownership_assignment_alias_owner.pgy";
import "ast_collection_ownership_member_transition_owner.pgy";
import "ast_collection_ownership_argument_transfer_owner.pgy";
import "ast_collection_ownership_statement_transition_owner.pgy";
import "ast_owned_string_result_fact_owner.pgy";
import "ast_signature_fact_owner.pgy";
import "array_type_shape_owner.pgy";
import "diagnostic_owner.pgy";

func SemanticAstCollectionOwnershipVerdictFromResolvedFacts(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts, ref locals: SemanticAstLocalBindingFacts,
    ref initializer_types: SemanticAstInitializerTypeFacts, ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref statements: SemanticAstStatementFacts, ref assignments: SemanticAstAssignmentFacts,
    ref assignment_types: SemanticAstAssignmentTypeFacts
) -> SemanticAstCollectionOwnershipVerdict {
    let local_count: Int = ArrayLength(locals.node_ids);
    if !SemanticAstExpressionSurfaceBorrowReady(artifact, surfaces) ||
        !SemanticAstLocalBindingIdentityRowsReady(
            locals, initializer_types.inferred_type_names) ||
        ArrayLength(initializer_types.node_ids) != local_count ||
        !SemanticExpressionGraphCarriedCallTargetsReady(
            surfaces.expression_graph) || !statements.ok ||
        !assignments.ok || !assignment_types.ok ||
        ArrayLength(assignments.node_ids) !=
            ArrayLength(assignment_types.node_ids) {
        return SemanticAstCollectionOwnershipVerdictError(
            "ast_artifact_invalid",
            SemanticError1("ast_artifact_invalid", "owner",
                "SemanticAstCollectionOwnershipVerdict"), -1, -1);
    }
    let ownership: Array<Int> = [];
    let dispositions: Array<Int> = [];
    let origins: Array<Int> = [];
    let transition_states: Array<Int> = [];
    let origin_syntax_ids: Array<Int> = [];
    let source_binding_syntax_ids: Array<Int> = [];
    let receipts: SemanticAstCollectionOwnershipReceiptRows =
        SemanticAstCollectionOwnershipReceiptRowsEmpty();
    let move_destinations: HashMap<String, Int> = MapNew();
    let owned_string_results: SemanticAstOwnedStringResultFacts =
        SemanticAstOwnedStringResultFactsFromResolvedFacts(
            artifact, signatures, locals, initializer_types, surfaces,
            statements);
    if !SemanticAstOwnedStringResultFactsReady(owned_string_results) {
        return SemanticAstCollectionOwnershipVerdictError(
            "ast_artifact_invalid",
            SemanticError1("ast_artifact_invalid", "owner",
                "SemanticAstOwnedStringResultFacts"), -1, -1);
    }
    let local_row: Int = 0;
    while local_row < local_count {
        ArrayPush(ownership, SemanticAstCollectionOwnershipUnknown());
        ArrayPush(dispositions, SemanticAstCollectionDispositionLive());
        ArrayPush(origins, SemanticAstCollectionOriginUnknown());
        ArrayPush(
            transition_states,
            SemanticAstCollectionTransitionUntracked()
        );
        ArrayPush(origin_syntax_ids, locals.node_ids[local_row]);
        ArrayPush(source_binding_syntax_ids, 0);
        if !SemanticAstCollectionOwnershipIsStringArray(
            initializer_types.inferred_type_names[local_row]) {
            local_row = local_row + 1;
            continue;
        }
        if locals.binding_kinds[local_row] !=
                SemanticAstLocalBindingKindNormal() ||
            locals.binding_indices[local_row] != 0 {
            return SemanticAstCollectionOwnershipVerdictError(
                "collection_ownership_unresolved",
                SemanticError2("collection_ownership_unresolved",
                    "boundary", "destructure_binding",
                    "type", "Array<String>"),
                locals.node_ids[local_row], -1);
        }
        let root: Option<Int> = SemanticAstExpressionGraphRootForNode(
            surfaces, locals.node_ids[local_row], AstExpressionLaneValue());
        if !IsSome(root) {
            return SemanticAstCollectionOwnershipVerdictError(
                "ast_artifact_invalid",
                SemanticError1("ast_artifact_invalid", "owner",
                    "collection_ownership_initializer_graph"),
                locals.node_ids[local_row], -1);
        }
        let root_id: Int = UnwrapOption(root);
        let root_kind: Option<Int> = SemanticExpressionGraphNodeKind(
            surfaces.expression_graph, root_id);
        if SemanticAstCollectionOwnershipLiteralIsEmpty(
            surfaces.expression_graph, root_id) {
            // Origin is exact; mutation/call-effect receipts must own any
            // later current-state refinement away from UNKNOWN.
            origins[local_row] = SemanticAstCollectionOriginEmptyLiteral();
            transition_states[local_row] =
                SemanticAstCollectionTransitionEmpty();
        } else if SemanticAstCollectionOwnershipLiteralIsBorrowed(
            surfaces.expression_graph, root_id) {
            ownership[local_row] =
                SemanticAstCollectionOwnershipBorrowedElements();
            origins[local_row] =
                SemanticAstCollectionOriginBorrowedLiteral();
        } else if SemanticAstCollectionOwnershipRootCallName(
            surfaces.expression_graph, root_id) == "MapKeys" {
            ownership[local_row] =
                SemanticAstCollectionOwnershipMapKeysSnapshot();
            origins[local_row] = SemanticAstCollectionOriginMapKeys();
        } else if SemanticAstCollectionOwnershipRootCallName(
            surfaces.expression_graph, root_id) == "Clone" {
            ownership[local_row] =
                SemanticAstCollectionOwnershipOwnedElements();
            origins[local_row] = SemanticAstCollectionOriginClone();
        } else if IsSome(root_kind) && UnwrapOption(root_kind) ==
                AstExpressionNodeCall() {
            let call_target: Option<Int> =
                SemanticExpressionGraphCallTargetSyntaxId(
                    surfaces.expression_graph, root_id
                );
            if IsSome(call_target) && UnwrapOption(call_target) > 0 {
                origins[local_row] =
                    SemanticAstCollectionOriginCallResult();
                origin_syntax_ids[local_row] = UnwrapOption(call_target);
            }
        } else if IsSome(root_kind) && UnwrapOption(root_kind) ==
                AstExpressionNodeMemberAccess() {
            let moved: SemanticAstCollectionMemberMoveIdentity =
                SemanticAstCollectionMemberMoveIdentityForNode(
                    artifact, constructors, locals, initializer_types.inferred_type_names,
                    locals.function_node_ids[local_row],
                    locals.node_ids[local_row], surfaces.expression_graph,
                    root_id);
            if moved.ok {
                origins[local_row] =
                    SemanticAstCollectionOriginMemberMove();
                origin_syntax_ids[local_row] = moved.field_syntax_id;
                source_binding_syntax_ids[local_row] =
                    moved.source_binding_syntax_id;
                MapSet(move_destinations,
                    SemanticAstCollectionMemberMoveEventKey(
                        moved, locals.node_ids[local_row]), locals.node_ids[local_row]);
            }
        } else {
            let source: SemanticAstLocalBindingIdentity =
                SemanticAstScopedLocalBindingIdentityForGraphLeaf(
                    artifact, locals, initializer_types.inferred_type_names,
                    locals.function_node_ids[local_row],
                    locals.node_ids[local_row],
                    surfaces.expression_graph, root_id);
            if source.ok &&
                (origins[source.row] ==
                    SemanticAstCollectionOriginEmptyLiteral() ||
                 dispositions[source.row] ==
                    SemanticAstCollectionDispositionRetired() ||
                 ownership[source.row] ==
                    SemanticAstCollectionOwnershipMapKeysSnapshot() ||
                 ownership[source.row] ==
                    SemanticAstCollectionOwnershipOwnedElements()) {
                return SemanticAstCollectionOwnershipVerdictError(
                    "borrow_boundary_escape",
                    SemanticError2("borrow_boundary_escape",
                        "boundary", "shallow_copy",
                        "type", "Array<String>"),
                    locals.node_ids[local_row], root_id);
            }
            if source.ok {
                ownership[local_row] = ownership[source.row];
                origins[local_row] = SemanticAstCollectionOriginBinding();
                source_binding_syntax_ids[local_row] =
                    locals.node_ids[source.row];
            }
        }
        local_row = local_row + 1;
    }
    let moved_use: SemanticAstCollectionMemberMoveUse =
        SemanticAstCollectionFirstInvalidMemberMoveUse(
            artifact, constructors, locals, initializer_types.inferred_type_names,
            surfaces, assignments, move_destinations);
    if moved_use.found {
        return SemanticAstCollectionOwnershipVerdictError(
            "move_from_released",
            SemanticError2("move_from_released", "boundary",
                "member_use_after_move", "type", "Array<String>"),
            moved_use.syntax_node_id, moved_use.expression_node_id);
    }
    let assignment_row: Int = 0;
    while assignment_row < ArrayLength(assignments.node_ids) {
        let alias: SemanticAstCollectionOwnershipAssignmentAliasFact =
            SemanticAstCollectionOwnershipAssignmentAliasAt(
                artifact, locals, initializer_types, surfaces,
                assignments, assignment_types, assignment_row);
        if !alias.ok {
            return SemanticAstCollectionOwnershipVerdictError(
                "ast_artifact_invalid",
                SemanticError1("ast_artifact_invalid", "owner",
                    "collection_ownership_assignment_join"),
                assignments.node_ids[assignment_row], -1);
        }
        if alias.candidate &&
            (origins[alias.source_row] ==
                SemanticAstCollectionOriginEmptyLiteral() ||
             dispositions[alias.source_row] ==
                SemanticAstCollectionDispositionRetired() ||
             ownership[alias.source_row] ==
                SemanticAstCollectionOwnershipMapKeysSnapshot() ||
             ownership[alias.source_row] ==
                SemanticAstCollectionOwnershipOwnedElements()) {
            return SemanticAstCollectionOwnershipVerdictError(
                "borrow_boundary_escape",
                SemanticError2("borrow_boundary_escape",
                    "boundary", "shallow_assignment",
                    "type", "Array<String>"),
                alias.syntax_node_id, alias.expression_node_id);
        }
        assignment_row = assignment_row + 1;
    }

    let statement_transitions: SemanticAstCollectionStatementTransitionResult =
        SemanticAstCollectionStatementTransitions(
            artifact, locals, initializer_types.inferred_type_names,
            surfaces, statements, ownership, dispositions, origins,
            transition_states, owned_string_results, receipts);
    if !statement_transitions.ok {
        return SemanticAstCollectionOwnershipVerdictError(
            statement_transitions.diagnostic_code,
            statement_transitions.diagnostic_message,
            statement_transitions.syntax_node_id, -1);
    }
    receipts = statement_transitions.receipts;

    let call_roots: SemanticCallSpineRoots =
        SemanticCallSpineRootsFromGraph(surfaces.expression_graph);
    if !call_roots.ok {
        return SemanticAstCollectionOwnershipVerdictError(
            "ast_artifact_invalid",
            SemanticError1("ast_artifact_invalid", "owner",
                "collection_ownership_call_roots"), -1, -1);
    }
    let last_root: Int = -1;
    let root_slot: Int = 0;
    while root_slot < ArrayLength(surfaces.expression_graph.roots) {
        if surfaces.expression_graph.has_roots[root_slot] {
            let root_id: Int = surfaces.expression_graph.roots[root_slot];
            let node: Int = last_root + 1;
            while node <= root_id {
                let kind: Option<Int> = SemanticExpressionGraphNodeKind(
                    surfaces.expression_graph, node);
                if IsSome(kind) &&
                    UnwrapOption(kind) == AstExpressionNodeCall() {
                    let target: Option<String> =
                        SemanticExpressionGraphCallTargetName(
                            surfaces.expression_graph, node);
                    let call: SemanticCallSpineView =
                        SemanticCallSpineViewFromGraph(
                            surfaces.expression_graph,
                            call_roots.root_nodes[node]);
                    if IsSome(target) && call.ok &&
                        call.call_node == node &&
                        SemanticAstCollectionOwnershipBuiltinCall(
                            surfaces.expression_graph, node,
                            UnwrapOption(target)) &&
                        ArrayLength(call.argument_nodes) > 0 {
                        let name: String = UnwrapOption(target);
                        let owned_push: Bool =
                            name == "ArrayPushOwnedString";
                        let mutates_elements: Bool = name == "ArrayPush" ||
                            name == "ArraySet" || name == "ArrayPop";
                        let deep_drop: Bool =
                            name == "ArrayDropOwnedStrings";
                        if owned_push || mutates_elements || deep_drop {
                            let binding: SemanticAstLocalBindingIdentity =
                                SemanticAstCollectionOwnershipLocalForArgument(
                                    artifact, locals,
                                    initializer_types.inferred_type_names,
                                    surfaces, root_slot / 3,
                                    call.argument_nodes[0]);
                            let parameter_mode: Int =
                                SemanticAstCollectionOwnershipParameterModeForArgument(
                                    signatures, surfaces, root_slot / 3,
                                    call.argument_nodes[0]);
                            if !binding.ok && deep_drop && parameter_mode > 0 &&
                                parameter_mode != 3 {
                                return SemanticAstCollectionOwnershipVerdictError(
                                    "borrow_boundary_escape",
                                    SemanticError2(
                                        "borrow_boundary_escape",
                                        "boundary", "parameter_without_owned_provenance",
                                        "type", "Array<String>"
                                    ),
                                    surfaces.node_ids[root_slot / 3], node);
                            }
                            if binding.ok {
                                let state: Int = ownership[binding.row];
                                if origins[binding.row] ==
                                        SemanticAstCollectionOriginEmptyLiteral() {
                                    let transition: Int =
                                        transition_states[binding.row];
                                    if owned_push {
                                        if transition !=
                                                SemanticAstCollectionTransitionEmpty() &&
                                            transition !=
                                                SemanticAstCollectionTransitionOwned() {
                                            return SemanticAstCollectionOwnershipVerdictError(
                                                "borrow_boundary_escape",
                                                SemanticError2(
                                                    "borrow_boundary_escape",
                                                    "boundary", name,
                                                    "type", "Array<String>"
                                                ),
                                                surfaces.node_ids[root_slot / 3],
                                                node
                                            );
                                        }
                                        transition_states[binding.row] =
                                            SemanticAstCollectionTransitionOwned();
                                    } else if mutates_elements {
                                        if transition !=
                                                SemanticAstCollectionTransitionEmpty() &&
                                            transition !=
                                                SemanticAstCollectionTransitionBorrowed() {
                                            return SemanticAstCollectionOwnershipVerdictError(
                                                "borrow_boundary_escape",
                                                SemanticError2(
                                                    "borrow_boundary_escape",
                                                    "boundary", name,
                                                    "type", "Array<String>"
                                                ),
                                                surfaces.node_ids[root_slot / 3],
                                                node
                                            );
                                        }
                                        transition_states[binding.row] =
                                            SemanticAstCollectionTransitionBorrowed();
                                    } else if deep_drop {
                                        if transition ==
                                                SemanticAstCollectionTransitionBorrowed() {
                                            return SemanticAstCollectionOwnershipVerdictError(
                                                "borrow_boundary_escape",
                                                SemanticError2(
                                                    "borrow_boundary_escape",
                                                    "boundary", "owned_string_drop",
                                                    "type", "borrowed Array<String>"
                                                ),
                                                surfaces.node_ids[root_slot / 3],
                                                node
                                            );
                                        }
                                        if transition ==
                                                SemanticAstCollectionTransitionRetired() {
                                            return SemanticAstCollectionOwnershipVerdictError(
                                                "borrow_boundary_escape",
                                                SemanticError2(
                                                    "borrow_boundary_escape",
                                                    "boundary", "double_drop",
                                                    "type", "Array<String>"
                                                ),
                                                surfaces.node_ids[root_slot / 3],
                                                node
                                            );
                                        }
                                        if transition !=
                                                SemanticAstCollectionTransitionEmpty() &&
                                            transition !=
                                                SemanticAstCollectionTransitionOwned() {
                                            return SemanticAstCollectionOwnershipVerdictError(
                                                "ast_artifact_invalid",
                                                SemanticError1(
                                                    "ast_artifact_invalid",
                                                    "owner",
                                                    "collection_ownership_transition"
                                                ),
                                                surfaces.node_ids[root_slot / 3],
                                                node
                                            );
                                        }
                                        transition_states[binding.row] =
                                            SemanticAstCollectionTransitionRetired();
                                    }
                                    let identity:
                                        SemanticExpressionCallIdentity =
                                            SemanticExpressionCallIdentityForNode(
                                                surfaces, node);
                                    if !identity.ok {
                                        return SemanticAstCollectionOwnershipVerdictError(
                                            "ast_artifact_invalid",
                                            SemanticError1(
                                                "ast_artifact_invalid",
                                                "owner",
                                                "collection_ownership_call_identity"
                                            ),
                                            surfaces.node_ids[root_slot / 3],
                                            node
                                        );
                                    }
                                    let effect: Int =
                                        SemanticAstCollectionOwnershipEffectDrop();
                                    if owned_push {
                                        effect =
                                            SemanticAstCollectionOwnershipEffectOwnedStringPush();
                                    } else if mutates_elements {
                                        effect =
                                            SemanticAstCollectionOwnershipEffectShallowMutation();
                                    }
                                    receipts =
                                        SemanticAstCollectionOwnershipReceiptRowsAppend(
                                            receipts,
                                            surfaces.function_node_ids[
                                                root_slot / 3],
                                            identity.owner_node_id,
                                            identity.lane,
                                            identity.local_call_ordinal,
                                            effect,
                                            locals.node_ids[binding.row], 0
                                        );
                                } else if (owned_push || deep_drop) &&
                                    (state ==
                                        SemanticAstCollectionOwnershipBorrowedElements() ||
                                     (state ==
                                        SemanticAstCollectionOwnershipUnknown() &&
                                      (origins[binding.row] ==
                                        SemanticAstCollectionOriginMemberMove() ||
                                       origins[binding.row] ==
                                        SemanticAstCollectionOriginCallResult() ||
                                       origins[binding.row] ==
                                        SemanticAstCollectionOriginBinding()))) {
                                    let boundary: String = name;
                                    if deep_drop {
                                        boundary = "owned_string_drop";
                                    }
                                    return SemanticAstCollectionOwnershipVerdictError(
                                        "borrow_boundary_escape",
                                        SemanticError2(
                                            "borrow_boundary_escape",
                                            "boundary", boundary,
                                            "type", "borrowed or unknown Array<String>"
                                        ),
                                        surfaces.node_ids[root_slot / 3], node);
                                } else if mutates_elements &&
                                    (state == SemanticAstCollectionOwnershipOwnedElements() ||
                                     state == SemanticAstCollectionOwnershipMapKeysSnapshot()) {
                                    return SemanticAstCollectionOwnershipVerdictError(
                                        "borrow_boundary_escape",
                                        SemanticError2("borrow_boundary_escape",
                                            "boundary", name,
                                            "type", "Array<String>"),
                                        surfaces.node_ids[root_slot / 3], node);
                                }
                                if origins[binding.row] !=
                                        SemanticAstCollectionOriginEmptyLiteral() &&
                                    deep_drop && state ==
                                        SemanticAstCollectionOwnershipBorrowedElements() {
                                    return SemanticAstCollectionOwnershipVerdictError(
                                        "borrow_boundary_escape",
                                        SemanticError2("borrow_boundary_escape",
                                            "boundary", "owned_string_drop",
                                            "type", "borrowed Array<String>"),
                                        surfaces.node_ids[root_slot / 3], node);
                                }
                                if origins[binding.row] !=
                                        SemanticAstCollectionOriginEmptyLiteral() &&
                                    deep_drop && dispositions[binding.row] ==
                                        SemanticAstCollectionDispositionRetired() {
                                    return SemanticAstCollectionOwnershipVerdictError(
                                        "borrow_boundary_escape",
                                        SemanticError2("borrow_boundary_escape",
                                            "boundary", "double_drop",
                                            "type", "Array<String>"),
                                        surfaces.node_ids[root_slot / 3], node);
                                }
                                if origins[binding.row] !=
                                        SemanticAstCollectionOriginEmptyLiteral() &&
                                    deep_drop &&
                                    (state == SemanticAstCollectionOwnershipOwnedElements() ||
                                     state == SemanticAstCollectionOwnershipMapKeysSnapshot()) {
                                    dispositions[binding.row] =
                                        SemanticAstCollectionDispositionRetired();
                                }
                            }
                        }
                    }
                }
                node = node + 1;
            }
            last_root = root_id;
        }
        root_slot = root_slot + 1;
    }
    let transferred_use: SemanticAstCollectionOwnedArgumentUse =
        SemanticAstCollectionFirstInvalidOwnedArgumentUse(
            artifact, signatures, locals, initializer_types.inferred_type_names,
            surfaces, ownership, dispositions, origins, transition_states);
    if transferred_use.found {
        return SemanticAstCollectionOwnershipVerdictError(
            transferred_use.diagnostic_code,
            SemanticError2(transferred_use.diagnostic_code, "boundary",
                transferred_use.boundary, "type", "Array<String>"),
            transferred_use.syntax_node_id, transferred_use.expression_node_id);
    }
    // The transition scan above proves that no use occurs after an exact
    // field restore.  Apply the terminal disposition only after earlier
    // statement/call effects have been checked in source order; otherwise a
    // valid mutation between move-out and move-back is seen as post-restore.
    SemanticAstCollectionApplyMemberMoveRestorations(
        locals, moved_use, dispositions
    );
    let function_syntax_ids: Array<Int> = [];
    let binding_syntax_ids: Array<Int> = [];
    let carried_origin_syntax_ids: Array<Int> = [];
    let carried_source_binding_syntax_ids: Array<Int> = [];
    let element_ownerships: Array<Int> = [];
    let carried_dispositions: Array<Int> = [];
    let carried_origins: Array<Int> = [];
    local_row = 0;
    while local_row < local_count {
        if SemanticAstCollectionOwnershipIsStringArray(
            initializer_types.inferred_type_names[local_row]
        ) {
            ArrayPush(function_syntax_ids, locals.function_node_ids[local_row]);
            ArrayPush(binding_syntax_ids, locals.node_ids[local_row]);
            ArrayPush(carried_origin_syntax_ids,
                origin_syntax_ids[local_row]);
            ArrayPush(carried_source_binding_syntax_ids,
                source_binding_syntax_ids[local_row]);
            ArrayPush(element_ownerships, ownership[local_row]);
            ArrayPush(carried_dispositions, dispositions[local_row]);
            ArrayPush(carried_origins, origins[local_row]);
        }
        local_row = local_row + 1;
    }
    if !SemanticAstCollectionOwnershipReceiptRowsReady(receipts) {
        return SemanticAstCollectionOwnershipVerdictError(
            "ast_artifact_invalid",
            SemanticError1("ast_artifact_invalid", "owner",
                "collection_ownership_receipts"), -1, -1
        );
    }
    return SemanticAstCollectionOwnershipVerdictOkWithFacts(
        function_syntax_ids, binding_syntax_ids, carried_origin_syntax_ids,
        carried_source_binding_syntax_ids, element_ownerships,
        carried_dispositions, carried_origins, receipts
    );
}
