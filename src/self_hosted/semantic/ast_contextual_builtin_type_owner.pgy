// Contextual builtin result types join call-spine facts with declared types.

import "ast_expression_graph_call_view_owner.pgy";
import "ast_expression_call_target_fact_owner.pgy";
import "builtin_signature_owner.pgy";
import "ast_expression_graph_node_view_owner.pgy";

func SemanticContextualBuiltinReturnTypeFromGraph(
    ref graph: SemanticExpressionGraphFacts,
    root_id: Int,
    declared_type: Option<String>
) -> Option<String> {
    let call: SemanticCallSpineView =
        SemanticCallSpineViewFromGraph(graph, root_id);
    if !call.ok { return None; }
    let target: Option<String> =
        SemanticExpressionGraphCallTargetName(graph, call.call_node);
    if IsSome(target) && UnwrapOption(target) != "" {
        return SemanticContextualBuiltinReturnTypeOpt(
            UnwrapOption(target), ArrayLength(call.argument_nodes),
            declared_type
        );
    }
    // Contextual collection typing runs before target binding has necessarily
    // populated the call overlay. Only a direct leaf callee may supply the
    // builtin spelling at this boundary; member and computed callees fail
    // closed instead of becoming a general name-resolution fallback.
    let callee_kind: Option<Int> = SemanticExpressionGraphNodeKind(
        graph, call.callee_node
    );
    if !IsSome(callee_kind) ||
        UnwrapOption(callee_kind) != AstExpressionNodeLeaf() {
        return None;
    }
    let callee_name: Option<String> = SemanticExpressionGraphNodeText(
        graph, call.callee_node
    );
    if !IsSome(callee_name) || UnwrapOption(callee_name) == "" { return None; }
    return SemanticContextualBuiltinReturnTypeOpt(
        UnwrapOption(callee_name), ArrayLength(call.argument_nodes),
        declared_type
    );
}

func SemanticContextualBuiltinInitializerTypeFromGraph(
    ref graph: SemanticExpressionGraphFacts,
    root_id: Int,
    declared_type: Option<String>,
    verdict_ok: Bool,
    inferred_type: String
) -> String {
    if !verdict_ok ||
        (inferred_type != "List<Unknown>" &&
         inferred_type != "Queue<Unknown>" &&
         inferred_type != "Set<Unknown>") {
        return inferred_type;
    }
    let contextual: Option<String> =
        SemanticContextualBuiltinReturnTypeFromGraph(
            graph, root_id, declared_type
        );
    if IsSome(contextual) { return UnwrapOption(contextual); }
    return inferred_type;
}
