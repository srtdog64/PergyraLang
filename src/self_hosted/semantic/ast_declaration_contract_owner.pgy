// Program-wide declaration contracts, checked once after statement typing:
// a bare enum variant name must have a single declaration (docs/205 L3a),
// whether the other declaration is a variant or a top-level function.
// Body flow (missing return, Never fallthrough) is owned by
// ast_body_flow_verdict_owner.pgy. A refusal carries the declaration node it
// is about, for its span.

import "ast_enum_fact_owner.pgy";
import "ast_signature_fact_owner.pgy";
import "diagnostic_owner.pgy";

struct SemanticAstDeclarationContractVerdict {
    ok: Bool;
    code: String;
    message: String;
    node_id: Int;
}

// The first variant row whose bare name another enum already declared.
func SemanticAstEnumVariantRedeclarationRow(enums: SemanticAstEnumFacts) -> Int {
    let row: Int = 0;
    while row < ArrayLength(enums.variant_names) {
        let other: Int = 0;
        while other < row {
            if enums.variant_names[other] == enums.variant_names[row] &&
                enums.variant_enum_names[other] != enums.variant_enum_names[row] {
                return row;
            }
            other = other + 1;
        }
        row = row + 1;
    }
    return 0 - 1;
}

func SemanticAstEnumVariantFirstEnum(enums: SemanticAstEnumFacts, row: Int) -> String {
    let other: Int = 0;
    while other < row {
        if enums.variant_names[other] == enums.variant_names[row] &&
            enums.variant_enum_names[other] != enums.variant_enum_names[row] {
            return enums.variant_enum_names[other];
        }
        other = other + 1;
    }
    return "";
}

func SemanticAstEnumDeclarationNode(enums: SemanticAstEnumFacts, enum_name: String) -> Int {
    let i: Int = 0;
    while i < ArrayLength(enums.enum_names) {
        if enums.enum_names[i] == enum_name { return enums.node_ids[i]; }
        i = i + 1;
    }
    return 0 - 1;
}

// The first top-level function whose name a bare enum variant owns, or -1.
// The callable table keeps the variant's row, so this is where it is refused.
func SemanticAstEnumVariantFunctionClashRow(
    signatures: SemanticAstFunctionSignatureFacts, enums: SemanticAstEnumFacts
) -> Int {
    let row: Int = 0;
    while row < ArrayLength(signatures.names) {
        if signatures.owner_names[row] == "" && signatures.function_node_ids[row] >= 0 &&
            SemanticAstEnumVariantRowForBareName(enums, signatures.names[row]) >= 0 {
            return row;
        }
        row = row + 1;
    }
    return 0 - 1;
}

func SemanticAstDeclarationContractVerdictFrom(
    signatures: SemanticAstFunctionSignatureFacts, enums: SemanticAstEnumFacts
) -> SemanticAstDeclarationContractVerdict {
    let row: Int = SemanticAstEnumVariantRedeclarationRow(enums);
    if row >= 0 {
        return SemanticAstDeclarationContractVerdict(
            false, "enum_variant_redeclaration",
            SemanticError3(
                "enum_variant_redeclaration",
                "variant", enums.variant_names[row],
                "enum", enums.variant_enum_names[row],
                "first_enum", SemanticAstEnumVariantFirstEnum(enums, row)
            ),
            SemanticAstEnumDeclarationNode(enums, enums.variant_enum_names[row])
        );
    }
    let clash: Int = SemanticAstEnumVariantFunctionClashRow(signatures, enums);
    if clash >= 0 {
        let variant: Int = SemanticAstEnumVariantRowForBareName(enums, signatures.names[clash]);
        return SemanticAstDeclarationContractVerdict(
            false, "enum_variant_function_clash",
            SemanticError2(
                "enum_variant_function_clash",
                "name", signatures.names[clash],
                "enum", enums.variant_enum_names[variant]
            ),
            signatures.function_node_ids[clash]
        );
    }
    return SemanticAstDeclarationContractVerdict(true, "", "", 0 - 1);
}
