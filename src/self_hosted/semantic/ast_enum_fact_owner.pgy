// Enum declaration and variant facts captured once from the typed AST arena.

import "../hir/ast_text_arena_projection_owner.pgy";
import "../hir/ast_node_kind_owner.pgy";
import "delimited_range_fact_owner.pgy";
import "ast_type_name_canonical_owner.pgy";
import "expression_normalization_owner.pgy";

struct SemanticAstEnumFacts {
    ok: Bool;
    artifact_node_count: Int;
    node_ids: Array<Int>;
    enum_names: Array<String>;
    variant_enum_names: Array<String>;
    variant_names: Array<String>;
    variant_param_starts: Array<Int>;
    variant_param_counts: Array<Int>;
    variant_param_type_names: Array<String>;
}

func SemanticAstEnumFactsFromArtifact(
    artifact: AstTreeArtifact
) -> SemanticAstEnumFacts {
    let node_ids: Array<Int> = [];
    let enum_names: Array<String> = [];
    let variant_enum_names: Array<String> = [];
    let variant_names: Array<String> = [];
    let variant_param_starts: Array<Int> = [];
    let variant_param_counts: Array<Int> = [];
    let variant_param_type_names: Array<String> = [];
    let ok: Bool = AstTreeArtifactReady(artifact);
    let node_id: Int = 0;
    while node_id < artifact.count && ok {
        if TypedAstArenaNodeKindIs(
            artifact.arena, node_id, TypedAstKindEnumDeclTag()
        ) {
            let enum_name_opt: Option<String> = TypedAstArenaAtomText(
                artifact.arena, node_id
            );
            let variants_opt: Option<String> = TypedAstArenaAuxValueText(
                artifact.arena, node_id
            );
            if !IsSome(enum_name_opt) || !IsSome(variants_opt) {
                ok = false;
            } else {
                let enum_name: String = UnwrapOption(enum_name_opt);
                let variants_text: String = UnwrapOption(variants_opt);
                let variants: SemanticDelimitedRangeFacts =
                    SemanticNestedCommaRangeFactsFromSource(variants_text);
                if StringLength(enum_name) == 0 ||
                    SemanticDelimitedRangeCount(variants) == 0 {
                    ok = false;
                } else {
                    ArrayPush(node_ids, node_id);
                    ArrayPush(enum_names, enum_name);
                    let variant_index: Int = 0;
                    while variant_index < SemanticDelimitedRangeCount(variants) && ok {
                        let variant: String = SemanticDelimitedRangeText(
                            variants, variants_text, variant_index
                        );
                        let paren: Int = StringIndexOf(variant, "(");
                        let variant_name: String = variant;
                        let param_start: Int = ArrayLength(
                            variant_param_type_names
                        );
                        let param_count: Int = 0;
                        if paren >= 0 {
                            variant_name = SemanticTrimSourceRangeReuse(
                                variant, 0, paren
                            );
                            let close: Int = StringIndexOf(variant, ")");
                            if close <= paren {
                                ok = false;
                            } else {
                                let params_text: String = Substring(
                                    variant, paren + 1, close - paren - 1
                                );
                                let params: SemanticDelimitedRangeFacts =
                                    SemanticNestedCommaRangeFactsFromSource(
                                        params_text
                                    );
                                param_count = SemanticDelimitedNonEmptyRangeCount(
                                    params
                                );
                                let param_index: Int = 0;
                                while param_index < param_count && ok {
                                    let param_type_name: String =
                                        SemanticDelimitedRangeText(
                                            params, params_text, param_index
                                        );
                                    if param_type_name == "" ||
                                        param_type_name == "Unknown" {
                                        ok = false;
                                    } else {
                                        ArrayPush(
                                            variant_param_type_names,
                                            SemanticCanonicalTypeName(
                                                param_type_name
                                            )
                                        );
                                    }
                                    param_index = param_index + 1;
                                }
                            }
                        }
                        if StringLength(variant_name) == 0 {
                            ok = false;
                        } else {
                            ArrayPush(variant_enum_names, enum_name);
                            ArrayPush(variant_names, variant_name);
                            ArrayPush(variant_param_starts, param_start);
                            ArrayPush(variant_param_counts, param_count);
                        }
                        variant_index = variant_index + 1;
                    }
                }
            }
        }
        node_id = node_id + 1;
    }
    return SemanticAstEnumFacts(
        ok, artifact.count, node_ids, enum_names, variant_enum_names, variant_names,
        variant_param_starts, variant_param_counts,
        variant_param_type_names
    );
}

func SemanticAstEnumRowsReady(ref facts: SemanticAstEnumFacts) -> Bool {
    let variant_count: Int = ArrayLength(facts.variant_names);
    if !facts.ok ||
        ArrayLength(facts.variant_enum_names) != variant_count ||
        ArrayLength(facts.variant_param_starts) != variant_count ||
        ArrayLength(facts.variant_param_counts) != variant_count {
        return false;
    }
    let expected_start: Int = 0;
    let variant_index: Int = 0;
    while variant_index < variant_count {
        if facts.variant_enum_names[variant_index] == "" ||
            facts.variant_names[variant_index] == "" ||
            facts.variant_param_starts[variant_index] != expected_start ||
            facts.variant_param_counts[variant_index] < 0 {
            return false;
        }
        expected_start = expected_start +
            facts.variant_param_counts[variant_index];
        variant_index = variant_index + 1;
    }
    if expected_start != ArrayLength(facts.variant_param_type_names) {
        return false;
    }
    let payload_index: Int = 0;
    while payload_index < ArrayLength(facts.variant_param_type_names) {
        if facts.variant_param_type_names[payload_index] == "" ||
            facts.variant_param_type_names[payload_index] == "Unknown" {
            return false;
        }
        payload_index = payload_index + 1;
    }
    return true;
}

func SemanticAstEnumNestedPayloadContractReady() -> Bool {
    let artifact: AstTreeArtifact = AstTreeArtifactFromText(
        "Program:\n  Enum: Shape { Circle(Int), Rect(Int, Int), None }\n"
    );
    let facts: SemanticAstEnumFacts = SemanticAstEnumFactsFromArtifact(artifact);
    let circle: Option<Int> = SemanticAstEnumVariantParamCountAt(
        facts, "Shape", 0
    );
    let rect: Option<Int> = SemanticAstEnumVariantParamCountAt(
        facts, "Shape", 1
    );
    let none: Option<Int> = SemanticAstEnumVariantParamCountAt(
        facts, "Shape", 2
    );
    return facts.ok && SemanticAstEnumCount(facts) == 1 &&
        IsSome(circle) && UnwrapOption(circle) == 1 &&
        IsSome(rect) && UnwrapOption(rect) == 2 &&
        IsSome(none) && UnwrapOption(none) == 0 &&
        IsSome(SemanticAstEnumVariantPayloadTypeAt(
            facts, "Shape", "Circle", 0
        )) && UnwrapOption(SemanticAstEnumVariantPayloadTypeAt(
            facts, "Shape", "Circle", 0
        )) == "Int" &&
        IsSome(SemanticAstEnumVariantPayloadTypeAt(
            facts, "Shape", "Rect", 0
        )) && UnwrapOption(SemanticAstEnumVariantPayloadTypeAt(
            facts, "Shape", "Rect", 0
        )) == "Int" &&
        IsSome(SemanticAstEnumVariantPayloadTypeAt(
            facts, "Shape", "Rect", 1
        )) && UnwrapOption(SemanticAstEnumVariantPayloadTypeAt(
            facts, "Shape", "Rect", 1
        )) == "Int" &&
        SemanticAstPayloadFreeEnumValueAssignableToInt(
            facts, "Int", "Shape", "Shape.None"
        ) &&
        !SemanticAstPayloadFreeEnumValueAssignableToInt(
            facts, "Int", "Shape", "Shape.Circle"
        );
}

func SemanticAstEnumExpressionRow(
    facts: SemanticAstEnumFacts,
    expression: String
) -> Option<Int> {
    if !SemanticAstEnumRowsReady(facts) {
        return None;
    }
    let dot: Int = StringIndexOf(expression, ".");
    if dot <= 0 || StringIndexOf(
        Substring(expression, dot + 1, StringLength(expression) - dot - 1), "."
    ) >= 0 {
        return None;
    }
    let enum_name: String = Substring(expression, 0, dot);
    let variant_name: String = Substring(
        expression, dot + 1, StringLength(expression) - dot - 1
    );
    let i: Int = 0;
    while i < ArrayLength(facts.variant_names) {
        if facts.variant_enum_names[i] == enum_name &&
            facts.variant_names[i] == variant_name {
            return Some(i);
        }
        i = i + 1;
    }
    return None;
}

func SemanticAstEnumExpressionType(
    facts: SemanticAstEnumFacts,
    expression: String
) -> Option<String> {
    let row: Option<Int> =
        SemanticAstEnumExpressionRow(facts, expression);
    if !IsSome(row) { return None; }
    return Some(facts.variant_enum_names[UnwrapOption(row)]);
}

func SemanticAstPayloadFreeEnumValueAssignableToInt(
    facts: SemanticAstEnumFacts,
    expected: String,
    actual: String,
    expression: String
) -> Bool {
    if expected != "Int" { return false; }
    let row: Option<Int> =
        SemanticAstEnumExpressionRow(facts, expression);
    if !IsSome(row) { return false; }
    let index: Int = UnwrapOption(row);
    return facts.variant_param_counts[index] == 0 &&
        facts.variant_enum_names[index] == actual;
}

func SemanticAstEnumCount(ref facts: SemanticAstEnumFacts) -> Int {
    return ArrayLength(facts.node_ids);
}

func SemanticAstEnumIndexForNode(
    ref facts: SemanticAstEnumFacts,
    node_id: Int
) -> Option<Int> {
    if !facts.ok { return None; }
    let count: Int = SemanticAstEnumCount(facts);
    let low: Int = 0;
    let high: Int = count;
    while low < high {
        let middle: Int = low + ((high - low) / 2);
        if facts.node_ids[middle] < node_id {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    if low < count && facts.node_ids[low] == node_id { return Some(low); }
    return None;
}

func SemanticAstEnumIndexForName(
    ref facts: SemanticAstEnumFacts,
    enum_name: String
) -> Option<Int> {
    if !facts.ok {
        return None;
    }
    let i: Int = 0;
    while i < SemanticAstEnumCount(facts) {
        if facts.enum_names[i] == enum_name {
            return Some(i);
        }
        i = i + 1;
    }
    return None;
}

func SemanticAstEnumNameAt(
    ref facts: SemanticAstEnumFacts,
    index: Int
) -> Option<String> {
    if !facts.ok || index < 0 || index >= SemanticAstEnumCount(facts) {
        return None;
    }
    return Some(facts.enum_names[index]);
}

func SemanticAstEnumVariantCountForName(
    ref facts: SemanticAstEnumFacts,
    enum_name: String
) -> Option<Int> {
    if !IsSome(SemanticAstEnumIndexForName(facts, enum_name)) {
        return None;
    }
    let count: Int = 0;
    let i: Int = 0;
    while i < ArrayLength(facts.variant_names) {
        if facts.variant_enum_names[i] == enum_name {
            count = count + 1;
        }
        i = i + 1;
    }
    return Some(count);
}

func SemanticAstEnumVariantRowIndex(
    ref facts: SemanticAstEnumFacts,
    enum_name: String,
    index: Int
) -> Option<Int> {
    if !facts.ok || index < 0 ||
        !IsSome(SemanticAstEnumIndexForName(facts, enum_name)) {
        return None;
    }
    let seen: Int = 0;
    let i: Int = 0;
    while i < ArrayLength(facts.variant_names) {
        if facts.variant_enum_names[i] == enum_name {
            if seen == index {
                return Some(i);
            }
            seen = seen + 1;
        }
        i = i + 1;
    }
    return None;
}

func SemanticAstEnumVariantNameAt(
    ref facts: SemanticAstEnumFacts,
    enum_name: String,
    index: Int
) -> Option<String> {
    let row: Option<Int> = SemanticAstEnumVariantRowIndex(
        facts, enum_name, index
    );
    if !IsSome(row) {
        return None;
    }
    return Some(facts.variant_names[UnwrapOption(row)]);
}

func SemanticAstEnumVariantParamCountAt(
    ref facts: SemanticAstEnumFacts,
    enum_name: String,
    index: Int
) -> Option<Int> {
    let row: Option<Int> = SemanticAstEnumVariantRowIndex(
        facts, enum_name, index
    );
    if !IsSome(row) {
        return None;
    }
    return Some(facts.variant_param_counts[UnwrapOption(row)]);
}

func SemanticAstEnumVariantPayloadTypeAt(
    ref facts: SemanticAstEnumFacts,
    enum_name: String,
    variant_name: String,
    payload_index: Int
) -> Option<String> {
    if !SemanticAstEnumRowsReady(facts) || payload_index < 0 {
        return None;
    }
    let row: Int = 0;
    while row < ArrayLength(facts.variant_names) {
        if facts.variant_enum_names[row] == enum_name &&
            facts.variant_names[row] == variant_name {
            if payload_index >= facts.variant_param_counts[row] {
                return None;
            }
            return Some(facts.variant_param_type_names[
                facts.variant_param_starts[row] + payload_index
            ]);
        }
        row = row + 1;
    }
    return None;
}

func SemanticAstEnumFactsMatchArtifact(
    artifact: AstTreeArtifact,
    facts: SemanticAstEnumFacts
) -> Bool {
    let rebuilt: SemanticAstEnumFacts =
        SemanticAstEnumFactsFromArtifact(artifact);
    if !facts.ok || !rebuilt.ok ||
        facts.artifact_node_count != artifact.count ||
        ArrayLength(facts.node_ids) != ArrayLength(facts.enum_names) ||
        ArrayLength(facts.node_ids) != ArrayLength(rebuilt.node_ids) ||
        ArrayLength(facts.enum_names) != ArrayLength(rebuilt.enum_names) ||
        ArrayLength(facts.variant_enum_names) !=
            ArrayLength(rebuilt.variant_enum_names) ||
        ArrayLength(facts.variant_names) != ArrayLength(rebuilt.variant_names) ||
        ArrayLength(facts.variant_param_starts) !=
            ArrayLength(rebuilt.variant_param_starts) ||
        ArrayLength(facts.variant_param_counts) !=
            ArrayLength(rebuilt.variant_param_counts) ||
        ArrayLength(facts.variant_param_type_names) !=
            ArrayLength(rebuilt.variant_param_type_names) {
        return false;
    }
    let i: Int = 0;
    while i < ArrayLength(facts.enum_names) {
        if facts.node_ids[i] != rebuilt.node_ids[i] ||
            facts.enum_names[i] != rebuilt.enum_names[i] {
            return false;
        }
        i = i + 1;
    }
    let variant_index: Int = 0;
    while variant_index < ArrayLength(facts.variant_names) {
        if facts.variant_enum_names[variant_index] !=
                rebuilt.variant_enum_names[variant_index] ||
            facts.variant_names[variant_index] !=
                rebuilt.variant_names[variant_index] ||
            facts.variant_param_starts[variant_index] !=
                rebuilt.variant_param_starts[variant_index] ||
            facts.variant_param_counts[variant_index] !=
                rebuilt.variant_param_counts[variant_index] {
            return false;
        }
        variant_index = variant_index + 1;
    }
    let payload_index: Int = 0;
    while payload_index < ArrayLength(facts.variant_param_type_names) {
        if facts.variant_param_type_names[payload_index] !=
            rebuilt.variant_param_type_names[payload_index] {
            return false;
        }
        payload_index = payload_index + 1;
    }
    return true;
}
