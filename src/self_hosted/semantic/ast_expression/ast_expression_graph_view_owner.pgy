// Borrowed expression-graph view over artifact-bound surface facts.
import "ast_expression_surface_fact_owner.pgy";
import "ast_expression_graph_root_projection_owner.pgy";
import "../ast_signature_fact_owner.pgy";
import "../ast_intent_expression_environment_owner.pgy";
func SemanticAstExpressionSurfaceBorrowReady(artifact: AstTreeArtifact,
    ref facts: SemanticAstExpressionSurfaceFacts) -> Bool {
    let count: Int = ArrayLength(facts.node_ids);
    if !facts.ok || facts.artifact_node_count != artifact.count ||
        ArrayLength(facts.function_node_ids) != count ||
        ArrayLength(facts.intent_node_ids) != count || ArrayLength(facts.has_atoms) != count ||
        ArrayLength(facts.atoms) != count || ArrayLength(facts.has_values) != count ||
        ArrayLength(facts.values) != count || ArrayLength(facts.has_auxiliary_values) != count ||
        ArrayLength(facts.auxiliary_values) != count ||
        ArrayLength(facts.normalized_atoms) != count ||
        ArrayLength(facts.normalized_values) != count ||
        ArrayLength(facts.normalized_auxiliary_values) != count ||
        ArrayLength(facts.operator_rows) != count * SemanticAstExpressionShapeWidth() ||
        !SemanticExpressionGraphFactsReady(facts.expression_graph, count * 3) {
        return false;
    }
    var previous_node_id: Int = -1;
    var i: Int = 0;
    while i < count {
        let node_id: Int = facts.node_ids[i];
        let function_node_id: Int = facts.function_node_ids[i];
        let intent_node_id: Int = facts.intent_node_ids[i];
        let has_graph: Bool = facts.expression_graph.has_roots[i * 3] ||
            facts.expression_graph.has_roots[i * 3 + 1] ||
            facts.expression_graph.has_roots[i * 3 + 2];
        if node_id <= previous_node_id || node_id < 0 || node_id >= artifact.count ||
            function_node_id < -1 || function_node_id >= artifact.count ||
            intent_node_id < -1 || intent_node_id >= artifact.count ||
            (function_node_id >= 0 && intent_node_id >= 0) ||
            (intent_node_id >= 0 && !TypedAstArenaNodeKindIs(
                artifact.arena, intent_node_id, TypedAstKindIntentDeclTag())) ||
            (function_node_id >= 0 && !TypedAstArenaNodeKindIsCallable(
                artifact.arena, function_node_id
            )) || (has_graph && function_node_id < 0 && intent_node_id < 0) ||
            (facts.expression_graph.has_roots[i * 3] && !facts.has_atoms[i]) ||
            (facts.expression_graph.has_roots[i * 3 + 1] && !facts.has_values[i]) ||
            (facts.expression_graph.has_roots[i * 3 + 2] && !facts.has_auxiliary_values[i]) {
            return false;
        }
        previous_node_id = node_id;
        i = i + 1;
    }
    return true;
}
func SemanticAstExpressionIntentNodeAt(ref facts: SemanticAstExpressionSurfaceFacts,
    ref intents: SemanticAstIntentSignatureFacts, surface_index: Int) -> Option<Int> {
    if !facts.ok || !intents.ok || intents.artifact_node_count != facts.artifact_node_count ||
        surface_index < 0 || surface_index >= ArrayLength(facts.node_ids) ||
        surface_index >= ArrayLength(facts.intent_node_ids) { return None; }
    let node_id: Int = facts.intent_node_ids[surface_index];
    if node_id < 0 || !IsSome(SemanticAstIntentSignatureIndexForNode(intents, node_id)) {
        return None;
    }
    return Some(node_id);
}
func SemanticAstExpressionFunctionNodeAt(ref facts: SemanticAstExpressionSurfaceFacts,
    ref signatures: SemanticAstFunctionSignatureFacts, surface_index: Int) -> Option<Int> {
    if !facts.ok || !signatures.ok || signatures.artifact_node_count != facts.artifact_node_count ||
        surface_index < 0 || surface_index >= ArrayLength(facts.node_ids) ||
        surface_index >= ArrayLength(facts.function_node_ids) {
        return None;
    }
    let function_node_id: Int = facts.function_node_ids[surface_index];
    if function_node_id < 0 || !IsSome(
        SemanticAstFunctionSignatureIndexForNode(
            signatures, function_node_id
        )
    ) {
        return None;
    }
    return Some(function_node_id);
}

func SemanticAstExpressionGraphRootForNode(
    ref facts: SemanticAstExpressionSurfaceFacts, node_id: Int, lane: Int
) -> Option<Int> {
    if !facts.ok { return None; }
    return SemanticAstExpressionGraphRootForProjection(
        facts.node_ids, facts.expression_graph, node_id, lane
    );
}
