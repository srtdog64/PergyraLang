// Executable contract for parser-bound semantic expression surface rows.

import "ast_expression_surface_query_owner.pgy";
import "ast_expression_graph_node_view_owner.pgy";
import "ast_expression_typed_binding_owner.pgy";

func SemanticAstExpressionSurfaceFactsContractReady() -> Bool {
    let artifact: AstTreeArtifact = ParserAstTreeArtifactFromText(
        "Program:\n  Function: Main\n    Parameters:\n    Returns: Void\n    Body:\n      Block:\n        Let: x : String = Concat(\"None\", \"x\")\n        Let: y : Int = 1 + (2 * 3)\n        Log((left + right))\n        If: (ready && enabled || fallback != denied)\n          Then:\n            Block:\n              Log(\"ok\")\n"
    );
    let facts: SemanticAstExpressionSurfaceFacts =
        SemanticAstExpressionSurfaceFactsFromTypedArtifact(artifact);
    let surface_count: Int = SemanticAstExpressionSurfaceCount(facts);
    if surface_count < 3 { return false; }
    let middle_row: Int = surface_count / 2;
    let first_index: Option<Int> = SemanticAstExpressionSurfaceIndexForNode(
        facts, facts.node_ids[0]
    );
    let middle_index: Option<Int> = SemanticAstExpressionSurfaceIndexForNode(
        facts, facts.node_ids[middle_row]
    );
    let last_index: Option<Int> = SemanticAstExpressionSurfaceIndexForNode(
        facts, facts.node_ids[surface_count - 1]
    );
    var additive_shape: SemanticAstExpressionShapeFact =
        SemanticAstExpressionInvalidShape();
    var logical_shape: SemanticAstExpressionShapeFact =
        SemanticAstExpressionInvalidShape();
    // Roots in the one expression graph the facts own; a view would carry a
    // whole copy of that graph for each of the three expressions.
    var logical_root: Int = 0;
    var value_root: Int = 0;
    var arithmetic_root: Int = 0;
    var logical_found: Bool = false;
    var value_found: Bool = false;
    var arithmetic_found: Bool = false;
    var i: Int = 0;
    while i < SemanticAstExpressionSurfaceCount(facts) {
        if facts.has_atoms[i] && facts.normalized_atoms[i] == "left + right" {
            additive_shape = SemanticAstExpressionShapeAt(
                facts, i, AstExpressionLaneAtom()
            );
        }
        if facts.has_atoms[i] && facts.normalized_atoms[i] ==
            "ready && enabled || fallback != denied" {
            logical_shape = SemanticAstExpressionShapeAt(
                facts, i, AstExpressionLaneAtom()
            );
            let root: Option<Int> = SemanticExpressionGraphRootAt(
                facts.expression_graph, i, AstExpressionLaneAtom()
            );
            if IsSome(root) { logical_root = UnwrapOption(root); logical_found = true; }
        }
        if facts.has_values[i] && StartsWith(
            facts.normalized_values[i], "Concat("
        ) {
            let root: Option<Int> = SemanticExpressionGraphRootAt(
                facts.expression_graph, i, AstExpressionLaneValue()
            );
            if IsSome(root) { value_root = UnwrapOption(root); value_found = true; }
        }
        if facts.has_values[i] &&
            facts.normalized_values[i] == "1 + (2 * 3)" {
            let root: Option<Int> = SemanticExpressionGraphRootAt(
                facts.expression_graph, i, AstExpressionLaneValue()
            );
            if IsSome(root) { arithmetic_root = UnwrapOption(root); arithmetic_found = true; }
        }
        i = i + 1;
    }
    let logical_root_kind: Option<Int> = SemanticExpressionGraphNodeKind(
        facts.expression_graph, logical_root
    );
    let value_root_kind: Option<Int> = SemanticExpressionGraphNodeKind(
        facts.expression_graph, value_root
    );
    let value_root_text: Option<String> = SemanticExpressionGraphNodeText(
        facts.expression_graph, value_root
    );
    let arithmetic_root_kind: Option<Int> = SemanticExpressionGraphNodeKind(
        facts.expression_graph, arithmetic_root
    );
    let arithmetic_right: Option<Int> = SemanticExpressionGraphRightChild(
        facts.expression_graph, arithmetic_root
    );
    var arithmetic_right_kind: Option<Int> = None;
    if IsSome(arithmetic_right) {
        arithmetic_right_kind = SemanticExpressionGraphNodeKind(
            facts.expression_graph, UnwrapOption(arithmetic_right)
        );
    }
    return SemanticAstExpressionSurfaceFactsMatchArtifact(artifact, facts) &&
        IsSome(first_index) && UnwrapOption(first_index) == 0 &&
        IsSome(middle_index) && UnwrapOption(middle_index) == middle_row &&
        IsSome(last_index) &&
        UnwrapOption(last_index) == surface_count - 1 &&
        !IsSome(SemanticAstExpressionSurfaceIndexForNode(facts, 0)) &&
        !IsSome(SemanticAstExpressionSurfaceIndexForNode(facts, -1)) &&
        !IsSome(SemanticAstExpressionSurfaceIndexForNode(
            facts, artifact.count
        )) &&
        !IsSome(SemanticExpressionGraphRootAt(
            facts.expression_graph, surface_count, AstExpressionLaneAtom()
        )) &&
        SemanticAstExpressionSurfaceCallPresent(facts, "Concat") &&
        !SemanticAstExpressionSurfaceTokenPresent(facts, "None") &&
        !SemanticAstExpressionSurfaceCallPresent(facts, "Substring") &&
        additive_shape.ok && additive_shape.normalized_text == "left + right" &&
        additive_shape.additive_index == 5 &&
        additive_shape.additive_operator_code == SourceByteOf("+") &&
        logical_shape.ok && logical_shape.logical_and_index == 6 &&
        logical_shape.logical_or_index == 17 &&
        logical_shape.equality_index == 29 && logical_shape.equality_is_not &&
        logical_found && IsSome(logical_root_kind) &&
        UnwrapOption(logical_root_kind) == AstExpressionNodeLogicalOr() &&
        value_found && IsSome(value_root_kind) &&
        UnwrapOption(value_root_kind) == AstExpressionNodeCallArgument() &&
        IsSome(value_root_text) &&
        UnwrapOption(value_root_text) == "Concat(\"None\", \"x\")" &&
        arithmetic_found && IsSome(arithmetic_root_kind) &&
        UnwrapOption(arithmetic_root_kind) == AstExpressionNodeAdd() &&
        IsSome(arithmetic_right) && IsSome(arithmetic_right_kind) &&
        UnwrapOption(arithmetic_right_kind) == AstExpressionNodeMultiply();
}
