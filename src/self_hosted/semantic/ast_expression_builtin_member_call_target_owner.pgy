// Exact source-member/canonical-builtin join for syntax-id-zero member calls.
import "ast_expression_call_target_fact_owner.pgy";
import "builtin_signature_owner.pgy";

func SemanticExpressionBuiltinMemberCallTargetExpected(
    ref graph: SemanticExpressionGraphFacts,
    ref function_tables: SemanticAstExpressionFunctionTableFacts,
    call_node: Int,
    callee_node: Int
) -> SemanticExpressionCallTargetFact {
    let builtin: Option<Int> =
        SemanticAstExpressionFunctionTableCallableIndex(
            function_tables,
            graph.arena.call_target_names[call_node]);
    let member: SemanticMemberAccessView =
        SemanticMemberAccessViewFromGraph(graph, callee_node);
    if !IsSome(builtin) || !member.ok {
        return SemanticExpressionCallTargetFact(
            false, SemanticCallTargetMember(), "", 1);
    }
    let source_member_name: Option<String> =
        SemanticExpressionGraphNodeText(graph, member.member_node);
    if !IsSome(source_member_name) ||
        graph.arena.identities.call_target_syntax_ids[call_node] != 0 ||
        function_tables.names[UnwrapOption(builtin)] != "Array_Slice" ||
        !SemanticBuiltinMemberCallableMatches(
            "Array_Slice", UnwrapOption(source_member_name)) {
        return SemanticExpressionCallTargetFact(
            false, SemanticCallTargetMember(), "", 1);
    }
    return SemanticExpressionCallTargetFact(
        true, SemanticCallTargetMember(), "Array_Slice", 1
    );
}

func SemanticExpressionBuiltinMemberCallTargetReady(
    ref graph: SemanticExpressionGraphFacts,
    ref function_tables: SemanticAstExpressionFunctionTableFacts,
    call_node: Int
) -> Bool {
    let call: SemanticCallSpineView =
        SemanticCallSpineViewFromGraph(graph, call_node);
    if !call.ok || call.call_node != call_node ||
        graph.arena.call_target_kinds[call_node] !=
            SemanticCallTargetMember() {
        return false;
    }
    let builtin: SemanticExpressionCallTargetFact =
        SemanticExpressionBuiltinMemberCallTargetExpected(
            graph, function_tables, call_node, call.callee_node);
    return builtin.ok && builtin.kind == SemanticCallTargetMember() &&
        builtin.parameter_offset == 1 &&
        graph.arena.call_target_names[call_node] == builtin.name;
}
