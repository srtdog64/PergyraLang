// Stable expression-call identity derived from the owning syntax row.
//
// Global expression-graph indexes are transient storage positions.  A call is
// identified by its statement SyntaxNodeId, expression lane, and call ordinal
// inside that lane's parser-owned expression root.  The tuple survives graph
// append/rebase and can therefore cross the semantic -> MIR boundary.

import "ast_expression_surface_fact_owner.pgy";

struct SemanticExpressionCallIdentity {
    ok: Bool;
    owner_node_id: Int;
    lane: Int;
    local_call_ordinal: Int;
}

func SemanticExpressionCallIdentityInvalid(
) -> SemanticExpressionCallIdentity {
    return SemanticExpressionCallIdentity(false, -1, -1, -1);
}

func SemanticExpressionGraphRootStartAt(
    ref graph: SemanticExpressionGraphFacts,
    root_slot: Int
) -> Option<Int> {
    if root_slot < 0 || root_slot >= ArrayLength(graph.roots) ||
        !graph.has_roots[root_slot] {
        return None;
    }
    let previous_root: Int = -1;
    let i: Int = 0;
    while i < root_slot {
        if graph.has_roots[i] {
            previous_root = graph.roots[i];
        }
        i = i + 1;
    }
    let root: Int = graph.roots[root_slot];
    if root <= previous_root {
        return None;
    }
    return Some(previous_root + 1);
}

func SemanticExpressionCallIdentityForNode(
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    call_node_id: Int
) -> SemanticExpressionCallIdentity {
    if call_node_id < 0 || call_node_id >=
        SemanticExpressionGraphArenaNodeCount(
            surfaces.expression_graph.arena
        ) || surfaces.expression_graph.arena.node_kinds[call_node_id] !=
            AstExpressionNodeCall() {
        return SemanticExpressionCallIdentityInvalid();
    }
    let slot: Int = 0;
    while slot < ArrayLength(surfaces.expression_graph.roots) {
        if surfaces.expression_graph.has_roots[slot] {
            let start_opt: Option<Int> =
                SemanticExpressionGraphRootStartAt(
                    surfaces.expression_graph, slot
                );
            if !IsSome(start_opt) {
                return SemanticExpressionCallIdentityInvalid();
            }
            let start: Int = UnwrapOption(start_opt);
            let root: Int = surfaces.expression_graph.roots[slot];
            if call_node_id >= start && call_node_id <= root {
                let ordinal: Int = 0;
                let node: Int = start;
                while node <= call_node_id {
                    if surfaces.expression_graph.arena.node_kinds[node] ==
                        AstExpressionNodeCall() {
                        if node == call_node_id {
                            let surface_index: Int = slot / 3;
                            let lane: Int = slot % 3;
                            if surface_index < 0 || surface_index >=
                                SemanticAstExpressionSurfaceCount(surfaces) {
                                return SemanticExpressionCallIdentityInvalid();
                            }
                            return SemanticExpressionCallIdentity(
                                true, surfaces.node_ids[surface_index], lane,
                                ordinal
                            );
                        }
                        ordinal = ordinal + 1;
                    }
                    node = node + 1;
                }
                return SemanticExpressionCallIdentityInvalid();
            }
        }
        slot = slot + 1;
    }
    return SemanticExpressionCallIdentityInvalid();
}

func SemanticExpressionCallNodeForIdentity(
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    owner_node_id: Int,
    lane: Int,
    local_call_ordinal: Int
) -> Option<Int> {
    if owner_node_id < 0 || lane < AstExpressionLaneAtom() ||
        lane > AstExpressionLaneAuxiliary() || local_call_ordinal < 0 {
        return None;
    }
    let surface_index: Int = 0;
    while surface_index < SemanticAstExpressionSurfaceCount(surfaces) &&
        surfaces.node_ids[surface_index] != owner_node_id {
        surface_index = surface_index + 1;
    }
    if surface_index >= SemanticAstExpressionSurfaceCount(surfaces) {
        return None;
    }
    let slot: Int = surface_index * 3 + lane;
    let start_opt: Option<Int> = SemanticExpressionGraphRootStartAt(
        surfaces.expression_graph, slot
    );
    if !IsSome(start_opt) { return None; }
    let ordinal: Int = 0;
    let node: Int = UnwrapOption(start_opt);
    let root: Int = surfaces.expression_graph.roots[slot];
    while node <= root {
        if surfaces.expression_graph.arena.node_kinds[node] ==
            AstExpressionNodeCall() {
            if ordinal == local_call_ordinal { return Some(node); }
            ordinal = ordinal + 1;
        }
        node = node + 1;
    }
    return None;
}

func SemanticExpressionCallIdentityEqual(
    left_owner_node_id: Int,
    left_lane: Int,
    left_ordinal: Int,
    right_owner_node_id: Int,
    right_lane: Int,
    right_ordinal: Int
) -> Bool {
    return left_owner_node_id == right_owner_node_id &&
        left_lane == right_lane && left_ordinal == right_ordinal;
}
