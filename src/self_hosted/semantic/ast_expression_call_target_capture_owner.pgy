// Signature-only initial capture of canonical callable target rows.
import "ast_expression_call_target_fact_owner.pgy";
import "ast_expression_graph_call_view_owner.pgy";
import "ast_signature_fact_owner.pgy";
import "ast_nominal_constructor_fact_owner.pgy";
import "ast_expression_environment_owner.pgy";
import "ast_expression_builtin_member_call_target_owner.pgy";
import "role_operator_vocabulary_owner.pgy";
import "ast_expression_graph_node_view_owner.pgy";
import "ast_expression_carried_callable_identity_owner.pgy";
struct SemanticExpressionCallTargetCapture {
    graph: SemanticExpressionGraphFacts;
    failure_node_id: Int;
    failure_lane: String;
}
struct SemanticExpressionCallTargetDecision {
    ok: Bool;
    kind: Int;
    name_source: Int;
    name_index: Int;
    parameter_offset: Int;
}
func SemanticExpressionCallTargetNameNone() -> Int { return 0; }
func SemanticExpressionCallTargetNameCallable() -> Int { return 1; }
func SemanticExpressionCallTargetNameGraphNode() -> Int { return 2; }
func SemanticExpressionCallTargetNameCarried() -> Int { return 3; }
func SemanticExpressionCallTargetDecisionForNode(
    ref graph: SemanticExpressionGraphFacts, signatures: SemanticAstFunctionSignatureFacts,
    intents: SemanticAstIntentSignatureFacts,
    ref function_tables: SemanticAstExpressionFunctionTableFacts,
    require_carried: Bool,
    node_id: Int
) -> SemanticExpressionCallTargetDecision {
    let kind: Option<Int> = SemanticExpressionGraphNodeKind(graph, node_id);
    if !IsSome(kind) {
        return SemanticExpressionCallTargetDecision(
            false, SemanticCallTargetNone(),
            SemanticExpressionCallTargetNameNone(), -1, 0);
    }
    if UnwrapOption(kind) != AstExpressionNodeCall() {
        if require_carried &&
            graph.arena.call_target_kinds[node_id] ==
                SemanticCallTargetRoleOperator() &&
            graph.arena.call_target_names[node_id] != "" &&
            SemanticRoleOperatorKindSupported(UnwrapOption(kind)) {
            return SemanticExpressionCallTargetDecision(
                true, SemanticCallTargetRoleOperator(),
                SemanticExpressionCallTargetNameCarried(), node_id, 0);
        }
        return SemanticExpressionCallTargetDecision(
            true, SemanticCallTargetNone(),
            SemanticExpressionCallTargetNameNone(), -1, 0);
    }
    let call: SemanticCallSpineView = SemanticCallSpineViewFromGraph(
        graph, node_id
    );
    if !call.ok || call.call_node != node_id {
        return SemanticExpressionCallTargetDecision(
            false, SemanticCallTargetNone(),
            SemanticExpressionCallTargetNameNone(), -1, 0);
    }
    let callee_kind: Option<Int> = SemanticExpressionGraphNodeKind(
        graph, call.callee_node);
    if !IsSome(callee_kind) {
        return SemanticExpressionCallTargetDecision(
            false, SemanticCallTargetNone(),
            SemanticExpressionCallTargetNameNone(), -1, 0);
    }
    if UnwrapOption(callee_kind) == AstExpressionNodeLeaf() {
        let source_name: Option<String> = SemanticExpressionGraphNodeText(
            graph, call.callee_node);
        if !IsSome(source_name) {
            return SemanticExpressionCallTargetDecision(
                false, SemanticCallTargetNone(),
                SemanticExpressionCallTargetNameNone(), -1, 0);
        }
        let binding: SemanticExpressionBindingIdentityFact = SemanticExpressionGraphBindingIdentity(
            graph, call.callee_node);
        if !binding.ok {
            return SemanticExpressionCallTargetDecision(
                false, SemanticCallTargetNone(),
                SemanticExpressionCallTargetNameNone(), -1, 0);
        }
        let binding_ordinal: Option<Int> = SemanticExpressionBindingIdentityOrdinal(binding);
        if require_carried && binding.kind ==
            SemanticExpressionBindingFormalParameter() {
            let carried_target_syntax_id: Int =
                graph.arena.identities.call_target_syntax_ids[node_id];
            if graph.arena.call_target_kinds[node_id] !=
                    SemanticCallTargetDirect() ||
                graph.arena.call_target_names[node_id] !=
                    UnwrapOption(source_name) ||
                carried_target_syntax_id <= 0 ||
                !IsSome(binding_ordinal) ||
                binding.syntax_id != carried_target_syntax_id ||
                !SemanticExpressionFormalParameterCarriedIdentityReady(
                    signatures, carried_target_syntax_id,
                    UnwrapOption(binding_ordinal),
                    UnwrapOption(source_name)) {
                return SemanticExpressionCallTargetDecision(
                    false, SemanticCallTargetDirect(),
                    SemanticExpressionCallTargetNameNone(), -1, 0);
            }
            return SemanticExpressionCallTargetDecision(
                true, SemanticCallTargetDirect(),
                SemanticExpressionCallTargetNameGraphNode(),
                call.callee_node, 0);
        }
        let direct: Option<Int> =
            SemanticAstExpressionFunctionTableCallableIndex(
                function_tables, UnwrapOption(source_name));
        if !IsSome(direct) {
            let protocol: SemanticAstDomainQueryProtocol =
                SemanticAstDomainQueryProtocolFromName(
                    UnwrapOption(source_name)
                );
            if protocol.applies {
                return SemanticExpressionCallTargetDecision(
                    true, SemanticCallTargetDirect(),
                    SemanticExpressionCallTargetNameGraphNode(),
                    call.callee_node, 0);
            }
            return SemanticExpressionCallTargetDecision(
                true, SemanticCallTargetNone(),
                SemanticExpressionCallTargetNameNone(), -1, 0);
        }
        let canonical_target_name: String =
            function_tables.names[UnwrapOption(direct)];
        let declared_callable: Bool =
            SemanticExpressionDeclaredCallableTargetExists(
                signatures, intents, canonical_target_name);
        if require_carried && declared_callable {
            let carried_target_syntax_id: Int =
                graph.arena.identities.call_target_syntax_ids[node_id];
            if binding.kind !=
                    SemanticExpressionBindingDeclaredCallable() ||
                IsSome(binding_ordinal) ||
                binding.syntax_id != carried_target_syntax_id ||
                !SemanticExpressionDeclaredCallableCarriedIdentityReady(
                    signatures, intents, canonical_target_name,
                    carried_target_syntax_id) {
                return SemanticExpressionCallTargetDecision(
                    false, SemanticCallTargetDirect(),
                    SemanticExpressionCallTargetNameNone(), -1, 0);
            }
        } else if require_carried &&
            (graph.arena.identities.call_target_syntax_ids[node_id] != 0 ||
             binding.kind != SemanticExpressionBindingNone() ||
             IsSome(binding_ordinal) || binding.syntax_id != 0) {
            return SemanticExpressionCallTargetDecision(
                false, SemanticCallTargetDirect(),
                SemanticExpressionCallTargetNameNone(), -1, 0);
        }
        return SemanticExpressionCallTargetDecision(
            true, SemanticCallTargetDirect(),
            SemanticExpressionCallTargetNameCallable(),
            UnwrapOption(direct), 0);
    }
    if UnwrapOption(callee_kind) != AstExpressionNodeMemberAccess() {
        return SemanticExpressionCallTargetDecision(
            true, SemanticCallTargetNone(),
            SemanticExpressionCallTargetNameNone(), -1, 0);
    }
    let source_name: Option<String> = SemanticExpressionGraphNodeText(
        graph, call.callee_node
    );
    if !IsSome(source_name) {
        return SemanticExpressionCallTargetDecision(
            false, SemanticCallTargetNone(),
            SemanticExpressionCallTargetNameNone(), -1, 0);
    }
    let target: Option<Int> =
        SemanticAstExpressionFunctionTableCallableIndex(
            function_tables, UnwrapOption(source_name));
    if IsSome(target) {
        return SemanticExpressionCallTargetDecision(
            true, SemanticCallTargetNamespace(),
            SemanticExpressionCallTargetNameCallable(),
            UnwrapOption(target), 0);
    }
    if require_carried {
        return SemanticExpressionCallTargetDecision(
            false, SemanticCallTargetMember(),
            SemanticExpressionCallTargetNameNone(), -1, 1);
    }
    return SemanticExpressionCallTargetDecision(
        true, SemanticCallTargetNone(),
        SemanticExpressionCallTargetNameNone(), -1, 0);
}
func SemanticExpressionGraphCallTargetCaptureFromSignatures(
    graph: SemanticExpressionGraphFacts, signatures: SemanticAstFunctionSignatureFacts,
    intents: SemanticAstIntentSignatureFacts,
    constructors: SemanticAstNominalConstructorFacts,
    enums: SemanticAstEnumFacts,
    require_carried: Bool,
    function_tables: SemanticAstExpressionFunctionTableFacts
) -> SemanticExpressionCallTargetCapture {
    if !graph.ok || !signatures.ok || !constructors.ok ||
        !enums.ok ||
        !SemanticExpressionGraphArenaReady(graph.arena) ||
        !SemanticAstExpressionFunctionTableFactsReady(function_tables) {
        return SemanticExpressionCallTargetCapture(
            SemanticExpressionGraphFacts(
                false, graph.roots, graph.has_roots, graph.arena),
            -1, "call_target_input"
        );
    }
    let target_names: Array<String> = graph.arena.call_target_names;
    let target_kinds: Array<Int> = graph.arena.call_target_kinds;
    let valid: Bool = true;
    let member_names: Array<String> = [];
    let signature_index: Int = 0;
    while signature_index < SemanticAstFunctionSignatureCount(signatures) {
        let owner: Option<String> = SemanticAstFunctionOwnerNameAt(
            signatures, signature_index
        );
        let name: Option<String> = SemanticAstFunctionNameAt(
            signatures, signature_index
        );
        if !IsSome(owner) || !IsSome(name) {
            return SemanticExpressionCallTargetCapture(
                SemanticExpressionGraphFacts(
                    false, graph.roots, graph.has_roots, graph.arena),
                -1, "call_target_signature"
            );
        }
        if UnwrapOption(owner) != "" {
            ArrayPush(
                member_names,
                SemanticCallableCanonicalDeclaredName(
                    UnwrapOption(owner), UnwrapOption(name)
                )
            );
        }
        signature_index = signature_index + 1;
    }
    let node_id: Int = 0;
    let failure_node_id: Int = -1;
    let failure_lane: String = "";
    while node_id < SemanticExpressionGraphArenaNodeCount(graph.arena) && valid {
        if require_carried && target_kinds[node_id] ==
                SemanticCallTargetMember() {
            let declared_member: Bool = IsSome(SemanticCallableIndex(
                member_names, target_names[node_id]));
            if !declared_member &&
                !SemanticExpressionBuiltinMemberCallTargetReady(
                    graph, function_tables, node_id) {
                valid = false;
                failure_node_id = node_id;
                failure_lane = "call_target_carried";
            }
        } else {
            let expected: SemanticExpressionCallTargetDecision =
                SemanticExpressionCallTargetDecisionForNode(
                    graph, signatures, intents, function_tables,
                    require_carried, node_id
                );
            if !expected.ok {
                valid = false;
                failure_node_id = node_id;
                failure_lane = "call_target_expected";
            } else {
                let expected_name: String = "";
                let expected_name_ready: Bool = true;
                if expected.name_source ==
                        SemanticExpressionCallTargetNameCallable() {
                    if expected.name_index < 0 || expected.name_index >=
                            ArrayLength(function_tables.names) {
                        expected_name_ready = false;
                    } else {
                        expected_name =
                            function_tables.names[expected.name_index];
                    }
                } else if expected.name_source ==
                        SemanticExpressionCallTargetNameGraphNode() {
                    let graph_name: Option<String> =
                        SemanticExpressionGraphNodeText(
                            graph, expected.name_index);
                    if !IsSome(graph_name) { expected_name_ready = false; }
                    else { expected_name = UnwrapOption(graph_name); }
                } else if expected.name_source ==
                        SemanticExpressionCallTargetNameCarried() {
                    if expected.name_index < 0 || expected.name_index >=
                            ArrayLength(target_names) {
                        expected_name_ready = false;
                    } else {
                        expected_name = target_names[expected.name_index];
                    }
                } else if expected.name_source !=
                        SemanticExpressionCallTargetNameNone() {
                    expected_name_ready = false;
                }
                if !expected_name_ready {
                    valid = false;
                    failure_node_id = node_id;
                    failure_lane = "call_target_name_owner";
                } else if require_carried &&
                    (target_kinds[node_id] != expected.kind ||
                     target_names[node_id] != expected_name) {
                    valid = false;
                    failure_node_id = node_id;
                    failure_lane = "call_target_carried";
                } else if !require_carried {
                    ArraySet(target_kinds, node_id, expected.kind);
                    ArraySet(target_names, node_id, expected_name);
                }
            }
        }
        node_id = node_id + 1;
    }
    let arena: SemanticExpressionGraphArena =
        SemanticExpressionGraphArenaFromTopologyWithIdentities(
        graph.arena.topology, graph.arena.node_texts,
        target_kinds, target_names, graph.arena.call_return_type_names,
        graph.arena.identities,
        graph.arena.place_kinds
    );
    if failure_node_id >= 0 {
        let failure_callee_id: Int = graph.arena.topology.left_children[failure_node_id];
        failure_lane = Concat(failure_lane, Concat(
            "|text=", graph.arena.node_texts[failure_node_id]));
        failure_lane = Concat(failure_lane, Concat(
            "|target=", graph.arena.call_target_names[failure_node_id]));
        failure_lane = Concat(failure_lane, Concat(
            "|target_id=", ToString(graph.arena.identities
                .call_target_syntax_ids[failure_node_id])));
        failure_lane = Concat(failure_lane, Concat(
            "|callee=", ToString(failure_callee_id)));
        failure_lane = Concat(failure_lane, Concat("|callee_text=",
            graph.arena.node_texts[failure_callee_id]));
        failure_lane = Concat(failure_lane, Concat("|callee_binding=", ToString(graph.arena.identities.binding_syntax_ids[failure_callee_id])));
        failure_lane = Concat(failure_lane, Concat("|callee_kind=",
            ToString(graph.arena.identities.binding_kinds[failure_callee_id])));
    }
    return SemanticExpressionCallTargetCapture(
        SemanticExpressionGraphFacts(
            valid && SemanticExpressionGraphArenaReady(arena),
            graph.roots, graph.has_roots, arena),
        failure_node_id, failure_lane
    );
}
func SemanticExpressionGraphCallTargetsFromSignatures(
    graph: SemanticExpressionGraphFacts, signatures: SemanticAstFunctionSignatureFacts,
    intents: SemanticAstIntentSignatureFacts,
    constructors: SemanticAstNominalConstructorFacts,
    enums: SemanticAstEnumFacts,
    require_carried: Bool,
    function_tables: SemanticAstExpressionFunctionTableFacts
) -> SemanticExpressionGraphFacts {
    return SemanticExpressionGraphCallTargetCaptureFromSignatures(
        graph, signatures, intents, constructors, enums, require_carried,
        function_tables).graph;
}
