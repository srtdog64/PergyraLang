// Executable contract for canonical callable target carriage.

import "ast_expression_call_target_capture_owner.pgy";
import "ast_expression_graph_build_owner.pgy";

func SemanticExpressionCallTargetFactContractReady() -> Bool {
    let artifact: AstTreeArtifact = AstTreeArtifactFromText(
        "Program:\n  Struct: Pair\n    Fields:\n      left: Int\n      right: Int\n  Function: Math_Add\n    Parameters:\n    Returns: Int\n    Body:\n      Block:\n        Return: 7\n"
        + "  Class: Box\n    Fields:\n      value: Int\n    Methods:\n      Function: Get\n        Parameters:\n          self\n        Returns: Int\n        Body:\n          Block:\n            Return: self.value\n"
    );
    let signatures: SemanticAstFunctionSignatureFacts =
        SemanticAstFunctionSignatureFactsFromArtifact(artifact);
    let intents: SemanticAstIntentSignatureFacts =
        SemanticAstIntentSignatureFactsFromArtifact(artifact);
    let constructors: SemanticAstNominalConstructorFacts =
        SemanticAstNominalConstructorFactsFromArtifact(artifact);
    let enums: SemanticAstEnumFacts = SemanticAstEnumFactsFromArtifact(artifact);
    let function_tables: SemanticAstExpressionFunctionTableFacts =
        SemanticAstExpressionFunctionTableFactsFromArtifact(
            artifact, signatures, constructors, enums
        );
    let node_kinds: Array<Int> = [];
    let node_texts: Array<String> = [];
    let left_children: Array<Int> = [];
    let right_children: Array<Int> = [];
    let call_target_kinds: Array<Int> = [];
    let call_target_names: Array<String> = [];
    let build: SemanticExpressionGraphBuild =
        SemanticExpressionGraphBuildCompactBridgeFromText(
            node_kinds, node_texts, left_children, right_children,
            call_target_kinds, call_target_names, "Math.Add()"
        );
    let arena: SemanticExpressionGraphArena =
        SemanticExpressionGraphArenaUnclassified(
        node_kinds, node_texts, left_children, right_children,
        call_target_kinds, call_target_names
    );
    let source: SemanticExpressionGraphFacts = SemanticExpressionGraphFacts(
        build.ok, [build.root_id], [build.ok], arena
    );
    let carried: SemanticExpressionGraphFacts =
        SemanticExpressionGraphCallTargetsFromSignatures(
            source, signatures, intents, constructors, enums, false,
            function_tables
        );
    if !carried.ok ||
        carried.arena.call_target_names[build.root_id] != "Math_Add" ||
        !SemanticExpressionGraphCallTargetsFromSignatures(
            carried, signatures, intents, constructors, enums, true,
            function_tables
        ).ok {
        return false;
    }
    let missing_names: Array<String> = carried.arena.call_target_names;
    ArraySet(missing_names, build.root_id, "");
    let missing_arena: SemanticExpressionGraphArena =
        SemanticExpressionGraphArenaFromTopology(
            carried.arena.topology, carried.arena.node_texts,
            carried.arena.call_target_kinds, missing_names,
            carried.arena.call_return_type_names, carried.arena.place_kinds
        );
    let missing: SemanticExpressionGraphFacts = SemanticExpressionGraphFacts(
        true, carried.roots, carried.has_roots, missing_arena
    );
    if SemanticExpressionGraphCallTargetsFromSignatures(
        missing, signatures, intents, constructors, enums, true,
        function_tables
    ).ok {
        return false;
    }
    let builtin_kinds: Array<Int> = [];
    let builtin_texts: Array<String> = [];
    let builtin_left: Array<Int> = [];
    let builtin_right: Array<Int> = [];
    let builtin_target_kinds: Array<Int> = [];
    let builtin_target_names: Array<String> = [];
    let builtin_build: SemanticExpressionGraphBuild =
        SemanticExpressionGraphBuildCompactBridgeFromText(
            builtin_kinds, builtin_texts, builtin_left, builtin_right,
            builtin_target_kinds, builtin_target_names, "StringLength(\"x\")");
    let builtin_source: SemanticExpressionGraphFacts =
        SemanticExpressionGraphFacts(
            builtin_build.ok, [builtin_build.root_id], [builtin_build.ok],
            SemanticExpressionGraphArenaUnclassified(
                builtin_kinds, builtin_texts, builtin_left, builtin_right,
                builtin_target_kinds, builtin_target_names));
    let builtin_carried: SemanticExpressionGraphFacts =
        SemanticExpressionGraphCallTargetsFromSignatures(
            builtin_source, signatures, intents, constructors, enums, false,
            function_tables);
    let builtin_call: SemanticCallSpineView =
        SemanticCallSpineViewFromGraph(
            builtin_carried, builtin_build.root_id);
    if !builtin_carried.ok || !builtin_call.ok ||
        builtin_carried.arena.call_target_names[builtin_call.call_node] !=
            "StringLength" ||
        builtin_carried.arena.identities.call_target_syntax_ids[
            builtin_call.call_node] != 0 ||
        builtin_carried.arena.identities.binding_kinds[
            builtin_call.callee_node] != SemanticExpressionBindingNone() ||
        !SemanticExpressionGraphCallTargetsFromSignatures(
            builtin_carried, signatures, intents, constructors, enums, true,
            function_tables).ok {
        return false;
    }
    let declared_kinds: Array<Int> = [];
    let declared_texts: Array<String> = [];
    let declared_left: Array<Int> = [];
    let declared_right: Array<Int> = [];
    let declared_target_kinds: Array<Int> = [];
    let declared_target_names: Array<String> = [];
    let declared_build: SemanticExpressionGraphBuild =
        SemanticExpressionGraphBuildCompactBridgeFromText(
            declared_kinds, declared_texts, declared_left, declared_right,
            declared_target_kinds, declared_target_names, "Math_Add()");
    let declared_source: SemanticExpressionGraphFacts =
        SemanticExpressionGraphFacts(
            declared_build.ok, [declared_build.root_id], [declared_build.ok],
            SemanticExpressionGraphArenaUnclassified(
                declared_kinds, declared_texts, declared_left, declared_right,
                declared_target_kinds, declared_target_names));
    let declared_carried: SemanticExpressionGraphFacts =
        SemanticExpressionGraphCallTargetsFromSignatures(
            declared_source, signatures, intents, constructors, enums, false,
            function_tables);
    if !declared_carried.ok ||
        SemanticExpressionGraphCallTargetsFromSignatures(
            declared_carried, signatures, intents, constructors, enums, true,
            function_tables).ok {
        return false;
    }
    let constructor_kinds: Array<Int> = [];
    let constructor_texts: Array<String> = [];
    let constructor_left: Array<Int> = [];
    let constructor_right: Array<Int> = [];
    let constructor_target_kinds: Array<Int> = [];
    let constructor_target_names: Array<String> = [];
    let constructor_build: SemanticExpressionGraphBuild =
        SemanticExpressionGraphBuildCompactBridgeFromText(
            constructor_kinds, constructor_texts,
            constructor_left, constructor_right,
            constructor_target_kinds, constructor_target_names,
            "Pair(1, 2)"
        );
    let constructor_source: SemanticExpressionGraphFacts =
        SemanticExpressionGraphFacts(
            constructor_build.ok, [constructor_build.root_id],
            [constructor_build.ok], SemanticExpressionGraphArenaUnclassified(
                constructor_kinds, constructor_texts,
                constructor_left, constructor_right,
                constructor_target_kinds, constructor_target_names
            )
        );
    let constructor_carried: SemanticExpressionGraphFacts =
        SemanticExpressionGraphCallTargetsFromSignatures(
            constructor_source, signatures, intents, constructors, enums, false,
            function_tables
        );
    let constructor_call: SemanticCallSpineView =
        SemanticCallSpineViewFromGraph(
            constructor_carried, constructor_build.root_id
        );
    if !constructor_carried.ok || !constructor_call.ok ||
        constructor_carried.arena.call_target_names[
            constructor_call.call_node
        ] != "Pair" ||
        !SemanticExpressionGraphCallTargetsFromSignatures(
            constructor_carried, signatures, intents, constructors, enums, true,
            function_tables
        ).ok {
        return false;
    }
    let member_kinds: Array<Int> = [];
    let member_texts: Array<String> = [];
    let member_left: Array<Int> = [];
    let member_right: Array<Int> = [];
    let member_target_kinds: Array<Int> = [];
    let member_target_names: Array<String> = [];
    let member_build: SemanticExpressionGraphBuild =
        SemanticExpressionGraphBuildCompactBridgeFromText(
            member_kinds, member_texts, member_left, member_right,
            member_target_kinds, member_target_names, "box.Get()"
        );
    let member_unbound: SemanticExpressionGraphFacts =
        SemanticExpressionGraphFacts(
            member_build.ok, [member_build.root_id],
            [member_build.ok], SemanticExpressionGraphArenaUnclassified(
                member_kinds, member_texts, member_left, member_right,
                member_target_kinds, member_target_names
            )
        );
    let member_call: SemanticCallSpineView =
        SemanticCallSpineViewFromGraph(member_unbound, member_build.root_id);
    if !member_call.ok {
        return false;
    }
    ArraySet(
        member_target_kinds, member_call.call_node,
        SemanticCallTargetMember()
    );
    ArraySet(member_target_names, member_call.call_node, "Other_Get");
    let wrong_member: SemanticExpressionGraphFacts =
        SemanticExpressionGraphFacts(
            true, member_unbound.roots, member_unbound.has_roots,
            SemanticExpressionGraphArenaUnclassified(
                member_kinds, member_texts, member_left, member_right,
                member_target_kinds, member_target_names
            )
        );
    if SemanticExpressionGraphCallTargetsFromSignatures(
        wrong_member, signatures, intents, constructors, enums, true,
        function_tables
    ).ok {
        return false;
    }
    let derived_member: SemanticExpressionCallTargetFact =
        SemanticExpressionGraphResolvedCallTarget(
            wrong_member, member_build.root_id, constructors,
            ["box"], ["Box"], ["Box_Get", "Other_Get"], ["Int", "Int"]
        );
    if !derived_member.ok ||
        derived_member.kind != SemanticCallTargetMember() ||
        derived_member.name != "Box_Get" {
        return false;
    }
    ArraySet(member_target_names, member_call.call_node, "Box_Get");
    let member_carried: SemanticExpressionGraphFacts =
        SemanticExpressionGraphFacts(
            true, member_unbound.roots, member_unbound.has_roots,
            SemanticExpressionGraphArenaUnclassified(
                member_kinds, member_texts, member_left, member_right,
                member_target_kinds, member_target_names
            )
        );
    let member_verified: SemanticExpressionGraphFacts =
        SemanticExpressionGraphCallTargetsFromSignatures(
            member_carried, signatures, intents, constructors, enums, true,
            function_tables
        );
    let chain_kinds: Array<Int> = [];
    let chain_texts: Array<String> = [];
    let chain_left: Array<Int> = [];
    let chain_right: Array<Int> = [];
    let chain_target_kinds: Array<Int> = [];
    let chain_target_names: Array<String> = [];
    let chain_build: SemanticExpressionGraphBuild =
        SemanticExpressionGraphBuildCompactBridgeFromText(
            chain_kinds, chain_texts, chain_left, chain_right,
            chain_target_kinds, chain_target_names, "MakeBox().Get()"
        );
    let chain_graph: SemanticExpressionGraphFacts =
        SemanticExpressionGraphFacts(
            chain_build.ok, [chain_build.root_id], [chain_build.ok],
            SemanticExpressionGraphArenaUnclassified(
                chain_kinds, chain_texts, chain_left, chain_right,
                chain_target_kinds, chain_target_names
            )
        );
    let empty_names: Array<String> = [];
    let empty_types: Array<String> = [];
    let missing_returns: Array<String> = [];
    let chain_target: SemanticExpressionCallTargetFact =
        SemanticExpressionGraphResolvedCallTarget(
            chain_graph, chain_build.root_id, constructors,
            empty_names, empty_types,
            ["MakeBox", "Box_Get"], ["Box", "Int"]
        );
    let missing_return_target: SemanticExpressionCallTargetFact =
        SemanticExpressionGraphResolvedCallTarget(
            chain_graph, chain_build.root_id, constructors,
            empty_names, empty_types,
            ["MakeBox", "Box_Get"], missing_returns
        );
    return member_verified.ok && chain_build.ok && chain_target.ok &&
        chain_target.kind == SemanticCallTargetMember() &&
        chain_target.name == "Box_Get" && !missing_return_target.ok &&
        member_verified.arena.call_target_names[member_call.call_node] ==
            "Box_Get";
}
