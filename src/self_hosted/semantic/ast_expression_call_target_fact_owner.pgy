// Canonical callable targets bound to semantic call-node handles.

import "ast_expression_graph_fact_owner.pgy";
import "ast_expression_graph_call_view_owner.pgy";
import "ast_expression_graph_member_view_owner.pgy";
import "ast_expression_graph_receiver_type_owner.pgy";
import "ast_expression_environment_owner.pgy";
import "ast_expression_graph_view_owner.pgy";
import "ast_signature_fact_owner.pgy";
import "ast_type_name_canonical_owner.pgy";
import "callable_resolution_owner.pgy";
import "env_owner.pgy";

struct SemanticExpressionCallTargetFact {
    ok: Bool;
    kind: Int;
    name: String;
    parameter_offset: Int;
}

func SemanticExpressionGraphCallTargetKind(
    ref graph: SemanticExpressionGraphFacts,
    node_id: Int
) -> Option<Int> {
    if !graph.ok || node_id < 0 ||
        node_id >= SemanticExpressionGraphArenaNodeCount(graph.arena) {
        return None;
    }
    return Some(graph.arena.call_target_kinds[node_id]);
}

func SemanticExpressionGraphCallTargetName(
    ref graph: SemanticExpressionGraphFacts,
    node_id: Int
) -> Option<String> {
    if !graph.ok || node_id < 0 ||
        node_id >= SemanticExpressionGraphArenaNodeCount(graph.arena) {
        return None;
    }
    return Some(graph.arena.call_target_names[node_id]);
}

func SemanticExpressionGraphResolvedCallTarget(
    ref graph: SemanticExpressionGraphFacts,
    root_id: Int,
    ref constructors: SemanticAstNominalConstructorFacts,
    names: Array<String>,
    types: Array<String>,
    function_names: Array<String>
) -> SemanticExpressionCallTargetFact {
    let call: SemanticCallSpineView = SemanticCallSpineViewFromGraph(
        graph, root_id
    );
    if !call.ok {
        return SemanticExpressionCallTargetFact(
            false, SemanticCallTargetNone(), "", 0
        );
    }
    let target_kind: Option<Int> = SemanticExpressionGraphCallTargetKind(
        graph, call.call_node
    );
    let target_name: Option<String> = SemanticExpressionGraphCallTargetName(
        graph, call.call_node
    );
    if !IsSome(target_kind) || !IsSome(target_name) {
        return SemanticExpressionCallTargetFact(
            false, SemanticCallTargetNone(), "", 0
        );
    }
    if UnwrapOption(target_kind) == SemanticCallTargetDirect() ||
        UnwrapOption(target_kind) == SemanticCallTargetNamespace() ||
        UnwrapOption(target_kind) == SemanticCallTargetMember() {
        let target: Option<Int> = SemanticCallableIndex(
            function_names, UnwrapOption(target_name)
        );
        if !IsSome(target) {
            return SemanticExpressionCallTargetFact(
                false, UnwrapOption(target_kind), "", 0
            );
        }
        let parameter_offset: Int = 0;
        if UnwrapOption(target_kind) == SemanticCallTargetMember() {
            parameter_offset = 1;
        }
        return SemanticExpressionCallTargetFact(
            true, UnwrapOption(target_kind),
            function_names[UnwrapOption(target)], parameter_offset
        );
    }
    if UnwrapOption(target_kind) != SemanticCallTargetNone() ||
        UnwrapOption(target_name) != "" {
        return SemanticExpressionCallTargetFact(
            false, SemanticCallTargetNone(), "", 0
        );
    }
    let callee_kind: Option<Int> = SemanticExpressionGraphNodeKind(
        graph, call.callee_node
    );
    if !IsSome(callee_kind) {
        return SemanticExpressionCallTargetFact(
            false, SemanticCallTargetNone(), "", 0
        );
    }
    if UnwrapOption(callee_kind) == AstExpressionNodeLeaf() {
        let callee_text: Option<String> = SemanticExpressionGraphNodeText(
            graph, call.callee_node
        );
        if !IsSome(callee_text) {
            return SemanticExpressionCallTargetFact(
                false, SemanticCallTargetNone(), "", 0
            );
        }
        let direct: Option<Int> = SemanticCallableIndex(
            function_names, UnwrapOption(callee_text)
        );
        if !IsSome(direct) {
            return SemanticExpressionCallTargetFact(
                false, SemanticCallTargetNone(), "", 0
            );
        }
        return SemanticExpressionCallTargetFact(
            true, SemanticCallTargetDirect(),
            function_names[UnwrapOption(direct)], 0
        );
    }
    let member: SemanticMemberAccessView =
        SemanticMemberAccessViewFromGraph(graph, call.callee_node);
    if !member.ok {
        return SemanticExpressionCallTargetFact(
            false, SemanticCallTargetNone(), "", 0
        );
    }
    let member_name: Option<String> = SemanticExpressionGraphNodeText(
        graph, member.member_node
    );
    if !IsSome(member_name) {
        return SemanticExpressionCallTargetFact(
            false, SemanticCallTargetMember(), "", 1
        );
    }
    let receiver_type: Option<String> =
        SemanticExpressionGraphReceiverTypeName(
            graph, member.receiver_node, constructors, names, types
        );
    if !IsSome(receiver_type) {
        return SemanticExpressionCallTargetFact(
            false, SemanticCallTargetMember(), "", 1
        );
    }
    let receiver_type_fact: SemanticCanonicalTypeNameFact =
        SemanticCanonicalTypeNameFactFrom(UnwrapOption(receiver_type));
    let source_target: String = Concat(
        receiver_type_fact.nominal_base_name,
        Concat(".", UnwrapOption(member_name))
    );
    let method: Option<Int> = SemanticCallableIndex(
        function_names, source_target
    );
    if !IsSome(method) {
        return SemanticExpressionCallTargetFact(
            false, SemanticCallTargetMember(), "", 1
        );
    }
    return SemanticExpressionCallTargetFact(
        true, SemanticCallTargetMember(),
        function_names[UnwrapOption(method)], 1
    );
}

func SemanticExpressionGraphCarriedCallTargetsReady(
    ref graph: SemanticExpressionGraphFacts
) -> Bool {
    if !graph.ok || !SemanticExpressionGraphArenaReady(graph.arena) {
        return false;
    }
    let node_id: Int = 0;
    while node_id < SemanticExpressionGraphArenaNodeCount(graph.arena) {
        if graph.arena.node_kinds[node_id] == AstExpressionNodeCall() {
            let target_kind: Int = graph.arena.call_target_kinds[node_id];
            if (target_kind != SemanticCallTargetDirect() &&
                target_kind != SemanticCallTargetNamespace() &&
                target_kind != SemanticCallTargetMember()) ||
                graph.arena.call_target_names[node_id] == "" {
                return false;
            }
        }
        node_id = node_id + 1;
    }
    return true;
}
