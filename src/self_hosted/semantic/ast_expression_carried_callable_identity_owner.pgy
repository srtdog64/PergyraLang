// Exact carried identity checks for formal and declared callable lanes.

import "ast_signature_fact_owner.pgy";
import "ast_intent_signature_fact_owner.pgy";
import "ast_callable_type_shape_owner.pgy";
import "callable_resolution_owner.pgy";

func SemanticExpressionFormalParameterCarriedIdentityReady(
    signatures: SemanticAstFunctionSignatureFacts,
    parameter_node_id: Int, parameter_ordinal: Int,
    parameter_name: String
) -> Bool {
    if parameter_node_id <= 0 || parameter_ordinal < 0 ||
        parameter_name == "" {
        return false;
    }
    let matches: Int = 0;
    let signature: Int = 0;
    while signature < SemanticAstFunctionSignatureCount(signatures) {
        let count: Option<Int> = SemanticAstFunctionParamCountAt(
            signatures, signature);
        if !IsSome(count) { return false; }
        let ordinal: Int = 0;
        while ordinal < UnwrapOption(count) {
            let node: Option<Int> = SemanticAstFunctionParamNodeAt(
                signatures, signature, ordinal);
            let name: Option<String> = SemanticAstFunctionParamNameAt(
                signatures, signature, ordinal);
            let type_name: Option<String> = SemanticAstFunctionParamTypeAt(
                signatures, signature, ordinal);
            if !IsSome(node) || !IsSome(name) || !IsSome(type_name) {
                return false;
            }
            if UnwrapOption(node) == parameter_node_id {
                matches = matches + 1;
                if matches > 1 || ordinal != parameter_ordinal ||
                    UnwrapOption(name) != parameter_name ||
                    !SemanticAstCallableTypeShapeFromName(
                        UnwrapOption(type_name)).ok {
                    return false;
                }
            }
            ordinal = ordinal + 1;
        }
        signature = signature + 1;
    }
    return matches == 1;
}

func SemanticExpressionDeclaredCallableSyntaxId(
    signatures: SemanticAstFunctionSignatureFacts,
    intents: SemanticAstIntentSignatureFacts,
    target_name: String
) -> Int {
    if target_name == "" || !intents.ok ||
        ArrayLength(intents.names) !=
            SemanticAstIntentSignatureCount(intents) {
        return 0 - 1;
    }
    let found: Int = 0;
    let matches: Int = 0;
    let signature: Int = 0;
    while signature < SemanticAstFunctionSignatureCount(signatures) {
        let owner: Option<String> = SemanticAstFunctionOwnerNameAt(
            signatures, signature);
        let name: Option<String> = SemanticAstFunctionNameAt(
            signatures, signature);
        let node: Option<Int> = SemanticAstFunctionNodeAt(
            signatures, signature);
        if !IsSome(owner) || !IsSome(name) || !IsSome(node) {
            return 0 - 1;
        }
        if SemanticCallableCanonicalDeclaredNameEquals(
                UnwrapOption(owner), UnwrapOption(name), target_name) {
            matches = matches + 1;
            found = UnwrapOption(node);
            if matches > 1 || found <= 0 { return 0 - 1; }
        }
        signature = signature + 1;
    }
    let intent_index: Int = 0;
    while intent_index < SemanticAstIntentSignatureCount(intents) {
        if intents.names[intent_index] == "" ||
            intents.intent_node_ids[intent_index] <= 0 {
            return 0 - 1;
        }
        if intents.names[intent_index] == target_name {
            matches = matches + 1;
            found = intents.intent_node_ids[intent_index];
            if matches > 1 { return 0 - 1; }
        }
        intent_index = intent_index + 1;
    }
    if matches == 0 { return 0; }
    return found;
}

func SemanticExpressionDeclaredCallableTargetExists(
    signatures: SemanticAstFunctionSignatureFacts,
    intents: SemanticAstIntentSignatureFacts,
    target_name: String
) -> Bool {
    return SemanticExpressionDeclaredCallableSyntaxId(
        signatures, intents, target_name) > 0;
}

func SemanticExpressionDeclaredCallableCarriedIdentityReady(
    signatures: SemanticAstFunctionSignatureFacts,
    intents: SemanticAstIntentSignatureFacts,
    target_name: String, target_node_id: Int
) -> Bool {
    return target_node_id > 0 &&
        SemanticExpressionDeclaredCallableSyntaxId(
            signatures, intents, target_name) == target_node_id;
}
