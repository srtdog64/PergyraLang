// Semantic expression environment derived from artifact-owned scope facts.
//
// Initializer and assignment verdict owners share this construction. Neither
// owner may rescan source text to recover parameters, locals, or visibility.

import "../hir/ast_text_arena_projection_owner.pgy";
import "ast_signature_fact_owner.pgy";
import "ast_nominal_constructor_fact_owner.pgy";
import "ast_enum_fact_owner.pgy";
import "ast_local_binding_fact_owner.pgy";
import "builtin_signature_owner.pgy";

func SemanticAstExpressionMemberRootNames(
    constructors: SemanticAstNominalConstructorFacts,
    enums: SemanticAstEnumFacts,
    inout roots: Array<String>
) -> Bool {
    if !SemanticAstNominalConstructorRowsReady(constructors) || !enums.ok {
        return false;
    }
    let i: Int = 0;
    while i < SemanticAstNominalConstructorCount(constructors) {
        let name: Option<String> = SemanticAstNominalConstructorNameAt(
            constructors, i
        );
        if !IsSome(name) { return false; }
        ArrayPush(roots, UnwrapOption(name));
        i = i + 1;
    }
    i = 0;
    while i < SemanticAstEnumCount(enums) {
        let enum_name: Option<String> = SemanticAstEnumNameAt(enums, i);
        if !IsSome(enum_name) { return false; }
        ArrayPush(roots, UnwrapOption(enum_name));
        i = i + 1;
    }
    return true;
}

func SemanticAstExpressionFunctionRowIndex(
    names: Array<String>,
    name: String
) -> Int {
    let i: Int = 0;
    while i < ArrayLength(names) {
        if names[i] == name {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

func SemanticAstExpressionScopeVisible(
    arena: AstArena,
    scope_node_id: Int,
    use_node_id: Int
) -> Bool {
    let cursor: Option<Int> = Some(use_node_id);
    let traversed: Int = 0;
    while IsSome(cursor) && traversed < TypedAstArenaNodeCount(arena) {
        let node_id: Int = UnwrapOption(cursor);
        if node_id == scope_node_id {
            return true;
        }
        cursor = TypedAstArenaParentId(arena, node_id);
        traversed = traversed + 1;
    }
    return false;
}

func SemanticAstExpressionFunctionTables(
    signatures: SemanticAstFunctionSignatureFacts,
    constructors: SemanticAstNominalConstructorFacts,
    inout names: Array<String>,
    inout returns: Array<String>,
    inout params: Array<String>
) -> Bool {
    if !SeedSemanticBuiltinSignatures(names, returns, params) {
        return false;
    }
    if !SemanticAstNominalConstructorRowsReady(constructors) {
        return false;
    }
    let constructor_index: Int = 0;
    while constructor_index < SemanticAstNominalConstructorCount(constructors) {
        ArrayPush(names, constructors.names[constructor_index]);
        ArrayPush(returns, constructors.return_type_names[constructor_index]);
        let constructor_params: String = "";
        let param_index: Int = 0;
        while param_index < constructors.param_counts[constructor_index] {
            let param_type: Option<String> =
                SemanticAstNominalConstructorParamTypeAt(
                    constructors, constructor_index, param_index
                );
            if !IsSome(param_type) {
                return false;
            }
            if StringLength(constructor_params) > 0 {
                constructor_params = Concat(constructor_params, "|");
            }
            constructor_params = Concat(
                constructor_params, UnwrapOption(param_type)
            );
            param_index = param_index + 1;
        }
        ArrayPush(params, constructor_params);
        constructor_index = constructor_index + 1;
    }
    let i: Int = 0;
    while i < SemanticAstFunctionSignatureCount(signatures) {
        let name: Option<String> = SemanticAstFunctionNameAt(signatures, i);
        let return_type: Option<String> = SemanticAstFunctionReturnTypeAt(
            signatures, i
        );
        if !IsSome(name) || !IsSome(return_type) {
            return false;
        }
        let param_row: String = "";
        let param_count_opt: Option<Int> =
            SemanticAstFunctionParamCountAt(signatures, i);
        if !IsSome(param_count_opt) {
            return false;
        }
        let p: Int = 0;
        while p < UnwrapOption(param_count_opt) {
            let param_type: Option<String> =
                SemanticAstFunctionParamTypeAt(signatures, i, p);
            if !IsSome(param_type) {
                return false;
            }
            if StringLength(param_row) > 0 {
                param_row = Concat(param_row, "|");
            }
            param_row = Concat(param_row, UnwrapOption(param_type));
            p = p + 1;
        }
        let existing: Int = SemanticAstExpressionFunctionRowIndex(
            names, UnwrapOption(name)
        );
        if existing >= 0 {
            if returns[existing] != UnwrapOption(return_type) ||
                params[existing] != param_row {
                return false;
            }
        } else {
            ArrayPush(names, UnwrapOption(name));
            ArrayPush(returns, UnwrapOption(return_type));
            ArrayPush(params, param_row);
        }
        i = i + 1;
    }
    return true;
}

func SemanticAstExpressionSeedParameterModes(
    signatures: SemanticAstFunctionSignatureFacts,
    function_node_id: Int,
    inout modes: Array<String>
) -> Bool {
    let signature_index_opt: Option<Int> =
        SemanticAstFunctionSignatureIndexForNode(
            signatures, function_node_id
        );
    if !IsSome(signature_index_opt) {
        return false;
    }
    let signature_index: Int = UnwrapOption(signature_index_opt);
    let count_opt: Option<Int> = SemanticAstFunctionParamCountAt(
        signatures, signature_index
    );
    if !IsSome(count_opt) {
        return false;
    }
    let i: Int = 0;
    while i < UnwrapOption(count_opt) {
        let mode_opt: Option<Int> = SemanticAstFunctionParamModeAt(
            signatures, signature_index, i
        );
        if !IsSome(mode_opt) {
            return false;
        }
        let mode_name: String = "default_param";
        let mode: Int = UnwrapOption(mode_opt);
        if mode == 1 {
            mode_name = "inout_param";
        } else if mode == 2 {
            mode_name = "own_param";
        } else if mode == 3 {
            mode_name = "ref_param";
        }
        ArrayPush(modes, mode_name);
        i = i + 1;
    }
    return true;
}

func SemanticAstExpressionSeedParameters(
    signatures: SemanticAstFunctionSignatureFacts,
    function_node_id: Int,
    inout names: Array<String>,
    inout types: Array<String>
) -> Bool {
    let signature_index_opt: Option<Int> =
        SemanticAstFunctionSignatureIndexForNode(
            signatures, function_node_id
        );
    if !IsSome(signature_index_opt) {
        return false;
    }
    let signature_index: Int = UnwrapOption(signature_index_opt);
    let count_opt: Option<Int> = SemanticAstFunctionParamCountAt(
        signatures, signature_index
    );
    if !IsSome(count_opt) {
        return false;
    }
    let i: Int = 0;
    while i < UnwrapOption(count_opt) {
        let name: Option<String> = SemanticAstFunctionParamNameAt(
            signatures, signature_index, i
        );
        let type_name: Option<String> = SemanticAstFunctionParamTypeAt(
            signatures, signature_index, i
        );
        if !IsSome(name) || !IsSome(type_name) {
            return false;
        }
        ArrayPush(names, UnwrapOption(name));
        ArrayPush(types, UnwrapOption(type_name));
        i = i + 1;
    }
    return true;
}

func SemanticAstExpressionSeedVisibleLocals(
    artifact: AstTreeArtifact,
    locals: SemanticAstLocalBindingFacts,
    inferred_types: Array<String>,
    function_node_id: Int,
    use_node_id: Int,
    inout names: Array<String>,
    inout types: Array<String>
) -> Bool {
    let i: Int = 0;
    while i < SemanticAstLocalBindingCount(locals) {
        if locals.node_ids[i] < use_node_id &&
            locals.function_node_ids[i] == function_node_id &&
            SemanticAstExpressionScopeVisible(
                artifact.arena, locals.scope_node_ids[i], use_node_id
            ) {
            let type_name: String = "";
            let declared: Option<String> =
                SemanticAstLocalBindingDeclaredTypeAt(locals, i);
            if IsSome(declared) {
                type_name = UnwrapOption(declared);
            } else if i < ArrayLength(inferred_types) {
                type_name = inferred_types[i];
            }
            if type_name == "" || type_name == "Unknown" {
                return false;
            }
            ArrayPush(names, locals.names[i]);
            ArrayPush(types, type_name);
        }
        i = i + 1;
    }
    return true;
}

func SemanticAstExpressionSeedVisibleLocalModes(
    artifact: AstTreeArtifact,
    locals: SemanticAstLocalBindingFacts,
    function_node_id: Int,
    use_node_id: Int,
    inout modes: Array<String>
) -> Bool {
    let i: Int = 0;
    while i < SemanticAstLocalBindingCount(locals) {
        if locals.node_ids[i] < use_node_id &&
            locals.function_node_ids[i] == function_node_id &&
            SemanticAstExpressionScopeVisible(
                artifact.arena, locals.scope_node_ids[i], use_node_id
            ) {
            ArrayPush(modes, "local");
        }
        i = i + 1;
    }
    return true;
}

func SemanticAstExpressionEnvironmentContractReady() -> Bool {
    let artifact: AstTreeArtifact = AstTreeArtifactFromText(
        "Program:\n  Function: F\n    Parameters:\n      p: Int\n    Returns: Void\n    Body:\n      Block:\n        Let: x : Int = p\n        If: true\n          Then:\n            Block:\n              Let: y : Int = x\n              Assign: x = y\n"
    );
    let signatures: SemanticAstFunctionSignatureFacts =
        SemanticAstFunctionSignatureFactsFromArtifact(artifact);
    let constructors: SemanticAstNominalConstructorFacts =
        SemanticAstNominalConstructorFactsFromArtifact(artifact);
    let locals: SemanticAstLocalBindingFacts =
        SemanticAstLocalBindingFactsFromArtifact(artifact, signatures);
    let names: Array<String> = [];
    let types: Array<String> = [];
    let function_names: Array<String> = [];
    let function_returns: Array<String> = [];
    let function_params: Array<String> = [];
    let modes: Array<String> = [];
    let inferred: Array<String> = ["Int", "Int"];
    if !SemanticAstExpressionFunctionTables(
        signatures, constructors,
        function_names, function_returns, function_params
    ) || !SemanticAstExpressionSeedParameters(
        signatures, locals.function_node_ids[0], names, types
    ) || !SemanticAstExpressionSeedParameterModes(
        signatures, locals.function_node_ids[0], modes
    ) || !SemanticAstExpressionSeedVisibleLocals(
        artifact, locals, inferred, locals.function_node_ids[0],
        artifact.count - 1,
        names, types
    ) || !SemanticAstExpressionSeedVisibleLocalModes(
        artifact, locals, locals.function_node_ids[0], artifact.count - 1,
        modes
    ) {
        return false;
    }
    return ArrayLength(names) == 3 && names[0] == "p" &&
        names[1] == "x" && names[2] == "y" &&
        types[0] == "Int" && types[1] == "Int" && types[2] == "Int" &&
        ArrayLength(modes) == 3 && modes[0] == "default_param" &&
        modes[1] == "local" && modes[2] == "local" &&
        ArrayLength(function_names) == 84 &&
        function_names[83] == "F" && function_returns[83] == "Void" &&
        function_params[83] == "Int";
}
