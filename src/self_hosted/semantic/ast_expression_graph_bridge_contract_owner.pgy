// Executable contracts for the temporary compact-text expression bridge.

import "ast_expression_graph_build_owner.pgy";

func SemanticExpressionGraphCompactBridgeTryContractReady() -> Bool {
    let prefix_kinds: Array<Int> = [];
    let prefix_texts: Array<String> = [];
    let prefix_left: Array<Int> = [];
    let prefix_right: Array<Int> = [];
    let prefix_target_kinds: Array<Int> = [];
    let prefix_target_names: Array<String> = [];
    let prefix: SemanticExpressionGraphBuild =
        SemanticExpressionGraphBuildCompactBridgeFromText(
            prefix_kinds, prefix_texts, prefix_left, prefix_right,
            prefix_target_kinds, prefix_target_names, "(?Pick(x))"
        );
    if !prefix.ok ||
        prefix_kinds[prefix.root_id] != AstExpressionNodeTry() ||
        prefix_texts[prefix.root_id] != "?Pick(x)" {
        return false;
    }
    let prefix_operand: Int = prefix_left[prefix.root_id];
    if prefix_kinds[prefix_operand] !=
            AstExpressionNodeCallArgument() {
        return false;
    }
    let prefix_call: Int = prefix_left[prefix_operand];
    let prefix_argument: Int = prefix_right[prefix_operand];
    let prefix_callee: Int = prefix_left[prefix_call];
    if prefix_kinds[prefix_call] != AstExpressionNodeCall() ||
        prefix_texts[prefix_callee] != "Pick" ||
        prefix_texts[prefix_argument] != "x" {
        return false;
    }

    let postfix_kinds: Array<Int> = [];
    let postfix_texts: Array<String> = [];
    let postfix_left: Array<Int> = [];
    let postfix_right: Array<Int> = [];
    let postfix_target_kinds: Array<Int> = [];
    let postfix_target_names: Array<String> = [];
    let postfix: SemanticExpressionGraphBuild =
        SemanticExpressionGraphBuildCompactBridgeFromText(
            postfix_kinds, postfix_texts, postfix_left, postfix_right,
            postfix_target_kinds, postfix_target_names, "1 + value?"
        );
    if !postfix.ok ||
        postfix_kinds[postfix.root_id] != AstExpressionNodeAdd() {
        return false;
    }
    let postfix_try: Int = postfix_right[postfix.root_id];
    if postfix_kinds[postfix_try] != AstExpressionNodeTry() ||
        postfix_texts[postfix_try] != "?value" {
        return false;
    }
    let postfix_operand: Int = postfix_left[postfix_try];
    return postfix_kinds[postfix_operand] ==
            AstExpressionNodeLeaf() &&
        postfix_texts[postfix_operand] == "value";
}

func SemanticExpressionGraphParserBridgeContractReady() -> Bool {
    let nested_kinds: Array<Int> = [];
    let nested_texts: Array<String> = [];
    let nested_left: Array<Int> = [];
    let nested_right: Array<Int> = [];
    let nested_target_kinds: Array<Int> = [];
    let nested_target_names: Array<String> = [];
    let nested: SemanticExpressionGraphBuild =
        SemanticExpressionGraphBuildCompactBridgeFromText(
            nested_kinds, nested_texts, nested_left, nested_right,
            nested_target_kinds, nested_target_names,
            "line.end.LengthPlus(2)"
        );
    if !nested.ok || nested_kinds[nested.root_id] !=
            AstExpressionNodeCallArgument() {
        return false;
    }
    let call: Int = nested_left[nested.root_id];
    if nested_kinds[call] != AstExpressionNodeCall() {
        return false;
    }
    let method: Int = nested_left[call];
    if nested_kinds[method] !=
            AstExpressionNodeMemberAccess() {
        return false;
    }
    let receiver: Int = nested_left[method];
    return nested_kinds[receiver] ==
            AstExpressionNodeMemberAccess() &&
        nested_texts[receiver] == "line.end";
}
