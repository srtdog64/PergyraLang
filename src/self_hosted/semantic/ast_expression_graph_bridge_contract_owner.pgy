// Executable contracts for the temporary compact-text expression bridge.

import "ast_expression_graph_fact_owner.pgy";

func SemanticExpressionGraphCompactBridgeTryContractReady() -> Bool {
    let prefix: SemanticExpressionGraphBuild =
        SemanticExpressionGraphBuildCompactBridgeFromText(
            SemanticExpressionGraphArenaEmpty(), "(?Pick(x))"
        );
    if !prefix.ok ||
        prefix.arena.node_kinds[prefix.root_id] != AstExpressionNodeTry() ||
        prefix.arena.node_texts[prefix.root_id] != "?Pick(x)" {
        return false;
    }
    let prefix_operand: Int = prefix.arena.left_children[prefix.root_id];
    if prefix.arena.node_kinds[prefix_operand] !=
            AstExpressionNodeCallArgument() {
        return false;
    }
    let prefix_call: Int = prefix.arena.left_children[prefix_operand];
    let prefix_argument: Int = prefix.arena.right_children[prefix_operand];
    let prefix_callee: Int = prefix.arena.left_children[prefix_call];
    if prefix.arena.node_kinds[prefix_call] != AstExpressionNodeCall() ||
        prefix.arena.node_texts[prefix_callee] != "Pick" ||
        prefix.arena.node_texts[prefix_argument] != "x" {
        return false;
    }

    let postfix: SemanticExpressionGraphBuild =
        SemanticExpressionGraphBuildCompactBridgeFromText(
            SemanticExpressionGraphArenaEmpty(), "1 + value?"
        );
    if !postfix.ok ||
        postfix.arena.node_kinds[postfix.root_id] != AstExpressionNodeAdd() {
        return false;
    }
    let postfix_try: Int = postfix.arena.right_children[postfix.root_id];
    if postfix.arena.node_kinds[postfix_try] != AstExpressionNodeTry() ||
        postfix.arena.node_texts[postfix_try] != "?value" {
        return false;
    }
    let postfix_operand: Int = postfix.arena.left_children[postfix_try];
    return postfix.arena.node_kinds[postfix_operand] ==
            AstExpressionNodeLeaf() &&
        postfix.arena.node_texts[postfix_operand] == "value";
}

func SemanticExpressionGraphParserBridgeContractReady() -> Bool {
    let nested: SemanticExpressionGraphBuild =
        SemanticExpressionGraphBuildCompactBridgeFromText(
            SemanticExpressionGraphArenaEmpty(),
            "line.end.LengthPlus(2)"
        );
    if !nested.ok || nested.arena.node_kinds[nested.root_id] !=
            AstExpressionNodeCallArgument() {
        return false;
    }
    let call: Int = nested.arena.left_children[nested.root_id];
    if nested.arena.node_kinds[call] != AstExpressionNodeCall() {
        return false;
    }
    let method: Int = nested.arena.left_children[call];
    if nested.arena.node_kinds[method] !=
            AstExpressionNodeMemberAccess() {
        return false;
    }
    let receiver: Int = nested.arena.left_children[method];
    return nested.arena.node_kinds[receiver] ==
            AstExpressionNodeMemberAccess() &&
        nested.arena.node_texts[receiver] == "line.end";
}
