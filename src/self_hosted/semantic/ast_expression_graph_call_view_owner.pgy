// Ordered call-spine view over parser-owned semantic expression graphs.
import "ast_expression_graph_fact_owner.pgy";
import "ast_expression_graph_node_view_owner.pgy";

struct SemanticCallSpineView {
    ok: Bool;
    call_node: Int;
    callee_node: Int;
    argument_nodes: Array<Int>;
    generic_actual_type_names: Array<String>;
}

func SemanticCallSpineViewFromGraph(
    ref graph: SemanticExpressionGraphFacts,
    root_id: Int
) -> SemanticCallSpineView {
    let reversed: Array<Int> = [];
    let no_actuals: Array<String> = [];
    let node: Int = root_id;
    let kind: Option<Int> = SemanticExpressionGraphNodeKind(graph, node);
    while IsSome(kind) &&
        UnwrapOption(kind) == AstExpressionNodeCallArgument() {
        let argument: Option<Int> = SemanticExpressionGraphRightChild(
            graph, node
        );
        let previous: Option<Int> = SemanticExpressionGraphLeftChild(
            graph, node
        );
        if !IsSome(argument) || !IsSome(previous) {
            return SemanticCallSpineView(
                false, 0, 0, reversed, no_actuals
            );
        }
        ArrayPush(reversed, UnwrapOption(argument));
        node = UnwrapOption(previous);
        kind = SemanticExpressionGraphNodeKind(graph, node);
    }
    if !IsSome(kind) || UnwrapOption(kind) != AstExpressionNodeCall() {
        return SemanticCallSpineView(false, 0, 0, reversed, no_actuals);
    }
    let callee: Option<Int> = SemanticExpressionGraphLeftChild(graph, node);
    if !IsSome(callee) {
        return SemanticCallSpineView(false, 0, 0, reversed, no_actuals);
    }
    let base_callee: Int = UnwrapOption(callee);
    let reversed_actuals: Array<String> = [];
    let callee_kind: Option<Int> = SemanticExpressionGraphNodeKind(
        graph, base_callee
    );
    while IsSome(callee_kind) &&
        UnwrapOption(callee_kind) == AstExpressionNodeGenericCallee() {
        let previous_callee: Option<Int> = SemanticExpressionGraphLeftChild(
            graph, base_callee
        );
        let actual_node: Option<Int> = SemanticExpressionGraphRightChild(
            graph, base_callee
        );
        if !IsSome(previous_callee) || !IsSome(actual_node) {
            return SemanticCallSpineView(
                false, 0, 0, reversed, no_actuals
            );
        }
        let actual_kind: Option<Int> = SemanticExpressionGraphNodeKind(
            graph, UnwrapOption(actual_node)
        );
        let actual_name: Option<String> = SemanticExpressionGraphNodeText(
            graph, UnwrapOption(actual_node)
        );
        if !IsSome(actual_kind) || UnwrapOption(actual_kind) !=
                AstExpressionNodeGenericTypeActual() ||
            !IsSome(actual_name) || UnwrapOption(actual_name) == "" {
            return SemanticCallSpineView(
                false, 0, 0, reversed, no_actuals
            );
        }
        ArrayPush(reversed_actuals, UnwrapOption(actual_name));
        base_callee = UnwrapOption(previous_callee);
        callee_kind = SemanticExpressionGraphNodeKind(graph, base_callee);
    }
    if !IsSome(callee_kind) ||
        !AstExpressionNodeIsCallableCallee(UnwrapOption(callee_kind)) ||
        UnwrapOption(callee_kind) == AstExpressionNodeGenericCallee() {
        return SemanticCallSpineView(false, 0, 0, reversed, no_actuals);
    }
    let arguments: Array<Int> = [];
    let i: Int = ArrayLength(reversed) - 1;
    while i >= 0 {
        ArrayPush(arguments, reversed[i]);
        i = i - 1;
    }
    let actuals: Array<String> = [];
    i = ArrayLength(reversed_actuals) - 1;
    while i >= 0 {
        ArrayPush(actuals, reversed_actuals[i]);
        i = i - 1;
    }
    return SemanticCallSpineView(
        true, node, base_callee, arguments, actuals
    );
}
