// Capability and diagnostics for concrete scalar graph trees.

import "ast_expression_graph_resolved_call_type_owner.pgy";
import "ast_expression_graph_scalar_type_owner.pgy";
import "ast_expression_graph_scalar_verdict_owner.pgy";
import "delimited_range_fact_owner.pgy";
import "diagnostic_owner.pgy";
import "expr_type_owner.pgy";
import "ast_expression_graph_node_view_owner.pgy";
import "ast_signature_type_expression_fact_owner.pgy";
import "ast_contextual_builtin_type_owner.pgy";

func SemanticExpressionGraphConcreteScalarValueOwned(
    ref graph: SemanticExpressionGraphFacts,
    node_id: Int,
    ref constructors: SemanticAstNominalConstructorFacts,
    names: Array<String>,
    types: Array<String>,
    function_names: Array<String>,
    function_returns: Array<String>,
    function_params: Array<String>
) -> Bool {
    let kind_opt: Option<Int> = SemanticExpressionGraphNodeKind(
        graph, node_id
    );
    if !IsSome(kind_opt) { return false; }
    let kind: Int = UnwrapOption(kind_opt);
    if AstExpressionNodeIsScalarLeaf(kind) { return true; }
    if kind == AstExpressionNodeCast() {
        let operand: Option<Int> = SemanticExpressionGraphLeftChild(
            graph, node_id
        );
        return IsSome(operand) &&
            IsSome(SemanticExpressionGraphCastTargetTypeName(
                graph, node_id
            )) && SemanticExpressionGraphConcreteScalarValueOwned(
                graph, UnwrapOption(operand), constructors, names, types,
                function_names, function_returns, function_params
            );
    }
    if kind == AstExpressionNodeMemberAccess() {
        return IsSome(SemanticExpressionGraphValueReceiverTypeName(
            graph, node_id, constructors, names, types,
            function_names, function_returns
        ));
    }
    if kind == AstExpressionNodeCoalesce() {
        let coalesce_left: Option<Int> = SemanticExpressionGraphLeftChild(
            graph, node_id
        );
        let coalesce_right: Option<Int> = SemanticExpressionGraphRightChild(
            graph, node_id
        );
        if !IsSome(coalesce_left) || !IsSome(coalesce_right) {
            return false;
        }
        let wrapped_type: String = SemanticExpressionGraphScalarTypeName(
            graph, UnwrapOption(coalesce_left), constructors, names, types,
            function_names, function_returns
        );
        let fallback_type: String = SemanticExpressionGraphScalarTypeName(
            graph, UnwrapOption(coalesce_right), constructors, names, types,
            function_names, function_returns
        );
        return IsSome(OptionCoalescePayloadTypeOpt(
            wrapped_type, fallback_type
        ));
    }
    if SemanticExpressionGraphScalarOperatorKind(kind) {
        let left: Option<Int> = SemanticExpressionGraphLeftChild(
            graph, node_id
        );
        if !IsSome(left) ||
            !SemanticExpressionGraphConcreteScalarValueOwned(
                graph, UnwrapOption(left), constructors, names, types, function_names,
                function_returns, function_params
            ) {
            return false;
        }
        if AstExpressionNodeArity(kind) == 1 { return true; }
        let right: Option<Int> = SemanticExpressionGraphRightChild(
            graph, node_id
        );
        return IsSome(right) &&
            SemanticExpressionGraphConcreteScalarValueOwned(
                graph, UnwrapOption(right), constructors, names, types, function_names,
                function_returns, function_params
            );
    }
    if ArrayLength(function_names) != ArrayLength(function_params) {
        return false;
    }
    let call: SemanticCallSpineView = SemanticCallSpineViewFromGraph(
        graph, node_id
    );
    if !call.ok { return false; }
    let target_fact: SemanticExpressionCallTargetFact =
        SemanticExpressionGraphResolvedCallTarget(
            graph, node_id, constructors, names, types,
            function_names, function_returns
        );
    if !target_fact.ok { return false; }
    let local_callable: SemanticAstCallableTypeShape =
        SemanticAstCallableTypeShapeFromName(
            EnvLookup(names, types, target_fact.name)
        );
    let signature: String = "";
    if local_callable.ok {
        signature = SemanticAstCallableTypeParameterSignature(
            local_callable
        );
    } else {
        let target: Option<Int> = SemanticCallableIndex(
            function_names, target_fact.name
        );
        if !IsSome(target) { return false; }
        signature = function_params[UnwrapOption(target)];
    }
    let signature_facts: SemanticDelimitedRangeFacts =
        SemanticSignatureRangeFactsFromSource(signature);
    let signature_count: Int = 0;
    if signature != "" {
        signature_count = SemanticDelimitedRangeCount(signature_facts);
    }
    if signature_count < target_fact.parameter_offset { return false; }
    let expected_count: Int = signature_count - target_fact.parameter_offset;
    if expected_count != ArrayLength(call.argument_nodes) {
        return true;
    }
    if !IsSome(SemanticExpressionGraphResolvedCallConcreteScalarTypeName(
        graph, node_id, constructors, names, types,
        function_names, function_returns
    )) {
        return false;
    }
    let i: Int = target_fact.parameter_offset;
    while i < signature_count {
        let expected: String = SemanticDelimitedRangeText(
            signature_facts, signature, i
        );
        if expected != "Unknown" &&
            !SemanticResolvedCallConcreteScalarType(expected) {
            return false;
        }
        i = i + 1;
    }
    i = 0;
    while i < ArrayLength(call.argument_nodes) {
        if !SemanticExpressionGraphConcreteScalarValueOwned(
            graph, call.argument_nodes[i], constructors, names, types, function_names,
            function_returns, function_params
        ) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func SemanticExpressionGraphContextualCallArgumentsOwned(
    ref graph: SemanticExpressionGraphFacts,
    node_id: Int,
    ref constructors: SemanticAstNominalConstructorFacts,
    names: Array<String>,
    types: Array<String>,
    function_names: Array<String>,
    function_returns: Array<String>,
    function_params: Array<String>
) -> Bool {
    if ArrayLength(function_names) != ArrayLength(function_params) {
        return false;
    }
    let call: SemanticCallSpineView = SemanticCallSpineViewFromGraph(
        graph, node_id
    );
    if !call.ok { return false; }
    let target_fact: SemanticExpressionCallTargetFact =
        SemanticExpressionGraphResolvedCallTarget(
            graph, node_id, constructors, names, types,
            function_names, function_returns
        );
    if !target_fact.ok { return false; }
    let local_callable: SemanticAstCallableTypeShape =
        SemanticAstCallableTypeShapeFromName(
            EnvLookup(names, types, target_fact.name)
        );
    let signature: String = "";
    if local_callable.ok {
        signature = SemanticAstCallableTypeParameterSignature(
            local_callable
        );
    } else {
        let target: Option<Int> = SemanticCallableIndex(
            function_names, target_fact.name
        );
        if !IsSome(target) { return false; }
        signature = function_params[UnwrapOption(target)];
    }
    let signature_facts: SemanticDelimitedRangeFacts =
        SemanticSignatureRangeFactsFromSource(signature);
    let signature_count: Int = 0;
    if signature != "" {
        signature_count = SemanticDelimitedRangeCount(signature_facts);
    }
    if signature_count < target_fact.parameter_offset ||
        signature_count - target_fact.parameter_offset !=
        ArrayLength(call.argument_nodes) {
        return false;
    }
    let has_contextual_argument: Bool = false;
    let i: Int = 0;
    while i < ArrayLength(call.argument_nodes) {
        let expected: Option<String> = Some(
            SemanticDelimitedRangeText(
                signature_facts, signature,
                i + target_fact.parameter_offset
            )
        );
        let contextual: Option<String> =
            SemanticContextualBuiltinReturnTypeFromGraph(
                graph, call.argument_nodes[i], expected
            );
        if IsSome(contextual) {
            has_contextual_argument = true;
        } else if !SemanticExpressionGraphConcreteScalarValueOwned(
            graph, call.argument_nodes[i], constructors, names, types,
            function_names, function_returns, function_params
        ) {
            return false;
        }
        i = i + 1;
    }
    return has_contextual_argument;
}

struct SemanticExpressionGraphResolvedCallArgumentFacts {
    call: SemanticCallSpineView;
    target: SemanticExpressionCallTargetFact;
    signature_found: Bool;
    signature: String;
    signature_ranges: SemanticDelimitedRangeFacts;
    signature_count: Int;
}

func SemanticExpressionGraphResolvedCallArgumentFactsFromGraph(
    ref graph: SemanticExpressionGraphFacts,
    node_id: Int,
    ref constructors: SemanticAstNominalConstructorFacts,
    names: Array<String>,
    types: Array<String>,
    function_names: Array<String>,
    function_returns: Array<String>,
    function_params: Array<String>
) -> SemanticExpressionGraphResolvedCallArgumentFacts {
    let call: SemanticCallSpineView = SemanticCallSpineViewFromGraph(
        graph, node_id
    );
    let empty_target: SemanticExpressionCallTargetFact =
        SemanticExpressionCallTargetFact(
            false, SemanticCallTargetNone(), "", 0
        );
    let empty_starts: Array<Int> = [];
    let empty_lengths: Array<Int> = [];
    let empty_ranges: SemanticDelimitedRangeFacts =
        SemanticDelimitedRangeFacts(0, empty_starts, empty_lengths);
    if !call.ok ||
        ArrayLength(function_names) != ArrayLength(function_params) {
        return SemanticExpressionGraphResolvedCallArgumentFacts(
            call, empty_target, false, "", empty_ranges, 0
        );
    }
    let target_fact: SemanticExpressionCallTargetFact =
        SemanticExpressionGraphResolvedCallTarget(
            graph, node_id, constructors, names, types,
            function_names, function_returns
        );
    if !target_fact.ok {
        return SemanticExpressionGraphResolvedCallArgumentFacts(
            call, target_fact, false, "", empty_ranges, 0
        );
    }
    let local_callable: SemanticAstCallableTypeShape =
        SemanticAstCallableTypeShapeFromName(
            EnvLookup(names, types, target_fact.name)
        );
    let signature: String = "";
    if local_callable.ok {
        signature = SemanticAstCallableTypeParameterSignature(
            local_callable
        );
    } else {
        let target: Option<Int> = SemanticCallableIndex(
            function_names, target_fact.name
        );
        if !IsSome(target) {
            return SemanticExpressionGraphResolvedCallArgumentFacts(
                call, target_fact, false, "", empty_ranges, 0
            );
        }
        signature = function_params[UnwrapOption(target)];
    }
    let signature_facts: SemanticDelimitedRangeFacts =
        SemanticSignatureRangeFactsFromSource(signature);
    let signature_count: Int = 0;
    if signature != "" {
        signature_count = SemanticDelimitedRangeCount(signature_facts);
    }
    return SemanticExpressionGraphResolvedCallArgumentFacts(
        call, target_fact, true, signature, signature_facts, signature_count
    );
}

func SemanticExpressionGraphResolvedMemberCallArgumentsOwned(
    ref graph: SemanticExpressionGraphFacts,
    node_id: Int,
    ref constructors: SemanticAstNominalConstructorFacts,
    names: Array<String>,
    types: Array<String>,
    function_names: Array<String>,
    function_returns: Array<String>,
    function_params: Array<String>
) -> Bool {
    let facts: SemanticExpressionGraphResolvedCallArgumentFacts =
        SemanticExpressionGraphResolvedCallArgumentFactsFromGraph(
            graph, node_id, constructors, names, types,
            function_names, function_returns, function_params
        );
    if !facts.target.ok || !facts.signature_found ||
        facts.target.kind != SemanticCallTargetMember() ||
        facts.signature_count < facts.target.parameter_offset ||
        facts.signature_count - facts.target.parameter_offset !=
            ArrayLength(facts.call.argument_nodes) {
        return false;
    }
    let i: Int = 0;
    while i < ArrayLength(facts.call.argument_nodes) {
        if !SemanticExpressionGraphConcreteScalarValueOwned(
            graph, facts.call.argument_nodes[i], constructors, names, types,
            function_names, function_returns, function_params
        ) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func SemanticExpressionGraphConcreteScalarValueError(
    ref graph: SemanticExpressionGraphFacts,
    node_id: Int,
    ref constructors: SemanticAstNominalConstructorFacts,
    names: Array<String>,
    types: Array<String>,
    function_names: Array<String>,
    function_returns: Array<String>,
    function_params: Array<String>
) -> String {
    let kind_opt: Option<Int> = SemanticExpressionGraphNodeKind(
        graph, node_id
    );
    if !IsSome(kind_opt) {
        return SemanticError1(
            "ast_artifact_invalid", "owner", "expression_graph"
        );
    }
    let kind: Int = UnwrapOption(kind_opt);
    if AstExpressionNodeIsScalarLeaf(kind) { return ""; }
    if kind == AstExpressionNodeCast() {
        let operand: Option<Int> = SemanticExpressionGraphLeftChild(
            graph, node_id
        );
        let target: Option<String> =
            SemanticExpressionGraphCastTargetTypeName(graph, node_id);
        if !IsSome(operand) || !IsSome(target) {
            return SemanticError1(
                "ast_artifact_invalid", "owner", "expression_graph"
            );
        }
        let operand_error: String =
            SemanticExpressionGraphConcreteScalarValueError(
                graph, UnwrapOption(operand), constructors, names, types,
                function_names, function_returns, function_params
            );
        if StringLength(operand_error) > 0 { return operand_error; }
        let target_name: String = UnwrapOption(target);
        if !SemanticExpressionGraphNumericTypeName(target_name) {
            return SemanticError3(
                "builtin_arg_type_mismatch", "func", "as",
                "expected", "Int|Long|Float", "actual", target_name
            );
        }
        let source_name: String = SemanticExpressionGraphScalarTypeName(
            graph, UnwrapOption(operand), constructors, names, types,
            function_names, function_returns
        );
        if source_name != "Unknown" &&
            !SemanticExpressionGraphNumericTypeName(source_name) {
            return SemanticError3(
                "builtin_arg_type_mismatch", "func", "as",
                "expected", "numeric", "actual", source_name
            );
        }
        return "";
    }
    if kind == AstExpressionNodeMemberAccess() {
        if IsSome(SemanticExpressionGraphValueReceiverTypeName(
            graph, node_id, constructors, names, types,
            function_names, function_returns
        )) { return ""; }
        return SemanticError1(
            "ast_artifact_invalid", "owner", "member_type"
        );
    }
    if SemanticExpressionGraphScalarOperatorKind(kind) {
        let left: Option<Int> = SemanticExpressionGraphLeftChild(
            graph, node_id
        );
        if !IsSome(left) {
            return SemanticError1(
                "ast_artifact_invalid", "owner", "expression_graph"
            );
        }
        let child_error: String =
            SemanticExpressionGraphConcreteScalarValueError(
                graph, UnwrapOption(left), constructors, names, types,
                function_names, function_returns, function_params
            );
        if StringLength(child_error) > 0 { return child_error; }
        if AstExpressionNodeArity(kind) == 2 {
            let right: Option<Int> = SemanticExpressionGraphRightChild(
                graph, node_id
            );
            if !IsSome(right) {
                return SemanticError1(
                    "ast_artifact_invalid", "owner", "expression_graph"
                );
            }
            let right_error: String =
                SemanticExpressionGraphConcreteScalarValueError(
                    graph, UnwrapOption(right), constructors, names, types,
                    function_names, function_returns, function_params
                );
            if StringLength(right_error) > 0 { return right_error; }
        }
        return SemanticExpressionGraphScalarOperatorError(
            graph, node_id, constructors, names, types,
            function_names, function_returns
        );
    }
    let argument_facts: SemanticExpressionGraphResolvedCallArgumentFacts =
        SemanticExpressionGraphResolvedCallArgumentFactsFromGraph(
            graph, node_id, constructors, names, types,
            function_names, function_returns, function_params
        );
    let call: SemanticCallSpineView = argument_facts.call;
    if !call.ok {
        return SemanticError1(
            "ast_artifact_invalid", "owner", "expression_graph"
        );
    }
    let callee_text: Option<String> = SemanticExpressionGraphNodeText(
        graph, call.callee_node
    );
    if !IsSome(callee_text) {
        return SemanticError1(
            "ast_artifact_invalid", "owner", "expression_graph"
        );
    }
    let callee: String = UnwrapOption(callee_text);
    let target_fact: SemanticExpressionCallTargetFact = argument_facts.target;
    if !target_fact.ok {
        return SemanticError1(
            "ast_artifact_invalid", "owner", "call_target"
        );
    }
    if !argument_facts.signature_found {
        return SemanticError1("undefined_function", "func", callee);
    }
    let signature: String = argument_facts.signature;
    let signature_facts: SemanticDelimitedRangeFacts =
        argument_facts.signature_ranges;
    let signature_count: Int = argument_facts.signature_count;
    if signature_count < target_fact.parameter_offset {
        return SemanticError1(
            "ast_artifact_invalid", "owner", "call_signature"
        );
    }
    let expected_count: Int = signature_count - target_fact.parameter_offset;
    let actual_count: Int = ArrayLength(call.argument_nodes);
    if expected_count != actual_count {
        return SemanticError3(
            "call_arity_mismatch", "func", callee,
            "expected", ToString(expected_count),
            "actual", ToString(actual_count)
        );
    }
    let i: Int = 0;
    while i < actual_count {
        let expected: String = SemanticDelimitedRangeText(
            signature_facts, signature, i + target_fact.parameter_offset
        );
        let argument: Int = call.argument_nodes[i];
        let argument_error: String =
            SemanticExpressionGraphConcreteScalarValueError(
                graph, argument, constructors, names, types,
                function_names, function_returns, function_params
            );
        if StringLength(argument_error) > 0 { return argument_error; }
        let actual: String = SemanticExpressionGraphScalarTypeName(
            graph, argument, constructors, names, types,
            function_names, function_returns
        );
        let expected_type: Option<String> = Some(expected);
        actual = SemanticContextualBuiltinExpectedTypeFromGraph(
            graph, argument, expected_type, true, actual
        );
        let argument_text: Option<String> =
            SemanticExpressionGraphNodeText(graph, argument);
        let assignable: Bool = expected == actual;
        if IsSome(argument_text) {
            assignable = ExpressionAssignableTo(
                expected, actual, UnwrapOption(argument_text)
            );
        }
        if expected != "Unknown" && actual != "Unknown" && !assignable {
            let diagnostic_code: String = "call_arg_type_mismatch";
            if target_fact.kind == SemanticCallTargetMember() {
                diagnostic_code = "member_call_arg_type_mismatch";
            }
            return SemanticError3(
                diagnostic_code, "func", callee,
                "expected", expected, "actual", actual
            );
        }
        i = i + 1;
    }
    return "";
}
