// Normalized semantic expression graph rows.
//
// Consumers use stable node handles and child edges. The current producer
// still lowers the compact parser payload into these rows; parser-owned arena
// production can replace that bridge without changing semantic/codegen views.

import "expression_normalization_owner.pgy";
import "expression_operator_fact_owner.pgy";
import "try_expression_fact_owner.pgy";
import "../hir/ast_expression_graph_owner.pgy";
import "../parser/expr_owner.pgy";

struct SemanticExpressionGraphArena {
    node_kinds: Array<Int>;
    node_texts: Array<String>;
    left_children: Array<Int>;
    right_children: Array<Int>;
    // Empty means no semantic target; otherwise this is the canonical callable.
    call_target_names: Array<String>;
}

struct SemanticExpressionGraphFacts {
    ok: Bool;
    roots: Array<Int>;
    has_roots: Array<Bool>;
    arena: SemanticExpressionGraphArena;
}

struct SemanticExpressionGraphBuild {
    ok: Bool;
    root_id: Int;
    arena: SemanticExpressionGraphArena;
}

struct SemanticExpressionGraphView {
    ok: Bool;
    root_id: Int;
    graph: SemanticExpressionGraphFacts;
}

func SemanticExpressionGraphArenaEmpty() -> SemanticExpressionGraphArena {
    let node_kinds: Array<Int> = [];
    let node_texts: Array<String> = [];
    let left_children: Array<Int> = [];
    let right_children: Array<Int> = [];
    let call_target_names: Array<String> = [];
    return SemanticExpressionGraphArena(
        node_kinds, node_texts, left_children, right_children,
        call_target_names
    );
}

func SemanticCallTargetNone() -> Int { return 0; }
func SemanticCallTargetNamespace() -> Int { return 1; }

func SemanticExpressionGraphFactsEmpty() -> SemanticExpressionGraphFacts {
    let roots: Array<Int> = [];
    let has_roots: Array<Bool> = [];
    return SemanticExpressionGraphFacts(
        true, roots, has_roots, SemanticExpressionGraphArenaEmpty()
    );
}

func SemanticExpressionGraphFactsFromAstRows(
    rows: AstExpressionGraphRows,
    root_slots: Array<Int>,
    expected_root_count: Int
) -> SemanticExpressionGraphFacts {
    let roots: Array<Int> = [];
    let has_roots: Array<Bool> = [];
    let kinds: Array<Int> = [];
    let texts: Array<String> = [];
    let left_children: Array<Int> = [];
    let right_children: Array<Int> = [];
    let call_target_names: Array<String> = [];
    let ok: Bool = expected_root_count >= 0 &&
        AstExpressionGraphRowsReady(rows) &&
        ArrayLength(root_slots) == ArrayLength(rows.roots);
    let i: Int = 0;
    while i < expected_root_count {
        ArrayPush(roots, 0);
        ArrayPush(has_roots, false);
        i = i + 1;
    }
    i = 0;
    while i < AstExpressionArenaNodeCount(rows.arena) {
        ArrayPush(kinds, rows.arena.node_kinds[i]);
        ArrayPush(texts, SemanticStripOuterParens(rows.arena.node_texts[i]));
        ArrayPush(left_children, rows.arena.left_children[i]);
        ArrayPush(right_children, rows.arena.right_children[i]);
        ArrayPush(call_target_names, "");
        i = i + 1;
    }
    i = 0;
    while i < ArrayLength(root_slots) && ok {
        let slot: Int = root_slots[i];
        if slot < 0 || slot >= expected_root_count || has_roots[slot] {
            ok = false;
        } else {
            ArraySet(roots, slot, rows.roots[i]);
            ArraySet(has_roots, slot, true);
        }
        i = i + 1;
    }
    let arena: SemanticExpressionGraphArena = SemanticExpressionGraphArena(
        kinds, texts, left_children, right_children,
        call_target_names
    );
    let facts: SemanticExpressionGraphFacts = SemanticExpressionGraphFacts(
        ok, roots, has_roots, arena
    );
    return SemanticExpressionGraphFacts(
        SemanticExpressionGraphFactsReady(facts, expected_root_count),
        roots, has_roots, arena
    );
}

func SemanticExpressionGraphArenaNodeCount(
    ref arena: SemanticExpressionGraphArena
) -> Int {
    return ArrayLength(arena.node_kinds);
}

func SemanticExpressionGraphArenaReady(
    ref arena: SemanticExpressionGraphArena
) -> Bool {
    let count: Int = SemanticExpressionGraphArenaNodeCount(arena);
    if ArrayLength(arena.node_texts) != count ||
        ArrayLength(arena.left_children) != count ||
        ArrayLength(arena.right_children) != count ||
        ArrayLength(arena.call_target_names) != count {
        return false;
    }
    let i: Int = 0;
    while i < count {
        let kind: Int = arena.node_kinds[i];
        let left: Int = arena.left_children[i];
        let right: Int = arena.right_children[i];
        if arena.node_texts[i] == "" ||
            !AstExpressionNodeKindKnown(kind) {
            return false;
        }
        let call_target_name: String = arena.call_target_names[i];
        if call_target_name != "" && kind != AstExpressionNodeCall() {
            return false;
        }
        let arity: Int = AstExpressionNodeArity(kind);
        if arity == 0 {
            if left != 0 || right != 0 { return false; }
        } else if left < 0 || left >= i {
            return false;
        } else if arity == 1 {
            if right != 0 { return false; }
        } else if right < 0 || right >= i {
            return false;
        }
        if kind == AstExpressionNodeCall() &&
            !AstExpressionNodeIsCallableCallee(arena.node_kinds[left]) {
            return false;
        }
        if kind == AstExpressionNodeCallArgument() &&
            !AstExpressionNodeIsCallSpine(arena.node_kinds[left]) {
            return false;
        }
        if kind == AstExpressionNodeMemberAccess() &&
            arena.node_kinds[right] != AstExpressionNodeLeaf() {
            return false;
        }
        if kind == AstExpressionNodeArrayElement() &&
            !AstExpressionNodeIsArrayLiteralSpine(
                arena.node_kinds[left]
            ) {
            return false;
        }
        if kind == AstExpressionNodeStructLiteral() &&
            arena.node_kinds[left] != AstExpressionNodeLeaf() {
            return false;
        }
        if kind == AstExpressionNodeStructFieldBinding() && arena.node_kinds[left] != AstExpressionNodeStructFieldName() {
            return false;
        }
        if kind == AstExpressionNodeStructField() &&
            (!AstExpressionNodeIsStructLiteralSpine(
                arena.node_kinds[left]
            ) || arena.node_kinds[right] !=
                AstExpressionNodeStructFieldBinding()) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func SemanticExpressionGraphAppendNode(
    arena: SemanticExpressionGraphArena,
    kind: Int,
    text: String,
    left: Int,
    right: Int
) -> SemanticExpressionGraphBuild {
    let kinds: Array<Int> = arena.node_kinds;
    let texts: Array<String> = arena.node_texts;
    let left_children: Array<Int> = arena.left_children;
    let right_children: Array<Int> = arena.right_children;
    let call_target_names: Array<String> = arena.call_target_names;
    let root_id: Int = ArrayLength(kinds);
    ArrayPush(kinds, kind);
    ArrayPush(texts, text);
    ArrayPush(left_children, left);
    ArrayPush(right_children, right);
    ArrayPush(call_target_names, "");
    let next: SemanticExpressionGraphArena = SemanticExpressionGraphArena(
        kinds, texts, left_children, right_children,
        call_target_names
    );
    return SemanticExpressionGraphBuild(
        SemanticExpressionGraphArenaReady(next), root_id, next
    );
}

func SemanticExpressionGraphInvalidBuild(
    arena: SemanticExpressionGraphArena
) -> SemanticExpressionGraphBuild {
    return SemanticExpressionGraphBuild(false, 0, arena);
}

func SemanticExpressionGraphBuildParserCompactBridge(
    arena: SemanticExpressionGraphArena,
    text: String
) -> SemanticExpressionGraphBuild {
    let cursor: Array<Int> = [0];
    let parsed: ParserExpressionFact = ParseExprFact(text, 0, cursor);
    if !parsed.ok || cursor[0] != StringLength(text) {
        return SemanticExpressionGraphInvalidBuild(arena);
    }
    let offset: Int = SemanticExpressionGraphArenaNodeCount(arena);
    let i: Int = 0;
    while i < AstExpressionArenaNodeCount(parsed.arena) {
        let kind: Int = parsed.arena.node_kinds[i];
        let arity: Int = AstExpressionNodeArity(kind);
        let left: Int = 0;
        let right: Int = 0;
        if arity >= 1 { left = offset + parsed.arena.left_children[i]; }
        if arity == 2 { right = offset + parsed.arena.right_children[i]; }
        let appended: SemanticExpressionGraphBuild =
            SemanticExpressionGraphAppendNode(
                arena, kind,
                SemanticStripOuterParens(parsed.arena.node_texts[i]),
                left, right
            );
        if !appended.ok { return appended; }
        arena = appended.arena;
        i = i + 1;
    }
    return SemanticExpressionGraphBuild(
        true, offset + parsed.root, arena
    );
}

func SemanticExpressionGraphBuildTryCompactBridge(
    arena: SemanticExpressionGraphArena,
    operand: String
) -> SemanticExpressionGraphBuild {
    let child: SemanticExpressionGraphBuild =
        SemanticExpressionGraphBuildCompactBridgeFromText(arena, operand);
    if !child.ok {
        return child;
    }
    return SemanticExpressionGraphAppendNode(
        child.arena, AstExpressionNodeTry(), Concat("?", operand),
        child.root_id, 0
    );
}

// Transitional producer: operator discovery still consumes compact parser
// payload text. The resulting graph, not that text scan, is the consumer API.
func SemanticExpressionGraphBuildCompactBridgeFromText(
    arena: SemanticExpressionGraphArena,
    expression: String
) -> SemanticExpressionGraphBuild {
    let text: String = SemanticStripOuterParens(expression);
    if text == "" {
        return SemanticExpressionGraphInvalidBuild(arena);
    }
    let prefix_try: Option<String> = SemanticTryOperand(text);
    if CharAt(text, 0) == "?" && IsSome(prefix_try) {
        return SemanticExpressionGraphBuildTryCompactBridge(
            arena, UnwrapOption(prefix_try)
        );
    }
    let operators: SemanticTopLevelOperatorFacts =
        SemanticTopLevelOperatorFactsFromExpression(text);
    let kind: Int = AstExpressionNodeLeaf();
    let operator_index: Option<Int> = None;
    let operator_width: Int = 0;
    if operators.logical_or_index >= 0 {
        kind = AstExpressionNodeLogicalOr();
        operator_index = Some(operators.logical_or_index);
        operator_width = 2;
    } else if operators.logical_and_index >= 0 {
        kind = AstExpressionNodeLogicalAnd();
        operator_index = Some(operators.logical_and_index);
        operator_width = 2;
    } else if operators.comparison_index >= 0 {
        let c0: Int = SourceByteAt(
            text, StringLength(text), operators.comparison_index
        );
        let c1: Int = SourceByteAt(
            text, StringLength(text), operators.comparison_index + 1
        );
        if c0 == SourceByteOf("=") {
            kind = AstExpressionNodeEquality();
        } else if c0 == SourceByteOf("!") {
            kind = AstExpressionNodeInequality();
        } else if c0 == SourceByteOf("<") && c1 == SourceByteOf("=") {
            kind = AstExpressionNodeLessEqual();
        } else if c0 == SourceByteOf(">") && c1 == SourceByteOf("=") {
            kind = AstExpressionNodeGreaterEqual();
        } else if c0 == SourceByteOf("<") {
            kind = AstExpressionNodeLess();
        } else if c0 == SourceByteOf(">") {
            kind = AstExpressionNodeGreater();
        }
        operator_index = Some(operators.comparison_index);
        operator_width = operators.comparison_length;
    } else if operators.additive_index >= 0 {
        let c: Int = SourceByteAt(
            text, StringLength(text), operators.additive_index
        );
        kind = AstExpressionNodeAdd();
        if c == SourceByteOf("-") {
            kind = AstExpressionNodeSubtract();
        }
        operator_index = Some(operators.additive_index);
        operator_width = 1;
    } else if operators.multiplicative_index >= 0 {
        let c: Int = SourceByteAt(
            text, StringLength(text), operators.multiplicative_index
        );
        kind = AstExpressionNodeMultiply();
        if c == SourceByteOf("/") {
            kind = AstExpressionNodeDivide();
        } else if c == SourceByteOf("%") {
            kind = AstExpressionNodeModulo();
        }
        operator_index = Some(operators.multiplicative_index);
        operator_width = 1;
    }
    if kind == AstExpressionNodeLeaf() {
        let postfix_try: Option<String> = SemanticTryOperand(text);
        if IsSome(postfix_try) {
            return SemanticExpressionGraphBuildTryCompactBridge(
                arena, UnwrapOption(postfix_try)
            );
        }
        let parser_bridge: SemanticExpressionGraphBuild =
            SemanticExpressionGraphBuildParserCompactBridge(arena, text);
        if parser_bridge.ok { return parser_bridge; }
        return SemanticExpressionGraphAppendNode(arena, kind, text, 0, 0);
    }
    if !IsSome(operator_index) || operator_width <= 0 {
        return SemanticExpressionGraphInvalidBuild(arena);
    }
    let operator_offset: Int = UnwrapOption(operator_index);
    let lhs: String = Trim(Substring(text, 0, operator_offset));
    let rhs: String = Trim(Substring(
        text, operator_offset + operator_width,
        StringLength(text) - (operator_offset + operator_width)
    ));
    if lhs == "" || rhs == "" {
        return SemanticExpressionGraphInvalidBuild(arena);
    }
    let left_build: SemanticExpressionGraphBuild =
        SemanticExpressionGraphBuildCompactBridgeFromText(arena, lhs);
    if !left_build.ok {
        return left_build;
    }
    let right_build: SemanticExpressionGraphBuild =
        SemanticExpressionGraphBuildCompactBridgeFromText(left_build.arena, rhs);
    if !right_build.ok {
        return right_build;
    }
    return SemanticExpressionGraphAppendNode(
        right_build.arena, kind, text,
        left_build.root_id, right_build.root_id
    );
}

func SemanticExpressionGraphFactsAppendLane(
    facts: SemanticExpressionGraphFacts,
    present: Bool,
    expression: String
) -> SemanticExpressionGraphFacts {
    let roots: Array<Int> = facts.roots;
    let has_roots: Array<Bool> = facts.has_roots;
    if !facts.ok {
        ArrayPush(roots, 0);
        ArrayPush(has_roots, false);
        return SemanticExpressionGraphFacts(
            false, roots, has_roots, facts.arena
        );
    }
    if !present {
        ArrayPush(roots, 0);
        ArrayPush(has_roots, false);
        return SemanticExpressionGraphFacts(
            true, roots, has_roots, facts.arena
        );
    }
    let build: SemanticExpressionGraphBuild =
        SemanticExpressionGraphBuildCompactBridgeFromText(
            facts.arena, expression
        );
    ArrayPush(roots, build.root_id);
    ArrayPush(has_roots, build.ok);
    return SemanticExpressionGraphFacts(
        build.ok, roots, has_roots, build.arena
    );
}

func SemanticExpressionGraphFactsReady(
    ref facts: SemanticExpressionGraphFacts,
    expected_root_count: Int
) -> Bool {
    if !facts.ok || ArrayLength(facts.roots) != expected_root_count ||
        ArrayLength(facts.has_roots) != expected_root_count ||
        !SemanticExpressionGraphArenaReady(facts.arena) {
        return false;
    }
    let node_count: Int = SemanticExpressionGraphArenaNodeCount(facts.arena);
    let i: Int = 0;
    while i < expected_root_count {
        let root: Int = facts.roots[i];
        if facts.has_roots[i] && (root < 0 || root >= node_count) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func SemanticExpressionGraphViewAt(
    facts: SemanticExpressionGraphFacts,
    surface_index: Int,
    lane: Int
) -> SemanticExpressionGraphView {
    let root_index: Int = surface_index * 3 + lane;
    if !facts.ok || surface_index < 0 || lane < 0 || lane > 2 ||
        root_index < 0 || root_index >= ArrayLength(facts.roots) ||
        root_index >= ArrayLength(facts.has_roots) ||
        !facts.has_roots[root_index] {
        return SemanticExpressionGraphView(false, 0, facts);
    }
    return SemanticExpressionGraphView(
        true, facts.roots[root_index], facts
    );
}

func SemanticExpressionGraphNodeText(
    ref facts: SemanticExpressionGraphFacts,
    node_id: Int
) -> Option<String> {
    if !facts.ok || node_id < 0 ||
        node_id >= SemanticExpressionGraphArenaNodeCount(facts.arena) {
        return None;
    }
    return Some(facts.arena.node_texts[node_id]);
}

func SemanticExpressionGraphNodeKind(
    ref facts: SemanticExpressionGraphFacts,
    node_id: Int
) -> Option<Int> {
    if !facts.ok || node_id < 0 ||
        node_id >= SemanticExpressionGraphArenaNodeCount(facts.arena) {
        return None;
    }
    return Some(facts.arena.node_kinds[node_id]);
}

func SemanticExpressionGraphLeftChild(
    ref facts: SemanticExpressionGraphFacts,
    node_id: Int
) -> Option<Int> {
    let kind: Option<Int> = SemanticExpressionGraphNodeKind(facts, node_id);
    if !IsSome(kind) || AstExpressionNodeArity(UnwrapOption(kind)) < 1 {
        return None;
    }
    return Some(facts.arena.left_children[node_id]);
}

func SemanticExpressionGraphRightChild(
    ref facts: SemanticExpressionGraphFacts,
    node_id: Int
) -> Option<Int> {
    let kind: Option<Int> = SemanticExpressionGraphNodeKind(facts, node_id);
    if !IsSome(kind) || AstExpressionNodeArity(UnwrapOption(kind)) < 2 {
        return None;
    }
    return Some(facts.arena.right_children[node_id]);
}

func SemanticExpressionGraphFactsEqual(
    ref left: SemanticExpressionGraphFacts,
    ref right: SemanticExpressionGraphFacts
) -> Bool {
    if left.ok != right.ok || ArrayLength(left.roots) != ArrayLength(right.roots) ||
        ArrayLength(left.has_roots) != ArrayLength(right.has_roots) ||
        SemanticExpressionGraphArenaNodeCount(left.arena) !=
            SemanticExpressionGraphArenaNodeCount(right.arena) {
        return false;
    }
    let i: Int = 0;
    while i < ArrayLength(left.roots) {
        if left.roots[i] != right.roots[i] ||
            left.has_roots[i] != right.has_roots[i] { return false; }
        i = i + 1;
    }
    i = 0;
    while i < SemanticExpressionGraphArenaNodeCount(left.arena) {
        if left.arena.node_kinds[i] != right.arena.node_kinds[i] ||
            left.arena.node_texts[i] != right.arena.node_texts[i] ||
            left.arena.left_children[i] != right.arena.left_children[i] ||
            left.arena.right_children[i] != right.arena.right_children[i] ||
            left.arena.call_target_names[i] !=
                right.arena.call_target_names[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}
