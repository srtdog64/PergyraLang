// Normalized semantic expression graph rows.
//
// Consumers use stable node handles and child edges. The current producer
// still lowers the compact parser payload into these rows; parser-owned arena
// production can replace that bridge without changing semantic/codegen views.

import "expression_normalization_owner.pgy";
import "../hir/ast_expression_graph_owner.pgy";

struct SemanticExpressionGraphArena {
    // Parser/HIR owns the immutable topology. Semantic owns only overlays.
    topology: AstExpressionArena;
    node_texts: Array<String>;
    // These rows jointly carry the canonical callable identity.
    call_target_kinds: Array<Int>;
    call_target_names: Array<String>;
    // Semantic value-category facts. Parser/MIR construction leaves these
    // unknown; the body fixpoint classifies every carried node once.
    place_kinds: Array<Int>;
}

struct SemanticExpressionGraphFacts {
    ok: Bool;
    roots: Array<Int>;
    has_roots: Array<Bool>;
    arena: SemanticExpressionGraphArena;
}

struct SemanticExpressionGraphBuild {
    ok: Bool;
    root_id: Int;
}

struct SemanticExpressionGraphView {
    ok: Bool;
    root_id: Int;
    graph: SemanticExpressionGraphFacts;
}

func SemanticExpressionGraphArenaEmpty() -> SemanticExpressionGraphArena {
    let node_kinds: Array<Int> = [];
    let node_texts: Array<String> = [];
    let left_children: Array<Int> = [];
    let right_children: Array<Int> = [];
    let call_target_kinds: Array<Int> = [];
    let call_target_names: Array<String> = [];
    let place_kinds: Array<Int> = [];
    return SemanticExpressionGraphArena(
        AstExpressionArena(
            node_kinds, node_texts, left_children, right_children
        ),
        node_texts, call_target_kinds, call_target_names, place_kinds
    );
}

func SemanticExpressionPlaceUnknown() -> Int { return 0; }
func SemanticExpressionPlaceValue() -> Int { return 1; }
func SemanticExpressionPlaceBinding() -> Int { return 2; }
func SemanticExpressionPlaceReadonlyRefBinding() -> Int { return 3; }
func SemanticExpressionPlaceMember() -> Int { return 4; }

func SemanticExpressionGraphArenaUnclassified(
    node_kinds: Array<Int>,
    node_texts: Array<String>,
    left_children: Array<Int>,
    right_children: Array<Int>,
    call_target_kinds: Array<Int>,
    call_target_names: Array<String>
) -> SemanticExpressionGraphArena {
    let place_kinds: Array<Int> = [];
    let i: Int = 0;
    while i < ArrayLength(node_kinds) {
        ArrayPush(place_kinds, SemanticExpressionPlaceUnknown());
        i = i + 1;
    }
    return SemanticExpressionGraphArenaFromTopology(
        AstExpressionArena(
            node_kinds, node_texts, left_children, right_children
        ),
        node_texts, call_target_kinds, call_target_names, place_kinds
    );
}

func SemanticExpressionGraphArenaFromTopology(
    topology: AstExpressionArena,
    node_texts: Array<String>,
    call_target_kinds: Array<Int>,
    call_target_names: Array<String>,
    place_kinds: Array<Int>
) -> SemanticExpressionGraphArena {
    return SemanticExpressionGraphArena(
        topology, node_texts, call_target_kinds, call_target_names, place_kinds
    );
}

func SemanticExpressionGraphArenaFromRows(
    node_kinds: Array<Int>,
    node_texts: Array<String>,
    left_children: Array<Int>,
    right_children: Array<Int>,
    call_target_kinds: Array<Int>,
    call_target_names: Array<String>,
    place_kinds: Array<Int>
) -> SemanticExpressionGraphArena {
    return SemanticExpressionGraphArenaFromTopology(
        AstExpressionArena(
            node_kinds, node_texts, left_children, right_children
        ),
        node_texts, call_target_kinds, call_target_names, place_kinds
    );
}

func SemanticCallTargetNone() -> Int { return 0; }
func SemanticCallTargetNamespace() -> Int { return 1; }
func SemanticCallTargetMember() -> Int { return 2; }
func SemanticCallTargetDirect() -> Int { return 3; }

func SemanticExpressionGraphFactsEmpty() -> SemanticExpressionGraphFacts {
    let roots: Array<Int> = [];
    let has_roots: Array<Bool> = [];
    return SemanticExpressionGraphFacts(
        true, roots, has_roots, SemanticExpressionGraphArenaEmpty()
    );
}

func SemanticExpressionGraphFactsFromAstRows(
    rows: AstExpressionGraphRows,
    root_slots: Array<Int>,
    expected_root_count: Int
) -> SemanticExpressionGraphFacts {
    let roots: Array<Int> = [];
    let has_roots: Array<Bool> = [];
    let texts: Array<String> = [];
    let call_target_kinds: Array<Int> = [];
    let call_target_names: Array<String> = [];
    let ok: Bool = expected_root_count >= 0 &&
        AstExpressionGraphRowsReady(rows) &&
        ArrayLength(root_slots) == ArrayLength(rows.roots);
    let i: Int = 0;
    while i < expected_root_count {
        ArrayPush(roots, 0);
        ArrayPush(has_roots, false);
        i = i + 1;
    }
    i = 0;
    while i < AstExpressionArenaNodeCount(rows.arena) {
        ArrayPush(texts, SemanticStripOuterParens(rows.arena.node_texts[i]));
        ArrayPush(call_target_kinds, SemanticCallTargetNone());
        ArrayPush(call_target_names, "");
        i = i + 1;
    }
    i = 0;
    while i < ArrayLength(root_slots) && ok {
        let slot: Int = root_slots[i];
        if slot < 0 || slot >= expected_root_count || has_roots[slot] {
            ok = false;
        } else {
            ArraySet(roots, slot, rows.roots[i]);
            ArraySet(has_roots, slot, true);
        }
        i = i + 1;
    }
    let place_kinds: Array<Int> = [];
    i = 0;
    while i < AstExpressionArenaNodeCount(rows.arena) {
        ArrayPush(place_kinds, SemanticExpressionPlaceUnknown());
        i = i + 1;
    }
    let arena: SemanticExpressionGraphArena =
        SemanticExpressionGraphArenaFromTopology(
        rows.arena, texts, call_target_kinds, call_target_names, place_kinds
    );
    let facts: SemanticExpressionGraphFacts = SemanticExpressionGraphFacts(
        ok, roots, has_roots, arena
    );
    return SemanticExpressionGraphFacts(
        SemanticExpressionGraphFactsReady(facts, expected_root_count),
        roots, has_roots, arena
    );
}

func SemanticExpressionGraphArenaNodeCount(
    ref arena: SemanticExpressionGraphArena
) -> Int {
    return ArrayLength(arena.topology.node_kinds);
}

func SemanticExpressionGraphArenaReady(
    ref arena: SemanticExpressionGraphArena
) -> Bool {
    let count: Int = SemanticExpressionGraphArenaNodeCount(arena);
    if !AstExpressionArenaReady(arena.topology) ||
        ArrayLength(arena.node_texts) != count ||
        ArrayLength(arena.topology.node_texts) != count ||
        ArrayLength(arena.topology.left_children) != count ||
        ArrayLength(arena.topology.right_children) != count ||
        ArrayLength(arena.call_target_kinds) != count ||
        ArrayLength(arena.call_target_names) != count ||
        ArrayLength(arena.place_kinds) != count {
        return false;
    }
    let i: Int = 0;
    while i < count {
        let kind: Int = arena.topology.node_kinds[i];
        let left: Int = arena.topology.left_children[i];
        let right: Int = arena.topology.right_children[i];
        if arena.node_texts[i] == "" ||
            !AstExpressionNodeKindKnown(kind) {
            return false;
        }
        if kind == AstExpressionNodeLongLiteral() &&
            !AstExpressionLongLiteralPayloadReady(arena.node_texts[i]) {
            return false;
        }
        if kind == AstExpressionNodeBoolLiteral() &&
            !AstExpressionBoolLiteralPayloadReady(arena.node_texts[i]) {
            return false;
        }
        if kind == AstExpressionNodeStringLiteral() &&
            !AstExpressionStringLiteralPayloadReady(arena.node_texts[i]) {
            return false;
        }
        let call_target_kind: Int = arena.call_target_kinds[i];
        let call_target_name: String = arena.call_target_names[i];
        let place_kind: Int = arena.place_kinds[i];
        if place_kind < SemanticExpressionPlaceUnknown() ||
            place_kind > SemanticExpressionPlaceMember() {
            return false;
        }
        if call_target_kind == SemanticCallTargetNone() {
            if call_target_name != "" { return false; }
        } else if call_target_kind == SemanticCallTargetDirect() ||
            call_target_kind == SemanticCallTargetNamespace() ||
            call_target_kind == SemanticCallTargetMember() {
            if call_target_name == "" || kind != AstExpressionNodeCall() {
                return false;
            }
        } else {
            return false;
        }
        let arity: Int = AstExpressionNodeArity(kind);
        if arity == 0 {
            if left != 0 || right != 0 { return false; }
        } else if left < 0 || left >= i {
            return false;
        } else if arity == 1 {
            if right != 0 { return false; }
        } else if right < 0 || right >= i {
            return false;
        }
        if kind == AstExpressionNodeCall() &&
            !AstExpressionNodeIsCallableCallee(
                arena.topology.node_kinds[left]
            ) {
            return false;
        }
        if kind == AstExpressionNodeCallArgument() &&
            !AstExpressionNodeIsCallSpine(arena.topology.node_kinds[left]) {
            return false;
        }
        if kind == AstExpressionNodeMemberAccess() &&
            arena.topology.node_kinds[right] != AstExpressionNodeLeaf() {
            return false;
        }
        if kind == AstExpressionNodeGenericCallee() &&
            (!AstExpressionNodeIsCallableCallee(
                arena.topology.node_kinds[left]
            ) || arena.topology.node_kinds[right] !=
                    AstExpressionNodeGenericTypeActual()) {
            return false;
        }
        if kind == AstExpressionNodeArrayElement() &&
            !AstExpressionNodeIsArrayLiteralSpine(
                arena.topology.node_kinds[left]
            ) {
            return false;
        }
        if kind == AstExpressionNodeSetElement() &&
            !AstExpressionNodeIsSetLiteralSpine(
                arena.topology.node_kinds[left]
            ) {
            return false;
        }
        if kind == AstExpressionNodeStructLiteral() &&
            arena.topology.node_kinds[left] != AstExpressionNodeLeaf() {
            return false;
        }
        if kind == AstExpressionNodeStructFieldBinding() &&
            arena.topology.node_kinds[left] !=
                AstExpressionNodeStructFieldName() {
            return false;
        }
        if kind == AstExpressionNodeStructField() &&
            (!AstExpressionNodeIsStructLiteralSpine(
                arena.topology.node_kinds[left]
            ) || arena.topology.node_kinds[right] !=
                AstExpressionNodeStructFieldBinding()) {
            return false;
        }
        if kind == AstExpressionNodeCast() &&
            arena.topology.node_kinds[right] != AstExpressionNodeTypeName() {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func SemanticExpressionGraphFactsReady(
    ref facts: SemanticExpressionGraphFacts,
    expected_root_count: Int
) -> Bool {
    if !facts.ok || ArrayLength(facts.roots) != expected_root_count ||
        ArrayLength(facts.has_roots) != expected_root_count ||
        !SemanticExpressionGraphArenaReady(facts.arena) {
        return false;
    }
    let node_count: Int = SemanticExpressionGraphArenaNodeCount(facts.arena);
    let i: Int = 0;
    while i < expected_root_count {
        let root: Int = facts.roots[i];
        if facts.has_roots[i] && (root < 0 || root >= node_count) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func SemanticExpressionGraphFactsReadinessSummary(
    ref facts: SemanticExpressionGraphFacts,
    expected_root_count: Int
) -> String {
    let arena_count: Int = SemanticExpressionGraphArenaNodeCount(facts.arena);
    let status: String = "false";
    if facts.ok { status = "true"; }
    return Concat(
        Concat(
            Concat(
                Concat(
                    Concat(
                        Concat(
                            Concat(
                                Concat(
                                    Concat("facts_ok=", status),
                                    Concat(";roots=", ToString(ArrayLength(facts.roots)))
                                ),
                                Concat(";expected=", ToString(expected_root_count))
                            ),
                            Concat(";has_roots=", ToString(ArrayLength(facts.has_roots)))
                        ),
                        Concat(";nodes=", ToString(arena_count))
                    ),
                    Concat(";texts=", ToString(ArrayLength(facts.arena.node_texts)))
                ),
                Concat(";left=", ToString(ArrayLength(facts.arena.topology.left_children)))
            ),
            Concat(";right=", ToString(ArrayLength(facts.arena.topology.right_children)))
        ),
        Concat(
            Concat(";target_kinds=", ToString(ArrayLength(facts.arena.call_target_kinds))),
            Concat(";target_names=", ToString(ArrayLength(facts.arena.call_target_names)))
        )
    );
}

func SemanticExpressionGraphViewAt(
    facts: SemanticExpressionGraphFacts,
    surface_index: Int,
    lane: Int
) -> SemanticExpressionGraphView {
    let root_index: Int = surface_index * 3 + lane;
    if !facts.ok || surface_index < 0 || lane < 0 || lane > 2 ||
        root_index < 0 || root_index >= ArrayLength(facts.roots) ||
        root_index >= ArrayLength(facts.has_roots) ||
        !facts.has_roots[root_index] {
        return SemanticExpressionGraphView(false, 0, facts);
    }
    return SemanticExpressionGraphView(
        true, facts.roots[root_index], facts
    );
}

func SemanticExpressionGraphNodeText(
    ref facts: SemanticExpressionGraphFacts,
    node_id: Int
) -> Option<String> {
    if !facts.ok || node_id < 0 ||
        node_id >= SemanticExpressionGraphArenaNodeCount(facts.arena) {
        return None;
    }
    return Some(facts.arena.node_texts[node_id]);
}

func SemanticExpressionGraphNodeKind(
    ref facts: SemanticExpressionGraphFacts,
    node_id: Int
) -> Option<Int> {
    if !facts.ok || node_id < 0 ||
        node_id >= SemanticExpressionGraphArenaNodeCount(facts.arena) {
        return None;
    }
    return Some(facts.arena.topology.node_kinds[node_id]);
}

func SemanticExpressionGraphPlaceKind(
    ref facts: SemanticExpressionGraphFacts,
    node_id: Int
) -> Option<Int> {
    if !facts.ok || node_id < 0 ||
        node_id >= SemanticExpressionGraphArenaNodeCount(facts.arena) {
        return None;
    }
    let place_kind: Int = facts.arena.place_kinds[node_id];
    if place_kind == SemanticExpressionPlaceUnknown() {
        return None;
    }
    return Some(place_kind);
}

func SemanticExpressionPlaceKindAddressable(place_kind: Int) -> Bool {
    return place_kind == SemanticExpressionPlaceBinding() ||
        place_kind == SemanticExpressionPlaceReadonlyRefBinding() ||
        place_kind == SemanticExpressionPlaceMember();
}

func SemanticExpressionPlaceKindDirectBinding(place_kind: Int) -> Bool {
    return place_kind == SemanticExpressionPlaceBinding() ||
        place_kind == SemanticExpressionPlaceReadonlyRefBinding();
}

func SemanticExpressionGraphLeftChild(
    ref facts: SemanticExpressionGraphFacts,
    node_id: Int
) -> Option<Int> {
    let kind: Option<Int> = SemanticExpressionGraphNodeKind(facts, node_id);
    if !IsSome(kind) || AstExpressionNodeArity(UnwrapOption(kind)) < 1 {
        return None;
    }
    return Some(facts.arena.topology.left_children[node_id]);
}

func SemanticExpressionGraphRightChild(
    ref facts: SemanticExpressionGraphFacts,
    node_id: Int
) -> Option<Int> {
    let kind: Option<Int> = SemanticExpressionGraphNodeKind(facts, node_id);
    if !IsSome(kind) || AstExpressionNodeArity(UnwrapOption(kind)) < 2 {
        return None;
    }
    return Some(facts.arena.topology.right_children[node_id]);
}

func SemanticExpressionGraphFactsEqual(
    ref left: SemanticExpressionGraphFacts,
    ref right: SemanticExpressionGraphFacts
) -> Bool {
    if left.ok != right.ok || ArrayLength(left.roots) != ArrayLength(right.roots) ||
        ArrayLength(left.has_roots) != ArrayLength(right.has_roots) ||
        SemanticExpressionGraphArenaNodeCount(left.arena) !=
            SemanticExpressionGraphArenaNodeCount(right.arena) {
        return false;
    }
    let i: Int = 0;
    while i < ArrayLength(left.roots) {
        if left.roots[i] != right.roots[i] ||
            left.has_roots[i] != right.has_roots[i] { return false; }
        i = i + 1;
    }
    i = 0;
    while i < SemanticExpressionGraphArenaNodeCount(left.arena) {
        if left.arena.topology.node_kinds[i] !=
                right.arena.topology.node_kinds[i] ||
            left.arena.topology.node_texts[i] !=
                right.arena.topology.node_texts[i] ||
            left.arena.node_texts[i] != right.arena.node_texts[i] ||
            left.arena.topology.left_children[i] !=
                right.arena.topology.left_children[i] ||
            left.arena.topology.right_children[i] !=
                right.arena.topology.right_children[i] ||
            left.arena.call_target_kinds[i] !=
                right.arena.call_target_kinds[i] ||
            left.arena.call_target_names[i] !=
                right.arena.call_target_names[i] ||
            left.arena.place_kinds[i] != right.arena.place_kinds[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}
