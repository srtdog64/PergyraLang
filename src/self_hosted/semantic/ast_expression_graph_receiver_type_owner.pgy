// Receiver types projected from expression handles and nominal field facts.

import "ast_expression_graph_member_view_owner.pgy";
import "ast_expression_graph_call_view_owner.pgy";
import "ast_nominal_constructor_fact_owner.pgy";
import "ast_expression_function_table_fact_owner.pgy";
import "ast_type_name_canonical_owner.pgy";
import "array_type_shape_owner.pgy";
import "callable_resolution_owner.pgy";
import "env_owner.pgy";
import "wrapper_type_owner.pgy";
import "ast_expression_graph_node_view_owner.pgy";

func SemanticExpressionGraphReceiverTypeName(
    ref graph: SemanticExpressionGraphFacts,
    node_id: Int,
    ref constructors: SemanticAstNominalConstructorFacts,
    names: Array<String>,
    types: Array<String>
) -> Option<String> {
    let current: Int = node_id;
    let member_depth: Int = 0;
    let remaining: Int = SemanticExpressionGraphArenaNodeCount(graph.arena);
    while remaining > 0 {
        let kind: Option<Int> = SemanticExpressionGraphNodeKind(graph, current);
        if !IsSome(kind) { return None; }
        if UnwrapOption(kind) == AstExpressionNodeLeaf() { break; }
        if UnwrapOption(kind) != AstExpressionNodeMemberAccess() { return None; }
        let member: SemanticMemberAccessView =
            SemanticMemberAccessViewFromGraph(graph, current);
        if !member.ok || member.receiver_node < 0 ||
            member.receiver_node >= current { return None; }
        current = member.receiver_node;
        member_depth = member_depth + 1;
        remaining = remaining - 1;
    }
    if remaining <= 0 { return None; }
    let name: Option<String> = SemanticExpressionGraphNodeText(graph, current);
    if !IsSome(name) { return None; }
    let receiver_type: String = EnvLookup(names, types, UnwrapOption(name));
    if receiver_type == "" { return None; }
    let layer: Int = member_depth;
    while layer > 0 {
        let member_node: Int = node_id;
        let descent: Int = layer - 1;
        while descent > 0 {
            let outer: SemanticMemberAccessView =
                SemanticMemberAccessViewFromGraph(graph, member_node);
            if !outer.ok || outer.receiver_node < 0 ||
                outer.receiver_node >= member_node { return None; }
            member_node = outer.receiver_node;
            descent = descent - 1;
        }
        let member: SemanticMemberAccessView =
            SemanticMemberAccessViewFromGraph(graph, member_node);
        if !member.ok { return None; }
        let field_name: Option<String> = SemanticExpressionGraphNodeText(
            graph, member.member_node);
        if !IsSome(field_name) { return None; }
        let receiver_fact: SemanticCanonicalTypeNameFact =
            SemanticCanonicalTypeNameFactFrom(receiver_type);
        let field_type: Option<String> = SemanticAstNominalFieldType(
            constructors, receiver_fact.nominal_base_name,
            UnwrapOption(field_name));
        if !IsSome(field_type) { return None; }
        receiver_type = Concat("", UnwrapOption(field_type));
        layer = layer - 1;
    }
    return Some(receiver_type);
}

struct SemanticExpressionGraphValueReceiverSpine {
    ok: Bool;
    leaf_node: Int;
    call_node: Int;
    call_target_node: Int;
    call_target_carried: Bool;
    depth: Int;
}

func SemanticExpressionGraphValueReceiverSpineFromGraph(
    ref graph: SemanticExpressionGraphFacts,
    node_id: Int
) -> SemanticExpressionGraphValueReceiverSpine {
    let missing: SemanticExpressionGraphValueReceiverSpine =
        SemanticExpressionGraphValueReceiverSpine(
            false, -1, -1, -1, false, 0);
    let current: Int = node_id;
    let depth: Int = 0;
    let remaining: Int = SemanticExpressionGraphArenaNodeCount(graph.arena);
    while remaining > 0 {
        let kind: Option<Int> = SemanticExpressionGraphNodeKind(graph, current);
        if !IsSome(kind) { return missing; }
        if UnwrapOption(kind) == AstExpressionNodeLeaf() {
            return SemanticExpressionGraphValueReceiverSpine(
                true, current, -1, -1, false, depth);
        } else if UnwrapOption(kind) == AstExpressionNodeMemberAccess() {
            let member: SemanticMemberAccessView =
                SemanticMemberAccessViewFromGraph(graph, current);
            if !member.ok || member.receiver_node < 0 ||
                member.receiver_node >= current { return missing; }
            current = member.receiver_node;
            depth = depth + 1;
        } else if UnwrapOption(kind) == AstExpressionNodeIndex() {
            let receiver: Option<Int> =
                SemanticExpressionGraphLeftChild(graph, current);
            if !IsSome(receiver) || UnwrapOption(receiver) < 0 ||
                UnwrapOption(receiver) >= current { return missing; }
            current = UnwrapOption(receiver);
            depth = depth + 1;
        } else {
            let call: SemanticCallSpineView =
                SemanticCallSpineViewFromGraph(graph, current);
            if !call.ok { return missing; }
            let carried_kind: Int =
                graph.arena.call_target_kinds[call.call_node];
            let carried_name: String =
                graph.arena.call_target_names[call.call_node];
            let target_name: String = carried_name;
            let target_node: Int = call.call_node;
            let target_carried: Bool = carried_name != "";
            if carried_name != "" &&
                carried_kind != SemanticCallTargetDirect() &&
                carried_kind != SemanticCallTargetNamespace() &&
                carried_kind != SemanticCallTargetMember() { return missing; }
            if target_name == "" {
                let callee_kind: Option<Int> =
                    SemanticExpressionGraphNodeKind(graph, call.callee_node);
                let callee_name: Option<String> =
                    SemanticExpressionGraphNodeText(graph, call.callee_node);
                if !IsSome(callee_kind) || UnwrapOption(callee_kind) !=
                        AstExpressionNodeLeaf() || !IsSome(callee_name) {
                    return missing;
                }
                target_name = UnwrapOption(callee_name);
                target_node = call.callee_node;
            }
            if (target_name == "UnwrapOption" || target_name == "Unwrap") &&
                    ArrayLength(call.argument_nodes) == 1 {
                let argument: Int = call.argument_nodes[0];
                if argument < 0 || argument >= current { return missing; }
                current = argument;
                depth = depth + 1;
            } else {
                return SemanticExpressionGraphValueReceiverSpine(
                    true, -1, call.call_node, target_node,
                    target_carried, depth);
            }
        }
        remaining = remaining - 1;
    }
    return missing;
}

func SemanticExpressionGraphValueReceiverProjectedTypeName(
    ref graph: SemanticExpressionGraphFacts,
    node_id: Int,
    ref constructors: SemanticAstNominalConstructorFacts,
    depth: Int,
    value_type: String
) -> Option<String> {
    if value_type == "" || value_type == "Unknown" { return None; }
    let layer: Int = depth;
    while layer > 0 {
        let operation_node: Int = node_id;
        let descent: Int = layer - 1;
        while descent > 0 {
            let kind: Option<Int> =
                SemanticExpressionGraphNodeKind(graph, operation_node);
            if !IsSome(kind) { return None; }
            if UnwrapOption(kind) == AstExpressionNodeMemberAccess() {
                let member: SemanticMemberAccessView =
                    SemanticMemberAccessViewFromGraph(graph, operation_node);
                if !member.ok { return None; }
                operation_node = member.receiver_node;
            } else if UnwrapOption(kind) == AstExpressionNodeIndex() {
                let receiver: Option<Int> =
                    SemanticExpressionGraphLeftChild(graph, operation_node);
                if !IsSome(receiver) { return None; }
                operation_node = UnwrapOption(receiver);
            } else {
                let call: SemanticCallSpineView =
                    SemanticCallSpineViewFromGraph(graph, operation_node);
                if !call.ok || ArrayLength(call.argument_nodes) != 1 {
                    return None;
                }
                operation_node = call.argument_nodes[0];
            }
            descent = descent - 1;
        }
        let operation_kind: Option<Int> =
            SemanticExpressionGraphNodeKind(graph, operation_node);
        if !IsSome(operation_kind) { return None; }
        let next_type: Option<String> = None;
        if UnwrapOption(operation_kind) == AstExpressionNodeMemberAccess() {
            let member: SemanticMemberAccessView =
                SemanticMemberAccessViewFromGraph(graph, operation_node);
            if !member.ok { return None; }
            let field_name: Option<String> =
                SemanticExpressionGraphNodeText(graph, member.member_node);
            if !IsSome(field_name) { return None; }
            let receiver_fact: SemanticCanonicalTypeNameFact =
                SemanticCanonicalTypeNameFactFrom(value_type);
            next_type = SemanticAstNominalFieldType(
                constructors, receiver_fact.nominal_base_name,
                UnwrapOption(field_name));
        } else if UnwrapOption(operation_kind) == AstExpressionNodeIndex() {
            next_type = SemanticArrayElementType(value_type);
            if !IsSome(next_type) {
                next_type = SemanticSliceElementType(value_type);
            }
        } else {
            next_type = OptionPayloadTypeOpt(value_type);
            if !IsSome(next_type) {
                next_type = ResultPayloadTypeOpt(value_type);
            }
        }
        if !IsSome(next_type) { return None; }
        value_type = Concat("", UnwrapOption(next_type));
        layer = layer - 1;
    }
    return Some(value_type);
}

func SemanticExpressionGraphValueReceiverSpineTargetName(
    ref graph: SemanticExpressionGraphFacts,
    spine: SemanticExpressionGraphValueReceiverSpine
) -> Option<String> {
    if !spine.ok || spine.call_node < 0 {
        return None;
    }
    if spine.call_target_carried {
        if spine.call_node >=
                SemanticExpressionGraphArenaNodeCount(graph.arena) ||
            graph.arena.call_target_names[spine.call_node] == "" {
            return None;
        }
        return Some(Concat(
            "", graph.arena.call_target_names[spine.call_node]));
    }
    let source_name: Option<String> =
        SemanticExpressionGraphNodeText(graph, spine.call_target_node);
    if !IsSome(source_name) { return None; }
    return Some(Concat("", UnwrapOption(source_name)));
}

func SemanticExpressionGraphValueReceiverTypeName(
    ref graph: SemanticExpressionGraphFacts,
    node_id: Int,
    ref constructors: SemanticAstNominalConstructorFacts,
    names: Array<String>,
    types: Array<String>,
    ref function_names: Array<String>,
    ref function_returns: Array<String>
) -> Option<String> {
    if ArrayLength(function_names) != ArrayLength(function_returns) {
        return None;
    }
    let spine: SemanticExpressionGraphValueReceiverSpine =
        SemanticExpressionGraphValueReceiverSpineFromGraph(graph, node_id);
    if !spine.ok { return None; }
    let value_type: String = "";
    if spine.leaf_node >= 0 {
        let leaf_type: Option<String> =
            SemanticExpressionGraphReceiverTypeName(
                graph, spine.leaf_node, constructors, names, types);
        if !IsSome(leaf_type) { return None; }
        value_type = Concat("", UnwrapOption(leaf_type));
    } else {
        let target_name: Option<String> =
            SemanticExpressionGraphValueReceiverSpineTargetName(
                graph, spine);
        if !IsSome(target_name) { return None; }
        let target: Option<Int> =
            SemanticCallableIndex(function_names, UnwrapOption(target_name));
        if !IsSome(target) ||
            function_returns[UnwrapOption(target)] == "" ||
            function_returns[UnwrapOption(target)] == "Unknown" {
            return None;
        }
        value_type = Concat("", function_returns[UnwrapOption(target)]);
    }
    return SemanticExpressionGraphValueReceiverProjectedTypeName(
        graph, node_id, constructors, spine.depth, value_type);
}

func SemanticExpressionGraphValueReceiverTypeNameFromFunctionTables(
    ref graph: SemanticExpressionGraphFacts,
    node_id: Int,
    ref constructors: SemanticAstNominalConstructorFacts,
    names: Array<String>,
    types: Array<String>,
    ref function_tables: SemanticAstExpressionFunctionTableFacts
) -> Option<String> {
    if !function_tables.ok ||
        ArrayLength(function_tables.names) !=
            ArrayLength(function_tables.returns) ||
        ArrayLength(function_tables.names) !=
            ArrayLength(function_tables.params) {
        return None;
    }
    let spine: SemanticExpressionGraphValueReceiverSpine =
        SemanticExpressionGraphValueReceiverSpineFromGraph(graph, node_id);
    if !spine.ok { return None; }
    let value_type: String = "";
    if spine.leaf_node >= 0 {
        let leaf_type: Option<String> =
            SemanticExpressionGraphReceiverTypeName(
                graph, spine.leaf_node, constructors, names, types);
        if !IsSome(leaf_type) { return None; }
        value_type = Concat("", UnwrapOption(leaf_type));
    } else {
        let target_name: Option<String> =
            SemanticExpressionGraphValueReceiverSpineTargetName(
                graph, spine);
        if !IsSome(target_name) { return None; }
        let target: Option<Int> =
            SemanticAstExpressionFunctionTableCallableIndex(
                function_tables, UnwrapOption(target_name));
        if !IsSome(target) ||
            function_tables.returns[UnwrapOption(target)] == "" ||
            function_tables.returns[UnwrapOption(target)] == "Unknown" {
            return None;
        }
        value_type = Concat(
            "", function_tables.returns[UnwrapOption(target)]);
    }
    return SemanticExpressionGraphValueReceiverProjectedTypeName(
        graph, node_id, constructors, spine.depth, value_type);
}
