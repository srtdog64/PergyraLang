// Canonical return types for semantically resolved graph calls.

import "ast_expression_call_target_fact_owner.pgy";
import "ast_expression_graph_call_view_owner.pgy";
import "ast_expression_graph_collection_call_protocol_owner.pgy";
import "ast_expression_graph_scalar_shape_owner.pgy";
import "callable_resolution_owner.pgy";
import "ast_type_name_canonical_owner.pgy";
import "env_owner.pgy";
import "expr_type_owner.pgy";
import "diagnostic_owner.pgy";
import "ast_expression_graph_queue_call_owner.pgy";
import "ast_expression_graph_set_call_owner.pgy";
import "ast_expression_graph_node_view_owner.pgy";

struct SemanticExpressionGraphListCallFact {
    applies: Bool;
    ok: Bool;
    diagnostic_code: String;
    diagnostic_message: String;
    return_type_name: String;
    list_type_name: String;
    element_type_name: String;
}

func SemanticExpressionGraphListCallNotApplicable(
) -> SemanticExpressionGraphListCallFact {
    return SemanticExpressionGraphListCallFact(
        false, true, "", "", "", "", ""
    );
}

func SemanticExpressionGraphListCallError(
    code: String,
    message: String
) -> SemanticExpressionGraphListCallFact {
    return SemanticExpressionGraphListCallFact(
        true, false, code, message, "", "", ""
    );
}

func SemanticExpressionGraphListCallFactFromResolvedTarget(
    ref graph: SemanticExpressionGraphFacts,
    root_id: Int,
    target: SemanticExpressionCallTargetFact,
    names: Array<String>,
    types: Array<String>
) -> SemanticExpressionGraphListCallFact {
    let call: SemanticCallSpineView = SemanticCallSpineViewFromGraph(
        graph, root_id
    );
    if !call.ok { return SemanticExpressionGraphListCallNotApplicable(); }
    let callee_kind: Option<Int> = SemanticExpressionGraphNodeKind(
        graph, call.callee_node
    );
    let callee_text: Option<String> = SemanticExpressionGraphNodeText(
        graph, call.callee_node
    );
    if !IsSome(callee_kind) || !IsSome(callee_text) ||
        UnwrapOption(callee_kind) != AstExpressionNodeLeaf() {
        return SemanticExpressionGraphListCallNotApplicable();
    }
    let protocol: SemanticExpressionGraphCollectionCallProtocolFact =
        SemanticExpressionGraphCollectionCallProtocolFromName(
            UnwrapOption(callee_text)
        );
    if !protocol.applies || protocol.family != "List" {
        return SemanticExpressionGraphListCallNotApplicable();
    }
    let callee: String = UnwrapOption(callee_text);
    if !target.ok || target.kind != SemanticCallTargetDirect() ||
        target.name != callee {
        return SemanticExpressionGraphListCallError(
            "ast_artifact_invalid",
            SemanticError1(
                "ast_artifact_invalid", "owner", "collection_call_target"
            )
        );
    }
    let expected_arity: Int = protocol.expected_arity;
    if ArrayLength(call.argument_nodes) != expected_arity {
        return SemanticExpressionGraphListCallError(
            "call_arity_mismatch",
            SemanticError3(
                "call_arity_mismatch", "func", callee,
                "expected", ToString(expected_arity),
                "actual", ToString(ArrayLength(call.argument_nodes))
            )
        );
    }
    if protocol.return_kind == "constructor" {
        return SemanticExpressionGraphListCallFact(
            true, true, "", "", "List<Unknown>", "List<Unknown>",
            "Unknown"
        );
    }
    let list_type: String = SemanticExpressionGraphCallArgumentScalarTypeName(
        graph, call.argument_nodes[protocol.receiver_argument_index],
        names, types
    );
    let shape: SemanticConstructedTypeNameFact =
        SemanticConstructedTypeNameFactFrom(list_type);
    if !shape.ok || shape.nominal_base_name != "List" ||
        ArrayLength(shape.actual_type_names) != 1 ||
        SemanticTypeNameContainsUnresolvedUnknown(shape.canonical_name) {
        if list_type == "Unknown" {
            return SemanticExpressionGraphListCallError(
                "ast_artifact_invalid",
                SemanticError1(
                    "ast_artifact_invalid", "owner", "collection_receiver_type"
                )
            );
        }
        return SemanticExpressionGraphListCallError(
            "builtin_arg_type_mismatch",
            SemanticError3(
                "builtin_arg_type_mismatch", "func", callee,
                "expected", "List<T>", "actual", list_type
            )
        );
    }
    let element_type: String = shape.actual_type_names[0];
    let index_node: Int = protocol.index_argument_index;
    if index_node >= 0 {
        let index_type: String =
            SemanticExpressionGraphCallArgumentScalarTypeName(
                graph, call.argument_nodes[index_node], names, types
            );
        if index_type != "Int" {
            return SemanticExpressionGraphListCallError(
                "builtin_arg_type_mismatch",
                SemanticError3(
                    "builtin_arg_type_mismatch", "func", callee,
                    "expected", "Int", "actual", index_type
                )
            );
        }
    }
    if protocol.value_argument_index >= 0 {
        let value_node: Int = call.argument_nodes[protocol.value_argument_index];
        let value_type: String = SemanticExpressionGraphCallArgumentScalarTypeName(
            graph, value_node, names, types
        );
        let value_text: Option<String> = SemanticExpressionGraphNodeText(
            graph, value_node
        );
        if value_type == "Unknown" || !IsSome(value_text) {
            return SemanticExpressionGraphListCallError(
                "ast_artifact_invalid",
                SemanticError1(
                    "ast_artifact_invalid", "owner", "collection_value_type"
                )
            );
        }
        if !ExpressionAssignableTo(
            element_type, value_type, UnwrapOption(value_text)
        ) {
            return SemanticExpressionGraphListCallError(
                "call_arg_type_mismatch",
                SemanticError3(
                    "call_arg_type_mismatch", "func", callee,
                    "expected", element_type, "actual", value_type
                )
            );
        }
    }
    let return_type: String = "Void";
    if protocol.return_kind == "element" { return_type = element_type; }
    if protocol.return_kind == "Int" { return_type = "Int"; }
    return SemanticExpressionGraphListCallFact(
        true, true, "", "", return_type,
        shape.canonical_name, element_type
    );
}

func SemanticExpressionGraphListCallFactFromGraph(
    ref graph: SemanticExpressionGraphFacts,
    root_id: Int,
    ref constructors: SemanticAstNominalConstructorFacts,
    names: Array<String>,
    types: Array<String>,
    function_names: Array<String>,
    function_returns: Array<String>
) -> SemanticExpressionGraphListCallFact {
    let target: SemanticExpressionCallTargetFact =
        SemanticExpressionGraphResolvedCallTarget(
            graph, root_id, constructors, names, types,
            function_names, function_returns
        );
    return SemanticExpressionGraphListCallFactFromResolvedTarget(
        graph, root_id, target, names, types
    );
}

func SemanticResolvedCallConcreteScalarType(type_name: String) -> Bool {
    return type_name == "Bool" || type_name == "Int" ||
        type_name == "Long" || type_name == "Float" ||
        type_name == "String";
}

func SemanticExpressionGraphResolvedCallReturnTypeName(
    ref graph: SemanticExpressionGraphFacts,
    root_id: Int,
    ref constructors: SemanticAstNominalConstructorFacts,
    names: Array<String>,
    types: Array<String>,
    function_names: Array<String>,
    function_returns: Array<String>
) -> Option<String> {
    if ArrayLength(function_names) != ArrayLength(function_returns) {
        return None;
    }
    let target: SemanticExpressionCallTargetFact =
        SemanticExpressionGraphResolvedCallTarget(
            graph, root_id, constructors, names, types,
            function_names, function_returns
        );
    if !target.ok { return None; }
    let list_call: SemanticExpressionGraphListCallFact =
        SemanticExpressionGraphListCallFactFromResolvedTarget(
            graph, root_id, target, names, types
        );
    if list_call.applies {
        if !list_call.ok { return None; }
        return Some(list_call.return_type_name);
    }
    let queue_protocol: SemanticExpressionGraphCollectionCallProtocolFact =
        SemanticExpressionGraphCollectionCallProtocolFromName(target.name);
    if queue_protocol.applies && queue_protocol.family == "Queue" {
        let queue_call: SemanticExpressionGraphQueueCallFact =
            SemanticExpressionGraphQueueCallFactFromResolvedTarget(
                graph, root_id, target, names, types
            );
        if queue_call.applies {
            if !queue_call.ok { return None; }
            return Some(queue_call.return_type_name);
        }
    }
    let set_protocol: SemanticExpressionGraphCollectionCallProtocolFact =
        SemanticExpressionGraphCollectionCallProtocolFromName(target.name);
    if set_protocol.applies && set_protocol.family == "Set" {
        let set_call: SemanticExpressionGraphSetCallFact =
            SemanticExpressionGraphSetCallFactFromResolvedTarget(
                graph, root_id, target, names, types
            );
        if set_call.applies {
            if !set_call.ok { return None; }
            return Some(set_call.return_type_name);
        }
    }
    let target_index: Option<Int> = SemanticCallableIndex(
        function_names, target.name
    );
    let domain_query: SemanticAstDomainQueryProtocol =
        SemanticAstDomainQueryProtocolFromName(target.name);
    if domain_query.applies { return Some("Bool"); }
    if !IsSome(target_index) { return None; }
    let type_name: String = function_returns[UnwrapOption(target_index)];
    if type_name == "" || type_name == "Unknown" { return None; }
    return Some(type_name);
}

func SemanticExpressionGraphResolvedCallConcreteScalarTypeName(
    ref graph: SemanticExpressionGraphFacts,
    root_id: Int,
    ref constructors: SemanticAstNominalConstructorFacts,
    names: Array<String>,
    types: Array<String>,
    function_names: Array<String>,
    function_returns: Array<String>
) -> Option<String> {
    let type_name: Option<String> =
        SemanticExpressionGraphResolvedCallReturnTypeName(
            graph, root_id, constructors, names, types,
            function_names, function_returns
        );
    if !IsSome(type_name) ||
        !SemanticResolvedCallConcreteScalarType(UnwrapOption(type_name)) {
        return None;
    }
    return type_name;
}

func SemanticExpressionGraphResolvedCallTypeContractReady() -> Bool {
    let artifact: AstTreeArtifact = AstTreeArtifactFromText(
        "Program:\n  Function: Main\n    Parameters:\n    Returns: Void\n    Body:\n      Block:\n"
    );
    let constructors: SemanticAstNominalConstructorFacts =
        SemanticAstNominalConstructorFactsFromArtifact(artifact);
    let direct_cursor: Array<Int> = [0];
    let direct_fact: ParserExpressionFact = ParseExprFact(
        "ToInt(1)", 0, direct_cursor
    );
    let member_cursor: Array<Int> = [0];
    let member_fact: ParserExpressionFact = ParseExprFact(
        "box.Get()", 0, member_cursor
    );
    let list_cursor: Array<Int> = [0];
    let list_fact: ParserExpressionFact = ParseExprFact(
        "ListGet(items, 0)", 0, list_cursor
    );
    if !direct_fact.ok || direct_cursor[0] != 8 ||
        !member_fact.ok || member_cursor[0] != 9 || !list_fact.ok ||
        list_cursor[0] != 17 {
        return false;
    }
    let direct_graph: SemanticExpressionGraphFacts =
        SemanticExpressionGraphFactsFromAstRows(
            AstExpressionGraphRows(
                true, [TypedAstKindLetStmtTag()], [AstExpressionLaneAtom()],
                [direct_fact.root], direct_fact.arena
            ), [0], 1
        );
    let member_graph: SemanticExpressionGraphFacts =
        SemanticExpressionGraphFactsFromAstRows(
            AstExpressionGraphRows(
                true, [TypedAstKindLetStmtTag()], [AstExpressionLaneAtom()],
                [member_fact.root], member_fact.arena
            ), [0], 1
        );
    let list_graph: SemanticExpressionGraphFacts =
        SemanticExpressionGraphFactsFromAstRows(
            AstExpressionGraphRows(
                true, [TypedAstKindLetStmtTag()], [AstExpressionLaneAtom()],
                [list_fact.root], list_fact.arena
            ), [0], 1
        );
    let empty: Array<String> = [];
    let resolved: Option<String> =
        SemanticExpressionGraphResolvedCallReturnTypeName(
            direct_graph, direct_fact.root, constructors, empty, empty,
            ["ToInt"], ["Int"]
        );
    let member: Option<String> =
        SemanticExpressionGraphResolvedCallReturnTypeName(
            member_graph, member_fact.root, constructors, ["box"], ["Box"],
            ["Box_Get"], ["String"]
        );
    let deferred: Option<String> =
        SemanticExpressionGraphResolvedCallReturnTypeName(
            direct_graph, direct_fact.root, constructors, empty, empty,
            ["ToInt"], ["Option<Int>"]
        );
    let deferred_scalar: Option<String> =
        SemanticExpressionGraphResolvedCallConcreteScalarTypeName(
            direct_graph, direct_fact.root, constructors, empty, empty,
            ["ToInt"], ["Option<Int>"]
        );
    let list_call: SemanticExpressionGraphListCallFact =
        SemanticExpressionGraphListCallFactFromGraph(
            list_graph, list_fact.root, constructors,
            ["items"], ["List<Int>"], ["ListGet"], ["Unknown"]
        );
    let wrong_list_call: SemanticExpressionGraphListCallFact =
        SemanticExpressionGraphListCallFactFromGraph(
            list_graph, list_fact.root, constructors,
            ["items"], ["Int"], ["ListGet"], ["Unknown"]
        );
    return IsSome(resolved) && UnwrapOption(resolved) == "Int" &&
        IsSome(member) && UnwrapOption(member) == "String" &&
        IsSome(deferred) && UnwrapOption(deferred) == "Option<Int>" &&
        !IsSome(deferred_scalar) && list_call.applies && list_call.ok &&
        list_call.return_type_name == "Int" &&
        list_call.list_type_name == "List<Int>" &&
        list_call.element_type_name == "Int" &&
        wrong_list_call.applies && !wrong_list_call.ok &&
        wrong_list_call.diagnostic_code == "builtin_arg_type_mismatch";
}
