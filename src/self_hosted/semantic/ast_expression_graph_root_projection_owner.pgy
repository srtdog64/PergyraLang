// Stable node-id projection into the expression graph's three surface lanes.
import "ast_expression_graph_fact_owner.pgy";

func SemanticAstExpressionGraphRootForProjection(
    ref node_ids: Array<Int>, ref graph: SemanticExpressionGraphFacts,
    node_id: Int, lane: Int
) -> Option<Int> {
    if lane < 0 || lane > 2 { return None; }
    var low: Int = 0;
    var high: Int = ArrayLength(node_ids);
    while low < high {
        let middle: Int = low + ((high - low) / 2);
        if node_ids[middle] < node_id { low = middle + 1; }
        else { high = middle; }
    }
    if low >= ArrayLength(node_ids) || node_ids[low] != node_id { return None; }
    let root_index: Int = low * 3 + lane;
    if root_index < 0 || root_index >= ArrayLength(graph.roots) ||
        root_index >= ArrayLength(graph.has_roots) ||
        !graph.has_roots[root_index] { return None; }
    return Some(graph.roots[root_index]);
}
