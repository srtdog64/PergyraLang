// Scalar result types projected from parser-owned expression graph nodes.

import "ast_expression_graph_fact_owner.pgy";
import "ast_expression_graph_scalar_shape_owner.pgy";
import "ast_expression_graph_call_view_owner.pgy";
import "ast_expression_call_target_fact_owner.pgy";
import "ast_expression_graph_resolved_call_type_owner.pgy";
import "ast_expression_graph_receiver_type_owner.pgy";
import "callable_resolution_owner.pgy";
import "builtin_signature_owner.pgy";
import "expr_type_owner.pgy";
import "env_owner.pgy";
import "../hir/ast_text_scan_owner.pgy";

func SemanticExpressionGraphLeafScalarTypeName(
    text: String,
    names: Array<String>,
    types: Array<String>
) -> String {
    if text == "None" { return "Option<Unknown>"; }
    if IsFloatLiteral(text) { return "Float"; }
    if IsIdentText(text) {
        let bound: String = EnvLookup(names, types, text);
        if bound != "" { return bound; }
    }
    return "Unknown";
}

func SemanticExpressionGraphScalarTypeName(
    ref graph: SemanticExpressionGraphFacts,
    root_id: Int,
    ref constructors: SemanticAstNominalConstructorFacts,
    names: Array<String>,
    types: Array<String>,
    function_names: Array<String>,
    function_returns: Array<String>
) -> String {
    let kind_opt: Option<Int> = SemanticExpressionGraphNodeKind(
        graph, root_id
    );
    if !IsSome(kind_opt) { return "Unknown"; }
    let kind: Int = UnwrapOption(kind_opt);
    if kind == AstExpressionNodeIntegerLiteral() { return "Int"; }
    if kind == AstExpressionNodeLongLiteral() { return "Long"; }
    if kind == AstExpressionNodeFloatLiteral() { return "Float"; }
    if kind == AstExpressionNodeBoolLiteral() { return "Bool"; }
    if kind == AstExpressionNodeStringLiteral() { return "String"; }
    if kind == AstExpressionNodeLeaf() {
        let text: Option<String> = SemanticExpressionGraphNodeText(
            graph, root_id
        );
        if !IsSome(text) { return "Unknown"; }
        return SemanticExpressionGraphLeafScalarTypeName(
            UnwrapOption(text), names, types
        );
    }
    if kind == AstExpressionNodeMemberAccess() {
        let member_type: Option<String> =
            SemanticExpressionGraphValueReceiverTypeName(
                graph, root_id, constructors, names, types,
                function_names, function_returns
            );
        if IsSome(member_type) { return UnwrapOption(member_type); }
        return "Unknown";
    }
    if AstExpressionNodeIsCallSpine(kind) {
        let call: SemanticCallSpineView = SemanticCallSpineViewFromGraph(
            graph, root_id
        );
        if !call.ok { return "Unknown"; }
        let target_fact: SemanticExpressionCallTargetFact =
            SemanticExpressionGraphResolvedCallTarget(
                graph, root_id, constructors, names, types,
                function_names, function_returns
            );
        if !target_fact.ok { return "Unknown"; }
        let callee: String = target_fact.name;
        if callee == "None" { return "Option<Unknown>"; }
        if callee == "IsSome" || callee == "IsOk" || callee == "IsErr" {
            return "Bool";
        }
        if callee == "Some" && ArrayLength(call.argument_nodes) == 1 {
            let payload: String = SemanticExpressionGraphScalarTypeName(
                graph, call.argument_nodes[0], constructors, names, types,
                function_names, function_returns
            );
            return Concat("Option<", Concat(payload, ">"));
        }
        if callee == "Ok" && ArrayLength(call.argument_nodes) == 1 {
            let payload2: String = SemanticExpressionGraphScalarTypeName(
                graph, call.argument_nodes[0], constructors, names, types,
                function_names, function_returns
            );
            return Concat("Result<", Concat(payload2, ">"));
        }
        if callee == "Err" && ArrayLength(call.argument_nodes) == 1 {
            let error_payload: String =
                SemanticExpressionGraphScalarTypeName(
                    graph, call.argument_nodes[0], constructors,
                    names, types, function_names, function_returns
                );
            if error_payload == "Unknown" {
                return "Result<Unknown>";
            }
            return Concat(
                "Result<Unknown, ", Concat(error_payload, ">")
            );
        }
        if (callee == "UnwrapOption" || callee == "Unwrap") &&
            ArrayLength(call.argument_nodes) == 1 {
            let wrapped: String = SemanticExpressionGraphScalarTypeName(
                graph, call.argument_nodes[0], constructors, names, types,
                function_names, function_returns
            );
            if IsOptionType(wrapped) {
                return Substring(wrapped, 7, StringLength(wrapped) - 8);
            }
            let result_payload: Option<String> = ResultPayloadTypeOpt(wrapped);
            if IsSome(result_payload) { return UnwrapOption(result_payload); }
            return "Unknown";
        }
        if callee == "UnwrapErr" &&
            ArrayLength(call.argument_nodes) == 1 {
            let wrapped_error: String =
                SemanticExpressionGraphScalarTypeName(
                    graph, call.argument_nodes[0], constructors,
                    names, types, function_names, function_returns
                );
            let result_error: Option<String> =
                ResultErrorTypeOpt(wrapped_error);
            if IsSome(result_error) { return UnwrapOption(result_error); }
            return "Unknown";
        }
        if callee == "UnwrapOr" && ArrayLength(call.argument_nodes) == 2 {
            let wrapped2: String = SemanticExpressionGraphScalarTypeName(
                graph, call.argument_nodes[0], constructors, names, types,
                function_names, function_returns
            );
            let result_payload2: Option<String> = ResultPayloadTypeOpt(wrapped2);
            if IsSome(result_payload2) &&
                UnwrapOption(result_payload2) != "Unknown" {
                return UnwrapOption(result_payload2);
            }
            return SemanticExpressionGraphScalarTypeName(
                graph, call.argument_nodes[1], constructors, names, types,
                function_names, function_returns
            );
        }
        if SemanticBuiltinReturnDependsOnArguments(callee) {
            let builtin_argument_types: Array<String> = [];
            let builtin_argument_index: Int = 0;
            while builtin_argument_index < ArrayLength(call.argument_nodes) {
                ArrayPush(
                    builtin_argument_types,
                    SemanticExpressionGraphScalarTypeName(
                        graph, call.argument_nodes[builtin_argument_index],
                        constructors, names, types,
                        function_names, function_returns
                    )
                );
                builtin_argument_index = builtin_argument_index + 1;
            }
            let polymorphic_return: Option<String> =
                SemanticPolymorphicBuiltinReturnTypeOpt(
                    callee, builtin_argument_types
                );
            if IsSome(polymorphic_return) {
                return UnwrapOption(polymorphic_return);
            }
            return "Unknown";
        }
        if (callee == "DeviceRead" || callee == "SubmitDeviceRead") &&
            ArrayLength(call.argument_nodes) == 1 {
            let receiver_type: String =
                SemanticExpressionGraphScalarTypeName(
                    graph, call.argument_nodes[0], constructors, names, types,
                    function_names, function_returns
                );
            let device_payload: Option<String> =
                DeviceSlotPayloadTypeOpt(receiver_type);
            if IsSome(device_payload) {
                if callee == "DeviceRead" {
                    return UnwrapOption(device_payload);
                }
                return Concat("RemoteFuture<", Concat(
                    UnwrapOption(device_payload), ">"
                ));
            }
        }
        let resolved: Option<String> =
            SemanticExpressionGraphResolvedCallReturnTypeName(
                graph, root_id, constructors, names, types,
                function_names, function_returns
            );
        if IsSome(resolved) { return UnwrapOption(resolved); }
        return "Unknown";
    }
    if kind == AstExpressionNodeCast() {
        let target: Option<String> =
            SemanticExpressionGraphCastTargetTypeName(graph, root_id);
        let operand: Option<Int> = SemanticExpressionGraphLeftChild(
            graph, root_id
        );
        if !IsSome(target) || !IsSome(operand) ||
            !SemanticExpressionGraphNumericTypeName(UnwrapOption(target)) {
            return "Unknown";
        }
        let source: String = SemanticExpressionGraphScalarTypeName(
            graph, UnwrapOption(operand), constructors, names, types,
            function_names, function_returns
        );
        if !SemanticExpressionGraphNumericTypeName(source) {
            return "Unknown";
        }
        return UnwrapOption(target);
    }
    let left_opt: Option<Int> = SemanticExpressionGraphLeftChild(
        graph, root_id
    );
    if !IsSome(left_opt) { return "Unknown"; }
    let left: String = SemanticExpressionGraphScalarTypeName(
        graph, UnwrapOption(left_opt), constructors, names, types,
        function_names, function_returns
    );
    if kind == AstExpressionNodeLogicalNot() {
        if left == "Bool" { return "Bool"; }
        return "Unknown";
    }
    if kind == AstExpressionNodeNegate() {
        if left == "Int" || left == "Long" || left == "Float" {
            return left;
        }
        return "Unknown";
    }
    if kind == AstExpressionNodeTry() {
        let try_payload: Option<String> = TryPayloadTypeOpt(left);
        if IsSome(try_payload) { return UnwrapOption(try_payload); }
        return "Unknown";
    }
    if kind == AstExpressionNodeAwait() {
        let remote_payload: Option<String> = RemoteFuturePayloadTypeOpt(left);
        if IsSome(remote_payload) {
            return Concat("Result<", Concat(
                UnwrapOption(remote_payload), ">"
            ));
        }
        let future_payload: Option<String> = FuturePayloadTypeOpt(left);
        if IsSome(future_payload) { return UnwrapOption(future_payload); }
        return "Unknown";
    }
    if kind == AstExpressionNodeSpawn() {
        if left == "Unknown" || left == "Void" { return "Unknown"; }
        return Concat("Future<", Concat(left, ">"));
    }
    let right_opt: Option<Int> = SemanticExpressionGraphRightChild(
        graph, root_id
    );
    if !IsSome(right_opt) { return "Unknown"; }
    let right: String = SemanticExpressionGraphScalarTypeName(
        graph, UnwrapOption(right_opt), constructors, names, types,
        function_names, function_returns
    );
    if kind == AstExpressionNodeCoalesce() {
        let payload: Option<String> =
            OptionCoalescePayloadTypeOpt(left, right);
        if IsSome(payload) { return UnwrapOption(payload); }
        return "Unknown";
    }
    if kind == AstExpressionNodeLogicalAnd() ||
        kind == AstExpressionNodeLogicalOr() {
        if left == "Bool" && right == "Bool" { return "Bool"; }
        return "Unknown";
    }
    if kind == AstExpressionNodeEquality() ||
        kind == AstExpressionNodeInequality() ||
        kind == AstExpressionNodeLess() ||
        kind == AstExpressionNodeLessEqual() ||
        kind == AstExpressionNodeGreater() ||
        kind == AstExpressionNodeGreaterEqual() {
        if left != "Unknown" && left == right { return "Bool"; }
        return "Unknown";
    }
    if kind == AstExpressionNodeAdd() ||
        kind == AstExpressionNodeSubtract() ||
        kind == AstExpressionNodeMultiply() ||
        kind == AstExpressionNodeDivide() ||
        kind == AstExpressionNodeModulo() {
        if left == right && (left == "Int" || left == "Long" ||
            left == "Float" ||
            (kind == AstExpressionNodeAdd() && left == "String")) {
            return left;
        }
        return "Unknown";
    }
    if kind == AstExpressionNodeIndex() && right == "Int" &&
        StringLength(left) >= 8 &&
        StartsWith(left, "Array<") &&
        CharAt(left, StringLength(left) - 1) == ">" {
        return Substring(left, 6, StringLength(left) - 7);
    }
    return "Unknown";
}

func SemanticExpressionGraphIndexValueTypeName(
    ref graph: SemanticExpressionGraphFacts,
    root_id: Int,
    ref constructors: SemanticAstNominalConstructorFacts,
    names: Array<String>,
    types: Array<String>,
    function_names: Array<String>,
    function_returns: Array<String>
) -> Option<String> {
    let kind: Option<Int> = SemanticExpressionGraphNodeKind(graph, root_id);
    if !IsSome(kind) || UnwrapOption(kind) != AstExpressionNodeIndex() {
        return None;
    }
    let receiver: Option<Int> = SemanticExpressionGraphLeftChild(
        graph, root_id
    );
    let index: Option<Int> = SemanticExpressionGraphRightChild(
        graph, root_id
    );
    if !IsSome(receiver) || !IsSome(index) { return None; }
    let collection_type: Option<String> =
        SemanticExpressionGraphValueReceiverTypeName(
            graph, UnwrapOption(receiver), constructors, names, types,
            function_names, function_returns
        );
    if !IsSome(collection_type) { return None; }
    let element_type: Option<String> = SemanticArrayElementType(
        UnwrapOption(collection_type)
    );
    let index_type: String = SemanticExpressionGraphScalarTypeName(
        graph, UnwrapOption(index), constructors, names, types,
        function_names, function_returns
    );
    if !IsSome(element_type) || index_type != "Int" { return None; }
    return element_type;
}

func SemanticExpressionGraphScalarTypeContractReady() -> Bool {
    let artifact: AstTreeArtifact = AstTreeArtifactFromText(
        "Program:\n  Struct: Inner\n    Fields:\n      values: Array<Int>\n  Struct: Outer\n    Fields:\n      inner: Inner\n      root: Int\n  Function: Main\n    Parameters:\n    Returns: Void\n    Body:\n      Block:\n"
    );
    let constructors: SemanticAstNominalConstructorFacts =
        SemanticAstNominalConstructorFactsFromArtifact(artifact);
    let cursor: Array<Int> = [0];
    let fact: ParserExpressionFact = ParseExprFact("i + 1", 0, cursor);
    if !fact.ok || cursor[0] != 5 { return false; }
    let graph: SemanticExpressionGraphFacts =
        SemanticExpressionGraphFactsFromAstRows(
            AstExpressionGraphRows(
                true, [TypedAstKindAssignStmtTag()],
                [AstExpressionLaneAuxiliary()], [fact.root], fact.arena
            ), [0], 1
        );
    let coalesce_cursor: Array<Int> = [0];
    let coalesce_fact: ParserExpressionFact =
        ParseExprFact("value ?? 0", 0, coalesce_cursor);
    let coalesce_graph: SemanticExpressionGraphFacts = SemanticExpressionGraphFactsFromAstRows(
            AstExpressionGraphRows(true, [TypedAstKindAssignStmtTag()],
                [AstExpressionLaneAuxiliary()], [coalesce_fact.root], coalesce_fact.arena), [0], 1);
    let await_cursor: Array<Int> = [0];
    let await_fact: ParserExpressionFact = ParseExprFact(
        "await pending", 0, await_cursor
    );
    let await_graph: SemanticExpressionGraphFacts =
        SemanticExpressionGraphFactsFromAstRows(
            AstExpressionGraphRows(
                true, [TypedAstKindAssignStmtTag()],
                [AstExpressionLaneAuxiliary()], [await_fact.root],
                await_fact.arena
            ), [0], 1
        );
    let member_cursor: Array<Int> = [0];
    let member_fact: ParserExpressionFact = ParseExprFact(
        "fact.inner.values[fact.root]", 0, member_cursor
    );
    let member_graph: SemanticExpressionGraphFacts =
        SemanticExpressionGraphFactsFromAstRows(
            AstExpressionGraphRows(
                true, [TypedAstKindAssignStmtTag()],
                [AstExpressionLaneAuxiliary()], [member_fact.root],
                member_fact.arena
            ), [0], 1
        );
    let call_member_cursor: Array<Int> = [0];
    let call_member_fact: ParserExpressionFact = ParseExprFact(
        "MakeOuter().root", 0, call_member_cursor
    );
    let call_member_graph: SemanticExpressionGraphFacts =
        SemanticExpressionGraphFactsFromAstRows(
            AstExpressionGraphRows(
                true, [TypedAstKindAssignStmtTag()],
                [AstExpressionLaneAuxiliary()], [call_member_fact.root],
                call_member_fact.arena
            ), [0], 1
        );
    let indexed_member_text: String = "nodes[active[0]].root";
    let indexed_member_cursor: Array<Int> = [0];
    let indexed_member_fact: ParserExpressionFact = ParseExprFact(
        indexed_member_text, 0, indexed_member_cursor
    );
    let indexed_member_graph: SemanticExpressionGraphFacts =
        SemanticExpressionGraphFactsFromAstRows(
            AstExpressionGraphRows(
                true, [TypedAstKindAssignStmtTag()],
                [AstExpressionLaneAuxiliary()], [indexed_member_fact.root],
                indexed_member_fact.arena
            ), [0], 1
        );
    let wrapper_member_text: String = "UnwrapOption(owner).root";
    let wrapper_member_cursor: Array<Int> = [0];
    let wrapper_member_fact: ParserExpressionFact = ParseExprFact(
        wrapper_member_text, 0, wrapper_member_cursor
    );
    let wrapper_member_graph: SemanticExpressionGraphFacts =
        SemanticExpressionGraphFactsFromAstRows(
            AstExpressionGraphRows(
                true, [TypedAstKindAssignStmtTag()],
                [AstExpressionLaneAuxiliary()], [wrapper_member_fact.root],
                wrapper_member_fact.arena
            ), [0], 1
        );
    let wrapper_member: SemanticMemberAccessView =
        SemanticMemberAccessViewFromGraph(
            wrapper_member_graph, wrapper_member_fact.root
        );
    if !wrapper_member.ok { return false; }
    let wrapper_call: SemanticCallSpineView =
        SemanticCallSpineViewFromGraph(
            wrapper_member_graph, wrapper_member.receiver_node
        );
    if !wrapper_call.ok { return false; }
    let wrapper_target_kinds: Array<Int> =
        wrapper_member_graph.arena.call_target_kinds;
    let wrapper_target_names: Array<String> =
        wrapper_member_graph.arena.call_target_names;
    ArraySet(
        wrapper_target_kinds,
        wrapper_call.call_node, SemanticCallTargetDirect()
    );
    ArraySet(
        wrapper_target_names,
        wrapper_call.call_node, "UnwrapOption"
    );
    let index_text: String = "stack[(ArrayLength(stack) - 1)]";
    let index_cursor: Array<Int> = [0];
    let index_fact: ParserExpressionFact = ParseExprFact(
        index_text, 0, index_cursor
    );
    let index_graph: SemanticExpressionGraphFacts =
        SemanticExpressionGraphFactsFromAstRows(
            AstExpressionGraphRows(
                true, [TypedAstKindAssignStmtTag()],
                [AstExpressionLaneAuxiliary()], [index_fact.root],
                index_fact.arena
            ), [0], 1
        );
    let invalid_index_text: String = "stack[\"bad\"]";
    let invalid_index_cursor: Array<Int> = [0];
    let invalid_index_fact: ParserExpressionFact = ParseExprFact(
        invalid_index_text, 0, invalid_index_cursor
    );
    let invalid_index_graph: SemanticExpressionGraphFacts =
        SemanticExpressionGraphFactsFromAstRows(
            AstExpressionGraphRows(
                true, [TypedAstKindAssignStmtTag()],
                [AstExpressionLaneAuxiliary()], [invalid_index_fact.root],
                invalid_index_fact.arena
            ), [0], 1
        );
    let empty: Array<String> = [];
    let index_functions: Array<String> = ["ArrayLength"];
    let index_returns: Array<String> = ["Int"];
    let index_type: Option<String> =
        SemanticExpressionGraphIndexValueTypeName(
            index_graph, index_fact.root, constructors,
            ["stack"], ["Array<Int>"], index_functions, index_returns
        );
    let invalid_index_type: Option<String> =
        SemanticExpressionGraphIndexValueTypeName(
            invalid_index_graph, invalid_index_fact.root, constructors,
            ["stack"], ["Array<Int>"], index_functions, index_returns
        );
    return await_fact.ok && await_cursor[0] == 13 &&
        coalesce_fact.ok && coalesce_cursor[0] == 10 &&
        index_fact.ok && index_cursor[0] == StringLength(index_text) &&
        invalid_index_fact.ok && invalid_index_cursor[0] ==
            StringLength(invalid_index_text) &&
        IsSome(index_type) && UnwrapOption(index_type) == "Int" &&
        !IsSome(invalid_index_type) &&
        member_fact.ok && member_cursor[0] == 28 &&
        call_member_fact.ok && call_member_cursor[0] == 16 &&
        indexed_member_fact.ok && indexed_member_cursor[0] ==
            StringLength(indexed_member_text) &&
        wrapper_member_fact.ok && wrapper_member_cursor[0] ==
            StringLength(wrapper_member_text) &&
        SemanticExpressionGraphScalarTypeName(
            member_graph, member_fact.root, constructors,
            ["fact"], ["Outer"], empty, empty
        ) == "Int" && SemanticExpressionGraphScalarTypeName(
            call_member_graph, call_member_fact.root, constructors,
            empty, empty, ["MakeOuter"], ["Outer"]
        ) == "Int" && SemanticExpressionGraphScalarTypeName(
            indexed_member_graph, indexed_member_fact.root, constructors,
            ["nodes", "active"], ["Array<Outer>", "Array<Int>"],
            empty, empty
        ) == "Int" && SemanticExpressionGraphScalarTypeName(
            wrapper_member_graph, wrapper_member_fact.root, constructors,
            ["owner"], ["Option<Outer>"], ["UnwrapOption"], ["Unknown"]
        ) == "Int" && SemanticExpressionGraphScalarTypeName(
            graph, fact.root, constructors, ["i"], ["Int"], empty, empty
        ) == "Int" && SemanticExpressionGraphScalarTypeName(
            graph, fact.root, constructors, ["i"], ["String"], empty, empty
        ) == "Unknown" && SemanticExpressionGraphScalarTypeName(
            coalesce_graph, coalesce_fact.root, constructors,
            ["value"], ["Option<Int>"], empty, empty
        ) == "Int" && SemanticExpressionGraphScalarTypeName(
            await_graph, await_fact.root, constructors,
            ["pending"], ["RemoteFuture<Int>"], empty, empty
        ) == "Result<Int>" && SemanticExpressionGraphScalarTypeName(
            await_graph, await_fact.root, constructors,
            ["pending"], ["Future<Int>"], empty, empty
        ) == "Int";
}
