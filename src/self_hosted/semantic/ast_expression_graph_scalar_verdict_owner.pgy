// Operand diagnostics for fully graph-owned scalar operator trees.

import "ast_expression_graph_scalar_type_owner.pgy";
import "ast_expression_graph_call_view_owner.pgy";
import "diagnostic_owner.pgy";

func SemanticExpressionGraphIndexAccessErrorFromTree(
    ref graph: SemanticExpressionGraphFacts,
    root_id: Int,
    ref constructors: SemanticAstNominalConstructorFacts,
    names: Array<String>,
    types: Array<String>,
    function_names: Array<String>,
    function_returns: Array<String>
) -> String {
    let pending: Array<Int> = [root_id];
    while ArrayLength(pending) > 0 {
        let node_id: Int = pending[ArrayLength(pending) - 1];
        ArrayPop(pending);
        let kind_opt: Option<Int> = SemanticExpressionGraphNodeKind(
            graph, node_id
        );
        if !IsSome(kind_opt) {
            return SemanticError1(
                "ast_artifact_invalid", "owner", "expression_graph"
            );
        }
        let kind: Int = UnwrapOption(kind_opt);
        if AstExpressionNodeIsCallSpine(kind) {
            let call: SemanticCallSpineView =
                SemanticCallSpineViewFromGraph(graph, node_id);
            if !call.ok {
                return SemanticError1(
                    "ast_artifact_invalid", "owner", "call_spine"
                );
            }
            ArrayPush(pending, call.callee_node);
            let argument: Int = 0;
            while argument < ArrayLength(call.argument_nodes) {
                ArrayPush(pending, call.argument_nodes[argument]);
                argument = argument + 1;
            }
            continue;
        }
        if kind == AstExpressionNodeIndex() {
            let index_node: Option<Int> =
                SemanticExpressionGraphRightChild(graph, node_id);
            if !IsSome(index_node) {
                return SemanticError1(
                    "ast_artifact_invalid", "owner", "array_index"
                );
            }
            let actual: String = SemanticExpressionGraphScalarTypeName(
                graph, UnwrapOption(index_node), constructors, names, types,
                function_names, function_returns
            );
            if actual != "Int" {
                return SemanticError2(
                    "array_index_type_mismatch",
                    "expected", "Int", "actual", actual
                );
            }
        }
        let arity_opt: Option<Int> = AstExpressionNodeArityOpt(kind);
        if !IsSome(arity_opt) {
            return SemanticError1(
                "ast_artifact_invalid", "owner", "expression_graph"
            );
        }
        let arity: Int = UnwrapOption(arity_opt);
        if arity >= 1 {
            ArrayPush(
                pending, graph.arena.topology.left_children[node_id]
            );
        }
        if arity == 2 {
            ArrayPush(
                pending, graph.arena.topology.right_children[node_id]
            );
        }
    }
    return "";
}

func SemanticExpressionGraphScalarOperatorError(
    ref graph: SemanticExpressionGraphFacts,
    node_id: Int,
    ref constructors: SemanticAstNominalConstructorFacts,
    names: Array<String>,
    types: Array<String>,
    function_names: Array<String>,
    function_returns: Array<String>
) -> String {
    let kind_opt: Option<Int> = SemanticExpressionGraphNodeKind(
        graph, node_id
    );
    if !IsSome(kind_opt) || !SemanticExpressionGraphScalarOperatorKind(
        UnwrapOption(kind_opt)
    ) {
        return SemanticError1(
            "ast_artifact_invalid", "owner", "expression_graph"
        );
    }
    let kind: Int = UnwrapOption(kind_opt);
    let left_opt: Option<Int> = SemanticExpressionGraphLeftChild(
        graph, node_id
    );
    if !IsSome(left_opt) {
        return SemanticError1(
            "ast_artifact_invalid", "owner", "expression_graph"
        );
    }
    let left: String = SemanticExpressionGraphScalarTypeName(
        graph, UnwrapOption(left_opt), constructors, names, types,
        function_names, function_returns
    );
    if kind == AstExpressionNodeLogicalNot() {
        if left != "Unknown" && left != "Bool" {
            return SemanticError1(
                "not_operand_not_bool", "actual", left
            );
        }
        return "";
    }
    if AstExpressionNodeArity(kind) == 1 { return ""; }
    let right_opt: Option<Int> = SemanticExpressionGraphRightChild(
        graph, node_id
    );
    if !IsSome(right_opt) {
        return SemanticError1(
            "ast_artifact_invalid", "owner", "expression_graph"
        );
    }
    let right: String = SemanticExpressionGraphScalarTypeName(
        graph, UnwrapOption(right_opt), constructors, names, types,
        function_names, function_returns
    );
    if kind == AstExpressionNodeCoalesce() {
        let payload: Option<String> = OptionPayloadTypeOpt(left);
        if left != "Unknown" && !IsSome(payload) {
            return SemanticError2(
                "binop_type_mismatch", "left", left, "right", right
            );
        }
        if IsSome(payload) && UnwrapOption(payload) != "Unknown" &&
            right != "Unknown" && UnwrapOption(payload) != right {
            return SemanticError2(
                "binop_type_mismatch", "left", left, "right", right
            );
        }
        return "";
    }
    if kind == AstExpressionNodeLogicalAnd() ||
        kind == AstExpressionNodeLogicalOr() {
        if left != "Unknown" && left != "Bool" {
            return SemanticError2(
                "logical_operand_not_bool",
                "side", "left", "actual", left
            );
        }
        if right != "Unknown" && right != "Bool" {
            return SemanticError2(
                "logical_operand_not_bool",
                "side", "right", "actual", right
            );
        }
        return "";
    }
    if left != "Unknown" && right != "Unknown" && left != right {
        if kind == AstExpressionNodeEquality() ||
            kind == AstExpressionNodeInequality() ||
            kind == AstExpressionNodeLess() ||
            kind == AstExpressionNodeLessEqual() ||
            kind == AstExpressionNodeGreater() ||
            kind == AstExpressionNodeGreaterEqual() {
            return SemanticError2(
                "compare_type_mismatch", "left", left, "right", right
            );
        }
        if kind == AstExpressionNodeAdd() ||
            kind == AstExpressionNodeSubtract() ||
            kind == AstExpressionNodeMultiply() ||
            kind == AstExpressionNodeDivide() ||
            kind == AstExpressionNodeModulo() {
            return SemanticError2(
                "binop_type_mismatch", "left", left, "right", right
            );
        }
    }
    return "";
}

func SemanticExpressionGraphScalarOperandError(
    ref graph: SemanticExpressionGraphFacts,
    root_id: Int,
    ref constructors: SemanticAstNominalConstructorFacts,
    names: Array<String>,
    types: Array<String>,
    function_names: Array<String>,
    function_returns: Array<String>
) -> String {
    let start: Int = root_id;
    let needed: Int = 1;
    while start >= 0 && needed > 0 {
        let scan_kind_opt: Option<Int> = SemanticExpressionGraphNodeKind(
            graph, start
        );
        if !IsSome(scan_kind_opt) {
            return SemanticError1(
                "ast_artifact_invalid", "owner", "expression_graph"
            );
        }
        needed = needed - 1 + AstExpressionNodeArity(
            UnwrapOption(scan_kind_opt)
        );
        start = start - 1;
    }
    if needed != 0 {
        return SemanticError1(
            "ast_artifact_invalid", "owner", "expression_graph"
        );
    }
    start = start + 1;

    let node: Int = start;
    while node <= root_id {
        let kind_opt: Option<Int> = SemanticExpressionGraphNodeKind(
            graph, node
        );
        if !IsSome(kind_opt) {
            return SemanticError1(
                "ast_artifact_invalid", "owner", "expression_graph"
            );
        }
        let kind: Int = UnwrapOption(kind_opt);
        if AstExpressionNodeIsScalarLeaf(kind) {
            node = node + 1;
            continue;
        }
        if !SemanticExpressionGraphScalarOperatorKind(kind) {
            return SemanticError1(
                "ast_artifact_invalid", "owner", "expression_graph"
            );
        }
        let left_opt: Option<Int> = SemanticExpressionGraphLeftChild(
            graph, node
        );
        if !IsSome(left_opt) || UnwrapOption(left_opt) < start ||
            UnwrapOption(left_opt) >= node {
            return SemanticError1(
                "ast_artifact_invalid", "owner", "expression_graph"
            );
        }
        if AstExpressionNodeArity(kind) == 2 {
            let right_opt: Option<Int> = SemanticExpressionGraphRightChild(
                graph, node
            );
            if !IsSome(right_opt) || UnwrapOption(right_opt) < start ||
                UnwrapOption(right_opt) >= node {
                return SemanticError1(
                    "ast_artifact_invalid", "owner", "expression_graph"
                );
            }
        }
        let operator_error: String =
            SemanticExpressionGraphScalarOperatorError(
                graph, node, constructors, names, types,
                function_names, function_returns
            );
        if StringLength(operator_error) > 0 { return operator_error; }
        node = node + 1;
    }
    return "";
}
