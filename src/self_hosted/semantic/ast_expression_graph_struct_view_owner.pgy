// Ordered struct-literal view over parser-owned semantic expression graphs.

import "ast_expression_graph_fact_owner.pgy";
import "../hir/ast_text_scan_owner.pgy";
import "ast_expression_graph_node_view_owner.pgy";

struct SemanticStructLiteralView {
    ok: Bool;
    type_node: Int;
    root_node: Int;
    field_count: Int;
}

struct SemanticStructLiteralFieldView {
    ok: Bool;
    name_node: Int;
    value_node: Int;
}

func SemanticStructLiteralViewFromGraph(
    ref graph: SemanticExpressionGraphFacts,
    root_id: Int
) -> SemanticStructLiteralView {
    let node: Int = root_id;
    let field_count: Int = 0;
    let kind: Option<Int> = SemanticExpressionGraphNodeKind(graph, node);
    while IsSome(kind) &&
        UnwrapOption(kind) == AstExpressionNodeStructField() {
        let previous: Option<Int> = SemanticExpressionGraphLeftChild(
            graph, node
        );
        let binding: Option<Int> = SemanticExpressionGraphRightChild(
            graph, node
        );
        if !IsSome(previous) || !IsSome(binding) {
            return SemanticStructLiteralView(false, 0, root_id, 0);
        }
        let binding_id: Int = UnwrapOption(binding);
        let binding_kind: Option<Int> = SemanticExpressionGraphNodeKind(
            graph, binding_id
        );
        let name_node: Option<Int> = SemanticExpressionGraphLeftChild(
            graph, binding_id
        );
        let value_node: Option<Int> = SemanticExpressionGraphRightChild(
            graph, binding_id
        );
        if !IsSome(binding_kind) || UnwrapOption(binding_kind) !=
                AstExpressionNodeStructFieldBinding() ||
            !IsSome(name_node) || !IsSome(value_node) {
            return SemanticStructLiteralView(false, 0, root_id, 0);
        }
        let name_kind: Option<Int> = SemanticExpressionGraphNodeKind(
            graph, UnwrapOption(name_node)
        );
        let name: Option<String> = SemanticExpressionGraphNodeText(
            graph, UnwrapOption(name_node)
        );
        if !IsSome(name_kind) || UnwrapOption(name_kind) !=
                AstExpressionNodeStructFieldName() ||
            !IsSome(name) || !IsIdentifier(UnwrapOption(name)) {
            return SemanticStructLiteralView(false, 0, root_id, 0);
        }
        field_count = field_count + 1;
        node = UnwrapOption(previous);
        kind = SemanticExpressionGraphNodeKind(graph, node);
    }
    if !IsSome(kind) ||
        UnwrapOption(kind) != AstExpressionNodeStructLiteral() {
        return SemanticStructLiteralView(false, 0, root_id, 0);
    }
    let type_node: Option<Int> = SemanticExpressionGraphLeftChild(
        graph, node
    );
    if !IsSome(type_node) {
        return SemanticStructLiteralView(false, 0, root_id, 0);
    }
    return SemanticStructLiteralView(
        true, UnwrapOption(type_node), root_id, field_count
    );
}

func SemanticStructLiteralFieldAt(
    ref graph: SemanticExpressionGraphFacts,
    view: SemanticStructLiteralView,
    index: Int
) -> SemanticStructLiteralFieldView {
    if !view.ok || index < 0 || index >= view.field_count {
        return SemanticStructLiteralFieldView(false, 0, 0);
    }
    let node: Int = view.root_node;
    let remaining: Int = view.field_count - index - 1;
    while remaining > 0 {
        let kind: Option<Int> = SemanticExpressionGraphNodeKind(graph, node);
        let previous: Option<Int> = SemanticExpressionGraphLeftChild(
            graph, node
        );
        if !IsSome(kind) || UnwrapOption(kind) !=
                AstExpressionNodeStructField() || !IsSome(previous) {
            return SemanticStructLiteralFieldView(false, 0, 0);
        }
        node = UnwrapOption(previous);
        remaining = remaining - 1;
    }
    let kind: Option<Int> = SemanticExpressionGraphNodeKind(graph, node);
    let binding: Option<Int> = SemanticExpressionGraphRightChild(graph, node);
    if !IsSome(kind) || UnwrapOption(kind) !=
            AstExpressionNodeStructField() || !IsSome(binding) {
        return SemanticStructLiteralFieldView(false, 0, 0);
    }
    let binding_kind: Option<Int> = SemanticExpressionGraphNodeKind(
        graph, UnwrapOption(binding)
    );
    let name_node: Option<Int> = SemanticExpressionGraphLeftChild(
        graph, UnwrapOption(binding)
    );
    let value_node: Option<Int> = SemanticExpressionGraphRightChild(
        graph, UnwrapOption(binding)
    );
    if !IsSome(binding_kind) || UnwrapOption(binding_kind) !=
            AstExpressionNodeStructFieldBinding() ||
        !IsSome(name_node) || !IsSome(value_node) {
        return SemanticStructLiteralFieldView(false, 0, 0);
    }
    return SemanticStructLiteralFieldView(
        true, UnwrapOption(name_node), UnwrapOption(value_node)
    );
}
