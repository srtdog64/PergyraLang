// Ordered struct-literal view over parser-owned semantic expression graphs.

import "ast_expression_graph_fact_owner.pgy";
import "../hir/ast_text_scan_owner.pgy";
import "ast_expression_graph_node_view_owner.pgy";

struct SemanticStructLiteralView {
    ok: Bool;
    type_node: Int;
    root_node: Int;
    field_count: Int;
}

struct SemanticStructLiteralFieldView {
    ok: Bool;
    name_node: Int;
    value_node: Int;
}

// One allocation-free parser binding edge, shared by indexed literal reads
// and capture admission during the existing source-ordered node traversal.
func SemanticStructLiteralFieldBindingFromGraph(
    ref graph: SemanticExpressionGraphFacts, binding: Int
) -> SemanticStructLiteralFieldView {
    let invalid: SemanticStructLiteralFieldView = SemanticStructLiteralFieldView(false, -1, -1);
    let kind: Option<Int> = SemanticExpressionGraphNodeKind(graph, binding);
    let name: Option<Int> = SemanticExpressionGraphLeftChild(graph, binding);
    let value: Option<Int> = SemanticExpressionGraphRightChild(graph, binding);
    if !IsSome(kind) || UnwrapOption(kind) != AstExpressionNodeStructFieldBinding() ||
        !IsSome(name) || !IsSome(value) || UnwrapOption(name) < 0 || UnwrapOption(name) >= binding ||
        UnwrapOption(value) < 0 || UnwrapOption(value) >= binding { return invalid; }
    let name_kind: Option<Int> = SemanticExpressionGraphNodeKind(graph, UnwrapOption(name));
    let name_text: Option<String> = SemanticExpressionGraphNodeText(graph, UnwrapOption(name));
    if !IsSome(name_kind) || UnwrapOption(name_kind) != AstExpressionNodeStructFieldName() ||
        !IsSome(name_text) || !IsIdentifier(UnwrapOption(name_text)) { return invalid; }
    return SemanticStructLiteralFieldView(true, UnwrapOption(name), UnwrapOption(value));
}

func SemanticStructLiteralViewFromGraph(
    ref graph: SemanticExpressionGraphFacts,
    root_id: Int
) -> SemanticStructLiteralView {
    let node: Int = root_id;
    let field_count: Int = 0;
    let kind: Option<Int> = SemanticExpressionGraphNodeKind(graph, node);
    while IsSome(kind) &&
        UnwrapOption(kind) == AstExpressionNodeStructField() {
        let previous: Option<Int> = SemanticExpressionGraphLeftChild(
            graph, node
        );
        let binding: Option<Int> = SemanticExpressionGraphRightChild(
            graph, node
        );
        if !IsSome(previous) || !IsSome(binding) {
            return SemanticStructLiteralView(false, 0, root_id, 0);
        }
        let field: SemanticStructLiteralFieldView = SemanticStructLiteralFieldBindingFromGraph(graph, UnwrapOption(binding));
        if !field.ok {
            return SemanticStructLiteralView(false, 0, root_id, 0);
        }
        field_count = field_count + 1;
        node = UnwrapOption(previous);
        kind = SemanticExpressionGraphNodeKind(graph, node);
    }
    if !IsSome(kind) ||
        UnwrapOption(kind) != AstExpressionNodeStructLiteral() {
        return SemanticStructLiteralView(false, 0, root_id, 0);
    }
    let type_node: Option<Int> = SemanticExpressionGraphLeftChild(
        graph, node
    );
    if !IsSome(type_node) {
        return SemanticStructLiteralView(false, 0, root_id, 0);
    }
    return SemanticStructLiteralView(
        true, UnwrapOption(type_node), root_id, field_count
    );
}

func SemanticStructLiteralFieldAt(
    ref graph: SemanticExpressionGraphFacts,
    view: SemanticStructLiteralView,
    index: Int
) -> SemanticStructLiteralFieldView {
    if !view.ok || index < 0 || index >= view.field_count {
        return SemanticStructLiteralFieldView(false, 0, 0);
    }
    let node: Int = view.root_node;
    let remaining: Int = view.field_count - index - 1;
    while remaining > 0 {
        let kind: Option<Int> = SemanticExpressionGraphNodeKind(graph, node);
        let previous: Option<Int> = SemanticExpressionGraphLeftChild(
            graph, node
        );
        if !IsSome(kind) || UnwrapOption(kind) !=
                AstExpressionNodeStructField() || !IsSome(previous) {
            return SemanticStructLiteralFieldView(false, 0, 0);
        }
        node = UnwrapOption(previous);
        remaining = remaining - 1;
    }
    let kind: Option<Int> = SemanticExpressionGraphNodeKind(graph, node);
    let binding: Option<Int> = SemanticExpressionGraphRightChild(graph, node);
    if !IsSome(kind) || UnwrapOption(kind) !=
            AstExpressionNodeStructField() || !IsSome(binding) {
        return SemanticStructLiteralFieldView(false, 0, 0);
    }
    return SemanticStructLiteralFieldBindingFromGraph(graph, UnwrapOption(binding));
}
