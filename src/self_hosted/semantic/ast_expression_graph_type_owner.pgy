// Intrinsic expression result types carried by parser-owned graph nodes.

import "ast_expression_graph_fact_owner.pgy";
import "ast_expression_graph_call_view_owner.pgy";
import "ast_expression_graph_struct_view_owner.pgy";
import "env_owner.pgy";

func SemanticExpressionGraphStructLiteralTypeName(
    ref graph: SemanticExpressionGraphFacts,
    root_id: Int,
    function_names: Array<String>,
    function_returns: Array<String>
) -> Option<String> {
    if !graph.ok ||
        ArrayLength(function_names) != ArrayLength(function_returns) {
        return None;
    }
    let literal: SemanticStructLiteralView =
        SemanticStructLiteralViewFromGraph(graph, root_id);
    if !literal.ok { return None; }
    let type_kind: Option<Int> = SemanticExpressionGraphNodeKind(
        graph, literal.type_node
    );
    let type_name: Option<String> = SemanticExpressionGraphNodeText(
        graph, literal.type_node
    );
    if !IsSome(type_kind) ||
        UnwrapOption(type_kind) != AstExpressionNodeLeaf() ||
        !IsSome(type_name) || !IsIdentifier(UnwrapOption(type_name)) {
        return None;
    }
    let name: String = UnwrapOption(type_name);
    let i: Int = 0;
    while i < ArrayLength(function_names) {
        if function_names[i] == name && function_returns[i] == name {
            return Some(name);
        }
        i = i + 1;
    }
    return None;
}

func SemanticExpressionGraphIntrinsicTypeName(
    ref graph: SemanticExpressionGraphFacts,
    root_id: Int,
    function_names: Array<String>,
    function_returns: Array<String>
) -> Option<String> {
    let direct: Option<String> =
        SemanticExpressionGraphStructLiteralTypeName(
            graph, root_id, function_names, function_returns
        );
    if IsSome(direct) { return direct; }
    let call: SemanticCallSpineView = SemanticCallSpineViewFromGraph(
        graph, root_id
    );
    if !call.ok || ArrayLength(call.argument_nodes) != 1 {
        return None;
    }
    let callee_kind: Option<Int> = SemanticExpressionGraphNodeKind(
        graph, call.callee_node
    );
    let callee_text: Option<String> = SemanticExpressionGraphNodeText(
        graph, call.callee_node
    );
    if !IsSome(callee_kind) ||
        UnwrapOption(callee_kind) != AstExpressionNodeLeaf() ||
        !IsSome(callee_text) || UnwrapOption(callee_text) != "Some" {
        return None;
    }
    let payload_type: Option<String> =
        SemanticExpressionGraphStructLiteralTypeName(
            graph, call.argument_nodes[0],
            function_names, function_returns
        );
    if !IsSome(payload_type) { return None; }
    return Some(Concat("Option<", Concat(UnwrapOption(payload_type), ">")));
}

func SemanticExpressionGraphIntrinsicTypeContractReady() -> Bool {
    let kinds: Array<Int> = [
        AstExpressionNodeLeaf(), AstExpressionNodeStructLiteral()
    ];
    let texts: Array<String> = ["Pair", "Pair { }"];
    let left_children: Array<Int> = [0, 0];
    let right_children: Array<Int> = [0, 0];
    let call_targets: Array<String> = ["", ""];
    let arena: SemanticExpressionGraphArena = SemanticExpressionGraphArena(
        kinds, texts, left_children, right_children, call_targets
    );
    let roots: Array<Int> = [1];
    let has_roots: Array<Bool> = [true];
    let graph: SemanticExpressionGraphFacts = SemanticExpressionGraphFacts(
        SemanticExpressionGraphArenaReady(arena), roots, has_roots, arena
    );
    let names: Array<String> = ["Pair"];
    let returns: Array<String> = ["Pair"];
    let type_name: Option<String> = SemanticExpressionGraphIntrinsicTypeName(
        graph, 1, names, returns
    );
    let option_kinds: Array<Int> = [
        AstExpressionNodeLeaf(), AstExpressionNodeStructLiteral(),
        AstExpressionNodeLeaf(), AstExpressionNodeCall(),
        AstExpressionNodeCallArgument()
    ];
    let option_texts: Array<String> = [
        "Pair", "Pair { }", "Some", "Some()", "Some(Pair { })"
    ];
    let option_left: Array<Int> = [0, 0, 0, 2, 3];
    let option_right: Array<Int> = [0, 0, 0, 0, 1];
    let option_targets: Array<String> = ["", "", "", "Some", ""];
    let option_arena: SemanticExpressionGraphArena =
        SemanticExpressionGraphArena(
            option_kinds, option_texts, option_left, option_right,
            option_targets
        );
    let option_graph: SemanticExpressionGraphFacts =
        SemanticExpressionGraphFacts(
            SemanticExpressionGraphArenaReady(option_arena), [4], [true],
            option_arena
        );
    let option_type: Option<String> =
        SemanticExpressionGraphIntrinsicTypeName(
            option_graph, 4, names, returns
        );
    let missing: Array<String> = ["Other"];
    return IsSome(type_name) && UnwrapOption(type_name) == "Pair" &&
        IsSome(option_type) && UnwrapOption(option_type) == "Option<Pair>" &&
        !IsSome(SemanticExpressionGraphIntrinsicTypeName(
            graph, 1, missing, returns
        ));
}
