// Borrowed expression-graph view over artifact-bound surface facts.
import "ast_expression_surface_fact_owner.pgy";
import "ast_signature_fact_owner.pgy";
import "ast_intent_expression_environment_owner.pgy";
func SemanticAstExpressionSurfaceBorrowReady(
    artifact: AstTreeArtifact,
    ref facts: SemanticAstExpressionSurfaceFacts
) -> Bool {
    let count: Int = ArrayLength(facts.node_ids);
    if !facts.ok || facts.artifact_node_count != artifact.count ||
        ArrayLength(facts.function_node_ids) != count ||
        ArrayLength(facts.has_atoms) != count ||
        ArrayLength(facts.atoms) != count ||
        ArrayLength(facts.has_values) != count ||
        ArrayLength(facts.values) != count ||
        ArrayLength(facts.has_auxiliary_values) != count ||
        ArrayLength(facts.auxiliary_values) != count ||
        ArrayLength(facts.normalized_atoms) != count ||
        ArrayLength(facts.normalized_values) != count ||
        ArrayLength(facts.normalized_auxiliary_values) != count ||
        ArrayLength(facts.operator_rows) !=
            count * SemanticAstExpressionShapeWidth() ||
        !SemanticExpressionGraphFactsReady(
            facts.expression_graph, count * 3
        ) {
        return false;
    }
    let previous_node_id: Int = -1;
    let i: Int = 0;
    while i < count {
        let node_id: Int = facts.node_ids[i];
        let function_node_id: Int = facts.function_node_ids[i];
        let has_graph: Bool = facts.expression_graph.has_roots[i * 3] ||
            facts.expression_graph.has_roots[i * 3 + 1] ||
            facts.expression_graph.has_roots[i * 3 + 2];
        if node_id <= previous_node_id || node_id < 0 ||
            node_id >= artifact.count ||
            function_node_id < -1 || function_node_id >= artifact.count ||
            (function_node_id >= 0 && !TypedAstArenaNodeKindIsCallable(
                artifact.arena, function_node_id
            )) || (has_graph && function_node_id < 0 &&
                !IsSome(SemanticAstIntentExpressionOwnerNodeId(artifact, node_id))) ||
            (facts.expression_graph.has_roots[i * 3] &&
                !facts.has_atoms[i]) ||
            (facts.expression_graph.has_roots[i * 3 + 1] &&
                !facts.has_values[i]) ||
            (facts.expression_graph.has_roots[i * 3 + 2] &&
                !facts.has_auxiliary_values[i]) {
            return false;
        }
        previous_node_id = node_id;
        i = i + 1;
    }
    return true;
}
func SemanticAstExpressionFunctionNodeAt(
    ref facts: SemanticAstExpressionSurfaceFacts,
    signatures: SemanticAstFunctionSignatureFacts,
    surface_index: Int
) -> Option<Int> {
    if !facts.ok || !signatures.ok ||
        signatures.artifact_node_count != facts.artifact_node_count ||
        surface_index < 0 || surface_index >= ArrayLength(facts.node_ids) ||
        surface_index >= ArrayLength(facts.function_node_ids) {
        return None;
    }
    let function_node_id: Int = facts.function_node_ids[surface_index];
    if function_node_id < 0 || !IsSome(
        SemanticAstFunctionSignatureIndexForNode(
            signatures, function_node_id
        )
    ) {
        return None;
    }
    return Some(function_node_id);
}

func SemanticAstExpressionGraphRootForNode(
    ref facts: SemanticAstExpressionSurfaceFacts, node_id: Int, lane: Int
) -> Option<Int> {
    if !facts.ok || lane < 0 || lane > 2 { return None; }
    let low: Int = 0;
    let high: Int = ArrayLength(facts.node_ids);
    while low < high {
        let middle: Int = low + ((high - low) / 2);
        if facts.node_ids[middle] < node_id {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    if low >= ArrayLength(facts.node_ids) ||
        facts.node_ids[low] != node_id { return None; }
    let root_index: Int = low * 3 + lane;
    if root_index < 0 ||
        root_index >= ArrayLength(facts.expression_graph.roots) ||
        root_index >= ArrayLength(facts.expression_graph.has_roots) ||
        !facts.expression_graph.has_roots[root_index] { return None; }
    return Some(facts.expression_graph.roots[root_index]);
}
