// Stable semantic identities carried beside expression-graph topology.

struct SemanticExpressionIdentityRows {
    call_target_syntax_ids: Array<Int>;
    runtime_call_abi_ids: Array<Int>;
    binding_syntax_ids: Array<Int>;
    binding_kinds: Array<Int>;
    binding_ordinals: Array<Int>;
}

struct SemanticExpressionBindingIdentityFact {
    ok: Bool;
    syntax_id: Int;
    kind: Int;
    has_ordinal: Bool;
    ordinal: Int;
}

func SemanticExpressionBindingNone() -> Int { return 0; }
func SemanticExpressionBindingFormalParameter() -> Int { return 1; }
func SemanticExpressionBindingDeclaredCallable() -> Int { return 2; }
func SemanticExpressionBindingOrdinalAbsent() -> Int { return 0 - 1; }

func SemanticExpressionBindingIdentityAt(
    ref rows: SemanticExpressionIdentityRows, row: Int
) -> SemanticExpressionBindingIdentityFact {
    if row < 0 || row >= ArrayLength(rows.binding_syntax_ids) ||
        row >= ArrayLength(rows.binding_kinds) ||
        row >= ArrayLength(rows.binding_ordinals) {
        return SemanticExpressionBindingIdentityFact(
            false, 0, SemanticExpressionBindingNone(), false, 0);
    }
    let syntax_id: Int = rows.binding_syntax_ids[row];
    let kind: Int = rows.binding_kinds[row];
    let ordinal: Int = rows.binding_ordinals[row];
    if kind == SemanticExpressionBindingFormalParameter() {
        return SemanticExpressionBindingIdentityFact(
            syntax_id > 0 && ordinal >= 0,
            syntax_id, kind, true, ordinal);
    }
    if kind == SemanticExpressionBindingDeclaredCallable() {
        return SemanticExpressionBindingIdentityFact(
            syntax_id > 0 &&
                ordinal == SemanticExpressionBindingOrdinalAbsent(),
            syntax_id, kind, false, 0);
    }
    if kind == SemanticExpressionBindingNone() {
        return SemanticExpressionBindingIdentityFact(
            ordinal == SemanticExpressionBindingOrdinalAbsent(),
            syntax_id, kind, false, 0);
    }
    return SemanticExpressionBindingIdentityFact(
        false, syntax_id, kind, false, 0);
}

func SemanticExpressionBindingIdentityOrdinal(
    ref binding: SemanticExpressionBindingIdentityFact
) -> Option<Int> {
    if !binding.ok || !binding.has_ordinal { return None; }
    return Some(binding.ordinal);
}

func SemanticExpressionIdentityRowsUnknown(
    count: Int
) -> SemanticExpressionIdentityRows {
    let targets: Array<Int> = [];
    let runtime_ids: Array<Int> = [];
    let binding_ids: Array<Int> = [];
    let kinds: Array<Int> = [];
    let ordinals: Array<Int> = [];
    let row: Int = 0;
    while row < count {
        ArrayPush(targets, 0);
        ArrayPush(runtime_ids, 0);
        ArrayPush(binding_ids, 0);
        ArrayPush(kinds, SemanticExpressionBindingNone());
        ArrayPush(ordinals, SemanticExpressionBindingOrdinalAbsent());
        row = row + 1;
    }
    return SemanticExpressionIdentityRows(
        targets, runtime_ids, binding_ids, kinds, ordinals);
}

func SemanticExpressionIdentityRowsReady(
    ref rows: SemanticExpressionIdentityRows, count: Int
) -> Bool {
    if count < 0 || ArrayLength(rows.call_target_syntax_ids) != count ||
        ArrayLength(rows.runtime_call_abi_ids) != count ||
        ArrayLength(rows.binding_syntax_ids) != count ||
        ArrayLength(rows.binding_kinds) != count ||
        ArrayLength(rows.binding_ordinals) != count {
        return false;
    }
    let row: Int = 0;
    while row < count {
        let binding: SemanticExpressionBindingIdentityFact =
            SemanticExpressionBindingIdentityAt(rows, row);
        if rows.call_target_syntax_ids[row] < 0 ||
            rows.runtime_call_abi_ids[row] < 0 ||
            rows.binding_syntax_ids[row] < 0 ||
            !binding.ok {
            return false;
        }
        row = row + 1;
    }
    return true;
}

func SemanticExpressionBindingKindName(kind: Int) -> String {
    if kind == SemanticExpressionBindingNone() { return "none"; }
    if kind == SemanticExpressionBindingFormalParameter() {
        return "formal_parameter";
    }
    if kind == SemanticExpressionBindingDeclaredCallable() {
        return "declared_callable";
    }
    return "";
}
