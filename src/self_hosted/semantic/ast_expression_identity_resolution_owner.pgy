// Final semantic binding/call identities for persisted expression graphs.
import "ast_artifact_verdict_owner.pgy";
import "ast_body_expression_environment_owner.pgy";
import "ast_iteration_type_fact_owner.pgy";
import "ast_expression_function_table_fact_owner.pgy";
import "ast_signature_type_expression_fact_owner.pgy";
import "../lib/intent_observability_abi_projection_owner.pgy";
func SemanticExpressionDirectTargetSyntaxId(
    signatures: SemanticAstFunctionSignatureFacts,
    target_name: String
) -> Int {
    let found: Int = 0;
    let matches: Int = 0;
    let row: Int = 0;
    while row < SemanticAstFunctionSignatureCount(signatures) {
        let owner: Option<String> = SemanticAstFunctionOwnerNameAt(
            signatures, row
        );
        let name: Option<String> = SemanticAstFunctionNameAt(
            signatures, row
        );
        let node: Option<Int> = SemanticAstFunctionNodeAt(signatures, row);
        if !IsSome(owner) || !IsSome(name) || !IsSome(node) {
            return 0 - 1;
        }
        if SemanticCallableCanonicalDeclaredNameEquals(
            UnwrapOption(owner), UnwrapOption(name), target_name
        ) {
            matches = matches + 1;
            if matches > 1 { return 0 - 1; }
            found = UnwrapOption(node);
        }
        row = row + 1;
    }
    if matches == 0 { return 0; }
    if found <= 0 { return 0 - 1; }
    return found;
}
func SemanticExpressionFormalParameterOrdinal(
    signatures: SemanticAstFunctionSignatureFacts,
    function_node_id: Int, binding_name: String
) -> Int {
    let signature: Option<Int> = SemanticAstFunctionSignatureIndexForNode(
        signatures, function_node_id
    );
    if !IsSome(signature) { return 0 - 1; }
    let count: Option<Int> = SemanticAstFunctionParamCountAt(
        signatures, UnwrapOption(signature)
    );
    if !IsSome(count) { return 0 - 1; }
    let found: Int = 0 - 1;
    let ordinal: Int = 0;
    while ordinal < UnwrapOption(count) {
        let name: Option<String> = SemanticAstFunctionParamNameAt(
            signatures, UnwrapOption(signature), ordinal
        );
        if !IsSome(name) { return 0 - 1; }
        if UnwrapOption(name) == binding_name {
            if found >= 0 { return 0 - 1; }
            found = ordinal;
        }
        ordinal = ordinal + 1;
    }
    return found;
}
func SemanticAstAnalysisResolveExpressionIdentities(
    artifact: AstTreeArtifact,
    inout analysis: SemanticAstArtifactAnalysis,
    inferred_types: Array<String>,
    iteration_types: SemanticAstIterationTypeFacts,
    function_tables: SemanticAstExpressionFunctionTableFacts,
    require_carried_identities: Bool
) -> Bool {
    let graph: SemanticExpressionGraphFacts =
        analysis.expression_surfaces.expression_graph;
    let count: Int = SemanticExpressionGraphArenaNodeCount(graph.arena);
    if !SemanticExpressionGraphFactsReady(graph, ArrayLength(graph.roots)) ||
        !SemanticExpressionGraphPlaceKindsReady(graph) ||
        !SemanticAstExpressionFunctionTableFactsReady(function_tables) ||
        !SemanticExpressionIdentityRowsReady(graph.arena.identities, count) {
        return false;
    }
    let last_root: Int = -1;
    let root_slot: Int = 0;
    let valid: Bool = true;
    let names: Array<String> = []; let types: Array<String> = [];
    let modes: Array<String> = []; let seeded_surface: Int = -1;
    while root_slot < ArrayLength(graph.roots) && valid {
        if graph.has_roots[root_slot] {
            let root_id: Int = graph.roots[root_slot];
            let surface_index: Int = root_slot / 3;
            if surface_index < 0 || surface_index >= ArrayLength(
                analysis.expression_surfaces.node_ids
            ) || root_id <= last_root {
                valid = false;
            } else {
                let use_node_id: Int =
                    analysis.expression_surfaces.node_ids[surface_index];
                let surface_carries_identity: Bool =
                    SemanticAstExpressionGraphLaneCarriesPersistedIdentity(
                        artifact, use_node_id, root_slot % 3
                    );
                let function_node: Option<Int> =
                    SemanticAstExpressionFunctionNodeAt(
                        analysis.expression_surfaces,
                        analysis.signatures, surface_index
                    );
                let intent_node: Option<Int> =
                    SemanticAstIntentExpressionOwnerNodeId(
                        artifact, use_node_id
                    );
                if surface_index != seeded_surface {
                    SemanticAstExpressionEnvironmentReset(names, types, modes);
                    if !SemanticAstBodyExpressionEnvironmentSeed(
                        artifact, analysis, inferred_types, iteration_types,
                        function_tables, analysis.intent_signatures,
                        function_node, intent_node, use_node_id,
                        names, types, modes
                    ) {
                        valid = false;
                    } else {
                        seeded_surface = surface_index;
                    }
                }
                let node: Int = last_root + 1;
                while node <= root_id && valid {
                    let carried_call_target_syntax_id: Int =
                        graph.arena.identities.call_target_syntax_ids[node];
                    let carried_runtime_call_abi_id: Int =
                        graph.arena.identities.runtime_call_abi_ids[node];
                    let carried_binding: SemanticExpressionBindingIdentityFact =
                        SemanticExpressionBindingIdentityAt(
                            graph.arena.identities, node);
                    graph.arena.identities.call_target_syntax_ids[node] = 0;
                    graph.arena.identities.runtime_call_abi_ids[node] = 0;
                    graph.arena.identities.binding_syntax_ids[node] = 0;
                    graph.arena.identities.binding_kinds[node] =
                        SemanticExpressionBindingNone();
                    graph.arena.identities.binding_ordinals[node] =
                        SemanticExpressionBindingOrdinalAbsent();
                    if graph.arena.call_target_kinds[node] == SemanticCallTargetDirect() || graph.arena.call_target_kinds[node] == SemanticCallTargetNamespace() {
                        let target_name: String =
                            graph.arena.call_target_names[node];
                        let local_callable: SemanticAstCallableTypeShape =
                            SemanticAstCallableTypeShapeFromName(
                                EnvLookup(names, types, target_name)
                            );
                        if local_callable.ok {
                            if !IsSome(function_node) { valid = false; }
                            let parameter_ordinal: Int = -1;
                            if valid {
                                parameter_ordinal =
                                    SemanticExpressionFormalParameterOrdinal(
                                        analysis.signatures,
                                        UnwrapOption(function_node), target_name
                                    );
                                if parameter_ordinal < 0 { valid = false; }
                            }
                            let signature_index: Option<Int> = None;
                            if valid {
                                signature_index =
                                    SemanticAstFunctionSignatureIndexForNode(
                                        analysis.signatures,
                                        UnwrapOption(function_node)
                                    );
                                if !IsSome(signature_index) { valid = false; }
                            }
                            let parameter_node: Option<Int> = None;
                            if valid {
                                parameter_node = SemanticAstFunctionParamNodeAt(
                                    analysis.signatures,
                                    UnwrapOption(signature_index),
                                    parameter_ordinal
                                );
                                if !IsSome(parameter_node) ||
                                    UnwrapOption(parameter_node) <= 0 {
                                    valid = false;
                                }
                            }
                            if valid {
                                graph.arena.identities
                                    .call_target_syntax_ids[node] =
                                        UnwrapOption(parameter_node);
                            }
                        } else {
                            let target_id: Int =
                                SemanticExpressionDirectTargetSyntaxId(
                                    analysis.signatures, target_name
                                );
                            if target_id < 0 { valid = false; }
                            if target_id > 0 {
                                graph.arena.identities
                                    .call_target_syntax_ids[node] = target_id;
                            } else {
                                let observability: IntentObservabilityAbiRow =
                                    IntentObservabilityAbiRowForSource(
                                        target_name);
                                if observability.valid {
                                    graph.arena.identities
                                        .runtime_call_abi_ids[node] =
                                            observability.runtime_call_abi_id;
                                }
                            }
                        }
                    }
                    if valid &&
                        (IsSome(function_node) || IsSome(intent_node)) &&
                        graph.arena.topology.node_kinds[node] ==
                            AstExpressionNodeLeaf() {
                        let binding_name: String = graph.arena.node_texts[node];
                        let mode: String = EnvMode(names, modes, binding_name);
                        if IsSome(function_node) &&
                            (mode == "default_param" ||
                             mode == "inout_param" ||
                             mode == "own_param" || mode == "ref_param") {
                            let ordinal: Int =
                                SemanticExpressionFormalParameterOrdinal(
                                    analysis.signatures,
                                    UnwrapOption(function_node), binding_name
                                );
                            if ordinal < 0 { valid = false; }
                            if ordinal >= 0 {
                                graph.arena.identities.binding_kinds[node] =
                                    SemanticExpressionBindingFormalParameter();
                                graph.arena.identities.binding_ordinals[node] =
                                    ordinal;
                                let signature_index: Option<Int> =
                                    SemanticAstFunctionSignatureIndexForNode(
                                        analysis.signatures,
                                        UnwrapOption(function_node)
                                    );
                                if !IsSome(signature_index) {
                                    valid = false;
                                } else {
                                    let parameter_type: Option<String> =
                                        SemanticAstFunctionParamTypeAt(
                                            analysis.signatures,
                                            UnwrapOption(signature_index),
                                            ordinal
                                        );
                                    let parameter_node: Option<Int> =
                                        SemanticAstFunctionParamNodeAt(
                                            analysis.signatures,
                                            UnwrapOption(signature_index),
                                            ordinal
                                        );
                                    if !IsSome(parameter_type) ||
                                        !IsSome(parameter_node) ||
                                        UnwrapOption(parameter_node) <= 0 {
                                        valid = false;
                                    } else {
                                        graph.arena.identities
                                            .binding_syntax_ids[node] =
                                                UnwrapOption(parameter_node);
                                    }
                                }
                            }
                        }
                        if valid && graph.arena.identities.binding_kinds[node] ==
                                SemanticExpressionBindingNone() &&
                            !EnvContainsName(
                                names, graph.arena.node_texts[node]) {
                            let callable_id: Int =
                                SemanticExpressionDirectTargetSyntaxId(
                                    analysis.signatures,
                                    graph.arena.node_texts[node]
                                );
                            // Expression nodes are persisted in postorder, so
                            // a direct leaf callee is followed by its call.
                            // Consume that exact edge and the admitted target
                            // identity; do not join the local leaf spelling to
                            // a declaration name.
                            let call_node: Int = -1;
                            if node + 1 < count &&
                                graph.arena.topology.node_kinds[node + 1] ==
                                    AstExpressionNodeCall() &&
                                graph.arena.topology.left_children[node + 1] ==
                                    node &&
                                (graph.arena.call_target_kinds[node + 1] ==
                                    SemanticCallTargetDirect() ||
                                 graph.arena.call_target_kinds[node + 1] ==
                                    SemanticCallTargetNamespace()) {
                                call_node = node + 1;
                            }
                            if callable_id == 0 && call_node >= 0 {
                                let call_target_id: Int =
                                    SemanticExpressionDirectTargetSyntaxId(
                                        analysis.signatures,
                                        graph.arena.call_target_names[call_node]
                                    );
                                if call_target_id < 0 ||
                                    (require_carried_identities &&
                                     graph.arena.identities
                                         .call_target_syntax_ids[call_node] !=
                                         call_target_id) {
                                    valid = false;
                                } else if call_target_id > 0 {
                                    callable_id = call_target_id;
                                }
                            }
                            if callable_id <= 0 {
                                if callable_id < 0 { valid = false; }
                            } else if valid {
                                graph.arena.identities
                                    .binding_syntax_ids[node] = callable_id;
                                graph.arena.identities.binding_kinds[node] =
                                    SemanticExpressionBindingDeclaredCallable();
                            }
                        }
                    }
                    let resolved_binding: SemanticExpressionBindingIdentityFact =
                        SemanticExpressionBindingIdentityAt(
                            graph.arena.identities, node);
                    let carried_binding_ordinal: Option<Int> =
                        SemanticExpressionBindingIdentityOrdinal(
                            carried_binding);
                    let resolved_binding_ordinal: Option<Int> =
                        SemanticExpressionBindingIdentityOrdinal(
                            resolved_binding);
                    let binding_ordinal_mismatch: Bool =
                        IsSome(resolved_binding_ordinal) !=
                            IsSome(carried_binding_ordinal);
                    if IsSome(resolved_binding_ordinal) &&
                        IsSome(carried_binding_ordinal) &&
                        UnwrapOption(resolved_binding_ordinal) !=
                            UnwrapOption(carried_binding_ordinal) {
                        binding_ordinal_mismatch = true;
                    }
                    let binding_identity_mismatch: Bool =
                        !carried_binding.ok || !resolved_binding.ok ||
                        resolved_binding.syntax_id != carried_binding.syntax_id ||
                        resolved_binding.kind != carried_binding.kind ||
                        binding_ordinal_mismatch;
                    let carried_identity_mismatch: Bool = false;
                    if require_carried_identities && surface_carries_identity {
                        carried_identity_mismatch =
                            graph.arena.identities.call_target_syntax_ids[node] !=
                                carried_call_target_syntax_id ||
                            graph.arena.identities.runtime_call_abi_ids[node] !=
                                carried_runtime_call_abi_id ||
                            binding_identity_mismatch;
                    } else if require_carried_identities {
                        carried_identity_mismatch =
                            carried_call_target_syntax_id != 0 ||
                            carried_runtime_call_abi_id != 0 ||
                            !carried_binding.ok ||
                            carried_binding.syntax_id != 0 ||
                            carried_binding.kind !=
                                SemanticExpressionBindingNone() ||
                            IsSome(carried_binding_ordinal);
                    }
                    if carried_identity_mismatch {
                        let carried_ordinal_text: String = "none";
                        if IsSome(carried_binding_ordinal) {
                            carried_ordinal_text = ToString(
                                UnwrapOption(carried_binding_ordinal));
                        }
                        let resolved_ordinal_text: String = "none";
                        if IsSome(resolved_binding_ordinal) {
                            resolved_ordinal_text = ToString(
                                UnwrapOption(resolved_binding_ordinal));
                        }
                        let detail: String = Concat("semantic carried expression identity mismatch: node=", Concat(ToString(node), Concat(" text=", graph.arena.node_texts[node])));
                        detail = Concat(detail, Concat(
                            " call_target=", Concat(
                            ToString(carried_call_target_syntax_id), Concat(
                            "/", ToString(graph.arena.identities
                                .call_target_syntax_ids[node])))));
                        detail = Concat(detail, Concat(
                            " runtime_abi=", Concat(
                            ToString(carried_runtime_call_abi_id), Concat(
                            "/", ToString(graph.arena.identities
                                .runtime_call_abi_ids[node])))));
                        detail = Concat(detail, Concat(
                            " binding_id=", Concat(
                            ToString(carried_binding.syntax_id), Concat(
                            "/", ToString(resolved_binding.syntax_id)))));
                        detail = Concat(detail, Concat(
                            " binding_kind=", Concat(
                            ToString(carried_binding.kind), Concat(
                            "/", ToString(resolved_binding.kind)))));
                        detail = Concat(detail, Concat(
                            " binding_ordinal=", Concat(
                            carried_ordinal_text, Concat(
                            "/", resolved_ordinal_text))));
                        Log(detail);
                        valid = false;
                    }
                    node = node + 1;
                }
            }
            last_root = root_id;
        }
        root_slot = root_slot + 1;
    }
    SemanticAstExpressionEnvironmentClear(names, types, modes);
    // Hoisted foreach collections extend the arena past the last surface
    // root with synthetic binding roots that carry no call identity. Admit
    // exactly the attached synthetic ids and pin their identity rows;
    // any other uncovered node stays a hard failure.
    let tail: Int = last_root + 1;
    while valid && tail < count {
        let synthetic_found: Bool = false;
        let iteration_row: Int = 0;
        while iteration_row < SemanticAstIterationTypeCount(iteration_types) {
            if iteration_types.synthetic_graph_root_ids[iteration_row] ==
                tail {
                synthetic_found = true;
            }
            iteration_row = iteration_row + 1;
        }
        if !synthetic_found {
            valid = false;
        } else {
            let tail_binding: SemanticExpressionBindingIdentityFact =
                SemanticExpressionBindingIdentityAt(
                    graph.arena.identities, tail);
            let tail_binding_ordinal: Option<Int> =
                SemanticExpressionBindingIdentityOrdinal(tail_binding);
            if require_carried_identities &&
                (graph.arena.identities.call_target_syntax_ids[tail] != 0 ||
                 graph.arena.identities.runtime_call_abi_ids[tail] != 0 ||
                 !tail_binding.ok || tail_binding.syntax_id != 0 ||
                 tail_binding.kind !=
                    SemanticExpressionBindingNone() ||
                 IsSome(tail_binding_ordinal)) {
                valid = false;
            }
            graph.arena.identities.call_target_syntax_ids[tail] = 0;
            graph.arena.identities.runtime_call_abi_ids[tail] = 0;
            graph.arena.identities.binding_syntax_ids[tail] = 0;
            graph.arena.identities.binding_kinds[tail] =
                SemanticExpressionBindingNone();
            graph.arena.identities.binding_ordinals[tail] =
                SemanticExpressionBindingOrdinalAbsent();
            tail = tail + 1;
        }
    }
    if tail != count ||
        !SemanticExpressionIdentityRowsReady(graph.arena.identities, count) {
        valid = false;
    }
    analysis.expression_surfaces.expression_graph = graph;
    return valid;
}
