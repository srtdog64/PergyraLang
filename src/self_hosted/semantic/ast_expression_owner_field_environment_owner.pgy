// Implicit method-field bindings derived from signature and nominal facts.

import "ast_signature_fact_owner.pgy";
import "ast_nominal_constructor_fact_owner.pgy";
import "ast_nominal_constructor_lookup_owner.pgy";

func SemanticAstExpressionOwnerFieldType(
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    function_node_id: Int,
    field_name: String
) -> Option<String> {
    if field_name == "" ||
        !SemanticAstNominalConstructorRowsReady(constructors) {
        return None;
    }
    return SemanticAstExpressionOwnerFieldTypeFromAdmittedFacts(
        signatures, constructors, function_node_id, field_name);
}

// Admitted body consumers must not reopen the complete field-set proof for
// each write. The signature still selects the exact owner of this field.
func SemanticAstExpressionOwnerFieldTypeFromAdmittedFacts(
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    function_node_id: Int, field_name: String
) -> Option<String> {
    if !signatures.ok || !constructors.ok || field_name == "" { return None; }
    let signature_index: Option<Int> =
        SemanticAstFunctionSignatureIndexForNode(
            signatures, function_node_id
        );
    if !IsSome(signature_index) { return None; }
    let owner: Option<String> = SemanticAstFunctionOwnerNameAt(
        signatures, UnwrapOption(signature_index)
    );
    if !IsSome(owner) || UnwrapOption(owner) == "" { return None; }
    return SemanticAstNominalFieldType(
        constructors, UnwrapOption(owner), field_name
    );
}

// Reconstruction-free owner-field projection for a constructor fact set that
// has already crossed SemanticAstBodyAnalysisAdmissionReady.  The admitted
// body stages may call this once per expression surface without reopening the
// quadratic field-identity proof in SemanticAstNominalConstructorRowsReady.
func SemanticAstExpressionSeedOwnerFieldsFromAdmittedConstructors(
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    function_node_id: Int,
    inout names: Array<String>,
    inout types: Array<String>,
    inout modes: Array<String>
) -> Bool {
    let signature_index: Option<Int> =
        SemanticAstFunctionSignatureIndexForNode(
            signatures, function_node_id
        );
    if !IsSome(signature_index) || !constructors.ok {
        return false;
    }
    let owner: Option<String> = SemanticAstFunctionOwnerNameAt(
        signatures, UnwrapOption(signature_index)
    );
    if !IsSome(owner) { return false; }
    let owner_name: String = UnwrapOption(owner);
    if owner_name == "" { return true; }

    var constructor_index: Int = 0;
    while constructor_index < SemanticAstNominalConstructorCount(constructors) {
        if constructors.names[constructor_index] == owner_name {
            var field_index: Int = 0;
            while field_index < constructors.param_counts[constructor_index] {
                let field_name: Option<String> =
                    SemanticAstNominalConstructorFieldNameAt(
                        constructors, constructor_index, field_index
                    );
                let field_type: Option<String> =
                    SemanticAstNominalConstructorFieldTypeAt(
                        constructors, constructor_index, field_index
                    );
                if !IsSome(field_name) || !IsSome(field_type) {
                    return false;
                }
                ArrayPushOwnedString(names, UnwrapOption(field_name));
                ArrayPushOwnedString(types, UnwrapOption(field_type));
                let field_row: Int = constructors.param_starts[constructor_index] + field_index;
                if field_row < 0 || field_row >= ArrayLength(constructors.field_write_modes) { return false; }
                let write_mode: Int = constructors.field_write_modes[field_row];
                if write_mode != 0 && write_mode != 1 { return false; }
                var permission: String = "mutable_owner_field";
                if write_mode == 1 || constructors.nominal_kinds[constructor_index] == "object" ||
                    constructors.nominal_kinds[constructor_index] == "tobject" { permission = "immutable_owner_field"; }
                ArrayPushOwnedString(modes, permission);
                field_index = field_index + 1;
            }
            return true;
        }
        constructor_index = constructor_index + 1;
    }
    // Ability/role-owned methods have no nominal constructor field rows.
    // They are valid expression environments with zero implicit owner fields;
    // only a matched nominal owner contributes field bindings.
    return true;
}

func SemanticAstExpressionOwnerFieldEnvironmentContractReady() -> Bool {
    let artifact: AstTreeArtifact = AstTreeArtifactFromText(
        "Program:\n  Class: Box\n    Fields:\n      value: Int\n      limit: Long\n    Methods:\n      Function: Read\n        Parameters:\n          self\n        Returns: Int\n        Body:\n          Block:\n            Return: value\n"
    );
    let signatures: SemanticAstFunctionSignatureFacts =
        SemanticAstFunctionSignatureFactsFromArtifact(artifact);
    let constructors: SemanticAstNominalConstructorFacts =
        SemanticAstNominalConstructorFactsFromArtifact(artifact);
    let function_node: Option<Int> = SemanticAstFunctionNodeAt(signatures, 0);
    var names: Array<String> = [];
    var types: Array<String> = [];
    var modes: Array<String> = [];
    var value_type: Option<String> = None;
    var limit_type: Option<String> = None;
    if IsSome(function_node) {
        value_type = SemanticAstExpressionOwnerFieldType(
            signatures, constructors, UnwrapOption(function_node), "value"
        );
        limit_type = SemanticAstExpressionOwnerFieldType(
            signatures, constructors, UnwrapOption(function_node), "limit"
        );
    }
    var seeded: Bool = false;
    if IsSome(function_node) &&
        SemanticAstNominalConstructorRowsReady(constructors) {
        seeded = SemanticAstExpressionSeedOwnerFieldsFromAdmittedConstructors(
            signatures, constructors, UnwrapOption(function_node),
            names, types, modes
        );
    }
    return IsSome(function_node) && IsSome(value_type) &&
        IsSome(limit_type) && UnwrapOption(value_type) == "Int" &&
        UnwrapOption(limit_type) == "Long" && seeded &&
        ArrayLength(names) == 2 && names[0] == "value" &&
        names[1] == "limit" && types[0] == "Int" && types[1] == "Long" &&
        modes[0] == "mutable_owner_field" && modes[1] == "mutable_owner_field";
}
