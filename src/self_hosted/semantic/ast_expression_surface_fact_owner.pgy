// Artifact-bound expression surface rows used by later projection decisions.

import "../hir/ast_text_arena_projection_owner.pgy";
import "../lib/source_scan_owner.pgy";
import "expression_normalization_owner.pgy";
import "expression_operator_fact_owner.pgy";
import "ast_expression_graph_fact_owner.pgy";

struct SemanticAstExpressionShapeFact {
    ok: Bool;
    normalized_text: String;
    logical_index: Int;
    logical_or_index: Int;
    logical_and_index: Int;
    comparison_index: Int;
    comparison_length: Int;
    equality_index: Int;
    equality_is_not: Bool;
    additive_index: Int;
    additive_operator_code: Int;
    multiplicative_index: Int;
    arithmetic_marker_index: Int;
}

struct SemanticAstExpressionSurfaceFacts {
    ok: Bool;
    artifact_node_count: Int;
    node_ids: Array<Int>;
    has_atoms: Array<Bool>;
    atoms: Array<String>;
    has_values: Array<Bool>;
    values: Array<String>;
    has_auxiliary_values: Array<Bool>;
    auxiliary_values: Array<String>;
    normalized_atoms: Array<String>;
    normalized_values: Array<String>;
    normalized_auxiliary_values: Array<String>;
    operator_rows: Array<Int>;
    expression_graph: SemanticExpressionGraphFacts;
}

func SemanticAstExpressionAtomLane() -> Int { return 0; }
func SemanticAstExpressionValueLane() -> Int { return 1; }
func SemanticAstExpressionAuxiliaryLane() -> Int { return 2; }
func SemanticAstExpressionOperatorWidth() -> Int { return 11; }
func SemanticAstExpressionShapeWidth() -> Int { return 33; }

func SemanticAstExpressionOperatorRowsAppend(
    inout rows: Array<Int>,
    operators: SemanticTopLevelOperatorFacts,
    normalized_text: String
) -> Void {
    ArrayPush(rows, operators.logical_index);
    ArrayPush(rows, operators.logical_or_index);
    ArrayPush(rows, operators.logical_and_index);
    ArrayPush(rows, operators.comparison_index);
    ArrayPush(rows, operators.comparison_length);
    ArrayPush(rows, operators.equality_index);
    let equality_is_not: Int = 0;
    if operators.equality_is_not { equality_is_not = 1; }
    ArrayPush(rows, equality_is_not);
    ArrayPush(rows, operators.additive_index);
    let additive_operator_code: Int = -1;
    if operators.additive_index >= 0 {
        additive_operator_code = SourceByteAt(
            normalized_text, StringLength(normalized_text),
            operators.additive_index
        );
    }
    ArrayPush(rows, additive_operator_code);
    ArrayPush(rows, operators.multiplicative_index);
    ArrayPush(rows, operators.arithmetic_marker_index);
}

func SemanticAstExpressionInvalidShape() -> SemanticAstExpressionShapeFact {
    return SemanticAstExpressionShapeFact(
        false, "", -1, -1, -1, -1, 0, -1, false,
        -1, -1, -1, -1
    );
}

func SemanticAstExpressionSurfaceFactsFromArtifactMode(
    artifact: AstTreeArtifact,
    derive_condition_graph: Bool
) -> SemanticAstExpressionSurfaceFacts {
    let node_ids: Array<Int> = [];
    let has_atoms: Array<Bool> = [];
    let atoms: Array<String> = [];
    let has_values: Array<Bool> = [];
    let values: Array<String> = [];
    let has_auxiliary_values: Array<Bool> = [];
    let auxiliary_values: Array<String> = [];
    let normalized_atoms: Array<String> = [];
    let normalized_values: Array<String> = [];
    let normalized_auxiliary_values: Array<String> = [];
    let operator_rows: Array<Int> = [];
    let expression_graph: SemanticExpressionGraphFacts =
        SemanticExpressionGraphFactsEmpty();
    let ok: Bool = AstTreeArtifactReady(artifact);
    let node_id: Int = 0;
    while node_id < artifact.count && ok {
        let atom: Option<String> = TypedAstArenaAtomText(artifact.arena, node_id);
        let value: Option<String> = TypedAstArenaValueText(artifact.arena, node_id);
        let auxiliary: Option<String> = TypedAstArenaAuxValueText(
            artifact.arena, node_id
        );
        if IsSome(atom) || IsSome(value) || IsSome(auxiliary) {
            let atom_text: String = "";
            let value_text: String = "";
            let auxiliary_text: String = "";
            if IsSome(atom) { atom_text = UnwrapOption(atom); }
            if IsSome(value) { value_text = UnwrapOption(value); }
            if IsSome(auxiliary) { auxiliary_text = UnwrapOption(auxiliary); }
            let normalized_atom: String = SemanticStripOuterParens(atom_text);
            let normalized_value: String = SemanticStripOuterParens(value_text);
            let normalized_auxiliary: String =
                SemanticStripOuterParens(auxiliary_text);
            ArrayPush(node_ids, node_id);
            ArrayPush(has_atoms, IsSome(atom));
            ArrayPush(atoms, atom_text);
            ArrayPush(has_values, IsSome(value));
            ArrayPush(values, value_text);
            ArrayPush(has_auxiliary_values, IsSome(auxiliary));
            ArrayPush(auxiliary_values, auxiliary_text);
            ArrayPush(normalized_atoms, normalized_atom);
            ArrayPush(normalized_values, normalized_value);
            ArrayPush(normalized_auxiliary_values, normalized_auxiliary);
            SemanticAstExpressionOperatorRowsAppend(
                operator_rows,
                SemanticTopLevelOperatorFactsFromExpression(normalized_atom),
                normalized_atom
            );
            SemanticAstExpressionOperatorRowsAppend(
                operator_rows,
                SemanticTopLevelOperatorFactsFromExpression(normalized_value),
                normalized_value
            );
            SemanticAstExpressionOperatorRowsAppend(
                operator_rows,
                SemanticTopLevelOperatorFactsFromExpression(
                    normalized_auxiliary
                ),
                normalized_auxiliary
            );
            let condition_atom: Bool = IsSome(atom) &&
                (TypedAstArenaNodeKindIs(
                    artifact.arena, node_id, TypedAstKindIfStmtTag()
                ) || TypedAstArenaNodeKindIs(
                    artifact.arena, node_id, TypedAstKindWhileStmtTag()
                ));
            expression_graph = SemanticExpressionGraphFactsAppendLane(
                expression_graph,
                derive_condition_graph && condition_atom,
                normalized_atom
            );
            expression_graph = SemanticExpressionGraphFactsAppendLane(
                expression_graph, false, normalized_value
            );
            expression_graph = SemanticExpressionGraphFactsAppendLane(
                expression_graph, false, normalized_auxiliary
            );
        }
        node_id = node_id + 1;
    }
    return SemanticAstExpressionSurfaceFacts(
        ok, artifact.count, node_ids, has_atoms, atoms, has_values, values,
        has_auxiliary_values, auxiliary_values, normalized_atoms,
        normalized_values, normalized_auxiliary_values, operator_rows,
        expression_graph
    );
}

func SemanticAstExpressionSurfaceFactsFromArtifact(
    artifact: AstTreeArtifact
) -> SemanticAstExpressionSurfaceFacts {
    return SemanticAstExpressionSurfaceFactsFromArtifactMode(artifact, true);
}

func SemanticAstExpressionSurfaceRowsFromArtifact(
    artifact: AstTreeArtifact
) -> SemanticAstExpressionSurfaceFacts {
    return SemanticAstExpressionSurfaceFactsFromArtifactMode(artifact, false);
}

func SemanticAstExpressionSurfaceFactsFromTypedArtifact(
    artifact: AstTreeArtifact
) -> SemanticAstExpressionSurfaceFacts {
    let rows: SemanticAstExpressionSurfaceFacts =
        SemanticAstExpressionSurfaceRowsFromArtifact(artifact);
    let condition_slots: Array<Int> = [];
    let i: Int = 0;
    while i < SemanticAstExpressionSurfaceCount(rows) {
        let node_id: Int = rows.node_ids[i];
        if rows.has_atoms[i] &&
            (TypedAstArenaNodeKindIs(
                artifact.arena, node_id, TypedAstKindIfStmtTag()
            ) || TypedAstArenaNodeKindIs(
                artifact.arena, node_id, TypedAstKindWhileStmtTag()
            )) {
            ArrayPush(
                condition_slots,
                i * 3 + SemanticAstExpressionAtomLane()
            );
        }
        i = i + 1;
    }
    let graph: SemanticExpressionGraphFacts =
        SemanticExpressionGraphFactsFromAstRows(
            artifact.expression_graphs,
            condition_slots,
            SemanticAstExpressionSurfaceCount(rows) * 3
        );
    return SemanticAstExpressionSurfaceFactsWithGraph(
        artifact, rows, graph
    );
}

func SemanticAstExpressionSurfaceCount(
    facts: SemanticAstExpressionSurfaceFacts
) -> Int {
    return ArrayLength(facts.node_ids);
}

func SemanticAstExpressionSurfaceAtomAt(
    facts: SemanticAstExpressionSurfaceFacts,
    index: Int
) -> Option<String> {
    if !facts.ok || index < 0 || index >= SemanticAstExpressionSurfaceCount(facts) ||
        !facts.has_atoms[index] { return None; }
    return Some(facts.atoms[index]);
}

func SemanticAstExpressionSurfaceValueAt(
    facts: SemanticAstExpressionSurfaceFacts,
    index: Int
) -> Option<String> {
    if !facts.ok || index < 0 || index >= SemanticAstExpressionSurfaceCount(facts) ||
        !facts.has_values[index] { return None; }
    return Some(facts.values[index]);
}

func SemanticAstExpressionSurfaceAuxiliaryAt(
    facts: SemanticAstExpressionSurfaceFacts,
    index: Int
) -> Option<String> {
    if !facts.ok || index < 0 || index >= SemanticAstExpressionSurfaceCount(facts) ||
        !facts.has_auxiliary_values[index] { return None; }
    return Some(facts.auxiliary_values[index]);
}

func SemanticAstExpressionSurfaceIndexForNode(
    facts: SemanticAstExpressionSurfaceFacts,
    node_id: Int
) -> Option<Int> {
    if !facts.ok || node_id < 0 || node_id >= facts.artifact_node_count {
        return None;
    }
    let i: Int = 0;
    while i < SemanticAstExpressionSurfaceCount(facts) {
        if facts.node_ids[i] == node_id { return Some(i); }
        i = i + 1;
    }
    return None;
}

func SemanticAstExpressionShapeAt(
    facts: SemanticAstExpressionSurfaceFacts,
    index: Int,
    lane: Int
) -> SemanticAstExpressionShapeFact {
    let count: Int = SemanticAstExpressionSurfaceCount(facts);
    if !facts.ok || index < 0 || index >= count || lane < 0 || lane > 2 ||
        ArrayLength(facts.operator_rows) !=
            count * SemanticAstExpressionShapeWidth() {
        return SemanticAstExpressionInvalidShape();
    }
    let present: Bool = facts.has_atoms[index];
    let normalized: String = facts.normalized_atoms[index];
    if lane == SemanticAstExpressionValueLane() {
        present = facts.has_values[index];
        normalized = facts.normalized_values[index];
    } else if lane == SemanticAstExpressionAuxiliaryLane() {
        present = facts.has_auxiliary_values[index];
        normalized = facts.normalized_auxiliary_values[index];
    }
    if !present { return SemanticAstExpressionInvalidShape(); }
    let base: Int = index * SemanticAstExpressionShapeWidth() +
        lane * SemanticAstExpressionOperatorWidth();
    return SemanticAstExpressionShapeFact(
        true, normalized,
        facts.operator_rows[base], facts.operator_rows[base + 1],
        facts.operator_rows[base + 2], facts.operator_rows[base + 3],
        facts.operator_rows[base + 4], facts.operator_rows[base + 5],
        facts.operator_rows[base + 6] == 1,
        facts.operator_rows[base + 7], facts.operator_rows[base + 8],
        facts.operator_rows[base + 9], facts.operator_rows[base + 10]
    );
}

func SemanticAstExpressionShapeForNode(
    facts: SemanticAstExpressionSurfaceFacts,
    node_id: Int,
    lane: Int
) -> SemanticAstExpressionShapeFact {
    let index: Option<Int> = SemanticAstExpressionSurfaceIndexForNode(
        facts, node_id
    );
    if !IsSome(index) { return SemanticAstExpressionInvalidShape(); }
    return SemanticAstExpressionShapeAt(facts, UnwrapOption(index), lane);
}

func SemanticAstExpressionGraphForNode(
    facts: SemanticAstExpressionSurfaceFacts,
    node_id: Int,
    lane: Int
) -> SemanticExpressionGraphView {
    let index: Option<Int> = SemanticAstExpressionSurfaceIndexForNode(
        facts, node_id
    );
    if !IsSome(index) {
        return SemanticExpressionGraphView(false, 0, facts.expression_graph);
    }
    return SemanticExpressionGraphViewAt(
        facts.expression_graph, UnwrapOption(index), lane
    );
}

func SemanticAstExpressionSurfaceFactsWithGraph(
    artifact: AstTreeArtifact,
    facts: SemanticAstExpressionSurfaceFacts,
    graph: SemanticExpressionGraphFacts
) -> SemanticAstExpressionSurfaceFacts {
    let valid: Bool = facts.ok &&
        SemanticExpressionGraphFactsReady(
            graph, SemanticAstExpressionSurfaceCount(facts) * 3
        );
    let condition_count: Int = 0;
    let i: Int = 0;
    while i < SemanticAstExpressionSurfaceCount(facts) && valid {
        let node_id: Int = facts.node_ids[i];
        let condition_atom: Bool = facts.has_atoms[i] &&
            (TypedAstArenaNodeKindIs(
                artifact.arena, node_id, TypedAstKindIfStmtTag()
            ) || TypedAstArenaNodeKindIs(
                artifact.arena, node_id, TypedAstKindWhileStmtTag()
            ));
        let atom_view: SemanticExpressionGraphView =
            SemanticExpressionGraphViewAt(
                graph, i, SemanticAstExpressionAtomLane()
            );
        let value_view: SemanticExpressionGraphView =
            SemanticExpressionGraphViewAt(
                graph, i, SemanticAstExpressionValueLane()
            );
        let auxiliary_view: SemanticExpressionGraphView =
            SemanticExpressionGraphViewAt(
                graph, i, SemanticAstExpressionAuxiliaryLane()
            );
        if condition_atom {
            condition_count = condition_count + 1;
            let root_text: Option<String> =
                SemanticExpressionGraphNodeText(
                    graph, atom_view.root_id
                );
            if !atom_view.ok || !IsSome(root_text) ||
                UnwrapOption(root_text) != facts.normalized_atoms[i] {
                valid = false;
            }
        } else if atom_view.ok {
            valid = false;
        }
        if value_view.ok || auxiliary_view.ok {
            valid = false;
        }
        i = i + 1;
    }
    if condition_count == 0 &&
        SemanticExpressionGraphArenaNodeCount(graph.arena) != 0 {
        valid = false;
    }
    return SemanticAstExpressionSurfaceFacts(
        valid, facts.artifact_node_count, facts.node_ids,
        facts.has_atoms, facts.atoms, facts.has_values, facts.values,
        facts.has_auxiliary_values, facts.auxiliary_values,
        facts.normalized_atoms, facts.normalized_values,
        facts.normalized_auxiliary_values, facts.operator_rows, graph
    );
}

func SemanticExpressionSurfaceIdentifierByte(c: Int) -> Bool {
    return SourceByteIsAlphaNum(c) || c == SourceByteOf("_");
}

func SemanticExpressionSurfaceHasToken(text: String, token: String) -> Bool {
    let n: Int = StringLength(text);
    let m: Int = StringLength(token);
    let i: Int = 0;
    let in_string: Bool = false;
    while i < n {
        let c: Int = SourceByteAt(text, n, i);
        if in_string {
            if c == SourceByteOf("\\") { i = i + 2; continue; }
            if c == SourceByteOf("\"") { in_string = false; }
            i = i + 1;
            continue;
        }
        if c == SourceByteOf("\"") { in_string = true; i = i + 1; continue; }
        if m > 0 && i + m <= n && SubEqualsWithLen(text, n, i, m, token) {
            let before_ok: Bool = i == 0 || !SemanticExpressionSurfaceIdentifierByte(
                SourceByteAt(text, n, i - 1)
            );
            let after: Int = i + m;
            let after_ok: Bool = after >= n || !SemanticExpressionSurfaceIdentifierByte(
                SourceByteAt(text, n, after)
            );
            if before_ok && after_ok { return true; }
        }
        i = i + 1;
    }
    return false;
}

func SemanticExpressionSurfaceCalls(text: String, callee: String) -> Bool {
    let n: Int = StringLength(text);
    let needle: String = Concat(callee, "(");
    let m: Int = StringLength(needle);
    let i: Int = 0;
    let in_string: Bool = false;
    while i < n {
        let c: Int = SourceByteAt(text, n, i);
        if in_string {
            if c == SourceByteOf("\\") { i = i + 2; continue; }
            if c == SourceByteOf("\"") { in_string = false; }
            i = i + 1;
            continue;
        }
        if c == SourceByteOf("\"") { in_string = true; i = i + 1; continue; }
        if m > 0 && i + m <= n && SubEqualsWithLen(text, n, i, m, needle) &&
            (i == 0 || !SemanticExpressionSurfaceIdentifierByte(
                SourceByteAt(text, n, i - 1)
            )) { return true; }
        i = i + 1;
    }
    return false;
}

func SemanticAstExpressionSurfaceTokenPresent(
    facts: SemanticAstExpressionSurfaceFacts,
    token: String
) -> Bool {
    let i: Int = 0;
    while i < SemanticAstExpressionSurfaceCount(facts) {
        if (facts.has_atoms[i] && SemanticExpressionSurfaceHasToken(facts.atoms[i], token)) ||
            (facts.has_values[i] && SemanticExpressionSurfaceHasToken(facts.values[i], token)) ||
            (facts.has_auxiliary_values[i] && SemanticExpressionSurfaceHasToken(
                facts.auxiliary_values[i], token
            )) { return true; }
        i = i + 1;
    }
    return false;
}

func SemanticAstExpressionSurfaceCallPresent(
    facts: SemanticAstExpressionSurfaceFacts,
    callee: String
) -> Bool {
    let i: Int = 0;
    while i < SemanticAstExpressionSurfaceCount(facts) {
        if (facts.has_atoms[i] && SemanticExpressionSurfaceCalls(facts.atoms[i], callee)) ||
            (facts.has_values[i] && SemanticExpressionSurfaceCalls(facts.values[i], callee)) ||
            (facts.has_auxiliary_values[i] && SemanticExpressionSurfaceCalls(
                facts.auxiliary_values[i], callee
            )) { return true; }
        i = i + 1;
    }
    return false;
}

func SemanticAstExpressionSurfaceFactsMatchArtifact(
    artifact: AstTreeArtifact,
    facts: SemanticAstExpressionSurfaceFacts
) -> Bool {
    let rebuilt: SemanticAstExpressionSurfaceFacts =
        SemanticAstExpressionSurfaceRowsFromArtifact(artifact);
    let count: Int = SemanticAstExpressionSurfaceCount(facts);
    if !facts.ok || !rebuilt.ok || facts.artifact_node_count != artifact.count ||
        SemanticAstExpressionSurfaceCount(rebuilt) != count ||
        ArrayLength(facts.operator_rows) !=
            count * SemanticAstExpressionShapeWidth() ||
        ArrayLength(rebuilt.operator_rows) != ArrayLength(facts.operator_rows) ||
        !SemanticExpressionGraphFactsReady(
            facts.expression_graph, count * 3
        ) || !SemanticExpressionGraphFactsReady(
            rebuilt.expression_graph, count * 3
        ) {
        return false;
    }
    let i: Int = 0;
    while i < count {
        if facts.node_ids[i] != rebuilt.node_ids[i] ||
            facts.has_atoms[i] != rebuilt.has_atoms[i] ||
            facts.atoms[i] != rebuilt.atoms[i] ||
            facts.has_values[i] != rebuilt.has_values[i] ||
            facts.values[i] != rebuilt.values[i] ||
            facts.has_auxiliary_values[i] != rebuilt.has_auxiliary_values[i] ||
            facts.auxiliary_values[i] != rebuilt.auxiliary_values[i] ||
            facts.normalized_atoms[i] != rebuilt.normalized_atoms[i] ||
            facts.normalized_values[i] != rebuilt.normalized_values[i] ||
            facts.normalized_auxiliary_values[i] !=
                rebuilt.normalized_auxiliary_values[i] {
            return false;
        }
        i = i + 1;
    }
    let operator_index: Int = 0;
    while operator_index < ArrayLength(facts.operator_rows) {
        if facts.operator_rows[operator_index] !=
            rebuilt.operator_rows[operator_index] {
            return false;
        }
        operator_index = operator_index + 1;
    }
    return SemanticAstExpressionSurfaceFactsWithGraph(
        artifact, rebuilt, facts.expression_graph
    ).ok;
}

func SemanticAstExpressionSurfaceFactsContractReady() -> Bool {
    let artifact: AstTreeArtifact = AstTreeArtifactFromText(
        "Program:\n  Function: Main\n    Parameters:\n    Returns: Void\n    Body:\n      Block:\n        Let: x : String = Concat(\"None\", \"x\")\n        Log((left + right))\n        If: (ready && enabled || fallback != denied)\n          Then:\n            Block:\n              Log(\"ok\")\n"
    );
    let facts: SemanticAstExpressionSurfaceFacts =
        SemanticAstExpressionSurfaceFactsFromArtifact(artifact);
    let missing_typed_graph: SemanticAstExpressionSurfaceFacts =
        SemanticAstExpressionSurfaceFactsFromTypedArtifact(artifact);
    let additive_shape: SemanticAstExpressionShapeFact =
        SemanticAstExpressionInvalidShape();
    let logical_shape: SemanticAstExpressionShapeFact =
        SemanticAstExpressionInvalidShape();
    let logical_graph: SemanticExpressionGraphView =
        SemanticExpressionGraphView(false, 0, facts.expression_graph);
    let non_condition_graph: SemanticExpressionGraphView =
        SemanticExpressionGraphView(false, 0, facts.expression_graph);
    let i: Int = 0;
    while i < SemanticAstExpressionSurfaceCount(facts) {
        if facts.has_atoms[i] && facts.normalized_atoms[i] == "left + right" {
            additive_shape = SemanticAstExpressionShapeAt(
                facts, i, SemanticAstExpressionAtomLane()
            );
        }
        if facts.has_atoms[i] && facts.normalized_atoms[i] ==
            "ready && enabled || fallback != denied" {
            logical_shape = SemanticAstExpressionShapeAt(
                facts, i, SemanticAstExpressionAtomLane()
            );
            logical_graph = SemanticExpressionGraphViewAt(
                facts.expression_graph, i, SemanticAstExpressionAtomLane()
            );
        }
        if facts.has_values[i] && StartsWith(
            facts.normalized_values[i], "Concat("
        ) {
            non_condition_graph = SemanticExpressionGraphViewAt(
                facts.expression_graph, i, SemanticAstExpressionValueLane()
            );
        }
        i = i + 1;
    }
    let logical_root_kind: Option<Int> = SemanticExpressionGraphNodeKind(
        logical_graph.graph, logical_graph.root_id
    );
    return !missing_typed_graph.ok &&
        SemanticAstExpressionSurfaceFactsMatchArtifact(artifact, facts) &&
        SemanticAstExpressionSurfaceCallPresent(facts, "Concat") &&
        SemanticAstExpressionSurfaceTokenPresent(facts, "None") &&
        !SemanticAstExpressionSurfaceCallPresent(facts, "Substring") &&
        additive_shape.ok && additive_shape.normalized_text == "left + right" &&
        additive_shape.additive_index == 5 &&
        additive_shape.additive_operator_code == SourceByteOf("+") &&
        logical_shape.ok && logical_shape.logical_and_index == 6 &&
        logical_shape.logical_or_index == 17 &&
        logical_shape.equality_index == 29 && logical_shape.equality_is_not &&
        logical_graph.ok && IsSome(logical_root_kind) &&
        UnwrapOption(logical_root_kind) == AstExpressionNodeLogicalOr() &&
        !non_condition_graph.ok;
}
