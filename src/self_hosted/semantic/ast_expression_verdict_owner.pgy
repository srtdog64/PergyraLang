// Expression verdicts over artifact-owned payload text and environment facts.

import "expression_normalization_owner.pgy";
import "expr_type_owner.pgy";
import "expr_validation_owner.pgy";
import "ast_expression_graph_identifier_owner.pgy";
import "ast_expression_graph_type_owner.pgy";
import "ast_expression_graph_resolved_call_type_owner.pgy";
import "ast_expression_graph_generic_call_owner.pgy";
import "ast_expression_graph_concrete_scalar_verdict_owner.pgy";
import "ast_expression_graph_nominal_constructor_call_owner.pgy";
import "ast_expression_graph_domain_query_owner.pgy";
import "ast_expression_graph_scalar_type_owner.pgy";
import "ast_expression_graph_scalar_verdict_owner.pgy";
import "ast_expression_graph_struct_type_verdict_owner.pgy";
import "ast_expression_graph_array_literal_owner.pgy";
import "ast_expression_graph_set_literal_owner.pgy";
import "ast_expression_graph_wrapper_value_owner.pgy";
import "ast_expression_graph_collection_mutation_owner.pgy";
import "ast_expression_graph_call_view_owner.pgy";
import "ast_expression_graph_collection_call_protocol_owner.pgy";
import "ast_expression_graph_queue_call_owner.pgy";
import "ast_expression_graph_set_call_owner.pgy";
import "call_check_owner.pgy";
import "diagnostic_owner.pgy";
import "ast_expression_graph_node_view_owner.pgy";

struct SemanticAstExpressionVerdict {
    ok: Bool;
    diagnostic_code: String;
    diagnostic_message: String;
    normalized_text: String;
    inferred_type_name: String;
}

func SemanticAstExpressionVerdictOk(
    text: String,
    inferred: String
) -> SemanticAstExpressionVerdict {
    return SemanticAstExpressionVerdict(true, "", "", text, inferred);
}

func SemanticAstExpressionVerdictError(
    text: String,
    message: String
) -> SemanticAstExpressionVerdict {
    let code: String = "unregistered_diagnostic_code";
    let code_fact: Option<String> = SemanticDiagnosticCodeFromMessage(message);
    if IsSome(code_fact) {
        code = UnwrapOption(code_fact);
    }
    return SemanticAstExpressionVerdict(
        false,
        code,
        message,
        text,
        "Unknown"
    );
}

func SemanticAstExpressionVerdictFromPayload(
    expression: String,
    names: Array<String>,
    types: Array<String>,
    modes: Array<String>,
    function_names: Array<String>,
    function_returns: Array<String>,
    function_params: Array<String>
) -> SemanticAstExpressionVerdict {
    let text: String = SemanticStripOuterParens(expression);
    let call_error: String = CheckCall(
        text, names, types, modes,
        function_names, function_returns, function_params, false
    );
    if StringLength(call_error) > 0 {
        return SemanticAstExpressionVerdictError(text, call_error);
    }
    let undefined_error: String =
        CheckUndefinedIdentifiers(text, names, function_names);
    if StringLength(undefined_error) > 0 {
        return SemanticAstExpressionVerdictError(text, undefined_error);
    }
    let try_error: String = CheckTryOperand(
        text, names, types, function_names, function_returns
    );
    if StringLength(try_error) > 0 {
        return SemanticAstExpressionVerdictError(text, try_error);
    }
    let logical_error: String = CheckLogicalOperands(
        text, names, types, function_names, function_returns
    );
    if StringLength(logical_error) > 0 {
        return SemanticAstExpressionVerdictError(text, logical_error);
    }
    let binary_error: String = CheckBinaryOperands(
        text, names, types, function_names, function_returns
    );
    if StringLength(binary_error) > 0 {
        return SemanticAstExpressionVerdictError(text, binary_error);
    }
    return SemanticAstExpressionVerdictOk(
        text,
        ExprType(text, names, types, function_names, function_returns)
    );
}

func SemanticAstExpressionVerdictFromGraph(
    expression: String,
    ref graph: SemanticExpressionGraphFacts,
    root_id: Int,
    ref constructors: SemanticAstNominalConstructorFacts,
    signatures: SemanticAstFunctionSignatureFacts,
    names: Array<String>,
    types: Array<String>,
    modes: Array<String>,
    function_names: Array<String>,
    function_returns: Array<String>,
    function_params: Array<String>,
    member_root_names: Array<String>,
    current_function_node_id: Int
) -> SemanticAstExpressionVerdict {
    let text: String = SemanticStripOuterParens(expression);
    let domain_queries: SemanticExpressionGraphDomainQueryFact =
        SemanticExpressionGraphDomainQueryFactsFromTree(
            graph, root_id, constructors, names, types, modes,
            function_names, function_returns
        );
    if !domain_queries.ok {
        return SemanticAstExpressionVerdict(
            false, domain_queries.diagnostic_code,
            domain_queries.diagnostic_message, text, "Unknown"
        );
    }
    let index_access_error: String =
        SemanticExpressionGraphIndexAccessErrorFromTree(
            graph, root_id, constructors, names, types,
            function_names, function_returns
        );
    if StringLength(index_access_error) > 0 {
        return SemanticAstExpressionVerdictError(text, index_access_error);
    }
    let intrinsic: Option<String> =
        SemanticExpressionGraphIntrinsicTypeName(
            graph, root_id, function_names, function_returns
        );
    let array_literal_type: Option<String> =
        SemanticExpressionGraphArrayLiteralTypeName(
            graph, root_id, constructors, names, types,
            function_names, function_returns
        );
    let set_literal_type: Option<String> =
        SemanticExpressionGraphSetLiteralTypeName(
            graph, root_id, constructors, names, types,
            function_names, function_returns
        );
    let struct_type_error: String =
        SemanticExpressionGraphStructValueTypeError(
            graph, root_id, constructors, signatures, names, types,
            function_names, function_returns
        );
    if StringLength(struct_type_error) > 0 {
        return SemanticAstExpressionVerdictError(text, struct_type_error);
    }
    let graph_owned_intrinsic: Bool = IsSome(intrinsic) &&
        UnwrapOption(intrinsic) != "Option<Unknown>";
    let wrapper: SemanticExpressionGraphWrapperValueFact =
        SemanticExpressionGraphWrapperValueFactFromGraph(
            graph, root_id, constructors, names, types,
            function_names, function_returns, function_params
        );
    if wrapper.applies && !wrapper.ok {
        return SemanticAstExpressionVerdict(
            false, wrapper.diagnostic_code, wrapper.diagnostic_message,
            text, "Unknown"
        );
    }
    let list_call: SemanticExpressionGraphListCallFact =
        SemanticExpressionGraphListCallFactFromGraph(
            graph, root_id, constructors, names, types,
            function_names, function_returns
        );
    if list_call.applies && !list_call.ok {
        return SemanticAstExpressionVerdict(
            false, list_call.diagnostic_code,
            list_call.diagnostic_message, text, "Unknown"
        );
    }
    let queue_call: SemanticExpressionGraphQueueCallFact =
        SemanticExpressionGraphQueueCallNotApplicable();
    let call_view: SemanticCallSpineView = SemanticCallSpineViewFromGraph(
        graph, root_id
    );
    if call_view.ok {
        let callee_text: Option<String> = SemanticExpressionGraphNodeText(
            graph, call_view.callee_node
        );
        if IsSome(callee_text) {
            let queue_protocol: SemanticExpressionGraphCollectionCallProtocolFact =
                SemanticExpressionGraphCollectionCallProtocolFromName(
                    UnwrapOption(callee_text)
                );
            if queue_protocol.applies && queue_protocol.family == "Queue" {
            queue_call = SemanticExpressionGraphQueueCallFactFromGraph(
                graph, root_id, constructors, names, types,
                function_names, function_returns
            );
            }
        }
    }
    if queue_call.applies && !queue_call.ok {
        return SemanticAstExpressionVerdict(
            false, queue_call.diagnostic_code,
            queue_call.diagnostic_message, text, "Unknown"
        );
    }
    let set_call: SemanticExpressionGraphSetCallFact =
        SemanticExpressionGraphSetCallNotApplicable();
    if call_view.ok {
        let callee_text: Option<String> = SemanticExpressionGraphNodeText(
            graph, call_view.callee_node
        );
        if IsSome(callee_text) {
            let set_protocol: SemanticExpressionGraphCollectionCallProtocolFact =
                SemanticExpressionGraphCollectionCallProtocolFromName(
                    UnwrapOption(callee_text)
                );
            if set_protocol.applies && set_protocol.family == "Set" {
            set_call = SemanticExpressionGraphSetCallFactFromGraph(
                graph, root_id, constructors, names, types,
                function_names, function_returns
            );
            }
        }
    }
    if set_call.applies && !set_call.ok {
        return SemanticAstExpressionVerdict(
            false, set_call.diagnostic_code,
            set_call.diagnostic_message, text, "Unknown"
        );
    }
    let collection_mutation: SemanticExpressionGraphCollectionMutationFact =
        SemanticExpressionGraphCollectionMutationFactFromGraph(
            graph, root_id, names, types, modes,
            SemanticCompilerRetireArrayStorageCallerReady(
                signatures, current_function_node_id
            )
        );
    if collection_mutation.applies && !collection_mutation.ok {
        return SemanticAstExpressionVerdict(
            false, collection_mutation.diagnostic_code,
            collection_mutation.diagnostic_message, text, "Unknown"
        );
    }
    let resolved_call_type: Option<String> =
        SemanticExpressionGraphResolvedCallReturnTypeName(
            graph, root_id, constructors, names, types,
            function_names, function_returns
        );
    let nominal_constructor_call:
        SemanticExpressionGraphNominalConstructorCallFact =
        SemanticExpressionGraphNominalConstructorCallFactFromGraph(
            graph, root_id, constructors, names, types,
            function_names, function_returns
        );
    if nominal_constructor_call.applies && !nominal_constructor_call.ok {
        return SemanticAstExpressionVerdict(
            false, nominal_constructor_call.diagnostic_code,
            nominal_constructor_call.diagnostic_message, text, "Unknown"
        );
    }
    let generic_call: SemanticExpressionGraphGenericCallFact =
        SemanticExpressionGraphGenericCallFactFromGraph(
            graph, root_id, signatures, constructors, names, types,
            function_names, function_returns
        );
    let generic_spawn: SemanticExpressionGraphGenericCallFact =
        SemanticExpressionGraphGenericSpawnFactFromGraph(
            graph, root_id, signatures, constructors, names, types,
            function_names, function_returns
        );
    let generic_value: SemanticExpressionGraphGenericCallFact = generic_call;
    if generic_spawn.applies { generic_value = generic_spawn; }
    if generic_value.applies && !generic_value.ok {
        return SemanticAstExpressionVerdict(
            false, generic_value.diagnostic_code,
            generic_value.diagnostic_message, text, "Unknown"
        );
    }
    let concrete_scalar_value_owned: Bool =
        SemanticExpressionGraphConcreteScalarValueOwned(
            graph, root_id, constructors, signatures, names, types,
            function_names,
            function_returns, function_params
        );
    let contextual_call_arguments_owned: Bool =
        SemanticExpressionGraphContextualCallArgumentsOwned(
            graph, root_id, constructors, signatures, names, types,
            function_names,
            function_returns, function_params
        );
    let graph_call_value_owned: Bool = concrete_scalar_value_owned ||
        contextual_call_arguments_owned;
    let resolved_member_call_arguments_owned: Bool =
        SemanticExpressionGraphResolvedMemberCallArgumentsOwned(
            graph, root_id, constructors, signatures, names, types,
            function_names,
            function_returns, function_params
        );
    let call_error: String = "";
    if graph_call_value_owned && !generic_value.applies {
        call_error = SemanticExpressionGraphConcreteScalarValueError(
            graph, root_id, constructors, signatures, names, types,
            function_names, function_returns, function_params
        );
    } else if resolved_member_call_arguments_owned &&
        !graph_owned_intrinsic && !generic_value.applies &&
        !wrapper.applies && !nominal_constructor_call.applies &&
        !domain_queries.applies {
        call_error = SemanticExpressionGraphConcreteScalarValueError(
            graph, root_id, constructors, signatures, names, types,
            function_names, function_returns, function_params
        );
    } else if !graph_owned_intrinsic && !generic_value.applies &&
        !wrapper.applies && !nominal_constructor_call.applies &&
        !domain_queries.applies {
        call_error = CheckCallFromGraphIdentifiers(
            text, names, types, modes,
            function_names, function_returns, function_params
        );
    }
    if StringLength(call_error) > 0 {
        return SemanticAstExpressionVerdictError(text, call_error);
    }
    let identifier_fact: SemanticExpressionGraphIdentifierFact =
        SemanticExpressionGraphIdentifierEvidenceWithSymbolicNodes(
            graph, root_id, names, function_names, member_root_names,
            domain_queries.symbolic_identifier_nodes
        );
    if !identifier_fact.ok {
        return SemanticAstExpressionVerdictError(
            text, SemanticError1(
                "ast_artifact_invalid", "owner", "expression_graph"
            )
        );
    }
    if identifier_fact.has_undefined {
        return SemanticAstExpressionVerdictError(
            text, SemanticError1(
                "undefined_symbol", "name", identifier_fact.name
            )
        );
    }
    let try_error: String = CheckTryOperand(
        text, names, types, function_names, function_returns
    );
    if StringLength(try_error) > 0 {
        return SemanticAstExpressionVerdictError(text, try_error);
    }
    let root_kind: Option<Int> = SemanticExpressionGraphNodeKind(
        graph, root_id
    );
    let scalar_operator_owned: Bool = concrete_scalar_value_owned &&
        IsSome(root_kind) && SemanticExpressionGraphScalarOperatorKind(
            UnwrapOption(root_kind)
        );
    let scalar_leaf_owned: Bool = IsSome(root_kind) &&
        AstExpressionNodeIsScalarLeaf(UnwrapOption(root_kind));
    let scalar_cast_owned: Bool = concrete_scalar_value_owned &&
        IsSome(root_kind) &&
        UnwrapOption(root_kind) == AstExpressionNodeCast();
    let member_value_owned: Bool = IsSome(root_kind) &&
        UnwrapOption(root_kind) == AstExpressionNodeMemberAccess();
    let index_value_owned: Bool = IsSome(root_kind) &&
        UnwrapOption(root_kind) == AstExpressionNodeIndex();
    let index_value_type: Option<String> = None;
    if index_value_owned {
        index_value_type = SemanticExpressionGraphIndexValueTypeName(
            graph, root_id, constructors, names, types,
            function_names, function_returns
        );
    }
    let operand_error: String = "";
    if !graph_call_value_owned && !index_value_owned {
        operand_error = CheckLogicalOperands(
            text, names, types, function_names, function_returns
        );
        if StringLength(operand_error) == 0 {
            operand_error = CheckBinaryOperands(
                text, names, types, function_names, function_returns
            );
        }
    }
    if StringLength(operand_error) > 0 {
        return SemanticAstExpressionVerdictError(text, operand_error);
    }
    let inferred: String = "Unknown";
    if IsSome(array_literal_type) {
        inferred = UnwrapOption(array_literal_type);
    } else if IsSome(set_literal_type) {
        inferred = UnwrapOption(set_literal_type);
    } else if wrapper.applies {
        inferred = wrapper.type_name;
    } else if generic_value.applies {
        inferred = generic_value.return_type_name;
    } else if nominal_constructor_call.applies {
        inferred = nominal_constructor_call.return_type_name;
    } else if graph_owned_intrinsic {
        inferred = UnwrapOption(intrinsic);
    } else if index_value_owned {
        if IsSome(index_value_type) {
            inferred = UnwrapOption(index_value_type);
        }
    } else if scalar_operator_owned || scalar_leaf_owned ||
        scalar_cast_owned {
        inferred = SemanticExpressionGraphScalarTypeName(
            graph, root_id, constructors, names, types,
            function_names, function_returns
        );
    } else if member_value_owned {
        inferred = SemanticExpressionGraphScalarTypeName(
            graph, root_id, constructors, names, types,
            function_names, function_returns
        );
    } else if IsSome(resolved_call_type) {
        inferred = UnwrapOption(resolved_call_type);
    } else {
        inferred = ExprType(
            text, names, types, function_names, function_returns
        );
        if inferred == "Unknown" || inferred == "" ||
            inferred == "Option<Unknown>" {
            if IsSome(intrinsic) { inferred = UnwrapOption(intrinsic); }
        }
    }
    return SemanticAstExpressionVerdictOk(text, inferred);
}

func SemanticAstExpressionVerdictContractReady() -> Bool {
    let names: Array<String> = ["x"];
    let types: Array<String> = ["Int"];
    let modes: Array<String> = ["local"];
    let function_names: Array<String> = ["F"];
    let function_returns: Array<String> = ["Int"];
    let function_params: Array<String> = ["Int"];
    let valid: SemanticAstExpressionVerdict =
        SemanticAstExpressionVerdictFromPayload(
            "(x + 1)", names, types, modes,
            function_names, function_returns, function_params
        );
    let undefined: SemanticAstExpressionVerdict =
        SemanticAstExpressionVerdictFromPayload(
            "missing", names, types, modes,
            function_names, function_returns, function_params
        );
    let bad_call: SemanticAstExpressionVerdict =
        SemanticAstExpressionVerdictFromPayload(
            "F(\"bad\")", names, types, modes,
            function_names, function_returns, function_params
        );
    let unknown: SemanticAstExpressionVerdict =
        SemanticAstExpressionVerdictError("x", "unstructured failure");
    return valid.ok && valid.inferred_type_name == "Int" &&
        !undefined.ok && undefined.diagnostic_code == "undefined_symbol" &&
        !bad_call.ok && bad_call.diagnostic_code == "call_arg_type_mismatch" &&
        !unknown.ok &&
        unknown.diagnostic_code == "unregistered_diagnostic_code" &&
        SemanticExpressionGraphIdentifierContractReady();
}
