// Aggregate storage admission for affine handles: Future/RemoteFuture
// completion handles, and the single-owner runtime handles (TextBuilder,
// Allocator, Box, Rc, Weak) and anchored resource handles (Slot, SecureSlot,
// DeviceSlot) that name one runtime storage.
//
// A direct binding remains the handle's owner. This owner rejects only value
// shapes that would copy or extract a handle through physical storage before
// MIR or either backend can publish an artifact. A Some(handle) payload
// compiled into a use-after-free on the native route before the runtime
// family was admitted here. The native twin is type_checker_future_lifecycle.c.

import "ast_body_verdict_owner.pgy";
import "ast_signature_fact_owner.pgy";
import "ast_nominal_constructor_fact_owner.pgy";
import "ast_local_binding_fact_owner.pgy";
import "ast_initializer_type_fact_owner.pgy";
import "ast_enum_fact_owner.pgy";
import "ast_type_name_canonical_owner.pgy";
import "wrapper_type_owner.pgy";
import "ast_nominal_constructor_lookup_owner.pgy";

func SemanticFutureStorageConstructor(name: String) -> Bool {
    return name == "Array" || name == "List" || name == "Queue" ||
        name == "Set" || name == "HashMap" || name == "Option" ||
        name == "Result" || name == "Box" || name == "Rc" ||
        name == "Channel" || name == "Slot" || name == "Tuple";
}

// Family 0: completion handles. Family 1: single-owner runtime and anchored
// resource handles; a source declaration named Box owns that spelling.
func SemanticAffineStorageFamilyCompletion() -> Int { return 0; }
func SemanticAffineStorageFamilyRuntimeHandle() -> Int { return 1; }
// The anchored subset of family 1, used only to name the refusal.
func SemanticAffineStorageFamilyAnchoredHandle() -> Int { return 2; }

// A channel transfers an own runtime or anchored handle under its transport
// contract, so for those families a Channel is a transfer, not storage.
func SemanticAffineStorageConstructor(name: String, family: Int) -> Bool {
    if family != SemanticAffineStorageFamilyCompletion() && name == "Channel" { return false; }
    return SemanticFutureStorageConstructor(name);
}

func SemanticAffineStorageLeaf(canonical: String, family: Int, box_builtin: Bool) -> Bool {
    if family == SemanticAffineStorageFamilyCompletion() {
        return IsSome(FuturePayloadTypeOpt(canonical)) || IsRemoteFutureType(canonical);
    }
    let anchored: Bool = StartsWith(canonical, "Slot<") || StartsWith(canonical, "SecureSlot<") ||
        StartsWith(canonical, "DeviceSlot<");
    if family == SemanticAffineStorageFamilyAnchoredHandle() { return anchored; }
    if anchored || canonical == "TextBuilder" || canonical == "Allocator" { return true; }
    if StartsWith(canonical, "Rc<") || StartsWith(canonical, "Weak<") { return true; }
    return box_builtin && StartsWith(canonical, "Box<");
}

func SemanticFutureStorageTypeContainsHandle(
    type_name: String,
    depth: Int,
    family: Int,
    box_builtin: Bool
) -> Bool {
    let canonical: String = SemanticCanonicalTypeName(type_name);
    if SemanticAffineStorageLeaf(canonical, family, box_builtin) {
        return true;
    }
    // Deeply nested storage is not admitted on an unbounded best-effort walk.
    if depth >= 32 { return true; }
    let shape: SemanticConstructedTypeNameFact =
        SemanticConstructedTypeNameFactFrom(canonical);
    if !shape.ok || !SemanticAffineStorageConstructor(shape.nominal_base_name, family) {
        return false;
    }
    let index: Int = 0;
    while index < ArrayLength(shape.actual_type_names) {
        if SemanticFutureStorageTypeContainsHandle(
            shape.actual_type_names[index], depth + 1, family, box_builtin
        ) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

func SemanticFutureAggregateStorageContainsHandle(
    type_name: String,
    family: Int,
    box_builtin: Bool
) -> Bool {
    let shape: SemanticConstructedTypeNameFact =
        SemanticConstructedTypeNameFactFrom(type_name);
    if !shape.ok || !SemanticAffineStorageConstructor(shape.nominal_base_name, family) {
        return false;
    }
    let index: Int = 0;
    while index < ArrayLength(shape.actual_type_names) {
        if SemanticFutureStorageTypeContainsHandle(
            shape.actual_type_names[index], 1, family, box_builtin
        ) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

func SemanticFutureStorageRejected(
    type_name: String,
    boundary: String,
    node_id: Int
) -> SemanticAstBodyVerdict {
    return SemanticAstBodyVerdictError(
        "task_lifecycle_invalid",
        SemanticError1(
            "task_lifecycle_invalid", "boundary",
            Concat(boundary, Concat(": ", type_name))
        ),
        node_id
    );
}

func SemanticRuntimeHandleStorageRejected(
    type_name: String,
    anchored: Bool,
    boundary: String,
    node_id: Int
) -> SemanticAstBodyVerdict {
    let code: String = "single_owner_handle_copy";
    if anchored { code = "anchored_handle_copy"; }
    return SemanticAstBodyVerdictError(
        code, SemanticError2(code, "type", type_name, "boundary", boundary), node_id);
}

// The first containing family decides the refusal; completion handles first.
func SemanticAffineStorageShapeVerdict(
    type_name: String,
    whole_value: Bool,
    box_builtin: Bool,
    boundary: String,
    node_id: Int
) -> SemanticAstBodyVerdict {
    let family: Int = SemanticAffineStorageFamilyCompletion();
    while family <= SemanticAffineStorageFamilyRuntimeHandle() {
        let contains: Bool = false;
        if whole_value {
            contains = SemanticFutureStorageTypeContainsHandle(type_name, 0, family, box_builtin);
        } else {
            contains = SemanticFutureAggregateStorageContainsHandle(type_name, family, box_builtin);
        }
        if contains {
            if family == SemanticAffineStorageFamilyCompletion() {
                return SemanticFutureStorageRejected(
                    type_name, Concat(boundary, " stores an affine task handle"), node_id);
            }
            let anchored: Bool = false;
            if whole_value {
                anchored = SemanticFutureStorageTypeContainsHandle(
                    type_name, 0, SemanticAffineStorageFamilyAnchoredHandle(), box_builtin);
            } else {
                anchored = SemanticFutureAggregateStorageContainsHandle(
                    type_name, SemanticAffineStorageFamilyAnchoredHandle(), box_builtin);
            }
            return SemanticRuntimeHandleStorageRejected(
                type_name, anchored, Concat(boundary, " stores a single-owner or anchored handle"), node_id);
        }
        family = family + 1;
    }
    return SemanticAstBodyVerdictOk();
}

func SemanticAstFutureStorageAdmissionFromFacts(
    artifact: AstTreeArtifact,
    signatures: SemanticAstFunctionSignatureFacts,
    constructors: SemanticAstNominalConstructorFacts,
    locals: SemanticAstLocalBindingFacts,
    initializers: SemanticAstInitializerTypeFacts,
    enums: SemanticAstEnumFacts
) -> SemanticAstBodyVerdict {
    if !SemanticAstSignatureRowsAdmittedReady(artifact, signatures) ||
        !constructors.ok || constructors.artifact_node_count != artifact.count ||
        !SemanticAstInitializerTypeFactsReadyProjection(
            artifact, locals, initializers
        ) || !SemanticAstEnumRowsReady(enums) ||
        enums.artifact_node_count != artifact.count {
        return SemanticAstBodyVerdictError(
            "ast_artifact_invalid",
            "Future storage admission requires admitted type facts", -1
        );
    }

    let box_builtin: Bool = !IsSome(SemanticAstNominalConstructorIndexForName(constructors, "Box"));

    // Nominal fields and enum payloads are physical storage boundaries even
    // when no value is constructed in this source file.
    let index: Int = 0;
    while index < ArrayLength(constructors.param_type_names) {
        let node_id: Int = -1;
        if index < ArrayLength(constructors.field_source_syntax_ids) {
            node_id = constructors.field_source_syntax_ids[index];
        }
        let verdict: SemanticAstBodyVerdict = SemanticAffineStorageShapeVerdict(
            constructors.param_type_names[index], true, box_builtin, "nominal field", node_id);
        if !verdict.ok { return verdict; }
        index = index + 1;
    }
    index = 0;
    while index < ArrayLength(enums.variant_param_type_names) {
        let verdict: SemanticAstBodyVerdict = SemanticAffineStorageShapeVerdict(
            enums.variant_param_type_names[index], true, box_builtin, "enum payload", -1);
        if !verdict.ok { return verdict; }
        index = index + 1;
    }

    // Direct handle parameters and returns keep their lifecycle modes; only a
    // containing value shape is forbidden here.
    index = 0;
    while index < ArrayLength(signatures.param_types) {
        let node_id: Int = -1;
        if index < ArrayLength(signatures.param_node_ids) {
            node_id = signatures.param_node_ids[index];
        }
        let verdict: SemanticAstBodyVerdict = SemanticAffineStorageShapeVerdict(
            signatures.param_types[index], false, box_builtin, "function parameter", node_id);
        if !verdict.ok { return verdict; }
        index = index + 1;
    }
    index = 0;
    while index < ArrayLength(signatures.return_types) {
        let verdict: SemanticAstBodyVerdict = SemanticAffineStorageShapeVerdict(
            signatures.return_types[index], false, box_builtin, "function return",
            signatures.function_node_ids[index]);
        if !verdict.ok { return verdict; }
        index = index + 1;
    }

    index = 0;
    while index < SemanticAstLocalBindingCount(locals) {
        let stored_type: String = initializers.inferred_type_names[index];
        let declared: Option<String> =
            SemanticAstLocalBindingDeclaredTypeAt(locals, index);
        if IsSome(declared) { stored_type = UnwrapOption(declared); }
        let verdict: SemanticAstBodyVerdict = SemanticAffineStorageShapeVerdict(
            stored_type, false, box_builtin, "local aggregate", locals.node_ids[index]);
        if !verdict.ok { return verdict; }
        index = index + 1;
    }
    return SemanticAstBodyVerdictOk();
}
