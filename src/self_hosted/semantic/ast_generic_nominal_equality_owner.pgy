// A declared nominal bound is exact type equality (not inheritance). Project
// only owned copies of those witnesses into a callable's temporary body type
// view; signatures, source handles and call-instance identities remain owned
// and unchanged.
import "ast_signature_fact_owner.pgy";
import "ast_nominal_constructor_fact_owner.pgy";

func SemanticAstGenericNominalEqualityInputsReady(
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    signature: Int
) -> Bool {
    if !signatures.ok || !constructors.ok || signature < 0 ||
        signature >= ArrayLength(signatures.generic_counts) ||
        signature >= ArrayLength(signatures.generic_starts) ||
        ArrayLength(signatures.generic_names) !=
            ArrayLength(signatures.generic_constraint_type_names) ||
        ArrayLength(constructors.names) !=
            ArrayLength(constructors.return_type_names) {
        return false;
    }
    let start: Int = signatures.generic_starts[signature];
    let count: Int = signatures.generic_counts[signature];
    return start >= 0 && count >= 0 &&
        start + count <= ArrayLength(signatures.generic_names);
}

func SemanticAstGenericNominalEqualityActualAt(
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    signature: Int,
    ordinal: Int
) -> String {
    if !SemanticAstGenericNominalEqualityInputsReady(
        signatures, constructors, signature
    ) {
        return "";
    }
    let start: Int = signatures.generic_starts[signature];
    let count: Int = signatures.generic_counts[signature];
    if ordinal < 0 || ordinal >= count {
        return "";
    }
    let row: Int = start + ordinal;
    let nominal: String = "";
    let constraints: String = signatures.generic_constraint_type_names[row];
    let cursor: Int = 0;
    let valid: Bool = true;
    while valid && cursor <= StringLength(constraints) {
        let tail: String = Substring(
            constraints, cursor, StringLength(constraints) - cursor
        );
        let separator: Int = StringIndexOf(tail, "+");
        let segment_length: Int = StringLength(constraints) - cursor;
        if separator >= 0 { segment_length = separator; }
        let type_name: String = SemanticCanonicalTypeName(
            Substring(constraints, cursor, segment_length)
        );
        let declaration: Int = 0;
        while declaration < ArrayLength(constructors.names) {
            if type_name != "" &&
                constructors.return_type_names[declaration] == type_name {
                if nominal != "" && nominal != type_name {
                    valid = false;
                } else {
                    nominal = type_name;
                }
            }
            declaration = declaration + 1;
        }
        if separator < 0 {
            cursor = StringLength(constraints) + 1;
        } else {
            cursor = cursor + segment_length + 1;
        }
    }
    if !valid {
        return "";
    }
    if nominal == "" {
        return Concat("", signatures.generic_names[row]);
    }
    return Concat("", nominal);
}

func SemanticAstGenericNominalEqualityActualsReady(
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    signature: Int
) -> Bool {
    if !SemanticAstGenericNominalEqualityInputsReady(
        signatures, constructors, signature
    ) {
        return false;
    }
    let ordinal: Int = 0;
    while ordinal < signatures.generic_counts[signature] {
        if SemanticAstGenericNominalEqualityActualAt(
            signatures, constructors, signature, ordinal
        ) == "" {
            return false;
        }
        ordinal = ordinal + 1;
    }
    return true;
}
