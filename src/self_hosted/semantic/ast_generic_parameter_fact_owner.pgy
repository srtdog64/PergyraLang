// Canonical formal-generic rows captured from a typed AST generic list node.

import "../hir/typed_ast_arena_owner.pgy";
import "../hir/ast_node_kind_owner.pgy";
import "../hir/ast_text_scan_owner.pgy";
import "../hir/ast_text_arena_projection_owner.pgy";
import "ast_type_name_canonical_owner.pgy";
import "delimited_range_fact_owner.pgy";
import "expression_normalization_owner.pgy";

struct SemanticAstGenericParameterFactRows {
    ok: Bool;
    names: Array<String>;
    default_type_names: Array<String>;
    constraint_type_names: Array<String>;
}

// A comparison-only or rejected result transfers no elements. Consume both
// the Array carriers and the owned String rows here.
func SemanticAstGenericParameterFactRowsDrop(
    inout rows: SemanticAstGenericParameterFactRows
) -> Void {
    let names: Array<String> = rows.names;
    ArrayDropOwnedStrings(names);
    rows.names = names;
    let defaults: Array<String> = rows.default_type_names;
    ArrayDropOwnedStrings(defaults);
    rows.default_type_names = defaults;
    let constraints: Array<String> = rows.constraint_type_names;
    ArrayDropOwnedStrings(constraints);
    rows.constraint_type_names = constraints;
}

func SemanticAstGenericParameterDefaultRowsFromText(
    row: String,
    inout names: Array<String>,
    inout default_type_names: Array<String>
) -> Bool {
    if ArrayLength(names) != ArrayLength(default_type_names) {
        return false;
    }
    let row_start: Int = ArrayLength(names);
    let n: Int = StringLength(row);
    if n < 3 || CharAt(row, 0) != "<" || CharAt(row, n - 1) != ">" {
        return false;
    }
    let inner: String = Substring(row, 1, n - 2);
    let parts: SemanticDelimitedRangeFacts =
        SemanticNestedCommaRangeFactsFromSource(inner);
    if SemanticDelimitedRangeCount(parts) == 0 { return false; }
    let i: Int = 0;
    while i < SemanticDelimitedRangeCount(parts) {
        let part: String = SemanticDelimitedRangeText(parts, inner, i);
        let equal: Int = StringIndexOf(part, "=");
        let name: String = part;
        let default_type: String = "";
        if equal >= 0 {
            name = SemanticTrimSourceRangeReuse(part, 0, equal);
            default_type = SemanticTrimSourceRangeReuse(
                part, equal + 1, StringLength(part)
            );
        }
        if !IsIdentifier(name) || (equal >= 0 && default_type == "") {
            return false;
        }
        let previous: Int = row_start;
        while previous < ArrayLength(names) {
            if names[previous] == name { return false; }
            previous = previous + 1;
        }
        ArrayPushOwnedString(names, name);
        ArrayPushOwnedString(
            default_type_names,
            SemanticCanonicalTypeName(default_type)
        );
        i = i + 1;
    }
    return true;
}

func SemanticAstGenericParameterDefaultRowsFromNode(
    arena: AstArena,
    node_id: Int,
    inout names: Array<String>,
    inout default_type_names: Array<String>
) -> Bool {
    if !TypedAstArenaNodeKindIs(
        arena, node_id, TypedAstKindGenericParamsTag()
    ) {
        return false;
    }
    let atom: Option<String> = TypedAstArenaAtomText(arena, node_id);
    return IsSome(atom) && SemanticAstGenericParameterDefaultRowsFromText(
        UnwrapOption(atom), names, default_type_names
    );
}

func SemanticAstAbilityGenericParameterDefaultRowsFromProvenance(
    arena: AstArena,
    ability_node_id: Int,
    inout names: Array<String>,
    inout default_type_names: Array<String>
) -> Bool {
    if !TypedAstArenaNodeKindIs(
        arena, ability_node_id, TypedAstKindAbilityDeclTag()
    ) {
        return false;
    }
    let provenance: Option<String> = TypedAstArenaProvenanceText(
        arena, ability_node_id
    );
    if !IsSome(provenance) { return false; }
    let row: String = UnwrapOption(provenance);
    let open: Int = StringIndexOf(row, "<");
    if open < 0 { return true; }
    let close: Int = -1;
    let depth: Int = 0;
    let cursor: Int = open;
    while cursor < StringLength(row) {
        let c: String = CharAt(row, cursor);
        if c == "<" { depth = depth + 1; }
        else if c == ">" {
            depth = depth - 1;
            if depth == 0 { close = cursor; break; }
            if depth < 0 { return false; }
        }
        cursor = cursor + 1;
    }
    if close <= open { return false; }
    return SemanticAstGenericParameterDefaultRowsFromText(
        Substring(row, open, close - open + 1), names, default_type_names
    );
}

func SemanticAstAbilityGenericParameterDefaultRowsFromNode(
    arena: AstArena,
    ability_node_id: Int,
    inout names: Array<String>,
    inout default_type_names: Array<String>
) -> Bool {
    if !TypedAstArenaNodeKindIs(
        arena, ability_node_id, TypedAstKindAbilityDeclTag()
    ) {
        return false;
    }
    let generic_child_count: Int = 0;
    let child_index: Int = 0;
    let child: Option<Int> = TypedAstArenaChildAt(
        arena, ability_node_id, child_index
    );
    while IsSome(child) {
        let child_id: Int = UnwrapOption(child);
        if TypedAstArenaNodeKindIs(
            arena, child_id, TypedAstKindGenericParamsTag()
        ) {
            generic_child_count = generic_child_count + 1;
            if generic_child_count > 1 ||
                !SemanticAstGenericParameterDefaultRowsFromNode(
                    arena, child_id, names, default_type_names
                ) {
                return false;
            }
        }
        child_index = child_index + 1;
        child = TypedAstArenaChildAt(arena, ability_node_id, child_index);
    }
    if generic_child_count == 1 { return true; }
    return SemanticAstAbilityGenericParameterDefaultRowsFromProvenance(
        arena, ability_node_id, names, default_type_names
    );
}

func SemanticAstGenericParameterFactRowsFromOwnerNode(
    arena: AstArena,
    owner_node_id: Int
) -> SemanticAstGenericParameterFactRows {
    let row_names: Array<String> = [];
    let row_defaults: Array<String> = [];
    let row_constraints: Array<String> = [];
    let ok: Bool = true;
    let ability_owner: Bool = TypedAstArenaNodeKindIs(
        arena, owner_node_id, TypedAstKindAbilityDeclTag()
    );
    if !ability_owner &&
        !TypedAstArenaNodeKindIsCallable(arena, owner_node_id) {
        ok = false;
    }
    let generic_parameter_node_id: Int = -1;
    let constraint_node_ids: Array<Int> = [];
    let child_index: Int = 0;
    let child: Option<Int> = TypedAstArenaChildAt(
        arena, owner_node_id, child_index
    );
    while ok && IsSome(child) {
        let child_id: Int = UnwrapOption(child);
        if TypedAstArenaNodeKindIs(
            arena, child_id, TypedAstKindGenericParamsTag()
        ) {
            if generic_parameter_node_id >= 0 {
                ok = false;
            } else {
                generic_parameter_node_id = child_id;
            }
        } else if TypedAstArenaNodeKindIs(
            arena, child_id, TypedAstKindGenericConstraintsTag()
        ) {
            ArrayPush(constraint_node_ids, child_id);
        }
        child_index = child_index + 1;
        child = TypedAstArenaChildAt(arena, owner_node_id, child_index);
    }
    if ok && generic_parameter_node_id >= 0 {
        if !SemanticAstGenericParameterDefaultRowsFromNode(
            arena, generic_parameter_node_id, row_names, row_defaults
        ) { ok = false; }
    } else if ok && ability_owner &&
        !SemanticAstAbilityGenericParameterDefaultRowsFromProvenance(
            arena, owner_node_id, row_names, row_defaults
        ) {
        ok = false;
    }
    if ok && ArrayLength(row_names) != ArrayLength(row_defaults) {
        ok = false;
    }
    let constraint_names: Array<String> = [];
    let constraint_bounds: Array<String> = [];
    let constraint_index: Int = 0;
    while ok && constraint_index < ArrayLength(constraint_node_ids) {
        let child_id: Int = constraint_node_ids[constraint_index];
        let row_opt: Option<String> = TypedAstArenaAtomText(arena, child_id);
        if !IsSome(row_opt) {
            ok = false;
            continue;
        }
        let row: String = UnwrapOption(row_opt);
        if StartsWith(row, "where ") {
            row = SemanticTrimSourceRangeReuse(
                row, 6, StringLength(row)
            );
        }
        let parts: SemanticDelimitedRangeFacts =
            SemanticNestedCommaRangeFactsFromSource(row);
        if SemanticDelimitedRangeCount(parts) == 0 {
            ok = false;
            continue;
        }
        let part_i: Int = 0;
        while ok && part_i < SemanticDelimitedRangeCount(parts) {
            let part: String = SemanticDelimitedRangeText(parts, row, part_i);
            let colon: Int = StringIndexOf(part, ":");
            if colon <= 0 {
                ok = false;
                continue;
            }
            let name: String = SemanticTrimSourceRangeReuse(part, 0, colon);
            let bounds: String = SemanticTrimSourceRangeReuse(
                part, colon + 1, StringLength(part)
            );
            if bounds == "" {
                ok = false;
                continue;
            }
            let name_i: Int = 0;
            let found: Bool = false;
            while name_i < ArrayLength(row_names) {
                if row_names[name_i] == name {
                    found = true;
                }
                name_i = name_i + 1;
            }
            // Native parity keeps a well-formed clause on a callable
            // with no generic parameters, but crossed named rows fail.
            if !found && ArrayLength(row_names) > 0 { ok = false; }
            if found {
                let prior: Int = 0;
                while prior < ArrayLength(constraint_names) {
                    if constraint_names[prior] == name { ok = false; }
                    prior = prior + 1;
                }
                if ok {
                    ArrayPushOwnedString(constraint_names, name);
                    ArrayPushOwnedString(constraint_bounds, bounds);
                }
            }
            part_i = part_i + 1;
        }
        constraint_index = constraint_index + 1;
    }
    let generic_i: Int = 0;
    while ok && generic_i < ArrayLength(row_names) {
        let bound: String = "";
        let bound_i: Int = 0;
        while bound_i < ArrayLength(constraint_names) {
            if constraint_names[bound_i] == row_names[generic_i] {
                bound = constraint_bounds[bound_i];
            }
            bound_i = bound_i + 1;
        }
        ArrayPushOwnedString(row_constraints, bound);
        generic_i = generic_i + 1;
    }
    ArrayDropOwnedStrings(constraint_names);
    ArrayDropOwnedStrings(constraint_bounds);
    ArrayDrop(constraint_node_ids);
    return SemanticAstGenericParameterFactRows(
        ok, row_names, row_defaults, row_constraints
    );
}

func SemanticAstGenericDefaultRowCountOrDie(
    name_count: Int, default_type_count: Int
) -> Int {
    if name_count != default_type_count {
        Log("semantic generic parameter default rows are misaligned");
        Exit(1);
    }
    return name_count;
}

func SemanticAstGenericParameterFactContractReady() -> Bool {
    let artifact: AstTreeArtifact = AstTreeArtifactFromText(
        "Program:\n  Function: Identity\n    Generic params: <T, U>\n" +
        "    Parameters:\n    Returns: T\n    Body:\n      Block:\n"
    );
    let node: Option<Int> = TypedAstArenaChildAt(artifact.arena, 1, 0);
    let names: Array<String> = [];
    let defaults: Array<String> = [];
    if !IsSome(node) || !SemanticAstGenericParameterDefaultRowsFromNode(
        artifact.arena, UnwrapOption(node), names, defaults
    ) || ArrayLength(names) != 2 || names[0] != "T" || names[1] != "U" ||
        defaults[0] != "" || defaults[1] != "" {
        return false;
    }
    let default_artifact: AstTreeArtifact = AstTreeArtifactFromText(
        "Program:\n  Function: Defaulted\n" +
        "    Generic params: <T = HashMap<String, Int>>\n" +
        "    Parameters:\n    Returns: T\n    Body:\n      Block:\n"
    );
    let default_node: Option<Int> = TypedAstArenaChildAt(
        default_artifact.arena, 1, 0
    );
    let default_names: Array<String> = [];
    let default_types: Array<String> = [];
    return IsSome(default_node) &&
        SemanticAstGenericParameterDefaultRowsFromNode(
            default_artifact.arena, UnwrapOption(default_node),
            default_names, default_types
        ) && SemanticAstGenericDefaultRowCountOrDie(
            ArrayLength(default_names), ArrayLength(default_types)
        ) == 1 && default_names[0] == "T" &&
        default_types[0] == "HashMap<String, Int>";
}
