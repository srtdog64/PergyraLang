// Semantic-owned concrete generic call bindings consumed by codegen.

import "ast_expression_environment_owner.pgy";
import "ast_expression_graph_view_owner.pgy";
import "ast_expression_graph_generic_call_owner.pgy";
import "ast_expression_call_target_fact_owner.pgy";
import "ast_initializer_type_fact_owner.pgy";
import "ast_type_name_canonical_owner.pgy";
import "ast_match_binding_environment_owner.pgy";
import "ast_expression_call_identity_owner.pgy";
import "ast_expression_function_table_fact_owner.pgy";
import "ast_intent_expression_environment_owner.pgy";

struct SemanticAstGenericSpecializationFacts {
    ok: Bool;
    diagnostic_code: String;
    diagnostic_message: String;
    call_node_ids: Array<Int>;
    source_owner_node_ids: Array<Int>;
    source_lanes: Array<Int>;
    source_call_ordinals: Array<Int>;
    signature_indexes: Array<Int>;
    actual_starts: Array<Int>;
    actual_counts: Array<Int>;
    actual_type_names: Array<String>;
}

func SemanticAstGenericSpecializationError(
    code: String,
    message: String,
    call_node_ids: Array<Int>,
    signature_indexes: Array<Int>,
    actual_starts: Array<Int>,
    actual_counts: Array<Int>,
    actual_type_names: Array<String>
) -> SemanticAstGenericSpecializationFacts {
    let stable_ids: Array<Int> = [];
    return SemanticAstGenericSpecializationFacts(
        false, code, message, call_node_ids,
        stable_ids, stable_ids, stable_ids, signature_indexes,
        actual_starts, actual_counts, actual_type_names
    );
}

func SemanticAstGenericSpecializationIndexForCall(
    call_node_ids: Array<Int>,
    call_node_id: Int
) -> Option<Int> {
    let i: Int = 0;
    while i < ArrayLength(call_node_ids) {
        if call_node_ids[i] == call_node_id { return Some(i); }
        i = i + 1;
    }
    return None;
}

func SemanticAstGenericSpecializationAppend(
    inout call_node_ids: Array<Int>,
    inout signature_indexes: Array<Int>,
    inout actual_starts: Array<Int>,
    inout actual_counts: Array<Int>,
    inout actual_type_names: Array<String>,
    call_node_id: Int,
    signature_index: Int,
    actuals: Array<String>
) -> Bool {
    let existing: Option<Int> = SemanticAstGenericSpecializationIndexForCall(
        call_node_ids, call_node_id
    );
    if IsSome(existing) {
        let existing_index: Int = UnwrapOption(existing);
        if signature_indexes[existing_index] != signature_index ||
            actual_counts[existing_index] != ArrayLength(actuals) {
            return false;
        }
        let i: Int = 0;
        while i < ArrayLength(actuals) {
            if actual_type_names[actual_starts[existing_index] + i] !=
                actuals[i] {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    if call_node_id < 0 || signature_index < 0 ||
        ArrayLength(actuals) == 0 {
        return false;
    }
    ArrayPush(call_node_ids, call_node_id);
    ArrayPush(signature_indexes, signature_index);
    ArrayPush(actual_starts, ArrayLength(actual_type_names));
    ArrayPush(actual_counts, ArrayLength(actuals));
    let i: Int = 0;
    while i < ArrayLength(actuals) {
        if actuals[i] == "" { return false; }
        ArrayPush(actual_type_names, Concat("", actuals[i]));
        i = i + 1;
    }
    return true;
}

func SemanticAstGenericSpecializationFactsFromAdmittedBody(
    artifact: AstTreeArtifact,
    signatures: SemanticAstFunctionSignatureFacts,
    constructors: SemanticAstNominalConstructorFacts,
    locals: SemanticAstLocalBindingFacts,
    initializer_types: SemanticAstInitializerTypeFacts,
    ref expression_surfaces: SemanticAstExpressionSurfaceFacts,
    function_tables: SemanticAstExpressionFunctionTableFacts,
    enum_facts: SemanticAstEnumFacts,
    intent_signatures: SemanticAstIntentSignatureFacts,
    intent_transitions: SemanticAstIntentTransitionFacts,
    function_scopes: SemanticAstFunctionScopeFacts
) -> SemanticAstGenericSpecializationFacts {
    let call_node_ids: Array<Int> = [];
    let signature_indexes: Array<Int> = [];
    let actual_starts: Array<Int> = [];
    let actual_counts: Array<Int> = [];
    let actual_type_names: Array<String> = [];
    if !SemanticAstInitializerTypeFactsReadyProjection(
        artifact, locals, initializer_types
    ) {
        return SemanticAstGenericSpecializationError(
            "ast_artifact_invalid",
            SemanticError1(
                "ast_artifact_invalid", "owner", "generic_specialization"
            ),
            call_node_ids, signature_indexes, actual_starts, actual_counts,
            actual_type_names
        );
    }
    let node_id: Int = 0;
    while node_id < SemanticExpressionGraphArenaNodeCount(
        expression_surfaces.expression_graph.arena
    ) {
        let view: SemanticCallSpineView = SemanticCallSpineViewFromGraph(
            expression_surfaces.expression_graph, node_id
        );
        if view.ok && ArrayLength(view.generic_actual_type_names) > 0 &&
            !IsSome(SemanticAstGenericSpecializationIndexForCall(
                call_node_ids, view.call_node
            )) {
            let target_kind: Option<Int> =
                SemanticExpressionGraphCallTargetKind(
                    expression_surfaces.expression_graph, view.call_node
                );
            let target_name: Option<String> =
                SemanticExpressionGraphCallTargetName(
                    expression_surfaces.expression_graph, view.call_node
                );
            if !IsSome(target_kind) || !IsSome(target_name) ||
                (UnwrapOption(target_kind) != SemanticCallTargetDirect() &&
                 UnwrapOption(target_kind) != SemanticCallTargetMember()) {
                return SemanticAstGenericSpecializationError(
                    "ast_artifact_invalid",
                    SemanticError1(
                        "ast_artifact_invalid", "owner",
                        "generic_specialization_target"
                    ),
                    call_node_ids, signature_indexes, actual_starts,
                    actual_counts, actual_type_names
                );
            }
            if UnwrapOption(target_kind) == SemanticCallTargetMember() {
                node_id = node_id + 1;
                continue;
            }
            let signature_index: Option<Int> =
                SemanticGenericCallSignatureIndex(
                    signatures, UnwrapOption(target_name)
                );
            if !IsSome(signature_index) {
                return SemanticAstGenericSpecializationError(
                    "undefined_function",
                    SemanticError1(
                        "undefined_function", "func", UnwrapOption(target_name)
                    ),
                    call_node_ids, signature_indexes, actual_starts,
                    actual_counts, actual_type_names
                );
            }
            let actuals: Array<String> = [];
            let actual_i: Int = 0;
            while actual_i < ArrayLength(view.generic_actual_type_names) {
                let actual: String = SemanticCanonicalTypeName(
                    view.generic_actual_type_names[actual_i]
                );
                if actual == "" { break; }
                ArrayPush(actuals, actual);
                actual_i = actual_i + 1;
            }
            let generic_count: Option<Int> =
                SemanticAstFunctionGenericCountAt(
                    signatures, UnwrapOption(signature_index)
                );
            if !IsSome(generic_count) ||
                ArrayLength(actuals) != UnwrapOption(generic_count) ||
                !SemanticAstGenericSpecializationAppend(
                    call_node_ids, signature_indexes, actual_starts,
                    actual_counts, actual_type_names, view.call_node,
                    UnwrapOption(signature_index), actuals
                ) {
                return SemanticAstGenericSpecializationError(
                    "generic_argument_count_mismatch",
                    SemanticError1(
                        "generic_argument_count_mismatch", "func",
                        UnwrapOption(target_name)
                    ),
                    call_node_ids, signature_indexes, actual_starts,
                    actual_counts, actual_type_names
                );
            }
        }
        node_id = node_id + 1;
    }

    if !SemanticAstEnumRowsReady(enum_facts) {
        return SemanticAstGenericSpecializationError(
            "ast_artifact_invalid",
            SemanticError1(
                "ast_artifact_invalid", "owner", "generic_enum_environment"
            ),
            call_node_ids, signature_indexes, actual_starts, actual_counts,
            actual_type_names
        );
    }
    if !SemanticAstExpressionFunctionTableFactsReady(function_tables) {
        return SemanticAstGenericSpecializationError(
            "ast_artifact_invalid",
            SemanticError1(
                "ast_artifact_invalid", "owner", "generic_function_table"
            ),
            call_node_ids, signature_indexes, actual_starts, actual_counts,
            actual_type_names
        );
    }
    if !SemanticAstIntentSignatureFactsAdmittedReady(
        artifact, intent_signatures
    ) {
        return SemanticAstGenericSpecializationError(
            "ast_artifact_invalid",
            SemanticError1(
                "ast_artifact_invalid", "owner", "generic_intent_environment"
            ),
            call_node_ids, signature_indexes, actual_starts, actual_counts,
            actual_type_names
        );
    }
    if !intent_transitions.ok ||
        intent_transitions.artifact_node_count != artifact.count ||
        !function_scopes.ok ||
        function_scopes.artifact_node_count != artifact.count ||
        ArrayLength(function_scopes.function_node_ids) != artifact.count {
        return SemanticAstGenericSpecializationError(
            "ast_artifact_invalid",
            SemanticError1(
                "ast_artifact_invalid", "owner", "generic_intent_transition"
            ),
            call_node_ids, signature_indexes, actual_starts, actual_counts,
            actual_type_names
        );
    }
    let names: Array<String> = [];
    let types: Array<String> = [];
    let modes: Array<String> = [];
    if !SemanticAstExpressionSeedEnumValues(
        enum_facts, names, types, modes
    ) {
        return SemanticAstGenericSpecializationError(
            "ast_artifact_invalid",
            SemanticError1(
                "ast_artifact_invalid", "owner", "generic_enum_environment"
            ),
            call_node_ids, signature_indexes, actual_starts, actual_counts,
            actual_type_names
        );
    }
    let enum_environment_count: Int = ArrayLength(names);
    let surface_index: Int = 0;
    while surface_index < SemanticAstExpressionSurfaceCount(
        expression_surfaces
    ) {
        let use_node_id: Int = expression_surfaces.node_ids[surface_index];
        let has_body_graph: Bool = false;
        let root_lane: Int = AstExpressionLaneAtom();
        while root_lane <= AstExpressionLaneAuxiliary() && !has_body_graph {
            has_body_graph = IsSome(SemanticAstExpressionGraphRootForNode(
                expression_surfaces, use_node_id, root_lane
            ));
            root_lane = root_lane + 1;
        }
        if !has_body_graph {
            surface_index = surface_index + 1;
            continue;
        }
        let function_node: Option<Int> =
            SemanticAstExpressionFunctionNodeAt(
                expression_surfaces, signatures, surface_index
            );
        let intent_node: Option<Int> =
            SemanticAstIntentExpressionOwnerNodeId(artifact, use_node_id);
        if !IsSome(function_node) && !IsSome(intent_node) {
            return SemanticAstGenericSpecializationError(
                "ast_artifact_invalid",
                SemanticError2(
                    "ast_artifact_invalid", "owner",
                    "generic_function_scope", "node_id",
                    ToString(use_node_id)
                ),
                call_node_ids, signature_indexes, actual_starts,
                actual_counts, actual_type_names
            );
        }
        while ArrayLength(names) > enum_environment_count { ArrayPop(names); }
        while ArrayLength(types) > enum_environment_count { ArrayPop(types); }
        while ArrayLength(modes) > enum_environment_count { ArrayPop(modes); }
        let environment_ok: Bool =
            ArrayLength(names) == enum_environment_count &&
            ArrayLength(types) == enum_environment_count &&
            ArrayLength(modes) == enum_environment_count;
        if environment_ok && IsSome(function_node) {
            environment_ok = SemanticAstExpressionSeedOwnerFieldsFromAdmittedConstructors(
                signatures, constructors, UnwrapOption(function_node),
                names, types, modes
            ) && SemanticAstExpressionSeedParameters(
                signatures, UnwrapOption(function_node), names, types
            ) && SemanticAstExpressionSeedParameterModes(
                signatures, UnwrapOption(function_node), modes
            ) && SemanticAstExpressionSeedVisibleLocals(
                artifact, locals, initializer_types.inferred_type_names,
                UnwrapOption(function_node), use_node_id, names, types
            ) && SemanticAstExpressionSeedVisibleLocalModes(
                artifact, locals, UnwrapOption(function_node), use_node_id,
                modes
            ) && SemanticAstExpressionSeedVisibleMatchBindingsFromAdmittedFacts(
                artifact, expression_surfaces, constructors, enum_facts,
                function_scopes,
                UnwrapOption(function_node), use_node_id,
                names, types, modes, function_tables
            );
        } else if environment_ok && IsSome(intent_node) {
            environment_ok = SemanticAstIntentExpressionSeedEnvironment(
                artifact, signatures, intent_signatures, intent_transitions,
                UnwrapOption(intent_node), use_node_id,
                names, types, modes
            );
        } else {
            environment_ok = false;
        }
        if !environment_ok || ArrayLength(names) != ArrayLength(types) ||
            ArrayLength(names) != ArrayLength(modes) {
            return SemanticAstGenericSpecializationError(
                "ast_artifact_invalid",
                SemanticError1(
                    "ast_artifact_invalid", "owner", "generic_environment"
                ),
                call_node_ids, signature_indexes, actual_starts,
                actual_counts, actual_type_names
            );
        }
        let lane: Int = AstExpressionLaneAtom();
        while lane <= AstExpressionLaneAuxiliary() {
            let root: Option<Int> = SemanticAstExpressionGraphRootForNode(
                expression_surfaces, use_node_id, lane
            );
            if IsSome(root) {
                let root_id: Int = UnwrapOption(root);
                let pending: Array<Int> = [root_id];
                while ArrayLength(pending) > 0 {
                    let current: Int = pending[ArrayLength(pending) - 1];
                    ArrayPop(pending);
                    let view: SemanticCallSpineView =
                        SemanticCallSpineViewFromGraph(
                            expression_surfaces.expression_graph, current
                        );
                    if view.ok &&
                        !IsSome(SemanticAstGenericSpecializationIndexForCall(
                            call_node_ids, view.call_node
                        )) {
                        let generic: SemanticExpressionGraphGenericCallFact =
                            SemanticExpressionGraphGenericCallFactFromGraph(
                                expression_surfaces.expression_graph, current,
                                signatures, constructors, names, types,
                                function_tables.names, function_tables.returns
                            );
                        if generic.applies && !generic.ok {
                            return SemanticAstGenericSpecializationError(
                                generic.diagnostic_code,
                                generic.diagnostic_message, call_node_ids,
                                signature_indexes, actual_starts,
                                actual_counts, actual_type_names
                            );
                        }
                        if generic.applies &&
                            !SemanticAstGenericSpecializationAppend(
                                call_node_ids, signature_indexes, actual_starts,
                                actual_counts, actual_type_names,
                                view.call_node, generic.signature_index,
                                generic.actual_type_names
                            ) {
                            return SemanticAstGenericSpecializationError(
                                "ast_artifact_invalid",
                                SemanticError1(
                                    "ast_artifact_invalid", "owner",
                                    "generic_binding"
                                ),
                                call_node_ids, signature_indexes,
                                actual_starts, actual_counts, actual_type_names
                            );
                        }
                    }
                    let kind: Option<Int> = SemanticExpressionGraphNodeKind(
                        expression_surfaces.expression_graph, current
                    );
                    if !IsSome(kind) {
                        return SemanticAstGenericSpecializationError(
                            "ast_artifact_invalid",
                            SemanticError1(
                                "ast_artifact_invalid", "owner",
                                "generic_graph"
                            ),
                            call_node_ids, signature_indexes, actual_starts,
                            actual_counts, actual_type_names
                        );
                    }
                    let arity: Int = AstExpressionNodeArity(UnwrapOption(kind));
                    if arity >= 1 {
                        ArrayPush(
                            pending,
                            expression_surfaces.expression_graph.arena
                                .topology.left_children[current]
                        );
                    }
                    if arity >= 2 {
                        ArrayPush(
                            pending,
                            expression_surfaces.expression_graph.arena
                                .topology.right_children[current]
                        );
                    }
                }
            }
            lane = lane + 1;
        }
        surface_index = surface_index + 1;
    }
    SemanticAstExpressionEnvironmentClear(names, types, modes);
    node_id = 0;
    while node_id < SemanticExpressionGraphArenaNodeCount(
        expression_surfaces.expression_graph.arena
    ) {
        let view: SemanticCallSpineView = SemanticCallSpineViewFromGraph(
            expression_surfaces.expression_graph, node_id
        );
        if view.ok && ArrayLength(view.generic_actual_type_names) == 0 &&
            !IsSome(SemanticAstGenericSpecializationIndexForCall(
                call_node_ids, view.call_node
            )) {
            let target_kind: Option<Int> =
                SemanticExpressionGraphCallTargetKind(
                    expression_surfaces.expression_graph, view.call_node
                );
            let target_name: Option<String> =
                SemanticExpressionGraphCallTargetName(
                    expression_surfaces.expression_graph, view.call_node
                );
            if IsSome(target_kind) && IsSome(target_name) &&
                UnwrapOption(target_kind) == SemanticCallTargetDirect() {
                let signature_index: Option<Int> =
                    SemanticGenericCallSignatureIndex(
                        signatures, UnwrapOption(target_name)
                    );
                if IsSome(signature_index) {
                    let count: Option<Int> = SemanticAstFunctionGenericCountAt(
                        signatures, UnwrapOption(signature_index)
                    );
                    if IsSome(count) && UnwrapOption(count) > 0 {
                        return SemanticAstGenericSpecializationError(
                            "ast_artifact_invalid",
                            SemanticError1(
                                "ast_artifact_invalid", "owner",
                                "generic_specialization_unresolved"
                            ),
                            call_node_ids, signature_indexes, actual_starts,
                            actual_counts, actual_type_names
                        );
                    }
                }
            }
        }
        node_id = node_id + 1;
    }
    let source_owner_node_ids: Array<Int> = [];
    let source_lanes: Array<Int> = [];
    let source_call_ordinals: Array<Int> = [];
    let identity_i: Int = 0;
    while identity_i < ArrayLength(call_node_ids) {
        let identity: SemanticExpressionCallIdentity =
            SemanticExpressionCallIdentityForNode(
                expression_surfaces, call_node_ids[identity_i]
            );
        if !identity.ok {
            return SemanticAstGenericSpecializationError(
                "ast_artifact_invalid",
                SemanticError1(
                    "ast_artifact_invalid", "owner",
                    "generic_call_stable_identity"
                ),
                call_node_ids, signature_indexes, actual_starts,
                actual_counts, actual_type_names
            );
        }
        ArrayPush(source_owner_node_ids, identity.owner_node_id);
        ArrayPush(source_lanes, identity.lane);
        ArrayPush(source_call_ordinals, identity.local_call_ordinal);
        identity_i = identity_i + 1;
    }
    return SemanticAstGenericSpecializationFacts(
        true, "", "", call_node_ids, source_owner_node_ids,
        source_lanes, source_call_ordinals, signature_indexes,
        actual_starts, actual_counts, actual_type_names
    );
}

func SemanticAstGenericSpecializationFactsFromBody(
    artifact: AstTreeArtifact,
    signatures: SemanticAstFunctionSignatureFacts,
    constructors: SemanticAstNominalConstructorFacts,
    locals: SemanticAstLocalBindingFacts,
    initializer_types: SemanticAstInitializerTypeFacts,
    ref expression_surfaces: SemanticAstExpressionSurfaceFacts,
    function_tables: SemanticAstExpressionFunctionTableFacts
) -> SemanticAstGenericSpecializationFacts {
    let enum_facts: SemanticAstEnumFacts =
        SemanticAstEnumFactsFromArtifact(artifact);
    let intent_signatures: SemanticAstIntentSignatureFacts =
        SemanticAstIntentSignatureFactsFromArtifact(artifact);
    let intent_transitions: SemanticAstIntentTransitionFacts =
        SemanticAstIntentTransitionFactsFromArtifact(
            artifact, signatures, intent_signatures
        );
    let function_scopes: SemanticAstFunctionScopeFacts =
        SemanticAstFunctionScopeFactsFromArtifact(artifact);
    if !SemanticAstNominalConstructorRowsReady(constructors) ||
        constructors.artifact_node_count != artifact.count ||
        !SemanticAstExpressionSurfaceBorrowReady(
        artifact, expression_surfaces
    ) || !SemanticAstIntentSignatureFactsReady(
        artifact, intent_signatures
    ) || !SemanticAstIntentTransitionFactsReady(
        artifact, intent_transitions
    ) || !function_scopes.ok {
        let empty_ints: Array<Int> = [];
        let empty_strings: Array<String> = [];
        return SemanticAstGenericSpecializationError(
            "ast_artifact_invalid",
            SemanticError1(
                "ast_artifact_invalid", "owner", "generic_specialization"
            ),
            empty_ints, empty_ints, empty_ints, empty_ints, empty_strings
        );
    }
    return SemanticAstGenericSpecializationFactsFromAdmittedBody(
        artifact, signatures, constructors, locals, initializer_types,
        expression_surfaces, function_tables, enum_facts, intent_signatures,
        intent_transitions, function_scopes
    );
}
