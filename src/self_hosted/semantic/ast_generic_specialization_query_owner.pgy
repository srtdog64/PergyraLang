// Read-only shape, actual-type, and expression-identity queries over generic
// specialization facts.

import "ast_generic_specialization_fact_owner.pgy";
import "ast_ability_generic_bound_verdict_owner.pgy";

func SemanticAstGenericSpecializationCount(
    ref facts: SemanticAstGenericSpecializationFacts
) -> Int {
    return ArrayLength(facts.call_node_ids);
}

func SemanticAstGenericSpecializationActuals(
    ref facts: SemanticAstGenericSpecializationFacts,
    index: Int
) -> Array<String> {
    let actuals: Array<String> = [];
    if !facts.ok || index < 0 ||
        index >= SemanticAstGenericSpecializationCount(facts) {
        return actuals;
    }
    let i: Int = 0;
    while i < facts.actual_counts[index] {
        ArrayPush(actuals, facts.actual_type_names[facts.actual_starts[index] + i]);
        i = i + 1;
    }
    return actuals;
}

func SemanticAstGenericSpecializationFactsReady(
    ref facts: SemanticAstGenericSpecializationFacts
) -> Bool {
    let count: Int = SemanticAstGenericSpecializationCount(facts);
    if !facts.ok || facts.diagnostic_code != "" ||
        facts.diagnostic_message != "" ||
        ArrayLength(facts.source_owner_node_ids) != count ||
        ArrayLength(facts.source_lanes) != count ||
        ArrayLength(facts.source_call_ordinals) != count ||
        ArrayLength(facts.signature_indexes) != count ||
        ArrayLength(facts.actual_starts) != count ||
        ArrayLength(facts.actual_counts) != count {
        return false;
    }
    let expected_start: Int = 0;
    let i: Int = 0;
    while i < count {
        if facts.call_node_ids[i] < 0 ||
            facts.source_owner_node_ids[i] < 0 ||
            facts.source_lanes[i] < AstExpressionLaneAtom() ||
            facts.source_lanes[i] > AstExpressionLaneAuxiliary() ||
            facts.source_call_ordinals[i] < 0 ||
            facts.signature_indexes[i] < 0 ||
            facts.actual_starts[i] != expected_start ||
            facts.actual_counts[i] <= 0 {
            return false;
        }
        let prior: Int = 0;
        while prior < i {
            if SemanticExpressionCallIdentityEqual(
                facts.source_owner_node_ids[prior],
                facts.source_lanes[prior],
                facts.source_call_ordinals[prior],
                facts.source_owner_node_ids[i], facts.source_lanes[i],
                facts.source_call_ordinals[i]
            ) {
                return false;
            }
            prior = prior + 1;
        }
        expected_start = expected_start + facts.actual_counts[i];
        i = i + 1;
    }
    return expected_start == ArrayLength(facts.actual_type_names);
}

func SemanticAstGenericSpecializationFactsMatchExpressionGraph(
    ref facts: SemanticAstGenericSpecializationFacts,
    ref expression_surfaces: SemanticAstExpressionSurfaceFacts
) -> Bool {
    if !SemanticAstGenericSpecializationFactsReady(facts) { return false; }
    let i: Int = 0;
    while i < SemanticAstGenericSpecializationCount(facts) {
        let node: Option<Int> = SemanticExpressionCallNodeForIdentity(
            expression_surfaces, facts.source_owner_node_ids[i],
            facts.source_lanes[i], facts.source_call_ordinals[i]
        );
        if !IsSome(node) || UnwrapOption(node) != facts.call_node_ids[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// `where` is a call-admission obligation, not a codegen specialization hint.
// Concrete implementations and a caller's declared formal bounds are the two
// legitimate witnesses. An unrelated role or a similarly named type is not.
func SemanticAstGenericSpecializationConstraintViolation(
    signatures: SemanticAstFunctionSignatureFacts,
    roles: SemanticAstRoleFacts,
    scopes: SemanticAstFunctionScopeFacts,
    ref facts: SemanticAstGenericSpecializationFacts
) -> Option<String> {
    if !signatures.ok || !roles.ok || !scopes.ok ||
        ArrayLength(signatures.generic_constraint_type_names) != ArrayLength(signatures.generic_names) ||
        !SemanticAstGenericSpecializationFactsReady(facts) {
        return Some("generic constraint admission requires sealed signature, role and binding facts");
    }
    let call: Int = 0;
    while call < SemanticAstGenericSpecializationCount(facts) {
        let target: Int = facts.signature_indexes[call];
        if target < 0 || target >= SemanticAstFunctionSignatureCount(signatures) ||
            facts.actual_counts[call] != signatures.generic_counts[target] {
            return Some("generic constraint binding does not match its formal signature");
        }
        let caller: Option<Int> = None;
        let caller_node: Option<Int> = SemanticAstFunctionScopeNodeId(scopes, facts.source_owner_node_ids[call]);
        if IsSome(caller_node) {
            caller = SemanticAstFunctionSignatureIndexForNode(signatures, UnwrapOption(caller_node));
        }
        let formal: Int = 0;
        while formal < facts.actual_counts[call] {
            let formal_row: Int = signatures.generic_starts[target] + formal;
            let constraint: String = signatures.generic_constraint_type_names[formal_row];
            if constraint != "" {
                let actual: String = facts.actual_type_names[facts.actual_starts[call] + formal];
                let bounds: Array<String> = Split(constraint, "+");
                let bound_index: Int = 0;
                while bound_index < ArrayLength(bounds) {
                    let bound: String = SemanticCanonicalTypeName(bounds[bound_index]);
                    let proven: Bool = bound != "" && actual == bound;
                    let bound_name: SemanticCanonicalTypeNameFact = SemanticCanonicalTypeNameFactFrom(bound);
                    if !proven && IsSome(SemanticAstAbilityIndexForName(roles, bound_name.nominal_base_name)) {
                        proven = SemanticAstTypeImplementsAbility(roles, actual, bound);
                    }
                    if !proven && bound != "" && IsSome(caller) {
                        let caller_index: Int = UnwrapOption(caller);
                        let caller_formal: Int = 0;
                        while caller_formal < signatures.generic_counts[caller_index] {
                            let caller_row: Int = signatures.generic_starts[caller_index] + caller_formal;
                            if signatures.generic_names[caller_row] == actual {
                                let caller_bounds: Array<String> = Split(signatures.generic_constraint_type_names[caller_row], "+");
                                let witness: Int = 0;
                                while witness < ArrayLength(caller_bounds) {
                                    if SemanticCanonicalTypeName(caller_bounds[witness]) == bound { proven = true; }
                                    witness = witness + 1;
                                }
                            }
                            caller_formal = caller_formal + 1;
                        }
                    }
                    if !proven {
                        return Some("Type '" + actual + "' does not satisfy constraint '" + bound +
                            "' for generic parameter '" + signatures.generic_names[formal_row] +
                            "' in '" + signatures.names[target] + "'");
                    }
                    bound_index = bound_index + 1;
                }
            }
            formal = formal + 1;
        }
        call = call + 1;
    }
    return None;
}
