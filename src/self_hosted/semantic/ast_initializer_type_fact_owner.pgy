// Semantic initializer type facts derived from parser-owned artifact facts.
//
// This owner never re-scans source text. It joins function signatures, lexical
// local-binding rows, and the initializer payload already captured by the
// semantic local-binding owner.

import "../hir/ast_text_arena_projection_owner.pgy";
import "ast_signature_artifact_match_owner.pgy";
import "ast_nominal_constructor_fact_owner.pgy";
import "ast_local_binding_fact_owner.pgy";
import "expr_type_owner.pgy";
import "ast_expression_environment_owner.pgy";
import "ast_expression_verdict_owner.pgy";
import "ast_expression_graph_view_owner.pgy";
import "array_type_owner.pgy";
import "projection_type_owner.pgy";
import "ast_enum_fact_owner.pgy";

struct SemanticAstInitializerTypeFacts {
    ok: Bool;
    diagnostic_code: String;
    diagnostic_message: String;
    artifact_node_count: Int;
    node_ids: Array<Int>;
    expression_texts: Array<String>;
    inferred_type_names: Array<String>;
    verified: Array<Int>;
    diagnostic_codes: Array<String>;
    diagnostic_messages: Array<String>;
}

func SemanticAstInitializerTypeStructuralError(
    artifact: AstTreeArtifact
) -> SemanticAstInitializerTypeFacts {
    let empty_ints: Array<Int> = [];
    let empty_strings: Array<String> = [];
    return SemanticAstInitializerTypeFacts(
        false,
        "ast_artifact_invalid",
        SemanticError2(
            "ast_artifact_invalid",
            "node_count", ToString(artifact.count),
            "owner", "SemanticAstInitializerTypeFacts"
        ),
        artifact.count,
        empty_ints, empty_strings, empty_strings, empty_ints,
        empty_strings, empty_strings
    );
}

func SemanticAstInitializerTypeFactsFromArtifactWithIterationRows(
    artifact: AstTreeArtifact,
    signatures: SemanticAstFunctionSignatureFacts,
    constructors: SemanticAstNominalConstructorFacts,
    locals: SemanticAstLocalBindingFacts,
    ref expression_surfaces: SemanticAstExpressionSurfaceFacts,
    iteration_node_ids: Array<Int>,
    iteration_function_node_ids: Array<Int>,
    iteration_binding_names: Array<String>,
    iteration_binding_types: Array<String>,
    iteration_verified: Array<Int>
) -> SemanticAstInitializerTypeFacts {
    if !AstTreeArtifactReady(artifact) ||
        !SemanticAstFunctionSignatureFactsMatchArtifact(
            artifact, signatures
        ) || !SemanticAstNominalConstructorFactsMatchArtifact(
            artifact, constructors
        ) || !SemanticAstLocalBindingFactsMatchArtifact(
            artifact, signatures, locals
        ) || !SemanticAstExpressionSurfaceBorrowReady(
            artifact, expression_surfaces
        ) {
        return SemanticAstInitializerTypeStructuralError(artifact);
    }

    let function_names: Array<String> = [];
    let function_returns: Array<String> = [];
    let function_params: Array<String> = [];
    let enum_facts: SemanticAstEnumFacts =
        SemanticAstEnumFactsFromArtifact(artifact);
    if !enum_facts.ok {
        return SemanticAstInitializerTypeStructuralError(artifact);
    }
    if !SemanticAstExpressionFunctionTables(
        signatures, constructors,
        function_names, function_returns, function_params
    ) {
        return SemanticAstInitializerTypeStructuralError(artifact);
    }

    let node_ids: Array<Int> = [];
    let expression_texts: Array<String> = [];
    let inferred_type_names: Array<String> = [];
    let verified: Array<Int> = [];
    let diagnostic_codes: Array<String> = [];
    let diagnostic_messages: Array<String> = [];
    let member_root_names: Array<String> = [];
    if !SemanticAstExpressionMemberRootNames(
        constructors, enum_facts, member_root_names
    ) {
        return SemanticAstInitializerTypeStructuralError(artifact);
    }
    let i: Int = 0;
    while i < SemanticAstLocalBindingCount(locals) {
        let names: Array<String> = [];
        let types: Array<String> = [];
        let modes: Array<String> = [];
        if !SemanticAstExpressionSeedEnumValues(
            enum_facts, names, types, modes
        ) || !SemanticAstExpressionSeedParameters(
            signatures, locals.function_node_ids[i], names, types
        ) || !SemanticAstExpressionSeedParameterModes(
            signatures, locals.function_node_ids[i], modes
        ) || !SemanticAstExpressionSeedVisibleLocals(
            artifact, locals, inferred_type_names,
            locals.function_node_ids[i], locals.node_ids[i], names, types
        ) || !SemanticAstExpressionSeedVisibleLocalModes(
            artifact, locals, locals.function_node_ids[i],
            locals.node_ids[i], modes
        ) || !SemanticAstExpressionSeedVisibleIterationRows(
            artifact, iteration_node_ids, iteration_function_node_ids,
            iteration_binding_names, iteration_binding_types,
            iteration_verified, locals.function_node_ids[i],
            locals.node_ids[i], names, types, modes
        ) || ArrayLength(names) != ArrayLength(modes) {
            return SemanticAstInitializerTypeStructuralError(artifact);
        }
        let expression: String = locals.initializer_texts[i];
        let graph_root: Option<Int> =
            SemanticAstExpressionGraphRootForNode(
                expression_surfaces, locals.node_ids[i],
                AstExpressionLaneValue()
            );
        if !IsSome(graph_root) {
            return SemanticAstInitializerTypeStructuralError(artifact);
        }
        let expression_verdict: SemanticAstExpressionVerdict =
            SemanticAstExpressionVerdictFromGraph(
                expression, expression_surfaces.expression_graph,
                UnwrapOption(graph_root),
                constructors, signatures,
                names, types, modes,
                function_names, function_returns, function_params,
                member_root_names
            );
        let inferred: String = expression_verdict.inferred_type_name;
        let declared: Option<String> =
            SemanticAstLocalBindingDeclaredTypeAt(locals, i);
        if expression_verdict.ok &&
            (inferred == "Unknown" || inferred == "") {
            let enum_type: Option<String> =
                SemanticAstEnumExpressionType(enum_facts, expression);
            if IsSome(enum_type) {
                inferred = UnwrapOption(enum_type);
            }
        }
        if expression_verdict.ok && IsSome(declared) &&
            SemanticAstPayloadFreeEnumValueAssignableToInt(
                enum_facts, UnwrapOption(declared), inferred, expression
            ) {
            inferred = "Int";
        }
        if expression_verdict.ok &&
            (inferred == "Unknown" || inferred == "") {
            let member_type: Option<String> =
                SemanticProjectionExpressionType(
                    expression, constructors, names, types, modes,
                    function_names, function_returns, function_params
                );
            if IsSome(member_type) {
                inferred = UnwrapOption(member_type);
            }
        }
        if expression_verdict.ok &&
            (inferred == "Unknown" || inferred == "") &&
            IsSome(declared) &&
            SemanticProjectionArrayLiteralMatchesDeclaredType(
                expression, UnwrapOption(declared), constructors,
                names, types, modes,
                function_names, function_returns, function_params
            ) {
            inferred = UnwrapOption(declared);
        }
        let row_verified: Int = 1;
        let row_code: String = "";
        let row_message: String = "";
        if !expression_verdict.ok {
            row_verified = 0;
            row_code = expression_verdict.diagnostic_code;
            row_message = expression_verdict.diagnostic_message;
        } else if inferred == "Unknown" || inferred == "" {
            row_verified = 0;
            row_code = "initializer_type_unresolved";
            row_message = SemanticError2(
                "initializer_type_unresolved",
                "binding", locals.names[i],
                "initializer", expression
            );
        } else {
            if IsSome(declared) && !ExpressionAssignableTo(
                UnwrapOption(declared), inferred, expression
            ) && !SemanticAstPayloadFreeEnumValueAssignableToInt(
                enum_facts, UnwrapOption(declared), inferred, expression
            ) {
                row_verified = 0;
                row_code = "let_type_mismatch";
                row_message = SemanticError2(
                    "let_type_mismatch",
                    "expected", UnwrapOption(declared),
                    "actual", inferred
                );
            }
        }
        ArrayPush(node_ids, locals.node_ids[i]);
        ArrayPush(expression_texts, expression);
        ArrayPush(inferred_type_names, inferred);
        ArrayPush(verified, row_verified);
        ArrayPush(diagnostic_codes, row_code);
        ArrayPush(diagnostic_messages, row_message);
        i = i + 1;
    }
    return SemanticAstInitializerTypeFacts(
        true, "", "", artifact.count, node_ids, expression_texts,
        inferred_type_names, verified, diagnostic_codes,
        diagnostic_messages
    );
}

func SemanticAstInitializerTypeFactsFromArtifact(
    artifact: AstTreeArtifact,
    signatures: SemanticAstFunctionSignatureFacts,
    constructors: SemanticAstNominalConstructorFacts,
    locals: SemanticAstLocalBindingFacts,
    ref expression_surfaces: SemanticAstExpressionSurfaceFacts
) -> SemanticAstInitializerTypeFacts {
    let empty_ints: Array<Int> = [];
    let empty_strings: Array<String> = [];
    return SemanticAstInitializerTypeFactsFromArtifactWithIterationRows(
        artifact, signatures, constructors, locals, expression_surfaces,
        empty_ints, empty_ints, empty_strings, empty_strings, empty_ints
    );
}

func SemanticAstInitializerTypeCount(
    facts: SemanticAstInitializerTypeFacts
) -> Int {
    return ArrayLength(facts.node_ids);
}

func SemanticAstInitializerTypesAllVerified(
    facts: SemanticAstInitializerTypeFacts
) -> Bool {
    if !facts.ok {
        return false;
    }
    let i: Int = 0;
    while i < SemanticAstInitializerTypeCount(facts) {
        if facts.verified[i] != 1 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func SemanticAstInitializerTypeFactsReadyProjection(
    artifact: AstTreeArtifact,
    locals: SemanticAstLocalBindingFacts,
    facts: SemanticAstInitializerTypeFacts
) -> Bool {
    let count: Int = SemanticAstInitializerTypeCount(facts);
    if !facts.ok || facts.artifact_node_count != artifact.count ||
        count != SemanticAstLocalBindingCount(locals) ||
        ArrayLength(facts.expression_texts) != count ||
        ArrayLength(facts.inferred_type_names) != count ||
        ArrayLength(facts.verified) != count ||
        ArrayLength(facts.diagnostic_codes) != count ||
        ArrayLength(facts.diagnostic_messages) != count {
        return false;
    }
    let i: Int = 0;
    while i < count {
        if facts.node_ids[i] != locals.node_ids[i] ||
            facts.expression_texts[i] != locals.initializer_texts[i] ||
            (facts.verified[i] != 0 && facts.verified[i] != 1) {
            return false;
        }
        if facts.verified[i] == 1 &&
            (facts.inferred_type_names[i] == "" ||
             facts.inferred_type_names[i] == "Unknown" ||
             facts.diagnostic_codes[i] != "" ||
             facts.diagnostic_messages[i] != "") {
            return false;
        }
        if facts.verified[i] == 0 &&
            (facts.diagnostic_codes[i] == "" ||
             facts.diagnostic_messages[i] == "") {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func SemanticAstInitializerFirstDiagnosticCode(
    facts: SemanticAstInitializerTypeFacts
) -> String {
    if !facts.ok {
        return facts.diagnostic_code;
    }
    let i: Int = 0;
    while i < SemanticAstInitializerTypeCount(facts) {
        if facts.verified[i] != 1 {
            return facts.diagnostic_codes[i];
        }
        i = i + 1;
    }
    return "";
}

func SemanticAstInitializerFirstDiagnosticMessage(
    facts: SemanticAstInitializerTypeFacts
) -> String {
    if !facts.ok {
        return facts.diagnostic_message;
    }
    let i: Int = 0;
    while i < SemanticAstInitializerTypeCount(facts) {
        if facts.verified[i] != 1 {
            return facts.diagnostic_messages[i];
        }
        i = i + 1;
    }
    return "";
}

func SemanticAstInitializerTypeFactsMatchArtifact(
    artifact: AstTreeArtifact,
    signatures: SemanticAstFunctionSignatureFacts,
    constructors: SemanticAstNominalConstructorFacts,
    locals: SemanticAstLocalBindingFacts,
    ref expression_surfaces: SemanticAstExpressionSurfaceFacts,
    facts: SemanticAstInitializerTypeFacts
) -> Bool {
    let rebuilt: SemanticAstInitializerTypeFacts =
        SemanticAstInitializerTypeFactsFromArtifact(
            artifact, signatures, constructors, locals, expression_surfaces
        );
    let n: Int = SemanticAstInitializerTypeCount(facts);
    if !facts.ok || !rebuilt.ok ||
        facts.artifact_node_count != artifact.count ||
        rebuilt.artifact_node_count != facts.artifact_node_count ||
        SemanticAstInitializerTypeCount(rebuilt) != n ||
        ArrayLength(facts.expression_texts) != n ||
        ArrayLength(facts.inferred_type_names) != n ||
        ArrayLength(facts.verified) != n ||
        ArrayLength(facts.diagnostic_codes) != n ||
        ArrayLength(facts.diagnostic_messages) != n {
        return false;
    }
    let i: Int = 0;
    while i < n {
        if rebuilt.node_ids[i] != facts.node_ids[i] ||
            rebuilt.expression_texts[i] != facts.expression_texts[i] ||
            rebuilt.inferred_type_names[i] != facts.inferred_type_names[i] ||
            rebuilt.verified[i] != facts.verified[i] ||
            rebuilt.diagnostic_codes[i] != facts.diagnostic_codes[i] ||
            rebuilt.diagnostic_messages[i] != facts.diagnostic_messages[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func SemanticAstInitializerTypeFactsContractReady() -> Bool {
    let valid: AstTreeArtifact = AstTreeArtifactFromText(
        "Program:\n  Function: Main\n    Parameters:\n    Returns: Void\n    Body:\n      Block:\n        Let: x : Int = 1\n        If: true\n          Then:\n            Block:\n              Let: y : Int = x\n"
    );
    let valid_signatures: SemanticAstFunctionSignatureFacts =
        SemanticAstFunctionSignatureFactsFromArtifact(valid);
    let valid_constructors: SemanticAstNominalConstructorFacts =
        SemanticAstNominalConstructorFactsFromArtifact(valid);
    let valid_locals: SemanticAstLocalBindingFacts =
        SemanticAstLocalBindingFactsFromArtifact(valid, valid_signatures);
    let valid_expression_surfaces: SemanticAstExpressionSurfaceFacts =
        SemanticAstExpressionSurfaceFactsFromArtifactCompactBridge(valid);
    let valid_facts: SemanticAstInitializerTypeFacts =
        SemanticAstInitializerTypeFactsFromArtifact(
            valid, valid_signatures, valid_constructors, valid_locals,
            valid_expression_surfaces
        );
    if !SemanticAstInitializerTypeFactsMatchArtifact(
        valid, valid_signatures, valid_constructors, valid_locals,
        valid_expression_surfaces, valid_facts
    ) || !SemanticAstInitializerTypesAllVerified(valid_facts) ||
        SemanticAstInitializerTypeCount(valid_facts) != 2 ||
        valid_facts.inferred_type_names[0] != "Int" ||
        valid_facts.inferred_type_names[1] != "Int" {
        return false;
    }

    let mismatch: AstTreeArtifact = AstTreeArtifactFromText(
        "Program:\n  Function: Main\n    Parameters:\n    Returns: Void\n    Body:\n      Block:\n        Let: bad : Int = \"x\"\n"
    );
    let mismatch_signatures: SemanticAstFunctionSignatureFacts =
        SemanticAstFunctionSignatureFactsFromArtifact(mismatch);
    let mismatch_constructors: SemanticAstNominalConstructorFacts =
        SemanticAstNominalConstructorFactsFromArtifact(mismatch);
    let mismatch_locals: SemanticAstLocalBindingFacts =
        SemanticAstLocalBindingFactsFromArtifact(
            mismatch, mismatch_signatures
        );
    let mismatch_expression_surfaces: SemanticAstExpressionSurfaceFacts =
        SemanticAstExpressionSurfaceFactsFromArtifactCompactBridge(mismatch);
    let mismatch_facts: SemanticAstInitializerTypeFacts =
        SemanticAstInitializerTypeFactsFromArtifact(
            mismatch, mismatch_signatures, mismatch_constructors,
            mismatch_locals, mismatch_expression_surfaces
        );
    if !SemanticAstInitializerTypeFactsReadyProjection(
        mismatch, mismatch_locals, mismatch_facts
    ) || SemanticAstInitializerTypesAllVerified(mismatch_facts) ||
        SemanticAstInitializerFirstDiagnosticCode(mismatch_facts) !=
            "let_type_mismatch" {
        return false;
    }

    let unknown: AstTreeArtifact = AstTreeArtifactFromText(
        "Program:\n  Function: Main\n    Parameters:\n    Returns: Void\n    Body:\n      Block:\n        Let: bad : Int = Mystery()\n"
    );
    let unknown_signatures: SemanticAstFunctionSignatureFacts =
        SemanticAstFunctionSignatureFactsFromArtifact(unknown);
    let unknown_constructors: SemanticAstNominalConstructorFacts =
        SemanticAstNominalConstructorFactsFromArtifact(unknown);
    let unknown_locals: SemanticAstLocalBindingFacts =
        SemanticAstLocalBindingFactsFromArtifact(unknown, unknown_signatures);
    let unknown_expression_surfaces: SemanticAstExpressionSurfaceFacts =
        SemanticAstExpressionSurfaceFactsFromArtifactCompactBridge(unknown);
    let unknown_facts: SemanticAstInitializerTypeFacts =
        SemanticAstInitializerTypeFactsFromArtifact(
            unknown, unknown_signatures, unknown_constructors, unknown_locals,
            unknown_expression_surfaces
        );
    return SemanticAstInitializerTypeFactsReadyProjection(
            unknown, unknown_locals, unknown_facts
        ) && !SemanticAstInitializerTypesAllVerified(unknown_facts) &&
        SemanticAstInitializerFirstDiagnosticCode(unknown_facts) ==
            "undefined_function";
}
