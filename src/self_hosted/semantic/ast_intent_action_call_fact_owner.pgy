// Exact subject-action return fact for an intent `on` expression.
import "ast_signature_fact_owner.pgy";
import "ast_intent_signature_fact_owner.pgy";
import "../hir/ast_text_scan_owner.pgy";

struct SemanticAstIntentActionCallFact {
    ok: Bool;
    receiver_alias: String;
    action_name: String;
    signature_index: Int;
    return_type_name: String;
}

// One resolved actor for the legacy executable-intent emitter.  `who` is an
// actor/provenance fact, not an authority fact.  The resolution order mirrors
// the native semantic owner: explicit who, direct on-call receiver, unique
// participant action named by the step, then the sole subject participant.
struct SemanticAstIntentStepActorFact {
    ok: Bool;
    actor_alias: String;
    provenance: String;
}

func SemanticAstIntentActionSignatureIndex(
    signatures: SemanticAstFunctionSignatureFacts,
    owner_name: String,
    action_name: String
) -> Int {
    let i: Int = 0;
    while i < SemanticAstFunctionSignatureCount(signatures) {
        if signatures.action_contracts.is_actions[i] &&
            signatures.owner_names[i] == owner_name &&
            signatures.names[i] == action_name {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

func SemanticAstIntentActionCallFromText(
    signatures: SemanticAstFunctionSignatureFacts,
    participant_aliases: Array<String>,
    participant_types: Array<String>,
    participant_is_values: Array<Bool>,
    participant_start: Int,
    participant_count: Int,
    text: String
) -> SemanticAstIntentActionCallFact {
    let dot: Int = StringIndexOf(text, ".");
    let open: Int = StringIndexOf(text, "(");
    if dot <= 0 || open <= dot + 1 {
        return SemanticAstIntentActionCallFact(false, "", "", -1, "");
    }
    let receiver: String = StringTrim(Substring(text, 0, dot));
    let action: String = StringTrim(Substring(
        text, dot + 1, open - dot - 1
    ));
    if !IsIdentifier(receiver) || !IsIdentifier(action) {
        return SemanticAstIntentActionCallFact(false, "", "", -1, "");
    }
    let participant_row: Int = -1;
    let i: Int = 0;
    while i < participant_count {
        let row: Int = participant_start + i;
        if row < 0 || row >= ArrayLength(participant_aliases) ||
            row >= ArrayLength(participant_types) ||
            row >= ArrayLength(participant_is_values) {
            return SemanticAstIntentActionCallFact(false, "", "", -1, "");
        }
        if participant_aliases[row] == receiver {
            if participant_row >= 0 {
                return SemanticAstIntentActionCallFact(
                    false, "", "", -1, ""
                );
            }
            participant_row = row;
        }
        i = i + 1;
    }
    if participant_row < 0 || participant_is_values[participant_row] {
        return SemanticAstIntentActionCallFact(false, "", "", -1, "");
    }
    let signature_index: Int = SemanticAstIntentActionSignatureIndex(
        signatures, participant_types[participant_row], action
    );
    if signature_index < 0 ||
        signature_index >= ArrayLength(signatures.return_types) {
        return SemanticAstIntentActionCallFact(false, "", "", -1, "");
    }
    return SemanticAstIntentActionCallFact(
        true, receiver, action, signature_index,
        signatures.return_types[signature_index]
    );
}

func SemanticAstIntentStepActorFromFacts(
    signatures: SemanticAstFunctionSignatureFacts,
    ref intents: SemanticAstIntentSignatureFacts,
    intent_index: Int,
    step_header_text: String,
    on_text: String,
    explicit_actor: String
) -> SemanticAstIntentStepActorFact {
    if intent_index < 0 ||
        intent_index >= ArrayLength(intents.param_starts) ||
        intent_index >= ArrayLength(intents.param_counts) {
        return SemanticAstIntentStepActorFact(false, "", "intent-range");
    }
    let start: Int = intents.param_starts[intent_index];
    let count: Int = intents.param_counts[intent_index];
    if start < 0 || count < 0 ||
        start + count > ArrayLength(intents.param_names) ||
        start + count > ArrayLength(intents.param_types) ||
        start + count > ArrayLength(intents.param_is_values) {
        return SemanticAstIntentStepActorFact(false, "", "participant-range");
    }

    if explicit_actor != "" {
        if !IsIdentifier(explicit_actor) {
            return SemanticAstIntentStepActorFact(false, "", "explicit-who");
        }
        let explicit_row: Int = start;
        while explicit_row < start + count {
            if intents.param_names[explicit_row] == explicit_actor {
                if intents.param_is_values[explicit_row] {
                    return SemanticAstIntentStepActorFact(
                        false, "", "explicit-who-value"
                    );
                }
                return SemanticAstIntentStepActorFact(
                    true, explicit_actor, "explicit-who"
                );
            }
            explicit_row = explicit_row + 1;
        }
        return SemanticAstIntentStepActorFact(
            false, "", "explicit-who-undeclared"
        );
    }

    let on_call: SemanticAstIntentActionCallFact =
        SemanticAstIntentActionCallFromText(
            signatures, intents.param_names, intents.param_types,
            intents.param_is_values, start, count, on_text
        );
    if on_call.ok {
        return SemanticAstIntentStepActorFact(
            true, on_call.receiver_alias, "on-receiver"
        );
    }

    let first_space: Int = StringIndexOf(step_header_text, " ");
    let step_name: String = step_header_text;
    if first_space >= 0 {
        step_name = Substring(step_header_text, 0, first_space);
    }
    if !IsIdentifier(step_name) {
        return SemanticAstIntentStepActorFact(false, "", "step-name");
    }
    let action_actor: String = "";
    let row: Int = start;
    while row < start + count {
        if !intents.param_is_values[row] &&
            SemanticAstIntentActionSignatureIndex(
                signatures, intents.param_types[row], step_name
            ) >= 0 {
            if action_actor != "" {
                return SemanticAstIntentStepActorFact(
                    false, "", "step-action-ambiguous"
                );
            }
            action_actor = intents.param_names[row];
        }
        row = row + 1;
    }
    if action_actor != "" {
        return SemanticAstIntentStepActorFact(
            true, action_actor, "step-action"
        );
    }

    let sole_actor: String = "";
    row = start;
    while row < start + count {
        if !intents.param_is_values[row] {
            if sole_actor != "" {
                return SemanticAstIntentStepActorFact(
                    false, "", "single-participant-ambiguous"
                );
            }
            sole_actor = intents.param_names[row];
        }
        row = row + 1;
    }
    if sole_actor != "" {
        return SemanticAstIntentStepActorFact(
            true, sole_actor, "single-participant"
        );
    }
    return SemanticAstIntentStepActorFact(false, "", "who-unresolved");
}
