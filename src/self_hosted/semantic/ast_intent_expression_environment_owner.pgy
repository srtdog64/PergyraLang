// Environment dispatcher for expression rows nested under an intent.
import "ast_intent_signature_fact_owner.pgy";
import "ast_signature_fact_owner.pgy";
import "ast_intent_parameter_environment_owner.pgy";
import "ast_intent_outcome_environment_owner.pgy";
import "../hir/ast_text_arena_projection_owner.pgy";

func SemanticAstIntentExpressionOwnerNodeId(
    artifact: AstTreeArtifact,
    expression_node_id: Int
) -> Option<Int> {
    if TypedAstArenaNodeKindIs(
        artifact.arena, expression_node_id, TypedAstKindIntentPriorityTag()
    ) {
        let priority_owner: Option<Int> = TypedAstArenaParentId(
            artifact.arena, expression_node_id
        );
        if IsSome(priority_owner) && TypedAstArenaNodeKindIs(
            artifact.arena, UnwrapOption(priority_owner),
            TypedAstKindIntentDeclTag()
        ) { return priority_owner; }
        return None;
    }
    if TypedAstArenaNodeKindIs(
        artifact.arena, expression_node_id,
        TypedAstKindIntentTerminalSuccessTag()
    ) || TypedAstArenaNodeKindIs(
        artifact.arena, expression_node_id,
        TypedAstKindIntentTerminalFailureTag()
    ) {
        let terminal_owner: Option<Int> = TypedAstArenaParentId(
            artifact.arena, expression_node_id
        );
        if IsSome(terminal_owner) && TypedAstArenaNodeKindIs(
            artifact.arena, UnwrapOption(terminal_owner),
            TypedAstKindIntentDeclTag()
        ) { return terminal_owner; }
        return None;
    }
    if !TypedAstArenaNodeKindIs(
        artifact.arena, expression_node_id, TypedAstKindIntentStepOnTag()
    ) && !TypedAstArenaNodeKindIs(
        artifact.arena, expression_node_id,
        TypedAstKindIntentStepCompensateTag()
    ) && !TypedAstArenaNodeKindIs(
        artifact.arena, expression_node_id, TypedAstKindIntentStepGuardTag()
    ) && !TypedAstArenaNodeKindIs(
        artifact.arena, expression_node_id, TypedAstKindIntentStepPostTag()
    ) && !TypedAstArenaNodeKindIs(
        artifact.arena, expression_node_id, TypedAstKindIntentStepExpectTag()
    ) && !TypedAstArenaNodeKindIs(
        artifact.arena, expression_node_id, TypedAstKindIntentStepIntentTag()
    ) && !TypedAstArenaNodeKindIs(
        artifact.arena, expression_node_id, TypedAstKindIntentStepOnTag()
    ) {
        return None;
    }
    let step: Option<Int> = TypedAstArenaParentId(
        artifact.arena, expression_node_id
    );
    if !IsSome(step) || !TypedAstArenaNodeKindIs(
        artifact.arena, UnwrapOption(step), TypedAstKindIntentStepTag()
    ) {
        return None;
    }
    let owner_node: Option<Int> = TypedAstArenaParentId(
        artifact.arena, UnwrapOption(step)
    );
    if !IsSome(owner_node) || !TypedAstArenaNodeKindIs(
        artifact.arena, UnwrapOption(owner_node), TypedAstKindIntentDeclTag()
    ) {
        return None;
    }
    return owner_node;
}

func SemanticAstIntentExpressionSeedEnvironment(
    artifact: AstTreeArtifact,
    signatures: SemanticAstFunctionSignatureFacts,
    ref facts: SemanticAstIntentSignatureFacts,
    ref transitions: SemanticAstIntentTransitionFacts,
    intent_node_id: Int,
    expression_node_id: Int,
    inout names: Array<String>,
    inout types: Array<String>,
    inout modes: Array<String>
) -> Bool {
    return SemanticAstIntentExpressionSeedParameters(
        facts, intent_node_id, names, types, modes
    ) && SemanticAstIntentExpressionSeedOutcome(
        artifact, signatures, facts, transitions,
        intent_node_id, expression_node_id,
        names, types, modes
    );
}
