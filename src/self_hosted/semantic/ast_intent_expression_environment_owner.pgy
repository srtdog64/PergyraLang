// Environment dispatcher for expression rows nested under an intent.
import "ast_intent_signature_fact_owner.pgy";
import "ast_signature_fact_owner.pgy";
import "ast_intent_parameter_environment_owner.pgy";
import "ast_intent_outcome_environment_owner.pgy";
import "../hir/ast_text_arena_projection_owner.pgy";


func SemanticAstIntentExpressionSeedEnvironment(
    artifact: AstTreeArtifact,
    signatures: SemanticAstFunctionSignatureFacts,
    ref facts: SemanticAstIntentSignatureFacts,
    ref transitions: SemanticAstIntentTransitionFacts,
    intent_node_id: Int,
    expression_node_id: Int,
    inout names: Array<String>,
    inout types: Array<String>,
    inout modes: Array<String>
) -> Bool {
    return SemanticAstIntentExpressionSeedParameters(
        facts, intent_node_id, names, types, modes
    ) && SemanticAstIntentExpressionSeedOutcome(
        artifact, signatures, facts, transitions,
        intent_node_id, expression_node_id,
        names, types, modes
    );
}
