// Ordered participant/value environment rows owned by one intent signature.
import "ast_intent_signature_fact_owner.pgy";

func SemanticAstIntentExpressionSeedParameters(
    ref facts: SemanticAstIntentSignatureFacts,
    intent_node_id: Int,
    inout names: Array<String>,
    inout types: Array<String>,
    inout modes: Array<String>
) -> Bool {
    let intent_index: Int = -1;
    let i: Int = 0;
    while i < SemanticAstIntentSignatureCount(facts) {
        if facts.intent_node_ids[i] == intent_node_id {
            if intent_index >= 0 { return false; }
            intent_index = i;
        }
        i = i + 1;
    }
    if intent_index < 0 { return false; }
    let p: Int = 0;
    while p < facts.param_counts[intent_index] {
        let row: Int = facts.param_starts[intent_index] + p;
        if row < 0 || row >= ArrayLength(facts.param_names) ||
            facts.param_names[row] == "" || facts.param_types[row] == "" {
            return false;
        }
        let prior: Int = 0;
        while prior < ArrayLength(names) {
            if names[prior] == facts.param_names[row] { return false; }
            prior = prior + 1;
        }
        ArrayPush(names, facts.param_names[row]);
        ArrayPush(types, facts.param_types[row]);
        if facts.param_is_values[row] {
            ArrayPush(modes, "intent_value");
        } else {
            ArrayPush(modes, "intent_participant");
        }
        p = p + 1;
    }
    return ArrayLength(names) == ArrayLength(types) &&
        ArrayLength(names) == ArrayLength(modes);
}
