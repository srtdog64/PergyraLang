// Canonical typed-intent row parsing and enum-scoped variant seals.

import "../hir/ast_text_scan_owner.pgy";
import "ast_enum_fact_owner.pgy";

struct SemanticAstIntentVariantBindingRow {
    ok: Bool;
    variant_name: String;
    payload_name: String;
}

struct SemanticAstIntentStepHeaderRow {
    ok: Bool;
    name: String;
    predecessor_name: String;
    where_zone_name: String;
    using_alias: String;
    intent_text: String;
    transfer_from_alias: String;
    transfer_to_alias: String;
}

struct SemanticAstIntentVariantSeal {
    ok: Bool;
    enum_node_id: Int;
    variant_index: Int;
    payload_type_name: String;
}

func SemanticAstIntentVariantBindingFromText(
    text: String
) -> SemanticAstIntentVariantBindingRow {
    let open: Int = StringIndexOf(text, "(");
    let close: Int = StringIndexOf(text, ")");
    if open <= 0 || close != StringLength(text) - 1 ||
        StringIndexOf(Substring(text, open + 1, close - open - 1), ",") >= 0 {
        return SemanticAstIntentVariantBindingRow(false, "", "");
    }
    let variant_name: String = Substring(text, 0, open);
    let payload_name: String = Substring(text, open + 1, close - open - 1);
    return SemanticAstIntentVariantBindingRow(
        IsIdentifier(variant_name) && IsIdentifier(payload_name),
        variant_name, payload_name
    );
}

func SemanticAstIntentStepHeaderFromText(
    text: String
) -> SemanticAstIntentStepHeaderRow {
    if text == "" {
        return SemanticAstIntentStepHeaderRow(
            false, "", "", "", "", "", "", ""
        );
    }
    let where_at: Int = StringIndexOf(text, " where ");
    let using_at: Int = StringIndexOf(text, " using ");
    let intent_at: Int = StringIndexOf(text, " intent ");
    let transfer_at: Int = StringIndexOf(text, " transfer ");
    if (where_at >= 0 && using_at >= 0 && using_at < where_at) ||
        (where_at >= 0 && intent_at >= 0 && intent_at < where_at) ||
        (where_at >= 0 && transfer_at >= 0 && transfer_at < where_at) ||
        (using_at >= 0 && intent_at >= 0 && intent_at < using_at) ||
        (using_at >= 0 && transfer_at >= 0 && transfer_at < using_at) ||
        (intent_at >= 0 && transfer_at >= 0 && transfer_at < intent_at) {
        return SemanticAstIntentStepHeaderRow(
            false, "", "", "", "", "", "", ""
        );
    }
    let name_end: Int = StringLength(text);
    if where_at >= 0 { name_end = where_at; }
    if using_at >= 0 && using_at < name_end { name_end = using_at; }
    if intent_at >= 0 && intent_at < name_end { name_end = intent_at; }
    if transfer_at >= 0 && transfer_at < name_end { name_end = transfer_at; }
    let topology: String = StringTrim(Substring(text, 0, name_end));
    let after_at: Int = StringIndexOf(topology, " after ");
    let name: String = topology;
    let predecessor_name: String = "";
    if after_at >= 0 {
        name = Substring(topology, 0, after_at);
        predecessor_name = Substring(
            topology, after_at + 7, StringLength(topology) - after_at - 7
        );
    }
    let where_zone_name: String = "";
    if where_at >= 0 {
        let where_end: Int = StringLength(text);
        if using_at > where_at && using_at < where_end {
            where_end = using_at;
        }
        if intent_at > where_at && intent_at < where_end {
            where_end = intent_at;
        }
        if transfer_at > where_at && transfer_at < where_end {
            where_end = transfer_at;
        }
        where_zone_name = StringTrim(Substring(
            text, where_at + 7, where_end - where_at - 7
        ));
    }
    let using_alias: String = "";
    if using_at >= 0 {
        let using_start: Int = using_at + StringLength(" using ");
        let using_end: Int = StringLength(text);
        if intent_at > using_at { using_end = intent_at; }
        if transfer_at > using_at && transfer_at < using_end {
            using_end = transfer_at;
        }
        if using_end > using_start {
            using_alias = StringTrim(Substring(
                text, using_start, using_end - using_start
            ));
        }
    }
    let intent_text: String = "";
    if intent_at >= 0 {
        let intent_end: Int = StringLength(text);
        if transfer_at > intent_at { intent_end = transfer_at; }
        intent_text = StringTrim(Substring(
            text, intent_at + 8, intent_end - intent_at - 8
        ));
    }
    let transfer_from: String = "";
    let transfer_to: String = "";
    if transfer_at >= 0 {
        let transfer: String = StringTrim(Substring(
            text, transfer_at + 10, StringLength(text) - transfer_at - 10
        ));
        let arrow: Int = StringIndexOf(transfer, " -> ");
        if arrow <= 0 || StringIndexOf(
            Substring(transfer, arrow + 4, StringLength(transfer) - arrow - 4),
            " -> "
        ) >= 0 {
            return SemanticAstIntentStepHeaderRow(
                false, "", "", "", "", "", "", ""
            );
        }
        transfer_from = StringTrim(Substring(transfer, 0, arrow));
        transfer_to = StringTrim(Substring(
            transfer, arrow + 4, StringLength(transfer) - arrow - 4
        ));
    }
    let canonical: String = name;
    if predecessor_name != "" {
        canonical = Concat(canonical, Concat(" after ", predecessor_name));
    }
    if where_zone_name != "" {
        canonical = Concat(canonical, Concat(" where ", where_zone_name));
    }
    if using_alias != "" {
        canonical = Concat(canonical, Concat(" using ", using_alias));
    }
    if intent_text != "" {
        canonical = Concat(canonical, Concat(" intent ", intent_text));
    }
    if transfer_from != "" && transfer_to != "" {
        canonical = Concat(canonical, Concat(
            " transfer ", Concat(transfer_from, Concat(" -> ", transfer_to))
        ));
    }
    return SemanticAstIntentStepHeaderRow(
        IsIdentifier(name) &&
            (predecessor_name == "" || IsIdentifier(predecessor_name)) &&
            (where_zone_name == "" || IsIdentifier(where_zone_name)) &&
            (using_alias == "" || IsIdentifier(using_alias)) &&
            (transfer_from == "" || IsIdentifier(transfer_from)) &&
            (transfer_to == "" || IsIdentifier(transfer_to)) &&
            canonical == text,
        name, predecessor_name, where_zone_name, using_alias, intent_text,
        transfer_from, transfer_to
    );
}

func SemanticAstIntentExactVariantSeal(
    ref enums: SemanticAstEnumFacts,
    enum_name: String,
    variant_name: String
) -> SemanticAstIntentVariantSeal {
    let enum_node_id: Int = -1;
    let enum_matches: Int = 0;
    let e: Int = 0;
    while e < ArrayLength(enums.enum_names) {
        if enums.enum_names[e] == enum_name {
            enum_matches = enum_matches + 1;
            enum_node_id = enums.node_ids[e];
        }
        e = e + 1;
    }
    let variant_index: Int = -1;
    let variant_matches: Int = 0;
    let local_index: Int = 0;
    let row: Int = 0;
    let payload_type_name: String = "";
    while row < ArrayLength(enums.variant_names) {
        if enums.variant_enum_names[row] == enum_name {
            if enums.variant_names[row] == variant_name {
                variant_matches = variant_matches + 1;
                variant_index = local_index;
                if enums.variant_param_counts[row] == 1 {
                    payload_type_name = enums.variant_param_type_names[
                        enums.variant_param_starts[row]
                    ];
                }
            }
            local_index = local_index + 1;
        }
        row = row + 1;
    }
    return SemanticAstIntentVariantSeal(
        enum_matches == 1 && variant_matches == 1 &&
            variant_index >= 0 && payload_type_name != "",
        enum_node_id, variant_index, payload_type_name
    );
}
