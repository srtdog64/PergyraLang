// Semantic for-loop header and binding type facts.
//
// The parser artifact owns loop variable/start/end payloads. This owner proves
// range bounds or foreach collection type and exposes the binding type to body
// expression environments. Consumers may not recover it from source text.

import "ast_statement_fact_owner.pgy";
import "ast_signature_artifact_match_owner.pgy";
import "ast_initializer_type_fact_owner.pgy";
import "ast_expression_environment_owner.pgy";
import "ast_expression_surface_fact_owner.pgy";
import "ast_expression_verdict_owner.pgy";
import "ast_expression_graph_view_owner.pgy";
import "ast_enum_fact_owner.pgy";
import "ast_match_binding_environment_owner.pgy";

struct SemanticAstIterationTypeFacts {
    ok: Bool;
    diagnostic_code: String;
    diagnostic_message: String;
    artifact_node_count: Int;
    node_ids: Array<Int>;
    binding_type_names: Array<String>;
    iterable_type_names: Array<String>;
    collection_hoists: Array<Int>;
    verified: Array<Int>;
    diagnostic_codes: Array<String>;
    diagnostic_messages: Array<String>;
}

func SemanticAstIterationTypeStructuralError(
    artifact: AstTreeArtifact
) -> SemanticAstIterationTypeFacts {
    let empty_ints: Array<Int> = [];
    let empty_strings: Array<String> = [];
    return SemanticAstIterationTypeFacts(
        false, "ast_artifact_invalid",
        SemanticError2(
            "ast_artifact_invalid",
            "node_count", ToString(artifact.count),
            "owner", "SemanticAstIterationTypeFacts"
        ),
        artifact.count, empty_ints, empty_strings, empty_strings, empty_ints,
        empty_ints, empty_strings, empty_strings
    );
}

func SemanticAstIterationCollectionIsBoundIdentifier(
    expression_surfaces: SemanticAstExpressionSurfaceFacts,
    node_id: Int,
    names: Array<String>
) -> Bool {
    let root: Option<Int> =
        SemanticAstExpressionGraphRootForNode(
            expression_surfaces, node_id, AstExpressionLaneValue()
        );
    if !IsSome(root) { return false; }
    let root_kind: Option<Int> = SemanticExpressionGraphNodeKind(
        expression_surfaces.expression_graph, UnwrapOption(root)
    );
    let root_text: Option<String> = SemanticExpressionGraphNodeText(
        expression_surfaces.expression_graph, UnwrapOption(root)
    );
    if !IsSome(root_kind) || !IsSome(root_text) ||
        UnwrapOption(root_kind) != AstExpressionNodeLeaf() {
        return false;
    }
    let name: String = UnwrapOption(root_text);
    let i: Int = 0;
    while i < ArrayLength(names) {
        if names[i] == name { return true; }
        i = i + 1;
    }
    return false;
}

func SemanticAstIterationSeedVisibleRows(
    artifact: AstTreeArtifact,
    statements: SemanticAstStatementFacts,
    iteration_node_ids: Array<Int>,
    binding_type_names: Array<String>,
    iteration_verified: Array<Int>,
    function_node_id: Int,
    use_node_id: Int,
    inout names: Array<String>,
    inout types: Array<String>,
    inout modes: Array<String>
) -> Bool {
    if ArrayLength(iteration_node_ids) != ArrayLength(binding_type_names) ||
        ArrayLength(iteration_node_ids) != ArrayLength(iteration_verified) {
        return false;
    }
    let i: Int = 0;
    while i < ArrayLength(iteration_node_ids) {
        if iteration_verified[i] != 1 {
            i = i + 1;
            continue;
        }
        let statement_index_opt: Option<Int> =
            SemanticAstStatementIndexForNode(
                statements, iteration_node_ids[i]
            );
        if !IsSome(statement_index_opt) {
            return false;
        }
        let statement_index: Int = UnwrapOption(statement_index_opt);
        let visible: Bool = SemanticAstExpressionScopeVisible(
            artifact.arena, iteration_node_ids[i], use_node_id
        );
        if statements.function_node_ids[statement_index] == function_node_id &&
            iteration_node_ids[i] < use_node_id && visible {
            let binding_type: String = binding_type_names[i];
            if binding_type == "" || binding_type == "Unknown" {
                return false;
            }
            ArrayPush(names, statements.payload_texts[statement_index]);
            ArrayPush(types, binding_type);
            ArrayPush(modes, "loop_binding");
        }
        i = i + 1;
    }
    return true;
}

func SemanticAstIterationTypeFactsFromArtifact(
    artifact: AstTreeArtifact,
    signatures: SemanticAstFunctionSignatureFacts,
    constructors: SemanticAstNominalConstructorFacts,
    locals: SemanticAstLocalBindingFacts,
    initializer_types: SemanticAstInitializerTypeFacts,
    statements: SemanticAstStatementFacts,
    expression_surfaces: SemanticAstExpressionSurfaceFacts
) -> SemanticAstIterationTypeFacts {
    if !AstTreeArtifactReady(artifact) ||
        !SemanticAstFunctionSignatureFactsMatchArtifact(
            artifact, signatures
        ) || !SemanticAstNominalConstructorFactsMatchArtifact(
            artifact, constructors
        ) || !SemanticAstLocalBindingFactsMatchArtifact(
            artifact, signatures, locals
        ) || !SemanticAstInitializerTypeFactsReadyProjection(
            artifact, locals, initializer_types
         ) || !SemanticAstStatementFactsMatchArtifact(
             artifact, signatures, statements
         ) || !SemanticAstExpressionSurfaceFactsMatchArtifact(
             artifact, expression_surfaces
         ) {
        return SemanticAstIterationTypeStructuralError(artifact);
    }
    let function_names: Array<String> = [];
    let function_returns: Array<String> = [];
    let function_params: Array<String> = [];
    let enum_facts: SemanticAstEnumFacts =
        SemanticAstEnumFactsFromArtifact(artifact);
    if !enum_facts.ok {
        return SemanticAstIterationTypeStructuralError(artifact);
    }
    if !SemanticAstExpressionFunctionTables(
        signatures, constructors, enum_facts,
        function_names, function_returns, function_params
    ) {
        return SemanticAstIterationTypeStructuralError(artifact);
    }
    let member_root_names: Array<String> = [];
    if !SemanticAstExpressionMemberRootNames(
        constructors, enum_facts, member_root_names
    ) {
        return SemanticAstIterationTypeStructuralError(artifact);
    }

    let node_ids: Array<Int> = [];
    let binding_types: Array<String> = [];
    let iterable_types: Array<String> = [];
    let collection_hoists: Array<Int> = [];
    let verified: Array<Int> = [];
    let diagnostic_codes: Array<String> = [];
    let diagnostic_messages: Array<String> = [];
    let i: Int = 0;
    while i < SemanticAstStatementCount(statements) {
        if statements.kind_tags[i] != TypedAstKindForStmtTag() {
            i = i + 1;
            continue;
        }
        let names: Array<String> = [];
        let types: Array<String> = [];
        let modes: Array<String> = [];
        if !SemanticAstExpressionSeedEnumValues(
            enum_facts, names, types, modes
        ) || !SemanticAstExpressionSeedOwnerFields(
            signatures, constructors, statements.function_node_ids[i],
            names, types, modes
        ) || !SemanticAstExpressionSeedParameters(
            signatures, statements.function_node_ids[i], names, types
        ) || !SemanticAstExpressionSeedParameterModes(
            signatures, statements.function_node_ids[i], modes
        ) || !SemanticAstExpressionSeedVisibleLocals(
            artifact, locals, initializer_types.inferred_type_names,
            statements.function_node_ids[i], statements.node_ids[i],
            names, types
        ) || !SemanticAstExpressionSeedVisibleLocalModes(
            artifact, locals, statements.function_node_ids[i],
            statements.node_ids[i], modes
        ) || !SemanticAstIterationSeedVisibleRows(
            artifact, statements, node_ids, binding_types, verified,
            statements.function_node_ids[i], statements.node_ids[i],
            names, types, modes
        ) || !SemanticAstExpressionSeedVisibleMatchBindings(
            artifact, expression_surfaces, signatures, constructors,
            statements.function_node_ids[i], statements.node_ids[i],
            names, types, modes
        ) || ArrayLength(names) != ArrayLength(modes) {
            return SemanticAstIterationTypeStructuralError(artifact);
        }

        let binding_type: String = "";
        let iterable_type: String = "";
        let collection_hoist: Int = 0;
        let row_verified: Int = 1;
        let row_code: String = "";
        let row_message: String = "";
        let first_root: Option<Int> =
            SemanticAstExpressionGraphRootForNode(
                expression_surfaces, statements.node_ids[i],
                AstExpressionLaneValue()
            );
        if !IsSome(first_root) {
            return SemanticAstIterationTypeStructuralError(artifact);
        }
        let first: SemanticAstExpressionVerdict =
            SemanticAstExpressionVerdictFromGraph(
                statements.value_texts[i],
                expression_surfaces.expression_graph,
                UnwrapOption(first_root), constructors, signatures,
                names, types, modes,
                function_names, function_returns, function_params,
                member_root_names
            );
        if !first.ok {
            row_verified = 0;
            row_code = first.diagnostic_code;
            row_message = first.diagnostic_message;
        } else if statements.auxiliary_texts[i] != "" {
            iterable_type = first.inferred_type_name;
            let last_root: Option<Int> =
                SemanticAstExpressionGraphRootForNode(
                    expression_surfaces, statements.node_ids[i],
                    AstExpressionLaneAuxiliary()
                );
            if !IsSome(last_root) {
                return SemanticAstIterationTypeStructuralError(artifact);
            }
            let last: SemanticAstExpressionVerdict =
                SemanticAstExpressionVerdictFromGraph(
                    statements.auxiliary_texts[i],
                    expression_surfaces.expression_graph,
                    UnwrapOption(last_root), constructors, signatures,
                    names, types, modes,
                    function_names, function_returns, function_params,
                    member_root_names
                );
            binding_type = "Int";
            if !last.ok {
                row_verified = 0;
                row_code = last.diagnostic_code;
                row_message = last.diagnostic_message;
            } else if first.inferred_type_name != "Int" ||
                last.inferred_type_name != "Int" {
                row_verified = 0;
                row_code = "statement_type_unresolved";
                row_message = SemanticError2(
                    "statement_type_unresolved",
                    "statement", "for_range",
                    "actual", Concat(
                        first.inferred_type_name,
                        Concat("..", last.inferred_type_name)
                    )
                );
            }
        } else {
            iterable_type = first.inferred_type_name;
            if StartsWith(iterable_type, "Array<") &&
                StringLength(iterable_type) > 7 &&
                CharAt(iterable_type, StringLength(iterable_type) - 1) == ">" {
                binding_type = Substring(
                    iterable_type, 6, StringLength(iterable_type) - 7
                );
                if !SemanticAstIterationCollectionIsBoundIdentifier(
                    expression_surfaces, statements.node_ids[i], names
                ) {
                    collection_hoist = 1;
                }
            } else {
                row_verified = 0;
                row_code = "statement_type_unresolved";
                row_message = SemanticError2(
                    "statement_type_unresolved",
                    "statement", "for_each",
                    "actual", iterable_type
                );
            }
        }
        ArrayPush(node_ids, statements.node_ids[i]);
        ArrayPush(binding_types, binding_type);
        ArrayPush(iterable_types, iterable_type);
        ArrayPush(collection_hoists, collection_hoist);
        ArrayPush(verified, row_verified);
        ArrayPush(diagnostic_codes, row_code);
        ArrayPush(diagnostic_messages, row_message);
        i = i + 1;
    }
    return SemanticAstIterationTypeFacts(
        true, "", "", artifact.count, node_ids, binding_types,
        iterable_types, collection_hoists, verified, diagnostic_codes,
        diagnostic_messages
    );
}

func SemanticAstIterationTypeCount(
    facts: SemanticAstIterationTypeFacts
) -> Int {
    return ArrayLength(facts.node_ids);
}

func SemanticAstIterationSeedVisibleBindings(
    artifact: AstTreeArtifact,
    statements: SemanticAstStatementFacts,
    facts: SemanticAstIterationTypeFacts,
    function_node_id: Int,
    use_node_id: Int,
    inout names: Array<String>,
    inout types: Array<String>,
    inout modes: Array<String>
) -> Bool {
    if !facts.ok || facts.artifact_node_count != artifact.count {
        return false;
    }
    let seeded: Bool = SemanticAstIterationSeedVisibleRows(
        artifact, statements, facts.node_ids, facts.binding_type_names,
        facts.verified,
        function_node_id, use_node_id, names, types, modes
    );
    return seeded;
}

func SemanticAstIterationTypeFactsMatchArtifact(
    artifact: AstTreeArtifact,
    signatures: SemanticAstFunctionSignatureFacts,
    constructors: SemanticAstNominalConstructorFacts,
    locals: SemanticAstLocalBindingFacts,
    initializer_types: SemanticAstInitializerTypeFacts,
    statements: SemanticAstStatementFacts,
    expression_surfaces: SemanticAstExpressionSurfaceFacts,
    facts: SemanticAstIterationTypeFacts
) -> Bool {
    let rebuilt: SemanticAstIterationTypeFacts =
        SemanticAstIterationTypeFactsFromArtifact(
            artifact, signatures, constructors, locals, initializer_types,
            statements, expression_surfaces
        );
    let n: Int = SemanticAstIterationTypeCount(facts);
    if !facts.ok || !rebuilt.ok ||
        facts.artifact_node_count != artifact.count ||
        SemanticAstIterationTypeCount(rebuilt) != n ||
        ArrayLength(facts.binding_type_names) != n ||
        ArrayLength(facts.iterable_type_names) != n ||
        ArrayLength(facts.collection_hoists) != n ||
        ArrayLength(facts.verified) != n ||
        ArrayLength(facts.diagnostic_codes) != n ||
        ArrayLength(facts.diagnostic_messages) != n {
        return false;
    }
    let i: Int = 0;
    while i < n {
        if rebuilt.node_ids[i] != facts.node_ids[i] ||
            rebuilt.binding_type_names[i] != facts.binding_type_names[i] ||
            rebuilt.iterable_type_names[i] != facts.iterable_type_names[i] ||
            rebuilt.collection_hoists[i] != facts.collection_hoists[i] ||
            rebuilt.verified[i] != facts.verified[i] ||
            rebuilt.diagnostic_codes[i] != facts.diagnostic_codes[i] ||
            rebuilt.diagnostic_messages[i] != facts.diagnostic_messages[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func SemanticAstIterationTypeFactsReadyForMirProjection(
    artifact: AstTreeArtifact,
    statements: SemanticAstStatementFacts,
    facts: SemanticAstIterationTypeFacts
) -> Bool {
    let count: Int = SemanticAstIterationTypeCount(facts);
    if !facts.ok || facts.artifact_node_count != artifact.count ||
        ArrayLength(facts.binding_type_names) != count ||
        ArrayLength(facts.iterable_type_names) != count ||
        ArrayLength(facts.collection_hoists) != count ||
        ArrayLength(facts.verified) != count ||
        ArrayLength(facts.diagnostic_codes) != count ||
        ArrayLength(facts.diagnostic_messages) != count {
        return false;
    }
    let i: Int = 0;
    while i < count {
        let statement_index: Option<Int> = SemanticAstStatementIndexForNode(
            statements, facts.node_ids[i]
        );
        if !IsSome(statement_index) || statements.kind_tags[
            UnwrapOption(statement_index)
        ] != TypedAstKindForStmtTag() ||
            facts.binding_type_names[i] == "" ||
            facts.binding_type_names[i] == "Unknown" ||
            facts.iterable_type_names[i] == "" ||
            facts.iterable_type_names[i] == "Unknown" ||
            (facts.collection_hoists[i] != 0 &&
             facts.collection_hoists[i] != 1) || facts.verified[i] != 1 ||
            facts.diagnostic_codes[i] != "" ||
            facts.diagnostic_messages[i] != "" {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func SemanticAstIterationTypeFactsContractReady() -> Bool {
    let artifact: AstTreeArtifact = AstTreeArtifactFromText(
        "Program:\n  Function: Main\n    Parameters:\n    Returns: Void\n    Body:\n      Block:\n        For: i in 0..3\n          Block:\n            Log(i)\n"
    );
    let signatures: SemanticAstFunctionSignatureFacts =
        SemanticAstFunctionSignatureFactsFromArtifact(artifact);
    let constructors: SemanticAstNominalConstructorFacts =
        SemanticAstNominalConstructorFactsFromArtifact(artifact);
    let locals: SemanticAstLocalBindingFacts =
        SemanticAstLocalBindingFactsFromArtifact(artifact, signatures);
    let expression_surfaces: SemanticAstExpressionSurfaceFacts =
        SemanticAstExpressionSurfaceFactsFromArtifactCompactBridge(artifact);
    let initializers: SemanticAstInitializerTypeFacts =
        SemanticAstInitializerTypeFactsFromArtifact(
            artifact, signatures, constructors, locals, expression_surfaces
        );
    let statements: SemanticAstStatementFacts =
        SemanticAstStatementFactsFromArtifact(artifact, signatures);
    let facts: SemanticAstIterationTypeFacts =
        SemanticAstIterationTypeFactsFromArtifact(
            artifact, signatures, constructors, locals, initializers,
            statements, expression_surfaces
        );
    return SemanticAstIterationTypeFactsMatchArtifact(
        artifact, signatures, constructors, locals, initializers,
        statements, expression_surfaces, facts
    ) && SemanticAstIterationTypeCount(facts) == 1 &&
        facts.verified[0] == 1 && facts.binding_type_names[0] == "Int" &&
        facts.iterable_type_names[0] == "Int" &&
        facts.collection_hoists[0] == 0;
}
