// Match-pattern bindings visible to semantic expression consumers.

import "../hir/ast_match_pattern_fact_owner.pgy";
import "ast_expression_graph_view_owner.pgy";
import "ast_expression_graph_receiver_type_owner.pgy";
import "ast_expression_environment_owner.pgy";
import "ast_expression_function_table_fact_owner.pgy";
import "ast_function_scope_fact_owner.pgy";
import "ast_enum_fact_owner.pgy";
import "env_owner.pgy";
import "wrapper_type_owner.pgy";

func SemanticAstExpressionSeedMatchCaseBindings(
    artifact: AstTreeArtifact,
    ref expression_surfaces: SemanticAstExpressionSurfaceFacts,
    ref constructors: SemanticAstNominalConstructorFacts,
    enums: SemanticAstEnumFacts,
    function_scopes: SemanticAstFunctionScopeFacts,
    function_tables: SemanticAstExpressionFunctionTableFacts,
    function_node_id: Int,
    case_node_id: Int,
    inout names: Array<String>,
    inout types: Array<String>,
    inout modes: Array<String>
) -> Bool {
    let pattern: AstMatchCasePatternFact =
        AstMatchCasePatternFactFromArtifact(artifact, case_node_id);
    let case_function: Option<Int> = SemanticAstFunctionScopeNodeId(
        function_scopes, case_node_id
    );
    if !pattern.ok || !IsSome(case_function) ||
        UnwrapOption(case_function) != function_node_id {
        return false;
    }
    if pattern.variant == "None" {
        return ArrayLength(pattern.bindings) == 0;
    }
    if pattern.variant == "" &&
        ToString(ToInt(pattern.pattern)) == pattern.pattern {
        return ArrayLength(pattern.bindings) == 0;
    }
    let match_node: Option<Int> = TypedAstArenaParentId(
        artifact.arena, case_node_id
    );
    if !IsSome(match_node) || !TypedAstArenaNodeKindIs(
        artifact.arena, UnwrapOption(match_node), TypedAstKindMatchStmtTag()
    ) {
        return false;
    }
    let subject_root: Option<Int> = SemanticAstExpressionGraphRootForNode(
        expression_surfaces, UnwrapOption(match_node),
        AstExpressionLaneAtom()
    );
    if !IsSome(subject_root) {
        return false;
    }
    let subject_type_fact: Option<String> =
        SemanticExpressionGraphValueReceiverTypeName(
            expression_surfaces.expression_graph,
            UnwrapOption(subject_root), constructors, names, types,
            function_tables.names, function_tables.returns
        );
    if !IsSome(subject_type_fact) {
        return false;
    }
    let subject_type: String = UnwrapOption(subject_type_fact);
    if pattern.variant != "Some" && pattern.variant != "Ok" &&
        pattern.variant != "Err" {
        let variant_name: String = pattern.variant;
        if variant_name == "" {
            variant_name = pattern.pattern;
        }
        let enum_variant_index: Int = -1;
        let variant_count: Option<Int> =
            SemanticAstEnumVariantCountForName(enums, subject_type);
        if !IsSome(variant_count) { return false; }
        let variant_index: Int = 0;
        while variant_index < UnwrapOption(variant_count) {
            let candidate: Option<String> = SemanticAstEnumVariantNameAt(
                enums, subject_type, variant_index
            );
            if IsSome(candidate) && UnwrapOption(candidate) == variant_name {
                enum_variant_index = variant_index;
            }
            variant_index = variant_index + 1;
        }
        if enum_variant_index < 0 { return false; }
        let param_count: Option<Int> = SemanticAstEnumVariantParamCountAt(
            enums, subject_type, enum_variant_index
        );
        if !IsSome(param_count) || UnwrapOption(param_count) !=
            ArrayLength(pattern.bindings) {
            return false;
        }
        let binding_index: Int = 0;
        while binding_index < ArrayLength(pattern.bindings) {
            let payload_type: Option<String> =
                SemanticAstEnumVariantPayloadTypeAt(
                    enums, subject_type, variant_name, binding_index
                );
            if !IsSome(payload_type) || UnwrapOption(payload_type) == "" ||
                UnwrapOption(payload_type) == "Unknown" {
                return false;
            }
            ArrayPush(names, pattern.bindings[binding_index]);
            ArrayPush(types, UnwrapOption(payload_type));
            ArrayPush(modes, "match_binding");
            binding_index = binding_index + 1;
        }
        return true;
    }
    if ArrayLength(pattern.bindings) != 1 {
        return false;
    }
    let payload_type: Option<String> = None;
    if pattern.variant == "Some" {
        payload_type = OptionPayloadTypeOpt(subject_type);
    } else if pattern.variant == "Ok" {
        payload_type = ResultPayloadTypeOpt(subject_type);
    } else {
        payload_type = ResultErrorTypeOpt(subject_type);
    }
    if !IsSome(payload_type) || UnwrapOption(payload_type) == "" ||
        UnwrapOption(payload_type) == "Unknown" {
        return false;
    }
    ArrayPush(names, pattern.bindings[0]);
    ArrayPush(types, UnwrapOption(payload_type));
    ArrayPush(modes, "match_binding");
    return true;
}

func SemanticAstExpressionSeedVisibleMatchBindings(
    artifact: AstTreeArtifact,
    ref expression_surfaces: SemanticAstExpressionSurfaceFacts,
    signatures: SemanticAstFunctionSignatureFacts,
    constructors: SemanticAstNominalConstructorFacts,
    function_node_id: Int,
    use_node_id: Int,
    inout names: Array<String>,
    inout types: Array<String>,
    inout modes: Array<String>,
    function_tables: SemanticAstExpressionFunctionTableFacts
) -> Bool {
    if !AstTreeArtifactReady(artifact) || use_node_id < 0 ||
        use_node_id >= artifact.count {
        return false;
    }
    if !SemanticAstExpressionFunctionTableFactsReady(function_tables) {
        return false;
    }
    let case_nodes: Array<Int> = [];
    let cursor: Option<Int> = Some(use_node_id);
    let traversed: Int = 0;
    while IsSome(cursor) && traversed < artifact.count {
        let node_id: Int = UnwrapOption(cursor);
        if TypedAstArenaNodeKindIs(
            artifact.arena, node_id, TypedAstKindMatchCaseStmtTag()
        ) {
            ArrayPush(case_nodes, node_id);
        }
        cursor = TypedAstArenaParentId(artifact.arena, node_id);
        traversed = traversed + 1;
    }
    if ArrayLength(case_nodes) == 0 { return true; }
    if !SemanticAstExpressionSurfaceBorrowReady(
        artifact, expression_surfaces
    ) {
        return false;
    }
    let enums: SemanticAstEnumFacts =
        SemanticAstEnumFactsFromArtifact(artifact);
    if !enums.ok {
        return false;
    }
    let function_scopes: SemanticAstFunctionScopeFacts =
        SemanticAstFunctionScopeFactsFromArtifact(artifact);
    if !function_scopes.ok {
        return false;
    }
    let i: Int = ArrayLength(case_nodes) - 1;
    while i >= 0 {
        if !SemanticAstExpressionSeedMatchCaseBindings(
            artifact, expression_surfaces, constructors, enums,
            function_scopes, function_tables,
            function_node_id, case_nodes[i], names, types, modes
        ) {
            return false;
        }
        i = i - 1;
    }
    return true;
}
