// Semantic owner for target-neutral match scrutinee materialization facts.
//
// A non-scalar scrutinee is one source evaluation.  Its original expression
// graph remains the meaning owner; this fact adds one isolated binding graph
// that MIR may use after evaluating the original graph into a synthetic local.

import "ast_artifact_verdict_owner.pgy";
import "ast_statement_type_query_owner.pgy";
import "ast_expression_graph_node_view_owner.pgy";
import "ast_expression_surface_query_owner.pgy";

struct SemanticAstMatchMaterializationFacts {
    ok: Bool;
    artifact_node_count: Int;
    node_ids: Array<Int>;
    function_node_ids: Array<Int>;
    type_names: Array<String>;
    synthetic_names: Array<String>;
    synthetic_graph_root_ids: Array<Int>;
}
func SemanticAstMatchMaterializationError(
    artifact: AstTreeArtifact
) -> SemanticAstMatchMaterializationFacts {
    let ints: Array<Int> = [];
    let strings: Array<String> = [];
    return SemanticAstMatchMaterializationFacts(
        false, artifact.count, ints, ints, strings, strings, ints
    );
}

func SemanticAstMatchMaterializationName(node_id: Int) -> String {
    if node_id < 0 { return ""; }
    return Concat("__pgy_match_", ToString(node_id));
}

func SemanticAstMatchScrutineeNeedsMaterialization(
    ref graph: SemanticExpressionGraphFacts,
    root: Int
) -> Bool {
    let kind: Option<Int> = SemanticExpressionGraphNodeKind(graph, root);
    return IsSome(kind) &&
        !AstExpressionNodeIsScalarLeaf(UnwrapOption(kind));
}

func SemanticAstMatchMaterializationFactsAttach(
    artifact: AstTreeArtifact,
    inout analysis: SemanticAstArtifactAnalysis,
    ref statement_types: SemanticAstStatementTypeFacts
) -> SemanticAstMatchMaterializationFacts {
    let node_ids: Array<Int> = [];
    let function_node_ids: Array<Int> = [];
    let type_names: Array<String> = [];
    let synthetic_names: Array<String> = [];
    let synthetic_roots: Array<Int> = [];
    if !SemanticAstStatementTypeRowsReady(statement_types) ||
        !SemanticAstExpressionSurfaceBorrowReady(
            artifact, analysis.expression_surfaces
        ) {
        return SemanticAstMatchMaterializationError(artifact);
    }

    // Every scrutinee is read before the first append: an append may release
    // the buffers the admitted graph still names.
    let row: Int = 0;
    while row < ArrayLength(statement_types.node_ids) {
        if statement_types.kind_tags[row] == TypedAstKindMatchStmtTag() {
            if statement_types.verified[row] != 1 ||
                statement_types.inferred_type_names[row] == "" ||
                statement_types.inferred_type_names[row] == "Unknown" {
                return SemanticAstMatchMaterializationError(artifact);
            }
            // Only the root is read: a view would copy the graph the
            // appends below grow.
            let source_root: Option<Int> =
                SemanticAstExpressionGraphRootForNode(
                    analysis.expression_surfaces,
                    statement_types.node_ids[row], AstExpressionLaneAtom()
                );
            if !IsSome(source_root) {
                return SemanticAstMatchMaterializationError(artifact);
            }
            if SemanticAstMatchScrutineeNeedsMaterialization(
                analysis.expression_surfaces.expression_graph,
                UnwrapOption(source_root)
            ) {
                ArrayPush(node_ids, statement_types.node_ids[row]);
                ArrayPush(
                    function_node_ids,
                    analysis.statements.function_node_ids[row]
                );
                ArrayPush(
                    type_names, statement_types.inferred_type_names[row]
                );
            }
        }
        row = row + 1;
    }

    let graph: SemanticExpressionGraphFacts =
        analysis.expression_surfaces.expression_graph;
    let topology: AstExpressionArena = graph.arena.topology;
    let graph_node_texts: Array<String> = graph.arena.node_texts;
    let target_kinds: Array<Int> = graph.arena.call_target_kinds;
    let target_names: Array<String> = graph.arena.call_target_names;
    let call_return_types: Array<String> =
        graph.arena.call_return_type_names;
    let call_target_syntax_ids: Array<Int> =
        graph.arena.identities.call_target_syntax_ids;
    let runtime_call_abi_ids: Array<Int> =
        graph.arena.identities.runtime_call_abi_ids;
    let binding_syntax_ids: Array<Int> =
        graph.arena.identities.binding_syntax_ids;
    let binding_kinds: Array<Int> =
        graph.arena.identities.binding_kinds;
    let binding_ordinals: Array<Int> =
        graph.arena.identities.binding_ordinals;
    let retention_calls: Array<SemanticAstBuiltinArgumentRetentionCallFact> =
        graph.arena.identities.builtin_argument_retention_calls;
    let place_kinds: Array<Int> = graph.arena.place_kinds;

    let appended_all: Bool = true;
    let index: Int = 0;
    while index < ArrayLength(node_ids) && appended_all {
        let name: String = SemanticAstMatchMaterializationName(node_ids[index]);
        let appended: ProgramExpressionGraphAppend =
            ProgramExpressionGraphAppendIsolatedNode(
                topology, AstExpressionNodeLeaf(), name
            );
        // A failed append hands back the arena it was given.
        appended_all = appended.ok;
        topology = appended.arena;
        if appended.ok {
            ArrayPush(graph_node_texts, name);
            ArrayPush(target_kinds, SemanticCallTargetNone());
            ArrayPush(target_names, "");
            ArrayPush(call_return_types, "");
            ArrayPush(call_target_syntax_ids, 0);
            ArrayPush(runtime_call_abi_ids, 0);
            ArrayPush(binding_syntax_ids, 0);
            ArrayPush(binding_kinds, SemanticExpressionBindingNone());
            ArrayPush(
                binding_ordinals,
                SemanticExpressionBindingOrdinalAbsent()
            );
            ArrayPush(place_kinds, SemanticExpressionPlaceBinding());
            ArrayPush(synthetic_names, name);
            ArrayPush(synthetic_roots, appended.root_id);
        }
        index = index + 1;
    }

    // The appended graph replaces the admitted one on every exit from here,
    // failed or not: the caller keeps reading it.
    let arena: SemanticExpressionGraphArena =
        SemanticExpressionGraphArenaFromTopologyWithIdentities(
            topology, graph_node_texts, target_kinds, target_names,
            call_return_types,
            SemanticExpressionIdentityRows(
                call_target_syntax_ids, runtime_call_abi_ids,
                binding_syntax_ids, binding_kinds, binding_ordinals,
                retention_calls, false, 0
            ),
            place_kinds
        );
    let attached: SemanticExpressionGraphFacts =
        SemanticExpressionGraphFacts(
            SemanticExpressionGraphArenaReady(arena),
            graph.roots, graph.has_roots, arena
        );
    let surfaces: SemanticAstExpressionSurfaceFacts =
        SemanticAstExpressionSurfaceFactsWithGraph(
            artifact, analysis.expression_surfaces, attached
        );
    let attached_ok: Bool = surfaces.ok;
    analysis.expression_surfaces = surfaces;
    if !appended_all || !attached_ok {
        return SemanticAstMatchMaterializationError(artifact);
    }
    return SemanticAstMatchMaterializationFacts(
        true, artifact.count, node_ids, function_node_ids, type_names,
        synthetic_names, synthetic_roots
    );
}

func SemanticAstMatchMaterializationFactsReady(
    artifact: AstTreeArtifact,
    ref analysis: SemanticAstArtifactAnalysis,
    ref statement_types: SemanticAstStatementTypeFacts,
    ref facts: SemanticAstMatchMaterializationFacts
) -> Bool {
    let count: Int = ArrayLength(facts.node_ids);
    if !facts.ok || facts.artifact_node_count != artifact.count ||
        ArrayLength(facts.function_node_ids) != count ||
        ArrayLength(facts.type_names) != count ||
        ArrayLength(facts.synthetic_names) != count ||
        ArrayLength(facts.synthetic_graph_root_ids) != count ||
        !SemanticAstExpressionSurfaceBorrowReady(
            artifact, analysis.expression_surfaces
        ) {
        return false;
    }
    let row: Int = 0;
    while row < count {
        let statement_type_row: Option<Int> =
            SemanticAstStatementTypeIndexForNode(
                statement_types, facts.node_ids[row]
            );
        let root: Int = facts.synthetic_graph_root_ids[row];
        let kind: Option<Int> = SemanticExpressionGraphNodeKind(
            analysis.expression_surfaces.expression_graph, root
        );
        let text: Option<String> = SemanticExpressionGraphNodeText(
            analysis.expression_surfaces.expression_graph, root
        );
        if !IsSome(statement_type_row) ||
            statement_types.kind_tags[UnwrapOption(statement_type_row)] !=
                TypedAstKindMatchStmtTag() ||
            statement_types.verified[UnwrapOption(statement_type_row)] != 1 ||
            facts.function_node_ids[row] !=
                analysis.statements.function_node_ids[
                    UnwrapOption(statement_type_row)
                ] ||
            facts.type_names[row] !=
                statement_types.inferred_type_names[
                    UnwrapOption(statement_type_row)
                ] ||
            facts.synthetic_names[row] !=
                SemanticAstMatchMaterializationName(facts.node_ids[row]) ||
            !IsSome(kind) || UnwrapOption(kind) != AstExpressionNodeLeaf() ||
            !IsSome(text) || UnwrapOption(text) !=
                facts.synthetic_names[row] ||
            analysis.expression_surfaces.expression_graph.arena
                .call_target_kinds[root] != SemanticCallTargetNone() ||
            analysis.expression_surfaces.expression_graph.arena
                .place_kinds[root] != SemanticExpressionPlaceBinding() ||
            (row > 0 && facts.node_ids[row] <= facts.node_ids[row - 1]) {
            return false;
        }
        row = row + 1;
    }

    let expected_count: Int = 0;
    let scan_row: Int = 0;
    while scan_row < ArrayLength(statement_types.node_ids) {
        if statement_types.kind_tags[scan_row] ==
            TypedAstKindMatchStmtTag() {
            let source: SemanticExpressionGraphView =
                SemanticAstExpressionGraphForNode(
                    analysis.expression_surfaces,
                    statement_types.node_ids[scan_row],
                    AstExpressionLaneAtom()
                );
            if !source.ok { return false; }
            if SemanticAstMatchScrutineeNeedsMaterialization(
                source.graph, source.root_id
            ) {
                expected_count = expected_count + 1;
            }
        }
        scan_row = scan_row + 1;
    }
    return expected_count == count;
}
