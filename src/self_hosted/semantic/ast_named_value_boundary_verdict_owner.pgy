// Named-value and readonly provenance rules at owned-sequence boundaries.
//
// Parameter type/mode and expression place are already admitted facts here.
// This owner joins them once before MIR lowering; backends may not recover the
// boundary from source text or a projected type name.

import "ast_signature_fact_owner.pgy";
import "ast_expression_graph_call_view_owner.pgy";
import "ast_expression_call_target_fact_owner.pgy";
import "ast_expression_graph_generic_call_owner.pgy";
import "ast_expression_place_fact_owner.pgy";
import "array_type_shape_owner.pgy";
import "builtin_signature_owner.pgy";
import "diagnostic_owner.pgy";
import "ast_statement_type_fact_owner.pgy";

struct SemanticAstNamedValueBoundaryVerdict {
    ok: Bool;
    diagnostic_code: String;
    diagnostic_message: String;
    call_node_id: Int;
    argument_index: Int;
}

func SemanticAstNamedValueBoundaryVerdictOk(
) -> SemanticAstNamedValueBoundaryVerdict {
    return SemanticAstNamedValueBoundaryVerdict(true, "", "", -1, -1);
}

func SemanticAstNamedValueBoundaryVerdictError(
    code: String,
    message: String,
    call_node_id: Int,
    argument_index: Int
) -> SemanticAstNamedValueBoundaryVerdict {
    return SemanticAstNamedValueBoundaryVerdict(
        false, code, message, call_node_id, argument_index
    );
}

func SemanticAstNamedValueBoundaryTracksType(type_name: String) -> Bool {
    // Owned-sequence shape identity stays with the canonical semantic owner.
    // Element spellings do not form a second ownership policy here.
    return IsSome(SemanticOwnedSequenceElementType(type_name));
}

func SemanticAstNamedValueBoundaryFreshOwnedSequenceConstructor(
    ref graph: SemanticExpressionGraphFacts,
    argument_node_id: Int,
    parameter_type: String,
    ref call_roots: SemanticCallSpineRoots
) -> Bool {
    if !SemanticAstNamedValueBoundaryTracksType(parameter_type) { return false; }
    let kind: Option<Int> = SemanticExpressionGraphNodeKind(
        graph, argument_node_id
    );
    if !IsSome(kind) || UnwrapOption(kind) != AstExpressionNodeCall() {
        return false;
    }
    let target_kind: Option<Int> = SemanticExpressionGraphCallTargetKind(
        graph, argument_node_id
    );
    let target_name: Option<String> = SemanticExpressionGraphCallTargetName(
        graph, argument_node_id
    );
    if !IsSome(target_kind) || !IsSome(target_name) ||
        UnwrapOption(target_kind) != SemanticCallTargetDirect() {
        return false;
    }
    if !call_roots.ok || ArrayLength(call_roots.root_nodes) !=
        SemanticExpressionGraphArenaNodeCount(graph.arena) { return false; }
    let call: SemanticCallSpineView = SemanticCallSpineViewFromGraph(
        graph, call_roots.root_nodes[argument_node_id]
    );
    if !call.ok || call.call_node != argument_node_id { return false; }
    let declared_type: Option<String> = Some(parameter_type);
    let contextual_type: Option<String> =
        SemanticContextualBuiltinReturnTypeOpt(
            UnwrapOption(target_name), ArrayLength(call.argument_nodes),
            declared_type
        );
    return IsSome(contextual_type) &&
        UnwrapOption(contextual_type) == parameter_type;
}

func SemanticAstNamedValueBoundaryModeName(mode: Int) -> String {
    if mode == 1 { return "inout"; }
    if mode == 2 { return "own"; }
    if mode == 3 { return "ref"; }
    return "default";
}

func SemanticAstReadonlySequenceBoundaryVerdict(
    ref graph: SemanticExpressionGraphFacts,
    root_id: Int, type_name: String, boundary: String
) -> SemanticAstNamedValueBoundaryVerdict {
    if !SemanticAstNamedValueBoundaryTracksType(type_name) {
        return SemanticAstNamedValueBoundaryVerdictOk();
    }
    // A field projection preserves its root's borrow; it does not grant
    // ownership. Follow only the admitted, strictly decreasing member path.
    let node: Int = root_id;
    while node >= 0 {
        let place: Option<Int> = SemanticExpressionGraphPlaceKind(graph, node);
        if !IsSome(place) || UnwrapOption(place) == SemanticExpressionPlaceUnknown() {
            break;
        }
        if UnwrapOption(place) == SemanticExpressionPlaceReadonlyRefBinding() {
            return SemanticAstNamedValueBoundaryVerdictError(
                "borrow_boundary_escape", SemanticError2(
                    "borrow_boundary_escape", "boundary", boundary,
                    "type", type_name), root_id, -1);
        }
        if UnwrapOption(place) != SemanticExpressionPlaceMember() {
            return SemanticAstNamedValueBoundaryVerdictOk();
        }
        let member: SemanticMemberAccessView = SemanticMemberAccessViewFromGraph(graph, node);
        if !member.ok || member.receiver_node < 0 || member.receiver_node >= node { break; }
        node = member.receiver_node;
    }
    return SemanticAstNamedValueBoundaryVerdictError(
        "ast_artifact_invalid", SemanticError1(
            "ast_artifact_invalid", "owner", "readonly_boundary_place"), root_id, -1);
}

func SemanticAstNamedValueBoundaryVerdictFromResolvedFacts(
    signatures: SemanticAstFunctionSignatureFacts,
    ref graph: SemanticExpressionGraphFacts,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref statements: SemanticAstStatementTypeFacts
) -> SemanticAstNamedValueBoundaryVerdict {
    if !signatures.ok || !statements.ok ||
        !SemanticExpressionGraphCarriedCallTargetsReady(graph) ||
        !SemanticExpressionGraphPlaceKindsReady(graph) {
        return SemanticAstNamedValueBoundaryVerdictError(
            "ast_artifact_invalid",
            SemanticError1(
                "ast_artifact_invalid", "owner",
                "SemanticAstNamedValueBoundaryVerdict"
            ),
            -1, -1
        );
    }
    let statement: Int = 0;
    while statement < ArrayLength(statements.node_ids) {
        if statements.verified[statement] == 1 &&
            statements.kind_tags[statement] == TypedAstKindValueReturnStmtTag() {
            let root: Option<Int> = SemanticAstExpressionGraphRootForNode(
                surfaces, statements.node_ids[statement], AstExpressionLaneAtom());
            if !IsSome(root) {
                return SemanticAstNamedValueBoundaryVerdictError(
                    "ast_artifact_invalid", SemanticError1(
                        "ast_artifact_invalid", "owner", "return_boundary_graph"),
                    statements.node_ids[statement], -1);
            }
            let verdict: SemanticAstNamedValueBoundaryVerdict =
                SemanticAstReadonlySequenceBoundaryVerdict(
                    graph, UnwrapOption(root), statements.expected_type_names[statement], "return");
            if !verdict.ok { return verdict; }
        }
        statement = statement + 1;
    }
    let arena_count: Int = SemanticExpressionGraphArenaNodeCount(graph.arena);
    let call_roots: SemanticCallSpineRoots = SemanticCallSpineRootsFromGraph(graph);
    if !call_roots.ok {
        return SemanticAstNamedValueBoundaryVerdictError(
            "ast_artifact_invalid", SemanticError1(
                "ast_artifact_invalid", "owner", "SemanticAstNamedValueBoundaryVerdict"),
            -1, -1);
    }
    let call_node: Int = 0;
    while call_node < arena_count {
        let kind: Option<Int> = SemanticExpressionGraphNodeKind(
            graph, call_node
        );
        if !IsSome(kind) || UnwrapOption(kind) != AstExpressionNodeCall() {
            call_node = call_node + 1;
            continue;
        }
        let target_kind: Option<Int> = SemanticExpressionGraphCallTargetKind(
            graph, call_node
        );
        let target_name: Option<String> = SemanticExpressionGraphCallTargetName(
            graph, call_node
        );
        if !IsSome(target_kind) || !IsSome(target_name) ||
            UnwrapOption(target_kind) != SemanticCallTargetDirect() {
            call_node = call_node + 1;
            continue;
        }
        let signature_index: Option<Int> = SemanticGenericCallSignatureIndex(
            signatures, UnwrapOption(target_name)
        );
        if !IsSome(signature_index) {
            call_node = call_node + 1;
            continue;
        }
        let call: SemanticCallSpineView = SemanticCallSpineViewFromGraph(
            graph, call_roots.root_nodes[call_node]);
        let parameter_count: Option<Int> = SemanticAstFunctionParamCountAt(
            signatures, UnwrapOption(signature_index)
        );
        if !call.ok || call.call_node != call_node || !IsSome(parameter_count) ||
            ArrayLength(call.argument_nodes) != UnwrapOption(parameter_count) {
            return SemanticAstNamedValueBoundaryVerdictError(
                "ast_artifact_invalid",
                SemanticError1(
                    "ast_artifact_invalid", "owner",
                    "SemanticAstNamedValueBoundaryVerdict"
                ),
                call_node, -1
            );
        }
        let argument_index: Int = 0;
        while argument_index < ArrayLength(call.argument_nodes) {
            let parameter_type: Option<String> =
                SemanticAstFunctionParamTypeAt(
                    signatures, UnwrapOption(signature_index), argument_index
                );
            let parameter_mode: Option<Int> =
                SemanticAstFunctionParamModeAt(
                    signatures, UnwrapOption(signature_index), argument_index
                );
            let argument_place: Option<Int> = SemanticExpressionGraphPlaceKind(
                graph, call.argument_nodes[argument_index]
            );
            if !IsSome(parameter_type) || !IsSome(parameter_mode) ||
                !IsSome(argument_place) {
                return SemanticAstNamedValueBoundaryVerdictError(
                    "ast_artifact_invalid",
                    SemanticError1(
                        "ast_artifact_invalid", "owner",
                        "SemanticAstNamedValueBoundaryVerdict"
                    ),
                    call_node, argument_index
                );
            }
            let mode: Int = UnwrapOption(parameter_mode);
            let admitted_parameter_type: String = UnwrapOption(parameter_type);
            let argument_node_id: Int = call.argument_nodes[argument_index];
            if mode != 3 {
                let readonly: SemanticAstNamedValueBoundaryVerdict =
                    SemanticAstReadonlySequenceBoundaryVerdict(
                        graph, argument_node_id, admitted_parameter_type,
                        SemanticAstNamedValueBoundaryModeName(mode));
                if !readonly.ok { return readonly; }
            }
            if mode != 0 &&
                SemanticAstNamedValueBoundaryTracksType(
                    admitted_parameter_type
                ) && UnwrapOption(argument_place) ==
                    SemanticExpressionPlaceValue() &&
                !SemanticAstNamedValueBoundaryFreshOwnedSequenceConstructor(
                    graph, argument_node_id, admitted_parameter_type,
                    call_roots
                ) {
                return SemanticAstNamedValueBoundaryVerdictError(
                    "named_value_boundary_argument_required",
                    SemanticError3(
                        "named_value_boundary_argument_required",
                        "callee", UnwrapOption(target_name),
                        "parameter_type", UnwrapOption(parameter_type),
                        "mode", SemanticAstNamedValueBoundaryModeName(mode)
                    ),
                    call_node, argument_index
                );
            }
            argument_index = argument_index + 1;
        }
        call_node = call_node + 1;
    }
    return SemanticAstNamedValueBoundaryVerdictOk();
}
