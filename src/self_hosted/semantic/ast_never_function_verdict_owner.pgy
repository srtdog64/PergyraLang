// A `-> Never` function must end in a call that never completes
// (docs/205 L1). The self-host semantic has no general missing-return
// analysis, so the rule here is conservative: the last top-level statement
// of the body must be Exit or a direct call to another Never function, and
// no statement of the function may return. A body
// whose branches all end in Never calls is refused, although native accepts
// it; refusing is the safe side of that gap.

import "ast_signature_fact_owner.pgy";
import "ast_statement_fact_owner.pgy";
import "diagnostic_owner.pgy";

func SemanticAstNeverFunctionBodyBlock(
    artifact: AstTreeArtifact,
    signatures: SemanticAstFunctionSignatureFacts,
    signature_index: Int
) -> Option<Int> {
    if signature_index >= ArrayLength(signatures.action_contracts.body_node_ids) {
        return None;
    }
    let body_node: Int = signatures.action_contracts.body_node_ids[signature_index];
    if body_node < 0 { return None; }
    let child_index: Int = 0;
    let child: Option<Int> = TypedAstArenaChildAt(artifact.arena, body_node, child_index);
    while IsSome(child) {
        if TypedAstArenaNodeKindIs(artifact.arena, UnwrapOption(child), TypedAstKindBlockTag()) {
            return child;
        }
        child_index = child_index + 1;
        child = TypedAstArenaChildAt(artifact.arena, body_node, child_index);
    }
    return None;
}

func SemanticAstNeverFunctionStatementDiverges(
    signatures: SemanticAstFunctionSignatureFacts,
    ref statements: SemanticAstStatementFacts,
    row: Int
) -> Bool {
    let kind: Int = statements.kind_tags[row];
    if kind == TypedAstKindExitStmtTag() { return true; }
    if kind != TypedAstKindBareCallStmtTag() { return false; }
    let callee: String = statements.payload_texts[row];
    let open: Int = StringIndexOf(callee, "(");
    if open > 0 { callee = Substring(callee, 0, open); }
    let i: Int = 0;
    while i < ArrayLength(signatures.names) {
        if signatures.names[i] == callee && signatures.return_types[i] == "Never" {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func SemanticAstNeverFunctionFallthroughMessage(
    artifact: AstTreeArtifact,
    signatures: SemanticAstFunctionSignatureFacts,
    ref statements: SemanticAstStatementFacts
) -> Option<String> {
    let signature: Int = 0;
    while signature < ArrayLength(signatures.function_node_ids) {
        if signatures.return_types[signature] == "Never" {
            let block: Option<Int> =
                SemanticAstNeverFunctionBodyBlock(artifact, signatures, signature);
            let last_row: Option<Int> = None;
            let row: Int = 0;
            while IsSome(block) && row < ArrayLength(statements.node_ids) {
                let in_function: Bool = statements.function_node_ids[row] ==
                    signatures.function_node_ids[signature];
                // The statement type check sees only value returns.
                if in_function && (statements.kind_tags[row] == TypedAstKindBareReturnStmtTag() ||
                    statements.kind_tags[row] == TypedAstKindValueReturnStmtTag()) {
                    return Some(SemanticError2("return_type_mismatch",
                        "expected", "Never", "actual", "return"));
                }
                if in_function && statements.scope_node_ids[row] == UnwrapOption(block) &&
                    (!IsSome(last_row) || statements.node_ids[row] >
                        statements.node_ids[UnwrapOption(last_row)]) {
                    last_row = Some(row);
                }
                row = row + 1;
            }
            if !IsSome(last_row) || !SemanticAstNeverFunctionStatementDiverges(
                signatures, statements, UnwrapOption(last_row)
            ) {
                return Some(SemanticError1(
                    "never_function_fallthrough", "function",
                    signatures.names[signature]
                ));
            }
        }
        signature = signature + 1;
    }
    return None;
}
