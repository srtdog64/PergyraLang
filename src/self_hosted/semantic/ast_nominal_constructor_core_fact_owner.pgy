// Nominal constructor fact construction and core queries.

import "../hir/ast_text_arena_projection_owner.pgy";
import "../hir/ast_node_kind_owner.pgy";
import "diagnostic_owner.pgy";
import "ast_type_name_canonical_owner.pgy";
import "ast_generic_parameter_fact_owner.pgy";
import "../lib/nominal_field_kind_owner.pgy";
import "callable_resolution_owner.pgy";

struct SemanticAstNominalConstructorFacts {
    ok: Bool;
    diagnostic_code: String;
    diagnostic_message: String;
    diagnostic_fact: SemanticDiagnosticMessageFact;
    artifact_node_count: Int;
    node_ids: Array<Int>;
    nominal_kinds: Array<String>;
    names: Array<String>;
    return_type_names: Array<String>;
    param_starts: Array<Int>;
    param_counts: Array<Int>;
    field_source_syntax_ids: Array<Int>;
    field_names: Array<String>;
    field_kinds: Array<String>;
    field_write_modes: Array<Int>;
    param_type_names: Array<String>;
    role_slot_starts: Array<Int>;
    role_slot_counts: Array<Int>;
    role_slot_names: Array<String>;
    role_slot_type_names: Array<String>;
    role_slot_dynamic: Array<Int>;
    // First row and row count per declaration name, filled once from `names`.
    name_first_rows: HashMap<String, Int>;
    name_row_counts: HashMap<String, Int>;
}
func SemanticAstNominalConstructorFactsFromArtifact(
    artifact: AstTreeArtifact
) -> SemanticAstNominalConstructorFacts {
    var node_ids: Array<Int> = [];
    var nominal_kinds: Array<String> = [];
    var names: Array<String> = [];
    var return_types: Array<String> = [];
    var param_starts: Array<Int> = [];
    var param_counts: Array<Int> = [];
    var field_source_syntax_ids: Array<Int> = [];
    var field_names: Array<String> = [];
    var field_kinds: Array<String> = [];
    var field_write_modes: Array<Int> = [];
    var param_types: Array<String> = [];
    var role_slot_starts: Array<Int> = [];
    var role_slot_counts: Array<Int> = [];
    var role_slot_names: Array<String> = [];
    var role_slot_type_names: Array<String> = [];
    var role_slot_dynamic: Array<Int> = [];
    var ok: Bool = AstTreeArtifactReady(artifact);
    var diagnostic_fact: SemanticDiagnosticMessageFact =
        SemanticDiagnosticMessageFactEmpty();
    if !ok {
        diagnostic_fact = SemanticDiagnosticMessageFact2(
            "ast_artifact_invalid",
            "node_count", ToString(artifact.count),
            "owner", "SemanticAstNominalConstructorFacts"
        );
    }
    var node_id: Int = 0;
    while node_id < artifact.count && ok {
        if !TypedAstArenaNodeKindIs(
            artifact.arena, node_id, TypedAstKindNominalDeclTag()
        ) {
            node_id = node_id + 1;
            continue;
        }
        let name_opt: Option<String> = TypedAstArenaAtomText(
            artifact.arena, node_id
        );
        let subkind_opt: Option<Int> = TypedAstArenaNominalSubkind(
            artifact.arena, node_id
        );
        if !IsSome(name_opt) || StringLength(UnwrapOption(name_opt)) == 0 {
            ok = false;
            diagnostic_fact = SemanticDiagnosticMessageFact2(
                "nominal_constructor_fact_invalid",
                "node_id", ToString(node_id),
                "missing_fact", "nominal_name"
            );
            continue;
        }
        if !IsSome(subkind_opt) {
            ok = false;
            diagnostic_fact = SemanticDiagnosticMessageFact2(
                "nominal_constructor_fact_invalid",
                "node_id", ToString(node_id),
                "missing_fact", "nominal_kind"
            );
            continue;
        }
        let param_start: Int = ArrayLength(param_types);
        let role_slot_start: Int = ArrayLength(role_slot_names);
        var generic_names: Array<String> = [];
        var generic_defaults: Array<String> = [];
        var saw_generic_params: Bool = false;
        var saw_fields: Bool = false;
        var child_index: Int = 0;
        var child_opt: Option<Int> = TypedAstArenaChildAt(
            artifact.arena, node_id, child_index
        );
        while IsSome(child_opt) && ok {
            let child_id: Int = UnwrapOption(child_opt);
            if TypedAstArenaNodeKindIs(
                artifact.arena, child_id, TypedAstKindGenericParamsTag()
            ) {
                if saw_generic_params ||
                    !SemanticAstGenericParameterDefaultRowsFromNode(
                        artifact.arena, child_id,
                        generic_names, generic_defaults
                    ) {
                    ok = false;
                    diagnostic_fact = SemanticDiagnosticMessageFact2(
                        "nominal_constructor_fact_invalid",
                        "node_id", ToString(child_id),
                        "missing_fact", "generic_parameter_default_rows"
                    );
                    continue;
                }
                saw_generic_params = true;
            } else if TypedAstArenaNodeKindIs(
                artifact.arena, child_id, TypedAstKindFieldsHeaderTag()
            ) {
                if saw_fields {
                    ok = false;
                    diagnostic_fact = SemanticDiagnosticMessageFact2(
                        "nominal_constructor_fact_invalid",
                        "node_id", ToString(child_id),
                        "missing_fact", "duplicate_fields_row"
                    );
                    continue;
                }
                saw_fields = true;
                var field_index: Int = 0;
                var field_opt: Option<Int> = TypedAstArenaChildAt(
                    artifact.arena, child_id, field_index
                );
                while IsSome(field_opt) && ok {
                    let field_id: Int = UnwrapOption(field_opt);
                    if !TypedAstArenaNodeKindIs(
                        artifact.arena, field_id, TypedAstKindFieldTag()
                    ) {
                        ok = false;
                        diagnostic_fact = SemanticDiagnosticMessageFact2(
                            "nominal_constructor_fact_invalid",
                            "node_id", ToString(field_id),
                            "missing_fact", "field_kind"
                        );
                        continue;
                    }
                    let field_type_opt: Option<String> = TypedAstArenaTypeName(
                        artifact.arena, field_id
                    );
                    let field_name_opt: Option<String> = TypedAstArenaAtomText(
                        artifact.arena, field_id
                    );
                    let field_kind_opt: Option<String> = TypedAstArenaAuxValueText(
                        artifact.arena, field_id
                    );
                    if !IsSome(field_name_opt) ||
                        StringLength(UnwrapOption(field_name_opt)) == 0 {
                        ok = false;
                        diagnostic_fact = SemanticDiagnosticMessageFact2(
                            "nominal_constructor_fact_invalid",
                            "node_id", ToString(field_id),
                            "missing_fact", "field_name"
                        );
                        continue;
                    }
                    if !IsSome(field_type_opt) ||
                        StringLength(UnwrapOption(field_type_opt)) == 0 {
                        ok = false;
                        diagnostic_fact = SemanticDiagnosticMessageFact2(
                            "nominal_constructor_fact_invalid",
                            "node_id", ToString(field_id),
                            "missing_fact", "field_type"
                        );
                        continue;
                    }
                    if !IsSome(field_kind_opt) || !NominalFieldKindKnown(
                        UnwrapOption(field_kind_opt)
                    ) {
                        ok = false;
                        diagnostic_fact = SemanticDiagnosticMessageFact2(
                            "nominal_constructor_fact_invalid",
                            "node_id", ToString(field_id),
                            "missing_fact", "field_semantic_kind"
                        );
                        continue;
                    }
                    ArrayPush(field_source_syntax_ids, field_id);
                    let field_mode: Option<Int> = TypedAstArenaFieldWriteMode(
                        artifact.arena, field_id);
                    if !IsSome(field_mode) {
                        ok = false;
                        diagnostic_fact = SemanticDiagnosticMessageFact2(
                            "nominal_constructor_fact_invalid",
                            "node_id", ToString(field_id),
                            "missing_fact", "field_write_mode");
                        continue;
                    }
                    ArrayPush(field_write_modes, UnwrapOption(field_mode));
                    ArrayPush(field_names, UnwrapOption(field_name_opt));
                    ArrayPush(field_kinds, UnwrapOption(field_kind_opt));
                    var field_type: String = SemanticCanonicalTypeName(
                        UnwrapOption(field_type_opt)
                    );
                    let default_count: Int = SemanticAstGenericDefaultRowCountOrDie(
                        ArrayLength(generic_names), ArrayLength(generic_defaults));
                    var default_row: Int = 0;
                    while default_row < default_count {
                        if generic_names[default_row] == field_type &&
                            generic_defaults[default_row] != "" {
                            field_type = generic_defaults[default_row]; break;
                        }
                        default_row = default_row + 1;
                    }
                    ArrayPush(param_types, field_type);
                    field_index = field_index + 1;
                    field_opt = TypedAstArenaChildAt(
                        artifact.arena, child_id, field_index
                    );
                }
            } else if (
                UnwrapOption(subkind_opt) == TypedAstNominalSubkindZone() ||
                UnwrapOption(subkind_opt) == TypedAstNominalSubkindWorld() ||
                UnwrapOption(subkind_opt) == TypedAstNominalSubkindEffect() || UnwrapOption(subkind_opt) == TypedAstNominalSubkindRelation() ||
                UnwrapOption(subkind_opt) == TypedAstNominalSubkindParty()
            ) && TypedAstArenaNodeKindIs(
                artifact.arena, child_id, TypedAstKindFieldTag()
            ) {
                // Direct domain slots join the same ordered nominal field facts.
                let field_type_opt: Option<String> = TypedAstArenaTypeName(
                    artifact.arena, child_id
                );
                let field_name_opt: Option<String> = TypedAstArenaAtomText(
                    artifact.arena, child_id
                );
                let field_kind_opt: Option<String> = TypedAstArenaAuxValueText(
                    artifact.arena, child_id
                );
                if !IsSome(field_name_opt) ||
                    StringLength(UnwrapOption(field_name_opt)) == 0 {
                    ok = false;
                    diagnostic_fact = SemanticDiagnosticMessageFact2(
                        "nominal_constructor_fact_invalid",
                        "node_id", ToString(child_id),
                        "missing_fact", "field_name"
                    );
                    continue;
                }
                if !IsSome(field_type_opt) ||
                    StringLength(UnwrapOption(field_type_opt)) == 0 {
                    ok = false;
                    diagnostic_fact = SemanticDiagnosticMessageFact2(
                        "nominal_constructor_fact_invalid",
                        "node_id", ToString(child_id),
                        "missing_fact", "field_type"
                    );
                    continue;
                }
                if !IsSome(field_kind_opt) || !NominalFieldKindKnown(
                    UnwrapOption(field_kind_opt)
                ) {
                    ok = false;
                    diagnostic_fact = SemanticDiagnosticMessageFact2(
                        "nominal_constructor_fact_invalid",
                        "node_id", ToString(child_id),
                        "missing_fact", "field_semantic_kind"
                    );
                    continue;
                }
                ArrayPush(field_source_syntax_ids, child_id);
                let field_mode: Option<Int> = TypedAstArenaFieldWriteMode(
                    artifact.arena, child_id);
                if !IsSome(field_mode) {
                    ok = false;
                    diagnostic_fact = SemanticDiagnosticMessageFact2(
                        "nominal_constructor_fact_invalid",
                        "node_id", ToString(child_id),
                        "missing_fact", "field_write_mode");
                    continue;
                }
                ArrayPush(field_write_modes, UnwrapOption(field_mode));
                ArrayPush(field_names, UnwrapOption(field_name_opt));
                ArrayPush(field_kinds, UnwrapOption(field_kind_opt));
                ArrayPush(
                    param_types,
                    SemanticCanonicalTypeName(UnwrapOption(field_type_opt))
                );
            } else if UnwrapOption(subkind_opt) ==
                TypedAstNominalSubkindParty() &&
                TypedAstArenaNodeKindIs(
                    artifact.arena, child_id, TypedAstKindRoleSlotTag()
                ) {
                let slot_type_opt: Option<String> = TypedAstArenaTypeName(
                    artifact.arena, child_id
                );
                let slot_name_opt: Option<String> = TypedAstArenaAtomText(
                    artifact.arena, child_id
                );
                if !IsSome(slot_name_opt) ||
                    StringLength(UnwrapOption(slot_name_opt)) == 0 {
                    ok = false;
                    diagnostic_fact = SemanticDiagnosticMessageFact2(
                        "nominal_constructor_fact_invalid",
                        "node_id", ToString(child_id),
                        "missing_fact", "party_role_slot_name"
                    );
                    continue;
                }
                if !IsSome(slot_type_opt) ||
                    StringLength(UnwrapOption(slot_type_opt)) == 0 {
                    ok = false;
                    diagnostic_fact = SemanticDiagnosticMessageFact2(
                        "nominal_constructor_fact_invalid",
                        "node_id", ToString(child_id),
                        "missing_fact", "party_role_slot_type"
                    );
                    continue;
                }
                let slot_mode_opt: Option<Int> = TypedAstArenaMode(artifact.arena, child_id);
                if !IsSome(slot_mode_opt) || UnwrapOption(slot_mode_opt) < 0 ||
                    UnwrapOption(slot_mode_opt) > 1 {
                    ok = false;
                    diagnostic_fact = SemanticDiagnosticMessageFact2(
                        "nominal_constructor_fact_invalid",
                        "node_id", ToString(child_id),
                        "missing_fact", "party_role_slot_dynamic"
                    );
                    continue;
                }
                ArrayPush(role_slot_names, UnwrapOption(slot_name_opt));
                ArrayPush(
                    role_slot_type_names,
                    SemanticCanonicalTypeName(UnwrapOption(slot_type_opt))
                );
                ArrayPush(role_slot_dynamic, UnwrapOption(slot_mode_opt));
            }
            child_index = child_index + 1;
            child_opt = TypedAstArenaChildAt(
                artifact.arena, node_id, child_index
            );
        }
        if !ok {
            continue;
        }
        let name: String = UnwrapOption(name_opt);
        ArrayPush(node_ids, node_id);
        ArrayPush(
            nominal_kinds,
            TypedAstNominalSubkindName(UnwrapOption(subkind_opt))
        );
        ArrayPush(names, name);
        ArrayPush(return_types, name);
        ArrayPush(param_starts, param_start);
        ArrayPush(param_counts, ArrayLength(param_types) - param_start);
        ArrayPush(role_slot_starts, role_slot_start);
        ArrayPush(
            role_slot_counts,
            ArrayLength(role_slot_names) - role_slot_start
        );
        node_id = node_id + 1;
    }
    var name_first_rows: HashMap<String, Int> = MapNew();
    var name_row_counts: HashMap<String, Int> = MapNew();
    SemanticAstNominalConstructorNameIndexFill(names, name_first_rows, name_row_counts);
    return SemanticAstNominalConstructorFacts(
        ok, diagnostic_fact.code,
        SemanticDiagnosticMessageFactRender(diagnostic_fact), diagnostic_fact,
        artifact.count,
        node_ids, nominal_kinds, names, return_types, param_starts,
        param_counts, field_source_syntax_ids, field_names, field_kinds, field_write_modes,
        param_types, role_slot_starts, role_slot_counts, role_slot_names, role_slot_type_names,
        role_slot_dynamic, name_first_rows, name_row_counts
    );
}
// The name index of the facts: the first row and the number of rows per
// name. Only the facts producer builds it, once, from `names`; the artifact
// match check compares it with a rebuilt one.
func SemanticAstNominalConstructorNameIndexFill(ref names: Array<String>,
    inout first_rows: HashMap<String, Int>, inout row_counts: HashMap<String, Int>) -> Void {
    var row: Int = 0;
    while row < ArrayLength(names) {
        SemanticCallableNameTableCount(first_rows, row_counts, Concat("", names[row]), row);
        row = row + 1;
    }
}
func SemanticAstNominalConstructorCount(ref facts: SemanticAstNominalConstructorFacts) -> Int { return ArrayLength(facts.node_ids); }
func SemanticAstNominalConstructorIndexForNode(ref facts: SemanticAstNominalConstructorFacts, node_id: Int) -> Option<Int> {
    if !facts.ok { return None; }
    let count: Int = SemanticAstNominalConstructorCount(facts); var low: Int = 0; var high: Int = count;
    while low < high {
        let middle: Int = low + ((high - low) / 2);
        if facts.node_ids[middle] < node_id { low = middle + 1; } else { high = middle; }
    }
    if low < count && facts.node_ids[low] == node_id { return Some(low); }
    return None;
}
func SemanticAstNominalConstructorNameAt(
    facts: SemanticAstNominalConstructorFacts, constructor_index: Int
) -> Option<String> {
    if !facts.ok || constructor_index < 0 ||
        constructor_index >= SemanticAstNominalConstructorCount(facts) {
        return None;
    }
    return Some(facts.names[constructor_index]);
}
func SemanticAstNominalConstructorFieldCountAt(facts: SemanticAstNominalConstructorFacts, constructor_index: Int) -> Option<Int> {
    if !facts.ok || constructor_index < 0 ||
        constructor_index >= SemanticAstNominalConstructorCount(facts) {
        return None;
    }
    return Some(facts.param_counts[constructor_index]);
}
func SemanticAstNominalConstructorRowsReady(ref facts: SemanticAstNominalConstructorFacts) -> Bool {
    let count: Int = SemanticAstNominalConstructorCount(facts);
    if !facts.ok || ArrayLength(facts.nominal_kinds) != count ||
        ArrayLength(facts.names) != count ||
        ArrayLength(facts.return_type_names) != count ||
        ArrayLength(facts.param_starts) != count ||
        ArrayLength(facts.param_counts) != count ||
        ArrayLength(facts.role_slot_starts) != count ||
        ArrayLength(facts.role_slot_counts) != count ||
        ArrayLength(facts.role_slot_dynamic) != ArrayLength(facts.role_slot_names) {
        return false;
    }
    var expected_param_count: Int = 0;
    var expected_role_slot_count: Int = 0;
    var i: Int = 0;
    while i < count {
        if facts.param_starts[i] != expected_param_count ||
            facts.param_counts[i] < 0 ||
            facts.role_slot_starts[i] != expected_role_slot_count ||
            facts.role_slot_counts[i] < 0 ||
            StringLength(facts.nominal_kinds[i]) == 0 {
            return false;
        }
        expected_param_count = expected_param_count + facts.param_counts[i];
        expected_role_slot_count = expected_role_slot_count + facts.role_slot_counts[i];
        i = i + 1;
    }
    var field_i: Int = 0;
    if ArrayLength(facts.field_write_modes) != expected_param_count {
        return false;
    }
    while field_i < expected_param_count {
        if facts.field_write_modes[field_i] != 0 &&
            facts.field_write_modes[field_i] != 1 { return false; }
        field_i = field_i + 1;
    }
    // Field source ids are positive and unique: find the largest, mark each once.
    var max_source_id: Int = 0;
    field_i = 0;
    while field_i < ArrayLength(facts.field_source_syntax_ids) {
        let candidate_id: Int = facts.field_source_syntax_ids[field_i];
        if candidate_id <= 0 { return false; }
        if candidate_id > max_source_id { max_source_id = candidate_id; }
        field_i = field_i + 1;
    }
    var seen_source_ids: Array<Bool> = [];
    while ArrayLength(seen_source_ids) <= max_source_id { ArrayPush(seen_source_ids, false); }
    field_i = 0;
    while field_i < ArrayLength(facts.field_source_syntax_ids) {
        let field_source_id: Int = facts.field_source_syntax_ids[field_i];
        if seen_source_ids[field_source_id] { return false; }
        seen_source_ids[field_source_id] = true;
        field_i = field_i + 1;
    }
    return expected_param_count == ArrayLength(facts.field_source_syntax_ids) &&
        expected_param_count == ArrayLength(facts.field_names) &&
        expected_param_count == ArrayLength(facts.field_kinds) &&
        expected_param_count == ArrayLength(facts.param_type_names) &&
        expected_role_slot_count == ArrayLength(facts.role_slot_names) &&
        expected_role_slot_count == ArrayLength(facts.role_slot_type_names);
}
func SemanticAstNominalConstructorParamTypeAt(
    ref facts: SemanticAstNominalConstructorFacts, constructor_index: Int,
    param_index: Int
) -> Option<String> {
    if constructor_index < 0 ||
        constructor_index >= SemanticAstNominalConstructorCount(facts) ||
        param_index < 0 || param_index >= facts.param_counts[constructor_index] {
        return None;
    }
    return Some(facts.param_type_names[
        facts.param_starts[constructor_index] + param_index
    ]);
}

