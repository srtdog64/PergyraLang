// Nominal constructor facts derived once from the parser-owned AST artifact.
//
// Expression typing consumes these rows instead of rescanning source text for
// class/struct fields. Field order is constructor parameter order.

import "../hir/ast_text_arena_projection_owner.pgy";
import "../hir/ast_node_kind_owner.pgy";
import "diagnostic_owner.pgy";
import "ast_type_name_canonical_owner.pgy";
import "ast_generic_parameter_fact_owner.pgy";

struct SemanticAstNominalConstructorFacts {
    ok: Bool;
    diagnostic_code: String;
    diagnostic_message: String;
    diagnostic_fact: SemanticDiagnosticMessageFact;
    artifact_node_count: Int;
    node_ids: Array<Int>;
    nominal_kinds: Array<String>;
    names: Array<String>;
    return_type_names: Array<String>;
    param_starts: Array<Int>;
    param_counts: Array<Int>;
    field_names: Array<String>;
    param_type_names: Array<String>;
    role_slot_starts: Array<Int>;
    role_slot_counts: Array<Int>;
    role_slot_names: Array<String>;
    role_slot_type_names: Array<String>;
}

func SemanticAstNominalConstructorFactsFromArtifact(
    artifact: AstTreeArtifact
) -> SemanticAstNominalConstructorFacts {
    let node_ids: Array<Int> = [];
    let nominal_kinds: Array<String> = [];
    let names: Array<String> = [];
    let return_types: Array<String> = [];
    let param_starts: Array<Int> = [];
    let param_counts: Array<Int> = [];
    let field_names: Array<String> = [];
    let param_types: Array<String> = [];
    let role_slot_starts: Array<Int> = [];
    let role_slot_counts: Array<Int> = [];
    let role_slot_names: Array<String> = [];
    let role_slot_type_names: Array<String> = [];
    let ok: Bool = AstTreeArtifactReady(artifact);
    let diagnostic_fact: SemanticDiagnosticMessageFact =
        SemanticDiagnosticMessageFactEmpty();
    if !ok {
        diagnostic_fact = SemanticDiagnosticMessageFact2(
            "ast_artifact_invalid",
            "node_count", ToString(artifact.count),
            "owner", "SemanticAstNominalConstructorFacts"
        );
    }

    let node_id: Int = 0;
    while node_id < artifact.count && ok {
        if !TypedAstArenaNodeKindIs(
            artifact.arena, node_id, TypedAstKindNominalDeclTag()
        ) {
            node_id = node_id + 1;
            continue;
        }
        let name_opt: Option<String> = TypedAstArenaAtomText(
            artifact.arena, node_id
        );
        let subkind_opt: Option<Int> = TypedAstArenaNominalSubkind(
            artifact.arena, node_id
        );
        if !IsSome(name_opt) || StringLength(UnwrapOption(name_opt)) == 0 {
            ok = false;
            diagnostic_fact = SemanticDiagnosticMessageFact2(
                "nominal_constructor_fact_invalid",
                "node_id", ToString(node_id),
                "missing_fact", "nominal_name"
            );
            continue;
        }
        if !IsSome(subkind_opt) {
            ok = false;
            diagnostic_fact = SemanticDiagnosticMessageFact2(
                "nominal_constructor_fact_invalid",
                "node_id", ToString(node_id),
                "missing_fact", "nominal_kind"
            );
            continue;
        }

        let param_start: Int = ArrayLength(param_types);
        let role_slot_start: Int = ArrayLength(role_slot_names);
        let generic_names: Array<String> = [];
        let generic_defaults: Array<String> = [];
        let saw_generic_params: Bool = false;
        let saw_fields: Bool = false;
        let child_index: Int = 0;
        let child_opt: Option<Int> = TypedAstArenaChildAt(
            artifact.arena, node_id, child_index
        );
        while IsSome(child_opt) && ok {
            let child_id: Int = UnwrapOption(child_opt);
            if TypedAstArenaNodeKindIs(
                artifact.arena, child_id, TypedAstKindGenericParamsTag()
            ) {
                if saw_generic_params ||
                    !SemanticAstGenericParameterDefaultRowsFromNode(
                        artifact.arena, child_id,
                        generic_names, generic_defaults
                    ) {
                    ok = false;
                    diagnostic_fact = SemanticDiagnosticMessageFact2(
                        "nominal_constructor_fact_invalid",
                        "node_id", ToString(child_id),
                        "missing_fact", "generic_parameter_default_rows"
                    );
                    continue;
                }
                saw_generic_params = true;
            } else if TypedAstArenaNodeKindIs(
                artifact.arena, child_id, TypedAstKindFieldsHeaderTag()
            ) {
                if saw_fields {
                    ok = false;
                    diagnostic_fact = SemanticDiagnosticMessageFact2(
                        "nominal_constructor_fact_invalid",
                        "node_id", ToString(child_id),
                        "missing_fact", "duplicate_fields_row"
                    );
                    continue;
                }
                saw_fields = true;
                let field_index: Int = 0;
                let field_opt: Option<Int> = TypedAstArenaChildAt(
                    artifact.arena, child_id, field_index
                );
                while IsSome(field_opt) && ok {
                    let field_id: Int = UnwrapOption(field_opt);
                    if !TypedAstArenaNodeKindIs(
                        artifact.arena, field_id, TypedAstKindFieldTag()
                    ) {
                        ok = false;
                        diagnostic_fact = SemanticDiagnosticMessageFact2(
                            "nominal_constructor_fact_invalid",
                            "node_id", ToString(field_id),
                            "missing_fact", "field_kind"
                        );
                        continue;
                    }
                    let field_type_opt: Option<String> = TypedAstArenaTypeName(
                        artifact.arena, field_id
                    );
                    let field_name_opt: Option<String> = TypedAstArenaAtomText(
                        artifact.arena, field_id
                    );
                    if !IsSome(field_name_opt) ||
                        StringLength(UnwrapOption(field_name_opt)) == 0 {
                        ok = false;
                        diagnostic_fact = SemanticDiagnosticMessageFact2(
                            "nominal_constructor_fact_invalid",
                            "node_id", ToString(field_id),
                            "missing_fact", "field_name"
                        );
                        continue;
                    }
                    if !IsSome(field_type_opt) ||
                        StringLength(UnwrapOption(field_type_opt)) == 0 {
                        ok = false;
                        diagnostic_fact = SemanticDiagnosticMessageFact2(
                            "nominal_constructor_fact_invalid",
                            "node_id", ToString(field_id),
                            "missing_fact", "field_type"
                        );
                        continue;
                    }
                    ArrayPush(field_names, UnwrapOption(field_name_opt));
                    let field_type: String = SemanticCanonicalTypeName(
                        UnwrapOption(field_type_opt)
                    );
                    ArrayPush(param_types, SemanticAstGenericDefaultTypeForName(
                        generic_names, generic_defaults, field_type
                    ));
                    field_index = field_index + 1;
                    field_opt = TypedAstArenaChildAt(
                        artifact.arena, child_id, field_index
                    );
                }
            } else if (
                UnwrapOption(subkind_opt) == TypedAstNominalSubkindZone() ||
                UnwrapOption(subkind_opt) == TypedAstNominalSubkindWorld()
            ) && TypedAstArenaNodeKindIs(
                artifact.arena, child_id, TypedAstKindFieldTag()
            ) {
                // Zone/world slots are direct children in the parser-owned
                // AST (there is no synthetic Fields header).  They are still
                // constructor parameters and must enter the same nominal
                // field fact stream as struct/class fields.
                let field_type_opt: Option<String> = TypedAstArenaTypeName(
                    artifact.arena, child_id
                );
                let field_name_opt: Option<String> = TypedAstArenaAtomText(
                    artifact.arena, child_id
                );
                if !IsSome(field_name_opt) ||
                    StringLength(UnwrapOption(field_name_opt)) == 0 {
                    ok = false;
                    diagnostic_fact = SemanticDiagnosticMessageFact2(
                        "nominal_constructor_fact_invalid",
                        "node_id", ToString(child_id),
                        "missing_fact", "field_name"
                    );
                    continue;
                }
                if !IsSome(field_type_opt) ||
                    StringLength(UnwrapOption(field_type_opt)) == 0 {
                    ok = false;
                    diagnostic_fact = SemanticDiagnosticMessageFact2(
                        "nominal_constructor_fact_invalid",
                        "node_id", ToString(child_id),
                        "missing_fact", "field_type"
                    );
                    continue;
                }
                ArrayPush(field_names, UnwrapOption(field_name_opt));
                ArrayPush(
                    param_types,
                    SemanticCanonicalTypeName(UnwrapOption(field_type_opt))
                );
            } else if UnwrapOption(subkind_opt) ==
                TypedAstNominalSubkindParty() &&
                TypedAstArenaNodeKindIs(
                    artifact.arena, child_id, TypedAstKindRoleSlotTag()
                ) {
                let slot_type_opt: Option<String> = TypedAstArenaTypeName(
                    artifact.arena, child_id
                );
                let slot_name_opt: Option<String> = TypedAstArenaAtomText(
                    artifact.arena, child_id
                );
                if !IsSome(slot_name_opt) ||
                    StringLength(UnwrapOption(slot_name_opt)) == 0 {
                    ok = false;
                    diagnostic_fact = SemanticDiagnosticMessageFact2(
                        "nominal_constructor_fact_invalid",
                        "node_id", ToString(child_id),
                        "missing_fact", "party_role_slot_name"
                    );
                    continue;
                }
                if !IsSome(slot_type_opt) ||
                    StringLength(UnwrapOption(slot_type_opt)) == 0 {
                    ok = false;
                    diagnostic_fact = SemanticDiagnosticMessageFact2(
                        "nominal_constructor_fact_invalid",
                        "node_id", ToString(child_id),
                        "missing_fact", "party_role_slot_type"
                    );
                    continue;
                }
                ArrayPush(role_slot_names, UnwrapOption(slot_name_opt));
                ArrayPush(
                    role_slot_type_names,
                    SemanticCanonicalTypeName(UnwrapOption(slot_type_opt))
                );
            }
            child_index = child_index + 1;
            child_opt = TypedAstArenaChildAt(
                artifact.arena, node_id, child_index
            );
        }
        if !ok {
            continue;
        }
        let name: String = UnwrapOption(name_opt);
        ArrayPush(node_ids, node_id);
        ArrayPush(
            nominal_kinds,
            TypedAstNominalSubkindName(UnwrapOption(subkind_opt))
        );
        ArrayPush(names, name);
        ArrayPush(return_types, name);
        ArrayPush(param_starts, param_start);
        ArrayPush(param_counts, ArrayLength(param_types) - param_start);
        ArrayPush(role_slot_starts, role_slot_start);
        ArrayPush(
            role_slot_counts,
            ArrayLength(role_slot_names) - role_slot_start
        );
        node_id = node_id + 1;
    }
    return SemanticAstNominalConstructorFacts(
        ok, diagnostic_fact.code,
        SemanticDiagnosticMessageFactRender(diagnostic_fact), diagnostic_fact,
        artifact.count,
        node_ids, nominal_kinds, names, return_types, param_starts,
        param_counts, field_names, param_types, role_slot_starts,
        role_slot_counts, role_slot_names, role_slot_type_names
    );
}

func SemanticAstNominalConstructorCount(
    ref facts: SemanticAstNominalConstructorFacts
) -> Int {
    return ArrayLength(facts.node_ids);
}

func SemanticAstNominalConstructorIndexForNode(
    facts: SemanticAstNominalConstructorFacts,
    node_id: Int
) -> Option<Int> {
    if !facts.ok { return None; }
    let i: Int = 0;
    while i < SemanticAstNominalConstructorCount(facts) {
        if facts.node_ids[i] == node_id { return Some(i); }
        i = i + 1;
    }
    return None;
}

func SemanticAstNominalConstructorNameAt(
    facts: SemanticAstNominalConstructorFacts,
    constructor_index: Int
) -> Option<String> {
    if !facts.ok || constructor_index < 0 ||
        constructor_index >= SemanticAstNominalConstructorCount(facts) {
        return None;
    }
    return Some(facts.names[constructor_index]);
}

func SemanticAstNominalConstructorFieldCountAt(
    facts: SemanticAstNominalConstructorFacts,
    constructor_index: Int
) -> Option<Int> {
    if !facts.ok || constructor_index < 0 ||
        constructor_index >= SemanticAstNominalConstructorCount(facts) {
        return None;
    }
    return Some(facts.param_counts[constructor_index]);
}

func SemanticAstNominalConstructorRowsReady(
    ref facts: SemanticAstNominalConstructorFacts
) -> Bool {
    let count: Int = SemanticAstNominalConstructorCount(facts);
    if !facts.ok || ArrayLength(facts.nominal_kinds) != count ||
        ArrayLength(facts.names) != count ||
        ArrayLength(facts.return_type_names) != count ||
        ArrayLength(facts.param_starts) != count ||
        ArrayLength(facts.param_counts) != count ||
        ArrayLength(facts.role_slot_starts) != count ||
        ArrayLength(facts.role_slot_counts) != count {
        return false;
    }
    let expected_param_count: Int = 0;
    let expected_role_slot_count: Int = 0;
    let i: Int = 0;
    while i < count {
        if facts.param_starts[i] != expected_param_count ||
            facts.param_counts[i] < 0 ||
            facts.role_slot_starts[i] != expected_role_slot_count ||
            facts.role_slot_counts[i] < 0 ||
            StringLength(facts.nominal_kinds[i]) == 0 {
            return false;
        }
        expected_param_count = expected_param_count + facts.param_counts[i];
        expected_role_slot_count = expected_role_slot_count +
            facts.role_slot_counts[i];
        i = i + 1;
    }
    return expected_param_count == ArrayLength(facts.field_names) &&
        expected_param_count == ArrayLength(facts.param_type_names) &&
        expected_role_slot_count == ArrayLength(facts.role_slot_names) &&
        expected_role_slot_count == ArrayLength(facts.role_slot_type_names);
}

func SemanticAstNominalConstructorParamTypeAt(
    facts: SemanticAstNominalConstructorFacts,
    constructor_index: Int,
    param_index: Int
) -> Option<String> {
    if constructor_index < 0 ||
        constructor_index >= SemanticAstNominalConstructorCount(facts) ||
        param_index < 0 || param_index >= facts.param_counts[constructor_index] {
        return None;
    }
    return Some(
        facts.param_type_names[
            facts.param_starts[constructor_index] + param_index
        ]
    );
}

func SemanticAstNominalRoleSlotCountAt(
    facts: SemanticAstNominalConstructorFacts,
    constructor_index: Int
) -> Option<Int> {
    if !facts.ok || constructor_index < 0 ||
        constructor_index >= SemanticAstNominalConstructorCount(facts) {
        return None;
    }
    return Some(facts.role_slot_counts[constructor_index]);
}

func SemanticAstNominalRoleSlotNameAt(
    facts: SemanticAstNominalConstructorFacts,
    constructor_index: Int,
    slot_index: Int
) -> Option<String> {
    if !facts.ok || constructor_index < 0 ||
        constructor_index >= SemanticAstNominalConstructorCount(facts) ||
        slot_index < 0 ||
        slot_index >= facts.role_slot_counts[constructor_index] {
        return None;
    }
    return Some(facts.role_slot_names[
        facts.role_slot_starts[constructor_index] + slot_index
    ]);
}

func SemanticAstNominalRoleSlotTypeAt(
    facts: SemanticAstNominalConstructorFacts,
    constructor_index: Int,
    slot_index: Int
) -> Option<String> {
    if !facts.ok || constructor_index < 0 ||
        constructor_index >= SemanticAstNominalConstructorCount(facts) ||
        slot_index < 0 ||
        slot_index >= facts.role_slot_counts[constructor_index] {
        return None;
    }
    return Some(facts.role_slot_type_names[
        facts.role_slot_starts[constructor_index] + slot_index
    ]);
}

func SemanticAstNominalConstructorFieldTypeAt(
    facts: SemanticAstNominalConstructorFacts,
    constructor_index: Int,
    field_index: Int
) -> Option<String> {
    return SemanticAstNominalConstructorParamTypeAt(
        facts, constructor_index, field_index
    );
}

func SemanticAstNominalConstructorFieldNameAt(
    facts: SemanticAstNominalConstructorFacts,
    constructor_index: Int,
    field_index: Int
) -> Option<String> {
    if constructor_index < 0 ||
        constructor_index >= SemanticAstNominalConstructorCount(facts) ||
        field_index < 0 || field_index >= facts.param_counts[constructor_index] {
        return None;
    }
    return Some(
        facts.field_names[facts.param_starts[constructor_index] + field_index]
    );
}

func SemanticAstNominalFieldType(
    ref facts: SemanticAstNominalConstructorFacts,
    nominal_name: String,
    field_name: String
) -> Option<String> {
    let constructor_index: Int = 0;
    while constructor_index < SemanticAstNominalConstructorCount(facts) {
        if facts.names[constructor_index] == nominal_name {
            let field_index: Int = 0;
            while field_index < facts.param_counts[constructor_index] {
                let row: Int = facts.param_starts[constructor_index] +
                    field_index;
                if facts.field_names[row] == field_name {
                    return Some(facts.param_type_names[row]);
                }
                field_index = field_index + 1;
            }
            let slot_index: Int = 0;
            while slot_index < facts.role_slot_counts[constructor_index] {
                let slot_row: Int = facts.role_slot_starts[constructor_index] +
                    slot_index;
                if facts.role_slot_names[slot_row] == field_name {
                    return Some(facts.role_slot_type_names[slot_row]);
                }
                slot_index = slot_index + 1;
            }
            return None;
        }
        constructor_index = constructor_index + 1;
    }
    return None;
}

func SemanticAstNominalConstructorFactsMatchArtifact(
    artifact: AstTreeArtifact,
    facts: SemanticAstNominalConstructorFacts
) -> Bool {
    let rebuilt: SemanticAstNominalConstructorFacts =
        SemanticAstNominalConstructorFactsFromArtifact(artifact);
    let count: Int = SemanticAstNominalConstructorCount(facts);
    if !SemanticAstNominalConstructorRowsReady(facts) || !rebuilt.ok ||
        facts.artifact_node_count != artifact.count ||
        SemanticAstNominalConstructorCount(rebuilt) != count ||
        ArrayLength(facts.names) != count ||
        ArrayLength(facts.return_type_names) != count ||
        ArrayLength(facts.param_starts) != count ||
        ArrayLength(facts.param_counts) != count ||
        ArrayLength(facts.role_slot_starts) != count ||
        ArrayLength(facts.role_slot_counts) != count ||
        ArrayLength(facts.field_names) != ArrayLength(rebuilt.field_names) ||
        ArrayLength(facts.param_type_names) !=
            ArrayLength(rebuilt.param_type_names) ||
        ArrayLength(facts.role_slot_names) !=
            ArrayLength(rebuilt.role_slot_names) ||
        ArrayLength(facts.role_slot_type_names) !=
            ArrayLength(rebuilt.role_slot_type_names) {
        return false;
    }
    let i: Int = 0;
    while i < count {
        if facts.node_ids[i] != rebuilt.node_ids[i] ||
            facts.nominal_kinds[i] != rebuilt.nominal_kinds[i] ||
            facts.names[i] != rebuilt.names[i] ||
            facts.return_type_names[i] != rebuilt.return_type_names[i] ||
            facts.param_starts[i] != rebuilt.param_starts[i] ||
            facts.param_counts[i] != rebuilt.param_counts[i] ||
            facts.role_slot_starts[i] != rebuilt.role_slot_starts[i] ||
            facts.role_slot_counts[i] != rebuilt.role_slot_counts[i] {
            return false;
        }
        i = i + 1;
    }
    let p: Int = 0;
    while p < ArrayLength(facts.param_type_names) {
        if facts.field_names[p] != rebuilt.field_names[p] ||
            facts.param_type_names[p] != rebuilt.param_type_names[p] {
            return false;
        }
        p = p + 1;
    }
    p = 0;
    while p < ArrayLength(facts.role_slot_type_names) {
        if facts.role_slot_names[p] != rebuilt.role_slot_names[p] ||
            facts.role_slot_type_names[p] != rebuilt.role_slot_type_names[p] {
            return false;
        }
        p = p + 1;
    }
    return true;
}

func SemanticAstNominalConstructorFactsContractReady() -> Bool {
    let artifact: AstTreeArtifact = AstTreeArtifactFromText(
        "Program:\n  Class: Box\n    Fields:\n      value: String\n      count: Int\n    Methods:\n      Function: Get\n        Parameters:\n          self\n        Returns: String\n        Body:\n          Block:\n            Return: self.value\n"
    );
    let facts: SemanticAstNominalConstructorFacts =
        SemanticAstNominalConstructorFactsFromArtifact(artifact);
    let first: Option<String> = SemanticAstNominalConstructorParamTypeAt(
        facts, 0, 0
    );
    let second: Option<String> = SemanticAstNominalConstructorParamTypeAt(
        facts, 0, 1
    );
    let first_name: Option<String> = SemanticAstNominalConstructorFieldNameAt(
        facts, 0, 0
    );
    return SemanticAstNominalConstructorFactsMatchArtifact(artifact, facts) &&
        SemanticAstNominalConstructorCount(facts) == 1 &&
        facts.nominal_kinds[0] == "class" && facts.names[0] == "Box" &&
        facts.return_type_names[0] == "Box" &&
        facts.param_counts[0] == 2 && IsSome(first) && IsSome(second) &&
        IsSome(first_name) && UnwrapOption(first_name) == "value" &&
        UnwrapOption(first) == "String" && UnwrapOption(second) == "Int";
}
