// Read-only identity lookup over semantic nominal-constructor facts.
// Duplicate names fail closed rather than selecting an arbitrary declaration.

import "ast_nominal_constructor_fact_owner.pgy";

func SemanticAstNominalConstructorUniqueIndexForName(
    ref facts: SemanticAstNominalConstructorFacts,
    name: String
) -> Result<Int> {
    if !facts.ok || name == "" ||
        ArrayLength(facts.names) != ArrayLength(facts.node_ids) {
        return Err("nominal_constructor_identity");
    }
    // The facts producer counted every name row once.
    let count: Int = SemanticCallableNameTableValue(facts.name_row_counts, name);
    if count > 1 { return Err("nominal_constructor_identity"); }
    if count == 1 { return Ok(SemanticCallableNameTableValue(facts.name_first_rows, name)); }
    return Ok(-1);
}

func SemanticAstNominalConstructorIndexForName(
    ref facts: SemanticAstNominalConstructorFacts, name: String
) -> Option<Int> {
    let found: Result<Int> =
        SemanticAstNominalConstructorUniqueIndexForName(facts, name);
    if IsErr(found) || Unwrap(found) < 0 { return None; }
    return Some(Unwrap(found));
}

// The same unique lookup for a name held in a borrowed table row. Only a copy
// of the row is looked up, never the row itself, so a readonly table formal
// stays a read at every caller.
func SemanticAstNominalConstructorIndexForNameAt(
    ref facts: SemanticAstNominalConstructorFacts,
    ref names: Array<String>, row: Int
) -> Option<Int> {
    if !facts.ok || row < 0 || row >= ArrayLength(names) || names[row] == "" ||
        ArrayLength(facts.names) != ArrayLength(facts.node_ids) {
        return None;
    }
    let wanted: String = Concat("", names[row]);
    if SemanticCallableNameTableValue(facts.name_row_counts, wanted) != 1 { return None; }
    return Some(SemanticCallableNameTableValue(facts.name_first_rows, wanted));
}

// Field identity is scoped by the owning declaration, never by field type.
func SemanticAstNominalConstructorFieldRowForName(
    ref facts: SemanticAstNominalConstructorFacts,
    owner_index: Int, name: String
) -> Option<Int> {
    if !facts.ok || owner_index < 0 ||
        owner_index >= SemanticAstNominalConstructorCount(facts) || name == "" {
        return None;
    }
    let found: Int = -1;
    let row: Int = facts.param_starts[owner_index];
    let end: Int = row + facts.param_counts[owner_index];
    while row < end {
        if facts.field_names[row] == name {
            if found >= 0 { return None; }
            found = row;
        }
        row = row + 1;
    }
    if found < 0 { return None; }
    return Some(found);
}

// The first declaration named `nominal_name` owns the field or role slot.
func SemanticAstNominalFieldType(
    ref facts: SemanticAstNominalConstructorFacts, nominal_name: String,
    field_name: String
) -> Option<String> {
    let constructor_index: Int =
        SemanticCallableNameTableValue(facts.name_first_rows, nominal_name);
    if constructor_index < 0 { return None; }
    let field_index: Int = 0;
    while field_index < facts.param_counts[constructor_index] {
        let row: Int = facts.param_starts[constructor_index] + field_index;
        if facts.field_names[row] == field_name {
            return Some(facts.param_type_names[row]);
        }
        field_index = field_index + 1;
    }
    let slot_index: Int = 0;
    while slot_index < facts.role_slot_counts[constructor_index] {
        let slot_row: Int = facts.role_slot_starts[constructor_index] + slot_index;
        if facts.role_slot_names[slot_row] == field_name {
            return Some(facts.role_slot_type_names[slot_row]);
        }
        slot_index = slot_index + 1;
    }
    return None;
}
