// Read-only identity lookup over semantic nominal-constructor facts.
// Duplicate names fail closed rather than selecting an arbitrary declaration.

import "ast_nominal_constructor_fact_owner.pgy";

func SemanticAstNominalConstructorUniqueIndexForName(
    ref facts: SemanticAstNominalConstructorFacts,
    name: String
) -> Result<Int> {
    if !facts.ok || name == "" ||
        ArrayLength(facts.names) != ArrayLength(facts.node_ids) {
        return Err("nominal_constructor_identity");
    }
    let found: Int = -1;
    let i: Int = 0;
    while i < SemanticAstNominalConstructorCount(facts) {
        if facts.names[i] == name {
            if found >= 0 { return Err("nominal_constructor_identity"); }
            found = i;
        }
        i = i + 1;
    }
    return Ok(found);
}

func SemanticAstNominalConstructorIndexForName(
    ref facts: SemanticAstNominalConstructorFacts, name: String
) -> Option<Int> {
    let found: Result<Int> =
        SemanticAstNominalConstructorUniqueIndexForName(facts, name);
    if IsErr(found) || Unwrap(found) < 0 { return None; }
    return Some(Unwrap(found));
}

// The same unique lookup for a name held in a borrowed table row. The row is
// compared in place, never bound or stored, so a readonly table formal stays
// a read at every caller.
func SemanticAstNominalConstructorIndexForNameAt(
    ref facts: SemanticAstNominalConstructorFacts,
    ref names: Array<String>, row: Int
) -> Option<Int> {
    if !facts.ok || row < 0 || row >= ArrayLength(names) || names[row] == "" ||
        ArrayLength(facts.names) != ArrayLength(facts.node_ids) {
        return None;
    }
    let found: Int = -1;
    let i: Int = 0;
    while i < SemanticAstNominalConstructorCount(facts) {
        if facts.names[i] == names[row] {
            if found >= 0 { return None; }
            found = i;
        }
        i = i + 1;
    }
    if found < 0 { return None; }
    return Some(found);
}

// Field identity is scoped by the owning declaration, never by field type.
func SemanticAstNominalConstructorFieldRowForName(
    ref facts: SemanticAstNominalConstructorFacts,
    owner_index: Int, name: String
) -> Option<Int> {
    if !facts.ok || owner_index < 0 ||
        owner_index >= SemanticAstNominalConstructorCount(facts) || name == "" {
        return None;
    }
    let found: Int = -1;
    let row: Int = facts.param_starts[owner_index];
    let end: Int = row + facts.param_counts[owner_index];
    while row < end {
        if facts.field_names[row] == name {
            if found >= 0 { return None; }
            found = row;
        }
        row = row + 1;
    }
    if found < 0 { return None; }
    return Some(found);
}
