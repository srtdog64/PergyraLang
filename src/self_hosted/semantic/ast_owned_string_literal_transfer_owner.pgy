// Exact straight-line transfer of one own String formal into a one-element
// Array<String> literal. The formal mode identifies the entry obligation; it
// does not grant callers allocation ownership. This owner only proves the
// callee body's borrow-before-transfer and completed definition transition.

import "ast_collection_assignment_definition_owner.pgy";
import "ast_collection_ownership_identity_owner.pgy";
import "ast_collection_ownership_state_owner.pgy";
import "ast_expression_graph_array_literal_owner.pgy";
import "ast_expression_graph_call_argument_edge_owner.pgy";
import "ast_expression_graph_node_view_owner.pgy";
import "ast_expression_call_identity_owner.pgy";
import "ast_owned_string_expression_domain_owner.pgy";
import "ast_collection_ownership_verdict_carrier_owner.pgy";
import "diagnostic_owner.pgy";
import "ast_owned_string_actual_exclusivity_owner.pgy";

struct SemanticAstOwnedStringLiteralTransferFacts {
    ok: Bool;
    definition_rows: Array<Int>;
    definition_slots: Array<Int>;
    formal_syntax_ids: Array<Int>;
    source_kinds: Array<Int>;
    element_leaf_nodes: Array<Int>;
    element_event_nodes: Array<Int>;
    states: Array<Int>;
}

func SemanticAstOwnedStringTransferFormalReady() -> Int { return 1; }
func SemanticAstOwnedStringTransferElementPending() -> Int { return 2; }
func SemanticAstOwnedStringTransferConsumed() -> Int { return 3; }

func SemanticAstOwnedStringLiteralTransferFactsEmpty(
) -> SemanticAstOwnedStringLiteralTransferFacts {
    let rows: Array<Int> = [];
    return SemanticAstOwnedStringLiteralTransferFacts(
        false, rows, rows, rows, rows, rows, rows, rows);
}

func SemanticAstOwnedStringTransferFormalSource() -> Int { return 1; }
func SemanticAstOwnedStringTransferLocalSource() -> Int { return 2; }

func SemanticAstOwnedStringLiteralTransferDirectDefinition(
    artifact: AstTreeArtifact, function_id: Int, definition_id: Int
) -> Bool {
    if function_id <= 0 || definition_id <= 0 ||
        function_id >= artifact.count || definition_id >= artifact.count {
        return false;
    }
    let parent: Option<Int> = TypedAstArenaParentId(
        artifact.arena, definition_id);
    let remaining: Int = artifact.count;
    while IsSome(parent) && remaining > 0 {
        let node: Int = UnwrapOption(parent);
        if node == function_id { return true; }
        let kind: Option<Int> = TypedAstArenaNodeKind(artifact.arena, node);
        if !IsSome(kind) { return false; }
        let value: Int = UnwrapOption(kind);
        if value == TypedAstKindForStmtTag() ||
            value == TypedAstKindWhileStmtTag() ||
            value == TypedAstKindIfStmtTag() ||
            value == TypedAstKindDeferStmtTag() ||
            value == TypedAstKindMatchStmtTag() ||
            value == TypedAstKindMatchCaseStmtTag() ||
            value == TypedAstKindMatchDefaultStmtTag() ||
            value == TypedAstKindParallelBlockTag() ||
            value == TypedAstKindAsyncBlockTag() ||
            value == TypedAstKindTransactionBlockTag() {
            return false;
        }
        parent = TypedAstArenaParentId(artifact.arena, node);
        remaining = remaining - 1;
    }
    return false;
}

func SemanticAstOwnedStringLiteralTransferUsesReady(
    artifact: AstTreeArtifact,
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    function_id: Int, formal_syntax_id: Int,
    definition_slot: Int, element_leaf_node: Int
) -> Bool {
    let transfer_uses: Int = 0;
    let slot: Int = 0;
    while slot < ArrayLength(surfaces.expression_graph.roots) {
        if surfaces.expression_graph.has_roots[slot] &&
            surfaces.function_node_ids[slot / 3] == function_id {
            let start: Option<Int> = SemanticExpressionGraphRootStartAt(
                surfaces.expression_graph, slot);
            if !IsSome(start) { return false; }
            let root: Int = surfaces.expression_graph.roots[slot];
            let node: Int = UnwrapOption(start);
            while node <= root {
                let identity: SemanticExpressionBindingIdentityFact =
                    SemanticExpressionGraphBindingIdentity(
                        surfaces.expression_graph, node);
                if identity.ok &&
                    identity.kind == SemanticExpressionBindingFormalParameter() &&
                    identity.syntax_id == formal_syntax_id {
                    let formal: SemanticAstCollectionFormalStorageIdentity =
                        SemanticAstCollectionSourceFormalIdentity(
                            signatures, function_id,
                            surfaces.expression_graph, node);
                    if !formal.ok || formal.mode != 2 ||
                        formal.declared_type_name != "String" { return false; }
                    if slot == definition_slot && node == element_leaf_node {
                        transfer_uses = transfer_uses + 1;
                    } else if slot >= definition_slot ||
                        !SemanticAstOwnedStringLiteralTransferDirectDefinition(
                            artifact, function_id,
                            surfaces.node_ids[slot / 3]) ||
                        !SemanticAstOwnedStringLiteralTransferBorrowUseExclusive(
                            surfaces, UnwrapOption(start), root, node) {
                        return false;
                    }
                }
                node = node + 1;
            }
        }
        slot = slot + 1;
    }
    return transfer_uses == 1;
}

func SemanticAstOwnedStringLiteralTransferDeepDropReady(
    artifact: AstTreeArtifact,
    ref locals: SemanticAstLocalBindingFacts,
    ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    definition_row: Int, definition_slot: Int
) -> Bool {
    if definition_row < 0 || definition_row >= ArrayLength(locals.node_ids) {
        return false;
    }
    let drops: Int = 0;
    let slot: Int = definition_slot + 1;
    while slot < ArrayLength(surfaces.expression_graph.roots) {
        if surfaces.expression_graph.has_roots[slot] &&
            surfaces.function_node_ids[slot / 3] ==
                locals.function_node_ids[definition_row] {
            let start: Option<Int> = SemanticExpressionGraphRootStartAt(
                surfaces.expression_graph, slot);
            if !IsSome(start) { return false; }
            let root: Int = surfaces.expression_graph.roots[slot];
            let node: Int = UnwrapOption(start);
            while node <= root {
                let kind: Option<Int> = SemanticExpressionGraphNodeKind(
                    surfaces.expression_graph, node);
                if IsSome(kind) && UnwrapOption(kind) ==
                        AstExpressionNodeCallArgument() {
                    let edge: SemanticCallArgumentEdgeView =
                        SemanticCallArgumentEdgeFromGraph(
                            surfaces.expression_graph, node);
                    if !edge.ok { return false; }
                    if edge.ordinal == 0 &&
                        SemanticAstCollectionOwnershipBuiltinCall(
                            surfaces.expression_graph, edge.call_node,
                            "ArrayDropOwnedStrings") {
                        let binding: SemanticAstLocalBindingIdentity =
                            SemanticAstCollectionOwnershipLocalForArgument(
                                artifact, locals, inferred_types, surfaces,
                                slot / 3, edge.argument_node);
                        if binding.ok && binding.row == definition_row {
                            if !SemanticAstOwnedStringLiteralTransferDirectDefinition(
                                    artifact,
                                    locals.function_node_ids[definition_row],
                                    surfaces.node_ids[slot / 3]) {
                                return false;
                            }
                            drops = drops + 1;
                        }
                    }
                }
                node = node + 1;
            }
        }
        slot = slot + 1;
    }
    return drops == 1;
}

func SemanticAstOwnedStringLiteralTransferLocalUsesReady(
    artifact: AstTreeArtifact,
    ref locals: SemanticAstLocalBindingFacts,
    ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref binding: SemanticAstLocalBindingIdentity,
    definition_slot: Int, element_leaf_node: Int
) -> Bool {
    let transfer_uses: Int = 0;
    let slot: Int = 0;
    while slot < ArrayLength(surfaces.expression_graph.roots) {
        if surfaces.expression_graph.has_roots[slot] &&
            surfaces.function_node_ids[slot / 3] ==
                locals.function_node_ids[binding.row] {
            let start: Option<Int> =
                SemanticExpressionGraphRootStartAt(
                    surfaces.expression_graph, slot);
            if !IsSome(start) { return false; }
            let root: Int = surfaces.expression_graph.roots[slot];
            let node: Int = UnwrapOption(start);
            while node <= root {
                let occurrence: SemanticAstLocalBindingIdentity =
                    SemanticAstScopedLocalBindingIdentityForGraphLeaf(
                        artifact, locals, inferred_types,
                        locals.function_node_ids[binding.row],
                        surfaces.node_ids[slot / 3],
                        surfaces.expression_graph, node);
                if occurrence.ok && occurrence.row == binding.row {
                    if slot == definition_slot &&
                        node == element_leaf_node {
                        transfer_uses = transfer_uses + 1;
                    } else if slot >= definition_slot ||
                        !SemanticAstOwnedStringLiteralTransferDirectDefinition(
                            artifact,
                            locals.function_node_ids[binding.row],
                            surfaces.node_ids[slot / 3]) ||
                        (!SemanticAstOwnedStringLiteralTransferBorrowUseExclusive(
                            surfaces, UnwrapOption(start), root, node) &&
                         !SemanticAstOwnedStringLiteralTransferComparisonUseExclusive(
                            surfaces.expression_graph,
                            UnwrapOption(start), root, node)) {
                        return false;
                    }
                }
                node = node + 1;
            }
        }
        slot = slot + 1;
    }
    return transfer_uses == 1;
}

func SemanticAstOwnedStringLiteralTransferLocalSourceDirect(
    artifact: AstTreeArtifact,
    ref locals: SemanticAstLocalBindingFacts,
    ref inferred_types: Array<String>,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref binding: SemanticAstLocalBindingIdentity
) -> Bool {
    let initializer: Option<Int> = SemanticAstExpressionGraphRootForNode(
        surfaces, binding.declaration_node_id, AstExpressionLaneValue());
    if !IsSome(initializer) { return false; }
    let source: SemanticAstLocalBindingIdentity =
        SemanticAstScopedLocalBindingIdentityForGraphLeaf(
            artifact, locals, inferred_types,
            locals.function_node_ids[binding.row],
            binding.declaration_node_id, surfaces.expression_graph,
            UnwrapOption(initializer));
    return !source.ok;
}

func SemanticAstOwnedStringLiteralTransferFactsFromDefinitions(
    artifact: AstTreeArtifact,
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref locals: SemanticAstLocalBindingFacts,
    ref initializer_types: SemanticAstInitializerTypeFacts,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref results: SemanticAstOwnedStringResultFacts,
    ref numeric: SemanticAstNumericStringAllocationCalls,
    ref definitions: SemanticAstCollectionDefinitionFacts
) -> SemanticAstOwnedStringLiteralTransferFacts {
    let facts: SemanticAstOwnedStringLiteralTransferFacts =
        SemanticAstOwnedStringLiteralTransferFactsEmpty();
    if !SemanticAstBuiltinArgumentRetentionCallFactsReady(surfaces) ||
        !definitions.ok || !signatures.ok || !locals.ok || !surfaces.ok ||
        !initializer_types.ok || !results.ok ||
        !SemanticAstNumericStringAllocationCallsReady(numeric) ||
        ArrayLength(initializer_types.inferred_type_names) !=
            ArrayLength(locals.node_ids) ||
        definitions.local_count != ArrayLength(locals.node_ids) {
        return facts;
    }
    let definition: Int = 0;
    while definition < definitions.local_count {
        if SemanticAstCollectionOwnershipIsStringArray(
                initializer_types.inferred_type_names[definition]) {
            let root: Int = definitions.value_nodes[definition];
            if root < 0 { return facts; }
            let literal: SemanticArrayLiteralView =
                SemanticArrayLiteralViewFromGraph(
                    surfaces.expression_graph, root);
            if literal.ok && ArrayLength(literal.element_nodes) == 1 {
                let leaf: Int = literal.element_nodes[0];
                let formal: SemanticAstCollectionFormalStorageIdentity =
                    SemanticAstCollectionSourceFormalIdentity(
                        signatures, locals.function_node_ids[definition],
                        surfaces.expression_graph, leaf);
                if formal.ok && formal.mode == 2 &&
                    formal.declared_type_name == "String" {
                    let surface: Option<Int> =
                        SemanticAstExpressionSurfaceIndexForNode(
                            surfaces, definitions.syntax_ids[definition]);
                    if !IsSome(surface) { return facts; }
                    let slot: Int = UnwrapOption(surface) * 3 +
                        AstExpressionLaneValue();
                    if SemanticAstOwnedStringLiteralTransferDirectDefinition(
                            artifact,
                            locals.function_node_ids[definition],
                            definitions.syntax_ids[definition]) &&
                        SemanticAstOwnedStringLiteralTransferUsesReady(
                            artifact, signatures, surfaces,
                            locals.function_node_ids[definition],
                            formal.syntax_id, slot, leaf) &&
                        SemanticAstOwnedStringLiteralTransferDeepDropReady(
                            artifact, locals,
                            initializer_types.inferred_type_names, surfaces,
                            definition, slot) {
                        let existing: Int = 0;
                        while existing < ArrayLength(facts.formal_syntax_ids) {
                            if facts.formal_syntax_ids[existing] == formal.syntax_id {
                                return facts;
                            }
                            existing = existing + 1;
                        }
                        ArrayPush(facts.definition_rows, definition);
                        ArrayPush(facts.definition_slots, slot);
                        ArrayPush(facts.formal_syntax_ids, formal.syntax_id);
                        ArrayPush(facts.source_kinds,
                            SemanticAstOwnedStringTransferFormalSource());
                        ArrayPush(facts.element_leaf_nodes, leaf);
                        ArrayPush(facts.element_event_nodes, root);
                        ArrayPush(facts.states,
                            SemanticAstOwnedStringTransferFormalReady());
                    }
                } else {
                    let binding: SemanticAstLocalBindingIdentity =
                        SemanticAstScopedLocalBindingIdentityForGraphLeaf(
                            artifact, locals,
                            initializer_types.inferred_type_names,
                            locals.function_node_ids[definition],
                            definitions.syntax_ids[definition],
                            surfaces.expression_graph, leaf);
                    let surface: Option<Int> =
                        SemanticAstExpressionSurfaceIndexForNode(
                            surfaces, definitions.syntax_ids[definition]);
                    if binding.ok && binding.type_name == "String" &&
                        IsSome(surface) {
                        let slot: Int = UnwrapOption(surface) * 3 +
                            AstExpressionLaneValue();
                        let domain: SemanticAstOwnedStringAllocationDomain =
                            SemanticAstOwnedStringExpressionAllocationDomain(
                                artifact, signatures, locals,
                                initializer_types, surfaces,
                                results.writes, results.domain_exposures,
                                results, numeric,
                                locals.function_node_ids[definition],
                                definitions.syntax_ids[definition],
                                AstExpressionLaneValue(), leaf, 0);
                        if domain.kind == 1 &&
                            SemanticAstOwnedStringLiteralTransferLocalSourceDirect(
                                artifact, locals,
                                initializer_types.inferred_type_names,
                                surfaces, binding) &&
                            SemanticAstOwnedStringLocalNotReassigned(
                                results.writes, binding) &&
                            SemanticAstOwnedStringValueDomainPreserved(
                                results.domain_exposures,
                                binding.declaration_node_id) &&
                            SemanticAstOwnedStringLiteralTransferDirectDefinition(
                                artifact,
                                locals.function_node_ids[definition],
                                definitions.syntax_ids[definition]) &&
                            SemanticAstOwnedStringLiteralTransferLocalUsesReady(
                                artifact, locals,
                                initializer_types.inferred_type_names,
                                surfaces, binding, slot, leaf) &&
                            SemanticAstOwnedStringLiteralTransferDeepDropReady(
                                artifact, locals,
                                initializer_types.inferred_type_names,
                                surfaces, definition, slot) {
                            let existing: Int = 0;
                            while existing <
                                    ArrayLength(facts.formal_syntax_ids) {
                                if facts.formal_syntax_ids[existing] ==
                                        binding.declaration_node_id {
                                    return facts;
                                }
                                existing = existing + 1;
                            }
                            ArrayPush(facts.definition_rows, definition);
                            ArrayPush(facts.definition_slots, slot);
                            ArrayPush(facts.formal_syntax_ids,
                                binding.declaration_node_id);
                            ArrayPush(facts.source_kinds,
                                SemanticAstOwnedStringTransferLocalSource());
                            ArrayPush(facts.element_leaf_nodes, leaf);
                            ArrayPush(facts.element_event_nodes, root);
                            ArrayPush(facts.states,
                                SemanticAstOwnedStringTransferFormalReady());
                        }
                    }
                }
            }
        }
        definition = definition + 1;
    }
    facts.ok = true;
    return facts;
}

func SemanticAstOwnedStringLiteralTransferParameterNode(
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref graph: SemanticExpressionGraphFacts,
    call_node: Int, argument_ordinal: Int
) -> Int {
    let target: Option<Int> = SemanticExpressionGraphCallTargetSyntaxId(
        graph, call_node);
    if !IsSome(target) || UnwrapOption(target) <= 0 ||
        argument_ordinal < 0 { return 0; }
    let signature: Option<Int> = SemanticAstFunctionSignatureIndexForNode(
        signatures, UnwrapOption(target));
    if !IsSome(signature) { return 0; }
    let row: Int = UnwrapOption(signature);
    if row < 0 || row >= ArrayLength(signatures.receiver_source_param_offsets) {
        return 0;
    }
    let offset: Int = signatures.receiver_source_param_offsets[row];
    let source_ordinal: Int = argument_ordinal + offset;
    let parameter: Option<Int> = SemanticAstFunctionParamFlatIndex(
        signatures, row, source_ordinal);
    if offset < 0 || offset > 1 || !IsSome(parameter) { return 0; }
    let flat: Int = UnwrapOption(parameter);
    if signatures.param_modes[flat] != 2 ||
        signatures.param_types[flat] != "String" ||
        signatures.param_node_ids[flat] <= 0 { return 0; }
    return signatures.param_node_ids[flat];
}

func SemanticAstOwnedStringLiteralTransferRequiresFormal(
    ref facts: SemanticAstOwnedStringLiteralTransferFacts,
    formal_syntax_id: Int
) -> Bool {
    let row: Int = 0;
    while row < ArrayLength(facts.formal_syntax_ids) {
        if facts.source_kinds[row] ==
                SemanticAstOwnedStringTransferFormalSource() &&
            facts.formal_syntax_ids[row] == formal_syntax_id {
            return true;
        }
        row = row + 1;
    }
    return false;
}

func SemanticAstOwnedStringLiteralTransferCallArgumentVerdict(
    artifact: AstTreeArtifact,
    ref signatures: SemanticAstFunctionSignatureFacts,
    ref locals: SemanticAstLocalBindingFacts,
    ref initializer_types: SemanticAstInitializerTypeFacts,
    ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref results: SemanticAstOwnedStringResultFacts,
    ref numeric: SemanticAstNumericStringAllocationCalls,
    ref facts: SemanticAstOwnedStringLiteralTransferFacts,
    surface_row: Int, lane: Int,
    edge: SemanticCallArgumentEdgeView
) -> SemanticAstCollectionOwnershipVerdict {
    if !edge.ok || surface_row < 0 ||
        surface_row >= ArrayLength(surfaces.node_ids) || lane < 0 || lane > 2 {
        return SemanticAstCollectionOwnershipVerdictError(
            "ast_artifact_invalid",
            SemanticError1("ast_artifact_invalid", "owner",
                "owned_string_literal_transfer_call_edge"), -1, -1);
    }
    let target: Int =
        SemanticAstOwnedStringLiteralTransferParameterNode(
            signatures, surfaces.expression_graph,
            edge.call_node, edge.ordinal);
    if target <= 0 ||
        !SemanticAstOwnedStringLiteralTransferRequiresFormal(facts, target) {
        return SemanticAstCollectionOwnershipVerdictOk();
    }
    let domain: SemanticAstOwnedStringAllocationDomain =
        SemanticAstOwnedStringExpressionAllocationDomain(
            artifact, signatures, locals, initializer_types, surfaces,
            results.writes, results.domain_exposures, results, numeric,
            surfaces.function_node_ids[surface_row],
            surfaces.node_ids[surface_row], lane,
            edge.argument_node, 0);
    let named_actual: SemanticAstLocalBindingIdentity =
        SemanticAstScopedLocalBindingIdentityForGraphLeaf(
            artifact, locals, initializer_types.inferred_type_names,
            surfaces.function_node_ids[surface_row],
            surfaces.node_ids[surface_row], surfaces.expression_graph,
            edge.argument_node);
    if domain.kind != 1 ||
        (named_actual.ok &&
         !SemanticAstOwnedStringLiteralTransferDirectDefinition(
            artifact, surfaces.function_node_ids[surface_row],
            surfaces.node_ids[surface_row])) ||
        !SemanticAstOwnedStringLiteralTransferExpressionExclusive(
            artifact, signatures, locals, initializer_types,
            surfaces, results, numeric,
            surfaces.function_node_ids[surface_row],
            surfaces.node_ids[surface_row], lane,
            edge.argument_node, 0,
            surfaces.node_ids[surface_row], edge.argument_node) {
        return SemanticAstCollectionOwnershipVerdictError(
            "borrow_boundary_escape",
            SemanticError2("borrow_boundary_escape", "boundary",
                "owned_string_actual_unproved", "type", "String"),
            surfaces.node_ids[surface_row], edge.argument_node);
    }
    return SemanticAstCollectionOwnershipVerdictOk();
}

func SemanticAstOwnedStringLiteralTransferFactsReady(
    ref facts: SemanticAstOwnedStringLiteralTransferFacts
) -> Bool {
    let count: Int = ArrayLength(facts.definition_rows);
    return facts.ok && ArrayLength(facts.definition_slots) == count &&
        ArrayLength(facts.formal_syntax_ids) == count &&
        ArrayLength(facts.source_kinds) == count &&
        ArrayLength(facts.element_leaf_nodes) == count &&
        ArrayLength(facts.element_event_nodes) == count &&
        ArrayLength(facts.states) == count;
}

func SemanticAstOwnedStringLiteralTransferObserveElement(
    node: Int, inout facts: SemanticAstOwnedStringLiteralTransferFacts
) -> Bool {
    let row: Int = 0;
    while row < ArrayLength(facts.element_event_nodes) {
        if facts.element_event_nodes[row] == node {
            if facts.states[row] !=
                SemanticAstOwnedStringTransferFormalReady() { return false; }
            facts.states[row] =
                SemanticAstOwnedStringTransferElementPending();
        }
        row = row + 1;
    }
    return true;
}

func SemanticAstOwnedStringLiteralTransferCompleteDefinition(
    slot: Int, definition: Int,
    inout facts: SemanticAstOwnedStringLiteralTransferFacts,
    inout ownership: Array<Int>, inout dispositions: Array<Int>,
    inout origins: Array<Int>, inout transitions: Array<Int>,
    inout origin_syntax_ids: Array<Int>,
    inout source_binding_syntax_ids: Array<Int>
) -> Bool {
    let transfer: Int = 0;
    while transfer < ArrayLength(facts.definition_rows) {
        if facts.definition_rows[transfer] == definition {
            if facts.definition_slots[transfer] != slot ||
                facts.states[transfer] !=
                    SemanticAstOwnedStringTransferElementPending() ||
                definition < 0 || definition >= ArrayLength(ownership) {
                return false;
            }
            ownership[definition] =
                SemanticAstCollectionOwnershipOwnedElements();
            dispositions[definition] =
                SemanticAstCollectionDispositionLive();
            if facts.source_kinds[transfer] ==
                    SemanticAstOwnedStringTransferFormalSource() {
                origins[definition] =
                    SemanticAstCollectionOriginFormalStringTransfer();
            } else if facts.source_kinds[transfer] ==
                    SemanticAstOwnedStringTransferLocalSource() {
                origins[definition] =
                    SemanticAstCollectionOriginLocalStringTransfer();
            } else {
                return false;
            }
            transitions[definition] =
                SemanticAstCollectionTransitionOwned();
            origin_syntax_ids[definition] =
                facts.formal_syntax_ids[transfer];
            source_binding_syntax_ids[definition] =
                facts.formal_syntax_ids[transfer];
            facts.states[transfer] =
                SemanticAstOwnedStringTransferConsumed();
        }
        transfer = transfer + 1;
    }
    return true;
}

func SemanticAstOwnedStringLiteralTransfersConsumed(
    ref facts: SemanticAstOwnedStringLiteralTransferFacts
) -> Bool {
    let row: Int = 0;
    while row < ArrayLength(facts.states) {
        if facts.states[row] != SemanticAstOwnedStringTransferConsumed() {
            return false;
        }
        row = row + 1;
    }
    return true;
}
