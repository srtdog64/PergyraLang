// Stable returned allocation domains over resolved source identities.
// All returns must have one exact domain. Completed/current/exclusive lifetime
// and actual formal-to-literal materialization remain separate obligations.
import "ast_owned_string_expression_domain_owner.pgy";

func SemanticAstFunctionStringResultAllocationDomain(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref locals: SemanticAstLocalBindingFacts, ref initializer_types: SemanticAstInitializerTypeFacts,
    ref surfaces: SemanticAstExpressionSurfaceFacts, ref statements: SemanticAstStatementFacts,
    ref facts: SemanticAstOwnedStringResultFacts,
    ref numeric: SemanticAstNumericStringAllocationCalls, signature_row: Int
) -> SemanticAstOwnedStringAllocationDomain {
    if !SemanticAstRuntimeCallableSignatureRowReady(signatures, signature_row) ||
        signatures.return_types[signature_row] != "String" || !signatures.runtime_callables[signature_row] {
        return SemanticAstOwnedStringDomainUnknown();
    }
    let function_id: Int = signatures.function_node_ids[signature_row];
    let range: SemanticAstLocalBindingFunctionRange = SemanticAstStatementRangeForFunction(statements, function_id);
    if !range.ok { return SemanticAstOwnedStringDomainUnknown(); }
    let saw_return: Bool = false;
    let domain: SemanticAstOwnedStringAllocationDomain = SemanticAstOwnedStringDomainUnknown();
    let row: Int = range.start;
    while row < range.end {
        if statements.kind_tags[row] == TypedAstKindValueReturnStmtTag() {
            let root: Option<Int> = SemanticAstExpressionGraphRootForNode(
                surfaces, statements.node_ids[row], AstExpressionLaneAtom());
            if !IsSome(root) { return SemanticAstOwnedStringDomainUnknown(); }
            let actual: SemanticAstOwnedStringAllocationDomain = SemanticAstOwnedStringExpressionAllocationDomain(
                artifact, signatures, locals, initializer_types, surfaces, facts.writes, facts.domain_exposures,
                facts, numeric, function_id, statements.node_ids[row], AstExpressionLaneAtom(), UnwrapOption(root), 0);
            if actual.kind == 0 || (saw_return && !SemanticAstOwnedStringDomainsEqual(domain, actual)) {
                return SemanticAstOwnedStringDomainUnknown();
            }
            domain = actual;
            saw_return = true;
        }
        row = row + 1;
    }
    if !saw_return { return SemanticAstOwnedStringDomainUnknown(); }
    return domain;
}

func SemanticAstOwnedStringResultFactsFromResolvedFacts(
    artifact: AstTreeArtifact, ref signatures: SemanticAstFunctionSignatureFacts,
    ref constructors: SemanticAstNominalConstructorFacts, ref locals: SemanticAstLocalBindingFacts,
    ref initializer_types: SemanticAstInitializerTypeFacts, ref surfaces: SemanticAstExpressionSurfaceFacts,
    ref numeric_string_allocations: SemanticAstNumericStringAllocationCalls,
    ref call_roots: SemanticCallSpineRoots,
    ref statements: SemanticAstStatementFacts, ref assignments: SemanticAstAssignmentFacts,
    ref assignment_types: SemanticAstAssignmentTypeFacts
) -> SemanticAstOwnedStringResultFacts {
    let signature_row: Int = 0;
    while signature_row < ArrayLength(signatures.function_node_ids) {
        if !SemanticAstRuntimeCallableSignatureRowReady(signatures, signature_row) {
            return SemanticAstOwnedStringResultFactsEmpty();
        }
        signature_row = signature_row + 1;
    }
    let ids: Array<Int> = [];
    let kinds: Array<Int> = [];
    let parameters: Array<Int> = [];
    let ordinals: Array<Int> = [];
    let writes: SemanticAstOwnedStringLocalReassignmentFacts =
        SemanticAstOwnedStringLocalReassignmentFactsFromResolvedFacts(
            artifact, signatures, constructors, locals, initializer_types, surfaces, assignments, assignment_types);
    let exposures: SemanticAstOwnedStringDomainExposureFacts =
        SemanticAstOwnedStringDomainExposureFactsFromResolvedFacts(
            artifact, signatures, locals, initializer_types, surfaces, call_roots);
    let facts: SemanticAstOwnedStringResultFacts =
        SemanticAstOwnedStringResultFacts(false, ids, kinds, parameters, ordinals, writes, exposures);
    if !signatures.ok || !locals.ok || !initializer_types.ok || !surfaces.ok || !statements.ok ||
        !writes.ok || !exposures.ok || !SemanticAstNumericStringAllocationCallsReady(numeric_string_allocations) ||
        ArrayLength(initializer_types.inferred_type_names) != ArrayLength(locals.node_ids) { return facts; }
    facts.ok = true;
    let remaining: Int = ArrayLength(signatures.function_node_ids);
    let changed: Bool = true;
    while changed && remaining > 0 {
        changed = false;
        let row: Int = 0;
        while row < ArrayLength(signatures.function_node_ids) {
            let function_id: Int = signatures.function_node_ids[row];
            if SemanticAstOwnedStringResultDomainForFunction(facts, function_id).kind == 0 {
                let domain: SemanticAstOwnedStringAllocationDomain = SemanticAstFunctionStringResultAllocationDomain(
                    artifact, signatures, locals, initializer_types, surfaces, statements, facts, numeric_string_allocations, row);
                if domain.kind > 0 {
                    ArrayPush(facts.function_syntax_ids, function_id);
                    ArrayPush(facts.domain_kinds, domain.kind);
                    ArrayPush(facts.allocator_formal_syntax_ids, domain.allocator_formal_syntax_id);
                    ArrayPush(facts.allocator_formal_ordinals, domain.allocator_formal_ordinal);
                    changed = true;
                }
            }
            row = row + 1;
        }
        remaining = remaining - 1;
    }
    return facts;
}
