// Deep artifact match and falsifying contract for semantic role facts.

import "ast_role_fact_owner.pgy";

func SemanticAstRoleFactsMatchArtifact(
    artifact: AstTreeArtifact,
    facts: SemanticAstRoleFacts
) -> Bool {
    let rebuilt: SemanticAstRoleFacts = SemanticAstRoleFactsFromArtifact(artifact);
    let count: Int = SemanticAstRoleCount(facts);
    if !facts.ok || !rebuilt.ok || facts.artifact_node_count != artifact.count ||
        SemanticAstRoleCount(rebuilt) != count ||
        ArrayLength(facts.method_node_ids) != ArrayLength(rebuilt.method_node_ids) ||
        ArrayLength(facts.method_ability_names) !=
            ArrayLength(rebuilt.method_ability_names) ||
        ArrayLength(facts.impl_starts) != count ||
        ArrayLength(facts.impl_counts) != count ||
        ArrayLength(facts.impl_ability_names) !=
            ArrayLength(rebuilt.impl_ability_names) ||
        SemanticAstAbilityCount(facts) != SemanticAstAbilityCount(rebuilt) ||
        ArrayLength(facts.ability_generic_names) !=
            ArrayLength(rebuilt.ability_generic_names) ||
        ArrayLength(facts.ability_generic_constraint_type_names) !=
            ArrayLength(rebuilt.ability_generic_constraint_type_names) ||
        ArrayLength(facts.ability_method_node_ids) !=
            ArrayLength(rebuilt.ability_method_node_ids) {
        return false;
    }
    let i: Int = 0;
    while i < count {
        if facts.role_node_ids[i] != rebuilt.role_node_ids[i] ||
            facts.names[i] != rebuilt.names[i] ||
            facts.target_type_names[i] != rebuilt.target_type_names[i] ||
            facts.method_starts[i] != rebuilt.method_starts[i] ||
            facts.method_counts[i] != rebuilt.method_counts[i] ||
            facts.impl_starts[i] != rebuilt.impl_starts[i] ||
            facts.impl_counts[i] != rebuilt.impl_counts[i] {
            return false;
        }
        i = i + 1;
    }
    let method_index: Int = 0;
    while method_index < ArrayLength(facts.method_node_ids) {
        if facts.method_node_ids[method_index] != rebuilt.method_node_ids[method_index] ||
            facts.method_ability_names[method_index] !=
                rebuilt.method_ability_names[method_index] {
            return false;
        }
        method_index = method_index + 1;
    }
    let impl_index: Int = 0;
    while impl_index < ArrayLength(facts.impl_ability_names) {
        if facts.impl_ability_names[impl_index] !=
            rebuilt.impl_ability_names[impl_index] {
            return false;
        }
        impl_index = impl_index + 1;
    }
    let ability_index: Int = 0;
    while ability_index < SemanticAstAbilityCount(facts) {
        if facts.ability_node_ids[ability_index] !=
                rebuilt.ability_node_ids[ability_index] ||
            facts.ability_names[ability_index] !=
                rebuilt.ability_names[ability_index] ||
            facts.ability_generic_starts[ability_index] !=
                rebuilt.ability_generic_starts[ability_index] ||
            facts.ability_generic_counts[ability_index] !=
                rebuilt.ability_generic_counts[ability_index] ||
            facts.ability_method_starts[ability_index] !=
                rebuilt.ability_method_starts[ability_index] ||
            facts.ability_method_counts[ability_index] !=
                rebuilt.ability_method_counts[ability_index] {
            return false;
        }
        ability_index = ability_index + 1;
    }
    let generic_index: Int = 0;
    while generic_index < ArrayLength(facts.ability_generic_names) {
        if facts.ability_generic_names[generic_index] !=
                rebuilt.ability_generic_names[generic_index] ||
            facts.ability_generic_constraint_type_names[generic_index] !=
                rebuilt.ability_generic_constraint_type_names[generic_index] ||
            facts.ability_generic_default_type_names[generic_index] !=
                rebuilt.ability_generic_default_type_names[generic_index] {
            return false;
        }
        generic_index = generic_index + 1;
    }
    method_index = 0;
    while method_index < ArrayLength(facts.ability_method_node_ids) {
        if facts.ability_method_node_ids[method_index] !=
            rebuilt.ability_method_node_ids[method_index] {
            return false;
        }
        method_index = method_index + 1;
    }
    return true;
}

func SemanticAstRoleFactsContractReady() -> Bool {
    let artifact: AstTreeArtifact = AstTreeArtifactFromText(
        "Program:\n  Role: IntMath for Int\n    Impl ability: Arithmetic\n      Function: Add\n        Parameters:\n          self\n          rhs: Int\n        Returns: Int\n        Body:\n          Block:\n            Return: 123\n"
    );
    let facts: SemanticAstRoleFacts = SemanticAstRoleFactsFromArtifact(artifact);
    let method: Option<Int> = SemanticAstRoleMethodNodeAt(facts, 0, 0);
    return SemanticAstRoleFactsMatchArtifact(artifact, facts) &&
        SemanticAstRoleCount(facts) == 1 &&
        IsSome(SemanticAstRoleNameAt(facts, 0)) &&
        UnwrapOption(SemanticAstRoleNameAt(facts, 0)) == "IntMath" &&
        IsSome(SemanticAstRoleTargetTypeAt(facts, 0)) &&
        UnwrapOption(SemanticAstRoleTargetTypeAt(facts, 0)) == "Int" &&
        IsSome(method) &&
        IsSome(SemanticAstRoleMethodAbilityNameAt(facts, 0, 0)) &&
        UnwrapOption(SemanticAstRoleMethodAbilityNameAt(facts, 0, 0)) ==
            "Arithmetic";
}
