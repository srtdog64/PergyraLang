// Role declaration and owned-method facts captured once from the typed AST.

import "../hir/ast_text_arena_projection_owner.pgy";
import "../hir/ast_node_kind_owner.pgy";
import "ast_type_name_canonical_owner.pgy";
import "ast_generic_parameter_fact_owner.pgy";
import "expression_normalization_owner.pgy";

struct SemanticAstRoleFacts {
    ok: Bool;
    artifact_node_count: Int;
    role_node_ids: Array<Int>;
    names: Array<String>;
    target_type_names: Array<String>;
    method_starts: Array<Int>;
    method_counts: Array<Int>;
    method_node_ids: Array<Int>;
    // Parallel to method_node_ids.  A role method is callable only through
    // the impl-ability identity captured at its declaration parent.
    method_ability_names: Array<String>;
    impl_starts: Array<Int>;
    impl_counts: Array<Int>;
    impl_ability_names: Array<String>;
    ability_node_ids: Array<Int>;
    ability_names: Array<String>;
    ability_generic_starts: Array<Int>;
    ability_generic_counts: Array<Int>;
    ability_generic_names: Array<String>;
    ability_generic_constraint_type_names: Array<String>;
    ability_generic_default_type_names: Array<String>;
    ability_method_starts: Array<Int>;
    ability_method_counts: Array<Int>;
    ability_method_node_ids: Array<Int>;
}

func SemanticAstAbilityGenericConstraintRowsFromNode(
    arena: AstArena,
    ability_node_id: Int,
    generic_start: Int,
    generic_count: Int,
    generic_names: Array<String>,
    inout generic_constraints: Array<String>
) -> Bool {
    let generic_i: Int = 0;
    while generic_i < generic_count {
        ArrayPush(generic_constraints, "");
        generic_i = generic_i + 1;
    }
    let child_index: Int = 0;
    let child: Option<Int> = TypedAstArenaChildAt(
        arena, ability_node_id, child_index
    );
    while IsSome(child) {
        let child_id: Int = UnwrapOption(child);
        if TypedAstArenaNodeKindIs(
            arena, child_id, TypedAstKindGenericConstraintsTag()
        ) {
            let row_opt: Option<String> = TypedAstArenaAtomText(arena, child_id);
            if !IsSome(row_opt) { return false; }
            let row: String = UnwrapOption(row_opt);
            if StartsWith(row, "where ") {
                row = SemanticTrimSourceRangeReuse(
                    row, 6, StringLength(row)
                );
            }
            let parts: SemanticDelimitedRangeFacts =
                SemanticNestedCommaRangeFactsFromSource(row);
            if SemanticDelimitedRangeCount(parts) == 0 {
                return false;
            }
            let part_i: Int = 0;
            while part_i < SemanticDelimitedRangeCount(parts) {
                let part: String = SemanticDelimitedRangeText(parts, row, part_i);
                let colon: Int = StringIndexOf(part, ":");
                if colon <= 0 {
                    return false;
                }
                let name: String = SemanticTrimSourceRangeReuse(
                    part, 0, colon
                );
                let bounds: String = SemanticTrimSourceRangeReuse(
                    part, colon + 1, StringLength(part)
                );
                let name_i: Int = 0;
                let found: Bool = false;
                while name_i < generic_count {
                    if generic_names[generic_start + name_i] == name {
                        if generic_constraints[generic_start + name_i] != "" ||
                            bounds == "" {
                            return false;
                        }
                        generic_constraints[generic_start + name_i] = bounds;
                        found = true;
                    }
                    name_i = name_i + 1;
                }
                if !found {
                    return false;
                }
                part_i = part_i + 1;
            }
        }
        child_index = child_index + 1;
        child = TypedAstArenaChildAt(arena, ability_node_id, child_index);
    }
    return true;
}

func SemanticAstRoleAncestorNodeId(
    arena: AstArena,
    node_id: Int
) -> Option<Int> {
    let parent: Option<Int> = TypedAstArenaParentId(arena, node_id);
    let remaining: Int = TypedAstArenaNodeCount(arena);
    while IsSome(parent) && remaining > 0 {
        let parent_id: Int = UnwrapOption(parent);
        if TypedAstArenaNodeKindIs(
            arena, parent_id, TypedAstKindRoleDeclTag()
        ) {
            return Some(parent_id);
        }
        parent = TypedAstArenaParentId(arena, parent_id);
        remaining = remaining - 1;
    }
    return None;
}

func SemanticAstRoleMethodAbilityName(
    arena: AstArena,
    method_node_id: Int
) -> Option<String> {
    let parent: Option<Int> = TypedAstArenaParentId(arena, method_node_id);
    let remaining: Int = TypedAstArenaNodeCount(arena);
    while IsSome(parent) && remaining > 0 {
        let parent_id: Int = UnwrapOption(parent);
        if TypedAstArenaNodeKindIs(
            arena, parent_id, TypedAstKindImplAbilityTag()
        ) {
            let ability: Option<String> = TypedAstArenaAtomText(
                arena, parent_id
            );
            if !IsSome(ability) || UnwrapOption(ability) == "" {
                return None;
            }
            return Some(SemanticCanonicalTypeName(UnwrapOption(ability)));
        }
        if TypedAstArenaNodeKindIs(
            arena, parent_id, TypedAstKindRoleDeclTag()
        ) {
            return None;
        }
        parent = TypedAstArenaParentId(arena, parent_id);
        remaining = remaining - 1;
    }
    return None;
}

func SemanticAstRoleFactsFromArtifact(
    artifact: AstTreeArtifact
) -> SemanticAstRoleFacts {
    let role_node_ids: Array<Int> = [];
    let names: Array<String> = [];
    let target_types: Array<String> = [];
    let method_starts: Array<Int> = [];
    let method_counts: Array<Int> = [];
    let method_node_ids: Array<Int> = [];
    let method_ability_names: Array<String> = [];
    let impl_starts: Array<Int> = [];
    let impl_counts: Array<Int> = [];
    let impl_ability_names: Array<String> = [];
    let ability_node_ids: Array<Int> = [];
    let ability_names: Array<String> = [];
    let ability_generic_starts: Array<Int> = [];
    let ability_generic_counts: Array<Int> = [];
    let ability_generic_names: Array<String> = [];
    let ability_generic_constraints: Array<String> = [];
    let ability_generic_defaults: Array<String> = [];
    let ability_method_starts: Array<Int> = [];
    let ability_method_counts: Array<Int> = [];
    let ability_method_node_ids: Array<Int> = [];
    let ok: Bool = AstTreeArtifactReady(artifact);
    let node_id: Int = 0;
    while node_id < artifact.count && ok {
        if TypedAstArenaNodeKindIs(
            artifact.arena, node_id, TypedAstKindRoleDeclTag()
        ) {
            let name: Option<String> = TypedAstArenaAtomText(
                artifact.arena, node_id
            );
            let target: Option<String> = TypedAstArenaTypeName(
                artifact.arena, node_id
            );
            if !IsSome(name) || !IsSome(target) ||
                StringLength(UnwrapOption(name)) == 0 ||
                StringLength(UnwrapOption(target)) == 0 {
                ok = false;
            } else {
                let method_start: Int = ArrayLength(method_node_ids);
                let impl_start: Int = ArrayLength(impl_ability_names);
                let candidate: Int = 0;
                while candidate < artifact.count {
                    let candidate_parent: Option<Int> = TypedAstArenaParentId(
                        artifact.arena, candidate
                    );
                    if TypedAstArenaNodeKindIsCallable(
                        artifact.arena, candidate
                    ) {
                        let owner: Option<Int> = SemanticAstRoleAncestorNodeId(
                            artifact.arena, candidate
                        );
                        if IsSome(owner) && UnwrapOption(owner) == node_id {
                            let method_ability: Option<String> =
                                SemanticAstRoleMethodAbilityName(
                                    artifact.arena, candidate
                                );
                            if !IsSome(method_ability) {
                                ok = false;
                            } else {
                                ArrayPush(method_node_ids, candidate);
                                ArrayPush(
                                    method_ability_names,
                                    UnwrapOption(method_ability)
                                );
                            }
                        }
                    } else if IsSome(candidate_parent) &&
                        UnwrapOption(candidate_parent) == node_id &&
                        TypedAstArenaNodeKindIs(
                            artifact.arena, candidate,
                            TypedAstKindImplAbilityTag()
                        ) {
                        let impl_name: Option<String> = TypedAstArenaAtomText(
                            artifact.arena, candidate
                        );
                        if !IsSome(impl_name) ||
                            StringLength(UnwrapOption(impl_name)) == 0 {
                            ok = false;
                        } else {
                            ArrayPush(
                                impl_ability_names,
                                SemanticCanonicalTypeName(
                                    UnwrapOption(impl_name)
                                )
                            );
                        }
                    }
                    candidate = candidate + 1;
                }
                ArrayPush(role_node_ids, node_id);
                ArrayPush(names, UnwrapOption(name));
                ArrayPush(
                    target_types,
                    SemanticCanonicalTypeName(UnwrapOption(target))
                );
                ArrayPush(method_starts, method_start);
                ArrayPush(
                    method_counts, ArrayLength(method_node_ids) - method_start
                );
                ArrayPush(impl_starts, impl_start);
                ArrayPush(
                    impl_counts,
                    ArrayLength(impl_ability_names) - impl_start
                );
            }
        } else if TypedAstArenaNodeKindIs(
            artifact.arena, node_id, TypedAstKindAbilityDeclTag()
        ) {
            let ability_name: Option<String> = TypedAstArenaAtomText(
                artifact.arena, node_id
            );
            if !IsSome(ability_name) ||
                StringLength(UnwrapOption(ability_name)) == 0 {
                ok = false;
            } else {
                let generic_start: Int = ArrayLength(ability_generic_names);
                let method_start: Int = ArrayLength(ability_method_node_ids);
                if !SemanticAstAbilityGenericParameterDefaultRowsFromNode(
                    artifact.arena, node_id,
                    ability_generic_names, ability_generic_defaults
                ) {
                    ok = false;
                }
                if ok && !SemanticAstAbilityGenericConstraintRowsFromNode(
                    artifact.arena, node_id, generic_start,
                    ArrayLength(ability_generic_names) - generic_start,
                    ability_generic_names, ability_generic_constraints
                ) {
                    ok = false;
                }
                let child: Int = 0;
                while child < artifact.count && ok {
                    let parent: Option<Int> = TypedAstArenaParentId(
                        artifact.arena, child
                    );
                    if IsSome(parent) && UnwrapOption(parent) == node_id {
                        if TypedAstArenaNodeKindIsCallable(
                            artifact.arena, child
                        ) {
                            ArrayPush(ability_method_node_ids, child);
                        }
                    }
                    child = child + 1;
                }
                ArrayPush(ability_node_ids, node_id);
                ArrayPush(
                    ability_names,
                    SemanticCanonicalTypeName(UnwrapOption(ability_name))
                );
                ArrayPush(ability_generic_starts, generic_start);
                ArrayPush(
                    ability_generic_counts,
                    ArrayLength(ability_generic_names) - generic_start
                );
                ArrayPush(ability_method_starts, method_start);
                ArrayPush(
                    ability_method_counts,
                    ArrayLength(ability_method_node_ids) - method_start
                );
            }
        }
        node_id = node_id + 1;
    }
    return SemanticAstRoleFacts(
        ok, artifact.count, role_node_ids, names, target_types,
        method_starts, method_counts, method_node_ids, method_ability_names,
        impl_starts, impl_counts, impl_ability_names,
        ability_node_ids, ability_names,
        ability_generic_starts, ability_generic_counts,
        ability_generic_names, ability_generic_constraints,
        ability_generic_defaults,
        ability_method_starts, ability_method_counts,
        ability_method_node_ids
    );
}

func SemanticAstRoleCount(facts: SemanticAstRoleFacts) -> Int {
    return ArrayLength(facts.role_node_ids);
}

func SemanticAstRoleIndexForNode(
    facts: SemanticAstRoleFacts,
    node_id: Int
) -> Option<Int> {
    if !facts.ok { return None; }
    let count: Int = SemanticAstRoleCount(facts);
    let low: Int = 0;
    let high: Int = count;
    while low < high {
        let middle: Int = low + ((high - low) / 2);
        if facts.role_node_ids[middle] < node_id {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    if low < count && facts.role_node_ids[low] == node_id { return Some(low); }
    return None;
}

func SemanticAstRoleNameAt(
    facts: SemanticAstRoleFacts,
    role_index: Int
) -> Option<String> {
    if !facts.ok || role_index < 0 || role_index >= SemanticAstRoleCount(facts) {
        return None;
    }
    return Some(facts.names[role_index]);
}

func SemanticAstRoleTargetTypeAt(
    facts: SemanticAstRoleFacts,
    role_index: Int
) -> Option<String> {
    if !facts.ok || role_index < 0 || role_index >= SemanticAstRoleCount(facts) {
        return None;
    }
    return Some(facts.target_type_names[role_index]);
}

func SemanticAstRoleMethodCountAt(
    facts: SemanticAstRoleFacts,
    role_index: Int
) -> Option<Int> {
    if !facts.ok || role_index < 0 || role_index >= SemanticAstRoleCount(facts) {
        return None;
    }
    return Some(facts.method_counts[role_index]);
}

func SemanticAstRoleMethodNodeAt(
    facts: SemanticAstRoleFacts,
    role_index: Int,
    method_index: Int
) -> Option<Int> {
    if !facts.ok || role_index < 0 || role_index >= SemanticAstRoleCount(facts) ||
        method_index < 0 || method_index >= facts.method_counts[role_index] {
        return None;
    }
    return Some(
        facts.method_node_ids[facts.method_starts[role_index] + method_index]
    );
}

func SemanticAstRoleTargetTypeForMethodNode(
    facts: SemanticAstRoleFacts,
    method_node_id: Int
) -> Option<String> {
    if !facts.ok {
        return None;
    }
    let role_index: Int = 0;
    while role_index < SemanticAstRoleCount(facts) {
        let method_index: Int = 0;
        while method_index < facts.method_counts[role_index] {
            if facts.method_node_ids[
                facts.method_starts[role_index] + method_index
            ] == method_node_id {
                return Some(facts.target_type_names[role_index]);
            }
            method_index = method_index + 1;
        }
        role_index = role_index + 1;
    }
    return None;
}

func SemanticAstRoleMethodAbilityNameAt(
    facts: SemanticAstRoleFacts,
    role_index: Int,
    method_index: Int
) -> Option<String> {
    if !facts.ok || role_index < 0 ||
        role_index >= SemanticAstRoleCount(facts) || method_index < 0 ||
        method_index >= facts.method_counts[role_index] {
        return None;
    }
    let flat: Int = facts.method_starts[role_index] + method_index;
    if flat < 0 || flat >= ArrayLength(facts.method_ability_names) {
        return None;
    }
    return Some(facts.method_ability_names[flat]);
}

func SemanticAstRoleImplAbilityCountAt(
    facts: SemanticAstRoleFacts,
    role_index: Int
) -> Option<Int> {
    if !facts.ok || role_index < 0 || role_index >= SemanticAstRoleCount(facts) {
        return None;
    }
    return Some(facts.impl_counts[role_index]);
}

func SemanticAstRoleImplAbilityNameAt(
    facts: SemanticAstRoleFacts,
    role_index: Int,
    impl_index: Int
) -> Option<String> {
    if !facts.ok || role_index < 0 || role_index >= SemanticAstRoleCount(facts) ||
        impl_index < 0 || impl_index >= facts.impl_counts[role_index] {
        return None;
    }
    return Some(facts.impl_ability_names[
        facts.impl_starts[role_index] + impl_index
    ]);
}

func SemanticAstAbilityCount(facts: SemanticAstRoleFacts) -> Int {
    return ArrayLength(facts.ability_node_ids);
}

func SemanticAstAbilityIndexForName(
    facts: SemanticAstRoleFacts,
    ability_name: String
) -> Option<Int> {
    if !facts.ok { return None; }
    let i: Int = 0;
    while i < SemanticAstAbilityCount(facts) {
        if facts.ability_names[i] == ability_name { return Some(i); }
        i = i + 1;
    }
    return None;
}

func SemanticAstAbilityGenericCountAt(
    facts: SemanticAstRoleFacts,
    ability_index: Int
) -> Option<Int> {
    if !facts.ok || ability_index < 0 ||
        ability_index >= SemanticAstAbilityCount(facts) {
        return None;
    }
    return Some(facts.ability_generic_counts[ability_index]);
}

func SemanticAstAbilityMethodCountAt(
    facts: SemanticAstRoleFacts,
    ability_index: Int
) -> Option<Int> {
    if !facts.ok || ability_index < 0 ||
        ability_index >= SemanticAstAbilityCount(facts) {
        return None;
    }
    return Some(facts.ability_method_counts[ability_index]);
}

func SemanticAstAbilityMethodNodeAt(
    facts: SemanticAstRoleFacts,
    ability_index: Int,
    method_index: Int
) -> Option<Int> {
    if !facts.ok || ability_index < 0 ||
        ability_index >= SemanticAstAbilityCount(facts) ||
        method_index < 0 ||
        method_index >= facts.ability_method_counts[ability_index] {
        return None;
    }
    return Some(facts.ability_method_node_ids[
        facts.ability_method_starts[ability_index] + method_index
    ]);
}

func SemanticAstRoleIndexForName(
    facts: SemanticAstRoleFacts,
    role_name: String
) -> Option<Int> {
    if !facts.ok { return None; }
    let i: Int = 0;
    while i < SemanticAstRoleCount(facts) {
        if facts.names[i] == role_name { return Some(i); }
        i = i + 1;
    }
    return None;
}

func SemanticAstRoleImplementsAbility(
    facts: SemanticAstRoleFacts,
    role_name: String,
    ability_name: String
) -> Bool {
    let role_index: Option<Int> = SemanticAstRoleIndexForName(
        facts, role_name
    );
    if !IsSome(role_index) { return false; }
    let row: Int = UnwrapOption(role_index);
    let i: Int = 0;
    while i < facts.impl_counts[row] {
        if facts.impl_ability_names[facts.impl_starts[row] + i] ==
            ability_name {
            return true;
        }
        i = i + 1;
    }
    return false;
}
