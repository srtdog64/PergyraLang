// Reverse validation that signature rows still match their source artifact.

import "ast_signature_fact_owner.pgy";

func SemanticAstFunctionSignatureRowMatchesArtifact(
    artifact: AstTreeArtifact,
    ref facts: SemanticAstFunctionSignatureFacts,
    signature_index: Int
) -> Bool {
    let function_node_id: Int = facts.function_node_ids[signature_index];
    if function_node_id < 0 || function_node_id >= artifact.count ||
        !TypedAstArenaNodeKindIsCallable(
            artifact.arena, function_node_id
        ) {
        return false;
    }
    let module_path: String = "";
    let module_path_opt: Option<String> = AstSourceModulePathForNode(
        artifact.source_modules, artifact.arena, function_node_id
    );
    if IsSome(module_path_opt) { module_path = UnwrapOption(module_path_opt); }
    if facts.module_paths[signature_index] != module_path { return false; }
    let name: Option<String> = TypedAstArenaAtomText(
        artifact.arena, function_node_id
    );
    let owner: Option<SemanticAstFunctionOwnerFact> =
        SemanticAstFunctionOwnerFactFromArena(
            artifact.arena, function_node_id
        );
    if !IsSome(name) || !IsSome(owner) ||
        UnwrapOption(name) != facts.names[signature_index] ||
        UnwrapOption(owner).name != facts.owner_names[signature_index] ||
        UnwrapOption(owner).runtime_callable !=
            facts.runtime_callables[signature_index] {
        return false;
    }
    let ability_generic_names: Array<String> = [];
    let ability_generic_defaults: Array<String> = [];
    if !SemanticAstFunctionAbilityDefaultRows(
        artifact.arena, function_node_id,
        ability_generic_names, ability_generic_defaults
    ) {
        return false;
    }
    let ability_default_count: Int = SemanticAstGenericDefaultRowCountOrDie(
        ArrayLength(ability_generic_names),
        ArrayLength(ability_generic_defaults));

    let saw_generic_params: Bool = false;
    let saw_parameters: Bool = false;
    let saw_returns: Bool = false;
    let generic_count: Int = 0;
    let parameter_count: Int = 0;
    let receiver_source_param_offset: Int = 0;
    let child_index: Int = 0;
    let child: Option<Int> = TypedAstArenaChildAt(
        artifact.arena, function_node_id, child_index
    );
    while IsSome(child) {
        let child_id: Int = UnwrapOption(child);
        if TypedAstArenaNodeKindIs(
            artifact.arena, child_id, TypedAstKindGenericParamsTag()
        ) {
            if saw_generic_params {
                return false;
            }
            saw_generic_params = true;
        } else if TypedAstArenaNodeKindIs(
            artifact.arena, child_id, TypedAstKindParametersTag()
        ) {
            if saw_parameters {
                return false;
            }
            saw_parameters = true;
            let parameter_index: Int = 0;
            let parameter: Option<Int> = TypedAstArenaChildAt(
                artifact.arena, child_id, parameter_index
            );
            while IsSome(parameter) {
                if parameter_count >= facts.param_counts[signature_index] {
                    return false;
                }
                let parameter_id: Int = UnwrapOption(parameter);
                let flat_index: Int =
                    facts.param_starts[signature_index] + parameter_count;
                let parameter_name: Option<String> = TypedAstArenaAtomText(
                    artifact.arena, parameter_id
                );
                let parameter_type: Option<String> = TypedAstArenaTypeName(
                    artifact.arena, parameter_id
                );
                let parameter_mode: Option<Int> = TypedAstArenaMode(
                    artifact.arena, parameter_id
                );
                let resolved_type: String = "";
                let owner_self: Bool = IsSome(parameter_name) &&
                    StringLength(UnwrapOption(owner).name) > 0 &&
                    UnwrapOption(parameter_name) == "self";
                if owner_self &&
                    (parameter_index != 0 || IsSome(parameter_type)) {
                    return false;
                }
                if IsSome(parameter_type) {
                    resolved_type = SemanticCanonicalTypeName(
                        UnwrapOption(parameter_type)
                    );
                } else if owner_self {
                    resolved_type = UnwrapOption(owner).receiver_type;
                    receiver_source_param_offset = 1;
                } else {
                    return false;
                }
                let default_row: Int = 0;
                while default_row < ability_default_count {
                    if ability_generic_names[default_row] == resolved_type &&
                        ability_generic_defaults[default_row] != "" {
                        resolved_type = ability_generic_defaults[default_row]; break;
                    }
                    default_row = default_row + 1;
                }
                if !TypedAstArenaNodeKindIs(
                    artifact.arena, parameter_id, TypedAstKindParamTag()
                ) || !IsSome(parameter_name) || !IsSome(parameter_mode) ||
                    facts.param_node_ids[flat_index] != parameter_id ||
                    facts.param_names[flat_index] != UnwrapOption(parameter_name) ||
                    facts.param_types[flat_index] != resolved_type ||
                    facts.param_modes[flat_index] != UnwrapOption(parameter_mode) {
                    return false;
                }
                parameter_count = parameter_count + 1;
                parameter_index = parameter_index + 1;
                parameter = TypedAstArenaChildAt(
                    artifact.arena, child_id, parameter_index
                );
            }
        } else if TypedAstArenaNodeKindIs(
            artifact.arena, child_id, TypedAstKindReturnsTag()
        ) {
            if saw_returns {
                return false;
            }
            let return_type: Option<String> = TypedAstArenaTypeName(
                artifact.arena, child_id
            );
            let resolved_return_type: String = "";
            if IsSome(return_type) {
                resolved_return_type = SemanticCanonicalTypeName(
                    UnwrapOption(return_type));
                let default_row: Int = 0;
                while default_row < ability_default_count {
                    if ability_generic_names[default_row] == resolved_return_type &&
                        ability_generic_defaults[default_row] != "" {
                        resolved_return_type = ability_generic_defaults[default_row]; break;
                    }
                    default_row = default_row + 1;
                }
            }
            if !IsSome(return_type) || resolved_return_type !=
                facts.return_types[signature_index] {
                return false;
            }
            saw_returns = true;
        }
        child_index = child_index + 1;
        child = TypedAstArenaChildAt(
            artifact.arena, function_node_id, child_index
        );
    }
    let parsed_rows: SemanticAstGenericParameterFactRows =
        SemanticAstGenericParameterFactRowsFromOwnerNode(
            artifact.arena, function_node_id
        );
    let parsed_rows_ok: Bool = parsed_rows.ok;
    let generic_index: Int = 0;
    let generic_rows_match: Bool = parsed_rows_ok;
    while parsed_rows_ok &&
        generic_index < ArrayLength(parsed_rows.names) && generic_rows_match {
        if generic_index >= facts.generic_counts[signature_index] {
            generic_rows_match = false;
        } else {
            let flat_generic: Int =
                facts.generic_starts[signature_index] + generic_index;
            if facts.generic_names[flat_generic] !=
                parsed_rows.names[generic_index] ||
                facts.generic_constraint_type_names[flat_generic] !=
                    parsed_rows.constraint_type_names[generic_index] {
                generic_rows_match = false;
            }
        }
        generic_index = generic_index + 1;
    }
    generic_count = ArrayLength(parsed_rows.names);
    let matches: Bool = parsed_rows_ok && generic_rows_match &&
        saw_parameters && saw_returns &&
        generic_count == facts.generic_counts[signature_index] &&
        parameter_count == facts.param_counts[signature_index] &&
        receiver_source_param_offset ==
            facts.receiver_source_param_offsets[signature_index];
    SemanticAstGenericParameterFactRowsDrop(parsed_rows);
    return matches;
}

func SemanticAstFunctionSignatureFactsMatchArtifact(
    artifact: AstTreeArtifact,
    ref facts: SemanticAstFunctionSignatureFacts
) -> Bool {
    let n: Int = SemanticAstFunctionSignatureCount(facts);
    let gn: Int = ArrayLength(facts.generic_names);
    let pn: Int = ArrayLength(facts.param_node_ids);
    if !AstTreeArtifactReady(artifact) || !facts.ok ||
        facts.artifact_node_count != artifact.count ||
        ArrayLength(facts.module_paths) != n ||
        ArrayLength(facts.owner_names) != n ||
        ArrayLength(facts.runtime_callables) != n ||
        ArrayLength(facts.names) != n ||
        ArrayLength(facts.return_types) != n ||
        ArrayLength(facts.generic_starts) != n ||
        ArrayLength(facts.generic_counts) != n ||
        ArrayLength(facts.generic_constraint_type_names) != gn ||
        ArrayLength(facts.param_starts) != n ||
        ArrayLength(facts.param_counts) != n ||
        ArrayLength(facts.receiver_source_param_offsets) != n ||
        ArrayLength(facts.param_names) != pn ||
        ArrayLength(facts.param_types) != pn ||
        ArrayLength(facts.param_modes) != pn ||
        !SemanticAstActionContractFactsMatchArtifact(
            artifact, facts.action_contracts
        ) {
        return false;
    }
    let type_rows_match: Bool = facts.type_expressions.ok &&
        ArrayLength(facts.type_expressions.return_roots) ==
            ArrayLength(facts.return_types) &&
        ArrayLength(facts.type_expressions.parameter_roots) ==
            ArrayLength(facts.param_types);
    let empty_names: Array<String> = [];
    let empty_bindings: Array<String> = [];
    let type_row: Int = 0;
    while type_rows_match && type_row < ArrayLength(facts.return_types) {
        let rendered: Option<String> =
            SemanticAstSignatureReturnTypeResolveAt(
                facts.type_expressions, type_row, 0, 0,
                empty_names, empty_bindings
            );
        if !IsSome(rendered) ||
            UnwrapOption(rendered) != facts.return_types[type_row] {
            type_rows_match = false;
        }
        type_row = type_row + 1;
    }
    type_row = 0;
    while type_rows_match && type_row < ArrayLength(facts.param_types) {
        let rendered_parameter: Option<String> =
            SemanticAstSignatureTypeExpressionResolveRoot(
                facts.type_expressions,
                facts.type_expressions.parameter_roots[type_row], 0, 0,
                empty_names, empty_bindings
            );
        if !IsSome(rendered_parameter) ||
            UnwrapOption(rendered_parameter) != facts.param_types[type_row] {
            type_rows_match = false;
        }
        type_row = type_row + 1;
    }
    if !type_rows_match {
        return false;
    }
    let i: Int = 0;
    let next_generic_start: Int = 0;
    let next_param_start: Int = 0;
    let entrypoint_accumulator: SemanticAstEntrypointSelectionAccumulator =
        SemanticAstEntrypointSelectionAccumulatorEmpty();
    while i < n {
        SemanticAstEntrypointSelectionObserve(
            entrypoint_accumulator, facts.owner_names[i],
            facts.runtime_callables[i], facts.names[i], i
        );
        if facts.generic_starts[i] != next_generic_start ||
            facts.generic_counts[i] < 0 ||
            facts.generic_starts[i] + facts.generic_counts[i] > gn ||
            facts.param_starts[i] != next_param_start ||
            facts.param_counts[i] < 0 ||
            facts.param_starts[i] + facts.param_counts[i] > pn ||
            facts.action_contracts.callable_node_ids[i] !=
                facts.function_node_ids[i] ||
            (i > 0 && facts.function_node_ids[i] <= facts.function_node_ids[i - 1]) ||
            !SemanticAstFunctionSignatureRowMatchesArtifact(
                artifact, facts, i
            ) {
            return false;
        }
        next_generic_start = next_generic_start + facts.generic_counts[i];
        next_param_start = next_param_start + facts.param_counts[i];
        i = i + 1;
    }
    if next_generic_start != gn || next_param_start != pn {
        return false;
    }
    if !SemanticAstEntrypointSelectionMatchesAccumulator(
        facts.entrypoint_selection, entrypoint_accumulator
    ) { return false; }
    let function_count: Int = 0;
    let node_id: Int = 0;
    while node_id < artifact.count {
        if TypedAstArenaNodeKindIsCallable(artifact.arena, node_id) {
            function_count = function_count + 1;
        }
        node_id = node_id + 1;
    }
    return function_count == n;
}
