// Function signature facts derived from the shared parser-owned AST artifact.
import "../hir/ast_text_arena_projection_owner.pgy";
import "../hir/ast_node_kind_owner.pgy";
import "diagnostic_owner.pgy";
import "ast_type_name_canonical_owner.pgy";
import "ast_generic_parameter_fact_owner.pgy";
import "ast_signature_type_expression_fact_owner.pgy";
import "ast_action_contract_fact_owner.pgy";
import "ast_entrypoint_selection_policy_owner.pgy";
import "ast_signature_canonical_name_index_owner.pgy";
struct SemanticAstFunctionSignatureFacts {
    ok: Bool;
    diagnostic_code: String;
    diagnostic_message: String;
    diagnostic_fact: SemanticDiagnosticMessageFact;
    artifact_node_count: Int;
    entrypoint_selection: SemanticAstEntrypointSelectionFact;
    action_contracts: SemanticAstActionContractFacts;
    function_node_ids: Array<Int>;
    module_paths: Array<String>;
    owner_names: Array<String>;
    runtime_callables: Array<Bool>;
    names: Array<String>;
    return_types: Array<String>;
    type_expressions: SemanticAstSignatureTypeExpressionFacts;
    generic_starts: Array<Int>;
    generic_counts: Array<Int>;
    generic_names: Array<String>;
    generic_constraint_type_names: Array<String>;
    param_starts: Array<Int>;
    param_counts: Array<Int>;
    receiver_source_param_offsets: Array<Int>;
    param_node_ids: Array<Int>;
    param_names: Array<String>;
    param_types: Array<String>;
    param_modes: Array<Int>;
    canonical_name_first_rows: HashMap<String, Int>; canonical_name_row_counts: HashMap<String, Int>;
}
struct SemanticAstFunctionOwnerFact {
    name: String;
    receiver_type: String;
    runtime_callable: Bool;
}
func SemanticAstFunctionAbilityDefaultRows(arena: AstArena, function_node_id: Int,
    inout names: Array<String>, inout default_type_names: Array<String>) -> Bool {
    let parent: Option<Int> = TypedAstArenaParentId(arena, function_node_id);
    if !IsSome(parent) || !TypedAstArenaNodeKindIs(
        arena, UnwrapOption(parent), TypedAstKindAbilityDeclTag()) {
        return true;
    }
    let parsed: Bool = SemanticAstAbilityGenericParameterDefaultRowsFromNode(
        arena, UnwrapOption(parent), names, default_type_names);
    return parsed;
}
func SemanticAstFunctionOwnerFactFromArena(arena: AstArena, function_node_id: Int
) -> Option<SemanticAstFunctionOwnerFact> {
    var parent: Option<Int> = TypedAstArenaParentId(arena, function_node_id);
    var remaining: Int = TypedAstArenaNodeCount(arena);
    while IsSome(parent) && remaining > 0 {
        let parent_id: Int = UnwrapOption(parent);
        if TypedAstArenaNodeKindIs(arena, parent_id, TypedAstKindNominalDeclTag()
        ) || TypedAstArenaNodeKindIs(arena, parent_id, TypedAstKindRoleDeclTag()) {
            let name: Option<String> = TypedAstArenaAtomText(arena, parent_id);
            // A role body's self is the role's `for` target (docs/206 section 1).
            var receiver: Option<String> = name;
            if TypedAstArenaNodeKindIs(arena, parent_id, TypedAstKindRoleDeclTag()) {
                receiver = TypedAstArenaTypeName(arena, parent_id);
            }
            if !IsSome(name) || !IsSome(receiver) { return None; }
            return Some(SemanticAstFunctionOwnerFact(UnwrapOption(name), UnwrapOption(receiver), true));
        }
        if TypedAstArenaNodeKindIs(
            arena, parent_id, TypedAstKindAbilityDeclTag()
        ) {
            let ability_name: Option<String> = TypedAstArenaAtomText(
                arena, parent_id
            );
            if !IsSome(ability_name) { return None; }
            return Some(SemanticAstFunctionOwnerFact(
                UnwrapOption(ability_name), UnwrapOption(ability_name), false
            ));
        }
        if TypedAstArenaNodeKindIs(
            arena, parent_id, TypedAstKindExternBlockTag()
        ) {
            // Host-ABI members: callable under their bare name like a free
            // function (owner ""), but signature-only like an ability member
            // -- the body lives on the host side of the ABI.
            return Some(SemanticAstFunctionOwnerFact("", "", false));
        }
        parent = TypedAstArenaParentId(arena, parent_id);
        remaining = remaining - 1;
    }
    if IsSome(parent) { return None; }
    return Some(SemanticAstFunctionOwnerFact("", "", true));
}
func SemanticAstFunctionSignatureFactsFromArtifact(
    artifact: AstTreeArtifact
) -> SemanticAstFunctionSignatureFacts {
    var function_node_ids: Array<Int> = [];
    var module_paths: Array<String> = [];
    var owner_names: Array<String> = [];
    var runtime_callables: Array<Bool> = [];
    var names: Array<String> = [];
    var return_types: Array<String> = [];
    var generic_starts: Array<Int> = [];
    var generic_counts: Array<Int> = [];
    var generic_names: Array<String> = [];
    var generic_default_type_names: Array<String> = [];
    var generic_constraint_type_names: Array<String> = [];
    var param_starts: Array<Int> = [];
    var param_counts: Array<Int> = [];
    var receiver_source_param_offsets: Array<Int> = [];
    var param_node_ids: Array<Int> = [];
    var param_names: Array<String> = [];
    var param_types: Array<String> = [];
    var param_modes: Array<Int> = [];
    var entrypoint_accumulator: SemanticAstEntrypointSelectionAccumulator =
        SemanticAstEntrypointSelectionAccumulatorEmpty();
    var ok: Bool = AstTreeArtifactReady(artifact);
    var diagnostic_fact: SemanticDiagnosticMessageFact =
        SemanticDiagnosticMessageFactEmpty();
    if !ok {
        diagnostic_fact = SemanticDiagnosticMessageFact2(
            "ast_artifact_invalid",
            "node_count", ToString(artifact.count),
            "owner", "AstTreeArtifact"
        );
    }
    var node_id: Int = 0;
    while node_id < artifact.count && ok {
        if !TypedAstArenaNodeKindIsCallable(artifact.arena, node_id) {
            node_id = node_id + 1;
            continue;
        }
        let name: Option<String> = TypedAstArenaAtomText(artifact.arena, node_id);
        if !IsSome(name) {
            ok = false;
            diagnostic_fact = SemanticDiagnosticMessageFact2(
                "function_signature_invalid",
                "node_id", ToString(node_id),
                "missing_fact", "function_name"
            );
            continue;
        }
        let owner: Option<SemanticAstFunctionOwnerFact> =
            SemanticAstFunctionOwnerFactFromArena(artifact.arena, node_id);
        if !IsSome(owner) {
            ok = false;
            diagnostic_fact = SemanticDiagnosticMessageFact2(
                "function_signature_invalid",
                "node_id", ToString(node_id),
                "missing_fact", "owner_name"
            );
            continue;
        }
        var ability_generic_names: Array<String> = [];
        var ability_generic_defaults: Array<String> = [];
        if !SemanticAstFunctionAbilityDefaultRows(
            artifact.arena, node_id,
            ability_generic_names, ability_generic_defaults
        ) {
            ok = false;
            diagnostic_fact = SemanticDiagnosticMessageFact2(
                "function_signature_invalid",
                "node_id", ToString(node_id),
                "missing_fact", "ability_generic_defaults"
            );
            continue;
        }
        let ability_default_count: Int = SemanticAstGenericDefaultRowCountOrDie(ArrayLength(ability_generic_names), ArrayLength(ability_generic_defaults));

        var saw_generic_params: Bool = false;
        var saw_parameters: Bool = false;
        var saw_returns: Bool = false;
        var return_type: String = "";
        let generic_start: Int = ArrayLength(generic_names);
        let param_start: Int = ArrayLength(param_node_ids);
        var receiver_source_param_offset: Int = 0;
        var child_index: Int = 0;
        var child: Option<Int> = TypedAstArenaChildAt(
            artifact.arena, node_id, child_index
        );
        while IsSome(child) && ok {
            let child_id: Int = UnwrapOption(child);
            if TypedAstArenaNodeKindIs(
                artifact.arena, child_id, TypedAstKindGenericParamsTag()
            ) {
                if saw_generic_params {
                    ok = false;
                    diagnostic_fact = SemanticDiagnosticMessageFact2(
                        "function_signature_invalid",
                        "node_id", ToString(child_id),
                        "missing_fact", "generic_parameter_rows"
                    );
                    continue;
                }
                saw_generic_params = true;
            } else if TypedAstArenaNodeKindIs(
                artifact.arena, child_id, TypedAstKindParametersTag()
            ) {
                if saw_parameters {
                    ok = false;
                    diagnostic_fact = SemanticDiagnosticMessageFact2(
                        "function_signature_invalid",
                        "node_id", ToString(child_id),
                        "missing_fact", "duplicate_parameters_row"
                    );
                    continue;
                }
                saw_parameters = true;
                var param_index: Int = 0;
                var param: Option<Int> = TypedAstArenaChildAt(
                    artifact.arena, child_id, param_index
                );
                while IsSome(param) && ok {
                    let param_id: Int = UnwrapOption(param);
                    if !TypedAstArenaNodeKindIs(
                        artifact.arena, param_id, TypedAstKindParamTag()
                    ) {
                        ok = false;
                        diagnostic_fact = SemanticDiagnosticMessageFact2(
                            "function_signature_invalid",
                            "node_id", ToString(param_id),
                            "missing_fact", "parameter_kind"
                        );
                        continue;
                    }
                    let param_name: Option<String> = TypedAstArenaAtomText(
                        artifact.arena, param_id);
                    if !IsSome(param_name) {
                        ok = false;
                        diagnostic_fact = SemanticDiagnosticMessageFact2(
                            "function_signature_invalid",
                            "node_id", ToString(param_id),
                            "missing_fact", "parameter_name"
                        );
                        continue;
                    }
                    let param_type: Option<String> = TypedAstArenaTypeName(
                        artifact.arena, param_id);
                    let owner_self: Bool = StringLength(
                        UnwrapOption(owner).name) > 0 &&
                        UnwrapOption(param_name) == "self";
                    if owner_self &&
                        (param_index != 0 || IsSome(param_type)) {
                        ok = false;
                        diagnostic_fact = SemanticDiagnosticMessageFact2(
                            "function_signature_invalid", "node_id",
                            ToString(param_id), "missing_fact",
                            "receiver_source_parameter_shape");
                        continue;
                    }
                    var resolved_param_type: String = "";
                    if IsSome(param_type) {
                        resolved_param_type = SemanticCanonicalTypeName(
                            UnwrapOption(param_type));
                        var default_row: Int = 0;
                        while default_row < ability_default_count {
                            if ability_generic_names[default_row] == resolved_param_type && ability_generic_defaults[default_row] != "" { resolved_param_type = ability_generic_defaults[default_row]; break; }
                            default_row = default_row + 1;
                        }
                    } else if owner_self {
                        resolved_param_type = UnwrapOption(owner).receiver_type;
                        receiver_source_param_offset = 1;
                    } else {
                        ok = false;
                        diagnostic_fact = SemanticDiagnosticMessageFact2(
                            "function_signature_invalid",
                            "node_id", ToString(param_id),
                            "missing_fact", "parameter_type"
                        );
                        continue;
                    }
                    let mode: Option<Int> = TypedAstArenaMode(
                        artifact.arena, param_id);
                    if !IsSome(mode) {
                        ok = false;
                        diagnostic_fact = SemanticDiagnosticMessageFact2(
                            "function_signature_invalid",
                            "node_id", ToString(param_id),
                            "missing_fact", "parameter_mode"
                        );
                        continue;
                    }
                    ArrayPush(param_node_ids, param_id);
                    ArrayPush(param_names, UnwrapOption(param_name));
                    ArrayPush(param_types, resolved_param_type);
                    ArrayPush(param_modes, UnwrapOption(mode));
                    param_index = param_index + 1;
                    param = TypedAstArenaChildAt(
                        artifact.arena, child_id, param_index
                    );
                }
            } else if TypedAstArenaNodeKindIs(
                artifact.arena, child_id, TypedAstKindReturnsTag()
            ) {
                if saw_returns {
                    ok = false;
                    diagnostic_fact = SemanticDiagnosticMessageFact2(
                        "function_signature_invalid",
                        "node_id", ToString(child_id),
                        "missing_fact", "duplicate_returns_row"
                    );
                    continue;
                }
                let return_type_fact: Option<String> =
                    TypedAstArenaTypeName(artifact.arena, child_id);
                if !IsSome(return_type_fact) {
                    ok = false;
                    diagnostic_fact = SemanticDiagnosticMessageFact2(
                        "function_signature_invalid",
                        "node_id", ToString(child_id),
                        "missing_fact", "return_type"
                    );
                    continue;
                }
                saw_returns = true;
                return_type = SemanticCanonicalTypeName(
                    UnwrapOption(return_type_fact)
                );
                var default_row: Int = 0;
                while default_row < ability_default_count {
                    if ability_generic_names[default_row] == return_type && ability_generic_defaults[default_row] != "" { return_type = ability_generic_defaults[default_row]; break; }
                    default_row = default_row + 1;
                }
            }
            child_index = child_index + 1;
            child = TypedAstArenaChildAt(
                artifact.arena, node_id, child_index
            );
        }
        if !ok {
            continue;
        }
        if !saw_parameters {
            ok = false;
            diagnostic_fact = SemanticDiagnosticMessageFact2(
                "function_signature_invalid",
                "node_id", ToString(node_id),
                "missing_fact", "parameters_row"
            );
            continue;
        }
        if !saw_returns {
            ok = false;
            diagnostic_fact = SemanticDiagnosticMessageFact2(
                "function_signature_invalid",
                "node_id", ToString(node_id),
                "missing_fact", "returns_row"
            );
            continue;
        }
        var module_path: String = "";
        let module_path_opt: Option<String> = AstSourceModulePathForNode(artifact.source_modules, artifact.arena, node_id);
        if IsSome(module_path_opt) { module_path = UnwrapOption(module_path_opt); }
        else if artifact.source_modules.known {
            ok = false;
            diagnostic_fact = SemanticDiagnosticMessageFact2("function_signature_invalid", "node_id", ToString(node_id), "missing_fact", "source_module_path");
            continue;
        }
        var generic_rows: SemanticAstGenericParameterFactRows =
            SemanticAstGenericParameterFactRowsFromOwnerNode(
                artifact.arena, node_id
            );
        let generic_rows_ok: Bool = generic_rows.ok;
        if !generic_rows_ok {
            ok = false;
            diagnostic_fact = SemanticDiagnosticMessageFact2(
                "function_signature_invalid", "node_id", ToString(node_id),
                "missing_fact", "generic_parameter_fact_rows"
            );
        } else {
            var generic_row: Int = 0;
            while generic_row < ArrayLength(generic_rows.names) {
                ArrayPushOwnedString(
                    generic_names, generic_rows.names[generic_row]
                );
                ArrayPushOwnedString(
                    generic_default_type_names,
                    generic_rows.default_type_names[generic_row]
                );
                ArrayPushOwnedString(
                    generic_constraint_type_names,
                    generic_rows.constraint_type_names[generic_row]
                );
                generic_row = generic_row + 1;
            }
        }
        SemanticAstGenericParameterFactRowsDrop(generic_rows);
        if !generic_rows_ok { continue; }
        ArrayPush(function_node_ids, node_id);
        ArrayPush(module_paths, module_path);
        ArrayPush(owner_names, UnwrapOption(owner).name);
        ArrayPush(runtime_callables, UnwrapOption(owner).runtime_callable);
        ArrayPush(names, UnwrapOption(name));
        SemanticAstEntrypointSelectionObserve(entrypoint_accumulator, UnwrapOption(owner).name, UnwrapOption(owner).runtime_callable, UnwrapOption(name), ArrayLength(function_node_ids) - 1);
        ArrayPush(return_types, return_type);
        ArrayPush(generic_starts, generic_start);
        ArrayPush(
            generic_counts, ArrayLength(generic_names) - generic_start
        );
        ArrayPush(param_starts, param_start);
        ArrayPush(param_counts, ArrayLength(param_node_ids) - param_start);
        ArrayPush(
            receiver_source_param_offsets, receiver_source_param_offset
        );
        node_id = node_id + 1;
    }

    let type_expressions: SemanticAstSignatureTypeExpressionFacts =
        SemanticAstSignatureTypeExpressionFactsFromRows(
            return_types, param_types
        );
    if ok && !type_expressions.ok {
        ok = false;
        diagnostic_fact = SemanticDiagnosticMessageFact2(
            "function_signature_invalid",
            "owner", "SemanticAstSignatureTypeExpressionFacts",
            "missing_fact", "signature_type_expression"
        );
    }
    let action_contracts: SemanticAstActionContractFacts =
        SemanticAstActionContractFactsFromArtifact(
            artifact, function_node_ids, runtime_callables
        );
    if ok && !SemanticAstActionContractFactsReady(
        artifact, action_contracts
    ) {
        ok = false;
        diagnostic_fact = SemanticDiagnosticMessageFact2(
            "callable_contract_invalid",
            "owner", "SemanticAstActionContractFacts",
            "missing_fact", action_contracts.diagnostic_message
        );
    }
    let entrypoint: SemanticAstEntrypointSelectionFact =
        SemanticAstEntrypointSelectionFinish(entrypoint_accumulator);
    ArrayDropOwnedStrings(generic_default_type_names);
    var canonical_first_rows: HashMap<String, Int> = MapNew(); var canonical_row_counts: HashMap<String, Int> = MapNew();
    SemanticAstSignatureCanonicalNameIndexFill(owner_names, names, canonical_first_rows, canonical_row_counts);
    return SemanticAstFunctionSignatureFacts(
        ok, diagnostic_fact.code,
        SemanticDiagnosticMessageFactRender(diagnostic_fact), diagnostic_fact,
        artifact.count, entrypoint, action_contracts,
        function_node_ids, module_paths, owner_names, runtime_callables,
        names, return_types,
        type_expressions,
        generic_starts, generic_counts, generic_names, generic_constraint_type_names,
        param_starts, param_counts, receiver_source_param_offsets,
        param_node_ids, param_names,
        param_types, param_modes, canonical_first_rows, canonical_row_counts
    );
}
func SemanticAstFunctionSignatureCount(
    ref facts: SemanticAstFunctionSignatureFacts
) -> Int {
    return ArrayLength(facts.function_node_ids);
}
func SemanticAstFunctionSignatureIndexForNode(
    ref facts: SemanticAstFunctionSignatureFacts,
    node_id: Int
) -> Option<Int> {
    let count: Int = SemanticAstFunctionSignatureCount(facts);
    var low: Int = 0;
    var high: Int = count;
    while low < high {
        let middle: Int = low + ((high - low) / 2);
        if facts.function_node_ids[middle] < node_id {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    if low < count && facts.function_node_ids[low] == node_id {
        return Some(low);
    }
    return None;
}
func SemanticAstFunctionNodeAt(facts: SemanticAstFunctionSignatureFacts,
    signature_index: Int
) -> Option<Int> {
    if signature_index < 0 || signature_index >=
        SemanticAstFunctionSignatureCount(facts) { return None; }
    return Some(facts.function_node_ids[signature_index]);
}
func SemanticAstFunctionModulePathAt(ref facts: SemanticAstFunctionSignatureFacts, signature_index: Int) -> Option<String> {
    if signature_index < 0 || signature_index >= SemanticAstFunctionSignatureCount(facts) { return None; }
    return Some(facts.module_paths[signature_index]);
}

func SemanticAstFunctionOwnerNameAt(ref facts: SemanticAstFunctionSignatureFacts,
    signature_index: Int
) -> Option<String> {
    if signature_index < 0 || signature_index >=
        SemanticAstFunctionSignatureCount(facts) { return None; }
    return Some(facts.owner_names[signature_index]);
}

func SemanticAstFunctionRuntimeCallableAt(facts: SemanticAstFunctionSignatureFacts,
    signature_index: Int
) -> Option<Bool> {
    if signature_index < 0 || signature_index >=
        SemanticAstFunctionSignatureCount(facts) { return None; }
    return Some(facts.runtime_callables[signature_index]);
}

func SemanticAstFunctionNameAt(facts: SemanticAstFunctionSignatureFacts,
    signature_index: Int
) -> Option<String> {
    if signature_index < 0 ||
        signature_index >= SemanticAstFunctionSignatureCount(facts) {
        return None;
    }
    return Some(facts.names[signature_index]);
}

func SemanticAstFunctionReturnTypeAt(
    facts: SemanticAstFunctionSignatureFacts,
    signature_index: Int
) -> Option<String> {
    if signature_index < 0 ||
        signature_index >= SemanticAstFunctionSignatureCount(facts) {
        return None;
    }
    return Some(facts.return_types[signature_index]);
}

func SemanticAstFunctionGenericCountAt(
    ref facts: SemanticAstFunctionSignatureFacts,
    signature_index: Int
) -> Option<Int> {
    if signature_index < 0 ||
        signature_index >= SemanticAstFunctionSignatureCount(facts) {
        return None;
    }
    return Some(facts.generic_counts[signature_index]);
}

func SemanticAstFunctionGenericNameAt(
    facts: SemanticAstFunctionSignatureFacts,
    signature_index: Int,
    generic_index: Int
) -> Option<String> {
    if signature_index < 0 ||
        signature_index >= SemanticAstFunctionSignatureCount(facts) ||
        generic_index < 0 ||
        generic_index >= facts.generic_counts[signature_index] {
        return None;
    }
    return Some(facts.generic_names[
        facts.generic_starts[signature_index] + generic_index
    ]);
}

func SemanticAstFunctionParamCountAt(
    ref facts: SemanticAstFunctionSignatureFacts,
    signature_index: Int
) -> Option<Int> {
    if signature_index < 0 ||
        signature_index >= SemanticAstFunctionSignatureCount(facts) {
        return None; }
    return Some(facts.param_counts[signature_index]);
}

func SemanticAstFunctionParamFlatIndex(
    ref facts: SemanticAstFunctionSignatureFacts,
    signature_index: Int,
    parameter_index: Int
) -> Option<Int> {
    if signature_index < 0 ||
        signature_index >= SemanticAstFunctionSignatureCount(facts) ||
        parameter_index < 0 ||
        parameter_index >= facts.param_counts[signature_index] { return None; }
    return Some(facts.param_starts[signature_index] + parameter_index);
}

func SemanticAstFunctionParamNodeAt(
    ref facts: SemanticAstFunctionSignatureFacts,
    signature_index: Int,
    parameter_index: Int
) -> Option<Int> {
    let flat: Option<Int> = SemanticAstFunctionParamFlatIndex(
        facts, signature_index, parameter_index
    );
    if !IsSome(flat) { return None; }
    return Some(facts.param_node_ids[UnwrapOption(flat)]);
}

func SemanticAstFunctionParamNameAt(
    ref facts: SemanticAstFunctionSignatureFacts,
    signature_index: Int,
    parameter_index: Int
) -> Option<String> {
    let flat: Option<Int> = SemanticAstFunctionParamFlatIndex(
        facts, signature_index, parameter_index
    );
    if !IsSome(flat) { return None; }
    return Some(facts.param_names[UnwrapOption(flat)]);
}

func SemanticAstFunctionParamTypeAt(
    ref facts: SemanticAstFunctionSignatureFacts,
    signature_index: Int,
    parameter_index: Int
) -> Option<String> {
    let flat: Option<Int> = SemanticAstFunctionParamFlatIndex(
        facts, signature_index, parameter_index
    );
    if !IsSome(flat) { return None; }
    return Some(facts.param_types[UnwrapOption(flat)]);
}

func SemanticAstFunctionParamModeAt(
    ref facts: SemanticAstFunctionSignatureFacts,
    signature_index: Int,
    parameter_index: Int
) -> Option<Int> {
    let flat: Option<Int> = SemanticAstFunctionParamFlatIndex(
        facts, signature_index, parameter_index
    );
    if !IsSome(flat) { return None; }
    return Some(facts.param_modes[UnwrapOption(flat)]);
}
