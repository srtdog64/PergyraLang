// Function signature facts derived from the shared parser-owned AST artifact.

import "../hir/ast_text_arena_projection_owner.pgy";
import "../hir/ast_node_kind_owner.pgy";
import "diagnostic_owner.pgy";
import "ast_type_name_canonical_owner.pgy";

struct SemanticAstFunctionSignatureFacts {
    ok: Bool;
    diagnostic_code: String;
    diagnostic_message: String;
    artifact_node_count: Int;
    function_node_ids: Array<Int>;
    owner_names: Array<String>;
    runtime_callables: Array<Bool>;
    names: Array<String>;
    return_types: Array<String>;
    param_starts: Array<Int>;
    param_counts: Array<Int>;
    param_node_ids: Array<Int>;
    param_names: Array<String>;
    param_types: Array<String>;
    param_modes: Array<Int>;
}

struct SemanticAstFunctionOwnerFact {
    name: String;
    runtime_callable: Bool;
}

func SemanticAstSignatureError(node_id: Int, fact: String) -> String {
    return SemanticError2(
        "function_signature_invalid",
        "node_id", ToString(node_id),
        "missing_fact", fact
    );
}

func SemanticAstFunctionOwnerFactFromArena(
    arena: AstArena,
    function_node_id: Int
) -> Option<SemanticAstFunctionOwnerFact> {
    let parent: Option<Int> = TypedAstArenaParentId(arena, function_node_id);
    let remaining: Int = TypedAstArenaNodeCount(arena);
    while IsSome(parent) && remaining > 0 {
        let parent_id: Int = UnwrapOption(parent);
        if TypedAstArenaNodeKindIs(
            arena, parent_id, TypedAstKindNominalDeclTag()
        ) || TypedAstArenaNodeKindIs(
            arena, parent_id, TypedAstKindRoleDeclTag()
        ) {
            let name: Option<String> = TypedAstArenaAtomText(arena, parent_id);
            if !IsSome(name) {
                return None;
            }
            return Some(SemanticAstFunctionOwnerFact(
                UnwrapOption(name), true
            ));
        }
        if TypedAstArenaNodeKindIs(
            arena, parent_id, TypedAstKindAbilityDeclTag()
        ) {
            let ability_name: Option<String> = TypedAstArenaAtomText(
                arena, parent_id
            );
            if !IsSome(ability_name) {
                return None;
            }
            return Some(SemanticAstFunctionOwnerFact(
                UnwrapOption(ability_name), false
            ));
        }
        parent = TypedAstArenaParentId(arena, parent_id);
        remaining = remaining - 1;
    }
    if IsSome(parent) {
        return None;
    }
    return Some(SemanticAstFunctionOwnerFact("", true));
}

func SemanticAstFunctionSignatureFactsFromArtifact(
    artifact: AstTreeArtifact
) -> SemanticAstFunctionSignatureFacts {
    let function_node_ids: Array<Int> = [];
    let owner_names: Array<String> = [];
    let runtime_callables: Array<Bool> = [];
    let names: Array<String> = [];
    let return_types: Array<String> = [];
    let param_starts: Array<Int> = [];
    let param_counts: Array<Int> = [];
    let param_node_ids: Array<Int> = [];
    let param_names: Array<String> = [];
    let param_types: Array<String> = [];
    let param_modes: Array<Int> = [];
    let ok: Bool = AstTreeArtifactReady(artifact);
    let diagnostic_code: String = "";
    let diagnostic_message: String = "";
    if !ok {
        diagnostic_code = "ast_artifact_invalid";
        diagnostic_message = SemanticError2(
            "ast_artifact_invalid",
            "node_count", ToString(artifact.count),
            "owner", "AstTreeArtifact"
        );
    }

    let node_id: Int = 0;
    while node_id < artifact.count && ok {
        if !TypedAstArenaNodeKindIs(
            artifact.arena, node_id, TypedAstKindFuncDeclTag()
        ) {
            node_id = node_id + 1;
            continue;
        }
        let name: Option<String> = TypedAstArenaAtomText(artifact.arena, node_id);
        if !IsSome(name) {
            ok = false;
            diagnostic_code = "function_signature_invalid";
            diagnostic_message = SemanticAstSignatureError(node_id, "function_name");
            continue;
        }
        let owner: Option<SemanticAstFunctionOwnerFact> =
            SemanticAstFunctionOwnerFactFromArena(artifact.arena, node_id);
        if !IsSome(owner) {
            ok = false;
            diagnostic_code = "function_signature_invalid";
            diagnostic_message = SemanticAstSignatureError(node_id, "owner_name");
            continue;
        }

        let saw_parameters: Bool = false;
        let saw_returns: Bool = false;
        let return_type: String = "";
        let param_start: Int = ArrayLength(param_node_ids);
        let child_index: Int = 0;
        let child: Option<Int> = TypedAstArenaChildAt(
            artifact.arena, node_id, child_index
        );
        while IsSome(child) && ok {
            let child_id: Int = UnwrapOption(child);
            if TypedAstArenaNodeKindIs(
                artifact.arena, child_id, TypedAstKindParametersTag()
            ) {
                if saw_parameters {
                    ok = false;
                    diagnostic_code = "function_signature_invalid";
                    diagnostic_message = SemanticAstSignatureError(
                        child_id, "duplicate_parameters_row"
                    );
                    continue;
                }
                saw_parameters = true;
                let param_index: Int = 0;
                let param: Option<Int> = TypedAstArenaChildAt(
                    artifact.arena, child_id, param_index
                );
                while IsSome(param) && ok {
                    let param_id: Int = UnwrapOption(param);
                    if !TypedAstArenaNodeKindIs(
                        artifact.arena, param_id, TypedAstKindParamTag()
                    ) {
                        ok = false;
                        diagnostic_code = "function_signature_invalid";
                        diagnostic_message = SemanticAstSignatureError(
                            param_id, "parameter_kind"
                        );
                        continue;
                    }
                    let param_name: Option<String> =
                        TypedAstArenaAtomText(artifact.arena, param_id);
                    if !IsSome(param_name) {
                        ok = false;
                        diagnostic_code = "function_signature_invalid";
                        diagnostic_message = SemanticAstSignatureError(
                            param_id, "parameter_name"
                        );
                        continue;
                    }
                    let param_type: Option<String> =
                        TypedAstArenaTypeName(artifact.arena, param_id);
                    let resolved_param_type: String = "";
                    if IsSome(param_type) {
                        resolved_param_type = SemanticCanonicalTypeName(
                            UnwrapOption(param_type)
                        );
                    } else if UnwrapOption(param_name) == "self" &&
                        StringLength(UnwrapOption(owner).name) > 0 {
                        resolved_param_type = UnwrapOption(owner).name;
                    } else {
                        ok = false;
                        diagnostic_code = "function_signature_invalid";
                        diagnostic_message = SemanticAstSignatureError(
                            param_id, "parameter_type"
                        );
                        continue;
                    }
                    let mode: Option<Int> = TypedAstArenaMode(
                        artifact.arena, param_id
                    );
                    if !IsSome(mode) {
                        ok = false;
                        diagnostic_code = "function_signature_invalid";
                        diagnostic_message = SemanticAstSignatureError(
                            param_id, "parameter_mode"
                        );
                        continue;
                    }
                    ArrayPush(param_node_ids, param_id);
                    ArrayPush(param_names, UnwrapOption(param_name));
                    ArrayPush(param_types, resolved_param_type);
                    ArrayPush(param_modes, UnwrapOption(mode));
                    param_index = param_index + 1;
                    param = TypedAstArenaChildAt(
                        artifact.arena, child_id, param_index
                    );
                }
            } else if TypedAstArenaNodeKindIs(
                artifact.arena, child_id, TypedAstKindReturnsTag()
            ) {
                if saw_returns {
                    ok = false;
                    diagnostic_code = "function_signature_invalid";
                    diagnostic_message = SemanticAstSignatureError(
                        child_id, "duplicate_returns_row"
                    );
                    continue;
                }
                let return_type_fact: Option<String> =
                    TypedAstArenaTypeName(artifact.arena, child_id);
                if !IsSome(return_type_fact) {
                    ok = false;
                    diagnostic_code = "function_signature_invalid";
                    diagnostic_message = SemanticAstSignatureError(
                        child_id, "return_type"
                    );
                    continue;
                }
                saw_returns = true;
                return_type = SemanticCanonicalTypeName(
                    UnwrapOption(return_type_fact)
                );
            }
            child_index = child_index + 1;
            child = TypedAstArenaChildAt(
                artifact.arena, node_id, child_index
            );
        }
        if !ok {
            continue;
        }
        if !saw_parameters {
            ok = false;
            diagnostic_code = "function_signature_invalid";
            diagnostic_message = SemanticAstSignatureError(
                node_id, "parameters_row"
            );
            continue;
        }
        if !saw_returns {
            ok = false;
            diagnostic_code = "function_signature_invalid";
            diagnostic_message = SemanticAstSignatureError(
                node_id, "returns_row"
            );
            continue;
        }
        ArrayPush(function_node_ids, node_id);
        ArrayPush(owner_names, UnwrapOption(owner).name);
        ArrayPush(runtime_callables, UnwrapOption(owner).runtime_callable);
        ArrayPush(names, UnwrapOption(name));
        ArrayPush(return_types, return_type);
        ArrayPush(param_starts, param_start);
        ArrayPush(param_counts, ArrayLength(param_node_ids) - param_start);
        node_id = node_id + 1;
    }

    return SemanticAstFunctionSignatureFacts(
        ok, diagnostic_code, diagnostic_message, artifact.count,
        function_node_ids, owner_names, runtime_callables, names, return_types,
        param_starts, param_counts, param_node_ids, param_names,
        param_types, param_modes
    );
}

func SemanticAstFunctionSignatureCount(
    facts: SemanticAstFunctionSignatureFacts
) -> Int {
    return ArrayLength(facts.function_node_ids);
}

func SemanticAstFunctionSignatureRowMatchesArtifact(
    artifact: AstTreeArtifact,
    facts: SemanticAstFunctionSignatureFacts,
    signature_index: Int
) -> Bool {
    let function_node_id: Int = facts.function_node_ids[signature_index];
    if function_node_id < 0 || function_node_id >= artifact.count ||
        !TypedAstArenaNodeKindIs(
            artifact.arena, function_node_id, TypedAstKindFuncDeclTag()
        ) {
        return false;
    }
    let name: Option<String> = TypedAstArenaAtomText(
        artifact.arena, function_node_id
    );
    let owner: Option<SemanticAstFunctionOwnerFact> = SemanticAstFunctionOwnerFactFromArena(
        artifact.arena, function_node_id
    );
    if !IsSome(name) || !IsSome(owner) ||
        UnwrapOption(name) != facts.names[signature_index] ||
        UnwrapOption(owner).name != facts.owner_names[signature_index] ||
        UnwrapOption(owner).runtime_callable !=
            facts.runtime_callables[signature_index] {
        return false;
    }

    let saw_parameters: Bool = false;
    let saw_returns: Bool = false;
    let parameter_count: Int = 0;
    let child_index: Int = 0;
    let child: Option<Int> = TypedAstArenaChildAt(
        artifact.arena, function_node_id, child_index
    );
    while IsSome(child) {
        let child_id: Int = UnwrapOption(child);
        if TypedAstArenaNodeKindIs(
            artifact.arena, child_id, TypedAstKindParametersTag()
        ) {
            if saw_parameters {
                return false;
            }
            saw_parameters = true;
            let parameter_index: Int = 0;
            let parameter: Option<Int> = TypedAstArenaChildAt(
                artifact.arena, child_id, parameter_index
            );
            while IsSome(parameter) {
                if parameter_count >= facts.param_counts[signature_index] {
                    return false;
                }
                let parameter_id: Int = UnwrapOption(parameter);
                let flat_index: Int =
                    facts.param_starts[signature_index] + parameter_count;
                let parameter_name: Option<String> = TypedAstArenaAtomText(
                    artifact.arena, parameter_id
                );
                let parameter_type: Option<String> = TypedAstArenaTypeName(
                    artifact.arena, parameter_id
                );
                let parameter_mode: Option<Int> = TypedAstArenaMode(
                    artifact.arena, parameter_id
                );
                let resolved_type: String = "";
                if IsSome(parameter_type) {
                    resolved_type = SemanticCanonicalTypeName(
                        UnwrapOption(parameter_type)
                    );
                } else if IsSome(parameter_name) &&
                    UnwrapOption(parameter_name) == "self" &&
                    StringLength(UnwrapOption(owner).name) > 0 {
                    resolved_type = UnwrapOption(owner).name;
                } else {
                    return false;
                }
                if !TypedAstArenaNodeKindIs(
                    artifact.arena, parameter_id, TypedAstKindParamTag()
                ) || !IsSome(parameter_name) || !IsSome(parameter_mode) ||
                    facts.param_node_ids[flat_index] != parameter_id ||
                    facts.param_names[flat_index] != UnwrapOption(parameter_name) ||
                    facts.param_types[flat_index] != resolved_type ||
                    facts.param_modes[flat_index] != UnwrapOption(parameter_mode) {
                    return false;
                }
                parameter_count = parameter_count + 1;
                parameter_index = parameter_index + 1;
                parameter = TypedAstArenaChildAt(
                    artifact.arena, child_id, parameter_index
                );
            }
        } else if TypedAstArenaNodeKindIs(
            artifact.arena, child_id, TypedAstKindReturnsTag()
        ) {
            if saw_returns {
                return false;
            }
            let return_type: Option<String> = TypedAstArenaTypeName(
                artifact.arena, child_id
            );
            if !IsSome(return_type) || SemanticCanonicalTypeName(
                UnwrapOption(return_type)
            ) != facts.return_types[signature_index] {
                return false;
            }
            saw_returns = true;
        }
        child_index = child_index + 1;
        child = TypedAstArenaChildAt(
            artifact.arena, function_node_id, child_index
        );
    }
    return saw_parameters && saw_returns &&
        parameter_count == facts.param_counts[signature_index];
}

func SemanticAstFunctionSignatureFactsMatchArtifact(
    artifact: AstTreeArtifact,
    facts: SemanticAstFunctionSignatureFacts
) -> Bool {
    let n: Int = SemanticAstFunctionSignatureCount(facts);
    let pn: Int = ArrayLength(facts.param_node_ids);
    if !AstTreeArtifactReady(artifact) || !facts.ok ||
        facts.artifact_node_count != artifact.count ||
        ArrayLength(facts.owner_names) != n ||
        ArrayLength(facts.runtime_callables) != n ||
        ArrayLength(facts.names) != n ||
        ArrayLength(facts.return_types) != n ||
        ArrayLength(facts.param_starts) != n ||
        ArrayLength(facts.param_counts) != n ||
        ArrayLength(facts.param_names) != pn ||
        ArrayLength(facts.param_types) != pn ||
        ArrayLength(facts.param_modes) != pn {
        return false;
    }
    let i: Int = 0;
    let next_param_start: Int = 0;
    while i < n {
        if facts.param_starts[i] != next_param_start ||
            facts.param_counts[i] < 0 ||
            facts.param_starts[i] + facts.param_counts[i] > pn ||
            (i > 0 && facts.function_node_ids[i] <= facts.function_node_ids[i - 1]) ||
            !SemanticAstFunctionSignatureRowMatchesArtifact(
                artifact, facts, i
            ) {
            return false;
        }
        next_param_start = next_param_start + facts.param_counts[i];
        i = i + 1;
    }
    if next_param_start != pn {
        return false;
    }
    let function_count: Int = 0;
    let node_id: Int = 0;
    while node_id < artifact.count {
        if TypedAstArenaNodeKindIs(
            artifact.arena, node_id, TypedAstKindFuncDeclTag()
        ) {
            function_count = function_count + 1;
        }
        node_id = node_id + 1;
    }
    return function_count == n;
}

func SemanticAstFunctionSignatureIndexForNode(
    facts: SemanticAstFunctionSignatureFacts,
    node_id: Int
) -> Option<Int> {
    let i: Int = 0;
    while i < SemanticAstFunctionSignatureCount(facts) {
        if facts.function_node_ids[i] == node_id {
            return Some(i);
        }
        i = i + 1;
    }
    return None;
}

func SemanticAstFunctionOwnerNameAt(
    facts: SemanticAstFunctionSignatureFacts,
    signature_index: Int
) -> Option<String> {
    if signature_index < 0 ||
        signature_index >= SemanticAstFunctionSignatureCount(facts) {
        return None;
    }
    return Some(facts.owner_names[signature_index]);
}

func SemanticAstFunctionRuntimeCallableAt(
    facts: SemanticAstFunctionSignatureFacts,
    signature_index: Int
) -> Option<Bool> {
    if signature_index < 0 ||
        signature_index >= SemanticAstFunctionSignatureCount(facts) {
        return None;
    }
    return Some(facts.runtime_callables[signature_index]);
}

func SemanticAstFunctionNameAt(
    facts: SemanticAstFunctionSignatureFacts,
    signature_index: Int
) -> Option<String> {
    if signature_index < 0 ||
        signature_index >= SemanticAstFunctionSignatureCount(facts) {
        return None;
    }
    return Some(facts.names[signature_index]);
}

func SemanticAstFunctionReturnTypeAt(
    facts: SemanticAstFunctionSignatureFacts,
    signature_index: Int
) -> Option<String> {
    if signature_index < 0 ||
        signature_index >= SemanticAstFunctionSignatureCount(facts) {
        return None;
    }
    return Some(facts.return_types[signature_index]);
}

func SemanticAstFunctionParamCountAt(
    facts: SemanticAstFunctionSignatureFacts,
    signature_index: Int
) -> Option<Int> {
    if signature_index < 0 ||
        signature_index >= SemanticAstFunctionSignatureCount(facts) {
        return None;
    }
    return Some(facts.param_counts[signature_index]);
}

func SemanticAstFunctionParamFlatIndex(
    facts: SemanticAstFunctionSignatureFacts,
    signature_index: Int,
    parameter_index: Int
) -> Option<Int> {
    if signature_index < 0 ||
        signature_index >= SemanticAstFunctionSignatureCount(facts) ||
        parameter_index < 0 ||
        parameter_index >= facts.param_counts[signature_index] {
        return None;
    }
    return Some(facts.param_starts[signature_index] + parameter_index);
}

func SemanticAstFunctionParamNodeAt(
    facts: SemanticAstFunctionSignatureFacts,
    signature_index: Int,
    parameter_index: Int
) -> Option<Int> {
    let flat: Option<Int> = SemanticAstFunctionParamFlatIndex(
        facts, signature_index, parameter_index
    );
    if !IsSome(flat) {
        return None;
    }
    return Some(facts.param_node_ids[UnwrapOption(flat)]);
}

func SemanticAstFunctionParamNameAt(
    facts: SemanticAstFunctionSignatureFacts,
    signature_index: Int,
    parameter_index: Int
) -> Option<String> {
    let flat: Option<Int> = SemanticAstFunctionParamFlatIndex(
        facts, signature_index, parameter_index
    );
    if !IsSome(flat) {
        return None;
    }
    return Some(facts.param_names[UnwrapOption(flat)]);
}

func SemanticAstFunctionParamTypeAt(
    facts: SemanticAstFunctionSignatureFacts,
    signature_index: Int,
    parameter_index: Int
) -> Option<String> {
    let flat: Option<Int> = SemanticAstFunctionParamFlatIndex(
        facts, signature_index, parameter_index
    );
    if !IsSome(flat) {
        return None;
    }
    return Some(facts.param_types[UnwrapOption(flat)]);
}

func SemanticAstFunctionParamModeAt(
    facts: SemanticAstFunctionSignatureFacts,
    signature_index: Int,
    parameter_index: Int
) -> Option<Int> {
    let flat: Option<Int> = SemanticAstFunctionParamFlatIndex(
        facts, signature_index, parameter_index
    );
    if !IsSome(flat) {
        return None;
    }
    return Some(facts.param_modes[UnwrapOption(flat)]);
}

func SemanticAstFunctionSignatureFactsContractReady() -> Bool {
    let artifact: AstTreeArtifact = AstTreeArtifactFromText(
        "Program:\n  Class: Box\n    Fields:\n    Methods:\n      Function: Get\n        Parameters:\n          self\n          index: Int\n        Returns: String\n        Body:\n          Block:\n  Function: Main\n    Parameters:\n    Returns: Void\n    Body:\n      Block:\n"
    );
    let facts: SemanticAstFunctionSignatureFacts =
        SemanticAstFunctionSignatureFactsFromArtifact(artifact);
    if !SemanticAstFunctionSignatureFactsMatchArtifact(artifact, facts) ||
        SemanticAstFunctionSignatureCount(facts) != 2 {
        return false;
    }
    let first_param: Option<Int> = SemanticAstFunctionParamFlatIndex(facts, 0, 0);
    let second_param: Option<Int> = SemanticAstFunctionParamFlatIndex(facts, 0, 1);
    let valid_rows: Bool = facts.owner_names[0] == "Box" &&
        facts.runtime_callables[0] &&
        facts.names[0] == "Get" &&
        facts.return_types[0] == "String" && facts.param_counts[0] == 2 &&
        IsSome(first_param) && facts.param_names[UnwrapOption(first_param)] == "self" &&
        facts.param_types[UnwrapOption(first_param)] == "Box" &&
        IsSome(second_param) && facts.param_names[UnwrapOption(second_param)] == "index" &&
        facts.param_types[UnwrapOption(second_param)] == "Int" &&
        facts.owner_names[1] == "" && facts.runtime_callables[1] &&
        facts.names[1] == "Main" &&
        facts.return_types[1] == "Void";
    if !valid_rows {
        return false;
    }
    let stale: AstTreeArtifact = AstTreeArtifactFromText(
        "Program:\n  Class: Box\n    Fields:\n    Methods:\n      Function: Set\n        Parameters:\n          self\n          index: Int\n        Returns: String\n        Body:\n          Block:\n  Function: Main\n    Parameters:\n    Returns: Void\n    Body:\n      Block:\n"
    );
    if SemanticAstFunctionSignatureFactsMatchArtifact(stale, facts) {
        return false;
    }
    let duplicate: AstTreeArtifact = AstTreeArtifactFromText(
        "Program:\n  Function: Main\n    Parameters:\n    Parameters:\n    Returns: Void\n    Body:\n      Block:\n"
    );
    let duplicate_facts: SemanticAstFunctionSignatureFacts =
        SemanticAstFunctionSignatureFactsFromArtifact(duplicate);
    if duplicate_facts.ok ||
        duplicate_facts.diagnostic_code != "function_signature_invalid" {
        return false;
    }
    let ability_artifact: AstTreeArtifact = AstTreeArtifactFromText(
        "Program:\n  Ability: Arithmetic\n    Function: Add\n      Parameters:\n        self\n      Returns: Int\n"
    );
    let ability_facts: SemanticAstFunctionSignatureFacts =
        SemanticAstFunctionSignatureFactsFromArtifact(ability_artifact);
    return ability_facts.ok &&
        ArrayLength(ability_facts.owner_names) == 1 &&
        ability_facts.owner_names[0] == "Arithmetic" &&
        !ability_facts.runtime_callables[0];
}
