// Structured parameter and return type expressions captured with signatures.

import "delimited_range_fact_owner.pgy";
import "expression_normalization_owner.pgy";
import "ast_callable_type_shape_owner.pgy";

struct SemanticAstSignatureTypeExpressionFacts {
    ok: Bool;
    return_roots: Array<Int>;
    parameter_roots: Array<Int>;
    node_names: Array<String>;
    child_starts: Array<Int>;
    child_counts: Array<Int>;
    children: Array<Int>;
}

func SemanticAstSignatureTypeExpressionAppend(
    type_name: String,
    inout node_names: Array<String>,
    inout child_starts: Array<Int>,
    inout child_counts: Array<Int>,
    inout children: Array<Int>
) -> Option<Int> {
    let text: String = SemanticTrimSourceReuse(type_name);
    let n: Int = StringLength(text);
    if n == 0 {
        return None;
    }
    let function_close: Option<Int> =
        SemanticAstSignatureFunctionTypeClose(text);
    if IsSome(function_close) {
        let close: Int = UnwrapOption(function_close);
        let arrow: Int = close + 1;
        while arrow < n && SourceByteIsWhitespace(
            SourceByteAt(text, n, n, arrow)
        ) {
            arrow = arrow + 1;
        }
        if arrow + 2 > n || CharAt(text, arrow) != "-" ||
            CharAt(text, arrow + 1) != ">" {
            return None;
        }
        let return_text: String = SemanticTrimSourceRangeReuse(
            text, arrow + 2, n
        );
        if return_text == "" {
            return None;
        }
        let child_nodes: Array<Int> = [];
        let parameter_text: String = Substring(text, 5, close - 5);
        if SemanticTrimSourceReuse(parameter_text) != "" {
            let parameter_ranges: SemanticDelimitedRangeFacts =
                SemanticNestedCommaRangeFactsFromSource(parameter_text);
            let parameter_index: Int = 0;
            while parameter_index <
                SemanticDelimitedRangeCount(parameter_ranges) {
                let parameter: Option<Int> =
                    SemanticAstSignatureTypeExpressionAppend(
                        SemanticDelimitedRangeText(
                            parameter_ranges, parameter_text, parameter_index
                        ),
                        node_names, child_starts, child_counts, children
                    );
                if !IsSome(parameter) {
                    return None;
                }
                ArrayPush(child_nodes, UnwrapOption(parameter));
                parameter_index = parameter_index + 1;
            }
        }
        let return_node: Option<Int> =
            SemanticAstSignatureTypeExpressionAppend(
                return_text, node_names, child_starts, child_counts, children
            );
        if !IsSome(return_node) {
            return None;
        }
        ArrayPush(child_nodes, UnwrapOption(return_node));
        let function_root: Int = ArrayLength(node_names);
        let function_child_start: Int = ArrayLength(children);
        let child_index: Int = 0;
        while child_index < ArrayLength(child_nodes) {
            ArrayPush(children, child_nodes[child_index]);
            child_index = child_index + 1;
        }
        ArrayPushOwnedString(node_names, "func");
        ArrayPush(child_starts, function_child_start);
        ArrayPush(child_counts, ArrayLength(child_nodes));
        return Some(function_root);
    }
    let open: Int = StringIndexOf(text, "<");
    if open < 0 {
        if StringIndexOf(text, ">") >= 0 {
            return None;
        }
        let leaf: Int = ArrayLength(node_names);
        ArrayPushOwnedString(node_names, text);
        ArrayPush(child_starts, ArrayLength(children));
        ArrayPush(child_counts, 0);
        return Some(leaf);
    }
    if open == 0 || n < open + 3 || CharAt(text, n - 1) != ">" {
        return None;
    }
    let base: String = SemanticTrimSourceRangeReuse(text, 0, open);
    if StringLength(base) == 0 || StringIndexOf(base, ">") >= 0 {
        return None;
    }
    let inner: String = Substring(text, open + 1, n - open - 2);
    let ranges: SemanticDelimitedRangeFacts =
        SemanticNestedCommaRangeFactsFromSource(inner);
    if SemanticDelimitedRangeCount(ranges) == 0 {
        return None;
    }
    let child_nodes: Array<Int> = [];
    let i: Int = 0;
    while i < SemanticDelimitedRangeCount(ranges) {
        let child: Option<Int> = SemanticAstSignatureTypeExpressionAppend(
            SemanticDelimitedRangeText(ranges, inner, i),
            node_names, child_starts, child_counts, children
        );
        if !IsSome(child) {
            return None;
        }
        ArrayPush(child_nodes, UnwrapOption(child));
        i = i + 1;
    }
    let root: Int = ArrayLength(node_names);
    let child_start: Int = ArrayLength(children);
    i = 0;
    while i < ArrayLength(child_nodes) {
        ArrayPush(children, child_nodes[i]);
        i = i + 1;
    }
    ArrayPushOwnedString(node_names, base);
    ArrayPush(child_starts, child_start);
    ArrayPush(child_counts, ArrayLength(child_nodes));
    return Some(root);
}

func SemanticAstSignatureTypeExpressionFactsFromRows(
    ref return_types: Array<String>,
    ref parameter_types: Array<String>
) -> SemanticAstSignatureTypeExpressionFacts {
    let return_roots: Array<Int> = [];
    let parameter_roots: Array<Int> = [];
    let node_names: Array<String> = [];
    let child_starts: Array<Int> = [];
    let child_counts: Array<Int> = [];
    let children: Array<Int> = [];
    let ok: Bool = true;
    let i: Int = 0;
    while i < ArrayLength(return_types) && ok {
        let return_type: String = Concat("", return_types[i]);
        let root: Option<Int> = SemanticAstSignatureTypeExpressionAppend(
            return_type, node_names, child_starts, child_counts, children
        );
        if !IsSome(root) {
            ok = false;
        } else {
            ArrayPush(return_roots, UnwrapOption(root));
        }
        i = i + 1;
    }
    i = 0;
    while i < ArrayLength(parameter_types) && ok {
        let parameter_type: String = Concat("", parameter_types[i]);
        let parameter_root: Option<Int> =
            SemanticAstSignatureTypeExpressionAppend(
                parameter_type, node_names, child_starts, child_counts,
                children
            );
        if !IsSome(parameter_root) {
            ok = false;
        } else {
            ArrayPush(parameter_roots, UnwrapOption(parameter_root));
        }
        i = i + 1;
    }
    return SemanticAstSignatureTypeExpressionFacts(
        ok, return_roots, parameter_roots,
        node_names, child_starts, child_counts, children
    );
}

func SemanticAstSignatureTypeExpressionFormalIndex(
    ref facts: SemanticAstSignatureTypeExpressionFacts,
    type_row: Int,
    generic_start: Int,
    generic_count: Int,
    generic_names: Slice<String>
) -> Option<Int> {
    if type_row < 0 || type_row >= ArrayLength(facts.node_names) {
        return None;
    }
    let i: Int = 0;
    while i < generic_count {
        let generic_name: String = Concat(
            "", generic_names[generic_start + i]
        );
        if generic_name == facts.node_names[type_row] {
            return Some(i);
        }
        i = i + 1;
    }
    return None;
}

func SemanticAstSignatureTypeBindingRowAt(
    bindings: String,
    binding_count: Int,
    binding_index: Int
) -> Option<String> {
    if binding_count < 0 || binding_index < 0 ||
        binding_index >= binding_count {
        return None;
    }
    let text_length: Int = StringLength(bindings);
    let cursor: Int = 0;
    let ordinal: Int = 0;
    let selected_start: Int = 0 - 1;
    let selected_length: Int = 0;
    while ordinal < binding_count {
        let colon: Int = cursor;
        while colon < text_length && CharAt(bindings, colon) != ":" {
            colon = colon + 1;
        }
        if colon == cursor || colon >= text_length { return None; }
        let length_text: String = Substring(bindings, cursor, colon - cursor);
        let value_length: Int = ToInt(length_text);
        if value_length < 0 || ToString(value_length) != length_text ||
            value_length > text_length - colon - 1 {
            return None;
        }
        let value_start: Int = colon + 1;
        if ordinal == binding_index {
            selected_start = value_start;
            selected_length = value_length;
        }
        cursor = value_start + value_length;
        ordinal = ordinal + 1;
    }
    if cursor != text_length || selected_start < 0 { return None; }
    return Some(Substring(bindings, selected_start, selected_length));
}

func SemanticAstSignatureTypeBindingRowAppend(
    binding_row: String,
    binding: String
) -> String {
    return Concat(
        binding_row,
        Concat(ToString(StringLength(binding)), Concat(":", binding))
    );
}

func SemanticAstSignatureTypeBindingRowFrom(
    bindings: Slice<String>
) -> String {
    let binding_row: String = "";
    let binding_index: Int = 0;
    while binding_index < ArrayLength(bindings) {
        let binding: String = Concat("", bindings[binding_index]);
        binding_row = SemanticAstSignatureTypeBindingRowAppend(
            binding_row, binding
        );
        binding_index = binding_index + 1;
    }
    return binding_row;
}

func SemanticAstSignatureTypeBindingRowFromRange(
    values: Slice<String>,
    start: Int,
    count: Int
) -> Option<String> {
    if start < 0 || count < 0 || start + count > ArrayLength(values) {
        return None;
    }
    let binding_row: String = "";
    let ordinal: Int = 0;
    while ordinal < count {
        let value: String = Concat("", values[start + ordinal]);
        if value == "" { return None; }
        binding_row = SemanticAstSignatureTypeBindingRowAppend(
            binding_row, value
        );
        ordinal = ordinal + 1;
    }
    return Some(binding_row);
}

func SemanticAstSignatureTypeBindingRowReady(
    binding_row: String,
    binding_count: Int
) -> Bool {
    if binding_count < 0 { return false; }
    if binding_count == 0 { return binding_row == ""; }
    let ordinal: Int = 0;
    while ordinal < binding_count {
        let binding: Option<String> = SemanticAstSignatureTypeBindingRowAt(
            binding_row, binding_count, ordinal
        );
        if !IsSome(binding) || UnwrapOption(binding) == "" { return false; }
        ordinal = ordinal + 1;
    }
    return true;
}

func SemanticAstSignatureTypeExpressionFormalIndexInRow(
    ref facts: SemanticAstSignatureTypeExpressionFacts,
    type_row: Int,
    generic_count: Int,
    generic_name_row: String
) -> Option<Int> {
    if type_row < 0 || type_row >= ArrayLength(facts.node_names) {
        return None;
    }
    let ordinal: Int = 0;
    while ordinal < generic_count {
        let name: Option<String> = SemanticAstSignatureTypeBindingRowAt(
            generic_name_row, generic_count, ordinal
        );
        if !IsSome(name) { return None; }
        if UnwrapOption(name) == facts.node_names[type_row] {
            return Some(ordinal);
        }
        ordinal = ordinal + 1;
    }
    return None;
}

func SemanticAstSignatureTypeExpressionRenderNode(
    ref facts: SemanticAstSignatureTypeExpressionFacts,
    node: Int,
    generic_count: Int,
    generic_name_row: String,
    bindings: String,
    remaining: Int
) -> Option<String> {
    let node_count: Int = ArrayLength(facts.node_names);
    if remaining <= 0 || node < 0 || node >= node_count ||
        ArrayLength(facts.child_starts) != node_count ||
        ArrayLength(facts.child_counts) != node_count {
        return None;
    }
    let operation_kinds: Array<Int> = [0];
    let operation_values: Array<Int> = [node];
    let operation_remaining: Array<Int> = [remaining];
    let rendered: String = "";
    let ok: Bool = true;
    while ok && ArrayLength(operation_kinds) > 0 {
        let operation_index: Int = ArrayLength(operation_kinds) - 1;
        let operation: Int = operation_kinds[operation_index];
        let value: Int = operation_values[operation_index];
        let budget: Int = operation_remaining[operation_index];
        ArrayPop(operation_kinds);
        ArrayPop(operation_values);
        ArrayPop(operation_remaining);
        if operation == 1 {
            rendered = Concat(rendered, ", ");
        } else if operation == 2 {
            rendered = Concat(rendered, ">");
        } else if operation == 3 {
            rendered = Concat(rendered, ") -> ");
        } else if operation != 0 || budget <= 0 || value < 0 ||
            value >= node_count {
            ok = false;
        } else {
            let start: Int = facts.child_starts[value];
            let count: Int = facts.child_counts[value];
            if start < 0 || count < 0 ||
                start + count > ArrayLength(facts.children) {
                ok = false;
            } else if count == 0 {
                let formal: Option<Int> =
                    SemanticAstSignatureTypeExpressionFormalIndexInRow(
                        facts, value, generic_count, generic_name_row
                    );
                if IsSome(formal) {
                    let binding_index: Int = UnwrapOption(formal);
                    let binding: Option<String> =
                        SemanticAstSignatureTypeBindingRowAt(
                            bindings, generic_count, binding_index
                        );
                    if !IsSome(binding) || UnwrapOption(binding) == "" {
                        ok = false;
                    } else {
                        rendered = Concat(rendered, UnwrapOption(binding));
                    }
                } else {
                    rendered = Concat(rendered, facts.node_names[value]);
                }
            } else if facts.node_names[value] == "func" {
                rendered = Concat(rendered, "func(");
                ArrayPush(operation_kinds, 0);
                ArrayPush(operation_values, facts.children[start + count - 1]);
                ArrayPush(operation_remaining, budget - 1);
                ArrayPush(operation_kinds, 3);
                ArrayPush(operation_values, 0);
                ArrayPush(operation_remaining, 0);
                let parameter_index: Int = count - 2;
                while parameter_index >= 0 {
                    ArrayPush(operation_kinds, 0);
                    ArrayPush(
                        operation_values, facts.children[start + parameter_index]
                    );
                    ArrayPush(operation_remaining, budget - 1);
                    if parameter_index > 0 {
                        ArrayPush(operation_kinds, 1);
                        ArrayPush(operation_values, 0);
                        ArrayPush(operation_remaining, 0);
                    }
                    parameter_index = parameter_index - 1;
                }
            } else {
                rendered = Concat(rendered, facts.node_names[value]);
                rendered = Concat(rendered, "<");
                ArrayPush(operation_kinds, 2);
                ArrayPush(operation_values, 0);
                ArrayPush(operation_remaining, 0);
                let child_index: Int = count - 1;
                while child_index >= 0 {
                    ArrayPush(operation_kinds, 0);
                    ArrayPush(
                        operation_values, facts.children[start + child_index]
                    );
                    ArrayPush(operation_remaining, budget - 1);
                    if child_index > 0 {
                        ArrayPush(operation_kinds, 1);
                        ArrayPush(operation_values, 0);
                        ArrayPush(operation_remaining, 0);
                    }
                    child_index = child_index - 1;
                }
            }
        }
    }
    ArrayDrop(operation_kinds);
    ArrayDrop(operation_values);
    ArrayDrop(operation_remaining);
    if !ok {
        return None;
    }
    return Some(rendered);
}

func SemanticAstSignatureTypeExpressionResolveRoot(
    ref facts: SemanticAstSignatureTypeExpressionFacts,
    root: Int,
    generic_start: Int,
    generic_count: Int,
    generic_names: Slice<String>,
    bindings: Slice<String>
) -> Option<String> {
    if ArrayLength(bindings) != generic_count { return None; }
    let generic_name_row: Option<String> =
        SemanticAstSignatureTypeBindingRowFromRange(
            generic_names, generic_start, generic_count
        );
    if !IsSome(generic_name_row) { return None; }
    let binding_row: String =
        SemanticAstSignatureTypeBindingRowFrom(bindings);
    return SemanticAstSignatureTypeExpressionResolveRootWithBindingRows(
        facts, root, generic_count,
        UnwrapOption(generic_name_row), binding_row
    );
}

func SemanticAstSignatureTypeExpressionResolveRootWithBindingRows(
    ref facts: SemanticAstSignatureTypeExpressionFacts,
    root: Int,
    generic_count: Int,
    generic_name_row: String,
    binding_row: String
) -> Option<String> {
    if !facts.ok || root < 0 || root >= ArrayLength(facts.node_names) ||
        generic_count < 0 ||
        !SemanticAstSignatureTypeBindingRowReady(
            generic_name_row, generic_count
        ) ||
        !SemanticAstSignatureTypeBindingRowReady(
            binding_row, generic_count
        ) {
        return None;
    }
    return SemanticAstSignatureTypeExpressionRenderNode(
        facts, root, generic_count,
        generic_name_row, binding_row,
        ArrayLength(facts.node_names) + 1
    );
}

func SemanticAstSignatureReturnTypeResolveAt(
    ref facts: SemanticAstSignatureTypeExpressionFacts,
    signature_index: Int,
    generic_start: Int,
    generic_count: Int,
    generic_names: Slice<String>,
    bindings: Slice<String>
) -> Option<String> {
    if !facts.ok || signature_index < 0 ||
        signature_index >= ArrayLength(facts.return_roots) {
        return None;
    }
    return SemanticAstSignatureTypeExpressionResolveRoot(
        facts, facts.return_roots[signature_index], generic_start,
        generic_count, generic_names, bindings
    );
}

func SemanticAstSignatureTypeExpressionRootHasFormal(
    ref facts: SemanticAstSignatureTypeExpressionFacts,
    root: Int,
    generic_start: Int,
    generic_count: Int,
    generic_names: Slice<String>
) -> Bool {
    if !facts.ok || root < 0 || root >= ArrayLength(facts.node_names) ||
        ArrayLength(facts.child_starts) != ArrayLength(facts.node_names) ||
        ArrayLength(facts.child_counts) != ArrayLength(facts.node_names) {
        return false;
    }
    let pending: Array<Int> = [root];
    let remaining: Int = ArrayLength(facts.node_names) + 1;
    while ArrayLength(pending) > 0 && remaining > 0 {
        let last: Int = ArrayLength(pending) - 1;
        let node: Int = pending[last];
        ArrayPop(pending);
        if node < 0 || node >= ArrayLength(facts.node_names) {
            return false;
        }
        if IsSome(SemanticAstSignatureTypeExpressionFormalIndex(
            facts, node, generic_start, generic_count, generic_names
        )) {
            return true;
        }
        let start: Int = facts.child_starts[node];
        let count: Int = facts.child_counts[node];
        if start < 0 || count < 0 || start + count > ArrayLength(facts.children) {
            return false;
        }
        let i: Int = 0;
        while i < count {
            ArrayPush(pending, facts.children[start + i]);
            i = i + 1;
        }
        remaining = remaining - 1;
    }
    return false;
}

func SemanticAstSignatureReturnTypeHasFormalAt(
    ref facts: SemanticAstSignatureTypeExpressionFacts,
    signature_index: Int,
    generic_start: Int,
    generic_count: Int,
    generic_names: Slice<String>
) -> Bool {
    if signature_index < 0 ||
        signature_index >= ArrayLength(facts.return_roots) {
        return false;
    }
    return SemanticAstSignatureTypeExpressionRootHasFormal(
        facts, facts.return_roots[signature_index], generic_start,
        generic_count, generic_names
    );
}

func SemanticAstSignatureParameterTypeHasFormalAt(
    ref facts: SemanticAstSignatureTypeExpressionFacts,
    parameter_index: Int,
    generic_start: Int,
    generic_count: Int,
    generic_names: Slice<String>
) -> Bool {
    if parameter_index < 0 ||
        parameter_index >= ArrayLength(facts.parameter_roots) {
        return false;
    }
    return SemanticAstSignatureTypeExpressionRootHasFormal(
        facts, facts.parameter_roots[parameter_index], generic_start,
        generic_count, generic_names
    );
}

func SemanticAstSignatureTypeExpressionFactsMatchRows(
    ref facts: SemanticAstSignatureTypeExpressionFacts,
    ref return_types: Array<String>,
    ref parameter_types: Array<String>
) -> Bool {
    if !facts.ok ||
        ArrayLength(facts.return_roots) != ArrayLength(return_types) ||
        ArrayLength(facts.parameter_roots) != ArrayLength(parameter_types) {
        return false;
    }
    let empty_names: Array<String> = [];
    let empty_bindings: Array<String> = [];
    let i: Int = 0;
    while i < ArrayLength(return_types) {
        let rendered: Option<String> = SemanticAstSignatureReturnTypeResolveAt(
            facts, i, 0, 0,
            empty_names.Slice(0, ArrayLength(empty_names)),
            empty_bindings.Slice(0, ArrayLength(empty_bindings))
        );
        if !IsSome(rendered) || UnwrapOption(rendered) != return_types[i] {
            return false;
        }
        i = i + 1;
    }
    i = 0;
    while i < ArrayLength(parameter_types) {
        let rendered_parameter: Option<String> =
            SemanticAstSignatureTypeExpressionResolveRoot(
                facts, facts.parameter_roots[i], 0, 0,
                empty_names.Slice(0, ArrayLength(empty_names)),
                empty_bindings.Slice(0, ArrayLength(empty_bindings))
            );
        if !IsSome(rendered_parameter) ||
            UnwrapOption(rendered_parameter) != parameter_types[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func SemanticAstSignatureTypeExpressionFactContractReady() -> Bool {
    let returns: Array<String> = [];
    let parameters: Array<String> = [];
    ArrayPushOwnedString(returns, "Option<T>");
    ArrayPushOwnedString(parameters, "Array<T>");
    let facts: SemanticAstSignatureTypeExpressionFacts =
        SemanticAstSignatureTypeExpressionFactsFromRows(
            returns, parameters
        );
    ArrayDropOwnedStrings(returns);
    ArrayDropOwnedStrings(parameters);
    let function_returns: Array<String> = [];
    ArrayPushOwnedString(function_returns, "func(Int) -> Int");
    let no_parameters: Array<String> = [];
    let function_facts: SemanticAstSignatureTypeExpressionFacts =
        SemanticAstSignatureTypeExpressionFactsFromRows(
            function_returns, no_parameters
        );
    ArrayDropOwnedStrings(function_returns);
    ArrayDropOwnedStrings(no_parameters);
    let no_names: Array<String> = [];
    let no_bindings: Array<String> = [];
    let resolved_function: Option<String> =
        SemanticAstSignatureReturnTypeResolveAt(
            function_facts, 0, 0, 0,
            no_names.Slice(0, ArrayLength(no_names)),
            no_bindings.Slice(0, ArrayLength(no_bindings))
        );
    let invalid_function_returns: Array<String> = [];
    let invalid_parameters: Array<String> = [];
    ArrayPushOwnedString(invalid_function_returns, "func(Int)");
    let invalid_function_facts: SemanticAstSignatureTypeExpressionFacts =
        SemanticAstSignatureTypeExpressionFactsFromRows(
            invalid_function_returns, invalid_parameters
        );
    ArrayDropOwnedStrings(invalid_function_returns);
    ArrayDropOwnedStrings(invalid_parameters);
    let expected_returns: Array<String> = [];
    let expected_parameters: Array<String> = [];
    ArrayPushOwnedString(expected_returns, "Option<T>");
    ArrayPushOwnedString(expected_parameters, "Array<T>");
    let rows_match: Bool = SemanticAstSignatureTypeExpressionFactsMatchRows(
        facts, expected_returns, expected_parameters
    );
    let ready: Bool = rows_match && function_facts.ok && IsSome(resolved_function) &&
        UnwrapOption(resolved_function) == "func(Int) -> Int" &&
        !invalid_function_facts.ok;
    ArrayDropOwnedStrings(expected_returns);
    ArrayDropOwnedStrings(expected_parameters);
    return ready;
}
