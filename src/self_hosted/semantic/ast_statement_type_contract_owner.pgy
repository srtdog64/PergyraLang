// Executable contracts for statement expression/type facts.

import "ast_statement_type_fact_owner.pgy";
func SemanticAstScalarMatchContractArtifact(
    tree_text: String, pattern: String
) -> AstTreeArtifact {
    let base: AstTreeArtifact = AstTreeArtifactFromText(tree_text);
    let patterns: AstExpressionGraphRows = AstExpressionGraphRows(
        true, [TypedAstKindMatchCaseStmtTag()],
        [AstExpressionLaneAtom()], [0],
        AstExpressionArena([AstExpressionNodeIntegerLiteral()], [pattern], [0], [0])
    );
    return AstTreeArtifact(
        base.tree_text, base.arena, base.count, base.expression_graphs, patterns
    );
}

func SemanticAstStatementTypeFactsForContract(
    artifact: AstTreeArtifact
) -> SemanticAstStatementTypeFacts {
    let signatures: SemanticAstFunctionSignatureFacts =
        SemanticAstFunctionSignatureFactsFromArtifact(artifact);
    let constructors: SemanticAstNominalConstructorFacts =
        SemanticAstNominalConstructorFactsFromArtifact(artifact);
    let locals: SemanticAstLocalBindingFacts =
        SemanticAstLocalBindingFactsFromArtifact(artifact, signatures);
    let expression_surfaces: SemanticAstExpressionSurfaceFacts =
        SemanticAstExpressionSurfaceFactsFromArtifactCompactBridge(artifact);
    let initializers: SemanticAstInitializerTypeFacts =
        SemanticAstInitializerTypeFactsFromArtifact(
            artifact, signatures, constructors, locals, expression_surfaces
        );
    let statements: SemanticAstStatementFacts =
        SemanticAstStatementFactsFromArtifact(artifact, signatures);
    let iterations: SemanticAstIterationTypeFacts =
        SemanticAstIterationTypeFactsFromArtifact(
            artifact, signatures, constructors, locals, initializers,
            statements, expression_surfaces
        );
    return SemanticAstStatementTypeFactsFromArtifact(
        artifact, signatures, constructors, locals, initializers,
        expression_surfaces, iterations, statements
    );
}

func SemanticAstCollectionStatementGraphContractReady() -> Bool {
    let artifact: AstTreeArtifact = AstTreeArtifactFromText(
        "Program:\n  Function: Main\n    Parameters:\n    Returns: Void\n    Body:\n      Block:\n        Let: xs : Array<Int> = []\n        ArrayPush(xs, 1)\n        ArraySet(xs, 0, 2)\n"
    );
    let signatures: SemanticAstFunctionSignatureFacts =
        SemanticAstFunctionSignatureFactsFromArtifact(artifact);
    let constructors: SemanticAstNominalConstructorFacts =
        SemanticAstNominalConstructorFactsFromArtifact(artifact);
    let locals: SemanticAstLocalBindingFacts =
        SemanticAstLocalBindingFactsFromArtifact(artifact, signatures);
    let surfaces: SemanticAstExpressionSurfaceFacts =
        SemanticAstExpressionSurfaceFactsFromArtifactCompactBridge(artifact);
    let initializers: SemanticAstInitializerTypeFacts =
        SemanticAstInitializerTypeFactsFromArtifact(
            artifact, signatures, constructors, locals, surfaces
        );
    let statements: SemanticAstStatementFacts =
        SemanticAstStatementFactsFromArtifact(artifact, signatures);
    let iterations: SemanticAstIterationTypeFacts =
        SemanticAstIterationTypeFactsFromArtifact(
            artifact, signatures, constructors, locals, initializers,
            statements, surfaces
        );
    let valid: SemanticAstStatementTypeFacts =
        SemanticAstStatementTypeFactsFromArtifact(
            artifact, signatures, constructors, locals, initializers,
            surfaces, iterations, statements
        );
    if !valid.ok || !SemanticAstStatementTypesAllVerified(valid) {
        return false;
    }
    let set_node_id: Int = -1;
    let i: Int = 0;
    while i < ArrayLength(statements.node_ids) {
        if statements.kind_tags[i] == TypedAstKindArraySetStmtTag() {
            set_node_id = statements.node_ids[i];
        }
        i = i + 1;
    }
    let index_root: Option<Int> = SemanticAstExpressionGraphRootForNode(
        surfaces, set_node_id, AstExpressionLaneValue()
    );
    if !IsSome(index_root) { return false; }
    let root: Int = UnwrapOption(index_root);
    surfaces.expression_graph.arena.topology.node_kinds[root] =
        AstExpressionNodeLeaf();
    let drifted: SemanticAstStatementTypeFacts =
        SemanticAstStatementTypeFactsFromArtifact(
            artifact, signatures, constructors, locals, initializers,
            surfaces, iterations, statements
        );
    return drifted.ok && !SemanticAstStatementTypesAllVerified(drifted) &&
        SemanticAstStatementFirstDiagnosticCode(drifted) ==
            "call_arg_type_mismatch";
}

func SemanticAstMatchStatementGraphContractReady() -> Bool {
    let artifact: AstTreeArtifact = SemanticAstScalarMatchContractArtifact(
        "Program:\n  Struct: Box\n    Fields:\n      value: Int\n  Function: Main\n    Parameters:\n    Returns: Int\n    Body:\n      Block:\n        Let: box : Box = Box(1)\n        Match: box.value\n          Case: 1\n            Block:\n              Return: 1\n"
        , "1"
    );
    let signatures: SemanticAstFunctionSignatureFacts =
        SemanticAstFunctionSignatureFactsFromArtifact(artifact);
    let constructors: SemanticAstNominalConstructorFacts =
        SemanticAstNominalConstructorFactsFromArtifact(artifact);
    let locals: SemanticAstLocalBindingFacts =
        SemanticAstLocalBindingFactsFromArtifact(artifact, signatures);
    let surfaces: SemanticAstExpressionSurfaceFacts =
        SemanticAstExpressionSurfaceFactsFromArtifactCompactBridge(artifact);
    let initializers: SemanticAstInitializerTypeFacts =
        SemanticAstInitializerTypeFactsFromArtifact(
            artifact, signatures, constructors, locals, surfaces
        );
    let statements: SemanticAstStatementFacts =
        SemanticAstStatementFactsFromArtifact(artifact, signatures);
    let iterations: SemanticAstIterationTypeFacts =
        SemanticAstIterationTypeFactsFromArtifact(
            artifact, signatures, constructors, locals, initializers,
            statements, surfaces
        );
    let valid: SemanticAstStatementTypeFacts =
        SemanticAstStatementTypeFactsFromArtifact(
            artifact, signatures, constructors, locals, initializers,
            surfaces, iterations, statements
        );
    if !valid.ok || !SemanticAstStatementTypesAllVerified(valid) {
        return false;
    }
    let match_node_id: Int = -1;
    let i: Int = 0;
    while i < ArrayLength(statements.node_ids) {
        if statements.kind_tags[i] == TypedAstKindMatchStmtTag() {
            match_node_id = statements.node_ids[i];
        }
        i = i + 1;
    }
    let match_root: Option<Int> = SemanticAstExpressionGraphRootForNode(
        surfaces, match_node_id, AstExpressionLaneAtom()
    );
    if !IsSome(match_root) { return false; }
    let member_name_node: Option<Int> = SemanticExpressionGraphRightChild(
        surfaces.expression_graph, UnwrapOption(match_root)
    );
    if !IsSome(member_name_node) { return false; }
    surfaces.expression_graph.arena.node_texts[
        UnwrapOption(member_name_node)
    ] = "missing";
    let drifted: SemanticAstStatementTypeFacts =
        SemanticAstStatementTypeFactsFromArtifact(
            artifact, signatures, constructors, locals, initializers,
            surfaces, iterations, statements
        );
    return drifted.ok && !SemanticAstStatementTypesAllVerified(drifted) &&
        SemanticAstStatementFirstDiagnosticCode(drifted) ==
            "statement_type_unresolved";
}

func SemanticAstStatementTypeFactsContractReady() -> Bool {
    let valid: AstTreeArtifact = SemanticAstScalarMatchContractArtifact(
        "Program:\n  Function: Main\n    Parameters:\n    Returns: Int\n    Body:\n      Block:\n        Let: x : Int = 1\n        If: x > 0\n          Then:\n            Block:\n              Log(x)\n        Match: x\n          Case: 1\n            Block:\n              Log(x)\n        Return: x\n"
        , "1"
    );
    let facts: SemanticAstStatementTypeFacts =
        SemanticAstStatementTypeFactsForContract(valid);
    if !facts.ok || !SemanticAstStatementTypesAllVerified(facts) ||
        ArrayLength(facts.node_ids) != 6 ||
        facts.expected_type_names[0] != "Bool" ||
        facts.inferred_type_names[2] != "Int" ||
        facts.expected_type_names[5] != "Int" {
        return false;
    }
    let bad_condition: AstTreeArtifact = AstTreeArtifactFromText(
        "Program:\n  Function: Main\n    Parameters:\n    Returns: Void\n    Body:\n      Block:\n        If: 1\n          Then:\n            Block:\n"
    );
    let bad_condition_facts: SemanticAstStatementTypeFacts =
        SemanticAstStatementTypeFactsForContract(bad_condition);
    if SemanticAstStatementTypesAllVerified(bad_condition_facts) ||
        SemanticAstStatementFirstDiagnosticCode(bad_condition_facts) !=
            "condition_not_bool" {
        return false;
    }
    let bad_exit: AstTreeArtifact = AstTreeArtifactFromText(
        "Program:\n  Function: Main\n    Parameters:\n    Returns: Void\n    Body:\n      Block:\n        Exit(\"bad\")\n"
    );
    let bad_exit_facts: SemanticAstStatementTypeFacts =
        SemanticAstStatementTypeFactsForContract(bad_exit);
    return bad_exit_facts.ok &&
        !SemanticAstStatementTypesAllVerified(bad_exit_facts) &&
        bad_exit_facts.expected_type_names[0] == "Int" &&
        bad_exit_facts.inferred_type_names[0] == "String" &&
        SemanticAstStatementFirstDiagnosticCode(bad_exit_facts) ==
            "call_arg_type_mismatch" &&
        SemanticAstCollectionStatementGraphContractReady() &&
        SemanticAstMatchStatementGraphContractReady();
}
