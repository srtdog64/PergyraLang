// Statement expression/type verdicts joined from artifact-owned facts.
import "ast_statement_fact_owner.pgy";
import "ast_signature_artifact_match_owner.pgy";
import "ast_expression_environment_owner.pgy";
import "ast_expression_verdict_owner.pgy";
import "ast_initializer_type_fact_owner.pgy";
import "ast_iteration_type_fact_owner.pgy";
import "ast_enum_fact_owner.pgy";
import "ast_expression_graph_view_owner.pgy";
import "ast_expression_graph_array_literal_owner.pgy";
import "collection_mutation_policy_owner.pgy";
import "ast_match_binding_environment_owner.pgy";
import "ast_bind_statement_type_fact_owner.pgy";
import "ast_expression_function_table_fact_owner.pgy";
struct SemanticAstStatementTypeFacts {
    ok: Bool;
    diagnostic_code: String;
    diagnostic_message: String;
    artifact_node_count: Int;
    node_ids: Array<Int>;
    kind_tags: Array<Int>;
    expected_type_names: Array<String>;
    inferred_type_names: Array<String>;
    verified: Array<Int>;
    diagnostic_codes: Array<String>;
    diagnostic_messages: Array<String>;
}
func SemanticAstStatementTypeStructuralError(
    artifact: AstTreeArtifact,
    fact: String
) -> SemanticAstStatementTypeFacts {
    let empty_ints: Array<Int> = [];
    let empty_strings: Array<String> = [];
    return SemanticAstStatementTypeFacts(
        false, "ast_artifact_invalid",
        SemanticError2(
            "ast_artifact_invalid",
            "node_count", ToString(artifact.count),
            "owner", Concat("SemanticAstStatementTypeFacts:", fact)
        ),
        artifact.count, empty_ints, empty_ints, empty_strings, empty_strings,
        empty_ints, empty_strings, empty_strings
    );
}
func SemanticAstStatementExpectedReturnType(
    signatures: SemanticAstFunctionSignatureFacts,
    function_node_id: Int
) -> String {
    let index_opt: Option<Int> = SemanticAstFunctionSignatureIndexForNode(
        signatures, function_node_id
    );
    if !IsSome(index_opt) {
        return "";
    }
    let return_opt: Option<String> = SemanticAstFunctionReturnTypeAt(
        signatures, UnwrapOption(index_opt)
    );
    if !IsSome(return_opt) {
        return "";
    }
    return UnwrapOption(return_opt);
}
func SemanticAstStatementTypeFactsFromArtifact(
    artifact: AstTreeArtifact,
    signatures: SemanticAstFunctionSignatureFacts,
    constructors: SemanticAstNominalConstructorFacts,
    locals: SemanticAstLocalBindingFacts,
    initializer_types: SemanticAstInitializerTypeFacts,
    expression_surfaces: SemanticAstExpressionSurfaceFacts,
    iteration_types: SemanticAstIterationTypeFacts,
    statements: SemanticAstStatementFacts,
    function_tables: SemanticAstExpressionFunctionTableFacts
) -> SemanticAstStatementTypeFacts {
    if !AstTreeArtifactReady(artifact) {
        return SemanticAstStatementTypeStructuralError(artifact, "artifact");
    }
    if !SemanticAstFunctionSignatureFactsMatchArtifact(
        artifact, signatures
    ) {
        return SemanticAstStatementTypeStructuralError(artifact, "signature");
    }
    if !SemanticAstNominalConstructorFactsMatchArtifact(
        artifact, constructors
    ) {
        return SemanticAstStatementTypeStructuralError(
            artifact, "constructor"
        );
    }
    if !SemanticAstLocalBindingFactsMatchArtifact(
        artifact, signatures, locals
    ) {
        return SemanticAstStatementTypeStructuralError(artifact, "local");
    }
    if !SemanticAstInitializerTypeFactsReadyProjection(
        artifact, locals, initializer_types
    ) {
        return SemanticAstStatementTypeStructuralError(artifact, "initializer");
    }
    if !SemanticAstIterationTypeFactsMatchArtifact(
        artifact, signatures, constructors, locals, initializer_types,
        statements, expression_surfaces, iteration_types
    ) {
        return SemanticAstStatementTypeStructuralError(artifact, "iteration");
    }
    if !SemanticAstStatementFactsMatchArtifact(artifact, signatures, statements) {
        return SemanticAstStatementTypeStructuralError(artifact, "statement");
    }
    if !SemanticAstExpressionSurfaceBorrowReady(artifact, expression_surfaces) { return SemanticAstStatementTypeStructuralError(artifact, "expression_surface"); }
    let enum_facts: SemanticAstEnumFacts =
        SemanticAstEnumFactsFromArtifact(artifact);
    let role_facts: SemanticAstRoleFacts =
        SemanticAstRoleFactsFromArtifact(artifact);
    if !enum_facts.ok {
        return SemanticAstStatementTypeStructuralError(artifact, "enum");
    }
    if !role_facts.ok {
        return SemanticAstStatementTypeStructuralError(artifact, "role");
    }
    if !SemanticAstExpressionFunctionTableFactsReady(function_tables) {
        return SemanticAstStatementTypeStructuralError(
            artifact, "function_table"
        );
    }
    let function_scopes: SemanticAstFunctionScopeFacts =
        SemanticAstFunctionScopeFactsFromArtifact(artifact);
    return SemanticAstStatementTypeFactsFromAdmittedArtifact(
        artifact, signatures, constructors, locals, initializer_types,
        expression_surfaces, iteration_types, statements, enum_facts,
        role_facts, function_scopes, function_tables
    );
}
func SemanticAstStatementTypeFactsFromAdmittedArtifact(
    artifact: AstTreeArtifact,
    signatures: SemanticAstFunctionSignatureFacts,
    constructors: SemanticAstNominalConstructorFacts,
    locals: SemanticAstLocalBindingFacts,
    initializer_types: SemanticAstInitializerTypeFacts,
    expression_surfaces: SemanticAstExpressionSurfaceFacts,
    iteration_types: SemanticAstIterationTypeFacts,
    statements: SemanticAstStatementFacts,
    enum_facts: SemanticAstEnumFacts,
    role_facts: SemanticAstRoleFacts,
    function_scopes: SemanticAstFunctionScopeFacts,
    function_tables: SemanticAstExpressionFunctionTableFacts
) -> SemanticAstStatementTypeFacts {
    let node_ids: Array<Int> = [];
    let kind_tags: Array<Int> = [];
    let expected_types: Array<String> = [];
    let inferred_types: Array<String> = [];
    let verified: Array<Int> = [];
    let diagnostic_codes: Array<String> = [];
    let diagnostic_messages: Array<String> = [];
    let member_root_names: Array<String> = [];
    if !SemanticAstExpressionMemberRootNames(
        constructors, enum_facts, member_root_names
    ) {
        return SemanticAstStatementTypeStructuralError(
            artifact, "member_root_environment"
        );
    }
    let names: Array<String> = [];
    let types: Array<String> = [];
    let modes: Array<String> = [];
    if !SemanticAstExpressionSeedEnumValues(
        enum_facts, names, types, modes
    ) {
        return SemanticAstStatementTypeStructuralError(
            artifact, "enum_environment"
        );
    }
    let enum_environment_count: Int = ArrayLength(names);
    let i: Int = 0;
    while i < SemanticAstStatementCount(statements) {
        while ArrayLength(names) > enum_environment_count { ArrayPop(names); }
        while ArrayLength(types) > enum_environment_count { ArrayPop(types); }
        while ArrayLength(modes) > enum_environment_count { ArrayPop(modes); }
        let environment_fact: String = "";
        if !SemanticAstExpressionSeedOwnerFieldsFromAdmittedConstructors(
            signatures, constructors, statements.function_node_ids[i],
            names, types, modes
        ) { environment_fact = "owner_field_environment"; }
        else if !SemanticAstExpressionSeedParameters(
            signatures, statements.function_node_ids[i], names, types
        ) { environment_fact = "parameter_environment"; }
        else if !SemanticAstExpressionSeedParameterModes(
            signatures, statements.function_node_ids[i], modes
        ) { environment_fact = "parameter_mode_environment"; }
        else if !SemanticAstExpressionSeedVisibleLocals(
            artifact, locals, initializer_types.inferred_type_names,
            statements.function_node_ids[i], statements.node_ids[i],
            names, types
        ) { environment_fact = Concat("local_environment@function=", Concat(ToString(statements.function_node_ids[i]), Concat(":statement=", ToString(statements.node_ids[i])))); }
        else if !SemanticAstExpressionSeedVisibleLocalModes(
            artifact, locals, statements.function_node_ids[i],
            statements.node_ids[i], modes
        ) { environment_fact = "local_mode_environment"; }
        else if !SemanticAstIterationSeedVisibleBindings(
            artifact, statements, iteration_types,
            statements.function_node_ids[i], statements.node_ids[i],
            names, types, modes
        ) { environment_fact = "iteration_environment"; }
        else if !SemanticAstExpressionSeedVisibleMatchBindingsFromAdmittedFacts(
            artifact, statements, expression_surfaces, constructors, enum_facts,
            function_scopes,
            statements.function_node_ids[i], statements.node_ids[i],
            names, types, modes, function_tables
        ) { environment_fact = "match_binding_environment"; }
        else if ArrayLength(names) != ArrayLength(modes) {
            environment_fact = "environment_row_count";
        }
        if environment_fact != "" {
            return SemanticAstStatementTypeStructuralError(
                artifact, environment_fact
            );
        }
        let kind: Int = statements.kind_tags[i];
        let expected: String = "";
        let inferred: String = "Void";
        let row_verified: Int = 1;
        let row_code: String = "";
        let row_message: String = "";
        let checks_expression: Bool = kind != TypedAstKindBareReturnStmtTag() &&
            kind != TypedAstKindMatchCaseStmtTag() &&
            kind != TypedAstKindForStmtTag() &&
            kind != TypedAstKindArrayPopStmtTag() &&
            kind != TypedAstKindArraySetStmtTag() &&
            kind != TypedAstKindArrayPushStmtTag() &&
            kind != TypedAstKindBindStmtTag();
        if checks_expression {
            let expression_verdict: SemanticAstExpressionVerdict =
                SemanticAstExpressionVerdictError(
                    statements.payload_texts[i],
                    SemanticError1(
                        "ast_artifact_invalid", "owner", "expression_graph"
                    )
                );
            if SemanticAstExpressionGraphAtomLaneRequired(
                artifact, statements.node_ids[i]
            ) {
                let graph_root: Option<Int> =
                    SemanticAstExpressionGraphRootForNode(
                        expression_surfaces, statements.node_ids[i],
                        AstExpressionLaneAtom()
                    );
                if !IsSome(graph_root) {
                    return SemanticAstStatementTypeStructuralError(
                        artifact, "expression_graph"
                    );
                }
                expression_verdict = SemanticAstExpressionVerdictFromGraph(
                    statements.payload_texts[i],
                    expression_surfaces.expression_graph,
                    UnwrapOption(graph_root), constructors, signatures,
                    names, types, modes,
                    function_tables.names, function_tables.returns,
                    function_tables.params,
                    member_root_names, statements.function_node_ids[i]
                );
            } else {
                expression_verdict = SemanticAstExpressionVerdictFromPayload(
                    statements.payload_texts[i], names, types, modes,
                    function_tables.names, function_tables.returns,
                    function_tables.params
                );
            }
            inferred = expression_verdict.inferred_type_name;
            if !expression_verdict.ok {
                row_verified = 0;
                row_code = expression_verdict.diagnostic_code;
                row_message = expression_verdict.diagnostic_message;
            } else if inferred == "Unknown" || inferred == "" {
                let enum_type: Option<String> =
                    SemanticAstEnumExpressionType(
                        enum_facts, statements.payload_texts[i]
                    );
                if IsSome(enum_type) {
                    inferred = UnwrapOption(enum_type);
                }
            }
        }
        if row_verified == 1 && kind == TypedAstKindMatchStmtTag() &&
            (inferred == "Unknown" || inferred == "") {
            row_verified = 0;
            row_code = "statement_type_unresolved";
            row_message = SemanticError2(
                "statement_type_unresolved",
                "node_id", ToString(statements.node_ids[i]),
                "payload", statements.payload_texts[i]
            );
        }
        if row_verified == 1 &&
            (kind == TypedAstKindArrayPopStmtTag() ||
             kind == TypedAstKindArraySetStmtTag() ||
             kind == TypedAstKindArrayPushStmtTag()) {
            let mutator_name: String = "ArrayPop";
            if kind == TypedAstKindArraySetStmtTag() {
                mutator_name = "ArraySet";
            } else if kind == TypedAstKindArrayPushStmtTag() {
                mutator_name = "ArrayPush";
            }
            let mutation_error: String = SemanticCollectionMutationError(
                mutator_name, statements.payload_texts[i],
                names, types, modes, false
            );
            if StringLength(mutation_error) > 0 {
                row_verified = 0;
                row_code = "value_param_collection_mutation";
                row_message = mutation_error;
            }
        }
        if row_verified == 1 &&
            (kind == TypedAstKindArrayPopStmtTag() ||
             kind == TypedAstKindArraySetStmtTag() ||
             kind == TypedAstKindArrayPushStmtTag()) {
            let target: String = statements.payload_texts[i];
            let target_type: String = EnvLookup(names, types, target);
            let element_type_opt: Option<String> =
                SemanticArrayElementType(target_type);
            if target == "" || !EnvContainsName(names, target) {
                row_verified = 0;
                row_code = "undefined_symbol";
                row_message = SemanticError1(
                    "undefined_symbol", "name", target
                );
            } else if !IsSome(element_type_opt) {
                row_verified = 0;
                row_code = "statement_type_unresolved";
                row_message = SemanticError2(
                    "statement_type_unresolved",
                    "target", target,
                    "actual", target_type
                );
            } else if kind == TypedAstKindArraySetStmtTag() {
                let index_root: Option<Int> =
                    SemanticAstExpressionGraphRootForNode(
                        expression_surfaces, statements.node_ids[i],
                        AstExpressionLaneValue()
                    );
                if !IsSome(index_root) {
                    return SemanticAstStatementTypeStructuralError(
                        artifact, "array_set_index_graph"
                    );
                }
                let index_verdict: SemanticAstExpressionVerdict =
                    SemanticAstExpressionVerdictFromGraph(
                        statements.value_texts[i],
                        expression_surfaces.expression_graph,
                        UnwrapOption(index_root), constructors, signatures,
                        names, types, modes, function_tables.names,
                        function_tables.returns, function_tables.params,
                        member_root_names, statements.function_node_ids[i]
                    );
                let index_type: String = index_verdict.inferred_type_name;
                if !index_verdict.ok {
                    row_verified = 0;
                    row_code = index_verdict.diagnostic_code;
                    row_message = index_verdict.diagnostic_message;
                } else if index_type != "Int" {
                    row_verified = 0;
                    row_code = "call_arg_type_mismatch";
                    row_message = SemanticError3(
                        "call_arg_type_mismatch",
                        "expression", statements.value_texts[i],
                        "expected", "Int",
                        "actual", index_type
                    );
                }
            }
            if row_verified == 1 &&
                kind != TypedAstKindArrayPopStmtTag() {
                let value_text: String = statements.value_texts[i];
                if kind == TypedAstKindArraySetStmtTag() {
                    value_text = statements.auxiliary_texts[i];
                }
                let value_lane: Int = AstExpressionLaneValue();
                if kind == TypedAstKindArraySetStmtTag() {
                    value_lane = AstExpressionLaneAuxiliary();
                }
                let value_root: Option<Int> =
                    SemanticAstExpressionGraphRootForNode(
                        expression_surfaces, statements.node_ids[i],
                        value_lane
                    );
                if !IsSome(value_root) {
                    return SemanticAstStatementTypeStructuralError(
                        artifact, "collection_value_graph"
                    );
                }
                let value_verdict: SemanticAstExpressionVerdict =
                    SemanticAstExpressionVerdictFromGraph(
                        value_text, expression_surfaces.expression_graph,
                        UnwrapOption(value_root), constructors, signatures,
                        names, types, modes, function_tables.names,
                        function_tables.returns, function_tables.params,
                        member_root_names, statements.function_node_ids[i]
                    );
                inferred = value_verdict.inferred_type_name;
                expected = UnwrapOption(element_type_opt);
                if !value_verdict.ok {
                    row_verified = 0;
                    row_code = value_verdict.diagnostic_code;
                    row_message = value_verdict.diagnostic_message;
                } else if !ExpressionAssignableTo(
                    expected, inferred, value_text
                ) && !SemanticAstPayloadFreeEnumValueAssignableToInt(
                    enum_facts, expected, inferred, value_text
                ) {
                    row_verified = 0;
                    row_code = "call_arg_type_mismatch";
                    row_message = SemanticError3(
                        "call_arg_type_mismatch",
                        "expression", value_text,
                        "expected", expected,
                        "actual", inferred
                    );
                }
            }
        }
        if row_verified == 1 &&
            (kind == TypedAstKindBareReturnStmtTag() ||
             kind == TypedAstKindValueReturnStmtTag()) {
            expected = SemanticAstStatementExpectedReturnType(
                signatures, statements.function_node_ids[i]
            );
            if (inferred == "Unknown" || inferred == "") && expected != "" {
                let return_root: Option<Int> =
                    SemanticAstExpressionGraphRootForNode(
                        expression_surfaces, statements.node_ids[i],
                        AstExpressionLaneAtom()
                    );
                if !IsSome(return_root) {
                    return SemanticAstStatementTypeStructuralError(
                        artifact, "return_expression_graph"
                    );
                }
                if SemanticExpressionGraphArrayLiteralMatchesDeclaredType(
                    expression_surfaces.expression_graph,
                    UnwrapOption(return_root), expected, constructors,
                    names, types, function_tables.names,
                    function_tables.returns
                ) {
                    inferred = expected;
                }
            }
            if expected == "" || inferred == "Unknown" {
                row_verified = 0;
                row_code = "statement_type_unresolved";
                row_message = SemanticError2(
                    "statement_type_unresolved",
                    "node_id", ToString(statements.node_ids[i]),
                    "payload", statements.payload_texts[i]
                );
            } else if !ExpressionAssignableTo(
                expected, inferred, statements.payload_texts[i]
            ) && !SemanticAstPayloadFreeEnumValueAssignableToInt(
                enum_facts, expected, inferred,
                statements.payload_texts[i]
            ) {
                row_verified = 0;
                row_code = "return_type_mismatch";
                row_message = SemanticError2(
                    "return_type_mismatch",
                    "expected", expected,
                    "actual", inferred
                );
            }
        }
        if row_verified == 1 &&
            (kind == TypedAstKindIfStmtTag() ||
             kind == TypedAstKindWhileStmtTag()) {
            expected = "Bool";
            if inferred == "Unknown" {
                row_verified = 0;
                row_code = "statement_type_unresolved";
                row_message = SemanticError2(
                    "statement_type_unresolved",
                    "node_id", ToString(statements.node_ids[i]),
                    "payload", statements.payload_texts[i]
                );
            } else if inferred != "Bool" {
                row_verified = 0;
                row_code = "condition_not_bool";
                row_message = SemanticError2(
                    "condition_not_bool", "expected", "Bool",
                    "actual", inferred
                );
            }
        }
        if row_verified == 1 && kind == TypedAstKindExitStmtTag() {
            expected = "Int";
            if inferred == "Unknown" || inferred == "" {
                row_verified = 0;
                row_code = "statement_type_unresolved";
                row_message = SemanticError2(
                    "statement_type_unresolved",
                    "node_id", ToString(statements.node_ids[i]),
                    "payload", statements.payload_texts[i]
                );
            } else if inferred != expected {
                row_verified = 0;
                row_code = "call_arg_type_mismatch";
                row_message = SemanticError3(
                    "call_arg_type_mismatch",
                    "expression", statements.payload_texts[i],
                    "expected", expected,
                    "actual", inferred
                );
            }
        }
        if row_verified == 1 && kind == TypedAstKindBindStmtTag() {
            let bind_verdict: SemanticAstBindStatementTypeVerdict = SemanticAstBindStatementTypeVerdictFor(
                constructors, role_facts, names, types, statements.payload_texts[i],
                statements.value_texts[i], statements.auxiliary_texts[i]);
            row_verified = bind_verdict.verified;
            row_code = bind_verdict.diagnostic_code;
            row_message = bind_verdict.diagnostic_message;
        }
        ArrayPush(node_ids, statements.node_ids[i]);
        ArrayPush(kind_tags, kind);
        ArrayPush(expected_types, Concat("", expected));
        ArrayPush(inferred_types, Concat("", inferred));
        ArrayPush(verified, row_verified);
        ArrayPush(diagnostic_codes, row_code);
        ArrayPush(diagnostic_messages, row_message);
        i = i + 1;
    }
    SemanticAstExpressionEnvironmentClear(names, types, modes);
    return SemanticAstStatementTypeFacts(
        true, "", "", artifact.count, node_ids, kind_tags,
        expected_types, inferred_types, verified,
        diagnostic_codes, diagnostic_messages);
}
