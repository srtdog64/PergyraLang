// Stable node-handle queries over semantic-owned statement type rows.

import "ast_statement_type_fact_owner.pgy";

func SemanticAstStatementTypeRowsReady(
    ref facts: SemanticAstStatementTypeFacts
) -> Bool {
    let count: Int = ArrayLength(facts.node_ids);
    return facts.ok && ArrayLength(facts.kind_tags) == count &&
        ArrayLength(facts.expected_type_names) == count &&
        ArrayLength(facts.inferred_type_names) == count &&
        ArrayLength(facts.verified) == count &&
        ArrayLength(facts.diagnostic_codes) == count &&
        ArrayLength(facts.diagnostic_messages) == count;
}

func SemanticAstStatementTypeIndexForNode(
    ref facts: SemanticAstStatementTypeFacts,
    node_id: Int
) -> Option<Int> {
    if !SemanticAstStatementTypeRowsReady(facts) { return None; }
    let i: Int = 0;
    while i < ArrayLength(facts.node_ids) {
        if facts.node_ids[i] == node_id { return Some(i); }
        i = i + 1;
    }
    return None;
}

func SemanticAstStatementInferredTypeForNode(
    ref facts: SemanticAstStatementTypeFacts,
    node_id: Int,
    expected_kind: Int
) -> Option<String> {
    let index: Option<Int> = SemanticAstStatementTypeIndexForNode(
        facts, node_id
    );
    if !IsSome(index) { return None; }
    let row: Int = UnwrapOption(index);
    if facts.kind_tags[row] != expected_kind || facts.verified[row] != 1 ||
        facts.inferred_type_names[row] == "" ||
        facts.inferred_type_names[row] == "Unknown" {
        return None;
    }
    return Some(facts.inferred_type_names[row]);
}

func SemanticAstStatementTypeQueryContractReady() -> Bool {
    let facts: SemanticAstStatementTypeFacts = SemanticAstStatementTypeFacts(
        true, "", "", 3,
        [7, 9, 11], [41, 41, 41], ["", "", ""],
        ["String", "Unknown", "Int"], [1, 1, 0],
        ["", "", ""], ["", "", ""]
    );
    let found: Option<String> = SemanticAstStatementInferredTypeForNode(
        facts, 7, 41
    );
    return SemanticAstStatementTypeRowsReady(facts) &&
        IsSome(found) && UnwrapOption(found) == "String" &&
        !IsSome(SemanticAstStatementInferredTypeForNode(facts, 7, 42)) &&
        !IsSome(SemanticAstStatementInferredTypeForNode(facts, 9, 41)) &&
        !IsSome(SemanticAstStatementInferredTypeForNode(facts, 11, 41)) &&
        !IsSome(SemanticAstStatementInferredTypeForNode(facts, 12, 41));
}

func SemanticAstStatementTypesAllVerified(
    ref facts: SemanticAstStatementTypeFacts
) -> Bool {
    if !facts.ok { return false; }
    let i: Int = 0;
    while i < ArrayLength(facts.node_ids) {
        if facts.verified[i] != 1 { return false; }
        i = i + 1;
    }
    return true;
}

func SemanticAstStatementFirstDiagnosticCode(
    facts: SemanticAstStatementTypeFacts
) -> String {
    if !facts.ok { return facts.diagnostic_code; }
    let i: Int = 0;
    while i < ArrayLength(facts.node_ids) {
        if facts.verified[i] != 1 { return facts.diagnostic_codes[i]; }
        i = i + 1;
    }
    return "";
}

func SemanticAstStatementFirstDiagnosticMessage(
    facts: SemanticAstStatementTypeFacts
) -> String {
    if !facts.ok { return facts.diagnostic_message; }
    let i: Int = 0;
    while i < ArrayLength(facts.node_ids) {
        if facts.verified[i] != 1 { return facts.diagnostic_messages[i]; }
        i = i + 1;
    }
    return "";
}

func SemanticAstStatementTypeFactsMatchArtifact(
    artifact: AstTreeArtifact,
    signatures: SemanticAstFunctionSignatureFacts,
    constructors: SemanticAstNominalConstructorFacts,
    locals: SemanticAstLocalBindingFacts,
    initializer_types: SemanticAstInitializerTypeFacts,
    expression_surfaces: SemanticAstExpressionSurfaceFacts,
    iteration_types: SemanticAstIterationTypeFacts,
    statements: SemanticAstStatementFacts,
    facts: SemanticAstStatementTypeFacts
) -> Bool {
    let enum_facts: SemanticAstEnumFacts =
        SemanticAstEnumFactsFromArtifact(artifact);
    let function_tables: SemanticAstExpressionFunctionTableFacts =
        SemanticAstExpressionFunctionTableFactsFromArtifact(
            artifact, signatures, constructors, enum_facts
        );
    let rebuilt: SemanticAstStatementTypeFacts =
        SemanticAstStatementTypeFactsFromArtifact(
            artifact, signatures, constructors, locals, initializer_types,
            expression_surfaces, iteration_types, statements, function_tables
        );
    let n: Int = ArrayLength(facts.node_ids);
    if !facts.ok || !rebuilt.ok ||
        facts.artifact_node_count != artifact.count ||
        ArrayLength(rebuilt.node_ids) != n ||
        ArrayLength(facts.kind_tags) != n ||
        ArrayLength(facts.expected_type_names) != n ||
        ArrayLength(facts.inferred_type_names) != n ||
        ArrayLength(facts.verified) != n ||
        ArrayLength(facts.diagnostic_codes) != n ||
        ArrayLength(facts.diagnostic_messages) != n {
        return false;
    }
    let i: Int = 0;
    while i < n {
        if rebuilt.node_ids[i] != facts.node_ids[i] ||
            rebuilt.kind_tags[i] != facts.kind_tags[i] ||
            rebuilt.expected_type_names[i] != facts.expected_type_names[i] ||
            rebuilt.inferred_type_names[i] != facts.inferred_type_names[i] ||
            rebuilt.verified[i] != facts.verified[i] ||
            rebuilt.diagnostic_codes[i] != facts.diagnostic_codes[i] ||
            rebuilt.diagnostic_messages[i] != facts.diagnostic_messages[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}
