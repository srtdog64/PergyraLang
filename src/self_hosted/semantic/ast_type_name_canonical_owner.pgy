// Canonical semantic type names for parser-owned artifact rows.
//
// The current AST printer preserves generic argument bindings as
// `Name<label: Type>`. Semantic facts own the value type, so labels are
// removed once at capture (`Option<Int: Int>` -> `Option<Int>`).

import "text_scan_owner.pgy";
import "delimited_range_fact_owner.pgy";
import "expression_normalization_owner.pgy";

struct SemanticCanonicalTypeNameFact {
    canonical_name: String,
    nominal_base_name: String
}

struct SemanticConstructedTypeNameFact {
    ok: Bool,
    canonical_name: String,
    nominal_base_name: String,
    actual_type_names: Array<String>
}

func SemanticTypeNameTopLevelColon(text: String) -> Option<Int> {
    let n: Int = StringLength(text);
    let open_angle: Int = SourceByteOf("<");
    let close_angle: Int = SourceByteOf(">");
    let open_paren: Int = SourceByteOf("(");
    let close_paren: Int = SourceByteOf(")");
    let open_bracket: Int = SourceByteOf("[");
    let close_bracket: Int = SourceByteOf("]");
    let colon: Int = SourceByteOf(":");
    let depth: Int = 0;
    let i: Int = 0;
    while i < n {
        let c: Int = SourceByteAt(text, n, i);
        if c == open_angle || c == open_paren || c == open_bracket {
            depth = depth + 1;
        } else if c == close_angle || c == close_paren ||
            c == close_bracket {
            if depth > 0 {
                depth = depth - 1;
            }
        } else if c == colon && depth == 0 {
            return Some(i);
        }
        i = i + 1;
    }
    return None;
}

func SemanticCanonicalTypeArgument(text: String) -> String {
    let argument: String = SemanticTrimSourceReuse(text);
    let colon_opt: Option<Int> = SemanticTypeNameTopLevelColon(argument);
    if IsSome(colon_opt) {
        let colon: Int = UnwrapOption(colon_opt);
        return SemanticCanonicalTypeName(
            SemanticTrimSourceRangeReuse(
                argument, colon + 1, StringLength(argument)
            )
        );
    }
    return SemanticCanonicalTypeName(argument);
}

func SemanticCanonicalTypeName(type_name: String) -> String {
    let text: String = SemanticTrimSourceReuse(type_name);
    let n: Int = StringLength(text);
    let open: Int = StringIndexOf(text, "<");
    if open <= 0 || n < open + 2 ||
        SourceByteAt(text, n, n - 1) != SourceByteOf(">") {
        return text;
    }
    let base: String = SemanticTrimSourceRangeReuse(text, 0, open);
    let inner: String = Substring(
        text, open + 1, n - open - 2
    );
    let arguments: SemanticDelimitedRangeFacts =
        SemanticNestedCommaRangeFactsFromSource(inner);
    let result: String = Concat(base, "<");
    let i: Int = 0;
    while i < SemanticDelimitedRangeCount(arguments) {
        if i > 0 {
            result = Concat(result, ", ");
        }
        result = Concat(
            result,
            SemanticCanonicalTypeArgument(
                SemanticDelimitedRangeText(arguments, inner, i)
            )
        );
        i = i + 1;
    }
    return Concat(result, ">");
}

func SemanticCanonicalTypeNameFactFrom(
    type_name: String
) -> SemanticCanonicalTypeNameFact {
    let canonical: String = SemanticCanonicalTypeName(type_name);
    let open: Int = StringIndexOf(canonical, "<");
    let nominal_base: String = canonical;
    if open >= 0 {
        nominal_base = SemanticTrimSourceRangeReuse(canonical, 0, open);
    }
    return SemanticCanonicalTypeNameFact(canonical, nominal_base);
}

func SemanticConstructedTypeNameFactFrom(
    type_name: String
) -> SemanticConstructedTypeNameFact {
    let actuals: Array<String> = [];
    let canonical: String = SemanticCanonicalTypeName(type_name);
    let n: Int = StringLength(canonical);
    let open: Int = StringIndexOf(canonical, "<");
    if open <= 0 || n < open + 3 ||
        SourceByteAt(canonical, n, n - 1) != SourceByteOf(">") {
        return SemanticConstructedTypeNameFact(
            false, canonical, "", actuals
        );
    }
    let base: String = SemanticTrimSourceRangeReuse(canonical, 0, open);
    let inner: String = Substring(canonical, open + 1, n - open - 2);
    let ranges: SemanticDelimitedRangeFacts =
        SemanticNestedCommaRangeFactsFromSource(inner);
    let count: Int = SemanticDelimitedRangeCount(ranges);
    if base == "" || count == 0 {
        return SemanticConstructedTypeNameFact(
            false, canonical, base, actuals
        );
    }
    let i: Int = 0;
    while i < count {
        let actual: String = SemanticCanonicalTypeName(
            SemanticDelimitedRangeText(ranges, inner, i)
        );
        if actual == "" {
            return SemanticConstructedTypeNameFact(
                false, canonical, base, actuals
            );
        }
        ArrayPush(actuals, actual);
        i = i + 1;
    }
    return SemanticConstructedTypeNameFact(
        true, canonical, base, actuals
    );
}

func SemanticTypeNameContainsUnresolvedUnknown(type_name: String) -> Bool {
    let canonical: String = SemanticCanonicalTypeName(type_name);
    if canonical == "Unknown" || canonical == "" { return true; }
    let shape: SemanticConstructedTypeNameFact =
        SemanticConstructedTypeNameFactFrom(canonical);
    if !shape.ok { return false; }
    let i: Int = 0;
    while i < ArrayLength(shape.actual_type_names) {
        if SemanticTypeNameContainsUnresolvedUnknown(
            shape.actual_type_names[i]
        ) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func SemanticAstTypeNameCanonicalContractReady() -> Bool {
    let box: SemanticCanonicalTypeNameFact =
        SemanticCanonicalTypeNameFactFrom("Box<T: Int>");
    let nested: SemanticConstructedTypeNameFact =
        SemanticConstructedTypeNameFactFrom(
            "List<HashMap<String, Int>>"
        );
    return box.canonical_name == "Box<Int>" &&
        box.nominal_base_name == "Box" &&
        nested.ok && nested.nominal_base_name == "List" &&
        ArrayLength(nested.actual_type_names) == 1 &&
        nested.actual_type_names[0] == "HashMap<String, Int>" &&
        !SemanticConstructedTypeNameFactFrom("List<>").ok &&
        !SemanticConstructedTypeNameFactFrom("String").ok &&
        !SemanticTypeNameContainsUnresolvedUnknown(
            "List<HashMap<String, Int>>"
        ) && SemanticTypeNameContainsUnresolvedUnknown(
            "List<HashMap<String, Unknown>>"
        ) &&
        SemanticCanonicalTypeName("Option<Int: Int>") == "Option<Int>" &&
        SemanticCanonicalTypeName("Array<Int: Int>") == "Array<Int>" &&
        SemanticCanonicalTypeName(
            "HashMap<K: String, V: Option<Int: Int>>"
        ) == "HashMap<String, Option<Int>>" &&
        SemanticCanonicalTypeName(
            "Result<T: HashMap<String, Int>, E: Option<String>>"
        ) == "Result<HashMap<String, Int>, Option<String>>" &&
        SemanticCanonicalTypeName("String") == "String";
}
