// Zone resources carry identity-bearing state. Semantic admission records
// every fresh local's exact resource paths and every mutable resource borrow;
// named copies, reassignment, and unowned parameter carriage fail closed.

import "ast_nominal_constructor_fact_owner.pgy";
import "ast_local_binding_fact_owner.pgy";
import "ast_initializer_type_fact_owner.pgy";
import "ast_assignment_fact_owner.pgy";
import "ast_assignment_type_fact_owner.pgy";
import "ast_expression_surface_fact_owner.pgy";
import "ast_zone_resource_shape_owner.pgy";
import "diagnostic_owner.pgy";

struct SemanticAstZoneValueCarriageVerdict {
    ok: Bool;
    diagnostic_code: String;
    diagnostic_message: String;
    syntax_node_id: Int;
    fresh_local_node_ids: Array<Int>;
    resource_path_starts: Array<Int>;
    resource_path_counts: Array<Int>;
    resource_field_paths: Array<String>;
    mutable_borrow_parameter_node_ids: Array<Int>;
}

func SemanticAstZoneValueCarriageVerdictOk(
    fresh_local_node_ids: Array<Int>,
    resource_path_starts: Array<Int>,
    resource_path_counts: Array<Int>,
    resource_field_paths: Array<String>,
    mutable_borrow_parameter_node_ids: Array<Int>
) -> SemanticAstZoneValueCarriageVerdict {
    return SemanticAstZoneValueCarriageVerdict(
        true, "", "", -1, fresh_local_node_ids,
        resource_path_starts, resource_path_counts, resource_field_paths,
        mutable_borrow_parameter_node_ids
    );
}

func SemanticAstZoneValueCarriageVerdictError(
    code: String,
    message: String,
    syntax_node_id: Int
) -> SemanticAstZoneValueCarriageVerdict {
    let empty_node_ids: Array<Int> = [];
    let empty_starts: Array<Int> = [];
    let empty_counts: Array<Int> = [];
    let empty_paths: Array<String> = [];
    let empty_parameter_ids: Array<Int> = [];
    return SemanticAstZoneValueCarriageVerdict(
        false, code, message, syntax_node_id, empty_node_ids,
        empty_starts, empty_counts, empty_paths, empty_parameter_ids
    );
}

func SemanticAstZoneValueCarriageFactsReady(
    artifact: AstTreeArtifact,
    ref constructors: SemanticAstNominalConstructorFacts,
    locals: SemanticAstLocalBindingFacts,
    initializer_types: SemanticAstInitializerTypeFacts,
    assignments: SemanticAstAssignmentFacts,
    ref assignment_types: SemanticAstAssignmentTypeFacts,
    ref expression_surfaces: SemanticAstExpressionSurfaceFacts
) -> Bool {
    let assignment_count: Int = SemanticAstAssignmentCount(assignments);
    return constructors.ok &&
        constructors.artifact_node_count == artifact.count &&
        SemanticAstNominalConstructorRowsReady(constructors) &&
        locals.ok && locals.artifact_node_count == artifact.count &&
        SemanticAstInitializerTypeFactsReadyProjection(
            artifact, locals, initializer_types
        ) &&
        assignments.ok && assignments.artifact_node_count == artifact.count &&
        assignment_types.ok &&
        assignment_types.artifact_node_count == artifact.count &&
        ArrayLength(assignment_types.node_ids) == assignment_count &&
        ArrayLength(assignment_types.target_type_names) == assignment_count &&
        ArrayLength(assignment_types.verified) == assignment_count &&
        expression_surfaces.ok &&
        expression_surfaces.artifact_node_count == artifact.count &&
        SemanticExpressionGraphCarriedCallTargetsReady(
            expression_surfaces.expression_graph
        );
}

func SemanticAstZoneValueCarriageVerdictFromAdmittedFacts(
    artifact: AstTreeArtifact,
    ref constructors: SemanticAstNominalConstructorFacts,
    locals: SemanticAstLocalBindingFacts,
    initializer_types: SemanticAstInitializerTypeFacts,
    assignments: SemanticAstAssignmentFacts,
    ref assignment_types: SemanticAstAssignmentTypeFacts,
    ref expression_surfaces: SemanticAstExpressionSurfaceFacts,
    mutable_borrow_parameter_node_ids: Array<Int>
) -> SemanticAstZoneValueCarriageVerdict {
    let fresh_local_node_ids: Array<Int> = [];
    let resource_path_starts: Array<Int> = [];
    let resource_path_counts: Array<Int> = [];
    let resource_field_paths: Array<String> = [];
    if !SemanticAstZoneValueCarriageFactsReady(
        artifact, constructors, locals, initializer_types, assignments,
        assignment_types, expression_surfaces
    ) {
        return SemanticAstZoneValueCarriageVerdictError(
            "ast_artifact_invalid",
            SemanticError1(
                "ast_artifact_invalid", "owner",
                "SemanticAstZoneValueCarriageVerdict"
            ),
            -1
        );
    }
    let local_index: Int = 0;
    while local_index < SemanticAstLocalBindingCount(locals) {
        if initializer_types.verified[local_index] == 1 {
            let type_name: String =
                initializer_types.inferred_type_names[local_index];
            let resource_kind: Int =
                SemanticAstZoneValueCarriageResourceKind(
                    constructors, type_name
                );
            if resource_kind != 0 {
                if !SemanticAstZoneValueCarriageFreshIdentity(
                    expression_surfaces, locals.node_ids[local_index],
                    type_name, resource_kind == 1
                ) {
                    return SemanticAstZoneValueCarriageVerdictError(
                        "zone_value_copy_requires_transfer",
                        SemanticError2(
                            "zone_value_copy_requires_transfer",
                            "type", type_name,
                            "binding", locals.names[local_index]
                        ),
                        locals.node_ids[local_index]
                    );
                }
                ArrayPush(fresh_local_node_ids, locals.node_ids[local_index]);
                ArrayPush(resource_path_starts,
                    ArrayLength(resource_field_paths));
                if resource_kind == 1 {
                    ArrayPush(resource_field_paths, "");
                    ArrayPush(resource_path_counts, 1);
                } else {
                    let constructor_opt: Option<Int> =
                        SemanticAstNominalConstructorIndexForName(
                            constructors, type_name
                        );
                    if !IsSome(constructor_opt) {
                        return SemanticAstZoneValueCarriageVerdictError(
                            "ast_artifact_invalid",
                            SemanticError1(
                                "ast_artifact_invalid", "owner",
                                "SemanticAstZoneResourcePath"
                            ),
                            locals.node_ids[local_index]
                        );
                    }
                    let constructor_index: Int =
                        UnwrapOption(constructor_opt);
                    let path_start: Int =
                        ArrayLength(resource_field_paths);
                    let field_index: Int = 0;
                    while field_index <
                        constructors.param_counts[constructor_index] {
                        let flat_index: Int =
                            constructors.param_starts[constructor_index] +
                            field_index;
                        if constructors.field_kinds[flat_index] ==
                            NominalFieldKindWorldZone() {
                            ArrayPush(
                                resource_field_paths,
                                constructors.field_names[flat_index]
                            );
                        }
                        field_index = field_index + 1;
                    }
                    let path_count: Int =
                        ArrayLength(resource_field_paths) - path_start;
                    if path_count <= 0 {
                        return SemanticAstZoneValueCarriageVerdictError(
                            "ast_artifact_invalid",
                            SemanticError1(
                                "ast_artifact_invalid", "owner",
                                "SemanticAstZoneResourcePath"
                            ),
                            locals.node_ids[local_index]
                        );
                    }
                    ArrayPush(resource_path_counts, path_count);
                }
            }
        }
        local_index = local_index + 1;
    }
    let assignment_index: Int = 0;
    while assignment_index < SemanticAstAssignmentCount(assignments) {
        if assignment_types.verified[assignment_index] == 1 {
            let target_type: String =
                assignment_types.target_type_names[assignment_index];
            if SemanticAstZoneValueCarriageTypeOwnsResource(
                constructors, target_type
            ) {
                return SemanticAstZoneValueCarriageVerdictError(
                    "zone_value_reassignment_requires_transfer",
                    SemanticError2(
                        "zone_value_reassignment_requires_transfer",
                        "type", target_type,
                        "target", assignments.target_texts[assignment_index]
                    ),
                    assignments.node_ids[assignment_index]
                );
            }
        }
        assignment_index = assignment_index + 1;
    }
    return SemanticAstZoneValueCarriageVerdictOk(
        fresh_local_node_ids, resource_path_starts, resource_path_counts,
        resource_field_paths, mutable_borrow_parameter_node_ids
    );
}
