// Whether a family reserves a spelling from top-level functions, and which.
struct SemanticBuiltinNameReservation {
    reserved: Bool;
    family: String;
}

func SemanticBuiltinNameReservationFor(name: String) -> SemanticBuiltinNameReservation {
    if SemanticBuiltinCapabilityRowForName(name).valid {
        return SemanticBuiltinNameReservation(true, "CAPABILITY");
    }
    let rows: Array<String> = SemanticBuiltinNameReservationRows();
    let i: Int = 0;
    while i < ArrayLength(rows) {
        let parts: Array<String> = Split(rows[i], "^");
        if ArrayLength(parts) == 2 && parts[1] == name {
            return SemanticBuiltinNameReservation(true, parts[0]);
        }
        i = i + 1;
    }
    return SemanticBuiltinNameReservation(false, "");
}

func SemanticProgramFunctionClaimsName(
    signatures: SemanticAstFunctionSignatureFacts,
    name: String
) -> Bool {
    let i: Int = 0;
    while i < SemanticAstFunctionSignatureCount(signatures) {
        let owner: Option<String> = SemanticAstFunctionOwnerNameAt(
            signatures, i
        );
        let function_name: Option<String> = SemanticAstFunctionNameAt(
            signatures, i
        );
        if IsSome(owner) && IsSome(function_name) &&
            UnwrapOption(owner) == "" &&
            UnwrapOption(function_name) == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// A reserved spelling keeps its builtin row, so a declaration that reaches
// the table without the admission check below still fails the table.
func SeedSemanticOwnedBuiltinSignaturesUnclaimed(
    signatures: SemanticAstFunctionSignatureFacts,
    inout names: Array<String>,
    inout returns: Array<String>,
    inout params: Array<String>
) -> Bool {
    let rows: Array<String> = SemanticBuiltinSignatureRows();
    let i: Int = 0;
    while i < ArrayLength(rows) {
        let parts: Array<String> = Split(rows[i], "^");
        if ArrayLength(parts) != 3 {
            return false;
        }
        if SemanticBuiltinNameReservationFor(parts[0]).reserved ||
            !SemanticProgramFunctionClaimsName(signatures, parts[0]) {
            let param_types: String = parts[2];
            if param_types == "none" {
                param_types = "";
            }
            ArrayPushOwnedString(names, parts[0]);
            ArrayPushOwnedString(returns, parts[1]);
            ArrayPushOwnedString(params, param_types);
        }
        i = i + 1;
    }
    return true;
}

// Admission: the first top-level function that takes a reserved spelling.
func SemanticAstFunctionSignatureFactsWithBuiltinNames(
    artifact: AstTreeArtifact
) -> SemanticAstFunctionSignatureFacts {
    let signatures: SemanticAstFunctionSignatureFacts =
        SemanticAstFunctionSignatureFactsFromArtifact(artifact);
    let i: Int = 0;
    while signatures.ok && i < SemanticAstFunctionSignatureCount(signatures) {
        let owner: Option<String> = SemanticAstFunctionOwnerNameAt(
            signatures, i
        );
        let name: Option<String> = SemanticAstFunctionNameAt(signatures, i);
        if IsSome(owner) && IsSome(name) && UnwrapOption(owner) == "" {
            let reservation: SemanticBuiltinNameReservation =
                SemanticBuiltinNameReservationFor(UnwrapOption(name));
            if reservation.reserved {
                signatures.ok = false;
                signatures.diagnostic_code = "builtin_name_reserved";
                signatures.diagnostic_message = SemanticError2(
                    "builtin_name_reserved",
                    "function", UnwrapOption(name),
                    "family", reservation.family
                );
            }
        }
        i = i + 1;
    }
    return signatures;
}
