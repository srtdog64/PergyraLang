        "RUNTIME_ABI^SubIndexOf",
        "RUNTIME_ABI^SubIndexOfWithLen",
        "RUNTIME_ABI^SubStartsWith",
        "RUNTIME_ABI^SubStartsWithLen",
        "RUNTIME_ABI^Substring",
        "RUNTIME_ABI^SubstringWithLen",
        "RUNTIME_ABI^Tan",
        "RUNTIME_ABI^ToFloat",
        "RUNTIME_ABI^ToInt",
        "RUNTIME_ABI^ToLower",
        "RUNTIME_ABI^ToUpper",
        "RESOURCE^Channel",
        "RESOURCE^ClaimDeviceSlot",
        "RESOURCE^ClaimSecureSlot",
        "RESOURCE^ClaimSlot",
        "RESOURCE^DeviceRead",
