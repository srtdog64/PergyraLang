// Canonical self-host semantic builtin signature table.

import "../lib/intent_observability_abi_projection_owner.pgy";
import "wrapper_type_owner.pgy";
import "ast_expression_graph_collection_call_protocol_owner.pgy";
import "collection_key_policy_projection_owner.pgy";
import "diagnostic_owner.pgy";

func SemanticBuiltinSignatureRows() -> Array<String> {
    let rows: Array<String> = [
        "StringLength^Int^String",
        "StringIndexOf^Int^String|String",
        "ArrayLength^Int^Unknown",
        "Substring^String^String|Int|Int",
        "SubstringWithLen^String^String|Int|Int|Int",
        "Concat^String^String|String",
        "ReadFile^String^String",
        "ReadStdin^String^Int",
        "WriteFile^Void^String|String",
        "ToInt^Int^Unknown",
        "ToFloat^Float^Unknown",
        "Sqrt^Float^Float",
        "Pow^Float^Float|Float",
        "Floor^Float^Float",
        "Ceil^Float^Float",
        "Sin^Float^Float",
        "Cos^Float^Float",
        "Tan^Float^Float",
        "Asin^Float^Float",
        "Acos^Float^Float",
        "Atan^Float^Float",
        "Atan2^Float^Float|Float",
        "Round^Float^Float",
        "Exp^Float^Float",
        "MathLog^Float^Float",
        "Log10^Float^Float",
        "Log2^Float^Float",
        "Now^Int^none",
        "Cancel^Bool^Unknown",
        "Random^Int^Int",
        "SeedRandom^Void^Int",
        "CheckedAdd^Int^Int|Int",
        "CheckedMul^Int^Int|Int",
        "Abs^Unknown^Unknown",
        "Min^Unknown^Unknown|Unknown",
        "Max^Unknown^Unknown|Unknown",
        "Clamp^Unknown^Unknown|Unknown|Unknown",
        "FileExists^Bool^String",
        "ToString^String^Unknown",
        "ToLower^String^Unknown",
        "ToUpper^String^Unknown",
        "Upper^String^Unknown",
        "StringReplace^String^Unknown|Unknown|Unknown",
        "StringContains^Bool^String|String",
        "SubContainsWithLen^Bool^String|Int|Int|Int|String",
        "SubEqualsWithLen^Bool^String|Int|Int|Int|String",
        "SubIndexOfWithLen^Int^String|Int|Int|Int|String",
        "SubStartsWithLen^Bool^String|Int|Int|String",
        "ArrayPush^Unknown^Unknown|Unknown",
        "ArrayPop^Unknown^Unknown",
        "ArraySet^Unknown^Unknown|Unknown|Unknown",
        "ArrayGet^Unknown^Unknown|Unknown",
        "Args^Array<String>^none",
        "Log^Unknown^Unknown",
        "Print^Unknown^Unknown",
        "Exit^Unknown^Unknown",
        "StringJoin^String^Array<String>|String",
        "Join^String^Array<String>|String",
        "Split^Array<String>^String|String",
        "StringSplit^Array<String>^String|String",
        "DirWalk^Array<String>^String",
        "StringTrim^String^Unknown",
        "CharCode^Int^String|Int|Int",
        "CharAtN^String^String|Int|Int",
        "Some^Unknown^Unknown",
        "None^Option<Unknown>^none",
        "IsSome^Bool^Unknown",
        "UnwrapOption^Unknown^Unknown",
        "Ok^Unknown^Unknown",
        "Err^Unknown^Unknown",
        "IsOk^Bool^Unknown",
        "IsErr^Bool^Unknown",
        "Unwrap^Unknown^Unknown",
        "UnwrapErr^Unknown^Unknown",
        "UnwrapOr^Unknown^Unknown|Unknown",
        "Channel^Channel<Unknown>^Int",
        "SliceCopy^Unknown^Unknown",
        "AllocatorResult^Allocator^none",
        "AllocatorDestroy^Void^Allocator",
        "TextBuilderNew^TextBuilder^Int",
        "TextBuilderAppend^Void^TextBuilder|String",
        "TextBuilderFinish^String^TextBuilder|Allocator",
        "TextBuilderDrop^Void^TextBuilder",
        "FileOpen^Int^String|String",
        "FileRead^String^Int",
        "FileWrite^Void^Int|String",
        "FileClose^Void^Int",
        "ArraySort^Unknown^Unknown",
        "ArrayReverse^Unknown^Unknown",
        "ArrayMap^Unknown^Unknown|Unknown",
        "ArrayFilter^Unknown^Unknown|Unknown",
        "ClaimDeviceSlot^DeviceSlot<Unknown>^none",
        "DeviceRead^Unknown^Unknown",
        "DeviceWrite^Void^Unknown|Unknown",
        "ReleaseDeviceSlot^Void^Unknown",
        "SubmitDeviceRead^RemoteFuture<Unknown>^Unknown",
        "Clone^Unknown^Unknown",
        "ClaimSlot^Slot<Unknown>^none",
        "Read^Unknown^Unknown",
        "Write^Void^Unknown|Unknown",
        "Release^Void^Unknown",
        "AllocatorSystem^Allocator^none",
        "AllocatorTracing^Allocator^none",
        "AllocatorDebug^Allocator^none",
        "AllocatorScratch^Allocator^none",
        "AllocatorPersistent^Allocator^none",
        "AllocatorPool^Allocator^Unknown",
        "BoxArray^Box<Unknown>^Int|Allocator",
        "StringConcat^String^String|String",
        "ListNew^List<Unknown>^none",
        "ListPush^Void^Unknown|Unknown",
        "ListGet^Unknown^Unknown|Int",
        "ListSet^Void^Unknown|Int|Unknown",
        "ListRemove^Void^Unknown|Int",
        "ListSize^Int^Unknown",
        "QueueNew^Queue<Unknown>^none",
        "QueuePush^Void^Unknown|Unknown",
        "QueuePop^Unknown^Unknown",
        "QueueSize^Int^Unknown",
        "QueueEmpty^Bool^Unknown",
        "SetNew^Set<Unknown>^none",
        "SetAdd^Void^Unknown|Unknown",
        "SetRemove^Void^Unknown|Unknown",
        "SetHas^Bool^Unknown|Unknown",
        "SetSize^Int^Unknown",
        "ArrayPushOwnedString^Void^Array<String>|String",
        "ArrayDropOwnedStrings^Void^Array<String>",
        "CompilerRetireArrayStorage^Void^Unknown",
        "CompilerArtifactAbort^Int^Int",
        "CompilerArtifactBegin^Int^String",
        "CompilerArtifactCommit^Int^Int",
        "CompilerArtifactWrite^Bool^Int|String"
    ];
    let map_names: Array<String> = SemanticHashMapCallProtocolNames();
    let map_index: Int = 0;
    while map_index < ArrayLength(map_names) {
        let protocol: SemanticExpressionGraphCollectionCallProtocolFact =
            SemanticExpressionGraphCollectionCallProtocolFromName(map_names[map_index]);
        if !protocol.applies || protocol.family != "HashMap" { return []; }
        let result: String = protocol.return_kind;
        if result == "constructor" { result = "HashMap<Unknown, Unknown>"; }
        if result == "element" { result = "Unknown"; }
        if result == "keys" { result = "Array<Unknown>"; }
        let params: String = "none";
        let parameter: Int = 0;
        while parameter < protocol.expected_arity {
            if parameter == 0 { params = "Unknown"; }
            else { params = params + "|Unknown"; }
            parameter = parameter + 1;
        }
        ArrayPush(rows, protocol.operation + "^" + result + "^" + params);
        map_index = map_index + 1;
    }
    if !IntentObservabilityAbiReady() { return []; }
    let observability_rows: Array<String> =
        IntentObservabilityAbiSignatureRows();
    let observability_index: Int = 0;
    while observability_index < ArrayLength(observability_rows) {
        ArrayPush(rows, observability_rows[observability_index]);
        observability_index = observability_index + 1;
    }
    return rows;
}

func SeedSemanticBuiltinSignaturesInto(
    inout names: Array<String>,
    inout returns: Array<String>,
    inout params: Array<String>,
    owned: Bool
) -> Bool {
    let rows: Array<String> = SemanticBuiltinSignatureRows();
    let i: Int = 0;
    while i < ArrayLength(rows) {
        let parts: Array<String> = Split(rows[i], "^");
        if ArrayLength(parts) != 3 {
            return false;
        }
        let param_types: String = parts[2];
        if param_types == "none" {
            param_types = "";
        }
        if owned {
            ArrayPushOwnedString(names, parts[0]);
            ArrayPushOwnedString(returns, parts[1]);
            ArrayPushOwnedString(params, param_types);
        } else {
            ArrayPush(names, parts[0]);
            ArrayPush(returns, parts[1]);
            ArrayPush(params, param_types);
        }
        i = i + 1;
    }
    return true;
}

func SeedSemanticBuiltinSignatures(
    inout names: Array<String>,
    inout returns: Array<String>,
    inout params: Array<String>
) -> Bool {
    return SeedSemanticBuiltinSignaturesInto(
        names, returns, params, false
    );
}

func SeedSemanticOwnedBuiltinSignatures(
    inout names: Array<String>,
    inout returns: Array<String>,
    inout params: Array<String>
) -> Bool {
    return SeedSemanticBuiltinSignaturesInto(
        names, returns, params, true
    );
}

// Verifies any consumer projection directly against the registry rows. A
// caller may append owner-local functions after the builtin prefix, so only
// the canonical prefix length is required here.
func SemanticBuiltinSignatureProjectionPrefixReady(
    names: Array<String>,
    returns: Array<String>,
    params: Array<String>
) -> Bool {
    let rows: Array<String> = SemanticBuiltinSignatureRows();
    if ArrayLength(names) < ArrayLength(rows) ||
        ArrayLength(returns) < ArrayLength(rows) ||
        ArrayLength(params) < ArrayLength(rows) {
        return false;
    }
    let i: Int = 0;
    while i < ArrayLength(rows) {
        let parts: Array<String> = Split(rows[i], "^");
        if ArrayLength(parts) != 3 { return false; }
        let expected_params: String = parts[2];
        if expected_params == "none" { expected_params = ""; }
        if names[i] != parts[0] || returns[i] != parts[1] ||
            params[i] != expected_params {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func SemanticBuiltinReturnDependsOnArguments(name: String) -> Bool {
    return name == "Abs" || SemanticBuiltinUsesFirstArgumentPair(name) || name == "Clamp" ||
        name == "Clone" ||
        name == "ArraySort" || name == "ArrayReverse" ||
        name == "ArrayMap" || name == "ArrayFilter" || name == "Read";
}

// Min/Max's second argument is checked against the first argument's type.
// Unknown table slots are polymorphic obligations, not unconstrained values.
func SemanticBuiltinUsesFirstArgumentPair(name: String) -> Bool {
    return name == "Min" || name == "Max";
}
func SemanticBuiltinPairedScalarSignatureOpt(name: String, first_type: String) -> Option<String> {
    if !SemanticBuiltinUsesFirstArgumentPair(name) || first_type == "Unknown" || first_type == "" {
        return None;
    }
    return Some(Concat(first_type, Concat("|", first_type)));
}

func SemanticPolymorphicBuiltinReturnTypeOpt(
    name: String,
    argument_types: Array<String>
) -> Option<String> {
    let expected_count: Int = 0;
    if name == "Abs" { expected_count = 1; }
    else if SemanticBuiltinUsesFirstArgumentPair(name) { expected_count = 2; }
    else if name == "Clamp" { expected_count = 3; }
    else if name == "ArraySort" || name == "ArrayReverse" {
        expected_count = 1;
    }
    else if name == "ArrayMap" || name == "ArrayFilter" {
        expected_count = 2;
    }
    else if name == "Clone" {
        expected_count = 1;
    }
    else if name == "Read" { expected_count = 1; }
    else { return None; }
    if ArrayLength(argument_types) != expected_count {
        return None;
    }
    let result_type: String = argument_types[0];
    if name == "Read" {
        return SlotPayloadTypeOpt(result_type);
    }
    if name == "Clone" {
        return Some(result_type);
    }
    if name == "ArraySort" || name == "ArrayReverse" ||
        name == "ArrayMap" || name == "ArrayFilter" {
        let n: Int = StringLength(result_type);
        if n < 8 || Substring(result_type, 0, 6) != "Array<" ||
            CharAt(result_type, n - 1) != ">" {
            return None;
        }
        return Some(result_type);
    }
    if result_type != "Int" && result_type != "Long" &&
        result_type != "Float" {
        return None;
    }
    let i: Int = 1;
    while i < ArrayLength(argument_types) {
        if argument_types[i] != result_type { return None; }
        i = i + 1;
    }
    return Some(result_type);
}

func SemanticContextualBuiltinReturnTypeOpt(
    name: String,
    argument_count: Int,
    declared_type: Option<String>
) -> Option<String> {
    if (name != "ListNew" && name != "QueueNew" && name != "SetNew" && name != "MapNew") || argument_count != 0 ||
        !IsSome(declared_type) {
        return None;
    }
    let shape: SemanticConstructedTypeNameFact =
        SemanticConstructedTypeNameFactFrom(UnwrapOption(declared_type));
    if name == "MapNew" {
        if SemanticHashMapTypeError(name, shape) != "" { return None; }
        return Some(shape.canonical_name);
    }
    if !shape.ok ||
        (name == "ListNew" && shape.nominal_base_name != "List") ||
        (name == "QueueNew" && shape.nominal_base_name != "Queue") ||
        (name == "SetNew" && shape.nominal_base_name != "Set") ||
        ArrayLength(shape.actual_type_names) != 1 ||
        SemanticTypeNameContainsUnresolvedUnknown(shape.canonical_name) {
        return None;
    }
    return Some(shape.canonical_name);
}

struct SemanticHashMapCallSignature {
    applies: Bool;
    ok: Bool;
    error: String;
    parameter_types: Array<String>;
    return_type: String;
}

func SemanticHashMapTypeError(name: String, shape: SemanticConstructedTypeNameFact) -> String {
    if !shape.ok || shape.nominal_base_name != "HashMap" ||
        ArrayLength(shape.actual_type_names) != 2 ||
        SemanticTypeNameContainsUnresolvedUnknown(shape.canonical_name) {
        return SemanticError3("builtin_arg_type_mismatch", "func", name,
            "expected", "HashMap<K, V>", "actual", shape.canonical_name);
    }
    if !SemanticCollectionStableKeySupported(shape.actual_type_names[0]) {
        return SemanticError3("builtin_arg_type_mismatch", "func", name,
            "expected", "HashMap with a supported stable scalar key", "actual", shape.canonical_name);
    }
    return "";
}

func SemanticHashMapContextualTypeError(declared: Option<String>, inferred: String) -> String {
    if inferred != "HashMap<Unknown, Unknown>" || !IsSome(declared) { return ""; }
    return SemanticHashMapTypeError("MapNew",
        SemanticConstructedTypeNameFactFrom(UnwrapOption(declared)));
}

func SemanticHashMapCallSignatureFrom(
    name: String, argument_count: Int, receiver_type: String
) -> SemanticHashMapCallSignature {
    let empty: Array<String> = [];
    let protocol: SemanticExpressionGraphCollectionCallProtocolFact =
        SemanticExpressionGraphCollectionCallProtocolFromName(name);
    if !protocol.applies || protocol.family != "HashMap" {
        return SemanticHashMapCallSignature(false, true, "", empty, "");
    }
    if argument_count != protocol.expected_arity {
        return SemanticHashMapCallSignature(true, false, SemanticError3(
            "call_arity_mismatch", "func", name,
            "expected", ToString(protocol.expected_arity), "actual", ToString(argument_count)
        ), empty, "");
    }
    if protocol.return_kind == "constructor" {
        return SemanticHashMapCallSignature(true, true, "", empty, "HashMap<Unknown, Unknown>");
    }
    let shape: SemanticConstructedTypeNameFact = SemanticConstructedTypeNameFactFrom(receiver_type);
    let type_error: String = SemanticHashMapTypeError(name, shape);
    if type_error != "" {
        return SemanticHashMapCallSignature(true, false, type_error, empty, "");
    }
    let parameters: Array<String> = [];
    let index: Int = 0;
    while index < protocol.expected_arity {
        let expected: String = "Unknown";
        if index == protocol.receiver_argument_index { expected = shape.canonical_name; }
        if index == protocol.key_argument_index { expected = shape.actual_type_names[0]; }
        if index == protocol.value_argument_index { expected = shape.actual_type_names[1]; }
        if expected == "Unknown" {
            return SemanticHashMapCallSignature(true, false, SemanticError1(
                "ast_artifact_invalid", "owner", "hashmap_call_protocol"
            ), empty, "");
        }
        ArrayPush(parameters, expected);
        index = index + 1;
    }
    let result: String = protocol.return_kind;
    if result == "element" { result = shape.actual_type_names[1]; }
    if result == "keys" { result = "Array<" + shape.actual_type_names[0] + ">"; }
    return SemanticHashMapCallSignature(true, true, "", parameters, result);
}

func SemanticBuiltinSignatureContractReady() -> Bool {
    let names: Array<String> = [];
    let returns: Array<String> = [];
    let params: Array<String> = [];
    let int_pair: Array<String> = ["Int", "Int"];
    let mixed_pair: Array<String> = ["Int", "Float"];
    let min_type: Option<String> =
        SemanticPolymorphicBuiltinReturnTypeOpt("Min", int_pair);
    let contextual_list: Option<String> =
        SemanticContextualBuiltinReturnTypeOpt(
            "ListNew", 0, Some("List<HashMap<String, Int>>")
        );
    if !SeedSemanticBuiltinSignatures(names, returns, params) ||
        !SemanticBuiltinSignatureProjectionPrefixReady(names, returns, params) ||
        !IntentObservabilityAbiReady() ||
        ArrayLength(returns) != ArrayLength(names) ||
        ArrayLength(params) != ArrayLength(names) {
        return false;
    }
    let i: Int = 0;
    while i < ArrayLength(names) {
        if names[i] == "" || returns[i] == "" {
            return false;
        }
        let prior: Int = 0;
        while prior < i {
            if names[prior] == names[i] { return false; }
            prior = prior + 1;
        }
        i = i + 1;
    }
    if !IsSome(contextual_list) || UnwrapOption(contextual_list) !=
        "List<HashMap<String, Int>>" {
        return false;
    }
    let contextual_queue: Option<String> =
        SemanticContextualBuiltinReturnTypeOpt(
            "QueueNew", 0, Some("Queue<String>")
        );
    let contextual_set: Option<String> =
        SemanticContextualBuiltinReturnTypeOpt(
            "SetNew", 0, Some("Set<String>")
        );
    if !IsSome(contextual_queue) ||
        UnwrapOption(contextual_queue) != "Queue<String>" ||
        !IsSome(contextual_set) || UnwrapOption(contextual_set) != "Set<String>" {
        return false;
    }
    if IsSome(SemanticContextualBuiltinReturnTypeOpt("ListNew", 0, None)) ||
        IsSome(SemanticContextualBuiltinReturnTypeOpt(
            "ListNew", 1, Some("List<Int>")
        )) || IsSome(SemanticContextualBuiltinReturnTypeOpt(
            "ListNew", 0, Some("HashMap<String, Int>")
        )) || IsSome(SemanticContextualBuiltinReturnTypeOpt(
            "ListNew", 0, Some("List<Unknown>")
        )) || IsSome(SemanticContextualBuiltinReturnTypeOpt(
            "QueueNew", 0, Some("List<Int>")
        )) || IsSome(SemanticContextualBuiltinReturnTypeOpt(
            "SetNew", 0, Some("List<Int>")
        )) {
        return false;
    }
    return IsSome(min_type) && UnwrapOption(min_type) == "Int" &&
        !IsSome(SemanticPolymorphicBuiltinReturnTypeOpt("Min", mixed_pair));
}
