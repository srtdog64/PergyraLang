func SeedSemanticBuiltinSignatures(
    inout names: Array<String>,
    inout returns: Array<String>,
    inout params: Array<String>
) -> Bool {
    let rows: Array<String> = SemanticBuiltinSignatureRows();
    let i: Int = 0;
    while i < ArrayLength(rows) {
        let parts: Array<String> = Split(rows[i], "^");
        if ArrayLength(parts) != 3 {
            return false;
        }
        let param_types: String = parts[2];
        if param_types == "none" {
            param_types = "";
        }
        ArrayPush(names, parts[0]);
        ArrayPush(returns, parts[1]);
        ArrayPush(params, param_types);
        i = i + 1;
    }
    return true;
}

func SemanticBuiltinReturnDependsOnArguments(name: String) -> Bool {
    return name == "Abs" || name == "Min" ||
        name == "Max" || name == "Clamp" ||
        name == "Clone" ||
        name == "ArraySort" || name == "ArrayReverse" ||
        name == "ArrayMap" || name == "ArrayFilter" || name == "Read";
}

func SemanticPolymorphicBuiltinReturnTypeOpt(
    name: String,
    argument_types: Array<String>
) -> Option<String> {
    let expected_count: Int = 0;
    if name == "Abs" { expected_count = 1; }
    else if name == "Min" || name == "Max" { expected_count = 2; }
    else if name == "Clamp" { expected_count = 3; }
    else if name == "ArraySort" || name == "ArrayReverse" {
        expected_count = 1;
    }
    else if name == "ArrayMap" || name == "ArrayFilter" {
        expected_count = 2;
    }
    else if name == "Clone" {
        expected_count = 1;
    }
    else if name == "Read" { expected_count = 1; }
    else { return None; }
    if ArrayLength(argument_types) != expected_count {
        return None;
    }
    let result_type: String = argument_types[0];
    if name == "Read" {
        return SlotPayloadTypeOpt(result_type);
    }
    if name == "Clone" {
        return Some(result_type);
    }
    if name == "ArraySort" || name == "ArrayReverse" ||
        name == "ArrayMap" || name == "ArrayFilter" {
        let n: Int = StringLength(result_type);
        if n < 8 || Substring(result_type, 0, 6) != "Array<" ||
            CharAt(result_type, n - 1) != ">" {
            return None;
        }
        return Some(result_type);
    }
    if result_type != "Int" && result_type != "Long" &&
        result_type != "Float" {
        return None;
    }
    let i: Int = 1;
    while i < ArrayLength(argument_types) {
        if argument_types[i] != result_type { return None; }
        i = i + 1;
    }
    return Some(result_type);
}

func SemanticContextualBuiltinReturnTypeOpt(
    name: String,
    argument_count: Int,
    declared_type: Option<String>
) -> Option<String> {
    if (name != "ListNew" && name != "QueueNew" && name != "SetNew") || argument_count != 0 ||
        !IsSome(declared_type) {
        return None;
    }
    let shape: SemanticConstructedTypeNameFact =
        SemanticConstructedTypeNameFactFrom(UnwrapOption(declared_type));
    if !shape.ok ||
        (name == "ListNew" && shape.nominal_base_name != "List") ||
        (name == "QueueNew" && shape.nominal_base_name != "Queue") ||
        (name == "SetNew" && shape.nominal_base_name != "Set") ||
        ArrayLength(shape.actual_type_names) != 1 ||
        SemanticTypeNameContainsUnresolvedUnknown(shape.canonical_name) {
        return None;
    }
    return Some(shape.canonical_name);
}

func SemanticBuiltinSignatureContractReady() -> Bool {
    let names: Array<String> = [];
    let returns: Array<String> = [];
    let params: Array<String> = [];
    let int_pair: Array<String> = ["Int", "Int"];
    let mixed_pair: Array<String> = ["Int", "Float"];
    let min_type: Option<String> =
        SemanticPolymorphicBuiltinReturnTypeOpt("Min", int_pair);
    let contextual_list: Option<String> =
        SemanticContextualBuiltinReturnTypeOpt(
            "ListNew", 0, Some("List<HashMap<String, Int>>")
        );
    return SeedSemanticBuiltinSignatures(names, returns, params) &&
        ArrayLength(names) == 120 && ArrayLength(returns) == 120 &&
        ArrayLength(params) == 120 && names[0] == "StringLength" &&
        returns[0] == "Int" && params[0] == "String" &&
        names[47] == "Args" && params[47] == "" &&
        names[51] == "StringJoin" &&
        names[68] == "UnwrapErr" && params[68] == "Unknown" &&
        names[70] == "AllocatorResult" && returns[70] == "Allocator" &&
        names[75] == "TextBuilderDrop" && params[75] == "TextBuilder" &&
        names[76] == "FileOpen" && returns[76] == "Int" &&
        params[76] == "String|String" &&
        names[79] == "FileClose" && params[79] == "Int" &&
        names[80] == "ArraySort" && names[83] == "ArrayFilter" &&
        names[84] == "ClaimDeviceSlot" &&
        names[88] == "SubmitDeviceRead" &&
        names[89] == "Clone" &&
        names[90] == "ClaimSlot" && returns[90] == "Slot<Unknown>" &&
        names[91] == "Read" && names[92] == "Write" &&
        names[93] == "Release" &&
        names[94] == "AllocatorSystem" && names[95] == "AllocatorTracing" &&
        names[96] == "AllocatorDebug" && names[97] == "AllocatorScratch" &&
        names[98] == "AllocatorPersistent" && names[99] == "AllocatorPool" &&
        returns[99] == "Allocator" && names[100] == "BoxArray" &&
        returns[100] == "Box<Unknown>" && params[100] == "Int|Allocator" &&
        names[101] == "StringConcat" && returns[101] == "String" &&
        params[101] == "String|String" && names[102] == "ListNew" &&
        returns[102] == "List<Unknown>" && params[102] == "" &&
        names[103] == "ListPush" && returns[103] == "Void" &&
        params[103] == "Unknown|Unknown" && names[104] == "ListGet" &&
        returns[104] == "Unknown" && params[104] == "Unknown|Int" &&
        names[105] == "ListSet" && returns[105] == "Void" &&
        params[105] == "Unknown|Int|Unknown" &&
        names[106] == "ListRemove" && returns[106] == "Void" &&
        params[106] == "Unknown|Int" && names[107] == "ListSize" &&
        returns[107] == "Int" && params[107] == "Unknown" &&
        names[108] == "QueueNew" && returns[108] == "Queue<Unknown>" &&
        params[108] == "" && names[109] == "QueuePush" &&
        returns[109] == "Void" && params[109] == "Unknown|Unknown" &&
        names[110] == "QueuePop" && returns[110] == "Unknown" &&
        params[110] == "Unknown" && names[111] == "QueueSize" &&
        returns[111] == "Int" && params[111] == "Unknown" &&
        names[112] == "QueueEmpty" && returns[112] == "Bool" &&
        params[112] == "Unknown" &&
        names[113] == "SetNew" && returns[113] == "Set<Unknown>" &&
        params[113] == "" && names[114] == "SetAdd" &&
        returns[114] == "Void" && params[114] == "Unknown|Unknown" &&
        names[115] == "SetRemove" && returns[115] == "Void" &&
        params[115] == "Unknown|Unknown" && names[116] == "SetHas" &&
        returns[116] == "Bool" && params[116] == "Unknown|Unknown" &&
        names[117] == "SetSize" && returns[117] == "Int" &&
        params[117] == "Unknown" &&
        names[118] == "ArrayPushOwnedString" && returns[118] == "Void" &&
        params[118] == "Array<String>|String" &&
        names[119] == "ArrayDropOwnedStrings" && returns[119] == "Void" &&
        params[119] == "Array<String>" &&
        IsSome(contextual_list) && UnwrapOption(contextual_list) ==
            "List<HashMap<String, Int>>" &&
        IsSome(SemanticContextualBuiltinReturnTypeOpt(
            "QueueNew", 0, Some("Queue<String>")
        )) && UnwrapOption(SemanticContextualBuiltinReturnTypeOpt(
            "QueueNew", 0, Some("Queue<String>")
        )) == "Queue<String>" &&
        !IsSome(SemanticContextualBuiltinReturnTypeOpt(
            "ListNew", 0, None
        )) && !IsSome(SemanticContextualBuiltinReturnTypeOpt(
            "ListNew", 1, Some("List<Int>")
        )) && !IsSome(SemanticContextualBuiltinReturnTypeOpt(
            "ListNew", 0, Some("HashMap<String, Int>")
        )) && !IsSome(SemanticContextualBuiltinReturnTypeOpt(
            "ListNew", 0, Some("List<Unknown>")
        )) && !IsSome(SemanticContextualBuiltinReturnTypeOpt(
            "QueueNew", 0, Some("List<Int>")
        )) && IsSome(SemanticContextualBuiltinReturnTypeOpt(
            "SetNew", 0, Some("Set<String>")
        )) && UnwrapOption(SemanticContextualBuiltinReturnTypeOpt(
            "SetNew", 0, Some("Set<String>")
        )) == "Set<String>" && !IsSome(
            SemanticContextualBuiltinReturnTypeOpt(
                "SetNew", 0, Some("List<Int>")
            )
        ) &&
        IsSome(min_type) && UnwrapOption(min_type) == "Int" &&
        !IsSome(SemanticPolymorphicBuiltinReturnTypeOpt(
            "Min", mixed_pair
        ));
}
