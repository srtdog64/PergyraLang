// Self-host semantic call checking owner.

import "text_scan_owner.pgy";
import "diagnostic_owner.pgy";
import "env_owner.pgy";
import "expr_type_owner.pgy";
import "expr_validation_owner.pgy";
import "delimited_range_fact_owner.pgy";
import "collection_mutation_policy_owner.pgy";
import "ast_signature_type_expression_fact_owner.pgy";

func CompareCallArgs(
    ref argument_facts: SemanticDelimitedRangeFacts,
    ref signature_facts: SemanticDelimitedRangeFacts,
    callee: String,
    args_src: String,
    sig: String,
    names: Array<String>,
    types: Array<String>,
    func_names: Array<String>,
    func_rets: Array<String>,
    check_argument_identifiers: Bool
) -> String {
    let i: Int = 0;
    let arg_index: Int = 0;
    while i < SemanticDelimitedRangeCount(argument_facts) {
        let part: String = SemanticDelimitedRangeText(
            argument_facts, args_src, i
        );
        if StringLength(part) > 0 {
            if check_argument_identifiers {
                let undefined_error: String =
                    CheckUndefinedIdentifiers(part, names, func_names);
                if StringLength(undefined_error) > 0 {
                    return undefined_error;
                }
            }
            let expected: String = NthExpectedFromFacts(
                signature_facts, sig, arg_index
            );
            let actual: String = ExprType(
                part, names, types, func_names, func_rets
            );
            if StringLength(expected) > 0 && expected != "Unknown" &&
                actual != "Unknown" &&
                !ExpressionAssignableTo(expected, actual, part) {
                return SemanticError3(
                    "call_arg_type_mismatch", "func", callee,
                    "expected", expected, "actual", actual
                );
            }
            arg_index = arg_index + 1;
        }
        i = i + 1;
    }
    return "";
}
func CheckScalarUtilityArgs(
    ref argument_facts: SemanticDelimitedRangeFacts,
    callee: String,
    args_src: String,
    names: Array<String>,
    types: Array<String>,
    func_names: Array<String>,
    func_rets: Array<String>,
    check_argument_identifiers: Bool
) -> String {
    if callee != "Min" && callee != "Max" {
        return "";
    }
    let first: String = CallArgAtFromFacts(argument_facts, args_src, 0);
    let second: String = CallArgAtFromFacts(argument_facts, args_src, 1);
    if check_argument_identifiers {
        let first_undefined: String =
            CheckUndefinedIdentifiers(first, names, func_names);
        if StringLength(first_undefined) > 0 {
            return first_undefined;
        }
        let second_undefined: String =
            CheckUndefinedIdentifiers(second, names, func_names);
        if StringLength(second_undefined) > 0 {
            return second_undefined;
        }
    }
    let first_type: String = ExprType(first, names, types, func_names, func_rets);
    let second_type: String = ExprType(second, names, types, func_names, func_rets);
    if first_type != "Unknown" && second_type != "Unknown" && !ExpressionAssignableTo(first_type, second_type, second) {
        return SemanticError3("call_arg_type_mismatch", "func", callee, "expected", first_type, "actual", second_type);
    }
    return "";
}
func NumToStr(n: Int) -> String {
    if n == 0 {
        return "0";
    }
    let digits: String = "0123456789";
    let result: String = "";
    let v: Int = n;
    while v > 0 {
        let d: Int = v - (v / 10) * 10;
        result = Concat(Substring(digits, d, 1), result);
        v = v / 10;
    }
    return result;
}
func ParamCount(sig: String) -> Int {
    let facts: SemanticDelimitedRangeFacts =
        SemanticSignatureRangeFactsFromSource(sig);
    return ParamCountFromFacts(facts, sig);
}
func ParamCountFromFacts(
    ref signature_facts: SemanticDelimitedRangeFacts,
    sig: String
) -> Int {
    if StringLength(sig) == 0 {
        return 0;
    }
    return SemanticDelimitedRangeCount(signature_facts);
}
func ArgCountFromFacts(
    ref argument_facts: SemanticDelimitedRangeFacts
) -> Int {
    return SemanticDelimitedNonEmptyRangeCount(argument_facts);
}
func ArgCount(args_src: String) -> Int {
    let facts: SemanticDelimitedRangeFacts =
        SemanticNestedCommaRangeFactsFromSource(args_src);
    return ArgCountFromFacts(facts);
}
func FirstArgFromFacts(
    ref argument_facts: SemanticDelimitedRangeFacts,
    args_src: String
) -> String {
    return SemanticDelimitedRangeText(argument_facts, args_src, 0);
}
func FirstArg(args_src: String) -> String {
    let facts: SemanticDelimitedRangeFacts =
        SemanticNestedCommaRangeFactsFromSource(args_src);
    return FirstArgFromFacts(facts, args_src);
}
func CheckCollectionMutatorReceiver(
    ref argument_facts: SemanticDelimitedRangeFacts,
    callee: String,
    args_src: String,
    names: Array<String>,
    types: Array<String>,
    modes: Array<String>,
    internal_caller_ready: Bool
) -> String {
    let receiver: String = FirstArgFromFacts(argument_facts, args_src);
    return SemanticCollectionMutationError(
        callee, receiver, names, types, modes, internal_caller_ready
    );
}
func CheckOptionBuiltinArgs(
    ref argument_facts: SemanticDelimitedRangeFacts,
    callee: String,
    args_src: String,
    names: Array<String>,
    types: Array<String>,
    func_names: Array<String>,
    func_rets: Array<String>
) -> String {
    if callee != "IsSome" && callee != "UnwrapOption" {
        return "";
    }
    let option_expr: String = CallArgAtFromFacts(
        argument_facts, args_src, 0
    );
    let option_type: String = ExprType(option_expr, names, types, func_names, func_rets);
    if option_type == "Unknown" {
        return "";
    }
    if option_type == "Option<Unknown>" {
        return SemanticError3("option_concrete_type_required", "func", callee, "expected", "Option<T>", "actual", option_type);
    }
    if !IsOptionType(option_type) {
        return SemanticError3("builtin_arg_type_mismatch", "func", callee, "expected", "Option<T>", "actual", option_type);
    }
    return "";
}
func CheckCallWithIdentifierOwner(
    text: String,
    names: Array<String>,
    types: Array<String>,
    modes: Array<String>,
    func_names: Array<String>,
    func_rets: Array<String>,
    func_params: Array<String>,
    check_argument_identifiers: Bool,
    check_collection_mutation: Bool,
    internal_caller_ready: Bool
) -> String {
    let trimmed: String = Trim(text);
    let tn: Int = StringLength(trimmed);
    if tn == 0 {
        return "";
    }
    if TopLevelOpType(trimmed) != "" {
        return "";
    }
    if CharAt(trimmed, tn - 1) != ")" {
        return "";
    }
    let paren: Int = StringIndexOf(trimmed, "(");
    if paren <= 0 {
        return "";
    }
    let callee: String = Trim(Substring(trimmed, 0, paren));
    if !SemanticCallableSourceNameValid(callee) {
        return "";
    }
    let local_callable: SemanticAstCallableTypeShape =
        SemanticAstCallableTypeShapeFromName(
            EnvLookup(names, types, callee)
        );
    let sig: String = "";
    if local_callable.ok {
        sig = SemanticAstCallableTypeParameterSignature(local_callable);
    } else {
        let found_opt: Option<Int> = SemanticCallableIndex(func_names, callee);
        if !IsSome(found_opt) {
            return SemanticError1("undefined_function", "func", callee);
        }
        sig = func_params[UnwrapOption(found_opt)];
    }
    let signature_facts: SemanticDelimitedRangeFacts =
        SemanticSignatureRangeFactsFromSource(sig);
    let args_src: String = Substring(trimmed, paren + 1, tn - paren - 2);
    let argument_facts: SemanticDelimitedRangeFacts =
        SemanticNestedCommaRangeFactsFromSource(args_src);
    let receiver_error: String = "";
    if check_collection_mutation {
        receiver_error = CheckCollectionMutatorReceiver(
            argument_facts, callee, args_src, names, types, modes,
            internal_caller_ready
        );
    }
    if StringLength(receiver_error) > 0 {
        return receiver_error;
    }
    let expected_count: Int = ParamCountFromFacts(signature_facts, sig);
    let actual_count: Int = ArgCountFromFacts(argument_facts);
    if expected_count != actual_count {
        return SemanticError3("call_arity_mismatch", "func", callee, "expected", NumToStr(expected_count), "actual", NumToStr(actual_count));
    }
    let option_error: String = CheckOptionBuiltinArgs(
        argument_facts, callee, args_src,
        names, types, func_names, func_rets
    );
    if StringLength(option_error) > 0 {
        return option_error;
    }
    let scalar_error: String = CheckScalarUtilityArgs(
        argument_facts, callee, args_src,
        names, types, func_names, func_rets,
        check_argument_identifiers
    );
    if StringLength(scalar_error) > 0 {
        return scalar_error;
    }
    if StringLength(sig) == 0 {
        return "";
    }
    return CompareCallArgs(
        argument_facts, signature_facts, callee, args_src, sig,
        names, types, func_names, func_rets,
        check_argument_identifiers
    );
}

func CheckCall(
    text: String,
    names: Array<String>,
    types: Array<String>,
    modes: Array<String>,
    func_names: Array<String>,
    func_rets: Array<String>,
    func_params: Array<String>,
    internal_caller_ready: Bool
) -> String {
    return CheckCallWithIdentifierOwner(
        text, names, types, modes, func_names, func_rets, func_params,
        true, true, internal_caller_ready
    );
}

func CheckCallFromGraphIdentifiers(
    text: String,
    names: Array<String>,
    types: Array<String>,
    modes: Array<String>,
    func_names: Array<String>,
    func_rets: Array<String>,
    func_params: Array<String>
) -> String {
    return CheckCallWithIdentifierOwner(
        text, names, types, modes, func_names, func_rets, func_params,
        false, false, false
    );
}
import "callable_resolution_owner.pgy";
