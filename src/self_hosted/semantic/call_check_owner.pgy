// Self-host semantic call checking owner.

import "text_scan_owner.pgy";
import "diagnostic_owner.pgy";
import "env_owner.pgy";
import "expr_type_owner.pgy";
import "expr_validation_owner.pgy";

func CompareCallArgs(callee: String, args_src: String, sig: String, names: Array<String>, types: Array<String>, func_names: Array<String>, func_rets: Array<String>) -> String {
    let n: Int = StringLength(args_src);
    let i: Int = 0;
    let depth: Int = 0;
    let part_start: Int = 0;
    let arg_index: Int = 0;
    while i <= n {
        let at_end: Bool = i >= n;
        let c: String = "";
        if !at_end {
            c = CharAt(args_src, i);
        }
        if !at_end && c == "\"" {
            i = i + 1;
            while i < n && CharAt(args_src, i) != "\"" {
                if CharAt(args_src, i) == "\\" {
                    i = i + 1;
                }
                i = i + 1;
            }
            i = i + 1;
            continue;
        }
        if !at_end && (c == "<" || c == "(" || c == "[") {
            depth = depth + 1;
            i = i + 1;
            continue;
        }
        if !at_end && (c == ">" || c == ")" || c == "]") {
            if depth > 0 {
                depth = depth - 1;
            }
            i = i + 1;
            continue;
        }
        if at_end || (depth == 0 && c == ",") {
            let part: String = Trim(Substring(args_src, part_start, i - part_start));
            if StringLength(part) > 0 {
                let undefined_error: String = CheckUndefinedIdentifiers(part, names);
                if StringLength(undefined_error) > 0 {
                    return undefined_error;
                }
                let expected: String = NthExpected(sig, arg_index);
                let actual: String = ExprType(part, names, types, func_names, func_rets);
                if StringLength(expected) > 0 && expected != "Unknown" && actual != "Unknown" && expected != actual {
                    return SemanticError3("call_arg_type_mismatch", "func", callee, "expected", expected, "actual", actual);
                }
                arg_index = arg_index + 1;
            }
            part_start = i + 1;
        }
        i = i + 1;
    }
    return "";
}
func CheckScalarUtilityArgs(callee: String, args_src: String, names: Array<String>, types: Array<String>, func_names: Array<String>, func_rets: Array<String>) -> String {
    if callee != "Min" && callee != "Max" {
        return "";
    }
    let first: String = CallArgAt(args_src, 0);
    let second: String = CallArgAt(args_src, 1);
    let first_undefined: String = CheckUndefinedIdentifiers(first, names);
    if StringLength(first_undefined) > 0 {
        return first_undefined;
    }
    let second_undefined: String = CheckUndefinedIdentifiers(second, names);
    if StringLength(second_undefined) > 0 {
        return second_undefined;
    }
    let first_type: String = ExprType(first, names, types, func_names, func_rets);
    let second_type: String = ExprType(second, names, types, func_names, func_rets);
    if first_type != "Unknown" && second_type != "Unknown" && !ExpressionAssignableTo(first_type, second_type, second) {
        return SemanticError3("call_arg_type_mismatch", "func", callee, "expected", first_type, "actual", second_type);
    }
    return "";
}
func NumToStr(n: Int) -> String {
    if n == 0 {
        return "0";
    }
    let digits: String = "0123456789";
    let result: String = "";
    let v: Int = n;
    while v > 0 {
        let d: Int = v - (v / 10) * 10;
        result = Concat(Substring(digits, d, 1), result);
        v = v / 10;
    }
    return result;
}
func ParamCount(sig: String) -> Int {
    if StringLength(sig) == 0 {
        return 0;
    }
    let n: Int = StringLength(sig);
    let i: Int = 0;
    let count: Int = 1;
    while i < n {
        if CharAt(sig, i) == "|" {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}
func ArgCount(args_src: String) -> Int {
    let n: Int = StringLength(args_src);
    let i: Int = 0;
    let depth: Int = 0;
    let part_start: Int = 0;
    let count: Int = 0;
    while i <= n {
        let at_end: Bool = i >= n;
        let c: String = "";
        if !at_end {
            c = CharAt(args_src, i);
        }
        if !at_end && c == "\"" {
            i = i + 1;
            while i < n && CharAt(args_src, i) != "\"" {
                if CharAt(args_src, i) == "\\" {
                    i = i + 1;
                }
                i = i + 1;
            }
            i = i + 1;
            continue;
        }
        if !at_end && (c == "<" || c == "(" || c == "[") {
            depth = depth + 1;
            i = i + 1;
            continue;
        }
        if !at_end && (c == ">" || c == ")" || c == "]") {
            if depth > 0 {
                depth = depth - 1;
            }
            i = i + 1;
            continue;
        }
        if at_end || (depth == 0 && c == ",") {
            let part: String = Trim(Substring(args_src, part_start, i - part_start));
            if StringLength(part) > 0 {
                count = count + 1;
            }
            part_start = i + 1;
        }
        i = i + 1;
    }
    return count;
}
func FirstArg(args_src: String) -> String {
    let n: Int = StringLength(args_src);
    let i: Int = 0;
    let depth: Int = 0;
    while i < n {
        let c: String = CharAt(args_src, i);
        if c == "\"" {
            i = i + 1;
            while i < n && CharAt(args_src, i) != "\"" {
                if CharAt(args_src, i) == "\\" {
                    i = i + 1;
                }
                i = i + 1;
            }
            i = i + 1;
            continue;
        }
        if c == "<" || c == "(" || c == "[" {
            depth = depth + 1;
            i = i + 1;
            continue;
        }
        if c == ">" || c == ")" || c == "]" {
            if depth > 0 {
                depth = depth - 1;
            }
            i = i + 1;
            continue;
        }
        if depth == 0 && c == "," {
            return Trim(Substring(args_src, 0, i));
        }
        i = i + 1;
    }
    return Trim(args_src);
}
func IsCollectionMutator(callee: String) -> Bool {
    return callee == "ArrayPush"
        || callee == "ArraySet"
        || callee == "ArrayPop"
        || callee == "ListPush"
        || callee == "ListSet"
        || callee == "ListRemove"
        || callee == "SetAdd"
        || callee == "SetRemove"
        || callee == "QueuePush"
        || callee == "QueuePop"
        || callee == "MapSet"
        || callee == "MapRemove";
}
func IsCollectionTypeName(type_name: String) -> Bool {
    return StringContains(type_name, "Array<")
        || StringContains(type_name, "List<")
        || StringContains(type_name, "Set<")
        || StringContains(type_name, "Queue<")
        || StringContains(type_name, "HashMap<");
}
func CheckCollectionMutatorReceiver(callee: String, args_src: String, names: Array<String>, types: Array<String>, modes: Array<String>) -> String {
    if !IsCollectionMutator(callee) {
        return "";
    }
    let receiver: String = FirstArg(args_src);
    if !IsIdentText(receiver) {
        return "";
    }
    if EnvMode(names, modes, receiver) != "default_param" {
        return "";
    }
    let receiver_type: String = EnvLookup(names, types, receiver);
    if !IsCollectionTypeName(receiver_type) {
        return "";
    }
    return SemanticError3("value_param_collection_mutation", "func", callee, "param", receiver, "mode", "default");
}
func CheckOptionBuiltinArgs(callee: String, args_src: String, names: Array<String>, types: Array<String>, func_names: Array<String>, func_rets: Array<String>) -> String {
    if callee != "IsSome" && callee != "UnwrapOption" {
        return "";
    }
    let option_expr: String = CallArgAt(args_src, 0);
    let option_type: String = ExprType(option_expr, names, types, func_names, func_rets);
    if option_type == "Unknown" {
        return "";
    }
    if !IsOptionType(option_type) {
        return SemanticError3("builtin_arg_type_mismatch", "func", callee, "expected", "Option<T>", "actual", option_type);
    }
    return "";
}
func CheckCall(text: String, names: Array<String>, types: Array<String>, modes: Array<String>, func_names: Array<String>, func_rets: Array<String>, func_params: Array<String>) -> String {
    let trimmed: String = Trim(text);
    let tn: Int = StringLength(trimmed);
    if tn == 0 {
        return "";
    }
    if TopLevelOpType(trimmed) != "" {
        return "";
    }
    if CharAt(trimmed, tn - 1) != ")" {
        return "";
    }
    let paren: Int = StringIndexOf(trimmed, "(");
    if paren <= 0 {
        return "";
    }
    let callee: String = Trim(Substring(trimmed, 0, paren));
    if !IsIdentText(callee) {
        return "";
    }
    let idx: Int = 0;
    let found: Int = -1;
    while idx < ArrayLength(func_names) {
        if func_names[idx] == callee {
            found = idx;
        }
        idx = idx + 1;
    }
    if found < 0 {
        return SemanticError1("undefined_function", "func", callee);
    }
    let sig: String = func_params[found];
    let args_src: String = Substring(trimmed, paren + 1, tn - paren - 2);
    let receiver_error: String = CheckCollectionMutatorReceiver(callee, args_src, names, types, modes);
    if StringLength(receiver_error) > 0 {
        return receiver_error;
    }
    let expected_count: Int = ParamCount(sig);
    let actual_count: Int = ArgCount(args_src);
    if expected_count != actual_count {
        return SemanticError3("call_arity_mismatch", "func", callee, "expected", NumToStr(expected_count), "actual", NumToStr(actual_count));
    }
    let option_error: String = CheckOptionBuiltinArgs(callee, args_src, names, types, func_names, func_rets);
    if StringLength(option_error) > 0 {
        return option_error;
    }
    let scalar_error: String = CheckScalarUtilityArgs(callee, args_src, names, types, func_names, func_rets);
    if StringLength(scalar_error) > 0 {
        return scalar_error;
    }
    if StringLength(sig) == 0 {
        return "";
    }
    return CompareCallArgs(callee, args_src, sig, names, types, func_names, func_rets);
}
