// Canonical callable-name resolution over flattened namespace declarations.

import "text_scan_owner.pgy";

func SemanticCallableNameRangeValid(
    source_name: String,
    start: Int,
    end: Int
) -> Bool {
    let n: Int = StringLength(source_name);
    if start < 0 || end <= start || end > n ||
        !SourceByteIsAlpha(SourceByteAt(source_name, n, n, start)) {
        return false;
    }
    let i: Int = start + 1;
    while i < end {
        if !SourceByteIsAlphaNum(SourceByteAt(source_name, n, n, i)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func SemanticCallableNameSegmentValid(segment: String) -> Bool {
    return SemanticCallableNameRangeValid(
        segment, 0, StringLength(segment)
    );
}

func SemanticCallableSourceNameValid(source_name: String) -> Bool {
    let n: Int = StringLength(source_name);
    let dot: Int = StringIndexOf(source_name, ".");
    if dot < 0 {
        return SemanticCallableNameSegmentValid(source_name);
    }
    let first: Int = SourceByteAt(source_name, n, n, 0);
    if dot == 0 || first < 65 || first > 90 {
        return false;
    }
    let start: Int = 0;
    let i: Int = 0;
    let separator: Int = SourceByteOf(".");
    while i <= n {
        if i == n || SourceByteAt(source_name, n, n, i) == separator {
            if !SemanticCallableNameRangeValid(source_name, start, i) {
                return false;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return true;
}

func SemanticCallableCanonicalLookupName(source_name: String) -> String {
    return StringReplace(source_name, ".", "_");
}

func SemanticCallableCanonicalDeclaredName(
    owner_name: String,
    local_name: String
) -> String {
    if owner_name == "" { return local_name; }
    return Concat(owner_name, Concat("_", local_name));
}

func SemanticCallableCanonicalDeclaredNameEquals(
    owner_name: String,
    local_name: String,
    canonical_target: String
) -> Bool {
    if owner_name == "" {
        return local_name == canonical_target;
    }
    let owner_length: Int = StringLength(owner_name);
    let local_length: Int = StringLength(local_name);
    let target_length: Int = StringLength(canonical_target);
    return target_length == owner_length + local_length + 1 &&
        SubEqualsWithLen(
            canonical_target, target_length, 0, owner_length, owner_name
        ) &&
        SubEqualsWithLen(
            canonical_target, target_length, owner_length, 1, "_"
        ) &&
        SubEqualsWithLen(
            canonical_target, target_length, owner_length + 1,
            local_length, local_name
        );
}

func SemanticCallableIndex(
    ref declared_names: Array<String>,
    source_name: String
) -> Option<Int> {
    if !SemanticCallableSourceNameValid(source_name) {
        return None;
    }
    let lookup_name: String =
        SemanticCallableCanonicalLookupName(source_name);
    let exact: Int = -1;
    let exact_count: Int = 0;
    let i: Int = 0;
    while i < ArrayLength(declared_names) {
        if declared_names[i] == lookup_name {
            exact = i;
            exact_count = exact_count + 1;
        }
        i = i + 1;
    }
    if exact_count == 1 {
        return Some(exact);
    }
    if exact_count > 1 {
        return None;
    }
    if StringIndexOf(source_name, ".") >= 0 {
        return None;
    }

    let suffix: Int = -1;
    let suffix_count: Int = 0;
    i = 0;
    while i < ArrayLength(declared_names) {
        // One unchanged row index lets every read observe the row in place.
        let declared_row: Int = i;
        let declared_len: Int = StringLength(declared_names[declared_row]);
        let local_len: Int = StringLength(source_name);
        let matches: Bool = local_len > 0 && declared_len > local_len;
        let start: Int = declared_len - local_len;
        if matches && CharCode(
                declared_names[declared_row], declared_len, start - 1) !=
                SourceByteOf("_") {
            matches = false;
        }
        let offset: Int = 0;
        while matches && offset < local_len {
            if CharCode(declared_names[declared_row], declared_len, start + offset) !=
                CharCode(source_name, local_len, offset) {
                matches = false;
            }
            offset = offset + 1;
        }
        if matches {
            suffix = i;
            suffix_count = suffix_count + 1;
        }
        i = i + 1;
    }
    if suffix_count == 1 {
        return Some(suffix);
    }
    return None;
}

// One declared-name array with its exact and '_'-suffix lookups, built once
// per callable table. SemanticCallableIndex scans the array on every call; a
// table answers the same question by map lookup. Suffix keys are every
// non-empty text after a '_' in a name, so a source name matches a row exactly
// when the row ends with "_" + that name, as in the scan.
struct SemanticCallableNameTable {
    names: Array<String>;
    exact_first_rows: HashMap<String, Int>;
    exact_row_counts: HashMap<String, Int>;
    suffix_first_rows: HashMap<String, Int>;
    suffix_row_counts: HashMap<String, Int>;
}

func SemanticCallableNameTableCount(
    inout first_rows: HashMap<String, Int>,
    inout row_counts: HashMap<String, Int>,
    key: String, row: Int
) -> Void {
    if MapHas(row_counts, key) {
        MapSet(row_counts, key, MapGet(row_counts, key) + 1);
        return;
    }
    MapSet(first_rows, key, row);
    MapSet(row_counts, key, 1);
}

// Scans with a ref array: CharCode's length proof holds for ref rows only.
func SemanticCallableNameTableFill(
    ref names: Array<String>,
    inout exact_first_rows: HashMap<String, Int>,
    inout exact_row_counts: HashMap<String, Int>,
    inout suffix_first_rows: HashMap<String, Int>,
    inout suffix_row_counts: HashMap<String, Int>
) -> Void {
    let separator: Int = SourceByteOf("_");
    let row: Int = 0;
    while row < ArrayLength(names) {
        // One unchanged row index lets every read observe the row in place.
        let declared_row: Int = row;
        let declared_len: Int = StringLength(names[declared_row]);
        let separators: Array<Int> = [];
        let at: Int = 0;
        while at < declared_len - 1 {
            if CharCode(names[declared_row], declared_len, at) == separator {
                ArrayPush(separators, at);
            }
            at = at + 1;
        }
        let slot: Int = 0;
        while slot < ArrayLength(separators) {
            let start: Int = separators[slot] + 1;
            SemanticCallableNameTableCount(
                suffix_first_rows, suffix_row_counts,
                Substring(names[declared_row], start, declared_len - start),
                declared_row);
            slot = slot + 1;
        }
        // The count keeps its key, so it receives a copy, never the row itself.
        SemanticCallableNameTableCount(exact_first_rows, exact_row_counts,
            Concat("", names[declared_row]), declared_row);
        row = row + 1;
    }
}

// The table owns copies of the names; the caller keeps its own rows.
func SemanticCallableNameTableFromNames(
    ref names: Array<String>
) -> SemanticCallableNameTable {
    let table_names: Array<String> = [];
    let row: Int = 0;
    while row < ArrayLength(names) {
        ArrayPushOwnedString(table_names, names[row]);
        row = row + 1;
    }
    let exact_first_rows: HashMap<String, Int> = MapNew();
    let exact_row_counts: HashMap<String, Int> = MapNew();
    let suffix_first_rows: HashMap<String, Int> = MapNew();
    let suffix_row_counts: HashMap<String, Int> = MapNew();
    SemanticCallableNameTableFill(table_names, exact_first_rows, exact_row_counts,
        suffix_first_rows, suffix_row_counts);
    return SemanticCallableNameTable(table_names, exact_first_rows,
        exact_row_counts, suffix_first_rows, suffix_row_counts);
}

// The stored value for a key, or -1 when no row has it.
func SemanticCallableNameTableValue(
    index: HashMap<String, Int>, key: String
) -> Int {
    if !MapHas(index, key) { return -1; }
    return MapGet(index, key);
}

func SemanticCallableIndexInTable(
    ref table: SemanticCallableNameTable,
    source_name: String
) -> Option<Int> {
    if !SemanticCallableSourceNameValid(source_name) {
        return None;
    }
    let lookup_name: String =
        SemanticCallableCanonicalLookupName(source_name);
    let exact_count: Int =
        SemanticCallableNameTableValue(table.exact_row_counts, lookup_name);
    if exact_count == 1 {
        return Some(SemanticCallableNameTableValue(
            table.exact_first_rows, lookup_name));
    }
    if exact_count > 1 || StringIndexOf(source_name, ".") >= 0 {
        return None;
    }
    if SemanticCallableNameTableValue(table.suffix_row_counts, source_name) == 1 {
        return Some(SemanticCallableNameTableValue(
            table.suffix_first_rows, source_name));
    }
    return None;
}

func SemanticCallableResolutionContractReady() -> Bool {
    let names: Array<String> = [
        "SelfHostPath_IsAbsolute", "SelfHostPath_JoinRelativePath", "Main"
    ];
    let exact: Option<Int> = SemanticCallableIndex(names, "Main");
    let local_match: Option<Int> = SemanticCallableIndex(names, "IsAbsolute");
    let qualified: Option<Int> = SemanticCallableIndex(
        names, "SelfHostPath.JoinRelativePath"
    );
    let ambiguous_names: Array<String> = ["A_Run", "B_Run"];
    return SemanticCallableCanonicalDeclaredName("Box", "Get") ==
            "Box_Get" &&
        SemanticCallableCanonicalDeclaredName("", "Main") == "Main" &&
        SemanticCallableCanonicalDeclaredNameEquals(
            "Box", "Get", "Box_Get"
        ) &&
        SemanticCallableCanonicalDeclaredNameEquals("", "Main", "Main") &&
        !SemanticCallableCanonicalDeclaredNameEquals(
            "Box", "Get", "Other_Get"
        ) &&
        !SemanticCallableCanonicalDeclaredNameEquals(
            "Box", "Get", "Box_GetExtra"
        ) &&
        IsSome(exact) && UnwrapOption(exact) == 2 &&
        IsSome(local_match) && UnwrapOption(local_match) == 0 &&
        IsSome(qualified) && UnwrapOption(qualified) == 1 &&
        !IsSome(SemanticCallableIndex(ambiguous_names, "Run"));
}
