// Canonical callable-name resolution over flattened namespace declarations.

import "text_scan_owner.pgy";

func SemanticCallableNameSegmentValid(segment: String) -> Bool {
    if StringLength(segment) == 0 || !IsAlpha(CharAt(segment, 0)) {
        return false;
    }
    let i: Int = 1;
    while i < StringLength(segment) {
        if !IsAlphaNum(CharAt(segment, i)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func SemanticCallableSourceNameValid(source_name: String) -> Bool {
    let dot: Int = StringIndexOf(source_name, ".");
    if dot < 0 {
        return SemanticCallableNameSegmentValid(source_name);
    }
    if dot == 0 || !StringContains(
        "ABCDEFGHIJKLMNOPQRSTUVWXYZ", CharAt(source_name, 0)
    ) {
        return false;
    }
    let start: Int = 0;
    let i: Int = 0;
    while i <= StringLength(source_name) {
        if i == StringLength(source_name) || CharAt(source_name, i) == "." {
            if !SemanticCallableNameSegmentValid(
                Substring(source_name, start, i - start)
            ) {
                return false;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return true;
}

func SemanticCallableCanonicalLookupName(source_name: String) -> String {
    let result: String = "";
    let i: Int = 0;
    while i < StringLength(source_name) {
        let c: String = CharAt(source_name, i);
        if c == "." {
            result = Concat(result, "_");
        } else {
            result = Concat(result, c);
        }
        i = i + 1;
    }
    return result;
}

func SemanticCallableHasLocalSuffix(
    declared_name: String,
    local_name: String
) -> Bool {
    let declared_len: Int = StringLength(declared_name);
    let local_len: Int = StringLength(local_name);
    if local_len == 0 || declared_len <= local_len {
        return false;
    }
    let start: Int = declared_len - local_len;
    return CharAt(declared_name, start - 1) == "_" &&
        Substring(declared_name, start, local_len) == local_name;
}

func SemanticCallableIndex(
    declared_names: Array<String>,
    source_name: String
) -> Option<Int> {
    if !SemanticCallableSourceNameValid(source_name) {
        return None;
    }
    let lookup_name: String =
        SemanticCallableCanonicalLookupName(source_name);
    let exact: Int = -1;
    let exact_count: Int = 0;
    let i: Int = 0;
    while i < ArrayLength(declared_names) {
        if declared_names[i] == lookup_name {
            exact = i;
            exact_count = exact_count + 1;
        }
        i = i + 1;
    }
    if exact_count == 1 {
        return Some(exact);
    }
    if exact_count > 1 {
        return None;
    }
    if StringIndexOf(source_name, ".") >= 0 {
        return None;
    }

    let suffix: Int = -1;
    let suffix_count: Int = 0;
    i = 0;
    while i < ArrayLength(declared_names) {
        if SemanticCallableHasLocalSuffix(declared_names[i], source_name) {
            suffix = i;
            suffix_count = suffix_count + 1;
        }
        i = i + 1;
    }
    if suffix_count == 1 {
        return Some(suffix);
    }
    return None;
}

func SemanticCallableResolutionContractReady() -> Bool {
    let names: Array<String> = [
        "SelfHostPath_IsAbsolute", "SelfHostPath_JoinRelativePath", "Main"
    ];
    let exact: Option<Int> = SemanticCallableIndex(names, "Main");
    let local_match: Option<Int> = SemanticCallableIndex(names, "IsAbsolute");
    let qualified: Option<Int> = SemanticCallableIndex(
        names, "SelfHostPath.JoinRelativePath"
    );
    let ambiguous_names: Array<String> = ["A_Run", "B_Run"];
    return IsSome(exact) && UnwrapOption(exact) == 2 &&
        IsSome(local_match) && UnwrapOption(local_match) == 0 &&
        IsSome(qualified) && UnwrapOption(qualified) == 1 &&
        !IsSome(SemanticCallableIndex(ambiguous_names, "Run"));
}
