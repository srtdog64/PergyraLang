// Canonical caller-visible collection mutation policy.

import "diagnostic_owner.pgy";
import "env_owner.pgy";
import "array_type_shape_owner.pgy";
import "compiler_internal_builtin_caller_registry_owner.pgy";

func SemanticCollectionMutatorName(callee: String) -> Bool {
    return callee == "ArrayDrop" || callee == "CompilerRetireArrayStorage" || callee == "ArrayPush" ||
        callee == "ArraySet" ||
        callee == "ArrayPop" || callee == "ListPush" ||
        callee == "ListSet" || callee == "ListRemove" ||
        callee == "SetAdd" || callee == "SetRemove" ||
        callee == "QueuePush" || callee == "QueuePop" ||
        callee == "MapSet" || callee == "MapRemove";
}

func SemanticCompilerRetireArrayStorageCallerContractReady(
    source_path: String,
    name: String,
    return_type: String,
    param_count: Int,
    param_type: String,
    own_parameter: Bool
) -> Bool {
    return SemanticCompilerInternalBuiltinCallerReady(
        source_path, "CompilerRetireArrayStorage", name, return_type,
        param_count, param_type, own_parameter
    );
}

func SemanticCompilerRetireArrayStorageCallerError(
    internal_caller_ready: Bool
) -> String {
    if internal_caller_ready { return ""; }
    return SemanticError1(
        "compiler_internal_builtin", "name", "CompilerRetireArrayStorage"
    );
}

func SemanticCompilerRetireArrayStorageResolvedError(
    receiver: String, receiver_type: String, mode: String,
    internal_caller_ready: Bool
) -> String {
    let caller_error: String =
        SemanticCompilerRetireArrayStorageCallerError(internal_caller_ready);
    if caller_error != "" { return caller_error; }
    if !IsIdentText(receiver) {
        return SemanticError1(
            "array_drop_storage_requires_binding", "receiver", receiver
        );
    }
    if !StringContains(receiver_type, "Array<") {
        return SemanticError2(
            "array_drop_storage_requires_array", "receiver", receiver,
            "type", receiver_type
        );
    }
    if mode == "default_param" || mode == "ref_param" {
        return SemanticError3(
            "value_param_collection_mutation", "func", "CompilerRetireArrayStorage",
            "param", receiver, "mode", mode
        );
    }
    return "";
}

func SemanticCompilerRetireArrayStorageError(
    receiver: String, names: Slice<String>, types: Slice<String>,
    modes: Slice<String>, internal_caller_ready: Bool
) -> String {
    return SemanticCompilerRetireArrayStorageResolvedError(
        receiver, EnvSliceLookup(names, types, receiver),
        EnvSliceMode(names, modes, receiver), internal_caller_ready);
}

func SemanticPublicArrayDropResolvedError(
    receiver: String, receiver_type: String, mode: String
) -> String {
    if !IsIdentText(receiver) ||
        !IsSome(SemanticArrayElementType(receiver_type)) ||
        mode == "default_param" || mode == "ref_param" || mode == "inout_param" {
        return "ArrayDrop requires one named owned Array<T> binding; borrowed parameters cannot release storage";
    }
    return "";
}

func SemanticPublicArrayDropReceiverError(
    receiver: String, names: Slice<String>, types: Slice<String>,
    modes: Slice<String>
) -> String {
    return SemanticPublicArrayDropResolvedError(
        receiver, EnvSliceLookup(names, types, receiver),
        EnvSliceMode(names, modes, receiver));
}

func SemanticCollectionTypeName(type_name: String) -> Bool {
    return StringContains(type_name, "Array<") ||
        StringContains(type_name, "List<") ||
        StringContains(type_name, "Set<") ||
        StringContains(type_name, "Queue<") ||
        StringContains(type_name, "HashMap<");
}

func SemanticCollectionMutationResolvedError(
    callee: String, receiver: String, receiver_type: String, mode: String,
    internal_caller_ready: Bool
) -> String {
    if callee == "ArrayDrop" {
        return SemanticPublicArrayDropResolvedError(
            receiver, receiver_type, mode);
    }
    if callee == "CompilerRetireArrayStorage" {
        return SemanticCompilerRetireArrayStorageResolvedError(
            receiver, receiver_type, mode, internal_caller_ready
        );
    }
    if !SemanticCollectionMutatorName(callee) || !IsIdentText(receiver) {
        return "";
    }
    if mode != "default_param" && mode != "ref_param" { return ""; }
    if !SemanticCollectionTypeName(receiver_type) { return ""; }
    let mode_name: String = "default";
    if mode == "ref_param" { mode_name = "ref"; }
    return SemanticError3(
        "value_param_collection_mutation", "func", callee,
        "param", receiver, "mode", mode_name
    );
}

func SemanticCollectionMutationError(
    callee: String, receiver: String, names: Slice<String>,
    types: Slice<String>, modes: Slice<String>, internal_caller_ready: Bool
) -> String {
    return SemanticCollectionMutationResolvedError(
        callee, receiver, EnvSliceLookup(names, types, receiver),
        EnvSliceMode(names, modes, receiver), internal_caller_ready);
}

func SemanticCollectionMutationPolicyContractReady() -> Bool {
    return SemanticCollectionMutatorName("CompilerRetireArrayStorage") &&
        SemanticCollectionMutatorName("ArrayPush") &&
        SemanticCollectionMutatorName("MapRemove") &&
        !SemanticCollectionMutatorName("ArrayLength") &&
        SemanticCollectionTypeName("Array<Int>") &&
        StringLength(SemanticCollectionMutationResolvedError(
            "ArrayPush", "xs", "Array<Int>", "default_param", false
        )) > 0 && StringLength(SemanticCollectionMutationResolvedError(
            "ArrayPush", "xs", "Array<Int>", "ref_param", false
        )) > 0 && StringLength(SemanticCollectionMutationResolvedError(
            "ArraySet", "xs", "Array<Int>", "ref_param", false
        )) > 0 && SemanticCollectionMutationResolvedError(
            "ArrayLength", "xs", "Array<Int>", "ref_param", false
        ) == "" && StringLength(SemanticCollectionMutationResolvedError(
            "ListPush", "xs", "List<Int>", "ref_param", false
        )) > 0 && SemanticCollectionMutationResolvedError(
            "ArrayPush", "xs", "Array<Int>", "inout_param", false
        ) == "" && StringLength(
            SemanticCompilerRetireArrayStorageResolvedError(
                "xs", "Array<Int>", "ref_param", true
            )
        ) > 0 && SemanticCompilerRetireArrayStorageResolvedError(
            "xs", "Array<Int>", "local", true
        ) == "" && StringLength(
            SemanticCompilerRetireArrayStorageResolvedError(
                "xs", "Array<Int>", "local", false
            )
        ) > 0;
}
