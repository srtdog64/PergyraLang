// Canonical caller-visible collection mutation policy.

import "diagnostic_owner.pgy";
import "env_owner.pgy";
import "compiler_internal_builtin_caller_registry_owner.pgy";

func SemanticCollectionMutatorName(callee: String) -> Bool {
    return callee == "CompilerRetireArrayStorage" || callee == "ArrayPush" ||
        callee == "ArraySet" ||
        callee == "ArrayPop" || callee == "ListPush" ||
        callee == "ListSet" || callee == "ListRemove" ||
        callee == "SetAdd" || callee == "SetRemove" ||
        callee == "QueuePush" || callee == "QueuePop" ||
        callee == "MapSet" || callee == "MapRemove";
}

func SemanticCompilerRetireArrayStorageCallerContractReady(
    source_path: String,
    name: String,
    return_type: String,
    param_count: Int,
    param_type: String,
    own_parameter: Bool
) -> Bool {
    return SemanticCompilerInternalBuiltinCallerReady(
        source_path, "CompilerRetireArrayStorage", name, return_type,
        param_count, param_type, own_parameter
    );
}

func SemanticCompilerRetireArrayStorageCallerError(
    internal_caller_ready: Bool
) -> String {
    if internal_caller_ready { return ""; }
    return SemanticError1(
        "compiler_internal_builtin", "name", "CompilerRetireArrayStorage"
    );
}

func SemanticCompilerRetireArrayStorageError(
    receiver: String,
    names: Array<String>,
    types: Array<String>,
    modes: Array<String>,
    internal_caller_ready: Bool
) -> String {
    let caller_error: String =
        SemanticCompilerRetireArrayStorageCallerError(internal_caller_ready);
    if caller_error != "" { return caller_error; }
    if !IsIdentText(receiver) {
        return SemanticError1(
            "array_drop_storage_requires_binding", "receiver", receiver
        );
    }
    let receiver_type: String = EnvLookup(names, types, receiver);
    if !StringContains(receiver_type, "Array<") {
        return SemanticError2(
            "array_drop_storage_requires_array", "receiver", receiver,
            "type", receiver_type
        );
    }
    let mode: String = EnvMode(names, modes, receiver);
    if mode == "default_param" || mode == "ref_param" {
        return SemanticError3(
            "value_param_collection_mutation", "func", "CompilerRetireArrayStorage",
            "param", receiver, "mode", mode
        );
    }
    return "";
}

func SemanticCollectionTypeName(type_name: String) -> Bool {
    return StringContains(type_name, "Array<") ||
        StringContains(type_name, "List<") ||
        StringContains(type_name, "Set<") ||
        StringContains(type_name, "Queue<") ||
        StringContains(type_name, "HashMap<");
}

func SemanticCollectionMutationError(
    callee: String,
    receiver: String,
    names: Array<String>,
    types: Array<String>,
    modes: Array<String>,
    internal_caller_ready: Bool
) -> String {
    if callee == "CompilerRetireArrayStorage" {
        return SemanticCompilerRetireArrayStorageError(
            receiver, names, types, modes, internal_caller_ready
        );
    }
    if !SemanticCollectionMutatorName(callee) ||
        !IsIdentText(receiver) ||
        EnvMode(names, modes, receiver) != "default_param" {
        return "";
    }
    let receiver_type: String = EnvLookup(names, types, receiver);
    if !SemanticCollectionTypeName(receiver_type) { return ""; }
    return SemanticError3(
        "value_param_collection_mutation", "func", callee,
        "param", receiver, "mode", "default"
    );
}

func SemanticCollectionMutationPolicyContractReady() -> Bool {
    return SemanticCollectionMutatorName("CompilerRetireArrayStorage") &&
        SemanticCollectionMutatorName("ArrayPush") &&
        SemanticCollectionMutatorName("MapRemove") &&
        !SemanticCollectionMutatorName("ArrayLength") &&
        SemanticCollectionTypeName("Array<Int>") &&
        StringLength(SemanticCollectionMutationError(
            "ArrayPush", "xs", ["xs"], ["Array<Int>"],
            ["default_param"], false
        )) > 0 && SemanticCollectionMutationError(
            "ArrayPush", "xs", ["xs"], ["Array<Int>"], ["inout_param"],
            false
        ) == "" && StringLength(SemanticCompilerRetireArrayStorageError(
            "xs", ["xs"], ["Array<Int>"], ["ref_param"], true
        )) > 0 && SemanticCompilerRetireArrayStorageError(
            "xs", ["xs"], ["Array<Int>"], ["local"], true
        ) == "" && StringLength(SemanticCompilerRetireArrayStorageError(
            "xs", ["xs"], ["Array<Int>"], ["local"], false
        )) > 0;
}
