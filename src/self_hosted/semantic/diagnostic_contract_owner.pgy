// Executable payload and vocabulary contract for semantic diagnostics.

import "diagnostic_owner.pgy";
import "public_diagnostic_receipt_owner.pgy";

func SemanticVerdictPayloadStatusReady() -> Bool {
    let ok: String = SemanticOk();
    if StringIndexOf(ok, "Diagnostic: pgy.selfhost.semantic.v1") != 0 {
        return false;
    }
    if StringIndexOf(ok, "Status: ok") < 0 {
        return false;
    }

    let err: String = SemanticError1("undefined_symbol", "name", "x");
    if StringIndexOf(err, "Status: error") < 0 {
        return false;
    }
    if StringIndexOf(err, "Stage: semantic") < 0 {
        return false;
    }
    if StringIndexOf(err, "Code: undefined_symbol") < 0 {
        return false;
    }
    return true;
}

func SemanticPublicDiagnosticReceiptMessageIndependenceReady() -> Bool {
    let first: SemanticPublicDiagnosticReceipt =
        SemanticPublicDiagnosticReceiptFromOwnedFacts(
            "undefined_function", "first wording"
        );
    let second: SemanticPublicDiagnosticReceipt =
        SemanticPublicDiagnosticReceiptFromOwnedFacts(
            "undefined_function", "second wording"
        );
    let return_first: SemanticPublicDiagnosticReceipt =
        SemanticPublicDiagnosticReceiptFromOwnedFacts(
            "return_type_mismatch", "first return wording"
        );
    let return_second: SemanticPublicDiagnosticReceipt =
        SemanticPublicDiagnosticReceiptFromOwnedFacts(
            "return_type_mismatch", "second return wording"
        );
    return SemanticPublicDiagnosticReceiptReadyFor(
            first, "undefined_function"
        ) && SemanticPublicDiagnosticReceiptReadyFor(
            second, "undefined_function"
        ) && SemanticPublicDiagnosticReceiptReadyFor(
            return_first, "return_type_mismatch"
        ) && SemanticPublicDiagnosticReceiptReadyFor(
            return_second, "return_type_mismatch"
        ) && first.schema == second.schema &&
        first.stage == second.stage && first.layer == second.layer &&
        first.code == second.code && first.cause_ir == second.cause_ir &&
        first.fix_source == second.fix_source &&
        first.message != second.message &&
        return_first.schema == return_second.schema &&
        return_first.stage == return_second.stage &&
        return_first.layer == return_second.layer &&
        return_first.code == return_second.code &&
        return_first.cause_ir == return_second.cause_ir &&
        return_first.fix_source == return_second.fix_source &&
        return_first.message != return_second.message;
}

func SemanticVerdictPayloadContractReady() -> Bool {
    if SemanticVerdictPayloadSchema() != "pgy.selfhost.semantic.v1" {
        return false;
    }
    if SemanticVerdictPayloadFixtureCount() != SemanticVerdictPayloadFixtureFrontierCount() {
        return false;
    }
    if SemanticDiagnosticCodeCount() != 36 {
        return false;
    }
    if ArrayLength(SemanticDiagnosticVocabularyRows()) != SemanticDiagnosticCodeCount() {
        return false;
    }
    if ArrayLength(SemanticDiagnosticSurfaceAuditFindings()) != 0 {
        return false;
    }
    if !SemanticVerdictPayloadStatusReady() {
        return false;
    }
    if !SemanticPublicDiagnosticReceiptMessageIndependenceReady() {
        return false;
    }
    return true;
}
