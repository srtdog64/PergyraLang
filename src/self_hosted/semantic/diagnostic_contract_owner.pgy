// Executable payload and vocabulary contract for semantic diagnostics.

import "diagnostic_owner.pgy";
import "public_diagnostic_receipt_owner.pgy";

func SemanticVerdictPayloadStatusReady() -> Bool {
    let ok: String = SemanticOk();
    if StringIndexOf(ok, "Diagnostic: pgy.selfhost.semantic.v1") != 0 {
        return false;
    }
    if StringIndexOf(ok, "Status: ok") < 0 {
        return false;
    }

    let err: String = SemanticError1("undefined_symbol", "name", "x");
    if StringIndexOf(err, "Status: error") < 0 {
        return false;
    }
    if StringIndexOf(err, "Stage: semantic") < 0 {
        return false;
    }
    if StringIndexOf(err, "Code: undefined_symbol") < 0 {
        return false;
    }
    return true;
}

func SemanticPublicDiagnosticReceiptMessageIndependenceReady() -> Bool {
    let first: SemanticPublicDiagnosticReceipt =
        SemanticPublicDiagnosticReceiptFromOwnedFacts(
            "undefined_function", "first wording"
        );
    let second: SemanticPublicDiagnosticReceipt =
        SemanticPublicDiagnosticReceiptFromOwnedFacts(
            "undefined_function", "second wording"
        );
    let return_first: SemanticPublicDiagnosticReceipt =
        SemanticPublicDiagnosticReceiptFromOwnedFacts(
            "return_type_mismatch", "first return wording"
        );
    let return_second: SemanticPublicDiagnosticReceipt =
        SemanticPublicDiagnosticReceiptFromOwnedFacts(
            "return_type_mismatch", "second return wording"
        );
    let let_first: SemanticPublicDiagnosticReceipt =
        SemanticPublicDiagnosticReceiptFromOwnedFacts(
            "let_type_mismatch", "first let wording"
        );
    let let_second: SemanticPublicDiagnosticReceipt =
        SemanticPublicDiagnosticReceiptFromOwnedFacts(
            "let_type_mismatch", "second let wording"
        );
    let logical_first: SemanticPublicDiagnosticReceipt =
        SemanticPublicDiagnosticReceiptFromOwnedFacts(
            "logical_operand_not_bool", "first logical wording"
        );
    let logical_second: SemanticPublicDiagnosticReceipt =
        SemanticPublicDiagnosticReceiptFromOwnedFacts(
            "logical_operand_not_bool", "second logical wording"
        );
    let condition_first: SemanticPublicDiagnosticReceipt =
        SemanticPublicDiagnosticReceiptFromOwnedFacts(
            "condition_not_bool", "first condition wording"
        );
    let condition_second: SemanticPublicDiagnosticReceipt =
        SemanticPublicDiagnosticReceiptFromOwnedFacts(
            "condition_not_bool", "second condition wording"
        );
    let unary_first: SemanticPublicDiagnosticReceipt =
        SemanticPublicDiagnosticReceiptFromOwnedFacts(
            "not_operand_not_bool", "first unary wording"
        );
    let unary_second: SemanticPublicDiagnosticReceipt =
        SemanticPublicDiagnosticReceiptFromOwnedFacts(
            "not_operand_not_bool", "second unary wording"
        );
    let compare_first: SemanticPublicDiagnosticReceipt =
        SemanticPublicDiagnosticReceiptFromOwnedFacts(
            "compare_type_mismatch", "first compare wording"
        );
    let compare_second: SemanticPublicDiagnosticReceipt =
        SemanticPublicDiagnosticReceiptFromOwnedFacts(
            "compare_type_mismatch", "second compare wording"
        );
    return SemanticPublicDiagnosticReceiptReadyFor(
            first, "undefined_function"
        ) && SemanticPublicDiagnosticReceiptReadyFor(
            second, "undefined_function"
        ) && SemanticPublicDiagnosticReceiptReadyFor(
            return_first, "return_type_mismatch"
        ) && SemanticPublicDiagnosticReceiptReadyFor(
            return_second, "return_type_mismatch"
        ) && SemanticPublicDiagnosticReceiptReadyFor(
            let_first, "let_type_mismatch"
        ) && SemanticPublicDiagnosticReceiptReadyFor(
            let_second, "let_type_mismatch"
        ) && SemanticPublicDiagnosticReceiptReadyFor(
            logical_first, "logical_operand_not_bool"
        ) && SemanticPublicDiagnosticReceiptReadyFor(
            logical_second, "logical_operand_not_bool"
        ) && SemanticPublicDiagnosticReceiptReadyFor(
            condition_first, "condition_not_bool"
        ) && SemanticPublicDiagnosticReceiptReadyFor(
            condition_second, "condition_not_bool"
        ) && SemanticPublicDiagnosticReceiptReadyFor(
            unary_first, "not_operand_not_bool"
        ) && SemanticPublicDiagnosticReceiptReadyFor(
            unary_second, "not_operand_not_bool"
        ) && SemanticPublicDiagnosticReceiptReadyFor(
            compare_first, "compare_type_mismatch"
        ) && SemanticPublicDiagnosticReceiptReadyFor(
            compare_second, "compare_type_mismatch"
        ) && first.schema == second.schema &&
        first.stage == second.stage && first.layer == second.layer &&
        first.code == second.code && first.cause_ir == second.cause_ir &&
        first.fix_source == second.fix_source &&
        first.message != second.message &&
        return_first.schema == return_second.schema &&
        return_first.stage == return_second.stage &&
        return_first.layer == return_second.layer &&
        return_first.code == return_second.code &&
        return_first.cause_ir == return_second.cause_ir &&
        return_first.fix_source == return_second.fix_source &&
        return_first.message != return_second.message &&
        let_first.schema == let_second.schema &&
        let_first.stage == let_second.stage &&
        let_first.layer == let_second.layer &&
        let_first.code == let_second.code &&
        let_first.cause_ir == let_second.cause_ir &&
        let_first.fix_source == let_second.fix_source &&
        let_first.message != let_second.message &&
        logical_first.schema == logical_second.schema &&
        logical_first.stage == logical_second.stage &&
        logical_first.layer == logical_second.layer &&
        logical_first.code == logical_second.code &&
        logical_first.cause_ir == logical_second.cause_ir &&
        logical_first.fix_source == logical_second.fix_source &&
        logical_first.message != logical_second.message &&
        condition_first.schema == condition_second.schema &&
        condition_first.stage == condition_second.stage &&
        condition_first.layer == condition_second.layer &&
        condition_first.code == condition_second.code &&
        condition_first.cause_ir == condition_second.cause_ir &&
        condition_first.fix_source == condition_second.fix_source &&
        condition_first.message != condition_second.message &&
        unary_first.schema == unary_second.schema &&
        unary_first.stage == unary_second.stage &&
        unary_first.layer == unary_second.layer &&
        unary_first.code == unary_second.code &&
        unary_first.cause_ir == unary_second.cause_ir &&
        unary_first.fix_source == unary_second.fix_source &&
        unary_first.message != unary_second.message &&
        compare_first.schema == compare_second.schema &&
        compare_first.stage == compare_second.stage &&
        compare_first.layer == compare_second.layer &&
        compare_first.code == compare_second.code &&
        compare_first.cause_ir == compare_second.cause_ir &&
        compare_first.fix_source == compare_second.fix_source &&
        compare_first.message != compare_second.message;
}

func SemanticVerdictPayloadContractReady() -> Bool {
    if SemanticVerdictPayloadSchema() != "pgy.selfhost.semantic.v1" {
        return false;
    }
    if SemanticVerdictPayloadFixtureCount() != SemanticVerdictPayloadFixtureFrontierCount() {
        return false;
    }
    if SemanticDiagnosticCodeCount() != 36 {
        return false;
    }
    if ArrayLength(SemanticDiagnosticVocabularyRows()) != SemanticDiagnosticCodeCount() {
        return false;
    }
    if ArrayLength(SemanticDiagnosticSurfaceAuditFindings()) != 0 {
        return false;
    }
    if !SemanticVerdictPayloadStatusReady() {
        return false;
    }
    if !SemanticPublicDiagnosticReceiptMessageIndependenceReady() {
        return false;
    }
    return true;
}
