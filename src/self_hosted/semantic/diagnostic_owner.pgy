// Self-host semantic diagnostic rendering owner.

import "../lib/diagnostic.pgy";
import "../lib/json_fact_table.pgy";
import "diagnostic_code_owner.pgy";

struct SemanticDiagnosticMessageFact {
    present: Bool;
    code: String;
    first_key: String;
    first_value: String;
    second_key: String;
    second_value: String;
}

func SemanticDiagnosticMessageFactEmpty() -> SemanticDiagnosticMessageFact {
    return SemanticDiagnosticMessageFact(false, "", "", "", "", "");
}

func SemanticDiagnosticMessageFact2(
    code: String,
    first_key: String,
    first_value: String,
    second_key: String,
    second_value: String
) -> SemanticDiagnosticMessageFact {
    return SemanticDiagnosticMessageFact(
        true, code, first_key, first_value, second_key, second_value
    );
}

func SemanticDiagnosticMessageFactRender(
    fact: SemanticDiagnosticMessageFact
) -> String {
    if !fact.present {
        return "";
    }
    return SemanticError2(
        fact.code,
        fact.first_key, fact.first_value,
        fact.second_key, fact.second_value
    );
}

func SemanticReason(code: String) -> String {
    if code == "undefined_symbol" {
        return "identifier is used before a local binding is in scope";
    }
    if code == "logical_operand_not_bool" {
        return "logical operators require Bool operands";
    }
    if code == "not_operand_not_bool" {
        return "logical not requires a Bool operand";
    }
    if code == "compare_type_mismatch" {
        return "comparison operands must have the same type";
    }
    if code == "binop_type_mismatch" {
        return "arithmetic operands must have the same type";
    }
    if code == "array_index_type_mismatch" {
        return "array access requires an Int index";
    }
    if code == "call_arg_type_mismatch" || code == "member_call_arg_type_mismatch" {
        return "call argument type does not match the callee parameter type";
    }
    if code == "named_value_boundary_argument_required" { return "borrow-tracked value boundaries require one stable source binding"; }
    if code == "zone_value_copy_requires_transfer" || code == "zone_value_reassignment_requires_transfer" || code == "zone_value_parameter_requires_transfer" { return "zone identity cannot be carried without an admitted transfer plan"; }
    if code == "builtin_arg_type_mismatch" { return "builtin argument type does not match the builtin contract"; }
    if code == "option_concrete_type_required" {
        return "Option builtin requires a concrete Option<T> payload type";
    }
    if code == "value_param_collection_mutation" {
        return "caller-visible collection mutation requires an explicit inout boundary";
    }
    if code == "undefined_function" {
        return "called function is not declared in the checked subset";
    }
    if code == "call_arity_mismatch" {
        return "call argument count does not match the callee parameter count";
    }
    if code == "generic_argument_count_mismatch" { return "explicit generic argument count does not match the callable generic parameters"; }
    if code == "generic_argument_type_invalid" { return "explicit generic argument is missing or malformed"; }
    if code == "let_type_mismatch" {
        return "let initializer type does not match the declared local type";
    }
    if code == "return_type_mismatch" {
        return "return expression type does not match the function return type";
    }
    if code == "condition_not_bool" {
        return "branch condition must be Bool";
    }
    if code == "assign_type_mismatch" {
        return "assigned expression type does not match the local type";
    }
    if code == "ast_artifact_invalid" {
        return "parser-owned AST artifact does not satisfy the shared HIR contract";
    }
    if code == "entrypoint_cardinality" {
        return "program entrypoint cardinality does not match the compilation boundary";
    }
    if code == "function_signature_invalid" {
        return "function signature rows are incomplete in the shared AST artifact";
    }
    if code == "input_missing" {
        return "semantic checker requires a source path argument";
    }
    if code == "local_binding_invalid" {
        return "local binding facts are incomplete in the shared AST artifact";
    }
    if code == "initializer_type_unresolved" {
        return "initializer type cannot be resolved from semantic artifact facts";
    }
    if code == "assignment_type_unresolved" {
        return "assignment type cannot be resolved from semantic artifact facts";
    }
    if code == "statement_type_unresolved" {
        return "statement expression type cannot be resolved from semantic artifact facts";
    }
    if code == "array_drop_storage_arity" {
        return "compiler storage retirement requires exactly one array binding";
    }
    if code == "array_drop_storage_requires_array" {
        return "compiler storage retirement requires an Array<T> receiver";
    }
    if code == "array_drop_storage_requires_binding" {
        return "compiler storage retirement requires a named owned binding";
    }
    if code == "compiler_internal_builtin" {
        return "compiler-internal builtin is unavailable outside its admitted owner";
    }
    if code == "destructure_binding_invalid" {
        return "destructure binding facts are incomplete or ambiguous";
    }
    if code == "destructure_initializer_not_array" {
        return "destructure initializer does not provide the required array element";
    }
    if code == "intent_signature_invalid" {
        return "intent signature facts are incomplete or ambiguous";
    }
    if code == "parse_syntax" {
        return "source syntax is incomplete or malformed";
    }
    if code == "unregistered_diagnostic_code" {
        return "semantic diagnostic code is not registered in the code owner";
    }
    return "semantic checker rejected the source";
}
func SemanticFix(code: String) -> String {
    if code == "undefined_symbol" {
        return "declare the local before use or pass it as a parameter";
    }
    if code == "logical_operand_not_bool" {
        return "convert the operand to Bool or compare it explicitly before using && or ||";
    }
    if code == "not_operand_not_bool" {
        return "apply ! only to a Bool expression";
    }
    if code == "compare_type_mismatch" {
        return "compare values with matching types";
    }
    if code == "binop_type_mismatch" {
        return "use operands with matching arithmetic types";
    }
    if code == "array_index_type_mismatch" {
        return "use an Int expression for the array index";
    }
    if code == "call_arg_type_mismatch" || code == "member_call_arg_type_mismatch" {
        return "change the argument expression or the callee parameter type";
    }
    if code == "named_value_boundary_argument_required" { return "bind the value to a local variable before passing it through the boundary"; }
    if code == "zone_value_copy_requires_transfer" || code == "zone_value_reassignment_requires_transfer" || code == "zone_value_parameter_requires_transfer" { return "construct a fresh zone or use an explicit admitted transfer boundary"; }
    if code == "builtin_arg_type_mismatch" {
        return "pass a value that satisfies the builtin signature";
    }
    if code == "option_concrete_type_required" {
        return "annotate the None value or pass a concretely typed Option<T>";
    }
    if code == "value_param_collection_mutation" {
        return "spell the parameter as inout or mutate a local collection and return it";
    }
    if code == "undefined_function" {
        return "declare the function before calling it";
    }
    if code == "call_arity_mismatch" {
        return "pass the declared number of arguments";
    }
    if code == "generic_argument_count_mismatch" { return "pass one explicit type argument for each generic parameter"; }
    if code == "generic_argument_type_invalid" { return "replace the malformed generic argument with a concrete type"; }
    if code == "let_type_mismatch" {
        return "change the initializer or the declared local type";
    }
    if code == "return_type_mismatch" {
        return "return the declared function result type";
    }
    if code == "condition_not_bool" {
        return "use a Bool expression for the condition";
    }
    if code == "assign_type_mismatch" {
        return "assign a value that matches the local type";
    }
    if code == "ast_artifact_invalid" {
        return "repair the parser artifact producer instead of reconstructing syntax downstream";
    }
    if code == "entrypoint_cardinality" {
        return "declare exactly one Main function for an executable program";
    }
    if code == "function_signature_invalid" {
        return "repair the parser-owned function signature fact instead of inferring it in codegen";
    }
    if code == "input_missing" {
        return "pass the source path as Args()[0]";
    }
    if code == "local_binding_invalid" {
        return "repair the parser-owned local binding fact instead of inferring it in codegen";
    }
    if code == "initializer_type_unresolved" {
        return "add the missing signature or type fact instead of guessing in the backend";
    }
    if code == "assignment_type_unresolved" {
        return "add the missing scope or expression type fact instead of guessing in the backend";
    }
    if code == "statement_type_unresolved" {
        return "add the missing statement environment or expression fact instead of guessing in the backend";
    }
    if code == "array_drop_storage_arity" {
        return "pass exactly one named owned Array<T> binding";
    }
    if code == "array_drop_storage_requires_array" {
        return "bind an Array<T> value before invoking compiler storage retirement";
    }
    if code == "array_drop_storage_requires_binding" {
        return "move the array into a named owned binding before retiring its storage";
    }
    if code == "compiler_internal_builtin" {
        return "remove the call outside the admitted compiler storage lifetime owner";
    }
    if code == "destructure_binding_invalid" {
        return "repair the parser-owned destructure pattern, scope, or binding facts";
    }
    if code == "destructure_initializer_not_array" {
        return "destructure an array value with a compatible element position";
    }
    if code == "intent_signature_invalid" {
        return "repair the parser-owned intent name, parameters, or result signature";
    }
    if code == "parse_syntax" {
        return "complete the missing syntax before semantic analysis";
    }
    if code == "unregistered_diagnostic_code" {
        return "add the code to diagnostic_code_owner before emitting it";
    }
    return "fix the semantic mismatch reported by the diagnostic code";
}
func SemanticOk() -> String {
    return SelfHostDiagnostic_RenderOk("pgy.selfhost.semantic.v1");
}

func SemanticVerdictPayloadSchema() -> String {
    return "pgy.selfhost.semantic.v1";
}

func SemanticVerdictPayloadFixtureCount() -> Int {
    return ArrayLength(SemanticVerdictPayloadFixtureManifestRows());
}

func SemanticVerdictPayloadFixtureFrontierCount() -> Int {
    return 115;
}

func SemanticVerdictPayloadFixtureDir() -> String {
    return "src/self_hosted/semantic/fixture";
}

func SemanticVerdictPayloadExpectedDir() -> String {
    return "src/self_hosted/semantic/expected";
}

func SemanticVerdictPayloadPathEndsWith(path: String, suffix: String) -> Bool {
    let path_len: Int = StringLength(path);
    let suffix_len: Int = StringLength(suffix);
    if suffix_len > path_len {
        return false;
    }
    return Substring(path, path_len - suffix_len, suffix_len) == suffix;
}

func SemanticVerdictPayloadBaseName(path: String, suffix: String) -> Option<String> {
    if !SemanticVerdictPayloadPathEndsWith(path, suffix) {
        return None;
    }
    let last_slash: Int = -1;
    let i: Int = 0;
    while i < StringLength(path) {
        if Substring(path, i, 1) == "/" {
            last_slash = i;
        }
        i = i + 1;
    }
    let start: Int = last_slash + 1;
    let len: Int = StringLength(path) - start - StringLength(suffix);
    if len <= 0 {
        return None;
    }
    return Some(Substring(path, start, len));
}

func SemanticVerdictPayloadExpectedPath(base: String) -> String {
    return Concat(Concat(SemanticVerdictPayloadExpectedDir(), "/"), Concat(base, ".diag"));
}

func SemanticVerdictPayloadExpectedStatus(base: String) -> Option<String> {
    let expected_path: String = SemanticVerdictPayloadExpectedPath(base);
    if !FileExists(expected_path) {
        return None;
    }
    let content: String = ReadFile(expected_path);
    if StringIndexOf(content, "Status: ok") >= 0 {
        return Some("ok");
    }
    if StringIndexOf(content, "Status: error") >= 0 {
        return Some("error");
    }
    return None;
}

func SemanticDiagnosticLineStartsWith(line: String, prefix: String) -> Bool {
    if StringLength(line) < StringLength(prefix) {
        return false;
    }
    return Substring(line, 0, StringLength(prefix)) == prefix;
}

func SemanticExpectedDiagnosticCode(base: String) -> Option<String> {
    let expected_path: String = SemanticVerdictPayloadExpectedPath(base);
    if !FileExists(expected_path) {
        return None;
    }
    let lines: Array<String> = Split(ReadFile(expected_path), "\n");
    let prefix: String = "Code: ";
    let i: Int = 0;
    while i < ArrayLength(lines) {
        let line: String = lines[i];
        if SemanticDiagnosticLineStartsWith(line, prefix) {
            let value: String = Substring(line, StringLength(prefix), StringLength(line) - StringLength(prefix));
            if StringLength(value) > 0 && Substring(value, StringLength(value) - 1, 1) == "\r" {
                return Some(Substring(value, 0, StringLength(value) - 1));
            }
            return Some(value);
        }
        i = i + 1;
    }
    return None;
}

func SemanticVerdictPayloadFixtureManifestRow(base: String, status: String) -> String {
    let code: String = "";
    let oracle: String = "";
    if status == "error" {
        let code_opt: Option<String> = SemanticExpectedDiagnosticCode(base);
        if IsSome(code_opt) {
            code = UnwrapOption(code_opt);
            oracle = SemanticDiagnosticOracleCode(code);
        }
    }
    let left: String = Concat(Concat(base, ":"), status);
    let right: String = Concat(Concat(code, ":"), oracle);
    return Concat(Concat(left, ":"), right);
}

func SemanticVerdictPayloadFixtureManifestRows() -> Array<String> {
    let entries: Array<String> = DirWalk(SemanticVerdictPayloadFixtureDir());
    let rows: Array<String> = [];
    let i: Int = 0;
    while i < ArrayLength(entries) {
        let path: String = entries[i];
        if SemanticVerdictPayloadPathEndsWith(path, ".pgy") {
            let base_opt: Option<String> = SemanticVerdictPayloadBaseName(path, ".pgy");
            if IsSome(base_opt) {
                let base: String = UnwrapOption(base_opt);
                let status_opt: Option<String> = SemanticVerdictPayloadExpectedStatus(base);
                if IsSome(status_opt) {
                    let status: String = UnwrapOption(status_opt);
                    ArrayPush(rows, SemanticVerdictPayloadFixtureManifestRow(base, status));
                }
            }
        }
        i = i + 1;
    }
    return rows;
}

func EmitSemanticVerdictPayloadFixtureManifest() -> Void {
    let rows: Array<String> = SemanticVerdictPayloadFixtureManifestRows();
    let i: Int = 0;
    while i < ArrayLength(rows) {
        Log(rows[i]);
        i = i + 1;
    }
}

func SemanticDiagnosticCodeRendered(code: String) -> Bool {
    if SemanticReason(code) == "semantic checker rejected the source" {
        return false;
    }
    if SemanticFix(code) == "fix the semantic mismatch reported by the diagnostic code" {
        return false;
    }
    return true;
}

func SemanticDiagnosticVocabularyRow(code: String) -> String {
    let oracle: String = SemanticDiagnosticOracleCode(code);
    let rendered: String = "missing-renderer";
    if SemanticDiagnosticCodeRendered(code) {
        rendered = "rendered";
    }
    let left: String = Concat(Concat(code, "|"), oracle);
    return Concat(Concat(left, "|"), rendered);
}

func SemanticDiagnosticVocabularyRows() -> Array<String> {
    let codes: Array<String> = SemanticDiagnosticCodes();
    let rows: Array<String> = [];
    let i: Int = 0;
    while i < ArrayLength(codes) {
        ArrayPush(rows, SemanticDiagnosticVocabularyRow(codes[i]));
        i = i + 1;
    }
    return rows;
}
func SemanticDiagnosticCodeFromMessage(message: String) -> Option<String> {
    let codes: Array<String> = SemanticDiagnosticCodes();
    let i: Int = 0;
    while i < ArrayLength(codes) {
        if StringContains(message, Concat("Code: ", codes[i])) {
            return Some(codes[i]);
        }
        i = i + 1;
    }
    return None;
}

func EmitSemanticDiagnosticVocabularyManifest() -> Void {
    let rows: Array<String> = SemanticDiagnosticVocabularyRows();
    let i: Int = 0;
    while i < ArrayLength(rows) {
        Log(rows[i]);
        i = i + 1;
    }
}

func SemanticDiagnosticCodeDuplicate(code: String, codes: Array<String>, end: Int) -> Bool {
    let seen: Bool = false;
    let i: Int = 0;
    while i < end {
        if codes[i] == code {
            return true;
        }
        i = i + 1;
    }
    return seen;
}

func SemanticDiagnosticCallCodesFromContent(content: String) -> Array<String> {
    let codes: Array<String> = [];
    let rest: String = content;
    while StringLength(rest) > 0 {
        let mark: Int = StringIndexOf(rest, "SemanticError");
        if mark < 0 {
            return codes;
        }
        let after: String = Substring(rest, mark, StringLength(rest) - mark);
        let open: Int = StringIndexOf(after, "(");
        if open < 0 {
            return codes;
        }
        if open + 1 < StringLength(after) && Substring(after, open + 1, 1) == "\"" {
            let literal_tail: String = Substring(after, open + 2, StringLength(after) - open - 2);
            let close: Int = StringIndexOf(literal_tail, "\"");
            if close > 0 {
                ArrayPush(codes, Substring(literal_tail, 0, close));
            }
        }
        let next: Int = mark + open + 1;
        if next >= StringLength(rest) {
            return codes;
        }
        rest = Substring(rest, next, StringLength(rest) - next);
    }
    return codes;
}

func SemanticSourceDiagnosticCallCodes() -> Array<String> {
    let entries: Array<String> = DirWalk("src/self_hosted/semantic");
    let codes: Array<String> = [];
    let i: Int = 0;
    while i < ArrayLength(entries) {
        let path: String = entries[i];
        if SemanticVerdictPayloadPathEndsWith(path, ".pgy") {
            let found: Array<String> = SemanticDiagnosticCallCodesFromContent(ReadFile(path));
            let j: Int = 0;
            while j < ArrayLength(found) {
                ArrayPush(codes, found[j]);
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return codes;
}

func SemanticExpectedDiagnosticCodes() -> Array<String> {
    let rows: Array<String> = SemanticVerdictPayloadFixtureManifestRows();
    let codes: Array<String> = [];
    let i: Int = 0;
    while i < ArrayLength(rows) {
        let parts: Array<String> = Split(rows[i], ":");
        if ArrayLength(parts) >= 4 && parts[1] == "error" {
            ArrayPush(codes, parts[2]);
        }
        i = i + 1;
    }
    return codes;
}

func SemanticDiagnosticSurfaceAuditFindings() -> Array<String> {
    let findings: Array<String> = [];
    let codes: Array<String> = SemanticDiagnosticCodes();
    let i: Int = 0;
    while i < ArrayLength(codes) {
        let code: String = codes[i];
        if SemanticDiagnosticCodeDuplicate(code, codes, i) {
            ArrayPush(findings, Concat("duplicate-code|", code));
        }
        if !SemanticDiagnosticCodeRendered(code) {
            ArrayPush(findings, Concat("missing-renderer|", code));
        }
        i = i + 1;
    }

    let expected_codes: Array<String> = SemanticExpectedDiagnosticCodes();
    i = 0;
    while i < ArrayLength(expected_codes) {
        let expected_code: String = expected_codes[i];
        if !SemanticDiagnosticCodeKnown(expected_code) {
            ArrayPush(findings, Concat("fixture-unregistered|", expected_code));
        } else if StringLength(SemanticDiagnosticOracleCode(expected_code)) == 0 {
            ArrayPush(findings, Concat("fixture-missing-oracle|", expected_code));
        }
        i = i + 1;
    }

    let call_codes: Array<String> = SemanticSourceDiagnosticCallCodes();
    i = 0;
    while i < ArrayLength(call_codes) {
        let call_code: String = call_codes[i];
        if !SemanticDiagnosticCodeKnown(call_code) {
            ArrayPush(findings, Concat("callsite-unregistered|", call_code));
        }
        i = i + 1;
    }
    return findings;
}

func EmitSemanticDiagnosticSurfaceAudit() -> Void {
    let findings: Array<String> = SemanticDiagnosticSurfaceAuditFindings();
    if ArrayLength(findings) == 0 {
        Log("ok");
        return;
    }
    let i: Int = 0;
    while i < ArrayLength(findings) {
        Log(findings[i]);
        i = i + 1;
    }
    Exit(1);
}

func SemanticOracleJsonRootFact(content: String) -> JsonObjectFactTable {
    let i: Int = 0;
    let n: Int = StringLength(content);
    while i < n {
        if Substring(content, i, 1) == "{" {
            let candidate: String = Substring(content, i, n - i);
            let root: JsonObjectFactTable = JsonDocumentObjectFactTable(candidate);
            if JsonObjectFactTableReady(root) {
                return root;
            }
        }
        i = i + 1;
    }
    return EmptyJsonObjectFactTable();
}

func SemanticOracleJsonCodeFromContent(content: String) -> Option<String> {
    let root: JsonObjectFactTable = SemanticOracleJsonRootFact(content);
    if !JsonObjectFactTableReady(root) {
        return None;
    }
    let code_opt: Option<String> = JsonObjectFactStringFieldOpt(root, "code");
    if !IsSome(code_opt) {
        return None;
    }
    return code_opt;
}

func EmitSemanticOracleJsonCodeMatch(path: String, expected: String) -> Void {
    if !FileExists(path) {
        Log(Concat("input-error|", path));
        Exit(1);
        return;
    }
    let actual_opt: Option<String> = SemanticOracleJsonCodeFromContent(ReadFile(path));
    if !IsSome(actual_opt) {
        Log(Concat(Concat("code-mismatch|expected=", expected), "|actual="));
        Exit(1);
        return;
    }
    let actual: String = UnwrapOption(actual_opt);
    if actual == expected {
        Log("ok");
        return;
    }
    Log(Concat(Concat(Concat("code-mismatch|expected=", expected), "|actual="), actual));
    Exit(1);
}

func SemanticErrorWithFacts(code: String, facts: String) -> String {
    let stable_code: String = code;
    let stable_facts: String = facts;
    if !SemanticDiagnosticCodeKnown(code) {
        stable_code = "unregistered_diagnostic_code";
        stable_facts = SelfHostDiagnostic_Fact2("code", code, "owner", "diagnostic_code_owner");
    }
    let stage: String = "semantic";
    if stable_code == "parse_syntax" {
        stage = "syntax";
    }
    return SelfHostDiagnostic_RenderError(
        "pgy.selfhost.semantic.v1",
        stage,
        "error",
        stable_code,
        SemanticReason(stable_code),
        SemanticFix(stable_code),
        "none",
        stable_facts);
}
func SemanticError1(code: String, k1: String, v1: String) -> String { return SemanticErrorWithFacts(code, SelfHostDiagnostic_Fact1(k1, v1)); }
func SemanticError2(code: String, k1: String, v1: String, k2: String, v2: String) -> String {
    return SemanticErrorWithFacts(code, SelfHostDiagnostic_Fact2(k1, v1, k2, v2));
}
func SemanticError3(code: String, k1: String, v1: String, k2: String, v2: String, k3: String, v3: String) -> String {
    return SemanticErrorWithFacts(code, SelfHostDiagnostic_Fact3(k1, v1, k2, v2, k3, v3));
}
