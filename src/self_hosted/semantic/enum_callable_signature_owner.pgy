// Enum variant callable/value signature rows for the lightweight checker.
//
// The parser owns enum grammar, so this owner parses the checked source with
// the parser owner and reads the typed enum facts. It never re-scans enum
// text: variant order, optional commas, payload labels and enum methods are
// all decided by the parser before a row is published.

import "ast_enum_fact_owner.pgy";
import "callable_resolution_owner.pgy";
import "../parser/program_parse_owner.pgy";
import "../parser/ast_text_artifact_parse_owner.pgy";

func SemanticEnumVariantParamSignature(
    facts: SemanticAstEnumFacts, variant_index: Int
) -> String {
    let signature: String = "";
    let param: Int = facts.variant_param_starts[variant_index];
    let end: Int = param + facts.variant_param_counts[variant_index];
    while param < end {
        if StringLength(signature) > 0 {
            signature = Concat(signature, "|");
        }
        signature = Concat(
            signature, facts.variant_param_type_names[param]
        );
        param = param + 1;
    }
    return signature;
}

func SemanticEnumCallableRowsFromFacts(
    facts: SemanticAstEnumFacts,
    inout callable_names: Array<String>,
    inout callable_returns: Array<String>,
    inout callable_params: Array<String>
) -> Bool {
    if !facts.ok {
        return false;
    }
    let count: Int = ArrayLength(facts.variant_names);
    if ArrayLength(facts.variant_enum_names) != count ||
        ArrayLength(facts.variant_param_starts) != count ||
        ArrayLength(facts.variant_param_counts) != count {
        return false;
    }
    // Stage every row first: a partial projection must not reach the table.
    let staged_names: Array<String> = [];
    let staged_returns: Array<String> = [];
    let staged_params: Array<String> = [];
    let variant_index: Int = 0;
    while variant_index < count {
        let enum_name: String = facts.variant_enum_names[variant_index];
        let variant_name: String = facts.variant_names[variant_index];
        if StringLength(enum_name) == 0 ||
            StringLength(variant_name) == 0 ||
            facts.variant_param_starts[variant_index] < 0 ||
            facts.variant_param_counts[variant_index] < 0 ||
            facts.variant_param_starts[variant_index] +
                facts.variant_param_counts[variant_index] >
                ArrayLength(facts.variant_param_type_names) {
            return false;
        }
        ArrayPush(staged_names, SemanticCallableCanonicalDeclaredName(
            enum_name, variant_name
        ));
        ArrayPush(staged_returns, enum_name);
        ArrayPush(staged_params, SemanticEnumVariantParamSignature(
            facts, variant_index
        ));
        variant_index = variant_index + 1;
    }
    let i: Int = 0;
    while i < ArrayLength(staged_names) {
        ArrayPush(callable_names, staged_names[i]);
        ArrayPush(callable_returns, staged_returns[i]);
        ArrayPush(callable_params, staged_params[i]);
        i = i + 1;
    }
    return true;
}

// Presence gate, not a projection: the word decides whether the parser is
// asked at all. What an enum is, which variants it has and what their payload
// types are stays the parser's answer. The lightweight checker also accepts
// statement shapes the self-host parser does not cover yet, so a source that
// declares no enum is never parsed here.
func SemanticSourceMayDeclareEnum(content: String) -> Bool {
    return StringIndexOf(content, "enum") >= 0;
}

func SemanticEnumFactsForCheckedSource(
    source_path: String, content: String
) -> SemanticAstEnumFacts {
    // The checked bundle already carries its imported modules, so the parse
    // reads no further file.
    let build: ParserProgramBuild = ParseProgramBuildContentWithImportPolicy(
        source_path, content, false
    );
    return SemanticAstEnumFactsFromArtifact(
        ParserAstTreeArtifactFromText(build.tree_text)
    );
}

func SeedDeclaredEnumVariantSignatures(
    source_path: String,
    content: String,
    inout callable_names: Array<String>,
    inout callable_returns: Array<String>,
    inout callable_params: Array<String>
) -> Bool {
    if !SemanticSourceMayDeclareEnum(content) {
        return true;
    }
    return SemanticEnumCallableRowsFromFacts(
        SemanticEnumFactsForCheckedSource(source_path, content),
        callable_names, callable_returns, callable_params
    );
}

func SemanticEnumCallableProjectionContractReady() -> Bool {
    let source: String = "enum ImportedDecision {\n  ImportedReady\n  ImportedValue(value: Int)\n  func StableCode(self) -> Int { return 7; }\n  ImportedPair(left: Int, right: String)\n}\n";
    let names: Array<String> = [];
    let returns: Array<String> = [];
    let params: Array<String> = [];
    if !SeedDeclaredEnumVariantSignatures(
        "enum_callable_contract.pgy", source, names, returns, params
    ) || ArrayLength(names) != 3 || ArrayLength(returns) != 3 ||
        ArrayLength(params) != 3 {
        return false;
    }
    if names[0] != "ImportedDecision_ImportedReady" ||
        names[1] != "ImportedDecision_ImportedValue" ||
        names[2] != "ImportedDecision_ImportedPair" ||
        returns[0] != "ImportedDecision" ||
        returns[1] != "ImportedDecision" ||
        returns[2] != "ImportedDecision" || params[0] != "" ||
        params[1] != "Int" || params[2] != "Int|String" {
        return false;
    }
    if !IsSome(SemanticCallableIndex(
        names, "ImportedDecision.ImportedReady"
    )) || !IsSome(SemanticCallableIndex(names, "ImportedReady")) ||
        !IsSome(SemanticCallableIndex(
            names, "ImportedDecision.ImportedPair"
        )) || !IsSome(SemanticCallableIndex(names, "ImportedPair")) ||
        IsSome(SemanticCallableIndex(
            names, "ImportedDecision.StableCode"
        )) || IsSome(SemanticCallableIndex(names, "StableCode")) {
        return false;
    }

    let non_enum_names: Array<String> = [];
    let non_enum_returns: Array<String> = [];
    let non_enum_params: Array<String> = [];
    if !SeedDeclaredEnumVariantSignatures(
        "enum_callable_contract_plain.pgy",
        "func Example() -> Void { let outcome_enum: String = \"ready\"; }\n",
        non_enum_names, non_enum_returns, non_enum_params
    ) || ArrayLength(non_enum_names) != 0 ||
        ArrayLength(non_enum_returns) != 0 || ArrayLength(non_enum_params) != 0 {
        return false;
    }

    // Facts that are not ready publish no row at all.
    let empty_ints: Array<Int> = [];
    let empty_texts: Array<String> = [];
    let broken: SemanticAstEnumFacts = SemanticAstEnumFacts(
        false, 0, empty_ints, empty_texts, empty_texts, empty_texts,
        empty_ints, empty_ints, empty_texts
    );
    let preserved_names: Array<String> = ["Keep"];
    let preserved_returns: Array<String> = ["Keep"];
    let preserved_params: Array<String> = [""];
    return !SemanticEnumCallableRowsFromFacts(
        broken, preserved_names, preserved_returns, preserved_params
    ) && ArrayLength(preserved_names) == 1 &&
        ArrayLength(preserved_returns) == 1 &&
        ArrayLength(preserved_params) == 1;
}
