// Enum variant callable/value signature projection for the lightweight checker.
//
// The parser owns enum grammar. This bounded source-bundle bridge follows that
// grammar exactly enough to project callable rows: commas between variants are
// optional, payload labels are erased, and enum methods are never variants.

import "text_scan_owner.pgy";
import "delimited_range_fact_owner.pgy";
import "callable_resolution_owner.pgy";

func SemanticEnumPayloadClose(
    source: String, open: Int, limit: Int
) -> Int {
    let depth: Int = 1;
    let i: Int = open + 1;
    while i < limit {
        let c: Int = SourceByteAt(source, limit, i);
        if c == SourceByteOf("\"") {
            i = SkipQuotedString(source, i, limit);
            continue;
        }
        if c == SourceByteOf("/") &&
            SourceByteAt(source, limit, i + 1) == SourceByteOf("/") {
            i = SkipLineComment(source, i, limit);
            continue;
        }
        if c == SourceByteOf("/") &&
            SourceByteAt(source, limit, i + 1) == SourceByteOf("*") {
            i = SkipBlockComment(source, i, limit);
            continue;
        }
        if c == SourceByteOf("(") {
            depth = depth + 1;
        } else if c == SourceByteOf(")") {
            depth = depth - 1;
            if depth == 0 { return i; }
        }
        i = i + 1;
    }
    return limit;
}

func SemanticEnumVariantParamSignature(source: String) -> Option<String> {
    if StringLength(Trim(source)) == 0 { return Some(""); }
    let facts: SemanticDelimitedRangeFacts =
        SemanticNestedCommaRangeFactsFromSource(source);
    let signature: String = "";
    let cursor: Array<Int> = [0];
    let i: Int = 0;
    while i < SemanticDelimitedRangeCount(facts) {
        let param: String = SemanticDelimitedRangeText(facts, source, i);
        let n: Int = StringLength(param);
        if n == 0 { return None; }
        let type_start: Int = 0;
        let possible_label: String = SemanticReadIdentWithin(
            param, n, 0, cursor
        );
        let after_label: Int = SkipWhitespaceAndCommentsWithin(
            param, n, cursor[0]
        );
        if StringLength(possible_label) > 0 && after_label < n &&
            CharAtWithin(param, n, after_label) == ":" {
            type_start = SkipWhitespaceAndCommentsWithin(
                param, n, after_label + 1
            );
        }
        let param_type: String = Trim(Substring(param, type_start, n - type_start));
        if StringLength(param_type) == 0 ||
            CharAtWithin(param_type, StringLength(param_type), 0) == ":" {
            return None;
        }
        if StringLength(signature) > 0 { signature = Concat(signature, "|"); }
        signature = Concat(signature, param_type);
        i = i + 1;
    }
    return Some(signature);
}

func SemanticEnumMethodEnd(
    content: String, start: Int, limit: Int
) -> Option<Int> {
    let body_open: Int = FindBlockOpen(content, start, limit);
    let signature_end: Int = FindStatementEnd(content, start, limit);
    if body_open < signature_end && body_open < limit &&
        CharAtWithin(content, limit, body_open) == "{" {
        let body_close: Int = FindMatchingBraceWithin(
            content, body_open, limit
        );
        if body_close >= limit { return None; }
        return Some(body_close + 1);
    }
    if signature_end < limit &&
        CharAtWithin(content, limit, signature_end) == ";" {
        return Some(signature_end + 1);
    }
    return None;
}

func SeedDeclaredEnumVariantSignatures(
    content: String,
    inout callable_names: Array<String>,
    inout callable_returns: Array<String>,
    inout callable_params: Array<String>
) -> Bool {
    let staged_names: Array<String> = [];
    let staged_returns: Array<String> = [];
    let staged_params: Array<String> = [];
    let n: Int = StringLength(content);
    let cursor: Array<Int> = [0];
    let scan: Int = 0;
    while scan < n {
        scan = SkipWhitespaceAndCommentsWithin(content, n, scan);
        if scan >= n { break; }
        if CharAtWithin(content, n, scan) == "\"" {
            scan = SkipQuotedString(content, scan, n);
            continue;
        }
        if (scan > 0 && SourceByteIsAlphaNum(
            SourceByteAt(content, n, scan - 1)
        )) || !SemanticMatchKeywordWithin(content, n, scan, "enum") {
            scan = scan + 1;
            continue;
        }

        let enum_name: String = SemanticReadIdentWithin(
            content, n, scan + 4, cursor
        );
        let body_open_opt: Option<Int> = ExpectLiteralWithin(
            content, n, cursor[0], "{"
        );
        if StringLength(enum_name) == 0 || !IsSome(body_open_opt) {
            return false;
        }
        let body_open: Int = UnwrapOption(body_open_opt) - 1;
        let body_close: Int = FindMatchingBraceWithin(content, body_open, n);
        if body_close >= n { return false; }

        let body_scan: Int = body_open + 1;
        while body_scan < body_close {
            body_scan = SkipWhitespaceAndCommentsWithin(
                content, n, body_scan
            );
            if body_scan >= body_close { break; }
            if SemanticMatchKeywordWithin(
                content, n, body_scan, "func"
            ) {
                let method_end: Option<Int> = SemanticEnumMethodEnd(
                    content, body_scan, body_close
                );
                if !IsSome(method_end) { return false; }
                body_scan = UnwrapOption(method_end);
                continue;
            }

            let variant_name: String = SemanticReadIdentWithin(
                content, n, body_scan, cursor
            );
            if StringLength(variant_name) == 0 { return false; }
            body_scan = SkipWhitespaceAndCommentsWithin(
                content, n, cursor[0]
            );
            let params: String = "";
            if body_scan < body_close &&
                CharAtWithin(content, n, body_scan) == "(" {
                let payload_close: Int = SemanticEnumPayloadClose(
                    content, body_scan, body_close
                );
                if payload_close >= body_close { return false; }
                let signature: Option<String> =
                    SemanticEnumVariantParamSignature(Substring(
                        content, body_scan + 1,
                        payload_close - body_scan - 1
                    ));
                if !IsSome(signature) { return false; }
                params = UnwrapOption(signature);
                body_scan = SkipWhitespaceAndCommentsWithin(
                    content, n, payload_close + 1
                );
            }
            ArrayPush(staged_names, SemanticCallableCanonicalDeclaredName(
                enum_name, variant_name
            ));
            ArrayPush(staged_returns, enum_name);
            ArrayPush(staged_params, params);
            if body_scan < body_close &&
                CharAtWithin(content, n, body_scan) == "," {
                body_scan = body_scan + 1;
            }
        }
        scan = body_close + 1;
    }

    let i: Int = 0;
    while i < ArrayLength(staged_names) {
        ArrayPush(callable_names, staged_names[i]);
        ArrayPush(callable_returns, staged_returns[i]);
        ArrayPush(callable_params, staged_params[i]);
        i = i + 1;
    }
    return true;
}

func SemanticEnumCallableProjectionContractReady() -> Bool {
    let source: String = "enum ImportedDecision {\n  ImportedReady\n  ImportedValue(value: Int)\n  func StableCode(self) -> Int { return 7; }\n  ImportedPair(left: Int, right: String)\n}\n";
    let names: Array<String> = [];
    let returns: Array<String> = [];
    let params: Array<String> = [];
    if !SeedDeclaredEnumVariantSignatures(
        source, names, returns, params
    ) || ArrayLength(names) != 3 || ArrayLength(returns) != 3 ||
        ArrayLength(params) != 3 {
        return false;
    }
    if names[0] != "ImportedDecision_ImportedReady" ||
        names[1] != "ImportedDecision_ImportedValue" ||
        names[2] != "ImportedDecision_ImportedPair" ||
        returns[0] != "ImportedDecision" ||
        returns[1] != "ImportedDecision" ||
        returns[2] != "ImportedDecision" || params[0] != "" ||
        params[1] != "Int" || params[2] != "Int|String" {
        return false;
    }
    if !IsSome(SemanticCallableIndex(
        names, "ImportedDecision.ImportedReady"
    )) || !IsSome(SemanticCallableIndex(names, "ImportedReady")) ||
        !IsSome(SemanticCallableIndex(
            names, "ImportedDecision.ImportedPair"
        )) || !IsSome(SemanticCallableIndex(names, "ImportedPair")) ||
        IsSome(SemanticCallableIndex(
            names, "ImportedDecision.StableCode"
        )) || IsSome(SemanticCallableIndex(names, "StableCode")) {
        return false;
    }

    let non_enum_names: Array<String> = [];
    let non_enum_returns: Array<String> = [];
    let non_enum_params: Array<String> = [];
    if !SeedDeclaredEnumVariantSignatures(
        "func Example() -> Void { let outcome_enum: String = \"ready\"; }",
        non_enum_names, non_enum_returns, non_enum_params
    ) || ArrayLength(non_enum_names) != 0 ||
        ArrayLength(non_enum_returns) != 0 || ArrayLength(non_enum_params) != 0 {
        return false;
    }

    let preserved_names: Array<String> = ["Keep"];
    let preserved_returns: Array<String> = ["Keep"];
    let preserved_params: Array<String> = [""];
    return !SeedDeclaredEnumVariantSignatures(
        "enum Broken { Value(Int)",
        preserved_names, preserved_returns, preserved_params
    ) && ArrayLength(preserved_names) == 1 &&
        ArrayLength(preserved_returns) == 1 &&
        ArrayLength(preserved_params) == 1;
}
