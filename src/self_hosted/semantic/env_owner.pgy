// Self-host semantic local environment owner.

func EnvLookup(
    ref names: Array<String>, ref types: Array<String>, name: String
) -> String {
    let i: Int = ArrayLength(names) - 1;
    while i >= 0 {
        if names[i] == name {
            return Concat("", types[i]);
        }
        i = i - 1;
    }
    return "Unknown";
}
func EnvContainsName(ref names: Array<String>, name: String) -> Bool {
    let i: Int = ArrayLength(names) - 1;
    while i >= 0 {
        if names[i] == name {
            return true;
        }
        i = i - 1;
    }
    return false;
}
func EnvMode(
    ref names: Array<String>, ref modes: Array<String>, name: String
) -> String {
    let i: Int = ArrayLength(names) - 1;
    while i >= 0 {
        if names[i] == name {
            return Concat("", modes[i]);
        }
        i = i - 1;
    }
    return "unknown";
}

func EnvSliceLookup(
    names: Slice<String>, types: Slice<String>, name: String
) -> String {
    if ArrayLength(names) != ArrayLength(types) { return "Unknown"; }
    let i: Int = ArrayLength(names) - 1;
    while i >= 0 {
        let candidate: String = Concat("", names[i]);
        if candidate == name { return Concat("", types[i]); }
        i = i - 1;
    }
    return "Unknown";
}

func EnvSliceMode(
    names: Slice<String>, modes: Slice<String>, name: String
) -> String {
    if ArrayLength(names) != ArrayLength(modes) { return "unknown"; }
    let i: Int = ArrayLength(names) - 1;
    while i >= 0 {
        let candidate: String = Concat("", names[i]);
        if candidate == name { return Concat("", modes[i]); }
        i = i - 1;
    }
    return "unknown";
}
