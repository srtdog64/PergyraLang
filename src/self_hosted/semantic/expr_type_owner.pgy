// Self-host semantic expression typing owner.

func IsIdentText(text: String) -> Bool {
    if StringLength(text) == 0 {
        return false;
    }
    if !IsAlpha(CharAt(text, 0)) {
        return false;
    }
    let i: Int = 1;
    while i < StringLength(text) {
        if !IsAlphaNum(CharAt(text, i)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}
func IsIntLiteral(text: String) -> Bool {
    let i: Int = 0;
    let n: Int = StringLength(text);
    if n == 0 {
        return false;
    }
    if CharAt(text, 0) == "-" {
        i = 1;
    }
    if i >= n {
        return false;
    }
    while i < n {
        if !IsDigit(CharAt(text, i)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}
func IsFloatLiteral(text: String) -> Bool {
    let i: Int = 0;
    let n: Int = StringLength(text);
    let seen_dot: Bool = false;
    let seen_digit: Bool = false;
    if n == 0 {
        return false;
    }
    if CharAt(text, 0) == "-" {
        i = 1;
    }
    if i >= n {
        return false;
    }
    while i < n {
        let c: String = CharAt(text, i);
        if c == "." {
            if seen_dot {
                return false;
            }
            seen_dot = true;
            i = i + 1;
            continue;
        }
        if !IsDigit(c) {
            return false;
        }
        seen_digit = true;
        i = i + 1;
    }
    return seen_dot && seen_digit;
}
func TopLevelOpType(expr: String) -> String {
    let n: Int = StringLength(expr);
    let i: Int = 0;
    let depth: Int = 0;
    let found_logical: Bool = false;
    let found_compare: Bool = false;
    let found_arith: Bool = false;
    while i < n {
        let c: String = CharAt(expr, i);
        if c == "\"" {
            i = i + 1;
            while i < n && CharAt(expr, i) != "\"" {
                if CharAt(expr, i) == "\\" {
                    i = i + 1;
                }
                i = i + 1;
            }
            i = i + 1;
            continue;
        }
        if c == "(" || c == "[" {
            depth = depth + 1;
            i = i + 1;
            continue;
        }
        if c == ")" || c == "]" {
            if depth > 0 {
                depth = depth - 1;
            }
            i = i + 1;
            continue;
        }
        if depth != 0 {
            i = i + 1;
            continue;
        }
        let c2: String = CharAt(expr, i + 1);
        if c == "|" && c2 == "|" {
            found_logical = true;
            i = i + 2;
            continue;
        }
        if c == "&" && c2 == "&" {
            found_logical = true;
            i = i + 2;
            continue;
        }
        if c == "=" && c2 == "=" {
            found_compare = true;
            i = i + 2;
            continue;
        }
        if c == "!" && c2 == "=" {
            found_compare = true;
            i = i + 2;
            continue;
        }
        if c == "<" || c == ">" {
            found_compare = true;
            i = i + 1;
            continue;
        }
        if c == "+" || c == "*" || c == "/" {
            found_arith = true;
            i = i + 1;
            continue;
        }
        if c == "-" && c2 != ">" {
            found_arith = true;
            i = i + 1;
            continue;
        }
        i = i + 1;
    }
    if found_logical {
        return "Bool";
    }
    if found_compare {
        return "Bool";
    }
    if found_arith {
        return "Int";
    }
    return "";
}
func CallReturnType(text: String, func_names: Array<String>, func_rets: Array<String>) -> String {
    let n: Int = StringLength(text);
    if n == 0 {
        return "Unknown";
    }
    if CharAt(text, n - 1) != ")" {
        return "Unknown";
    }
    let paren: Int = StringIndexOf(text, "(");
    if paren <= 0 {
        return "Unknown";
    }
    let callee: String = Trim(Substring(text, 0, paren));
    if !IsIdentText(callee) {
        return "Unknown";
    }
    let i: Int = 0;
    while i < ArrayLength(func_names) {
        if func_names[i] == callee {
            return func_rets[i];
        }
        i = i + 1;
    }
    return "Unknown";
}
func ParamTypeOf(part: String) -> String {
    let colon: Int = StringIndexOf(part, ":");
    if colon < 0 {
        return "Unknown";
    }
    return Trim(Substring(part, colon + 1, StringLength(part) - colon - 1));
}
func ParamTypes(param_src: String) -> String {
    let n: Int = StringLength(param_src);
    let i: Int = 0;
    let depth: Int = 0;
    let part_start: Int = 0;
    let result: String = "";
    while i <= n {
        let at_end: Bool = i >= n;
        let c: String = "";
        if !at_end {
            c = CharAt(param_src, i);
        }
        if !at_end && (c == "<" || c == "(" || c == "[") {
            depth = depth + 1;
            i = i + 1;
            continue;
        }
        if !at_end && (c == ">" || c == ")" || c == "]") {
            if depth > 0 {
                depth = depth - 1;
            }
            i = i + 1;
            continue;
        }
        if at_end || (depth == 0 && c == ",") {
            let part: String = Trim(Substring(param_src, part_start, i - part_start));
            if StringLength(part) > 0 {
                let ptype: String = ParamTypeOf(part);
                if StringLength(result) > 0 {
                    result = Concat(result, "|");
                }
                result = Concat(result, ptype);
            }
            part_start = i + 1;
        }
        i = i + 1;
    }
    return result;
}
func NthExpected(sig: String, target: Int) -> String {
    let n: Int = StringLength(sig);
    let i: Int = 0;
    let field: Int = 0;
    let start: Int = 0;
    while i <= n {
        let at_end: Bool = i >= n;
        let c: String = "";
        if !at_end {
            c = CharAt(sig, i);
        }
        if at_end || c == "|" {
            if field == target {
                return Trim(Substring(sig, start, i - start));
            }
            field = field + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}
func ArithmeticResultType(expr: String, names: Array<String>, types: Array<String>, func_names: Array<String>, func_rets: Array<String>) -> String {
    let text: String = Trim(expr);
    let n: Int = StringLength(text);
    let i: Int = 0;
    let depth: Int = 0;
    let split_idx: Int = -1;
    while i < n {
        let c: String = CharAt(text, i);
        if c == "\"" {
            i = i + 1;
            while i < n && CharAt(text, i) != "\"" {
                if CharAt(text, i) == "\\" {
                    i = i + 1;
                }
                i = i + 1;
            }
            i = i + 1;
            continue;
        }
        if c == "(" || c == "[" {
            depth = depth + 1;
            i = i + 1;
            continue;
        }
        if c == ")" || c == "]" {
            if depth > 0 {
                depth = depth - 1;
            }
            i = i + 1;
            continue;
        }
        if depth == 0 && (c == "+" || c == "*" || c == "/") {
            split_idx = i;
            break;
        }
        if depth == 0 && c == "-" && CharAt(text, i + 1) != ">" {
            let j: Int = i - 1;
            while j >= 0 && (CharAt(text, j) == " " || CharAt(text, j) == "\t") {
                j = j - 1;
            }
            if j >= 0 {
                let prevc: String = CharAt(text, j);
                if prevc == ")" || prevc == "]" || prevc == "\"" || IsAlphaNum(prevc) {
                    split_idx = i;
                    break;
                }
            }
        }
        i = i + 1;
    }
    if split_idx < 0 {
        return "";
    }
    let left: String = Trim(Substring(text, 0, split_idx));
    let right: String = Trim(Substring(text, split_idx + 1, n - split_idx - 1));
    if StringLength(left) == 0 || StringLength(right) == 0 {
        return "Int";
    }
    let lt: String = ExprType(left, names, types, func_names, func_rets);
    let rt: String = ExprType(right, names, types, func_names, func_rets);
    if lt == rt {
        if lt == "Int" || lt == "Long" || lt == "Float" {
            return lt;
        }
    }
    return "Int";
}
func ExpressionAssignableTo(expected: String, actual: String, expr: String) -> Bool {
    if expected == actual {
        return true;
    }
    if expected == "Long" && actual == "Int" && IsIntLiteral(Trim(expr)) {
        return true;
    }
    return false;
}
func ExprType(expr: String, names: Array<String>, types: Array<String>, func_names: Array<String>, func_rets: Array<String>) -> String {
    let text: String = Trim(expr);
    if StringLength(text) == 0 {
        return "Void";
    }
    if CharAt(text, 0) == "!" && CharAt(text, 1) != "=" {
        return "Bool";
    }
    let op_type: String = TopLevelOpType(text);
    if op_type == "Bool" {
        return "Bool";
    }
    if op_type == "Int" {
        let arith_type: String = ArithmeticResultType(text, names, types, func_names, func_rets);
        if arith_type != "" {
            return arith_type;
        }
        return "Int";
    }
    if CharAt(text, 0) == "\"" {
        return "String";
    }
    if text == "true" || text == "false" {
        return "Bool";
    }
    if IsIntLiteral(text) {
        return "Int";
    }
    if IsFloatLiteral(text) {
        return "Float";
    }
    let call_type: String = CallReturnType(text, func_names, func_rets);
    if call_type != "Unknown" {
        return call_type;
    }
    if IsIdentText(text) {
        return EnvLookup(names, types, text);
    }
    return "Unknown";
}
