// Self-host semantic expression typing owner.

import "text_scan_owner.pgy";
import "env_owner.pgy";
import "expression_normalization_owner.pgy";
import "expression_operator_fact_owner.pgy";
import "delimited_range_fact_owner.pgy";
import "try_expression_fact_owner.pgy";
import "wrapper_type_owner.pgy";

func IsIdentText(text: String) -> Bool {
    if StringLength(text) == 0 {
        return false;
    }
    if !IsAlpha(CharAt(text, 0)) {
        return false;
    }
    let i: Int = 1;
    while i < StringLength(text) {
        if !IsAlphaNum(CharAt(text, i)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}
func IsIntLiteral(text: String) -> Bool {
    let i: Int = 0;
    let n: Int = StringLength(text);
    if n == 0 {
        return false;
    }
    if CharAt(text, 0) == "-" {
        i = 1;
    }
    if i >= n {
        return false;
    }
    while i < n {
        if !IsDigit(CharAt(text, i)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}
func IsFloatLiteral(text: String) -> Bool {
    let i: Int = 0;
    let n: Int = StringLength(text);
    let seen_dot: Bool = false;
    let seen_digit: Bool = false;
    if n == 0 {
        return false;
    }
    if CharAt(text, 0) == "-" {
        i = 1;
    }
    if i >= n {
        return false;
    }
    while i < n {
        let c: String = CharAt(text, i);
        if c == "." {
            if seen_dot {
                return false;
            }
            seen_dot = true;
            i = i + 1;
            continue;
        }
        if !IsDigit(c) {
            return false;
        }
        seen_digit = true;
        i = i + 1;
    }
    return seen_dot && seen_digit;
}
func TopLevelOpType(expr: String) -> String {
    let facts: SemanticTopLevelOperatorFacts =
        SemanticTopLevelOperatorFactsFromExpression(expr);
    if facts.logical_index >= 0 {
        return "Bool";
    }
    if facts.comparison_index >= 0 {
        return "Bool";
    }
    if facts.arithmetic_marker_index >= 0 {
        return "Int";
    }
    return "";
}
func CallReturnType(text: String, func_names: Array<String>, func_rets: Array<String>) -> String {
    let n: Int = StringLength(text);
    if n == 0 {
        return "Unknown";
    }
    if CharAt(text, n - 1) != ")" {
        return "Unknown";
    }
    let paren: Int = StringIndexOf(text, "(");
    if paren <= 0 {
        return "Unknown";
    }
    let callee: String = Trim(Substring(text, 0, paren));
    if !SemanticCallableSourceNameValid(callee) {
        return "Unknown";
    }
    let index: Option<Int> = SemanticCallableIndex(func_names, callee);
    if IsSome(index) {
        return func_rets[UnwrapOption(index)];
    }
    return "Unknown";
}

func MachineLayerBuiltinReturnType(
    text: String,
    names: Array<String>,
    types: Array<String>,
    func_names: Array<String>,
    func_rets: Array<String>
) -> String {
    let n: Int = StringLength(text);
    if n == 0 || CharAt(text, n - 1) != ")" {
        return "";
    }
    let paren: Int = StringIndexOf(text, "(");
    if paren <= 0 { return ""; }
    let callee: String = Trim(Substring(text, 0, paren));
    let args_src: String = Substring(text, paren + 1, n - paren - 2);
    if callee == "ClaimDeviceSlot" {
        return "DeviceSlot<Unknown>";
    }
    if callee == "DeviceRead" || callee == "SubmitDeviceRead" {
        let argument: String = CallArgAt(args_src, 0);
        let receiver_type: String =
            ExprType(argument, names, types, func_names, func_rets);
        let payload: Option<String> =
            DeviceSlotPayloadTypeOpt(receiver_type);
        if !IsSome(payload) {
            return "";
        }
        if callee == "DeviceRead" {
            return UnwrapOption(payload);
        }
        return Concat("RemoteFuture<", Concat(
            UnwrapOption(payload), ">"
        ));
    }
    if callee == "DeviceWrite" || callee == "ReleaseDeviceSlot" {
        return "Void";
    }
    return "";
}

func ParamTypeOf(part: String) -> String {
    let colon: Int = StringIndexOf(part, ":");
    if colon < 0 {
        return "Unknown";
    }
    return Trim(Substring(part, colon + 1, StringLength(part) - colon - 1));
}
func ParamTypes(param_src: String) -> String {
    let facts: SemanticDelimitedRangeFacts =
        SemanticNestedCommaRangeFactsFromSource(param_src);
    let result: String = "";
    let i: Int = 0;
    while i < SemanticDelimitedRangeCount(facts) {
        let part: String = SemanticDelimitedRangeText(facts, param_src, i);
        if StringLength(part) > 0 {
            let ptype: String = ParamTypeOf(part);
            if StringLength(result) > 0 {
                result = Concat(result, "|");
            }
            result = Concat(result, ptype);
        }
        i = i + 1;
    }
    return result;
}
func NthExpectedFromFacts(
    ref facts: SemanticDelimitedRangeFacts,
    sig: String,
    target: Int
) -> String {
    return SemanticDelimitedRangeText(facts, sig, target);
}
func NthExpected(sig: String, target: Int) -> String {
    let facts: SemanticDelimitedRangeFacts =
        SemanticSignatureRangeFactsFromSource(sig);
    return NthExpectedFromFacts(facts, sig, target);
}
func CallArgAtFromFacts(
    ref facts: SemanticDelimitedRangeFacts,
    args_src: String,
    target: Int
) -> String {
    return SemanticDelimitedRangeText(facts, args_src, target);
}
func CallArgAt(args_src: String, target: Int) -> String {
    let facts: SemanticDelimitedRangeFacts =
        SemanticNestedCommaRangeFactsFromSource(args_src);
    return CallArgAtFromFacts(facts, args_src, target);
}
func ScalarUtilityReturnType(text: String, names: Array<String>, types: Array<String>, func_names: Array<String>, func_rets: Array<String>) -> String {
    let n: Int = StringLength(text);
    if n == 0 || CharAt(text, n - 1) != ")" {
        return "";
    }
    let paren: Int = StringIndexOf(text, "(");
    if paren <= 0 {
        return "";
    }
    let callee: String = Trim(Substring(text, 0, paren));
    if callee != "Abs" && callee != "Min" && callee != "Max" && callee != "Clamp" {
        return "";
    }
    let args_src: String = Substring(text, paren + 1, n - paren - 2);
    let first: String = CallArgAt(args_src, 0);
    if StringLength(first) == 0 {
        return "Unknown";
    }
    let first_type: String = ExprType(first, names, types, func_names, func_rets);
    if first_type != "Unknown" {
        return first_type;
    }
    return "Unknown";
}
func ArithmeticResultType(expr: String, names: Array<String>, types: Array<String>, func_names: Array<String>, func_rets: Array<String>) -> String {
    let text: String = Trim(expr);
    let n: Int = StringLength(text);
    let i: Int = 0;
    let depth: Int = 0;
    let split_idx: Int = -1;
    let split_op: String = "";
    while i < n {
        let c: String = CharAt(text, i);
        if c == "\"" {
            i = i + 1;
            while i < n && CharAt(text, i) != "\"" {
                if CharAt(text, i) == "\\" {
                    i = i + 1;
                }
                i = i + 1;
            }
            i = i + 1;
            continue;
        }
        if c == "(" || c == "[" {
            depth = depth + 1;
            i = i + 1;
            continue;
        }
        if c == ")" || c == "]" {
            if depth > 0 {
                depth = depth - 1;
            }
            i = i + 1;
            continue;
        }
        if depth == 0 && (c == "+" || c == "*" || c == "/") {
            split_idx = i;
            split_op = c;
            break;
        }
        if depth == 0 && c == "-" && CharAt(text, i + 1) != ">" {
            let j: Int = i - 1;
            while j >= 0 && (CharAt(text, j) == " " || CharAt(text, j) == "\t") {
                j = j - 1;
            }
            if j >= 0 {
                let prevc: String = CharAt(text, j);
                if prevc == ")" || prevc == "]" || prevc == "\"" || IsAlphaNum(prevc) {
                    split_idx = i;
                    split_op = c;
                    break;
                }
            }
        }
        i = i + 1;
    }
    if split_idx < 0 {
        return "";
    }
    let left: String = Trim(Substring(text, 0, split_idx));
    let right: String = Trim(Substring(text, split_idx + 1, n - split_idx - 1));
    if StringLength(left) == 0 || StringLength(right) == 0 {
        return "Int";
    }
    let lt: String = ExprType(left, names, types, func_names, func_rets);
    let rt: String = ExprType(right, names, types, func_names, func_rets);
    if split_op == "+" && lt == "String" && rt == "String" {
        return "String";
    }
    if lt == rt {
        if lt == "Int" || lt == "Long" || lt == "Float" || lt == "Bool" {
            return lt;
        }
    }
    return "Int";
}
func OptionCallReturnType(text: String, names: Array<String>, types: Array<String>, func_names: Array<String>, func_rets: Array<String>) -> String {
    let n: Int = StringLength(text);
    if text == "None" {
        return "Option<Unknown>";
    }
    if n == 0 || CharAt(text, n - 1) != ")" {
        return "";
    }
    let paren: Int = StringIndexOf(text, "(");
    if paren <= 0 {
        return "";
    }
    let callee: String = Trim(Substring(text, 0, paren));
    let args_src: String = Substring(text, paren + 1, n - paren - 2);
    if callee == "None" {
        return "Option<Unknown>";
    }
    if callee == "Some" {
        let value_expr: String = CallArgAt(args_src, 0);
        let value_type: String = ExprType(value_expr, names, types, func_names, func_rets);
        if StringLength(value_type) == 0 {
            return "Option<Unknown>";
        }
        return Concat(Concat("Option<", value_type), ">");
    }
    if callee == "UnwrapOption" {
        let option_expr: String = CallArgAt(args_src, 0);
        let option_type: String = ExprType(option_expr, names, types, func_names, func_rets);
        if IsOptionType(option_type) {
            return Substring(option_type, 7, StringLength(option_type) - 8);
        }
        return "Unknown";
    }
    if callee == "IsSome" {
        return "Bool";
    }
    return "";
}
func ResultCallReturnType(text: String, names: Array<String>, types: Array<String>, func_names: Array<String>, func_rets: Array<String>) -> String {
    let n: Int = StringLength(text);
    if n == 0 || CharAt(text, n - 1) != ")" {
        return "";
    }
    let paren: Int = StringIndexOf(text, "(");
    if paren <= 0 {
        return "";
    }
    let callee: String = Trim(Substring(text, 0, paren));
    let args_src: String = Substring(text, paren + 1, n - paren - 2);
    if callee == "Ok" {
        let value_expr: String = CallArgAt(args_src, 0);
        let value_type: String = ExprType(value_expr, names, types, func_names, func_rets);
        if StringLength(value_type) == 0 {
            return "Result<Unknown>";
        }
        return Concat(Concat("Result<", value_type), ">");
    }
    if callee == "Err" {
        return "Result<Unknown>";
    }
    if callee == "IsOk" || callee == "IsErr" {
        return "Bool";
    }
    if callee == "Unwrap" {
        let result_expr: String = CallArgAt(args_src, 0);
        let payload_type_opt: Option<String> = ResultPayloadTypeOpt(ExprType(result_expr, names, types, func_names, func_rets));
        if IsSome(payload_type_opt) {
            return UnwrapOption(payload_type_opt);
        }
        return "Unknown";
    }
    if callee == "UnwrapOr" {
        let result_expr: String = CallArgAt(args_src, 0);
        let result_type: String = ExprType(result_expr, names, types, func_names, func_rets);
        let payload_type_opt2: Option<String> = ResultPayloadTypeOpt(result_type);
        if IsSome(payload_type_opt2) && UnwrapOption(payload_type_opt2) != "Unknown" {
            return UnwrapOption(payload_type_opt2);
        }
        let fallback_expr: String = CallArgAt(args_src, 1);
        return ExprType(fallback_expr, names, types, func_names, func_rets);
    }
    return "";
}
func ExpressionAssignableTo(expected: String, actual: String, expr: String) -> Bool {
    if expected == actual {
        return true;
    }
    if IsOptionType(expected) && actual == "Option<Unknown>" {
        return true;
    }
    if IsResultType(expected) && actual == "Result<Unknown>" {
        return true;
    }
    if IsDeviceSlotType(expected) && actual == "DeviceSlot<Unknown>" {
        return true;
    }
    if IsRemoteFutureType(expected) && actual == "RemoteFuture<Unknown>" {
        return true;
    }
    if expected == "Long" && actual == "Int" && IsIntLiteral(Trim(expr)) {
        return true;
    }
    return false;
}
func ExprType(expr: String, names: Array<String>, types: Array<String>, func_names: Array<String>, func_rets: Array<String>) -> String {
    let text: String = SemanticStripOuterParens(expr);
    if StringLength(text) == 0 {
        return "Void";
    }
    if StartsWith(text, "await ") {
        let awaited_text: String =
            Trim(Substring(text, 6, StringLength(text) - 6));
        let awaited_type: String =
            ExprType(awaited_text, names, types, func_names, func_rets);
        let remote_payload: Option<String> =
            RemoteFuturePayloadTypeOpt(awaited_type);
        if IsSome(remote_payload) {
            return Concat("Result<", Concat(
                UnwrapOption(remote_payload), ">"
            ));
        }
        let future_payload: Option<String> =
            FuturePayloadTypeOpt(awaited_type);
        if IsSome(future_payload) {
            return UnwrapOption(future_payload);
        }
        return "Unknown";
    }
    let try_bounds: Array<Int> = [0, 0];
    if TryOperandBounds(text, try_bounds) {
        let try_operand: String = Trim(Substring(text, try_bounds[0], try_bounds[1]));
        let try_operand_type: String = ExprType(try_operand, names, types, func_names, func_rets);
        if IsOptionType(try_operand_type) {
            return Substring(try_operand_type, 7, StringLength(try_operand_type) - 8);
        }
        if IsResultType(try_operand_type) {
            return Substring(try_operand_type, 7, StringLength(try_operand_type) - 8);
        }
        return "Unknown";
    }
    if CharAt(text, 0) == "!" && CharAt(text, 1) != "=" {
        return "Bool";
    }
    if CharAt(text, 0) == "-" && StringLength(text) > 1 {
        let negated: String = Trim(Substring(text, 1, StringLength(text) - 1));
        let negated_type: String = ExprType(negated, names, types, func_names, func_rets);
        if negated_type == "Int" || negated_type == "Long" || negated_type == "Float" {
            return negated_type;
        }
    }
    let op_type: String = TopLevelOpType(text);
    if op_type == "Bool" {
        return "Bool";
    }
    if op_type == "Int" {
        let arith_type: String = ArithmeticResultType(text, names, types, func_names, func_rets);
        if arith_type != "" {
            return arith_type;
        }
        return "Int";
    }
    if CharAt(text, 0) == "\"" {
        return "String";
    }
    if text == "true" || text == "false" {
        return "Bool";
    }
    if IsIntLiteral(text) {
        return "Int";
    }
    if IsFloatLiteral(text) {
        return "Float";
    }
    let option_type: String = OptionCallReturnType(text, names, types, func_names, func_rets);
    if StringLength(option_type) > 0 {
        return option_type;
    }
    let result_type: String = ResultCallReturnType(text, names, types, func_names, func_rets);
    if StringLength(result_type) > 0 {
        return result_type;
    }
    let machine_layer_type: String = MachineLayerBuiltinReturnType(
        text, names, types, func_names, func_rets
    );
    if machine_layer_type != "" {
        return machine_layer_type;
    }
    let scalar_utility_type: String = ScalarUtilityReturnType(text, names, types, func_names, func_rets);
    if StringLength(scalar_utility_type) > 0 {
        return scalar_utility_type;
    }
    let call_type: String = CallReturnType(text, func_names, func_rets);
    if call_type != "Unknown" {
        return call_type;
    }
    if IsIdentText(text) {
        return EnvLookup(names, types, text);
    }
    return "Unknown";
}
import "callable_resolution_owner.pgy";
