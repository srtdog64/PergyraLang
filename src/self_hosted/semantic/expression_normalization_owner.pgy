// Semantic expression normalization before type and validation consumers.
//
// Parser artifacts preserve full-expression parentheses around infix rows.
// This owner removes only wrappers that cover the complete expression; inner
// grouping and string contents remain unchanged.

import "text_scan_owner.pgy";
import "../lib/source_scan_owner.pgy";

func SemanticTrimSourceReuse(expr: String) -> String {
    let source_length: Int = StringLength(expr);
    let start: Int = 0;
    let end: Int = source_length;
    while start < end && SourceByteIsWhitespace(
        SourceByteAt(expr, source_length, start)
    ) {
        start = start + 1;
    }
    while end > start && SourceByteIsWhitespace(
        SourceByteAt(expr, source_length, end - 1)
    ) {
        end = end - 1;
    }
    if start == 0 && end == source_length {
        return expr;
    }
    return Substring(expr, start, end - start);
}

func SemanticStripOuterParens(expr: String) -> String {
    let text: String = SemanticTrimSourceReuse(expr);
    let keep_scanning: Bool = true;
    while keep_scanning && StringLength(text) >= 2 &&
        SourceByteAt(text, StringLength(text), 0) == SourceByteOf("(") {
        let depth: Int = 0;
        let close: Int = -1;
        let i: Int = 0;
        while i < StringLength(text) && close < 0 {
            let c: Int = SourceByteAt(text, StringLength(text), i);
            if c == SourceByteOf("\"") {
                i = i + 1;
                while i < StringLength(text) &&
                    SourceByteAt(text, StringLength(text), i) !=
                        SourceByteOf("\"") {
                    if SourceByteAt(text, StringLength(text), i) ==
                        SourceByteOf("\\") {
                        i = i + 1;
                    }
                    i = i + 1;
                }
                i = i + 1;
                continue;
            }
            if c == SourceByteOf("(") {
                depth = depth + 1;
            } else if c == SourceByteOf(")") {
                depth = depth - 1;
                if depth == 0 {
                    close = i;
                }
            }
            i = i + 1;
        }
        if close != StringLength(text) - 1 {
            keep_scanning = false;
        } else {
            let inner_start: Int = 1;
            let inner_end: Int = StringLength(text) - 1;
            while inner_start < inner_end && SourceByteIsWhitespace(
                SourceByteAt(text, StringLength(text), inner_start)
            ) {
                inner_start = inner_start + 1;
            }
            while inner_end > inner_start && SourceByteIsWhitespace(
                SourceByteAt(text, StringLength(text), inner_end - 1)
            ) {
                inner_end = inner_end - 1;
            }
            text = Substring(
                text, inner_start, inner_end - inner_start
            );
        }
    }
    return text;
}

func SemanticExpressionNormalizationContractReady() -> Bool {
    return SemanticStripOuterParens("((x + 2))") == "x + 2" &&
        SemanticStripOuterParens("(x) + 2") == "(x) + 2" &&
        SemanticStripOuterParens("(\"(x)\")") == "\"(x)\"";
}
