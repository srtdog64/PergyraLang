// Operand shapes the text-level expression checker cannot resolve.
//
// `ExprType` types expression source text. Two operand shapes defeat its
// arithmetic path: a member path, because there is no nominal field table at
// this level, and an indexed element, whose split candidate that scanner does
// not find. `ArithmeticResultType` reports either as Int, a default consumers
// outside the checker rely on, so the refusal sites consult this owner instead
// of reading that default as a resolved type. Both shapes type correctly on
// their own, outside the arithmetic path.

import "../lib/source_scan_owner.pgy";
import "expression_normalization_owner.pgy";

func SemanticExpressionTextCarriesMemberPath(expr: String) -> Bool {
    let text: String = SemanticTrimSourceReuse(expr);
    let n: Int = StringLength(text);
    let i: Int = 0;
    while i < n {
        let c: String = CharAt(text, i);
        if c == "\"" {
            i = i + 1;
            while i < n && CharAt(text, i) != "\"" {
                if CharAt(text, i) == "\\" { i = i + 1; }
                i = i + 1;
            }
            i = i + 1;
            continue;
        }
        if c == "." && i > 0 && i + 1 < n {
            let before: String = CharAt(text, i - 1);
            let after: String = CharAt(text, i + 1);
            if (IsAlphaNum(before) || before == "_" || before == ")" ||
                before == "]") && StringIndexOf("0123456789", after) < 0 {
                return true;
            }
        }
        if c == "[" && i > 0 {
            let prior: String = CharAt(text, i - 1);
            if IsAlphaNum(prior) || prior == "_" || prior == ")" ||
                prior == "]" {
                return true;
            }
        }
        i = i + 1;
    }
    return false;
}
