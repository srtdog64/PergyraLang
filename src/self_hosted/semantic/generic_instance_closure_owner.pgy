// One target-independent closure of admitted generic call substitutions.
// Template identity is a declaration handle; instance identity is that handle
// plus the ordered actual tuple. Neither symbols nor backend storage select it.
import "ast_signature_type_expression_fact_owner.pgy";

struct GenericInstanceTemplates {
    valid: Bool;
    syntax_ids: Array<Int>;
    generic_starts: Array<Int>;
    generic_counts: Array<Int>;
    generic_names: Array<String>;
}

struct GenericInstanceRecipes {
    valid: Bool;
    callers: Array<Int>;
    targets: Array<Int>;
    actual_starts: Array<Int>;
    actual_counts: Array<Int>;
    actual_types: Array<String>;
}

struct GenericInstanceClosure {
    valid: Bool;
    diagnostic: String;
    template_rows: Array<Int>;
    actual_starts: Array<Int>;
    actual_counts: Array<Int>;
    actual_types: Array<String>;
    call_contexts: Array<Int>;
    call_recipes: Array<Int>;
    call_targets: Array<Int>;
}

func GenericInstanceTemplatesEmpty() -> GenericInstanceTemplates {
    let ints: Array<Int> = [];
    let names: Array<String> = [];
    return GenericInstanceTemplates(true, ints, ints, ints, names);
}

func GenericInstanceClosureEmpty() -> GenericInstanceClosure {
    let ints: Array<Int> = [];
    let types: Array<String> = [];
    return GenericInstanceClosure(true, "", ints, ints, ints, types, ints, ints, ints);
}

func GenericInstanceClosureError(message: String) -> GenericInstanceClosure {
    var result: GenericInstanceClosure = GenericInstanceClosureEmpty();
    result.valid = false;
    result.diagnostic = message;
    return result;
}

func GenericInstanceTemplatesReady(ref templates: GenericInstanceTemplates) -> Bool {
    let count: Int = ArrayLength(templates.syntax_ids);
    if !templates.valid || count != ArrayLength(templates.generic_starts) ||
        count != ArrayLength(templates.generic_counts) { return false; }
    var row: Int = 0;
    var expected: Int = 0;
    while row < count {
        let size: Int = templates.generic_counts[row];
        if templates.syntax_ids[row] <= 0 || templates.generic_starts[row] != expected ||
            size < 0 || expected + size > ArrayLength(templates.generic_names) { return false; }
        var prior: Int = 0;
        while prior < row {
            if templates.syntax_ids[prior] == templates.syntax_ids[row] { return false; }
            prior = prior + 1;
        }
        var formal: Int = 0;
        while formal < size {
            let name: String = templates.generic_names[expected + formal];
            if name == "" { return false; }
            prior = 0;
            while prior < formal {
                if templates.generic_names[expected + prior] == name { return false; }
                prior = prior + 1;
            }
            formal = formal + 1;
        }
        expected = expected + size;
        row = row + 1;
    }
    return expected == ArrayLength(templates.generic_names);
}

func GenericInstanceRecipesReady(
    ref templates: GenericInstanceTemplates, ref recipes: GenericInstanceRecipes
) -> Bool {
    let count: Int = ArrayLength(recipes.targets);
    if !recipes.valid || count != ArrayLength(recipes.callers) ||
        count != ArrayLength(recipes.actual_starts) ||
        count != ArrayLength(recipes.actual_counts) { return false; }
    var row: Int = 0;
    var expected: Int = 0;
    while row < count {
        let target: Int = recipes.targets[row];
        let caller: Int = recipes.callers[row];
        let size: Int = recipes.actual_counts[row];
        if target < 0 || target >= ArrayLength(templates.syntax_ids) || caller < -1 ||
            caller >= ArrayLength(templates.syntax_ids) || size <= 0 ||
            size != templates.generic_counts[target] || recipes.actual_starts[row] != expected ||
            expected + size > ArrayLength(recipes.actual_types) { return false; }
        var actual: Int = 0;
        while actual < size {
            if recipes.actual_types[expected + actual] == "" { return false; }
            actual = actual + 1;
        }
        expected = expected + size;
        row = row + 1;
    }
    return expected == ArrayLength(recipes.actual_types);
}

func GenericInstanceActuals(ref closure: GenericInstanceClosure, instance: Int) -> Array<String> {
    var actuals: Array<String> = [];
    if !closure.valid || instance < 0 || instance >= ArrayLength(closure.template_rows) {
        return actuals;
    }
    var i: Int = 0;
    while i < closure.actual_counts[instance] {
        ArrayPushOwnedString(actuals, closure.actual_types[closure.actual_starts[instance] + i]);
        i = i + 1;
    }
    return actuals;
}

func GenericInstanceActualTupleKey(ref closure: GenericInstanceClosure, instance: Int) -> String {
    let actuals: Array<String> = GenericInstanceActuals(closure, instance);
    var key: String = "";
    var actual: Int = 0;
    while actual < ArrayLength(actuals) {
        key = key + ToString(StringLength(actuals[actual])) + ":" + actuals[actual];
        actual = actual + 1;
    }
    return key;
}

func GenericInstanceAppend(
    ref templates: GenericInstanceTemplates, inout closure: GenericInstanceClosure,
    inout parents: Array<Int>, target: Int, ref actuals: Array<String>,
    parent: Int, expands_formal: Bool
) -> Int {
    var row: Int = 0;
    while row < ArrayLength(closure.template_rows) {
        if closure.template_rows[row] == target && closure.actual_counts[row] == ArrayLength(actuals) {
            var equal: Bool = true;
            var i: Int = 0;
            while i < ArrayLength(actuals) {
                if closure.actual_types[closure.actual_starts[row] + i] != actuals[i] { equal = false; }
                i = i + 1;
            }
            if equal { return row; }
        }
        row = row + 1;
    }
    // Reusing an existing tuple is finite. An expanding edge closing a
    // recursion cycle cannot authorize an unbounded sequence of new bodies.
    var ancestor: Int = parent;
    while ancestor >= 0 {
        if ancestor >= ArrayLength(parents) || parents[ancestor] >= ancestor ||
            (expands_formal && closure.template_rows[ancestor] == target) { return -1; }
        ancestor = parents[ancestor];
    }
    let instance: Int = ArrayLength(closure.template_rows);
    var template_rows: Array<Int> = closure.template_rows;
    var actual_starts: Array<Int> = closure.actual_starts;
    var actual_counts: Array<Int> = closure.actual_counts;
    // A member view has no uniform element-ownership grant; publish into fresh storage.
    var actual_types: Array<String> = [];
    var prior: Int = 0;
    while prior < ArrayLength(closure.actual_types) {
        ArrayPushOwnedString(actual_types, closure.actual_types[prior]);
        prior = prior + 1;
    }
    ArrayPush(template_rows, target);
    ArrayPush(actual_starts, ArrayLength(actual_types));
    ArrayPush(actual_counts, ArrayLength(actuals));
    ArrayPush(parents, parent);
    var i: Int = 0;
    while i < ArrayLength(actuals) {
        ArrayPushOwnedString(actual_types, actuals[i]);
        i = i + 1;
    }
    closure.template_rows = template_rows;
    closure.actual_starts = actual_starts;
    closure.actual_counts = actual_counts;
    closure.actual_types = actual_types;
    return instance;
}

func GenericInstanceClosureFromRecipes(
    ref templates: GenericInstanceTemplates, ref recipes: GenericInstanceRecipes
) -> GenericInstanceClosure {
    if !GenericInstanceTemplatesReady(templates) || !GenericInstanceRecipesReady(templates, recipes) {
        return GenericInstanceClosureError("generic instance closure requires admitted template and call identities");
    }
    let empty_types: Array<String> = [];
    let expressions: SemanticAstSignatureTypeExpressionFacts =
        SemanticAstSignatureTypeExpressionFactsFromRows(recipes.actual_types, empty_types);
    if !expressions.ok {
        return GenericInstanceClosureError("generic actual type expression is malformed");
    }
    // Index recipes once by their owner. Slot zero is the closed, nongeneric
    // context; other slots are generic templates, not recursively rescanned MIR.
    var owner_counts: Array<Int> = [0];
    var owner_starts: Array<Int> = [];
    var owner_cursors: Array<Int> = [];
    var template: Int = 0;
    while template < ArrayLength(templates.syntax_ids) {
        ArrayPush(owner_counts, 0);
        template = template + 1;
    }
    var row: Int = 0;
    while row < ArrayLength(recipes.targets) {
        var owner: Int = 0;
        let caller: Int = recipes.callers[row];
        if caller >= 0 && templates.generic_counts[caller] > 0 { owner = caller + 1; }
        ArraySet(owner_counts, owner, owner_counts[owner] + 1);
        row = row + 1;
    }
    var offset: Int = 0;
    row = 0;
    while row < ArrayLength(owner_counts) {
        ArrayPush(owner_starts, offset);
        ArrayPush(owner_cursors, offset);
        offset = offset + owner_counts[row];
        row = row + 1;
    }
    var ordered_recipes: Array<Int> = [];
    row = 0;
    while row < ArrayLength(recipes.targets) { ArrayPush(ordered_recipes, -1); row = row + 1; }
    row = 0;
    while row < ArrayLength(recipes.targets) {
        var owner: Int = 0;
        let caller: Int = recipes.callers[row];
        if caller >= 0 && templates.generic_counts[caller] > 0 { owner = caller + 1; }
        ArraySet(ordered_recipes, owner_cursors[owner], row);
        ArraySet(owner_cursors, owner, owner_cursors[owner] + 1);
        row = row + 1;
    }
    var result: GenericInstanceClosure = GenericInstanceClosureEmpty();
    var parents: Array<Int> = [];
    var instance: Int = -1;
    while instance < ArrayLength(result.template_rows) {
        var owner: Int = 0;
        var caller: Int = -1;
        var caller_actuals: Array<String> = [];
        if instance >= 0 {
            caller = result.template_rows[instance];
            owner = caller + 1;
            caller_actuals = GenericInstanceActuals(result, instance);
        }
        var occurrence: Int = owner_starts[owner];
        let end: Int = occurrence + owner_counts[owner];
        while occurrence < end {
            let recipe: Int = ordered_recipes[occurrence];
            var actuals: Array<String> = [];
            var expands: Bool = false;
            var a: Int = 0;
            while a < recipes.actual_counts[recipe] {
                let actual_row: Int = recipes.actual_starts[recipe] + a;
                let root: Int = expressions.return_roots[actual_row];
                var actual: String = recipes.actual_types[actual_row];
                if caller >= 0 {
                    if expressions.child_counts[root] > 0 &&
                        SemanticAstSignatureTypeExpressionRootHasFormal(expressions, root,
                            templates.generic_starts[caller], templates.generic_counts[caller],
                            templates.generic_names.Slice(
                                0, ArrayLength(templates.generic_names))) {
                        expands = true;
                    }
                    let bound: Option<String> = SemanticAstSignatureTypeExpressionResolveRoot(
                        expressions, root, templates.generic_starts[caller],
                        templates.generic_counts[caller],
                        templates.generic_names.Slice(
                            0, ArrayLength(templates.generic_names)),
                        caller_actuals.Slice(0, ArrayLength(caller_actuals)));
                    if !IsSome(bound) {
                        return GenericInstanceClosureError("generic caller substitution is incomplete");
                    }
                    actual = UnwrapOption(bound);
                }
                // Published tuples outlive the readonly recipe/substitution view.
                ArrayPushOwnedString(actuals, actual);
                a = a + 1;
            }
            let target: Int = GenericInstanceAppend(templates, result, parents,
                recipes.targets[recipe], actuals, instance, expands);
            if target < 0 {
                return GenericInstanceClosureError("constructor-expanding recursive specialization has no admitted finite closure");
            }
            var call_contexts: Array<Int> = result.call_contexts;
            var call_recipes: Array<Int> = result.call_recipes;
            var call_targets: Array<Int> = result.call_targets;
            ArrayPush(call_contexts, instance);
            ArrayPush(call_recipes, recipe);
            ArrayPush(call_targets, target);
            result.call_contexts = call_contexts;
            result.call_recipes = call_recipes;
            result.call_targets = call_targets;
            occurrence = occurrence + 1;
        }
        instance = instance + 1;
    }
    return result;
}
