// src/self_hosted/semantic/main.pgy
//
// Status: rung-2 (2026-06-16). Pergyra-origin semantic substitution slice.
// It checks a bounded function-body subset against the C compiler oracle:
// typed params, typed `let`, return typing, branch conditions, assignment,
// call arity/argument types, and simple undefined identifier use. Expression
// typing now covers literals, identifiers, unary not, top-level binary
// operators (arithmetic yields Int, comparison and logical yield Bool), and
// function calls typed by a signature table seeded with built-ins and the
// program's own functions.

func CharAt(s: String, i: Int) -> String {
    let n: Int = StringLength(s);
    if i < 0 {
        return "";
    }
    if i >= n {
        return "";
    }
    return Substring(s, i, 1);
}

func IsAlpha(c: String) -> Bool {
    if StringLength(c) != 1 {
        return false;
    }
    return StringIndexOf("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c) >= 0;
}

func IsDigit(c: String) -> Bool {
    if StringLength(c) != 1 {
        return false;
    }
    return StringIndexOf("0123456789", c) >= 0;
}

func IsAlphaNum(c: String) -> Bool {
    return IsAlpha(c) || IsDigit(c);
}

func SkipWhitespaceAndComments(content: String, start: Int) -> Int {
    let n: Int = StringLength(content);
    let i: Int = start;
    while i < n {
        let c: String = CharAt(content, i);
        if c == " " || c == "\t" || c == "\n" || c == "\r" {
            i = i + 1;
            continue;
        }
        if c == "/" && CharAt(content, i + 1) == "/" {
            while i < n && CharAt(content, i) != "\n" {
                i = i + 1;
            }
            continue;
        }
        if c == "/" && CharAt(content, i + 1) == "*" {
            i = i + 2;
            while i < n {
                if CharAt(content, i) == "*" && CharAt(content, i + 1) == "/" {
                    i = i + 2;
                    break;
                }
                i = i + 1;
            }
            continue;
        }
        return i;
    }
    return i;
}

func MatchKeyword(content: String, start: Int, kw: String) -> Bool {
    let i: Int = SkipWhitespaceAndComments(content, start);
    let n: Int = StringLength(content);
    let kl: Int = StringLength(kw);
    if i + kl > n {
        return false;
    }
    if Substring(content, i, kl) != kw {
        return false;
    }
    let next: String = CharAt(content, i + kl);
    return !IsAlphaNum(next);
}

func ReadIdent(content: String, start: Int, cursor_out: Array<Int>) -> String {
    let i: Int = SkipWhitespaceAndComments(content, start);
    let n: Int = StringLength(content);
    if !IsAlpha(CharAt(content, i)) {
        ArraySet(cursor_out, 0, i);
        return "";
    }
    let end: Int = i + 1;
    while end < n && IsAlphaNum(CharAt(content, end)) {
        end = end + 1;
    }
    ArraySet(cursor_out, 0, end);
    return Substring(content, i, end - i);
}

func Trim(content: String) -> String {
    let start: Int = 0;
    let end: Int = StringLength(content);
    while start < end {
        let c: String = CharAt(content, start);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            break;
        }
        start = start + 1;
    }
    while end > start {
        let c2: String = CharAt(content, end - 1);
        if c2 != " " && c2 != "\t" && c2 != "\n" && c2 != "\r" {
            break;
        }
        end = end - 1;
    }
    return Substring(content, start, end - start);
}

func ReadTypeName(content: String, start: Int, cursor_out: Array<Int>) -> String {
    let i: Int = SkipWhitespaceAndComments(content, start);
    let n: Int = StringLength(content);
    let depth: Int = 0;
    let end: Int = i;
    while end < n {
        let c: String = CharAt(content, end);
        if c == "<" {
            depth = depth + 1;
        } else if c == ">" {
            if depth > 0 {
                depth = depth - 1;
            }
        } else if depth == 0 {
            if c == "," || c == ")" || c == "{" || c == ";" || c == "=" {
                break;
            }
        }
        end = end + 1;
    }
    ArraySet(cursor_out, 0, end);
    return Trim(Substring(content, i, end - i));
}

func ExpectLiteral(content: String, start: Int, tok: String) -> Int {
    let i: Int = SkipWhitespaceAndComments(content, start);
    let tl: Int = StringLength(tok);
    if Substring(content, i, tl) != tok {
        return -1;
    }
    return i + tl;
}

func FindStatementEnd(content: String, start: Int, limit: Int) -> Int {
    let i: Int = start;
    let depth: Int = 0;
    while i < limit {
        let c: String = CharAt(content, i);
        if c == "\"" {
            i = i + 1;
            while i < limit && CharAt(content, i) != "\"" {
                if CharAt(content, i) == "\\" {
                    i = i + 1;
                }
                i = i + 1;
            }
        } else if c == "(" || c == "[" {
            depth = depth + 1;
        } else if c == ")" || c == "]" {
            if depth > 0 {
                depth = depth - 1;
            }
        } else if depth == 0 && c == ";" {
            return i;
        }
        i = i + 1;
    }
    return limit;
}

func FindMatchingBrace(content: String, open_idx: Int) -> Int {
    let n: Int = StringLength(content);
    let i: Int = open_idx;
    let depth: Int = 0;
    while i < n {
        let c: String = CharAt(content, i);
        if c == "\"" {
            i = i + 1;
            while i < n && CharAt(content, i) != "\"" {
                if CharAt(content, i) == "\\" {
                    i = i + 1;
                }
                i = i + 1;
            }
        } else if c == "{" {
            depth = depth + 1;
        } else if c == "}" {
            depth = depth - 1;
            if depth == 0 {
                return i;
            }
        }
        i = i + 1;
    }
    return n;
}

func EnvLookup(names: Array<String>, types: Array<String>, name: String) -> String {
    let i: Int = ArrayLength(names) - 1;
    while i >= 0 {
        if names[i] == name {
            return types[i];
        }
        i = i - 1;
    }
    return "Unknown";
}

func EnvContainsName(names: Array<String>, name: String) -> Bool {
    let i: Int = ArrayLength(names) - 1;
    while i >= 0 {
        if names[i] == name {
            return true;
        }
        i = i - 1;
    }
    return false;
}

func IsIdentText(text: String) -> Bool {
    if StringLength(text) == 0 {
        return false;
    }
    if !IsAlpha(CharAt(text, 0)) {
        return false;
    }
    let i: Int = 1;
    while i < StringLength(text) {
        if !IsAlphaNum(CharAt(text, i)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func IsIntLiteral(text: String) -> Bool {
    let i: Int = 0;
    let n: Int = StringLength(text);
    if n == 0 {
        return false;
    }
    if CharAt(text, 0) == "-" {
        i = 1;
    }
    if i >= n {
        return false;
    }
    while i < n {
        if !IsDigit(CharAt(text, i)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func TopLevelOpType(expr: String) -> String {
    let n: Int = StringLength(expr);
    let i: Int = 0;
    let depth: Int = 0;
    let found_logical: Bool = false;
    let found_compare: Bool = false;
    let found_arith: Bool = false;
    while i < n {
        let c: String = CharAt(expr, i);
        if c == "\"" {
            i = i + 1;
            while i < n && CharAt(expr, i) != "\"" {
                if CharAt(expr, i) == "\\" {
                    i = i + 1;
                }
                i = i + 1;
            }
            i = i + 1;
            continue;
        }
        if c == "(" || c == "[" {
            depth = depth + 1;
            i = i + 1;
            continue;
        }
        if c == ")" || c == "]" {
            if depth > 0 {
                depth = depth - 1;
            }
            i = i + 1;
            continue;
        }
        if depth != 0 {
            i = i + 1;
            continue;
        }
        let c2: String = CharAt(expr, i + 1);
        if c == "|" && c2 == "|" {
            found_logical = true;
            i = i + 2;
            continue;
        }
        if c == "&" && c2 == "&" {
            found_logical = true;
            i = i + 2;
            continue;
        }
        if c == "=" && c2 == "=" {
            found_compare = true;
            i = i + 2;
            continue;
        }
        if c == "!" && c2 == "=" {
            found_compare = true;
            i = i + 2;
            continue;
        }
        if c == "<" || c == ">" {
            found_compare = true;
            i = i + 1;
            continue;
        }
        if c == "+" || c == "*" || c == "/" {
            found_arith = true;
            i = i + 1;
            continue;
        }
        if c == "-" && c2 != ">" {
            found_arith = true;
            i = i + 1;
            continue;
        }
        i = i + 1;
    }
    if found_logical {
        return "Bool";
    }
    if found_compare {
        return "Bool";
    }
    if found_arith {
        return "Int";
    }
    return "";
}

func CallReturnType(text: String, func_names: Array<String>, func_rets: Array<String>) -> String {
    let n: Int = StringLength(text);
    if n == 0 {
        return "Unknown";
    }
    if CharAt(text, n - 1) != ")" {
        return "Unknown";
    }
    let paren: Int = StringIndexOf(text, "(");
    if paren <= 0 {
        return "Unknown";
    }
    let callee: String = Trim(Substring(text, 0, paren));
    if !IsIdentText(callee) {
        return "Unknown";
    }
    let i: Int = 0;
    while i < ArrayLength(func_names) {
        if func_names[i] == callee {
            return func_rets[i];
        }
        i = i + 1;
    }
    return "Unknown";
}

func ParamTypeOf(part: String) -> String {
    let colon: Int = StringIndexOf(part, ":");
    if colon < 0 {
        return "Unknown";
    }
    return Trim(Substring(part, colon + 1, StringLength(part) - colon - 1));
}

func ParamTypes(param_src: String) -> String {
    let n: Int = StringLength(param_src);
    let i: Int = 0;
    let depth: Int = 0;
    let part_start: Int = 0;
    let result: String = "";
    while i <= n {
        let at_end: Bool = i >= n;
        let c: String = "";
        if !at_end {
            c = CharAt(param_src, i);
        }
        if !at_end && (c == "<" || c == "(" || c == "[") {
            depth = depth + 1;
            i = i + 1;
            continue;
        }
        if !at_end && (c == ">" || c == ")" || c == "]") {
            if depth > 0 {
                depth = depth - 1;
            }
            i = i + 1;
            continue;
        }
        if at_end || (depth == 0 && c == ",") {
            let part: String = Trim(Substring(param_src, part_start, i - part_start));
            if StringLength(part) > 0 {
                let ptype: String = ParamTypeOf(part);
                if StringLength(result) > 0 {
                    result = Concat(result, "|");
                }
                result = Concat(result, ptype);
            }
            part_start = i + 1;
        }
        i = i + 1;
    }
    return result;
}

func NthExpected(sig: String, target: Int) -> String {
    let n: Int = StringLength(sig);
    let i: Int = 0;
    let field: Int = 0;
    let start: Int = 0;
    while i <= n {
        let at_end: Bool = i >= n;
        let c: String = "";
        if !at_end {
            c = CharAt(sig, i);
        }
        if at_end || c == "|" {
            if field == target {
                return Trim(Substring(sig, start, i - start));
            }
            field = field + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

func FindBlockOpen(content: String, start: Int, limit: Int) -> Int {
    let i: Int = start;
    let depth: Int = 0;
    while i < limit {
        let c: String = CharAt(content, i);
        if c == "\"" {
            i = i + 1;
            while i < limit && CharAt(content, i) != "\"" {
                if CharAt(content, i) == "\\" {
                    i = i + 1;
                }
                i = i + 1;
            }
        } else if c == "(" || c == "[" {
            depth = depth + 1;
        } else if c == ")" || c == "]" {
            if depth > 0 {
                depth = depth - 1;
            }
        } else if depth == 0 && c == "{" {
            return i;
        }
        i = i + 1;
    }
    return limit;
}

func ExprType(expr: String, names: Array<String>, types: Array<String>, func_names: Array<String>, func_rets: Array<String>) -> String {
    let text: String = Trim(expr);
    if StringLength(text) == 0 {
        return "Void";
    }
    if CharAt(text, 0) == "!" && CharAt(text, 1) != "=" {
        return "Bool";
    }
    let op_type: String = TopLevelOpType(text);
    if op_type != "" {
        return op_type;
    }
    if CharAt(text, 0) == "\"" {
        return "String";
    }
    if text == "true" || text == "false" {
        return "Bool";
    }
    if IsIntLiteral(text) {
        return "Int";
    }
    let call_type: String = CallReturnType(text, func_names, func_rets);
    if call_type != "Unknown" {
        return call_type;
    }
    if IsIdentText(text) {
        return EnvLookup(names, types, text);
    }
    return "Unknown";
}

func CheckUndefinedIdentifiers(expr: String, names: Array<String>) -> String {
    let text: String = Trim(expr);
    let n: Int = StringLength(text);
    let i: Int = 0;
    while i < n {
        let c: String = CharAt(text, i);
        if c == "\"" {
            i = i + 1;
            while i < n && CharAt(text, i) != "\"" {
                if CharAt(text, i) == "\\" {
                    i = i + 1;
                }
                i = i + 1;
            }
            i = i + 1;
            continue;
        }
        if IsAlpha(c) {
            let start: Int = i;
            i = i + 1;
            while i < n && IsAlphaNum(CharAt(text, i)) {
                i = i + 1;
            }
            let name: String = Substring(text, start, i - start);
            if name == "true" || name == "false" {
                continue;
            }
            if start > 0 && CharAt(text, start - 1) == "." {
                continue;
            }
            let after: Int = SkipWhitespaceAndComments(text, i);
            if after < n && CharAt(text, after) == "(" {
                continue;
            }
            if !EnvContainsName(names, name) {
                return Concat("SEMANTIC ERROR undefined_symbol name=", name);
            }
            continue;
        }
        i = i + 1;
    }
    return "";
}

func CompareCallArgs(callee: String, args_src: String, sig: String, names: Array<String>, types: Array<String>, func_names: Array<String>, func_rets: Array<String>) -> String {
    let n: Int = StringLength(args_src);
    let i: Int = 0;
    let depth: Int = 0;
    let part_start: Int = 0;
    let arg_index: Int = 0;
    while i <= n {
        let at_end: Bool = i >= n;
        let c: String = "";
        if !at_end {
            c = CharAt(args_src, i);
        }
        if !at_end && c == "\"" {
            i = i + 1;
            while i < n && CharAt(args_src, i) != "\"" {
                if CharAt(args_src, i) == "\\" {
                    i = i + 1;
                }
                i = i + 1;
            }
            i = i + 1;
            continue;
        }
        if !at_end && (c == "<" || c == "(" || c == "[") {
            depth = depth + 1;
            i = i + 1;
            continue;
        }
        if !at_end && (c == ">" || c == ")" || c == "]") {
            if depth > 0 {
                depth = depth - 1;
            }
            i = i + 1;
            continue;
        }
        if at_end || (depth == 0 && c == ",") {
            let part: String = Trim(Substring(args_src, part_start, i - part_start));
            if StringLength(part) > 0 {
                let undefined_error: String = CheckUndefinedIdentifiers(part, names);
                if StringLength(undefined_error) > 0 {
                    return undefined_error;
                }
                let expected: String = NthExpected(sig, arg_index);
                let actual: String = ExprType(part, names, types, func_names, func_rets);
                if StringLength(expected) > 0 && expected != "Unknown" && actual != "Unknown" && expected != actual {
                    return Concat("SEMANTIC ERROR call_arg_type_mismatch func=", Concat(callee, Concat(" expected=", Concat(expected, Concat(" actual=", actual)))));
                }
                arg_index = arg_index + 1;
            }
            part_start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

func NumToStr(n: Int) -> String {
    if n == 0 {
        return "0";
    }
    let digits: String = "0123456789";
    let result: String = "";
    let v: Int = n;
    while v > 0 {
        let d: Int = v - (v / 10) * 10;
        result = Concat(Substring(digits, d, 1), result);
        v = v / 10;
    }
    return result;
}

func ParamCount(sig: String) -> Int {
    if StringLength(sig) == 0 {
        return 0;
    }
    let n: Int = StringLength(sig);
    let i: Int = 0;
    let count: Int = 1;
    while i < n {
        if CharAt(sig, i) == "|" {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

func ArgCount(args_src: String) -> Int {
    let n: Int = StringLength(args_src);
    let i: Int = 0;
    let depth: Int = 0;
    let part_start: Int = 0;
    let count: Int = 0;
    while i <= n {
        let at_end: Bool = i >= n;
        let c: String = "";
        if !at_end {
            c = CharAt(args_src, i);
        }
        if !at_end && c == "\"" {
            i = i + 1;
            while i < n && CharAt(args_src, i) != "\"" {
                if CharAt(args_src, i) == "\\" {
                    i = i + 1;
                }
                i = i + 1;
            }
            i = i + 1;
            continue;
        }
        if !at_end && (c == "<" || c == "(" || c == "[") {
            depth = depth + 1;
            i = i + 1;
            continue;
        }
        if !at_end && (c == ">" || c == ")" || c == "]") {
            if depth > 0 {
                depth = depth - 1;
            }
            i = i + 1;
            continue;
        }
        if at_end || (depth == 0 && c == ",") {
            let part: String = Trim(Substring(args_src, part_start, i - part_start));
            if StringLength(part) > 0 {
                count = count + 1;
            }
            part_start = i + 1;
        }
        i = i + 1;
    }
    return count;
}

func CheckCall(text: String, names: Array<String>, types: Array<String>, func_names: Array<String>, func_rets: Array<String>, func_params: Array<String>) -> String {
    let trimmed: String = Trim(text);
    let tn: Int = StringLength(trimmed);
    if tn == 0 {
        return "";
    }
    if TopLevelOpType(trimmed) != "" {
        return "";
    }
    if CharAt(trimmed, tn - 1) != ")" {
        return "";
    }
    let paren: Int = StringIndexOf(trimmed, "(");
    if paren <= 0 {
        return "";
    }
    let callee: String = Trim(Substring(trimmed, 0, paren));
    if !IsIdentText(callee) {
        return "";
    }
    let idx: Int = 0;
    let found: Int = -1;
    while idx < ArrayLength(func_names) {
        if func_names[idx] == callee {
            found = idx;
        }
        idx = idx + 1;
    }
    if found < 0 {
        return "";
    }
    let sig: String = func_params[found];
    let args_src: String = Substring(trimmed, paren + 1, tn - paren - 2);
    let expected_count: Int = ParamCount(sig);
    let actual_count: Int = ArgCount(args_src);
    if expected_count != actual_count {
        return Concat("SEMANTIC ERROR call_arity_mismatch func=", Concat(callee, Concat(" expected=", Concat(NumToStr(expected_count), Concat(" actual=", NumToStr(actual_count))))));
    }
    if StringLength(sig) == 0 {
        return "";
    }
    return CompareCallArgs(callee, args_src, sig, names, types, func_names, func_rets);
}

func CheckBody(content: String, start: Int, end: Int, return_type: String, names: Array<String>, types: Array<String>, func_names: Array<String>, func_rets: Array<String>, func_params: Array<String>) -> String {
    let i: Int = start;
    let cursor: Array<Int> = [0];
    while i < end {
        i = SkipWhitespaceAndComments(content, i);
        if i >= end {
            break;
        }
        if MatchKeyword(content, i, "let") {
            i = i + 3;
            let name: String = ReadIdent(content, i, cursor);
            i = cursor[0];
            let declared_type: String = "Unknown";
            i = SkipWhitespaceAndComments(content, i);
            if CharAt(content, i) == ":" {
                declared_type = ReadTypeName(content, i + 1, cursor);
                i = cursor[0];
            }
            i = ExpectLiteral(content, i, "=");
            if i < 0 {
                i = FindStatementEnd(content, start, end) + 1;
                continue;
            }
            let semi: Int = FindStatementEnd(content, i, end);
            let let_call_error: String = CheckCall(Substring(content, i, semi - i), names, types, func_names, func_rets, func_params);
            if StringLength(let_call_error) > 0 {
                return let_call_error;
            }
            let let_expr: String = Substring(content, i, semi - i);
            let let_undefined_error: String = CheckUndefinedIdentifiers(let_expr, names);
            if StringLength(let_undefined_error) > 0 {
                return let_undefined_error;
            }
            let actual_type: String = ExprType(let_expr, names, types, func_names, func_rets);
            if declared_type != "Unknown" {
                if actual_type != "Unknown" {
                    if declared_type != actual_type {
                        return Concat("SEMANTIC ERROR let_type_mismatch expected=", Concat(declared_type, Concat(" actual=", actual_type)));
                    }
                }
            }
            ArrayPush(names, name);
            if declared_type != "Unknown" {
                ArrayPush(types, declared_type);
            } else {
                ArrayPush(types, actual_type);
            }
            i = semi + 1;
            continue;
        }
        if MatchKeyword(content, i, "return") {
            i = i + 6;
            let return_semi: Int = FindStatementEnd(content, i, end);
            let return_call_error: String = CheckCall(Substring(content, i, return_semi - i), names, types, func_names, func_rets, func_params);
            if StringLength(return_call_error) > 0 {
                return return_call_error;
            }
            let return_expr: String = Substring(content, i, return_semi - i);
            let return_undefined_error: String = CheckUndefinedIdentifiers(return_expr, names);
            if StringLength(return_undefined_error) > 0 {
                return return_undefined_error;
            }
            let return_actual_type: String = ExprType(return_expr, names, types, func_names, func_rets);
            if return_type != "Unknown" {
                if return_actual_type != "Unknown" {
                    if return_type != return_actual_type {
                        return Concat("SEMANTIC ERROR return_type_mismatch expected=", Concat(return_type, Concat(" actual=", return_actual_type)));
                    }
                }
            }
            i = return_semi + 1;
            continue;
        }
        if MatchKeyword(content, i, "if") || MatchKeyword(content, i, "while") {
            let cond_start: Int = i + 2;
            if MatchKeyword(content, i, "while") {
                cond_start = i + 5;
            }
            let block_open: Int = FindBlockOpen(content, cond_start, end);
            let cond_text: String = Trim(Substring(content, cond_start, block_open - cond_start));
            if StringLength(cond_text) > 0 {
                let cond_type: String = ExprType(cond_text, names, types, func_names, func_rets);
                if cond_type != "Unknown" {
                    if cond_type != "Bool" {
                        return Concat("SEMANTIC ERROR condition_not_bool expected=Bool actual=", cond_type);
                    }
                }
            }
            i = block_open + 1;
            continue;
        }
        let asn_name: String = ReadIdent(content, i, cursor);
        let asn_after: Int = SkipWhitespaceAndComments(content, cursor[0]);
        if StringLength(asn_name) > 0 && CharAt(content, asn_after) == "=" && CharAt(content, asn_after + 1) != "=" {
            if !EnvContainsName(names, asn_name) {
                return Concat("SEMANTIC ERROR undefined_symbol name=", asn_name);
            }
            let lhs_type: String = EnvLookup(names, types, asn_name);
            if lhs_type != "Unknown" {
                let asn_semi: Int = FindStatementEnd(content, asn_after + 1, end);
                let rhs_expr: String = Substring(content, asn_after + 1, asn_semi - asn_after - 1);
                let asn_undefined_error: String = CheckUndefinedIdentifiers(rhs_expr, names);
                if StringLength(asn_undefined_error) > 0 {
                    return asn_undefined_error;
                }
                let rhs_type: String = ExprType(rhs_expr, names, types, func_names, func_rets);
                if rhs_type != "Unknown" {
                    if lhs_type != rhs_type {
                        return Concat("SEMANTIC ERROR assign_type_mismatch expected=", Concat(lhs_type, Concat(" actual=", rhs_type)));
                    }
                }
                i = asn_semi + 1;
                continue;
            }
        }
        let stmt_end: Int = FindStatementEnd(content, i, end);
        let stmt_call_error: String = CheckCall(Substring(content, i, stmt_end - i), names, types, func_names, func_rets, func_params);
        if StringLength(stmt_call_error) > 0 {
            return stmt_call_error;
        }
        if stmt_end <= i {
            i = i + 1;
        } else {
            i = stmt_end + 1;
        }
    }
    return "";
}

func CheckFunction(content: String, func_pos: Int, cursor_out: Array<Int>, func_names: Array<String>, func_rets: Array<String>, func_params: Array<String>) -> String {
    let cursor: Array<Int> = [0];
    let names: Array<String> = [];
    let types: Array<String> = [];
    let i: Int = func_pos + 4;
    let fn_name: String = ReadIdent(content, i, cursor);
    i = cursor[0];
    i = ExpectLiteral(content, i, "(");
    if i < 0 || StringLength(fn_name) == 0 {
        ArraySet(cursor_out, 0, func_pos + 1);
        return "";
    }
    while true {
        i = SkipWhitespaceAndComments(content, i);
        if CharAt(content, i) == ")" {
            i = i + 1;
            break;
        }
        let param_name: String = ReadIdent(content, i, cursor);
        i = cursor[0];
        i = ExpectLiteral(content, i, ":");
        if i < 0 {
            ArraySet(cursor_out, 0, func_pos + 1);
            return "";
        }
        let param_type: String = ReadTypeName(content, i, cursor);
        i = cursor[0];
        ArrayPush(names, param_name);
        ArrayPush(types, param_type);
        i = SkipWhitespaceAndComments(content, i);
        if CharAt(content, i) == "," {
            i = i + 1;
            continue;
        }
        if CharAt(content, i) == ")" {
            i = i + 1;
            break;
        }
    }
    let return_type: String = "Void";
    i = SkipWhitespaceAndComments(content, i);
    if CharAt(content, i) == "-" && CharAt(content, i + 1) == ">" {
        return_type = ReadTypeName(content, i + 2, cursor);
        i = cursor[0];
    }
    i = SkipWhitespaceAndComments(content, i);
    if CharAt(content, i) != "{" {
        ArraySet(cursor_out, 0, i + 1);
        return "";
    }
    let close: Int = FindMatchingBrace(content, i);
    let body_error: String = CheckBody(content, i + 1, close, return_type, names, types, func_names, func_rets, func_params);
    ArraySet(cursor_out, 0, close + 1);
    return body_error;
}

func CheckProgram(content: String) -> String {
    let cursor: Array<Int> = [0];
    let func_names: Array<String> = [];
    let func_rets: Array<String> = [];
    let func_params: Array<String> = [];
    ArrayPush(func_names, "StringLength");
    ArrayPush(func_rets, "Int");
    ArrayPush(func_params, "String");
    ArrayPush(func_names, "StringIndexOf");
    ArrayPush(func_rets, "Int");
    ArrayPush(func_params, "String|String");
    ArrayPush(func_names, "ArrayLength");
    ArrayPush(func_rets, "Int");
    ArrayPush(func_params, "Unknown");
    ArrayPush(func_names, "Substring");
    ArrayPush(func_rets, "String");
    ArrayPush(func_params, "String|Int|Int");
    ArrayPush(func_names, "Concat");
    ArrayPush(func_rets, "String");
    ArrayPush(func_params, "String|String");
    ArrayPush(func_names, "ReadFile");
    ArrayPush(func_rets, "String");
    ArrayPush(func_params, "String");
    let n: Int = StringLength(content);
    let scan: Int = 0;
    while scan < n {
        scan = SkipWhitespaceAndComments(content, scan);
        if scan >= n {
            break;
        }
        if !MatchKeyword(content, scan, "func") {
            scan = scan + 1;
            continue;
        }
        let name_pos: Int = scan + 4;
        let fn_name: String = ReadIdent(content, name_pos, cursor);
        let after_name: Int = cursor[0];
        let open: Int = ExpectLiteral(content, after_name, "(");
        if open < 0 || StringLength(fn_name) == 0 {
            scan = scan + 4;
            continue;
        }
        let depth: Int = 1;
        let k: Int = open;
        while k < n && depth > 0 {
            let c: String = CharAt(content, k);
            if c == "(" {
                depth = depth + 1;
            } else if c == ")" {
                depth = depth - 1;
            }
            k = k + 1;
        }
        let param_src: String = Substring(content, open, k - 1 - open);
        let ret: String = "Void";
        k = SkipWhitespaceAndComments(content, k);
        if CharAt(content, k) == "-" && CharAt(content, k + 1) == ">" {
            ret = ReadTypeName(content, k + 2, cursor);
            k = cursor[0];
        }
        ArrayPush(func_names, fn_name);
        ArrayPush(func_rets, ret);
        ArrayPush(func_params, ParamTypes(param_src));
        scan = k;
    }
    let i: Int = 0;
    while i < n {
        i = SkipWhitespaceAndComments(content, i);
        if i >= n {
            break;
        }
        if MatchKeyword(content, i, "export") {
            i = i + 6;
            continue;
        }
        if MatchKeyword(content, i, "async") {
            i = i + 5;
            continue;
        }
        if MatchKeyword(content, i, "func") {
            let fn_error: String = CheckFunction(content, i, cursor, func_names, func_rets, func_params);
            if StringLength(fn_error) > 0 {
                return fn_error;
            }
            i = cursor[0];
            continue;
        }
        i = i + 1;
    }
    return "";
}

func Main() -> Void {
    let args: Array<String> = Args();
    if ArrayLength(args) < 1 {
        Log("SEMANTIC ERROR input_missing expected=source actual=none");
        Exit(1);
    }
    let content: String = ReadFile(args[0]);
    let error: String = CheckProgram(content);
    if StringLength(error) > 0 {
        Log(error);
        return;
    }
    Log("SEMANTIC OK");
}
