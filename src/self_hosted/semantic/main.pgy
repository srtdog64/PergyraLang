// src/self_hosted/semantic/main.pgy
//
// Status: rung-2 (2026-06-16). Pergyra-origin semantic substitution slice.
// It checks a bounded function-body subset against the C compiler oracle:
// typed params, typed `let`, return typing, scoped if/while bodies, branch
// conditions, assignment, call arity/argument types, and undefined identifier
// use. Expression typing now covers literals, identifiers, unary not,
// top-level binary operators (arithmetic yields Int, comparison and logical
// yield Bool), and function calls typed by a signature table seeded with
// built-ins and the program's own functions. Binary operands are checked for
// type agreement: comparison and arithmetic operators require equal left/right
// operand types (skipped when either side is Unknown), mirroring the C oracle's
// type_equals rule.

import "../lib/diagnostic.pgy";
import "text_scan_owner.pgy";
import "source_bundle_owner.pgy";
import "diagnostic_owner.pgy";
import "env_owner.pgy";
import "expr_type_owner.pgy";
import "call_check_owner.pgy";
import "body_check_owner.pgy";
import "program_check_owner.pgy";
import "semantic_run_owner.pgy";

func Main() -> Void {
    let args: Array<String> = Args();
    RunSemanticFromArgs(args);
}
