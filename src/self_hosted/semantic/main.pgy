// src/self_hosted/semantic/main.pgy
//
// Status: rung-1 minimal (2026-06-15). First Pergyra-origin semantic
// substitution slice. It checks a bounded function-body subset against the C
// compiler oracle: typed params, typed `let`, and return typing for
// Int/String/Bool/Void literal and identifier expressions.

func CharAt(s: String, i: Int) -> String {
    let n: Int = StringLength(s);
    if i < 0 {
        return "";
    }
    if i >= n {
        return "";
    }
    return Substring(s, i, 1);
}

func IsAlpha(c: String) -> Bool {
    if StringLength(c) != 1 {
        return false;
    }
    return StringIndexOf("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c) >= 0;
}

func IsDigit(c: String) -> Bool {
    if StringLength(c) != 1 {
        return false;
    }
    return StringIndexOf("0123456789", c) >= 0;
}

func IsAlphaNum(c: String) -> Bool {
    return IsAlpha(c) || IsDigit(c);
}

func SkipWhitespaceAndComments(content: String, start: Int) -> Int {
    let n: Int = StringLength(content);
    let i: Int = start;
    while i < n {
        let c: String = CharAt(content, i);
        if c == " " || c == "\t" || c == "\n" || c == "\r" {
            i = i + 1;
            continue;
        }
        if c == "/" && CharAt(content, i + 1) == "/" {
            while i < n && CharAt(content, i) != "\n" {
                i = i + 1;
            }
            continue;
        }
        if c == "/" && CharAt(content, i + 1) == "*" {
            i = i + 2;
            while i < n {
                if CharAt(content, i) == "*" && CharAt(content, i + 1) == "/" {
                    i = i + 2;
                    break;
                }
                i = i + 1;
            }
            continue;
        }
        return i;
    }
    return i;
}

func MatchKeyword(content: String, start: Int, kw: String) -> Bool {
    let i: Int = SkipWhitespaceAndComments(content, start);
    let n: Int = StringLength(content);
    let kl: Int = StringLength(kw);
    if i + kl > n {
        return false;
    }
    if Substring(content, i, kl) != kw {
        return false;
    }
    let next: String = CharAt(content, i + kl);
    return !IsAlphaNum(next);
}

func ReadIdent(content: String, start: Int, cursor_out: Array<Int>) -> String {
    let i: Int = SkipWhitespaceAndComments(content, start);
    let n: Int = StringLength(content);
    if !IsAlpha(CharAt(content, i)) {
        ArraySet(cursor_out, 0, i);
        return "";
    }
    let end: Int = i + 1;
    while end < n && IsAlphaNum(CharAt(content, end)) {
        end = end + 1;
    }
    ArraySet(cursor_out, 0, end);
    return Substring(content, i, end - i);
}

func Trim(content: String) -> String {
    let start: Int = 0;
    let end: Int = StringLength(content);
    while start < end {
        let c: String = CharAt(content, start);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            break;
        }
        start = start + 1;
    }
    while end > start {
        let c2: String = CharAt(content, end - 1);
        if c2 != " " && c2 != "\t" && c2 != "\n" && c2 != "\r" {
            break;
        }
        end = end - 1;
    }
    return Substring(content, start, end - start);
}

func ReadTypeName(content: String, start: Int, cursor_out: Array<Int>) -> String {
    let i: Int = SkipWhitespaceAndComments(content, start);
    let n: Int = StringLength(content);
    let depth: Int = 0;
    let end: Int = i;
    while end < n {
        let c: String = CharAt(content, end);
        if c == "<" {
            depth = depth + 1;
        } else if c == ">" {
            if depth > 0 {
                depth = depth - 1;
            }
        } else if depth == 0 {
            if c == "," || c == ")" || c == "{" || c == ";" || c == "=" {
                break;
            }
        }
        end = end + 1;
    }
    ArraySet(cursor_out, 0, end);
    return Trim(Substring(content, i, end - i));
}

func ExpectLiteral(content: String, start: Int, tok: String) -> Int {
    let i: Int = SkipWhitespaceAndComments(content, start);
    let tl: Int = StringLength(tok);
    if Substring(content, i, tl) != tok {
        return -1;
    }
    return i + tl;
}

func FindStatementEnd(content: String, start: Int, limit: Int) -> Int {
    let i: Int = start;
    let depth: Int = 0;
    while i < limit {
        let c: String = CharAt(content, i);
        if c == "\"" {
            i = i + 1;
            while i < limit && CharAt(content, i) != "\"" {
                i = i + 1;
            }
        } else if c == "(" || c == "[" {
            depth = depth + 1;
        } else if c == ")" || c == "]" {
            if depth > 0 {
                depth = depth - 1;
            }
        } else if depth == 0 && c == ";" {
            return i;
        }
        i = i + 1;
    }
    return limit;
}

func FindMatchingBrace(content: String, open_idx: Int) -> Int {
    let n: Int = StringLength(content);
    let i: Int = open_idx;
    let depth: Int = 0;
    while i < n {
        let c: String = CharAt(content, i);
        if c == "\"" {
            i = i + 1;
            while i < n && CharAt(content, i) != "\"" {
                i = i + 1;
            }
        } else if c == "{" {
            depth = depth + 1;
        } else if c == "}" {
            depth = depth - 1;
            if depth == 0 {
                return i;
            }
        }
        i = i + 1;
    }
    return n;
}

func EnvLookup(names: Array<String>, types: Array<String>, name: String) -> String {
    let i: Int = ArrayLength(names) - 1;
    while i >= 0 {
        if names[i] == name {
            return types[i];
        }
        i = i - 1;
    }
    return "Unknown";
}

func IsIdentText(text: String) -> Bool {
    if StringLength(text) == 0 {
        return false;
    }
    if !IsAlpha(CharAt(text, 0)) {
        return false;
    }
    let i: Int = 1;
    while i < StringLength(text) {
        if !IsAlphaNum(CharAt(text, i)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func IsIntLiteral(text: String) -> Bool {
    let i: Int = 0;
    let n: Int = StringLength(text);
    if n == 0 {
        return false;
    }
    if CharAt(text, 0) == "-" {
        i = 1;
    }
    if i >= n {
        return false;
    }
    while i < n {
        if !IsDigit(CharAt(text, i)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

func ExprType(expr: String, names: Array<String>, types: Array<String>) -> String {
    let text: String = Trim(expr);
    if StringLength(text) == 0 {
        return "Void";
    }
    if CharAt(text, 0) == "\"" {
        return "String";
    }
    if text == "true" || text == "false" {
        return "Bool";
    }
    if IsIntLiteral(text) {
        return "Int";
    }
    if IsIdentText(text) {
        return EnvLookup(names, types, text);
    }
    return "Unknown";
}

func CheckBody(content: String, start: Int, end: Int, return_type: String, names: Array<String>, types: Array<String>) -> String {
    let i: Int = start;
    let cursor: Array<Int> = [0];
    while i < end {
        i = SkipWhitespaceAndComments(content, i);
        if i >= end {
            break;
        }
        if MatchKeyword(content, i, "let") {
            i = i + 3;
            let name: String = ReadIdent(content, i, cursor);
            i = cursor[0];
            let declared_type: String = "Unknown";
            i = SkipWhitespaceAndComments(content, i);
            if CharAt(content, i) == ":" {
                declared_type = ReadTypeName(content, i + 1, cursor);
                i = cursor[0];
            }
            i = ExpectLiteral(content, i, "=");
            if i < 0 {
                i = FindStatementEnd(content, start, end) + 1;
                continue;
            }
            let semi: Int = FindStatementEnd(content, i, end);
            let actual_type: String = ExprType(Substring(content, i, semi - i), names, types);
            if declared_type != "Unknown" {
                if actual_type != "Unknown" {
                    if declared_type != actual_type {
                        return Concat("SEMANTIC ERROR let_type_mismatch expected=", Concat(declared_type, Concat(" actual=", actual_type)));
                    }
                }
            }
            ArrayPush(names, name);
            if declared_type != "Unknown" {
                ArrayPush(types, declared_type);
            } else {
                ArrayPush(types, actual_type);
            }
            i = semi + 1;
            continue;
        }
        if MatchKeyword(content, i, "return") {
            i = i + 6;
            let return_semi: Int = FindStatementEnd(content, i, end);
            let return_actual_type: String = ExprType(Substring(content, i, return_semi - i), names, types);
            if return_type != "Unknown" {
                if return_actual_type != "Unknown" {
                    if return_type != return_actual_type {
                        return Concat("SEMANTIC ERROR return_type_mismatch expected=", Concat(return_type, Concat(" actual=", return_actual_type)));
                    }
                }
            }
            i = return_semi + 1;
            continue;
        }
        let next: Int = FindStatementEnd(content, i, end);
        if next <= i {
            i = i + 1;
        } else {
            i = next + 1;
        }
    }
    return "";
}

func CheckFunction(content: String, func_pos: Int, cursor_out: Array<Int>) -> String {
    let cursor: Array<Int> = [0];
    let names: Array<String> = [];
    let types: Array<String> = [];
    let i: Int = func_pos + 4;
    let fn_name: String = ReadIdent(content, i, cursor);
    i = cursor[0];
    i = ExpectLiteral(content, i, "(");
    if i < 0 || StringLength(fn_name) == 0 {
        ArraySet(cursor_out, 0, func_pos + 1);
        return "";
    }
    while true {
        i = SkipWhitespaceAndComments(content, i);
        if CharAt(content, i) == ")" {
            i = i + 1;
            break;
        }
        let param_name: String = ReadIdent(content, i, cursor);
        i = cursor[0];
        i = ExpectLiteral(content, i, ":");
        if i < 0 {
            ArraySet(cursor_out, 0, func_pos + 1);
            return "";
        }
        let param_type: String = ReadTypeName(content, i, cursor);
        i = cursor[0];
        ArrayPush(names, param_name);
        ArrayPush(types, param_type);
        i = SkipWhitespaceAndComments(content, i);
        if CharAt(content, i) == "," {
            i = i + 1;
            continue;
        }
        if CharAt(content, i) == ")" {
            i = i + 1;
            break;
        }
    }
    let return_type: String = "Void";
    i = SkipWhitespaceAndComments(content, i);
    if CharAt(content, i) == "-" && CharAt(content, i + 1) == ">" {
        return_type = ReadTypeName(content, i + 2, cursor);
        i = cursor[0];
    }
    i = SkipWhitespaceAndComments(content, i);
    if CharAt(content, i) != "{" {
        ArraySet(cursor_out, 0, i + 1);
        return "";
    }
    let close: Int = FindMatchingBrace(content, i);
    let body_error: String = CheckBody(content, i + 1, close, return_type, names, types);
    ArraySet(cursor_out, 0, close + 1);
    return body_error;
}

func CheckProgram(content: String) -> String {
    let cursor: Array<Int> = [0];
    let i: Int = 0;
    let n: Int = StringLength(content);
    while i < n {
        i = SkipWhitespaceAndComments(content, i);
        if i >= n {
            break;
        }
        if MatchKeyword(content, i, "export") {
            i = i + 6;
            continue;
        }
        if MatchKeyword(content, i, "async") {
            i = i + 5;
            continue;
        }
        if MatchKeyword(content, i, "func") {
            let fn_error: String = CheckFunction(content, i, cursor);
            if StringLength(fn_error) > 0 {
                return fn_error;
            }
            i = cursor[0];
            continue;
        }
        i = i + 1;
    }
    return "";
}

func Main() -> Void {
    let args: Array<String> = Args();
    if ArrayLength(args) < 1 {
        Log("SEMANTIC ERROR input_missing expected=source actual=none");
        Exit(1);
    }
    let content: String = ReadFile(args[0]);
    let error: String = CheckProgram(content);
    if StringLength(error) > 0 {
        Log(error);
        return;
    }
    Log("SEMANTIC OK");
}
