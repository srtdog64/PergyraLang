// Semantic owner of the distinction between nominal storage fields and
// caller-supplied constructor arguments. Domain layer storage remains part of
// the nominal layout and must be materialized by the domain topology/runtime
// owner; the constructor does not accept it from the caller.

import "ast_nominal_constructor_fact_owner.pgy";
import "../lib/nominal_field_kind_owner.pgy";

func SemanticAstNominalConstructorFieldIsArgument(
    ref constructors: SemanticAstNominalConstructorFacts,
    constructor_index: Int,
    field_index: Int
) -> Bool {
    if constructor_index < 0 ||
        constructor_index >= SemanticAstNominalConstructorCount(constructors) ||
        field_index < 0 ||
        field_index >= constructors.param_counts[constructor_index] {
        return false;
    }
    if constructors.nominal_kinds[constructor_index] != "zone" {
        return true;
    }
    let kind: String = constructors.field_kinds[
        constructors.param_starts[constructor_index] + field_index
    ];
    // A zone receives identity-bearing subjects and explicit bindings.
    // object/tobject slots are projection products materialized by
    // refresh/publish; asking callers to construct them would create a
    // second authority beside the topology owner.
    return kind == NominalFieldKindSubjectSlot() ||
        kind == NominalFieldKindBindingSlot();
}

func SemanticAstNominalConstructorArgumentCountAt(
    ref constructors: SemanticAstNominalConstructorFacts,
    constructor_index: Int
) -> Int {
    if constructor_index < 0 ||
        constructor_index >= SemanticAstNominalConstructorCount(constructors) {
        return -1;
    }
    let count: Int = 0;
    let field_index: Int = 0;
    while field_index < constructors.param_counts[constructor_index] {
        if SemanticAstNominalConstructorFieldIsArgument(
            constructors, constructor_index, field_index
        ) {
            count = count + 1;
        }
        field_index = field_index + 1;
    }
    return count;
}

func SemanticAstNominalConstructorArgumentTypeAt(
    ref constructors: SemanticAstNominalConstructorFacts,
    constructor_index: Int,
    argument_index: Int
) -> Option<String> {
    if argument_index < 0 { return None; }
    let ordinal: Int = 0;
    let field_index: Int = 0;
    while field_index < constructors.param_counts[constructor_index] {
        if SemanticAstNominalConstructorFieldIsArgument(
            constructors, constructor_index, field_index
        ) {
            if ordinal == argument_index {
                return Some(constructors.param_type_names[
                    constructors.param_starts[constructor_index] + field_index
                ]);
            }
            ordinal = ordinal + 1;
        }
        field_index = field_index + 1;
    }
    return None;
}
