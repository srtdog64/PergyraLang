// Semantic owner of the distinction between nominal storage fields and
// caller-supplied constructor arguments. Domain layer storage remains part of
// the nominal layout and must be materialized by the domain topology/runtime
// owner; the constructor does not accept it from the caller.

import "ast_nominal_constructor_fact_owner.pgy";
import "../lib/nominal_field_kind_owner.pgy";

func SemanticAstNominalConstructorFieldIsArgument(
    ref constructors: SemanticAstNominalConstructorFacts,
    constructor_index: Int,
    field_index: Int
) -> Bool {
    if !constructors.ok || constructor_index < 0 ||
        constructor_index >= SemanticAstNominalConstructorCount(constructors) ||
        constructor_index >= ArrayLength(constructors.param_counts) ||
        constructor_index >= ArrayLength(constructors.param_starts) ||
        constructor_index >= ArrayLength(constructors.nominal_kinds) ||
        field_index < 0 ||
        field_index >= constructors.param_counts[constructor_index] {
        return false;
    }
    let nominal_kind: String = constructors.nominal_kinds[constructor_index];
    if nominal_kind != "zone" && nominal_kind != "relation" &&
        nominal_kind != "effect" {
        return true;
    }
    let row: Int = constructors.param_starts[constructor_index] + field_index;
    if row < 0 || row >= ArrayLength(constructors.field_kinds) { return false; }
    let kind: String = constructors.field_kinds[row];
    // A domain host receives identity-bearing subjects and explicit bindings.
    // object/tobject slots are projection products materialized by
    // refresh/publish; asking callers to construct them would create a
    // second authority beside the topology owner.
    return kind == NominalFieldKindSubjectSlot() ||
        kind == NominalFieldKindBindingSlot();
}

func SemanticAstNominalConstructorArgumentCountAt(
    ref constructors: SemanticAstNominalConstructorFacts,
    constructor_index: Int
) -> Option<Int> {
    if !constructors.ok || constructor_index < 0 ||
        constructor_index >= SemanticAstNominalConstructorCount(constructors) ||
        constructor_index >= ArrayLength(constructors.param_counts) ||
        constructor_index >= ArrayLength(constructors.param_starts) ||
        constructor_index >= ArrayLength(constructors.nominal_kinds) ||
        constructors.param_counts[constructor_index] < 0 {
        return None;
    }
    let start: Int = constructors.param_starts[constructor_index];
    let fields: Int = constructors.param_counts[constructor_index];
    if start < 0 || start > ArrayLength(constructors.field_source_syntax_ids) ||
        fields > ArrayLength(constructors.field_source_syntax_ids) - start {
        return None;
    }
    let end: Int = start + fields;
    if end > ArrayLength(constructors.field_names) ||
        end > ArrayLength(constructors.field_kinds) ||
        end > ArrayLength(constructors.param_type_names) { return None; }
    let count: Int = 0;
    let field_index: Int = 0;
    while field_index < constructors.param_counts[constructor_index] {
        if SemanticAstNominalConstructorFieldIsArgument(
            constructors, constructor_index, field_index
        ) {
            count = count + 1;
        }
        field_index = field_index + 1;
    }
    return Some(count);
}

func SemanticAstNominalConstructorArgumentFieldIndexAt(
    ref constructors: SemanticAstNominalConstructorFacts,
    constructor_index: Int,
    argument_index: Int
) -> Option<Int> {
    let count: Option<Int> = SemanticAstNominalConstructorArgumentCountAt(
        constructors, constructor_index);
    if !IsSome(count) || argument_index < 0 ||
        argument_index >= UnwrapOption(count) { return None; }
    let ordinal: Int = 0;
    let field_index: Int = 0;
    while field_index < constructors.param_counts[constructor_index] {
        if SemanticAstNominalConstructorFieldIsArgument(
            constructors, constructor_index, field_index
        ) {
            if ordinal == argument_index {
                return Some(field_index);
            }
            ordinal = ordinal + 1;
        }
        field_index = field_index + 1;
    }
    return None;
}

func SemanticAstNominalConstructorArgumentTypeAt(
    ref constructors: SemanticAstNominalConstructorFacts,
    constructor_index: Int, argument_index: Int
) -> Option<String> {
    let field: Option<Int> = SemanticAstNominalConstructorArgumentFieldIndexAt(
        constructors, constructor_index, argument_index);
    if !IsSome(field) { return None; }
    return Some(constructors.param_type_names[
        constructors.param_starts[constructor_index] + UnwrapOption(field)]);
}
