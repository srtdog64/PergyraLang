    ArrayPush(func_params, "Float");
    ArrayPush(func_names, "Cos");
    ArrayPush(func_rets, "Float");
    ArrayPush(func_params, "Float");
    ArrayPush(func_names, "Tan");
    ArrayPush(func_rets, "Float");
    ArrayPush(func_params, "Float");
    ArrayPush(func_names, "Asin");
    ArrayPush(func_rets, "Float");
    ArrayPush(func_params, "Float");
    ArrayPush(func_names, "Acos");
    ArrayPush(func_rets, "Float");
    ArrayPush(func_params, "Float");
    ArrayPush(func_names, "Atan");
    ArrayPush(func_rets, "Float");
    ArrayPush(func_params, "Float");
    ArrayPush(func_names, "Atan2");
    ArrayPush(func_rets, "Float");
    ArrayPush(func_params, "Float|Float");
    ArrayPush(func_names, "Round");
    ArrayPush(func_rets, "Float");
    ArrayPush(func_params, "Float");
    ArrayPush(func_names, "Exp");
    ArrayPush(func_rets, "Float");
    ArrayPush(func_params, "Float");
    ArrayPush(func_names, "MathLog");
    ArrayPush(func_rets, "Float");
    ArrayPush(func_params, "Float");
    ArrayPush(func_names, "Log10");
    ArrayPush(func_rets, "Float");
    ArrayPush(func_params, "Float");
    ArrayPush(func_names, "Log2");
    ArrayPush(func_rets, "Float");
    ArrayPush(func_params, "Float");
    ArrayPush(func_names, "Random");
    ArrayPush(func_rets, "Int");
    ArrayPush(func_params, "Int");
    ArrayPush(func_names, "SeedRandom");
    ArrayPush(func_rets, "Void");
    ArrayPush(func_params, "Int");
    ArrayPush(func_names, "Abs");
    ArrayPush(func_rets, "Unknown");
    ArrayPush(func_params, "Unknown");
    ArrayPush(func_names, "Min");
    ArrayPush(func_rets, "Unknown");
    ArrayPush(func_params, "Unknown|Unknown");
    ArrayPush(func_names, "Max");
    ArrayPush(func_rets, "Unknown");
    ArrayPush(func_params, "Unknown|Unknown");
    ArrayPush(func_names, "Clamp");
    ArrayPush(func_rets, "Unknown");
    ArrayPush(func_params, "Unknown|Unknown|Unknown");
    ArrayPush(func_names, "FileExists");
    ArrayPush(func_rets, "Bool");
    ArrayPush(func_params, "String");
    ArrayPush(func_names, "ToString");
    ArrayPush(func_rets, "String");
    ArrayPush(func_params, "Unknown");
    ArrayPush(func_names, "ToLower");
    ArrayPush(func_rets, "String");
    ArrayPush(func_params, "Unknown");
    ArrayPush(func_names, "ToUpper");
    ArrayPush(func_rets, "String");
    ArrayPush(func_params, "Unknown");
    ArrayPush(func_names, "Trim");
