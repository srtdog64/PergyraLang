// Self-host semantic program checking owner.

import "text_scan_owner.pgy";
import "expr_type_owner.pgy";
import "body_check_owner.pgy";
import "builtin_signature_owner.pgy";
import "callable_resolution_owner.pgy";
import "enum_callable_signature_owner.pgy";

func NominalDeclKeywordLength(
    content: String, content_length: Int, start: Int
) -> Int {
    if SemanticMatchKeywordWithin(content, content_length, start, "struct") {
        return 6;
    }
    if SemanticMatchKeywordWithin(content, content_length, start, "class") {
        return 5;
    }
    if SemanticMatchKeywordWithin(content, content_length, start, "subject") {
        return 7;
    }
    if SemanticMatchKeywordWithin(content, content_length, start, "object") {
        return 6;
    }
    if SemanticMatchKeywordWithin(content, content_length, start, "tobject") {
        return 7;
    }
    if SemanticMatchKeywordWithin(content, content_length, start, "vessel") {
        return 6;
    }
    if SemanticMatchKeywordWithin(content, content_length, start, "zone") {
        return 4;
    }
    if SemanticMatchKeywordWithin(content, content_length, start, "world") {
        return 5;
    }
    return 0;
}

func FindNominalFieldEnd(content: String, start: Int, limit: Int) -> Int {
    let i: Int = start;
    let depth: Int = 0;
    while i < limit {
        let c: Int = SourceByteAt(content, limit, i);
        if c == SourceByteOf("\"") {
            i = SkipQuotedString(content, i, limit);
            continue;
        }
        if c == SourceByteOf("<") || c == SourceByteOf("(") ||
            c == SourceByteOf("[") {
            depth = depth + 1;
        } else if c == SourceByteOf(">") || c == SourceByteOf(")") ||
            c == SourceByteOf("]") {
            if depth > 0 { depth = depth - 1; }
        } else if depth == 0 &&
            (c == SourceByteOf(",") || c == SourceByteOf(";") ||
             c == SourceByteOf("\n")) {
            return i;
        }
        i = i + 1;
    }
    return limit;
}

func NominalConstructorFieldNameStart(
    content: String, content_length: Int, start: Int
) -> Int {
    let i: Int = start;
    if SemanticMatchKeywordWithin(content, content_length, i, "let") {
        let after_let: Int = SkipWhitespaceAndCommentsWithin(
            content, content_length, i + 3
        );
        if SemanticMatchKeywordWithin(
            content, content_length, after_let, "mut"
        ) {
            return after_let + 3;
        }
        return after_let;
    }
    if SemanticMatchKeywordWithin(content, content_length, i, "zone") {
        return i + 4;
    }
    let prefix_length: Int = 0;
    if SemanticMatchKeywordWithin(content, content_length, i, "subject") {
        prefix_length = 7;
    } else if SemanticMatchKeywordWithin(
        content, content_length, i, "object"
    ) {
        prefix_length = 6;
    } else if SemanticMatchKeywordWithin(
        content, content_length, i, "tobject"
    ) {
        prefix_length = 7;
    }
    if prefix_length == 0 { return i; }
    let after_kind: Int = SkipWhitespaceAndCommentsWithin(
        content, content_length, i + prefix_length
    );
    if SemanticMatchKeywordWithin(
        content, content_length, after_kind, "slot"
    ) {
        return after_kind + 4;
    }
    return i + prefix_length;
}

func NominalConstructorParams(
    content: String, content_length: Int,
    body_open: Int, body_close: Int, inout cursor: Array<Int>
) -> String {
    let i: Int = body_open + 1;
    let depth: Int = 0;
    let params: String = "";
    while i < body_close {
        i = SkipWhitespaceAndCommentsWithin(content, content_length, i);
        if i >= body_close {
            break;
        }
        let c: String = CharAtWithin(content, content_length, i);
        if c == "\"" {
            i = SkipQuotedString(content, i, body_close);
            continue;
        }
        if c == "{" {
            depth = depth + 1;
            i = i + 1;
            continue;
        }
        if c == "}" {
            if depth > 0 {
                depth = depth - 1;
            }
            i = i + 1;
            continue;
        }
        if depth != 0 {
            i = i + 1;
            continue;
        }
        i = NominalConstructorFieldNameStart(
            content, content_length, i
        );
        let field_name: String = SemanticReadIdentWithin(
            content, content_length, i, cursor
        );
        i = cursor[0];
        i = SkipWhitespaceAndCommentsWithin(content, content_length, i);
        if StringLength(field_name) == 0 ||
            CharAtWithin(content, content_length, i) != ":" {
            let bad_field_end: Int =
                FindNominalFieldEnd(content, i, body_close);
            let bad_block_open: Int = FindBlockOpen(
                content, i, body_close
            );
            if bad_block_open < bad_field_end &&
                CharAtWithin(
                    content, content_length, bad_block_open
                ) == "{" {
                i = FindMatchingBraceWithin(
                    content, bad_block_open, body_close
                ) + 1;
            } else {
                i = bad_field_end + 1;
            }
            continue;
        }
        let type_start: Int = SkipWhitespaceAndCommentsWithin(
            content, content_length, i + 1
        );
        let field_end: Int = FindNominalFieldEnd(
            content, type_start, body_close
        );
        let field_type: String = Trim(Substring(
            content, type_start, field_end - type_start
        ));
        if StringLength(field_type) > 0 {
            if StringLength(params) > 0 {
                params = Concat(params, "|");
            }
            params = Concat(params, field_type);
        }
        i = field_end + 1;
    }
    return params;
}

func SeedNominalConstructors(content: String, inout func_names: Array<String>, inout func_rets: Array<String>, inout func_params: Array<String>) -> Void {
    let n: Int = StringLength(content);
    let scan: Int = 0;
    let cursor: Array<Int> = [0];
    while scan < n {
        scan = SkipWhitespaceAndCommentsWithin(content, n, scan);
        if scan >= n {
            break;
        }
        if CharAtWithin(content, n, scan) == "\"" {
            scan = SkipQuotedString(content, scan, n);
            continue;
        }
        let kw_len: Int = NominalDeclKeywordLength(content, n, scan);
        if kw_len == 0 {
            scan = scan + 1;
            continue;
        }
        let name: String = SemanticReadIdentWithin(
            content, n, scan + kw_len, cursor
        );
        let after_name: Int = cursor[0];
        if StringLength(name) == 0 {
            scan = scan + kw_len;
            continue;
        }
        let body_open: Int = FindBlockOpen(content, after_name, n);
        if body_open >= n || CharAtWithin(content, n, body_open) != "{" {
            scan = after_name;
            continue;
        }
        let body_close: Int = FindMatchingBraceWithin(content, body_open, n);
        ArrayPush(func_names, name);
        ArrayPush(func_rets, name);
        ArrayPush(func_params, NominalConstructorParams(
            content, n, body_open, body_close, cursor
        ));
        scan = body_close + 1;
    }
}

func SeedDeclaredFunctionSignatures(
    content: String,
    content_length: Int,
    start: Int,
    end: Int,
    owner_name: String,
    inout func_names: Array<String>,
    inout func_rets: Array<String>,
    inout func_params: Array<String>
) -> Void {
    let cursor: Array<Int> = [0];
    let scan: Int = start;
    while scan < end {
        scan = SkipWhitespaceAndCommentsWithin(content, content_length, scan);
        if scan >= end {
            break;
        }
        if CharAtWithin(content, content_length, scan) == "\"" {
            scan = SkipQuotedString(content, scan, end);
            continue;
        }
        if SemanticMatchKeywordWithin(
            content, content_length, scan, "namespace"
        ) {
            let namespace_name: String =
                SemanticReadIdentWithin(
                    content, content_length, scan + 9, cursor
                );
            let after_namespace: Int = cursor[0];
            let body_open: Int =
                FindBlockOpen(content, after_namespace, end);
            if StringLength(namespace_name) == 0 || body_open >= end ||
                CharAtWithin(content, content_length, body_open) != "{" {
                scan = scan + 9;
                continue;
            }
            let body_close: Int =
                FindMatchingBraceWithin(content, body_open, end);
            SeedDeclaredFunctionSignatures(
                content, content_length, body_open + 1, body_close,
                SemanticCallableCanonicalDeclaredName(
                    owner_name, namespace_name
                ),
                func_names, func_rets, func_params
            );
            scan = body_close + 1;
            continue;
        }
        if !SemanticMatchKeywordWithin(
            content, content_length, scan, "func"
        ) {
            scan = scan + 1;
            continue;
        }
        let fn_name: String =
            SemanticReadIdentWithin(
                content, content_length, scan + 4, cursor
            );
        let after_name: Int = cursor[0];
        let open_match: Option<Int> =
            ExpectLiteralWithin(
                content, content_length, after_name, "("
            );
        if !IsSome(open_match) || StringLength(fn_name) == 0 {
            scan = scan + 4;
            continue;
        }
        let open: Int = UnwrapOption(open_match);
        let depth: Int = 1;
        let k: Int = open;
        while k < end && depth > 0 {
            let c: String = CharAtWithin(content, content_length, k);
            if c == "(" {
                depth = depth + 1;
            } else if c == ")" {
                depth = depth - 1;
            }
            k = k + 1;
        }
        let param_src: String = Substring(content, open, k - 1 - open);
        let ret: String = "Void";
        k = SkipWhitespaceAndCommentsWithin(content, content_length, k);
        if CharAtWithin(content, content_length, k) == "-" &&
            CharAtWithin(content, content_length, k + 1) == ">" {
            ret = ReadTypeNameWithin(
                content, content_length, k + 2, cursor
            );
            k = cursor[0];
        }
        ArrayPush(
            func_names,
            SemanticCallableCanonicalDeclaredName(owner_name, fn_name)
        );
        ArrayPush(func_rets, ret);
        ArrayPush(func_params, ParamTypes(param_src));
        let function_body_open: Int = FindBlockOpen(content, k, end);
        if function_body_open < end &&
            CharAtWithin(content, content_length, function_body_open) == "{" {
            scan = FindMatchingBraceWithin(
                content, function_body_open, end
            ) + 1;
            continue;
        }
        scan = k;
    }
}

func CheckProgram(content: String) -> String {
    let cursor: Array<Int> = [0];
    let func_names: Array<String> = [];
    let func_rets: Array<String> = [];
    let func_params: Array<String> = [];
    if !SeedSemanticBuiltinSignatures(func_names, func_rets, func_params) {
        return SemanticError1("function_signature_invalid", "owner", "SemanticBuiltinSignatureRows");
    }
    SeedNominalConstructors(content, func_names, func_rets, func_params);
    if !SeedDeclaredEnumVariantSignatures(
        content, func_names, func_rets, func_params
    ) {
        return SemanticError1(
            "function_signature_invalid", "owner",
            "SemanticEnumCallableProjection"
        );
    }
    let n: Int = StringLength(content);
    SeedDeclaredFunctionSignatures(
        content, n, 0, n, "", func_names, func_rets, func_params
    );
    let root_marker: String = "/*PGY_SEMANTIC_ROOT_START*/";
    let root_pos: Int = StringIndexOf(content, root_marker);
    let i: Int = 0;
    if root_pos >= 0 {
        i = root_pos + StringLength(root_marker);
    }
    while i < n {
        i = SkipWhitespaceAndCommentsWithin(content, n, i);
        if i >= n {
            break;
        }
        if CharAtWithin(content, n, i) == "\"" {
            i = SkipQuotedString(content, i, n);
            continue;
        }
        if SemanticMatchKeywordWithin(content, n, i, "export") {
            i = i + 6;
            continue;
        }
        if SemanticMatchKeywordWithin(content, n, i, "async") {
            i = i + 5;
            continue;
        }
        if SemanticMatchKeywordWithin(content, n, i, "func") {
            let fn_error: String = CheckFunction(content, i, cursor, func_names, func_rets, func_params);
            if StringLength(fn_error) > 0 {
                return fn_error;
            }
            i = cursor[0];
            continue;
        }
        i = i + 1;
    }
    return "";
}
