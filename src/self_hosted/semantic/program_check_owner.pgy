// Self-host semantic program checking owner.

import "text_scan_owner.pgy";
import "expr_type_owner.pgy";
import "body_check_owner.pgy";
import "builtin_signature_owner.pgy";

func NominalDeclKeywordLength(content: String, start: Int) -> Int {
    if SemanticMatchKeyword(content, start, "struct") {
        return 6;
    }
    if SemanticMatchKeyword(content, start, "class") {
        return 5;
    }
    if SemanticMatchKeyword(content, start, "subject") {
        return 7;
    }
    if SemanticMatchKeyword(content, start, "object") {
        return 6;
    }
    if SemanticMatchKeyword(content, start, "tobject") {
        return 7;
    }
    if SemanticMatchKeyword(content, start, "vessel") {
        return 6;
    }
    return 0;
}

func NominalConstructorParams(content: String, body_open: Int, body_close: Int, inout cursor: Array<Int>) -> String {
    let i: Int = body_open + 1;
    let depth: Int = 0;
    let params: String = "";
    while i < body_close {
        i = SkipWhitespaceAndComments(content, i);
        if i >= body_close {
            break;
        }
        let c: String = CharAt(content, i);
        if c == "\"" {
            i = SkipQuotedString(content, i, body_close);
            continue;
        }
        if c == "{" {
            depth = depth + 1;
            i = i + 1;
            continue;
        }
        if c == "}" {
            if depth > 0 {
                depth = depth - 1;
            }
            i = i + 1;
            continue;
        }
        if depth != 0 {
            i = i + 1;
            continue;
        }
        if SemanticMatchKeyword(content, i, "let") {
            i = i + 3;
        }
        let field_name: String = SemanticReadIdent(content, i, cursor);
        i = cursor[0];
        i = SkipWhitespaceAndComments(content, i);
        if StringLength(field_name) == 0 || CharAt(content, i) != ":" {
            let bad_field_end: Int = FindStatementEnd(content, i, body_close);
            i = bad_field_end + 1;
            continue;
        }
        let field_type: String = ReadTypeName(content, i + 1, cursor);
        i = cursor[0];
        if StringLength(field_type) > 0 {
            if StringLength(params) > 0 {
                params = Concat(params, "|");
            }
            params = Concat(params, field_type);
        }
        let field_end: Int = FindStatementEnd(content, i, body_close);
        i = field_end + 1;
    }
    return params;
}

func SeedNominalConstructors(content: String, inout func_names: Array<String>, inout func_rets: Array<String>, inout func_params: Array<String>) -> Void {
    let n: Int = StringLength(content);
    let scan: Int = 0;
    let cursor: Array<Int> = [0];
    while scan < n {
        scan = SkipWhitespaceAndComments(content, scan);
        if scan >= n {
            break;
        }
        if CharAt(content, scan) == "\"" {
            scan = SkipQuotedString(content, scan, n);
            continue;
        }
        let kw_len: Int = NominalDeclKeywordLength(content, scan);
        if kw_len == 0 {
            scan = scan + 1;
            continue;
        }
        let name: String = SemanticReadIdent(content, scan + kw_len, cursor);
        let after_name: Int = cursor[0];
        if StringLength(name) == 0 {
            scan = scan + kw_len;
            continue;
        }
        let body_open: Int = FindBlockOpen(content, after_name, n);
        if body_open >= n || CharAt(content, body_open) != "{" {
            scan = after_name;
            continue;
        }
        let body_close: Int = FindMatchingBraceWithin(content, body_open, n);
        ArrayPush(func_names, name);
        ArrayPush(func_rets, name);
        ArrayPush(func_params, NominalConstructorParams(content, body_open, body_close, cursor));
        scan = body_close + 1;
    }
}

func CheckProgram(content: String) -> String {
    let cursor: Array<Int> = [0];
    let func_names: Array<String> = [];
    let func_rets: Array<String> = [];
    let func_params: Array<String> = [];
    if !SeedSemanticBuiltinSignatures(func_names, func_rets, func_params) {
        return SemanticError1("function_signature_invalid", "owner", "SemanticBuiltinSignatureRows");
    }
    SeedNominalConstructors(content, func_names, func_rets, func_params);
    let n: Int = StringLength(content);
    let scan: Int = 0;
    while scan < n {
        scan = SkipWhitespaceAndComments(content, scan);
        if scan >= n {
            break;
        }
        if CharAt(content, scan) == "\"" {
            scan = SkipQuotedString(content, scan, n);
            continue;
        }
        if !SemanticMatchKeyword(content, scan, "func") {
            scan = scan + 1;
            continue;
        }
        let name_pos: Int = scan + 4;
        let fn_name: String = SemanticReadIdent(content, name_pos, cursor);
        let after_name: Int = cursor[0];
        let open_match: Option<Int> = ExpectLiteral(content, after_name, "(");
        if !IsSome(open_match) || StringLength(fn_name) == 0 {
            scan = scan + 4;
            continue;
        }
        let open: Int = UnwrapOption(open_match);
        let depth: Int = 1;
        let k: Int = open;
        while k < n && depth > 0 {
            let c: String = CharAt(content, k);
            if c == "(" {
                depth = depth + 1;
            } else if c == ")" {
                depth = depth - 1;
            }
            k = k + 1;
        }
        let param_src: String = Substring(content, open, k - 1 - open);
        let ret: String = "Void";
        k = SkipWhitespaceAndComments(content, k);
        if CharAt(content, k) == "-" && CharAt(content, k + 1) == ">" {
            ret = ReadTypeName(content, k + 2, cursor);
            k = cursor[0];
        }
        ArrayPush(func_names, fn_name);
        ArrayPush(func_rets, ret);
        ArrayPush(func_params, ParamTypes(param_src));
        let body_open: Int = FindBlockOpen(content, k, n);
        if body_open < n && CharAt(content, body_open) == "{" {
            scan = FindMatchingBraceWithin(content, body_open, n) + 1;
            continue;
        }
        scan = k;
    }
    let root_marker: String = "/*PGY_SEMANTIC_ROOT_START*/";
    let root_pos: Int = StringIndexOf(content, root_marker);
    let i: Int = 0;
    if root_pos >= 0 {
        i = root_pos + StringLength(root_marker);
    }
    while i < n {
        i = SkipWhitespaceAndComments(content, i);
        if i >= n {
            break;
        }
        if CharAt(content, i) == "\"" {
            i = SkipQuotedString(content, i, n);
            continue;
        }
        if SemanticMatchKeyword(content, i, "export") {
            i = i + 6;
            continue;
        }
        if SemanticMatchKeyword(content, i, "async") {
            i = i + 5;
            continue;
        }
        if SemanticMatchKeyword(content, i, "func") {
            let fn_error: String = CheckFunction(content, i, cursor, func_names, func_rets, func_params);
            if StringLength(fn_error) > 0 {
                return fn_error;
            }
            i = cursor[0];
            continue;
        }
        i = i + 1;
    }
    return "";
}
