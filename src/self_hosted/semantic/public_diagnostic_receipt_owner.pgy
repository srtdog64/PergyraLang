// Typed public diagnostic receipt owner. Rendered message wording is payload,
// never the source of semantic identity.

import "../lib/public_diagnostic_receipt_owner.pgy";
import "diagnostic_code_owner.pgy";

struct SemanticPublicDiagnosticReceipt {
    ready: Bool;
    schema: String;
    stage: String;
    layer: String;
    code: String;
    cause_ir: String;
    fix_source: String;
    message: String;
}

struct SemanticPublicDiagnosticIdentity {
    ready: Bool;
    cause_ir: String;
    fix_source: String;
}

func SemanticPublicDiagnosticReceiptSchema() -> String {
    return SelfHostPublicDiagnosticReceiptSchema();
}

func SemanticPublicDiagnosticIdentityForOwnedCode(
    code: String
) -> SemanticPublicDiagnosticIdentity {
    if code == "task_lifecycle_invalid" {
        return SemanticPublicDiagnosticIdentity(true, "semantic:task:lifecycle", "await-task-before-exit");
    }
    if code == "cancel_argument_invalid" {
        return SemanticPublicDiagnosticIdentity(true, "semantic:builtin:signature_mismatch", "match-builtin-signature");
    }
    if code == "cancel_payload_unsupported" {
        return SemanticPublicDiagnosticIdentity(true, "semantic:remote_future:direct_access", "await-future");
    }
    if code == "parallel_unsafe_forbidden" {
        return SemanticPublicDiagnosticIdentity(true, "semantic:parallel:secure_in_task", "serialize-outside-parallel");
    }
    if code == "action_contract_invalid" {
        return SemanticPublicDiagnosticIdentity(true, "semantic:action_contract", "align-action-surface-with-zone");
    }
    if code == "action_ability_unsatisfied" {
        return SemanticPublicDiagnosticIdentity(true, "semantic:ability_contract", "align-ability-generics-or-fields");
    }
    if code == "intent_retry_unavailable" {
        return SemanticPublicDiagnosticIdentity(true, "semantic:intent_step", "check-intent-step-lowering");
    }
    if code == "match_pattern_invalid" {
        return SemanticPublicDiagnosticIdentity(true, "semantic:match:pattern_shape", "align-pattern-arity-or-kind");
    }
    if code == "world_zone_escape" || code == "subject_value_copy" {
        return SemanticPublicDiagnosticIdentity(true, "semantic:anchored_handle:copy_attempt", "use-move-or-retain-binding");
    }
    if code == "subject_value_return" {
        return SemanticPublicDiagnosticIdentity(true, "semantic:anchored_handle:return_boundary", "return-projection-or-keep-local");
    }
    if code == "zone_contract_invalid" {
        return SemanticPublicDiagnosticIdentity(true, "semantic:zone_contract", "align-zone-slot-or-state-naming");
    }
    if code == "generic_constraint_unsatisfied" {
        return SemanticPublicDiagnosticIdentity(true, "semantic:class_contract", "satisfy-generic-bound-or-widen");
    }
    if code == "undefined_symbol" || code == "undefined_function" {
        return SemanticPublicDiagnosticIdentity(
            true,
            "semantic:symbol:undefined",
            "import-or-declare-symbol"
        );
    }
    if code == "return_type_mismatch" {
        return SemanticPublicDiagnosticIdentity(
            true,
            "semantic:assignability_check",
            "annotate-or-convert"
        );
    }
    if code == "let_type_mismatch" {
        return SemanticPublicDiagnosticIdentity(
            true,
            "semantic:assignability_check",
            "annotate-or-convert"
        );
    }
    if code == "assign_type_mismatch" {
        return SemanticPublicDiagnosticIdentity(
            true,
            "semantic:assignability_check",
            "annotate-or-convert"
        );
    }
    if code == "immutable_field_write" {
        return SemanticPublicDiagnosticIdentity(
            true, "semantic:immutable_field:write", "reconstruct-or-change-host-kind");
    }
    if code == "declared_capability_missing" || code == "declared_effect_missing" ||
        code == "call_effect_fact_unavailable" {
        return SemanticPublicDiagnosticIdentity(
            true, "semantic:effect:incompatible_combo", "split-effect-families");
    }
    if code == "call_arg_type_mismatch" {
        return SemanticPublicDiagnosticIdentity(
            true,
            "semantic:assignability_check",
            "annotate-or-convert"
        );
    }
    if code == "member_call_arg_type_mismatch" {
        return SemanticPublicDiagnosticIdentity(
            true,
            "semantic:call:arg_type_mismatch",
            "align-arg-type"
        );
    }
    if code == "enum_payload_variant_unproven" {
        return SemanticPublicDiagnosticIdentity(
            true,
            "semantic:enum_payload:active_variant_unproven",
            "narrow-enum-variant-before-projection"
        );
    }
    if code == "builtin_arg_type_mismatch" {
        return SemanticPublicDiagnosticIdentity(
            true,
            "semantic:builtin:signature_mismatch",
            "match-builtin-signature"
        );
    }
    if code == "value_param_collection_mutation" {
        return SemanticPublicDiagnosticIdentity(
            true,
            "semantic:builtin:signature_mismatch",
            "match-builtin-signature"
        );
    }
    if code == "borrow_boundary_escape" {
        return SemanticPublicDiagnosticIdentity(
            true, "semantic:borrow_escape", "change-ref-to-own-or-stop-escape");
    }
    if code == "call_arity_mismatch" {
        return SemanticPublicDiagnosticIdentity(
            true,
            "semantic:builtin:signature_mismatch",
            "match-builtin-signature"
        );
    }
    if code == "logical_operand_not_bool" {
        return SemanticPublicDiagnosticIdentity(
            true,
            "semantic:binop:operand_types",
            "align-operand-types-or-overload"
        );
    }
    if code == "condition_not_bool" {
        return SemanticPublicDiagnosticIdentity(
            true,
            "semantic:condition:non_bool",
            "convert-condition-to-bool"
        );
    }
    if code == "not_operand_not_bool" {
        return SemanticPublicDiagnosticIdentity(
            true,
            "semantic:unary_operator:operand",
            "align-operand-type"
        );
    }
    if code == "compare_type_mismatch" {
        return SemanticPublicDiagnosticIdentity(
            true,
            "semantic:binop:operand_types",
            "align-operand-types-or-overload"
        );
    }
    if code == "binop_type_mismatch" {
        return SemanticPublicDiagnosticIdentity(
            true,
            "semantic:binop:operand_types",
            "align-operand-types-or-overload"
        );
    }
    if code == "array_index_type_mismatch" {
        return SemanticPublicDiagnosticIdentity(
            true,
            "semantic:array_access:index_non_int",
            "use-int-index"
        );
    }
    return SemanticPublicDiagnosticIdentity(false, "", "");
}

func SemanticPublicDiagnosticReceiptFromOwnedFacts(
    code: String,
    message: String
) -> SemanticPublicDiagnosticReceipt {
    let public_code: String = SemanticDiagnosticOracleCode(code);
    let identity: SemanticPublicDiagnosticIdentity =
        SemanticPublicDiagnosticIdentityForOwnedCode(code);
    let ready: Bool = public_code != "" && identity.ready && message != "";
    return SemanticPublicDiagnosticReceipt(
        ready,
        SemanticPublicDiagnosticReceiptSchema(),
        "semantic",
        SemanticDiagnosticPublicLayer(code),
        public_code,
        identity.cause_ir,
        identity.fix_source,
        message
    );
}

func SemanticPublicDiagnosticReceiptReadyFor(
    receipt: SemanticPublicDiagnosticReceipt,
    owned_code: String
) -> Bool {
    let identity: SemanticPublicDiagnosticIdentity =
        SemanticPublicDiagnosticIdentityForOwnedCode(owned_code);
    return receipt.ready &&
        identity.ready &&
        receipt.schema == SemanticPublicDiagnosticReceiptSchema() &&
        receipt.stage == "semantic" &&
        receipt.layer == SemanticDiagnosticPublicLayer(owned_code) &&
        receipt.code == SemanticDiagnosticOracleCode(owned_code) &&
        receipt.cause_ir == identity.cause_ir &&
        receipt.fix_source == identity.fix_source &&
        receipt.message != "";
}

func SemanticPublicDiagnosticReceiptJson(
    receipt: SemanticPublicDiagnosticReceipt
) -> String {
    if !receipt.ready { return ""; }
    return SelfHostPublicDiagnosticReceiptJsonFromOwnedFacts(
        receipt.stage, receipt.layer, receipt.code, receipt.cause_ir,
        receipt.fix_source, receipt.message
    );
}

func SemanticPublicDiagnosticReceiptWirePayload(
    receipt: SemanticPublicDiagnosticReceipt
) -> String {
    if !receipt.ready ||
        receipt.schema != SelfHostPublicDiagnosticReceiptSchema() {
        return "";
    }
    return SelfHostPublicDiagnosticReceiptWireFromOwnedFacts(
        receipt.stage, receipt.layer, receipt.code, receipt.cause_ir,
        receipt.fix_source, receipt.message
    );
}

func SemanticDiagnosticPayloadForPublicBoundary(
    code: String,
    message: String,
    emit_json_receipt: Bool
) -> String {
    if !emit_json_receipt { return message; }
    let receipt: SemanticPublicDiagnosticReceipt =
        SemanticPublicDiagnosticReceiptFromOwnedFacts(code, message);
    if !SemanticPublicDiagnosticReceiptReadyFor(receipt, code) {
        // The caller owns the non-zero exit. Empty output makes the transport
        // reject the receipt without importing another failure vocabulary.
        return "";
    }
    return SemanticPublicDiagnosticReceiptWirePayload(receipt);
}
