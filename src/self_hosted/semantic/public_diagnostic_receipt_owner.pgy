// Typed public diagnostic receipt owner. Rendered message wording is payload,
// never the source of semantic identity.

import "../lib/public_diagnostic_receipt_owner.pgy";
import "diagnostic_code_owner.pgy";

struct SemanticPublicDiagnosticReceipt {
    ready: Bool;
    schema: String;
    stage: String;
    layer: String;
    code: String;
    cause_ir: String;
    fix_source: String;
    message: String;
}

struct SemanticPublicDiagnosticIdentity {
    ready: Bool;
    cause_ir: String;
    fix_source: String;
}

func SemanticPublicDiagnosticReceiptSchema() -> String {
    return SelfHostPublicDiagnosticReceiptSchema();
}

func SemanticPublicDiagnosticIdentityForOwnedCode(
    code: String
) -> SemanticPublicDiagnosticIdentity {
    if code == "undefined_symbol" || code == "undefined_function" {
        return SemanticPublicDiagnosticIdentity(
            true,
            "semantic:symbol:undefined",
            "import-or-declare-symbol"
        );
    }
    if code == "return_type_mismatch" {
        return SemanticPublicDiagnosticIdentity(
            true,
            "semantic:assignability_check",
            "annotate-or-convert"
        );
    }
    if code == "let_type_mismatch" {
        return SemanticPublicDiagnosticIdentity(
            true,
            "semantic:assignability_check",
            "annotate-or-convert"
        );
    }
    if code == "assign_type_mismatch" {
        return SemanticPublicDiagnosticIdentity(
            true,
            "semantic:assignability_check",
            "annotate-or-convert"
        );
    }
    if code == "call_arg_type_mismatch" {
        return SemanticPublicDiagnosticIdentity(
            true,
            "semantic:assignability_check",
            "annotate-or-convert"
        );
    }
    if code == "builtin_arg_type_mismatch" {
        return SemanticPublicDiagnosticIdentity(
            true,
            "semantic:builtin:signature_mismatch",
            "match-builtin-signature"
        );
    }
    if code == "value_param_collection_mutation" {
        return SemanticPublicDiagnosticIdentity(
            true,
            "semantic:builtin:signature_mismatch",
            "match-builtin-signature"
        );
    }
    if code == "call_arity_mismatch" {
        return SemanticPublicDiagnosticIdentity(
            true,
            "semantic:builtin:signature_mismatch",
            "match-builtin-signature"
        );
    }
    if code == "logical_operand_not_bool" {
        return SemanticPublicDiagnosticIdentity(
            true,
            "semantic:binop:operand_types",
            "align-operand-types-or-overload"
        );
    }
    if code == "condition_not_bool" {
        return SemanticPublicDiagnosticIdentity(
            true,
            "semantic:condition:non_bool",
            "convert-condition-to-bool"
        );
    }
    if code == "not_operand_not_bool" {
        return SemanticPublicDiagnosticIdentity(
            true,
            "semantic:unary_operator:operand",
            "align-operand-type"
        );
    }
    if code == "compare_type_mismatch" {
        return SemanticPublicDiagnosticIdentity(
            true,
            "semantic:binop:operand_types",
            "align-operand-types-or-overload"
        );
    }
    return SemanticPublicDiagnosticIdentity(false, "", "");
}

func SemanticPublicDiagnosticReceiptFromOwnedFacts(
    code: String,
    message: String
) -> SemanticPublicDiagnosticReceipt {
    let public_code: String = SemanticDiagnosticOracleCode(code);
    let identity: SemanticPublicDiagnosticIdentity =
        SemanticPublicDiagnosticIdentityForOwnedCode(code);
    let ready: Bool = public_code != "" && identity.ready && message != "";
    return SemanticPublicDiagnosticReceipt(
        ready,
        SemanticPublicDiagnosticReceiptSchema(),
        "semantic",
        "type",
        public_code,
        identity.cause_ir,
        identity.fix_source,
        message
    );
}

func SemanticPublicDiagnosticReceiptReadyFor(
    receipt: SemanticPublicDiagnosticReceipt,
    owned_code: String
) -> Bool {
    let identity: SemanticPublicDiagnosticIdentity =
        SemanticPublicDiagnosticIdentityForOwnedCode(owned_code);
    return receipt.ready &&
        identity.ready &&
        receipt.schema == SemanticPublicDiagnosticReceiptSchema() &&
        receipt.stage == "semantic" && receipt.layer == "type" &&
        receipt.code == SemanticDiagnosticOracleCode(owned_code) &&
        receipt.cause_ir == identity.cause_ir &&
        receipt.fix_source == identity.fix_source &&
        receipt.message != "";
}

func SemanticPublicDiagnosticReceiptJson(
    receipt: SemanticPublicDiagnosticReceipt
) -> String {
    if !receipt.ready { return ""; }
    return SelfHostPublicDiagnosticReceiptJsonFromOwnedFacts(
        receipt.stage, receipt.layer, receipt.code, receipt.cause_ir,
        receipt.fix_source, receipt.message
    );
}

func SemanticPublicDiagnosticReceiptWirePayload(
    receipt: SemanticPublicDiagnosticReceipt
) -> String {
    if !receipt.ready ||
        receipt.schema != SelfHostPublicDiagnosticReceiptSchema() {
        return "";
    }
    return SelfHostPublicDiagnosticReceiptWireFromOwnedFacts(
        receipt.stage, receipt.layer, receipt.code, receipt.cause_ir,
        receipt.fix_source, receipt.message
    );
}

func SemanticDiagnosticPayloadForPublicBoundary(
    code: String,
    message: String,
    emit_json_receipt: Bool
) -> String {
    if !emit_json_receipt { return message; }
    let receipt: SemanticPublicDiagnosticReceipt =
        SemanticPublicDiagnosticReceiptFromOwnedFacts(code, message);
    if !SemanticPublicDiagnosticReceiptReadyFor(receipt, code) {
        // The caller owns the non-zero exit. Empty output makes the transport
        // reject the receipt without importing another failure vocabulary.
        return "";
    }
    return SemanticPublicDiagnosticReceiptWirePayload(receipt);
}
