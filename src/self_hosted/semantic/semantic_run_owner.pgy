// Self-host semantic run boundary owner.
//
// Owns CLI argument validation and deterministic diagnostic verdict emission.
// Semantic facts stay in the source bundle and program checker owners.

import "source_bundle_owner.pgy";
import "diagnostic_owner.pgy";
import "program_check_owner.pgy";

func RunSemanticFromArgs(args: Array<String>) -> Void {
    if ArrayLength(args) < 1 {
        Log(SemanticError2("input_missing", "expected", "source", "actual", "none"));
        Exit(1);
        return;
    }
    if args[0] == "--fixture-manifest" {
        EmitSemanticVerdictPayloadFixtureManifest();
        return;
    }
    if args[0] == "--diagnostic-vocabulary" {
        EmitSemanticDiagnosticVocabularyManifest();
        return;
    }
    if args[0] == "--diagnostic-surface-audit" {
        EmitSemanticDiagnosticSurfaceAudit();
        return;
    }
    if args[0] == "--oracle-json-code-match" {
        if ArrayLength(args) < 3 {
            Log(SemanticError2("input_missing", "expected", "oracle-json-and-code", "actual", "none"));
            Exit(1);
            return;
        }
        EmitSemanticOracleJsonCodeMatch(args[1], args[2]);
        return;
    }
    if args[0] == "--check" {
        if ArrayLength(args) < 2 {
            Log(SemanticError2("input_missing", "expected", "source", "actual", "none"));
            Exit(1);
            return;
        }
        let check_bundle: SemanticSourceBundle = LoadSemanticSourceCheckBundle(args[1]);
        let check_content: String = check_bundle.content;
        let check_error: String = CheckProgram(check_content);
        if StringLength(check_error) > 0 {
            Log(check_error);
            Exit(1);
            return;
        }
        Log(SemanticOk());
        return;
    }

    let content: String = LoadSemanticSourceBundle(args[0]);
    let error: String = CheckProgram(content);
    if StringLength(error) > 0 {
        Log(error);
        return;
    }
    Log(SemanticOk());
}
