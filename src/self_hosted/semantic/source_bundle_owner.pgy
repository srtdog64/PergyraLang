// Self-host semantic source-bundle owner.
//
// Owns the "program source" fact consumed by CheckProgram. `main.pgy` is only
// the CLI boundary; import graph expansion and source ordering live here.

import "../lib/path.pgy";
import "text_scan_owner.pgy";

func SourceBundleSeen(paths: Array<String>, path: String) -> Bool {
    let i: Int = 0;
    while i < ArrayLength(paths) {
        if paths[i] == path {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func SourceBundleReadImportPath(content: String, start: Int, inout cursor_out: Array<Int>) -> String {
    let i: Int = SkipWhitespaceAndComments(content, start);
    if CharAt(content, i) != "\"" {
        ArraySet(cursor_out, 0, i);
        return "";
    }
    let begin: Int = i + 1;
    let end: Int = begin;
    while end < StringLength(content) && CharAt(content, end) != "\"" {
        end = end + 1;
    }
    if end >= StringLength(content) {
        ArraySet(cursor_out, 0, end);
        return "";
    }
    ArraySet(cursor_out, 0, end + 1);
    return Substring(content, begin, end - begin);
}

func SourceBundleSkipString(content: String, start: Int) -> Int {
    let i: Int = start + 1;
    while i < StringLength(content) && CharAt(content, i) != "\"" {
        if CharAt(content, i) == "\\" {
            i = i + 1;
        }
        i = i + 1;
    }
    return i + 1;
}

func LoadSemanticSourceBundleVisit(path: String, inout seen_paths: Array<String>) -> String {
    if SourceBundleSeen(seen_paths, path) {
        return "";
    }
    if !FileExists(path) {
        Exit(1);
        return "";
    }
    ArrayPush(seen_paths, path);

    let content: String = ReadFile(path);
    let base_dir: String = SelfHostPath.Dirname(path);
    let out: String = Concat(content, "\n");
    let cursor: Array<Int> = [0];
    let i: Int = 0;
    while i < StringLength(content) {
        i = SkipWhitespaceAndComments(content, i);
        if i >= StringLength(content) {
            break;
        }
        if CharAt(content, i) == "\"" {
            i = SourceBundleSkipString(content, i);
            continue;
        }
        if MatchKeyword(content, i, "import") {
            let rel_path: String = SourceBundleReadImportPath(content, i + 6, cursor);
            i = cursor[0];
            if StringLength(rel_path) > 0 {
                let imp_path: String = SelfHostPath.NormalizeImportRelative(base_dir, rel_path);
                let imp_content: String = LoadSemanticSourceBundleVisit(imp_path, seen_paths);
                if StringLength(imp_content) > 0 {
                    out = Concat(imp_content, out);
                }
            }
            continue;
        }
        i = i + 1;
    }
    return out;
}

func LoadSemanticSourceBundle(root_path: String) -> String {
    let seen_paths: Array<String> = [];
    return LoadSemanticSourceBundleVisit(root_path, seen_paths);
}
