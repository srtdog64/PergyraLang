// Self-host semantic source text scanner owner.

import "../lib/source_scan_owner.pgy";

func CharAt(s: String, i: Int) -> String {
    return SourceCharAt(s, i);
}
func SkipQuotedString(content: String, start: Int, limit: Int) -> Int {
    let i: Int = start + 1;
    while i < limit &&
        SourceByteAt(content, limit, i) != SourceByteOf("\"") {
        if SourceByteAt(content, limit, i) == SourceByteOf("\\") {
            i = i + 1;
        }
        i = i + 1;
    }
    return i + 1;
}
func SkipLineComment(content: String, start: Int, limit: Int) -> Int {
    let i: Int = start + 2;
    while i < limit &&
        SourceByteAt(content, limit, i) != SourceByteOf("\n") {
        i = i + 1;
    }
    return i;
}
func SkipBlockComment(content: String, start: Int, limit: Int) -> Int {
    let i: Int = start + 2;
    while i < limit {
        if SourceByteAt(content, limit, i) == SourceByteOf("*") &&
            SourceByteAt(content, limit, i + 1) == SourceByteOf("/") {
            return i + 2;
        }
        i = i + 1;
    }
    return limit;
}
func SemanticMatchKeyword(content: String, start: Int, kw: String) -> Bool {
    let i: Int = SkipWhitespaceAndComments(content, start);
    let n: Int = StringLength(content);
    let kl: Int = StringLength(kw);
    if i + kl > n {
        return false;
    }
    if !SubEqualsWithLen(content, n, i, kl, kw) {
        return false;
    }
    return !SourceByteIsAlphaNum(SourceByteAt(content, n, i + kl));
}
func SemanticReadIdent(content: String, start: Int, inout cursor_out: Array<Int>) -> String {
    let i: Int = SkipWhitespaceAndComments(content, start);
    let n: Int = StringLength(content);
    if !SourceByteIsAlpha(SourceByteAt(content, n, i)) {
        ArraySet(cursor_out, 0, i);
        return "";
    }
    let end: Int = i + 1;
    while end < n && SourceByteIsAlphaNum(SourceByteAt(content, n, end)) {
        end = end + 1;
    }
    ArraySet(cursor_out, 0, end);
    return Substring(content, i, end - i);
}
func Trim(content: String) -> String {
    let start: Int = 0;
    let end: Int = StringLength(content);
    while start < end {
        let c: Int = SourceByteAt(content, end, start);
        if !SourceByteIsWhitespace(c) {
            break;
        }
        start = start + 1;
    }
    while end > start {
        let c2: Int = SourceByteAt(content, end, end - 1);
        if !SourceByteIsWhitespace(c2) {
            break;
        }
        end = end - 1;
    }
    return Substring(content, start, end - start);
}
func ReadTypeName(content: String, start: Int, inout cursor_out: Array<Int>) -> String {
    let i: Int = SkipWhitespaceAndComments(content, start);
    let n: Int = StringLength(content);
    let depth: Int = 0;
    let end: Int = i;
    while end < n {
        let c: Int = SourceByteAt(content, n, end);
        if c == SourceByteOf("<") {
            depth = depth + 1;
        } else if c == SourceByteOf(">") {
            if depth > 0 {
                depth = depth - 1;
            }
        } else if depth == 0 {
            if SourceByteIsWhitespace(c) &&
                SemanticMatchKeyword(content, end + 1, "with") {
                break;
            }
            if c == SourceByteOf(",") || c == SourceByteOf(")") ||
                c == SourceByteOf("{") || c == SourceByteOf(";") ||
                c == SourceByteOf("=") {
                break;
            }
        }
        end = end + 1;
    }
    ArraySet(cursor_out, 0, end);
    return Trim(Substring(content, i, end - i));
}
func ExpectLiteral(content: String, start: Int, tok: String) -> Option<Int> {
    let i: Int = SkipWhitespaceAndComments(content, start);
    let tl: Int = StringLength(tok);
    if !SubEqualsWithLen(content, StringLength(content), i, tl, tok) {
        return None;
    }
    return Some(i + tl);
}
func FindStatementEnd(content: String, start: Int, limit: Int) -> Int {
    let i: Int = start;
    let depth: Int = 0;
    while i < limit {
        let c: Int = SourceByteAt(content, limit, i);
        if c == SourceByteOf("\"") {
            i = SkipQuotedString(content, i, limit);
            continue;
        } else if c == SourceByteOf("/") &&
            SourceByteAt(content, limit, i + 1) == SourceByteOf("/") {
            i = SkipLineComment(content, i, limit);
            continue;
        } else if c == SourceByteOf("/") &&
            SourceByteAt(content, limit, i + 1) == SourceByteOf("*") {
            i = SkipBlockComment(content, i, limit);
            continue;
        } else if c == SourceByteOf("(") || c == SourceByteOf("[") {
            depth = depth + 1;
        } else if c == SourceByteOf(")") || c == SourceByteOf("]") {
            if depth > 0 {
                depth = depth - 1;
            }
        } else if depth == 0 && c == SourceByteOf(";") {
            return i;
        }
        i = i + 1;
    }
    return limit;
}
func FindMatchingBraceWithin(content: String, open_idx: Int, limit: Int) -> Int {
    let i: Int = open_idx;
    let depth: Int = 0;
    while i < limit {
        let c: Int = SourceByteAt(content, limit, i);
        if c == SourceByteOf("\"") {
            i = SkipQuotedString(content, i, limit);
            continue;
        } else if c == SourceByteOf("/") &&
            SourceByteAt(content, limit, i + 1) == SourceByteOf("/") {
            i = SkipLineComment(content, i, limit);
            continue;
        } else if c == SourceByteOf("/") &&
            SourceByteAt(content, limit, i + 1) == SourceByteOf("*") {
            i = SkipBlockComment(content, i, limit);
            continue;
        } else if c == SourceByteOf("{") {
            depth = depth + 1;
        } else if c == SourceByteOf("}") {
            depth = depth - 1;
            if depth == 0 {
                return i;
            }
        }
        i = i + 1;
    }
    return limit;
}
func FindMatchingBrace(content: String, open_idx: Int) -> Int {
    let n: Int = StringLength(content);
    return FindMatchingBraceWithin(content, open_idx, n);
}
func FindBlockOpen(content: String, start: Int, limit: Int) -> Int {
    let i: Int = start;
    let depth: Int = 0;
    while i < limit {
        let c: Int = SourceByteAt(content, limit, i);
        if c == SourceByteOf("\"") {
            i = SkipQuotedString(content, i, limit);
            continue;
        } else if c == SourceByteOf("/") &&
            SourceByteAt(content, limit, i + 1) == SourceByteOf("/") {
            i = SkipLineComment(content, i, limit);
            continue;
        } else if c == SourceByteOf("/") &&
            SourceByteAt(content, limit, i + 1) == SourceByteOf("*") {
            i = SkipBlockComment(content, i, limit);
            continue;
        } else if c == SourceByteOf("(") || c == SourceByteOf("[") {
            depth = depth + 1;
        } else if c == SourceByteOf(")") || c == SourceByteOf("]") {
            if depth > 0 {
                depth = depth - 1;
            }
        } else if depth == 0 && c == SourceByteOf("{") {
            return i;
        }
        i = i + 1;
    }
    return limit;
}
