// Self-host semantic source text scanner owner.

import "../lib/source_scan_owner.pgy";

func CharAt(s: String, i: Int) -> String {
    let n: Int = StringLength(s);
    if i < 0 {
        return "";
    }
    if i >= n {
        return "";
    }
    return Substring(s, i, 1);
}
func SkipQuotedString(content: String, start: Int, limit: Int) -> Int {
    let i: Int = start + 1;
    while i < limit && CharAt(content, i) != "\"" {
        if CharAt(content, i) == "\\" {
            i = i + 1;
        }
        i = i + 1;
    }
    return i + 1;
}
func SkipLineComment(content: String, start: Int, limit: Int) -> Int {
    let i: Int = start + 2;
    while i < limit && CharAt(content, i) != "\n" {
        i = i + 1;
    }
    return i;
}
func SkipBlockComment(content: String, start: Int, limit: Int) -> Int {
    let i: Int = start + 2;
    while i < limit {
        if CharAt(content, i) == "*" && CharAt(content, i + 1) == "/" {
            return i + 2;
        }
        i = i + 1;
    }
    return limit;
}
func SemanticMatchKeyword(content: String, start: Int, kw: String) -> Bool {
    let i: Int = SkipWhitespaceAndComments(content, start);
    let n: Int = StringLength(content);
    let kl: Int = StringLength(kw);
    if i + kl > n {
        return false;
    }
    if Substring(content, i, kl) != kw {
        return false;
    }
    let next: String = CharAt(content, i + kl);
    return !IsAlphaNum(next);
}
func SemanticReadIdent(content: String, start: Int, inout cursor_out: Array<Int>) -> String {
    let i: Int = SkipWhitespaceAndComments(content, start);
    let n: Int = StringLength(content);
    if !IsAlpha(CharAt(content, i)) {
        ArraySet(cursor_out, 0, i);
        return "";
    }
    let end: Int = i + 1;
    while end < n && IsAlphaNum(CharAt(content, end)) {
        end = end + 1;
    }
    ArraySet(cursor_out, 0, end);
    return Substring(content, i, end - i);
}
func Trim(content: String) -> String {
    let start: Int = 0;
    let end: Int = StringLength(content);
    while start < end {
        let c: String = CharAt(content, start);
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            break;
        }
        start = start + 1;
    }
    while end > start {
        let c2: String = CharAt(content, end - 1);
        if c2 != " " && c2 != "\t" && c2 != "\n" && c2 != "\r" {
            break;
        }
        end = end - 1;
    }
    return Substring(content, start, end - start);
}
func ReadTypeName(content: String, start: Int, inout cursor_out: Array<Int>) -> String {
    let i: Int = SkipWhitespaceAndComments(content, start);
    let n: Int = StringLength(content);
    let depth: Int = 0;
    let end: Int = i;
    while end < n {
        let c: String = CharAt(content, end);
        if c == "<" {
            depth = depth + 1;
        } else if c == ">" {
            if depth > 0 {
                depth = depth - 1;
            }
        } else if depth == 0 {
            if (c == " " || c == "\t" || c == "\n" || c == "\r") &&
                SemanticMatchKeyword(content, end + 1, "with") {
                break;
            }
            if c == "," || c == ")" || c == "{" || c == ";" || c == "=" {
                break;
            }
        }
        end = end + 1;
    }
    ArraySet(cursor_out, 0, end);
    return Trim(Substring(content, i, end - i));
}
func ExpectLiteral(content: String, start: Int, tok: String) -> Option<Int> {
    let i: Int = SkipWhitespaceAndComments(content, start);
    let tl: Int = StringLength(tok);
    if Substring(content, i, tl) != tok {
        return None;
    }
    return Some(i + tl);
}
func FindStatementEnd(content: String, start: Int, limit: Int) -> Int {
    let i: Int = start;
    let depth: Int = 0;
    while i < limit {
        let c: String = CharAt(content, i);
        if c == "\"" {
            i = SkipQuotedString(content, i, limit);
            continue;
        } else if c == "/" && CharAt(content, i + 1) == "/" {
            i = SkipLineComment(content, i, limit);
            continue;
        } else if c == "/" && CharAt(content, i + 1) == "*" {
            i = SkipBlockComment(content, i, limit);
            continue;
        } else if c == "(" || c == "[" {
            depth = depth + 1;
        } else if c == ")" || c == "]" {
            if depth > 0 {
                depth = depth - 1;
            }
        } else if depth == 0 && c == ";" {
            return i;
        }
        i = i + 1;
    }
    return limit;
}
func FindMatchingBraceWithin(content: String, open_idx: Int, limit: Int) -> Int {
    let i: Int = open_idx;
    let depth: Int = 0;
    while i < limit {
        let c: String = CharAt(content, i);
        if c == "\"" {
            i = SkipQuotedString(content, i, limit);
            continue;
        } else if c == "/" && CharAt(content, i + 1) == "/" {
            i = SkipLineComment(content, i, limit);
            continue;
        } else if c == "/" && CharAt(content, i + 1) == "*" {
            i = SkipBlockComment(content, i, limit);
            continue;
        } else if c == "{" {
            depth = depth + 1;
        } else if c == "}" {
            depth = depth - 1;
            if depth == 0 {
                return i;
            }
        }
        i = i + 1;
    }
    return limit;
}
func FindMatchingBrace(content: String, open_idx: Int) -> Int {
    let n: Int = StringLength(content);
    return FindMatchingBraceWithin(content, open_idx, n);
}
func FindBlockOpen(content: String, start: Int, limit: Int) -> Int {
    let i: Int = start;
    let depth: Int = 0;
    while i < limit {
        let c: String = CharAt(content, i);
        if c == "\"" {
            i = SkipQuotedString(content, i, limit);
            continue;
        } else if c == "/" && CharAt(content, i + 1) == "/" {
            i = SkipLineComment(content, i, limit);
            continue;
        } else if c == "/" && CharAt(content, i + 1) == "*" {
            i = SkipBlockComment(content, i, limit);
            continue;
        } else if c == "(" || c == "[" {
            depth = depth + 1;
        } else if c == ")" || c == "]" {
            if depth > 0 {
                depth = depth - 1;
            }
        } else if depth == 0 && c == "{" {
            return i;
        }
        i = i + 1;
    }
    return limit;
}
