// Canonical Option/Result type-shape policy.

func IsOptionType(type_name: String) -> Bool {
    let n: Int = StringLength(type_name);
    return n >= 9 && Substring(type_name, 0, 7) == "Option<" &&
        CharAt(type_name, n - 1) == ">";
}

func IsResultType(type_name: String) -> Bool {
    let n: Int = StringLength(type_name);
    return n >= 9 && Substring(type_name, 0, 7) == "Result<" &&
        CharAt(type_name, n - 1) == ">";
}

func OptionPayloadTypeOpt(type_name: String) -> Option<String> {
    if !IsOptionType(type_name) { return None; }
    return Some(Substring(type_name, 7, StringLength(type_name) - 8));
}

func ResultPayloadTypeOpt(type_name: String) -> Option<String> {
    if !IsResultType(type_name) { return None; }
    return Some(Substring(type_name, 7, StringLength(type_name) - 8));
}

func IsDeviceSlotType(type_name: String) -> Bool {
    let n: Int = StringLength(type_name);
    return n >= 14 && Substring(type_name, 0, 11) == "DeviceSlot<" &&
        CharAt(type_name, n - 1) == ">";
}

func DeviceSlotPayloadTypeOpt(type_name: String) -> Option<String> {
    if !IsDeviceSlotType(type_name) { return None; }
    return Some(Substring(type_name, 11, StringLength(type_name) - 12));
}

func IsRemoteFutureType(type_name: String) -> Bool {
    let n: Int = StringLength(type_name);
    return n >= 15 && Substring(type_name, 0, 13) == "RemoteFuture<" &&
        CharAt(type_name, n - 1) == ">";
}

func RemoteFuturePayloadTypeOpt(type_name: String) -> Option<String> {
    if !IsRemoteFutureType(type_name) { return None; }
    return Some(Substring(type_name, 13, StringLength(type_name) - 14));
}

func FuturePayloadTypeOpt(type_name: String) -> Option<String> {
    let n: Int = StringLength(type_name);
    if n < 9 || Substring(type_name, 0, 7) != "Future<" ||
        CharAt(type_name, n - 1) != ">" {
        return None;
    }
    return Some(Substring(type_name, 7, n - 8));
}

func SemanticWrapperTypePolicyContractReady() -> Bool {
    let option_payload: Option<String> = OptionPayloadTypeOpt(
        "Option<Array<Int>>"
    );
    let result_payload: Option<String> = ResultPayloadTypeOpt(
        "Result<Option<String>>"
    );
    return IsSome(option_payload) &&
        UnwrapOption(option_payload) == "Array<Int>" &&
        IsSome(result_payload) &&
        UnwrapOption(result_payload) == "Option<String>" &&
        !IsOptionType("Option<Int") && !IsResultType("Result<Int");
}
