// src/self_hosted/tools/air_graph_id_uniqueness/main.pgy
//
// Status: rung-1 minimal. Reads a stable AIR-graph-shaped JSON dump and checks
// that every node id is unique. Duplicate node ids in the compiler IR graph are
// a real defect, so this is a consumer/analysis pass over the dump rather than a
// schema validator. AIR graph scalar facts are consumed through the shared scan
// owner so this checker does not rebuild JSON token extraction locally.
//
// Cwd contract: the parity harness cd's into the repo root before running.
// Contract: see intent.md in the same directory.

import "../../lib/json.pgy";
import "../../lib/json_emit.pgy";
import "../air_graph_json_validator/scan_owner.pgy";

func ArrayContainsString(arr: Array<String>, target: String) -> Bool {
    let i: Int = 0;
    let n: Int = ArrayLength(arr);
    while i < n {
        if arr[i] == target {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func DuplicateFinding(id_val: String) -> Option<String> {
    let fields: Array<String> = [
        JsonEmitFieldString("kind", "duplicate_id"),
        JsonEmitFieldString("id", id_val)
    ];
    return Some(JsonEmitObject(fields));
}

func InputErrorJson(path: String) -> Option<String> {
    let source_fields: Array<String> = [
        JsonEmitFieldString("input_schema", "pgy.air.graph.v1"),
        JsonEmitFieldString("fixture_owner", path)
    ];
    let counts_fields: Array<String> = [
        JsonEmitFieldNumber("ids", "0"),
        JsonEmitFieldNumber("distinct", "0"),
        JsonEmitFieldNumber("duplicates", "0")
    ];
    let finding_fields: Array<String> = [
        JsonEmitFieldString("kind", "input_error"),
        JsonEmitFieldString("key", path),
        JsonEmitFieldString("location", path)
    ];
    let findings: Array<String> = [
        JsonEmitObject(finding_fields)
    ];
    let report_fields: Array<String> = [
        JsonEmitFieldString("schema", "pgy.selfhost.air-id-uniqueness.v1"),
        JsonEmitFieldBool("ok", false),
        JsonEmitFieldRaw("source", JsonEmitObject(source_fields)),
        JsonEmitFieldRaw("counts", JsonEmitObject(counts_fields)),
        JsonEmitFieldRaw("findings", JsonEmitArray(findings))
    ];
    return Some(JsonEmitObject(report_fields));
}

func Main() -> Void {
    let fixture_path: String = "src/self_hosted/tools/air_graph_id_uniqueness/fixture/graph_ids.json";
    if !FileExists(fixture_path) {
        Log(UnwrapOption(InputErrorJson(fixture_path)));
        Exit(1);
    }

    let content: String = ReadFile(fixture_path);
    let ids: Array<String> = AirGraphScalarFieldValues(content, "id");
    let total: Int = ArrayLength(ids);

    let seen: Array<String> = [];
    let dup_findings: Array<String> = [];
    let duplicates: Int = 0;
    let i: Int = 0;
    while i < total {
        let id_val: String = ids[i];
        if ArrayContainsString(seen, id_val) {
            duplicates = duplicates + 1;
            ArrayPush(dup_findings, UnwrapOption(DuplicateFinding(id_val)));
        } else {
            ArrayPush(seen, id_val);
        }
        i = i + 1;
    }
    let distinct: Int = ArrayLength(seen);

    let source_fields: Array<String> = [
        JsonEmitFieldString("input_schema", "pgy.air.graph.v1"),
        JsonEmitFieldString("fixture_owner", fixture_path)
    ];
    let counts_fields: Array<String> = [
        JsonEmitFieldNumber("ids", ToString(total)),
        JsonEmitFieldNumber("distinct", ToString(distinct)),
        JsonEmitFieldNumber("duplicates", ToString(duplicates))
    ];
    let report_fields: Array<String> = [
        JsonEmitFieldString("schema", "pgy.selfhost.air-id-uniqueness.v1"),
        JsonEmitFieldBool("ok", duplicates == 0),
        JsonEmitFieldRaw("source", JsonEmitObject(source_fields)),
        JsonEmitFieldRaw("counts", JsonEmitObject(counts_fields)),
        JsonEmitFieldRaw("findings", JsonEmitArray(dup_findings))
    ];
    Log(JsonEmitObject(report_fields));

    if duplicates > 0 {
        Exit(1);
    }
}
