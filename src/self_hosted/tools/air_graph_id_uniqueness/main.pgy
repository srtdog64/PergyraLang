// src/self_hosted/tools/air_graph_id_uniqueness/main.pgy
//
// Status: rung-1 minimal. Reads a stable AIR-graph-shaped JSON dump and checks
// that every node id is unique. Duplicate node ids in the compiler IR graph are
// a real defect, so this is a consumer/analysis pass over the dump rather than a
// schema validator. No JSON parser -- substring-anchored scan only, the same
// surface the AIR graph JSON validator established.
//
// Cwd contract: the parity harness cd's into the repo root before running.
// Contract: see intent.md in the same directory.

// Extract the raw token after each "id": occurrence, up to the next ',' or '}'.
// Numeric ("id":12) and quoted ("id":"n12") forms both yield a stable unique key.
func ExtractIds(content: String) -> Array<String> {
    let ids: Array<String> = [];
    let key: String = "\"id\":";
    let rest: String = content;
    let guard: Int = 0;
    while guard < 1000000 {
        guard = guard + 1;
        let idx: Int = StringIndexOf(rest, key);
        if idx < 0 {
            break;
        }
        let value_start: Int = idx + StringLength(key);
        let rest_len: Int = StringLength(rest) - value_start;
        if rest_len <= 0 {
            break;
        }
        let after: String = Substring(rest, value_start, rest_len);
        let comma_idx: Int = StringIndexOf(after, ",");
        let brace_idx: Int = StringIndexOf(after, "}");
        let stop: Int = -1;
        if comma_idx >= 0 {
            stop = comma_idx;
        }
        if brace_idx >= 0 {
            if stop < 0 || brace_idx < stop {
                stop = brace_idx;
            }
        }
        if stop <= 0 {
            stop = StringLength(after);
        }
        let id_val: String = Substring(after, 0, stop);
        ArrayPush(ids, id_val);
        let tail_len: Int = StringLength(after) - stop;
        rest = Substring(after, stop, tail_len);
    }
    return ids;
}

func ArrayContainsString(arr: Array<String>, target: String) -> Bool {
    let i: Int = 0;
    let n: Int = ArrayLength(arr);
    while i < n {
        if arr[i] == target {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func DuplicateFinding(id_val: String) -> String {
    let parts: Array<String> = [
        "{\"kind\":\"duplicate_id\",\"id\":\"",
        id_val,
        "\"}"
    ];
    return StringJoin(parts, "");
}

func InputErrorJson(path: String) -> String {
    let parts: Array<String> = [
        "{\"schema\":\"pgy.selfhost.air-id-uniqueness.v1\",\"ok\":false,",
        "\"source\":{\"input_schema\":\"pgy.air.graph.v1\",\"fixture_owner\":\"",
        path,
        "\"},\"counts\":{\"ids\":0,\"distinct\":0,\"duplicates\":0},",
        "\"findings\":[{\"kind\":\"input_error\",\"key\":\"",
        path,
        "\",\"location\":\"",
        path,
        "\"}]}"
    ];
    return StringJoin(parts, "");
}

func Main() -> Void {
    let fixture_path: String = "src/self_hosted/tools/air_graph_id_uniqueness/fixture/graph_ids.json";
    if !FileExists(fixture_path) {
        Log(InputErrorJson(fixture_path));
        Exit(1);
    }

    let content: String = ReadFile(fixture_path);
    let ids: Array<String> = ExtractIds(content);
    let total: Int = ArrayLength(ids);

    let seen: Array<String> = [];
    let dup_findings: Array<String> = [];
    let duplicates: Int = 0;
    let i: Int = 0;
    while i < total {
        let id_val: String = ids[i];
        if ArrayContainsString(seen, id_val) {
            duplicates = duplicates + 1;
            ArrayPush(dup_findings, DuplicateFinding(id_val));
        } else {
            ArrayPush(seen, id_val);
        }
        i = i + 1;
    }
    let distinct: Int = ArrayLength(seen);

    let ok_text: String = "true";
    if duplicates > 0 {
        ok_text = "false";
    }
    let findings: String = StringJoin(dup_findings, ",");

    let json_parts: Array<String> = [
        "{\"schema\":\"pgy.selfhost.air-id-uniqueness.v1\",\"ok\":",
        ok_text,
        ",\"source\":{\"input_schema\":\"pgy.air.graph.v1\",\"fixture_owner\":\"",
        fixture_path,
        "\"},\"counts\":{\"ids\":",
        ToString(total),
        ",\"distinct\":",
        ToString(distinct),
        ",\"duplicates\":",
        ToString(duplicates),
        "},\"findings\":[",
        findings,
        "]}"
    ];
    Log(StringJoin(json_parts, ""));

    if duplicates > 0 {
        Exit(1);
    }
}
