// src/self_hosted/tools/air_graph_json_validator/main.pgy
//
// Status: rung-2 minimal (2026-05-27). Reads
// src/self_hosted/tools/air_graph_json_validator/fixture/sample.json relative to
// cwd, validates the AIR-graph schema field, checks required top-level keys,
// extracts summary counts, emits a verdict JSON. No JSON parser -- substring
// scan only.
//
// Cwd contract: the parity harness cd's into the repo root before running.
//
// LLVM lift dependency: uses StringJoin (2026-05-26) for JSON build.
//
// Contract: see intent.md in the same directory.

func ExtractIntField(content: String, field: String) -> Int {
    let key: String = Concat(Concat("\"", field), "\":");
    let key_idx: Int = StringIndexOf(content, key);
    if key_idx < 0 {
        return -1;
    }
    let value_start: Int = key_idx + StringLength(key);
    let rest_len: Int = StringLength(content) - value_start;
    if rest_len <= 0 {
        return -1;
    }
    let rest: String = Substring(content, value_start, rest_len);
    let comma_idx: Int = StringIndexOf(rest, ",");
    let brace_idx: Int = StringIndexOf(rest, "}");
    let stop: Int = -1;
    if comma_idx >= 0 {
        stop = comma_idx;
    }
    if brace_idx >= 0 {
        if stop < 0 || brace_idx < stop {
            stop = brace_idx;
        }
    }
    if stop <= 0 {
        return -1;
    }
    let num_str: String = Substring(rest, 0, stop);
    return ToInt(num_str);
}

func CountSubstring(content: String, needle: String) -> Int {
    let count: Int = 0;
    let rest: String = content;
    let needle_len: Int = StringLength(needle);
    if needle_len <= 0 {
        return 0;
    }
    while true {
        let idx: Int = StringIndexOf(rest, needle);
        if idx < 0 {
            return count;
        }
        count = count + 1;
        let next: Int = idx + needle_len;
        let rest_len: Int = StringLength(rest);
        if next >= rest_len {
            return count;
        }
        rest = Substring(rest, next, rest_len - next);
    }
    return count;
}

func RequiredKeys() -> Array<String> {
    let keys: Array<String> = [
        "\"schema\":",
        "\"capabilities\":",
        "\"effects_by_op\":",
        "\"summary\":",
        "\"intents\":",
        "\"boundaries\":",
        "\"evidence\":",
        "\"drifts\":",
        "\"compression_budget\":",
        "\"compression_reason\":"
    ];
    return keys;
}

func RequiredCapabilityTraceKeys() -> Array<String> {
    let keys: Array<String> = [
        "\"schema\":",
        "\"capabilities\":",
        "\"effects_by_op\":",
        "\"summary\":",
        "\"evidence\":",
        "\"drifts\":"
    ];
    return keys;
}

func CountMissingKeys(content: String, keys: Array<String>) -> Int {
    let missing: Int = 0;
    let i: Int = 0;
    let n: Int = ArrayLength(keys);
    while i < n {
        let key: String = keys[i];
        if !StringContains(content, key) {
            missing = missing + 1;
        }
        i = i + 1;
    }
    return missing;
}

func MissingKeyFinding(key: String, location: String) -> String {
    let parts: Array<String> = [
        "{\"kind\":\"missing_key\",\"key\":\"",
        key,
        "\",\"location\":\"",
        location,
        "\"}"
    ];
    return StringJoin(parts, "");
}

func SchemaMismatchFinding(actual: String, location: String) -> String {
    let parts: Array<String> = [
        "{\"kind\":\"schema_mismatch\",\"key\":\"",
        actual,
        "\",\"location\":\"",
        location,
        "\"}"
    ];
    return StringJoin(parts, "");
}

func EnvEffectFinding(location: String) -> String {
    let parts: Array<String> = [
        "{\"kind\":\"missing_effect_site\",\"key\":\"Args:ENV:0x20\",",
        "\"location\":\"",
        location,
        "\"}"
    ];
    return StringJoin(parts, "");
}

func AppendFinding(findings: String, entry: String) -> String {
    if StringLength(entry) == 0 {
        return findings;
    }
    if StringLength(findings) == 0 {
        return entry;
    }
    return Concat(Concat(findings, ","), entry);
}

func BuildMissingKeyFindings(content: String, keys: Array<String>, location: String) -> String {
    let pieces: Array<String> = [];
    let i: Int = 0;
    let n: Int = ArrayLength(keys);
    while i < n {
        let key: String = keys[i];
        if !StringContains(content, key) {
            ArrayPush(pieces, MissingKeyFinding(key, location));
        }
        i = i + 1;
    }
    return StringJoin(pieces, ",");
}

func HasExpectedSchema(content: String) -> Bool {
    return StringContains(content, "\"schema\":\"pgy.air.graph.v1\"");
}

func InputErrorJson(path: String) -> String {
    let parts: Array<String> = [
        "{\"schema\":\"pgy.selfhost.air-graph-validator.v1\",\"ok\":false,",
        "\"source\":{\"input_schema\":\"pgy.air.graph.v1\",\"fixture_owner\":\"",
        path,
        "\"},\"counts\":{\"intents\":0,\"boundaries\":0,\"evidence\":0,",
        "\"drifts\":0,\"effect_sites\":0,\"env_effect_sites\":0,",
        "\"missing_keys\":0},",
        "\"findings\":[{\"kind\":\"input_error\",\"key\":\"",
        path,
        "\",\"location\":\"",
        path,
        "\"}]}"
    ];
    return StringJoin(parts, "");
}

func Main() -> Void {
    let fixture_path: String = "src/self_hosted/tools/air_graph_json_validator/fixture/sample.json";
    let cap_fixture_path: String = "src/self_hosted/tools/air_graph_json_validator/fixture/cap_env.json";
    if !FileExists(fixture_path) {
        Log(InputErrorJson(fixture_path));
        Exit(1);
    }
    if !FileExists(cap_fixture_path) {
        Log(InputErrorJson(cap_fixture_path));
        Exit(1);
    }

    let content: String = ReadFile(fixture_path);
    let cap_content: String = ReadFile(cap_fixture_path);
    let keys: Array<String> = RequiredKeys();
    let cap_keys: Array<String> = RequiredCapabilityTraceKeys();
    let missing_keys: Int = CountMissingKeys(content, keys) + CountMissingKeys(cap_content, cap_keys);
    let missing_findings: String = AppendFinding(
        BuildMissingKeyFindings(content, keys, fixture_path),
        BuildMissingKeyFindings(cap_content, cap_keys, cap_fixture_path));

    let schema_ok: Bool = HasExpectedSchema(content);
    let cap_schema_ok: Bool = HasExpectedSchema(cap_content);
    let intents: Int = ExtractIntField(content, "intent_count");
    let boundaries: Int = ExtractIntField(content, "boundary_count");
    let evidence: Int = ExtractIntField(content, "evidence_count");
    let drifts: Int = ExtractIntField(content, "drift_count");
    let effect_sites: Int = CountSubstring(content, "\"capability_mask\":\"0x")
        + CountSubstring(cap_content, "\"capability_mask\":\"0x");
    let env_effect_sites: Int = CountSubstring(
        cap_content,
        "\"op\":\"Args\",\"effect\":\"ENV\",\"capability_mask\":\"0x20\"");

    let findings: String = missing_findings;
    if !schema_ok {
        findings = AppendFinding(
            findings,
            SchemaMismatchFinding("schema-field-absent-or-wrong", fixture_path));
    }
    if !cap_schema_ok {
        findings = AppendFinding(
            findings,
            SchemaMismatchFinding("schema-field-absent-or-wrong", cap_fixture_path));
    }
    if env_effect_sites <= 0 {
        findings = AppendFinding(findings, EnvEffectFinding(cap_fixture_path));
    }

    let ok_text: String = "true";
    if missing_keys > 0 || !schema_ok || !cap_schema_ok || env_effect_sites <= 0 {
        ok_text = "false";
    }

    let json_parts: Array<String> = [
        "{\"schema\":\"pgy.selfhost.air-graph-validator.v1\",\"ok\":",
        ok_text,
        ",\"source\":{\"input_schema\":\"pgy.air.graph.v1\",\"fixture_owner\":\"",
        fixture_path,
        "\"},\"counts\":{\"intents\":",
        ToString(intents),
        ",\"boundaries\":",
        ToString(boundaries),
        ",\"evidence\":",
        ToString(evidence),
        ",\"drifts\":",
        ToString(drifts),
        ",\"effect_sites\":",
        ToString(effect_sites),
        ",\"env_effect_sites\":",
        ToString(env_effect_sites),
        ",\"missing_keys\":",
        ToString(missing_keys),
        "},\"findings\":[",
        findings,
        "]}"
    ];
    Log(StringJoin(json_parts, ""));

    if missing_keys > 0 || !schema_ok || !cap_schema_ok || env_effect_sites <= 0 {
        Exit(1);
    }
}
