// src/self_hosted/tools/air_graph_json_validator/report_owner.pgy
//
// JSON schema owner for pgy.selfhost.air-graph-validator.v1. Scan facts are
// rendered here; this owner does not inspect AIR JSON fixture contents.

import "../../lib/json.pgy";
import "../../lib/json_emit.pgy";

func FindingFactField(row: String, index: Int) -> String {
    let parts: Array<String> = Split(row, "|");
    if ArrayLength(parts) <= index {
        return "";
    }
    return parts[index];
}

func FindingJson(kind: String, key: String, location: String) -> String {
    let fields: Array<String> = [
        JsonEmitFieldString("kind", kind),
        JsonEmitFieldString("key", key),
        JsonEmitFieldString("location", location)
    ];
    return JsonEmitObject(fields);
}

func FindingsJsonFromFacts(facts: String) -> Array<String> {
    let rows: Array<String> = Split(facts, "\n");
    let findings: Array<String> = [];
    for row in rows {
        if StringLength(row) > 0 {
            let kind: String = FindingFactField(row, 0);
            let key: String = FindingFactField(row, 1);
            let location: String = FindingFactField(row, 2);
            let entry: String = FindingJson(kind, key, location);
            ArrayPush(findings, entry);
        }
    }
    return findings;
}

func InputErrorJson(path: String) -> String {
    let source_fields: Array<String> = [
        JsonEmitFieldString("input_schema", "pgy.air.graph.v1"),
        JsonEmitFieldString("fixture_owner", path)
    ];
    let counts_fields: Array<String> = [
        JsonEmitFieldNumber("intents", "0"),
        JsonEmitFieldNumber("boundaries", "0"),
        JsonEmitFieldNumber("evidence", "0"),
        JsonEmitFieldNumber("drifts", "0"),
        JsonEmitFieldNumber("effect_sites", "0"),
        JsonEmitFieldNumber("env_effect_sites", "0"),
        JsonEmitFieldNumber("missing_keys", "0")
    ];
    let finding_fields: Array<String> = [
        JsonEmitFieldString("kind", "input_error"),
        JsonEmitFieldString("key", path),
        JsonEmitFieldString("location", path)
    ];
    let findings: Array<String> = [
        JsonEmitObject(finding_fields)
    ];
    let report_fields: Array<String> = [
        JsonEmitFieldString("schema", "pgy.selfhost.air-graph-validator.v1"),
        JsonEmitFieldBool("ok", false),
        JsonEmitFieldRaw("source", JsonEmitObject(source_fields)),
        JsonEmitFieldRaw("counts", JsonEmitObject(counts_fields)),
        JsonEmitFieldRaw("findings", JsonEmitArray(findings))
    ];
    return JsonEmitObject(report_fields);
}

func AirGraphValidatorJson(
    fixture_path: String,
    intents: Int,
    boundaries: Int,
    evidence: Int,
    drifts: Int,
    effect_sites: Int,
    env_effect_sites: Int,
    missing_keys: Int,
    ok: Bool,
    finding_facts: String
) -> String {
    let source_fields: Array<String> = [
        JsonEmitFieldString("input_schema", "pgy.air.graph.v1"),
        JsonEmitFieldString("fixture_owner", fixture_path)
    ];
    let counts_fields: Array<String> = [
        JsonEmitFieldNumber("intents", ToString(intents)),
        JsonEmitFieldNumber("boundaries", ToString(boundaries)),
        JsonEmitFieldNumber("evidence", ToString(evidence)),
        JsonEmitFieldNumber("drifts", ToString(drifts)),
        JsonEmitFieldNumber("effect_sites", ToString(effect_sites)),
        JsonEmitFieldNumber("env_effect_sites", ToString(env_effect_sites)),
        JsonEmitFieldNumber("missing_keys", ToString(missing_keys))
    ];
    let report_fields: Array<String> = [
        JsonEmitFieldString("schema", "pgy.selfhost.air-graph-validator.v1"),
        JsonEmitFieldBool("ok", ok),
        JsonEmitFieldRaw("source", JsonEmitObject(source_fields)),
        JsonEmitFieldRaw("counts", JsonEmitObject(counts_fields)),
        JsonEmitFieldRaw("findings", JsonEmitArray(FindingsJsonFromFacts(finding_facts)))
    ];
    return JsonEmitObject(report_fields);
}
