// src/self_hosted/tools/air_graph_json_validator/run_owner.pgy
//
// CLI/run owner for the AIR graph JSON validator. This file owns fixed fixture
// paths, filesystem reads, logging, and process exit policy.

import "../../compiler/air_evidence_owner.pgy";

func RunAirGraphJsonValidation() -> Void {
    if !CompilerAirEvidenceEnvelopeReady() {
        Log(UnwrapOption(InputErrorJson("compiler AIR evidence envelope")));
        Exit(1);
    }
    let fixture_path: String = "src/self_hosted/tools/air_graph_json_validator/fixture/sample.json";
    let cap_fixture_path: String = "src/self_hosted/tools/air_graph_json_validator/fixture/cap_env.json";
    if !FileExists(fixture_path) {
        Log(UnwrapOption(InputErrorJson(fixture_path)));
        Exit(1);
    }
    if !FileExists(cap_fixture_path) {
        Log(UnwrapOption(InputErrorJson(cap_fixture_path)));
        Exit(1);
    }

    let content: String = ReadFile(fixture_path);
    let cap_content: String = ReadFile(cap_fixture_path);
    let keys: Array<String> = RequiredKeys();
    let cap_keys: Array<String> = RequiredCapabilityTraceKeys();
    let feature_keys: Array<String> = RequiredGraphFeatureKeys();
    let missing_keys: Int = CountMissingKeys(content, keys)
        + CountMissingKeys(cap_content, cap_keys)
        + CountMissingGraphFeatureKeys(content, feature_keys);
    let schema_ok: Bool = HasExpectedSchema(content);
    let cap_schema_ok: Bool = HasExpectedSchema(cap_content);
    let intents_box: Array<Int> = [0];
    let boundaries_box: Array<Int> = [0];
    let evidence_box: Array<Int> = [0];
    let drifts_box: Array<Int> = [0];
    let counts_ok: Bool = true;
    if !AirGraphSummaryIntField(content, "intent_count", intents_box) {
        counts_ok = false;
    }
    if !AirGraphSummaryIntField(content, "boundary_count", boundaries_box) {
        counts_ok = false;
    }
    if !AirGraphSummaryIntField(content, "evidence_count", evidence_box) {
        counts_ok = false;
    }
    if !AirGraphSummaryIntField(content, "drift_count", drifts_box) {
        counts_ok = false;
    }
    let intents: Int = intents_box[0];
    let boundaries: Int = boundaries_box[0];
    let evidence: Int = evidence_box[0];
    let drifts: Int = drifts_box[0];
    let effect_sites: Int = CountEffectSites(content, cap_content);
    let env_effect_sites: Int = CountEnvEffectSites(cap_content);
    let finding_facts: String = BuildAirGraphFindingFacts(content, cap_content, fixture_path, cap_fixture_path);
    let ok: Bool = missing_keys == 0 && schema_ok && cap_schema_ok && counts_ok && env_effect_sites > 0;

    Log(AirGraphValidatorJson(
        fixture_path,
        intents,
        boundaries,
        evidence,
        drifts,
        effect_sites,
        env_effect_sites,
        missing_keys,
        ok,
        finding_facts));

    if !ok {
        Exit(1);
    }
}
