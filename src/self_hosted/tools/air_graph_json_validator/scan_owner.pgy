// src/self_hosted/tools/air_graph_json_validator/scan_owner.pgy
//
// AIR JSON scan owner. This file extracts stable summary counts, scalar graph
// facts, and finding facts from committed AIR graph fixtures. It does not own
// the output JSON schema or filesystem/exit policy.

import "../../lib/json.pgy";

func AirGraphSummaryIntField(content: String, field: String, inout value_out: Array<Int>) -> Bool {
    let doc_end_opt: Option<Int> = JsonDocumentObjectEnd(content);
    if !IsSome(doc_end_opt) {
        return false;
    }
    let summary_bounds: Array<Int> = [0, 0];
    if !JsonObjectFieldValueBounds(content, 0, UnwrapOption(doc_end_opt), "summary", summary_bounds) {
        return false;
    }
    let num_str: Option<String> = JsonObjectNumberFieldOpt(content, summary_bounds[0], summary_bounds[1], field);
    if !IsSome(num_str) {
        return false;
    }
    let number_text: String = UnwrapOption(num_str);
    value_out[0] = ToInt(number_text);
    return true;
}

func AirGraphScalarToken(content: String, start: Int, end: Int) -> String {
    let value_start: Int = JsonSkipWhitespace(content, start, end);
    if value_start >= end {
        return "";
    }
    if CharAt(content, value_start) == "\"" {
        let string_end: Array<Int> = [0];
        return ReadJsonString(content, value_start, string_end);
    }
    return Substring(content, value_start, end - value_start);
}

func AirGraphCollectScalarFieldValues(content: String, start: Int, end: Int, field: String, inout values: Array<String>) -> Void {
    if start < 0 || end <= start {
        return;
    }
    let open: String = CharAt(content, start);
    if open == "{" {
        let i: Int = start + 1;
        while i < end {
            i = JsonSkipWhitespace(content, i, end);
            if i >= end || CharAt(content, i) == "}" {
                return;
            }
            if CharAt(content, i) == "," {
                i = i + 1;
                continue;
            }
            if CharAt(content, i) != "\"" {
                return;
            }
            let key_end: Array<Int> = [0];
            let key: String = ReadJsonString(content, i, key_end);
            if key_end[0] <= i {
                return;
            }
            i = JsonSkipWhitespace(content, key_end[0], end);
            if i >= end || CharAt(content, i) != ":" {
                return;
            }
            i = JsonSkipWhitespace(content, i + 1, end);
            let value_end_opt: Option<Int> = JsonValueEnd(content, i, end);
            if !IsSome(value_end_opt) {
                return;
            }
            let value_end: Int = UnwrapOption(value_end_opt);
            if key == field {
                ArrayPush(values, AirGraphScalarToken(content, i, value_end));
            }
            let value_open: String = CharAt(content, i);
            if value_open == "{" || value_open == "[" {
                AirGraphCollectScalarFieldValues(content, i, value_end, field, values);
            }
            i = value_end;
        }
        return;
    }
    if open == "[" {
        let j: Int = start + 1;
        while j < end {
            j = JsonSkipWhitespace(content, j, end);
            if j >= end || CharAt(content, j) == "]" {
                return;
            }
            if CharAt(content, j) == "," {
                j = j + 1;
                continue;
            }
            let item_end_opt: Option<Int> = JsonValueEnd(content, j, end);
            if !IsSome(item_end_opt) {
                return;
            }
            let item_end: Int = UnwrapOption(item_end_opt);
            let item_open: String = CharAt(content, j);
            if item_open == "{" || item_open == "[" {
                AirGraphCollectScalarFieldValues(content, j, item_end, field, values);
            }
            j = item_end;
        }
    }
}

func AirGraphScalarFieldValues(content: String, field: String) -> Array<String> {
    let values: Array<String> = [];
    let doc_end_opt: Option<Int> = JsonDocumentObjectEnd(content);
    if !IsSome(doc_end_opt) {
        return values;
    }
    AirGraphCollectScalarFieldValues(content, 0, UnwrapOption(doc_end_opt), field, values);
    return values;
}

func CountSubstring(content: String, needle: String) -> Int {
    let count: Int = 0;
    let rest: String = content;
    let needle_len: Int = StringLength(needle);
    if needle_len <= 0 {
        return 0;
    }
    while true {
        let idx: Int = StringIndexOf(rest, needle);
        if idx < 0 {
            return count;
        }
        count = count + 1;
        let next: Int = idx + needle_len;
        let rest_len: Int = StringLength(rest);
        if next >= rest_len {
            return count;
        }
        rest = Substring(rest, next, rest_len - next);
    }
    return count;
}

func RequiredKeys() -> Array<String> {
    let keys: Array<String> = [
        JsonFieldKey("schema"),
        JsonFieldKey("capabilities"),
        JsonFieldKey("effects_by_op"),
        JsonFieldKey("summary"),
        JsonFieldKey("intents"),
        JsonFieldKey("boundaries"),
        JsonFieldKey("evidence"),
        JsonFieldKey("drifts"),
        JsonFieldKey("compression_budget"),
        JsonFieldKey("compression_reason"),
        JsonFieldKey("execution_lane"),
        JsonFieldKey("boundary_capture")
    ];
    return keys;
}

func RequiredCapabilityTraceKeys() -> Array<String> {
    let keys: Array<String> = [
        JsonFieldKey("schema"),
        JsonFieldKey("capabilities"),
        JsonFieldKey("effects_by_op"),
        JsonFieldKey("summary"),
        JsonFieldKey("evidence"),
        JsonFieldKey("drifts")
    ];
    return keys;
}

func CountMissingKeys(content: String, keys: Array<String>) -> Int {
    let missing: Int = 0;
    let i: Int = 0;
    let n: Int = ArrayLength(keys);
    while i < n {
        let key: String = keys[i];
        if !StringContains(content, key) {
            missing = missing + 1;
        }
        i = i + 1;
    }
    return missing;
}

func FindingFact(kind: String, key: String, location: String) -> String {
    return "${kind}|${key}|${location}";
}

func AppendFindingFact(facts: String, entry: String) -> String {
    if StringLength(entry) == 0 {
        return facts;
    }
    if StringLength(facts) == 0 {
        return entry;
    }
    return Concat(Concat(facts, "\n"), entry);
}

func BuildMissingKeyFindingFacts(content: String, keys: Array<String>, location: String) -> String {
    let facts: String = "";
    let i: Int = 0;
    let n: Int = ArrayLength(keys);
    while i < n {
        let key: String = keys[i];
        if !StringContains(content, key) {
            let entry: String = FindingFact("missing_key", key, location);
            facts = AppendFindingFact(facts, entry);
        }
        i = i + 1;
    }
    return facts;
}

func HasExpectedSchema(content: String) -> Bool {
    return JsonDocumentStringFieldEquals(content, "schema", "pgy.air.graph.v1");
}

func CountEffectSites(content: String, cap_content: String) -> Int {
    return CountSubstring(content, "\"capability_mask\":\"0x")
        + CountSubstring(cap_content, "\"capability_mask\":\"0x");
}

func CountEnvEffectSites(cap_content: String) -> Int {
    return CountSubstring(
        cap_content,
        "\"op\":\"Args\",\"effect\":\"ENV\",\"capability_mask\":\"0x20\"");
}

func BuildAirGraphFindingFacts(
    content: String,
    cap_content: String,
    fixture_path: String,
    cap_fixture_path: String
) -> String {
    let keys: Array<String> = RequiredKeys();
    let cap_keys: Array<String> = RequiredCapabilityTraceKeys();
    let facts: String = AppendFindingFact(
        BuildMissingKeyFindingFacts(content, keys, fixture_path),
        BuildMissingKeyFindingFacts(cap_content, cap_keys, cap_fixture_path));

    if !HasExpectedSchema(content) {
        facts = AppendFindingFact(
            facts,
            FindingFact("schema_mismatch", "schema-field-absent-or-wrong", fixture_path));
    }
    if !HasExpectedSchema(cap_content) {
        facts = AppendFindingFact(
            facts,
            FindingFact("schema_mismatch", "schema-field-absent-or-wrong", cap_fixture_path));
    }
    if CountEnvEffectSites(cap_content) <= 0 {
        facts = AppendFindingFact(facts, FindingFact("missing_effect_site", "Args:ENV:0x20", cap_fixture_path));
    }
    return facts;
}
