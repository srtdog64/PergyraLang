// src/self_hosted/tools/air_graph_reachability/main.pgy
//
// Status: rung-1 minimal. Reads a stable AIR-graph-shaped JSON dump and runs a
// worklist reachability over the directed edges from the declared root(s).
// A node that no path from a root reaches is an orphan -- dead IR that a later
// pass will either mis-handle or waste work on. Consumer/analysis pass. No JSON
// parser -- substring-anchored scan only.
//
// The worklist is an Array<String> frontier with an advancing cursor (a BFS
// queue without pop), and a visited Array<String>. This dogfoods the graph
// traversal substrate the hard-self-host tier requires, using only push/index.
//
// Cwd contract: the parity harness cd's into the repo root before running.
// Contract: see intent.md in the same directory.

import "../../lib/json.pgy";

func ExtractByKey(content: String, key: String) -> Array<String> {
    let vals: Array<String> = [];
    let rest: String = content;
    let guard: Int = 0;
    while guard < 1000000 {
        guard = guard + 1;
        let idx: Int = StringIndexOf(rest, key);
        if idx < 0 {
            break;
        }
        let value_start: Int = idx + StringLength(key);
        let rest_len: Int = StringLength(rest) - value_start;
        if rest_len <= 0 {
            break;
        }
        let after: String = Substring(rest, value_start, rest_len);
        let comma_idx: Int = StringIndexOf(after, ",");
        let brace_idx: Int = StringIndexOf(after, "}");
        let stop: Int = -1;
        if comma_idx >= 0 {
            stop = comma_idx;
        }
        if brace_idx >= 0 {
            if stop < 0 || brace_idx < stop {
                stop = brace_idx;
            }
        }
        if stop <= 0 {
            stop = StringLength(after);
        }
        let val: String = Substring(after, 0, stop);
        ArrayPush(vals, val);
        let tail_len: Int = StringLength(after) - stop;
        rest = Substring(after, stop, tail_len);
    }
    return vals;
}

func ArrayContainsString(arr: Array<String>, target: String) -> Bool {
    let i: Int = 0;
    let n: Int = ArrayLength(arr);
    while i < n {
        if arr[i] == target {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func OrphanFinding(id_val: String) -> String {
    let fields: Array<String> = [
        JsonEmitFieldString("kind", "orphan_node"),
        JsonEmitFieldString("id", id_val)
    ];
    return JsonEmitObject(fields);
}

func InputErrorJson(path: String) -> String {
    let source_fields: Array<String> = [
        JsonEmitFieldString("input_schema", "pgy.air.graph.v1"),
        JsonEmitFieldString("fixture_owner", path)
    ];
    let counts_fields: Array<String> = [
        JsonEmitFieldNumber("nodes", "0"),
        JsonEmitFieldNumber("reachable", "0"),
        JsonEmitFieldNumber("orphans", "0")
    ];
    let finding_fields: Array<String> = [
        JsonEmitFieldString("kind", "input_error"),
        JsonEmitFieldString("key", path),
        JsonEmitFieldString("location", path)
    ];
    let findings: Array<String> = [
        JsonEmitObject(finding_fields)
    ];
    let report_fields: Array<String> = [
        JsonEmitFieldString("schema", "pgy.selfhost.air-reachability.v1"),
        JsonEmitFieldBool("ok", false),
        JsonEmitFieldRaw("source", JsonEmitObject(source_fields)),
        JsonEmitFieldRaw("counts", JsonEmitObject(counts_fields)),
        JsonEmitFieldRaw("findings", JsonEmitArray(findings))
    ];
    return JsonEmitObject(report_fields);
}

// BFS over edges (froms[i] -> tos[i]) starting from every root; returns the
// visited (reachable) id list. Frontier is a push-only array with a cursor.
func Reachable(roots: Array<String>, froms: Array<String>, tos: Array<String>) -> Array<String> {
    let frontier: Array<String> = [];
    let r: Int = 0;
    let rn: Int = ArrayLength(roots);
    while r < rn {
        ArrayPush(frontier, roots[r]);
        r = r + 1;
    }

    let visited: Array<String> = [];
    let cursor: Int = 0;
    let guard: Int = 0;
    while cursor < ArrayLength(frontier) && guard < 1000000 {
        guard = guard + 1;
        let cur: String = frontier[cursor];
        cursor = cursor + 1;
        if !ArrayContainsString(visited, cur) {
            ArrayPush(visited, cur);
            let i: Int = 0;
            let e: Int = ArrayLength(froms);
            while i < e {
                if froms[i] == cur {
                    ArrayPush(frontier, tos[i]);
                }
                i = i + 1;
            }
        }
    }
    return visited;
}

func Main() -> Void {
    let fixture_path: String = "src/self_hosted/tools/air_graph_reachability/fixture/graph_rooted.json";
    if !FileExists(fixture_path) {
        Log(InputErrorJson(fixture_path));
        Exit(1);
    }

    let content: String = ReadFile(fixture_path);
    let node_ids: Array<String> = ExtractByKey(content, "\"id\":");
    let roots: Array<String> = ExtractByKey(content, "\"root\":");
    let froms: Array<String> = ExtractByKey(content, "\"from\":");
    let tos: Array<String> = ExtractByKey(content, "\"to\":");

    let visited: Array<String> = Reachable(roots, froms, tos);

    let orphans: Int = 0;
    let findings_list: Array<String> = [];
    let i: Int = 0;
    let nn: Int = ArrayLength(node_ids);
    while i < nn {
        let nid: String = node_ids[i];
        if !ArrayContainsString(visited, nid) {
            orphans = orphans + 1;
            ArrayPush(findings_list, OrphanFinding(nid));
        }
        i = i + 1;
    }

    let nodes: Int = ArrayLength(node_ids);
    let reachable: Int = ArrayLength(visited);

    let source_fields: Array<String> = [
        JsonEmitFieldString("input_schema", "pgy.air.graph.v1"),
        JsonEmitFieldString("fixture_owner", fixture_path)
    ];
    let counts_fields: Array<String> = [
        JsonEmitFieldNumber("nodes", ToString(nodes)),
        JsonEmitFieldNumber("reachable", ToString(reachable)),
        JsonEmitFieldNumber("orphans", ToString(orphans))
    ];
    let report_fields: Array<String> = [
        JsonEmitFieldString("schema", "pgy.selfhost.air-reachability.v1"),
        JsonEmitFieldBool("ok", orphans == 0),
        JsonEmitFieldRaw("source", JsonEmitObject(source_fields)),
        JsonEmitFieldRaw("counts", JsonEmitObject(counts_fields)),
        JsonEmitFieldRaw("findings", JsonEmitArray(findings_list))
    ];
    Log(JsonEmitObject(report_fields));

    if orphans > 0 {
        Exit(1);
    }
}
