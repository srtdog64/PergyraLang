// src/self_hosted/tools/air_graph_ref_integrity/main.pgy
//
// Status: rung-1 minimal. Reads a stable AIR-graph-shaped JSON dump and checks
// referential integrity: every edge endpoint ("from"/"to") must name a node id
// that exists. A dangling endpoint is a real IR defect (an edge into a node that
// was deleted or never numbered). Consumer/analysis pass, not a schema
// validator. AIR graph scalar facts are consumed through the shared scan owner
// so this checker does not rebuild JSON token extraction locally.
//
// Cwd contract: the parity harness cd's into the repo root before running.
// Contract: see intent.md in the same directory.

import "../../lib/json.pgy";
import "../../lib/json_emit.pgy";
import "../air_graph_json_validator/scan_owner.pgy";

func ArrayContainsString(arr: Array<String>, target: String) -> Bool {
    let i: Int = 0;
    let n: Int = ArrayLength(arr);
    while i < n {
        if arr[i] == target {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func AppendAll(dest: Array<String>, src: Array<String>) -> Array<String> {
    let out: Array<String> = dest;
    let i: Int = 0;
    let n: Int = ArrayLength(src);
    while i < n {
        ArrayPush(out, src[i]);
        i = i + 1;
    }
    return out;
}

func DanglingFinding(id_val: String) -> String {
    let fields: Array<String> = [
        JsonEmitFieldString("kind", "dangling_edge_endpoint"),
        JsonEmitFieldString("id", id_val)
    ];
    return JsonEmitObject(fields);
}

func InputErrorJson(path: String) -> String {
    let source_fields: Array<String> = [
        JsonEmitFieldString("input_schema", "pgy.air.graph.v1"),
        JsonEmitFieldString("fixture_owner", path)
    ];
    let counts_fields: Array<String> = [
        JsonEmitFieldNumber("nodes", "0"),
        JsonEmitFieldNumber("endpoints", "0"),
        JsonEmitFieldNumber("dangling", "0")
    ];
    let finding_fields: Array<String> = [
        JsonEmitFieldString("kind", "input_error"),
        JsonEmitFieldString("key", path),
        JsonEmitFieldString("location", path)
    ];
    let findings: Array<String> = [
        JsonEmitObject(finding_fields)
    ];
    let report_fields: Array<String> = [
        JsonEmitFieldString("schema", "pgy.selfhost.air-ref-integrity.v1"),
        JsonEmitFieldBool("ok", false),
        JsonEmitFieldRaw("source", JsonEmitObject(source_fields)),
        JsonEmitFieldRaw("counts", JsonEmitObject(counts_fields)),
        JsonEmitFieldRaw("findings", JsonEmitArray(findings))
    ];
    return JsonEmitObject(report_fields);
}

func Main() -> Void {
    let fixture_path: String = "src/self_hosted/tools/air_graph_ref_integrity/fixture/graph_edges.json";
    if !FileExists(fixture_path) {
        Log(InputErrorJson(fixture_path));
        Exit(1);
    }

    let content: String = ReadFile(fixture_path);
    let node_ids: Array<String> = AirGraphScalarFieldValues(content, "id");
    let froms: Array<String> = AirGraphScalarFieldValues(content, "from");
    let tos: Array<String> = AirGraphScalarFieldValues(content, "to");

    let endpoints: Array<String> = [];
    endpoints = AppendAll(endpoints, froms);
    endpoints = AppendAll(endpoints, tos);

    let dangling: Int = 0;
    let findings_list: Array<String> = [];
    let i: Int = 0;
    let m: Int = ArrayLength(endpoints);
    while i < m {
        let ep: String = endpoints[i];
        if !ArrayContainsString(node_ids, ep) {
            dangling = dangling + 1;
            ArrayPush(findings_list, DanglingFinding(ep));
        }
        i = i + 1;
    }

    let nodes: Int = ArrayLength(node_ids);
    let endpoint_count: Int = ArrayLength(endpoints);

    let source_fields: Array<String> = [
        JsonEmitFieldString("input_schema", "pgy.air.graph.v1"),
        JsonEmitFieldString("fixture_owner", fixture_path)
    ];
    let counts_fields: Array<String> = [
        JsonEmitFieldNumber("nodes", ToString(nodes)),
        JsonEmitFieldNumber("endpoints", ToString(endpoint_count)),
        JsonEmitFieldNumber("dangling", ToString(dangling))
    ];
    let report_fields: Array<String> = [
        JsonEmitFieldString("schema", "pgy.selfhost.air-ref-integrity.v1"),
        JsonEmitFieldBool("ok", dangling == 0),
        JsonEmitFieldRaw("source", JsonEmitObject(source_fields)),
        JsonEmitFieldRaw("counts", JsonEmitObject(counts_fields)),
        JsonEmitFieldRaw("findings", JsonEmitArray(findings_list))
    ];
    Log(JsonEmitObject(report_fields));

    if dangling > 0 {
        Exit(1);
    }
}
