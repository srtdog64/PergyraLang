// src/self_hosted/tools/air_graph_ref_live/main.pgy
//
// Status: rung-1 minimal. Live-schema referential integrity over the real
// `pgy --air-json` dump (via the validator's drift-guarded fixture). Unlike the
// fixture-shaped air_graph_ref_integrity (which used "from"/"to" edges), the
// real dump uses dense 0-based ids per array and back-references: each
// evidence."boundary" names a boundary id (or null), each boundary."intent"
// names an intent id. Because ids are dense and 0-based, a reference is valid
// iff 0 <= ref < count, where count is the compiler-owned summary count -- so no
// array scoping is needed. No JSON parser; substring-anchored scan only.
//
// Cwd contract: the parity harness cd's into the repo root before running.
// Contract: see intent.md in the same directory.

import "../../lib/json.pgy";
import "../air_graph_json_validator/scan_owner.pgy";

func FirstTokenAfter(s: String, start: Int) -> String {
    let after: String = Substring(s, start, StringLength(s) - start);
    let c: Int = StringIndexOf(after, ",");
    let b: Int = StringIndexOf(after, "}");
    let stop: Int = -1;
    if c >= 0 {
        stop = c;
    }
    if b >= 0 {
        if stop < 0 || b < stop {
            stop = b;
        }
    }
    if stop <= 0 {
        stop = StringLength(after);
    }
    return Substring(after, 0, stop);
}

// Count references under `key` whose value is not "null" and falls outside
// [0, limit). Each `"<key>":` occurrence is scanned in order.
func DanglingRefs(content: String, key: String, limit: Int) -> Int {
    let dangling: Int = 0;
    let rest: String = content;
    let guard: Int = 0;
    while guard < 1000000 {
        guard = guard + 1;
        let idx: Int = StringIndexOf(rest, key);
        if idx < 0 {
            break;
        }
        let vstart: Int = idx + StringLength(key);
        let tok: String = FirstTokenAfter(rest, vstart);
        if tok != "null" {
            let n: Int = ToInt(tok);
            if n < 0 || n >= limit {
                dangling = dangling + 1;
            }
        }
        let tail_len: Int = StringLength(rest) - vstart;
        rest = Substring(rest, vstart, tail_len);
    }
    return dangling;
}

func DanglingFinding(boundary_d: Int, intent_d: Int) -> String {
    let fields: Array<String> = [
        JsonEmitFieldString("kind", "dangling_reference"),
        JsonEmitFieldNumber("boundary_refs", ToString(boundary_d)),
        JsonEmitFieldNumber("intent_refs", ToString(intent_d))
    ];
    return JsonEmitObject(fields);
}

func FindingsFor(dangling: Int, boundary_d: Int, intent_d: Int) -> Array<String> {
    let findings: Array<String> = [];
    if dangling > 0 {
        ArrayPush(findings, DanglingFinding(boundary_d, intent_d));
    }
    return findings;
}

func InputErrorJson(path: String) -> String {
    let source_fields: Array<String> = [
        JsonEmitFieldString("input_schema", "pgy.air.graph.v1"),
        JsonEmitFieldString("fixture_owner", path)
    ];
    let counts_fields: Array<String> = [
        JsonEmitFieldNumber("boundary_refs_dangling", "0"),
        JsonEmitFieldNumber("intent_refs_dangling", "0"),
        JsonEmitFieldNumber("dangling", "0")
    ];
    let finding_fields: Array<String> = [
        JsonEmitFieldString("kind", "input_error"),
        JsonEmitFieldString("key", path),
        JsonEmitFieldString("location", path)
    ];
    let findings: Array<String> = [
        JsonEmitObject(finding_fields)
    ];
    let report_fields: Array<String> = [
        JsonEmitFieldString("schema", "pgy.selfhost.air-ref-live.v1"),
        JsonEmitFieldBool("ok", false),
        JsonEmitFieldRaw("source", JsonEmitObject(source_fields)),
        JsonEmitFieldRaw("counts", JsonEmitObject(counts_fields)),
        JsonEmitFieldRaw("findings", JsonEmitArray(findings))
    ];
    return JsonEmitObject(report_fields);
}

func Main() -> Void {
    let fixture_path: String = "src/self_hosted/tools/air_graph_json_validator/fixture/sample.json";
    if !FileExists(fixture_path) {
        Log(InputErrorJson(fixture_path));
        Exit(1);
    }

    let content: String = ReadFile(fixture_path);
    let intent_count_box: Array<Int> = [0];
    let boundary_count_box: Array<Int> = [0];
    let counts_ok: Bool = true;
    if !AirGraphSummaryIntField(content, "intent_count", intent_count_box) {
        counts_ok = false;
    }
    if !AirGraphSummaryIntField(content, "boundary_count", boundary_count_box) {
        counts_ok = false;
    }
    let intent_count: Int = intent_count_box[0];
    let boundary_count: Int = boundary_count_box[0];

    let boundary_dangling: Int = DanglingRefs(content, "\"boundary\":", boundary_count);
    let intent_dangling: Int = DanglingRefs(content, "\"intent\":", intent_count);
    let dangling: Int = boundary_dangling + intent_dangling;
    if !counts_ok {
        dangling = dangling + 1;
    }

    let findings: Array<String> = FindingsFor(dangling, boundary_dangling, intent_dangling);
    let source_fields: Array<String> = [
        JsonEmitFieldString("input_schema", "pgy.air.graph.v1"),
        JsonEmitFieldString("fixture_owner", fixture_path)
    ];
    let counts_fields: Array<String> = [
        JsonEmitFieldNumber("boundary_refs_dangling", ToString(boundary_dangling)),
        JsonEmitFieldNumber("intent_refs_dangling", ToString(intent_dangling)),
        JsonEmitFieldNumber("dangling", ToString(dangling))
    ];
    let report_fields: Array<String> = [
        JsonEmitFieldString("schema", "pgy.selfhost.air-ref-live.v1"),
        JsonEmitFieldBool("ok", dangling == 0),
        JsonEmitFieldRaw("source", JsonEmitObject(source_fields)),
        JsonEmitFieldRaw("counts", JsonEmitObject(counts_fields)),
        JsonEmitFieldRaw("findings", JsonEmitArray(findings))
    ];
    Log(JsonEmitObject(report_fields));

    if dangling > 0 {
        Exit(1);
    }
}
