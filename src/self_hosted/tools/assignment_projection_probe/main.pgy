// Focused executable proof for semantic-owned assignment projections.

import "../../codegen/emission/assign_emit_owner.pgy";
import "../../codegen/type_facts/type_env_state_lifetime_owner.pgy";
import "../../codegen/emission/function_binding_env_owner.pgy";
import "../../semantic/ast_expression_call_target_capture_owner.pgy";
import "../../semantic/ast_expression_place_fact_owner.pgy";

func ProbeAssignmentFacts(
    target: String,
    base_name: String,
    is_indexed: Int,
    index_text: String,
    expression: String
) -> SemanticAstAssignmentFacts {
    return SemanticAstAssignmentFacts(
        true, "", "", 1,
        [0], [0], [0], [target], [base_name], [base_name], [is_indexed],
        [index_text], [expression]
    );
}

func ProbeExpressionGraph(
    expression: String,
    carry_call_targets: Bool,
    binding_name: String,
    carry_binding_place_fact: Bool
) -> SemanticExpressionGraphView {
    let node_kinds: Array<Int> = [];
    let node_texts: Array<String> = [];
    let left_children: Array<Int> = [];
    let right_children: Array<Int> = [];
    let call_target_kinds: Array<Int> = [];
    let call_target_names: Array<String> = [];
    let built: SemanticExpressionGraphBuild =
        SemanticExpressionGraphBuildCompactBridgeFromText(
            node_kinds, node_texts, left_children, right_children,
            call_target_kinds, call_target_names, expression
        );
    if !built.ok { Die("assignment projection probe graph build failed"); }
    let place_kinds: Array<Int> = [];
    let node_index: Int = 0;
    while node_index < ArrayLength(node_kinds) {
        let place_kind: Int = SemanticExpressionPlaceValue();
        if binding_name != "" &&
            node_kinds[node_index] == AstExpressionNodeLeaf() &&
            node_texts[node_index] == binding_name {
            if carry_binding_place_fact {
                place_kind = SemanticExpressionPlaceBinding();
            } else {
                place_kind = SemanticExpressionPlaceUnknown();
            }
        }
        ArrayPush(place_kinds, place_kind);
        node_index = node_index + 1;
    }
    let arena: SemanticExpressionGraphArena =
        SemanticExpressionGraphArenaFromRows(
        node_kinds, node_texts, left_children, right_children,
        call_target_kinds, call_target_names, place_kinds
    );
    let source: SemanticExpressionGraphFacts = SemanticExpressionGraphFacts(
        true, [built.root_id], [true], arena
    );
    let facts: SemanticExpressionGraphFacts = source;
    if carry_call_targets {
        let artifact: AstTreeArtifact = AstTreeArtifactFromText("Program:\n");
        let signatures: SemanticAstFunctionSignatureFacts =
            SemanticAstFunctionSignatureFactsFromArtifact(artifact);
        let intents: SemanticAstIntentSignatureFacts =
            SemanticAstIntentSignatureFactsFromArtifact(artifact);
        let constructors: SemanticAstNominalConstructorFacts =
            SemanticAstNominalConstructorFactsFromArtifact(artifact);
        let enums: SemanticAstEnumFacts =
            SemanticAstEnumFactsFromArtifact(artifact);
        let function_tables: SemanticAstExpressionFunctionTableFacts =
            SemanticAstExpressionFunctionTableFactsFromArtifact(
                artifact, signatures, constructors, enums
            );
        facts = SemanticExpressionGraphCallTargetsFromSignatures(
            source, signatures, intents, constructors, enums, false,
            function_tables
        );
        if !facts.ok {
            Die("assignment projection probe call-target capture failed");
        }
    }
    if carry_binding_place_fact &&
        !SemanticExpressionGraphPlaceKindsReady(facts) {
        Die("assignment projection probe place facts are incomplete");
    }
    return SemanticExpressionGraphView(true, built.root_id, facts);
}

func ProbeOptionAssignment(
    name: String,
    expression: String,
    binding_type: String,
    expected_type: String,
    carry_call_targets: Bool,
    carry_c_binding: Bool,
    carry_place_facts: Bool
) -> String {
    let assignments: SemanticAstAssignmentFacts = ProbeAssignmentFacts(
        name, name, 0, "", expression
    );
    let graph: SemanticExpressionGraphView = ProbeExpressionGraph(
        expression, carry_call_targets, "", true
    );
    let target_graph: SemanticExpressionGraphView = ProbeExpressionGraph(
        name, true, name, carry_place_facts
    );
    let base_env: CodegenTypeEnv = CodegenTypeEnvFromRows("|", "");
    let local_rows: String = "|";
    if carry_c_binding {
        let binding: CodegenFunctionValueBindingFact =
            CodegenFunctionValueBindingFactFor(
                name, binding_type, base_env
            );
        local_rows = Concat(local_rows, binding.env_rows);
    }
    let env_state: CodegenTypeEnvState = CodegenTypeEnvStateOwned(local_rows);
    let env: CodegenTypeEnv = CodegenTypeEnvFromRows("|", local_rows);
    return EmitAssign(
        assignments, 0, expected_type, expected_type,
        env_state, env, graph, target_graph
    );
}

func ProbeIndexedAssignment(
    target_type: String,
    carry_place_facts: Bool,
    carry_c_binding: Bool
) -> String {
    let assignments: SemanticAstAssignmentFacts = ProbeAssignmentFacts(
        "nums[1]", "nums", 1, "1", "9"
    );
    let value_graph: SemanticExpressionGraphView = ProbeExpressionGraph(
        "9", true, "", true
    );
    let target_graph: SemanticExpressionGraphView =
        ProbeExpressionGraph(
            "nums[1]", true, "nums", carry_place_facts
        );
    let local_rows: String = "|nums=v:ArrayInt|";
    if carry_c_binding {
        local_rows = Concat(local_rows, "nums=cbind:nums|");
    }
    let env_state: CodegenTypeEnvState = CodegenTypeEnvStateOwned(local_rows);
    let env: CodegenTypeEnv = CodegenTypeEnvFromRows("|", local_rows);
    return EmitAssign(
        assignments, 0, "Int", target_type,
        env_state, env, value_graph, target_graph
    );
}

func ProbeCollectionCrefOnly() -> String {
    let env: CodegenTypeEnv = CodegenTypeEnvFromRows(
        "|", "|xs=v:ArrayInt|xs=type:Array<Int>|xs=cref:pgy_ref_xs|"
    );
    return CodegenCollectionTargetCBindingOrDie(env, "xs");
}

func Main() -> Void {
    let args: Array<String> = Args();
    if ArrayLength(args) > 0 && args[0] == "--missing-expected-type" {
        Log(ProbeOptionAssignment(
            "a", "Some(7)", "Option<Int>", "", true, true, true
        ));
        return;
    }
    if ArrayLength(args) > 0 && args[0] == "--missing-call-target" {
        Log(ProbeOptionAssignment(
            "a", "Some(7)", "Option<Int>", "Option<Int>",
            false, true, true
        ));
        return;
    }
    if ArrayLength(args) > 0 && args[0] == "--missing-c-binding" {
        Log(ProbeOptionAssignment(
            "a", "Some(7)", "Option<Int>", "Option<Int>",
            true, false, true
        ));
        return;
    }
    if ArrayLength(args) > 0 && args[0] == "--missing-place-kind" {
        Log(ProbeIndexedAssignment("Array<Int>", false, true));
        return;
    }
    if ArrayLength(args) > 0 && args[0] == "--missing-leaf-c-binding" {
        Log(ProbeIndexedAssignment("Array<Int>", true, false));
        return;
    }
    if ArrayLength(args) > 0 && args[0] == "--missing-target-type" {
        Log(ProbeIndexedAssignment("", true, true));
        return;
    }
    if ArrayLength(args) > 0 && args[0] == "--collection-cref-only" {
        Log(ProbeCollectionCrefOnly());
        return;
    }
    Log(ProbeOptionAssignment(
        "a", "Some(7)", "Option<Int>", "Option<Int>", true, true, true
    ));
    Log(ProbeOptionAssignment(
        "a", "None()", "Option<Int>", "Option<Int>", true, true, true
    ));
    Log(ProbeOptionAssignment(
        "s", "Some(\"ok\")", "Option<String>", "Option<String>",
        true, true, true
    ));
    Log(ProbeOptionAssignment(
        "s", "None", "Option<String>", "Option<String>",
        true, true, true
    ));
    Log(ProbeIndexedAssignment("Array<Int>", true, true));
}
