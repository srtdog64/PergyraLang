// src/self_hosted/tools/backend_output_comparator/main.pgy
//
// Status: rung-2 minimal (2026-05-27). Reads expected.txt and actual.txt
// from fixture/ relative to cwd, compares line-by-line, emits the schema
// `pgy.selfhost.backend-output-comparator.v1`, exits 1 on any mismatch.
//
// Cwd contract: the parity harness cd's into the repo root (or a tmp clone)
// before running.
//
// Pattern: parallel-array iteration over two Split results. First Pergyra
// origin tool that reads paired text inputs and emits a structured diff
// verdict. Cap on `findings[]` is 8 entries so the JSON stays bounded.
//
// Contract: see intent.md in the same directory.

import "../../lib/json.pgy";
import "../../lib/json_emit.pgy";
import "../../compiler/artifact_zone_owner.pgy";
import "../../compiler/test_harness_owner.pgy";
import "../../compiler/subprocess_runner_owner.pgy";

func AppendMismatchFinding(
    inout findings: Array<String>,
    kind: String,
    line_index: Int,
    location: String
) -> Void {
    let fields: Array<String> = [
        JsonEmitFieldString("kind", kind),
        JsonEmitFieldNumber("line", ToString(line_index)),
        JsonEmitFieldString("location", location)
    ];
    ArrayPush(findings, JsonEmitObject(fields));
}

func ComparatorSourceFields(
    expected_path: String,
    actual_path: String,
    expected_projection: String,
    actual_projection: String
) -> Array<String> {
    if !CompilerArtifactKindKnown("run_output") ||
        !CompilerTestHarnessReady() ||
        !CompilerSubprocessRunnerReady() {
        Log("BACKEND COMPARATOR OWNER ERROR artifact/test-harness/subprocess rows not ready");
        Exit(1);
    }
    let fields: Array<String> = [
        JsonEmitFieldString("expected_owner", expected_path),
        JsonEmitFieldString("actual_owner", actual_path),
        JsonEmitFieldString("artifact_kind", CompilerArtifactKindAt(6)),
        JsonEmitFieldString("expected_projection", expected_projection),
        JsonEmitFieldString("actual_projection", actual_projection),
        JsonEmitFieldString("subprocess_schema", CompilerSubprocessSchema()),
        JsonEmitFieldString("subprocess_use_case", CompilerSubprocessUseCaseAt(0)),
        JsonEmitFieldString("subprocess_timeout_ms", CompilerSubprocessOracleCompareTimeoutMs()),
        JsonEmitFieldString("subprocess_env_allowlist", CompilerSubprocessOracleCompareEnvAllowlist()),
        JsonEmitFieldString("subprocess_stream_fact", CompilerSubprocessFactAt(5)),
        JsonEmitFieldString("subprocess_exit_fact", CompilerSubprocessFactAt(6))
    ];
    return fields;
}

func InputErrorJson(
    path: String,
    expected_path: String,
    actual_path: String,
    expected_projection: String,
    actual_projection: String
) -> String {
    let source_fields: Array<String> = ComparatorSourceFields(
        expected_path,
        actual_path,
        expected_projection,
        actual_projection);
    let counts_fields: Array<String> = [
        JsonEmitFieldNumber("expected_lines", "0"),
        JsonEmitFieldNumber("actual_lines", "0"),
        JsonEmitFieldNumber("mismatch_lines", "0"),
        JsonEmitFieldNumber("extra_actual_lines", "0"),
        JsonEmitFieldNumber("missing_actual_lines", "0")
    ];
    let findings: Array<String> = [];
    AppendMismatchFinding(findings, "input_error", 0, path);
    let report_fields: Array<String> = [
        JsonEmitFieldString("schema", "pgy.selfhost.backend-output-comparator.v1"),
        JsonEmitFieldBool("ok", false),
        JsonEmitFieldRaw("source", JsonEmitObject(source_fields)),
        JsonEmitFieldRaw("counts", JsonEmitObject(counts_fields)),
        JsonEmitFieldRaw("findings", JsonEmitArray(findings))
    ];
    return JsonEmitObject(report_fields);
}

func Main() -> Void {
    let args: Array<String> = Args();
    let expected_path: String = CompilerHarnessComparableArtifactPathAt(0);
    let actual_path: String = CompilerHarnessComparableArtifactPathAt(1);
    let expected_projection: String = CompilerHarnessProjectionOrExit(0);
    let actual_projection: String = CompilerHarnessProjectionOrExit(1);
    if ArrayLength(args) > 0 {
        expected_path = args[0];
    }
    if ArrayLength(args) > 1 {
        actual_path = args[1];
    }
    if ArrayLength(args) > 2 {
        expected_projection = CompilerHarnessProjectionOrExit(ToInt(args[2]));
    }
    if ArrayLength(args) > 3 {
        actual_projection = CompilerHarnessProjectionOrExit(ToInt(args[3]));
    }

    if !FileExists(expected_path) {
        Log(InputErrorJson(expected_path, expected_path, actual_path, expected_projection, actual_projection));
        Exit(1);
    }
    if !FileExists(actual_path) {
        Log(InputErrorJson(actual_path, expected_path, actual_path, expected_projection, actual_projection));
        Exit(1);
    }

    let expected: String = ReadFile(expected_path);
    let actual: String = ReadFile(actual_path);

    let exp_lines: Array<String> = Split(expected, "\n");
    let act_lines: Array<String> = Split(actual, "\n");
    let exp_n: Int = ArrayLength(exp_lines);
    let act_n: Int = ArrayLength(act_lines);

    let common: Int = exp_n;
    if act_n < common {
        common = act_n;
    }

    let max_n: Int = exp_n;
    if act_n > max_n {
        max_n = act_n;
    }

    let mismatch_count: Int = 0;
    let extra_actual: Int = 0;
    let missing_actual: Int = 0;
    let findings: Array<String> = [];
    let findings_cap: Int = CompilerHarnessFindingCap();

    let i: Int = 0;
    while i < max_n {
        let in_expected: Bool = i < exp_n;
        let in_actual: Bool = i < act_n;
        if in_expected && in_actual {
            let e: String = exp_lines[i];
            let a: String = act_lines[i];
            if e != a {
                mismatch_count = mismatch_count + 1;
                if ArrayLength(findings) < findings_cap {
                    AppendMismatchFinding(findings, "mismatch", i, actual_path);
                }
            }
        } else {
            if in_actual {
                extra_actual = extra_actual + 1;
                if ArrayLength(findings) < findings_cap {
                    AppendMismatchFinding(findings, "extra", i, actual_path);
                }
            } else {
                missing_actual = missing_actual + 1;
                if ArrayLength(findings) < findings_cap {
                    AppendMismatchFinding(findings, "missing", i, expected_path);
                }
            }
        }
        i = i + 1;
    }

    let ok: Bool = (mismatch_count == 0) && (extra_actual == 0) && (missing_actual == 0);
    let source_fields: Array<String> = ComparatorSourceFields(
        expected_path,
        actual_path,
        expected_projection,
        actual_projection);
    let counts_fields: Array<String> = [
        JsonEmitFieldNumber("expected_lines", ToString(exp_n)),
        JsonEmitFieldNumber("actual_lines", ToString(act_n)),
        JsonEmitFieldNumber("mismatch_lines", ToString(mismatch_count)),
        JsonEmitFieldNumber("extra_actual_lines", ToString(extra_actual)),
        JsonEmitFieldNumber("missing_actual_lines", ToString(missing_actual))
    ];
    let report_fields: Array<String> = [
        JsonEmitFieldString("schema", "pgy.selfhost.backend-output-comparator.v1"),
        JsonEmitFieldBool("ok", ok),
        JsonEmitFieldRaw("source", JsonEmitObject(source_fields)),
        JsonEmitFieldRaw("counts", JsonEmitObject(counts_fields)),
        JsonEmitFieldRaw("findings", JsonEmitArray(findings))
    ];
    Log(JsonEmitObject(report_fields));

    if !ok {
        Exit(1);
    }
}
