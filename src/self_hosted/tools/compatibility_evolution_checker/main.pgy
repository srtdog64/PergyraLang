// Self-host compatibility-evolution corpus consumer.
//
// Consumes the PgyCompilerWorld compatibility owner and emits a stable report
// proving that the seed corpus covers every compatibility surface.

import "../../compiler/compatibility_evolution_owner.pgy";
import "../../lib/json_emit.pgy";

func CompatibilityChangeRowHasSurface(row: String, surface: String) -> Bool {
    let needle_parts: Array<String> = ["change|", surface, "|"];
    let needle: String = StringJoin(needle_parts, "");
    return StringContains(row, needle);
}

func CountCompatibilityChangeSurface(surface: String) -> Int {
    let count: Int = 0;
    let i: Int = 0;
    while i < CompilerCompatibilityChangeCount() {
        if CompatibilityChangeRowHasSurface(CompilerCompatibilityChangeRowAt(i), surface) {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

func CountCompatibilityRowsWithCodefixStatus() -> Int {
    let count: Int = 0;
    let i: Int = 0;
    while i < CompilerCompatibilityChangeCount() {
        if CompatibilityChangeRowHasCodefixStatus(CompilerCompatibilityChangeRowAt(i)) {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

func CompatibilityChangeRowFieldCount(row: String) -> Int {
    let count: Int = 1;
    let i: Int = 0;
    while i < StringLength(row) {
        if Substring(row, i, 1) == "|" {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

func CompatibilityChangeRowHasShape(row: String) -> Bool {
    return StringIndexOf(row, "change|") == 0 &&
        CompatibilityChangeRowFieldCount(row) == 11;
}

func CompatibilityChangeRowFieldAt(row: String, index: Int) -> String {
    let parts: Array<String> = Split(row, "|");
    if index >= 0 && index < ArrayLength(parts) {
        return parts[index];
    }
    return "";
}

func CompatibilityChangeRowHasDiagnosticId(row: String) -> Bool {
    return StringIndexOf(CompatibilityChangeRowFieldAt(row, 7), "PGYCOMPAT") == 0;
}

func CompatibilityChangeRowHasVersionLadder(row: String) -> Bool {
    return CompatibilityChangeRowFieldAt(row, 4) == "0.8" &&
        CompatibilityChangeRowFieldAt(row, 5) == "0.9" &&
        CompatibilityChangeRowFieldAt(row, 6) == "1.0";
}

func CompatibilityChangeRowHasMigrationUrl(row: String) -> Bool {
    return StringIndexOf(CompatibilityChangeRowFieldAt(row, 9), "docs/compat/") == 0;
}

func CompatibilityChangeRowHasCodefixStatus(row: String) -> Bool {
    let status: String = CompatibilityChangeRowFieldAt(row, 10);
    return status == CompilerCompatibilityCodefixAvailableStatus() ||
        status == CompilerCompatibilityManualMigrationStatus() ||
        status == CompilerCompatibilityNoCodefixStatus();
}

func CompatibilityChangeRowIsObsolete(row: String) -> Bool {
    return CompatibilityChangeRowFieldAt(row, 3) == "obsolete";
}

func CompatibilityChangeRowHasMigrationEnvelope(row: String) -> Bool {
    return CompatibilityChangeRowHasShape(row) &&
        CompatibilityChangeRowHasDiagnosticId(row) &&
        CompatibilityChangeRowHasVersionLadder(row) &&
        StringLength(CompatibilityChangeRowFieldAt(row, 8)) > 0 &&
        CompatibilityChangeRowHasMigrationUrl(row) &&
        CompatibilityChangeRowHasCodefixStatus(row);
}

func CountCompatibilityRowsWithShape() -> Int {
    let count: Int = 0;
    let i: Int = 0;
    while i < CompilerCompatibilityChangeCount() {
        if CompatibilityChangeRowHasShape(CompilerCompatibilityChangeRowAt(i)) {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

func CountCompatibilityRowsWithDiagnosticId() -> Int {
    let count: Int = 0;
    let i: Int = 0;
    while i < CompilerCompatibilityChangeCount() {
        if CompatibilityChangeRowHasDiagnosticId(CompilerCompatibilityChangeRowAt(i)) {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

func CountCompatibilityRowsWithVersionLadder() -> Int {
    let count: Int = 0;
    let i: Int = 0;
    while i < CompilerCompatibilityChangeCount() {
        if CompatibilityChangeRowHasVersionLadder(CompilerCompatibilityChangeRowAt(i)) {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

func CountCompatibilityRowsWithMigrationUrl() -> Int {
    let count: Int = 0;
    let i: Int = 0;
    while i < CompilerCompatibilityChangeCount() {
        if CompatibilityChangeRowHasMigrationUrl(CompilerCompatibilityChangeRowAt(i)) {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

func CountCompatibilityObsoleteRows() -> Int {
    let count: Int = 0;
    let i: Int = 0;
    while i < CompilerCompatibilityChangeCount() {
        if CompatibilityChangeRowIsObsolete(CompilerCompatibilityChangeRowAt(i)) {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

func CountCompatibilityObsoleteRowsWithMigrationEnvelope() -> Int {
    let count: Int = 0;
    let i: Int = 0;
    while i < CompilerCompatibilityChangeCount() {
        let row: String = CompilerCompatibilityChangeRowAt(i);
        if CompatibilityChangeRowIsObsolete(row) &&
            CompatibilityChangeRowHasMigrationEnvelope(row) {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

func CompatibilityMalformedRowSelfTestMode() -> String {
    return "--self-test-malformed-row";
}

func CompatibilityInvalidCodefixSelfTestMode() -> String {
    return "--self-test-invalid-codefix-status";
}

func CompatibilityMalformedRowSelfTestReport(row_shape_count: Int) -> String {
    let missing: Int = 0;
    let findings: Array<String> = [];
    if row_shape_count < 1 {
        missing = 1;
        ArrayPush(findings, JsonEmitObject([JsonEmitFieldString("kind", "malformed_change_row")]));
    }
    let counts: String = JsonEmitObject([
        JsonEmitFieldNumber("changes", "1"),
        JsonEmitFieldNumber("row_shape", ToString(row_shape_count)),
        JsonEmitFieldNumber("missing", ToString(missing))
    ]);
    return JsonEmitObject([
        JsonEmitFieldString("schema", "pgy.selfhost.compatibility-corpus-negative.v1"),
        JsonEmitFieldBool("ok", missing == 0),
        JsonEmitFieldRaw("counts", counts),
        JsonEmitFieldRaw("findings", JsonEmitArray(findings))
    ]);
}

func CompatibilityInvalidCodefixSelfTestReport(codefix_status_count: Int, row_shape_count: Int) -> String {
    let missing: Int = 0;
    let findings: Array<String> = [];
    if codefix_status_count < 1 {
        missing = 1;
        ArrayPush(findings, JsonEmitObject([JsonEmitFieldString("kind", "missing_codefix_status")]));
    }
    let counts: String = JsonEmitObject([
        JsonEmitFieldNumber("changes", "1"),
        JsonEmitFieldNumber("row_shape", ToString(row_shape_count)),
        JsonEmitFieldNumber("codefix_status", ToString(codefix_status_count)),
        JsonEmitFieldNumber("missing", ToString(missing))
    ]);
    return JsonEmitObject([
        JsonEmitFieldString("schema", "pgy.selfhost.compatibility-corpus-negative.v1"),
        JsonEmitFieldBool("ok", missing == 0),
        JsonEmitFieldRaw("counts", counts),
        JsonEmitFieldRaw("findings", JsonEmitArray(findings))
    ]);
}

func RunCompatibilityMalformedRowSelfTest() -> Void {
    let row_shape_count: Int = 0;
    if CompatibilityChangeRowHasShape("change|source|too_short") {
        row_shape_count = 1;
    }
    Log(CompatibilityMalformedRowSelfTestReport(row_shape_count));
    if row_shape_count < 1 {
        Exit(1);
    }
}

func RunCompatibilityInvalidCodefixSelfTest() -> Void {
    let row: String = "change|source|PrintLine|obsolete|0.8|0.9|1.0|PGYCOMPAT001|Print|docs/compat/PrintLine|unknown_codefix";
    let row_shape_count: Int = 0;
    let codefix_status_count: Int = 0;
    if CompatibilityChangeRowHasShape(row) {
        row_shape_count = 1;
    }
    if CompatibilityChangeRowHasCodefixStatus(row) {
        codefix_status_count = 1;
    }
    Log(CompatibilityInvalidCodefixSelfTestReport(codefix_status_count, row_shape_count));
    if codefix_status_count < 1 {
        Exit(1);
    }
}

func CompatibilityCorpusFindings(
    source_count: Int,
    abi_count: Int,
    behavior_count: Int,
    diagnostic_count: Int,
    air_count: Int,
    mir_count: Int,
    runtime_trace_count: Int,
    capability_count: Int,
    stdlib_count: Int,
    diagnostic_id_count: Int,
    version_ladder_count: Int,
    migration_url_count: Int,
    codefix_status_count: Int,
    row_shape_count: Int,
    obsolete_count: Int,
    obsolete_migration_count: Int
) -> String {
    let findings: Array<String> = [];
    if source_count == 0 {
        ArrayPush(findings, JsonEmitObject([JsonEmitFieldString("kind", "missing_source_change")]));
    }
    if abi_count == 0 {
        ArrayPush(findings, JsonEmitObject([JsonEmitFieldString("kind", "missing_abi_change")]));
    }
    if behavior_count == 0 {
        ArrayPush(findings, JsonEmitObject([JsonEmitFieldString("kind", "missing_behavior_change")]));
    }
    if diagnostic_count == 0 {
        ArrayPush(findings, JsonEmitObject([JsonEmitFieldString("kind", "missing_diagnostic_change")]));
    }
    if air_count == 0 {
        ArrayPush(findings, JsonEmitObject([JsonEmitFieldString("kind", "missing_air_evidence_change")]));
    }
    if mir_count == 0 {
        ArrayPush(findings, JsonEmitObject([JsonEmitFieldString("kind", "missing_mir_json_change")]));
    }
    if runtime_trace_count == 0 {
        ArrayPush(findings, JsonEmitObject([JsonEmitFieldString("kind", "missing_runtime_trace_change")]));
    }
    if capability_count == 0 {
        ArrayPush(findings, JsonEmitObject([JsonEmitFieldString("kind", "missing_capability_profile_change")]));
    }
    if stdlib_count == 0 {
        ArrayPush(findings, JsonEmitObject([JsonEmitFieldString("kind", "missing_stdlib_module_change")]));
    }
    if diagnostic_id_count < CompilerCompatibilityChangeCount() {
        ArrayPush(findings, JsonEmitObject([JsonEmitFieldString("kind", "missing_diagnostic_id")]));
    }
    if version_ladder_count < CompilerCompatibilityChangeCount() {
        ArrayPush(findings, JsonEmitObject([JsonEmitFieldString("kind", "missing_version_ladder")]));
    }
    if migration_url_count < CompilerCompatibilityChangeCount() {
        ArrayPush(findings, JsonEmitObject([JsonEmitFieldString("kind", "missing_migration_url")]));
    }
    if codefix_status_count < CompilerCompatibilityChangeCount() {
        ArrayPush(findings, JsonEmitObject([JsonEmitFieldString("kind", "missing_codefix_status")]));
    }
    if row_shape_count < CompilerCompatibilityChangeCount() {
        ArrayPush(findings, JsonEmitObject([JsonEmitFieldString("kind", "malformed_change_row")]));
    }
    if obsolete_count == 0 {
        ArrayPush(findings, JsonEmitObject([JsonEmitFieldString("kind", "missing_obsolete_change")]));
    }
    if obsolete_migration_count < obsolete_count {
        ArrayPush(findings, JsonEmitObject([JsonEmitFieldString("kind", "missing_obsolete_migration_envelope")]));
    }
    return JsonEmitArray(findings);
}

func Main() -> Void {
    let args: Array<String> = Args();
    if ArrayLength(args) > 0 && args[0] == CompatibilityMalformedRowSelfTestMode() {
        RunCompatibilityMalformedRowSelfTest();
        return;
    }
    if ArrayLength(args) > 0 && args[0] == CompatibilityInvalidCodefixSelfTestMode() {
        RunCompatibilityInvalidCodefixSelfTest();
        return;
    }

    let source_count: Int = CountCompatibilityChangeSurface(CompilerSourceCompatibilitySurface());
    let abi_count: Int = CountCompatibilityChangeSurface(CompilerAbiBinaryCompatibilitySurface());
    let behavior_count: Int = CountCompatibilityChangeSurface(CompilerBehaviorCompatibilitySurface());
    let diagnostic_count: Int = CountCompatibilityChangeSurface(CompilerDiagnosticCompatibilitySurface());
    let air_count: Int = CountCompatibilityChangeSurface(CompilerAirEvidenceCompatibilitySurface());
    let mir_count: Int = CountCompatibilityChangeSurface(CompilerMirJsonCompatibilitySurface());
    let runtime_trace_count: Int = CountCompatibilityChangeSurface(CompilerRuntimeTraceCompatibilitySurface());
    let capability_count: Int = CountCompatibilityChangeSurface(CompilerCapabilityProfileCompatibilitySurface());
    let stdlib_count: Int = CountCompatibilityChangeSurface(CompilerStdlibModuleCompatibilitySurface());
    let diagnostic_id_count: Int = CountCompatibilityRowsWithDiagnosticId();
    let version_ladder_count: Int = CountCompatibilityRowsWithVersionLadder();
    let migration_url_count: Int = CountCompatibilityRowsWithMigrationUrl();
    let codefix_status_count: Int = CountCompatibilityRowsWithCodefixStatus();
    let row_shape_count: Int = CountCompatibilityRowsWithShape();
    let obsolete_count: Int = CountCompatibilityObsoleteRows();
    let obsolete_migration_count: Int = CountCompatibilityObsoleteRowsWithMigrationEnvelope();
    let missing: Int = 0;
    if source_count == 0 { missing = missing + 1; }
    if abi_count == 0 { missing = missing + 1; }
    if behavior_count == 0 { missing = missing + 1; }
    if diagnostic_count == 0 { missing = missing + 1; }
    if air_count == 0 { missing = missing + 1; }
    if mir_count == 0 { missing = missing + 1; }
    if runtime_trace_count == 0 { missing = missing + 1; }
    if capability_count == 0 { missing = missing + 1; }
    if stdlib_count == 0 { missing = missing + 1; }
    if diagnostic_id_count < CompilerCompatibilityChangeCount() { missing = missing + 1; }
    if version_ladder_count < CompilerCompatibilityChangeCount() { missing = missing + 1; }
    if migration_url_count < CompilerCompatibilityChangeCount() { missing = missing + 1; }
    if codefix_status_count < CompilerCompatibilityChangeCount() { missing = missing + 1; }
    if row_shape_count < CompilerCompatibilityChangeCount() { missing = missing + 1; }
    if obsolete_count == 0 { missing = missing + 1; }
    if obsolete_migration_count < obsolete_count { missing = missing + 1; }
    let counts: String = JsonEmitObject([
        JsonEmitFieldNumber("changes", ToString(CompilerCompatibilityChangeCount())),
        JsonEmitFieldNumber("source", ToString(source_count)),
        JsonEmitFieldNumber("abi_binary", ToString(abi_count)),
        JsonEmitFieldNumber("behavior", ToString(behavior_count)),
        JsonEmitFieldNumber("diagnostic", ToString(diagnostic_count)),
        JsonEmitFieldNumber("air_evidence", ToString(air_count)),
        JsonEmitFieldNumber("mir_json", ToString(mir_count)),
        JsonEmitFieldNumber("runtime_trace", ToString(runtime_trace_count)),
        JsonEmitFieldNumber("capability_profile", ToString(capability_count)),
        JsonEmitFieldNumber("stdlib_module", ToString(stdlib_count)),
        JsonEmitFieldNumber("diagnostic_id", ToString(diagnostic_id_count)),
        JsonEmitFieldNumber("version_ladder", ToString(version_ladder_count)),
        JsonEmitFieldNumber("migration_url", ToString(migration_url_count)),
        JsonEmitFieldNumber("codefix_status", ToString(codefix_status_count)),
        JsonEmitFieldNumber("row_shape", ToString(row_shape_count)),
        JsonEmitFieldNumber("obsolete", ToString(obsolete_count)),
        JsonEmitFieldNumber("obsolete_migration", ToString(obsolete_migration_count)),
        JsonEmitFieldNumber("missing", ToString(missing))
    ]);
    let report: String = JsonEmitObject([
        JsonEmitFieldString("schema", "pgy.selfhost.compatibility-corpus.v1"),
        JsonEmitFieldBool("ok", missing == 0),
        JsonEmitFieldRaw("counts", counts),
        JsonEmitFieldRaw("findings", CompatibilityCorpusFindings(
            source_count,
            abi_count,
            behavior_count,
            diagnostic_count,
            air_count,
            mir_count,
            runtime_trace_count,
            capability_count,
            stdlib_count,
            diagnostic_id_count,
            version_ladder_count,
            migration_url_count,
            codefix_status_count,
            row_shape_count,
            obsolete_count,
            obsolete_migration_count
        ))
    ]);
    Log(report);
    if missing > 0 {
        Exit(1);
    }
}
