// Compatibility evolution checker report owner.
//
// Owns the JSON report, count row, and finding shapes. The checker entrypoint
// owns row analysis over CompatibilityEvolutionZone facts.

import "../../compiler/compatibility_evolution_owner.pgy";
import "../../lib/json_emit.pgy";

func CompatibilityFindingJson(kind: String) -> String {
    return JsonEmitObject([JsonEmitFieldString("kind", kind)]);
}

func CompatibilityMalformedRowSelfTestReport(row_shape_count: Int) -> String {
    let missing: Int = 0;
    let findings: Array<String> = [];
    if row_shape_count < 1 {
        missing = 1;
        ArrayPush(findings, CompatibilityFindingJson(CompilerCompatibilityMalformedChangeRowFinding()));
    }
    let counts: String = JsonEmitObject([
        JsonEmitFieldNumber(CompilerCompatibilityCorpusChangesCountField(), ToString(1)),
        JsonEmitFieldNumber(CompilerCompatibilityCorpusRowShapeCountField(), ToString(row_shape_count)),
        JsonEmitFieldNumber(CompilerCompatibilityCorpusMissingCountField(), ToString(missing))
    ]);
    return JsonEmitObject([
        JsonEmitFieldString("schema", CompilerCompatibilityCorpusNegativeSchema()),
        JsonEmitFieldBool("ok", missing == 0),
        JsonEmitFieldRaw("counts", counts),
        JsonEmitFieldRaw("findings", JsonEmitArray(findings))
    ]);
}

