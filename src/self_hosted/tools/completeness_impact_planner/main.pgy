// src/self_hosted/tools/completeness_impact_planner/main.pgy
//
// Consumes the completeness impact rows and classifies changed paths into the
// proof gates that should run. It does not inspect git state; callers pass the
// changed paths explicitly so the impact decision remains deterministic.

import "../../compiler/completeness_ledger_owner.pgy";
import "../../lib/json_emit.pgy";

func ImpactPlannerStartsWith(path: String, prefix: String) -> Bool {
    let path_len: Int = StringLength(path);
    let prefix_len: Int = StringLength(prefix);
    if path_len < prefix_len {
        return false;
    }
    return Substring(path, 0, prefix_len) == prefix;
}

func ImpactPlannerEndsWith(path: String, suffix: String) -> Bool {
    let path_len: Int = StringLength(path);
    let suffix_len: Int = StringLength(suffix);
    if path_len < suffix_len {
        return false;
    }
    return Substring(path, path_len - suffix_len, suffix_len) == suffix;
}

func ImpactPlannerPrefixPatternMatches(path: String, prefix_pattern: String) -> Bool {
    if ImpactPlannerEndsWith(prefix_pattern, "*") {
        let prefix_len: Int = StringLength(prefix_pattern) - 1;
        let prefix: String = Substring(prefix_pattern, 0, prefix_len);
        return ImpactPlannerStartsWith(path, prefix);
    }
    return ImpactPlannerStartsWith(path, Concat(prefix_pattern, "/"));
}

func ImpactPlannerPatternMatches(pattern: String, path: String) -> Bool {
    let recursive_pgy_suffix: String = "/**/*.pgy";
    if ImpactPlannerEndsWith(pattern, recursive_pgy_suffix) {
        let prefix_len: Int = StringLength(pattern) - StringLength(recursive_pgy_suffix);
        let prefix_pattern: String = Substring(pattern, 0, prefix_len);
        return ImpactPlannerPrefixPatternMatches(path, prefix_pattern) &&
            ImpactPlannerEndsWith(path, ".pgy");
    }
    return path == pattern;
}

func ImpactPlannerRowField(row: String, index: Int) -> Option<String> {
    let parts: Array<String> = Split(row, "\t");
    if index < 0 || index >= ArrayLength(parts) {
        return None;
    }
    return Some(parts[index]);
}

func ImpactPlannerArrayContains(values: Array<String>, value: String) -> Bool {
    let i: Int = 0;
    while i < ArrayLength(values) {
        if values[i] == value {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func ImpactPlannerFinding(path: String) -> String {
    let fields: Array<String> = [
        JsonEmitFieldString("kind", "unmatched_path"),
        JsonEmitFieldString("path", path),
        JsonEmitFieldString("location", path)
    ];
    return JsonEmitObject(fields);
}

func ImpactPlannerImpactItem(
    impact_id: String,
    pattern: String,
    matched_path: String,
    source_env: String,
    stage_env: String,
    stage_value: String,
    gate: String
) -> String {
    let fields: Array<String> = [
        JsonEmitFieldString("impact_id", impact_id),
        JsonEmitFieldString("source_pattern", pattern),
        JsonEmitFieldString("matched_path", matched_path),
        JsonEmitFieldString("source_filter_env", source_env),
        JsonEmitFieldString("source_filter_value", matched_path),
        JsonEmitFieldString("stage_filter_env", stage_env),
        JsonEmitFieldString("stage_filter_value", stage_value),
        JsonEmitFieldString("proof_gate", gate)
    ];
    return JsonEmitObject(fields);
}

func ImpactPlannerJson(paths: Array<String>) -> String {
    let matched_impacts: Array<String> = [];
    let impact_items: Array<String> = [];
    let proof_gates: Array<String> = [];
    let findings: Array<String> = [];
    let unmatched: Int = 0;
    let path_i: Int = 0;
    while path_i < ArrayLength(paths) {
        let path: String = paths[path_i];
        let path_matched: Bool = false;
        let row_i: Int = 0;
        while row_i < CompilerCompletenessImpactRowCount() {
            let row: String = CompilerCompletenessImpactRowAt(row_i);
            let impact_id_opt: Option<String> = ImpactPlannerRowField(row, 0);
            let pattern_opt: Option<String> = ImpactPlannerRowField(row, 1);
            let source_env_opt: Option<String> = ImpactPlannerRowField(row, 2);
            let stage_env_opt: Option<String> = ImpactPlannerRowField(row, 3);
            let stage_value_opt: Option<String> = ImpactPlannerRowField(row, 4);
            let gate_opt: Option<String> = ImpactPlannerRowField(row, 5);
            if IsSome(impact_id_opt) && IsSome(pattern_opt) && IsSome(source_env_opt) &&
                IsSome(stage_env_opt) && IsSome(stage_value_opt) && IsSome(gate_opt) {
                let impact_id: String = UnwrapOption(impact_id_opt);
                let pattern: String = UnwrapOption(pattern_opt);
                if ImpactPlannerPatternMatches(pattern, path) {
                    let source_env: String = UnwrapOption(source_env_opt);
                    let stage_env: String = UnwrapOption(stage_env_opt);
                    let stage_value: String = UnwrapOption(stage_value_opt);
                    let gate: String = UnwrapOption(gate_opt);
                    path_matched = true;
                    if !ImpactPlannerArrayContains(matched_impacts, impact_id) {
                        ArrayPush(matched_impacts, impact_id);
                    }
                    ArrayPush(
                        impact_items,
                        ImpactPlannerImpactItem(
                            impact_id,
                            pattern,
                            path,
                            source_env,
                            stage_env,
                            stage_value,
                            gate
                        )
                    );
                    if !ImpactPlannerArrayContains(proof_gates, gate) {
                        ArrayPush(proof_gates, gate);
                    }
                }
            }
            row_i = row_i + 1;
        }
        if !path_matched {
            unmatched = unmatched + 1;
            if ArrayLength(findings) < 8 {
                ArrayPush(findings, ImpactPlannerFinding(path));
            }
        }
        path_i = path_i + 1;
    }

    let gate_items: Array<String> = [];
    let gate_i: Int = 0;
    while gate_i < ArrayLength(proof_gates) {
        ArrayPush(gate_items, JsonStringLiteral(proof_gates[gate_i]));
        gate_i = gate_i + 1;
    }
    let counts_fields: Array<String> = [
        JsonEmitFieldNumber("changed_paths", ToString(ArrayLength(paths))),
        JsonEmitFieldNumber("matched_impacts", ToString(ArrayLength(matched_impacts))),
        JsonEmitFieldNumber("impact_matches", ToString(ArrayLength(impact_items))),
        JsonEmitFieldNumber("proof_gates", ToString(ArrayLength(proof_gates))),
        JsonEmitFieldNumber("unmatched", ToString(unmatched))
    ];
    let report_fields: Array<String> = [
        JsonEmitFieldString("schema", "pgy.selfhost.completeness-impact-planner.v1"),
        JsonEmitFieldBool("ok", unmatched == 0),
        JsonEmitFieldString("impact_schema", CompilerCompletenessImpactPlanSchema()),
        JsonEmitFieldRaw("counts", JsonEmitObject(counts_fields)),
        JsonEmitFieldRaw("proof_gates", JsonEmitArray(gate_items)),
        JsonEmitFieldRaw("impacts", JsonEmitArray(impact_items)),
        JsonEmitFieldRaw("findings", JsonEmitArray(findings))
    ];
    return JsonEmitObject(report_fields);
}

func Main() -> Void {
    let paths: Array<String> = Args();
    let report: String = ImpactPlannerJson(paths);
    Log(report);
    if StringContains(report, "\"ok\":false") {
        Exit(1);
    }
}
