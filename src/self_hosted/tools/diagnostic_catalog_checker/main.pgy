// Entrypoint only. The diagnostic catalog SoT lives in scan/report/run owners:
// scan_owner owns stable fact extraction, report_owner owns the JSON schema,
// and run_owner owns input boundaries plus exit policy.

import "scan_owner.pgy";
import "report_owner.pgy";
import "run_owner.pgy";

func Main() -> Void {
    RunDiagnosticCatalogCheck();
}
