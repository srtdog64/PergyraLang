// src/self_hosted/tools/diagnostic_catalog_checker/report_owner.pgy
//
// JSON schema owner for pgy.selfhost.diagnostic-catalog.v1. Source scanning
// lives in scan_owner; this owner renders pre-extracted finding facts only.

import "../../lib/json.pgy";
import "../../lib/json_emit.pgy";

func FindingJson(kind: String, code: String, location: String) -> String {
    let parts: Array<String> = [
        "{\"kind\":",
        JsonStringLiteral(kind),
        ",\"code\":",
        JsonStringLiteral(code),
        ",\"location\":",
        JsonStringLiteral(location),
        "}"
    ];
    return StringJoin(parts, "");
}

func AppendFinding(findings: String, entry: String) -> String {
    if StringLength(findings) == 0 {
        return entry;
    }
    return Concat(Concat(findings, ","), entry);
}

func FindingFactField(row: String, index: Int) -> String {
    let parts: Array<String> = Split(row, "|");
    if ArrayLength(parts) <= index {
        return "";
    }
    return parts[index];
}

func FindingsJsonFromFacts(facts: String) -> String {
    let rows: Array<String> = Split(facts, "\n");
    let findings: String = "";
    for row in rows {
        if StringLength(row) > 0 {
            let kind: String = FindingFactField(row, 0);
            let code: String = FindingFactField(row, 1);
            let location: String = FindingFactField(row, 2);
            let entry: String = FindingJson(kind, code, location);
            findings = AppendFinding(findings, entry);
        }
    }
    return findings;
}

func DiagnosticCatalogSourceJson(code_owner: String, docs_owner: String) -> String {
    let parts: Array<String> = [
        "\"source\":{\"code_owner\":",
        JsonStringLiteral(code_owner),
        ",\"docs_owner\":",
        JsonStringLiteral(docs_owner),
        "}"
    ];
    return StringJoin(parts, "");
}

func InputErrorJsonForOwners(path: String, code_owner: String, docs_owner: String) -> Option<String> {
    let parts: Array<String> = [
        "{\"schema\":\"pgy.selfhost.diagnostic-catalog.v1\",\"ok\":false,",
        DiagnosticCatalogSourceJson(code_owner, docs_owner),
        ",\"counts\":{\"codes\":0,\"documented\":0,\"missing\":0,\"duplicates\":0,\"orphans\":0},\"findings\":[{\"kind\":\"input_error\",\"code\":",
        JsonStringLiteral(path),
        ",\"location\":",
        JsonStringLiteral(path),
        "}]}"
    ];
    return Some(StringJoin(parts, ""));
}

func InputErrorJson(path: String) -> Option<String> {
    return InputErrorJsonForOwners(path, "src/semantic/diag_codes.h", "docs/72_diagnostic_codes.md");
}

func DiagnosticCatalogJsonForOwners(
    codes: Int,
    documented: Int,
    missing: Int,
    duplicates: Int,
    orphans: Int,
    findings: String,
    code_owner: String,
    docs_owner: String
) -> String {
    let ok_text: String = "true";
    if missing > 0 || duplicates > 0 || orphans > 0 {
        ok_text = "false";
    }
    let prefix: String = "{\"schema\":\"pgy.selfhost.diagnostic-catalog.v1\",\"ok\":";
    let source_prefix: String = Concat(Concat(",", DiagnosticCatalogSourceJson(code_owner, docs_owner)), ",\"counts\":{\"codes\":");
    let mid_doc: String = ",\"documented\":";
    let mid_missing: String = ",\"missing\":";
    let mid_dup: String = ",\"duplicates\":";
    let mid_orphan: String = ",\"orphans\":";
    let findings_prefix: String = "},\"findings\":[";
    let suffix: String = "]}";
    let s0: String = Concat(Concat(prefix, ok_text), source_prefix);
    let s1: String = Concat(s0, ToString(codes));
    let s2: String = Concat(Concat(s1, mid_doc), ToString(documented));
    let s3: String = Concat(Concat(s2, mid_missing), ToString(missing));
    let s4: String = Concat(Concat(s3, mid_dup), ToString(duplicates));
    let s5: String = Concat(Concat(s4, mid_orphan), ToString(orphans));
    return Concat(Concat(Concat(s5, findings_prefix), findings), suffix);
}

func DiagnosticCatalogJson(codes: Int, documented: Int, missing: Int, duplicates: Int, orphans: Int, findings: String) -> String {
    return DiagnosticCatalogJsonForOwners(
        codes,
        documented,
        missing,
        duplicates,
        orphans,
        findings,
        "src/semantic/diag_codes.h",
        "docs/72_diagnostic_codes.md"
    );
}
