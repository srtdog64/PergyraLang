// src/self_hosted/tools/doc_link_checker/main.pgy
//
// Status: rung-2 minimal (2026-05-27). Reads docs/INDEX.md relative to cwd,
// extracts every `](path)` target, and verifies each `.md` target exists
// relative to the `docs/` directory.
//
// Cwd contract: the parity harness cd's into the repo root before running.
//
// Path-extraction pattern: this is the first Pergyra origin tool that
// extracts substrings between matched delimiters (`](` then `)`) and acts
// on the captured value. Future tools that parse `#include "..."` or
// `import "..."` statements will reuse this shape.
//
// Contract: see intent.md in the same directory.

import "../../lib/json.pgy";
import "../../lib/json_emit.pgy";

func ExtractLinkPath(line: String) -> String {
    let open: String = "](";
    let close: String = ")";
    let open_idx: Int = StringIndexOf(line, open);
    if open_idx < 0 {
        return "";
    }
    let after: Int = open_idx + StringLength(open);
    let rest_len: Int = StringLength(line) - after;
    if rest_len <= 0 {
        return "";
    }
    let rest: String = Substring(line, after, rest_len);
    let close_idx: Int = StringIndexOf(rest, close);
    if close_idx <= 0 {
        return "";
    }
    return Substring(rest, 0, close_idx);
}

func IsMarkdownTarget(path: String) -> Bool {
    let n: Int = StringLength(path);
    if n < 3 {
        return false;
    }
    let tail: String = Substring(path, n - 3, 3);
    return tail == ".md";
}

func IsExternalUrl(path: String) -> Bool {
    if StringContains(path, "://") {
        return true;
    }
    if StringLength(path) > 0 {
        let head: String = Substring(path, 0, 1);
        if head == "#" {
            return true;
        }
    }
    return false;
}

func MissingLinkFinding(path: String, index_path: String) -> String {
    let fields: Array<String> = [
        JsonEmitFieldString("kind", "missing_link"),
        JsonEmitFieldString("path", Concat("docs/", path)),
        JsonEmitFieldString("location", index_path)
    ];
    return JsonEmitObject(fields);
}

func InputErrorJson(path: String) -> Option<String> {
    let source_fields: Array<String> = [
        JsonEmitFieldString("index_owner", path)
    ];
    let counts_fields: Array<String> = [
        JsonEmitFieldNumber("total_links", "0"),
        JsonEmitFieldNumber("md_links", "0"),
        JsonEmitFieldNumber("missing_links", "0")
    ];
    let finding_fields: Array<String> = [
        JsonEmitFieldString("kind", "input_error"),
        JsonEmitFieldString("path", path),
        JsonEmitFieldString("location", path)
    ];
    let findings: Array<String> = [
        JsonEmitObject(finding_fields)
    ];
    let report_fields: Array<String> = [
        JsonEmitFieldString("schema", "pgy.selfhost.doc-link-checker.v1"),
        JsonEmitFieldBool("ok", false),
        JsonEmitFieldRaw("source", JsonEmitObject(source_fields)),
        JsonEmitFieldRaw("counts", JsonEmitObject(counts_fields)),
        JsonEmitFieldRaw("findings", JsonEmitArray(findings))
    ];
    return Some(JsonEmitObject(report_fields));
}

func Main() -> Void {
    let args: Array<String> = Args();
    let index_path: String = "docs/INDEX.md";
    if ArrayLength(args) > 0 {
        index_path = args[0];
    }
    if !FileExists(index_path) {
        Log(UnwrapOption(InputErrorJson(index_path)));
        Exit(1);
    }

    let content: String = ReadFile(index_path);
    let lines: Array<String> = Split(content, "\n");

    let total_links: Int = 0;
    let md_links: Int = 0;
    let missing_links: Int = 0;
    let findings: Array<String> = [];
    let findings_cap: Int = 8;

    let i: Int = 0;
    let n: Int = ArrayLength(lines);
    while i < n {
        let line: String = lines[i];
        let remaining: String = line;
        while StringContains(remaining, "](") {
            let path: String = ExtractLinkPath(remaining);
            if StringLength(path) == 0 {
                remaining = "";
            } else {
                total_links = total_links + 1;
                if !IsExternalUrl(path) && IsMarkdownTarget(path) {
                    md_links = md_links + 1;
                    let full_path: String = Concat("docs/", path);
                    if !FileExists(full_path) {
                        missing_links = missing_links + 1;
                        if ArrayLength(findings) < findings_cap {
                            ArrayPush(findings, MissingLinkFinding(path, index_path));
                        }
                    }
                }
                let open_idx: Int = StringIndexOf(remaining, "](");
                let advance: Int = open_idx + 2 + StringLength(path) + 1;
                let rest_len: Int = StringLength(remaining) - advance;
                if rest_len <= 0 {
                    remaining = "";
                } else {
                    remaining = Substring(remaining, advance, rest_len);
                }
            }
        }
        i = i + 1;
    }

    let source_fields: Array<String> = [
        JsonEmitFieldString("index_owner", index_path)
    ];
    let counts_fields: Array<String> = [
        JsonEmitFieldNumber("total_links", ToString(total_links)),
        JsonEmitFieldNumber("md_links", ToString(md_links)),
        JsonEmitFieldNumber("missing_links", ToString(missing_links))
    ];
    let report_fields: Array<String> = [
        JsonEmitFieldString("schema", "pgy.selfhost.doc-link-checker.v1"),
        JsonEmitFieldBool("ok", missing_links == 0),
        JsonEmitFieldRaw("source", JsonEmitObject(source_fields)),
        JsonEmitFieldRaw("counts", JsonEmitObject(counts_fields)),
        JsonEmitFieldRaw("findings", JsonEmitArray(findings))
    ];
    Log(JsonEmitObject(report_fields));

    if missing_links > 0 {
        Exit(1);
    }
}
