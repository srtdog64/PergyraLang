// src/self_hosted/tools/examples_inventory_checker/main.pgy
//
// Status: rung-2 DirWalk-owned (2026-06-15). Enumerates top-level
// examples/*.pgy through DirWalk, verifies the expected inventory count and
// non-empty content. Emits the schema, exits 1 on count drift or empty files.
//
// Cwd contract: the parity harness cd's into the repo root before running.
//
// Third consumer of TextScan.CountLines (after tools 8 and 9), which
// triggered the lift from inline duplicates to lib/text_scan.pgy.
//
// Contract: see intent.md in the same directory.

import "../../lib/text_scan.pgy";
import "../../lib/json.pgy";
import "../../lib/json_emit.pgy";

func MissingFinding(kind: String, path: String) -> String {
    let fields: Array<String> = [
        JsonEmitFieldString("kind", kind),
        JsonEmitFieldString("path", path),
        JsonEmitFieldString("location", path)
    ];
    return JsonEmitObject(fields);
}

func EndsWith(text: String, suffix: String) -> Bool {
    let text_len: Int = StringLength(text);
    let suffix_len: Int = StringLength(suffix);
    if text_len < suffix_len {
        return false;
    }
    return Substring(text, text_len - suffix_len, suffix_len) == suffix;
}

func IsTopLevelExample(path: String) -> Bool {
    let prefix: String = "examples/";
    let prefix_len: Int = StringLength(prefix);
    let path_len: Int = StringLength(path);
    if path_len <= prefix_len {
        return false;
    }
    if Substring(path, 0, prefix_len) != prefix {
        return false;
    }
    let rest: String = Substring(path, prefix_len, path_len - prefix_len);
    return StringIndexOf(rest, "/") < 0 && EndsWith(path, ".pgy");
}

func Main() -> Void {
    let dirwalk_owner: String = "examples";
    let expected_examples: Int = 119;
    let entries: Array<String> = DirWalk(dirwalk_owner);

    let examples: Int = 0;
    let missing: Int = 0;
    let empty: Int = 0;
    let max_lines: Int = 0;
    let findings: Array<String> = [];
    let findings_cap: Int = 8;

    let i: Int = 0;
    let n: Int = ArrayLength(entries);
    while i < n {
        let path: String = entries[i];
        if IsTopLevelExample(path) {
            examples = examples + 1;
            let content: String = ReadFile(path);
            let lines: Int = TextScan.CountLines(content);
            if lines > max_lines {
                max_lines = lines;
            }
            if lines == 0 {
                empty = empty + 1;
                if ArrayLength(findings) < findings_cap {
                    ArrayPush(findings, MissingFinding("empty_example", path));
                }
            }
        }
        i = i + 1;
    }
    if examples < expected_examples {
        missing = expected_examples - examples;
    }
    if examples != expected_examples && ArrayLength(findings) < findings_cap {
        ArrayPush(findings, MissingFinding("inventory_count_drift",
            dirwalk_owner));
    }

    let ok: Bool = (examples == expected_examples) && (empty == 0);
    let source_fields: Array<String> = [
        JsonEmitFieldString("dirwalk_owner", dirwalk_owner),
        JsonEmitFieldNumber("expected_examples", ToString(expected_examples))
    ];
    let counts_fields: Array<String> = [
        JsonEmitFieldNumber("examples", ToString(examples)),
        JsonEmitFieldNumber("missing", ToString(missing)),
        JsonEmitFieldNumber("empty", ToString(empty)),
        JsonEmitFieldNumber("max_lines", ToString(max_lines))
    ];
    let report_fields: Array<String> = [
        JsonEmitFieldString("schema", "pgy.selfhost.examples-inventory.v1"),
        JsonEmitFieldBool("ok", ok),
        JsonEmitFieldRaw("source", JsonEmitObject(source_fields)),
        JsonEmitFieldRaw("counts", JsonEmitObject(counts_fields)),
        JsonEmitFieldRaw("findings", JsonEmitArray(findings))
    ];
    Log(JsonEmitObject(report_fields));

    if !ok {
        Exit(1);
    }
}
