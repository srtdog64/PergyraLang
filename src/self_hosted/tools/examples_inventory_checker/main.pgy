// src/self_hosted/tools/examples_inventory_checker/main.pgy
//
// Status: rung-2 minimal (2026-05-27). Reads fixture/examples_manifest.txt,
// iterates each entry, verifies FileExists + content has at least one
// line. Emits the schema, exits 1 on any missing or empty example.
//
// Cwd contract: the parity harness cd's into the repo root before running.
//
// Third consumer of TextScan.CountLines (after tools 8 and 9), which
// triggered the lift from inline duplicates to lib/text_scan.pgy.
//
// Contract: see intent.md in the same directory.

import "../../lib/text_scan.pgy";

func MissingFinding(kind: String, path: String) -> String {
    let parts: Array<String> = [
        "{\"kind\":\"",
        kind,
        "\",\"path\":\"",
        path,
        "\",\"location\":\"",
        path,
        "\"}"
    ];
    return StringJoin(parts, "");
}

func MissingManifestJson(path: String) -> String {
    let parts: Array<String> = [
        "{\"schema\":\"pgy.selfhost.examples-inventory.v1\",\"ok\":false,",
        "\"source\":{\"manifest_owner\":\"",
        path,
        "\"},\"counts\":{\"examples\":0,\"missing\":0,\"empty\":0,",
        "\"max_lines\":0},",
        "\"findings\":[{\"kind\":\"missing_manifest\",\"path\":\"",
        path,
        "\",\"location\":\"",
        path,
        "\"}]}"
    ];
    return StringJoin(parts, "");
}

func Main() -> Void {
    let manifest_path: String = "src/self_hosted/tools/examples_inventory_checker/fixture/examples_manifest.txt";

    if !FileExists(manifest_path) {
        Log(MissingManifestJson(manifest_path));
        Exit(1);
    }

    let manifest: String = ReadFile(manifest_path);
    let entries: Array<String> = Split(manifest, "\n");

    let examples: Int = 0;
    let missing: Int = 0;
    let empty: Int = 0;
    let max_lines: Int = 0;
    let findings: Array<String> = [];
    let findings_cap: Int = 8;

    let i: Int = 0;
    let n: Int = ArrayLength(entries);
    while i < n {
        let path: String = entries[i];
        if StringLength(path) > 0 {
            if !FileExists(path) {
                missing = missing + 1;
                if ArrayLength(findings) < findings_cap {
                    ArrayPush(findings, MissingFinding("missing_example", path));
                }
            } else {
                examples = examples + 1;
                let content: String = ReadFile(path);
                let lines: Int = TextScan.CountLines(content);
                if lines > max_lines {
                    max_lines = lines;
                }
                if lines == 0 {
                    empty = empty + 1;
                    if ArrayLength(findings) < findings_cap {
                        ArrayPush(findings, MissingFinding("empty_example", path));
                    }
                }
            }
        }
        i = i + 1;
    }

    let ok: Bool = (missing == 0) && (empty == 0);
    let ok_text: String = "true";
    if !ok {
        ok_text = "false";
    }

    let json_parts: Array<String> = [
        "{\"schema\":\"pgy.selfhost.examples-inventory.v1\",\"ok\":",
        ok_text,
        ",\"source\":{\"manifest_owner\":\"",
        manifest_path,
        "\"},\"counts\":{\"examples\":",
        ToString(examples),
        ",\"missing\":",
        ToString(missing),
        ",\"empty\":",
        ToString(empty),
        ",\"max_lines\":",
        ToString(max_lines),
        "},\"findings\":[",
        StringJoin(findings, ","),
        "]}"
    ];
    Log(StringJoin(json_parts, ""));

    if !ok {
        Exit(1);
    }
}
