// Self-hosted Pergyra linter (rung-1).
//
// Reads a Pergyra source file and emits LSP-style diagnostics as a JSON array.
// Rules: trailing whitespace, tab indentation, line longer than 100 columns,
// and TODO/FIXME markers. Output is one JSON array of LSP Diagnostic objects
// (range with 0-based line/character, severity 1=Error 2=Warning 3=Info, a
// source tag, and a message), so an editor or CI gate can consume it directly.
//
// ReadFile is capability-bound to the project root, so the target path is
// project-root relative. This tool lints its committed fixture; point ReadFile
// at another in-root path to lint a different file.
//
// Verified: compiles on C and LLVM, both backends produce identical output.

func CharAt(s: String, i: Int) -> String {
    let n: Int = StringLength(s);
    if i < 0 { return ""; }
    if i >= n { return ""; }
    return Substring(s, i, 1);
}

func IndexOfWord(line: String, word: String) -> Option<Int> {
    let n: Int = StringLength(line);
    let w: Int = StringLength(word);
    if w == 0 { return None; }
    let j: Int = 0;
    while j + w <= n {
        if Substring(line, j, w) == word {
            return Some(j);
        }
        j = j + 1;
    }
    return None;
}

func TrailingSpaceCol(line: String) -> Option<Int> {
    let n: Int = StringLength(line);
    if n == 0 { return None; }
    let last: String = CharAt(line, n - 1);
    if last == " " { return Some(n - 1); }
    if last == "\t" { return Some(n - 1); }
    return None;
}

func StartsWithTab(line: String) -> Bool {
    return CharAt(line, 0) == "\t";
}

func Diag(line: Int, col: Int, endCol: Int, sev: Int, msg: String) -> String {
    let parts: Array<String> = [
        "{\"range\":{\"start\":{\"line\":", ToString(line),
        ",\"character\":", ToString(col),
        "},\"end\":{\"line\":", ToString(line),
        ",\"character\":", ToString(endCol),
        "}},\"severity\":", ToString(sev),
        ",\"source\":\"pgy-lint\",\"message\":\"", msg, "\"}"
    ];
    return StringJoin(parts, "");
}

func ScanStructure(content: String, inout diags: Array<String>) -> Void {
    let n: Int = StringLength(content);
    // structural scan: bracket balance + empty block, skipping strings/comments
    let si: Int = 0;
    let sline: Int = 0;
    let scol: Int = 0;
    let depth: Int = 0;
    let inStr: Bool = false;
    let inComment: Bool = false;
    let lastSig: String = "";
    let lastSigLine: Int = 0;
    let lastSigCol: Int = 0;
    while si < n {
        let sc: String = CharAt(content, si);
        if sc == "\n" {
            sline = sline + 1;
            scol = 0;
            inComment = false;
            si = si + 1;
        } else {
            if inComment {
                scol = scol + 1;
                si = si + 1;
            } else {
                if inStr {
                    if sc == "\\" {
                        scol = scol + 2;
                        si = si + 2;
                    } else {
                        if sc == "\"" { inStr = false; }
                        scol = scol + 1;
                        si = si + 1;
                    }
                } else {
                    if sc == "\"" {
                        inStr = true;
                        scol = scol + 1;
                        si = si + 1;
                    } else {
                        if sc == "/" && CharAt(content, si + 1) == "/" {
                            inComment = true;
                            scol = scol + 1;
                            si = si + 1;
                        } else {
                            if sc == "{" || sc == "(" || sc == "[" {
                                depth = depth + 1;
                            }
                            if sc == "}" || sc == ")" || sc == "]" {
                                if sc == "}" && lastSig == "{" {
                                    ArrayPush(diags, Diag(lastSigLine, lastSigCol, lastSigCol + 1, 3, "empty block"));
                                }
                                depth = depth - 1;
                                if depth < 0 {
                                    ArrayPush(diags, Diag(sline, scol, scol + 1, 1, "unmatched closing bracket"));
                                    depth = 0;
                                }
                            }
                            if sc != " " && sc != "\t" {
                                lastSig = sc;
                                lastSigLine = sline;
                                lastSigCol = scol;
                            }
                            scol = scol + 1;
                            si = si + 1;
                        }
                    }
                }
            }
        }
    }
    if depth > 0 {
        ArrayPush(diags, Diag(sline, 0, 1, 1, "unbalanced brackets at end of file"));
    }

    return;
}

func Main() -> Void {
    let content: String = ReadFile("src/self_hosted/tools/linter/fixture.pgy");
    let n: Int = StringLength(content);

    let diags: Array<String> = [];
    let lineStart: Int = 0;
    let lineNum: Int = 0;
    let i: Int = 0;

    while i <= n {
        let atEnd: Bool = i == n;
        let isNl: Bool = false;
        if atEnd == false {
            if CharAt(content, i) == "\n" {
                isNl = true;
            }
        }
        if isNl || atEnd {
            let line: String = Substring(content, lineStart, i - lineStart);
            let len: Int = StringLength(line);

            let tw: Option<Int> = TrailingSpaceCol(line);
            if IsSome(tw) {
                let twCol: Int = UnwrapOption(tw);
                ArrayPush(diags, Diag(lineNum, twCol, len, 2, "trailing whitespace"));
            }
            if StartsWithTab(line) {
                ArrayPush(diags, Diag(lineNum, 0, 1, 2, "tab indentation; use spaces"));
            }
            if len > 100 {
                ArrayPush(diags, Diag(lineNum, 100, len, 3, "line exceeds 100 columns"));
            }
            let todo: Option<Int> = IndexOfWord(line, "TODO");
            if IsSome(todo) {
                let todoCol: Int = UnwrapOption(todo);
                ArrayPush(diags, Diag(lineNum, todoCol, todoCol + 4, 3, "TODO marker"));
            }
            let fixme: Option<Int> = IndexOfWord(line, "FIXME");
            if IsSome(fixme) {
                let fixmeCol: Int = UnwrapOption(fixme);
                ArrayPush(diags, Diag(lineNum, fixmeCol, fixmeCol + 5, 3, "FIXME marker"));
            }

            lineStart = i + 1;
            lineNum = lineNum + 1;
        }
        i = i + 1;
    }


    ScanStructure(content, diags);
    Log(Concat("[", Concat(StringJoin(diags, ","), "]")));
}
