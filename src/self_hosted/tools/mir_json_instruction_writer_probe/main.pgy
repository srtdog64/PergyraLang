// Byte-parity probe for the sequential MIR instruction artifact writer.
// The String and file projections consume the exact same verified facts so
// producer nondeterminism cannot hide a wire-order or escaping difference.

import "../../compiler/driver/driver_rung2_owner.pgy";

func MirJsonInstructionWriterInvalidFacts(
    facts: SelfMirProgramFacts
) -> SelfMirProgramFacts {
    var invalid: SelfMirProgramFacts = facts;
    var cfg: SelfMirCfgRows = invalid.cfg;
    var instructions: SelfMirInstructionRows = cfg.instructions;
    var ids: Array<Int> = instructions.ids;
    ArrayPush(ids, -1);
    instructions.ids = ids;
    cfg.instructions = instructions;
    invalid.cfg = cfg;
    return invalid;
}

func MirJsonInstructionWriterInvalidAssignments(
    facts: SelfMirProgramFacts
) -> SelfMirProgramFacts {
    var invalid: SelfMirProgramFacts = facts;
    var assignments: SelfMirDomainRuntimeAssignmentFacts =
        invalid.domain_runtime_assignments;
    assignments.ok = false;
    invalid.domain_runtime_assignments = assignments;
    return invalid;
}

func MirJsonInstructionWriterProjection(source: String) -> DriverRung2MirProjection
    with caps io_read {
    let artifact: AstTreeArtifact = CompileSourceToAstArtifact(source);
    let analysis: SemanticAstArtifactAnalysis =
        SemanticAstArtifactAnalyzeTyped(artifact, true);
    return DriverRung2MirProjectionFromAnalysisObserved(
        artifact, analysis, SelfHostMachineLayerDeclarationEmpty(), false);
}

func Main() -> Void with caps env, io_read, io_write {
    let args: Array<String> = Args();
    if ArrayLength(args) != 4 {
        Die("MIR JSON instruction writer probe requires source, String output, file output, and invalid output paths");
    }

    let projection: DriverRung2MirProjection =
        MirJsonInstructionWriterProjection(args[0]);
    let string_json: String = SelfMirProgramJson(projection.facts);
    if string_json == "" { Die("String MIR JSON projection failed"); }
    WriteFile(args[1], string_json);
    if !SelfMirProgramJsonWriteFile(projection.facts, args[2]) {
        Die("sequential MIR JSON artifact projection failed");
    }

    WriteFile(args[3], "writer-preopen-sentinel");
    // The conditional prefix writer may rely only on the public wrapper's
    // admitted domain facts, never on empty text masking invalid rows.
    let invalid_assignments: SelfMirProgramFacts =
        MirJsonInstructionWriterInvalidAssignments(projection.facts);
    if SelfMirProgramJson(invalid_assignments) != "" {
        Die("String MIR JSON projection accepted invalid domain assignments");
    }
    if SelfMirProgramJsonWriteFile(invalid_assignments, args[3]) ||
        ReadFile(args[3]) != "writer-preopen-sentinel" {
        Die("invalid domain assignments passed the pre-open boundary");
    }
    // Each mutation consumes its own facts; it cannot corrupt or move the
    // verified facts used by the preceding positive and negative cases.
    let fresh: DriverRung2MirProjection = MirJsonInstructionWriterProjection(args[0]);
    let invalid: SelfMirProgramFacts = MirJsonInstructionWriterInvalidFacts(fresh.facts);
    if SelfMirProgramJson(invalid) != "" {
        Die("String MIR JSON projection accepted invalid instruction rows");
    }
    if SelfMirProgramJsonWriteFile(invalid, args[3]) {
        Die("sequential MIR JSON writer accepted invalid instruction rows");
    }
    if ReadFile(args[3]) != "writer-preopen-sentinel" {
        Die("invalid MIR facts opened or truncated the output artifact");
    }
    Log("mir-json-instruction-writer-byte-probe-ok");
}
