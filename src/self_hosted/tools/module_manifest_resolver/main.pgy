// src/self_hosted/tools/module_manifest_resolver/main.pgy
//
// Status: rung-2 minimal (2026-05-27). Reads
// docs/language_module_manifest.json relative to cwd, counts modules,
// beta_blocker entries, and stable-subset entries via substring scans,
// validates that every module has a full required-field set by comparing
// counts in parallel, emits the validator schema.
//
// Cwd contract: the parity harness cd's into the repo root before running.
//
// Required-field check: a well-formed manifest has equal counts of `"name":`,
// `"layer":`, `"status":`, and `"beta_blocker":` inside the modules array,
// because the BDFL keeps the manifest pretty-printed one-field-per-line.
// If any field count diverges from the module count, a finding is emitted.
//
// CountOccurrences moved to src/self_hosted/lib/text_scan.pgy (2026-05-27).
// The parity harness mirrors the lib subtree into the build dir so the
// relative import resolves under the copied tool source.
//
// Contract: see intent.md in the same directory.

import "../../lib/json.pgy";
import "../../lib/text_scan.pgy";

func MissingFieldFinding(field: String, expected: Int, actual: Int) -> String {
    let fields: Array<String> = [
        JsonEmitFieldString("kind", "field_count_mismatch"),
        JsonEmitFieldString("key", field),
        JsonEmitFieldNumber("expected", ToString(expected)),
        JsonEmitFieldNumber("actual", ToString(actual)),
        JsonEmitFieldString("location", "docs/language_module_manifest.json")
    ];
    return JsonEmitObject(fields);
}

func MissingModulesKeyFinding() -> String {
    let fields: Array<String> = [
        JsonEmitFieldString("kind", "missing_modules_key"),
        JsonEmitFieldString("key", "modules"),
        JsonEmitFieldString("location", "docs/language_module_manifest.json")
    ];
    return JsonEmitObject(fields);
}

func ModuleManifestReportJson(
    ok: Bool,
    manifest_path: String,
    modules: Int,
    beta_blockers: Int,
    stable_subset: Int,
    missing_fields: Int,
    findings: Array<String>
) -> String {
    let source_fields: Array<String> = [
        JsonEmitFieldString("manifest_owner", manifest_path)
    ];
    let counts_fields: Array<String> = [
        JsonEmitFieldNumber("modules", ToString(modules)),
        JsonEmitFieldNumber("beta_blockers", ToString(beta_blockers)),
        JsonEmitFieldNumber("stable_subset", ToString(stable_subset)),
        JsonEmitFieldNumber("missing_fields", ToString(missing_fields))
    ];
    let report_fields: Array<String> = [
        JsonEmitFieldString("schema", "pgy.selfhost.module-manifest-resolver.v1"),
        JsonEmitFieldBool("ok", ok),
        JsonEmitFieldRaw("source", JsonEmitObject(source_fields)),
        JsonEmitFieldRaw("counts", JsonEmitObject(counts_fields)),
        JsonEmitFieldRaw("findings", JsonEmitArray(findings))
    ];
    return JsonEmitObject(report_fields);
}

func InputErrorJson(path: String) -> String {
    let finding_fields: Array<String> = [
        JsonEmitFieldString("kind", "input_error"),
        JsonEmitFieldString("key", path),
        JsonEmitFieldString("location", path)
    ];
    let findings: Array<String> = [
        JsonEmitObject(finding_fields)
    ];
    return ModuleManifestReportJson(false, "docs/language_module_manifest.json", 0, 0, 0, 0, findings);
}

func Main() -> Void {
    let manifest_path: String = "docs/language_module_manifest.json";
    if !FileExists(manifest_path) {
        Log(InputErrorJson(manifest_path));
        Exit(1);
    }

    let content: String = ReadFile(manifest_path);

    let findings: Array<String> = [];

    if !JsonDocumentHasField(content, "modules") {
        ArrayPush(findings, MissingModulesKeyFinding());
        Log(ModuleManifestReportJson(false, manifest_path, 0, 0, 0, 1, findings));
        Exit(1);
    }

    let modules: Int = TextScan.CountOccurrences(content, "\"name\":");
    let layers: Int = TextScan.CountOccurrences(content, "\"layer\":");
    let statuses: Int = TextScan.CountOccurrences(content, "\"status\":");
    let blockers_present: Int = TextScan.CountOccurrences(content, "\"beta_blocker\":");
    let beta_blockers: Int = TextScan.CountOccurrences(content, "\"beta_blocker\": true");
    let stable_subset: Int = TextScan.CountOccurrences(content, "\"status\": \"stable-subset\"");

    let missing_fields: Int = 0;
    if layers != modules {
        missing_fields = missing_fields + 1;
        ArrayPush(findings, MissingFieldFinding("layer", modules, layers));
    }
    if statuses != modules {
        missing_fields = missing_fields + 1;
        ArrayPush(findings, MissingFieldFinding("status", modules, statuses));
    }
    if blockers_present != modules {
        missing_fields = missing_fields + 1;
        ArrayPush(findings, MissingFieldFinding("beta_blocker", modules, blockers_present));
    }

    Log(ModuleManifestReportJson(
        missing_fields == 0,
        manifest_path,
        modules,
        beta_blockers,
        stable_subset,
        missing_fields,
        findings));

    if missing_fields > 0 {
        Exit(1);
    }
}
