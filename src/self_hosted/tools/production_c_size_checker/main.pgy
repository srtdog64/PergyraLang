// src/self_hosted/tools/production_c_size_checker/main.pgy
//
// Status: rung-2 minimal (2026-05-27). Sister tool to tool 8 -- iterates
// the committed `.c` manifest, reads each translation unit, counts
// newlines, asserts the current production C size cap.
//
// Cwd contract: the parity harness cd's into the repo root before running.
//
// Pattern reused from tool 8 (`production_header_size_checker`): manifest
// input + per-line file I/O loop. `CountLines` lifted to
// src/self_hosted/lib/text_scan.pgy (2026-05-27).
//
// Contract: see intent.md in the same directory.

import "../../lib/text_scan.pgy";

func OverCapFinding(path: String, lines: Int) -> String {
    let parts: Array<String> = [
        "{\"kind\":\"c_over_cap\",\"path\":\"",
        path,
        "\",\"lines\":",
        ToString(lines),
        ",\"location\":\"",
        path,
        "\"}"
    ];
    return StringJoin(parts, "");
}

func MissingFileFinding(path: String) -> String {
    let parts: Array<String> = [
        "{\"kind\":\"input_error\",\"path\":\"",
        path,
        "\",\"lines\":0,\"location\":\"",
        path,
        "\"}"
    ];
    return StringJoin(parts, "");
}

func MissingManifestJson(path: String) -> String {
    let parts: Array<String> = [
        "{\"schema\":\"pgy.selfhost.production-c-size.v1\",\"ok\":false,",
        "\"source\":{\"manifest_owner\":\"",
        path,
        "\",\"cap_lines\":699},",
        "\"counts\":{\"c_files\":0,\"violations\":0,\"max_lines\":0},",
        "\"findings\":[{\"kind\":\"missing_manifest\",\"path\":\"",
        path,
        "\",\"lines\":0,\"location\":\"",
        path,
        "\"}]}"
    ];
    return StringJoin(parts, "");
}

func Main() -> Void {
    let manifest_path: String = "src/self_hosted/tools/production_c_size_checker/fixture/c_files_manifest.txt";
    // Production C owners use the highest 600s hard cap. The checker records
    // current max_lines from the manifest so source-owner splits cannot drift silently.
    let cap: Int = 699;

    if !FileExists(manifest_path) {
        Log(MissingManifestJson(manifest_path));
        Exit(1);
    }

    let manifest: String = ReadFile(manifest_path);
    let entries: Array<String> = Split(manifest, "\n");

    let c_files: Int = 0;
    let violations: Int = 0;
    let max_lines: Int = 0;
    let findings: Array<String> = [];
    let findings_cap: Int = 8;

    let i: Int = 0;
    let n: Int = ArrayLength(entries);
    while i < n {
        let path: String = entries[i];
        if StringLength(path) > 0 {
            if !FileExists(path) {
                if ArrayLength(findings) < findings_cap {
                    ArrayPush(findings, MissingFileFinding(path));
                }
                violations = violations + 1;
            } else {
                c_files = c_files + 1;
                let content: String = ReadFile(path);
                let lines: Int = TextScan.CountLines(content);
                if lines > max_lines {
                    max_lines = lines;
                }
                if lines > cap {
                    violations = violations + 1;
                    if ArrayLength(findings) < findings_cap {
                        ArrayPush(findings, OverCapFinding(path, lines));
                    }
                }
            }
        }
        i = i + 1;
    }

    let ok_text: String = "true";
    if violations > 0 {
        ok_text = "false";
    }

    let json_parts: Array<String> = [
        "{\"schema\":\"pgy.selfhost.production-c-size.v1\",\"ok\":",
        ok_text,
        ",\"source\":{\"manifest_owner\":\"",
        manifest_path,
        "\",\"cap_lines\":",
        ToString(cap),
        "},\"counts\":{\"c_files\":",
        ToString(c_files),
        ",\"violations\":",
        ToString(violations),
        ",\"max_lines\":",
        ToString(max_lines),
        "},\"findings\":[",
        StringJoin(findings, ","),
        "]}"
    ];
    Log(StringJoin(json_parts, ""));

    if violations > 0 {
        Exit(1);
    }
}
