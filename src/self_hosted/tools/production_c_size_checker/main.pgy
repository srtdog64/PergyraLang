// src/self_hosted/tools/production_c_size_checker/main.pgy
//
// Status: rung-2 DirWalk-owned (2026-06-15). Sister tool to tool 8 --
// enumerates production `.c` owners through DirWalk("src"), filters the same
// production owner scope as tests/test_inc_size_smoke.sh, counts newlines,
// and asserts the current production C size cap.
//
// Cwd contract: the parity harness cd's into the repo root before running.
//
// Pattern reused from tool 8 (`production_header_size_checker`): DirWalk-owned
// inventory + per-file I/O loop. `CountLines` lifted to
// src/self_hosted/lib/text_scan.pgy (2026-05-27).
//
// Contract: see intent.md in the same directory.

import "../../lib/json.pgy";
import "../../lib/text_scan.pgy";

func OverCapFinding(path: String, lines: Int) -> String {
    let fields: Array<String> = [
        JsonEmitFieldString("kind", "c_over_cap"),
        JsonEmitFieldString("path", path),
        JsonEmitFieldNumber("lines", ToString(lines)),
        JsonEmitFieldString("location", path)
    ];
    return JsonEmitObject(fields);
}

func StartsWith(text: String, prefix: String) -> Bool {
    let text_len: Int = StringLength(text);
    let prefix_len: Int = StringLength(prefix);
    if text_len < prefix_len {
        return false;
    }
    return Substring(text, 0, prefix_len) == prefix;
}

func EndsWith(text: String, suffix: String) -> Bool {
    let text_len: Int = StringLength(text);
    let suffix_len: Int = StringLength(suffix);
    if text_len < suffix_len {
        return false;
    }
    return Substring(text, text_len - suffix_len, suffix_len) == suffix;
}

func BasenameStartsWith(path: String, prefix: String) -> Bool {
    let last_slash: Int = -1;
    let i: Int = 0;
    let n: Int = StringLength(path);
    while i < n {
        if Substring(path, i, 1) == "/" {
            last_slash = i;
        }
        i = i + 1;
    }
    let start: Int = last_slash + 1;
    let remaining: Int = n - start;
    let prefix_len: Int = StringLength(prefix);
    if remaining < prefix_len {
        return false;
    }
    return Substring(path, start, prefix_len) == prefix;
}

func IsProductionCSource(path: String) -> Bool {
    if !StartsWith(path, "src/") || !EndsWith(path, ".c") {
        return false;
    }
    if StartsWith(path, "src/tests/") {
        return false;
    }
    return !BasenameStartsWith(path, "test_");
}

func Main() -> Void {
    let dirwalk_owner: String = "src";
    // Production C owners use the highest 600s hard cap. The checker records
    // current max_lines from the directory snapshot so owner splits cannot drift silently.
    let cap: Int = 699;
    let entries: Array<String> = DirWalk(dirwalk_owner);

    let c_files: Int = 0;
    let violations: Int = 0;
    let max_lines: Int = 0;
    let findings: Array<String> = [];
    let findings_cap: Int = 8;

    let i: Int = 0;
    let n: Int = ArrayLength(entries);
    while i < n {
        let path: String = entries[i];
        if IsProductionCSource(path) {
            c_files = c_files + 1;
            let content: String = ReadFile(path);
            let lines: Int = TextScan.CountLines(content);
            if lines > max_lines {
                max_lines = lines;
            }
            if lines > cap {
                violations = violations + 1;
                if ArrayLength(findings) < findings_cap {
                    ArrayPush(findings, OverCapFinding(path, lines));
                }
            }
        }
        i = i + 1;
    }

    let source_fields: Array<String> = [
        JsonEmitFieldString("dirwalk_owner", dirwalk_owner),
        JsonEmitFieldString("filter", "test_inc_size_production_c_scope"),
        JsonEmitFieldNumber("cap_lines", ToString(cap))
    ];
    let counts_fields: Array<String> = [
        JsonEmitFieldNumber("c_files", ToString(c_files)),
        JsonEmitFieldNumber("violations", ToString(violations)),
        JsonEmitFieldNumber("max_lines", ToString(max_lines))
    ];
    let report_fields: Array<String> = [
        JsonEmitFieldString("schema", "pgy.selfhost.production-c-size.v1"),
        JsonEmitFieldBool("ok", violations == 0),
        JsonEmitFieldRaw("source", JsonEmitObject(source_fields)),
        JsonEmitFieldRaw("counts", JsonEmitObject(counts_fields)),
        JsonEmitFieldRaw("findings", JsonEmitArray(findings))
    ];
    Log(JsonEmitObject(report_fields));

    if violations > 0 {
        Exit(1);
    }
}
