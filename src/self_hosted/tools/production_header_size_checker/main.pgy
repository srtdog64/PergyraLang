// src/self_hosted/tools/production_header_size_checker/main.pgy
//
// Status: rung-2 DirWalk-owned (2026-06-15). Enumerates production header
// owners through DirWalk("src"), filters the same prefixes as
// tests/production_header_size_smoke.sh, counts newlines, and asserts <= 600
// LOC. Reports any over-cap headers in findings[].
//
// Cwd contract: the parity harness cd's into the repo root before running.
//
// CountLines moved to src/self_hosted/lib/text_scan.pgy (2026-05-27, lifted
// once a third consumer adopted it).
//
// Contract: see intent.md in the same directory.

import "../../lib/json.pgy";
import "../../lib/text_scan.pgy";

func OverCapFinding(path: String, lines: Int) -> String {
    let fields: Array<String> = [
        JsonEmitFieldString("kind", "header_over_cap"),
        JsonEmitFieldString("path", path),
        JsonEmitFieldNumber("lines", ToString(lines)),
        JsonEmitFieldString("location", path)
    ];
    return JsonEmitObject(fields);
}

func StartsWith(text: String, prefix: String) -> Bool {
    let text_len: Int = StringLength(text);
    let prefix_len: Int = StringLength(prefix);
    if text_len < prefix_len {
        return false;
    }
    return Substring(text, 0, prefix_len) == prefix;
}

func EndsWith(text: String, suffix: String) -> Bool {
    let text_len: Int = StringLength(text);
    let suffix_len: Int = StringLength(suffix);
    if text_len < suffix_len {
        return false;
    }
    return Substring(text, text_len - suffix_len, suffix_len) == suffix;
}

func IsProductionHeader(path: String) -> Bool {
    if !EndsWith(path, ".h") {
        return false;
    }
    return StartsWith(path, "src/codegen/") ||
        StartsWith(path, "src/runtime/") ||
        StartsWith(path, "src/compiler/") ||
        StartsWith(path, "src/semantic/") ||
        StartsWith(path, "src/parser/") ||
        StartsWith(path, "src/lsp/");
}

func Main() -> Void {
    let dirwalk_owner: String = "src";
    let cap: Int = 600;
    let entries: Array<String> = DirWalk(dirwalk_owner);

    let headers: Int = 0;
    let violations: Int = 0;
    let max_lines: Int = 0;
    let findings: Array<String> = [];
    let findings_cap: Int = 8;

    let i: Int = 0;
    let n: Int = ArrayLength(entries);
    while i < n {
        let path: String = entries[i];
        if IsProductionHeader(path) {
            headers = headers + 1;
            let content: String = ReadFile(path);
            let lines: Int = TextScan.CountLines(content);
            if lines > max_lines {
                max_lines = lines;
            }
            if lines > cap {
                violations = violations + 1;
                if ArrayLength(findings) < findings_cap {
                    ArrayPush(findings, OverCapFinding(path, lines));
                }
            }
        }
        i = i + 1;
    }

    let source_fields: Array<String> = [
        JsonEmitFieldString("dirwalk_owner", dirwalk_owner),
        JsonEmitFieldString("filter", "production_header_smoke_scope"),
        JsonEmitFieldNumber("cap_lines", ToString(cap))
    ];
    let counts_fields: Array<String> = [
        JsonEmitFieldNumber("headers", ToString(headers)),
        JsonEmitFieldNumber("violations", ToString(violations)),
        JsonEmitFieldNumber("max_lines", ToString(max_lines))
    ];
    let report_fields: Array<String> = [
        JsonEmitFieldString("schema", "pgy.selfhost.production-header-size.v1"),
        JsonEmitFieldBool("ok", violations == 0),
        JsonEmitFieldRaw("source", JsonEmitObject(source_fields)),
        JsonEmitFieldRaw("counts", JsonEmitObject(counts_fields)),
        JsonEmitFieldRaw("findings", JsonEmitArray(findings))
    ];
    Log(JsonEmitObject(report_fields));

    if violations > 0 {
        Exit(1);
    }
}
