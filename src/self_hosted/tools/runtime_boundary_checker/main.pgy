// src/self_hosted/tools/runtime_boundary_checker/main.pgy
//
// Status: rung-2 (2026-06-16). Soft self-host runtime-boundary checker.
// It keeps runtime self-host claims split between the C native kernel and
// Pergyra-owned portable policy/checker work.

func Finding(path: String, term: String) -> String {
    let parts: Array<String> = [
        "{\"kind\":\"missing_term\",\"path\":\"",
        path,
        "\",\"term\":\"",
        term,
        "\"}"
    ];
    return StringJoin(parts, "");
}

func InputError(path: String) -> String {
    let parts: Array<String> = [
        "{\"schema\":\"pgy.selfhost.runtime-boundary.v1\",\"ok\":false,",
        "\"counts\":{\"documents\":0,\"required\":0,\"missing\":1},",
        "\"findings\":[{\"kind\":\"input_error\",\"path\":\"",
        path,
        "\"}]}"
    ];
    return StringJoin(parts, "");
}

func RuntimeBoundaryRequiredTermCount() -> Int {
    return 8;
}

func RuntimeBoundaryRequiredPathAt(index: Int) -> String {
    if index == 0 { return "src/self_hosted/runtime/README.md"; }
    if index == 1 { return "src/self_hosted/runtime/README.md"; }
    if index == 2 { return "src/self_hosted/runtime/README.md"; }
    if index == 3 { return "src/self_hosted/PROGRESS.md"; }
    if index == 4 { return "src/self_hosted/PROGRESS.md"; }
    if index == 5 { return "src/self_hosted/README.md"; }
    if index == 6 { return "docs/self_hosted/05_compiler_core_gap_analysis.md"; }
    if index == 7 { return "docs/self_hosted/05_compiler_core_gap_analysis.md"; }
    return "";
}

func RuntimeBoundaryRequiredTermAt(index: Int) -> String {
    if index == 0 { return "The native runtime kernel remains C"; }
    if index == 1 { return "Portable runtime policy can move to Pergyra"; }
    if index == 2 { return "full runtime replacement"; }
    if index == 3 { return "native runtime kernel stays C"; }
    if index == 4 { return "Runtime-adjacent Pergyra tools count as soft self-host evidence"; }
    if index == 5 { return "runtime/                        -- native runtime kernel stays C"; }
    if index == 6 { return "runtime in one jump"; }
    if index == 7 { return "runtime replacement"; }
    return "";
}

func EmitRuntimeBoundaryTermManifest() -> Void {
    let i: Int = 0;
    let n: Int = RuntimeBoundaryRequiredTermCount();
    while i < n {
        let pair: Array<String> = [
            RuntimeBoundaryRequiredPathAt(i),
            "|",
            RuntimeBoundaryRequiredTermAt(i)
        ];
        Log(StringJoin(pair, ""));
        i = i + 1;
    }
}

func Main() -> Void {
    let args: Array<String> = Args();
    if ArrayLength(args) > 0 && args[0] == "--terms" {
        EmitRuntimeBoundaryTermManifest();
        return;
    }
    let missing: Int = 0;
    let findings: Array<String> = [];
    let i: Int = 0;
    let n: Int = RuntimeBoundaryRequiredTermCount();
    while i < n {
        let path: String = RuntimeBoundaryRequiredPathAt(i);
        let term: String = RuntimeBoundaryRequiredTermAt(i);
        if !FileExists(path) {
            Log(InputError(path));
            Exit(1);
        }
        let content: String = ReadFile(path);
        if !StringContains(content, term) {
            missing = missing + 1;
            ArrayPush(findings, Finding(path, term));
        }
        i = i + 1;
    }

    let ok_text: String = "true";
    if missing > 0 {
        ok_text = "false";
    }

    let parts: Array<String> = [
        "{\"schema\":\"pgy.selfhost.runtime-boundary.v1\",\"ok\":",
        ok_text,
        ",\"counts\":{\"documents\":4,\"required\":",
        ToString(n),
        ",\"missing\":",
        ToString(missing),
        "},\"findings\":[",
        StringJoin(findings, ","),
        "]}"
    ];
    Log(StringJoin(parts, ""));
    if missing > 0 {
        Exit(1);
    }
}
