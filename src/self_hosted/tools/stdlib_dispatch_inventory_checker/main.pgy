// src/self_hosted/tools/stdlib_dispatch_inventory_checker/main.pgy
//
// Status: rung-2 minimal (2026-05-27). Reads the C-backend and LLVM-backend
// stdlib scalar/IO dispatch tables relative to cwd, counts entries via stable
// anchor patterns, and asserts the counts remain inside the documented drift
// tolerance. Emits the validator schema.
//
// Cwd contract: the parity harness cd's into the repo root before running.
//
// Anchor patterns (chosen for stability, not literal entry count -- the same
// pattern in both files yields the same overcount or undercount, so the
// drift signal stays meaningful):
//   - C-side:    `, TRANSPILER_SCALAR_OP_` matches each dispatch entry once.
//   - LLVM-side: `"stdlib ` matches each dispatch entry's family-name slot.
//
// When a new builtin lands in only one of the two tables and exceeds the
// tolerance band, the tool emits a `count_drift` finding. Permanent direction:
// align both dispatch inventories and ratchet drift_tolerance to 0.
//
// CountOccurrences moved to src/self_hosted/lib/text_scan.pgy (2026-05-27).
//
// Contract: see intent.md in the same directory.

import "../../lib/text_scan.pgy";
import "../../lib/json.pgy";

func DriftFinding(c_entries: Int, llvm_entries: Int) -> String {
    let fields: Array<String> = [
        JsonEmitFieldString("kind", "count_drift"),
        JsonEmitFieldNumber("c_entries", ToString(c_entries)),
        JsonEmitFieldNumber("llvm_entries", ToString(llvm_entries)),
        JsonEmitFieldString("location", "src/codegen/transpiler_expr_stdlib_scalar_builtin.c")
    ];
    return JsonEmitObject(fields);
}

func InputErrorJson(path: String) -> String {
    let source_fields: Array<String> = [
        JsonEmitFieldString("c_dispatch_owner", "src/codegen/transpiler_expr_stdlib_scalar_builtin.c"),
        JsonEmitFieldString("llvm_dispatch_owner", "src/codegen/llvm_expr_stdlib_scalar_io_calls.c")
    ];
    let counts_fields: Array<String> = [
        JsonEmitFieldNumber("c_entries", "0"),
        JsonEmitFieldNumber("llvm_entries", "0"),
        JsonEmitFieldNumber("drift", "0")
    ];
    let finding_fields: Array<String> = [
        JsonEmitFieldString("kind", "input_error"),
        JsonEmitFieldString("key", path),
        JsonEmitFieldString("location", path)
    ];
    let findings: Array<String> = [
        JsonEmitObject(finding_fields)
    ];
    let report_fields: Array<String> = [
        JsonEmitFieldString("schema", "pgy.selfhost.stdlib-dispatch-inventory.v1"),
        JsonEmitFieldBool("ok", false),
        JsonEmitFieldRaw("source", JsonEmitObject(source_fields)),
        JsonEmitFieldRaw("counts", JsonEmitObject(counts_fields)),
        JsonEmitFieldRaw("findings", JsonEmitArray(findings))
    ];
    return JsonEmitObject(report_fields);
}

func Main() -> Void {
    let c_path: String = "src/codegen/transpiler_expr_stdlib_scalar_builtin.c";
    let llvm_path: String = "src/codegen/llvm_expr_stdlib_scalar_io_calls.c";

    if !FileExists(c_path) {
        Log(InputErrorJson(c_path));
        Exit(1);
    }
    if !FileExists(llvm_path) {
        Log(InputErrorJson(llvm_path));
        Exit(1);
    }

    let c_content: String = ReadFile(c_path);
    let llvm_content: String = ReadFile(llvm_path);

    // C dispatch is split across two tables: the main TRANSPILER_SCALAR_OP_
    // family (most builtins) and a TranspilerScalarUnarySpec math family
    // ({ "Acos" }, { "Asin" }, ...). Sum both so the count is comparable to
    // the single LLVM table.
    let c_entries: Int = TextScan.CountOccurrences(c_content, ", TRANSPILER_SCALAR_OP_")
        + TextScan.CountOccurrences(c_content, "        { \"");
    let llvm_entries: Int = TextScan.CountOccurrences(llvm_content, "\"stdlib ");

    // Allow a small drift band: builtin parity is post-beta work, and the
    // count anchors are heuristic. Permanent fix: align LLVM/C dispatch
    // tables once self-host gives us better grouping.
    let drift_tolerance: Int = 5;
    let raw_drift: Int = c_entries - llvm_entries;
    if raw_drift < 0 {
        raw_drift = -raw_drift;
    }
    let drift: Int = 0;
    let findings: Array<String> = [];
    if raw_drift > drift_tolerance {
        drift = 1;
        ArrayPush(findings, DriftFinding(c_entries, llvm_entries));
    }

    let source_fields: Array<String> = [
        JsonEmitFieldString("c_dispatch_owner", c_path),
        JsonEmitFieldString("llvm_dispatch_owner", llvm_path)
    ];
    let counts_fields: Array<String> = [
        JsonEmitFieldNumber("c_entries", ToString(c_entries)),
        JsonEmitFieldNumber("llvm_entries", ToString(llvm_entries)),
        JsonEmitFieldNumber("drift", ToString(drift))
    ];
    let report_fields: Array<String> = [
        JsonEmitFieldString("schema", "pgy.selfhost.stdlib-dispatch-inventory.v1"),
        JsonEmitFieldBool("ok", drift == 0),
        JsonEmitFieldRaw("source", JsonEmitObject(source_fields)),
        JsonEmitFieldRaw("counts", JsonEmitObject(counts_fields)),
        JsonEmitFieldRaw("findings", JsonEmitArray(findings))
    ];
    Log(JsonEmitObject(report_fields));

    if drift > 0 {
        Exit(1);
    }
}
