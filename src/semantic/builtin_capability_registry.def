/* PGY_BUILTIN_CAPABILITY_POLICY_ROWS
 *
 * Canonical ambient-builtin -> capability policy registry.
 *
 * PGY_BUILTIN_CAPABILITY(
 *     identity, stable_id, source_name, primary_capability_identity,
 *     secondary_capability_identity, policy)
 *
 * FIXED rows require primary (primary == secondary). FILE_MODE rows derive
 * the precise read/write union from pgy_file_mode_capability.def and use the
 * two identities as their fail-closed dynamic/unknown result.
 */

PGY_BUILTIN_CAPABILITY(ARGS, 0, "Args", CAP_ENV, CAP_ENV, PGY_BUILTIN_CAPABILITY_FIXED)
PGY_BUILTIN_CAPABILITY(COMPILER_ARTIFACT_ABORT, 1, "CompilerArtifactAbort", CAP_IO_WRITE, CAP_IO_WRITE, PGY_BUILTIN_CAPABILITY_FIXED)
PGY_BUILTIN_CAPABILITY(COMPILER_ARTIFACT_BEGIN, 2, "CompilerArtifactBegin", CAP_IO_WRITE, CAP_IO_WRITE, PGY_BUILTIN_CAPABILITY_FIXED)
PGY_BUILTIN_CAPABILITY(COMPILER_ARTIFACT_COMMIT, 3, "CompilerArtifactCommit", CAP_IO_WRITE, CAP_IO_WRITE, PGY_BUILTIN_CAPABILITY_FIXED)
PGY_BUILTIN_CAPABILITY(COMPILER_ARTIFACT_WRITE, 4, "CompilerArtifactWrite", CAP_IO_WRITE, CAP_IO_WRITE, PGY_BUILTIN_CAPABILITY_FIXED)
PGY_BUILTIN_CAPABILITY(DIR_WALK, 5, "DirWalk", CAP_IO_READ, CAP_IO_READ, PGY_BUILTIN_CAPABILITY_FIXED)
PGY_BUILTIN_CAPABILITY(FILE_EXISTS, 6, "FileExists", CAP_IO_READ, CAP_IO_READ, PGY_BUILTIN_CAPABILITY_FIXED)
PGY_BUILTIN_CAPABILITY(FILE_OPEN, 7, "FileOpen", CAP_IO_READ, CAP_IO_WRITE, PGY_BUILTIN_CAPABILITY_FILE_MODE)
PGY_BUILTIN_CAPABILITY(FILE_READ, 8, "FileRead", CAP_IO_READ, CAP_IO_READ, PGY_BUILTIN_CAPABILITY_FIXED)
PGY_BUILTIN_CAPABILITY(FILE_WRITE, 9, "FileWrite", CAP_IO_WRITE, CAP_IO_WRITE, PGY_BUILTIN_CAPABILITY_FIXED)
PGY_BUILTIN_CAPABILITY(INPUT, 10, "Input", CAP_IO_READ, CAP_IO_READ, PGY_BUILTIN_CAPABILITY_FIXED)
PGY_BUILTIN_CAPABILITY(NOW, 11, "Now", CAP_CLOCK, CAP_CLOCK, PGY_BUILTIN_CAPABILITY_FIXED)
PGY_BUILTIN_CAPABILITY(RANDOM, 12, "Random", CAP_RANDOM, CAP_RANDOM, PGY_BUILTIN_CAPABILITY_FIXED)
PGY_BUILTIN_CAPABILITY(READ_FILE, 13, "ReadFile", CAP_IO_READ, CAP_IO_READ, PGY_BUILTIN_CAPABILITY_FIXED)
PGY_BUILTIN_CAPABILITY(READ_STDIN, 14, "ReadStdin", CAP_IO_READ, CAP_IO_READ, PGY_BUILTIN_CAPABILITY_FIXED)
PGY_BUILTIN_CAPABILITY(SEED_RANDOM, 15, "SeedRandom", CAP_RANDOM, CAP_RANDOM, PGY_BUILTIN_CAPABILITY_FIXED)
PGY_BUILTIN_CAPABILITY(WRITE_FILE, 16, "WriteFile", CAP_IO_WRITE, CAP_IO_WRITE, PGY_BUILTIN_CAPABILITY_FIXED)
