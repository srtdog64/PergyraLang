/* Fixed builtin effect policy: PGY_BUILTIN_EFFECT_POLICY_ROWS.
 * Numeric bits and vocabulary remain owned by
 * type_system.h and callable_contract_vocabulary.def. Missing rows are unknown,
 * not pure. Operand-dependent resource and callback effects are not fixed rows.
 * PGY_BUILTIN_EFFECT(source_name, effect_mask_expression) */
PGY_BUILTIN_EFFECT("Now", EFFECT_NONDETERMINISTIC)
PGY_BUILTIN_EFFECT("Cancel", EFFECT_REMOTE)
PGY_BUILTIN_EFFECT("Random", EFFECT_NONDETERMINISTIC)
PGY_BUILTIN_EFFECT("SeedRandom", EFFECT_NONDETERMINISTIC)
PGY_BUILTIN_EFFECT("ReadLine", EFFECT_NONDETERMINISTIC)
PGY_BUILTIN_EFFECT("Sleep", EFFECT_NONDETERMINISTIC)
PGY_BUILTIN_EFFECT("Print", EFFECT_IO)
PGY_BUILTIN_EFFECT("StringLength", EFFECT_NONE)
PGY_BUILTIN_EFFECT("ToString", EFFECT_NONE)
PGY_BUILTIN_EFFECT("Log", EFFECT_NONE)
PGY_BUILTIN_EFFECT("Args", EFFECT_NONDETERMINISTIC)
PGY_BUILTIN_EFFECT("Input", EFFECT_NONDETERMINISTIC)
PGY_BUILTIN_EFFECT("CompilerArtifactAbort", EFFECT_IO)
PGY_BUILTIN_EFFECT("CompilerArtifactBegin", EFFECT_IO)
PGY_BUILTIN_EFFECT("CompilerArtifactCommit", EFFECT_IO)
PGY_BUILTIN_EFFECT("CompilerArtifactWrite", EFFECT_IO)
PGY_BUILTIN_EFFECT("DirWalk", EFFECT_IO | EFFECT_NONDETERMINISTIC)
PGY_BUILTIN_EFFECT("FileExists", EFFECT_IO)
PGY_BUILTIN_EFFECT("FileOpen", EFFECT_IO)
PGY_BUILTIN_EFFECT("FileRead", EFFECT_IO)
PGY_BUILTIN_EFFECT("FileWrite", EFFECT_IO)
PGY_BUILTIN_EFFECT("FileClose", EFFECT_IO)
PGY_BUILTIN_EFFECT("ReadFile", EFFECT_IO)
PGY_BUILTIN_EFFECT("ReadStdin", EFFECT_IO | EFFECT_NONDETERMINISTIC)
PGY_BUILTIN_EFFECT("WriteFile", EFFECT_IO)

