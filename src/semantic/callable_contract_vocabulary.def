/*
 * Canonical callable-contract vocabulary.
 * Registry producer identity: PGY_CALLABLE_CONTRACT_VOCABULARY_ROWS.
 *
 * This is the declaration authority for callable capability/effect words.
 * Runtime numeric masks remain owned by pgy_runtime_capability.h and
 * type_system.h; rows reference those symbols instead of redefining values.
 *
 * PGY_CALLABLE_CONTRACT_CAPABILITY(
 *     identity, stable_id, spelling, mask_symbol, canonical_rank,
 *     zero_policy, external_name)
 * PGY_CALLABLE_CONTRACT_EFFECT(
 *     identity, stable_id, spelling, mask_symbol, canonical_rank,
 *     zero_policy, external_name)
 */

PGY_CALLABLE_CONTRACT_CAPABILITY(CAP_IO_READ, 0, "io_read", PGY_CAP_IO_READ, 0, PGY_CALLABLE_CONTRACT_ZERO_DISALLOWED, "IO_READ")
PGY_CALLABLE_CONTRACT_CAPABILITY(CAP_IO_WRITE, 1, "io_write", PGY_CAP_IO_WRITE, 1, PGY_CALLABLE_CONTRACT_ZERO_DISALLOWED, "IO_WRITE")
PGY_CALLABLE_CONTRACT_CAPABILITY(CAP_NETWORK, 2, "network", PGY_CAP_NETWORK, 2, PGY_CALLABLE_CONTRACT_ZERO_DISALLOWED, "NETWORK")
PGY_CALLABLE_CONTRACT_CAPABILITY(CAP_CLOCK, 3, "clock", PGY_CAP_CLOCK, 3, PGY_CALLABLE_CONTRACT_ZERO_DISALLOWED, "CLOCK")
PGY_CALLABLE_CONTRACT_CAPABILITY(CAP_RANDOM, 4, "random", PGY_CAP_RANDOM, 4, PGY_CALLABLE_CONTRACT_ZERO_DISALLOWED, "RANDOM")
PGY_CALLABLE_CONTRACT_CAPABILITY(CAP_ENV, 5, "env", PGY_CAP_ENV, 5, PGY_CALLABLE_CONTRACT_ZERO_DISALLOWED, "ENV")
PGY_CALLABLE_CONTRACT_CAPABILITY(CAP_RENDER, 6, "render", PGY_CAP_RENDER, 6, PGY_CALLABLE_CONTRACT_ZERO_DISALLOWED, "RENDER")
PGY_CALLABLE_CONTRACT_CAPABILITY(CAP_AUDIO, 7, "audio", PGY_CAP_AUDIO, 7, PGY_CALLABLE_CONTRACT_ZERO_DISALLOWED, "AUDIO")
PGY_CALLABLE_CONTRACT_CAPABILITY(CAP_INPUT, 8, "input", PGY_CAP_INPUT, 8, PGY_CALLABLE_CONTRACT_ZERO_DISALLOWED, "INPUT")

PGY_CALLABLE_CONTRACT_EFFECT(EFFECT_SECURE_WORD, 9, "secure", EFFECT_SECURE, 0, PGY_CALLABLE_CONTRACT_ZERO_DISALLOWED, "")
PGY_CALLABLE_CONTRACT_EFFECT(EFFECT_REMOTE_WORD, 10, "remote", EFFECT_REMOTE, 1, PGY_CALLABLE_CONTRACT_ZERO_DISALLOWED, "")
PGY_CALLABLE_CONTRACT_EFFECT(EFFECT_NONDETERMINISTIC_WORD, 11, "nondeterministic", EFFECT_NONDETERMINISTIC, 2, PGY_CALLABLE_CONTRACT_ZERO_DISALLOWED, "")
PGY_CALLABLE_CONTRACT_EFFECT(EFFECT_COLLAPSE_WORD, 12, "collapse", EFFECT_COLLAPSE, 3, PGY_CALLABLE_CONTRACT_ZERO_DISALLOWED, "")
PGY_CALLABLE_CONTRACT_EFFECT(EFFECT_UNSAFE_WORD, 13, "unsafe", EFFECT_UNSAFE, 4, PGY_CALLABLE_CONTRACT_ZERO_DISALLOWED, "")
PGY_CALLABLE_CONTRACT_EFFECT(EFFECT_IO_WORD, 14, "io", EFFECT_IO, 5, PGY_CALLABLE_CONTRACT_ZERO_DISALLOWED, "")
PGY_CALLABLE_CONTRACT_EFFECT(EFFECT_ALLOC_WORD, 15, "alloc", EFFECT_ALLOC, 6, PGY_CALLABLE_CONTRACT_ZERO_DISALLOWED, "")
PGY_CALLABLE_CONTRACT_EFFECT(EFFECT_AUTHORITY_WORD, 16, "authority", EFFECT_AUTHORITY, 7, PGY_CALLABLE_CONTRACT_ZERO_DISALLOWED, "")
PGY_CALLABLE_CONTRACT_EFFECT(EFFECT_LOCAL_WORD, 17, "local", EFFECT_NONE, 8, PGY_CALLABLE_CONTRACT_ZERO_EXCLUSIVE, "")
