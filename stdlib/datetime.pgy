export class LocalDate
{
    let year: Int;
    let month: Int;
    let day: Int;

    func Key(self) -> Int
    {
        return year * 10000 + month * 100 + day;
    }

    func Format(self) -> String
    {
        return ToString(year) + "-" + ToString(month) + "-" + ToString(day);
    }
}

export class LocalTime
{
    let hour: Int;
    let minute: Int;

    func Format(self) -> String
    {
        return ToString(hour) + ":" + ToString(minute);
    }
}

export class DateTime
{
    let date: LocalDate;
    let time: LocalTime;

    func Format(self) -> String
    {
        return date.Format() + " " + time.Format();
    }

    func IsOnDate(self, target: LocalDate) -> Bool
    {
        return date.year == target.year
            && date.month == target.month
            && date.day == target.day;
    }
}

export class Duration
{
    let milliseconds: Int;

    func Format(self) -> String
    {
        return ToString(milliseconds) + "ms";
    }
}

export class Instant
{
    let milliseconds: Int;

    func Add(self, delta: Duration) -> Instant
    {
        return Instant(milliseconds + delta.milliseconds);
    }

    func Since(self, earlier: Instant) -> Duration
    {
        return Duration(milliseconds - earlier.milliseconds);
    }

    func Reached(self, deadline: Instant) -> Bool
    {
        return milliseconds >= deadline.milliseconds;
    }
}

export func SameDate(a: LocalDate, b: LocalDate) -> Bool
{
    return a.year == b.year
        && a.month == b.month
        && a.day == b.day;
}

export func FormatDate(date: LocalDate) -> String
{
    return date.Format();
}

export func FormatTime(time: LocalTime) -> String
{
    return time.Format();
}

export func FormatDateTime(at: DateTime) -> String
{
    return at.Format();
}

export func DateTimeOnDate(at: DateTime, date: LocalDate) -> Bool
{
    return at.IsOnDate(date);
}

export func DurationMs(ms: Int) -> Duration
{
    return Duration(ms);
}

export func DurationSeconds(seconds: Int) -> Duration
{
    return Duration(seconds * 1000);
}

export func DurationMinutes(minutes: Int) -> Duration
{
    return DurationSeconds(minutes * 60);
}

export func FormatDuration(delta: Duration) -> String
{
    return delta.Format();
}

export func InstantNow() -> Instant
{
    return Instant(Now());
}

export func InstantAdd(at: Instant, delta: Duration) -> Instant
{
    return at.Add(delta);
}

export func DurationBetween(start: Instant, end: Instant) -> Duration
{
    return Duration(end.milliseconds - start.milliseconds);
}

export func DeadlineReached(now: Instant, deadline: Instant) -> Bool
{
    return now.Reached(deadline);
}
