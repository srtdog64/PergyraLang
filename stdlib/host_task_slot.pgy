export enum HostTaskApplyPolicy
{
    HostTaskSpawn,
    HostTaskRestart,
    HostTaskSkip
}

export class HostTaskTicket
{
    let key: String;
    let generation: Int;
}

export class HostTaskSlot
{
    let key: String;
    let generation: Int;
    let phase: Int;
    let waitOutcome: String;
    let finalOutcome: String;
}

export class HostTaskSlotTransition
{
    let slot: HostTaskSlot;
    let ticket: HostTaskTicket;
    let applied: Bool;
    let reason: String;
}

export class HostTaskPolicyDecision
{
    let transition: HostTaskSlotTransition;
    let policy: HostTaskApplyPolicy;
    let status: String;
}

namespace HostTasks {
    func RunningPhase() -> Int { return 1; }
    func WaitingPhase() -> Int { return 2; }
    func FinalPhase() -> Int { return 3; }
    func VacantPhase() -> Int { return 4; }
    func MaxGeneration() -> Int { return 2147483647; }

    func PolicyKnown(policy: HostTaskApplyPolicy) -> Bool
    {
        return policy == HostTaskSpawn
            || policy == HostTaskRestart
            || policy == HostTaskSkip;
    }

    func ActivePhase(phase: Int) -> Bool
    {
        return phase == RunningPhase()
            || phase == WaitingPhase()
            || phase == FinalPhase();
    }

    func GenerationValid(generation: Int) -> Bool
    {
        return generation > 0;
    }

    func GenerationCanAdvance(generation: Int) -> Bool
    {
        return GenerationValid(generation)
            && generation < MaxGeneration();
    }

    func Transition(slot: HostTaskSlot, applied: Bool, reason: String) -> HostTaskSlotTransition
    {
        return HostTaskSlotTransition(
            slot,
            HostTaskTicket(slot.key, slot.generation),
            applied,
            reason
        );
    }

    func PolicyDecision(
        transition: HostTaskSlotTransition,
        policy: HostTaskApplyPolicy,
        status: String
    ) -> HostTaskPolicyDecision
    {
        return HostTaskPolicyDecision(transition, policy, status);
    }

    func RejectTicket(slot: HostTaskSlot, ticket: HostTaskTicket) -> String
    {
        if ticket.key != slot.key {
            return "wrong_key";
        }
        if ticket.generation != slot.generation {
            return "stale_generation";
        }
        if slot.key == "" {
            return "invalid_key";
        }
        if !GenerationValid(slot.generation) {
            return "invalid_generation";
        }
        if slot.phase == VacantPhase() {
            return "inactive_slot";
        }
        if !ActivePhase(slot.phase) {
            return "invalid_phase";
        }
        return "";
    }

    export func Open(key: String) -> HostTaskSlotTransition
    {
        if key == "" {
            return Transition(HostTaskSlot("", 0, VacantPhase(), "", ""), false, "invalid_key");
        }
        return Transition(HostTaskSlot(key, 1, RunningPhase(), "", ""), true, "applied");
    }

    export func Ticket(slot: HostTaskSlot) -> HostTaskTicket
    {
        return HostTaskTicket(slot.key, slot.generation);
    }

    export func SpawnPolicy() -> HostTaskApplyPolicy { return HostTaskSpawn; }
    export func RestartPolicy() -> HostTaskApplyPolicy { return HostTaskRestart; }
    export func SkipPolicy() -> HostTaskApplyPolicy { return HostTaskSkip; }

    export func ApplyPolicy(
        slot: HostTaskSlot,
        policy: HostTaskApplyPolicy
    ) -> HostTaskPolicyDecision
    {
        if !PolicyKnown(policy) {
            return PolicyDecision(
                Transition(slot, false, "invalid_policy"),
                policy,
                "rejected"
            );
        }
        if slot.key == "" {
            return PolicyDecision(
                Transition(slot, false, "invalid_key"),
                policy,
                "rejected"
            );
        }
        if !GenerationValid(slot.generation) {
            return PolicyDecision(
                Transition(slot, false, "invalid_generation"),
                policy,
                "rejected"
            );
        }
        if slot.phase == VacantPhase() {
            if !GenerationCanAdvance(slot.generation) {
                return PolicyDecision(
                    Transition(slot, false, "generation_exhausted"),
                    policy,
                    "rejected"
                );
            }
            let started: HostTaskSlot = HostTaskSlot(
                slot.key,
                slot.generation + 1,
                RunningPhase(),
                "",
                ""
            );
            return PolicyDecision(
                Transition(started, true, "applied"),
                policy,
                "started"
            );
        }
        if !ActivePhase(slot.phase) {
            return PolicyDecision(
                Transition(slot, false, "invalid_phase"),
                policy,
                "rejected"
            );
        }
        if policy == HostTaskSkip {
            return PolicyDecision(
                Transition(slot, false, "skipped"),
                policy,
                "skipped"
            );
        }
        if policy == HostTaskSpawn {
            return PolicyDecision(
                Transition(slot, false, "task_already_exists"),
                policy,
                "rejected"
            );
        }
        if !GenerationCanAdvance(slot.generation) {
            return PolicyDecision(
                Transition(slot, false, "generation_exhausted"),
                policy,
                "rejected"
            );
        }
        let restarted: HostTaskSlot = HostTaskSlot(
            slot.key,
            slot.generation + 1,
            RunningPhase(),
            "",
            ""
        );
        return PolicyDecision(
            Transition(restarted, true, "applied"),
            policy,
            "restarted"
        );
    }

    export func IsCurrent(slot: HostTaskSlot, ticket: HostTaskTicket) -> Bool
    {
        return ticket.key == slot.key
            && ticket.generation == slot.generation
            && slot.key != ""
            && GenerationValid(slot.generation)
            && ActivePhase(slot.phase);
    }

    export func Replace(slot: HostTaskSlot, key: String) -> HostTaskSlotTransition
    {
        if key == "" || key != slot.key {
            return Transition(slot, false, "invalid_key");
        }
        if slot.phase == VacantPhase() {
            return Transition(slot, false, "inactive_slot");
        }
        let decision: HostTaskPolicyDecision = ApplyPolicy(slot, RestartPolicy());
        return decision.transition;
    }

    export func PublishWait(
        slot: HostTaskSlot,
        ticket: HostTaskTicket,
        outcome: String
    ) -> HostTaskSlotTransition
    {
        let rejected: String = RejectTicket(slot, ticket);
        if rejected != "" {
            return Transition(slot, false, rejected);
        }
        if slot.phase != RunningPhase() && slot.phase != WaitingPhase() {
            return Transition(slot, false, "invalid_phase");
        }
        return Transition(
            HostTaskSlot(slot.key, slot.generation, WaitingPhase(), outcome, ""),
            true,
            "applied"
        );
    }

    export func PublishFinal(
        slot: HostTaskSlot,
        ticket: HostTaskTicket,
        outcome: String
    ) -> HostTaskSlotTransition
    {
        let rejected: String = RejectTicket(slot, ticket);
        if rejected != "" {
            return Transition(slot, false, rejected);
        }
        if slot.phase != RunningPhase() && slot.phase != WaitingPhase() {
            return Transition(slot, false, "invalid_phase");
        }
        return Transition(
            HostTaskSlot(slot.key, slot.generation, FinalPhase(), slot.waitOutcome, outcome),
            true,
            "applied"
        );
    }

    export func Cleanup(
        slot: HostTaskSlot,
        ticket: HostTaskTicket
    ) -> HostTaskSlotTransition
    {
        let rejected: String = RejectTicket(slot, ticket);
        if rejected != "" {
            return Transition(slot, false, rejected);
        }
        if slot.phase != FinalPhase() {
            return Transition(slot, false, "invalid_phase");
        }
        return Transition(
            HostTaskSlot(slot.key, slot.generation, VacantPhase(), slot.waitOutcome, slot.finalOutcome),
            true,
            "applied"
        );
    }

    export func Phase(slot: HostTaskSlot) -> String
    {
        if slot.phase == RunningPhase() { return "running"; }
        if slot.phase == WaitingPhase() { return "waiting"; }
        if slot.phase == FinalPhase() { return "final"; }
        if slot.phase == VacantPhase() { return "vacant"; }
        return "invalid";
    }
}
