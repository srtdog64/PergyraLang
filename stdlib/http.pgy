class HttpRequest {
    let method: String;
    let path: String;
    let body: String;
    let traceId: Int;
}

class HttpResponse {
    let status: Int;
    let contentType: String;
    let body: String;
}

tobject HttpIntentRequest
{
    let intentName: String;
    let actorKey: String;
    let request: HttpRequest;
}

tobject HttpIntentResponse
{
    let ok: Bool;
    let intentName: String;
    let handle: Int;
    let failed: Bool;
    let stepCount: Int;
    let response: HttpResponse;
}

class RouteSpec {
    let method: String;
    let path: String;
}

func PostJson(path: String, body: String, traceId: Int) -> HttpRequest {
    return HttpRequest("POST", path, body, traceId);
}

func OkResponse(body: String) -> HttpResponse {
    return HttpResponse(200, "text/plain", body);
}

func ErrorResponse(status: Int, body: String) -> HttpResponse {
    return HttpResponse(status, "text/plain", body);
}

func JsonResponse(body: String) -> HttpResponse {
    return HttpResponse(200, "application/json", body);
}

func BuildIntentRequest(intentName: String, actorKey: String, request: HttpRequest) -> HttpIntentRequest
{
    return HttpIntentRequest(intentName, actorKey, request);
}

func BuildIntentResponse(
    ok: Bool,
    intentName: String,
    handle: Int,
    failed: Bool,
    stepCount: Int,
    response: HttpResponse
) -> HttpIntentResponse
{
    return HttpIntentResponse(ok, intentName, handle, failed, stepCount, response);
}

func RequestMatches(request: HttpRequest, route: RouteSpec) -> Bool {
    return request.method == route.method && request.path == route.path;
}

func RenderHttpRequest(request: HttpRequest) -> String
{
    return "[HTTP] " + request.method
        + " " + request.path
        + " trace=" + ToString(request.traceId)
        + " body=" + request.body;
}

func RenderHttpResponse(response: HttpResponse) -> String
{
    return "[HTTP] status=" + ToString(response.status)
        + " type=" + response.contentType
        + " body=" + response.body;
}
