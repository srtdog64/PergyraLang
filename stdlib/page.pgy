class PageRoute
{
    let path: String;
    let title: String;
    
    func Description(self) -> String
    {
        return f"{title} ({path})";
    }
    
    func Format(self) -> String
    {
        return f"[Route] {title} -> {path}";
    }
}

class PageAction
{
    let name: String;
    let endpoint: String;
    
    func Dispatch(self, payload: String) -> String
    {
        return f"[Action] {name} -> {endpoint} payload={payload}";
    }
    
    func Format(self) -> String
    {
        return f"[Action] {name} -> {endpoint}";
    }
}

class PageMessage
{
    let level: String;
    let body: String;
    
    func IsError(self) -> Bool
    {
        return level == "error" || level == "critical";
    }
    
    func IsSuccess(self) -> Bool
    {
        return level == "success" || level == "info";
    }
    
    func Format(self) -> String
    {
        return f"[{level}] {body}";
    }
}

func MountPage(route: PageRoute) -> String {
    return f"[Page] mounted: {route.Description()}";
}

func NavigatePage(route: PageRoute) -> String {
    return f"[Page] navigate: {route.Description()}";
}

func BindAction(action: PageAction) -> String {
    return action.Format();
}

func RenderMessage(message: PageMessage) -> String {
    return message.Format();
}

func RenderSection(title: String, body: String) -> String {
    return f"== {title} ==\n{body}";
}
