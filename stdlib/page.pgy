class PageRoute
{
    let path: String;
    let title: String;
    
    func Description(self) -> String
    {
        return title + " (" + path + ")";
    }
    
    func Format(self) -> String
    {
        return "[Route] " + title + " -> " + path;
    }
}

class PageAction
{
    let name: String;
    let endpoint: String;
    
    func Dispatch(self, payload: String) -> String
    {
        return "[Action] " + name + " -> " + endpoint + " payload=" + payload;
    }
    
    func Format(self) -> String
    {
        return "[Action] " + name + " -> " + endpoint;
    }
}

class PageMessage
{
    let level: String;
    let body: String;
    
    func IsError(self) -> Bool
    {
        return self.level == "error" || self.level == "critical";
    }
    
    func IsSuccess(self) -> Bool
    {
        return self.level == "success" || self.level == "info";
    }
    
    func Format(self) -> String
    {
        return "[" + level + "] " + body;
    }
}

func MountPage(route: PageRoute) -> String {
    return "[Page] mounted: " + route.Description();
}

func NavigatePage(route: PageRoute) -> String {
    return "[Page] navigate: " + route.Description();
}

func BindAction(action: PageAction) -> String {
    return action.Format();
}

func RenderMessage(message: PageMessage) -> String {
    return message.Format();
}

func RenderSection(title: String, body: String) -> String {
    return "== " + title + " ==\n" + body;
}
