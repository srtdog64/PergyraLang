class TimerSpec
{
    let name: String;
    let startedAtMs: Long;
    let dueAtMs: Long;
    let intervalMs: Long;
    let repeating: Bool;
}

func TimerAfter(name: String, nowMs: Long, delayMs: Long) -> TimerSpec
{
    return TimerSpec(name, nowMs, nowMs + delayMs, delayMs, false);
}

func TimerEvery(name: String, nowMs: Long, intervalMs: Long) -> TimerSpec
{
    return TimerSpec(name, nowMs, nowMs + intervalMs, intervalMs, true);
}

func TimerExpired(timer: TimerSpec, nowMs: Long) -> Bool
{
    return nowMs >= timer.dueAtMs;
}

func TimerRemaining(timer: TimerSpec, nowMs: Long) -> Long
{
    if nowMs >= timer.dueAtMs {
        return 0;
    }
    return timer.dueAtMs - nowMs;
}

func TimerTick(timer: TimerSpec, nowMs: Long) -> TimerSpec
{
    if !timer.repeating {
        return timer;
    }
    if nowMs < timer.dueAtMs {
        return timer;
    }
    return TimerSpec(timer.name, timer.startedAtMs, nowMs + timer.intervalMs, timer.intervalMs, timer.repeating);
}

func RenderTimer(timer: TimerSpec) -> String
{
    return "[timer] " + timer.name
        + " due=" + ToString(timer.dueAtMs)
        + " interval=" + ToString(timer.intervalMs)
        + " repeating=" + ToString(timer.repeating);
}
