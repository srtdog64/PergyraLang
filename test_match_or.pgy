// Test: enum match with OR patterns

enum Direction {
    North,
    South,
    East,
    West,
}

func DirectionType(dir: Direction) -> String {
    match dir {
        case North | South:
            return "vertical";
        case East | West:
            return "horizontal";
    }
}

func Main() -> Void {
    let d: Direction = North;
    Log(DirectionType(d));
    
    let d2: Direction = East;
    Log(DirectionType(d2));
}
