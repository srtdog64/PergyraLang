// Slot axis with token capability: token validated against runtime slot identity.
// Authority is a RUNTIME fact -> bucket B (by-design fail-closed), not erasable.
// No hardware/encrypted policy is requested or proved by this no-argument claim.
func Main() -> Void {
    let (hp, token) = ClaimSecureSlot<Int>();
    Write(hp, 100, token);
    let v: Int = Read(hp, token);
    Log(v);
    Release(hp, token);
}
