// Parity probe for the 1+arg runtime aggregate-return ABI: StringSplit returns
// Array<String> by value at the source/runtime boundary and LLVM consumes it
// through the aggregate-return sret owner.
let parts: Array<String> = StringSplit("a,bb,ccc,dddd", ",");
let n: Int = 0;
let total: Int = 0;
for p in parts {
    n = n + 1;
    total = total + StringLength(p);
}
Log("parts:");
Log(ToString(n));
Log("total-len:");
Log(ToString(total));
