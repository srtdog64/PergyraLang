func ValueParam(x: Int) -> Int {
    return x;
}

func ReadParam(ref x: Int) -> Int {
    return x;
}

func ValueResultParam(inout x: Int) -> Void {
    x = x + 1;
}

func OwnerParam(own values: Array<Int>) -> Int {
    return ArrayLength(values);
}

func ReadAggregate(ref pair: Pair) -> Int {
    return pair.left + pair.right;
}

func Main() -> Void {
    let x: Int = 1;
    let values: Array<Int> = [1, 2];
    let pair: Pair = Pair(20, 22);
    Log(ToString(ValueParam(x)));
    Log(ToString(ReadParam(x)));
    ValueResultParam(x);
    Log(ToString(OwnerParam(values)));
    Log(ToString(ReadAggregate(pair)));
}
struct Pair {
    left: Int;
    right: Int;
}
