within PaymentZone {
    subject Buyer {
        let hp: Int;

        action Promote(self) -> Void
            authorized by self
            causes Charged
        {
            hp = hp + 2;
        }
    }
}

effect Charged for bearer: Buyer { }

zone CartZone {
    subject slot buyer: Buyer
    authority buyer
}

zone PaymentZone {
    subject slot buyer: Buyer
    effect slot charged: Charged
    authority buyer
    state chargedState: effect charged on buyer

    func Report(self) -> Void {
        Log(HasLayer(charged));
        Log(HasState(chargedState, buyer));
    }
}

world CheckoutWorld {
    zone cart: CartZone
    zone payment: PaymentZone
    state paymentLayer: zone payment layer charged
    state paymentCharged: zone payment state chargedState
    state ready: all paymentLayer, paymentCharged
    activate payment

    func Report(self) -> Void {
        Log(HasZoneLayer(payment, charged));
        Log(HasZoneState(payment, chargedState));
        Log(HasZone(paymentLayer));
        Log(HasZone(paymentCharged));
        Log(HasZone(ready));
        Log(payment.buyer.hp);
    }

    func Run(self) -> Bool {
        return Checkout(cart, payment, cart.buyer);
    }

    func ReportPayment(self) -> Void {
        payment.Report();
    }
}

intent Checkout(cart: CartZone, payment: PaymentZone, buyer: Buyer) {
    step Handoff {
        where: PaymentZone;
        using: payment;
        transfer: cart -> payment;
        who: buyer;
        authorized by: buyer;
        on: buyer.Promote();
        expect: payment.buyer.hp == 7;
    }

    success: true;
    failure: false;
}

func Main() -> Void {
    let world = CheckoutWorld(CartZone(Buyer(5)), PaymentZone(Buyer(0)));

    world.Report();
    let ok = world.Run();
    Log(ok);
    world.ReportPayment();
    world.Report();
}
