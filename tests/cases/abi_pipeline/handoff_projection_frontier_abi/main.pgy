subject Buyer {
    let hp: Int;
    action Promote(self) -> Void {
        hp = hp + 2;
    }
}

object BuyerView {
    hp: Int;
}

zone CartZone {
    subject slot buyer: Buyer
    object slot mirror: BuyerView
    authority buyer
    bind mirror from buyer by buyer

    func Ready(self) -> Bool {
        return HasProjection(mirror);
    }

    func MirrorHp(self) -> Int {
        return mirror.hp;
    }
}

zone PaymentZone {
    subject slot buyer: Buyer
    object slot receipt: BuyerView
    authority buyer
    bind receipt from buyer by buyer

    func Ready(self) -> Bool {
        return HasProjection(receipt);
    }

    func ReceiptHp(self) -> Int {
        return receipt.hp;
    }
}

intent Checkout(cart: CartZone, payment: PaymentZone, buyer: Buyer) {
    step Handoff {
        where: PaymentZone;
        using: payment;
        transfer: cart -> payment;
        who: buyer;
        authorized by: buyer;
        on: buyer.Promote();
        expect: payment.Ready() && payment.receipt.hp == 7;
    }

    success: true;
    failure: false;
}

func Main() -> Void {
    let cart = CartZone(Buyer(5));
    let payment = PaymentZone(Buyer(0));

    Log(cart.Ready());
    Log(cart.MirrorHp());
    Log(payment.Ready());
    Log(payment.ReceiptHp());

    let ok = Checkout(cart, payment, cart.buyer);
    Log(ok);
    Log(cart.Ready());
    Log(cart.MirrorHp());
    Log(payment.Ready());
    Log(payment.ReceiptHp());
}
