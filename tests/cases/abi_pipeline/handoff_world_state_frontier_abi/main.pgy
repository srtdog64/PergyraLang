subject Buyer {
    let hp: Int;
    action Promote(self) -> Void {
        hp = hp + 2;
    }
}

object BuyerView {
    hp: Int;
}

zone CartZone {
    subject slot buyer: Buyer
    object slot mirror: BuyerView = BuyerView(0)
    authority buyer
    bind mirror from buyer by buyer
}

zone PaymentZone {
    subject slot buyer: Buyer
    object slot receipt: BuyerView = BuyerView(0)
    authority buyer
    bind receipt from buyer by buyer
}

world CheckoutWorld {
    zone cart: CartZone
    zone payment: PaymentZone
    state cartReady: zone cart projection mirror
    state paymentReady: zone payment projection receipt
    state bothReady: all cartReady, paymentReady
    activate cart
    activate payment

    func Report(self) -> Void {
        Log(HasZone(cartReady));
        Log(HasZone(paymentReady));
        Log(HasZone(bothReady));
        Log(HasZoneProjection(payment, receipt));
        Log(payment.receipt.hp);
    }

    func Run(self) -> Bool {
        return Checkout(cart, payment, cart.buyer);
    }
}

intent Checkout(cart: CartZone, payment: PaymentZone, buyer: Buyer) {
    step Handoff {
        where: PaymentZone;
        using: payment;
        transfer: cart -> payment;
        who: buyer;
        authorized by: buyer;
        on: buyer.Promote();
        expect: payment.receipt.hp == 7;
    }

    success: true;
    failure: false;
}

func Main() -> Void {
    let world = CheckoutWorld(
        CartZone(Buyer(5), BuyerView(0)),
        PaymentZone(Buyer(0), BuyerView(0)));

    world.Report();
    let ok = world.Run();
    Log(ok);
    world.Report();
}
