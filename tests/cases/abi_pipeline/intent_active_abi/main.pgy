subject Buyer {
    let hp: Int;
    action Verify(self) -> Void {
        let current: Int = IntentCurrentHandle();
        Log(ToString(current >= 0));
        Log(ToString(IntentActiveStepCount(0) == 1));
        Log(IntentActiveStepName(current, 0));
        Log(IntentActiveStepZone(current, 0));
        Log(IntentActiveStepParticipant(current, 0));
        Log(ToString(StringLength(IntentActiveStepPhase(current, 0)) > 0));
        Log(ToString(StringLength(IntentActiveStepFailure(current, 0)) == 0));
        return;
    }
}
zone CheckoutZone {
    subject slot buyer: Buyer
}
intent Charge(checkout: CheckoutZone, buyer: Buyer) {
    step verify {
        where: CheckoutZone;
        using: checkout;
        who: buyer;
        on: buyer.Verify();
        expect: true;
    }
    success: true;
    failure: false;
}
func Main() -> Void {
    let buyer: Buyer = Buyer(1);
let checkout: CheckoutZone = CheckoutZone(Buyer(1));
    Log(Charge(checkout, buyer));
    Log(ToString(IntentHistoryCount()));
}
