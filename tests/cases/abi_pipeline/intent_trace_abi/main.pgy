subject Buyer {
    let hp: Int;
    action Verify(self) -> Void { }
}
zone CheckoutZone {
    subject slot buyer: Buyer
}
intent Charge(checkout: CheckoutZone, buyer: Buyer) {
    step verify {
        where: CheckoutZone;
        using: checkout;
        who: buyer;
        on: buyer.Verify();
        expect: true;
    }
    success: true;
    failure: false;
}
func Main() -> Void {
    let buyer: Buyer = Buyer(1);
    let checkout: CheckoutZone = CheckoutZone(buyer);
    let ok: Bool = Charge(checkout, buyer);
    Log(ok);
    Log(ToString(IntentLastStepCount()));
    Log(ToString(IntentHistoryCount()));
    Log(ToString(IntentLastFailed()));
    Log(ToString(IntentRecentCount()));
    Log(IntentRecentName(0));
    Log(ToString(IntentRecentStepCount(0)));
    Log(ToString(IntentRecentFailed(0)));
}
