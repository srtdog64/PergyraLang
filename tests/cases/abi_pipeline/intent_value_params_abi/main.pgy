subject Buyer {
    let hp: Int;
    action Pay(self) -> Void { }
}

zone CheckoutZone {
    subject slot buyer: Buyer
}

intent Checkout(checkout: CheckoutZone, buyer: Buyer, price: Int, adjustments: Array<Int>) {
    step pay {
        where: CheckoutZone;
        using: checkout;
        who: buyer;
        guard: price > 0;
        expect: ArrayLength(adjustments) == 2;
        on: buyer.Pay();
    }
    success: true;
    failure: false;
}

func Main() -> Void {
    let buyer: Buyer = Buyer(5);
    let checkout: CheckoutZone = CheckoutZone(buyer);
    Log(Checkout(checkout, buyer, 9, [2, 7]));
    Log(ToString(IntentRecentCount()));
    Log(IntentRecentName(0));
    Log(ToString(IntentRecentStepCount(0)));
    Log(ToString(IntentRecentFailed(0)));
}
