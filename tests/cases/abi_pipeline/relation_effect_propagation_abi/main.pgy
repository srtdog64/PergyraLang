subject Player {
    let hp: Int;
}
object PlayerView {
    hp: Int;
}
effect Poisoned for bearer: Player { }
relation Allied for source: Player, target: Player { }
zone ArenaZone {
    subject slot player: Player
    subject slot ally: Player
    object slot playerView: PlayerView
    effect slot poison: Poisoned
    relation slot alliance: Allied
    authority player
    state poisoned: effect poison on player
    state allied: relation alliance between player, ally
    refresh playerView from player by player
    maintain poisoned by player
    maintain allied by player
    func Pulse() -> Void {
        player.hp = player.hp + 3;
    }
    func Report() -> Void {
        Log(HasLayer(poison));
        Log(HasState(poisoned, player));
        Log(HasState(allied, player, ally));
        Log(playerView.hp);
    }
}
func Main() -> Void {
    let arena = ArenaZone(Player(40), Player(7));
    arena.Pulse();
    arena.Report();
}
