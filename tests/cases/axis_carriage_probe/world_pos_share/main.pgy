// axis-carriage probe — World x positional, sharing/laundering leg.
// One live zone value is planted into TWO worlds. Verdict space:
//   static reject   -> world membership boundary exists today
//   runs 7 / 5      -> copy semantics at world construction
//   runs 7 / 7      -> alias: world boundary is silent for zone values
subject Buyer {
    let hp: Int;
    action Promote(self) -> Void {
        hp = hp + 2;
    }
}

object BuyerView {
    hp: Int;
}

zone CartZone {
    subject slot buyer: Buyer
    object slot mirror: BuyerView
    authority buyer
    bind mirror from buyer by buyer
}

world SoloWorld {
    zone cart: CartZone
    activate cart

    func Poke(self) -> Void {
        cart.buyer.Promote();
    }

    func Report(self) -> Void {
        Log(cart.buyer.hp);
    }
}

func Main() -> Void {
    let cz = CartZone(Buyer(5));
    let w1 = SoloWorld(cz);
    let w2 = SoloWorld(cz);

    w1.Poke();
    w1.Report();
    w2.Report();
}
