// (World x Intent) composition probe — CROSS-WORLD leg.
// The distributed-design principle says cross-World movement is
// Channel-only. This kernel asks: can an intent transfer step be aimed
// at zones owned by two DIFFERENT worlds, bypassing Channel?
// MEASURED HISTORY: 2026-07-04 it RAN silently with asymmetric
// write-through (2/1/2 — dest world interior mutated without a Channel).
// CLOSED 2026-07-05 (full theorem T, docs/157 §5): world-owned zone
// bindings cannot escape as live values — this file is now the REJECT
// regression fixture ("cannot escape as a live binding"), locked by
// tests/axis_composition_smoke.sh.
subject Buyer {
    let mut hp: Int;
    action Promote(self) -> Void {
        self.hp = self.hp + 1;
    }
}

zone CartZone {
    subject slot buyer: Buyer
}

zone PaymentZone {
    subject slot buyer: Buyer
}

world CartWorld {
    zone cart: CartZone

    func Hp(self) -> Int {
        return cart.buyer.hp;
    }
}

world PayWorld {
    zone payment: PaymentZone

    func Hp(self) -> Int {
        return payment.buyer.hp;
    }
}

intent Checkout(cart: CartZone, payment: PaymentZone, buyer: Buyer) {
    step Promote {
        transfer: cart -> payment;
        on: buyer.Promote();
        expect: true;
    }
}

func Main() -> Void {
    let w1 = CartWorld(CartZone(Buyer(1)));
    let w2 = PayWorld(PaymentZone(Buyer(1)));
    let buyer = Buyer(1);
    Checkout(w1.cart, w2.payment, buyer);
    Log(buyer.hp);
    Log(w1.Hp());
    Log(w2.Hp());
}
