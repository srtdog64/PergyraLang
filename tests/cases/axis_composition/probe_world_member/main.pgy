// AC-3 premise probe P-B: what does `w.zone` member read actually hand out?
// MEASURED 2026-07-04: let-init detached a copy (2/1) while transfer-arg
// position aliased — per-position accidental semantics. CLOSED 2026-07-05
// (full theorem T, docs/157 §5): any live escape of a world-owned zone is
// a STATIC reject — this file is now the let-init REJECT regression
// fixture ("cannot escape as a live binding"), locked by
// tests/axis_composition_smoke.sh. The declared form is Clone(w.cart).
subject Buyer {
    let mut hp: Int;
    action Promote(self) -> Void {
        self.hp = self.hp + 1;
    }
}

zone CartZone {
    subject slot buyer: Buyer
}

world CartWorld {
    zone cart: CartZone

    func Hp(self) -> Int {
        return cart.buyer.hp;
    }
}

func Main() -> Void {
    let w = CartWorld(CartZone(Buyer(1)));
    let escaped = w.cart;
    escaped.buyer.Promote();
    Log(escaped.buyer.hp);
    Log(w.Hp());
}
