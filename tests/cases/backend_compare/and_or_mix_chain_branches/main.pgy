func Classify(a: Int, b: Int, c: Int) -> Int {
    if a > 0 && b > 0 && c > 0 {
        return 3;
    }
    if a > 0 && b > 0 || c > 0 {
        return 2;
    }
    if (a > 0 || b > 0) && c > 0 {
        return 1;
    }
    return 0;
}

func Main() -> Void {
    Log(Classify(1, 1, 1));
    Log(Classify(1, 1, -1));
    Log(Classify(1, -1, 1));
    Log(Classify(-1, -1, 1));
    Log(Classify(-1, -1, -1));
    Log(Classify(0, 0, 0));
    Log(Classify(-1, 1, 1));
}
