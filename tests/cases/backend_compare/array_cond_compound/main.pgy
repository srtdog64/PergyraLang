func CountPos(arr: Array<Int>, n: Int) -> Int {
    let c: Int = 0;
    let i: Int = 0;
    while arr[i] > 0 && i < n {
        c = c + 1;
        i = i + 1;
    }
    return c;
}

func SumNonNeg(arr: Array<Int>, flags: Array<Bool>, n: Int) -> Int {
    let total: Int = 0;
    let i: Int = 0;
    while i < n {
        if flags[i] && arr[i] >= 0 {
            total = total + arr[i];
        }
        i = i + 1;
    }
    return total;
}

func Main() -> Void {
    let a: Array<Int> = [3, 5, 2, -1, 7, 9];
    Log(CountPos(a, 6));
    let b: Array<Int> = [-1, 2, 3];
    Log(CountPos(b, 3));
    let nums: Array<Int> = [10, -5, 20, 30, -7, 40];
    let flags: Array<Bool> = [true, true, false, true, true, false];
    Log(SumNonNeg(nums, flags, 6));
}
