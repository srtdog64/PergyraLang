func CountInversions(arr: Array<Int>, n: Int) -> Int {
    let count: Int = 0;
    let i: Int = 0;
    while i < n {
        let j: Int = i + 1;
        while j < n {
            if arr[i] > arr[j] { count = count + 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    return count;
}

func Main() -> Void {
    let a: Array<Int> = [1, 2, 3, 4, 5];
    Log(CountInversions(a, 5));
    let b: Array<Int> = [5, 4, 3, 2, 1];
    Log(CountInversions(b, 5));
    let c: Array<Int> = [3, 1, 4, 1, 5];
    Log(CountInversions(c, 5));
    let d: Array<Int> = [];
    Log(CountInversions(d, 0));
}
