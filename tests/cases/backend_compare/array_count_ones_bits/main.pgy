func PopCount(n: Int) -> Int {
    let v: Int = n;
    if v < 0 { return -1; }
    let count: Int = 0;
    while v > 0 {
        if v % 2 == 1 { count = count + 1; }
        v = v / 2;
    }
    return count;
}

func TotalPopCount(arr: Array<Int>, n: Int) -> Int {
    let sum: Int = 0;
    let i: Int = 0;
    while i < n {
        sum = sum + PopCount(arr[i]);
        i = i + 1;
    }
    return sum;
}

func Main() -> Void {
    Log(PopCount(0));
    Log(PopCount(1));
    Log(PopCount(7));
    Log(PopCount(255));
    Log(PopCount(-1));
    let a: Array<Int> = [1, 2, 3, 4, 5, 6, 7, 8];
    Log(TotalPopCount(a, 8));
}
