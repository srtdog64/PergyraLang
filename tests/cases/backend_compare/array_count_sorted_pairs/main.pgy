func CountAscPairs(arr: Array<Int>, n: Int) -> Int {
    let count: Int = 0;
    let i: Int = 0;
    while i < n - 1 {
        if arr[i] < arr[i + 1] { count = count + 1; }
        i = i + 1;
    }
    return count;
}

func CountAscTriples(arr: Array<Int>, n: Int) -> Int {
    let count: Int = 0;
    let i: Int = 0;
    while i < n - 2 {
        if arr[i] < arr[i + 1] && arr[i + 1] < arr[i + 2] { count = count + 1; }
        i = i + 1;
    }
    return count;
}

func Main() -> Void {
    let a: Array<Int> = [1, 2, 3, 4, 5];
    Log(CountAscPairs(a, 5));
    Log(CountAscTriples(a, 5));
    let b: Array<Int> = [5, 4, 3, 2, 1];
    Log(CountAscPairs(b, 5));
    Log(CountAscTriples(b, 5));
    let c: Array<Int> = [1, 3, 2, 4, 1, 5];
    Log(CountAscPairs(c, 6));
    Log(CountAscTriples(c, 6));
}
