func DedupSorted(inout arr: Array<Int>, n: Int) -> Int {
    if n <= 1 { return n; }
    var write: Int = 1;
    var i: Int = 1;
    while i < n {
        if arr[i] != arr[write - 1] {
            arr[write] = arr[i];
            write = write + 1;
        }
        i = i + 1;
    }
    return write;
}

func DedupSum(arr: Array<Int>, n: Int) -> Int {
    let m: Int = DedupSorted(arr, n);
    var s: Int = 0;
    var i: Int = 0;
    while i < m {
        s = s + arr[i];
        i = i + 1;
    }
    return s * 100 + m;
}

func Main() -> Void {
    let a: Array<Int> = [1, 1, 2, 2, 3, 4, 5, 5];
    Log(DedupSum(a, 8));
    let b: Array<Int> = [1, 1, 1, 1];
    Log(DedupSum(b, 4));
    let c: Array<Int> = [1, 2, 3];
    Log(DedupSum(c, 3));
    let d: Array<Int> = [];
    Log(DedupSum(d, 0));
}
