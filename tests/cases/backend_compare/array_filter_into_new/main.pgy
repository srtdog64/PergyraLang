func FilterEven(src: Array<Int>, n: Int, inout dst: Array<Int>) -> Int {
    let write: Int = 0;
    let i: Int = 0;
    while i < n {
        if src[i] % 2 == 0 {
            dst[write] = src[i];
            write = write + 1;
        }
        i = i + 1;
    }
    let sum: Int = 0;
    let k: Int = 0;
    while k < write {
        sum = sum + dst[k];
        k = k + 1;
    }
    return sum * 100 + write;
}

func Main() -> Void {
    let src: Array<Int> = [1, 2, 3, 4, 5, 6, 7, 8];
    let dst: Array<Int> = [0, 0, 0, 0, 0, 0, 0, 0];
    Log(FilterEven(src, 8, dst));
    let src2: Array<Int> = [1, 3, 5, 7];
    let dst2: Array<Int> = [0, 0, 0, 0];
    Log(FilterEven(src2, 4, dst2));
    let src3: Array<Int> = [2, 4, 6];
    let dst3: Array<Int> = [0, 0, 0];
    Log(FilterEven(src3, 3, dst3));
}
