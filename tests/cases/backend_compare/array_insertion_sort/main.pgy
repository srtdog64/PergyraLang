func InsertionSort(inout arr: Array<Int>, n: Int) -> Int {
    var i: Int = 1;
    while i < n {
        let key: Int = arr[i];
        var j: Int = i - 1;
        while j >= 0 && arr[j] > key {
            arr[j + 1] = arr[j];
            j = j - 1;
        }
        arr[j + 1] = key;
        i = i + 1;
    }
    var sum: Int = 0;
    var k: Int = 0;
    while k < n {
        sum = sum + arr[k] * (k + 1);
        k = k + 1;
    }
    return sum;
}

func Main() -> Void {
    var a: Array<Int> = [5, 2, 8, 1, 9, 3];
    Log(InsertionSort(a, 6));
    var b: Array<Int> = [1, 2, 3];
    Log(InsertionSort(b, 3));
    var c: Array<Int> = [-3, -1, -4, -2];
    Log(InsertionSort(c, 4));
}
