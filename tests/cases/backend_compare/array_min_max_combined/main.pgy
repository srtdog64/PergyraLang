func MinMaxSpan(arr: Array<Int>, n: Int) -> Int {
    if n == 0 { return 0; }
    let minv: Int = arr[0];
    let maxv: Int = arr[0];
    let i: Int = 1;
    while i < n {
        if arr[i] < minv { minv = arr[i]; }
        if arr[i] > maxv { maxv = arr[i]; }
        i = i + 1;
    }
    return maxv - minv;
}

func Main() -> Void {
    let a: Array<Int> = [3, 7, 1, 9, 4, 2, 8];
    Log(MinMaxSpan(a, 7));
    Log(MinMaxSpan(a, 3));
    Log(MinMaxSpan(a, 1));
    Log(MinMaxSpan(a, 0));
    let b: Array<Int> = [-5, -1, -10, -3];
    Log(MinMaxSpan(b, 4));
}
