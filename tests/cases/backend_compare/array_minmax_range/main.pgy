func MinMax(arr: Array<Int>, n: Int) -> Int {
    if n <= 0 { return 0; }
    let mn: Int = arr[0];
    let mx: Int = arr[0];
    let i: Int = 1;
    while i < n {
        if arr[i] < mn { mn = arr[i]; }
        if arr[i] > mx { mx = arr[i]; }
        i = i + 1;
    }
    return mx * 1000 + mn;
}

func RangeSum(arr: Array<Int>, n: Int, lo: Int, hi: Int) -> Int {
    let total: Int = 0;
    let i: Int = 0;
    while i < n {
        if arr[i] >= lo && arr[i] <= hi {
            total = total + arr[i];
        }
        i = i + 1;
    }
    return total;
}

func Main() -> Void {
    let arr: Array<Int> = [5, 3, 8, 1, 9, 4];
    Log(MinMax(arr, 6));
    Log(RangeSum(arr, 6, 3, 8));
    Log(RangeSum(arr, 6, 5, 10));
    Log(RangeSum(arr, 6, 0, 100));
    Log(RangeSum(arr, 6, 100, 200));
}
