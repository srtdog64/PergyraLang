func PrefixSumAt(arr: Array<Int>, n: Int, idx: Int) -> Int {
    if idx < 0 { return 0; }
    if idx >= n { return PrefixSumAt(arr, n, n - 1); }
    let sum: Int = 0;
    let i: Int = 0;
    while i <= idx {
        sum = sum + arr[i];
        i = i + 1;
    }
    return sum;
}

func RangeSum(arr: Array<Int>, n: Int, lo: Int, hi: Int) -> Int {
    return PrefixSumAt(arr, n, hi) - PrefixSumAt(arr, n, lo - 1);
}

func Main() -> Void {
    let a: Array<Int> = [1, 2, 3, 4, 5, 6];
    Log(PrefixSumAt(a, 6, 0));
    Log(PrefixSumAt(a, 6, 2));
    Log(PrefixSumAt(a, 6, 5));
    Log(RangeSum(a, 6, 1, 3));
    Log(RangeSum(a, 6, 0, 5));
    Log(RangeSum(a, 6, 4, 5));
}
