func SqueezeZeros(inout arr: Array<Int>, n: Int) -> Int {
    let write: Int = 0;
    let i: Int = 0;
    while i < n {
        if arr[i] != 0 {
            arr[write] = arr[i];
            write = write + 1;
        }
        i = i + 1;
    }
    let j: Int = write;
    while j < n {
        arr[j] = 0;
        j = j + 1;
    }
    let s: Int = 0;
    let k: Int = 0;
    while k < n {
        s = s + arr[k] * (k + 1);
        k = k + 1;
    }
    return s;
}

func Main() -> Void {
    let a: Array<Int> = [0, 1, 0, 2, 0, 3];
    Log(SqueezeZeros(a, 6));
    let b: Array<Int> = [1, 2, 3];
    Log(SqueezeZeros(b, 3));
    let c: Array<Int> = [0, 0, 0];
    Log(SqueezeZeros(c, 3));
    let d: Array<Int> = [];
    Log(SqueezeZeros(d, 0));
}
