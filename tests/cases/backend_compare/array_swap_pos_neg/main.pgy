func MovePositiveFirst(inout arr: Array<Int>, n: Int) -> Int {
    let write: Int = 0;
    let i: Int = 0;
    while i < n {
        if arr[i] > 0 {
            let tmp: Int = arr[write];
            arr[write] = arr[i];
            arr[i] = tmp;
            write = write + 1;
        }
        i = i + 1;
    }
    let sum: Int = 0;
    let k: Int = 0;
    while k < n {
        sum = sum + arr[k] * (k + 1);
        k = k + 1;
    }
    return sum;
}

func Main() -> Void {
    let a: Array<Int> = [1, -2, 3, -4, 5];
    Log(MovePositiveFirst(a, 5));
    let b: Array<Int> = [-1, -2, -3];
    Log(MovePositiveFirst(b, 3));
    let c: Array<Int> = [1, 2, 3];
    Log(MovePositiveFirst(c, 3));
    let d: Array<Int> = [];
    Log(MovePositiveFirst(d, 0));
}
