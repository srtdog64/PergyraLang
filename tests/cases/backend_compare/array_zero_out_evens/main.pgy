func ZeroOutEvens(arr: Array<Int>, n: Int) -> Int {
    let count: Int = 0;
    let i: Int = 0;
    while i < n {
        if arr[i] % 2 == 0 {
            arr[i] = 0;
            count = count + 1;
        }
        i = i + 1;
    }
    let sum: Int = 0;
    let k: Int = 0;
    while k < n {
        sum = sum + arr[k];
        k = k + 1;
    }
    return sum * 100 + count;
}

func Main() -> Void {
    let a: Array<Int> = [1, 2, 3, 4, 5, 6];
    Log(ZeroOutEvens(a, 6));
    let b: Array<Int> = [1, 3, 5, 7];
    Log(ZeroOutEvens(b, 4));
    let c: Array<Int> = [2, 4, 6, 8];
    Log(ZeroOutEvens(c, 4));
    let d: Array<Int> = [];
    Log(ZeroOutEvens(d, 0));
}
