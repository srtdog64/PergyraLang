func BinarySearch(arr: Array<Int>, target: Int) -> Int {
    let lo: Int = 0;
    let hi: Int = ArrayLength(arr) - 1;
    while lo <= hi {
        let mid: Int = (lo + hi) / 2;
        if arr[mid] == target { return mid; }
        if arr[mid] < target { lo = mid + 1; }
        if arr[mid] > target { hi = mid - 1; }
    }
    return -1;
}

func Main() -> Void {
    let xs: Array<Int> = [1, 3, 7, 9, 12, 18, 25, 31, 44];
    Log(BinarySearch(xs, 12));
    Log(BinarySearch(xs, 1));
    Log(BinarySearch(xs, 44));
    Log(BinarySearch(xs, 100));
    Log(BinarySearch(xs, 0));
}
