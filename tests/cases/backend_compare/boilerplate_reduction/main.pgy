// Boilerplate reduction surface that is currently closed:
// 1. subject action may omit within/authorized by/causes
// 2. intent-level who propagates to steps
// 3. step using: derives its zone contract
// 4. grouped subject slot syntax stays available in zones

ability Climber {
    fields hp: Int;
    func CanClimb() -> Bool;
}

subject Adventurer {
    let name: String;
    let mut hp: Int;

    action Climb(self) -> Void
        requires Climber
    {
        hp = hp + 1;
        return;
    }
}

role AdventurerClimber for Adventurer {
    impl ability Climber {
        func CanClimb() -> Bool {
            return true;
        }
    }
}

zone CampZone {
    subjects [camper, guide]: Adventurer

    func Rest() -> Void {
        camper.hp = camper.hp + 5;
        guide.hp = guide.hp + 1;
    }
}

intent MountainTrip(camp: CampZone, explorer: Adventurer) {
    exclusive;
    who: explorer;

    step prepare {
        using: camp;
        on: explorer.Climb();
        expect: explorer.hp == 11;
    }

    step summit {
        using: camp;
        on: explorer.Climb();
        expect: explorer.hp == 12;
    }

    success: explorer.hp == 12;
    failure: false;
}

func Main() -> Void {
    let hero = Adventurer("Alice", 10);
    let camp = CampZone(Adventurer("Bob", 5), Adventurer("Guide", 7));

    hero.Climb();
    Log("after climb hp=" + ToString(hero.hp));

    camp.Rest();
    Log("camper hp=" + ToString(camp.camper.hp));
    Log("guide hp=" + ToString(camp.guide.hp));

    let ok = MountainTrip(camp, hero);
    Log("intent ok=" + ToString(ok));
    Log("final hp=" + ToString(hero.hp));
}
