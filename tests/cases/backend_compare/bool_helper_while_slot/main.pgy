func IsEven(n: Int) -> Bool {
    return n % 2 == 0;
}

func Main() -> Void {
    let acc: Slot<Int> = ClaimSlot();
    Write(acc, 0);
    let i: Slot<Int> = ClaimSlot();
    Write(i, 0);
    while Read(i) < 6 {
        if IsEven(Read(i)) {
            Write(acc, Read(acc) + 1);
        }
        Write(i, Read(i) + 1);
    }
    Log(Read(acc));
}
