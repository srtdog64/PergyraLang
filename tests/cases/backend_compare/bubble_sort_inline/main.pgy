func BubbleSort(inout arr: Array<Int>, n: Int) -> Int {
    let i: Int = 0;
    while i < n {
        let j: Int = 0;
        while j < n - 1 - i {
            if arr[j] > arr[j + 1] {
                let tmp: Int = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = tmp;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    let sum: Int = 0;
    let k: Int = 0;
    while k < n {
        sum = sum + arr[k] * (k + 1);
        k = k + 1;
    }
    return sum;
}

func Main() -> Void {
    let nums: Array<Int> = [5, 2, 8, 1, 9, 3];
    Log(BubbleSort(nums, 6));
    let nums2: Array<Int> = [7, 7, 7];
    Log(BubbleSort(nums2, 3));
    let nums3: Array<Int> = [10];
    Log(BubbleSort(nums3, 1));
    let nums4: Array<Int> = [3, 1];
    Log(BubbleSort(nums4, 2));
}
