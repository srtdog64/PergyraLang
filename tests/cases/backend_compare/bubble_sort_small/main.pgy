func Main() -> Void {
    let xs: Array<Int> = [5, 2, 8, 1, 9, 3, 7];
    let n: Int = ArrayLength(xs);
    let i: Int = 0;
    while i < n - 1 {
        let j: Int = 0;
        while j < n - 1 - i {
            if xs[j] > xs[j + 1] {
                let tmp: Int = xs[j];
                ArraySet(xs, j, xs[j + 1]);
                ArraySet(xs, j + 1, tmp);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    let k: Int = 0;
    while k < n {
        Log(xs[k]);
        k = k + 1;
    }
}
