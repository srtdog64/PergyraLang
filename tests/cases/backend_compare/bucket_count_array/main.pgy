func Bucket(n: Int) -> Int {
    if n < 0 { return -1; }
    if n < 10 { return 0; }
    if n < 100 { return 1; }
    if n < 1000 { return 2; }
    return 3;
}

func Bucketize(arr: Array<Int>, n: Int) -> Int {
    let counts: Array<Int> = [0, 0, 0, 0, 0];
    let i: Int = 0;
    while i < n {
        let b: Int = Bucket(arr[i]) + 1;
        counts[b] = counts[b] + 1;
        i = i + 1;
    }
    return counts[0] * 10000 + counts[1] * 1000 + counts[2] * 100 + counts[3] * 10 + counts[4];
}

func Main() -> Void {
    let arr: Array<Int> = [5, -1, 50, 500, 5000, -2, 99, 999];
    Log(Bucketize(arr, 8));
    let arr2: Array<Int> = [0];
    Log(Bucketize(arr2, 1));
    let arr3: Array<Int> = [-1, -1, -1];
    Log(Bucketize(arr3, 3));
}
