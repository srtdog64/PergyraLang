func AddOne(value: Int) -> Int { return value + 1; }
func Pick(value: Int) -> Int { return value + 100; }

func BuiltinShadow(StringLength: func(Int) -> Int, value: Int) -> Int {
    return StringLength(value);
}

func GlobalShadow(Pick: func(Int) -> Int, value: Int) -> Int {
    return Pick(value);
}

func LocalShadow() -> Int {
    let before: Int = StringLength("abc");
    let StringLength: func(Int) -> Int = (value: Int) => value + 2;
    return StringLength(before);
}

func CapturedShadow() -> Int {
    let delta: Int = 3;
    let StringLength: func(Int) -> Int = (value: Int) => value + delta;
    return StringLength(5);
}

func Main() -> Void {
    Log(BuiltinShadow(AddOne, 5));
    Log(GlobalShadow(AddOne, 5));
    Log(LocalShadow());
    Log(CapturedShadow());
    if true {
        let StringLength: func(Int) -> Int = (value: Int) => value + 4;
        Log(StringLength(5));
    }
    Log(StringLength("abc"));
    Log(Pick(5));
}
