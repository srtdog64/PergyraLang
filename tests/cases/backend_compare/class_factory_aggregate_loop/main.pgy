class Atom {
    let kind: Int;
    let energy: Int;
}

func MakeAtom(seed: Int) -> Atom {
    return Atom(seed % 3, seed * 10);
}

func TotalEnergy(start: Int, n: Int) -> Int {
    var total: Int = 0;
    var i: Int = 0;
    while i < n {
        let a: Atom = MakeAtom(start + i);
        total = total + a.energy;
        i = i + 1;
    }
    return total;
}

func Main() -> Void {
    Log(TotalEnergy(0, 5));
    Log(TotalEnergy(10, 3));
    Log(TotalEnergy(100, 10));
}
