class Vec {
    let x: Int;
    let y: Int;
    let z: Int;

    func Sum(self) -> Int { return self.x + self.y + self.z; }
}

class Frame {
    let pos: Vec;
    let scale: Int;
}

func MakeFrame(x: Int, y: Int, z: Int, s: Int) -> Frame {
    return Frame(Vec(x, y, z), s);
}

func Main() -> Void {
    Log(MakeFrame(5, 5, 5, 2).pos.Sum());
    Log(MakeFrame(1, 2, 3, 10).pos.Sum());
}
