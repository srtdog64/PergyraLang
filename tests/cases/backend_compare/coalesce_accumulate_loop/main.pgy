func ParityVal(n: Int) -> Option<Int> {
    if n % 2 == 0 { return Some(n * 10); }
    return None();
}

func SumEvenWeighted(arr: Array<Int>, n: Int) -> Int {
    let total: Int = 0;
    let i: Int = 0;
    while i < n {
        total = total + (ParityVal(arr[i]) ?? -1);
        i = i + 1;
    }
    return total;
}

func Main() -> Void {
    let nums: Array<Int> = [1, 2, 3, 4, 5, 6];
    Log(SumEvenWeighted(nums, 6));
    Log(SumEvenWeighted(nums, 3));
    Log(SumEvenWeighted(nums, 1));
    Log(SumEvenWeighted(nums, 0));
}
