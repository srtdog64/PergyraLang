// List, Queue, Set and Array element stores widen a narrower expression to
// the element type the same way HashMap values do: a Float literal into a
// Double element, an Int literal into a Long element. The raw List, Queue
// and Set exports copy sizeof(T) bytes from a temporary, so an unwidened
// store read back garbage (List<Double> printed 0.000000, SetHas missed the
// Long it had just added); Array stores refused the same programs on LLVM.
func Main() -> Void {
    var halves: List<Double> = ListNew();
    ListPush(halves, 0.5);
    ListPush(halves, 1.5);
    ListSet(halves, 1, 0.25);
    Log(ListGet(halves, 0));
    Log(ListGet(halves, 1));

    var longs: List<Long> = ListNew();
    ListPush(longs, 7);
    ListSet(longs, 0, 8);
    Log(ListGet(longs, 0));

    var pending: Queue<Double> = QueueNew();
    QueuePush(pending, 0.5);
    Log(QueuePop(pending));
    var ticks: Queue<Long> = QueueNew();
    QueuePush(ticks, 11);
    Log(QueuePop(ticks));

    var seen: Set<Long> = SetNew();
    SetAdd(seen, 9);
    Log(SetHas(seen, 9));
    Log(SetHas(seen, 9L));
    SetRemove(seen, 9);
    Log(SetHas(seen, 9L));

    var totals: Array<Long> = [7L, 8L];
    ArrayPush(totals, 9);
    ArraySet(totals, 0, 5);
    Log(totals[0] + totals[1] + totals[2]);

    let quarter: Float = 0.25;
    var weights: Array<Double> = [];
    ArrayPush(weights, quarter);
    ArrayPush(weights, 0.5);
    ArraySet(weights, 0, 0.75);
    Log(weights[0]);
    Log(weights[1]);
}
