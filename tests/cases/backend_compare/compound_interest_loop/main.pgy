func Main() -> Void {
    let principal: Int = 1000;
    let rate_bps: Int = 250;
    let years: Int = 8;
    var balance: Int = principal;
    var i: Int = 0;
    while i < years {
        balance = balance + (balance * rate_bps) / 10000;
        Log(balance);
        i = i + 1;
    }
    Log(balance - principal);
}
