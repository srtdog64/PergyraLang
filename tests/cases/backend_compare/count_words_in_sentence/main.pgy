func CountWords(s: String) -> Int {
    let n: Int = StringLength(s);
    if n == 0 { return 0; }
    let count: Int = 1;
    let i: Int = 0;
    while i < n {
        if Substring(s, i, 1) == " " {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

func Main() -> Void {
    Log(CountWords("hello world"));
    Log(CountWords("one two three four"));
    Log(CountWords("alone"));
    Log(CountWords(""));
    Log(CountWords("a b c d e f g"));
}
