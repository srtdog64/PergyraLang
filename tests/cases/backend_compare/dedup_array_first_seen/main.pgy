func Main() -> Void {
    let xs: Array<Int> = [3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5];
    var seen: Set<Int> = SetNew();
    var unique: Array<Int> = [];
    var i: Int = 0;
    while i < ArrayLength(xs) {
        let v: Int = xs[i];
        if !SetHas(seen, v) {
            SetAdd(seen, v);
            ArrayPush(unique, v);
        }
        i = i + 1;
    }
    Log(ArrayLength(unique));
    Log(SetSize(seen));
    var j: Int = 0;
    while j < ArrayLength(unique) {
        Log(unique[j]);
        j = j + 1;
    }
}
