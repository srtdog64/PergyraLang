func DigitSum(n: Int) -> Int {
    var v: Int = n;
    if v < 0 { v = -v; }
    var sum: Int = 0;
    while v > 0 {
        sum = sum + (v % 10);
        v = v / 10;
    }
    return sum;
}

func DigitalRoot(n: Int) -> Int {
    var v: Int = n;
    while v >= 10 {
        v = DigitSum(v);
    }
    return v;
}

func Main() -> Void {
    Log(DigitSum(123));
    Log(DigitSum(9999));
    Log(DigitSum(0));
    Log(DigitSum(-456));
    Log(DigitalRoot(942));
    Log(DigitalRoot(1));
    Log(DigitalRoot(99999));
}
