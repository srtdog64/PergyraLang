enum Frame { Skip, Render(Int) }

func ChooseFrame(v: Int) -> Frame {
    if v > 0 { return Render(v); }
    return Skip;
}

func DescribeAll(arr: Array<Int>, n: Int) -> Int {
    let total: Int = 0;
    let i: Int = 0;
    while i < n {
        let f: Frame = ChooseFrame(arr[i]);
        match f {
            case Skip: total = total + 1;
            case Render(x): total = total + x * 10;
        }
        i = i + 1;
    }
    return total;
}

func Main() -> Void {
    let nums: Array<Int> = [3, 0, -1, 5];
    Log(DescribeAll(nums, 4));
    Log(DescribeAll(nums, 2));
    Log(DescribeAll(nums, 1));
    Log(DescribeAll(nums, 0));
}
