enum Status { Off, On(Int), Hold }

func StatusFromInt(n: Int) -> Status {
    if n < 0 { return Hold; }
    if n == 0 { return Off; }
    return On(n);
}

func SumOn(arr: Array<Int>, n: Int) -> Int {
    let total: Int = 0;
    let i: Int = 0;
    while i < n {
        let s: Status = StatusFromInt(arr[i]);
        match s {
            case On(v): total = total + v;
            case Off: total = total + 1;
            case Hold: total = total - 1;
        }
        i = i + 1;
    }
    return total;
}

func Main() -> Void {
    let nums: Array<Int> = [3, 0, -1, 5, -2, 7];
    Log(SumOn(nums, 6));
    Log(SumOn(nums, 3));
    Log(SumOn(nums, 1));
    Log(SumOn(nums, 0));
}
