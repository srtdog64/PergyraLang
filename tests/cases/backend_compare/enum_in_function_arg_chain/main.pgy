enum Dir { North, South, East, West }

func DeltaX(d: Dir) -> Int {
    match d {
        case North: return 0;
        case South: return 0;
        case East: return 1;
        case West: return -1;
    }
}

func DeltaY(d: Dir) -> Int {
    match d {
        case North: return 1;
        case South: return -1;
        case East: return 0;
        case West: return 0;
    }
}

func Step(x: Int, y: Int, d: Dir, steps: Int) -> Int {
    let nx: Int = x + DeltaX(d) * steps;
    let ny: Int = y + DeltaY(d) * steps;
    return nx * 100 + ny;
}

func Main() -> Void {
    Log(Step(0, 0, North, 3));
    Log(Step(0, 0, South, 5));
    Log(Step(10, 10, East, 2));
    Log(Step(10, 10, West, 4));
    Log(Step(5, 5, North, 0));
}
