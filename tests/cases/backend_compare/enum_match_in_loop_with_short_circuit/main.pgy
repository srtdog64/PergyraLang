enum Token { Number(Int), Op, Sep }

func TokenFromVal(v: Int) -> Token {
    if v == 0 { return Op; }
    if v == -1 { return Sep; }
    return Number(v);
}

func SumNumeric(arr: Array<Int>, n: Int, threshold: Int) -> Int {
    let total: Int = 0;
    let i: Int = 0;
    while i < n {
        let t: Token = TokenFromVal(arr[i]);
        match t {
            case Number(v):
                if v > threshold || v < -threshold {
                    total = total + v;
                }
            case Op: total = total + 1;
            case Sep: total = total - 1;
        }
        i = i + 1;
    }
    return total;
}

func Main() -> Void {
    let nums: Array<Int> = [5, 0, 3, -1, 100, 2, -1];
    Log(SumNumeric(nums, 7, 2));
    Log(SumNumeric(nums, 7, 50));
    Log(SumNumeric(nums, 3, 0));
    Log(SumNumeric(nums, 0, 0));
}
