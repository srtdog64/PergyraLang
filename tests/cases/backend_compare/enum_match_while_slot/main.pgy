enum Mode { Add, Mul, Sub }

func Choose(n: Int) -> Mode {
    if n % 3 == 0 { return Mode.Add; }
    if n % 3 == 1 { return Mode.Mul; }
    return Mode.Sub;
}

func Main() -> Void {
    let acc: Slot<Int> = ClaimSlot();
    Write(acc, 1);
    let i: Slot<Int> = ClaimSlot();
    Write(i, 0);
    while Read(i) < 5 {
        match Choose(Read(i)) {
            case Mode.Add: Write(acc, Read(acc) + Read(i));
            case Mode.Mul: Write(acc, Read(acc) * 2);
            case Mode.Sub: Write(acc, Read(acc) - 1);
        }
        Write(i, Read(i) + 1);
    }
    Log(Read(acc));
}
