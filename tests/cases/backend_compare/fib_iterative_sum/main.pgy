func Fib(n: Int) -> Int {
    if n <= 0 { return 0; }
    if n == 1 { return 1; }
    var a: Int = 0;
    var b: Int = 1;
    var i: Int = 2;
    while i <= n {
        let c: Int = a + b;
        a = b;
        b = c;
        i = i + 1;
    }
    return b;
}

func FibSum(n: Int) -> Int {
    var total: Int = 0;
    var i: Int = 0;
    while i <= n {
        total = total + Fib(i);
        i = i + 1;
    }
    return total;
}

func Main() -> Void {
    Log(Fib(10));
    Log(Fib(20));
    Log(Fib(0));
    Log(FibSum(5));
    Log(FibSum(10));
}
