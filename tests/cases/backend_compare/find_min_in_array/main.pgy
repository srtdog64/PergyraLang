func FindMin(xs: Array<Int>) -> Int {
    let cur: Int = xs[0];
    let i: Int = 1;
    while i < ArrayLength(xs) {
        if xs[i] < cur { cur = xs[i]; }
        i = i + 1;
    }
    return cur;
}

func Main() -> Void {
    let a: Array<Int> = [5, 2, 8, 1, 9, 3];
    let b: Array<Int> = [-3, -10, -1];
    let c: Array<Int> = [7];
    let d: Array<Int> = [0, 0, 0];
    Log(FindMin(a));
    Log(FindMin(b));
    Log(FindMin(c));
    Log(FindMin(d));
}
