class Step {
    let n: Int;

    func Doubled(self) -> Int { return self.n * 2; }
}

func Get(i: Int) -> Step { return Step(i); }

func Test(n: Int) -> Int {
    let total: Int = 0;
    for i in 0..n {
        total = total + Get(i + 1).Doubled();
    }
    return total;
}

func Main() -> Void {
    Log(Test(5));
    Log(Test(0));
    Log(Test(10));
}
