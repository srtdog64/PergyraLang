func PairSum(n: Int, m: Int) -> Int {
    let total: Int = 0;
    for i in 0..n {
        for j in 0..m {
            total = total + i * 10 + j;
        }
    }
    return total;
}

func Main() -> Void {
    Log(PairSum(3, 2));
    Log(PairSum(0, 5));
    Log(PairSum(5, 0));
    Log(PairSum(2, 2));
}
