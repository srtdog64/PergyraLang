func Main() -> Void {
    let xs: Array<Int> = [3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5, 8, 9, 5];
    let counts: HashMap<Int, Int> = MapNew();
    let i: Int = 0;
    while i < ArrayLength(xs) {
        let v: Int = xs[i];
        if MapHas(counts, v) {
            MapSet(counts, v, MapGet(counts, v) + 1);
        }
        if !MapHas(counts, v) {
            MapSet(counts, v, 1);
        }
        i = i + 1;
    }
    let dominant: Int = -1;
    let max_count: Int = 0;
    let probes: Array<Int> = [1, 2, 3, 4, 5, 6, 8, 9];
    let j: Int = 0;
    while j < ArrayLength(probes) {
        if MapHas(counts, probes[j]) {
            let c: Int = MapGet(counts, probes[j]);
            if c > max_count {
                max_count = c;
                dominant = probes[j];
            }
        }
        j = j + 1;
    }
    Log(dominant);
    Log(max_count);
}
