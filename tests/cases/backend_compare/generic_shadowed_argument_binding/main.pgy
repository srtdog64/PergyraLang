// A name reused after its block has closed keeps each binding's type as a
// generic argument: the calls in the block bind T = String, the later ones
// T = Int.
func Wrap<T>(x: T) -> Option<T> {
    return Some(x);
}

func Size<T>(xs: Array<T>) -> Int {
    return ArrayLength(xs);
}

func Main() -> Void {
    let flag: Int = 1;
    if flag > 0 {
        let v: String = "inner";
        let w: Option<String> = Wrap(v);
        if IsSome(w) {
            Log(UnwrapOption(w));
        }
        let pair: Array<String> = [v, v];
        Log(pair[Size(pair) - 1]);
    }
    let v: Int = 1;
    let o: Option<Int> = Wrap(v);
    if IsSome(o) {
        Log(ToString(UnwrapOption(o)));
    }
    let nums: Array<Int> = [v, v];
    Log(ToString(nums[0] + nums[Size(nums) - 1]));
}
