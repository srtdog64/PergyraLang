func GridSum(flat: Array<Int>, rows: Int, cols: Int) -> Int {
    let sum: Int = 0;
    let r: Int = 0;
    while r < rows {
        let c: Int = 0;
        while c < cols {
            sum = sum + flat[r * cols + c];
            c = c + 1;
        }
        r = r + 1;
    }
    return sum;
}

func RowSum(flat: Array<Int>, cols: Int, row: Int) -> Int {
    let s: Int = 0;
    let c: Int = 0;
    while c < cols {
        s = s + flat[row * cols + c];
        c = c + 1;
    }
    return s;
}

func Main() -> Void {
    let g: Array<Int> = [1, 2, 3, 4, 5, 6, 7, 8, 9];
    Log(GridSum(g, 3, 3));
    Log(GridSum(g, 1, 3));
    Log(RowSum(g, 3, 0));
    Log(RowSum(g, 3, 1));
    Log(RowSum(g, 3, 2));
}
