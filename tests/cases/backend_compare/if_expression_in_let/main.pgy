func Pick(flag: Bool, hi: Int, lo: Int) -> Int {
    let chosen: Int = 0;
    if flag {
        chosen = hi;
    }
    if !flag {
        chosen = lo;
    }
    return chosen;
}

func Main() -> Void {
    Log(Pick(true, 100, 5));
    Log(Pick(false, 100, 5));
    Log(Pick(1 > 0, 7, -7));
    Log(Pick(2 == 3, 7, -7));
}
