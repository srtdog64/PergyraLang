func ValidRange(x: Int, lo: Int, hi: Int) -> Bool {
    return lo <= x && x <= hi;
}

func Main() -> Void {
    Log(ToString(ValidRange(5, 1, 10)));
    Log(ToString(ValidRange(0, 1, 10)));
    Log(ToString(ValidRange(20, 1, 10)));
    Log(ToString(ValidRange(1, 1, 10)));
    Log(ToString(ValidRange(10, 1, 10)));
    let any: Bool = ValidRange(-5, 0, 5) || ValidRange(7, 0, 5);
    Log(ToString(any));
}
