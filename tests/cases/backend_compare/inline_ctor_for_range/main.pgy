class Card {
    let value: Int;
}

func TotalHands(seeds: Array<Int>, n: Int) -> Int {
    let sum: Int = 0;
    for i in 0..n {
        sum = sum + Card(seeds[i] + i).value;
    }
    return sum;
}

func Main() -> Void {
    let s: Array<Int> = [10, 20, 30];
    Log(TotalHands(s, 3));
    let empty: Array<Int> = [];
    Log(TotalHands(empty, 0));
}
