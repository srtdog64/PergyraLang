func MyAbs(n: Int) -> Int {
    if n < 0 { return 0 - n; }
    return n;
}

func MySign(n: Int) -> Int {
    if n > 0 { return 1; }
    if n < 0 { return -1; }
    return 0;
}

func MyClamp(n: Int, lo: Int, hi: Int) -> Int {
    if n < lo { return lo; }
    if n > hi { return hi; }
    return n;
}

func Main() -> Void {
    Log(MyAbs(-5));
    Log(MyAbs(7));
    Log(MyAbs(0));
    Log(MySign(-3));
    Log(MySign(0));
    Log(MySign(42));
    Log(MyClamp(50, 0, 100));
    Log(MyClamp(-10, 0, 100));
    Log(MyClamp(150, 0, 100));
}
