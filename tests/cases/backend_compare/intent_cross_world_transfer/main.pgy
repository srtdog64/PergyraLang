subject Buyer {
    let hp: Int;

    action Promote(self) -> Void {
        hp = hp + 2;
    }
}

object BuyerView {
    let hp: Int;
}

zone CartZone {
    subject slot buyer: Buyer
    object slot mirror: BuyerView

    bind mirror from buyer by buyer
}

zone PaymentZone {
    subject slot buyer: Buyer
    object slot receipt: BuyerView

    bind receipt from buyer by buyer
}

intent Checkout(cart: CartZone, payment: PaymentZone, buyer: Buyer) {
    exclusive;
    priority: 7;

    step Promote {
        where: PaymentZone;
        using: payment;
        transfer: cart -> payment;
        who: buyer;
        on: buyer.Promote();
        post: cart.buyer.hp == buyer.hp;
        expect: payment.receipt.hp == buyer.hp;
    }

    success: payment.buyer.hp == 7;
    failure: false;
}

func Main() -> Void {
    let cart = CartZone(Buyer(5));
    let payment = PaymentZone(Buyer(0));
    let ok = Checkout(cart, payment, cart.buyer);

    Log("ok=" + ToString(ok));
    Log("cart.hp=" + ToString(cart.buyer.hp));
    Log("payment.hp=" + ToString(payment.buyer.hp));
    Log("receipt.hp=" + ToString(payment.receipt.hp));
    Log("trace=" + IntentLastTrace());
    Log("history.count=" + ToString(IntentHistoryCount()));
    Log("history.zone0=" + IntentHistoryStepZone(0));
    Log("history.ok0=" + ToString(IntentHistoryStepOk(0)));
}
