subject Driver {
    let hp: Int;
    let started: Bool;

    action Ignite(self) -> Void {
        started = true;
        hp = hp + 1;
    }

    action RollbackIgnite(self) -> Void {
        started = false;
        hp = hp - 1;
    }
}

zone CockpitZone {
    subject slot driver: Driver
}

intent DriveCar(cockpit: CockpitZone, driver: Driver) {
    exclusive;
    priority: 3;

    step Ignite {
        where: CockpitZone;
        using: cockpit;
        who: driver;
        on: driver.Ignite();
        compensate: driver.RollbackIgnite();
        pre: true;
        expect: cockpit.driver.hp == driver.hp;
        post: driver.started;
        guard: false;
        invariant: cockpit.driver.started == driver.started;
    }

    success: true;
    failure: false;
}

func Main() -> Void {
    let d = Driver(0, false);
    let cockpit = CockpitZone(Driver(99, true));
    let ok = DriveCar(cockpit, d);
    Log("ok=" + ToString(ok));
    Log("hp=" + ToString(d.hp));
    Log("started=" + ToString(d.started));
    Log("cockpit.hp=" + ToString(cockpit.driver.hp));
    Log("cockpit.started=" + ToString(cockpit.driver.started));
    Log("last.name=" + IntentLastName());
    Log("last.handle=" + ToString(IntentLastHandle()));
    Log("last.steps=" + ToString(IntentLastStepCount()));
    Log("last.failed=" + ToString(IntentLastFailed()));
    Log("history.count=" + ToString(IntentHistoryCount()));
    Log("history[0].name=" + IntentHistoryStepName(0));
    Log("history[0].zone=" + IntentHistoryStepZone(0));
    Log("history[0].ok=" + ToString(IntentHistoryStepOk(0)));
    Log("history[0].failure=" + IntentHistoryStepFailure(0));
    Log("failure=" + IntentLastFailure());
    Log("trace:");
    Log(IntentLastTrace());
}
