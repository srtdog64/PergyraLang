class A {
    let v: Int;

    func Value(self) -> Int {
        return v + 1;
    }
}

class B {
    let v: Int;

    func Value(self) -> Int {
        return v + 100;
    }
}

// A name reused after its block has closed dispatches on each binding's own
// class (docs/206 section 3).
func Main() -> Void {
    if true {
        let x: B = B(2);
        Log(x.Value());
    }
    let x: A = A(1);
    Log(x.Value());
}
