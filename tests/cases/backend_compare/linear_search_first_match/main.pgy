func FindFirst(xs: Array<Int>, predicate_threshold: Int) -> Int {
    let i: Int = 0;
    while i < ArrayLength(xs) {
        if xs[i] > predicate_threshold {
            return xs[i];
        }
        i = i + 1;
    }
    return -1;
}

func Main() -> Void {
    let xs: Array<Int> = [3, 7, 2, 9, 1, 11, 4];
    Log(FindFirst(xs, 5));
    Log(FindFirst(xs, 10));
    Log(FindFirst(xs, 100));
    Log(FindFirst(xs, 0));
}
