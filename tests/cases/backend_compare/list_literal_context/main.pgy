func Main() -> Void {
    var nums: List<Int> = [3, 4, 5];
    Log(ListSize(nums));
    Log(ListGet(nums, 0));
    Log(ListGet(nums, 2));

    var names: List<String> = ["alpha", "beta"];
    Log(ListSize(names));
    Log(ListGet(names, 1));

    let empty: List<String> = [];
    Log(ListSize(empty));
}
