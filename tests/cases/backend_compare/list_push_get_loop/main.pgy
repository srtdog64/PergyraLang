func Main() -> Void {
    var xs: List<Int> = ListNew();
    var i: Int = 1;
    while i <= 5 {
        ListPush(xs, i * i);
        i = i + 1;
    }
    var total: Int = 0;
    var j: Int = 0;
    while j < ListSize(xs) {
        total = total + ListGet(xs, j);
        j = j + 1;
    }
    Log(ListSize(xs));
    Log(total);
}
