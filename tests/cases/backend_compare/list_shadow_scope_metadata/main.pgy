// A name reused after its block has closed is a second List binding with its
// own element type (docs/206 section 3).
func Main() -> Void {
    if 1 == 1 {
        var items: List<String> = ListNew();
        ListPush(items, "inner");
        Log(ListGet(items, 0));
    }

    var items: List<Int> = ListNew();
    ListPush(items, 10);
    ListPush(items, 20);
    Log(ListGet(items, 0));
    Log(ListGet(items, 1));
}
