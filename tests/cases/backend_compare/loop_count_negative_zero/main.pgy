func CountSigns(arr: Array<Int>, n: Int) -> Int {
    let neg: Int = 0;
    let zero: Int = 0;
    let pos: Int = 0;
    let i: Int = 0;
    while i < n {
        if arr[i] < 0 {
            neg = neg + 1;
        } else if arr[i] == 0 {
            zero = zero + 1;
        } else {
            pos = pos + 1;
        }
        i = i + 1;
    }
    return neg * 10000 + zero * 100 + pos;
}

func Main() -> Void {
    let a: Array<Int> = [-3, 0, 5, -1, 0, 7, 8];
    Log(CountSigns(a, 7));
    Log(CountSigns(a, 3));
    Log(CountSigns(a, 0));
    let b: Array<Int> = [0, 0, 0, 0];
    Log(CountSigns(b, 4));
    let c: Array<Int> = [1, 2, 3, 4, 5];
    Log(CountSigns(c, 5));
    let d: Array<Int> = [-5, -4, -3, -2, -1];
    Log(CountSigns(d, 5));
}
