func Main() -> Void {
    let labels: Array<String> = ["red", "blue", "red", "green", "blue", "red"];
    let counts: HashMap<String, Int> = MapNew();
    let i: Int = 0;
    while i < ArrayLength(labels) {
        let key: String = labels[i];
        if MapHas(counts, key) {
            MapSet(counts, key, MapGet(counts, key) + 1);
        }
        if !MapHas(counts, key) {
            MapSet(counts, key, 1);
        }
        i = i + 1;
    }
    Log(MapGet(counts, "red"));
    Log(MapGet(counts, "blue"));
    Log(MapGet(counts, "green"));
}
