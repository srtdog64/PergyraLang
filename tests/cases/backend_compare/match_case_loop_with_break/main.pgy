enum Target { First, Last, Count(Int) }

func Find(arr: Array<Int>, n: Int, key: Int, t: Target) -> Int {
    match t {
        case First:
            let i: Int = 0;
            while i < n {
                if arr[i] == key { return i; }
                i = i + 1;
            }
            return -1;
        case Last:
            let result: Int = -1;
            let i: Int = 0;
            while i < n {
                if arr[i] == key { result = i; }
                i = i + 1;
            }
            return result;
        case Count(limit):
            let c: Int = 0;
            let i: Int = 0;
            while i < n && c < limit {
                if arr[i] == key { c = c + 1; }
                i = i + 1;
            }
            return c;
    }
}

func Main() -> Void {
    let a: Array<Int> = [3, 1, 4, 1, 5, 9, 2, 6, 1];
    Log(Find(a, 9, 1, First));
    Log(Find(a, 9, 1, Last));
    Log(Find(a, 9, 1, Count(2)));
    Log(Find(a, 9, 1, Count(99)));
    Log(Find(a, 9, 7, First));
    Log(Find(a, 9, 7, Count(5)));
}
