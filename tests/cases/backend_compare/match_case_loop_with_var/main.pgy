enum Mode { Sum, Product, Diff }

func Apply(arr: Array<Int>, n: Int, mode: Mode) -> Int {
    match mode {
        case Sum:
            var acc: Int = 0;
            var i: Int = 0;
            while i < n {
                acc = acc + arr[i];
                i = i + 1;
            }
            return acc;
        case Product:
            var acc: Int = 1;
            var i: Int = 0;
            while i < n {
                acc = acc * arr[i];
                i = i + 1;
            }
            return acc;
        case Diff:
            if n == 0 { return 0; }
            var acc: Int = arr[0];
            var i: Int = 1;
            while i < n {
                acc = acc - arr[i];
                i = i + 1;
            }
            return acc;
    }
}

func Main() -> Void {
    let a: Array<Int> = [1, 2, 3, 4, 5];
    Log(Apply(a, 5, Sum));
    Log(Apply(a, 5, Product));
    Log(Apply(a, 5, Diff));
    let b: Array<Int> = [10, 5];
    Log(Apply(b, 2, Sum));
    Log(Apply(b, 2, Diff));
    let c: Array<Int> = [];
    Log(Apply(c, 0, Sum));
}
