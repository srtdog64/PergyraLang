func InnerCat(n: Int) -> Int {
    match n % 3 {
        case 0: return 1000;
        case 1: return 2000;
        default: return 3000;
    }
}

func Categorize(n: Int) -> Int {
    match n {
        case 0: return 100;
        case 1: return 200;
        case 2: return 300;
        default: return InnerCat(n);
    }
}

func Main() -> Void {
    let acc: Slot<Int> = ClaimSlot();
    Write(acc, 0);
    let i: Slot<Int> = ClaimSlot();
    Write(i, 0);
    while Read(i) < 8 {
        Write(acc, Read(acc) + Categorize(Read(i)));
        Write(i, Read(i) + 1);
    }
    Log(Read(acc));
}
