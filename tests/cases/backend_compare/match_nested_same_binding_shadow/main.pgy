func Pick(x: Int) -> Option<Int> {
    if x == 0 {
        return None;
    }
    return Some(x);
}

// A nested case cannot rebind `v` (docs/206 section 3); a match that starts
// after the first has closed can.
func Score(a: Int, b: Int) -> Int {
    let total: Int = 0;
    match Pick(a) {
        case Some(v):
            total = v;
            match Pick(b) {
                case Some(w): total = total + w;
                case None: total = total + 100;
            }
            total = total + v;
        case None:
            total = -1;
    }
    match Pick(b) {
        case Some(v): total = total + v * 10;
        case None: total = total + 0;
    }
    return total;
}

func Main() -> Void {
    Log(Score(2, 3));
    Log(Score(2, 0));
    Log(Score(0, 3));
}
