enum Mode { Hot, Cold, Mild }

class Reading {
    let temp: Int;
    let humidity: Int;
}

func ReadingOf(m: Mode) -> Reading {
    match m {
        case Hot: return Reading(100, 30);
        case Cold: return Reading(20, 50);
        case Mild: return Reading(60, 70);
    }
}

func Index(m: Mode) -> Int {
    return ReadingOf(m).temp + ReadingOf(m).humidity;
}

func Main() -> Void {
    Log(Index(Hot));
    Log(Index(Cold));
    Log(Index(Mild));
    Log(ReadingOf(Hot).temp);
    Log(ReadingOf(Cold).humidity);
}
