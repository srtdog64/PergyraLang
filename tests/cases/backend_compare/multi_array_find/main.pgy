func FindInArray(arr: Array<Int>, target: Int) -> Int {
    let i: Int = 0;
    while i < ArrayLength(arr) {
        if arr[i] == target {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

func Main() -> Void {
    let row1: Array<Int> = [1, 2, 3];
    let row2: Array<Int> = [4, 5, 6];
    let row3: Array<Int> = [7, 8, 9];
    Log(FindInArray(row1, 2));
    Log(FindInArray(row2, 5));
    Log(FindInArray(row3, 8));
    Log(FindInArray(row1, 99));
    Log(FindInArray(row3, 7));
}
