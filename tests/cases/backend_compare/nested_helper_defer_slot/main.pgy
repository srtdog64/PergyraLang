func Double(n: Int) -> Int { return n * 2; }
func Triple(n: Int) -> Int { return n * 3; }

func Compose(seed: Int) -> Int {
    let s: Slot<Int> = ClaimSlot();
    Write(s, Double(seed));
    Write(s, Triple(Read(s)));
    defer { Log(Read(s)); };
    return Read(s);
}

func Main() -> Void {
    Log(Compose(5));
}
