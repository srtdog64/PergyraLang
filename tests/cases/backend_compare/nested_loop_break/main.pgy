func Main() -> Void {
    var total: Int = 0;
    var i: Int = 0;
    while i < 5 {
        var j: Int = 0;
        while j < 5 {
            if i + j > 5 {
                break;
            }
            total = total + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    Log(total);
}
