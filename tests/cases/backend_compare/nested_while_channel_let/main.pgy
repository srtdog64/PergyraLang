func Main() -> Void {
    let ch: Channel<Int> = Channel(5);
    let sum: Slot<Int> = ClaimSlot();
    Write(sum, 0);
    let i: Slot<Int> = ClaimSlot();
    Write(i, 0);
    while Read(i) < 3 {
        ch <- Read(i);
        Write(i, Read(i) + 1);
    }
    Write(i, 0);
    while Read(i) < 3 {
        let v: Int = <- ch;
        Write(sum, Read(sum) + v);
        Write(i, Read(i) + 1);
    }
    Log(Read(sum));
}
