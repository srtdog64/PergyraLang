func TryGet(arr: Array<Int>, n: Int, idx: Int) -> Option<Int> {
    if idx < 0 {
        return None;
    }
    if idx >= n {
        return None;
    }
    return Some(arr[idx]);
}

func SumIndices(arr: Array<Int>, n: Int, indices: Array<Int>, m: Int) -> Int {
    let total: Int = 0;
    let i: Int = 0;
    while i < m {
        match TryGet(arr, n, indices[i]) {
            case Some(v): total = total + v;
            case None: total = total - 1;
        }
        i = i + 1;
    }
    return total;
}

func Main() -> Void {
    let data: Array<Int> = [10, 20, 30, 40, 50];
    let idx1: Array<Int> = [0, 1, 2, 3, 4];
    Log(SumIndices(data, 5, idx1, 5));
    let idx2: Array<Int> = [-1, 0, 7, 2, 100];
    Log(SumIndices(data, 5, idx2, 5));
    let idx3: Array<Int> = [4, 3, 2, 1, 0];
    Log(SumIndices(data, 5, idx3, 5));
}
