func SafeDiv(a: Int, b: Int) -> Option<Int> {
    if b == 0 { return None; }
    return Some(a / b);
}

func Main() -> Void {
    let acc: Slot<Int> = ClaimSlot();
    Write(acc, 0);
    let i: Slot<Int> = ClaimSlot();
    Write(i, 1);
    while Read(i) <= 5 {
        match SafeDiv(20, Read(i)) {
            case Some(q): Write(acc, Read(acc) + q);
            case None: Write(acc, Read(acc));
        }
        Write(i, Read(i) + 1);
    }
    Log(Read(acc));
}
