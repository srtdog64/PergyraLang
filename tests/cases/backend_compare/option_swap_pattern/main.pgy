func PickFirst(a: Int, b: Int, useA: Bool) -> Option<Int> {
    if useA { return Some(a); }
    if b > 0 { return Some(b); }
    return None();
}

func SafeMax(a: Int, b: Int) -> Int {
    let x: Int = PickFirst(a, b, true) ?? 0;
    let y: Int = PickFirst(a, b, false) ?? 0;
    if x > y { return x; }
    return y;
}

func Main() -> Void {
    Log(SafeMax(5, 7));
    Log(SafeMax(-1, 3));
    Log(SafeMax(-10, -5));
    Log(SafeMax(0, 0));
    Log(SafeMax(100, 50));
}
