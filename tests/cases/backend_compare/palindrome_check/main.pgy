func Reverse(s: String) -> String {
    let result: String = "";
    let i: Int = StringLength(s) - 1;
    while i >= 0 {
        result = result + Substring(s, i, i + 1);
        i = i - 1;
    }
    return result;
}

func IsPalindrome(s: String) -> Bool {
    return s == Reverse(s);
}

func Main() -> Void {
    Log(IsPalindrome("racecar"));
    Log(IsPalindrome("hello"));
    Log(IsPalindrome(""));
    Log(IsPalindrome("a"));
    Log(IsPalindrome("abba"));
    Log(Reverse("hi"));
}
