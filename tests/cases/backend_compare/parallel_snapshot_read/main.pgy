// Reader-snapshot witness (docs/178 Copy evidence, statement level).
//
// One arm writes x and then signals through a channel; the other arm waits
// for the signal and only then reads x. Under shared-pointer semantics the
// reader would be guaranteed to observe 42 (the channel receive orders it
// after the write). Under snapshot semantics the reader arm holds the
// pre-parallel copy of x, so it observes 1 -- deterministically, on both
// backends. The parent still observes the writer's final value after the
// join. Expected output: 42 then 1.
func Main() -> Void {
    let ch: Channel<Int> = Channel(1);
    let mut x: Int = 1;
    let mut seen: Int = -1;
    parallel {
        {
            x = x + 41;
            ch <- 1;
        }
        {
            let go: Int = <- ch;
            seen = x + go - go;
        }
    }
    Log(x);
    Log(seen);
}
