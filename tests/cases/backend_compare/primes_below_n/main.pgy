func IsPrime(n: Int) -> Bool {
    if n < 2 { return false; }
    if n == 2 { return true; }
    if n % 2 == 0 { return false; }
    var i: Int = 3;
    while i * i <= n {
        if n % i == 0 { return false; }
        i = i + 2;
    }
    return true;
}

func Main() -> Void {
    var count: Int = 0;
    var last: Int = 0;
    var n: Int = 2;
    while n <= 30 {
        if IsPrime(n) {
            count = count + 1;
            last = n;
        }
        n = n + 1;
    }
    Log(count);
    Log(last);
}
