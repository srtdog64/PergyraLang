struct Strat {
    name: String;
    posture: String;
    aggression: Int;
    guardBias: Int;
    focusShift: Int;
    moraleSwing: Int;
    effectBias: Int;
}

class WeaponCard {
    let name: String;
    let style: String;
    let power: Int;
    let guardBreak: Int;
    let focusCost: Int;
    let effectTag: String;

    func ActionLine(self, strategy: Strat) -> String {
        return strategy.name + " with " + name + " in a " + strategy.posture + " pattern";
    }

    func EffectLine(self, strategy: Strat) -> String {
        return effectTag
            + ", aggression=" + ToString(strategy.aggression)
            + ", guard=" + ToString(strategy.guardBias)
            + ", morale=" + ToString(strategy.moraleSwing);
    }
}

world W {
    shared transcript: String = ""

    func Record(self, line: String) -> Void {
        if StringLength(transcript) == 0 {
            transcript = line;
        } else {
            transcript = transcript + "\n" + line;
        }
    }

    func Broadcast(self, line: String) -> Void {
        Log(line);
        Record(line);
    }

    func BroadcastNoRecord(self, line: String) -> Void {
        Log(line);
    }
}

func MakeStrat(stateId: Int, opt: Int, classCode: Int, pulse: Int) -> Strat {
    let aggression = pulse;
    let guardBias = 0;
    let focusShift = 0;
    let moraleSwing = 0;
    let effectBias = 0;
    let name = "tempo line";
    let posture = "measured";

    if opt == 1 {
        name = "anchor drive";
        posture = "front-footed";
        guardBias = 1;
        moraleSwing = 1;
    }
    else if opt == 2 {
        name = "ward weave";
        posture = "guarded";
        guardBias = 2;
        focusShift = 1;
    }
    else if opt == 3 {
        name = "shadow cut";
        posture = "flanking";
        aggression = aggression + 1;
        effectBias = 1;
    }
    else {
        name = "ember surge";
        posture = "reckless";
        aggression = aggression + 2;
        focusShift = -1;
        moraleSwing = -1;
        effectBias = 2;
    }

    if classCode == 0 { guardBias = guardBias + 1; }
    else if classCode == 1 { moraleSwing = moraleSwing + 1; }
    else if classCode == 2 { focusShift = focusShift + 1; }
    else { aggression = aggression + 1; }

    if stateId == 4 {
        aggression = aggression + 1;
        moraleSwing = moraleSwing + 1;
    }

    return Strat(name, posture, aggression, guardBias, focusShift, moraleSwing, effectBias);
}

func Main() -> Void {
    let w = W("");
    let weapon = WeaponCard("Iron Kite", "line-break", 3, 2, 1, "guard crack");
    let round = 1;
    while round <= 2 {
        let fStrat = MakeStrat(1, 1, 0, round);
        let cStrat = MakeStrat(1, 1, 1, round);
        let rStrat = MakeStrat(1, 1, 2, round);
        let mStrat = MakeStrat(1, 1, 3, round);
        w.Broadcast("Ari " + weapon.ActionLine(fStrat));
        w.Broadcast("Mira " + weapon.ActionLine(cStrat));
        w.Broadcast("Nyx " + weapon.ActionLine(rStrat));
        w.Broadcast("Sol " + weapon.ActionLine(mStrat));
        round = round + 1;
    }
}
