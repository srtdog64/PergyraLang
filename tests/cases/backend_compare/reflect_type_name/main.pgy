// Regression: `reflect` yields a compile-time `projection`. For a type:
// `.name`/`.kind`/`.effects`/`.fields`/`.methods`. For a function: `.params`
// ("name:Type" list) and `.returns` (return type name). Every field folds at
// compile time; C and LLVM must agree on all of them.
struct Account {
    id: Int
}

func Add(a: Int, b: Int) -> Int {
    return a + b;
}

func Main() -> Void {
    let p: projection = reflect Account;
    Log(p.name);
    Log(p.kind);
    Log(p.fields);
    Log(p.methods);

    let f: projection = reflect Add;
    Log(f.params);
    Log(f.returns);
}
