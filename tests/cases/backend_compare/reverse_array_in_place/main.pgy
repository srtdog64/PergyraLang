func Main() -> Void {
    var xs: Array<Int> = [1, 2, 3, 4, 5];
    var lo: Int = 0;
    var hi: Int = ArrayLength(xs) - 1;
    while lo < hi {
        let tmp: Int = xs[lo];
        ArraySet(xs, lo, xs[hi]);
        ArraySet(xs, hi, tmp);
        lo = lo + 1;
        hi = hi - 1;
    }
    var i: Int = 0;
    while i < ArrayLength(xs) {
        Log(xs[i]);
        i = i + 1;
    }
}
