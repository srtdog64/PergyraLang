func ReverseString(s: String) -> String {
    var result: String = "";
    let n: Int = StringLength(s);
    var i: Int = n - 1;
    while i >= 0 {
        result = Concat(result, Substring(s, i, 1));
        i = i - 1;
    }
    return result;
}

func Main() -> Void {
    Log(ReverseString("hello"));
    Log(ReverseString("a"));
    Log(ReverseString(""));
    Log(ReverseString("racecar"));
    Log(ReverseString("12345"));
}
