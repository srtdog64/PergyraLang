// C/LLVM token-gated field-storage parity only; no encrypted policy is claimed.
class Vault
{
    private let (_coinSlot, _coinToken) = ClaimSecureSlot<Int>()

    public func Run() -> Void
    {
        Write(_coinSlot, 100, _coinToken)
        Log(Read(_coinSlot, _coinToken))
    }
}

func Main() -> Void
{
    let v: Vault = Vault()
    v.Run()
}
