subject Vec2 {
    let x: Int;
    let y: Int;
}

func ConsumeInner(own s: SecureSlot<Vec2>) -> Void {
    Write(s, Vec2(1, 2), s_token);
    Release(s, s_token);
}

func ConsumeOuter(own s: SecureSlot<Vec2>) -> Void {
    ConsumeInner(s);
}

func Main() -> Void {
    let s: SecureSlot<Vec2> = Vec2(3, 7);
    ConsumeOuter(s);
    Log(1);
}
