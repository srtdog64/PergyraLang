func Main() -> Void {
    let rs: SecureSlot<Int> = ClaimSecureSlot();
    let ws: SecureSlot<Int> = ClaimSecureSlot();
    Write(rs, 5, rs_token);
    pin rs as rv: ReadView<Int> {
        Log(Read(rv));
    }
    pin ws as wv: WriteView<Int> {
        Write(wv, 5);
        Write(wv, 9);
    }
    Log(Read(ws, ws_token));
}
