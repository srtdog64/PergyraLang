func Main() -> Void {
    let xs: Array<Int> = [10, 14, 12, 18, 22, 15, 30];
    let diffs: Array<Int> = [];
    let i: Int = 1;
    while i < ArrayLength(xs) {
        ArrayPush(diffs, xs[i] - xs[i - 1]);
        i = i + 1;
    }
    Log(ArrayLength(diffs));
    let j: Int = 0;
    while j < ArrayLength(diffs) {
        Log(diffs[j]);
        j = j + 1;
    }
    let total: Int = 0;
    let k: Int = 0;
    while k < ArrayLength(diffs) {
        if diffs[k] > 0 { total = total + diffs[k]; }
        k = k + 1;
    }
    Log(total);
}
