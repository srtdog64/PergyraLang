func SafeDivCount(arr: Array<Int>, n: Int, divisor: Int) -> Int {
    let count: Int = 0;
    let i: Int = 0;
    while i < n {
        if divisor != 0 && arr[i] % divisor == 0 {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

func AnyMatch(arr: Array<Int>, n: Int, target: Int) -> Bool {
    let i: Int = 0;
    let found: Bool = false;
    while i < n {
        if found || arr[i] == target {
            found = true;
        }
        i = i + 1;
    }
    return found;
}

func Main() -> Void {
    let nums: Array<Int> = [2, 4, 6, 7, 12, 15];
    Log(SafeDivCount(nums, 6, 3));
    Log(SafeDivCount(nums, 6, 2));
    Log(SafeDivCount(nums, 6, 0));
    Log(AnyMatch(nums, 6, 7));
    Log(AnyMatch(nums, 6, 99));
    Log(AnyMatch(nums, 0, 2));
}
