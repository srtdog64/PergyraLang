func IsBig(n: Int) -> Bool {
    return n > 100;
}

func IsEvenPos(n: Int) -> Bool {
    return n > 0 && n % 2 == 0;
}

func CategorySum(arr: Array<Int>, n: Int) -> Int {
    let total: Int = 0;
    let i: Int = 0;
    while i < n {
        let v: Int = arr[i];
        if IsBig(v) || IsEvenPos(v) {
            total = total + v;
        }
        if IsBig(v) && IsEvenPos(v) {
            total = total + 1;
        }
        i = i + 1;
    }
    return total;
}

func Main() -> Void {
    let nums: Array<Int> = [-4, 2, 6, 105, 200, 7];
    Log(CategorySum(nums, 6));
    Log(CategorySum(nums, 3));
    Log(CategorySum(nums, 1));
    Log(CategorySum(nums, 0));
}
