func WindowSum(xs: Array<Int>, k: Int) -> Int {
    let n: Int = ArrayLength(xs);
    if k > n { return 0; }
    let i: Int = 0;
    let best: Int = 0;
    while i + k <= n {
        let cur: Int = 0;
        let j: Int = 0;
        while j < k {
            cur = cur + xs[i + j];
            j = j + 1;
        }
        if cur > best { best = cur; }
        i = i + 1;
    }
    return best;
}

func Main() -> Void {
    let xs: Array<Int> = [1, 3, 2, 6, 5, 4, 1, 8];
    Log(WindowSum(xs, 3));
    Log(WindowSum(xs, 4));
    Log(WindowSum(xs, 1));
    Log(WindowSum(xs, 8));
    Log(WindowSum(xs, 9));
}
