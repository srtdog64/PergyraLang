class Cell {
    let value: Int;

    func Score(self) -> Int {
        return value * 10;
    }
}

func Main() -> Void {
    let x: Int = 0;
    if true {
        x = 1;
    }
    Log(x);

    let label: String = "cold";
    if true {
        label = "hot";
    }
    Log(label);

    let cell: Cell = Cell(2);
    if true {
        cell = Cell(7);
    }
    Log(cell.Score());
}
