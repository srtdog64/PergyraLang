// Effect summaries may precede this scope; only the real call reads path.
func Main() -> Void {
    let i: Int = 0;
    while i < 1 {
        let path: String = "payload.txt";
        if i == 0 {
            let content: String = ReadFile(path);
            Log(ToInt(content));
        }
        i = i + 1;
    }
}
