func RunLength(s: String) -> String {
    let n: Int = StringLength(s);
    if n == 0 { return ""; }
    let result: String = "";
    let prev: String = Substring(s, 0, 1);
    let count: Int = 1;
    let i: Int = 1;
    while i < n {
        let ch: String = Substring(s, i, 1);
        if ch == prev {
            count = count + 1;
        }
        if ch != prev {
            result = Concat(result, prev);
            result = Concat(result, ToString(count));
            prev = ch;
            count = 1;
        }
        i = i + 1;
    }
    result = Concat(result, prev);
    result = Concat(result, ToString(count));
    return result;
}

func Main() -> Void {
    Log(RunLength("aaabbc"));
    Log(RunLength("abcd"));
    Log(RunLength("aaaa"));
    Log(RunLength("a"));
    Log(RunLength(""));
}
