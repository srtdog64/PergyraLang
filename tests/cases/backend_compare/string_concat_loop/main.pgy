func Greet(name: String, formal: Bool) -> String {
    if formal {
        return "Greetings, " + name + ".";
    }
    return "Hi, " + name + "!";
}

func Repeat(s: String, n: Int) -> String {
    let result: String = "";
    let i: Int = 0;
    while i < n {
        result = result + s;
        i = i + 1;
    }
    return result;
}

func Main() -> Void {
    Log(Greet("Alice", false));
    Log(Greet("Mr. Bob", true));
    Log(Repeat("ab", 3));
    Log(Repeat("x", 5));
    Log(Repeat("", 100));
}
