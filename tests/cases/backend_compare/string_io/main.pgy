func Main() -> Void {
    let s: String = Concat(Upper(Trim("  hi")), Lower(" THERE"));
    Log(StringLength(s));
    Log(Contains(s, "HI"));
    Log(StringIndexOf(s, "there"));
    WriteFile("io.txt", Replace(s, "HI", "BYE"));
    Log(FileExists("io.txt"));
    let out: String = ReadFile("io.txt");
    Log(out);
}
