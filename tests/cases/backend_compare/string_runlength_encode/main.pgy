func Rle(s: String) -> String {
    let n: Int = StringLength(s);
    if n == 0 { return ""; }
    let result: String = "";
    let i: Int = 0;
    while i < n {
        let ch: String = Substring(s, i, i + 1);
        let count: Int = 1;
        while i + count < n && Substring(s, i + count, i + count + 1) == ch {
            count = count + 1;
        }
        result = result + ch + ToString(count);
        i = i + count;
    }
    return result;
}

func Main() -> Void {
    Log(Rle("aaabbc"));
    Log(Rle("abc"));
    Log(Rle("aaaaaa"));
    Log(Rle(""));
    Log(Rle("a"));
    Log(Rle("aabbccdd"));
}
