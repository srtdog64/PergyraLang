func CountWords(s: String) -> Int {
    let n: Int = StringLength(s);
    let i: Int = 0;
    let words: Int = 0;
    let in_word: Bool = false;
    while i < n {
        let ch: String = Substring(s, i, i + 1);
        if ch == " " {
            in_word = false;
        } else {
            if !in_word { words = words + 1; }
            in_word = true;
        }
        i = i + 1;
    }
    return words;
}

func Main() -> Void {
    Log(CountWords(""));
    Log(CountWords("hello"));
    Log(CountWords("hello world"));
    Log(CountWords("  spaced  out  "));
    Log(CountWords("one two three four"));
    Log(CountWords("   "));
}
