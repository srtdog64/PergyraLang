func FirstWord(s: String) -> String {
    let n: Int = StringLength(s);
    let i: Int = 0;
    while i < n {
        let ch: String = Substring(s, i, i + 1);
        if ch == " " { return Substring(s, 0, i); }
        i = i + 1;
    }
    return s;
}

func WordCount(s: String) -> Int {
    let n: Int = StringLength(s);
    if n == 0 { return 0; }
    let count: Int = 1;
    let i: Int = 0;
    while i < n - 1 {
        let ch: String = Substring(s, i, i + 1);
        let nx: String = Substring(s, i + 1, i + 2);
        if ch == " " && nx != " " { count = count + 1; }
        i = i + 1;
    }
    return count;
}

func Main() -> Void {
    Log(FirstWord("hello world"));
    Log(FirstWord("solo"));
    Log(FirstWord(""));
    Log(FirstWord("a b c"));
    Log(WordCount("hello world"));
    Log(WordCount("one two three four"));
    Log(WordCount(""));
    Log(WordCount("solo"));
}
