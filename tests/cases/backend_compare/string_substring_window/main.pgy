func LongestEqualRun(s: String) -> Int {
    let n: Int = StringLength(s);
    if n == 0 { return 0; }
    let best: Int = 1;
    let cur: Int = 1;
    let i: Int = 1;
    while i < n {
        if Substring(s, i, i + 1) == Substring(s, i - 1, i) {
            cur = cur + 1;
            if cur > best { best = cur; }
        } else {
            cur = 1;
        }
        i = i + 1;
    }
    return best;
}

func Main() -> Void {
    Log(LongestEqualRun("aaabbc"));
    Log(LongestEqualRun("abcdefg"));
    Log(LongestEqualRun("aaaaaa"));
    Log(LongestEqualRun(""));
    Log(LongestEqualRun("ab"));
    Log(LongestEqualRun("aabbccdd"));
}
