func ParseDigit(s: String) -> Int {
    if s == "0" { return 0; }
    if s == "1" { return 1; }
    if s == "2" { return 2; }
    if s == "3" { return 3; }
    if s == "4" { return 4; }
    if s == "5" { return 5; }
    if s == "6" { return 6; }
    if s == "7" { return 7; }
    if s == "8" { return 8; }
    if s == "9" { return 9; }
    return -1;
}

func SumDigits(s: String) -> Int {
    let total: Int = 0;
    let i: Int = 0;
    while i < StringLength(s) {
        let d: Int = ParseDigit(Substring(s, i, 1));
        if d >= 0 { total = total + d; }
        i = i + 1;
    }
    return total;
}

func Main() -> Void {
    Log(SumDigits("123"));
    Log(SumDigits("9876"));
    Log(SumDigits("0"));
    Log(SumDigits(""));
    Log(SumDigits("a1b2c3"));
}
