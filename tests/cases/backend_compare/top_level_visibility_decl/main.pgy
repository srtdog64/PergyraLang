private class InternalCounter {
    let value: Int;

    func Next(self) -> Int {
        return value + 1;
    }
}

public subject VisibleRunner {
    let counter: InternalCounter;

    func Run(self) -> Int {
        return counter.Next();
    }
}

func Main() -> Void {
    let runner = VisibleRunner(InternalCounter(4));
    Log(runner.Run());
}
