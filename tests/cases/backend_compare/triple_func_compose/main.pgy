func Inc(n: Int) -> Int { return n + 1; }
func Dec(n: Int) -> Int { return n - 1; }
func Twice(n: Int) -> Int { return n * 2; }
func Triple(n: Int) -> Int { return n * 3; }

func Combine(a: Int, b: Int, c: Int) -> Int {
    return Inc(Twice(Dec(a))) + Triple(b) - Twice(Inc(c));
}

func DeepCompose(n: Int) -> Int {
    return Inc(Inc(Inc(Twice(Twice(Triple(n))))));
}

func Main() -> Void {
    Log(Combine(5, 3, 2));
    Log(Combine(0, 0, 0));
    Log(Combine(-1, 2, 4));
    Log(DeepCompose(1));
    Log(DeepCompose(0));
    Log(DeepCompose(2));
}
