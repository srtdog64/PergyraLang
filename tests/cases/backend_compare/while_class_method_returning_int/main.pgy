class Counter {
    let n: Int;

    func Square(self) -> Int {
        return n * n;
    }
}

func SumSquares(seeds: Array<Int>, count: Int) -> Int {
    let total: Int = 0;
    let i: Int = 0;
    while i < count {
        let c: Counter = Counter(seeds[i]);
        total = total + c.Square();
        i = i + 1;
    }
    return total;
}

func Main() -> Void {
    let arr1: Array<Int> = [1, 2, 3];
    Log(SumSquares(arr1, 3));
    let arr2: Array<Int> = [4, 5, 6];
    Log(SumSquares(arr2, 3));
    let arr3: Array<Int> = [0];
    Log(SumSquares(arr3, 1));
    let arr4: Array<Int> = [10, 20];
    Log(SumSquares(arr4, 2));
}
