func Pick(n: Int) -> Int {
    return n * 2 + 1;
}

func Main() -> Void {
    let acc: Slot<Int> = ClaimSlot();
    Write(acc, 0);
    let i: Slot<Int> = ClaimSlot();
    Write(i, 0);
    while Read(i) < 4 {
        let x: Int = Pick(Read(i));
        Write(acc, Read(acc) + x);
        Write(i, Read(i) + 1);
    }
    Log(Read(acc));
}
