within BattleZone {
    subject Player {
        let hp: Int;

        action Attack(self) -> Void
            authorized by self
            causes Poisoned
        {
            hp = hp - 1;
        }
    }
}

effect Poisoned for bearer: Player { }

zone BattleZone {
    subject slot player: Player
    effect pool poison: Poisoned capacity 4
    authority player
    state poisoned: effect poison on player
}

world GameWorld {
    zone battle: BattleZone
    state battleLayer: zone battle layer poison
    state battlePoisoned: zone battle state poisoned
    state ready: all battleLayer, battlePoisoned
    activate battle

    func AttackAndReport(self) -> Void {
        Log("direct.layer.before=" + ToString(HasZoneLayer(battle, poison)));
        Log("world.layer.before=" + ToString(HasZone(battleLayer)));
        battle.player.Attack();
        Log("direct.layer.after=" + ToString(HasZoneLayer(battle, poison)));
        Log("direct.state.after=" + ToString(HasZoneState(battle, poisoned)));
        Log("world.layer.after=" + ToString(HasZone(battleLayer)));
        Log("world.state.after=" + ToString(HasZone(battlePoisoned)));
        Log("world.ready.after=" + ToString(HasZone(ready)));
        Log("hp.after=" + ToString(battle.player.hp));
    }
}

func Main() -> Void {
    let world = GameWorld(BattleZone(Player(9)));
    world.AttackAndReport();
}
