ability Payable {
    func CanPay() -> Bool;
}

within PaymentZone {
    subject Buyer {
        let displayName: String;
        let mut total: Int;

        action Promote(self) -> Void
            requires Payable
            authorized by self
            causes Charged
        {
            self.total = self.total + 1;
        }
    }
}

role BuyerPayable for Buyer {
    impl ability Payable {
        func CanPay() -> Bool {
            return true;
        }
    }
}

object BuyerView {
    label: String;
    totalPurchases: Int;
}

tobject BuyerPacket {
    user: String;
    totalPurchases: Int;
}

effect Charged for bearer: Buyer {
}

zone PaymentZone {
    subject slot buyer: Buyer
    object slot buyerView: BuyerView
    tobject slot buyerPacket: BuyerPacket
    effect slot charged: Charged
    authority buyer requires Payable

    refresh buyerView from buyer by buyer map {
        label <- displayName;
        totalPurchases <- total;
    }

    publish buyerPacket from buyer by buyer map {
        user <- displayName;
        totalPurchases <- total;
    }

    func Ready(self) -> Bool {
        return HasProjection(buyerView) && HasProjection(buyerPacket);
    }

    func Label(self) -> String {
        return buyerView.label;
    }
}

world PaymentWorld {
    zone payment: PaymentZone

    func Ready(self) -> Bool {
        return HasZoneProjection(payment, buyerView)
            && HasZoneProjection(payment, buyerPacket);
    }
}

intent Checkout(payment: PaymentZone, buyer: Buyer) {
    step Promote {
        on: buyer.Promote();
        expect: true;
    }
}

func Main() -> Void {
    let buyer = Buyer("Mina", 2);
    let payment = PaymentZone(Clone(buyer));
    let world = PaymentWorld(Clone(payment));

    Checkout(payment, buyer);

    Log("payment.ready=" + ToString(payment.Ready()));
    Log("payment.label=" + payment.Label());
    Log("history.count=" + ToString(IntentHistoryCount()));
    Log("world.ready=" + ToString(world.Ready()));
}
