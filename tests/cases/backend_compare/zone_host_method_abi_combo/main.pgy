struct Strategy {
    let aggression: Int;
    let guardBias: Int;
}

class Weapon {
    let power: Int;

    func Strain(self, stateId: Int, strategy: Strategy, pulse: Int) -> Int {
        return 1 + stateId + pulse + power - strategy.guardBias;
    }
}

subject Hero {
    let weapon: Weapon;
    let hp: Int;

    action Heal(self, amount: Int) -> Int {
        hp = hp + amount;
        return hp;
    }
}

class Arena {
    let hero: Hero;

    func MemberWeapon(self) -> Weapon {
        return hero.weapon;
    }

    func Hit(self, strategy: Strategy) -> Int {
        let w = MemberWeapon();
        return w.Strain(2, strategy, 1);
    }
}

zone PaymentZone {
    subject slot buyer: Hero
    shared captured: Int = 0

    func Capture(self, arena: Arena, strategy: Strategy, shipping: Int) -> Int {
        let boost = arena.Hit(strategy);
        let amount = buyer.Heal(shipping + boost);
        captured = amount;
        return captured;
    }
}

func RunCapture(payment: PaymentZone, arena: Arena, strategy: Strategy, shipping: Int) -> Int {
    return payment.Capture(arena, strategy, shipping);
}

func Main() -> Void {
    let payment = PaymentZone(Hero(Weapon(3), 10));
    let arena = Arena(Hero(Weapon(3), 0));
    let strategy = Strategy(5, 1);
    let got = RunCapture(payment, arena, strategy, 6);
    Log("got=" + ToString(got));
    Log("captured=" + ToString(payment.captured));
    Log("buyer.hp=" + ToString(payment.buyer.hp));
}
