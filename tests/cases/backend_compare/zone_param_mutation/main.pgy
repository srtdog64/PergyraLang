subject Buyer {
    let hp: Int;

    action Heal(self, amount: Int) -> Int {
        hp = hp + amount;
        return hp;
    }
}

zone PaymentZone {
    subject slot buyer: Buyer
    shared captured: Int = 0

    func Capture(self, shipping: Int) -> Int {
        let amount = buyer.Heal(shipping);
        captured = amount;
        return captured;
    }
}

func RunCapture(payment: PaymentZone, shipping: Int) -> Int {
    return payment.Capture(shipping);
}

func Main() -> Void {
    let payment = PaymentZone(Buyer(10), 0);
    let got = RunCapture(payment, 6);
    Log("got=" + ToString(got));
    Log("captured=" + ToString(payment.captured));
    Log("buyer.hp=" + ToString(payment.buyer.hp));
}
