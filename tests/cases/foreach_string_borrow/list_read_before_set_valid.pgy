// Each iteration reads its binding before ListSet, and the next iteration
// binds a fresh element. Admitted; prints 5 6 99 2.
func Swap(seed: Int) -> Int {
    var items: List<String> = ListNew();
    ListPush(items, ToString(seed));
    ListPush(items, ToString(seed + 1));
    var n: Int = 0;
    for name in items {
        Log(name);
        ListSet(items, 0, ToString(99));
        n = n + 1;
    }
    Log(ListGet(items, 0));
    return n;
}
func Main() -> Void { Log(Swap(5)); }
