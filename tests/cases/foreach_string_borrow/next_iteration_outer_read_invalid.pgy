// `first` borrows names[0]; the first iteration frees it with the owned
// ArraySet and the second iteration reads it. Refused at the read.
func Walk(seed: Int) -> Int {
    var names: Array<String> = [];
    ArrayPush(names, ToString(seed));
    ArrayPush(names, ToString(seed + 1));
    let first = names[0];
    var n: Int = 0;
    for name in names {
        Log(first);
        ArraySet(names, 0, ToString(99));
        n = n + 1;
    }
    return n;
}
func Main() -> Void { Log(Walk(5)); }
