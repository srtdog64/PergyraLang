// Each iteration reads its binding before the owned ArrayPop. Admitted;
// prints 5 6 2.
func Shrink(seed: Int) -> Int {
    var names: Array<String> = [];
    ArrayPush(names, ToString(seed));
    ArrayPush(names, ToString(seed + 1));
    ArrayPush(names, ToString(seed + 2));
    var n: Int = 0;
    for name in names {
        Log(name);
        ArrayPop(names);
        n = n + 1;
    }
    return n;
}
func Main() -> Void { Log(Shrink(5)); }
