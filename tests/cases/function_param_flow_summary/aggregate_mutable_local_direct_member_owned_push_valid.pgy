// A `var` aggregate root that still holds its initializer is as exact a place
// as a `let` one: permission to replace is not a replacement. The landed
// String copy enters the Array field of that unchanged root.
struct Rows {
    names: Array<String>;
}

func Append(ref text: String) -> Void {
    var rows: Rows = Rows([Concat("a", "")]);
    ArrayPush(rows.names, text);
}

func Main() -> Int {
    let text: String = Concat("b", "");
    Append(text);
    return 0;
}
