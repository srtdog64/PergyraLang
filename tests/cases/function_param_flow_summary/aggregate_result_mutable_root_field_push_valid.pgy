// A `var` aggregate root that is never replaced keeps the exact result
// identity of its initializer for the later field move and owned push.
struct Rows {
    names: Array<String>;
}

func MakeRows() -> Rows {
    let names: Array<String> = [Concat("a", "")];
    return Rows(names);
}

func Append() -> Void {
    var rows: Rows = MakeRows();
    var names: Array<String> = rows.names;
    ArrayPush(names, Concat("b", ""));
}

func Main() -> Int {
    Append();
    return 0;
}
