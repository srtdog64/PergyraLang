// The first analysis refuses the loan this program's ref call lends; the
// next copies it where the call makes it (Clone copies the result whole).
// The getter's String is storage of the aggregate Main owns. Main replaces
// that element while the loan is still to be printed, so the loan is
// refused even though it never leaves Main.
struct Facts {
    names: Array<String>;
}

func NameAt(ref facts: Facts, index: Int) -> String {
    return facts.names[index];
}

func Main() -> Int {
    var facts: Facts = Facts([StringConcat("ab", ToString(7))]);
    let name: String = NameAt(facts, 0);
    ArraySet(facts.names, 0, StringConcat("zz", ToString(8)));
    Print(name);
    return 0;
}
