// The first analysis refuses the loan this program's ref call lends; the
// next copies it where the call makes it (Clone copies the result whole).
// The getter's String is a loan of the borrowed aggregate, and so is the
// Label that LabelOf builds from it. MakeLabel returns that Label past the
// aggregate it owns.
struct Facts {
    names: Array<String>;
}

struct Label {
    text: String;
}

func NameAt(ref facts: Facts, index: Int) -> Option<String> {
    if index < 0 || index >= ArrayLength(facts.names) {
        return None;
    }
    return Some(facts.names[index]);
}

func LabelOf(ref facts: Facts) -> Label {
    let name: Option<String> = NameAt(facts, 0);
    if !IsSome(name) {
        return Label("");
    }
    return Label(UnwrapOption(name));
}

func MakeLabel() -> Label {
    let facts: Facts = Facts([StringConcat("ab", "c")]);
    return LabelOf(facts);
}

func Main() -> Int {
    let label: Label = MakeLabel();
    Print(label.text);
    return 0;
}
