// Each field is detached into its exact local, replaced with fresh storage,
// and handed to a callee whose current summary releases that storage.
struct State { ids: Array<Int>; invalid: Array<Bool>; }

func SinkIds(own ids: Array<Int>) -> Void
{
    Log(ArrayLength(ids));
    ArrayDrop(ids);
}

func SinkInvalid(own invalid: Array<Bool>) -> Void
{
    Log(ArrayLength(invalid));
    ArrayDrop(invalid);
}

func Retire(inout state: State) -> Void
{
    let ids: Array<Int> = state.ids;
    let invalid: Array<Bool> = state.invalid;
    state.ids = [];
    state.invalid = [];
    SinkIds(ids);
    SinkInvalid(invalid);
}

func Main() -> Void
{
    let state: State = State([7], [true]);
    Retire(state);
    Log(ArrayLength(state.ids));
    Log(ArrayLength(state.invalid));
}
