// As SemanticAstGenericSpecializationError's callers: one empty Array goes to
// two by-value formals of one call, and both are kept in its result. The
// earlier argument is copied where the call takes it, so the result's two
// fields own separate storage and a push into one leaves the other empty.
struct Facts {
    ok: Bool;
    a: Array<Int>;
    b: Array<Int>;
    names: Array<String>;
}

func FactsError(a: Array<Int>, b: Array<Int>, names: Array<String>) -> Facts {
    return Facts(false, a, b, names);
}

func Build(flag: Bool) -> Facts {
    if flag {
        let empty_ints: Array<Int> = [];
        let empty_strings: Array<String> = [];
        return FactsError(empty_ints, empty_ints, empty_strings);
    }
    let a: Array<Int> = [1];
    let b: Array<Int> = [2];
    let names: Array<String> = ["x"];
    return Facts(true, a, b, names);
}

func Main() -> Int {
    var facts: Facts = Build(true);
    ArrayPush(facts.a, 7);
    Print(ToString(ArrayLength(facts.a) + ArrayLength(facts.b)));
    return 0;
}
