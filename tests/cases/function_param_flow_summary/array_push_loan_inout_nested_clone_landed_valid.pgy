// Collect pushes a loan of its borrowed facts into the inout Array it was
// given, and Fill's facts die before Main reads the Array. Label contains one
// nested Array layer whose concrete leaves are Int, so both backends copy the
// whole Label and the next analysis lands a Clone at the push.
struct Facts {
    names: Array<String>;
}

struct Label {
    text: String;
    grid: Array<Array<Int>>;
}

func LabelOf(ref facts: Facts) -> Label {
    return Label(facts.names[0], [[1]]);
}

func Collect(ref facts: Facts, inout out: Array<Label>) -> Void {
    ArrayPush(out, LabelOf(facts));
}

func Fill(inout out: Array<Label>) -> Void {
    let facts: Facts = Facts([StringConcat("ab", ToString(7))]);
    Collect(facts, out);
}

func Main() -> Int {
    var labels: Array<Label> = [];
    Fill(labels);
    Print(labels[0].text);
    return 0;
}
