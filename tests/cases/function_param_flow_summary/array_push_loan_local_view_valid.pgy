// LabelsOf pushes Labels that lend its borrowed facts into a local Array,
// swaps two of them with ArraySet and returns the Array inside a Shelf.
// Each push and set stores the loan in the Array, so the Shelf lends the
// facts; Main reads it while it owns them.
struct Facts {
    names: Array<String>;
}

struct Label {
    text: String;
}

struct Shelf {
    labels: Array<Label>;
}

func LabelAt(ref facts: Facts, index: Int) -> Label {
    return Label(facts.names[index]);
}

func LabelsOf(ref facts: Facts) -> Shelf {
    let labels: Array<Label> = [];
    ArrayPush(labels, LabelAt(facts, 0));
    ArrayPush(labels, LabelAt(facts, 1));
    let first: Label = labels[0];
    ArraySet(labels, 0, labels[1]);
    ArraySet(labels, 1, first);
    return Shelf(labels);
}

func Main() -> Int {
    let facts: Facts = Facts([StringConcat("ab", "c"), StringConcat("d", "e")]);
    let shelf: Shelf = LabelsOf(facts);
    Print(shelf.labels[0].text);
    return 0;
}
