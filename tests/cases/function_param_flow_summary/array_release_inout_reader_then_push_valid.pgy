func ReadLength(ref names: Array<String>) -> Int
{
    return ArrayLength(names);
}

func Append(inout names: Array<String>) -> Int
{
    let before: Int = ReadLength(names);
    ArrayPushOwnedString(names, Concat("added", " row"));
    return before + 1;
}

func Main() -> Void
{
    let map: HashMap<String, Int> = MapNew<String, Int>();
    MapSet(map, "key", 1);
    let names: Array<String> = MapKeys(map);
    Log(Append(names));
    ArrayDropOwnedStrings(names);
}
