func Inspect(ref values: Array<Int>) -> Int
{
    return ArrayLength(values);
}

func Main() -> Void
{
    let values: Array<Int> = [1];
    let names: Array<String> = [];
    var i: Int = 0;
    while i < 2
    {
        let count: Int = Inspect(values);
        ArrayPushOwnedString(names, "entry");
        i = i + count;
    }
    Log(ArrayLength(names));
    ArrayDropOwnedStrings(names);
}
