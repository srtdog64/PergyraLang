extern "C" { func Keep(keys: Array<String>) -> Void; }

func Leak(keys: Array<String>) -> Void
{
    Keep(keys);
}

func Grow(inout keys: Array<String>) -> Int
{
    ArrayPushOwnedString(keys, Concat("added", " row"));
    return ArrayLength(keys);
}

func Main() -> Void
{
    var map: HashMap<String, Int> = MapNew<String, Int>();
    MapSet(map, "key", 1);
    var keys: Array<String> = MapKeys(map);
    Leak(keys);
    Log(Grow(keys));
}
