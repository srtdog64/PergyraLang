// Pushing an owned element of rows into copies would alias storage that
// ArrayDropOwnedStrings frees; the push lands as an owned copy instead,
// so copies[0] stays valid after the drop.
func Main() -> Void
{
    let rows: Array<String> = [];
    ArrayPushOwnedString(rows, Concat("owned", " value"));
    let copies: Array<String> = [];
    ArrayPush(copies, rows[0]);
    ArrayDropOwnedStrings(rows);
    Log(copies[0]);
}
