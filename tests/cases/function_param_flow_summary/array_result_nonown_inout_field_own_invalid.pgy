struct State { rows: Array<String>; }

func Extract(inout state: State) -> Array<String>
{
    return state.rows;
}

func Consume(own rows: Array<String>) -> Int
{
    return ArrayLength(rows);
}

func Main() -> Void
{
    var state: State = State(["row"]);
    let rows: Array<String> = Extract(state);
    Log(Consume(rows));
    Log(ArrayLength(state.rows));
}
