// No proof admits the callee keeping or returning the String element, so
// the next analysis copies the element where the call takes it, and the
// Array's later release or change no longer reaches it.
func OwnedRows() -> Array<String> {
    var rows: Array<String> = [];
    ArrayPushOwnedString(rows, Concat("owned", " value"));
    return rows;
}

func Retain(inout output: String, text: String) -> Void {
    let kept: String = text; output = kept;
}

func Main() -> Void {
    var output: String = "seed";
    if true {
        let rows: Array<String> = OwnedRows();
        let text: String = rows[0];
        defer { ArrayDropOwnedStrings(rows); };
        Retain(output, text);
    }
    Log(output);
}
