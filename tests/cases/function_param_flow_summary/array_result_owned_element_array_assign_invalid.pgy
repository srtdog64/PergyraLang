func OwnedRows() -> Array<String> {
    let rows: Array<String> = [];
    ArrayPushOwnedString(rows, Concat("owned", " value"));
    return rows;
}

func Main() -> Void {
    let source: Array<String> = OwnedRows();
    let destination: Array<String> = ["placeholder"];
    destination[0] = source[0];
    ArrayDropOwnedStrings(source);
    Log(destination[0]);
}
