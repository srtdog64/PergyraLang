func OwnedRows() -> Array<String> {
    let rows: Array<String> = [];
    ArrayPushOwnedString(rows, Concat("owned", " value"));
    return rows;
}

func Main() -> Void {
    let rows: Array<String> = OwnedRows();
    let output: DeviceSlot<String> = ClaimDeviceSlot();
    DeviceWrite(output, Concat("", rows[0]));
    ArrayDropOwnedStrings(rows);
    let text = DeviceRead(output);
    Log(text);
    ReleaseDeviceSlot(output);
}
