func OwnedRows() -> Array<String>
{
    let rows: Array<String> = [];
    ArrayPushOwnedString(rows, Concat("owned", " value"));
    return rows;
}

func CaptureCopy(inout output: String, ref rows: Array<String>) -> Void
{
    output = Concat("", rows[0]);
}

func Main() -> Void
{
    let rows: Array<String> = OwnedRows();
    var output: String = "";
    CaptureCopy(output, rows);
    ArrayDropOwnedStrings(rows);
    Log(output);
}
