// Capture keeps an element of its ref Array in its inout output, so the
// next analysis assigns a copy there; Main may then release the Array's
// Strings before it prints the output.
func OwnedRows() -> Array<String>
{
    let rows: Array<String> = [];
    ArrayPushOwnedString(rows, Concat("owned", " value"));
    return rows;
}

func Capture(inout output: String, ref rows: Array<String>) -> Void
{
    output = rows[0];
}

func Main() -> Void
{
    let rows: Array<String> = OwnedRows();
    var output: String = "";
    Capture(output, rows);
    ArrayDropOwnedStrings(rows);
    Print(output);
}
