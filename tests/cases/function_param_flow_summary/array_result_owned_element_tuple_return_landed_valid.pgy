// The first analysis refuses this String where it leaves its Array owner;
// the next copies it there (Clone copies a String whole).
func OwnedRows() -> Array<String> {
    var rows: Array<String> = [];
    ArrayPushOwnedString(rows, Concat("owned", " value"));
    return rows;
}

func Wrap(ref rows: Array<String>) -> (String, Int) {
    return (rows[0], 0);
}

func Main() -> Void {
    let rows: Array<String> = OwnedRows();
    let (output, marker) = Wrap(rows);
    ArrayDropOwnedStrings(rows);
    Log(output);
}
