func OwnedRows() -> Array<String>
{
    var rows: Array<String> = [];
    ArrayPushOwnedString(rows, Concat("owned", " value"));
    return rows;
}

func Corrupt(inout rows: Array<String>) -> Void
{
    rows[0] = "borrowed";
}

func Main() -> Void
{
    var rows: Array<String> = OwnedRows();
    Corrupt(rows);
    ArrayDropOwnedStrings(rows);
}
