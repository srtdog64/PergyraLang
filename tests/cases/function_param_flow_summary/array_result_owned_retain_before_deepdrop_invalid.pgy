struct Count { text: String; }

func OwnedRows() -> Array<String>
{
    let rows: Array<String> = [];
    ArrayPushOwnedString(rows, Concat("owned", " value"));
    return rows;
}

func ReadCount(rows: Array<String>) -> Count
{
    return Count(rows[0]);
}

func Main() -> Void
{
    let rows: Array<String> = OwnedRows();
    let count: Count = ReadCount(rows);
    ArrayDropOwnedStrings(rows);
    Log(count.text);
}
