// Unique fills a local Array through Mark's inout formal, sorts the Array
// and records its first id in an inout output. The sort permutes the local
// Array in place and returns it, so Unique only reads its ref input, and
// Check may pass its own ref input on.
struct Index {
    counts: Array<Int>;
}

func Mark(inout ids: Array<Int>, value: Int) -> Void {
    ArrayPush(ids, value);
}

func Unique(ref index: Index, inout seen: Array<Int>) -> Bool {
    var ids: Array<Int> = [];
    var i: Int = 0;
    while i < ArrayLength(index.counts) {
        Mark(ids, index.counts[i]);
        i = i + 1;
    }
    ArraySort(ids);
    ArrayPush(seen, ids[0]);
    return ids[0] == 1;
}

func Check(ref index: Index, inout seen: Array<Int>) -> Bool {
    return Unique(index, seen);
}

func Main() -> Int {
    let index: Index = Index([3, 1, 2]);
    var seen: Array<Int> = [];
    if Check(index, seen) {
        Print(ToString(ArrayLength(seen) + index.counts[0]));
    }
    return 0;
}
