// As borrowed_owner_loan_grown_landed_valid, but Borrow also returns the
// borrowed groups field. Groups hold Arrays, so the compiler cannot make the
// complete result independent by copying only env.rows. The loan stays
// refused instead of leaving an uncopyable borrowed field in the result.
struct Group {
    items: Array<Int>;
}

struct Env {
    rows: String;
    groups: Array<Group>;
}

func Borrow(ref env: Env) -> Env {
    return Env(env.rows, env.groups);
}

func Append(inout env: Env, row: String) -> Void {
    env.rows = Concat(env.rows, row);
}

func Nest(inout env: Env) -> Int {
    var inner: Env = Borrow(env);
    Append(inner, "bc");
    return StringLength(inner.rows) * 10 + StringLength(env.rows);
}

func Main() -> Int {
    var env: Env = Env("a", []);
    Print(ToString(Nest(env)));
    return 0;
}
