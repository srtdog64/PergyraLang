// Since 2026-10-22 the moving call takes a copy of the argument, so the
// later use is admitted (moved_argument_used_again_is_copied). Below: the move.
// SortedFirst binds a local to its by-value holder's items and sorts it in
// place, which permutes the storage Main's holder shares: the call moves the
// holder, and Main's later use is refused.
struct Holder {
    items: Array<Int>;
}

func SortedFirst(holder: Holder) -> Int {
    var items: Array<Int> = holder.items;
    ArraySort(items);
    return items[0];
}

func Main() -> Int {
    let holder: Holder = Holder([3, 1, 2]);
    let first: Int = SortedFirst(holder);
    Print(ToString(first * 10 + holder.items[0]));
    return 0;
}
