// Bump rebinds its by-value build to the Build WithCount returns, which
// holds the build's items, and then only reads it. The build keeps the
// storage it shares with Main's build, so Main's later use is admitted.
struct Build {
    items: Array<Int>;
    count: Int;
}

func WithCount(build: Build, count: Int) -> Build {
    return Build(build.items, count);
}

func Bump(build: Build) -> Int {
    build = WithCount(build, build.count + 1);
    return ArrayLength(build.items) + build.count;
}

func Main() -> Int {
    let build: Build = Build([1, 2], 0);
    let n: Int = Bump(build);
    Print(ToString(n + ArrayLength(build.items) + build.items[1]));
    return 0;
}
