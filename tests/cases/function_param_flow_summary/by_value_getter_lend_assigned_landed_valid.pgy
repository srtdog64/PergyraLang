// AtomText lends Collect's by-value arena, and Collect assigns the loan to
// a field of its inout labels before it uses the arena again. The loan is
// copied where it leaves, as out.label = Clone(first).
struct Arena {
    atoms: Array<String>;
}

struct Labels {
    label: String;
}

func AtomText(arena: Arena, index: Int) -> String {
    return arena.atoms[index];
}

func Collect(arena: Arena, inout out: Labels) -> Int {
    let first: String = AtomText(arena, 0);
    out.label = first;
    return ArrayLength(arena.atoms);
}

func Main() -> Int {
    let arena: Arena = Arena([StringConcat("ab", "")]);
    var out: Labels = Labels(StringConcat("", ""));
    Print(ToString(Collect(arena, out)));
    Print(out.label);
    return 0;
}
