// Part lends Main's local outer, Main builds a new Outer around the loan
// and pushes onto its items. The new Outer holds the loan, so the pushes
// change outer: the loan is copied where it is made, and outer keeps its
// two items.
struct Inner {
    items: Array<Int>;
}

struct Outer {
    inner: Inner;
    count: Int;
}

func Part(outer: Outer) -> Inner {
    return outer.inner;
}

func Main() -> Int {
    let outer: Outer = Outer(Inner([1, 2]), 0);
    let part: Inner = Part(outer);
    let wrapped: Outer = Outer(part, 1);
    ArrayPush(wrapped.inner.items, 9);
    ArrayPush(wrapped.inner.items, 9);
    ArrayPush(wrapped.inner.items, 9);
    ArrayPush(wrapped.inner.items, 9);
    Print(ToString(ArrayLength(wrapped.inner.items) + ArrayLength(outer.inner.items) + outer.inner.items[1]));
    return 0;
}
