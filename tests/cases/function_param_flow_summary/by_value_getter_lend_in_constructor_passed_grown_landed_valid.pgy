// Part lends Main's local outer. Main builds a new Outer around the loan and
// hands it to Fill, which pushes onto its items. The new Outer shares the
// loan's storage and so outer's: it is copied where it leaves, and the loan
// where it is made, since building a value from a loan counts as a change
// of it. outer keeps its two items.
struct Inner {
    items: Array<Int>;
}

struct Outer {
    inner: Inner;
    count: Int;
}

func Part(outer: Outer) -> Inner {
    return outer.inner;
}

func Fill(outer: Outer) -> Int {
    ArrayPush(outer.inner.items, 9);
    ArrayPush(outer.inner.items, 9);
    ArrayPush(outer.inner.items, 9);
    ArrayPush(outer.inner.items, 9);
    return ArrayLength(outer.inner.items);
}

func Main() -> Int {
    let outer: Outer = Outer(Inner([1, 2]), 0);
    let part: Inner = Part(outer);
    let n: Int = Fill(Outer(part, 1));
    Print(ToString(n + ArrayLength(outer.inner.items) + outer.inner.items[1]));
    return 0;
}
