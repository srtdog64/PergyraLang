// BoxOf lends Use's by-value arena, and Use hands the loan to Touch as an
// inout argument, the caller's own place, which no copy can stand in for:
// the later use of the arena is refused.
struct Box {
    names: Array<String>;
}

struct Arena {
    box: Box;
}

func BoxOf(arena: Arena) -> Box {
    return arena.box;
}

func Touch(inout box: Box) -> Int {
    return ArrayLength(box.names);
}

func Use(arena: Arena) -> Int {
    var box: Box = BoxOf(arena);
    let n: Int = Touch(box);
    return n + ArrayLength(arena.box.names);
}

func Main() -> Int {
    let arena: Arena = Arena(Box([StringConcat("ab", "")]));
    Print(ToString(Use(arena)));
    return 0;
}
