// BoxOf lends Use's by-value arena, and Use hands the loan to Touch as an
// inout argument, the caller's own place, where no copy can stand in. The
// Box holds an Array of structs, which Clone copies by value, so no copy
// can land where the loan is made either: the later use is refused.
struct Part {
    name: String;
}

struct Box {
    parts: Array<Part>;
}

struct Arena {
    box: Box;
}

func BoxOf(arena: Arena) -> Box {
    return arena.box;
}

func Touch(inout box: Box) -> Int {
    return ArrayLength(box.parts);
}

func Use(arena: Arena) -> Int {
    var box: Box = BoxOf(arena);
    let n: Int = Touch(box);
    return n + ArrayLength(arena.box.parts);
}

func Main() -> Int {
    let arena: Arena = Arena(Box([Part(StringConcat("ab", ""))]));
    Print(ToString(Use(arena)));
    return 0;
}
