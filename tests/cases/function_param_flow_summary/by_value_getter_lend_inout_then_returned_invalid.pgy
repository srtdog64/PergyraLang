// BoxOf lends Use's by-value arena. The loan first leaves as Touch's inout
// argument, which no copy can stand in for, and then as Use's result. The
// Box holds an Array of structs, which Clone copies by value, so no copy
// lands where the loan is made either: the later use is refused.
struct Part {
    name: String;
}

struct Box {
    parts: Array<Part>;
}

struct Arena {
    box: Box;
}

func BoxOf(arena: Arena) -> Box {
    return arena.box;
}

func Touch(inout box: Box) -> Int {
    return ArrayLength(box.parts);
}

func Use(arena: Arena) -> Box {
    var box: Box = BoxOf(arena);
    let n: Int = Touch(box);
    Print(ToString(n + ArrayLength(arena.box.parts)));
    return box;
}

func Main() -> Int {
    let arena: Arena = Arena(Box([Part(StringConcat("ab", ""))]));
    Print(ToString(ArrayLength(Use(arena).parts)));
    return 0;
}
