// Part lends Main's local outer, and Main pushes onto the loan's items while
// it still uses outer. The loan shares outer's storage, so the push would
// change outer: the loan is copied where it is made, and outer keeps its
// two items.
struct Inner {
    items: Array<Int>;
}

struct Outer {
    inner: Inner;
    count: Int;
}

func Part(outer: Outer) -> Inner {
    return outer.inner;
}

func Main() -> Int {
    let outer: Outer = Outer(Inner([1, 2]), 0);
    var part: Inner = Part(outer);
    ArrayPush(part.items, 9);
    ArrayPush(part.items, 9);
    ArrayPush(part.items, 9);
    ArrayPush(part.items, 9);
    Print(ToString(ArrayLength(part.items) + ArrayLength(outer.inner.items) + outer.inner.items[1]));
    return 0;
}
