// AtomText lends Make's local arena, and Make returns the loan past the
// arena it owns. The loan is copied where it leaves, as return Clone(first),
// so Make may use the arena again.
struct Arena {
    atoms: Array<String>;
}

func AtomText(arena: Arena, index: Int) -> String {
    return arena.atoms[index];
}

func Make() -> String {
    let arena: Arena = Arena([StringConcat("ab", "")]);
    let first: String = AtomText(arena, 0);
    Print(ToString(ArrayLength(arena.atoms)));
    return first;
}

func Main() -> Int {
    Print(Make());
    return 0;
}
