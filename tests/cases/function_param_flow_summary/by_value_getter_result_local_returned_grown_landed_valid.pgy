// Since 2026-10-22 the moving call takes a copy of the argument, so the
// later use is admitted (moved_argument_used_again_is_copied). Below: the move.
// Pick keeps Part's result in a local and returns it, so Pick's result
// holds its by-value outer. Grow pushes onto that result's items, which
// share storage with Main's outer: Main's later use is refused.
struct Inner {
    items: Array<Int>;
}

struct Outer {
    inner: Inner;
    count: Int;
}

func Part(outer: Outer) -> Inner {
    return outer.inner;
}

func Pick(outer: Outer) -> Inner {
    let part: Inner = Part(outer);
    return part;
}

func Grow(outer: Outer) -> Int {
    var picked: Inner = Pick(outer);
    ArrayPush(picked.items, 9);
    ArrayPush(picked.items, 9);
    ArrayPush(picked.items, 9);
    ArrayPush(picked.items, 9);
    return ArrayLength(picked.items);
}

func Main() -> Int {
    let outer: Outer = Outer(Inner([1, 2]), 0);
    let n: Int = Grow(outer);
    Print(ToString(n + ArrayLength(outer.inner.items) + outer.inner.items[1]));
    return 0;
}
