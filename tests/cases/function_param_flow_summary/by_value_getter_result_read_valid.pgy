// Part returns its outer's inner struct. Report only reads that result, so
// Main's outer keeps its storage and its later use is admitted.
struct Inner {
    items: Array<Int>;
}

struct Outer {
    inner: Inner;
    count: Int;
}

func Part(outer: Outer) -> Inner {
    return outer.inner;
}

func Report(outer: Outer) -> Int {
    let part: Inner = Part(outer);
    return ArrayLength(part.items) + outer.count;
}

func Main() -> Int {
    let outer: Outer = Outer(Inner([1, 2]), 0);
    let n: Int = Report(outer);
    Print(ToString(n + ArrayLength(outer.inner.items) + outer.inner.items[1]));
    return 0;
}
