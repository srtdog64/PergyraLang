// Part lends Main's local outer twice, and Main pushes onto the second
// loan's items while it still uses the first loan and outer. Each loan is
// checked on its own: the second is copied where it is made, and the first
// loan and outer keep their two items.
struct Inner {
    items: Array<Int>;
}

struct Outer {
    inner: Inner;
    count: Int;
}

func Part(outer: Outer) -> Inner {
    return outer.inner;
}

func Main() -> Int {
    let outer: Outer = Outer(Inner([1, 2]), 0);
    let first: Inner = Part(outer);
    let second: Inner = Part(outer);
    ArrayPush(second.items, 9);
    ArrayPush(second.items, 9);
    ArrayPush(second.items, 9);
    ArrayPush(second.items, 9);
    Print(ToString(ArrayLength(second.items) + first.items[1] + ArrayLength(outer.inner.items) + outer.inner.items[1]));
    return 0;
}
