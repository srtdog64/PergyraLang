// Part lends Main's local outer twice, and Main pushes onto both loans'
// items while it still uses outer. Each loan is refused on its own at
// outer's use, and both are copied where they are made in the one next
// analysis: outer keeps its two items.
struct Inner {
    items: Array<Int>;
}

struct Outer {
    inner: Inner;
    count: Int;
}

func Part(outer: Outer) -> Inner {
    return outer.inner;
}

func Main() -> Int {
    let outer: Outer = Outer(Inner([1, 2]), 0);
    var first: Inner = Part(outer);
    var second: Inner = Part(outer);
    ArrayPush(first.items, 9);
    ArrayPush(first.items, 9);
    ArrayPush(first.items, 9);
    ArrayPush(first.items, 9);
    ArrayPush(second.items, 9);
    ArrayPush(second.items, 9);
    ArrayPush(second.items, 9);
    ArrayPush(second.items, 9);
    Print(ToString(ArrayLength(first.items) + ArrayLength(second.items) + outer.inner.items[1]));
    return 0;
}
