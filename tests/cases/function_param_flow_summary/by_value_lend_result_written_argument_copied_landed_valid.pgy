// Wrap lends its by-value box: the result holds the box. Main writes through
// the result and then reads the box again, so the two must not share the
// box's Array. The result also holds an Array of String-holding structs,
// which a Clone does not copy whole, so no copy can stand where the loan is
// made; the copy stands where Wrap takes its argument, as Wrap(Clone(box)),
// and the box keeps its first element.
struct Pair {
    a: Int;
    name: String;
}

struct Box {
    items: Array<Int>;
}

struct Held {
    box: Box;
    pairs: Array<Pair>;
}

func Wrap(box: Box) -> Held {
    return Held(box, []);
}

func Main() -> Int {
    let box: Box = Box([1, 2]);
    var held: Held = Wrap(box);
    held.box.items[0] = 9;
    Print(ToString(box.items[0]));
    Print(ToString(held.box.items[0]));
    return 0;
}
