// The nested constructor keeps a borrowed String only until its exact
// projection is assigned into the caller's inout output.  The compiler copies
// that String at the projection source, and both backends must materialize the
// expression-only Option<Held> specialization used along the way.
struct TextRecord { text: String; }
struct Held { value: String; }

func StoreRecord(ref record: TextRecord, inout output: String) -> Option<Int> {
    let key: String = UnwrapOption(Some(Held(record.text))).value;
    output = key;
    return Some(0);
}

func Main() -> Void {
    let record = TextRecord(Concat("heap", " text"));
    var output: String = "";
    let result = StoreRecord(record, output);
    if IsSome(result) { Log(output); }
}
