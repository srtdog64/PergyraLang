struct TextRecord { text: String; }
extern "C" { func Keep(text: String) -> Void; }
func Alias(ref text: String) -> String {
    let first = text;
    let second = first;
    return second;
}
func ReadRecord(ref record: TextRecord) -> Bool { Keep(Alias(record.text)); return true; }
func Main() -> Void {
    let record = TextRecord(Concat("heap", " text"));
    Log(ReadRecord(record));
}
