// The first analysis refuses the loan this program's ref call lends; the
// next copies it where the call makes it (Clone copies the result whole).
struct TextRecord { text: String; }
func Alias(ref text: String) -> String {
    let first = text;
    let second = first;
    return second;
}
func ReadRecord(ref record: TextRecord) -> String { return Alias(record.text); }
func Make() -> String {
    let record = TextRecord(Concat("heap", " text"));
    return ReadRecord(record);
}
func Main() -> Void { Log(Make()); }
