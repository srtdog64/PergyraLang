// Clone of an Array of structs copies each struct by value, so the clone's
// elements share the borrowed input's inner Array storage: MakeCopy returns
// them past its own input.
struct Inner {
    ids: Array<Int>;
}

struct Holder {
    items: Array<Inner>;
}

func Copy(ref input: Holder) -> Array<Inner> {
    return Clone(input.items);
}

func MakeCopy() -> Array<Inner> {
    let ids: Array<Int> = [1];
    let items: Array<Inner> = [Inner(ids)];
    let input: Holder = Holder(items);
    return Copy(input);
}

func Main() -> Int {
    let copy: Array<Inner> = MakeCopy();
    Print(ToString(ArrayLength(copy) + copy[0].ids[0]));
    return 0;
}
