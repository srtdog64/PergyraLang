// Collect builds a Facts from its by-value arena's count and a fresh Array
// and pushes it onto a local Array. A count is a copy, so the Facts hold
// none of the arena's storage and the push keeps nothing of it: Main's
// arena keeps its storage and its later use is admitted.
struct Arena {
    names: Array<String>;
    count: Int;
}

struct Facts {
    count: Int;
    items: Array<Int>;
}

func Collect(arena: Arena) -> Int {
    var rows: Array<Facts> = [];
    ArrayPush(rows, Facts(arena.count, [1, 2]));
    return ArrayLength(rows) + arena.count;
}

func Main() -> Int {
    let arena: Arena = Arena([StringConcat("ab", "")], 2);
    Print(ToString(Collect(arena)));
    Print(arena.names[0]);
    return 0;
}
