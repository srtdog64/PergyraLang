// IdentityNames copies Strings from a default aggregate field into the
// returned Array. The return-summary consumer selects that exact push before
// rejecting the aggregate dependency; the next analysis owns the copied
// element and ViewFrom consumes the resulting owned Array.
struct Facts {
    names: Array<String>;
    kinds: Array<String>;
}

struct View {
    ok: Bool;
    ids: Array<String>;
}

func IdentityNames(facts: Facts) -> Array<String> {
    var names: Array<String> = [];
    var row: Int = 0;
    while row < ArrayLength(facts.names) {
        if facts.kinds[row] == "class" {
            ArrayPush(names, facts.names[row]);
        }
        row = row + 1;
    }
    return names;
}

func ViewFrom(facts: Facts) -> View {
    return View(true, IdentityNames(facts));
}

func Checked(facts: Facts, ref rows: Array<String>) -> View {
    let view: View = ViewFrom(facts);
    if ArrayLength(rows) != ArrayLength(view.ids) {
        Print("rows differ");
    }
    return view;
}

func Main() -> Int {
    let facts: Facts = Facts(["A", "B"], ["class", "enum"]);
    let rows: Array<String> = ["A"];
    let view: View = Checked(facts, rows);
    Print(view.ids[0]);
    return 0;
}
