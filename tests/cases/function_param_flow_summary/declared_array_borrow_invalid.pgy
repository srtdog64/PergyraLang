struct TextRecord { text: String; }

func Wrap(ref text: String) -> Array<String> {
    return ["known", text];
}

func Probe(ref record: TextRecord) -> Array<String> {
    return Wrap(record.text);
}

func MakeProbe() -> Array<String> {
    let record = TextRecord(Concat("heap", " text"));
    return Probe(record);
}

func Main() -> Void {
    Log(ArrayLength(MakeProbe()));
}
