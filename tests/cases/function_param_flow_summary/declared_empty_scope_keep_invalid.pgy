struct TextRecord { text: String; }
struct Scope { names: Array<String>; values: Array<Int>; tags: Array<Int>; }
extern "C" { func Keep(text: String) -> Void; }

func EmptyScope() -> Scope {
    let names: Array<String> = [];
    let values: Array<Int> = [];
    let tags: Array<Int> = [];
    return Scope(names, values, tags);
}

func Probe(ref record: TextRecord) -> Option<Int> {
    let scope = EmptyScope();
    Keep(record.text);
    return Some(ArrayLength(scope.names) + StringLength(record.text));
}

func Main() -> Void {
    let record = TextRecord(Concat("heap", " text"));
    Log(UnwrapOption(Probe(record)));
}
