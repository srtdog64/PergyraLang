// One branch moves the argument; the use after the branches may see it
// moved, and a Clone of a copies its Array of structs only by value.
struct Pair {
    a: Int;
    b: Int;
}

struct Rows {
    ids: Array<Int>;
    pairs: Array<Pair>;
}

func AddBlock(rows: Rows) -> Rows {
    let ids: Array<Int> = rows.ids;
    ArrayPush(ids, ArrayLength(ids));
    return Rows(ids, rows.pairs);
}

func Main() -> Int {
    let ids: Array<Int> = [1];
    let a: Rows = Rows(ids, []);
    let size: Int = 0;
    if ArrayLength(a.ids) > 0 {
        let b: Rows = AddBlock(a);
        size = ArrayLength(b.ids);
    }
    Print(ToString(size + ArrayLength(a.ids)));
    return 0;
}
