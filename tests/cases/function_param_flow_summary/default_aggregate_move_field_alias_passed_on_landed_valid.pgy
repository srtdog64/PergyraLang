// Since 2026-10-22 the moving call takes a copy of the argument, so the
// later use is admitted (moved_argument_used_again_is_copied). Below: the move.
// Grow binds its arena's inner struct to a local and hands it to Same,
// which returns it. Grow pushes onto the result's ids, storage Main's arena
// shares, so the call moves the arena.
struct Inner {
    ids: Array<Int>;
}

struct Arena {
    inner: Inner;
}

func Same(inner: Inner) -> Inner {
    return inner;
}

func Grow(arena: Arena) -> Int {
    let inner: Inner = arena.inner;
    var kept: Inner = Same(inner);
    ArrayPush(kept.ids, 7);
    ArrayPush(kept.ids, 8);
    return ArrayLength(kept.ids);
}

func Main() -> Int {
    let arena: Arena = Arena(Inner([1]));
    let grown: Int = Grow(arena);
    Print(ToString(arena.inner.ids[0] + grown));
    return 0;
}
