// Since 2026-10-22 the moving call takes a copy of the argument, so the
// later use is admitted (moved_argument_used_again_is_copied). Below: the move.
// Grow binds its arena's Array field to a local and pushes onto it. The
// local shares the storage of Main's arena, so the call moves the arena.
struct Arena {
    atoms: Array<String>;
}

func Grow(arena: Arena) -> Int {
    var atoms: Array<String> = arena.atoms;
    ArrayPush(atoms, StringConcat("zz", ""));
    return ArrayLength(atoms);
}

func Main() -> Int {
    let arena: Arena = Arena([StringConcat("ab", "")]);
    let grown: Int = Grow(arena);
    Print(arena.atoms[0]);
    return grown;
}
