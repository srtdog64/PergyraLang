// Since 2026-10-22 the moving call takes a copy of the argument, so the
// later use is admitted (moved_argument_used_again_is_copied). Below: the move.
// Rename replaces an element of its by-value arena's Array field. The
// element lives in storage Main's arena shares, so the call moves the arena.
struct Arena {
    atoms: Array<String>;
}

func Rename(arena: Arena) -> Int {
    ArraySet(arena.atoms, 0, StringConcat("zz", ""));
    return ArrayLength(arena.atoms);
}

func Main() -> Int {
    let arena: Arena = Arena([StringConcat("ab", "")]);
    let count: Int = Rename(arena);
    Print(arena.atoms[0]);
    return count;
}
