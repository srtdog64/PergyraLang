// Each iteration grows the argument, so each call takes a copy of its own:
// AddBlock(Clone(a)).
// AddBlock also writes the first id in place; a keeps its own (1).
struct Rows {
    ids: Array<Int>;
}

func AddBlock(rows: Rows) -> Rows {
    var ids: Array<Int> = rows.ids;
    ArraySet(ids, 0, 99);
    ArrayPush(ids, ArrayLength(ids));
    return Rows(ids);
}

func Main() -> Int {
    let ids: Array<Int> = [1];
    let a: Rows = Rows(ids);
    var total: Int = 0;
    var i: Int = 0;
    while i < 2 {
        let b: Rows = AddBlock(a);
        total = total + ArrayLength(b.ids);
        i = i + 1;
    }
    Print(ToString(total));
    Print(ToString(a.ids[0]));
    return 0;
}
