// Put stores into its by-value table's map, storage Main's table shares, so
// the call moves the table and Main's later read is refused.
struct Table {
    counts: HashMap<String, Int>;
}

func Put(table: Table) -> Int {
    MapSet(table.counts, "b", 2);
    return 0;
}

func Main() -> Int {
    let counts: HashMap<String, Int> = MapNew();
    MapSet(counts, "a", 1);
    let table: Table = Table(counts);
    let done: Int = Put(table);
    Print(ToString(done + MapSize(table.counts)));
    return 0;
}
