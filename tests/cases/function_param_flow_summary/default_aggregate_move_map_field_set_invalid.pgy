// Put stores into its by-value table's map of Arrays (Clone copies it only
// by value), so the call moves the table and Main's later read is refused.
struct Table {
    counts: HashMap<String, Array<Int>>;
}

func Put(table: Table) -> Int {
    MapSet(table.counts, "b", [2]);
    return 0;
}

func Main() -> Int {
    let counts: HashMap<String, Array<Int>> = MapNew();
    MapSet(counts, "a", [1]);
    let table: Table = Table(counts);
    let done: Int = Put(table);
    Print(ToString(done + MapSize(table.counts)));
    return 0;
}
