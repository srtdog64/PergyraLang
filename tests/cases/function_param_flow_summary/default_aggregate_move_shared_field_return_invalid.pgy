// Keep returns a new Rows built from its by-value argument's fields: the
// result shares their storage, so growing the result can free the storage
// the argument still names. Clone does not copy the nested grid whole, so
// no copy can stand in for the loan and Main's later use of rows is refused.
struct Rows {
    ids: Array<Int>;
    grid: Array<Array<Int>>;
}

func Keep(rows: Rows) -> Rows {
    return Rows(rows.ids, rows.grid);
}

func Main() -> Int {
    let ids: Array<Int> = [1];
    let grid: Array<Array<Int>> = [[1]];
    let rows: Rows = Rows(ids, grid);
    let kept: Rows = Keep(rows);
    ArrayPush(kept.ids, 2);
    Print(ToString(rows.ids[0]));
    return 0;
}
