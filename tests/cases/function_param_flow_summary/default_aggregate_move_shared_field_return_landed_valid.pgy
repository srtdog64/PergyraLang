// Keep returns a new Rows built from its by-value argument's ids: the
// result shares that field's storage, so Keep lends rows to Main. Main grows
// the result while it still uses rows, so the loan is copied where it is
// made and rows keeps its one id.
struct Rows {
    ids: Array<Int>;
}

func Keep(rows: Rows) -> Rows {
    return Rows(rows.ids);
}

func Main() -> Int {
    let ids: Array<Int> = [1];
    let rows: Rows = Rows(ids);
    let kept: Rows = Keep(rows);
    ArrayPush(kept.ids, 2);
    Print(ToString(rows.ids[0]));
    return 0;
}
