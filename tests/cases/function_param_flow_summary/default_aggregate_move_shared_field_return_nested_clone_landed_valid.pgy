// Keep returns a new Rows built from its by-value argument's fields. The
// result initially shares their storage. Because the concrete Rows layout is
// copied wholly by both backends, the move owner lands one Clone at the call
// before kept.ids changes and Main reads rows again.
struct Rows {
    ids: Array<Int>;
    grid: Array<Array<Int>>;
}

func Keep(rows: Rows) -> Rows {
    return Rows(rows.ids, rows.grid);
}

func Main() -> Int {
    let ids: Array<Int> = [1];
    let grid: Array<Array<Int>> = [[1]];
    let rows: Rows = Rows(ids, grid);
    var kept: Rows = Keep(rows);
    ArrayPush(kept.ids, 2);
    Print(ToString(rows.ids[0]));
    return 0;
}
