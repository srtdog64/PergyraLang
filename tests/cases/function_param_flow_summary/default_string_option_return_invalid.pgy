struct TextRecord { text: String; }
func ReadRecord(ref record: TextRecord, field: String) -> Option<String> {
    return Some(record.text);
}
func KeepRecord(ref record: TextRecord) -> TextRecord {
    let result = ReadRecord(record, "field");
    return TextRecord(UnwrapOption(result));
}
func Main() -> Void {
    let record = TextRecord(Concat("heap", " text"));
    let kept = KeepRecord(record);
    Log(StringLength(kept.text));
}
