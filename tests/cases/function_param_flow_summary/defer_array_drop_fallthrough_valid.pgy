// A Void routine that falls through runs its defer there; rows still owns
// its storage at that exit.
func Peek(ref rows: Array<Int>) -> Int {
    return ArrayLength(rows);
}

func Run() -> Void {
    var rows: Array<Int> = [];
    ArrayPush(rows, 7);
    defer { ArrayDrop(rows); };
    Print(ToString(Peek(rows) + rows[0]));
}

func Main() -> Int {
    Run();
    return 0;
}
