// The return value copies an element before the defer releases the Strings.
func Build() -> String {
    var names: Array<String> = [];
    ArrayPushOwnedString(names, Concat("a", "b"));
    defer { ArrayDropOwnedStrings(names); };
    return Concat(names[0], "!");
}

func Main() -> Int {
    Print(Build());
    return 0;
}
