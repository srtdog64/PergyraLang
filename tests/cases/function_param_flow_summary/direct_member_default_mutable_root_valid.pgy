// A `var` aggregate root that is not rebound before the moving call proves its
// field's owned elements exactly as a `let` root does.
struct Rows {
    names: Array<String>;
}

struct Changed {
    names: Array<String>;
}

func Append(names: Array<String>) -> Changed {
    var changed: Array<String> = names;
    ArrayPush(changed, Concat("b", ""));
    return Changed(changed);
}

func Main() -> Int {
    var rows: Rows = Rows([Concat("a", "")]);
    let result: Changed = Append(rows.names);
    return ArrayLength(result.names);
}
