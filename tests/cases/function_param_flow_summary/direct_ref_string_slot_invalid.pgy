struct TextRecord { text: String; }
func StoreText(ref output: Slot<String>, ref text: String) -> Void {
    Write(output, text);
}
func Publish(ref output: Slot<String>) -> Bool {
    let record = TextRecord(Concat("heap", " text"));
    StoreText(output, record.text);
    return true;
}
func Main() -> Void {
    let output: Slot<String> = ClaimSlot();
    Log(Publish(output));
    Log(Read(output));
    Release(output);
}
