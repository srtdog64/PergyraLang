// As enum_payload_constructor_ref_field_return_valid, but a case body
// replaces the admission while the payload still lends it: a case body runs,
// unlike its pattern, and the later match reads the payload.
struct Refusal {
    owner: String;
    stage: String;
}

enum Payload {
    Emitted(String),
    Refused(Refusal),
}

struct Admission {
    owner: String;
    stage: String;
}

func RefusalOf(ref admission: Admission) -> Refusal {
    return Refusal(admission.owner, admission.stage);
}

func Route(ref admission: Admission, count: Int) -> Payload {
    if count == 3 {
        return Emitted("emitted");
    }
    return Refused(RefusalOf(admission));
}

func Main() -> Int {
    let admission: Admission = Admission("owner", "stage");
    let payload: Payload = Route(admission, 1);
    match payload {
        case Emitted(text): Print(text);
        case Refused(refusal): admission = Admission("other", "x");
    }
    match payload {
        case Emitted(text): Print(text);
        case Refused(refusal): Print(refusal.owner);
    }
    return 0;
}
