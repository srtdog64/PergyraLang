// Gather pushes a String element of its ref input into a local Array and
// returns it. No proof admits that store: the first analysis selects it and
// a second lands it as an owned push (ArrayPushOwnedString), so the ref
// input does not escape through the result.
struct Routines {
    names: Array<String>;
}

func Gather(ref routines: Routines) -> Array<String> {
    var out: Array<String> = [];
    ArrayPush(out, routines.names[0]);
    return out;
}

func Main() -> Int {
    let routines: Routines = Routines([StringConcat("a", "")]);
    let out: Array<String> = Gather(routines);
    Print(out[0]);
    Print(routines.names[0]);
    return 0;
}
