// Collect pushes String elements of its ref input into its inout output.
// Each String leaves the routine, so the push stores an owned copy
// (Clone) and the ref input does not escape.
struct Routines {
    names: Array<String>;
}

func Collect(ref routines: Routines, inout names: Array<String>) -> Int {
    let row: Int = 0;
    while row < ArrayLength(routines.names) {
        ArrayPush(names, routines.names[row]);
        row = row + 1;
    }
    return ArrayLength(names);
}

func Main() -> Int {
    let routines: Routines = Routines([StringConcat("a", ""), StringConcat("b", "")]);
    let names: Array<String> = [];
    let count: Int = Collect(routines, names);
    Print(ToString(count));
    Print(names[1]);
    Print(routines.names[0]);
    return 0;
}
