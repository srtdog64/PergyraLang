// A struct named Clone does not take over the copy a String store into an
// inout output lands as: the checker-built call is the builtin, not that
// struct's constructor.
struct Clone {
    tag: Int;
}

struct Routines {
    names: Array<String>;
}

func Collect(ref routines: Routines, inout names: Array<String>) -> Int {
    ArrayPush(names, routines.names[0]);
    return ArrayLength(names);
}

func Main() -> Int {
    let marker: Clone = Clone(7);
    let routines: Routines = Routines([StringConcat("a", "")]);
    let names: Array<String> = [];
    Print(ToString(Collect(routines, names)));
    Print(names[0]);
    Print(ToString(marker.tag));
    return 0;
}
