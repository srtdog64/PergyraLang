// Label takes its by-value rows' labels into a local and puts a String of
// its by-value source into it. The escape analysis selects the store and a
// second analysis lands it as an owned copy, so Main lends source to Label
// instead of moving it and may read it afterwards.
struct Rows {
    labels: HashMap<String, String>;
}

struct Source {
    title: String;
    ids: Array<Int>;
}

func Label(rows: Rows, source: Source) -> Rows {
    let labels: HashMap<String, String> = rows.labels;
    MapSet(labels, "k", source.title);
    return Rows(labels);
}

func Main() -> Int {
    let source: Source = Source(StringConcat("t", ""), [1]);
    let empty: HashMap<String, String> = MapNew();
    let rows: Rows = Label(Rows(empty), source);
    let labels: HashMap<String, String> = rows.labels;
    Print(MapGet(labels, "k"));
    Print(source.title);
    Print(ToString(ArrayLength(source.ids)));
    return 0;
}
