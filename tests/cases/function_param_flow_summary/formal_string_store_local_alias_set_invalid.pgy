// Rename sets a String of its by-value source into a local through a local
// binding of that String. Only a path of a formal lands as a copy, so the
// set keeps a String no owner proves alive and is refused.
struct Rows {
    names: Array<String>;
}

struct Source {
    title: String;
    ids: Array<Int>;
}

func Rename(rows: Rows, source: Source) -> Rows {
    let names: Array<String> = rows.names;
    let title: String = source.title;
    ArraySet(names, 0, title);
    return Rows(names);
}

func Main() -> Int {
    let source: Source = Source(StringConcat("t", ""), [1]);
    let rows: Rows = Rename(Rows([StringConcat("a", "")]), source);
    Print(rows.names[0]);
    Print(source.title);
    return 0;
}
