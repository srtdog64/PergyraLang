// ArraySet copies an exact local String into an independently owned local
// receiver. The source stays live, so both values remain readable.
struct Rows {
    names: Array<String>;
}

struct Source {
    title: String;
    ids: Array<Int>;
}

func Rename(rows: Rows, source: Source) -> Rows {
    var names: Array<String> = rows.names;
    let title: String = source.title;
    ArraySet(names, 0, title);
    return Rows(names);
}

func Main() -> Int {
    let source: Source = Source(StringConcat("t", ""), [1]);
    let rows: Rows = Rename(Rows([StringConcat("a", "")]), source);
    Print(rows.names[0]);
    Print(source.title);
    return 0;
}
