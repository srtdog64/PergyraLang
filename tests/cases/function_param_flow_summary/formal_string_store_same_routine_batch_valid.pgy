// One ref formal supplies three Strings stored by one contiguous statement
// run. The first live Array<String> is a copy-risk owner, not the identity of
// every destination, so the landing owner records all three independent
// copies in one analysis.
struct FormalStringStoreBatchRows {
    first: Array<String>;
    second: Array<String>;
    third: Array<String>;
}

struct FormalStringStoreBatchFact {
    first: String;
    second: String;
    third: String;
}

func FormalStringStoreBatchApply(
    rows: FormalStringStoreBatchRows,
    ref fact: FormalStringStoreBatchFact
) -> FormalStringStoreBatchRows {
    let first: Array<String> = rows.first;
    let second: Array<String> = rows.second;
    let third: Array<String> = rows.third;
    ArraySet(first, 0, fact.first);
    ArraySet(second, 0, fact.second);
    ArraySet(third, 0, fact.third);
    return FormalStringStoreBatchRows(first, second, third);
}

func Main() -> Int {
    let rows: FormalStringStoreBatchRows = FormalStringStoreBatchRows(
        Clone(["one"]), Clone(["two"]), Clone(["three"]));
    let fact: FormalStringStoreBatchFact = FormalStringStoreBatchFact(
        "a1", "b2", "c3");
    let result: FormalStringStoreBatchRows = FormalStringStoreBatchApply(
        rows, fact);
    Print(result.first[0]);
    Print(result.second[0]);
    Print(result.third[0]);
    return 0;
}
