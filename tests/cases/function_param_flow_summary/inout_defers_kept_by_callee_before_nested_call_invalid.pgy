// As the recursive emitter, but a callee keeps the inout defers in another
// inout Array before the nested call: the kept descriptor may be rebound.
func Stash(inout defers: Array<String>, inout stash: Array<Array<String>>) -> Int {
    ArrayPush(stash, defers);
    return 0;
}

func Emit(depth: Int, inout cur: Array<Int>, inout defers: Array<String>,
    inout stash: Array<Array<String>>) -> String {
    let result: String = "";
    while cur[0] < depth {
        ArraySet(cur, 0, cur[0] + 1);
        let kept: Int = Stash(defers, stash);
        let nested: String = Emit(depth - 1, cur, defers, stash);
        ArraySet(defers, 0, Concat(defers[0], "d"));
        result = Concat(result, nested);
    }
    return result;
}

func Main() -> Int {
    let cur: Array<Int> = [0];
    let defers: Array<String> = [""];
    let stash: Array<Array<String>> = [];
    let text: String = Emit(2, cur, defers, stash);
    Print(Concat(text, defers[0]));
    return 0;
}
