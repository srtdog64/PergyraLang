// Since 2026-10-22 the moving call takes a copy of the argument, so the
// later use is admitted (moved_argument_used_again_is_copied). Below: the move.
// A by-value parameter that an inout callee fills from a second by-value
// input carries that input's storage; returning it moves the second
// argument, so the caller cannot use it again.
struct Rows {
    values: Array<Int>;
    count: Int;
}

struct Route {
    ok: Bool;
    rows: Rows;
}

func Fill(inout rows: Rows, other: Rows) -> Int {
    let next: Rows = Rows(other.values, rows.count); rows = next;
    return rows.count;
}

func Build(rows: Rows, other: Rows) -> Route {
    var count: Int = 0;
    count = Fill(rows, other);
    return Route(count >= 0, rows);
}

func Main() -> Int {
    let empty: Array<Int> = [];
    let values: Array<Int> = [1];
    let rows: Rows = Rows(empty, 0);
    let other: Rows = Rows(values, 1);
    var route: Route = Build(rows, other);
    ArrayPush(route.rows.values, 2);
    Print(ToString(ArrayLength(other.values)));
    return 0;
}
