// A nonempty literal starts with borrowed String elements.  Because the local
// remains live after the inout writer, the existing copy-on-reuse owner must
// make the initializer independent before the writer adds an owned result.
func AppendFresh(inout rows: Array<String>) -> Void {
    ArrayPush(rows, Concat("owned", " value"));
}

func Main() -> Void {
    var rows: Array<String> = ["borrowed"];
    AppendFresh(rows);
    Log(ArrayLength(rows));
    Log(rows[0]);
    Log(rows[1]);
}
