// A terminal branch transfers the empty Array into its return value.  That
// branch cannot revoke the element premise on the surviving path, where the
// same local is still an independently owned empty Array.
struct BuildResult {
    ok: Bool;
    rows: Array<String>;
}

func AppendFresh(inout rows: Array<String>) -> Void {
    ArrayPush(rows, Concat("owned", " value"));
}

func Build(enabled: Bool) -> BuildResult {
    var rows: Array<String> = [];
    if !enabled {
        return BuildResult(false, rows);
    }
    AppendFresh(rows);
    return BuildResult(true, rows);
}

func Main() -> Void {
    let result: BuildResult = Build(true);
    let rows: Array<String> = result.rows;
    Log(result.ok);
    Log(ArrayLength(rows));
    Log(rows[0]);
}
