// As the recursive parser, but a callee keeps the chain in another inout
// Array before popping it: the kept descriptor may be rebound by the next
// push, so the nested call that takes the chain is refused.
func Keep(inout chain: Array<String>, inout stash: Array<Array<String>>) -> Void {
    ArrayPush(stash, chain);
    ArrayPop(chain);
}

func Decls(depth: Int, inout chain: Array<String>, inout stash: Array<Array<String>>) -> Void {
    if depth < 2 {
        ArrayPush(chain, ToString(depth));
        Keep(chain, stash);
        Decls(depth + 1, chain, stash);
    }
}

func Main() -> Int {
    let chain: Array<String> = [];
    let stash: Array<Array<String>> = [];
    Decls(0, chain, stash);
    Print(ToString(ArrayLength(stash)));
    return 0;
}
