// As the recursive parser, but a callee stores an independent copy of the
// chain in another inout Array before popping the live owner place.
func Keep(inout chain: Array<String>, inout stash: Array<Array<String>>) -> Void {
    ArrayPush(stash, chain);
    ArrayPop(chain);
}

func Decls(depth: Int, inout chain: Array<String>, inout stash: Array<Array<String>>) -> Void {
    if depth < 2 {
        ArrayPush(chain, ToString(depth));
        Keep(chain, stash);
        Decls(depth + 1, chain, stash);
    }
}

func Main() -> Int {
    var chain: Array<String> = [];
    var stash: Array<Array<String>> = [];
    Decls(0, chain, stash);
    Print(ToString(ArrayLength(stash)));
    return 0;
}
