// An intent's step action copies its Array argument and sorts the copy.
// ArraySort on a local that is not an Array literal is a stdlib call the
// analysis does not model, so the action's frame for that formal is
// unsupported, and so is the frame of Route that hands the Array to the
// intent: its unsupported relation is the step's action call. No row of
// Route holds that call; the row that holds the intent call owns it, so
// Route's rows stay current and its result is admitted: a conservative
// summary, not a stale proof.
struct Taken {
    items: Array<Int>;
}

subject Runner {
    var outcome: Option<Taken>;
    action Run(self, items: Array<Int>) -> Bool {
        let sorted: Array<Int> = Clone(items);
        self.outcome = Some(Taken(ArraySort(sorted)));
        return true;
    }
}

zone RunZone {
    subject slot runner: Runner
    authority runner
}

intent RunItems(run_zone: RunZone, runner: Runner, items: Array<Int>) {
    exclusive;
    step Run {
        using: run_zone;
        on ran: runner.Run(items);
        expect: ran;
    }
    success: true;
    failure: false;
}

func Route(zone: RunZone, runner: Runner, items: Array<Int>) -> Taken {
    let ran: Bool = RunItems(zone, runner, items);
    if !ran || !IsSome(runner.outcome) {
        let empty: Array<Int> = [];
        return Taken(empty);
    }
    return UnwrapOption(runner.outcome);
}

func Main() -> Int {
    let zone: RunZone = RunZone(Runner(None));
    let runner: Runner = Runner(None);
    let items: Array<Int> = [3, 1, 2];
    let taken: Taken = Route(zone, runner, items);
    Print(ToString(taken.items[0]));
    return 0;
}
