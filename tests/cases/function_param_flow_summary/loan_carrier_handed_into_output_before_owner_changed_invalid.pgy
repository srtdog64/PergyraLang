// As loan_carrier_handed_on_by_early_return_valid, but the facts are handed
// into an inout output and the analysis changes after: the loan leaves into
// the output, where the change would show.
struct Cell {
    value: Int;
}

struct Graph {
    rows: Array<Cell>;
}

struct Analysis {
    graph: Graph;
    ok: Bool;
}

struct Facts {
    graph: Graph;
    code: Int;
}

func FactsEmpty(graph: Graph) -> Facts {
    return Facts(graph, 0);
}

func FactsError(facts: Facts, code: Int) -> Facts {
    return Facts(facts.graph, code);
}

func Check(analysis: Analysis, inout out: Array<Facts>) -> Int {
    let facts: Facts = FactsEmpty(analysis.graph);
    ArrayPush(out, FactsError(facts, 1));
    ArraySet(analysis.graph.rows, 0, Cell(9));
    return 0;
}

func Main() -> Int {
    let analysis: Analysis = Analysis(Graph([Cell(1), Cell(2)]), true);
    var out: Array<Facts> = [];
    let n: Int = Check(analysis, out);
    Print(ToString(out[0].graph.rows[0].value + n));
    return 0;
}
