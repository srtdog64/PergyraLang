// As loan_scope_ended_before_owner_moved_valid, but the view is kept in a
// local declared before the loop: it still lends the copy when the copy
// moves, and a write through the new owner would show through it.
struct Cell {
    value: Int;
}

struct Arena {
    ready: Bool;
    rows: Array<Cell>;
}

struct Graph {
    arena: Arena;
}

struct View {
    rows: Array<Cell>;
}

struct Holder {
    total: Int;
    graph: Graph;
}

func ViewAt(graph: Graph, i: Int) -> View {
    return View(graph.arena.rows);
}

func WithGraph(graph: Graph) -> Int {
    let sealed: Graph = graph;
    var keep: View = View([]);
    var i: Int = 0;
    while i < 2 {
        let view: View = ViewAt(sealed, i);
        keep = view;
        i = i + 1;
    }
    var held: Holder = Holder(0, sealed);
    held.graph.arena.rows[0] = Cell(7);
    return keep.rows[0].value;
}

func Main() -> Int {
    let graph: Graph = Graph(Arena(false, [Cell(1), Cell(2), Cell(3)]));
    Print(ToString(WithGraph(graph)));
    return 0;
}
