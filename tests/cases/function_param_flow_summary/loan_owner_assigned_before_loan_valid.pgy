// WithGraph assigns fields of the copy it lends only before the loop that
// takes views of it: no assignment runs while a view lends it, so the loan
// proof holds although Clone copies the graph only by value.
struct Cell {
    value: Int;
}

struct Arena {
    ready: Bool;
    rows: Array<Cell>;
}

struct Graph {
    arena: Arena;
}

struct View {
    rows: Array<Cell>;
}

func ViewAt(graph: Graph, i: Int) -> View {
    return View(graph.arena.rows);
}

func WithGraph(graph: Graph) -> Int {
    var sealed: Graph = graph;
    if !sealed.arena.ready {
        sealed.arena.ready = true;
    }
    var total: Int = 0;
    var i: Int = 0;
    while i < 2 {
        let view: View = ViewAt(sealed, i);
        total = total + ArrayLength(view.rows);
        i = i + 1;
    }
    return total + ArrayLength(sealed.arena.rows);
}

func Main() -> Int {
    let graph: Graph = Graph(Arena(false, [Cell(1), Cell(2), Cell(3)]));
    Print(ToString(WithGraph(graph)));
    return 0;
}
