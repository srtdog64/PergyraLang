// As loan_owner_assigned_before_loan_valid, but the first assignment's value
// takes a view of the copy it assigns: the assignment runs after that view is
// made, so that loan's owner changes under it.
struct Cell {
    value: Int;
}

struct Arena {
    ready: Bool;
    rows: Array<Cell>;
}

struct Graph {
    arena: Arena;
}

struct View {
    rows: Array<Cell>;
}

func ViewAt(graph: Graph, i: Int) -> View {
    return View(graph.arena.rows);
}

func WithGraph(graph: Graph) -> Int {
    let sealed: Graph = graph;
    if !sealed.arena.ready {
        sealed.arena.ready = ArrayLength(ViewAt(sealed, 0).rows) > 0;
    }
    let total: Int = 0;
    let i: Int = 0;
    while i < 2 {
        let view: View = ViewAt(sealed, i);
        total = total + ArrayLength(view.rows);
        i = i + 1;
    }
    return total + ArrayLength(sealed.arena.rows);
}

func Main() -> Int {
    let graph: Graph = Graph(Arena(false, [Cell(1), Cell(2), Cell(3)]));
    Print(ToString(WithGraph(graph)));
    return 0;
}
