// As loan_owner_read_by_constructor_valid, but the value built from the
// base's fields is changed while the facts still lend the base: the change
// writes storage the facts read, and the local copy rule refuses it.
struct Cell {
    value: Int;
}

struct Arena {
    rows: Array<Cell>;
}

struct Artifact {
    text: String;
    arena: Arena;
    count: Int;
}

struct Facts {
    rows: Array<Cell>;
    ok: Bool;
}

func FactsFrom(artifact: Artifact) -> Facts {
    return Facts(artifact.arena.rows, ArrayLength(artifact.arena.rows) > 0);
}

func Check() -> Int {
    let base: Artifact = Artifact("p", Arena([Cell(1), Cell(2)]), 2);
    let missing: Facts = FactsFrom(base);
    let typed: Artifact = Artifact(base.text, base.arena, base.count);
    typed.arena.rows[0] = Cell(7);
    return missing.rows[0].value + base.count;
}

func Main() -> Int {
    Print(ToString(Check()));
    return 0;
}
