// As DriverSourceCExecution.Compile: the admission lends the request, a
// match binds its payload, and the request is read again. A case pattern
// binds parts of the admission and evaluates nothing.
struct Cell {
    value: Int;
}

struct Request {
    rows: Array<Cell>;
    ok: Bool;
}

struct Receipt {
    rows: Array<Cell>;
}

enum Admission {
    Admitted(Receipt),
    Denied(Int),
}

func Produce(request: Request) -> Admission {
    if !request.ok {
        return Denied(1);
    }
    return Admitted(Receipt(request.rows));
}

func Compile(request: Request) -> Int {
    let admission: Admission = Produce(request);
    match admission {
        case Denied(code):
            return code + ArrayLength(request.rows);
        case Admitted(receipt):
            return receipt.rows[0].value + ArrayLength(request.rows);
    }
    return 0;
}

func Main() -> Int {
    let good: Request = Request([Cell(1), Cell(2)], true);
    Print(ToString(Compile(good)));
    let bad: Request = Request([], false);
    Print(ToString(Compile(bad)));
    return 0;
}
