// Main puts outer's inner in an Array literal and pushes onto the element's
// items while it still uses outer: the inner is copied where it is put in,
// and outer keeps its items.
struct Inner {
    items: Array<Int>;
}

struct Outer {
    inner: Inner;
    count: Int;
}

func Main() -> Int {
    let outer: Outer = Outer(Inner([1, 2]), 0);
    let held: Array<Inner> = [outer.inner];
    var first: Inner = held[0];
    ArrayPush(first.items, 9);
    ArrayPush(first.items, 9);
    ArrayPush(first.items, 9);
    ArrayPush(first.items, 9);
    Print(ToString(ArrayLength(first.items) + ArrayLength(outer.inner.items) + outer.inner.items[1]));
    return 0;
}
