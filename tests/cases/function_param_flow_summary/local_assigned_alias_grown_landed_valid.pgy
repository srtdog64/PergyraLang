// Main assigns outer's inner to a local and pushes onto the local while it
// still uses outer: the assigned value is copied, and outer keeps its items.
struct Inner {
    items: Array<Int>;
}

struct Outer {
    inner: Inner;
    count: Int;
}

func Main() -> Int {
    let outer: Outer = Outer(Inner([1, 2]), 0);
    var other: Inner = Inner([5]);
    other = outer.inner;
    ArrayPush(other.items, 9);
    ArrayPush(other.items, 9);
    ArrayPush(other.items, 9);
    ArrayPush(other.items, 9);
    Print(ToString(ArrayLength(other.items) + ArrayLength(outer.inner.items) + outer.inner.items[1]));
    return 0;
}
