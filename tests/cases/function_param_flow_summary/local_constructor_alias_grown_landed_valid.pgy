// Main builds a new Outer from outer's inner and pushes onto the new value's
// items while it still uses outer: the inner is copied where it is built in,
// and outer keeps its items.
struct Inner {
    items: Array<Int>;
}

struct Outer {
    inner: Inner;
    count: Int;
}

func Main() -> Int {
    let outer: Outer = Outer(Inner([1, 2]), 0);
    var other: Outer = Outer(outer.inner, 1);
    ArrayPush(other.inner.items, 9);
    ArrayPush(other.inner.items, 9);
    ArrayPush(other.inner.items, 9);
    ArrayPush(other.inner.items, 9);
    Print(ToString(ArrayLength(other.inner.items) + ArrayLength(outer.inner.items) + outer.inner.items[1]));
    return 0;
}
