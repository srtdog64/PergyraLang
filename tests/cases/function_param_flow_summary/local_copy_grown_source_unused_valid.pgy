// Main binds a local to outer's inner and pushes onto the local, but never
// uses outer again. No later use reads the storage the pushes moved, so no
// copy is landed.
struct Inner {
    items: Array<Int>;
}

struct Outer {
    inner: Inner;
    count: Int;
}

func Main() -> Int {
    let outer: Outer = Outer(Inner([1, 2]), 0);
    Print(ToString(outer.inner.items[0]));
    let other: Inner = outer.inner;
    ArrayPush(other.items, 9);
    ArrayPush(other.items, 9);
    ArrayPush(other.items, 9);
    ArrayPush(other.items, 9);
    Print(ToString(ArrayLength(other.items) + other.items[1]));
    return 0;
}
