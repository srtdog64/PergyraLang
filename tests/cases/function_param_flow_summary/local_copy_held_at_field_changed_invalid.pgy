// As local_copy_held_at_other_field_valid, but each change reaches the
// field the value was assigned into, a map of Arrays Clone copies only by
// value: the field read after a change through the value, and the value
// read after a change through a copy of the field, through the whole holder
// or through a path inside the field, are refused.
struct Facts {
    table: HashMap<String, Array<Int>>;
    carry: HashMap<String, Array<Int>>;
}

struct Bag {
    counts: HashMap<String, Array<Int>>;
}

struct Holder {
    bag: Bag;
    other: HashMap<String, Array<Int>>;
}

func Grow(facts: Facts) -> Facts {
    let carry: HashMap<String, Array<Int>> = facts.carry;
    MapSet(carry, "t", [1]);
    return Facts(facts.table, carry);
}

func AssignedValueChanged(inout facts: Facts) -> Int {
    let fresh: HashMap<String, Array<Int>> = MapNew();
    facts.table = fresh;
    MapSet(fresh, "k", [1]);
    return MapSize(facts.table);
}

func FieldCopyChanged(inout facts: Facts) -> Int {
    let fresh: HashMap<String, Array<Int>> = MapNew();
    facts.table = fresh;
    let again: HashMap<String, Array<Int>> = facts.table;
    MapSet(again, "k", [1]);
    return MapSize(fresh);
}

func HolderChanged() -> Int {
    let table: HashMap<String, Array<Int>> = MapNew();
    let carry: HashMap<String, Array<Int>> = MapNew();
    var facts: Facts = Facts(table, carry);
    let fresh: HashMap<String, Array<Int>> = MapNew();
    facts.table = fresh;
    let grown: Facts = Grow(facts);
    return MapSize(fresh) + MapSize(grown.carry);
}

func InnerPathChanged(inout holder: Holder) -> Int {
    let counts: HashMap<String, Array<Int>> = MapNew();
    let bag: Bag = Bag(counts);
    holder.bag = bag;
    MapSet(holder.bag.counts, "k", [1]);
    return MapSize(bag.counts);
}

func Main() -> Int {
    let table: HashMap<String, Array<Int>> = MapNew();
    let carry: HashMap<String, Array<Int>> = MapNew();
    var facts: Facts = Facts(table, carry);
    Log(AssignedValueChanged(facts));
    Log(FieldCopyChanged(facts));
    Log(HolderChanged());
    let counts: HashMap<String, Array<Int>> = MapNew();
    let other: HashMap<String, Array<Int>> = MapNew();
    var holder: Holder = Holder(Bag(counts), other);
    Log(InnerPathChanged(holder));
    return 0;
}
