// As local_copy_collection_changed_invalid, but the copies are of maps with
// a String key and an Int value, which Clone copies slot by slot: each copy
// is made where it is bound, so a change through it leaves the source as it
// was.
func MapSetCopy(seed: Int) -> Int {
    let source: HashMap<String, Int> = MapNew();
    MapSet(source, "k", seed);
    let copy: HashMap<String, Int> = source;
    MapSet(copy, "j", 2);
    MapSet(copy, "k", 7);
    return MapGet(source, "k") * 10 + MapSize(source);
}

func MapRemoveCopy(seed: Int) -> Bool {
    let source: HashMap<String, Int> = MapNew();
    MapSet(source, "k", seed);
    let copy: HashMap<String, Int> = source;
    MapRemove(copy, "k");
    return MapHas(source, "k");
}

func Main() -> Int {
    Log(MapSetCopy(1));
    Log(MapRemoveCopy(1));
    return 0;
}
