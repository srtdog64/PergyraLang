// As SemanticAstAnalysisResolveExpressionIdentities: a copy of the graph has
// its identity rows reset in place, and the surfaces it came from go to a
// callee that reads only their node ids, which the reset does not touch.
struct Cell {
    value: Int;
}

struct Identities {
    targets: Array<Int>;
    calls: Array<Cell>;
}

struct Graph {
    identities: Identities;
}

struct Surfaces {
    node_ids: Array<Int>;
    graph: Graph;
}

struct Analysis {
    surfaces: Surfaces;
}

func NodeAt(surfaces: Surfaces, index: Int) -> Int {
    return surfaces.node_ids[index];
}

func Resolve(inout analysis: Analysis) -> Int {
    var graph: Graph = analysis.surfaces.graph;
    var total: Int = 0;
    var i: Int = 0;
    while i < 2 {
        ArraySet(graph.identities.targets, i, 0);
        total = total + NodeAt(analysis.surfaces, i);
        i = i + 1;
    }
    analysis.surfaces.graph = graph;
    return total;
}

func Main() -> Int {
    var analysis: Analysis = Analysis(Surfaces([3, 4], Graph(Identities([7, 8], [Cell(1)]))));
    Print(ToString(Resolve(analysis)));
    return 0;
}
