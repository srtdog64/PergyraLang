// Main binds a local to outer's inner, then gives the local a fresh value
// and pushes onto it. After the assignment the local shares nothing with
// outer, so no copy is landed.
struct Inner {
    items: Array<Int>;
}

struct Outer {
    inner: Inner;
    count: Int;
}

func Main() -> Int {
    let outer: Outer = Outer(Inner([1, 2]), 0);
    let other: Inner = outer.inner;
    other = Inner([7]);
    ArrayPush(other.items, 9);
    ArrayPush(other.items, 9);
    ArrayPush(other.items, 9);
    ArrayPush(other.items, 9);
    Print(ToString(ArrayLength(other.items) + ArrayLength(outer.inner.items) + outer.inner.items[1]));
    return 0;
}
