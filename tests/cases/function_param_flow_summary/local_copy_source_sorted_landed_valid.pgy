// Main binds a local to its Array, then sorts the Array in place while it
// still uses the local. The local is an independent value, so it is copied
// where it is bound and keeps the unsorted order.
func Main() -> Int {
    var items: Array<Int> = [3, 1, 2];
    let before: Array<Int> = items;
    ArraySort(items);
    Print(ToString(before[0] * 10 + items[0]));
    return 0;
}
