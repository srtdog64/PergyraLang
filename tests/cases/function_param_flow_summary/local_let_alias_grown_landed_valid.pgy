// Main binds a local to outer's inner and pushes onto it while it still
// uses outer. The local shares outer's storage, so the pushes would change
// outer: the local is copied where it is bound, and outer keeps its items.
struct Inner {
    items: Array<Int>;
}

struct Outer {
    inner: Inner;
    count: Int;
}

func Main() -> Int {
    let outer: Outer = Outer(Inner([1, 2]), 0);
    var other: Inner = outer.inner;
    ArrayPush(other.items, 9);
    ArrayPush(other.items, 9);
    ArrayPush(other.items, 9);
    ArrayPush(other.items, 9);
    Print(ToString(ArrayLength(other.items) + ArrayLength(outer.inner.items) + outer.inner.items[1]));
    return 0;
}
