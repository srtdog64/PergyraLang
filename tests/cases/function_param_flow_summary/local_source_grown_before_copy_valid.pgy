// Main pushes onto outer's items, then binds a local to outer's inner and
// reads both. Nothing changes the storage after the copy shares it, so no
// copy is landed.
struct Inner {
    items: Array<Int>;
}

struct Outer {
    inner: Inner;
    count: Int;
}

func Main() -> Int {
    var outer: Outer = Outer(Inner([1, 2]), 0);
    ArrayPush(outer.inner.items, 9);
    ArrayPush(outer.inner.items, 9);
    let other: Inner = outer.inner;
    Print(ToString(ArrayLength(other.items) + other.items[3] + ArrayLength(outer.inner.items)));
    return 0;
}
