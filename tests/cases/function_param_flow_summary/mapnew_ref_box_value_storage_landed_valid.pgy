// The HashMap value owns a copyable nominal field.  Landing must copy the
// borrowed String inside Box before MapSet, so the returned map no longer
// retains input and can cross the opaque Keep boundary independently.
struct Box {
    text: String;
}

struct BoxMapScope {
    values: HashMap<String, Box>;
}

extern "C" { func Keep(scope: BoxMapScope) -> Void; }

func Make(ref input: String) -> BoxMapScope {
    var values: HashMap<String, Box> = MapNew();
    MapSet(values, "key", Box(input));
    return BoxMapScope(values);
}

func Publish(ref input: String) -> Bool {
    Keep(Make(input));
    return true;
}

func Main() -> Void {
    let input = Concat("heap", " value");
    Log(Publish(input));
}
