struct StringMapScope {
    values: HashMap<String, String>;
}

extern "C" { func Keep(scope: StringMapScope) -> Void; }

func Make(ref input: String) -> StringMapScope {
    var values: HashMap<String, String> = MapNew();
    MapSet(values, "key", input);
    return StringMapScope(values);
}

func Publish(ref input: String) -> Bool {
    Keep(Make(input));
    return true;
}

func Main() -> Void {
    let input = Concat("heap", " value");
    Log(Publish(input));
}
