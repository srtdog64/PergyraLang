// Since 2026-10-22 the callee lends what it returns through a local, and
// the loan is copied where it is made because its owner changes after
// (returned_alias_is_the_formals_return). Below: the original shape.
// The returned payload shares the matched value's storage, so the call
// moves the request and a second call on it is refused.
struct Decl {
    names: Array<String>;
}

enum Request {
    Default(Bool),
    Verified(Decl, Bool),
}

func RequestDecl(request: Request) -> Decl {
    match request {
        case Default(emit):
            let empty: Array<String> = [];
            return Decl(empty);
        case Verified(decl, emit): return decl;
    }
}

func Keep(request: Request) -> Decl {
    return RequestDecl(request);
}

func Main() -> Int {
    let request: Request = Verified(Decl(["a"]), true);
    var decl: Decl = Keep(request);
    ArrayPush(decl.names, "b");
    let again: Decl = Keep(request);
    Print(again.names[0]);
    return 0;
}
