// CanonicalArgument and CanonicalName call each other, and TrimReuse may
// return its input. Main stores both results, then Fresh's. CanonicalName's
// declared result is still being built when the demand for CanonicalArgument
// checks its return relation, which then holds without it: the flow
// summaries stay open, so Fresh's new String is stored with no copy (the two
// recursive results are copied, as their proof does not hold yet).
func TrimReuse(expr: String) -> String {
    let n: Int = StringLength(expr);
    if n > 0 && Substring(expr, 0, 1) == " " {
        return Substring(expr, 1, n - 1);
    }
    return expr;
}

func CanonicalArgument(text: String) -> String {
    let argument: String = TrimReuse(text);
    if StringLength(argument) > 6 {
        return CanonicalName(Substring(argument, 1, StringLength(argument) - 1));
    }
    return CanonicalName(argument);
}

func CanonicalName(type_name: String) -> String {
    let text: String = TrimReuse(type_name);
    let n: Int = StringLength(text);
    let open: Int = StringIndexOf(text, "<");
    if open <= 0 || n < open + 2 {
        return text;
    }
    let base: String = TrimReuse(Substring(text, 0, open));
    let inner: String = Substring(text, open + 1, n - open - 2);
    var result: String = Concat(base, "<");
    result = Concat(result, CanonicalArgument(inner));
    return Concat(result, ">");
}

func Fresh(text: String) -> String {
    return Concat(text, "!");
}

func Main() -> Int {
    var rows: Array<String> = [];
    ArrayPush(rows, CanonicalName("Array< Int>"));
    ArrayPush(rows, CanonicalArgument(" Map<String>"));
    ArrayPush(rows, Fresh("x"));
    Print(rows[0]);
    Print(rows[1]);
    Print(rows[2]);
    return 0;
}
