// As named_string_field_forward_project_drop_landed_valid, but the node
// holds an Array of structs, which Clone copies only by value: no copy
// stands in for the String Fill keeps, so the drop stays refused.
struct Tag { name: String; }
struct TextNode { type_name: String; tags: Array<Tag>; }
struct Arena { atom_table: Array<String>; provenance_texts: Array<String>; }

func OwnedRows() -> Array<String> {
    var rows: Array<String> = [];
    ArrayPushOwnedString(rows, Concat("owned", " value"));
    return rows;
}

func Fill(source: Array<String>, inout nodes: Array<TextNode>) -> Void {
    let tags: Array<Tag> = [];
    ArrayPush(nodes, TextNode(source[0], tags));
}

func Project(nodes: Array<TextNode>) -> Arena {
    let provenance_texts: Array<String> = [];
    var atom_table: Array<String> = [""];
    var i: Int = 0;
    while i < ArrayLength(nodes) {
        if nodes[i].type_name != "" {
            ArrayPush(atom_table, nodes[i].type_name);
        }
        i = i + 1;
    }
    return Arena(atom_table, provenance_texts);
}

func ForwardProject(nodes: Array<TextNode>) -> Arena {
    return Project(nodes);
}

func Main() -> Void {
    let rows: Array<String> = OwnedRows();
    var nodes: Array<TextNode> = [];
    Fill(rows, nodes);
    let arena: Arena = ForwardProject(nodes);
    ArrayDropOwnedStrings(rows);
    Log(arena.atom_table[1]);
}
