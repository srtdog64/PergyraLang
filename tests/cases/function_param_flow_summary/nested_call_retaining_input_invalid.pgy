struct TextRecord { text: String; }
extern "C" { func Keep(text: String) -> Void; }
func Produce(ref text: String) -> String {
    Keep(text);
    return "independent result";
}
func Inspect(ref record: TextRecord) -> Bool {
    Log(Produce(record.text));
    return true;
}
func Main() -> Void {
    let record = TextRecord(Concat("heap", " text"));
    Log(Inspect(record));
}
