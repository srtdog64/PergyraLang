// An empty Array<String> has no element cleanup obligation. A declared reader
// may observe it when the callee summary proves no mutation, retention, release
// or result dependence; the descriptor remains local to this routine.
struct Arena { atoms: Array<String>; }

func VariantAt(arena: Arena, index: Int) -> Option<String> {
    if index < 0 || index >= ArrayLength(arena.atoms) { return None; }
    return Some(arena.atoms[index]);
}

func NonownerRead(text: String) -> Int { return StringLength(text); }
func CountNames(names: Array<String>) -> Int { return ArrayLength(names); }

func Main() -> Void {
    let arena: Arena = Arena(["red,blue"]);
    let selected: Option<String> = VariantAt(arena, 0);
    if IsSome(selected) {
        let text: String = UnwrapOption(selected);
        let no_names: Array<String> = [];
        Log(NonownerRead(text));
        Log(CountNames(no_names));
    }
}
