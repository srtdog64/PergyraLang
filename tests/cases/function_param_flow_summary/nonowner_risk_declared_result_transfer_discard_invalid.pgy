// The typed result path can prove where the Array moves, but a block-statement
// call has no result consumer and cannot retire this non-owner risk receipt.
struct Arena {
    atoms: Array<String>;
}

struct Facts {
    names: Array<String>;
}

func VariantAt(arena: Arena, index: Int) -> Option<String> {
    if index < 0 || index >= ArrayLength(arena.atoms) { return None; }
    return Some(arena.atoms[index]);
}

func NonownerRead(text: String) -> Int { return StringLength(text); }

func Forward(names: Array<String>) -> Facts {
    return Facts(names);
}

func Main() -> Void {
    let arena: Arena = Arena(["alpha"]);
    let selected: Option<String> = VariantAt(arena, 0);
    if IsSome(selected) {
        let text: String = UnwrapOption(selected);
        var names: Array<String> = [];
        Log(NonownerRead(text));
        ArrayPush(names, text);
        Forward(names);
    }
}
