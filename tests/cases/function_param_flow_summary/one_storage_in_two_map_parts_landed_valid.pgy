// One map in two fields of a returned value: Clone copies a map with a
// String key and an Int value slot by slot, so the earlier part is copied
// and each field owns its storage.
struct MapPair {
    first: HashMap<String, Int>;
    second: HashMap<String, Int>;
}

func Make() -> MapPair {
    let rows: HashMap<String, Int> = MapNew();
    return MapPair(rows, rows);
}

func Main() -> Int {
    let pair: MapPair = Make();
    Print(ToString(MapSize(pair.first)));
    return 0;
}
