// Keep returns None() or a Pair holding its ref input's Array, a loan of
// that input. Make returns the loan past the fact it owns.
struct Fact {
    present: Bool;
    ids: Array<Int>;
}

struct Pair {
    ids: Array<Int>;
}

func Keep(ref fact: Fact) -> Option<Pair> {
    if !fact.present {
        return None();
    }
    return Some(Pair(fact.ids));
}

func Make() -> Option<Pair> {
    let fact: Fact = Fact(true, [1, 2]);
    let kept: Option<Pair> = Keep(fact);
    return kept;
}

func Main() -> Int {
    let made: Option<Pair> = Make();
    if IsSome(made) {
        Print(ToString(ArrayLength(UnwrapOption(made).ids)));
    }
    return 0;
}
