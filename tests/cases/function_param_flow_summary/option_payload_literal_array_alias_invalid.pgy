func AliasedCodes() -> Array<String> {
    let codes: Array<String> = ["alpha"];
    let alias: Array<String> = codes;
    return alias;
}

func FindCode() -> Option<String> {
    let codes: Array<String> = AliasedCodes();
    return Some(codes[0]);
}

func Main() -> Void {
    let risk: Array<String> = [Concat("li", "ve")];
    let found: Option<String> = FindCode();
    let rows: Array<String> = [];
    if IsSome(found) {
        let text: String = UnwrapOption(found);
        ArrayPush(rows, text);
        Log(rows[0]);
    }
    Log(risk[0]);
}
