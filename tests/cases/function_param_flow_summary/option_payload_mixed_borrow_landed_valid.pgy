// The first analysis refuses this String where it leaves its Array owner;
// the next copies it there (Clone copies a String whole).
func MixedOptional(storage: Array<String>, fresh: Bool) -> Option<String> {
    if fresh {
        return Some(Substring(storage[0], 0, StringLength(storage[0])));
    }
    return Some(storage[0]);
}

func FormatPayload(value: String) -> String {
    return Concat(value, "!");
}

func Main() -> Void {
    let storage: Array<String> = [Concat("se", "ed")];
    var rows: Array<String> = [];
    let candidate: Option<String> = MixedOptional(storage, false);
    if IsSome(candidate) {
        let value: String = UnwrapOption(candidate);
        ArrayPush(rows, FormatPayload(value));
    }
}
