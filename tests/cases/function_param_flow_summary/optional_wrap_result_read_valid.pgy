// Wrap returns its outer's inner struct in an Option: the result holds the
// outer's storage and Wrap returns it, as a getter does. Report only reads
// the result, so Main's outer keeps its storage and its later use is
// admitted.
struct Inner {
    items: Array<Int>;
}

struct Outer {
    inner: Inner;
    count: Int;
}

func Wrap(outer: Outer) -> Option<Inner> {
    return Some(outer.inner);
}

func Report(outer: Outer) -> Int {
    let wrapped: Option<Inner> = Wrap(outer);
    let inner: Inner = UnwrapOption(wrapped);
    return ArrayLength(inner.items) + outer.count;
}

func Main() -> Int {
    let outer: Outer = Outer(Inner([1, 2]), 0);
    let n: Int = Report(outer);
    Print(ToString(n + ArrayLength(outer.inner.items) + outer.inner.items[1]));
    return 0;
}
