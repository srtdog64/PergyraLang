// Rebinding an own parameter to hold the ref input's storage and returning
// it lets the borrowed storage outlive the call.
struct Build {
    ok: Bool;
    names: Array<String>;
}

struct SourceFacts {
    names: Array<String>;
}

func Adopt(own build: Build, ref input: SourceFacts) -> Build {
    build = Build(build.ok, input.names);
    return build;
}

func Main() -> Int {
    let names: Array<String> = ["a"];
    let input: SourceFacts = SourceFacts(names);
    let empty: Array<String> = [];
    let build: Build = Build(true, empty);
    let adopted: Build = Adopt(build, input);
    Print(ToString(ArrayLength(adopted.names)));
    return 0;
}
