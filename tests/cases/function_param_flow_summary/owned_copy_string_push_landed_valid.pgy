// Main copies its names with Clone, which makes an Array<String> that owns
// its elements. StringConcat produces the new String independently, so the
// general push transfers that exact result without another owned-copy landing.
struct Book {
    names: Array<String>;
}

func Main() -> Int {
    let book: Book = Book([StringConcat("a", ""), StringConcat("b", "")]);
    var names: Array<String> = Clone(book.names);
    ArrayPush(names, StringConcat("c", ""));
    Print(ToString(ArrayLength(names) + ArrayLength(book.names)));
    Print(names[2]);
    return 0;
}
