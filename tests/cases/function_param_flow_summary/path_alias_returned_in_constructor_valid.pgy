// Wrap keeps a path of its by-value outer in a local and returns it inside
// a Holder, beside another path of the outer. That other path makes Wrap's
// summary return the outer, so the Holder is a getter's result, alias and
// all. Report only reads it, so Main's outer keeps its storage and its
// later use is admitted.
struct Inner {
    items: Array<Int>;
}

struct Outer {
    inner: Inner;
    extra: Array<Int>;
}

struct Holder {
    part: Inner;
    extra: Array<Int>;
}

func Wrap(outer: Outer) -> Holder {
    let inner: Inner = outer.inner;
    return Holder(inner, outer.extra);
}

func Report(outer: Outer) -> Int {
    let held: Holder = Wrap(outer);
    return ArrayLength(held.part.items) + ArrayLength(held.extra);
}

func Main() -> Int {
    let outer: Outer = Outer(Inner([1, 2]), [3]);
    let n: Int = Report(outer);
    Print(ToString(n + ArrayLength(outer.inner.items) + outer.inner.items[1]));
    return 0;
}
