func ReadCursor(ref label: String, inout cursor_out: Array<Int>) -> Option<Int> {
    let i: Int = 0;
    let total: Int = 0;
    let turn: Int = 0;
    while turn < 2 {
        i = cursor_out[0];
        total = total + i;
        turn = turn + 1;
    }
    return Some(total + StringLength(label));
}

func Probe(ref label: String) -> Option<Int> {
    var cursor: Array<Int> = [1];
    let observed = ReadCursor(label, cursor);
    return Some(UnwrapOption(observed) + cursor[0]);
}

func Main() -> Void {
    let label = Concat("heap", "");
    Log(UnwrapOption(Probe(label)));
}
