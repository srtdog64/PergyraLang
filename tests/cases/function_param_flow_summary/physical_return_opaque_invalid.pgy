struct TextRecord { text: String; }
extern "C" { func KeepText(ref text: String) -> Void; }
func Observe(ref text: String) -> String { return text; }
func ReadRecord(ref record: TextRecord, field: String) -> Bool {
    KeepText(Observe(record.text));
    return StringLength(field) > 0;
}
func Main() -> Void {
    let record = TextRecord(Concat("heap", " text"));
    Log(ReadRecord(record, "field"));
}
