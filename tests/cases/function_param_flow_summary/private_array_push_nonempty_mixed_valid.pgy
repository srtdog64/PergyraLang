func Inspect(ref input: Array<String>) -> Int {
    let rows: Array<String> = ["known", Concat("local", " value")];
    ArrayPush(rows, Concat("added", " value"));
    return ArrayLength(rows) + ArrayLength(input);
}

func Main() -> Void {
    let input: Array<String> = ["source"];
    Log(Inspect(input));
}
