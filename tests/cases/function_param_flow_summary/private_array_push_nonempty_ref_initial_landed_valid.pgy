// The ref String is copied at the Array literal boundary.  Copying Build's
// completed result instead would abandon the original Array descriptor, so
// the gate requires the Clone in Build and forbids one around Build in Publish.
extern "C" { func Keep(rows: Array<String>) -> Void; }

func Build(ref text: String) -> Array<String> {
    var rows: Array<String> = ["known", text];
    ArrayPush(rows, "added");
    return rows;
}

func Publish(ref text: String) -> Bool {
    Keep(Build(text));
    return true;
}

func Main() -> Void {
    let text = Concat("heap", " text");
    Log(Publish(text));
}
