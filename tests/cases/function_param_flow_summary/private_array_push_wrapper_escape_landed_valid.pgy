// Build copies the borrowed String at the private Array store before the
// Array is wrapped. The Wrapper handed to Keep therefore owns its element.
struct Wrapper { rows: Array<String>; }
extern "C" { func Keep(value: Wrapper) -> Void; }
func Build(ref input: Array<String>) -> Wrapper {
    var owned_rows: Array<String> = [];
    ArrayPush(owned_rows, input[0]);
    return Wrapper(owned_rows);
}
func Publish(ref input: Array<String>) -> Bool { Keep(Build(input)); return true; }
func Main() -> Void {
    let input: Array<String> = [Concat("heap", " text")];
    Log(Publish(input));
}
