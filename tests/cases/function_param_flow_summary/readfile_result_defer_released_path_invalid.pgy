func Consume(text: String) -> Int {
    return StringLength(text);
}

func Main() -> Void {
    var paths: Array<String> = [];
    ArrayPushOwnedString(paths, Concat("tests/cases/backend_compare/string_io/", "io.txt"));
    let risk: Array<String> = [Concat("he", "ap")];
    defer {
        Log(Consume(ReadFile(paths[0])));
    };
    ArrayDropOwnedStrings(paths);
    Log(risk[0]);
}
