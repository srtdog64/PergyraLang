func Consume(text: String) -> Int {
    return StringLength(text);
}

func Main() -> Void {
    let risk: Array<String> = [Concat("he", "ap")];
    Log(Consume(ReadFile("tests/cases/backend_compare/string_io/io.txt")));
    Log(Consume(ReadFile("missing-result-source-probe.txt")));
    Log(risk[0]);
}
