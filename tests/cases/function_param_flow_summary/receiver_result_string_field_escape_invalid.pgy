class Holder {
    let text: String;

    func Echo(self) -> String {
        return text;
    }
}

func EchoWrapper(ref holder: Holder) -> String {
    return holder.Echo();
}

func Inspect(ref holder: Holder) -> Option<Int> {
    let echoed = EchoWrapper(holder);
    return Some(StringLength(echoed));
}

func Main() -> Void {
    let holder = Holder(Concat("q", ""));
    Log(UnwrapOption(Inspect(holder)));
}
