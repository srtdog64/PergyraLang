class Holder {
    let text: String;

    func Echo(self) -> String {
        return text;
    }
}

struct Echoed {
    text: String;
}

func EchoWrapper(ref holder: Holder) -> String {
    return holder.Echo();
}

func Inspect(ref holder: Holder) -> Echoed {
    let echoed = EchoWrapper(holder);
    return Echoed(echoed);
}

func Main() -> Void {
    let holder = Holder(Concat("q", ""));
    let inspected = Inspect(holder);
    Log(StringLength(inspected.text));
}
