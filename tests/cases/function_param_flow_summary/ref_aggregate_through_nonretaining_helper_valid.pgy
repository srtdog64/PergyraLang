// Passing a borrowed aggregate through a helper that only reads it is not an
// escape. The helper edge is internal to ReadTwice's call boundary.
struct Pair {
    left: Int;
    right: Int;
}

func ReadPair(ref pair: Pair) -> Int {
    return pair.left + pair.right;
}

func ReadTwice(ref pair: Pair) -> Int {
    return ReadPair(pair) + ReadPair(pair);
}

func Main() -> Int {
    let pair: Pair = Pair(3, 4);
    Log(ReadTwice(pair));
    return 0;
}
