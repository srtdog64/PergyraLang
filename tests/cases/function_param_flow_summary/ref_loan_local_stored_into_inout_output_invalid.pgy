// Fill stores a local its ref index lent into the caller's inout output,
// which did not hold it: index's storage reaches the output, so the call
// escapes index. No copy lands for a local yet, so the store stays refused.
struct Index {
    labels: Array<String>;
}

struct Out {
    names: Array<String>;
}

func Lend(ref index: Index) -> Array<String> {
    let names: Array<String> = [];
    let i: Int = 0;
    while i < ArrayLength(index.labels) {
        ArrayPush(names, index.labels[i]);
        i = i + 1;
    }
    return names;
}

func Fill(ref index: Index, inout out: Out) -> Void {
    let lent: Array<String> = Lend(index);
    out.names = lent;
}

func Make(inout o: Out) -> Void {
    let index: Index = Index([Concat("a", "")]);
    Fill(index, o);
}

func Main() -> Int {
    let none: Array<String> = [];
    var o: Out = Out(none);
    Make(o);
    Log(o.names[0]);
    return 0;
}
