// The first analysis refuses the loan this program's ref call lends; the
// next copies it where the call makes it (Clone copies the result whole).
struct InputRecord { text: String; }

func Wrap(ref input: String) -> Array<String> {
    let rows: Array<String> = [];
    ArrayPush(rows, input);
    return rows;
}

func Leak(ref record: InputRecord) -> Array<String> {
    return Wrap(record.text);
}

func MakeLeak() -> Array<String> {
    let record = InputRecord(Concat("heap", " text"));
    return Leak(record);
}

func Main() -> Void {
    let leaked = MakeLeak();
    Log(ArrayLength(leaked));
}
