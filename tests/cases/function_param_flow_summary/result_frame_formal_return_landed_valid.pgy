// The first analysis refuses the loan this program's ref call lends; the
// next copies it where the call makes it (Clone copies the result whole).
struct InputRecord { text: String; }

func Forward(ref input: String) -> String {
    return input;
}

func Leak(ref record: InputRecord) -> String {
    return Forward(record.text);
}

func Keep(ref record: InputRecord) -> InputRecord {
    return InputRecord(Leak(record));
}

func MakeKept() -> InputRecord {
    let record = InputRecord(Concat("heap", " text"));
    return Keep(record);
}

func Main() -> Void {
    let kept = MakeKept();
    Log(StringLength(kept.text));
}
