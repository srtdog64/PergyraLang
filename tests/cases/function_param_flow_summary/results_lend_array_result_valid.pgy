// Wrap's Array holds its borrowed String, and Probe lends its record's
// String through it. Main measures the Array while it owns the record.
struct TextRecord { text: String; }

func Wrap(ref text: String) -> Array<String> {
    return ["known", text];
}

func Probe(ref record: TextRecord) -> Array<String> {
    return Wrap(record.text);
}

func Main() -> Void {
    let record = TextRecord(Concat("heap", " text"));
    Log(ArrayLength(Probe(record)));
}
