// The first analysis refuses the loan this program's ref call lends; the
// next copies it where the call makes it (Clone copies the result whole).
extern "C" { func Fill(inout text: String) -> Void; }
func Echo(ref text: String) -> String { return text; }
func Publish(inout output: String) -> Void {
    var held: String = "literal";
    Fill(held);
    output = Echo(held);
}
func Main() -> Void {
    var output = "";
    Publish(output);
    Log(output);
}
