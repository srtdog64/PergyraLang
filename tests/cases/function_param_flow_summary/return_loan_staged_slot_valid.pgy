// The String is created in Publish, lent through EchoText, and then staged in
// another local before the Slot takes it.  The staged local preserves the one
// local owner, so the transfer needs no compiler-inserted Clone.
struct TextRecord { text: String; }
func EchoText(ref text: String) -> String { return text; }
func Publish(ref output: Slot<String>) -> Bool {
    let record = TextRecord(Concat("heap", " text"));
    let staged = EchoText(record.text);
    Write(output, staged);
    return true;
}
func Main() -> Void {
    let output: Slot<String> = ClaimSlot();
    Log(Publish(output));
    Log(Read(output));
    Release(output);
}
