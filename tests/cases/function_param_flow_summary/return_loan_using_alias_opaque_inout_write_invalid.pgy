// `using` binds an immutable name, so an alias of a `var` carries no write
// authority: handing it to an opaque inout call is refused at the argument.
extern "C" { func Fill(inout text: String) -> Void; }
func Echo(ref text: String) -> String { return text; }
func Publish(ref output: Slot<String>) -> Void {
    var held: String = "literal";
    using held as alias;
    Fill(alias);
    Write(output, Echo(held));
}
func Main() -> Void {
    let output: Slot<String> = ClaimSlot();
    Publish(output);
    Log(Read(output));
    Release(output);
}
