// A Slice view is its receiver's storage, so Window lends its borrowed
// Array. MakeWindow returns that loan past the Array it owns.
func Window(ref rows: Array<Int>) -> Slice<Int> {
    return rows.Slice(0, 1);
}

func MakeWindow() -> Slice<Int> {
    let rows: Array<Int> = [7, 8];
    return Window(rows);
}

func Main() -> Int {
    let view: Slice<Int> = MakeWindow();
    Print(ToString(view[0]));
    return 0;
}
