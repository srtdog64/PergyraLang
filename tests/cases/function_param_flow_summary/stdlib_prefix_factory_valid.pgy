struct PrefixDecision {
    matched: Bool;
}

func PrefixReadingFactory() -> PrefixDecision {
    let source = Concat("alpha", "beta");
    let prefix = Concat("alpha", "");
    let matched = SubStartsWithLen(source, StringLength(source), 0, prefix);
    return PrefixDecision(matched);
}

func Probe(ref text: String) -> Option<Int> {
    let decision = PrefixReadingFactory();
    if decision.matched {
        return Some(StringLength(text) + 1);
    }
    return Some(StringLength(text));
}

func Main() -> Void {
    let text = Concat("heap", " text");
    Log(UnwrapOption(Probe(text)));
}
