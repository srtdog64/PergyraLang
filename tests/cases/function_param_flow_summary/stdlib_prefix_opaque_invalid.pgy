extern "C" {
    func OpaqueStartsWithLen(source: String, sourceLength: Int, start: Int,
        prefix: String) -> Bool;
}

func Probe(ref source: String, ref prefix: String) -> Bool {
    let sourceLength = StringLength(source);
    return OpaqueStartsWithLen(source, sourceLength, 0, prefix);
}

func Main() -> Void {
    let source = Concat("alpha", "beta");
    let prefix = Concat("alpha", "");
    Log(Probe(source, prefix));
}
