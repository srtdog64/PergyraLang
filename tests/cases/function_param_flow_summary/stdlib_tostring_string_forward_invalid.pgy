struct InputRecord { text: String; }

func Forward(ref input: String) -> Option<String>
{
    return Some(ToString(input));
}

func Leak(ref record: InputRecord) -> Option<String>
{
    return Forward(record.text);
}

func Keep(ref record: InputRecord) -> InputRecord
{
    let leaked = Leak(record);
    return InputRecord(UnwrapOption(leaked));
}

func Main() -> Void
{
    let record = InputRecord(Concat("heap", " text"));
    let kept = Keep(record);
    Log(StringLength(kept.text));
}
