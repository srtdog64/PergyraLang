struct TextRecord { text: String; }
extern "C" { func Keep(text: String) -> Void; }
func Retain(text: String) -> String { Keep(text); return text; }
// Trim copies backing, but its operand must still be evaluated before that copy.
func Extract(ref record: TextRecord) -> Void { Keep(StringTrim(Retain(record.text))); }
func Main() -> Void {
    let record = TextRecord(Concat(" heap", " text "));
    Extract(record);
}
