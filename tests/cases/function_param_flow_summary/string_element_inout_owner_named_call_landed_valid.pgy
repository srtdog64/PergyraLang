// A callee that also takes the element's Array inout can replace and free
// the element while it reads the borrowed String.
// No proof admits the callee keeping or returning the String element, so
// the next analysis copies the element where the call takes it, and the
// Array's later release or change no longer reaches it.
func Names(n: Int) -> Array<String> {
    var out: Array<String> = [];
    var i: Int = 0;
    while i < n {
        ArrayPush(out, ToString(i));
        i = i + 1;
    }
    return out;
}

func Replaced(inout list: Array<String>, text: String) -> Bool {
    ArraySet(list, 0, "x");
    return text == "x";
}

func Main() -> Int {
    var names: Array<String> = Names(3);
    let same: Bool = Replaced(names, names[0]);
    Print(ToString(ArrayLength(names)));
    return 0;
}
