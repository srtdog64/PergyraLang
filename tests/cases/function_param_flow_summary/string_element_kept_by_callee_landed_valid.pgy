// Join returns its line when the accumulator is empty, so block may be an
// element of the local parts and is returned. Inside the loop that loan
// holds: parts is pushed only before it. The returned block is copied,
// as a returned loan of a local is.
func Join(acc: String, line: String) -> String {
    if StringLength(acc) == 0 { return line; }
    return Concat(acc, Concat("|", line));
}

func Lines() -> String {
    var parts: Array<String> = [];
    ArrayPush(parts, Concat("a", "1"));
    ArrayPush(parts, Concat("b", "2"));
    var block: String = "";
    var i: Int = 0;
    while i < ArrayLength(parts) {
        block = Join(block, parts[i]);
        i = i + 1;
    }
    return block;
}

func Main() -> Int {
    Print(Lines());
    return 0;
}
