// A receiver that already holds borrowed literals has no uniform element
// ownership for an owned push: the String lands as a Clone a plain push keeps.
func Names(n: Int) -> Array<String> {
    var out: Array<String> = [];
    var i: Int = 0;
    while i < n {
        ArrayPush(out, ToString(i));
        i = i + 1;
    }
    return out;
}

func Marked(path: String) -> Bool {
    return path != "1";
}

func Selected(n: Int) -> Array<String> {
    let entries: Array<String> = Names(n);
    var rows: Array<String> = ["header"];
    var i: Int = 0;
    while i < ArrayLength(entries) {
        let path: String = entries[i];
        if Marked(path) {
            ArrayPush(rows, path);
        }
        i = i + 1;
    }
    return rows;
}

func Main() -> Int {
    let rows: Array<String> = Selected(4);
    var i: Int = 0;
    while i < ArrayLength(rows) {
        Print(rows[i]);
        i = i + 1;
    }
    return 0;
}
