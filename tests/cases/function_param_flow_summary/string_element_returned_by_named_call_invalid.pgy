// A callee that returns its String parameter keeps the element past the
// call, so the element needs an owner proof the local Array cannot give.
func Names(n: Int) -> Array<String> {
    let out: Array<String> = [];
    let i: Int = 0;
    while i < n {
        ArrayPush(out, ToString(i));
        i = i + 1;
    }
    return out;
}

func Kept(text: String) -> String {
    return text;
}

func Main() -> Int {
    let names: Array<String> = Names(3);
    let kept: String = Kept(names[1]);
    Print(kept);
    return 0;
}
