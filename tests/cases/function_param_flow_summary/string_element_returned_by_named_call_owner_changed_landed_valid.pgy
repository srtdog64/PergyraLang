// Kept lends an element of names to kept, and Main replaces that element
// before it prints the loan.
// No proof admits the callee keeping or returning the String element, so
// the next analysis copies the element where the call takes it, and the
// Array's later release or change no longer reaches it.
func Names(n: Int) -> Array<String> {
    var out: Array<String> = [];
    var i: Int = 0;
    while i < n {
        ArrayPush(out, ToString(i));
        i = i + 1;
    }
    return out;
}

func Kept(text: String) -> String {
    return text;
}

func Main() -> Int {
    var names: Array<String> = Names(3);
    let kept: String = Kept(names[1]);
    ArraySet(names, 1, ToString(9));
    Print(kept);
    return 0;
}
