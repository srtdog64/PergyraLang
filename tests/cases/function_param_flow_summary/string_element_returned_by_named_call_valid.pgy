// Kept returns its String parameter, so the call lends the element of
// Main's names to kept. The loan stays in Main and nothing changes names
// while it lives, so the call is admitted.
func Names(n: Int) -> Array<String> {
    var out: Array<String> = [];
    var i: Int = 0;
    while i < n {
        ArrayPush(out, ToString(i));
        i = i + 1;
    }
    return out;
}

func Kept(text: String) -> String {
    return text;
}

func Main() -> Int {
    let names: Array<String> = Names(3);
    let kept: String = Kept(names[1]);
    Print(kept);
    return 0;
}
