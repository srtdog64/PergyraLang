// ToString(String) returns its input, an element of the owned array that is
// dropped before Keep's output is read. No proof admits the argument, so the
// next analysis passes a copy of it and the output keeps a String of its own.
func Keep(inout out: Array<String>, text: String) -> Void {
    ArrayPush(out, text);
}

func Names() -> Array<String> {
    var names: Array<String> = [];
    ArrayPushOwnedString(names, "a");
    return names;
}

func Main() -> Int {
    let owned: Array<String> = Names();
    var out: Array<String> = [];
    Keep(out, ToString(owned[0]));
    ArrayDropOwnedStrings(owned);
    Print(out[0]);
    return 0;
}
