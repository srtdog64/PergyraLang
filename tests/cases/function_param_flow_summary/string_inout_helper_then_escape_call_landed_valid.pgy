// The helper's formal String lands as an owned copy in the array, so the
// second callee may keep the array: every element it holds is owned.
func Keep(inout out: Array<String>, text: String) -> Void {
    ArrayPush(out, text);
}

func Stash(inout out: Array<String>, inout shelf: Array<Array<String>>) -> Void {
    ArrayPush(shelf, out);
}

func Main() -> Int {
    var out: Array<String> = [];
    var shelf: Array<Array<String>> = [];
    Keep(out, "a");
    Stash(out, shelf);
    Print(ToString(ArrayLength(shelf)));
    return 0;
}
