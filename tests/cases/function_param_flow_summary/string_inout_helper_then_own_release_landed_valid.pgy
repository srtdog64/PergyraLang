// The helper's formal String goes into an inout output, so it lands as an
// owned copy: Drain releases that copy, not the caller's literal.
func Keep(inout out: Array<String>, text: String) -> Void {
    ArrayPush(out, text);
}

func Drain(own out: Array<String>) -> Void {
    ArrayDropOwnedStrings(out);
}

func Main() -> Int {
    var out: Array<String> = [];
    Keep(out, "a");
    Drain(out);
    return 0;
}
