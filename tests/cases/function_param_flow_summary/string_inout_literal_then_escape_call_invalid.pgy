// The helper pushes a String literal into the array, a borrowed element no
// landing copies. A second callee that keeps the array still needs owned
// elements, and is refused (15:5).
func Mark(inout out: Array<String>) -> Void {
    ArrayPush(out, "a");
}

func Stash(inout out: Array<String>, inout shelf: Array<Array<String>>) -> Void {
    ArrayPush(shelf, out);
}

func Main() -> Int {
    let out: Array<String> = [];
    let shelf: Array<Array<String>> = [];
    Mark(out);
    Stash(out, shelf);
    Print(ToString(ArrayLength(shelf)));
    return 0;
}
