// A literal pushed into an inout output lands as an owned copy, so the
// second callee may keep the array: every element it holds is owned.
func Mark(inout out: Array<String>) -> Void {
    ArrayPush(out, "a");
}

func Stash(inout out: Array<String>, inout shelf: Array<Array<String>>) -> Void {
    ArrayPush(shelf, out);
}

func Main() -> Int {
    let out: Array<String> = [];
    let shelf: Array<Array<String>> = [];
    Mark(out);
    Stash(out, shelf);
    Print(ToString(ArrayLength(shelf)));
    return 0;
}
