// Label returns a String literal. The compiler-owned store landing gives Mark
// an owned element, and Stash clones the aggregate at the retaining boundary.
func Label() -> String {
    return "label";
}
func Mark(inout out: Array<String>) -> Void {
    ArrayPush(out, Label());
}
func Stash(inout out: Array<String>, inout shelf: Array<Array<String>>) -> Void {
    ArrayPush(shelf, out);
}

func Main() -> Int {
    let out: Array<String> = [];
    let shelf: Array<Array<String>> = [];
    Mark(out);
    Stash(out, shelf);
    Print(ToString(ArrayLength(shelf)));
    return 0;
}
