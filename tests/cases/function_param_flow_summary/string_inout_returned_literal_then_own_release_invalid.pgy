// Label returns a String literal. Pushed into the output it is not an owned
// element, so handing the Array to an owner that releases its Strings would
// free the literal; that handoff is refused (19:5).
func Label() -> String {
    return "label";
}

func Mark(inout out: Array<String>) -> Void {
    ArrayPush(out, Label());
}

func Drain(own out: Array<String>) -> Void {
    ArrayDropOwnedStrings(out);
}

func Main() -> Int {
    let out: Array<String> = [];
    Mark(out);
    Drain(out);
    return 0;
}
