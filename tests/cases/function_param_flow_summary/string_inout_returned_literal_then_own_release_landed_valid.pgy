// Label returns a literal String. The compiler-owned store landing makes the
// element in Mark's output independently owned before Drain releases it.
func Label() -> String {
    return "label";
}
func Mark(inout out: Array<String>) -> Void {
    ArrayPush(out, Label());
}
func Drain(own out: Array<String>) -> Void {
    ArrayDropOwnedStrings(out);
}

func Main() -> Int {
    let out: Array<String> = [];
    Mark(out);
    Drain(out);
    return 0;
}
