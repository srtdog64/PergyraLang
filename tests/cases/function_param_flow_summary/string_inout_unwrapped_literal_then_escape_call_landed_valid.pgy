// UnwrapOption hands back its payload. The compiler-owned store landing copies
// that String into Mark's array, and Stash clones the retained aggregate.
func Mark(inout out: Array<String>) -> Void {
    let label: Option<String> = Some("label");
    ArrayPush(out, UnwrapOption(label));
}
func Stash(inout out: Array<String>, inout shelf: Array<Array<String>>) -> Void {
    ArrayPush(shelf, out);
}
func Main() -> Int {
    var out: Array<String> = [];
    var shelf: Array<Array<String>> = [];
    Mark(out);
    Stash(out, shelf);
    Print(ToString(ArrayLength(shelf)));
    return 0;
}
