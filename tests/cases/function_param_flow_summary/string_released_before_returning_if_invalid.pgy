// names is released before an if whose only branch returns; the path that
// skips the branch still reads the released element.
func Clear(own names: Array<String>) -> Void {
    ArrayDropOwnedStrings(names);
}

func Pick(i: Int) -> Int {
    var names: Array<String> = [];
    ArrayPushOwnedString(names, Concat("re", "d"));
    let text: String = names[0];
    Clear(names);
    if i < 0 {
        return 0;
    }
    return StringLength(text);
}

func Main() -> Int {
    Print(ToString(Pick(1)));
    return 0;
}
