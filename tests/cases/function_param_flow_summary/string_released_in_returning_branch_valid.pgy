// A branch that releases names and returns takes the release with it: after
// the if, and in the else branch, no path has released the element text
// borrows.
func Clear(own names: Array<String>) -> Void {
    ArrayDropOwnedStrings(names);
}

func Pick(i: Int) -> Int {
    let names: Array<String> = [];
    ArrayPushOwnedString(names, Concat("re", "d"));
    let text: String = names[0];
    if i < 0 {
        Clear(names);
        return 0;
    }
    let length: Int = StringLength(text);
    Clear(names);
    return length;
}

func Choose(i: Int) -> Int {
    let names: Array<String> = [];
    ArrayPushOwnedString(names, Concat("bl", "ue"));
    let text: String = names[0];
    let length: Int = 0;
    if i < 0 {
        Clear(names);
        return 0;
    } else {
        length = StringLength(text);
    }
    Clear(names);
    return length;
}

func Main() -> Int {
    Print(ToString(Pick(1)));
    Print(ToString(Pick(-1)));
    Print(ToString(Choose(1)));
    return 0;
}
