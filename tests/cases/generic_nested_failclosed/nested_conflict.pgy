// T is bound by Option<T> (argument 1) and by T (argument 2) to two types.
// The checker binds generic parameters structurally, so this is refused at
// semantic; it used to pass semantic and fail in MIR lowering.
func Both<T>(a: Option<T>, b: T) -> Int {
    if IsSome(a) {
        return 1;
    }
    return 0;
}

func Main() -> Void {
    Log(ToString(Both(Some(1), "x")));
}
