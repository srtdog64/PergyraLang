// The where-clause bound on T is checked against the structural binding
// (T = Card from Option<Card>); it used to be refused with "could not
// materialize generic argument" because only a bare-T argument bound T.
ability Sortable {}
subject Card { let value: Int; }
role CardContract for Card { impl ability Sortable {} }

func Peek<T>(o: Option<T>) -> Int where T: Sortable {
    if IsSome(o) {
        return 1;
    }
    return 0;
}

func Main() -> Void {
    Log(ToString(Peek(Some(Card(4)))));
}
