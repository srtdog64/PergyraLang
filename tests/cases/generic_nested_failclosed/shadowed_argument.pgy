// A name reused after its block has closed: the String `v` in the block and
// the later Int `v` are two bindings. The text binder read the argument's
// type by the local's name, bound T = Int for the call in the block, and C
// and LLVM both received a String for an Int parameter. The checker binds
// T = String for the call in the block and T = Int for the later one.
func Wrap<T>(x: T) -> Option<T> {
    return Some(x);
}

func Main() -> Void {
    let flag: Int = 1;
    if flag > 0 {
        let v: String = "inner";
        let w: Option<String> = Wrap(v);
        if IsSome(w) {
            Log(UnwrapOption(w));
        }
    }
    let v: Int = 1;
    let o: Option<Int> = Wrap(v);
    if IsSome(o) {
        Log(ToString(UnwrapOption(o)));
    }
}
