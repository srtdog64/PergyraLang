// `name` borrows the List element items[0], and Replace's ListSet frees it
// before `name` is read (heap-use-after-free on C and LLVM before
// 2026-11-20). A ListGet loan has no storage source of its own, so the
// compiler copies the String where `name` is defined, as after a direct
// ListSet. Admitted; prints 5 2.
func Replace(inout items: List<String>) -> Void {
    ListSet(items, 0, ToString(99));
}
func Run(seed: Int) -> Int {
    var items: List<String> = ListNew();
    ListPush(items, ToString(seed));
    ListPush(items, ToString(seed + 1));
    let name: String = ListGet(items, 0);
    Replace(items);
    Log(name);
    return ListSize(items);
}
func Main() -> Void { Log(Run(5)); }
