func Pick(flag: Bool, lhs: Int, rhs: Int) -> Int {
    var chosen: Int = lhs;
    if flag {
        chosen = 7;
    }
    return chosen;
}

func GuardedDivide(flag: Bool, divisor: Int) -> Int {
    var chosen: Int = 0;
    if flag {
        chosen = 100 / divisor;
    }
    return chosen;
}

struct SpeculationRows {
    values: Array<String>;
}

// Moving a member Array into a local requires the MIR copyout synthesizer to
// restore it on this early return.  That post-lowering expression must receive
// the same speculation fact as expressions created by ordinary lowering.
func RestoreBeforeEarlyReturn(inout rows: SpeculationRows, stop: Bool) -> Bool {
    var values: Array<String> = rows.values;
    if stop { return false; }
    ArraySet(values, 0, "new");
    rows.values = values;
    return true;
}

func Main() -> Void {
    var rows: SpeculationRows = SpeculationRows(["old"]);
    Log(RestoreBeforeEarlyReturn(rows, true));
    Log(rows.values[0]);
    Log(Pick(true, 3, 7));
    Log(GuardedDivide(false, 0));
}
