// One task builds a struct holding its own Array; nothing is shared.
struct Holder {
    data: Array<Int>;
}

func Main() -> Void {
    let mut x: Int = 0;
    let mut y: Int = 0;
    parallel {
        { let a: Array<Int> = [5, 6]; let h: Holder = Holder(a); x = ArrayLength(h.data) + 3; }
        { y = 2; }
    }
    Log(x + y);
}
