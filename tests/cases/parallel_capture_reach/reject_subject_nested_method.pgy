// The write hides one call deeper: Tick calls Step, which writes self.
subject Counter {
    var n: Int;

    func Step(self, x: Int) -> Int {
        self.n = self.n + x;
        return self.n;
    }

    func Tick(self) -> Int {
        return self.Step(1);
    }
}

func Main() -> Void {
    let counter: Counter = Counter(0);
    var a: Int = 0;
    var b: Int = 0;
    parallel {
        { a = counter.Tick(); }
        { b = counter.Tick(); }
    }
    Log(a + b);
}
