// Both arms only read the subject through a read-only method: admitted.
subject Counter {
    var n: Int;

    func Get(self) -> Int {
        return self.n;
    }
}

func Main() -> Void {
    let counter: Counter = Counter(7);
    var a: Int = 0;
    var b: Int = 0;
    parallel {
        { a = counter.Get(); }
        { b = counter.Get() + counter.n; }
    }
    Log(a + b);
}
