// Both tasks borrow the subject through a ref parameter: read-only, admitted.
subject Counter {
    let mut n: Int;
}

func Inspect(ref c: Counter) -> Int {
    return c.n;
}

func Main() -> Void {
    let counter: Counter = Counter(4);
    let mut a: Int = 0;
    let mut b: Int = 0;
    parallel {
        { a = Inspect(counter); }
        { b = Inspect(counter) * 2; }
    }
    Log(a + b);
}
