// Only one arm touches the subject: exclusive, admitted.
subject Counter {
    let mut n: Int;

    func Step(self, x: Int) -> Int {
        self.n = self.n + x;
        return self.n;
    }
}

func Main() -> Void {
    let counter: Counter = Counter(0);
    let mut a: Int = 0;
    let mut b: Int = 0;
    parallel {
        { let i: Int = 0; while i < 1000 { a = counter.Step(1); i = i + 1; } }
        { let j: Int = 0; while j < 1000 { b = b + 1; j = j + 1; } }
    }
    Log(counter.n);
    Log(b);
}
