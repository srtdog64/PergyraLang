// Each task builds its own subject; the type name is not a shared binding.
subject Counter {
    var n: Int;

    func Step(self) -> Void {
        self.n = self.n + 1;
    }
}

func Main() -> Void {
    var a: Int = 0;
    var b: Int = 0;
    parallel {
        { let c: Counter = Counter(1); c.Step(); a = c.n; }
        { let d: Counter = Counter(2); d.Step(); b = d.n; }
    }
    Log(a + b);
}
