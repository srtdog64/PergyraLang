// Negative: the split boundary is a `let mut` local, so its value is not
// provably identical at the two slicing sites -- no split fact is
// recorded and the collection reject fires.
func Main() -> Void {
    let mut arr: Array<Int> = [];
    let mut k: Int = 0;
    while k < 8 { ArrayPush(arr, 0); k = k + 1; }
    let mut mid: Int = 4;
    let lo: Slice<Int> = arr.Slice(0, mid);
    let hi: Slice<Int> = arr.Slice(mid, 4);
    let mut i: Int = 0;
    let mut j: Int = 0;
    parallel {
        while i < 4 { lo[i] = 1; i = i + 1; }
        while j < 4 { hi[j] = 3; j = j + 1; }
    }
    Log(arr[0]);
}
