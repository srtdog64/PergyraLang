// Negative: two arbitrary views with overlapping ranges ([1,4) and [2,6))
// are not a construction-guaranteed split pair -- no lower/upper match, so
// admission is denied and the collection reject fires.
func Main() -> Void {
    let mut arr: Array<Int> = [];
    let mut k: Int = 0;
    while k < 8 { ArrayPush(arr, 0); k = k + 1; }
    let a: Slice<Int> = arr.Slice(1, 3);
    let b: Slice<Int> = arr.Slice(2, 4);
    let mut i: Int = 0;
    let mut j: Int = 0;
    parallel {
        while i < 3 { a[i] = 1; i = i + 1; }
        while j < 4 { b[j] = 2; j = j + 1; }
    }
    Log(arr[0]);
}
