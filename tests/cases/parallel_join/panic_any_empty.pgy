// R3 runtime witness: "the first of nothing" has no answer. An empty
// fan-out leaves the decision cell untouched, so the join panics
// fail-closed on both backends instead of returning a fake value
// (same rationale as empty min/max).
func Main() -> Void {
    let mut xs: Array<Int> = [];
    let none: Int = parallel (x in xs) join with any { give x; };
    Log(none);
}
