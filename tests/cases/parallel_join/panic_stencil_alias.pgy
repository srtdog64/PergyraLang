// R5 runtime witness: `let b = a;` copies the HANDLE, not the buffer.
// A snapshot-read capture whose backing is the index-written array
// would let free-index reads race the per-index writes, so the fan-out
// entry check panics fail-closed on both backends.
func Main() -> Void {
    let mut a: Array<Int> = [];
    for k in 0..4 { ArrayPush(a, k); }
    let b = a;
    parallel (i in 0..4) {
        a[i] = b[0] + i;
    }
    Log(a[0]);
}
