// docs/181 R2 reject: give must be the final statement of the body --
// R2 carries exactly one unconditional result per task.
func Main() -> Void {
    let mut xs: Array<Int> = [];
    let mut k: Int = 0;
    while k < 4 { ArrayPush(xs, k); k = k + 1; }
    let rs = parallel (x in xs) join with all {
        give x * x;
        Log(x);
    };
}
