// Negative: String is not snapshot-eligible (only primitive scalars are),
// so one arm writing while another reads stays a rejected read-write race.
func Main() -> Void {
    var s: String = "a";
    var t: String = "-";
    parallel {
        { s = "b"; }
        { t = s; }
    }
    Log(s);
    Log(t);
}
