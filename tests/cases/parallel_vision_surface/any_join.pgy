// Declared vision surface (docs/181 SS1.4 R3): any-join needs the
// cooperative cancellation protocol first; it must fail closed, never
// silently downgrade to all-join.
func Main() -> Void {
    let mut xs: Array<Int> = [];
    ArrayPush(xs, 1);
    parallel (x in xs) join with any {
        Log(x);
    }
}
