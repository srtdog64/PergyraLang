// Declared vision surface (docs/181 §1): the join-over-collection form
// must fail closed until its rung 0 lands -- previously it silently
// degenerated to a no-op (the collection expression was parsed and
// destroyed).
func Main() -> Void {
    let xs: Array<Int> = [];
    parallel (xs) join with all {
        Log(1);
    }
}
