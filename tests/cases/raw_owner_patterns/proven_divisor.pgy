func Dividend() -> Int {
    Log(11);
    return 513;
}
func Divisor() -> Int {
    Log(22);
    return 256;
}
func Main() -> Void {
    Log(Dividend() / Divisor());
    var pass: Int = 0;
    var divisor: Int = 1;
    var total: Int = 0;
    while pass < 2 {
        total = total + 513 / divisor + 513 % divisor;
        divisor = divisor * 256;
        pass = pass + 1;
    }
    Log(total);
    let negative: Int = -2;
    Log(9 / negative);
    Log(9 % negative);
}
