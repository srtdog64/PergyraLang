// An outward Slice retains storage. Measure its final retirement separately.
extern "C"
{
    func PatternIterations() -> Int;
    func PatternStart() -> Void;
    func PatternFinish(value: Int) -> Void;
}
func ReturnedView() -> Slice<Int>
{
    let values: Array<Int> = [1, 2, 3];
    return values.Slice(0, 2);
}
func Work() -> Int
{
    let view: Slice<Int> = ReturnedView();
    return view[0];
}
func Main() -> Void
{
    let count: Int = PatternIterations();
    PatternStart();
    PatternFinish(Work());
}
