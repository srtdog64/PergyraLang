func IntValue() -> Int {
    var values: Array<Int> = [1, 2];
    var view: Slice<Int> = values.Slice(0, 2);
    view[0] = 3;
    return view[0];
}
func LongValue() -> Long {
    var values: Array<Long> = [1L, 2L];
    var view: Slice<Long> = values.Slice(0, 2);
    view[0] = 3L;
    return view[0];
}
func FloatValue() -> Float {
    var values: Array<Float> = [1.5, 2.5];
    var view: Slice<Float> = values.Slice(0, 2);
    view[0] = 3.5;
    return view[0];
}
func DoubleValue() -> Double {
    let one: Double = 1.5;
    let two: Double = 2.5;
    let three: Double = 3.5;
    var values: Array<Double> = [one, two];
    var view: Slice<Double> = values.Slice(0, 2);
    view[0] = three;
    return view[0];
}
func BoolValue() -> Bool {
    var values: Array<Bool> = [true, false];
    var view: Slice<Bool> = values.Slice(0, 2);
    view[1] = true;
    return view[1];
}
func Main() -> Void {
    Log(IntValue()); Log(LongValue()); Log(FloatValue());
    Log(DoubleValue()); Log(BoolValue());
}
