func Loop1(inout rows: Array<Int>, n: Int) -> Int {
    var total: Int = 0;
    var outer: Int = 0;
    while outer < n {
        ArrayPush(rows, outer);
        total = total + outer;
        outer = outer + 1;
    }
    return total;
}

func Main() -> Void {
    var rows: Array<Int> = [];
    Log(Loop1(rows, 2));
}
