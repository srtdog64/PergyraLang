func Loop2(inout rows: Array<Int>, n: Int) -> Int {
    let total: Int = 0;
    let outer: Int = 0;
    while outer < n {
        ArrayPush(rows, outer);
        for i in 0..2 {
            if i == 0 { continue; }
            total = total + i;
        }
        outer = outer + 1;
    }
    return total;
}

func Main() -> Void {
    let rows: Array<Int> = [];
    Log(Loop2(rows, 2));
}
