func CheckStringForward() -> Int {
    let labels: HashMap<String, Int> = MapNew();
    MapSet(labels, "zeta", 1);
    MapSet(labels, "alpha", 2);
    MapSet(labels, "mid", 3);
    let keys: Array<String> = MapKeys(labels);
    if ArrayLength(keys) == 3 && keys[0] == "alpha" && keys[1] == "mid" && keys[2] == "zeta" {
        return 101;
    }
    return -101;
}

func CheckStringReverse() -> Int {
    let labels: HashMap<String, Int> = MapNew();
    MapSet(labels, "mid", 3);
    MapSet(labels, "alpha", 2);
    MapSet(labels, "zeta", 1);
    let keys: Array<String> = MapKeys(labels);
    if ArrayLength(keys) == 3 && keys[0] == "alpha" && keys[1] == "mid" && keys[2] == "zeta" {
        return 102;
    }
    return -102;
}

func CheckIntForward() -> Int {
    let numbers: HashMap<Int, Int> = MapNew();
    MapSet(numbers, 9, 90);
    MapSet(numbers, 1, 10);
    MapSet(numbers, 4, 40);
    let keys: Array<Int> = MapKeys(numbers);
    if ArrayLength(keys) == 3 && keys[0] == 1 && keys[1] == 4 && keys[2] == 9 {
        return 201;
    }
    return -201;
}

func CheckIntReverse() -> Int {
    let numbers: HashMap<Int, Int> = MapNew();
    MapSet(numbers, 4, 40);
