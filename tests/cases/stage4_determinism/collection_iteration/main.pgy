func CheckBoolForward() -> Int {
    let flags: HashMap<Bool, Int> = MapNew();
    MapSet(flags, true, 1);
    MapSet(flags, false, 0);
    let keys: Array<Bool> = MapKeys(flags);
    if ArrayLength(keys) == 2 && keys[0] == false && keys[1] == true {
        return 401;
    }
    return -401;
}

func CheckBoolReverse() -> Int {
    let flags: HashMap<Bool, Int> = MapNew();
    MapSet(flags, false, 0);
    MapSet(flags, true, 1);
    let keys: Array<Bool> = MapKeys(flags);
    if ArrayLength(keys) == 2 && keys[0] == false && keys[1] == true {
        return 402;
    }
    return -402;
}

func CheckSetStringForward() -> Int {
    let labels: Set<String> = SetNew();
    SetAdd(labels, "zeta");
    SetAdd(labels, "alpha");
    SetAdd(labels, "mid");
    let values: Array<String> = SetValues(labels);
    if ArrayLength(values) == 3 && values[0] == "alpha" && values[1] == "mid" && values[2] == "zeta" {
        return 501;
    }
    return -501;
}

func CheckSetStringReverse() -> Int {
    let labels: Set<String> = SetNew();
    SetAdd(labels, "mid");
    SetAdd(labels, "alpha");
    SetAdd(labels, "zeta");
    let values: Array<String> = SetValues(labels);
    if ArrayLength(values) == 3 && values[0] == "alpha" && values[1] == "mid" && values[2] == "zeta" {
        return 502;
