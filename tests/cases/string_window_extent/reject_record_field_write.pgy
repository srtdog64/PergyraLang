// A mutable field of a proven pair is replaced after construction.
struct Measured {
    var text: String;
    let text_length: Int;
}

func Main() -> Void {
    let s: String = Concat("abc", "def");
    var m: Measured = Measured(s, StringLength(s));
    m.text = "";
    Print(ToString(CharCode(m.text, m.text_length, 5)));
}
