// A struct field keeps the String ListGet lends, and ListSet frees it before
// row.name is read. Before 2026-11-20 the read printed freed memory on
// native C and LLVM. The field stores a copy of the String. Admitted;
// prints 5 77 2.
struct Row {
    name: String
}
func Hold(seed: Int) -> Int {
    var items: List<String> = ListNew();
    ListPush(items, ToString(seed));
    ListPush(items, ToString(seed + 1));
    let row = Row { name: ListGet(items, 0) };
    ListSet(items, 0, ToString(99));
    let filler = ToString(77);
    Log(row.name);
    Log(filler);
    return ListSize(items);
}
func Main() -> Void { Log(Hold(5)); }
