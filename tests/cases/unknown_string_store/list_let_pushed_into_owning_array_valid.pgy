// `out` already owns its elements (ArrayPushOwnedString, then
// ArrayDropOwnedStrings), so the push of a ListGet loan stores an owned copy
// before and after 2026-11-20, and ListSet frees only the List's String.
// Admitted; prints 5 77 2.
func Gather(seed: Int) -> Int {
    var items: List<String> = ListNew();
    ListPush(items, ToString(seed));
    ListPush(items, ToString(seed + 1));
    var out: Array<String> = [];
    ArrayPushOwnedString(out, Concat("a", "b"));
    let name: String = ListGet(items, 0);
    ArrayPush(out, name);
    ListSet(items, 0, ToString(99));
    let filler = ToString(77);
    Log(out[1]);
    Log(filler);
    ArrayDropOwnedStrings(out);
    return ListSize(items);
}
func Main() -> Void { Log(Gather(5)); }
