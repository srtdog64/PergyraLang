// MakeRow keeps its String in the Row it returns, and it is given view[0],
// which is names[0]; the owned ArraySet frees that String before row.name
// is read. Before 2026-11-20 the read printed freed memory on native C and
// LLVM. MakeRow's result depends on the String, so the argument is copied.
// Admitted; prints 5 77 2.
struct Row {
    name: String
}
func MakeRow(name: String) -> Row { return Row { name: name }; }
func Hold(seed: Int) -> Int {
    var names: Array<String> = [];
    ArrayPush(names, ToString(seed));
    ArrayPush(names, ToString(seed + 1));
    let view: Slice<String> = names[0..2];
    let row = MakeRow(view[0]);
    ArraySet(names, 0, ToString(99));
    let filler = ToString(77);
    Log(row.name);
    Log(filler);
    return ArrayLength(names);
}
func Main() -> Void { Log(Hold(5)); }
