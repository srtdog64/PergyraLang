// The Slice element pushed directly: `out` keeps view[0], which is names[0],
// and the owned ArraySet frees it before out[0] is read. Before 2026-11-20
// the read printed freed memory on native C and LLVM. The String is copied
// where it is pushed. Admitted; prints 5 77 1.
func Gather(seed: Int) -> Int {
    var names: Array<String> = [];
    ArrayPush(names, ToString(seed));
    ArrayPush(names, ToString(seed + 1));
    let view: Slice<String> = names[0..2];
    var out: Array<String> = [];
    ArrayPush(out, view[0]);
    ArraySet(names, 0, ToString(99));
    let filler = ToString(77);
    Log(out[0]);
    Log(filler);
    return ArrayLength(out);
}
func Main() -> Void { Log(Gather(5)); }
