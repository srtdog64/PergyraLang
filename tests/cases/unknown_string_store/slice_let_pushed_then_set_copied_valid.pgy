// `name` lends names[0] through a Slice view, so its source is unknown.
// `out` keeps it, and the owned ArraySet frees it before out[0] is read.
// Before 2026-11-20 the store was let through because `names` was excluded
// as an owner while it was empty and the exclusion was dropped once its
// stores became owned; the read printed freed memory on native C and LLVM.
// The String is copied where it is pushed. Admitted; prints 5 77 1.
func Gather(seed: Int) -> Int {
    var names: Array<String> = [];
    ArrayPush(names, ToString(seed));
    ArrayPush(names, ToString(seed + 1));
    let view: Slice<String> = names[0..2];
    var out: Array<String> = [];
    let name = view[0];
    ArrayPush(out, name);
    ArraySet(names, 0, ToString(99));
    let filler = ToString(77);
    Log(out[0]);
    Log(filler);
    return ArrayLength(out);
}
func Main() -> Void { Log(Gather(5)); }
