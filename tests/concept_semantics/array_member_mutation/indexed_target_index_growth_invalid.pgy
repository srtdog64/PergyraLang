struct Cell { value: Int; }

func Index(inout cells: Array<Cell>) -> Int {
    var i: Int = 0;
    while (i < 128) {
        ArrayPush(cells, Cell(2));
        i = i + 1;
    }
    return 0;
}

func Main() -> Void {
    var cells: Array<Cell> = [Cell(1)];
    cells[Index(cells)].value = 7;
    Log(ToString(cells[0].value));
}
