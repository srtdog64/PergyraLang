import "callable_capability_fixture.pgy";

func ClockBump(value: Int) -> Int with caps clock {
    let observed: Int = Now();
    return value + 1;
}
func Forward(operation: func(Int) -> Int, value: Int) -> Int {
    return Invoke(operation, value);
}
func Main() -> Void with caps random { Log(Forward(ClockBump, 41)); }
