import "callable_capability_fixture.pgy";

func ClockBump(value: Int) -> Int with caps clock {
    let observed: Int = Now();
    return value + 1;
}
func Dispatch(dispatcher: func(func(Int) -> Int, Int) -> Int,
              operation: func(Int) -> Int, value: Int) -> Int {
    return dispatcher(operation, value);
}
func Main() -> Void with caps random { Log(Dispatch(Invoke, ClockBump, 41)); }
