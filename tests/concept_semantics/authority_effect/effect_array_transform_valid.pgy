func Main() -> Void with effects local {
    var values: Array<Int> = [3, 1, 2, 2];
    let sorted: Array<Int> = ArraySort(values);
    Log(values[0]);
    Log(sorted[3]);
    let reversed: Array<Int> = ArrayReverse(values);
    Log(reversed[0]);
    Log(values[3]);
    ArrayReverse(values);
    Log(sorted[0]);
    var empty: Array<Int> = [];
    ArraySort(empty);
    ArrayReverse(empty);
    Log(ArrayLength(empty));
    var singleton: Array<Int> = [9];
    ArrayReverse(singleton);
    ArraySort(singleton);
    Log(singleton[0]);
    var words: Array<String> = ["a", "bb", "ccc", "dddd"];
    ArrayReverse(words);
    Log(StringLength(words[0])); Log(StringLength(words[1]));
    Log(StringLength(words[2])); Log(StringLength(words[3]));
    ArrayReverse(words);
    Log(StringLength(words[0]));
    var odd_words: Array<String> = ["a", "bb", "ccc"];
    ArrayReverse(odd_words);
    Log(StringLength(odd_words[0])); Log(StringLength(odd_words[1])); Log(StringLength(odd_words[2]));
    var no_words: Array<String> = [];
    ArrayReverse(no_words); Log(ArrayLength(no_words));
    var one_word: Array<String> = ["single"];
    ArrayReverse(one_word); Log(StringLength(one_word[0]));
    var flags: Array<Bool> = [true, false, false, false];
    ArrayReverse(flags);
    Log(flags[0]); Log(flags[1]); Log(flags[2]); Log(flags[3]);
    var odd_flags: Array<Bool> = [true, false, false];
    ArrayReverse(odd_flags); Log(odd_flags[0]); Log(odd_flags[1]); Log(odd_flags[2]);
    var no_flags: Array<Bool> = [];
    ArrayReverse(no_flags); Log(ArrayLength(no_flags));
    var one_flag: Array<Bool> = [true];
    ArrayReverse(one_flag); Log(one_flag[0]);
    var owned: Array<String> = [];
    ArrayPushOwnedString(owned, "aa");
    ArrayPushOwnedString(owned, "bbb");
    ArrayPushOwnedString(owned, "cccc");
    ArrayReverse(owned);
    Log(StringLength(owned[0])); Log(StringLength(owned[1])); Log(StringLength(owned[2]));
    Log(ArrayLength(owned)); ArrayDropOwnedStrings(owned);
}
