func Stamp(value: Long) -> Long with caps clock { return value + Now(); }
func Pure(value: Long) -> Long { return value + 1L; }
func Invoke(operation: func(Long) -> Long) -> Long { return operation(1); }
func ClockPath() -> Long with effects nondeterministic { return Invoke(Stamp); }
func PurePath() -> Long with effects local { return Invoke(Pure); }
func Main() -> Void { Log(ClockPath()); Log(PurePath()); }
