subject Counter {
    var value: Int;
    var active: Bool;
    var label: String;
    action Bump(self, amount: Int) -> Void authorized by self {
        self.value = self.value + amount;
        self.value = self.value + 1;
        self.active = !self.active;
        self.label = "changed";
    }
}
subject Other {
    var value: Int;
    action Bump(self, amount: Int) -> Void authorized by self {
        self.value = self.value + amount;
    }
}
func Main() -> Void {
    let c: Counter = Counter(1, false, "initial");
    let d: Other = Other(10);
    c.Bump(2);
    d.Bump(5);
    Log(ToString(c.value));
    Log(ToString(c.active));
    Log(c.label);
    Log(ToString(d.value));
}
