subject Fighter {
    let power: Int;
}

ability Combatable {
    func Score(self) -> Int;
}

role Warrior for Fighter {
    impl ability Combatable {
        func Score(self) -> Int { return 10; }
    }
}

role Berserker for Fighter {
    impl ability Combatable {
        func Score(self) -> Int { return 77; }
    }
}

party Team {
    dyn role slot fighter: Combatable
}

func Main() -> Void {
    let team = Team();
    let hero = Fighter(1);
    bind team.fighter = hero as Warrior;
    Log(team.fighter.Score());
    bind team.fighter = hero as Berserker;
    Log(team.fighter.Score());
}
