// Ordinary literal/push descriptor storage is not the copy operation here.
func Main() -> Void
{
    let intRow: Array<Int> = [7, 8];
    let ints: Array<Array<Int>> = [intRow];
    var intAlias: Array<Int> = ints[0];
    let copiedInts: Array<Array<Int>> = Clone(ints);
    ArraySet(intAlias, 0, 99);
    Log(intAlias[0]);
    Log(copiedInts[0][0]);
    Log(copiedInts[0][1]);
    let stringRow: Array<String> = ["alpha", "beta"];
    let strings: Array<Array<String>> = [stringRow];
    var stringAlias: Array<String> = strings[0];
    let copiedStrings: Array<Array<String>> = Clone(strings);
    ArraySet(stringAlias, 0, "changed");
    Log(stringAlias[0]);
    Log(copiedStrings[0][0]);
    Log(copiedStrings[0][1]);
    let emptyInts: Array<Array<Int>> = [];
    let emptyStrings: Array<Array<String>> = [];
    Log(ArrayLength(Clone(emptyInts)));
    Log(ArrayLength(Clone(emptyStrings)));
}
