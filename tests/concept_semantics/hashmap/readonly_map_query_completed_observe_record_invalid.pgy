struct TextRecord { text: String; }
func Observe(ref text: String) -> String { return text; }
func ReadRecord(ref record: TextRecord) -> TextRecord {
    let observed = Observe(record.text);
    return TextRecord(observed);
}
func Main() -> Void {
    let record: TextRecord = TextRecord(Concat("heap", " text"));
    let saved = ReadRecord(record);
    Log(saved.text);
}
