// ReadRecord returns a loan of record.text.
// Since 2026-10-19 the result lends the record (results_lend_ref_inputs), and a
// loan whose owner changes while it is held is copied where it is made
// (2026-10-22). Native admits this only with that compiler-placed Clone; the
// readonly-map smoke requires the Clone in MIR and the output on C and LLVM.
struct TextRecord { text: String; }
func Observe(ref text: String) -> String { return text; }
func ReadRecord(ref record: TextRecord) -> String {
    let observed = Observe(record.text);
    return observed;
}
func Main() -> Void {
    var record: TextRecord = TextRecord(Concat("heap", " text"));
    let observed: String = ReadRecord(record);
    record.text = Concat("other", " text");
    Log(observed);
}
