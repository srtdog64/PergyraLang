func ReadValue(ref values: HashMap<String, Int>, key: String) -> Int {
    if !MapHas(values, key) { return 0; }
    return MapGet(values, key);
}
func Main() -> Void {
    let values: HashMap<String, Int> = MapNew();
    MapSet(values, "entry", 7);
    Log(ReadValue(values, "entry"));
    Log(ReadValue(values, "absent"));
    MapSet(values, "entry", 9);
    Log(ReadValue(values, "entry"));
}
