func Early(ref values: HashMap<String, Int>) -> Int { return Late(values); }
func Main() -> Void {
    let values: HashMap<String, Int> = MapNew();
    MapSet(values, "key", 1);
    Log(Early(values));
}
func Late(ref values: HashMap<String, Int>) -> Int {
    let retained: HashMap<String, Int> = values;
    return MapGet(retained, "key");
}
