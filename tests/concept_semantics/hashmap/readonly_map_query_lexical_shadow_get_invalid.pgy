func Retain(values: HashMap<String, Int>, key: String) -> Int { return MapSize(values); }
func Query(ref values: HashMap<String, Int>, MapGet: func(HashMap<String, Int>, String) -> Int) -> Int {
    return MapGet(values, "key");
}
func Main() -> Void {
    let values: HashMap<String, Int> = MapNew();
    Log(Query(values, Retain));
}
