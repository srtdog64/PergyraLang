func Retain(values: HashMap<String, Int>) -> Array<String> { return MapKeys(values); }
func Query(ref values: HashMap<String, Int>, MapKeys: func(HashMap<String, Int>) -> Array<String>) -> Array<String> {
    return MapKeys(values);
}
func Main() -> Void {
    let values: HashMap<String, Int> = MapNew();
    let keys: Array<String> = Query(values, Retain);
    Log(ArrayLength(keys));
}
