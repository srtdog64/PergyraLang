struct NestedIntInventory { entries: HashMap<Int, Int>; }
struct NestedIntQueries { inventory: NestedIntInventory; }
func ReadNestedMapValue(ref record: NestedIntQueries) -> Int {
    return MapGet(record.inventory.entries, 4);
}
func SnapshotNestedMapKeys(ref record: NestedIntQueries) -> Array<Int> {
    return MapKeys(record.inventory.entries);
}
func Main() -> Void {
    let values: HashMap<Int, Int> = MapNew();
    let record: NestedIntQueries = NestedIntQueries(NestedIntInventory(values));
    MapSet(record.inventory.entries, 4, 11);
    let value = MapGet(record.inventory.entries, 4);
    Log(value);
    Log(ReadNestedMapValue(record));
    let keys = MapKeys(record.inventory.entries);
    Log(ArrayLength(keys));
    Log(keys[0]);
    let snapshot = SnapshotNestedMapKeys(record);
    Log(ArrayLength(snapshot));
    MapRemove(record.inventory.entries, 4);
    Log(MapHas(record.inventory.entries, 4));
    Log(MapSize(record.inventory.entries));
}
