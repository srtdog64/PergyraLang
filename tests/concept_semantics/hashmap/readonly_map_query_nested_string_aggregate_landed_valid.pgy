// A record built around a nested MapGet loan lends the nested map.
// Since 2026-10-19 the result lends the nested map (results_lend_ref_inputs), and a
// loan whose owner changes while it is held is copied where it is made
// (2026-10-22). Native admits this only with that compiler-placed Clone; the
// readonly-map smoke requires the Clone in MIR and the output on C and LLVM.
struct NestedCapturedMap { entries: HashMap<String, String>; }
struct NestedCapturedQueries { inventory: NestedCapturedMap; }
struct NestedCapturedText { value: String; }
func CaptureNestedMapText(ref record: NestedCapturedQueries) -> NestedCapturedText {
    return NestedCapturedText(MapGet(record.inventory.entries, "entry"));
}
func Main() -> Void {
    var entries: HashMap<String, String> = MapNew();
    MapSet(entries, "entry", "a");
    var record: NestedCapturedQueries = NestedCapturedQueries(NestedCapturedMap(entries));
    let captured: NestedCapturedText = CaptureNestedMapText(record);
    MapSet(record.inventory.entries, "entry", "b");
    Log(captured.value);
}
