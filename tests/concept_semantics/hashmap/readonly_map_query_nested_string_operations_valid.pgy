struct NestedStringQueries { entries: HashMap<String, Int>; }
func Main() -> Void {
    let values: HashMap<String, Int> = MapNew();
    let record: NestedStringQueries = NestedStringQueries(values);
    MapSet(record.entries, "entry", 7);
    let value = MapGet(record.entries, "entry");
    Log(value);
    Log(MapHas(record.entries, "entry"));
    Log(MapSize(record.entries));
    let keys = MapKeys(record.entries);
    Log(ArrayLength(keys));
    ArrayDropOwnedStrings(keys);
    MapRemove(record.entries, "entry");
    Log(MapHas(record.entries, "entry"));
    Log(MapSize(record.entries));
}
