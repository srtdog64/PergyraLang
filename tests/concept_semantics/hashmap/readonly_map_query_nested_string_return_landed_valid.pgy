// MapGet<String> stays a loan through a resolved member receiver.
// Since 2026-10-19 the result lends the nested map (results_lend_ref_inputs), and a
// loan whose owner changes while it is held is copied where it is made
// (2026-10-22). Native admits this only with that compiler-placed Clone; the
// readonly-map smoke requires the Clone in MIR and the output on C and LLVM.
struct NestedBorrowedMap { entries: HashMap<String, String>; }
struct NestedBorrowedQueries { inventory: NestedBorrowedMap; }
func ReadNestedMapText(ref record: NestedBorrowedQueries) -> String {
    return MapGet(record.inventory.entries, "entry");
}
func Main() -> Void {
    var entries: HashMap<String, String> = MapNew();
    MapSet(entries, "entry", "a");
    var record: NestedBorrowedQueries = NestedBorrowedQueries(NestedBorrowedMap(entries));
    let held: String = ReadNestedMapText(record);
    MapSet(record.inventory.entries, "entry", "b");
    Log(held);
}
