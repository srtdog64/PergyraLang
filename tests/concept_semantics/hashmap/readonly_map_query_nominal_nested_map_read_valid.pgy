struct TextPayload { text: String; count: Int; }
func Probe(ref values: HashMap<String, String>) -> Bool {
    let payload = TextPayload(MapGet(values, "key"), 3);
    return StringLength(payload.text) > 0;
}
func Main() -> Void {
    let values: HashMap<String, String> = MapNew();
    MapSet(values, "key", Concat("heap", " text"));
    Log(Probe(values));
}
