// This retaining store used to be refused. Since the 2026-10-19/20 landing
// rules the store takes a compiler-placed copy (a Clone in MIR), which the
// readonly-map smoke requires with the output on C and LLVM.
struct TextRecord { text: String; }
struct TextPayload { text: String; count: Int; }
func Extract(ref record: TextRecord) -> Option<String> {
    let payload = TextPayload(record.text, 3);
    return Some(payload.text);
}
func Main() -> Void {
    let record = TextRecord(Concat("heap", " text"));
    Log(UnwrapOption(Extract(record)));
}
