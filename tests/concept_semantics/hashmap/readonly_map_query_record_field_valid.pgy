struct QueryRecord { entries: HashMap<String, Int>; }
func ReadRecord(ref record: QueryRecord) -> Int { return ReadRows(record.entries); }
func ReadRows(ref rows: HashMap<String, Int>) -> Int { return MapGet(rows, "entry"); }
func Main() -> Void {
    let values: HashMap<String, Int> = MapNew();
    MapSet(values, "entry", 23);
    let record: QueryRecord = QueryRecord(values);
    Log(ReadRecord(record));
}
