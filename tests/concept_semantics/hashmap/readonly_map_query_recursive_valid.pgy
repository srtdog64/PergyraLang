// Both directions of a finite recursive component borrow the same receiver.
func First(ref values: HashMap<String, Int>, depth: Int) -> Int {
    if depth <= 0 { return MapGet(values, "entry"); }
    return Second(values, depth - 1);
}
func Second(ref values: HashMap<String, Int>, depth: Int) -> Int {
    if depth <= 0 { return MapGet(values, "entry"); }
    return First(values, depth - 1);
}
func Main() -> Void {
    let values: HashMap<String, Int> = MapNew();
    MapSet(values, "entry", 19);
    Log(First(values, 4));
    Log(Second(values, 3));
}
