// This retaining store used to be refused. Since the 2026-10-19/20 landing
// rules the store takes a compiler-placed copy (a Clone in MIR), which the
// readonly-map smoke requires; the extern Keep has no body to link, so it is not run.
struct TextRecord { text: String; }
extern "C" { func Keep(text: String) -> Void; }
func Observe(ref text: String) -> String { return text; }
func ReadRecord(ref record: TextRecord) -> Bool {
    let observed = Observe(record.text);
    Keep(observed);
    return true;
}
func Publish() -> Bool {
    let record = TextRecord(Concat("heap", " text"));
    return ReadRecord(record);
}
func Main() -> Void { Log(Publish()); }
