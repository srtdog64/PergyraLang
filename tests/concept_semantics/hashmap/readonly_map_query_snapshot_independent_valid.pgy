func ReadValue(ref values: HashMap<String, Int>) -> Int { return MapGet(values, "replacement"); }
func Main() -> Void {
    let values: HashMap<String, Int> = MapNew();
    MapSet(values, "stable", 37);
    let keys: Array<String> = MapKeys(values);
    MapRemove(values, "stable");
    MapSet(values, "replacement", 41);
    Log(keys[0]);
    ArrayDropOwnedStrings(keys);
    Log(ReadValue(values));
}
