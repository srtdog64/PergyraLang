struct TextRecord { text: String; }
func Extract(ref record: TextRecord, inout output: String) -> Bool {
    let observed = Some(record.text);
    output = UnwrapOption(observed);
    return true;
}
func Publish(ref output: Slot<String>) -> Bool {
    let record = TextRecord(Concat("heap", " text"));
    var staged: String = "literal";
    let accepted = Extract(record, staged);
    Write(output, staged);
    return accepted;
}
func Main() -> Void {
    let output: Slot<String> = ClaimSlot();
    Log(Publish(output));
    Release(output);
}
