func ReadMaybe(ref values: HashMap<String, String>) -> Bool {
    let observed = Some(MapGet(values, "key"));
    return StringLength(UnwrapOption(observed)) > 0;
}
func Main() -> Void {
    var values: HashMap<String, String> = MapNew();
    MapSet(values, "key", Concat("heap", " text"));
    Log(ReadMaybe(values));
}
