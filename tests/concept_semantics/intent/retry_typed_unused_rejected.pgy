import "terminal_fixture.pgy";

intent Deliver(work: AuditZone, worker: AuditWorker, succeed: Bool)
    -> AuditPurposeOutcome with retry(1) {
    step Read {
        where: AuditZone;
        using: work;
        on outcome: worker.Read(succeed);
        success: AuditAccepted(receipt);
        failure: AuditDeclined(problem);
    }
    success Read: AuditDelivered(receipt);
    failure Read: AuditRejected(problem);
}

func Main() -> Void {}
