subject HeaderWorker {
    let mut calls: Int;
    action Run(self) -> Void { self.calls = self.calls + 1; }
}
zone HeaderZone { subject slot worker: HeaderWorker }

func CompletionObserved(calls: Int) -> Bool {
    Log("completion");
    Log(calls);
    return calls == 2;
}

intent Complete(work: HeaderZone, worker: HeaderWorker) {
    step First {
        where: HeaderZone;
        using: work;
        who: worker;
        on: worker.Run();
        expect: true;
    }
    step Second {
        where: HeaderZone;
        using: work;
        who: worker;
        on: worker.Run();
        expect: true;
    }
    success: CompletionObserved(worker.calls);
}

func Main() -> Void {
    let work = HeaderZone(HeaderWorker(0));
    let worker = HeaderWorker(0);
    let completed = Complete(work, worker);
    Log(completed);
    Log(worker.calls);
    Log(work.worker.calls);
}
