enum Shape { Dot, Line(Int), Rect(Int, Int) }
func Area(s: Shape) -> Int {
    match s {
        case Dot:
            match s {
                case Dot: return 0;
                case Line(n): return n;
                case Rect(w, h): return w * h;
            }
        case Line(n): return n;
        case Rect(w, h): return w * h;
    }
}
func Main() -> Void { Log(Area(Rect(2, 3))); }
