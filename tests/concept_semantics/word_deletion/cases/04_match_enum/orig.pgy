enum Shape { Dot, Line(Int), Rect(Int, Int) }
func Area(s: Shape) -> Int {
    match s {
        case Dot: return 0;
        case Line(n): return n;
        case Rect(w, h): return w * h;
    }
}
func Main() -> Void {
    Log(ToString(Area(Dot)));
    Log(ToString(Area(Line(4))));
    Log(ToString(Area(Rect(2, 3))));
}
