subject Fighter { let power: Int; }
ability Combatable { func Attack(self) -> Int; }
role Warrior for Fighter { impl Combatable { func Attack(self) -> Int { return 10; } } }
role Archer for Fighter { impl Combatable { func Attack(self) -> Int { return 20; } } }
party Team { dyn role slot fighter: Combatable; shared hp: Int; }
func Main() -> Void {
    let team: Team = Team();
    let hero: Fighter = Fighter(1);
    bind team.fighter = hero as Warrior;
    Log(ToString(team.fighter.Attack()));
    bind team.fighter = hero as Archer;
    Log(ToString(team.fighter.Attack()));
}
