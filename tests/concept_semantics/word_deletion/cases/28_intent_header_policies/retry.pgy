subject W { let mut n: Int; action Go(self) -> Void { n = n + 1; } }
zone Z { subject slot w: W }
intent Run(z: Z, w: W) with retry(3) {
    step S { where: Z; using: z; who: w; on: w.Go(); expect: z.w.n == 2; }
    success: true;
    failure: false;
}
func Main() -> Void {
    let z = Z(W(0));
    let w = W(0);
    Log(ToString(Run(z, w)) + " " + ToString(z.w.n));
}
