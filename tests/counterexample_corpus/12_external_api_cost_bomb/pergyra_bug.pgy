// Bug: the agent retries a paid model call until it succeeds; every attempt is billed.
// Pergyra: accepted and runs. There is no network or cost budget, and the `retry` word has no
// execution support (docs/199 line 75); only the host wall-clock watchdog is a backstop.
subject PaidModelApi {
    var calls: Int;
    var spentCents: Int;
    var reported: Bool;

    // Local stand-in for the paid API (no network): 3 cents per call, overloaded (529)
    // for the first 400 calls.
    action Complete(self) -> Int {
        calls = calls + 1;
        spentCents = spentCents + 3;
        if spentCents > 10 && !reported {   // 10 cents is the request's cost budget
            Log("BUG_MANIFESTED 12");
            reported = true;
        }
        if calls >= 400 {
            return 200;
        }
        return 529;
    }
}

func Main() -> Void {
    let api: PaidModelApi = PaidModelApi(0, 0, false);
    let status: Int = 0;
    // Retry until success.
    while status != 200 {
        status = api.Complete();
    }
}
