// Bug: the purchase intent claims `rollback: full`, but its debit step has no undo.
// Pergyra: INT-2 compensation coverage refuses the intent at compile time with
// PGY_SEM_INTENT_STEP_INVALID; `irreversible: "why";` is the explicit opt-out.
subject Wallet {
    let tenant: String;
    let mut gold: Int;
    action Debit(self, amount: Int) -> Void { self.gold = self.gold - amount; }
    action Refund(self, amount: Int) -> Void { self.gold = self.gold + amount; }
    action Notify(self) -> Void { Log("notify " + self.tenant + ": order placed"); }
}

subject Warehouse {
    let mut stock: Int;
    let mut shipped: Int;
    action Ship(self) -> Void { self.stock = self.stock - 1; self.shipped = self.shipped + 1; }
}

zone Billing { subject slot wallet: Wallet }
zone Shipping { subject slot warehouse: Warehouse }

intent PurchaseTool(billing: Billing, shipping: Shipping,
                    wallet: Wallet, warehouse: Warehouse, price: Int) {
    rollback: full;

    step debit {
        where: Billing;
        using: billing;
        who: wallet;
        on: wallet.Debit(price);
    }

    step notify {
        where: Billing;
        using: billing;
        who: wallet;
        on: wallet.Notify();
        irreversible: "a sent notification cannot be recalled";
    }

    step ship {
        where: Shipping;
        using: shipping;
        who: warehouse;
        pre: warehouse.stock > 0;
        on: warehouse.Ship();
    }

    success: true;
}

func Main() -> Void {
    let billing = Billing();
    let shipping = Shipping();
    let wallet = Wallet("acme", 100);
    let warehouse = Warehouse(0, 0);
    let ok = PurchaseTool(billing, shipping, wallet, warehouse, 40);
    Log("purchase ok=" + ToString(ok) + " gold=" + ToString(wallet.gold)
        + " shipped=" + ToString(warehouse.shipped));
}
