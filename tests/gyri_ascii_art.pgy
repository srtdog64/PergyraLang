// Pergyra 언어 브랜드 아스키 아트
// use: pgy tests/gyri_ascii_art.pgy --run

func PrintLogo() -> Void {
    Log("   ____  ____  ____  ____  ____  ____  ____  ____ ");
    Log("  |P  ||e  ||r  ||g  ||y  ||r  ||a  ||   ||L  ||a  ||n  ||g  |");
    Log("  |___||___||___||___||___||___||___||   ||___||___||___||___|");
    Log("  \\__/\\__/\\__/\\__/\\__/\\__/\\__/     \\__/\\__/\\__/\\__/");
}

func PrintArt() -> Void {
    Log("");
    Log("  @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@");
    Log("  @@@@@@@@@@@@@@@@@@  GI  @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@");
    Log("  @@@@@@@@@@@@@@  @@@@@@@@@@  @@@@@@@@@@@@@@@@@@@@@@@@@@@@");
    Log("  @@@@@@@@@@@@  @@@@@@@@@@@@@@  @@@@@@@@@@@@@@@@@@@@@@@@");
    Log("  @@@@@@@@@@  @@@@@@@@@@@@@@@@@@  @@@@@@@@@@@@@@@@@@@@");
    Log("  @@@@@@@@  @@@@@@@@@@@@@@@@@@@@@@  @@@@@@@@@@@@@@@@");
    Log("  @@@@@@  @@@@@@@@@@@@@@@@@@@@@@@@@@  @@@@@@@@@@@@");
    Log("  @@@@  @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@  @@@@@@@@");
    Log("  @@  @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@  @@@@");
    Log("  @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@");
    Log("  @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@");
}

func Main() -> Void {
    PrintLogo();
    PrintArt();
    Log("");
    Log("  Intent-First Programming Language");
    Log("  subject/class/object/dto | Slot<T> | Zone/World");
}
