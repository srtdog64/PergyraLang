func PrintFeatures() -> Void {
    Log("");
    Log("[Pergyra] Intent-driven programming language");
    Log("[Pergyra] subject/class/object/tobject type system");
    Log("[Pergyra] Slot-based resource management");
    Log("[Pergyra] Zone/World domain boundaries");
    Log("[Pergyra] Async/await + channels");
    Log("[Pergyra] Result<T> error handling with ? operator");
}

func Main() -> Void {
    PrintBanner();
    PrintFeatures();
}
