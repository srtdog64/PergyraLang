func PrintBanner() -> Void {
    Log("╔══════════════════════════════════════════════════════╗");
    Log("║                                                      ║");
    Log("║   ____  ____  ____  ____  ____  ____  ____  ____     ║");
    Log("║  |P  ||e  ||r  ||g  ||y  ||r  ||a  ||   ||L  ||a  ||n  ||g  |");
    Log("║  |___||___||___||___||___||___||___||   ||___||___||___||___|");
    Log("║  \\__/\\__/\\__/\\__/\\__/\\__/\\__/     \\__/\\__/\\__/\\__/");
