// Every cell of the call hand-off rule as the self-host front end reads it
// (src/self_hosted/semantic/call_handoff_rule_projection_owner.pgy, rendered
// from src/semantic/call_handoff_rule.def). call_handoff_rule_smoke.sh
// compares this dump with the native rendering's (call_handoff_rule_probe.c).
import "../../src/self_hosted/semantic/call_handoff_rule_projection_owner.pgy";

func CallHandoffProbeCell(divergences: Int, kind: Int, origin: Int, later: Int,
    site_context: Int, elements: Int) -> String {
    let answer: Int = SemanticCallHandoffActionForKind(kind, origin, later, site_context,
        elements, divergences);
    var line: String = Concat("cell ", ToString(divergences));
    line = Concat(line, Concat(" ", ToString(kind)));
    line = Concat(line, Concat(" ", ToString(origin)));
    line = Concat(line, Concat(" ", ToString(later)));
    line = Concat(line, Concat(" ", ToString(site_context)));
    line = Concat(line, Concat(" ", ToString(elements)));
    return Concat(line, Concat(" ", ToString(answer)));
}

func Main() -> Void {
    var flag: Int = -1;
    while flag < SemanticCallHandoffDivergenceFlagCount() {
        var divergences: Int = 0;
        if flag >= 0 {
            divergences = 1;
            var shift: Int = 0;
            while shift < flag { divergences = divergences * 2; shift = shift + 1; }
        }
        var kind: Int = 0;
        while kind <= SemanticCallHandoffKindMoving() {
            var origin: Int = 0;
            while origin <= SemanticCallHandoffOriginBorrowed() {
                var later: Int = 0;
                while later <= SemanticCallHandoffLaterUsedAgain() {
                    var site_context: Int = 0;
                    while site_context <= SemanticCallHandoffContextDetached() {
                        var elements: Int = 0;
                        while elements <= SemanticCallHandoffElementsOwnedRequired() {
                            Log(CallHandoffProbeCell(divergences, kind, origin, later,
                                site_context, elements));
                            elements = elements + 1;
                        }
                        site_context = site_context + 1;
                    }
                    later = later + 1;
                }
                origin = origin + 1;
            }
            kind = kind + 1;
        }
        flag = flag + 1;
    }
    var members: Int = 0;
    while members < 64 {
        Log(Concat(Concat("kind ", ToString(members)),
            Concat(" ", ToString(SemanticCallHandoffKind(members)))));
        members = members + 1;
    }
    // The MIR JSON spellings the self-host writer and reader use (slice S2).
    CallHandoffProbeNames("member", SemanticCallHandoffMemberCount());
    CallHandoffProbeNames("origin", SemanticCallHandoffOriginCount());
    CallHandoffProbeNames("later", SemanticCallHandoffLaterCount());
    CallHandoffProbeNames("context", SemanticCallHandoffContextCount());
    CallHandoffProbeNames("elements", SemanticCallHandoffElementsCount());
    CallHandoffProbeNames("action", SemanticCallHandoffActionCount());
    CallHandoffProbeNames("divergence", SemanticCallHandoffDivergenceCount());
    if !SemanticCallHandoffStringResultFresh("Concat", 2, "String") ||
        !SemanticCallHandoffStringResultFresh("ToString", 1, "Int") ||
        SemanticCallHandoffStringResultFresh("ToString", 1, "String") ||
        SemanticCallHandoffStringResultFresh("Clone", 1, "Array<String>") {
        Exit(1);
    }
    let producers: Array<String> = ["Concat", "Substring", "ToString", "Clone", "UserConcat"];
    let types: Array<String> = ["String", "Int", "Long", "Bool", "Unknown"];
    var producer: Int = 0;
    while producer < ArrayLength(producers) {
        var arity: Int = 1;
        while arity <= 4 {
            var type_row: Int = 0;
            while type_row < ArrayLength(types) {
                var fresh: Int = 0;
                if SemanticCallHandoffStringResultFresh(producers[producer], arity, types[type_row]) {
                    fresh = 1;
                }
                Log("result " + ToString(producer) + " " + ToString(arity) +
                    " " + ToString(type_row) + " " + ToString(fresh));
                type_row = type_row + 1;
            }
            arity = arity + 1;
        }
        producer = producer + 1;
    }
}

func CallHandoffProbeName(vocabulary: String, index: Int) -> String {
    if vocabulary == "member" { return SemanticCallHandoffMemberName(index); }
    if vocabulary == "origin" { return SemanticCallHandoffOriginName(index); }
    if vocabulary == "later" { return SemanticCallHandoffLaterName(index); }
    if vocabulary == "context" { return SemanticCallHandoffContextName(index); }
    if vocabulary == "elements" { return SemanticCallHandoffElementsName(index); }
    if vocabulary == "action" { return SemanticCallHandoffActionName(index); }
    return SemanticCallHandoffDivergenceName(index);
}

func CallHandoffProbeNames(vocabulary: String, count: Int) -> Void {
    var index: Int = 0;
    while index < count {
        Log(Concat(Concat(Concat("name ", vocabulary), Concat(" ", ToString(index))),
            Concat(" ", CallHandoffProbeName(vocabulary, index))));
        index = index + 1;
    }
}
