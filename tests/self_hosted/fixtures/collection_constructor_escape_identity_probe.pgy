// Mutate one freshly admitted graph/fact frame. No supplied program is emitted.
import "../../../src/self_hosted/parser/program_parse_owner.pgy";
import "../../../src/self_hosted/semantic/ast_body_type_bundle_owner.pgy";

// Synthetic fixed-point frames falsify graph shape, cycle and transactional
// effect claims without granting a source-program ownership receipt.
func InspectFormalEffectFixedPointFrame(mutation: Int) -> Bool {
    let row_by_formal: HashMap<String, Int> = MapNew();
    MapSet(row_by_formal, "101", 0);
    MapSet(row_by_formal, "102", 1);
    MapSet(row_by_formal, "103", 2);
    let inventory: SemanticAstCollectionFormalEffectInventory =
        SemanticAstCollectionFormalEffectInventory(
            true, [101, 102, 103], [11, 12, 13], [0, 0, 0],
            [0, 0, 0], [true, true, true], row_by_formal);
    let blocked: Array<Bool> = [false, false, false];
    let mutations: Array<Bool> = [false, false, false];
    let shallow: Array<Bool> = [false, false, false];
    let reads: Array<Bool> = [false, false, false];
    let sources: Array<Int> = [];
    let targets: Array<Int> = [];
    let effects: HashMap<String, Int> = MapNew();
    if mutation == 19 {
        ArrayPush(sources, 0);
        let status: SemanticAstCollectionFormalEffectResolutionStatus =
            SemanticAstCollectionFormalEffectResolutionStatus(true);
        SemanticAstCollectionFormalEffectFixedPoint(
            inventory, blocked, mutations, shallow, reads,
            sources, targets, effects, status);
        return !status.ok;
    }
    if mutation == 20 || mutation == 21 {
        let source: Int = 0;
        let target: Int = 0;
        if mutation == 20 { source = -1; }
        if mutation == 21 { target = 3; }
        ArrayPush(sources, source);
        ArrayPush(targets, target);
        let status: SemanticAstCollectionFormalEffectResolutionStatus =
            SemanticAstCollectionFormalEffectResolutionStatus(true);
        SemanticAstCollectionFormalEffectFixedPoint(
            inventory, blocked, mutations, shallow, reads,
            sources, targets, effects, status);
        return !status.ok;
    }
    if mutation == 22 || mutation == 23 {
        ArrayPush(sources, 0); ArrayPush(targets, 0);
        if mutation == 23 { reads[0] = true; }
        let status: SemanticAstCollectionFormalEffectResolutionStatus =
            SemanticAstCollectionFormalEffectResolutionStatus(true);
        SemanticAstCollectionFormalEffectFixedPoint(
            inventory, blocked, mutations, shallow, reads,
            sources, targets, effects, status);
        if mutation == 22 { return status.ok && !MapHas(effects, "101"); }
        return status.ok && MapHas(effects, "101") &&
            MapGet(effects, "101") == 3;
    }
    if mutation == 24 {
        MapSet(effects, "102", 2); MapSet(effects, "103", 2);
        let first_sources: Array<Int> = [0, 0];
        let first_targets: Array<Int> = [1, 2];
        let first_status: SemanticAstCollectionFormalEffectResolutionStatus =
            SemanticAstCollectionFormalEffectResolutionStatus(true);
        SemanticAstCollectionFormalEffectFixedPoint(
            inventory, blocked, mutations, shallow, reads,
            first_sources, first_targets, effects, first_status);
        let reordered_effects: HashMap<String, Int> = MapNew();
        MapSet(reordered_effects, "102", 2);
        MapSet(reordered_effects, "103", 2);
        let reordered_sources: Array<Int> = [0, 0];
        let reordered_targets: Array<Int> = [2, 1];
        let reordered_status: SemanticAstCollectionFormalEffectResolutionStatus =
            SemanticAstCollectionFormalEffectResolutionStatus(true);
        SemanticAstCollectionFormalEffectFixedPoint(
            inventory, blocked, mutations, shallow, reads,
            reordered_sources, reordered_targets, reordered_effects,
            reordered_status);
        return first_status.ok && reordered_status.ok &&
            MapHas(effects, "101") &&
            MapHas(reordered_effects, "101") &&
            MapGet(effects, "101") == 2 &&
            MapGet(reordered_effects, "101") == 2;
    }
    if mutation == 25 {
        MapSet(effects, "103", 7);
        let status: SemanticAstCollectionFormalEffectResolutionStatus =
            SemanticAstCollectionFormalEffectResolutionStatus(true);
        SemanticAstCollectionFormalEffectFixedPoint(
            inventory, blocked, mutations, shallow, reads,
            sources, targets, effects, status);
        return !status.ok && !MapHas(effects, "101") &&
            !MapHas(effects, "102") && MapGet(effects, "103") == 7;
    }
    return false;
}

// Synthetic vector/closure units do not grant storage or validate a producer.
func InspectConstructorEffectFrame(mutation: Int) -> Bool {
    let no_formal_escape: HashMap<String, Int> = MapNew();
    let no_formal_unknown: HashMap<String, Int> = MapNew();
    let no_formal_retiring: HashMap<String, Int> = MapNew();
    let no_formal_non_deep: HashMap<String, Int> = MapNew();
    let no_formal_descriptor_retiring: HashMap<String, Int> = MapNew();
    let facts: SemanticAstCollectionCallEffectFacts = SemanticAstCollectionCallEffectFacts(
        true, [101, 102], [201, 202], [301, 302],
        [101, 102, 103], [201, 202, 203], [301, 302, 303],
        [401, 402], [401, 402, 403], no_formal_escape, no_formal_unknown, no_formal_retiring, no_formal_non_deep,
        SemanticAstCollectionConstructorFieldInputsEmpty(), [501, 502, 503], no_formal_descriptor_retiring,
        SemanticAstCollectionFormalDescriptorRetentionEmpty());
    if !SemanticAstCollectionCallEffectFactsReady(facts, 2) { return false; }
    if mutation == 26 {
        ArrayPop(facts.definition_descriptor_retiring_sites);
        return !SemanticAstCollectionCallEffectFactsReady(facts, 2);
    }
    if mutation == 27 {
        ArrayPush(facts.definition_descriptor_retiring_sites, 0);
        return !SemanticAstCollectionCallEffectFactsReady(facts, 2);
    }
    if mutation == 14 {
        ArrayPop(facts.first_storage_escape_sites);
        return !SemanticAstCollectionCallEffectFactsReady(facts, 2);
    }
    if mutation == 15 {
        ArrayPop(facts.definition_storage_escape_sites);
        return !SemanticAstCollectionCallEffectFactsReady(facts, 2);
    }
    if mutation == 16 {
        SemanticAstCollectionSelectDefinitionEffects(facts, 1, 2);
        if facts.first_unknown_sites[1] != 103 || facts.first_retiring_sites[1] != 203 ||
            facts.first_non_deep_drop_retiring_sites[1] != 303 || facts.first_storage_escape_sites[1] != 403 ||
            facts.first_unknown_sites[0] != 101 || facts.first_retiring_sites[0] != 201 ||
            facts.first_non_deep_drop_retiring_sites[0] != 301 || facts.first_storage_escape_sites[0] != 401 { return false; }
        SemanticAstCollectionSelectDefinitionEffects(facts, 1, 0);
        if facts.first_unknown_sites[1] != 101 || facts.first_retiring_sites[1] != 201 ||
            facts.first_non_deep_drop_retiring_sites[1] != 301 || facts.first_storage_escape_sites[1] != 401 { return false; }
        facts.definition_storage_escape_sites[2] = -1;
        SemanticAstCollectionSelectDefinitionEffects(facts, 1, 2);
        return facts.first_storage_escape_sites[1] == -1 && facts.first_unknown_sites[1] == 103 &&
            facts.first_retiring_sites[1] == 203 && facts.first_non_deep_drop_retiring_sites[1] == 303;
    }
    let ints: Array<Int> = [1, 2, 3];
    let definitions: SemanticAstCollectionDefinitionFacts = SemanticAstCollectionDefinitionFacts(
        true, 3, ints, ints, ints, ints, ints, ints, ints, ints, ints, ints, ints,
        [true, true, true], [false, true, true]);
    let storage: SemanticAstCollectionStorageAuthorityFacts = SemanticAstCollectionStorageAuthorityFacts(
        true, [false, true, true], [-1, -1, -1], [1, 0, 0]);
    let parents: Array<Int> = [-1, 0, 0];
    let unknown: Array<Int> = [-1, -1, -1];
    let retiring: Array<Int> = [-1, -1, -1];
    let non_deep: Array<Int> = [-1, -1, -1];
    let escaping: Array<Int> = [-1, -1, 43];
    let descriptor_retiring: Array<Int> = [-1, -1, -1];
    if mutation == 28 { descriptor_retiring[2] = 43; }
    if mutation == 18 { storage.borrowed_definitions = [false, false, false]; }
    SemanticAstCollectionDefinitionEffectClosure(definitions, storage, parents, unknown, retiring, non_deep, escaping, descriptor_retiring);
    if mutation == 28 {
        return descriptor_retiring[0] == 43 && descriptor_retiring[1] == 43 &&
            descriptor_retiring[2] == 43 && unknown[0] == -1 &&
            retiring[0] == -1 && non_deep[0] == -1;
    }
    if unknown[0] != -1 || unknown[1] != -1 || unknown[2] != -1 ||
        retiring[0] != -1 || retiring[1] != -1 || retiring[2] != -1 ||
        non_deep[0] != -1 || non_deep[1] != -1 || non_deep[2] != -1 { return false; }
    if mutation == 17 { return escaping[0] == 43 && escaping[1] == 43 && escaping[2] == 43; }
    if escaping[0] != -1 || escaping[1] != -1 || escaping[2] != 43 { return false; }
    escaping = [43, -1, -1];
    SemanticAstCollectionDefinitionEffectClosure(definitions, storage, parents, unknown, retiring, non_deep, escaping, descriptor_retiring);
    return escaping[0] == 43 && escaping[1] == 43 && escaping[2] == 43 &&
        unknown[0] == -1 && unknown[1] == -1 && unknown[2] == -1 &&
        retiring[0] == -1 && retiring[1] == -1 && retiring[2] == -1 &&
        non_deep[0] == -1 && non_deep[1] == -1 && non_deep[2] == -1;
}

func Main() -> Void with caps env, io_read {
    let args: Array<String> = Args();
    if ArrayLength(args) != 2 { Log("expected source and mutation"); Exit(2); }
    let mutation: Int = ToInt(args[1]);
    if mutation < 0 || mutation > 28 || args[1] != ToString(mutation) {
        Log("invalid mutation"); Exit(2);
    }
    if mutation >= 26 {
        if !InspectConstructorEffectFrame(mutation) {
            Log("descriptor retirement frame mismatch"); Exit(1);
        }
        Log("true"); return;
    }
    if mutation >= 19 {
        if !InspectFormalEffectFixedPointFrame(mutation) {
            Log("formal effect fixed-point mismatch"); Exit(1);
        }
        Log("true"); return;
    }
    let artifact: AstTreeArtifact = ParseRootProgramArtifact(args[0]);
    if !AstTreeArtifactReady(artifact) { Log("fixture parser refused"); Exit(2); }
    let analysis: SemanticAstArtifactAnalysis = SemanticAstArtifactAnalyzeTyped(artifact, true);
    let bundle: SemanticAstBodyTypeBundle = SemanticAstBodyTypeBundleFromAnalysis(artifact, analysis);
    if !bundle.verdict.ok { Log("fixture body refused"); Exit(2); }
    if mutation >= 14 {
        if !InspectConstructorEffectFrame(mutation) { Log("constructor effect frame mismatch"); Exit(1); }
        Log("true"); return;
    }
    let constructors: SemanticAstNominalConstructorFacts = analysis.constructors;
    let surfaces: SemanticAstExpressionSurfaceFacts = analysis.expression_surfaces;
    let inferred: Array<String> = bundle.initializer_types.inferred_type_names;
    let locals: SemanticAstLocalBindingFacts = analysis.local_bindings;
    let surface: Int = -1;
    let edge: SemanticCallArgumentEdgeView = SemanticCallArgumentEdgeView(false, 0, 0, -1);
    let second: SemanticCallArgumentEdgeView = SemanticCallArgumentEdgeView(false, 0, 0, -1);
    let slot: Int = 0;
    let last: Int = -1;
    while slot < ArrayLength(surfaces.expression_graph.roots) {
        if surfaces.expression_graph.has_roots[slot] {
            let root: Int = surfaces.expression_graph.roots[slot];
            let node: Int = last + 1;
            while node <= root {
                if surfaces.expression_graph.arena.topology.node_kinds[node] == AstExpressionNodeCallArgument() {
                    let candidate: SemanticCallArgumentEdgeView = SemanticCallArgumentEdgeFromGraph(surfaces.expression_graph, node);
                    if candidate.ok && surfaces.expression_graph.arena.call_target_names[candidate.call_node] == "Carrier" {
                        if candidate.ordinal == 0 {
                            if edge.ok { Log("duplicate fixture edge"); Exit(2); }
                            edge = candidate; surface = slot / 3;
                        } else if candidate.ordinal == 1 { second = candidate; }
                    }
                }
                node = node + 1;
            }
            last = root;
        }
        slot = slot + 1;
    }
    let index: Option<Int> = SemanticAstNominalConstructorIndexForName(constructors, "Carrier");
    let decoy: Option<Int> = SemanticAstNominalConstructorIndexForName(constructors, "Decoy");
    let callee: Option<Int> = SemanticCallBaseCalleeFromGraph(surfaces.expression_graph, edge.call_node);
    if !edge.ok || !IsSome(index) || !IsSome(decoy) || !IsSome(callee) { Log("fixture identity missing"); Exit(2); }
    let owner: Int = UnwrapOption(index);
    let field: Int = constructors.param_starts[owner];
    let expected: Int = constructors.field_source_syntax_ids[field];
    if mutation == 1 { constructors.names[UnwrapOption(decoy)] = "Carrier"; }
    else if mutation == 2 { constructors.field_source_syntax_ids[field] = 0; }
    else if mutation == 3 { constructors.node_ids[owner] = 0; }
    else if mutation == 4 { edge.ordinal = 2; }
    else if mutation == 5 { constructors.param_starts[owner] = -1; }
    else if mutation == 6 { constructors.param_counts[owner] = ArrayLength(constructors.field_source_syntax_ids) + 1; }
    else if mutation == 7 { surfaces.expression_graph.arena.identities.call_target_syntax_ids[edge.call_node] = -1; }
    else if mutation == 8 { surfaces.expression_graph.arena.identities.runtime_call_abi_ids[edge.call_node] = -1; }
    else if mutation == 9 { ArrayPop(constructors.names); }
    else if mutation == 10 { surfaces.expression_graph.arena.call_target_kinds[edge.call_node] = SemanticCallTargetMember(); }
    else if mutation == 11 { surfaces.expression_graph.arena.identities.runtime_call_abi_ids[edge.call_node] = 1; }
    else if mutation == 12 {
        // Same nominal spelling, but the exact scoped local is a callable.
        let row: Int = 0;
        let found: Bool = false;
        while row < ArrayLength(locals.names) {
            if locals.names[row] == "seed" {
                locals.names[row] = "Carrier";
                locals.declared_type_names[row] = "func(Array<String>)->Int";
                inferred[row] = "func(Array<String>)->Int";
                found = true;
            }
            row = row + 1;
        }
        if !found { Log("fixture callable missing"); Exit(2); }
    } else if mutation == 13 {
        if !second.ok { Log("fixture second edge missing"); Exit(2); }
        edge = second; expected = constructors.field_source_syntax_ids[field + 1];
    }
    let escape: SemanticAstCollectionConstructorFieldIdentity = SemanticAstCollectionConstructorStorageEscapeField(
        artifact, constructors, locals, inferred, surfaces, surface, edge);
    let passed: Bool = false;
    if mutation == 0 || mutation == 13 {
        if escape.ok {
            let identity: SemanticAstCollectionConstructorFieldIdentity = escape;
            passed = identity.field_syntax_id == expected && expected > 0 &&
                identity.constructor_syntax_id == constructors.node_ids[owner] && identity.constructor_row == owner;
        }
    }
    else if mutation >= 10 {
        if escape.ok {
            let identity: SemanticAstCollectionConstructorFieldIdentity = escape;
            passed = identity.field_syntax_id == 0 && identity.constructor_syntax_id == 0 && identity.field_type_name == "" &&
                identity.constructor_row == -1 && identity.field_row == -1;
        }
    }
    else { passed = !escape.ok; }
    if !passed { Log("constructor escape identity mismatch"); Exit(1); }
    Log("true");
}
