// Inspect the reached formal and call-effect owners; never emit or run input.
import "../../../src/self_hosted/parser/program_parse_owner.pgy";
import "../../../src/self_hosted/semantic/ast_body_type_bundle_owner.pgy";

func Main() -> Void with caps env, io_read {
    let args: Array<String> = Args();
    if ArrayLength(args) != 1 && ArrayLength(args) != 2 { Exit(2); }
    let artifact: AstTreeArtifact = ParseRootProgramArtifact(args[0]);
    if !AstTreeArtifactReady(artifact) { Log("parser refused"); Exit(2); }
    let analysis: SemanticAstArtifactAnalysis = SemanticAstArtifactAnalyzeTyped(artifact, true);
    if !analysis.verdict.ok { Log(analysis.verdict.diagnostic_code); Exit(2); }
    let bundle: SemanticAstBodyTypeBundle = SemanticAstBodyTypeBundleFromAnalysis(artifact, analysis);
    Log("body_ok=" + ToString(bundle.verdict.ok));
    Log("body_diagnostic=" + bundle.verdict.diagnostic_code);
    Log("body_syntax=" + ToString(bundle.verdict.first_node_id));
    let formals: SemanticAstCollectionFormalEffects = bundle.collection_formal_effects;
    if !formals.ok { Log("formal owner not reached"); Exit(2); }
    let proved: HashMap<String, Int> = formals.effects;
    let definitions: SemanticAstCollectionDefinitionFacts = SemanticAstCollectionDefinitionFactsFromResolvedFacts(
        artifact, analysis.signatures, analysis.local_bindings,
        bundle.initializer_types.inferred_type_names, analysis.expression_surfaces,
        analysis.assignments, bundle.assignment_types);
    let storage: SemanticAstCollectionStorageAuthorityFacts = SemanticAstCollectionStorageAuthorityFromDefinitions(
        analysis.signatures, analysis.local_bindings, analysis.expression_surfaces, definitions);
    if !definitions.ok || !storage.ok { Log("storage owner not reached"); Exit(2); }
    let calls: SemanticAstCollectionCallEffectFacts = SemanticAstCollectionCallEffectFactsFromResolvedFacts(
        artifact, analysis.signatures, analysis.constructors, analysis.local_bindings,
        bundle.initializer_types.inferred_type_names, analysis.expression_surfaces,
        formals.inventory.row_by_formal, formals.inventory.modes, formals.effects,
        definitions, storage);
    if !SemanticAstCollectionCallEffectFactsReady(calls, definitions.local_count) {
        Log("call-effect owner not reached"); Exit(2);
    }
    let found: Int = 0;
    let row: Int = 0;
    while row < ArrayLength(formals.inventory.formal_nodes) {
        let function: Int = formals.inventory.function_nodes[row];
        let signature: Option<Int> = SemanticAstFunctionSignatureIndexForNode(analysis.signatures, function);
        if !IsSome(signature) { Exit(2); }
        let name: Option<String> = SemanticAstFunctionNameAt(analysis.signatures, UnwrapOption(signature));
        if !IsSome(name) { Exit(2); }
        if (ArrayLength(args) == 2 && UnwrapOption(name) == args[1]) ||
            (ArrayLength(args) == 1 &&
             (UnwrapOption(name) == "CodegenValueWrapperUsageCollectType" ||
              UnwrapOption(name) == "CodegenValueWrapperUsageContains")) {
            let formal: Int = formals.inventory.formal_nodes[row];
            let key: String = ToString(formal);
            let effect: Int = -1;
            if MapHas(proved, key) { effect = MapGet(proved, key); }
            Log("function=" + UnwrapOption(name));
            Log("formal=" + key);
            Log("mode=" + ToString(formals.inventory.modes[row]));
            Log("effect=" + ToString(effect));
            Log("unknown=" + ToString(SemanticAstCollectionFormalPermissionSite(calls.formal_unknown_sites, formal)));
            Log("escaped=" + ToString(SemanticAstCollectionFormalPermissionSite(calls.formal_storage_escape_sites, formal)));
            Log("retiring=" + ToString(SemanticAstCollectionFormalPermissionSite(calls.formal_retiring_sites, formal)));
            Log("non_deep=" + ToString(SemanticAstCollectionFormalPermissionSite(calls.formal_non_deep_drop_sites, formal)));
            Log("descriptor_retiring=" + ToString(SemanticAstCollectionFormalPermissionSite(calls.formal_descriptor_retiring_sites, formal)));
            if ArrayLength(args) == 2 {
                let surface: Int = 0;
                while surface < ArrayLength(analysis.expression_surfaces.node_ids) {
                    if analysis.expression_surfaces.function_node_ids[surface] == formals.inventory.function_nodes[row] {
                        let lane: Int = 0;
                        while lane < 3 {
                            let slot: Int = surface * 3 + lane;
                            if analysis.expression_surfaces.expression_graph.has_roots[slot] {
                                let start: Option<Int> = SemanticExpressionGraphRootStartAt(analysis.expression_surfaces.expression_graph, slot);
                                if !IsSome(start) { Exit(2); }
                                let node: Int = UnwrapOption(start);
                                while node <= analysis.expression_surfaces.expression_graph.roots[slot] {
                                    let edge: SemanticCallArgumentEdgeView = SemanticCallArgumentEdgeFromGraph(analysis.expression_surfaces.expression_graph, node);
                                    if edge.ok {
                                        let identity: SemanticExpressionBindingIdentityFact = SemanticExpressionGraphBindingIdentity(analysis.expression_surfaces.expression_graph, edge.argument_node);
                                        if identity.ok && identity.kind == SemanticExpressionBindingFormalParameter() && identity.syntax_id == formal {
                                            let target: Option<String> = SemanticExpressionGraphCallTargetName(analysis.expression_surfaces.expression_graph, edge.call_node);
                                            if !IsSome(target) { Exit(2); }
                                            Log("direct_call=" + UnwrapOption(target));
                                            Log("target_formal=" + ToString(SemanticAstCollectionSourceStringSequenceFormalForArgument(
                                                analysis.signatures, analysis.expression_surfaces.expression_graph, edge.call_node, edge.ordinal)));
                                        }
                                    }
                                    node = node + 1;
                                }
                            }
                            lane = lane + 1;
                        }
                    }
                    surface = surface + 1;
                }
            }
            found = found + 1;
        }
        row = row + 1;
    }
    let expected: Int = 2;
    if ArrayLength(args) == 2 { expected = 1; }
    if found != expected { Log("expected exact selected formals"); Exit(2); }
}
