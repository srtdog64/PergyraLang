// Mutate freshly produced, sealed facts only AFTER body admission.
// Each invocation owns its parse/bundle; no shared baseline arrays are reused.
import "../../../src/self_hosted/parser/program_parse_owner.pgy";
import "../../../src/self_hosted/semantic/ast_body_type_bundle_owner.pgy";

func Main() -> Void with caps env, io_read {
    let args: Array<String> = Args();
    if ArrayLength(args) != 2 { Log("expected source and mutation"); Exit(2); }
    let mutation: Int = ToInt(args[1]);
    let artifact: AstTreeArtifact = ParseRootProgramArtifact(args[0]);
    if !AstTreeArtifactReady(artifact) { Log("fixture parser refused"); Exit(2); }
    let analysis: SemanticAstArtifactAnalysis = SemanticAstArtifactAnalyzeTyped(artifact, true);
    let bundle: SemanticAstBodyTypeBundle = SemanticAstBodyTypeBundleFromAnalysis(artifact, analysis);
    if mutation == -1 {
        // Collection refusal is reached only AFTER identity sealing. An earlier
        // body failure must never turn an unused/unbound graph into a proof.
        let reached: Bool = bundle.verdict.ok || (!bundle.collection_ownership.ok &&
            bundle.collection_ownership.diagnostic_code == "borrow_boundary_escape" &&
            bundle.collection_ownership.syntax_node_id >= 0);
        if !reached || !SemanticAstExpressionSurfaceBorrowReady(artifact, analysis.expression_surfaces) ||
            !SemanticExpressionGraphCarriedCallTargetsReady(analysis.expression_surfaces.expression_graph) {
            Log("actual producer did not reach sealed collection facts"); Exit(2);
        }
        let actual: SemanticAstCollectionFormalEffects = SemanticAstCollectionFormalEffectsFromResolvedFacts(
            analysis.signatures, analysis.expression_surfaces);
        let proved_actual: HashMap<String, Int> = actual.effects;
        if !actual.ok { Log("actual formal effects are invalid"); Exit(2); }
        let observed: Int = 0;
        let actual_row: Int = 0;
        while actual_row < ArrayLength(analysis.signatures.names) {
            let name: String = analysis.signatures.names[actual_row];
            let suffix: String = "src/self_hosted/semantic/ast_expression_environment_owner.pgy";
            let label: String = "";
            let first: Int = 0;
            let count: Int = 1;
            let expected: Int = 3;
            let mode: Int = 0;
            if name == "SemanticAstExpressionFunctionRowIndex" { label = "row_index"; }
            if name == "SeedSemanticOwnedBuiltinSignaturesUnclaimed" {
                label = "seed"; suffix = "src/self_hosted/semantic/builtin_shadow_owner.pgy";
                first = 1; count = 3; expected = 2; mode = 1;
            }
            if name == "SemanticAstExpressionFunctionTables" {
                label = "tables"; first = 3; count = 3; expected = 2; mode = 1;
            }
            if label != "" {
                let module: Option<String> = SemanticAstFunctionModulePathAt(analysis.signatures, actual_row);
                if !IsSome(module) || !SemanticCompilerInternalBuiltinModulePathMatches(UnwrapOption(module), suffix) {
                    Log("actual producer module mismatch"); Exit(2);
                }
                let ordinal: Int = first;
                while ordinal < first + count {
                    let actual_formal: Option<Int> = SemanticAstFunctionParamNodeAt(analysis.signatures, actual_row, ordinal);
                    let param_mode: Option<Int> = SemanticAstFunctionParamModeAt(analysis.signatures, actual_row, ordinal);
                    if !IsSome(actual_formal) || UnwrapOption(actual_formal) <= 0 || !IsSome(param_mode) || UnwrapOption(param_mode) != mode {
                        Log("actual producer formal identity mismatch"); Exit(2);
                    }
                    let actual_key: String = ToString(UnwrapOption(actual_formal));
                    if !MapHas(proved_actual, actual_key) || MapGet(proved_actual, actual_key) != expected {
                        Log(Concat(label, Concat(":unproved=", ToString(ordinal)))); Exit(2);
                    }
                    Log(Concat(label, Concat(":", Concat(ToString(ordinal), Concat("=", ToString(expected))))));
                    observed = observed + 1; ordinal = ordinal + 1;
                }
            }
            actual_row = actual_row + 1;
        }
        if observed != 7 { Log("actual producer formal count mismatch"); Exit(2); }
        return;
    }
    if !bundle.verdict.ok { Log(bundle.verdict.diagnostic_code); Exit(2); }
    if mutation >= 26 && mutation <= 36 {
        Log(InspectAssignmentDefinitionAdmission(artifact, analysis, bundle, mutation)); return;
    }
    if mutation >= 22 && mutation <= 25 {
        Log(InspectOwnArgumentOccurrenceOrder(artifact, analysis, bundle, mutation)); return;
    }
    if mutation >= 16 && mutation <= 21 {
        Log(InspectOwnStorageAdmission(artifact, analysis, bundle, mutation)); return;
    }
    let signature: Int = -1;
    let other: Int = -1;
    let indexed: Int = -1;
    let main_node: Int = -1;
    let row: Int = 0;
    while row < ArrayLength(analysis.signatures.names) {
        if analysis.signatures.names[row] == "Populate" { signature = row; }
        if analysis.signatures.names[row] == "Forward" { other = row; }
        if analysis.signatures.names[row] == "Matches" { indexed = row; }
        if analysis.signatures.names[row] == "Main" { main_node = analysis.signatures.function_node_ids[row]; }
        row = row + 1;
    }
    if signature < 0 || other < 0 { Log("missing producer identities"); Exit(2); }
    let formal: Int = UnwrapOption(SemanticAstFunctionParamNodeAt(analysis.signatures, signature, 0));
    let foreign: Int = UnwrapOption(SemanticAstFunctionParamNodeAt(analysis.signatures, other, 0));
    let indexed_formal: Int = -1;
    if mutation >= 13 {
        if indexed < 0 { Log("missing indexed formal identity"); Exit(2); }
        indexed_formal = UnwrapOption(SemanticAstFunctionParamNodeAt(analysis.signatures, indexed, 0));
    }
    let changed: Bool = mutation == 0 || mutation == 13;
    let shared_index: Int = -1;
    let unknown_call_syntax: Int = -1;
    let slot: Int = 0;
    let last: Int = -1;
    while slot < ArrayLength(analysis.expression_surfaces.expression_graph.roots) {
        if analysis.expression_surfaces.expression_graph.has_roots[slot] {
            let root: Int = analysis.expression_surfaces.expression_graph.roots[slot];
            let node: Int = last + 1;
            while node <= root {
                let binding: SemanticExpressionBindingIdentityFact =
                    SemanticExpressionGraphBindingIdentity(analysis.expression_surfaces.expression_graph, node);
                if mutation >= 14 && analysis.expression_surfaces.function_node_ids[slot / 3] ==
                        analysis.signatures.function_node_ids[indexed] {
                    let kind: Int = analysis.expression_surfaces.expression_graph.arena.topology.node_kinds[node];
                    if kind == AstExpressionNodeIndex() { shared_index = node; }
                    if !changed && mutation == 14 && kind == AstExpressionNodeEquality() {
                        analysis.expression_surfaces.expression_graph.arena.call_target_kinds[node] = SemanticCallTargetRoleOperator();
                        analysis.expression_surfaces.expression_graph.arena.call_target_names[node] = "TextEqualityRole.Eq";
                        changed = true;
                    }
                    if !changed && mutation == 15 && kind == AstExpressionNodeArrayElement() && shared_index >= 0 {
                        // A second physical parent escapes the same comparison operand.
                        analysis.expression_surfaces.expression_graph.arena.topology.right_children[node] = shared_index;
                        changed = true;
                    }
                }
                if !changed && binding.kind == SemanticExpressionBindingFormalParameter() && binding.syntax_id == formal {
                    if mutation == 1 { analysis.expression_surfaces.expression_graph.arena.identities.binding_syntax_ids[node] = 0; }
                    if mutation == 2 { analysis.expression_surfaces.expression_graph.arena.identities.binding_syntax_ids[node] = foreign; }
                    if mutation == 3 { analysis.expression_surfaces.expression_graph.arena.identities.binding_ordinals[node] = 99; }
                    if mutation == 4 { analysis.expression_surfaces.function_node_ids[slot / 3] = analysis.signatures.function_node_ids[other]; }
                    if mutation >= 1 && mutation <= 4 { changed = true; }
                }
                if !changed && SemanticAstCollectionOwnershipBuiltinCall(
                        analysis.expression_surfaces.expression_graph, node, "ArrayPushOwnedString") {
                    if mutation == 6 { analysis.expression_surfaces.expression_graph.arena.identities.runtime_call_abi_ids[node] = 9; }
                    if mutation == 7 { analysis.expression_surfaces.expression_graph.arena.identities.call_target_syntax_ids[node] = analysis.signatures.function_node_ids[other]; }
                    if mutation == 8 {
                        let callee: Int = UnwrapOption(SemanticExpressionGraphLeftChild(analysis.expression_surfaces.expression_graph, node));
                        analysis.expression_surfaces.expression_graph.arena.identities.binding_kinds[callee] = SemanticExpressionBindingDeclaredCallable();
                        analysis.expression_surfaces.expression_graph.arena.identities.binding_syntax_ids[callee] = analysis.signatures.function_node_ids[other];
                    }
                    if mutation >= 6 && mutation <= 8 { changed = true; }
                }
                if !changed && mutation == 10 && analysis.expression_surfaces.expression_graph.arena.topology.node_kinds[node] == AstExpressionNodeCall() &&
                    analysis.expression_surfaces.expression_graph.arena.identities.call_target_syntax_ids[node] == analysis.signatures.function_node_ids[signature] {
                    analysis.expression_surfaces.expression_graph.arena.identities.call_target_syntax_ids[node] = 0;
                    changed = true;
                }
                if !changed && mutation >= 11 && mutation <= 12 && analysis.expression_surfaces.expression_graph.arena.topology.node_kinds[node] == AstExpressionNodeCall() &&
                    analysis.expression_surfaces.expression_graph.arena.identities.call_target_syntax_ids[node] == analysis.signatures.function_node_ids[other] {
                    analysis.expression_surfaces.expression_graph.arena.identities.call_target_syntax_ids[node] = 0;
                    unknown_call_syntax = analysis.expression_surfaces.node_ids[slot / 3];
                    changed = true;
                }
                node = node + 1;
            }
            last = root;
        }
        slot = slot + 1;
    }
    if mutation == 5 { analysis.signatures.action_contracts.body_node_ids[signature] = -1; changed = true; }
    if mutation == 9 { ArrayPop(analysis.signatures.param_node_ids); changed = true; }
    if !changed { Log("mutation did not reach its fact"); Exit(2); }
    if mutation >= 14 && !SemanticExpressionGraphFactsReady(analysis.expression_surfaces.expression_graph,
            ArrayLength(analysis.expression_surfaces.expression_graph.roots)) {
        Log("indexed comparator graph shape is invalid"); Exit(2);
    }
    let effects: SemanticAstCollectionFormalEffects = SemanticAstCollectionFormalEffectsFromResolvedFacts(
        analysis.signatures, analysis.expression_surfaces);
    let proved: HashMap<String, Int> = effects.effects;
    let key: String = ToString(formal);
    if mutation == 13 {
        Log(effects.ok && MapHas(proved, key) && MapGet(proved, key) == 2 &&
            MapHas(proved, ToString(foreign)) && MapGet(proved, ToString(foreign)) == 2 &&
            MapHas(proved, ToString(indexed_formal)) && MapGet(proved, ToString(indexed_formal)) == 3);
    } else if mutation >= 14 {
        Log(effects.ok && !MapHas(proved, ToString(indexed_formal)) &&
            !MapHas(proved, key) && !MapHas(proved, ToString(foreign)));
    } else if mutation == 0 {
        Log(effects.ok && MapHas(proved, key) && MapGet(proved, key) == 2 &&
            MapHas(proved, ToString(foreign)) && MapGet(proved, ToString(foreign)) == 2);
    } else if mutation == 10 {
        Log(!effects.ok || !MapHas(proved, ToString(foreign)));
    } else if mutation >= 11 && mutation <= 12 {
        // Bounds production cannot change state. Only the exact Main.values
        // event loses permission; retirement must remain sticky afterwards.
        let ownership: Array<Int> = [];
        let dispositions: Array<Int> = [];
        let transitions: Array<Int> = [];
        let caller_row: Int = -1;
        row = 0;
        while row < ArrayLength(analysis.local_bindings.node_ids) {
            let state: Int = SemanticAstCollectionOwnershipUnknown();
            let transition: Int = SemanticAstCollectionTransitionEmpty();
            if mutation == 12 { state = SemanticAstCollectionOwnershipOwnedElements(); transition = SemanticAstCollectionTransitionOwned(); }
            ArrayPush(ownership, state); ArrayPush(dispositions, SemanticAstCollectionDispositionLive());
            if analysis.local_bindings.names[row] == "values" && analysis.local_bindings.function_node_ids[row] == main_node { caller_row = row; }
            ArrayPush(transitions, transition); row = row + 1;
        }
        let formal_rows: HashMap<String, Int> = effects.inventory.row_by_formal;
        let modes: Array<Int> = effects.inventory.modes;
        let origins: Array<Int> = bundle.collection_ownership.origins;
        let source_ids: Array<Int> = bundle.collection_ownership.source_binding_syntax_ids;
        let definitions: SemanticAstCollectionDefinitionFacts = SemanticAstCollectionDefinitionFactsFromResolvedFacts(
            artifact, analysis.signatures, analysis.local_bindings, bundle.initializer_types.inferred_type_names,
            analysis.expression_surfaces, analysis.assignments, bundle.assignment_types);
        let facts: SemanticAstCollectionCallEffectFacts = SemanticAstCollectionCallEffectFactsFromResolvedFacts(
            artifact, analysis.signatures, analysis.local_bindings,
            bundle.initializer_types.inferred_type_names, analysis.expression_surfaces,
            formal_rows, modes, proved, definitions);
        if caller_row < 0 || unknown_call_syntax < 0 || !SemanticAstCollectionCallEffectFactsReady(facts, ArrayLength(ownership)) {
            Log("missing exact caller effect frame"); Exit(2);
        }
        let initial_state: Int = SemanticAstCollectionOwnershipUnknown();
        let initial_transition: Int = SemanticAstCollectionTransitionEmpty();
        if mutation == 12 { initial_state = SemanticAstCollectionOwnershipOwnedElements(); initial_transition = SemanticAstCollectionTransitionOwned(); }
        let unchanged: Bool = true;
        row = 0;
        while row < ArrayLength(ownership) {
            if ownership[row] != initial_state || transitions[row] != initial_transition || dispositions[row] != SemanticAstCollectionDispositionLive() { unchanged = false; }
            row = row + 1;
        }
        let site: Int = SemanticAstCollectionCallRetirementSite(artifact, unknown_call_syntax);
        let bounded: Bool = facts.first_unknown_sites[caller_row] == site && facts.first_retiring_sites[caller_row] == site && facts.first_non_deep_drop_retiring_sites[caller_row] == site;
        let before: Bool = SemanticAstCollectionApplyUnknownCallStateAtUse(artifact, facts, caller_row,
            analysis.local_bindings.node_ids[caller_row], ownership, dispositions, transitions);
        let before_unchanged: Bool = !before && ownership[caller_row] == initial_state && transitions[caller_row] == initial_transition;
        let reached_unknown: Bool = SemanticAstCollectionApplyUnknownCallStateAtUse(artifact, facts, caller_row,
            unknown_call_syntax, ownership, dispositions, transitions);
        let invalidated: Bool = reached_unknown && ownership[caller_row] == SemanticAstCollectionOwnershipUnknown() && transitions[caller_row] == SemanticAstCollectionTransitionUntracked();
        ownership[caller_row] = SemanticAstCollectionOwnershipRetired(); transitions[caller_row] = SemanticAstCollectionTransitionRetired();
        let repeated: Bool = SemanticAstCollectionApplyUnknownCallStateAtUse(artifact, facts, caller_row,
            unknown_call_syntax, ownership, dispositions, transitions);
        let sticky: Bool = repeated && ownership[caller_row] == SemanticAstCollectionOwnershipRetired() && transitions[caller_row] == SemanticAstCollectionTransitionRetired();
        dispositions[caller_row] = SemanticAstCollectionDispositionRetired();
        SemanticAstCollectionApplyTerminalCallEffects(facts, ownership, dispositions, transitions);
        sticky = sticky && dispositions[caller_row] == SemanticAstCollectionDispositionRetired() && ownership[caller_row] == SemanticAstCollectionOwnershipRetired() && transitions[caller_row] == SemanticAstCollectionTransitionRetired();
        ownership[caller_row] = initial_state; transitions[caller_row] = initial_transition;
        let disposed: Bool = SemanticAstCollectionApplyUnknownCallStateAtUse(artifact, facts, caller_row,
            unknown_call_syntax, ownership, dispositions, transitions);
        let disposition_sticky: Bool = disposed && ownership[caller_row] == initial_state && transitions[caller_row] == initial_transition;
        SemanticAstCollectionApplyTerminalCallEffects(facts, ownership, dispositions, transitions);
        disposition_sticky = disposition_sticky && ownership[caller_row] == initial_state && transitions[caller_row] == initial_transition;
        ArrayPop(facts.first_unknown_sites);
        Log(effects.ok && MapHas(proved, ToString(foreign)) && unchanged && bounded && before_unchanged && invalidated && sticky && disposition_sticky && !SemanticAstCollectionCallEffectFactsReady(facts, ArrayLength(ownership)));
    } else {
        Log(!effects.ok || !MapHas(proved, key));
    }
}

func InspectOwnStorageAdmission(
    artifact: AstTreeArtifact, inout analysis: SemanticAstArtifactAnalysis,
    ref bundle: SemanticAstBodyTypeBundle, mutation: Int
) -> Bool {
    let signature: Int = -1;
    let other: Int = -1;
    let row: Int = 0;
    while row < ArrayLength(analysis.signatures.names) {
        if analysis.signatures.names[row] == "Metadata" { signature = row; }
        if analysis.signatures.names[row] == "Other" { other = row; }
        row = row + 1;
    }
    if signature < 0 || other < 0 { return false; }
    let formal: Int = UnwrapOption(SemanticAstFunctionParamNodeAt(analysis.signatures, signature, 0));
    let slot: Int = 0;
    let last: Int = -1;
    while slot < ArrayLength(analysis.expression_surfaces.expression_graph.roots) {
        if analysis.expression_surfaces.expression_graph.has_roots[slot] {
            let root: Int = analysis.expression_surfaces.expression_graph.roots[slot];
            let node: Int = last + 1;
            while node <= root {
                if analysis.expression_surfaces.expression_graph.arena.topology.node_kinds[node] == AstExpressionNodeCallArgument() {
                    let edge: SemanticCallArgumentEdgeView = SemanticCallArgumentEdgeFromGraph(analysis.expression_surfaces.expression_graph, node);
                    if edge.ok && SemanticAstCollectionOwnStringArrayParameterNode(analysis.signatures,
                            analysis.expression_surfaces.expression_graph, edge.call_node, edge.ordinal) == formal {
                        if mutation == 17 { analysis.expression_surfaces.expression_graph.arena.identities.call_target_syntax_ids[edge.call_node] = 0; }
                        if mutation == 18 { analysis.expression_surfaces.expression_graph.arena.identities.call_target_syntax_ids[edge.call_node] = analysis.signatures.function_node_ids[other]; }
                        if mutation == 19 { analysis.signatures.param_node_ids[analysis.signatures.param_starts[signature]] = 0; }
                        if mutation == 20 { analysis.signatures.receiver_source_param_offsets[signature] = 1; }
                        if mutation == 21 { edge.ordinal = 99; }
                        if mutation > 16 {
                            return SemanticAstCollectionOwnStringArrayParameterNode(analysis.signatures,
                                analysis.expression_surfaces.expression_graph, edge.call_node, edge.ordinal) == 0;
                        }
                        let binding: SemanticAstLocalBindingIdentity = SemanticAstCollectionOwnershipLocalForArgument(
                            artifact, analysis.local_bindings, bundle.initializer_types.inferred_type_names,
                            analysis.expression_surfaces, slot / 3, edge.argument_node);
                        if !binding.ok || ArrayLength(analysis.local_bindings.node_ids) != 1 || binding.row != 0 { return false; }
                        let effects: SemanticAstCollectionFormalEffects = SemanticAstCollectionFormalEffectsFromResolvedFacts(analysis.signatures, analysis.expression_surfaces);
                        let formal_rows: HashMap<String, Int> = effects.inventory.row_by_formal;
                        let modes: Array<Int> = effects.inventory.modes;
                        let proved: HashMap<String, Int> = effects.effects;
                        let definitions: SemanticAstCollectionDefinitionFacts = SemanticAstCollectionDefinitionFactsFromResolvedFacts(
                            artifact, analysis.signatures, analysis.local_bindings, bundle.initializer_types.inferred_type_names,
                            analysis.expression_surfaces, analysis.assignments, bundle.assignment_types);
                        let facts: SemanticAstCollectionCallEffectFacts = SemanticAstCollectionCallEffectFactsFromResolvedFacts(
                            artifact, analysis.signatures, analysis.local_bindings,
                            bundle.initializer_types.inferred_type_names, analysis.expression_surfaces,
                            formal_rows, modes, proved, definitions);
                        if !effects.ok || !SemanticAstCollectionCallEffectFactsReady(facts, 1) { return false; }
                        let ownership: Array<Int> = [SemanticAstCollectionOwnershipBorrowedElements()];
                        let dispositions: Array<Int> = [SemanticAstCollectionDispositionLive()];
                        let transitions: Array<Int> = [SemanticAstCollectionTransitionUntracked()];
                        let requirements: HashMap<String, Int> = MapNew();
                        let syntax: Int = analysis.expression_surfaces.node_ids[slot / 3];
                        let live: SemanticAstCollectionOwnershipVerdict = SemanticAstCollectionOwnedArgumentVerdict(
                            artifact, analysis.signatures, analysis.local_bindings, bundle.initializer_types.inferred_type_names,
                            analysis.expression_surfaces, slot / 3, edge, binding, false, facts, requirements,
                            ownership, dispositions, bundle.collection_ownership.origins, transitions);
                        let unknown: SemanticAstCollectionOwnershipVerdict = SemanticAstCollectionOwnedArgumentVerdict(
                            artifact, analysis.signatures, analysis.local_bindings, bundle.initializer_types.inferred_type_names,
                            analysis.expression_surfaces, slot / 3, edge, binding, true, facts, requirements,
                            ownership, dispositions, bundle.collection_ownership.origins, transitions);
                        let clean: Bool = live.ok && !unknown.ok && ownership[0] == SemanticAstCollectionOwnershipBorrowedElements() &&
                            transitions[0] == SemanticAstCollectionTransitionUntracked() &&
                            bundle.collection_ownership.element_ownerships[0] == SemanticAstCollectionOwnershipBorrowedElements();
                        clean = clean && !SemanticAstCollectionOwnedArgumentStorageLive(0, syntax, -1, ownership, dispositions, transitions) &&
                            !SemanticAstCollectionOwnedArgumentStorageLive(0, syntax, 0, ownership, dispositions, transitions) &&
                            !SemanticAstCollectionOwnedArgumentStorageLive(0, syntax, syntax + 1, ownership, dispositions, transitions);
                        dispositions[0] = SemanticAstCollectionDispositionRetired();
                        clean = clean && !SemanticAstCollectionOwnedArgumentStorageLive(0, syntax, syntax, ownership, dispositions, transitions);
                        dispositions[0] = SemanticAstCollectionDispositionLive(); ownership[0] = SemanticAstCollectionOwnershipRetired();
                        clean = clean && !SemanticAstCollectionOwnedArgumentStorageLive(0, syntax, syntax, ownership, dispositions, transitions);
                        ownership[0] = SemanticAstCollectionOwnershipBorrowedElements(); transitions[0] = SemanticAstCollectionTransitionRetired();
                        clean = clean && !SemanticAstCollectionOwnedArgumentStorageLive(0, syntax, syntax, ownership, dispositions, transitions);
                        ArrayPop(transitions);
                        return clean && !SemanticAstCollectionOwnedArgumentStorageLive(0, syntax, syntax, ownership, dispositions, transitions);
                    }
                }
                node = node + 1;
            }
            last = root;
        }
        slot = slot + 1;
    }
    return false;
}

// Owner-unit mutation after the unchanged source has passed full admission.
// These probes do not substitute for negative artifact admission or execution.
func InspectAssignmentDefinitionAdmission(
    artifact: AstTreeArtifact, inout analysis: SemanticAstArtifactAnalysis,
    inout bundle: SemanticAstBodyTypeBundle, mutation: Int
) -> Bool {
    let assignment: Int = -1;
    let row: Int = 0;
    let foreign_local: Int = -1;
    let foreign_formal: Int = -1;
    let function_id: Int = -1;
    let signature: Int = 0;
    while signature < ArrayLength(analysis.signatures.names) {
        if analysis.signatures.names[signature] == "Forward" { function_id = analysis.signatures.function_node_ids[signature]; }
        if analysis.signatures.names[signature] == "Metadata" { foreign_formal = UnwrapOption(SemanticAstFunctionParamNodeAt(analysis.signatures, signature, 0)); }
        signature = signature + 1;
    }
    while row < ArrayLength(analysis.assignments.node_ids) {
        if analysis.assignments.function_node_ids[row] == function_id { assignment = row; }
        row = row + 1;
    }
    row = 0;
    while row < ArrayLength(analysis.local_bindings.node_ids) {
        if analysis.local_bindings.function_node_ids[row] != function_id { foreign_local = row; }
        row = row + 1;
    }
    if assignment < 0 || foreign_local < 0 || foreign_formal <= 0 { return false; }
    let syntax: Int = analysis.assignments.node_ids[assignment];
    let surface: Int = UnwrapOption(SemanticAstExpressionSurfaceIndexForNode(analysis.expression_surfaces, syntax));
    let target: Int = UnwrapOption(SemanticAstExpressionGraphRootForNode(analysis.expression_surfaces, syntax, AstExpressionLaneAtom()));
    let value: Int = UnwrapOption(SemanticAstExpressionGraphRootForNode(analysis.expression_surfaces, syntax, AstExpressionLaneValue()));
    if mutation == 27 { bundle.assignment_types.node_ids[assignment] = 0; }
    if mutation == 28 { bundle.assignment_types.verified[assignment] = 0; }
    if mutation == 29 { analysis.expression_surfaces.expression_graph.has_roots[(surface * 3) + AstExpressionLaneAtom()] = false; }
    if mutation == 30 { analysis.expression_surfaces.expression_graph.arena.identities.binding_syntax_ids[target] = analysis.local_bindings.node_ids[foreign_local]; }
    if mutation == 31 { analysis.expression_surfaces.expression_graph.arena.identities.binding_kinds[target] = SemanticExpressionBindingDeclaredCallable(); }
    if mutation == 32 { analysis.assignments.function_node_ids[assignment] = analysis.local_bindings.function_node_ids[foreign_local]; }
    if mutation == 33 { analysis.expression_surfaces.expression_graph.arena.identities.binding_syntax_ids[value] = foreign_formal; }
    if mutation == 34 { analysis.expression_surfaces.expression_graph.arena.identities.binding_ordinals[value] = 99; }
    if mutation == 35 { bundle.assignment_types.target_type_names[assignment] = "Int"; }
    if mutation == 36 { analysis.expression_surfaces.expression_graph.has_roots[(surface * 3) + AstExpressionLaneValue()] = false; }
    let facts: SemanticAstCollectionDefinitionFacts = SemanticAstCollectionDefinitionFactsFromResolvedFacts(
        artifact, analysis.signatures, analysis.local_bindings, bundle.initializer_types.inferred_type_names,
        analysis.expression_surfaces, analysis.assignments, bundle.assignment_types);
    if mutation >= 27 && mutation <= 32 || mutation >= 35 { return !facts.ok; }
    if !facts.ok || facts.surface_rows[surface] < facts.local_count { return false; }
    let definition: Int = facts.surface_rows[surface];
    if mutation == 33 || mutation == 34 { return facts.own_sources[definition] == 0 && !facts.fresh[definition]; }
    return facts.syntax_ids[definition] == syntax && facts.target_nodes[definition] == target &&
        facts.value_nodes[definition] == value && facts.own_sources[definition] > 0 && facts.fresh[definition] &&
        facts.origins[definition] == SemanticAstCollectionOriginUnknown() && facts.ownerships[definition] == SemanticAstCollectionOwnershipUnknown();
}

// Fresh exact-ID unit projection, not forged final-artifact admission evidence.
func InspectOwnArgumentOccurrenceOrder(
    artifact: AstTreeArtifact, ref analysis: SemanticAstArtifactAnalysis,
    ref bundle: SemanticAstBodyTypeBundle, mutation: Int
) -> Bool {
    let own_target: Int = 0;
    let read_target: Int = 0;
    let caller: Int = 0;
    let formal: Int = 0;
    let row: Int = 0;
    while row < ArrayLength(analysis.signatures.names) {
        if analysis.signatures.names[row] == "OwnFirst" { own_target = analysis.signatures.function_node_ids[row]; }
        if analysis.signatures.names[row] == "ReadFirst" { read_target = analysis.signatures.function_node_ids[row]; }
        if analysis.signatures.names[row] == "Forward" {
            caller = analysis.signatures.function_node_ids[row];
            let source: Option<Int> = SemanticAstFunctionParamNodeAt(analysis.signatures, row, 0);
            if !IsSome(source) { return false; }
            formal = UnwrapOption(source);
        }
        row = row + 1;
    }
    let syntax: Int = 0;
    row = 0;
    while row < ArrayLength(analysis.local_bindings.node_ids) {
        if analysis.local_bindings.function_node_ids[row] == caller { syntax = analysis.local_bindings.node_ids[row]; }
        row = row + 1;
    }
    if own_target <= 0 || read_target <= 0 || caller <= 0 || formal <= 0 || syntax <= 0 { return false; }
    let kinds: Array<Int> = [0, 17, 0, 17, 0, 18, 0, 18, 18];
    let texts: Array<String> = ["OwnFirst", "OwnFirst", "ArrayLength", "ArrayLength",
        "values", "ArrayLength(values)", "values", "OwnFirst(values)", "OwnFirst(values, ArrayLength(values))"];
    let left: Array<Int> = [-1, 0, -1, 2, -1, 3, -1, 1, 7];
    let right: Array<Int> = [-1, -1, -1, -1, -1, 4, -1, 6, 5];
    let targets: Array<Int> = [0, own_target, 0, 0, 0, 0, 0, 0, 0];
    let binding_ids: Array<Int> = [own_target, 0, 0, 0, formal, 0, formal, 0, 0];
    let binding_kinds: Array<Int> = [2, 0, 0, 0, 1, 0, 1, 0, 0];
    let ordinals: Array<Int> = [-1, -1, -1, -1, 0, -1, 0, -1, -1];
    let target_kinds: Array<Int> = [0, 3, 0, 3, 0, 0, 0, 0, 0];
    let names: Array<String> = ["", "OwnFirst", "", "ArrayLength", "", "", "", "", ""];
    let root: Int = 8;
    if mutation == 23 {
        kinds = [0, 17, 0, 17, 0, 18, 18, 18];
        texts = ["OwnFirst", "OwnFirst", "ArrayLength", "ArrayLength",
            "values", "ArrayLength(values)", "OwnFirst(values)", "OwnFirst(values, ArrayLength(values))"];
        left = [-1, 0, -1, 2, -1, 3, 1, 6];
        right = [-1, -1, -1, -1, -1, 4, 4, 5];
        targets = [0, own_target, 0, 0, 0, 0, 0, 0];
        binding_ids = [own_target, 0, 0, 0, formal, 0, 0, 0];
        binding_kinds = [2, 0, 0, 0, 1, 0, 0, 0];
        ordinals = [-1, -1, -1, -1, 0, -1, -1, -1];
        target_kinds = [0, 3, 0, 3, 0, 0, 0, 0];
        names = ["", "OwnFirst", "", "ArrayLength", "", "", "", ""];
        root = 7;
    }
    if mutation == 24 { right[5] = 5; }
    if mutation == 25 {
        right[7] = 5; right[8] = 6;
        targets[1] = read_target; binding_ids[0] = read_target;
        names[1] = "ReadFirst"; texts[0] = "ReadFirst"; texts[1] = "ReadFirst";
        texts[7] = "ReadFirst(ArrayLength(values))"; texts[8] = "ReadFirst(ArrayLength(values), values)";
    }
    let arena: SemanticExpressionGraphArena = SemanticExpressionGraphArenaFromTopology(
        AstExpressionArena(kinds, texts, left, right), texts, target_kinds, names,
        texts, target_kinds);
    let runtime_ids: Array<Int> = [];
    row = 0;
    while row < ArrayLength(kinds) { ArrayPush(runtime_ids, 0); row = row + 1; }
    arena.identities = SemanticExpressionIdentityRows(targets, runtime_ids, binding_ids, binding_kinds, ordinals);
    let graph: SemanticExpressionGraphFacts = SemanticExpressionGraphFacts(true, [root, 0, 0], [true, false, false], arena);
    let projected: SemanticAstExpressionSurfaceFacts = SemanticAstExpressionSurfaceFacts(
        true, -1, "", artifact.count, [syntax], [caller], [-1],
        [true], ["candidate"], [false], [""], [false], [""], ["candidate"], [""], [""], [], graph);
    let proved: HashMap<String, Int> = MapNew();
    let definitions: SemanticAstCollectionDefinitionFacts = SemanticAstCollectionDefinitionFactsFromResolvedFacts(
        artifact, analysis.signatures, analysis.local_bindings, bundle.initializer_types.inferred_type_names,
        projected, analysis.assignments, bundle.assignment_types);
    let verdict: SemanticAstCollectionOwnedArgumentUse = SemanticAstCollectionFirstInvalidOwnedArgumentUse(
        artifact, analysis.signatures, analysis.local_bindings, bundle.initializer_types.inferred_type_names, projected, definitions, proved);
    if mutation == 24 { return verdict.found && verdict.diagnostic_code == "ast_artifact_invalid"; }
    if mutation == 25 { return !verdict.found; }
    return verdict.found && verdict.diagnostic_code == "move_from_released" &&
        verdict.boundary == "owned_argument_use_after_move" && verdict.syntax_node_id == syntax &&
        verdict.expression_node_id == 4;
}
