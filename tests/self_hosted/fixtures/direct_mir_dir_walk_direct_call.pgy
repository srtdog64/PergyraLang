func DirectMirDirWalkFixtureDir() -> String {
    return ".tmp/self_hosted/direct_mir_scalar_dir_walk_direct_call/tree";
}

func Main() -> Void {
    let files: Array<String> = DirWalk(DirectMirDirWalkFixtureDir());
    WriteFile(".tmp/self_hosted/direct_mir_scalar_dir_walk_direct_call/tree/written.txt", "written");
    Log(ToString(ArrayLength(files)));
}
