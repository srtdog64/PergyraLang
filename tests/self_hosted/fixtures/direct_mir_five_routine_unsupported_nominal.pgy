// Historical path: Metadata is an ABI-free logical record whose Option<Int>
// terminal field must join the canonical Option receipt before target emission.

struct Pair {
    left: Int;
    right: Int;
}

struct Metadata {
    ready: Bool;
    optional_count: Option<Int>;
}

func Keep(value: Pair) -> Pair {
    return value;
}

func KeepMetadata(value: Metadata) -> Metadata {
    return value;
}

func Leaf(value: Int) -> Int {
    return value + 1;
}

func Relay(value: Int) -> Int {
    return Leaf(value) + 2;
}

func Main() -> Void {
    Log(Relay(8));
}
