func Build() -> Array<String> {
    var values: Array<String> = [];
    ArrayPushOwnedString(values, Concat("a", "b"));
    ArrayPushOwnedString(values, "fixed");
    return values;
}

func Main() -> Void {
    let values: Array<String> = Build();
    Log(ArrayLength(values));
    Log(values[0]);
    Log(values[1]);
}
