import "../../../src/self_hosted/codegen/text/owned_string_join_owner.pgy";
struct Emission { body: String; cleanup: String; }
func SiblingUse() -> Emission {
    let rows: Array<String> = [];
    ArrayPushOwnedString(rows, Concat("owned", "-row"));
    return Emission(CodegenJoinOwnedStringFragments(rows, ""), ToString(ArrayLength(rows)));
}
func Main() -> Void { Print(SiblingUse().body); }
