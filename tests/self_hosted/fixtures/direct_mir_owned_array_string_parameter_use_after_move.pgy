func ReleaseOwnedArray(own payload: Array<String>) -> Void {
    ArrayDropOwnedStrings(payload);
}

func Main() -> Void {
    var values: Array<String> = [];
    let marker: String = Concat("owned", "-array");
    ArrayPushOwnedString(values, marker);
    ReleaseOwnedArray(values);
    Log(ArrayLength(values));
}
