// Exact owner-handle logical-record transfer returned as the same identity.

struct ScheduleGraph {
    let valid: Bool;
    let node_count: Int;
}

struct OtherScheduleGraph {
    let valid: Bool;
    let node_count: Int;
}

func Schedule(own graph: ScheduleGraph) -> ScheduleGraph {
    return graph;
}

func Main() -> Void {
    let graph: ScheduleGraph = ScheduleGraph(true, 7);
    let scheduled: ScheduleGraph = Schedule(graph);
    if scheduled.valid {
        Log("owned-logical-record-return-ready");
    } else {
        Log("owned-logical-record-return-invalid");
    }
}
