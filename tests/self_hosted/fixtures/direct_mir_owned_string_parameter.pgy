// Exact String owner-handle reaches its explicit terminal storage consumer.
func ReleaseOwnedString(own value: String) -> Void {
    if value == "" { return; }
    let owned_values: Array<String> = [value];
    ArrayDropOwnedStrings(owned_values);
}
struct OwnedStringFact { let value: String; }
func ReleaseOwnedMember() -> Void {
    let fact: OwnedStringFact = OwnedStringFact(Concat("owned", "-member"));
    ReleaseOwnedString(fact.value);
}
func BuildOwnedString() -> String { return Concat("owned", "-call"); }
func Main() -> Void {
    let value: String = Concat("owned", "-string");
    ReleaseOwnedString(value);
    ReleaseOwnedMember();
    ReleaseOwnedString(BuildOwnedString());
    Log("released");
}
