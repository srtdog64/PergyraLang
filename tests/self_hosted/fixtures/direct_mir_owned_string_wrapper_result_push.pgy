func MakeOwnedStringWrapper() -> String
{
    return MakeOwnedString();
}

func MakeOwnedString() -> String
{
    let resultAllocator: Allocator = AllocatorResult();
    let output: TextBuilder = TextBuilderNew(16);
    TextBuilderAppend(output, "owned-wrapper");
    let result: String = TextBuilderFinish(output, resultAllocator);
    AllocatorDestroy(resultAllocator);
    return result;
}

func Main() -> Void
{
    let values: Array<String> = [];
    ArrayPush(values, MakeOwnedStringWrapper());
    ArrayDropOwnedStrings(values);
    Log("owned-string-wrapper-result-ready");
}
