func SumWithTransfers() -> Int {
    let sum: Int = 0;
    let i: Int = 0;
    while i < 10 {
        i = i + 1;
        if i == 3 {
            continue;
        }
        if i == 8 {
            break;
        }
        sum = sum + i;
    }
    return sum;
}

func Main() -> Void {
    Log(SumWithTransfers());
}
