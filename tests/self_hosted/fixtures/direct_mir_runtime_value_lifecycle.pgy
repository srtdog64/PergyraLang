func Main() -> Void {
    let source: String = "runtime-value";
    let result_allocator: Allocator = AllocatorResult();
    let output: TextBuilder = TextBuilderNew(StringLength(source));
    let index: Int = 0;
    while index < StringLength(source) {
        TextBuilderAppend(output, Substring(source, index, 1));
        index = index + 1;
    }
    let result: String = TextBuilderFinish(output, result_allocator);
    let parameter_result: String = RuntimeValueFinishWithAllocator(
        "", result_allocator);
    AllocatorDestroy(result_allocator);
    Print(result);
    Log(parameter_result);
}

func RuntimeValueFinishWithAllocator(
    value: String, allocator: Allocator
) -> String {
    let output: TextBuilder = TextBuilderNew(StringLength(value));
    TextBuilderAppend(output, value);
    let result: String = TextBuilderFinish(output, allocator);
    return result;
}

func RuntimeValueLifecycleMarker() -> Int {
    return 1;
}
