func JsonTrueAt(json: String, end: Int, start: Int) -> Bool {
    return ((start + 4) == end) &&
        SubEqualsWithLen(json, end, start, 4, "true");
}

func NestedShortCircuitExit(
    left: Bool, compare: Bool, inner: Bool, json: String, end: Int
) -> Bool {
    return left || (compare !=
        (inner || SubEqualsWithLen(json, end, 0, 4, "true")));
}

func Main() -> Void {
    if JsonTrueAt("true", 4, 0) {
        Log(1);
    }
    if !JsonTrueAt("false", 5, 0) {
        Log(0);
    }
    if NestedShortCircuitExit(false, false, false, "true", 4) { Log(2); }
}
