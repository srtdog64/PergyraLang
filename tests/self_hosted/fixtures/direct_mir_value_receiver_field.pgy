class Counter {
    let n: Int;
    let cap: Int;
    let label: String;
    let on: Bool;

    func Next(self) -> Int {
        if n + 1 > cap {
            return cap;
        }
        return n + 1;
    }

    func Describe(self) -> String {
        if on {
            return Concat(label, ToString(self.Next()));
        }
        return label;
    }
}

func Steps(start: Int, steps: Int) -> Int {
    var cur: Int = start;
    var i: Int = 0;
    while i < steps {
        let c: Counter = Counter(cur, 7, "c", true);
        cur = c.Next();
        i = i + 1;
    }
    return cur;
}

func Main() -> Void {
    Log(Steps(0, 5));
    Log(Steps(5, 9));
    let shown: Counter = Counter(2, 9, "n=", true);
    Log(shown.Describe());
    let hidden: Counter = Counter(2, 9, "off", false);
    Log(hidden.Describe());
}
