import "../../../src/self_hosted/compiler/direct_mir/scalar_program/direct_mir_scalar_program_expression_readiness_owner.pgy";
import "../../../src/self_hosted/compiler/direct_mir/scalar_program/direct_mir_scalar_program_builtin_runtime_call_identity_owner.pgy";

// Each admission sees the current altered inputs, independently of any Clone
// the compiler inserts when constructing the normalized aggregate value.
func EffectNodeReady(ref kinds: Array<Int>, ref types: Array<String>,
    ref rights: Array<Int>, ref abi_ids: Array<Int>, node: Int) -> Bool {
    let lefts: Array<Int> = [-1, -1, 0, 0, -1, 4, 4];
    let locals: Array<Int> = [-1, -1, -1, -1, 0, -1, -1];
    let absent: Array<Int> = [-1, -1, -1, -1, -1, -1, -1];
    let literals: Array<String> = ["1", "2", "", "", "", "", ""];
    let empty: Array<Int> = [];
    let nary: DirectMirScalarProgramNaryOperands = DirectMirScalarProgramNaryOperands(true, empty, empty, empty, empty);
    let facts: DirectMirScalarProgramExpressionSet = DirectMirScalarProgramExpressionSet(true, 0,
        empty, empty, empty, empty, kinds, types, lefts, rights, locals, absent, absent, literals, absent, abi_ids, nary);
    return DirectMirScalarProgramExpressionNodeReady(facts, node);
}

func Main() -> Void {
    var kinds: Array<Int> = [DirectMirScalarProgramExprIntLiteral(), DirectMirScalarProgramExprIntLiteral(),
        DirectMirScalarProgramExprCheckedAddInt(), DirectMirScalarProgramExprCheckedMulInt(),
        DirectMirScalarProgramExprLocal(), DirectMirScalarProgramExprArrayIntSort(), DirectMirScalarProgramExprArrayReverse()];
    var types: Array<String> = ["Int", "Int", "Int", "Int", "Array<Int>", "Array<Int>", "Array<Int>"];
    var rights: Array<Int> = [-1, -1, 1, 1, -1, -1, -1];
    var abi_ids: Array<Int> = [-1, -1,
        DirectMirScalarProgramCheckedIntRuntimeFact(kinds[2]).runtime_call_abi_id,
        DirectMirScalarProgramCheckedIntRuntimeFact(kinds[3]).runtime_call_abi_id, -1,
        DirectMirScalarProgramArrayTransformRuntimeFact(kinds[5], types[5]).runtime_call_abi_id,
        DirectMirScalarProgramArrayTransformRuntimeFact(kinds[6], types[6]).runtime_call_abi_id];
    Log(EffectNodeReady(kinds, types, rights, abi_ids, 2));
    Log(EffectNodeReady(kinds, types, rights, abi_ids, 3));
    Log(EffectNodeReady(kinds, types, rights, abi_ids, 5));
    Log(EffectNodeReady(kinds, types, rights, abi_ids, 6));
    abi_ids[2] = -1;
    Log(!EffectNodeReady(kinds, types, rights, abi_ids, 2));
    abi_ids[2] = abi_ids[3];
    Log(!EffectNodeReady(kinds, types, rights, abi_ids, 2));
    types[1] = "Long";
    Log(!EffectNodeReady(kinds, types, rights, abi_ids, 3));
    types[1] = "Int"; rights[3] = 3;
    Log(!EffectNodeReady(kinds, types, rights, abi_ids, 3));
    rights[3] = 1; abi_ids[5] = abi_ids[6];
    Log(!EffectNodeReady(kinds, types, rights, abi_ids, 5));
    types[4] = "Array<Long>";
    Log(!EffectNodeReady(kinds, types, rights, abi_ids, 6));
    let checked: DirectMirScalarProgramBuiltinSignatureFact = DirectMirScalarProgramBuiltinSignatureFactFromName("CheckedAdd");
    let transform: DirectMirScalarProgramBuiltinSignatureFact = DirectMirScalarProgramBuiltinSignatureFactFromName("ArrayReverse");
    Log(DirectMirScalarProgramBuiltinRuntimeCallIdentityReady(checked, 0));
    Log(!DirectMirScalarProgramBuiltinRuntimeCallIdentityReady(transform, 0));
    Log(!DirectMirScalarProgramBuiltinRuntimeCallIdentityReady(checked, checked.runtime_call_abi_id));
    Log(!DirectMirScalarProgramBuiltinRuntimeCallIdentityReady(transform, transform.runtime_call_abi_id));
    types[4] = "Array<Int>"; kinds[4] = DirectMirScalarProgramExprParameter();
    Log(!EffectNodeReady(kinds, types, rights, abi_ids, 6));
    kinds[4] = DirectMirScalarProgramExprLocal(); rights[6] = 1;
    Log(!EffectNodeReady(kinds, types, rights, abi_ids, 6));
    rights[6] = -1; types[4] = "Array<String>"; types[6] = "Array<String>";
    let string_abi: Int = DirectMirScalarProgramArrayTransformRuntimeFact(kinds[6], types[6]).runtime_call_abi_id;
    abi_ids[6] = string_abi;
    Log(EffectNodeReady(kinds, types, rights, abi_ids, 6));
    abi_ids[6] = DirectMirScalarProgramArrayTransformRuntimeFact(kinds[6], "Array<Int>").runtime_call_abi_id;
    Log(!EffectNodeReady(kinds, types, rights, abi_ids, 6));
    abi_ids[6] = string_abi; types[4] = "Array<Bool>";
    Log(!EffectNodeReady(kinds, types, rights, abi_ids, 6));
    types[6] = "Array<Bool>";
    abi_ids[6] = DirectMirScalarProgramArrayTransformRuntimeFact(kinds[6], types[6]).runtime_call_abi_id;
    Log(EffectNodeReady(kinds, types, rights, abi_ids, 6));
    abi_ids[6] = string_abi;
    Log(!EffectNodeReady(kinds, types, rights, abi_ids, 6));
    Log(!DirectMirScalarProgramArrayTransformRuntimeFact(kinds[6], "Array<Long>").ok);
    let string_types: Array<String> = ["Array<String>"];
    let bool_types: Array<String> = ["Array<Bool>"];
    let long_types: Array<String> = ["Array<Long>"];
    let two_types: Array<String> = ["Array<String>", "Array<String>"];
    let no_types: Array<String> = [];
    let typed_string: DirectMirScalarProgramBuiltinSignatureFact =
        DirectMirScalarProgramArrayTransformSignatureForCall(transform, string_types);
    let typed_bool: DirectMirScalarProgramBuiltinSignatureFact =
        DirectMirScalarProgramArrayTransformSignatureForCall(transform, bool_types);
    Log(DirectMirScalarProgramBuiltinRuntimeCallIdentityReady(typed_string, 0));
    Log(DirectMirScalarProgramBuiltinRuntimeCallIdentityReady(typed_bool, 0));
    Log(!DirectMirScalarProgramBuiltinRuntimeCallIdentityReady(typed_string, typed_string.runtime_call_abi_id));
    let incomplete: DirectMirScalarProgramBuiltinSignatureFact =
        DirectMirScalarProgramArrayTransformSignatureForCall(transform, no_types);
    Log(!DirectMirScalarProgramBuiltinRuntimeCallIdentityReady(incomplete, 0));
    Log(!DirectMirScalarProgramArrayTransformSignatureForCall(transform, two_types).valid);
    Log(!DirectMirScalarProgramArrayTransformSignatureForCall(transform, long_types).valid);
    let sort: DirectMirScalarProgramBuiltinSignatureFact = DirectMirScalarProgramBuiltinSignatureFactFromName("ArraySort");
    Log(!DirectMirScalarProgramArrayTransformSignatureForCall(sort, string_types).valid);
    abi_ids[6] = -1;
    Log(!EffectNodeReady(kinds, types, rights, abi_ids, 6));
}
