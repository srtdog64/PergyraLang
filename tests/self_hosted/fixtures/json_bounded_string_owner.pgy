// Executable contract for exact-bound JSON string materialization.

import "../../../src/self_hosted/lib/json.pgy";
import "../../../src/self_hosted/lib/json_bounded_fact_read.pgy";

func JsonBoundedStringEquals(
    encoded: String,
    expected: String,
    expected_end: Int
) -> Bool {
    let end: Array<Int> = [0];
    let actual: String = ReadJsonStringBounded(
        encoded, 0, StringLength(encoded), end
    );
    return actual == expected && end[0] == expected_end;
}

func Main() -> Void {
    let failures: Int = 0;
    let plain: String = "\"routine_name\"";
    if !JsonBoundedStringEquals(
        plain, "routine_name", StringLength(plain)
    ) { failures = failures + 1; }

    let escaped: String = "\"line\\nquote\\\"slash\\\\x\"";
    if !JsonBoundedStringEquals(
        escaped, "line\nquote\"slash\\x", StringLength(escaped)
    ) { failures = failures + 1; }

    let empty: String = "\"\"";
    if !JsonBoundedStringEquals(empty, "", 2) {
        failures = failures + 1;
    }

    let truncated_end: Array<Int> = [0];
    if ReadJsonStringBounded(
        plain, 0, StringLength(plain) - 1, truncated_end
    ) != "" || truncated_end[0] != 0 {
        failures = failures + 1;
    }

    let array_with_suffix: String = "xx[\"a\",\"b\\n\",\"\"]tail";
    let array_end: Int = StringLength(array_with_suffix) - 4;
    if JsonArrayStringCount(array_with_suffix, 2, array_end) != 3 ||
        JsonArrayStringAt(array_with_suffix, 2, array_end, 0) != "a" ||
        JsonArrayStringAt(array_with_suffix, 2, array_end, 1) != "b\n" ||
        JsonArrayStringAt(array_with_suffix, 2, array_end, 2) != "" {
        failures = failures + 1;
    }

    let missing_comma: String = "[\"a\" \"b\"]";
    let leading_comma: String = "[,\"a\"]";
    let trailing_comma: String = "[\"a\",]";
    let non_string: String = "[\"a\",1]";
    if JsonArrayStringCount(
            missing_comma, 0, StringLength(missing_comma)
        ) != 0 || JsonArrayStringCount(
            leading_comma, 0, StringLength(leading_comma)
        ) != 0 || JsonArrayStringCount(
            trailing_comma, 0, StringLength(trailing_comma)
        ) != 0 || JsonArrayStringCount(
            non_string, 0, StringLength(non_string)
        ) != 0 || JsonArrayStringCount(
            array_with_suffix, 2, array_end - 1
        ) != 0 {
        failures = failures + 1;
    }

    if failures == 0 {
        Log("json-bounded-string-owner-ok");
    } else {
        Log(Concat("json-bounded-string-owner-failures=", ToString(failures)));
        Exit(1);
    }
}
