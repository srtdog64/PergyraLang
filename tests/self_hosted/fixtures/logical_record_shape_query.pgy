// Bounded calls into the real record query owner, not external-MIR admission.
import "../../../src/self_hosted/compiler/direct_mir_scalar_program_logical_record_expression_owner.pgy";
import "../../../src/self_hosted/compiler/direct_mir_scalar_program_expression_kind_id_owner.pgy";

func QueryRecord(fields: Int, corruption: Int) -> DirectMirScalarProgramLogicalRecordFact {
    let rows: Array<Int> = [7];
    let names: Array<String> = ["Record"];
    let syntax: Array<Int> = [31];
    let starts: Array<Int> = [0];
    let counts: Array<Int> = [fields];
    let field_names: Array<String> = [];
    let field_types: Array<String> = [];
    let field_ids: Array<Int> = [];
    let field_enums: Array<Int> = [];
    let field: Int = 0;
    while field < fields {
        ArrayPush(field_names, Concat("field", ToString(field)));
        ArrayPush(field_types, "Int");
        let id: Int = 1001 + field;
        if corruption == 2 && field == fields - 1 { id = 1001; }
        ArrayPush(field_ids, id);
        ArrayPush(field_enums, 0);
        field = field + 1;
    }
    let absence: DirectMirNominalDeclarationAbiFact = InvalidDirectMirNominalDeclarationAbiFact();
    let physical: DirectMirScalarProgramRecordAbiCarriage =
        DirectMirScalarProgramRecordAbiCarriageFromDeclaration(absence, fields);
    if corruption == 3 {
        let bad_sizes: Array<Int> = [];
        field = 0;
        while field < fields {
            let size: Int = 0;
            if field == 0 { size = 4; }
            ArrayPush(bad_sizes, size);
            field = field + 1;
        }
        physical = DirectMirScalarProgramRecordAbiCarriage(physical.layout_ids,
            physical.row_keys, physical.sizes, physical.aligns,
            physical.field_offsets, bad_sizes, physical.field_aligns);
    }
    let source: DirectMirScalarProgramLogicalRecordFact = DirectMirScalarProgramLogicalRecordFact(
        true, 0, true, rows, names, syntax, starts, counts,
        field_names, field_types, field_ids, field_enums, physical);
    let digest: Int = DirectMirScalarProgramLogicalRecordFactDigest(source);
    if corruption == 1 {
        if digest == 1 { digest = 2; } else { digest = 1; }
    }
    return DirectMirScalarProgramLogicalRecordFact(true, digest, true,
        rows, names, syntax, starts, counts,
        field_names, field_types, field_ids, field_enums, physical);
}

func QuerySequence() -> MirExpressionGraphSequence {
    let leaf: Int = AstExpressionNodeLeaf();
    let member: Int = AstExpressionNodeMemberAccess();
    let integer: Int = AstExpressionNodeIntegerLiteral();
    let kinds: Array<Int> = [leaf,leaf,member,integer,leaf,integer,leaf,member,leaf];
    let texts: Array<String> = ["value","field0","value.field0","7","plain","8","missing","value.missing","tail"];
    let lefts: Array<Int> = [0,0,0,0,0,0,0,0,0];
    let rights: Array<Int> = [0,0,1,0,0,0,0,6,0];
    let targets: Array<Int> = [0,0,0,0,0,0,0,0,0];
    let target_names: Array<String> = ["","","","","","","","",""];
    let roots: Array<Int> = [7];
    return MirExpressionGraphSequence(true, 1, roots,
        SemanticExpressionGraphArenaUnclassified(kinds, texts, lefts, rights, targets, target_names));
}

func MissingMember(ref value: DirectMirScalarProgramLogicalRecordExpressionFact) -> Bool {
    return !value.recognized && !value.valid && !value.complete &&
        value.kind == 0 && value.type_name == "" &&
        ArrayLength(value.argument_rows) == 0 && value.call_node == -1 &&
        value.left_row == -1 && value.member_ordinal == -1;
}

func QueryControls() -> Void {
    let sequence: MirExpressionGraphSequence = QuerySequence();
    let rows: Array<Int> = [0,-1,-1,-1,-1,-1,-1,-1,-1];
    let types: Array<String> = ["Record"];
    let record: DirectMirScalarProgramLogicalRecordFact = QueryRecord(4, 0);
    Log(ToString(SemanticExpressionGraphArenaReady(sequence.arena)));
    Log(ToString(DirectMirScalarProgramLogicalRecordFactReady(record)));
    Log(ToString(DirectMirScalarProgramLogicalRecordMemberMarkerReady(sequence, 1, "", record)));
    Log(ToString(DirectMirScalarProgramLogicalRecordMemberMarkerReady(sequence, 1, "Record", record)));
    Log(ToString(DirectMirScalarProgramLogicalRecordMemberMarkerReady(sequence, 1, "Other", record)));
    Log(ToString(DirectMirScalarProgramLogicalRecordMemberMarkerReady(sequence, 6, "Record", record)));
    let valid: DirectMirScalarProgramLogicalRecordExpressionFact =
        DirectMirScalarProgramLogicalRecordMemberFromGraph(sequence, 2, rows, types, record);
    Log(ToString(valid.recognized && valid.valid && valid.complete &&
        valid.kind == DirectMirScalarProgramExprLogicalRecordMember() &&
        valid.type_name == "Int" && valid.left_row == 0 && valid.member_ordinal == 0));
    let absent: DirectMirScalarProgramLogicalRecordExpressionFact =
        DirectMirScalarProgramLogicalRecordMemberFromGraph(sequence, 7, rows, types, record);
    Log(ToString(absent.recognized && !absent.valid && !absent.complete));
    let nonmembers: Array<Int> = [-1,3,4,8,9];
    let i: Int = 0;
    while i < ArrayLength(nonmembers) {
        let node: Int = nonmembers[i];
        let value: DirectMirScalarProgramLogicalRecordExpressionFact =
            DirectMirScalarProgramLogicalRecordMemberFromGraph(sequence, node, rows, types, record);
        Log(ToString(!DirectMirScalarProgramLogicalRecordMemberMarkerReady(sequence, node, "", record) && MissingMember(value)));
        i = i + 1;
    }
    let corruption: Int = 1;
    while corruption <= 3 {
        record = QueryRecord(4, corruption);
        let rejected: DirectMirScalarProgramLogicalRecordExpressionFact =
            DirectMirScalarProgramLogicalRecordMemberFromGraph(sequence, 2, rows, types, record);
        Log(ToString(!DirectMirScalarProgramLogicalRecordFactReady(record) &&
            !DirectMirScalarProgramLogicalRecordMemberMarkerReady(sequence, 1, "Record", record) && MissingMember(rejected)));
        corruption = corruption + 1;
    }
    record = DirectMirScalarProgramLogicalRecordFactCanonicalEmpty();
    let empty: DirectMirScalarProgramLogicalRecordExpressionFact =
        DirectMirScalarProgramLogicalRecordMemberFromGraph(sequence, 2, rows, types, record);
    Log(ToString(DirectMirScalarProgramLogicalRecordFactReady(record) &&
        !DirectMirScalarProgramLogicalRecordMemberMarkerReady(sequence, 1, "", record) && MissingMember(empty)));
}

func QueryPressure(fields: Int) -> Void {
    let record: DirectMirScalarProgramLogicalRecordFact = QueryRecord(fields, 0);
    let sequence: MirExpressionGraphSequence = QuerySequence();
    let rows: Array<Int> = [0,-1,-1,-1,-1,-1,-1,-1,-1];
    let types: Array<String> = ["Record"];
    if !DirectMirScalarProgramLogicalRecordFactReady(record) { Exit(1); }
    let i: Int = 0;
    while i < 512 {
        let integer: DirectMirScalarProgramLogicalRecordExpressionFact =
            DirectMirScalarProgramLogicalRecordMemberFromGraph(sequence, 3, rows, types, record);
        let leaf: DirectMirScalarProgramLogicalRecordExpressionFact =
            DirectMirScalarProgramLogicalRecordMemberFromGraph(sequence, 4, rows, types, record);
        if DirectMirScalarProgramLogicalRecordMemberMarkerReady(sequence, 3, "", record) ||
            DirectMirScalarProgramLogicalRecordMemberMarkerReady(sequence, 4, "", record) ||
            !MissingMember(integer) || !MissingMember(leaf) { Exit(1); }
        i = i + 1;
    }
    Log("2048 noncandidate queries preserved");
}

func Main() -> Void {
    let args: Array<String> = Args();
    if ArrayLength(args) == 1 {
        let fields: Int = 0;
        if args[0] == "small" { fields = 32; }
        if args[0] == "medium" { fields = 64; }
        if args[0] == "large" { fields = 128; }
        if fields == 0 { Log("unknown query size"); Exit(1); }
        QueryPressure(fields);
        return;
    }
    if ArrayLength(args) != 0 { Log("expected zero or one argument"); Exit(1); }
    QueryControls();
}
