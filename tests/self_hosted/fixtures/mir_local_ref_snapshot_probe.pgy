import "../../../src/self_hosted/mir/local_ref_fact_owner.pgy";

func Main() -> Void {
    let kinds: Array<Int> = [AstExpressionNodeLeaf()];
    let texts: Array<String> = ["value"];
    let edges: Array<Int> = [-1];
    let zeros: Array<Int> = [0];
    let empty_text: Array<String> = [""];
    let graph: SemanticExpressionGraphFacts = SemanticExpressionGraphFacts(
        true, [0], [true], SemanticExpressionGraphArena(
            AstExpressionArena(kinds, texts, edges, edges), texts,
            zeros, empty_text, empty_text,
            SemanticExpressionIdentityRowsUnknown(1), zeros));
    let view: SemanticExpressionGraphView = SemanticExpressionGraphView(true, 0, graph);
    let names: Array<String> = [];
    ArrayPushOwnedString(names, "value");
    ArrayPushOwnedString(names, "value");
    let refs: Array<String> = [];
    ArrayPushOwnedString(refs, "parameter:100:0");
    ArrayPushOwnedString(refs, "declaration:200:0");
    let versions: Array<Int> = [0, 1];
    let row: SelfMirInstructionLocalRefRows =
        SelfMirInstructionLocalRefRowsAppendInstruction(SelfMirInstructionLocalRefRowsEmpty());
    let shadowed: SelfMirInstructionLocalRefRows =
        SelfMirInstructionLocalRefRowsAttachExpr0(row, view, names, versions, refs);
    if shadowed.expr0_counts[0] != 0 || ArrayLength(shadowed.expr0_refs) != 0 { Exit(1); }
    ArraySet(versions, 1, 0);
    let empty_refs: Array<String> = [];
    let malformed: SelfMirInstructionLocalRefRows =
        SelfMirInstructionLocalRefRowsAttachExpr0(row, view, names, versions, empty_refs);
    if malformed.expr0_counts[0] != 0 || ArrayLength(malformed.expr0_refs) != 0 { Exit(1); }
    let attached: SelfMirInstructionLocalRefRows =
        SelfMirInstructionLocalRefRowsAttachExpr0(row, view, names, versions, refs);
    attached = SelfMirInstructionLocalRefRowsAttachPrimary(attached, "declaration:300:0");
    let repeated: SelfMirInstructionLocalRefRows =
        SelfMirInstructionLocalRefRowsAttachExpr0(attached, view, names, versions, refs);
    ArrayDropOwnedStrings(names);
    ArrayDropOwnedStrings(refs);
    ArrayDropOwnedStrings(empty_refs);
    // This oracle checks retained String text, not numeric scratch retirement.
    if attached.expr0_counts[0] != 1 || attached.expr0_nodes[0] != 0 ||
        attached.expr0_refs[0] != "declaration:200:0" ||
        attached.primary_refs[0] != "declaration:300:0" ||
        ArrayLength(repeated.expr0_refs) != 1 { Exit(1); }
    let prefix: SelfMirInstructionLocalRefRows =
        SelfMirInstructionLocalRefRowsAppendInstruction(SelfMirInstructionLocalRefRowsEmpty());
    let prefix_names: Array<String> = ["value"];
    let prefix_versions: Array<Int> = [0];
    let prefix_refs: Array<String> = ["parameter:99:0"];
    prefix = SelfMirInstructionLocalRefRowsAttachExpr0(
        prefix, view, prefix_names, prefix_versions, prefix_refs);
    let appended: SelfMirInstructionLocalRefRows = SelfMirInstructionLocalRefRowsAppendRows(prefix, attached);
    if ArrayLength(appended.primary_refs) != 2 || appended.primary_refs[0] != "" ||
        appended.primary_refs[1] != "declaration:300:0" ||
        appended.expr0_starts[1] != 1 || appended.expr0_counts[1] != 1 ||
        appended.expr0_nodes[0] != 0 || appended.expr0_refs[0] != "parameter:99:0" ||
        appended.expr0_nodes[1] != 0 || appended.expr0_refs[1] != "declaration:200:0" { Exit(1); }
    Log("MIR LOCAL REF SNAPSHOT PASS");
}
