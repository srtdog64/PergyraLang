// Loop result flags the self-host MIR producer carries from the semantic flow
// calculus: FALLTHROUGH (1) unless the loop cannot leave normally, plus
// RETURN (8) when its body may leave the routine.

// A while loop that may return: 9.
func FirstAbove(limit: Int) -> Int {
    var i: Int = 0;
    while i < 10 {
        if i > limit {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// The inner loop's return reaches the outer loop's flags: 9 and 9.
func NestedFind(rows: Int, cols: Int) -> Int {
    var r: Int = 0;
    while r < rows {
        var c: Int = 0;
        while c < cols {
            if r * c == 6 {
                return r * 10 + c;
            }
            c = c + 1;
        }
        r = r + 1;
    }
    return 0 - 1;
}

// while true left by a break falls through: 1.
func BreakOut() -> Int {
    var total: Int = 0;
    while true {
        total = total + 3;
        if total > 10 {
            break;
        }
    }
    return total;
}

// Native tracks the Array local as a resource-flow symbol; the self-host
// producer marks this routine's flow state as not carried: 9.
func SumUntil(limit: Int) -> Int {
    let values: Array<Int> = [4, 8, 15, 16, 23, 42];
    var total: Int = 0;
    for v in values {
        if total > limit {
            return total;
        }
        total = total + v;
    }
    return total;
}

func Main() -> Void {
    Log(FirstAbove(3));
    Log(FirstAbove(20));
    Log(NestedFind(4, 4));
    Log(NestedFind(1, 1));
    Log(BreakOut());
    Log(SumUntil(20));
    Log(SumUntil(500));
}
