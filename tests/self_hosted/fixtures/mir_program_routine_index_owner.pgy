// Executable contract for the flattened MIR program routine structure index.

import "../../../src/self_hosted/mir_lower/program_routine_index_owner.pgy";
import "../../../src/self_hosted/mir_lower/routine_instruction_view_owner.pgy";
import "../../../src/self_hosted/mir_lower/routine_fact_index_owner.pgy";
import "../../../src/self_hosted/mir_lower/abi_layout_fact_owner.pgy";

func MirProgramRoutineIndexJsonReady(json: String) -> Bool {
    let document: MirDocumentFactIndex = BuildMirDocumentFactIndex(json);
    if !document.valid { return false; }
    let index: MirProgramRoutineIndex =
        BuildMirProgramRoutineIndexFromTable(document.routines);
    return MirProgramRoutineIndexStructureReady(index);
}

func Main() -> Void {
    let failures: Int = 0;
    let abi_validation: MirAbiLayoutValidationSession =
        NewMirAbiLayoutValidationSession();
    let first_instruction: String =
        "{\"kind\":\"def\",\"source_type\":\"AST_LET_DECL\",\"result\":\"%0\",\"expr0\":\"1\",\"expr1\":null,\"arg0\":\"x\",\"arg1\":\"\",\"slot_anchor\":\"slot\",\"abi_type_name\":\"Int\",\"abi_layout_id\":0,\"abi_layout_required\":false,\"abi_layout\":null,\"match_variant\":\"Some\",\"payload\":{\"kind\":\"wrong\",\"source_type\":\"wrong\",\"expr0\":\"wrong\",\"machine_layer\":{}},\"machine_contact_kind\":\"\",\"machine_layer\":null}";
    let second_instruction: String =
        "{\"kind\":\"stmt\",\"source_type\":\"AST_CALL\",\"abi_type_name\":null,\"abi_layout_id\":0,\"abi_layout_required\":false,\"abi_layout\":null,\"machine_layer\":{\"operation\":\"x\"},\"machine_contact_kind\":\"x\"}";
    let third_instruction: String =
        "{\"kind\":\"phi\",\"source_type\":null,\"abi_type_name\":null,\"abi_layout_id\":0,\"abi_layout_required\":false,\"abi_layout\":null,\"machine_contact_kind\":null,\"machine_layer\":null}";
    let first_block: String = Concat(
        "{\"id\":0,\"instructions\":[",
        Concat(first_instruction, Concat(",", Concat(second_instruction, "]}")))
    );
    let second_block: String = Concat(
        "{\"id\":0,\"instructions\":[", Concat(third_instruction, "]}")
    );
    let empty_block: String = "{\"id\":1,\"instructions\":[]}";
    let first_routine: String = Concat(
        "{\"kind\":\"function\",\"name\":\"A\",\"blocks\":[",
        Concat(first_block, "]}")
    );
    let second_routine: String = Concat(
        "{\"kind\":\"method\",\"owner\":\"Box\",\"name\":\"Ping\",\"blocks\":[",
        Concat(second_block, Concat(",", Concat(empty_block, "]}")))
    );
    let prefix: String =
        "{\"schema\":\"pgy.mir.v1\",\"decls\":[],\"parallel_capture_boundaries\":[],\"routines\":[";
    let json: String = Concat(
        prefix, Concat(first_routine, Concat(",", Concat(second_routine, "]}")))
    );
    let document: MirDocumentFactIndex = BuildMirDocumentFactIndex(json);
    let index: MirProgramRoutineIndex =
        BuildMirProgramRoutineIndexFromTable(document.routines);
    if !MirProgramRoutineIndexStructureReady(index) ||
        index.source_json != json || index.source_length != StringLength(json) ||
        !MirProgramRoutineIndexRowReady(index, 0) ||
        !MirProgramRoutineIndexRowReady(index, 1) ||
        MirProgramRoutineIndexRowReady(index, 0 - 1) ||
        MirProgramRoutineIndexRowReady(index, 2) ||
        ArrayLength(index.starts) != 2 ||
        index.routine_block_starts[0] != 0 ||
        index.routine_block_counts[0] != 1 ||
        index.routine_block_starts[1] != 1 ||
        index.routine_block_counts[1] != 2 ||
        ArrayLength(index.block_starts) != 3 ||
        index.block_instruction_starts[0] != 0 ||
        index.block_instruction_counts[0] != 2 ||
        index.block_instruction_starts[1] != 2 ||
        index.block_instruction_counts[1] != 1 ||
        index.block_instruction_starts[2] != 3 ||
        index.block_instruction_counts[2] != 0 ||
        index.instruction_kinds[0] != "def" ||
        index.instruction_kinds[1] != "stmt" ||
        index.instruction_kinds[2] != "phi" ||
        index.instruction_source_types[0] != "AST_LET_DECL" ||
        index.instruction_source_types[1] != "AST_CALL" ||
        index.instruction_source_types[2] != "" {
        failures = failures + 1;
    }
    let first_view: MirRoutineInstructionView =
        MirRoutineInstructionViewAt(index, 0, 0, 0);
    let phi_selection: MirRoutineInstructionSelection =
        MirRoutineInstructionViewOfKind(index, 1, 0, "phi");
    let empty_selection: MirRoutineInstructionSelection =
        MirRoutineInstructionViewOfKind(index, 1, 1, "branch");
    let first_facts: MirRoutineFactIndex =
        BuildMirRoutineFactIndex(index, 0);
    let first_scalar: MirRoutineInstructionScalarCapture =
        MirRoutineInstructionFactBundleAtGlobal(
            first_facts.instruction_facts, first_view.global_row
        );
    if !first_view.valid || first_view.global_row != 0 ||
        first_view.kind != "def" ||
        first_view.source_type != "AST_LET_DECL" ||
        !first_facts.instruction_facts.valid || !first_scalar.valid ||
        first_scalar.result != "%0" || first_scalar.expr0 != "1" ||
        first_scalar.arg0 != "x" || first_scalar.slot_anchor != "slot" ||
        first_scalar.abi_type_name != "Int" ||
        !first_scalar.abi_type_value_ready ||
        first_scalar.match_variant != "Some" ||
        !phi_selection.valid || !phi_selection.found ||
        phi_selection.instruction.global_row != 2 ||
        phi_selection.instruction.source_type != "" ||
        !empty_selection.valid || empty_selection.found ||
        MirRoutineInstructionViewAt(index, 0 - 1, 0, 0).valid ||
        MirRoutineInstructionViewAt(index, 0, 1, 0).valid ||
        MirRoutineInstructionViewAt(index, 0, 0, 2).valid {
        failures = failures + 1;
    }
    if !MirCapturedAbiLayoutFactReady(
        json, first_scalar.abi_type_name,
        first_scalar.abi_type_value_ready,
        first_scalar.abi_type_start, first_scalar.abi_type_end,
        first_scalar.abi_layout_id_start, first_scalar.abi_layout_id_end,
        first_scalar.abi_layout_required_start,
        first_scalar.abi_layout_required_end,
        first_scalar.abi_layout_start, first_scalar.abi_layout_end,
        abi_validation
    ) {
        Log("mir-program-routine-index-owner-positive-abi-failed");
        failures = failures + 1;
    }
    let method_row: Option<Int> = MirProgramRoutineIndexFindMethodRow(
        index, "Box", "Ping"
    );
    if !IsSome(method_row) || UnwrapOption(method_row) != 1 {
        failures = failures + 1;
    }
    if JsonCharCodeAt(
        json, index.instruction_machine_layer_ends[0],
        index.instruction_machine_layer_starts[0]
    ) != JsonAsciiCode("n") || JsonCharCodeAt(
        json, index.instruction_machine_layer_ends[1],
        index.instruction_machine_layer_starts[1]
    ) != JsonAsciiCode("{") || JsonCharCodeAt(
        json, index.instruction_machine_contact_ends[1],
        index.instruction_machine_contact_starts[1]
    ) != JsonAsciiCode("\"") {
        failures = failures + 1;
    }

    let missing_successor_index: MirRoutineFactIndex =
        BuildMirRoutineFactIndex(index, 0);
    let negative_successor_routine: String =
        "{\"kind\":\"function\",\"name\":\"N\",\"source_syntax_id\":1,\"blocks\":[{\"id\":0,\"succ_true\":-1,\"instructions\":[]}]}";
    let negative_successor_json: String = Concat(
        prefix, Concat(negative_successor_routine, "]}")
    );
    let negative_successor_document: MirDocumentFactIndex =
        BuildMirDocumentFactIndex(negative_successor_json);
    let negative_successor_program: MirProgramRoutineIndex =
        BuildMirProgramRoutineIndexFromTable(negative_successor_document.routines);
    let negative_successor_index: MirRoutineFactIndex =
        BuildMirRoutineFactIndex(negative_successor_program, 0);
    if missing_successor_index.block_succ_true[0] != (0 - 1) ||
        negative_successor_index.valid ||
        negative_successor_index.validation_stage != "cfg_successor" {
        failures = failures + 1;
    }

    let scalar_routine: String = Concat(
        prefix, Concat(first_routine, Concat(",7,", Concat(second_routine, "]}")))
    );
    let scalar_block_routine: String = Concat(
        "{\"kind\":\"function\",\"name\":\"A\",\"blocks\":[",
        Concat(first_block, Concat(",7,", Concat(empty_block, "]}")))
    );
    let scalar_block: String = Concat(prefix, Concat(scalar_block_routine, "]}"));
    let scalar_instruction_block: String = Concat(
        "{\"id\":0,\"instructions\":[",
        Concat(first_instruction, Concat(",7,", Concat(second_instruction, "]}")))
    );
    let scalar_instruction_routine: String = Concat(
        "{\"kind\":\"function\",\"name\":\"A\",\"blocks\":[",
        Concat(scalar_instruction_block, "]}")
    );
    let scalar_instruction: String = Concat(
        prefix, Concat(scalar_instruction_routine, "]}")
    );
    let missing_kind: String = Concat(
        prefix,
        "{\"name\":\"A\",\"blocks\":[{\"id\":0,\"instructions\":[]}]}]}"
    );
    let missing_instructions: String = Concat(
        prefix,
        "{\"kind\":\"function\",\"name\":\"A\",\"blocks\":[{\"id\":0}]}]}"
    );
    let missing_source_type: String = Concat(
        prefix,
        "{\"kind\":\"function\",\"name\":\"A\",\"blocks\":[{\"id\":0,\"instructions\":[{\"kind\":\"def\",\"machine_contact_kind\":\"\",\"machine_layer\":null}]}]}]}"
    );
    let wrong_source_type: String = Concat(
        prefix,
        "{\"kind\":\"function\",\"name\":\"A\",\"blocks\":[{\"id\":0,\"instructions\":[{\"kind\":\"def\",\"source_type\":{},\"machine_contact_kind\":\"\",\"machine_layer\":null}]}]}]}"
    );
    let duplicate_source_type: String = Concat(
        prefix,
        "{\"kind\":\"function\",\"name\":\"A\",\"blocks\":[{\"id\":0,\"instructions\":[{\"kind\":\"def\",\"source_type\":\"AST_LET_DECL\",\"source_type\":\"AST_CALL\",\"machine_contact_kind\":\"\",\"machine_layer\":null}]}]}]}"
    );
    let duplicate_expr0: String = Concat(
        prefix,
        "{\"kind\":\"function\",\"name\":\"A\",\"blocks\":[{\"id\":0,\"instructions\":[{\"kind\":\"def\",\"source_type\":\"AST_LET_DECL\",\"expr0\":\"1\",\"expr0\":\"2\"}]}]}]}"
    );
    let wrong_expr0: String = Concat(
        prefix,
        "{\"kind\":\"function\",\"name\":\"A\",\"blocks\":[{\"id\":0,\"instructions\":[{\"kind\":\"def\",\"source_type\":\"AST_LET_DECL\",\"expr0\":{}}]}]}]}"
    );
    let missing_instruction_comma: String = Concat(
        prefix,
        "{\"kind\":\"function\",\"name\":\"A\",\"blocks\":[{\"id\":0,\"instructions\":[{\"kind\":\"def\" \"source_type\":\"AST_CALL\"}]}]}]}"
    );
    let leading_instruction_comma: String = Concat(
        prefix,
        "{\"kind\":\"function\",\"name\":\"A\",\"blocks\":[{\"id\":0,\"instructions\":[{,\"kind\":\"def\",\"source_type\":\"AST_CALL\"}]}]}]}"
    );
    let repeated_instruction_comma: String = Concat(
        prefix,
        "{\"kind\":\"function\",\"name\":\"A\",\"blocks\":[{\"id\":0,\"instructions\":[{\"kind\":\"def\",,\"source_type\":\"AST_CALL\"}]}]}]}"
    );
    let trailing_instruction_comma: String = Concat(
        prefix,
        "{\"kind\":\"function\",\"name\":\"A\",\"blocks\":[{\"id\":0,\"instructions\":[{\"kind\":\"def\",\"source_type\":\"AST_CALL\",}]}]}]}"
    );
    if MirProgramRoutineIndexJsonReady(scalar_routine) ||
        MirProgramRoutineIndexJsonReady(scalar_block) ||
        MirProgramRoutineIndexJsonReady(scalar_instruction) ||
        MirProgramRoutineIndexJsonReady(missing_kind) ||
        MirProgramRoutineIndexJsonReady(missing_instructions) ||
        MirProgramRoutineIndexJsonReady(missing_source_type) ||
        MirProgramRoutineIndexJsonReady(wrong_source_type) ||
        MirProgramRoutineIndexJsonReady(duplicate_source_type) ||
        MirProgramRoutineIndexJsonReady(missing_instruction_comma) ||
        MirProgramRoutineIndexJsonReady(leading_instruction_comma) ||
        MirProgramRoutineIndexJsonReady(repeated_instruction_comma) ||
        MirProgramRoutineIndexJsonReady(trailing_instruction_comma) {
        failures = failures + 1;
    }
    let duplicate_expr0_document: MirDocumentFactIndex =
        BuildMirDocumentFactIndex(duplicate_expr0);
    let duplicate_expr0_program: MirProgramRoutineIndex =
        BuildMirProgramRoutineIndexFromTable(
            duplicate_expr0_document.routines
        );
    let wrong_expr0_document: MirDocumentFactIndex =
        BuildMirDocumentFactIndex(wrong_expr0);
    let wrong_expr0_program: MirProgramRoutineIndex =
        BuildMirProgramRoutineIndexFromTable(wrong_expr0_document.routines);
    if BuildMirRoutineInstructionFactBundle(
            duplicate_expr0_program, 0
        ).valid ||
        BuildMirRoutineInstructionFactBundle(wrong_expr0_program, 0).valid {
        failures = failures + 1;
    }

    let same_length_non_target_row: String =
        "{\"other\":{},\"expr0\":\"kept\"}";
    let same_length_non_target: MirRoutineInstructionScalarCapture =
        MirRoutineInstructionScalarCaptureWithin(
            same_length_non_target_row, 0,
            StringLength(same_length_non_target_row)
        );
    let escaped_target_row: String = "{\"\\expr0\":\"escaped\"}";
    let escaped_target: MirRoutineInstructionScalarCapture =
        MirRoutineInstructionScalarCaptureWithin(
            escaped_target_row, 0, StringLength(escaped_target_row)
        );
    let plain_escaped_duplicate_row: String =
        "{\"expr0\":\"plain\",\"\\expr0\":\"escaped\"}";
    let plain_escaped_duplicate: MirRoutineInstructionScalarCapture =
        MirRoutineInstructionScalarCaptureWithin(
            plain_escaped_duplicate_row, 0,
            StringLength(plain_escaped_duplicate_row)
        );
    if !same_length_non_target.valid ||
        same_length_non_target.expr0 != "kept" ||
        !escaped_target.valid || escaped_target.expr0 != "escaped" ||
        plain_escaped_duplicate.valid {
        Log("mir-program-routine-index-owner-key-dispatch-failed");
        failures = failures + 1;
    }

    let wrong_abi_row: String =
        "{\"kind\":\"def\",\"source_type\":\"AST_LET_DECL\",\"abi_type_name\":null,\"abi_layout_id\":\"0\",\"abi_layout_required\":false,\"abi_layout\":null}";
    let wrong_abi: MirRoutineInstructionScalarCapture =
        MirRoutineInstructionScalarCaptureWithin(
            wrong_abi_row, 0, StringLength(wrong_abi_row)
        );
    let duplicate_abi_row: String =
        "{\"kind\":\"def\",\"source_type\":\"AST_LET_DECL\",\"abi_type_name\":null,\"abi_layout_id\":0,\"abi_layout_id\":0,\"abi_layout_required\":false,\"abi_layout\":null}";
    let duplicate_abi: MirRoutineInstructionScalarCapture =
        MirRoutineInstructionScalarCaptureWithin(
            duplicate_abi_row, 0, StringLength(duplicate_abi_row)
        );
    let wrong_abi_type_row: String =
        "{\"kind\":\"def\",\"source_type\":\"AST_LET_DECL\",\"abi_type_name\":{},\"abi_layout_id\":0,\"abi_layout_required\":false,\"abi_layout\":null}";
    let wrong_abi_type: MirRoutineInstructionScalarCapture =
        MirRoutineInstructionScalarCaptureWithin(
            wrong_abi_type_row, 0, StringLength(wrong_abi_type_row)
        );
    let required_abi_row: String =
        "{\"kind\":\"def\",\"source_type\":\"AST_LET_DECL\",\"abi_type_name\":\"Array<Int>\",\"abi_layout_id\":599770891,\"abi_layout_required\":true,\"abi_layout\":{\"type\":\"Array<Int>\",\"size\":32,\"align\":8,\"fields\":[{\"name\":\"data\",\"offset\":0,\"size\":8,\"align\":8},{\"name\":\"length\",\"offset\":8,\"size\":8,\"align\":8},{\"name\":\"capacity\",\"offset\":16,\"size\":8,\"align\":8},{\"name\":\"allocator\",\"offset\":24,\"size\":8,\"align\":8}],\"runtime_fn\":\"pgy_array_new_Int\",\"inner_c_type\":\"int32_t\",\"representation\":0,\"discriminant\":null,\"primary_tag\":0,\"secondary_tag\":0,\"niche_none_pattern\":null}}";
    let required_abi: MirRoutineInstructionScalarCapture =
        MirRoutineInstructionScalarCaptureWithin(
            required_abi_row, 0, StringLength(required_abi_row)
        );
    let mutated_required_abi_row: String = StringReplace(
        required_abi_row, "\"offset\":0", "\"offset\":1"
    );
    let mutated_required_abi: MirRoutineInstructionScalarCapture =
        MirRoutineInstructionScalarCaptureWithin(
            mutated_required_abi_row, 0,
            StringLength(mutated_required_abi_row)
        );
    let reordered_required_abi_row: String = StringReplace(
        required_abi_row,
        "\"type\":\"Array<Int>\",\"size\":32",
        "\"size\":32,\"type\":\"Array<Int>\""
    );
    let reordered_required_abi: MirRoutineInstructionScalarCapture =
        MirRoutineInstructionScalarCaptureWithin(
            reordered_required_abi_row, 0,
            StringLength(reordered_required_abi_row)
        );
    let required_abi_layout: JsonObjectFactTable =
        JsonObjectFactTableFromBounds(
            required_abi_row, required_abi.abi_layout_start,
            required_abi.abi_layout_end
        );
    if !wrong_abi.valid || !duplicate_abi.valid || !wrong_abi_type.valid ||
        wrong_abi_type.abi_type_value_ready || !required_abi.valid ||
        !mutated_required_abi.valid || !reordered_required_abi.valid ||
        MirAbiLayoutIdFromRow(required_abi_layout) != 599770891 ||
        !MirCapturedAbiLayoutFactReady(
            required_abi_row, required_abi.abi_type_name,
            required_abi.abi_type_value_ready, required_abi.abi_type_start,
            required_abi.abi_type_end, required_abi.abi_layout_id_start,
            required_abi.abi_layout_id_end,
            required_abi.abi_layout_required_start,
            required_abi.abi_layout_required_end,
            required_abi.abi_layout_start, required_abi.abi_layout_end,
            abi_validation
        ) || !MirCapturedAbiLayoutFactReady(
            reordered_required_abi_row, reordered_required_abi.abi_type_name,
            reordered_required_abi.abi_type_value_ready,
            reordered_required_abi.abi_type_start,
            reordered_required_abi.abi_type_end,
            reordered_required_abi.abi_layout_id_start,
            reordered_required_abi.abi_layout_id_end,
            reordered_required_abi.abi_layout_required_start,
            reordered_required_abi.abi_layout_required_end,
            reordered_required_abi.abi_layout_start,
            reordered_required_abi.abi_layout_end,
            abi_validation
        ) ||
        MirCapturedAbiLayoutFactReady(
            wrong_abi_row, wrong_abi.abi_type_name,
            wrong_abi.abi_type_value_ready, wrong_abi.abi_type_start,
            wrong_abi.abi_type_end, wrong_abi.abi_layout_id_start,
            wrong_abi.abi_layout_id_end,
            wrong_abi.abi_layout_required_start,
            wrong_abi.abi_layout_required_end,
            wrong_abi.abi_layout_start, wrong_abi.abi_layout_end,
            abi_validation
        ) || MirCapturedAbiLayoutFactReady(
            duplicate_abi_row, duplicate_abi.abi_type_name,
            duplicate_abi.abi_type_value_ready, duplicate_abi.abi_type_start,
            duplicate_abi.abi_type_end, duplicate_abi.abi_layout_id_start,
            duplicate_abi.abi_layout_id_end,
            duplicate_abi.abi_layout_required_start,
            duplicate_abi.abi_layout_required_end,
            duplicate_abi.abi_layout_start, duplicate_abi.abi_layout_end,
            abi_validation
        ) || MirCapturedAbiLayoutFactReady(
            wrong_abi_type_row, wrong_abi_type.abi_type_name,
            wrong_abi_type.abi_type_value_ready,
            wrong_abi_type.abi_type_start, wrong_abi_type.abi_type_end,
            wrong_abi_type.abi_layout_id_start,
            wrong_abi_type.abi_layout_id_end,
            wrong_abi_type.abi_layout_required_start,
            wrong_abi_type.abi_layout_required_end,
            wrong_abi_type.abi_layout_start,
            wrong_abi_type.abi_layout_end, abi_validation
        ) || MirCapturedAbiLayoutFactReady(
            mutated_required_abi_row, mutated_required_abi.abi_type_name,
            mutated_required_abi.abi_type_value_ready,
            mutated_required_abi.abi_type_start,
            mutated_required_abi.abi_type_end,
            mutated_required_abi.abi_layout_id_start,
            mutated_required_abi.abi_layout_id_end,
            mutated_required_abi.abi_layout_required_start,
            mutated_required_abi.abi_layout_required_end,
            mutated_required_abi.abi_layout_start,
            mutated_required_abi.abi_layout_end,
            abi_validation
        ) {
        Log("mir-program-routine-index-owner-negative-abi-failed");
        failures = failures + 1;
    }

    let corrupted_counts: Array<Int> = index.block_instruction_counts;
    ArraySet(corrupted_counts, 0, 3);
    let corrupted_instruction_facts: MirRoutineInstructionFactBundle =
        BuildMirRoutineInstructionFactBundle(index, 0);
    if corrupted_instruction_facts.valid ||
        MirProgramRoutineIndexStructureReady(index) ||
        MirProgramRoutineIndexRowReady(index, 0 - 1) ||
        MirProgramRoutineIndexRowReady(index, 2) {
        failures = failures + 1;
    }
    let truncated_abi_bounds: Array<Int> =
        first_facts.instruction_facts.abi_layout_bounds;
    ArrayPop(truncated_abi_bounds);
    let truncated_abi_facts: MirRoutineInstructionFactBundle =
        MirRoutineInstructionFactBundle(
            first_facts.instruction_facts.valid,
            first_facts.instruction_facts.global_start,
            first_facts.instruction_facts.starts,
            first_facts.instruction_facts.ends,
            first_facts.instruction_facts.results,
            first_facts.instruction_facts.expr0s,
            first_facts.instruction_facts.expr1s,
            first_facts.instruction_facts.arg0s,
            first_facts.instruction_facts.arg1s,
            first_facts.instruction_facts.slot_anchors,
            first_facts.instruction_facts.abi_type_names,
            first_facts.instruction_facts.abi_type_values_ready,
            truncated_abi_bounds,
            first_facts.instruction_facts.match_variants,
            first_facts.instruction_facts.block_has_conditional_branch
        );
    if MirRoutineInstructionFactBundleReady(
            truncated_abi_facts, 1
        ) || MirRoutineInstructionFactBundleAtGlobal(
            truncated_abi_facts, first_view.global_row
        ).valid {
        Log("mir-program-routine-index-owner-truncated-abi-bounds-failed");
        failures = failures + 1;
    }
    if failures == 0 {
        Log("mir-program-routine-index-owner-ok");
    } else {
        Log(Concat(
            "mir-program-routine-index-owner-failures=", ToString(failures)
        ));
        Exit(1);
    }
}
