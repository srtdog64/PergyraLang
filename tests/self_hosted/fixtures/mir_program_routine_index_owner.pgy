// Executable contract for the flattened MIR program routine structure index.

import "../../../src/self_hosted/mir_lower/program_routine_index_owner.pgy";
import "../../../src/self_hosted/mir_lower/program_instruction_routing_span_owner.pgy";
import "../../../src/self_hosted/mir_lower/routine_instruction_view_owner.pgy";
import "../../../src/self_hosted/mir_lower/routine_fact_index_owner.pgy";
import "../../../src/self_hosted/mir_lower/abi_layout_fact_owner.pgy";
import "../../../src/self_hosted/mir_lower/routine_lower.pgy";

func MirProgramRoutineIndexFromDocument(
    document: MirDocumentFactIndex
) -> MirProgramRoutineIndex {
    let declarations: MirProgramDeclarationIndex =
        BuildMirProgramDeclarationIndexFromTable(document.declarations);
    return BuildMirProgramRoutineIndexFromTable(
        document.routines, declarations
    );
}

func MirProgramRoutineIndexJsonReady(json: String) -> Bool {
    let document: MirDocumentFactIndex = BuildMirDocumentFactIndex(json);
    if !document.valid { return false; }
    let index: MirProgramRoutineIndex =
        MirProgramRoutineIndexFromDocument(document);
    return MirProgramRoutineIndexStructureReady(index);
}

func Main() -> Void {
    let failures: Int = 0;
    let abi_validation: MirAbiLayoutValidationSession =
        NewMirAbiLayoutValidationSession();
    let first_instruction: String =
        "{\"kind\":\"def\",\"source_type\":\"AST_LET_DECL\",\"result\":\"%0\",\"expr0\":\"1\",\"expr1\":null,\"arg0\":\"x\",\"arg1\":\"\",\"slot_anchor\":\"slot\",\"abi_type_name\":\"Int\",\"abi_layout_id\":0,\"abi_layout_required\":false,\"abi_layout\":null,\"match_variant\":\"Some\",\"payload\":{\"kind\":\"wrong\",\"source_type\":\"wrong\",\"expr0\":\"wrong\",\"machine_layer\":{}},\"machine_contact_kind\":\"\",\"machine_layer\":null}";
    let second_instruction: String =
        "{\"kind\":\"stmt\",\"source_type\":\"AST_CALL\",\"abi_type_name\":null,\"abi_layout_id\":0,\"abi_layout_required\":false,\"abi_layout\":null,\"machine_layer\":{\"operation\":\"x\"},\"machine_contact_kind\":\"x\"}";
    let third_instruction: String =
        "{\"kind\":\"phi\",\"source_type\":null,\"abi_type_name\":null,\"abi_layout_id\":0,\"abi_layout_required\":false,\"abi_layout\":null,\"machine_contact_kind\":null,\"machine_layer\":null}";
    let first_block: String = Concat(
        "{\"id\":0,\"reachable\":true,\"instructions\":[",
        Concat(first_instruction, Concat(",", Concat(second_instruction, "]}")))
    );
    let second_block: String = Concat(
        "{\"id\":0,\"reachable\":true,\"instructions\":[", Concat(third_instruction, "]}")
    );
    let empty_block: String = "{\"id\":1,\"reachable\":true,\"instructions\":[]}";
    let first_routine: String = Concat(
        "{\"kind\":\"function\",\"name\":\"A\",\"source_syntax_id\":1,\"receiver_carriage\":\"none\",\"iteration_type_fact_count\":0,\"iteration_type_facts\":[],\"resource_flow_symbol_count\":0,\"resource_flow_symbols\":[],\"blocks\":[",
        Concat(first_block, "]}")
    );
    let second_routine: String = Concat(
        "{\"kind\":\"method\",\"owner\":\"Box\",\"name\":\"Ping\",\"source_syntax_id\":2,\"receiver_carriage\":\"value\",\"blocks\":[",
        Concat(second_block, Concat(",", Concat(empty_block, "]}")))
    );
    let prefix: String =
        "{\"schema\":\"pgy.mir.v1\",\"decls\":[{\"kind\":\"class\",\"nominal_kind\":\"class\",\"name\":\"Box\",\"fields\":[]}],\"parallel_capture_boundaries\":[],\"routines\":[";
    let json: String = Concat(
        prefix, Concat(first_routine, Concat(",", Concat(second_routine, "]}")))
    );
    let document: MirDocumentFactIndex = BuildMirDocumentFactIndex(json);
    let index: MirProgramRoutineIndex =
        MirProgramRoutineIndexFromDocument(document);
    let foreign_document: MirDocumentFactIndex = BuildMirDocumentFactIndex(
        StringReplace(json, "Box", "ForeignBox")
    );
    let foreign_declarations: MirProgramDeclarationIndex =
        BuildMirProgramDeclarationIndexFromTable(foreign_document.declarations);
    let extended_declaration_table: JsonArrayObjectFactTable =
        JsonArrayObjectFactTable(
            true, document.declarations.json, document.declarations.start,
            document.declarations.end + 1
        );
    let extended_declarations: MirProgramDeclarationIndex =
        BuildMirProgramDeclarationIndexFromTable(extended_declaration_table);
    let cross_document_index: MirProgramRoutineIndex =
        BuildMirProgramRoutineIndexFromTable(
            document.routines, foreign_declarations
        );
    if !MirProgramRoutineIndexStructureReady(index) ||
        extended_declarations.valid ||
        cross_document_index.valid ||
        index.source_json != json || index.source_length != StringLength(json) ||
        !MirProgramRoutineIndexRowReady(index, 0) ||
        !MirProgramRoutineIndexRowReady(index, 1) ||
        MirProgramRoutineIndexRowReady(index, 0 - 1) ||
        MirProgramRoutineIndexRowReady(index, 2) ||
        ArrayLength(index.starts) != 2 ||
        index.source_syntax_ids[0] != "1" ||
        index.source_syntax_ids[1] != "2" ||
        index.receiver_carriages[0] != "none" ||
        index.receiver_carriages[1] != "value" ||
        index.owner_nominal_kinds[0] != "none" ||
        index.owner_nominal_kinds[1] != "class" ||
        index.owner_declaration_rows[0] != (0 - 1) ||
        index.owner_declaration_rows[1] != 0 ||
        index.routine_block_starts[0] != 0 ||
        index.routine_block_counts[0] != 1 ||
        index.routine_block_starts[1] != 1 ||
        index.routine_block_counts[1] != 2 ||
        ArrayLength(index.block_starts) != 3 ||
        index.block_instruction_starts[0] != 0 ||
        index.block_instruction_counts[0] != 2 ||
        index.block_instruction_starts[1] != 2 ||
        index.block_instruction_counts[1] != 1 ||
        index.block_instruction_starts[2] != 3 ||
        index.block_instruction_counts[2] != 0 ||
        index.instruction_kinds[0] != "def" ||
        index.instruction_kinds[1] != "stmt" ||
        index.instruction_kinds[2] != "phi" ||
        index.instruction_source_types[0] != "AST_LET_DECL" ||
        index.instruction_source_types[1] != "AST_CALL" ||
        index.instruction_source_types[2] != "" {
        failures = failures + 1;
    }
    let first_view: MirRoutineInstructionView =
        MirRoutineInstructionViewAt(index, 0, 0, 0);
    let phi_selection: MirRoutineInstructionSelection =
        MirRoutineInstructionViewOfKind(index, 1, 0, "phi");
    let empty_selection: MirRoutineInstructionSelection =
        MirRoutineInstructionViewOfKind(index, 1, 1, "branch");
    let first_facts: MirRoutineFactIndex =
        BuildMirRoutineFactIndex(index, 0);
    let first_scalar: MirRoutineInstructionScalarCapture =
        MirRoutineInstructionFactBundleAtGlobal(
            first_facts.instruction_facts, first_view.global_row
        );
    let missing_branch: MirRoutineInstructionSelection =
        MirRoutineFactIndexBranchAtBlock(
            first_facts, index, 0, 0
        );
    if !first_view.valid || first_view.global_row != 0 ||
        first_view.kind != "def" ||
        first_view.source_type != "AST_LET_DECL" ||
        !first_facts.instruction_facts.valid || !first_scalar.valid ||
        first_scalar.result != "%0" || first_scalar.expr0 != "1" ||
        first_scalar.arg0 != "x" || first_scalar.slot_anchor != "slot" ||
        first_scalar.abi_type_name != "Int" ||
        !first_scalar.abi_type_value_ready ||
        first_scalar.match_variant != "Some" ||
        !phi_selection.valid || !phi_selection.found ||
        phi_selection.instruction.global_row != 2 ||
        phi_selection.instruction.source_type != "" ||
        !empty_selection.valid || empty_selection.found ||
        !missing_branch.valid || missing_branch.found ||
        MirRoutineInstructionViewAt(index, 0 - 1, 0, 0).valid ||
        MirRoutineInstructionViewAt(index, 0, 1, 0).valid ||
        MirRoutineInstructionViewAt(index, 0, 0, 2).valid {
        failures = failures + 1;
    }

    // Match-local admission consumes the program routine index directly.  A
    // non-match row may carry forged match arrays, but it must never be read as
    // a binding source; only the canonical match branch contributes a local.
    let nonmatch_binding_instruction: String =
        "{\"kind\":\"stmt\",\"source_type\":\"AST_CALL\",\"match_bindings\":[\"ignored\"],\"match_binding_types\":[],\"abi_type_name\":null,\"abi_layout_id\":0,\"abi_layout_required\":false,\"abi_layout\":null,\"machine_contact_kind\":null,\"machine_layer\":null}";
    let match_binding_instruction: String =
        "{\"kind\":\"branch\",\"source_type\":\"AST_MATCH_CASE\",\"match_bindings\":[\"bound\"],\"match_binding_types\":[\"Int\"],\"abi_type_name\":null,\"abi_layout_id\":0,\"abi_layout_required\":false,\"abi_layout\":null,\"machine_contact_kind\":null,\"machine_layer\":null}";
    let match_binding_block: String = Concat(
        "{\"id\":0,\"reachable\":true,\"instructions\":[", Concat(
            nonmatch_binding_instruction,
            Concat(",", Concat(match_binding_instruction, "]}"))
        )
    );
    let match_binding_routine_prefix: String =
        "{\"kind\":\"function\",\"name\":\"MatchBindings\",\"source_syntax_id\":1,\"receiver_carriage\":\"none\",\"iteration_type_fact_count\":0,\"iteration_type_facts\":[],\"resource_flow_symbol_count\":0,\"resource_flow_symbols\":[],\"blocks\":[";
    let match_binding_routine: String = Concat(
        match_binding_routine_prefix, Concat(match_binding_block, "]}")
    );
    let match_binding_json: String = Concat(
        prefix, Concat(match_binding_routine, "]}")
    );
    let match_binding_program: MirProgramRoutineIndex =
        BuildMirProgramRoutineIndex(match_binding_json);
    let match_binding_index: MirRoutineFactIndex =
        BuildMirRoutineFactIndex(match_binding_program, 0);
    if !match_binding_index.valid ||
        MirRoutineFactIndexSourceLocalType(
            match_binding_index, "bound"
        ) != "Int" || MirRoutineFactIndexSourceLocalType(
            match_binding_index, "ignored"
        ) != "" {
        Log("mir-program-routine-index-owner-match-direct-filter-failed");
        failures = failures + 1;
    }

    let second_arm_match_instruction: String =
        "{\"kind\":\"branch\",\"source_type\":\"AST_MATCH_CASE\",\"match_bindings\":[\"bound\"],\"match_binding_types\":[\"String\"],\"abi_type_name\":null,\"abi_layout_id\":0,\"abi_layout_required\":false,\"abi_layout\":null,\"machine_contact_kind\":null,\"machine_layer\":null}";
    let distinct_arm_first_block: String = Concat(
        "{\"id\":0,\"reachable\":true,\"instructions\":[",
        Concat(match_binding_instruction, "]}")
    );
    let distinct_arm_second_block: String = Concat(
        "{\"id\":1,\"reachable\":true,\"instructions\":[",
        Concat(second_arm_match_instruction, "]}")
    );
    let distinct_arm_routine: String = Concat(
        match_binding_routine_prefix, Concat(
            distinct_arm_first_block, Concat(",", Concat(
                distinct_arm_second_block, "]}"
            ))
        )
    );
    let distinct_arm_json: String = Concat(
        prefix, Concat(distinct_arm_routine, "]}")
    );
    let distinct_arm_program: MirProgramRoutineIndex =
        BuildMirProgramRoutineIndex(distinct_arm_json);
    let distinct_arm_index: MirRoutineFactIndex =
        BuildMirRoutineFactIndex(distinct_arm_program, 0);
    if !distinct_arm_index.valid {
        Log(Concat(
            "mir-program-routine-index-owner-distinct-arm-invalid=",
            distinct_arm_index.validation_stage
        ));
        failures = failures + 1;
    } else if MirRoutineFactIndexSourceLocalType(
        distinct_arm_index, "bound"
    ) != "" {
        Log("mir-program-routine-index-owner-distinct-arm-scope-failed");
        failures = failures + 1;
    }

    let forged_stmt_match_instruction: String =
        "{\"kind\":\"stmt\",\"source_type\":\"AST_MATCH_CASE\",\"match_bindings\":[\"forged\"],\"match_binding_types\":[\"Int\"],\"abi_type_name\":null,\"abi_layout_id\":0,\"abi_layout_required\":false,\"abi_layout\":null,\"machine_contact_kind\":null,\"machine_layer\":null}";
    let forged_stmt_match_block: String = Concat(
        "{\"id\":0,\"reachable\":true,\"instructions\":[",
        Concat(forged_stmt_match_instruction, "]}")
    );
    let forged_stmt_match_routine: String = Concat(
        match_binding_routine_prefix, Concat(forged_stmt_match_block, "]}")
    );
    let forged_stmt_match_json: String = Concat(
        prefix, Concat(forged_stmt_match_routine, "]}")
    );
    let forged_stmt_match_program: MirProgramRoutineIndex =
        BuildMirProgramRoutineIndex(forged_stmt_match_json);
    let forged_stmt_match_index: MirRoutineFactIndex =
        BuildMirRoutineFactIndex(forged_stmt_match_program, 0);
    if forged_stmt_match_index.valid ||
        forged_stmt_match_index.validation_stage !=
            "match_binding_instruction_kind" {
        Log("mir-program-routine-index-owner-forged-stmt-match-accepted");
        failures = failures + 1;
    }

    let missing_match_type_instruction: String =
        "{\"kind\":\"branch\",\"source_type\":\"AST_MATCH_CASE\",\"match_bindings\":[\"missing_type\"],\"match_binding_types\":[],\"abi_type_name\":null,\"abi_layout_id\":0,\"abi_layout_required\":false,\"abi_layout\":null,\"machine_contact_kind\":null,\"machine_layer\":null}";
    let missing_match_type_block: String = Concat(
        "{\"id\":0,\"reachable\":true,\"instructions\":[",
        Concat(missing_match_type_instruction, "]}")
    );
    let missing_match_type_routine: String = Concat(
        match_binding_routine_prefix, Concat(missing_match_type_block, "]}")
    );
    let missing_match_type_json: String = Concat(
        prefix, Concat(missing_match_type_routine, "]}")
    );
    let missing_match_type_program: MirProgramRoutineIndex =
        BuildMirProgramRoutineIndex(missing_match_type_json);
    let missing_match_type_index: MirRoutineFactIndex =
        BuildMirRoutineFactIndex(missing_match_type_program, 0);
    if missing_match_type_index.valid ||
        missing_match_type_index.validation_stage !=
            "match_binding_type_count" {
        Log("mir-program-routine-index-owner-missing-match-type-accepted");
        failures = failures + 1;
    }

    let empty_match_names: Array<String> = [];
    let empty_match_types: Array<String> = [];
    let invalid_match_program: MirProgramRoutineIndex =
        BuildMirProgramRoutineIndex("{}");
    let invalid_match_owner: MirMatchBindingLocalFacts =
        BuildMirMatchBindingLocalFacts(
            invalid_match_program, 0, empty_match_names, empty_match_types
        );
    let invalid_match_row: MirMatchBindingLocalFacts =
        BuildMirMatchBindingLocalFacts(
            match_binding_program, 1, empty_match_names, empty_match_types
        );
    if invalid_match_owner.valid || invalid_match_row.valid ||
        invalid_match_owner.validation_stage !=
            "match_binding_routine_owner" ||
        invalid_match_row.validation_stage !=
            "match_binding_routine_owner" {
        Log("mir-program-routine-index-owner-invalid-match-owner-accepted");
        failures = failures + 1;
    }
    let mismatched_match_names: Array<String> = ["existing"];
    let mismatched_match_types: Array<String> = [];
    let mismatched_match_locals: MirMatchBindingLocalFacts =
        BuildMirMatchBindingLocalFacts(
            match_binding_program, 0,
            mismatched_match_names, mismatched_match_types
        );
    if mismatched_match_locals.valid ||
        mismatched_match_locals.validation_stage !=
            "match_binding_source_local_count" {
        Log("mir-program-routine-index-owner-mismatched-locals-accepted");
        failures = failures + 1;
    }
    let zero_block_routine_counts: Array<Int> = [1, 0];
    let missing_parallel_block_ends: Array<Int> = [];
    let zero_block_parallel_gap: MirProgramRoutineIndex =
        MirProgramRoutineIndex(
            index.valid, index.source_json, index.source_length,
            index.declarations,
            index.starts, index.ends, index.kinds, index.owners, index.names,
            index.source_syntax_ids, index.receiver_carriages,
            index.owner_nominal_kinds, index.owner_declaration_rows,
            index.routine_block_starts, zero_block_routine_counts,
            index.block_starts, missing_parallel_block_ends,
            index.block_instruction_starts,
            index.block_instruction_counts,
            index.instruction_starts, index.instruction_ends,
            index.instruction_kinds, index.instruction_source_types,
            index.instruction_machine_contact_starts,
            index.instruction_machine_contact_ends,
            index.instruction_machine_layer_starts,
            index.instruction_machine_layer_ends,
            index.instruction_expressions
        );
    let zero_block_gap_names: Array<String> = [];
    let zero_block_gap_types: Array<String> = [];
    let zero_block_gap_facts: MirMatchBindingLocalFacts =
        BuildMirMatchBindingLocalFacts(
            zero_block_parallel_gap, 1,
            zero_block_gap_names, zero_block_gap_types
        );
    if !MirProgramRoutineIndexRowReady(zero_block_parallel_gap, 1) ||
        zero_block_gap_facts.valid ||
        zero_block_gap_facts.validation_stage !=
            "match_binding_block_alignment" {
        Log("mir-program-routine-index-owner-zero-block-parallel-gap-accepted");
        failures = failures + 1;
    }
    if !MirCapturedAbiLayoutFactReady(
        json, first_scalar.abi_type_name,
        first_scalar.abi_type_value_ready,
        first_scalar.abi_type_start, first_scalar.abi_type_end,
        first_scalar.abi_layout_id_start, first_scalar.abi_layout_id_end,
        first_scalar.abi_layout_required_start,
        first_scalar.abi_layout_required_end,
        first_scalar.abi_layout_start, first_scalar.abi_layout_end,
        abi_validation
    ) {
        Log("mir-program-routine-index-owner-positive-abi-failed");
        failures = failures + 1;
    }
    let method_row: Option<Int> = MirProgramRoutineIndexFindMethodRow(
        index, "Box", "Ping"
    );
    if !IsSome(method_row) || UnwrapOption(method_row) != 1 {
        failures = failures + 1;
    }
    if JsonCharCodeAt(
        json, index.instruction_machine_layer_ends[0],
        index.instruction_machine_layer_starts[0]
    ) != JsonAsciiCode("n") || JsonCharCodeAt(
        json, index.instruction_machine_layer_ends[1],
        index.instruction_machine_layer_starts[1]
    ) != JsonAsciiCode("{") || JsonCharCodeAt(
        json, index.instruction_machine_contact_ends[1],
        index.instruction_machine_contact_starts[1]
    ) != JsonAsciiCode("\"") {
        failures = failures + 1;
    }

    let branch_instruction: String =
        "{\"kind\":\"branch\",\"source_type\":\"AST_IF_STMT\",\"expr0\":\"%0\",\"abi_type_name\":null,\"abi_layout_id\":0,\"abi_layout_required\":false,\"abi_layout\":null,\"machine_contact_kind\":null,\"machine_layer\":null}";
    let branch_block: String = Concat(
        "{\"id\":0,\"reachable\":true,\"instructions\":[",
        Concat(first_instruction, Concat(",", Concat(branch_instruction, "]}")))
    );
    let branch_routine: String = Concat(
        "{\"kind\":\"function\",\"name\":\"Branch\",\"source_syntax_id\":1,\"receiver_carriage\":\"none\",\"iteration_type_fact_count\":0,\"iteration_type_facts\":[],\"resource_flow_symbol_count\":0,\"resource_flow_symbols\":[],\"blocks\":[",
        Concat(branch_block, "]}")
    );
    let branch_json: String = Concat(
        prefix, Concat(branch_routine, "]}")
    );
    let branch_document: MirDocumentFactIndex =
        BuildMirDocumentFactIndex(branch_json);
    let branch_program: MirProgramRoutineIndex =
        MirProgramRoutineIndexFromDocument(branch_document);
    let branch_index: MirRoutineFactIndex =
        BuildMirRoutineFactIndex(branch_program, 0);
    let branch_selection: MirRoutineInstructionSelection =
        MirRoutineFactIndexBranchAtBlock(
            branch_index, branch_program, 0, 0
        );
    if !branch_selection.valid || !branch_selection.found ||
        branch_selection.instruction.global_row != 1 ||
        branch_selection.instruction.kind != "branch" ||
        ArrayLength(
            branch_index.instruction_facts.block_branch_global_rows
        ) != 1 ||
        branch_index.instruction_facts.block_branch_global_rows[0] != 1 {
        Log("mir-program-routine-index-owner-branch-row-failed");
        failures = failures + 1;
    }
    let forged_branch_rows: Array<Int> =
        branch_index.instruction_facts.block_branch_global_rows;
    ArraySet(forged_branch_rows, 0, 0);
    if MirRoutineFactIndexBranchAtBlock(
        branch_index, branch_program, 0, 0
    ).valid {
        Log("mir-program-routine-index-owner-forged-branch-kind-failed");
        failures = failures + 1;
    }
    let out_of_block_branch_index: MirRoutineFactIndex =
        BuildMirRoutineFactIndex(branch_program, 0);
    let out_of_block_branch_rows: Array<Int> =
        out_of_block_branch_index.instruction_facts.block_branch_global_rows;
    ArraySet(out_of_block_branch_rows, 0, 2);
    if MirRoutineFactIndexBranchAtBlock(
        out_of_block_branch_index, branch_program, 0, 0
    ).valid {
        Log("mir-program-routine-index-owner-out-of-block-branch-failed");
        failures = failures + 1;
    }
    let invalid_sentinel_branch_index: MirRoutineFactIndex =
        BuildMirRoutineFactIndex(branch_program, 0);
    let invalid_sentinel_branch_rows: Array<Int> =
        invalid_sentinel_branch_index.instruction_facts.block_branch_global_rows;
    ArraySet(invalid_sentinel_branch_rows, 0, 0 - 2);
    if MirRoutineFactIndexBranchAtBlock(
        invalid_sentinel_branch_index, branch_program, 0, 0
    ).valid {
        Log("mir-program-routine-index-owner-invalid-branch-sentinel-failed");
        failures = failures + 1;
    }
    let cross_block_first: String = Concat(
        "{\"id\":0,\"reachable\":true,\"instructions\":[", Concat(first_instruction, "]}")
    );
    let cross_block_second: String = Concat(
        "{\"id\":1,\"reachable\":true,\"instructions\":[", Concat(branch_instruction, "]}")
    );
    let cross_block_routine: String = Concat(
        "{\"kind\":\"function\",\"name\":\"CrossBlock\",\"source_syntax_id\":1,\"receiver_carriage\":\"none\",\"iteration_type_fact_count\":0,\"iteration_type_facts\":[],\"resource_flow_symbol_count\":0,\"resource_flow_symbols\":[],\"blocks\":[",
        Concat(cross_block_first, Concat(",", Concat(cross_block_second, "]}")))
    );
    let cross_block_json: String = Concat(
        prefix, Concat(cross_block_routine, "]}")
    );
    let cross_block_document: MirDocumentFactIndex =
        BuildMirDocumentFactIndex(cross_block_json);
    let cross_block_program: MirProgramRoutineIndex =
        MirProgramRoutineIndexFromDocument(cross_block_document);
    let cross_block_index: MirRoutineFactIndex =
        BuildMirRoutineFactIndex(cross_block_program, 0);
    let cross_block_branch_rows: Array<Int> =
        cross_block_index.instruction_facts.block_branch_global_rows;
    ArraySet(cross_block_branch_rows, 0, 1);
    if MirRoutineFactIndexBranchAtBlock(
        cross_block_index, cross_block_program, 0, 0
    ).valid {
        Log("mir-program-routine-index-owner-cross-block-branch-failed");
        failures = failures + 1;
    }
    let no_branch_projection_index: MirRoutineFactIndex =
        BuildMirRoutineFactIndex(index, 0);
    if !LoopFlowSummaryProjectionReady(
        no_branch_projection_index, index, 0
    ) {
        Log("mir-program-routine-index-owner-no-branch-projection-failed");
        failures = failures + 1;
    }
    let no_branch_span_starts: Array<Int> =
        no_branch_projection_index.block_starts;
    ArraySet(no_branch_span_starts, 0, no_branch_span_starts[0] + 1);
    if LoopFlowSummaryProjectionReady(
        no_branch_projection_index, index, 0
    ) {
        Log("mir-program-routine-index-owner-no-branch-span-failed");
        failures = failures + 1;
    }
    let for_instruction: String =
        "{\"kind\":\"branch\",\"source_type\":\"AST_FOR_LOOP\",\"arg0\":\"i\",\"expr0\":\"0\",\"expr1\":\"10\",\"abi_type_name\":null,\"abi_layout_id\":0,\"abi_layout_required\":false,\"abi_layout\":null,\"machine_contact_kind\":null,\"machine_layer\":null}";
    let for_routine: String = Concat(
