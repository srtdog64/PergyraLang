// Negative consumer contract: a routine-local instruction start may not point
// into a sibling block's admitted slice.

import "../../../src/self_hosted/mir_lower/program_routine_index_owner.pgy";
import "../../../src/self_hosted/mir_lower/routine_fact_index_owner.pgy";
import "../../../src/self_hosted/mir_lower/routine_lower.pgy";

func Main() -> Void {
    let instruction: String =
        "{\"kind\":\"stmt\",\"source_type\":\"AST_CALL\",\"abi_type_name\":null,\"abi_layout_id\":0,\"abi_layout_required\":false,\"abi_layout\":null,\"machine_contact_kind\":null,\"machine_layer\":null}";
    let block0: String = Concat(
        "{\"id\":0,\"instructions\":[", Concat(instruction, "]}")
    );
    let block1: String = Concat(
        "{\"id\":1,\"instructions\":[", Concat(instruction, "]}")
    );
    let routine: String = Concat(
        "{\"kind\":\"function\",\"name\":\"CrossBlock\",\"source_syntax_id\":1,\"iteration_type_fact_count\":0,\"iteration_type_facts\":[],\"resource_flow_symbol_count\":0,\"resource_flow_symbols\":[],\"blocks\":[",
        Concat(block0, Concat(",", Concat(block1, "]}")))
    );
    let json: String = Concat(
        "{\"schema\":\"pgy.mir.v1\",\"decls\":[],\"parallel_capture_boundaries\":[],\"routines\":[",
        Concat(routine, "]}")
    );
    let document: MirDocumentFactIndex = BuildMirDocumentFactIndex(json);
    let routines: MirProgramRoutineIndex =
        BuildMirProgramRoutineIndexFromTable(document.routines);
    let index: MirRoutineFactIndex = BuildMirRoutineFactIndex(routines, 0);
    if !index.valid || ArrayLength(index.block_instruction_starts) != 2 ||
        index.block_instruction_starts[0] != 0 ||
        index.block_instruction_starts[1] != 1 {
        Log("mir-routine-block-local-admission-fixture-invalid");
        Exit(2);
    }
    let forged_starts: Array<Int> = index.block_instruction_starts;
    ArraySet(forged_starts, 1, 0);
    let abi_validation: MirAbiLayoutValidationSession =
        NewMirAbiLayoutValidationSession();
    EmitBlockStmts(index, routines, 0, 1, "", false, abi_validation);
    Log("mir-routine-block-local-admission-accepted");
    Exit(1);
}
