// A borrowed input may retire immediately after independent MIR row storage.
import "../../../src/self_hosted/mir/routine_build_owner.pgy";

func RowsFromBorrow(ref values: Array<String>) -> SelfMirRoutineBuild {
    let build: SelfMirRoutineBuild = SelfMirRoutineBuildEmpty();
    build = SelfMirRoutinePushLocal(build, values[0], "String", 0, values[0]);
    let uses: Array<String> = [];
    return SelfMirRoutineAddInstruction(build, "assign", values[0], values[0],
        values[0], values[0], values[0], values[0], "String", uses);
}

func Main() -> Void with caps io_write {
    let values: Array<String> = [];
    ArrayPushOwnedString(values, "borrow-retained-row");
    let build: SelfMirRoutineBuild = RowsFromBorrow(values);
    ArrayDropOwnedStrings(values);
    if build.local_names[0] != "borrow-retained-row" ||
        build.local_refs[0] != "borrow-retained-row" ||
        build.cfg.instructions.names[0] != "borrow-retained-row" ||
        build.cfg.instructions.expr0s[0] != "borrow-retained-row" {
        Print("retained-row-mismatch");
        Exit(1);
    }
    Print("retained-row-ok");
}
