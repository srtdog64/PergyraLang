// Analyze the actual source producer's initializer route. Never emit/run input.
import "../../../src/self_hosted/parser/program_parse_owner.pgy";
import "../../../src/self_hosted/semantic/ast_body_type_bundle_owner.pgy";
import "owned_string_local_reassignment_unit.pgy";
import "numeric_string_allocation_unit.pgy";
import "owned_string_allocator_domain_unit.pgy";

func Main() -> Void with caps env, io_read {
    let args: Array<String> = Args();
    if ArrayLength(args) < 1 || ArrayLength(args) > 2 { Log("expected source path and optional diagnostic mode"); Exit(2); }
    let diagnostic: Bool = false;
    let reassignment_mode: String = "";
    let numeric_mode: String = "";
    let allocator_mode: String = "";
    if ArrayLength(args) == 2 {
        if args[1] == "diagnostic" { diagnostic = true; }
        else if StartsWith(args[1], "owned-string-reassignment-") { reassignment_mode = args[1]; }
        else if StartsWith(args[1], "numeric-string-") { numeric_mode = args[1]; }
        else if StartsWith(args[1], "allocator-domain-") { allocator_mode = args[1]; }
        else { Log("unknown source observation mode"); Exit(2); }
    }
    let artifact: AstTreeArtifact = ParseRootProgramArtifact(args[0]);
    if !AstTreeArtifactReady(artifact) { Log("source parser refused"); Exit(2); }
    let analysis: SemanticAstArtifactAnalysis = SemanticAstArtifactAnalyzeTyped(artifact, true);
    if !analysis.verdict.ok { Log(analysis.verdict.diagnostic_code); Exit(2); }
    let bundle: SemanticAstBodyTypeBundle = SemanticAstBodyTypeBundleFromAnalysis(artifact, analysis);
    if allocator_mode != "" {
        if !InspectOwnedStringAllocatorDomain(artifact, analysis, bundle, allocator_mode) {
            Log("owned String allocator domain unit failed"); Exit(3);
        }
        Log("owned-string-allocator-domain-unit:PASS"); return;
    }
    if numeric_mode != "" {
        if !InspectNumericStringAllocation(artifact, analysis, bundle, numeric_mode) {
            Log("numeric String allocation unit failed"); Exit(3);
        }
        Log("numeric-string-allocation-unit:PASS"); return;
    }
    if reassignment_mode != "" {
        if !InspectOwnedStringLocalReassignment(artifact, analysis, bundle, reassignment_mode) {
            Log("owned-string reassignment unit failed"); Exit(3);
        }
        Log("owned-string-reassignment-unit:PASS"); return;
    }
    Log(Concat("body_ok=", ToString(bundle.verdict.ok)));
    Log(Concat("body_diagnostic=", bundle.verdict.diagnostic_code));
    if diagnostic {
        Log(Concat("body_message=", bundle.verdict.diagnostic_message));
        Log(Concat("body_syntax=", ToString(bundle.verdict.first_node_id)));
        let atom: Option<String> = TypedAstArenaAtomText(artifact.arena, bundle.verdict.first_node_id);
        let value: Option<String> = TypedAstArenaValueText(artifact.arena, bundle.verdict.first_node_id);
        if IsSome(atom) { Log(Concat("body_atom=", UnwrapOption(atom))); }
        if IsSome(value) { Log(Concat("body_value=", UnwrapOption(value))); }
        let ancestor: Int = bundle.verdict.first_node_id;
        let remaining: Int = artifact.count;
        while ancestor >= 0 && ancestor < artifact.count && remaining > 0 {
            if TypedAstArenaNodeKindIsCallable(artifact.arena, ancestor) {
                let signature: Option<Int> = SemanticAstFunctionSignatureIndexForNode(analysis.signatures, ancestor);
                if IsSome(signature) {
                    let name: Option<String> = SemanticAstFunctionNameAt(analysis.signatures, UnwrapOption(signature));
                    let module: Option<String> = SemanticAstFunctionModulePathAt(analysis.signatures, UnwrapOption(signature));
                    if !IsSome(name) || !IsSome(module) { Log("invalid diagnostic callable identity"); Exit(2); }
                    Log(Concat("body_function=", UnwrapOption(name)));
                    Log(Concat("body_module=", UnwrapOption(module)));
                }
                break;
            }
            let parent: Option<Int> = TypedAstArenaParentId(artifact.arena, ancestor);
            if !IsSome(parent) { break; }
            ancestor = UnwrapOption(parent); remaining = remaining - 1;
        }
    }
}
