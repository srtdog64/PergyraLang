// Inspect/mutate issued semantic facts; never execute a supplied input.
import "../../../src/self_hosted/semantic/ast_numeric_string_allocation_call_owner.pgy";

func InspectNumericStringAllocation(
    ref artifact: AstTreeArtifact, inout analysis: SemanticAstArtifactAnalysis,
    inout bundle: SemanticAstBodyTypeBundle, mode: String
) -> Bool {
    let reached: Bool = bundle.verdict.ok ||
        (!bundle.collection_ownership.ok && bundle.collection_ownership.diagnostic_code == "borrow_boundary_escape");
    let facts: SemanticAstNumericStringAllocationCalls = bundle.numeric_string_allocations;
    if !reached || !SemanticAstNumericStringAllocationCallsReady(facts) { return false; }
    if mode == "numeric-string-observe" {
        let row: Int = 0; let digest_found: Bool = false; let indexed_delta_found: Bool = false;
        while row < ArrayLength(facts.call_nodes) {
            if !SemanticAstNumericStringAllocationCallReady(facts, analysis.expression_surfaces,
                    facts.owner_node_ids[row], facts.lanes[row], facts.terminal_nodes[row]) { return false; }
            let surface: Option<Int> = SemanticAstExpressionSurfaceIndexForNode(
                analysis.expression_surfaces, facts.owner_node_ids[row]);
            if !IsSome(surface) { return false; }
            let function_id: Int = analysis.expression_surfaces.function_node_ids[UnwrapOption(surface)];
            let signature: Option<Int> = SemanticAstFunctionSignatureIndexForNode(analysis.signatures, function_id);
            if IsSome(signature) && analysis.signatures.names[UnwrapOption(signature)] == "SelfMirJsonExpressionGraphWriteFile" {
                let call: SemanticCallSpineView = SemanticCallSpineViewFromGraph(
                    analysis.expression_surfaces.expression_graph, facts.terminal_nodes[row]);
                let text: Option<String> = SemanticExpressionGraphNodeText(
                    analysis.expression_surfaces.expression_graph, call.argument_nodes[0]);
                let kind: Option<Int> = SemanticExpressionGraphNodeKind(
                    analysis.expression_surfaces.expression_graph, call.argument_nodes[0]);
                if IsSome(text) && UnwrapOption(text) == "digest" && facts.operand_types[row] == "Int" { digest_found = true; }
                if IsSome(kind) && UnwrapOption(kind) == AstExpressionNodeSubtract() && facts.operand_types[row] == "Int" { indexed_delta_found = true; }
            }
            row = row + 1;
        }
        Log(Concat("numeric_string_calls=", ToString(ArrayLength(facts.call_nodes))));
        Log(Concat("actual_digest=", ToString(digest_found)));
        Log(Concat("actual_indexed_delta=", ToString(indexed_delta_found)));
        return digest_found && indexed_delta_found;
    }
    if ArrayLength(facts.call_nodes) < 2 { return false; }
    let root: Int = facts.terminal_nodes[0]; let base: Int = facts.call_nodes[0];
    let owner: Int = facts.owner_node_ids[0]; let lane: Int = facts.lanes[0];
    if !SemanticAstNumericStringAllocationCallReady(facts, analysis.expression_surfaces, owner, lane, root) { return false; }
    if mode == "numeric-string-current" { return true; }
    if mode == "numeric-string-missing-owner" { ArrayPop(facts.owner_node_ids); }
    else if mode == "numeric-string-missing-type" { ArrayPop(facts.operand_types); }
    else if mode == "numeric-string-foreign-owner" { facts.owner_node_ids[0] = facts.owner_node_ids[1]; }
    else if mode == "numeric-string-crossed-node" { facts.call_nodes[0] = facts.call_nodes[1]; }
    else if mode == "numeric-string-crossed-lane" { facts.lanes[0] = (lane + 1) % 3; }
    else if mode == "numeric-string-crossed-ordinal" { facts.local_call_ordinals[0] = facts.local_call_ordinals[0] + 1; }
    else if mode == "numeric-string-borrowed-type" { facts.operand_types[0] = "String"; }
    else if mode == "numeric-string-unknown-type" { facts.operand_types[0] = "Unknown"; }
    else if mode == "numeric-string-family-deleted" { facts = SemanticAstNumericStringAllocationCallsEmpty(); facts.ok = true; }
    else if mode == "numeric-string-declared-target" {
        analysis.expression_surfaces.expression_graph.arena.identities.call_target_syntax_ids[base] =
            analysis.signatures.function_node_ids[0];
    } else if mode == "numeric-string-runtime-abi" {
        analysis.expression_surfaces.expression_graph.arena.identities.runtime_call_abi_ids[base] = 1;
    } else if mode == "numeric-string-callee-binding" {
        let callee: Option<Int> = SemanticCallBaseCalleeFromGraph(analysis.expression_surfaces.expression_graph, base);
        if !IsSome(callee) { return false; }
        let node: Int = UnwrapOption(callee);
        analysis.expression_surfaces.expression_graph.arena.identities.binding_kinds[node] = SemanticExpressionBindingDeclaredCallable();
        analysis.expression_surfaces.expression_graph.arena.identities.binding_syntax_ids[node] = analysis.signatures.function_node_ids[0];
    } else { return false; }
    return !SemanticAstNumericStringAllocationCallReady(facts, analysis.expression_surfaces, owner, lane, root);
}
