// A party returned from a call cannot carry a bound slot: the bind stores the
// address of a subject local to MakeTeam, which ends when MakeTeam returns
// (docs/206 section 1). Both front ends refuse returning the bound party.
// Before, the default C route ran this and native refused it for another
// reason, so the party-once receiver order it once checked has no legal form.
subject Fighter {
    let power: Int;
}

ability Combatable {
    func Poke(self, x: Int) -> Int;
}

role Warrior for Fighter {
    impl Combatable {
        func Poke(self, x: Int) -> Int {
            return 200 + x;
        }
    }
}

party Team {
    dyn role slot fighter: Combatable;
    shared hp: Int;
}

func Tag(t: String) -> Int {
    Log(t);
    return 1;
}

func MakeTeam(t: String) -> Team {
    Log(t);
    let hero: Fighter = Fighter(1);
    let team: Team = Team(0);
    bind team.fighter = hero as Warrior;
    return team;
}

func Main() -> Void {
    Log(MakeTeam("party").fighter.Poke(Tag("c")));
}
