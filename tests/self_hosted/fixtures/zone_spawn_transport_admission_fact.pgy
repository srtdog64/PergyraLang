// Execute the admitted semantic owner; never execute the source under test.
import "../../../src/self_hosted/parser/program_parse_owner.pgy";
import "../../../src/self_hosted/semantic/ast_body_type_bundle_owner.pgy";
import "../../../src/self_hosted/semantic/public_diagnostic_receipt_owner.pgy";
import "../../../src/self_hosted/codegen/text/text_owner.pgy";

func Main() -> Void with caps env, io_read {
    let args: Array<String> = Args();
    if ArrayLength(args) != 4 {
        Die("zone spawn probe requires source, owned code, public code and cause");
    }
    let artifact: AstTreeArtifact = ParseRootProgramArtifact(args[0]);
    let analysis: SemanticAstArtifactAnalysis =
        SemanticAstArtifactAnalyzeTyped(artifact, true);
    let body: SemanticAstBodyTypeBundle =
        SemanticAstBodyTypeBundleFromAnalysis(artifact, analysis);
    if args[1] == "missing-identity" {
        let graph_node: Int = 0;
        let call_node: Int = -1;
        while graph_node < SemanticExpressionGraphArenaNodeCount(
            analysis.expression_surfaces.expression_graph.arena
        ) {
            if analysis.expression_surfaces.expression_graph.arena.topology.node_kinds[
                graph_node
            ] == AstExpressionNodeSpawn() {
                let operand: Int = analysis.expression_surfaces.expression_graph.arena.topology.left_children[
                    graph_node
                ];
                let call: SemanticCallSpineView =
                    SemanticCallSpineViewFromGraph(
                        analysis.expression_surfaces.expression_graph, operand
                    );
                if !call.ok { Die("spawn call spine is missing"); }
                call_node = call.call_node;
                break;
            }
            graph_node = graph_node + 1;
        }
        if call_node < 0 { Die("spawn source graph is missing"); }
        ArraySet(
            analysis.expression_surfaces.expression_graph.arena.identities.call_target_syntax_ids,
            call_node, 0
        );
        let missing: SemanticAstZoneParameterBoundaryVerdict =
            SemanticAstZoneSpawnBoundaryVerdictFromAdmittedFacts(
                artifact, analysis.signatures, analysis.constructors,
                analysis.expression_surfaces
            );
        if missing.ok || missing.diagnostic_code != "ast_artifact_invalid" {
            Die("spawn accepted a missing callable identity");
        }
        let missing_receipt: SemanticPublicDiagnosticReceipt =
            SemanticPublicDiagnosticReceiptFromOwnedFacts(
                missing.diagnostic_code, missing.diagnostic_message
            );
        if !SemanticPublicDiagnosticReceiptReadyFor(
            missing_receipt, missing.diagnostic_code
        ) || missing_receipt.code != args[2] ||
            missing_receipt.cause_ir != args[3] {
            Die("missing spawn identity lost its public diagnostic receipt");
        }
        Log("missing spawn callable identity refused with owned receipt");
        return;
    }
    if body.verdict.ok || body.verdict.diagnostic_code != args[1] {
        Die(Concat("zone spawn verdict did not match its owner: ",
            body.verdict.diagnostic_code));
    }
    let receipt: SemanticPublicDiagnosticReceipt =
        SemanticPublicDiagnosticReceiptFromOwnedFacts(
            body.verdict.diagnostic_code, body.verdict.diagnostic_message
        );
    if !SemanticPublicDiagnosticReceiptReadyFor(receipt, args[1]) ||
        receipt.code != args[2] || receipt.cause_ir != args[3] {
        Die("zone spawn public diagnostic receipt is missing or drifted");
    }
    Log("zone spawn semantic verdict and public receipt verified");
}
