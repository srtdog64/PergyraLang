struct Pair
{
    first: Array<Int>;
    second: Array<Int>;
}

func Make() -> Pair
{
    let rows: Array<Int> = [1];
    let pair: Pair = Pair(rows, rows);
    ArrayPush(pair.first, 2);
    return pair;
}

func Main() -> Void
{
    let pair: Pair = Make();
    Log(ArrayLength(pair.first));
    Log(ArrayLength(pair.second));
}
