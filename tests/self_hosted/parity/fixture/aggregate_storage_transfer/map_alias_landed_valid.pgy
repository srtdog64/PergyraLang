struct MapPair
{
    first: HashMap<String, Int>;
    second: HashMap<String, Int>;
}

func Make() -> MapPair
{
    let rows: HashMap<String, Int> = MapNew();
    let alias: HashMap<String, Int> = rows;
    var pair: MapPair = MapPair(rows, alias);
    MapSet(pair.first, "key", 1);
    return pair;
}

func Main() -> Void
{
    let pair: MapPair = Make();
    Log(MapSize(pair.first));
    Log(MapSize(pair.second));
}
