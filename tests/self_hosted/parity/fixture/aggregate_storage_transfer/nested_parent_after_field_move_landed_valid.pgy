struct Arena {
    texts: Array<String>;
    kinds: Array<Int>;
}

struct Rows {
    arena: Arena;
}

func Main() -> Int {
    let texts: Array<String> = [];
    ArrayPushOwnedString(texts, Concat("owned", "-value"));
    let kinds: Array<Int> = [7];
    let rows: Rows = Rows(Arena(texts, kinds));
    let moved: Array<String> = rows.arena.texts;
    ArrayPushOwnedString(moved, Concat("second", "-value"));
    let copied_parent: Arena = rows.arena;
    Log(ToString(ArrayLength(copied_parent.texts)));
    Log(ToString(ArrayLength(moved)));
    return 0;
}
