struct Pair
{
    first: Array<Int>;
    second: Array<Int>;
}

func Make() -> Pair
{
    var rows: Array<Int> = [];
    ArrayPush(rows, 1);
    ArrayPop(rows);
    var pair: Pair = Pair(rows, rows);
    ArrayPush(pair.first, 7);
    return pair;
}

func Main() -> Void
{
    let pair: Pair = Make();
    Log(ArrayLength(pair.first));
    Log(ArrayLength(pair.second));
}
