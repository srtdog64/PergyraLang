struct Rows { values: Array<String>; }

func Append(inout rows: Rows) -> Void {
    var values: Array<String> = rows.values;
    ArrayPushOwnedString(values, "x");
    rows.values = values;
}

func MakeRows() -> Rows {
    let rows: Rows = Rows([]);
    var alias: Rows = rows;
    Append(alias);
    return rows;
}

func Main() -> Void {
    var rows: Rows = MakeRows();
    Append(rows);
}
