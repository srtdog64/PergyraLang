// Exact nested lineage does not grant mutation without restoration. Returning
// the old aggregate would leave both fields pointing at retired descriptors.
struct NestedCarrierMissingArena {
    texts: Array<String>;
    call_target_names: Array<String>;
}

struct NestedCarrierMissingSequence {
    arena: NestedCarrierMissingArena;
}

func NestedCarrierMissingStore(
    inout values: Array<String>, value: String
) -> Void {
    ArrayPushOwnedString(values, value);
}

func NestedCarrierMissingImport(
    inout texts: Array<String>,
    inout call_target_names: Array<String>
) -> Void {
    NestedCarrierMissingStore(texts, "text");
    NestedCarrierMissingStore(call_target_names, "target");
}

func NestedCarrierMissingAppend(
    sequence: NestedCarrierMissingSequence
) -> NestedCarrierMissingSequence {
    let arena: NestedCarrierMissingArena = sequence.arena;
    var texts: Array<String> = arena.texts;
    var call_target_names: Array<String> = arena.call_target_names;
    NestedCarrierMissingImport(texts, call_target_names);
    return sequence;
}

func Main() -> Int {
    let sequence: NestedCarrierMissingSequence =
        NestedCarrierMissingSequence(
            NestedCarrierMissingArena([], []));
    let updated: NestedCarrierMissingSequence =
        NestedCarrierMissingAppend(sequence);
    return ArrayLength(updated.arena.texts);
}
