// Closed readonly aggregate use, not an opaque/default-mode exemption.
struct Rows { values: Array<String>; }
func Observe(rows: Rows) -> Void { Log(ArrayLength(rows.values)); }
func Append(inout rows: Rows) -> Void {
    var values: Array<String> = rows.values;
    ArrayPushOwnedString(values, "x");
    rows.values = values;
    Observe(rows);
}
func Main() -> Void { var rows: Rows = Rows([]); Append(rows); }
