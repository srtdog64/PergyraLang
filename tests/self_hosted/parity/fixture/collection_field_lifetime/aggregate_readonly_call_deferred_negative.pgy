struct Table { names: Array<String>; }
func Deferred(table: Table) -> Bool {
    defer { Log(ArrayLength(table.names)); }
    return true;
}
func Observe(ref table: Table) -> Bool { return Deferred(table); }
func Retire(inout table: Table) -> Void {
    let names: Array<String> = table.names;
    ArrayDropOwnedStrings(names);
    table.names = names;
}
func Main() -> Void {
    let names: Array<String> = [];
    let table: Table = Table(names);
    let observed: Bool = Observe(table);
    Retire(table);
}
