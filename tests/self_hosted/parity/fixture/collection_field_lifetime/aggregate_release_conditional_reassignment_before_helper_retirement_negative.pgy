// A conditional replacement cannot end the original member loan on every path.
struct Table { names: Array<String>; }

func Retire(inout table: Table) -> Void {
    let names: Array<String> = table.names;
    ArrayDropOwnedStrings(names);
    table.names = names;
}

func Observe(inout table: Table, flag: Bool) -> Int {
    var text: String = table.names[0];
    if flag { text = Concat("", "safe"); }
    Retire(table);
    return StringLength(text);
}

func Main() -> Void {
    var names: Array<String> = [];
    ArrayPushOwnedString(names, "owned");
    var table: Table = Table(names);
    Log(Observe(table, false));
}
