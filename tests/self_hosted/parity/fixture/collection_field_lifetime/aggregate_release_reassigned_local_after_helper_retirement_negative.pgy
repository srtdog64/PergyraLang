struct Table {
    names: Array<String>;
}

func Retire(inout table: Table) -> Void {
    let names: Array<String> = table.names;
    ArrayDropOwnedStrings(names);
    table.names = names;
}

func Observe(inout table: Table) -> Int {
    let text: String = "";
    text = table.names[0];
    Retire(table);
    return StringLength(text);
}

func Main() -> Void {
    let names: Array<String> = [];
    ArrayPushOwnedString(names, "owned");
    let table: Table = Table(names);
    Log(Observe(table));
}
