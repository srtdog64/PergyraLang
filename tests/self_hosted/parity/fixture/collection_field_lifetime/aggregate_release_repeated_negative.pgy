import "../../../../../src/self_hosted/semantic/ast_expression_function_table_fact_owner.pgy";

func Main() -> Void {
    let names: Array<String> = [];
    let returns: Array<String> = [];
    let params: Array<String> = [];
    let callables: SemanticCallableNameTable = SemanticCallableNameTableFromNames(names);
    let facts: SemanticAstExpressionFunctionTableFacts =
        SemanticAstExpressionFunctionTableFacts(
            true, names, returns, params, callables);
    SemanticAstExpressionFunctionTableFactsRelease(facts);
    SemanticAstExpressionFunctionTableFactsRelease(facts);
}
