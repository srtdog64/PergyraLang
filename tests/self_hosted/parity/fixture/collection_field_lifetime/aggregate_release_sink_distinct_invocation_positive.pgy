// Two releases reach one constructor site through separate calls of its
// producer: each call constructs its own tables.
import "../../../../../src/self_hosted/semantic/ast_expression_function_table_fact_owner.pgy";

struct TableHolder {
    tables: SemanticAstExpressionFunctionTableFacts;
    count: Int;
}

func HolderFromTables(tables: SemanticAstExpressionFunctionTableFacts) -> TableHolder {
    return TableHolder(tables, 1);
}

func HolderRelease(inout holder: TableHolder) -> Void {
    var tables: SemanticAstExpressionFunctionTableFacts = holder.tables;
    SemanticAstExpressionFunctionTableFactsRelease(tables);
    holder.tables = tables;
}

func OwnedTables() -> SemanticAstExpressionFunctionTableFacts {
    var names: Array<String> = [];
    var returns: Array<String> = [];
    var params: Array<String> = [];
    ArrayPushOwnedString(names, "OwnedCallable");
    ArrayPushOwnedString(returns, "Void");
    ArrayPushOwnedString(params, "");
    let callables: SemanticCallableNameTable = SemanticCallableNameTableFromNames(names);
    return SemanticAstExpressionFunctionTableFacts(true, names, returns, params, callables);
}

func ReleaseFresh() -> Void {
    var holder: TableHolder = HolderFromTables(OwnedTables());
    HolderRelease(holder);
}

func ReleaseFreshAgain() -> Void {
    var holder: TableHolder = HolderFromTables(OwnedTables());
    HolderRelease(holder);
}

func Main() -> Void {
    ReleaseFresh();
    ReleaseFreshAgain();
}
