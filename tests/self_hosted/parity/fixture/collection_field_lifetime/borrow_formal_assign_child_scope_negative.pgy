func Opaque(inout values: Array<String>) -> Void {
    ArrayPush(values, "opaque");
}

func Observe(ref values: Array<String>) -> Void {
    var alias: Array<String> = [];
    if true {
        alias = values;
        Opaque(alias);
    }
}

func Main() -> Void {
    let values: Array<String> = ["borrowed"];
    Observe(values);
}
