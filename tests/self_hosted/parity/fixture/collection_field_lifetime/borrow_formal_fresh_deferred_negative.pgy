func Metadata(own values: Array<String>) -> Int { return ArrayLength(values); }
func Opaque(inout values: Array<String>) -> Void { ArrayPush(values, "opaque"); }
func Observe(ref values: Array<String>) -> Int {
    let alias: Array<String> = values;
    defer { Opaque(alias); }
    alias = Clone(values);
    return Metadata(alias);
}
func Main() -> Void { let values: Array<String> = ["borrowed"]; Log(Observe(values)); }
