func Metadata(own values: Array<String>) -> Int { return ArrayLength(values); }
func Forward(ref values: Array<String>, own supplied: Array<String>) -> Int {
    let alias: Array<String> = values;
    alias = supplied;
    return Metadata(alias) + ArrayLength(values);
}
func Main() -> Void {
    let values: Array<String> = ["borrowed"];
    let supplied: Array<String> = ["separate"];
    Log(Forward(values, supplied));
}
