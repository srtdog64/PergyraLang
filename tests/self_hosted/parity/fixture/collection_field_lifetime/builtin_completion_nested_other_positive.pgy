func Stamp(inout values: Array<String>) -> String {
    ArrayPushOwnedString(values, "nested");
    return "outer";
}
func Main() -> Void {
    var a: Array<String> = [];
    var b: Array<String> = [];
    ArrayPushOwnedString(a, Stamp(b));
    ArrayDropOwnedStrings(a);
    ArrayDropOwnedStrings(b);
}
