// User identity suppresses builtin selection; this formal is unused.
func StringLength(value: String) -> Int {
    return 1;
}

func ObserveIndexedString(values: Array<String>) -> Bool {
    return StringLength(values[0]) > 0;
}

func Main() -> Void {
    let values: Array<String> = ["shadowed"];
    Log(ObserveIndexedString(values));
}
