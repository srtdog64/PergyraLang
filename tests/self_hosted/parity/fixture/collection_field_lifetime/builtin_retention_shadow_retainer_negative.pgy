func StringLength(value: String) -> String {
    return value;
}

func EscapeIndexedString(values: Array<String>) -> String {
    return StringLength(values[0]);
}

func Main() -> Void {
    let values: Array<String> = [];
    ArrayPushOwnedString(values, "retained");
    Log(EscapeIndexedString(values));
    ArrayDropOwnedStrings(values);
}
