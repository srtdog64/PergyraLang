func StoreIndexedString(
    values: Array<String>,
    inout destination: Array<String>
) -> Void {
    ArrayPush(destination, values[0]);
}

func Main() -> Void {
    var values: Array<String> = [];
    ArrayPushOwnedString(values, "stored");
    var destination: Array<String> = [];
    StoreIndexedString(values, destination);
    ArrayDropOwnedStrings(values);
    Log(destination[0]);
}
