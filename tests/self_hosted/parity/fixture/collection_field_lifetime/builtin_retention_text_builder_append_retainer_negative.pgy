// A real name-shadow retention test, without an inadmissible resource formal.
func TextBuilderAppend(value: String) -> String {
    return value;
}

func EscapeIndexedString(values: Array<String>) -> String {
    return TextBuilderAppend(values[0]);
}

func Main() -> Void {
    let values: Array<String> = ["retained"];
    Log(EscapeIndexedString(values));
}
