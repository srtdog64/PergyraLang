func ObserveIndexedString(values: Array<String>) -> String {
    if StringIndexOf(values[0], "observed") >= 0 { return "observed"; }
    return "";
}

func Main() -> Void {
    let values: Array<String> = [];
    ArrayPushOwnedString(values, "observed");
    Log(ObserveIndexedString(values));
    ArrayDropOwnedStrings(values);
}
