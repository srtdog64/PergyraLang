// Real producer/release component control; not installed DRV-2 acceptance.
// Input identity is repository-relative: run this probe from the repository root.
import "../../../../../src/self_hosted/parser/program_parse_owner.pgy";
import "../../../../../src/self_hosted/semantic/ast_expression_environment_owner.pgy";

func Main() -> Void with caps io_read
{
    let artifact: AstTreeArtifact = ParseRootProgramArtifact(
        "tests/self_hosted/parity/fixture/collection_field_lifetime/callable_table_producer_input.pgy");
    if !AstTreeArtifactReady(artifact)
    {
        Log("producer-artifact-invalid");
        Exit(1);
    }
    let signatures: SemanticAstFunctionSignatureFacts =
        SemanticAstFunctionSignatureFactsWithBuiltinNames(artifact);
    let constructors: SemanticAstNominalConstructorFacts =
        SemanticAstNominalConstructorFactsFromArtifact(artifact);
    let enums: SemanticAstEnumFacts = SemanticAstEnumFactsFromArtifact(artifact);
    let facts: SemanticAstExpressionFunctionTableFacts =
        SemanticAstExpressionFunctionTableFactsFromArtifact(
            artifact, signatures, constructors, enums);
    if !SemanticAstExpressionFunctionTableFactsReady(facts)
    {
        Log("producer-table-invalid");
        Exit(1);
    }
    let row: Int = SemanticAstExpressionFunctionRowIndex(
        facts.names, "CandidateValue");
    if row < 0
    {
        Log("producer-user-row-missing");
        Exit(1);
    }
    if facts.returns[row] != "Int" || facts.params[row] != "Candidate"
    {
        Log("producer-user-row-mismatch");
        Exit(1);
    }
    SemanticAstExpressionFunctionTableFactsRelease(facts);
    if facts.ok || SemanticAstExpressionFunctionTableFactsReady(facts) ||
        ArrayLength(facts.names) != 0 || ArrayLength(facts.returns) != 0 ||
        ArrayLength(facts.params) != 0
    {
        Log("producer-table-retirement-invalid");
        Exit(1);
    }
    Log("producer-table-retired");
}
