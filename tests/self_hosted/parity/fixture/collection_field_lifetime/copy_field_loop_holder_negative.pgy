struct CopyPair {
    left: Array<String>;
    right: Array<String>;
}
func CopyGrow(pair: CopyPair) -> CopyPair {
    var left: Array<String> = pair.left;
    ArrayPush(left, "g");
    return CopyPair(left, pair.right);
}
func Main() -> Void {
    let left: Array<String> = ["l"];
    let right: Array<String> = ["r"];
    let spare: Array<String> = [];
    var pair: CopyPair = CopyPair(left, right);
    let kept: CopyPair = CopyPair(pair.left, spare);
    while ArrayLength(kept.left) < 3 {
        pair = CopyGrow(pair);
    }
}
