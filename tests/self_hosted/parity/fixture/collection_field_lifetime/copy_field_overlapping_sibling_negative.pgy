struct CopyPair {
    left: Array<String>;
    right: Array<String>;
}
func CopyGrow(pair: CopyPair) -> CopyPair {
    let left: Array<String> = pair.left;
    ArrayPush(left, "g");
    return CopyPair(left, pair.right);
}
func Main() -> Void {
    let left: Array<String> = ["l"];
    let right: Array<String> = ["r"];
    let spare: Array<String> = [];
    let pair: CopyPair = CopyPair(left, right);
    let first: CopyPair = CopyPair(pair.left, spare);
    let second: CopyPair = CopyPair(pair.left, spare);
    first = CopyGrow(first);
    Log(ArrayLength(second.left));
}
