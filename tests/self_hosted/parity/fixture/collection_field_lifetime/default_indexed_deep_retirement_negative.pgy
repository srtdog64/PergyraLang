// Compile/admission only: body presence does not grant borrowed retirement.
func CopySelected(values: Array<String>) -> String {
    let copied: String = Concat("", values[0]);
    ArrayDropOwnedStrings(values);
    return copied;
}
func Main() -> Void {
    let values: Array<String> = [];
    ArrayPushOwnedString(values, "owned");
    Log(CopySelected(values));
}
