func PickText(values: Array<String>) -> String {
    return values[0];
}
func ReplaceText(inout values: Array<String>) -> Void {
    ArraySet(values, 0, "replacement");
}
func ForwardAndReplace(inout values: Array<String>) -> String {
    let text: String = PickText(values);
    ReplaceText(values);
    return text;
}
func ReadText(values: Array<String>) -> Bool {
    return values[0] == "replacement";
}
func Main() -> Void {
    let values: Array<String> = ["a"];
    let text: String = ForwardAndReplace(values);
    Log(ToString(ReadText(values)));
    Log(text);
}
