func PickText(values: Array<String>) -> String {
    return values[0];
}
func ForwardText(values: Array<String>) -> String {
    return PickText(values);
}
func ReadText(values: Array<String>) -> Bool {
    return values[0] == "a";
}
func Main() -> Void {
    let values: Array<String> = ["a"];
    let text: String = ForwardText(values);
    Log(ToString(ReadText(values)));
    Log(text);
}
