event OnText(value: Int);
func RetainText(values: Array<String>) -> String {
    OnText += (ignored: Int) => {
        Log(values[0]);
    };
    return values[0];
}
func Main() -> Void {
    let values: Array<String> = ["a"];
    let text: String = RetainText(values);
    Log(values[0]);
    Log(text);
}
