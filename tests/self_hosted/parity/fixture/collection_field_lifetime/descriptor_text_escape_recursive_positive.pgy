func RecursiveTextA(ref values: Array<String>, remaining: Int) -> String {
    return RecursiveTextB(values, remaining);
}
func RecursiveTextB(ref values: Array<String>, remaining: Int) -> String {
    if remaining > 0 {
        return RecursiveTextA(values, remaining - 1);
    }
    return values[0];
}
func ReadText(values: Array<String>) -> Bool {
    return values[0] == "a";
}
func Main() -> Void {
    let values: Array<String> = ["a"];
    let text: String = RecursiveTextA(values, 1);
    Log(ToString(ReadText(values)));
    Log(text);
}
