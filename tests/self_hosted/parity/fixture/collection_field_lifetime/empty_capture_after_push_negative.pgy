struct CapturedNames
{
    left: Array<String>;
    right: Array<String>;
}

func Retire(inout names: CapturedNames) -> Void
{
    let left: Array<String> = names.left;
    let right: Array<String> = names.right;
    ArrayDropOwnedStrings(left);
    ArrayDropOwnedStrings(right);
    names.left = left;
    names.right = right;
}

func Main() -> Void
{
    var seed: Array<String> = [];
    ArrayPushOwnedString(seed, "shared");
    var names: CapturedNames = CapturedNames(seed, seed);
    Retire(names);
}
