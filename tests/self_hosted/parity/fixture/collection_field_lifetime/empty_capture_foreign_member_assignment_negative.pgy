struct CapturedNames
{
    left: Array<String>;
    right: Array<String>;
}
func Retire(inout names: CapturedNames) -> Void
{
    let left: Array<String> = names.left;
    let right: Array<String> = names.right;
    ArrayDropOwnedStrings(left);
    ArrayDropOwnedStrings(right);
    names.left = left;
    names.right = right;
}
func Main() -> Void
{
    let otherSeed: Array<String> = [];
    let other: CapturedNames = CapturedNames(otherSeed, otherSeed);
    ArrayPushOwnedString(other.left, "other");
    let seed: Array<String> = [];
    let names: CapturedNames = CapturedNames(seed, seed);
    ArrayPushOwnedString(names.left, "names");
    names.right = other.left;
    Retire(names);
    Log(ArrayLength(other.left));
}
