struct CapturedNames
{
    left: Array<String>;
    right: Array<String>;
}
func Retire(inout names: CapturedNames) -> Void
{
    let left: Array<String> = names.left;
    let right: Array<String> = names.right;
    ArrayDropOwnedStrings(left);
    ArrayDropOwnedStrings(right);
    names.left = left;
    names.right = right;
}

struct OuterNames
{
    inner: CapturedNames;
}
func Main() -> Void
{
    let seed: Array<String> = [];
    let names: CapturedNames = CapturedNames(seed, seed);
    let outer: OuterNames = OuterNames(names);
    ArrayPushOwnedString(outer.inner.left, "owned");
    outer.inner.right = outer.inner.left;
    let moved: CapturedNames = outer.inner;
    Retire(moved);
    outer.inner = moved;
}
