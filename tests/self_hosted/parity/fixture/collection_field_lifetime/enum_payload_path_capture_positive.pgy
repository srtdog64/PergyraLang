// The payload path the MIR round trip writes for a match binding, spelled
// directly: an owned subject's aggregate payload bound by a `let`.
struct Table { names: Array<String>; }
enum Holder {
    Full(Table),
    Empty,
}
func Count(holder: Holder) -> Int {
    if holder == Holder.Full {
        let table: Table = holder.Full._0;
        return ArrayLength(table.names);
    }
    return 0;
}
func Main() -> Void {
    let names: Array<String> = [];
    ArrayPushOwnedString(names, "owned");
    let holder: Holder = Holder.Full(Table(names));
    if Count(holder) != 1 { Exit(1); }
}
