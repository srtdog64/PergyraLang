// The call lives across passes: `left = call` comes after the join, but the
// next pass runs it before the next join, which then grows the rows `left`
// still holds.
struct Rows {
    ok: Bool;
    names: Array<String>;
}

func RowsFresh() -> Rows {
    let names: Array<String> = ["c"];
    return Rows(true, names);
}

func RowsJoin(rows: Rows, other: Rows) -> Rows {
    let names: Array<String> = rows.names;
    ArrayPush(names, ToString(ArrayLength(other.names)));
    return Rows(rows.ok && other.ok, names);
}

func RowsPipe(seed: Array<String>, count: Int) -> Rows {
    let left: Rows = Rows(true, seed);
    let call: Rows = RowsFresh();
    let index: Int = 0;
    while index < count {
        call = RowsJoin(call, left);
        if !call.ok { return call; }
        left = call;
        index = index + 1;
    }
    return left;
}

func Main() -> Int {
    let seed: Array<String> = ["s"];
    let rows: Rows = RowsPipe(seed, 3);
    Log(ToString(ArrayLength(rows.names)));
    return 0;
}
