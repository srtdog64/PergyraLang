// An exclusive member alias grows through an inout formal and is read again
// in the next iteration; each write-back leaves it current.
struct NodeSet {
    valid: Bool;
    types: Array<String>;
}

func AppendNode(inout types: Array<String>, name: String) -> Void {
    ArrayPush(types, name);
}

func ReadAt(ref types: Array<String>, at: Int) -> String {
    if at < 0 || at >= ArrayLength(types) { return ""; }
    return Concat("", types[at]);
}

func Append(facts: NodeSet, count: Int) -> NodeSet {
    let types: Array<String> = facts.types;
    let node: Int = 0;
    while node < count {
        let left: String = ReadAt(types, node - 1);
        AppendNode(types, Concat(left, "t"));
        node = node + 1;
    }
    return NodeSet(facts.valid, types);
}

func Main() -> Int {
    let types: Array<String> = ["x"];
    let facts: NodeSet = NodeSet(true, types);
    facts = Append(facts, 3);
    return ArrayLength(facts.types);
}
