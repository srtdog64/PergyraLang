// Two sets built from one array share its buffer.
struct NodeSet {
    valid: Bool;
    types: Array<String>;
}

func NodeSetAddInt(facts: NodeSet) -> NodeSet {
    let types: Array<String> = facts.types;
    ArrayPush(types, "Int"); ArrayPush(types, "Bool"); ArrayPush(types, "Long"); ArrayPush(types, "Char");
    return NodeSet(true, types);
}

func Main() -> Int {
    let types: Array<String> = ["x"];
    let kept: NodeSet = NodeSet(true, types);
    let grown: NodeSet = NodeSet(true, types);
    grown = NodeSetAddInt(grown);
    return StringLength(kept.types[0]) + ArrayLength(grown.types);
}
