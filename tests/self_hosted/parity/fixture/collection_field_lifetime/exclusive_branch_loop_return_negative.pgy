// The other branch runs in a later iteration, after the growth.
struct NodeSet {
    valid: Bool;
    types: Array<String>;
}

func NodeSetPickUntil(facts: NodeSet, count: Int) -> NodeSet {
    let types: Array<String> = facts.types;
    let index: Int = 0;
    while index < count {
        if index == 0 {
            ArrayPush(types, "a"); ArrayPush(types, "b"); ArrayPush(types, "c"); ArrayPush(types, "d");
        } else {
            return facts;
        }
        index = index + 1;
    }
    return NodeSet(facts.valid, types);
}

func Main() -> Int {
    let types: Array<String> = ["x"];
    let facts: NodeSet = NodeSet(true, types);
    facts = NodeSetPickUntil(facts, 3);
    return StringLength(facts.types[0]);
}
