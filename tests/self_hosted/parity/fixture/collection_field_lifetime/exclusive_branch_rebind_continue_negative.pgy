// One branch goes to the next pass without rebinding: that pass appends to
// the rows the previous append took.
struct Rows {
    ok: Bool;
    names: Array<String>;
}

func RowsAdd(rows: Rows, name: String) -> Rows {
    let names: Array<String> = rows.names;
    ArrayPush(names, name);
    return Rows(rows.ok, names);
}

func RowsFill(seed: Array<String>, limit: Int) -> Rows {
    let rows: Rows = Rows(true, seed);
    let index: Int = 0;
    while index < limit {
        let added: Rows = RowsAdd(rows, "x");
        if index == 1 {
            rows = added;
        } else {
            index = index + 1;
            continue;
        }
        index = index + 1;
    }
    return rows;
}

func Main() -> Int {
    let seed: Array<String> = ["s"];
    let rows: Rows = RowsFill(seed, 4);
    Log(ToString(ArrayLength(rows.names)));
    return 0;
}
