// Both branches rebind the rows, but one reads the old rows first: the
// append took them, so that read sees retired storage.
struct Rows {
    ok: Bool;
    names: Array<String>;
}

func RowsAdd(rows: Rows, name: String) -> Rows {
    let names: Array<String> = rows.names;
    ArrayPush(names, name);
    return Rows(rows.ok, names);
}

func RowsFill(seed: Array<String>, limit: Int) -> Int {
    let rows: Rows = Rows(true, seed);
    let total: Int = 0;
    let index: Int = 0;
    while index < limit {
        let added: Rows = RowsAdd(rows, "x");
        if index == 1 {
            rows = added;
        } else {
            total = total + StringLength(rows.names[0]);
            rows = added;
        }
        index = index + 1;
    }
    return total + ArrayLength(rows.names);
}

func Main() -> Int {
    let seed: Array<String> = ["s"];
    Log(ToString(RowsFill(seed, 4)));
    return 0;
}
