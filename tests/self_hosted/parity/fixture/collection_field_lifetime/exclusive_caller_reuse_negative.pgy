// The caller reads the set after a sink grew its field buffer.
struct NodeSet {
    valid: Bool;
    types: Array<String>;
}

func NodeSetAddInt(facts: NodeSet) -> NodeSet {
    let types: Array<String> = facts.types;
    ArrayPush(types, "Int");
    ArrayPush(types, "Bool");
    ArrayPush(types, "Long");
    ArrayPush(types, "Char");
    ArrayPush(types, "Float");
    return NodeSet(true, types);
}

func Main() -> Int {
    let types: Array<String> = ["String"];
    let facts: NodeSet = NodeSet(true, types);
    let grown: NodeSet = NodeSetAddInt(facts);
    return StringLength(facts.types[0]) + ArrayLength(grown.types);
}
