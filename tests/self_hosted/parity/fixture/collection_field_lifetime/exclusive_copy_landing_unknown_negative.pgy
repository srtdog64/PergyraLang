// A call builds the holder, so where `rows` lands in it is unknown. The
// proof keeps `rows` a reader of every field: a precision boundary control
// for unknown landings, not a runtime unsafety claim.
struct Facts {
    rows: Array<String>;
    marks: Array<String>;
}

func FactsMake(rows: Array<String>, marks: Array<String>) -> Facts {
    return Facts(rows, marks);
}

func Build() -> Int {
    let rows: Array<String> = ["r"];
    let marks: Array<String> = [];
    let facts: Facts = FactsMake(rows, marks);
    let grown: Array<String> = facts.marks;
    ArrayPush(grown, "m");
    ArrayPush(grown, "n");
    facts.marks = grown;
    return StringLength(rows[0]) + ArrayLength(facts.marks);
}

func Main() -> Int {
    Log(ToString(Build()));
    return 0;
}
