// A failure value copied from the set leaves before the field grows.
struct NodeSet {
    valid: Bool;
    types: Array<String>;
}

func NodeSetGrowChecked(facts: NodeSet, fail: Bool) -> NodeSet {
    let invalid: NodeSet = NodeSet(false, facts.types);
    if fail { return invalid; }
    let types: Array<String> = facts.types;
    ArrayPush(types, "a"); ArrayPush(types, "b"); ArrayPush(types, "c"); ArrayPush(types, "d");
    return NodeSet(true, types);
}

func Main() -> Int {
    let types: Array<String> = ["x"];
    let facts: NodeSet = NodeSet(true, types);
    facts = NodeSetGrowChecked(facts, false);
    return ArrayLength(facts.types);
}
