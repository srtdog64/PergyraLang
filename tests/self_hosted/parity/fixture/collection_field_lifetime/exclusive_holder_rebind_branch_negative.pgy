// The holder is rebound on one path only; the other reads the copy the grower
// released.
struct Box {
    items: Array<String>;
}

struct Holder {
    box: Box;
}

func Grow(box: Box) -> Box {
    let items: Array<String> = box.items;
    ArrayPush(items, "g");
    ArrayPush(items, "g");
    return Box(items);
}

func Fresh() -> Holder {
    let none: Array<String> = ["f"];
    return Holder(Box(none));
}

func Run(box: Box, flag: Bool) -> Int {
    let holder: Holder = Holder(box);
    let grown: Box = Grow(box);
    if flag { holder = Fresh(); }
    return StringLength(holder.box.items[0]) + ArrayLength(grown.items);
}

func Main() -> Int {
    let items: Array<String> = ["x"];
    return Run(Box(items), false);
}
