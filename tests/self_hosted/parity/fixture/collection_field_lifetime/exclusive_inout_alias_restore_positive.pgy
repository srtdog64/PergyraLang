// A field alias of an inout formal grows and is restored.
struct NodeSet {
    valid: Bool;
    types: Array<String>;
}

func NodeSetAddInt(inout facts: NodeSet) -> Void {
    var types: Array<String> = facts.types;
    ArrayPush(types, "Int");
    facts.types = types;
}

func Main() -> Int {
    let types: Array<String> = [];
    var facts: NodeSet = NodeSet(true, types);
    NodeSetAddInt(facts);
    return ArrayLength(facts.types);
}
