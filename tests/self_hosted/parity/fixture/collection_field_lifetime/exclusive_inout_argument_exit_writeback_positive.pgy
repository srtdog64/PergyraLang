// Every exit after the inout set enters a grower writes the grown set back.
struct TypeList {
    items: Array<String>;
}

func TypeListGrow(list: TypeList, name: String) -> TypeList {
    let items: Array<String> = list.items;
    ArrayPush(items, name); ArrayPush(items, name); ArrayPush(items, name); ArrayPush(items, name);
    return TypeList(items);
}

func TypeListAddChecked(inout list: TypeList, name: String) -> Bool {
    let grown: TypeList = TypeListGrow(list, name);
    if name == "" {
        list = grown;
        return false;
    }
    list = grown;
    return true;
}

func Main() -> Int {
    let items: Array<String> = ["x"];
    let list: TypeList = TypeList(items);
    let added: Bool = TypeListAddChecked(list, "");
    if added { return 1; }
    return StringLength(list.items[0]);
}
