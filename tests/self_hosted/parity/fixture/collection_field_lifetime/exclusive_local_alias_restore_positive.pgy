// A field alias of an exclusive local grows and is restored.
struct NodeSet {
    valid: Bool;
    types: Array<String>;
}

func Main() -> Int {
    let types: Array<String> = [];
    var facts: NodeSet = NodeSet(true, types);
    var alias: Array<String> = facts.types;
    ArrayPush(alias, "Int");
    facts.types = alias;
    return ArrayLength(facts.types);
}
