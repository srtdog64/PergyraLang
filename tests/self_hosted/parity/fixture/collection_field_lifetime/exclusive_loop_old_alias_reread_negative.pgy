// The inner loop reads the outer binding again on each pass after the callee
// took its rows and the append grew them.
struct Rows {
    ok: Bool;
    names: Array<String>;
}

func RowsAdd(rows: Rows, name: String) -> Rows {
    var names: Array<String> = rows.names;
    ArrayPush(names, name);
    return Rows(rows.ok, names);
}

func RowsChain(seed: Array<String>, count: Int) -> Int {
    var base: Rows = Rows(true, seed);
    var total: Int = 0;
    var outer: Int = 0;
    while outer < count {
        var callee: Rows = base;
        var inner: Int = 0;
        while inner < 2 {
            total = total + StringLength(base.names[0]);
            callee = RowsAdd(callee, "g");
            inner = inner + 1;
        }
        base = callee;
        outer = outer + 1;
    }
    return total + ArrayLength(base.names);
}

func Main() -> Int {
    let seed: Array<String> = ["s"];
    Log(ToString(RowsChain(seed, 3)));
    return 0;
}
