func Seeded() -> HashMap<String, Int> {
    var table: HashMap<String, Int> = MapNew();
    MapSet(table, "seed", 1);
    return table;
}

func Main() -> Int {
    let table: HashMap<String, Int> = Seeded();
    var copy: HashMap<String, Int> = table;
    MapRemove(copy, "seed");
    return MapSize(table);
}
