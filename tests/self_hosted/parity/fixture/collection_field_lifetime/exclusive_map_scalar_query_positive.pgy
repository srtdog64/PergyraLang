struct MapState { entries: HashMap<String, Int>; }

func Insert(inout state: MapState) -> Void {
    let entries: HashMap<String, Int> = state.entries;
    if MapHas(entries, "stop") && MapGet(entries, "stop") == 1 { return; }
    MapSet(entries, "value", 2);
    state.entries = entries;
}

func Main() -> Int {
    let entries: HashMap<String, Int> = MapNew();
    MapSet(entries, "stop", 0);
    let copied_value: Int = MapGet(entries, "stop");
    let state: MapState = MapState(entries);
    Insert(state);
    let final_entries: HashMap<String, Int> = state.entries;
    let stored_value: Int = MapGet(final_entries, "value");
    if copied_value != 0 || stored_value != 2 { return 1; }
    return 0;
}
