// The rows nested two fields down are copied and grown; the callee reads
// the enclosing field whole and hands it on, so it reaches the retired
// buffer through the prefix.
struct Inner {
    rows: Array<Int>;
    names: Array<String>;
}

struct Outer {
    ok: Bool;
    inner: Inner;
}

func InnerRow(inner: Inner) -> Int {
    return inner.rows[1];
}

func FirstRow(outer: Outer) -> Int {
    return InnerRow(outer.inner);
}

func Grow(outer: Outer) -> Int {
    let rows: Array<Int> = outer.inner.rows;
    ArrayPush(rows, 2);
    ArrayPush(rows, 3);
    ArrayPush(rows, 4);
    return FirstRow(outer) + rows[3];
}

func Main() -> Int {
    let outer: Outer = Outer(true, Inner([1], ["a"]));
    Log(ToString(Grow(outer)));
    return 0;
}
