// Returning the set after its alias grew returns the freed buffer.
struct NodeSet {
    valid: Bool;
    types: Array<String>;
}

func NodeSetGrow(facts: NodeSet, fail: Bool) -> NodeSet {
    var types: Array<String> = facts.types;
    ArrayPush(types, "a"); ArrayPush(types, "b"); ArrayPush(types, "c"); ArrayPush(types, "d");
    if fail { return facts; }
    return NodeSet(true, types);
}

func Main() -> Int {
    let types: Array<String> = ["x"];
    var facts: NodeSet = NodeSet(true, types);
    facts = NodeSetGrow(facts, true);
    return StringLength(facts.types[0]);
}
