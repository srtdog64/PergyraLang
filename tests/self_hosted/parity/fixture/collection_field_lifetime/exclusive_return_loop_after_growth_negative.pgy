// A return earlier in the loop body runs after the growth of a previous
// iteration.
struct NodeSet {
    valid: Bool;
    types: Array<String>;
}

func NodeSetGrowUntil(facts: NodeSet, count: Int) -> NodeSet {
    var types: Array<String> = facts.types;
    var index: Int = 0;
    while index < count {
        if index == 3 { return facts; }
        ArrayPush(types, "a");
        index = index + 1;
    }
    return NodeSet(true, types);
}

func Main() -> Int {
    let types: Array<String> = ["x"];
    var facts: NodeSet = NodeSet(true, types);
    facts = NodeSetGrowUntil(facts, 5);
    return StringLength(facts.types[0]);
}
