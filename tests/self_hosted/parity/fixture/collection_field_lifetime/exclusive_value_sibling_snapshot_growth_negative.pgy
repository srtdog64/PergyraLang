// Repacking member aliases into another live value keeps the old array
// descriptors alive, so growing either alias must fail closed.
struct PairRows {
    left: Array<Int>;
    right: Array<Int>;
}

func GrowAfterSnapshot(rows: PairRows) -> PairRows {
    var left: Array<Int> = rows.left;
    let right: Array<Int> = rows.right;
    let snapshot: PairRows = PairRows(left, right);
    ArrayPush(left, 3);
    return snapshot;
}

func Main() -> Int {
    var rows: PairRows = PairRows([1], [2]);
    rows = GrowAfterSnapshot(rows);
    return ArrayLength(rows.left);
}
