struct Carrier { values: Array<String>; }
func FindIndex(values: Array<String>, name: String) -> Int {
    let row: Int = 0;
    while row < ArrayLength(values) {
        if values[row] == name { return row; }
        row = row + 1;
    }
    return -1;
}
func Main() -> Void {
    let seed: Array<String> = ["owned"];
    let values: Array<String> = Clone(seed);
    let record: Carrier = Carrier(values);
    Log(FindIndex(values, "owned") + ArrayLength(record.values));
}
