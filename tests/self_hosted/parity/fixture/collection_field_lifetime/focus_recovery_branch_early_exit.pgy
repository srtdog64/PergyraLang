struct Rows { types: Array<String>; }
func BranchCapture(inout rows: Rows, grow: Bool, should_fail: Bool) -> Bool
{
    var types: Array<String> = rows.types;
    if !grow { return false; }
    var count: Int = 0;
    while count < 8 {
        ArrayPush(types, "row");
        count = count + 1;
    }
    if should_fail { return false; }
    rows.types = types;
    return true;
}
func Main() -> Void
{
    var rows: Rows = Rows(["seed"]);
    Log(BranchCapture(rows, false, false));
    Log(ArrayLength(rows.types));
    Log(BranchCapture(rows, true, true));
    Log(ArrayLength(rows.types));
    Log(rows.types[ArrayLength(rows.types) - 1]);
}
