struct Rows { types: Array<String>; }
func Capture(inout rows: Rows, json: String) -> Int
{
    let extent: Int = StringLength(json);
    if extent < 2 || CharCode(json, extent, 0) != 91 { return -1; }
    let types: Array<String> = rows.types;
    let cursor: Int = 1;
    while cursor < extent {
        if CharCode(json, extent, cursor) == 93 {
            if cursor + 1 != extent { rows.types = types; return -1; }
            rows.types = types;
            return ArrayLength(types);
        }
        if cursor + 2 >= extent || CharCode(json, extent, cursor) != 91 ||
            CharCode(json, extent, cursor + 1) != 48 || CharCode(json, extent, cursor + 2) != 93 { rows.types = types; return -1; }
        ArrayPush(types, "row");
        cursor = cursor + 3;
        if cursor >= extent { rows.types = types; return -1; }
        if CharCode(json, extent, cursor) == 44 {
            cursor = cursor + 1;
            if cursor >= extent || CharCode(json, extent, cursor) != 91 { rows.types = types; return -1; }
        }
        else if CharCode(json, extent, cursor) != 93 { rows.types = types; return -1; }
    }
    rows.types = types; return -1;
}
func Main() -> Void
{
    let rows: Rows = Rows(["seed"]);
    Log(Capture(rows, "[[0],[0],[0],[0],[0],[0],[0],[0],bad]"));
    Log(ArrayLength(rows.types));
    Log(rows.types[0]);
    Log(rows.types[8]);
}
