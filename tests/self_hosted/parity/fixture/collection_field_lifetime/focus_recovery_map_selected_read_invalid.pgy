struct FocusMapRows
{
    values: HashMap<String, Int>;
    paths: Array<Int>;
}
func Count(rows: FocusMapRows) -> Int
{
    return ArrayLength(rows.paths);
}
func Path(inout rows: FocusMapRows) -> Void
{
    var paths: Array<Int> = rows.paths;
    ArrayPush(paths, 9);
    rows.paths = paths;
}
func SelectedCount(rows: FocusMapRows) -> Int
{
    if !MapHas(rows.values, "seed") { return 0; }
    return MapGet(rows.values, "seed");
}
func Populate(inout rows: FocusMapRows, shouldReturn: Bool) -> Int
{
    var oldHolder: HashMap<String, Int> = rows.values;
    if shouldReturn
    {
        MapSet(oldHolder, "early", 99);
        let completedCount: Int = MapSize(oldHolder);
        rows.values = oldHolder;
        return completedCount;
    }
    var values: HashMap<String, Int> = rows.values;
    Path(rows);
    var index: Int = 0;
    while index < 40
    {
        MapSet(values, ToString(index), index);
        index = index + 1;
    }
    let priorPaths: Int = SelectedCount(rows);
    MapRemove(values, "0");
    let completedCount: Int = MapSize(values);
    rows.values = values;
    return completedCount + priorPaths;
}

func Main() -> Void
{
    var values: HashMap<String, Int> = MapNew();
    MapSet(values, "seed", 7);
    var rows: FocusMapRows = FocusMapRows(values, [1]);
    Log(Populate(rows, false));
}
