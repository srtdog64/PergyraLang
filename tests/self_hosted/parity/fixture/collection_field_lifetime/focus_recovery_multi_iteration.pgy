struct Rows { types: Array<String>; }
func RepeatedCapture(inout rows: Rows) -> Bool
{
    var types: Array<String> = rows.types;
    var round: Int = 0;
    while round < 3
    {
        var count: Int = 0;
        while count < 8
        {
            ArrayPush(types, "row");
            count = count + 1;
        }
        round = round + 1;
    }
    return false;
}
func Main() -> Void
{
    var rows: Rows = Rows(["seed"]);
    Log(RepeatedCapture(rows));
    Log(ArrayLength(rows.types));
    Log(rows.types[ArrayLength(rows.types) - 1]);
}
