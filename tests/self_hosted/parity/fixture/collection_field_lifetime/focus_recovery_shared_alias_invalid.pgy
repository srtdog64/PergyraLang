struct Rows { types: Array<String>; }
func CaptureShared(inout rows: Rows) -> Bool
{
    let kept: Rows = rows;
    var types: Array<String> = rows.types;
    var count: Int = 0;
    while count < 8 { ArrayPush(types, "row"); count = count + 1; }
    Log(kept.types[0]);
    rows.types = types;
    return true;
}
func Main() -> Void
{
    var rows: Rows = Rows(["seed"]);
    Log(CaptureShared(rows));
}
