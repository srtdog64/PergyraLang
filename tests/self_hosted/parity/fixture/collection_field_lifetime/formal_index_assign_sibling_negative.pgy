// Indexed assignment through an inout formal is a shallow mutation like
// ArraySet, not a read: the record's copy of the array is a sibling the call
// invalidates, and it is read afterwards.
struct Carrier {
    values: Array<String>;
}

func Blank(inout values: Array<String>) -> Void {
    values[0] = "";
}

func Main() -> Int {
    let values: Array<String> = ["a"];
    let record: Carrier = Carrier(values);
    Blank(values);
    Log(record.values[0]);
    return 0;
}
