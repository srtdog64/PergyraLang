func EscapeCycleA(ref values: Array<String>) -> String {
    return EscapeCycleB(values);
}

func EscapeCycleB(ref values: Array<String>) -> String {
    if ArrayLength(values) == 0 {
        return EscapeCycleA(values);
    }
    return values[0];
}

func Main() -> Void {
    let values: Array<String> = ["x"];
    Log(EscapeCycleA(values));
}
