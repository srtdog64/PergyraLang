func Observe(replace: Bool) -> Void {
    var values: Array<String> = [];
    ArrayPushOwnedString(values, "owned-value");
    var borrowed: String = values[0];
    if replace { borrowed = "replacement"; }
    ArrayDropOwnedStrings(values);
    Log(borrowed);
}

func Main() -> Void {
    Observe(false);
}
