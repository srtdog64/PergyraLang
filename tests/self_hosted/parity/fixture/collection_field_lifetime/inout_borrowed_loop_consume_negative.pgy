func Append(inout values: Array<String>, value: String) -> Void {
    ArrayPush(values, value);
}

func Consume(own values: Array<String>) -> Void {}

func Main() -> Void {
    var values: Array<String> = [];
    var i: Int = 0;
    while i < 2 {
        Append(values, "live");
        Consume(values);
        i = i + 1;
    }
}
