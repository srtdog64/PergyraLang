func Consume(own values: Array<String>) -> Void { ArrayDropOwnedStrings(values); }
func Copy(inout values: Array<String>) -> Void { ArrayPushOwnedString(values, "copied"); }
func Main() -> Void {
    let borrowed: Array<String> = ["borrowed"];
    let values: Array<String> = Clone(borrowed);
    if true { Consume(values); }
    Copy(values);
}
