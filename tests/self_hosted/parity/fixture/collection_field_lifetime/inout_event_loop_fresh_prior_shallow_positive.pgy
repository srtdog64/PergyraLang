func Append(inout values: Array<String>) -> Void {
    ArrayPush(values, "after");
}

func Main() -> Void {
    var iteration: Int = 0;
    while iteration < 2 {
        var values: Array<String> = [];
        var input: Int = 0;
        while input < 1 {
            ArrayPush(values, "before");
            input = input + 1;
        }
        Append(values);
        iteration = iteration + 1;
    }
}
