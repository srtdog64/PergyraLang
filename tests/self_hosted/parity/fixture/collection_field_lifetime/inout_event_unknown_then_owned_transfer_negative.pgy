func Borrow(inout values: Array<String>) -> Void { ArrayPush(values, "borrowed"); }
func Consume(own values: Array<String>) -> Void { ArrayDropOwnedStrings(values); }
func Main() -> Void {
    let borrowed: Array<String> = ["owned"];
    let values: Array<String> = Clone(borrowed);
    Borrow(values);
    Consume(values);
}
