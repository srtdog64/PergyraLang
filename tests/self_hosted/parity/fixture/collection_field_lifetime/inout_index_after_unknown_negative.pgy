func Matches(values: Array<String>) -> Bool { return values[0] == "copied"; }
// Detached execution, not a callee name, makes this formal effect opaque.
func Opaque(inout values: Array<String>) -> Void {
    defer { ArrayPush(values, "borrowed"); }
}
func Main() -> Void
{
    let values: Array<String> = [];
    ArrayPushOwnedString(values, "copied");
    Opaque(values);
    Log(Matches(values));
}
