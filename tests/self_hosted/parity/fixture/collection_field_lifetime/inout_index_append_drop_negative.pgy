func ForwardElement(source: Array<String>, inout destination: Array<String>) -> Void
{
    ArrayPush(destination, source[0]);
}
func Main() -> Void
{
    var values: Array<String> = [];
    var destination: Array<String> = [];
    ArrayPushOwnedString(values, "copied");
    ForwardElement(values, destination);
    ArrayDropOwnedStrings(values);
}
