func Matches(values: Array<String>) -> Bool { return values[0] == "copied"; }
func Consume(own values: Array<String>) -> Void { ArrayDropOwnedStrings(values); }
func Main() -> Void
{
    var values: Array<String> = [];
    ArrayPushOwnedString(values, "copied");
    defer { Log(Matches(values)); }
    Consume(values);
}
