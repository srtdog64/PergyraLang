func FindIndex(values: Array<String>, name: String) -> Int
{
    let row: Int = 0;
    while row < ArrayLength(values)
    {
        if values[row] == name { return row; }
        row = row + 1;
    }
    return 0 - 1;
}
func Main() -> Void
{
    let values: Array<String> = [];
    ArrayPushOwnedString(values, "copied");
    let row: Int = FindIndex(values, "copied");
    ArrayDropOwnedStrings(values);
    Log(row);
}
