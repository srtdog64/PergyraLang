func Matches(values: Array<String>) -> Bool { return values[0] == "borrowed"; }
func Opaque(inout values: Array<String>) -> Void { ArrayPush(values, "borrowed"); }
func Forward(inout values: Array<String>) -> Void
{
    defer { Log(Matches(values)); }
    Opaque(values);
}
func Main() -> Void
{
    let values: Array<String> = ["borrowed"];
    Forward(values);
}
