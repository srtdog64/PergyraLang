func Expected() -> Option<String> { return Some("copied"); }
func Differs(values: Array<String>) -> Bool
{
    return values[0] != UnwrapOption(Expected());
}
func Main() -> Void
{
    let values: Array<String> = [];
    ArrayPushOwnedString(values, "copied");
    let different: Bool = Differs(values);
    ArrayDropOwnedStrings(values);
    Log(different);
}
