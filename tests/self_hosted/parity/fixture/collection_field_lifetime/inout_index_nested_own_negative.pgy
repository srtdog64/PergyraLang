func Matches(values: Array<String>, marker: Int) -> Bool { return values[0] == "copied"; }
func Consume(own values: Array<String>) -> Int { ArrayDropOwnedStrings(values); return 1; }
func Main() -> Void
{
    let values: Array<String> = [];
    ArrayPushOwnedString(values, "copied");
    Log(Matches(values, Consume(values)));
}
