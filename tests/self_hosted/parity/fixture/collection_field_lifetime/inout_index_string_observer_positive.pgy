func IndexedStringMatches(values: Array<String>) -> Bool {
    return values[0] == "observed";
}

func ObserveAndMatch(values: Array<String>) -> Bool {
    let length: Int = StringLength(values[0]);
    let observed: Bool = length > 0 &&
        CharCode(values[0], length, 0) > 0;
    return observed && IndexedStringMatches(values);
}

func Main() -> Void {
    let values: Array<String> = ["observed"];
    Log(ObserveAndMatch(values));
}
