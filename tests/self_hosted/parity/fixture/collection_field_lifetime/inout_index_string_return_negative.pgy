func EscapeIndexedString(value: String) -> String {
    return value;
}

func ReturnedIndexMatches(values: Array<String>) -> Bool {
    return values[0] == "escaped";
}

func EscapeAndMatch(values: Array<String>) -> String {
    let escaped: String = EscapeIndexedString(values[0]);
    if ReturnedIndexMatches(values) && escaped == "escaped" { return escaped; }
    return "";
}

func Main() -> Void {
    let values: Array<String> = [];
    ArrayPushOwnedString(values, "escaped");
    Log(EscapeAndMatch(values));
    ArrayDropOwnedStrings(values);
}
