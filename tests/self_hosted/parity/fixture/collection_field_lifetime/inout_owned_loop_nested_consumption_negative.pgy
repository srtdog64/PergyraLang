func Copy(inout values: Array<String>) -> Void { ArrayPushOwnedString(values, "copied"); }
func Retire(own values: Array<String>) -> Void { ArrayDropOwnedStrings(values); }
func Reads(ref values: Array<String>) -> Bool { return values[0] == "copied"; }
func Main() -> Void {
    var outer: Int = 0;
    while outer < 2 {
        var values: Array<String> = [];
        Copy(values);
        var inner: Int = 0;
        while inner < 2 {
            Log(Reads(values));
            Retire(values);
            inner = inner + 1;
        }
        outer = outer + 1;
    }
}
