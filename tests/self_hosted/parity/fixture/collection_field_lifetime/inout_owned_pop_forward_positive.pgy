func Retire(inout values: Array<String>) -> Void {
    ArrayPop(values);
}

func Forward(inout values: Array<String>) -> Void {
    Retire(values);
}

func Main() -> Void {
    let values: Array<String> = [];
    ArrayPush(values, "owned");
    Forward(values);
    Log(ArrayLength(values));
    ArrayDropOwnedStrings(values);
}
