func AppendUnique(inout uses: Array<String>, use_name: String) -> Void {
    let i: Int = 0;
    while i < ArrayLength(uses) {
        if uses[i] == use_name { return; }
        i = i + 1;
    }
    ArrayPushOwnedString(uses, use_name);
}
func Append(inout uses: Array<String>, ref source: Array<String>) -> Void {
    let i: Int = 0;
    while i < ArrayLength(source) {
        AppendUnique(uses, Concat("", source[i]));
        i = i + 1;
    }
}
func Main() -> Void {
    let source: Array<String> = [];
    ArrayPushOwnedString(source, "value.1");
    ArrayPushOwnedString(source, "value.1");
    ArrayPushOwnedString(source, "other.2");
    let uses: Array<String> = [];
    ArrayPushOwnedString(uses, "prefix.0");
    Append(uses, source);
    ArrayDropOwnedStrings(source);
    if ArrayLength(uses) != 3 || uses[0] != "prefix.0" ||
        uses[1] != "value.1" || uses[2] != "other.2" { Exit(1); }
}
