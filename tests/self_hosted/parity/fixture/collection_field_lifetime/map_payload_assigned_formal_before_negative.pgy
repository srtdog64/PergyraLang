func Observe(inout map: HashMap<String, String>) -> Void {
    let table: HashMap<String, String> = MapNew();
    MapSet(table, "k", "old");
    let saved: String = MapGet(table, "k");
    map = table;
    MapSet(map, "k", "new");
    Log(saved);
}
func Main() -> Void {
    let target: HashMap<String, String> = MapNew();
    Observe(target);
}
