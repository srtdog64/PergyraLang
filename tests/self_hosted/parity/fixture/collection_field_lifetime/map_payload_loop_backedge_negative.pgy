func Main() -> Int {
    let table: HashMap<String, String> = MapNew();
    MapSet(table, "key", "old");
    let view: String = MapGet(table, "key");
    let count: Int = 0;
    while count < 2 {
        Log(view);
        MapSet(table, "key", "new");
        count = count + 1;
    }
    return count;
}
