func UnsafeFormal(inout map: HashMap<String, String>) -> Void {
    let table: HashMap<String, String> = MapNew();
    var count: Int = 0;
    while count < 2 { Log(MapSize(map)); map = table; count = count + 1; }
}
func UnsafeLocal() -> Void {
    var rows: HashMap<String, String> = MapNew();
    let table: HashMap<String, String> = MapNew();
    var count: Int = 0;
    while count < 2 { Log(MapSize(rows)); rows = table; count = count + 1; }
}
func UnsafeNested(inout map: HashMap<String, String>) -> Void {
    let table: HashMap<String, String> = MapNew();
    var outer: Int = 0;
    while outer < 2 {
        var count: Int = 0;
        while count < 2 { Log(MapSize(map)); map = table; count = count + 1; }
        outer = outer + 1;
    }
}
func SafeFresh() -> Void {
    var count: Int = 0;
    while count < 2 {
        var fresh: HashMap<String, String> = MapNew();
        let table: HashMap<String, String> = MapNew();
        Log(MapSize(fresh)); fresh = table; count = count + 1;
    }
}
func SafeUnrelated(inout map: HashMap<String, String>) -> Void {
    var other: HashMap<String, String> = MapNew();
    let table: HashMap<String, String> = MapNew();
    var count: Int = 0;
    while count < 2 { Log(MapSize(map)); other = table; count = count + 1; }
}
func SafeOutside(inout map: HashMap<String, String>) -> Void {
    let table: HashMap<String, String> = MapNew();
    var count: Int = 0;
    while count < 2 { Log(MapSize(map)); count = count + 1; }
    map = table;
}
