struct Table { names: Array<String>; }
struct Envelope { table: Table; }
struct Box { table: Table; }
func Inspect(ref box: Box) -> Bool { return box.table.names[0] == "x"; }
func Observe(ref input: Envelope) -> Bool {
    let ok: Bool = Inspect(Box(input.table));
    return ok;
}
func Main() -> Void {}
