struct ReadPair { left: Array<String>; right: Array<String>; }
func Text(ref names: Array<String>) -> String { return names[0]; }
func Retire(inout pair: ReadPair) -> Void {
    let names: Array<String> = pair.left;
    ArrayDropOwnedStrings(names);
    pair.left = names;
}
func Main() -> Void {
    let names: Array<String> = [];
    ArrayPushOwnedString(names, Concat("", "owned"));
    let pair: ReadPair = ReadPair(names, ["y"]);
    let borrowed: String = Text(pair.left);
    Retire(pair);
    Log(borrowed);
}
