struct ReadPair { left: Array<String>; right: Array<String>; }
func Retains(ref names: Array<String>) -> Array<String> { return names; }
func Main() -> Void {
    let pair: ReadPair = ReadPair(["x"], ["y"]);
    let alias: Array<String> = [];
    let retained: Array<String> = Retains(pair.left);
    alias = pair.right;
    Log(ArrayLength(retained));
    Log(ArrayLength(alias));
}
