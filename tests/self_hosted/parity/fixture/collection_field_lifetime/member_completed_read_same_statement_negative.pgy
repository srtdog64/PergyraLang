struct ReadPair { left: Array<String>; right: Array<String>; }
func Reads(ref names: Array<String>) -> Bool { return names[0] == "x"; }
func Select(observed: Bool, ref names: Array<String>) -> Array<String> { return names; }
func Main() -> Void {
    let pair: ReadPair = ReadPair(["x"], ["y"]);
    let alias: Array<String> = [];
    alias = Select(Reads(pair.left), pair.right);
    Log(ArrayLength(alias));
}
