// Completion before aliasing does not claim different fields are independent.
struct ReadPair { left: Array<String>; right: Array<String>; }
func Reads(ref names: Array<String>) -> Bool { return names[0] == "x"; }
func Main() -> Void {
    let backing: Array<String> = ["x"];
    let pair: ReadPair = ReadPair(backing, backing);
    let alias: Array<String> = [];
    let observed: Bool = Reads(pair.left);
    alias = pair.right;
    Log(observed);
    Log(ArrayLength(alias));
}
