struct Table { names: Array<String>; }
func Reads(ref names: Array<String>) -> Bool { return names[0] == "x"; }
func Extract(table: Table) -> Int {
    let moved: Array<String> = table.names;
    return ArrayLength(moved);
}
func Forward(table: Table) -> Int { return Extract(table); }
func Observe(table: Table) -> Bool { Log(Forward(table)); return Reads(table.names); }
func Main() -> Void {}
