func Opaque(inout values: Array<String>) -> Void { ArrayPush(values, "borrowed"); }
func Metadata(own values: Array<String>) -> Int { return ArrayLength(values); }
func Forward(own values: Array<String>) -> Int {
    let moved: Array<String> = [];
    defer { Opaque(moved); }
    moved = values;
    return Metadata(moved);
}
func Main() -> Void { let values: Array<String> = ["borrowed"]; Log(Forward(values)); }
