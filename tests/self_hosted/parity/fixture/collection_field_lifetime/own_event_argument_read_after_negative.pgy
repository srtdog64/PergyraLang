func OwnFirst(own values: Array<String>, count: Int) -> Int { return count + ArrayLength(values); }
func Forward(own values: Array<String>) -> Int {
    let rejected_argument_after: Int = OwnFirst(values, ArrayLength(values));
    return rejected_argument_after;
}
func Main() -> Void {
    let values: Array<String> = ["borrowed"];
    Log(Forward(values));
}
