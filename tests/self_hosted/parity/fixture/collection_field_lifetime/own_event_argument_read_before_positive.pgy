func ReadFirst(count: Int, own values: Array<String>) -> Int { return count + ArrayLength(values); }
func Forward(own values: Array<String>) -> Int {
    let accepted_argument_before: Int = ReadFirst(ArrayLength(values), values);
    return accepted_argument_before;
}
func Main() -> Void {
    let values: Array<String> = ["borrowed"];
    Log(Forward(values));
}
