func Metadata(own values: Array<String>) -> Int { return ArrayLength(values); }
func Forward(own values: Array<String>) -> Int {
    let moved: Array<String> = values;
    let rejected_original_read: Int = ArrayLength(values);
    return rejected_original_read + Metadata(moved);
}
func Main() -> Void {
    let values: Array<String> = ["borrowed"];
    Log(Forward(values));
}
