func Metadata(own values: Array<String>) -> Int { return ArrayLength(values); }
func Opaque(ref values: Array<String>) -> String {
    if ArrayLength(values) > 0 { return values[0]; }
    return "";
}
func Forward(own values: Array<String>) -> Int {
    Log(Opaque(values));
    let rejected_unknown_move: Array<String> = values;
    return Metadata(rejected_unknown_move);
}
func Main() -> Void {
    let values: Array<String> = ["borrowed"];
    Log(Forward(values));
}
