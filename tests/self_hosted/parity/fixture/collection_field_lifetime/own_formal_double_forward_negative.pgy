// Compile-only negative: the first forwarding retires this exact formal.
// Never execute this program.
func Retire(own values: Array<String>) -> Void
{
    ArrayDropOwnedStrings(values);
}

func Forward(own values: Array<String>) -> Void
{
    Retire(values);
    Retire(values);
}

func Main() -> Void
{
    var values: Array<String> = [];
    ArrayPushOwnedString(values, "owned");
    Forward(values);
}
