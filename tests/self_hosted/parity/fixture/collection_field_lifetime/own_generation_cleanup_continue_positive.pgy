func Copy(inout values: Array<String>) -> Void { ArrayPushOwnedString(values, "copied"); }
func Retire(own values: Array<String>) -> Void { ArrayDropOwnedStrings(values); }
func Main() -> Void {
    let iteration: Int = 0;
    while iteration < 2 {
        let values: Array<String> = [];
        Copy(values);
        if iteration == 0 { Retire(values); iteration = iteration + 1; continue; }
        Log(ArrayLength(values));
        Retire(values);
        iteration = iteration + 1;
    }
}
