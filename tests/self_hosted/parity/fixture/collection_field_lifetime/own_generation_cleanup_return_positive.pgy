func Copy(inout values: Array<String>) -> Void { ArrayPushOwnedString(values, "copied"); }
func Retire(own values: Array<String>) -> Void { ArrayDropOwnedStrings(values); }
func Run() -> Int {
    let iteration: Int = 0;
    while iteration < 2 {
        let values: Array<String> = [];
        Copy(values);
        if iteration == 0 { Retire(values); return 0; }
        Log(ArrayLength(values));
        Retire(values);
        iteration = iteration + 1;
    }
    return iteration;
}
func Main() -> Void { Log(Run()); }
