func Retire(own values: Array<String>) -> Void { ArrayDropOwnedStrings(values); }
func Main() -> Void {
    var outer: Int = 0;
    while outer < 2 {
        let values: Array<String> = [];
        var inner: Int = 0;
        while inner < 2 { Retire(values); inner = inner + 1; }
        outer = outer + 1;
    }
}
