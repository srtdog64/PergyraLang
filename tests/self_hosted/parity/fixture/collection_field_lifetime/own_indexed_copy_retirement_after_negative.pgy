// Compile/admission only: the body exists but the read follows retirement.
func CopySelected(own values: Array<String>) -> String {
    ArrayDropOwnedStrings(values);
    return Concat("", values[0]);
}
func Main() -> Void {
    let values: Array<String> = [];
    ArrayPushOwnedString(values, "owned");
    Log(CopySelected(values));
}
