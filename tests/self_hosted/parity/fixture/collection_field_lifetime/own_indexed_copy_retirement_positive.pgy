func CopySelected(own values: Array<String>) -> String {
    let copied: String = Concat("", values[ArrayLength(values) - 1]);
    ArrayDropOwnedStrings(values);
    return copied;
}
func Main() -> Void {
    let values: Array<String> = [];
    ArrayPushOwnedString(values, "selected");
    if CopySelected(values) != "selected" { Exit(1); }
    Log("OWN INDEXED COPY RETIREMENT PASS");
}
