func Metadata(own values: Array<String>) -> Int { return ArrayLength(values); }
func Forward(own values: Array<String>) -> Int {
    ArrayDropOwnedStrings(values);
    let rejected_formal: Int = Metadata(values);
    return rejected_formal;
}
func Main() -> Void {
    let borrowed: Array<String> = ["borrowed"];
    let values: Array<String> = Clone(borrowed);
    Log(Forward(values));
}
