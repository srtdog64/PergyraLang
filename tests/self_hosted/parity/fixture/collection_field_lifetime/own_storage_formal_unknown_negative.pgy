func Metadata(own values: Array<String>) -> Int { return ArrayLength(values); }
func Opaque(ref values: Array<String>) -> Void {
    if ArrayLength(values) > 0 { Log(values[0]); }
}
func Forward(own values: Array<String>) -> Int {
    Opaque(values);
    let rejected_unknown_formal: Int = Metadata(values);
    return rejected_unknown_formal;
}
func Main() -> Void {
    let values: Array<String> = [];
    Log(Forward(values));
}
