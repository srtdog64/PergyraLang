// A callee keeps the elements it borrows in a local array it only pushes,
// measures and indexes; the caller grows its own array afterwards.
struct Expr {
    valid: Bool;
    text: String;
}

func HashMapAt(values: Array<String>, at: Int) -> Expr {
    var operands: Array<String> = [];
    var index: Int = 0;
    while index < at {
        if index >= ArrayLength(values) { return Expr(false, ""); }
        ArrayPush(operands, values[index]);
        index = index + 1;
    }
    var text: String = "";
    if ArrayLength(operands) > 0 { text = Concat("op ", operands[0]); }
    return Expr(true, text);
}

func Emit(ref names: Array<String>) -> Int {
    var values: Array<String> = [];
    var chunks: Array<String> = [];
    var node: Int = 0;
    while node < ArrayLength(names) {
        var left: String = "";
        if node > 0 { left = values[node - 1]; }
        let hashmap: Expr = HashMapAt(values, node);
        var value: String = Concat(left, names[node]);
        if hashmap.valid { value = hashmap.text; }
        ArrayPush(chunks, Concat("c", value));
        ArrayPush(values, value);
        node = node + 1;
    }
    return ArrayLength(chunks) + ArrayLength(values);
}

func Main() -> Int {
    let names: Array<String> = ["x", "y"];
    return Emit(names);
}
