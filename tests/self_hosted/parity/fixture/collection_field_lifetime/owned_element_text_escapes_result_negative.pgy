// The callee returns a borrowed element through its result; the caller
// releases the elements and then reads the result.
struct Expr {
    valid: Bool;
    text: String;
}

func FirstOf(values: Array<String>) -> Expr {
    let operands: Array<String> = [];
    ArrayPush(operands, values[0]);
    return Expr(true, operands[0]);
}

func Main() -> Int {
    let names: Array<String> = [];
    ArrayPushOwnedString(names, Concat("a", "b"));
    let expr: Expr = FirstOf(names);
    ArrayDropOwnedStrings(names);
    return StringLength(expr.text);
}
