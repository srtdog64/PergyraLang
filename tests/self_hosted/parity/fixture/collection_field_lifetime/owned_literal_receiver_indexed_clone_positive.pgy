func OwnedField(value: String) -> String {
    return Concat("", value);
}

func GatherFields(ref source: Array<String>) -> Void {
    let fields: Array<String> = [OwnedField("seed")];
    let row: Int = 0;
    while row < ArrayLength(source) {
        ArrayPush(fields, source[row]);
        row = row + 1;
    }
    if ArrayLength(fields) != 2 || fields[0] != "seed" ||
        fields[1] != "copied" {
        Exit(1);
    }
    ArrayDropOwnedStrings(fields);
}

func Main() -> Void {
    let source: Array<String> = [];
    ArrayPushOwnedString(source, "copied");
    GatherFields(source);
    ArrayDropOwnedStrings(source);
}
