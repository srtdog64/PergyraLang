func MaybeBorrowed(flag: Bool) -> Array<String> {
    if flag {
        let values: Array<String> = [];
        ArrayPushOwnedString(values, Concat("", "owned"));
        return values;
    }
    return ["borrowed"];
}

func Main() -> Void {
    let values: Array<String> = MaybeBorrowed(false);
    ArrayDropOwnedStrings(values);
}
