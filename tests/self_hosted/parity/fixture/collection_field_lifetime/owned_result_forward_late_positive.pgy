func ForwardOwned(value: String) -> Array<String> {
    return BuildOwned(value);
}

func BuildOwned(value: String) -> Array<String> {
    var values: Array<String> = [];
    ArrayPushOwnedString(values, Concat("", value));
    return values;
}

func Main() -> Void {
    var values: Array<String> = ForwardOwned("first");
    ArrayPushOwnedString(values, Concat("", "second"));
    ArrayDropOwnedStrings(values);
}
