import "../../../../../src/self_hosted/codegen/text/owned_string_join_owner.pgy";
func RetireJoined(own value: String) -> Void {
    let retired: Array<String> = [value];
    ArrayDropOwnedStrings(retired);
}
func Main() -> Void {
    let fragments: Array<String> = [];
    ArrayPushOwnedString(fragments, "first");
    ArrayPushOwnedString(fragments, "second");
    let joined: String = CodegenJoinOwnedStringFragments(fragments, ":");
    if joined != "first:second" { Exit(1); }
    RetireJoined(joined);
    let empty: Array<String> = [];
    RetireJoined(CodegenJoinOwnedStringFragments(empty, ""));
    Log("OWNED STRING JOIN PASS");
}
