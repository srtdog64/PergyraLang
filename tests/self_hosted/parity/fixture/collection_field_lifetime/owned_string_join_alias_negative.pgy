func RetireJoined(own value: String) -> Void {
    let retired: Array<String> = [value];
    ArrayDropOwnedStrings(retired);
}
func Main() -> Void {
    let fragments: Array<String> = ["a", "b"];
    let joined: String = StringJoin(fragments, "");
    let alias: String = joined;
    RetireJoined(joined);
    Log(alias);
}
