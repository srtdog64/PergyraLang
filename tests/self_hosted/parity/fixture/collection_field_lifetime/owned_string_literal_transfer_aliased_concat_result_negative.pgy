struct StringHolder { text: String }

func ProduceAliasedString(inout holder: StringHolder) -> String {
    let value: String = Concat("", "retained");
    holder.text = value;
    return value;
}

func Retire(own fragment: String) -> Void {
    let fragments: Array<String> = [fragment];
    ArrayDropOwnedStrings(fragments);
}

func Main() -> Void {
    let holder: StringHolder = StringHolder("");
    Retire(ProduceAliasedString(holder));
}
