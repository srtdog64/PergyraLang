func MakeString(change: Bool) -> String {
    let allocator: Allocator = AllocatorResult();
    let output: TextBuilder = TextBuilderNew(16);
    TextBuilderAppend(output, "owned");
    let result: String = TextBuilderFinish(output, allocator);
    AllocatorDestroy(allocator);
    if change { result = "borrowed"; }
    return result;
}
func Main() -> Void {
    let values: Array<String> = [];
    ArrayPush(values, MakeString(true));
    ArrayDropOwnedStrings(values);
}
