// An own String formal is not a borrowed place of this frame.
func Has(names: Array<String>, name: String) -> Bool {
    let i: Int = 0;
    while i < ArrayLength(names) {
        if names[i] == name { return true; }
        i = i + 1;
    }
    return false;
}

func Check(own text: String) -> Bool {
    return Has([text], "a");
}

func Main() -> Int {
    if Check(Concat("a", "")) { return 1; }
    return 0;
}
