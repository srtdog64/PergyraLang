// An opaque return is not positive storage authority, even without borrow tags.
func Opaque() -> Array<String> { return []; }
func Metadata(own values: Array<String>) -> Int { return ArrayLength(values); }
func Main() -> Void {
    let seed: Array<String> = ["borrowed"];
    let values: Array<String> = Opaque();
    Log(Metadata(values));
}
