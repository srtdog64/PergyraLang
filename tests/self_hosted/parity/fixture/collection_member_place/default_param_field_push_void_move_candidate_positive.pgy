struct Table { names: Array<String>; count: Int; }
struct Outer { table: Table; label: String; }
// Returning Void does not make the mutation readonly. It remains a moving-
// formal candidate whose caller-side later use is decided by ownership flow.
func MakeTable() -> Table {
    var names: Array<String> = [];
    ArrayPushOwnedString(names, Concat("", "owned"));
    return Table(names, 1);
}
func Has(ref names: Array<String>, wanted: String) -> Bool {
    var row: Int = 0;
    while row < ArrayLength(names) {
        if names[row] == wanted { return true; }
        row = row + 1;
    }
    return false;
}
func HasTable(ref table: Table, wanted: String) -> Bool {
    var row: Int = 0;
    while row < ArrayLength(table.names) {
        if table.names[row] == wanted { return true; }
        row = row + 1;
    }
    return false;
}
func Retire(inout table: Table) -> Void {
    let names: Array<String> = table.names;
    ArrayDropOwnedStrings(names);
    table.names = names;
}
func Grow(table: Table) -> Void {
    ArrayPush(table.names, "x");
}
func Main() -> Void {
    let table: Table = MakeTable();
    Grow(table);
    Log(table.names[0]);
}
