subject Fighter { let power: Int; }
ability Talkable { func Speak(self) -> Int; }
role Warrior for Fighter { impl ability Talkable { func Speak(self) -> Int { return self.power; } } }
party Team { dyn role slot fighter: Talkable; }
func Make() -> Team {
    let hero: Fighter = Fighter(1);
    let team: Team = Team();
    bind team.fighter = hero as Warrior;
    return team;
}
func Main() -> Void {
    Log(1);
}
