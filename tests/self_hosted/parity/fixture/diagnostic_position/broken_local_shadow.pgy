func Label(flag: Bool, n: Int) -> String {
    var tag: String = "";
    if flag { tag = "!"; }
    var out: String = "a" + tag;
    var i: Int = 0;
    while i < n {
        var tag: String = "";
        if i > 0 { tag = "+"; }
        out = out + tag;
        i = i + 1;
    }
    return out;
}

func Main() -> Void {
    Log(Label(true, 3));
}
