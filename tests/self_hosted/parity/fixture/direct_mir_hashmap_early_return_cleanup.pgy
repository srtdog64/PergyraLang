func ContainsOwnedKey(
    values: HashMap<String, Int>, key: String
) -> Bool {
    return MapHas(values, key);
}

func ContainsBorrowedKey(
    ref values: HashMap<String, Int>, key: String
) -> Bool {
    return MapHas(values, key);
}

func InsertOwnedKey(
    inout values: HashMap<String, Int>, key: String, value: Int
) -> Void {
    MapSet(values, key, value);
}

func Main() -> Void {
    var values: HashMap<String, Int> = MapNew();
    InsertOwnedKey(values, "owned", 1);
    if ContainsOwnedKey(values, "owned") &&
        ContainsBorrowedKey(values, "owned") {
        Log(1);
        return;
    }
    Log(0);
}
