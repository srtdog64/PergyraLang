subject Source {
    let value: Int;
}

object View {
    value: Int;
}

tobject Packet {
    value: Int;
}

zone InvalidProjectionInitializerZone {
    subject slot source: Source
    object slot view: View = ToObject(View, source)
    tobject slot packet: Packet = ToTObject(Packet, source)
}

