func Main() -> Int
{
    var n: Int = 0;
    var total: Int = 0;
    while n < 3
    {
        var rows: Array<String> = [];
        ArrayPushOwnedString(rows, "x");
        total = total + ArrayLength(rows);
        ArrayDropOwnedStrings(rows);
        n = n + 1;
    }
    Print(ToString(total));
    return 0;
}
