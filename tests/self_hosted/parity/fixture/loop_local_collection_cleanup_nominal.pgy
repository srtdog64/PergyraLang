struct LoopRows {
    let tag: Int;
    let ready: Bool;
    let names: Array<String>;
}

func LoopRowsCount(ref rows: LoopRows) -> Int {
    return ArrayLength(rows.names);
}

func Main() -> Int {
    var i: Int = 0;
    var total: Int = 0;
    while i < 3 {
        var names: Array<String> = [];
        ArrayPushOwnedString(names, Concat("x", ""));
        let rows: LoopRows = LoopRows(i, true, names);
        total = total + LoopRowsCount(rows);
        i = i + 1;
    }
    Print(ToString(total));
    return 0;
}
