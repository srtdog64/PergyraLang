// Gate-only reconstruction of immutable receipts around deliberately stale rows.
import "../../../../src/self_hosted/compiler/direct_mir_scalar_cfg_graph_identity_owner.pgy";

func RewriteProbeMoveReceipts(
    plan: DirectMirScalarCfgGraphPlan, repair_coverage: Bool
) -> DirectMirScalarCfgGraphPlan {
    let prior_move: DirectMirScalarProgramOwnedArrayStringMoveFact =
        plan.program.owned_array_string_move;
    let coverage: DirectMirScalarProgramOwnedArrayStringMoveCoverageFact = prior_move.coverage;
    if repair_coverage {
        coverage = DirectMirScalarProgramOwnedArrayStringMoveCoverageFact(
            coverage.valid, DirectMirScalarProgramOwnedArrayStringMoveCoverageDigest(coverage),
            coverage.input_digest, coverage.call_block_rows);
    }
    let move_source: DirectMirScalarProgramOwnedArrayStringMoveFact =
        DirectMirScalarProgramOwnedArrayStringMoveFact(
            prior_move.valid, 0, prior_move.present, coverage,
            prior_move.caller_routines, prior_move.call_operation_rows,
            prior_move.call_expression_rows, prior_move.local_rows,
            prior_move.callable_ordinals, prior_move.parameter_ordinals, prior_move.abi_layout_ids);
    let move_fact: DirectMirScalarProgramOwnedArrayStringMoveFact =
        DirectMirScalarProgramOwnedArrayStringMoveFact(
            move_source.valid, DirectMirScalarProgramOwnedArrayStringMoveFactDigest(move_source),
            move_source.present, coverage, move_source.caller_routines,
            move_source.call_operation_rows, move_source.call_expression_rows,
            move_source.local_rows, move_source.callable_ordinals,
            move_source.parameter_ordinals, move_source.abi_layout_ids);
    let prior_program: DirectMirScalarCfgProgramExtensionFact = plan.program;
    let program_fact: DirectMirScalarCfgProgramExtensionFact =
        DirectMirScalarCfgProgramExtensionFact(
            prior_program.valid, 0, prior_program.callable, prior_program.expressions,
            prior_program.block_condition_expression_rows, prior_program.operation_expression_rows,
            prior_program.operation_secondary_expression_rows, prior_program.block_return_expression_rows,
            prior_program.closed_call_abi, prior_program.runtime_abi,
            prior_program.option_int_abi, prior_program.result_int_abi,
            prior_program.option_string_abi, prior_program.option_bool_abi,
            prior_program.logical_record, prior_program.referenced_enum,
            prior_program.payload_free_enum, prior_program.array_int_value_result,
            prior_program.array_bool_abi, prior_program.array_string_abi,
            prior_program.array_string_boundary, move_fact);
    program_fact = DirectMirScalarCfgProgramExtensionFactWithDigest(
        program_fact, DirectMirScalarCfgProgramExtensionFactDigest(program_fact));
    let rewritten: DirectMirScalarCfgGraphPlan = DirectMirScalarCfgGraphPlan(
        plan.valid, plan.schema, plan.revision, 0,
        plan.mir_digest, plan.cfg_digest, plan.target_schema,
        plan.target_fingerprint, plan.routines,
        plan.local_names, plan.local_types,
        plan.local_ref_kinds, plan.local_ref_value_ids,
        plan.local_ref_syntax_ids, plan.value_names, plan.value_types,
        plan.value_local_rows, plan.value_definition_blocks,
        plan.block_succ_true, plan.block_succ_false,
        plan.block_operation_starts, plan.block_operation_counts,
        plan.block_condition_kinds, plan.block_condition_left_values,
        plan.block_condition_right_values, plan.block_condition_left_locals,
        plan.block_condition_right_locals, plan.block_condition_left_literals,
        plan.block_condition_right_literals, plan.operation_kinds,
        plan.operation_result_values, plan.operation_left_values,
        plan.operation_right_values, plan.operation_left_locals,
        plan.operation_right_locals, plan.operation_left_literals,
        plan.operation_right_literals, plan.operation_phi_starts,
        plan.operation_phi_counts, plan.phi_predecessor_blocks,
        plan.phi_incoming_values, plan.range_iterations,
        plan.foreach_iterations, plan.foreach_elements, plan.string_arrays,
        plan.array_int_program, plan.collection_pops, plan.collections,
        plan.string_concat_runtime_call_abi_id, program_fact);
    return DirectMirScalarCfgGraphPlanWithDigest(
        rewritten, DirectMirScalarCfgGraphPlanDigest(rewritten));
}
