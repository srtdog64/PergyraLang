func Touch(ref view: Slice<Int>) -> Void {
    view[0] = 7;
}

func ReadWindowValue(ref view: Slice<Int>, index: Int) -> Int {
    return 3 + view[index];
}

func Main() -> Void {
    let values: Array<Int> = [1];
    let view: Slice<Int> = values.Slice(0, 1);
    Touch(view);
    Log(values[0]);
    Log(ReadWindowValue(view, 0));
}
