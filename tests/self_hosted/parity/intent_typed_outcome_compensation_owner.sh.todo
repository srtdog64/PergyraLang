#!/usr/bin/env bash
set -euo pipefail

# PLANNED/OPEN gate skeleton. The .todo suffix intentionally keeps this file
# out of Makefile/aggregate execution. Running it must not report PASS until the
# typed intent step transition owner and executable fixture exist.

