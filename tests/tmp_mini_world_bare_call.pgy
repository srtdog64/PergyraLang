import "examples/raid_graph_fsm/party.pgy";
world W {
    func Touch(self, r: Raider) -> Void {
        r.Wound(2);
    }
    func Run(self, r: Raider) -> Void {
        Touch(r);
        Print(ToString(r.core.blocks));
        Print("\n");
        Print(ToString(r.core.wounds));
        Print("\n");
    }
}
func Main() -> Void {
    let w = W();
    let r = Raider("Iris", "scout", RaiderCore(0,0,0,14,0,0,0,0,0,0,0));
    w.Run(r);
}
