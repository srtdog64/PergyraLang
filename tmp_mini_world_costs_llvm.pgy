zone RoomZone {
    shared threat: Int = 0
    shared instability: Int = 0
}
world W {
    zone forge: RoomZone
    shared storm: Int = 0
    shared campForge: Int = 2
    func CostToForge(self) -> Int {
        return campForge + forge.threat + storm;
    }
}
func Main() -> Void {
    let w: W = W(RoomZone(1, 0));
    w.storm = 1;
    Print(ToString(w.CostToForge()));
    Print("\n");
}
